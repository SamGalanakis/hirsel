type IndexedEntries {
    keys: Inline[u32, 5],
    values: Inline[u32, 5]
}

// Sorting three entries moves their values with them and leaves the entries
// on each side of the range in place.
// expect: run heap_sort_indexed_range() = true
fn heap_sort_indexed_range() -> bool {
    let mut entries = IndexedEntries(keys:[9, 4, 2, 3, 1], values:[90, 40, 20, 30, 10])
    list.heap_sort_by_index(mut entries, 1, 4, fn(table: IndexedEntries, i: u64, j: u64) -> Order {
        order.compare(table.keys[i], table.keys[j])
    }, fn(mut table: IndexedEntries, i: u64, j: u64) {
        let key = table.keys[i]
        let value = table.values[i]
        table.keys[i] = table.keys[j]
        table.values[i] = table.values[j]
        table.keys[j] = key
        table.values[j] = value
    })
    let keys: Inline[u32, 5] =[9, 2, 3, 4, 1]
    for i in 0u64 .. 5 {
        if entries.keys[i] != keys[i] || entries.values[i] != keys[i] * 10 {
            return false
        }
    }
    true
}

// expect: run sort_ascending() = 11345
fn sort_ascending() -> u64 {
    let mut xs = five(3, 1, 4, 1, 5)
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    digits(xs)
}

// expect: run sort_descending() = 54311
fn sort_descending() -> u64 {
    let mut xs = five(3, 1, 4, 1, 5)
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(b, a)
    })
    digits(xs)
}

// Past 16 elements the quicksort partitions: (7i) % 20 for i in 0..20 is a permutation of
// 0..20 (7 and 20 are coprime), so sorted, element i is i at all 20 positions.
// expect: run sort_permutation_of_twenty() = 20
fn sort_permutation_of_twenty() -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 20 {
        result.unwrap(list.push(mut xs, (7 * i) % 20))
    }
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    let mut placed: u64 = 0
    for i in 0u64 .. 20 {
        if xs[i] == i {
            placed += 1
        }
    }
    placed
}

// Thirty elements i % 3: sorted, ten 0s, ten 1s and ten 2s, so element i is i / 10.
// expect: run sort_many_equal() = 30
fn sort_many_equal() -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 30 {
        result.unwrap(list.push(mut xs, i % 3))
    }
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    let mut placed: u64 = 0
    for i in 0u64 .. 30 {
        if xs[i] == i / 10 {
            placed += 1
        }
    }
    placed
}

type SortLawItem {
    id: u64,
    key: u64,
    payload: String
}

fn sort_law_key(i: u64, n: u64, shape: u64) -> u64 {
    if shape == 0 {
        0
    } else if shape == 1 {
        i % 2
    } else if shape == 2 {
        i
    } else if shape == 3 {
        n - i
    } else if shape == 4 {
        if i < n / 2 {
            i
        } else {
            n - i
        }
    } else {
        int.wrapping_mul(i ^ 0x9e3779b9, 0xbf58476d1ce4e5b9) >> 57
    }
}

fn sort_law_input(n: u64, shape: u64) -> List[SortLawItem] {
    let mut xs: List[SortLawItem] = result.unwrap(list.with_capacity(n))
    for i in 0u64 .. n {
        let payload = result.unwrap(string.from("live"))
        result.unwrap(list.push(mut xs, SortLawItem(id: i, key: sort_law_key(i, n, shape), payload: take payload)))
    }
    take xs
}

// The IDs must be exactly 0..n, each with its original key and payload.
fn sort_law_permutation(xs: List[SortLawItem], n: u64, shape: u64) -> bool {
    if list.len(xs) != n {
        return false
    }
    let mut seen: Inline[bool, 129] =[false; 129]
    for item in xs {
        if item.id >= n || seen[item.id] || item.key != sort_law_key(item.id, n, shape) || item.payload != "live" {
            return false
        }
        seen[item.id] = true
    }
    true
}

// expect: run sort_run_and_duplicate_law() = true
fn sort_run_and_duplicate_law() -> bool {
    let sizes: Inline[u64, 13] =[0, 1, 2, 15, 16, 17, 31, 32, 63, 64, 65, 128, 129]
    for n in sizes {
        for shape in 0u64 .. 6 {
            let mut xs = sort_law_input(n, shape)
            list.sort(mut xs, fn(a: SortLawItem, b: SortLawItem) -> Order {
                order.compare(a.key, b.key)
            })
            if !sort_law_permutation(xs, n, shape) {
                return false
            }
            for i in 1u64 .. n {
                if xs[i - 1].key > xs[i].key {
                    return false
                }
            }
        }
    }
    true
}

resource type UnstableSortAudit {
    items: List[SortLawItem],
    n: u64,
    shape: u64
} drop(audit) {
    if !sort_law_permutation(audit.items, audit.n, audit.shape) {
        fail("list.sort changed its input permutation")
    }
}

fn sort_law_fail_at(n: u64, shape: u64, k: u64) {
    let mut audit = result.unwrap(UnstableSortAudit(items: sort_law_input(n, shape), n, shape))
    let mut calls: u64 = 0
    list.sort(mut audit.items, scoped fn(a: SortLawItem, b: SortLawItem) -> Order {
        calls += 1
        if calls == k {
            let missing: Option[u64] = None
            let _ = option.unwrap(missing)
        }
        order.compare(a.key, b.key)
    })
}

// The resource finalizer checks the permutation during unwinding. Any
// finalizer failure must appear as an extra cause alongside the injected one.
fn sort_law_caught(n: u64, shape: u64, k: u64) -> bool {
    match result.unwrap(isolate(fn() -> bool {
        sort_law_fail_at(n, shape, k)
        true
    })) {
        Ok(_) => false,
        Error(take causes) => {
            let mut seen = false
            for cause in causes {
                if seen {
                    return false
                }
                match cause.kind {
                    Unwrap => {
                        seen = true
                    },
                    _ => return false,
                }
            }
            seen
        },
    }
}

// expect: run sort_comparator_failure_law() = true
fn sort_comparator_failure_law() -> bool {
    let calls: Inline[u64, 6] =[1, 3, 9, 20, 48, 80]
    for k in calls {
        for shape in 0u64 .. 5 {
            let n: u64 = if shape == 3 {
                16
            } else {
                96
            }
            if !sort_law_caught(n, shape, k) {
                return false
            }
        }
    }
    // A later failure exercises the pass that groups equal keys.
    sort_law_caught(96, 1, 220)
}

// A changing answer gives no order. Its calls still see live elements and the
// result is a permutation.
// expect: run sort_inconsistent_comparator_law() = true
fn sort_inconsistent_comparator_law() -> bool {
    let mut xs = sort_law_input(129, 5)
    let mut calls: u64 = 0
    list.sort(mut xs, scoped fn(a: SortLawItem, b: SortLawItem) -> Order {
        if a.payload != "live" || b.payload != "live" {
            fail("list.sort compared an invalid element")
        }
        calls += 1
        match calls % 3 {
            0 => Less,
            1 => Equal,
            _ => Greater,
        }
    })
    sort_law_permutation(xs, 129, 5)
}

// 'a' + 'b' + 'c' = 97 + 98 + 99.
// expect: run sum_bytes_of_text() = 294
fn sum_bytes_of_text() -> u64 {
    list.sum_bytes(string.as_bytes("abc"))
}

// 300 bytes of 255 sum past u8 and u16 without overflow: 300 x 255.
// expect: run sum_bytes_wide() = 76500
fn sum_bytes_wide() -> u64 {
    let mut b: Bytes = list.new()
    result.unwrap(list.fill(mut b, 300, 255))
    list.sum_bytes(b)
}

// Core operations with bodies (core/core/list.hirsel), against core.md.
// fill appends n copies after the existing elements and grows once to at least len + n.
// expect: run fill_appends() = 1777
fn fill_appends() -> u64 {
    let mut xs: List[u64] = list.new()
    result.unwrap(list.push(mut xs, 1))
    result.unwrap(list.fill(mut xs, 3, 7))
    if list.capacity(xs) < 4 {
        return 99
    }
    digits(xs)
}

// Under `bound bytes 0` the growth is refused and xs is unchanged.
// expect: run fill_under_bound() = 0
fn fill_under_bound() -> u64 {
    let mut xs: List[u64] = list.new()
    let r = bound bytes 0 {
        list.fill(mut xs, 3, 7)
    }
    match r {
        Ok(Error(_)) => list.len(xs),
        _ => 99,
    }
}

// expect: run sum_empty() = 0
fn sum_empty() -> u64 {
    list.sum((list.new() : List[u64]))
}

// 250 + 5 is u8's maximum, 255.
// expect: run sum_to_max() = 255
fn sum_to_max() -> u8 {
    let mut xs: List[u8] = list.new()
    result.unwrap(list.push(mut xs, 250))
    result.unwrap(list.push(mut xs, 5))
    list.sum(xs)
}

// 250 + 6 does not fit u8.
// expect: run sum_overflow() = fail Overflow
fn sum_overflow() -> u8 {
    let mut xs: List[u8] = list.new()
    result.unwrap(list.push(mut xs, 250))
    result.unwrap(list.push(mut xs, 6))
    list.sum(xs)
}

// Signed: -128 + 127 + -1 = -2, every partial sum within i8.
// expect: run sum_signed() = -2
fn sum_signed() -> i8 {
    let mut xs: List[i8] = list.new()
    result.unwrap(list.push(mut xs, -128))
    result.unwrap(list.push(mut xs, 127))
    result.unwrap(list.push(mut xs, -1))
    list.sum(xs)
}

// expect: run contains_cases() = true
fn contains_cases() -> bool {
    let xs = five(1, 2, 3, 2, 1)
    let empty: List[u64] = list.new()
    list.contains(xs, 2) && !list.contains(xs, 4) && !list.contains(empty, 1)
}

// Search returns the first equal and exact insertion positions.
// expect: run search_positions() = 1305
fn search_positions() -> u64 {
    let xs = five(1, 2, 2, 4, 5)
    let a = result.unwrap(list.binary_search(xs, 2))
    let b = match list.binary_search(xs, 3) {
        Error(i) => i,
        _ => 99
    }
    let c = match list.binary_search(xs, 0) {
        Error(i) => i,
        _ => 99
    }
    let d = match list.binary_search(xs, 6) {
        Error(i) => i,
        _ => 99
    }
    a * 1000 + b * 100 + c * 10 + d
}

// [1,1,2,2,1] -> [1,2,1], not globally unique and not reordered.
// expect: run dedup_runs() = 121
fn dedup_runs() -> u64 {
    let mut xs = five(1, 1, 2, 2, 1)
    list.dedup(mut xs)
    digits(xs)
}

// expect: run dedup_empty_singleton() = 7
fn dedup_empty_singleton() -> u64 {
    let mut xs: List[u64] = list.new()
    list.dedup(mut xs)
    result.unwrap(list.push(mut xs, 7))
    list.dedup(mut xs)
    digits(xs)
}

// expect: run extend_copies() = 12345
fn extend_copies() -> u64 {
    let mut xs: List[u64] = list.new()
    let ys = five(1, 2, 3, 4, 5)
    result.unwrap(list.extend(mut xs, ys))
    if digits(ys) != 12345 {
        return 99
    }
    digits(xs)
}

// expect: run extend_capacity() = 0
fn extend_capacity() -> u64 {
    let mut xs: List[u64] = list.new()
    let ys = five(6, 7, 8, 9, 0)
    let r = bound bytes 0 {
        list.extend(mut xs, ys)
    }
    match r {
        Ok(Error(_)) => list.len(xs),
        _ => 99
    }
}

fn by_tens(a: u64, b: u64) -> Order {
    order.compare(a / 10, b / 10)
}

// Four accumulators and all tail lengths. 0 + 1 + ... + 6 = 21.
// expect: run sum_bytes_tails() = 21
fn sum_bytes_tails() -> u64 {
    let mut xs: Bytes = list.new()
    for i in 0u8 .. 7 {
        result.unwrap(list.push(mut xs, i))
    }
    list.sum_bytes(list.slice(xs, 0, 4)) + list.sum_bytes(list.slice(xs, 4, 7))
}

// All four accumulator tails, including empty input.
// expect: run sum_bytes_tail_lengths() = true
fn sum_bytes_tail_lengths() -> bool {
    let mut xs: Bytes = list.new()
    result.unwrap(list.fill(mut xs, 7, 255))
    let mut n: u64 = 0
    while n <= 7 {
        if list.sum_bytes(list.slice(xs, 0, n)) != 255 * n {
            return false
        }
        n += 1
    }
    true
}

// Both indices are checked even when equal; the same-index fast path must not
// turn an out-of-range access into a successful no-op.
// expect: run swap_equal_out_of_bounds() = fail Bounds
fn swap_equal_out_of_bounds() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 5, 5)
    digits(xs)
}

// The first index is independently checked before the exchange.
// expect: run swap_first_out_of_bounds() = fail Bounds
fn swap_first_out_of_bounds() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 5, 0)
    digits(xs)
}

// Owning elements exchange their whole carriers, without a cleanup or clone.
// expect: run swap_owned_carriers() = true
fn swap_owned_carriers() -> bool {
    let mut xs: List[String] = list.new()
    result.unwrap(list.push(mut xs, result.unwrap(string.from("first"))))
    result.unwrap(list.push(mut xs, result.unwrap(string.from("second"))))
    list.swap(mut xs, 0, 1)
    xs[0] == "second" && xs[1] == "first"
}

// expect: run swap_zero_sized() = 2
fn swap_zero_sized() -> u64 {
    let mut xs: List[()] = list.new()
    result.unwrap(list.push(mut xs, ()))
    result.unwrap(list.push(mut xs, ()))
    list.swap(mut xs, 0, 1)
    list.len(xs)
}

// A zero-sized element has no storage to bound a length, so appending two lists of
// 2^63 units overflows the count: Error(Capacity), and xs keeps its length.
// expect: run append_zero_sized_count_overflows() = 9223372036854775808
fn append_zero_sized_count_overflows() -> u64 {
    let mut xs: List[()] = list.new()
    let mut ys: List[()] = list.new()
    result.unwrap(list.fill(mut xs, 9223372036854775808, ()))
    result.unwrap(list.fill(mut ys, 9223372036854775808, ()))
    match list.append(mut xs, ys) {
        Ok(()) => 0,
        Error(_) => list.len(xs)
    }
}

// Search only the tens key, not the whole value, retaining the first equal index.
// expect: run search_by_key() = 1
fn search_by_key() -> u64 {
    let xs = five(10, 21, 22, 24, 30)
    result.unwrap(list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x / 10, 2)
    }))
}

// Exact insertion indices before, between and after keys; a callback using the
// opposite operand order changes these results.
// expect: run search_by_insertions() = 35
fn search_by_insertions() -> u64 {
    let xs = five(10, 20, 30, 40, 50)
    let a = match list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, 5)
    }) {
        Error(i) => i,
        _ => 99
    }
    let b = match list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, 35)
    }) {
        Error(i) => i,
        _ => 99
    }
    let c = match list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, 55)
    }) {
        Error(i) => i,
        _ => 99
    }
    a * 100 + b * 10 + c
}

// Empty search must not call the comparator.
// expect: run search_by_empty() = 0
fn search_by_empty() -> u64 {
    let xs: List[u64] = list.new()
    match list.binary_search_by(xs, fn(x: u64) -> Order {
        fail("empty comparator")
    }) {
        Error(i) => i,
        _ => 99,
    }
}

// Captured key is viewed, and equal runs still resolve to their first position.
// expect: run search_by_capture() = 0
fn search_by_capture() -> u64 {
    let xs = five(7, 7, 7, 7, 7)
    let key: u64 = 7
    result.unwrap(list.binary_search_by(xs, fn(x: u64) -> Order {
        order.compare(x, key)
    }))
}

// Huffman nodes need not be ordered: the callback reads frequency alone.
// expect: run search_by_unordered_record() = 1
fn search_by_unordered_record() -> u64 {
    let mut xs: List[Box[SearchNode]] = list.new()
    result.unwrap(list.push(mut xs, result.unwrap(box.new(SearchNode(frequency: 1, name: true)))))
    result.unwrap(list.push(mut xs, result.unwrap(box.new(SearchNode(frequency: 3, name: false)))))
    result.unwrap(list.push(mut xs, result.unwrap(box.new(SearchNode(frequency: 3, name: true)))))
    result.unwrap(list.binary_search_by(xs, fn(x: Box[SearchNode]) -> Order {
        order.compare(x.frequency, 3)
    }))
}

type SearchNode {
    frequency: u64,
    name: bool
}

// get_or reads xs[i] inside the list and x from len on, including an empty list and the
// largest index: [7, 8] gives 7, 8, then 5, 5; the empty list gives 5. Read as digits.
// expect: run get_or_edges() = 78555
fn get_or_edges() -> u64 {
    let mut xs: List[u64] = list.new()
    result.unwrap(list.push(mut xs, 7))
    result.unwrap(list.push(mut xs, 8))
    let none: List[u64] = list.new()
    let a = list.get_or(xs, 0, 5)
    let b = list.get_or(xs, 1, 5)
    let c = list.get_or(xs, 2, 5)
    let d = list.get_or(xs, 18446744073709551615, 5)
    let e = list.get_or(none, 0, 5)
    (((a * 10 + b) * 10 + c) * 10 + d) * 10 + e
}

fn find_byte_ref(xs: Bytes, start: u64, end: u64, byte: u8) -> Option[u64] {
    for i in start .. end {
        if xs[i] == byte {
            return Some(i)
        }
    }
    None
}

fn find_byte4_ref(xs: Bytes, start: u64, end: u64, a: u8, b: u8, c: u8, d: u8) -> Option[u64] {
    for i in start .. end {
        let x = xs[i]
        if x == a || x == b || x == c || x == d {
            return Some(i)
        }
    }
    None
}

// Every lane of the portable word path (< 160 B) and the SIMD four-vector group
// plus leftovers and overlapping tail (>= 160 B) can hold the first hit.
// The second adjacent hit must lose even when it sits in the next word or vector.
// expect: run find_byte_order_and_range() = true
fn find_byte_order_and_range() -> bool {
    let sizes: Inline[u64, 2] =[75, 360]
    for n in sizes {
        let mut xs: Bytes = result.unwrap(list.with_capacity(n))
        result.unwrap(list.fill(mut xs, n, 1))
        for at in 0u64 .. n - 1 {
            xs[at] = 255
            xs[at + 1] = 255
            let matched = bound bytes 0 {
                list.find_byte(xs, 0, n, 255) == Some(at) && list.find_byte(xs, 0, at, 255) == None && list.find_byte(xs, at + 1, n, 255) == Some(at + 1)
            }
            match matched {
                Ok(true) => (),
                _ => return false,
            }
            xs[at] = 1
            xs[at + 1] = 1
        }
        if list.find_byte(xs, 1, n, 0) != None {
            return false
        }
    }
    true
}

// Differential check against an independent scalar scan across short and long
// spans, alignments, hits, and misses.
// expect: run find_byte_matches_scalar() = true
fn find_byte_matches_scalar() -> bool {
    let len: u64 = 389
    let mut xs: Bytes = result.unwrap(list.with_capacity(len))
    let mut state: u32 = 0x8c11d14b
    for _ in 0u64 .. len {
        state = int.wrapping_add(int.wrapping_mul(state, 1664525), 1013904223)
        let byte: u8 = int.narrow(state >> 24)
        result.unwrap(list.push(mut xs, byte))
    }
    for start in 0u64 .. 160 {
        state = int.wrapping_add(int.wrapping_mul(state, 1664525), 1013904223)
        let span: u64 = int.widen(state)
        let end = start + span % (len - start + 1)
        let byte: u8 = int.narrow(state >> 24)
        if list.find_byte(xs, start, end, byte) != find_byte_ref(xs, start, end, byte) {
            return false
        }
    }
    // Exercise misses and late hits right around the 160-byte SIMD crossover.
    let mut flat: Bytes = result.unwrap(list.with_capacity(200))
    result.unwrap(list.fill(mut flat, 200, b'z'))
    for n in 155u64 .. 166 {
        if list.find_byte(flat, 0, n, b'a') != None {
            return false
        }
        flat[n - 1] = b'a'
        if list.find_byte(flat, 0, n, b'a') != Some(n - 1) {
            return false
        }
        flat[n - 1] = b'z'
    }
    true
}

// Multi-delimiter search (2, 3, and 4 needles) across scalar, 16-byte SIMD,
// 32-byte SIMD, 128-byte four-vector group, leftover, and overlapping tail.
// expect: run find_byte4_order_and_range() = true
fn find_byte4_order_and_range() -> bool {
    let n: u64 = 360
    let mut xs: Bytes = result.unwrap(list.with_capacity(n))
    result.unwrap(list.fill(mut xs, n, b'z'))
    let needles: Inline[u8, 4] =[b'"', b',', 13, 10]
    for at in 0u64 .. n - 1 {
        let first_byte = needles[at % 4]
        let second_byte = needles[(at + 1) % 4]
        xs[at] = first_byte
        xs[at + 1] = second_byte
        let matched = bound bytes 0 {
            list.find_byte4(xs, 0, n, b'"', b',', 13, 10) == Some(at) && list.find_byte4(xs, 0, at, b'"', b',', 13, 10) == None && list.find_byte4(xs, at + 1, n, b'"', b',', 13, 10) == Some(at + 1)
        }
        match matched {
            Ok(true) => (),
            _ => return false,
        }
        xs[at] = b'z'
        xs[at + 1] = b'z'
    }
    // Check lengths 0..37 (scalar + 16-byte SIMD + 32-byte SIMD boundaries) for find_byte2/3/4.
    for len in 0u64 .. 38 {
        if list.find_byte2(xs, 0, len, b',', 10) != None || list.find_byte3(xs, 0, len, b',', 13, 10) != None || list.find_byte4(xs, 0, len, b'"', b',', 13, 10) != None {
            return false
        }
        if len > 0 {
            xs[len - 1] = 10
            let ok = list.find_byte2(xs, 0, len, b',', 10) == find_byte4_ref(xs, 0, len, b',', 10, b',', 10) && list.find_byte3(xs, 0, len, b',', 13, 10) == find_byte4_ref(xs, 0, len, b',', 13, 10, 10) && list.find_byte4(xs, 0, len, b'"', b',', 13, 10) == Some(len - 1)
            xs[len - 1] = b'z'
            if !ok {
                return false
            }
        }
    }
    true
}

// expect: run find_byte_reversed_range() = fail Bounds
fn find_byte_reversed_range() -> Option[u64] {
    list.find_byte(result.unwrap(b"abc"), 2, 1, b'b')
}

// expect: run find_byte4_past_end() = fail Bounds
fn find_byte4_past_end() -> Option[u64] {
    list.find_byte4(result.unwrap(b"abc"), 0, 4, b'"', b',', 13, 10)
}

// Under a tight step bound, long scans stop with Steps rather than escaping the bound.
// expect: run find_byte_step_bound() = true
fn find_byte_step_bound() -> bool {
    let mut xs: Bytes = result.unwrap(list.with_capacity(512))
    result.unwrap(list.fill(mut xs, 512, b'z'))
    xs[511] = b'a'
    let tight1 = bound steps 1 {
        list.find_byte(xs, 0, 512, b'a')
    }
    let tight4 = bound steps 1 {
        list.find_byte4(xs, 0, 512, b'"', b',', 13, b'a')
    }
    let ample1 = bound steps 10000 {
        list.find_byte(xs, 0, 512, b'a')
    }
    let ample4 = bound steps 10000 {
        list.find_byte4(xs, 0, 512, b'"', b',', 13, b'a')
    }
    let ok_t1 = match tight1 {
        Error(_) => true,
        Ok(_) => false,
    }
    let ok_t4 = match tight4 {
        Error(_) => true,
        Ok(_) => false,
    }
    let ok_a1 = match ample1 {
        Ok(Some(511)) => true,
        _ => false,
    }
    let ok_a4 = match ample4 {
        Ok(Some(511)) => true,
        _ => false,
    }
    ok_t1 && ok_t4 && ok_a1 && ok_a4
}

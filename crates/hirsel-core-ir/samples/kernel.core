fn f6 = n6 g1 {
  addr a0 = v0 byte v1 : ptr           ; data
  addr a1 = v0 byte v2 : u64           ; len: the live count
  addr a2 = v0 byte v3 : u64           ; capacity
  addr a3 = v0 byte v4 : u64           ; head
  addr a4 = v5 index v17 : t4          ; source: slot head + k
  addr a5 = v5 index v18 : t4          ; destination: slot dst + k
b0(v0: ptr):
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  v4: u64 = const 24
  address a0
  address a1
  address a2
  address a3
  v5: ptr = read a0
  v6: u64 = read a1
  v7: u64 = read a2
  v8: u64 = read a3
  v9: u64 = wrapping_add v8, v6
  v10: bool = lt v7, v9                ; the ring wraps

// S5 (core.md "Literals"): a byte-string literal is a static `Bytes` of capacity 0, like a
// string literal: no Result, nothing admitted or charged (each run ends with used 0).
// Hand-derived: b"a\x00\xff\n" is the bytes 97, 0, 255, 10; br#"x"y"# is 120, 34, 121;
// b"" has length 0; a literal's capacity is 0.
// expect: run at(0) = 97
// expect: run at(1) = 0
// expect: run at(2) = 255
// expect: run at(3) = 10
// expect: run at(4) = fail Bounds
// expect: run count(0) = 4
// expect: run raw(1) = 34
// expect: run empty(0) = 0
// expect: run cap(0) = 0
fn at(i: u64) -> u64 {
  let xs = b"a\x00\xff\n"
  int.widen(xs[i])
}
fn count(x: u64) -> u64 { list.len(b"a\x00\xff\n") + x }
fn raw(i: u64) -> u64 {
  let xs = br#"x"y"#
  int.widen(xs[i])
}
fn empty(x: u64) -> u64 { list.len(b"") + x }
fn cap(x: u64) -> u64 { list.capacity(b"abc") + x }

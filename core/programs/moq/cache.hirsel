// MOQ-6 tenant-scoped relay cache with MEM-24 logical size accounting, fair-share eviction,
// cross-publisher deduplication / malformed-track detection, and FETCH range assembly.
pub type RelayLimits: key {
    cache_groups: u32,
    cache_bytes: u64,
    per_track_cache_bytes: u64,
    max_objects_per_group: u32,
    max_object_bytes: u64
}

pub type RelayEvent = Authorize(session: u32, id: RequestId, scope: Scope, track: codec.TrackName, token: Option[Bytes]) | Evicted(scope: Scope, track: codec.TrackName, groups: u32, size: u64) | Ended(session: u32, code: u64)

/// One cached object in a group, holding a zero-copy Shared[Bytes] payload and its exact
/// MEM-24 logical charge.
type CachedObj {
    obj: Object,
    charge: u64
}

/// One cached group of a track, objects sorted ascending by object id.
type CacheGroup {
    group: u64,
    objects: List[CachedObj],
    used: u64
}

/// One tenant-scoped `(scope, track)` entry in the relay cache.
type CacheTrack {
    scope: Scope,
    track: codec.TrackName,
    groups: List[CacheGroup],
    used: u64,
    evicted_through: Option[u64],
    malformed: bool,
    track_end: Option[codec.Location],
    group_ends: List[(u64, u64)],
    subgroups: List[SubgroupMeta]
}

type Cache {
    limits: RelayLimits,
    tracks: List[CacheTrack],
    total_bytes: u64,
    evicted_groups: u64,
    evicted_bytes: u64
}

fn new_cache(limits: RelayLimits) -> Cache {
    Cache(limits: limits, tracks: list.new(), total_bytes: 0, evicted_groups: 0, evicted_bytes: 0)
}

/// MEM-24 logical size of one cached object: fixed record overhead + properties + payload.
pub fn object_logical_size(o: Object) -> u64 {
    4 * bytes[CachedObj] + retained_properties(o.properties) + track_storage(o.track) + quic.payload_retained_bytes(o.payload)
}

fn track_storage(t: codec.TrackName) -> u64 {
    let codec.Namespace(parts) = view t.ns
    let mut n = rounded_bytes(list.capacity(parts) * bytes[Bytes]) + rounded_bytes(list.capacity(t.name))
    for p in parts {
        n += rounded_bytes(list.capacity(p))
    }
    n
}

fn retained_properties(p: Bytes) -> u64 {
    rounded_bytes(list.capacity(p))
}

fn rounded_bytes(n: u64) -> u64 {
    (n + 7) / 8 * 8
}

fn cache_track_index(c: Cache, scope: Scope, tr: codec.TrackName) -> Option[u64] {
    for i in 0u64 .. list.len(c.tracks) {
        if c.tracks[i].scope == scope && c.tracks[i].track == tr {
            return Some(i)
        }
    }
    None
}

fn ensure_cache_track(mut c: Cache, take scope: Scope, take tr: codec.TrackName) -> u64 {
    if let Some(i) = cache_track_index(c, scope, tr) {
        return i
    }
    list.push(mut c.tracks, CacheTrack(scope: take scope, track: take tr, groups: list.new(), used: 0, evicted_through: None, malformed: false, track_end: None, group_ends: list.new(), subgroups: list.new()))
    list.len(c.tracks) - 1
}

fn cache_group_index(ct: CacheTrack, group: u64) -> Option[u64] {
    for i in 0u64 .. list.len(ct.groups) {
        if ct.groups[i].group == group {
            return Some(i)
        }
    }
    None
}

/// Result of checking an incoming object against `(scope, track)`'s cache / dedup state.
type CacheCheck: key = Fresh | Duplicate | BadTrack

fn cache_check_object(c: Cache, ti: u64, o: Object) -> CacheCheck {
    if c.tracks[ti].malformed {
        return BadTrack
    }
    let loc = codec.Location(group: o.group, object: o.id)
    if let Some(te) = c.tracks[ti].track_end {
        if loc_gt(loc, te) {
            return BadTrack
        }
    }
    for ge in c.tracks[ti].group_ends {
        let (g, last_o) = ge
        if g == o.group && o.id > last_o {
            return BadTrack
        }
    }
    if o.mode == Subgroup {
        for sm in c.tracks[ti].subgroups {
            if sm.group == o.group && sm.subgroup == o.subgroup {
                if sm.priority != o.publisher_priority {
                    return BadTrack
                }
                if let Some(fo) = sm.final_obj {
                    if o.id > fo {
                        return BadTrack
                    }
                }
            }
        }
    }
    if let Some(gi) = cache_group_index(c.tracks[ti], o.group) {
        for co in c.tracks[ti].groups[gi].objects {
            if co.obj.id == o.id {
                let same = co.obj.mode == o.mode && co.obj.subgroup == o.subgroup && co.obj.publisher_priority == o.publisher_priority && co.obj.status == o.status && co.obj.properties == o.properties && payload_eq(co.obj.payload, o.payload)
                if same {
                    return Duplicate
                }
                return BadTrack
            }
        }
    }
    Fresh
}

/// Evict the oldest group from track `ti` and report `RelayEvent.Evicted`.
fn evict_oldest_group(mut c: Cache, ti: u64, mut out: List[RelayEvent]) -> bool {
    if list.len(c.tracks[ti].groups) == 0 {
        return false
    }
    let CacheGroup(group: gid, objects: _, used: sz) = list.remove(mut c.tracks[ti].groups, 0)
    c.tracks[ti].used -= sz
    c.total_bytes -= sz
    c.evicted_groups += 1
    c.evicted_bytes += sz
    let prev = c.tracks[ti].evicted_through
    c.tracks[ti].evicted_through = match prev {
        None => Some(gid),
        Some(p) => Some(order.max(p, gid)),
    }
    let sc: Scope = clone(c.tracks[ti].scope)
    let tr: codec.TrackName = clone(c.tracks[ti].track)
    list.push(mut out, Evicted(scope: take sc, track: take tr, groups: 1, size: sz))
    true
}

/// Pick the cached track furthest over its fair share of `cache_bytes` (MOQ-6 / M9).
/// Since fair share `cache_bytes / n_tracks` is identical across all cached tracks, the track
/// furthest above fair share is the non-empty track with the largest `bytes`.
fn track_furthest_over_share(c: Cache, incoming_track: u64, charge: u64) -> Option[u64] {
    let mut best: Option[u64] = None
    let mut best_bytes = 0u64
    for i in 0u64 .. list.len(c.tracks) {
        if list.len(c.tracks[i].groups) == 0 {
            continue
        }
        let size = if i == incoming_track {
            int.saturating_add(c.tracks[i].used, charge)
        } else {
            c.tracks[i].used
        }
        if best == None || size > best_bytes {
            best = Some(i)
            best_bytes = size
        }
    }
    best
}

/// Insert a validated fresh object into the tenant-scoped cache, enforcing every bound in
/// `RelayLimits` (MOQ-6 / M9). Objects exceeding `max_object_bytes` or single-track/total
/// limits are not cached (the relay still forwards them).
fn cache_insert(mut c: Cache, ti: u64, take o: Object, mut out: List[RelayEvent]) {
    // Record subgroup priority and group/track end metadata for §12.1.
    if o.mode == Subgroup {
        let mut found = false
        for sm in c.tracks[ti].subgroups {
            if sm.group == o.group && sm.subgroup == o.subgroup {
                found = true
                break
            }
        }
        if !found {
            if list.len(c.tracks[ti].subgroups) >= 512 {
                let _ = list.remove(mut c.tracks[ti].subgroups, 0)
            }
            list.push(mut c.tracks[ti].subgroups, SubgroupMeta(group: o.group, subgroup: o.subgroup, priority: o.publisher_priority, final_obj: None))
        }
    }
    if o.status == EndOfGroup {
        list.push(mut c.tracks[ti].group_ends, (o.group, o.id))
    }
    if o.status == EndOfTrack {
        c.tracks[ti].track_end = Some(codec.Location(group: o.group, object: o.id))
    }
    let charge = object_logical_size(o)
    if charge > c.limits.max_object_bytes || charge > c.limits.per_track_cache_bytes || charge > c.limits.cache_bytes || c.limits.cache_groups == 0 || c.limits.max_objects_per_group == 0 {
        return
    }
    let need_new_group = cache_group_index(c.tracks[ti], o.group) == None
    if need_new_group {
        let max_g: u64 = int.widen(c.limits.cache_groups)
        while list.len(c.tracks[ti].groups) >= max_g && list.len(c.tracks[ti].groups) > 0 {
            let _ = evict_oldest_group(mut c, ti, mut out)
        }
    }
    // Enforce per-track byte bound.
    while charge > c.limits.per_track_cache_bytes - c.tracks[ti].used {
        if !evict_oldest_group(mut c, ti, mut out) {
            return
        }
    }
    // Enforce relay-wide cache_bytes via fair-share eviction.
    while charge > c.limits.cache_bytes - c.total_bytes {
        let Some(victim) = track_furthest_over_share(c, ti, charge) else {
            return
        }
        if !evict_oldest_group(mut c, victim, mut out) {
            return
        }
    }
    // Re-locate (or create) the target group sorted by group id.
    let gi = match cache_group_index(c.tracks[ti], o.group) {
        Some(idx) => idx,
        None => {
            let mut pos = list.len(c.tracks[ti].groups)
            for k in 0u64 .. list.len(c.tracks[ti].groups) {
                if c.tracks[ti].groups[k].group > o.group {
                    pos = k
                    break
                }
            }
            let cg = CacheGroup(group: o.group, objects: list.new(), used: 0)
            list.push(mut c.tracks[ti].groups, take cg)
            let mut m = list.len(c.tracks[ti].groups) - 1
            while m > pos {
                list.swap(mut c.tracks[ti].groups, m - 1, m)
                m -= 1
            }
            pos
        },
    }
    let max_objs: u64 = int.widen(c.limits.max_objects_per_group)
    if list.len(c.tracks[ti].groups[gi].objects) >= max_objs {
        return
    }
    // Insert object in ascending object id order.
    let oid = o.id
    let mut opos = list.len(c.tracks[ti].groups[gi].objects)
    for k in 0u64 .. list.len(c.tracks[ti].groups[gi].objects) {
        if c.tracks[ti].groups[gi].objects[k].obj.id > oid {
            opos = k
            break
        }
    }
    list.push(mut c.tracks[ti].groups[gi].objects, CachedObj(obj: take o, charge: charge))
    let mut m = list.len(c.tracks[ti].groups[gi].objects) - 1
    while m > opos {
        list.swap(mut c.tracks[ti].groups[gi].objects, m - 1, m)
        m -= 1
    }
    c.tracks[ti].groups[gi].used += charge
    c.tracks[ti].used += charge
    c.total_bytes += charge
}

/// Build FETCH reply entries from cache for `(scope, tr)` covering `[from, to]`.
/// Missing / evicted ranges are emitted as `ReplyUnknown` (End of Unknown Range, §11.4.2),
/// never as non-existent objects (MOQ-6 / M9).
fn cache_fetch_entries(c: Cache, scope: Scope, tr: codec.TrackName, from: codec.Location, to: codec.Location) -> List[FetchReplyEntry] {
    let mut entries: List[FetchReplyEntry] = list.new()
    if loc_gt(from, to) {
        return take entries
    }
    let Some(ti) = cache_track_index(c, scope, tr) else {
        list.push(mut entries, ReplyUnknown(end: to))
        return take entries
    }
    let mut cursor_g = from.group
    let mut cursor_o = from.object
    let mut has_any_held = false
    for gi in 0u64 .. list.len(c.tracks[ti].groups) {
        let g = c.tracks[ti].groups[gi].group
        if g < from.group {
            continue
        }
        if g > to.group {
            break
        }
        if g > cursor_g {
            // Groups [cursor_g .. g - 1] are not in cache -> End of Unknown Range.
            list.push(mut entries, ReplyUnknown(end: codec.Location(group: g - 1, object: 0xffffffffffffffff)))
            cursor_g = g
            cursor_o = 0
        }
        for oi in 0u64 .. list.len(c.tracks[ti].groups[gi].objects) {
            let obj = c.tracks[ti].groups[gi].objects[oi].obj
            let loc = codec.Location(group: g, object: obj.id)
            if loc_gt(from, loc) || loc_gt(loc, to) {
                continue
            }
            list.push(mut entries, ReplyObject(clone(obj)))
            has_any_held = true
            cursor_g = g
            cursor_o = int.saturating_add(obj.id, 1)
        }
        if cursor_g == g {
            if g == 0xffffffffffffffff {
                break
            }
            cursor_g = int.saturating_add(g, 1)
            cursor_o = 0
        }
    }
    if !has_any_held {
        list.clear(mut entries)
        list.push(mut entries, ReplyUnknown(end: to))
    } else if cursor_g <= to.group && to.group < 0xffffffffffffffff {
        list.push(mut entries, ReplyUnknown(end: to))
    }
    let _ = cursor_o
    take entries
}

; CoreIR sample, family: slot kernels (FORM v1c: `mark`, a core finalizer on an own row).
;
; Source (core@1 module deque, and package samples@0, module kernel):
;   type Slots[T] { raw: List[T] }           ; the live count is the carrier's len word
;   type Deque[T] { ring: Slots[T], head: u64 } drop { move the live slots into the
;                                               prefix 0..len, front first; head = 0 }
;   fn push_back(d: Deque[T], x: T)   ; slot (head + len) % cap: put, len + 1
;   fn pop_front(d: Deque[T])         ; slot head: drop (a take), head + 1, len - 1
;   fn reverse(data, lo, hi)          ; swap slots lo..hi end for end (all live)
;   resource Res { id: u64 }          ; no finalizer: mechanical cleanup
;   fn ring() { let d = Deque with capacity 4; push 1, 2, 3; pop; pop; push 4, 5 }
;
; Deque[Res] is 32 bytes: data @0, len @8, capacity @16, head @24. Its storage holds
; four 8-byte slots, charged seq(4, 8) = 32; each Res is charged 40. A put is marked
; `live`, a move's source `empty` and its destination `live`; a `drop` of a marked
; slot, or List cleanup of one, is a take. The evaluator stops the run on a take of
; an empty slot, a put over a live one, a read of an empty one, or a free of the
; storage while a slot is live. Engines emit nothing for a mark.
;
; The finalizer only moves, and its arithmetic wraps under the ring's invariants, so it
; cannot fail (wf refuses an own row's finalizer that may); the List field's cleanup then drops
; the prefix front first, resuming past a failed drop as any List does (FAIL-12).
;
; Behaviour, derived by hand (trace: Res ids in the order their cleanup started).
; After the pushes and pops, head is 2 and len 3: slot 2 holds 3, slot 3 holds 4 and
; slot 0 holds 5 (the ring wraps; slot 1 is empty). The finalizer moves slots 2, 3 to
; 1, 2 (giving 5, 3, 4), rotates the prefix left by one (3, 4, 5) and sets head 0;
; the List then drops 3, 4, 5 and frees the storage. Without the finalizer the List
; would reach the emptied slot 1:
; run: f4() -> | used 0 | trace 1, 2, 3, 4, 5
; Counted cleanup runs a row with a finalizer whole, as one step. f5 makes an Rc
; node (charged counted(32) = 40) whose payload is a Deque[Item] of capacity 4
; (charged 32) holding one Item at slot 2 (head 2, len 1), whose box is charged 8.
; The release at zero runs Deque's finalizer, which moves slot 2 to slot 0; the List
; then drops it (freeing the box) and frees the storage, and the node is freed.
; Without the finalizer the List would drop slot 0, which holds nothing:
; run: f5() -> | used 0
core v1
item i0 = samples@0/kernel/ring
type t0 = resource "Res" { id: u64 }
type t1 = own "Slots[Res]" { raw: seq t0 }
type t2 = own "Deque[Res]" drop f1 { ring: t1, head: u64 }
type t3 = own "Leaf" { x: u64 }
type t4 = own "Item" { b: box t3 }
type t5 = own "Slots[Item]" { raw: seq t4 }
type t6 = own "Deque[Item]" drop f6 { ring: t5, head: u64 }
sig g0 = (u64) -> (ptr)
sig g1 = (ptr) -> ()
sig g2 = (ptr, ptr) -> ()
sig g3 = () -> ()
sig g4 = (ptr, u64, u64) -> ()
inst n0 = samples@0/kernel/mk [] []
inst n1 = core@1/deque/Deque.drop ["Res"] []
inst n2 = core@1/deque/push_back ["Res"] []
inst n3 = core@1/deque/pop_front ["Res"] []
inst n4 = samples@0/kernel/ring [] []
inst n5 = samples@0/kernel/shared [] []
inst n6 = core@1/deque/Deque.drop ["Item"] []
inst n7 = core@1/deque/reverse ["Res"] []
inst n8 = core@1/deque/reverse ["Item"] []
fn f0 = n0 g0 {
  addr a0 = v2 : t0
  addr a1 = a0 field 0 : u64
b0(v0: u64):
  v1: u64 = const 40
  v4: u64 = const 8
  v2: ptr, v3: u64 = alloc resource grant 0 v4 align 8 charge v1
  v5: ptr = const 0x0
  v6: bool = ne v2, v5
  branch v6, b1, b2
b1:
  address a0
  address a1
  store a1, v0
  return v2
b2:
  raise unwrap
}
fn f1 = n1 g1 {
  addr a0 = v0 byte v1 : ptr           ; data
  addr a1 = v0 byte v2 : u64           ; len: the live count
  addr a2 = v0 byte v3 : u64           ; capacity
  addr a3 = v0 byte v4 : u64           ; head
  addr a4 = v5 index v17 : t0          ; source: slot head + k
  addr a5 = v5 index v18 : t0          ; destination: slot dst + k
b0(v0: ptr):
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  v4: u64 = const 24
  address a0
  address a1
  address a2
  address a3
  v5: ptr = read a0
  v6: u64 = read a1
  v7: u64 = read a2
  v8: u64 = read a3
  v9: u64 = wrapping_add v8, v6
  v10: bool = lt v7, v9                ; the ring wraps
  v11: u64 = wrapping_sub v7, v8
  branch v10, b1, b2
b1:
  v12: u64 = wrapping_sub v9, v7                ; the wrapped part's length
  jump b3(v11, v12)
b2:
  jump b3(v6, v1)
b3(v13: u64, v14: u64):                ; move v13 slots from head down to v14
  jump b4(v1)
b4(v15: u64):
  v16: bool = lt v15, v13
  branch v16, b5, b6
b5:
  v17: u64 = wrapping_add v8, v15
  v18: u64 = wrapping_add v14, v15
  address a4
  address a5
  copy a5, a4, v2
  mark a4, empty : t0
  mark a5, live : t0
  v19: u64 = const 1
  v20: u64 = wrapping_add v15, v19
  jump b4(v20)
b6:                                    ; rotate the prefix left by v14
  call f7 g4 (v5, v1, v14)
  call f7 g4 (v5, v14, v6)
  call f7 g4 (v5, v1, v6)
  store a3, v1
  return
}
fn f2 = n2 g2 {
  addr a0 = v0 byte v2 : ptr           ; data
  addr a1 = v0 byte v3 : u64           ; len
  addr a2 = v0 byte v4 : u64           ; capacity
  addr a3 = v0 byte v5 : u64           ; head
  addr a4 = v6 index v11 : ptr         ; slot (head + len) % capacity
  addr a5 = v6 index v11 : t0
b0(v0: ptr, v1: ptr):
  v2: u64 = const 0
  v3: u64 = const 8
  v4: u64 = const 16
  v5: u64 = const 24
  address a0
  address a1
  address a2
  address a3
  v6: ptr = read a0

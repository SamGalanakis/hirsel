// Transport abstraction over native QUIC and WebTransport (MOQ-1).
// Every stream and datagram call routes through quic for Native and webtransport for Web,
// preserving WebTransport's session flow control (WT-2).
fn tx_conn(t: Transport) -> quic.ConnectionHandle {
    match t {
        Native(c: c) => c,
        Web(s: sh) => {
            let webtransport.SessionHandle(conn: c, ..) = sh
            c
        },
    }
}

fn tx_is_web(t: Transport) -> bool {
    match t {
        Native(..) => false,
        Web(..) => true,
    }
}

fn tx_open(t: Transport, mut io: Io, bidi: bool) -> Result[quic.StreamId, MoqError] {
    match t {
        Native(c: c) => match quic.open(mut io.q, c, bidi) {
            Ok(id) => Ok(id),
            Error(e) => Error(Quic(e)),
        },
        Web(s: sh) => match io.w {
            Some(mut w) => match webtransport.open(mut w, mut io.q, sh, bidi) {
                Ok(id) => Ok(id),
                Error(e) => Error(Web(e)),
            },
            None => Error(State),
        },
    }
}

fn tx_read(t: Transport, mut io: Io, stream: quic.StreamId, mut into: Bytes) -> Result[(u64, bool), MoqError] {
    match t {
        Native(c: c) => match quic.read(mut io.q, c, stream, mut into) {
            Ok(r) => Ok(r),
            Error(e) => Error(Quic(e)),
        },
        Web(s: sh) => match io.w {
            Some(mut w) => match webtransport.read(mut w, mut io.q, sh, stream, mut into) {
                Ok(r) => Ok(r),
                Error(e) => Error(Web(e)),
            },
            None => Error(State),
        },
    }
}

fn tx_write(t: Transport, mut io: Io, stream: quic.StreamId, data: Bytes, fin: bool) -> Result[u64, MoqError] {
    match t {
        Native(c: c) => match quic.write(mut io.q, c, stream, data, fin) {
            Ok(n) => Ok(n),
            Error(e) => Error(Quic(e)),
        },
        Web(s: sh) => match io.w {
            Some(mut w) => match webtransport.write(mut w, mut io.q, sh, stream, data, fin) {
                Ok(n) => Ok(n),
                Error(e) => Error(Web(e)),
            },
            None => Error(State),
        },
    }
}

fn tx_write_shared(t: Transport, mut io: Io, stream: quic.StreamId, take data: Shared[Bytes], fin: bool) -> Result[bool, MoqError] {
    match t {
        Native(c: c) => match quic.write_shared(mut io.q, c, stream, take data, fin) {
            Ok(b) => Ok(b),
            Error(e) => Error(Quic(e)),
        },
        Web(s: sh) => match io.w {
            Some(mut w) => match webtransport.write_shared(mut w, mut io.q, sh, stream, take data, fin) {
                Ok(b) => Ok(b),
                Error(e) => Error(Web(e)),
            },
            None => Error(State),
        },
    }
}

fn tx_reset(t: Transport, mut io: Io, stream: quic.StreamId, code: u64, reliable: u64) {
    match t {
        Native(c: c) => {
            if let Error(_) = quic.reset(mut io.q, c, stream, code, reliable) {
                let _ = quic.reset(mut io.q, c, stream, code, 0)
            }
        },
        Web(s: sh) => {
            if let Some(mut w) = io.w {
                let c32: u32 = int.truncate(code)
                let _ = webtransport.reset(mut w, mut io.q, sh, stream, c32)
            }
        },
    }
}

fn tx_stop(t: Transport, mut io: Io, stream: quic.StreamId, code: u64) {
    match t {
        Native(c: c) => {
            let _ = quic.stop(mut io.q, c, stream, code)
        },
        Web(s: sh) => {
            if let Some(mut w) = io.w {
                let c32: u32 = int.truncate(code)
                let _ = webtransport.stop(mut w, mut io.q, sh, stream, c32)
            }
        },
    }
}

fn tx_priority(t: Transport, mut io: Io, stream: quic.StreamId, p: quic.Priority) {
    let _ = quic.priority(mut io.q, tx_conn(t), stream, p)
}

fn tx_send_datagram(t: Transport, mut io: Io, take data: Shared[Bytes], p: quic.Priority, tag: u64) -> Result[(), MoqError] {
    match t {
        Native(c: c) => match quic.send_datagram(mut io.q, c, take data, p, tag) {
            Ok(()) => Ok(()),
            Error(e) => Error(Quic(e)),
        },
        Web(s: sh) => match io.w {
            Some(mut w) => match webtransport.send_datagram(mut w, mut io.q, sh, data, p, tag) {
                Ok(()) => Ok(()),
                Error(e) => Error(Web(e)),
            },
            None => Error(State),
        },
    }
}

fn tx_drop_datagrams(t: Transport, mut io: Io, tag: u64) -> u64 {
    quic.drop_datagrams(mut io.q, tx_conn(t), tag)
}

fn tx_close(t: Transport, mut io: Io, code: u64, reason: Bytes) {
    match t {
        Native(c: c) => quic.close(mut io.q, c, code, clone(reason)),
        Web(s: sh) => {
            if let Some(mut w) = io.w {
                let c32: u32 = int.truncate(code)
                webtransport.close(mut w, mut io.q, sh, c32, reason)
            }
        },
    }
}

/// Read available bytes from `stream` onto `buf` up to `buf`'s capacity.
/// Returns `(fin, reset_code)`.
fn tx_read_more(t: Transport, mut io: Io, stream: quic.StreamId, mut buf: Bytes) -> (bool, Option[u64]) {
    loop {
        if list.len(buf) >= list.capacity(buf) {
            return (false, None)
        }
        match tx_read(t, mut io, stream, mut buf) {
            Ok((n, fin)) => {
                if fin {
                    return (true, None)
                }
                if n == 0 {
                    return (false, None)
                }
            },
            Error(Quic(StreamReset(code))) => return (true, Some(code)),
            Error(Web(Quic(StreamReset(code)))) => return (true, Some(code)),
            Error(_) => return (false, None),
        }
    }
}

// ---- Outgoing stream queue (flushed on Writable) ----
fn out_index(s: Session, stream: quic.StreamId) -> Option[u64] {
    for i in 0u64 .. list.len(s.outgoing) {
        if s.outgoing[i].stream == stream {
            return Some(i)
        }
    }
    None
}

fn drop_outgoing(mut s: Session, stream: quic.StreamId) {
    if let Some(i) = out_index(s, stream) {
        let _ = list.remove(mut s.outgoing, i)
    }
}

fn enqueue_raw(mut s: Session, mut io: Io, stream: quic.StreamId, take data: Bytes, fin: bool) {
    if let Some(i) = out_index(s, stream) {
        if list.len(data) > 0 {
            list.push(mut s.outgoing[i].chunks, Raw(take data))
        }
        s.outgoing[i].fin = s.outgoing[i].fin || fin
        flush_outgoing(mut s, mut io, stream)
        return
    }
    let n = match tx_write(s.transport, mut io, stream, data, fin) {
        Ok(n) => n,
        Error(_) => return,
    }
    if n < list.len(data) || (list.len(data) == 0 && fin && n == 0) {
        let mut chunks: List[OutChunk] = list.new()
        if n < list.len(data) {
            let mut rest: Bytes = list.with_capacity(list.len(data) - n)
            list.append(mut rest, list.slice(data, n, list.len(data)))
            list.push(mut chunks, Raw(take rest))
        }
        list.push(mut s.outgoing, Outgoing(stream: stream, chunks: take chunks, offset: 0, fin: fin))
    }
}

/// Queue a zero-copy Shared[Bytes] payload onto `stream`. Returns true if handed to transport
/// immediately, false if buffered waiting for Writable.
fn enqueue_shared(mut s: Session, mut io: Io, stream: quic.StreamId, take data: Shared[Bytes], fin: bool) -> bool {
    if let Some(i) = out_index(s, stream) {
        if list.len(data) > 0 {
            list.push(mut s.outgoing[i].chunks, SharedChunk(take data))
        }
        s.outgoing[i].fin = s.outgoing[i].fin || fin
        flush_outgoing(mut s, mut io, stream)
        return out_index(s, stream) == None
    }
    match tx_write_shared(s.transport, mut io, stream, clone(data), fin) {
        Ok(true) => true,
        Ok(false) => {
            let mut chunks: List[OutChunk] = list.new()
            list.push(mut chunks, SharedChunk(take data))
            list.push(mut s.outgoing, Outgoing(stream: stream, chunks: take chunks, offset: 0, fin: fin))
            false
        },
        Error(_) => false,
    }
}

fn flush_outgoing(mut s: Session, mut io: Io, stream: quic.StreamId) {
    let Some(i) = out_index(s, stream) else {
        return
    }
    loop {
        if list.len(s.outgoing[i].chunks) == 0 {
            if s.outgoing[i].fin {
                let _ = tx_write(s.transport, mut io, stream, b"", true)
            }
            let _ = list.remove(mut s.outgoing, i)
            return
        }
        let last = list.len(s.outgoing[i].chunks) == 1
        let fin = last && s.outgoing[i].fin
        let kind = match s.outgoing[i].chunks[0] {
            Raw(_) => 0u8,
            SharedChunk(_) => 1u8,
        }
        if kind == 0 {
            let off = s.outgoing[i].offset
            let mut part: Bytes = list.new()
            if let Raw(b) = s.outgoing[i].chunks[0] {
                let slice_len = list.len(b) - off
                let _ = list.try_reserve(mut part, slice_len)
                list.append(mut part, list.slice(b, off, list.len(b)))
            }
            let slice_len = list.len(part)
            match tx_write(s.transport, mut io, stream, part, fin) {
                Ok(n) => {
                    if n == slice_len {
                        let _ = list.remove(mut s.outgoing[i].chunks, 0)
                        s.outgoing[i].offset = 0
                        if fin {
                            let _ = list.remove(mut s.outgoing, i)
                            return
                        }
                    } else if n > 0 {
                        s.outgoing[i].offset = off + n
                        return
                    } else {
                        return
                    }
                },
                Error(_) => {
                    let _ = list.remove(mut s.outgoing, i)
                    return
                },
            }
        } else {
            let mut sh_opt: Option[Shared[Bytes]] = None
            if let SharedChunk(sh) = s.outgoing[i].chunks[0] {
                sh_opt = Some(clone(sh))
            }
            let Some(take sh) = take sh_opt else {
                return
            }
            match tx_write_shared(s.transport, mut io, stream, take sh, fin) {
                Ok(true) => {
                    let _ = list.remove(mut s.outgoing[i].chunks, 0)
                    s.outgoing[i].offset = 0
                    if fin {
                        let _ = list.remove(mut s.outgoing, i)
                        return
                    }
                },
                Ok(false) => return,
                Error(_) => {
                    let _ = list.remove(mut s.outgoing, i)
                    return
                },
            }
        }
    }
}

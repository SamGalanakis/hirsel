const SEEDS: Inline[u64, 4] = [11, 23, 47, 97]
const ROUND_ITERATIONS: u64 = 16384
const TARGET: u64 = 26
const PREFERENCE_SEED: u64 = 10723151780598845931

fn random(state: u64) -> u64 {
    let x = state ^ (state << 13)
    let y = x ^ (x >> 7)
    y ^ (y << 17)
}

fn energy(bits: u64, unary: u64, edges: u64) -> u64 {
    let sites: u64 = int.widen(int.count_ones(bits ^ unary))
    let breaks: u64 = int.widen(int.count_ones(((bits ^ (bits >> 1)) ^ edges) & 9223372036854775807))
    sites + 2 * breaks
}

type Search: codec {
    random_state: u64,
    bits: u64,
    cost: u64
}

type Reply: codec {
    iterations: u64,
    cost: u64,
    witness: u64
}

fn stage(take initial: Search, key: u64, target: u64) -> (Search, Option[Reply]) {
    let mut search = initial
    let unary = random(PREFERENCE_SEED)
    let edges = random(unary)
    let mut iterations: u64 = 0
    while iterations < ROUND_ITERATIONS {
        search.random_state = random(search.random_state)
        let restart = (iterations & 127) == 0
        let bits = if restart {
            search.random_state
        } else {
            search.bits ^ (1u64 << ((search.random_state >> 32) & 63))
        }
        let cost = energy(bits, unary, edges)
        if restart || cost <= search.cost || (cost == search.cost + 1 && (search.random_state & 15) == 0) {
            search.bits = bits
            search.cost = cost
        }
        iterations += 1
        if search.cost == target { break }
    }
    (search, Some(Reply(iterations: iterations, cost: search.cost, witness: search.bits)))
}

pub fn main(tasks: Tasks, out: Stdout, clock: Clock) -> Result[(), Exit] waits {
    let start = host.mono_ns(clock)
    let mut f = flow.new()
    let mut lanes: List[(Port[u64], Sink[Reply])] = list.with_capacity(4)
    for seed in SEEDS {
        let search = Search(random_state: seed, bits: 0, cost: 0)
        let (sink, into): (Sink[Reply], Into[Reply]) = result.unwrap(flow.sink(mut f))
        let input = result.unwrap(flow.stage(mut f, into, 1, bytes 0, steps 2000000, search, code.describe(stage)))
        let port = result.unwrap(flow.port(mut f, input, 1))
        list.push(mut lanes, (port, sink))
    }

    let mut iterations: u64 = 0
    let mut key: u64 = 0
    let mut found = false
    let mut witness: u64 = 0
    let mut lag_bound: u64 = 0
    while !found {
        let round_start = host.mono_ns(clock)
        for i in 0u64 .. 4 {
            let (port, _) = lanes[i]
            match flow.push(mut f, port, key, TARGET) {
                Ok => (),
                _ => fail("portfolio request")
            }
        }
        for i in 0u64 .. 4 {
            let (_, sink) = lanes[i]
            match flow.next(mut f, sink) {
                Item(key: _, from: _, x: reply) => {
                    iterations += reply.iterations
                    if reply.cost == TARGET && !found {
                        witness = reply.witness
                        found = true
                    }
                },
                _ => fail("portfolio reply")
            }
        }
        key += 1
        if found {
            lag_bound = host.mono_ns(clock) - round_start
        }
    }
    result.unwrap(flow.finish(take f))
    let elapsed = host.mono_ns(clock) - start
    let mut line = string.new()
    let fields: Inline[u64, 7] = [elapsed, iterations, TARGET, witness, 0, lag_bound, key]
    for field in fields {
        string.push_u64(mut line, field)
        string.push(mut line, " ")
    }
    string.push(mut line, "\n")
    result.unwrap(stdout.write(out, line))
    Ok(())
}

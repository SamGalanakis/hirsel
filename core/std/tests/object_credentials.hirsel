// test-of: std.object
// test-reason: Exercise the private validation and atomic swap with a scripted S3 peer.
fn serve_credential_fixture(take fixture: (sim.s3.Config, Served[NetOp], Clock)) -> sim.s3.Report waits {
    let (config, port, clock) = take fixture
    let mut plan = sim.world.plan(23)
    sim.s3.serve(config, mut plan, clock, take port)
}

fn run_credential_clock(take w: sim.world.World) waits {
    let mut world = take w
    sim.world.run(mut world)
}

fn fixture_secret() -> Secret {
    let data = string.into_bytes(string.from("wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"))
    result.unwrap(secret.seal(take data, "kdf"))
}

// expect: run credential_swap_keeps_current_on_403(tasks) = true
fn credential_swap_keeps_current_on_403(tasks: Tasks) -> bool waits {
    let (world, clock) = sim.world.new(23, 0, 1369353600000)
    let driver = task.spawn(tasks, bytes 65536, take world, run_credential_clock)
    let ip = V4(2130706433)
    let addr = Addr(ip, port: 8080)
    let mut model = sim.net.new(sim.net.defaults())
    let mut ips: List[Ip] = list.with_capacity(1)
    list.push(mut ips, ip)
    sim.net.resolve_as(mut model, string.from("bucket.s3.test"), take ips)
    // AWS's example key, derived for 20130524/us-east-1/s3/aws4_request.
    let digest: Inline[u8, 32] =[219, 184, 147, 172, 192, 16, 150, 73, 24, 241, 253, 67, 58, 221, 135, 199, 14, 139, 13, 182, 190, 48, 193, 251, 234, 254, 250, 94, 198, 186, 131, 120]
    let mut key: Bytes = list.with_capacity(32)
    let _ = bytebuf.append_inline(mut key, digest, 0, 32)
    let sealed = result.unwrap(secret.seal(take key, "verify"))
    let config = sim.s3.Config(address: addr, network: take model, after_resolve: None, credential: "AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request", signing_key: take sealed, faults: list.new(), exists_status: 412, fragment_bytes: 64, max_body: 65536)
    let (network, port) = provide.net(bytes 65536)
    let fixture = (take config, take port, clock)
    let peer = task.spawn(tasks, bytes 1048576, take fixture, serve_credential_fixture)
    let bucket = Bucket(endpoint: "http://s3.test:8080", aws_region: "us-east-1", bucket: "bucket", prefix: "", style: Virtual)
    let server = result.unwrap(endpoint(bucket, System))
    let (tx, rx): (Sender[PoolMessage], Receiver[PoolMessage]) = channel.new(4)
    let (lease_tx, lease): (Sender[PoolReply], Receiver[PoolReply]) = channel.new(1)
    let mut replies: List[Sender[PoolReply]] = list.with_capacity(1)
    list.push(mut replies, take lease_tx)
    let mut peers: List[Peer] = list.with_capacity(1)
    result.unwrap(resolve_peers(network, clock, server.name, 1000000, mut peers))
    let pool = Pool(network, clock, tasks, server: clone(server), input: take rx, timer_tx: channel.sender(tx), replies: take replies, peers: take peers)
    let resolver = task.spawn(tasks, bytes 1048576, take pool, pool_loop)
    let mut check = Restore(clock, network, server: take server, pool: take tx, lease: take lease, index: 0, config: take bucket, wire: wire_buffers())
    let good = cred.from_secret("AKIAIOSFODNN7EXAMPLE", fixture_secret(), "active")
    let mut current = result.unwrap(auth_state(clock, "us-east-1", take good))
    let bad = cred.from_secret("DENIED", fixture_secret(), "rejected")
    let rejected = !adopt(mut check, mut current, take bad, 1000000)
    let preserved = current.credentials.session_token == "active"
    let next = cred.from_secret("AKIAIOSFODNN7EXAMPLE", fixture_secret(), "accepted")
    let accepted = adopt(mut check, mut current, take next, 1000000)
    let _ = take check
    let _ = take resolver
    let observed = result.unwrap(task.join(take peer))
    result.unwrap(task.join(take driver))
    rejected && preserved && accepted && current.credentials.session_token == "accepted" && observed.attempts == 2 && observed.writes == 0
}

// RTC-5 units and RTC-7's fence across them (webrtc spec, slice S5). Every media unit
// runs one Router over its own socket; unit 0 is the control unit, which makes every
// control call. A unit's steps are separate functions so a test can interleave them
// (W14); `turn` runs them in RTC-5's order over a real socket.
/// A control order or acknowledgement, with a publication's Opus parameters.
pub type ControlMessage: cross {
    step: router.Control,
    opus_fmtp: Option[Shared[Bytes]]
}

/// The doors of one unit, which every other unit holds: its control inbox, its media
/// inbox and the address of its socket, where doorbells go.
pub type Doors: cross {
    control: Client[ControlMessage],
    media: Client[router.Carried],
    addr: Addr
}

/// What a unit counts beyond its Router: the messages it took from its media inbox
/// by kind, doorbells from addresses that are not a sibling's, media messages
/// dropped because the receiving inbox was full, datagrams `udp_send` refused one
/// by one, and datagrams the socket truncated.
pub type UnitCounts: key {
    // Messages taken from the media inbox, by kind.
    media: u64,
    asks: u64,
    replies: u64,
    forged: u64,
    full: u64,
    refused: u64,
    truncated: u64
}

/// One datagram a unit passed to `udp_send` and the kernel committed, with its tag
/// and bytes (the test seam's tap; W15, W8).
pub type Sent {
    to: Addr,
    tag: peer.Tag,
    data: Bytes
}

/// The control plane's sizes (RTC-10, The control plane): at most `inflight` ordinary
/// control calls in flight across the pool, one per room, for at most `rooms` live
/// rooms, and at most `media_take` media-inbox messages taken per turn.
pub type Plane: key {
    inflight: u16,
    rooms: u32,
    media_take: u32
}

/// One room's control calls on the control unit: its changes not yet admitted, the
/// one in flight, and the answers not yet taken.
type Calls {
    room: peer.RoomId,
    // The room's last order; `seq` counts per room.
    seq: u64,
    pending: List[router.Change],
    // The call in flight: its change, the unit that applies it first, whether that
    // unit has answered, whether it is a fence, the units it still waits on, the
    // units whose inbox was full when it was posted, its Opus parameters and answer.
    change: Option[router.Change],
    home: u16,
    rest: bool,
    fence: bool,
    waiting: u64,
    unposted: u64,
    fmtp: Option[Shared[Bytes]],
    answer: Option[Result[router.Answer, router.RouterError]],
    answers: List[Done]
}

type Done {
    change: router.Change,
    answer: Result[router.Answer, router.RouterError]
}

// The media messages of one room a unit has taken and not yet routed.
type Held {
    room: peer.RoomId,
    msgs: List[router.Carried]
}

pub type Event = Fenced(peer.Participant) | Fault(room: peer.RoomId, error: router.RouterError) | Layers(room: peer.RoomId, publication: router.PublicationId, mask: u8) | Speakers(room: peer.RoomId, top: Inline[u64, 8], count: u8) | Offer(who: peer.Participant, version: u64, text: Bytes) | Shut(who: peer.Participant)

pub opaque type Unit {
    r: router.Router,
    index: u16,
    doors: List[Doors],
    control: Inbox[ControlMessage],
    media: Inbox[router.Carried],
    // Every queued datagram not yet committed by `udp_send`. What a partial send
    // left is the uncommitted suffix; the send step purges all of it each time.
    out: peer.Outbox,
    rx: Bytes,
    batch: List[UdpPacket],
    slot: Bytes,
    datagram_bytes: u64,
    // A bit per unit this unit posted to in this turn: their doorbells.
    rung: u64,
    // Acknowledgements the control unit's full inbox refused, in order.
    acks: List[ControlMessage],
    counts: UnitCounts,
    // The test seam: at most `limit` datagrams per `udp_send` (0: no limit), and
    // the tap of what each call committed when `tapping`.
    limit: u64,
    tapping: bool,
    tap: List[Sent],
    plane: Plane,
    timing: Timing,
    last_room: u64,
    // On the control unit: each room's calls, the room served first in the last
    // admission round, and the ordinary calls in flight.
    calls: List[Calls],
    cursor: Option[peer.RoomId],
    ordinary: u64,
    // Media taken and carried to the next turn, per room.
    held: List[Held],
    events: List[Event]
}

/// A unit's media queue and socket limits, funded by its unit grant.
pub type MediaQueues: key {
    ingress_packets: u64,
    ingress_bytes: u64,
    egress_packets: u64,
    egress_bytes: u64,
    socket_slots: u32,
    datagram_bytes: u16
}

const RECEIVE_BATCH: u64 = 64

pub const DEFAULT_MEDIA_QUEUES: MediaQueues = MediaQueues(ingress_packets: 1024, ingress_bytes: 4194304, egress_packets: 1024, egress_bytes: 1048576, socket_slots: 256, datagram_bytes: int.narrow(peer.SLOT))

/// Let each homed session contribute a batch to a burst. The baseline covers
/// smaller units and retains the independently funded ingress and egress rooms.
pub fn media_queues(sessions: u32) -> MediaQueues {
    let seats: u64 = int.widen(sessions)
    let mut q = DEFAULT_MEDIA_QUEUES
    let burst = seats * RECEIVE_BATCH
    if burst > q.ingress_packets {
        let payload = burst * int.widen(q.datagram_bytes)
        q.ingress_packets = burst
        q.ingress_bytes = order.max(q.ingress_bytes, payload)
        q.egress_packets = burst
        q.egress_bytes = order.max(q.egress_bytes, payload)
    }
    q
}

/// NET-16 reserves 256 bytes in each receive slot for metadata. Slots are aligned
/// to 8 bytes and have a minimum stride of 1,536 bytes.
pub fn udp_options(slots: u32, datagram_bytes: u16) -> Option[UdpOptions] {
    if slots == 0 || slots > 32768 || slots & (slots - 1) != 0 || datagram_bytes == 0 || datagram_bytes > 65507 {
        return None
    }
    let width: u32 = int.widen(datagram_bytes)
    let stride = order.max(1536u32, (width + 256u32 + 7u32) / 8u32 * 8u32)
    Some(UdpOptions(slots: slots, slot_bytes: stride))
}

pub fn queues_valid(q: MediaQueues) -> bool {
    let Some(_) = udp_options(q.socket_slots, q.datagram_bytes) else {
        return false
    }
    q.ingress_packets != 0 && q.ingress_packets < 4194304 && q.ingress_bytes < 1099511627776 && q.egress_packets != 0 && q.egress_bytes >= int.widen(q.datagram_bytes)
}

// CONC-17 reserves the connection header, its inline slots and its content room.
fn connection_bytes(element: u64, slots: u64, content: u64) -> u64 {
    64u64 + slots * element + content
}

/// What unit `index` of `units` allocates before any room (RTC-10 Sizing): its control
/// and media inboxes at their byte budgets, its outbox, its receive, batch and slot
/// buffers, `socket`'s slots, and its router's row lists at `pool`
/// (`router.reserve_pool`). Its ledger starts at its `unit_bytes` less this.
pub fn fixed_bytes(index: u16, units: u16, plane: Plane, q: MediaQueues, pool: router.PoolBounds) -> u64 {
    if !queues_valid(q) {
        return 0xffffffffffffffff
    }
    let Some(socket) = udp_options(q.socket_slots, q.datagram_bytes) else {
        return 0xffffffffffffffff
    }
    let boxes = connection_bytes(bytes[ControlMessage], control_slots(index, units, plane), 0) + connection_bytes(bytes[router.Carried], q.ingress_packets, q.ingress_bytes)
    let packet_bytes = int.saturating_add(priced(bytes[UdpTx], q.egress_packets), priced(bytes[peer.Tag], q.egress_packets))
    let out = int.saturating_add(priced(1, q.egress_bytes), packet_bytes)
    let width: u64 = int.widen(q.datagram_bytes)
    let buffers = priced(1, RECEIVE_BATCH * width) + priced(bytes[UdpPacket], RECEIVE_BATCH) + priced(1, width)
    let UdpOptions(slots: n, slot_bytes: each) = socket
    let slots: u64 = int.widen(n)
    let rows = match router.pool_bytes(pool) {
        Some(b) => b,
        None => 0xffffffffffffffff,
    }
    let fixed = boxes + buffers + slots * int.widen(each)
    int.saturating_add(fixed, int.saturating_add(out, rows))
}

/// Reserve the unit's router row lists at `pool` before it serves any room (RTC-10
/// Sizing), as `fixed_bytes` prices them.
pub fn reserve_pool(mut u: Unit, pool: router.PoolBounds) {
    router.reserve_pool(mut u.r, pool)
}

fn priced(element: u64, capacity: u64) -> u64 {
    match charge.seq(element, capacity) {
        Some(n) => n,
        None => 0xffffffffffffffff,
    }
}

/// The control plane of a service of one room.
pub const ONE_ROOM: Plane = Plane(inflight: 1, rooms: 1, media_take: 1024)

/// How many control messages unit `index` of `units` units must hold: a worker every
/// change that can be in flight to it at once, one per room plus a fence slot per
/// room; the control unit every worker's acknowledgements of those, and one fault per
/// room from each worker, which raises a room's fault once (RTC-10 Isolation item 2).
pub fn control_slots(index: u16, units: u16, plane: Plane) -> u64 {
    let inflight: u64 = int.widen(plane.inflight)
    let rooms: u64 = int.widen(plane.rooms)
    let per = inflight + rooms
    if index != 0 {
        return per
    }
    let workers: u64 = if units > 1 {
        int.widen(units - 1)
    } else {
        1u64
    }
    workers * (per + rooms)
}

/// One unit's inboxes and doors. `addr` is the address of the socket it will run on;
/// the control inbox is sized by `control_slots`.
pub fn inboxes(addr: Addr, index: u16, units: u16, plane: Plane) -> Result[(Doors, Inbox[ControlMessage], Inbox[router.Carried]), router.RouterError] {
    inboxes_with(addr, index, units, plane, DEFAULT_MEDIA_QUEUES)
}

pub fn inboxes_with(addr: Addr, index: u16, units: u16, plane: Plane, q: MediaQueues) -> Result[(Doors, Inbox[ControlMessage], Inbox[router.Carried]), router.RouterError] {
    let slots = control_slots(index, units, plane)
    // Control payloads are inline. Shared Opus parameters keep their original charge.
    let c: Result[(Client[ControlMessage], Inbox[ControlMessage]), Capacity] = conn.new(slots, bytes 0)
    let (control, take control_in) = c ?=> |x| Capacity(x)
    let m: Result[(Client[router.Carried], Inbox[router.Carried]), Capacity] = conn.new(q.ingress_packets, bytes q.ingress_bytes)
    let (media, take media_in) = m ?=> |x| Capacity(x)
    Ok((Doors(control: control, media: media, addr: addr), take control_in, take media_in))
}

/// Unit `index` of `list.len(doors)` units, over its own inboxes. `doors` names every
/// unit's doors in unit order, its own included.
pub fn unit(r: Random, index: u16, doors: List[Doors], take control: Inbox[ControlMessage], take media: Inbox[router.Carried], out_bytes: u64, out_packets: u64, plane: Plane) -> Result[Unit, router.RouterError] {
    let mut queues = DEFAULT_MEDIA_QUEUES
    queues.egress_bytes = out_bytes
    queues.egress_packets = out_packets
    unit_with(r, index, doors, take control, take media, queues, plane)
}

pub fn unit_with(r: Random, index: u16, doors: List[Doors], take control: Inbox[ControlMessage], take media: Inbox[router.Carried], q: MediaQueues, plane: Plane) -> Result[Unit, router.RouterError] {
    if list.len(doors) > int.widen(router.UNITS_MAX) {
        return Error(Limit(int.widen(router.UNITS_MAX)))
    }
    let out = peer.outbox(q.egress_bytes, q.egress_packets) ?=> |take e| Peer(e)
    let width: u64 = int.widen(q.datagram_bytes)
    let mut rx: Bytes = list.new()
    list.try_reserve(mut rx, RECEIVE_BATCH * width) ?=> |c| Capacity(c)
    let mut batch: List[UdpPacket] = list.new()
    list.try_reserve(mut batch, RECEIVE_BATCH) ?=> |c| Capacity(c)
    let mut slot: Bytes = list.new()
    list.try_reserve(mut slot, width) ?=> |c| Capacity(c)
    let mut all: List[Doors] = list.new()
    for d in doors {
        list.push(mut all, Doors(control: conn.client(d.control), media: conn.client(d.media), addr: d.addr))
    }
    Ok(Unit(r: router.on_unit(r, index), index: index, doors: take all, control: take control, media: take media, out: take out, rx: take rx, batch: take batch, slot: take slot, datagram_bytes: width, rung: 0, acks: list.new(), counts: UnitCounts(media: 0, asks: 0, replies: 0, forged: 0, full: 0, refused: 0, truncated: 0), limit: 0, tapping: false, tap: list.new(), plane: plane, timing: DEFAULT_TIMING, last_room: 0, calls: list.new(), cursor: None, ordinary: 0, held: list.new(), events: list.new()))
}

pub fn router_of(u: Unit) -> View[router.Router] in u {
    view u.r
}

pub fn counts(u: Unit) -> UnitCounts {
    u.counts
}

/// The datagrams queued and not yet committed: the uncommitted suffix after a
/// partial send, and whatever the unit queued since.
pub fn queued(u: Unit) -> View[peer.Outbox] in u {
    view u.out
}

/// The test seam (RTC-7, W14 and W15): commit at most `limit` datagrams per
/// `udp_send`, 0 for no limit, and record what each send committed.
pub fn seam(mut u: Unit, limit: u64, tapping: bool) {
    u.limit = limit
    u.tapping = tapping
}

/// The pool's ingress rates on this unit's router (RTC-10, Isolation items 4 and 6).
pub fn set_rates(mut u: Unit, rates: router.Rates) {
    router.set_rates(mut u.r, rates)
}

/// Take what the tap recorded since the last call.
pub fn take_tap(mut u: Unit) -> List[Sent] {
    replace(mut u.tap, list.new())
}

/// Take the events since the last call: `Fenced` after a revoke returns (RTC-7).
/// Hand a participant's answer to its re-offer to the session's home unit (RTC-4), on
/// the control unit.
pub fn answer_reoffer(mut u: Unit, room: peer.RoomId, who: peer.Gen, version: u64, take text: Bytes) -> Result[(), router.RouterError] {
    router.answer_reoffer(mut u.r, room, who, version, take text)?
    deal(mut u)
    Ok(())
}

pub fn take_events(mut u: Unit) -> List[Event] {
    let mut events = replace(mut u.events, list.new())
    list.retain(mut events, scoped fn(e: Event) -> bool {
        router.room_open(u.r, event_room(e))
    })
    take events
}

/// Take `room`'s events since the last call, leaving every other room's for its own
/// adapter (RTC-10: one adapter per room on the control unit).
pub fn take_room_events(mut u: Unit, room: peer.RoomId) -> List[Event] {
    let mut mine: List[Event] = list.new()
    let mut rest: List[Event] = list.new()
    for take e in replace(mut u.events, list.new()) {
        if event_room(e) == room {
            list.push(mut mine, take e)
        } else if router.room_open(u.r, event_room(e)) {
            list.push(mut rest, take e)
        }
    }
    u.events = take rest
    if !router.room_open(u.r, room) {
        list.clear(mut mine)
    }
    take mine
}

pub fn event_room(e: Event) -> peer.RoomId {
    match e {
        Fenced(who) => who.room,
        Fault(room: room, ..) => room,
        Offer(who: who, ..) => who.room,
        Shut(who: who) => who.room,
        Layers(room: room, ..) => room,
        Speakers(room: room, ..) => room,
    }
}

/// Allocate the next room identity on unit 0, even after every room has closed.
pub fn next_room(mut u: Unit) -> Option[peer.RoomId] {
    if u.index != 0 {
        return None
    }
    let id = int.checked_add(u.last_room, 1u64)?
    u.last_room = id
    Some(RoomId(id))
}

/// Whether the queued build still has an open room on this unit.
pub fn take_build(mut u: Unit, room: peer.RoomId) -> bool {
    router.take_build(mut u.r, room)
}

/// Park a session opened on this unit, its home, until a control call admits it.
pub fn park(mut u: Unit, take session: peer.PeerSession) -> Result[(), router.RouterError] {
    router.park(mut u.r, take session)
}

// ---- The control order (RTC-5, RTC-10), on the control unit ----
/// Ask for a control call on the control unit, unit 0. The change joins its room's
/// pending changes. Each room has at most one call in flight, and at most
/// `inflight` ordinary calls are in flight across the pool; a fence (`Revoke`,
/// `Suspend`, `Close`) goes before its room's other pending changes and takes no slot
/// of that window, so it waits only for its own room's call in flight. A call goes to
/// the unit that applies it first, and once that unit answers `Ok`, to every other
/// unit. A publication's id is the control unit's to hand out. `finished` answers it.
pub fn begin(mut u: Unit, now: u64, take c: router.Change) -> Result[(), router.RouterError] {
    if u.index != 0 {
        return Error(Exists)
    }
    let room = router.change_room(c)
    let i = calls_of(mut u, room)
    list.push(mut u.calls[i].pending, c)
    admit(mut u, now)
    Ok(())
}

fn calls_at(u: Unit, room: peer.RoomId) -> Option[u64] {
    for i in 0u64 .. list.len(u.calls) {
        if u.calls[i].room == room {
            return Some(i)
        }
    }
    None
}

fn calls_of(mut u: Unit, room: peer.RoomId) -> u64 {
    if let Some(i) = calls_at(u, room) {
        return i
    }
    list.push(mut u.calls, Calls(room: room, seq: 0, pending: list.new(), change: None, home: 0, rest: false, fence: false, waiting: 0, unposted: 0, fmtp: None, answer: None, answers: list.new()))
    list.len(u.calls) - 1
}

fn flying(c: Calls) -> bool {
    match c.change {
        Some(_) => true,
        None => false,
    }
}

// The pending change a room admits next: its first fence, else its first change.
fn next_pending(c: Calls) -> Option[u64] {
    for j in 0u64 .. list.len(c.pending) {
        if router.fencing(c.pending[j]) {
            return Some(j)
        }
    }
    if list.len(c.pending) != 0 {
        Some(0)
    } else {
        None
    }
}

// Admit pending changes round-robin by room, starting after the room served first in
// the last round, until the window is full. A call that finishes at once (a pool of
// one unit) frees its room for another round.
fn admit(mut u: Unit, now: u64) {
    let window: u64 = int.widen(u.plane.inflight)
    let mut moved = true
    while moved {
        moved = false
        let n = list.len(u.calls)
        let start = match u.cursor {
            Some(room) => match calls_at(u, room) {
                Some(k) => k + 1,
                None => 0,
            },
            None => 0,
        }
        let mut first: Option[peer.RoomId] = None
        for k in 0u64 .. n {
            let i = (start + k) % n
            if flying(u.calls[i]) {
                continue
            }
            let Some(j) = next_pending(u.calls[i]) else {
                continue
            }
            let fence = router.fencing(u.calls[i].pending[j])
            if !fence && u.ordinary >= window {
                continue
            }
            let c = list.remove(mut u.calls[i].pending, j)
            if first == None {
                first = Some(u.calls[i].room)
            }
            start_call(mut u, now, i, c, fence)
            moved = true
        }
        if let Some(room) = first {
            u.cursor = Some(room)
        }
    }
}

fn start_call(mut u: Unit, now: u64, i: u64, c: router.Change, fence: bool) {
    let change: router.Change = match c {
        Publish(room: room, who: who, section: section, id: _, shape: _) => Publish(room: room, who: who, section: section, id: router.next_publication(mut u.r), shape: None),
        other => other,
    }
    let home = router.first(u.r, change)
    u.calls[i].seq += 1
    let seq = u.calls[i].seq
    let room = u.calls[i].room
    u.calls[i].change = Some(change)
    u.calls[i].home = home
    u.calls[i].rest = false
    u.calls[i].fence = fence
    u.calls[i].unposted = 0
    u.calls[i].fmtp = None
    u.calls[i].answer = None
    if !fence {
        u.ordinary += 1
    }
    if home == 0 {
        u.calls[i].waiting = 1
        let a = router.apply(mut u.r, now, change, mut u.out)
        let fmtp = applied_opus_fmtp(u, change, a)
        answered(mut u, now, room, seq, 0, take a, fmtp)
    } else {
        let shift: u64 = int.widen(home)
        u.calls[i].waiting = 1 << shift
        order(mut u, i, home)
    }
}

/// The next answer of `room`'s calls, once every unit a call waits on has
/// acknowledged it; answers come in the order the calls were admitted. A revoke's
/// answer is followed by `Event.Fenced` (RTC-7).
pub fn finished(mut u: Unit, room: peer.RoomId) -> Option[Result[router.Answer, router.RouterError]] {
    let i = calls_at(u, room)?
    if list.len(u.calls[i].answers) == 0 {
        return None
    }
    let Done(change: change, answer: take a) = list.remove(mut u.calls[i].answers, 0)
    if let Ok(_) = a {
        if let Revoke(room: _, id: id, epoch: epoch) = change {
            list.push(mut u.events, Fenced(peer.Participant(gen: Gen(id: id, epoch: epoch), room: room)))
        }
    }
    // A room no longer open with nothing pending, in flight or unanswered keeps no
    // record: room ids are never reused.
    let idle = list.len(u.calls[i].pending) == 0 && list.len(u.calls[i].answers) == 0 && !flying(u.calls[i])
    if idle && !router.room_open(u.r, room) {
        let _ = list.remove(mut u.calls, i)
    }
    Some(take a)
}

// Post room `i`'s call in flight to unit `to`. A full inbox is not an error: the
// unit stays unposted and the post is made again at the next fence point.
fn order(mut u: Unit, i: u64, to: u16) {
    let Some(c) = u.calls[i].change else {
        return
    }
    let k: u64 = int.widen(to)
    let bit: u64 = 1 << k
    let room = u.calls[i].room
    let seq = u.calls[i].seq
    match conn.try_send(u.doors[k].control, ControlMessage(step: Order(room: room, seq: seq, change: c), opus_fmtp: clone(u.calls[i].fmtp))) {
        Ok(()) => {
            u.calls[i].unposted = u.calls[i].unposted & ~bit
            u.rung = u.rung | bit
        },
        Error(Full(_)) => {
            u.calls[i].unposted = u.calls[i].unposted | bit
        },
        // A unit whose inbox is gone has ended; the pool ends with it.
        Error(Closed(_)) => {
            u.calls[i].unposted = u.calls[i].unposted & ~bit
        },
    }
}

// Post again every order a full inbox refused, each room's in its order.
fn repost(mut u: Unit) {
    for i in 0u64 .. list.len(u.calls) {
        let unposted = u.calls[i].unposted
        if unposted == 0 {
            continue
        }
        for k in 0u64 .. list.len(u.doors) {
            if (unposted >> k) & 1 == 1 {
                order(mut u, i, int.narrow(k))
            }
        }
    }
}

// One unit's answer to `room`'s call in flight.
fn answered(mut u: Unit, now: u64, room: peer.RoomId, seq: u64, from: u16, take a: Result[router.Answer, router.RouterError], fmtp: Option[Shared[Bytes]]) {
    let Some(i) = calls_at(u, room) else {
        return
    }
    let Some(change) = u.calls[i].change else {
        return
    }
    if u.calls[i].seq != seq {
        return
    }
    let shift: u64 = int.widen(from)
    let bit: u64 = 1 << shift
    u.calls[i].waiting = u.calls[i].waiting & ~bit
    if u.calls[i].rest {
        // A unit after the first refused a change the first accepted: their states
        // differ, which the control order rules out, so the call answers the refusal.
        if let Error(_) = a {
            u.calls[i].answer = Some(take a)
        }
        complete(mut u, i)
        return
    }
    u.calls[i].rest = true
    let shape = match a {
        Ok(Shaped(id: _, shape: s)) => Some(s),
        Ok(Done) => None,
        Error(_) => {
            u.calls[i].answer = Some(take a)
            complete(mut u, i)
            return
        },
    }
    u.calls[i].answer = Some(take a)
    let given: router.Change = match change {
        Publish(room: _, who: who, section: section, id: id, shape: _) => Publish(room: room, who: who, section: section, id: id, shape: shape),
        other => other,
    }
    u.calls[i].change = Some(given)
    u.calls[i].fmtp = clone(fmtp)
    let home = u.calls[i].home
    let n: u64 = list.len(u.doors)
    for k in 0u64 .. n {
        let to: u16 = int.narrow(k)
        if to == home {
            continue
        }
        if to == 0 {
            let _ = router.apply_with_fmtp(mut u.r, now, given, fmtp, mut u.out)
        } else {
            u.calls[i].waiting = u.calls[i].waiting | (1 << k)
            order(mut u, i, to)
        }
    }
    complete(mut u, i)
}

// A call every unit has acknowledged is over: its answer waits for `finished`, and
// its room may admit its next change.
fn complete(mut u: Unit, i: u64) {
    if u.calls[i].waiting != 0 {
        return
    }
    let Some(change) = replace(mut u.calls[i].change, None) else {
        return
    }
    let Some(take a) = replace(mut u.calls[i].answer, None) else {
        return
    }
    if !u.calls[i].fence {
        u.ordinary -= 1
    }
    u.calls[i].fmtp = None
    u.calls[i].unposted = 0
    list.push(mut u.calls[i].answers, Done(change: change, answer: take a))
}

// ---- A unit's steps (RTC-5, A turn) ----
/// Take every control message waiting: a fence point. Each `Order` is applied in
/// control order, purging the queue it fences (RTC-7 step 2), and acknowledged.
///
/// On the control unit it also posts again what a full inbox refused, and admits
/// the pending changes the acknowledgements made room for.
pub fn take_control(mut u: Unit, now: u64) {
    retry_acks(mut u)
    while true {
        match conn.try_receive(u.control) {
            Ok(ControlMessage(step: Order(room: room, seq: seq, change: c), opus_fmtp: fmtp)) => {
                let a = router.apply_with_fmtp(mut u.r, now, c, fmtp, mut u.out)
                let _ = router.purge(u.r, mut u.out)
                let published = applied_opus_fmtp(u, c, a)
                ack(mut u, room, seq, take a, take published)
            },
            Ok(ControlMessage(step: Ack(room: room, seq: seq, unit: k, answer: a), opus_fmtp: fmtp)) => answered(mut u, now, room, seq, k, a, fmtp),
            Ok(ControlMessage(step: Fault(room: room, unit: _, error: take e), opus_fmtp: _)) => list.push(mut u.events, Fault(room: room, error: take e)),
            Error(_) => break,
        }
    }
    if u.index == 0 {
        repost(mut u)
        admit(mut u, now)
    }
}

fn applied_opus_fmtp(u: Unit, c: router.Change, answer: Result[router.Answer, router.RouterError]) -> Option[Shared[Bytes]] {
    if let Ok(Shaped(id: _, shape: _)) = answer {
        return router.published_opus_fmtp(u.r, c)
    }
    None
}

fn ack(mut u: Unit, room: peer.RoomId, seq: u64, take a: Result[router.Answer, router.RouterError], take fmtp: Option[Shared[Bytes]]) {
    let index = u.index
    list.push(mut u.acks, ControlMessage(step: Ack(room: room, seq: seq, unit: index, answer: take a), opus_fmtp: take fmtp))
    retry_acks(mut u)
}

fn retry_acks(mut u: Unit) {
    while list.len(u.acks) != 0 {
        let a = list.remove(mut u.acks, 0)
        match conn.try_send(u.doors[0].control, take a) {
            Ok(()) => {
                u.rung = u.rung | 1
            },
            Error(Full(take back)) => {
                list.insert(mut u.acks, 0, take back)
                return
            },
            Error(Closed(_)) => (),
        }
    }
}

/// Take at most `media_take` media-inbox messages and route them fairly by room
/// (RTC-10, Isolation item 5): each room's messages queue in order, and each turn
/// routes at most `media_take / r` of each of the `r` rooms with messages waiting,
/// carrying the rest to the next turn ahead of new messages. A room whose queue is
/// past its share drops what it is sent and counts it `full`. Each message is checked
/// against the fences when it is routed (RTC-7 step 4); one of a room this unit does
/// not have open is routed at once, which drops it as stale. An error routing a
/// message is its room's fault (`routed`), and no error leaves.
pub fn take_media(mut u: Unit, now: u64) {
    let budget: u64 = int.widen(u.plane.media_take)
    let mut taken = 0u64
    while taken < budget {
        match conn.try_receive(u.media) {
            Ok(take m) => {
                taken += 1
                match m.carry {
                    Media(room: _, publication: _, src: _, m: _, handle: _, speaking: _, rate: _, dropped: _) => {
                        u.counts.media += 1
                    },
                    Ask(room: _, publication: _, src: _, dst: _, ask: _) => {
                        u.counts.asks += 1
                    },
                    Reply(room: _, publication: _, src: _, dst: _, ask: _) => {
                        u.counts.replies += 1
                    },
                    _ => {},
                }
                let room = router.carry_room(m.carry)
                if router.room_open(u.r, room) {
                    hold(mut u, room, take m)
                } else {
                    let got = router.accept(mut u.r, now, take m, mut u.out)
                    routed(mut u, room, take got)
                }
            },
            Error(_) => break,
        }
    }
    route_held(mut u, now)
    deal(mut u)
}

// RTC-10 Isolation item 2: a session's own error drops only the message; any other is
// in the room's shared state and is the room's fault.
fn routed(mut u: Unit, room: peer.RoomId, take got: Result[(), router.RouterError]) {
    match take got {
        Ok(()) => (),
        Error(Peer(_)) => (),
        Error(take e) => fault(mut u, room, take e),
    }
}

/// Raise `room`'s fault on this unit (RTC-10 Isolation item 2), as an error in the
/// room's shared state does: the unit stops routing the room and tells the control unit,
/// whose adapter closes the room.
pub fn fault(mut u: Unit, room: peer.RoomId, take e: router.RouterError) {
    router.fault(mut u.r, room, take e, mut u.out)
    deal(mut u)
}

fn share(budget: u64, rooms: u64) -> u64 {
    if rooms == 0 || budget / rooms == 0 {
        1u64
    } else {
        budget / rooms
    }
}

fn hold(mut u: Unit, room: peer.RoomId, take m: router.Carried) {
    let mut at: Option[u64] = None
    for q in 0u64 .. list.len(u.held) {
        if u.held[q].room == room {
            at = Some(q)
        }
    }
    let q = match at {
        Some(q) => q,
        None => {
            list.push(mut u.held, Held(room: room, msgs: list.new()))
            list.len(u.held) - 1
        },
    }
    let cap = share(int.widen(u.plane.media_take), list.len(u.held))
    if list.len(u.held[q].msgs) >= cap {
        u.counts.full += 1
        router.count_full(mut u.r, room)
        return
    }
    list.push(mut u.held[q].msgs, take m)
}

// Route each waiting room's share, in room order, and keep the rest.
fn route_held(mut u: Unit, now: u64) {
    let quota = share(int.widen(u.plane.media_take), list.len(u.held))
    for q in 0u64 .. list.len(u.held) {
        let mut k = 0u64
        while k < quota && list.len(u.held[q].msgs) != 0 {
            let m = list.remove(mut u.held[q].msgs, 0)
            let room = u.held[q].room
            let got = router.accept(mut u.r, now, take m, mut u.out)
            routed(mut u, room, take got)
            k += 1
        }
    }
    list.retain(mut u.held, scoped fn(h: Held) -> bool {
        list.len(h.msgs) != 0
    })
}

/// Route one datagram that `from` sent to this unit's socket.
pub fn take_datagram(mut u: Unit, now: u64, from: Addr, data: Bytes) -> Result[(), router.RouterError] {
    if list.len(data) == 0 {
        if !sibling(u, from) {
            u.counts.forged += 1
        }
        return Ok(())
    }
    list.clear(mut u.slot)
    list.try_reserve(mut u.slot, list.len(data)) ?=> |c| Capacity(c)
    list.append(mut u.slot, data)
    router.deliver(mut u.r, now, from, mut u.slot, mut u.out)
    deal(mut u)
    Ok(())
}

fn sibling(u: Unit, from: Addr) -> bool {
    for d in u.doors {
        if d.addr == from {
            return true
        }
    }
    false
}

/// Drive every session's timers; the earliest deadline.
pub fn take_timers(mut u: Unit, now: u64) -> Option[u64] {
    let wake = router.poll(mut u.r, now, mut u.out)
    deal(mut u)
    wake
}

// Send what the router posted to the other units' media inboxes. A full inbox drops
// the message, which is media and repair only, and counts it.
fn deal(mut u: Unit) {
    // The control unit's RTC-6 notices become events.
    for take n in router.take_notices(mut u.r) {
        match take n {
            Layers(room: room, publication: p, mask: mask) => list.push(mut u.events, Layers(room: room, publication: p, mask: mask)),
            Speakers(room: room, top: top, count: count) => list.push(mut u.events, Speakers(room: room, top: top, count: count)),
            Offer(who: who, version: version, text: take text) => list.push(mut u.events, Offer(who: who, version: version, text: take text)),
            Shut(who: who) => list.push(mut u.events, Shut(who: who)),
            // A worker's fault goes to the control unit with its acknowledgements,
            // which are retried, never dropped, when its inbox is full.
            Fault(room: room, error: take e) => {
                if u.index == 0 {
                    list.push(mut u.events, Fault(room: room, error: take e))
                } else {
                    let index = u.index
                    list.push(mut u.acks, ControlMessage(step: Fault(room: room, unit: index, error: take e), opus_fmtp: None))
                    retry_acks(mut u)
                }
            },
        }
    }
    let posts = router.take_posts(mut u.r)
    for take p in posts {
        let router.Post(to: to, carried: take m) = take p
        let i: u64 = int.widen(to)
        if i >= list.len(u.doors) || to == u.index {
            continue
        }
        let room = router.carry_room(m.carry)
        match conn.try_send(u.doors[i].media, take m) {
            Ok(()) => {
                u.rung = u.rung | (1 << i)
            },
            Error(_) => {
                u.counts.full += 1
                router.count_full(mut u.r, room)
            },
        }
    }
}

/// The send step's first half: drop every queued datagram the fences cover (RTC-7
/// step 2: `out` and the uncommitted suffix alike), and answer how many to pass to
/// `udp_send`.
pub fn ready(mut u: Unit) -> u64 {
    let _ = router.purge(u.r, mut u.out)
    let n = list.len(u.out.pkts)
    if u.limit != 0 && n > u.limit {
        u.limit
    } else {
        n
    }
}

/// The send step's second half: the first `k` datagrams were committed. What
/// remains is the uncommitted suffix, compacted to the front of the outbox.
pub fn committed(mut u: Unit, k: u64) {
    advance(mut u, k, true)
}

fn advance(mut u: Unit, k: u64, sent: bool) {
    if sent && u.tapping {
        for i in 0u64 .. k {
            let UdpTx(to, at, len, ecn: _) = u.out.pkts[i]
            list.push(mut u.tap, Sent(to: to, tag: u.out.tags[i], data: copy_out(u.out.data, at, len)))
        }
    }
    let n = list.len(u.out.pkts)
    let mut w = 0u64
    let mut kept = 0u64
    for i in k .. n {
        let UdpTx(to, at, len, ecn) = u.out.pkts[i]
        if at != w {
            list.copy_within(mut u.out.data, at, w, len)
        }
        u.out.pkts[kept] = UdpTx(to: to, at: w, len: len, ecn: ecn)
        u.out.tags[kept] = u.out.tags[i]
        w += len
        kept += 1
    }
    list.truncate(mut u.out.data, w)
    list.truncate(mut u.out.pkts, kept)
    list.truncate(mut u.out.tags, kept)
}

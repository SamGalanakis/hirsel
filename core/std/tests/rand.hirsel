// Go 46b62495, math/rand/v2/pcg_test.go TestPCG.
const GO_STREAM: Inline[u64, 20] =[0xc4f5a58656eef510, 0x9dcec3ad077dec6c, 0xc8d04605312f8088, 0xcbedc0dcb63ac19a, 0x3bf98798cae97950, 0x0a8c6d7f8d485abc, 0x7ffa3780429cd279, 0x730ad2626b1c2f8e, 0x21ff2330f4a0ad99, 0x2f0901a1947094b0, 0xa9735a3cfbe36cef, 0x71ddb0a01a12c84a, 0xf0e53e77a78453bb, 0x1f173e9663be1e9d, 0x657651da3ac4115e, 0xc8987376b65a157b, 0xbb17008f5fca28e7, 0x8232bd645f29ed22, 0x12be8f07ad14c539, 0x54908a48e8e4736e]

// R1. Pins the post-step DXSM and both cross terms of the state advance.
// expect: run go_stream() = true
fn go_stream() -> bool {
    let mut p = rand.new(1, 2)
    for i in 0u64 .. 20u64 {
        if rand.next(mut p) != GO_STREAM[i] {
            return false
        }
    }
    true
}

// R2. Go 46b62495, math/rand/v2/regress_test.go Uint64N rows. The
// bounds include powers of two and 2^64-1. Each draw advances one shared
// stream, so a draw-count change also affects the following rows.
// expect: run go_bounded() = true
fn go_bounded() -> bool {
    let cases: Inline[(u64, u64), 20] =[(1, 0), (10, 6), (32, 8), (1048576, 704922), (1048577, 245656), (1000000000, 41205257), (1073741824, 43831929), (2147483646, 965044528), (2147483647, 285184408), (1000000000000000000, 183731176326946086), (1152921504606846976, 680987186633600239), (9223372036854775806, 4102454148908803108), (9223372036854775807, 8679174511200971228), (18446744073709551614, 2240328155279531676), (18446744073709551615, 7311121042813227357), (1, 0), (10, 7), (32, 2), (1048576, 312633), (1048577, 346376)]
    let mut p = rand.new(1, 2)
    for i in 0u64 .. 20u64 {
        let (n, expected) = cases[i]
        if rand.below(mut p, n) != expected {
            return false
        }
    }
    true
}

// R3. Generated by Go 1.24.6 math/rand/v2 using NewPCG(7, 11) separately
// for each bound. The first bound rejects almost half of all source words.
const HEAVY: Inline[u64, 20] =[3624670031342969893, 4799461362348215017, 1645907960068430040, 3092406264821826215, 2323816322509811767, 6036533018862854390, 2134280282810953017, 2859135577599732268, 4299453602875468391, 8568027087831493349, 4459346948202727618, 2247926497430997277, 6057886438299477622, 2501293248264343208, 5741572397372540727, 1978293437604344265, 6418401737035102202, 1939887877053715647, 3419941745119778882, 2594152204597982454]

const MAXIMUM: Inline[u64, 20] =[4272534329212569457, 7249340062685939786, 9598922724696430033, 3291815920136860080, 6184812529643652430, 4647632645019623534, 12073066037725708779, 4268560565621906034, 13139790910734876866, 5718271155199464536, 3061529970737300303, 12779613810309915964, 3806069010677485121, 16777724515876290478, 8598907205750936782, 12370270329482044226, 13658429273923967238, 17136054175662986697, 8918693896405455236, 5479591252758781449]

// For M=2^64 and t=M mod n, bucket k accepts multiples of n in
// [k*M+t, (k+1)*M). The interval has length M-t, a multiple of n, so
// each bucket accepts exactly floor(M/n) source words. Also t < M/2.
// At n=2^63+1 the two seeds below force low words t-1 and t on the first
// draw. Go 1.24.6 gives the accepted value and final state in each case.
// expect: run rejection_boundary() = true
fn rejection_boundary() -> bool {
    let mut below = rand.new(0x701573f4c0b09bed, 0x8af6d8ab3399600a)
    let below_value = rand.below(mut below, 0x8000000000000001)
    let below_matches = below_value == 0x578e736d00fe0bfb && rand.state(below) == (0x02f68a49fe079421u64, 0x578b5ae397347794u64)
    let mut equal = rand.new(0x5560ea8d7c5d5eae, 0x8af6d8ab3399600a)
    let equal_value = rand.below(mut equal, 0x8000000000000001)
    let equal_matches = equal_value == 0x8000000000000000 && rand.state(equal) == (0x72fcab15589fab15u64, 0x0000000000000001u64)
    below_matches && equal_matches
}

// expect: run go_rejection_heavy() = true
fn go_rejection_heavy() -> bool {
    let mut heavy = rand.new(7, 11)
    let mut maximum = rand.new(7, 11)
    for i in 0u64 .. 20u64 {
        if rand.below(mut heavy, 0x8000000000000001) != HEAVY[i] || rand.below(mut maximum, 0xffffffffffffffff) != MAXIMUM[i] {
            return false
        }
    }
    true
}

// R4. Go 46b62495, math/rand/v2/regress_test.go Perm rows. The nibble at
// offset 4*j holds the expected value at j. Empty and singleton lists must
// consume no draws, and the remaining rows detect a wrong swap bound or order.
// expect: run go_shuffle() = true
fn go_shuffle() -> bool {
    let cases: Inline[(u64, u64), 20] =[(0, 0x0), (1, 0x0), (5, 0x30241), (8, 0x7251634), (9, 0x430278156), (10, 0x3071865249), (16, 0xc68de0bf7a241395), (0, 0x0), (1, 0x0), (5, 0x3124), (8, 0x76451320), (9, 0x156743802), (10, 0x7921483560), (16, 0xf5a173c2608db4e9), (0, 0x0), (1, 0x0), (5, 0x13042), (8, 0x64570123), (9, 0x687205431), (10, 0x3095627481)]
    let mut p = rand.new(1, 2)
    for i in 0u64 .. 20u64 {
        let (n, expected) = cases[i]
        let mut xs: List[u64] = list.with_capacity(n)
        for j in 0u64 .. n {
            list.push(mut xs, j)
        }
        rand.shuffle(mut p, mut xs)
        for j in 0u64 .. n {
            if xs[j] != ((expected >> (4 * j)) & 15) {
                return false
            }
        }
    }
    true
}

// R5. Go 46b62495, math/rand/v2/regress_test.go Float64 rows converted to
// their exact binary64 encodings by Go's math.Float64bits.
// expect: run go_float_bits() = true
fn go_float_bits() -> bool {
    let expected: Inline[u64, 20] =[0x3fe5a58656eef510, 0x3fdd875a0efbd8d8, 0x3fe04605312f8088, 0x3fdb81b96c758334, 0x3fe98798cae97950, 0x3fd8daff1a90b578, 0x3fea3780429cd279, 0x3fd5a4c4d6385f1c, 0x3fef2330f4a0ad99, 0x3fd2034328e12960, 0x3fe35a3cfbe36cef, 0x3fedb0a01a12c84a, 0x3fc4f9de9e114eec, 0x3fe73e9663be1e9d, 0x3fe651da3ac4115e, 0x3fe87376b65a157b, 0x3fe7008f5fca28e7, 0x3fe2bd645f29ed22, 0x3fee8f07ad14c539, 0x3fe08a48e8e4736e]
    let mut p = rand.new(1, 2)
    for i in 0u64 .. 20u64 {
        if float.to_bits64(rand.float64(mut p)) != expected[i] {
            return false
        }
    }
    true
}

// R6. Go NewPCG(1, 2), MarshalBinary after five draws, and the rest of TestPCG.
// expect: run go_resume() = true
fn go_resume() -> bool {
    let mut p = rand.new(1, 2)
    if rand.state(p) != (1u64, 2u64) {
        return false
    }
    for _ in 0u64 .. 5u64 {
        let _ = rand.next(mut p)
    }
    let (hi, lo) = rand.state(p)
    if hi != 0x07fe5f6644a0e46c || lo != 0xb5bf4b720cb0c66d {
        return false
    }
    let mut resumed = rand.new(hi, lo)
    let mut fork = p
    for i in 5u64 .. 20u64 {
        if rand.next(mut resumed) != GO_STREAM[i] || rand.next(mut fork) != GO_STREAM[i] {
            return false
        }
    }
    rand.state(p) == (hi, lo)
}

// R7. The below contract requires Bounds for an empty interval.
// expect: run zero_bound() = fail Bounds
fn zero_bound() -> u64 {
    let mut p = rand.new(1, 2)
    rand.below(mut p, 0)
}

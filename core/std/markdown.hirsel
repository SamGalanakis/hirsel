fn fence_parts(value: String) -> (String, String) {
    match string.split_once(value, "\n") {
        Some((info, rest)) => (unescape(trim(info), true), string.from(rest)),
        None => ("", ""),
    }
}

// Match equal-length backtick runs by reading the source backwards once.
// Each suffix of a run gets a lookup because an escaped first backtick
// can leave a shorter opening run to parse.
fn backtick_ends(mut budget: ParseState, source: String) -> Result[List[u64], ParseLimit] {
    let length = size(source)
    if string.find(source, 0, "`") == None {
        return Ok(list.new())
    }
    admit(mut budget, length * 2 + 1)?
    let mut next_run: List[u64] = list.new()
    let mut result: List[u64] = list.new()
    list.fill(mut next_run, length + 1, 0u64)
    list.fill(mut result, length, 0u64)
    let mut at = length
    while at != 0 {
        at -= 1
        if byte(source, at) != 96 {
            continue
        }
        let end = at + 1
        let mut count = 1u64
        result[at] = next_run[count]
        while at != 0 && byte(source, at - 1) == 96 {
            at -= 1
            count += 1
            result[at] = next_run[count]
        }
        next_run[end - at] = at
    }
    Ok(take result)
}

// A failed inline link can leave another bracket much later in the same
// tentative destination. Index the stopping points once so a series of
// failures cannot rescan a long common suffix.
type LinkEnds {
    bare: u64,
    angle: u64,
    single_quote: u64,
    double_quote: u64,
    paren: u64,
    spaces: u64,
}

fn scan_link_ends(mut budget: ParseState, source: String) -> Result[List[LinkEnds], ParseLimit] {
    if string.find(source, 0, "](") == None {
        return Ok(list.new())
    }
    let length = size(source)
    let missing = length + 1
    admit(mut budget, missing)?
    let mut ends: List[LinkEnds] = list.new()
    list.fill(mut ends, missing, LinkEnds(
        bare: length,
        angle: missing,
        single_quote: missing,
        double_quote: missing,
        paren: missing,
        spaces: length,
    ))
    let mut at = length
    while at != 0 {
        at -= 1
        let c = byte(source, at)
        if c == b'\\' && punctuation(byte(source, at + 1)) {
            let followed = ends[at + 2]
            ends[at] = LinkEnds(
                bare: followed.bare,
                angle: followed.angle,
                single_quote: followed.single_quote,
                double_quote: followed.double_quote,
                paren: followed.paren,
                spaces: at,
            )
            continue
        }
        let next = ends[at + 1]
        let bare = if c <= 32 || c == 127 || c == b')' {
            at
        } else if c == b'(' {
            let close = next.bare
            if close < length && byte(source, close) == b')' {
                ends[close + 1].bare
            } else {
                missing
            }
        } else {
            next.bare
        }
        let angle = if c == b'>' {
            at
        } else if c == b'<' || c == 10 {
            missing
        } else {
            next.angle
        }
        let paren = if c == b')' {
            at
        } else if c == b'(' {
            missing
        } else {
            next.paren
        }
        ends[at] = LinkEnds(
            bare,
            angle,
            single_quote: if c == 39 {
                at
            } else {
                next.single_quote
            },
            double_quote: if c == b'"' {
                at
            } else {
                next.double_quote
            },
            paren,
            spaces: if space(c) {
                next.spaces
            } else {
                at
            },
        )
    }
    Ok(take ends)
}

fn inline_space(s: String, ends: List[LinkEnds], at: u64) -> u64 {
    let after = ends[at].spaces
    if byte(s, after) == 10 {
        ends[after + 1].spaces
    } else {
        after
    }
}

fn inline_link(s: String, ends: List[LinkEnds], at: u64) -> Option[(String, String, u64)] {
    let length = size(s)
    let begin = inline_space(s, ends, at)
    let angle = byte(s, begin) == b'<'
    let start = if angle {
        begin + 1
    } else {
        begin
    }
    let stop = if angle {
        ends[start].angle
    } else {
        ends[start].bare
    }
    if stop > length || !angle && start == stop && byte(s, stop) != b')' {
        return None
    }
    let after_dest = if angle {
        stop + 1
    } else {
        stop
    }
    let mut next = inline_space(s, ends, after_dest)
    let mut title_start = next
    let mut title_end = next
    if next > after_dest && next < length {
        let quote = byte(s, next)
        let after_quote = ends[next + 1]
        let close = match quote {
            34 => after_quote.double_quote,
            39 => after_quote.single_quote,
            40 => after_quote.paren,
            _ => length + 1,
        }
        if close < length {
            title_start = next + 1
            title_end = close
            next = inline_space(s, ends, close + 1)
        }
    }
    if byte(s, next) != b')' {
        return None
    }
    let address = normalize_uri(unescape(string.slice(s, start, stop), true))
    let title = unescape(string.slice(s, title_start, title_end), true)
    Some((take address, take title, next + 1))
}

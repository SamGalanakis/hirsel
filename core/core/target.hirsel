// Module `target` (PROG-6): the target a build is for, as constants the toolchain supplies.
pub type Os: key = Linux | Macos | Ios

pub type Arch: key = X86_64 | Aarch64

/// Supplied by the toolchain from the build's target (LANG-20).
pub const os: Os

/// Supplied by the toolchain from the build's target (LANG-20).
pub const arch: Arch

/// Refuses a build whose retained code reaches it, naming `why`, the target and the reach
/// chain (PROG-6). It never runs. `why` is a string literal.
pub fn unsupported(why: String) -> Never

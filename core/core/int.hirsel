// Module `int` (SEM-1).
pub fn wrapping_add[T: integer](a: T, b: T) -> T

pub fn wrapping_sub[T: integer](a: T, b: T) -> T

pub fn wrapping_mul[T: integer](a: T, b: T) -> T

pub fn wrapping_neg[T: integer](a: T) -> T

pub fn abs[T: integer](a: T) -> T

pub fn wrapping_shl[T: integer](a: T, n: u32) -> T

pub fn checked_add[T: integer](a: T, b: T) -> Option[T]

pub fn checked_sub[T: integer](a: T, b: T) -> Option[T]

pub fn checked_mul[T: integer](a: T, b: T) -> Option[T]

pub fn checked_div[T: integer](a: T, b: T) -> Option[T]

pub fn saturating_add[T: integer](a: T, b: T) -> T

pub fn saturating_sub[T: integer](a: T, b: T) -> T

pub fn saturating_mul[T: integer](a: T, b: T) -> T

pub fn mul_wide(a: u64, b: u64) -> (u64, u64)

pub fn leading_zeros[T: integer](x: T) -> u32

pub fn trailing_zeros[T: integer](x: T) -> u32

pub fn count_ones[T: integer](x: T) -> u32

pub fn rotate_left[T: integer](x: T, n: u32) -> T

pub fn rotate_right[T: integer](x: T, n: u32) -> T

pub fn swap_bytes[T: integer](x: T) -> T

pub fn widen[T: integer, U: integer](x: T) -> U

pub fn narrow[T: integer, U: integer](x: T) -> U

pub fn try_narrow[T: integer, U: integer](x: T) -> Option[U]

pub fn truncate[T: integer, U: integer](x: T) -> U

/// Returns the ASCII digit value below radix. Letters A through Z and a
/// through z stand for 10 through 35. Other bytes return None. Radix bounds
/// are the caller's grammar. Alloc: nothing. Cost: O(1).
pub fn ascii_digit(b: u8, radix: u32) -> Option[u8] {
    let digit = if b > b'9' && radix > 10 {
        // The mask folds both ASCII letter cases after subtracting 'A'.
        (int.wrapping_sub(b, b'A') & 0xDF) + 10
    } else {
        int.wrapping_sub(b, b'0')
    }
    let value: u32 = int.widen(digit)
    if value < radix && digit < 36 {
        Some(digit)
    } else {
        None
    }
}

/// Accumulates one numeric digit as value times radix plus digit. Returns None
/// when the result exceeds limit, including arithmetic overflow. The caller
/// checks that the digit and radix belong to its grammar. Alloc: nothing.
pub fn accumulate_digit(value: u64, radix: u32, digit: u8, limit: u64) -> Option[u64] {
    let base: u64 = int.widen(radix)
    let d: u64 = int.widen(digit)
    let Some(product) = int.checked_mul(value, base) else {
        return None
    }
    let Some(sum) = int.checked_add(product, d) else {
        return None
    }
    if sum > limit {
        None
    } else {
        Some(sum)
    }
}

pub fn parse[T: integer](s: String) -> Result[T, ParseError] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if n == 0 {
        return Error(Empty)
    }
    // T is signed exactly when it holds -1.
    let minus_one: Option[T] = int.try_narrow(-1i8)
    let negative = b[0] == b'-' && match minus_one {
        Some(_) => true,
        None => false,
    }
    let start: u64 = if negative {
        1
    } else {
        0
    }
    if start == n {
        return Error(Invalid(0))
    }
    // The largest all-nines values that fit the eight integer types.
    let digits19: Option[T] = int.try_narrow(9999999999999999999u64)
    let digits18: Option[T] = int.try_narrow(999999999999999999u64)
    let digits9: Option[T] = int.try_narrow(999999999u64)
    let digits4: Option[T] = int.try_narrow(9999u64)
    let fast_digits: u64 = if let Some(_) = digits19 {
        19
    } else if let Some(_) = digits18 {
        18
    } else if let Some(_) = digits9 {
        9
    } else if let Some(_) = digits4 {
        4
    } else {
        2
    }
    let mut mag: u64 = 0
    if n - start <= fast_digits {
        // Every number with this many digits fits T, including each prefix.
        for i in start .. n {
            let Some(digit) = ascii_digit(b[i], 10) else {
                return Error(Invalid(i))
            }
            mag = int.wrapping_add(int.wrapping_mul(mag, 10), int.widen(digit))
        }
    } else {
        // u64 holds every T's magnitude. Read the grammar to the end even
        // after overflow, so an invalid byte still wins over OutOfRange.
        let mut big = false
        for i in start .. n {
            let Some(digit) = ascii_digit(b[i], 10) else {
                return Error(Invalid(i))
            }
            if !big {
                match accumulate_digit(mag, 10, digit, 18446744073709551615) {
                    Some(v) => {
                        mag = v
                    },
                    None => {
                        big = true
                    },
                }
            }
        }
        if big {
            return Error(OutOfRange)
        }
    }
    if !negative || mag == 0 {
        let fit: Option[T] = int.try_narrow(mag)
        return match fit {
            Some(v) => Ok(v),
            None => Error(OutOfRange),
        }
    }
    // -mag fits exactly when mag - 1 fits, and is then (0 - (mag - 1)) - 1: both steps
    // stay in [MIN, 0], so neither check can fail.
    let below: Option[T] = int.try_narrow(mag - 1)
    let zero: T = int.narrow(0u8)
    let one: T = int.narrow(1u8)
    let value: Option[T] = match below {
        Some(v) => match int.checked_sub(zero, v) {
            Some(w) => int.checked_sub(w, one),
            None => None,
        },
        None => None,
    }
    match value {
        Some(v) => Ok(v),
        None => Error(OutOfRange),
    }
}

/// Writes n's unpadded ASCII digits into the suffix of digits and returns its
/// start offset. Radix is 2 through 36 with lowercase letters. Zero writes one
/// digit. Fails: Fail for an invalid radix, before changing digits.
/// Alloc: nothing. Cost: O(number of digits).
pub fn radix_digits(n: u64, radix: u32, mut digits: Inline[u8, 64]) -> u64 {
    if radix < 2 || radix > 36 {
        fail("int.radix_digits: radix outside 2..=36")
    }
    if radix == 10 {
        return decimal_digits(n, mut digits)
    }
    let base: u64 = int.widen(radix)
    let mut start: u64 = 64
    let mut value = n
    loop {
        let digit: u8 = int.narrow(value % base)
        start -= 1
        digits[start] = if digit < 10 {
            b'0' + digit
        } else {
            b'a' + (digit - 10)
        }
        value /= base
        if value == 0 {
            return start
        }
    }
}

fn decimal_four(n: u64, mut digits: Inline[u8, 64], at: u64) {
    // Two lanes of two digits. Multiplying by 103 and shifting by 10
    // divides each pair by ten exactly.
    let pairs = n / 100 | (n % 100) << 16
    let tens = (int.wrapping_mul(pairs, 103) >> 10) & 0x000F000F
    let word = (tens | int.wrapping_sub(pairs, int.wrapping_mul(tens, 10)) << 8) | 0x30303030
    digits[at] = int.truncate(word)
    digits[at + 1] = int.truncate(word >> 8)
    digits[at + 2] = int.truncate(word >> 16)
    digits[at + 3] = int.truncate(word >> 24)
}

fn decimal_digits(n: u64, mut digits: Inline[u8, 64]) -> u64 {
    let mut start: u64 = 64
    let mut value = n
    // Split eight digits into two groups of four and then four pairs.
    // Each pair occupies 16 bits, so its decimal arithmetic stays in its lane.
    while value >= 100000000 {
        let chunk = value % 100000000
        value /= 100000000
        start -= 8
        let halves = chunk / 10000 | (chunk % 10000) << 32
        let upper = (int.wrapping_mul(halves, 10486) >> 20) & 0x0000007F0000007F
        let pairs = upper | int.wrapping_sub(halves, int.wrapping_mul(upper, 100)) << 16
        let tens = (int.wrapping_mul(pairs, 103) >> 10) & 0x000F000F000F000F
        let word = (tens | int.wrapping_sub(pairs, int.wrapping_mul(tens, 10)) << 8) | 0x3030303030303030
        for i in 0u64 .. 8 {
            digits[start + i] = int.truncate(word >> (i * 8))
        }
    }
    if value >= 10000 {
        start -= 4
        decimal_four(value % 10000, mut digits, start)
        value /= 10000
    }
    if value >= 1000 {
        start -= 4
        decimal_four(value, mut digits, start)
        return start
    }
    loop {
        let digit: u8 = int.truncate(value % 10)
        start -= 1
        digits[start] = b'0' + digit
        value /= 10
        if value == 0 {
            return start
        }
    }
}

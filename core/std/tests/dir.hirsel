// Contract tests for `dir` (core/std/dir.hirsel), written to run once an engine runs
// library bodies with a host. Each test takes `dir`, a fresh empty directory the runner
// provides, and returns a scalar; the line `// expect: run f(dir) = R` above it gives the
// result derived by hand from the contract.
fn io(r: Result[(), IoError]) -> u64 {
    match r {
        Ok(()) => 0,
        Error(NotFound) => 1,
        Error(Denied) => 2,
        Error(Exists) => 3,
        Error(Closed) => 4,
        Error(Other(_)) => 5,
    }
}

// Created (0), then Exists (3).
// expect: run create_twice(dir) = 3
fn create_twice(d: Dir) -> u64 waits {
    let first = io(dir.create_dir(d, "sub"))
    let second = io(dir.create_dir(d, "sub"))
    first * 10 + second
}

// expect: run create_without_parent(dir) = 1
fn create_without_parent(d: Dir) -> u64 waits {
    io(dir.create_dir(d, "no/sub"))
}

// Removes the tree: the file below it is gone after.
// expect: run remove_all_tree(dir) = 1
fn remove_all_tree(d: Dir) -> u64 waits {
    result.unwrap(dir.create_dir(d, "sub"))
    result.unwrap(dir.create_dir(d, "sub/deeper"))
    result.unwrap(file.write(d, "sub/deeper/x", string.as_bytes("1")))
    result.unwrap(dir.remove_all(d, "sub"))
    io(file.remove(d, "sub/deeper/x"))
}

// expect: run remove_all_missing(dir) = 1
fn remove_all_missing(d: Dir) -> u64 waits {
    io(dir.remove_all(d, "absent"))
}

// The fresh name is appended after the prefix the caller wrote, and the directory exists:
// a file can be written in it through the Dir returned.
// expect: run create_temp_names(dir) = true
fn create_temp_names(d: Dir) -> bool waits {
    let mut name = string.with_capacity(40)
    string.push(mut name, "t-")
    let tmp = result.unwrap(dir.create_temp(d, mut name))
    result.unwrap(file.write(tmp, "x", string.as_bytes("1")))
    let grew = string.byte_len(name) > 2 && string.starts_with(name, "t-")
    result.unwrap(dir.remove_all(d, name))
    grew
}

// Less than 32 bytes of spare capacity in name.
// expect: run create_temp_small_name(dir) = fail Bounds
fn create_temp_small_name(d: Dir) -> bool waits {
    let mut name = string.new()
    let _ = dir.create_temp(d, mut name)
    true
}

// The scripted provider removes only tree/a, then EIO. tree/b is a surviving prefix.
// host: remove_tree_prefix a
// expect: run remove_tree_keeps_completed_prefix(dir) = true
fn remove_tree_keeps_completed_prefix(d: Dir) -> bool waits {
    result.unwrap(dir.create_dir(d, "tree"))
    result.unwrap(file.write(d, "tree/a", string.as_bytes("a")))
    result.unwrap(file.write(d, "tree/b", string.as_bytes("b")))
    match dir.remove_all(d, "tree") {
        Error(Other(5)) => {},
        _ => return false
    }
    match file.open(d, "tree/a", Read) {
        Error(NotFound) => {},
        _ => return false
    }
    let b = result.unwrap(file.read(d, "tree/b"))
    let kept = list.len(b) == 1 && b[0] == b'b'
    result.unwrap(dir.remove_all(d, "tree"))
    kept
}

// Every encoded record fits alone in 258 bytes. No pair fits, so a reader
// must retain a record it fetched at the end of the preceding call.
// expect: run list_small_batches(dir) = true
fn list_small_batches(d: Dir) -> bool waits {
    result.unwrap(dir.create_dir(d, "scan"))
    let scan = result.unwrap(dir.narrow(d, "scan"))
    let b = string.repeat("b", 255)
    let a = string.repeat("a", 254)
    let c = string.repeat("C", 253)
    result.unwrap(dir.create_dir(scan, b))
    result.unwrap(file.write(scan, a, string.as_bytes("a")))
    result.unwrap(file.write(scan, c, string.as_bytes("C")))
    let mut handle = result.unwrap(dir.entries(d, Some("scan")))
    let mut buf: Bytes = list.with_capacity(258)
    let mut seen: u8 = 0
    loop {
        let count = result.unwrap(dir.next_entries(mut handle, mut buf))
        if count == 0 {
            if list.len(buf) != 0 {
                fail("an empty batch appended bytes")
            }
            break
        }
        let size: u16 = list.word_le(buf, 1)
        let name_len: u64 = int.widen(size)
        if count != 1 || list.len(buf) != 3 + name_len {
            fail("a batch did not contain exactly one whole record")
        }
        let first = buf[3]
        let mask: u8 = if first == b'b' && size == 255 && buf[0] == 1 {
            1
        } else if first == b'a' && size == 254 && buf[0] == 0 {
            2
        } else if first == b'C' && size == 253 && buf[0] == 0 {
            4
        } else {
            fail("unexpected listing record")
        }
        if seen & mask != 0 {
            fail("a directory entry was delivered twice")
        }
        seen = seen | mask
        list.clear(mut buf)
    }
    if seen != 7 {
        fail("an entry was lost between batches")
    }
    let sorted = result.unwrap(dir.list(scan, None))
    list.len(sorted) == 3 && sorted[0].name == c && sorted[1].name == a && sorted[2].name == b
}

fn read_only_open_denied(r: Result[HostFile, IoError]) -> bool {
    match r {
        Error(Denied) => true,
        _ => false,
    }
}

fn read_only_write_denied(r: Result[(), WriteError]) -> bool {
    match r {
        Error(e) => e.written == 0 && io(Error(e.error)) == 2,
        Ok(()) => false,
    }
}

// expect: run read_only_dir_denies_writes(dir) = true
fn read_only_dir_denies_writes(d: Dir) -> bool waits {
    result.unwrap(host.mkdir(d, "nested"))
    result.unwrap(file.write(d, "nested/value", string.as_bytes("kept")))
    let ro = host.read_only(host.read_only(d))
    let child = result.unwrap(host.open_dir(ro, "nested"))
    if !read_only_open_denied(host.open(child, "value", Write)) || !read_only_open_denied(host.open(child, "value", Append)) || !read_only_open_denied(host.open(child, "new", CreateNew)) || !read_only_open_denied(host.open(child, "value", ReadWrite)) {
        return false
    }
    if io(host.mkdir(child, "new")) != 2 || io(host.remove(child, "value")) != 2 || io(host.rename(child, "value", "renamed")) != 2 || io(host.remove_tree(ro, "nested")) != 2 {
        return false
    }
    let mut name = string.new()
    match host.mkdtemp(ro, mut name) {
        Error(Denied) => {},
        _ => return false,
    }
    let mut f = result.unwrap(host.open(child, "value", Read))
    let replacement = string.as_bytes("lost")
    if !read_only_write_denied(host.write(mut f, replacement)) || !read_only_write_denied(host.write_at(mut f, 0, replacement)) {
        return false
    }
    let mut got: Bytes = list.with_capacity(4)
    let read = result.unwrap(host.read(mut f, mut got))
    result.unwrap(host.close(take f))
    let info = result.unwrap(host.stat(child, "value"))
    let mut entries = result.unwrap(host.entries(child, None))
    let mut encoded: Bytes = list.with_capacity(258)
    let count = result.unwrap(host.next_entries(mut entries, mut encoded))
    result.unwrap(host.sync_dir(child))
    read == 4 && got == b"kept" && info.size == 4 && count == 1 && string.byte_len(name) == 0
}

fn walk_tree(d: Dir) -> () waits {
    result.unwrap(dir.create_dir(d, "b"))
    result.unwrap(dir.create_dir(d, "a"))
    result.unwrap(dir.create_dir(d, "a/x"))
    for p in["b/z", "a.txt", "a/x/q", "b/.hidden"] {
        result.unwrap(file.write(d, p, string.as_bytes("")))
    }
}

// Go filepath.WalkDir at 8eaf19e visits the parent before its sorted children.
// Omit its starting directory. The native runner supplies link -> a.
// expect: run walkdir_preorder(dir) = true
fn walkdir_preorder(d: Dir) -> bool waits {
    walk_tree(d)
    let regular: Kind = File
    let order =[
        ("a", Directory),
        ("a/x", Directory),
        ("a/x/q", regular),
        ("a.txt", regular),
        ("b", Directory),
        ("b/.hidden", regular),
        ("b/z", regular),
        ("link", Symlink),
    ]
    let mut w = dir.walk(d, None)
    for (name, kind) in order {
        let Ok(Some(e)) = dir.next(mut w) else {
            return false
        }
        if e.name != name {
            return false
        }
        match (e.kind, kind) {
            (Directory, Directory) => {},
            (File, File) => {},
            (Symlink, Symlink) => {},
            _ => return false,
        }
    }
    match dir.next(mut w) {
        Ok(None) => true,
        _ => false
    }
}

// A skipped directory is never listed. A removed sibling returns one NotFound.
// expect: run walk_skip_and_resume(dir) = true
fn walk_skip_and_resume(d: Dir) -> bool waits {
    walk_tree(d)
    let mut w = dir.walk(d, None)
    dir.skip(mut w)
    let Ok(Some(a)) = dir.next(mut w) else {
        return false
    }
    if a.name != "a" {
        return false
    }
    result.unwrap(dir.remove_all(d, "a"))
    dir.skip(mut w)
    dir.skip(mut w)
    let Ok(Some(txt)) = dir.next(mut w) else {
        return false
    }
    if txt.name != "a.txt" {
        return false
    }
    dir.skip(mut w)
    let Ok(Some(b)) = dir.next(mut w) else {
        return false
    }
    if b.name != "b" {
        return false
    }
    result.unwrap(dir.remove_all(d, "b"))
    let Error(problem) = dir.next(mut w) else {
        return false
    }
    let Io(NotFound) = problem.error else {
        return false
    }
    if problem.path != "b" {
        return false
    }
    match dir.next(mut w) {
        Ok(None) => true,
        _ => false
    }
}

// expect: run glob_matches_walk(dir) = true
fn glob_matches_walk(d: Dir) -> bool waits {
    walk_tree(d)
    for pattern in["**", "a/**", "a/**/q", "a/x", "**/q", "*/*.txt", "**/.*", "?/x/*", "a\\.txt", "missing/*"] {
        let actual = result.unwrap(dir.glob(d, pattern))
        let mut index: u64 = 0
        let mut w = dir.walk(d, None)
        while let Some(e) = result.unwrap(dir.next(mut w)) {
            if result.unwrap(path.matches(pattern, e.name)) {
                if index == list.len(actual) || actual[index] != e.name {
                    return false
                }
                index += 1
            }
        }
        if index != list.len(actual) {
            return false
        }
    }
    true
}

// The scripted host refuses any listing outside these patterns' possible bases.
// host: glob_list_paths
// expect: run glob_prunes_and_accepts_missing_base(dir) = true
fn glob_prunes_and_accepts_missing_base(d: Dir) -> bool waits {
    for p in["base", "base/bad", "base/good", "base/good/deep", "outside"] {
        result.unwrap(dir.create_dir(d, p))
    }
    for p in["base/good/x", "base/good/deep/x", "base/bad/x", "outside/x"] {
        result.unwrap(file.write(d, p, string.as_bytes("")))
    }
    let Error(Pattern(Syntax(8))) = dir.glob(d, "outside/[") else {
        return false
    }
    let hits = result.unwrap(dir.glob(d, "base/g*/**/x"))
    if list.len(hits) != 2 || hits[0] != "base/good/deep/x" || hits[1] != "base/good/x" {
        return false
    }
    list.len(result.unwrap(dir.glob(d, "missing/*"))) == 0
}

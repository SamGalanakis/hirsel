fn journal_recover(d: Dir, id: StoreId, first: u64, c: Clock, take initial: pager.JournalReplay) -> Result[journal.JournalRecovered, Error] waits {
    let mut replay = take initial
    let mut seq = first
    let mut uncovered = 0u64
    loop {
        let path = failure_result_from_rep(manifest.journal_path(seq, ""))?
        let mut file = match host.open(d, path, Read) {
            Ok(take handle) => take handle,
            Error(NotFound) => return Error(failure_from_rep(format.disk_fault(path, 0, Header))),
            Error(e) => return Error(Io(e))
        }
        failure_result_from_rep(manifest.journal_wait_shared(mut file, c))?
        let mut source = failure_result_from_rep(journal.journal_input(take file, true))?
        let following = failure_result_from_rep(journal.journal_following(d, store_key_to_rep(id), seq, Some(c)))?
        let boundary = match following {
            Some(h) => Some(h.prev_end),
            None => failure_result_from_rep(journal.disk_end(d, store_key_to_rep(id), seq))?
        }
        let final_item = match following {
            None => true,
            Some(_) => false
        }
        let scanned = journal_scan(mut source, path, id, seq, 72, boundary, final_item, mut replay, scoped fn(mut recovered_state: pager.JournalReplay, take event: format.JournalEvent) -> Result[(), Error] {
            journal_apply(path, mut recovered_state, take event)
        })
        let consumed_file = format.take_journal_file(take source)
        let mut consumed = take consumed_file
        failure_result_from_rep(manifest.disk_io(host.unlock(mut consumed)))?
        failure_result_from_rep(manifest.disk_io(host.close(take consumed)))?
        let (end, segment_bytes) = match take scanned {
            Ok(segment) => segment,
            Error(Corrupt(take fault)) => {
                // A bad last HEADER without a good END is an incomplete
                // segment creation. Valid headers with bad frames follow d.
                // Only one segment is ever dropped: with a file after it, the
                // segment was complete when that file was created (§3.4 step 5).
                let no_end = match boundary {
                    None => true,
                    Some(_) => false
                }
                let next_path = failure_result_from_rep(manifest.journal_path(seq + 1, ""))?
                if final_item && no_end && seq == first && !failure_result_from_rep(journal.disk_exists(d, next_path))? {
                    if let Error(Corrupt(_)) = failure_result_from_rep(manifest.journal_header(d, store_key_to_rep(id), seq, None)) {
                        return Ok(journal.JournalRecovered(replay: take replay, seq: seq - 1, end: 0, uncovered: uncovered))
                    }
                }
                return Error(Corrupt(take fault))
            },
            Error(take e) => return Error(take e)
        }
        uncovered = int.saturating_add(uncovered, segment_bytes)
        if let None = following {
            return Ok(journal.JournalRecovered(replay: take replay, seq: seq, end: end, uncovered: uncovered))
        }
        seq += 1
    }
}

fn capture_scan(id: StoreId, deadline: Option[(Clock, u64)], take walk: journal.CaptureWalk, take initial: pager.JournalReplay) -> Result[pager.JournalReplay, Error] waits {
    let journal.CaptureWalk(segments: take selected, torn_tail: torn_tail, ..) = take walk
    let mut segments = take selected
    let segment_count = list.len(segments)
    // Scan the oldest segment first and transfer each descriptor once.
    for i in 0u64 .. segment_count / 2 {
        list.swap(mut segments, i, segment_count - i - 1)
    }
    let mut replay = take initial
    while let Some(take segment) = list.pop(mut segments) {
        failure_result_from_rep(format.check_journal_deadline(deadline))?
        let journal.CaptureSegment(file: take opened, seq: seq, boundary: stored_end) = take segment
        let tail = list.len(segments) == 0
        let torn = tail && torn_tail
        let boundary = if tail && !torn {
            Some(match stored_end {
                Some(end) => end,
                None => 72u64
            })
        } else {
            stored_end
        }
        let path = failure_result_from_rep(manifest.journal_path(seq, ""))?
        let mut source = failure_result_from_rep(journal.journal_input_with_deadline(take opened, torn, deadline))?
        failure_result_from_rep(journal.journal_refresh_size(mut source, boundary))?
        let scanned = journal_scan(mut source, path, id, seq, 72, boundary, torn, mut replay, scoped fn(mut recovered_state: pager.JournalReplay, take event: format.JournalEvent) -> Result[(), Error] {
            journal_apply(path, mut recovered_state, take event)
        })
        let consumed = format.take_journal_file(take source)
        let mut file = take consumed
        let unlocked = if torn {
            manifest.disk_io(host.unlock(mut file))
        } else {
            Ok(())
        }
        let closed = manifest.disk_io(host.close(take file))
        let _ = scanned?
        failure_result_from_rep(take unlocked)?
        failure_result_from_rep(take closed)?
    }
    failure_result_from_rep(format.check_journal_deadline(deadline))?
    Ok(take replay)
}

fn journal_apply_commit(file: String, mut replay: pager.JournalReplay, commit: format.JournalCommit) -> Result[(), Error] {
    failure_result_from_rep(txn.journal_apply_commit(file, mut replay, commit))
}

fn journal_apply(file: String, mut replay: pager.JournalReplay, take event: format.JournalEvent) -> Result[(), Error] {
    failure_result_from_rep(txn.journal_apply(file, mut replay, take event))
}

fn journal_apply_ops(file: String, mut ids: u64, mut tree: pages.PageTree, ops: List[format.JournalOp], mut account: pager.ReplayTieredAccount, immutable: bool) -> Result[(), Error] {
    failure_result_from_rep(txn.journal_apply_ops(file, mut ids, mut tree, ops, mut account, immutable))
}

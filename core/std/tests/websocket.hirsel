// RFC 6455 and tungstenite 89576c6 frame/mod.rs:316-430.
fn unhex(s: String) -> Bytes {
    option.unwrap(hex.decode(string.as_bytes(string.replace(s, " ", ""))))
}

fn event(e: websocket.Event) -> u16 {
    match e {
        Need => 0,
        Message(_) => 2,
        Text(_) => 1,
        Ping(_) => 9,
        Pong(_) => 10,
        Closed(_) => 8,
        Reject(code) => code,
        Ended => 65535
    }
}

fn first(b: Bytes, role: websocket.Role, max: u64) -> u16 {
    let mut d = websocket.decoder(role, max)
    let mut at: u64 = 0
    event(websocket.next(mut d, b, mut at))
}

fn payload(e: websocket.Event, expected: Bytes) -> bool {
    match e {
        Message(b) => b == expected,
        Text(b) => b == expected,
        _ => false
    }
}

fn control(e: websocket.Event, kind: u16, expected: Bytes) -> bool {
    let c = match e {
        Ping(c) => {
            if kind != 9 {
                return false
            };
            c
        },
        Pong(c) => {
            if kind != 10 {
                return false
            };
            c
        },
        Closed(c) => {
            if kind != 8 {
                return false
            };
            c
        },
        _ => return false
    }
    let mut b: Bytes = list.new()
    websocket.control(c, mut b)
    b == expected
}

// tungstenite frame/mod.rs: read_frames. Mutant: consume_next_frame_tail.
// expect: run read_frames() = true
fn read_frames() -> bool {
    let b = unhex("82 07 01 02 03 04 05 06 07 82 03 03 02 01 99")
    let mut d = websocket.decoder(Client, 256)
    let mut at: u64 = 0
    let a = payload(websocket.next(mut d, b, mut at), unhex("01 02 03 04 05 06 07")) && at == 9
    let c = payload(websocket.next(mut d, b, mut at), unhex("03 02 01")) && at == 14
    a && c && first(list.slice(b, at, list.len(b)), Client, 256) == 0
}

// tungstenite from_partially_read: partial header/payload saved between calls.
// Mutant: forget_partial_payload.
// expect: run from_partially_read() = true
fn from_partially_read() -> bool {
    let mut d = websocket.decoder(Client, 256)
    let a = unhex("82 07 01")
    let mut at: u64 = 0
    let partial = event(websocket.next(mut d, a, mut at)) == 0 && websocket.buffered(d) == 1
    let b = unhex("02 03 04 05 06 07")
    at = 0
    partial && payload(websocket.next(mut d, b, mut at), unhex("01 02 03 04 05 06 07")) && at == 6
}

// Oversized length is rejected from the ten-byte header before a mask/payload.
// Partial legal length holds arrived bytes, with rounded/growing allocation,
// not its 256 KiB declaration. Mutant: reserve_declared.
// expect: run length_before_reserve() = true
fn length_before_reserve() -> bool {
    let b = unhex("82 ff 00 00 00 00 00 04 00 01")
    let refused = bound bytes 0 {
        let mut d = websocket.decoder(Server, 262144)
        let mut at: u64 = 0
        event(websocket.next(mut d, b, mut at)) == 1009 && at == 10 && websocket.capacity(d) == 0
    }
    let c = unhex("82 ff 00 00 00 00 00 04 00 00 00 00 00 00 61 62 63")
    let partial = bound bytes 8208 {
        let scratch: Bytes = list.with_capacity(8192)
        let mut d = websocket.decoder(Server, 262144)
        let mut at: u64 = 0
        event(websocket.next(mut d, c, mut at)) == 0 && websocket.buffered(d) == 3 && websocket.capacity(d) == 4 && list.capacity(scratch) == 8192
    }
    result.unwrap(refused) && result.unwrap(partial)
}

// A 65th payload byte needs a 128-byte allocation while the 64-byte
// prefix is still live: under 128 bytes it raises Capacity(128, 64).
// expect: run grow_preserves_partial() = true
fn grow_preserves_partial() -> bool {
    let mut prefix = unhex("82 c1 00 00 00 00")
    for _ in 0u64 .. 64u64 {
        list.push(mut prefix, 97u8)
    }
    let last = unhex("62")
    let small = isolate(fn() -> Result[bool, Capacity] {
        bound bytes 128u64 {
            let mut d = websocket.decoder(Server, 256u64)
            let mut at = 0u64
            let got_prefix = event(websocket.next(mut d, prefix, mut at)) == 0
            at = 0u64
            got_prefix && event(websocket.next(mut d, last, mut at)) == 2
        }
    })
    let refused = match caught(take small) {
        Some(c) => c.requested == 128u64 && c.available == 64u64,
        None => false,
    }
    let enough = bound bytes 192u64 {
        let mut d = websocket.decoder(Server, 256u64)
        let mut at = 0u64
        let got_prefix = event(websocket.next(mut d, prefix, mut at)) == 0
        at = 0u64
        match websocket.next(mut d, last, mut at) {
            Message(message) => got_prefix && list.len(message) == 65u64 && list.slice(message, 0u64, 64u64) == list.slice(prefix, 6u64, 70u64) && message[64u64] == 98u8,
            _ => false,
        }
    }
    refused && result.unwrap(enough)
}

// RFC 6455 section 5.7 Hello, mask 37fa213d. Hand-derived masked bytes.
// Mutants: accept_unmasked, accept_masked_server, wrong_mask_phase.
// expect: run masks_both_roles() = true
fn masks_both_roles() -> bool {
    let b = unhex("82 85 37 fa 21 3d 7f 9f 4d 51 58")
    let mut d = websocket.decoder(Server, 256)
    let mut at: u64 = 0
    let decoded = payload(websocket.next(mut d, b, mut at), b"Hello")
    let mut split = websocket.decoder(Server, 256)
    at = 0
    let partial = event(websocket.next(mut split, list.slice(b, 0, 8), mut at)) == 0
    at = 0
    decoded && partial && payload(websocket.next(mut split, list.slice(b, 8, 11), mut at), b"Hello")
}

// Binary fragment + Ping emits Pong work before continuation has arrived.
// Mutants: pong_after_message, ping_breaks_assembly.
// expect: run binary_ping_mid_fragments() = true
fn binary_ping_mid_fragments() -> bool {
    let b = unhex("02 81 00 00 00 00 61 89 81 00 00 00 00 70")
    let mut d = websocket.decoder(Server, 256)
    let mut at: u64 = 0
    let ping = control(websocket.next(mut d, b, mut at), 9, b"p") && at == list.len(b) && websocket.buffered(d) == 1
    let c = unhex("80 82 00 00 00 00 62 63")
    at = 0
    ping && payload(websocket.next(mut d, c, mut at), b"abc")
}

// F16: U+20AC split across text fragments, with an intervening Ping.
// Mutants: validate_utf8_per_frame, ping_resets_utf8, reject_all_text.
// expect: run ping_mid_fragments() = true
fn ping_mid_fragments() -> bool {
    let b = unhex("01 01 e2 89 01 70 80 02 82 ac")
    let mut d = websocket.decoder(Client, 256)
    let mut at: u64 = 0
    let ping = control(websocket.next(mut d, b, mut at), 9, b"p") && at == 6
    let text = match websocket.next(mut d, b, mut at) {
        Text(v) => v == unhex("e2 82 ac"),
        _ => false
    }
    ping && text && first(unhex("01 01 e2 80 02 28 a1"), Client, 256) == 1007 && first(unhex("01 01 e2 80 00"), Client, 256) == 1007 && first(unhex("81 01 e2"), Client, 256) == 1007 && first(unhex("81 02 c0 80"), Client, 256) == 1007 && first(unhex("81 03 ed a0 80"), Client, 256) == 1007 && first(unhex("81 04 f4 90 80 80"), Client, 256) == 1007
}

// RFC 6455 protocol guards, with one counterexample per deleted check.
// Mutant: skip_rsv.
// expect: run rejects_rsv() = 1002
fn rejects_rsv() -> u16 {
    first(unhex("c2 00"), Client, 256)
}

// Mutant: allow_large_control.

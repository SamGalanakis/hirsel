// Binding used explicitly by the checkbox application and the wire fixtures.
// The client supplies a random 16-byte credential and keeps it across reconnects.
pub fn caller(_seed: (), supplied: Bytes) -> Result[runner.BoundCaller, runner.BindRefusal] {
    if list.len(supplied) != 16u64 {
        return Error(Rejected)
    }
    let tag = string.as_bytes("hirsel.example.credential.v1")
    let mut hash = std.sha256.start()
    std.sha256.add(mut hash, tag, 0u64, list.len(tag))
    std.sha256.add(mut hash, supplied, 0u64, list.len(supplied))
    let digest = std.sha256.finish(hash)
    let mut subject: Bytes = list.with_capacity(16u64)
    for i in 0u64 .. 16u64 {
        list.push(mut subject, digest[i])
    }
    Ok(runner.BoundCaller(caller: store.Caller(issuer: 2u8, subject: take subject), expires_at_ms: None))
}

pub fn binding() -> runner.Wire[()] {
    runner.wire(code.describe(caller), 4096u64, 65536u64)
}

// The unit G each bind of `binding` takes (RUNNER-SPEC v2.70 F4): this binding
// needs no authority, so its bind mint makes ().
fn unit_grant[H: shareable + inert + send](_seed: (), _handles: H, _input: ()) -> Result[(), Capacity] {
    Ok(())
}

pub fn bind_mint[H: shareable + inert + send]() -> runner.Mint[(), H, (), ()] {
    let mint: fn((), H, ()) -> Result[(), Capacity] = unit_grant
    runner.Mint(seed: (), mint: mint, mint_bytes: 4096u64, mint_steps: runner.DEFAULT_STEPS)
}

// A place's grants when its only mint is the unit bind mint.
pub fn bind_grants[H: shareable + inert + send]() -> runner.Grants[(), H, ()] {
    runner.Grants(attempt: None, call: None, claim: None, bind: Some(bind_mint()))
}

// The unit bind mint's task, for a session front served without a place's head.
// The front stops it with runner.stop_grants when its sessions end.
pub fn bind_task(tasks: Tasks) -> runner.PlaceGrants[()] {
    let given: runner.Grants[(), (), ()] = bind_grants()
    runner.grant_task(tasks, (), take given)
}

// `binding` with the bind mint `running` serves.
pub fn bound_wire(running: runner.PlaceGrants[()]) -> Option[runner.BindGrant[()]] {
    runner.grant_binds_of(running, binding())
}

pub fn credential(random: Random) -> Bytes {
    let mut bytes_out: Bytes = list.with_capacity(16u64)
    host.random(random, mut bytes_out)
    bytes_out
}

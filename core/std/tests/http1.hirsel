// UTF-8 scalars and CRLF may split at any byte. RFC 3629 excludes overlongs,
// surrogates and scalars above U+10FFFF. Mutants: rescan_from_zero,
// restart_cursor_loses_field.
// expect: run resume_utf8() = true
fn resume_utf8() -> bool {
    resume_parity(b"GET /\xc2\xa2\xe2\x82\xac\xf0\x90\x80\x80 HTTP/1.1\r\nA: x\r\nB: y\r\n\r\nTAIL", Some(39)) && resume_parity(b"GET /\xe0\x80 HTTP/1.1\r\n\r\n", None) && resume_parity(b"GET /\xed\xa0 HTTP/1.1\r\n\r\n", None) && resume_parity(b"GET /\xf4\x90 HTTP/1.1\r\n\r\n", None) && resume_parity(b"GET /\xe2\x82", None)
}

// HTTP-3 fixed bounds: exactly 8192 bytes succeeds; needing byte 8193 fails.
// Terminal results preserve the head and do no more work.
// expect: run resume_limits() = true
fn resume_limits() -> bool {
    let mut raw = b"GET / HTTP/1.1\r\nX:"
    while list.len(raw) < 8188 {
        list.push(mut raw, b'a')
    }
    list.append(mut raw, b"\r\n\r\n")
    let mut h = http1.head()
    let mut cur = http1.cursor()
    if http1.resume(list.slice(raw, 0, 8191), mut h, mut cur) != Partial || http1.resume(raw, mut h, mut cur) != Complete || h.end != 8192 || cur.examined != 8192 || cur.line_end != 16 {
        return false
    }
    let before = h
    if http1.resume(raw, mut h, mut cur) != Complete || !same_head(h, before) || cur.examined != 8192 {
        return false
    }
    raw[8190] = b'a'
    raw[8191] = b'a'
    h = http1.head()
    cur = http1.cursor()
    http1.resume(raw, mut h, mut cur) == TooLarge && cur.examined == 8192 && http1.request(raw, mut h) == TooLarge
}

// HTTP-3 counts initialized fields, including empty values and duplicates.
// expect: run resume_field_limit() = true
fn resume_field_limit() -> bool {
    let mut raw = b"GET / HTTP/1.1\r\n"
    for i in 0u64 .. 64u64 {
        list.append(mut raw, b"X:\r\n")
    }
    list.append(mut raw, b"\r\n")
    if !resume_parity(raw, Some(list.len(raw))) {
        return false
    }
    let mut h = http1.head()
    if http1.request(raw, mut h) != Complete || h.count != 64 {
        return false
    }
    raw[list.len(raw) - 2] = b'X'
    http1.request(raw, mut h) == TooLarge && resume_parity(raw, None)
}

// A request-line overflow maps to 414 rather than the field limit's 431.
// expect: run resume_request_line_limit() = true
fn resume_request_line_limit() -> bool {
    let mut raw = b"GET /"
    while list.len(raw) < 8192 {
        list.push(mut raw, b'a')
    }
    let mut h = http1.head()
    let mut cur = http1.cursor()
    http1.resume(raw, mut h, mut cur) == TooLarge && cur.line_end == 0 && cur.examined == 8192 && http1.request(raw, mut h) == TooLarge
}

// HTTP-3's 414 applies only when the request line alone overflows. A prefix
// of empty lines consumes head space, never request-line space.
// expect: run resume_prefixed_limit() = true
fn resume_prefixed_limit() -> bool {
    let mut raw = b"\r\n"
    while list.len(raw) < 8192 {
        list.push(mut raw, b'a')
    }
    let mut h = http1.head()
    let mut cur = http1.cursor()
    if http1.resume(raw, mut h, mut cur) != TooLarge || cur.line_start != 2 || cur.line_end != 0 || cur.examined != 8192 {
        return false
    }
    for i in 0u64 .. 8192u64 {
        raw[i] = 10
    }
    h = http1.head()
    cur = http1.cursor()
    http1.resume(raw, mut h, mut cur) == TooLarge && cur.line_start == 8192 && cur.line_end == 0 && cur.examined == 8192
}

// The request head ends at byte 27. The body is already in the buffer on
// some splits and does not change when the head first becomes complete.
// expect: run resume_exact_prefix_progress() = true
fn resume_exact_prefix_progress() -> bool {
    let raw = b"GET / HTTP/1.1\r\nHost: x\r\n\r\nbody"
    let mut names: List[Bytes] = list.new()
    list.push(mut names, b"Host")
    let mut values: List[Bytes] = list.new()
    list.push(mut values, b"x")
    request_case(raw, Complete, 27, Some(b"GET"), Some(b"/"), Some(1), names, values)
}

// llhttp test/request/uri.md, 36151b9a7d6320072e24e472a769a5e09f9e969d.
// Copyright Fedor Indutny, 2018. MIT, see vectors/llhttp-LICENSE.
// These heads carry the full request target to the caller, including its
// second question mark, absolute authority, vertical bar, or fragment.
// expect: run llhttp_request_targets() = true
fn llhttp_request_targets() -> bool {
    for (input, target, end) in[("GET /test.cgi?foo=bar?baz HTTP/1.1\r\n\r\n", "/test.cgi?foo=bar?baz", 38u64), ("GET http://hypnotoad.org:1234?hail=all HTTP/1.1\r\n\r\n", "http://hypnotoad.org:1234?hail=all", 51u64), ("GET /test.cgi?query=| HTTP/1.1\r\n\r\n", "/test.cgi?query=|", 34u64), ("GET /forums/1/topics/2375?page=1#posts-17408 HTTP/1.1\r\n\r\n", "/forums/1/topics/2375?page=1#posts-17408", 57u64),] {
        let b = string.as_bytes(input)
        let mut h = http1.head()
        if http1.request(b, mut h) != Complete || h.end != end || h.version != 1 || h.count != 0 {
            return false
        }
        if string.slice(input, h.method.start, h.method.end) != "GET" || string.slice(input, h.target.start, h.target.end) != target {
            return false
        }
    }
    true
}

// llhttp test/response/sample.md, 36151b9a7d6320072e24e472a769a5e09f9e969d.
// Copyright Fedor Indutny, 2018. MIT, see vectors/llhttp-LICENSE.
// httparse src/lib.rs, 9f29e79f9832dbd0ae5220acb17c1866745bdecd.
// Copyright Sean McArthur. MIT, see vectors/httparse-LICENSE.
// Missing reasons, LF-only heads, and partial heads retain committed fields.
// expect: run upstream_response_heads() = true
fn upstream_response_heads() -> bool {
    let cases: Inline[(String, http1.Progress, u64, u8, u16, String, u64, Inline[(String, String), 3]), 4] =[
    // llhttp simple response.
    ("HTTP/1.1 200 OK\r\nHeader1: Value1\r\nHeader2:\t Value2\r\nContent-Length: 0\r\n\r\n", Complete, 73u64, 1u8, 200u16, "OK", 3u64,[("Header1", "Value1"), ("Header2", "Value2"), ("Content-Length", "0")]),
    // httparse test_response_reason_missing_no_space_with_headers and test_response_no_cr.
    ("HTTP/1.1 200\r\nFoo: bar\r\n\r\n", Complete, 26u64, 1u8, 200u16, "", 1u64,[("Foo", "bar"), ("", ""), ("", "")]), ("HTTP/1.0 200\nContent-type: text/html\n\n", Complete, 38u64, 0u8, 200u16, "", 1u64,[("Content-type", "text/html"), ("", ""), ("", "")]),
    // httparse test_response_partial_parses_headers_as_much_as_it_can.
    ("HTTP/1.1 200 OK\r\nServer: yolo\r\n", Partial, 0u64, 1u8, 200u16, "OK", 1u64,[("Server", "yolo"), ("", ""), ("", "")]),]
    for (input, progress, end, version, status, reason, count, fields) in cases {
        let b = string.as_bytes(input)
        let mut h = http1.head()
        if http1.response(b, mut h) != progress || h.version != version || h.status != status || h.count != count {
            return false
        }
        if (progress == Complete && h.end != end) || string.slice(input, h.reason.start, h.reason.end) != reason {
            return false
        }
        for i in 0u64 .. h.count {
            let f = h.fields[i]
            let (name, value) = fields[i]
            if string.slice(input, f.name.start, f.name.end) != name || string.slice(input, f.value.start, f.value.end) != value {
                return false
            }
        }
    }
    true
}

// httparse src/lib.rs, 9f29e79f9832dbd0ae5220acb17c1866745bdecd.
// Copyright Sean McArthur. MIT, see vectors/httparse-LICENSE.
// These are the default strict parser results.
// expect: run httparse_rejects_malformed_response_heads() = true
fn httparse_rejects_malformed_response_heads() -> bool {
    for input in[
    // test_response_reason_with_nul_byte.
    "HTTP/1.1 200 \0\r\n\r\n",
    // test_forbid_response_with_whitespace_between_header_name_and_colon.
    "HTTP/1.1 200 OK\r\nAccess-Control-Allow-Credentials : true\r\nBread: baguette\r\n\r\n",
    // test_forbid_response_with_obsolete_line_folding_at_start.
    "HTTP/1.1 200 OK\r\nLine-Folded-Header: \r\n   \r\n hello there\r\n\r\n",] {
        let mut h = http1.head()
        if http1.response(string.as_bytes(input), mut h) != Bad {
            return false
        }
    }
    true
}

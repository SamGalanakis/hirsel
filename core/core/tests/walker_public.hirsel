// Public-only control: core tests have no access to a library module's private names.
// expect: run owned_bytes() = true
fn owned_bytes() -> bool {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 7)
    list.len(xs) == 1 && xs[0] == 7
}

// The 296-byte root limit leaves 8 bytes after startup. The list needs 16.
// test-limit: 296
// expect: run list_root_limit() = fail Capacity
fn list_root_limit() -> bool {
    let mut values: List[u64] = list.with_capacity(2)
    list.push(mut values, 7)
    list.push(mut values, 9)
    values[0] + values[1] == 16
}

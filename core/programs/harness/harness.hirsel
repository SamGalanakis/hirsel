// A Hirsel LLM harness: one Place holds one session. The turn is rows and
// short transactions; no code runs between effects. See README.md.

// ---- payloads, entries and receipts ----

// Payloads larger than INLINE_LIMIT will be stored as a BlobRef once
// std.object lands. Until then an oversized payload is refused at admission.
pub type BlobRef: codec + send { digest: Bytes, len: u64, mime: String }
pub type Payload: codec + send = Inline(Bytes) | Blob(BlobRef)
pub const INLINE_LIMIT: u64 = 65536u64

pub type Call: codec + send { id: String, name: String, args: Payload }
pub type Usage: codec + send { input: u64, output: u64 }
// model.answer: the complete, validated provider outcome.
pub type Answer: codec + send { text: String, calls: List[Call], stop: String, usage: Usage }
pub type Outcome: codec + send = Returned(Payload) | Failed(String) | Denied(String) | InDoubt | Gone
// A positional system patch. A baseline replaces every section with its
// changes, in order. Otherwise a change for a shown key replaces its text in
// place, a change for a new key is added at the end, and `None` removes the
// key. `tools`, when present, replaces the offered tool definitions.
pub type Change: codec + send { key: String, text: Option[String] }
pub type ToolDef: codec + send { name: String, about: String, input: String, rev: u64, catalog: Option[Bytes] }
pub type Patch: codec + send { baseline: bool, changes: List[Change], tools: Option[List[ToolDef]] }
pub type Entry: codec + send =
    User(String)
    | Inform(String)
    | Assistant(Answer)
    | ToolResult(String, Outcome)
    | System(Patch)
    | Reset(String)
    | Note(String, Bytes)

// ---- the harness tables ----

pub type Narrow: codec + send = All | Only(List[String])
pub type SectionHash: codec + send { key: String, hash: Bytes }
pub type Session: codec + send {
    model: String,
    tools_narrow: Narrow,
    head_pos: u64,
    next_pos: u64,
    active_run: Option[u64],
    next_run: u64,
    active_sections_hashes: List[SectionHash],
    active_tools_hash: Bytes,
    active_tools_pos: Option[u64],
}

pub type InboxKey: codec + send { caller: store.Caller, client_key: String }
pub type Disposition: codec + send = Placed(u64) | Busy
pub type Received: codec + send { digest: Bytes, disposition: Disposition }

pub type Finish: codec + send = Answered | OutOfRounds | Stopped(String)
pub type Phase: codec + send = Preparing | AwaitingModel(u64) | AnswerReady(u64) | AwaitingRound(u64, u64) | Finished(Finish)
// Known spend is settled usage; reserved is the bound held for calls that may
// still be charged; unresolved is a reservation whose call is in doubt.
pub type Spend: codec + send { known: u64, reserved: u64, unresolved: u64 }
pub type Run: codec + send { caller: store.Caller, phase: Phase, round: u64, rounds_left: u64, spend: Spend }

pub const MODEL: u8 = 0u8
pub const TOOL: u8 = 1u8
pub type EffectKey: codec + send { run: u64, round: u64, kind: u8, ordinal: u64 }
// The immutable logical cutoff of a model request. The worker builds the body
// from entries[head_pos..=tail_pos] through a snapshot, off the write lock.
pub type Cutoff: codec + send { head_pos: u64, tail_pos: u64, route: String, policy: u64, tools_pos: Option[u64] }
// Once dispatches at most one body. Repeatable(n) resends with the same key
// up to n dispatches within the deadline.
pub type Repeat: codec + send = Once | Repeatable(u64)
pub type Receipt: codec + send = Model(Answer) | ModelFailed(String) | Tool(Outcome)
// Held waits for an approval; Parked waits for `resume` after an Inside tool
// returned Later.
pub type EffectPhase: codec + send = Pending | Held | Parked | Sealed | Dispatched(u64) | Settled(Receipt) | Doubted
pub type Effect: codec + send {
    cutoff: Cutoff,
    call: Option[Call],
    repeat: Repeat,
    deadline: u64,
    phase: EffectPhase,
    trigger: Option[store.triggers.Id],
    dispatches: u64,
    reserve: u64,
}

pub type WaitKey: codec + send { run: u64, slot: u64, kind: u8, generation: u64 }
// An open approval holds its key and the wall-clock ms at which it expires.
pub type Wait: codec + send = Open(Bytes, u64) | Decided(Bytes, bool) | Expired | Revoked

// The public Cover projection. Key 0 is the status row; key p + 1 is the
// visible line of entry p.
pub type View: codec + send = Status(String) | Line(String, String)

pub type Handles: send {
    session: store.Table[u64, Session],
    entries: store.Table[u64, Entry],
    inbox: store.Table[InboxKey, Received],
    runs: store.Table[u64, Run],
    effects: store.Table[EffectKey, Effect],
    waits: store.Table[WaitKey, Wait],
    views: store.Table[u64, View],
    mcp_catalog: store.Table[String, mcp_tools.Remote],
    triggers: store.triggers.Tables,
}

fn session_name() -> String { "harness.session" }
fn entries_name() -> String { "harness.entries" }
fn inbox_name() -> String { "harness.inbox" }
fn runs_name() -> String { "harness.runs" }
fn effects_name() -> String { "harness.effects" }
fn waits_name() -> String { "harness.waits" }
fn views_name() -> String { "harness.views" }

fn put_inbox_key(k: InboxKey, mut out: Bytes) {
    std.codec.put_key_u8(k.caller.issuer, mut out)
    std.codec.put_key_bytes(k.caller.subject, mut out)
    std.codec.put_key_string(k.client_key, mut out)
}

fn take_inbox_key(raw: Bytes, mut at: u64) -> Result[InboxKey, std.codec.DecodeError] {
    let issuer = std.codec.take_key_u8(raw, mut at)?
    let subject = std.codec.take_key_bytes(raw, mut at)?
    let client_key = std.codec.take_key_string(raw, mut at)?
    Ok(InboxKey(caller: store.Caller(issuer: issuer, subject: take subject), client_key: take client_key))
}

fn inbox_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 3u64)?
    std.codec.schema_u8(mut s)
    std.codec.schema_key(mut s, std.codec.key_bytes())?
    std.codec.schema_string(mut s)
    Ok(())
}

fn inbox_key() -> std.codec.Key[InboxKey] { std.codec.key_make(put_inbox_key, take_inbox_key, inbox_schema) }

fn put_effect_key(k: EffectKey, mut out: Bytes) {
    std.codec.put_key_u64(k.run, mut out)
    std.codec.put_key_u64(k.round, mut out)
    std.codec.put_key_u8(k.kind, mut out)
    std.codec.put_key_u64(k.ordinal, mut out)
}

fn take_effect_key(raw: Bytes, mut at: u64) -> Result[EffectKey, std.codec.DecodeError] {
    let run = std.codec.take_key_u64(raw, mut at)?
    let round = std.codec.take_key_u64(raw, mut at)?
    let kind = std.codec.take_key_u8(raw, mut at)?
    let ordinal = std.codec.take_key_u64(raw, mut at)?
    Ok(EffectKey(run: run, round: round, kind: kind, ordinal: ordinal))
}

fn quad_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 4u64)?
    std.codec.schema_u64(mut s)
    std.codec.schema_u64(mut s)
    std.codec.schema_u8(mut s)
    std.codec.schema_u64(mut s)
    Ok(())
}

fn effect_key() -> std.codec.Key[EffectKey] { std.codec.key_make(put_effect_key, take_effect_key, quad_schema) }

fn put_wait_key(k: WaitKey, mut out: Bytes) {
    std.codec.put_key_u64(k.run, mut out)
    std.codec.put_key_u64(k.slot, mut out)
    std.codec.put_key_u8(k.kind, mut out)
    std.codec.put_key_u64(k.generation, mut out)
}

fn take_wait_key(raw: Bytes, mut at: u64) -> Result[WaitKey, std.codec.DecodeError] {
    let run = std.codec.take_key_u64(raw, mut at)?
    let slot = std.codec.take_key_u64(raw, mut at)?
    let kind = std.codec.take_key_u8(raw, mut at)?
    let generation = std.codec.take_key_u64(raw, mut at)?
    Ok(WaitKey(run: run, slot: slot, kind: kind, generation: generation))
}

fn wait_key() -> std.codec.Key[WaitKey] { std.codec.key_make(put_wait_key, take_wait_key, quad_schema) }

// Re-running the migration on a migrated store is a no-op, as for the
// trigger tables, so a place reopens a store a host seeded.
fn created(take r: Result[(), store.Error]) -> Result[(), store.Error] {
    match take r {
        Error(Exists(_)) => Ok(()),
        other => take other,
    }
}

pub fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    store.triggers.migrate(mut phase)?
    mcp_tools.migrate(mut phase)?
    let c_session: std.codec.Codec[Session] = std.codec.of()
    let c_entry: std.codec.Codec[Entry] = std.codec.of()
    let c_received: std.codec.Codec[Received] = std.codec.of()
    let c_run: std.codec.Codec[Run] = std.codec.of()
    let c_effect: std.codec.Codec[Effect] = std.codec.of()
    let c_wait: std.codec.Codec[Wait] = std.codec.of()
    let c_shown: std.codec.Codec[View] = std.codec.of()
    created(store.migration_create_table(mut phase, store.spec(session_name(), std.codec.key_u64(), c_session)))?
    created(store.migration_create_table(mut phase, store.spec(entries_name(), std.codec.key_u64(), c_entry)))?
    created(store.migration_create_table(mut phase, store.spec(inbox_name(), inbox_key(), c_received)))?
    created(store.migration_create_table(mut phase, store.spec(runs_name(), std.codec.key_u64(), c_run)))?
    created(store.migration_create_table(mut phase, store.spec(effects_name(), effect_key(), c_effect)))?
    created(store.migration_create_table(mut phase, store.spec(waits_name(), wait_key(), c_wait)))?
    created(store.migration_create_table(mut phase, store.spec(views_name(), std.codec.key_u64(), c_shown)))
}

pub fn handles(schema: store.Schema) -> Result[Handles, store.Error] {
    let c_session: std.codec.Codec[Session] = std.codec.of()
    let c_entry: std.codec.Codec[Entry] = std.codec.of()
    let c_received: std.codec.Codec[Received] = std.codec.of()
    let c_run: std.codec.Codec[Run] = std.codec.of()
    let c_effect: std.codec.Codec[Effect] = std.codec.of()
    let c_wait: std.codec.Codec[Wait] = std.codec.of()
    let c_shown: std.codec.Codec[View] = std.codec.of()
    Ok(Handles(
        session: store.schema_table(schema, session_name(), std.codec.key_u64(), c_session)?,
        entries: store.schema_table(schema, entries_name(), std.codec.key_u64(), c_entry)?,
        inbox: store.schema_table(schema, inbox_name(), inbox_key(), c_received)?,
        runs: store.schema_table(schema, runs_name(), std.codec.key_u64(), c_run)?,
        effects: store.schema_table(schema, effects_name(), effect_key(), c_effect)?,
        waits: store.schema_table(schema, waits_name(), wait_key(), c_wait)?,
        views: store.schema_table(schema, views_name(), std.codec.key_u64(), c_shown)?,
        mcp_catalog: mcp_tools.catalog(schema)?,
        triggers: store.triggers.tables(schema)?,
    ))
}

// ---- the composition ----

pub type Fault: codec + send = BadArgs(String) | Refused(String) | Unavailable | TooLarge
// What the model is sent. `system` and `tools` are the fold of the System
// entries up to the cutoff, so a resend is built from the log and never from
// the agent's current code.
pub type Request: codec + send { route: String, system: List[String], tools: List[ToolDef], messages: List[Entry], key: Bytes }

// What an Inside tool is given: its call's key, which `resume` takes, and its
// arguments.
pub type Invoke: codec + send { key: EffectKey, args: Bytes }
// An Inside tool answers now, or Later: it has written whatever row will
// eventually call `resume` for its key (a timer, a webhook row, another
// place's reply), and the call stays parked until then.
pub type Reply: codec + send = Now(Bytes) | Later

pub type ToolRun[G: send]: send =
    Outside(StaticFn[fn(G, take Bytes) -> Result[Bytes, Fault] waits], Repeat)
    | Inside(StaticFn[fn(mut store.Tx, Invoke) -> Result[Reply, Fault]])
    | Mcp(Bytes)

// `rev` names the tool's behaviour in approval keys: raise it when the same
// arguments would now do something else, so earlier approvals stop matching.
// `repair` is a pure rewrite of the arguments that runs before the gates.
pub type Tool[G: send]: send { name: String, about: String, input: String, rev: u64, repair: Option[StaticFn[fn(Bytes) -> Result[Bytes, Fault]]], run: ToolRun[G] }

// A gate's verdict. Verdicts fold by maximum, Pass < Hold < Deny, so adding
// a gate can only make a call less allowed, and the order of gates does not
// change the result.
pub type Verdict: codec + send = Pass | Hold(String) | Deny(String)
// A gate sees a read-only transaction and the call with the caller of the
// submission that started the run, never the caller of the trigger it runs in.
pub type Ask: codec + send { caller: store.Caller, call: Call }
pub type Gate: send { name: String, check: StaticFn[fn(store.Tx, Ask) -> Verdict] }

// A keyed system-prompt section, rendered from rows each time a request is
// prepared. List order is prompt order. `None` removes it; a render that
// fails or overruns keeps the text it showed last.
pub type Section: send { key: String, render: StaticFn[fn(store.Tx) -> Result[Option[String], store.Error]] }

// Runs in the transaction that appends an entry, with the entry's position.
// It may write its own rows and triggers. It cannot veto or edit the entry:
// a reaction that fails has its writes rolled back and is recorded as a Note.
pub type After: send { name: String, run: StaticFn[fn(mut store.Tx, u64, Entry) -> Result[(), Fault]] }

pub type Limits: send {
    rounds: u64, calls: u64, model_ms: u64, tool_ms: u64, model_reserve: u64,
    inside_bytes: u64, inside_steps: u64, gate_bytes: u64, gate_steps: u64, section_bytes: u64, section_steps: u64, hold_ms: u64,
}

pub type Agent[G: send]: send {
    name: String,
    route: String,
    model: StaticFn[fn(G, take Request) -> Result[Answer, Fault] waits],
    model_repeat: Repeat,
    tools: List[Tool[G]],
    mcp_peer: Option[StaticFn[fn(G, String) -> Option[mcp_tools.Peer]]],
    gates: List[Gate],
    sections: List[Section],
    reactions: List[After],
    limits: Limits,
}

pub fn agent[G: send](take name: String, take route: String, model: StaticFn[fn(G, take Request) -> Result[Answer, Fault] waits]) -> Agent[G] {
    Agent(name: take name, route: take route, model: model, model_repeat: Once, tools: list.new(), mcp_peer: None, gates: list.new(),
        sections: list.new(), reactions: list.new(),
        limits: Limits(rounds: 8u64, calls: 8u64, model_ms: 120000u64, tool_ms: 60000u64, model_reserve: 4096u64,
                        // Gates and sections read rows; opening a table alone takes over
            // 10,000 steps.
            inside_bytes: 65536u64, inside_steps: 1000000u64, gate_bytes: 16384u64, gate_steps: 100000u64,
            section_bytes: 16384u64, section_steps: 100000u64, hold_ms: 86400000u64))
}

pub fn outside[G: send](take name: String, take about: String, take input: String, repeat: Repeat, f: StaticFn[fn(G, take Bytes) -> Result[Bytes, Fault] waits]) -> Tool[G] {
    Tool(name: take name, about: take about, input: take input, rev: 1u64, repair: None, run: Outside(f, repeat))
}

pub fn inside[G: send](take name: String, take about: String, take input: String, f: StaticFn[fn(mut store.Tx, Invoke) -> Result[Reply, Fault]]) -> Tool[G] {
    Tool(name: take name, about: take about, input: take input, rev: 1u64, repair: None, run: Inside(f))
}

// ---- wiring: the app's trigger targets, rebuilt in each transaction ----

pub type Wake: codec + send = Kick | Deadline(EffectKey) | Expire(WaitKey)
pub type Refused: codec + send = NotAllowed | Conflict | TooLarge | Malformed(String) | Storage

pub opaque type Wiring { entries: store.triggers.Entries, advance: store.triggers.Entry[Wake], effect: store.triggers.Entry[EffectKey] }

pub fn wiring[H, G, R, E, W](advance_fn: StaticFn[fn(mut store.Tx, H, store.Caller, take Wake) -> Result[R, E]], effect_fn: StaticFn[fn(G, store.Caller, take EffectKey) -> Result[W, Capacity] waits]) -> Result[Wiring, Refused] {
    let a = store.triggers.transact(advance_fn) ?=> |_| Malformed("advance target")
    let e = store.triggers.granted(effect_fn) ?=> |_| Malformed("effect target")
    let mut allowed = store.triggers.empty_entries()
    store.triggers.allow(mut allowed, a) ?=> |_| Malformed("advance target")
    store.triggers.allow(mut allowed, e) ?=> |_| Malformed("effect target")
    Ok(Wiring(entries: take allowed, advance: take a, effect: take e))
}

// The trigger allowlist the place's TriggerConfig carries.
pub fn entries(w: Wiring) -> store.triggers.Entries { clone(w.entries) }

fn kept[T](take r: Result[T, store.Error]) -> Result[T, Refused] {
    match take r { Ok(take v) => Ok(take v), Error(_) => Error(Storage) }
}

fn armed(take r: Result[store.triggers.Id, store.triggers.Error]) -> Result[store.triggers.Id, Refused] {
    match take r { Ok(id) => Ok(id), Error(_) => Error(Storage) }
}

fn session_of(tx: store.Tx, h: Handles) -> Result[Session, Refused] {
    match kept(store.fetch(tx, store.shape(h.session), 0u64))? {
        Some(take s) => Ok(take s),
        None => Error(Malformed("no session")),
    }
}

// Opens the singleton session. Idempotent: an existing session is kept.
pub fn open_session(mut tx: store.Tx, h: Handles, take model: String, take narrow: Narrow) -> Result[(), Refused] {
    if let Some(_) = kept(store.fetch(tx, store.shape(h.session), 0u64))? { return Ok(()) }
    let s = Session(model: take model, tools_narrow: take narrow, head_pos: 0u64, next_pos: 0u64, active_run: None,
        next_run: 0u64, active_sections_hashes: list.new(), active_tools_hash: list.new(), active_tools_pos: None)
    kept(store.put(mut tx, h.session, 0u64, s))?
    kept(store.put(mut tx, h.views, 0u64, Status("idle")))
}

// ---- forks ----

// An exported prefix: entries[0..len) and the session settings they ran
// under. A fork is a new session seeded from one; it shares these entries and
// nothing else.
pub type Prefix: codec + send { model: String, tools_narrow: Narrow, head_pos: u64, entries: List[Entry] }

// Exports entries[0..upto) through a snapshot. A cut inside a tool round (an
// Assistant whose calls do not all have results before `upto`) conflicts: the
// fork's first request would carry calls with no results.
pub fn export(snap: store.Snapshot, h: Handles, upto: u64) -> Result[Prefix, Refused] {
    let Some(s) = kept(store.get(snap, store.shape(h.session), 0u64))? else { return Error(Malformed("no session")) }
    if upto > s.next_pos || s.head_pos > upto { return Error(Malformed("cut outside the log")) }
    let mut log: List[Entry] = list.with_capacity(upto)
    let mut open: List[String] = list.new()
    for p in 0u64..upto {
        let Some(take e) = kept(store.get(snap, store.shape(h.entries), p))? else { return Error(Malformed("entry")) }
        match e {
            Assistant(answer) => {
                open = list.new()
                for c in answer.calls { list.push(mut open, clone(c.id)) }
            },
            ToolResult(id, _) => {
                let mut rest: List[String] = list.new()
                for o in open { if o != id { list.push(mut rest, clone(o)) } }
                open = take rest
            },
            _ => (),
        }
        list.push(mut log, take e)
    }
    if list.len(open) > 0u64 { return Error(Conflict) }
    Ok(Prefix(model: clone(s.model), tools_narrow: clone(s.tools_narrow), head_pos: s.head_pos, entries: take log))
}

// Seeds an empty session from a prefix: its entries and their visible lines,
// with no runs, inbox, effects or waits. Reactions do not run again; what
// they wrote in the parent stays there. The section and tool hashes start
// empty, so the fork's first prepare appends a baseline.
pub fn adopt(mut tx: store.Tx, h: Handles, take p: Prefix) -> Result[(), Refused] {
    if let Some(_) = kept(store.fetch(tx, store.shape(h.session), 0u64))? { return Error(Conflict) }
    let Prefix(model: take model, tools_narrow: take narrow, head_pos: head, entries: take log) = take p
    let mut s = Session(model: take model, tools_narrow: take narrow, head_pos: head, next_pos: 0u64, active_run: None,
        next_run: 0u64, active_sections_hashes: list.new(), active_tools_hash: list.new())
    for e in log { let _ = put_entry(mut tx, h, mut s, e)? }
    kept(store.put(mut tx, h.session, 0u64, s))?
    kept(store.put(mut tx, h.views, 0u64, Status("idle")))
}

fn digest(raw: Bytes) -> Bytes {
    let d = std.sha256.hash(raw)
    let mut out: Bytes = list.with_capacity(32u64)
    for i in 0u64..32u64 { list.push(mut out, d[i]) }
    take out
}

fn line(e: Entry) -> Option[View] {
    match e {
        User(text) => Some(Line("user", clone(text))),
        Inform(text) => Some(Line("info", clone(text))),
        Assistant(answer) => Some(Line("assistant", clone(answer.text))),
        ToolResult(id, _) => Some(Line("tool", clone(id))),
        _ => None,
    }
}

// Appends one entry at the session tail and its visible line in the same
// transaction. The caller writes the session row.
fn append[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], mut s: Session, take e: Entry) -> Result[u64, Refused] {
    let at = put_entry(mut tx, h, mut s, e)?
    for r in a.reactions {
        if !reacted(mut tx, r, at, e, a.limits) {
            let _ = put_entry(mut tx, h, mut s, Note("reaction failed", string.into_bytes(clone(r.name))))?
        }
    }
    Ok(at)
}

fn put_entry(mut tx: store.Tx, h: Handles, mut s: Session, e: Entry) -> Result[u64, Refused] {
    let at = s.next_pos
    if let Some(take v) = line(e) { kept(store.put(mut tx, h.views, at + 1u64, v))? }
    kept(store.put(mut tx, h.entries, at, clone(e)))?
    s.next_pos = at + 1u64
    Ok(at)
}

// One reaction, under the Inside byte and step bounds, with its writes rolled
// back if it fails or overruns.
fn reacted(mut tx: store.Tx, r: After, at: u64, e: Entry, l: Limits) -> bool {
    let go = code.callable(r.run)
    let ran = store.rollback_writes_on_overrun(mut tx, l.inside_steps, scoped fn(mut t: store.Tx) -> Result[(), Fault] {
        let bounded = bound bytes l.inside_bytes { go(mut t, at, clone(e)) }
        match take bounded { Ok(take done) => take done, Error(_) => Error(TooLarge) }
    })
    match ran { Ok(Ok(())) => true, _ => false }
}

fn status(mut tx: store.Tx, h: Handles, take text: String) -> Result[(), Refused] {
    kept(store.put(mut tx, h.views, 0u64, Status(take text)))
}

pub type Submit: codec + send { client_key: String, text: String }

// Admits a submission. A repeated key with identical bytes returns its
// recorded disposition; different bytes conflict. A submission that arrives
// while a run is active is answered Busy and leaves no row, so the same key
// may be sent again once the run ends.
pub fn submit[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, caller: store.Caller, take m: Submit) -> Result[Disposition, Refused] {
    if string.byte_len(m.text) > INLINE_LIMIT { return Error(TooLarge) }
    let Submit(client_key: take client_key, text: take text) = take m
    let key = InboxKey(caller: clone(caller), client_key: take client_key)
    let d = digest(string.as_bytes(text))
    if let Some(seen) = kept(store.fetch(tx, store.shape(h.inbox), key))? {
        if seen.digest != d { return Error(Conflict) }
        return Ok(clone(seen.disposition))
    }
    let mut s = session_of(tx, h)?
    if let Some(_) = s.active_run { return Ok(Busy) }
    let _ = append(mut tx, h, a, mut s, User(take text))?
    let id = s.next_run
    s.next_run = id + 1u64
    s.active_run = Some(id)
    let run = Run(caller: clone(caller), phase: Preparing, round: 0u64, rounds_left: a.limits.rounds,
        spend: Spend(known: 0u64, reserved: 0u64, unresolved: 0u64))
    kept(store.put(mut tx, h.runs, id, run))?
    kept(store.put(mut tx, h.session, 0u64, s))?
    kept(store.put(mut tx, h.inbox, key, Received(digest: take d, disposition: Placed(id))))?
    advance(mut tx, h, a, w, Kick)?
    Ok(Placed(id))
}

fn finish(mut tx: store.Tx, h: Handles, mut s: Session, id: u64, take r: Run, take why: Finish) -> Result[(), Refused] {
    let mut run = take r
    let shown = match why { Answered => "answered", OutOfRounds => "out of rounds", Stopped(_) => "stopped" }
    run.phase = Finished(take why)
    kept(store.put(mut tx, h.runs, id, run))?
    s.active_run = None
    kept(store.put(mut tx, h.session, 0u64, s))?
    status(mut tx, h, take shown)
}

fn tool_of[G: send](a: Agent[G], name: String) -> Option[Tool[G]] {
    for t in a.tools { if t.name == name { return Some(clone(t)) } }
    None
}

// Read only the tool definitions the model saw. The pointer stays fixed even
// when later System entries change sections without changing tools.
fn matching_remote(pinned: Option[Entry], name: String, row: mcp_tools.Remote) -> bool {
    let Some(System(patch)) = view pinned else { return false }
    let Some(defs) = view patch.tools else { return false }
    for def in defs {
        if def.name == name {
            return def.catalog == Some(clone(mcp_tools.fingerprint(row)))
        }
    }
    false
}

fn current_remote(tx: store.Tx, h: Handles, cutoff: Cutoff, name: String) -> Result[Option[mcp_tools.Remote], Refused] {
    let Some(pos) = cutoff.tools_pos else { return Ok(None) }
    let Some(take row) = kept(store.fetch(tx, store.shape(h.mcp_catalog), name))? else { return Ok(None) }
    let pinned = kept(store.fetch(tx, store.shape(h.entries), pos))?
    if matching_remote(pinned, name, row) { Ok(Some(take row)) } else { Ok(None) }
}

fn resolve_tool[G: send](tx: store.Tx, h: Handles, a: Agent[G], cutoff: Cutoff, name: String) -> Result[Option[Tool[G]], Refused] {
    if !mcp_tools.reserved(name) { return Ok(tool_of(a, name)) }
    if let None = a.mcp_peer { return Ok(None) }
    let Some(row) = current_remote(tx, h, cutoff, name)? else { return Ok(None) }
    Ok(Some(Tool(name: clone(name), about: string.from(mcp_tools.about(row)), input: string.from(mcp_tools.input(row)),
        rev: 0u64, repair: None, run: Mcp(clone(mcp_tools.fingerprint(row))))))
}

// Runs the tool's repair on the call's arguments, bounded like a gate.
fn repaired[G: send](t: Tool[G], l: Limits, mut call: Call) -> Result[(), String] {
    let Some(f) = t.repair else { return Ok(()) }
    let raw: Bytes = match call.args { Inline(b) => clone(b), Blob(_) => return Error("blob arguments are not supported yet") }
    let go = code.callable(f)
    let ran = bound bytes l.gate_bytes { bound steps l.gate_steps { go(raw) } }
    match take ran {
        Ok(Ok(Ok(take fixed))) => {
            if list.len(fixed) > INLINE_LIMIT { return Error("repaired arguments too large") }
            call.args = Inline(take fixed)
            Ok(())
        },
        Ok(Ok(Error(take fault))) => Error(fault_text(take fault)),
        _ => Error("argument repair exceeded its bounds"),
    }
}

fn rank(v: Verdict) -> u8 { match v { Pass => 0u8, Hold(_) => 1u8, Deny(_) => 2u8 } }

// The fold of every gate's verdict by maximum. A gate that overruns its
// bounds denies: a gate fails closed.
pub fn verdict[G: send](tx: store.Tx, a: Agent[G], ask: Ask) -> Verdict {
    let mut out: Verdict = Pass
    for g in a.gates {
        let go = code.callable(g.check)
        let ran = bound bytes a.limits.gate_bytes { bound steps a.limits.gate_steps { go(tx, ask) } }
        let v: Verdict = match take ran {
            Ok(Ok(take v)) => take v,
            _ => Deny(clone(g.name)),
        }
        if rank(v) > rank(out) { out = take v }
    }
    take out
}

pub const APPROVAL: u8 = 0u8

// What an approval is bound to: the tool, its revision and the exact
// arguments the gates saw (after repair). Any change to one of them needs a
// new approval.
pub fn approval_key(name: String, rev: u64, args: Payload) -> Bytes {
    let mut raw: Bytes = list.new()
    std.codec.put_key_string(name, mut raw)
    std.codec.put_key_u64(rev, mut raw)
    hash_approval(take raw, args)
}

fn remote_approval(name: String, fingerprint: Bytes, args: Payload) -> Bytes {
    let mut raw: Bytes = list.new()
    std.codec.put_key_string(name, mut raw)
    std.codec.put_key_bytes(fingerprint, mut raw)
    hash_approval(take raw, args)
}

fn hash_approval(take prefix: Bytes, args: Payload) -> Bytes {
    let mut raw = take prefix
    match args {
        Inline(b) => { list.push(mut raw, 0u8); list.append(mut raw, b) },
        Blob(r) => { list.push(mut raw, 1u8); list.append(mut raw, r.digest) },
    }
    digest(raw)
}

pub type Decision: codec + send { run: u64, round: u64, ordinal: u64, key: Bytes, allow: bool }
// What a decision did. A decision at or after the hold's expiry is Lapsed
// even when the expiry timer has not run yet.
pub type Ruling: codec + send = Approved | Declined | Lapsed

fn ruled(allow: bool) -> Ruling { if allow { Approved } else { Declined } }

// Decides a held call. Only the run's caller may decide, and only with the
// key the call is held under; a key for any other tool, revision or
// arguments conflicts and changes nothing. The first decision wins: a repeat
// of it returns its ruling, and a different one conflicts.
pub fn decide[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, caller: store.Caller, take d: Decision) -> Result[Ruling, Refused] {
    let Some(run) = kept(store.fetch(tx, store.shape(h.runs), d.run))? else { return Error(Malformed("no such run")) }
    if run.caller.issuer != caller.issuer || run.caller.subject != caller.subject { return Error(NotAllowed) }
    let wait = WaitKey(run: d.run, slot: d.ordinal, kind: APPROVAL, generation: d.round)
    let Some(take found) = kept(store.fetch(tx, store.shape(h.waits), wait))? else { return Error(Malformed("no such hold")) }
    let member_key = EffectKey(run: d.run, round: d.round, kind: TOOL, ordinal: d.ordinal)
    let Some(take m) = kept(store.fetch(tx, store.shape(h.effects), member_key))? else { return Error(Malformed("no such call")) }
    let mut member = take m
    if let Some(c) = view member.call {
        if mcp_tools.reserved(c.name) {
            if let None = a.mcp_peer { return Error(Conflict) }
            if let None = current_remote(tx, h, member.cutoff, c.name)? { return Error(Conflict) }
        }
    }
    let (held, expires) = match take found {
        Open(take k, x) => (take k, x),
        Decided(take k, allow) => return if k == d.key && allow == d.allow { Ok(ruled(allow)) } else { Error(Conflict) },
        Expired => return Ok(Lapsed),
        Revoked => return Error(Conflict),
    }
    if held != d.key { return Error(Conflict) }
    match member.phase { Held => (), _ => return Error(Conflict) }
    if now(mut tx) >= expires {
        lapse(mut tx, h, wait, member_key)?
        advance(mut tx, h, a, w, Kick)?
        return Ok(Lapsed)
    }
    member.phase = if d.allow { Pending } else { Settled(Tool(Denied("not approved"))) }
    kept(store.put(mut tx, h.effects, member_key, member))?
    kept(store.put(mut tx, h.waits, wait, Decided(clone(d.key), d.allow)))?
    advance(mut tx, h, a, w, Kick)?
    Ok(ruled(d.allow))
}

fn lapse(mut tx: store.Tx, h: Handles, wait: WaitKey, member_key: EffectKey) -> Result[(), Refused] {
    let Some(take m) = kept(store.fetch(tx, store.shape(h.effects), member_key))? else { return Error(Malformed("no such call")) }
    let mut member = take m
    member.phase = Settled(Tool(Denied("approval expired")))
    kept(store.put(mut tx, h.effects, member_key, member))?
    kept(store.put(mut tx, h.waits, wait, Expired))
}

// The expiry timer of a hold. A hold that is still open at its expiry lapses;
// a decided one, or a timer that runs early, changes nothing.
fn expire(mut tx: store.Tx, h: Handles, wait: WaitKey) -> Result[(), Refused] {
    let Some(found) = kept(store.fetch(tx, store.shape(h.waits), wait))? else { return Ok(()) }
    let Open(_, expires) = view found else { return Ok(()) }
    if now(mut tx) < expires { return Ok(()) }
    lapse(mut tx, h, wait, EffectKey(run: wait.run, round: wait.generation, kind: TOOL, ordinal: wait.slot))
}

// Settles a parked Inside call. The app's own entry calls it from whatever
// wakes the park, after authorizing its caller. Only the first resume of a
// parked call in the active run counts.
pub fn resume[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, key: EffectKey, take outcome: Outcome) -> Result[Filed, Refused] {
    let Some(take found) = kept(store.fetch(tx, store.shape(h.effects), key))? else { return Ok(Ignored) }
    let mut e = take found
    match e.phase { Parked => (), _ => return Ok(Ignored) }
    let s = session_of(tx, h)?
    if s.active_run != Some(key.run) { return Ok(Ignored) }
    let shown = match take outcome {
        Returned(Inline(take b)) => if list.len(b) > INLINE_LIMIT { Failed("result too large") } else { Returned(Inline(take b)) },
        take other => take other,
    }
    e.phase = Settled(Tool(take shown))
    kept(store.put(mut tx, h.effects, key, e))?
    advance(mut tx, h, a, w, Kick)?
    Ok(Recorded)
}

fn tool_named[G: send](a: Agent[G], name: String) -> Option[ToolRun[G]] {
    for t in a.tools { if t.name == name { return Some(clone(t.run)) } }
    None
}

fn narrowed(s: Session, name: String) -> bool {
    match s.tools_narrow {
        All => true,
        Only(names) => {
            for n in names { if n == name { return true } }
            false
        },
    }
}

fn seal(mut tx: store.Tx, h: Handles, w: Wiring, key: EffectKey, take e: Effect) -> Result[(), Refused] {
    let mut sealed = take e
    let id = armed(store.triggers.write(mut tx, h.triggers, w.entries, w.effect, key, AfterCommit))?
    let _ = armed(store.triggers.write(mut tx, h.triggers, w.entries, w.advance, Deadline(key), At(sealed.deadline)))?
    sealed.trigger = Some(id)
    sealed.phase = Sealed
    kept(store.put(mut tx, h.effects, key, sealed))
}

fn now(mut tx: store.Tx) -> u64 { store.info(mut tx).at }

// The one decision function. It reads the session row, the active run and at
// most `limits.calls` effect rows of the current round, so its cost does not
// depend on the length of the conversation. It runs at most one Inside tool
// and schedules itself AfterCommit when more remain.
pub fn advance[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, take wake: Wake) -> Result[(), Refused] {
    let mut s = session_of(tx, h)?
    let Some(id) = s.active_run else { return Ok(()) }
    match wake {
        Deadline(key) => if key.run == id { inspect(mut tx, h, key)? },
        Expire(wait) => if wait.run == id { expire(mut tx, h, wait)? },
        Kick => (),
    }
    s = session_of(tx, h)?
    if s.active_run != Some(id) { return Ok(()) }
    let Some(take found) = kept(store.fetch(tx, store.shape(h.runs), id))? else { return Error(Malformed("active run")) }
    let run = take found
    match run.phase {
        Preparing => prepare(mut tx, h, a, w, mut s, id, take run),
        AwaitingModel(_) => Ok(()),
        AnswerReady(round) => derive(mut tx, h, a, w, mut s, id, take run, round),
        AwaitingRound(round, n) => step_round(mut tx, h, a, w, mut s, id, take run, round, n),
        Finished(_) => Ok(()),
    }
}

fn prepare[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, mut s: Session, id: u64, take r: Run) -> Result[(), Refused] {
    let mut run = take r
    if run.rounds_left == 0u64 { return finish(mut tx, h, mut s, id, take run, OutOfRounds) }
    plan(mut tx, h, a, mut s)?
    kept(store.put(mut tx, h.session, 0u64, clone(s)))?
    let key = EffectKey(run: id, round: run.round, kind: MODEL, ordinal: 0u64)
    let deadline = now(mut tx) + a.limits.model_ms
    let cutoff = Cutoff(head_pos: s.head_pos, tail_pos: s.next_pos - 1u64, route: clone(a.route), policy: 0u64, tools_pos: clone(s.active_tools_pos))
    let e = Effect(cutoff: take cutoff, call: None, repeat: clone(a.model_repeat), deadline: deadline, phase: Pending,
        trigger: None, dispatches: 0u64, reserve: a.limits.model_reserve)
    seal(mut tx, h, w, key, take e)?
    run.spend.reserved += a.limits.model_reserve
    run.phase = AwaitingModel(run.round)
    kept(store.put(mut tx, h.runs, id, run))?
    status(mut tx, h, "thinking")
}

type Shown = Text(String) | Absent | Kept

fn render(tx: store.Tx, sec: Section, l: Limits) -> Shown {
    let go = code.callable(sec.render)
    let ran = bound bytes l.section_bytes { bound steps l.section_steps { go(tx) } }
    match take ran {
        Ok(Ok(Ok(Some(take text)))) => if string.byte_len(text) > INLINE_LIMIT { Kept } else { Text(take text) },
        Ok(Ok(Ok(None))) => Absent,
        _ => Kept,
    }
}

fn hash_of(list: List[SectionHash], key: String) -> Option[Bytes] {
    for e in list { if e.key == key { return Some(clone(e.hash)) } }
    None
}

fn offered[G: send](tx: store.Tx, h: Handles, a: Agent[G], s: Session) -> Result[List[ToolDef], Refused] {
    let mut defs: List[ToolDef] = list.new()
    for t in a.tools {
        if mcp_tools.reserved(t.name) { return Error(Malformed("reserved MCP tool name")) }
        if narrowed(s, t.name) {
            list.push(mut defs, ToolDef(name: clone(t.name), about: clone(t.about), input: clone(t.input), rev: t.rev, catalog: None))
        }
    }
    if let Some(_) = a.mcp_peer {
        let Ok(take cursor) = store.range(tx, store.shape(h.mcp_catalog), Unbounded, Unbounded) else { return Error(Storage) }
        let mut rows = take cursor
        while let Some((take name, r)) = kept(store.next_range(mut rows))? {
            if narrowed(s, name) {
                list.push(mut defs, ToolDef(name: take name, about: string.from(mcp_tools.about(r)), input: string.from(mcp_tools.input(r)),
                    rev: 0u64, catalog: Some(clone(mcp_tools.fingerprint(r)))))
            }
        }
    }
    Ok(take defs)
}

// Renders every section and appends the smallest System patch that brings the
// fold of earlier patches to the rendered list, or nothing if it already
// matches. The session row caches each shown section's hash and the offered
// tools' hash, so no earlier entry is read. Kept sections stay where they are.
// A patch whose order differs from the shown order is a baseline; a baseline
// that would need a kept section's text, which only the log holds, is put off
// to the next request and every section keeps its shown text.
fn plan[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], mut s: Session) -> Result[(), Refused] {
    let first = list.len(s.active_tools_hash) == 0u64
    let mut shown: List[SectionHash] = list.new()
    let mut changes: List[Change] = list.new()
    let mut texts: List[Change] = list.new()
    let mut kept_any = false
    for sec in a.sections {
        let old = hash_of(s.active_sections_hashes, sec.key)
        match render(tx, sec, a.limits) {
            Text(take text) => {
                let hash = digest(string.as_bytes(text))
                list.push(mut shown, SectionHash(key: clone(sec.key), hash: clone(hash)))
                if old != Some(clone(hash)) { list.push(mut changes, Change(key: clone(sec.key), text: Some(clone(text)))) }
                list.push(mut texts, Change(key: clone(sec.key), text: Some(take text)))
            },
            Absent => if let Some(_) = old { list.push(mut changes, Change(key: clone(sec.key), text: None)) },
            Kept => if let Some(take hash) = old {
                kept_any = true
                list.push(mut shown, SectionHash(key: clone(sec.key), hash: take hash))
            },
        }
    }
    // Incremental patches keep shown keys in place and add new ones at the
    // end, so the new order must be the old order without removed keys,
    // followed by the added keys.
    let mut expected: List[String] = list.new()
    for e in s.active_sections_hashes { if let Some(_) = hash_of(shown, e.key) { list.push(mut expected, clone(e.key)) } }
    for e in shown { if let None = hash_of(s.active_sections_hashes, e.key) { list.push(mut expected, clone(e.key)) } }
    let mut in_place = list.len(expected) == list.len(shown)
    if in_place { for i in 0u64..list.len(shown) { if expected[i] != shown[i].key { in_place = false } } }
    let baseline = (first || !in_place) && !kept_any
    if !in_place && kept_any {
        shown = clone(s.active_sections_hashes)
        changes = list.new()
    }
    let defs = offered(tx, h, a, s)?
    let Some(raw_defs) = encoded(defs) else { return Error(Malformed("tool definitions")) }
    let tools_hash = digest(raw_defs)
    let tools_changed = first || tools_hash != s.active_tools_hash
    if !baseline && list.len(changes) == 0u64 && !tools_changed { return Ok(()) }
    let tools: Option[List[ToolDef]] = if tools_changed { Some(clone(defs)) } else { None }
    let patch = if baseline { Patch(baseline: true, changes: take texts, tools: Some(take defs)) }
        else { Patch(baseline: false, changes: take changes, tools: take tools) }
    let pos = append(mut tx, h, a, mut s, System(take patch))?
    if baseline || tools_changed { s.active_tools_pos = Some(pos) }
    s.active_sections_hashes = take shown
    s.active_tools_hash = take tools_hash
    Ok(())
}

// After model.answer committed: one member row per returned call, in model
// order. Calls beyond the limit, unknown tools and narrowed-away tools are
// settled at once with a typed outcome and never dispatched.
fn derive[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, mut s: Session, id: u64, take r: Run, round: u64) -> Result[(), Refused] {
    let mut run = take r
    let model_key = EffectKey(run: id, round: round, kind: MODEL, ordinal: 0u64)
    let Some(e) = kept(store.fetch(tx, store.shape(h.effects), model_key))? else { return Error(Malformed("model effect")) }
    let Settled(Model(answer)) = view e.phase else { return Error(Malformed("model answer")) }
    if list.len(answer.calls) == 0u64 { return finish(mut tx, h, mut s, id, take run, Answered) }
    let mut ordinal = 0u64
    for given in answer.calls {
        let key = EffectKey(run: id, round: round, kind: TOOL, ordinal: ordinal)
        let mut call: Call = clone(given)
        let phase: EffectPhase =
            if ordinal >= a.limits.calls { Settled(Tool(Failed("too many calls in one answer"))) }
            else if !narrowed(s, call.name) { Settled(Tool(Gone)) }
            else {
                match resolve_tool(tx, h, a, e.cutoff, call.name)? {
                    None => Settled(Tool(Gone)),
                    Some(t) => match repaired(t, a.limits, mut call) {
                        Error(take why) => Settled(Tool(Failed(take why))),
                        Ok(()) => match verdict(tx, a, Ask(caller: clone(run.caller), call: clone(call))) {
                            Pass => Pending,
                            Deny(take why) => Settled(Tool(Denied(take why))),
                            Hold(_) => {
                                let wait = WaitKey(run: id, slot: ordinal, kind: APPROVAL, generation: round)
                                let expires = now(mut tx) + a.limits.hold_ms
                                let approval = match t.run {
                                    Mcp(fp) => remote_approval(t.name, fp, call.args),
                                    _ => approval_key(t.name, t.rev, call.args),
                                }
                                kept(store.put(mut tx, h.waits, wait, Open(take approval, expires)))?
                                let _ = armed(store.triggers.write(mut tx, h.triggers, w.entries, w.advance, Expire(wait), At(expires)))?
                                Held
                            },
                        },
                    },
                }
            }
        let member = Effect(cutoff: clone(e.cutoff), call: Some(take call), repeat: Once, deadline: 0u64, phase: take phase,
            trigger: None, dispatches: 0u64, reserve: 0u64)
        kept(store.put(mut tx, h.effects, key, member))?
        ordinal += 1u64
    }
    run.phase = AwaitingRound(round, ordinal)
    kept(store.put(mut tx, h.runs, id, run))?
    status(mut tx, h, "calling tools")?
    let _ = armed(store.triggers.write(mut tx, h.triggers, w.entries, w.advance, Kick, AfterCommit))?
    Ok(())
}

fn step_round[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, mut s: Session, id: u64, take r: Run, round: u64, n: u64) -> Result[(), Refused] {
    let mut open = false
    let mut ran_inside = false
    for i in 0u64..n {
        let key = EffectKey(run: id, round: round, kind: TOOL, ordinal: i)
        let Some(take found) = kept(store.fetch(tx, store.shape(h.effects), key))? else { return Error(Malformed("member")) }
        let mut e = take found
        let pending = match e.phase { Pending => true, Settled(_) => false, Doubted => false, _ => { open = true; false } }
        // A Held member waits for its decision; it counts as open above.
        if !pending { continue }
        let call: Call = match e.call { Some(c) => clone(c), None => return Error(Malformed("member call")) }
        if mcp_tools.reserved(call.name) {
            let live = current_remote(tx, h, e.cutoff, call.name)?
            if let (Some(_), Some(_)) = (a.mcp_peer, live) {
                open = true
                e.repeat = Once
                e.deadline = now(mut tx) + a.limits.tool_ms
                seal(mut tx, h, w, key, take e)?
            } else {
                e.phase = Settled(Tool(Gone))
                kept(store.put(mut tx, h.effects, key, e))?
            }
            continue
        }
        let Some(run) = tool_named(a, call.name) else { return Error(Malformed("member tool")) }
        match run {
            Inside(f) => {
                if ran_inside {
                    let _ = armed(store.triggers.write(mut tx, h.triggers, w.entries, w.advance, Kick, AfterCommit))?
                    return Ok(())
                }
                ran_inside = true
                e.phase = match run_inside(mut tx, f, key, call.args, a.limits) {
                    Gave(take outcome) => Settled(Tool(take outcome)),
                    Parks => { open = true; Parked },
                }
                kept(store.put(mut tx, h.effects, key, e))?
            },
            Outside(_, repeat) => {
                open = true
                e.repeat = clone(repeat)
                e.deadline = now(mut tx) + a.limits.tool_ms
                seal(mut tx, h, w, key, take e)?
            },
            Mcp(_) => return Error(Malformed("member tool")),
        }
    }
    if open { return Ok(()) }
    present(mut tx, h, a, w, mut s, id, take r, round, n)
}

// Runs an Inside tool in the advance transaction under its byte and step
// bounds. A tool that fails or overruns either bound leaves none of its writes.
type Ran = Gave(Outcome) | Parks

fn run_inside(mut tx: store.Tx, f: StaticFn[fn(mut store.Tx, Invoke) -> Result[Reply, Fault]], key: EffectKey, args: Payload, l: Limits) -> Ran {
    let Inline(raw) = view args else { return Gave(Failed("blob arguments are not supported yet")) }
    let go = code.callable(f)
    let given = Invoke(key: key, args: clone(raw))
    let ran = store.rollback_writes_on_overrun(mut tx, l.inside_steps, scoped fn(mut t: store.Tx) -> Result[Reply, Fault] {
        let bounded = bound bytes l.inside_bytes { go(mut t, given) }
        match take bounded {
            Ok(take r) => take r,
            Error(_) => Error(Refused("inside tool exceeded its bytes")),
        }
    })
    match take ran {
        Ok(Ok(Now(take out))) => Gave(if list.len(out) > INLINE_LIMIT { Failed("result too large") } else { Returned(Inline(take out)) }),
        Ok(Ok(Later)) => Parks,
        Ok(Error(take fault)) => Gave(Failed(fault_text(take fault))),
        Error(_) => Gave(Failed("inside tool exceeded its steps")),
    }
}

fn fault_text(take f: Fault) -> String {
    match take f {
        BadArgs(take why) => take why,
        Refused(take why) => take why,
        Unavailable => "unavailable",
        TooLarge => "too large",
    }
}

// All members settled: append their results in model order, then prepare the
// next request in the same transaction.
fn present[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, mut s: Session, id: u64, take r: Run, round: u64, n: u64) -> Result[(), Refused] {
    let mut run = take r
    for i in 0u64..n {
        let key = EffectKey(run: id, round: round, kind: TOOL, ordinal: i)
        let Some(take e) = kept(store.fetch(tx, store.shape(h.effects), key))? else { return Error(Malformed("member")) }
        let Effect(call: take call, phase: take phase, ..) = take e
        let Some(take c) = take call else { return Error(Malformed("member call")) }
        let outcome = match take phase { Settled(Tool(take o)) => take o, _ => InDoubt }
        let _ = append(mut tx, h, a, mut s, ToolResult(clone(c.id), take outcome))?
    }
    kept(store.put(mut tx, h.session, 0u64, s))?
    run.round = round + 1u64
    run.rounds_left -= 1u64
    run.phase = Preparing
    prepare(mut tx, h, a, w, mut s, id, take run)
}

// A deadline fired for one effect. A settled effect is left alone. Otherwise
// the effect's run is asked to cancel and the effect is recorded as in doubt
// if it was dispatched: a deadline is not a clean timeout.
fn inspect(mut tx: store.Tx, h: Handles, key: EffectKey) -> Result[(), Refused] {
    let Some(take found) = kept(store.fetch(tx, store.shape(h.effects), key))? else { return Ok(()) }
    let mut e = take found
    let dispatched = match e.phase {
        Settled(_) => return Ok(()),
        Doubted => return Ok(()),
        Dispatched(_) => true,
        _ => false,
    }
    if let Some(t) = e.trigger { let _ = store.triggers.request_cancel(mut tx, h.triggers, t) }
    e.phase = if key.kind == MODEL {
        if dispatched { Doubted } else { Settled(ModelFailed("model deadline")) }
    } else {
        Settled(Tool(if dispatched { InDoubt } else { Failed("tool deadline") }))
    }
    let reserve = e.reserve
    kept(store.put(mut tx, h.effects, key, e))?
    if key.kind == MODEL { model_closed(mut tx, h, key, reserve, dispatched)? }
    Ok(())
}

// A model effect closed without an answer ends its run.
fn model_closed(mut tx: store.Tx, h: Handles, key: EffectKey, reserve: u64, doubted: bool) -> Result[(), Refused] {
    let Some(take found) = kept(store.fetch(tx, store.shape(h.runs), key.run))? else { return Ok(()) }
    let mut run = take found
    run.spend.reserved -= reserve
    if doubted { run.spend.unresolved += reserve }
    let mut s = session_of(tx, h)?
    let why = if doubted { "model call in doubt" } else { "model failed" }
    finish(mut tx, h, mut s, key.run, take run, Stopped(why))
}

// ---- the effect protocol: begin and settle are fenced attempt entries ----

pub type Permit: codec + send = Go(u64) | Doubt | Shut

fn active(tx: store.Tx, h: Handles, run: u64) -> Result[bool, store.Error] {
    let Some(s) = store.fetch(tx, store.shape(h.session), 0u64)? else { return Ok(false) }
    Ok(match s.active_run { Some(r) => r == run, None => false })
}

// begin(E) records the dispatch before the worker may send. A Once effect
// whose earlier attempt began and never settled is in doubt at once; it never
// waits for its deadline and never sends again.
fn begin(mut tx: store.Tx, attempt: store.triggers.Attempt, take key: EffectKey) -> Result[Permit, store.Error] {
    let h = handles(store.tx_schema(tx))?
    let Some(take found) = store.fetch(tx, store.shape(h.effects), key)? else { return Ok(Shut) }
    let mut e = take found
    let Some(t) = e.trigger else { return Ok(Shut) }
    if t != store.triggers.run_id(attempt) { return Ok(Shut) }
    if !active(tx, h, key.run)? { return Ok(Shut) }
    let n = store.triggers.number(attempt)
    match e.phase {
        Sealed => (),
        Dispatched(prev) => {
            if prev >= n { return Ok(Shut) }
            let again = match e.repeat {
                Once => false,
                Repeatable(max) => e.dispatches < max && store.info(mut tx).at < e.deadline,
            }
            if !again { return Ok(Doubt) }
            if key.kind == MODEL { resend_reserve(mut tx, h, key.run, e.reserve)? }
        },
        _ => return Ok(Shut),
    }
    e.phase = Dispatched(n)
    e.dispatches += 1u64
    store.put(mut tx, h.effects, key, e)?
    Ok(Go(n))
}

// A resend: the earlier dispatch may have been charged and will never be
// settled, so its reservation becomes unresolved; the reserved bound stays
// held for the new dispatch.
fn resend_reserve(mut tx: store.Tx, h: Handles, id: u64, reserve: u64) -> Result[(), store.Error] {
    let Some(take found) = store.fetch(tx, store.shape(h.runs), id)? else { return Ok(()) }
    let mut run = take found
    run.spend.unresolved += reserve
    store.put(mut tx, h.runs, id, run)
}

pub fn register[G: send, H: send](mut r: store.runner.Registry[G, H], n: u64, steps: u64) -> Result[(), store.runner.RegisterError] {
    let f: own[send] fn(mut store.Tx, store.triggers.Attempt, take EffectKey) -> Result[Permit, store.Error] = begin
    store.runner.register_attempt(mut r, code.describe(begin), take f, n, steps)
}

pub type Settle: codec + send { key: EffectKey, receipt: Option[Receipt] }
pub type Filed: codec + send = Recorded | Ignored

// settle(E, receipt): first writer wins. A model answer commits as its entry
// and schedules derivation; a tool receipt settles its member and advances.
// None records the effect as in doubt. The app's settle entry is a fenced
// attempt entry whose body calls this; a refusal rolls the transaction back.
pub fn settle[G: send](mut tx: store.Tx, a: Agent[G], w: Wiring, attempt: store.triggers.Attempt, take m: Settle) -> Result[Filed, store.Error] {
    let h = handles(store.tx_schema(tx))?
    match settle_in(mut tx, h, a, w, attempt, take m) {
        Ok(d) => Ok(d),
        Error(Storage) => Error(Missing("harness: storage refused the settle")),
        Error(_) => Error(Missing("harness: settle refused")),
    }
}

fn settle_in[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], w: Wiring, attempt: store.triggers.Attempt, take m: Settle) -> Result[Filed, Refused] {
    let Settle(key: key, receipt: take receipt) = take m
    let Some(take found) = kept(store.fetch(tx, store.shape(h.effects), key))? else { return Ok(Ignored) }
    let mut e = take found
    let Some(t) = e.trigger else { return Ok(Ignored) }
    if t != store.triggers.run_id(attempt) { return Ok(Ignored) }
    match e.phase { Dispatched(_) => (), _ => return Ok(Ignored) }
    match take receipt {
        None => {
            if key.kind == MODEL {
                e.phase = Doubted
                let reserve = e.reserve
                kept(store.put(mut tx, h.effects, key, e))?
                model_closed(mut tx, h, key, reserve, true)?
            } else {
                e.phase = Settled(Tool(InDoubt))
                kept(store.put(mut tx, h.effects, key, e))?
                advance(mut tx, h, a, w, Kick)?
            }
        },
        Some(Model(take answer)) => {
            let Some(take found_run) = kept(store.fetch(tx, store.shape(h.runs), key.run))? else { return Ok(Ignored) }
            let mut run = take found_run
            run.spend.reserved -= e.reserve
            run.spend.known += answer.usage.input + answer.usage.output
            run.phase = AnswerReady(key.round)
            let mut s = session_of(tx, h)?
            let said: Answer = clone(answer)
            let _ = append(mut tx, h, a, mut s, Assistant(take said))?
            kept(store.put(mut tx, h.session, 0u64, s))?
            kept(store.put(mut tx, h.runs, key.run, run))?
            e.phase = Settled(Model(take answer))
            kept(store.put(mut tx, h.effects, key, e))?
            let _ = armed(store.triggers.write(mut tx, h.triggers, w.entries, w.advance, Kick, AfterCommit))?
        },
        Some(ModelFailed(take why)) => {
            let reserve = e.reserve
            e.phase = Settled(ModelFailed(take why))
            kept(store.put(mut tx, h.effects, key, e))?
            model_closed(mut tx, h, key, reserve, false)?
        },
        Some(Tool(take outcome)) => {
            e.phase = Settled(Tool(take outcome))
            kept(store.put(mut tx, h.effects, key, e))?
            advance(mut tx, h, a, w, Kick)?
        },
    }
    Ok(Recorded)
}

// ---- the granted worker ----

pub type Worked: codec + send = Sent | Doubted | Skipped | Lost

fn encoded[A: codec](a: A) -> Option[Bytes] {
    let codec: std.codec.Codec[A] = std.codec.of()
    let mut raw: Bytes = list.new()
    match std.codec.encode(codec, a, mut raw) { Ok(_) => Some(take raw), Error(_) => None }
}

fn call_attempt[F, A: codec, R: codec](ctx: store.runner.TriggerContext, f: StaticFn[F], a: A) -> Option[R] waits {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let Ok(take key) = store.runner.attempt_key(f, ca, cr) else { return None }
    let Some(take arg) = encoded(a) else { return None }
    let Ok(Returned(raw)) = store.runner.trigger_call(ctx, take key, take arg) else { return None }
    match std.codec.decode(cr, raw) { Ok(take r) => Some(take r), Error(_) => None }
}

// The request for a model effect, built from immutable entries read through
// the attempt's snapshot, so the advance transaction never carries the body.
// System entries fold into `system` and `tools`; Notes are not sent.
pub fn request(snap: store.Snapshot, h: Handles, key: EffectKey, cutoff: Cutoff) -> Result[Request, store.Error] {
    let mut messages: List[Entry] = list.new()
    let mut system: List[Change] = list.new()
    let mut tools: List[ToolDef] = list.new()
    let mut p = cutoff.head_pos
    while p <= cutoff.tail_pos {
        match store.get(snap, store.shape(h.entries), p)? {
            Some(System(take patch)) => fold(mut system, mut tools, take patch),
            Some(Note(_, _)) => (),
            Some(take entry) => list.push(mut messages, take entry),
            None => return Error(Missing("entry")),
        }
        p += 1u64
    }
    let mut texts: List[String] = list.new()
    for c in system { if let Some(t) = view c.text { list.push(mut texts, clone(t)) } }
    let mut stable: Bytes = list.new()
    std.codec.put_u64(key.run, mut stable)
    std.codec.put_u64(key.round, mut stable)
    Ok(Request(route: clone(cutoff.route), system: take texts, tools: take tools, messages: take messages, key: take stable))
}

fn fold(mut system: List[Change], mut tools: List[ToolDef], take p: Patch) {
    let Patch(baseline: baseline, changes: take changes, tools: take defs) = take p
    if baseline { system = list.new() }
    for c in changes {
        let mut found = false
        let mut next: List[Change] = list.new()
        for old in system {
            if old.key == c.key {
                found = true
                if let Some(_) = c.text { list.push(mut next, clone(c)) }
            } else { list.push(mut next, clone(old)) }
        }
        if !found { if let Some(_) = c.text { list.push(mut next, clone(c)) } }
        system = take next
    }
    if let Some(take d) = take defs { tools = take d }
}

fn doubt[F](ctx: store.runner.TriggerContext, settle_entry: StaticFn[F], key: EffectKey) -> Worked waits {
    let done: Option[Filed] = call_attempt(ctx, settle_entry, Settle(key: key, receipt: None))
    match done { Some(_) => Doubted, None => Lost }
}

fn remote_effect[G: send](snap: store.Snapshot, h: Handles, e: Effect, c: Call, a: Agent[G], port: G) -> Outcome waits {
    let Some(resolve) = a.mcp_peer else { return Gone }
    let Some(pos) = e.cutoff.tools_pos else { return Gone }
    let Ok(pinned) = store.get(snap, store.shape(h.entries), pos) else { return InDoubt }
    let Ok(found) = store.get(snap, store.shape(h.mcp_catalog), c.name) else { return InDoubt }
    let Some(row) = found else { return Gone }
    if !matching_remote(pinned, c.name, row) { return Gone }
    let get_peer = code.callable(resolve)
    let Some(peer) = get_peer(port, mcp_tools.server_id(row)) else { return Gone }
    let Inline(raw) = view c.args else { return Failed("MCP arguments must be inline") }
    let wall = host.wall_ms(peer.clock)
    if wall >= e.deadline { return Failed("MCP deadline elapsed before send") }
    let deadline = std.clock.deadline_after_ms(host.mono_ns(peer.clock), e.deadline - wall)
    match mcp_tools.call(peer, row, clone(raw), INLINE_LIMIT, deadline) {
        Ok(take out) => if list.len(out) > INLINE_LIMIT { Failed("result too large") } else { Returned(Inline(take out)) },
        Error(Unavailable) => InDoubt,
        Error(BadArguments) => Failed("invalid MCP arguments"),
        Error(Refused(take why)) => Failed(take why),
    }
}

// The body of the app's granted effect entry: begin, read the sealed cutoff
// through the fenced snapshot, make the one outside call, settle.
pub fn effect[G: send, F](ctx: store.runner.TriggerContext, port: G, take key: EffectKey, a: Agent[G], settle_entry: StaticFn[F]) -> Result[Worked, Capacity] waits {
    let permit: Option[Permit] = call_attempt(ctx, code.describe(begin), key)
    match permit {
        Some(Go(_)) => (),
        Some(Doubt) => return Ok(doubt(ctx, settle_entry, key)),
        Some(Shut) => return Ok(Skipped),
        None => return Ok(Lost),
    }
    let Ok(snap) = store.runner.trigger_snapshot(ctx) else { return Ok(Lost) }
    let Ok(h) = handles(store.snapshot_schema(snap)) else { return Ok(Lost) }
    let Ok(Some(take e)) = store.get(snap, store.shape(h.effects), key) else { return Ok(Lost) }
    let receipt: Receipt = if key.kind == MODEL {
        let Ok(take asked) = request(snap, h, key, e.cutoff) else { return Ok(Lost) }
        let call = code.callable(a.model)
        match call(port, take asked) {
            Ok(take answer) => Model(take answer),
            // Unavailable after the send may have been charged: record doubt.
            Error(Unavailable) => return Ok(doubt(ctx, settle_entry, key)),
            Error(take fault) => ModelFailed(fault_text(take fault)),
        }
    } else {
        let Some(c) = view e.call else { return Ok(Lost) }
        if mcp_tools.reserved(c.name) { Tool(remote_effect(snap, h, e, c, a, port)) }
        else {
            let Some(Outside(f, _)) = tool_named(a, c.name) else { return Ok(Lost) }
            let Inline(raw) = view c.args else { return Ok(Lost) }
            let go = code.callable(f)
            Tool(match go(port, clone(raw)) {
                Ok(take out) => if list.len(out) > INLINE_LIMIT { Failed("result too large") } else { Returned(Inline(take out)) },
                Error(Unavailable) => InDoubt,
                Error(take fault) => Failed(fault_text(take fault)),
            })
        }
    }
    let done: Option[Filed] = call_attempt(ctx, settle_entry, Settle(key: key, receipt: Some(take receipt)))
    match done { Some(_) => Ok(Sent), None => Ok(Lost) }
}

// ---- reads ----

pub fn transcript(h: Handles) -> Result[store.runner.Cover, Capacity] {
    store.runner.cover(store.shape(h.views), Unbounded, Unbounded)
}

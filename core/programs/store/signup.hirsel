// A sign-up process over the store step library.
pub type Signup: codec + send { id: u64, email: String, card: String }
type Account: codec + send { email: String, active: bool }
type StatusRequest: codec + send { id: u64, run: triggers.Id }
pub type WriteError: codec + send = Exists | Missing | Rejected | PaymentUnknown
type RunResult: codec + send = Active | Held | Cancelled | MailInDoubt | ChargeInDoubt | Rejected

type Tables: send {
    accounts: store.Table[u64, Account],
    triggers: triggers.Tables,
}

fn accounts_name() -> String { "signup.accounts" }
const ENTRY_BYTES: u64 = 131072u64
const PLACE_BYTES: u64 = 1048576u64

pub fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    triggers.migrate(mut phase)?
    steps.migrate(mut phase)?
    let account: std.codec.Codec[Account] = std.codec.of()
    store.migration_create_table(mut phase, store.spec(accounts_name(), std.codec.key_u64(), account))
}

fn accounts(schema: store.Schema) -> Result[store.Table[u64, Account], store.Error] {
    let account: std.codec.Codec[Account] = std.codec.of()
    store.schema_table(schema, accounts_name(), std.codec.key_u64(), account)
}

fn handles(schema: store.Schema) -> Result[Tables, store.Error] {
    Ok(Tables(accounts: accounts(schema)?, triggers: triggers.tables(schema)?))
}

fn stored[R](take x: Result[R, store.Error]) -> Result[R, WriteError] {
    match take x { Ok(take a) => Ok(take a), Error(_) => Error(Rejected) }
}

fn trigger_entries(target: triggers.Entry[Signup]) -> Result[triggers.Entries, triggers.Error] {
    let mut entries = triggers.empty_entries()
    triggers.allow(mut entries, target)?
    Ok(take entries)
}

fn signup(mut tx: store.Tx, h: Tables, caller: store.Caller, take arg: Signup) -> Result[triggers.Id, WriteError] {
    if let Some(_) = stored(store.fetch(tx, store.shape(h.accounts), arg.id))? { return Error(Exists) }
    let made: Result[triggers.Entry[Signup], Capacity] = triggers.granted(code.describe(run))
    let target = match take made { Ok(take value) => take value, Error(_) => return Error(Rejected) }
    let entries = match trigger_entries(target) { Ok(take value) => take value, Error(_) => return Error(Rejected) }
    let copied: Result[String, Capacity] = clone(arg.email)
    let email = match take copied { Ok(take value) => take value, Error(_) => return Error(Rejected) }
    stored(store.put(mut tx, h.accounts, arg.id, Account(email: take email, active: false)))?
    match steps.schedule(mut tx, entries, target, arg, 3u64, AfterCommit) {
        Ok(id) => Ok(id),
        Error(_) => Error(Rejected),
    }
}

pub fn activate(mut tx: store.Tx, id: u64) -> Result[(), WriteError] {
    let table = stored(accounts(store.tx_schema(tx)))?
    let Some(take found) = stored(store.fetch(tx, store.shape(table), id))? else { return Error(Missing) }
    let mut account = take found
    account.active = true
    stored(store.put(mut tx, table, id, account))
}

pub fn enroll(mut tx: store.Tx, id: u64) -> Result[triggers.Id, WriteError] {
    let h = stored(handles(store.tx_schema(tx)))?
    signup(mut tx, h, store.Caller(issuer: 1u8, subject: list.new()), Signup(id: id, email: "ada@example.test", card: "scripted-card"))
}

pub fn active(db: store.Db, id: u64) -> Result[bool, store.Error] {
    let h = store.with_schema(db, code.describe(handles))?
    let row = store.get(store.snapshot(db), store.shape(h.accounts), id)?
    Ok(match row { Some(account) => account.active, None => false })
}

fn signup_status(mut tx: store.Tx, h: Tables, caller: store.Caller, take request: StatusRequest) -> Result[Option[bool], WriteError] {
    if let None = stored(triggers.fetch_outcome(tx, h.triggers, request.run))? { return Ok(None) }
    let row = stored(store.fetch(tx, store.shape(h.accounts), request.id))?
    Ok(Some(match row { Some(account) => account.active, None => false }))
}

type Mail: send { email: String, reply: Sender[u64] }
type Payment: send = Charge(Bytes, String, Sender[u64]) | Lookup(Bytes, Sender[Option[u64]])
pub type Services: send { mail: Sender[Mail], payment: Sender[Payment] }
type Grants: send { context: runner.TriggerContext, services: Services }

fn make_grants(services: Services, take ctx: runner.TriggerContext) -> Result[Grants, Capacity] {
    Ok(Grants(context: take ctx, services: Services(mail: channel.sender(services.mail), payment: channel.sender(services.payment))))
}

fn mail_service(take inbox: Receiver[Mail]) -> () waits {
    let mut sent = 0u64
    while let Ok(take request) = channel.receive(inbox) {
        sent += 1u64
        let _ = channel.send(request.reply, sent)
    }
}

fn payment_service(take inbox: Receiver[Payment]) -> () waits {
    let mut charges: Map[Bytes, u64] = map.new()
    let mut charged = 0u64
    while let Ok(take request) = channel.receive(inbox) {
        match take request {
            Charge(take key, _, take reply) => {
                // This service charges for every request, even a repeated key.
                charged += 1u64
                let _ = result.unwrap(map.insert(mut charges, take key, charged))
                let _ = channel.send(reply, charged)
            },
            Lookup(key, reply) => {
                let found: Option[u64] = match map.get(charges, key) { Some(receipt) => Some(receipt), None => None }
                let _ = channel.send(reply, found)
            },
        }
    }
}

pub fn scripted_services(tasks: Tasks) -> (Services, Task[()], Task[()]) {
    let (mail, mail_in): (Sender[Mail], Receiver[Mail]) = result.unwrap(channel.new(1u64))
    let (payment, payment_in): (Sender[Payment], Receiver[Payment]) = result.unwrap(channel.new(1u64))
    let mailing = result.unwrap(task.spawn(tasks, bytes 65536u64, take mail_in, mail_service))
    let payments = result.unwrap(task.spawn(tasks, bytes 65536u64, take payment_in, payment_service))
    (Services(mail: take mail, payment: take payment), take mailing, take payments)
}

fn encode[A: codec](a: A) -> Result[Bytes, Capacity] {
    let mut raw: Bytes = list.new()
    let codec: std.codec.Codec[A] = std.codec.of()
    std.codec.encode(codec, a, mut raw)?
    Ok(take raw)
}

fn entry_key[A: codec, R: codec](f: StaticFn[fn(mut store.Tx, Tables, store.Caller, take A) -> Result[R, WriteError]]) -> Result[Bytes, Capacity] {
    let input: std.codec.Codec[A] = std.codec.of()
    let reply: std.codec.Codec[Result[R, WriteError]] = std.codec.of()
    let identity = code.identity(f)
    let mut raw: Bytes = list.with_capacity(list.len(identity) + 16u64)?
    list.append(mut raw, identity)?
    std.codec.put_u64(std.codec.fingerprint(input)?, mut raw)?
    std.codec.put_u64(std.codec.fingerprint(reply)?, mut raw)?
    Ok(take raw)
}

fn decode_reply[R: codec](outcome: runner.Outcome) -> Result[R, Capacity] {
    let Returned(raw) = view outcome else { fail("sign-up: transact did not return") }
    let codec: std.codec.Codec[Result[R, WriteError]] = std.codec.of()
    match std.codec.decode(codec, raw)? {
        Ok(Ok(take value)) => Ok(take value),
        _ => fail("sign-up: transact rejected"),
    }
}

pub type Port: send = Welcome(Sender[Mail]) | Billing(Sender[Payment])
pub type ChargeRequest: codec + send { id: steps.StepId, card: String }

pub fn send_welcome(port: Port, take email: String) -> Result[u64, WriteError] waits {
    let Welcome(mail) = view port else { fail("sign-up: expected mail grant") }
    let pair: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(1u64)
    let (to, from) = result.unwrap(take pair)
    result.unwrap(channel.send(mail, Mail(email: take email, reply: take to)))
    Ok(result.unwrap(channel.receive(from)))
}

pub fn send_charge(port: Port, take request: ChargeRequest) -> Result[u64, WriteError] waits {
    let Billing(payment) = view port else { fail("sign-up: expected payment grant") }
    let pair: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(1u64)
    let (to, from) = result.unwrap(take pair)
    let ChargeRequest(id: id, card: take card) = take request
    result.unwrap(channel.send(payment, Charge(result.unwrap(steps.outside_key(id)), take card, take to)))
    Ok(result.unwrap(channel.receive(from)))
}

pub fn find_charge(port: Port, take request: ChargeRequest) -> Result[u64, WriteError] waits {
    let Billing(payment) = view port else { fail("sign-up: expected payment grant") }
    let pair: Result[(Sender[Option[u64]], Receiver[Option[u64]]), Capacity] = channel.new(1u64)
    let (to, from) = result.unwrap(take pair)
    result.unwrap(channel.send(payment, Lookup(result.unwrap(steps.outside_key(request.id)), take to)))
    match channel.receive(from) {
        Ok(Some(receipt)) => Ok(receipt),
        _ => Error(PaymentUnknown),
    }
}

fn process(mut ctx: steps.Ctx[Port], take arg: Signup) -> Result[RunResult, steps.StepError[WriteError]] waits {
    let Signup(id: id, email: take email, card: take card) = take arg
    let _ = steps.step(mut ctx, take email, send_welcome)?
    let charge = ChargeRequest(id: steps.next_id(ctx), card: take card)
    let copied: Result[ChargeRequest, Capacity] = clone(charge)
    let attempted = steps.step(mut ctx, result.unwrap(take copied), send_charge)
    let _ = match take attempted {
        Error(InDoubt(step)) => steps.resolve(mut ctx, step, take charge, find_charge)?,
        other => (take other)?,
    }
    steps.transaction(mut ctx, id, code.describe(activate))?
    Ok(Active)
}

fn run(g: Grants, caller: runner.Caller, take arg: Signup) -> Result[RunResult, Capacity] waits {
    let mut allowed: Map[u64, Port] = map.new()
    result.capacity_only(map.insert(mut allowed, 0u64, Welcome(channel.sender(g.services.mail))))?
    result.capacity_only(map.insert(mut allowed, 1u64, Billing(channel.sender(g.services.payment))))?
    match steps.run(g.context, take allowed, take arg, process) {
        Ok(value) => Ok(value),
        Error(StaleAttempt) => Ok(Held),
        Error(Cancelled) => Ok(Cancelled),
        Error(InDoubt(_)) => Ok(MailInDoubt),
        Error(Callback(PaymentUnknown)) => Ok(ChargeInDoubt),
        Error(_) => Ok(Rejected),
    }
}

fn place(mut registry: runner.Registry[Grants, Tables]) -> Result[(), runner.RegisterError] {
    runner.transact(mut registry, code.describe(signup), ENTRY_BYTES, runner.DEFAULT_STEPS)?
    runner.transact(mut registry, code.describe(signup_status), ENTRY_BYTES, runner.DEFAULT_STEPS)?
    steps.register(mut registry, ENTRY_BYTES, runner.DEFAULT_STEPS)?
    steps.register_transaction(mut registry, code.describe(activate), ENTRY_BYTES, runner.DEFAULT_STEPS)?
    runner.granted(mut registry, code.describe(run), ENTRY_BYTES, runner.DEFAULT_STEPS)
}

type Demo: send { config: runner.PlaceConfig[Grants, Tables, Services], stop: Receiver[()], status: Latest[runner.Status], watch: Sender[Receiver[runner.Phase]] }

fn operate(take demo: Demo) -> Result[runner.Ended, runner.StartError] waits {
    let Demo(config: take config, stop: take stop, status: take status, watch: take watch) = take demo
    runner.operate(take config, take stop, status, Some(take watch))
}

fn client_call[R: codec](conn: wire_client.Conn, slot: u32, take arg: Bytes, position: u64) -> R waits {
    wire_client.send_frame(conn, Call(0u32, position, slot, 1000u32, take arg))
    loop {
        match wire_client.next(conn) {
            Ok(Batch(_, _, _, done)) => {
                for item in done {
                    if item.p == position { return result.unwrap(decode_reply(item.outcome)) }
                }
            },
            Ok(_) => (),
            Error(_) => fail("sign-up: wire call lost"),
        }
    }
}

// Run with a scratch Dir, then inspect the account and its stored step rows.
pub fn main(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, out: Stdout) -> Result[(), Exit] waits {
    let mut name = result.unwrap(string.with_capacity(64u64))
    result.unwrap(string.push(mut name, "signup-"))
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let (take services, take mailing, take payments) = scripted_services(tasks)
    let target: triggers.Entry[Signup] = result.unwrap(triggers.granted(code.describe(run)))
    let entries = result.unwrap(trigger_entries(target))
    let trigger_config = runner.TriggerConfig(entries: take entries, author: store.Caller(issuer: 0u8, subject: list.new()),
        grants: take services, grant: make_grants, grant_bytes: 65536u64)
    let mut wire = runner.wire_defaults(65536u64, PLACE_BYTES)
    wire.n_pool = 4194304u64
    let options = triggers.law_options()
    let settings = runner.PlaceConfig(backing: Disk(dir, options), selection: Current(0u64), place: code.describe(place), n_place: PLACE_BYTES,
        migrate: code.describe(migrate), handles: code.describe(handles), session: wire, max_sessions: 1u64,
        proxies: list.new(), n_publisher: PLACE_BYTES, listen: Addr(ip: V4(0x7f000001u32), port: 0u16),
        net: net, tasks: tasks, clock: clock, random: random, stop: runner.Stop(lag_ms: 0u64, grace_ms: 1000u64), wire: None, triggers: Some(take trigger_config))
    let (stop, stopping): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (watch, watching): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = result.unwrap(channel.new(1u64))
    let status = result.unwrap(runner.status_root())
    let demo = Demo(config: take settings, stop: take stopping, status: latest.handle(status), watch: take watch)
    let mut running = result.unwrap(task.spawn(tasks, bytes 50331648u64, take demo, operate))
    let phases = result.unwrap(channel.receive(watching))
    loop {
        match channel.receive(phases) { Ok(Ready) => break, Ok(Starting(_)) => (), _ => fail("sign-up: place did not start") }
    }
    let address = option.unwrap(latest.read(status).addr)
    let mut keys: List[Bytes] = list.new()
    let signup_key = result.unwrap(entry_key(code.describe(signup)))
    let status_key = result.unwrap(entry_key(code.describe(signup_status)))
    result.unwrap(list.push(mut keys, result.unwrap(clone(signup_key))))
    result.unwrap(list.push(mut keys, result.unwrap(clone(status_key))))
    let conn = result.unwrap(wire_client.connect(tasks, net, address, clock, random, keys, None, wire.socket))
    let arg = Signup(id: 1u64, email: "ada@example.test", card: "scripted-card")
    let created = result.unwrap(encode(arg))
    let run_id: triggers.Id = client_call(conn, wire_client.slot(keys, signup_key), take created, 0u64)
    let mut position = 1u64
    let requested = StatusRequest(id: 1u64, run: run_id)
    loop {
        let observed: Option[bool] = client_call(conn, wire_client.slot(keys, status_key), result.unwrap(encode(requested)), position)
        match observed {
            Some(true) => break,
            Some(false) => fail("sign-up: run ended without activating the account"),
            None => (),
        }
        position += 1u64
        host.sleep_until(clock, int.saturating_add(host.mono_ns(clock), 50000000u64))
    }
    // Stop the place gracefully after observing the terminal commit, then reopen its store.
    let _ = wire_client.close(take conn)
    result.unwrap(channel.send(stop, ()))
    if let Ok(Ok(Stopped)) = task.join(take running) {} else { fail("sign-up: place did not stop") }
    let db = result.unwrap(store.open(tasks, dir, clock, random, options))
    let snapshot = store.snapshot(db)
    let h = result.unwrap(store.with_schema(db, code.describe(handles)))
    let Some(Returned(take outcome)) = result.unwrap(triggers.outcome(snapshot, h.triggers, run_id)) else { fail("sign-up: missing terminal outcome") }
    let result_codec: std.codec.Codec[RunResult] = std.codec.of()
    if let Ok(Active) = result.unwrap(std.codec.decode(result_codec, outcome)) {} else { fail("sign-up: expected an active outcome") }
    let welcome: Result[Option[Result[u64, WriteError]], store.Error] = steps.recorded(db, steps.StepId(run: run_id, index: 0u64))
    let paid: Result[Option[Result[u64, WriteError]], store.Error] = steps.recorded(db, steps.StepId(run: run_id, index: 1u64))
    if let Ok(Some(Ok(1u64))) = welcome {} else { fail("sign-up: missing welcome receipt") }
    if let Ok(Some(Ok(1u64))) = paid {} else { fail("sign-up: missing payment receipt") }
    result.unwrap(store.close(take db))
    let _ = take mailing
    let _ = take payments
    result.unwrap(stdout.write(out, "sign-up active; one welcome and one charge\n"))
    Ok(())
}

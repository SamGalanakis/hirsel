// A collection's lookup roots include the candidate queue and every earlier
// promotion of this cut. A queued subtree starts at its own root.
type TieredPromotionRoot: send = PromotionPage(std.page.Slot) | PromotionBlob(std.page.BlobRef)

type TieredPromotion {
    installed: TieredPageSource,
    captured: TieredPageSource,
    lookup: List[TieredPromotionRoot],
    probed_through: Map[u64, u64]
}

type TieredPromotionNeed: key = PromotionPageStamp(u64) | PromotionBlobStamp(u64)

type TieredPromotionHit: shareable + send = PromotedPage(std.page.Slot) | PromotedBlob(std.page.BlobSlot)

fn promotion_collection_root(tree: PageTree, collection: u32) -> Result[Option[std.page.Slot], Error] {
    let key = prefix(collection)?
    let Some((edge, descriptor)) = std.page.collection_slot(tree.root, key) else {
        return Ok(None)
    }
    if collection_descriptor(descriptor).residency != ResidentTiered {
        return Ok(None)
    }
    Ok(Some(clone(edge)))
}

fn promotion_page_stamp(edge: std.page.Slot) -> u64 {
    match edge {
        ColdPage(ptr) => ptr.stamp,
        HotPage(page) => std.page.stamp(std.page.image_of(page)),
    }
}

fn promotion_load_page(source: TieredPageSource, edge: std.page.Slot) -> Result[Arc[std.page.Page], Error] waits {
    match edge {
        ColdPage(ptr) => {
            let frame = fold_frame_at(source, TieredPage(ptr))?
            Ok(arc.share(fold_page(frame)))
        },
        HotPage(page) => Ok(arc.share(page)),
    }
}

fn promotion_find_path(cut: TieredPageSource, root: std.page.Slot, need: TieredPromotionNeed, key: Bytes) -> Result[Option[TieredPromotionHit], Error] waits {
    let mut edge: std.page.Slot = clone(root)
    loop {
        if need == PromotionPageStamp(promotion_page_stamp(edge)) {
            return Ok(Some(PromotedPage(take edge)))
        }
        let page = promotion_load_page(cut, edge)?
        let image = std.page.image_of(page)
        if let Some(slot) = std.page.descend(image, key) {
            edge = clone(option.unwrap(std.page.child_slot(page, slot)))
            continue
        }
        let (slot, found) = std.page.search(image, key)
        if found {
            if let Some(BlobEdge(reference)) = std.page.owning_edge(image, slot) {
                if need == PromotionBlobStamp(reference.stamp) {
                    let own_body = option.unwrap(std.page.blob_slot(page, reference.body))
                    return Ok(Some(PromotedBlob(clone(own_body))))
                }
            }
        }
        return Ok(None)
    }
}

fn promotion_find(cut: TieredPromotion, need: TieredPromotionNeed, key: Bytes) -> Result[Option[TieredPromotionHit], Error] waits {
    for root in cut.lookup {
        match root {
            PromotionPage(edge) => {
                if let Some(take found) = promotion_find_path(cut.installed, edge, need, key)? {
                    return Ok(Some(take found))
                }
            },
            PromotionBlob(reference) => {
                if need == PromotionBlobStamp(reference.stamp) {
                    return Ok(Some(PromotedBlob(ColdBlob(reference))))
                }
            },
        }
    }
    Ok(None)
}

// PACK_INDEX rows are in increasing data-offset order. The last offset
// reached by the installed probe marks the prefix it may still retire.
fn promotion_can_keep(cut: TieredPromotion, pack: u64, offset: u64) -> bool {
    if let None = std.omap.get(cut.installed.packs, pack) {
        return false
    }
    offset > map.get_or(cut.probed_through, pack, 0u64)
}

fn promotion_resolve_blob(cut: TieredPromotion, reference: std.page.BlobRef, current: std.page.BlobSlot, key: Bytes) -> Result[std.page.BlobSlot, Error] waits {
    if let Some(PromotedBlob(take found)) = promotion_find(cut, PromotionBlobStamp(reference.stamp), key)? {
        return Ok(take found)
    }
    if let ColdBlob(ptr) = view current {
        if !promotion_can_keep(cut, ptr.pack, ptr.offset) {
            let frame = fold_frame_at(cut.captured, TieredBlob(ptr))?
            let TieredValue(body) = view frame.payload else {
                fail("store: a BLOB reference resolved to a PAGE")
            }
            return disk_allocation(scoped fn() -> Result[std.page.BlobSlot, Error] {
                Ok(HotBlob(arc.new(copied(body)?)))
            })
        }
    }
    Ok(clone(current))
}

fn promotion_ref(reference: std.page.BlobRef, mut slot: std.page.BlobSlot, ordinal: u16) -> std.page.BlobRef {
    match slot {
        ColdBlob(mut ptr) => {
            ptr.body = ordinal
            ptr
        },
        HotBlob(_) => std.page.BlobRef(stamp: reference.stamp, len: reference.len, checksum: reference.checksum, pack: 0, offset: 0, body: ordinal),
    }
}

fn promotion_resolve_page(cut: TieredPromotion, collection: u32, root: std.page.Slot) -> Result[std.page.Slot, Error] waits {
    let stamp = promotion_page_stamp(root)
    if stamp == 0 {
        return Ok(clone(root))
    }
    let need = PromotionPageStamp(stamp)
    let page = {
        let source = promotion_load_page(cut.captured, root)?
        let key = tiered_page_index_key(collection, std.page.image_of(source))?
        if let Some(PromotedPage(take found)) = promotion_find(cut, need, list.slice(key, 4, list.len(key)))? {
            return Ok(take found)
        }
        // The walk itself owns the ancestor image. Do not hold a cut pin
        // across the visits to its children.
        match root {
            ColdPage(_) => disk_allocation(scoped fn() -> Result[Arc[std.page.Page], Error] {
                Ok(std.page.copy_with_stamp(source, stamp))
            })?,
            HotPage(_) => arc.share(source),
        }
    }
    let image = std.page.image_of(page)
    let height = std.page.level(image)
    let mut children: List[std.page.Slot] = list.new()
    let mut bodies: List[std.page.BlobSlot] = list.new()
    let mut rows: List[std.page.Entry] = list.new()
    let mut reemit = match root {
        ColdPage(ptr) => !promotion_can_keep(cut, ptr.pack, ptr.offset),
        HotPage(_) => true,
    }
    for slot in 0u64 .. std.page.count(image) {
        let mut row = disk_allocation(scoped fn() -> Result[std.page.Entry, Error] {
            Ok(option.unwrap(std.page.entry(image, slot)))
        })?
        match row.cell {
            Child(mut child) => {
                let original = option.unwrap(std.page.child_slot(page, slot))
                let resolved = promotion_resolve_page(cut, collection, original)?
                let place = match resolved {
                    ColdPage(ptr) => ptr,
                    HotPage(_) => std.page.unlocated(child.child.stamp),
                }
                reemit = reemit || place != child.child
                child.child = place
                capacity(list.try_reserve(mut children, 1))?
                list.push(mut children, take resolved)
            },
            BlobValue(mut reference) => {
                let original = option.unwrap(std.page.blob_slot(page, reference.body))
                let mut resolved = promotion_resolve_blob(cut, reference, original, row.key)?
                let place = promotion_ref(reference, mut resolved, int.truncate(list.len(bodies)))
                reemit = reemit || place != reference
                reference = place
                capacity(list.try_reserve(mut bodies, 1))?
                list.push(mut bodies, take resolved)
            },
            InlineValue(_) => (),
        }
        capacity(list.try_reserve(mut rows, 1))?
        list.push(mut rows, take row)
    }
    if !reemit {
        return Ok(clone(root))
    }
    disk_allocation(scoped fn() -> Result[std.page.Slot, Error] {
        let ready = page_result(std.page.encode(rows, height, stamp, Collection))?
        let winner = page_result(std.page.attach(take ready, clone(children), clone(bodies)))?
        Ok(HotPage(take winner))
    })
}

fn share_page_source(source: TieredPageSource) -> TieredPageSource {
    TieredPageSource(pager: channel.sender(source.pager), packs: std.omap.snapshot(source.packs), next_stamp: source.next_stamp, deadline: source.deadline)
}

// Each Tiered collection of a collection map, with its root slot.
fn promotion_tiered_collections(root: Arc[std.page.Page], mut found: List[(u32, std.page.Slot)]) -> Result[(), Error] {
    let image = std.page.image_of(root)
    for slot in 0u64 .. std.page.count(image) {
        if std.page.level(image) != 0 {
            promotion_tiered_collections(option.unwrap(std.page.child(root, slot)), mut found)?
            continue
        }
        if unwrap_collection_descriptor(std.page.value_at(root, slot)).residency != ResidentTiered {
            continue
        }
        let key = option.unwrap(std.page.key_at(image, slot))
        let collection: u32 = list.word_be(key, 0)
        capacity(list.try_reserve(mut found, 1))?
        list.push(mut found, (collection, clone(option.unwrap(std.page.child_slot(root, slot)))))
    }
    Ok(())
}

fn promotion_queue_root(source: TieredPageSource, row: DeferredFree, mut roots_found: List[TieredPromotionRoot]) -> Result[(), Error] {
    let (pack, root) = match row.target {
        TieredPage(ptr) => (ptr.pack, PromotionPage(ColdPage(ptr))),
        TieredBlob(reference) => (reference.pack, PromotionBlob(reference)),
    }
    // Lookups read through the installed inventory, which lists every pack
    // a queue row of the installed generation names.
    if let None = std.omap.get(source.packs, pack) {
        return Ok(())
    }
    capacity(list.try_reserve(mut roots_found, 1))?
    list.push(mut roots_found, take root)
    Ok(())
}

fn promotion_has_overlay(tree: PageTree, collection: u32) -> bool {
    let Some(overlay) = view tree.replay else {
        return false
    }
    match std.omap.get(overlay.collections, collection) {
        Some(_) => true,
        None => false,
    }
}

// §13.5 step 2 at the cut that publishes a historical pin or a cut-path
// fork. Each Tiered collection of the added root resolves against the lookup
// roots: every other participant after the fold, the installed queue and
// this cut's added rows. A collection whose root takes another location is
// re-pointed in a copy of the collection map with fresh stamps, so the
// Memory classes emit the map again. Whether the published generation lists
// a pack is the installed inventory's answer; the Snapshot's own inventory,
// which its lease keeps readable, reads what it captured. A refusal here
// refuses the cut: promotion is mandatory.
fn promote_cut_holder(db: Db, pager: Option[View[Sender[TieredPagerMessage]]], mut roots: List[Roots], at: u64, queued: List[DeferredFree], mut next_stamp: u64) -> Result[(bool, bool), Error] waits {
    let mut collections: List[(u32, std.page.Slot)] = list.new()
    promotion_tiered_collections(roots[at].collections.root, mut collections)?
    if list.len(collections) == 0 {
        return Ok((false, false))
    }
    let Some(requests) = pager else {
        return Error(Io(Closed))
    }
    let installed = disk_state(db).pages
    let paging = recovered_tiered_inventory(installed.locations, None, db.checkpointed, next_stamp)?
    let source = TieredPageSource(pager: channel.sender(requests), packs: std.omap.snapshot(paging.packs), next_stamp: next_stamp, deadline: 0)
    // A Snapshot whose Tiered roots are all Hot reads nothing it captured.
    let captured_packs = match view roots[at].collections.paging {
        Some(inventory) => std.omap.snapshot(inventory.packs),
        None => std.omap.snapshot(paging.packs),
    }
    let captured = TieredPageSource(pager: channel.sender(requests), packs: captured_packs, next_stamp: next_stamp, deadline: 0)
    let mut probed_through: Map[u64, u64] = map.new()
    for (seq, cursor) in installed.compaction.probes {
        capacity(map.try_reserve(mut probed_through, 1))?
        map.insert(mut probed_through, seq, cursor.next_data - 1)
    }
    let mut queue_roots: List[TieredPromotionRoot] = list.new()
    let mut rows = std.page.cursor_open(arc.share(installed.lists.deferred), None, true, false)
    while let Some(queue_row) = std.page.cursor_next(mut rows) {
        promotion_queue_root(source, queued_free(queue_row.value), mut queue_roots)?
    }
    for added in queued {
        promotion_queue_root(source, added, mut queue_roots)?
    }
    let captured_root = arc.share(roots[at].collections.root)
    let mut map_root = arc.share(roots[at].collections.root)
    let mut resolved_bases: Map[u32, std.page.Slot] = map.new()
    let mut changed = false
    for (collection, edge) in collections {
        let mut against: List[TieredPromotionRoot] = list.new()
        for slot in 0u64 .. list.len(roots) {
            if slot == at {
                continue
            }
            if let Some(take other) = promotion_collection_root(roots[slot].collections, collection)? {
                capacity(list.try_reserve(mut against, 1))?
                list.push(mut against, PromotionPage(take other))
            }
        }
        capacity(list.try_reserve(mut against, list.len(queue_roots)))?
        for queue_root in queue_roots {
            list.push(mut against, clone(queue_root))
        }
        let cut = TieredPromotion(installed: share_page_source(source), captured: share_page_source(captured), lookup: take against, probed_through: clone(probed_through))
        let resolved = promotion_resolve_page(cut, collection, edge)?
        // §13.5 steps 2 then 3: a collection with a replay overlay already
        // carries its post-overlay totals in its descriptor. Pass the
        // resolved base straight to `promotion_materialize` so
        // `install_tiered_root` checks totals against the materialized root.
        if promotion_has_overlay(roots[at].collections, collection) {
            capacity(map.try_reserve(mut resolved_bases, 1))?
            map.insert(mut resolved_bases, collection, take resolved)
            continue
        }
        if let (ColdPage(before), ColdPage(after)) = (view edge, view resolved) {
            if before == after {
                continue
            }
        }
        let key = prefix(collection)?
        let draw_from = next_stamp
        let (take mapped, following) = disk_allocation(scoped fn() -> Result[(Arc[std.page.Page], u64), Error] {
            let mut candidate = arc.share(map_root)
            let mut draw = draw_from
            page_result(std.page.install_tiered_root(mut candidate, key, resolved, mut draw))?
            Ok((take candidate, draw))
        })?
        map_root = take mapped
        next_stamp = following
        changed = true
    }
    if changed {
        roots[at].collections.root = take map_root
    }
    let materialized = promotion_materialize(captured, source, captured_root, resolved_bases, mut roots[at].collections, mut next_stamp)?
    Ok((changed, materialized))
}

// §13.5 step 3 after step 2: a Snapshot's overlay is applied to its tree as
// resolution left it, with fresh stamps, through the installed inventory
// that lists every Cold slot resolution kept or found. The `base` and trim
// evidence checks read the captured Cold tree, which equal stamps make the
// same logical content. The materialization records nothing: the fold of
// the Snapshot's own branch already queued what the overlay detaches and
// filed what it replaces (mandatory candidate steps 2 and 3).
fn promotion_materialize(captured: TieredPageSource, installed: TieredPageSource, captured_root: Arc[std.page.Page], resolved_bases: Map[u32, std.page.Slot], mut tree: PageTree, mut next_stamp: u64) -> Result[bool, Error] waits {
    let replayed: Option[Arc[ReplayBranch]] = clone(tree.replay)
    let Some(take overlay) = take replayed else {
        return Ok(false)
    }
    let Some(empty_root) = view tree.empty_collection else {
        fail("store: missing empty collection page")
    }
    let inline = tree.inline
    let mut folded = FoldMap(root: arc.share(tree.root), next_stamp: next_stamp, effects: None)
    let materialized = if let Some(collections) = std.omap.root(overlay.collections) {
        visit_fold_records(collections, mut folded, scoped fn(mut working: FoldMap, id: u32, edits: Arc[ReplayOverlay]) -> Result[(), Error] waits {
            let inherited = match overlay.fork_time {
                Some(forked) => std.omap.get(forked, id),
                None => None,
            }
            working.root = promotion_materialize_collection(captured, installed, captured_root, resolved_bases, working.root, empty_root, id, edits, inherited, inline, mut working.next_stamp)?
            Ok(())
        })
    } else {
        Ok(())
    }
    let FoldMap(root: take ready, next_stamp: following_stamp, ..) = take folded
    next_stamp = following_stamp
    materialized?
    tree.root = take ready
    tree.replay = None
    Ok(true)
}

fn promotion_materialize_collection(captured: TieredPageSource, installed: TieredPageSource, captured_root: Arc[std.page.Page], resolved_bases: Map[u32, std.page.Slot], root: Arc[std.page.Page], empty_root: Arc[std.page.Page], id: u32, edits: Arc[ReplayOverlay], inherited: Option[View[Arc[ReplayOverlay]]], inline: u64, mut next_stamp: u64) -> Result[Arc[std.page.Page], Error] waits {
    let key = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        prefix(id)
    })?
    let location = match option.unwrap(std.page.collection_slot(captured_root, key)) {
        (ColdPage(ptr), _) => ptr,
        (HotPage(_), _) => std.page.unlocated(0),
    }
    let base: std.page.Slot = match map.get(resolved_bases, id) {
        Some(slot) => clone(slot),
        None => {
            let (slot, _) = option.unwrap(std.page.collection_slot(root, key))
            clone(slot)
        },
    }
    let mut ignored: Option[List[TieredFoldEffect]] = None
    verify_tiered_fold(captured, location, edits)?
    let mut starting: std.page.Slot = clone(base)
    if let Some(previous) = inherited {
        verify_tiered_fold(captured, location, previous)?
        starting = fold_apply_overlay(installed, base, empty_root, previous, None, inline, mut next_stamp, mut ignored)?
    }
    let ready = fold_apply_overlay(installed, starting, empty_root, edits, inherited, inline, mut next_stamp, mut ignored)?
    let (take mapped, following) = disk_allocation(scoped fn() -> Result[(Arc[std.page.Page], u64), Error] {
        let mut candidate = arc.share(root)
        let mut draw = next_stamp
        page_result(std.page.install_tiered_root(mut candidate, key, ready, mut draw))?
        Ok((take candidate, draw))
    })?
    next_stamp = following
    Ok(take mapped)
}

// Clear drops elements in ascending order, including the suffix after failure, and keeps
// the storage: b"abc" owns capacity 3 (core.md "Literals").
// expect: accept
// expect: run reuse() = 904
// expect: run static_value() = 3
// expect: run resources() = 4 trace 7,11
// expect: run failed_drop() = fail Unwrap,Unwrap trace 7,11
fn clear[T](mut xs: List[T]) { list.clear(mut xs) }
fn reuse() -> u64 {
    let mut xs: List[u64] = list.new()
    result.unwrap(list.push(mut xs, 7u64))
    clear(mut xs)
    clear(mut xs)
    result.unwrap(list.push(mut xs, 9u64))
    xs[0] * 100 + list.capacity(xs)
}
fn static_value() -> u64 {
    let mut xs = result.unwrap(b"abc")
    clear(mut xs)
    list.len(xs) + list.capacity(xs)
}
resource type Mark { id:u64 } drop(m) { let _ = m.id }
fn resources() -> u64 {
    let mut xs: List[Mark] = list.new()
    result.unwrap(list.push(mut xs, result.unwrap(Mark(id:7))))
    result.unwrap(list.push(mut xs, result.unwrap(Mark(id:11))))
    clear(mut xs)
    list.len(xs) * 100 + list.capacity(xs)
}
resource type Broken { id:u64 } drop(m) {
    let _ = m.id
    let none: Option[u64] = None
    let _ = option.unwrap(none)
}
fn failed_drop() -> u64 {
    let mut xs: List[Broken] = list.new()
    result.unwrap(list.push(mut xs, result.unwrap(Broken(id:7))))
    result.unwrap(list.push(mut xs, result.unwrap(Broken(id:11))))
    clear(mut xs)
    999
}

// rule: CONC-6
// expect: run
// A blocked receive parks at once. Under FIFO, R yields once, so S and then
// the root (as C) are queued ahead of it when its receive finds the channel
// empty. R parks, S's send completes R's receive, and only then does the root
// cancel R: R has already received the value. A Yield turn before the park
// would leave R queued behind the cancel, which it would then observe.
// The exact result is the default (FIFO) schedule's; other schedules may run
// the cancel first, and every engine must still record the same tape.
fn discard[T](take value: T) -> () {
  ()
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  task.scope(
    tasks,
    fn(s: Scope) {
      let (sender, receiver): (Sender[u8], Receiver[u8]) = channel.open(tasks)
      let (turn, turn_rx): (Sender[u8], Receiver[u8]) = channel.open(tasks)
      let r = task.async(
        s,
        fn() -> Result[u8, ChannelError] {
          let mut yielder = take turn
          let _ = channel.send(tasks, mut yielder, 0u8)
          let mut rx = take receiver
          channel.receive(tasks, mut rx)
        }
      )
      let w = task.async(
        s,
        fn() -> () {
          let mut tx = take sender
          let _ = channel.send(tasks, mut tx, 7u8)
          ()
        }
      )
      task.cancel(s, r)
      failure.check(task.await(s, take r) == Ok(7u8), Arithmetic())
      task.await(s, take w)
      discard(take turn_rx)
    }
  )
  Ok(())
}

#!/usr/bin/env python3
"""Detached unit body: tools/land-run LOG [EVENTS] [--alone] [--repair-main TARGET]."""
import argparse
import json
import os
import signal
from pathlib import Path
import subprocess
import sys
import tempfile

from land_events import append_event


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('log')
    parser.add_argument('events', nargs='?', default='/workspace/code/hirsel-briefs/land-events.tsv')
    parser.add_argument('--alone', action='store_true')
    parser.add_argument('--repair-main', metavar='TARGET')
    options = parser.parse_args()
    root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
    log = Path(options.log).resolve()
    events = Path(options.events).resolve()
    lane = subprocess.check_output(['git', 'branch', '--show-current'], text=True).strip() or root.name
    submitted = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
    with tempfile.TemporaryDirectory(prefix='hirsel-land-result-') as temporary, log.open('w') as output:
        result = Path(temporary) / 'result.json'
        env = os.environ | dict(HIRSEL_LAND_RESULT_FILE=str(result), HIRSEL_LAND_LOG=str(log),
                                HIRSEL_LAND_EVENTS=str(events))
        code, child, cancelled = 1, None, False

        def withdraw(signum, frame):
            nonlocal cancelled
            cancelled = True
            if child is not None:
                try:
                    child.send_signal(signum)
                except ProcessLookupError:
                    pass

        previous = signal.signal(signal.SIGTERM, withdraw)
        try:
            arguments = (['--alone'] if options.alone else [])
            if options.repair_main:
                arguments += ['--repair-main', options.repair_main]
            child = subprocess.Popen([sys.executable, str(root / 'tools/land'), *arguments], cwd=root, env=env,
                                     stdout=output, stderr=subprocess.STDOUT)
            if cancelled:
                child.terminate()
            code = child.wait()
            if code < 0:
                code = 128 - code
        finally:
            signal.signal(signal.SIGTERM, previous)
            output.write(f'EXIT {code}\n')
            output.flush()
            os.fsync(output.fileno())
            record = json.loads(result.read_text()) if result.exists() else dict(lane=lane, submitted=submitted)
            append_event(events, 'LANDED' if code == 0 else 'FAILED', record, log, code)
    return code


if __name__ == '__main__':
    sys.exit(main())

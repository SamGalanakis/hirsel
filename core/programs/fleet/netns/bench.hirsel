// compute@1 create benchmark across three OS processes in three network
// namespaces. Node 0 runs the credit desk, node 1 the dispatcher and its
// callers, node 2 the worker. Every message is one authenticated roster
// datagram on a pinned QUIC link.
//
// One create: the dispatcher states its demand to the desk, the desk grants a
// credit, the dispatcher redeems it at the worker, the worker admits and starts
// the slot and answers. The workload ends at once: the worker retires the slot,
// mints its next credit and offers it to the desk. No user program is launched.
//
// Datagrams may still be lost. Demand is a versioned level, grants are numbered and
// acknowledged by the next demand, creates repeat until answered, and offers
// repeat until redeemed. Every repeat is idempotent in the compute kernels.
const BENCH_PRINCIPAL: u64 = 1

const BENCH_RUN: u64 = 1

const BENCH_SLOTS: u64 = 64

const BENCH_WARM: u64 = 5000

const BENCH_TAIL: u64 = 1000

const BENCH_RESEND_NS: u64 = 20000000

const BENCH_SCAN_NS: u64 = 5000000

const BENCH_WAIT_NS: u64 = 250000

const BENCH_SESSION: compute.worker.Session = compute.worker.Session(caller: 1, principal: BENCH_PRINCIPAL, id: 1)

/// `BenchAssume(host, run, owner_epoch)`, `BenchOffer(offer)`,
/// `BenchWant(ask, grants_received)`, `BenchGrant(number, credit)`,
/// `BenchCreate(exchange, credit, attempt, retry, attempt_floor)`,
/// `BenchCreated(exchange, result)`, `BenchStop`.
type BenchWire: codec + send = BenchAssume(u64, u64, u64) | BenchOffer(compute.protocol.Offer[u64, u64]) | BenchWant(compute.desk.Ask, u64) | BenchGrant(u64, compute.protocol.Credit[u64, u64]) | BenchCreate(u64, compute.protocol.Credit[u64, u64], compute.protocol.Attempt, compute.protocol.RetryClass, u64) | BenchCreated(u64, compute.protocol.Consumption[u64, u64]) | BenchStop

fn bench_send(mut hub: roster.HostLinks, dst: u64, nonce: u64, msg: BenchWire) {
    let co: std.codec.Codec[BenchWire] = std.codec.of()
    let mut raw: Bytes = list.new()
    result.unwrap(std.codec.encode(co, msg, mut raw))
    result.unwrap(roster.rpc(mut hub, dst, nonce, take raw))
}

fn bench_decode(data: Bytes) -> Option[BenchWire] {
    let co: std.codec.Codec[BenchWire] = std.codec.of()
    match std.codec.decode(co, data) {
        Ok(take msg) => Some(take msg),
        Error(_) => None,
    }
}

fn bench_one[T](take item: T) -> List[T] {
    let mut out: List[T] = list.new()
    list.push(mut out, take item)
    take out
}

fn bench_line(out: Stdout, key: String, a: u64, b: u64, c: u64) waits {
    let mut s = string.from(key)
    string.push(mut s, " ")
    string.push_u64(mut s, a)
    string.push(mut s, " ")
    string.push_u64(mut s, b)
    string.push(mut s, " ")
    string.push_u64(mut s, c)
    string.push(mut s, "\n")
    result.unwrap(stdout.write(out, s))
}

type BenchUnacked {
    number: u64,
    connection: u64,
    credit: compute.protocol.Credit[u64, u64],
    sent: u64
}

fn desk_event(mut desk: List[compute.desk.State[u64, u64]], take event: compute.desk.Event[u64, u64]) -> List[compute.desk.Action[u64, u64]] {
    let state = option.unwrap(list.pop(mut desk))
    let (next, actions) = compute.desk.step(take state, take event)
    list.push(mut desk, take next)
    take actions
}

// The credit desk. It prints `desk_mark grants step_ns io_rounds` when its grant count
// first reaches the warm-up count and again `creates` grants later. The harness
// reads the process CPU time at both lines.
fn bench_desk(mut root: TestHost, mut db: store.Db, cell: store.Cell[roster.Roster], clock: Clock, out: Stdout, creates: u64) waits {
    publish_seed(mut root, mut db, cell, out)
    let cfg = compute.desk.Config(session: 1, workers: 1, slots_per_worker: BENCH_SLOTS, classes: 1, connections: 1, pending_per_connection: 1024, pending_per_principal: 1024, grants_per_connection: BENCH_SLOTS, grants_per_principal: BENCH_SLOTS, shares: bench_one(compute.desk.Share(principal: BENCH_PRINCIPAL, weight: 1)))
    let mut desk: List[compute.desk.State[u64, u64]] = bench_one(compute.desk.init(take cfg))
    let _ = desk_event(mut desk, Connect(1))
    let mut unacked: List[BenchUnacked] = list.new()
    let mut issued: u64 = 0
    let mut step_ns: u64 = 0
    let mut marks: u64 = 0
    let mut scanned: u64 = 0
    let mut rounds: u64 = 0
    while true {
        result.unwrap(roster.drive(mut root.hub, mut root.socket, clock, host.mono_ns(clock) + BENCH_WAIT_NS, mut root.incoming))
        rounds += 1
        let mut stop = false
        for e in root.incoming {
            match e {
                Admission(req) => {
                    let _ = result.unwrap(roster.admit(mut root.hub, mut db, cell, req))
                },
                Message(node: from, data: data, ..) => {
                    let began = host.mono_ns(clock)
                    match bench_decode(data) {
                        Some(BenchAssume(member, run, epoch)) => {
                            if from == member {
                                let _ = desk_event(mut desk, Attach(member, run, run))
                                let _ = desk_event(mut desk, Assume(member, run, run, epoch))
                            }
                        },
                        Some(BenchOffer(take offer)) => {
                            if from == offer.credit.host {
                                let stream = offer.credit.run
                                let _ = desk_event(mut desk, Offer(take offer, stream))
                            }
                        },
                        Some(BenchWant(ask, received)) => {
                            if from == ask.connection && received <= issued {
                                let mut kept: List[BenchUnacked] = list.new()
                                for u in unacked {
                                    if u.number > received {
                                        list.push(mut kept, clone(u))
                                    }
                                }
                                unacked = take kept
                                // Grants still on the wire already answer part of this demand.
                                let transit = issued - received
                                let count = if ask.count > transit {
                                    ask.count - transit
                                } else {
                                    0u64
                                }
                                let _ = desk_event(mut desk, Demand(compute.desk.Ask(connection: ask.connection, class_id: ask.class_id, principal: ask.principal, version: ask.version, count)))
                            }
                        },
                        Some(BenchStop) => {
                            stop = true
                        },
                        _ => (),
                    }
                    while true {
                        let actions = desk_event(mut desk, Pop(0, BENCH_PRINCIPAL))
                        let mut granted = false
                        for a in actions {
                            if let Grant(ask, credit) = a {
                                issued += 1
                                granted = true
                                list.push(mut unacked, BenchUnacked(number: issued, connection: ask.connection, credit, sent: began))
                                bench_send(mut root.hub, ask.connection, 0, BenchGrant(issued, credit))
                            }
                        }
                        if !granted {
                            break
                        }
                    }
                    step_ns += host.mono_ns(clock) - began
                    if (marks == 0 && issued >= BENCH_WARM) || (marks == 1 && issued >= BENCH_WARM + creates) {
                        marks += 1
                        bench_line(out, "desk_mark", issued, step_ns, rounds)
                    }
                },
                Refused(_) => (),
            }
        }
        let now = host.mono_ns(clock)
        if now - scanned > BENCH_SCAN_NS {
            scanned = now
            for i in 0u64 .. list.len(unacked) {
                if now - unacked[i].sent > BENCH_RESEND_NS {
                    unacked[i].sent = now
                    bench_send(mut root.hub, unacked[i].connection, 0, BenchGrant(unacked[i].number, unacked[i].credit))
                }
            }
        }
        if stop {
            result.unwrap(roster.shutdown(mut root.hub, mut root.socket, clock))
            return
        }
    }
}

type BenchOffered {
    offer: compute.protocol.Offer[u64, u64],
    sent: u64,
    wait: u64
}

fn worker_event(mut worker: List[compute.worker.State[u64, u64]], take event: compute.worker.Event[u64, u64]) -> List[compute.worker.Action[u64, u64]] {
    let state = option.unwrap(list.pop(mut worker))
    let (next, actions) = compute.worker.step(take state, take event)
    list.push(mut worker, take next)
    take actions
}

fn bench_resources(n: u64) -> compute.resources.Vector {
    compute.resources.Vector(memory_bytes: n, address_space: n, warm_stock: n, mappings: n, fds: n, connections: n, starts: n, stacks: n, cpu: n, disk_iops: n)
}

// Send each fresh offer to the desk and remember it until it is redeemed.
fn bench_offer(mut hub: roster.HostLinks, clock: Clock, mut offers: Map[u64, BenchOffered], actions: List[compute.worker.Action[u64, u64]]) {
    for a in actions {
        if let Offer(desk, offer) = a {
            map.insert(mut offers, offer.credit.slot, BenchOffered(offer: clone(offer), sent: host.mono_ns(clock), wait: BENCH_RESEND_NS))
            bench_send(mut hub, desk, 0, BenchOffer(clone(offer)))
        }
    }
}

fn bench_worker(mut h: TestHost, clock: Clock, out: Stdout) waits {
    let start = host.mono_ns(clock)
    while !joined(h, 2) {
        result.unwrap(roster.drive(mut h.hub, mut h.socket, clock, host.mono_ns(clock) + BENCH_WAIT_NS, mut h.incoming))
        check_time(clock, start, "worker did not join")
    }
    let mut slot_classes: List[u64] = list.new()
    list.fill(mut slot_classes, BENCH_SLOTS, 0)
    let class = compute.worker.Class(shard: 0, cost: bench_resources(1), warm_cost: compute.resources.zero(), window: BENCH_SLOTS)
    let cfg = compute.worker.Config(host: 2u64, pool: bench_resources(BENCH_SLOTS), classes: bench_one(take class), slot_classes: take slot_classes, owners: bench_one(compute.worker.DeskOwner(member: 0u64, session: 1)), escrows: bench_one(compute.worker.Escrow(principal: BENCH_PRINCIPAL, rights: BENCH_SLOTS, epoch: 0, installed_transfer: None)), max_sessions: 1, max_attempts: 4096)
    let mut worker: List[compute.worker.State[u64, u64]] = bench_one(compute.worker.init(take cfg, BENCH_RUN))
    let _ = worker_event(mut worker, LauncherFenced(BENCH_RUN, BENCH_RUN))
    let mut epoch: u64 = 0
    for a in worker_event(mut worker, CustodyEmpty(BENCH_RUN, BENCH_RUN)) {
        if let AssumeOwner(_, _, _, _, assumed) = a {
            epoch = assumed
        }
    }
    if epoch == 0 {
        fail("worker assumed no desk owner")
    }
    let _ = worker_event(mut worker, OpenSession(BENCH_RUN, BENCH_SESSION))
    bench_send(mut h.hub, 0, 0, BenchAssume(2, BENCH_RUN, epoch))
    let mut offers: Map[u64, BenchOffered] = map.new()
    for slot in 0u64 .. BENCH_SLOTS {
        let minted = worker_event(mut worker, Mint(BENCH_RUN, slot))
        bench_offer(mut h.hub, clock, mut offers, minted)
    }
    let mut floor: u64 = 0
    let mut scanned: u64 = 0
    let mut asked: u64 = 0
    let mut answered: u64 = 0
    while true {
        result.unwrap(roster.drive(mut h.hub, mut h.socket, clock, host.mono_ns(clock) + BENCH_WAIT_NS, mut h.incoming))
        let mut stop = false
        for e in h.incoming {
            let Message(node: from, nonce: id, data: data, ..) = e else {
                continue
            }
            match bench_decode(data) {
                Some(BenchCreate(exchange, credit, attempt, retry, attempt_floor)) => {
                    asked += 1
                    if attempt_floor >= floor + 64 {
                        floor = attempt_floor
                        let _ = worker_event(mut worker, RetireAttempts(BENCH_RUN, BENCH_SESSION, floor))
                    }
                    let actions = worker_event(mut worker, Redeem(credit, attempt, retry, Authenticated(true)))
                    for a in actions {
                        match a {
                            Launch(checkout, _) => {
                                let _ = map.remove(mut offers, credit.slot)
                                for s in worker_event(mut worker, Started(checkout)) {
                                    if let Redeemed(done) = s {
                                        answered += 1
                                        bench_send(mut h.hub, from, id, BenchCreated(exchange, clone(done)))
                                    }
                                }
                                let _ = worker_event(mut worker, Retire(checkout))
                                let minted = worker_event(mut worker, Mint(BENCH_RUN, credit.slot))
                                bench_offer(mut h.hub, clock, mut offers, minted)
                            },
                            Redeemed(done) => {
                                answered += 1
                                bench_send(mut h.hub, from, id, BenchCreated(exchange, clone(done)))
                            },
                            _ => (),
                        }
                    }
                },
                Some(BenchStop) => {
                    stop = true
                },
                _ => (),
            }
        }
        let now = host.mono_ns(clock)
        if !stop && now - scanned > BENCH_SCAN_NS && roster.connected(h.hub, 0) {
            scanned = now
            let mut late: List[u64] = list.new()
            for (slot, o) in offers {
                if now - o.sent > o.wait {
                    list.push(mut late, slot)
                }
            }
            for slot in late {
                let mut o = option.unwrap(map.remove(mut offers, slot))
                o.sent = now
                o.wait = order.min(o.wait * 2, 64 * BENCH_RESEND_NS)
                bench_send(mut h.hub, 0, 0, BenchAssume(2, BENCH_RUN, epoch))
                bench_send(mut h.hub, 0, 0, BenchOffer(clone(o.offer)))
                map.insert(mut offers, slot, take o)
            }
        }
        if stop {
            bench_line(out, "worker_creates", asked, answered, 0)
            result.unwrap(roster.shutdown(mut h.hub, mut h.socket, clock))
            return
        }
    }
}

type BenchCall {
    began: u64,
    probe: u64,
    sent: u64,
    create: Option[BenchWire]
}

type BenchCaller {
    states: Map[u64, compute.dispatcher.State[u64, u64, u64]],
    calls: Map[u64, BenchCall],
    placing: List[u64],
    placed: u64,
    finds: u64,
    spare: List[compute.protocol.Credit[u64, u64]],
    floor: u64,
    done: u64,
    failed: u64,
    repeats: u64,
    sends: u64,
    answers: u64,
    creates: u64,
    first: u64,
    last: u64,
    samples: List[u64]
}

// Feed one event to one invocation and carry out what its kernel asks for.
fn bench_advance(mut d: BenchCaller, mut hub: roster.HostLinks, clock: Clock, seq: u64, take event: compute.dispatcher.Event[u64, u64, u64]) {
    let Some(take state) = map.remove(mut d.states, seq) else {
        return
    }
    let mut call = option.unwrap(map.remove(mut d.calls, seq))
    let (next, actions) = compute.dispatcher.step(take state, take event)
    let now = host.mono_ns(clock)
    let mut finished = false
    for a in actions {
        match a {
            Find(_, probe, _, _, _) => {
                call.probe = probe
                call.sent = 0
                call.create = None
                list.push(mut d.placing, seq)
                d.finds += 1
            },
            Send(exchange, credit, attempt, retry) => {
                let wire: BenchWire = BenchCreate(exchange, credit, attempt, retry, d.floor)
                bench_send(mut hub, credit.host, seq, clone(wire))
                d.sends += 1
                call.sent = now
                call.create = Some(take wire)
            },
            Finish(Created(_)) => {
                finished = true
            },
            Finish(Duplicate(_)) => {
                finished = true
            },
            _ => {
                finished = true
                d.failed += 1
            },
        }
    }
    if !finished {
        map.insert(mut d.states, seq, take next)
        map.insert(mut d.calls, seq, take call)
        return
    }
    d.done += 1
    if d.done == BENCH_WARM {
        d.first = now
    }
    if d.done > BENCH_WARM && d.done <= BENCH_WARM + d.creates {
        list.push(mut d.samples, now - call.began)
        d.last = now
    }
}

// The dispatcher and its callers: a closed loop of `concurrency` invocations.
// A sample runs from the invocation's first kernel step to its `Finish`.
fn bench_dispatcher(mut h: TestHost, clock: Clock, out: Stdout, concurrency: u64, creates: u64) waits {
    let start = host.mono_ns(clock)
    while !joined(h, 1) {
        result.unwrap(roster.drive(mut h.hub, mut h.socket, clock, host.mono_ns(clock) + BENCH_WAIT_NS, mut h.incoming))
        check_time(clock, start, "dispatcher did not join")
    }
    let total = BENCH_WARM + creates + BENCH_TAIL
    let policy = compute.dispatcher.ReleasePolicy(no_grants: true, deterministic: true, tolerates_duplicates: true, sinks_deduplicate: false, single_handle: false, has_net: false)
    let mut session = bench_one(compute.dispatcher.open_session(1, BENCH_PRINCIPAL, 1))
    let mut d = BenchCaller(states: map.new(), calls: map.new(), placing: list.new(), placed: 0, finds: 0, spare: list.new(), floor: 0, done: 0, failed: 0, repeats: 0, sends: 0, answers: 0, creates, first: 0, last: 0, samples: list.with_capacity(creates))
    let mut seen: Map[u64, ()] = map.new()
    let mut received: u64 = 0
    let mut next_seq: u64 = 1
    let mut version: u64 = 0
    let mut stated: u64 = 0
    let mut wanted: u64 = 0
    let mut scanned: u64 = 0
    let mut progress = (0u64, host.mono_ns(clock))
    while d.done < total {
        if d.done != progress.0 {
            progress = (d.done, host.mono_ns(clock))
        } else if host.mono_ns(clock) - progress.1 > 5000000000 {
            bench_line(out, "stall_done_states_waiting", d.done, map.len(d.states), list.len(d.placing) - d.placed)
            bench_line(out, "stall_spare_received_version", list.len(d.spare), received, version)
            fail("the benchmark made no progress for five seconds")
        }
        while map.len(d.states) < concurrency && next_seq <= total {
            let seq = next_seq
            next_seq += 1
            let attempt = compute.protocol.Attempt(caller: 1, principal: BENCH_PRINCIPAL, session: 1, seq, digest: (seq, 0))
            let caller = option.unwrap(list.pop(mut session))
            let (opened, accepted) = compute.dispatcher.session_step(take caller, Request(attempt))
            list.push(mut session, take opened)
            let Accepted(request) = accepted[0] else {
                fail("the session refused a fresh sequence")
            }
            let created: compute.dispatcher.State[u64, u64, u64] = compute.dispatcher.init(1u64, 0, request, policy, false)
            map.insert(mut d.states, seq, take created)
            map.insert(mut d.calls, seq, BenchCall(began: host.mono_ns(clock), probe: 0, sent: 0, create: None))
            bench_advance(mut d, mut h.hub, clock, seq, Begin)
        }
        while list.len(d.spare) > 0 && d.placed < list.len(d.placing) {
            let credit = option.unwrap(list.pop(mut d.spare))
            let seq = d.placing[d.placed]
            d.placed += 1
            let probe = match map.get(d.calls, seq) {
                Some(call) => call.probe,
                None => 0u64,
            }
            bench_advance(mut d, mut h.hub, clock, seq, Placed(probe, credit))
        }
        if d.placed == list.len(d.placing) && d.placed != 0 {
            list.clear(mut d.placing)
            d.placed = 0
        }
        let now = host.mono_ns(clock)
        let waiting = list.len(d.placing) - d.placed
        if d.finds != wanted || (waiting != 0 && now - stated > BENCH_RESEND_NS) {
            version += 1
            wanted = d.finds
            stated = now
            bench_send(mut h.hub, 0, 0, BenchWant(compute.desk.Ask(connection: 1, class_id: 0, principal: BENCH_PRINCIPAL, version, count: waiting), received))
        }
        if now - scanned > BENCH_SCAN_NS {
            scanned = now
            let mut lowest = next_seq
            let mut late: List[u64] = list.new()
            for (seq, call) in d.calls {
                lowest = order.min(lowest, seq)
                if call.sent != 0 && now - call.sent > BENCH_RESEND_NS {
                    list.push(mut late, seq)
                }
            }
            d.floor = lowest
            for seq in late {
                let mut call = option.unwrap(map.remove(mut d.calls, seq))
                call.sent = now
                d.repeats += 1
                d.sends += 1
                if let Some(BenchCreate(exchange, credit, attempt, retry, _)) = call.create {
                    bench_send(mut h.hub, credit.host, seq, BenchCreate(exchange, credit, attempt, retry, d.floor))
                }
                map.insert(mut d.calls, seq, take call)
            }
        }
        result.unwrap(roster.drive(mut h.hub, mut h.socket, clock, host.mono_ns(clock) + BENCH_WAIT_NS, mut h.incoming))
        for e in h.incoming {
            let Message(node: from, nonce: id, data: data, ..) = e else {
                continue
            }
            match bench_decode(data) {
                Some(BenchGrant(number, credit)) => {
                    if from == 0 && number > received && !map.contains(seen, number) {
                        map.insert(mut seen, number, ())
                        while map.contains(seen, received + 1) {
                            received += 1
                            let _ = map.remove(mut seen, received)
                        }
                        list.push(mut d.spare, credit)
                    }
                },
                Some(BenchCreated(exchange, take answer)) => {
                    if from == 2 {
                        d.answers += 1
                        bench_advance(mut d, mut h.hub, clock, id, WorkerReply(exchange, Answer(take answer)))
                    }
                },
                _ => (),
            }
        }
    }
    bench_line(out, "creates", list.len(d.samples), d.last - d.first, 0)
    bench_line(out, "failed", d.failed, d.repeats, 0)
    bench_line(out, "demands", version, received, 0)
    bench_line(out, "create_datagrams", d.sends, d.answers, 0)
    let mut line = string.from("samples")
    for ns in d.samples {
        string.push(mut line, " ")
        string.push_u64(mut line, ns)
    }
    string.push(mut line, "\n")
    result.unwrap(stdout.write(out, line))
    let stop = host.mono_ns(clock)
    let mut told: u64 = 0
    while (roster.connected(h.hub, 0) || roster.connected(h.hub, 2)) && host.mono_ns(clock) - stop < 2000000000 {
        let now = host.mono_ns(clock)
        if now - told > BENCH_SCAN_NS {
            told = now
            if roster.connected(h.hub, 0) {
                bench_send(mut h.hub, 0, 0, BenchStop)
            }
            if roster.connected(h.hub, 2) {
                bench_send(mut h.hub, 2, 0, BenchStop)
            }
        }
        result.unwrap(roster.drive(mut h.hub, mut h.socket, clock, host.mono_ns(clock) + BENCH_WAIT_NS, mut h.incoming))
    }
}

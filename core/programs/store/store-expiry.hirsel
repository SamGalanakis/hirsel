type ExpiryExtractor[K, V]: send {
    table: Table[K, V],
    id: u32,
    by: StaticFn[fn(K, V) -> Option[u64]]
}

/// Declares that `t`'s rows expire: `by` gives a row its expiry time in
/// keyed-time milliseconds, or None for a row that never expires. A row is
/// deleted by the first sweep at or after that time. Under Migrate a new or
/// changed declaration is built from the table's rows; until it is Public the
/// sweep skips the table. A table has at most one expiry.
pub fn expire_rows[K, V](mut d: Declare, mut t: TableDecl[K, V], by: StaticFn[fn(K, V) -> Option[u64]]) -> Result[(), Error] {
    active_table(d, t)?
    d.failed = true
    let key = std.codec.key_u64()
    let lookup_key = failure_result_from_rep(catalog.catalog_index_key(t.handle.id, maintenance.EXPIRY_INDEX))?
    let (take revision, ends) = index_revision(d.versioned, by, t.handle, key, std.codec.of_unit())?
    let mut proposed = indexes.Catalog(record: CatalogIndex(indexes.IndexRecord(shape: Entries(ManyEntry), payload_schemas: list.new(), projection: None, state: Backfilling(None))), id: d.plan.schema.next_table, owner: t.handle.id, epoch: 1, key: (std.codec.key_schema(key) ?=> |_| Schema(0)), schemas: list.new(), next: 0, by: failure_result_from_rep(types.copied(code.identity(by)))?, revision: take revision)
    let existing = existing_index_record(d, lookup_key, maintenance.EXPIRY_INDEX)?
    let rebuilt_for = settle_index_record(mut d, lookup_key, maintenance.EXPIRY_INDEX, take existing, mut proposed, ends)?
    let schema_binding = expiry_binding(t.handle, proposed, by)
    build_declared_record(mut d, t.handle, lookup_key, maintenance.EXPIRY_INDEX, proposed, indexes.binding_extractor(schema_binding), take rebuilt_for)?
    if let Follower = d.mode {} else {
        indexes.add_binding(mut d.plan.bindings, take schema_binding)
    }
    map.insert(mut d.indexes, proposed.id, ())
    d.failed = false
    Ok(())
}

fn expiry_binding[K, V](t: Table[K, V], record: indexes.Catalog, by: StaticFn[fn(K, V) -> Option[u64]]) -> indexes.IndexRegistration {
    let extractor: ExpiryExtractor[K, V] = ExpiryExtractor(table: clone(t), id: record.id, by: by)
    let extract: own[send] fn(Bytes, Bytes) -> Result[indexes.IndexValue, types.Failure] = fn(raw: Bytes, primary: Bytes) -> Result[indexes.IndexValue, types.Failure] {
        failure_result_to_rep(extract_expiry(extractor, raw, primary))
    }
    indexes.index_registration(t.id, t.readers.current, record, take extract, indexes.entry_key_end(std.codec.key_u64()))
}

fn extract_expiry[K, V](extractor: ExpiryExtractor[K, V], raw: Bytes, primary: Bytes) -> Result[indexes.IndexValue, Error] {
    let t = view extractor.table
    let k = failure_result_from_rep(catalog.decoded(std.codec.decode_key(t.key, primary)))?
    let v = row_value(t.readers, t.id, raw)?
    failure_result_from_rep(maintenance.expiry_entries(extractor.id, (code.callable(extractor.by))(k, v), primary))
}

/// What one sweep did: the rows it deleted, and its commit when it made one.
pub type Swept {
    rows: u64,
    ticket: Option[Ticket]
}

/// Deletes rows whose expiry is at or before keyed time, in one commit of at
/// most `limits.rows` rows and `limits.byte_limit` row bytes (at least one
/// row, so a row larger than the byte limit still goes). Rows go in
/// (table, expiry, key) order through the ordinary delete, so every index,
/// aggregate and change feed sees an ordinary delete. Only Public expiry
/// indexes this release binds are swept. An entry whose row is absent proves
/// the index wrong: the commit stops with Drift and the index is demoted and
/// rebuilt, as for any write. Not built: Tiered stores (`Missing("steps")`).
pub fn sweep_expired(mut db: Db, limits: Limits) -> Result[Swept, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    if limits.rows == 0 {
        return Error(Limit(Transaction))
    }
    if pages.tiered_collections(pages.holder_heads(db.holders)[0].roots.collections.root) {
        return Error(Missing("steps"))
    }
    let now = keyed_time(db)
    let due = failure_result_from_rep(maintenance.due_rows(pages.holder_heads(db.holders)[0].roots, db.indexes, now, limits.rows, limits.byte_limit))?
    if list.len(due) == 0 {
        return Ok(Swept(rows: 0, ticket: None))
    }
    let no_reply: Option[fn(Error) -> bool] = None
    let settled = store_body_at(mut db, 0u64, now, None, no_reply, scoped fn(mut tx: Tx) -> Result[(), Error] {
        for row in due {
            let indexes = failure_result_from_rep(txn.bound_indexes(tx.inner, row.table, row.schema))?
            if !failure_result_from_rep(txn.delete_impl(mut tx.inner, row.table, row.schema, indexes, row.primary, point_event))? {
                return Error(expiry_drift(mut tx, row.table)?)
            }
        }
        Ok(())
    })?
    match take settled {
        Committed(take done) => Ok(Swept(rows: list.len(due), ticket: Some(done.ticket))),
        Failed(Drift(_)) => Ok(Swept(rows: 0, ticket: None)),
        Refused(c) => Error(Full(c)),
        Aborted(Undone(value: take e, ..)) => Error(take e),
        _ => Error(Missing("expiry sweep")),
    }
}

// The expiry index of `owner` names a row it does not have.
fn expiry_drift(mut tx: Tx, owner: u32) -> Result[Error, Error] {
    let record = catalog_entry_in(txn.tx_roots(tx.inner).catalog, failure_result_from_rep(catalog.catalog_index_key(owner, maintenance.EXPIRY_INDEX))?)?
    let mut seen: List[(u32, u32)] = list.new()
    list.push(mut seen, (owner, record.id))
    Ok(failure_from_rep(txn.drift_stop(mut tx.inner, take seen)))
}

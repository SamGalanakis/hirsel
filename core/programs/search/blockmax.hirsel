// Search form B's block-max reading of one generation (STORE-SPEC §1.2
// "Search form B"): per-term cursors over packed blocks, block-max windows
// and the MaxScore split. The query in search.hirsel runs it per generation.
// A header addresses the last key and frontier in the term's two buffers.
// Consecutive headers delimit consecutive frontiers.
type Header {
    last_at: u64,
    last_end: u64,
    frontier_at: u64,
    count: u64,
    head: u64
}

// A term in one generation of the query's transaction. The first header
// past the consumed windows is at `at`. Only this block can have a cached
// bound or loaded postings. `pos` is the current posting and `stop` is the
// first past the window.
type Cursor {
    headers: List[Header],
    last_keys: Bytes,
    frontiers: List[(u64, u64)],
    at: u64,
    maximum: f64,
    bounded: bool,
    loaded: bool,
    data: PostingBlock,
    pos: u64,
    stop: u64,
    head: u64
}

fn term_cursor[K, V](tx: store.Tx, s: Text[K, V], g: u32, term: String) -> Result[Cursor, store.Error] {
    let mut headers: List[Header] = list.new()
    let mut last_keys: Bytes = list.new()
    let mut frontiers: List[(u64, u64)] = list.new()
    let mut rows = store.range(tx, s.derived.blocks, Included((g, clone(term), 0u32)), Included((g, clone(term), LAST_BLOCK)))?
    while let Some((_, take block)) = store.next_in(tx, mut rows)? {
        let last_at = list.len(last_keys)
        list.append(mut last_keys, block.last)
        let frontier_at = list.len(frontiers)
        list.append(mut frontiers, block.frontier)
        list.push(mut headers, Header(last_at: last_at, last_end: list.len(last_keys), frontier_at: frontier_at, count: block.count, head: key_head(block.last)))
    }
    let empty = PostingBlock(raw: list.new(), pairs_at: 0, heads_at: 0, keys_at: 0)
    Ok(Cursor(headers: take headers, last_keys: take last_keys, frontiers: take frontiers, at: 0, maximum: 0.0, bounded: false, loaded: false, data: take empty, pos: 0, stop: 0, head: 0))
}

fn last_key(c: Cursor, i: u64) -> View[Bytes] in c {
    let h = view c.headers[i]
    list.slice(c.last_keys, h.last_at, h.last_end)
}

// Evaluate the same per-tf frontier as the stored block. Computing the
// greatest contribution with the query's arithmetic preserves exact bounds.
fn ensure_bound(scoring: Scoring, weight: f64, mut c: Cursor) {
    if c.bounded {
        return
    }
    let start = c.headers[c.at].frontier_at
    let stop = if c.at + 1 < list.len(c.headers) {
        c.headers[c.at + 1].frontier_at
    } else {
        list.len(c.frontiers)
    }
    let mut most: f64 = 0.0
    for (tf, length) in list.slice(c.frontiers, start, stop) {
        let value = contribution(scoring.params, length_norm(scoring, length), weight, tf)
        if float.gt(value, most) {
            most = value
        }
    }
    c.maximum = most
    c.bounded = true
}

fn next_block(mut c: Cursor) {
    c.at += 1
    c.loaded = false
    c.bounded = false
}

fn posting_key(c: Cursor, p: u64) -> View[Bytes] in c {
    let offsets = list.slice(c.data.raw, 8, c.data.pairs_at)
    let start: u64 = list.word_le(offsets, p * 8)
    let end: u64 = list.word_le(offsets, p * 8 + 8)
    list.slice(list.slice(c.data.raw, c.data.keys_at, list.len(c.data.raw)), start, end)
}

fn posting_head(c: Cursor, p: u64) -> u64 {
    list.word_le(list.slice(c.data.raw, c.data.heads_at, c.data.keys_at), p * 8)
}

fn compare_posting(c: Cursor, p: u64, head: u64, target: Bytes) -> Order {
    let current = posting_head(c, p)
    if current < head {
        return Less
    }
    if current > head {
        return Greater
    }
    list.compare_bytes(posting_key(c, p), target)
}

// Orders two cursors by their current keys: by head, then by bytes.
fn compare_current(left: Cursor, right: Cursor) -> Order {
    if left.head != right.head {
        return if left.head < right.head {
            Less
        } else {
            Greater
        }
    }
    list.compare_bytes(posting_key(left, left.pos), posting_key(right, right.pos))
}

// The first posting from `from` in the loaded block whose key is past
// `target`.
fn first_after(c: Cursor, from: u64, head: u64, target: Bytes) -> u64 {
    let mut low = from
    let mut high = c.headers[c.at].count
    while low < high {
        let middle = low + (high - low) / 2
        if compare_posting(c, middle, head, target) == Greater {
            high = middle
        } else {
            low = middle + 1
        }
    }
    low
}

// Moves a cursor of a read block to its first posting before `stop` whose
// key is at least `key` (with head `head`): a step when it is near, else a
// binary search.
fn catch_up(mut c: Cursor, head: u64, key: Bytes) {
    if c.pos >= c.stop || behind(c, head, key) == false {
        return
    }
    let mut low = c.pos + 1
    let mut high = c.stop
    if low < high {
        set_pos(mut c, low)
        if behind(c, head, key) {
            low += 1
            while low < high {
                let middle = low + (high - low) / 2
                if compare_posting(c, middle, head, key) == Less {
                    low = middle + 1
                } else {
                    high = middle
                }
            }
        }
    }
    set_pos(mut c, low)
}

fn behind(c: Cursor, head: u64, key: Bytes) -> bool {
    if c.head != head {
        return c.head < head
    }
    list.compare_bytes(posting_key(c, c.pos), key) == Less
}

fn set_pos(mut c: Cursor, p: u64) {
    c.pos = p
    if p < c.headers[c.at].count {
        c.head = posting_head(c, p)
    }
}

// The current posting's contribution.
fn posting_contribution(scoring: Scoring, weight: f64, c: Cursor) -> f64 {
    let pairs = list.slice(c.data.raw, c.data.pairs_at, c.data.heads_at)
    let tf: u64 = list.word_le(pairs, c.pos * 16)
    let length: u64 = list.word_le(pairs, c.pos * 16 + 8)
    contribution(scoring.params, length_norm(scoring, length), weight, tf)
}

// Reads the cursor's block if it is not read, and sets `stop` to its first
// posting past `end`.
fn ready_cursor[K, V](tx: store.Tx, s: Text[K, V], g: u32, term: String, mut c: Cursor, low: Option[Bytes], end_head: u64, end: Bytes) -> Result[(), store.Error] {
    if !c.loaded {
        load(tx, s, g, term, mut c, low)?
    }
    c.stop = if ends_at(c, end_head, end) {
        c.headers[c.at].count
    } else {
        first_after(c, c.pos, end_head, end)
    }
    Ok(())
}

// Reads block `at` and stands on its first posting past `low`.
fn load[K, V](tx: store.Tx, s: Text[K, V], g: u32, term: String, mut c: Cursor, low: Option[Bytes]) -> Result[(), store.Error] {
    let number: u32 = int.narrow(c.at)
    let Some(take raw) = store.fetch(tx, s.derived.postings, (g, clone(term), number))? else {
        return Error(MigrationFault)
    }
    c.data = posting_block(take raw)?
    c.loaded = true
    let from = match low {
        Some(after) => first_after(c, 0, key_head(after), after),
        None => 0,
    }
    set_pos(mut c, from)
    Ok(())
}

fn ends_at(c: Cursor, head: u64, end: Bytes) -> bool {
    c.headers[c.at].head == head && list.compare_bytes(last_key(c, c.at), end) == Equal
}

fn earlier_block(left: Cursor, right: Cursor) -> bool {
    let lh = left.headers[left.at].head
    let rh = right.headers[right.at].head
    if lh != rh {
        return lh < rh
    }
    list.compare_bytes(last_key(left, left.at), last_key(right, right.at)) == Less
}

// Whether a bound keeps every row it covers out of the heap. Rows of equal
// score rank by key, so once every live cursor stands at or past the worst
// hit's key a bound equal to its score cannot enter either: in a corpus of
// few distinct (tf, length) pairs most bounds tie the worst score exactly.
fn cannot_enter(sum: f64, floor: f64, ties_lose: bool) -> bool {
    float.lt(sum, floor) || (ties_lose && float.eq(sum, floor))
}

// Whether a newer generation or the tail mentions `raw`.
fn masked[K, V](tx: store.Tx, s: Text[K, V], generations: List[store.Generation], at: u64, tail: std.set.Set[Bytes], raw: Bytes) -> Result[bool, store.Error] {
    if std.set.contains(tail, raw) {
        return Ok(true)
    }
    for newer in at + 1 .. list.len(generations) {
        if let Some(_) = store.fetch(tx, s.derived.mentions, (generations[newer].id, clone(raw)))? {
            return Ok(true)
        }
    }
    Ok(false)
}

// Block-max top-k over generation `at` (Ding and Suel 2011; Lucene's
// MaxScoreBulkScorer and Tantivy's block_wand read the same bounds): the
// terms' postings are read in windows, each ending at the least last key of
// the blocks the cursors stand in. A window whose blocks' bounds, summed in
// query order, cannot reach the heap is passed without reading a posting.
// Otherwise the terms split as MaxScore splits them (Turtle and Flood 1995):
// those whose bounds, taken by increasing bound, cannot place a row alone
// are read only at rows the others hold, and only when the row's bound with
// them can still enter; each row read is scored exactly as form A scores it.
// A block is read only when a window needs it.
fn block_max_generation[K, V](mut best: List[(Bytes, Hit[K])], k: u64, tx: store.Tx, s: Text[K, V], scoring: Scoring, generations: List[store.Generation], at: u64, tail: std.set.Set[Bytes], allows: scoped fn(K) -> bool) -> Result[(), store.Error] {
    let g = generations[at].id
    let terms = list.len(scoring.terms)
    let mut cursors: List[Cursor] = list.with_capacity(terms)
    for weighted in scoring.terms {
        list.push(mut cursors, term_cursor(tx, s, g, weighted.term)?)
    }
    let mut inside: List[bool] = list.new()
    list.fill(mut inside, terms, false)
    let mut held: List[bool] = list.new()
    list.fill(mut held, terms, false)
    let mut lead: List[bool] = list.new()
    list.fill(mut lead, terms, false)
    let mut ready: List[bool] = list.new()
    list.fill(mut ready, terms, false)
    // Every row at or before `low` is read.
    let mut low: Option[Bytes] = None
    loop {
        let mut w = terms
        for i in 0u64 .. terms {
            if cursors[i].at < list.len(cursors[i].headers) && (w == terms || earlier_block(cursors[i], cursors[w])) {
                w = i
            }
        }
        if w == terms {
            return Ok(())
        }
        let end: Bytes = clone(last_key(cursors[w], cursors[w].at))
        let end_head = cursors[w].headers[cursors[w].at].head
        // The blocks that can hold a row in (low, end], and their bound.
        let full = list.len(best) == k
        let mut limit: f64 = 0.0
        for i in 0u64 .. terms {
            let current = cursors[i].at
            inside[i] = current < list.len(cursors[i].headers) && (current == 0 || list.compare_bytes(last_key(cursors[i], current - 1), end) == Less)
            if full && inside[i] {
                ensure_bound(scoring, scoring.terms[i].weight, mut cursors[i])
                limit += cursors[i].maximum
            }
        }
        let mut ties_lose = false
        if full {
            if let Some(after) = view low {
                ties_lose = list.compare_bytes(after, best[0].0) != Less
            }
        }
        if full && cannot_enter(limit, best[0].1 .score, ties_lose) {
            for i in 0u64 .. terms {
                if inside[i] {
                    if ends_at(cursors[i], end_head, end) {
                        next_block(mut cursors[i])
                    } else if cursors[i].loaded {
                        let next = first_after(cursors[i], cursors[i].pos, end_head, end)
                        set_pos(mut cursors[i], next)
                    }
                }
            }
            low = Some(take end)
            continue
        }
        for i in 0u64 .. terms {
            lead[i] = inside[i]
            ready[i] = false
        }
        if full {
            loop {
                let mut pick = terms
                for i in 0u64 .. terms {
                    if lead[i] && (pick == terms || float.lt(cursors[i].maximum, cursors[pick].maximum)) {
                        pick = i
                    }
                }
                if pick == terms {
                    break
                }
                lead[pick] = false
                let mut alone: f64 = 0.0
                for i in 0u64 .. terms {
                    if inside[i] && !lead[i] {
                        alone += cursors[i].maximum
                    }
                }
                if !cannot_enter(alone, best[0].1 .score, ties_lose) {
                    lead[pick] = true
                    break
                }
            }
        }
        for i in 0u64 .. terms {
            if lead[i] {
                ready_cursor(tx, s, g, scoring.terms[i].term, mut cursors[i], low, end_head, end)?
                ready[i] = true
            }
        }
        loop {
            let mut m = terms
            for i in 0u64 .. terms {
                if lead[i] && cursors[i].pos < cursors[i].stop && (m == terms || compare_current(cursors[i], cursors[m]) == Less) {
                    m = i
                }
            }
            if m == terms {
                break
            }
            for i in 0u64 .. terms {
                held[i] = lead[i] && cursors[i].pos < cursors[i].stop && (i == m || compare_current(cursors[i], cursors[m]) == Equal)
            }
            let mut passes = false
            if list.len(best) == k {
                // The row's bound: its own contributions where the leading
                // terms hold it, the others' block bounds, in query order.
                let mut most: f64 = 0.0
                for i in 0u64 .. terms {
                    if held[i] {
                        most += posting_contribution(scoring, scoring.terms[i].weight, cursors[i])
                    } else if inside[i] && !lead[i] {
                        most += cursors[i].maximum
                    }
                }
                passes = cannot_enter(most, best[0].1 .score, ties_lose)
            }
            if !passes {
                let key: Bytes = clone(posting_key(cursors[m], cursors[m].pos))
                let head = cursors[m].head
                for i in 0u64 .. terms {
                    if inside[i] && !lead[i] {
                        if !ready[i] {
                            ready_cursor(tx, s, g, scoring.terms[i].term, mut cursors[i], low, end_head, end)?
                            ready[i] = true
                        }
                        catch_up(mut cursors[i], head, key)
                        held[i] = cursors[i].pos < cursors[i].stop && cursors[i].head == head && list.compare_bytes(posting_key(cursors[i], cursors[i].pos), key) == Equal
                    }
                }
                let mut score: f64 = 0.0
                for i in 0u64 .. terms {
                    if held[i] {
                        score += posting_contribution(scoring, scoring.terms[i].weight, cursors[i])
                    }
                }
                if enters(best, k, key, score) && !masked(tx, s, generations, at, tail, key)? {
                    let decoded = std.codec.decode_key(s.derived.primary, key) ?=> Decode
                    if allows(decoded) {
                        // Later rows of the window have greater keys than
                        // this one, so they lose a tie to the worst hit
                        // exactly when this key is not less than its key.
                        let tie_key: Bytes = clone(key)
                        keep_hit(mut best, k, (take key, Hit(key: take decoded, score: score)))
                        if list.len(best) == k {
                            ties_lose = list.compare_bytes(tie_key, best[0].0) != Less
                        }
                    }
                }
            }
            for i in 0u64 .. terms {
                if held[i] {
                    let next = cursors[i].pos + 1
                    set_pos(mut cursors[i], next)
                }
            }
        }
        for i in 0u64 .. terms {
            if inside[i] {
                if ends_at(cursors[i], end_head, end) {
                    next_block(mut cursors[i])
                } else if ready[i] {
                    let next = cursors[i].stop
                    set_pos(mut cursors[i], next)
                } else if cursors[i].loaded {
                    let next = first_after(cursors[i], cursors[i].pos, end_head, end)
                    set_pos(mut cursors[i], next)
                }
            }
        }
        low = Some(take end)
    }
}

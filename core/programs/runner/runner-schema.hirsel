fn migration_declaration(db: store.Db, tasks: Tasks, on_migrate: Option[StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits]]) -> Result[store.Declare, store.Error] waits {
    match on_migrate {
        Some(callback) => store.declare_migration(db, tasks, callback),
        None => store.declare(db, Migrate),
    }
}

fn open_place_schema[H: shareable + inert + send](mut db: store.Db, schema: StaticFn[fn(mut store.Declare) -> Result[H, store.Error]]) -> Result[H, store.Error] waits {
    let mut declaration = store.declare(db, Open)?
    let h = (code.callable(schema))(mut declaration)?
    let _ = store.seal(mut db, take declaration)?
    Ok(take h)
}

fn head_prepare[G: send, H: shareable + inert + send](mut db: store.Db, selection: Selection, persistent: bool, placing: Placing[G, H], on_migrate: Option[StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits]], schema: StaticFn[fn(mut store.Declare) -> Result[H, store.Error]], n_place: u64, tasks: Tasks) -> Result[(Registry[G, H], H, Bytes, Bytes), OpenError] waits {
    head_prepare_registered(mut db, selection, persistent, placing, on_migrate, schema, n_place, tasks, None)
}

type HeadRegistration[G: send, H: shareable + inert + send] {
    registry: Registry[G, H],
    description: Bytes,
    record: ReleaseRecord
}

fn head_prepare_registered[G: send, H: shareable + inert + send](mut db: store.Db, selection: Selection, persistent: bool, placing: Placing[G, H], on_migrate: Option[StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits]], schema: StaticFn[fn(mut store.Declare) -> Result[H, store.Error]], n_place: u64, tasks: Tasks, take pre_registered: Option[HeadRegistration[G, H]]) -> Result[(Registry[G, H], H, Bytes, Bytes), OpenError] waits {
    if !store.is_disk(db) {
        let mut local_registry = match instantiate(placing) {
            Ok(take registered) => take registered,
            Error(take problem) => return Error(Place(take problem))
        }
        let identity = activation_identity(code.identity(placing.place), on_migrate, code.identity(schema))?
        let installing = match selection {
            Install(_) => true,
            InstallAt(_, _) => true,
            InstallFrom(_) => true,
            _ => store.version(store.snapshot(db)) == 0u64,
        }
        let h = if installing {
            let mut declaration = migration_declaration(db, tasks, on_migrate) ?=> Migrate
            let made = (code.callable(schema))(mut declaration) ?=> Migrate
            let _ = store.seal(mut db, take declaration) ?=> Migrate
            take made
        } else {
            open_place_schema(mut db, schema) ?=> Store
        }
        let release = http_release_digest(local_registry.t.exported, local_registry.t.bindings) ?=> |_| Place(Bounds)
        return Ok((take local_registry, take h, take release, take identity))
    }
    let explicit_install = match selection {
        Install(_) => true,
        InstallAt(_, _) => true,
        InstallFrom(_) => true,
        _ => false,
    }
    if explicit_install {
        activation_result(store.activation_install_allowed(db))?
    }
    if persistent && launch_env().revision.size == 0u64 {
        return Error(IdentityUnknown)
    }
    let current = activation_result(current_description(db))?
    let selected: Option[u64] = match selection {
        Install(_) => None,
        InstallAt(target, _) => {
            let next = store.version(store.snapshot(db)) + 1u64
            if next != (if target == 0u64 {
                1u64
            } else {
                target
            }) {
                return Error(InstallVersion(next))
            }
            None
        },
        InstallFrom(_) => {
            let Some(expected) = launch_env().predecessor else {
                return Error(IdentityUnknown)
            }
            if !persistent || current == None {
                return Error(IdentityUnknown)
            }
            let version = activation_result(activation_version(db))?
            let Some(take prior) = activation_result(release_record(db, version))? else {
                return Error(IdentityUnknown)
            }
            if prior.binding != launch_bytes(expected) {
                return Error(PredecessorChanged(clone(prior.binding)))
            }
            None
        },
        Reopen => match current {
            None => None,
            Some(_) => Some(activation_result(activation_version(db))?),
        },
        Current(expected) => match current {
            None => {
                if expected != 0u64 {
                    return Error(NotCurrent(Empty))
                }
                None
            },
            Some(_) => {
                let version = activation_result(activation_version(db))?
                if version != expected {
                    return Error(not_current_activation(db, version, option.unwrap(take current)))
                }
                Some(version)
            },
        },
    }
    let (take reg, take description, take record) = match take pre_registered {
        Some(HeadRegistration(registry: take reg, description: take description, record: take record)) => (take reg, take description, take record),
        None => {
            let reg = instantiate(placing) ?=> Place
            let (take description, take record) = prepare_activation(reg, n_place, list.new()) ?=> Place
            (take reg, take description, take record)
        },
    }
    if let Some(version) = selected {
        let old = option.unwrap(take current)
        let prior = activation_result(release_record(db, version))?
        let matches = match prior {
            Some(row) => row.binding == record.binding,
            None => false
        }
        if !matches {
            return Error(not_current_activation(db, version, take old))
        }
        let identity = activation_identity(code.identity(placing.place), on_migrate, code.identity(schema))?
        let h = open_place_schema(mut db, schema) ?=> Store
        let ReleaseRecord(release: take release, ..) = take record
        return Ok((take reg, take h, take release, take identity))
    }
    if !explicit_install {
        activation_result(store.activation_install_allowed(db))?
    }
    let identity = activation_identity(code.identity(placing.place), on_migrate, code.identity(schema))?
    let mut declaration = migration_declaration(db, tasks, on_migrate) ?=> Migrate
    let h = (code.callable(schema))(mut declaration) ?=> Migrate
    let mut stage = store.finish_migration(db, take declaration) ?=> Migrate
    settle_held(db, mut stage, selection, reg, h, current, n_place)?
    let version = store.version(store.snapshot(db)) + 1u64
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    activation_result(store.stage_activation(mut stage, version, current, description, release_codec, record))?
    if let Error(take problem) = store.install_bound_activation(mut db, take stage, version, record.binding) {
        if let Tiered(Install) = problem {
            return Error(Store(take problem))
        }
        if let InstallAt(_, _) = selection {
            return Error(InstallUncertain(take problem))
        }
        if let InstallFrom(_) = selection {
            return Error(InstallUncertain(take problem))
        }
        return Error(Store(take problem))
    }
    let ReleaseRecord(release: take release, ..) = take record
    Ok((take reg, take h, take release, take identity))
}

fn activation_result[T](take answer: Result[T, store.Error]) -> Result[T, OpenError] {
    match take answer {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Store(take problem)),
    }
}

fn activation_identity(place_id: Bytes, on_migrate: Option[StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits]], schema_id: Bytes) -> Result[Bytes, OpenError] {
    let launch = launch_digest() ?=> |problem| Store(Full(Allocation(problem)))
    activation_identity_for(take launch, place_id, on_migrate, schema_id)
}

fn activation_identity_for(take launch: Bytes, place_id: Bytes, on_migrate: Option[StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits]], schema_id: Bytes) -> Result[Bytes, OpenError] {
    let migrate_id: Bytes = match on_migrate {
        Some(callback) => clone(code.identity(callback)),
        None => list.new(),
    }
    match replay_identity_of(take launch, place_id, migrate_id, schema_id) {
        Ok(take digest) => Ok(take digest),
        Error(problem) => Error(Store(Full(Allocation(problem)))),
    }
}

fn replay_identity_of(take launch: Bytes, place_id: Bytes, migrate_id: Bytes, schema_id: Bytes) -> Result[Bytes, Capacity] {
    if list.len(launch) == 0 {
        return Ok(list.new())
    }
    let mut raw = take launch
    be_word(mut raw, list.len(place_id), 4)?
    list.append(mut raw, place_id)
    be_word(mut raw, list.len(migrate_id), 4)?
    list.append(mut raw, migrate_id)
    be_word(mut raw, list.len(schema_id), 4)?
    list.append(mut raw, schema_id)
    let mut hash = std.sha256.start()
    std.sha256.add(mut hash, raw, 0, list.len(raw))
    let digest = std.sha256.finish(hash)
    let mut identity: Bytes = list.with_capacity(32)
    for byte in digest {
        list.push(mut identity, byte)
    }
    Ok(take identity)
}

fn push_undeclared_schema(mut line: String, name: String) {
    string.push(mut line, "undeclared table or index: ")
    string.push(mut line, name)
    string.push(mut line, ". Declare it in schema, or remove it during an upgrade. For a table, call store.drop_named_table in on_migrate. For an index, omit it from its table's declaration.")
}

fn close_store(take db: store.Db) -> Result[(), OpenError] waits {
    match store.close(take db) {
        Ok(()) => Ok(()),
        Error(take problem) => Error(Store(take problem))
    }
}

// The activation fate of a disk install (RUNNER-SPEC §14.6): every held row is
// rewritten in the activation's own staging, or the install is refused
// `Unsettled` before it stages any activation.
fn settle_held[G: send, H: shareable + inert + send](db: store.Db, mut stage: store.StagedMigration, selection: Selection, reg: Registry[G, H], h: H, current: Option[Bytes], n_place: u64) -> Result[(), OpenError] waits {
    let Some(tables) = (declared_triggers(reg, h, store.snapshot(db)) ?=> Store) else {
        return Ok(())
    }
    let image = trigger_stamp(reg.t.exported, reg.t.bindings, n_place) ?=> Store
    let mut registered: List[Bytes] = list.new()
    for entry in reg.t.exported {
        list.push(mut registered, triggers.identity_path(entry.described.identity))
    }
    if let Some(prior) = current {
        let codec: std.codec.Codec[Describe] = std.codec.of()
        let old = std.codec.decode(codec, prior) ?=> |problem| Store(Decode(problem))
        for entry in old.exported {
            list.push(mut registered, triggers.identity_path(entry.described.identity))
        }
    }
    let chosen: fate.Fates = match selection {
        Install(f) => clone(f),
        InstallAt(_, f) => clone(f),
        InstallFrom(f) => clone(f),
        _ => fate.none(),
    }
    match fate.settle(db, mut stage, tables, image, registered, chosen) ?=> Store {
        Some(take report) => Error(Unsettled(take report)),
        None => Ok(()),
    }
}

// Keep these options in Args so they are also present during Run tape replay.
pub fn launch_selection(a: Args) -> Result[Selection, Exit] {
    let mut selected: Option[Selection] = None
    let mut fates = fate.none()
    let mut held = false
    for i in 0u64 .. args.len(a) {
        let name = option.unwrap(args.get(a, i))
        match fate.parse_option(mut fates, name) {
            Ok(true) => {
                held = true
                continue
            },
            Ok(false) => {},
            Error(_) => return Error(Exit(status: 1u8)),
        }
        let choice = if name == "--hirsel-install" {
            Install(fate.none())
        } else if let Some(value) = std.string.strip_prefix(name, "--hirsel-activation=") {
            let Ok(v) = (int.parse(value) : Result[u64, ParseError]) else {
                return Error(Exit(status: 1u8))
            }
            Current(v)
        } else {
            continue
        }
        if let Some(_) = selected {
            return Error(Exit(status: 1u8))
        }
        selected = Some(choice)
    }
    // Held fates are install options (RUNNER-SPEC §14.6 "Who supplies a fate").
    Ok(match take selected {
        Some(Install(_)) => Install(take fates),
        Some(take choice) => {
            if held {
                return Error(Exit(status: 1u8))
            }
            take choice
        },
        None => {
            if held {
                return Error(Exit(status: 1u8))
            }
            Reopen
        },
    })
}

// Installation shares the serving head's open and activation, then closes the store
// before it sends proof. No publisher, triggers, or listener start for this launch.
fn operate_install[G: send, H: shareable + inert + send, S: send](placing: Placing[G, H], take p: PlaceConfig[G, H, S], take options: store.Options, selection: Selection, n_place: u64) -> Result[u64, StartError] waits {
    let PlaceConfig(backing: take backing, tasks: tasks, clock: clock, random: random, on_migrate: on_migrate, schema: schema, ..) = take p
    let persistent = persistent_backing(backing)
    let typed = match selection {
        InstallAt(_, _) => true,
        InstallFrom(_) => true,
        _ => false
    }
    if typed && !persistent {
        return Error(Missing("disk store"))
    }
    let expected = launch_env().store_id
    let mut opening = options
    if let Some((hi, lo)) = expected {
        opening.expect = Some(store.StoreId(hi, lo))
    }
    let (take db, take temporary) = open_backing(take backing, opening, tasks, clock, random) ?=> backing_start_error
    let mut opened = take db
    if let Some(id) = expected {
        let actual = store.identity_words(opened)
        if id != actual {
            let _ = close_store(take opened)
            return Error(Open(StoreMismatch(id, actual)))
        }
    }
    let installed: Result[u64, StartError] = match head_prepare(mut opened, selection, persistent, placing, on_migrate, schema, n_place, tasks) {
        Ok(_) => if persistent {
            match activation_version(opened) {
                Ok(version) => Ok(version),
                Error(take problem) => Error(Open(InstallUncertain(take problem)))
            }
        } else {
            Ok(0u64)
        },
        Error(take problem) => {
            let _ = close_store(take opened)
            return Error(Open(take problem))
        },
    }
    store.close(take opened) ?=> |problem| Open(InstallUncertain(problem))
    let _ = take temporary
    take installed
}

fn finish_install(take result: Result[u64, StartError]) -> Result[Ended, StartError] {
    // A failed durability barrier or close can leave the activation on disk.
    // Let a recovery open decide it if we reached the cut without proof.
    let reply: Option[HostReply] = match result {
        Error(Open(InstallUncertain(_))) => None,
        Ok(version) => Some(PlaceInstalled(version, false)),
        Error(problem) => Some(PlaceInstallRefused(match problem {
            Open(Store(Held)) => InstallHeld,
            Open(Store(Full(_))) => InstallCapacity,
            Full(_) => InstallCapacity,
            Open(Store(_)) => InstallStore,
            Open(Place(_)) => InstallPlace,
            Open(Migrate(_)) => InstallMigration,
            Open(NotCurrent(_)) => InstallCurrent,
            Open(IdentityUnknown) => InstallIdentity,
            Open(InstallVersion(next)) => InstallWrongVersion(next),
            Open(PredecessorChanged(found)) => InstallPredecessor(clone(found)),
            Open(Unsettled(_)) => InstallUnsettled,
            _ => InstallConfig,
        })),
    }
    if let Some(take value) = take reply {
        let codec: std.codec.Codec[HostReply] = std.codec.of()
        let mut answer: Bytes = list.with_capacity(16u64)
        let _ = std.codec.encode(codec, value, mut answer) ?=> |_| Missing("install answer")
        if !launch_emit(answer) {
            return Error(Missing("install answer"))
        }
    }
    match take result {
        Ok(_) => Ok(Unstarted),
        Error(take problem) => Error(take problem)
    }
}

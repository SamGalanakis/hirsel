// Laws of core.string (core/core/string.hirsel), each result derived by hand.
fn same(a: String, b: String) -> bool {
    a == b
}

// Each clone of "apple" needs eight bytes. The first call must release its
// temporary before the next statement can clone the same string.
// expect: run borrowed_clone_refunds() = true
fn borrowed_clone_refunds() -> bool {
    let text = string.from("apple")
    let trial = bound bytes 8 {
        let first = same(clone(text), "apple")
        let second = same(clone(text), "apple")
        first && second
    }
    result.unwrap(trial)
}

// Only a-z change; É (two bytes) and '-' are kept.
// expect: run upper_owned() = true
fn upper_owned() -> bool {
    let mut s = string.from("abc-Éz")
    string.make_ascii_upper(mut s)
    same(s, "ABC-ÉZ")
}

// The neighbours of a-z: '`' (0x60) and '{' (0x7B) stay, as do '@' and '['; 0xFF-range
// bytes of é are not shifted by the one-comparison test.
// expect: run upper_range_edges() = true
fn upper_range_edges() -> bool {
    let mut s = string.from("`az{@AZ[é")
    string.make_ascii_upper(mut s)
    same(s, "`AZ{@AZ[é")
}

// A literal is copied first.
// expect: run upper_static() = true
fn upper_static() -> bool {
    let mut s = "hello"
    string.make_ascii_upper(mut s)
    same(s, "HELLO")
}

// The neighbours of A-Z: '@' (0x40) and '[' (0x5B) stay, as do '`' and '{'; É's bytes
// C3 89 are not shifted.
// expect: run lower_range_edges() = true
fn lower_range_edges() -> bool {
    let mut s = string.from("@AZ[`az{É")
    string.make_ascii_lower(mut s)
    s == "@az[`az{É"
}

// The edge rows of upper_range_edges and lower_range_edges four times over (44 bytes), so
// each neighbour of a-z and A-Z falls in several lanes of a 16-byte vector and in the tail.
// expect: run case_edges_across_vectors() = true
fn case_edges_across_vectors() -> bool {
    let mut up = string.from("`az{@AZ[é`az{@AZ[é`az{@AZ[é`az{@AZ[é")
    string.make_ascii_upper(mut up)
    let mut low = string.from("@AZ[`az{É@AZ[`az{É@AZ[`az{É@AZ[`az{É")
    string.make_ascii_lower(mut low)
    same(up, string.from("`AZ{@AZ[é`AZ{@AZ[é`AZ{@AZ[é`AZ{@AZ[é")) && same(low, string.from("@az[`az{É@az[`az{É@az[`az{É@az[`az{É"))
}

// Under `bound bytes 0` the copy of the literal is refused: 8 bytes for "Abc".
// expect: run upper_static_refused() = 8
fn upper_static_refused() -> u64 {
    refused_request(isolate(fn() -> Result[(), Capacity] {
        bound bytes 0 {
            let mut s = "Abc"
            string.make_ascii_upper(mut s)
        }
    }))
}

// The primary cause of a caught failure, when it is a refused admission.
fn refusal[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

fn refused_request[R](r: Result[Result[R, Causes], Capacity]) -> u64 {
    match refusal(r) {
        Some(c) => c.requested,
        None => 99,
    }
}

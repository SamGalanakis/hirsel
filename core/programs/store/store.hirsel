fn journal_test_recorded_fork(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_recorded_fork(disk_test_directory(d), c, r, tasks) { Ok(()) } else { Error(()) }
}

fn journal_crash_options() -> Options {
    let mut options = defaults()
    options.checkpoint_task_bytes = 1048576
    options.resident_limit = 1048576
    options.pack_bytes = 512
    options.group_commits = 2
    options.group_bytes = 1048576
    options
}

fn journal_note(out: Stdout, head: u64) waits {
    let mut line = result.unwrap(string.with_capacity(32))
    result.unwrap(string.push(mut line, "ACK "))
    result.unwrap(string.push_u64(mut line, head))
    result.unwrap(stdout.write(out, line))
}

fn journal_is_poisoned[T](take response: Result[T, Error]) -> bool {
    match take response { Error(Poisoned(Other(125))) => true, _ => false }
}

type JournalPlace {
    rows: Table[u64, u64],
    out: Option[Stdout],
    requests: Receiver[u64],
    delivered: u64,
    committed: u64
}

fn journal_place_receive(db: Db, mut place: JournalPlace, wait: bool) -> Option[u64] waits {
    if wait {
        match channel.receive(place.requests) { Ok(key) => Some(key), Error(_) => None }
    } else {
        match channel.try_receive(place.requests) { Ok(key) => Some(key), Error(_) => None }
    }
}

fn journal_place_requests(count: u64) -> Receiver[u64] waits {
    let (send, requests): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(count))
    for key in 0u64 .. count { result.unwrap(channel.send(send, key)) }
    take requests
}

fn journal_place_put(mut tx: Tx, place: JournalPlace, key: u64) -> Result[u64, Error] {
    let value = key + 10
    put(mut tx, place.rows, key, value)?
    Ok(value)
}

fn journal_place_deliver(mut place: JournalPlace, take key: u64, take outcome: Result[Outcome[u64, Error], Error]) waits {
    if key != place.delivered { fail("place delivered out of order") }
    place.delivered += 1
    match take outcome {
        Ok(Committed(done)) => {
            if done.value != key + 10 { fail("place returned another request's value") }
            place.committed += 1
            if let Some(out) = place.out { journal_note(out, key + 2) }
        },
        Error(Poisoned(Other(125))) => {},
        _ => fail("unexpected place outcome")
    }
}

pub fn journal_law_place(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let options = journal_crash_options()
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    let table_ticket = result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    result.unwrap(durable(mut db, table_ticket))
    let rows = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let mut place = JournalPlace(rows: rows, out: None, requests: journal_place_requests(6), delivered: 0, committed: 0)
    result.unwrap(write_place(mut db, mut place, journal_place_receive, journal_place_put, journal_place_deliver))
    result.unwrap(close(take db))
    place.delivered == 6 && place.committed == 6
}

@test
fn journal_test_place(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_place(disk_test_directory(d), c, r, tasks) { Ok(()) } else { Error(()) }
}

fn journal_place_idle_turn(take signal: Receiver[()]) waits {
    result.unwrap(channel.receive(signal))
}

fn journal_place_idle(d: Dir, tasks: Tasks, mut db: Db, take rows: Table[u64, u64], out: Option[Stdout]) -> Result[bool, Error] waits {
    let mut place = JournalPlace(rows: take rows, out: out, requests: journal_place_requests(1), delivered: 0, committed: 0)
    write_place(mut db, mut place, journal_place_receive, journal_place_put, journal_place_deliver)?
    // Give the ready journal task a scheduler turn with its sender still open.
    let (wake, signal): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1))
    let turn = result.unwrap(task.spawn(tasks, bytes 4096, take signal, journal_place_idle_turn))
    result.unwrap(channel.send(wake, ()))
    result.unwrap(task.join(take turn))
    let boundary = disk_end(d, db.store, db.file_seq)?
    // HEADER (72) + empty COMMIT with DATA section (42) + the put's
    // overhead (9), table-prefixed u64 key (12), and schema-tagged row (10).
    Ok(place.delivered == 1 && place.committed == 1 && boundary == Some(145u64))
}

pub fn journal_law_place_idle(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = journal_crash_options()
    options.group_commits = 1
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    let commit_ticket = result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    result.unwrap(durable(mut db, commit_ticket))
    let rows = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let good = result.unwrap(journal_place_idle(d, tasks, mut db, take rows, None))
    result.unwrap(close(take db))
    good
}


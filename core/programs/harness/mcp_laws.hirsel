// Scripted MCP transport and blob-settlement law.
const MCP_BLOB_SIZE: u64 = 102400u64

fn mcp_peer(g: Grants, id: String) -> Option[mcp_tools.Peer] {
    let Some(f) = view g.blobs else {
        return None
    }
    let Some((at, network)) = f.peer else {
        return None
    }
    if id != "fixture" {
        return None
    }
    Some(mcp_tools.Peer(net: network, clock: f.clock, endpoint: mcp.client.Endpoint(address: at, authority: "127.0.0.1", target: "/mcp", origin: "http://127.0.0.1", security: Plain), identity: mcp.rpc.Identity(name: "harness-law", version: "1")))
}

fn mcp_blob_model(g: Grants, take r: harness.Request, mut draft: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let name = mcp_tools.offered_name("fixture", "echo")
    let mut offered = false
    for t in r.tools {
        if t.name == name {
            offered = true
        }
    }
    let mut answer = scripted_model(g, take r, mut draft)?
    if list.len(answer.calls) == 0u64 {
        return Ok(take answer)
    }
    if !offered {
        return Error(Rejected("missing MCP tool"))
    }
    answer.calls[0u64].name = take name
    Ok(take answer)
}

fn mcp_blob_agent() -> harness.Agent[Grants, ()] {
    let mut a = harness.agent("mcp-blob", "scripted", code.describe(mcp_blob_model), ())
    a.mcp_peer = Some(code.describe(mcp_peer))
    a.store_result = Some(code.describe(stage_blob))
    a
}

fn mcp_blob_wiring() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(mcp_blob_advance), code.describe(mcp_blob_effect))
}

fn mcp_blob_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    harness.advance_park(mut tx, h, mcp_blob_agent(), mcp_blob_wiring()?, take wake)
}

fn mcp_blob_effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    let Some(ctx) = view g.context else {
        fail("only an attempt's G reaches an effect; a bind's G has no trigger context")
    }
    harness.effect(ctx, g.handles, g, take key, mcp_blob_agent(), code.describe(mcp_blob_settle), None)
}

fn mcp_blob_settle(mut tx: store.Tx, h: harness.Handles, a: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let w = mcp_blob_wiring() ?=> |_| Missing("MCP blob wiring")
    harness.settle(mut tx, h, mcp_blob_agent(), w, a, take m)
}

fn mcp_blob_place(mut r: runner.Registry[Grants, harness.Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(mcp_blob_advance), code.describe(mcp_blob_effect), code.describe(mcp_blob_settle), harness.select_handles, BYTES, 8388608u64)?
    let views: std.codec.Codec[harness.View] = std.codec.of()
    runner.query_as(mut r, code.describe(harness.window), harness.window_slots()?, BYTES, runner.DEFAULT_STEPS)
}

fn seed_mcp_blob(dir: Dir, clock: Clock, random: Random, tasks: Tasks, caller: store.Caller) waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let h = result.unwrap(store.bind_declaration(mut db, Migrate, harness.declare_tables))
    update_catalog(mut db, OLD_SCHEMA)
    let w = result.unwrap(mcp_blob_wiring())
    let committed = result.unwrap(store.run(mut db, None, (store.copy_env(caller), store.copy_env(h), store.copy_env(w)), fn(mut tx, call_env) -> Result[(), harness.Refused] {
        harness.set_reader(mut tx, call_env.1, call_env.0, true)?
        harness.open_session(mut tx, call_env.1, "scripted", All)?
        let Placed(0u64) = harness.submit(mut tx, call_env.1, mcp_blob_agent(), call_env.2, call_env.0, NextTurn, harness.Submit(client_key: "mcp-blob", text: "echo"))? else {
            return Error(Conflict)
        }
        Ok(())
    }))
    let Committed(done) = take committed else {
        fail("seed MCP blob session")
    }
    result.unwrap(store.durable(mut db, done.ticket))
    result.unwrap(store.close(take db))
}

fn read_mcp_request(mut r: ReadHalf, until: Until) -> Result[(Bytes, std.http1.Head, mcp.rpc.Request), ()] waits {
    let mut input: Bytes = list.with_capacity(8192u64)
    let mut head = std.http1.head()
    let mut cursor = std.http1.cursor()
    loop {
        match std.http1.resume(input, mut head, mut cursor) {
            Complete => break,
            Partial => (),
            _ => return Error(()),
        }
        let room = 8192u64 - list.len(input)
        let Ok(size) = host.recv_bounded(mut r, mut input, room, until) else {
            return Error(())
        }
        if size == 0u64 {
            return Error(())
        }
    }
    let Ok(ContentLength(size)) = std.http.framing(input, view head, 8192u64 - head.end) else {
        return Error(())
    }
    while list.len(input) < head.end + size {
        let remaining = head.end + size - list.len(input)
        let Ok(got) = host.recv_bounded(mut r, mut input, remaining, until) else {
            return Error(())
        }
        if got == 0u64 {
            return Error(())
        }
    }
    let body = std.http.copy_bytes(list.slice(input, head.end, head.end + size))
    let Ok(text) = string.from_utf8(take body) else {
        return Error(())
    }
    let Ok(take request) = mcp.rpc.request(text) else {
        return Error(())
    }
    Ok((take input, take head, take request))
}

fn write_mcp_response(mut w: WriteHalf, head: Bytes, body: Bytes, until: Until) -> Result[(), NetError] waits {
    let boundary = list.len(head)
    let end = boundary + list.len(body)
    let mut sent = 0u64
    while sent < end {
        let prefix = list.slice(head, order.min(sent, boundary), boundary)
        let tail = list.slice(body, int.saturating_sub(sent, boundary), list.len(body))
        let n = host.send_pair(mut w, prefix, tail, until)?
        if n == 0u64 {
            return Error(Reset)
        }
        sent += n
    }
    Ok(())
}

fn mcp_header(wire: Bytes, h: std.http1.Head, name: Bytes) -> Option[Bytes] {
    for i in 0u64 .. h.count {
        let field = h.fields[i]
        if std.http1.equal_ascii(list.slice(wire, field.name.start, field.name.end), name) {
            return Some(std.http.copy_bytes(list.slice(wire, field.value.start, field.value.end)))
        }
    }
    None
}

fn mcp_response(mut w: WriteHalf, until: Until, status: String, fields: String, body: Bytes) -> Result[(), NetError] waits {
    let mut head = string.from("HTTP/1.1 ")
    string.push(mut head, status)
    string.push(mut head, "\r\nConnection: close\r\n")
    string.push(mut head, fields)
    string.push(mut head, "Content-Length: ")
    string.push_u64(mut head, list.len(body))
    string.push(mut head, "\r\n\r\n")
    write_mcp_response(mut w, string.as_bytes(head), body, until)
}

fn mcp_exchange(mut listener: Listener, until: Until, method: String, version: Option[Bytes], sid: Option[Bytes], cursor: Option[String], status: String, headers: String, payload: String) waits {
    let (take conn, _) = result.unwrap(host.accept(mut listener, until))
    let (take input, take output) = net.split(take conn)
    let mut r = take input
    let mut w = take output
    let (wire, head, take request) = result.unwrap(read_mcp_request(mut r, until))
    let mcp.rpc.Request(id: take id, method: take received, params: take params) = take request
    if received != method || mcp_header(wire, head, b"mcp-protocol-version") != version || mcp_header(wire, head, b"mcp-session-id") != sid || mcp.rpc.field_text(params, "cursor") != cursor {
        fail("unexpected MCP method, session headers or cursor")
    }
    let body = if payload == "" {
        if method == "notifications/initialized" {
            if let Some(_) = id {
                fail("initialized has an id")
            }
        }
        string.new()
    } else {
        let response_id = option.unwrap(take id)
        mcp.rpc.encode_result(response_id, result.unwrap(mcp.rpc.object(payload)))
    }
    result.unwrap(mcp_response(mut w, until, status, headers, string.as_bytes(body)))
}

const MCP_JSON: String = "Content-Type: application/json\r\n"

fn legacy_handshake(mut listener: Listener, until: Until, sid: String) waits {
    mcp_exchange(mut listener, until, "server/discover", Some(b"2026-07-28"), None, None, "400 Bad Request", "", "")
    let mut header = string.from("Content-Type: application/json\r\nMcp-Session-Id: ")
    string.push(mut header, sid)
    string.push(mut header, "\r\n")
    mcp_exchange(mut listener, until, "initialize", None, None, None, "200 OK", header, "{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"fixture\",\"version\":\"1\"}}")
    mcp_exchange(mut listener, until, "notifications/initialized", Some(b"2025-06-18"), Some(string.into_bytes(string.from(sid))), None, "202 Accepted", "", "")
}

type LegacyMcp: send {
    listener: Listener,
    clock: Clock,
    deadline: u64
}

fn serve_legacy_mcp(take job: LegacyMcp) waits {
    let LegacyMcp(listener: take socket, clock, deadline) = take job
    let mut listener = take socket
    let until = At(clock, deadline)
    legacy_handshake(mut listener, until, "first")
    mcp_exchange(mut listener, until, "tools/list", Some(b"2025-06-18"), Some(b"first"), None, "200 OK", MCP_JSON, "{\"nextCursor\":\"expired\",\"tools\":[{\"name\":\"stale\",\"inputSchema\":{\"type\":\"object\"}}]}")
    mcp_exchange(mut listener, until, "tools/list", Some(b"2025-06-18"), Some(b"first"), Some("expired"), "404 Not Found", "", "")
    legacy_handshake(mut listener, until, "renewed")
    mcp_exchange(mut listener, until, "tools/list", Some(b"2025-06-18"), Some(b"renewed"), None, "200 OK", MCP_JSON, "{\"nextCursor\":\"page-two\",\"tools\":[{\"name\":\"echo\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"bad\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"q\":{\"type\":\"number\",\"x-mcp-header\":\"Q\"}}}}]}")
    mcp_exchange(mut listener, until, "tools/list", Some(b"2025-06-18"), Some(b"renewed"), Some("page-two"), "200 OK", MCP_JSON, "{\"tools\":[{\"name\":\"other\",\"inputSchema\":{\"type\":\"object\"}}]}")
    for sid in["expiring", "expired-again"] {
        legacy_handshake(mut listener, until, sid)
        mcp_exchange(mut listener, until, "tools/list", Some(b"2025-06-18"), Some(string.into_bytes(string.from(sid))), None, "404 Not Found", "", "")
    }
}

@test
fn test_mcp_legacy_session_discovery(network: Net, clock: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let (take listener, address) = result.unwrap(host.listen(network, Addr(ip: V4(0x7f000001u32), port: 0u16), 4u16))
    let deadline = host.mono_ns(clock) + 5000000000u64
    let serving = task.spawn(tasks, bytes 262144u64, LegacyMcp(listener: take listener, clock, deadline), serve_legacy_mcp)
    let peer = mcp_tools.Peer(net: network, clock, endpoint: mcp.client.Endpoint(address, authority: "127.0.0.1", target: "/mcp", origin: "http://127.0.0.1", security: Plain), identity: mcp.rpc.Identity(name: "harness-law", version: "1"))
    let mut listing = result.unwrap(mcp_tools.discover(peer, "fixture", mcp_tools.REPLY_LIMIT, deadline))
    let twice_expired = mcp_tools.discover(peer, "fixture", mcp_tools.REPLY_LIMIT, deadline)
    result.unwrap(task.join(take serving))
    let Error(Refused(why)) = twice_expired else {
        fail("the second session expiration was not reported")
    }
    if why != "MCP session expired" {
        fail("the session expiration lost its reason")
    }
    {
        let refused = mcp_tools.rejected(listing)
        if list.len(refused) != 1u64 || refused[0u64].tool != Some("bad") || refused[0u64].field != "inputSchema.properties.q.x-mcp-header" {
            fail("malformed tool name and field were not reported")
        }
    }
    if !mcp_tools.defer(mut listing, "echo") || !mcp_tools.defer(mut listing, "other") || mcp_tools.defer(mut listing, "stale") || mcp_tools.defer(mut listing, "bad") {
        fail("listing did not contain exactly the accepted tools from the renewed session")
    }
    Ok(())
}

fn mcp_status(at: Addr, credential: Bytes, clock: Clock, random: Random, tasks: Tasks, net: Net, socket: std.wsock.Config) -> bool waits {
    let keys = result.unwrap(runner.fixture.entry_keys(code.describe(mcp_blob_place)))
    let mut client = result.unwrap(runner.fixture.client_at(tasks, net, clock, random, keys, socket, at, Some(clone(credential)), None, 3000u64))
    let codec: std.codec.Codec[harness.View] = std.codec.of()
    let entry = runner.fixture.query_as_entry(code.describe(harness.window), result.unwrap(harness.window_slots()))
    let sub = result.unwrap(runner.fixture.subscribe(mut client, entry, Status, 3000u64))
    let image = result.unwrap(runner.fixture.seen_at(mut client, sub, 0u64, 3000u64))
    runner.fixture.close(take client)
    for row in image.rows {
        if let Some(raw) = row.value {
            if let Ok(Status(status)) = std.codec.decode(codec, raw) {
                return status == "calling tools"
            }
        }
    }
    false
}

// Hold a real local tools/call response until the live query has inspected
// status, then send exactly 100 KiB of text and recover the stored result.
@test
fn test_mcp_working_and_blob(parent: Dir, clock: Clock, random: Random, tasks: Tasks, network: Net, seed_grant: Env) -> Result[(), u64] waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let credential = runner.ingress.credential(random)
    seed_mcp_blob(dir, clock, random, tasks, result.unwrap(runner.ingress.caller((), credential)).caller)
    let (take input, at) = result.unwrap(host.listen(network, Addr(ip: V4(0x7f000001u32), port: 0u16), 1u16))
    let mut listener = take input
    let seed = match std.sim.world.test_seed(seed_grant) {
        Some(n) => n,
        None => 7u64
    }
    let (take blobs, server) = blob_fixture(tasks, clock, random, MCP_BLOB_SIZE, seed)
    let mut fixture = take blobs
    fixture.peer = Some((at, network))
    let (world, _) = std.sim.world.new(2u64, 0u64, 0u64)
    let (done, finishing): (Sender[()], Receiver[()]) = channel.new(1u64)
    let keeper = task.spawn(tasks, bytes 65536u64, KeepServer(world: take world, real: clock, stop: take finishing), keep_blob_server)
    let (model, inbox): (Sender[ModelAsk], Receiver[ModelAsk]) = channel.new(1u64)
    let models = task.spawn(tasks, bytes 65536u64, take inbox, model_service)
    let (tool, _tools): (Sender[ToolAsk], Receiver[ToolAsk]) = channel.new(1u64)
    let services = Services(model: take model, tool: take tool, blobs: Some(copy_blob_fixture(fixture)))
    let w = result.unwrap(mcp_blob_wiring())
    let config = wired_settings_of(code.describe(mcp_blob_place), harness.entries(w), dir, clock, random, tasks, network, take services, Some(IDLE_MS))
    let socket = runner.wire_defaults(65536u64).socket
    let (running, _stop, status) = launch(tasks, take config)
    mcp_exchange(mut listener, Never, "server/discover", Some(b"2026-07-28"), None, None, "200 OK", MCP_JSON, "{\"supportedVersions\":[\"2026-07-28\"],\"capabilities\":{\"tools\":{}}}")
    let (take conn, _) = result.unwrap(host.accept(mut listener, Never))
    let (take reader, take output) = net.split(take conn)
    let mut r = take reader
    let mut writer = take output
    let Ok((_, _, request)) = read_mcp_request(mut r, Never) else {
        return Error(1u64)
    }
    if request.method != "tools/call" || mcp.rpc.field_text(request.params, "name") != Some("echo") {
        return Error(1u64)
    }
    let Some(address) = latest.read(status).addr else {
        return Error(2u64)
    }
    let working = mcp_status(address, credential, clock, random, tasks, network, socket)
    let mut body = string.into_bytes("{\"jsonrpc\":\"2.0\",\"id\":\"call\",\"result\":{\"resultType\":\"complete\",\"content\":[{\"type\":\"text\",\"text\":\"")
    list.append(mut body, blob_bytes(MCP_BLOB_SIZE))
    list.append(mut body, b"\"}]}}")
    let sent = mcp_response(mut writer, Never, "200 OK", MCP_JSON, body)
    drop(take writer)
    drop(take r)
    let _ = result.unwrap(result.unwrap(task.join(take running)))
    result.unwrap(task.join(take models))
    let reference = option.unwrap(stored_blob(dir, clock, random, tasks, false))
    let matched = if reference.len == MCP_BLOB_SIZE && reference.mime == BLOB_MIME {
        let mut client = result.unwrap(blob_client(fixture))
        let deadline = std.object.deadline_after_ms(client, 1000u64)
        let retrieved = harness.read_blob(mut client, reference, MCP_BLOB_SIZE, deadline)
        result.unwrap(take retrieved) == blob_bytes(MCP_BLOB_SIZE)
    } else {
        false
    }
    drop(take fixture)
    result.unwrap(channel.send(done, ()))
    result.unwrap(task.join(take keeper))
    let report = result.unwrap(task.join(take server))
    result.unwrap(std.dir.remove_all(parent, name))
    if !working {
        return Error(3u64)
    }
    if let Error(_) = sent {
        return Error(4u64)
    }
    if !matched || report.writes != 1u64 {
        return Error(5u64)
    }
    Ok(())
}

fn admission_catalog(mut db: store.Db, h: harness.Handles) waits {
    let mut pages: List[String] = list.new()
    list.push(mut pages, "{\"tools\":[{\"name\":\"echo\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"alpha\",\"description\":\"audit audit trail\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"beta\",\"description\":\"audit trail notes\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"gamma\",\"description\":\"weather\",\"inputSchema\":{\"type\":\"object\"}}]}")
    let mut listing = result.unwrap(mcp_tools.listing("fixture", pages))
    for name in["alpha", "beta", "gamma"] {
        if !mcp_tools.defer(mut listing, name) {
            fail("missing fixture tool")
        }
    }
    let changed = store.run(mut db, None, (store.copy_env(h), store.copy_env(listing)), fn(mut tx, call_env) -> Result[(), store.Error] {
        mcp_tools.replace(mut tx, call_env.0 .mcp_catalog, call_env.1)
    })
    match take changed {
        Ok(Committed(_)) => (),
        _ => fail("admission catalog fixture")
    }
}

fn admission_answer(mut db: store.Db, h: harness.Handles, a: harness.Agent[Grants, ()], round: u64, hidden: Option[String]) waits {
    let saved = store.run(mut db, None, (store.copy_env(h), store.copy_env(hidden), store.copy_env(round)), fn(mut tx, call_env) -> Result[(), store.Error] {
        let key = harness.EffectKey(run: 0u64, round: call_env.2, kind: harness.MODEL, ordinal: 0u64)
        let mut e = option.unwrap(store.fetch(tx, call_env.0 .effects, key)?)
        let mut s = option.unwrap(store.fetch(tx, call_env.0 .session, 0u64)?)
        let mut r = option.unwrap(store.fetch(tx, call_env.0 .runs, 0u64)?)
        let mut calls: List[harness.Call] = list.new()
        list.push(mut calls, harness.Call(id: "search", name: "tool_search", args: Inline(string.into_bytes("{\"query\":\"audit\"}"))))
        if let Some(name) = call_env.1 {
            list.push(mut calls, harness.Call(id: "unseen", name: clone(name), args: Inline(string.into_bytes("{}"))))
        }
        let answer = harness.Answer(text: "", calls: take calls, stop: "tool_use", usage: usage())
        store.put(mut tx, call_env.0 .entries, s.next_pos, Assistant(clone(answer)))?
        s.next_pos += 1u64
        e.phase = Settled(Model(take answer))
        r.phase = AnswerReady(call_env.2, 0u64)
        store.put(mut tx, call_env.0 .effects, key, e)?
        store.put(mut tx, call_env.0 .session, 0u64, s)?
        store.put(mut tx, call_env.0 .runs, 0u64, r)
    })
    match take saved {
        Ok(Committed(_)) => (),
        _ => fail("admission answer fixture")
    }
    kick(mut db, a)
    kick(mut db, a)
}

fn admission_entry(read_handle: store.Reader, snap: store.Snapshot, h: harness.Handles, pos: u64) -> harness.Entry waits {
    option.unwrap(result.unwrap(store.get(read_handle, snap, h.entries, pos)))
}

fn admission_bytes(entry: harness.Entry) -> Bytes {
    let codec: std.codec.Codec[harness.Entry] = std.codec.of()
    let mut raw: Bytes = list.new()
    result.unwrap(std.codec.encode(codec, entry, mut raw))
    take raw
}

@test
fn test_wave2_catalog_admission_prefix(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), u64] waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let mut db = fresh(dir, clock, random, tasks)
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let mut a = sectioned(false)
    a.mcp_peer = Some(code.describe(unused_peer))
    admission_catalog(mut db, h)
    let first = prepared(mut db, a, 0u64, shows3(Show("instructions"), Hidden, Hidden), false)
    let echo = mcp_tools.offered_name("fixture", "echo")
    let alpha = mcp_tools.offered_name("fixture", "alpha")
    let beta = mcp_tools.offered_name("fixture", "beta")
    if list.len(first.tools) != 3u64 || first.tools[1u64].name != "tool_search" || first.tools[2u64].name != echo {
        return Error(1u64)
    }
    let before = store.snapshot(db)
    let key = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
    let old = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), before, h.effects, key)))
    let provider_model = provider.Model(dialect: OpenAi, name: "scripted", max_tokens: 128u64, cache_control: Off)
    let body = result.unwrap(provider.body(provider_model, result.unwrap(harness.request(result.unwrap(store.reader(db, 0u64)), before, h, key, old))))
    admission_answer(mut db, h, a, 0u64, Some(clone(alpha)))
    let after = store.snapshot(db)
    let replay = result.unwrap(provider.body(provider_model, result.unwrap(harness.request(result.unwrap(store.reader(db, 0u64)), after, h, key, old))))
    if replay != body {
        return Error(2u64)
    }
    for i in 0u64 .. 2u64 {
        if admission_bytes(admission_entry(result.unwrap(store.reader(db, 0u64)), before, h, i)) != admission_bytes(admission_entry(result.unwrap(store.reader(db, 0u64)), after, h, i)) {
            return Error(3u64)
        }
    }
    let ToolResult(search_id, Returned(Inline(output)), _) = admission_entry(result.unwrap(store.reader(db, 0u64)), after, h, 3u64) else {
        return Error(4u64)
    }
    if search_id != "search" {
        return Error(4u64)
    }
    // The two equally long descriptions have audit frequencies 2 and 1.
    // Their BM25 weights and length norms agree, so alpha sorts before beta.
    let expected = texts3(alpha, beta, "", 2u64)
    if output != string.into_bytes(mcp.rpc.typed_json(expected)) {
        return Error(5u64)
    }
    let ToolResult(unseen_id, Gone, _) = admission_entry(result.unwrap(store.reader(db, 0u64)), after, h, 4u64) else {
        return Error(6u64)
    }
    if unseen_id != "unseen" {
        return Error(6u64)
    }
    let System(patch) = admission_entry(result.unwrap(store.reader(db, 0u64)), after, h, 5u64) else {
        return Error(7u64)
    }
    let Some(defs) = view patch.tools else {
        return Error(8u64)
    }
    if patch.baseline || list.len(patch.changes) != 0u64 || list.len(defs) != 5u64 || defs[3u64].name != alpha || defs[4u64].name != beta {
        return Error(9u64)
    }
    let next_key = harness.EffectKey(run: 0u64, round: 1u64, kind: harness.MODEL, ordinal: 0u64)
    let next = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), after, h.effects, next_key)))
    let request = result.unwrap(harness.request(result.unwrap(store.reader(db, 0u64)), after, h, next_key, next))
    if next.cutoff.tail_pos != 5u64 || next.cutoff.tools_pos != Some(5u64) || request.system != first.system {
        return Error(10u64)
    }
    admission_answer(mut db, h, a, 1u64, None)
    let again = store.snapshot(db)
    let s = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), again, h.session, 0u64)))
    if s.admitted != expected || s.next_pos != 8u64 || s.active_tools_pos != Some(5u64) {
        return Error(11u64)
    }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    Ok(())
}

fn reconcile_model(g: Grants, take r: harness.Request, mut draft: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let mut answer = scripted_model(g, take r, mut draft)?
    if list.len(answer.calls) != 0u64 {
        for id in["c2", "c3"] {
            list.push(mut answer.calls, harness.Call(id: clone(id), name: "bump", args: Inline(string.into_bytes("{}"))))
        }
    }
    Ok(take answer)
}

fn other_receipt(key: harness.EffectKey) -> harness.Settle {
    harness.Settle(key: key, receipt: Some(Tool(Failed("competing result"))))
}

fn competing_settle(ctx: runner.TriggerContext, key: harness.EffectKey) -> bool waits {
    let arg: std.codec.Codec[harness.Settle] = std.codec.of()
    let reply: std.codec.Codec[harness.Filed] = std.codec.of()
    let Ok(take entry) = runner.attempt_key(code.describe(reconcile_settle), arg, reply) else {
        return false
    }
    let mut input: Bytes = list.new()
    if let Error(_) = std.codec.encode(arg, other_receipt(key), mut input) {
        return false
    }
    let Ok(Returned(raw)) = runner.trigger_call(ctx, take entry, take input) else {
        return false
    }
    match std.codec.decode(reply, raw) {
        Ok(Ignored) => true,
        _ => false
    }
}

fn reconcile_bump(g: Grants, key: harness.EffectKey) -> Result[Option[Bytes], harness.Fault] waits {
    if key.run != 0u64 || key.round != 0u64 || key.kind != harness.TOOL {
        fail("unexpected reconciliation key")
    }
    match key.ordinal {
        0u64 => Ok(Some(string.into_bytes("recovered"))),
        1u64 => {
            let target = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.TOOL, ordinal: 0u64)
            let Some(ctx) = view g.context else {
                fail("only an attempt's G reaches an effect; a bind's G has no trigger context")
            }
            if !competing_settle(ctx, target) {
                return Error(Refused("the other worker's settle was not ignored"))
            }
            Ok(None)
        },
        _ => Error(Unavailable),
    }
}

fn reconcile_agent() -> harness.Agent[Grants, ()] {
    let mut a = harness.agent("reconcile", "scripted", code.describe(reconcile_model), ())
    list.push(mut a.tools, harness.Tool(name: "bump", about: "adds one", input: "{}", rev: 1u64, repair: None, run: Outside(code.describe(bump), Once, Some(code.describe(reconcile_bump)))))
    take a
}

fn reconcile_wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(reconcile_advance), code.describe(reconcile_effect))
}

fn reconcile_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    harness.advance_park(mut tx, h, reconcile_agent(), reconcile_wired()?, take wake)
}

fn reconcile_effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    let Some(ctx) = view g.context else {
        fail("only an attempt's G reaches an effect; a bind's G has no trigger context")
    }
    harness.effect(ctx, g.handles, g, take key, reconcile_agent(), code.describe(reconcile_settle), None)
}

fn reconcile_settle(mut tx: store.Tx, h: harness.Handles, attempt: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let w = reconcile_wired() ?=> |_| Missing("reconciliation wiring")
    let a = reconcile_agent()
    let key = m.key
    let filed = harness.settle(mut tx, h, a, w, attempt, take m)?
    if key.kind == harness.TOOL {
        if let Recorded = filed {
            let Ignored = harness.settle(mut tx, h, a, w, attempt, other_receipt(key))? else {
                return Error(Missing("duplicate settle was recorded"))
            }
        }
    }
    Ok(filed)
}

fn reconcile_place(mut r: runner.Registry[Grants, harness.Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(reconcile_advance), code.describe(reconcile_effect), code.describe(reconcile_settle), harness.select_handles, BYTES, BYTES)
}

@test
fn test_wave2_catalog_reconcile_outside_crash(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, seed_grant: Env) -> Result[(), u64] waits {
    let seed = std.sim.world.test_seed(seed_grant)
    let (dir, take first_disk, take name): (Dir, Option[Task[(std.sim.fs.Fs, std.sim.world.Plan)]], Option[String]) = match seed {
        Some(n) => {
            let (d, take serving) = mount(tasks, clock, std.sim.fs.new(), std.sim.world.plan(n))
            (d, Some(take serving), None)
        },
        None => {
            let mut scratch = string.with_capacity(32u64)
            let d = result.unwrap(host.mkdtemp(parent, mut scratch))
            (d, None, Some(take scratch))
        },
    }
    let w = result.unwrap(reconcile_wired())
    seed_with(dir, clock, random, tasks, reconcile_agent(), w)
    let (model, model_in): (Sender[ModelAsk], Receiver[ModelAsk]) = channel.new(4u64)
    let (tool, tool_in): (Sender[ToolAsk], Receiver[ToolAsk]) = channel.new(4u64)
    let (seen, saw): (Sender[()], Receiver[()]) = channel.new(3u64)
    let models = task.spawn(tasks, bytes 65536u64, take model_in, model_service)
    let tools = task.spawn(tasks, bytes 65536u64, ToolSeed(inbox: take tool_in, seen: take seen, hold: 3u64), tool_service)
    let services = Services(model: take model, tool: take tool, blobs: None)
    let (first, stop, _) = launch(tasks, settings_of(code.describe(reconcile_place), harness.entries(w), dir, clock, random, tasks, net, copy_services(services), None))
    for _ in 0u64 .. 3u64 {
        result.unwrap(channel.receive(saw))
    }
    result.unwrap(channel.send(stop, ()))
    let _ = result.unwrap(result.unwrap(task.join(take first)))
    let (reopened, take second_disk): (Dir, Option[Task[(std.sim.fs.Fs, std.sim.world.Plan)]]) = match take first_disk {
        None => (dir, None),
        Some(take serving) => {
            let (take image, _) = unmount(take dir, take serving)
            let mut crashed = take image
            let mut plan = std.sim.world.plan(option.unwrap(seed))
            std.sim.fs.crash(mut crashed, mut plan)
            let (d, take replay) = mount(tasks, clock, take crashed, take plan)
            (d, Some(take replay))
        },
    }
    let (second, _stop, _) = launch(tasks, settings_of(code.describe(reconcile_place), harness.entries(w), reopened, clock, random, tasks, net, copy_services(services), Some(IDLE_MS)))
    let _ = result.unwrap(result.unwrap(task.join(take second)))
    let asked = model_asked(services)
    let dispatched = tool_ran(services)
    let mut db = result.unwrap(store.open(tasks, reopened, clock, random, runner.triggers.law_options()))
    let snap = store.snapshot(db)
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let s = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.session, 0u64)))
    let run = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.runs, 0u64)))
    let finished = match run.phase {
        Finished(Answered) => true,
        _ => false
    }
    let mut verified = 0u64
    for ordinal in 0u64 .. 3u64 {
        let key = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.TOOL, ordinal: ordinal)
        let row = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.effects, key)))
        let entry = result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.entries, 3u64 + ordinal))
        let matched = match (ordinal, view row.phase, take entry) {
            (0u64, Settled(Tool(Returned(Inline(a)))), Some(ToolResult(id, Returned(Inline(b)), _))) => id == "c1" && a == string.into_bytes("recovered") && a == b,
            (1u64, Settled(Tool(Failed(a))), Some(ToolResult(id, Failed(b), _))) => id == "c2" && a == "not dispatched" && a == b,
            (2u64, Settled(Tool(InDoubt)), Some(ToolResult(id, InDoubt, _))) => id == "c3",
            _ => false,
        }
        if matched && row.dispatches == 1u64 {
            verified += 1u64
        }
    }
    result.unwrap(store.close(take db))
    drop(take services)
    result.unwrap(task.join(take models))
    result.unwrap(task.join(take tools))
    if let Some(take serving) = take second_disk {
        let _ = unmount(take reopened, take serving)
    }
    if let Some(take scratch) = take name {
        result.unwrap(std.dir.remove_all(parent, scratch))
    }
    if asked != 2u64 || dispatched != 3u64 {
        return Error(1u64)
    }
    if verified != 3u64 {
        return Error(2u64)
    }
    if !finished || s.next_pos != 7u64 {
        return Error(3u64)
    }
    Ok(())
}

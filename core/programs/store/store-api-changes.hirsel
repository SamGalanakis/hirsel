type ChangeOutput = read.ChangeOutput[Change, Trimmed]

fn change_row(take key: Bytes, take value: Option[Arc[Bytes]]) -> Change {
    Change(tree_key: take key, value: take value)
}

fn trimmed_span(take lo: Bytes, take hi: Bytes) -> Trimmed {
    Trimmed(lo: take lo, hi: take hi)
}

fn change_output(limits: Option[Limits]) -> ChangeOutput {
    let page = match limits {
        Some(l) => Some((l.rows, l.byte_limit)),
        None => None,
    }
    read.change_output(page, change_row, trimmed_span)
}

fn admit_change(mut out: ChangeOutput, key: Bytes, width: u64) -> Result[bool, Error] {
    failure_result_from_rep(read.admit_change(mut out, key, width))
}

fn walk_page_changes(mut out: ChangeOutput, before: Option[View[pages.PageTree]], after: pages.PageTree, low: Option[Bytes], high: Option[Bytes]) -> Result[(), Error] {
    failure_result_from_rep(read.walk_page_changes(mut out, before, after, low, high))
}

fn page_change_rows(mut out: ChangeOutput, id: u32, mut left: std.page_walk.Walk, mut right: std.page_walk.Walk, high: Option[Bytes]) -> Result[bool, Error] {
    failure_result_from_rep(read.page_change_rows(mut out, id, mut left, mut right, high))
}

fn changes_from_output(take out: ChangeOutput) -> Changes {
    let read.ChangeOutput(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds, ..) = take out
    Changes(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds)
}

fn compare_page_collections(before: pages.PageTree, after: pages.PageTree) -> Result[Changes, Error] {
    let out = failure_result_from_rep(read.compare_page_collections(before, after, change_row, trimmed_span))?
    Ok(changes_from_output(take out))
}

fn catch_up_compare_collections(before: pages.PageTree, after: pages.PageTree, skip_ids: List[u32]) -> Result[(Changes, List[pager.TieredRowDiff]), Error] {
    let (take out, take deferred) = failure_result_from_rep(read.catch_up_compare_collections(before, after, skip_ids, change_row, trimmed_span))?
    Ok((changes_from_output(take out), take deferred))
}

pub type Trimmed {
    lo: Bytes,
    hi: Bytes
}

pub type Changes {
    rows: List[Change],
    trimmed: List[Trimmed],
    bounds: List[Bytes]
}

pub type ChangePage {
    changes: List[Change],
    trimmed: List[Trimmed],
    bounds: List[Bytes],
    next: Option[Bytes]
}

pub fn changes_page(r: Reader, a: Option[Snapshot], b: Snapshot, lo: Bytes, hi: Bytes, l: Limits) -> Result[ChangePage, Error] waits {
    read_access(r, b)?
    if let Some(before) = a {
        read_access(r, before)?
    }
    page_limits(l)?
    if let Some(base) = a {
        if !types.same(base.store.hi, base.store.lo, b.store.hi, b.store.lo) || base.open != b.open {
            return Error(Foreign)
        }
        if snapshot_paged(base) || snapshot_paged(b) {
            let out = tiered_changes(r, base, b, Some(clone(lo)), Some(clone(hi)), Some(l))?
            let read.ChangeOutput(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds, next: take resume, ..) = take out
            return Ok(ChangePage(changes: take rows, trimmed: take trimmed, bounds: take changed_bounds, next: take resume))
        }
    } else if lo < hi {
        if let Some(inventory) = view b.roots.collections.paging {
            return snapshot_tiered_initial_changes(r, b, inventory, lo, hi, l)
        }
    }
    disk_allocation(scoped fn() -> Result[ChangePage, Error] {
        let mut out = change_output(Some(l))
        if lo < hi {
            let low: Option[Bytes] = Some(clone(lo))
            let high: Option[Bytes] = Some(clone(hi))
            match a {
                None => walk_page_changes(mut out, None, b.roots.collections, low, high)?,
                Some(base) => walk_page_changes(mut out, Some(view base.roots.collections), b.roots.collections, low, high)?,
            }
        }
        let read.ChangeOutput(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds, next: take resume, ..) = take out
        Ok(ChangePage(changes: take rows, trimmed: take trimmed, bounds: take changed_bounds, next: take resume))
    })
}

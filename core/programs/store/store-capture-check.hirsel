// §15.6 offline verification over a capture that owns LOCK.
pub type CheckTotals: key + send {
    scrubbed: u64,
    pages: u64,
    journal: u64,
    faults: u64,
    repeats: u64
}

pub type CheckError: send = CheckStore(Error) | CheckBudget(Capacity) | CheckRepeats(Capacity)

fn check_blob(mut walk: capture.CheckWalk, reference: std.page.BlobRef, class: u8) -> Result[(), Error] waits {
    let path = failure_result_from_rep(manifest.paged_pack_path(reference.pack))?
    if reference.len > manifest.BLOB_LIMIT - 8 {
        return Error(failure_from_rep(format.disk_fault(path, reference.offset, Malformed)))
    }
    let ptr = std.page.PagePtr(pack: reference.pack, offset: reference.offset, len: int.truncate(8 + reference.len), checksum: reference.checksum, stamp: reference.stamp)
    let slot = failure_result_from_rep(capture.check_pack_slot(walk.packs, path, ptr, class, walk.next_stamp))?
    if class == 4 {
        let pack = walk.packs[slot]
        let index_at = pack.payload_bytes
        let width: u64 = int.widen(ptr.len)
        if ptr.offset >= index_at || 16 + width > index_at - ptr.offset {
            return Error(failure_from_rep(format.disk_fault(path, ptr.offset, Malformed)))
        }
        failure_result_from_rep(pager.check_cold_pack_index_row(walk.dir, walk.id, path, ptr.pack, 4, index_at, pack.size, walk.next_stamp, format.tiered_frame_id(TieredBlob(reference))))?
    }
    let location = 4 * (walk.packs[slot].base + ptr.offset) + 3
    let opened = failure_result_from_rep(capture.check_open_pack(walk.dir, path))?
    let mut input = failure_result_from_rep(journal.journal_input(take opened, false))?
    failure_result_from_rep(capture.check_at_head(mut input, mut walk.packs[slot], path, ptr))?
    let mut scanned = manifest.pack_scan_indexed(class, walk.next_stamp, walk.packs[slot].payload_bytes)
    let mut spent = 0u64
    let ctx = format.DiskContext(store: walk.id, role: 3, seq: ptr.pack)
    let frame = failure_result_from_rep(manifest.read_pack_frame(mut input, path, ctx, mut scanned, ptr.offset, true, mut spent))?
    if frame.stamp != Some(ptr.stamp) || frame.size != int.widen(ptr.len) || frame.checksum != ptr.checksum {
        return Error(failure_from_rep(format.disk_fault(path, ptr.offset, Checksum)))
    }
    let _ = failure_result_from_rep(capture.check_arrive(mut walk, path, ptr, location))?
    Ok(())
}

fn check_page(mut walk: capture.CheckWalk, ptr: std.page.PagePtr, class: u8, domain: std.page.Domain, expected_level: Option[u8]) -> Result[(), Error] waits {
    if ptr.stamp == 0 {
        return Ok(())
    }
    let path = failure_result_from_rep(manifest.paged_pack_path(ptr.pack))?
    let slot = failure_result_from_rep(capture.check_pack_slot(walk.packs, path, ptr, class, walk.next_stamp))?
    if class == 3 {
        let pack = walk.packs[slot]
        let index_at = pack.payload_bytes
        let width: u64 = int.widen(ptr.len)
        if ptr.offset >= index_at || 16 + width > index_at - ptr.offset {
            return Error(failure_from_rep(format.disk_fault(path, ptr.offset, Malformed)))
        }
        failure_result_from_rep(pager.check_cold_pack_index_row(walk.dir, walk.id, path, ptr.pack, 3, index_at, pack.size, walk.next_stamp, format.tiered_frame_id(TieredPage(ptr))))?
    }
    let tag = match domain {
        Collection => 0u64,
        CollectionMap => 1u64,
        Unprefixed => 2u64
    }
    let location = 4 * (walk.packs[slot].base + ptr.offset) + tag
    let allow_tiered = domain == CollectionMap
    let image = {
        let file = failure_result_from_rep(capture.check_open_pack(walk.dir, path))?
        let mut input = failure_result_from_rep(journal.journal_input(take file, false))?
        failure_result_from_rep(capture.check_at_head(mut input, mut walk.packs[slot], path, ptr))?
        format.with_journal_file(mut input, scoped fn(mut opened: HostFile) -> Result[std.page.Image, Error] waits {
            failure_result_from_rep(capture.capture_read_page_mode(mut opened, path, walk.id, ptr, domain, expected_level, allow_tiered))
        })?
    }
    if !failure_result_from_rep(capture.check_arrive(mut walk, path, ptr, location))? {
        return Ok(())
    }
    walk.visits.pages += 1
    let height = std.page.level(image)
    let blob_class = if class == 3 {
        4u8
    } else {
        1u8
    }
    for i in 0u64 .. std.page.count(image) {
        match std.page.owning_edge(image, i) {
            Some(PageEdge(child)) => {
                if child.stamp != 0 {
                    failure_result_from_rep(format.page_edge_order(path, ptr, child))?
                }
                if let Some(_) = std.page.tiered_root_at(image, i) {
                    check_page(mut walk, child, 3, Collection, None)?
                } else if height == 0 {
                    check_page(mut walk, child, class, Collection, None)?
                } else {
                    check_page(mut walk, child, class, domain, Some(height - 1))?
                }
            },
            Some(BlobEdge(value)) => check_blob(mut walk, value, blob_class)?,
            None => (),
        }
    }
    Ok(())
}

fn check_roots(mut walk: capture.CheckWalk, roots: pages.LocatedRoots) -> Result[(), Error] waits {
    check_page(mut walk, roots.collections, 0, CollectionMap, None)?
    for root in[roots.streams, roots.catalog] {
        check_page(mut walk, root, 0, Unprefixed, None)?
    }
    for root in roots.keyed {
        check_page(mut walk, root, 0, Unprefixed, None)?
    }
    Ok(())
}

fn check_reachable(p: PreparedCapture, mut walk: capture.CheckWalk) -> Result[(), Error] waits {
    let m = capture.prepared_manifest(p.state)
    for root in[m.pack_root, m.deferred_frees, m.lineage] {
        check_page(mut walk, root, 2, Unprefixed, None)?
    }
    if m.deferred_frees.stamp != 0 {
        let mut packs = capture.capture_packs(capture.prepared_dir(p.state), capture.prepared_id(p.state), capture.prepared_manifest(p.state), false, 0)
        let mut pages = 0u64
        failure_result_from_rep(capture.capture_walk_pages(mut packs, m.deferred_frees, 2, None, mut walk, mut pages, scoped fn(mut _packs: capture.CapturePacks, mut current: capture.CheckWalk, path: String, at: u64, key: Bytes, cell_value: std.page.Cell) -> Result[(), types.Failure] waits {
            let InlineValue(raw) = view cell_value else {
                return Error(format.disk_fault(path, at, Malformed))
            }
            let (_, queued) = manifest.decode_deferred_free(path, at, key, raw, capture.prepared_manifest(p.state))?
            match queued.target {
                TieredPage(ptr) => failure_result_to_rep(check_page(mut current, ptr, 3, Collection, None)),
                TieredBlob(body) => failure_result_to_rep(check_blob(mut current, body, 4)),
            }
        }))?
    }
    for holder in m.branches {
        check_roots(mut walk, holder.roots)?
    }
    for kept in m.pins {
        check_roots(mut walk, kept.roots)?
    }
    Ok(())
}

fn check_emit(take problem: Error, mut summary: CheckTotals, fault: scoped[view] fn(Fault) -> Result[(), Error] waits) -> Result[(), Error] waits {
    match take problem {
        Corrupt(take found) => {
            summary.faults += 1
            fault(found)
        },
        take other => Error(take other),
    }
}

fn check_mark(p: PreparedCapture, target: Option[Dir], mut summary: CheckTotals, fault: scoped[view] fn(Fault) -> Result[(), Error] waits) -> Result[Option[capture.CheckWalk], Error] waits {
    let mut packs = failure_result_from_rep(capture.check_inventory(capture.prepared_dir(p.state), capture.prepared_id(p.state), capture.prepared_manifest(p.state), capture.capture_list_slots(p.state)))?
    let mut base = 0u64
    for i in 0u64 .. list.len(packs) {
        if let Error(take problem) = failure_result_from_rep(capture.check_envelope(p.state, mut packs[i], target, mut summary.scrubbed)) {
            check_emit(take problem, mut summary, fault)?
        }
        packs[i].base = base
        base = capture.capture_add(base, packs[i].size)
    }
    if summary.faults != 0 {
        return Ok(None)
    }
    if base > 4611686018427387903u64 {
        return Error(Full(Allocation(Capacity(requested: 18446744073709551615u64, available: 0))))
    }
    let width = capture.capture_bitmap_bytes(p.state)
    let visits = capture.CheckVisits(visited: capture.check_bitmap(width), repeated: capture.check_bitmap(width), repeats: 0, pages: 0)
    let mut walk = capture.CheckWalk(packs: take packs, visits: take visits, locations: list.new(), locate: false, dir: capture.prepared_dir(p.state), id: capture.prepared_id(p.state), next_stamp: capture.prepared_manifest(p.state).next_stamp)
    match check_reachable(p, mut walk) {
        Ok(()) => Ok(Some(take walk)),
        Error(take problem) => {
            check_emit(take problem, mut summary, fault)?
            Ok(None)
        },
    }
}

// The initial scope refunds its scratch after marking. The repeat table is
// reserved from the enclosing limit before a second scratch scope is taken.
fn check_prepared(mut p: PreparedCapture, target: Option[Dir], fault: scoped[view] fn(Fault) -> Result[(), Error] waits) -> Result[(CheckTotals, u64), CheckError] waits {
    let mut summary = CheckTotals(scrubbed: 0, pages: 0, journal: 0, faults: 0, repeats: 0)
    let marked = bound bytes capture.capture_check_need(p.state, p.purpose == Copy) {
        check_mark(p, target, mut summary, fault)
    } ?=> CheckBudget
    let mut thorough = match take marked {
        Ok(take walk) => take walk,
        Error(take problem) => {
            check_emit(take problem, mut summary, fault) ?=> CheckStore
            None
        },
    }
    if let Some(mut walk) = thorough {
        summary.pages = walk.visits.pages
        summary.repeats = capture.capture_mul(16, walk.visits.repeats)
        let scratch = capture.capture_check_scratch(p.state)
        let located = bound bytes capture.capture_add(scratch, summary.repeats) {
            walk.locations = capture.check_repeat_slots(walk.visits)
            for i in 0u64 .. list.len(walk.visits.visited) {
                walk.visits.visited[i] = 0u8
            }
            walk.locate = true
            check_reachable(p, mut walk)
        } ?=> |cause| CheckRepeats(Capacity(requested: summary.repeats, available: int.saturating_sub(cause.available, scratch)))
        if let Error(take problem) = located {
            check_emit(take problem, mut summary, fault) ?=> CheckStore
        }
    }
    let _ = take thorough
    let journal = bound bytes capture.capture_check_scratch(p.state) {
        check_journal(mut p, mut summary.journal)
    } ?=> CheckBudget
    let head = match take journal {
        Ok(found) => found,
        Error(take problem) => {
            check_emit(take problem, mut summary, fault) ?=> CheckStore
            0u64
        },
    }
    Ok((take summary, head))
}

pub fn check_capture(take p: PreparedCapture, fault: scoped[view] fn(Fault) -> Result[(), Error] waits) -> Result[CheckTotals, CheckError] waits {
    let mut selected = take p
    if !capture.prepared_locked(selected.state) {
        return Error(CheckStore(Unsupported(0)))
    }
    let (take summary, _) = check_prepared(mut selected, None, fault)?
    Ok(take summary)
}

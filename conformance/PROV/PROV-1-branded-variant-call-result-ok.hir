// rule: PROV-1
// expect: accept
// An unannotated construction is typed by its payload: `Some(now)` holds an
// instant of `c` once the call's brand names the argument, so it is an
// `Option[Instant of c]`.
fn sampled(c: MonotonicClock) -> Result[Option[Instant of c], ClockError] {
  let now = clock.monotonic(c)?
  let t = Some(now)
  Ok(t)
}

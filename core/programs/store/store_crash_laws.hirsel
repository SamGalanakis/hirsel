// L17 and L33. The rewrite, its index and the extra table are published at
// one version: the migration phase rewrites rows, and crash_schema declares
// by_v and added in the same declaration.
fn crash_migration(mut phase: Migration) -> Result[(), Error] {
    migrate_table(mut phase, "rows", std.codec.key_u64(), std.codec.of_u64(), "rows", std.codec.key_u64(), std.codec.of_u64(), crash_thousand)
}

fn crash_value(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, v)
    Ok(take keys)
}

fn crash_thousand(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
    Ok(Some((k, v + 1000)))
}

fn disk_crash_read(d: Dir, c: Clock, r: Random, tasks: Tasks, scenario: String, required_new: bool) -> Result[bool, Error] waits {
    let mut options = disk_crash_options(scenario)
    options.create = false
    let mut db = match open(tasks, d, c, r, options) {
        Ok(take db) => take db,
        Error(NotFound) => return Ok(scenario == "genesis" && !required_new),
        Error(take e) => return Error(take e)
    }
    if scenario == "genesis" && db.heads[0].head == 0 {
        let empty = page_row_count(db.heads[0].roots.collections) == 0 && page_row_count(db.heads[0].roots.catalog) == 0
        close(take db)?
        return Ok(empty && !required_new)
    }
    let mut old = true
    let mut new = true
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let sh = view t
    for k in 0u64 .. 96 {
        let found = get(result.unwrap(reader(db, 0u64)), snapshot(db), sh, k)?
        let old_value: Option[u64] = if scenario == "genesis" {
            if k + 1 < db.heads[0].head {
                Some(k + 1)
            } else {
                None
            }
        } else {
            Some(k + 1)
        }
        if found != old_value {
            old = false
        }
        let expected = if k < 64 {
            k + 101
        } else {
            k + 1
        }
        if found != Some(expected) {
            new = false
        }
    }
    // L4's input was durable in init; a checkpoint cut never loses it.
    let mut good = if scenario == "branches" || scenario == "migrate" {
        true
    } else {
        new
    }
    if scenario == "schema" {
        good = old
        match table(mut db, "added", std.codec.key_u64(), std.codec.of_u64()) {
            Ok(take added) => {
                if added.id != 2 || db.heads[0].head != 98 {
                    good = false
                }
            },
            Error(Missing(_)) => {
                if db.heads[0].head != 97 || required_new {
                    good = false
                }
            },
            _ => {
                good = false
            }
        }
    } else if scenario == "refusal" {
        good = old
        let big = table(mut db, "big", std.codec.key_u64(), std.codec.of_string())?
        if !old || db.heads[0].head < 98 || db.heads[0].head > 100 || (required_new && db.heads[0].head != 100) {
            good = false
        }
        match get(result.unwrap(reader(db, 0u64)), snapshot(db), big, 1)? {
            Some(value) => {
                if db.heads[0].head != 99 || string.byte_len(value) != 1048566 {
                    good = false
                }
                for byte in string.as_bytes(value) {
                    if byte != 97u8 {
                        good = false
                    }
                }
            },
            None => if db.heads[0].head == 99 {
                good = false
            }
        }
    } else if scenario == "migrate" {
        // Before: head 97, rows k + 1, no index. After: head 98, rows
        // k + 1001, and by_v lists all 96 in key order. Nothing between.
        let mut moved = true
        for k in 0u64 .. 96 {
            if get(result.unwrap(reader(db, 0u64)), snapshot(db), sh, k)? != Some(k + 1001) {
                moved = false
            }
        }
        let listed = list.len(index_catalog(db, t.id)?)
        let mut whole = false
        if moved && listed == 1 && db.heads[0].head == 98 {
            let mut decl = declare(db, Open)?
            let mut indexed = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
            let ix = index(mut decl, mut indexed, "by_v", Many, code.describe(crash_value), std.codec.key_u64())?
            let _ = finish(mut decl, take indexed)?
            let added_decl = declare_table(mut decl, "added", std.codec.key_u64(), std.codec.of_u64())?
            let _ = finish(mut decl, take added_decl)?
            let _ = seal(mut db, take decl)?
            let mut rows = find(result.unwrap(reader(db, 0u64)), snapshot(db), ix, Unbounded, Unbounded)?
            let mut expect = 0u64
            whole = true
            while let Some((k, v)) = next(law_reader(rows.capture), mut rows)? {
                if k != expect || v != k + 1001 {
                    whole = false
                }
                expect += 1
            }
            whole = whole && expect == 96
        }
        let added = table(mut db, "added", std.codec.key_u64(), std.codec.of_u64())
        let before = old && listed == 0 && db.heads[0].head == 97
        good = match take added {
            Ok(created) => whole && created.id == 4,
            Error(Missing(_)) => before && !required_new,
            _ => false,
        }
    } else if scenario == "branches" {
        // The states in write order: nothing; pin p at 97; and b at 97; b at
        // 98 with k0 = 500; p gone. Main is at 97 with every row k + 1 in all.
        let has_pin = match pinned(db, "p") {
            Some(s) => {
                if version(s) != 97 || get(law_reader(s), s, sh, 0)? != Some(1u64) {
                    good = false
                };
                true
            },
            None => false
        }
        let b_head = match branch(db, "b") {
            Some(b) => {
                let at_b = snapshot_of(db, b)?
                let k0: Option[u64] = if version(at_b) == 98 {
                    Some(500)
                } else {
                    Some(1)
                }
                if get(result.unwrap(reader(db, 0u64)), at_b, sh, 0)? != k0 || get(result.unwrap(reader(db, 0u64)), at_b, sh, 95)? != Some(96u64) {
                    good = false
                }
                version(at_b)
            },
            None => 0u64
        }
        let known = (b_head == 0) || (has_pin && b_head == 97) || b_head == 98
        good = good && old && db.heads[0].head == 97 && known && (!required_new || (!has_pin && b_head == 98))
    } else if scenario == "genesis" {
        good = old && db.heads[0].head >= 1 && db.heads[0].head <= 97 && (!required_new || db.heads[0].head == 97)
    }
    close(take db)?
    Ok(good)
}

fn install_target_value(target: PreparedTarget, _witness: Inline[u8, 32]) -> Result[Bytes, DeployError] {
    deploy_result(copied(target.release))
}

fn install_fixture_bytes(n: u64, b: u8) -> Bytes {
    let mut out: Bytes = list.new()
    list.fill(mut out, n, b)
    take out
}

fn crash_install_init(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, disk_crash_options("install"))?
    let mut staging = install_old(db)?
    let description = install_fixture_bytes(32u64, 65u8)
    stage_activation(mut staging, 1u64, None, description, std.codec.of_bytes(), description)?
    install_activation(mut db, take staging)?
    let target = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 96u64 {
        if !typed_put(mut db, target, k, k + 1) {
            fail("install seed row")
        }
    }
    let _ = checkpoint(mut db)?
    close(take db)
}

fn crash_install_prepared(mut db: Db, d: Dir, c: Clock, tasks: Tasks, attempt: Bytes) -> Result[(Dir, u64), DeployError] waits {
    let copying = begin_export(mut db, tasks, d, deploy_result(copied(attempt))?, 1u64, 4194304u64)?
    let exported = match task.join(take copying) {
        Ok(take answer) => (take answer)?,
        Error(_) => return Error(ExportMismatch),
    }
    Ok((exported.dir, exported.stamp.head))
}

fn crash_import(mut db: Db, scratch: Dir, c: Clock, tasks: Tasks, attempt: Bytes, image: u8, journal_cap: u64) -> Result[Inline[u8, 32], DeployError] waits {
    let source = open_export(scratch, c, attempt, disk_crash_options("install"))?
    let staged = deploy_result(stage_next(source, tasks))?
    let header = PreparedTarget(describe: install_fixture_bytes(32u64, image), release: install_fixture_bytes(32u64, 67u8), digest: install_fixture_bytes(32u64, 68u8), resident_limit: 2097152u64, pack_bytes: 1048576u64, checkpoint_bytes: 4096u64, journal_limit: journal_cap)
    write_prepared(source, staged, scratch, take header)?
    let checked = validate_prepared(scratch)?
    let work = reserve_import(mut db, take checked)?
    let assembled = import_trees(take work)?
    let digest = imported_digest(assembled)
    keep_import(mut db, take assembled)?
    Ok(digest)
}

fn crash_apply(mut db: Db, attempt: Bytes, digest: Inline[u8, 32]) -> Result[u64, DeployError] waits {
    let requested = Cutover(attempt: deploy_result(copied(attempt))?, digest: digest, deadline: 18446744073709551615u64)
    let description = install_fixture_bytes(32u64, 65u8)
    perform_cutover(mut db, requested, 1u64, description, std.codec.of_bytes(), install_target_value, scoped fn() -> bool {
        true
    })
}

fn crash_install_run(mut db: Db, d: Dir, c: Clock, tasks: Tasks) -> Result[u64, DeployError] waits {
    let attempt = install_fixture_bytes(16u64, 7u8)
    let (scratch, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let digest = crash_import(mut db, scratch, c, tasks, attempt, 66u8, 16781392u64)?
    crash_apply(mut db, attempt, digest)
}

@test
fn export_refuses_a_second_lease(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let directory = disk_test_directory(d)
    let scratch = disk_test_directory(d)
    let mut db = deploy_result(open(tasks, directory, c, r, disk_crash_options("install")))?
    let first = install_fixture_bytes(16, 7)
    let second = install_fixture_bytes(16, 8)
    let _ = begin_export_copy(mut db, scratch, deploy_result(copied(first))?, 0)?
    if let Error(AttemptBusy) = begin_export_copy(mut db, scratch, deploy_result(copied(second))?, 0) {} else {
        fail("a second export replaced the current lease")
    }
    release_export(mut db, second)
    if !export_leased(db) {
        fail("the refused attempt could release the first export")
    }
    release_export(mut db, first)
    let _ = begin_export_copy(mut db, scratch, deploy_result(copied(second))?, 0)?
    release_export(mut db, second)
    deploy_result(close(take db))
}

@test
fn expired_cutover_keeps_old_serving(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let directory = disk_test_directory(d)
    deploy_result(crash_install_init(directory, c, r, tasks))?
    let mut db = deploy_result(open(tasks, directory, c, r, disk_crash_options("install")))?
    let attempt = install_fixture_bytes(16, 7)
    let (scratch, base) = crash_install_prepared(mut db, directory, c, tasks, attempt)?
    let digest = crash_import(mut db, scratch, c, tasks, attempt, 66, 16781392)?
    let request = Cutover(attempt: take attempt, digest: digest, deadline: 0)
    let description = install_fixture_bytes(32, 65)
    match perform_cutover(mut db, request, 1, description, std.codec.of_bytes(), install_target_value, scoped fn() -> bool {
        true
    }) {
        Error(Expired) => (),
        _ => fail("the prepared cutover did not refuse the expired deadline"),
    }
    let old = deploy_result(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let read = deploy_result(reader(db, 0))?
    let snap = snapshot(db)
    if version(snap) != base || deploy_result(get(read, snap, old, 0))? != Some(1) {
        fail("the expired cutover changed OLD's serving state")
    }
    if !typed_put(mut db, old, 0, 99) {
        fail("OLD could not commit after the expired cutover")
    }
    deploy_result(close(take db))
}

fn crash_prepared_meta(d: Dir) -> Result[Bytes, DeployError] waits {
    let mut file = scratch_result(disk_io(host.open(d, "PREPARED", Read)))?
    // AP1b gives 212 + 32 bytes for this fixture's 32-byte describe.
    let frame = scratch_result(read_disk_bytes(mut file, "PREPARED", 72, 16 + 244))?
    scratch_result(disk_io(host.close(take file)))?
    let kind: u16 = list.word_le(frame, 0)
    let width: u32 = list.word_le(frame, 4)
    if kind != 0x0081 || width != 244 {
        fail("unexpected PREPARED metadata frame")
    }
    deploy_result(copied(list.slice(frame, 16, 260)))
}

// Exercise the pre-rename refusals together with a fresh export after drift.
// No cut in this case is permitted to change the activation until the retry.
fn crash_install_refusals(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let mut db = deploy_result(open(tasks, d, c, r, disk_crash_options("install")))?
    let attempt = install_fixture_bytes(16u64, 7u8)
    let (scratch, base) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    if base != 97u64 {
        fail("fixture base")
    }
    let first = crash_import(mut db, scratch, c, tasks, attempt, 66u8, 16781392u64)?
    let fitted_meta = crash_prepared_meta(scratch)?
    let second = crash_import(mut db, scratch, c, tasks, attempt, 70u8, 16781392u64)?
    if first == second {
        fail("candidate digests are equal")
    }
    match crash_apply(mut db, attempt, first) {
        Error(ExportMismatch) => (),
        _ => fail("cutover accepted a superseded candidate"),
    }
    let (scratch_limit, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let before = deploy_result(disk_read_paged_file(d, "MANIFEST", MANIFEST_LIMIT))?
    let blocked = crash_import(mut db, scratch_limit, c, tasks, attempt, 66u8, 16781391u64)?
    let limited_meta = crash_prepared_meta(scratch_limit)?
    let fitted: u64 = list.word_le(fitted_meta, 216)
    let limited: u64 = list.word_le(limited_meta, 216)
    if fitted != 16781392 || limited != 16781391 || list.slice(fitted_meta, 0, 216) != list.slice(limited_meta, 0, 216) || list.slice(fitted_meta, 224, 244) != list.slice(limited_meta, 224, 244) {
        fail("PREPARED did not preserve the exact target options")
    }
    match crash_apply(mut db, attempt, blocked) {
        Error(FullNew(Journal(problem))) if problem.requested == 16781392 && problem.available == 16781391 => (),
        _ => fail("cutover ignored NEW's journal floor"),
    }
    let after = deploy_result(disk_read_paged_file(d, "MANIFEST", MANIFEST_LIMIT))?
    if version(snapshot(db)) != base || before != after || disk_state(db).options.journal_limit != 268435456 {
        fail("a refused install changed OLD")
    }
    let (scratch_writes, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let stale = crash_import(mut db, scratch_writes, c, tasks, attempt, 66u8, 16781392u64)?
    let t = deploy_result(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let acknowledged = deploy_result(run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 0u64, 77u64)
    }))?
    if let Committed(done) = acknowledged {
        deploy_result(durable(mut db, done.ticket))?
    } else {
        fail("could not acknowledge the drift write")
    }
    match crash_apply(mut db, attempt, stale) {
        Error(Drift) => (),
        _ => fail("cutover accepted an intervening journal commit"),
    }
    let (scratch_schema, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let stale_schema = crash_import(mut db, scratch_schema, c, tasks, attempt, 66u8, 16781392u64)?
    let _ = deploy_result(law_table(mut db, "kept", std.codec.key_u64(), std.codec.of_u64()))?
    match crash_apply(mut db, attempt, stale_schema) {
        Error(Drift) => (),
        _ => fail("cutover accepted an intervening schema commit"),
    }
    let installed = crash_install_run(mut db, d, c, tasks)?
    if installed != 100u64 {
        fail("fresh export lost an intervening version")
    }
    deploy_result(close(take db))?
    let reopened = deploy_result(open(tasks, d, c, r, disk_crash_options("install")))?
    let migrated = deploy_result(system_table(reopened, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let _ = deploy_result(system_table(reopened, "kept", std.codec.key_u64(), std.codec.of_u64()))?
    if deploy_result(get(result.unwrap(reader(reopened, 0u64)), snapshot(reopened), migrated, 0u64))? != Some(1077u64) {
        fail("fresh export lost the acknowledged row")
    }
    deploy_result(close(take reopened))
}

fn crash_install_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, disk_crash_options("install"))?
    match crash_install_run(mut db, d, c, tasks) {
        Ok(v) => if v != 98 {
            fail("wrong installed version")
        },
        Error(Store(take problem)) => return Error(take problem),
        Error(Scratch(take problem)) => return Error(take problem),
        Error(_) => fail("install fixture refused"),
    }
    close(take db)
}

fn crash_install_read(d: Dir, c: Clock, r: Random, tasks: Tasks, required_new: bool) -> Result[bool, Error] waits {
    let mut db = open(tasks, d, c, r, disk_crash_options("install"))?
    let snap = snapshot(db)
    let v = version(snap)
    if v != 98 && (v != 97 || required_new) {
        return Ok(false)
    }
    let installed = v == 98
    let activated = system_table(db, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes())?
    let release = system_table(db, "hirsel.runner.releases", std.codec.key_u64(), std.codec.of_bytes())?
    let found = option.unwrap(get(result.unwrap(reader(db, 0u64)), snap, activated, 0u8)?)
    if found != install_fixture_bytes(32u64, if installed {
        66u8
    } else {
        65u8
    }) || db.fence != 1 {
        return Ok(false)
    }
    let new_release = get(result.unwrap(reader(db, 0u64)), snap, release, 98u64)?
    if installed {
        if option.unwrap(take new_release) != install_fixture_bytes(32u64, 67u8) || db.next_table != 10u32 {
            return Ok(false)
        }
    } else if let Some(_) = new_release {
        return Ok(false)
    }
    let t = system_table(db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 96u64 {
        if get(result.unwrap(reader(db, 0u64)), snap, t, k)? != Some(k + if installed {
            1001u64
        } else {
            1u64
        }) {
            return Ok(false)
        }
    }
    if installed {
        let other = system_table(db, "other", std.codec.key_u64(), std.codec.of_u64())?
        if list.len(index_catalog(db, other.id)?) != 1 || page_row_count(db.heads[0].roots.streams) != 0u64 {
            return Ok(false)
        }
        let _ = declare_after(mut db)?
        let after = system_table(db, "after", std.codec.key_u64(), std.codec.of_u64())?
        if after.id != 10u32 {
            return Ok(false)
        }
        let _ = checkpoint(mut db)?
        close(take db)?
        let reopened = open(tasks, d, c, r, disk_crash_options("install"))?
        for k in 0u64 .. 96u64 {
            if get(result.unwrap(reader(reopened, 0u64)), snapshot(reopened), t, k)? != Some(k + 1001u64) {
                return Ok(false)
            }
        }
        close(take reopened)?
    } else {
        close(take db)?
    }
    Ok(true)
}

// Native provider entry; the adapter invokes it for init, one cut and reopen.
// The expected rows and schema versions above follow the specified history.
pub fn disk_crash_main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, out: Stdout) -> Result[(), Exit] waits {
    let phase = option.unwrap(args.get(argv, 0))
    let scenario = option.unwrap(args.get(argv, 1))
    if scenario == "window" || scenario == "window-chunk-failure" || scenario == "window-sync-failure" {
        return disk_window_crash(d, c, r, tasks, argv, out, phase, scenario != "window")
    }
    if scenario == "read-only" {
        if phase == "init" {
            disk_crash_init(d, c, r, tasks, "checkpoint") ?=> |_| Exit(status: 31)
            return Ok(())
        }
        if phase == "write" {
            return match disk_crash_torn_manifest(d) {
                Ok(()) => {
                    let _ = stdout.write(out, "DONE");
                    Ok(())
                },
                Error(Io(_)) => Ok(()),
                Error(_) => Error(Exit(status: 32)),
            }
        }
        let published = option.unwrap(args.get(argv, 2)) == "new"
        disk_crash_read_only(d, c, published) ?=> |_| Exit(status: 33)
        return Ok(())
    }
    if scenario == "follower-durable" || scenario == "follower-boundary" || scenario == "read-only-durable" {
        return disk_crash_live_read_main(d, c, r, tasks, argv, out, scenario)
    }
    if scenario == "watermark-absent" || scenario == "watermark-torn" {
        if phase == "write" {
            if let Error(_) = disk_watermark_cut(d, c, r, tasks, scenario == "watermark-torn") {
                return Error(Exit(status: 65u8))
            }
            let _ = stdout.write(out, "DONE")
        }
        return Ok(())
    }
    if scenario == "install-refusals" {
        if phase == "init" {
            return match crash_install_init(d, c, r, tasks) {
                Ok(()) => Ok(()),
                Error(_) => Error(Exit(status: 61u8))
            }
        }
        if phase == "write" {
            if let Ok(()) = crash_install_refusals(d, c, r, tasks) {
                let _ = stdout.write(out, "DONE");
                return Ok(())
            }
            return Error(Exit(status: 64u8))
        }
        return Ok(())
    }
    if scenario == "install" {
        if phase == "init" {
            return match crash_install_init(d, c, r, tasks) {
                Ok(()) => Ok(()),
                Error(_) => Error(Exit(status: 61u8))
            }
        }
        if phase == "write" {
            if let Ok(()) = crash_install_write(d, c, r, tasks) {
                let _ = stdout.write(out, "DONE")
            }
            return Ok(())
        }
        let required_new = option.unwrap(args.get(argv, 2u64)) == "new"
        return match crash_install_read(d, c, r, tasks, required_new) {
            Ok(true) => Ok(()),
            _ => Error(Exit(status: 63u8))
        }
    }
    if scenario == "index-build" {
        if phase == "init" {
            index_build_init(d, c, r, tasks) ?=> |_| Exit(status: 71u8)
            return Ok(())
        }
        if phase == "write" {
            return match index_build_write(d, c, r, tasks) {
                Ok(()) => {
                    let _ = stdout.write(out, "DONE");
                    Ok(())
                },
                Error(Io(_)) => Ok(()),
                Error(Poisoned(_)) => Ok(()),
                Error(_) => Error(Exit(status: 72u8)),
            }
        }
        let required_new = option.unwrap(args.get(argv, 2u64)) == "new"
        return match index_build_read(d, c, r, tasks, required_new) {
            Ok(true) => Ok(()),
            _ => Error(Exit(status: 73u8)),
        }
    }
    if phase == "init" {
        if scenario == "genesis" {
            return Ok(())
        }
        match disk_crash_init(d, c, r, tasks, scenario) {
            Ok(()) => Ok(()),
            Error(_) => Error(Exit(status: 31))
        }
    } else if phase == "write" {
        match disk_crash_write(d, c, r, tasks, scenario) {
            Ok(()) => {
                let _ = stdout.write(out, "DONE");
                Ok(())
            },
            Error(Io(_)) => Ok(()),
            Error(Poisoned(_)) => Ok(()),
            Error(_) => Error(Exit(status: 32))
        }
    } else if phase == "reopen" {
        match open(tasks, d, c, r, disk_crash_options(scenario)) {
            Error(Io(_)) => Ok(()),
            _ => Error(Exit(status: 34))
        }
    } else {
        let expected = option.unwrap(args.get(argv, 2))
        match disk_crash_read(d, c, r, tasks, scenario, expected == "new") {
            Ok(true) => Ok(()),
            _ => Error(Exit(status: 33))
        }
    }
}

fn disk_crash_torn_manifest(d: Dir) -> Result[(), Error] waits {
    let raw = read_page_manifest_bytes(d)?
    let torn = list.slice(raw, 0, list.len(raw) - 1)
    disk_write_synced(d, "MANIFEST.tmp", torn)?
    disk_io(host.rename(d, "MANIFEST.tmp", "MANIFEST"))?
    disk_io(host.sync_dir(d))
}

fn disk_crash_read_only(d: Dir, c: Clock, torn: bool) -> Result[(), Error] waits {
    let opened = open_read_only(d, c, disk_crash_options("checkpoint"))
    if torn {
        match opened {
            Error(Corrupt(f)) => if f.file == "MANIFEST" {
                if let Truncated = f.why {
                    return Ok(())
                }
            },
            _ => (),
        }
        fail("read-only open accepted a published torn MANIFEST or lost its fault")
    }
    let read_source = opened?
    let rows = read_only_table(read_source, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if version(read_source.snapshot) != 161 {
        fail("read-only open recovered the wrong journal prefix")
    }
    for k in 0u64 .. 96 {
        let expected = if k < 64 {
            k + 101
        } else {
            k + 1
        }
        if read_only_get(read_source, rows, k)? != Some(expected) {
            fail("read-only open recovered the wrong row")
        }
    }
    Ok(())
}

@test
fn disk_test_read_only_snapshot(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let child = disk_test_directory(d)
    if let Error(NotFound) = open_read_only(child, c, result.unwrap(sized(Directory, 2147483648u64))) {} else {
        fail("read-only open of an empty directory must refuse")
    }
    let mut db = open(tasks, child, c, r, result.unwrap(sized(Directory, 2147483648u64)))?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let opened_rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !typed_put(mut db, opened_rows, 7, 70) {
        fail("could not commit first row")
    }
    let final_item = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    durable(mut db, final_item)?
    let saved = open_read_only(child, c, result.unwrap(sized(Directory, 2147483648u64)))?
    let rows = read_only_table(saved, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if version(saved.snapshot) != 2 || read_only_get(saved, rows, 7)? != Some(70u64) {
        fail("read-only open missed a durable journal row")
    }
    if !typed_put(mut db, opened_rows, 7, 71) {
        fail("could not commit replacement row")
    }
    checkpoint(mut db)?
    close(take db)?
    let newer = open_read_only(child, c, result.unwrap(sized(Directory, 2147483648u64)))?
    if version(saved.snapshot) != 2 || read_only_get(saved, rows, 7)? != Some(70u64) || version(newer.snapshot) != 3 || read_only_get(newer, rows, 7)? != Some(71u64) {
        fail("read-only reads changed after the writer replaced the row")
    }
    Ok(())
}

// L-IX (STORE-SPEC §1.2). For any interleaving of writes with build chunks,
// an index that reaches Public holds exactly the entries a fresh extraction
// of the rows gives, and every read of it before then refuses NotReady. The
// oracle is the law's own model of the rows; the "index-build" scenario
// below holds the same law at every W2 cut.
fn lix_keys(key: u64, value: u64) -> Result[List[u64], Capacity] {
    let a = value % 7
    let b = (value / 2) % 7
    let mut keys: List[u64] = list.new()
    list.push(mut keys, if a <= b {
        a
    } else {
        b
    })
    list.push(mut keys, if a <= b {
        b
    } else {
        a
    })
    Ok(take keys)
}

fn lix_next(seed: u64) -> u64 {
    (seed * 1103515245 + 12345) % 2147483648
}

fn lix_expected(id: u32, model: List[Option[u64]]) -> Result[List[Bytes], Error] {
    let mut out: List[Bytes] = list.new()
    for j in 0u64 .. 7 {
        for k in 0u64 .. list.len(model) {
            let Some(v) = model[k] else {
                continue
            }
            let keys = capacity(lix_keys(k, v))?
            if keys[0] == j || keys[1] == j {
                let mut logical = prefix(id)?
                list.put_word_be(mut logical, j)
                list.put_word_be(mut logical, k)
                list.push(mut out, take logical)
            }
        }
    }
    Ok(take out)
}

fn lix_entries(db: Db, id: u32) -> Result[List[Bytes], Error] {
    let s = snapshot(db)
    let mut cursor = byte_cursor(s.roots.collections, Included(prefix(id)?), prefix(id + 1)?)?
    let mut out: List[Bytes] = list.new()
    while let Some((take key, _)) = next_bytes(mut cursor)? {
        list.push(mut out, take key)
    }
    Ok(take out)
}

// The state `attention` reports for the index named `name`; an operator
// reads it there (§II.3).
fn lix_state(db: Db, name: String) -> Result[IndexState, Error] {
    let seen = attention(db)?
    let mut found: Option[IndexState] = None
    for report in seen.indexes {
        if report.index == name {
            if let Some(_) = found { fail("L-IX: attention reports an index twice") }
            found = Some(copied_state(report.state)?)
        }
    }
    match take found {
        Some(take state) => Ok(take state),
        None => fail("L-IX: attention omits a declared index"),
    }
}

// Whether `ix` is Public, as attention reports it, after checking that it
// serves reads exactly then.
fn lix_serves[J, K, V, P](db: Db, ix: Index[J, K, V, P], name: String) -> Result[bool, Error] waits {
    let public = match lix_state(db, name)? {
        Public => true,
        _ => false,
    }
    let served = match find(result.unwrap(reader(db, 0u64)), snapshot(db), ix, Unbounded, Unbounded) {
        Ok(_) => true,
        Error(NotReady(_)) => false,
        Error(take problem) => return Error(take problem),
    }
    if served != public {
        fail("L-IX: an index serves reads exactly when it is Public")
    }
    Ok(public)
}

fn lix_write(mut db: Db, t: Table[u64, u64], k: u64, v: Option[u64]) -> Result[(), Error] waits {
    let ran = run(mut db, None, (copy_env(t), k, v), fn(mut tx, input) -> Result[(), Error] {
        match input.2 {
            Some(value) => put(mut tx, input.0, input.1, value),
            None => {
                let _ = delete(mut tx, input.0, input.1)?
                Ok(())
            },
        }
    })?
    match take ran {
        Committed(_) => Ok(()),
        _ => Error(MigrationFault),
    }
}

fn lix_case(c: Clock, seed: u64, initial: u64) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let key = std.codec.key_u64()
    let mut declaration = declare(db, Migrate)?
    let mut rows_decl = declare_table(mut declaration, "rows", key, std.codec.of_u64())?
    let ix = index(mut declaration, mut rows_decl, "by_v", Many, code.describe(lix_keys), key)?
    let t = finish(mut declaration, take rows_decl)?
    let _ = seal(mut db, take declaration)?
    let mut model: List[Option[u64]] = list.new()
    for k in 0u64 .. 40 {
        let v = if k < initial {
            Some(k * 3)
        } else {
            None
        }
        if let Some(_) = v {
            lix_write(mut db, t, k, v)?
        }
        list.push(mut model, v)
    }
    rebuild_index(mut db, ix)?
    let mut state = seed
    let mut rounds = 0u64
    while !lix_serves(db, ix, "by_v")? {
        rounds += 1
        if rounds > 2000 {
            fail("L-IX: the build made no progress")
        }
        state = lix_next(state)
        let pick = state % 8
        state = lix_next(state)
        let k = state % 40
        state = lix_next(state)
        if pick < 3 {
            match index_build_step(mut db, 2 * pick + 1)? {
                Some(name) => if name != "by_v" {
                    fail("L-IX: the step built another index")
                },
                None => fail("L-IX: the step found nothing building"),
            }
        } else {
            let v = if pick < 6 {
                Some(state % 1000)
            } else {
                None
            }
            lix_write(mut db, t, k, v)?
            model[k] = v
        }
    }
    if lix_entries(db, ix.id)? != lix_expected(ix.id, model)? {
        fail("L-IX: the Public index differs from a fresh extraction of the rows")
    }
    if let Some(_) = index_build_step(mut db, 1)? {
        fail("L-IX: a Public index still builds")
    }
    Ok(())
}

// law_unique_backfill's chunk boundaries, built by the step. Row 0 takes
// row d's value while the index is empty, so only the chunk holding row d
// finds the pair; the index then fails and keeps refusing reads.
fn lix_duplicate_case(c: Clock, rows: u64, duplicate: Option[u64]) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let key = std.codec.key_u64()
    let mut declaration = declare(db, Migrate)?
    let mut rows_decl = declare_table(mut declaration, "rows", key, std.codec.of_u64())?
    let ix = index(mut declaration, mut rows_decl, "unique", Unique, code.describe(backfill_keys), key)?
    let t = finish(mut declaration, take rows_decl)?
    let _ = seal(mut db, take declaration)?
    let filled = run(mut db, None, (copy_env(t), rows), fn(mut tx, input) -> Result[(), Error] {
        for i in 0u64 .. input.1 {
            put(mut tx, input.0, i, i)?
        }
        Ok(())
    })?
    if let Committed(_) = filled {} else {
        return Error(MigrationFault)
    }
    rebuild_index(mut db, ix)?
    if let Some(d) = duplicate { lix_write(mut db, t, 0, Some(d))? }
    if let Backfilling(None) = lix_state(db, "unique")? {} else { fail("L-IX: a rebuilt index reports Backfilling before its first chunk") }
    // The first chunk reads rows 0 to 4095: it fails on a pair inside it,
    // ends the build when no row follows, and otherwise leaves the cursor
    // at row 4095, the last key it covered.
    let _ = index_build_step(mut db, INDEX_CHUNK)?
    let first_chunk = match lix_state(db, "unique")? {
        Public => 0u64,
        Backfilling(Some(cursor)) => if list.len(cursor) == 8 && list.word_be(cursor, 0) == INDEX_CHUNK - 1 { 1u64 } else { 9u64 },
        Failed(_, _) => 2u64,
        Backfilling(None) => 9u64,
    }
    let expected_chunk = match duplicate {
        Some(d) if d < INDEX_CHUNK => 2u64,
        _ => if rows > INDEX_CHUNK { 1u64 } else { 0u64 },
    }
    if first_chunk != expected_chunk { fail("L-IX: attention reports the first chunk's state and cursor") }
    while let Some(_) = index_build_step(mut db, INDEX_CHUNK)? {}
    let failed = match lix_state(db, "unique")? {
        Failed(first, second) => {
            let owner: u64 = list.word_be(first, 0)
            let other: u64 = list.word_be(second, 0)
            Some((owner, other))
        },
        _ => None,
    }
    let expected_failure = match duplicate {
        Some(d) => Some((0u64, d)),
        None => None,
    }
    if failed != expected_failure { fail("L-IX: a duplicate fails the build at the row that repeats it") }
    if lix_serves(db, ix, "unique")? == (duplicate != None) { fail("L-IX: a failed index refuses reads") }
    if let None = duplicate {
        let found = lix_entries(db, ix.id)?
        if list.len(found) != rows {
            fail("L-IX: the unique index holds one entry per row")
        }
        for i in 0u64 .. rows {
            let j: u64 = list.word_be(found[i], 4)
            if j != i {
                fail("L-IX: the unique index holds one entry per row")
            }
        }
    }
    Ok(())
}

@test
fn test_index_build_law(c: Clock) -> Result[(), Error] waits {
    let initials: Inline[u64, 4] =[0, 1, 17, 40]
    for initial in initials {
        for seed in 0u64 .. 8 {
            lix_case(c, seed * 7919 + initial, initial)?
        }
    }
    let sizes: Inline[u64, 6] =[0, 1, 4095, 4096, 4097, 12289]
    let duplicates: Inline[u64, 10] =[1, 4095, 4096, 4097, 8191, 8192, 8193, 12287, 12288, 2]
    for rows in sizes {
        lix_duplicate_case(c, rows, None)?
        for duplicate in duplicates {
            if duplicate < rows {
                lix_duplicate_case(c, rows, Some(duplicate))?
            }
        }
    }
    Ok(())
}

fn index_build_open(d: Dir, c: Clock, r: Random, tasks: Tasks, create: bool) -> Result[(Db, Table[u64, u64], Index[u64, u64, u64, ()]), Error] waits {
    let mut options = disk_crash_options("index-build")
    options.create = create
    let mut db = open(tasks, d, c, r, options)?
    let (t, ix) = index_build_schema(mut db, Open)?
    Ok((take db, t, take ix))
}

// rows with by_v, declared in one schema: Migrate adds by_v, Open binds it.
fn index_build_schema(mut db: Db, mode: Mode) -> Result[(Table[u64, u64], Index[u64, u64, u64, ()]), Error] waits {
    let mut d = declare(db, mode)?
    let mut declared = declare_table(mut d, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let ix = index(mut d, mut declared, "by_v", Many, code.describe(crash_value), std.codec.key_u64())?
    let t = finish(mut d, take declared)?
    let _ = seal(mut db, take d)?
    Ok((t, take ix))
}

fn index_build_init(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    disk_crash_init(d, c, r, tasks, "index-build")?
    let mut db = open(tasks, d, c, r, disk_crash_options("index-build"))?
    let _ = index_build_schema(mut db, Migrate)?
    let _ = checkpoint(mut db)?
    close(take db)
}

// Demotes by_v and rebuilds it in chunks of 16 rows, one row changing
// between chunks (behind the cursor or ahead of it).
fn index_build_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let (take opened, t, take ix) = index_build_open(d, c, r, tasks, true)?
    let mut db = take opened
    rebuild_index(mut db, ix)?
    let mut round = 0u64
    while let Some(_) = index_build_step(mut db, 16)? {
        let k = (round * 37) % 96
        lix_write(mut db, t, k, Some(k + 500))?
        round += 1
    }
    close(take db)
}

// After any cut: by_v serves only if Public (and must be Public once the
// write phase finished). Every row then changes, the build finishes, and
// the index must equal by_v over the rows, k + 2000 for row k.
fn index_build_read(d: Dir, c: Clock, r: Random, tasks: Tasks, required_new: bool) -> Result[bool, Error] waits {
    let (take opened, t, take ix) = index_build_open(d, c, r, tasks, false)?
    let mut db = take opened
    let mut good = lix_serves(db, ix, "by_v")? || !required_new
    for k in 0u64 .. 96 {
        lix_write(mut db, t, k, Some(k + 2000))?
    }
    while let Some(_) = index_build_step(mut db, 16)? {}
    good = good && lix_serves(db, ix, "by_v")?
    let mut expected: List[Bytes] = list.new()
    for k in 0u64 .. 96 {
        let mut logical = prefix(ix.id)?
        list.put_word_be(mut logical, k + 2000)
        list.put_word_be(mut logical, k)
        list.push(mut expected, take logical)
    }
    good = good && lix_entries(db, ix.id)? == expected
    close(take db)?
    Ok(good)
}

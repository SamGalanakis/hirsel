fn tiered_replayed_row(tree: PageTree, logical: Bytes) -> Option[View[ReplayRow]] in tree {
    let Some(overlays) = view tree.replay else {
        return None
    }
    let id: u32 = list.word_be(logical, 0)
    let Some(overlay) = std.omap.get(overlays.collections, id) else {
        return None
    }
    replay_overlay_at(overlay, logical)
}

fn read_tiered_point[R](source: TieredPageSource, root_grant: Arc[TieredReaderGrant], root: TieredPinRoot, tree: PageTree, logical: Bytes,
    decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    if list.len(logical) < 4 {
        return decode_row(None)
    }
    let Some((edge, descriptor)) = std.page.collection_slot(tree.root, list.slice(logical, 0, 4)) else {
        return decode_row(None)
    }
    if descriptor[52u64] == 4 {
        if list.len(logical) != 12 {
            return decode_row(None)
        }
        let sequence: u64 = list.word_be(logical, 4)
        let window = descriptor_bounds(descriptor)
        if sequence < window.first || sequence >= window.next {
            return decode_row(None)
        }
    }
    if let Some(row) = tiered_replayed_row(tree, logical) {
        let stored: Option[View[Bytes]] = match row.now {
            ReplayPut(value) => Some(view value),
            ReplayAbsent => None,
        }
        return decode_row(stored)
    }
    let key = list.slice(logical, 4, list.len(logical))
    retry_tiered_read(source, root_grant, root, key, None, TieredPoint, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[R, Error] {
        let backing = TieredBorrowedRoot(edge: view edge, pins: view visible)
        let stored = tiered_point_bytes(attempt, backing, key)?
        decode_row(stored)
    })
}

fn retry_tiered_read[R](source: TieredPageSource, root_grant: Arc[TieredReaderGrant], root: TieredPinRoot, key: Bytes, upper: Option[View[Bytes]], direction: TieredDirection,
    read: scoped[view] fn(core.Cell[TieredTouchSet], Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[R, Error]) -> Result[R, Error] waits {
    let mut pins = empty_tiered_pins(root, root_grant.pin_bytes)
    let mut pending: Option[(TieredTarget, Error)] = None
    let mut window = if direction == TieredPoint { 0u64 } else { 8u64 }
    loop {
        // The attempt lives outside the body's isolation, so a stop that
        // escapes the body still leaves its touches and latch readable.
        let attempt = tiered_attempt(root_grant.pin_bytes, window)
        let isolated = disk_allocation(scoped fn() -> Result[Result[R, Error], Error] {
            Ok(read(attempt, pins.frames))
        })
        let state = tiered_finish(take attempt)
        let observed = (take isolated)?
        match state.stopped {
            Some(AttemptMiss(target)) => {
                let failed_here = match pending {
                    Some((failed, _)) => tiered_frame_id(failed) == tiered_frame_id(target),
                    None => false,
                }
                if failed_here {
                    let (_, take problem) = option.unwrap(replace(mut pending, None))
                    return Error(take problem)
                }
                let sought = match state.seek {
                    SeekKey(secondary) => view secondary,
                    SeekUpper => option.unwrap(upper),
                    SeekOperation => view key,
                }
                let demand = TieredPointDemand(target: clone(target), key: copied(sought)?, direction: direction,
                    siblings: clone(state.siblings), packs: std.omap.snapshot(source.packs), next_stamp: source.next_stamp, deadline: source.deadline, grant: Some(arc.share(root_grant)))
                let TieredPointDelivery(frames: take frames, failure: take failure, ..) = tiered_point_delivery(source.pager, take demand)?
                window = int.saturating_mul(window, 2)
                for frame in frames {
                    let _ = tiered_install_pin(mut pins, root, state.stamps, frame)?
                }
                if let Some(take refused) = take failure {
                    pending = Some(take refused)
                }
            },
            Some(AttemptPinLimit(problem)) => return Error(Full(Cache(problem))),
            Some(AttemptAllocation(problem)) => return Error(Full(Allocation(problem))),
            Some(AttemptFold(_)) => fail("store: a read attempt cannot wait for a fold"),
            None => return take observed,
        }
    }
}

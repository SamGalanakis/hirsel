; CoreIR sample, family: calls and instances (Call direct and indirect, FunctionRef,
; multiple results, generic instances, an external function).
;
; Source (package samples@0, module calls):
;   i0  fn id[T](x: T) -> T { x }
;   i1  fn divmod(a: u32, b: u32) -> (u32, u32) { (a / b, a % b) }
;   i2  fn use(a: u32, b: u64) -> u64 { let (q, r) = divmod(a, 10); int.widen(id(q) + r) + id(b) }
;
; `id` has two instances, id[u32] (n0) and id[u64] (n1): two function rows, two link
; names. `id(b)` is called through a code pointer here to show the indirect form
; (generated code such as drop glue tables calls this way); a source call to a known
; function is direct, as `id(q)` is. f4 is defined in another module and only declared.
;
; Behaviour, derived by hand:
; run: f2(47, 10) -> 4, 7
; run: f2(1, 0) -> fail Division     ; division by zero (SEM-1)
; run: f3(47, 100) -> 111            ; q 4, r 7: widen(4 + 7) + 100
; run: f3(5, 0) -> 5
; run: f5() -> true, false           ; one descriptor per function: f1's twice is one word, f0's another
core v1
item i0 = samples@0/calls/id
item i1 = samples@0/calls/divmod
item i2 = samples@0/calls/use
type t0 = own "u32" value u32 { 0: u32 }
type t1 = own "u64" value u64 { 0: u64 }
static d0 = align 1 hex 6964           ; a descriptor's identity bytes
sig g0 = (u32) -> (u32)
sig g1 = (u64) -> (u64)
sig g2 = (u32, u32) -> (u32, u32)
sig g3 = (u32, u64) -> (u64)
sig g4 = () -> (bool, bool)
inst n0 = samples@0/calls/id [t0] []
inst n1 = samples@0/calls/id [t1] []
inst n2 = samples@0/calls/divmod [] []
inst n3 = samples@0/calls/use [] []
inst n4 = std@1/time/ticks [] []
inst n5 = samples@0/calls/same [] []
fn f0 = n0 g0 {
b0(v0: u32):
  return v0
}
fn f1 = n1 g1 {
b0(v0: u64):
  return v0
}
fn f2 = n2 g2 {
b0(v0: u32, v1: u32):
  v2: u32 = div v0, v1
  v3: u32 = rem v0, v1
  return v2, v3                        ; two results: the C struct-return of (u32, u32)
}
fn f3 = n3 g3 {
b0(v0: u32, v1: u64):
  v2: u32 = const 10
  v3: u32, v4: u32 = call f2 g2 (v0, v2) at i2 45..58
  v5: u32 = call f0 g0 (v3) at i2 70..75
  v6: u32 = add v5, v4 at i2 70..79
  v7: u64 = widen v6
  v8: ptr = fnref f1
  v9: u64 = call v8 g1 (v1) at i2 83..88
  v10: u64 = add v7, v9 at i2 60..88
  return v10
}
fn f4 = n4 g1 extern
fn f5 = n5 g4 {
b0:
  v0: ptr = descriptor f1, d0          ; a StaticFn: the descriptor's address
  v1: ptr = descriptor f1, d0
  v2: ptr = descriptor f0, d0
  v3: bool = eq v0, v1
  v4: bool = eq v0, v2
  return v3, v4
}

// rule: STORE-9
// expect: run
// SER-2 merges equal record representations. Renaming A.value must split
// that shared descriptor node while keeping B.value unchanged.
fn rename_left(mut tx: store.Tx, info: store.CallInfo, none: ()) -> Result[
  (),
  store.TxError
] {
  let a: table.Table[u32, table_models@1/model.Pair] = table.named("pairs")
  table.create(mut tx, a)?
  table.put(
    mut tx,
    a,
    1,
    table_models@1/model.Pair(
      left: table_models@1/model.A(value: 7),
      right: table_models@1/model.B(value: 8)
    )
  )?
  table.rename(
    mut tx,
    "pairs",
    "table_models/model/A.value",
    "table_models/model/A.count"
  )?
  Ok(())
}

fn read_pair(mut tx: store.Tx, info: store.CallInfo, none: ()) -> Result[
  Option[table_models@2/model.Pair],
  store.TxError
] {
  let b: table.Table[u32, table_models@2/model.Pair] = table.named("pairs")
  table.get(tx, b, 1)
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  let setup = store.transact(mut s, rename_left, ())
  check(setup == Ok(()))?
  let read = store.transact(mut s, read_pair, ())
  check(read == Ok(
      Some(
        table_models@2/model.Pair(
          left: table_models@2/model.A(count: 7),
          right: table_models@2/model.B(value: 8)
        )
      )
    ))?
  Ok(())
}

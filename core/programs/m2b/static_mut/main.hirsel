fn number(mut tx: mutlib.lib.Tx, take a: u64, n: u64) -> Result[u64, u64] {
    tx.writes += n;
    Ok(a + 1u64)
}

fn text(mut tx: mutlib.lib.Tx, take a: String, n: u64) -> Result[String, u64] {
    tx.writes += n;
    Ok(take a)
}

pub fn case_cross_number() -> u64 {
    let mut tx = mutlib.lib.Tx(writes: 1u64, text: string.from("held"));
    let a = 7u64;
    let n = result.unwrap(mutlib.lib.adapt_mtv(code.describe(number), mut tx, take a, 2u64));
    tx.writes * 10u64 + n
}

pub fn case_cross_text() -> u64 {
    let mut tx = mutlib.lib.Tx(writes: 1u64, text: string.from("held"));
    let a = string.from("ok");
    let s = result.unwrap(mutlib.lib.adapt_mtv(code.describe(text), mut tx, take a, 2u64));
    tx.writes * 10u64 + list.len(string.as_bytes(s))
}

pub fn main(argv: Args, out: Stdout) -> Result[(), Exit] {
    Ok(())
}

pub fn case_probe_transaction() -> u64 {
    match mutprobe4.main.main() {
        Ok(()) => 0u64,
        Error(e) => {
            let code: u64 = int.widen(e.status);
            code + 100u64
        }
    }
}

pub fn case_probe_generic() -> u64 {
    match mutprobe8.main.main() {
        Ok(()) => 0u64,
        Error(e) => {
            let code: u64 = int.widen(e.status);
            code + 100u64
        }
    }
}

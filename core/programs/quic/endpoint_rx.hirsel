fn span(input: Bytes, r: codec.Span) -> Bytes {
    clone(list.slice(input, r.at, r.at + r.len))
}

fn route(e: Endpoint, h: codec.Header, from: Addr, wire: Bytes) -> Option[u64] {
    let dcid = list.slice(wire, h.destination.at, h.destination.at + h.destination.len)
    if let Some(i) = map.get(e.cids, dcid) {
        return Some(i)
    }
    if h.kind == Initial {
        if let Some(i) = map.get(e.initial_cids, (from, clone(dcid))) {
            return Some(i)
        }
    }
    None
}

fn can_queue_reply(e: Endpoint) -> bool {
    list.len(e.stateless) < order.max(1u64, int.widen(e.config.limits.connections))
}

fn negotiation(mut e: Endpoint, now: u64, from: Addr, h: codec.Header, wire: Bytes, mut events: List[Event]) {
    if h.kind == OtherVersion {
        if can_queue_reply(e) {
            let dest = span(wire, h.source)
            let source = span(wire, h.destination)
            let mut response: Bytes = list.with_capacity(7 + list.len(dest) + list.len(source) + 4)
            let mut versions: List[u32] = list.with_capacity(1)
            list.push(mut versions, 1)
            if let Ok(()) = codec.write_negotiation(dest, source, versions, mut response) {
                list.push(mut e.stateless, Stateless(peer: from, wire: take response))
            }
        } else {
            dropped(mut e.drops, UnsupportedVersion)
        }
        return
    }
    let Some(i) = route(e, h, from, wire) else {
        dropped(mut e.drops, VersionNegotiation)
        return
    }
    if let Some(mut c) = e.connections[i] {
        if let Server = c.side {
            dropped(mut e.drops, VersionNegotiation)
            return
        }
        if c.peer != from || c.authenticated || !open_life(c) || list.slice(wire, h.source.at, h.source.at + h.source.len) != c.original_id {
            dropped(mut e.drops, VersionNegotiation)
            return
        }
        let mut at = h.body.at
        while at < h.body.at + h.body.len {
            if (list.word_be(wire, at) : u32) == 1 {
                dropped(mut e.drops, VersionNegotiation)
                return
            }
            at += 4
        }
        start_draining(mut c, now)
        list.push(mut events, Closed(c.handle, Refused(Version)))
    }
}

fn receive_known(mut c: Connection, now: u64, from: Addr, h: codec.Header, mut wire: Bytes, mut plain: Bytes, random: Random, mtu: u16, ecn: u8, mut events: List[Event]) -> Result[(), DropReason] {
    let moved = from != c.peer
    if moved && !may_migrate(c, h.kind) {
        return Error(WrongPath)
    }
    if !c.validated && !moved {
        c.path_received = int.saturating_add(c.path_received, h.packet.len)
    }
    if let Draining = c.life {
        return Error(Draining)
    }
    if h.kind != OneRtt && c.authenticated && list.slice(wire, h.source.at, h.source.at + h.source.len) != c.peer_id {
        return Error(UnknownConnection)
    }
    if now >= c.keys.previous_until {
        c.keys.previous = None
    }
    let largest = c.application.largest
    let opened = open_for_connection(c, h, mut wire, mut plain)?
    if let Next = opened.phase {
        commit_receive_update(mut c, now, opened.number)
    }
    let number = opened.number
    accept_packet(mut c, now, h, opened, wire, plain, random, mtu, ecn, mut events)?
    let newest = match largest {
        Some(l) => number > l,
        None => true,
    }
    if moved && newest && !c.probing_only && open_life(c) {
        migrate(mut c, now, from, h.packet.len, random)
    }
    Ok(())
}

fn receive_existing(mut e: Endpoint, i: u64, now: u64, from: Addr, ecn: u8, h: codec.Header, mut wire: Bytes, mut events: List[Event]) {
    let mut failed: Option[DropReason] = None
    let mut reset_peer: Option[Addr] = None
    let mut released: List[Bytes] = list.new()
    if let Some(mut c) = e.connections[i] {
        let before = established(c)
        let awaiting = match c.side {
            Server => !before,
            Client => false,
        }
        c.streams.datagram_room = e.datagram_room
        let outcome = receive_known(mut c, now, from, h, mut wire, mut e.plain, e.random, e.config.max_mtu, ecn, mut events)
        e.datagram_room = c.streams.datagram_room
        dropped_many(mut e.drops, DatagramBuffer, replace(mut c.streams.datagrams_refused, 0))
        released = replace(mut c.streams.cids.released, list.new())
        let finished = awaiting && established(c)
        if finished {
            e.unconfirmed -= 1
            let _ = map.remove(mut e.initial_cids, (c.peer, clone(c.initial_id)))
        }
        if !before && established(c) {
            if let Some(_) = c.peer_reset {
                reset_peer = Some(c.peer)
            }
        }
        if let Error(reason) = outcome {
            if reason == PacketProtection {
                note_failed_open(mut c, now, mut events)
            }
            failed = Some(reason)
        }
    }
    unmap_released(mut e, i, released)
    if let Some(peer) = reset_peer {
        note_reset_peer(mut e, peer, i)
    }
    if let Some(reason) = failed {
        if h.kind == OneRtt && (reason == PacketProtection || reason == SampleTooShort) {
            if routed_reset(mut e, i, now, from, mut events) {
                return
            }
        }
        dropped(mut e.drops, reason)
    }
}

/// A stateless Initial CONNECTION_CLOSE: CONNECTION_REFUSED (0x02) at a limit,
/// INVALID_TOKEN (0x0b) for a Retry token that fails (RFC 9000 §8.1.2).
fn refuse_initial(mut e: Endpoint, mut c: Connection, code: u64) {
    if !can_queue_reply(e) {
        return
    }
    let mut wire: Bytes = list.with_capacity(1200)
    if let Some(_) = tx_space(mut c.initial, mut c.streams, false, Initial, c.peer_id, c.local_id, false, Some(transport_close(code, 0)), 1200, 0, false, mut wire) {
        list.push(mut e.stateless, Stateless(peer: c.peer, wire: take wire))
    }
}

fn admit(mut e: Endpoint, now: u64, from: Addr, ecn: u8, h: codec.Header, mut wire: Bytes, mut events: List[Event]) {
    let (id, t): (handshake.Identity, TransportConfig) = match e.server {
        Some((id, t)) => (share_identity(id), clone(t)),
        None => {
            dropped(mut e.drops, UnknownConnection)
            return
        },
    }
    let dcid = span(wire, h.destination)
    let verdict = check_token(e, now, from, span(wire, h.token), dcid)
    let invalid = match verdict {
        Invalid => true,
        _ => false,
    }
    let no_token = match verdict {
        NoToken => true,
        _ => false,
    }
    let (original, retried, validated) = match take verdict {
        Retried(take odcid) => (take odcid, true, true),
        Address => (clone(dcid), false, true),
        _ => (clone(dcid), false, false),
    }
    if !retried && h.destination.len < 8 {
        dropped(mut e.drops, MalformedHeader)
        return
    }
    if no_token {
        if retry_due(e) {
            send_retry(mut e, now, from, h, wire)
            return
        }
    }
    let mut c = match new_connection(ConnectionHandle(0), Server, from, draw_local_id(e), clone(dcid), take original, span(wire, h.source), take t, Some(take id), now) {
        Ok(take c) => take c,
        Error(_) => return,
    }
    c.reset = reset_token(e.config.reset_key, c.local_id)
    match open_for_connection(c, h, mut wire, mut e.plain) {
        Error(reason) => dropped(mut e.drops, reason),
        Ok(opened) => {
            if invalid {
                refuse_initial(mut e, mut c, 0x0b)
                return
            }
            let Ok(handle) = reserve_handle(e) else {
                refuse_initial(mut e, mut c, 0x02)
                return
            }
            if e.unconfirmed >= int.widen(e.config.limits.unvalidated) {
                refuse_initial(mut e, mut c, 0x02)
                return
            }
            c.handle = handle
            if retried {
                c.retry_source = Some(clone(dcid))
            }
            c.validated = validated
            c.path_received = h.packet.len
            let _ = accept_packet(mut c, now, h, opened, wire, e.plain, e.random, e.config.max_mtu, ecn, mut events)
            add_connection(mut e, take c)
        },
    }
}

fn header_drop(err: codec.CodecError) -> DropReason {
    match err {
        DatagramTooShort => DatagramTooShort,
        SmallInitial => SmallInitial,
        SmallUnsupportedVersion => SmallUnsupportedVersion,
        UnexpectedVersionNegotiation => VersionNegotiation,
        UnsupportedVersion => UnsupportedVersion,
        _ => MalformedHeader,
    }
}

fn dispatch(mut e: Endpoint, now: u64, from: Addr, ecn: u8, h: codec.Header, mut wire: Bytes, mut events: List[Event]) {
    if h.kind == Initial || h.kind == Handshake || h.kind == OneRtt {
        if let Some(i) = route(e, h, from, wire) {
            receive_existing(mut e, i, now, from, ecn, h, mut wire, mut events)
        } else if h.kind == Initial {
            admit(mut e, now, from, ecn, h, mut wire, mut events)
        } else if h.kind == OneRtt {
            short_unroutable(mut e, now, from, h, wire, mut events)
        } else {
            dropped(mut e.drops, UnknownConnection)
        }
    } else if h.kind == Retry && !server_side(e) {
        client_retry(mut e, now, from, h, wire)
    } else if h.kind == Negotiation || h.kind == OtherVersion {
        negotiation(mut e, now, from, h, wire, mut events)
    } else {
        dropped(mut e.drops, KeysUnavailable)
    }
}

/// The caller lends a receive buffer. Header protection is removed only in the
/// addressed packet, and AEAD reads exactly that packet even in a coalesced datagram.
pub fn receive_datagram(mut e: Endpoint, now: u64, from: Addr, ecn: u8, mut buf: Bytes, at: u64, len: u64, mut events: List[Event]) {
    if at > list.len(buf) || len > list.len(buf) - at {
        dropped(mut e.drops, MalformedHeader)
        return
    }
    let end = at + len
    let mut next = at
    e.datagram_room = datagram_room(e, events)
    let server = match e.server {
        Some(_) => true,
        None => false
    }
    let first = match codec.read_first_header(buf, mut next, end, e.config.cid_len, server) {
        Ok(take h) => take h,
        Error(err) => {
            dropped(mut e.drops, header_drop(err))
            return
        },
    }
    // Kept before header protection is removed in place: a stateless reset is
    // recognized by these 16 bytes (RFC 9000 §10.3.1).
    list.truncate(mut e.tail, 0)
    if first.kind == OneRtt {
        list.append(mut e.tail, list.slice(buf, end - 16, end))
    }
    dispatch(mut e, now, from, ecn, first, mut buf, mut events)
    while next < end {
        let start = next
        match codec.read_coalesced_header(buf, mut next, end, e.config.cid_len, first.destination) {
            Ok(h) => {
                if server && h.kind == Initial && len < 1200 {
                    dropped(mut e.drops, SmallInitial)
                } else {
                    dispatch(mut e, now, from, ecn, h, mut buf, mut events)
                }
            },
            Error(err) => dropped(mut e.drops, header_drop(err)),
        }
        if next <= start {
            break
        }
    }
}

fn share_identity(id: handshake.Identity) -> handshake.Identity {
    match id {
        Identity(chain: chain, key: key, alg: alg) => Identity(chain: clone(chain), key: secret.share(key), alg: alg),
    }
}

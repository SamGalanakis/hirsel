// The Bucket host stream's plan, its refusals, the service handle and a
// Place's slot (STORE-SPEC §12.11.1, §12.11.12).
pub type Batching: cross {
    max_wait_ms: u64,
    max_batch_bytes: u64
}

pub type StreamLimits: cross {
    max_slots: u32,
    max_pins: u32,
    hold_ms: u64,
    idle_poll_ms: u64,
    index_every: u64,
    pin_ttl_s: u64,
    slot_bytes: u64
}

pub type StreamPlan: cross {
    sid: HostStreamId,
    prefix: String,
    batching: Batching,
    limits: StreamLimits
}

pub type StreamRoot: cross {
    prefix: String
}

// What a Place sends on its slot: its attachment with its Place prefix and the
// connection the service answers on, then each frame as its first chunk and the rest.
type SlotMsg: cross = SlotAttach(u64, u64, u64, String, Client[SlotAck]) | SlotFrame(u64, u64, Bytes) | SlotMore(Bytes)

// The service's answers: the grant (inc, next_seq), the last ticket sequence
// decided acked with its batch seq, a stall head-poll ask, an unhold settle
// ask (settle_id, through_seq, next_seq), a fenced verdict (epoch, ok_through,
// missing_evidence), or the incarnation's latch.
type SlotAck: cross = SlotGranted(u64, u64) | SlotAcked(u64, u64) | SlotPollHead | SlotSettle(u64, u64, u64) | SlotFenced(u64, u64, bool) | SlotLatched(StreamLatch)

// Out-of-band head reports from a Place to the service (§12.11.12), carried on
// a dedicated shared connection so queued frames on a stalled slot never block
// settle, cut or fence replies.
type SlotReport: cross = ReportSettled(u32, u64, bool, u64, u64, u32) | ReportFenced(u32, u64, u64, Option[u64]) | ReportDetached(u32, u64) | ReportHead(u32, u64, u64, u64, u64, HeadRanges)

// The doorbell item that wakes the service for its control channel.
const STREAM_CONTROL_RING: u32 = 0xFFFFFFFF

// Fund two full frame chunks in a slot. Round down so MEM-24's rounded
// byte charges for both chunks fit even when slot_bytes is unaligned.
const STREAM_SLOT_CHUNKS: u64 = 2

const STREAM_SLOT_ACKS: u64 = 8

const STREAM_CONNECTION_BASE: u64 = 64

const STREAM_MIN_SLOT_BYTES: u64 = 4096

fn stream_slot_chunk(room: u64) -> u64 {
    room / STREAM_SLOT_CHUNKS / bytes[u64] * bytes[u64]
}

// The service's own ring when its stall poll is due (§12.11.13), and the
// alarm task that rings it.
const STREAM_POLL_RING: u32 = 0xFFFFFFFE

const STREAM_TIMER_BYTES: u64 = 4096

type ServiceControl: send = NewSlot(Sender[Result[(Client[SlotMsg], u32), Error]]) | NewReservedSlot(Sender[Result[(Client[SlotMsg], u32), Error]]) | JanitorPoll(Sender[List[JanitorAsk]]) | JanitorStill(JanitorAsk, Sender[bool]) | StopService

// One Place's data connection client, the doorbell, the report connection,
// and the stream it names (§12.11.12). `root` is the stream root as a key
// prefix in the bucket.
pub opaque type JournalSlot: cross {
    data: Client[SlotMsg],
    bell: Client[u32],
    reports: Client[SlotReport],
    slot: u32,
    sid: HostStreamId,
    endpoint: String,
    aws_region: String,
    bucket: String,
    root: String,
    slot_bytes: u64,
    max_batch_bytes: u64,
    max_rows: u64
}

pub opaque type JournalService {
    task: Task[StreamServiceEnd],
    control: Sender[ServiceControl],
    bell: Client[u32],
    reports: Client[SlotReport],
    workers: Option[std.object.Workers],
    sid: HostStreamId,
    endpoint: String,
    aws_region: String,
    bucket: String,
    root: String,
    slot_bytes: u64,
    max_batch_bytes: u64,
    max_rows: u64
}

// The bytes the service task runs in: the batch buffer, the batch's slice
// octets and the 412 compare (each `max_batch_bytes`), its register
// buffers, the doorbell, the stall poll's alarm, and per slot its room and
// ack item (§12.11.12).
pub fn stream_service_bytes(plan: StreamPlan) -> u64 {
    let batch = int.saturating_add(plan.batching.max_batch_bytes, BINDING_BYTES + 64)
    let reg = REG_LIMIT + 88 + BINDING_BYTES + 64
    let slots: u64 = int.widen(plan.limits.max_slots)
    let room = plan.limits.slot_bytes
    let slot_headers = STREAM_CONNECTION_BASE + STREAM_SLOT_CHUNKS * bytes[SlotMsg] + bytes[ServiceSlot]
    let per_slot = int.saturating_add(room, slot_headers + stream_slot_chunk(room))
    let fixed = STREAM_CONNECTION_BASE + (slots + 1) * bytes[u32] + STREAM_SERVICE_FIXED + STREAM_TIMER_BYTES
    let buffers = int.saturating_mul(3, order.max(batch, reg))
    int.saturating_add(int.saturating_add(buffers, fixed), int.saturating_mul(slots, per_slot))
}

const STREAM_SERVICE_FIXED: u64 = 262144

fn stream_plan_check(plan: StreamPlan, op_ms: u64) -> Result[(), Error] {
    if string.byte_len(plan.prefix) > 1024 {
        return Error(Limit(Name))
    }
    let limits = plan.limits
    let batch = plan.batching.max_batch_bytes
    if batch < LIMIT_VALUE_FLOOR + LIMIT_FRAME_ROOM + stream_batch_overhead(1) || batch > 4294967296 {
        return Error(Stream(Bound(MaxBatchBytes)))
    }
    let slots: u64 = int.widen(limits.max_slots)
    if slots == 0 || slots > STREAM_MAX_SLOTS {
        return Error(Stream(Bound(MaxSlots)))
    }
    if limits.hold_ms / 4 < op_ms {
        return Error(Stream(Bound(HoldMs)))
    }
    if limits.idle_poll_ms == 0 || limits.idle_poll_ms > limits.hold_ms {
        return Error(Stream(Bound(IdlePollMs)))
    }
    if limits.index_every == 0 {
        return Error(Stream(Bound(IndexEvery)))
    }
    if limits.slot_bytes < STREAM_MIN_SLOT_BYTES {
        return Error(Stream(Bound(SlotBytes)))
    }
    if limits.max_pins < 2 {
        return Error(Stream(Bound(MaxPins)))
    }
    Ok(())
}

// The stream root as a key prefix: the plan's prefix with one `/` after it.
fn stream_root_dir(plan_prefix: String) -> String {
    let mut dir = string.with_capacity(string.byte_len(plan_prefix) + 1)
    string.push(mut dir, plan_prefix)
    if string.byte_len(plan_prefix) != 0 && !string.ends_with(plan_prefix, "/") {
        string.push_char(mut dir, '/')
    }
    take dir
}

// Keys under one prefix are listed by the other when either is a prefix of
// the other, so the Place's genesis LIST and the stream's keys would meet.
fn stream_overlaps(place: String, root: String) -> bool {
    string.starts_with(place, root) || string.starts_with(root, place)
}

fn stream_authority_parts(a: Authority) -> Result[(u8, u64, bool), Error] {
    match a {
        ObjectAuthority(config) => Ok((1u8, config.op_ms, false)),
        SimAuthority(config) => match config.sim {
            Some((names, _)) if list.len(names) != 0 => Ok((2u8, config.op_ms, true)),
            _ => Ok((2u8, config.op_ms, false)),
        },
        LogAuthority(_) => Error(Unsupported(0)),
    }
}

// Starts the host stream's service (§12.11.1): every refusal is decided
// before any request; then the task creates or re-elects the stream (§12.11.7)
// before this returns.
pub fn journal_service(tasks: Tasks, take a: Authority, plan: StreamPlan, budget: u64, c: Clock, r: Random) -> Result[JournalService, Refusal] waits {
    let checked: Result[(u8, u64), Error] = match stream_authority_parts(a) {
        Ok((_, _, true)) => Error(Stream(WeakLevels)),
        Ok((kind, op_ms, false)) => match stream_plan_check(plan, op_ms) {
            Ok(()) => Ok((kind, op_ms)),
            Error(take e) => Error(take e),
        },
        Error(take e) => Error(take e),
    }
    let (kind, op_ms) = match take checked {
        Ok(parts) => parts,
        Error(take e) => return Error(Refusal(error: take e, authority: take a)),
    }
    let wanted = stream_service_bytes(plan)
    if budget < wanted {
        return Error(Refusal(error: Full(Allocation(Capacity(requested: wanted, available: budget))), authority: take a))
    }
    let holder = match capacity(disk_identity(r)) {
        Ok(id) => id,
        Error(take e) => return Error(Refusal(error: take e, authority: take a)),
    }
    let config = match take a {
        ObjectAuthority(take config) => take config,
        SimAuthority(take config) => take config,
        LogAuthority(_) => fail("journal_service: a log authority passed the check"),
    }
    let ObjectAuthorityConfig(client: take client, level_name: take level_name, op_ms: _, sim: take sim, stream: take stream, stream_root: take stream_root, cache) = take config
    let home = std.object.bucket_config(client)
    let mut root = string.with_capacity(string.byte_len(home.prefix) + string.byte_len(plan.prefix) + 1)
    string.push(mut root, home.prefix)
    string.push(mut root, stream_root_dir(plan.prefix))
    let slots: u64 = int.widen(plan.limits.max_slots)
    let made: Result[(Client[u32], Inbox[u32]), Capacity] = conn.new(slots + 1, bytes 0)
    let (take bell, take rings) = match take made {
        Ok(take pair) => take pair,
        Error(e) => return Error(Refusal(error: Full(Allocation(e)), authority: stream_rewrap(kind, take client, take level_name, op_ms, take sim, take stream, take stream_root, cache))),
    }
    let made_reports: Result[(Client[SlotReport], Inbox[SlotReport]), Capacity] = conn.new(2 * slots + 4, bytes 0)
    let (take report_client, take report_inbox) = match take made_reports {
        Ok(take pair) => take pair,
        Error(e) => return Error(Refusal(error: Full(Allocation(e)), authority: stream_rewrap(kind, take client, take level_name, op_ms, take sim, take stream, take stream_root, cache))),
    }
    let (control_send, control_receive): (Sender[ServiceControl], Receiver[ServiceControl]) = channel.new(slots + 1)
    let (ready_send, ready_receive): (Sender[Result[(), Error]], Receiver[Result[(), Error]]) = channel.new(1)
    let (take requests, take workers) = std.object.split(take client)
    let input = StreamServiceInput(requests: take requests, clock: c, plan: clone(plan), dir: stream_root_dir(plan.prefix), authority_kind: kind, holder, op_ms, control: take control_receive, rings: take rings, reports: take report_inbox, ready: take ready_send, tasks, bell: conn.client(bell))
    let running = match task.try_spawn(tasks, bytes budget, take input, stream_service_task) {
        Ok(take handle) => take handle,
        Error((problem, take back)) => {
            let StreamServiceInput(requests: take returned, ..) = take back
            let restored = std.object.attach(take returned, take workers)
            return Error(Refusal(error: Full(Allocation(problem)), authority: stream_rewrap(kind, take restored, take level_name, op_ms, take sim, take stream, take stream_root, cache)))
        },
    }
    let started = match channel.receive(ready_receive) {
        Ok(take outcome) => take outcome,
        Error(_) => Error(Io(Closed)),
    }
    if let Error(take problem) = started {
        let ended = task.join(take running)
        return match take ended {
            Ok(StreamServiceEnd(requests: take returned, ..)) => {
                let restored = std.object.attach(take returned, take workers)
                Error(Refusal(error: take problem, authority: stream_rewrap(kind, take restored, take level_name, op_ms, take sim, take stream, take stream_root, cache)))
            },
            Error(_) => fail("journal_service: the service task failed at its start"),
        }
    }
    Ok(JournalService(task: take running, control: take control_send, bell: take bell, reports: take report_client, workers: take workers, sid: plan.sid, endpoint: string.from(home.endpoint), aws_region: string.from(home.aws_region), bucket: string.from(home.bucket), root: take root, slot_bytes: plan.limits.slot_bytes, max_batch_bytes: plan.batching.max_batch_bytes, max_rows: 2 * slots))
}

fn stream_rewrap(kind: u8, take client: std.object.Client, take level_name: String, op_ms: u64, take sim: Option[(List[String], LevelSync)], take stream: Option[JournalSlot], take stream_root: Option[String], cache: Option[ObjectsCache]) -> Authority {
    wrap_object_authority(ObjectAuthorityConfig(client: take client, level_name: take level_name, op_ms, sim: take sim, stream: take stream, stream_root: take stream_root, cache), kind)
}

// One Place's slot (§12.11.12): the service creates its data connection, so
// its room is charged to the service. One slot stays the janitor's.
pub fn journal_slot(mut s: JournalService) -> Result[JournalSlot, Error] waits {
    journal_slot_kind(mut s, false)
}

// The reserved janitor slot (§12.11.8 A5): uses the reserved `max_slots`-th
// slot and is never refused by `max_pins`.
fn journal_reserved_slot(mut s: JournalService) -> Result[JournalSlot, Error] waits {
    journal_slot_kind(mut s, true)
}

fn journal_slot_kind(mut s: JournalService, reserved: bool) -> Result[JournalSlot, Error] waits {
    let (reply_send, reply_receive): (Sender[Result[(Client[SlotMsg], u32), Error]], Receiver[Result[(Client[SlotMsg], u32), Error]]) = channel.new(1)
    let req = if reserved {
        NewReservedSlot(take reply_send)
    } else {
        NewSlot(take reply_send)
    }
    if let Error(_) = channel.send(s.control, take req) {
        return Error(Io(Closed))
    }
    if let Error(_) = conn.send(s.bell, STREAM_CONTROL_RING) {
        return Error(Io(Closed))
    }
    let (take data, slot) = match channel.receive(reply_receive) {
        Ok(Ok(take granted)) => take granted,
        Ok(Error(take e)) => return Error(take e),
        Error(_) => return Error(Io(Closed)),
    }
    Ok(JournalSlot(data: take data, bell: conn.client(s.bell), reports: conn.client(s.reports), slot, sid: s.sid, endpoint: string.from(s.endpoint), aws_region: string.from(s.aws_region), bucket: string.from(s.bucket), root: string.from(s.root), slot_bytes: s.slot_bytes, max_batch_bytes: s.max_batch_bytes, max_rows: s.max_rows))
}

// Whether an ask's cause still holds at the service (§12.11.6 A4): the Held
// row of its Store at the ask's epoch, or its Store's pin.
fn journal_janitor_still(mut s: JournalService, ask: JanitorAsk) -> Result[bool, Error] waits {
    let (reply_send, reply_receive): (Sender[bool], Receiver[bool]) = channel.new(1)
    let asked: JanitorAsk = clone(ask)
    if let Error(_) = channel.send(s.control, JanitorStill(take asked, take reply_send)) {
        return Error(Io(Closed))
    }
    if let Error(_) = conn.send(s.bell, STREAM_CONTROL_RING) {
        return Error(Io(Closed))
    }
    match channel.receive(reply_receive) {
        Ok(still) => Ok(still),
        Error(_) => Error(Io(Closed)),
    }
}

// Drains pending janitor asks from the service (orphan Held rows at `hold_ms`
// and straggler pins at `pin_ttl_s` or `max_pins`, §12.11.6 A4 & §12.11.8 M9).
fn journal_janitor_asks(mut s: JournalService) -> Result[List[JanitorAsk], Error] waits {
    let (reply_send, reply_receive): (Sender[List[JanitorAsk]], Receiver[List[JanitorAsk]]) = channel.new(1)
    if let Error(_) = channel.send(s.control, JanitorPoll(take reply_send)) {
        return Error(Io(Closed))
    }
    if let Error(_) = conn.send(s.bell, STREAM_CONTROL_RING) {
        return Error(Io(Closed))
    }
    match channel.receive(reply_receive) {
        Ok(take asks) => Ok(take asks),
        Error(_) => Error(Io(Closed)),
    }
}

// A writer Authority whose opens attach to the slot's stream (§12.11.1).
// Its refusals are configuration errors and consume the Authority.
pub fn streamed(take a: Authority, take slot: JournalSlot) -> Result[Authority, Error] {
    let (kind, _, weak) = stream_authority_parts(a)?
    if weak {
        return Error(Stream(WeakLevels))
    }
    let mut config = match take a {
        ObjectAuthority(take config) => take config,
        SimAuthority(take config) => take config,
        LogAuthority(_) => return Error(Unsupported(0)),
    }
    let place = std.object.bucket_config(config.client)
    if place.endpoint != slot.endpoint || place.aws_region != slot.aws_region || place.bucket != slot.bucket {
        return Error(Foreign)
    }
    if stream_overlaps(place.prefix, slot.root) {
        return Error(Stream(Overlap))
    }
    config.stream = Some(take slot)
    config.stream_root = None
    Ok(wrap_object_authority(take config, kind))
}

// A read-only Authority for followers, `open_read_only`, scrub or verify on
// attached Places (§12.11.1, §12.11.9). Never elects, takes no slot and never
// writes the register.
pub fn stream_reader(take a: Authority, root: StreamRoot) -> Result[Authority, Error] {
    let (kind, _, weak) = stream_authority_parts(a)?
    if weak {
        return Error(Stream(WeakLevels))
    }
    if string.byte_len(root.prefix) > 1024 {
        return Error(Limit(Name))
    }
    let mut config = match take a {
        ObjectAuthority(take config) => take config,
        SimAuthority(take config) => take config,
        LogAuthority(_) => return Error(Unsupported(0)),
    }
    let place = std.object.bucket_config(config.client)
    let dir = stream_root_dir(root.prefix)
    if stream_overlaps(place.prefix, dir) {
        return Error(Stream(Overlap))
    }
    config.stream = None
    config.stream_root = Some(take dir)
    Ok(wrap_object_authority(take config, kind))
}

// Stops the service. Every slot's Place should be closed first: a frame
// still queued is never acked.
pub fn close_journal_service(take s: JournalService) -> Result[(), Error] waits {
    let JournalService(task: take running, control: take control, bell: take bell, workers: take workers, ..) = take s
    let _ = channel.send(control, StopService)
    let _ = conn.send(bell, STREAM_CONTROL_RING)
    let ended = match task.join(take running) {
        Ok(StreamServiceEnd(result: take outcome, ..)) => take outcome,
        Error(_) => Error(Io(Closed)),
    }
    let _ = take workers
    take ended
}

// The Place side of an attached open: its slot and the connection the
// service answers on (§12.11.12). `inc` is the incarnation that granted it.
// `root` is the stream root from the bucket's top and `max_rows` the
// register bound a claimant's hold applies (§12.11.2). `last_batch_seq` tracks
// the highest batch seq acked for this Place.
type SlotLink: send {
    data: Client[SlotMsg],
    bell: Client[u32],
    reports: Client[SlotReport],
    slot: u32,
    sid: HostStreamId,
    chunk: u64,
    max_batch_bytes: u64,
    answers: Option[Inbox[SlotAck]],
    answer_client: Option[Client[SlotAck]],
    inc: u64,
    last_batch_seq: u64,
    commit_batches: List[u64],
    root: String,
    max_rows: u64
}

fn slot_link(slot: JournalSlot) -> Result[SlotLink, Error] {
    let made: Result[(Client[SlotAck], Inbox[SlotAck]), Capacity] = conn.new(STREAM_SLOT_ACKS, bytes 0)
    let (take answer_client, take answers) = capacity(take made)?
    Ok(SlotLink(data: conn.client(slot.data), bell: conn.client(slot.bell), reports: conn.client(slot.reports), slot: slot.slot, sid: slot.sid, chunk: stream_slot_chunk(slot.slot_bytes), max_batch_bytes: slot.max_batch_bytes, answers: Some(take answers), answer_client: Some(take answer_client), inc: 0, last_batch_seq: 0, commit_batches: list.new(), root: string.from(slot.root), max_rows: slot.max_rows))
}

fn slot_ring(link: SlotLink) {
    let _ = conn.try_send(link.bell, link.slot)
}

fn slot_report(link: SlotLink, take report: SlotReport) {
    let _ = conn.try_send(link.reports, take report)
    slot_ring(link)
}

fn slot_report_head(link: SlotLink, store: StoreId, attach: Option[Attach], obs_seq: u64) {
    let ranges = stream_attach_head_ranges(attach, link.sid)
    slot_report(link, ReportHead(link.slot, store.hi, store.lo, link.inc, obs_seq, ranges))
}

// Forwards service answers on a Place's reply connection into the Place's
// journal worker channel so an idle or stalled Place reacts without blocking.
type SlotRelayInput: send {
    answers: Inbox[SlotAck],
    journal: Sender[JournalMsg]
}

fn slot_relay(take input: SlotRelayInput) waits {
    let SlotRelayInput(answers: take answers, journal: take journal) = take input
    loop {
        match conn.receive(answers) {
            Ok(take ack) => {
                if let Error(_) = channel.send(journal, StreamAnswer(take ack)) {
                    return
                }
            },
            Error(_) => return,
        }
    }
}

// The grant (§12.11.5): the service registers (store, epoch, place_prefix) on
// this slot and names its incarnation and the next_seq batch seq.
fn slot_attach(mut link: SlotLink, store: StoreId, epoch: u64, place_prefix: String, limits: StoreLimits) -> Result[(u64, u64), Error] waits {
    if limits.frame + stream_batch_overhead(1) > link.max_batch_bytes {
        return Error(Stream(Bound(MaxBatchBytes)))
    }
    // The service holds the only answer client, so a service that ends
    // closes the Place's answers.
    let Some(take answer_client) = replace(mut link.answer_client, None) else {
        return Error(disk_fault("slot", 0, Malformed))
    }
    if let Error(_) = conn.send(link.data, SlotAttach(store.hi, store.lo, epoch, string.from(place_prefix), take answer_client)) {
        return Error(Io(Closed))
    }
    slot_ring(link)
    let Some(answers) = view link.answers else {
        return Error(disk_fault("slot", 0, Malformed))
    }
    match conn.receive(answers) {
        Ok(SlotGranted(inc, next_seq)) => {
            link.inc = inc
            if next_seq > 0 && link.last_batch_seq + 1 < next_seq {
                link.last_batch_seq = next_seq - 1
            }
            Ok((inc, next_seq))
        },
        Ok(SlotLatched(cause)) => Error(Latched(cause)),
        Ok(_) => Error(disk_fault("slot", 0, Malformed)),
        Error(_) => Error(Io(Closed)),
    }
}

// Sends one unsealed frame in chunks of at most half the slot's room.
fn slot_send(link: SlotLink, raw: Bytes, sequence: u64) -> Result[(), Error] waits {
    let total = list.len(raw)
    let mut at = 0u64
    loop {
        let end = order.min(at + link.chunk, total)
        let mut piece = disk_allocation(scoped fn() -> Result[Bytes, Error] {
            Ok(list.with_capacity(end - at))
        })?
        list.append(mut piece, list.slice(raw, at, end))
        let message = if at == 0 {
            SlotFrame(total, sequence, take piece)
        } else {
            SlotMore(take piece)
        }
        match conn.try_send(link.data, take message) {
            Ok(()) => (),
            Error(Full(take queued)) => {
                slot_ring(link)
                if let Error(_) = conn.send(link.data, take queued) {
                    return Error(Io(Closed))
                }
            },
            Error(Closed(_)) => return Error(Io(Closed)),
        }
        at = end
        if at >= total {
            break
        }
    }
    Ok(())
}

// Waits for the service's decision on the frames sent through `sequence`
// (used during open before the relay task takes `link.answers`).
fn slot_wait(mut link: SlotLink, sequence: u64) -> Result[(), Error] waits {
    slot_ring(link)
    let Some(answers) = view link.answers else {
        return Error(disk_fault("slot", 0, Malformed))
    }
    loop {
        match conn.receive(answers) {
            Ok(SlotAcked(through, batch_seq)) => {
                link.last_batch_seq = order.max(link.last_batch_seq, batch_seq)
                if through >= sequence {
                    return Ok(())
                }
            },
            Ok(SlotFenced(epoch, _, missing)) => return if missing {
                Error(Undecided)
            } else {
                Error(Fenced(epoch))
            },
            Ok(SlotLatched(cause)) => return Error(Latched(cause)),
            Ok(SlotPollHead) => (),
            Ok(SlotSettle(_, _, _)) => (),
            Ok(SlotGranted(_, _)) => return Error(disk_fault("slot", 0, Malformed)),
            Error(_) => return Error(Io(Closed)),
        }
    }
}

// X's CLAIM frame (§12.11.5), unsealed: the service seals it in its batch.
fn slot_claim_frame(mut raw: Bytes, epoch: u64, holder: StoreId) {
    list.clear(mut raw)
    list.put_word_le(mut raw, 0x0040u16)
    list.fill(mut raw, 14, 0u8)
    list.put_word_le(mut raw, epoch)
    list.put_word_le(mut raw, holder.hi)
    list.put_word_le(mut raw, holder.lo)
}

const EXP_NEGLN2HIN: f64 = -0.005415212348111709 // 0xbf762e42fefa0000, -ln2/N high bits

const EXP_NEGLN2LON: f64 = -1.2864023111638346e-14 // 0xbd0cf79abc9e3b3a, its low part

const EXP_SHIFT: f64 = 6755399441055744.0 // 0x4338000000000000

const EXP_C2: f64 = 0.49999999999996786 // 0x3fdffffffffffdbd

const EXP_C3: f64 = 0.16666666666665886 // 0x3fc555555555543c


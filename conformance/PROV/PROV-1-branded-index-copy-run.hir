// rule: PROV-1
// expect: run
pub opaque type Token: copyable uses {} {
  text: String,
}

fn make(a: String) -> Token of a {
  Token(text: "payload")
}

fn inspect(a: String, token: Token of a) -> bool {
  token.text == "payload"
}

fn gather(a: String) -> List[Token of a] {
  [make(a)]
}

pub fn main() -> Result[(), ()] {
  let a: String = "owner"
  let held = gather(a)
  failure.check(inspect(a, copy held[0]), TextInvariant())
  Ok(())
}

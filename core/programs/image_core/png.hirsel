const PNG_PASS: Inline[(u64, u64, u64, u64), 8] =[(0, 0, 8, 8), (4, 0, 8, 8), (0, 4, 4, 8), (2, 0, 4, 4), (0, 2, 2, 4), (1, 0, 2, 2), (0, 1, 1, 2), (0, 0, 1, 1)]

type PngData {
    scanlines: Bytes,
    palette: BoxRange,
    transparency: BoxRange
}

pub fn decode_png(input: Bytes, limits: Limits) -> Result[Raster, Error] {
    if list.len(input) > limits.max_bytes {
        return Error(ByteLimit)
    }
    match (bound steps limits.max_steps {
        decode_png_inner(input, limits)
    }) {
        Ok(value) => value,
        Error(_) => Error(WorkLimit),
    }
}

fn pass_length(full: u64, first: u64, stride: u64) -> u64 {
    if full <= first {
        0
    } else {
        1 + (full - 1 - first) / stride
    }
}

fn png_filtered_size(w: u64, h: u64, bits: u64, interlace: bool) -> Result[u64, Error] {
    let mut total = 0u64
    let start: u64 = if interlace {
        0
    } else {
        7
    }
    let end: u64 = if interlace {
        7
    } else {
        8
    }
    for pass in start .. end {
        let (x, y, dx, dy) = PNG_PASS[pass]
        let wide = pass_length(w, x, dx)
        let high = pass_length(h, y, dy)
        let row = 1 + (wide * bits + 7) / 8
        if wide != 0 && high != 0 {
            if row > (0xffffffffffffffff - total) / high {
                return Error(ByteLimit)
            }
            total += row * high
        }
    }
    Ok(total)
}

fn png_read_data(input: Bytes, size: u64, colors: u8, depth: u8) -> Result[PngData, Error] {
    let mut scanlines = alloc_bytes(size)?
    let mut decoder = std.flate.decoder(Zlib)
    let mut palette = empty_range()
    let mut trans = empty_range()
    let mut at = 33u64
    let mut state = 0u8
    let mut finished = false
    // The probe has checked every chunk extent.
    while at < list.len(input) {
        let len: u32 = list.word_be(input, at)
        let count: u64 = int.widen(len)
        let name: u32 = list.word_be(input, at + 4)
        let start = at + 8
        let end = start + count
        let crc: u32 = list.word_be(input, end)
        if std.crc32.update(0, input, at + 4, end) != crc {
            return Error(Malformed)
        }
        if name == 0x49444154 {
            if state == 2 || (colors == 3 && palette.start == 0) {
                return Error(Malformed)
            }
            state = 1
            if finished {
                if count != 0 {
                    return Error(Malformed)
                }
            } else {
                let remaining = size - list.len(scanlines)
                let decoded = std.flate.decode_step_bounded(mut decoder, input, start, end, mut scanlines, remaining)
                match decoded {
                    Ok(step) => {
                        if step.consumed != count {
                            return Error(Malformed)
                        }
                        finished = step.ended
                    },
                    Error(_) => return Error(Malformed),
                }
            }
        } else {
            if state == 1 {
                state = 2
            }
            if name == 0x504c5445 {
                let entries = count / 3
                let max_index: u64 = int.widen(depth)
                if palette.start != 0 || trans.start != 0 || state != 0 || count == 0 || count % 3 != 0 || entries > 256 || colors == 0 || colors == 4 || (colors == 3 && entries > 1u64 << max_index) {
                    return Error(Malformed)
                }
                palette = BoxRange(start: start, end: end)
            } else if name == 0x74524e53 {
                if trans.start != 0 || state != 0 {
                    return Error(Malformed)
                }
                if !png_valid_transparency(input, start, end, colors, depth, palette) {
                    return Error(Malformed)
                }
                trans = BoxRange(start: start, end: end)
            } else if name == 0x6163544c || name == 0x6663544c || name == 0x66644154 {
                return Error(Unsupported)
            } else if name != 0x49454e44 && (name & 0x20000000 == 0 || name & 0x00002000 != 0) {
                return Error(Malformed)
            }
        }
        at = end + 4
    }
    if !finished || list.len(scanlines) != size {
        return Error(Truncated)
    }
    Ok(PngData(scanlines: take scanlines, palette: palette, transparency: trans))
}

fn png_valid_transparency(input: Bytes, start: u64, end: u64, colors: u8, depth: u8, palette: BoxRange) -> bool {
    let n = end - start
    if colors == 3 {
        return n > 0 && n <= (palette.end - palette.start) / 3
    }
    if (colors == 0 && n == 2) || (colors == 2 && n == 6) {
        let shift: u64 = int.widen(depth)
        for i in 0u64 .. n / 2 {
            let sample: u64 = int.widen(tiff_short(input, start + 2 * i, false))
            if sample >= 1u64 << shift {
                return false
            }
        }
        return true
    }
    false
}

fn decode_png_inner(input: Bytes, limits: Limits) -> Result[Raster, Error] {
    let header = probe_header(input, limits)?
    if let Png = header.format {} else {
        return Error(UnknownFormat)
    }
    let depth = input[24]
    let colors = input[25]
    let channels = png_components(colors, depth)?
    let sample_bits: u64 = int.widen(depth)
    let bits = channels * sample_bits
    let w: u64 = int.widen(header.width)
    let h: u64 = int.widen(header.height)
    let interlace = input[28] == 1
    let size = png_filtered_size(w, h, bits, interlace)?
    let mut data = png_read_data(input, size, colors, depth)?
    let size_bytes = rgba_size(header.width, header.height)?
    let mut rgba = alloc_bytes(size_bytes)?
    let packed = !interlace && colors == 6 && depth == 8
    if !packed {
        list.fill(mut rgba, size_bytes, 0)
    }
    let mut at = 0u64
    let start: u64 = if interlace {
        0
    } else {
        7
    }
    let end: u64 = if interlace {
        7
    } else {
        8
    }
    let bpp = (bits + 7) / 8
    for pass in start .. end {
        let (x, y, dx, dy) = PNG_PASS[pass]
        let wide = pass_length(w, x, dx)
        let high = pass_length(h, y, dy)
        if wide == 0 || high == 0 {
            continue
        }
        let row_bytes = (wide * bits + 7) / 8
        for row in 0u64 .. high {
            let filter = data.scanlines[at]
            let body = at + 1
            if filter > 4 {
                return Error(Malformed)
            }
            if filter != 0 {
                png_unfilter(mut data.scanlines, body, row_bytes, bpp, row != 0, filter)
            }
            if packed {
                list.append(mut rgba, list.slice(data.scanlines, body, body + row_bytes))
            } else {
                for column in 0u64 .. wide {
                    let pixel = png_pixel(input, data, body, column * channels, sample_bits, colors)?
                    let dest = ((y + row * dy) * w + x + column * dx) * 4
                    list.set_word_be(mut rgba, dest, pixel)
                }
            }
            at = body + row_bytes
        }
    }
    Ok(Raster(width: header.width, height: header.height, rgba: take rgba))
}

fn png_unfilter(mut b: Bytes, at: u64, n: u64, bpp: u64, prior: bool, filter: u8) {
    let mut offset = 0u64
    if n >= 16 {
        if filter == 1 || (filter == 4 && !prior) {
            offset = png_sub_prefix(mut b, at, n, bpp)
        } else if filter == 4 && bpp == 4 {
            offset = png_paeth4_prefix(mut b, at, n)
        } else if filter == 2 {
            if !prior {
                return
            }
            offset = png_up_prefix(mut b, at, n)
        }
    }
    for i in offset .. n {
        let a = if i >= bpp {
            b[at + i - bpp]
        } else {
            0
        }
        let c = if prior {
            b[at + i - n - 1]
        } else {
            0
        }
        let base = match filter {
            1 => a,
            2 => c,
            3 => {
                let left: u16 = int.widen(a)
                let up: u16 = int.widen(c)
                int.narrow((left + up) / 2)
            },
            _ => {
                let d = if prior && i >= bpp {
                    b[at + i - n - 1 - bpp]
                } else {
                    0
                }
                png_paeth(a, c, d)
            },
        }
        b[at + i] = int.wrapping_add(b[at + i], base)
    }
}

fn png_paeth(left: u8, up: u8, diagonal: u8) -> u8 {
    let a: i32 = int.widen(left)
    let b: i32 = int.widen(up)
    let c: i32 = int.widen(diagonal)
    let da = int.abs(b - c)
    let db = int.abs(a - c)
    let dc = int.abs(a + b - 2 * c)
    if da <= db && da <= dc {
        left
    } else if db <= dc {
        up
    } else {
        diagonal
    }
}

fn png_sample(src: Bytes, row: u64, index: u64, depth: u64) -> u32 {
    if depth == 16 {
        return int.widen(tiff_short(src, row + 2 * index, false))
    }
    let bit = index * depth
    let byte: u32 = int.widen(src[row + bit / 8])
    let shift: u32 = int.narrow(8 - depth - bit % 8)
    let width: u32 = int.narrow(depth)
    (byte >> shift) & ((1u32 << width) - 1)
}

fn png_to_u8(value: u32, depth: u64) -> u32 {
    let width: u32 = int.narrow(depth)
    if depth == 16 {
        value >> 8
    } else {
        value * 255 / ((1u32 << width) - 1)
    }
}

fn png_pixel(input: Bytes, data: PngData, row: u64, i: u64, depth: u64, colors: u8) -> Result[u32, Error] {
    let first = png_sample(data.scanlines, row, i, depth)
    let tr = data.transparency
    if colors == 3 {
        let slot: u64 = int.widen(first)
        let at = data.palette.start + slot * 3
        if at >= data.palette.end {
            return Error(Malformed)
        }
        let r: u32 = int.widen(input[at])
        let g: u32 = int.widen(input[at + 1])
        let b: u32 = int.widen(input[at + 2])
        let a: u32 = if slot < tr.end - tr.start {
            int.widen(input[tr.start + slot])
        } else {
            255
        }
        return Ok((r << 24) | (g << 16) | (b << 8) | a)
    }
    let r = png_to_u8(first, depth)
    if colors == 0 || colors == 4 {
        let mut a = 255u32
        if colors == 4 {
            a = png_to_u8(png_sample(data.scanlines, row, i + 1, depth), depth)
        } else if tr.start != 0 && first == int.widen(tiff_short(input, tr.start, false)) {
            a = 0
        }
        return Ok((r << 24) | (r << 16) | (r << 8) | a)
    }
    let green = png_sample(data.scanlines, row, i + 1, depth)
    let blue = png_sample(data.scanlines, row, i + 2, depth)
    let g = png_to_u8(green, depth)
    let b = png_to_u8(blue, depth)
    let mut a = 255u32
    if colors == 6 {
        a = png_to_u8(png_sample(data.scanlines, row, i + 3, depth), depth)
    } else if tr.start != 0 && first == int.widen(tiff_short(input, tr.start, false)) && green == int.widen(tiff_short(input, tr.start + 2, false)) && blue == int.widen(tiff_short(input, tr.start + 4, false)) {
        a = 0
    }
    Ok((r << 24) | (g << 16) | (b << 8) | a)
}

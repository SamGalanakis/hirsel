// expect: run go() = 3700300
// expect: run refused() = 48 used 32
// MEM-12: `seq.index_in` builds a sequence's offset table once in a region block, so
// `seq.get` reads element i with a bounds check and one offset load. The elements are
// Num(4), Str("abc") and Num(7), of different sizes, so a wrong offset reads a wrong or
// broken element. Hand-derived: count 3 * 1000000, get 2 = Num(7) -> 7 * 100000, get 1
// = Str("abc") -> 100 * 3, get 3 is past the count -> None (0, else 50).
// refused(): the bound leaves room for the built value but not the block, round8(24 +
// 8 * 3) = 48 bytes, so index_in raises Capacity requested 48.
@compact(u16)
type J = Num(u64) | Str(Text) | Arr(SeqSpan[J])

fn num(j: J) -> u64 {
    match j {
        Num(n) => n,
        Str(t) => 100 * text.len(t),
        _ => 0
    }
}

fn w_val[in r](take w: Writer[J, in r]) -> Result[Child[J], BuildError] {
    emit(take w, Arr(emit(fn(take xs: Writer[SeqSpan[J], in r]) -> Result[Child[SeqSpan[J]], BuildError] {
        writer.append(mut xs, fn(take x: Writer[J, in r]) -> Result[Child[J], BuildError] {
            emit(take x, Num(4))
        })?
        writer.append(mut xs, fn(take x: Writer[J, in r]) -> Result[Child[J], BuildError] {
            emit(take x, Str("abc"))
        })?
        writer.append(mut xs, fn(take x: Writer[J, in r]) -> Result[Child[J], BuildError] {
            emit(take x, Num(7))
        })?
        writer.close(take xs)
    })))
}

fn make(r: Region) -> Result[J in r, BuildError] {
    match build_stream_in(r, bytes 200, fn(take w: Writer[J, in r]) -> Result[Child[J], BuildError] {
        w_val(take w)
    }) {
        Ok(take b) => Ok(finish(take b)),
        Error(e) => Error(e),
    }
}

fn go() -> u64 {
    region r {
        match make(r) {
            Ok(Arr(xs)) => match seq.index_in(r, xs) {
                ix => {
                    let two: u64 = match seq.get(ix, 2) {
                        Some(z) => 100000 * num(z),
                        None => 1
                    }
                    let one: u64 = match seq.get(ix, 1) {
                        Some(y) => num(y),
                        None => 2
                    }
                    let past: u64 = match seq.get(ix, 3) {
                        Some(_) => 50,
                        None => 0
                    }
                    seq.len(xs) * 1000000 + two + one + past
                },
            },
            Ok(_) => 97,
            Error(_) => 99,
        }
    }
}

fn refused() -> u64 {
    let got = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 216 {
            region r {
                match make(r) {
                    Ok(Arr(xs)) => {
                        let _ = seq.index_in(r, xs)
                        1u64
                    },
                    _ => 4u64,
                }
            }
        }
    })
    match caught(take got) {
        Some(e) => e.requested,
        None => 5u64
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

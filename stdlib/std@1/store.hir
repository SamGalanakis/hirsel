// An embedded, transactional, ordered key-value store over Backend[S]: a
// log-structured engine whose objects are immutable and conditionally created,
// after SlateDB's object-storage protocol (manifest, write-ahead objects and
// writer fencing by create-if-absent). The local backend uses an explicit Dir;
// object backends supply the same operations through their owned state.
//
// Layout under the Dir, every name a 20-digit decimal id:
//   manifest/N  the writer epoch, the current snapshot and the first log id
//               to replay; written when a writer claims the store and at
//               compaction, never replaced (the newest valid one is current)
//   log/N       one commit group: the write sets of consecutive commits; the
//               commit point of every commit in it
//   snap/N      every entry as of one commit, written by compaction
// A writer claims the store by creating a fence log at the next log id and
// then the next manifest with the next epoch. A stale writer's next create
// finds its id taken and the store reports Fenced(). Fencing rests on every
// created name staying taken, so the store never removes a durable object:
// a freed name would let a superseded writer's create succeed. Compaction
// only lets recovery skip what the newest manifest no longer reaches.
//
// A transaction is an entry (STORE-2): `transact`, `query` and `call` run
// it through `runner.apply` on argument bytes decoded afresh, with call
// information minted before the run. The store holds itself from the run to
// the commit, so no commit lands in between and there is no conflict.
/// The storage seam: immutable whole-object reads, conditional creation,
/// ordered prefix discovery, deletion and directory setup. `put_new` returns
/// `Ok` only once an object with exactly these bytes holds the name, durably
/// under `Durable()`: for an existing object with equal bytes it first redoes
/// its durability barrier. Its errors say whether the create may have happened
/// (`PutError`). Implementations may issue range GETs and cache immutable data
/// behind `read`.
pub type Backend[S] {
  read: fn(mut state: S, String) -> Result[Bytes, FileError] uses {state},
  put_new: fn(mut state: S, String, Bytes, Durability) -> Result[(), PutError] uses {state},
  list: fn(mut state: S, String) -> Result[List[String], FileError] uses {state},
  remove: fn(mut state: S, String) -> Result[(), FileError] uses {state},
  mkdir: fn(mut state: S, String) -> Result[(), FileError] uses {state},
  // The largest object `put_new` accepts; a larger one is `Refused`.
  max_object_bytes: fn(mut state: S) -> u64 uses {state},
}

/// How a backend's `put_new` failed. `Taken()`: an object with other bytes
/// holds the name. `Refused(e)`: the request was refused before it had any
/// effect, so no object was created. `Undecided(e)`: the object may hold the
/// name, with or without its durability barrier: a lost response, or a barrier
/// that failed after the object became visible. The store settles an undecided
/// create by issuing the same create again, which succeeds only with its
/// barrier; reading the object back would prove existence, not durability.
@serializable
pub type PutError = Taken | Refused(FileError) | Undecided(FileError)

/// The default backend: an explicitly granted local or simulated Dir.
pub fn local_backend() -> Backend[Dir] uses {} {
  Backend(
    read: local_read,
    put_new: local_put,
    list: local_list,
    remove: local_remove,
    mkdir: local_mkdir,
    max_object_bytes: local_max_object_bytes
  )
}

// A Dir object is bounded only by the runtime's largest byte extent.
fn local_max_object_bytes(mut d: Dir) -> u64 uses {} {
  4611686018427387839
}

fn local_read(mut d: Dir, name: String) -> Result[Bytes, FileError] uses {d} {
  file.read_bytes(d, path.of(name))
}

// `file.put_new` reports a failed directory barrier after the link as a fault
// like any other, so only `AlreadyExists` (other bytes) is decided.
fn local_put(mut d: Dir, name: String, data: Bytes, mode: Durability) -> Result[
  (),
  PutError
] uses {d} {
  match file.put_new(d, path.of(name), unique data, mode) {
    Ok(()) => Ok(()),
    Error(AlreadyExists()) => Error(Taken()),
    Error(e) => Error(Undecided(e)),
  }
}

fn local_list(mut d: Dir, name: String) -> Result[List[String], FileError] uses {d} {
  let entries = file.read_dir(d, path.of(name))?
  let mut names: List[String] = []
  for item in take entries {
    let entry = item?
    list.push(mut names, path.text(entry.path))
  }
  Ok(take names)
}

fn local_remove(mut d: Dir, name: String) -> Result[(), FileError] uses {d} {
  file.remove(d, path.of(name))
}

fn local_mkdir(mut d: Dir, name: String) -> Result[(), FileError] uses {d} {
  file.mkdir(d, path.of(name))
}

/// How the store makes commits survive a crash, and where it may stop for a
/// test. `durability` is the mode of every log object: `Durable()` returns a
/// commit's ticket from `durable` only once its group is synced, `Volatile()`
/// writes groups without syncing, so a crash may lose any suffix of commits
/// (never part of one). `group_limit` commits share one log object: a commit
/// that fills the group writes it, and `durable` writes a partial group; 1
/// writes every commit on its own. `faults` injects a stop for crash tests.
pub type StoreConfig {
  durability: Durability,
  group_limit: u64,
  faults: StoreFaults,
  limits: StoreLimits,
}

/// The most a commit may write: any key over `key_bytes`, any value over
/// `value_bytes`, or an encoded commit over `transaction_bytes` refuses the
/// commit with `Limit(..)` and no effect. A commit's encoded size is that of
/// the log object holding it alone: its keys and values, 17 bytes per put, 9
/// per delete and 50 of object framing. `open` refuses a `transaction_bytes`
/// over the backend's `max_object_bytes`, so every admitted commit can be
/// written.
pub type StoreLimits {
  key_bytes: u64,
  value_bytes: u64,
  transaction_bytes: u64,
  range_rows: u64,
}

/// A test seam: `StopAfterWrites(n)` refuses the store's storage mutation after
/// its first `n` (creates, removals and directory creations, from `open` on),
/// with no effect, as a crash at that point would; the store then closes.
pub type StoreFaults = NoFaults | StopAfterWrites(u64)

/// Why a store operation failed. `Storage` is the Dir's own error, after which
/// a create's outcome may be undecided; `Refused` is a create the backend
/// refused before it had any effect; `Corrupt`
/// names an object that fails its checksum or the layout's rules (in a
/// `Volatile()` store, a bad log instead ends the recovered log); `Fenced` means another writer claimed the store; `Limit`
/// is a commit over the configured limits, or at `open` a `transaction_bytes`
/// the backend's objects cannot hold; `Injected` is a `StopAfterWrites` stop.
/// After `Storage`, `Refused`, `Corrupt`, `Fenced` or `Injected` the store is
/// closed and every later call returns `Closed`. `NoLevel` is a durability
/// level this store does not declare and `InvalidInput` an argument the
/// operation refuses; both are definite, have no effect and leave the store
/// open.
@serializable
pub type StoreError = Storage(FileError) | Refused(FileError) | Corrupt(String) | Fenced | Limit(
  TxLimit
) | Injected | Closed | NoLevel | InvalidInput

/// How a transaction ended without its outcome: `Aborted(e)` when the body
/// returned `Error(e)` and its writes were discarded; `Canceled(cause)` before
/// the body started (only the call-stream form is canceled); `Faulted(f)` when
/// the body failed with `f` (FAIL-2), its writes discarded, nothing recorded
/// and the store usable; `Storage(e)` and
/// `Limit(..)` when nothing was committed; `Unknown(e)` when the commit was
/// attempted and the store could not tell whether it became durable, which the
/// next `open` decides.
@serializable
pub type TxFailure[E] = Aborted(E) | Canceled(CancelCause) | Faulted(Failure) | Storage(
  StoreError
) | Limit(TxLimit) | Unknown(StoreError)

/// Which of the configured limits a commit exceeded.
@serializable
pub type TxLimit = KeyBytes | ValueBytes | TransactionBytes | RangeRows

/// Why a call returned no outcome of its own: `Tx(f)` as for `transact`;
/// `Denied()` when a later executor epoch holds the stream; `Rejected()` for a
/// position the stream cannot take, or a retained position with another digest.
@serializable
pub type CallFailure[E] = Tx(TxFailure[E]) | Denied | Rejected

// A stream's row under `hirsel.streams/<stream>`: its executor epoch, the
// last position applied, the last one the caller acknowledged, and the digest
// and encoded outcome of each position between them.
@serializable
type StreamRow {
  epoch: u64,
  applied: u64,
  acknowledged: u64,
  retained: List[Retained],
}

@serializable
type Retained {
  position: u64,
  digest: Bytes,
  outcome: Bytes,
}

// One write of a commit's write set.
type Write = Put(key: Bytes, value: Bytes) | Delete(key: Bytes)

/// A commit's place in the store's commit order, awaited with `durable`.
pub opaque type Ticket: copyable + plain + data uses {} {
  seq: u64,
}

/// A stable view of the store as of one commit: later commits never change it.
pub opaque type Snapshot: copyable uses {} {
  seq: u64,
  index: ordered_map.OrderedMap[Bytes, Bytes],
}

/// What a store's head states about one transaction (STORE-4), the same for
/// every run of it: the caller's principal (empty for a local call), the
/// commit-order time (0: this head has no clock) and a seed fixed when the
/// transaction is ordered. A query is not ordered: its time and seed are 0.
/// Only the store mints one; `call_info` reads it.
pub opaque type CallInfo: copyable + data + inert uses {} {
  caller: String,
  at: i64,
  seed: u64,
}

/// What one run of a body read (STORE-14), over byte keys. `points` holds
/// every key it read, whether or not the key held a value, in the order read
/// and possibly repeated; `spans` every interval a scan consumed. The run's
/// writes are its write set. A commit that writes no key in it cannot change
/// the run's outcome.
pub type AccessSet {
  points: List[Bytes],
  spans: List[Span],
}

/// The interval one scan consumed, from `from` to `to` in key order whatever
/// its `direction`: from the bound the scan started at to the last key it
/// examined, or to the range's far bound when it exhausted the range. A scan
/// cut short by its limit depends on no key past the cut.
pub type Span {
  from: ordered_map.Bound[Bytes],
  to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
}

// One run of a transaction body: the commit it reads at, that state with its
// own writes applied, its writes and its access set.
type Run {
  base: u64,
  state: ordered_map.OrderedMap[Bytes, Bytes],
  writes: ordered_map.OrderedMap[Bytes, Option[Bytes]],
  access: AccessSet,
}

/// The scoped capability a transaction entry holds: reads see the commit the
/// transaction began at plus its own writes. It cannot leave the entry, and it
/// reaches only the keys of its scope.
@capability(local)
pub opaque type Tx: () uses {Recorder} {
  txn: Run,
  limits: StoreLimits,
  scope: KeyScope,
  // The run's access set (STORE-14), recorded through borrowed reads: every
  // key read and every interval a scan consumed, as independently owned
  // bytes. A narrowed facet records into its own and hands its events to its
  // parent's when its body returns.
  points: Recorder[Bytes],
  spans: Recorder[Span],
}

/// One end of a key range: no limit, the key itself included, or excluded.
pub type RangeBound[K] = Unbounded | Included(K) | Excluded(K)

/// The order a range is returned in.
pub type ScanOrder = Ascending | Descending

/// What a key scope lets a `Tx` do with a key.
@serializable
pub type Access = Read | ReadWrite

/// Why a table's stored schema refuses the operation's key or value type.
@serializable
pub type SchemaError = KeyMismatch | ValueMismatch | Renamed(String, String)

/// The outcome of one failed operation inside a transaction body. A failed
/// operation changes nothing, and the body continues.
@serializable
pub type TxError = NoTable | TableExists | Schema(SchemaError) | Migrating | ReadOnly | OutOfScope | InvalidInput | Limit(
  TxLimit
) | Storage(StoreError)

// One run of keys of a scope: the half-open byte interval [lo, hi), with no
// upper end for `None()`, read only or read and write.
type ScopeSpan {
  lo: Bytes,
  hi: Option[Bytes],
  write: bool,
}

/// A set of byte keys, each with an `Access`. Data without authority: it
/// grants nothing until a `Tx` is narrowed to it. Its spans are sorted,
/// disjoint and nonempty, with adjacent spans of equal access merged, so two
/// scopes holding the same keys with the same accesses are equal.
pub opaque type KeyScope: copyable + data + inert uses {} {
  spans: List[ScopeSpan],
  // Every key, read and write: the scope of an unnarrowed Tx.
  whole: bool,
}

/// The writer of one store directory.
@captures(backend)
pub opaque type Store[S]: () uses {S} {
  state: S,
  backend: Backend[S],
  config: StoreConfig,
  epoch: u64,
  index: ordered_map.OrderedMap[Bytes, Bytes],
  // An empty access set whose lists keep the capacity an earlier run grew,
  // so a run records its reads without allocating once the store is warm.
  spare: AccessSet,
  // The last commit applied (V) and the last one in a written log object (D).
  visible: u64,
  durable: u64,
  pending: List[List[Write]],
  // The encoded size of the pending commits and the backend's object cap.
  pending_bytes: u64,
  object_bytes: u64,
  next_log: u64,
  next_manifest: u64,
  next_snap: u64,
  // The current snapshot, if any, and the first log id recovery replays.
  snap: Option[SnapRef],
  log_start: u64,
  writes: u64,
  closed: bool,
}

const MAGIC: u32 = 0x52545348

const VERSION: u8 = 2

const KIND_LOG: u8 = 1

const KIND_SNAP: u8 = 2

const KIND_MANIFEST: u8 = 3

const OP_PUT: u8 = 1

const OP_DELETE: u8 = 2

// A log object's bytes besides its commits: header, first sequence, commit
// count and checksum; and a commit's own write count.
const LOG_FRAME: u64 = 42

const COMMIT_FRAME: u64 = 8

// A snapshot part's bytes besides its share of the entry stream: header,
// sequence, part index, part count and checksum.
const SNAP_FRAME: u64 = 50

// A manifest with a snapshot: header, flag, snapshot id, sequence and part
// count, first log id and checksum.
const MANIFEST_BYTES: u64 = 59

/// Durable log objects, 64 commits per group, no injected faults, and limits
/// of 4096-byte keys, 1 MiB values and 16 MiB per transaction.
pub fn default_config() -> StoreConfig uses {} {
  StoreConfig(
    durability: Durable(),
    group_limit: 64,
    faults: NoFaults(),
    limits: StoreLimits(
      key_bytes: 4096,
      value_bytes: 1048576,
      transaction_bytes: 16777216,
      range_rows: 4096
    )
  )
}

/// Whether `key` lies in `hirsel.`, the key space the store keeps for its own
/// rows; a transaction body writes no key there.
pub fn reserved(key: Bytes) -> bool uses {} {
  // The first byte settles nearly every key: the namespace begins with `h`.
  let prefix = b"hirsel."
  bytes.len(key) >= bytes.len(prefix) && key[0] == prefix[0] && bytes.slice(
    key,
    0,
    bytes.len(prefix)
  ) == prefix
}

/// The commit order position of a ticket: the n-th commit since the store
/// was created has sequence n.
@noalloc
pub fn sequence(t: Ticket) -> u64 uses {} {
  t.seq
}

/// Byte-lexicographic order, a proper prefix first: the order of every key.
@noalloc
pub fn compare_keys(a: Bytes, b: Bytes) -> i32 uses {} {
  if a < b {
    -1
  } else if b < a {
    1
  } else {
    0
  }
}

/// The bounds that select exactly the keys starting with `prefix`.
pub fn prefix_bounds(prefix: Bytes) -> (
  ordered_map.Bound[Bytes],
  ordered_map.Bound[Bytes]
) uses {} {
  let low: ordered_map.Bound[Bytes] = Included(unique prefix)
  // The least key above every extension of the prefix: drop trailing 0xff
  // bytes and increment the last remaining one; none left means no bound.
  let mut end: List[u8] = []
  for b in prefix {
    list.push(mut end, b)
  }
  while list.len(end) > 0 {
    let last = list.len(end) - 1
    if end[last] == 255 {
      let _ = list.pop(mut end)
    } else {
      end[last] = end[last] + 1
      let high: ordered_map.Bound[Bytes] = Excluded(bytes.from_list(take end))
      return (take low, take high)
    }
  }
  (take low, Unbounded())
}

/// Opens the store in `d`, creating its layout when `d` is empty, recovers the
/// newest valid state and claims the store as its writer at the next epoch.
pub fn open(d: Dir, config: StoreConfig) -> Result[Store[Dir], StoreError] uses {d} {
  open_backend(d, local_backend(), config)
}

/// Opens the same engine over a host-selected storage implementation. The state
/// is owned by the store; all effects go through this explicit function dictionary.
pub fn open_backend[S](take state: S, take backend: Backend[S], config: StoreConfig) -> Result[
  Store[S],
  StoreError
] uses {state, backend} {
  let mut s: Store[S] = Store(
    state: take state,
    backend: take backend,
    config: config,
    epoch: 0,
    index: ordered_map.empty(compare_keys),
    spare: AccessSet(points: [], spans: []),
    visible: 0,
    durable: 0,
    pending: [],
    pending_bytes: 0,
    object_bytes: 0,
    next_log: 0,
    next_manifest: 0,
    next_snap: 0,
    snap: None(),
    log_start: 0,
    writes: 0,
    closed: false
  )
  s.object_bytes = s.backend.max_object_bytes(mut s.state)
  // Every admitted commit must fit one log object, and a snapshot part must
  // carry some of its stream.
  if config.limits.transaction_bytes > s.object_bytes || s.object_bytes <= SNAP_FRAME || s.object_bytes < MANIFEST_BYTES {
    return Error(Limit(TransactionBytes()))
  }
  match recover(mut s) {
    Ok(()) => {
      collect(mut s)?
      Ok(take s)
    },
    Error(e) => Error(e),
  }
}

// Deletions a library has committed to, such as the typed-table library's
// dropped tables and the generations a migration replaces or abandons
// (STORE-5, STORE-9): one key per key prefix to delete, `hirsel.garbage/`
// followed by the prefix. Its value is empty, or `restoring`'s: a key to put
// back once no key under the prefix remains, in the commit that removes the
// entry. `collect` runs at every open, so a crash leaves no deletion half done.
fn garbage(prefix: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, b"hirsel.garbage/")
  bytes.append(mut out, prefix)
  bytes.from_list(take out)
}

// A garbage entry's value that puts `value` under `key` once its prefix is empty.
fn restoring(key: Bytes, value: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  let n = bytes.len(key)
  let mut i: u64 = 0
  while i < 4 {
    list.push(mut out, int.truncate((n >> (i * 8)) & 255))
    i += 1
  }
  bytes.append(mut out, key)
  bytes.append(mut out, value)
  bytes.from_list(take out)
}

// Carries out every garbage entry in key order: deletes the keys under its
// prefix in commits within the store's limits, then, in one more commit,
// removes the entry and puts back the key it restores. A crash between these
// commits leaves the rest to the next call. A failure closes the store, so no
// transaction runs while garbage remains that its deleter left: a generation
// number is reused only once its garbage is gone (STORE-9).
fn collect[S](mut s: Store[S]) -> Result[(), StoreError] {
  match collect_all(mut s) {
    Ok(()) => Ok(()),
    Error(e) => Error(stop(mut s, take e)),
  }
}

fn collect_all[S](mut s: Store[S]) -> Result[(), StoreError] {
  let (low, high) = prefix_bounds(b"hirsel.garbage/")
  while true {
    let mut t = serial(mut s)
    let _ = read_span(mut t.access, unique low, unique high, Ascending(), 1, [])
    let found = entries_in(t.state, low, high, Ascending(), 1)
    if list.len(found) == 0 {
      discard(mut s, take t)
      return Ok(())
    }
    let (entry, value) = unique found[0]
    let skip = bytes.len(b"hirsel.garbage/")
    let (from, to) = prefix_bounds(bytes.slice(entry, skip, bytes.len(entry)))
    if delete_within(mut t, s.config.limits, from, to) && ordered_map.len(t.writes) == 0 {
      run_delete(mut t, unique entry)
      if bytes.len(value) >= 4 {
        let mut n: u64 = 0
        let mut i: u64 = 0
        while i < 4 {
          let byte: u64 = int.widen(value[i])
          n = n | (byte << (i * 8))
          i += 1
        }
        if 4 + n > bytes.len(value) {
          discard(mut s, take t)
          return Error(Corrupt("garbage entry"))
        }
        run_put(
          mut t,
          bytes.slice(value, 4, 4 + n),
          bytes.slice(value, 4 + n, bytes.len(value))
        )
      }
    } else if ordered_map.len(t.writes) == 0 {
      // No single delete fits the commit limit.
      discard(mut s, take t)
      return Error(Limit(TransactionBytes()))
    }
    let ticket = commit(mut s, take t)?
    durable(mut s, ticket)?
  }
  Ok(())
}

// Deletes keys in [low, high) in key order while the commit of `t`, which
// writes nothing else, stays within `limits`; true when none remain. The
// whole span is in `t`'s reads.
fn delete_within(
  mut t: Run,
  limits: StoreLimits,
  low: ordered_map.Bound[Bytes],
  high: ordered_map.Bound[Bytes]
) -> bool uses {} {
  let _ = read_span(mut t.access, unique low, unique high, Ascending(), 1, [])
  let mut total = LOG_FRAME + COMMIT_FRAME
  // Every delete costs at least ten bytes, so no more keys than this fit.
  for (key, _) in entries_in(
    t.state,
    low,
    high,
    Ascending(),
    limits.transaction_bytes / 10 + 1
  ) {
    total += 9 + bytes.len(key)
    if total > limits.transaction_bytes {
      return false
    }
    run_delete(mut t, unique key)
  }
  list.len(entries_in(t.state, low, high, Ascending(), 1)) == 0
}

/// A stable view of every commit so far, durable or not. Later commits never
/// change it, and holding it never holds up the writer.
pub fn snapshot[S](mut s: Store[S]) -> Snapshot uses {} {
  Snapshot(seq: s.visible, index: current(mut s))
}

/// The commit a snapshot reflects: every commit up to it, no later one.
@noalloc
pub fn snapshot_sequence(snap: Snapshot) -> u64 uses {} {
  snap.seq
}

/// The value stored under `key` in the snapshot.
pub fn get(snap: Snapshot, key: Bytes) -> Option[Bytes] in snap uses {} {
  ordered_map.get(snap.index, key)
}

/// At most `limit` entries of the snapshot with keys between `from` and `to`,
/// in `direction` order, as fresh copies. Page by passing `Excluded` of the
/// last key received.
pub fn range(
  snap: Snapshot,
  from: ordered_map.Bound[Bytes],
  to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64
) -> List[(Bytes, Bytes)] uses {} {
  entries_in(snap.index, from, to, direction, limit)
}

// A run at the latest commit, for a call that holds the store from the run to
// its commit, so no commit lands in between.
fn serial[S](mut s: Store[S]) -> Run uses {} {
  Run(
    base: s.visible,
    state: current(mut s),
    writes: ordered_map.empty(compare_keys),
    access: replace(mut s.spare, AccessSet(points: [], spans: []))
  )
}

// Keeps `a`'s list capacity for the next run, emptied.
fn reuse[S](mut s: Store[S], take a: AccessSet) -> () uses {} {
  let mut kept = take a
  core@1/list.truncate(mut kept.points, 0)
  core@1/list.truncate(mut kept.spans, 0)
  s.spare = take kept
}

// Drops a run's writes, keeping its access set's capacity.
fn discard[S](mut s: Store[S], take t: Run) -> () uses {} {
  let Run(access: access, ..) = take t
  reuse(mut s, take access)
}

// Stores `value` under `key` when the run commits.
fn run_put(mut t: Run, take key: Bytes, take value: Bytes) -> () uses {} {
  ordered_map.insert(mut t.state, copy key, copy value)
  ordered_map.insert(mut t.writes, take key, Some(take value))
}

// Removes `key` when the run commits.
fn run_delete(mut t: Run, take key: Bytes) -> () uses {} {
  let _ = ordered_map.remove(mut t.state, key)
  ordered_map.insert(mut t.writes, take key, None())
}

// Records that the run read `key`, whether or not it holds a value.
fn read_point(mut a: AccessSet, take key: Bytes) -> () uses {} {
  list.push(mut a.points, take key)
}

// Records the interval a scan consumed (see `consumed`).
fn read_span(
  mut a: AccessSet,
  take from: ordered_map.Bound[Bytes],
  take to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64,
  take rows: List[(Bytes, Bytes)]
) -> List[(Bytes, Bytes)] uses {} {
  if let Some(span) = consumed(take from, take to, direction, limit, rows) {
    list.push(mut a.spans, take span)
  }
  take rows
}

// The interval a scan from `from` to `to` in `direction`, limited to `limit`
// entries, consumed when it returned `rows`: up to the last row when it
// returned `limit` of them, the whole range otherwise. A scan limited to none
// examined nothing.
fn consumed(
  take from: ordered_map.Bound[Bytes],
  take to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64,
  rows: List[(Bytes, Bytes)]
) -> Option[Span] uses {} {
  if limit == 0 {
    return None()
  }
  let n = list.len(rows)
  if n < limit {
    return Some(Span(from: take from, to: take to, direction: direction))
  }
  let (last, _) = rows[n - 1]
  let cut = copy_to(heap, last)
  Some(
    match direction {
      Ascending() => Span(from: take from, to: Included(take cut), direction: direction),
      Descending() => Span(from: Included(take cut), to: take to, direction: direction),
    }
  )
}

// A share of the index that outlives this call: the index moves out of the
// store, which only holds owned values, so a copy of it is owned too.
fn current[S](mut s: Store[S]) -> ordered_map.OrderedMap[Bytes, Bytes] uses {} {
  let index = replace(mut s.index, ordered_map.empty(compare_keys))
  let share = copy index
  s.index = take index
  share
}

// Commits run `t`'s writes as the next commit, visible at once to later
// snapshots and runs, and returns its ticket. `Limit(..)` when they exceed the
// configured limits; the commit has no effect and the store stays open. A
// commit that fills its group, by count or by the backend's object cap, writes
// the group's log object; `durable` awaits it. The store was held from the
// run's start, so its state is the index plus its writes.
fn commit[S](mut s: Store[S], take t: Run) -> Result[Ticket, StoreError] uses {s} {
  if s.closed {
    return Error(Closed())
  }
  let Run(base: _, state: state, writes: writes, access: access) = take t
  if let Some(l) = over_limit(s.config.limits, writes) {
    reuse(mut s, take access)
    return Error(Limit(l))
  }
  reuse(mut s, take access)
  let set = write_set(writes)
  // A group never outgrows one object: one that this commit would push past
  // the cap is written first. The commit alone fits, as `open` checked.
  let size = commit_bytes(set)
  if list.len(s.pending) > 0 && LOG_FRAME + s.pending_bytes + size > s.object_bytes {
    flush(mut s)?
  }
  s.index = take state
  s.visible += 1
  list.push(mut s.pending, take set)
  s.pending_bytes += size
  if list.len(s.pending) >= s.config.group_limit {
    flush(mut s)?
  }
  Ok(Ticket(seq: s.visible))
}

// The output gate: returns once the commit `t` names is in a written log
// object, synced when the store is `Durable()`, together with every earlier
// commit. Writes the pending group if `t` is in it.
fn durable[S](mut s: Store[S], t: Ticket) -> Result[(), StoreError] uses {s} {
  if s.closed {
    return Error(Closed())
  }
  if t.seq <= s.durable {
    return Ok(())
  }
  flush(mut s)
}

/// Writes every commit into a new snapshot, as many objects as the backend's
/// object cap requires, and publishes it with a new manifest, so recovery
/// replays only the logs after it. It removes nothing:
/// every created name stays taken, which is what fences a superseded writer.
/// A crash at any point recovers: until the manifest exists the old state is
/// current, and after it the older objects are never read again.
pub fn compact[S](mut s: Store[S]) -> Result[(), StoreError] uses {s} {
  if s.closed {
    return Error(Closed())
  }
  flush(mut s)?
  let first = s.next_snap
  let parts = encode_snapshot(
    first,
    s.epoch,
    s.durable,
    s.index,
    s.object_bytes - SNAP_FRAME
  )
  let count = list.len(parts)
  for part in parts {
    create(mut s, snap_name(s.next_snap), copy part, Durable())?
    s.next_snap += 1
  }
  s.snap = Some(SnapRef(first: first, seq: s.durable, parts: count))
  s.log_start = s.next_log
  publish_manifest(mut s)
}

/// Writes any pending commits and closes the store.
pub fn close[S](take store: Store[S]) -> Result[(), StoreError] uses {store} {
  let mut s = take store
  if s.closed {
    return Error(Closed())
  }
  flush(mut s)
}

/// Runs the transaction entry `f` once, with a fresh `Tx` at the latest
/// commit, call information minted before the run and `a` decoded afresh from
/// its argument bytes (STORE-2), and commits its writes as one commit when it
/// returns `Ok`. `Error(e)` discards them and is `Aborted(e)`; a failure in
/// the run discards them and is `Faulted(f)` (FAIL-2), and the store stays
/// usable; writes over the limits are `Limit(..)`. The outcome, of any kind,
/// is returned only once every commit the run could see, and its own, is
/// durable: the output gate.
pub fn transact[S, A: serializable, R: serializable, E: serializable](
  mut s: Store[S],
  f: Entry[fn(mut tx: Tx, info: CallInfo, a: A) -> Result[R, E]],
  a: A
) -> Result[R, TxFailure[E]] uses {s} {
  if s.closed {
    return Error(Storage(Closed()))
  }
  let Ok(argument) = fresh_argument(a) else {
    return Error(Storage(Corrupt("hirsel.argument")))
  }
  let info = ordered(s)
  let mut tx = Tx(
    txn: serial(mut s),
    limits: s.config.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  let returned = runner.apply_mut(f, mut tx, info, argument)
  // The run `tx` ran; its access set is what the entry's reads recorded.
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut t = take ran
  t.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  match take returned {
    Ok(Ok(v)) => {
      settle(mut s, take t) ? released
      Ok(take v)
    },
    Ok(Error(e)) => {
      let base = t.base
      discard(mut s, take t)
      gate(mut s, base) ? released
      Error(Aborted(take e))
    },
    Error(failure) => {
      let base = t.base
      discard(mut s, take t)
      gate(mut s, base) ? released
      Error(Faulted(take failure))
    },
  }
}

// One of std's own transactions, run by calling `body` directly: a body
// generic over its caller's types, as each of `table.migrate`'s steps is,
// cannot be an entry. Outcomes are `transact`'s, but a failure in `body`
// propagates.
fn transact_body[S, R: inert, E: inert](
  mut s: Store[S],
  body: fn(mut tx: Tx) -> Result[R, E] uses {}
) -> Result[R, TxFailure[E]] uses {s} {
  if s.closed {
    return Error(Storage(Closed()))
  }
  let mut tx = Tx(
    txn: serial(mut s),
    limits: s.config.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  let returned = body(mut tx)
  // The run `tx` ran; its access set is what the entry's reads recorded.
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut t = take ran
  t.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  match take returned {
    Ok(v) => {
      settle(mut s, take t) ? released
      Ok(take v)
    },
    Error(e) => {
      let base = t.base
      discard(mut s, take t)
      gate(mut s, base) ? released
      Error(Aborted(take e))
    },
  }
}

/// Runs the query entry `f` once on `snap`, with a borrowed `Tx` that reads
/// the snapshot and through which no write can be made, call information
/// with no time or seed (a query is not ordered, STORE-4) and `a` decoded
/// afresh. `Error(e)` is `Aborted(e)` and a failure in the run `Faulted(f)`.
pub fn query[A: serializable, R: serializable, E: serializable](
  take snap: Snapshot,
  f: Entry[fn(tx: Tx, info: CallInfo, a: A) -> Result[R, E]],
  a: A
) -> Result[R, TxFailure[E]] uses {} {
  let Ok(argument) = fresh_argument(a) else {
    return Error(Storage(Corrupt("hirsel.argument")))
  }
  let tx = Tx(
    txn: reading(take snap),
    limits: default_config().limits,
    scope: all(Read()),
    points: recorder.new(),
    spans: recorder.new()
  )
  let info = CallInfo(caller: "", at: 0, seed: 0)
  let returned = runner.apply(f, tx, info, argument)
  let Tx(txn: _, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let _: List[Bytes] = recorder.finish(take read_points)
  let _: List[Span] = recorder.finish(take read_spans)
  match take returned {
    Ok(Ok(v)) => Ok(take v),
    Ok(Error(e)) => Error(Aborted(take e)),
    Error(failure) => Error(Faulted(take failure)),
  }
}

// A run over `snap`'s state.
fn reading(take snap: Snapshot) -> Run uses {} {
  let Snapshot(seq: seq, index: index) = take snap
  Run(
    base: seq,
    state: take index,
    writes: ordered_map.empty(compare_keys),
    access: AccessSet(points: [], spans: [])
  )
}

// Fresh owned data decoded from the canonical encoding of `a` (STORE-2): a
// round trip canonicalizes NaNs and `Set` order, as a recorded call's
// re-execution sees them. A just-encoded value always decodes.
fn fresh_argument[A: serializable](a: A) -> Result[A, DecodeError] uses {} {
  let bytes = codec.encode(a)
  codec.decode(bytes)
}

// The call information of the next transaction `s` orders (STORE-4): no
// caller for a local call, no clock, and a seed from its place in the order.
fn ordered[S](s: Store[S]) -> CallInfo uses {} {
  CallInfo(caller: "", at: 0, seed: order_seed(s.visible + 1))
}

// splitmix64's finalizer: distinct versions give well-spread seeds.
fn order_seed(version: u64) -> u64 uses {} {
  let mut z = core@1/int.wrapping_mul(version, 0x9e3779b97f4a7c15u64)
  z = core@1/int.wrapping_mul(z ^ z >> 30, 0xbf58476d1ce4e5b9u64)
  z = core@1/int.wrapping_mul(z ^ z >> 27, 0x94d049bb133111ebu64)
  z ^ z >> 31
}

/// `transact` as one request on an ordered call stream, exactly once per
/// position. The stream's row decides the request in the transaction that
/// would run it: an epoch below the row's is `Denied()`; a position at or
/// below the acknowledged one, above the next one, or retained with another
/// digest is `Rejected()`; a retained position with an equal digest returns
/// its recorded outcome without running `f`; the next position runs `f`, and
/// the same commit records the outcome in the row, so an outcome is recorded
/// exactly when its writes commit. An outcome that writes nothing (an abort, a
/// limit) is recorded by a commit of the row alone. A failure in the run is
/// `Tx(Faulted(f))`, recorded nowhere: the position stays the next one.
pub fn call[S, A: serializable, R: serializable, E: serializable](
  mut s: Store[S],
  req: CallRequest,
  f: Entry[fn(mut tx: Tx, info: CallInfo, a: A) -> Result[R, E]],
  a: A
) -> Result[R, CallFailure[E]] uses {s} {
  if s.closed {
    return Error(Tx(Storage(Closed())))
  }
  let key = stream_key(req.stream)
  let t = serial(mut s)
  let base = t.base
  let row = match decide(mut s, t, key, req) {
    Error(e) => {
      discard(mut s, take t)
      return Error(Tx(Storage(take e)))
    },
    Ok(Deny()) => {
      discard(mut s, take t)
      return refuse(mut s, base, Denied())
    },
    Ok(Reject()) => {
      discard(mut s, take t)
      return refuse(mut s, base, Rejected())
    },
    Ok(Recorded(row, recorded)) => {
      discard(mut s, take t)
      let stored: Result[Result[R, TxFailure[E]], DecodeError] = codec.decode(recorded)
      let Ok(outcome) = take stored else {
        return Error(Tx(Storage(stop(mut s, Corrupt("hirsel.streams")))))
      }
      replayed(mut s, take row, key, req, base) ? released_call
      return match take outcome {
        Ok(v) => Ok(take v),
        Error(failed) => Error(Tx(take failed)),
      }
    },
    Ok(Next(row)) => take row,
  }
  let Ok(argument) = fresh_argument(a) else {
    discard(mut s, take t)
    return Error(Tx(Storage(Corrupt("hirsel.argument"))))
  }
  let info = ordered(s)
  let mut tx = Tx(
    txn: take t,
    limits: s.config.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  // The row read decides the request, so the run read it.
  recorder.append(tx.points, copy key)
  let returned = runner.apply_mut(f, mut tx, info, argument)
  // The run `tx` ran; its access set is what the entry's reads recorded.
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut done = take ran
  done.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  let outcome: Result[R, TxFailure[E]] = match take returned {
    Ok(Ok(v)) => Ok(take v),
    Ok(Error(e)) => Error(Aborted(take e)),
    Error(failure) => {
      discard(mut s, take done)
      gate(mut s, base) ? released_call
      return Error(Tx(Faulted(take failure)))
    },
  }
  let ok = match outcome {
    Ok(_) => true,
    Error(_) => false,
  }
  let recorded = codec.encode(outcome)
  let limited = fn(l: TxLimit) -> Bytes {
    let o: Result[R, TxFailure[E]] = Error(Limit(l))
    codec.encode(o)
  }
  match record(mut s, take done, ok, key, take row, req, take recorded, limited) {
    AsRun() => match take outcome {
      Ok(v) => Ok(take v),
      Error(failed) => Error(Tx(take failed)),
    },
    Limited(l) => Error(Tx(Limit(l))),
    Unrecorded(u) => Error(released_call(take u)),
  }
}

// How a stream decides a request (STORE-12): refused for its epoch or its
// position; a position whose end the stream records, with that end's bytes; or
// the next position, which runs.
type Decision = Deny | Reject | Recorded(StreamRow, Bytes) | Next(StreamRow)

// Decides `req` on the stream row under `key` as the run `t` reads it. A row
// that does not decode closes the store.
fn decide[S](mut s: Store[S], t: Run, key: Bytes, req: CallRequest) -> Result[
  Decision,
  StoreError
] uses {} {
  let row = match ordered_map.get(t.state, key) {
    None() => StreamRow(epoch: 0, applied: 0, acknowledged: 0, retained: []),
    Some(data) => {
      let decoded: Result[StreamRow, DecodeError] = codec.decode(data)
      match take decoded {
        Ok(r) => take r,
        Error(_) => return Error(stop(mut s, Corrupt("hirsel.streams"))),
      }
    },
  }
  if req.epoch < row.epoch {
    return Ok(Deny())
  }
  if req.position <= row.acknowledged || req.position > row.applied + 1 || req.acknowledged >= req.position {
    return Ok(Reject())
  }
  if req.position > row.applied {
    return Ok(Next(take row))
  }
  let mut found: Option[Bytes] = None()
  for r in row.retained {
    if r.position == req.position && r.digest == req.digest {
      found = Some(unique r.outcome)
    }
  }
  match take found {
    // Another request at a recorded position.
    None() => Ok(Reject()),
    Some(recorded) => Ok(Recorded(take row, take recorded)),
  }
}

// Releases a recorded end: a later executor's duplicate fences the earlier
// ones, in a commit of the row alone.
fn replayed[S](mut s: Store[S], take row: StreamRow, key: Bytes, req: CallRequest, base: u64) -> Result[
  (),
  Unreleased
] {
  if req.epoch <= row.epoch {
    return gate(mut s, base)
  }
  let mut fenced = take row
  fenced.epoch = req.epoch
  let mut fence = serial(mut s)
  run_put(mut fence, unique key, codec.encode(fenced))
  settle(mut s, take fence)
}

// How the commit recording a run's end went: as the run ended; as the limit
// `l`, when the run's writes and the row recording them exceed it; or not at
// all, the position staying the next one.
type Recording = AsRun | Limited(TxLimit) | Unrecorded(Unreleased)

// Records the run `done`'s end, `recorded`, at `req`'s position and commits:
// with the run's writes when `ok`, else in a commit of the row alone. The row
// counts against the limits like the body's writes: when they exceed them,
// the end is `limited(l)`, recorded by a commit of the row alone; when not
// even that fits (its caller holds too many ends unacknowledged), nothing is
// recorded.
fn record[S](
  mut s: Store[S],
  take done: Run,
  ok: bool,
  key: Bytes,
  take row: StreamRow,
  req: CallRequest,
  take recorded: Bytes,
  limited: fn(l: TxLimit) -> Bytes uses {}
) -> Recording uses {s} {
  let base = done.base
  let mut next = take row
  next.epoch = req.epoch
  next.applied = req.position
  if req.acknowledged > next.acknowledged {
    next.acknowledged = req.acknowledged
  }
  let mut kept: List[Retained] = []
  for r in next.retained {
    if r.position > next.acknowledged {
      list.push(mut kept, copy r)
    }
  }
  next.retained = take kept
  let mut commit_set = if ok {
    take done
  } else {
    discard(mut s, take done)
    serial(mut s)
  }
  put_row(mut commit_set, unique key, copy next, req, take recorded)
  if let Some(l) = over_limit(s.config.limits, commit_set.writes) {
    discard(mut s, take commit_set)
    let mut alone = serial(mut s)
    put_row(mut alone, unique key, take next, req, limited(l))
    if let Some(full) = over_limit(s.config.limits, alone.writes) {
      discard(mut s, take alone)
      return match gate(mut s, base) {
        Ok(()) => Unrecorded(Limit(full)),
        Error(u) => Unrecorded(take u),
      }
    }
    return match settle(mut s, take alone) {
      Ok(()) => Limited(l),
      Error(u) => Unrecorded(take u),
    }
  }
  match settle(mut s, take commit_set) {
    Ok(()) => AsRun(),
    Error(u) => Unrecorded(take u),
  }
}

/// One entry a place's head serves (STORE-12), with its form: its identity and
/// its evaluation over argument bytes, specialized to its types when made.
pub opaque type Served: copyable uses {} {
  entry: EntryId,
  body: ServedBody,
  // The bytes of `TxFailure[E]` `Limit(l)` and `Storage(e)`, and the end a
  // stream's recorded outcome bytes (a `Result[R, TxFailure[E]]`) stand for.
  limited: fn(l: TxLimit) -> (Bytes, Bytes) uses {},
  refused: fn(e: StoreError) -> Bytes uses {},
  replay: fn(recorded: Bytes) -> Option[CallEnd] uses {},
}

// A body takes its call's caller and seed rather than a `CallInfo`, which it
// mints: a `CallInfo` parameter in a declared function type is resolved with a
// different drop allocation from the closure's (TIR validation rejects it).
type ServedBody = Transacting(
  fn(mut tx: Tx, caller: String, seed: u64, argument: Bytes) -> Evaluated uses {}
) | Querying(fn(tx: Tx, caller: String, seed: u64, argument: Bytes) -> Evaluated uses {})

// One evaluation of a served entry: an argument that does not decode, a
// failure in the run, or the body's outcome as the stream records it (a
// `Result[R, TxFailure[E]]`) and as the call ends.
type Evaluated = Undecoded | Faulting(Failure) | Ended(ok: bool, recorded: Bytes, end: CallEnd)

/// Serves the transaction entry `f`.
pub fn served_transact[A: serializable, R: serializable, E: serializable](
  f: Entry[fn(mut tx: Tx, info: CallInfo, a: A) -> Result[R, E]]
) -> Served uses {} {
  Served(
    entry: runner.entry_id(f),
    body: Transacting(fn(mut tx: Tx, caller: String, seed: u64, argument: Bytes) -> Evaluated {
      let info = CallInfo(caller: copy caller, at: 0, seed: seed)
      let decoded: Result[A, DecodeError] = codec.decode(argument)
      let Ok(a) = take decoded else {
        return Undecoded()
      }
      match runner.apply_mut(f, mut tx, info, take a) {
        Ok(Ok(v)) => {
          let end: CallEnd = Returned(codec.encode(v))
          let outcome: Result[R, TxFailure[E]] = Ok(take v)
          Ended(ok: true, recorded: codec.encode(outcome), end: take end)
        },
        Ok(Error(e)) => {
          let failure: TxFailure[E] = Aborted(take e)
          let end: CallEnd = Failed(codec.encode(failure))
          let outcome: Result[R, TxFailure[E]] = Error(take failure)
          Ended(ok: false, recorded: codec.encode(outcome), end: take end)
        },
        Error(failure) => Faulting(take failure),
      }
    }),
    limited: fn(l: TxLimit) -> (Bytes, Bytes) {
      let failure: TxFailure[E] = Limit(l)
      let end = codec.encode(failure)
      let outcome: Result[R, TxFailure[E]] = Error(take failure)
      (codec.encode(outcome), take end)
    },
    refused: fn(e: StoreError) -> Bytes {
      let failure: TxFailure[E] = Storage(copy e)
      codec.encode(failure)
    },
    replay: fn(recorded: Bytes) -> Option[CallEnd] {
      let stored: Result[Result[R, TxFailure[E]], DecodeError] = codec.decode(recorded)
      match take stored {
        Ok(Ok(v)) => Some(Returned(codec.encode(v))),
        Ok(Error(failure)) => Some(Failed(codec.encode(failure))),
        Error(_) => None(),
      }
    }
  )
}

/// Serves the query entry `f`.
pub fn served_query[A: serializable, R: serializable, E: serializable](
  f: Entry[fn(tx: Tx, info: CallInfo, a: A) -> Result[R, E]]
) -> Served uses {} {
  Served(
    entry: runner.entry_id(f),
    body: Querying(fn(tx: Tx, caller: String, seed: u64, argument: Bytes) -> Evaluated {
      let info = CallInfo(caller: copy caller, at: 0, seed: seed)
      let decoded: Result[A, DecodeError] = codec.decode(argument)
      let Ok(a) = take decoded else {
        return Undecoded()
      }
      match runner.apply(f, tx, info, take a) {
        Ok(Ok(v)) => Ended(ok: true, recorded: b"", end: Returned(codec.encode(v))),
        Ok(Error(e)) => {
          let failure: TxFailure[E] = Aborted(take e)
          Ended(ok: false, recorded: b"", end: Failed(codec.encode(failure)))
        },
        Error(failure) => Faulting(take failure),
      }
    }),
    limited: fn(l: TxLimit) -> (Bytes, Bytes) {
      let failure: TxFailure[E] = Limit(l)
      let end = codec.encode(failure)
      let outcome: Result[R, TxFailure[E]] = Error(take failure)
      (codec.encode(outcome), take end)
    },
    refused: fn(e: StoreError) -> Bytes {
      let failure: TxFailure[E] = Storage(copy e)
      codec.encode(failure)
    },
    replay: fn(recorded: Bytes) -> Option[CallEnd] {
      let stored: Result[Result[R, TxFailure[E]], DecodeError] = codec.decode(recorded)
      match take stored {
        Ok(Ok(v)) => Some(Returned(codec.encode(v))),
        Ok(Error(failure)) => Some(Failed(codec.encode(failure))),
        Error(_) => None(),
      }
    }
  )
}

/// Serves the calls that arrive in `inbox` with `entries` until the inbox
/// closes, which returns `Ok(())`, or the store closes, which returns its
/// error (STORE-12). Each arrival names its entry by identity: a path `entries`
/// does not serve, or serves in the other form, ends `NotRun(Denied())`; one
/// whose fingerprint or code hash differs ends `NotRun(VersionMismatch())`. A
/// transact call is decided on its call stream in the transaction that would
/// run it, as `call` decides it; a query reads the latest commit. An argument
/// that does not decode ends `NotRun(Rejected())`. Each end is given once the
/// output gate releases it. A store that closes, a fenced one included, ends
/// the arrivals it holds `InDoubt(Abandoned())`; the calls still in the inbox
/// never ran. `entries` naming one path twice is `InvalidInput()`.
pub fn serve[S](mut s: Store[S], take inbox: Inbox, entries: List[Served]) -> Result[
  (),
  StoreError
] uses {s, inbox} {
  let mut i: u64 = 0
  while i < list.len(entries) {
    let mut j = i + 1
    while j < list.len(entries) {
      if entries[i].entry.path == entries[j].entry.path {
        return Error(InvalidInput())
      }
      j += 1
    }
    i += 1
  }
  let mut held = take inbox
  while true {
    let Some(arrivals) = inbox.take(mut held, true) else {
      return Ok(())
    }
    let mut failed: Option[StoreError] = None()
    for arrival in take arrivals {
      if s.closed {
        arrival.end(take arrival, InDoubt(Abandoned()))
      } else {
        let request = arrival.request(arrival)
        let end = serve_one(mut s, entries, take request)
        if s.closed {
          failed = Some(Closed())
          arrival.end(take arrival, InDoubt(Abandoned()))
        } else {
          arrival.end(take arrival, take end)
        }
      }
    }
    if let Some(e) = take failed {
      return Error(take e)
    }
  }
  Ok(())
}

// The end of one arrival, resolved against `entries`.
fn serve_one[S](mut s: Store[S], entries: List[Served], take request: Arrived) -> CallEnd uses {s} {
  let mut found: Option[u64] = None()
  let mut k: u64 = 0
  while k < list.len(entries) {
    if entries[k].entry.path == request.entry.path {
      found = Some(k)
    }
    k += 1
  }
  let Some(at) = found else {
    return NotRun(Denied())
  }
  let served = entries[at]
  let querying = match served.body {
    Transacting(_) => false,
    Querying(_) => true,
  }
  if querying != (request.form == Query()) || !(querying || request.form == Transact()) {
    return NotRun(Denied())
  }
  if served.entry.fingerprint != request.entry.fingerprint || served.entry.code != request.entry.code {
    return NotRun(VersionMismatch())
  }
  // A level this store does not declare (STORE-2): definite, no effect.
  if let Some(_) = request.level {
    return Failed(served.refused(NoLevel()))
  }
  match served.body {
    Querying(body) => {
      let snap = snapshot(mut s)
      let seq = snap.seq
      let tx = Tx(
        txn: reading(take snap),
        limits: s.config.limits,
        scope: all(Read()),
        points: recorder.new(),
        spans: recorder.new()
      )
      let evaluated = body(tx, request.caller, 0, request.argument)
      let Tx(txn: _, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
      let _: List[Bytes] = recorder.finish(take read_points)
      let _: List[Span] = recorder.finish(take read_spans)
      if let Error(_) = gate(mut s, seq) {
        return InDoubt(Abandoned())
      }
      match take evaluated {
        Undecoded() => NotRun(Rejected()),
        Faulting(failure) => Faulted(codec.encode(failure)),
        Ended(ok: _, recorded: _, end: end) => take end,
      }
    },
    Transacting(body) => serve_transact(mut s, served, body, request.request, request.caller, request.argument),
  }
}

// A served transact call, decided on its stream as `call` decides it.
fn serve_transact[S](
  mut s: Store[S],
  served: Served,
  body: fn(mut tx: Tx, caller: String, seed: u64, argument: Bytes) -> Evaluated uses {},
  req: CallRequest,
  caller: String,
  argument: Bytes
) -> CallEnd uses {s} {
  if bytes.len(req.stream) != 32 {
    return NotRun(Rejected())
  }
  let key = stream_key(req.stream)
  let t = serial(mut s)
  let base = t.base
  let row = match decide(mut s, t, key, req) {
    Error(_) => {
      discard(mut s, take t)
      return InDoubt(Abandoned())
    },
    Ok(Deny()) => {
      discard(mut s, take t)
      return released_end(mut s, base, NotRun(Denied()))
    },
    Ok(Reject()) => {
      discard(mut s, take t)
      return released_end(mut s, base, NotRun(Rejected()))
    },
    Ok(Recorded(row, recorded)) => {
      discard(mut s, take t)
      let Some(end) = served.replay(recorded) else {
        let _ = stop(mut s, Corrupt("hirsel.streams"))
        return InDoubt(Abandoned())
      }
      return match replayed(mut s, take row, key, req, base) {
        Ok(()) => take end,
        Error(_) => InDoubt(Abandoned()),
      }
    },
    Ok(Next(row)) => take row,
  }
  let seed = order_seed(s.visible + 1)
  let mut tx = Tx(
    txn: take t,
    limits: s.config.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  // The row read decides the request, so the run read it.
  recorder.append(tx.points, copy key)
  let evaluated = body(mut tx, caller, seed, argument)
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut done = take ran
  done.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  let (ok, recorded, end) = match take evaluated {
    Undecoded() => {
      discard(mut s, take done)
      return released_end(mut s, base, NotRun(Rejected()))
    },
    Faulting(failure) => {
      discard(mut s, take done)
      return released_end(mut s, base, Faulted(codec.encode(failure)))
    },
    Ended(ok: ok, recorded: recorded, end: end) => (ok, take recorded, take end),
  }
  let limited = fn(l: TxLimit) -> Bytes {
    let (outcome, _) = served.limited(l)
    outcome
  }
  match record(mut s, take done, ok, key, take row, req, take recorded, limited) {
    AsRun() => take end,
    Limited(l) => {
      let (_, failed) = served.limited(l)
      Failed(take failed)
    },
    Unrecorded(Limit(l)) => {
      let (_, failed) = served.limited(l)
      Failed(take failed)
    },
    Unrecorded(Storage(e)) => {
      if s.closed {
        return InDoubt(Abandoned())
      }
      Failed(served.refused(take e))
    },
    Unrecorded(Unknown(_)) => InDoubt(Abandoned()),
  }
}

// `end` once every commit the request could see is durable.
fn released_end[S](mut s: Store[S], base: u64, take end: CallEnd) -> CallEnd uses {s} {
  match gate(mut s, base) {
    Ok(()) => take end,
    Error(_) => InDoubt(Abandoned()),
  }
}

// The reserved namespace `hirsel.` is exactly the keys in [RESERVED_LO,
// RESERVED_HI): '/' follows '.'.
const RESERVED_LO: Bytes = b"hirsel."

const RESERVED_HI: Bytes = b"hirsel/"

/// The value under `key` as the transaction sees it. The read enters the
/// run's access set, whether or not `key` holds a value.
pub fn tx_get(tx: Tx, key: Bytes) -> Result[Option[Bytes], TxError]
  requires !reserved(key) {
  // Inline, passing no Tx to a callee: unnarrowed, the scope costs one branch.
  if !tx.scope.whole {
    check(key_held(tx.scope.spans, key), false)?
  }
  if bytes.len(key) > tx.limits.key_bytes {
    return Error(Limit(KeyBytes()))
  }
  recorder.append(tx.points, copy_to(heap, key))
  match ordered_map.get(tx.txn.state, key) {
    Some(v) => Ok(Some(copy_to(heap, v))),
    None() => Ok(None()),
  }
}

/// Stores `value` under `key` when the transaction commits. The commit
/// checks the write limits.
pub fn tx_put(mut tx: Tx, take key: Bytes, take value: Bytes) -> Result[(), TxError]
  requires !reserved(key) {
  admit(tx.scope, key, true)?
  run_put(mut tx.txn, take key, take value)
  Ok(())
}

/// Removes `key` when the transaction commits.
pub fn tx_delete(mut tx: Tx, take key: Bytes) -> Result[(), TxError]
  requires !reserved(key) {
  admit(tx.scope, key, true)?
  run_delete(mut tx.txn, take key)
  Ok(())
}

/// At most `limit` entries with keys between `from` and `to` as the
/// transaction sees them, in `order`, as fresh copies. Keys in the reserved
/// namespace are passed over as if absent, and the scope need not hold them.
/// The interval each part of the scan consumed enters the run's access set:
/// up to the last entry returned when it returned `limit` of them, the whole
/// part otherwise.
pub fn tx_range(
  tx: Tx,
  from: RangeBound[Bytes],
  to: RangeBound[Bytes],
  limit: u64,
  order: ScanOrder
) -> Result[List[(Bytes, Bytes)], TxError] {
  if limit == 0 {
    return Error(InvalidInput())
  }
  let lo = lower_key(from)
  let hi = upper_key(to)
  // The parts of [lo, hi) below and above the reserved namespace.
  let below: Option[(Bytes, Option[Bytes])] = if lo < RESERVED_LO {
    Some((copy lo, Some(min_end(hi, RESERVED_LO))))
  } else {
    None()
  }
  let above: Option[(Bytes, Option[Bytes])] = if before_end(RESERVED_HI, hi) {
    let start = if lo < RESERVED_HI {
      RESERVED_HI
    } else {
      copy lo
    }
    Some((take start, copy hi))
  } else {
    None()
  }
  if !tx.scope.whole {
    if let Some((a, b)) = below {
      check(spans_hold(tx.scope.spans, a, b, false), false)?
    }
    if let Some((a, b)) = above {
      check(spans_hold(tx.scope.spans, a, b, false), false)?
    }
  }
  if limit > tx.limits.range_rows {
    return Error(Limit(RangeRows()))
  }
  let ascending = match order {
    Ascending() => true,
    Descending() => false,
  }
  let (first, second) = if ascending {
    (take below, take above)
  } else {
    (take above, take below)
  }
  let mut out = scan(tx, take first, ascending, limit)
  let got = list.len(out)
  if got < limit {
    for (k, v) in scan(tx, take second, ascending, limit - got) {
      list.push(mut out, (unique k, unique v))
    }
  }
  Ok(take out)
}

// The entries of the part [lo, hi) of a range, at most `limit` of them,
// recording the interval the scan consumed.
fn scan(tx: Tx, take part: Option[(Bytes, Option[Bytes])], ascending: bool, limit: u64) -> List[
  (Bytes, Bytes)
] {
  let Some((lo, hi)) = take part else {
    return []
  }
  if !before_end(lo, hi) {
    return []
  }
  let low: ordered_map.Bound[Bytes] = Included(take lo)
  let high: ordered_map.Bound[Bytes] = match take hi {
    Some(h) => Excluded(take h),
    None() => Unbounded(),
  }
  let direction: ordered_map.Direction = if ascending {
    Ascending()
  } else {
    Descending()
  }
  let rows = entries_in(tx.txn.state, low, high, direction, limit)
  if let Some(span) = consumed(take low, take high, direction, limit, rows) {
    recorder.append(tx.spans, take span)
  }
  take rows
}

// The least key a lower bound admits.
fn lower_key(b: RangeBound[Bytes]) -> Bytes uses {} {
  match b {
    Unbounded() => b"",
    Included(k) => unique k,
    Excluded(k) => successor(k),
  }
}

// The least key above every key an upper bound admits, `None()` for none.
fn upper_key(b: RangeBound[Bytes]) -> Option[Bytes] uses {} {
  match b {
    Unbounded() => None(),
    Included(k) => Some(successor(k)),
    Excluded(k) => Some(unique k),
  }
}

// The least key after `k`: `k` followed by a zero byte.
fn successor(k: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, k)
  list.push(mut out, 0)
  bytes.from_list(take out)
}

// Whether `k` lies before the end `hi` (no end lies after every key).
fn before_end(k: Bytes, hi: Option[Bytes]) -> bool uses {} {
  match hi {
    Some(h) => k < h,
    None() => true,
  }
}

fn min_end(hi: Option[Bytes], k: Bytes) -> Bytes uses {} {
  match hi {
    Some(h) => if h < k {
      unique h
    } else {
      unique k
    },
    None() => unique k,
  }
}

// What `held` found for an access: 0 none, 1 read, 2 read and write.
fn check(held: u8, write: bool) -> Result[(), TxError] uses {} {
  if held == 0 {
    return Error(OutOfScope())
  }
  if write && held == 1 {
    return Error(ReadOnly())
  }
  Ok(())
}

// Checks access to one key. An unnarrowed Tx costs one branch; a narrowed
// one a binary search over its spans, comparing the key in place.
fn admit(scope: KeyScope, key: Bytes, write: bool) -> Result[(), TxError] uses {} {
  if scope.whole {
    return Ok(())
  }
  check(key_held(scope.spans, key), write)
}

// The access `spans` give `key`: 0 none, 1 read, 2 read and write.
fn key_held(spans: List[ScopeSpan], key: Bytes) -> u8 uses {} {
  // The number of spans starting at or before `key`.
  let mut low: u64 = 0
  let mut high = list.len(spans)
  while low < high {
    let mid = low + (high - low) / 2
    if spans[mid].lo <= key {
      low = mid + 1
    } else {
      high = mid
    }
  }
  if low == 0 {
    return 0
  }
  let span = spans[low - 1]
  if !before_end(key, span.hi) {
    return 0
  }
  if span.write {
    2
  } else {
    1
  }
}

// The weakest access `spans` give a key in [lo, hi), 0 when one is outside
// them; an empty interval needs nothing. A merge walk over the spans it
// overlaps.
fn spans_hold(spans: List[ScopeSpan], lo: Bytes, hi: Option[Bytes], write: bool) -> u8 uses {} {
  if !before_end(lo, hi) {
    return 2
  }
  let mut weakest: u8 = 2
  let mut at = copy lo
  for span in spans {
    if !before_end(at, span.hi) {
      continue
    }
    if at < span.lo {
      return 0
    }
    if !span.write {
      weakest = 1
      if write {
        return 1
      }
    }
    match span.hi {
      None() => return weakest,
      Some(end) => {
        let reached = match hi {
          Some(h) => h <= end,
          None() => false,
        }
        if reached {
          return weakest
        }
        at = copy end
      },
    }
  }
  0
}

// Library operations: the byte operations without the reserved-namespace
// requirement, for libraries that keep their own rows under `hirsel.`. They
// check scope as the byte operations do; the engine makes no exception for
// a library's rows.
// Reads one key after checking read access and the key limit.
fn admit_read(tx: Tx, key: Bytes) -> Result[(), TxError] {
  admit(tx.scope, key, false)?
  if bytes.len(key) > tx.limits.key_bytes {
    return Error(Limit(KeyBytes()))
  }
  Ok(())
}

// The value of `key` in this transaction, after `admit_read`. The read
// enters the run's access set.
fn table_read(tx: Tx, take key: Bytes) -> Option[Bytes] in tx {
  let found = ordered_map.get(tx.txn.state, key)
  recorder.append(tx.points, take key)
  found
}

// Writes one key after checking write access and the limits, so a refusal
// leaves the transaction unchanged.
fn table_put(mut tx: Tx, take key: Bytes, take value: Bytes) -> Result[(), TxError] {
  admit(tx.scope, key, true)?
  if let Some(limit) = check_put(tx, key, value) {
    return Error(Limit(limit))
  }
  run_put(mut tx.txn, take key, take value)
  Ok(())
}

// Deletes one key after checking write access and the limits.
fn table_delete(mut tx: Tx, take key: Bytes) -> Result[(), TxError] {
  admit(tx.scope, key, true)?
  if let Some(limit) = check_delete(tx, key) {
    return Error(Limit(limit))
  }
  run_delete(mut tx.txn, take key)
  Ok(())
}

// Reads at most `limit` entries of [lo, hi) after checking read access to all
// of it, reserved keys included, and the row limit.
fn table_range(
  tx: Tx,
  take lo: Bytes,
  take hi: Option[Bytes],
  limit: u64,
  order: ScanOrder
) -> Result[List[(Bytes, Bytes)], TxError] {
  if !tx.scope.whole {
    check(spans_hold(tx.scope.spans, lo, hi, false), false)?
  }
  if limit > tx.limits.range_rows {
    return Error(Limit(RangeRows()))
  }
  let ascending = match order {
    Ascending() => true,
    Descending() => false,
  }
  Ok(scan(tx, Some((take lo, take hi)), ascending, limit))
}

// Checks write access to one key without touching it: an operation that
// writes a key checks that before it reads anything about it.
fn admit_write(tx: Tx, key: Bytes) -> Result[(), TxError] {
  admit(tx.scope, key, true)
}

/// The keys between `from` and `to` outside the reserved namespace, each with
/// `access`.
pub fn keys(from: RangeBound[Bytes], to: RangeBound[Bytes], access: Access) -> KeyScope uses {} {
  let lo = lower_key(from)
  let hi = upper_key(to)
  let write = writable(access)
  let mut parts: List[ScopeSpan] = []
  if lo < RESERVED_LO {
    list.push(
      mut parts,
      ScopeSpan(lo: copy lo, hi: Some(min_end(hi, RESERVED_LO)), write: write)
    )
  }
  if before_end(RESERVED_HI, hi) {
    let start = if lo < RESERVED_HI {
      RESERVED_HI
    } else {
      copy lo
    }
    list.push(mut parts, ScopeSpan(lo: take start, hi: copy hi, write: write))
  }
  normal(parts)
}

/// Every key, the reserved namespace included, with `access`.
pub fn all(access: Access) -> KeyScope uses {} {
  let write = writable(access)
  KeyScope(spans: [ScopeSpan(lo: b"", hi: None(), write: write)], whole: write)
}

// The keys in [lo, hi), the reserved namespace included, with `access`: for
// libraries that build scopes over their own rows.
fn interval(lo: Bytes, hi: Option[Bytes], access: Access) -> KeyScope uses {} {
  normal([ScopeSpan(lo: unique lo, hi: unique hi, write: writable(access))])
}

/// The keys of `a` and of `b`, each with the stronger of its accesses.
pub fn join(a: KeyScope, b: KeyScope) -> KeyScope uses {} {
  let mut parts: List[ScopeSpan] = []
  for span in a.spans {
    list.push(mut parts, unique span)
  }
  for span in b.spans {
    list.push(mut parts, unique span)
  }
  normal(parts)
}

/// Runs `body` once with a `Tx` of the same transaction whose scope is exactly
/// `scope`, and returns its result; `OutOfScope()` without running `body`
/// unless `scope` is within `tx`'s scope. The narrowed `Tx` reads the same
/// state, and its writes are the transaction's writes.
pub fn narrow[R: inert](mut tx: Tx, scope: KeyScope, body: fn(mut sub: Tx) -> R uses {}) -> Result[
  R,
  TxError
] {
  if !scope_within(scope, tx.scope) {
    return Error(OutOfScope())
  }
  let outer = replace(mut tx.scope, unique scope)
  let returned = body(mut tx)
  tx.scope = take outer
  Ok(take returned)
}

/// `narrow` to `scope` with every key Read, through a borrowed `Tx`: `body`
/// borrows a facet of the same transaction whose scope is `scope`, read only,
/// so it cannot write. Its reads enter the run's access set.
pub fn narrow_read[R: inert](tx: Tx, scope: KeyScope, body: fn(sub: Tx) -> R uses {}) -> Result[
  R,
  TxError
] {
  let inner = read_only(scope)
  if !scope_within(inner, tx.scope) {
    return Error(OutOfScope())
  }
  // The facet sees the same state; its recorders hand what its body read to
  // the parent's when it ends.
  let facet = Tx(
    txn: unique tx.txn,
    limits: unique tx.limits,
    scope: take inner,
    points: recorder.new(),
    spans: recorder.new()
  )
  let returned = body(facet)
  let Tx(txn: _, limits: _, scope: _, points: points, spans: spans) = take facet
  let point_keys: List[Bytes] = recorder.finish(take points)
  for key in take point_keys {
    recorder.append(tx.points, take key)
  }
  let span_reads: List[Span] = recorder.finish(take spans)
  for span in take span_reads {
    recorder.append(tx.spans, take span)
  }
  Ok(take returned)
}

// `scope` with every key Read.
fn read_only(scope: KeyScope) -> KeyScope uses {} {
  let mut parts: List[ScopeSpan] = []
  for span in scope.spans {
    list.push(
      mut parts,
      ScopeSpan(lo: unique span.lo, hi: unique span.hi, write: false)
    )
  }
  normal(parts)
}

// Whether every key `inner` holds, `outer` holds with an access at least as
// strong: one merge pass over both span lists.
fn scope_within(inner: KeyScope, outer: KeyScope) -> bool uses {} {
  if outer.whole {
    return true
  }
  for span in inner.spans {
    let held = spans_hold(outer.spans, span.lo, span.hi, span.write)
    if held == 0 || span.write && held == 1 {
      return false
    }
  }
  true
}

fn writable(access: Access) -> bool uses {} {
  match access {
    Read() => false,
    ReadWrite() => true,
  }
}

// The scope of an unnarrowed Tx.
fn everything() -> KeyScope uses {} {
  all(ReadWrite())
}

// The normal form of a union of spans: each key with its strongest access,
// sorted, disjoint, nonempty, adjacent spans of equal access merged.
fn normal(parts: List[ScopeSpan]) -> KeyScope uses {} {
  // Every finite span end, sorted and distinct, and whether a span is endless.
  let mut cuts: List[Bytes] = []
  let mut endless = false
  for span in parts {
    if !before_end(span.lo, span.hi) {
      continue
    }
    insert_cut(mut cuts, span.lo)
    match span.hi {
      Some(h) => insert_cut(mut cuts, h),
      None() => {
        endless = true
      },
    }
  }
  let mut spans: List[ScopeSpan] = []
  let n = list.len(cuts)
  let mut i: u64 = 0
  while i < n {
    let lo = cuts[i]
    let hi: Option[Bytes] = if i + 1 < n {
      Some(copy cuts[i + 1])
    } else {
      None()
    }
    i += 1
    if hi == None() && !endless {
      continue
    }
    // The strongest access of the parts that cover the piece [lo, hi).
    let mut held: u8 = 0
    for span in parts {
      let starts = span.lo <= lo
      let ends = match span.hi {
        None() => true,
        Some(e) => match hi {
          Some(h) => h <= e,
          None() => false,
        },
      }
      if starts && ends && before_end(span.lo, span.hi) {
        let a: u8 = if span.write {
          2
        } else {
          1
        }
        if a > held {
          held = a
        }
      }
    }
    if held == 0 {
      continue
    }
    let write = held == 2
    let last = list.len(spans)
    if last > 0 && spans[last - 1].write == write && spans[last - 1].hi == Some(copy lo) {
      spans[last - 1].hi = hi
    } else {
      list.push(mut spans, ScopeSpan(lo: copy lo, hi: hi, write: write))
    }
  }
  let whole = list.len(spans) == 1 && spans[0].write && spans[0].lo == b"" && spans[0].hi == None()
  KeyScope(spans: take spans, whole: whole)
}

// Inserts `k` into the sorted, distinct `cuts` unless it is there.
fn insert_cut(mut cuts: unique List[Bytes], k: Bytes) -> () uses {} {
  let mut at = list.len(cuts)
  while at > 0 && k < cuts[at - 1] {
    at -= 1
  }
  if at > 0 && cuts[at - 1] == k {
    return
  }
  list.push(mut cuts, unique k)
  let mut j = list.len(cuts) - 1
  while j > at {
    core@1/list.swap(mut cuts, j - 1, j)
    j -= 1
  }
}

fn stream_key(stream: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  for b in b"hirsel.streams/" {
    list.push(mut out, b)
  }
  for b in stream {
    list.push(mut out, b)
  }
  bytes.from_list(take out)
}

// Puts into `set` the stream row `row`, its retained ends followed by
// `outcome` at `req`'s position.
fn put_row(
  mut set: Run,
  take key: Bytes,
  take row: StreamRow,
  req: CallRequest,
  take outcome: Bytes
) -> () uses {} {
  let mut recorded = take row
  list.push(
    mut recorded.retained,
    Retained(position: req.position, digest: unique req.digest, outcome: take outcome)
  )
  run_put(mut set, take key, codec.encode(recorded))
}

// Releases a refusal once every commit the request could see is durable.
fn refuse[S, R, E](mut s: Store[S], base: u64, take f: CallFailure[E]) -> Result[
  R,
  CallFailure[E]
] {
  gate(mut s, base) ? released_call
  Error(f)
}

// The limit a transaction's writes exceed, if any. The total is the encoded
// size of the log object holding this commit alone.
fn over_limit(limits: StoreLimits, writes: ordered_map.OrderedMap[Bytes, Option[Bytes]]) -> Option[
  TxLimit
] uses {} {
  let start: (u64, Option[TxLimit]) = (LOG_FRAME + COMMIT_FRAME, None())
  let (total, found) = ordered_map.fold_range(
    writes,
    Unbounded(),
    Unbounded(),
    Ascending(),
    start,
    fn(take acc: (u64, Option[TxLimit]), k: Bytes, v: Option[Bytes]) -> (
      (u64, Option[TxLimit]),
      bool
    ) {
      let (sum, _) = acc
      if bytes.len(k) > limits.key_bytes {
        return ((sum, Some(KeyBytes())), false)
      }
      let encoded = match v {
        Some(value) => {
          if bytes.len(value) > limits.value_bytes {
            return ((sum, Some(ValueBytes())), false)
          }
          17 + bytes.len(k) + bytes.len(value)
        },
        None() => 9 + bytes.len(k),
      }
      ((sum + encoded, None()), true)
    }
  )
  match found {
    Some(l) => Some(l),
    None() => if total > limits.transaction_bytes {
      Some(TransactionBytes())
    } else {
      None()
    },
  }
}

// A commit's encoded size inside a log object.
fn commit_bytes(set: List[Write]) -> u64 uses {} {
  let mut total = COMMIT_FRAME
  for w in set {
    total += match w {
      Put(key: k, value: v) => 17 + bytes.len(k) + bytes.len(v),
      Delete(key: k) => 9 + bytes.len(k),
    }
  }
  total
}

// The output gate at `version`: writes the pending group when a commit at or
// below it is not yet durable. Nothing was attempted for this outcome, so a
// failure is `Storage`.
fn gate[S](mut s: Store[S], version: u64) -> Result[(), Unreleased] {
  if version <= s.durable {
    return Ok(())
  }
  match flush(mut s) {
    Ok(()) => Ok(()),
    Error(e) => Error(Storage(e)),
  }
}

// Commits `t` when it writes anything and waits until it is durable; a
// transaction without writes waits for the commit it began at.
fn settle[S](mut s: Store[S], take t: Run) -> Result[(), Unreleased] {
  if ordered_map.len(t.writes) == 0 {
    let base = t.base
    discard(mut s, take t)
    return gate(mut s, base)
  }
  let base = t.base
  let ticket = match commit(mut s, take t) {
    Ok(k) => k,
    Error(Limit(l)) => {
      gate(mut s, base)?
      return Error(Limit(l))
    },
    Error(e) => return Error(unsettled(take e)),
  }
  match durable(mut s, ticket) {
    Ok(()) => Ok(()),
    Error(e) => Error(unsettled(take e)),
  }
}

// A storage error from a create that may have happened leaves the commit's
// durability undecided; the store's other errors, `Refused` included, prove it
// did not happen.
fn unsettled(take e: StoreError) -> Unreleased uses {} {
  match e {
    Storage(f) => Unknown(Storage(f)),
    other => Storage(copy other),
  }
}

// Why an outcome could not be released: nothing was committed, or a commit's
// durability is undecided.
type Unreleased = Storage(StoreError) | Unknown(StoreError) | Limit(TxLimit)

fn released[E](take u: Unreleased) -> TxFailure[E] uses {} {
  match u {
    Storage(e) => Storage(copy e),
    Unknown(e) => Unknown(copy e),
    Limit(l) => Limit(l),
  }
}

fn released_call[E](take u: Unreleased) -> CallFailure[E] uses {} {
  Tx(released(take u))
}

/// Flushes the pending group and returns the backend state, for explicit
/// lifecycle management, simulation observations or reopening the same medium.
pub fn into_state[S](take store: Store[S]) -> Result[S, StoreError] uses {store} {
  let mut s = take store
  if s.closed {
    return Error(Closed())
  }
  flush(mut s)?
  let Store(state: state, ..) = take s
  Ok(take state)
}

// A commit's write set, in key order.
fn write_set(writes: ordered_map.OrderedMap[Bytes, Option[Bytes]]) -> List[Write] uses {} {
  let first: List[Write] = []
  ordered_map.fold_range(
    writes,
    Unbounded(),
    Unbounded(),
    Ascending(),
    take first,
    fn(take acc: List[Write], k: Bytes, v: Option[Bytes]) -> (List[Write], bool) {
      let mut out = take acc
      match v {
        Some(value) => list.push(mut out, Put(key: unique k, value: unique value)),
        None() => list.push(mut out, Delete(key: unique k)),
      }
      (take out, true)
    }
  )
}

// Effective entries of `m` in a range, copied out.
fn entries_in(
  m: ordered_map.OrderedMap[Bytes, Bytes],
  from: ordered_map.Bound[Bytes],
  to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64
) -> List[(Bytes, Bytes)] uses {} {
  let start: List[(Bytes, Bytes)] = []
  if limit == 0 {
    return start
  }
  ordered_map.fold_range(
    m,
    from,
    to,
    direction,
    take start,
    fn(take acc: List[(Bytes, Bytes)], k: Bytes, v: Bytes) -> (
      List[(Bytes, Bytes)],
      bool
    ) {
      let mut out = take acc
      list.push(mut out, (unique k, unique v))
      let more = list.len(out) < limit
      (take out, more)
    }
  )
}

// Closes the store on an error that ends it. Every storage mutation goes
// through `create`, `remove` or `make_dir`, which count it for the fault seam.
fn stop[S](mut s: Store[S], take e: StoreError) -> StoreError uses {} {
  s.closed = true
  e
}

// Counts one storage mutation, refusing it when the fault seam says so.
fn mutation[S](mut s: Store[S]) -> Result[(), StoreError] uses {} {
  if let StopAfterWrites(n) = s.config.faults {
    if s.writes >= n {
      return Error(stop(mut s, Injected()))
    }
  }
  s.writes += 1
  Ok(())
}

fn create[S](mut s: Store[S], name: String, take data: Bytes, mode: Durability) -> Result[
  (),
  StoreError
] {
  mutation(mut s)?
  match s.backend.put_new(mut s.state, name, data, mode) {
    Ok(()) => Ok(()),
    Error(Taken()) => Error(stop(mut s, Fenced())),
    Error(Refused(e)) => Error(stop(mut s, Refused(e))),
    Error(Undecided(_)) => {
      // A lost response or a barrier that failed after the object became
      // visible. The same create again succeeds on equal bytes only once they
      // are durable, and finds other bytes taken; anything else leaves the
      // outcome undecided.
      match s.backend.put_new(mut s.state, name, data, mode) {
        Ok(()) => Ok(()),
        Error(Taken()) => Error(stop(mut s, Fenced())),
        Error(Refused(e)) | Error(Undecided(e)) => Error(stop(mut s, Storage(e))),
      }
    },
  }
}

fn remove[S](mut s: Store[S], name: String) -> Result[(), StoreError] {
  mutation(mut s)?
  match s.backend.remove(mut s.state, name) {
    Ok(()) | Error(NotFound()) => Ok(()),
    Error(e) => Error(stop(mut s, Storage(e))),
  }
}

fn make_dir[S](mut s: Store[S], name: String) -> Result[(), StoreError] {
  mutation(mut s)?
  match s.backend.mkdir(mut s.state, name) {
    Ok(()) | Error(AlreadyExists()) => Ok(()),
    Error(e) => Error(stop(mut s, Storage(e))),
  }
}

fn read[S](mut s: Store[S], name: String) -> Result[Bytes, StoreError] {
  match s.backend.read(mut s.state, name) {
    Ok(data) => Ok(unique data),
    Error(e) => Error(stop(mut s, Storage(e))),
  }
}

// The ids of the objects under `kind`, ascending; other names (a crashed
// put_new's temporary) are ignored.
fn list_ids[S](mut s: Store[S], kind: String) -> Result[List[u64], StoreError] {
  let entries = match s.backend.list(mut s.state, kind) {
    Ok(entries) => entries,
    Error(e) => return Error(stop(mut s, Storage(e))),
  }
  let prefix_len = string.byte_len(kind) + 1
  let mut ids: List[u64] = []
  for entry in entries {
    let name = string.as_bytes(entry)
    if bytes.len(name) != prefix_len + 20 {
      continue
    }
    let mut id: u64 = 0
    let mut digits = true
    for i in prefix_len..bytes.len(name) {
      let c = name[i]
      if c < b'0' || c > b'9' {
        digits = false
        break
      }
      let digit: u64 = int.widen(c - b'0')
      let Some(next) = int.checked_add(id * 10, digit) else {
        digits = false
        break
      }
      id = next
    }
    if digits {
      list.push(mut ids, id)
    }
  }
  Ok(ids)
}

fn object_name(kind: String, id: u64) -> String uses {} {
  let mut out: List[u8] = []
  text.append(mut out, kind)
  list.push(mut out, b'/')
  // Twenty decimal digits, most significant first, so names sort as ids do.
  let mut place: u64 = 10000000000000000000
  while place > 0 {
    list.push(mut out, b'0' + int.truncate(id / place % 10))
    place = place / 10
  }
  text.finish_valid(take out)
}

fn log_name(id: u64) -> String uses {} {
  object_name("log", id)
}

fn snap_name(id: u64) -> String uses {} {
  object_name("snap", id)
}

fn manifest_name(id: u64) -> String uses {} {
  object_name("manifest", id)
}

// Writes the pending commits as one log object, the commit point of each.
fn flush[S](mut s: Store[S]) -> Result[(), StoreError] {
  if list.len(s.pending) == 0 {
    return Ok(())
  }
  let id = s.next_log
  let data = encode_log(id, s.epoch, s.durable + 1, s.pending)
  let mode = s.config.durability
  create(mut s, log_name(id), take data, mode)?
  s.next_log += 1
  s.durable = s.visible
  s.pending = []
  s.pending_bytes = 0
  Ok(())
}

fn publish_manifest[S](mut s: Store[S]) -> Result[(), StoreError] {
  let id = s.next_manifest
  let data = encode_manifest(id, s.epoch, s.snap, s.log_start)
  create(mut s, manifest_name(id), take data, Durable())?
  s.next_manifest += 1
  Ok(())
}

// Loads the newest valid state, then claims the store at the next epoch.
fn recover[S](mut s: Store[S]) -> Result[(), StoreError] {
  make_dir(mut s, "manifest")?
  make_dir(mut s, "log")?
  make_dir(mut s, "snap")?
  let mut max_epoch: u64 = 0
  let manifests = list_ids(mut s, "manifest")?
  if list.len(manifests) > 0 {
    let id = manifests[list.len(manifests) - 1]
    let name = manifest_name(id)
    let data = read(mut s, copy name)?
    let Ok(m) = decode_manifest(data, id) else {
      return Error(stop(mut s, Corrupt(name)))
    }
    max_epoch = m.epoch
    s.next_manifest = id + 1
    s.snap = m.snap
    s.log_start = m.log_start
  }
  s.next_log = s.log_start
  if let Some(snap) = s.snap {
    let mut stream: List[u8] = []
    for i in 0u64..snap.parts {
      let name = snap_name(snap.first + i)
      let data = read(mut s, copy name)?
      let Ok(()) = decode_snapshot_part(data, snap, i, mut stream) else {
        return Error(stop(mut s, Corrupt(name)))
      }
    }
    let Ok(index) = decode_entries(bytes.from_list(take stream)) else {
      return Error(stop(mut s, Corrupt(snap_name(snap.first))))
    }
    s.index = take index
    s.visible = snap.seq
    s.next_snap = snap.first + snap.parts
  }
  let snaps = list_ids(mut s, "snap")?
  if list.len(snaps) > 0 && snaps[list.len(snaps) - 1] >= s.next_snap {
    // A snapshot an interrupted compaction wrote without its manifest.
    s.next_snap = snaps[list.len(snaps) - 1] + 1
  }
  let logs = list_ids(mut s, "log")?
  let mut log_epoch: u64 = 0
  let mut tail = false
  for id in logs {
    if id < s.log_start {
      continue
    }
    let name = log_name(id)
    if tail {
      // Past a lost or torn volatile log: the rest of the suffix is lost too.
      remove(mut s, take name)?
      continue
    }
    let durable_mode = match s.config.durability {
      Durable() => true,
      Volatile() => false,
    }
    let data = read(mut s, copy name)?
    let decoded = if id == s.next_log {
      decode_log(data, id)
    } else {
      Error(())
    }
    let Ok(batch) = decoded else {
      // A gap or a bad object. A Durable create is whole or nothing at its
      // final name, so a bad Durable log, the last one included, is
      // corruption after its acknowledgement: refuse and remove nothing.
      // Volatile logs lose any suffix, so the first bad one truncates the
      // log there.
      if durable_mode {
        return Error(stop(mut s, Corrupt(name)))
      }
      remove(mut s, take name)?
      tail = true
      continue
    }
    // Epochs never decrease along the log: a stale writer's object cannot
    // follow a newer writer's fence.
    if batch.epoch < log_epoch {
      return Error(stop(mut s, Corrupt(name)))
    }
    log_epoch = batch.epoch
    let mut seq = batch.first_seq
    for set in batch.commits {
      if seq > s.visible + 1 {
        return Error(stop(mut s, Corrupt(copy name)))
      }
      if seq == s.visible + 1 {
        apply(mut s.index, set)
        s.visible = seq
      }
      seq += 1
    }
    s.next_log = id + 1
  }
  s.durable = s.visible
  let newest = if log_epoch > max_epoch {
    log_epoch
  } else {
    max_epoch
  }
  claim(mut s, newest + 1)
}

fn apply(mut index: ordered_map.OrderedMap[Bytes, Bytes], set: List[Write]) -> () uses {} {
  for w in set {
    match w {
      Put(key: k, value: v) => ordered_map.insert(mut index, unique k, unique v),
      Delete(key: k) => {
        let _ = ordered_map.remove(mut index, k)
      },
    }
  }
}

// Fences every older writer, then records the new epoch in a manifest.
fn claim[S](mut s: Store[S], epoch: u64) -> Result[(), StoreError] {
  s.epoch = epoch
  let id = s.next_log
  let empty: List[List[Write]] = []
  let fence = encode_log(id, epoch, s.visible + 1, empty)
  create(mut s, log_name(id), take fence, Durable())?
  s.next_log += 1
  publish_manifest(mut s)
}

// Objects are a header (magic, version, kind, id, epoch), a body and a
// CRC-32C of everything before it, all integers little-endian.
type Manifest {
  epoch: u64,
  snap: Option[SnapRef],
  log_start: u64,
}

// A snapshot: the commit it reflects, held as `parts` objects from `first`.
type SnapRef {
  first: u64,
  seq: u64,
  parts: u64,
}

type Group {
  epoch: u64,
  first_seq: u64,
  commits: List[List[Write]],
}

fn put_u8(mut out: List[u8], value: u8) -> () uses {} {
  list.push(mut out, value)
}

fn put_u32(mut out: List[u8], value: u32) -> () uses {} {
  for i in 0u32..4 {
    list.push(mut out, int.truncate(value >> i * 8))
  }
}

fn put_u64(mut out: List[u8], value: u64) -> () uses {} {
  for i in 0u64..8 {
    list.push(mut out, int.truncate(value >> i * 8))
  }
}

fn put_bytes(mut out: List[u8], data: Bytes) -> () uses {} {
  put_u64(mut out, bytes.len(data))
  for b in data {
    list.push(mut out, b)
  }
}

fn header(kind: u8, id: u64, epoch: u64) -> List[u8] uses {} {
  let mut out: List[u8] = []
  put_u32(mut out, MAGIC)
  put_u8(mut out, VERSION)
  put_u8(mut out, kind)
  put_u64(mut out, id)
  put_u64(mut out, epoch)
  out
}

fn seal(take out: List[u8]) -> Bytes uses {} {
  let mut sealed = take out
  let body = bytes.from_list(copy sealed)
  put_u32(mut sealed, crc32c.digest(body))
  bytes.from_list(take sealed)
}

fn encode_log(id: u64, epoch: u64, first_seq: u64, commits: List[List[Write]]) -> Bytes uses {} {
  let mut out = header(KIND_LOG, id, epoch)
  put_u64(mut out, first_seq)
  put_u64(mut out, list.len(commits))
  for set in commits {
    put_u64(mut out, list.len(set))
    for w in set {
      match w {
        Put(key: k, value: v) => {
          put_u8(mut out, OP_PUT)
          put_bytes(mut out, k)
          put_bytes(mut out, v)
        },
        Delete(key: k) => {
          put_u8(mut out, OP_DELETE)
          put_bytes(mut out, k)
        },
      }
    }
  }
  seal(take out)
}

// A snapshot is its entry stream (the entry count, then each key and value)
// cut into parts of at most `payload` bytes, one object each from `first`.
fn encode_snapshot(
  first: u64,
  epoch: u64,
  seq: u64,
  index: ordered_map.OrderedMap[Bytes, Bytes],
  payload: u64
) -> List[Bytes] uses {} {
  let mut start: List[u8] = []
  put_u64(mut start, ordered_map.len(index))
  let stream = ordered_map.fold_range(
    index,
    Unbounded(),
    Unbounded(),
    Ascending(),
    take start,
    fn(take acc: List[u8], k: Bytes, v: Bytes) -> (List[u8], bool) {
      let mut buffer = take acc
      put_bytes(mut buffer, k)
      put_bytes(mut buffer, v)
      (take buffer, true)
    }
  )
  let total = list.len(stream)
  let parts = (total + payload - 1) / payload
  let mut objects: List[Bytes] = []
  for i in 0u64..parts {
    let mut part = header(KIND_SNAP, first + i, epoch)
    put_u64(mut part, seq)
    put_u64(mut part, i)
    put_u64(mut part, parts)
    let end = if (i + 1) * payload < total {
      (i + 1) * payload
    } else {
      total
    }
    for at in i * payload..end {
      list.push(mut part, stream[at])
    }
    list.push(mut objects, seal(take part))
  }
  objects
}

fn encode_manifest(id: u64, epoch: u64, snap: Option[SnapRef], log_start: u64) -> Bytes uses {} {
  let mut out = header(KIND_MANIFEST, id, epoch)
  match snap {
    Some(r) => {
      put_u8(mut out, 1)
      put_u64(mut out, r.first)
      put_u64(mut out, r.seq)
      put_u64(mut out, r.parts)
    },
    None() => put_u8(mut out, 0),
  }
  put_u64(mut out, log_start)
  seal(take out)
}

// A cursor over an object's bytes. Every read checks the bounds first.
type Cursor {
  at: u64,
  end: u64,
}

fn get_u8(data: Bytes, mut c: Cursor) -> Result[u8, ()] uses {} {
  if c.at >= c.end {
    return Error(())
  }
  let b = data[c.at]
  c.at += 1
  Ok(b)
}

fn get_u32(data: Bytes, mut c: Cursor) -> Result[u32, ()] uses {} {
  if c.end - c.at < 4 {
    return Error(())
  }
  let mut value: u32 = 0
  for i in 0u64..4 {
    let b: u32 = int.widen(data[c.at + i])
    value = value | b << int.truncate(i * 8)
  }
  c.at += 4
  Ok(value)
}

fn get_u64(data: Bytes, mut c: Cursor) -> Result[u64, ()] uses {} {
  if c.end - c.at < 8 {
    return Error(())
  }
  let mut value: u64 = 0
  for i in 0u64..8 {
    let b: u64 = int.widen(data[c.at + i])
    value = value | b << i * 8
  }
  c.at += 8
  Ok(value)
}

fn get_bytes(data: Bytes, mut c: Cursor) -> Result[Bytes, ()] uses {} {
  let n = get_u64(data, mut c)?
  if c.end - c.at < n {
    return Error(())
  }
  let part = unique bytes.slice(data, c.at, c.at + n)
  c.at += n
  Ok(take part)
}

// Checks the trailer and header and returns a cursor over the body and the
// object's epoch.
fn open_object(data: Bytes, kind: u8, id: u64) -> Result[(Cursor, u64), ()] uses {} {
  let total = bytes.len(data)
  if total < 26 {
    return Error(())
  }
  let mut trailer = Cursor(at: total - 4, end: total)
  let stored = get_u32(data, mut trailer)?
  if crc32c.digest(bytes.slice(data, 0, total - 4)) != stored {
    return Error(())
  }
  let mut c = Cursor(at: 0, end: total - 4)
  if get_u32(data, mut c)? != MAGIC || get_u8(data, mut c)? != VERSION || get_u8(
    data,
    mut c
  )? != kind {
    return Error(())
  }
  if get_u64(data, mut c)? != id {
    return Error(())
  }
  let epoch = get_u64(data, mut c)?
  Ok((c, epoch))
}

fn decode_manifest(data: Bytes, id: u64) -> Result[Manifest, ()] uses {} {
  let (c0, epoch) = open_object(data, KIND_MANIFEST, id)?
  let mut c = c0
  let snap: Option[SnapRef] = match get_u8(data, mut c)? {
    0 => None(),
    1 => {
      let first = get_u64(data, mut c)?
      let seq = get_u64(data, mut c)?
      let parts = get_u64(data, mut c)?
      if parts == 0 {
        return Error(())
      }
      Some(SnapRef(first: first, seq: seq, parts: parts))
    },
    _ => return Error(()),
  }
  let log_start = get_u64(data, mut c)?
  if c.at != c.end {
    return Error(())
  }
  Ok(Manifest(epoch: epoch, snap: snap, log_start: log_start))
}

fn decode_log(data: Bytes, id: u64) -> Result[Group, ()] uses {} {
  let (c0, epoch) = open_object(data, KIND_LOG, id)?
  let mut c = c0
  let first_seq = get_u64(data, mut c)?
  let count = get_u64(data, mut c)?
  let mut commits: List[List[Write]] = []
  for _ in 0u64..count {
    let writes = get_u64(data, mut c)?
    let mut set: List[Write] = []
    for _ in 0u64..writes {
      let op = get_u8(data, mut c)?
      let k = get_bytes(data, mut c)?
      if op == OP_PUT {
        let v = get_bytes(data, mut c)?
        list.push(mut set, Put(key: take k, value: take v))
      } else if op == OP_DELETE {
        list.push(mut set, Delete(key: take k))
      } else {
        return Error(())
      }
    }
    list.push(mut commits, take set)
  }
  if c.at != c.end {
    return Error(())
  }
  Ok(Group(epoch: epoch, first_seq: first_seq, commits: take commits))
}

// Checks part `i` of `snap` and appends its share of the entry stream.
fn decode_snapshot_part(data: Bytes, snap: SnapRef, i: u64, mut stream: List[u8]) -> Result[
  (),
  ()
] uses {} {
  let (c0, _) = open_object(data, KIND_SNAP, snap.first + i)?
  let mut c = c0
  if get_u64(data, mut c)? != snap.seq || get_u64(data, mut c)? != i || get_u64(
    data,
    mut c
  )? != snap.parts {
    return Error(())
  }
  for at in c.at..c.end {
    list.push(mut stream, data[at])
  }
  Ok(())
}

fn decode_entries(data: Bytes) -> Result[ordered_map.OrderedMap[Bytes, Bytes], ()] uses {} {
  let mut c = Cursor(at: 0, end: bytes.len(data))
  let count = get_u64(data, mut c)?
  let mut index: ordered_map.OrderedMap[Bytes, Bytes] = ordered_map.empty(compare_keys)
  for _ in 0u64..count {
    let k = get_bytes(data, mut c)?
    let v = get_bytes(data, mut c)?
    ordered_map.insert(mut index, take k, take v)
  }
  if c.at != c.end || ordered_map.len(index) != count {
    return Error(())
  }
  Ok(take index)
}

// Typed operations preflight the complete prospective write set before mutating
// the live Tx, so a limit refusal changes nothing and the body can continue.
fn check_put(tx: Tx, key: Bytes, value: Bytes) -> Option[TxLimit] uses {} {
  let mut trial = copy tx.txn
  run_put(mut trial, unique key, unique value)
  over_limit(tx.limits, trial.writes)
}

fn check_delete(tx: Tx, key: Bytes) -> Option[TxLimit] uses {} {
  let mut trial = copy tx.txn
  run_delete(mut trial, unique key)
  over_limit(tx.limits, trial.writes)
}

// Preflights deleting every key in `doomed` together, as `check_delete` does one.
fn check_delete_all(tx: Tx, doomed: List[Bytes]) -> Option[TxLimit] uses {} {
  let mut trial = copy tx.txn
  for key in doomed {
    run_delete(mut trial, unique key)
  }
  over_limit(tx.limits, trial.writes)
}

// Every entry in [lo, hi), reserved keys included, after checking read (or,
// with `write`, write) access to all of it: for a library operation over a
// whole namespace of its own, such as dropping a table. `range_rows` does not
// bound it; the commit's limits do.
fn table_all(tx: Tx, take lo: Bytes, take hi: Option[Bytes], write: bool) -> Result[
  List[(Bytes, Bytes)],
  TxError
] {
  if !tx.scope.whole {
    check(spans_hold(tx.scope.spans, lo, hi, write), write)?
  }
  Ok(scan(tx, Some((take lo, take hi)), true, 18446744073709551615))
}

// Deletes the keys starting with `prefix` in key order within the
// transaction's limits, after checking write access to all of them; true when
// none remain. The transaction must write nothing else.
fn table_delete_within(mut tx: Tx, prefix: Bytes) -> Result[bool, TxError] {
  let (low, high) = prefix_bounds(prefix)
  if !tx.scope.whole {
    let hi: Option[Bytes] = match high {
      Excluded(h) => Some(unique h),
      _ => None(),
    }
    check(spans_hold(tx.scope.spans, prefix, hi, true), true)?
  }
  Ok(delete_within(mut tx.txn, tx.limits, low, high))
}

const BASE: Addr = Addr(ip: V4(0xc0000201), port: 40000)

const PEER_A: Addr = Addr(ip: V4(0xc633640c), port: 46000)

const PEER_B: Addr = Addr(ip: V4(0xc633640c), port: 46100)

fn entropy(id: u64) -> stun_ice.Entropy {
    stun_ice.Entropy(transaction: stun_ice.Transaction(high: 0, low: id), jitter: 0)
}

fn new_full() -> Result[stun_ice.Agent, stun_ice.IceError] {
    let local = stun_ice.credentials(b"lite", b"LocalPassword1234567890")?
    let mut locals: List[stun_ice.LocalCandidate] = list.new()
    let host = stun_ice.Candidate(component: 1, address: BASE, foundation: 1, priority: 0x7e0001ff)
    list.push(mut locals, stun_ice.LocalCandidate(candidate: host, base: BASE))
    stun_ice.full(take local, take locals, Controlled, 10, 10)
}

fn configure_peer(mut agent: stun_ice.Agent) -> Result[(), stun_ice.IceError] {
    let remote = stun_ice.credentials(b"full", b"RemotePassword123456789")?
    stun_ice.full_remote_credentials(mut agent, take remote, 0, 0)
}

fn wire(out: Bytes, n: u64, expected: Bytes) {
    if list.compare_bytes(list.slice(out, 0, n), expected) != Equal {
        fail("ICE datagram differs from the independent fixture")
    }
}

fn expect_send(action: stun_ice.Poll, out: Bytes, port: u16, expected: Bytes) {
    let Send(path, n) = action else {
        fail("expected one paced STUN transmission")
    }
    if path.base.port != 40000 || path.peer.port != port || path.component != 1 {
        fail("sent the check over the wrong candidate pair")
    }
    wire(out, n, expected)
}

fn expect_reply(action: stun_ice.Receive, out: Bytes, expected: Bytes) {
    let Reply(n) = action else {
        fail("expected a STUN reply")
    }
    wire(out, n, expected)
}

fn selected(agent: stun_ice.Agent, now: u64) -> bool {
    if let Some(route) = stun_ice.full_selected(agent, 1, now) {
        if let V4(0xc0000209) = route.mapped.ip {} else {
            fail("lost the peer-reflexive local address")
        }
        if route.path.peer.port != 46100 || route.mapped.port != 41000 {
            fail("wrong pair selected")
        }
        true
    } else {
        false
    }
}

/// bug: accept conflicting roles or nominate before a successful check; keep sending after consent expires.
/// oracle: RFC 8445 sections 6–8 and RFC 7675 section 5, with independent Binding datagrams.
@test
fn full_connectivity() -> Result[(), stun_ice.IceError] {
    let mut agent = new_full()?
    configure_peer(mut agent)?
    stun_ice.full_add_remote(mut agent, stun_ice.Candidate(component: 1, address: PEER_A, foundation: 2, priority: 0x6e0001ff))?
    stun_ice.full_add_remote(mut agent, stun_ice.Candidate(component: 1, address: PEER_B, foundation: 2, priority: 0x6e0000ff))?
    let mut scratch: Bytes = list.with_capacity(160)
    list.fill(mut scratch, 160, 0)
    let mut output: Bytes = list.with_capacity(128)
    list.fill(mut output, 128, 0)
    let reply = stun_ice.full_receive(mut agent, BASE, PEER_A, conflicting_check(), 0, entropy(98), mut output, mut scratch)?
    expect_reply(reply, output, conflict_reply())
    if stun_ice.full_role(agent) != Controlled {
        fail("lower controlled tiebreaker did not retain its role")
    }
    let first = stun_ice.full_poll(mut agent, 0, entropy(101), mut output, mut scratch)?
    expect_send(first, output, 46000, first_check())
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_A, first_conflict(), 1, entropy(99), mut output, mut scratch)?
    if stun_ice.full_role(agent) != Controlling {
        fail("authenticated 487 did not switch the check-sender to controlling")
    }
    let wait = stun_ice.full_poll(mut agent, 49000000, entropy(100), mut output, mut scratch)?
    if let WakeAt(50000000) = wait {} else {
        fail("triggered retry ignored Ta")
    }
    let new_role = stun_ice.full_poll(mut agent, 50000000, entropy(102), mut output, mut scratch)?
    expect_send(new_role, output, 46000, retried_check())
    let retry = stun_ice.full_poll(mut agent, 550000000, entropy(999), mut output, mut scratch)?
    expect_send(retry, output, 46000, retried_check())
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_A, first_failure(), 551000000, entropy(99), mut output, mut scratch)?
    let backup = stun_ice.full_poll(mut agent, 600000000, entropy(103), mut output, mut scratch)?
    expect_send(backup, output, 46100, backup_check())
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_B, backup_success(), 601000000, entropy(99), mut output, mut scratch)?
    if selected(agent, 601000000) {
        fail("ordinary check selected an unnominated pair")
    }
    let nomination = stun_ice.full_poll(mut agent, 650000000, entropy(104), mut output, mut scratch)?
    expect_send(nomination, output, 46100, backup_nomination())
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_B, nomination_success(), 651000000, entropy(99), mut output, mut scratch)?
    if !selected(agent, 651000000) || selected(agent, 30651000000) {
        fail("nominated route did not have a 30-second consent window")
    }
    let first_probe = stun_ice.full_poll(mut agent, 4651000000, entropy(105), mut output, mut scratch)?
    expect_send(first_probe, output, 46100, consent_probe())
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_A, consent_success(), 4652000000, entropy(99), mut output, mut scratch)?
    if selected(agent, 30651000000) {
        fail("wrong source address extended consent")
    }
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_B, consent_success(), 4653000000, entropy(99), mut output, mut scratch)?
    if !selected(agent, 30651000000) || selected(agent, 34653000000) {
        fail("consent renewal did not use the authenticated response time")
    }
    let second_probe = stun_ice.full_poll(mut agent, 8651000000, entropy(106), mut output, mut scratch)?
    expect_send(second_probe, output, 46100, consent_second())
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_B, consent_revoked(), 8652000000, entropy(99), mut output, mut scratch)?
    if selected(agent, 8652000000) {
        fail("authenticated 403 did not revoke consent")
    }
    controlled_nomination(mut output, mut scratch)
}

fn controlled_nomination(mut output: Bytes, mut scratch: Bytes) -> Result[(), stun_ice.IceError] {
    let mut agent = new_full()?
    let nomination = lite_nominate()
    let attempt = bound bytes 0 {
        stun_ice.full_receive(mut agent, BASE, PEER_B, nomination, 0, entropy(99), mut output, mut scratch)
    }
    let reply = match attempt {
        Ok(verdict) => verdict?,
        Error(_) => fail("pre-answer Binding reply allocated"),
    }
    expect_reply(reply, output, early_reply())
    configure_peer(mut agent)?
    if selected(agent, 0) {
        fail("controlled agent nominated before the reciprocal check")
    }
    let triggered = stun_ice.full_poll(mut agent, 0, entropy(201), mut output, mut scratch)?
    expect_send(triggered, output, 46100, triggered_check())
    let _ = stun_ice.full_receive(mut agent, BASE, PEER_B, triggered_success(), 1, entropy(99), mut output, mut scratch)?
    if !selected(agent, 1) {
        fail("reciprocal check did not complete the pre-answer nomination")
    }
    Ok(())
}

/// bug: complete a lite/lite checklist before signaling has reconciled every component.
/// oracle: RFC 8445 section 8.2's pair matching and completion requirements.
@test
fn lite_peer_signaling() -> Result[(), stun_ice.IceError] {
    let local = stun_ice.credentials(b"lite", b"LocalPassword1234567890")?
    let second = Addr(ip: V6(0x20010db800000000, 1), port: 40001)
    let remote = Addr(ip: V6(0x20010db800000000, 2), port: 46001)
    let mut bases: List[stun_ice.Local] = list.new()
    list.push(mut bases, stun_ice.Local(component: 1, base: BASE))
    list.push(mut bases, stun_ice.Local(component: 2, base: second))
    let mut agent = stun_ice.lite(take local, take bases)?
    let mut pairs: List[stun_ice.Path] = list.new()
    list.push(mut pairs, stun_ice.Path(component: 1, base: BASE, peer: PEER_A))
    list.push(mut pairs, stun_ice.Path(component: 2, base: second, peer: PEER_B))
    if let Error(BadCandidate) = stun_ice.lite_select_signaled(mut agent, pairs) {} else {
        fail("lite/lite accepted an address-family mismatch")
    }
    if let Some(_) = stun_ice.lite_selected(agent, 1) {
        fail("a rejected candidate exchange partially selected routes")
    }
    pairs[1] = stun_ice.Path(component: 2, base: second, peer: remote)
    stun_ice.lite_select_signaled(mut agent, pairs)?
    let Some(first_path) = stun_ice.lite_selected(agent, 1) else {
        fail("IPv4 component missing")
    }
    let Some(second_path) = stun_ice.lite_selected(agent, 2) else {
        fail("IPv6 component missing")
    }
    if first_path.peer.port != 46000 || second_path.peer.port != 46001 {
        fail("lite/lite used a path outside the reconciled exchange")
    }
    Ok(())
}

/// bug: derive the wrong key from the prepared password for a long-term STUN request.
/// oracle: RFC 5769 section 2.4 and RFC 8489 Appendix B.1, corrected by erratum 6268.
@test
fn long_term_key_vectors() -> Result[(), stun_ice.Error] {
    let password = b"TheMatrIX"
    let parent = result.unwrap(secret.seal(take password, "digest"))
    let prefix = b"\xe3\x83\x9e\xe3\x83\x88\xe3\x83\xaa\xe3\x83\x83\xe3\x82\xaf\xe3\x82\xb9:example.org:"
    let md5 = result.unwrap(secret.derive_digest(parent, Md5, prefix, Raw, b"", "mac"))
    let sha256 = result.unwrap(secret.derive_digest(parent, Sha256, prefix, Raw, b"", "mac"))
    let mut scratch: Bytes = list.with_capacity(160)
    list.fill(mut scratch, 160, 0)
    if stun_ice.verify_key(long_sha1(), Long(take md5), mut scratch)? != Sha1 {
        fail("RFC 5769 long-term request did not verify")
    }
    if stun_ice.verify_key(long_sha256(), Long(take sha256), mut scratch)? != Sha256 {
        fail("RFC 8489 erratum 6268 long-term request did not verify")
    }
    Ok(())
}

/// bug: derive a TURN relay key from the raw MAC or its unpadded encoding.
/// oracle: Python hmac and hashlib over an RFC 8656 Allocate and the
/// base64 password drQMYrWe3ae7X1QibpxONspvq5SLSuj98Wl9nLNQNGw=.
/// The MD5 and SHA-256 keys are 71dce5a2bacb759846f8854891e51cba
/// and 3fb85d010dc5b8daab7c1870271438de0f7ce680bb997e3b78c4e6dc6807040c.
@test
fn minted_credentials() -> Result[(), stun_ice.Error] {
    let mut raw: Bytes = list.with_capacity(20)
    list.fill(mut raw, 20, 0x0b)
    let master = result.unwrap(secret.seal(take raw, "kdf"))
    let password = result.unwrap(secret.derive_hmac_sha256(master, b"", b"1700000000:alice", "digest"))
    let prefix = b"1700000000:alice:example.org:"
    let md5 = result.unwrap(secret.derive_digest(password, Md5, prefix, Base64, b"", "mac"))
    let sha256 = result.unwrap(secret.derive_digest(password, Sha256, prefix, Base64, b"", "mac"))
    let mut scratch: Bytes = list.with_capacity(128)
    list.fill(mut scratch, 128, 0)
    let allocate_sha1 = b"\x00\x03\x00\x54\x21\x12\xa4\x42\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x00\x19\x00\x04\x11\x00\x00\x00\x00\x06\x00\x101700000000:alice\x00\x14\x00\x0bexample.org\x00\x00\x15\x00\x0brelay-nonce\x00\x00\x08\x00\x14\x43\xef\xe6\x40\xe2\x5d\xa9\xa3\x98\xca\x32\x85\x81\xbb\xfe\x5c\x9f\xf5\xb5\x24"
    let allocate_sha256 = b"\x00\x03\x00\x68\x21\x12\xa4\x42\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x00\x19\x00\x04\x11\x00\x00\x00\x00\x06\x00\x101700000000:alice\x00\x14\x00\x0bexample.org\x00\x00\x15\x00\x0brelay-nonce\x00\x00\x1d\x00\x04\x00\x02\x00\x00\x00\x1c\x00\x20\x75\xb6\xfb\x19\x60\xaf\x43\x3e\xe9\x08\xd2\xdf\x97\x02\x4d\xc6\x95\xc1\x8e\xcf\xe1\x64\x90\x08\x26\x79\x87\x4f\x49\x8e\x62\xd6"
    if stun_ice.verify_key(allocate_sha1, Long(take md5), mut scratch)? != Sha1 {
        fail("minted MD5 credentials did not verify Allocate")
    }
    if stun_ice.verify_key(allocate_sha256, Long(take sha256), mut scratch)? != Sha256 {
        fail("minted SHA-256 credentials did not verify Allocate")
    }
    Ok(())
}

fn kd4_key(uses: String) -> Secret {
    let mut raw: Bytes = list.with_capacity(131)
    list.fill(mut raw, 131, 0xaa)
    result.unwrap(secret.seal(take raw, uses))
}

/// bug: authorize a long-key hash as a MAC key or let a digest child derive another key.
/// oracle: TLS-5 KD4, RFC 4231 case 6, and RFC 5869 Appendix A.1's OKM (first 32 bytes ending ecc4c5bf).
@test
fn kd4_digest_policy() -> Result[(), ()] {
    let kdf = kd4_key("verify kdf")
    let digest = kd4_key("digest")
    if let Error(Invalid) = secret.derive_digest(kdf, Sha256, b"prefix", Raw, b"", "mac") {} else {
        fail("secret.derive_digest accepted a kdf-only parent")
    }
    if let Error(Invalid) = secret.derive_digest(kdf, Sha256, b"", Raw, b"", "mac") {} else {
        fail("secret.derive_digest allowed hashing the kdf key directly")
    }
    if let Error(Invalid) = secret.derive_digest(digest, Sha256, b"", Raw, b"", "mac") {} else {
        fail("secret.derive_digest allowed hashing the digest key directly")
    }
    let tag = b"\x60\xe4\x31\x59\x1e\xe0\xb6\x7f\x0d\x8a\x26\xaa\xcb\xf5\xb7\x7f\x8e\x0b\xc6\x21\x37\x28\xc5\x14\x05\x46\x04\x0f\x0e\xe3\x7f\x54"
    if !result.unwrap(secret.verify_hmac_sha256(kdf, b"Test Using Larger Than Block-Size Key - Hash Key First", tag)) {
        fail("verify kdf did not verify RFC 4231 case 6")
    }
    let mut ikm: Bytes = list.with_capacity(22)
    list.fill(mut ikm, 22, 0x0b)
    let parent = result.unwrap(secret.seal(take ikm, "digest"))
    let salt = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c"
    let mut ipad: Bytes = list.with_capacity(64)
    list.fill(mut ipad, 64, 0x36)
    for i in 0u64 .. list.len(salt) {
        ipad[i] = salt[i] ^ 0x36
    }
    if let Error(Invalid) = secret.derive_digest(parent, Sha256, ipad, Raw, b"", "digest") {} else {
        fail("digest derivation granted digest to its child")
    }
    match secret.derive_digest(parent, Sha256, ipad, Raw, b"", "kdf") {
        Error(Invalid) => {}
        Ok(child) => {
            let mut opad: Bytes = list.with_capacity(64)
            list.fill(mut opad, 64, 0x5c)
            for i in 0u64 .. list.len(salt) {
                opad[i] = salt[i] ^ 0x5c
            }
            let data = b"\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\x01"
            let okm_key = result.unwrap(secret.derive_hmac_sha256(child, opad, data, "mac"))
            // HMAC-SHA256 over "x" keyed by the first 32 bytes of RFC 5869 A.1's OKM.
            let okm_tag = b"\x21\xc3\xca\xa7\xe9\x6e\x59\xbc\xc0\x74\x06\x4f\xdd\x5d\x71\x35\x72\x35\xaf\xfa\xe8\xb7\x4d\x81\xf5\x66\x4a\x76\xfb\x2e\x8b\x54"
            if result.unwrap(secret.verify_hmac_sha256(okm_key, b"x", okm_tag)) {
                fail("a digest child holding kdf reproduced RFC 5869 A.1's HKDF child")
            }
            fail("digest derivation granted kdf to its child")
        }
        Error(_) => fail("digest derivation with a kdf child failed other than Invalid"),
    }
    Ok(())
}

type StunRoundDraw {
    method: u16,
    class: stun_ice.Class,
    tx: stun_ice.Transaction,
    addr: Addr,
    nonce: Bytes
}

fn show_stun_round(d: StunRoundDraw, mut out: String) {
    string.push(mut out, "StunRoundDraw(method: ")
    string.push_u64(mut out, int.widen(d.method))
    string.push(mut out, ")")
}

fn stun_round_gen() -> std.prop.Gen[StunRoundDraw] {
    std.prop.make(fn(mut src: std.prop.Source) -> StunRoundDraw {
        let class: stun_ice.Class = match std.prop.below(mut src, 4) {
            0 => Request,
            1 => Indication,
            2 => Success,
            _ => Failure,
        }
        let len = 1 + std.prop.below(mut src, 24)
        let mut nonce: Bytes = list.with_capacity(len)
        for _ in 0u64 .. len {
            list.push(mut nonce, int.narrow(97 + std.prop.below(mut src, 26)))
        }
        StunRoundDraw(method: int.narrow(std.prop.below(mut src, 4096)), class, tx: stun_ice.Transaction(high: int.truncate(std.prop.word(mut src)), low: std.prop.word(mut src)), addr: Addr(ip: V4(int.truncate(std.prop.word(mut src))), port: int.truncate(std.prop.word(mut src))), nonce: take nonce)
    }, show_stun_round)
}

fn stun_round_law(d: StunRoundDraw) -> Result[(), String] {
    let mut out: Bytes = list.new()
    list.fill(mut out, 512, 0u8)
    let mut scratch: Bytes = list.new()
    let mut b = match stun_ice.start(d.method, d.class, d.tx, mut out) {
        Ok(b) => b,
        Error(_) => return Error(string.from("writer refused generated method")),
    }
    if let Error(_) = stun_ice.add_xor_addr(mut b, stun_ice.XOR_RELAYED_ADDRESS, d.addr, mut out) {
        return Error(string.from("writer refused XOR address"))
    }
    if let Error(_) = stun_ice.add(mut b, stun_ice.NONCE, d.nonce, mut out) {
        return Error(string.from("writer refused nonce"))
    }
    let n = match stun_ice.finish(take b, NoIntegrity, Short(b""), false, mut out, mut scratch) {
        Ok(n) => n,
        Error(_) => return Error(string.from("writer could not finish")),
    }
    list.truncate(mut out, n)
    if n != list.len(out) {
        return Error(string.from("write length mismatch"))
    }
    let h = match stun_ice.header(out) {
        Ok(h) => h,
        Error(_) => return Error(string.from("written header did not parse")),
    }
    if h.method != d.method || h.class != d.class || h.transaction != d.tx {
        return Error(string.from("fixed fields did not round trip"))
    }
    let mut attrs: List[stun_ice.Attr] = list.new()
    let integrity = match stun_ice.attrs(out, mut attrs) {
        Ok(i) => i,
        Error(_) => return Error(string.from("written attributes did not scan")),
    }
    if integrity != NoIntegrity || list.len(attrs) != 2 {
        return Error(string.from("attribute scan shape mismatch"))
    }
    let a = match stun_ice.xor_addr(out, attrs[0].value) {
        Ok(a) => a,
        Error(_) => return Error(string.from("written XOR address did not parse")),
    }
    if a != d.addr || list.compare_bytes(list.slice(out, attrs[1].value.lo, attrs[1].value.hi), d.nonce) != Equal {
        return Error(string.from("attribute values did not round trip"))
    }
    Ok(())
}

fn stun_total_law(pkt: Bytes) -> Result[(), String] {
    if let Ok(_) = stun_ice.header(pkt) {
        let mut attrs: List[stun_ice.Attr] = list.new()
        let _ = stun_ice.attrs(pkt, mut attrs)
    }
    Ok(())
}

/// bug: Write STUN fixed fields or attributes its own parser cannot read back.
/// oracle: RFC 8489 section 5 fixed header, XOR address, and padded attribute wire formats.
@test
fn stun_write_parse_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 96
    std.prop.check(c, stun_round_gen(), stun_round_law)
}

/// bug: Index outside arbitrary bytes while reading a STUN header or attribute framing.
/// oracle: RFC 8489 sections 5 and 15 length and padding rules.
@test
fn stun_totality_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 128
    std.prop.check(c, std.prop.bytes_of(0, 256), stun_total_law)
}

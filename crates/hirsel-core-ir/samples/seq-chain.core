; LANG-19 through sequence storage: ordinary release uses constant native stack
; whatever the depth of the value, here Node = { kids: List[Node] }. f0(n)
; builds n levels: each level allocates a one-element buffer (capacity 1,
; charge 24 = round8(1 * 24), Node being one 24-byte carrier), moves the current
; root into its element and makes the root's kids that buffer. Then the root is
; dropped, so one ordinary release cleans the whole chain. Derived by hand:
; every buffer is freed once and refunded, so the run returns n with nothing
; used and n admissions.
; run: f0(0) -> 0 | used 0
; run: f0(32) -> 32 | used 0
core v1
type t0 = own "Node" { kids: seq t0 }
sig g0 = (u64) -> (u64)
inst n0 = test@0/seq_chain/run [] []
fn f0 = n0 g0 {
  slot s0 = t0
  addr a0 = s0 field 0 byte v1 : ptr   ; the root's kids: data
  addr a1 = s0 field 0 byte v2 : u64   ; length
  addr a2 = s0 field 0 byte v3 : u64   ; capacity
  addr a3 = s0 : t0
  addr a4 = v9 : t0                    ; the new buffer's one element
b0(v0: u64):
  live s0
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  v4: u64 = const 24
  v5: ptr = const 0x0
  v6: u64 = const 1
  address a0
  address a1
  address a2
  address a3
  store a0, v5
  store a1, v1
  store a2, v1
  jump b1(v1)
b1(v7: u64):
  v8: bool = lt v7, v0
  branch v8, b2, b4
b2:
  v9: ptr, v10: u64 = alloc for seq t0 v4 align 8 charge v4
  v11: bool = ne v9, v5
  branch v11, b3, b4
b3:
  address a4
  copy a4, a3, v4                      ; the root moves into the element
  store a0, v9
  store a1, v6
  store a2, v6
  v12: u64 = wrapping_add v7, v6
  jump b1(v12)
b4:
  drop a3 t0
  dead s0
  return v7
}

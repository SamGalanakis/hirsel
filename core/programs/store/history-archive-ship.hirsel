// Native unit shippers for `log@1` (Directory) and `objects@1` (Bucket),
// Gap publication, stale-archiver fencing, and TLA+ trace emission (§15.7).
pub type ArchiveTraceEvent: send = TraceStage(u64, String, u64) | TracePublish(u64) | TraceGap(u64)

pub type ArchiveStepResult: send {
    advanced: bool,
    gap_committed: bool,
    head: Option[format.ArchiveHeadRep],
    acked_gen: u64,
    acked_digest: u64,
    acked_seg: u64,
    acked_entry: u64,
    trace: List[ArchiveTraceEvent]
}

fn empty_step_result(take head: Option[format.ArchiveHeadRep]) -> ArchiveStepResult {
    ArchiveStepResult(advanced: false, gap_committed: false, head: take head, acked_gen: 0, acked_digest: 0, acked_seg: 0, acked_entry: 0, trace: list.new())
}

fn push_trace(mut out: List[ArchiveTraceEvent], take ev: ArchiveTraceEvent) {
    if let Ok(()) = list.try_reserve(mut out, 1) {
        list.push(mut out, take ev)
    }
}

// Appends a new interval to `head.intervals`, spilling the oldest closed
// interval(s) into `spilled` when `list.len(intervals) >= ARCHIVE_HEAD_INTERVAL_MAX`.
fn append_head_interval(existing: List[format.ArchiveIntervalRep], take fresh: format.ArchiveIntervalRep) -> Result[(List[format.ArchiveIntervalRep], List[format.ArchiveIntervalRep]), types.Failure] {
    let mut kept: List[format.ArchiveIntervalRep] = list.new()
    let mut spilled: List[format.ArchiveIntervalRep] = list.new()
    let n = list.len(existing)
    let drop_n = if n >= format.ARCHIVE_HEAD_INTERVAL_MAX {
        n + 1 - format.ARCHIVE_HEAD_INTERVAL_MAX
    } else {
        0u64
    }
    types.capacity(list.try_reserve(mut spilled, drop_n))?
    types.capacity(list.try_reserve(mut kept, n + 1 - drop_n))?
    for i in 0u64 .. n {
        if i < drop_n {
            list.push(mut spilled, clone(existing[i]))
        } else {
            list.push(mut kept, clone(existing[i]))
        }
    }
    list.push(mut kept, take fresh)
    Ok((take kept, take spilled))
}

fn extend_head_interval(existing: List[format.ArchiveIntervalRep], next_cursor: format.ArchiveCursorRep) -> Result[List[format.ArchiveIntervalRep], types.Failure] {
    let mut out = manifest.disk_allocation(scoped fn() -> Result[List[format.ArchiveIntervalRep], types.Failure] {
        Ok(clone(existing))
    })?
    let n = list.len(out)
    if n == 0 {
        return Error(format.disk_fault("archive-head", 0, Malformed))
    }
    out[n - 1].through = next_cursor
    Ok(take out)
}

fn close_head_interval_gap(existing: List[format.ArchiveIntervalRep]) -> Result[List[format.ArchiveIntervalRep], types.Failure] {
    let mut out = manifest.disk_allocation(scoped fn() -> Result[List[format.ArchiveIntervalRep], types.Failure] {
        Ok(clone(existing))
    })?
    let n = list.len(out)
    if n > 0 {
        out[n - 1].closed_by_gap = true
    }
    Ok(take out)
}

// Checks binding & holder epoch authority against existing sink `archive-head`.
// Returns `Ok(true)` if an explicit higher-binding rebind must first close the
// preceding binding's interval with a Gap; `Error(Fenced(..))` for stale writers.
fn check_archive_authority(existing: format.ArchiveHeadRep, binding_id: u64, holder_epoch: u64, allow_rebind: bool) -> Result[bool, types.Failure] {
    if existing.binding_id == binding_id {
        if holder_epoch < existing.holder_epoch {
            return Error(Fenced(holder_epoch))
        }
        return Ok(false)
    }
    if allow_rebind && binding_id > existing.binding_id {
        return Ok(true)
    }
    Error(Fenced(holder_epoch))
}

// =============================================================================
// log@1 (Directory) shipper
// =============================================================================
fn read_dir_manifest_candidate(d: Dir, store: types.StoreKey, gen_opt: Option[u64]) -> Result[(Bytes, manifest.PageManifest, String), types.Failure] waits {
    let path = match gen_opt {
        Some(g) => manifest.archive_manifest_path(g, "")?,
        None => string.from("MANIFEST"),
    }
    let raw = manifest.disk_read_file(d, path, manifest.PAGE_MANIFEST_FILE_LIMIT)?
    let (owner, take parsed) = manifest.disk_allocation(scoped fn() -> Result[(types.StoreKey, manifest.PageManifest), types.Failure] {
        manifest.disk_read_page_manifest(path, raw)
    })?
    if !types.same(owner.hi, owner.lo, store.hi, store.lo) {
        return Error(format.disk_fault(path, 0, Header))
    }
    if let Some(g) = gen_opt {
        if parsed.generation != g {
            return Error(format.disk_fault(path, 0, Header))
        }
    }
    Ok((take raw, take parsed, take path))
}

fn dir_segment_header_bound(d: Dir, store: types.StoreKey, seq: u64) -> Result[Option[u64], types.Failure] waits {
    let next_path = manifest.journal_path(seq + 1, "")?
    let mut f = match host.open(d, next_path, Read) {
        Ok(take opened) => take opened,
        Error(NotFound) => return Ok(None),
        Error(e) => return Error(Io(e)),
    }
    let head = manifest.read_disk_bytes(mut f, next_path, 0, 72)
    let _ = host.close(take f)
    let raw = match take head {
        Ok(take b) => take b,
        Error(_) => return Ok(None),
    }
    let parsed = match manifest.disk_read_header(next_path, raw, 2, Some(seq + 1), Some(store)) {
        Ok(h) => h,
        Error(_) => return Ok(None),
    }
    Ok(Some(parsed.prev_end))
}

fn dir_segment_end_bound(d: Dir, store: types.StoreKey, seq: u64) -> Result[Option[u64], types.Failure] waits {
    let end_path = manifest.journal_path(seq, ".end")?
    let raw = match manifest.disk_read_file(d, end_path, 96 + 1048576) {
        Ok(take b) => take b,
        Error(Io(NotFound)) => return Ok(None),
        Error(Io(Other(5))) => return Ok(None),
        Error(Corrupt(_)) => return Ok(None),
        Error(take problem) => return Error(take problem),
    }
    match journal.disk_read_end(end_path, store, seq, raw) {
        Ok(at) => Ok(Some(at)),
        Error(Corrupt(_)) => Ok(None),
        Error(take problem) => Error(take problem),
    }
}

fn dir_segment_exists(d: Dir, seq: u64) -> Result[bool, types.Failure] waits {
    let path = manifest.journal_path(seq, "")?
    journal.disk_exists(d, path)
}

fn dir_verify_sink_base_intact(mut sink: std.object.Client, store: types.StoreKey, cur: format.ArchiveCursorRep, deadline: u64) -> Result[(), types.Failure] waits {
    let m_key = format.archive_key(store, format.archive_log_manifest_rel(cur.gen, cur.digest))
    let mut m_raw = manifest.disk_read_buffer(cur.len)?
    match history_fetch(mut sink, m_key, mut m_raw, deadline) {
        Ok(_) => {
            if list.len(m_raw) != cur.len || std.check.xxh3(m_raw, 0, list.len(m_raw)) != cur.digest {
                return Error(format.disk_fault(m_key, 0, Checksum))
            }
            Ok(())
        },
        Error(Remote(NotFound)) => Error(Lost),
        Error(take problem) => Error(take problem),
    }
}

// Uploads a log@1 base (`p-<seq>-<xxh3>`, `m-<gen>-<xxh3>`), checks A2
// no-relisting against any prior advertised base, spills `index-` segment(s),
// and CASes `archive-head`.
fn archive_publish_dir_base(d: Dir, store: types.StoreKey, binding_id: u64, mut sink: std.object.Client, take existing: Option[(format.ArchiveHeadRep, std.object.ETag)], m_raw: Bytes, m_rec: manifest.PageManifest, m_path: String, continuous: bool, deadline: u64, take trace_in: List[ArchiveTraceEvent]) -> Result[ArchiveStepResult, types.Failure] waits {
    let mut trace = take trace_in
    let pack_seqs = manifest.validate_receipt_packs(d, store, m_path, m_rec)?
    let mut pack_refs: List[format.ArchivePackRefRep] = list.new()
    types.capacity(list.try_reserve(mut pack_refs, list.len(pack_seqs)))?
    let mut max_pack = 0u64
    let trace_cursor = if m_rec.generation > 0 {
        2 * m_rec.generation - 1
    } else {
        1u64
    }
    for seq in pack_seqs {
        let p_path = manifest.paged_pack_path(seq)?
        let mut f = manifest.disk_io(host.open(d, p_path, Read))?
        let size = manifest.disk_io(host.stat_file(mut f))?.size
        let p_raw = manifest.read_disk_bytes(mut f, p_path, 0, size)?
        manifest.disk_io(host.close(take f))?
        let _ = manifest.disk_read_header(p_path, list.slice(p_raw, 0, 72), 3, Some(seq), Some(store))?
        let p_digest = std.check.xxh3(p_raw, 0, size)
        let p_key = format.archive_key(store, format.archive_log_pack_rel(seq, p_digest))
        match archive_put_immutable(mut sink, p_key, take p_raw, deadline)? {
            UnitStored => (),
            UnitDiverged(_) => return Error(Diverged(0)),
        }
        push_trace(mut trace, TraceStage(trace_cursor, string.from("pack"), seq))
        list.push(mut pack_refs, format.ArchivePackRefRep(seq, epoch: 0, len: size, digest: p_digest))
        if seq > max_pack {
            max_pack = seq
        }
    }
    let m_len = list.len(m_raw)
    let m_digest = std.check.xxh3(m_raw, 0, m_len)
    let m_key = format.archive_key(store, format.archive_log_manifest_rel(m_rec.generation, m_digest))
    match archive_put_immutable(mut sink, m_key, clone(m_raw), deadline)? {
        UnitStored => (),
        UnitDiverged(_) => return Error(Diverged(0)),
    }
    push_trace(mut trace, TraceStage(trace_cursor, string.from("unit"), trace_cursor))
    let next_pack_bound = order.max(m_rec.next_pack, max_pack + 1)
    let frontier = format.ArchiveFrontierRep(next_pack: next_pack_bound, next_gen: m_rec.generation + 1, next_unit: m_rec.first_live, next_offset: 0, first_index_ordinal: 1)
    let main_ver = m_rec.branches[0u64].version
    let main_at = m_rec.branches[0u64].at
    let mut base_row = format.ArchiveBaseRowRep(base_ordinal: m_rec.generation, epoch: 0, digest: m_digest, len: m_len, first_unit: m_rec.first_live, main_version: main_ver, main_at, frontier, pack_continuation: false, packs: take pack_refs)
    // A2: check against preceding advertised base (including across a Gap!).
    if let Some((prev_head, _)) = view existing {
        if let Some(prev_tail) = prev_head.index_tail {
            let (take prev_base, take prev_packs) = archive_load_latest_base(mut sink, store, prev_tail, deadline)?
            archive_check_no_relisting(prev_base, prev_packs, base_row)?
        }
    }
    let cursor = format.ArchiveCursorRep(source_kind: format.ARCHIVE_SOURCE_LOG, ordinal: m_rec.first_live, sub: 0, gen: m_rec.generation, digest: m_digest, len: m_len, main_version: main_ver, main_at)
    let (pre, prev_tail, rev, take floor_opt, take next_ivs, take spilled_ivs): (std.object.Precondition, Option[format.ArchiveIndexRefRep], u64, Option[format.ArchiveBaseRowRep], List[format.ArchiveIntervalRep], List[format.ArchiveIntervalRep]) = match take existing {
        None => {
            let mut ivs: List[format.ArchiveIntervalRep] = list.new()
            types.capacity(list.try_reserve(mut ivs, 1))?
            list.push(mut ivs, format.ArchiveIntervalRep(first_base: format.archive_base_summary(base_row), through: cursor, closed_by_gap: false))
            (Absent, None, 1u64, None, take ivs, list.new())
        },
        Some((take prev_head, tag)) => {
            let (take ivs, take spilled): (List[format.ArchiveIntervalRep], List[format.ArchiveIntervalRep]) = if continuous && list.len(prev_head.intervals) > 0 {
                (extend_head_interval(prev_head.intervals, cursor)?, list.new())
            } else {
                append_head_interval(prev_head.intervals, format.ArchiveIntervalRep(first_base: format.archive_base_summary(base_row), through: cursor, closed_by_gap: false))?
            }
            (Match(tag), prev_head.index_tail, prev_head.rev + 1, clone(prev_head.floor_base), take ivs, take spilled)
        },
    }
    let (new_tail, first_ord) = archive_spill_base_index(mut sink, store, format.ARCHIVE_SOURCE_LOG, prev_tail, base_row, spilled_ivs, deadline)?
    base_row.frontier.first_index_ordinal = first_ord
    let floor_base = match take floor_opt {
        Some(take fb) => Some(take fb),
        None => Some(format.archive_base_summary(base_row)),
    }
    let mut final_ivs = take next_ivs
    if !continuous && list.len(final_ivs) > 0 {
        final_ivs[list.len(final_ivs) - 1].first_base = format.archive_base_summary(base_row)
    }
    // Re-check current Directory binding hasn't changed/detached while we uploaded.
    let (_, cur_check, _) = read_dir_manifest_candidate(d, store, None)?
    if cur_check.binding_id != binding_id {
        return Error(Fenced(0))
    }
    let candidate = format.ArchiveHeadRep(store, source_kind: format.ARCHIVE_SOURCE_LOG, binding_id, holder_epoch: 0, rev, open_gap: false, through: Some(cursor), floor_base: take floor_base, index_tail: Some(new_tail), intervals: take final_ivs)
    let acked_prev_seg = if m_rec.first_live > 0 {
        m_rec.first_live - 1
    } else {
        0u64
    }
    match archive_head_cas(mut sink, store, pre, candidate, deadline)? {
        ArchiveCasApplied(_) => {
            push_trace(mut trace, TracePublish(trace_cursor))
            Ok(ArchiveStepResult(advanced: true, gap_committed: false, head: Some(take candidate), acked_gen: m_rec.generation, acked_digest: m_digest, acked_seg: acked_prev_seg, acked_entry: 0, trace: take trace))
        },
        ArchiveCasConflict(take other, _) => {
            if other.binding_id != binding_id {
                return Error(Fenced(0))
            }
            Ok(empty_step_result(Some(take other)))
        },
        ArchiveCasUncertain => Error(Undecided),
    }
}

fn archive_commit_gap(mut sink: std.object.Client, store: types.StoreKey, source_kind: u8, binding_id: u64, holder_epoch: u64, prev_head: format.ArchiveHeadRep, tag: std.object.ETag, deadline: u64, take trace_in: List[ArchiveTraceEvent]) -> Result[ArchiveStepResult, types.Failure] waits {
    let mut trace = take trace_in
    let closed_ivs = close_head_interval_gap(prev_head.intervals)?
    let after_cursor = match prev_head.through {
        Some(c) => if source_kind == format.ARCHIVE_SOURCE_LOG {
            if c.gen > 0 {
                2 * c.gen - 1
            } else {
                1u64
            }
        } else {
            c.ordinal
        },
        None => 0u64,
    }
    let candidate = format.ArchiveHeadRep(store, source_kind, binding_id, holder_epoch, rev: prev_head.rev + 1, open_gap: true, through: prev_head.through, floor_base: clone(prev_head.floor_base), index_tail: prev_head.index_tail, intervals: take closed_ivs)
    match archive_head_cas(mut sink, store, Match(tag), candidate, deadline)? {
        ArchiveCasApplied(_) => {
            push_trace(mut trace, TraceGap(after_cursor))
            Ok(ArchiveStepResult(advanced: true, gap_committed: true, head: Some(take candidate), acked_gen: 0, acked_digest: 0, acked_seg: 0, acked_entry: 0, trace: take trace))
        },
        ArchiveCasConflict(take other, _) => {
            if other.binding_id != binding_id || holder_epoch < other.holder_epoch {
                return Error(Fenced(holder_epoch))
            }
            Ok(empty_step_result(Some(take other)))
        },
        ArchiveCasUncertain => Error(Undecided),
    }
}

// Performs one bounded archive step for a Directory (`log@1`) store.
pub fn archive_step_directory(d: Dir, store: types.StoreKey, binding_id: u64, allow_rebind: bool, mut sink: std.object.Client, deadline: u64) -> Result[ArchiveStepResult, types.Failure] waits {
    let trace: List[ArchiveTraceEvent] = list.new()
    let (take cur_raw, take cur_manifest, take cur_path) = read_dir_manifest_candidate(d, store, None)?
    if cur_manifest.binding_id != binding_id {
        return Error(Fenced(0))
    }
    let existing = archive_head_fetch(mut sink, store, deadline)?
    let Some((take prev_head, tag)) = take existing else {
        // No archive-head yet: publish the current MANIFEST as the initial base.
        return archive_publish_dir_base(d, store, binding_id, mut sink, None, take cur_raw, take cur_manifest, take cur_path, false, deadline, take trace)
    }
    if prev_head.source_kind != format.ARCHIVE_SOURCE_LOG {
        return Error(format.disk_fault("archive-head", 72, Malformed))
    }
    let need_rebind_gap = check_archive_authority(prev_head, binding_id, 0, allow_rebind)?
    if need_rebind_gap && !prev_head.open_gap && prev_head.through != None {
        return archive_commit_gap(mut sink, store, format.ARCHIVE_SOURCE_LOG, binding_id, 0, prev_head, tag, deadline, take trace)
    }
    if prev_head.open_gap || prev_head.through == None {
        return archive_publish_dir_base(d, store, binding_id, mut sink, Some((take prev_head, tag)), take cur_raw, take cur_manifest, take cur_path, false, deadline, take trace)
    }
    let cur = option.unwrap(prev_head.through)
    // Check if current segment `cur.ordinal` is available on source or staged on sink.
    let seg_present = dir_segment_exists(d, cur.ordinal)?
    if !seg_present {
        // Check if already staged at sink before declaring a budget Gap.
        let staged_key = format.archive_key(store, format.archive_log_journal_rel(cur.ordinal, cur.sub))
        let mut staged_raw = manifest.disk_read_buffer(65536)?
        match history_fetch(mut sink, staged_key, mut staged_raw, deadline) {
            Ok(_) => {
                let (new_ver, new_at) = archive_verify_journal_chunk(staged_key, store, cur.ordinal, cur.sub, staged_raw, cur.main_version, cur.main_at)?
                let next_cur = format.ArchiveCursorRep(source_kind: format.ARCHIVE_SOURCE_LOG, ordinal: cur.ordinal, sub: cur.sub + list.len(staged_raw), gen: cur.gen, digest: cur.digest, len: cur.len, main_version: new_ver, main_at: new_at)
                let next_ivs = extend_head_interval(prev_head.intervals, next_cur)?
                let cand = format.ArchiveHeadRep(store, source_kind: format.ARCHIVE_SOURCE_LOG, binding_id, holder_epoch: 0, rev: prev_head.rev + 1, open_gap: false, through: Some(next_cur), floor_base: clone(prev_head.floor_base), index_tail: prev_head.index_tail, intervals: take next_ivs)
                return match archive_head_cas(mut sink, store, Match(tag), cand, deadline)? {
                    ArchiveCasApplied(_) => Ok(ArchiveStepResult(advanced: true, gap_committed: false, head: Some(take cand), acked_gen: cur.gen, acked_digest: cur.digest, acked_seg: if cur.ordinal > 0 {
                        cur.ordinal - 1
                    } else {
                        0u64
                    }, acked_entry: 0, trace: take trace)),
                    ArchiveCasConflict(take other, _) => if other.binding_id != binding_id {
                        Error(Fenced(0))
                    } else {
                        Ok(empty_step_result(Some(take other)))
                    },
                    ArchiveCasUncertain => Error(Undecided),
                }
            },
            Error(Remote(NotFound)) => {
                // Never mask sink corruption of a committed base as a budget Gap (L-A3).
                dir_verify_sink_base_intact(mut sink, store, cur, deadline)?
                return archive_commit_gap(mut sink, store, format.ARCHIVE_SOURCE_LOG, binding_id, 0, prev_head, tag, deadline, take trace)
            },
            Error(take problem) => return Error(take problem),
        }
    }
    // Segment exists on source. Determine sealed bound (`next_header.prev_end`)
    // or durable `END` bound.
    let sealed_bound = dir_segment_header_bound(d, store, cur.ordinal)?
    let durable_bound = match sealed_bound {
        Some(b) => Some(b),
        None => dir_segment_end_bound(d, store, cur.ordinal)?,
    }
    if let Some(bound_end) = durable_bound {
        if bound_end > cur.sub {
            let seg_path = manifest.journal_path(cur.ordinal, "")?
            let mut f = manifest.disk_io(host.open(d, seg_path, Read))?
            let chunk_raw = manifest.read_disk_bytes(mut f, seg_path, cur.sub, bound_end - cur.sub)?
            manifest.disk_io(host.close(take f))?
            let (chk_ver, chk_at) = archive_verify_journal_chunk(seg_path, store, cur.ordinal, cur.sub, chunk_raw, cur.main_version, cur.main_at)?
            let (new_sub, fin_ver, fin_at) = match archive_put_journal_chunk(mut sink, store, cur.ordinal, cur.sub, take chunk_raw, cur.main_version, cur.main_at, deadline)? {
                ChunkStored(end_pos) => (end_pos, chk_ver, chk_at),
                ChunkAdoptedPrefix(prefix_end, p_ver, p_at) => (prefix_end, p_ver, p_at),
                ChunkDiverged(_) => return Error(Diverged(0)),
            }
            let next_cur = format.ArchiveCursorRep(source_kind: format.ARCHIVE_SOURCE_LOG, ordinal: cur.ordinal, sub: new_sub, gen: cur.gen, digest: cur.digest, len: cur.len, main_version: fin_ver, main_at: fin_at)
            let next_ivs = extend_head_interval(prev_head.intervals, next_cur)?
            let cand = format.ArchiveHeadRep(store, source_kind: format.ARCHIVE_SOURCE_LOG, binding_id, holder_epoch: 0, rev: prev_head.rev + 1, open_gap: false, through: Some(next_cur), floor_base: clone(prev_head.floor_base), index_tail: prev_head.index_tail, intervals: take next_ivs)
            return match archive_head_cas(mut sink, store, Match(tag), cand, deadline)? {
                ArchiveCasApplied(_) => Ok(ArchiveStepResult(advanced: true, gap_committed: false, head: Some(take cand), acked_gen: cur.gen, acked_digest: cur.digest, acked_seg: if cur.ordinal > 0 {
                    cur.ordinal - 1
                } else {
                    0u64
                }, acked_entry: 0, trace: take trace)),
                ArchiveCasConflict(take other, _) => if other.binding_id != binding_id {
                    Error(Fenced(0))
                } else {
                    Ok(empty_step_result(Some(take other)))
                },
                ArchiveCasUncertain => Error(Undecided),
            }
        }
    }
    // Current segment is caught up through its durable/sealed bound.
    // If sealed (successor segment exists), advance to the next cut base or next segment.
    if let Some(_) = sealed_bound {
        let next_seg = cur.ordinal + 1
        archive_stage_successor(d, mut sink, store, next_seg, cur.sub, deadline)?
        if cur_manifest.generation > cur.gen {
            let want_gen = cur.gen + 1
            let next_base: Option[(Bytes, manifest.PageManifest, String)] = if want_gen == cur_manifest.generation {
                Some((clone(cur_raw), clone(cur_manifest), string.from(cur_path)))
            } else {
                match read_dir_manifest_candidate(d, store, Some(want_gen)) {
                    Ok(take found) => Some(take found),
                    Error(Io(NotFound)) => None,
                    Error(take problem) => return Error(take problem),
                }
            }
            match take next_base {
                Some((take nb_raw, take nb_rec, take nb_path)) => {
                    if nb_rec.first_live == next_seg {
                        return archive_publish_dir_base(d, store, binding_id, mut sink, Some((take prev_head, tag)), take nb_raw, take nb_rec, take nb_path, true, deadline, take trace)
                    }
                },
                None => {
                    // Intermediate receipt `m-<cur.gen + 1>` was released past hold_bytes.
                    dir_verify_sink_base_intact(mut sink, store, cur, deadline)?
                    return archive_commit_gap(mut sink, store, format.ARCHIVE_SOURCE_LOG, binding_id, 0, prev_head, tag, deadline, take trace)
                },
            }
        }
        // No cut at `next_seg`: reopened segment rotation under same base.
        let next_cur = format.ArchiveCursorRep(source_kind: format.ARCHIVE_SOURCE_LOG, ordinal: next_seg, sub: 0, gen: cur.gen, digest: cur.digest, len: cur.len, main_version: cur.main_version, main_at: cur.main_at)
        let next_ivs = extend_head_interval(prev_head.intervals, next_cur)?
        let cand = format.ArchiveHeadRep(store, source_kind: format.ARCHIVE_SOURCE_LOG, binding_id, holder_epoch: 0, rev: prev_head.rev + 1, open_gap: false, through: Some(next_cur), floor_base: clone(prev_head.floor_base), index_tail: prev_head.index_tail, intervals: take next_ivs)
        return match archive_head_cas(mut sink, store, Match(tag), cand, deadline)? {
            ArchiveCasApplied(_) => Ok(ArchiveStepResult(advanced: true, gap_committed: false, head: Some(take cand), acked_gen: cur.gen, acked_digest: cur.digest, acked_seg: cur.ordinal, acked_entry: 0, trace: take trace)),
            ArchiveCasConflict(take other, _) => if other.binding_id != binding_id {
                Error(Fenced(0))
            } else {
                Ok(empty_step_result(Some(take other)))
            },
            ArchiveCasUncertain => Error(Undecided),
        }
    }
    Ok(empty_step_result(Some(take prev_head)))
}

pub type ArchiveLaneMsg: send = ArchiveStepNow(Sender[Result[ArchiveStepResult, types.Failure]]) | ArchiveTickWake | ArchiveSinkHeadProbe(ArchiveHeadProbeReq) | ArchiveStop

// =============================================================================
// objects@1 (Bucket) shipper
// =============================================================================
fn opener_fetch_object(source: Sender[ArchiveFetchReq], key: String, reference: pages.HistoryRef, deadline: u64) -> Result[Bytes, types.Failure] waits {
    let (take raw, _) = match archive_channel_fetch(source, key, reference.len, deadline) {
        Ok(take got) => take got,
        Error(Remote(NotFound)) => return Error(pager.history_missing_object(key, reference)),
        Error(take problem) => return Error(take problem),
    }
    history_object_digest(key, reference, raw)?
    Ok(take raw)
}

fn opener_fetch_locator_deps(source: Sender[ArchiveFetchReq], mut sink: std.object.Client, store: types.StoreKey, mark_ref: pages.HistoryRef, file: String, depth: u8, raw: Bytes, mut packs_out: List[format.ArchivePackRefRep], deadline: u64) -> Result[(), types.Failure] waits {
    let row_count = list.len(raw) / 32
    for i in 0u64 .. row_count {
        let item = pages.HistoryRef(seq: format.read_le(raw, i * 32, 8), epoch: format.read_le(raw, i * 32 + 8, 8), len: format.read_le(raw, i * 32 + 16, 8), digest: format.read_le(raw, i * 32 + 24, 8))
        if depth == 0 {
            let rel = history_read_key("p-", item)?
            let p_raw = opener_fetch_object(source, rel, item, deadline)?
            let _ = history_object_context(rel, store, 3, item, p_raw)?
            let dst = format.archive_key(store, rel)
            match archive_put_immutable(mut sink, dst, take p_raw, deadline)? {
                UnitStored => (),
                UnitDiverged(_) => return Error(Diverged(0)),
            }
            types.capacity(list.try_reserve(mut packs_out, 1))?
            list.push(mut packs_out, format.ArchivePackRefRep(seq: item.seq, epoch: item.epoch, len: item.len, digest: item.digest))
        } else {
            let rel = history_read_key("l-", item)?
            let l_raw = opener_fetch_object(source, rel, item, deadline)?
            let ctx = history_object_context(rel, store, 8, item, l_raw)?
            let field = manifest.history_frame(rel, ctx, l_raw, 72, 0x00C0)?
            let child_rows = types.copied(list.slice(l_raw, field.payload, field.end))?
            opener_fetch_locator_deps(source, mut sink, store, mark_ref, rel, depth - 1, child_rows, mut packs_out, deadline)?
            let dst = format.archive_key(store, rel)
            match archive_put_immutable(mut sink, dst, take l_raw, deadline)? {
                UnitStored => (),
                UnitDiverged(_) => return Error(Diverged(0)),
            }
        }
    }
    Ok(())
}

// Uploads a MARK checkpoint entry `mark_ref` and all its transitive dependencies
// (`m-`, `l-`, `p-`, retained MARKs and their closures, then `e-`).
fn opener_ship_mark_closure(source: Sender[ArchiveFetchReq], mut sink: std.object.Client, store: types.StoreKey, mark_ref: pages.HistoryRef, deadline: u64) -> Result[(manifest.PageManifest, List[format.ArchivePackRefRep]), types.Failure] waits {
    let e_rel = history_read_key("e-", mark_ref)?
    let e_raw = opener_fetch_object(source, e_rel, mark_ref, deadline)?
    let mark = manifest.disk_allocation(scoped fn() -> Result[HistoryMark, types.Failure] {
        history_read_mark(e_rel, store, mark_ref, e_raw)
    })?
    // Retained MARKs first so every referenced MARK closure exists before naming.
    for ret_ref in mark.retained {
        let r_rel = history_read_key("e-", ret_ref)?
        let r_raw = opener_fetch_object(source, r_rel, ret_ref, deadline)?
        let r_mark = manifest.disk_allocation(scoped fn() -> Result[HistoryMark, types.Failure] {
            history_read_mark(r_rel, store, ret_ref, r_raw)
        })?
        let rm_rel = history_read_key("m-", r_mark.manifest)?
        let rm_raw = opener_fetch_object(source, rm_rel, r_mark.manifest, deadline)?
        let _ = history_decode_manifest(rm_rel, store, r_mark, ret_ref.seq, clone(rm_raw))?
        let mut ignored_packs: List[format.ArchivePackRefRep] = list.new()
        let r_loc = types.copied(list.slice(r_raw, r_mark.locate_at, r_mark.locate_end))?
        opener_fetch_locator_deps(source, mut sink, store, ret_ref, r_rel, r_mark.depth, r_loc, mut ignored_packs, deadline)?
        match archive_put_immutable(mut sink, format.archive_key(store, rm_rel), take rm_raw, deadline)? {
            UnitStored => (),
            UnitDiverged(_) => return Error(Diverged(0)),
        }
        match archive_put_immutable(mut sink, format.archive_key(store, r_rel), take r_raw, deadline)? {
            UnitStored => (),
            UnitDiverged(_) => return Error(Diverged(0)),
        }
    }
    let m_rel = history_read_key("m-", mark.manifest)?
    let m_raw = opener_fetch_object(source, m_rel, mark.manifest, deadline)?
    let page_record = history_decode_manifest(m_rel, store, mark, mark_ref.seq, clone(m_raw))?
    let mut packs: List[format.ArchivePackRefRep] = list.new()
    let e_loc = types.copied(list.slice(e_raw, mark.locate_at, mark.locate_end))?
    opener_fetch_locator_deps(source, mut sink, store, mark_ref, e_rel, mark.depth, e_loc, mut packs, deadline)?
    match archive_put_immutable(mut sink, format.archive_key(store, m_rel), take m_raw, deadline)? {
        UnitStored => (),
        UnitDiverged(_) => return Error(Diverged(0)),
    }
    match archive_put_immutable(mut sink, format.archive_key(store, e_rel), take e_raw, deadline)? {
        UnitStored => (),
        UnitDiverged(_) => return Error(Diverged(0)),
    }
    Ok((take page_record, take packs))
}

// Walks source `e-` chain backwards from `head.entry` to find `target_seq` and
// verify the predecessor at `expect_prev` (if any).
fn opener_find_next_entry(source: Sender[ArchiveFetchReq], head: HistoryHead, target_seq: u64, expect_prev: Option[pages.HistoryRef], deadline: u64) -> Result[pages.HistoryRef, types.Failure] waits {
    let mut current = head.entry
    let mut found: Option[pages.HistoryRef] = None
    while current.seq >= target_seq {
        if current.seq == target_seq {
            found = Some(current)
        }
        let rel = history_read_key("e-", current)?
        let raw = opener_fetch_object(source, rel, current, deadline)?
        let (_, pred) = history_entry_context(rel, head.store, current, raw)?
        if current.seq == target_seq {
            if let Some(exp) = expect_prev {
                let actual_prev = history_length(pred, current.seq - 1)
                if !history_ref_matches(actual_prev, exp) {
                    return Error(Diverged(0))
                }
            }
            break
        }
        current = history_length(pred, current.seq - 1)
    }
    match found {
        Some(r) => Ok(r),
        None => Error(format.disk_fault("head", 72, Malformed)),
    }
}

fn entry_main_version_and_at(file: String, store: types.StoreKey, reference: pages.HistoryRef, raw: Bytes, init_ver: u64, init_at: u64) -> Result[(bool, u64, u64), types.Failure] {
    let (ctx, _) = history_entry_context(file, store, reference, raw)?
    let mut at = 112u64
    let mut main_ver = init_ver
    let mut main_at = init_at
    while at < list.len(raw) {
        let frame = manifest.disk_frame_bytes(file, ctx, raw, at)?
        if frame.kind == 0x0090 {
            return Ok((true, main_ver, main_at))
        }
        if frame.kind == 0x0011 {
            let body = list.slice(raw, frame.payload, frame.end)
            if list.len(body) >= 20 {
                let branch = format.read_le(body, 0, 4)
                if branch == 0 {
                    main_ver = format.read_le(body, 4, 8)
                    main_at = format.read_le(body, 12, 8)
                }
            }
        }
        at = frame.end
    }
    Ok((false, main_ver, main_at))
}

fn verify_sink_object_entry_intact(mut sink: std.object.Client, store: types.StoreKey, cur: format.ArchiveCursorRep, deadline: u64) -> Result[(), types.Failure] waits {
    let r = pages.HistoryRef(seq: cur.ordinal, epoch: cur.sub, len: cur.len, digest: cur.digest)
    let e_key = format.archive_key(store, history_read_key("e-", r)?)
    let mut raw = manifest.disk_read_buffer(cur.len)?
    match history_fetch(mut sink, e_key, mut raw, deadline) {
        Ok(_) => history_object_digest(e_key, r, raw),
        Error(Remote(NotFound)) => Error(Lost),
        Error(take problem) => Error(take problem),
    }
}

fn objects_check_holder_still_valid(source: Sender[ArchiveFetchReq], store: types.StoreKey, holder_epoch: u64, deadline: u64) -> Result[HistoryHead, types.Failure] waits {
    let (take head_raw, _) = archive_channel_fetch(source, string.from("head"), 65536u64, deadline)?
    let (take capture, _) = history_decode_head_attach(head_raw)?
    manifest.check_expected_store(Some(store), capture.head.store)?
    if capture.head.pair.epoch != holder_epoch {
        return Error(Fenced(holder_epoch))
    }
    Ok(capture.head)
}

fn archive_publish_objects_base(source: Sender[ArchiveFetchReq], mut sink: std.object.Client, store: types.StoreKey, binding_id: u64, holder_epoch: u64, take existing: Option[(format.ArchiveHeadRep, std.object.ETag)], mark_ref: pages.HistoryRef, continuous: bool, deadline: u64, take trace_in: List[ArchiveTraceEvent]) -> Result[ArchiveStepResult, types.Failure] waits {
    let trace = take trace_in
    let (take m_rec, take pack_refs) = opener_ship_mark_closure(source, mut sink, store, mark_ref, deadline)?
    let mut max_pack = 0u64
    for p in pack_refs {
        if p.seq > max_pack {
            max_pack = p.seq
        }
    }
    let next_pack_bound = order.max(m_rec.next_pack, max_pack + 1)
    let frontier = format.ArchiveFrontierRep(next_pack: next_pack_bound, next_gen: m_rec.generation + 1, next_unit: mark_ref.seq + 1, next_offset: mark_ref.epoch, first_index_ordinal: 1)
    let main_ver = m_rec.branches[0u64].version
    let main_at = m_rec.branches[0u64].at
    let mut base_row = format.ArchiveBaseRowRep(base_ordinal: mark_ref.seq, epoch: mark_ref.epoch, digest: mark_ref.digest, len: mark_ref.len, first_unit: mark_ref.seq, main_version: main_ver, main_at, frontier, pack_continuation: false, packs: take pack_refs)
    if let Some((prev_head, _)) = view existing {
        if let Some(prev_tail) = prev_head.index_tail {
            let (take prev_base, take prev_packs) = archive_load_latest_base(mut sink, store, prev_tail, deadline)?
            archive_check_no_relisting(prev_base, prev_packs, base_row)?
        }
    }
    let cursor = format.ArchiveCursorRep(source_kind: format.ARCHIVE_SOURCE_OBJECTS, ordinal: mark_ref.seq, sub: mark_ref.epoch, gen: mark_ref.seq, digest: mark_ref.digest, len: mark_ref.len, main_version: main_ver, main_at)
    let (pre, prev_tail, rev, take floor_opt, take next_ivs, take spilled_ivs): (std.object.Precondition, Option[format.ArchiveIndexRefRep], u64, Option[format.ArchiveBaseRowRep], List[format.ArchiveIntervalRep], List[format.ArchiveIntervalRep]) = match take existing {
        None => {
            let mut ivs: List[format.ArchiveIntervalRep] = list.new()
            types.capacity(list.try_reserve(mut ivs, 1))?
            list.push(mut ivs, format.ArchiveIntervalRep(first_base: format.archive_base_summary(base_row), through: cursor, closed_by_gap: false))
            (Absent, None, 1u64, None, take ivs, list.new())
        },
        Some((take prev_head, tag)) => {
            let (take ivs, take spilled): (List[format.ArchiveIntervalRep], List[format.ArchiveIntervalRep]) = if continuous && list.len(prev_head.intervals) > 0 {
                (extend_head_interval(prev_head.intervals, cursor)?, list.new())
            } else {
                append_head_interval(prev_head.intervals, format.ArchiveIntervalRep(first_base: format.archive_base_summary(base_row), through: cursor, closed_by_gap: false))?
            }
            (Match(tag), prev_head.index_tail, prev_head.rev + 1, clone(prev_head.floor_base), take ivs, take spilled)
        },
    }
    let (new_tail, first_ord) = archive_spill_base_index(mut sink, store, format.ARCHIVE_SOURCE_OBJECTS, prev_tail, base_row, spilled_ivs, deadline)?
    base_row.frontier.first_index_ordinal = first_ord
    let floor_base = match take floor_opt {
        Some(take fb) => Some(take fb),
        None => Some(format.archive_base_summary(base_row)),
    }
    let mut final_ivs = take next_ivs
    if !continuous && list.len(final_ivs) > 0 {
        final_ivs[list.len(final_ivs) - 1].first_base = format.archive_base_summary(base_row)
    }
    // Re-verify holder epoch right before archive-head CAS (L-A6).
    let _ = objects_check_holder_still_valid(source, store, holder_epoch, deadline)?
    let cand = format.ArchiveHeadRep(store, source_kind: format.ARCHIVE_SOURCE_OBJECTS, binding_id, holder_epoch, rev, open_gap: false, through: Some(cursor), floor_base: take floor_base, index_tail: Some(new_tail), intervals: take final_ivs)
    match archive_head_cas(mut sink, store, pre, cand, deadline)? {
        ArchiveCasApplied(_) => Ok(ArchiveStepResult(advanced: true, gap_committed: false, head: Some(take cand), acked_gen: m_rec.generation, acked_digest: mark_ref.digest, acked_seg: 0, acked_entry: mark_ref.seq, trace: take trace)),
        ArchiveCasConflict(take other, _) => {
            if other.binding_id != binding_id || holder_epoch < other.holder_epoch {
                return Error(Fenced(holder_epoch))
            }
            Ok(empty_step_result(Some(take other)))
        },
        ArchiveCasUncertain => Error(Undecided),
    }
}

// Performs one bounded archive step for an `objects@1` (Bucket) store.
pub fn archive_step_objects(source: Sender[ArchiveFetchReq], store: types.StoreKey, binding_id: u64, holder_epoch: u64, allow_rebind: bool, mut sink: std.object.Client, deadline: u64) -> Result[ArchiveStepResult, types.Failure] waits {
    let trace: List[ArchiveTraceEvent] = list.new()
    let src_head = objects_check_holder_still_valid(source, store, holder_epoch, deadline)?
    let existing = archive_head_fetch(mut sink, store, deadline)?
    let Some((take prev_head, tag)) = take existing else {
        return archive_publish_objects_base(source, mut sink, store, binding_id, holder_epoch, None, src_head.checkpoint, false, deadline, take trace)
    }
    if prev_head.source_kind != format.ARCHIVE_SOURCE_OBJECTS {
        return Error(format.disk_fault("archive-head", 72, Malformed))
    }
    let need_rebind_gap = check_archive_authority(prev_head, binding_id, holder_epoch, allow_rebind)?
    if need_rebind_gap && !prev_head.open_gap && prev_head.through != None {
        return archive_commit_gap(mut sink, store, format.ARCHIVE_SOURCE_OBJECTS, binding_id, holder_epoch, prev_head, tag, deadline, take trace)
    }
    if prev_head.open_gap || prev_head.through == None {
        return archive_publish_objects_base(source, mut sink, store, binding_id, holder_epoch, Some((take prev_head, tag)), src_head.checkpoint, false, deadline, take trace)
    }
    let cur = option.unwrap(prev_head.through)
    if src_head.entry.seq == cur.ordinal {
        if src_head.entry.epoch != cur.sub || src_head.entry.digest != cur.digest {
            return Error(Diverged(0))
        }
        return Ok(empty_step_result(Some(take prev_head)))
    }
    if src_head.entry.seq < cur.ordinal {
        return Error(Diverged(0))
    }
    let next_seq = cur.ordinal + 1
    if src_head.floor > next_seq {
        // Source reclaimed `next_seq` past budget. Verify committed sink unit
        // first so sink damage is never masked as a budget Gap (L-A3).
        verify_sink_object_entry_intact(mut sink, store, cur, deadline)?
        return archive_commit_gap(mut sink, store, format.ARCHIVE_SOURCE_OBJECTS, binding_id, holder_epoch, prev_head, tag, deadline, take trace)
    }
    let prev_ref = pages.HistoryRef(seq: cur.ordinal, epoch: cur.sub, len: cur.len, digest: cur.digest)
    let next_ref = match opener_find_next_entry(source, src_head, next_seq, Some(prev_ref), deadline) {
        Ok(r) => r,
        Error(HistoryMissing(_, _)) => {
            verify_sink_object_entry_intact(mut sink, store, cur, deadline)?
            return archive_commit_gap(mut sink, store, format.ARCHIVE_SOURCE_OBJECTS, binding_id, holder_epoch, prev_head, tag, deadline, take trace)
        },
        Error(take problem) => return Error(take problem),
    }
    let next_rel = history_read_key("e-", next_ref)?
    let next_raw = opener_fetch_object(source, next_rel, next_ref, deadline)?
    let (is_mark, new_ver, new_at) = entry_main_version_and_at(next_rel, store, next_ref, next_raw, cur.main_version, cur.main_at)?
    if is_mark {
        return archive_publish_objects_base(source, mut sink, store, binding_id, holder_epoch, Some((take prev_head, tag)), next_ref, true, deadline, take trace)
    }
    match archive_put_immutable(mut sink, format.archive_key(store, next_rel), take next_raw, deadline)? {
        UnitStored => (),
        UnitDiverged(_) => return Error(Diverged(0)),
    }
    let _ = objects_check_holder_still_valid(source, store, holder_epoch, deadline)?
    let next_cur = format.ArchiveCursorRep(source_kind: format.ARCHIVE_SOURCE_OBJECTS, ordinal: next_ref.seq, sub: next_ref.epoch, gen: cur.gen, digest: next_ref.digest, len: next_ref.len, main_version: new_ver, main_at: new_at)
    let next_ivs = extend_head_interval(prev_head.intervals, next_cur)?
    let cand = format.ArchiveHeadRep(store, source_kind: format.ARCHIVE_SOURCE_OBJECTS, binding_id, holder_epoch, rev: prev_head.rev + 1, open_gap: false, through: Some(next_cur), floor_base: clone(prev_head.floor_base), index_tail: prev_head.index_tail, intervals: take next_ivs)
    match archive_head_cas(mut sink, store, Match(tag), cand, deadline)? {
        ArchiveCasApplied(_) => Ok(ArchiveStepResult(advanced: true, gap_committed: false, head: Some(take cand), acked_gen: 0, acked_digest: 0, acked_seg: 0, acked_entry: next_ref.seq, trace: take trace)),
        ArchiveCasConflict(take other, _) => if other.binding_id != binding_id || holder_epoch < other.holder_epoch {
            Error(Fenced(holder_epoch))
        } else {
            Ok(empty_step_result(Some(take other)))
        },
        ArchiveCasUncertain => Error(Undecided),
    }
}

type GrantedOpen: send {
    tasks: Tasks,
    d: Dir,
    c: Clock,
    r: Random,
    options: Options
}

fn writer_law_room() -> u64 {
    let Error(refused) = (bound bytes 18446744073709551615u64 {}) else {
        fail("expected a finite writer grant")
    }
    refused.available
}

// Six empty pages cost 6 × (round8(98 + 8) + 24) = 816 B. The inline
// Page is 24 + 8 for its image, 2 × 24 for list descriptors, 2 × 8
// for counters, and 2 for flags. The genesis branch keeps four Head
// slots at 264 B each: 4 + 24 + 4 + 8 + 3 × 64 + 8 + 8 + 16.
// Db is inline and HostFile opens have no separate charge. Total: 1,872 B.
const GENESIS_WRITER_STATE: u64 = 1872

fn granted_open_commit(take input: GrantedOpen) -> Result[(), Error] waits {
    let before = writer_law_room()
    let mut db = open(input.tasks, input.d, input.c, input.r, input.options)?
    // Wait until the worker is in its loop and has released the ready sender.
    {
        let journal = disk_state(db)
        result.unwrap(channel.send(journal.journal, Barrier))
        if let WriteFailed(e) = result.unwrap(channel.receive(journal.written)) {
            return Error(Io(e))
        }
    }
    let open_charge = before - writer_law_room()
    // The worker, timer and five live channels take 67,174,752 + 4,384
    // + (27,264 - 88). The ready channel's 88 B have been refunded.
    let group: u64 = int.widen(input.options.group_bytes)
    let commits: u64 = int.widen(input.options.group_commits)
    let worker = option.unwrap(charge.task(bytes[Result[(), Error]], group + JOURNAL_WORKER_SLACK))
    let timer = option.unwrap(charge.task(bytes[()], JOURNAL_TIMER_GRANT))
    let fixed = open_charge - worker - timer - (journal_channel_bytes(commits) - journal_ready_bytes())
    if fixed != GENESIS_WRITER_STATE || fixed != directory_writer_state_bytes() {
        fail("§1.1: fixed writer state at genesis")
    }
    let codec = std.codec.of_bytes()
    let _ = create_table(mut db, spec("values", std.codec.key_u64(), codec))?
    let t = table(mut db, "values", std.codec.key_u64(), codec)?
    let saved = run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        let mut value: Bytes = list.with_capacity(64)
        list.fill(mut value, 64, 7u8)
        put(mut tx, call_env, 1, value)
    })?
    let Committed(done) = saved else {
        return Error(Foreign)
    }
    durable(mut db, done.ticket)?
    close(take db)
}

fn group_override(group: u64) -> Overrides {
    let mut o = derived_sizes()
    o.group_bytes = Some(group)
    o
}

// §1.1: a Directory grant covers the journal worker's own grant. A 64 MiB
// group used to size inside a 39,839,262 B share. At the resident floor:
//   journal worker: 67,108,864 + 65,536 + 288 + 64 = 67,174,752
//   journal timer: 4,096 + 288 = 4,384
//   journal channels for 64 commits: 416 × 64 + 640 = 27,264
//   writer state: 1,872
//   resident: 1,048,576
//   cut phase: 16,777,640 + 65,536 + 2 × 95,326 + (4,096 + 16,711,680)
//            = 33,749,604, above the write peak of 2 × 16,777,296
//   total: 102,006,452
@test
fn directory_grant_covers_journal_worker(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let o = group_override(67108864)
    let need = 102006452u64
    match planned(Directory, 39839262, o) {
        Error(short) if short.need == need && short.have == 39839262 => (),
        _ => fail("§1.1: a 64 MiB group sized inside a share its journal worker exceeds"),
    }
    match planned(Directory, need - 1, o) {
        Error(short) if short.need == need && short.have == need - 1 => (),
        _ => fail("§1.1: one byte below the Directory peak was admitted"),
    }
    let place = planned(Directory, need, o) ?=> |_| Missing("directory sizing")
    let options = planned_options(place)
    let total = planned_bytes(place)
    let plan = writer_plan(Directory, options) ?=> |_| Missing("writer plan")
    if total != need || writer_bytes(plan) != need || options.group_bytes != 67108864u32 || options.resident_limit != 1048576 {
        fail("§1.1: the Directory peak at its exact share")
    }
    let input = GrantedOpen(tasks, d: disk_test_directory(d), c, r, options: take options)
    let running = task.spawn(tasks, bytes total, take input, granted_open_commit)
    result.unwrap(task.join(take running))
}

// §1.1 and §12.9, one 1 MiB lane with 64 KiB pack and group limits.
//   journal and frame: (65,536 + 16,777,296) + 16,777,296
//   pack and PUT buffer: 2 × 65,536
//   cut: 65,536 + 2 × ceil(1,048,576 / 11) + (4,096 + 16,711,680)
//   resident and lane: 2 × 1,048,576
//   entries, heads, key: 2 × round8(65,536 + 112 + 33) + 2 × 65,776 + round8(60)
//   timer and worker: (4,096 + 288) + (4 × 65,536 + 524,288 + 288 + 64)
//   reclaim page: round8(1,000 × ((1,024 + 8) + 8 + (64 + 8)))
//   T_floor = 54,986,476. The place needs T_floor + 80 + 1,098 = 54,987,654.
@test
fn bucket_place_plan_at_floor() -> Result[(), Error] {
    let lanes = std.object.LaneConfig(requested_lanes: 1, lane_bytes: 1048576)
    let kind: Kind = Bucket(lanes)
    let mut o = group_override(65536)
    o.pack_bytes = Some(65536)
    let need = 54987654u64
    let place = result.unwrap(planned(kind, need, o))
    if planned_bytes(place) != need || planned_options(place).resident_limit != MIB {
        fail("§1.1: the Bucket place plan at its exact share")
    }
    let capture = option.unwrap(planned_capture(place))
    let writer = result.unwrap(writer_plan(kind, planned_options(place)))
    if plan_bytes(capture) != writer_bytes(writer) - lanes.lane_bytes {
        fail("§1.1: the capture envelope must use the sized writer grant")
    }
    let Error(refused) = planned(kind, need - 1, o) else {
        fail("§1.1: one byte below the Bucket floor was admitted")
    }
    if refused.need != need || refused.have != need - 1 {
        fail("§1.1: the Bucket shortage must name the whole place grant")
    }
    let n = list.len(refused.parts)
    if n < 2 { fail("§1.1: the Bucket shortage must itemize capture") }
    let service = view refused.parts[n - 2]
    let starter = view refused.parts[n - 1]
    if service.0 != "follower_service" || service.1 != follower_service_bytes() ||
        starter.0 != "follower_starter" || starter.1 != follower_starter_bytes() {
        fail("§1.1: the Bucket shortage must itemize both capture terms")
    }
    Ok(())
}

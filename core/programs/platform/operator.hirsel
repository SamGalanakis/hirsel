// Module operator (package store): the operator wire on STATE/operator.sock (docs/spec/
// launch.md "The operator socket"). One connection carries one exchange: a Begin and the
// deploy it subscribes to, a Register and the genesis it subscribes to, or one Status,
// ResolvePin or LookupGroup and its one reply.
//
// Each frame is a u32 little-endian length (at most 16 MiB, `MAX_FRAME`), then one
// value-codec `Ask` (operator to host) or `Answer` (host to operator). Declared variant
// order fixes the u32 wire tags in each direction; the Rust CLI
// (crates/hirsel-core-driver/src/operator.rs) mirrors these types, and operator_wire.hirsel
// holds the byte vectors both sides check.
//
// D is the client's random 16-byte request ID, A a host-generated launcher.Attempt, and a
// hash H is 32 bytes. A known D names the same group and input for its whole life.
pub const PATH: String = "operator.sock"

pub const MAX_FRAME: u64 = 16777216u64

// A recorded group's tapes: each serving start writes `dir`/<recording ID in hex>.tape,
// and its pin lasts `retention_s` seconds from the start.
pub type Record: codec + send {
    dir: String,
    retention_s: u64
}

pub type Forward: codec + send = Http | Stream

pub type Front: codec + send {
    names: List[String],
    forward: Forward
}

// A group the operator registers (launch.md "Registering a group"): its catalog name, the
// tenant it is charged to, its working directory, whether its author is a trusted publisher,
// its listener address, store directory and release memory allowance,
// the program's arguments for every serving start, recording settings and the TLS front.
pub type Registration: codec + send {
    name: String,
    tenant: String,
    workdir: String,
    trusted: bool,
    listen: String,
    store: String,
    memory: Option[u64],
    args: List[String],
    record: Option[Record],
    front: Option[Front]
}

// What a Begin or Register deploys (launch.md "The operator socket"): an attested recipe R,
// a publication R in the launcher's code store, or source, a `launcher.Tree`'s codec bytes.
pub type Input: codec + send = AttestedInput(Bytes) | PublicationInput(Bytes) | SourceInput(Bytes)

// One operator request. Tags: 0 Begin, 1 Data, 2 EndInput, 3 Confirm, 4 Status,
// 5 ResolvePin, 6 LookupGroup, 7 Register, 8 Decide (operator.sock only).
pub type Ask: codec + send =
// Begin(D, group, input, foreign, exec, held, gate): deploy `input` to the group's current
// incarnation, approving exactly these sorted Foreign and Exec lines, with `held` the fate of
// each run the deploy holds (RUNNER-SPEC §14.6). Unsorted or repeated entries are Invalid.
// `gate` asks for the law gate (launch.md "The law gate"); with any input but a source it is
// Invalid.
BeginAsk(Bytes, launcher.Group, Input, List[String], List[String], runner.fate.Fates, bool)
// One nonempty chunk of an attested input's admission bytes, on the connection that owns A.
    | DataAsk(Bytes, launcher.Attempt, Bytes)
// The attested input is complete.
    | EndAsk(Bytes, launcher.Attempt)
// The operator checked, printed and flushed the display whose UTF-8 SHA-256 this is.
    | ConfirmAsk(Bytes, launcher.Attempt, Bytes)
// D's committed state, or UnknownRequest. Does no work.
    | StatusAsk(Bytes)
// The pin of a 16-byte recording ID at the host's wall clock.
    | ResolveAsk(Bytes)
// The registered incarnation of a group name.
    | LookupAsk(String)
// Register(D, group, input, foreign, exec): add the group under a new incarnation and run
// `input` as its first release, approving exactly these sorted Foreign and Exec lines. Its
// upload and confirmation are a Begin's; it ends Installed at activation 0, its genesis.
    | RegisterAsk(Bytes, Registration, Input, List[String], List[String])
// Decide(D, decision, fates, approve): the operator's decision on request D, which awaits
// one on exactly `decision` (launch.md "Self-editing"). When the decision shows a held group
// or an unmatched path, `fates` replaces D's fates; otherwise it is `fate.none()`. An
// approval repeats D's admission under the approved set; a refusal fails D Denied.
    | DecideAsk(Bytes, Decision, runner.fate.Fates, bool)

// What a pin lookup finds: the assembly a recording ran, or Gone for an absent, expired
// or removed pin. A store error is an error, never Gone.
pub type Resolved: codec + send = Found(Bytes) | Gone

// How a write pause is known in an Installed report.
pub type Pause: codec + send = NotStarted | AwaitWrite | Measured(u64) | MeasurementLost | StartFailed(String)

// How NEW changes one entry, by code identity (launch.md "Deploy preview"): an entry OLD
// lacks, one NEW lacks, or one both export whose `code.revision` differs or is equal.
pub type EntryChange: codec + send = EntryAdded | EntryRemoved | EntryChanged | EntryUnchanged

pub type EntryLine: codec + send {
    identity: Bytes,
    change: EntryChange
}

// A deploy's preview (launch.md "Deploy preview"): the grant diff against OLD's recipe,
// every entry of OLD or NEW sorted by identity, and the prepare child's report of what NEW
// does with each pending trigger, with each held group's fate and the unmatched held entry
// paths, and the migration OLD reported for the PREPARED it bound (RUNNER-SPEC §14.3
// "Preparing"). A part not yet computed when the deploy ended is empty.
pub type Preview: codec + send {
    grants: launcher.Grants,
    entries: List[EntryLine],
    triggers: runner.TriggerReport,
    migration: Option[Migration]
}

pub fn no_triggers() -> runner.TriggerReport {
    runner.TriggerReport(rows: list.new(), unmatched: list.new())
}

pub fn no_preview() -> Preview {
    Preview(grants: launcher.no_grants(), entries: list.new(), triggers: no_triggers(), migration: None)
}

// A deploy's timing and preview: fetch and assembly nanoseconds, the write pause, and the
// preview.
pub type Report: codec + send {
    fetch_ns: Option[u64],
    assemble_ns: Option[u64],
    pause: Pause,
    preview: Preview
}

// The error and failure classes. Tags 0 Protocol, 1 Denied, 2 UnknownRequest,
// 3 UnknownGroup, 4 Conflict, 5 Busy, 6 Full, 7 Invalid, 8 Unassembled, 9 Store,
// 10 Uncompiled, 11 NotInstalledAfterRecovery, 12 Exhausted, 13 Red (a gated source whose
// tests were not all green).
pub type Class: codec + send = ProtocolClass | DeniedClass | UnknownRequestClass | UnknownGroupClass | ConflictClass | BusyClass | FullClass | InvalidClass | UnassembledClass | StoreClass | UncompiledClass | NotInstalledClass | ExhaustedClass | RedClass

// Which facts a decision has computed: the admission facts only (grants, approvals), or
// every fact after prepare.
pub type DecisionStage: codec + send = AdmissionStage | PreparedStage

// R's Foreign and Exec lines and the exact display text, held only for an editor's request.
pub type Approvals: codec + send {
    r: Bytes,
    foreign: List[String],
    exec: List[String],
    text: String
}

// The migration PREPARED ships: `digest` is the SHA-256 of its 0x0082 payloads in order and
// the 0x0083 inventory's sorted (id, kind) list; `changes` names each collection it touches.
pub type Migration: codec + send {
    digest: Bytes,
    changes: List[String]
}

// What a held request awaits the operator's decision on (launch.md "Self-editing"): the
// source tree's digest and H (empty for an attested or publication input), the stage, and
// each fact, where an empty part is clear.
pub type Decision: codec + send {
    tree: Bytes,
    root: Bytes,
    stage: DecisionStage,
    grants: launcher.Grants,
    approvals: Option[Approvals],
    migration: Option[Migration],
    triggers: runner.TriggerReport
}

pub fn decision_bytes(d: Decision) -> Bytes {
    let codec: std.codec.Codec[Decision] = std.codec.of()
    let mut out: Bytes = list.new()
    let _ = std.codec.encode(codec, d, mut out)
    out
}

// Whether a decision shows a held group or an unmatched path, which its Decide must fate.
pub fn shows_held(d: Decision) -> bool {
    if list.len(d.triggers.unmatched) > 0u64 {
        return true
    }
    for row in d.triggers.rows {
        if let Held = row.class {
            return true
        }
    }
    false
}

// Where a request stands. Tags 0 AwaitInput(A), 1 Admitting(A), 2 AwaitConfirm(A),
// 3 Assembling(A), 4 Preparing(A), 5 Pending(A, v), 6 Undecided(A, v, reason),
// 7 Installed(v, assembly, report), 8 Failed(class, detail, report), 9 AwaitDecision(decision).
// Installed and Failed are terminal. AwaitDecision holds no attempt: the request waits for
// the operator's Decide on exactly that decision.
pub type Phase: codec + send = AwaitInput(launcher.Attempt) | AdmittingPhase(launcher.Attempt) | AwaitConfirm(launcher.Attempt) | AssemblingPhase(launcher.Attempt) | PreparingPhase(launcher.Attempt) | PendingPhase(launcher.Attempt, u64) | UndecidedPhase(launcher.Attempt, u64, String) | InstalledPhase(u64, Bytes, Report) | FailedPhase(Class, String, Report) | AwaitDecision(Decision)

// One host reply. Tags: 0 State, 1 Need, 2 Display, 3 Pin, 4 Error, 5 GroupInfo, 6 Part.
pub type Answer: codec + send =
// State(D, group, input, phase): a committed snapshot.
StateAnswer(Bytes, launcher.Group, Input, Phase)
// Need(D, A, keys, last): one part of the verifier's missing set.
    | NeedAnswer(Bytes, launcher.Attempt, List[launcher.Wanted], bool)
// Display(D, A, R, text): the exact Foreign and Exec text to confirm for verified R.
    | DisplayAnswer(Bytes, launcher.Attempt, Bytes, String) | PinAnswer(Resolved) | ErrorAnswer(Class, String) | GroupAnswer(launcher.Group)
// Part(total, offset, bytes): one in-order chunk of an encoded reply larger than a frame.
    | PartAnswer(u64, u64, Bytes)

pub fn terminal(p: Phase) -> bool {
    match p {
        InstalledPhase(_, _, _) => true,
        FailedPhase(_, _, _) => true,
        _ => false,
    }
}

pub fn no_report() -> Report {
    Report(fetch_ns: None, assemble_ns: None, pause: NotStarted, preview: no_preview())
}

pub fn decode_ask(body: Bytes) -> Option[Ask] {
    let codec: std.codec.Codec[Ask] = std.codec.of()
    match std.codec.decode(codec, body) {
        Ok(take a) => Some(take a),
        _ => None
    }
}

pub fn encode_answer(a: Answer) -> Option[Bytes] {
    let codec: std.codec.Codec[Answer] = std.codec.of()
    let mut out: Bytes = list.new()
    if let Error(_) = std.codec.encode(codec, a, mut out) {
        return None
    }
    Some(out)
}

// The canonical bytes of a Begin: what a later Begin with the same D must equal.
pub fn ask_bytes(a: Ask) -> Bytes {
    let codec: std.codec.Codec[Ask] = std.codec.of()
    let mut out: Bytes = list.new()
    let _ = std.codec.encode(codec, a, mut out)
    out
}

pub fn read_frame(mut input: ReadHalf, until: Until) -> Option[Bytes] waits {
    runner.read_frame(mut input, MAX_FRAME, until)
}

pub fn send_frame(mut output: WriteHalf, body: Bytes, until: Until) -> bool waits {
    runner.send_frame(mut output, body, MAX_FRAME, until)
}

// Open one operator exchange and read its first answer. Source Begin carries its whole
// input, so a complete admission keeps running after this connection closes.
pub fn exchange(n: Net, root: String, ask: Ask, until: Until) -> Option[Answer] waits {
    let Ok(take socket) = host.connect_unix(n, root, PATH, until) else {
        return None
    }
    let (take rd, take wr) = net.split(take socket)
    let mut w = take wr
    if !send_frame(mut w, ask_bytes(ask), until) {
        return None
    }
    let mut r = take rd
    let Some(body) = read_frame(mut r, until) else {
        return None
    }
    let codec: std.codec.Codec[Answer] = std.codec.of()
    match std.codec.decode(codec, body) {
        Ok(take a) => Some(take a),
        Error(_) => None,
    }
}

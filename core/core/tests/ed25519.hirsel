// Signature verification laws in docs/spec/core.md.
// RFC 8032 §7.1 TEST 1.
fn rfc_test_1() -> (Bytes, Bytes, Bytes) {
    (b"\xd7\x5a\x98\x01\x82\xb1\x0a\xb7\xd5\x4b\xfe\xd3\xc9\x64\x07\x3a\x0e\xe1\x72\xf3\xda\xa6\x23\x25\xaf\x02\x1a\x68\xf7\x07\x51\x1a", b"", b"\xe5\x56\x43\x00\xc3\x60\xac\x72\x90\x86\xe2\xcc\x80\x6e\x82\x8a\x84\x87\x7f\x1e\xb8\xe5\xd9\x74\xd8\x73\xe0\x65\x22\x49\x01\x55\x5f\xb8\x82\x15\x90\xa3\x3b\xac\xc6\x1e\x39\x70\x1c\xf9\xb4\x6b\xd2\x5b\xf5\xf0\x59\x5b\xbe\x24\x65\x51\x41\x43\x8e\x7a\x10\x0b")
}

// RFC 8032 §7.1 TEST 2.
fn rfc_test_2() -> (Bytes, Bytes, Bytes) {
    (b"\x3d\x40\x17\xc3\xe8\x43\x89\x5a\x92\xb7\x0a\xa7\x4d\x1b\x7e\xbc\x9c\x98\x2c\xcf\x2e\xc4\x96\x8c\xc0\xcd\x55\xf1\x2a\xf4\x66\x0c", b"\x72", b"\x92\xa0\x09\xa9\xf0\xd4\xca\xb8\x72\x0e\x82\x0b\x5f\x64\x25\x40\xa2\xb2\x7b\x54\x16\x50\x3f\x8f\xb3\x76\x22\x23\xeb\xdb\x69\xda\x08\x5a\xc1\xe4\x3e\x15\x99\x6e\x45\x8f\x36\x13\xd0\xf1\x1d\x8c\x38\x7b\x2e\xae\xb4\x30\x2a\xee\xb0\x0d\x29\x16\x12\xbb\x0c\x00")
}

// RFC 8032 §7.1 TEST 3.
fn rfc_test_3() -> (Bytes, Bytes, Bytes) {
    (b"\xfc\x51\xcd\x8e\x62\x18\xa1\xa3\x8d\xa4\x7e\xd0\x02\x30\xf0\x58\x08\x16\xed\x13\xba\x33\x03\xac\x5d\xeb\x91\x15\x48\x90\x80\x25", b"\xaf\x82", b"\x62\x91\xd6\x57\xde\xec\x24\x02\x48\x27\xe6\x9c\x3a\xbe\x01\xa3\x0c\xe5\x48\xa2\x84\x74\x3a\x44\x5e\x36\x80\xd7\xdb\x5a\xc3\xac\x18\xff\x9b\x53\x8d\x16\xf2\x90\xae\x67\xf7\x60\x98\x4d\xc6\x59\x4a\x7c\x15\xe9\x71\x6e\xd2\x8d\xc0\x27\xbe\xce\xea\x1e\xc4\x0a")
}

// Wycheproof ed25519_test.json at 65ca494727a52944c204441c860b039e6786b99b, tcId 3.
fn wycheproof_tc3() -> (Bytes, Bytes, Bytes) {
    (b"\x7d\x4d\x0e\x7f\x61\x53\xa6\x9b\x62\x42\xb5\x22\xab\xbe\xe6\x85\xfd\xa4\x42\x0f\x88\x34\xb1\x08\xc3\xbd\xae\x36\x9e\xf5\x49\xfa", b"\x54\x65\x73\x74", b"\x7c\x38\xe0\x26\xf2\x9e\x14\xaa\xbd\x05\x9a\x0f\x2d\xb8\xb0\xcd\x78\x30\x40\x60\x9a\x8b\xe6\x84\xdb\x12\xf8\x2a\x27\x77\x4a\xb0\x7a\x91\x55\x71\x1e\xcf\xaf\x7f\x99\xf2\x77\xba\xd0\xc6\xae\x7e\x39\xd4\xee\xf6\x76\x57\x33\x36\xa5\xc5\x1e\xb6\xf9\x46\xb3\x0d")
}

// SV1. The RFC vectors cover empty, one-byte and two-byte messages.
// expect: run sv1_rfc8032() = true
fn sv1_rfc8032() -> bool {
    let (k1, m1, s1) = rfc_test_1()
    let (k2, m2, s2) = rfc_test_2()
    let (k3, m3, s3) = rfc_test_3()
    ed25519.verify(k1, m1, s1) && ed25519.verify(k2, m2, s2) && ed25519.verify(k3, m3, s3)
}

// SV2. Flip the last bit of TEST 3's message.
// expect: run sv2_flipped_message() = false
fn sv2_flipped_message() -> bool {
    let (key, _, sig) = rfc_test_3()
    ed25519.verify(key, b"\xaf\x83", sig)
}

// SV3. tcId 63 encodes S + L. The same key and message verify with tcId 3's S.
// expect: run sv3_scalar_range() = true
fn sv3_scalar_range() -> bool {
    let (key, msg, sig) = wycheproof_tc3()
    ed25519.verify(key, msg, sig) && !ed25519.verify(key, msg, b"\x7c\x38\xe0\x26\xf2\x9e\x14\xaa\xbd\x05\x9a\x0f\x2d\xb8\xb0\xcd\x78\x30\x40\x60\x9a\x8b\xe6\x84\xdb\x12\xf8\x2a\x27\x77\x4a\xb0\x67\x65\x4b\xce\x38\x32\xc2\xd7\x6f\x8f\x6f\x5d\xaf\xc0\x8d\x93\x39\xd4\xee\xf6\x76\x57\x33\x36\xa5\xc5\x1e\xb6\xf9\x46\xb3\x1d")
}

// SV4. tcId 152 satisfies the cofactorless equation with the identity key.
// expect: run sv4_identity_key() = true
fn sv4_identity_key() -> bool {
    let key = b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    let msg = b"\x6d\x65\x73\x73\x61\x67\x65"
    let sig = b"\x58\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x66\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    ed25519.verify(key, msg, sig)
}

// SV5. Short and long keys, and a short signature, derived from TEST 1.
// expect: run sv5_rfc_lengths() = true
fn sv5_rfc_lengths() -> bool {
    let (key, msg, sig) = rfc_test_1()
    !ed25519.verify(list.slice(key, 0, 31), msg, sig) && !ed25519.verify(b"\xd7\x5a\x98\x01\x82\xb1\x0a\xb7\xd5\x4b\xfe\xd3\xc9\x64\x07\x3a\x0e\xe1\x72\xf3\xda\xa6\x23\x25\xaf\x02\x1a\x68\xf7\x07\x51\x1a\x00", msg, sig) && !ed25519.verify(key, msg, b"\xe5\x56\x43\x00\xc3\x60\xac\x72\x90\x86\xe2\xcc\x80\x6e\x82\x8a\x84\x87\x7f\x1e\xb8\xe5\xd9\x74\xd8\x73\xe0\x65\x22\x49\x01\x55\x5f\xb8\x82\x15\x90\xa3\x3b\xac\xc6\x1e\x39\x70\x1c\xf9\xb4\x6b\xd2\x5b\xf5\xf0\x59\x5b\xbe\x24\x65\x51\x41\x43\x8e\x7a\x10")
}

// SV5. tcIds 30 and 33 have an empty signature and a signature with trailing bytes.
// expect: run sv5_wycheproof_lengths() = true
fn sv5_wycheproof_lengths() -> bool {
    let (key, msg, _) = wycheproof_tc3()
    let empty: Bytes = list.new()
    !ed25519.verify(key, msg, empty) && !ed25519.verify(key, msg, b"\x7c\x38\xe0\x26\xf2\x9e\x14\xaa\xbd\x05\x9a\x0f\x2d\xb8\xb0\xcd\x78\x30\x40\x60\x9a\x8b\xe6\x84\xdb\x12\xf8\x2a\x27\x77\x4a\xb0\x7a\x91\x55\x71\x1e\xcf\xaf\x7f\x99\xf2\x77\xba\xd0\xc6\xae\x7e\x39\xd4\xee\xf6\x76\x57\x33\x36\xa5\xc5\x1e\xb6\xf9\x46\xb3\x0d\x20\x20")
}

// SV10. One step and zero bytes suffice with TEST 1's local arguments.
// expect: reference run sv10_ed25519_charge() = true
fn sv10_ed25519_charge() -> bool {
    let (key, msg, sig) = rfc_test_1()
    let work = bound bytes 0 {
        bound steps 1 {
            ed25519.verify(key, msg, sig)
        }
    }
    match work {
        Ok(Ok(true)) => true,
        _ => false,
    }
}

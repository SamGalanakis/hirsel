fn compare(a:u64,b:u64)->Order { if a < b { Less } else if a > b { Greater } else { Equal } }
fn five(a: u64, b: u64, c: u64, d: u64, e: u64) -> List[u64] {
    let mut xs: List[u64] = result.unwrap(list.with_capacity(5))
    result.unwrap(list.push(mut xs, a))
    result.unwrap(list.push(mut xs, b))
    result.unwrap(list.push(mut xs, c))
    result.unwrap(list.push(mut xs, d))
    result.unwrap(list.push(mut xs, e))
    xs
}

/// The elements as the digits of one number, first element first: [3, 1, 2] is 312.
fn digits(xs: List[u64]) -> u64 {
    let mut v: u64 = 0
    for x in xs {
        v = v * 10 + x
    }
    v
}

// Original equal-key groups: 2 -> [21,22,23], 1 -> [11,12].
// Taking the right run on Equal changes [11,12,21,22,23].
// expect: run stable_equal_keys() = true
fn stable_equal_keys() -> bool {
    let mut xs = five(21, 11, 22, 12, 23)
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { compare(a / 10, b / 10) }))
    xs[0] == 11 && xs[1] == 12 && xs[2] == 21 && xs[3] == 22 && xs[4] == 23
}

// expect: run stable_empty_singleton() = 7
fn stable_empty_singleton() -> u64 {
    let mut xs: List[u64] = list.new()
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { compare(a / 10, b / 10) }))
    result.unwrap(list.push(mut xs, 7))
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { compare(a / 10, b / 10) }))
    digits(xs)
}

// expect: run stable_capacity_unchanged() = 54321
fn stable_capacity_unchanged() -> u64 {
    let mut xs = five(5, 4, 3, 2, 1)
    let r = bound bytes 0 { list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { compare(a, b) }) }
    match r { Ok(Error(_)) => digits(xs), _ => 99 }
}

// Owned elements remain a permutation and ties keep their original order.
// expect: run stable_owned_strings() = true
fn stable_owned_strings() -> bool {
    let mut xs: List[String] = list.new()
    result.unwrap(list.push(mut xs, result.unwrap(string.from("bb"))))
    result.unwrap(list.push(mut xs, result.unwrap(string.from("a"))))
    result.unwrap(list.push(mut xs, result.unwrap(string.from("cc"))))
    result.unwrap(list.sort_stable(mut xs, fn(a: String, b: String) -> Order {
        compare(list.len(string.as_bytes(a)), list.len(string.as_bytes(b)))
    }))
    xs[0] == "a" && xs[1] == "bb" && xs[2] == "cc"
}

// One 5-u64 scratch block fits exactly. This bound refused the old second allocation.
// expect: run stable_one_allocation() = 12345
fn stable_one_allocation() -> u64 {
    let mut xs = five(5, 4, 3, 2, 1)
    let r = bound bytes 40 { list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { compare(a, b) }) }
    match r { Ok(Ok(())) => digits(xs), _ => 99 }
}

// Each encoded value carries its input index. Sizes0..17 cover odd trailing
// runs and both final scratch locations. Key/order/bitmask is the list model.
// expect: run model_all_small_sizes() = true
fn model_all_small_sizes() -> bool {
    for n in 0u64 .. 18 {
        let mut xs: List[u64] = list.new()
        let mut expected_mask: u64 = 0
        for i in 0u64 .. n {
            result.unwrap(list.push(mut xs, ((i * 7 + 3) % 5) * 100 + i))
            expected_mask |= 1u64 << i
        }
        let cap = list.capacity(xs)
        result.unwrap(list.sort_stable(mut xs, fn(a:u64,b:u64)->Order { compare(a / 100,b / 100) }))
        if list.len(xs) != n || list.capacity(xs) != cap { return false }
        let mut mask: u64 = 0
        for i in 0u64 .. n {
            let id = xs[i] % 100
            if id >= n || xs[i] / 100 != (id * 7 + 3) % 5 { return false }
            let bit = 1u64 << id
            if (mask & bit) != 0 { return false }
            mask |= bit
            if i > 0 && (xs[i - 1] / 100 > xs[i] / 100 || (xs[i - 1] / 100 == xs[i] / 100 && xs[i - 1] % 100 > id)) { return false }
        }
        if mask != expected_mask { return false }
    }
    true
}

// An inconsistent comparator need not sort, but cannot lose or duplicate owners.
// expect: run bad_comparator_permutation() = true
fn bad_comparator_permutation() -> bool {
    let mut xs = five(3, 1, 4, 0, 2)
    result.unwrap(list.sort_stable(mut xs, fn(a:u64,b:u64)->Order { Less }))
    let mut mask: u64 = 0
    for x in xs {
        if x >= 5 { return false }
        mask |= 1u64 << x
    }
    mask == 31 && list.len(xs) == 5
}

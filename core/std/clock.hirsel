// Module `clock`: monotonic deadlines and waits (core.md, "Host"). Clock is a core
// capability type; a run's Clock comes from `main`'s granted parameters (CAP-4). Core has
// one waiting clock operation, `host.sleep_until`, on an absolute deadline in
// `host.mono_ns` nanoseconds; a relative wait is library code over it, here. Field
// legend: API.md. Nothing here admits anything (core.md, "Host").
/// Waits until `host.mono_ns(c)` has advanced by at least ns from its reading at entry:
/// one `host.mono_ns` reading plus ns is the deadline given to `host.sleep_until`, so it
/// returns at once when ns is 0 (WASI monotonic-clock subscribe-duration, Go time.Sleep).
/// A cancellation point at entry and while it waits (CONC-7); replay delivers the reading
/// and the completion without waiting (CAP-8).
/// Fails: Overflow (failure), before waiting, when the reading plus ns exceeds 2^64 - 1.
/// Ex: `std.clock.sleep_ns(c, 5_000_000)`
pub fn sleep_ns(c: Clock, ns: u64) waits {
    host.sleep_until(c, host.mono_ns(c) + ns)
}

/// The deadline at plus ms milliseconds, in monotonic nanoseconds. Saturates at
/// u64's maximum when the conversion or addition overflows. Cost: O(1).
/// Ex: `clock.deadline_after_ms(2_000_000, 5)` is 7_000_000.
pub fn deadline_after_ms(at: u64, ms: u64) -> u64 {
    int.saturating_add(at, int.saturating_mul(ms, 1000000u64))
}

type Alarm[M: send]: send {
    c: Clock,
    at: u64,
    to: Sender[M],
    m: M
}

fn fire_alarm[M: send](take job: Alarm[M]) waits {
    let Alarm(c, at, to: take to, m: take m) = take job
    host.sleep_until(c, at)
    let _ = channel.send(to, take m)
}

type WallAlarm[M: send]: send {
    c: Clock,
    at_ms: u64,
    to: Sender[M],
    m: M
}

fn fire_wall_alarm[M: send](take job: WallAlarm[M]) waits {
    let WallAlarm(c, at_ms, to: take to, m: take m) = take job
    host.sleep_until_wall(c, at_ms)
    let _ = channel.send(to, take m)
}

/// Sends m once `host.wall_ms(c)` has reached at_ms, with no wakeup before then.
/// Waits for room in the channel and ends cleanly if the receiver is closed.
/// Dropping the task before then cancels the alarm without sending.
/// Alloc: a task with a 4096-byte child limit and a copy of the sender handle.
pub fn wall_alarm[M: send](tasks: Tasks, c: Clock, at_ms: u64, to: Sender[M], take m: M) -> Task[()] {
    task.spawn(tasks, bytes 4096, WallAlarm(c, at_ms, to: channel.sender(to), m: take m), fire_wall_alarm)
}

/// Sends m once at or after the absolute monotonic deadline at. Waits for room
/// in the channel and ends cleanly if the receiver is closed. Dropping the task
/// before at cancels the alarm without sending.
/// Alloc: a task with a 4096-byte child limit and a copy of the sender handle.
pub fn alarm[M: send](tasks: Tasks, c: Clock, at: u64, to: Sender[M], take m: M) -> Task[()] {
    task.spawn(tasks, bytes 4096, Alarm(c, at, to: channel.sender(to), m: take m), fire_alarm)
}

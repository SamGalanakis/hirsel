pub type DeferredFree: shareable + send {
    branch_id: u32,
    target: format.TieredTarget
}

pub fn deferred_free_value(row: DeferredFree) -> Bytes {
    let (tag, take payload): (u8, Bytes) = match row.target {
        TieredPage(ptr) => (0, std.page.encode_ptr(ptr)),
        TieredBlob(reference) => (1, std.page.encode_ref(reference)),
    }
    let mut value: Bytes = list.with_capacity(5 + list.len(payload))
    list.push(mut value, tag)
    list.put_word_le(mut value, row.branch_id)
    list.append(mut value, payload)
    take value
}

pub fn deferred_free_entry(seq: u64, row: DeferredFree) -> std.page.Entry {
    let mut key: Bytes = list.with_capacity(8)
    list.put_word_be(mut key, seq)
    std.page.Entry(key: take key, cell: InlineValue(deferred_free_value(row)))
}

pub fn decode_deferred_free(file: String, at: u64, key: Bytes, value: Bytes, manifest: PageManifest) -> Result[(u64, DeferredFree), types.Failure] {
    if list.len(key) != 8 || list.len(value) < 5 {
        return Error(format.disk_fault(file, at, Malformed))
    }
    let seq: u64 = list.word_be(key, 0)
    let branch_id: u32 = list.word_le(value, 1)
    if seq >= manifest.deferred_next || branch_id >= manifest.next_branch {
        return Error(format.disk_fault(file, at, Malformed))
    }
    let target: format.TieredTarget = match value[0u64] {
        0 if list.len(value) == 41 => {
            let ptr = std.page.decode_ptr(list.slice(value, 5, 41)) ?=> |_| format.disk_fault(file, at, Malformed)
            TieredPage(ptr)
        },
        1 if list.len(value) == 47 => {
            let reference = std.page.decode_ref(list.slice(value, 5, 47)) ?=> |_| format.disk_fault(file, at, Malformed)
            TieredBlob(reference)
        },
        _ => return Error(format.disk_fault(file, at, Malformed)),
    }
    Ok((seq, DeferredFree(branch_id: branch_id, target: take target)))
}

pub fn validate_deferred_target(inventory: RecoveryInventory, target: format.TieredTarget) -> Result[(), types.Failure] {
    let frame = format.tiered_frame_id(target)
    let path = paged_pack_path(frame.pack)?
    let (class, least, limit): (u8, u64, u64) = match target {
        TieredPage(_) => (3, 24, PAGE_LIMIT),
        TieredBlob(_) => (4, 8, BLOB_LIMIT),
    }
    let Some(pack) = map.get(inventory.packs, frame.pack) else {
        return Error(format.disk_fault(path, frame.offset, Malformed))
    }
    if pack.class != class || frame.stamp == 0 || frame.stamp >= inventory.next_stamp || frame.len < least || frame.len > limit || frame.offset < 72 || frame.offset >= pack.index || 16 + frame.len > pack.index - frame.offset {
        return Error(format.disk_fault(path, frame.offset, Malformed))
    }
    Ok(())
}

pub type TieredDeferredQueue {
    rows: std.omap.OMap[u64, DeferredFree],
    issued: u64,
    next_seq: u64
}

pub type TieredDrainKill: send {
    branch_id: u32,
    frame: ReplacedFrame
}

// T8 steps 3 and 4: the rows a cut adds at `deferred_next` onward, in order,
// and the (sequence, prior) pairs its drain consumed. Installed rows carry
// their encoded length + 1. New rows carry zero. `folded` holds
// the Cold frames the fold replaced, which step 2 files with the replaced
// list; `kills` holds the drain's. `moved` holds the (pack, len) of each
// Cold ancestor that compaction re-emitted, and `retiring` the packs whose
// compaction probe this cut finished (T8 steps 6 and 7). `rewritten` holds
// the installed rows this cut's compaction moved, at their own sequences,
// with the values T8 step 3 writes; an added row carries its moved value in
// `added`.
pub type CutQueue: send {
    added: List[DeferredFree],
    rewritten: List[(u64, DeferredFree)],
    drained: List[(u64, u32)],
    kills: List[TieredDrainKill],
    folded: List[TieredDrainKill],
    moved: List[(u64, u64)],
    retiring: List[u64]
}

pub fn no_cut_queue() -> CutQueue {
    CutQueue(added: list.new(), rewritten: list.new(), drained: list.new(), kills: list.new(), folded: list.new(), moved: list.new(), retiring: list.new())
}

pub fn queued_free(value: Bytes) -> DeferredFree {
    let branch_id: u32 = list.word_le(value, 1)
    let target: format.TieredTarget = match value[0u64] {
        0 => TieredPage(result.unwrap(std.page.decode_ptr(list.slice(value, 5, 41)))),
        _ => TieredBlob(result.unwrap(std.page.decode_ref(list.slice(value, 5, 47)))),
    }
    DeferredFree(branch_id: branch_id, target: take target)
}

// Installed rewrites and drains are each in sequence order. Drains of new
// rows cancel their insert, including children appended during this drain.
pub fn edit_deferred_list(mut root: Arc[std.page.Page], first: u64, queue: CutQueue, issued: core.Cell[u64]) -> Result[u64, types.Failure] {
    let Some(end) = int.checked_add(first, list.len(queue.added)) else {
        return Error(Limit(Ids))
    }
    let mut edits = ManifestEdits(data: list.new(), offsets: list.new())
    let mut drained = 0u64
    for (seq, row) in queue.rewritten {
        while drained < list.len(queue.drained) && queue.drained[drained].0 < seq {
            let (at, prior) = queue.drained[drained]
            add_manifest_edit(mut edits, at, None, Some(prior))
            drained += 1
        }
        add_manifest_edit(mut edits, seq, Some(deferred_free_value(row)), None)
    }
    while drained < list.len(queue.drained) && queue.drained[drained].0 < first {
        let (at, prior) = queue.drained[drained]
        add_manifest_edit(mut edits, at, None, Some(prior))
        drained += 1
    }
    for seq in first .. end {
        if drained < list.len(queue.drained) && queue.drained[drained].0 == seq {
            drained += 1
        } else {
            add_manifest_edit(mut edits, seq, Some(deferred_free_value(queue.added[seq - first])), Some(0))
        }
    }
    apply_manifest_edits(mut root, take edits, issued)?
    Ok(end)
}

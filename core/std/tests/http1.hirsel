// Go ebe2feefc400 readrequest_test.go:33, reqTests[0]; head only.
// Mutant: drop_head_field.
// expect: run go_head_00() = true
fn go_head_00() -> bool {
    let mut names: List[Bytes] = list.new()
    list.push(mut names, b"Host")
    list.push(mut names, b"User-Agent")
    list.push(mut names, b"Accept")
    list.push(mut names, b"Accept-Language")
    list.push(mut names, b"Accept-Encoding")
    list.push(mut names, b"Accept-Charset")
    list.push(mut names, b"Keep-Alive")
    list.push(mut names, b"Content-Length")
    list.push(mut names, b"Proxy-Connection")
    let mut values: List[Bytes] = list.new()
    list.push(mut values, b"www.techcrunch.com")
    list.push(mut values, b"Fake")
    list.push(mut values, b"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8")
    list.push(mut values, b"en-us,en;q=0.5")
    list.push(mut values, b"gzip,deflate")
    list.push(mut values, b"ISO-8859-1,utf-8;q=0.7,*;q=0.7")
    list.push(mut values, b"300")
    list.push(mut values, b"7")
    list.push(mut values, b"keep-alive")
    request_case(b"GET http://www.techcrunch.com/ HTTP/1.1\r\nHost: www.techcrunch.com\r\nUser-Agent: Fake\r\nAccept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\nAccept-Language: en-us,en;q=0.5\r\nAccept-Encoding: gzip,deflate\r\nAccept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\r\nKeep-Alive: 300\r\nContent-Length: 7\r\nProxy-Connection: keep-alive\r\n\r\nabcdef\n???", Complete, 338, Some(b"GET"), Some(b"http://www.techcrunch.com/"), Some(1), names, values)
}


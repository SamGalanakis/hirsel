fn old_balance(v: OldAccount) -> Result[u64, Capacity] {
    Ok(v.balance)
}

fn twice_balance(v: OldAccount) -> Result[u64, Capacity] {
    Ok(v.balance * 2)
}

fn new_bonus(v: NewAccount) -> Result[u64, Capacity] {
    Ok(v.bonus)
}

// L31 (b): Capacity from the extractor on the second row, k2 (balance 9).
fn bonus_refuses(v: NewAccount) -> Result[u64, Capacity] {
    if v.balance == 9 { Error(Capacity(requested: 1, available: 0)) } else { Ok(v.bonus) }
}

// L31 (b): an index key of 5000 bytes, past the 4096-byte key limit.
fn wide_key(v: NewAccount) -> Result[Bytes, Capacity] {
    let mut raw: Bytes = list.new()
    list.fill(mut raw, 5000, int.truncate(v.balance))
    Ok(take raw)
}

fn upgrade(k: u64, v: OldAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((k, NewAccount(balance: v.balance, bonus: v.balance * 10))))
}

fn keep_new(k: u64, v: NewAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((k, v)))
}

fn collapse(k: u64, v: NewAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((0, v)))
}

// by_b's order as one number: each row is k * 1000 + bonus, four digits
// each, so (70, k1), (90, k2) is 1070 2090.
fn bonus_order(s: Snapshot, ix: Index[u64, u64, NewAccount]) -> Result[u64, Error] {
    let mut rows = find(s, ix, Unbounded, Unbounded)?
    let mut keys = 0u64
    while let Some((k, v)) = next(mut rows)? {
        keys = keys * 10000 + k * 1000 + v.bonus
    }
    Ok(keys)
}

fn new_spec(name: String, index_name: String) -> TableSpec[u64, NewAccount] {
    let mut s = spec(string.from(name), std.codec.key_u64(), new_codec())
    result.unwrap(with_index(mut s, index_name, code.describe(new_bonus), std.codec.key_u64()))
    s
}

// L31 by hand, AB1's trace with Old {balance} for Old {a} and New {balance,
// bonus} for New {b}. Table t (id 1) with by_a (id 2) = Old.balance holds
// k1 = Old 7 and k2 = Old 9 at v2. migrate to `t` with by_b = New.bonus and
// f(k, Old a) = (k, New a, 10a): t gets id 3 and by_b id 4, at v3; the rows
// take schema number 1, the old entry's next, and number 0 retires. by_b
// lists (70, k1), (90, k2); by_a and its entries are gone. Old handles are
// Stale(1) and Stale(2) against v3 and read M at v2, where the new handles
// are Stale(3). A New put k3 = (5, 50) joins by_b first. (b) A migrate whose
// extractor refuses k2 is Full, one whose index key is 5000 bytes is
// Limit(Key), one whose f sends two rows to one key is Exists, and a spec
// repeating an index name is Exists; each leaves v4, the catalog and by_b as
// they were. (c) A table declared with two indexes is one commit, and both
// hold the first put. Wrong implementations caught: a migrate that keeps
// from's indexes (by_a still listed); one that installs rows past a failed
// index build (b is Ok); a reused schema number (the entry lists 0).
pub fn law_migrate(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let mut declared = spec("t", std.codec.key_u64(), old_codec())
    result.unwrap(with_index(mut declared, "by_a", code.describe(old_balance), std.codec.key_u64()))
    match with_index(mut declared, "by_a", code.describe(twice_balance), std.codec.key_u64()) { Error(Exists(_)) => {}, _ => return false }
    result.unwrap(create_table(mut db, take declared))
    let mut t = result.unwrap(table(mut db, "t", std.codec.key_u64(), old_codec()))
    let ix_a = result.unwrap(index(db, mut t, "by_a", code.describe(old_balance), std.codec.key_u64()))
    let mut writer = result.unwrap(table(mut db, "t", std.codec.key_u64(), old_codec()))
    let _ = result.unwrap(index(db, mut writer, "by_a", code.describe(old_balance), std.codec.key_u64()))
    let first = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, OldAccount(balance: 7))?
        put(mut tx, t, 2, OldAccount(balance: 9))
    }))
    match take first { Committed(_) => {}, _ => return false }
    let before = snapshot(db)
    let _ = result.unwrap(pin(mut db, "before", before))
    let old_shape = shape(t)
    if version(before) != 2 || t.id != 1 || ix_a.id != 2 { return false }
    result.unwrap(migrate(mut db, take t, new_spec("t", "by_b"), upgrade))
    let now = snapshot(db)
    if version(now) != 3 { return false }
    let mut nt = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    if version(snapshot(db)) != 3 || nt.id != 3 { return false }
    let ix_b = result.unwrap(index(db, mut nt, "by_b", code.describe(new_bonus), std.codec.key_u64()))
    let meta = result.unwrap(catalog_entry(db, nt.catalog_key))
    if ix_b.id != 4 || list.len(meta.schemas) != 1 || meta.schemas[0].number != 1 || meta.next != 2 { return false }
    let listed = result.unwrap(index_catalog(db, 3))
    if list.len(listed) != 1 || listed[0].id != 4 || list.len(result.unwrap(index_catalog(db, 1))) != 0 { return false }
    let order = result.unwrap(bonus_order(now, ix_b))
    if order != 10702090 { return false }
    match get(now, old_shape, 1) { Error(Stale(id)) => if id != 1 { return false }, _ => return false }
    match find(now, ix_a, Unbounded, Unbounded) { Error(Stale(id)) => if id != 2 { return false }, _ => return false }
    match result.unwrap(get(before, old_shape, 1)) { Some(v) => if v.balance != 7 { return false }, None => return false }
    let mut old_rows = result.unwrap(find(before, ix_a, Unbounded, Unbounded))
    match result.unwrap(next(mut old_rows)) { Some((k, _)) => if k != 1 { return false }, None => return false }
    match get(before, shape(nt), 1) { Error(Stale(id)) => if id != 3 { return false }, _ => return false }
    let held = match pinned(db, "before") { Some(x) => x, None => return false }
    match get(held, shape(nt), 1) { Error(Stale(_)) => {}, _ => return false }
    let late = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, nt, 3, NewAccount(balance: 5, bonus: 50)) }))
    match take late { Committed(_) => {}, _ => return false }
    let stale_put = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, writer, 4, OldAccount(balance: 1)) }))
    match take stale_put { Aborted(undone) => match undone.value { Stale(id) => if id != 1 { return false }, _ => return false }, _ => return false }
    if result.unwrap(bonus_order(snapshot(db), ix_b)) != 305010702090 || version(snapshot(db)) != 4 { return false }
    // (b) each refusal leaves v4, ids, catalog and by_b as they were.
    let mut refusing = spec("t", std.codec.key_u64(), new_codec())
    result.unwrap(with_index(mut refusing, "by_r", code.describe(bonus_refuses), std.codec.key_u64()))
    match migrate(mut db, take nt, take refusing, keep_new) { Error(Full(_)) => {}, _ => return false }
    let mut wide = spec("t", std.codec.key_u64(), new_codec())
    result.unwrap(with_index(mut wide, "by_w", code.describe(wide_key), std.codec.key_bytes()))
    let again = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    match migrate(mut db, take again, take wide, keep_new) { Error(Limit(Key)) => {}, _ => return false }
    let third = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    match migrate(mut db, take third, new_spec("t", "by_b"), collapse) { Error(Exists(_)) => {}, _ => return false }
    let fourth = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    if version(snapshot(db)) != 4 || db.next_table != 5 || fourth.id != 3 { return false }
    if list.len(result.unwrap(index_catalog(db, 3))) != 1 || result.unwrap(bonus_order(snapshot(db), ix_b)) != 305010702090 { return false }
    // (c) two indexes, one commit.
    let mut both = spec("w", std.codec.key_u64(), old_codec())
    result.unwrap(with_index(mut both, "by_a", code.describe(old_balance), std.codec.key_u64()))
    result.unwrap(with_index(mut both, "by_twice", code.describe(twice_balance), std.codec.key_u64()))
    result.unwrap(create_table(mut db, take both))
    if version(snapshot(db)) != 5 { return false }
    let mut w = result.unwrap(table(mut db, "w", std.codec.key_u64(), old_codec()))
    let wa = result.unwrap(index(db, mut w, "by_a", code.describe(old_balance), std.codec.key_u64()))
    let wt = result.unwrap(index(db, mut w, "by_twice", code.describe(twice_balance), std.codec.key_u64()))
    let put_w = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, w, 1, OldAccount(balance: 3)) }))
    match take put_w { Committed(_) => {}, _ => return false }
    let mut by_a = result.unwrap(find(snapshot(db), wa, Included(3), Included(3)))
    let mut by_t = result.unwrap(find(snapshot(db), wt, Included(6), Included(6)))
    let a_hit = match result.unwrap(next(mut by_a)) { Some((k, _)) => k == 1, None => false }
    let t_hit = match result.unwrap(next(mut by_t)) { Some((k, _)) => k == 1, None => false }
    a_hit && t_hit && w.id == 5 && wa.id == 6 && wt.id == 7
}

@test
fn test_migrate(c: Clock) -> Result[(), ()] waits {
    if law_migrate(c) { Ok(()) } else { Error(()) }
}

// Initial ids and epochs are input validity rules, not B-tree invariants.
pub fn law_catalog_invalid(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let mut meta = result.unwrap(catalog_entry(db, t.catalog_key))
    if meta.id != 1 || meta.epoch != 1 || meta.next != 1 || meta.schemas[0].number != 0 {
        return false
    }
    meta.id = 0
    let raw = result.unwrap(encode_catalog(meta))
    match decode_catalog(raw) {
        Error(Corrupt(_)) => {},
        _ => return false
    }
    meta.id = 1
    meta.epoch = 0
    let zero_epoch = result.unwrap(encode_catalog(meta))
    match decode_catalog(zero_epoch) {
        Error(Corrupt(_)) => {},
        _ => return false
    }
    meta.epoch = 9
    meta.id = 17
    let another = result.unwrap(encode_catalog(meta))
    match decode_catalog(another) {
        Ok(catalog) => catalog.id == 17 && catalog.epoch == 9,
        _ => false
    }
}

@test
fn test_catalog_invalid(c: Clock) -> Result[(), ()] waits {
    if law_catalog_invalid(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn reject_999(v: u64) -> Result[u64, Capacity] {
    if v == 999 || v == 1999 {
        Error(Capacity(requested: 1, available: 0))
    } else {
        Ok(v)
    }
}

fn write_state(tx: Tx) -> (u64, u64, u64, u64, u64, bool) {
    let node = tree_stamp(tx.roots.collections)
    (node, tx.ids, tx.resident, tx.frame_bytes, list.len(tx.ops.rows), tx.wrote)
}

fn check_index_put_refusal(mut db: Db, t: Table[u64, u64], value: u64, frame_limit: bool) -> bool waits {
    let watermark = db.next_node
    let out = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        let previous_extra = tx.extra_bytes
        if frame_limit {
            // U1: header42 + primary31 + two (delete25 + put29) + delete25.
            // The last index put is the only edit that exceeds this allowance.
            tx.extra_bytes = 16777280 - (42 + 31 + 2 * (25 + 29) + 25 - 16)
        }
        let prior = write_state(tx)
        let rejected = match put(mut tx, t, 1, value) {
            Error(Full(_)) => !frame_limit,
            Error(Limit(Transaction)) => frame_limit,
            _ => false
        }
        tx.extra_bytes = previous_extra
        Ok(rejected && write_state(tx) == prior && fetch(tx, shape(t), 1)? == Some(99u64))
    }))
    match take out {
        Committed(done) => done.value && db.next_node == watermark,
        _ => false
    }
}

fn reject_old_index_value(value: u64) -> Result[Bytes, Capacity] {
    if value == 99 {
        return Error(Capacity(requested: 1, available: 0))
    }
    Ok(key_word(value))
}

// Catch an error from a new extractor, an old extractor and the last index
// frame check, then commit. Preserve the old row, index keys and ID watermark.
pub fn law_index_refusal(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let mut t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, t, 1, 99) {
        return false
    }
    result.unwrap(create_index(mut db, t, "a", code.describe(bucket), std.codec.key_u64()))
    result.unwrap(create_index(mut db, t, "b", code.describe(quotient), std.codec.key_u64()))
    result.unwrap(create_index(mut db, t, "c", code.describe(reject_999), std.codec.key_u64()))
    let a = result.unwrap(index(db, mut t, "a", code.describe(bucket), std.codec.key_u64()))
    let b = result.unwrap(index(db, mut t, "b", code.describe(quotient), std.codec.key_u64()))
    let _ = result.unwrap(index(db, mut t, "c", code.describe(reject_999), std.codec.key_u64()))
    if !check_index_put_refusal(mut db, t, 999, false) ||
        !check_index_put_refusal(mut db, t, 1999, false) ||
        !check_index_put_refusal(mut db, t, 100, true) {
        return false
    }
    let last_id = t.indexes[2].id
    t.indexes[2] = IndexOf(id: last_id, extract: reject_old_index_value)
    if !check_index_put_refusal(mut db, t, 100, false) {
        return false
    }
    let mut first = result.unwrap(find(snapshot(db), a, Included(3), Included(3)))
    let mut second = result.unwrap(find(snapshot(db), b, Included(24), Included(24)))
    let mut absent = result.unwrap(find(snapshot(db), b, Included(249), Included(249)))
    let mut absent_second = result.unwrap(find(snapshot(db), b, Included(499), Included(499)))
    match (result.unwrap(next(mut first)), result.unwrap(next(mut second)), result.unwrap(next(mut absent)), result.unwrap(next(mut absent_second))) {
        (Some((1, 99)), Some((1, 99)), None, None) => true,
        _ => false
    }
}

fn write_validation_encode(value: u64, mut raw: Bytes) -> Result[(), std.codec.EncodeError] {
    if value == 999 {
        return Error(CountOverflow(4294967296u64))
    }
    std.codec.put_u64(value, mut raw)
    Ok(())
}

fn write_validation_decode(raw: Bytes, mut at: u64) -> Result[u64, std.codec.DecodeError] {
    let start = at
    let value = std.codec.take_u64(raw, mut at)?
    if value == 99 {
        Error(Value(start))
    } else {
        Ok(value)
    }
}

fn write_validation_schema(mut schema: std.codec.Schema, _dictionary: std.codec.Codec[u64]) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_u64(mut schema)
    Ok(())
}

fn validation_refusal[K, V](mut tx: Tx, t: Table[K, V], key: K, value: V, expected: Limit) -> bool {
    let before = write_state(tx)
    let rejected = match (put(mut tx, t, key, value), expected) {
        (Error(Limit(Key)), Key) => true,
        (Error(Limit(Value)), Value) => true,
        _ => false
    }
    rejected && write_state(tx) == before
}

pub fn law_put_validation(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let refusing = std.codec.make(write_validation_encode, write_validation_decode, write_validation_schema, 8)
    result.unwrap(create_table(mut db, spec("refusing", std.codec.key_u64(), refusing)))
    let mut t = result.unwrap(table(mut db, "refusing", std.codec.key_u64(), refusing))
    result.unwrap(create_index(mut db, t, "a", code.describe(bucket), std.codec.key_u64()))
    let _ = result.unwrap(index(db, mut t, "a", code.describe(bucket), std.codec.key_u64()))
    let byte_codec = std.codec.of_bytes()
    result.unwrap(create_table(mut db, spec("bytes", std.codec.key_bytes(), byte_codec)))
    let byte_table = result.unwrap(table(mut db, "bytes", std.codec.key_bytes(), byte_codec))
    let outcome = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        if !validation_refusal(mut tx, t, 1u64, 999u64, Value) {
            return Ok(false)
        }
        let mut key: Bytes = list.with_capacity(4096)
        list.fill(mut key, 4096, 1u8)
        let empty: Bytes = list.new()
        if !validation_refusal(mut tx, byte_table, key, empty, Key) {
            return Ok(false)
        }
        let mut large: Bytes = list.with_capacity(VALUE_LIMIT)
        list.fill(mut large, VALUE_LIMIT, 1u8)
        if !validation_refusal(mut tx, byte_table, empty, large, Value) {
            return Ok(false)
        }
        // Install a raw fixture with a valid schema tag and a value the current
        // reader rejects. The attempted indexed overwrite has to read it.
        let mut old: Bytes = list.with_capacity(10)
        le(mut old, int.widen(t.readers.current), 2) ?=> |problem| Full(Allocation(problem))
        std.codec.put_u64(99, mut old)
        put_bytes(mut tx, t.id, key_word(1), old)?
        let prior = write_state(tx)
        let rejected = match put(mut tx, t, 1, 100) {
            Error(Decode(Value(2))) => true,
            _ => false
        }
        // Roll back the deliberately unreadable fixture.
        Error(if rejected && write_state(tx) == prior {
            Missing("checked")
        } else {
            Foreign
        })
    }))
    match take outcome {
        Aborted(Undone(value: Missing(checked), ticket: None)) => checked == "checked",
        _ => false
    }
}


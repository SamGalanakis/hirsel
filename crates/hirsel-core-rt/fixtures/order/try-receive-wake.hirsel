// CONC-5: try_receive delivers the front item as receive would, so the slot it frees
// lets a sender parked on the full queue publish. Hand-derived: the child takes 7 with
// try_receive, the root's parked send of 9 publishes, the child receives 9; stdout "7s9".
type Rx:send { rx: Receiver[u64], out: Stdout }
fn child(take x: Rx) -> u64 waits {
    let Rx(rx: rx, out: out) = take x
    let a = match channel.try_receive(rx) { Ok(v) => v, _ => 0u64 }
    result.unwrap(stdout.write(out, "7"))
    let b = match channel.receive(rx) { Ok(v) => v, _ => 0u64 }
    result.unwrap(stdout.write(out, "9"))
    a * 10u64 + b
}
pub fn main(tasks: Tasks, out: Stdout) -> Result[(), Exit] waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(1)
    result.unwrap(channel.try_send(tx, 7u64))
    let h = task.spawn(tasks, bytes 4096, Rx(rx: take rx, out: out), child)
    result.unwrap(channel.send(tx, 9u64))
    result.unwrap(stdout.write(out, "s"))
    if result.unwrap(task.join(take h)) == 79u64 { Ok(()) } else { Error(Exit(status: 3u8)) }
}

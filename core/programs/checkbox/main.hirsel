const N_PLACE: u64 = 1048576

type Bit: codec via u32(to: bit_wire, from: bit) {
    index: u32,
}

fn bit_wire(i: Bit) -> View[u32] in i {
    view i.index
}

fn bit(take i: u32) -> Result[Bit, ()] {
    if i < 1000000 {
        Ok(Bit(index: i))
    } else {
        Error(())
    }
}

type Handles: shareable + send {
    chunks: store.Table[u32, Bytes]
}

type Registry = runner.Registry[(), Handles]

fn schema(mut d: store.Declare) -> Result[Handles, store.Error] {
    let codec: std.codec.Codec[Bytes] = std.codec.of()
    let table = store.declare_table(mut d, "chunks", std.codec.key_u32(), codec)?
    let chunks = store.finish(mut d, take table)?
    Ok(Handles(chunks: chunks))
}

fn chunk(i: Bit) -> u32 {
    i.index >> 9
}

fn zero_chunk() -> Bytes {
    let mut data: Bytes = list.with_capacity(64u64)
    for _ in 0u64 .. 64u64 {
        list.push(mut data, 0u8)
    }
    data
}

fn flip(mut data: Bytes, i: Bit) -> bool {
    let index: u64 = int.widen((i.index >> 3) & 63u32)
    let mask: u8 = 1u8 << int.narrow(i.index & 7u32)
    data[index] ^= mask
    data[index] & mask != 0u8
}

fn toggle(mut tx: store.Tx, h: Handles, author: runner.Caller, take i: Bit) -> Result[bool, Never] {
    let key = chunk(i)
    let old = result.unwrap(store.fetch(tx, h.chunks, key))
    let mut data = match take old {
        Some(take value) => take value,
        None => zero_chunk()
    }
    let checked = flip(mut data, i)
    result.unwrap(store.put(mut tx, h.chunks, key, data))
    Ok(checked)
}

fn query_table(h: Handles) -> store.Table[u32, Bytes] {
    clone(h.chunks)
}

fn query_slots() -> Result[runner.Slots[Handles], runner.RegisterError] {
    runner.table_slot("chunks", code.describe(query_table))
}

fn board(tx: store.Tx, h: Handles, take _arg: ()) -> Result[runner.Answer[()], Capacity] {
    runner.table_answer("chunks", h.chunks, Unbounded, Unbounded)
}

fn place(mut registry: Registry) -> Result[(), runner.RegisterError] {
    runner.transact(mut registry, code.describe(toggle), 65536u64, runner.DEFAULT_STEPS)?
    runner.query(mut registry, code.describe(board), query_slots()?, 1048576u64, runner.DEFAULT_STEPS)
}

fn asset(path: Bytes) -> Option[std.wsock.Asset] {
    if path == string.as_bytes("/") {
        return Some(std.wsock.Asset(name: string.from("index.html"), content_type: string.from("text/html; charset=utf-8")))
    }
    let name = if path == string.as_bytes("/client.js") {
        "client.js"
    } else if path == string.as_bytes("/codec.js") {
        "codec.js"
    } else if path == string.as_bytes("/entries.js") {
        "entries.js"
    } else if path == string.as_bytes("/frame.js") {
        "frame.js"
    } else {
        return None
    }
    Some(std.wsock.Asset(name: string.from(name), content_type: string.from("text/javascript; charset=utf-8")))
}

type Settings {
    listen: Addr,
    proxies: List[std.wsock.Prefix],
}

fn settings(a: Args) -> Result[Settings, Exit] {
    let invalid = Exit(status: 2u8)
    let mut listen = Addr(ip: V4(0x7f000001u32), port: 7700u16)
    let mut proxies: List[std.wsock.Prefix] = list.new()
    let mut i = 0u64
    while i < args.len(a) {
        let name = option.unwrap(args.get(a, i))
        if name == "--hirsel-install" || std.string.starts_with(name, "--hirsel-activation=") {
            i += 1u64
            continue
        }
        let Some(value) = args.get(a, i + 1u64) else {
            return Error(invalid)
        }
        if name == "--listen" {
            let Some((address, port_text)) = std.string.split_once(value, ":") else {
                return Error(invalid)
            }
            let Some(ip) = std.wsock.parse_ip(address) else {
                return Error(invalid)
            }
            let Ok(port) = (int.parse(port_text) : Result[u16, ParseError]) else {
                return Error(invalid)
            }
            listen = Addr(ip: ip, port: port)
        } else if name == "--ingress" {
            let Some(prefix) = std.wsock.parse_prefix(value) else {
                return Error(invalid)
            }
            list.push(mut proxies, prefix)
        } else {
            return Error(invalid)
        }
        i += 2u64
    }
    Ok(Settings(listen: listen, proxies: take proxies))
}

// A stop admits for no extra time, then gives admitted work and open sessions this long.
const STOP_GRACE_MS: u64 = 5000u64

// runner.operate owns the place from store open to store close; a SIGINT or SIGTERM closes
// `stop` (runner.main), which drains and closes the store.
fn config(n: Net, directory: Dir, web: Dir, c: Clock, random: Random, tasks: Tasks, selection: runner.Selection, listen: Addr, take proxies: List[std.wsock.Prefix]) -> runner.PlaceConfig[(), Handles, (), ()] {
    let mut session = runner.wire_defaults(65536u64)
    session.site = Some(std.wsock.Site(dir: web, find: asset))
    runner.PlaceConfig(backing: Disk(directory), sizes: store.derived_sizes(),
        selection: selection, place: code.describe(place), n_place: N_PLACE, on_migrate: None, schema: code.describe(schema),
        session: session, max_sessions: runner.WIRE_OWNER_LIMIT, proxies: take proxies, n_publisher: 67108864u64,
        listen: listen, net: n, tasks: tasks, clock: c, random: random, stop: runner.Stop(lag_ms: 0u64, grace_ms: STOP_GRACE_MS), wire: Some(runner.ingress.binding()), triggers: None, idle: None)
}

fn start(n: Net, directory: Dir, web: Dir, c: Clock, random: Random, tasks: Tasks, a: Args, errors: Stderr, take stop: Receiver[()]) -> Result[runner.Ended, runner.MainError] waits {
    let selected = runner.launch_selection(a) ?=> Usage
    let Settings(listen: listen, proxies: take proxies) = settings(a) ?=> Usage
    let configured = config(n, directory, web, c, random, tasks, selected, listen, take proxies)
    let ended = runner.operate_report(take configured, take stop, result.unwrap(runner.status_root()), None, errors) ?=> Start
    Ok(ended)
}

pub fn main(n: Net, directory: Dir, web: Dir, c: Clock, random: Random, tasks: Tasks, a: Args, process: Process, errors: Stderr) -> Result[(), Exit] waits {
    runner.main(a, process, errors, tasks, code.describe(place), scoped fn(take stop: Receiver[()]) -> Result[runner.Ended, runner.MainError] waits {
        if let Some(take candidate) = runner.launch_prepare_args(a) ?=> Usage {
            let runner.PrepareArgs(attempt: take attempt, digest: take digest) = take candidate
            let configured = config(n, directory, web, c, random, tasks, Reopen, Addr(ip: V4(0x7f000001u32), port: 0u16), list.new())
            return Ok(runner.prepare_place(take configured, take attempt, take digest, errors) ?=> Start)
        }
        start(n, directory, web, c, random, tasks, a, errors, take stop)
    })
}

type BenchmarkBoard: cross {
    net: Net,
    directory: Dir,
    web: Dir,
    clock: Clock,
    random: Random,
    tasks: Tasks,
    args: Args,
    process: Process,
    errors: Stderr,
}

fn serve_board(take app: BenchmarkBoard) -> Result[(), Exit] waits {
    main(app.net, app.directory, app.web, app.clock, app.random, app.tasks, app.args, app.process, app.errors)
}

// The store runner's publisher, owner and reader use unit-local channels.
// The benchmark moves the whole application into an owned unit.
pub fn shipping_benchmark(n: Net, directory: Dir, web: Dir, c: Clock, random: Random, tasks: Tasks, a: Args,
                           process: Process, errors: Stderr) -> Result[(), Exit] waits {
    let app = BenchmarkBoard(net: n, directory: directory, web: web, clock: c,
        random: random, tasks: tasks, args: a, process: process, errors: errors)
    let h = result.unwrap(task.spawn_unit(tasks, bytes 3221225472 - 1048576, take app, serve_board))
    result.unwrap(task.join(take h))
}

fn at_bit(raw: u32, expected_chunk: u32, expected_byte: u64, expected_mask: u8) -> bool {
    let i = result.unwrap(bit(raw))
    let mut data = zero_chunk()
    if chunk(i) != expected_chunk || !flip(mut data, i) {
        return false
    }
    for offset in 0u64 .. 64u64 {
        let want = if offset == expected_byte {
            expected_mask
        } else {
            0u8
        }
        if data[offset] != want {
            return false
        }
    }
    if flip(mut data, i) {
        return false
    }
    data == zero_chunk()
}

pub fn bit_law() -> bool {
    at_bit(0u32, 0u32, 0u64, 1u8) && at_bit(7u32, 0u32, 0u64, 128u8) && at_bit(8u32, 0u32, 1u64, 1u8) && at_bit(511u32, 0u32, 63u64, 128u8) && at_bit(512u32, 1u32, 0u64, 1u8) && at_bit(999999u32, 1953u32, 7u64, 128u8)
}

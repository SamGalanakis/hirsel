// A Streamable HTTP server at 2025-06-18 that requires its session, applied as
// rules from that revision's transports and lifecycle pages, not as a script:
// - initialize carries no Mcp-Session-Id; its response assigns one.
// - every later request carries that Mcp-Session-Id (else 400) and
//   MCP-Protocol-Version: 2025-06-18, the negotiated version (else 400).
// - notifications/initialized is a notification, answered 202 with no body,
//   and requests before it are refused.
// - a request on a terminated session gets 404.
// It ends the session after one tools/list.
const SIM_MEMORY: u64 = 1048576

const SIM_SESSION: String = "sim-7f3a"

type Sim: send {
    listener: Listener,
    clock: Clock,
    deadline: u64
}

fn sim_field(wire: Bytes, h: std.http1.Head, name: Bytes) -> Option[Bytes] {
    for i in 0u64 .. h.count {
        let field = h.fields[i]
        if std.http1.equal_ascii(list.slice(wire, field.name.start, field.name.end), name) {
            return Some(std.http.copy_bytes(list.slice(wire, field.value.start, field.value.end)))
        }
    }
    None
}

fn sim_reply(status: u16, reason: String, fields: String, body: String) -> Bytes {
    let mut h = string.from("HTTP/1.1 ")
    string.push_u64(mut h, int.widen(status))
    string.push(mut h, " ")
    string.push(mut h, reason)
    string.push(mut h, "\r\nConnection: close\r\n")
    string.push(mut h, fields)
    string.push(mut h, "Content-Length: ")
    string.push_u64(mut h, string.byte_len(body))
    string.push(mut h, "\r\n\r\n")
    string.push(mut h, body)
    string.into_bytes(take h)
}

fn sim_id(id: rpc.Id) -> String {
    let mut out = string.new()
    std.json.write(mut out, false, fn(w) {
        rpc.write_id(w, id)
    })
    take out
}

fn no_session() -> Bytes {
    sim_reply(400, "Bad Request", "Content-Type: application/json\r\n", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32000,\"message\":\"Bad Request: No valid session ID provided\"},\"id\":null}")
}

fn bad_request() -> Bytes {
    sim_reply(400, "Bad Request", "", "")
}

// phase: 0 before initialize, 1 initialized response sent, 2 ready, 3 ended.
fn sim_answer(wire: Bytes, h: std.http1.Head, body: String, mut phase: u8) -> (u16, Bytes) {
    let Ok(take request) = rpc.request(body) else {
        return (400, bad_request())
    }
    let rpc.Request(id: take id, method: take method, params: take params) = take request
    let accept = match sim_field(wire, h, b"accept") {
        Some(take value) => std.http1.contains(value, b"application/json") && std.http1.contains(value, b"text/event-stream"),
        None => false,
    }
    if !accept {
        return (400, bad_request())
    }
    let session = sim_field(wire, h, b"mcp-session-id")
    if method == "initialize" {
        let Some(call_id) = id else {
            return (400, bad_request())
        }
        if let Some(_) = session {
            return (400, bad_request())
        }
        if let None = rpc.field_text(params, "protocolVersion") {
            return (400, bad_request())
        }
        phase = 1
        let mut result = string.from("{\"jsonrpc\":\"2.0\",\"id\":")
        string.push(mut result, sim_id(call_id))
        string.push(mut result, ",\"result\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"sim\",\"version\":\"1\"}}}")
        let mut fields = string.from("Content-Type: application/json\r\nMcp-Session-Id: ")
        string.push(mut fields, SIM_SESSION)
        string.push(mut fields, "\r\n")
        return (200, sim_reply(200, "OK", fields, result))
    }
    let Some(take presented) = session else {
        return (400, no_session())
    }
    if phase == 0 || phase == 3 || presented != string.as_bytes(SIM_SESSION) {
        return (404, sim_reply(404, "Not Found", "", ""))
    }
    if sim_field(wire, h, b"mcp-protocol-version") != Some(string.into_bytes(string.from("2025-06-18"))) {
        return (400, bad_request())
    }
    if method == "notifications/initialized" {
        if let Some(_) = id {
            return (400, bad_request())
        }
        if phase != 1 {
            return (400, bad_request())
        }
        phase = 2
        return (202, sim_reply(202, "Accepted", "", ""))
    }
    let Some(call_id) = id else {
        return (400, bad_request())
    }
    if phase != 2 || method != "tools/list" {
        return (400, bad_request())
    }
    phase = 3
    let mut event = string.from("event: message\nid: 1\ndata: {\"jsonrpc\":\"2.0\",\"id\":")
    string.push(mut event, sim_id(call_id))
    string.push(mut event, ",\"result\":{\"tools\":[{\"name\":\"echo\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"bad\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"q\":{\"type\":\"number\",\"x-mcp-header\":\"Q\"}}}}]}}\n\n")
    (200, sim_reply(200, "OK", "Content-Type: text/event-stream\r\nX-Trace: t-42\r\n", event))
}

fn sim_exchange(mut listener: Listener, until: Until, mut phase: u8, mut log: String) -> bool waits {
    let Ok((sock, _)) = host.accept(mut listener, until) else {
        return false
    }
    let (rx, tx) = net.split(take sock)
    let mut input = take rx
    let mut output = take tx
    let mut wire: Bytes = list.with_capacity(8192)
    let mut h = std.http1.head()
    loop {
        match std.http1.request(wire, mut h) {
            Complete => break,
            Partial => (),
            _ => return false,
        }
        let room = 8192 - list.len(wire)
        let Ok(got) = host.recv_bounded(mut input, mut wire, room, until) else {
            return false
        }
        if room == 0 || got == 0 {
            return false
        }
    }
    let mut length: u64 = 0
    if let Some(raw) = sim_field(wire, h, b"content-length") {
        let Ok(n) = int.parse_decimal_span(raw, 0, list.len(raw), 8192) else {
            return false
        }
        length = n
    }
    while list.len(wire) < h.end + length {
        let left = h.end + length - list.len(wire)
        let Ok(got) = host.recv_bounded(mut input, mut wire, left, until) else {
            return false
        }
        if got == 0 {
            return false
        }
    }
    let Ok(body) = string.from_utf8(std.http.copy_bytes(list.slice(wire, h.end, h.end + length))) else {
        return false
    }
    let method = match rpc.request(body) {
        Ok(rpc.Request(method: take m, ..)) => take m,
        Error(_) => string.from("?"),
    }
    let (status, response) = sim_answer(wire, h, body, mut phase)
    if string.byte_len(log) != 0 {
        string.push(mut log, ";")
    }
    string.push(mut log, method)
    string.push(mut log, " ")
    string.push_u64(mut log, int.widen(status))
    let mut sent: u64 = 0
    while sent < list.len(response) {
        let Ok(n) = host.send_pair(mut output, list.slice(response, sent, list.len(response)), b"", until) else {
            return false
        }
        if n == 0 {
            return false
        }
        sent += n
    }
    true
}

fn sim_serve(take job: Sim) -> String waits {
    let Sim(listener: take site, clock, deadline) = take job
    let until = At(clock, deadline)
    let mut listener = take site
    let mut phase: u8 = 0
    let mut log = string.new()
    for _ in 0u64 .. 5u64 {
        if !sim_exchange(mut listener, until, mut phase, mut log) {
            string.push(mut log, ";broken")
            break
        }
    }
    take log
}

fn sim_notice(notice: client.Notice) -> bool {
    true
}

// Oracle: the 2025-06-18 handshake order (initialize, then
// notifications/initialized, then requests) and its header rules, as the sim
// server enforces them; the 2026-07-28 x-mcp-header rule that a number-typed
// parameter makes the definition invalid.
@test
fn legacy_session_handshake(n: Net, c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let (site, address) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 4))
    let end = host.mono_ns(c) + 5000000000
    let server = task.spawn(tasks, bytes 262144, Sim(listener: take site, clock: c, deadline: end), sim_serve)
    let mut authority = string.from("127.0.0.1:")
    string.push_u64(mut authority, int.widen(address.port))
    let peer = client.Endpoint(address, authority: take authority, target: string.from("/mcp"), origin: string.from("http://mcp.local"), security: Plain)
    let identity = rpc.Identity(name: string.from("hirsel-test"), version: string.from("1"))
    let connected = client.connect(n, c, peer, None, identity, SIM_MEMORY, 65536, end)
    let mut problem = string.new()
    if let Ok(session) = connected {
        if client.protocol_version(session) != "2025-06-18" || client.session_id(session) != Some(SIM_SESSION) {
            problem = string.from("wrong negotiated session")
        } else {
            match client.call(n, c, peer, session, None, option.unwrap(rpc.id_value("2")), "tools/list", map.new(), SIM_MEMORY, 65536, end, sim_notice) {
                Ok(reply) => {
                    let traced = match client.reply_header(reply, "x-trace") {
                        Some(value) => value == b"t-42",
                        None => false,
                    }
                    if !traced {
                        problem = string.from("response header not visible")
                    } else if let Ok(listed) = metadata.tools(reply.body) {
                        let one_good = list.len(listed.tools) == 1 && metadata.tool_name(listed.tools[0]) == "echo"
                        let one_bad = list.len(listed.rejected) == 1 && listed.rejected[0].tool == Some("bad") && listed.rejected[0].field == "inputSchema.properties.q.x-mcp-header"
                        if !one_good || !one_bad {
                            problem = string.from("malformed tool not reported by name and field")
                        }
                    } else {
                        problem = string.from("tools/list result refused")
                    }
                },
                Error(_) => {
                    problem = string.from("tools/list failed")
                },
            }
            if string.byte_len(problem) == 0 {
                match client.call(n, c, peer, session, None, option.unwrap(rpc.id_value("3")), "tools/list", map.new(), SIM_MEMORY, 65536, end, sim_notice) {
                    Error(SessionExpired) => (),
                    _ => {
                        problem = string.from("404 on the session was not SessionExpired")
                    },
                }
            }
        }
    } else {
        problem = string.from("connect failed")
    }
    let log = result.unwrap(task.join(take server))
    if string.byte_len(problem) != 0 {
        fail(take problem)
    }
    if log != "server/discover 400;initialize 200;notifications/initialized 202;tools/list 200;tools/list 404" {
        fail(take log)
    }
    Ok(())
}

const LEGACY_INITIALIZE: String = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"ExampleClient\",\"version\":\"1.0.0\"}}}"

const LEGACY_INITIALIZED: String = "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"

const LEGACY_WEATHER: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"get_weather\",\"arguments\":{\"location\":\"New York\"}}}"

const MODERN_WEATHER: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"get_weather\",\"arguments\":{\"location\":\"New York\"},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientInfo\":{\"name\":\"ExampleClient\",\"version\":\"1.0.0\"},\"io.modelcontextprotocol/clientCapabilities\":{}}}}"

const WEATHER_TEXT: String = "Current weather in New York:\nTemperature: 72°F\nConditions: Partly cloudy"

type WeatherInput: codec {
    location: String
}

fn weather(mut call: server.Call, c: Clock, mut ctx: ()) -> server.Step {
    let args = result.unwrap(rpc.object(call.arguments))
    if rpc.field_text(args, "location") != Some("New York") {
        return ToolError(string.from("expected New York"))
    }
    Text(string.from(WEATHER_TEXT))
}

type LiveServer: send {
    listener: Listener,
    clock: Clock,
    tasks: Tasks,
    registry: sessions.Registry,
    stop: Receiver[u64]
}

type FixtureContext: send {
    directory: Dir,
    path: String,
    ready: bool
}

fn read_fixture(ctx: FixtureContext) -> Result[String, ()] waits {
    let mut input = std.file.open(ctx.directory, ctx.path, Read) ?=> |_| ()
    let mut buffer: Bytes = list.with_capacity(128)
    loop {
        let read = std.file.read_into(mut input, mut buffer) ?=> |_| ()
        if read == 0 {
            break
        }
        if list.len(buffer) == list.capacity(buffer) {
            return Error(())
        }
    }
    std.file.close(take input) ?=> |_| ()
    Ok(string.from_utf8(take buffer) ?=> |_| ())
}

fn fixture_weather(mut call: server.Call, c: Clock, mut ctx: FixtureContext) -> server.Step waits {
    if !ctx.ready {
        ctx.ready = true
        return Progress(1, Some(2), None)
    }
    match read_fixture(ctx) {
        Ok(take text) => Text(take text),
        Error(_) => ToolError(string.from("fixture read failed")),
    }
}

fn serve_fixture(take job: (LiveServer, Dir)) waits {
    let (take live, directory) = take job
    let make: scoped[view] fn() -> FixtureContext = fn() -> FixtureContext {
        FixtureContext(directory, path: string.from("weather.txt"), ready: false)
    }
    serve_weather_with(take live, fixture_weather, 4096, make)
}

fn live_config() -> std.http.Config {
    let mut cfg = std.http.defaults()
    cfg.sockets_max = 4
    cfg.http_max = 4
    cfg.conns_max = 4
    cfg.ip_sockets_max = 4
    cfg.streams_max = 1
    cfg.heartbeat_ms = 1000
    cfg.lease_ms = 5000
    take cfg
}

fn serve_weather(take job: LiveServer) waits {
    serve_weather_with(take job, weather, 0, fn() {})
}

fn serve_weather_with[Ctx: send](take job: LiveServer, handler: fn(mut server.Call, Clock, mut Ctx) -> server.Step waits, context_bytes: u64, make: scoped[view] fn() -> Ctx) waits {
    let LiveServer(listener: take listener, clock, tasks, registry: take registry, stop: take stop) = take job
    let mut listeners: List[Listener] = list.new()
    list.push(mut listeners, take listener)
    let format: std.json.Format[WeatherInput] = result.unwrap(std.json.interop())
    let schema = result.unwrap(server.schema(format, list.new()))
    let mut tools: List[server.Tool[Ctx]] = list.new()
    list.push(mut tools, server.Tool(name: string.from("get_weather"), description: string.from("Get current weather"), input_schema: take schema, call: handler))
    let identity = rpc.Identity(name: string.from("ExampleServer"), version: string.from("1.0.0"))
    let state = server.Server(identity: take identity, origins: list.new(), tools: Fixed(take tools), resources: list.new(), event_max: 4096, producer_bytes: 65536, producer_steps: 1000000)
    let mut routes: std.router.Builder[server.Endpoint[Ctx]] = std.router.builder()
    result.unwrap(server.mount(mut routes, "/mcp", 8192, 262144))
    result.unwrap(server.serve(take listeners, clock, tasks, live_config(), result.unwrap(std.router.build(take routes)), take state, take registry, 4096, context_bytes, make, Some(take stop)))
}

type WirePeer {
    net: Net,
    clock: Clock,
    address: Addr,
    authority: String,
    deadline: u64
}

type WireReply {
    status: u16,
    session: Option[String],
    media: Option[String],
    body: String
}

fn wire_header(mut fields: List[std.http_client.Header], name: String, value: String) {
    let value_bytes = std.http.copy_bytes(string.as_bytes(value))
    list.push(mut fields, std.http_client.Header(name: string.from(name), value: Public(take value_bytes)))
}

fn wire_request(peer: WirePeer, method: String, payload: String, version: Option[String], session: Option[String], modern: bool) -> WireReply waits {
    let mut headers: List[std.http_client.Header] = list.new()
    wire_header(mut headers, "Connection", "close")
    wire_header(mut headers, "Accept", "application/json, text/event-stream")
    if method == "POST" {
        wire_header(mut headers, "Content-Type", "application/json")
    }
    if let Some(value) = version {
        wire_header(mut headers, "MCP-Protocol-Version", value)
    }
    if let Some(value) = session {
        wire_header(mut headers, "Mcp-Session-Id", value)
    }
    if modern {
        wire_header(mut headers, "Mcp-Method", "tools/call")
        wire_header(mut headers, "Mcp-Name", "get_weather")
    }
    let request = std.http_client.Request(method: string.from(method), target: string.from("/mcp"), headers: take headers, body: Fixed(string.byte_len(payload)))
    let mut connection = result.unwrap(std.http_client.dial(peer.net, peer.address, peer.authority, peer.clock, take request, peer.deadline))
    if payload != "" {
        result.unwrap(std.http_client.write(mut connection, string.as_bytes(payload)))
    }
    result.unwrap(std.http_client.finish_request(mut connection, 8192))
    let mut assigned: Option[String] = None
    let mut media: Option[String] = None
    let status = scoped fn() -> u16 {
        let head = std.http_client.head(connection)
        for i in 0u64 .. std.http_client.field_count(head) {
            let (name, value) = option.unwrap(std.http_client.field_at(head, i))
            if std.http1.equal_ascii(name, b"mcp-session-id") {
                assigned = Some(result.unwrap(string.from_utf8(std.http.copy_bytes(value))))
            }
            if std.http1.equal_ascii(name, b"content-type") {
                media = Some(result.unwrap(string.from_utf8(std.http.copy_bytes(value))))
            }
        }
        std.http_client.status(head)
    }
    let code = status()
    let mut body: Bytes = list.with_capacity(8192)
    while result.unwrap(std.http_client.read(mut connection, mut body)) != 0 {}
    WireReply(status: code, session: take assigned, media: take media, body: result.unwrap(string.from_utf8(take body)))
}

fn open_weather_session(peer: WirePeer, request: String, expected_version: String) -> String waits {
    let opened = wire_request(peer, "POST", request, None, None, false)
    if opened.status != 200 || opened.media != Some("application/json") {
        fail("initialize did not return a JSON HTTP 200")
    }
    let Reply(id, take value) = result.unwrap(rpc.incoming(opened.body)) else {
        fail("initialize did not return a JSON-RPC result")
    }
    let init = result.unwrap(rpc.object(value))
    let chosen = option.unwrap(rpc.field_text(init, "protocolVersion"))
    if !rpc.same_id(id, IntegerId(string.from("1"))) || chosen != expected_version {
        fail("initialize returned the wrong ID or negotiated version")
    }
    let Some(raw_caps) = map.get(init, "capabilities") else {
        fail("initialize omitted capabilities")
    }
    let Some(raw_info) = map.get(init, "serverInfo") else {
        fail("initialize omitted server info")
    }
    let caps = result.unwrap(rpc.object(raw_caps))
    let info = result.unwrap(rpc.object(raw_info))
    if map.get(caps, "tools") != Some("{}") || rpc.field_text(info, "name") != Some("ExampleServer") || rpc.field_text(info, "version") != Some("1.0.0") {
        fail("initialize returned the wrong capabilities or server identity")
    }
    let WireReply(session: take assigned, ..) = take opened
    let session = option.unwrap(take assigned)
    if session == "" {
        fail("initialize returned an empty session ID")
    }
    for byte in string.as_bytes(session) {
        if byte < 0x21 || byte > 0x7e {
            fail("initialize returned a non-visible-ASCII session ID")
        }
    }
    take session
}

fn expect_weather(reply: WireReply, modern: bool, expected: String, progress: bool) {
    if reply.status != 200 || reply.media != Some("text/event-stream") || reply.session != None {
        fail("tools/call did not return HTTP 200 and SSE without a session header")
    }
    let mut decoder = std.sse.decoder(8192)
    let mut events: List[String] = list.new()
    let _ = result.unwrap(std.sse.feed(mut decoder, string.as_bytes(reply.body), fn(name: Bytes, data: Bytes, event_id: Bytes) -> std.sse.FeedControl[()] {
        if name == b"message" && list.len(data) != 0 {
            list.push(mut events, result.unwrap(string.from_utf8(std.http.copy_bytes(data))))
        }
        Continue
    }))
    let result_at = if progress {
        if list.len(events) != 2 {
            fail("expected one progress notification and one tool result")
        }
        let Notification(method, params) = result.unwrap(rpc.incoming(events[0])) else {
            fail("expected a progress notification before the tool result")
        }
        if method != "notifications/progress" || rpc.field_text(params, "progressToken") != Some("fixture") || map.get(params, "progress") != Some("1") || map.get(params, "total") != Some("2") {
            fail("tools/call returned the wrong progress")
        }
        1u64
    } else {
        if list.len(events) != 1 {
            fail("expected one tool result")
        }
        0u64
    }
    let Reply(id, take value) = result.unwrap(rpc.incoming(events[result_at])) else {
        fail("tools/call did not return a JSON-RPC result")
    }
    let fields = result.unwrap(rpc.object(value))
    if !rpc.same_id(id, IntegerId(string.from("2"))) || (modern && rpc.field_text(fields, "resultType") != Some("complete")) {
        fail("tools/call returned the wrong ID or result type")
    }
    if let Some(failed) = map.get(fields, "isError") {
        if failed != "false" {
            fail("tools/call reported an error")
        }
    }
    let Some(raw) = map.get(fields, "content") else {
        fail("tools/call omitted content")
    }
    let format: std.json.Format[List[Map[String, String]]] = result.unwrap(std.json.interop())
    let items = result.unwrap(std.json.decode_typed(format, std.http.copy_bytes(string.as_bytes(raw)), 4096))
    if list.len(items) != 1 || map.get(items[0], "type") != Some("text") || option.unwrap(map.get(items[0], "text")) != expected {
        fail("tools/call did not return the expected weather content")
    }
}

// Oracle: 2025-06-18 Initialization, 2025-11-25 Streamable HTTP Session Management,
// and the New York tools/call examples in both 2025-06-18 and 2026-07-28.
@test
fn server_session_and_per_request(n: Net, c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let (listener, address) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 4))
    let end = std.clock.deadline_after_ms(host.mono_ns(c), 5000)
    let mut authority = string.from("127.0.0.1:")
    string.push_u64(mut authority, int.widen(address.port))
    let peer = WirePeer(net: n, clock: c, address, authority: take authority, deadline: end)
    let (session_clock, take hand) = provide.clock(0, 0)
    let mut time = take hand
    let (take registry, owner) = result.unwrap(sessions.start(tasks, session_clock, provide.random(17), 1, 1000))
    let (stop, stopping): (Sender[u64], Receiver[u64]) = channel.new(1)
    let live = LiveServer(listener: take listener, clock: c, tasks, registry: take registry, stop: take stopping)
    let running = task.spawn(tasks, bytes 16777216, take live, serve_weather)
    let legacy = Some("2025-06-18")
    let id = open_weather_session(peer, LEGACY_INITIALIZE, "2025-06-18")
    let session = Some(string.from(id))
    let before = wire_request(peer, "POST", LEGACY_WEATHER, legacy, session, false)
    if before.status != 400 {
        fail("tools/call ran before notifications/initialized")
    }
    let ready = wire_request(peer, "POST", LEGACY_INITIALIZED, legacy, session, false)
    if ready.status != 202 || ready.body != "" {
        fail("notifications/initialized did not return an empty HTTP 202")
    }
    expect_weather(wire_request(peer, "POST", LEGACY_WEATHER, legacy, session, false), false, WEATHER_TEXT, false)
    expect_weather(wire_request(peer, "POST", MODERN_WEATHER, Some("2026-07-28"), None, true), true, WEATHER_TEXT, false)
    let wrong = wire_request(peer, "POST", LEGACY_WEATHER, legacy, Some("unknown-session"), false)
    if wrong.status != 404 {
        fail("unknown session did not get HTTP 404")
    }
    let ended = wire_request(peer, "DELETE", "", legacy, session, false)
    if ended.status != 204 || ended.body != "" {
        fail("DELETE did not end the session")
    }
    if wire_request(peer, "POST", LEGACY_WEATHER, legacy, session, false).status != 404 {
        fail("the deleted session was accepted")
    }
    let next = open_weather_session(peer, LEGACY_INITIALIZE, "2025-06-18")
    if next == id {
        fail("a new handshake reused a session ID")
    }
    clock.advance_to(mut time, 1000000000)
    if wire_request(peer, "POST", LEGACY_WEATHER, legacy, Some(next), false).status != 404 {
        fail("the expired session was accepted")
    }
    result.unwrap(channel.send(stop, end))
    result.unwrap(task.join(take running))
    result.unwrap(task.join(take owner))
    Ok(())
}

@test
fn tool_context_reads_fixture(n: Net, c: Clock, tasks: Tasks, directory: Dir) -> Result[(), ()] waits {
    let expected = "Weather from the test directory\n"
    let mut file = result.unwrap(std.file.open(directory, "weather.txt", CreateNew))
    result.unwrap(std.file.write_all(mut file, string.as_bytes(expected)))
    result.unwrap(std.file.close(take file))
    let (listener, address) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 4))
    let end = std.clock.deadline_after_ms(host.mono_ns(c), 5000)
    let mut authority = string.from("127.0.0.1:")
    string.push_u64(mut authority, int.widen(address.port))
    let peer = WirePeer(net: n, clock: c, address, authority: take authority, deadline: end)
    let (take registry, owner) = result.unwrap(sessions.start(tasks, c, provide.random(17), 1, 1000))
    let (stop, stopping): (Sender[u64], Receiver[u64]) = channel.new(1)
    let live = LiveServer(listener: take listener, clock: c, tasks, registry: take registry, stop: take stopping)
    let running = task.spawn(tasks, bytes 16777216, (take live, directory), serve_fixture)
    let request = std.string.replace(MODERN_WEATHER, "\"_meta\":{", "\"_meta\":{\"progressToken\":\"fixture\",")
    expect_weather(wire_request(peer, "POST", request, Some("2026-07-28"), None, true), true, expected, true)
    result.unwrap(channel.send(stop, end))
    result.unwrap(task.join(take running))
    result.unwrap(task.join(take owner))
    Ok(())
}

// END
/// Joins parts with sep between successive strings. Fails: Capacity.
pub fn join(parts: List[String], sep: String) -> String {
    let mut out = string.new()
    for i in 0 .. list.len(parts) {
        if i != 0 {
            string.push(mut out, sep)
        }
        string.push(mut out, parts[i])
    }
    take out
}

/// Replaces every leftmost non-overlapping occurrence of pat. An empty
/// pattern inserts replacement at every scalar boundary, including the ends.
pub fn replace(s: String, pat: String, replacement: String) -> String {
    let mut out = string.new()
    let n = string.byte_len(s)
    let m = string.byte_len(pat)
    let mut at: u64 = 0
    if m == 0 {
        string.push(mut out, replacement)
        while let Some((_, next)) = string.next_scalar(s, at) {
            string.push(mut out, string.slice(s, at, next))
            string.push(mut out, replacement)
            at = next
        }
    } else {
        while let Some(found) = find(s, at, pat) {
            string.push(mut out, string.slice(s, at, found))
            string.push(mut out, replacement)
            at = found + m
        }
        string.push(mut out, string.slice(s, at, n))
    }
    take out
}

type ReleaseExport: codec + send {
    described: Described,
    args_fp: u64,
    result_fp: u64,
    revision: Bytes
}

type ReleaseIdentity: codec + send {
    revision: Bytes,
    n_place: u64,
    exported: List[ReleaseExport],
    bindings: List[HttpDescribe],
    slots: List[List[SlotSchema]],
}

fn release_exports(exported: List[Exported]) -> List[ReleaseExport] {
    let mut entries: List[ReleaseExport] = list.with_capacity(list.len(exported))
    for entry in exported {
        list.push(mut entries, ReleaseExport(described: clone(entry.described), args_fp: entry.args_fp, result_fp: entry.result_fp, revision: clone(entry.revision)))
    }
    take entries
}

pub fn identity_digest(description: Describe) -> Result[Bytes, RegisterError] {
    if list.len(description.revision) != 32u64 {
        return Error(Bounds)
    }
    let mut slot_schemas: List[List[SlotSchema]] = list.with_capacity(list.len(description.exported))
    for export in description.exported {
        list.push(mut slot_schemas, clone(export.slots))
    }
    let identity = ReleaseIdentity(revision: clone(description.revision), n_place: description.n_place, exported: release_exports(description.exported), bindings: clone(description.bindings), slots: take slot_schemas)
    let codec: std.codec.Codec[ReleaseIdentity] = std.codec.of()
    let mut payload: Bytes = list.new()
    std.codec.encode(codec, identity, mut payload) ?=> |_| Bounds
    let mut hash = std.sha256.start()
    let domain = string.as_bytes("hirsel.identity.v1")
    std.sha256.add_byte(mut hash, 18u8)
    std.sha256.add(mut hash, domain, 0u64, list.len(domain))
    std.sha256.add(mut hash, payload, 0u64, list.len(payload))
    let digest = std.sha256.finish(hash)
    let mut out: Bytes = list.with_capacity(32u64)
    for byte in digest {
        list.push(mut out, byte)
    }
    Ok(take out)
}

pub fn decode_description(raw: Bytes) -> Option[Describe] {
    let codec: std.codec.Codec[Describe] = std.codec.of()
    match std.codec.decode(codec, raw) {
        Ok(take description) => Some(take description),
        Error(_) => None,
    }
}

pub type ReleaseRecord: codec + send {
    release: Bytes,
    digest: Bytes,
    binding: Bytes,
    n_place: u64,
    prepared: Bytes
}

pub type PlaceClaim: codec + send {
    epoch: u64,
    holder: Bytes,
    attempt: Bytes
}

pub type PlaceRead: codec + send {
    store_hi: u64,
    store_lo: u64,
    binding: Bytes,
    n_place: Option[u64],
    prepared: Bytes,
    witness_present: bool,
    claim: Option[PlaceClaim],
}

fn release_record(db: store.Db, version: u64) -> Result[Option[ReleaseRecord], store.Error] waits {
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    let table = store.system_table(db, "hirsel.runner.releases", std.codec.key_u64(), codec)?
    store.get(result.unwrap(store.reader(db, store.READER_PIN_MIN)), store.snapshot(db), table, version)
}

// Call under the open store's lock. A failed capture leaves the refusal useful
// as a start outcome, but supplies no evidence for a recovery decision.
fn capture_release(db: store.Db, version: u64, witness: u64) -> Result[Bytes, store.Error] waits {
    let Some(current) = release_record(db, version)? else {
        return Error(Missing("activation release"))
    }
    let (present, take prepared): (bool, Bytes) = if witness == 0u64 {
        (false, list.new())
    } else if witness == version {
        (true, clone(current.prepared))
    } else {
        match release_record(db, witness)? {
            Some(record) => (true, clone(record.prepared)),
            None => (false, list.new())
        }
    }
    // `None` only for a backing without a claim (`Missing("head")`); the
    // empty attempt only for a genesis head, which carries no ORIGIN. Any
    // other failure is an error, never evidence for recovery.
    let claim: Option[PlaceClaim] = match store.claim_of(db) {
        Ok(store.Claim(epoch, holder: take holder)) => {
            let attempt: Bytes = match store.origin_of(db)? {
                Some(store.Origin(attempt: take a, ..)) => take a,
                None => list.new(),
            }
            Some(PlaceClaim(epoch, holder: take holder, attempt: take attempt))
        },
        Error(Missing(what)) if what == "head" => None,
        Error(take problem) => return Error(take problem),
    }
    let (hi, lo) = store.identity_words(db)
    let read = PlaceRead(store_hi: hi, store_lo: lo, binding: clone(current.binding), n_place: Some(current.n_place), prepared: take prepared, witness_present: present, claim: take claim)
    encode_place_read(read)
}

fn encode_place_read(read: PlaceRead) -> Result[Bytes, store.Error] {
    let mut raw: Bytes = list.new()
    let codec: std.codec.Codec[PlaceRead] = std.codec.of()
    std.codec.encode(codec, read, mut raw) ?=> |_| Limit(Value)
    Ok(take raw)
}

pub fn follower_release(f: store.Follower, witness: u64) -> Result[(u64, Bytes), store.Error] waits {
    let (version, take read, _) = read_follower_release(f, witness)?
    Ok((version, encode_place_read(read)?))
}

fn follower_description(f: store.Follower, read_handle: store.Reader, captured: store.Snapshot, binding: Bytes) -> Result[(Option[Bytes], Option[u64]), store.Error] waits {
    let mut declaration = store.declare_follower(f)
    let table = store.declare_activation_table(mut declaration)?
    let Some(take raw) = store.get(read_handle, captured, table, 0u8)? else {
        return Ok((None, None))
    }
    let Some(decoded) = decode_description(raw) else {
        return Ok((None, None))
    }
    let Ok(actual) = identity_digest(decoded) else {
        return Ok((None, None))
    }
    if actual != binding {
        return Ok((None, None))
    }
    Ok((Some(take raw), Some(decoded.n_place)))
}

fn read_follower_release(f: store.Follower, witness: u64) -> Result[(u64, PlaceRead, Option[Bytes]), store.Error] waits {
    let current = store.follower_head(f)?
    let Some(main_branch) = store.follower_branch(f, "main") else {
        return Error(Missing("main"))
    }
    let captured = store.snapshot_follower(f, main_branch)?
    let read_handle = store.follower_reader(f, store.READER_PIN_MIN)?
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    let mut declaration = store.declare_follower(f)
    let releases = store.declare_release_table(mut declaration, codec)?
    let Some(release) = store.get(read_handle, captured, releases, current.activation)? else {
        return Error(Missing("activation release"))
    }
    if release.binding != current.binding {
        return Error(NotCurrent(current.activation))
    }
    let (present, take prepared): (bool, Bytes) = if witness == 0 {
        (false, list.new())
    } else if witness == current.activation {
        (true, clone(release.prepared))
    } else {
        match store.get(read_handle, captured, releases, witness)? {
            Some(record) => (true, clone(record.prepared)),
            None => (false, list.new()),
        }
    }
    let (take description, n_place) = follower_description(f, read_handle, captured, current.binding)?
    let store.HeadView(binding: take binding, claim: store.Claim(epoch, holder: take holder), origin: take origin, store: id, activation, ..) = take current
    let attempt: Bytes = match take origin {
        Some(store.Origin(attempt: take a, ..)) => take a,
        None => list.new(),
    }
    let read = PlaceRead(store_hi: id.hi, store_lo: id.lo, binding: take binding, n_place, prepared: take prepared, witness_present: present, claim: Some(PlaceClaim(epoch, holder: take holder, attempt: take attempt)))
    Ok((activation, take read, take description))
}

fn bucket_not_current(take authority: store.Authority, plan: store.FollowerPlan, tasks: Tasks, clock: Clock, expect: Option[store.StoreId], activation: u64, op_ms: u64) -> OpenError waits {
    let read = capture_follower(take authority, plan, tasks, clock, expect, launch_env().witness, op_ms)
    match take read {
        Ok((version, take description, take report)) => NotCurrent(Active(version, take description, take report)),
        Error(_) => NotCurrent(Active(activation, list.new(), list.new())),
    }
}

fn capture_follower(take authority: store.Authority, plan: store.FollowerPlan, tasks: Tasks, clock: Clock, expect: Option[store.StoreId], witness: u64, op_ms: u64) -> Result[(u64, Bytes, Bytes), store.Error] waits {
    let budget = {
        let mut plans: List[store.FollowerPlan] = list.with_capacity(1u64)
        list.push(mut plans, clone(plan))
        option.unwrap(store.service_bytes(plans))
    }
    let service = store.follower_service(tasks, budget)?
    let captured = capture_with_service(take authority, plan, service, clock, expect, witness, op_ms)
    store.close_follower_service(take service)?
    take captured
}

fn capture_with_service(take authority: store.Authority, plan: store.FollowerPlan, service: store.FollowerService, clock: Clock, expect: Option[store.StoreId], witness: u64, op_ms: u64) -> Result[(u64, Bytes, Bytes), store.Error] waits {
    let owner = store.follower_owner(service)?
    let reserved_slot = store.follower_slot(owner, plan)?
    let mut source = store.followers()
    let mut follower = store.follower(mut source, take reserved_slot, take authority, clock, expect)?
    let _ = store.fresh(mut follower, std.clock.deadline_after_ms(host.mono_ns(clock), op_ms))?
    let (version, take product, take description) = read_follower_release(follower, witness)?
    let selected: Bytes = match take description {
        Some(take raw) => take raw,
        None => list.new()
    }
    Ok((version, take selected, encode_place_read(product)?))
}

fn not_current_activation(db: store.Db, version: u64, take description: Bytes) -> OpenError waits {
    let read = match capture_release(db, version, launch_env().witness) {
        Ok(take raw) => take raw,
        Error(_) => list.new(),
    }
    NotCurrent(Active(version, take description, take read))
}

// `tables` is Describe's diagnostic list (not in the identity). A prepared
// target carries the preview's exact Describe, so prepare passes the list that
// describe mode reports; the other activations record none.
fn prepare_activation[G: send, H: shareable + inert + send](r: Registry[G, H], n_place: u64, take tables: List[store.DeclaredCollection]) -> Result[(Bytes, ReleaseRecord), RegisterError] {
    let release = http_release_digest(r.t.exported, r.t.bindings) ?=> |_| Bounds
    let launch = launch_env()
    let image = launch_bytes(launch.digest)
    let target = owned_launch_target(launch.target)
    let description = Describe(digest: take image, target: take target, n_place: n_place, revision: launch_bytes(launch.revision), exported: clone(r.t.exported), tables: take tables, bindings: clone(r.t.bindings))
    let binding: Bytes = if launch.revision.size == 0u64 {
        list.new()
    } else {
        identity_digest(description)?
    }
    let payload = encode_describe(description) ?=> |_| Bounds
    let Describe(digest: take digest, ..) = take description
    Ok((take payload, ReleaseRecord(release: take release, digest: take digest, binding: take binding, n_place: n_place, prepared: list.new())))
}

fn trigger_stamp(exported: List[Exported], bindings: List[HttpDescribe], n_place: u64) -> Result[Bytes, store.Error] {
    let entry = launch_env().revision
    if entry.size == 0u64 {
        return Ok(list.new())
    }
    let revision = launch_bytes(entry)
    let identity = Describe(digest: list.new(), target: string.new(), n_place: n_place, revision: take revision, exported: clone(exported), tables: list.new(), bindings: clone(bindings))
    Ok(identity_digest(identity) ?=> |_| Limit(Value))
}

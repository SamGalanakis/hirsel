// Module `float` (SEM-2).

pub fn mul_add[F: float](a: F, b: F, c: F) -> F
pub fn total_order[F: float](a: F, b: F) -> Order
pub fn to_int[F: float, I: integer](x: F) -> Result[I, FloatError]
pub fn from_int[I: integer, F: float](x: I) -> F
pub fn widen(x: f32) -> f64
pub fn narrow(x: f64) -> f32
pub fn to_bits32(x: f32) -> u32
pub fn to_bits64(x: f64) -> u64
pub fn from_bits32(b: u32) -> f32
pub fn from_bits64(b: u64) -> f64

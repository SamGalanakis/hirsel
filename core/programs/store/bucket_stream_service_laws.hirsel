// L90 laws for the host stream's service and streamed genesis (STORE-SPEC
// §12.11.1, §12.11.5, §12.11.14). Each expected request is the spec's
// schedule, written out here, never the run's own log.
// The stream root of these laws, under a service client with prefix "".
const STREAM_SERVICE_ROOT: String = "streams"

fn stream_limits() -> StreamLimits {
    StreamLimits(max_slots: 512, max_pins: 4096, hold_ms: 2000, idle_poll_ms: 1000, index_every: 512, pin_ttl_s: 86400, slot_bytes: 65536)
}

fn stream_service_plan(max_slots: u32) -> StreamPlan {
    let mut limits = stream_limits()
    limits.max_slots = max_slots
    // BUCKET_LAW_OP_MS is 30 s, so hold_ms is its floor, 4 x 30 s.
    limits.hold_ms = 120000
    StreamPlan(sid: stream_law_sid(), prefix: string.from(STREAM_SERVICE_ROOT), batching: Batching(max_wait_ms: 0, max_batch_bytes: FRAME_LIMIT + 4096), limits: take limits)
}

fn stream_service_budget(plan: StreamPlan) -> u64 {
    stream_service_bytes(plan)
}

fn stream_service_client(s: BucketSim, tasks: Tasks, seed: u64, key_prefix: String, zone: String) -> Result[std.object.Client, Error] waits {
    stream_endpoint_client(s.endpoint, s.time, tasks, seed, key_prefix, zone)
}

fn stream_endpoint_client(endpoint: std.sim.s3.Endpoint, time: Clock, tasks: Tasks, seed: u64, key_prefix: String, zone: String) -> Result[std.object.Client, Error] waits {
    let secret_bytes = string.into_bytes(string.from("wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"))
    let root = result.unwrap(secret.seal(take secret_bytes, "kdf"))
    let credentials_set = std.cred.from_secret("AKIAIOSFODNN7EXAMPLE", take root, "")
    let deadline = std.clock.deadline_after_ms(host.mono_ns(time), BUCKET_LAW_OP_MS)
    let mut place = bucket_law_place("s3.test")
    place.prefix = string.from(key_prefix)
    // Only bucket.s3.test resolves in the simulation, so the law's other
    // place is the same bucket name in another region.
    place.aws_region = string.from(zone)
    let random = provide.random(seed)
    match std.object.start_simulated(endpoint, tasks, take place, take credentials_set, time, random, bucket_law_lanes(0), deadline) {
        Ok(take client) => Ok(take client),
        Error(take e) => Error(Remote(take e)),
    }
}

fn stream_service_start(s: BucketSim, tasks: Tasks, c: Clock, r: Random, plan: StreamPlan) -> Result[JournalService, Error] waits {
    let client = stream_service_client(s, tasks, 81, "", "us-east-1")?
    let authority = object_authority(take client, "bucket", BUCKET_LAW_OP_MS)
    Ok(journal_service(tasks, take authority, plan, stream_service_budget(plan), s.time, r) ?=> |Refusal(error: take problem, ..)| take problem)
}

fn stream_service_marker(s: BucketSim, tasks: Tasks, take key: String) -> Result[(), Error] waits {
    let mut client = stream_service_client(s, tasks, 99, "", "us-east-1")?
    let mut raw: Bytes = list.with_capacity(64)
    match history_fetch(mut client, key, mut raw, std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)) {
        Error(Remote(NotFound)) => Ok(()),
        _ => fail("a marker key was found"),
    }
}

fn stream_service_key(take name: String) -> String {
    let mut key = string.from(STREAM_SERVICE_ROOT)
    string.push_char(mut key, '/')
    string.push(mut key, stream_dir(stream_law_sid()))
    string.push(mut key, name)
    take key
}

type ServiceStep {
    method: String,
    key: String,
    exact: bool,
    status: u16
}

fn service_step(take method: String, take key: String, exact: bool, status: u16) -> ServiceStep {
    ServiceStep(method: take method, key: take key, exact, status)
}

// The §12.11.5, §12.11.4, §12.11.11 and §12.11.13 schedule from the Place's
// first request: genesis with no 5a probes and no CLAIM entry, the CLAIM's
// batch and its `reg` GET before open returns, then per commit one batch create
// and one `reg` GET and no head write; three idle `reg` GETs over 3.5 s with
// no Place idle head GET; then close's settle reading the batches, writing one
// GROUP entry and one head write that drops ATTACH (2 A).
fn stream_service_expected(commits: u64) -> List[ServiceStep] {
    let mut steps: List[ServiceStep] = list.new()
    list.push(mut steps, service_step("GET", "p1/head", true, 404))
    list.push(mut steps, service_step("LIST", "", true, 200))
    list.push(mut steps, service_step("PUT", "p1/m-00000000000000000001-", false, 200))
    list.push(mut steps, service_step("PUT", "p1/e-00000000000000000001-", false, 200))
    list.push(mut steps, service_step("PUT", "p1/head", true, 200))
    list.push(mut steps, service_step("PUT", stream_service_key("b-00000000000000000001-00000000000000000001"), true, 200))
    list.push(mut steps, service_step("GET", stream_service_key("reg"), true, 200))
    list.push(mut steps, service_step("GET", "marker-1", true, 404))
    for k in 0u64 .. commits {
        let mut name = string.with_capacity(48)
        format.stream_batch_key(mut name, 1, k + 2)
        list.push(mut steps, service_step("PUT", stream_service_key(take name), true, 200))
        list.push(mut steps, service_step("GET", stream_service_key("reg"), true, 200))
    }
    list.push(mut steps, service_step("GET", "marker-2", true, 404))
    // Three idle `reg` polls over 3.5 s (idle_poll_ms = 1,000 ms), zero head GETs.
    for _ in 0u64 .. 3 {
        list.push(mut steps, service_step("GET", stream_service_key("reg"), true, 200))
    }
    list.push(mut steps, service_step("GET", "marker-3", true, 404))
    // Close settle: reads each commit batch of the live tail (INDEX + slice),
    // writes 1 GROUP entry and 1 head PUT dropping ATTACH (2 A).
    for k in 0u64 .. commits {
        let mut name = string.with_capacity(48)
        format.stream_batch_key(mut name, 1, k + 2)
        let key = stream_service_key(take name)
        list.push(mut steps, service_step("GET", clone(key), true, 206))
        list.push(mut steps, service_step("GET", take key, true, 206))
    }
    list.push(mut steps, service_step("PUT", "p1/e-00000000000000000002-", false, 200))
    list.push(mut steps, service_step("PUT", "p1/head", true, 200))
    take steps
}

// The streamed-genesis law (§12.11.5) with L90-K's per-batch cost
// (§12.11.14) and no idle head poll (§12.11.13). Red for a genesis that
// probes 5a or writes a CLAIM entry, an open that returns before its CLAIM
// batch is decided, a commit that writes the head or an entry, or an
// attached Place that keeps its head poll.
@test
fn bucket_stream_streamed_genesis(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 83, None, list.new())
    let mut plan = stream_service_plan(4)
    // One row: 104 bytes for HEADER and INDEX, 68 for the row, 48 for FOOTER.
    plan.batching.max_batch_bytes = small_place_limits().frame + 104 + 68 + 48
    let outcome = stream_service_genesis_run(s, tasks, c, r, plan, 2)
    let report = bucket_law_report(take s)
    outcome?
    let expected = stream_service_expected(2)
    let mut from = list.len(report.requests)
    for i in 0u64 .. list.len(report.requests) {
        if string.starts_with(report.requests[i].key, "p1/") {
            from = i
            break
        }
    }
    if list.len(report.requests) - from != list.len(expected) {
        fail("the streamed Place sent other than §12.11.5's and §12.11.4's requests")
    }
    for i in 0u64 .. list.len(expected) {
        let want = expected[i]
        let got = report.requests[from + i]
        let key_ok = if want.exact {
            got.key == want.key
        } else {
            string.starts_with(got.key, want.key)
        }
        if got.method != want.method || !key_ok || got.status != want.status {
            fail("the streamed Place sent other than §12.11.5's and §12.11.4's requests")
        }
    }
    if list.len(report.head_writes) != 2 {
        fail("expected genesis head write and close settle head write")
    }
    let (_, take attach) = history_decode_head_attach(report.head_writes[0u64].data)?
    let Some(a) = attach else {
        fail("the streamed genesis head has no ATTACH")
    }
    let Some(tail) = a.live else {
        fail("the streamed genesis head names no live tail")
    }
    // Incarnation 1 is the stream's first election; its first batch is seq 1.
    if a.settles != 0 || list.len(a.sealed) != 0 || !format.stream_same(tail.sid, host_stream_id_to_rep(stream_law_sid())) || tail.inc != 1 || tail.from_seq != 1 || tail.from_frame != 0 {
        fail("the streamed genesis ATTACH is not {0, (S, 1, (1, 0)), []}")
    }
    let (_, take closed_attach) = history_decode_head_attach(report.head_writes[1u64].data)?
    if let Some(_) = closed_attach {
        fail("the close settle head still carries ATTACH")
    }
    Ok(())
}

fn stream_service_genesis_run(s: BucketSim, tasks: Tasks, c: Clock, r: Random, plan: StreamPlan, commits: u64) -> Result[(), Error] waits {
    let mut service = stream_service_start(s, tasks, c, r, plan)?
    let slot = journal_slot(mut service)?
    let client = stream_service_client(s, tasks, 85, "p1/", "us-east-1")?
    let attached = streamed(object_authority(take client, "bucket", BUCKET_LAW_OP_MS), take slot)?
    let mut options = bucket_order_options(true)
    options.head_poll_ms = 1000
    options.limits = Some(small_place_limits())
    let mut db = open_authority(tasks, take attached, s.time, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    stream_service_marker(s, tasks, string.from("marker-1"))?
    for _ in 0u64 .. commits {
        let receipt = bucket_order_commit(mut db)?
        durable(mut db, receipt)?
    }
    stream_service_marker(s, tasks, string.from("marker-2"))?
    std.clock.sleep_ns(s.time, 3500 * 1000000)
    stream_service_marker(s, tasks, string.from("marker-3"))?
    close(take db)?
    close_journal_service(take service)
}

fn stream_service_refused(s: BucketSim, tasks: Tasks, r: Random, plan: StreamPlan, budget: u64) -> Error waits {
    let client = match stream_service_client(s, tasks, 87, "", "us-east-1") {
        Ok(take made) => take made,
        Error(_) => fail("the law's client did not start"),
    }
    match journal_service(tasks, object_authority(take client, "bucket", BUCKET_LAW_OP_MS), plan, budget, s.time, r) {
        Ok(_) => fail("a plan out of range started a service"),
        Error(Refusal(error: take problem, ..)) => take problem,
    }
}

fn stream_service_same_refusal(take got: Error, take want: Error) -> bool {
    match (take got, take want) {
        (Stream(Bound(a)), Stream(Bound(b))) => stream_field_code(a) == stream_field_code(b),
        (Limit(Name), Limit(Name)) => true,
        _ => false,
    }
}

fn stream_field_code(f: StreamField) -> u64 {
    match f {
        MaxBatchBytes => 1,
        MaxSlots => 2,
        MaxPins => 3,
        HoldMs => 4,
        IdlePollMs => 5,
        IndexEvery => 6,
        SlotBytes => 8,
    }
}

// L90-P (§12.11.1, M12): each plan refusal is typed and decided before any
// request. Red for a service that creates `probe` or `reg` before it
// refuses, or a bound it does not check.
@test
fn bucket_stream_plan_refusals(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 89, None, list.new())
    let good = stream_service_plan(4)
    let fits = stream_service_budget(good)
    let mut cases: List[(StreamPlan, u64, Error)] = list.new()
    let mut low_batch: StreamPlan = clone(good)
    // A minimum-sized Place has one 4,096-byte value and 65,616 bytes of frame room.
    low_batch.batching.max_batch_bytes = 4096 + 65616 + 219
    list.push(mut cases, (take low_batch, fits, Stream(Bound(MaxBatchBytes))))
    let mut high_batch: StreamPlan = clone(good)
    high_batch.batching.max_batch_bytes = 4294967297
    list.push(mut cases, (take high_batch, fits, Stream(Bound(MaxBatchBytes))))
    list.push(mut cases, (stream_service_plan(0), fits, Stream(Bound(MaxSlots))))
    list.push(mut cases, (stream_service_plan(10699), fits, Stream(Bound(MaxSlots))))
    let mut hold: StreamPlan = clone(good)
    hold.limits.hold_ms = 119999
    list.push(mut cases, (take hold, fits, Stream(Bound(HoldMs))))
    let mut idle: StreamPlan = clone(good)
    idle.limits.idle_poll_ms = 0
    list.push(mut cases, (take idle, fits, Stream(Bound(IdlePollMs))))
    let mut idle_high: StreamPlan = clone(good)
    idle_high.limits.idle_poll_ms = 120001
    list.push(mut cases, (take idle_high, fits, Stream(Bound(IdlePollMs))))
    let mut no_index: StreamPlan = clone(good)
    no_index.limits.index_every = 0
    list.push(mut cases, (take no_index, fits, Stream(Bound(IndexEvery))))
    let mut slot_room: StreamPlan = clone(good)
    slot_room.limits.slot_bytes = 4095
    list.push(mut cases, (take slot_room, fits, Stream(Bound(SlotBytes))))
    let mut pins: StreamPlan = clone(good)
    pins.limits.max_pins = 1
    list.push(mut cases, (take pins, fits, Stream(Bound(MaxPins))))
    let mut long_name: StreamPlan = clone(good)
    long_name.prefix = string.repeat("n", 1025)
    list.push(mut cases, (take long_name, fits, Limit(Name)))
    let mut failures = 0u64
    for case in cases {
        let (plan, budget, want) = case
        if !stream_service_same_refusal(stream_service_refused(s, tasks, r, plan, budget), clone(want)) {
            failures += 1
        }
    }
    let small = stream_service_refused(s, tasks, r, good, fits - 1)
    let report = bucket_law_report(take s)
    if failures != 0 {
        fail("a plan out of range was not refused with its own field")
    }
    match small {
        Full(Allocation(Capacity(requested, available))) if requested == fits && available == fits - 1 => (),
        _ => fail("a budget below the service's bytes was not Full(Allocation)"),
    }
    if list.len(report.requests) != 0 {
        fail("a refused journal_service sent a request")
    }
    Ok(())
}

// L90-P for slots and `streamed` (§12.11.1): with `max_slots` 2 one slot is
// ordinary and the second is the janitor's, so a second `journal_slot` is
// `Full(Slots)`; a Place prefix over the root, an empty Place prefix,
// another region and a sim@1 grant with a weak level are refused, and none
// of them sends a request.
@test
fn bucket_stream_slot_refusals(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 91, None, list.new())
    let outcome = stream_service_slot_run(s, tasks, c, r)
    let report = bucket_law_report(take s)
    outcome?
    for request in report.requests {
        if !string.starts_with(request.key, "streams/") {
            fail("a refused slot or streamed call sent a request")
        }
        if stream_service_is_batch(request.key) {
            fail("a refused slot or streamed call created a batch")
        }
    }
    Ok(())
}

fn stream_service_is_batch(key: String) -> bool {
    string.starts_with(key, stream_service_key(string.from("b-")))
}

fn stream_service_slot_run(s: BucketSim, tasks: Tasks, c: Clock, r: Random) -> Result[(), Error] waits {
    let mut service = stream_service_start(s, tasks, c, r, stream_service_plan(2))?
    let first = journal_slot(mut service)?
    match journal_slot(mut service) {
        Error(Full(Slots(_))) => (),
        _ => fail("the janitor's slot was given out"),
    }
    let mut refused = 0u64
    let inside = stream_service_client(s, tasks, 93, "streams/p/", "us-east-1")?
    if let Error(Stream(Overlap)) = streamed(object_authority(take inside, "bucket", BUCKET_LAW_OP_MS), take first) {
        refused += 1
    }
    let second = journal_slot(mut service)?
    let whole = stream_service_client(s, tasks, 94, "", "us-east-1")?
    if let Error(Stream(Overlap)) = streamed(object_authority(take whole, "bucket", BUCKET_LAW_OP_MS), take second) {
        refused += 1
    }
    let third = journal_slot(mut service)?
    let other = stream_service_client(s, tasks, 95, "p1/", "eu-west-1")?
    if let Error(Foreign) = streamed(object_authority(take other, "bucket", BUCKET_LAW_OP_MS), take third) {
        refused += 1
    }
    let fourth = journal_slot(mut service)?
    let weak_client = stream_service_client(s, tasks, 96, "p2/", "us-east-1")?
    let mut world = level_world(tasks, s.time, list.new(), 65536)?
    let mut weak: List[String] = list.with_capacity(1)
    list.push(mut weak, string.from("replicated"))
    let grant = SimLevels(weak: take weak, strongest: "durable")
    if let Error(Stream(WeakLevels)) = streamed(sim_authority(take weak_client, grant, level_sync(mut world)?, BUCKET_LAW_OP_MS), take fourth) {
        refused += 1
    }
    let _ = level_log(take world)?
    if refused != 4 {
        fail("streamed accepted a prefix over the root, another region or a weak level")
    }
    close_journal_service(take service)
}

// L90-K's schedule (§12.11.15): 32 Places, commit i at `start` + 30 ms × i by
// Place i mod 32, each acked before its Place's next. The sim answers in no
// virtual time, so with `max_wait_ms` 0 every commit is a batch of its own,
// and with 100 a batch gathers the frames at t, t + 30, t + 60 and t + 90 and
// the one at t + 120 opens the next.
const STREAM_COST_PLACES: u64 = 32

const STREAM_COST_COMMITS: u64 = 1000

const STREAM_COST_SPACING_MS: u64 = 30

type CostPlace: send {
    endpoint: std.sim.s3.Endpoint,
    clock: Clock,
    tasks: Tasks,
    r: Random,
    slot: JournalSlot,
    nth: u64,
    start: u64
}

fn stream_cost_place(take p: CostPlace) -> Result[(), Error] waits {
    let CostPlace(endpoint, clock, tasks, r, slot: take slot, nth, start) = take p
    let mut place_prefix = string.from("p")
    string.push_u64(mut place_prefix, nth)
    string.push_char(mut place_prefix, '/')
    let client = stream_endpoint_client(endpoint, clock, tasks, 200 + nth, place_prefix, "us-east-1")?
    let attached = streamed(object_authority(take client, "bucket", BUCKET_LAW_OP_MS), take slot)?
    let mut options = bucket_order_options(true)
    options.head_poll_ms = 1000
    let mut db = open_authority(tasks, take attached, clock, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    let mut i = nth
    while i < STREAM_COST_COMMITS {
        host.sleep_until(clock, std.clock.deadline_after_ms(start, i * STREAM_COST_SPACING_MS))
        let receipt = bucket_order_commit(mut db)?
        durable(mut db, receipt)?
        i += STREAM_COST_PLACES
    }
    // Close after the measurement window ends so close settles stay outside it.
    host.sleep_until(clock, std.clock.deadline_after_ms(start, STREAM_COST_COMMITS * STREAM_COST_SPACING_MS + 1000))
    close(take db)
}

// L90-K (§12.11.14): over the commit window the request log is exactly one
// batch PUT then one `reg` GET per batch and nothing else (no head GET or
// write from an attached Place), and the batch count is the hand-derived
// 1,000 at `max_wait_ms` 0 and 250 at 100. Red for stream traffic that grows
// with Places, an idle head poll, or a window that does not gather.
@test
fn bucket_stream_cost_no_wait(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    stream_cost_law(c, r, tasks, 0, 1000)
}

@test
fn bucket_stream_cost_window(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    stream_cost_law(c, r, tasks, 100, 250)
}

fn stream_cost_law(c: Clock, r: Random, tasks: Tasks, wait_ms: u64, batches: u64) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 87, None, list.new())
    // Start strictly between two 1 s idle reg polls so the pre-window poll does
    // not land at `start` itself.
    let start = std.clock.deadline_after_ms(host.mono_ns(s.time), 10500)
    let outcome = stream_cost_run(s, tasks, r, wait_ms, start)
    let report = bucket_law_report(take s)
    outcome?
    let end = std.clock.deadline_after_ms(start, STREAM_COST_COMMITS * STREAM_COST_SPACING_MS)
    let mut pre_batches = 0u64
    let mut puts = 0u64
    let mut xindex_puts = 0u64
    let mut expect_put = true
    let mut expect_ckpt_reg = false
    for request in report.requests {
        if request.at_ns < start {
            if request.method == "PUT" && stream_service_is_batch(request.key) && request.status == 200 {
                pre_batches += 1
            }
            continue
        }
        if request.at_ns >= end {
            continue
        }
        if expect_ckpt_reg && request.method == "PUT" && request.key == stream_service_key(string.from("reg")) {
            expect_ckpt_reg = false
        } else if expect_put && request.method == "PUT" && string.starts_with(request.key, stream_service_key(string.from("x-"))) {
            xindex_puts += 1
            expect_ckpt_reg = true
        } else if expect_put && request.method == "PUT" && stream_service_is_batch(request.key) {
            puts += 1
            expect_put = false
        } else if !expect_put && request.method == "GET" && request.key == stream_service_key(string.from("reg")) {
            expect_put = true
        } else {
            fail("the commit window sent other than one batch PUT then one reg GET per batch (and index checkpoints)")
        }
    }
    if puts != batches || !expect_put || expect_ckpt_reg {
        fail("the commit window's batch count is not the hand-derived one")
    }
    let want_ckpts = (pre_batches + batches) / 512 - pre_batches / 512
    if xindex_puts != want_ckpts {
        fail("the commit window's index checkpoint count is not 2 A per 512 batches")
    }
    Ok(())
}

fn stream_cost_run(s: BucketSim, tasks: Tasks, r: Random, wait_ms: u64, start: u64) -> Result[(), Error] waits {
    let mut plan = stream_service_plan(33)
    plan.batching.max_wait_ms = wait_ms
    let mut service = stream_service_start(s, tasks, s.time, r, plan)?
    let mut places: List[Task[Result[(), Error]]] = list.with_capacity(STREAM_COST_PLACES)
    for nth in 0u64 .. STREAM_COST_PLACES {
        let slot = journal_slot(mut service)?
        let place = CostPlace(endpoint: s.endpoint, clock: s.time, tasks, r, slot: take slot, nth, start)
        list.push(mut places, task.spawn(tasks, bytes 16777216, take place, stream_cost_place))
    }
    let mut failed: Option[Error] = None
    while let Some(running) = list.pop(mut places) {
        let joined: Result[(), Error] = result.unwrap(task.join(take running))
        if let Error(take e) = joined {
            failed = Some(take e)
        }
    }
    if let Some(take e) = failed {
        return Error(take e)
    }
    close_journal_service(take service)
}

// L91 (F1, E7): idle host-stream attached holder A with every frame durable is
// deposed by B, who claims and commits a change to key k. A's zero-mutation run
// reading k must return and latch Fenced without releasing stale output.
@test
fn bucket_stream_empty_commit_fenced(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 9102, None, list.new())
    let outcome = stream_empty_commit_fenced_run(s, tasks, r)
    let report = bucket_law_report(take s)
    outcome?
    let mut saw_304 = false
    for req in report.requests {
        if req.method == "GET" && req.key == "p1/head" && req.status == 304 {
            saw_304 = true
        }
    }
    if !saw_304 {
        fail("L91 F1 (stream): unfenced skip did not issue a conditional 304 head GET")
    }
    Ok(())
}

fn stream_empty_commit_fenced_run(s: BucketSim, tasks: Tasks, r: Random) -> Result[(), Error] waits {
    let mut history = std.sim.history.new(9102)
    let plan = stream_service_plan(4)
    let mut service = stream_service_start(s, tasks, s.time, r, plan)?
    // Create standalone Place with table declared, then attach A to the stream.
    let client_init = stream_service_client(s, tasks, 911, "p1/", "us-east-1")?
    let mut init_db = open_authority(tasks, object_authority(take client_init, "bucket", BUCKET_LAW_OP_MS), s.time, r, bucket_order_options(true)) ?=> |Refusal(error: take problem, ..)| take problem
    let _ = law_table(mut init_db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    close(take init_db)?
    let slot_a = journal_slot(mut service)?
    let client_a = stream_service_client(s, tasks, 912, "p1/", "us-east-1")?
    let attached_a = streamed(object_authority(take client_a, "bucket", BUCKET_LAW_OP_MS), take slot_a)?
    let mut opts_a = bucket_order_options(false)
    opts_a.head_poll_ms = 600000
    let mut a = open_authority(tasks, take attached_a, s.time, r, opts_a) ?=> |Refusal(error: take problem, ..)| take problem
    let rows_a = table(mut a, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let Committed(w1) = run(mut a, None, copy_env(rows_a), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 1u64, 10u64)
    })? else {
        fail("L91 F1 (stream): A initial write failed")
    }
    durable(mut a, w1.ticket)?
    let v_a = version(snapshot(a))
    std.sim.history.model(mut history, v_a, types.key_word(10u64))
    std.sim.history.check(std.sim.history.committed(mut history, types.key_word(1u64), v_a, types.key_word(10u64)))
    std.sim.history.check(std.sim.history.reply(mut history, 1, types.key_word(1u64), v_a, Some(types.key_word(10u64))))
    // Unfenced zero-mutation run on attached A succeeds via 304 head GET with 0 stream frames.
    let seq_before = a.frame_seq
    let req_ok = std.sim.history.request(history, 1, Fresh)
    let Committed(r_ok) = run(mut a, None, copy_env(rows_a), fn(mut tx, t) -> Result[Option[u64], Error] {
        fetch(tx, t, 1u64)
    })? else {
        fail("L91 F1 (stream): unfenced zero-mutation run failed")
    }
    if r_ok.value != Some(10u64) || version(snapshot(a)) != v_a || a.frame_seq != seq_before {
        fail("L91 F1 (stream): unfenced skip changed version or frame_seq")
    }
    if let Some(_) = r_ok.info {
        fail("L91 F1/F2 (stream): unfenced skip returned Some(CallInfo)")
    }
    std.sim.history.check(std.sim.history.read(mut history, req_ok, v_a, types.key_word(10u64)))
    // B claims the attached Place and commits k = 20.
    let slot_b = journal_slot(mut service)?
    let client_b = stream_service_client(s, tasks, 913, "p1/", "us-east-1")?
    let attached_b = streamed(object_authority(take client_b, "bucket", BUCKET_LAW_OP_MS), take slot_b)?
    let mut opts_b = bucket_order_options(false)
    opts_b.head_poll_ms = 600000
    let mut b = open_authority(tasks, take attached_b, s.time, r, opts_b) ?=> |Refusal(error: take problem, ..)| take problem
    let rows_b = table(mut b, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let Committed(w2) = run(mut b, None, copy_env(rows_b), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 1u64, 20u64)
    })? else {
        fail("L91 F1 (stream): B write failed")
    }
    durable(mut b, w2.ticket)?
    let v_b = version(snapshot(b))
    std.sim.history.model(mut history, v_b, types.key_word(20u64))
    std.sim.history.check(std.sim.history.committed(mut history, types.key_word(2u64), v_b, types.key_word(20u64)))
    std.sim.history.check(std.sim.history.reply(mut history, 2, types.key_word(2u64), v_b, Some(types.key_word(20u64))))
    close(take b)?
    // Idle deposed A runs a zero-mutation run reading k: must return and latch Fenced.
    let req_stale = std.sim.history.request(history, 1, Fresh)
    match run(mut a, None, copy_env(rows_a), fn(mut tx, t) -> Result[Option[u64], Error] {
        fetch(tx, t, 1u64)
    }) {
        Error(Fenced(_)) => (),
        Ok(Committed(done)) => {
            let _ = durable(mut a, done.ticket)
            std.sim.history.check(std.sim.history.read(mut history, req_stale, version(snapshot(a)), types.key_word(option.unwrap(done.value))))
            fail("L91 F1 (stream): deposed attached holder committed stale zero-mutation run")
        },
        _ => fail("L91 F1 (stream): deposed attached holder did not return Fenced"),
    }
    match health(a) {
        Fenced(_) => (),
        _ => fail("L91 F1 (stream): Fenced was not latched in health(a)"),
    }
    match run(mut a, None, copy_env(rows_a), fn(mut tx, t) -> Result[Option[u64], Error] {
        fetch(tx, t, 1u64)
    }) {
        Error(Fenced(_)) => (),
        _ => fail("L91 F1 (stream): second zero-mutation run was not refused"),
    }
    let _ = close(take a)
    close_journal_service(take service)
}

@test
fn bucket_stream_reissues_overwritten_settle(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 3134, None, list.new())
    let outcome = stream_reissue_settle(s, tasks, r)
    let _ = bucket_law_report(take s)
    outcome
}

fn stream_reissue_settle(s: BucketSim, tasks: Tasks, r: Random) -> Result[(), Error] waits {
    let mut service = stream_unhold_service(s, tasks, r, 4)?
    stream_unhold_make_place(s, tasks, r)?
    let mut place = stream_unhold_open_attached(s, tasks, r, mut service, 85)?
    let first = stream_unhold_commit_ticket(mut place, 1)?
    durable(mut place, first)?
    let epoch = claim_of(place)?.epoch
    let (take handover, take paused): (Sender[ObjectJournalStart], Receiver[ObjectJournalStart]) = channel.new(1)
    let (take resume, take resuming): (Sender[ObjectJournalStart], Receiver[ObjectJournalStart]) = channel.new(1)
    result.unwrap(channel.send(disk_state(place).journal, ObjectPause(take handover, take resuming)))
    let mut parked = result.unwrap(channel.receive(paused))
    // One answer fits behind the blocked relay. Both are occupied before hold_ms.
    let made: Result[(Client[SlotAck], Inbox[SlotAck]), Capacity] = conn.new(1, bytes 0)
    let (take answer_client, take answers) = failure_result_from_rep(types.capacity(take made))?
    let relay = match parked.stream {
        Some(mut link) => {
            link.answer_client = Some(take answer_client)
            link.answers = Some(take answers)
            let _ = slot_attach(mut link, place.store, epoch, "p1/", place.limits)?
            SlotRelayInput(answers: option.unwrap(replace(mut link.answers, None)), journal: channel.sender(disk_state(place).journal))
        },
        None => fail("paused journal lost its stream"),
    }
    let running = task.spawn(tasks, bytes OBJECT_TIMER_GRANT, take relay, slot_relay)
    let stalled = stream_unhold_commit_ticket(mut place, 2)?
    while let Ok(()) = channel.try_send(disk_state(place).journal, Barrier) {}
    stream_unhold_raw_hold(s, tasks, 240, place.store, epoch, StoreId(hi: 3134, lo: 1))?
    // Keep the journal paused past both the first rule-(a) request and the
    // following head poll. The first settle is queued and then overwritten.
    std.clock.sleep_ns(s.time, 2 * UNHOLD_HOLD_MS * 1000000)
    result.unwrap(channel.send(resume, take parked))
    std.clock.sleep_ns(s.time, UNHOLD_HOLD_MS * 1000000)
    let mut client = stream_service_client(s, tasks, 241, "", "us-east-1")?
    let mut lane = stream_lane(stream_law_sid(), 1, 8, StoreId(hi: 3134, lo: 2))?
    lane.dir = stream_key(stream_root_dir(string.from(STREAM_SERVICE_ROOT)), stream_dir(stream_law_sid()))
    let deadline = std.object.deadline_after_ms(client, UNHOLD_OP_MS)
    stream_reg_read(mut lane, mut client, deadline)?
    if list.len(lane.reg.rows) != 0 {
        fail("the Held row survived the overwritten rule-(a) settle")
    }
    if !durable_now(mut place, stalled)? {
        fail("the queued commit did not become durable after the settle")
    }
    close(take place)?
    close_journal_service(take service)?
    result.unwrap(task.join(take running))
    stream_reap_pending_settle(s, tasks)
}

fn stream_reap_pending_settle(s: BucketSim, tasks: Tasks) -> Result[(), Error] waits {
    let store = StoreId(hi: 3134, lo: 3)
    let client = stream_service_client(s, tasks, 242, "", "us-east-1")?
    let lane = stream_lane(stream_law_sid(), 1, 8, store)?
    let gc = stream_gc_new(lane.reg)
    let (take control, take service_control): (Sender[ServiceControl], Receiver[ServiceControl]) = channel.new(1)
    let rings: Result[(Client[u32], Inbox[u32]), Capacity] = conn.new(1, bytes 0)
    let (take bell, take ring_inbox) = failure_result_from_rep(types.capacity(take rings))?
    let reports: Result[(Client[SlotReport], Inbox[SlotReport]), Capacity] = conn.new(1, bytes 0)
    let (take report, take report_inbox) = failure_result_from_rep(types.capacity(take reports))?
    let mut service = StreamService(lane: take lane, client: take client, clock: s.time, plan: stream_unhold_plan(4), op_ms: UNHOLD_OP_MS, slots: list.with_capacity(1), rings: take ring_inbox, reports: take report_inbox, control: take service_control, waiting: list.new(), tickets: list.new(), prefixes: map.new(), observed_rows: list.new(), active_settles: list.with_capacity(1), stall_polls: list.new(), next_settle_id: 2, last_reg_ns: 0, tasks, bell: take bell, timer: None, poll_at: 0, gc: take gc, janitor_asks: list.new())
    let data: Result[(Client[SlotMsg], Inbox[SlotMsg]), Capacity] = conn.new(1, bytes 0)
    let (take data_client, take data_inbox) = failure_result_from_rep(types.capacity(take data))?
    let answers: Result[(Client[SlotAck], Inbox[SlotAck]), Capacity] = conn.new(1, bytes 0)
    let (take answer_client, take answer_inbox) = failure_result_from_rep(types.capacity(take answers))?
    let place = SlotPlace(store, epoch: 1, fenced: false, settled_from: 0, answers: take answer_client)
    list.push(mut service.slots, ServiceSlot(inbox: Some(take data_inbox), place: Some(take place), held: None, unsent: Some(SlotSettle(1, 0, 1))))
    list.push(mut service.active_settles, ActiveSettle(id: 1, slot: 0, store, epoch: 1, tokens: list.new()))
    let _ = take data_client
    stream_reap_closed_slots(mut service)
    if !stream_slot_unused(service.slots[0u64]) || stream_has_active_settle(service, store, 1) {
        fail("the reaped slot retained its active settle")
    }
    let _ = (take control, take report, take answer_inbox)
    Ok(())
}

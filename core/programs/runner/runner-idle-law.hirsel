const IDLE_MS: u64 = 30u64

type IdleSeed: send {
    clock: Clock,
    starts: Sender[u64]
}

type IdleGrant: send {
    clock: Clock,
    starts: Sender[u64],
    attempt: u64
}

fn idle_grant(seed: IdleSeed, unused_handles: Hd, ctx: runner.TriggerContext) -> Result[IdleGrant, Capacity] {
    let number = triggers.number(runner.trigger_attempt(ctx))
    Ok(IdleGrant(clock: seed.clock, starts: channel.sender(seed.starts), attempt: number))
}

fn idle_body(grant: IdleGrant, author: runner.Caller, take delay: u64) -> Result[u64, Capacity] waits {
    let outside_done_at = std.clock.deadline_after_ms(host.mono_ns(grant.clock), delay)
    result.unwrap(channel.send(grant.starts, grant.attempt))
    host.sleep_until(grant.clock, outside_done_at)
    Ok(grant.attempt)
}

fn idle_entries() -> (triggers.Entries, triggers.Entry[u64]) {
    let target: triggers.Entry[u64] = result.unwrap(triggers.granted(code.describe(idle_body)))
    let mut entries = triggers.empty_entries()
    result.unwrap(triggers.allow(mut entries, target))
    (take entries, take target)
}

fn idle_place(mut r: runner.Registry[IdleGrant, Hd]) -> Result[(), runner.RegisterError] {
    runner.use_trigger_tables(mut r, fn(h: Hd) -> triggers.Tables {
        ping_tables(h)
    })
    runner.granted(mut r, code.describe(idle_body), 65536u64, runner.DEFAULT_STEPS)
}

// The store section the head reports to Status once it serves: the trigger
// tables declare the index "due", every index of a fresh store is built at its
// declaration, so all are Public, and nothing has drifted or failed.
fn idle_store_reported(seen: store.Attention) -> bool {
    let mut due = 0u64
    for report in seen.indexes {
        if let Public = report.state {} else {
            return false
        }
        if report.index == "due" {
            due += 1
        }
    }
    due == 1u64 && list.len(seen.drift) == 0u64 && seen.reclaim_failures == 0u64 && !seen.reclaim_pending
}

// A listener with no clients keeps each accept pending until withdrawn.
fn idle_net(take seed: (Sender[()], Served[NetOp])) waits {
    let (accepts, take port) = take seed
    let mut net_port = take port
    let mut pending: Option[Call[NetOp]] = None
    while let Some(take request) = provide.next(mut net_port) {
        match provide.net_op(request) {
            Listen(addr: addr, ..) => {
                let listening: NetReply = Listener(1u64, Addr(ip: addr.ip, port: 4000u16))
                let _ = provide.reply(mut net_port, take request, provide.net_reply(listening))
            },
            Accept(..) => {
                let _ = channel.try_send(accepts, ())
                let _ = replace(mut pending, Some(take request))
            },
            Released(..) => {
                let _ = replace(mut pending, None)
            },
            _ => fail("idle: unexpected network operation"),
        }
    }
}

fn idle_triggers(dir: Dir, time: Clock, random: Random, tasks: Tasks, due: u64, future: u64) -> triggers.Id waits {
    let mut db = result.unwrap(store.open(tasks, dir, time, random, disk_options()))
    let mut declaration = result.unwrap(store.declare(db, Migrate))
    let _ = result.unwrap(ping_schema(mut declaration))
    let _ = result.unwrap(store.seal(mut db, take declaration))
    let tables = ping_tables(result.unwrap(store.bind_declaration(mut db, Migrate, ping_schema)))
    let (entries, target) = idle_entries()
    let schedule = store.run(mut db, None, (store.copy_env(due), store.copy_env(future), store.copy_env(tables), store.copy_env(entries), store.copy_env(target)), fn(mut tx, call_env) -> Result[triggers.Id, triggers.Error] {
        let id = triggers.write(mut tx, call_env.2, call_env.3, call_env.4, 3u64 * IDLE_MS, At(call_env.0))?
        let _ = triggers.write(mut tx, call_env.2, call_env.3, call_env.4, 3u64 * IDLE_MS, At(call_env.1))?
        Ok(id)
    })
    let scheduled = match take schedule {
        Ok(Committed(row)) => row,
        _ => fail("idle: trigger schedule failed"),
    }
    result.unwrap(store.durable(mut db, scheduled.ticket))
    result.unwrap(store.close(take db))
    scheduled.value
}

fn idle_trigger_case(parent: Dir, wall_clock: Clock, random: Random, tasks: Tasks, at_idle_deadline: bool) -> () waits {
    let (virtual_time, hand) = provide.clock(0u64, 1000u64)
    let mut ticks = take hand
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let due = if at_idle_deadline {
        1000u64 + IDLE_MS
    } else {
        1000u64
    }
    let future = 2000u64
    let id = idle_triggers(dir, virtual_time, random, tasks, due, future)
    let (network, provider) = provide.net(bytes 4096u64)
    let (accepts, observed_accepts): (Sender[()], Receiver[()]) = channel.new(2u64)
    let serving_net = task.spawn(tasks, bytes 16384u64, (take accepts, take provider), idle_net)
    let listen = Addr(ip: V4(0x7f000001u32), port: 0u16)
    let stop = runner.Stop(lag_ms: 1000u64, grace_ms: 1000u64)
    let (starts, started): (Sender[u64], Receiver[u64]) = channel.new(2u64)
    let (entries, _) = idle_entries()
    let config = runner.TriggerConfig(entries: take entries, author: store.Caller(issuer: 0u8, subject: list.new()))
    let config_grants: runner.Grants[IdleGrant, Hd, IdleSeed] = runner.Grants(attempt: Some(runner.Mint(seed: IdleSeed(clock: virtual_time, starts: take starts), mint: idle_grant, mint_bytes: 65536u64, mint_steps: runner.DEFAULT_STEPS)), call: None, claim: None, bind: None)
    let mut wire = runner.wire_defaults(65536u64)
    wire.n_pool = 4194304u64
    let settings: runner.PlaceConfig[IdleGrant, Hd, IdleSeed] = runner.PlaceConfig(backing: Disk(dir), sizes: store.Overrides(resident_limit: Some(1048576u64), journal_limit: None, checkpoint_bytes: Some(4194304u64), pack_bytes: Some(512u64), group_bytes: Some(1048576u64), group_commits: Some(2u32), lock_wait_ms: None, cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: Current(0u64), place: code.describe(idle_place), n_place: N_PLACE, on_migrate: None, schema: code.describe(ping_schema), session: wire, max_sessions: 1u64, proxies: list.new(), n_publisher: 1048576u64, listen: Tcp(listen), net: network, tasks: tasks, clock: virtual_time, random: random, stop: stop, wire: None, grants: Some(take config_grants), triggers: Some(take config), idle: Some(IDLE_MS))
    let (running, stop_to, phases, status) = start_managed(tasks, take settings, false)
    loop {
        match channel.receive(phases) {
            Ok(Ready) => break,
            Ok(Starting(_)) => (),
            _ => fail("idle: place did not become ready")
        }
    }
    let first_due = (due - 1000u64) * 1000000u64
    let mut now = 0u64
    let quantum = IDLE_MS * 500000u64
    while now <= first_due {
        let _ = clock.idle(mut ticks)
        if now == first_due {
            break
        }
        now += quantum
        clock.advance_to(mut ticks, now)
        clock.set_wall(mut ticks, 1000u64 + now / 1000000u64)
    }
    if let Ok(1u64) = channel.try_receive(started) {} else {
        fail("idle: the first attempt did not start")
    }
    let finish_at = first_due + 3u64 * IDLE_MS * 1000000u64
    while now < finish_at {
        if let Ready = latest.read(status).phase {} else {
            fail("idle: a waiting granted run lost its place")
        }
        now += quantum
        clock.advance_to(mut ticks, now)
        clock.set_wall(mut ticks, 1000u64 + now / 1000000u64)
        let _ = clock.idle(mut ticks)
    }
    want(idle_store_reported(latest.read(status).store), "idle: Status does not report the store's indexes, all Public, and no drift or reclaim failure")
    if !at_idle_deadline {
        if let Ok(()) = channel.try_receive(observed_accepts) {} else {
            fail("idle: the listener never armed")
        }
        if let Error(Empty) = channel.try_receive(observed_accepts) {} else {
            fail("idle: the listener polled while a run was held")
        }
    }
    let mut next_clock: Option[u64] = None
    while now < finish_at + 5u64 * IDLE_MS * 1000000u64 {
        if let Draining = latest.read(status).phase {
            break
        }
        now += quantum
        clock.advance_to(mut ticks, now)
        clock.set_wall(mut ticks, 1000u64 + now / 1000000u64)
        next_clock = clock.idle(mut ticks)
    }
    if let Draining = latest.read(status).phase {} else {
        fail("idle: completed run kept the place up")
    }
    want(next_clock == None, "idle: drain waited for the configured lag")
    if let Ok(Ok(Stopped(Some(next)))) = task.join(take running) {
        want(next == future, "idle: clean stop lost the future trigger")
    } else {
        fail("idle: expected a clean stop")
    }
    let _ = take serving_net
    let _ = take stop_to
    let _ = take started
    let mut db = result.unwrap(store.open(tasks, dir, wall_clock, random, disk_options()))
    let tables = ping_tables(result.unwrap(store.bind_declaration(mut db, Open, ping_schema)))
    if let Ok(Some(Returned(raw))) = triggers.outcome(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), tables, id) {
        want(result.unwrap(std.codec.decode(std.codec.of_u64(), raw)) == 1u64, "idle: the run did not finish on attempt one")
    } else {
        fail("idle: no terminal result")
    }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
}

// L44. In the second case the trigger becomes due at the idle deadline,
// so the head must participate in deciding whether to drain.
@test
fn test_idle_keeps_runs(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), ()] waits {
    idle_trigger_case(parent, clock, random, tasks, false)
    idle_trigger_case(parent, clock, random, tasks, true)
    Ok(())
}

@test
fn test_trigger_timer_wall_wait(tasks: Tasks) -> Result[(), ()] waits {
    if runner.law_trigger_timer_wall_wait(tasks) {
        Ok(())
    } else {
        Error(())
    }
}

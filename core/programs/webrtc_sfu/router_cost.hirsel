// RTC-10 Sizing: the memory terms of one room, from the bounds the router allocates
// with. `signal.room_cost` adds the control unit's terms.
/// A pool's bounds on the rows every unit's router holds at once (RTC-10 Sizing): its
/// live rooms, their seats, the sessions one unit homes, and the publications and
/// down-tracks one seat holds. Each seat has a session reservation on its home
/// unit's ledger. Each publication uses a distinct negotiated section.
pub type PoolBounds: key {
    rooms: u64,
    seats: u64,
    sessions: u64,
    publications: u64,
    downs: u64
}

/// The bounds of a pool of `units` units, `rooms` live rooms and `sessions` sessions
/// a unit, each of `session`'s size. The room's participant field is `u16`.
pub fn pool_bounds(units: u64, rooms: u64, sessions: u64, session: peer.PeerLimits) -> PoolBounds {
    let by_rooms = int.saturating_mul(rooms, 65535u64)
    let by_units = int.saturating_mul(units, sessions)
    PoolBounds(rooms: rooms, seats: order.min(by_rooms, by_units), sessions: sessions, publications: int.widen(session.sections), downs: int.widen(session.down_tracks))
}

/// What `reserve_pool` allocates: every pool-wide row list at its bound. A seat has at
/// most `publications` publications and `downs` down-tracks; a unit
/// parks and seats at most `sessions` members, each with one 5-tuple row. `None` when
/// the bounds overflow.
pub fn pool_bytes(b: PoolBounds) -> Option[u64] {
    let pubs = int.checked_mul(b.seats, b.publications)?
    let downs = int.checked_mul(b.seats, b.downs)?
    let mut sum = charge.seq(bytes[Room], b.rooms)?
    sum = int.checked_add(sum, charge.seq(bytes[Seat], b.seats)?)?
    sum = int.checked_add(sum, charge.seq(bytes[Member], b.sessions)?)?
    sum = int.checked_add(sum, charge.seq(bytes[Member], b.sessions)?)?
    sum = int.checked_add(sum, charge.seq(bytes[Row], b.sessions)?)?
    sum = int.checked_add(sum, charge.seq(bytes[Publication], pubs)?)?
    int.checked_add(sum, charge.seq(bytes[Down], downs)?)
}

/// Reserve every pool-wide row list at `b`, before the unit serves any room (RTC-10
/// Sizing): a list that grew as rooms filled would allocate past what the ledgers
/// reserve, by its growth's slack and by the capacity it keeps once rows are removed.
/// Each list takes exactly its bound (`list.with_capacity`), so it allocates
/// `pool_bytes(b)`; the caller checks that fits before it calls this. Rows the router
/// already holds are kept.
pub fn reserve_pool(mut r: Router, b: PoolBounds) {
    let pubs = int.saturating_mul(b.seats, b.publications)
    let downs = int.saturating_mul(b.seats, b.downs)
    let rooms = sized(replace(mut r.rooms, list.new()), b.rooms)
    r.rooms = take rooms
    let roster = sized(replace(mut r.roster, list.new()), b.seats)
    r.roster = take roster
    let members = sized(replace(mut r.members, list.new()), b.sessions)
    r.members = take members
    let parked = sized(replace(mut r.parked, list.new()), b.sessions)
    r.parked = take parked
    let rows = sized(replace(mut r.rows, list.new()), b.sessions)
    r.rows = take rows
    let publications = sized(replace(mut r.publications, list.new()), pubs)
    r.publications = take publications
    let tracks = sized(replace(mut r.downs, list.new()), downs)
    r.downs = take tracks
    r.pool = Some(b)
}

// `xs` moved into a list of exactly `n` capacity, or of its length if longer.
fn sized[T](take xs: List[T], n: u64) -> List[T] {
    let len = list.len(xs)
    let mut all: List[T] = list.with_capacity(if len > n {
        len
    } else {
        n
    })
    for take x in take xs {
        list.push(mut all, take x)
    }
    all
}

/// What every unit allocates for a room at `Open` and as the room fills to its
/// bounds, beyond its rows in the lists `reserve_pool` holds: the room's fence table
/// and top speakers, and every publication's encodings and Opus RED ring (RTP-13),
/// which every unit keeps.
pub fn room_replicated(limits: RoomLimits) -> u64 {
    let ids: u64 = int.widen(limits.ids)
    let participants: u64 = int.widen(limits.participants)
    let rows = participants * int.widen(limits.publications)
    let publication = cost_seq(bytes[Encoding], ENCODINGS_MAX) + rtp.red.ring_heap(rtp.red.MAX_DISTANCE)
    cost_seq(bytes[u64], ids) + cost_seq(bytes[Option[u64]], ids) + cost_seq(bytes[u64], TOP) + rows * publication
}

/// What one admitted participant adds on its home unit beyond its session's heap
/// (`peer.session_heap`) and its rows in the lists `reserve_pool` holds: the ingress
/// RTX ring of each publication it may make (`floor(rtx_bytes / 1500)` slots of 1,500
/// bytes). It saturates: `rtx_bytes` is the caller's.
pub fn member_bytes(limits: RoomLimits, session: peer.PeerLimits) -> u64 {
    let n = session.rtx_bytes / RING_SLOT
    let slots = int.saturating_mul(n, cost_seq(1, RING_SLOT))
    let rtx_ring = int.saturating_add(int.saturating_add(saturated(charge.seq(bytes[Bytes], n)), slots), saturated(charge.seq(bytes[u64], n)))
    int.saturating_mul(int.widen(limits.publications), rtx_ring)
}

/// What one down-track on a unit other than its publisher's home adds there: the
/// `Shared` packets the home's fan-out hands it, up to its pacer's bound (RTC-5 step
/// 3), each at most one ring slot. The RED ring is in `room_replicated`.
pub fn remote_bytes(session: peer.PeerLimits) -> u64 {
    let packet = saturated(charge.shared(bytes[Bytes])) + cost_seq(1, RING_SLOT)
    let n: u64 = int.widen(session.pacer_packets)
    n * packet
}

fn cost_seq(element: u64, capacity: u64) -> u64 {
    option.unwrap(charge.seq(element, capacity))
}

fn saturated(x: Option[u64]) -> u64 {
    match x {
        Some(v) => v,
        None => 0xffffffffffffffff,
    }
}

// L15. The head inbox is the cut before admission. Timers and reply channels
// are the relay's real ones; the test controls when the head's Told arrives.
fn l15_timers(tasks: Tasks) waits {
    let (take world, time) = std.sim.world.new(15u64, 0u64, 0u64)
    let clock_task = task.spawn(tasks, bytes 65536u64, take world, sse_law_sim_clock)
    let reg = result.unwrap(placed(code.describe(http_op_original), HTTP_LAW_PLACE_BYTES))
    let key = http_law_key(reg.exported[0u64])
    let cfg = RelayConfig(http_max: 2u64, sends_max: 2u64, positions_max: 6u64, arg_max: 1024u64)
    let reserve = option.unwrap(relay_bytes(reg, cfg))
    // Twelve RelayEvents cost 64 + 12 * 209. The new claim slot is a
    // 24-byte Bytes plus an 8-byte variant tag. The two credit queues cost 128.
    // HeadLease costs 56 fields + 32 cause, two 32-byte roots and three 16-byte Arc nodes.
    // Two send slots cost 2 * 56, and their alarms cost 2 * (288 + 4096).
    // Six positions cost round8(6 * 90) for the records. Each also costs
    // 16 owner seed + 64 subject + 2 * 88 for the widened stream keys
    // + 8192 reply + 1024 argument + the longest rounded registry key.
    // Three delivered buffers cost 3 * 8192. Startup adds 288 for the task record,
    // 64 + 96 for its ready channel and round8(6 * 81) = 488 for pending tells.
    // The optional reply expiry adds 8 bytes for the value and 8 for the tag.
    let mut longest = 0u64
    for entry in reg.exported {
        // Each key is the exported identity followed by two eight-byte codec fingerprints.
        let length = list.len(entry.described.identity) + 16u64
        longest = order.max(longest, length)
    }
    let expected = 94668u64 + 6u64 * ((longest + 7u64) / 8u64 * 8u64)
    if reserve != expected {
        let mut detail = string.from("L15 relay allowance ")
        string.push_u64(mut detail, reserve)
        string.push(mut detail, " differs from hand derivation ")
        string.push_u64(mut detail, expected)
        for width in[bytes[RelayEvent], bytes[RelayPosition], bytes[Option[RelayTell]]] {
            string.push(mut detail, " ")
            string.push_u64(mut detail, width)
        }
        fail(take detail)
    }
    let mut maximum: Bytes = list.with_capacity(MAX_RETURNED_BYTES)
    list.fill(mut maximum, MAX_RETURNED_BYTES, b'x')
    let returned = Returned(take maximum)
    let (head_to, head_from): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(6u64)
    let (pub_to, pub_from): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    let short_start = bound bytes (expected - 1u64) {
        start_relay(reg, head_to, pub_to, time, tasks, cfg)
    }
    if let Ok(Error(Overloaded)) = short_start {} else {
        fail("L15 relay admitted one byte below its allowance")
    }
    if let Error(Empty) = channel.try_receive(pub_from) {} else {
        fail("L15 refused relay joined the publisher")
    }
    let started = bound bytes expected {
        start_relay(reg, head_to, pub_to, time, tasks, cfg)
    }
    let (take endpoint, take owner_task) = result.unwrap(result.unwrap(take started))
    if let Ok(PubIn(e: RelayJoined(_))) = channel.try_receive(pub_from) {} else {
        fail("L15 admitted relay did not join the publisher")
    }
    let _ = std.task.cancel_join(take owner_task)
    let _ = take endpoint
    let checked = bound bytes reserve {
        let (to, from): (Sender[RelayEvent], Receiver[RelayEvent]) = channel.new(option.unwrap(relay_inbox_size(cfg)))
        let own_head = result.unwrap(head_lease(LifecycleHead(channel.sender(head_to))))
        let mut records: List[RelaySend] = list.with_capacity(2u64)
        list.push(mut records, Vacant)
        list.push(mut records, Vacant)
        let mut state = RelayState(sends: take records, positions: list.with_capacity(cfg.positions_max), generation: 0u64, owner: take own_head, inbox: channel.sender(to), clock: time, tasks: tasks, config: cfg, key_max: relay_key_max(reg))
        let (first, closed_first): (Sender[RelayResult], Receiver[RelayResult]) = channel.new(1u64)
        relay_step(mut state, RelayAsk(l15_send(reg, key, time, 1u32, 0u64, 1u64), take first))
        let _ = take closed_first
        let held = result.unwrap(channel.receive(head_from))
        relay_step(mut state, result.unwrap(channel.receive(from)))
        let mut last_delivery: Option[RelayOutcome] = None
        for i in 0u64 .. 1000u64 {
            if list.len(state.positions) != 1u64 || state.positions[0u64].id != 1u64 {
                fail("L15 expiry refunded the head's position")
            }
            let (reply, reply_from): (Sender[RelayResult], Receiver[RelayResult]) = channel.new(1u64)
            relay_step(mut state, RelayAsk(l15_send(reg, key, time, 1u32, 0u64, 1u64), take reply))
            if i % 2u64 == 0u64 {
                let _ = take reply_from
                relay_step(mut state, result.unwrap(channel.receive(from)))
            } else {
                relay_step(mut state, result.unwrap(channel.receive(from)))
                let result = l15_delivery(reply_from)
                if let Abandoned = l15_outcome(result) {} else {
                    fail("L15 an owed send did not get Abandoned")
                }
                if let Error(Closed) = channel.try_receive(reply_from) {} else {
                    fail("L15 an expired send kept a reply sender")
                }
                // The earlier connection can still own its delivery block
                // while the relay allocates the next connection's block.
                last_delivery = Some(take result)
            }
            if let Error(Empty) = channel.try_receive(from) {} else {
                fail("L15 stale Expired after retirement")
            }
            for record in state.sends {
                if let Vacant = record {} else {
                    fail("L15 an expired timer retained a send record")
                }
            }
            if let Error(Empty) = channel.try_receive(head_from) {} else {
                fail("L15 reconnect forwarded the same position twice")
            }
        }
        let (a, a_from): (Sender[RelayResult], Receiver[RelayResult]) = channel.new(1u64)
        let (b, b_from): (Sender[RelayResult], Receiver[RelayResult]) = channel.new(1u64)
        // The long timer must cancel. The short timer has finished already,
        // but its Expired sits behind Told in the relay inbox.
        relay_step(mut state, RelayAsk(l15_send(reg, key, time, 1u32, 0u64, 1u64), take a))
        let short = state.generation
        relay_step(mut state, RelayAsk(l15_send(reg, key, time, 1u32, 0u64, 30u64), take b))
        let told = l15_told(take held, returned)
        result.unwrap(channel.try_send(to, take told))
        host.sleep_until(time, std.clock.deadline_after_ms(host.mono_ns(time), 2u64))
        let _ = take last_delivery
        relay_step(mut state, result.unwrap(channel.receive(from)))
        if list.len(state.positions) != 0u64 {
            fail("L15 Told did not refund its position")
        }
        if let Retiring(id) = state.sends[0u64] {
            if id != short {
                fail("L15 the wrong timer is retiring")
            }
        } else {
            fail("L15 a queued expiry lost its charged send record")
        }
        if let Vacant = state.sends[1u64] {} else {
            fail("L15 cancelled timer did not refund immediately")
        }
        let first_delivery = l15_delivery(a_from)
        let second_delivery = l15_delivery(b_from)
        if list.len(first_delivery.payload) != 8168u64 || list.slice(first_delivery.payload, 0u64, 8u64) != b"\x00\x00\x00\x00\xe0\x1f\x00\x00" || second_delivery.payload != first_delivery.payload || first_delivery.replayed || second_delivery.replayed {
            fail("L15 joined sends disagree with the head outcome")
        }
        for byte in list.slice(first_delivery.payload, 8u64, 8168u64) {
            if byte != b'x' {
                fail("L15 delivery lost part of the maximum outcome")
            }
        }
        let expired = result.unwrap(channel.receive(from))
        if let RelayExpired(id) = expired {
            if id != short {
                fail("L15 unexpected expiry")
            }
        } else {
            fail("L15 expected pending expiry")
        }
        relay_step(mut state, take expired)
        if let Vacant = state.sends[0u64] {} else {
            fail("L15 taking Expired did not refund the retiring record")
        }
        if let Error(Empty) = channel.try_receive(from) {} else {
            fail("L15 relay inbox retained an expiry")
        }
        let _ = (take first_delivery, take second_delivery)
        l15_position_caps(mut state, from, reg, key, time)
    }
    if let Error(_) = checked {
        fail("L15 relay exceeded its declared bytes")
    }
    let _ = std.task.cancel_join(take clock_task)
}

fn l15_position_caps(mut state: RelayState, from: Receiver[RelayEvent], reg: Registry[(), HttpLawHandles], key: Bytes, time: Clock) waits {
    for stream_id in 1u32 .. 6u32 {
        let (reply, dropped): (Sender[RelayResult], Receiver[RelayResult]) = channel.new(1u64)
        relay_step(mut state, RelayAsk(l15_send(reg, key, time, stream_id, 0u64, 1u64), take reply))
        let _ = take dropped
        relay_step(mut state, result.unwrap(channel.receive(from)))
        if list.len(state.positions) != int.widen(stream_id) {
            fail("L15 expired principal position was released early")
        }
    }
    l15_over_capacity(mut state, l15_send(reg, key, time, 6u32, 0u64, 1u64), 5u64)
    let (reply, dropped): (Sender[RelayResult], Receiver[RelayResult]) = channel.new(1u64)
    relay_step(mut state, RelayAsk(l15_send_for(reg, key, time, 6u32, 0u64, 1u64, 2u64), take reply))
    let _ = take dropped
    relay_step(mut state, result.unwrap(channel.receive(from)))
    if list.len(state.positions) != 6u64 {
        fail("L15 one principal's quota consumed another principal's slot")
    }
    l15_over_capacity(mut state, l15_send_for(reg, key, time, 7u32, 0u64, 1u64, 2u64), 6u64)
}

@test
fn http_caller_cap_structured(tasks: Tasks) -> Result[(), ()] waits {
    let (take world, time) = std.sim.world.new(15u64, 0u64, 0u64)
    let clock_task = task.spawn(tasks, bytes 65536u64, take world, sse_law_sim_clock)
    let reg = result.unwrap(placed(code.describe(http_op_original), HTTP_LAW_PLACE_BYTES))
    let key = http_law_key(reg.exported[0u64])
    let cfg = RelayConfig(http_max: 1u64, sends_max: 2u64, positions_max: 6u64, arg_max: 1024u64)
    let (head, forwarded): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(6u64)
    let (to, from): (Sender[RelayEvent], Receiver[RelayEvent]) = channel.new(option.unwrap(relay_inbox_size(cfg)))
    let owner = result.unwrap(head_lease(LifecycleHead(take head)))
    let mut sends: List[RelaySend] = list.with_capacity(2u64)
    list.push(mut sends, Vacant)
    list.push(mut sends, Vacant)
    let mut state = RelayState(sends: take sends, positions: list.with_capacity(6u64), generation: 0u64, owner: take owner, inbox: take to, clock: time, tasks: tasks, config: cfg, key_max: relay_key_max(reg))
    l15_position_caps(mut state, from, reg, key, time)
    for _ in 0u64 .. 6u64 {
        if let Ok(RunRequest(_)) = channel.try_receive(forwarded) {} else {
            fail("L15 counted a position without forwarding it")
        }
    }
    let _ = std.task.cancel_join(take clock_task)
    Ok(())
}

fn l15_over_capacity(mut state: RelayState, take attempt: Send, occupied: u64) waits {
    let (reply, returned): (Sender[RelayResult], Receiver[RelayResult]) = channel.new(1u64)
    relay_step(mut state, RelayAsk(take attempt, take reply))
    if list.len(state.positions) != occupied {
        fail("L15 relay exceeded its position cap")
    }
    let got = result.unwrap(channel.try_receive(returned))
    if let Delivered(answer) = got {
        if let Refused(Overloaded) = l15_outcome(answer) {
            return
        }
    }
    fail("L15 exhausted positions did not refuse the send")
}

@test
fn relay_handler_expiry_leaves_ask_queued(tasks: Tasks) -> Result[(), ()] waits {
    let (take world, time) = std.sim.world.new(15u64, 0u64, 0u64)
    let clock_task = task.spawn(tasks, bytes 65536u64, take world, sse_law_sim_clock)
    let reg = result.unwrap(placed(code.describe(http_op_original), HTTP_LAW_PLACE_BYTES))
    let key = http_law_key(reg.exported[0u64])
    let cfg = RelayConfig(http_max: 1u64, sends_max: 1u64, positions_max: 1u64, arg_max: 1024u64)
    let (head, forwarded): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let (to, from): (Sender[Relay], Receiver[Relay]) = channel.new(1u64)
    let setup = RelayStart(to: take to, head: take head, clock: time, tasks: tasks, config: cfg, inbox_size: option.unwrap(relay_inbox_size(cfg)), key_max: relay_key_max(reg))
    let (take booted, take incoming, take credits, take end_credits) = option.unwrap(relay_boot(take setup))
    let mut state = take booted
    let endpoint = result.unwrap(channel.receive(from))
    let send = l15_send(reg, key, time, 1u32, 0u64, 30u64)
    let short = std.clock.deadline_after_ms(host.mono_ns(time), 1u64)
    // The relay has not taken the Ask. Only its handler deadline can answer.
    match relay_call(endpoint, take send, time, tasks, short) {
        Unanswered(Deadline) => (),
        _ => fail("an expired handler certified an Ask that the relay can still forward"),
    }
    let pending_ask = result.unwrap(channel.try_receive(incoming))
    relay_refund(pending_ask, credits, end_credits)
    relay_step(mut state, take pending_ask)
    if let Ok(RunRequest(_)) = channel.try_receive(forwarded) {} else {
        fail("the handler deadline cancelled the still-live send")
    }
    let _ = std.task.cancel_join(take clock_task)
    Ok(())
}

type EndResume: send {
    endpoint: Relay,
    caller: Caller
}

fn resume_failed_end(take pending_end: EndResume) waits {
    relay_end(pending_end.endpoint, pending_end.caller)
}

@test
fn http_retire_end_credit_survives_owner_failure(tasks: Tasks) -> Result[(), ()] waits {
    let (take world, time) = std.sim.world.new(16u64, 0u64, 0u64)
    let clock_task = task.spawn(tasks, bytes 65536u64, take world, sse_law_sim_clock)
    let reg = result.unwrap(placed(code.describe(http_op_original), HTTP_LAW_PLACE_BYTES))
    let key = http_law_key(reg.exported[0u64])
    let cfg = RelayConfig(http_max: 1u64, sends_max: 1u64, positions_max: 1u64, arg_max: 1024u64)
    let (head, forwarded): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(2u64)
    let (to, from): (Sender[Relay], Receiver[Relay]) = channel.new(1u64)
    let setup = RelayStart(to: take to, head: take head, clock: time, tasks: tasks, config: cfg, inbox_size: option.unwrap(relay_inbox_size(cfg)), key_max: relay_key_max(reg))
    let (take booted, take incoming, take asks, take ends) = option.unwrap(relay_boot(take setup))
    let mut state = take booted
    let endpoint = result.unwrap(channel.receive(from))
    let send = l15_send(reg, key, time, 1u32, 0u64, 30u64)
    let short = std.clock.deadline_after_ms(host.mono_ns(time), 1u64)
    if let Unanswered(Deadline) = relay_call(endpoint, take send, time, tasks, short) {} else {
        return Error(())
    }
    // The older Ask is still charged. An anonymous owner publishes End and
    // fails before consuming its ack. The supervisor resumes that retirement.
    let caller = store.Caller(issuer: 1u8, subject: clone(b"retired subject!"))
    let (ack, failed): (Sender[()], Receiver[()]) = channel.new(1u64)
    result.unwrap(channel.try_send(endpoint.end_credit, ()))
    result.unwrap(channel.try_send(endpoint.inbox, RelayEnd(clone(caller.subject), take ack)))
    let _ = take failed
    let resumed = EndResume(endpoint: relay_endpoint(endpoint), caller: clone(caller))
    let cleanup = task.spawn(tasks, bytes 4096u64, take resumed, resume_failed_end)
    let first = result.unwrap(channel.receive(incoming))
    if let RelayAsk(..) = first {} else {
        fail("the queued Ask was passed by End")
    }
    relay_refund(first, asks, ends)
    relay_step(mut state, take first)
    if let Ok(RunRequest(_)) = channel.try_receive(forwarded) {} else {
        return Error(())
    }
    for _ in 0u64 .. 2u64 {
        let end = result.unwrap(channel.receive(incoming))
        if let RelayEnd(subject, _) = end {
            if subject != caller.subject {
                return Error(())
            }
        } else {
            return Error(())
        }
        if let Error(Empty) = channel.try_receive(forwarded) {} else {
            fail("retired before the relay acknowledged End")
        }
        relay_refund(end, asks, ends)
        relay_step(mut state, take end)
    }
    result.unwrap(task.join(take cleanup))
    if let Ok(RetireCaller(retired)) = channel.try_receive(forwarded) {
        if retired != caller {
            return Error(())
        }
    } else {
        return Error(())
    }
    let _ = task.cancel_join(take clock_task)
    Ok(())
}

fn l15_send(reg: Registry[(), HttpLawHandles], key: Bytes, time: Clock, stream_id: u32, position: u64, milliseconds: u64) -> Send {
    l15_send_for(reg, key, time, stream_id, position, milliseconds, 1u64)
}

fn l15_send_for(reg: Registry[(), HttpLawHandles], key: Bytes, time: Clock, stream_id: u32, position: u64, milliseconds: u64, author: u64) -> Send {
    let mut allowed: List[Bytes] = list.with_capacity(1u64)
    list.push(mut allowed, std.http.copy_bytes(key))
    let now = host.mono_ns(time)
    let mut subject: Bytes = list.with_capacity(64u64)
    list.fill(mut subject, 64u64, int.truncate(author))
    let caller = store.Caller(issuer: 2u8, subject: take subject)
    let context = admitted(take caller, None, take allowed, now, now, 65536u64, 1024u64)
    let stamp: u64 = int.widen(stream_id)
    result.unwrap(prepare_call(reg, context, std.http.copy_bytes(key), store.StreamId(t: stamp, n: stamp << 32u64), position, b"\x05\x00\x00\x00saved", milliseconds))
}

fn l15_delivery(from: Receiver[RelayResult]) -> RelayOutcome waits {
    match channel.receive(from) {
        Ok(Delivered(take answer)) => take answer,
        _ => fail("L15 relay did not deliver an outcome"),
    }
}

fn l15_outcome(item: RelayOutcome) -> Outcome {
    let coding: std.codec.Codec[Outcome] = std.codec.of()
    result.unwrap(std.codec.decode(coding, item.payload))
}

fn l15_told(take message: HeadInput, answer: Outcome) -> RelayEvent {
    let RunRequest(Req(e: Requested(Request(reply_to: RelayReply(take destination), ..)))) = take message else {
        fail("L15 head did not get the relay's position")
    }
    let RelayRecipient(to: _, position, backing: take buffer) = take destination
    let mut backing = take buffer
    relay_fill(answer, mut backing)
    RelayTold(position, RelayOutcome(payload: take backing, replayed: false, expires: None))
}

@test
fn test_l15(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), ()] waits {
    l15_timers(tasks)
    let mut name = string.with_capacity(32u64)
    let directory = result.unwrap(host.mkdtemp(parent, mut name))
    l15_disk(directory, clock, random, tasks, net, false)
    l15_disk(directory, clock, random, tasks, net, true)
    result.unwrap(std.dir.remove_all(parent, name))
    Ok(())
}

fn l15_body(mut tx: store.Tx, h: HttpLawHandles, caller: Caller, take input: HttpOpInput) -> Result[u64, ()] {
    // The CONC-10 sink counts the 37 sends on this body-local channel. The
    // trace still sees a body whose effects get rolled back.
    let (to, _from): (Sender[()], Receiver[()]) = channel.new(37u64)
    for _ in 0u64 .. 37u64 {
        let _ = channel.try_send(to, ())
    }
    http_op_increment(mut tx, h, caller, take input)
}

fn l15_place(mut r: Registry[(), HttpLawHandles]) -> Result[(), RegisterError] {
    transact(mut r, code.describe(l15_body), 65536u64, DEFAULT_STEPS)?
    let binding = http_op_binding(r, "increment", "/old", 201u16)
    bind(mut r, take binding)
}

type L15Drive: send {
    head: Sender[HeadInput],
    publisher: Sender[PubIn],
    clock: Clock,
    random: Random,
    tasks: Tasks,
    net: Net,
    reopening: bool,
}

fn l15_native(take job: L15Drive) waits {
    let L15Drive(head: take head, publisher: take pub_to, clock, random, tasks, net, reopening) = take job
    let reg = result.unwrap(placed(code.describe(l15_place), HTTP_LAW_PLACE_BYTES))
    let (intercept, waiting): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(2u64)
    let cfg = RelayConfig(http_max: 2u64, sends_max: 2u64, positions_max: 1u64, arg_max: 1024u64)
    let (take endpoint, take relay_task, take joined) = l15_start_relay(reg, intercept, pub_to, clock, tasks, cfg)
    let (take listener, address) = result.unwrap(host.listen(net, Addr(ip: V4(0x7f000001u32), port: 0u16), 8u16))
    let seed = HttpOpListener(relay: take endpoint, listener: take listener, publisher: take pub_to, clock, random, tasks, place: code.describe(l15_place), previous: None, retired: None, stage: 0u8, stop: None)
    let server = task.spawn(tasks, bytes 4194304u64, take seed, http_op_serve)
    if reopening {
        for stream_id in 1u32 .. 4u32 {
            let mut replay = l15_post(net, clock, address, stream_id, 0u64, true)
            result.unwrap(channel.send(head, l15_head_request(waiting)))
            l15_response(mut replay, int.widen(stream_id), true)
        }
    } else {
        // No argument reached the handler before this peer disconnected.
        std.http_client.close(l15_post(net, clock, address, 1u32, 0u64, false))
        let mut first = l15_post(net, clock, address, 1u32, 0u64, true)
        result.unwrap(channel.send(head, l15_head_request(waiting)))
        l15_response(mut first, 1u64, false)
        std.http_client.close(take first)
        {
            // The first request's position is already held by the relay.
            // The retry joins it while the head is still processing that send.
            let second = l15_post(net, clock, address, 2u32, 0u64, true)
            let request = l15_head_request(waiting)
            std.http_client.close(take second)
            let mut recovery = l15_post(net, clock, address, 2u32, 0u64, true)
            result.unwrap(channel.receive(joined))
            result.unwrap(channel.send(head, take request))
            l15_response(mut recovery, 2u64, false)
            std.http_client.close(take recovery)
        }
        {
            // Publisher owns Told only after commit. Hold it there, drop the
            // original peer, then release it before issuing the retry.
            let third = l15_post(net, clock, address, 3u32, 0u64, true)
            let (result_to, result_from): (Sender[RelayEvent], Receiver[RelayEvent]) = channel.new(1u64)
            let answer_to = l15_forward(head, result_to, l15_head_request(waiting))
            let told = result.unwrap(channel.receive(result_from))
            std.http_client.close(take third)
            result.unwrap(channel.try_send(answer_to, take told))
            let mut recovery = l15_post(net, clock, address, 3u32, 0u64, true)
            result.unwrap(channel.send(head, l15_head_request(waiting)))
            l15_response(mut recovery, 3u64, true)
            std.http_client.close(take recovery)
        }
        let mut unknown = l15_post(net, clock, address, 4u32, 1u64, true)
        result.unwrap(channel.send(head, l15_head_request(waiting)))
        l15_history_marker(mut unknown)
        std.http_client.close(take unknown)
    }
    let _ = std.task.cancel_join(take server)
    let _ = std.task.cancel_join(take relay_task)
    let _ = take head
}

// A test relay observes Ask decisions before letting the fixture release the
// head. It runs the same charged state and event step as the serving relay.
type L15Relay: send {
    seed: RelayStart,
    joined: Sender[()]
}

fn l15_relay(take input: L15Relay) waits {
    let L15Relay(seed: take setup, joined: take joined) = take input
    let (take ready, take from, take credits, take end_credits) = option.unwrap(relay_boot(take setup))
    let mut state = take ready
    while let Ok(take event) = channel.receive(from) {
        relay_refund(event, credits, end_credits)
        let existing = if let RelayAsk(request, _) = event {
            list.len(state.positions) == 1u64 && state.positions[0u64].stream == request.stream && state.positions[0u64].position == request.p
        } else {
            false
        }
        let before = state.generation
        relay_step(mut state, take event)
        if existing && state.generation != before {
            let _ = channel.try_send(joined, ())
        }
    }
}

fn l15_start_relay(reg: Registry[(), HttpLawHandles], head: Sender[HeadInput], pub_to: Sender[PubIn], clock: Clock, tasks: Tasks, cfg: RelayConfig) -> (Relay, Task[()], Receiver[()]) waits {
    let (ready, from): (Sender[Relay], Receiver[Relay]) = channel.new(1u64)
    let (join_to, joined): (Sender[()], Receiver[()]) = channel.new(1u64)
    let key_max = relay_key_max(reg)
    let seed = RelayStart(to: take ready, head: channel.sender(head), clock: clock, tasks: tasks, config: cfg, inbox_size: option.unwrap(relay_inbox_size(cfg)), key_max: key_max)
    let child = task.spawn(tasks, bytes option.unwrap(relay_child_bytes(cfg, key_max, false)), L15Relay(seed: take seed, joined: take join_to), l15_relay)
    let endpoint = result.unwrap(channel.receive(from))
    let held: List[Option[RelayTell]] = list.with_capacity(cfg.positions_max)
    result.unwrap(channel.send(pub_to, PubIn(e: RelayJoined(take held))))
    (take endpoint, take child, take joined)
}

fn l15_head_request(from: Receiver[HeadInput]) -> HeadInput waits {
    let next = result.unwrap(channel.receive(from))
    if let RunRequest(_) = next {
        return take next
    }
    fail("L15 expected a forwarded request")
}

fn l15_forward(to: Sender[HeadInput], during: Sender[RelayEvent], take msg: HeadInput) -> Sender[RelayEvent] waits {
    let RunRequest(Req(e: Requested(take req))) = take msg else {
        fail("L15 expected a relay request")
    }
    let Request(caller: take caller, stream: take stream_bytes, stream_id, p, key: take key, arg: take arg, digest, deadline, claim: take claim, reply_to: RelayReply(RelayRecipient(to: take answer_to, position, backing: take backing)), live: take live, identity: take identity, seed: take seed) = take req else {
        fail("L15 expected relay reply authority")
    }
    let target = RelayReply(RelayRecipient(to: channel.sender(during), position, backing: take backing))
    let request = Request(caller: take caller, stream: take stream_bytes, stream_id, p, key: take key, arg: take arg, digest, deadline, claim: take claim, reply_to: take target, live: take live, identity: take identity, seed: take seed)
    result.unwrap(channel.send(to, RunRequest(Req(e: Requested(take request)))))
    take answer_to
}

fn l15_request(stream_id: u32, p: u64, close: bool) -> std.http_client.Request {
    let mut fields: List[std.http_client.Header] = list.with_capacity(4u64)
    if close {
        list.push(mut fields, std.http_client.Header(name: "Connection", value: Public(b"close")))
    }
    list.push(mut fields, std.http_client.Header(name: "Content-Type", value: Public(b"application/json")))
    list.push(mut fields, std.http_client.Header(name: "Authorization", value: Public(b"token")))
    let mut header = string.from("\"")
    string.push_uint(mut header, int.widen(stream_id), 16u32, 32u64, '0')
    string.push(mut header, ".")
    string.push_u64(mut header, p)
    string.push(mut header, "\"")
    list.push(mut fields, std.http_client.Header(name: "Idempotency-Key", value: Public(string.into_bytes(take header))))
    std.http_client.Request(method: "POST", target: "/old", headers: take fields, body: Fixed(2u64))
}

fn l15_post(net: Net, clock: Clock, address: Addr, stream_id: u32, p: u64, submit: bool) -> std.http_client.Connection waits {
    let request = l15_request(stream_id, p, true)
    let mut client = result.unwrap(std.http_client.dial(net, address, "a", clock, request, std.clock.deadline_after_ms(host.mono_ns(clock), 4000u64)))
    if submit {
        result.unwrap(std.http_client.write(mut client, b"{}"))
    }
    take client
}

fn l15_history_marker(mut client: std.http_client.Connection) waits {
    result.unwrap(std.http_client.finish_request(mut client, 4096u64))
    let response = std.http_client.head(client)
    if std.http_client.status(response) != 410u16 {
        fail("L15 absent stream with p > 0 must return 410")
    }
    let mut refused = false
    for i in 0u64 .. std.http_client.field_count(response) {
        if let Some((name, value)) = std.http_client.field_at(response, i) {
            if std.http1.equal_ascii(name, b"Idempotent-Outcome") {
                fail("L15 no effect was committed")
            }
            if std.http1.equal_ascii(name, b"Hirsel-Refused") {
                refused = value == b"history_unavailable;key=\"00000000000000000000000000000004.1\""
            }
        }
    }
    if !refused {
        fail("L15 a terminal refusal did not echo the attempt key")
    }
}

fn l15_response(mut client: std.http_client.Connection, number: u64, replayed: bool) waits {
    result.unwrap(std.http_client.finish_request(mut client, 4096u64))
    {
        let response = std.http_client.head(client)
        let mut marked = false
        let mut copied = false
        for i in 0u64 .. std.http_client.field_count(response) {
            if let Some((name, value)) = std.http_client.field_at(response, i) {
                if std.http1.equal_ascii(name, b"Idempotent-Outcome") && value == b"committed" {
                    marked = true
                }
                if std.http1.equal_ascii(name, b"Idempotent-Replayed") && value == b"true" {
                    copied = true
                }
            }
        }
        if std.http_client.status(response) != 201u16 || !marked || copied != replayed {
            fail("L15 status or replay headers differ")
        }
    }
    let mut expected = string.from("\"")
    string.push_u64(mut expected, number)
    string.push(mut expected, "\"")
    let answer = sse_law_body(mut client)
    if answer != string.as_bytes(expected) {
        fail("L15 replayed body or durable counter differs")
    }
}

fn l15_disk(directory: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, reopening: bool) waits {
    let mut options = result.unwrap(store.sized(Directory, 2147483648u64))
    // Keep the replay fixture's fixed IDs across separate process phases.
    options.stream_retention_ms = 18446744073709551615u64
    let db = result.unwrap(store.open(tasks, directory, clock, random, options))
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(16u64)
    let publisher_in = result.unwrap(mailbox(16u64))
    let seed = L15Drive(head: take head, publisher: post(publisher_in), clock, random, tasks, net, reopening)
    let work = task.spawn(tasks, bytes 16777216u64, take seed, l15_native)
    let selection: Selection = if reopening {
        Reopen
    } else {
        Install
    }
    let started = place_head_selected(take db, selection, code.describe(l15_place), HTTP_LAW_PLACE_BYTES, None, code.describe(http_law_schema), take requests, take publisher_in, tasks, 1048576u64)
    if let Error(take problem) = started {
        fail(start_text(Open(take problem)))
    }
    match task.join(take work) {
        Ok(()) => (),
        Error(Failed(causes)) => fail(http_law_cause(causes)),
        Error(Cancelled(causes)) => fail(http_law_cause(causes)),
    }
}

pub fn l15_process(directory: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, argv: Args) -> Result[(), Exit] waits {
    let phase = option.unwrap(args.get(argv, 0u64))
    if phase != "cut" && phase != "recover" {
        return Error(Exit(status: 2u8))
    }
    l15_disk(directory, clock, random, tasks, net, phase == "recover")
    Ok(())
}

type L15RetireDrive: send {
    drive: L15Drive,
    retired: Sender[List[store.StreamKey]]
}

fn l15_fail_after_call(req: std.http.Request, scratch: Region, mut response: std.http.Responder, state: HttpConnection[(), HttpLawHandles, ()]) -> Result[std.http.Outcome, std.http.HandlerError] waits {
    let _ = http_generated_handler(req, scratch, mut response, state)?
    fail("connection task fails after the call's response was prepared")
}

fn l15_retire_drive(take seed: L15RetireDrive) waits {
    let L15RetireDrive(drive: L15Drive(head: take head, publisher: take pub_to, clock, random, tasks, net, ..), retired: take retired_to) = take seed
    let reg = result.unwrap(placed(code.describe(l15_place), HTTP_LAW_PLACE_BYTES))
    let (intercept, waiting): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let cfg = RelayConfig(http_max: 2u64, sends_max: 2u64, positions_max: 1u64, arg_max: 1024u64)
    let (take endpoint, take relay_task, _joined) = l15_start_relay(reg, intercept, pub_to, clock, tasks, cfg)
    let (take listener, address) = result.unwrap(host.listen(net, Addr(ip: V4(0x7f000001u32), port: 0u16), 8u16))
    let (stop, stop_from): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    let job = HttpOpListener(relay: take endpoint, listener: take listener, publisher: take pub_to, clock, random, tasks, place: code.describe(l15_place), previous: None, retired: None, stage: 2u8, stop: Some(take stop_from))
    let server = task.spawn(tasks, bytes 4194304u64, take job, http_op_serve)
    let until = std.clock.deadline_after_ms(host.mono_ns(clock), 4000u64)
    let mut client = result.unwrap(std.http_client.open(net, address, "a", clock, until))
    let mut retired: List[store.StreamKey] = list.with_capacity(4u64)
    for id in 1u32 .. 3u32 {
        result.unwrap(std.http_client.start(mut client, l15_request(id, 0u64, false), until))
        result.unwrap(std.http_client.write(mut client, b"{}"))
        let forwarded = l15_head_request(waiting)
        let name = l15_request_stream(forwarded)
        if name.caller.issuer != 1u8 || list.len(name.caller.subject) != 16u64 {
            fail("request did not bind an anonymous Caller")
        }
        result.unwrap(channel.send(head, take forwarded))
        l15_response(mut client, int.widen(id), false)
        l15_forward_retire(waiting, head, name.caller)
        list.push(mut retired, take name)
    }
    if retired[0u64].caller == retired[1u64].caller {
        fail("keep-alive reused an anonymous Caller")
    }
    // Fail the owner after it has received Told and before it can run the
    // post-response callback. The supervisor recovers the published subject.
    let mut fault = l15_request(3u32, 0u64, false)
    fault.target = "/fail"
    result.unwrap(std.http_client.start(mut client, fault, until))
    result.unwrap(std.http_client.write(mut client, b"{}"))
    let failed_request = l15_head_request(waiting)
    let failed_caller = l15_request_stream(failed_request)
    result.unwrap(channel.send(head, take failed_request))
    l15_forward_retire(waiting, head, failed_caller.caller)
    list.push(mut retired, take failed_caller)
    std.http_client.close(take client)
    client = result.unwrap(std.http_client.open(net, address, "a", clock, until))
    // Stop the next connection while its Ask is already forwarded and it is
    // still waiting for the head. The supervisor must send End after joining.
    result.unwrap(std.http_client.start(mut client, l15_request(4u32, 0u64, false), until))
    result.unwrap(std.http_client.write(mut client, b"{}"))
    let forwarded = l15_head_request(waiting)
    let name = l15_request_stream(forwarded)
    result.unwrap(channel.send(stop, host.mono_ns(clock)))
    let ended = result.unwrap(channel.receive(waiting))
    if let RetireCaller(caller) = ended {
        if caller != name.caller {
            fail("Stop retired a different Caller")
        }
    } else {
        fail("Stop dropped the connection's pending retirement")
    }
    let (result_to, result_from): (Sender[RelayEvent], Receiver[RelayEvent]) = channel.new(1u64)
    let _ = l15_forward(head, result_to, take forwarded)
    let replied = result.unwrap(channel.receive(result_from))
    if let RelayTold(_, answer) = replied {
        if let Returned(_) = l15_outcome(answer) {} else {
            fail("after Stop the forwarded Ask lost its effect")
        }
    } else {
        fail("expected the forwarded Ask's outcome")
    }
    result.unwrap(channel.send(head, take ended))
    list.push(mut retired, take name)
    std.http_client.close(take client)
    result.unwrap(task.join(take server))
    let _ = task.cancel_join(take relay_task)
    result.unwrap(channel.send(retired_to, take retired))
}

fn l15_request_stream(input: HeadInput) -> store.StreamKey {
    match input {
        RunRequest(Req(e: Requested(q))) => store.StreamKey(caller: clone(q.caller), id: q.stream_id),
        _ => fail("expected anonymous request"),
    }
}

fn l15_forward_retire(waiting: Receiver[HeadInput], head: Sender[HeadInput], who: Caller) waits {
    let ended = result.unwrap(channel.receive(waiting))
    match ended {
        RetireCaller(caller) if caller == who => (),
        _ => fail("retirement did not follow the request"),
    }
    result.unwrap(channel.send(head, take ended))
}

@test
fn http_request_retire_after_forward(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), ()] waits {
    let mut location = string.with_capacity(32u64)
    let directory = result.unwrap(host.mkdtemp(parent, mut location))
    let mut options = result.unwrap(store.sized(Directory, 2147483648u64))
    options.stream_retention_ms = 18446744073709551615u64
    let db = result.unwrap(store.open(tasks, directory, clock, random, options))
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(16u64)
    let (retired_to, retired_from): (Sender[List[store.StreamKey]], Receiver[List[store.StreamKey]]) = channel.new(1u64)
    let publisher_in = result.unwrap(mailbox(16u64))
    let drive = L15Drive(head: take head, publisher: post(publisher_in), clock, random, tasks, net, reopening: false)
    let caller_task = task.spawn(tasks, bytes 16777216u64, L15RetireDrive(drive: take drive, retired: take retired_to), l15_retire_drive)
    let started = place_head_selected(take db, Install, code.describe(l15_place), HTTP_LAW_PLACE_BYTES, None, code.describe(http_law_schema), take requests, take publisher_in, tasks, 1048576u64)
    if let Error(take problem) = started {
        fail(start_text(Open(take problem)))
    }
    match task.join(take caller_task) {
        Ok(()) => (),
        Error(Failed(causes)) => fail(http_law_cause(causes)),
        Error(Cancelled(causes)) => fail(http_law_cause(causes)),
    }
    let mut after = result.unwrap(store.open(tasks, directory, clock, random, options))
    let fingerprint = store.request_digest(b"", b"")
    for key in result.unwrap(channel.receive(retired_from)) {
        if let HistoryUnavailable = result.unwrap(store.admit(mut after, key, 1u64, fingerprint)) {} else {
            fail("quiet head retained an anonymous stream")
        }
    }
    result.unwrap(store.close(take after))
    result.unwrap(std.dir.remove_all(parent, location))
    Ok(())
}

type DeliveryCarryDrive: send {
    head: Sender[HeadInput],
    publisher: Sender[PubIn],
    clock: Clock,
    random: Random,
    tasks: Tasks,
    net: Net,
    stage: u8
}

fn delivery_carry_drive(take job: DeliveryCarryDrive) waits {
    let DeliveryCarryDrive(head: take head, publisher: take pub_to, clock, random, tasks, net, stage) = take job
    let definition: HttpOpPlace = code.describe(http_op_original)
    let reg = result.unwrap(placed(definition, HTTP_LAW_PLACE_BYTES))
    let (take relay, take relay_task) = result.unwrap(start_relay(reg, head, pub_to, clock, tasks, RelayConfig(http_max: 2u64, sends_max: 2u64, positions_max: 2u64, arg_max: 1024u64)))
    let (take listener, address) = result.unwrap(host.listen(net, Addr(ip: V4(0x7f000001u32), port: 0u16), 8u16))
    let server_job = HttpOpListener(relay: take relay, listener: take listener, publisher: take pub_to, clock, random, tasks, place: definition, previous: None, retired: None, stage: 0u8, stop: None)
    let server = task.spawn(tasks, bytes 4194304u64, take server_job, http_op_serve)
    if stage == 0u8 {
        // The binding refuses the credential before any head: 401 with no
        // attempt marker, no committed marker and nothing recorded.
        let refused = http_law_post(net, clock, address, "/old", b"expired", 6u32, 0u64, b"{}", 1000u32)
        if refused.status != 401u16 || refused.committed || refused.replayed || !none(refused.refused) || list.len(refused.body) != 0u64 {
            fail("a binding 401 carried a marker or a body")
        }
        // The same identity with a credential the binding accepts runs once.
        let accepted = http_law_post(net, clock, address, "/old", b"token", 6u32, 0u64, b"{}", 1000u32)
        if accepted.status != 201u16 || !accepted.committed || accepted.replayed || accepted.body != b"\"1\"" {
            fail("the refused identity was recorded by the binding 401")
        }
        let again = http_law_post(net, clock, address, "/old", b"token", 6u32, 0u64, b"{}", 1000u32)
        if again.status != 201u16 || !again.committed || !again.replayed || again.body != b"\"1\"" {
            fail("the identity after a binding 401 ran twice")
        }
    } else if stage == 1u8 {
        let first = http_law_post(net, clock, address, "/old", b"token", 6u32, 0u64, b"{}", 1000u32)
        if first.status != 201u16 || !first.committed || first.replayed || first.body != b"\"1\"" {
            fail("the stream's first send did not commit")
        }
    } else {
        let aged = http_law_post(net, clock, address, "/old", b"token", 6u32, 0u64, b"{}", 1000u32)
        if aged.status != 410u16 || aged.committed || aged.replayed || aged.refused != Some(b"history_unavailable;key=\"00000000000000000000000000000006.0\"") {
            fail("an aged stream's retry was not a marked 410")
        }
    }
    let _ = std.task.cancel_join(take server)
    let _ = std.task.cancel_join(take relay_task)
}

fn delivery_carry_cycle(dir: Dir, time: Clock, random: Random, tasks: Tasks, net: Net, retention_ms: u64, stage: u8) waits {
    let mut options = result.unwrap(store.sized(Directory, 2147483648u64))
    options.stream_retention_ms = retention_ms
    let mut db = result.unwrap(store.open(tasks, dir, time, random, options))
    let definition: HttpOpPlace = code.describe(http_op_original)
    let (take reg, take handles, _, take identity) = result.unwrap(head_prepare(mut db, Install, false, definition, None, code.describe(http_law_schema), HTTP_LAW_PLACE_BYTES, tasks))
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(16u64)
    let mail = result.unwrap(mailbox(16u64))
    let seed = DeliveryCarryDrive(head: take head, publisher: post(mail), clock: time, random, tasks, net, stage)
    let work = task.spawn(tasks, bytes 16777216u64, take seed, delivery_carry_drive)
    let started = run_head(take db, take reg, take identity, take handles, definition, HTTP_LAW_PLACE_BYTES, take requests, take mail, tasks, 1048576u64, None, None)
    if let Error(take problem) = started {
        fail(start_text(Open(take problem)))
    }
    match task.join(take work) {
        Ok(()) => (),
        Error(Failed(causes)) => fail(http_law_cause(causes)),
        Error(Cancelled(causes)) => fail(http_law_cause(causes)),
    }
}

// Carry 9 (http.md B-7, sdk.md credential recovery): a binding 401 is
// unmarked and records nothing, so the SDK resends the same identity after a
// fresh credential and it commits once.
@test
fn http_binding_401_unmarked_records_nothing(d: Dir, random: Random, tasks: Tasks, net: Net) -> Result[(), ()] waits {
    let (time, take wall) = provide.clock(0u64, 100u64)
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(d, mut name))
    delivery_carry_cycle(dir, time, random, tasks, net, 3600000u64, 0u8)
    result.unwrap(std.dir.remove_all(d, name))
    let _ = take wall
    Ok(())
}

// Carry 8, HTTP half: stream t = 0 commits at wall 100 under retention
// 3600000. At wall 3600100 its age floor is 100, so the same identity is a
// marked 410. Reopened with retention 10800000 the floor would be absent, but
// the recorded cutoff keeps the marked 410 instead of a replayed 201.
@test
fn http_age_refusal_survives_longer_retention(d: Dir, random: Random, tasks: Tasks, net: Net) -> Result[(), ()] waits {
    let (time, take wall) = provide.clock(0u64, 100u64)
    let mut wall_hand = take wall
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(d, mut name))
    delivery_carry_cycle(dir, time, random, tasks, net, 3600000u64, 1u8)
    clock.set_wall(mut wall_hand, 3600100u64)
    delivery_carry_cycle(dir, time, random, tasks, net, 3600000u64, 2u8)
    delivery_carry_cycle(dir, time, random, tasks, net, 10800000u64, 2u8)
    result.unwrap(std.dir.remove_all(d, name))
    let _ = take wall_hand
    Ok(())
}

type InvisiblePost: send {
    net: Net,
    clock: Clock,
    address: Addr
}

fn invisible_post(take job: InvisiblePost) waits {
    let InvisiblePost(net, clock, address) = take job
    let lost = http_law_post(net, clock, address, "/old", b"token", 7u32, 0u64, b"{}", 1000u32)
    if lost.status != 409u16 || lost.committed || lost.replayed || !lost.retry || !none(lost.refused) {
        fail("an owed send past its deadline was not an unmarked 409")
    }
}

fn invisible_retry_drive(take job: KeyedHorizonDrive) waits {
    let KeyedHorizonDrive(head: take head, publisher: take pub_to, clock: time, hand: take clock_hand, random, tasks, net) = take job
    let mut hand_of = take clock_hand
    let definition: HttpOpPlace = code.describe(http_op_original)
    let reg = result.unwrap(placed(definition, HTTP_LAW_PLACE_BYTES))
    let (intercept, waiting): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(2u64)
    let (take relay, take relay_task) = result.unwrap(start_relay(reg, intercept, pub_to, time, tasks, RelayConfig(http_max: 2u64, sends_max: 2u64, positions_max: 2u64, arg_max: 1024u64)))
    let (take listener, address) = result.unwrap(host.listen(net, Addr(ip: V4(0x7f000001u32), port: 0u16), 8u16))
    let server_job = HttpOpListener(relay: take relay, listener: take listener, publisher: take pub_to, clock: time, random, tasks, place: definition, previous: None, retired: None, stage: 0u8, stop: None)
    let server = task.spawn(tasks, bytes 4194304u64, take server_job, http_op_serve)
    // X's first delivery is held before the head until its 1000 ms send
    // deadline passes, so its client sees only the unmarked 409.
    let first = task.spawn(tasks, bytes 1048576u64, InvisiblePost(net, clock: time, address), invisible_post)
    let held = l15_head_request(waiting)
    clock.advance_to(mut hand_of, 1001000000u64)
    if let Error(_) = task.join(take first) {
        fail("X's lost delivery failed")
    }
    // The held delivery then commits X's one effect, invisible to X, and
    // every later delivery goes straight to the head.
    result.unwrap(channel.send(head, take held))
    let pump = task.spawn(tasks, bytes 65536u64, InvisiblePump(from: take waiting, to: take head), invisible_pump)
    // The Abandoned send kept its slot (V2), so X's retry receives that one
    // run's answer: effect 1, not a second run.
    invisible_expect(http_law_post(net, time, address, "/old", b"token", 7u32, 0u64, b"{}", 1000u32), false, b"\"1\"")
    invisible_expect(http_law_post(net, time, address, "/old", b"token", 7u32, 0u64, b"{}", 1000u32), true, b"\"1\"")
    // Y on a newer stream evicts X at one stream per Caller.
    invisible_expect(http_law_post(net, time, address, "/old", b"token", 8u32, 0u64, b"{}", 1000u32), false, b"\"2\"")
    let aged = http_law_post(net, time, address, "/old", b"token", 7u32, 0u64, b"{}", 1000u32)
    if aged.status != 410u16 || aged.committed || aged.replayed || aged.refused != Some(b"history_unavailable;key=\"00000000000000000000000000000007.0\"") {
        fail("X's retry after eviction was not a marked 410")
    }
    // The 410 ran no body: the next new stream's effect is the third.
    invisible_expect(http_law_post(net, time, address, "/old", b"token", 9u32, 0u64, b"{}", 1000u32), false, b"\"3\"")
    let _ = std.task.cancel_join(take pump)
    let _ = std.task.cancel_join(take server)
    let _ = std.task.cancel_join(take relay_task)
    let _ = take hand_of
}

fn invisible_expect(reply: HttpLawReply, replayed: bool, body: Bytes) {
    if reply.status != 201u16 || !reply.committed || reply.replayed != replayed || reply.body != body || !none(reply.refused) {
        let mut text = string.from("a stream send got another call's effect: ")
        string.push_u64(mut text, int.widen(reply.status))
        string.push(mut text, if reply.committed {
            " committed "
        } else {
            " not committed "
        })
        string.push(mut text, if reply.replayed {
            "replayed "
        } else {
            "fresh "
        })
        if list.len(reply.body) == 3u64 {
            string.push_u64(mut text, int.widen(reply.body[1u64]))
        }
        fail(take text)
    }
}

type InvisiblePump: send {
    from: Receiver[HeadInput],
    to: Sender[HeadInput]
}

fn invisible_pump(take job: InvisiblePump) waits {
    let InvisiblePump(from: take from, to: take to) = take job
    while let Ok(take next) = channel.receive(from) {
        result.unwrap(channel.send(to, take next))
    }
}

// Carry 1 (http.md B-7, B-8; transition rows 4 and 6c): X's first delivery
// commits after its client saw an unmarked 409, the retry gets that run's
// answer and the next one replays it, Y evicts X, X's next retry is a marked 410 that runs nothing, and
// the effects are X = 1, Y = 2, then a new stream 3.
@test
fn http_invisible_retry_keeps_one_effect(d: Dir, random: Random, tasks: Tasks, net: Net) -> Result[(), ()] waits {
    let (time, take wall) = provide.clock(0u64, 100u64)
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(d, mut name))
    let mut options = result.unwrap(store.sized(Directory, 2147483648u64))
    options.streams_per_caller_max = 1u64
    let mut db = result.unwrap(store.open(tasks, dir, time, random, options))
    let definition: HttpOpPlace = code.describe(http_op_original)
    let (take reg, take handles, _, take identity) = result.unwrap(head_prepare(mut db, Install, false, definition, None, code.describe(http_law_schema), HTTP_LAW_PLACE_BYTES, tasks))
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(16u64)
    let mail = result.unwrap(mailbox(16u64))
    let seed = KeyedHorizonDrive(head: take head, publisher: post(mail), clock: time, hand: take wall, random, tasks, net)
    let work = task.spawn(tasks, bytes 16777216u64, take seed, invisible_retry_drive)
    let started = run_head(take db, take reg, take identity, take handles, definition, HTTP_LAW_PLACE_BYTES, take requests, take mail, tasks, 1048576u64, None, None)
    if let Error(take problem) = started {
        fail(start_text(Open(take problem)))
    }
    match task.join(take work) {
        Ok(()) => (),
        Error(Failed(causes)) => fail(http_law_cause(causes)),
        Error(Cancelled(causes)) => fail(http_law_cause(causes)),
    }
    result.unwrap(std.dir.remove_all(d, name))
    Ok(())
}

type Strong[T]: codec via T (to: strong_view, from: strong_from) { value: T }
fn strong_view[T: key](x: Strong[T]) -> View[T] in x { view x.value }
fn strong_from[T: key](take value: T) -> Result[Strong[T], ()] { Ok(Strong(value: value)) }

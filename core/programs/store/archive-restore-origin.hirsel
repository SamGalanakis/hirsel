// Physical coordinates of a verified founding base or a frame in its successor chain.
// frame_end is zero for the base and otherwise names the end in the native unit.
pub type RestoreBoundary: key + shareable + send {
    source_kind: u8,
    base_ordinal: u64,
    base_digest: u64,
    unit: u64,
    epoch: u64,
    unit_digest: u64,
    frame_end: u64
}

pub type RestoreOrigin: shareable + send {
    parent: types.StoreKey,
    binding_id: u64,
    branch: u32,
    version: u64,
    at: u64,
    boundary: RestoreBoundary,
    attempt: Inline[u8, 16],
    capture_attempt: Inline[u8, 16]
}

pub const RESTORE_ORIGIN_KIND: u16 = 0x0071

pub const RESTORE_ORIGIN_PAYLOAD: u64 = 125

pub const RESTORE_ORIGIN_FRAME: u64 = 16 + RESTORE_ORIGIN_PAYLOAD

pub fn restore_origin_bytes(origin: Option[RestoreOrigin]) -> u64 {
    match origin {
        Some(_) => RESTORE_ORIGIN_FRAME,
        None => 0u64,
    }
}

pub fn append_restore_origin(mut raw: Bytes, ctx: format.DiskContext, origin: Option[RestoreOrigin]) -> Result[(), types.Failure] {
    let Some(o) = origin else {
        return Ok(())
    }
    let body = restore_origin_payload(o)?
    let frame = types.capacity(format.disk_seal(ctx, list.len(raw), RESTORE_ORIGIN_KIND, 1, body))?
    types.capacity(list.try_reserve(mut raw, list.len(frame)))?
    list.append(mut raw, frame)
    Ok(())
}

pub fn restore_origin_payload(o: RestoreOrigin) -> Result[Bytes, types.Failure] {
    let mut body: Bytes = list.new()
    types.capacity(list.try_reserve(mut body, RESTORE_ORIGIN_PAYLOAD))?
    list.put_word_le(mut body, o.parent.hi)
    list.put_word_le(mut body, o.parent.lo)
    list.put_word_le(mut body, o.binding_id)
    list.put_word_le(mut body, o.branch)
    list.put_word_le(mut body, o.version)
    list.put_word_le(mut body, o.at)
    let b = o.boundary
    list.push(mut body, b.source_kind)
    list.put_word_le(mut body, b.base_ordinal)
    list.put_word_le(mut body, b.base_digest)
    list.put_word_le(mut body, b.unit)
    list.put_word_le(mut body, b.epoch)
    list.put_word_le(mut body, b.unit_digest)
    list.put_word_le(mut body, b.frame_end)
    for i in 0u64 .. 16 {
        list.push(mut body, o.attempt[i])
    }
    for i in 0u64 .. 16 {
        list.push(mut body, o.capture_attempt[i])
    }
    Ok(take body)
}

fn decode_restore_origin(file: String, frame: format.DiskFrame, payload: Bytes, child: types.StoreKey) -> Result[RestoreOrigin, types.Failure] {
    let Some(origin) = restore_origin_from_payload(payload) else {
        return Error(format.disk_fault(file, frame.payload, Malformed))
    }
    if frame.flags != 1 || origin.parent == child {
        return Error(format.disk_fault(file, frame.payload, Malformed))
    }
    Ok(origin)
}

pub fn restore_origin_from_payload(payload: Bytes) -> Option[RestoreOrigin] {
    if list.len(payload) != RESTORE_ORIGIN_PAYLOAD {
        return None
    }
    let parent = types.StoreKey(hi: format.read_le(payload, 0, 8), lo: format.read_le(payload, 8, 8))
    let source_kind = payload[44]
    let b = RestoreBoundary(source_kind, base_ordinal: format.read_le(payload, 45, 8), base_digest: format.read_le(payload, 53, 8), unit: format.read_le(payload, 61, 8), epoch: format.read_le(payload, 69, 8), unit_digest: format.read_le(payload, 77, 8), frame_end: format.read_le(payload, 85, 8))
    if b.base_ordinal == 0 || b.unit == 0 || source_kind > format.ARCHIVE_SOURCE_OBJECTS {
        return None
    }
    let mut attempt: Inline[u8, 16] =[0; 16]
    let mut capture_attempt: Inline[u8, 16] =[0; 16]
    for i in 0u64 .. 16 {
        capture_attempt[i] = payload[109 + i]
        attempt[i] = payload[93 + i]
    }
    let binding_id = format.read_le(payload, 16, 8)
    if binding_id != 0 && capture_attempt !=[0u8; 16] {
        return None
    }
    Some(RestoreOrigin(parent, binding_id, branch: int.truncate(format.read_le(payload, 24, 4)), version: format.read_le(payload, 28, 8), at: format.read_le(payload, 36, 8), boundary: b, attempt, capture_attempt))
}

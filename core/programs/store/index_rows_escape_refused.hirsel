fn read_in_scope[R](read: scoped[view] fn() -> R) -> R {
    read()
}

// J1: a view callback cannot return an index cursor anchored to its Tx.
pub fn rejected(tx: store.Tx, ix: store.Index[u64, u64, u64, ()]) -> bool {
    let _ = read_in_scope(fn() -> Result[store.IndexRows[u64, u64], store.Error] in tx {
        store.lookup(tx, ix, Unbounded, Unbounded)
    })
    false
}

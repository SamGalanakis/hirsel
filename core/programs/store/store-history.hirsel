fn history_claim_origin(prior: Option[history.HistoryOrigin], epoch: u64, auth: ClaimAuth) -> Result[history.HistoryOrigin, Error] {
    if list.len(auth.attempt) != 16 {
        return Error(Missing("claim_auth"))
    }
    let mut attempt: Inline[u8, 16] =[0; 16]
    for i in 0u64 .. 16 {
        attempt[i] = auth.attempt[i]
    }
    match auth.class {
        Permit => Ok(history.HistoryOrigin(epoch, attempt, class: 0, permit_epoch: epoch, permit_attempt: attempt)),
        Continue => {
            let (pe, pa) = match prior {
                Some(prev) => (prev.permit_epoch, prev.permit_attempt),
                None => (0u64,[0u8; 16]),
            }
            Ok(history.HistoryOrigin(epoch, attempt, class: 1, permit_epoch: pe, permit_attempt: pa))
        },
        Adopt => {
            let (pe, pa) = match prior {
                Some(prev) => (prev.permit_epoch, prev.permit_attempt),
                None => (0u64,[0u8; 16]),
            }
            Ok(history.HistoryOrigin(epoch, attempt, class: 2, permit_epoch: pe, permit_attempt: pa))
        },
    }
}

fn history_claim_head(current: history.HistoryHead, holder: StoreId, auth: ClaimAuth) -> Result[history.HistoryHead, Error] {
    let epoch = failure_result_from_rep(history.history_next_id(current.pair.epoch))?
    let _ = failure_result_from_rep(history.history_next_id(current.entry.seq))?
    let origin = history_claim_origin(current.origin, epoch, auth)?
    let mut candidate = current
    candidate.pair = history.HistoryPair(epoch, holder: store_key_to_rep(holder))
    candidate.origin = Some(origin)
    Ok(candidate)
}

// The caller holds LOCK. The export opener uses the reader and validator
// directly, so it never selects or removes files in the captured directory.
fn read_selected_page_manifest(d: Dir) -> Result[(StoreId, ValidatedPageManifest), Error] waits {
    let (id, take manifest) = read_page_manifest_file(d)?
    Ok((id, select_page_manifest(d, id, take manifest)?))
}

fn publish_page_manifest(d: Dir, id: StoreId, m: PageManifest, target: Option[TargetLimits], mut scratch: Bytes) -> Result[(), Error] waits {
    fill_page_manifest_file(mut scratch, id, m)?
    if let Some(wanted) = target {
        let none = new_page_locations()
        validate_new_page_manifest(d, id, scratch, wanted, SettledPacks(below: 0, locations: view none))?
    }
    publish_page_manifest_bytes(d, scratch)
}

// Independently encoded from AP3, AP14 (Format 12, no `retired` root), AP20 and §13.1
// using libxxhash.
// The 29-byte pack row has a zero index offset. Both live PAGEs start at byte 72.
fn page_manifest_vector() -> Bytes {
    let words: Inline[u64, 65] =[
        0x0000003800010001,
        0xefe8d888afc8637d,
        0x45524f5453524948,
        0x000000010000000c,
        0x0000000000000001,
        0x0000000000000002,
        0x0000000000000000,
        0x0000000000000001,
        0x0000000000000000,
        0x000001ab00010031,
        0xdbb751b234869054,
        0x0000000000000001,
        0x0100000000ff0000,
        0x0100004000000400,
        0x0000000000000003,
        0x0000000100000001,
        0x0000000000000003,
        0x0000000000000001,
        0x0000000000000001,
        0x000000000000004e,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000200000000,
        0x0000004800000000,
        0x0000004400000000,
        0xc222e9723fa736a5,
        0x0000000000000002,
        0x0000000000000001,
        0x00006e69616d0004,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0001000000000000,
        0x0048000000000000,
        0x0021000000000000,
        0x8df641cc33c60000,
        0x000000000001222e,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
    ]
    let mut raw: Bytes = list.with_capacity(520)
    for word in words {
        list.put_word_le(mut raw, word)
    }
    list.truncate(mut raw, 515)
    take raw
}


fn store_key_to_rep(take value: StoreId) -> types.StoreKey {
    let StoreId(hi: hi, lo: lo) = take value
    types.StoreKey(hi: hi, lo: lo)
}

fn store_key_from_rep(take value: types.StoreKey) -> StoreId {
    let types.StoreKey(hi: hi, lo: lo) = take value
    StoreId(hi: hi, lo: lo)
}

fn limits_to_rep(take value: StoreLimits) -> types.LimitsRep {
    let StoreLimits(frame: frame, value: value_max, meta: meta) = take value
    types.LimitsRep(frame: frame, value: value_max, meta: meta)
}

fn limits_from_rep(take value: types.LimitsRep) -> StoreLimits {
    let types.LimitsRep(frame: frame, value: value_max, meta: meta) = take value
    StoreLimits(frame: frame, value: value_max, meta: meta)
}

fn fault_to_rep(take value: Fault) -> types.FaultRep {
    let Fault(file: take file, offset: offset, why: why) = take value
    types.FaultRep(file: take file, offset: offset, why: why_to_rep(why))
}

fn fault_from_rep(take value: types.FaultRep) -> Fault {
    let types.FaultRep(file: take file, offset: offset, why: why) = take value
    Fault(file: take file, offset: offset, why: why_from_rep(why))
}

fn why_to_rep(take value: Why) -> types.WhyRep {
    match take value {
        Checksum => Checksum,
        Truncated => Truncated,
        Flags => Flags,
        Kind(item) => Kind(item),
        Header => Header,
        Gap(item) => Gap(item),
        Order => Order,
        Dangling(item) => Dangling(item),
        Absent => Absent,
        Malformed => Malformed,
        Regressed => Regressed,
    }
}

fn why_from_rep(take value: types.WhyRep) -> Why {
    match take value {
        Checksum => Checksum,
        Truncated => Truncated,
        Flags => Flags,
        Kind(item) => Kind(item),
        Header => Header,
        Gap(item) => Gap(item),
        Order => Order,
        Dangling(item) => Dangling(item),
        Absent => Absent,
        Malformed => Malformed,
        Regressed => Regressed,
    }
}

fn capacity_to_rep(take value: StoreCapacity) -> types.CapacityRep {
    match take value {
        Journal(item) => Journal(item),
        Resident(item) => Resident(item),
        Allocation(item) => Allocation(item),
        Cache(item) => Cache(item),
        Slots(item) => Slots(item),
        Pins(item) => Pins(item),
        Register(item) => Register(item),
    }
}

fn capacity_from_rep(take value: types.CapacityRep) -> StoreCapacity {
    match take value {
        Journal(item) => Journal(item),
        Resident(item) => Resident(item),
        Allocation(item) => Allocation(item),
        Cache(item) => Cache(item),
        Slots(item) => Slots(item),
        Pins(item) => Pins(item),
        Register(item) => Register(item),
    }
}

fn failure_to_rep(take value: Error) -> types.Failure {
    match take value {
        Held => Held,
        NotFound => NotFound,
        Corrupt(take item) => Corrupt(fault_to_rep(take item)),
        Unsupported(item) => Unsupported(item),
        Io(item) => Io(item),
        Poisoned(item) => Poisoned(item),
        Full(item) => Full(capacity_to_rep(item)),
        Limit(item) => Limit(limit_to_rep(item)),
        Schema(item) => Schema(item),
        Stale(item) => Stale(item),
        Decode(item) => Decode(item),
        Exists(take item) => Exists(take item),
        Missing(take item) => Missing(take item),
        Changed(take item) => Changed(take item),
        Conflict(take item) => Conflict(take item),
        Undeclared(take item) => Undeclared(take item),
        NoLevel(take item) => NoLevel(take item),
        Behind(item) => Behind(position_to_rep(item)),
        Gone(item) => Gone(item),
        Unseen(item) => Unseen(item),
        Diverged(item) => Diverged(item),
        Foreign => Foreign,
        MigrationFault => MigrationFault,
        ExportDirectory => ExportDirectory,
        Fenced(item) => Fenced(item),
        Lost => Lost,
        Superseded(take item) => Superseded(claim_to_rep(take item)),
        Undecided => Undecided,
        Declared(take item) => Declared(take item),
        NotCurrent(item) => NotCurrent(item),
        Endpoint(item) => Endpoint(endpoint_refusal_to_rep(item)),
        HistoryMissing(take value_0, value_1) => HistoryMissing(take value_0, value_1),
        Reclaimed(item) => Reclaimed(item),
        Retired => Retired,
        Remote(take item) => Remote(take item),
        Missed => Missed,
        Tiered(item) => Tiered(tiered_refusal_to_rep(item)),
        NotReady(take item) => NotReady(take item),
        Drift(take item) => Drift(take item),
        LimitsDiffer(item) => LimitsDiffer(limits_to_rep(item)),
        Attached(item) => Attached(optional_host_stream_id_to_rep(item)),
        Stream(item) => Stream(stream_refusal_to_rep(item)),
        Latched(item) => Latched(item),
    }
}

fn failure_from_rep(take value: types.Failure) -> Error {
    match take value {
        Held => Held,
        NotFound => NotFound,
        Corrupt(take item) => Corrupt(fault_from_rep(take item)),
        Unsupported(item) => Unsupported(item),
        Io(item) => Io(item),
        Poisoned(item) => Poisoned(item),
        Full(item) => Full(capacity_from_rep(item)),
        Limit(item) => Limit(limit_from_rep(item)),
        Schema(item) => Schema(item),
        Stale(item) => Stale(item),
        Decode(item) => Decode(item),
        Exists(take item) => Exists(take item),
        Missing(take item) => Missing(take item),
        Changed(take item) => Changed(take item),
        Conflict(take item) => Conflict(take item),
        Undeclared(take item) => Undeclared(take item),
        NoLevel(take item) => NoLevel(take item),
        Behind(item) => Behind(position_from_rep(item)),
        Gone(item) => Gone(item),
        Unseen(item) => Unseen(item),
        Diverged(item) => Diverged(item),
        Foreign => Foreign,
        MigrationFault => MigrationFault,
        ExportDirectory => ExportDirectory,
        Fenced(item) => Fenced(item),
        Lost => Lost,
        Superseded(take item) => Superseded(claim_from_rep(take item)),
        Undecided => Undecided,
        Declared(take item) => Declared(take item),
        NotCurrent(item) => NotCurrent(item),
        Endpoint(item) => Endpoint(endpoint_refusal_from_rep(item)),
        HistoryMissing(take value_0, value_1) => HistoryMissing(take value_0, value_1),
        Reclaimed(item) => Reclaimed(item),
        Retired => Retired,
        Remote(take item) => Remote(take item),
        Missed => Missed,
        Tiered(item) => Tiered(tiered_refusal_from_rep(item)),
        NotReady(take item) => NotReady(take item),
        Drift(take item) => Drift(take item),
        LimitsDiffer(item) => LimitsDiffer(limits_from_rep(item)),
        Attached(item) => Attached(optional_host_stream_id_from_rep(item)),
        Stream(item) => Stream(stream_refusal_from_rep(item)),
        Latched(item) => Latched(item),
    }
}


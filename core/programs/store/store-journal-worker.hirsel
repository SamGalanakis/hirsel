type JournalMsg: send = Frame(Bytes, u64) | Rotate(HostFile, HostFile, Bytes) | Barrier | IdleCheck | ObjectPause(Sender[ObjectJournalStart], Receiver[ObjectJournalStart]) | ObjectFresh(Sender[Result[(), Error]], u64) | ObjectSkipFence(Sender[Result[(), Error]]) | ObjectExportRead(journal.ObjectExportFetch) | StreamAnswer(journal.SlotAck) | ObjectClose(Sender[Result[(), Error]]) | Flush

type JournalIdleTimer: send {
    clock: Clock,
    requests: Receiver[()],
    journal: Sender[JournalMsg],
    interval_ns: u64
}

fn journal_idle_timer(take timer: JournalIdleTimer) waits {
    while let Ok(()) = channel.receive(timer.requests) {
        std.clock.sleep_ns(timer.clock, timer.interval_ns)
        if let Error(_) = channel.send(timer.journal, IdleCheck) {
            return
        }
    }
}

pub fn main(tasks: Tasks, out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let Some(number) = args.get(argv, 0) else { return Error(Exit(status: 2)) }
    let rounds: u64 = result.unwrap(int.parse(number))
    let (checksum, completed) = result.unwrap(matmul.parallel_work(tasks, 256, 16, rounds))
    let mut line = string.new()
    string.push_u64(mut line, completed)
    string.push(mut line, " ")
    string.push_u64(mut line, int.widen(checksum))
    string.push(mut line, "\n")
    result.unwrap(stdout.write(out, line))
    Ok(())
}

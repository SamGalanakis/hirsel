// FAIL-15 quiescence across independent simulations (failure.md, FAIL-15):
// before a run stops with Deadlock, each clock.idle wait is woken with its
// clock's earliest pending deadline, and if none of them advances time, each
// server waiting in provide.next with no queued call is woken with None.
type IdleDriver: send {
    hand: ClockHand,
    stop: Receiver[()]
}

// Drives one simulation's virtual clock: advances to each deadline idle
// answers and, when it answers None, asks again unless told to stop.
fn idle_driver(take input: IdleDriver) waits {
    let IdleDriver(hand: take h, stop: take stop) = take input
    let mut hand = take h
    loop {
        match clock.idle(mut hand) {
            Some(at) => clock.advance_to(mut hand, at),
            None => if let Ok(()) = channel.try_receive(stop) {
                return
            }
        }
    }
}

fn idle_server(take s: Served[DirOp]) -> bool waits {
    let mut served = take s
    match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
}

// FAIL-15: two independent simulations, each a served Dir and a driver on
// its own virtual clock. Simulation a's driver is stopped and its server
// joined while b's driver still runs. No sleeper is pending on either clock,
// so every woken idle wait answers None and none advances time: each server
// waiting in next with no queued call is woken with None, and a's join
// returns while b's driver is still asking.
// expect: run independent_quiescence(tasks) = true
fn independent_quiescence(tasks: Tasks) -> bool waits {
    let (_ca, ha) = provide.clock(0, 0)
    let (_cb, hb) = provide.clock(0, 0)
    let (_da, sa) = provide.dir(bytes 64)
    let (_db, sb) = provide.dir(bytes 64)
    let (stop_a, stopping_a): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (stop_b, stopping_b): (Sender[()], Receiver[()]) = channel.new(1u64)
    let driver_a = task.spawn(tasks, bytes 65536, IdleDriver(hand: take ha, stop: take stopping_a), idle_driver)
    let driver_b = task.spawn(tasks, bytes 65536, IdleDriver(hand: take hb, stop: take stopping_b), idle_driver)
    let server_a = task.spawn(tasks, bytes 65536, take sa, idle_server)
    let server_b = task.spawn(tasks, bytes 65536, take sb, idle_server)
    result.unwrap(channel.send(stop_a, ()))
    let ended_a = result.unwrap(task.join(take server_a))
    result.unwrap(task.join(take driver_a))
    result.unwrap(channel.send(stop_b, ()))
    result.unwrap(task.join(take driver_b))
    let ended_b = result.unwrap(task.join(take server_b))
    ended_a && ended_b
}

fn conn_waiter(take i: Inbox[u32]) -> u32 waits {
    match conn.receive(i) {
        Ok(n) => n,
        Error(_) => 0,
    }
}

// FAIL-15 and Cells: clock.idle waits until every other task waits. A task
// waiting in conn.receive on a connection whose every client is in this unit
// waits like a channel receive: with no other unit, nothing but this unit's
// tasks can settle it, so the sleeper's deadline is answered and the sleep
// returns. The waiter is then sent 7 and returns it.
// expect: run idle_past_a_local_connection_wait(tasks) = 7
fn idle_past_a_local_connection_wait(tasks: Tasks) -> u32 waits {
    let (c, h) = provide.clock(0, 0)
    let (stop, stopping): (Sender[()], Receiver[()]) = channel.new(1u64)
    let driver = task.spawn(tasks, bytes 65536, IdleDriver(hand: take h, stop: take stopping), idle_driver)
    let made: Result[(Client[u32], Inbox[u32]), Capacity] = conn.new(1, bytes 0)
    let (client, take inbox) = result.unwrap(take made)
    let waiter = task.spawn(tasks, bytes 65536, take inbox, conn_waiter)
    host.sleep_until(c, 1000000)
    result.unwrap(conn.send(client, 7u32))
    let got = result.unwrap(task.join(take waiter))
    result.unwrap(channel.send(stop, ()))
    result.unwrap(task.join(take driver))
    got
}

type Across: cross {
    back: Client[Client[u32]],
    poke: Client[u32]
}

// The helper unit's root task waits in conn.receive on its own connection,
// whose client it has handed to the root unit. Once answered n and closed (so
// no client outlives it), it sends n + 1 to the root unit's waiter and
// returns n.
fn across_helper(take a: Across) -> u32 waits {
    let Across(back: take back, poke: take poke) = take a
    let made: Result[(Client[u32], Inbox[u32]), Capacity] = conn.new(1, bytes 0)
    let (client, take inbox) = result.unwrap(take made)
    result.unwrap(conn.send(back, take client))
    let n = result.unwrap(conn.receive(inbox))
    let closed = match conn.receive(inbox) {
        Error(Closed) => 1u32,
        _ => 0u32
    }
    result.unwrap(conn.send(poke, n + closed))
    n
}

// Send n on the last client, which this drops.
fn send_last(take to: Client[u32], n: u32) waits {
    result.unwrap(conn.send(to, n))
}

// FAIL-15 and Cells across units: clock.idle waits until every task in every
// unit of the run waits on something inside the run. Each unit has a task in
// conn.receive on a connection only the other unit settles, and the root
// sleeps on the virtual clock: the whole run is quiet, so the driver's idle
// answers the sleep's deadline. The root then sends 7 to the helper, which
// sends 8 to the root unit's waiter: 8 + 7.
// expect: run idle_past_connection_waits_across_units(tasks) = 15
fn idle_past_connection_waits_across_units(tasks: Tasks) -> u32 waits {
    let (c, h) = provide.clock(0, 0)
    let (stop, stopping): (Sender[()], Receiver[()]) = channel.new(1u64)
    let driver = task.spawn(tasks, bytes 65536, IdleDriver(hand: take h, stop: take stopping), idle_driver)
    let made: Result[(Client[u32], Inbox[u32]), Capacity] = conn.new(1, bytes 0)
    let (poke, take poked) = result.unwrap(take made)
    let waiter = task.spawn(tasks, bytes 65536, take poked, conn_waiter)
    let backs: Result[(Client[Client[u32]], Inbox[Client[u32]]), Capacity] = conn.new(1, bytes 0)
    let (back, take answers) = result.unwrap(take backs)
    let helper = result.unwrap(task.spawn_unit(tasks, bytes 4096, Across(back: take back, poke: take poke), across_helper))
    let there = result.unwrap(conn.receive(answers))
    host.sleep_until(c, 1000000)
    send_last(take there, 7u32)
    let got = result.unwrap(task.join(take waiter))
    let sent = result.unwrap(task.join(take helper))
    result.unwrap(channel.send(stop, ()))
    result.unwrap(task.join(take driver))
    got + sent
}

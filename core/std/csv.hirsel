// ADAPTED from Goose stdlib/csv.goose:19-69 and Go encoding/csv reader.go:297-460.
pub type Dialect: key {
    delimiter: u8,
    crlf: bool
}

pub type Field: key {
    span: http1.Span,
    quoted: bool
}

pub type Next: key = Record(u64) | End | Need

pub type Error = Invalid(u64) | NotUtf8(u64) | Capacity(Capacity)

pub opaque type Writer {
    d: Dialect,
    fields: u64,
    empty_first: bool
}

fn check_delimiter(d: Dialect) {
    if d.delimiter >= 128 || d.delimiter == b'"' || d.delimiter == 13 || d.delimiter == 10 {
        fail("csv: delimiter must be ASCII and distinct from quote, CR and LF")
    }
}

fn buffer_end(at: u64, eof: bool) -> Next {
    if eof {
        Record(at)
    } else {
        Need
    }
}

fn line_end(text: Bytes, at: u64, eof: bool) -> Result[Next, Error] {
    if text[at] == 10 {
        return Ok(Record(at + 1))
    }
    let n = list.len(text)
    if text[at] == 13 {
        if at + 1 == n && !eof {
            return Ok(Need)
        }
        if at + 1 < n && text[at + 1] == 10 {
            return Ok(Record(at + 2))
        }
    }
    Error(Invalid(at))
}

// Scan only complete blocks. A quote ends a quoted run, whereas an
// unquoted run ends at any of the four structural bytes.
fn scan_field_blocks(text: Bytes, start: u64, delimiter: u8, quoted: bool) -> u64 {
    let quote: Simd[u8, 32] = simd.splat(b'"')
    let sep: Simd[u8, 32] = simd.splat(delimiter)
    let cr: Simd[u8, 32] = simd.splat(13)
    let lf: Simd[u8, 32] = simd.splat(10)
    let n = list.len(text)
    let mut i = start
    while n - i >= 32 {
        let block: Simd[u8, 32] = list.lanes(text, i)
        let quotes = simd.eq(block, quote)
        let mask = if quoted {
            simd.bitmask(quotes)
        } else {
            simd.bitmask(quotes | simd.eq(block, sep) | simd.eq(block, cr) | simd.eq(block, lf))
        }
        if mask != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(mask))
            return i + offset
        }
        i += 32
    }
    i
}

fn zero_byte_mask(word: u64) -> u64 {
    // Borrow can add higher bits. The first marked byte is always exact.
    int.wrapping_sub(word, 0x0101010101010101) & ~word & 0x8080808080808080
}

fn field_stop(text: Bytes, start: u64, delimiter: u8, quoted: bool) -> u64 {
    let n = list.len(text)
    let sep: u64 = int.widen(delimiter)
    let spread = sep * 0x0101010101010101
    let mut i = start
    // Test nearby terminators before taking the vector path.
    for _ in 0u32 .. 2 {
        if n - i < 8 {
            break
        }
        let word = list.word_le(text, i)
        let quotes = zero_byte_mask(word ^ 0x2222222222222222)
        let mask = if quoted {
            quotes
        } else {
            quotes | zero_byte_mask(word ^ spread) | zero_byte_mask(word ^ 0x0d0d0d0d0d0d0d0d) | zero_byte_mask(word ^ 0x0a0a0a0a0a0a0a0a)
        }
        if mask != 0 {
            let bit: u64 = int.widen(int.trailing_zeros(mask))
            return i + (bit >> 3)
        }
        i += 8
    }
    if n - i >= 32 {
        i = scan_field_blocks(text, i, delimiter, quoted)
    }
    while i < n {
        let c = text[i]
        if c == b'"' || (!quoted && (c == delimiter || c == 13 || c == 10)) {
            return i
        }
        i += 1
    }
    i
}

/// Clears fields and scans the record at at. Record(next) advances past its line end.
/// End means EOF at at. Need means re-offer the same at after appending input,
/// including when a final CR could still be followed by LF.
/// Fails: Invalid(i) at a grammar error, Capacity(c) on growth, Fail for an
/// invalid delimiter, or Bounds when at exceeds len(text). After failure fields
/// holds an unspecified prefix. Field spans borrow their meaning from text.
/// Alloc: GROWTH of fields only. Cost: O(record length) per call. Grow the
/// input buffer geometrically when retrying a long record.
/// Ex: `let next = csv.record(buf, at, csv.Dialect(delimiter: 44, crlf: false), true, mut fields)?`.
pub fn record(text: Bytes, at: u64, d: Dialect, eof: bool, mut fields: List[Field]) -> Result[Next, Error] {
    list.clear(mut fields)
    check_delimiter(d)
    let n = list.len(text)
    if at == n {
        return Ok(if eof {
            End
        } else {
            Need
        })
    }
    if text[at] == 10 || text[at] == 13 {
        return line_end(text, at, eof)
    }
    let mut i = at
    loop {
        let quoted = i < n && text[i] == b'"'
        let start = if quoted {
            i + 1
        } else {
            i
        }
        let mut stop = start
        if quoted {
            loop {
                stop = field_stop(text, stop, d.delimiter, true)
                if stop == n {
                    return if eof {
                        Error(Invalid(i))
                    } else {
                        Ok(Need)
                    }
                }
                if stop + 1 == n || text[stop + 1] != b'"' {
                    break
                }
                stop += 2
            }
            i = stop + 1
        } else {
            stop = field_stop(text, stop, d.delimiter, false)
            if stop < n && text[stop] == b'"' {
                return Error(Invalid(stop))
            }
            i = stop
        }
        let next = if i == n {
            buffer_end(i, eof)
        } else if text[i] == d.delimiter {
            Record(i + 1)
        } else {
            line_end(text, i, eof)?
        }
        if next == Need {
            return Ok(Need)
        }
        if let Error((c, _)) = list.push(mut fields, Field(span: http1.Span(start: start, end: stop), quoted: quoted)) {
            return Error(Capacity(c))
        }
        if i == n || text[i] != d.delimiter {
            return Ok(next)
        }
        i += 1
    }
}

fn scalar_width(lead: u8) -> u64 {
    if lead < 0x80 {
        1
    } else if lead < 0xe0 {
        2
    } else if lead < 0xf0 {
        3
    } else {
        4
    }
}

fn scalar_code(b: Bytes, at: u64, width: u64) -> u32 {
    let lead = b[at]
    let mut code: u32 = int.widen(if width == 1 {
        lead
    } else if width == 2 {
        lead & 0x1f
    } else if width == 3 {
        lead & 0x0f
    } else {
        lead & 0x07
    })
    for k in 1u64 .. width {
        let bits: u32 = int.widen(b[at + k] & 0x3f)
        code = (code << 6) | bits
    }
    code
}

fn valid_scalar(b: Bytes, at: u64, width: u64) -> bool {
    if width == 1 {
        return true
    }
    let lead = b[at]
    if lead < 0xc2 || lead > 0xf4 || list.len(b) - at < width {
        return false
    }
    let second = b[at + 1]
    if (lead == 0xe0 && second < 0xa0) || (lead == 0xed && second >= 0xa0) || (lead == 0xf0 && second < 0x90) || (lead == 0xf4 && second >= 0x90) {
        return false
    }
    for k in 1u64 .. width {
        if b[at + k] & 0xc0 != 0x80 {
            return false
        }
    }
    true
}

fn doubled(b: Bytes, i: u64, quoted: bool) -> bool {
    quoted && b[i] == b'"' && i + 1 < list.len(b) && b[i + 1] == b'"'
}

/// Appends a field's value, undoubling quotes for a quoted field. For raw bytes,
/// use `list.slice(text, f.span.start, f.span.end)`.
/// Fails: Bounds for a bad span, NotUtf8(i) at the first invalid scalar start,
/// or Capacity(c). Validates and reserves before writing, so out is unchanged
/// on failure. Alloc: GROWTH of out. Cost: O(span).
/// Ex: `csv.field_text(buf, fields[i], mut value)?`.
pub fn field_text(text: Bytes, f: Field, mut out: String) -> Result[(), Error] {
    let b = list.slice(text, f.span.start, f.span.end)
    let n = list.len(b)
    let mut size = n
    let mut i: u64 = 0
    while i < n {
        let width = scalar_width(b[i])
        if !valid_scalar(b, i, width) {
            return Error(NotUtf8(f.span.start + i))
        }
        if doubled(b, i, f.quoted) {
            size -= 1
            i += 2
        } else {
            i += width
        }
    }
    if let Error(c) = string.reserve(mut out, size) {
        return Error(Capacity(c))
    }
    i = 0
    while i < n {
        let width = scalar_width(b[i])
        let scalar = option.unwrap(char.from_u32(scalar_code(b, i, width)))
        let _ = string.push_char(mut out, scalar)
        i += if doubled(b, i, f.quoted) {
            2
        } else {
            width
        }
    }
    Ok(())
}

/// Starts a writer at the beginning of a record. Fails: Fail for an invalid
/// delimiter. Alloc: nothing. Cost: O(1).
/// Ex: `let mut w = csv.writer(csv.Dialect(delimiter: 44, crlf: false))`.
pub fn writer(d: Dialect) -> Writer {
    check_delimiter(d)
    Writer(d: d, fields: 0, empty_first: false)
}

/// Appends a delimiter after the first field, then value. Quotes fields
/// containing delimiter, quote, CR or LF, and doubles each embedded quote.
/// A sole empty field is quoted by end. Fails: Capacity(c), leaving out and w
/// unchanged. Alloc: GROWTH of out, reserved before writing. Cost: O(len value).
/// Ex: `csv.field(mut w, mut out, "a,b")?`.
pub fn field(mut w: Writer, mut out: String, value: String) -> Result[(), Capacity] {
    let b = string.as_bytes(value)
    let n = list.len(b)
    let mut quoted = false
    let mut quotes: u64 = 0
    for c in b {
        if c == w.d.delimiter || c == b'"' || c == 13 || c == 10 {
            quoted = true
            if c == b'"' {
                quotes += 1
            }
        }
    }
    let prefix: u64 = if w.fields == 0 {
        0
    } else {
        1
    }
    let wrapper: u64 = if quoted {
        2
    } else {
        0
    }
    string.reserve(mut out, prefix + wrapper + n + quotes)?
    if prefix != 0 {
        let code: u32 = int.widen(w.d.delimiter)
        let _ = string.push_char(mut out, option.unwrap(char.from_u32(code)))
    }
    if quoted {
        let _ = string.push(mut out, "\"")
        let mut start: u64 = 0
        for i in 0u64 .. n {
            if b[i] == b'"' {
                let _ = string.push(mut out, string.slice(value, start, i + 1))
                let _ = string.push(mut out, "\"")
                start = i + 1
            }
        }
        let _ = string.push(mut out, string.slice(value, start, n))
        let _ = string.push(mut out, "\"")
    } else {
        let _ = string.push(mut out, value)
    }
    if w.fields == 0 {
        w.empty_first = n == 0
    }
    // The writer only distinguishes zero, one and multiple fields.
    if w.fields < 2 {
        w.fields += 1
    }
    Ok(())
}

/// Appends the configured line end, inserting `""` first for a sole empty
/// field, then resets the writer for the next record. A zero-field record is
/// an empty line. Fails: Capacity(c), leaving out and w unchanged.
/// Alloc: GROWTH of out. Cost: O(1) excluding growth.
/// Ex: `csv.end(mut w, mut out)?`.
pub fn end(mut w: Writer, mut out: String) -> Result[(), Capacity] {
    let single_empty = w.fields == 1 && w.empty_first
    if w.d.crlf {
        string.push(mut out, if single_empty {
            "\"\"\r\n"
        } else {
            "\r\n"
        })?
    } else {
        string.push(mut out, if single_empty {
            "\"\"\n"
        } else {
            "\n"
        })?
    }
    w.fields = 0
    w.empty_first = false
    Ok(())
}

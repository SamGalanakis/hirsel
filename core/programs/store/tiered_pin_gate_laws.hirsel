// L88 (b), the v2.96 row: main deletes A's rows, so no head reaches A. Cut 1
// probes A (PACK_INDEX row 0), finds no match and publishes with P's cursor
// at 1. pin(S) at cut 2 finds A in no lookup root, and A is behind the
// cursor, so the pin copies it with its stamp. Later cuts move F and the
// rest and retire P, and the pin reads A after P's Remove and after a
// reopen. Seeded bug `promote_behind_cursor` (`promotion_can_keep` ignores
// the cursor): the pin keeps A in P, and P retires under it.
fn gate_l88_behind_cursor(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let fixture = gate_l88_fixture(d, c, r, tasks)?
    let rows: Table[u64, Bytes] = clone(fixture.rows)
    let mut db = open(tasks, d, c, r, fixture.options)?
    let s = snapshot(db)
    let first = fixture.leaves[0u64]
    gate_delete_rows(mut db, rows, first.first, first.first + first.rows)?
    let _ = checkpoint(mut db)?
    if !compact_listed(db, fixture.pack) || gate_probe_rows(db, fixture.pack) != 1 {
        fail("L88 (b): cut 1 probes A, matches nothing, and leaves P's cursor at 1")
    }
    let pinned_db = gate_pin_cut(d, c, r, tasks, fixture.options, take db, "s", take s, crash)?
    let _ = gate_walk_all(d, pinned_db, rows.id)?
    gate_l88_finish(d, c, r, tasks, fixture, take pinned_db, "s", map.new(), gate_leaf_rows(first), map.new(), gate_pin_kept(crash))
}

// L88 (d): main deletes A's and F's rows, and P's probe moves the other
// leaves and retires P while S's lease keeps its file. Pins P1 and P2 of S
// publish at consecutive cuts. P1 finds A and F nowhere and P unlisted, so
// it copies them with their stamps; P2's lookups include P1's root and take
// P1's copies. Stamps 30 and 31 each have one location. Seeded bug
// `promote_copies_each` (a promotion's lookups skip the other holders): P2
// copies A and F again.
fn gate_l88_two_pins(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let fixture = gate_l88_fixture(d, c, r, tasks)?
    let rows: Table[u64, Bytes] = clone(fixture.rows)
    let mut db = open(tasks, d, c, r, fixture.options)?
    let s = snapshot(db)
    let first = fixture.leaves[0u64]
    let second = fixture.leaves[1u64]
    gate_delete_rows(mut db, rows, first.first, second.first + second.rows)?
    let mut deleted = gate_leaf_rows(first)
    for key in second.first .. second.first + second.rows {
        map.insert(mut deleted, key, ())
    }
    let _ = gate_settle(d, mut db, rows.id, fixture.pack, 4 * fixture.frames + 8)?
    let _ = pin(mut db, "p1", s)?
    let _ = gate_walk_all(d, db, rows.id)?
    let pinned_db = gate_pin_cut(d, c, r, tasks, fixture.options, take db, "p2", take s, crash)?
    let _ = gate_walk_all(d, pinned_db, rows.id)?
    gate_pin_rows(pinned_db, "p1", rows, map.new())?
    gate_l88_finish(d, c, r, tasks, fixture, take pinned_db, "p2", map.new(), take deleted, map.new(), gate_pin_kept(crash))
}

// L88 (e), trace (e): S0 is captured while R is main's root; main
// overwrites a row of F; cut 1 moves A to A′ with stamp 30 and P stays
// listed with its cursor at 1. S1 is captured (its root R₂ names A′); main
// overwrites a row of A′. pin(S0) copies A, behind the cursor, to A″ with
// stamp 30. pin(S1), at the next cut, finds stamp 30 in S0's pin and takes
// A″, so A′ is reached by no root. Seeded bug `promote_shortcut` (no
// lookup): S1 keeps A′, and stamp 30 is at A″ and A′.
fn gate_l88_two_generations(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let fixture = gate_l88_fixture(d, c, r, tasks)?
    let rows: Table[u64, Bytes] = clone(fixture.rows)
    let mut db = open(tasks, d, c, r, fixture.options)?
    let s0 = snapshot(db)
    let a_row = fixture.leaves[0u64].first
    let f_row = fixture.leaves[1u64].first
    gate_put(mut db, rows, f_row, 1)?
    let _ = checkpoint(mut db)?
    let (_, moved) = gate_leaves(d, db, 0, rows.id)?
    if !compact_listed(db, fixture.pack) || moved[0u64].at.pack == fixture.pack || moved[0u64].at.stamp != fixture.leaves[0u64].at.stamp || gate_probe_rows(db, fixture.pack) != 1 {
        fail("L88 (e): cut 1 moves A out of P with its stamp, and P's cursor is 1")
    }
    let s1 = snapshot(db)
    gate_put(mut db, rows, a_row, 2)?
    let _ = pin(mut db, "s0", s0)?
    drop(take s0)
    let _ = gate_walk_all(d, db, rows.id)?
    let pinned_db = gate_pin_cut(d, c, r, tasks, fixture.options, take db, "s1", take s1, crash)?
    let _ = gate_walk_all(d, pinned_db, rows.id)?
    gate_pin_rows(pinned_db, "s0", rows, map.new())?
    let mut s1_edits: Map[u64, u8] = map.new()
    map.insert(mut s1_edits, f_row, 1u8)
    let mut head_edits: Map[u64, u8] = map.new()
    map.insert(mut head_edits, f_row, 1u8)
    map.insert(mut head_edits, a_row, 2u8)
    gate_l88_finish(d, c, r, tasks, fixture, take pinned_db, "s1", head_edits, map.new(), s1_edits, gate_pin_kept(crash))
}

// L88 (f), trace (f): main deletes A's rows, and cut 1 probes A with no
// match. A pin of S publishes at every later cut. Each pin copies A (behind
// the cursor) or takes an earlier pin's copy, and restarts no probe, so P,
// with N PACK_INDEX rows, retires at cut N: N - 1 pin cuts after cut 1. A
// crashed pin (the first) is followed by plain cuts; the reopen restarts
// the probe, so only the bound is checked there. Seeded bugs
// `promote_resets_cursor` (P never retires while pins keep coming) and
// `promote_behind_cursor` (P retires under the pins' A).
fn gate_l88_pin_every_cut(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let fixture = gate_l88_fixture(d, c, r, tasks)?
    let rows: Table[u64, Bytes] = clone(fixture.rows)
    let mut db = open(tasks, d, c, r, fixture.options)?
    let s = snapshot(db)
    let first = fixture.leaves[0u64]
    gate_delete_rows(mut db, rows, first.first, first.first + first.rows)?
    let _ = checkpoint(mut db)?
    if gate_probe_rows(db, fixture.pack) != 1 {
        fail("L88 (f): cut 1 probes A and leaves P's cursor at 1")
    }
    if let NoCrash = crash {
        let mut pins = 0u64
        while compact_listed(db, fixture.pack) {
            if pins == fixture.frames {
                fail("L88 (f): P retires within its PACK_INDEX rows while a pin publishes at every cut")
            }
            let mut name = string.from("p")
            string.push_u64(mut name, pins)
            let _ = pin(mut db, clone(name), s)?
            pins += 1
            let _ = gate_walk_all(d, db, rows.id)?
            gate_pin_rows(db, name, rows, map.new())?
        }
        drop(take s)
        if pins + 1 != fixture.frames {
            fail("L88 (f): a probe of N rows at budget one retires P at cut N")
        }
        return gate_l88_finish(d, c, r, tasks, fixture, take db, "p0", map.new(), gate_leaf_rows(first), map.new(), true)
    }
    let pinned_db = gate_pin_cut(d, c, r, tasks, fixture.options, take db, "p0", take s, crash)?
    let _ = gate_walk_all(d, pinned_db, rows.id)?
    gate_l88_finish(d, c, r, tasks, fixture, take pinned_db, "p0", map.new(), gate_leaf_rows(first), map.new(), gate_pin_kept(crash))
}


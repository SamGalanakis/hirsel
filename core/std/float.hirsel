/// m x 2^e x 10^digits rounded half to even, when digits <= 19 and that is m x 5^digits
/// shifted right by 1 to 63 bits into a u64; None elsewhere. Exact: the remainder is
/// the bits shifted out.
fn fixed_scaled(m: u64, e: i64, digits: u64) -> Option[u64] {
    if digits > 19 || m == 0 {
        return None
    }
    let d: i64 = int.narrow(digits)
    let shift = -e - d
    if shift < 1 || shift > 63 {
        return None
    }
    let (hi, lo) = int.mul_wide(m, POW5_U64[digits])
    let s: u64 = int.narrow(shift)
    let q = (hi << (64 - s)) | (lo >> s)
    // The rounded value must fit too.
    if hi >> s != 0 || q == ALL_ONES {
        return None
    }
    let rest = lo & ((1u64 << s) - 1)
    let half: u64 = 1 << (s - 1)
    if rest > half || (rest == half && (q & 1) == 1) {
        Some(q + 1)
    } else {
        Some(q)
    }
}

/// q / 10^digits with `digits` places, as push_fixed64 writes it.
fn push_scaled(mut s: String, q: u64, digits: u64) {
    if digits == 0 {
        return string.push_u64(mut s, q)
    }
    let scale = POW10_U64[digits]
    let places = q % scale
    string.push_u64(mut s, q / scale)
    string.push(mut s, ".")
    let mut width: u64 = 1
    while width < digits && places >= POW10_U64[width] {
        width += 1
    }
    if places == 0 {
        return string.push(mut s, string.slice("0000000000000000000", 0, digits))
    }
    string.push(mut s, string.slice("0000000000000000000", 0, digits - width))
    string.push_u64(mut s, places)
}

fn strip(c: u64, p: i64) -> (u64, i64) {
    let mut v = c
    let mut q = p
    while v % 10 == 0 {
        v = v / 10
        q += 1
    }
    (v, q)
}

/// The index in push_fixed64's text of output digit q: after the carry byte, and past the
/// '.' once the whole digits end.
fn place(q: u64, whole: u64) -> u64 {
    if q < whole {
        1 + q
    } else {
        2 + q
    }
}

fn push_ascii(mut s: String, take o: Bytes) {
    match string.from_utf8(take o) {
        Ok(take t) => string.push(mut s, t),
        Error(_) => fail("float: formatted digits are ASCII"),
    }
}


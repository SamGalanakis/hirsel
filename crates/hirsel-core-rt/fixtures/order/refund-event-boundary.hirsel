// MEM-20, CONC-10 (event-hooks-review-1041 F1): a refund from another task reaches an
// admission only after the admitting task's next event. The child (limit 1024) sends its
// 800-byte allocation to the root and counts refused 800-byte allocations. After 64
// refusals its polls are used up and the root runs: it receives and frees the
// allocation. The child's next admission still sees 224 bytes and refuses; that refusal
// is its next event, which delivers the refund, so the following allocation succeeds.
// Hand-derived count: 65.
type Input:send { ready: Sender[Bytes] }
fn worker(take s: Input) -> u64 {
    let first: Bytes = list.with_capacity(800)
    result.unwrap(channel.try_send(s.ready, take first))
    let mut refused = 0u64
    loop {
        let mut b: Bytes = list.new()
        match list.try_reserve(mut b, 800) { Ok(()) => return refused, Error(_) => { refused += 1 } }
    }
}
pub fn main(tasks: Tasks) -> Result[(), Exit] waits {
    let (ready, ready_rx): (Sender[Bytes], Receiver[Bytes]) = channel.new(1)
    let h = task.spawn(tasks, bytes 1024, Input(ready: take ready), worker)
    let _ = result.unwrap(channel.receive(ready_rx))
    let n = result.unwrap(task.join(take h))
    if n == 65u64 { Ok(()) } else { Error(Exit(status: 64u8)) }
}

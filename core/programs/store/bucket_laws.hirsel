fn bucket_m2_law_admit(d: Dir, tasks: Tasks, r: Random, sim: BucketSim) -> Result[(), Error] waits {
    let (take loaded, head) = bucket_m2_upload_checkpoint(d, tasks, sim)?
    let mut source = take loaded
    let mut workspace = failure_result_from_rep(history.history_buffers(1024))?
    let cfg = history.object_history_config(std.object.bucket_config(source.client), "bucket")
    let authority = failure_result_from_rep(history.history_config_bytes(cfg))?
    failure_result_from_rep(history.history_encode_head(mut workspace.body, head, authority))?
    let issued_head = history.history_write_head_issue(mut source.client, Absent, mut workspace.body, source.deadline)
    let HistoryApplied(tag) = history.history_write_head_finish(mut source.client, take issued_head, mut workspace.body, mut workspace.witness, source.deadline) else {
        fail("could not publish the checkpoint fixture")
    }
    let mut incumbent = history.fixture_register(head, tag)
    let mut requested = result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64))
    requested.create = false
    requested.expect = Some(store_key_from_rep(head.store))
    requested.claim_auth = Some(bucket_law_adopt_auth())
    requested.resident_limit = 0
    let small = history_open_register(mut source, sim.time, r, requested, "bucket", mut workspace, BUCKET_LAW_OP_MS)
    if let Error(Full(Resident(_))) = small {} else {
        fail("the claim did not admit the restored state before fencing")
    }
    requested.resident_limit = 1048576
    requested.activation = Some(3)
    let stale = history_open_register(mut source, sim.time, r, requested, "bucket", mut workspace, BUCKET_LAW_OP_MS)
    if let Error(NotCurrent(0)) = stale {} else {
        fail("the claim ignored the requested activation")
    }
    bucket_m2_law_commit_packet(mut workspace.packet, history.register_head(incumbent), 3)?
    let HistoryApplied(_) = failure_result_from_rep(history.history_register_advance(mut source.client, mut incumbent, authority, mut workspace, source.deadline))? else {
        fail("the refused open fenced the incumbent")
    }
    requested.activation = Some(0)
    let (take claimed, take loaded_state) = history_open_register(mut source, sim.time, r, requested, "bucket", mut workspace, BUCKET_LAW_OP_MS)?
    if history.register_head(claimed).pair.epoch != 2 || history.register_head(claimed).entry.seq != 3 || loaded_state.state.tips[0].head != 3 {
        fail("open did not serve the admitted suffix after advancing CLAIM")
    }
    bucket_m2_law_commit_packet(mut workspace.packet, history.register_head(incumbent), 4)?
    if let Error(Fenced(1)) = failure_result_from_rep(history.history_register_advance(mut source.client, mut incumbent, authority, mut workspace, source.deadline)) {} else {
        fail("a fenced holder advanced after the admitted claim")
    }
    Ok(())
}


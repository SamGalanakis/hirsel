// A mut call needs a published descriptor post-state before replacing callbacks.
// expect: gap capture descriptor updates through mut arguments are not built
// expect: gap capture descriptor updates through a borrowed place are not built
fn replace_cb(mut cb:scoped fn(u64)->u64,take next:scoped fn(u64)->u64) {cb=take next}
fn f()->u64 {
 let mut n:u64=1
 let mut m:u64=2
 let mut cb=scoped fn(x:u64)->u64 {n+=x;n}
 replace_cb(mut cb,scoped fn(x:u64)->u64 {m+=x;m})
 cb(m)
}

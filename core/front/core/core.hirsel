// Fixture of the core prelude (core@1/core): the subset of core/core/core.hirsel the
// cases use, declared as it declares them at spec revision 4. Role types are fixed by
// these paths.
pub type Option[T] = None | Some(T)
pub type Result[T, E] = Ok(T) | Error(E)
pub opaque type Never

pub opaque type String
pub opaque type List[T]
pub opaque type Box[T]
pub opaque type Rc[T: shareable]
pub opaque type Arc[T: shareable + send]
pub opaque type View[T]

pub opaque type Region

pub opaque type Task[R: send]
pub opaque type Sender[T: send]
pub opaque type Receiver[T: send]

pub opaque type Dir
pub opaque type Unique: key

pub type Capacity { requested: u64, available: u64 }
pub type Exit: key { status: u8 }
pub type Bytes = List[u8]

pub fn fail(take msg: String) -> Never
pub fn replace[T](mut q: T, take v: T) -> T

pub opaque resource type HostFile
pub opaque stable type Text
pub opaque stable type SeqSpan[T: packed]
pub opaque stable type IndexedSpan[T: packed]
pub opaque type Writer[T, in r]
pub opaque stable type FixedSpan[T: plain]
pub opaque type SpanBuilder[T: plain, in r]
pub opaque stable type SeqIndex[T: packed, in a]
pub opaque type Link[T]
pub opaque type Child[T]
pub opaque type Builder[T, in r]
pub type BuildError = Capacity(Capacity) | Overflow

pub fn finish[T, in r](take b: Builder[T, in r]) -> T in r
pub fn finish_trim[T, in r](take b: Builder[T, in r]) -> T in r
pub fn build_stream_in[T: streamable](r: Region, bytes n: u64, w: scoped fn(take Writer[T, in r]) -> Result[Child[T], BuildError]) -> Result[Builder[T, in r], BuildError]
pub fn emit[T, in r](take w: Writer[T, in r], x: T) -> Result[Child[T], BuildError]

pub type Order: key + ordered = Less | Equal | Greater
pub type FloatError = NaN | OutOfRange
pub type ParseError = Empty | Invalid(u64) | OutOfRange

pub opaque type Map[K: key, V]
pub opaque type Causes

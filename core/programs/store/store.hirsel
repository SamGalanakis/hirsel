        Ok(())
    } else {
        Error(())
    }
}

fn disk_test_directory(d: Dir) -> Dir waits {
    let mut name = result.unwrap(string.with_capacity(64))
    result.unwrap(string.push(mut name, "store-law-"))
    result.unwrap(host.mkdtemp(d, mut name))
}

fn disk_crash_options(scenario: String) -> Options {
    let mut options = defaults()
    options.resident_limit = if scenario == "refusal" { 2097152u64 + 1048639 } else { 2097152u64 }
    options.checkpoint_task_bytes = if scenario == "refusal" {
        131072
    } else {
        1048576
    }
    options.pack_bytes = if scenario == "oversize" {
        1
    } else {
        512
    }
    options
}

fn disk_crash_init(d: Dir, c: Clock, r: Random, tasks: Tasks, scenario: String) -> Result[(), Error] waits {
    let options = disk_crash_options(scenario)
    let mut db = open(tasks, d, c, r, options)?
    let _ = create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64()))?
    if scenario == "refusal" {
        let _ = create_table(mut db, spec("big", std.codec.key_u64(), std.codec.of_string()))?
    }
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 96 {
        let inserted = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
            put(mut tx, t, k, k + 1)
        })?
        match take inserted { Committed(_) => {}, _ => fail("crash init put") }
    }
    let _ = checkpoint(mut db)?
    if scenario == "gap" {
        let loaded = disk_load(d, options.resident_limit)?
        let seq = loaded.manifest.next_pack
        let first_name = capacity(disk_path("p-", seq, ""))?
        let second_name = capacity(disk_path("p-", seq + 1, ""))?
        let first = capacity(disk_header_bytes(DiskContext(store: db.store, role: 3, seq: seq), 0))?
        let second = capacity(disk_header_bytes(DiskContext(store: db.store, role: 3, seq: seq + 1), 0))?
        disk_write_synced(d, first_name, first)?
        disk_write_synced(d, second_name, second)?
        disk_io(host.sync_dir(d))?
        // Explicit legal post-cleanup gap from H3's partial-persistence model.
        // W2's restart itself still discards all volatile directory operations.
        let _ = disk_remove_optional(d, first_name)?
        disk_io(host.sync_dir(d))?
    }
    if scenario == "checkpoint" || scenario == "gap" || scenario == "oversize" {
        // L4 cuts only the checkpoint. Its input commits are durable before
        // the adapter arms filesystem cuts, so every reopen must keep them.
        for k in 0u64 .. 64 {
            if !typed_put(mut db, t, k, k + 101) { fail("checkpoint input") }
        }
        let last = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq))
        durable(mut db, last)?
    }
    close(take db)
}

fn disk_crash_write(d: Dir, c: Clock, r: Random, tasks: Tasks, scenario: String) -> Result[(), Error] waits {
    if scenario == "genesis" {
        return disk_crash_init(d, c, r, tasks, scenario)
    }
    let options = disk_crash_options(scenario)
    let mut db = open(tasks, d, c, r, options)?
    if scenario == "schema" {
        let _ = create_table(mut db, spec("added", std.codec.key_u64(), std.codec.of_u64()))?
    } else if scenario == "refusal" {
        let big = table(mut db, "big", std.codec.key_u64(), std.codec.of_string())?
        let mut raw: Bytes = capacity(list.with_capacity(1048566))?
        capacity(list.fill(mut raw, 1048566, 97u8))?
        let large = result.unwrap(string.from_utf8(take raw))
        let inserted = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
            put(mut tx, big, 1, large)
        })?
        match take inserted {
            Committed(_) => {},
            _ => fail("crash refusal put")
        }
        match checkpoint(mut db) {
            Error(Full(_)) => {},
            Error(take e) => return Error(take e),
            Ok(_) => fail("oversized cut unexpectedly fits")
        }
        let deleted = run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
            delete(mut tx, big, 1)
        })?
        match take deleted {
            Committed(done) => if !done.value {
                fail("crash refusal delete")
            },
            _ => fail("crash refusal delete")
        }
        let _ = checkpoint(mut db)?
    } else if scenario == "migrate" {
        run_migration(mut db, tasks, code.describe(crash_migration))?
    } else if scenario == "branches" {
        // L7 at every W2 cut: pin, fork, a fork commit made durable, unpin.
        let arg10 = snapshot(db)
        let _ = pin(mut db, "p", arg10)?
        let arg11 = snapshot(db)
        let (b, _) = fork(mut db, "b", arg11)?
        let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
        let on_b = run_on(mut db, b, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, t, 0, 500) })?
        match take on_b { Committed(done) => durable(mut db, done.ticket)?, _ => fail("crash fork put") }
        let _ = unpin(mut db, "p")?
    } else {
        let _ = checkpoint(mut db)?
    }
    close(take db)
}

// L17 and L33. The rewrite, its index and the extra table are published at
// one version by the migration phase.
fn crash_migration(mut phase: Migration) -> Result[(), Error] {
    let t = migration_table(mut phase, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let mut declared = spec("rows", std.codec.key_u64(), std.codec.of_u64())
    with_index(mut declared, "by_v", code.describe(crash_value), std.codec.key_u64())?
    migration_migrate(mut phase, take t, take declared, crash_thousand)?
    migration_create_table(mut phase, spec("added", std.codec.key_u64(), std.codec.of_u64()))
}

fn crash_value(v: u64) -> Result[u64, Capacity] {
    Ok(v)
}

fn crash_thousand(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
    Ok(Some((k, v + 1000)))
}

fn disk_crash_read(d: Dir, c: Clock, r: Random, tasks: Tasks, scenario: String, required_new: bool) -> Result[bool, Error] waits {
    let mut options = disk_crash_options(scenario)
    options.create = false
    let mut db = match open(tasks, d, c, r, options) {
        Ok(take db) => take db,
        Error(NotFound) => return Ok(scenario == "genesis" && !required_new),
        Error(take e) => return Error(take e)
    }
    if scenario == "genesis" && db.heads[0].head == 0 {
        let empty = std.omap.len(db.heads[0].roots.data) == 0 && std.omap.len(db.heads[0].roots.catalog) == 0
        close(take db)?
        return Ok(empty && !required_new)
    }
    let mut old = true
    let mut new = true
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let sh = shape(t)
    for k in 0u64 .. 96 {
        let found = get(snapshot(db), sh, k)?
        let old_value: Option[u64] = if scenario == "genesis" {
            if k + 1 < db.heads[0].head { Some(k + 1) } else { None }
        } else { Some(k + 1) }
        if found != old_value {
            old = false
        }
        let expected = if k < 64 {
            k + 101
        } else {
            k + 1
        }
        if found != Some(expected) {
            new = false
        }
    }
    // L4's input was durable in init; a checkpoint cut never loses it.
    let mut good = if scenario == "branches" || scenario == "migrate" { true } else { new }
    if scenario == "schema" {
        good = old
        match table(mut db, "added", std.codec.key_u64(), std.codec.of_u64()) {
            Ok(take added) => {
                if added.id != 2 || db.heads[0].head != 98 {
                    good = false
                }
            },
            Error(Missing(_)) => {
                if db.heads[0].head != 97 || required_new {
                    good = false
                }
            },
            _ => {
                good = false
            }
        }
    } else if scenario == "refusal" {
        good = old
        let big = table(mut db, "big", std.codec.key_u64(), std.codec.of_string())?
        if !old || db.heads[0].head < 98 || db.heads[0].head > 100 || (required_new && db.heads[0].head != 100) { good = false }
        match get(snapshot(db), shape(big), 1)? {
            Some(value) => {
                if db.heads[0].head != 99 || string.byte_len(value) != 1048566 { good = false }
                for byte in string.as_bytes(value) { if byte != 97u8 { good = false } }
            },
            None => if db.heads[0].head == 99 { good = false }
        }
    } else if scenario == "migrate" {
        // Before: head 97, rows k + 1, no index. After: head 98, rows
        // k + 1001, and by_v lists all 96 in key order. Nothing between.
        let mut moved = true
        for k in 0u64 .. 96 {
            if get(snapshot(db), sh, k)? != Some(k + 1001) { moved = false }
        }
        let listed = list.len(index_catalog(db, t.id)?)
        let mut whole = false
        if moved && listed == 1 && db.heads[0].head == 98 {
            let mut indexed = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
            let ix = index(db, mut indexed, "by_v", code.describe(crash_value), std.codec.key_u64())?
            let mut rows = find(snapshot(db), ix, Unbounded, Unbounded)?
            let mut expect = 0u64
            whole = true
            while let Some((k, v)) = next(mut rows)? {
                if k != expect || v != k + 1001 { whole = false }
                expect += 1
            }
            whole = whole && expect == 96
        }
        let added = table(mut db, "added", std.codec.key_u64(), std.codec.of_u64())
        let before = old && listed == 0 && db.heads[0].head == 97
        good = match take added {
            Ok(created) => whole && created.id == 4,
            Error(Missing(_)) => before && !required_new,
            _ => false,
        }
    } else if scenario == "branches" {
        // The states in write order: nothing; pin p at 97; and b at 97; b at
        // 98 with k0 = 500; p gone. Main is at 97 with every row k + 1 in all.
        let has_pin = match pinned(db, "p") {
            Some(s) => { if version(s) != 97 || get(s, sh, 0)? != Some(1u64) { good = false }; true },
            None => false
        }
        let b_head = match branch(db, "b") {
            Some(b) => {
                let at_b = snapshot_of(db, b)?
                let k0: Option[u64] = if version(at_b) == 98 { Some(500) } else { Some(1) }
                if get(at_b, sh, 0)? != k0 || get(at_b, sh, 95)? != Some(96u64) { good = false }
                version(at_b)
            },
            None => 0u64
        }
        let known = (b_head == 0) || (has_pin && b_head == 97) || b_head == 98
        good = good && old && db.heads[0].head == 97 && known && (!required_new || (!has_pin && b_head == 98))
    } else if scenario == "genesis" {
        good = old && db.heads[0].head >= 1 && db.heads[0].head <= 97 && (!required_new || db.heads[0].head == 97)
    }
    close(take db)?
    Ok(good)
}

fn install_old(mut phase: Migration) -> Result[(), Error] {
    migration_create_table(mut phase, spec("rows", std.codec.key_u64(), std.codec.of_u64()))?
    migration_create_table(mut phase, spec("other", std.codec.key_u64(), std.codec.of_u64()))
}

fn install_next(mut phase: Migration) -> Result[(), Error] {
    crash_migration(mut phase)?
    let second = migration_table(mut phase, "other", std.codec.key_u64(), std.codec.of_u64())?
    let mut replacement = spec("other", std.codec.key_u64(), std.codec.of_u64())
    with_index(mut replacement, "empty", code.describe(crash_value), std.codec.key_u64())?
    migration_migrate(mut phase, take second, take replacement, crash_thousand)
}

fn install_target_value(target: PreparedTarget) -> Result[Bytes, DeployError] {
    deploy_result(copied(target.release))
}

fn install_fixture_bytes(n: u64, b: u8) -> Bytes {
    let mut out: Bytes = list.new()
    result.unwrap(list.fill(mut out, n, b))
    take out
}

fn crash_install_init(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, disk_crash_options("install"))?
    let mut staging = stage_migration(db, tasks, code.describe(install_old))?
    let description = install_fixture_bytes(32u64, 65u8)
    stage_activation(mut staging, 1u64, None, description, std.codec.of_bytes(), description)?
    install_activation(mut db, take staging)?
    let target = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 96u64 {
        if !typed_put(mut db, target, k, k + 1) { fail("install seed row") }
    }
    let _ = checkpoint(mut db)?
    close(take db)
}

fn crash_install_prepared(mut db: Db, d: Dir, c: Clock, tasks: Tasks, attempt: Bytes) -> Result[(Dir, u64), DeployError] waits {
    let copying = begin_export(mut db, tasks, d, deploy_result(copied(attempt))?, 1u64, 4194304u64)?
    let exported = match task.join(take copying) {
        Ok(take answer) => (take answer)?,
        Error(_) => return Error(ExportMismatch),
    }
    Ok((exported.dir, exported.stamp.head))
}

fn crash_import(mut db: Db, scratch: Dir, c: Clock, tasks: Tasks, attempt: Bytes, image: u8, pack: u64) -> Result[Inline[u8, 32], DeployError] waits {
    let source = open_export(scratch, c, attempt, disk_crash_options("install"))?
    let staged = deploy_result(stage_export_migration(source, tasks, code.describe(install_next)))?
    let header = PreparedTarget(describe: install_fixture_bytes(32u64, image), release: install_fixture_bytes(32u64, 67u8),
        digest: install_fixture_bytes(32u64, 68u8), resident_limit: 2097152u64, checkpoint_task_bytes: pack)
    write_prepared(source, staged, scratch, take header)?
    let checked = validate_prepared(scratch)?
    let work = reserve_import(mut db, take checked)?
    let assembled = import_trees(take work)?
    let digest = imported_digest(assembled)
    keep_import(mut db, take assembled)?
    Ok(digest)
}

fn crash_apply(mut db: Db, attempt: Bytes, digest: Inline[u8, 32]) -> Result[u64, DeployError] waits {
    let requested = Cutover(attempt: deploy_result(copied(attempt))?, digest: digest, deadline: 18446744073709551615u64)
    let description = install_fixture_bytes(32u64, 65u8)
    perform_cutover(mut db, requested, 1u64, description, std.codec.of_bytes(), install_target_value, scoped fn() -> bool { true })
}

fn crash_install_run(mut db: Db, d: Dir, c: Clock, tasks: Tasks) -> Result[u64, DeployError] waits {
    let attempt = install_fixture_bytes(16u64, 7u8)
    let (scratch, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let digest = crash_import(mut db, scratch, c, tasks, attempt, 66u8, 1048576u64)?
    crash_apply(mut db, attempt, digest)
}

// Exercise the pre-rename refusals together with a fresh export after drift.
// No cut in this case is permitted to change the activation until the retry.
fn crash_install_refusals(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let mut db = deploy_result(open(tasks, d, c, r, disk_crash_options("install")))?
    let attempt = install_fixture_bytes(16u64, 7u8)
    let (scratch, base) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    if base != 97u64 { fail("fixture base") }
    let first = crash_import(mut db, scratch, c, tasks, attempt, 66u8, 1048576u64)?
    let second = crash_import(mut db, scratch, c, tasks, attempt, 70u8, 1048576u64)?
    if first == second { fail("candidate digests are equal") }
    match crash_apply(mut db, attempt, first) {
        Error(ExportMismatch) => (),
        _ => fail("cutover accepted a superseded candidate"),
    }
    let (scratch_limit, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let blocked = crash_import(mut db, scratch_limit, c, tasks, attempt, 66u8, 32u64)?
    match crash_apply(mut db, attempt, blocked) {
        Error(FullNew(_)) => (),
        _ => fail("cutover ignored the target's largest-pack limit"),
    }
    if version(snapshot(db)) != base { fail("a refusal published roots") }
    let (scratch_writes, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let stale = crash_import(mut db, scratch_writes, c, tasks, attempt, 66u8, 1048576u64)?
    let t = deploy_result(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let acknowledged = deploy_result(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 0u64, 77u64)
    }))?
    if let Committed(done) = acknowledged {
        deploy_result(durable(mut db, done.ticket))?
    } else { fail("could not acknowledge the drift write") }
    match crash_apply(mut db, attempt, stale) {
        Error(Drift) => (),
        _ => fail("cutover accepted an intervening journal commit"),
    }
    let (scratch_schema, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let stale_schema = crash_import(mut db, scratch_schema, c, tasks, attempt, 66u8, 1048576u64)?
    let _ = deploy_result(create_table(mut db, spec("kept", std.codec.key_u64(), std.codec.of_u64())))?
    match crash_apply(mut db, attempt, stale_schema) {
        Error(Drift) => (),
        _ => fail("cutover accepted an intervening schema commit"),
    }
    let installed = crash_install_run(mut db, d, c, tasks)?
    if installed != 100u64 { fail("fresh export lost an intervening version") }
    deploy_result(close(take db))?
    let reopened = deploy_result(open(tasks, d, c, r, disk_crash_options("install")))?
    let migrated = deploy_result(system_table(reopened, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let _ = deploy_result(system_table(reopened, "kept", std.codec.key_u64(), std.codec.of_u64()))?
    if deploy_result(get(snapshot(reopened), shape(migrated), 0u64))? != Some(1077u64) {
        fail("fresh export lost the acknowledged row")
    }
    deploy_result(close(take reopened))
}

fn crash_install_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, disk_crash_options("install"))?
    match crash_install_run(mut db, d, c, tasks) {
        Ok(v) => if v != 98 { fail("wrong installed version") },
        Error(Store(take problem)) => return Error(take problem),
        Error(Scratch(take problem)) => return Error(take problem),
        Error(_) => fail("install fixture refused"),
    }
    close(take db)
}

fn crash_install_read(d: Dir, c: Clock, r: Random, tasks: Tasks, required_new: bool) -> Result[bool, Error] waits {
    let mut db = open(tasks, d, c, r, disk_crash_options("install"))?
    let snap = snapshot(db)
    let v = version(snap)
    if v != 98 && (v != 97 || required_new) { return Ok(false) }
    let installed = v == 98
    let activated = system_table(db, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes())?
    let release = system_table(db, "hirsel.runner.releases", std.codec.key_u64(), std.codec.of_bytes())?
    let found = option.unwrap(get(snap, shape(activated), 0u8)?)
    if found != install_fixture_bytes(32u64, if installed { 66u8 } else { 65u8 }) || db.fence != 1 { return Ok(false) }
    let new_release = get(snap, shape(release), 98u64)?
    if installed {
        if option.unwrap(take new_release) != install_fixture_bytes(32u64, 67u8) || db.next_table != 10u32 { return Ok(false) }
    } else if let Some(_) = new_release { return Ok(false) }
    let t = system_table(db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 96u64 {
        if get(snap, shape(t), k)? != Some(k + if installed { 1001u64 } else { 1u64 }) { return Ok(false) }
    }
    if installed {
        let other = system_table(db, "other", std.codec.key_u64(), std.codec.of_u64())?
        if list.len(index_catalog(db, other.id)?) != 1 || std.omap.len(db.heads[0].roots.streams) != 0u64 { return Ok(false) }
        let _ = create_table(mut db, spec("after", std.codec.key_u64(), std.codec.of_u64()))?
        let after = system_table(db, "after", std.codec.key_u64(), std.codec.of_u64())?
        if after.id != 10u32 { return Ok(false) }
        let _ = checkpoint(mut db)?
        close(take db)?
        let reopened = open(tasks, d, c, r, disk_crash_options("install"))?
        for k in 0u64 .. 96u64 {
            if get(snapshot(reopened), shape(t), k)? != Some(k + 1001u64) { return Ok(false) }
        }
        close(take reopened)?
    } else {
        close(take db)?
    }
    Ok(true)
}

// Native provider entry; the adapter invokes it for init, one cut and reopen.
// The expected rows and schema versions above follow the specified history.
pub fn disk_crash_main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, out: Stdout) -> Result[(), Exit] waits {
    let phase = option.unwrap(args.get(argv, 0))
    let scenario = option.unwrap(args.get(argv, 1))
    if scenario == "install-refusals" {
        if phase == "init" {
            return match crash_install_init(d, c, r, tasks) { Ok(()) => Ok(()), Error(_) => Error(Exit(status: 61u8)) }
        }
        if phase == "write" {
            if let Ok(()) = crash_install_refusals(d, c, r, tasks) { let _ = stdout.write(out, "DONE"); return Ok(()) }
            return Error(Exit(status: 64u8))
        }
        return Ok(())
    }
    if scenario == "install" {
        if phase == "init" {
            return match crash_install_init(d, c, r, tasks) { Ok(()) => Ok(()), Error(_) => Error(Exit(status: 61u8)) }
        }
        if phase == "write" {
            if let Ok(()) = crash_install_write(d, c, r, tasks) { let _ = stdout.write(out, "DONE") }
            return Ok(())
        }
        let required_new = option.unwrap(args.get(argv, 2u64)) == "new"
        return match crash_install_read(d, c, r, tasks, required_new) { Ok(true) => Ok(()), _ => Error(Exit(status: 63u8)) }
    }
    if phase == "init" {
        if scenario == "genesis" {
            return Ok(())
        }
        match disk_crash_init(d, c, r, tasks, scenario) {
            Ok(()) => Ok(()),
            Error(_) => Error(Exit(status: 31))
        }
    } else if phase == "write" {
        match disk_crash_write(d, c, r, tasks, scenario) {
            Ok(()) => {
                let _ = stdout.write(out, "DONE");
                Ok(())
            },
            Error(Io(_)) => Ok(()),
            Error(Poisoned(_)) => Ok(()),
            Error(_) => Error(Exit(status: 32))
        }
    } else if phase == "reopen" {
        match open(tasks, d, c, r, disk_crash_options(scenario)) {
            Error(Io(_)) => Ok(()),
            _ => Error(Exit(status: 34))
        }
    } else {
        let expected = option.unwrap(args.get(argv, 2))
        match disk_crash_read(d, c, r, tasks, scenario, expected == "new") {
            Ok(true) => Ok(()),
            _ => Error(Exit(status: 33))
        }
    }
}

// S3 journal payloads are decoded exactly before their effects are applied.
pub type CallRecord: codec {
    key: Bytes,
    args: Bytes,
    stream: Bytes,
    // AD1: code.revision of the entry that ran, exactly 32 bytes; None only
    // when the program was assembled without revisions. Never 32 zero bytes.
    revision: Option[Bytes],
    // The code that ran: u64 n ‖ u64 s, big-endian, then the replay identity
    // (32 bytes, or none when the launch has no identity), RUNNER-SPEC §7.
    code: Bytes
}

// Tag 2 carries the original execution context only when a later frame
// settles the call. An inline reply uses the context of its own frame.
type Settlement { way: u8, base: u64, at: u64, seed: u64 }
type CallSection { record: CallRecord, settlement: Option[Settlement] }

pub type Recorded { record: CallRecord, settle: u8, branch: Branch, base: u64, at: u64, seed: u64 }

fn call_section_bytes(rec: CallRecord, shifted: bool) -> u64 {
    let revision = match rec.revision { Some(raw) => list.len(raw), None => 0u64 }
    22 + list.len(rec.key) + list.len(rec.args) + list.len(rec.stream) + revision + list.len(rec.code) +
        (if shifted { 24u64 } else { 0u64 })
}

// AD1: the CALL revision check. A Some that is not code.revision's 32 bytes is refused
// before anything is committed.
fn call_checked(c: CallRecord) -> Result[(), Error] {
    if let Some(r) = c.revision {
        if list.len(r) != 32 { return Error(Missing("revision")) }
    }
    if !call_code_size(list.len(c.code)) { return Error(Missing("code")) }
    Ok(())
}

fn check_completion_record(complete: Completion, rec: Option[CallRecord]) -> Result[(), Error] {
    if let Some(c) = rec {
        if c.stream != complete.stream { return Error(Foreign) }
        call_checked(c)?
    }
    Ok(())
}

fn call_code_size(size: u64) -> bool { size == 16 || size == 48 }

type JournalOp: shareable + send {
    key: Bytes,
    value: Option[Bytes]
}

type JournalCommit {
    branch: u32,
    version: u64,
    at: u64,
    data: List[JournalOp],
    streams: List[JournalOp],
    call: Option[CallSection]
}

fn journal_ops(file: String, raw: Bytes, mut at: u64) -> Result[List[JournalOp], Error] {
    let count = disk_count(file, raw, mut at, 5)?
    let mut ops: List[JournalOp] = list.new()
    for i in 0u64 .. count {
        let kind = disk_number(file, raw, mut at, 1)?
        if kind != 1 && kind != 2 { return Error(disk_fault(file, at - 1, Malformed)) }
        let key = disk_blob(file, raw, mut at, 4096)?
        let value = if kind == 1 { Some(disk_blob(file, raw, mut at, 1048576)?) } else { None }
        capacity(result.capacity_only(list.push(mut ops, JournalOp(key: take key, value: take value))))?
    }
    Ok(take ops)
}

fn decode_settlement(file: String, raw: Bytes, mut at: u64, way: u8) -> Result[Settlement, Error] {
    if list.len(raw) - at < 24 { return Error(disk_fault(file, at, Malformed)) }
    let context = Settlement(way: way, base: word_be(raw, at), at: word_be(raw, at + 8), seed: word_be(raw, at + 16))
    at += 24
    Ok(context)
}

fn journal_decode(file: String, raw: Bytes) -> Result[JournalCommit, Error] {
    let mut at = 0u64
    let br: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let head = disk_number(file, raw, mut at, 8)?
    let wall = disk_number(file, raw, mut at, 8)?
    let sections = disk_number(file, raw, mut at, 1)?
    if sections == 0 || sections > 3 { return Error(disk_fault(file, at - 1, Malformed)) }
    let mut seen = 0u64
    let mut data: List[JournalOp] = list.new()
    let mut streams: List[JournalOp] = list.new()
    let mut call: Option[CallSection] = None
    for section in 0u64 .. sections {
        let tag = disk_number(file, raw, mut at, 1)?
        if tag > 2 { return Error(disk_fault(file, at - 1, Malformed)) }
        let mask = 1u64 << tag
        if seen & mask != 0 { return Error(disk_fault(file, at - 1, Malformed)) }
        seen |= mask
        if tag == 0 {
            data = journal_ops(file, raw, mut at)?
        } else if tag == 1 {
            streams = journal_ops(file, raw, mut at)?
        } else {
            let key = disk_blob(file, raw, mut at, 16777280)?
            let args = disk_blob(file, raw, mut at, 16777280)?
            let stream = disk_blob(file, raw, mut at, 16777280)?
            let revision_at = at
            let revision_bytes = disk_blob(file, raw, mut at, 32)?
            let revision: Option[Bytes] = match list.len(revision_bytes) {
                0 => None,
                32 => Some(take revision_bytes),
                _ => return Error(disk_fault(file, revision_at, Malformed))
            }
            let code_at = at
            let code = disk_blob(file, raw, mut at, 48)?
            if !call_code_size(list.len(code)) { return Error(disk_fault(file, code_at, Malformed)) }
            let way: u8 = int.truncate(disk_number(file, raw, mut at, 1)?)
            let settlement: Option[Settlement] = match way {
                0 => None,
                1 => Some(decode_settlement(file, raw, mut at, way)?),
                2 => Some(decode_settlement(file, raw, mut at, way)?),
                _ => return Error(disk_fault(file, at - 1, Malformed)),
            }
            let rec = CallRecord(key: take key, args: take args, stream: take stream, revision: take revision, code: take code)
            call = Some(CallSection(record: take rec, settlement: settlement))
        }
    }
    if at != list.len(raw) { return Error(disk_fault(file, at, Malformed)) }
    if let Some(c) = call {
        let mut matching = false
        for op in streams {
            if op.key == c.record.stream { matching = true }
        }
        if !matching { return Error(disk_fault(file, at, Malformed)) }
    }
    Ok(JournalCommit(branch: br, version: head, at: wall, data: take data, streams: take streams, call: take call))
}

// AD1 (vi): the hand-written revision 0x00, 0x01, ..., 0x1f.
fn code_vector() -> Bytes {
    let mut raw: Bytes = list.new()
    result.unwrap(list.fill(mut raw, 48, 9u8))
    raw
}

fn revision_vector() -> Bytes {
    let mut r: Bytes = result.unwrap(list.with_capacity(32))
    for i in 0u64 .. 32 { result.unwrap(list.push(mut r, int.truncate(i))) }
    r
}

fn revision_is_vector(got: Option[Bytes]) -> bool {
    match got { Some(r) => r == revision_vector(), None => false }
}

fn revision_is_none(got: Option[Bytes]) -> bool {
    match got { Some(_) => false, None => true }
}

// L10/L12: hand-laid payload with both state sections and a CALL. The call
// follows its stream op; section ordering carries no semantic distinction.
pub fn journal_law_payload() -> bool {
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, 3, 4))
    result.unwrap(le(mut payload, 257, 8))
    result.unwrap(le(mut payload, 1234, 8))
    result.unwrap(le(mut payload, 3, 1))
    result.unwrap(le(mut payload, 2, 1))
    result.unwrap(blob(mut payload, string.as_bytes("entry")))
    result.unwrap(blob(mut payload, string.as_bytes("arguments")))
    result.unwrap(blob(mut payload, string.as_bytes("stream")))
    result.unwrap(blob(mut payload, revision_vector()))
    result.unwrap(blob(mut payload, code_vector()))
    result.unwrap(le(mut payload, 0, 1))
    result.unwrap(le(mut payload, 0, 1))
    result.unwrap(le(mut payload, 2, 4))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(blob(mut payload, string.as_bytes("key")))
    result.unwrap(blob(mut payload, string.as_bytes("value")))
    result.unwrap(le(mut payload, 2, 1))
    result.unwrap(blob(mut payload, string.as_bytes("gone")))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(le(mut payload, 1, 4))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(blob(mut payload, string.as_bytes("stream")))
    result.unwrap(blob(mut payload, string.as_bytes("reply")))
    let got = result.unwrap(journal_decode("j-7", payload))
    if got.branch != 3 || got.version != 257 || got.at != 1234 || list.len(got.data) != 2 || list.len(got.streams) != 1 { return false }
    if got.data[0].key != string.as_bytes("key") { return false }
    match got.data[0].value { Some(v) => if v != string.as_bytes("value") { return false }, None => return false }
    if got.data[1].key != string.as_bytes("gone") || got.data[1].value != None { return false }
    if got.streams[0].key != string.as_bytes("stream") { return false }
    match got.streams[0].value { Some(v) => if v != string.as_bytes("reply") { return false }, None => return false }
    match got.call {
        Some(c) => if c.record.key != string.as_bytes("entry") || c.record.args != string.as_bytes("arguments") || c.record.stream != string.as_bytes("stream") || !revision_is_vector(c.record.revision) { return false },
        None => return false
    }
    // AD1: the revision field is bytes 54..90 (u32 32 then 0x00..0x1f). Length
    // 0 reads as None; length 1 is malformed.
    for size in 0u64 .. 2 {
        let mut other: Bytes = result.unwrap(copied(list.slice(payload, 0, 54)))
        result.unwrap(le(mut other, size, 4))
        if size == 1 { result.unwrap(list.push(mut other, 0u8)) }
        result.unwrap(list.append(mut other, list.slice(payload, 90, list.len(payload))))
        let read_back = journal_decode("j-7", other)
        if size == 1 {
            match read_back { Error(Corrupt(fault)) => match fault.why { Malformed => {}, _ => return false }, _ => return false }
        } else {
            match result.unwrap(take read_back).call { Some(c) => if !revision_is_none(c.record.revision) { return false }, None => return false }
        }
    }
    for i in 0u64 .. list.len(payload) {
        if !disk_corrupt(journal_decode("j-7", list.slice(payload, 0, i))) { return false }
    }
    let mut trailing = result.unwrap(copied(payload))
    result.unwrap(list.push(mut trailing, 0u8))
    if !disk_corrupt(journal_decode("j-7", trailing)) { return false }
    // A checked call record without the named stream op cannot be replayed.
    let mut no_reply = result.unwrap(copied(payload))
    let _ = list.set(mut no_reply, 48, 120u8)
    if !disk_corrupt(journal_decode("j-7", no_reply)) { return false }
    // Two sections with the same tag are malformed, including an empty one.
    let mut duplicate: Bytes = list.new()
    result.unwrap(le(mut duplicate, 0, 4))
    result.unwrap(le(mut duplicate, 1, 8))
    result.unwrap(le(mut duplicate, 2, 8))
    result.unwrap(le(mut duplicate, 2, 1))
    for i in 0u64 .. 2 {
        result.unwrap(le(mut duplicate, 0, 1))
        result.unwrap(le(mut duplicate, 0, 4))
    }
    disk_corrupt(journal_decode("j-7", duplicate))
}

@test
fn journal_test_payload() -> Result[(), ()] {
    if journal_law_payload() { Ok(()) } else { Error(()) }
}

type JournalSegment {
    end: u64,
    commits: List[JournalCommit]
}

// Middle segments stop at the next HEADER's prev_end. Only the last segment
// reads beyond its durable boundary, stopping at the first physically bad frame.
fn journal_segment(file: String, id: StoreId, seq: u64, raw: Bytes, boundary: Option[u64], last: bool) -> Result[JournalSegment, Error] {
    let header = disk_read_header(file, raw, 2, Some(seq), Some(id))?
    let durable_end = match boundary { Some(d) => d, None => 72u64 }
    if durable_end < 72 || durable_end > list.len(raw) { return Error(disk_fault(file, list.len(raw), Truncated)) }
    let stop = if last { list.len(raw) } else { durable_end }
    let mut at = 72u64
    let mut commits: List[JournalCommit] = list.new()
    while at < stop {
        let read_frame = disk_read_frame(file, header.context, raw, at)
        let frame = match take read_frame {
            Ok(f) => f,
            Error(Corrupt(take fault)) => {
                let torn = match fault.why {
                    Truncated => true, Flags => true, Checksum => true, Malformed => true, Kind(0) => true,
                    _ => false
                }
                if !last || at < durable_end || !torn { return Error(Corrupt(take fault)) }
                break
            },
            Error(take e) => return Error(take e)
        }
        if at < durable_end && frame.end > durable_end { return Error(disk_fault(file, at, Truncated)) }
        if frame.kind == 0x0011 {
            let payload = list.slice(raw, frame.payload, frame.end)
            let commit = journal_decode(file, payload)?
            capacity(result.capacity_only(list.push(mut commits, take commit)))?
        }
        at = frame.end
    }
    Ok(JournalSegment(end: at, commits: take commits))
}

fn journal_empty_commit(ctx: DiskContext, offset: u64, head: u64) -> Bytes {
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, 0, 4))
    result.unwrap(le(mut payload, head, 8))
    result.unwrap(le(mut payload, head + 100, 8))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(le(mut payload, 0, 1))
    result.unwrap(le(mut payload, 0, 4))
    result.unwrap(disk_seal(ctx, offset, 0x0011, 1, payload))
}

// L3/L10/L11/L12: the durable boundary is an independently calculated offset,
// never the decoder's returned end. Every truncation of the second42-byte frame
// is a valid torn last tail when d=114, and corruption when d=156.
pub fn journal_law_segment() -> bool {
    let id = StoreId(hi: 1, lo: 2)
    let ctx = DiskContext(store: id, role: 2, seq: 7)
    let header = result.unwrap(disk_header_bytes(ctx, 0))
    let first = journal_empty_commit(ctx, 72, 1)
    let second = journal_empty_commit(ctx, 114, 2)
    let mut raw = result.unwrap(copied(header))
    result.unwrap(list.append(mut raw, first))
    result.unwrap(list.append(mut raw, second))
    if list.len(raw) != 156 { return false }
    let got = result.unwrap(journal_segment("j-7", id, 7, raw, Some(114), true))
    if got.end != 156 || list.len(got.commits) != 2 || got.commits[0].version != 1 || got.commits[1].version != 2 { return false }
    let middle = result.unwrap(journal_segment("j-7", id, 7, raw, Some(114), false))
    if middle.end != 114 || list.len(middle.commits) != 1 { return false }
    for n in 114u64 .. 156 {
        let tail = list.slice(raw, 0, n)
        let partial = result.unwrap(journal_segment("j-7", id, 7, tail, Some(114), true))
        if partial.end != 114 || list.len(partial.commits) != 1 { return false }
        if !disk_corrupt(journal_segment("j-7", id, 7, tail, Some(156), true)) { return false }
    }
    for n in 72u64 .. 114 {
        let mut broken = result.unwrap(copied(raw))
        let changed = broken[n] ^ 1u8
        let _ = list.set(mut broken, n, changed)
        if !disk_corrupt(journal_segment("j-7", id, 7, broken, Some(114), true)) { return false }
        let torn = result.unwrap(journal_segment("j-7", id, 7, broken, None, true))
        if torn.end != 72 || list.len(torn.commits) != 0 { return false }
    }
    if !disk_corrupt(journal_segment("j-7", id, 7, raw, Some(115), true)) { return false }
    let empty: Bytes = list.new()
    let optional = result.unwrap(disk_seal(ctx, 72, 0x7ffe, 0, empty))
    let shifted = journal_empty_commit(ctx, 88, 1)
    let mut extended = result.unwrap(copied(header))
    result.unwrap(list.append(mut extended, optional))
    result.unwrap(list.append(mut extended, shifted))
    let future = result.unwrap(journal_segment("j-7", id, 7, extended, None, true))
    if future.end != 130 || list.len(future.commits) != 1 { return false }
    let required = result.unwrap(disk_seal(ctx, 156, 0x0040, 1, empty))
    result.unwrap(list.append(mut raw, required))
    match journal_segment("j-7", id, 7, raw, Some(114), true) {
        Error(Unsupported(0x0040)) => true,
        _ => false
    }
}

@test
fn journal_test_segment() -> Result[(), ()] {
    if journal_law_segment() { Ok(()) } else { Error(()) }
}

type JournalReplay {
    state: State,
    next_node: u64
}

fn journal_main(take roots: Roots, head: u64, at: u64, next_node: u64) -> JournalReplay {
    JournalReplay(state: result.unwrap(main_state(take roots, head, at)), next_node: next_node)
}

fn journal_apply_ops(mut ids: u64, tree: std.omap.OMap[Bytes, Arc[Bytes]], ops: List[JournalOp]) -> Result[std.omap.OMap[Bytes, Arc[Bytes]], Error] {
    let mut current = std.omap.snapshot(tree)
    for op in ops {
        match op.value {
            Some(value) => {
                let key = copied(op.key)?
                let shared = capacity(result.capacity_only(arc.new(copied(value)?)))?
                let (take updated, _) = capacity(result.capacity_only(std.omap.insert(mut ids, current, take key, take shared)))?
                current = take updated
            },
            None => {
                current = capacity(std.omap.remove(mut ids, current, op.key))?
            }
        }
    }
    Ok(take current)
}

fn journal_apply(file: String, mut replay: JournalReplay, commit: JournalCommit) -> Result[(), Error] {
    // Section 3.4 step 6: the branch must exist, and the version is its head + 1.
    let count = list.len(replay.state.tips)
    let mut i = count
    for k in 0u64 .. count {
        if replay.state.tips[k].id == commit.branch { i = k }
    }
    if i == count || commit.version != replay.state.tips[i].head + 1 { return Error(disk_fault(file, 0, Gap(commit.version))) }
    let data = journal_apply_ops(mut replay.next_node, replay.state.tips[i].roots.data, commit.data)?
    let streams = journal_apply_ops(mut replay.next_node, replay.state.tips[i].roots.streams, commit.streams)?
    replay.state.tips[i].roots.data = take data
    replay.state.tips[i].roots.streams = take streams
    replay.state.tips[i].head = commit.version
    replay.state.tips[i].at = commit.at
    Ok(())
}

// L3/L10/L18c: replay applies both state trees, keeps the catalog and uses the
// frame's branch/version/at. An unknown branch or a repeated version is Gap.
pub fn journal_law_apply() -> bool {
    let mut replay = journal_initial()
    for head in 1u64 .. 4 {
        let key = result.unwrap(physical(1, key_word(7)))
        let mut data: List[JournalOp] = list.new()
        result.unwrap(list.push(mut data, JournalOp(key: result.unwrap(copied(key)), value: Some(key_word(head * 10)))))
        let mut streams: List[JournalOp] = list.new()
        result.unwrap(list.push(mut streams, JournalOp(key: result.unwrap(copied(string.as_bytes("stream"))), value: Some(key_word(head)))))
        let commit = JournalCommit(branch: 0, version: head, at: 100 + head, data: take data, streams: take streams, call: None)
        result.unwrap(journal_apply("j-7", mut replay, commit))
        if replay.state.tips[0].head != head || replay.state.tips[0].at != 100 + head { return false }
        match std.omap.get(replay.state.tips[0].roots.data, key) { Some(v) => if decode_word(v) != head * 10 { return false }, None => return false }
        match std.omap.get(replay.state.tips[0].roots.streams, string.as_bytes("stream")) { Some(v) => if decode_word(v) != head { return false }, None => return false }
    }
    let saved = std.omap.snapshot(replay.state.tips[0].roots.data)
    let duplicate = JournalCommit(branch: 0, version: 3, at: 103, data: list.new(), streams: list.new(), call: None)
    match journal_apply("j-7", mut replay, duplicate) { Error(Corrupt(f)) => match f.why { Gap(3) => {}, _ => return false }, _ => return false }
    let foreign_branch = JournalCommit(branch: 1, version: 4, at: 104, data: list.new(), streams: list.new(), call: None)
    match journal_apply("j-7", mut replay, foreign_branch) { Error(Corrupt(f)) => match f.why { Gap(4) => {}, _ => return false }, _ => return false }
    let key = result.unwrap(physical(1, key_word(7)))
    let mut deletes: List[JournalOp] = list.new()
    result.unwrap(list.push(mut deletes, JournalOp(key: result.unwrap(copied(key)), value: None)))
    let removed = JournalCommit(branch: 0, version: 4, at: 104, data: take deletes, streams: list.new(), call: None)
    result.unwrap(journal_apply("j-7", mut replay, removed))
    if std.omap.len(replay.state.tips[0].roots.data) != 0 || std.omap.len(saved) != 1 || replay.state.tips[0].head != 4 || replay.state.tips[0].at != 104 { return false }
    if std.omap.len(replay.state.tips[0].roots.catalog) != 0 || std.omap.len(replay.state.tips[0].roots.streams) != 1 { return false }
    match std.omap.get(saved, key) { Some(v) => decode_word(v) == 30, None => false }
}

@test
fn journal_test_apply() -> Result[(), ()] {
    if journal_law_apply() { Ok(()) } else { Error(()) }
}

// The lookahead needs only the next HEADER's prev_end. Read that prefix, not
// a second whole segment, while the current segment's buffer is retained.
fn journal_header(d: Dir, id: StoreId, seq: u64, flush: bool) -> Result[Option[DiskHeader], Error] waits {
    let path = capacity(disk_path("j-", seq, ""))?
    let mut file = match host.open(d, path, Read) {
        Ok(take file) => take file,
        Error(NotFound) => return Ok(None),
        Error(e) => return Error(Io(e))
    }
    if flush { disk_io(host.sync(mut file))? }
    let mut raw: Bytes = capacity(list.with_capacity(72))?
    while list.len(raw) < 72 {
        let mut chunk: Bytes = capacity(list.with_capacity(72 - list.len(raw)))?
        if disk_io(host.read(mut file, mut chunk))? == 0 { break }
        capacity(list.append(mut raw, chunk))?
    }
    disk_io(host.close(take file))?
    Ok(Some(disk_read_header(path, raw, 2, Some(seq), Some(id))?))
}

type JournalRecovered {
    replay: JournalReplay,
    seq: u64,
    end: u64
}

fn journal_recover(d: Dir, id: StoreId, first: u64, take initial: JournalReplay) -> Result[JournalRecovered, Error] waits {
    let mut replay = take initial
    let mut seq = first
    loop {
        let path = capacity(disk_path("j-", seq, ""))?
        let raw = match disk_read_synced(d, path, 18446744073709551615) {
            Ok(take bytes_in) => take bytes_in,
            Error(Io(NotFound)) => return Error(disk_fault(path, 0, Header)),
            Error(take e) => return Error(take e)
        }
        let following = journal_following(d, id, seq, true)?
        let boundary = match following {
            Some(h) => Some(h.prev_end),
            None => disk_end(d, id, seq)?
        }
        let last = match following { None => true, Some(_) => false }
        let parsed_segment = journal_segment(path, id, seq, raw, boundary, last)
        let segment = match take parsed_segment {
            Ok(take segment) => take segment,
            Error(Corrupt(take fault)) => {
                // A bad last HEADER without a good END is an incomplete
                // segment creation. Valid headers with bad frames follow d.
                let header_bad = match disk_read_header(path, raw, 2, Some(seq), Some(id)) {
                    Error(Corrupt(_)) => true,
                    _ => false
                }
                let no_end = match boundary { None => true, Some(_) => false }
                if header_bad && last && no_end && seq == first {
                    return Ok(JournalRecovered(replay: take replay, seq: seq - 1, end: 0))
                }
                return Error(Corrupt(take fault))
            },
            Error(take e) => return Error(take e)
        }
        let end = segment.end
        for commit in segment.commits { journal_apply(path, mut replay, commit)? }
        if let None = following { return Ok(JournalRecovered(replay: take replay, seq: seq, end: end)) }
        seq += 1
    }
}

fn journal_account_node(node: Arc[std.omap.Node[Bytes, Arc[Bytes]]]) -> u64 {
    let mut live = disk_node_charge(node)
    if std.omap.node_level(node) != 0 {
        for i in 0u64 .. std.omap.node_count(node) {
            live = int.saturating_add(live, journal_account_node(option.unwrap(std.omap.node_child(node, i))))
        }
    }
    live
}

fn journal_account(roots: Roots) -> u64 {
    let mut live = 0u64
    if let Some(n) = std.omap.root(roots.data) { live = int.saturating_add(live, journal_account_node(n)) }
    if let Some(n) = std.omap.root(roots.streams) { live = int.saturating_add(live, journal_account_node(n)) }
    if let Some(n) = std.omap.root(roots.catalog) { live = int.saturating_add(live, journal_account_node(n)) }
    live
}

fn journal_end_bytes(id: StoreId, seq: u64, end: u64) -> Bytes {
    let ctx = DiskContext(store: id, role: 4, seq: seq)
    let mut raw = result.unwrap(disk_header_bytes(ctx, 0))
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, end, 8))
    let frame = result.unwrap(disk_seal(ctx, 72, 0x0012, 1, payload))
    result.unwrap(list.append(mut raw, frame))
    take raw
}

fn journal_initial() -> JournalReplay {
    journal_main(empty_roots(), 0, 0, 0)
}

// L3/L10/L12: next-header prev_end ignores an older torn tail; a bad final
// header is absent only without a good END, and its predecessor uses its own d.
pub fn journal_law_recovery(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let (take old, take old_end) = result.unwrap(disk_new_segment(d, id, 7, 0))
    let mut old_file = take old
    let first = journal_empty_commit(DiskContext(store: id, role: 2, seq: 7), 72, 1)
    result.unwrap(host.write(mut old_file, first))
    let mut junk: Bytes = list.new()
    result.unwrap(list.fill(mut junk, 16, 255u8))
    result.unwrap(host.write(mut old_file, junk))
    result.unwrap(host.sync(mut old_file))
    result.unwrap(host.close(take old_file))
    result.unwrap(host.close(take old_end))
    result.unwrap(disk_write_synced(d, "j-7.end", journal_end_bytes(id, 7, 114)))
    let (take next_file, take next_end) = result.unwrap(disk_new_segment(d, id, 8, 114))
    let mut newest = take next_file
    let second = journal_empty_commit(DiskContext(store: id, role: 2, seq: 8), 72, 2)
    result.unwrap(host.write(mut newest, second))
    result.unwrap(host.sync(mut newest))
    result.unwrap(host.close(take newest))
    result.unwrap(host.close(take next_end))
    result.unwrap(disk_write_synced(d, "j-8.end", journal_end_bytes(id, 8, 114)))
    let all = result.unwrap(journal_recover(d, id, 7, journal_initial()))
    if all.seq != 8 || all.end != 114 || all.replay.state.tips[0].head != 2 || all.replay.state.tips[0].at != 102 { return false }
    let empty: Bytes = list.new()
    result.unwrap(disk_write_synced(d, "j-9", empty))
    let incomplete = result.unwrap(journal_recover(d, id, 7, journal_initial()))
    if incomplete.seq != 8 || incomplete.end != 114 || incomplete.replay.state.tips[0].head != 2 { return false }
    result.unwrap(disk_write_synced(d, "j-9.end", journal_end_bytes(id, 9, 72)))
    if !disk_corrupt(journal_recover(d, id, 7, journal_initial())) { return false }
    result.unwrap(host.remove(d, "j-9.end"))
    result.unwrap(host.remove(d, "j-8"))
    let previous = result.unwrap(journal_recover(d, id, 7, journal_initial()))
    previous.seq == 7 && previous.end == 114 && previous.replay.state.tips[0].head == 1 && previous.replay.state.tips[0].at == 101
}

@test
fn journal_test_recovery(d: Dir) -> Result[(), ()] waits {
    if journal_law_recovery(disk_test_directory(d)) { Ok(()) } else { Error(()) }
}

// Recovery precedes admission and rotation. The pack account alone is too
// small after replay; a refused open releases LOCK without publishing a cut.
pub fn journal_law_bootstrap(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = defaults()
    options.checkpoint_task_bytes = 1048576
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let table_handle = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = shape(table_handle)
    let id = db.store
    let seq = db.file_seq
    let baseline = db.resident
    let wall = db.heads[0].at + 17
    let next_node = db.next_node
    result.unwrap(close(take db))
    let mut stored: Bytes = list.new()
    result.unwrap(le(mut stored, 0, 2))
    result.unwrap(le(mut stored, 70, 8))
    let key = result.unwrap(physical(1, key_word(7)))
    let mut ids = 0u64
    let ops: std.omap.OMap[Bytes, Option[Bytes]] = std.omap.new()
    let (take written, _) = result.unwrap(std.omap.insert(mut ids, ops, take key, Some(take stored)))
    let ci = CallInfo(id: CallId(store: id, branch: 0, version: 2), at: wall, seed: 0)
    let raw = result.unwrap(encode_commit(ci, written, seq, 72))
    if list.len(raw) != 73 { return false }
    let path = result.unwrap(disk_path("j-", seq, ""))
    let mut file = result.unwrap(host.open(d, path, Append))
    result.unwrap(host.write(mut file, raw))
    result.unwrap(host.sync(mut file))
    result.unwrap(host.close(take file))
    let end_path = result.unwrap(disk_path("j-", seq, ".end"))
    result.unwrap(disk_write_synced(d, end_path, journal_end_bytes(id, seq, 145)))
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    if reopened.heads[0].head != 2 || reopened.heads[0].at != wall || reopened.resident != baseline + 94 || reopened.next_node <= next_node { return false }
    if result.unwrap(get(snapshot(reopened), sh, 7)) != Some(70u64) { return false }
    result.unwrap(close(take reopened))
    options.resident_limit = baseline + 93
    match open(tasks, d, c, r, options) {
        Error(Full(cap)) => if cap.requested != baseline + 94 || cap.available != baseline + 93 { return false },
        _ => return false
    }
    options.resident_limit = baseline + 94
    let exact = result.unwrap(open(tasks, d, c, r, options))
    if result.unwrap(get(snapshot(exact), sh, 7)) != Some(70u64) { return false }
    result.unwrap(close(take exact))
    true
}

@test
fn journal_test_bootstrap(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_bootstrap(disk_test_directory(d), c, r, tasks) { Ok(()) } else { Error(()) }
}

type JournalMsg: send = Frame(Bytes, u64) | Rotate(HostFile, HostFile) | Barrier

type WriteNotice: send = Written | WriteFailed(IoError)

type JournalWorker: send {
    d: Dir,
    store: StoreId,
    seq: u64,
    segment: HostFile,
    end_file: HostFile,
    group_commits: u32,
    group_bytes: u32,
    receive: Receiver[JournalMsg],
    send: Sender[Ack],
    ready: Sender[Result[(), Capacity]],
    written: Sender[WriteNotice]
}

type JournalBuffers {
    group: Bytes,
    end_bytes: Bytes,
    binding: Bytes,
    name: String
}

fn journal_set(mut raw: Bytes, at: u64, value: u64, width: u64) {
    for i in 0u64 .. width { raw[at + i] = int.truncate(value >> (i * 8)) }
}

fn journal_fixed_check(binding: Bytes, raw: Bytes, at: u64, length: u64) -> u64 {
    let mut state = std.check.start()
    std.check.add(mut state, binding, 0, 33)
    std.check.add(mut state, raw, at, at + 8)
    std.check.add(mut state, raw, at + 16, at + 16 + length)
    std.check.finish(state)
}

fn journal_buffers(reserve: u64) -> Result[JournalBuffers, Capacity] {
    let group: Bytes = list.with_capacity(reserve)?
    let mut end_bytes: Bytes = list.with_capacity(96)?
    list.fill(mut end_bytes, 96, 0u8)?
    let mut binding: Bytes = list.with_capacity(33)?
    list.fill(mut binding, 33, 0u8)?
    let name = string.with_capacity(32)?
    Ok(JournalBuffers(group: take group, end_bytes: take end_bytes, binding: take binding, name: take name))
}

// END's bytes, checksum binding and name all reuse storage admitted at spawn.
fn journal_write_end(d: Dir, id: StoreId, seq: u64, end: u64, mut end_file: Option[HostFile], mut raw: Bytes, mut binding: Bytes, mut name: String) -> Result[(), Error] waits {
    journal_set(mut binding, 0, id.hi, 8)
    journal_set(mut binding, 8, id.lo, 8)
    journal_set(mut binding, 16, 4, 1)
    journal_set(mut binding, 17, seq, 8)
    journal_set(mut binding, 25, 0, 8)
    journal_set(mut raw, 0, 1, 2)
    journal_set(mut raw, 2, 1, 2)
    journal_set(mut raw, 4, 56, 4)
    let magic = string.as_bytes("HIRSTORE")
    for i in 0u64 .. 8 { raw[16 + i] = magic[i] }
    journal_set(mut raw, 24, 2, 4)
    journal_set(mut raw, 28, 4, 1)
    journal_set(mut raw, 32, id.hi, 8)
    journal_set(mut raw, 40, id.lo, 8)
    journal_set(mut raw, 56, seq, 8)
    let header_check = journal_fixed_check(binding, raw, 0, 56)
    journal_set(mut raw, 8, header_check, 8)
    journal_set(mut raw, 72, 0x0012, 2)
    journal_set(mut raw, 74, 1, 2)
    journal_set(mut raw, 76, 8, 4)
    journal_set(mut raw, 88, end, 8)
    journal_set(mut binding, 25, 72, 8)
    let end_check = journal_fixed_check(binding, raw, 72, 8)
    journal_set(mut raw, 80, end_check, 8)
    string.truncate(mut name, 0)
    result.unwrap(string.push(mut name, "j-"))
    result.unwrap(string.push_u64(mut name, seq))
    result.unwrap(string.push(mut name, ".end"))
    let previous = replace(mut end_file, None)
    if let Some(take file) = take previous { disk_io(host.close(take file))? }
    let mut file = disk_io(host.open(d, name, Write))?
    match host.write(mut file, raw) { Ok(()) => {}, Error(e) => return Error(Io(e.error)) }
    disk_io(host.sync(mut file))?
    end_file = Some(take file)
    Ok(())
}

fn journal_loop(take input: JournalWorker, take scratch: JournalBuffers) -> Result[(), Error] waits {
    let JournalWorker(d: d, store: id, seq: initial_seq, segment: take segment, end_file: take end_file,
                      group_commits: max_frames, group_bytes: max_bytes, receive: take receive, send: take send, ready: _, written: take notices) = take input
    let mut segment_file = take segment
    let mut end_file_slot = Some(take end_file)
    let mut seq = initial_seq
    let mut end = 72u64
    let mut written = 0u64
    let mut groups = 0u64
    let JournalBuffers(group: take reserved, end_bytes: take initial_end, binding: take initial_binding, name: take initial_name) = take scratch
    let mut buffer = take reserved
    let mut end_bytes = take initial_end
    let mut binding = take initial_binding
    let mut end_name = take initial_name
    let mut deferred: Option[JournalMsg] = None
    loop {
        let mut next_message = replace(mut deferred, None)
        if let None = next_message {
            if groups != 0 {
                // A cap or Barrier can end a group without probing the queue.
                match channel.try_receive(receive) {
                    Ok(take msg) => { next_message = Some(take msg) },
                    Error(Empty) => {
                        journal_write_end(d, id, seq, end, mut end_file_slot, mut end_bytes, mut binding, mut end_name)?
                        groups = 0
                    },
                    Error(Closed) => {}
                }
            }
            if let None = next_message {
                next_message = match channel.receive(receive) { Ok(take msg) => Some(take msg), Error(_) => None }
            }
        }
        list.clear(mut buffer)
        let mut frames = 0u64
        let mut last_frame = 0u64
        let mut idle = false
        let mut closing = false
        let mut rotating: Option[(HostFile, HostFile)] = None
        let mut answering = false
        loop {
            let selected = replace(mut next_message, None)
            match take selected {
                None => { closing = true; break },
                Some(Frame(take raw, number)) => {
                    if frames != 0 && list.len(buffer) + list.len(raw) > int.widen(max_bytes) {
                        deferred = Some(Frame(take raw, number))
                        break
                    }
                    result.unwrap(list.append(mut buffer, raw))
                    end += list.len(raw)
                    written += list.len(raw)
                    last_frame = number
                    frames += 1
                    if frames >= int.widen(max_frames) || list.len(buffer) >= int.widen(max_bytes) { break }
                    match channel.try_receive(receive) {
                        Ok(take msg) => { next_message = Some(take msg) },
                        Error(Empty) => { idle = true; break },
                        Error(Closed) => { closing = true; break }
                    }
                },
                Some(Rotate(take file, take rotated_end)) => { rotating = Some((take file, take rotated_end)); break },
                Some(Barrier) => { answering = true; break }
            }
        }
        if frames != 0 {
            match host.write(mut segment_file, buffer) { Ok(()) => {}, Error(e) => return Error(Io(e.error)) }
        }
        if answering { let _ = channel.try_send(notices, Written) }
        if frames != 0 {
            disk_io(host.sync(mut segment_file))?
            if let Error(_) = channel.send(send, Journaled(last_frame, written)) { return Ok(()) }
            groups += 1
        }
        let rotate_now = match rotating { Some(_) => true, None => false }
        if idle || closing || rotate_now || groups == 64 {
            journal_write_end(d, id, seq, end, mut end_file_slot, mut end_bytes, mut binding, mut end_name)?
            groups = 0
        }
        if let Some((take new_file, take new_end)) = take rotating {
            disk_io(host.close(take segment_file))?
            let previous_end = replace(mut end_file_slot, None)
            if let Some(take old_end) = take previous_end { disk_io(host.close(take old_end))? }
            segment_file = take new_file
            end_file_slot = Some(take new_end)
            seq += 1
            end = 72
        }
        if closing {
            disk_io(host.close(take segment_file))?
            let previous_end = replace(mut end_file_slot, None)
            if let Some(take old_end) = take previous_end { disk_io(host.close(take old_end))? }
            return Ok(())
        }
    }
}

fn journal_worker(take input: JournalWorker) -> Result[(), Error] waits {
    let requested: u64 = int.widen(input.group_bytes)
    let reserve = if requested > 16777296 { requested } else { 16777296u64 }
    let allocation = journal_buffers(reserve)
    let reserved = match take allocation {
        Ok(take buffer) => take buffer,
        Error(c) => { let _ = channel.send(input.ready, Error(c)); return Ok(()) }
    }
    if let Error(_) = channel.send(input.ready, Ok(())) { return Ok(()) }
    let send = channel.sender(input.send)
    let written = channel.sender(input.written)
    let result = journal_loop(take input, take reserved)
    if let Error(Io(e)) = result {
        let _ = channel.try_send(written, WriteFailed(e))
        let _ = channel.send(send, Broken(e))
    }
    take result
}

fn journal_worker_case(d: Dir, tasks: Tasks, mode: u64) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let (take segment, take end_file) = result.unwrap(disk_new_segment(d, id, 7, 0))
    let (send, receive): (Sender[JournalMsg], Receiver[JournalMsg]) = result.unwrap(channel.new(128))
    let (acks, received): (Sender[Ack], Receiver[Ack]) = result.unwrap(channel.new(128))
    let (ready, waiting): (Sender[Result[(), Capacity]], Receiver[Result[(), Capacity]]) = result.unwrap(channel.new(1))
    let (written_send, written_receive): (Sender[WriteNotice], Receiver[WriteNotice]) = result.unwrap(channel.new(2))
    let first = journal_empty_commit(DiskContext(store: id, role: 2, seq: 7), 72, 1)
    result.unwrap(channel.send(send, Frame(take first, 1)))
    if mode == 3 {
        let (take rotated, take rotated_end) = result.unwrap(disk_new_segment(d, id, 8, 114))
        result.unwrap(channel.send(send, Rotate(take rotated, take rotated_end)))
    }
    for head in 2u64 .. 4 {
        let seq = if mode == 3 { 8u64 } else { 7u64 }
        let offset = if mode == 3 { 72 + (head - 2) * 42 } else { 72 + (head - 1) * 42 }
        let raw = journal_empty_commit(DiskContext(store: id, role: 2, seq: seq), offset, head)
        result.unwrap(channel.send(send, Frame(take raw, head)))
    }
    let max_frames = if mode == 1 { 1u32 } else { 8u32 }
    let max_bytes = if mode == 2 { 41u32 } else { 100u32 }
    let input = JournalWorker(d: d, store: id, seq: 7, segment: take segment, end_file: take end_file,
                              group_commits: max_frames, group_bytes: max_bytes, receive: take receive, send: take acks, ready: take ready, written: take written_send)
    let worker = if mode == 0 {
        result.unwrap(task.spawn(tasks, bytes 16842832, take input, journal_worker_zero))
    } else {
        result.unwrap(task.spawn(tasks, bytes 16842832, take input, journal_worker))
    }
    result.unwrap(result.unwrap(channel.receive(waiting)))
    let _ = take send
    result.unwrap(result.unwrap(task.join(take worker)))
    let mut group_count = 0u64
    let mut final_number = 0u64
    let mut final_bytes = 0u64
    while let Ok(ack) = channel.try_receive(received) {
        match ack {
            Journaled(n, bytes_out) => {
                group_count += 1
                if n <= final_number || bytes_out != n * 42 { return false }
                if mode == 0 && group_count == 1 && n != 2 { return false }
                if mode == 3 && group_count == 1 && n != 1 { return false }
                final_number = n
                final_bytes = bytes_out
            },
            _ => return false
        }
    }
    let expected_groups = if mode == 1 || mode == 2 { 3u64 } else { 2u64 }
    if group_count != expected_groups || final_number != 3 || final_bytes != 126 { return false }
    let end = result.unwrap(disk_end(d, id, 7))
    if end != Some(if mode == 3 { 114u64 } else { 198u64 }) { return false }
    let all = result.unwrap(journal_recover(d, id, 7, journal_initial()))
    if mode == 3 { all.seq == 8 && all.end == 156 && all.replay.state.tips[0].head == 3 } else { all.seq == 7 && all.end == 198 && all.replay.state.tips[0].head == 3 }
}

// L3/L10/L21: close drains every queued frame. Byte and frame bounds give
// different groupings but the same commit prefix; Rotate preserves that order.
pub fn journal_law_worker(d: Dir, tasks: Tasks) -> bool waits {
    for mode in 0u64 .. 4 {
        if !journal_worker_case(disk_test_directory(d), tasks, mode) { return false }
    }
    true
}

@test
fn journal_test_worker(d: Dir, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_worker(d, tasks) { Ok(()) } else { Error(()) }
}

// A writer that ended without its ack (cancelled before it could send
// Broken) is a terminal failure: the place stops, unacked sequences unanswered.
fn journal_receive(db: Db) -> Ack waits {
    match db.acks {
        Some(receiver) => match channel.receive(receiver) {
            Ok(ack) => ack,
            Error(_) => Broken(Closed)
        },
        None => fail("journal receiver")
    }
}

fn journal_ack(mut db: Db, take ack: Ack) -> Result[(), Error] {
    match take ack {
        Journaled(n, bytes_out) => {
            db.journaled = n
            db.inflight -= bytes_out - db.acked_bytes
            db.acked_bytes = bytes_out
            Ok(())
        },
        Broken(e) => {
            if let None = db.poison { db.poison = Some(e) }
            Error(Poisoned(option.unwrap(db.poison)))
        },
        Checkpointed(n, live) => { db.checkpointed = n; db.resident = live; Ok(()) }
    }
}

fn journal_poll(mut db: Db) -> Result[(), Error] {
    while let Some(take ack) = close_ack(db) { journal_ack(mut db, take ack)? }
    healthy(db)
}

// L18c/L21a: commits without an explicit cut survive close and reopen, and
// close releases LOCK. A subsequent cut retires their live journal segment.
pub fn journal_law_db(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = defaults()
    options.checkpoint_task_bytes = 1048576
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = shape(t)
    let before = db.file_seq
    let saved = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, t, 7, 70) }))
    let ci = match take saved {
        Committed(done) => {
            result.unwrap(durable(mut db, done.ticket))
            done.info
        },
        _ => return false
    }
    if db.journaled != 1 || db.inflight != 0 { return false }
    if !typed_put(mut db, t, 8, 80) { return false }
    if db.file_seq != before { return false }
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    if reopened.heads[0].head != ci.id.version + 1 || reopened.heads[0].at < ci.at { return false }
    if result.unwrap(get(snapshot(reopened), sh, 7)) != Some(70u64) || result.unwrap(get(snapshot(reopened), sh, 8)) != Some(80u64) { return false }
    let path = result.unwrap(disk_path("j-", before, ""))
    if !result.unwrap(disk_exists(d, path)) { return false }
    let cut = result.unwrap(checkpoint(mut reopened))
    result.unwrap(durable(mut reopened, cut))
    if result.unwrap(disk_exists(d, path)) { return false }
    result.unwrap(close(take reopened))
    let final_db = result.unwrap(open(tasks, d, c, r, options))
    if result.unwrap(get(snapshot(final_db), sh, 7)) != Some(70u64) || result.unwrap(get(snapshot(final_db), sh, 8)) != Some(80u64) { return false }
    result.unwrap(close(take final_db))
    true
}

@test
fn journal_test_db(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_db(disk_test_directory(d), c, r, tasks) { Ok(()) } else { Error(()) }
}

pub fn journal_law_end_storage(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let mut scratch = result.unwrap(journal_buffers(1024))
    let mut file: Option[HostFile] = None
    for seq in [7u64, 257u64] {
        let attempt = bound bytes 0 {
            journal_write_end(d, id, seq, 198, mut file, mut scratch.end_bytes, mut scratch.binding, mut scratch.name)
        }
        match take attempt { Ok(Ok(())) => {}, _ => return false }
        if result.unwrap(disk_end(d, id, seq)) != Some(198u64) { return false }
    }
    true
}





@test
fn journal_test_end_storage(d: Dir) -> Result[(), ()] waits {
    if journal_law_end_storage(disk_test_directory(d)) { Ok(()) } else { Error(()) }
}

// The law alone gives the running loop zero new bytes after its startup.
// Production reserves its root once and relies on the preallocated buffers.
fn journal_worker_zero(take input: JournalWorker) -> Result[(), Error] waits {
    let reserved = capacity(journal_buffers(16777296))?
    let _ = channel.send(input.ready, Ok(()))
    let attempt = bound bytes 0 { journal_loop(take input, take reserved) }
    capacity(take attempt)?
}

fn journal_following(d: Dir, id: StoreId, seq: u64, flush: bool) -> Result[Option[DiskHeader], Error] waits {
    let next_header = journal_header(d, id, seq + 1, flush)
    match take next_header {
            Ok(h) => Ok(h),
            Error(Corrupt(_)) => {
                let next_path = capacity(disk_path("j-", seq + 1, ""))?
                let beyond_path = capacity(disk_path("j-", seq + 2, ""))?
                if disk_exists(d, beyond_path)? || disk_end(d, id, seq + 1)? != None {
                    return Error(disk_fault(next_path, 0, Header))
                }
                Ok(None)
            },
            Error(take e) => return Error(take e)
        }

}

pub fn recorded(db: Db, b: Branch, wanted: u64) -> Result[Option[Recorded], Error] waits {
    healthy(db)?
    let i = branch_index(db, b)?
    if list.len(db.disk) == 0 { return Ok(None) }
    // A version the last cut covers has its frame below record_cut, so the
    // scan from there does not find it.
    if wanted > db.heads[i].head { return Ok(None) }
    // Z1: skip the barrier exactly when every frame this Db has sent is acked,
    // so it is written (X1 step 0's condition); never compare a version with
    // `journaled`, which counts frames.
    if !covered(db, Journal(db.frame_seq)) {
        if let Some(sender) = db.journal { let _ = channel.send(sender, Barrier) }
        if let Some(receiver) = db.written {
            match result.unwrap(channel.receive(receiver)) {
                Written => {},
                WriteFailed(e) => {
                    if let Some(sender) = db.written_send { let _ = channel.try_send(sender, WriteFailed(e)) }
                    return Error(Poisoned(e))
                }
            }
        }
    }
    let d = db.disk[0].d
    let mut seq = db.disk[0].record_cut
    loop {
        let path = capacity(disk_path("j-", seq, ""))?
        let raw = match disk_read_file(d, path, 18446744073709551615) {
            Ok(take bytes_in) => take bytes_in,
            Error(Io(NotFound)) => return Ok(None),
            Error(take e) => return Error(take e)
        }
        let following = journal_following(d, db.store, seq, false)?
        let boundary = match following { Some(h) => Some(h.prev_end), None => disk_end(d, db.store, seq)? }
        let last = match following { Some(_) => false, None => true }
        let segment = journal_segment(path, db.store, seq, raw, boundary, last)?
        let JournalSegment(end: _, commits: take commits) = take segment
        for take commit in take commits {
            if commit.branch == b.id && commit.version == wanted {
                let JournalCommit(branch: _, version: frame, at: wall, data: _, streams: _, call: take call) = take commit
                let answer: Option[Recorded] = match take call {
                    None => None,
                    Some(CallSection(record: take rec, settlement: settled)) => {
                        let context = match settled {
                            Some(found) => found,
                            None => Settlement(way: 0, base: frame - 1, at: wall, seed: call_info(db.store, b.id, frame, wall, wall).seed)
                        }
                        Some(Recorded(record: take rec, settle: context.way, branch: b, base: context.base, at: context.at, seed: context.seed))
                    },
                }
                return Ok(take answer)
            }
        }
        if last { return Ok(None) }
        seq += 1
    }
}

// L24's S3 half writes the specified CALL frame directly. record/reply are
// S5's producers; the S3 reader retains no call record in resident trees.
pub fn journal_law_recorded(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = defaults()
    options.checkpoint_task_bytes = 1048576
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let db = result.unwrap(open(tasks, d, c, r, options))
    let id = db.store
    let seq = db.file_seq
    result.unwrap(close(take db))
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, 0, 4))
    result.unwrap(le(mut payload, 1, 8))
    result.unwrap(le(mut payload, 101, 8))
    result.unwrap(le(mut payload, 2, 1))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(le(mut payload, 1, 4))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(blob(mut payload, string.as_bytes("stream")))
    let mut stream_value: Bytes = list.new()
    result.unwrap(le(mut stream_value, 1, 8))
    result.unwrap(list.fill(mut stream_value, 32, 5u8))
    result.unwrap(le(mut stream_value, 2, 1))
    result.unwrap(list.append(mut stream_value, string.as_bytes("reply")))
    result.unwrap(blob(mut payload, stream_value))
    result.unwrap(le(mut payload, 2, 1))
    result.unwrap(blob(mut payload, string.as_bytes("entry")))
    result.unwrap(blob(mut payload, string.as_bytes("arguments")))
    result.unwrap(blob(mut payload, string.as_bytes("stream")))
    // STORE v2.30 §2.4 (AN1/AN2): 21-byte COMMIT prefix, then the
    // streams section (5 + 1 + 10 + 4 + 41 + 5), then the CALL tag
    // and its first three blobs (1 + 9 + 13 + 10).
    let revision_at = 120u64
    result.unwrap(blob(mut payload, revision_vector()))
    result.unwrap(blob(mut payload, code_vector()))
    result.unwrap(le(mut payload, 0, 1))
    // Revision (36), code (52) and settle (1) add 89 bytes.
    if list.len(payload) != 209 { return false }
    let raw = result.unwrap(disk_seal(DiskContext(store: id, role: 2, seq: seq), 72, 0x0011, 1, payload))
    let path = result.unwrap(disk_path("j-", seq, ""))
    let mut file = result.unwrap(host.open(d, path, Append))
    result.unwrap(host.write(mut file, raw))
    result.unwrap(host.sync(mut file))
    result.unwrap(host.close(take file))
    let end_path = result.unwrap(disk_path("j-", seq, ".end"))
    // HEADER (72) + COMMIT frame overhead (16) + payload (209).
    result.unwrap(disk_write_synced(d, end_path, journal_end_bytes(id, seq, 297)))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    let b = main_branch(reopened)
    match result.unwrap(recorded(reopened, b, 1)) {
        Some(call_record) => if call_record.record.key != string.as_bytes("entry") || call_record.record.args != string.as_bytes("arguments") || call_record.record.stream != string.as_bytes("stream") || !revision_is_vector(call_record.record.revision) { return false },
        None => return false
    }
    if let Some(_) = result.unwrap(recorded(reopened, b, 0)) { return false }
    if let Some(_) = result.unwrap(recorded(reopened, b, 2)) { return false }
    let foreign_branch = Branch(store: StoreId(hi: id.hi ^ 1u64, lo: id.lo), id: 0)
    match recorded(reopened, foreign_branch, 1) { Error(Foreign) => {}, _ => return false }
    let cut = result.unwrap(checkpoint(mut reopened))
    result.unwrap(durable(mut reopened, cut))
    if let Some(_) = result.unwrap(recorded(reopened, b, 1)) { return false }
    if std.omap.len(reopened.heads[0].roots.streams) != 1 { return false }
    result.unwrap(close(take reopened))
    // AD1: a one-byte entry revision is malformed even when the code
    // and settlement fields are present and the checksum matches.
    let bad_dir = disk_test_directory(d)
    let bad = result.unwrap(open(tasks, bad_dir, c, r, options))
    let bad_id = bad.store
    let bad_seq = bad.file_seq
    result.unwrap(close(take bad))
    let mut one: Bytes = list.new()
    result.unwrap(list.fill(mut one, 1, 7u8))
    let mut short = result.unwrap(copied(list.slice(payload, 0, revision_at)))
    result.unwrap(blob(mut short, one))
    result.unwrap(blob(mut short, code_vector()))
    result.unwrap(le(mut short, 0, 1))
    // The one-byte revision makes this payload 31 bytes shorter.
    if list.len(short) != 178 { return false }
    let short_raw = result.unwrap(disk_seal(DiskContext(store: bad_id, role: 2, seq: bad_seq), 72, 0x0011, 1, short))
    let short_path = result.unwrap(disk_path("j-", bad_seq, ""))
    let mut short_file = result.unwrap(host.open(bad_dir, short_path, Append))
    result.unwrap(host.write(mut short_file, short_raw))
    result.unwrap(host.sync(mut short_file))
    result.unwrap(host.close(take short_file))
    let short_end = result.unwrap(disk_path("j-", bad_seq, ".end"))
    result.unwrap(disk_write_synced(bad_dir, short_end, journal_end_bytes(bad_id, bad_seq, 266)))
    match open(tasks, bad_dir, c, r, options) {
        Error(Corrupt(fault)) => match fault.why { Malformed => {}, _ => return false },
        _ => return false
    }
    let in_memory = memory(c, r, options)
    let memory_branch = main_branch(in_memory)
    match result.unwrap(recorded(in_memory, memory_branch, 1)) { None => true, Some(_) => false }
}

@test
fn journal_test_recorded(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_recorded(disk_test_directory(d), c, r, tasks) { Ok(()) } else { Error(()) }
}

// L24(v), Z1 by hand: 100 main commits made durable leave journaled at frame
// 100. A fork from version 1 commits its v2 with a CALL section as frame 101,
// which the journal task has not taken. recorded(fork, 2) must send the
// barrier and read Some, with AD1's revision. Main's v2 is under the fork's
// cut, so it is None. After reopen the fork's v2 is replayed and read again.
// Wrong implementations caught: a fast path that compares the version with
// journaled (2 <= 100 skips the barrier and reads None); a cover test that
// compares the version with main's head at the last cut (2 <= 101 is None).
pub fn journal_law_recorded_fork(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = journal_crash_options()
    options.resident_limit = 4194304
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let early = snapshot(db)
    for k in 0u64 .. 100 {
        if !typed_put(mut db, t, k, k) { return false }
    }
    let last = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq))
    result.unwrap(durable(mut db, last))
    if db.journaled != 100 || db.heads[0].head != 101 { return false }
    let (f, _) = result.unwrap(fork(mut db, "f", early))
    let commit_ticket = result.unwrap(journal_fixture_call(mut db, 1, false, Some(revision_vector())))
    match result.unwrap(recorded(db, f, 2)) {
        Some(captured) => if !revision_is_vector(captured.record.revision) || captured.record.stream != string.as_bytes("stream00") { return false },
        None => return false
    }
    let main = main_branch(db)
    if let Some(_) = result.unwrap(recorded(db, main, 2)) { return false }
    result.unwrap(durable(mut db, commit_ticket))
    result.unwrap(close(take db))
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    let again = match branch(reopened, "f") { Some(x) => x, None => return false }
    let good = match result.unwrap(recorded(reopened, again, 2)) {
        Some(captured) => revision_is_vector(captured.record.revision),
        None => false
    }
    result.unwrap(close(take reopened))
    good
}


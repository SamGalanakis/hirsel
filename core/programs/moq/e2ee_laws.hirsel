// MS5 law M10: relay_never_sees_plaintext (SFrame-encrypted objects through the MoQ relay).
fn e2ee_unhex(s: String) -> Bytes {
    option.unwrap(std.hex.decode(string.as_bytes(s)))
}

fn e2ee_copy(b: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(list.len(b))
    list.append(mut out, b)
    take out
}

fn e2ee_import(take raw: Bytes, uses: String) -> schedule.Schedule {
    let s = result.unwrap(secret.seal(take raw, uses))
    match schedule.import_sframe(Aes128GcmSha256_128, take s) {
        Ok(take keys) => take keys,
        Error(_) => fail("import_sframe refused test key"),
    }
}

fn e2ee_sender(base: Bytes, kid: u64, start_ctr: u64) -> sframe.Sender {
    let mut uses = string.from("sframe_import(send,")
    string.push_u64(mut uses, kid)
    string.push(mut uses, ",0)")
    let keys = e2ee_import(e2ee_copy(base), uses)
    let mut s = match sframe.sender(Aes128GcmSha256_128(), Rfc, Fixed(kid), take keys, 0, sframe.Mark(ctr: start_ctr, volume: 0), sframe.limits()) {
        Ok(take sender) => take sender,
        Error(_) => fail("sframe sender refused"),
    }
    let _ = result.unwrap(sframe.reserve(mut s, 1024, 1 << 24))
    take s
}

fn e2ee_receiver(base: Bytes, kid: u64) -> sframe.Receiver {
    let mut r = result.unwrap(sframe.receiver(Aes128GcmSha256_128(), Rfc, sframe.limits()))
    let keys = e2ee_import(e2ee_copy(base), "sframe_import(receive)")
    result.unwrap(sframe.install(mut r, kid, take keys, 0))
    take r
}

/// bug: an SFrame-protected object leaves plaintext bytes in the relay's cache or session
/// buffers, diverges from RFC 9605 Appendix C.3, fails to decrypt for authorized subscribers
/// (live or via FETCH), or accepts tampered routing metadata / missing keys.
/// oracle: M10 (docs/spec/moq.md) — marker scan over all relay buffers and RFC 9605 C.3 vector.
@test
fn relay_never_sees_plaintext() -> Result[(), ()] {
    // 1. Verify MoQ SFrame wrapper byte-for-byte against RFC 9605 Appendix C.3.
    let c3_base = e2ee_unhex("000102030405060708090a0b0c0d0e0f")
    let c3_meta = e2ee_unhex("4945544620534672616d65205747")
    let c3_plain = e2ee_unhex("64726166742d696574662d736672616d652d656e63")
    let c3_want = e2ee_unhex("9901234567b7412c2513a1b66dbb48841bbaf17f598751176ad847681a69c6d0b091c07018ce4adb34eb")
    let mut c3_s = e2ee_sender(c3_base, 0x123, 0x4567)
    let mut c3_r = e2ee_receiver(c3_base, 0x123)
    let tr_c3 = track(ns1(b"m10"), b"c3")
    let c3_obj = moq.Object(track: clone(tr_c3), group: 0, subgroup: 0, id: 0, mode: Subgroup, publisher_priority: 10, status: Normal, properties: b"", payload: shared.new(e2ee_copy(c3_plain)))
    let (take c3_sealed_obj, c3_sealed) = result.unwrap(moq.seal_object(mut c3_s, c3_obj, c3_meta))
    if c3_sealed.ctr != 0x4567 || c3_sealed.len != list.len(c3_want) || !bytes_eq_shared(c3_sealed_obj.payload, c3_want) {
        fail("M10: seal_object differs from RFC 9605 Appendix C.3")
    }
    let (take c3_back, c3_opened) = result.unwrap(moq.open_object(mut c3_r, c3_sealed_obj, c3_meta))
    if c3_opened.kid != 0x123 || c3_opened.ctr != 0x4567 || !bytes_eq_shared(c3_back.payload, c3_plain) {
        fail("M10: open_object failed to recover RFC 9605 Appendix C.3 plaintext")
    }
    // 2. End-to-end through a live MoQ Relay with caching, fan-out, and cache-backed FETCH.
    let lim = moq_limits()
    let rlim = moq.RelayLimits(cache_groups: 16, cache_bytes: 262144, per_track_cache_bytes: 262144, max_objects_per_group: 64, max_object_bytes: 16384)
    let mut rig = new_relay_rig(5001, lim, rlim, 8)
    let sc = moq.default_scope(b"e2ee.test", b"/m10")
    let pub_i = rig_add_peer(mut rig, 5002, Publisher, clone(sc), lim, 0)
    let sub_ok = rig_add_peer(mut rig, 5003, Subscriber, clone(sc), lim, 10)
    let sub_nokey = rig_add_peer(mut rig, 5004, Subscriber, clone(sc), lim, 20)
    let tr = track(ns1(b"m10"), b"secret-video")
    let _ = peer_subscribe(mut rig.peers[sub_ok], 30, clone(tr), NoFilter, 10, None)
    let _ = peer_subscribe(mut rig.peers[sub_nokey], 30, clone(tr), NoFilter, 10, None)
    rig_settle(mut rig, 31, true)
    let _ = peer_accept_subscribes(mut rig.peers[pub_i])
    rig_settle(mut rig, 32, true)
    let room_key = e2ee_unhex("101112131415161718191a1b1c1d1e1f")
    let kid = 7u64
    let mut sender = e2ee_sender(room_key, kid, 0)
    let mut recv_live = e2ee_receiver(room_key, kid)
    let mut recv_fetch = e2ee_receiver(room_key, kid)
    let mut recv_empty = result.unwrap(sframe.receiver(Aes128GcmSha256_128(), Rfc, sframe.limits()))
    let marker = b"HIRSEL-MOQ-SFRAME-PLAINTEXT-MARKER-9605"
    let mut first_cipher_sample: Bytes = list.new()
    let mut total_sent = 0u64
    for g in 0u64 .. 3 {
        for oid in 0u64 .. 4 {
            let mut plain: Bytes = list.with_capacity(list.len(marker) + 8)
            list.append(mut plain, marker)
            let gb: u8 = int.truncate(g)
            let ob: u8 = int.truncate(oid)
            list.push(mut plain, gb)
            list.push(mut plain, ob)
            let mode: moq.Mode = if oid == 3 {
                Datagram
            } else {
                Subgroup
            }
            let sg = oid % 2
            let raw_obj = moq.Object(track: clone(tr), group: g, subgroup: sg, id: oid, mode: mode, publisher_priority: 20, status: Normal, properties: b"", payload: shared.new(take plain))
            let (take sealed_obj, _) = result.unwrap(moq.seal_object_bound(mut sender, raw_obj))
            if total_sent == 0 {
                list.append(mut first_cipher_sample, sealed_obj.payload)
            }
            let fin_sg = mode == Subgroup && oid == 2
            peer_publish(mut rig.peers[pub_i], 40 + total_sent, sealed_obj, fin_sg)
            total_sent += 1
        }
    }
    rig_settle(mut rig, 100, true)
    // Verify relay actually cached objects (non-vacuous scan) and holds ciphertext, NOT plaintext!
    if moq.relay_cached_object_count(rig.r) < 9 {
        fail("M10: relay cache did not hold the published encrypted objects")
    }
    if !moq.relay_contains_bytes(rig.r, first_cipher_sample) {
        fail("M10: relay memory scanner did not observe the cached ciphertext (vacuous scan)")
    }
    if moq.relay_contains_bytes(rig.r, marker) {
        fail("M10: relay memory holds plaintext marker bytes")
    }
    // Authorized live subscriber decrypts every received object and recovers the exact marker.
    let mut live_decrypted = 0u64
    let mut tampered_checked = false
    for ev in rig.peers[sub_ok].events {
        if let Received(o) = ev {
            if !tampered_checked {
                // Tampering with routing metadata (group id) must fail AAD verification.
                let bad_meta = moq.Object(track: clone(o.track), group: o.group + 99, subgroup: o.subgroup, id: o.id, mode: o.mode, publisher_priority: o.publisher_priority, status: o.status, properties: clone(o.properties), payload: clone(o.payload))
                match moq.open_object_bound(mut recv_live, bad_meta) {
                    Error(Discarded(Tampered)) => {
                        tampered_checked = true
                    },
                    _ => fail("M10: tampered object routing metadata was not rejected"),
                }
            }
            let (take plain_obj, opened) = result.unwrap(moq.open_object_bound(mut recv_live, o))
            if opened.kid != kid {
                fail("M10: decrypted object had unexpected KID")
            }
            if !moq.bytes_contain(plain_obj.payload, marker) {
                fail("M10: decrypted object did not recover plaintext marker")
            }
            let tail_at = list.len(marker)
            let expected_g: u8 = int.truncate(plain_obj.group)
            let expected_o: u8 = int.truncate(plain_obj.id)
            if plain_obj.payload[tail_at] != expected_g || plain_obj.payload[tail_at + 1] != expected_o {
                fail("M10: decrypted payload suffix did not match object location")
            }
            live_decrypted += 1
        }
    }
    if live_decrypted != total_sent || !tampered_checked {
        fail("M10: authorized live subscriber did not decrypt every published object")
    }
    // Subscriber without the key cannot open any object.
    let mut nokey_seen = 0u64
    for ev in rig.peers[sub_nokey].events {
        if let Received(o) = ev {
            match moq.open_object_bound(mut recv_empty, o) {
                Error(NoKey(k)) => {
                    if k != kid {
                        fail("M10: NoKey reported wrong KID")
                    }
                    nokey_seen += 1
                },
                _ => fail("M10: unauthorized subscriber without key opened or misclassified object"),
            }
        }
    }
    if nokey_seen != total_sent {
        fail("M10: keyless subscriber did not receive ciphertext objects to test refusal")
    }
    // Late-joining subscriber FETCHes from the relay cache and decrypts every cached object.
    let sub_fetch = rig_add_peer(mut rig, 5005, Subscriber, clone(sc), lim, 120)
    let _ = peer_fetch(mut rig.peers[sub_fetch], 130, clone(tr), codec.Location(group: 0, object: 0), codec.Location(group: 2, object: 10))
    rig_settle(mut rig, 140, true)
    let mut fetch_decrypted = 0u64
    for ev in rig.peers[sub_fetch].events {
        if let Received(o) = ev {
            let (take plain_obj, _) = result.unwrap(moq.open_object_bound(mut recv_fetch, o))
            if !moq.bytes_contain(plain_obj.payload, marker) {
                fail("M10: FETCH-decrypted object did not recover plaintext marker")
            }
            fetch_decrypted += 1
        }
    }
    if fetch_decrypted != total_sent {
        fail("M10: FETCH subscriber did not decrypt all cached objects")
    }
    // Final scan of all relay memory after live fan-out and cache-backed FETCH.
    if moq.relay_contains_bytes(rig.r, marker) {
        fail("M10: relay memory holds plaintext marker after FETCH")
    }
    Ok(())
}

fn bytes_eq_shared(a: Shared[Bytes], b: Bytes) -> bool {
    if list.len(a) != list.len(b) {
        return false
    }
    for i in 0u64 .. list.len(b) {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

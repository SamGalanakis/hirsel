; FORM v0 sample, family: comparison and conversion (Compare, Convert, Branch, Switch).
;
; Source (package samples@0, module convert):
;   i0  fn to_u8(x: i64) -> u8 { match int.try_narrow(x) { Some(v) => v, None => 255 } }
;   i1  fn sign(x: f64) -> i32 { if x < 0.0 { -1 } else if x > 0.0 { 1 } else { 0 } }
;   i2  fn bits(x: f32) -> u32 { f32.bits(x) }
;   i3  fn to_i32(x: f64) -> i32 { match float.to_i32(x) { Ok(v) => v, Err(_) => -1 } }
;   i4  fn widen(x: i16) -> i64 { int.widen(x) }
;   i5  fn approx(x: u64) -> f32 { float.from_int(x) }
;
; Behaviour, derived by hand:
; run: f0(7) -> 7
; run: f0(255) -> 255
; run: f0(256) -> 255                ; not representable: None
; run: f0(-1) -> 255
; run: f1(-2.5) -> -1
; run: f1(3) -> 1
; run: f1(-0) -> 0                   ; -0 < 0 and -0 > 0 are both false (IEEE)
; run: f1(nan) -> 0                  ; an unordered pair: every op but ne is false
; run: f2(1) -> 1065353216           ; 0x3f800000
; run: f2(-0) -> 2147483648          ; only the sign bit
; run: f2(0x7fc00001) -> 2143289344  ; a NaN reads as the one observable NaN 0x7fc00000 (SEM-2)
; run: f2(0xffc00000) -> 2143289344  ; ... whatever its sign
; run: f3(2.9) -> 2                  ; truncation toward zero
; run: f3(-2.9) -> -2
; run: f3(2147483647) -> 2147483647  ; exactly representable in f64, fits
; run: f3(3e9) -> -1                 ; status 2, out of range
; run: f3(-inf) -> -1                ; status 2: an infinity is out of range
; run: f3(nan) -> -1                 ; status 1, NaN
; run: f4(-3) -> -3                  ; sign extension
; run: f4(32767) -> 32767
; run: f5(16777217) -> 16777216      ; 2^24+1 lies halfway; ties to even mantissa 2^24
; run: f5(16777219) -> 16777220      ; halfway between 2^24+2 and 2^24+4; 2^24+4 is even
core v0
item i0 = samples@0/convert/to_u8
item i1 = samples@0/convert/sign
item i2 = samples@0/convert/bits
item i3 = samples@0/convert/to_i32
item i4 = samples@0/convert/widen
item i5 = samples@0/convert/approx
sig g0 = (i64) -> (u8)
sig g1 = (f64) -> (i32)
sig g2 = (f32) -> (u32)
sig g3 = (i16) -> (i64)
sig g4 = (u64) -> (f32)
inst n0 = samples@0/convert/to_u8 [] []
inst n1 = samples@0/convert/sign [] []
inst n2 = samples@0/convert/bits [] []
inst n3 = samples@0/convert/to_i32 [] []
inst n4 = samples@0/convert/widen [] []
inst n5 = samples@0/convert/approx [] []
fn f0 = n0 g0 {
b0(v0: i64):
  v1: u8, v2: bool = try_narrow v0     ; v1 is meaningful only when v2
  branch v2, b2(v1), b1
b1:
  v3: u8 = const 255
  jump b2(v3)
b2(v4: u8):                            ; the match's join: a block parameter
  return v4
}
fn f1 = n1 g1 {
b0(v0: f64):
  v1: f64 = const 0x0                  ; floats are written by their bits
  v2: bool = lt v0, v1
  branch v2, b1, b2
b1:
  v3: i32 = const -1
  return v3
b2:
  v4: bool = gt v0, v1
  branch v4, b3, b4
b3:
  v5: i32 = const 1
  return v5
b4:
  v6: i32 = const 0
  return v6
}
fn f2 = n2 g2 {
b0(v0: f32):
  v1: u32 = reinterpret v0
  return v1
}
fn f3 = n3 g1 {
b0(v0: f64):
  v1: i32, v2: u8 = float_to_int v0    ; result, then status 0 ok, 1 NaN, 2 out of range
  switch v2 [0 -> b1] else b2
b1:
  return v1
b2:
  v3: i32 = const -1
  return v3
}
fn f4 = n4 g3 {
b0(v0: i16):
  v1: i64 = widen v0
  return v1
}
fn f5 = n5 g4 {
b0(v0: u64):
  v1: f32 = int_to_float v0
  return v1
}

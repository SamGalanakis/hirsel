// Every comparator failure must refund both scratch and the original list.
fn fail_at(failure: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 5 {
        list.push(mut xs, (i * 3) % 5)
    }
    let mut calls: u64 = 0
    list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a < b {
            Less
        } else {
            Greater
        }
    })
    calls
}

// expect: run balance_fail_1() = fail Unwrap
fn balance_fail_1() -> u64 {
    fail_at(1)
}

// expect: run balance_fail_2() = fail Unwrap
fn balance_fail_2() -> u64 {
    fail_at(2)
}

// expect: run balance_fail_3() = fail Unwrap
fn balance_fail_3() -> u64 {
    fail_at(3)
}

// expect: run balance_fail_4() = fail Unwrap
fn balance_fail_4() -> u64 {
    fail_at(4)
}

// expect: run balance_fail_5() = fail Unwrap
fn balance_fail_5() -> u64 {
    fail_at(5)
}

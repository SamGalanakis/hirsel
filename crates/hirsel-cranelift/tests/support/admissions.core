; Guarded prepare/commit for two owners, with allocations under both grants.
; Root refusal returns Capacity and cleans the prepared prefix.
; Finalizer refusal keeps its cause cell and cleans the remaining owner.
core v1
type t0 = resource "Owner" drop f1 grant 8 { id: u64 }
sig g0 = (u64) -> (bool, u64)
sig g1 = (ptr) -> ()
inst n0 = test@0/admissions/run [] []
inst n1 = test@0/admissions/finalize [] []
fn f0 = n0 g0 {
  slot s0 = t0
  slot s1 = t0
  addr a0 = s0 : ptr
  addr a1 = s0 : t0
  addr a2 = s1 : ptr
  addr a3 = s1 : t0
  addr a4 = v3 : t0
  addr a5 = a4 field 0 : u64
  addr a6 = v6 : t0
  addr a7 = a6 field 0 : u64
b0(v0: u64):
  live s0
  live s1
  address a0
  address a1
  address a2
  address a3
  v1: u64 = const 48
  v2: u64 = const 8
  v3: ptr, v4: u64 = alloc resource grant 8 v2 align 8 charge v1
  v5: ptr = const 0x0
  v10: bool = ne v3, v5
  branch v10, b1, b4
b1:
  store a0, v3
  address a4
  address a5
  store a5, v0
  v6: ptr, v7: u64 = alloc resource grant 8 v2 align 8 charge v1
  v8: bool = ne v6, v5
  branch v8, b2, b3
b2:
  store a2, v6
  address a6
  address a7
  v9: u64 = const 2
  store a7, v9
  drop a3 t0 fail b6
  drop a1 t0 fail b5
  return v8, v7
b3:
  drop a1 t0 fail b5
  return v8, v7
b4:
  return v10, v4
b5:
  propagate
b6:
  drop a1 t0 fail b5
  propagate
}
fn f1 = n1 g1 {
  addr a0 = v0 : t0
  addr a1 = a0 field 0 : u64
b0(v0: ptr):
  address a0
  address a1
  v1: u64 = read a1
  v2: u64 = const 0
  v3: bool = eq v1, v2
  branch v3, b1, b2
b1:
  raise bounds
b2:
  v4: u64 = const 8
  v5: ptr, v6: u64 = alloc own v4 align 8 charge v4
  free v5 charge v4
  return
}

// Scale fleet simulation laws at 50 and 1,000 simulated hosts (docs/spec/fleet.md FLT-8).
// Exercises fleet@1 move_kernel, K10 advisory lattice, and partitioned Directory[u64] Places
// under message hold, clock pause, controller kill mid-move, and zone isolation, checking
// kernel invariants, Directory[K] invariants, and SM1 NDJSON/ITF traces at seed end.
/// bug: Violate move_kernel safety, Directory[K] lease exclusivity/quarantine/drift bounds, or SM1 trace integrity at 50 simulated hosts under combined faults.
/// oracle: docs/spec/fleet.md FLT-2..FLT-8 end-of-seed invariants and SM1 NDJSON/ITF traces at 50 hosts.
@test
fn sim_fleet_scale_50_hosts(tasks: Tasks) -> Result[(), ()] waits {
    let cfg = scale_sim.default_config(50u64, 3056050u64)
    let rep = result.unwrap(scale_sim.run_scale_sim(cfg, tasks))
    if rep.hosts != 50 || rep.moves_completed == 0 || rep.stale_races_blocked == 0 || rep.controller_kills == 0 || rep.freeze_blocks == 0 || rep.dir_quarantine_refusals == 0 || rep.dir_drift_refusals == 0 || rep.sm1_rows == 0 {
        fail("50-host fleet sim did not exercise all fault classes and SM1 trace checks")
    }
    Ok(())
}

/// bug: Violate move_kernel safety, Directory[K] lease exclusivity/quarantine/drift bounds, or SM1 trace integrity at 1,000 simulated hosts under combined faults.
/// oracle: docs/spec/fleet.md FLT-2..FLT-8 end-of-seed invariants and SM1 NDJSON/ITF traces at 1,000 hosts.
@test
fn sim_fleet_scale_1000_hosts(tasks: Tasks) -> Result[(), ()] waits {
    let cfg = scale_sim.default_config(1000u64, 30561000u64)
    let rep = result.unwrap(scale_sim.run_scale_sim(cfg, tasks))
    if rep.hosts != 1000 || rep.moves_completed == 0 || rep.stale_races_blocked == 0 || rep.controller_kills == 0 || rep.freeze_blocks == 0 || rep.dir_quarantine_refusals == 0 || rep.dir_drift_refusals == 0 || rep.sm1_rows == 0 {
        fail("1,000-host fleet sim did not exercise all fault classes and SM1 trace checks")
    }
    Ok(())
}

/// bug: Loss of worker-funded capacity, unsafe credit reuse across a withdrawal or restart, or a placement cost beyond the qualified envelope.
/// oracle: Summit verdict items 3, 4 and 13. Exact burst bound and Erlang-B with four slots at two Erlangs.
@test
fn sim_fleet_credit_desk_gate() -> Result[(), ()] {
    let gate = scale_sim.run_placement(scale_sim.default_config(1000u64, 3087u64))
    for scenario in gate.cases {
        let trial = scenario.desk
        if trial.false_overload * 1000 > trial.offered {
            fail("false Overloaded exceeded one per thousand offered creates")
        }
        if trial.started_by_deadline < trial.burst_bound {
            fail("the desk missed the exact burst lower bound")
        }
        if scenario.name == "erlang_calibration_50" {
            // B(4, 2) = 2/21. Allow one percentage point of sampling error.
            if trial.erlang_ppb != 95238095 || trial.overload * 1000 < 85 * trial.offered || trial.overload * 1000 > 106 * trial.offered {
                fail("four-slot placement diverged from Erlang-B")
            }
        }
        if scenario.name == "sparse_200us" && trial.p50_us != 300 {
            fail("a sparse create on the modeled RTT boundary took more than the two expected legs")
        }
    }
    let recovery = gate.desk_recovery
    if recovery.reoffered_us == 0 || recovery.reoffered_us > 6150 || recovery.bound_us != 6150 {
        fail("the desk failed to reoffer the stranded slot within the heal bound")
    }
    if recovery.double_redemptions != 0 || recovery.replay_attempts != 6 {
        fail("the desk did not reject all held and duplicate credits")
    }
    Ok(())
}

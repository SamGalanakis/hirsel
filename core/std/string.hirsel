// Module `string`, extended (LANG-7): library members of the core module `string` (SEM-3).
// The core members (new, from, from_utf8, into_bytes, as_bytes, slice, next_scalar,
// byte_len, push, push_char, push_u64, make_ascii_upper, make_ascii_lower) are declared in core/core/string.hirsel. Field
// legend, GROWTH and FREEZE: API.md, "Reading a contract".
//
// Representation: String is an opaque own type over a Bytes block: a 24-byte header
// inline, storage capacity x 1 byte rounded up to 8, charged to the limit where it was
// made (MEM-26); GROWTH as for lists. A literal is static, has capacity 0 and is never
// charged; its first growth copies it. Positions are byte offsets. Equality, order and
// hashing are bytewise (`==`, `<`); nothing normalises. A copy is `string.from` (or
// `clone`); there is no `string.copy`.
//
// Cutting: the functions below that return a `View[String] in s` are library code over
// `string.slice`, returning the sub-view the call gave for s (OWN-20); they allocate
// nothing and FREEZE s for the result's extent. Scalars are read with `next_scalar` in a
// `while let` loop; `for` iterates only built-in sources (SEM-6).
/// An empty string with storage for n bytes: `string.from_utf8` of `list.with_capacity(n)`.
/// Fails: Error(c). Alloc: n rounded to 8, current limit. Cost: O(1).
/// Ex: `let mut reply = string.with_capacity(256)?`
pub fn with_capacity(n: u64) -> Result[String, Capacity] {
    let b: Bytes = list.with_capacity(n)?
    match string.from_utf8(take b) {
        Ok(take s) => Ok(take s),
        Error(_) => fail("string.with_capacity: empty bytes are UTF-8"),
    }
}

/// Whether i is a scalar boundary: i == byte_len, or i < byte_len and byte i is not a
/// continuation byte. Cost: O(1). Ex: `if !string.is_boundary(text, at) { return Error(BadPosition) }`
pub fn is_boundary(s: String, i: u64) -> bool {
    let n = string.byte_len(s)
    if i >= n {
        return i == n
    }
    let b = string.as_bytes(s)
    b[i] & 0xc0 != 0x80
}

/// Appends n in decimal, with '-' when negative. Fails: Error(c); s then holds a prefix
/// of the text (core has no `string.reserve` to make the append atomic).
/// Alloc: GROWTH, at most twice. Ex: `string.push_i64(mut s, -3)?`
pub fn push_i64(mut s: String, n: i64) -> Result[(), Capacity] {
    // The magnitude in u64: two's complement negation of the same bits, exact for MIN.
    let bits: u64 = int.truncate(n)
    if n < 0 {
        string.push_char(mut s, '-')?
        string.push_u64(mut s, int.wrapping_neg(bits))
    } else {
        string.push_u64(mut s, bits)
    }
}

/// Appends n in `base` (2 to 36, lower-case), left-padded with `pad` to at least `width`
/// scalars (Go strconv.AppendUint plus padding). Fails: Fail when base is outside
/// 2..=36; Error(c) when a growth is refused, s then holding a prefix of the text (no
/// `string.reserve`). Alloc: GROWTH per push_char. Cost: O(digits + width). Ex: `string.push_uint(mut out, 31, 16, 4, '0')?` appends "001f"
pub fn push_uint(mut s: String, n: u64, base: u32, width: u64, pad: char) -> Result[(), Capacity] {
    if base < 2 || base > 36 {
        fail("string.push_uint: base outside 2..=36")
    }
    let radix: u64 = int.widen(base)
    // Digits least significant first; 64 is enough for base 2.
    let mut digits: Inline[u8, 64] =[0; 64]
    let mut count: u64 = 0
    let mut v = n
    loop {
        let d: u8 = int.narrow(v % radix)
        digits[count] = if d < 10 {
            b'0' + d
        } else {
            b'a' + (d - 10)
        }
        count += 1
        v = v / radix
        if v == 0 {
            break
        }
    }
    let mut padded = count
    while padded < width {
        string.push_char(mut s, pad)?
        padded += 1
    }
    while count > 0 {
        count -= 1
        let code: u32 = int.widen(digits[count])
        string.push_char(mut s, option.unwrap(char.from_u32(code)))?
    }
    Ok(())
}

/// s written n times into a new string of exactly byte_len(s) * n bytes (Rust str::repeat).
/// Fails: Error(c) when that storage is refused; Fail when byte_len(s) * n overflows u64.
/// Alloc: byte_len(s) * n rounded to 8, current limit. Cost: O(byte_len(s) * n).
/// Ex: `let rule = string.repeat("-", 40)?`
pub fn repeat(s: String, n: u64) -> Result[String, Capacity] {
    let total = match int.checked_mul(string.byte_len(s), n) {
        Some(t) => t,
        None => fail("string.repeat: length overflows u64"),
    }
    let mut out = with_capacity(total)?
    let mut k: u64 = 0
    while k < n {
        string.push(mut out, s)?
        k += 1
    }
    Ok(take out)
}

/// Empties s; keeps an owned s's storage, and a static s (a literal) becomes the empty
/// static string, so clearing admits nothing (core truncate to 0). Alloc: nothing. Cost: O(1).
/// Ex: `string.clear(mut line)`
pub fn clear(mut s: String) {
    string.truncate(mut s, 0)
}

/// The first byte position at or after `start` where pat occurs, or None. An empty pat is
/// found at `start`. Fails: Bounds (failure) when start > byte_len (`list.slice`).
/// Alloc: nothing.
/// Cost: O(len x len(pat)) worst case (naive search, as Go for short patterns).
/// Ex: `let Some(colon) = string.find(line, 0, ":") else { return Error(Malformed) }`
pub fn find(s: String, start: u64, pat: String) -> Option[u64] {
    let n = string.byte_len(s)
    let hay = list.slice(string.as_bytes(s), start, n)
    let needle = string.as_bytes(pat)
    let m = list.len(needle)
    let rest = list.len(hay)
    if m > rest {
        return None
    }
    if m == 0 {
        return Some(start)
    }
    // Scan for the first byte alone; compare the rest only at a candidate.
    let first = needle[0]
    let one: u64 = int.widen(first)
    let spread = one * 0x0101010101010101
    let last = rest - m
    let mut i: u64 = 0
    while i <= last {
        // Two words at a time while neither holds the first byte. A word w holds it where
        // w ^ spread has a zero byte; (v - 0x01..) & ~v & 0x80.. marks the lowest zero byte
        // of v exactly (a borrow can mark only bytes above it).
        while i + 16 <= rest {
            let v0 = list.word_le(hay, i) ^ spread
            let v1 = list.word_le(hay, i + 8) ^ spread
            let z0 = int.wrapping_sub(v0, 0x0101010101010101) & ~v0 & 0x8080808080808080
            let z1 = int.wrapping_sub(v1, 0x0101010101010101) & ~v1 & 0x8080808080808080
            if z0 | z1 != 0 {
                // Bit 8j + 7 marks byte j of its word.
                let low: u64 = int.widen(int.trailing_zeros(z0))
                let high: u64 = int.widen(int.trailing_zeros(z1))
                if z0 != 0 {
                    i += low >> 3
                } else {
                    i += 8 + (high >> 3)
                }
                break
            }
            i += 16
        }
        // At a candidate, or within 16 bytes of the end: byte steps to the next candidate.
        while i <= last && hay[i] != first {
            i += 1
        }
        if i > last {
            return None
        }
        let mut k: u64 = 1
        while k < m && hay[i + k] == needle[k] {
            k += 1
        }
        if k == m {
            return Some(start + i)
        }
        i += 1
    }
    None
}

/// Whether s begins with p. Cost: O(len(p)). Ex: `string.starts_with(line, "GET ")`
pub fn starts_with(s: String, p: String) -> bool {
    let m = string.byte_len(p)
    m <= string.byte_len(s) && list.slice(string.as_bytes(s), 0, m) == string.as_bytes(p)
}

/// Whether s ends with p. Cost: O(len(p)). Ex: `string.ends_with(name, ".json")`
pub fn ends_with(s: String, p: String) -> bool {
    let n = string.byte_len(s)
    let m = string.byte_len(p)
    m <= n && list.slice(string.as_bytes(s), n - m, n) == string.as_bytes(p)
}

/// The parts of s before and after the first occurrence of sep, or None when sep does not
/// occur (Rust str::split_once). An empty sep splits at 0. View: both anchored to s;
/// FREEZE s. Alloc: nothing. Cost: as find.
/// Ex: `let Some((key, value)) = string.split_once(line, ": ") else { return Error(NoColon) }`
pub fn split_once(s: String, sep: String) -> Option[(View[String], View[String])] in s {
    // A match of valid UTF-8 in valid UTF-8 starts and ends on scalar boundaries, so
    // neither slice can fail.
    let Some(at) = find(s, 0, sep) else {
        return None
    }
    let n = string.byte_len(s)
    Some((string.slice(s, 0, at), string.slice(s, at + string.byte_len(sep), n)))
}

/// The piece of s from at up to the next sep, and the cursor after that sep: the pieces of
/// Rust str::split(sep), one per call, starting from 0. A piece that runs to the end returns
/// cursor byte_len(s) + 1, after which the result is None, so a trailing sep yields a final
/// empty piece and "" yields one empty piece, as in Rust. Fails: Bounds when at exceeds
/// byte_len(s) + 1 or falls inside a scalar; Fail when sep is empty. View: anchored to s;
/// FREEZE s. Alloc: nothing. Cost: as find from at.
/// Ex: `while let Some((field, next)) = string.next_split(row, at, ",") { ...; at = next }`
pub fn next_split(s: String, at: u64, sep: String) -> Option[(View[String], u64)] in s {
    let n = string.byte_len(s)
    if at == n + 1 {
        return None
    }
    let m = string.byte_len(sep)
    if m == 0 {
        fail("string.next_split: the separator is empty")
    }
    match find(s, at, sep) {
        Some(i) => Some((string.slice(s, at, i), i + m)),
        None => Some((string.slice(s, at, n), n + 1)),
    }
}

/// The line of s from at, without its line ending, and the cursor after that ending: the
/// lines of Rust str::lines, one per call, starting from 0. A line ends at "\n" or "\r\n"; the
/// last line's ending is optional, so a final "\n" yields no empty line, and a lone "\r" stays
/// in its line. None when at is byte_len(s). Fails: Bounds when at exceeds byte_len(s) or
/// falls inside a scalar. View: anchored to s; FREEZE s. Alloc: nothing. Cost: as find from at.
/// Ex: `while let Some((line, next)) = string.next_line(text, at) { ...; at = next }`
pub fn next_line(s: String, at: u64) -> Option[(View[String], u64)] in s {
    let n = string.byte_len(s)
    if at == n {
        return None
    }
    let Some(i) = find(s, at, "\n") else {
        return Some((string.slice(s, at, n), n))
    }
    // A "\r" just before the "\n" belongs to the line ending.
    let b = string.as_bytes(s)
    if i > at && b[i - 1] == 0x0D {
        return Some((string.slice(s, at, i - 1), i + 1))
    }
    Some((string.slice(s, at, i), i + 1))
}

/// s without its leading p, or None when s does not begin with p (Rust strip_prefix).
/// View: anchored to s; FREEZE s. Alloc: nothing. Cost: O(len(p)).
/// Ex: `let Some(route) = string.strip_prefix(line, "GET ") else { return Error(NotGet) }`
pub fn strip_prefix(s: String, p: String) -> Option[View[String]] in s {
    if starts_with(s, p) {
        Some(string.slice(s, string.byte_len(p), string.byte_len(s)))
    } else {
        None
    }
}

/// s without its trailing p, or None when s does not end with p (Rust strip_suffix).
/// View: anchored to s; FREEZE s. Alloc: nothing. Cost: O(len(p)).
/// Ex: `let stem = match string.strip_suffix(name, ".json") { Some(t) => t, None => name }`
pub fn strip_suffix(s: String, p: String) -> Option[View[String]] in s {
    if ends_with(s, p) {
        Some(string.slice(s, 0, string.byte_len(s) - string.byte_len(p)))
    } else {
        None
    }
}

/// s without leading and trailing ASCII whitespace (space, \t, \n, \r, form feed), as
/// Rust trim_ascii; no other scalar is whitespace here. View: anchored to s; FREEZE s.
/// Alloc: nothing. Cost: O(whitespace trimmed). Ex: `let v = string.trim_ascii(value)`
pub fn trim_ascii(s: String) -> View[String] in s {
    let b = string.as_bytes(s)
    let mut lo: u64 = 0
    let mut hi = list.len(b)
    while lo < hi && is_ascii_space(b[lo]) {
        lo += 1
    }
    while hi > lo && is_ascii_space(b[hi - 1]) {
        hi -= 1
    }
    string.slice(s, lo, hi)
}

fn is_ascii_space(x: u8) -> bool {
    x == b' ' || x == b'\t' || x == b'\n' || x == b'\r' || x == 0x0c
}

fn image() -> Bytes {
    let mut b: Bytes = list.with_capacity(4120)
    list.fill(mut b, 11, 77u8)
    for i in 0u64 .. 4096 {
        list.push(mut b, int.truncate(i * 17 + 3))
    }
    for _ in 0u64 .. 13 {
        list.push(mut b, 99u8)
    }
    b
}

// Wrong implementation: wrong short-path constant, last stripe, block scramble, or range.
// expect: run reference_lengths() = true
fn reference_lengths() -> bool {
    let b = image()
    for i in 0u64 .. 265 {
        if check.xxh3(b, 11, 11 + LENGTHS[i]) != HASHES[i] {
            return false
        }
    }
    check.xxh3(string.as_bytes(""), 0, 0) == 0x2d06800538d394c2u64
}

// Wrong implementation: reset between chunks, duplicate a pending stripe, omit overlap.
// expect: run streaming_splits() = true
fn streaming_splits() -> bool {
    let b = image()
    for cut in 0u64 .. 258 {
        let mut s = check.start()
        check.add(mut s, b, 11, 11 + cut)
        check.add(mut s, b, 11 + cut, 268)
        if check.finish(s) != HASHES[257] {
            return false
        }
    }
    let mut s = check.start()
    for i in 0u64 .. 4096 {
        check.add(mut s, b, 11 + i, 12 + i)
    }
    check.finish(s) == HASHES[264]
}

// xxHash v0.8.2 tests/sanity_test_vectors.h, XSUM_XXH3_testdata, seed zero.
// The byte generator is fillTestBuffer in tests/sanity_test.c.
// expect: run published_vectors() = true
fn published_vectors() -> bool {
    let mut b: Bytes = list.with_capacity(4096)
    let mut state: u64 = 2654435761
    for _ in 0u64 .. 4096 {
        list.push(mut b, int.truncate(state >> 56))
        state = int.wrapping_mul(state, 11400714785074694797)
    }
    let vectors: Inline[(u64, u64), 7] =[(0, 0x2d06800538d394c2), (192, 0xaf9f58e78b8d3587), (240, 0x81c3c2b67f568ccf), (241, 0xc5a639ecd2030e5e), (1024, 0xdd85c9b5c1109c5c), (1025, 0xd870c0fa13211c6a), (4096, 0xe91206429d1f48f9)]
    for (size, expected) in vectors {
        if check.xxh3(b, 0, size) != expected {
            return false
        }
    }
    true
}

// Splits immediately before, at and after the stripe, short-buffer and block
// boundaries must not drop or duplicate a stripe. HASHES is the libxxhash oracle.
// expect: run streaming_block_boundaries() = true
fn streaming_block_boundaries() -> bool {
    let b = image()
    let cuts: Inline[u64, 21] =[0, 63, 64, 65, 239, 240, 241, 255, 256, 257, 511, 512, 513, 1023, 1024, 1025, 2047, 2048, 2049, 4095, 4096]
    for cut in cuts {
        let mut s = check.start()
        check.add(mut s, b, 11, 11 + cut)
        check.add(mut s, b, 11 + cut, 4107)
        if check.finish(s) != HASHES[264] {
            return false
        }
    }
    true
}

// Every lane gets its neighboring word plus the product of the low and high
// halves of its keyed word. Here both stripes repeat 01 and the key is zero.
// expect: run stripes_step_bound() = true
fn stripes_step_bound() -> bool {
    let mut b: Bytes = list.new()
    list.fill(mut b, 128, 1)
    let key: Inline[u8, 192] =[0; 192]
    let work = bound steps 1 {
        let mut acc: Inline[u64, 8] =[0; 8]
        check.xxh3_stripes(mut acc, b, key, 0)
        acc[0] == 0x020406080a080604 && acc[7] == 0x020406080a080604
    }
    let denied = bound steps 0 {
        let mut acc: Inline[u64, 8] =[0; 8]
        check.xxh3_stripes(mut acc, b, key, 0)
        acc[0]
    }
    match (work, denied) {
        (Ok(true), Error(out)) => out.steps == 0,
        _ => false,
    }
}

// The first key window fits exactly, but the second would overrun by 8 bytes.
// expect: run stripe_secret_bounds() = fail Bounds
fn stripe_secret_bounds() -> u64 {
    let mut b: Bytes = list.new()
    list.fill(mut b, 128, 1)
    let key: Inline[u8, 192] =[0; 192]
    let mut acc: Inline[u64, 8] =[0; 8]
    check.xxh3_stripes(mut acc, b, key, 128)
    acc[0]
}

// rule: STORE-12
// expect: run
// runners: [{"name":"ledger","provider":"sim@1","node":"bank","models":"db@1","head":"application@1/head","grants":{"dirs":[],"authorities":{"place":{"provider":"authority.memory@1","floor":"memory"}}},"definitions":null}]
// tasks: free
// A call stream belongs to the caller that first used it, and a recorded end
// reaches only that caller. The head takes the caller's first request itself,
// ends it NotRun(Rejected()), which leaves its position to the caller's next
// request, and records that request on the stream as a local call (caller "").
// The caller then sends the same call again, the same position with the same
// digest: the stream is another caller's, so it is Denied, not answered with
// the end the local call recorded. The deposit applied once, by the local call.
fn deposit(mut tx: store.Tx, info: store.CallInfo, amount: u64) -> Result[
  u64,
  store.TxError
] {
  let n = match store.tx_get(tx, b"balance")? {
    Some(b) => int.widen(b[0]) + amount,
    None() => amount,
  }
  store.tx_put(mut tx, b"balance", bytes.from_list([int.truncate(n)]))?
  Ok(n)
}

fn balance(tx: store.Tx, info: store.CallInfo, a: ()) -> Result[u64, store.TxError] {
  match store.tx_get(tx, b"balance")? {
    Some(b) => Ok(int.widen(b[0])),
    None() => Ok(0),
  }
}

pub fn head(rt: Io, a: ()) -> Result[(), store.StoreError] {
  let Ok(place) = io.authority(rt, "place") else {
    return Error(Corrupt("place"))
  }
  let Ok(inbox) = io.inbox(rt) else {
    return Error(Corrupt("inbox"))
  }
  let mut s = store.open(place, store.default_config())?
  let mut held = take inbox
  let Some(first) = inbox.take(mut held, true) else {
    return Error(Corrupt("no first arrival"))
  }
  for arrival in take first {
    let arrived = arrival.request(arrival)
    arrival.end(take arrival, NotRun(Rejected()))
    let direct = store.call(mut s, arrived.request, deposit, 5u64)
    if direct != Ok(5u64) {
      return Error(Corrupt("local call"))
    }
  }
  store.serve(
    mut s,
    take held,
    [store.served_transact(deposit), store.served_query(balance)]
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let ledger = io.runner(rt, "ledger")?
  failure.check(
    runner.transact(ledger, deposit, 5u64) == Error(NotRun(Rejected())),
    Arithmetic()
  )
  failure.check(
    runner.transact(ledger, deposit, 5u64) == Error(NotRun(Denied())),
    Arithmetic()
  )
  failure.check(runner.query(ledger, balance, ()) == Ok(5u64), Arithmetic())
  Ok(())
}

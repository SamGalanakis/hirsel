fn forge(take client: std.object.Client, take register: store.history.HistoryRegister, take buffers: store.history.HistoryBuffers) -> store.host_stream.SettleView {
    store.host_stream.SettleView(client: take client, register: take register, authority: list.new(), buffers: take buffers, op_ms: 1, slot: None, root: string.new(), last_acked: 0, known_batches: list.new(), cursor_seq: 0, cursor_frame: 0)
}

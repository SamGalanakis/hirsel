fn tail_demoted_check(db: Db, fixture: ProjectorFixture, image: Image) -> Result[(), Error] waits {
    let s = snapshot(db)
    if pages.tiered_collections(s.roots.collections.root) || tail_image(db, fixture)? != image {
        fail("demoted tail: the Memory head and its published image must both survive")
    }
    let Some(bases) = view s.bases else {
        fail("demoted tail: the published image has no retained pin")
    }
    let slot = option.unwrap(pages.tail_base(bases, fixture.decl.name, image.slot, image.position, s.branch))
    let key = failure_result_from_rep(catalog.prefix(fixture.source_table.id))?
    let Some((ColdPage(_), _)) = std.page.collection_slot(bases[slot].roots.collections.root, key) else {
        fail("demoted tail: the pin must still hold a Cold source")
    }
    let r = reader(db, VALUE_LIMIT + 1048576)?
    let input: (ProjectionDecl, Table[u64, u64]) = (clone(fixture.decl), clone(fixture.source_table))
    let Seen(Seen(value: (Error(Tiered(Tail)), Ok(Some(20u64))), ..)) = look(r, s, None, input, fn(tx, handles) -> (Result[Option[TailRows], Error], Result[Option[u64], Error]) {
        (tail_pages(tx, handles), fetch(tx, handles.1, 1u64))
    })? else {
        fail("demoted tail: the Cold pin must refuse and the Memory row must read")
    }
    Ok(())
}

/// bug: admitting a Cold pin read without a Tx attempt breaks the retry contract on a Memory head.
/// oracle: a Tiered refusal, the same published image, and the committed value 20 before and after reopen.
@test
fn test_tail_demoted_source(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = l70_open_options(300000000)?
    let mut db = open(tasks, directory, c, r, options)?
    let fixture = projector_fixture(mut db, Migrate, Own, cadence())?
    let source = view fixture.source_table
    bounded_put(mut db, source, 1, 10)?
    set_residency(mut db, source.id, Tiered)?
    project_until_idle(mut db, Limits(rows: 64, byte_limit: 65536))?
    let image = tail_image(db, fixture)?
    bounded_put(mut db, source, 1, 20)?
    set_residency(mut db, source.id, Memory)?
    tail_demoted_check(db, fixture, image)?
    close(take db)?
    let mut reopened = open(tasks, directory, c, r, options)?
    let rebound = projector_fixture(mut reopened, Open, Own, cadence())?
    tail_demoted_check(reopened, rebound, image)?
    close(take reopened)
}

fn tail_pin_page(db: Db, fixture: ProjectorFixture, image: Image) -> Result[std.page.PagePtr, Error] {
    let name = pages.projector_pin_name(fixture.decl.name, image.slot)
    let slot = pin_index(db, ProjectorPin, name)
    let key = failure_result_from_rep(catalog.prefix(fixture.source_table.id))?
    let Some((ColdPage(ptr), _)) = std.page.collection_slot(pages.holder_pins(db.holders)[slot].roots.collections.root, key) else {
        fail("Tiered tail: the published pin must hold a Cold source")
    }
    Ok(ptr)
}

fn checkpoint_tail_pin(mut db: Db, fixture: ProjectorFixture, image: Image) -> Result[(), Error] waits {
    let original = tail_pin_page(db, fixture, image)?
    let _ = checkpoint(mut db)?
    let moved = tail_pin_page(db, fixture, image)?
    if original.pack == moved.pack || original.stamp != moved.stamp || compact_listed(db, original.pack) {
        fail("Tiered tail: the cut must relocate the image root and retire the old pack")
    }
    Ok(())
}

/// bug: read_tail refuses a Tiered source, misses staged changes or keeps a retired pin location after a cut.
/// oracle: the paged model-map differences in L-TAIL, after two publications and a guarded relocation cut.
@test
fn test_tail_tiered(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut options = l70_open_options(300000000)?
    options.compact_permille = 1001
    options.probe_budget = 65536
    let mut db = open(tasks, disk_test_directory(d), c, r, options)?
    let fixture = projector_fixture(mut db, Migrate, Own, cadence())?
    set_residency(mut db, fixture.source_table.id, Tiered)?
    law_tail(mut db, fixture, true)?
    close(take db)
}

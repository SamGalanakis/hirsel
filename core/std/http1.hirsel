// ADAPTED from httparse a0fa552e src/lib.rs: request/status line, strict
// header tokens, opaque field values, optional whitespace, CRLF or LF.
// Offsets replace borrowed slices. No body parsing and no I/O.
pub type Span: key {
    start: u64,
    end: u64
}

pub type Header {
    name: Span,
    value: Span
}

pub type Head {
    method: Span,
    target: Span,
    version: u8,
    status: u16,
    reason: Span,
    fields: Inline[Header, 64],
    count: u64,
    end: u64
}

pub type Progress: key = Partial | Complete | Bad | TooLarge

type Stop = More | Malformed | Limit

/// Empty offset head; parsers reset it before each call. No allocation.
/// Ex: `let mut h = http1.head()`.
pub fn head() -> Head {
    let z = Span(start: 0, end: 0)
    Head(method: z, target: z, version: 0, status: 0, reason: z, fields:[Header(name: z, value: z); 64], count: 0, end: 0)
}

fn byte(b: Bytes, at: u64) -> Result[u8, Stop] {
    if at >= 8192 {
        return Error(Limit)
    }
    if at >= list.len(b) {
        return Error(More)
    }
    Ok(b[at])
}

fn newline(b: Bytes, mut at: u64) -> Result[(), Stop] {
    let c = byte(b, at)?
    at += 1
    if c == 13 {
        if byte(b, at)? != 10 {
            return Error(Malformed)
        }
        at += 1
    } else if c != 10 {
        return Error(Malformed)
    }
    Ok(())
}

fn token(c: u8) -> bool {
    int.is_ascii_alpha(c) || int.is_ascii_digit(c) || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

// httparse accepts non-ASCII URI bytes only when they form UTF-8. Validate
// each scalar as it arrives, without allocating a String for the target.
fn uri_scalar(b: Bytes, mut at: u64) -> Result[(), Stop] {
    let x = byte(b, at)?
    if x < 128 {
        if x < 33 || x == 127 {
            return Error(Malformed)
        }
        at += 1
        return Ok(())
    }
    let width: u64 = if x >= 0xc2 && x <= 0xdf {
        2
    } else if x >= 0xe0 && x <= 0xef {
        3
    } else if x >= 0xf0 && x <= 0xf4 {
        4
    } else {
        return Error(Malformed)
    }
    let y = byte(b, at + 1)?
    let low: u8 = if x == 0xe0 {
        0xa0
    } else if x == 0xf0 {
        0x90
    } else {
        0x80
    }
    let high: u8 = if x == 0xed {
        0x9f
    } else if x == 0xf4 {
        0x8f
    } else {
        0xbf
    }
    if y < low || y > high {
        return Error(Malformed)
    }
    for i in 2u64 .. width {
        if byte(b, at + i)? & 0xc0 != 0x80 {
            return Error(Malformed)
        }
    }
    at += width
    Ok(())
}

fn version(b: Bytes, mut at: u64) -> Result[u8, Stop] {
    let prefix = string.as_bytes("HTTP/1.")
    for i in 0u64 .. 7u64 {
        if byte(b, at)? != prefix[i] {
            return Error(Malformed)
        }
        at += 1
    }
    let c = byte(b, at)?
    if c != b'0' && c != b'1' {
        return Error(Malformed)
    }
    at += 1
    Ok(c - b'0')
}

fn headers(b: Bytes, mut at: u64, mut h: Head) -> Result[(), Stop] {
    loop {
        let c = byte(b, at)?
        if c == 13 || c == 10 {
            newline(b, mut at)?
            h.end = at
            return Ok(())
        }
        if h.count == 64 {
            return Error(Limit)
        }
        let ns = at
        while token(byte(b, at)?) {
            at += 1
        }
        if at == ns || byte(b, at)? != b':' {
            return Error(Malformed)
        }
        let ne = at
        at += 1
        while byte(b, at)? == b' ' || byte(b, at)? == 9 {
            at += 1
        }
        let vs = at
        let mut ve = at
        loop {
            let x = byte(b, at)?
            if x == 13 || x == 10 {
                break
            }
            if x < 32 && x != 9 || x == 127 {
                return Error(Malformed)
            }
            at += 1
            if x != b' ' && x != 9 {
                ve = at
            }
        }
        newline(b, mut at)?
        h.fields[h.count] = Header(name: Span(start: ns, end: ne), value: Span(start: vs, end: ve))
        h.count += 1
    }
}

fn parse(b: Bytes, mut h: Head, is_response: bool) -> Result[(), Stop] {
    let mut at: u64 = 0
    while byte(b, at)? == 13 || byte(b, at)? == 10 {
        newline(b, mut at)?
    }
    if is_response {
        h.version = version(b, mut at)?
        if byte(b, at)? != b' ' {
            return Error(Malformed)
        }
        at += 1
        let mut status: u16 = 0
        for i in 0u64 .. 3u64 {
            let c = byte(b, at)?
            if !int.is_ascii_digit(c) {
                return Error(Malformed)
            }
            let digit: u16 = int.widen(c - b'0')
            status = status * 10 + digit
            at += 1
        }
        h.status = status
        let c = byte(b, at)?
        if c == b' ' {
            at += 1
        } else if c != 13 && c != 10 {
            return Error(Malformed)
        }
        let start = at
        loop {
            let x = byte(b, at)?
            if x == 13 || x == 10 {
                break
            }
            if x < 32 && x != 9 || x == 127 {
                return Error(Malformed)
            }
            at += 1
        }
        h.reason = Span(start: start, end: at)
    } else {
        let start = at
        while token(byte(b, at)?) {
            at += 1
        }
        if at == start || byte(b, at)? != b' ' {
            return Error(Malformed)
        }
        h.method = Span(start: start, end: at)
        at += 1
        let target_start = at
        loop {
            let c = byte(b, at)?
            if c == b' ' {
                break
            }
            uri_scalar(b, mut at)?
        }
        if at == target_start {
            return Error(Malformed)
        }
        h.target = Span(start: target_start, end: at)
        at += 1
        h.version = version(b, mut at)?
    }
    newline(b, mut at)?
    headers(b, mut at, mut h)
}

fn progress(r: Result[(), Stop]) -> Progress {
    match r {
        Ok(_) => Complete,
        Error(More) => Partial,
        Error(Malformed) => Bad,
        Error(Limit) => TooLarge
    }
}

/// Parses one request head, capped at 8192 bytes and 64 fields. A complete
/// head sets h.end; any read-ahead remains in b[h.end..]. O(head), no allocation.
/// Partial keeps initialized fields. Ex: `http1.request(b, mut h)`.
pub fn request(b: Bytes, mut h: Head) -> Progress {
    h = head()
    progress(parse(b, mut h, false))
}

/// Bounded status-head parser for WebSocket's client 101 check. Same offsets,
/// limits and strict header rules as request. Ex: `http1.response(b, mut h)`.
pub fn response(b: Bytes, mut h: Head) -> Progress {
    h = head()
    progress(parse(b, mut h, true))
}

/// Compares ASCII bytes without changing their spelling. O(n), no allocation.
/// Ex: `http1.equal_ascii(value, string.as_bytes("websocket"))`.
pub fn equal_ascii(a: Bytes, b: Bytes) -> bool {
    if list.len(a) != list.len(b) {
        return false
    }
    for i in 0u64 .. list.len(a) {
        if int.to_ascii_lower(a[i]) != int.to_ascii_lower(b[i]) {
            return false
        }
    }
    true
}

/// Comma/space/tab-separated ASCII token membership. O(n), no allocation.
/// Ex: `http1.contains(value, string.as_bytes("upgrade"))`.
pub fn contains(b: Bytes, wanted: Bytes) -> bool {
    let mut at: u64 = 0
    let n = list.len(b)
    while at < n {
        while at < n && (b[at] == 44 || b[at] == 32 || b[at] == 9) {
            at += 1
        }
        let start = at
        while at < n && b[at] != 44 && b[at] != 32 && b[at] != 9 {
            at += 1
        }
        if equal_ascii(list.slice(b, start, at), wanted) {
            return true
        }
    }
    false
}

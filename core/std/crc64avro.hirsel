/// CRC-64-AVRO of schema bytes. One lookup per byte in a 256-entry table. No admission.
pub fn fingerprint(b: Bytes) -> u64 {
    let mut fp: u64 = 0xc15d213aa4d7a795
    for x in b {
        let byte: u64 = int.widen(x)
        fp = (fp >> 8) ^ FINGERPRINT_TABLE[(fp ^ byte) & 255]
    }
    fp
}

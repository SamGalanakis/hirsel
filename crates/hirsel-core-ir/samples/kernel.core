fn f5 = n5 g3 {
  addr a0 = v1 byte v9 : ptr           ; the payload Deque's data
  addr a1 = v1 byte v10 : u64          ; len
  addr a2 = v1 byte v11 : u64          ; capacity
  addr a3 = v1 byte v12 : u64          ; head
  addr a4 = v4 byte v10 : ptr          ; slot 2: the Item's box
b0:
  v0: u64 = const 40
  v1: ptr, v2: u64 = alloc counted rc v0 align 8 charge v0
  v3: u64 = const 32
  v4: ptr, v5: u64 = alloc own v3 align 8 charge v3
  v6: u64 = const 8
  v7: ptr, v8: u64 = alloc own v6 align 8 charge v6
  v9: u64 = const 8
  v10: u64 = const 16
  v11: u64 = const 24
  v12: u64 = const 32
  v13: u64 = const 1
  v14: u64 = const 4
  v15: u64 = const 2
  address a0
  address a1
  address a2
  address a3
  address a4
  store a0, v4
  store a1, v13
  store a2, v14
  store a3, v15
  store a4, v7

fn sum(a: Simd[u8, 16], b: Simd[u8, 16]) -> Simd[u8, 16] { a + b }
type Block { lanes: Simd[u8, 16] }
fn wide(v: Simd[u64, 8]) -> u64 { 0 }
fn pick(t: Simd[u16, 16], i: Simd[u8, 16]) -> Simd[u16, 16] { simd.swizzle(t, i) }
fn float_lanes(v: Simd[f32, 4]) {}
fn length_parameter[N](v: Simd[u8, N]) {}
fn short(v: Simd[u8, 8]) {}
fn tuple_type(v: (Simd[u8, 16], u8)) {}
fn array_type(v: Inline[Simd[u8, 16], 2]) {}
fn list_type(v: List[Simd[u8, 16]]) {}
fn callable(v: fn(Simd[u8, 16])) {}
fn inferred_tuple(v: Simd[u8, 16]) { let _ = (v, 0u8) }
fn inferred_array(v: Simd[u8, 16]) { let _ = [v; 2] }
fn identity[T: plain](v: T) -> T { v }
fn inferred_generic(v: Simd[u8, 16]) { let _ = identity(v) }
fn capture(v: Simd[u8, 16]) { let _ = scoped fn() -> bool { simd.any(v) } }
fn mulhi_unsigned(a: Simd[u16, 8]) -> Simd[u16, 8] { simd.mulhi_i16(a, a) }
fn madd_wide(a: Simd[i32, 4]) -> bool { simd.any(simd.madd_i16(a, a)) }
fn pack_wide(a: Simd[i64, 2]) -> Simd[i32, 4] { simd.pack_saturating(a, a) }
fn sign_mismatch(xs: List[u32]) -> Simd[i32, 4] { list.lanes(xs, 0) }
fn width_mismatch(mut a: Inline[u16, 8], v: Simd[u8, 16]) { inline.set_lanes(mut a, 0, v) }


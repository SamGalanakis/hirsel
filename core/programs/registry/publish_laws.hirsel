// A later checkpoint must not change the first covering batch of an earlier release.
@test
fn cold_version_hints(tasks: Tasks, random: Random) -> Result[(), String] waits {
    let bucket = start_bucket(tasks, 3362, list.new())
    let mut w = new_witness_pair(1730000000)
    let mut c = connect_client(bucket.endpoint, tasks, bucket.clock, 3363)
    let mut seq = new_sequencer()
    do_init_pair(mut seq, mut c, mut w, random)
    let _ = result.unwrap(do_pub(mut seq, mut c, mut w, build_publish_req("acme.dev", "acme.dev/item@1", "1.0.0", "v1", 0, Some(subjects_one(SUB_A)), SUB_A, false), None, random))
    let _ = result.unwrap(do_pub(mut seq, mut c, mut w, build_publish_req("acme.dev", "acme.dev/item@1", "1.0.1", "v2", 1, None, SUB_A, false), None, random))
    let _ = take seq
    let mut cold = new_sequencer()
    result.unwrap(version_hints.rebuild(mut cold, mut c, DEADLINE))
    let reply = static.serve_get(mut cold, mut c, "/versions/acme.dev/item", DEADLINE)
    let _ = take c
    let _ = finish_bucket(take bucket)
    require(reply.status == 200 && reply.body == b"[[\"1.0.0\",\"1\",\"2\"],[\"1.0.1\",\"2\",\"3\"]]", "cold /versions must preserve first covering heads 2 and 3")
}

fn namespaces() -> List[String] {
    let mut values: List[String] = list.new()
    list.push(mut values, "acme.dev/*")
    list.push(mut values, "github.com/example/*")
    take values
}

fn service_sequencer() -> commit.Sequencer {
    commit.new(make_log_config(Release), make_log_config(Status), "https://pkg.example", option.unwrap(std.hex.decode(string.as_bytes(LEGAL_PK))))
}

fn leaf_content() -> Bytes {
    b"\x03\x17github.com/example/leaf\x01\x00\x00\x00\x09charge-v1\x00\x01\x0bleaf.hirsel\x01\x04leaf\x1apub fn one() -> u64 { 1 }\x0a\x00"
}

const LEAF_ROOT: String = "76ae24ce4d9a71210574fcf579054da206f4f2d70b109aa4908233a7e4bb3126"

@test
fn library_admission(c: Compiler, tasks: Tasks, random: Random) -> Result[(), String] waits {
    let bucket = start_bucket(tasks, 3364, list.new())
    let mut w = new_witness_pair(1730000000)
    let mut client = connect_client(bucket.endpoint, tasks, bucket.clock, 3365)
    let mut seq = new_sequencer()
    do_init_pair(mut seq, mut client, mut w, random)
    let _ = static.serve_get(mut seq, mut client, "/versions/before-admission", DEADLINE)
    let p = registry_auth.Publication(root: string.from(LEAF_ROOT), identity: "github.com/example/leaf@1", version: "1.0.0", description: "leaf", source_commit: None, enrollment: None)
    let mut frames: List[commit.FrameInput] = list.new()
    list.push(mut frames, commit.FrameInput(root: string.from(LEAF_ROOT), compressed: make_zstd_raw_alt(leaf_content())))
    let checked = match admit.check(c, mut seq, mut client, p, frames, list.new(), namespaces(), 1730000000, DEADLINE) {
        Ok(value) => take value,
        Error(Worker(Unavailable(msg))) => return Error(take msg),
        Error(Worker(Rejected(msg))) => return Error(take msg),
        Error(_) => return Error("valid C refused"),
    }
    let expected = b"{\"authority\":{\"carried\":{},\"reached\":{\"leaf/one\":{\"contained\":[],\"kinds\":[],\"provided\":[],\"unresolved\":null}},\"verdict\":\"pure\"},\"bindings\":[],\"header\":{\"charge\":\"charge-v1\",\"identity\":\"github.com/example/leaf@1\",\"version\":\"1.0.0\"},\"interface\":{\"modules\":[{\"extends_core\":false,\"items\":[{\"definition\":\"github.com/example/leaf@1/leaf/one\",\"kind\":\"function\",\"name\":\"one\",\"signature\":\"pub fn one() -> u64\"}],\"path\":[\"leaf\"]}],\"package\":{\"name\":\"github.com/example/leaf\",\"version\":\"1\"},\"version\":1},\"root\":\"76ae24ce4d9a71210574fcf579054da206f4f2d70b109aa4908233a7e4bb3126\"}"
    require(checked.facts_bytes == expected && checked.facts_digest == pending.sha256_hex(expected) && pending.lower_hex(checked.compiler_id, 64), "complete canonical compiler facts and build identity")?
    frames[0u64].compressed = make_zstd_raw_alt(b"wrong")
    let refused = admit.check(c, mut seq, mut client, p, frames, list.new(), namespaces(), 1730000000, DEADLINE)
    let _ = take client
    let report = finish_bucket(take bucket)
    let Error(Invalid) = refused else {
        return Error("wrong library root accepted")
    }
    let mut started = false
    for request in report.requests {
        if request.key == "versions/before-admission" {
            started = true
        }
        if started && request.method == "PUT" {
            return Error("admission wrote an object")
        }
    }
    require(started, "admission boundary missing from bucket trace")
}

type Documents: send {
    site: Listener,
    clock: Clock
}

type DocumentNetwork: send {
    network: std.sim.net.Network,
    port: Served[NetOp],
    clock: Clock
}

fn drive_documents(take link: DocumentNetwork) waits {
    let DocumentNetwork(network: take network, port: take port, clock) = take link
    let mut plan = std.sim.world.plan(3366)
    let _ = std.sim.net.serve(network, mut plan, clock, take port)
}

fn serve_documents(take docs: Documents) waits {
    let Documents(site: take site, clock) = take docs
    let mut listener = take site
    loop {
        let Ok((sock, _)) = host.accept(mut listener, At(clock, DEADLINE)) else {
            return
        }
        let (rx, tx) = net.split(take sock)
        let mut reader = take rx
        let mut writer = take tx
        let mut input: Bytes = list.with_capacity(16384)
        let mut path = string.new()
        loop {
            let Ok(n) = host.recv_bounded(mut reader, mut input, 16384 - list.len(input), At(clock, DEADLINE)) else {
                return
            }
            if n == 0 {
                return
            }
            let Ok(text) = string.from_utf8(clone(input)) else {
                return
            }
            if std.string.find(text, 0, "\r\n\r\n") != None {
                path = take text
                break
            }
        }
        let data = if std.string.starts_with(path, "GET /jwks ") {
            string.from(SERVICE_JWKS)
        } else if std.string.starts_with(path, "GET /.well-known/hirsel-registry.json ") {
            string.from(SERVICE_ENROLLMENT)
        } else {
            string.from("{}")
        }
        let mut msg = string.from("HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: application/json\r\nContent-Length: ")
        string.push_u64(mut msg, string.byte_len(data))
        string.push(mut msg, "\r\n\r\n")
        string.push(mut msg, data)
        let _ = std.http.write_wire(mut writer, string.as_bytes(msg), b"", clock, DEADLINE)
    }
}

fn document_network(tasks: Tasks, clock: Clock) -> (Net, Task[()], Task[()]) waits {
    let (root, port) = provide.net(bytes 65536)
    let mut network = std.sim.net.new(std.sim.net.defaults())
    let ip = V4(134744072)
    let mut ips: List[Ip] = list.new()
    list.push(mut ips, ip)
    std.sim.net.resolve_as(mut network, "acme.dev", clone(ips))
    std.sim.net.resolve_as(mut network, "issuer.example", take ips)
    std.sim.net.handshake_as(mut network, "acme.dev", Ok(Handshake(protocol: Some(0), peer: (0, 0, 0, 0))))
    std.sim.net.handshake_as(mut network, "issuer.example", Ok(Handshake(protocol: Some(0), peer: (0, 0, 0, 0))))
    let driver = task.spawn(tasks, bytes 8388608, DocumentNetwork(network: take network, port: take port, clock: clock), drive_documents)
    let (listener, _) = result.unwrap(host.listen(root, Addr(ip: ip, port: 443), 8))
    let server = task.spawn(tasks, bytes 1048576, Documents(site: take listener, clock: clock), serve_documents)
    (root, take driver, take server)
}

fn packet(meta: String, frames: List[Bytes]) -> Bytes {
    let mut data: Bytes = list.new()
    list.put_word_be(mut data, (int.narrow(string.byte_len(meta)) : u32))
    list.append(mut data, string.as_bytes(meta))
    for frame in frames {
        list.put_word_be(mut data, (int.narrow(list.len(frame)) : u32))
        list.append(mut data, frame)
    }
    take data
}

fn blob(hex: String) -> List[Bytes] {
    let mut frames: List[Bytes] = list.new()
    list.push(mut frames, make_zstd_raw_alt(option.unwrap(std.hex.decode(string.as_bytes(hex)))))
    take frames
}

fn run_submit(c: Compiler, mut seq: commit.Sequencer, mut client: std.object.Client, cfg: submit.Config, data: Bytes, mut lookup: registry_auth.Lookup, clock: Clock, random: Random, mut w: WitnessPair) -> Result[commit.Receipt, submit.Error] waits {
    let s = submit.decode(data)?
    submit.apply(c, mut seq, mut client, cfg, s, mut lookup, clock, random, DEADLINE, scoped fn(kind: checkpoint.LogKind, i: u64, p: String, b: String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] {
        post_pair(mut w, kind, i, p, b, random)
    })
}

fn applied(take r: Result[commit.Receipt, submit.Error], action: String) -> Result[commit.Receipt, String] {
    match take r {
        Ok(receipt) => Ok(take receipt),
        Error(e) => Error(cat3(action, " ", match e {
            Invalid => "invalid",
            Size => "size",
            Forbidden => "forbidden",
            Conflict => "conflict",
            _ => "unavailable",
        })),
    }
}

fn contains_raw(data: Bytes, needle: Bytes) -> bool {
    if list.len(data) < list.len(needle) {
        return false
    }
    for i in 0u64 .. list.len(data) - list.len(needle) + 1 {
        if data[i] == needle[0u64] && list.slice(data, i, i + list.len(needle)) == needle {
            return true
        }
    }
    false
}


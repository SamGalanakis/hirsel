; LANG-19 through own-fn environments: releasing a closure whose captures hold
; a closure, n deep, uses constant native stack. f0(n) starts from a
; captureless callable (f1, no environment) and wraps it n times. Each wrap
; allocates an environment of row t1 (one ownfn capture, logical 16, so
; charge 16 and block 8 + 16), moves the current callable into it, and makes
; the callable (f1, that environment). Dropping the callable releases every
; environment, newest first.
; Derived by hand: the run returns n, frees every environment (used 0) and
; makes n admissions.
; run: f0(0) -> 0 | used 0
; run: f0(1) -> 1 | used 0
; run: f0(32) -> 32 | used 0
core v1
type t0 = own "Callable" { f: ownfn }
type t1 = own "Captures" { g: ownfn }
sig g0 = (u64) -> (u64)
sig g1 = (ptr) -> (u64)
inst n0 = test@0/closure_chain/run [] []
inst n1 = test@0/closure_chain/code [] []
fn f0 = n0 g0 {
  slot s0 = t0
  addr a0 = s0 field 0 : ptr           ; the callable's code
  addr a1 = s0 field 0 byte v2 : ptr   ; the callable's environment
  addr a2 = v7 byte v2 : ptr           ; the capture's code
  addr a3 = v7 byte v3 : ptr           ; the capture's environment
  addr a4 = s0 : t0
b0(v0: u64):
  live s0
  v1: ptr = fnref f1
  v2: u64 = const 8
  v3: u64 = const 16
  v4: ptr = const 0x0
  v5: u64 = const 0
  address a0
  address a1
  address a4
  store a0, v1
  store a1, v4
  jump b1(v5)
b1(v6: u64):                           ; wraps made
  v9: bool = lt v6, v0
  branch v9, b2, b4(v6)
b2:
  v10: u64 = const 24
  v7: ptr, v8: u64 = alloc env t1 v10 align 8 charge v3
  v11: bool = ne v7, v4
  branch v11, b3, b4(v6)
b3:
  v12: ptr = read a0
  v13: ptr = read a1
  address a2
  address a3
  store a2, v12
  store a3, v13
  store a1, v7
  v14: u64 = const 1
  v15: u64 = wrapping_add v6, v14
  jump b1(v15)
b4(v16: u64):
  drop a4 t0                           ; LANG-19: the release
  dead s0
  return v16
}
fn f1 = n1 g1 {
b0(v0: ptr):
  v1: u64 = const 0
  return v1
}

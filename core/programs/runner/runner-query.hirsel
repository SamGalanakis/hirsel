// An attempted query cannot publish a value or a cover before Store accepts its read set.
type Viewed: shareable + send {
    covers: List[Cover],
    value: Bytes,
    reads: List[store.Read]
}

type Queried = Covered(Viewed) | Stopped(Outcome) | Faulted(Outcome, List[store.Read]) | Lost(store.Error, List[store.Read])

type QueryBody[H, A, R] = Plain(StaticFn[fn(store.Tx, H, take A) -> Result[Answer[R], Capacity]]) | As(StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Answer[R], Capacity]])

type QueryAttempt[H, A, R] {
    body: QueryBody[H, A, R],
    args: std.codec.Codec[A],
    value: std.codec.Codec[R],
    handles: H,
    caller: Caller,
    arguments: Bytes,
    steps: u64
}

fn query_body[H, A, R](body: QueryBody[H, A, R], tx: store.Tx, h: H, caller: Caller, take a: A) -> Result[Answer[R], Capacity] {
    match body {
        Plain(f) => code.callable(f)(tx, h, take a),
        As(f) => code.callable(f)(tx, h, caller, take a),
    }
}

fn query_attempt[H: inert, A, R](tx: store.Tx, attempt: QueryAttempt[H, A, R]) -> Result[Answer[Bytes], Outcome] {
    let ran = isolate(fn() -> Result[Answer[Bytes], Outcome] {
        let input = std.codec.decode(attempt.args, attempt.arguments) ?=> |e| Refused(Malformed(bad(e)))
        let Answer(value: take value, covers: take selected) = query_body(attempt.body, tx, attempt.handles, attempt.caller, take input) ?=> |f| Failed(OutOfBytes(capacity_room(f)))
        let encoded_answer = encode_query_value(attempt.value, value, attempt.steps)?
        Ok(Answer(value: take encoded_answer, covers: take selected))
    })
    match take ran {
        Ok(Ok(take output)) => take output,
        Ok(Error(cs)) => {
            for cause in cs {
                if let OutOfTime = cause.kind {
                    return Error(Failed(OutOfTime(attempt.steps)))
                }
            }
            Error(projection_cause(cs))
        },
        Error(problem) => Error(Failed(OutOfBytes(capacity_room(problem)))),
    }
}

fn encode_query_value[R](codec: std.codec.Codec[R], value: R, steps: u64) -> Result[Bytes, Outcome] {
    let run_encoder = isolate(fn() -> Result[Bytes, std.codec.EncodeError] {
        let mut encoded_value: Bytes = list.new()
        std.codec.encode(codec, value, mut encoded_value)?
        Ok(take encoded_value)
    })
    match take run_encoder {
        Ok(Ok(Ok(take encoded_value))) => Ok(take encoded_value),
        Ok(Ok(Error(_))) => Error(Failed(Raised(5u32))),
        Ok(Error(cs)) => {
            for cause in cs {
                if let OutOfTime = cause.kind {
                    return Error(Failed(OutOfTime(steps)))
                }
            }
            Error(projection_cause(cs))
        },
        Error(problem) => Error(Failed(OutOfBytes(capacity_room(problem)))),
    }
}

fn query_projection[H: inert + send, Outer: send, A, R](access: PublisherReads, read_handle: store.Reader, attempt: QueryAttempt[H, A, R], declared: Slots[Outer], bindings: List[BoundSlot], newest: store.Snapshot, prior: store.Snapshot, rows: Log[Row], old: Option[View[List[Cover]]]) -> Queried waits {
    let steps = attempt.steps
    match store.look(read_handle, newest, Some(steps), attempt, query_attempt) {
        Ok(Seen(take answer)) => {
            let store.Seen(value: take output, reads: take reads, ..) = take answer
            let accepted = match take output {
                Ok(take received) => take received,
                Error(take why) => return Faulted(take why, take reads),
            }
            let Answer(value: take value, covers: take selections) = take accepted
            let projected = bound steps steps {
                project_query_covers(access, read_handle, declared, bindings, newest, prior, rows, old, take selections)
            }
            match take projected {
                Ok(Ok(take spans)) => Covered(Viewed(covers: take spans, value: take value, reads: take reads)),
                Ok(Error(take problem)) => finish_projection(take problem, take reads),
                Error(limit) => Faulted(Failed(OutOfTime(limit.steps)), take reads),
            }
        },
        Ok(Failed(cs, take reads)) => Faulted(Failed(Raised(raised(cs))), take reads),
        Ok(Refused(c, take reads)) => Faulted(Failed(OutOfBytes(capacity_room(store_capacity(c)))), take reads),
        Ok(Stopped(e, take reads)) => Faulted(Failed(OutOfTime(e.steps)), take reads),
        Error(take problem) => Lost(take problem, list.new()),
    }
}

fn project_query_covers[H: send](access: PublisherReads, read_handle: store.Reader, declared: Slots[H], bindings: List[BoundSlot], newest: store.Snapshot, prior: store.Snapshot, rows: Log[Row], old: Option[View[List[Cover]]], take selections: CoverSet) -> Result[List[Cover], ProjectionIssue] waits {
    let matched = isolate(scoped fn() -> Result[List[Cover], Outcome] {
        matched_covers(selections, declared, bindings)
    })
    let spans = match take matched {
        Ok(Ok(Ok(take selected))) => take selected,
        Ok(Ok(Error(take why))) => return Error(ProjectionStopped(take why)),
        Ok(Error(cs)) => return Error(ProjectionStopped(projection_cause(cs))),
        Error(problem) => return Error(ProjectionStopped(Failed(OutOfBytes(capacity_room(problem))))),
    }
    match old {
        Some(previous) => rerun_rows(access, read_handle, prior, previous, newest, spans, bindings, rows)?,
        None => cover_rows(access, read_handle, newest, spans, bindings, rows)?,
    }
    Ok(take spans)
}

fn adapt_query[H: inert + send, Outer: send, A, R](body: QueryBody[H, A, R], ca: std.codec.Codec[A], cr: std.codec.Codec[R], declared: Slots[Outer], bindings: List[BoundSlot], access: PublisherReads, read_handle: store.Reader, h: Outer, select: fn(Outer) -> H, caller: Caller, arg: Bytes, n: u64, steps: u64, newest: store.Snapshot, prior: store.Snapshot, rows: Log[Row], old: Option[View[List[Cover]]]) -> Queried waits {
    let result = bound bytes n {
        let prepared = isolate(scoped fn() -> QueryAttempt[H, A, R] {
            QueryAttempt(body: body, args: ca, value: cr, handles: select(h), caller: store.copy_env(caller), arguments: store.copy_env(arg), steps: steps)
        })
        match take prepared {
            Ok(Ok(take attempt)) => query_projection(access, read_handle, attempt, declared, bindings, newest, prior, rows, old),
            Ok(Error(cs)) => Stopped(projection_cause(cs)),
            Error(problem) => Stopped(Failed(OutOfBytes(capacity_room(problem)))),
        }
    }
    match take result {
        Ok(take output) => take output,
        Error(problem) => Stopped(Refused(Budget(capacity_room(problem)))),
    }
}

type QueryEntry[H: send]: send {
    by_caller: bool,
    ephemeral: Option[RoomEntry],
    slots: Slots[H],
    run: own[send] fn(Slots[H], List[BoundSlot], PublisherReads, store.Reader, H, Caller, Bytes, store.Snapshot, store.Snapshot, Log[Row], Option[View[List[Cover]]]) -> Queried waits
}

pub fn query[G: send, H: shareable + inert + send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, take A) -> Result[Answer[R], Capacity]], take declarations: Slots[H], n: u64, s: u64) -> Result[(), RegisterError] {
    register_query(mut r, Plain(f), take declarations, store.copy_env, n, s, None)
}

pub fn query_as[G: send, H: shareable + inert + send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Answer[R], Capacity]], take declarations: Slots[H], n: u64, s: u64) -> Result[(), RegisterError] {
    register_query(mut r, As(f), take declarations, store.copy_env, n, s, None)
}

pub fn query_as_with[G: send, Outer: shareable + inert + send, H: shareable + inert + send, A: codec, R: codec](mut r: Registry[G, Outer], f: StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Answer[R], Capacity]], take declarations: Slots[H], select: fn(Outer) -> H, n: u64, s: u64) -> Result[(), RegisterError] {
    let projected = map_slots(take declarations, select)
    register_query(mut r, As(f), take projected, select, n, s, None)
}

fn register_query[G: send, Outer: shareable + inert + send, H: shareable + inert + send, A: codec, R: codec](mut r: Registry[G, Outer], body: QueryBody[H, A, R], take registered_slots: Slots[Outer], select: fn(Outer) -> H, n: u64, s: u64, take ephemeral: Option[RoomEntry]) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let mark: Bytes = match body {
        Plain(f) => clone(code.identity(f)),
        As(f) => clone(code.identity(f)),
    }
    let (take key, take d) = entry_described(r, mark, scoped fn() -> Result[(Bytes, Exported), RegisterError] {
        let value = std.codec.schema(cr) ?=> |_| Bounds
        let schemas = slot_descriptions(registered_slots)
        let (kind, take result): (Kind, Bytes) = match ephemeral {
            Some(definition) => (Room, ((definition.hooks)().schema)(value, schemas, definition)?),
            None => (Query, encode_query_schema(clone(value), clone(schemas)) ?=> |_| Bounds),
        }
        let described_query = match body {
            Plain(f) => described_result(code.identity(f), code.revision(f), kind, ca, take result),
            As(f) => described_result(code.identity(f), code.revision(f), kind, ca, take result),
        }
        let mut entry = described_query ?=> |_| Bounds
        entry.1.slots = take schemas
        entry.1.value = take value
        Ok(take entry)
    })?
    register_check(mut r, key, ca, n, s)?
    let go = fn(declared: Slots[Outer], bindings: List[BoundSlot], access: PublisherReads, read_handle: store.Reader, h: Outer, caller: Caller, arg: Bytes, newest: store.Snapshot, prior: store.Snapshot, rows: Log[Row], old: Option[View[List[Cover]]]) -> Queried waits {
        adapt_query(body, ca, cr, declared, bindings, access, read_handle, h, select, caller, arg, n, s, newest, prior, rows, old)
    }
    let by_caller = match body {
        As(_) => true,
        Plain(_) => false
    }
    insert_exported(mut r, take key, mark, take d, Query(n, s, QueryEntry(by_caller: by_caller, ephemeral: take ephemeral, slots: take registered_slots, run: take go)))
}

fn bind_query_slots[G: send, H: shareable + inert + send](mut r: Registry[G, H], h: H) -> Result[(), RegisterError] {
    for (entry, registered) in r.slots {
        if let Query(_, _, entry_query) = registered {
            let bindings = bind_slots(entry_query.slots, h)?
            map.insert(mut r.bound_slots, clone(entry), take bindings)
        }
    }
    Ok(())
}

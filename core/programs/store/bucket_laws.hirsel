// Bucket authority laws on std.sim.s3, against the real store writer.
type BucketSim {
    network: Net,
    endpoint: std.sim.s3.Endpoint,
    time: Clock,
    server: Task[std.sim.s3.Report],
    driver: Task[()],
    stop: Sender[()]
}

type BucketSimClock: send {
    world: std.sim.world.World,
    stop: Receiver[()],
    real: Clock
}

const BUCKET_LAW_OP_MS: u64 = 30000

const BUCKET_LAW_ROUNDS: u64 = 3

const BUCKET_LAW_CUTS: u64 = 40

// Advances virtual time until the law stops it and no virtual timer is
// left. `clock.idle` also answers None while the store waits on its real
// disk, so before the stop None means only that the driver waits a real
// millisecond and asks again. After the stop, clients the law dropped may
// still be backing off on virtual time; the driver ends only once they are
// done, since a frozen clock would keep their tasks, and so the server, alive.
fn bucket_law_clock(take input: BucketSimClock) waits {
    let BucketSimClock(world: take initial, stop: take stop, real) = take input
    let mut world = take initial
    loop {
        if std.sim.world.step(mut world) {
            continue
        }
        if let Ok(()) = channel.try_receive(stop) {
            return
        }
        host.sleep_until(real, clock.deadline_after_ms(host.mono_ns(real), 1))
    }
}

fn bucket_law_signing_key() -> Secret {
    // AWS's documentation example key, derived for 20130524/us-east-1/s3.
    let raw: Inline[u8, 32] =[219, 184, 147, 172, 192, 16, 150, 73, 24, 241, 253, 67, 58, 221, 135, 199, 14, 139, 13, 182, 190, 48, 193, 251, 234, 254, 250, 94, 198, 186, 131, 120]
    let mut owned: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32 {
        list.push(mut owned, raw[i])
    }
    result.unwrap(secret.seal(take owned, "mac"))
}

fn bucket_law_spare() -> Addr {
    Addr(ip: V4(2130706434), port: 8080)
}

// Requests to s3.test may be cut. Requests to spare.test never are.
fn bucket_law_sim(tasks: Tasks, real: Clock, seed: u64, cut: Option[std.sim.s3.Cut], take faults: List[std.sim.s3.Fault]) -> BucketSim {
    bucket_law_sim_plan(tasks, real, seed, cut, take faults, std.sim.world.plan(seed))
}

fn bucket_law_sim_plan(tasks: Tasks, real: Clock, seed: u64, cut: Option[std.sim.s3.Cut], take faults: List[std.sim.s3.Fault], take plan: std.sim.world.Plan) -> BucketSim {
    bucket_law_sim_holds(tasks, real, seed, cut, take faults, list.new(), take plan)
}

fn bucket_law_sim_holds(tasks: Tasks, real: Clock, seed: u64, cut: Option[std.sim.s3.Cut], take faults: List[std.sim.s3.Fault], take holds: List[std.sim.s3.Hold], take plan: std.sim.world.Plan) -> BucketSim {
    let (world, time) = std.sim.world.new(seed, 0, 1369353600000)
    let (stop, stopping): (Sender[()], Receiver[()]) = channel.new(1u64)
    let driver = task.spawn(tasks, bytes 65536, BucketSimClock(world: take world, stop: take stopping, real), bucket_law_clock)
    let (endpoint, take server) = bucket_law_server(tasks, time, cut, take faults, take holds, take plan)
    BucketSim(network: std.sim.s3.endpoint_network(endpoint), endpoint, time, server: take server, driver: take driver, stop: take stop)
}

fn bucket_law_server(tasks: Tasks, time: Clock, cut: Option[std.sim.s3.Cut], take faults: List[std.sim.s3.Fault], take holds: List[std.sim.s3.Hold], take plan: std.sim.world.Plan) -> (std.sim.s3.Endpoint, Task[std.sim.s3.Report]) {
    bucket_law_server_sized(tasks, time, cut, take faults, take holds, take plan, 33554432)
}

fn bucket_law_server_sized(tasks: Tasks, time: Clock, cut: Option[std.sim.s3.Cut], take faults: List[std.sim.s3.Fault], take holds: List[std.sim.s3.Hold], take plan: std.sim.world.Plan, server_room: u64) -> (std.sim.s3.Endpoint, Task[std.sim.s3.Report]) {
    let address = Addr(ip: V4(2130706433), port: 8080)
    let mut net_model = std.sim.net.new(std.sim.net.defaults())
    let mut primary: List[Ip] = list.with_capacity(1)
    list.push(mut primary, address.ip)
    std.sim.net.resolve_as(mut net_model, string.from("bucket.s3.test"), take primary)
    std.sim.net.handshake_as(mut net_model, string.from("bucket.s3.test"), Ok(Handshake(protocol: Some(0), peer: (0, 0, 0, 0))))
    let mut spare: List[Ip] = list.with_capacity(1)
    list.push(mut spare, bucket_law_spare().ip)
    std.sim.net.resolve_as(mut net_model, string.from("bucket.spare.test"), take spare)
    let key = bucket_law_signing_key()
    let verify = result.unwrap(secret.narrow(key, "verify"))
    let config = std.sim.s3.Config(address, cut: cut, network: take net_model, after_resolve: None, credential: string.from("AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request"), signing_key: take verify, faults: take faults, holds: take holds, exists_status: 412, fragment_bytes: 4096, max_body: 16777216)
    std.sim.s3.start_service(tasks, take config, take plan, time, 1048576, server_room)
}

fn bucket_law_place(host_name: String) -> std.object.Bucket {
    let mut endpoint = string.from("http://")
    string.push(mut endpoint, host_name)
    string.push(mut endpoint, ":8080")
    std.object.Bucket(endpoint: take endpoint, aws_region: string.from("us-east-1"), bucket: string.from("bucket"), prefix: string.from(""), style: Virtual)
}

fn bucket_law_client(s: BucketSim, tasks: Tasks, host_name: String, seed: u64) -> Result[std.object.Client, Error] waits {
    bucket_law_client_with(s, tasks, host_name, seed, false)
}

fn bucket_law_lanes(lanes: u64) -> std.object.LaneConfig {
    std.object.LaneConfig(requested_lanes: lanes, lane_bytes: 1048576)
}

fn bucket_law_client_with(s: BucketSim, tasks: Tasks, host_name: String, seed: u64, typed: bool) -> Result[std.object.Client, Error] waits {
    bucket_law_client_lanes(s, tasks, host_name, seed, typed, 0)
}

fn bucket_law_client_lanes(s: BucketSim, tasks: Tasks, host_name: String, seed: u64, typed: bool, lanes: u64) -> Result[std.object.Client, Error] waits {
    bucket_endpoint_client(s.endpoint, s.network, s.time, tasks, host_name, seed, typed, lanes)
}

fn bucket_endpoint_client(endpoint: std.sim.s3.Endpoint, network: Net, time: Clock, tasks: Tasks, host_name: String, seed: u64, typed: bool, lanes: u64) -> Result[std.object.Client, Error] waits {
    let secret_bytes = string.into_bytes(string.from("wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"))
    let root = result.unwrap(secret.seal(take secret_bytes, "kdf"))
    let credentials_set = std.cred.from_secret("AKIAIOSFODNN7EXAMPLE", take root, "")
    let deadline = std.clock.deadline_after_ms(host.mono_ns(time), BUCKET_LAW_OP_MS)
    let place = bucket_law_place(host_name)
    let random = provide.random(seed)
    let connected = if typed {
        std.object.start_simulated(endpoint, tasks, take place, take credentials_set, time, random, bucket_law_lanes(lanes), deadline)
    } else {
        std.object.start(network, tasks, take place, take credentials_set, None, System, time, random, bucket_law_lanes(lanes), deadline)
    }
    match take connected {
        Ok(take client) => Ok(take client),
        Error(take e) => Error(Remote(take e)),
    }
}

fn bucket_law_https_client(s: BucketSim, tasks: Tasks, host_name: String, seed: u64) -> Result[std.object.Client, Error] waits {
    let secret_bytes = string.into_bytes(string.from("wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"))
    let root = result.unwrap(secret.seal(take secret_bytes, "kdf"))
    let credentials_set = std.cred.from_secret("AKIAIOSFODNN7EXAMPLE", take root, "")
    let deadline = std.clock.deadline_after_ms(host.mono_ns(s.time), BUCKET_LAW_OP_MS)
    let mut endpoint = string.from("https://")
    string.push(mut endpoint, host_name)
    string.push(mut endpoint, ":8080")
    let place = std.object.Bucket(endpoint: take endpoint, aws_region: string.from("us-east-1"), bucket: string.from("bucket"), prefix: string.from(""), style: Virtual)
    match std.object.start(s.network, tasks, take place, take credentials_set, None, System, s.time, provide.random(seed), bucket_law_lanes(1), deadline) {
        Ok(take client) => Ok(take client),
        Error(take e) => Error(Remote(take e)),
    }
}

fn bucket_law_adopt_auth() -> ClaimAuth {
    let mut attempt: Bytes = list.with_capacity(16)
    for i in 0u64 .. 16 {
        list.push(mut attempt, int.narrow(i + 1))
    }
    ClaimAuth(expect: None, attempt: take attempt, class: Adopt)
}

fn bucket_law_options(create: bool) -> Options {
    let mut options = result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64))
    options.create = create
    options.claim_auth = Some(bucket_law_adopt_auth())
    options
}

fn bucket_law_value(k: u64) -> Bytes {
    let mut value: Bytes = list.with_capacity(600)
    list.fill(mut value, 600, int.narrow(k))
    take value
}

fn bucket_law_rows_table(mut db: Db) -> Result[Table[u64, Bytes], Error] waits {
    match table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes()) {
        Error(Missing(_)) => {
            law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
            table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())
        },
        other => other,
    }
}

// Commits row k and waits for the bucket register to publish its group.
fn bucket_law_commit(mut db: Db, k: u64) -> Result[(), Error] waits {
    let rows = bucket_law_rows_table(mut db)?
    let value = bucket_law_value(k)
    let done = run(mut db, None, (copy_env(k), copy_env(rows), copy_env(value)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.1, call_env.0, call_env.2)
    })?
    let Committed(take receipt) = take done else {
        return Error(Foreign)
    }
    durable(mut db, receipt.ticket)
}

fn bucket_law_checkpoint(mut db: Db) -> Result[(), Error] waits {
    let cut = checkpoint(mut db)?
    durable(mut db, cut)
}

fn bucket_law_round(mut db: Db, k: u64) -> Result[(), Error] waits {
    bucket_law_commit(mut db, k)?
    bucket_law_checkpoint(mut db)
}

fn bucket_law_authority(s: BucketSim, tasks: Tasks, host_name: String, seed: u64) -> Result[Authority, Error] waits {
    let client = bucket_law_client_with(s, tasks, host_name, seed, true)?
    Ok(object_authority(take client, "bucket", BUCKET_LAW_OP_MS))
}

// The acknowledged row prefix and whether every checkpoint completed.
fn bucket_law_write(tasks: Tasks, r: Random, s: BucketSim, rounds: u64) -> (u64, bool) waits {
    let Ok(take authority) = bucket_law_authority(s, tasks, "s3.test", 1) else {
        return (0, false)
    }
    let Ok(take opened) = open_authority(tasks, take authority, s.time, r, bucket_law_options(true)) else {
        return (0, false)
    }
    let mut db = take opened
    let mut acked = 0u64
    let mut cut = 0u64
    for k in 1u64 .. rounds + 1 {
        if let Error(_) = bucket_law_commit(mut db, k) {
            break
        }
        acked = k
        if let Error(_) = bucket_law_checkpoint(mut db) {
            break
        }
        cut = k
    }
    let _ = close(take db)
    (acked, cut == rounds)
}

// The recovered rounds: k when rows 1..k hold their values.
fn bucket_law_rows(mut db: Db) -> Result[u64, Error] waits {
    let rows = match table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes()) {
        Ok(take found) => take found,
        Error(Missing(_)) => return Ok(0),
        Error(take e) => return Error(take e),
    }
    let s = snapshot(db)
    let mut got = 0u64
    loop {
        match get(result.unwrap(reader(db, 0u64)), s, rows, got + 1)? {
            Some(value) => {
                if value != bucket_law_value(got + 1) {
                    return Error(Foreign)
                }
                got += 1
            },
            None => return Ok(got),
        }
    }
}

// Recovers through the uncut address. Zero when the bucket holds no store.
fn bucket_law_recover(tasks: Tasks, r: Random, s: BucketSim, host_name: String, seed: u64) -> Result[u64, Error] waits {
    let authority = bucket_law_authority(s, tasks, host_name, seed)?
    let mut db = match open_authority(tasks, take authority, s.time, r, bucket_law_options(false)) {
        Ok(take opened) => take opened,
        Error(Refusal(error: NotFound, ..)) => return Ok(0),
        Error(Refusal(error: take e, ..)) => return Error(take e),
    }
    let got = bucket_law_rows(mut db)
    close(take db)?
    got
}

fn bucket_law_finish(take s: BucketSim) -> std.sim.s3.Report waits {
    let report = bucket_law_report(take s)
    result.unwrap(bucket_law_head_history(report))
    take report
}

fn bucket_law_report(take s: BucketSim) -> std.sim.s3.Report waits {
    let BucketSim(server: take server, driver: take driver, stop: take stop, ..) = take s
    result.unwrap(channel.send(stop, ()))
    let report = result.unwrap(task.join(take server))
    result.unwrap(task.join(take driver))
    take report
}

// At most one serial GROUP can apply without an answer. Cold recovery has
// no directory of its own and must recover the register's durable prefix.
fn bucket_law_cut(c: Clock, r: Random, tasks: Tasks, seed: u64, cut: std.sim.s3.Cut, take faults: List[std.sim.s3.Fault]) -> Result[bool, Error] waits {
    let apply = cut.apply
    let s = bucket_law_sim(tasks, c, seed, Some(cut), take faults)
    let (acked, finished) = bucket_law_write(tasks, r, s, BUCKET_LAW_ROUNDS)
    let recovered = bucket_law_recover(tasks, r, s, "spare.test", seed + 7)
    let _ = bucket_law_finish(take s)
    let got = recovered?
    if got != acked && !(apply && got == acked + 1) {
        fail("bucket wire cut: recovery lost or invented a durable row")
    }
    Ok(finished)
}

fn bucket_law_wire_cut(after: u64, apply: bool) -> std.sim.s3.Cut {
    std.sim.s3.Cut(after, apply, spare: bucket_law_spare())
}

fn bucket_law_seed(e: Env, fallback: u64) -> u64 {
    match std.sim.world.test_seed(e) {
        Some(active) => active,
        None => fallback,
    }
}

// Allow room for the objects@1 bootstrap, three groups and their checkpoints.
// Hold the simulation seed fixed across wire positions and modes.
@test
fn bucket_test_l4_cuts(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    for after in 0u64 .. 128 {
        let finished_applied = bucket_law_cut(c, r, tasks, 0, bucket_law_wire_cut(after, true), list.new())?
        let finished_dropped = bucket_law_cut(c, r, tasks, 0, bucket_law_wire_cut(after, false), list.new())?
        if finished_applied && finished_dropped {
            if after < 4 * BUCKET_LAW_ROUNDS {
                fail("bucket wire cut: the cut never reached the writer")
            }
            return Ok(())
        }
    }
    fail("bucket wire cut: the writer never finished the durable row groups")
}

// One cut per seed with retriable faults on the connections the plan picks.
@test
fn bucket_test_soak(c: Clock, r: Random, tasks: Tasks, e: Env) -> Result[(), Error] waits {
    let seed = bucket_law_seed(e, 0)
    let after = seed % BUCKET_LAW_CUTS
    let apply = (seed / BUCKET_LAW_CUTS) % 2 == 0
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(10)
    for _ in 0u64 .. 8 {
        list.push(mut faults, Clean)
    }
    list.push(mut faults, ResetBeforeBody)
    list.push(mut faults, InternalError)
    let _ = bucket_law_cut(c, r, tasks, seed, bucket_law_wire_cut(after, apply), take faults)?
    Ok(())
}

fn bucket_law_fence(r: Random, tasks: Tasks, s: BucketSim) -> Result[(), Error] waits {
    let first = bucket_law_authority(s, tasks, "s3.test", 1)?
    let mut a = open_authority(tasks, take first, s.time, r, bucket_law_options(true)) ?=> |Refusal(error: take problem, ..)| take problem
    bucket_law_round(mut a, 1)?
    let second = bucket_law_authority(s, tasks, "s3.test", 2)?
    let mut b = open_authority(tasks, take second, s.time, r, bucket_law_options(false)) ?=> |Refusal(error: take problem, ..)| take problem
    match bucket_law_round(mut a, 4) {
        Error(Fenced(1)) => {},
        _ => fail("bucket fence: the old writer published past the new claim"),
    }
    if let Ok(_) = healthy(a) {
        fail("bucket fence: the fenced writer stayed healthy")
    }
    let _ = close(take a)
    bucket_law_round(mut b, 2)?
    bucket_law_round(mut b, 3)?
    let rows = bucket_law_rows_table(mut b)?
    if get(reader(b, 0u64)?, snapshot(b), rows, 4)? != None {
        fail("bucket fence: the stale writer's row became visible")
    }
    close(take b)?
    if bucket_law_recover(tasks, r, s, "s3.test", 3)? != 3 {
        fail("bucket fence: recovery did not see the new writer's rounds")
    }
    Ok(())
}

@test
fn bucket_test_fence(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 5, None, list.new())
    let checked = bucket_law_fence(r, tasks, s)
    let report = bucket_law_finish(take s)
    checked?
    if list.len(report.pending) != 0 {
        fail("bucket fence: a pending upload survived recovery")
    }
    Ok(())
}

fn bucket_law_capture(r: Random, tasks: Tasks, s: BucketSim) -> Result[(), Error] waits {
    // The successor and follower are live together, so both use the small-history sizing.
    let plan = follower_law_plan(Bucket(bucket_law_lanes(0)), bucket_law_options(true))
    let mut options: Options = clone(plan.options)
    options.create = true
    // A plan carries no identity options: the writer names its own ClaimAuth.
    options.claim_auth = Some(bucket_law_adopt_auth())
    let first = bucket_law_authority(s, tasks, "s3.test", 1)?
    let mut writer = open_authority(tasks, take first, s.time, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    bucket_law_round(mut writer, 1)?
    bucket_law_commit(mut writer, 2)?
    let rows = bucket_law_rows_table(mut writer)?
    close(take writer)?
    options.create = false
    let source = bucket_law_authority(s, tasks, "s3.test", 2)?
    let mut wrong_activation: Options = clone(options)
    wrong_activation.activation = Some(1u64)
    let Error(Refusal(error: NotCurrent(0), authority: take returned)) = open_authority(tasks, take source, s.time, r, wrong_activation) else {
        fail("L61: the writer open did not refuse the wrong activation")
    }
    let mut process = followers()
    let service = follower_law_service(tasks, plan, 1)?
    let mut mirror = follower(mut process, follower_slot(follower_owner(service)?, plan)?, take returned, s.time, options.expect)?
    let Some(main) = follower_branch(mirror, "main") else {
        fail("the follower did not recover main")
    }
    let before = snapshot_follower(mirror, main)?
    let read_handle = follower_reader(mirror, 0u64)?
    if get(read_handle, before, rows, 2)? != Some(bucket_law_value(2)) || follower_head(mirror)?.claim.epoch != 1 {
        fail("the follower missed the durable group or claimed the register")
    }
    let successor_grant = bucket_law_authority(s, tasks, "s3.test", 3)?
    let mut successor = open_authority(tasks, take successor_grant, s.time, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    bucket_law_commit(mut successor, 3)?
    close(take successor)?
    let deadline = clock.deadline_after_ms(host.mono_ns(s.time), BUCKET_LAW_OP_MS)
    let current = fresh(mut mirror, deadline)?
    if get(read_handle, current, rows, 3)? != Some(bucket_law_value(3)) || follower_head(mirror)?.claim.epoch != 2 {
        fail("the refreshed follower missed the successor's durable group")
    }
    if get(read_handle, before, rows, 2)? != Some(bucket_law_value(2)) || get(read_handle, before, rows, 3)? != None {
        fail("refresh changed the previous capture")
    }
    Ok(())
}

@test
fn bucket_test_read_only_capture(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 6, None, list.new())
    let checked = bucket_law_capture(r, tasks, s)
    let _ = bucket_law_finish(take s)
    checked
}

fn bucket_m2_law_commit_packet(mut raw: Bytes, head: history.HistoryHead, version_number: u64) -> Result[(), Error] {
    let seq = failure_result_from_rep(history.history_next_id(head.entry.seq))?
    let ctx = format.DiskContext(store: head.store, role: 2, seq)
    failure_result_from_rep(history.history_packet_header(mut raw, ctx, head.pair.epoch, head.authority_kind, head.entry))?
    list.fill(mut raw, 16, 0u8)
    list.put_word_le(mut raw, 0u32)
    list.put_word_le(mut raw, version_number)
    list.put_word_le(mut raw, 0u64)
    list.push(mut raw, 1u8)
    list.push(mut raw, 0u8)
    list.put_word_le(mut raw, 0u32)
    failure_result_from_rep(types.capacity(format.history_seal(mut raw, ctx, 112, 0x0011)))
}

fn bucket_m2_law_register(tasks: Tasks, sim: BucketSim) -> Result[(pages.HistoryRef, pages.HistoryRef), Error] waits {
    let mut first = bucket_law_client(sim, tasks, "s3.test", 1)?
    let mut second = bucket_law_client(sim, tasks, "s3.test", 2)?
    let config = history.object_history_config(std.object.bucket_config(first), "bucket")
    let metadata = failure_result_from_rep(history.history_config_bytes(config))?
    let mut a_buffers = failure_result_from_rep(history.history_buffers(1024))?
    let mut b_buffers = failure_result_from_rep(history.history_buffers(1024))?
    let due = std.object.deadline_after_ms(first, BUCKET_LAW_OP_MS)
    let mut a = failure_result_from_rep(history.history_publish_genesis(mut first, store_key_to_rep(StoreId(hi: 9, lo: 10)), store_key_to_rep(StoreId(hi: 11, lo: 12)), 1, metadata, mut a_buffers, due, limits_to_rep(default_limits()), None))?
    failure_result_from_rep(history.history_claim_packet(mut a_buffers.packet, history.register_head(a)))?
    let HistoryApplied(_) = failure_result_from_rep(history.history_register_advance(mut first, mut a, metadata, mut a_buffers, due))? else {
        fail("genesis CLAIM did not advance")
    }
    bucket_m2_law_commit_packet(mut a_buffers.packet, history.register_head(a), 1)?
    let HistoryApplied(_) = failure_result_from_rep(history.history_register_advance(mut first, mut a, metadata, mut a_buffers, due))? else {
        fail("first commit did not advance")
    }
    let _ = failure_result_from_rep(history.history_fetch(mut second, "head", mut b_buffers.witness, due))?
    let captured = failure_result_from_rep(history.history_decode_head(b_buffers.witness))?
    let HistoryClaimed(take claimed) = history_replace_claim(mut second, captured.head, StoreId(hi: 13, lo: 14), bucket_law_adopt_auth(), mut b_buffers, due, None)? else {
        fail("second holder failed to claim")
    }
    let mut b = take claimed
    failure_result_from_rep(history.history_claim_packet(mut b_buffers.packet, history.register_head(b)))?
    let HistoryApplied(_) = failure_result_from_rep(history.history_register_advance(mut second, mut b, metadata, mut b_buffers, due))? else {
        fail("second holder's CLAIM did not advance")
    }
    bucket_m2_law_commit_packet(mut a_buffers.packet, history.register_head(a), 2)?
    let orphan = history.history_new_ref(4, 1, a_buffers.packet)
    let refused = failure_result_from_rep(history.history_register_advance(mut first, mut a, metadata, mut a_buffers, due))
    if let Error(Fenced(1)) = refused {} else {
        fail("the stale holder's advance did not return Fenced")
    }
    bucket_m2_law_commit_packet(mut a_buffers.packet, history.register_head(a), 3)?
    if let Error(Fenced(1)) = failure_result_from_rep(history.history_register_advance(mut first, mut a, metadata, mut a_buffers, due)) {} else {
        fail("the stale holder lost its terminal error")
    }
    Ok((history.register_head(b).entry, orphan))
}


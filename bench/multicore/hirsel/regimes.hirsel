const LANES: u64 = 16
const TASK_BYTES: u64 = 65536

// Use the same xorshift recurrence in each port.
fn kernel(seed: u64, rounds: u64) -> u64 {
    let mut x = seed
    for _ in 0 .. rounds {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
    }
    x
}

type Work: cross {
    start: u64,
    count: u64,
    grain: u64,
}

fn compute(take job: Work) -> u64 {
    let mut sum = 0u64
    for i in 0 .. job.count {
        sum = int.wrapping_add(sum, kernel(job.start + i, job.grain))
    }
    sum
}

fn independent(tasks: Tasks, lanes: u64, waves: u64, grain: u64) -> u64 waits {
    let mut sum = 0u64
    for wave in 0 .. waves {
        let mut jobs: List[Task[u64]] = list.with_capacity(lanes)
        for lane in 0 .. lanes {
            let job = Work(start: 1 + wave * lanes + lane, count: 1, grain: grain)
            list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, job, compute)))
        }
        while let Some(take h) = list.pop(mut jobs) {
            sum = int.wrapping_add(sum, result.unwrap(task.join(take h)))
        }
    }
    sum
}

type Pair: cross {
    tasks: Tasks,
    work: Work,
}

type Stage: cross {
    ready: Client[Client[u64]],
    output: Client[u64],
    count: u64,
    grain: u64,
    cap: u64,
}

fn stage(take job: Stage) -> () waits {
    let (client, input): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(job.cap, bytes 0))
    result.unwrap(conn.send(job.ready, take client))
    for _ in 0 .. job.count {
        let value = result.unwrap(conn.receive(input))
        result.unwrap(conn.send(job.output, kernel(value, job.grain)))
    }
}

fn pair(take job: Pair) -> u64 waits {
    let (ready, senders): (Client[Client[u64]], Inbox[Client[u64]]) = result.unwrap(conn.new(1, bytes 0))
    let (out, reply): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    let child = Stage(ready: take ready, output: take out, count: job.work.count, grain: job.work.grain, cap: 1)
    let h = result.unwrap(task.spawn_unit(job.tasks, bytes TASK_BYTES, take child, stage))
    let tx = result.unwrap(conn.receive(senders))
    let mut sum = 0u64
    for i in 0 .. job.work.count {
        result.unwrap(conn.send(tx, job.work.start + i))
        sum = int.wrapping_add(sum, result.unwrap(conn.receive(reply)))
    }
    result.unwrap(task.join(take h))
    sum
}

fn chain(take job: Pair) -> u64 waits {
    let mut sum = 0u64
    for i in 0 .. job.work.count {
        let leaf = Work(start: job.work.start + i, count: 1, grain: job.work.grain)
        let h = result.unwrap(task.spawn_unit(job.tasks, bytes TASK_BYTES, leaf, compute))
        sum = int.wrapping_add(sum, result.unwrap(task.join(take h)))
    }
    sum
}

fn parallel_pairs(tasks: Tasks, count: u64, grain: u64, f: fn(take Pair) -> u64 waits) -> u64 waits {
    let mut jobs: List[Task[u64]] = list.new()
    for lane in 0 .. LANES {
        let job = Pair(tasks: tasks, work: Work(start: lane * count + 1, count: count, grain: grain))
        list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes 131072, job, f)))
    }
    let mut sum = 0u64
    while let Some(take h) = list.pop(mut jobs) {
        sum = int.wrapping_add(sum, result.unwrap(task.join(take h)))
    }
    sum
}

type Producer: cross {
    output: Client[u64],
    work: Work,
}

fn produce(take job: Producer) -> () waits {
    for i in 0 .. job.work.count {
        result.unwrap(conn.send(job.output, kernel(job.work.start + i, job.work.grain)))
    }
}

fn collect(input: Inbox[u64], count: u64) -> u64 waits {
    let mut sum = 0u64
    for _ in 0 .. count {
        sum = int.wrapping_add(sum, result.unwrap(conn.receive(input)))
    }
    sum
}

fn join_all(take pending: List[Task[()]]) waits {
    let mut jobs = take pending
    while let Some(take h) = list.pop(mut jobs) {
        result.unwrap(task.join(take h))
    }
}

fn fan_in(tasks: Tasks, count: u64, grain: u64) -> u64 waits {
    let (out, input): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(64, bytes 0))
    let mut jobs: List[Task[()]] = list.new()
    for lane in 0 .. LANES {
        let job = Producer(output: conn.client(out), work: Work(start: lane * count + 1, count: count, grain: grain))
        list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take job, produce)))
    }
    let sum = collect(input, LANES * count)
    join_all(take jobs)
    sum
}

type Dispatch: cross {
    ready: Client[Client[Client[u64]]],
    count: u64,
}

fn dispatch(take job: Dispatch) -> () waits {
    let (wiring, incoming): (Client[Client[u64]], Inbox[Client[u64]]) = result.unwrap(conn.new(LANES, bytes 0))
    result.unwrap(conn.send(job.ready, take wiring))
    let mut outputs: List[Client[u64]] = list.with_capacity(LANES)
    for _ in 0 .. LANES {
        list.push(mut outputs, result.unwrap(conn.receive(incoming)))
    }
    for i in 0 .. job.count {
        for lane in 0 .. LANES {
            result.unwrap(conn.send(outputs[lane], i * LANES + lane + 1))
        }
    }
}

fn fan_out(tasks: Tasks, count: u64, grain: u64) -> u64 waits {
    let (out, input): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(64, bytes 0))
    let (ready, senders): (Client[Client[u64]], Inbox[Client[u64]]) = result.unwrap(conn.new(1, bytes 0))
    let (dispatch_ready, dispatcher): (Client[Client[Client[u64]]], Inbox[Client[Client[u64]]]) = result.unwrap(conn.new(1, bytes 0))
    let mut jobs: List[Task[()]] = list.new()
    let job = Dispatch(ready: take dispatch_ready, count: count)
    list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take job, dispatch)))
    let wiring = result.unwrap(conn.receive(dispatcher))
    for _ in 0 .. LANES {
        let stage_job = Stage(ready: conn.client(ready), output: conn.client(out), count: count, grain: grain, cap: 64)
        list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take stage_job, stage)))
        result.unwrap(conn.send(wiring, result.unwrap(conn.receive(senders))))
    }
    let sum = collect(input, LANES * count)
    join_all(take jobs)
    sum
}

fn pipeline(tasks: Tasks, count: u64, grain: u64) -> u64 waits {
    let (out, input): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(64, bytes 0))
    let (ready, senders): (Client[Client[u64]], Inbox[Client[u64]]) = result.unwrap(conn.new(1, bytes 0))
    let mut next = take out
    let mut jobs: List[Task[()]] = list.new()
    for _ in 0 .. 8u64 {
        let job = Stage(ready: conn.client(ready), output: take next, count: count, grain: grain, cap: 64)
        list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take job, stage)))
        next = result.unwrap(conn.receive(senders))
    }
    let source = Producer(output: take next, work: Work(start: 1, count: count, grain: 0))
    list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take source, produce)))
    let sum = collect(input, count)
    join_all(take jobs)
    sum
}

type Branch: cross {
    tasks: Tasks,
    start: u64,
    leaves: u64,
    grain: u64,
}

fn tree(take job: Branch) -> u64 waits {
    if job.leaves == 1 { return kernel(job.start, job.grain) }
    let half = job.leaves / 2
    let left = Branch(tasks: job.tasks, start: job.start, leaves: half, grain: job.grain)
    let right = Branch(tasks: job.tasks, start: job.start + half, leaves: half, grain: job.grain)
    let allowance = (2 * half - 1) * (TASK_BYTES + 512)
    let a = result.unwrap(task.spawn_unit(job.tasks, bytes allowance, left, tree))
    let b = result.unwrap(task.spawn_unit(job.tasks, bytes allowance, right, tree))
    int.wrapping_add(result.unwrap(task.join(take a)), result.unwrap(task.join(take b)))
}

fn forest(tasks: Tasks, waves: u64, grain: u64) -> u64 waits {
    let mut sum = 0u64
    for wave in 0 .. waves {
        sum = int.wrapping_add(sum, tree(Branch(tasks: tasks, start: wave * 64 + 1, leaves: 64, grain: grain)))
    }
    sum
}

type Hub: cross {
    requests: Client[Client[Client[()]]],
    releases: Client[Client[()]],
    count: u64,
}

fn broker(take job: Hub) -> () waits {
    let (request, input): (Client[Client[()]], Inbox[Client[()]]) = result.unwrap(conn.new(1, bytes 0))
    let (release, released): (Client[()], Inbox[()]) = result.unwrap(conn.new(1, bytes 0))
    result.unwrap(conn.send(job.requests, take request))
    result.unwrap(conn.send(job.releases, take release))
    for _ in 0 .. job.count {
        let grant = result.unwrap(conn.receive(input))
        result.unwrap(conn.send(grant, ()))
        result.unwrap(conn.receive(released))
    }
}

type HubClient: cross {
    request: Client[Client[()]],
    release: Client[()],
    work: Work,
}

fn touch(take job: HubClient) -> u64 waits {
    let (grant, permit): (Client[()], Inbox[()]) = result.unwrap(conn.new(1, bytes 0))
    let mut sum = 0u64
    for i in 0 .. job.work.count {
        let value = kernel(job.work.start + i, job.work.grain)
        result.unwrap(conn.send(job.request, conn.client(grant)))
        result.unwrap(conn.receive(permit))
        sum = int.wrapping_add(sum, value)
        result.unwrap(conn.send(job.release, ()))
    }
    sum
}

fn hub(tasks: Tasks, count: u64, grain: u64) -> u64 waits {
    let (ready, requests): (Client[Client[Client[()]]], Inbox[Client[Client[()]]]) = result.unwrap(conn.new(1, bytes 0))
    let (ready_release, releases): (Client[Client[()]], Inbox[Client[()]]) = result.unwrap(conn.new(1, bytes 0))
    let job = Hub(requests: take ready, releases: take ready_release, count: LANES * count)
    let owner = result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take job, broker))
    let request = result.unwrap(conn.receive(requests))
    let release = result.unwrap(conn.receive(releases))
    let mut clients: List[Task[u64]] = list.new()
    for lane in 0 .. LANES {
        let client = HubClient(request: conn.client(request), release: conn.client(release),
                               work: Work(start: lane * count + 1, count: count, grain: grain))
        list.push(mut clients, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take client, touch)))
    }
    let mut sum = 0u64
    while let Some(take h) = list.pop(mut clients) {
        sum = int.wrapping_add(sum, result.unwrap(task.join(take h)))
    }
    result.unwrap(task.join(take owner))
    sum
}

type Shared: shareable + send {
    value: u64,
}

type ArcJob: send {
    shared: Arc[Shared],
    work: Work,
}

fn arc_worker(take job: ArcJob) -> u64 {
    let mut sum = 0u64
    for i in 0 .. job.work.count {
        let value = kernel(job.work.start + i, job.work.grain)
        let shared = arc.share(job.shared)
        sum = int.wrapping_add(sum, int.wrapping_add(value, shared.value))
    }
    sum
}

// Arc is unit-local. Keep all lanes' clones of the same allocation in
// one unit so the workload still exercises shared reference ownership.
fn arc_hub(take seed: Pair) -> u64 waits {
    let Pair(tasks: tasks, work: Work(start: _, count: count, grain: grain)) = take seed
    let shared = arc.new(Shared(value: 1))
    let mut jobs: List[Task[u64]] = list.new()
    for lane in 0 .. LANES {
        let job = ArcJob(shared: arc.share(shared), work: Work(start: lane * count + 1, count: count, grain: grain))
        list.push(mut jobs, task.spawn(tasks, bytes TASK_BYTES, take job, arc_worker))
    }
    let mut sum = 0u64
    while let Some(take h) = list.pop(mut jobs) {
        sum = int.wrapping_add(sum, result.unwrap(task.join(take h)))
    }
    sum
}

type Sleeper: cross {
    clock: Clock,
    id: u64,
    grain: u64,
    delay: u64,
}

fn sleeper(take job: Sleeper) -> (u64, u64) waits {
    let deadline = host.mono_ns(job.clock) + job.delay
    host.sleep_until(job.clock, deadline)
    let lag = int.saturating_sub(host.mono_ns(job.clock), deadline)
    (kernel(job.id, job.grain), lag)
}

type Hot: cross {
    pair: Pair,
    clock: Clock,
}

fn hot_pair(take job: Hot) -> (u64, u64) waits {
    let started = host.mono_ns(job.clock)
    let sum = pair(job.pair)
    (sum, host.mono_ns(job.clock) - started)
}

fn append(mut line: String, name: String, value: u64) {
    string.push(mut line, name)
    string.push_u64(mut line, value)
    string.push(mut line, "\n")
}

fn timers(tasks: Tasks, clock: Clock, err: Stderr, count: u64, grain: u64, hot: u64) -> u64 waits {
    let mut jobs: List[Task[(u64, u64)]] = list.with_capacity(count)
    let mut hot_tasks: List[Task[(u64, u64)]] = list.new()
    if hot != 0 {
        let work = Work(start: count + 1, count: hot, grain: grain)
        let job = Hot(pair: Pair(tasks: tasks, work: work), clock: clock)
        list.push(mut hot_tasks, result.unwrap(task.spawn_unit(tasks, bytes 131072, job, hot_pair)))
    }
    for i in 0 .. count {
        let job = Sleeper(clock: clock, id: i + 1, grain: if hot == 0 { grain } else { 0 },
                          delay: 2000000 + i * 1000)
        list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes 8192, job, sleeper)))
    }
    let mut sum = 0u64
    let mut lag = 0u64
    let mut worst = 0u64
    while let Some(take h) = list.pop(mut jobs) {
        let (value, ns) = result.unwrap(task.join(take h))
        sum = int.wrapping_add(sum, value)
        lag += ns
        if ns > worst { worst = ns }
    }
    let mut line = string.new()
    if let Some(take h) = list.pop(mut hot_tasks) {
        let (value, elapsed) = result.unwrap(task.join(take h))
        sum = int.wrapping_add(sum, value)
        append(mut line, "hot-ns=", elapsed)
    }
    append(mut line, "wake-mean-ns=", lag / count)
    append(mut line, "wake-max-ns=", worst)
    result.unwrap(stderr.write(err, line))
    sum
}

fn run(tasks: Tasks, clock: Clock, err: Stderr, name: String, count: u64, grain: u64) -> (u64, u64) waits {
    let first = Work(start: 1, count: count, grain: grain)
    let job = Pair(tasks: tasks, work: first)
    if name == "independent16" {
        (count * 16, independent(tasks, 16, count, grain))
    } else if name == "independent256" {
        (count * 256, independent(tasks, 256, count, grain))
    } else if name == "pairs" {
        (count * LANES, parallel_pairs(tasks, count, grain, pair))
    } else if name == "single_pair" {
        (count, pair(job))
    } else if name == "fanin" {
        (count * LANES, fan_in(tasks, count, grain))
    } else if name == "fanout" {
        (count * LANES, fan_out(tasks, count, grain))
    } else if name == "pipeline" {
        (count, pipeline(tasks, count, grain))
    } else if name == "grain_spawn_join" {
        (count, chain(job))
    } else if name == "grain_spawn_chain" {
        (count * LANES, parallel_pairs(tasks, count, grain, chain))
    } else if name == "spawn_tree" {
        (count * 64, forest(tasks, count, grain))
    } else if name == "channel_hub" {
        (count * LANES, hub(tasks, count, grain))
    } else if name == "arc_hub" {
        let shared = result.unwrap(task.spawn_unit(tasks, bytes (LANES + 1) * TASK_BYTES, job, arc_hub))
        (count * LANES, result.unwrap(task.join(take shared)))
    } else if name == "skew" {
        (count + 1000, timers(tasks, clock, err, 1000, grain, count))
    } else if name == "timers" {
        (count, timers(tasks, clock, err, count, grain, 0))
    } else if name == "calibrate" {
        let started = host.mono_ns(clock)
        let sum = compute(first)
        let mut line = string.new()
        append(mut line, "kernel-ns=", host.mono_ns(clock) - started)
        result.unwrap(stderr.write(err, line))
        (count, sum)
    } else {
        fail("unknown grain workload")
    }
}

type Connection: cross {
    socket: Socket,
    count: u64,
    grain: u64,
}

fn serve(take job: Connection) -> u64 waits {
    let Connection(socket: take socket, count: count, grain: grain) = take job
    let (reader, writer) = net.split(take socket)
    let mut input = take reader
    let mut output = take writer
    let mut buffer: Bytes = list.with_capacity(8)
    let mut sum = 0u64
    for _ in 0 .. count {
        list.clear(mut buffer)
        while list.len(buffer) < 8 {
            let left = 8 - list.len(buffer)
            let received = result.unwrap(host.recv_bounded(mut input, mut buffer, left, Never))
            if received == 0 { fail("socket closed during request") }
        }
        let mut value = 0u64
        for i in 0 .. 8u64 {
            value |= int.wrapping_shl(int.widen(buffer[i]), int.narrow(i * 8))
        }
        let mixed = kernel(value, grain)
        sum = int.wrapping_add(sum, mixed)
        list.clear(mut buffer)
        for i in 0 .. 8u64 {
            list.push(mut buffer, int.truncate(mixed >> (8 * i)))
        }
        let mut sent = 0u64
        while sent < 8 {
            let written = result.unwrap(host.send_pair(mut output, list.slice(buffer, sent, 8), string.as_bytes(""), Never))
            if written == 0 { fail("socket closed during reply") }
            sent += written
        }
    }
    sum
}

fn sockets(tasks: Tasks, net: Net, err: Stderr, port: u16, connections: u64, count: u64, grain: u64) -> u64 waits {
    let (take listener, address) = result.unwrap(host.listen(net, Addr(ip: V4(0x7f000001), port: port), 128))
    let mut line = string.new()
    append(mut line, "listening=", int.widen(address.port))
    result.unwrap(stderr.write(err, line))
    let mut input = take listener
    let mut jobs: List[Task[u64]] = list.new()
    for _ in 0 .. connections {
        let (take socket, _) = result.unwrap(host.accept(mut input, Never))
        let job = Connection(socket: take socket, count: count, grain: grain)
        list.push(mut jobs, result.unwrap(task.spawn_unit(tasks, bytes TASK_BYTES, take job, serve)))
    }
    let mut sum = 0u64
    while let Some(take h) = list.pop(mut jobs) {
        sum = int.wrapping_add(sum, result.unwrap(task.join(take h)))
    }
    sum
}

fn receipt(completed: u64, sum: u64) -> String {
    let mut line = string.new()
    string.push_u64(mut line, completed)
    string.push(mut line, " ")
    string.push_u64(mut line, sum)
    string.push(mut line, "\n")
    line
}

pub fn main(tasks: Tasks, net: Net, clock: Clock, dir: Dir, out: Stdout, err: Stderr, argv: Args) -> Result[(), Exit] waits {
    let Some(name) = args.get(argv, 0) else { return Error(Exit(status: 2)) }
    let Some(size) = args.get(argv, 1) else { return Error(Exit(status: 2)) }
    let Some(rounds) = args.get(argv, 2) else { return Error(Exit(status: 2)) }
    let count: u64 = result.unwrap(int.parse(size))
    let grain: u64 = result.unwrap(int.parse(rounds))
    if name == "socket_server" {
        let Some(port) = args.get(argv, 3) else { return Error(Exit(status: 2)) }
        let Some(clients) = args.get(argv, 4) else { return Error(Exit(status: 2)) }
        let connections: u64 = result.unwrap(int.parse(clients))
        let sum = sockets(tasks, net, err, result.unwrap(int.parse(port)), connections, count, grain)
        result.unwrap(stdout.write(out, receipt(connections * count, sum)))
        return Ok(())
    }
    let (completed, sum) = run(tasks, clock, err, name, count, grain)
    result.unwrap(stdout.write(out, receipt(completed, sum)))
    Ok(())
}

// rule: MODE-6
// expect: run
fn note(r: Recorder[u64], x: u64) -> () {
  recorder.append(r, x)
}

pub fn main(t: Test) -> Result[(), ()] {
  let r: Recorder[u64] = recorder.new()
  note(r, 1)
  recorder.append(r, 2u64)
  let xs: List[u64] = recorder.finish(take r)
  test.check(t, list.len(xs) == 2)
  test.check(t, xs[1] == 2)
  Ok(())
}

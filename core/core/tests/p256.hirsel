// Record 4 in the same section.
fn nist_record_4() -> (Bytes, Bytes, Bytes) {
    (b"\x04\xe4\x24\xdc\x61\xd4\xbb\x3c\xb7\xef\x43\x44\xa7\xf8\x95\x7a\x0c\x51\x34\xe1\x6f\x7a\x67\xc0\x74\xf8\x2e\x6e\x12\xf4\x9a\xbf\x3c\x97\x0e\xed\x7a\xa2\xbc\x48\x65\x15\x45\x94\x9d\xe1\xdd\xda\xf0\x12\x7e\x59\x65\xac\x85\xd1\x24\x3d\x6f\x60\xe7\xdf\xae\xe9\x27", b"\xe1\x13\x0a\xf6\xa3\x8c\xcb\x41\x2a\x9c\x8d\x13\xe1\x5d\xbf\xc9\xe6\x9a\x16\x38\x5a\xf3\xc3\xf1\xe5\xda\x95\x4f\xd5\xe7\xc4\x5f\xd7\x5e\x2b\x8c\x36\x69\x92\x28\xe9\x28\x40\xc0\x56\x2f\xbf\x37\x72\xf0\x7e\x17\xf1\xad\xd5\x65\x88\xdd\x45\xf7\x45\x0e\x12\x17\xad\x23\x99\x22\xdd\x9c\x32\x69\x5d\xc7\x1f\xf2\x42\x4c\xa0\xde\xc1\x32\x1a\xa4\x70\x64\xa0\x44\xb7\xfe\x3c\x2b\x97\xd0\x3c\xe4\x70\xa5\x92\x30\x4c\x5e\xf2\x1e\xed\x9f\x93\xda\x56\xbb\x23\x2d\x1e\xeb\x00\x35\xf9\xbf\x0d\xfa\xfd\xcc\x46\x06\x27\x2b\x20\xa3", b"\xbf\x96\xb9\x9a\xa4\x9c\x70\x5c\x91\x0b\xe3\x31\x42\x01\x7c\x64\x2f\xf5\x40\xc7\x63\x49\xb9\xda\xb7\x2f\x98\x1f\xd9\x34\x7f\x4f\x17\xc5\x50\x95\x81\x90\x89\xc2\xe0\x3b\x9c\xd4\x15\xab\xdf\x12\x44\x4e\x32\x30\x75\xd9\x8f\x31\x92\x0b\x9e\x0f\x57\xec\x87\x1c")

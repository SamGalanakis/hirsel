// The issued-id log and read set survive a typed error.
pub fn rollback_writes_on_error[R, E](mut tx: Tx, body: scoped[view] fn(mut Tx) -> Result[R, E]) -> Result[R, E] {
    txn.freeze(mut tx.inner)
    let staged = {
        let mut draft = Tx(inner: txn.fork_tx(tx.inner), info: tx.info)
        let result = body(mut draft)
        let Tx(inner: take ready, ..) = take draft
        txn.drafted_tx(take ready, take result)
    }
    txn.install(mut tx.inner, take staged)
}

// An overrun drops the private work and restores the frozen overlay.
pub fn rollback_writes_on_overrun[R, E](mut tx: Tx, steps: u64, body: scoped[view] fn(mut Tx) -> Result[R, E]) -> Result[Result[R, E], OutOfTime] {
    txn.freeze(mut tx.inner)
    let ran: Result[txn.Drafted[R, E], OutOfTime] = {
        let work = Tx(inner: txn.fork_tx(tx.inner), info: tx.info)
        match (bound steps steps {
            let mut draft = take work
            let result = body(mut draft)
            let Tx(inner: take ready, ..) = take draft
            (take ready, take result)
        }) {
            Ok((take ready, take result)) => Ok(txn.drafted_tx(take ready, take result)),
            Error(limit) => Error(limit),
        }
    }
    match take ran {
        Ok(take staged) => Ok(txn.install(mut tx.inner, take staged)),
        Error(limit) => {
            txn.restore_frozen(mut tx.inner)
            Error(limit)
        },
    }
}

/// Delete and return the first row in the table's encoded key order.
pub fn pop_first[K, V](mut tx: Tx, t: Table[K, V]) -> Result[Option[(K, V)], Error] {
    pop_table_edge(mut tx, t, false)
}

/// Delete and return the last row in the table's encoded key order.
pub fn pop_last[K, V](mut tx: Tx, t: Table[K, V]) -> Result[Option[(K, V)], Error] {
    pop_table_edge(mut tx, t, true)
}

fn pop_table_edge[K, V](mut tx: Tx, t: Table[K, V], reverse: bool) -> Result[Option[(K, V)], Error] {
    let indexes = check_table_write(tx, t)?
    let low = lower_bytes(t.id, Unbounded, false)?
    let high = lower_bytes(t.id, Unbounded, true)?
    let (take row, take candidate): (Option[(Bytes, Arc[Bytes])], Option[txn.TxView]) = if let Some(take tiered) = failure_result_from_rep(txn.tx_tiered_rows(tx.inner, t.id, low, high, true))? {
        let mut cursor = take tiered
        (next_tiered_in(txn.tx_roots(tx.inner).collections, txn.tx_attempt(tx.inner), txn.tx_pins(tx.inner), cursor.collection, cursor.staged, mut cursor.from, mut cursor.to, reverse)?, None)
    } else {
        let mut cached = failure_result_from_rep(txn.current_tx_view(tx.inner))?
        let row = failure_result_from_rep(txn.pop_tx_view_edge(mut cached, t.id, low, reverse))?
        (take row, Some(take cached))
    }
    let Some((take key, take raw)) = take row else {
        if let Some(take cached) = take candidate {
            cell.set(txn.tx_view_tree(tx.inner), Some(take cached))
        }
        failure_result_from_rep(txn.note_read(tx.inner, Span(take low, take high)))?
        return Ok(None)
    }
    if reverse {
        failure_result_from_rep(txn.note_read(tx.inner, Span(failure_result_from_rep(types.copied(key))?, take high)))?
    } else {
        let mut after = failure_result_from_rep(types.copied(key))?
        list.push(mut after, 0u8)
        failure_result_from_rep(txn.note_read(tx.inner, Span(take low, take after)))?
    }
    let k = failure_result_from_rep(catalog.decoded(std.codec.decode_key(t.key, list.slice(key, 4, list.len(key)))))?
    let v = row_value(t.readers, t.id, raw)?
    let plan = failure_result_from_rep(txn.plan_delete(tx.inner, t.id, t.readers.current, indexes, key, raw))?
    let popped = if let Some(take cached) = take candidate {
        cell.set(txn.tx_view_tree(tx.inner), Some(take cached))
        true
    } else {
        false
    }
    if let Error(take e) = failure_result_from_rep(txn.apply_delete_plan(mut tx.inner, take key, take plan, popped, point_event)) {
        if popped {
            cell.set(txn.tx_view_tree(tx.inner), None)
        }
        return Error(take e)
    }
    Ok(Some((take k, take v)))
}

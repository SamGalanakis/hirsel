// RTC-4 re-offers and renegotiation: the SSRCs a session announces, the answer it takes
// and the agreement it installs.
/// Set the source Opus parameters on a down-track. A changed wire value needs a re-offer.
pub fn set_opus_fmtp(mut p: PeerSession, track: u16, fmtp: Bytes) -> bool {
    let Some(i) = track_index(p, track) else {
        return false
    }
    let si: u64 = int.widen(p.tracks[i].section)
    if si >= list.len(p.agreed.sections) {
        return false
    }
    p.tracks[i].opus_fmtp = Some(clone(fmtp))
    if let Some((_, sent)) = p.offered {
        if si < list.len(sent.sections) {
            return opus_fmtp_differs(sent.sections[si], fmtp)
        }
    }
    opus_fmtp_differs(p.agreed.sections[si].local, fmtp)
}

/// Whether the browser holds another track's `a=ssrc` on this down-track's section:
/// the offer in flight, or else the agreement in force, announces SSRCs and not the
/// track's own. A reused section needs a re-offer (RTC-2, RTC-4), since a MID with
/// signaled SSRCs does not take an unsignaled one.
pub fn ssrc_stale(p: PeerSession, track: u16) -> bool {
    let Some(i) = track_index(p, track) else {
        return false
    }
    let si: u64 = int.widen(p.tracks[i].section)
    if let Some((_, sent)) = p.offered {
        if si < list.len(sent.sections) {
            return stale_in(sent.sections[si].ssrcs, p.tracks[i].ssrc)
        }
    }
    si < list.len(p.agreed.sections) && stale_in(p.agreed.sections[si].local.ssrcs, p.tracks[i].ssrc)
}

fn stale_in(announced: List[u32], ssrc: u32) -> bool {
    if list.len(announced) == 0 {
        return false
    }
    for x in announced {
        if x == ssrc {
            return false
        }
    }
    true
}

fn opus_fmtp_differs(s: sdp.Section, fmtp: Bytes) -> bool {
    for f in s.formats {
        if f.codec == Opus {
            return list.compare_bytes(f.fmtp, fmtp) != Equal
        }
    }
    false
}

/// RTC-4's re-offer gives each sending section its down-track's current SSRCs
/// (RTC-2) and source Opus fmtp. It returns the next origin version. The offer stays in
/// flight until `answer_reoffer` takes its answer. While one is in flight no other is
/// made: the answer is `None`, and `reoffer_due` holds until that answer is taken.
pub fn reoffer(mut p: PeerSession, policy: sdp.Policy, mut text: Bytes) -> Result[Option[u64], PeerError] {
    if p.closed {
        return Error(Closed)
    }
    if let Some(_) = p.offered {
        p.reoffer_due = true
        return Ok(None)
    }
    p.reoffer_due = false
    let mut current: sdp.Negotiated = clone(p.agreed)
    // Rebuild the local announcements from the tracks still present.
    for si in 0u64 .. list.len(current.sections) {
        list.clear(mut current.sections[si].local.ssrcs)
        list.clear(mut current.sections[si].local.rtx_pairs)
        list.clear(mut current.sections[si].local.fec_pairs)
    }
    for t in p.tracks {
        let si: u64 = int.widen(t.section)
        if si >= list.len(current.sections) {
            continue
        }
        if let Some(fmtp) = t.opus_fmtp {
            for i in 0u64 .. list.len(current.sections[si].local.formats) {
                if current.sections[si].local.formats[i].codec == Opus {
                    current.sections[si].local.formats[i].fmtp = clone(fmtp)
                    break
                }
            }
        }
        list.push(mut current.sections[si].local.ssrcs, t.ssrc)
        if let Some(rtx) = t.rtx {
            list.push(mut current.sections[si].local.rtx_pairs, (t.ssrc, rtx.ssrc))
            list.push(mut current.sections[si].local.ssrcs, rtx.ssrc)
        }
        if let Some(fec) = t.fec {
            list.push(mut current.sections[si].local.fec_pairs, (t.ssrc, fec.ssrc))
            list.push(mut current.sections[si].local.ssrcs, fec.ssrc)
        }
    }
    current.local.origin_version += 1
    let mut d = sdp.description()
    sdp.offer(policy, current, current.local, list.new(), mut d) ?=> |take e| Sdp(e)
    list.clear(mut text)
    let _ = sdp.write(d, mut text) ?=> |take e| Sdp(e)
    let version = d.origin_version
    p.offered = Some((version, take d))
    Ok(Some(version))
}

/// Whether track `track` has an RTX or FlexFEC SSRC that the agreement in force does not
/// pair with its media SSRC (`a=ssrc-group:FID` or `FEC-FR`), so the router re-offers
/// (RTC-4). A track with neither, audio or video without RTX, needs no re-offer: the
/// browser takes its media by MID.
pub fn unannounced(p: PeerSession, track: u16) -> bool {
    let Some(t) = track_index(p, track) else {
        return false
    }
    let si: u64 = int.widen(p.tracks[t].section)
    let local = p.sections[si].agreed.local
    let ssrc = p.tracks[t].ssrc
    let rtx_missing = match p.tracks[t].rtx {
        Some(rtx) => !paired(local.rtx_pairs, (ssrc, rtx.ssrc)),
        None => false,
    }
    let fec_missing = match p.tracks[t].fec {
        Some(fec) => !paired(local.fec_pairs, (ssrc, fec.ssrc)),
        None => false,
    }
    rtx_missing || fec_missing
}

fn paired(pairs: List[(u32, u32)], pair: (u32, u32)) -> bool {
    for x in pairs {
        if x == pair {
            return true
        }
    }
    false
}

/// Whether a re-offer was asked for while another was in flight (RTC-4).
pub fn reoffer_due(p: PeerSession) -> bool {
    if let Some(_) = p.offered {
        return false
    }
    p.reoffer_due
}

/// Take the answer to the re-offer in flight. One that answers no offer in flight, names
/// another version, does not parse or does not match the offer is refused (RTC-4) and
/// changes nothing here: the caller revokes the participant, which closes the session,
/// and the participant renegotiates by rejoining. A matching answer installs the agreement.
pub fn answer_reoffer(mut p: PeerSession, version: u64, text: Bytes) -> Result[(), PeerError] {
    if p.closed {
        return Error(Closed)
    }
    let Some((v, take sent)) = replace(mut p.offered, None) else {
        return Error(Sdp(AnswerMismatch(0)))
    }
    if v != version {
        return Error(Sdp(AnswerMismatch(0)))
    }
    let mut remote = sdp.description()
    sdp.parse(text, mut remote) ?=> |take e| Sdp(e)
    let mut agreed = sdp.negotiated(p.agreed.local)
    sdp.accept_answer(p.agreed, sent, remote, mut agreed) ?=> |take e| Sdp(e)
    renegotiated(mut p, agreed)
}

/// Install a renegotiated agreement. Bindings of sections no longer receiving go.
pub fn renegotiated(mut p: PeerSession, agreed: sdp.Negotiated) -> Result[(), PeerError] {
    if p.closed {
        return Error(Closed)
    }
    let sections = build_sections(agreed, p.limits)?
    p.sections = take sections
    p.agreed = clone(agreed)
    let mut kept: List[Inbound] = list.new()
    let old = replace(mut p.inbound, list.new())
    for take i in take old {
        let si: u64 = int.widen(i.section)
        if si < list.len(p.sections) && p.sections[si].agreed.recv {
            list.push(mut kept, take i)
        }
    }
    p.inbound = take kept
    Ok(())
}

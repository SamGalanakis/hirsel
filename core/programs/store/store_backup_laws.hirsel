// Store 1.5 backup and restore laws (STORE-SPEC §15.5, CLOUD #4).
fn backup_law_delete(mut db: Db, t: Table[u64, u64], k: u64) -> bool waits {
    let out = run(mut db, None, (copy_env(k), copy_env(t)), fn(mut tx, call_env) -> Result[(), Error] {
        let _ = delete(mut tx, call_env.1, call_env.0)?
        Ok(())
    })
    match take out {
        Ok(Committed(_)) => true,
        _ => false
    }
}

// Both ways: every row of `t` at `left` is at `right` in the same key order
// with the same value, and `right` has no extra row.
fn backup_law_same_rows(left: Db, at_left: Snapshot, right: Db, at_right: Snapshot, t: Table[u64, u64], twin_table: Table[u64, u64]) -> Result[u64, DeployError] waits {
    let left_reader = result.unwrap(reader(left, 0u64))
    let right_reader = result.unwrap(reader(right, 0u64))
    let mut expected = deploy_result(scan(left_reader, at_left, t, Unbounded, Unbounded))?
    let mut actual = deploy_result(scan(right_reader, at_right, twin_table, Unbounded, Unbounded))?
    let mut matched = 0u64
    loop {
        let want = deploy_result(next(left_reader, mut expected))?
        let got = deploy_result(next(right_reader, mut actual))?
        if want != got {
            return Error(ExportMismatch)
        }
        if want == None {
            return Ok(matched)
        }
        matched = matched + 1
    }
}

// Full-scan both-ways check over every index entry in key order.
fn backup_law_same_index(left: Db, at_left: Snapshot, right: Db, at_right: Snapshot, ix: Index[u64, u64, u64, ()], twin_index: Index[u64, u64, u64, ()]) -> Result[u64, DeployError] waits {
    let mut expected = deploy_result(find(result.unwrap(reader(left, 0u64)), at_left, ix, Unbounded, Unbounded))?
    let mut actual = deploy_result(find(result.unwrap(reader(right, 0u64)), at_right, twin_index, Unbounded, Unbounded))?
    let mut matched = 0u64
    loop {
        let want = deploy_result(next(law_reader(expected.capture), mut expected))?
        let got = deploy_result(next(law_reader(actual.capture), mut actual))?
        if want != got {
            return Error(ExportMismatch)
        }
        if want == None {
            return Ok(matched)
        }
        matched = matched + 1
    }
}

// Full-scan both-ways check over every retained log entry in sequence order.
fn backup_law_same_log(left: Db, at_left: Snapshot, right: Db, at_right: Snapshot, l: Log[u64], twin_log: Log[u64]) -> Result[u64, DeployError] waits {
    let left_reader = result.unwrap(reader(left, 0u64))
    let right_reader = result.unwrap(reader(right, 0u64))
    let mut expected = deploy_result(log_scan(left_reader, at_left, l, Unbounded, Unbounded))?
    let mut actual = deploy_result(log_scan(right_reader, at_right, twin_log, Unbounded, Unbounded))?
    let mut matched = 0u64
    loop {
        let want = deploy_result(next(left_reader, mut expected))?
        let got = deploy_result(next(right_reader, mut actual))?
        if want != got {
            return Error(ExportMismatch)
        }
        if want == None {
            return Ok(matched)
        }
        matched = matched + 1
    }
}

fn backup_law_cell_set(mut db: Db, cell_handle: Cell[u64], v: u64) -> bool waits {
    let out = run(mut db, None, (copy_env(cell_handle), copy_env(v)), fn(mut tx, call_env) -> Result[(), Error] {
        cell_set(mut tx, call_env.0, call_env.1)
    })
    match take out {
        Ok(Committed(_)) => true,
        _ => false
    }
}

fn backup_law_log_edit(mut db: Db, l: Log[u64], first: u64, n_items: u64, trim: Option[u64]) -> bool waits {
    let log_handle: Log[u64] = clone(l)
    let out = run(mut db, None, (take log_handle, first, n_items, trim), fn(mut tx, call_env) -> Result[(), Error] {
        for i in 0u64 .. call_env.2 {
            let _ = append(mut tx, call_env.0, call_env.1 + i)?
        }
        if let Some(before) = call_env.3 {
            trim_before(mut tx, call_env.0, before)?
        }
        Ok(())
    })
    match take out {
        Ok(Committed(_)) => true,
        _ => false
    }
}

fn backup_law_schema(mut schema: Declare) -> Result[(Table[u64, u64], Index[u64, u64, u64, ()], Table[u64, u64], Cell[u64], Log[u64]), Error] {
    let key = std.codec.key_u64()
    let value = std.codec.of_u64()
    let mut declared_items = declare_table(mut schema, "items", key, value)?
    let ix = index(mut schema, mut declared_items, "bucket", Many, code.describe(bucket_keys), key)?
    let items = finish(mut schema, take declared_items)?
    let declared_other = declare_table(mut schema, "other", key, value)?
    let other = finish(mut schema, take declared_other)?
    let meta = declare_cell(mut schema, "meta", value)?
    let events = declare_log(mut schema, "events", value, Forever)?
    Ok((items, ix, other, meta, events))
}

fn backup_law_check_logical(source: Db, leased: Snapshot, twin: Db, now: Snapshot, items: Table[u64, u64], ix: Index[u64, u64, u64, ()], other: Table[u64, u64], meta: Cell[u64], events: Log[u64], twin_handles: (Table[u64, u64], Index[u64, u64, u64, ()], Table[u64, u64], Cell[u64], Log[u64]), expect_items: u64, expect_other: u64, expect_log: u64) -> Result[(), DeployError] waits {
    if version(now) != version(leased) || twin.store == source.store {
        return Error(ExportMismatch)
    }
    if backup_law_same_rows(source, leased, twin, now, items, twin_handles.0)? != expect_items || backup_law_same_rows(source, leased, twin, now, other, twin_handles.2)? != expect_other {
        return Error(ExportMismatch)
    }
    if backup_law_same_index(source, leased, twin, now, ix, twin_handles.1)? != expect_items {
        return Error(ExportMismatch)
    }
    let want_meta = deploy_result(cell_get(result.unwrap(reader(source, 0u64)), leased, meta))?
    let got_meta = deploy_result(cell_get(result.unwrap(reader(twin, 0u64)), now, twin_handles.3))?
    if want_meta != got_meta {
        return Error(ExportMismatch)
    }
    if backup_law_same_log(source, leased, twin, now, events, twin_handles.4)? != expect_log {
        return Error(ExportMismatch)
    }
    Ok(())
}

fn backup_law_seed(tasks: Tasks, source: Dir, c: Clock, r: Random, options: Options) -> Result[(), DeployError] waits {
    let mut db = deploy_result(open(tasks, source, c, r, options))?
    let mut schema = deploy_result(declare(db, Migrate))?
    let (items, _, other, meta, events) = deploy_result(backup_law_schema(mut schema))?
    let _ = deploy_result(seal(mut db, take schema))?
    for k in 0u64 .. 40 {
        if !typed_put(mut db, items, k, k * 3) || !typed_put(mut db, other, k * 7, k) {
            return Error(ExportMismatch)
        }
        if k == 19 {
            let _ = deploy_result(checkpoint(mut db))?
        }
    }
    if !backup_law_delete(mut db, items, 5) || !typed_put(mut db, items, 6, 1000) || !backup_law_cell_set(mut db, meta, 77u64) || !backup_law_log_edit(mut db, events, 100u64, 5u64, Some(2u64)) {
        return Error(ExportMismatch)
    }
    deploy_result(close(take db))
}

// L89 (§15.5, CLOUD #4). A restored backup opens as an ordinary store and equals its
// source at the leased head across every table, index, cell and log, whatever the source
// wrote, deleted or checkpointed after the lease.
@test
fn journal_test_backup_restore(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let source = disk_test_directory(d)
    let target = disk_test_directory(d)
    let restored = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 1048576
    // The first open writes, checkpoints, deletes and overwrites, then closes.
    // The reopen rotates to a new segment with no checkpoint, so the backup
    // holds a finished segment (no END file) before its terminal one.
    backup_law_seed(tasks, source, c, r, options)?
    let mut db = deploy_result(open(tasks, source, c, r, options))?
    let mut schema = deploy_result(declare(db, Open))?
    let (items, ix, other, meta, events) = deploy_result(backup_law_schema(mut schema))?
    let _ = deploy_result(seal(mut db, take schema))?
    if !typed_put(mut db, other, 1000, 1) || !typed_put(mut db, items, 7, 2000) || !backup_law_log_edit(mut db, events, 200u64, 2u64, None) {
        return Error(ExportMismatch)
    }
    let leased = snapshot(db)
    let mut attempt: Bytes = list.with_capacity(16)
    list.fill(mut attempt, 16, 3u8)
    let job = begin_backup(mut db, target, result.unwrap(failure_result_from_rep(types.copied(attempt))))?
    match begin_backup(mut db, restored, result.unwrap(failure_result_from_rep(types.copied(attempt)))) {
        Error(AttemptBusy) => (),
        _ => return Error(ExportMismatch),
    }
    // Writes after the lease land in the leased terminal segment and, after
    // the checkpoint, in a new MANIFEST. Neither belongs to the backup.
    for k in 40u64 .. 50 {
        if !typed_put(mut db, items, k, k) || !typed_put(mut db, items, k - 40, 7) {
            return Error(ExportMismatch)
        }
    }
    if !backup_law_delete(mut db, other, 0) || !backup_law_cell_set(mut db, meta, 999u64) || !backup_law_log_edit(mut db, events, 300u64, 3u64, Some(4u64)) {
        return Error(ExportMismatch)
    }
    let _ = deploy_result(checkpoint(mut db))?
    if !typed_put(mut db, other, 1, 1) {
        return Error(ExportMismatch)
    }
    let copied_backup = export_copy(take job)?
    let mut segments = 0u64
    for listed in result.unwrap(std.dir.list(target, None)) {
        if string.starts_with(listed.name, "j-") {
            segments = segments + 1
        }
    }
    if segments < 2 {
        return Error(ExportMismatch)
    }
    release_export(mut db, attempt)
    if copied_backup.stamp.head != version(leased) {
        return Error(ExportMismatch)
    }
    match deploy_result(open(tasks, target, c, r, options)) {
        Error(Store(ExportDirectory)) => (),
        _ => return Error(ExportMismatch),
    }
    match begin_backup(mut db, source, result.unwrap(failure_result_from_rep(types.copied(attempt)))) {
        Error(Scratch(Exists(_))) => (),
        _ => return Error(ExportMismatch),
    }
    let stamp = restore(tasks, target, restored, c, r, options, Latest, restore_attempt(r))?
    if stamp.point.main_version != version(leased) || stamp.child == db.store {
        return Error(ExportMismatch)
    }
    let mut twin = deploy_result(open(tasks, restored, c, r, options))?
    let mut twin_schema = deploy_result(declare(twin, Open))?
    let twin_handles = deploy_result(backup_law_schema(mut twin_schema))?
    let _ = deploy_result(seal(mut twin, take twin_schema))?
    let now = snapshot(twin)
    backup_law_check_logical(db, leased, twin, now, items, ix, other, meta, events, twin_handles, 39u64, 41u64, 5u64)?
    let gone = disk_test_directory(d)
    disk_io_deploy(host.remove(target, "EXPORT"))?
    match restore(tasks, target, gone, c, r, options, Latest, restore_attempt(r)) {
        Error(Scratch(Io(NotFound))) => (),
        _ => return Error(ExportMismatch),
    }
    deploy_result(close(take twin))?
    deploy_result(close(take db))
}

fn bucket_backup_restore_body(d: Dir, c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), DeployError] waits {
    let target = disk_test_directory(d)
    let restored = disk_test_directory(d)
    let mut bucket_options = bucket_law_options(true)
    bucket_options.group_bytes = 65536
    bucket_options.head_poll_ms = 10000
    let authority = deploy_result(bucket_law_authority(sim, tasks, "s3.test", 1))?
    let mut db = open_authority(tasks, take authority, c, r, bucket_options) ?=> |Refusal(error: take problem, ..)| Store(take problem)
    let mut schema = deploy_result(declare(db, Migrate))?
    let (items, ix, other, meta, events) = deploy_result(backup_law_schema(mut schema))?
    let _ = deploy_result(seal(mut db, take schema))?
    for k in 0u64 .. 24 {
        if !typed_put(mut db, items, k, k * 5) || !typed_put(mut db, other, k * 3, k + 10) {
            return Error(ExportMismatch)
        }
        if k == 11 {
            let _ = deploy_result(checkpoint(mut db))?
        }
    }
    if !backup_law_delete(mut db, items, 4) || !typed_put(mut db, items, 6, 4242) || !backup_law_cell_set(mut db, meta, 55u64) || !backup_law_log_edit(mut db, events, 10u64, 4u64, Some(1u64)) {
        return Error(ExportMismatch)
    }
    let leased = snapshot(db)
    let mut attempt: Bytes = list.with_capacity(16)
    list.fill(mut attempt, 16, 9u8)
    let job = begin_backup(mut db, target, result.unwrap(failure_result_from_rep(types.copied(attempt))))?
    // Post-lease mutations and checkpoint on the live Bucket writer must not appear in the restore.
    if !typed_put(mut db, items, 99, 99) || !backup_law_delete(mut db, other, 0) || !backup_law_cell_set(mut db, meta, 888u64) || !backup_law_log_edit(mut db, events, 50u64, 2u64, Some(2u64)) {
        return Error(ExportMismatch)
    }
    let _ = deploy_result(checkpoint(mut db))?
    let copied_backup = export_copy(take job)?
    release_export(mut db, attempt)
    if copied_backup.stamp.head != version(leased) {
        return Error(ExportMismatch)
    }
    let dir_options = result.unwrap(sized(Directory, 2147483648u64))
    let stamp = restore(tasks, target, restored, c, r, dir_options, Latest, restore_attempt(r))?
    if stamp.point.main_version != version(leased) || stamp.child == db.store {
        return Error(ExportMismatch)
    }
    let mut twin = deploy_result(open(tasks, restored, c, r, dir_options))?
    let mut twin_schema = deploy_result(declare(twin, Open))?
    let twin_handles = deploy_result(backup_law_schema(mut twin_schema))?
    let _ = deploy_result(seal(mut twin, take twin_schema))?
    let now = snapshot(twin)
    backup_law_check_logical(db, leased, twin, now, items, ix, other, meta, events, twin_handles, 23u64, 24u64, 3u64)?
    deploy_result(close(take twin))?
    deploy_result(close(take db))
}

// CLOUD #4: full-scan restore verification for a Bucket backup restored into a Directory store.
@test
fn bucket_test_backup_restore_full_scan(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let sim = bucket_law_sim(tasks, c, 20263, None, list.new())
    let outcome = bucket_backup_restore_body(d, c, r, tasks, sim)
    let _ = bucket_law_finish(take sim)
    outcome
}

fn disk_io_deploy(take r: Result[(), IoError]) -> Result[(), DeployError] {
    scratch_result(failure_result_from_rep(manifest.disk_io(r)))
}

fn offline_law_copy(source: Dir, target: Dir, c: Clock) -> Result[Option[(ExportStamp, u64)], BackupError] waits {
    let (take prepared, _) = prepare_backup(source, target, c) ?=> BackupDeploy
    backup_offline(take prepared, b"backup-law-3079!")
}

fn offline_law_write(mut db: Db, t: Table[u64, Bytes], k: u64, value: Bytes) -> Result[(), Error] waits {
    let written = run(mut db, None, (copy_env(t), k, copy_env(value)), fn(mut tx, args) -> Result[(), Error] {
        put(mut tx, args.0, args.1, args.2)
    })?
    let Committed(done) = written else {
        fail("backup fixture did not commit")
    }
    durable(mut db, done.ticket)
}

fn backup_residual_fence(d: Dir, c: Clock, r: Random, tasks: Tasks, options: Options) -> Result[(), Error] waits {
    let source = disk_test_directory(d)
    let target = disk_test_directory(d)
    let restored = disk_test_directory(d)
    let mut db = open(tasks, source, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let mut wide: Bytes = list.with_capacity(150000)
    list.fill(mut wide, 150000, 23u8)
    offline_law_write(mut db, rows, 0, wide)?
    let _ = checkpoint(mut db)?
    offline_law_write(mut db, rows, 1, b"one")?
    let stale = file_end(db)
    offline_law_write(mut db, rows, 2, b"two")?
    offline_law_write(mut db, rows, 3, b"three")?
    let head = version(snapshot(db))
    let recovered_end = file_end(db)
    let id = db.store
    let seq = file_seq(db)
    let terminal = failure_result_from_rep(manifest.journal_path(seq, ""))?
    let end_file = failure_result_from_rep(manifest.journal_path(seq, ".end"))?
    close(take db)?
    failure_result_from_rep(manifest.disk_write_synced(source, end_file, journal_end_bytes(id, seq, stale)))?
    let original_manifest = failure_result_from_rep(manifest.read_page_manifest_bytes(source))?
    let original_terminal = failure_result_from_rep(manifest.disk_io(host.stat(source, terminal)))?
    let mut fence = failure_result_from_rep(manifest.disk_io(host.open(source, terminal, ReadWrite)))?
    if !failure_result_from_rep(manifest.disk_io(host.try_lock(mut fence)))? {
        fail("backup fixture could not fence the terminal")
    }
    let exclusive = task.spawn(tasks, bytes 134217728, (source, target, c), fn(take work: (Dir, Dir, Clock)) -> Result[Option[(ExportStamp, u64)], BackupError] waits {
        offline_law_copy(work.0, work.1, work.2)
    })
    let mut probe = failure_result_from_rep(manifest.disk_io(host.open(source, "LOCK", Read)))?
    while failure_result_from_rep(manifest.disk_io(host.try_lock(mut probe)))? {
        failure_result_from_rep(manifest.disk_io(host.unlock(mut probe)))?
        std.clock.sleep_ns(c, 1000000)
    }
    if failure_result_from_rep(journal.disk_exists(target, "EXPORT"))? {
        fail("backup stamped while the terminal fence was held")
    }
    failure_result_from_rep(manifest.disk_io(host.unlock(mut fence)))?
    let Some((stamp, _)) = result.unwrap(result.unwrap(task.join(take exclusive))) else {
        fail("locked recovery routed a valid terminal to the writer")
    }
    if stamp.head != head || stamp.opened != seq || stamp.terminal != seq || stamp.end != recovered_end {
        fail("backup did not stamp the recovered terminal and head")
    }
    if failure_result_from_rep(manifest.disk_io(host.stat(source, terminal)))?.size != original_terminal.size || failure_result_from_rep(journal.disk_end(source, store_key_to_rep(id), seq))? != Some(stale) || failure_result_from_rep(manifest.read_page_manifest_bytes(source))? != original_manifest {
        fail("backup changed the source")
    }
    let _ = result.unwrap(restore(tasks, target, restored, c, r, options, Latest, restore_attempt(r)))
    let twin = open(tasks, restored, c, r, options)?
    let restored_rows = system_table(twin, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let read = reader(twin, 0)?
    let snap = snapshot(twin)
    if version(snap) != head || get(read, snap, restored_rows, 0u64)? != Some(wide) || get(read, snap, restored_rows, 1u64)? != Some(b"one") || get(read, snap, restored_rows, 2u64)? != Some(b"two") || get(read, snap, restored_rows, 3u64)? != Some(b"three") {
        fail("restore lost a checkpointed blob or a recovered suffix row")
    }
    close(take twin)
}

fn backup_writer_route(d: Dir, c: Clock, r: Random, tasks: Tasks, options: Options, orphan: bool) -> Result[(), Error] waits {
    let source = disk_test_directory(d)
    let target = disk_test_directory(d)
    let restored = disk_test_directory(d)
    let mut db = open(tasks, source, c, r, options)?
    if orphan {
        let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
        let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
        if !typed_put(mut db, rows, 1, 91) {
            fail("orphan pin fixture failed to write its row")
        }
        let held = snapshot(db)
        let change = change_pin(mut db, ImportPin, "import", held)?
        durable(mut db, change)?
        let (_, take page_record) = read_page_manifest_file(source)?
        if list.len(page_record.pins) != 1 || page_record.pins[0].owner != ImportPin {
            fail("orphan pin fixture failed to publish the import pin")
        }
    }
    let head = version(snapshot(db))
    let seq = file_seq(db)
    close(take db)?
    if !orphan {
        let _ = failure_result_from_rep(manifest.disk_remove_optional(source, failure_result_from_rep(manifest.journal_path(seq, ".end"))?))?
        failure_result_from_rep(manifest.disk_write_synced(source, failure_result_from_rep(manifest.journal_path(seq, ""))?, b""))?
    }
    if let Some(_) = result.unwrap(offline_law_copy(source, target, c)) {
        fail("the offline backup bypassed the writer fallback")
    }
    if failure_result_from_rep(journal.disk_exists(target, "EXPORT"))? {
        fail("a writer fallback published an offline stamp")
    }
    let stamp = result.unwrap(backup_with_writer(tasks, source, target, c, r, clone(options), b"backup-law-3079!"))
    let (_, take page_record) = read_page_manifest_file(target)?
    if stamp.head != head || list.len(page_record.pins) != 0 {
        fail("writer backup lost the head or retained the orphan import pin")
    }
    let _ = result.unwrap(restore(tasks, target, restored, c, r, options, Latest, restore_attempt(r)))
    let twin = open(tasks, restored, c, r, options)?
    let snap = snapshot(twin)
    if version(snap) != head {
        fail("writer backup restored a different head")
    }
    if orphan {
        let rows = system_table(twin, "rows", std.codec.key_u64(), std.codec.of_u64())?
        if get(reader(twin, 0)?, snap, rows, 1u64)? != Some(91u64) {
            fail("writer backup lost the row covered by the orphan import pin")
        }
    }
    close(take twin)
}

fn backup_mutilations(d: Dir, c: Clock, r: Random, tasks: Tasks, options: Options) -> Result[(), Error] waits {
    let source = disk_test_directory(d)
    let target = disk_test_directory(d)
    let restored = disk_test_directory(d)
    result.unwrap(backup_law_seed(tasks, source, c, r, options))
    let (id, take page_record) = read_page_manifest_file(source)?
    let mut packs = capture.capture_packs(source, store_key_to_rep(id), page_record, false, 0)
    let counts = failure_result_from_rep(capture.capture_lists(mut packs, page_record))?
    let inventory = failure_result_from_rep(capture.check_inventory(source, store_key_to_rep(id), page_record, counts.rows + counts.pages))?
    let mut listed: Option[u64] = None
    for candidate in inventory {
        if candidate.class == 0 {
            listed = Some(candidate.seq)
            break
        }
    }
    let Some(seq) = listed else {
        fail("backup fixture needs a listed data pack")
    }
    let pack = failure_result_from_rep(manifest.paged_pack_path(seq))?
    let extra = "p-99999999"
    let temp = "p-99999999.tmp"
    failure_result_from_rep(manifest.disk_write_synced(source, extra, b"stray"))?
    failure_result_from_rep(manifest.disk_write_synced(source, temp, b"temporary"))?
    let Some((stamp, _)) = result.unwrap(offline_law_copy(source, target, c)) else {
        fail("backup refused a store with an unlisted pack")
    }
    if failure_result_from_rep(journal.disk_exists(target, extra))? || failure_result_from_rep(journal.disk_exists(target, temp))? || !failure_result_from_rep(journal.disk_exists(source, extra))? || !failure_result_from_rep(journal.disk_exists(source, temp))? {
        fail("backup copied or removed unlisted files")
    }
    failure_result_from_rep(manifest.disk_write_synced(target, extra, b"stray"))?
    failure_result_from_rep(manifest.disk_write_synced(target, temp, b"temporary"))?
    let restored_stamp = result.unwrap(restore(tasks, target, restored, c, r, options, Latest, restore_attempt(r)))
    if restored_stamp.point.main_version != stamp.head || restored_stamp.point.token.parent != StoreId(hi: stamp.store_hi, lo: stamp.store_lo) || restored_stamp.child == restored_stamp.point.token.parent || failure_result_from_rep(journal.disk_exists(restored, extra))? || failure_result_from_rep(journal.disk_exists(restored, temp))? {
        fail("restore copied unlisted files or changed the stamp")
    }
    let raw = failure_result_from_rep(manifest.disk_read_file(source, pack, 1048576))?
    for damage in 0u64 .. 3 {
        let output = disk_test_directory(d)
        let incomplete = disk_test_directory(d)
        for at in[source, target] {
            if damage == 2 {
                failure_result_from_rep(manifest.disk_io(host.rename(at, pack, "p-99999998")))?
            } else {
                failure_result_from_rep(manifest.disk_io(host.remove(at, pack)))?
                if damage == 1 {
                    failure_result_from_rep(manifest.disk_write_synced(at, pack, list.slice(raw, 0, 73)))?
                }
            }
        }
        match offline_law_copy(source, output, c) {
            Error(BackupCheck(CheckStore(Corrupt(found)))) if found.file == pack => match found.why {
                Truncated if damage == 1 => (),
                Absent if damage != 1 => (),
                _ => fail("backup reported the wrong pack fault"),
            },
            _ => fail("backup accepted a mutilated listed pack"),
        }
        match restore(tasks, target, incomplete, c, r, options, Latest, restore_attempt(r)) {
            Error(Store(Corrupt(found))) if found.file == pack => match found.why {
                Truncated if damage == 1 => (),
                Absent if damage != 1 => (),
                _ => fail("restore reported the wrong pack fault"),
            },
            _ => fail("restore accepted a mutilated listed pack"),
        }
        if failure_result_from_rep(journal.disk_exists(output, "EXPORT"))? || !failure_result_from_rep(journal.disk_exists(incomplete, "EXPORT"))? {
            fail("a refused copy published an openable image")
        }
        for at in[source, target] {
            if damage == 2 {
                failure_result_from_rep(manifest.disk_io(host.rename(at, "p-99999998", pack)))?
            } else {
                failure_result_from_rep(manifest.disk_write_synced(at, pack, raw))?
            }
        }
    }
    Ok(())
}

@test
fn backup_offline_routes_and_packs(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut options = result.unwrap(sized(Directory, 268435456))
    options.pack_bytes = 1048576
    backup_residual_fence(d, c, r, tasks, options)?
    backup_writer_route(d, c, r, tasks, options, true)?
    backup_writer_route(d, c, r, tasks, options, false)?
    backup_mutilations(d, c, r, tasks, options)
}

fn l96_memory_exact_and_below(tasks: Tasks, r: Random, target: Dir, d: Dir, c: Clock, options: Options, resident_exact: u64) -> Result[(), DeployError] waits {
    let mut exact_opts: Options = clone(options)
    exact_opts.resident_limit = resident_exact
    let restored_ok = disk_test_directory(d)
    let _stamp = restore(tasks, target, restored_ok, c, r, exact_opts, Latest, restore_attempt(r))?
    let mut below_opts: Options = clone(options)
    below_opts.resident_limit = resident_exact - 1
    let restored_bad = disk_test_directory(d)
    match restore(tasks, target, restored_bad, c, r, below_opts, Latest, restore_attempt(r)) {
        Error(Store(Full(Resident(Capacity(requested, available))))) if requested == resident_exact && available == resident_exact - 1 => (),
        _ => return Error(ExportMismatch),
    }
    if !deploy_result(failure_result_from_rep(journal.disk_exists(restored_bad, "EXPORT")))? {
        return Error(ExportMismatch)
    }
    Ok(())
}

// L96 (e) Memory half (DESIGN-v2 §2.2, §6): Memory-only store + repeated-class-2
// fixture keep exact lease list, R4 resident figure, exact vs one-below
// Full(Resident(Capacity)) fields, and tight copy task budget.
@test
fn test_l96_memory_backup_admission_and_budget(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let source = disk_test_directory(d)
    let target = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 65536
    backup_law_seed(tasks, source, c, r, options)?
    let mut db = deploy_result(open(tasks, source, c, r, options))?
    let mut schema = deploy_result(declare(db, Open))?
    let (items, _, _, _, _) = deploy_result(backup_law_schema(mut schema))?
    let _ = deploy_result(seal(mut db, take schema))?
    // Produce several packs across cuts so the pack list holds multiple rows
    // and class-2 packs carry multiple list pages.
    for round in 0u64 .. 6 {
        for i in 0u64 .. 16 {
            if !typed_put(mut db, items, 200 + round * 16 + i, round * 100 + i) {
                return Error(ExportMismatch)
            }
        }
        let _ = deploy_result(checkpoint(mut db))?
    }
    let resident_exact = db.accounting.resident
    let want_packs = manifest.live_pack_sequences(manifest.pack_locations(disk_state(db).packs))
    let mut attempt: Bytes = list.with_capacity(16)
    list.fill(mut attempt, 16, 17u8)
    let job = begin_backup(mut db, target, result.unwrap(failure_result_from_rep(types.copied(attempt))))?
    let leased_ok = match transfer.active_lease(disk_state(db).transfer) {
        Some(held_lease) => held_lease.packs == want_packs,
        None => false,
    }
    if !leased_ok {
        return Error(ExportMismatch)
    }
    let _ = export_copy(take job)?
    release_export(mut db, attempt)
    l96_memory_exact_and_below(tasks, r, target, d, c, options, resident_exact)?
    // Tight copy task budget: binary-search the exact byte boundary for the
    // spawned copy task and verify exact passes while exact - 1 fails.
    let mut low = 0u64
    let mut high = 4194304u64
    while low < high {
        let mid = low + (high - low) / 2
        let probe_dir = disk_test_directory(d)
        let probe_job = begin_backup(mut db, probe_dir, result.unwrap(failure_result_from_rep(types.copied(attempt))))?
        let passed = match task.try_spawn(tasks, bytes mid, take probe_job, export_copy) {
            Ok(take running) => match task.join(take running) {
                Ok(Ok(_)) => true,
                Ok(Error(_)) => return Error(ExportMismatch),
                Error(_) => false,
            },
            Error(_) => false,
        }
        release_export(mut db, attempt)
        if passed {
            high = mid
        } else {
            low = mid + 1
        }
    }
    if low == 0 || low >= 4194304 {
        return Error(ExportMismatch)
    }
    let exact_dir = disk_test_directory(d)
    let exact_job = begin_backup(mut db, exact_dir, result.unwrap(failure_result_from_rep(types.copied(attempt))))?
    let exact_ok = match task.try_spawn(tasks, bytes low, take exact_job, export_copy) {
        Ok(take running) => match task.join(take running) {
            Ok(Ok(_)) => true,
            _ => false,
        },
        Error(_) => false,
    }
    release_export(mut db, attempt)
    if !exact_ok {
        return Error(ExportMismatch)
    }
    let below = low - 1
    let below_dir = disk_test_directory(d)
    let below_job = begin_backup(mut db, below_dir, result.unwrap(failure_result_from_rep(types.copied(attempt))))?
    let below_failed = match task.try_spawn(tasks, bytes below, take below_job, export_copy) {
        Ok(take running) => match task.join(take running) {
            Error(_) => true,
            _ => false,
        },
        Error(_) => true,
    }
    release_export(mut db, attempt)
    if !below_failed {
        return Error(ExportMismatch)
    }
    deploy_result(close(take db))
}

type Q5Operation: send = GenesisWrite | ClaimWrite | ActivationWrite

type Q5Fault: send = AfterBody | BeforeBody | OvertakeDrop | OvertakeApply | Retry500 | ExhaustBeforeBody

type Q5Actor: send {
    operation: Q5Operation,
    dir: Dir,
    clock: Clock,
    tasks: Tasks,
    r: Random,
    endpoint: std.sim.s3.Endpoint
}

type Q5Observation: send {
    outcome: Result[u64, DeployError],
    digest: Option[Inline[u8, 32]]
}

fn q5_actor(take trial: Q5Actor) -> Q5Observation waits {
    if let ActivationWrite = trial.operation {
        return q5_install(trial)
    }
    let create = match trial.operation {
        GenesisWrite => true,
        _ => false
    }
    let observed = q5_open(trial, create)
    Q5Observation(outcome: take observed, digest: None)
}

fn q5_open(trial: Q5Actor, create: bool) -> Result[u64, DeployError] waits {
    let opened = deploy_result(bucket_order_open(trial.tasks, trial.r, trial.clock, trial.endpoint, 21, create))?
    let epoch = deploy_result(claim_of(opened))?.epoch
    deploy_result(close(take opened))?
    Ok(epoch)
}

fn q5_install(trial: Q5Actor) -> Q5Observation waits {
    let (take observed, digest) = q5_prepared_activation(trial)
    Q5Observation(outcome: take observed, digest)
}

fn q5_seed_activation(mut db: Db, tasks: Tasks, prior: Bytes) -> Result[(), DeployError] waits {
    let mut staged = deploy_result(install_old(db))?
    deploy_result(stage_activation(mut staged, 1, None, prior, std.codec.of_bytes(), prior))?
    deploy_result(install_bound_activation(mut db, take staged, 1, prior))?
    let rows = deploy_result(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    if !typed_put(mut db, rows, 7, 14) || !typed_put(mut db, rows, 8, 15) {
        fail("L54-M: could not write the two exported versions")
    }
    Ok(())
}

fn q5_prepared_activation(trial: Q5Actor) -> (Result[u64, DeployError], Option[Inline[u8, 32]]) waits {
    let starting = bucket_order_open(trial.tasks, trial.r, trial.clock, trial.endpoint, 21, true)
    let mut db = match take starting {
        Ok(take opened) => take opened,
        Error(take problem) => return (Error(Store(take problem)), None),
    }
    let prior = install_fixture_bytes(32, 65)
    if let Error(take problem) = q5_seed_activation(mut db, trial.tasks, prior) {
        return (Error(take problem), None)
    }
    let attempt = install_fixture_bytes(16, 2)
    let staged = stage_object_preparation(mut db, trial.dir, trial.clock, trial.tasks, attempt, 2097152)
    let digest = match take staged {
        Ok(ready_digest) => ready_digest,
        Error(take problem) => return (Error(take problem), None),
    }
    let request = Cutover(attempt: take attempt, digest, deadline: 0xffffffffffffffffu64)
    let installed = perform_bound_cutover(mut db, request, 1, prior, std.codec.of_bytes(), prepared_release_witness,[66; 32], fn() -> bool {
        true
    })
    (take installed, Some(digest))
}

type Q5Site {
    connection: u64,
    nth: u64,
    reads: u64
}

fn q5_selects(operation: Q5Operation, head_bytes: Bytes) -> bool {
    let epoch = format.read_le(head_bytes, 88, 8)
    let sequence = format.read_le(head_bytes, 120, 8)
    match operation {
        GenesisWrite => epoch == 1 && sequence == 1,
        ClaimWrite => epoch == 2 && sequence == 2,
        ActivationWrite => epoch == 1 && sequence == 7 && format.read_le(head_bytes, 112, 8) == 4,
    }
}

fn q5_locate_site(operation: Q5Operation, report: std.sim.s3.Report) -> Q5Site {
    for event in report.head_writes {
        if q5_selects(operation, event.data) {
            let mut sends = 0u64
            let mut reads = 0u64
            for req in report.requests {
                if req.key != "head" {
                    continue
                }
                if req.method == "GET" {
                    reads += 1
                }
                if req.method == "PUT" {
                    sends += 1
                }
                if req.request == event.request {
                    return Q5Site(connection: event.request, nth: sends, reads)
                }
            }
        }
    }
    fail("L54-M: clean setup never attempted the target head write")
}

fn q5_incumbent(tasks: Tasks, r: Random, sim: BucketSim, operation: Q5Operation) -> Result[(), DeployError] waits {
    if let ClaimWrite = operation {
        let incumbent = deploy_result(bucket_order_open(tasks, r, sim.time, sim.endpoint, 19, true))?
        deploy_result(close(take incumbent))?
    }
    Ok(())
}

fn q5_clean_site(d: Dir, c: Clock, r: Random, tasks: Tasks, seed: u64, operation: Q5Operation) -> Result[Q5Site, DeployError] waits {
    let sim = bucket_law_sim(tasks, c, seed, None, list.new())
    q5_incumbent(tasks, r, sim, operation)?
    let trial = Q5Actor(operation, dir: disk_test_directory(d), clock: sim.time, tasks, r, endpoint: sim.endpoint)
    let tested = q5_actor(take trial)
    let Q5Observation(outcome: take outcome, ..) = take tested
    outcome?
    deploy_result(trust_bucket_sim(tasks, sim, "s3.test"))?
    let report = bucket_law_finish(take sim)
    Ok(q5_locate_site(operation, report))
}

fn q5_fixture(c: Clock, tasks: Tasks, seed: u64, site: Q5Site, fault: Q5Fault) -> BucketSim {
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(2)
    list.push(mut faults, Clean)
    list.push(mut faults, match fault {
        AfterBody => ResetAfterBody,
        BeforeBody => ResetBeforeBody,
        ExhaustBeforeBody => ResetBeforeBody,
        Retry500 => InternalError,
        _ => Clean,
    })
    let mut words: List[u64] = list.with_capacity(2 * (site.connection + 64))
    for i in 1u64 .. site.connection + 65 {
        let inject = i == site.connection || (i >= site.connection && i - site.connection < 5 && q5_exhausts(fault))
        list.push(mut words, if inject {
            1u64 << 63
        } else {
            0u64
        })
        list.push(mut words, seed)
    }
    let mut streams: List[List[u64]] = list.with_capacity(1)
    list.push(mut streams, take words)
    let plan = std.sim.world.plan_from(std.sim.world.Script(tail_seed: seed, streams: take streams), 0)
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    match fault {
        OvertakeDrop => list.push(mut holds, std.sim.s3.Hold(method: "PUT", key: "head", from: site.nth, count: 1, until: Applied("PUT", "head", site.nth + 1), then: Drop)),
        OvertakeApply => list.push(mut holds, std.sim.s3.Hold(method: "PUT", key: "head", from: site.nth, count: 1, until: Requested("GET", "head", site.reads + 1), then: ApplyLoseReply)),
        _ => (),
    }
    bucket_law_sim_holds(tasks, c, seed, None, take faults, take holds, take plan)
}

fn q5_exhausts(fault: Q5Fault) -> bool {
    match fault {
        ExhaustBeforeBody => true,
        _ => false
    }
}

fn q5_races(fault: Q5Fault) -> bool {
    match fault {
        OvertakeDrop => true,
        OvertakeApply => true,
        _ => false,
    }
}

fn q5_reconcile(tasks: Tasks, sim: BucketSim, digest: Option[Inline[u8, 32]], applied_during_claim: bool, plan: FollowerPlan) -> Result[(), DeployError] waits {
    let authority = deploy_result(bucket_law_authority(sim, tasks, "s3.test", 23))?
    let mut ids = followers()
    let owner = bucket_law_start_followers(tasks, plan, 1, "L54-M activation reconciliation service")
    let handle = deploy_result(follower_owner(owner))?
    let slot = deploy_result(follower_slot(handle, plan))?
    let mirror = deploy_result(follower(mut ids, take slot, take authority, sim.time, None))?
    let captured = deploy_result(follower_head(mirror))?
    let image = deploy_result(snapshot_follower(mirror, Branch(store: captured.store, id: 0)))?
    let read = deploy_result(follower_reader(mirror, 0))?
    let mut schema = declare_follower(mirror)
    let rows = deploy_result(declare_release_table(mut schema, std.codec.of_bytes()))?
    let mut primary = deploy_result(declare_table(mut schema, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    if applied_during_claim {
        let _ = deploy_result(index(mut schema, mut primary, "by_v", Many, code.describe(crash_value), std.codec.key_u64()))?
    }
    let _ = deploy_result(finish(mut schema, take primary))?
    let mut secondary = deploy_result(declare_table(mut schema, "other", std.codec.key_u64(), std.codec.of_u64()))?
    if applied_during_claim {
        let _ = deploy_result(index(mut schema, mut secondary, "empty", Many, code.describe(crash_value), std.codec.key_u64()))?
    }
    let _ = deploy_result(finish(mut schema, take secondary))?
    if applied_during_claim {
        let added = deploy_result(declare_table(mut schema, "added", std.codec.key_u64(), std.codec.of_u64()))?
        let _ = deploy_result(finish(mut schema, take added))?
    }
    deploy_result(seal_follower(mirror, take schema))?
    let witness = deploy_result(get(read, image, rows, 4))?
    let wanted: Option[Bytes] = if applied_during_claim {
        Some(release_witness(option.unwrap(digest)))
    } else {
        None
    }
    let expected_activation = if applied_during_claim {
        4u64
    } else {
        1u64
    }
    if witness != wanted || captured.activation != expected_activation {
        fail("L54-M: the cold activation witness disagreed with the register")
    }
    Ok(())
}

fn q5_fault_check(report: std.sim.s3.Report, site: Q5Site, fault: Q5Fault) {
    if q5_races(fault) {
        return
    }
    let expected: u16 = match fault {
        AfterBody => 200,
        Retry500 => 500,
        _ => 0,
    }
    let mut injected = 0u64
    let last_connection = if q5_exhausts(fault) {
        site.connection + 4
    } else {
        site.connection
    }
    for req in report.requests {
        if req.request >= site.connection && req.request <= last_connection && req.key == "head" && req.method == "PUT" && req.status == expected {
            injected += 1
        }
    }
    if injected != last_connection - site.connection + 1 {
        fail("L54-M: the fault tape missed its selected head write")
    }
}

fn q5_verify(operation: Q5Operation, fault: Q5Fault, observed: Q5Observation, report: std.sim.s3.Report) -> Result[(), DeployError] {
    if q5_races(fault) {
        match (operation, view observed.outcome) {
            (ActivationWrite, Error(Store(Fenced(1)))) => (),
            (GenesisWrite, Error(Store(Lost))) => (),
            // The other claimant is the same Store, a validated successor (§12.3).
            (ClaimWrite, Error(Store(Superseded(actual)))) => {
                let final_write = report.head_writes[list.len(report.head_writes) - 1]
                let won = result.unwrap(failure_result_from_rep(history.history_decode_head(final_write.data))).head.pair
                if !history_claim_matches_pair(actual, won) {
                    fail("L54-M: Superseded did not name the claimant that won")
                }
            },
            _ => fail("L54-M: an overtaken attempt returned the wrong outcome"),
        }
        return Ok(())
    }
    let mut recorded_target = false
    for event in report.head_writes {
        if q5_selects(operation, event.data) {
            recorded_target = true
        }
    }
    if q5_exhausts(fault) {
        match observed.outcome {
            Error(Store(Remote(_))) if !recorded_target => return Ok(()),
            _ => fail("L54-M: exhausting only pre-body resets must leave the old head and return Remote"),
        }
    }
    let expected = match operation {
        GenesisWrite => 1u64,
        ClaimWrite => 2u64,
        ActivationWrite => 4u64,
    }
    match observed.outcome {
        Ok(n) if n == expected && recorded_target => Ok(()),
        _ => fail("L54-M: success did not match the register's applied bytes"),
    }
}

fn q5_case(d: Dir, c: Clock, r: Random, tasks: Tasks, seed: u64, operation: Q5Operation, site: Q5Site, fault: Q5Fault, plan: FollowerPlan) -> Result[(), DeployError] waits {
    let sim = q5_fixture(c, tasks, seed, site, fault)
    q5_incumbent(tasks, r, sim, operation)?
    let trial = Q5Actor(operation, dir: disk_test_directory(d), clock: sim.time, tasks, r, endpoint: sim.endpoint)
    let running = task.spawn(tasks, bytes 50331648, take trial, q5_actor)
    let recovered: Option[Db] = if q5_races(fault) {
        result.unwrap(std.sim.s3.requested(sim.endpoint, "PUT", "head", site.nth))
        let create = match operation {
            GenesisWrite => true,
            _ => false
        }
        Some(deploy_result(bucket_order_open(tasks, r, sim.time, sim.endpoint, 22, create))?)
    } else {
        None
    }
    let observed = result.unwrap(task.join(take running))
    if let Some(take successor) = take recovered {
        deploy_result(close(take successor))?
        if let ActivationWrite = operation {
            q5_reconcile(tasks, sim, observed.digest, q5_applies(fault), plan)?
        }
    }
    let report = bucket_law_finish(take sim)
    q5_fault_check(report, site, fault)
    q5_verify(operation, fault, observed, report)?
    deploy_result(trust_bucket_report(report))
}

fn q5_applies(fault: Q5Fault) -> bool {
    match fault {
        OvertakeApply => true,
        _ => false
    }
}

type GenesisPhase: send = AfterManifest | AfterCheckpoint | ConcurrentList

fn genesis_debris_case(d: Dir, real: Clock, tasks: Tasks, seed: u64, phase: GenesisPhase) -> Result[(), DeployError] waits {
    let first_seed = 1u64
    let second_seed = 2u64
    let predict = provide.random(first_seed)
    let _ = failure_result_from_rep(types.capacity(types.disk_identity(predict))) ?=> Store
    let identity_bytes = failure_result_from_rep(types.capacity(types.disk_identity(predict))) ?=> Store
    let mut manifest: Bytes = list.new()
    let manifest_ref = deploy_result(failure_result_from_rep(history.history_manifest_packet(mut manifest, store_key_to_rep(store_key_from_rep(identity_bytes)), 1, limits_to_rep(default_limits()))))?
    let mut entry_bytes: Bytes = list.new()
    let no_packs = history.HistoryLocateRoot(depth: 0, rows: list.new())
    let checkpoint_ref = deploy_result(failure_result_from_rep(history.history_genesis_packet(mut entry_bytes, store_key_to_rep(store_key_from_rep(identity_bytes)), 1, manifest_ref, no_packs)))?
    let manifest_name = history.history_key("m-", manifest_ref)
    let entry_name = history.history_key("e-", checkpoint_ref)
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    let hold = match phase {
        AfterManifest => std.sim.s3.Hold(method: "PUT", key: clone(entry_name), from: 1, count: 1, until: Never, then: Drop),
        AfterCheckpoint => std.sim.s3.Hold(method: "PUT", key: "head", from: 1, count: 1, until: Never, then: Drop),
        ConcurrentList => std.sim.s3.Hold(method: "LIST", key: "", from: 1, count: 1, until: Applied("PUT", clone(entry_name), 1), then: Apply),
    }
    list.push(mut holds, take hold)
    let sim = bucket_law_sim_holds(tasks, real, seed, None, list.new(), take holds, std.sim.world.plan(seed))
    let first = Q5Actor(operation: GenesisWrite, dir: d, clock: sim.time, tasks, r: provide.random(first_seed), endpoint: sim.endpoint)
    let second = Q5Actor(operation: GenesisWrite, dir: d, clock: sim.time, tasks, r: provide.random(second_seed), endpoint: sim.endpoint)
    match phase {
        ConcurrentList => {
            let queued = task.spawn(tasks, bytes 33554432, take second, q5_actor)
            result.unwrap(std.sim.s3.requested(sim.endpoint, "LIST", "", 1))
            let original = q5_actor(take first)
            let challenger = result.unwrap(task.join(take queued))
            match (view original.outcome, view challenger.outcome) {
                (Ok(1), Error(Store(Lost))) => (),
                (Error(Store(Lost)), Ok(1)) => (),
                _ => fail("L54-G: concurrent genesis did not complete one epoch-1 open"),
            }
        },
        _ => {
            let mut running = task.spawn(tasks, bytes 33554432, take first, q5_actor)
            let parked_key: String = match phase {
                AfterManifest => string.from(entry_name),
                _ => string.from("head")
            }
            result.unwrap(std.sim.s3.requested(sim.endpoint, "PUT", parked_key, 1))
            task.cancel(mut running)
            let _ = task.join(take running)
            if q5_open(second, true)? != 1 {
                fail("L54-G: the completing open did not create epoch 1")
            }
        },
    }
    deploy_result(trust_bucket_sim(tasks, sim, "s3.test"))?
    let report = bucket_law_finish(take sim)
    if list.len(report.head_writes) != 2 || !q5_selects(GenesisWrite, report.head_writes[0].data) {
        fail("L54-G: the register did not record exactly one genesis and its claim")
    }
    let mut left_manifest = false
    let mut left_checkpoint = false
    let mut debris_listed = false
    for req in report.requests {
        if req.method == "PUT" && req.applied && req.key == manifest_name {
            left_manifest = true
        }
        if req.method == "PUT" && req.applied && req.key == entry_name {
            left_checkpoint = true
        }
        if req.method == "LIST" && req.status == 200 && left_manifest && left_checkpoint {
            debris_listed = true
        }
    }
    if !left_manifest {
        fail("L54-G: the first creator never applied its manifest")
    }
    match phase {
        AfterManifest if left_checkpoint => fail("L54-G: the first creator's checkpoint survived the cut"),
        AfterCheckpoint if !left_checkpoint => fail("L54-G: the test cut preceded the checkpoint"),
        ConcurrentList if !debris_listed => fail("L54-G: the second LIST did not observe both debris objects"),
        _ => (),
    }
    Ok(())
}

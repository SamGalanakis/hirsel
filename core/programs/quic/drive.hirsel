// QUIC-10's driver: the thin IO loop over one NET-16 socket or group member. Its batch
// buffers live in the endpoint and are sized on first use.
/// Datagrams one drive call sends or receives at most.
const DRIVE_BATCH: u64 = 64

/// Receive room per datagram: NET-16's smallest slot payload.
const DRIVE_SLOT: u64 = 1280

/// One round: run due timers, poll and hand the whole batch to one udp_send (waiting for
/// the first send_at still ahead), commit what it took, then one udp_recv batch until the
/// endpoint's next deadline or `until`, each datagram to receive_datagram. A truncated
/// UdpPacket is dropped and counted. Polling first means data written between calls
/// leaves on the next call, not after a receive wait.
pub fn drive(mut e: Endpoint, clock: Clock, mut sock: UdpSocket, until: u64, mut events: List[Event]) -> Result[(), NetError] waits {
    let now = host.mono_ns(clock)
    timeout(mut e, now, mut events)
    let mut out = replace(mut e.drive_out, b"")
    if list.capacity(out) < DRIVE_BATCH * MSS {
        out = list.with_capacity(DRIVE_BATCH * MSS)
    }
    list.clear(mut out)
    let mut tx = replace(mut e.drive_tx, list.new())
    if list.capacity(tx) < DRIVE_BATCH + 1 {
        tx = list.with_capacity(DRIVE_BATCH + 1)
    }
    list.clear(mut tx)
    let mut udp = replace(mut e.drive_udp, list.new())
    if list.capacity(udp) < DRIVE_BATCH {
        udp = list.with_capacity(DRIVE_BATCH)
    }
    list.clear(mut udp)
    let _ = poll(mut e, now, mut out, mut tx)
    let mut wait = now
    for o in tx {
        if let Transmit(to: to, at: at, len: len, ecn: ecn, send_at: send_at) = o {
            list.push(mut udp, UdpTx(to, at: at, len: len, ecn: ecn))
            if wait == now && send_at > now {
                wait = send_at
            }
        }
    }
    let mut failed: Option[NetError] = None
    if list.len(udp) > 0 {
        if wait > now {
            host.sleep_until(clock, wait)
        }
        match host.udp_send(mut sock, out, udp, Never) {
            Ok(k) => committed(mut e, host.mono_ns(clock), k),
            Error(err) => {
                committed(mut e, now, 0)
                failed = Some(err)
            },
        }
    } else {
        committed(mut e, now, 0)
    }
    e.drive_out = take out
    e.drive_tx = take tx
    e.drive_udp = take udp
    if let Some(err) = failed {
        return Error(err)
    }
    // Taken after committed(): the batch just sent armed its loss timers.
    let wake = match next_deadline(e) {
        Some(at) => order.min(at, until),
        None => until,
    }
    let mut buf = replace(mut e.drive_in, b"")
    let room = DRIVE_BATCH * DRIVE_SLOT + int.widen(e.config.max_mtu)
    if list.capacity(buf) < room {
        buf = list.with_capacity(room)
    }
    list.clear(mut buf)
    let mut packets = replace(mut e.drive_packets, list.new())
    if list.capacity(packets) < DRIVE_BATCH {
        packets = list.with_capacity(DRIVE_BATCH)
    }
    list.clear(mut packets)
    match host.udp_recv(mut sock, mut buf, mut packets, At(clock, order.max(wake, now + 1))) {
        Ok(_) => (),
        Error(TimedOut) => (),
        Error(err) => {
            failed = Some(err)
        },
    }
    let at = host.mono_ns(clock)
    for p in packets {
        let UdpPacket(peer, at: start, len, truncated, ecn) = p
        if truncated {
            dropped(mut e.drops, Truncated)
        } else {
            receive_datagram(mut e, at, peer, ecn, mut buf, start, len, mut events)
        }
    }
    e.drive_in = take buf
    e.drive_packets = take packets
    if let Some(err) = failed {
        return Error(err)
    }
    Ok(())
}

// rule: SEM-5
// expect: run
// std@1/store over a test Dir: a transaction reads its own writes, a commit is
// visible to later snapshots at once, a snapshot never changes, ranges walk
// either way with paging and prefix bounds, and a reopened store holds every
// commit.
fn keys(entries: List[(Bytes, Bytes)]) -> List[Bytes] {
  let mut out: List[Bytes] = []
  for (k, _) in entries {
    list.push(mut out, unique k)
  }
  out
}

// Writes the users and reports whether the run reads its own writes.
fn first(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[bool, store.TxError] {
  store.tx_put(mut tx, b"user/ada", b"1815")?
  store.tx_put(mut tx, b"user/alan", b"1912")?
  store.tx_put(mut tx, b"user/grace", b"1906")?
  store.tx_put(mut tx, b"zone", b"z")?
  store.tx_delete(mut tx, b"zone")?
  let ada = store.tx_get(tx, b"user/ada") == Ok(Some(b"1815"))
  let zone = store.tx_get(tx, b"zone") == Ok(None())
  Ok(ada && zone)
}

fn second(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), store.TxError] {
  store.tx_delete(mut tx, b"user/alan")?
  store.tx_put(mut tx, b"user/ada", b"1815-12-10")
}

fn third(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"user/x", b"x")
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  let d = test.dir(t, [])
  let mut s = store.open(d, store.default_config())?
  let earlier = store.snapshot(mut s)
  test.check(t, store.transact(mut s, first, ()) == Ok(true))
  let after = store.snapshot(mut s)
  test.check(t, store.snapshot_sequence(after) == 1)
  test.check(
    t,
    store.get(earlier, b"user/ada") == None() && store.get(after, b"user/ada") == Some(
      b"1815"
    )
  )
  // Ranges: ascending, descending, paging and prefixes.
  let up: ordered_map.Direction = Ascending()
  let down: ordered_map.Direction = Descending()
  let all: ordered_map.Bound[Bytes] = Unbounded()
  test.check(
    t,
    keys(store.range(after, all, Unbounded(), up, 10)) == [
      b"user/ada",
      b"user/alan",
      b"user/grace"
    ]
  )
  test.check(
    t,
    keys(store.range(after, all, Unbounded(), down, 2)) == [b"user/grace", b"user/alan"]
  )
  let page = store.range(after, all, Unbounded(), up, 1)
  let (last, _) = page[0]
  let next: ordered_map.Bound[Bytes] = Excluded(unique last)
  test.check(t, keys(store.range(after, next, Unbounded(), up, 1)) == [b"user/alan"])
  let (low, high) = store.prefix_bounds(b"user/a")
  test.check(
    t,
    keys(store.range(after, low, high, up, 10)) == [b"user/ada", b"user/alan"]
  )
  let (ff_low, ff_high) = store.prefix_bounds(b"\xff")
  test.check(
    t,
    store.range(after, ff_low, ff_high, up, 10) == [] && ff_high == Unbounded()
  )
  test.check(t, store.transact(mut s, second, ()) == Ok(()))
  test.check(t, store.transact(mut s, third, ()) == Ok(()))
  test.check(t, store.snapshot_sequence(store.snapshot(mut s)) == 3)
  test.check(
    t,
    keys(store.range(after, all, Unbounded(), up, 10)) == [
      b"user/ada",
      b"user/alan",
      b"user/grace"
    ]
  )
  store.close(take s)?
  let mut again = store.open(d, store.default_config())?
  let now = store.snapshot(mut again)
  test.check(t, store.snapshot_sequence(now) == 3)
  test.check(
    t,
    store.get(now, b"user/ada") == Some(b"1815-12-10") && store.get(now, b"user/alan") == None() && store.get(
      now,
      b"user/x"
    ) == Some(b"x")
  )
  store.close(take again)?
  Ok(())
}

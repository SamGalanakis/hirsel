// Module `path`: Path, a relative path below a Dir. Own: it holds its String.
// A path is '/'-separated components; it is never absolute and never contains "." or
// ".." components or an empty component. `path.of` does not check: the provider checks
// at every use and refuses a bad path with InvalidPath before any host effect, so a
// Path can never name anything outside its Dir (CAP-7).

pub opaque type Path { s: String }

/// Wraps s; no copy, no check. A literal costs nothing. Alloc: nothing. Cost: O(1).
/// Ex: `dir.narrow(d, path.of(take "logs"))`
pub fn of(take s: String) -> Path

/// A view of the path's text. View: anchored to p; FREEZE p. Cost: O(1).
/// Ex: `stdout.write(out, path.as_string(p))?`
pub fn as_string(p: Path) -> View[String] in p

// SEM-4: no element storage; capacity is MAX even for a fresh or capacity-0 List.
// expect: accept
// expect: run fresh() = 18446744073709551615
// expect: run generic_fresh() = 18446744073709551615
// expect: run exact() = true
// expect: run reserve_overflow() = true
// expect: run max_count() = true
// expect: run generic_ops() = true
// A concrete `list.get` of a zero-sized element is `Some` alone, with no payload to
// install: present at 0 (1), absent at 1 (0) (stable-value-attack-966).
// expect: run concrete_get() = 10
fn new[T]() -> List[T] {
    list.new()
}

fn make[T](n: u64) -> List[T] {
    list.with_capacity(n)
}

fn reserve[T](mut xs: List[T], n: u64) -> Result[(), Capacity] {
    list.try_reserve(mut xs, n)
}

fn push[T](mut xs: List[T], take x: T) {
    list.push(mut xs, take x)
}

fn fresh() -> u64 {
    let xs: List[()] = list.new();
    list.capacity(xs)
}

type Empty {}

fn generic_fresh() -> u64 {
    let xs: List[Empty] = new();
    list.capacity(xs)
}

fn exact() -> bool {
    let outcome = bound bytes 0 {
        let a: List[()] = make(0)
        let b: List[()] = make(18446744073709551615u64)
        let mut c: List[()] = new()
        result.unwrap(reserve(mut c, 18446744073709551615u64))
        list.capacity(a) == 18446744073709551615u64 && list.capacity(b) == 18446744073709551615u64 && list.capacity(c) == 18446744073709551615u64
    }
    match outcome {
        Ok(b) => b,
        Error(_) => false
    }
}

fn reserve_overflow() -> bool {
    let outcome = bound bytes 0 {
        let mut xs: List[()] = new()
        push(mut xs, ())
        match reserve(mut xs, 18446744073709551615u64) {
            Ok(()) => false,
            Error(e) => e.requested == 18446744073709551615u64 && e.available == 0 && list.len(xs) == 1 && list.capacity(xs) == 18446744073709551615u64,
        }
    }
    match outcome {
        Ok(b) => b,
        Error(_) => false
    }
}

fn max_count() -> bool {
    let outcome = bound bytes 0 {
        let mut a: List[()] = new()
        let mut b: List[()] = new()
        push(mut a, ())
        // After iteration k, len(a)=2^(k+2)-1. No element bytes are copied.
        for _ in 0u64 .. 63u64 {
            list.clear(mut b)
            list.append(mut b, a)
            list.append(mut a, b)
            push(mut a, ())
        }
        let good = list.len(a) == 18446744073709551615u64
        let declined = match reserve(mut a, 1) {
            Ok(()) => false,
            Error(e) => e.requested == 18446744073709551615u64 && e.available == 0,
        }
        good && declined && list.len(a) == 18446744073709551615u64
    }
    match outcome {
        Ok(b) => b,
        Error(_) => false
    }
}

fn generic_ops() -> bool {
    let outcome = bound bytes 0 {
        let mut xs: List[Empty] = make(18446744073709551615u64)
        push(mut xs, Empty())
        list.set(mut xs, 0, Empty())
        let present = match list.get(xs, 0) {
            Some(_) => true,
            None => false
        }
        let popped = match list.pop(mut xs) {
            Some(_) => true,
            None => false
        }
        present && popped && list.len(xs) == 0 && list.capacity(xs) == 18446744073709551615u64
    }
    match outcome {
        Ok(b) => b,
        Error(_) => false
    }
}

fn concrete_get() -> u64 {
    let mut xs: List[()] = list.new()
    list.push(mut xs, ())
    let first: u64 = match list.get(xs, 0) {
        Some(_) => 1,
        None => 0
    }
    let second: u64 = match list.get(xs, 1) {
        Some(_) => 1,
        None => 0
    }
    first * 10 + second
}

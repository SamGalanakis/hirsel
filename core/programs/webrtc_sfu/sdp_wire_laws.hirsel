fn minimal_head_ice(ufrag: bool, pwd: bool) -> Bytes {
    let mut b: Bytes = b"v=0\no=- 5 9 IN IP4 0.0.0.0\ns=-\nt=0 0\na=group:BUNDLE v\n"
    if ufrag {
        list.append(mut b, b"a=ice-ufrag:remote\n")
    }
    if pwd {
        list.append(mut b, b"a=ice-pwd:remote-pass-0123456789abcd\n")
    }
    list.append(mut b, b"a=fingerprint:sha-256 1F:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00\na=setup:actpass\na=tls-id:remote-association\n")
    take b
}

fn sdp_without_ice(ufrag: bool, pwd: bool) -> Bytes {
    let mut b = minimal_head_ice(ufrag, pwd)
    list.append(mut b, minimal_video(b"96", b"v", true))
    take b
}

/// bug: accept a session-level transport block without its ICE ufrag.
/// oracle: RTC-1's session/media ICE credential inheritance rule.
@test
fn sdp_parse_no_ice_ufrag() -> Result[(), sdp.SdpError] {
    let mut d = sdp.description()
    if let Error(NoIceCredentials) = sdp.parse(sdp_without_ice(false, true), mut d) {} else {
        fail("missing ICE ufrag")
    }
    Ok(())
}

/// bug: accept a session-level transport block without its ICE password.
/// oracle: RTC-1's session/media ICE credential inheritance rule.
@test
fn sdp_parse_no_ice_pwd() -> Result[(), sdp.SdpError] {
    let mut d = sdp.description()
    if let Error(NoIceCredentials) = sdp.parse(sdp_without_ice(true, false), mut d) {} else {
        fail("missing ICE password")
    }
    Ok(())
}

/// bug: negotiate from a local end whose ICE credentials are not SDP tokens.
/// oracle: SDP's ice-ufrag/ice-pwd token grammar as enforced before writing.
@test
fn sdp_negotiate_no_ice_credentials() -> Result[(), sdp.SdpError] {
    let mut d = sdp.description()
    sdp.parse(video_offer(), mut d)?
    let mut local = local_end(1)
    local.ice_ufrag = b""
    let mut reply = sdp.description()
    let mut agreed = sdp.negotiated(local)
    if let Error(NoIceCredentials) = sdp.answer(sdp.default_policy(), None, d, local, mut reply, mut agreed) {} else {
        fail("empty local ICE ufrag")
    }
    Ok(())
}

/// bug: write a description whose ICE credentials cannot be represented as SDP tokens.
/// oracle: SDP's ice-ufrag/ice-pwd token grammar as enforced by the writer.
@test
fn sdp_write_no_ice_credentials() -> Result[(), sdp.SdpError] {
    let mut d = sdp.description()
    sdp.parse(video_offer(), mut d)?
    d.ice_pwd = list.new()
    let mut out: Bytes = list.new()
    if let Error(NoIceCredentials) = sdp.write(d, mut out) {} else {
        fail("empty ICE password")
    }
    Ok(())
}

fn client_answer() -> Bytes {
    let mut b = minimal_head(b" v s0")
    list.append(mut b, b"a=setup:active\n")
    list.append(mut b, minimal_video(b"96 97", b"v", true))
    list.append(mut b, b"a=sendonly\na=rtpmap:96 VP8/90000\na=rtpmap:97 rtx/90000\na=fmtp:97 apt=96\n")
    list.append(mut b, minimal_video(b"96 97", b"s0", true))
    list.append(mut b, b"a=recvonly\na=rtpmap:96 VP8/90000\na=rtpmap:97 rtx/90000\na=fmtp:97 apt=96\n")
    take b
}

fn expect_running(n: sdp.Negotiated, count: u64) {
    if list.len(n.sections) != count || !n.sections[0].recv || n.sections[0].send || n.sections[0].formats[0].pt != 96 || n.sections[0].extmaps[0].id != 1 || n.remote_fingerprint[0] != 0x1f {
        fail("negotiated ingress and forwarding inputs changed")
    }
}

/// bug: overwrite an outstanding offer or install a stale, reassociated, or reordered answer.
/// oracle: RTC-2's role and section rules and the impolite peer's three-message exchange.
@test
fn glare_settles_in_one_round() -> Result[(), sdp.SdpError] {
    let mut incoming = sdp.description()
    sdp.parse(video_offer(), mut incoming)?
    let mut local = local_end(1)
    let mut running = sdp.negotiated(local)
    let mut outbound = sdp.description()
    let policy = sdp.default_policy()
    sdp.answer(policy, None, incoming, local, mut outbound, mut running)?
    expect_running(running, 1)
    local.origin_version = 2
    let mut adds: List[sdp.SendSection] = list.new()
    list.push(mut adds, Add(sdp.TrackSource(media: Video, formats: clone(incoming.sections[0].formats), ssrc: 101, rtx_ssrc: 102, msid: b"stream track")))
    sdp.offer(policy, running, local, adds, mut outbound)?
    if outbound.setup != ActPass || outbound.sections[1].dir != SendOnly || outbound.sections[1].mid[0] != b's' || outbound.sections[1].mid[1] != b'0' || outbound.sections[1].ssrcs[0] != 101 || outbound.sections[1].ssrcs[1] != 102 {
        fail("new down-track identity")
    }
    let mut state: sdp.Signaling = Stable
    sdp.begin_local(mut state, 2)?
    if let Glare(2) = sdp.begin_remote(mut state, 9) {} else {
        fail("glare must name outstanding offer")
    }
    let mut remote = sdp.description()
    sdp.parse(client_answer(), mut remote)?
    let current: sdp.Negotiated = clone(running)
    if let Error(AnswerMismatch(0)) = sdp.receive_answer(1, current, outbound, remote, mut state, mut running) {} else {
        fail("stale answer")
    }
    expect_running(running, 1)
    remote.fingerprint[0] = 1
    if let Error(AssociationChanged) = sdp.receive_answer(2, current, outbound, remote, mut state, mut running) {} else {
        fail("changed fingerprint")
    }
    expect_running(running, 1)
    remote.fingerprint[0] = 0x1f
    remote.tls_id = b"new-association"
    if let Error(AssociationChanged) = sdp.receive_answer(2, current, outbound, remote, mut state, mut running) {} else {
        fail("changed tls-id")
    }
    expect_running(running, 1)
    remote.tls_id = b"remote-association"
    list.swap(mut remote.sections, 0, 1)
    if let Error(AnswerMismatch(0)) = sdp.receive_answer(2, current, outbound, remote, mut state, mut running) {} else {
        fail("reordered answer")
    }
    expect_running(running, 1)
    if state != HaveLocalOffer(2) {
        fail("refusal consumed local offer")
    }
    list.swap(mut remote.sections, 0, 1)
    remote.sections[1].protocol = b"RTP/AVP"
    if let Error(AnswerMismatch(1)) = sdp.receive_answer(2, current, outbound, remote, mut state, mut running) {} else {
        fail("changed m-line protocol")
    }
    remote.sections[1].protocol = b"UDP/TLS/RTP/SAVPF"
    remote.sections[1].dir = SendOnly
    if let Error(AnswerMismatch(1)) = sdp.receive_answer(2, current, outbound, remote, mut state, mut running) {} else {
        fail("invalid answer direction")
    }
    remote.sections[1].dir = RecvOnly
    remote.sections[1].formats[0].pt = 98
    if let Error(AnswerMismatch(1)) = sdp.receive_answer(2, current, outbound, remote, mut state, mut running) {} else {
        fail("unoffered answer payload")
    }
    expect_running(running, 1)
    remote.sections[1].formats[0].pt = 96
    sdp.receive_answer(2, current, outbound, remote, mut state, mut running)?
    expect_running(running, 2)
    if state != Stable || !running.sections[1].send {
        fail("matching answer did not install down-track")
    }
    let installed: sdp.Negotiated = clone(running)
    let mut retry = client_answer()
    list.append(mut retry, b"a=setup:actpass\n")
    sdp.parse(retry, mut incoming)?
    if let Proceed = sdp.begin_remote(mut state, 9) {} else {
        fail("client could not retry its offer")
    }
    local.origin_version = 3
    sdp.answer(policy, Some(installed), incoming, local, mut outbound, mut running)?
    sdp.finish_remote(mut state, 9)?
    expect_running(running, 2)
    if state != Stable || !running.sections[1].send || running.sections[1].local.ssrcs[0] != 101 {
        fail("re-offer changed the installed down-track")
    }
    let mid = sdp.Id(name: running.sections[1].mid, len: running.sections[1].mid_len)
    let mut remove: List[sdp.SendSection] = list.new()
    list.push(mut remove, Remove(mid))
    local.origin_version = 4
    sdp.offer(policy, running, local, remove, mut outbound)?
    if outbound.sections[1].dir != Inactive || outbound.sections[1].mid != mid.name {
        fail("removed down-track keeps its MID and becomes inactive")
    }
    remote.sections[1].dir = Inactive
    let before_remove: sdp.Negotiated = clone(running)
    sdp.accept_answer(before_remove, outbound, remote, mut running)?
    local.origin_version = 5
    sdp.offer(policy, running, local, adds, mut outbound)?
    if list.len(outbound.sections) != 2 || outbound.sections[1].mid != mid.name || outbound.sections[1].dir != SendOnly {
        fail("new down-track reuses the inactive section")
    }
    Ok(())
}

// ---- RTC-3 PeerSession laws (W4, W19) ----
// RFC 8839 section 5.4: ice-char is ALPHA, DIGIT, "+" and "/".
fn server_pwd() -> Bytes {
    b"serverpass0123456789abcd"
}

fn rig_local() -> sdp.LocalEnd {
    let mut l = local_end(1)
    l.ice_pwd = server_pwd()
    l
}

const CLIENT_SSRC: u32 = 0x0c0c0c0c

const MEDIA_SSRC: u32 = 0x11111111

const MS: u64 = 1000000

fn server_addr() -> Addr {
    Addr(ip: V4(0xc0000201), port: 5000)
}

fn client_addr() -> Addr {
    Addr(ip: V4(0xc6336401), port: 50000)
}

fn stranger() -> Addr {
    Addr(ip: V4(0xc6336402), port: 50002)
}

type Party {
    id: dtls.Identity,
    certificate: Bytes
}

fn party(seed: u64) -> Party {
    let r = provide.random(seed)
    let mut point: Bytes = list.with_capacity(65)
    let key = result.unwrap(secret.p256_key(r, "sign(p256)", mut point))
    let start = option.unwrap(std.time.from_unix(1704067200, 0))
    let end = option.unwrap(std.time.from_unix(2524608000, 0))
    let der = result.unwrap(std.x509_build.self_signed_p256(key, r, point, seed, "webrtc.test", start, end))
    let mut certificate: Bytes = list.with_capacity(list.len(der))
    list.append(mut certificate, der)
    Party(id: result.unwrap(dtls.identity(take key, take der, r)), certificate: take certificate)
}

/// RFC 8122 section 5: the SHA-256 of the whole certificate DER.
fn pin_list(certificate: Bytes) -> List[dtls.Fingerprint] {
    let d = std.sha256.hash(certificate)
    let mut digest: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32 {
        list.push(mut digest, d[i])
    }
    let mut out: List[dtls.Fingerprint] = list.new()
    list.push(mut out, dtls.Fingerprint(hash: Sha256, digest: take digest))
    out
}

// Sections a and b receive VP8 on the same payload type 96; c is the server's down-track.
fn session_offer() -> Bytes {
    let mut b = minimal_head(b" a b c")
    list.append(mut b, minimal_video(b"96 97", b"a", true))
    list.append(mut b, b"a=sendonly\na=rtpmap:96 VP8/90000\na=rtpmap:97 rtx/90000\na=fmtp:97 apt=96\na=rtcp-fb:96 nack\na=extmap:3 http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01\n")
    list.append(mut b, minimal_video(b"96", b"b", true))
    list.append(mut b, b"a=sendonly\na=rtpmap:96 VP8/90000\na=rtcp-fb:96 nack\n")
    list.append(mut b, minimal_video(b"96 97", b"c", true))
    list.append(mut b, b"a=recvonly\na=rtpmap:96 VP8/90000\na=rtpmap:97 rtx/90000\na=fmtp:97 apt=96\na=rtcp-fb:96 nack\na=extmap:3 http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01\n")
    take b
}

/// One established PeerSession and the browser end that reached it: the STUN
/// nomination, the DTLS handshake and the browser's SRTP session.
type Rig {
    p: peer.PeerSession,
    c: dtls.Endpoint,
    cs: srtp.Session,
    out: peer.Outbox
}

fn copy_of(b: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(1500)
    list.append(mut out, b)
    out
}

fn to_client(mut c: dtls.Endpoint, rc: Random, now: u64, out: peer.Outbox) {
    for tx in out.pkts {
        let UdpTx(to: _, at, len, ecn: _) = tx
        let mut data: Bytes = list.new()
        let _ = dtls.receive(mut c, now, rc, list.slice(out.data, at, at + len), mut data)
    }
}

fn established(seed: u64) -> Rig {
    established_on(seed, session_offer(), peer.Participant(gen: Gen(id: 1, epoch: 1), room: RoomId(7)), client_addr())
}

/// A session for `who`, from the browser at `client` that sent `offer`.
fn established_on(seed: u64, offer_bytes: Bytes, who: peer.Participant, client: Addr) -> Rig {
    established_with(seed, offer_bytes, who, client, 64)
}

/// The same, with a pacer of `pacer_packets` slots.
fn established_with(seed: u64, offer_bytes: Bytes, who: peer.Participant, client: Addr, pacer_packets: u32) -> Rig {
    established_as(seed, offer_bytes, who, client, pacer_packets, b"server")
}

/// The same, with the server's ICE ufrag `ufrag`, which names the session (RTC-3).
fn established_as(seed: u64, offer_bytes: Bytes, who: peer.Participant, client: Addr, pacer_packets: u32, ufrag: Bytes) -> Rig {
    established_limits(seed, offer_bytes, who, client, peer.PeerLimits(sections: 8, down_tracks: 4, rtx_bytes: 1048576, pacer_packets: pacer_packets, start_bps: 300000), ufrag)
}

/// The same, with the session's `limits`.
fn established_limits(seed: u64, offer_bytes: Bytes, who: peer.Participant, client: Addr, limits: peer.PeerLimits, ufrag: Bytes) -> Rig {
    let mut local = rig_local()
    local.ice_ufrag = copy_of(ufrag)
    let Party(id: take server_id, certificate: server_certificate) = party(seed)
    let Party(id: take client_id, certificate: client_certificate) = party(seed + 1)
    let mut offer = sdp.description()
    result.unwrap(sdp.parse(offer_bytes, mut offer))
    let mut reply = sdp.description()
    let mut n = sdp.negotiated(local)
    result.unwrap(sdp.answer(sdp.default_policy(), None, offer, local, mut reply, mut n))
    let d = std.sha256.hash(client_certificate)
    for i in 0u64 .. 32 {
        n.remote_fingerprint[i] = d[i]
    }
    let mut p = result.unwrap(peer.open(take local, take server_id, provide.random(seed + 2), server_addr(), limits, n, who))
    let mut out = result.unwrap(peer.outbox(65536, 64))
    let mut pkt: Bytes = list.with_capacity(576)
    list.fill(mut pkt, 576, 0)
    let mut scratch: Bytes = list.with_capacity(576)
    list.fill(mut scratch, 576, 0)
    let check = stun_ice.Check(role: stun_ice.IceRole(role: Controlling, tie: 7), priority: 0x6e0001ff, nominate: true)
    let k = result.unwrap(stun_ice.binding_request(stun_ice.Transaction(high: 1, low: 2), username(ufrag), Some(check), Sha1, true, server_pwd(), mut pkt, mut scratch))
    let mut slot = copy_of(list.slice(pkt, 0, k))
    if let Ok(Replied) = peer.receive(mut p, 0, client, mut slot, mut out) {} else {
        fail("nomination not answered")
    }
    if peer.selected(p) != Some(client) {
        fail("nomination did not select the path")
    }
    peer.clear_outbox(mut out)
    let rc = provide.random(seed + 3)
    let mut c = result.unwrap(dtls.client(take client_id, dtls.defaults(), server_addr()))
    result.unwrap(dtls.expect(mut c, pin_list(server_certificate)))
    for _ in 0u64 .. 8 {
        while true {
            let mut f: Bytes = list.with_capacity(1500)
            match dtls.poll(mut c, 0, rc, mut f) {
                Ok(Send(_)) => {
                    let _ = result.unwrap(peer.receive(mut p, 0, client, mut f, mut out))
                },
                _ => break,
            }
        }
        let _ = peer.poll(mut p, 0, mut out)
        to_client(mut c, rc, 0, out)
        peer.clear_outbox(mut out)
    }
    if !peer.connected(p) {
        fail("DTLS did not connect the session")
    }
    let profile = option.unwrap(dtls.srtp_profile(c))
    let keys = result.unwrap(dtls.take_srtp(mut c))
    let cs = result.unwrap(srtp.session(take keys, profile, srtp.Limits(send_streams: 32, receive_streams: 32, ended_streams: 32)))
    Rig(p: take p, c: take c, cs: take cs, out: take out)
}

// The USERNAME of a browser's check of the server's ufrag `ufrag` (RFC 8445 section 7.2.2).
fn username(ufrag: Bytes) -> Bytes {
    let mut u = copy_of(ufrag)
    list.append(mut u, b":remote")
    u
}

// A browser RTP packet with the one-byte MID element first (RFC 8285 section 4.2).
fn media(mut cs: srtp.Session, ssrc: u32, seq: u16, mid: Bytes, pt: u8) -> Bytes {
    let wide: u32 = int.widen(seq)
    media_carrying(mut cs, ssrc, seq, 3000 * wide, mid, pt, b"\x10\x00\x9d\x01\x2a\x00\x00\x00")
}

fn media_carrying(mut cs: srtp.Session, ssrc: u32, seq: u16, ts: u32, mid: Bytes, pt: u8, body: Bytes) -> Bytes {
    let mut m = rtp.ext.map(OneOnly)
    result.unwrap(rtp.ext.bind(mut m, 1, Mid))
    let mut w = rtp.ext.writer()
    if list.len(mid) != 0 {
        result.unwrap(rtp.ext.put(mut w, m, Mid, mid, 0, list.len(mid)))
    }
    let f = rtp.header.Fields(marker: true, pt: pt, seq: seq, ts: ts, ssrc: ssrc)
    let mut b: Bytes = list.with_capacity(1500)
    let _ = result.unwrap(rtp.header.write(f, view w, mut b))
    list.append(mut b, body)
    let _ = result.unwrap(srtp.protect_rtp(mut cs, mut b))
    b
}

fn sealed_rtcp(mut cs: srtp.Session, take plain: Bytes) -> Bytes {
    let mut b = take plain
    let _ = result.unwrap(srtp.protect_rtcp(mut cs, mut b))
    b
}

fn nack(mut cs: srtp.Session, media_ssrc: u32, seq: u16) -> Bytes {
    let mut b: Bytes = list.with_capacity(1500)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = result.unwrap(rtp.rtcp.write_rr(CLIENT_SSRC, view empty, mut b))
    let _ = result.unwrap(rtp.rtcp.write_cname(CLIENT_SSRC, b"browser", mut b))
    let mut pairs: List[(u16, u16)] = list.new()
    list.push(mut pairs, (seq, 0))
    let _ = result.unwrap(rtp.rtcp.write_nack(CLIENT_SSRC, media_ssrc, view pairs, mut b))
    sealed_rtcp(mut cs, take b)
}

fn twcc(mut cs: srtp.Session, media_ssrc: u32, count: u16, now: u64) -> Bytes {
    let mut log = result.unwrap(rtp.twcc.recv_log(64))
    for i in 0u16 .. count {
        let at: u64 = int.widen(i)
        rtp.twcc.on_packet(mut log, i, now + at * MS)
    }
    let mut b: Bytes = list.with_capacity(1500)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = result.unwrap(rtp.rtcp.write_rr(CLIENT_SSRC, view empty, mut b))
    let _ = result.unwrap(rtp.rtcp.write_cname(CLIENT_SSRC, b"browser", mut b))
    let _ = result.unwrap(rtp.twcc.write(mut log, CLIENT_SSRC, media_ssrc, 1000, mut b))
    sealed_rtcp(mut cs, take b)
}

fn counts(d: peer.Drops) -> List[u64] {
    let mut out: List[u64] = list.new()
    for v in[d.classified, d.short_stun, d.short_dtls, d.short_rtp, d.short_rtcp, d.off_path, d.stun, d.early, d.srtp, d.malformed, d.unbound, d.format, d.repair, d.late, d.nack, d.capacity] {
        list.push(mut out, v)
    }
    out
}

// The one drop counter that moved, which must have moved by exactly one.
fn raised(before: peer.Drops, after: peer.Drops) -> Option[u64] {
    let a = counts(before)
    let b = counts(after)
    let mut moved: Option[u64] = None
    for i in 0u64 .. list.len(a) {
        if a[i] != b[i] {
            if b[i] != a[i] + 1 || moved != None {
                return None
            }
            moved = Some(i)
        }
    }
    moved
}

const SHORT_STUN: u64 = 1

const SHORT_DTLS: u64 = 2

const SHORT_RTP: u64 = 3

const SHORT_RTCP: u64 = 4

const OFF_PATH: u64 = 5

const BAD_STUN: u64 = 6

const BAD_SRTP: u64 = 8

const UNBOUND: u64 = 10

// Feed one datagram that must be dropped: no input, no output, one counter.
fn dropped(mut r: Rig, now: u64, from: Addr, packet: Bytes, counter: u64, take what: String) {
    let before = peer.drops(r.p)
    let mut slot = copy_of(packet)
    match peer.receive(mut r.p, now, from, mut slot, mut r.out) {
        Ok(Nothing) => (),
        _ => fail(take what),
    }
    if list.len(r.out.pkts) != 0 || raised(before, peer.drops(r.p)) != Some(counter) {
        fail(take what)
    }
}

fn media_at(mut r: Rig, now: u64, packet: Bytes) -> peer.MediaIn {
    let mut slot = copy_of(packet)
    match peer.receive(mut r.p, now, client_addr(), mut slot, mut r.out) {
        Ok(Media(take m)) => take m,
        _ => fail("a valid packet was not taken as media"),
    }
}

fn bound_to(r: Rig, ssrc: u32) -> Option[u8] {
    for b in peer.bindings(r.p) {
        if b.ssrc == ssrc {
            return Some(b.section)
        }
    }
    None
}

/// RFC 9443 section 3 with RFC 5761 section 4, as the table states it: first-byte
/// ranges and their class, the RTP range split by the second byte.
fn rfc9443(first: u8, second: u8) -> peer.Class {
    let mut table: List[(u8, u8, peer.Class)] = list.new()
    list.push(mut table, (0, 3, Stun))
    list.push(mut table, (4, 15, Drop))
    list.push(mut table, (16, 19, Drop))
    list.push(mut table, (20, 63, Dtls))
    list.push(mut table, (64, 79, Drop))
    list.push(mut table, (80, 127, Drop))
    list.push(mut table, (128, 191, Rtp))
    list.push(mut table, (192, 255, Drop))
    for (lo, hi, class) in table {
        if first >= lo && first <= hi {
            if class == Rtp && second >= 192 && second <= 223 {
                return Rtcp
            }
            return class
        }
    }
    fail("table does not cover the byte")
}

/// bug: demultiplex on the wrong byte boundary, take an empty or 1-byte datagram as RTP, let a short datagram reach its parser uncounted, bind a payload type two sections share, or let an older packet undo a newer MID binding.
/// oracle: RFC 9443 section 3's table and RFC 5761 section 4 by hand, exhaustive over the first byte; RTC-3's reader minimums and binding steps.
@test
fn demux_prefix() -> Result[(), peer.PeerError] {
    for f in 0u64 .. 256 {
        let first: u8 = int.narrow(f)
        for second in[191u8, 192u8, 223u8, 224u8] {
            let mut prefix: Bytes = list.with_capacity(2)
            list.push(mut prefix, first)
            list.push(mut prefix, second)
            if peer.classify(prefix) != rfc9443(first, second) {
                fail("classify disagrees with RFC 9443")
            }
        }
    }
    if peer.classify(b"") != Drop || peer.classify(b"\x80") != Drop || peer.classify(b"\xbf") != Drop {
        fail("empty or 1-byte RTP-range datagram not dropped")
    }
    let mut r = established(41)
    dropped(mut r, MS, client_addr(), b"\x00\x01\x00\x00\x21\x12\xa4\x42\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00", SHORT_STUN, "19-byte STUN")
    dropped(mut r, MS, client_addr(), b"\x16\xfe\xfd\x00\x00\x00\x00\x00\x00\x00\x00\x00", SHORT_DTLS, "12-byte DTLS")
    dropped(mut r, MS, client_addr(), b"\x80\x60\x00\x01\x00\x00\x00\x00\x11\x11\x11", SHORT_RTP, "11-byte RTP")
    dropped(mut r, MS, client_addr(), b"\x80\xc9\x00\x01\x0c\x0c\x0c", SHORT_RTCP, "7-byte RTCP")
    // Payload type 96 names sections a and b, and the packet has no MID.
    let shared = media(mut r.cs, 0x22222222, 7, b"", 96)
    dropped(mut r, 2 * MS, client_addr(), shared, UNBOUND, "a shared payload type bound an SSRC")
    if bound_to(r, 0x22222222) != None {
        fail("a shared payload type bound an SSRC")
    }
    // RFC 8843 section 9.2: rebind only for a higher extended index.
    let first = media(mut r.cs, 0x33333333, 10, b"a", 96)
    let older = media(mut r.cs, 0x33333333, 11, b"a", 96)
    let newer = media(mut r.cs, 0x33333333, 12, b"b", 96)
    if media_at(mut r, 3 * MS, first).section != 0 || bound_to(r, 0x33333333) != Some(0) {
        fail("MID a did not bind section a")
    }
    if media_at(mut r, 4 * MS, newer).section != 1 || bound_to(r, 0x33333333) != Some(1) {
        fail("a newer MID b did not rebind")
    }
    if media_at(mut r, 5 * MS, older).section != 1 || bound_to(r, 0x33333333) != Some(1) {
        fail("an older packet with the earlier MID took the SSRC back")
    }
    Ok(())
}

fn same_out(a: peer.Outbox, b: peer.Outbox) -> bool {
    if list.len(a.pkts) != list.len(b.pkts) || list.compare_bytes(a.data, b.data) != Equal {
        return false
    }
    for i in 0u64 .. list.len(a.pkts) {
        let UdpTx(to: ta, at: aa, len: la, ecn: _) = a.pkts[i]
        let UdpTx(to: tb, at: ab, len: lb, ecn: _) = b.pkts[i]
        if ta != tb || aa != ab || la != lb {
            return false
        }
    }
    true
}

fn flip(packet: Bytes, at: u64) -> Bytes {
    let mut b = copy_of(packet)
    b[at] = b[at] ^ 1
    b
}

// The same egress on a twin: a down-track and five packets of one source frame each,
// from index 100 and timestamp 0, so the outgoing numbers are 100 to 104.
fn egress(mut r: Rig, payload: Bytes) {
    let track = result.unwrap(peer.add_track(mut r.p, 2, 100, 0))
    result.unwrap(peer.set_target(mut r.p, track, Layer(source: 9, target: 0)))
    let none = result.unwrap(rtp.red.ring(0))
    for i in 0u64 .. 5 {
        let ts: i64 = int.narrow(3000 * i)
        let u = rtp.rewrite.Unit(start: true, end: true, keyframe: i == 0, needs: 1, switches: 0xffffffff, frame: 0)
        let leg = peer.Leg(src: Gen(id: 9, epoch: 1), handle: i, source: 9, index: 100 + i, ts: ts, marker: true, codec: Vp8, padding_only: false, unit: u, level: None, voice: false, from: 0, len: list.len(payload), closes: 0, dd_at: 0, dd_len: 0, orientation: None, capture: None)
        if result.unwrap(peer.forward(mut r.p, 6 * MS + i * MS, track, leg, payload, none, mut r.out)) != OnMedia {
            fail("an on-time packet was not sent on the media SSRC")
        }
    }
    peer.clear_outbox(mut r.out)
}

fn control_at(mut r: Rig, now: u64, packet: Bytes) -> peer.ControlIn {
    let mut slot = copy_of(packet)
    match peer.receive(mut r.p, now, client_addr(), mut slot, mut r.out) {
        Ok(Control(take c)) => take c,
        _ => fail("valid RTCP was not taken as control"),
    }
}

type SdpRoundDraw {
    ufrag: Bytes,
    pwd: Bytes,
    session: u64,
    version: u64
}

fn show_sdp_round(d: SdpRoundDraw, mut out: String) {
    string.push(mut out, "SdpRoundDraw(version: ")
    string.push_u64(mut out, d.version)
    string.push(mut out, ")")
}

fn sdp_token(mut src: std.prop.Source, min: u64, max: u64) -> Bytes {
    let len = min + std.prop.below(mut src, max - min + 1)
    let mut out: Bytes = list.with_capacity(len)
    for _ in 0u64 .. len {
        list.push(mut out, int.narrow(97 + std.prop.below(mut src, 26)))
    }
    take out
}

fn sdp_round_gen() -> std.prop.Gen[SdpRoundDraw] {
    std.prop.make(fn(mut src: std.prop.Source) -> SdpRoundDraw {
        SdpRoundDraw(ufrag: sdp_token(mut src, 4, 24), pwd: sdp_token(mut src, 22, 32), session: std.prop.word(mut src), version: std.prop.below(mut src, 1000))
    }, show_sdp_round)
}

fn sdp_round_law(d: SdpRoundDraw) -> Result[(), String] {
    let mut description = sdp.description()
    match sdp.parse(video_offer(), mut description) {
        Ok(()) => (),
        Error(_) => return Error(string.from("fixture offer did not parse")),
    }
    description.ice_ufrag = clone(d.ufrag)
    description.ice_pwd = clone(d.pwd)
    description.origin_session = d.session
    description.origin_version = d.version
    let mut out: Bytes = list.new()
    let n = match sdp.write(description, mut out) {
        Ok(n) => n,
        Error(_) => return Error(string.from("writer refused generated description")),
    }
    if n != list.len(out) {
        return Error(string.from("write length mismatch"))
    }
    let mut again = sdp.description()
    match sdp.parse(out, mut again) {
        Ok(()) => (),
        Error(_) => return Error(string.from("written SDP did not parse")),
    }
    if list.compare_bytes(again.ice_ufrag, d.ufrag) != Equal || list.compare_bytes(again.ice_pwd, d.pwd) != Equal || again.origin_session != d.session || again.origin_version != d.version || list.len(again.sections) != list.len(description.sections) {
        return Error(string.from("written SDP fields did not round trip"))
    }
    Ok(())
}

fn sdp_total_law(text: Bytes) -> Result[(), String] {
    let mut d = sdp.description()
    let _ = sdp.parse(text, mut d)
    Ok(())
}

/// bug: Write an SDP transport or origin field its parser cannot read back.
/// oracle: RFC 8866 origin and RFC 8839 ice-ufrag/ice-pwd line grammars.
@test
fn sdp_write_parse_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 64
    std.prop.check(c, sdp_round_gen(), sdp_round_law)
}

/// bug: Index outside arbitrary bytes while scanning SDP lines and attributes.
/// oracle: RFC 8866 line framing and RTC-1's typed refusals.
@test
fn sdp_totality_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 128
    std.prop.check(c, std.prop.bytes_of(0, 512), sdp_total_law)
}

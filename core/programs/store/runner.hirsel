// Module runner (package store): the entries of a place (RUNNER-SPEC v2.10).
// Room and Bad mirror Capacity and DecodeError, which are not codec (OWN-4).
pub type Room: codec + send { requested: u64, available: u64 }

pub type Bad: codec + send { kind: u32, at: u64 }

pub type Kind: codec + send = Compute | Transact | Query | Granted

pub type Refusal: codec + send = NoEntry | Malformed(Bad) | Overloaded | Deadline | Budget(Room) | NotAllowed | RequestMismatch | HistoryUnavailable

pub type Fault: codec + send = Raised(u32) | OutOfBytes(Room) | OutOfTime(u64) | Gone

pub type Outcome: codec + send = Returned(Bytes) | Failed(Fault) | Refused(Refusal) | Abandoned | InDoubt

pub type Described: codec + send { kind: Kind, identity: Bytes, args: Bytes, result: Bytes }

// WIRE-SPEC v2 §3. Declared variant order fixes the u32 wire tags, Hello 0 to Reset 8.
pub type Want: codec + send { identity: Bytes, args_fp: u64, result_fp: u64 }

pub type Entry: codec + send = Ready(u32) | Resolve(u32, Bytes) | Gone

pub type Done: codec + send { stream: u32, p: u64, outcome: Outcome }

// key is the data-tree key (table id and key-codec integers big-endian). value is
// the current value codec's bytes, without a stored schema prefix; None removes it.
pub type Row: codec + send { sub: u32, key: Bytes, value: Option[Bytes] }

pub type Frame: codec + send = Hello(Option[Bytes], List[Want]) | Call(u32, u64, u32, u32, Bytes) | Subscribe(u32, u32, Bytes, Option[Bytes]) | Unsubscribe(u32) | Welcome(Bytes, u32, u64, Bytes, String, u64) | Placed(Entry) | Batch(u64, List[u32], List[Row], List[Done]) | Ended(u32, Outcome) | Reset(u64, List[Done])

pub type RegisterError: send = Full(Capacity) | AlreadyRegistered(Bytes)

pub const DEFAULT_STEPS: u64 = 1 << 30

pub type OpenError = Store(store.Error) | Place(RegisterError) | HandlesChanged

// Private runtime-supplied launch metadata. The body is a declaration placeholder;
// the call is lowered to the immutable launch transport on every engine.
fn launch_word(field: u64, index: u64) -> u64 { 0u64 }

fn launch_digest() -> Result[Bytes, Capacity] {
    let len = launch_word(1u64, 0u64)
    let mut digest: Bytes = list.with_capacity(len)?
    for i in 0u64..len {
        result.unwrap(list.push(mut digest, int.narrow(launch_word(2u64, i))))
    }
    Ok(take digest)
}

fn launch_text(a: Args) -> View[String] in a { "" }

fn launch_target(a: Args) -> Result[String, Capacity] {
    string.from(launch_text(a))
}

// One erased adapter per kind, holding the entry's byte bound n from registration
// (RUNNER-SPEC v2.4 §1.1). A compute slot runs in the caller's task; a granted slot
// starts a task under `bytes n` that holds the grant. A transact slot has two: the
// session's check (rule 5: decode the argument, keep nothing) and the head's run, with the
// entry's step bound and its code.revision, which each call record carries (R5, §7).
type Slot[G: send, H: send]: send = Compute(own[send] fn(Bytes) -> Outcome) | Granted(own[send] fn(Tasks, take G, take Bytes) -> Result[Task[Outcome], Capacity]) | Transact(u64, Option[Bytes], own[send] fn(Bytes) -> Option[Refusal], own[send] fn(mut store.Tx, H, Bytes) -> Ran) | Query(own[send] fn(store.Snapshot, H, Bytes) -> Queried)

pub opaque type Registry[G: send, H: send]: send {
    slots: Map[Bytes, Slot[G, H]],
    described: List[Described],
    checks: Map[Bytes, own[send] fn(Bytes) -> Option[Refusal]],
    gone: Map[Bytes, ()]
}

pub fn registry[G: send, H: send]() -> Registry[G, H] {
    Registry(slots: map.new(), described: list.new(), checks: map.new(), gone: map.new())
}

fn room(c: Capacity) -> Room {
    Room(requested: c.requested, available: c.available)
}

// RUNNER-SPEC §1.1's fixed Bad.kind table.
fn bad(e: std.codec.DecodeError) -> Bad {
    match e {
        Truncated(at) => Bad(kind: 0u32, at: at),
        Invalid(at) => Bad(kind: 1u32, at: at),
        Utf8(at) => Bad(kind: 2u32, at: at),
        Duplicate(at) => Bad(kind: 3u32, at: at),
        Trailing(at) => Bad(kind: 4u32, at: at),
        Schema(at) => Bad(kind: 5u32, at: at),
        Value(at) => Bad(kind: 6u32, at: at),
    }
}

// RUNNER-SPEC v2.10 §1.1: fixed wire kinds, independent of core ordinals.
fn raised(cs: Causes) -> u32 {
    for c in cs {
        return match c.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity => 7u32,
            OutOfTime => 8u32,
            Tape => 9u32,
        }
    }
    0u32
}

type DecodeFail { e: std.codec.DecodeError }

fn encoded[R](cr: std.codec.Codec[R], r: R) -> Outcome {
    let mut out: Bytes = list.new()
    match std.codec.encode(cr, r, mut out) {
        Ok(()) => limited_reply(take out),
        Error(c) => Failed(OutOfBytes(room(c))),
    }
}

// The compute adapter: decode A, call f and encode R, all inside `bound bytes n` and
// `isolate`. A budget the place cannot grant is Refused(Budget); exhaustion after entry
// is Failed(OutOfBytes); a fault is Failed(Raised).
fn adapt_compute[A, R](f: StaticFn[fn(take A) -> Result[R, Capacity]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], arg: Bytes, n: u64, s: u64) -> Outcome {
    let body = code.callable(f)
    let ran = bound bytes n {
        let run = scoped fn() -> Result[Result[Outcome, DecodeFail], OutOfTime] {
            bound steps s {
            match std.codec.decode(ca, arg) {
                Ok(Ok(take a)) => match body(take a) {
                    Ok(take r) => Ok(encoded(cr, r)),
                    Error(c) => Ok(Failed(OutOfBytes(room(c)))),
                },
                Ok(Error(e)) => Error(DecodeFail(e: e)),
                Error(c) => Ok(Failed(OutOfBytes(room(c)))),
            }
            }
        }
        isolate(run)
    }
    match take ran {
        Ok(Ok(Ok(Ok(Ok(take o))))) => take o,
        Ok(Ok(Ok(Ok(Error(d))))) => Refused(Malformed(bad(d.e))),
        Ok(Ok(Ok(Error(e)))) => Failed(OutOfTime(e.steps)),
        Ok(Ok(Error(cs))) => Failed(Raised(raised(cs))),
        Ok(Error(c)) => Failed(OutOfBytes(room(c))),
        Error(c) => Refused(Budget(room(c))),
    }
}

type Job[G: send, A, R]: send {
    f: StaticFn[fn(G, take A) -> Result[R, Capacity] waits],
    ca: std.codec.Codec[A],
    cr: std.codec.Codec[R],
    grant: G,
    arg: Bytes,
    steps: u64
}

// The granted adapter, the body of the task `start` spawns under `bytes n`.
fn adapt_granted[G: send, A, R](take j: Job[G, A, R]) -> Outcome waits {
    let allowance = j.steps
    let ran = bound steps allowance {
        let job = take j
        let body = code.callable(job.f)
        match std.codec.decode(job.ca, job.arg) {
            Ok(Ok(take a)) => match body(job.grant, take a) {
                Ok(take r) => encoded(job.cr, r),
                Error(c) => Failed(OutOfBytes(room(c))),
            },
            Ok(Error(e)) => Refused(Malformed(bad(e))),
            Error(c) => Failed(OutOfBytes(room(c))),
        }
    }
    match take ran { Ok(take o) => take o, Error(e) => Failed(OutOfTime(e.steps)) }
}

// Key = identity ++ fingerprint(A) ++ fingerprint(reply), each fingerprint u64 little-endian.
// The reply is the type the Returned bytes carry: Result[R, E] for transact, R for compute
// and granted (RUNNER-SPEC v2.11.2), so a change to E alone changes the Key.
fn described[A, R](identity: View[Bytes], kind: Kind, ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Result[(Bytes, Described), Capacity] {
    let args = std.codec.schema(ca)?
    let result = std.codec.schema(cr)?
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)?
    list.append(mut key, identity)?
    std.codec.put_u64(std.codec.fingerprint_of(args), mut key)?
    std.codec.put_u64(std.codec.fingerprint_of(result), mut key)?
    let mut id: Bytes = list.with_capacity(list.len(identity))?
    list.append(mut id, identity)?
    Ok((take key, Described(kind: kind, identity: take id, args: take args, result: take result)))
}

// The one insertion: a key already present is refused and the registry is unchanged.
fn insert[G: send, H: send](mut r: Registry[G, H], take key: Bytes, take d: Described, take s: Slot[G, H]) -> Result[(), RegisterError] {
    if map.contains(r.slots, key) {
        return Error(AlreadyRegistered(take key))
    }
    match list.reserve(mut r.described, 1u64) {
        Ok(()) => (),
        Error(c) => return Error(Full(c)),
    }
    match map.insert(mut r.slots, take key, take s) {
        Ok(()) => (),
        Error((c, _)) => return Error(Full(c)),
    }
    match list.push(mut r.described, take d) {
        Ok(()) => Ok(()),
        Error((c, _)) => Error(Full(c)),
    }
}

pub fn compute[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(take A) -> Result[R, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), Compute, ca, cr) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(arg: Bytes) -> Outcome { adapt_compute(f, ca, cr, arg, n, s) }
    match made {
        Ok(take run) => insert(mut r, take key, take d, Compute(take run)),
        Error((c, _)) => Error(Full(c)),
    }
}

pub fn granted[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(G, take A) -> Result[R, Capacity] waits], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), Granted, ca, cr) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(tasks: Tasks, take g: G, take arg: Bytes) -> Result[Task[Outcome], Capacity] {
        let j = Job(f: f, ca: ca, cr: cr, grant: take g, arg: take arg, steps: s)
        match task.spawn(tasks, bytes n, take j, adapt_granted) {
            Ok(take t) => Ok(take t),
            Error((c, _)) => Error(c),
        }
    }
    match made {
        Ok(take go) => insert(mut r, take key, take d, Granted(take go)),
        Error((c, _)) => Error(Full(c)),
    }
}

// The export list in registration order: the codec of List[Described].
pub fn describe[G: send, H: send](r: Registry[G, H], mut out: Bytes) -> Result[(), Capacity] {
    let c: std.codec.Codec[Described] = std.codec.of()
    std.codec.put_list(r.described, c, mut out)
}

pub type Exported: codec + send { described: Described, args_fp: u64, result_fp: u64 }

pub type Describe: codec + send { digest: Bytes, target: String, n_place: u64, exported: List[Exported] }

pub type DescribeError: codec + send = PlaceCapacity(Room) | AlreadyRegistered(Bytes)

fn launch_emit(data: Bytes) -> bool { false }

fn describe_registered[G: send, H: send](a: Args, take r: Registry[G, H]) -> Result[Bytes, Capacity] {
    let Registry(slots: take held_slots, described: take descriptions, checks: _, gone: _) = take r
    let mut exported: List[Exported] = list.with_capacity(list.len(descriptions))?
    for take d in descriptions {
        let args_fp = std.codec.fingerprint_of(d.args)
        let result_fp = std.codec.fingerprint_of(d.result)
        match list.push(mut exported, Exported(described: take d, args_fp: args_fp, result_fp: result_fp)) {
            Ok(()) => (),
            Error((c, _)) => return Error(c),
        }
    }
    let digest = launch_digest()?
    let target = launch_target(a)?
    let description = Describe(digest: take digest, target: take target, n_place: launch_word(0u64, 0u64), exported: take exported)
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let mut out: Bytes = list.new()
    std.codec.encode(codec, description, mut out)?
    Ok(take out)
}

fn describe_response[G: send, H: send](a: Args, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]]) -> Result[Bytes, RegisterError] {
    let run = code.callable(place)
    let ran = bound bytes launch_word(0u64, 0u64) {
        let mut r: Registry[G, H] = registry()
        let response: Result[Bytes, RegisterError] = match run(mut r) {
            Ok(()) => match describe_registered(a, take r) {
                Ok(take payload) => Ok(take payload),
                Error(c) => Error(Full(c)),
            },
            Error(take e) => Error(take e),
        }
        take response
    }
    match take ran {
        Ok(take answer) => take answer,
        Error(c) => Error(Full(c)),
    }
}

// The first branch precedes the caller's ordinary serve callback, including its
// store open, listener and every capability use. No n_place runtime argument.
pub fn main[G: send, H: send](a: Args, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn() -> Result[(), Exit] waits) -> Result[(), Exit] waits {
    if launch_word(5u64, 0u64) == 0u64 {
        return start_server()
    }
    match describe_response(a, place) {
        Ok(take payload) => if launch_emit(payload) { Ok(()) } else { Error(Exit(status: 1u8)) },
        Error(take e) => {
            let error: DescribeError = match take e {
                Full(c) => PlaceCapacity(room(c)),
                AlreadyRegistered(take key) => AlreadyRegistered(take key),
            }
            let codec: std.codec.Codec[DescribeError] = std.codec.of()
            let mut out: Bytes = list.new()
            match std.codec.encode(codec, error, mut out) {
                Ok(()) => { let _ = launch_emit(out) },
                Error(_) => (),
            }
            Error(Exit(status: 2u8))
        },
    }
}

// A compute call in the caller's task, under the entry's n. A key that names no compute
// entry is NoEntry.
pub fn call[G: send, H: send](r: Registry[G, H], key: Bytes, arg: Bytes) -> Outcome {
    match map.get(r.slots, key) {
        Some(Compute(run)) => run(arg),
        _ => Refused(NoEntry),
    }
}

// A granted call: a task under the entry's `bytes n` holding g. A key that names no
// granted entry is NoEntry; a task the place cannot grant is Budget.
pub fn start[G: send, H: send](r: Registry[G, H], tasks: Tasks, take g: G, key: Bytes, take arg: Bytes) -> Result[Task[Outcome], Refusal] {
    match map.get(r.slots, key) {
        Some(Granted(go)) => match go(tasks, take g, take arg) {
            Ok(take t) => Ok(take t),
            Error(c) => Error(Budget(room(c))),
        },
        _ => Error(NoEntry),
    }
}

pub fn finish(take t: Task[Outcome]) -> Outcome waits {
    match task.join(take t) {
        Ok(take o) => take o,
        Error(Failed(cs)) => Failed(Raised(raised(cs))),
        Error(Cancelled(cs)) => Failed(Raised(raised(cs))),
    }
}

// ---- R1 (RUNNER-SPEC v2.4 §2, §3): transact, the head, sessions and the publisher.

// Rule 10: every task that runs entries runs the place's one `place` function itself,
// here under `bytes n_place`, so the head's, the publisher's and each session's lists
// are the same list.
fn placed[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64) -> Result[Registry[G, H], RegisterError] {
    let go = code.callable(place)
    let built: Result[Result[Registry[G, H], RegisterError], Capacity] = bound bytes n_place {
        let mut r: Registry[G, H] = registry()
        match go(mut r) {
            Ok(()) => Ok(take r),
            Error(take e) => Error(take e),
        }
    }
    match take built {
        Ok(take x) => take x,
        Error(c) => Error(Full(c)),
    }
}

// A transact run, for the head: an effect to commit with its reply, a typed error whose
// reply is kept alone, a fault after entry, or a refusal that records nothing.
type Ran: send = Commit(Bytes) | Abort(Bytes) | Faulted(Fault) | Refuse(Refusal)

// The session's check (rule 5): the argument decodes under n, and the value is dropped.
// Running out of n is not a refusal; the head's run answers it with Failed(OutOfBytes).
fn check_arg[A](ca: std.codec.Codec[A], arg: Bytes, n: u64) -> Option[Refusal] {
    let seen = bound bytes n {
        match std.codec.decode(ca, arg) {
            Ok(Error(e)) => {
                let why: Refusal = Malformed(bad(e))
                Some(take why)
            },
            _ => None,
        }
    }
    match take seen {
        Ok(take o) => take o,
        Error(c) => Some(Budget(room(c))),
    }
}

// The transact adapter, inside the head's `store.run` (which isolates it): decode A, call
// f with the Tx and the handles, and encode its Result[R, E], all inside `bound bytes n`.
fn adapt_transact[H: send, A, R, E](f: StaticFn[fn(mut store.Tx, H, take A) -> Result[R, E]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], ce: std.codec.Codec[E], mut tx: store.Tx, h: H, arg: Bytes, n: u64) -> Ran {
    let body = code.callable(f)
    let tried = bound bytes n {
        match std.codec.decode(ca, arg) {
            Ok(Ok(take a)) => {
                let res = body(mut tx, h, take a)
                let kept = match res {
                    Ok(_) => true,
                    Error(_) => false,
                }
                let mut out: Bytes = list.new()
                match std.codec.put_result(res, cr, ce, mut out) {
                    Ok(()) => if list.len(out) > DONE_MAX - 20u64 {
                        { let stopped: Ran = Faulted(OutOfBytes(Room(requested: list.len(out), available: DONE_MAX - 20u64))); stopped }
                    } else if kept {
                        Commit(take out)
                    } else {
                        Abort(take out)
                    },
                    Error(c) => Faulted(OutOfBytes(room(c))),
                }
            },
            Ok(Error(e)) => Refuse(Malformed(bad(e))),
            Error(c) => Faulted(OutOfBytes(room(c))),
        }
    }
    match take tried {
        Ok(take r) => take r,
        Error(c) => Refuse(Budget(room(c))),
    }
}

pub fn transact[G: send, H: send, A: codec, R: codec, E: codec](mut r: Registry[G, H], f: StaticFn[fn(mut store.Tx, H, take A) -> Result[R, E]], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let ce: std.codec.Codec[E] = std.codec.of()
    let carried: std.codec.Codec[Result[R, E]] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), Transact, ca, carried) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    let revision: Option[Bytes] = match code.revision(f) {
        Some(v) => {
            let mut b: Bytes = list.new()
            if let Error(c) = list.append(mut b, v) {
                return Error(Full(c))
            }
            Some(take b)
        },
        None => None,
    }
    register_check(mut r, key, ca, n, s)?
    let check = fn(arg: Bytes) -> Option[Refusal] { check_arg(ca, arg, n) }
    let run = fn(mut tx: store.Tx, h: H, arg: Bytes) -> Ran { adapt_transact(f, ca, cr, ce, mut tx, h, arg, n) }
    match check {
        Ok(take c) => match run {
            Ok(take go) => insert(mut r, take key, take d, Transact(s, take revision, take c, take go)),
            Error((e, _)) => Error(Full(e)),
        },
        Error((e, _)) => Error(Full(e)),
    }
}

// ---- R2 (RUNNER-SPEC v2.11 §4): queries and their Covers.

// A Cover names one data-tree key range [low, high) of one table (I1), without reading it. It
// keeps that table's published value, erased once here (v2.11.1, STORE-SPEC AG3), so the
// publisher normalizes a Cover's initial rows and its changed rows alike (F10).
pub opaque type Cover: send {
    low: Bytes,
    high: Bytes,
    value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error]
}

pub fn cover[K, V](t: store.Shape[K, V], lo: store.Bound[K], hi: store.Bound[K]) -> Result[Cover, Capacity] {
    let (take low, take high) = match store.key_span(t, lo, hi) {
        Ok(Span(take l, take h)) => (take l, take h),
        Error(Full(c)) => return Error(c),
        _ => fail("runner: a Cover's bounds do not encode"),
    }
    let mine: store.Shape[K, V] = clone(t)?
    let made = fn(c: store.Change) -> Result[Option[Bytes], store.Error] { store.published_value(mine, c) }
    match made {
        Ok(take f) => Ok(Cover(low: take low, high: take high, value: take f)),
        Error((c, _)) => Error(c),
    }
}

// What a query run at a Snapshot gives the publisher: its Cover and read set, an Outcome
// that ends the subscription, or a store error, which is a Reset.
type Viewed { cover: Cover, reads: List[store.Read] }

type Queried = Covered(Viewed) | Stopped(Outcome) | Lost(store.Error)

// The query adapter: decode A and call f inside `look` (which isolates it), all inside
// `bound bytes n`. A fault, or exhaustion after entry, ends the subscription with Failed.
fn adapt_query[H: send, A](f: StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]], ca: std.codec.Codec[A], s: store.Snapshot, h: H, arg: Bytes, n: u64, steps: u64) -> Queried {
    let body = code.callable(f)
    let looked = bound bytes n {
        store.look(s, Some(steps), scoped fn(tx: store.Tx) -> Result[Cover, Outcome] {
            match std.codec.decode(ca, arg) {
                Ok(Ok(take a)) => match body(tx, h, take a) {
                    Ok(take c) => Ok(take c),
                    Error(c) => Error(Failed(OutOfBytes(room(c)))),
                },
                Ok(Error(e)) => Error(Refused(Malformed(bad(e)))),
                Error(c) => Error(Failed(OutOfBytes(room(c)))),
            }
        })
    }
    match take looked {
        Ok(Ok(Seen(take x))) => {
            let store.Seen(value: take v, version: _, reads: take reads) = take x
            match take v {
                Ok(take c) => Covered(Viewed(cover: take c, reads: take reads)),
                Error(take o) => Stopped(take o),
            }
        },
        Ok(Ok(Failed(cs))) => Stopped(Failed(Raised(raised(cs)))),
        Ok(Ok(Refused(c))) => Stopped(Failed(OutOfBytes(room(c)))),
        Ok(Ok(Stopped(e))) => Stopped(Failed(OutOfTime(e.steps))),
        Ok(Error(e)) => Lost(e),
        Error(c) => Stopped(Refused(Budget(room(c)))),
    }
}

// A query's rows travel in Batches under their tables' codecs, so its described result is
// the unit schema.
pub fn query[G: send, H: send, A: codec](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take key, take d) = match described(code.identity(f), Query, ca, cr) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(at: store.Snapshot, h: H, arg: Bytes) -> Queried { adapt_query(f, ca, at, h, arg, n, s) }
    match made {
        Ok(take run) => insert(mut r, take key, take d, Query(take run)),
        Error((c, _)) => Error(Full(c)),
    }
}

// ---- The publisher's subscriptions (G2, G3). A subscription keeps its Cover and read set at
// the base, never its rows (F4): rows are enumerated from the snapshots the publisher holds.
type Sub { session: u64, sub: u32, key: Bytes, arg: Bytes, cover: Cover, reads: List[store.Read] }

// What one step owes one session: at `version`, the subs whose whole initial result it
// carries, its rows and its Ended subs; or, with `reset`, a Reset and nothing else.
type Owe: send { session: u64, version: u64, complete: List[u32], rows: List[Row], ended: List[(u32, Outcome)], reset: bool }

type Board[G: send, H: send] { r: Registry[G, H], h: H, base: store.Snapshot, newest: Option[store.Snapshot], subs: List[Sub] }

// A Subscribe on a live (session, sub) replaces it.
fn find(subs: List[Sub], who: u64, sub: u32) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(subs) {
        if subs[i].session == who && subs[i].sub == sub {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn owe(mut owes: List[Owe], who: u64, version: u64) -> u64 {
    let mut i = 0u64
    while i < list.len(owes) {
        if owes[i].session == who {
            return i
        }
        i += 1u64
    }
    result.unwrap(list.push(mut owes, Owe(session: who, version: version, complete: list.new(), rows: list.new(), ended: list.new(), reset: false)))
    i
}

fn run_query[G: send, H: send](r: Registry[G, H], h: H, s: store.Snapshot, key: Bytes, arg: Bytes) -> Queried {
    match map.get(r.slots, key) {
        Some(Query(go)) => go(s, h, arg),
        _ => Stopped(Refused(NoEntry)),
    }
}

// The rows inside a Cover at s, each with its published value (F10).
fn cover_rows(s: store.Snapshot, c: Cover, sub: u32, mut out: List[Row]) -> Result[(), store.Error] {
    for ch in store.span_changes(s, c.low, c.high)? {
        let v = (c.value)(ch)?
        result.unwrap(list.push(mut out, Row(sub: sub, key: result.unwrap(clone(ch.tree_key)), value: take v)))
    }
    Ok(())
}

// G3: the query runs at the base, and its whole result goes in one owe naming it complete.
fn at_base[G: send, H: send](mut b: Board[G, H], who: u64, sub: u32, take key: Bytes, take arg: Bytes) -> Owe {
    if let Some(i) = find(b.subs, who, sub) {
        let _ = list.remove(mut b.subs, i)
    }
    let version = store.version(b.base)
    let mut o = Owe(session: who, version: version, complete: list.new(), rows: list.new(), ended: list.new(), reset: false)
    match run_query(b.r, b.h, b.base, key, arg) {
        Covered(take v) => {
            let Viewed(cover: take c, reads: take reads) = take v
            if let Error(_) = cover_rows(b.base, c, sub, mut o.rows) {
                o.rows = list.new()
                o.reset = true
                return take o
            }
            result.unwrap(list.push(mut o.complete, sub))
            result.unwrap(list.push(mut b.subs, Sub(session: who, sub: sub, key: take key, arg: take arg, cover: take c, reads: take reads)))
        },
        Stopped(take why) => result.unwrap(list.push(mut o.ended, (sub, take why))),
        Lost(_) => {
            o.reset = true
        },
    }
    take o
}

fn read_hit(reads: List[store.Read], d: List[store.Change]) -> bool {
    for ch in d {
        for r in reads {
            if store.reads_key(r, ch.tree_key) {
                return true
            }
        }
    }
    false
}

// The rerun's difference: the keys inside the old Cover at a against the keys inside the new
// Cover at b, removals included, each new or changed key with its published value at b.
fn rerun_rows(a: store.Snapshot, old: Cover, b: store.Snapshot, new: Cover, sub: u32, mut out: List[Row]) -> Result[(), store.Error] {
    let before = store.span_changes(a, old.low, old.high)?
    let after = store.span_changes(b, new.low, new.high)?
    let mut i = 0u64
    let mut j = 0u64
    while i < list.len(before) || j < list.len(after) {
        let gone = j == list.len(after) || (i < list.len(before) && before[i].tree_key < after[j].tree_key)
        if gone {
            result.unwrap(list.push(mut out, Row(sub: sub, key: result.unwrap(clone(before[i].tree_key)), value: None)))
            i += 1u64
            continue
        }
        let was = if i < list.len(before) && before[i].tree_key == after[j].tree_key {
            i += 1u64
            (old.value)(before[i - 1u64])?
        } else {
            None
        }
        let now = (new.value)(after[j])?
        if was != now {
            result.unwrap(list.push(mut out, Row(sub: sub, key: result.unwrap(clone(after[j].tree_key)), value: take now)))
        }
        j += 1u64
    }
    Ok(())
}

// The changed keys inside a Cover, with their published values at b.
fn covered_rows(d: List[store.Change], c: Cover, sub: u32, mut out: List[Row]) -> Result[(), store.Error] {
    for ch in d {
        if c.low <= ch.tree_key && ch.tree_key < c.high {
            let v = (c.value)(ch)?
            result.unwrap(list.push(mut out, Row(sub: sub, key: result.unwrap(clone(ch.tree_key)), value: take v)))
        }
    }
    Ok(())
}

// A session Reset loses all its subscriptions and owes nothing else.
fn reset_session(mut b: List[Sub], mut owes: List[Owe], who: u64, version: u64) {
    let mut i = 0u64
    while i < list.len(b) {
        if b[i].session == who {
            let _ = list.remove(mut b, i)
        } else {
            i += 1u64
        }
    }
    let k = owe(mut owes, who, version)
    owes[k].complete = list.new()
    owes[k].rows = list.new()
    owes[k].ended = list.new()
    owes[k].reset = true
}

// G2: one round from the base to the newest snapshot released.
fn round[G: send, H: send](mut b: Board[G, H]) -> List[Owe] {
    let mut owes: List[Owe] = list.new()
    let newest = match replace(mut b.newest, None) {
        Some(take s) => take s,
        None => return take owes,
    }
    let version = store.version(newest)
    let d = match store.changes(b.base, newest) {
        Ok(take x) => take x,
        Error(_) => {
            while list.len(b.subs) > 0u64 {
                let who = b.subs[0].session
                reset_session(mut b.subs, mut owes, who, version)
            }
            b.base = take newest
            return take owes
        },
    }
    let mut i = 0u64
    while i < list.len(b.subs) {
        let who = b.subs[i].session
        let sub = b.subs[i].sub
        let k = owe(mut owes, who, version)
        if owes[k].reset {
            i += 1u64
            continue
        }
        if !read_hit(b.subs[i].reads, d) {
            if let Error(_) = covered_rows(d, b.subs[i].cover, sub, mut owes[k].rows) {
                reset_session(mut b.subs, mut owes, who, version)
                i = 0u64
                continue
            }
            i += 1u64
            continue
        }
        match run_query(b.r, b.h, newest, b.subs[i].key, b.subs[i].arg) {
            Covered(take v) => {
                let Viewed(cover: take c, reads: take reads) = take v
                if let Error(_) = rerun_rows(b.base, b.subs[i].cover, newest, c, sub, mut owes[k].rows) {
                    reset_session(mut b.subs, mut owes, who, version)
                    i = 0u64
                    continue
                }
                b.subs[i].cover = take c
                b.subs[i].reads = take reads
                i += 1u64
            },
            Stopped(take why) => {
                result.unwrap(list.push(mut owes[k].ended, (sub, take why)))
                let _ = list.remove(mut b.subs, i)
            },
            Lost(_) => {
                reset_session(mut b.subs, mut owes, who, version)
                i = 0u64
            },
        }
    }
    b.base = take newest
    take owes
}

// The stream's reply at p is the Outcome's codec bytes (STORE-SPEC §1.8 reply).
fn reply(mut tx: store.Tx, stream: Bytes, p: u64, o: Outcome) -> Result[(), store.Error] {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let mut b: Bytes = list.new()
    match std.codec.encode(co, o, mut b) {
        Ok(()) => (),
        Error(c) => return Error(Full(c)),
    }
    store.reply(mut tx, stream, p, take b)
}

// ---- P2: the head (H1-H4) and its gate (V3, V4).

// A request at the head. The session computed its digest at ingress (store.request_digest
// over the requested key and the exact argument bytes, v2.11.3) and never takes one from a
// client.
pub opaque type Req: send {
    stream: Bytes,
    p: u64,
    key: Bytes,
    arg: Bytes,
    digest: store.RequestDigest,
    reply_to: Delivery
}

type Answer: send { to: Delivery, stream: Bytes, p: u64, outcome: Outcome }

// With a snapshot, a Release carries its group's durable version (V4). Without one it
// carries commitless answers, which the publisher sends at its base (V3).
pub opaque type Release: send {
    version: u64,
    snapshot: Option[store.Snapshot],
    answers: List[Answer]
}

// The publisher's one inbox (v2.12, ruled 2026-11-17: one mailbox per actor). The head's
// Releases, a session's join, its Subscribes and Unsubscribes, its leaving and the head's
// last word arrive here in send order, so a Subscribe is ordered against every Release (G3)
// without selection, which v1 lacks.
pub opaque type PubIn: send { e: ToPub }

type ToPub: send = Released(Release) | Joined(Join) | Subscribed(u64, u32, Bytes, Bytes) | Unsubscribed(u64, u32) | Left(u64) | Halt | Drained

// A session's join, on its first Subscribe: where its content goes, and where the
// publisher answers with the id it mints for the session.
// v2.14: a marked session (an HTTP group or one-shot read) sends the Receiver of its
// retirement mark, a channel it keeps the only Sender of and never sends on.
type Join: send { to: Delivery, told: Sender[u64], mark: Option[Receiver[()]], closed: Option[Receiver[()]] }

// The publisher's inbox, both ends. `post` gives each session a sender; place_head then
// takes the mailbox whole, its head sending Releases on the same channel.
pub opaque type Mailbox: send { to: Sender[PubIn], from: Receiver[PubIn] }

pub fn mailbox(n: u64) -> Result[Mailbox, Capacity] {
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(n)?
    Ok(Mailbox(to: take to, from: take from))
}

pub fn post(m: Mailbox) -> Sender[PubIn] {
    channel.sender(m.to)
}

// A stream's worker, from its commit until the gate releases its group.
type Worker: send { p: u64, digest: store.RequestDigest, version: u64, outcome: Outcome, waiters: List[Delivery] }

type Waiting: send { req: Req, parked: bool }

type Head[G: send, H: send] {
    db: store.Db,
    r: Registry[G, H],
    h: H,
    out: Sender[PubIn],
    busy: Map[Bytes, Worker],
    waiting: List[Waiting],
    group: List[Bytes],
    last: Option[store.Ticket]
}

type Publish[G: send, H: send]: send {
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    n_place: u64,
    h: H,
    base: store.Snapshot,
    from: Receiver[PubIn],
    ready: Sender[Option[RegisterError]]
}

// The publisher task runs `place` itself and tells the head whether it could.
fn publish[G: send, H: send](take p: Publish[G, H]) -> () waits {
    let Publish(place: place, n_place: n_place, h: take h, base: take base, from: take from, ready: take ready) = take p
    let r = match placed(place, n_place) {
        Ok(take x) => take x,
        Error(take e) => {
            let _ = channel.send(ready, Some(take e))
            return
        },
    }
    if let Error(_) = channel.send(ready, None) {
        return
    }
    publisher(take r, take h, take base, take from)
}

// Rule 10: the head and the publisher each run `place` under n_place. Rule 12: `handles`
// runs twice; the head keeps the first H and moves the second to the publisher it starts.
// A second call that moves the version fails the open. The publisher's base starts at the
// snapshot at open, so a Subscribe that arrives before any Release runs there.
pub fn place_head[G: send, H: send](take db: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, handles: StaticFn[fn(mut store.Db) -> Result[H, store.Error] waits], take inbox: Receiver[Req], take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    let r = match placed(place, n_place) {
        Ok(take x) => take x,
        Error(take e) => return Error(Place(take e)),
    }
    let mut owned = take db
    let make = code.callable(handles)
    let h = match make(mut owned) {
        Ok(take x) => take x,
        Error(e) => return Error(Store(e)),
    }
    let before = store.version(store.snapshot(owned))
    let h2 = match make(mut owned) {
        Ok(take x) => take x,
        Error(e) => return Error(Store(e)),
    }
    if store.version(store.snapshot(owned)) != before {
        return Error(HandlesChanged)
    }
    let Mailbox(to: take out, from: take from) = take mail
    let told: Result[(Sender[Option[RegisterError]], Receiver[Option[RegisterError]]), Capacity] = channel.new(1u64)
    let (ready, readied) = match take told {
        Ok(take pair) => take pair,
        Error(c) => return Error(Store(Full(c))),
    }
    let p = Publish(place: place, n_place: n_place, h: take h2, base: store.snapshot(owned), from: take from, ready: take ready)
    let publishing = match task.spawn(tasks, bytes n_publisher, take p, publish) {
        Ok(take t) => take t,
        Error((c, _)) => return Error(Store(Full(c))),
    }
    match channel.receive(readied) {
        Ok(None) => (),
        Ok(Some(take e)) => {
            let _ = task.join(take publishing)
            return Error(Place(take e))
        },
        // The task ended without a word: `place` already ran here, so the task's own
        // allowance could not hold it.
        Error(_) => {
            let _ = task.join(take publishing)
            return Error(Place(Full(Capacity(requested: n_publisher, available: 0u64))))
        },
    }
    let mut hd = Head(db: take owned, r: take r, h: take h, out: take out, busy: map.new(), waiting: list.new(), group: list.new(), last: None)
    let served = serve_head(mut hd, inbox)
    let Head(db: take kept, r: _, h: _, out: take last_word, busy: _, waiting: _, group: _, last: _) = take hd
    // Sessions hold senders to the inbox too, so the head ends the publisher by its last word.
    let _ = channel.send(last_word, PubIn(e: Halt))
    let _ = task.join(take publishing)
    match take served {
        Ok(()) => (),
        Error(e) => return Error(Store(e)),
    }
    match store.close(take kept) {
        Ok(()) => Ok(()),
        Error(e) => Error(Store(e)),
    }
}

// Arrivals first; then a waiting request whose stream has no worker; then the gate; and
// with nothing left, wait for an arrival. Every arrival clears the parks (H2).
fn serve_head[G: send, H: send](mut hd: Head[G, H], inbox: Receiver[Req]) -> Result[(), store.Error] waits {
    loop {
        match channel.try_receive(inbox) {
            Ok(take q) => {
                unpark(mut hd);
                route(mut hd, take q)?;
                continue
            },
            Error(_) => (),
        }
        if next_waiting(mut hd)? {
            continue
        }
        if list.len(hd.group) > 0u64 {
            gate(mut hd)?;
            continue
        }
        match channel.receive(inbox) {
            Ok(take q) => {
                unpark(mut hd);
                route(mut hd, take q)?
            },
            Error(_) => return Ok(()),
        }
    }
}

fn unpark[G: send, H: send](mut hd: Head[G, H]) {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        hd.waiting[i].parked = false;
        i += 1u64
    }
}

// H1: a request for its stream's worker position joins the waiters if its digest equals the
// worker's, and is otherwise answered Refused(RequestMismatch) as V3 without running (v2.11.3);
// another position waits.
fn route[G: send, H: send](mut hd: Head[G, H], take q: Req) -> Result[(), store.Error] waits {
    let running = match map.get(hd.busy, q.stream) {
        Some(w) => Some((w.p, w.digest == q.digest)),
        None => None,
    }
    match running {
        Some((p, same)) => if p == q.p && !same {
            commitless(mut hd, take q, Refused(RequestMismatch))
        } else if p == q.p {
            let Req(stream: take stream, p: _, key: _, arg: _, digest: _, reply_to: take to) = take q
            let mut w = match map.remove(mut hd.busy, stream) {
                Some(take x) => take x,
                None => return Ok(()),
            }
            result.unwrap(list.push(mut w.waiters, take to))
            result.unwrap(map.insert(mut hd.busy, take stream, take w))
            Ok(())
        } else {
            result.unwrap(list.push(mut hd.waiting, Waiting(req: take q, parked: false)))
            Ok(())
        },
        None => begin(mut hd, take q),
    }
}

// The first unparked waiting request whose stream has no worker starts.
fn next_waiting[G: send, H: send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        if !hd.waiting[i].parked && !map.contains(hd.busy, hd.waiting[i].req.stream) {
            let Waiting(req: take q, parked: _) = list.remove(mut hd.waiting, i)
            begin(mut hd, take q)?
            return Ok(true)
        }
        i += 1u64
    }
    Ok(false)
}

// H2 on the store's admit (STORE-SPEC v2.24). Below latest the store cannot say whether p
// ran these bytes (AH2), and at latest another digest is not this request (AH1): both are
// answered commitless (V3), Refused(HistoryUnavailable) or Refused(RequestMismatch), and
// neither marks the stream.
fn begin[G: send, H: send](mut hd: Head[G, H], take q: Req) -> Result[(), store.Error] waits {
    let a = match store.admit(mut hd.db, q.stream, q.p, q.digest) {
        Ok(take x) => take x,
        Error(Full(_)) => return commitless(mut hd, take q, Refused(Overloaded)),
        Error(e) => return Error(e),
    }
    match take a {
        Admitted(_) => execute(mut hd, take q),
        Abandoned(_) => execute(mut hd, take q),
        Duplicate(b) => {
            let co: std.codec.Codec[Outcome] = std.codec.of()
            match std.codec.decode(co, b) {
                Ok(Ok(take o)) => commitless(mut hd, take q, take o),
                _ => fail("runner: a stored reply does not decode"),
            }
        },
        Rejected(_) => {
            result.unwrap(list.push(mut hd.waiting, Waiting(req: take q, parked: true)))
            Ok(())
        },
        HistoryUnavailable => commitless(mut hd, take q, Refused(HistoryUnavailable)),
        RequestMismatch => commitless(mut hd, take q, Refused(RequestMismatch)),
    }
}

// What a failed transact run leaves: its reply, which the store keeps alone in the aborted
// run's frame (STORE-SPEC F2), or a refusal that records nothing.
type Kept = Alone(Outcome) | Nothing(Refusal)

// The effect run: the slot's body and its reply in one commit. It takes the head's parts
// as separate places, so the body can view the registry and handles while db is lent.
fn effect[G: send, H: send](mut db: store.Db, r: Registry[G, H], h: H, q: Req) -> Option[Result[store.Outcome[Outcome, Kept], store.Error]] waits {
    match map.get(r.slots, q.key) {
        Some(Transact(s, revision, _, go)) => Some(store.run(mut db, Some(s), scoped fn(mut tx: store.Tx) -> Result[Outcome, Kept] {
            match go(mut tx, h, q.arg) {
                Commit(take b) => {
                    let o = Returned(take b)
                    match answered(mut tx, q, o, revision) {
                        Ok(()) => Ok(take o),
                        Error(_) => Error(Nothing(Overloaded)),
                    }
                },
                Abort(take b) => keep_reply(mut tx, q, Returned(take b), revision),
                Faulted(take f) => keep_reply(mut tx, q, Failed(take f), revision),
                Refuse(take why) => Error(Nothing(take why)),
            }
        })),
        _ => None,
    }
}

// R5 (§7): a run's reply and its call record in one Tx: the requested key, the exact
// argument bytes, the stream, and the code.revision of the entry that ran.
fn answered(mut tx: store.Tx, q: Req, o: Outcome, revision: Option[Bytes]) -> Result[(), store.Error] {
    reply(mut tx, q.stream, q.p, o)?
    let rev = match revision {
        Some(b) => Some(copy_bytes(b)?),
        None => None,
    }
    store.record(mut tx, store.CallRecord(key: copy_bytes(q.key)?, args: copy_bytes(q.arg)?, stream: copy_bytes(q.stream)?, revision: take rev))
}

fn copy_bytes(b: Bytes) -> Result[Bytes, store.Error] {
    let mut out: Bytes = list.new()
    match list.append(mut out, b) {
        Ok(()) => Ok(take out),
        Error(c) => Error(Full(c)),
    }
}

// The revision a reply-only commit records for a faulted or stopped run of q's entry.
fn revision_of[G: send, H: send](r: Registry[G, H], key: Bytes) -> Option[Option[Bytes]] {
    match map.get(r.slots, key) {
        Some(Transact(_, revision, _, _)) => match revision {
            Some(b) => {
                let mut out: Bytes = list.new()
                result.unwrap(list.append(mut out, b))
                Some(Some(take out))
            },
            None => Some(None),
        },
        _ => None,
    }
}

fn keep_reply(mut tx: store.Tx, q: Req, take o: Outcome, revision: Option[Bytes]) -> Result[Outcome, Kept] {
    match answered(mut tx, q, o, revision) {
        Ok(()) => Error(Alone(take o)),
        Error(_) => Error(Nothing(Overloaded)),
    }
}

fn execute[G: send, H: send](mut hd: Head[G, H], take q: Req) -> Result[(), store.Error] waits {
    let tried = effect(mut hd.db, hd.r, hd.h, q)
    let ran = match take tried {
        Some(take x) => match take x {
            Ok(take y) => take y,
            Error(e) => return Error(e),
        },
        // §7's one exception: a gone entry's reply has no call record.
        None => return reply_only(mut hd, take q, Failed(Gone), None),
    }
    match take ran {
        Committed(take d) => {
            let store.Done(value: take o, ticket: t, info: i, reads: _) = take d
            worker(mut hd, take q, take o, t, i.id.version)
        },
        Aborted(take u) => match take u {
            store.Undone(value: Alone(take o), ticket: Some(t)) => {
                let version = store.version(store.snapshot(hd.db))
                worker(mut hd, take q, take o, t, version)
            },
            store.Undone(value: Alone(_), ticket: None) => fail("runner: an aborted run lost its reply"),
            store.Undone(value: Nothing(take why), ticket: _) => commitless(mut hd, take q, Refused(take why)),
        },
        Failed(cs) => {
            let rev = revision_of(hd.r, q.key)
            reply_only(mut hd, take q, Failed(Raised(raised(cs))), take rev)
        },
        Stopped(e) => {
            let rev = revision_of(hd.r, q.key)
            reply_only(mut hd, take q, Failed(OutOfTime(e.steps)), take rev)
        },
        Refused(_) => commitless(mut hd, take q, Refused(Overloaded)),
    }
}

// `record` is Some(the entry's revision) for a run's reply, which keeps its call record,
// and None for a gone entry's.
fn reply_alone(mut db: store.Db, q: Req, o: Outcome, record: Option[Option[Bytes]]) -> Result[store.Outcome[(), store.Error], store.Error] waits {
    store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        match record {
            Some(revision) => answered(mut tx, q, o, revision),
            None => reply(mut tx, q.stream, q.p, o),
        }
    })
}

// A reply with no effect: a run whose body only replies (STORE-SPEC §1.8).
fn reply_only[G: send, H: send](mut hd: Head[G, H], take q: Req, take o: Outcome, take record: Option[Option[Bytes]]) -> Result[(), store.Error] waits {
    let ran = reply_alone(mut hd.db, q, o, record)?
    match take ran {
        Committed(d) => worker(mut hd, take q, take o, d.ticket, d.info.id.version),
        Refused(_) => commitless(mut hd, take q, Refused(Overloaded)),
        Aborted(take u) => {
            let store.Undone(value: take e, ticket: _) = take u
            Error(take e)
        },
        Failed(_) => fail("runner: a reply-only commit faulted"),
        Stopped(e) => commitless(mut hd, take q, Failed(OutOfTime(e.steps))),
    }
}

fn worker[G: send, H: send](mut hd: Head[G, H], take q: Req, take o: Outcome, t: store.Ticket, version: u64) -> Result[(), store.Error] {
    let Req(stream: take stream, p: p, key: _, arg: _, digest: d, reply_to: take to) = take q
    let mut waiters: List[Delivery] = list.new()
    result.unwrap(list.push(mut waiters, take to))
    let named: Bytes = result.unwrap(clone(stream))
    result.unwrap(map.insert(mut hd.busy, take named, Worker(p: p, digest: d, version: version, outcome: take o, waiters: take waiters)))
    result.unwrap(list.push(mut hd.group, take stream))
    hd.last = Some(t)
    Ok(())
}

// V3: a commitless answer goes at once, in a snapshot-less Release behind every earlier
// Release on the one FIFO to the publisher.
fn commitless[G: send, H: send](mut hd: Head[G, H], take q: Req, take o: Outcome) -> Result[(), store.Error] waits {
    let Req(stream: take stream, p: p, key: _, arg: _, digest: _, reply_to: take to) = take q
    let mut answers: List[Answer] = list.new()
    result.unwrap(list.push(mut answers, Answer(to: take to, stream: take stream, p: p, outcome: take o)))
    let _ = channel.send(hd.out, PubIn(e: Released(Release(version: 0u64, snapshot: None, answers: take answers))))
    Ok(())
}

// H3, V4: one durable for the group, then each worker's Release at the group's durable
// version, in commit order; the workers end, and the waiting requests may start.
fn gate[G: send, H: send](mut hd: Head[G, H]) -> Result[(), store.Error] waits {
    if let Some(t) = replace(mut hd.last, None) {
        store.durable(mut hd.db, t)?
    }
    let d = store.version(store.snapshot(hd.db))
    let group = replace(mut hd.group, list.new())
    for stream in group {
        let w = match map.remove(mut hd.busy, stream) {
            Some(take x) => take x,
            None => continue,
        }
        let Worker(p: p, digest: _, version: _, outcome: take o, waiters: take waiters) = take w
        let mut answers: List[Answer] = list.new()
        for take to in waiters {
            let s: Bytes = result.unwrap(clone(stream))
            let each: Outcome = result.unwrap(clone(o))
            result.unwrap(list.push(mut answers, Answer(to: take to, stream: take s, p: p, outcome: take each)))
        }
        let _ = channel.send(hd.out, PubIn(e: Released(Release(version: d, snapshot: Some(store.snapshot(hd.db)), answers: take answers))))
    }
    unpark(mut hd)
    Ok(())
}

// ---- The publisher, on its one inbox. A Release with a snapshot runs one G2 round to it
// and moves the base there; the round's content goes to each joined session before the
// Release's answers, all at the new base (G1). A Release without one carries commitless
// answers at the base (V3). A Subscribe runs at the base (G3), in its place among Releases.
//
// The publisher never blocks on a session (L23): every send to an owner is a try_send. A
// closed inbox drops that session's subs. A full one ends each sub whose content did not fit
// with Ended(sub, Refused(Overloaded)); the client resubscribes (WIRE-SPEC D3). That Ended
// (or a Reset) waits on the session's ledger, and a Told on `waiting`, until the inbox takes
// it; the publisher holds no subscription content. The ledger is retried after every message
// and before a session's next content, so it reaches the owner ahead of that content. A
// retried Told is told at the current base, which is still >= its commit (rule 9).
type Joiner { who: u64, to: Delivery, closed: Option[Receiver[()]], ended: List[(u32, Outcome)], reset: bool, mark: Option[Receiver[()]] }

// One try_send to an owner: taken, bounced back by a full inbox, or shut.
type Offered = Took | Bounced(Event) | Shut

type Delivery: send = Seam(Sender[Event]) | Wire(Sender[WireEvent])

fn offer(to: Delivery, take e: Event) -> Offered {
    if let Wire(sender) = to {
        return match channel.try_send(sender, wire_event(FromRunner(take e))) {
            Ok(()) => Took,
            Error(Full(WireEvent(e: FromRunner(take back)))) => Bounced(take back),
            _ => Shut,
        }
    }
    let sender = match to { Seam(sender) => sender, _ => fail("runner: delivery") }
    match channel.try_send(sender, take e) {
        Ok(_) => Took,
        Error(Full(take x)) => Bounced(take x),
        Error(Closed(_)) => Shut,
    }
}

fn publisher[G: send, H: send](take r: Registry[G, H], take h: H, take base: store.Snapshot, take from: Receiver[PubIn]) -> () waits {
    let mut at = store.version(base)
    let mut b = Board(r: take r, h: take h, base: take base, newest: None, subs: list.new())
    let mut joined: List[Joiner] = list.new()
    let mut waiting: List[Answer] = list.new()
    let mut minted = 0u64
    loop {
        let got = match channel.receive(from) {
            Ok(take x) => take x,
            Error(_) => return,
        }
        let PubIn(e: take e) = take got
        match take e {
            Halt => return,
            Released(take rel) => {
                let Release(version: v, snapshot: take snap, answers: take answers) = take rel
                if let Some(take s) = take snap {
                    at = v
                    b.newest = Some(take s)
                    let owes = round(mut b)
                    deliver(mut b, mut joined, take owes)
                }
                retell(mut waiting, at)
                for take a in answers {
                    tell_owner(mut waiting, take a, at)
                }
            },
            Joined(take j) => {
                let Join(to: take to, told: take told, mark: take mark, closed: take closed) = take j
                minted += 1u64
                let wake: Option[Sender[WireEvent]] = match to { Wire(sender) => Some(channel.sender(sender)), _ => None }
                result.unwrap(list.push(mut joined, Joiner(who: minted, to: take to, closed: take closed, ended: list.new(), reset: false, mark: take mark)))
                let _ = channel.try_send(told, minted)
                if let Some(sender) = wake { let _ = channel.try_send(sender, wire_event(JoinReady)) }
            },
            Subscribed(who, sub, take key, take arg) => if let Some(i) = joiner(joined, who) {
                unend(mut joined[i].ended, sub)
                let mut owes: List[Owe] = list.new()
                result.unwrap(list.push(mut owes, at_base(mut b, who, sub, take key, take arg)))
                deliver(mut b, mut joined, take owes)
            },
            Unsubscribed(who, sub) => if let Some(i) = find(b.subs, who, sub) {
                let _ = list.remove(mut b.subs, i)
            },
            Left(who) => forget(mut b.subs, mut joined, who),
            // An owner made room (v2.13), or a marked session ended (v2.14): the sweep and the
            // retry below are the whole of it.
            Drained => (),
        }
        sweep(mut b.subs, mut joined)
        settle(mut b.subs, mut joined, mut waiting, at)
    }
}

// An answer told at `at`, or kept on `waiting` while its owner's inbox is full.
fn tell_owner(mut waiting: List[Answer], take a: Answer, at: u64) {
    let Answer(to: take to, stream: take stream, p: p, outcome: take o) = take a
    match offer(to, Event(e: Answered(Told(version: at, stream: take stream, p: p, outcome: take o)))) {
        Bounced(take back) => {
            let Event(e: take e) = take back
            match take e {
                Answered(take t) => {
                    let Told(version: _, stream: take s, p: q, outcome: take u) = take t
                    result.unwrap(list.push(mut waiting, Answer(to: take to, stream: take s, p: q, outcome: take u)))
                },
                _ => (),
            }
        },
        _ => (),
    }
}

// A resubscribed sub's waiting Ended is moot: the new Subscribe's Batch replaces it.
fn unend(mut ended: List[(u32, Outcome)], sub: u32) {
    let mut i = 0u64
    while i < list.len(ended) {
        if ended[i].0 == sub {
            let _ = list.remove(mut ended, i)
        } else {
            i += 1u64
        }
    }
}

// Retry every waiting Ended, Reset and Told.
fn settle(mut subs: List[Sub], mut joined: List[Joiner], mut waiting: List[Answer], at: u64) {
    let mut i = 0u64
    while i < list.len(joined) {
        let closed = match joined[i].closed { Some(from) => match channel.try_receive(from) { Ok(()) => true, _ => false }, _ => false }
        if closed {
            let who = joined[i].who
            forget(mut subs, mut joined, who)
            continue
        }
        match catch_up(mut joined[i], at) {
            Gone => {
                let who = joined[i].who
                forget(mut subs, mut joined, who)
            },
            _ => {
                i += 1u64
            },
        }
    }
    retell(mut waiting, at)
}

// Every waiting answer, oldest first, before any newer one.
fn retell(mut waiting: List[Answer], at: u64) {
    let retry = replace(mut waiting, list.new())
    for take a in retry {
        tell_owner(mut waiting, take a, at)
    }
}

type Ledger = Clear | Behind | Gone

// Send a session's waiting Ended subs (or its Reset) before anything else of its own.
fn catch_up(mut j: Joiner, at: u64) -> Ledger {
    if !j.reset && list.len(j.ended) == 0u64 {
        return Clear
    }
    let owed = Owe(session: j.who, version: at, complete: list.new(), rows: list.new(), ended: replace(mut j.ended, list.new()), reset: j.reset)
    match offer(j.to, Event(e: Content(take owed))) {
        Took => {
            j.reset = false
            Clear
        },
        Bounced(take back) => {
            let Event(e: take e) = take back
            match take e {
                Content(take x) => {
                    let Owe(session: _, version: _, complete: _, rows: _, ended: take ended, reset: _) = take x
                    j.ended = take ended
                },
                _ => (),
            }
            Behind
        },
        Shut => Gone,
    }
}

// A full inbox bounced this content: each sub it named (complete or a row) ends Overloaded,
// its Ended subs wait, and a Reset waits and covers them all.
fn overloaded(mut subs: List[Sub], mut j: Joiner, take back: Event) {
    let Event(e: take e) = take back
    let o = match take e {
        Content(take o) => take o,
        _ => return,
    }
    let Owe(session: who, version: _, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    let mut cut: List[u32] = take complete
    for r in rows {
        if !list.contains(cut, r.sub) {
            result.unwrap(list.push(mut cut, r.sub))
        }
    }
    for sub in cut {
        if let Some(i) = find(subs, who, sub) {
            let _ = list.remove(mut subs, i)
        }
    }
    if reset || j.reset {
        j.reset = true
        j.ended = list.new()
        return
    }
    for take x in ended {
        result.unwrap(list.push(mut j.ended, take x))
    }
    for sub in cut {
        result.unwrap(list.push(mut j.ended, (sub, Refused(Overloaded))))
    }
}

fn joiner(joined: List[Joiner], who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(joined) {
        if joined[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

// Each owe that carries anything goes to its session after that session's ledger; a full
// inbox (or a ledger still waiting) ends the subs it names, a closed one forgets the session.
fn deliver[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], take owes: List[Owe]) {
    for take o in owes {
        if !o.reset && list.len(o.complete) == 0u64 && list.len(o.rows) == 0u64 && list.len(o.ended) == 0u64 {
            continue
        }
        let who = o.session
        if let Some(i) = joiner(joined, who) {
            let sent = match catch_up(mut joined[i], o.version) {
                Clear => offer(joined[i].to, Event(e: Content(take o))),
                Behind => Bounced(Event(e: Content(take o))),
                Gone => Shut,
            }
            match sent {
                Took => (),
                Bounced(take back) => overloaded(mut b.subs, mut joined[i], take back),
                Shut => forget(mut b.subs, mut joined, who),
            }
        }
    }
}

// v2.14: after every message but Halt, in join order, a marked session whose mark answers
// Closed has ended, and is retired: its subscriptions, its ledger and mark (in its Joiner)
// go. The retry pass that follows drops its waiting Told's, whose inbox is closed (Shut).
fn sweep(mut subs: List[Sub], mut joined: List[Joiner]) {
    let mut i = 0u64
    while i < list.len(joined) {
        let ended = match joined[i].mark {
            Some(m) => match channel.try_receive(m) {
                Error(Closed) => true,
                _ => false,
            },
            None => false,
        }
        if ended {
            let who = joined[i].who
            forget(mut subs, mut joined, who)
        } else {
            i += 1u64
        }
    }
}

fn forget(mut subs: List[Sub], mut joined: List[Joiner], who: u64) {
    let mut i = 0u64
    while i < list.len(subs) {
        if subs[i].session == who {
            let _ = list.remove(mut subs, i)
        } else {
            i += 1u64
        }
    }
    if let Some(j) = joiner(joined, who) {
        let _ = list.remove(mut joined, j)
    }
}

// ---- §3: sessions. A client's call, in the session clock's mono_ns.
pub type Call: send { stream: Bytes, p: u64, key: Bytes, arg: Bytes, deadline: u64 }

// The head's answer to one send at the publisher's base: one Batch outcome row before batching.
type Told: send { version: u64, stream: Bytes, p: u64, outcome: Outcome }

// What a session hands its client, before the wire Frame (WIRE-SPEC §3): the Frame's Batch,
// Ended and Reset with each answered send named by the store's stream key, until R3 gives
// sessions stream slots. A KeyedBatch at `version` names in `complete` each sub whose whole
// initial result it carries (F11), and carries the wire's subscription Rows (F10: the
// data-tree key and the published value at `version`, None for a removal) and KeyedDone
// rows, one per send answered.
pub type KeyedDone: send { stream: Bytes, p: u64, outcome: Outcome }

pub type KeyedBatch: send { version: u64, complete: List[u32], rows: List[Row], outcomes: List[KeyedDone] }

pub type Down: send = Batched(KeyedBatch) | Ended(u32, Outcome) | Reset

type Tick: send { stream: Bytes, p: u64, generation: u64 }

// A session has one inbox, because v1 has no selection: its client's calls, Subscribes and
// Unsubscribes, the publisher's answers and content, and its own deadline timers.
type Received: send = Asked(Call) | Answered(Told) | Expired(Tick) | Closing | Subscribing(u32, Bytes, Bytes) | Unsubscribing(u32) | Content(Owe)

pub opaque type Event: send { e: Received }

pub fn ask(take c: Call) -> Event {
    Event(e: Asked(take c))
}

pub fn hang_up() -> Event {
    Event(e: Closing)
}

// A client's Subscribe of `sub` to the query `key` with argument `arg`, and its Unsubscribe.
pub fn subscribe(sub: u32, take key: Bytes, take arg: Bytes) -> Event {
    Event(e: Subscribing(sub, take key, take arg))
}

pub fn unsubscribe(sub: u32) -> Event {
    Event(e: Unsubscribing(sub))
}

// A forwarded position keeps its slot until the head's answer arrives (V2), with one
// Owed per send of it not yet answered (rule 5: one Outcome per send). Each send has its
// own deadline timer: the timer answers that send alone with Abandoned, and the head's
// answer goes once to each send still owed, so to none after Abandoned without a re-send.
// Dropping an Owed cancels its timer (CONC-8). The slot table counts max(1, owed sends)
// per held position, at most 1 + q in all (V2): a joined send takes a slot.
type Owed { generation: u64, timer: Task[()] }

// A held position: the request digest of the send that forwarded it (32 B, v2.11.3) and
// its owed sends. A later send joins only with an equal digest.
type Held { digest: store.RequestDigest, owed: List[Owed] }

fn slots(owed: u64) -> u64 {
    if owed > 1u64 { owed } else { 1u64 }
}

type Timer: send { clock: Clock, at: u64, to: Sender[Event], stream: Bytes, p: u64, generation: u64 }

fn timer(take t: Timer) -> () waits {
    host.sleep_until(t.clock, t.at)
    let Timer(clock: _, at: _, to: take to, stream: take stream, p: p, generation: g) = take t
    let _ = channel.send(to, Event(e: Expired(Tick(stream: take stream, p: p, generation: g))))
}

type Session[G: send, H: send]: send {
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    n_place: u64,
    inbox: Receiver[Event],
    me: Sender[Event],
    head: Sender[Req],
    publisher: Sender[PubIn],
    client: Sender[Down],
    clock: Clock,
    tasks: Tasks,
    q: u64,
    marked: bool
}

// A session as a task under `bytes n_session`: it runs `place` itself under n_place
// (rule 10), forwards calls to the head and Subscribes to the publisher, and answers its
// client on `client`. The returned
// sender is the client's way in; the task ends with Place's error if `place` fails. A
// `marked` session (v2.14: an HTTP group or one-shot read) ends without waiting on the
// publisher, and its joiner uses `join_marked`; an unmarked one (WebSocket) sends `Left`.
pub fn connect[G: send, H: send](tasks: Tasks, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, head: Sender[Req], to_publisher: Sender[PubIn], take client: Sender[Down], clock: Clock, q: u64, n_session: u64, marked: bool) -> Result[(Sender[Event], Task[Result[(), RegisterError]]), Capacity] {
    let (tx, rx): (Sender[Event], Receiver[Event]) = channel.new(INBOX)?
    let s = Session(place: place, n_place: n_place, inbox: take rx, me: channel.sender(tx), head: channel.sender(head), publisher: channel.sender(to_publisher), client: take client, clock: clock, tasks: tasks, q: q, marked: marked)
    match task.spawn(tasks, bytes n_session, take s, session) {
        Ok(take t) => Ok((take tx, take t)),
        Error((c, _)) => Error(c),
    }
}

// v2.14: a marked session's joiner. A failed or cancelled session skipped its own end, so
// whatever the outcome, the joiner offers the publisher one Drained, never waiting.
pub fn join_marked[R: send](take t: Task[R], to_publisher: Sender[PubIn]) -> Result[R, JoinError] waits {
    let got = task.join(take t)
    let _ = channel.try_send(to_publisher, PubIn(e: Drained))
    got
}

fn slot_key(stream: Bytes, p: u64) -> Bytes {
    let mut k: Bytes = result.unwrap(list.with_capacity(list.len(stream) + 8u64))
    result.unwrap(list.append(mut k, stream))
    result.unwrap(std.codec.put_u64(p, mut k))
    k
}

// V1: what the session answers itself, before forwarding.
fn refusal[G: send, H: send](r: Registry[G, H], s: Session[G, H], c: Call) -> Option[Outcome] {
    if c.deadline <= host.mono_ns(s.clock) {
        return Some(Refused(Deadline))
    }
    match map.get(r.slots, c.key) {
        Some(Compute(run)) => Some(run(c.arg)),
        Some(Transact(_, _, check, _)) => match check(c.arg) {
            Some(take why) => Some(Refused(take why)),
            None => None,
        },
        _ => Some(Refused(NoEntry)),
    }
}

// One Outcome row, in its own KeyedBatch at `version`.
fn tell(to: Sender[Down], version: u64, take stream: Bytes, p: u64, take o: Outcome) -> () waits {
    let mut outcomes: List[KeyedDone] = list.new()
    result.unwrap(list.push(mut outcomes, KeyedDone(stream: take stream, p: p, outcome: take o)))
    let _ = channel.send(to, Batched(KeyedBatch(version: version, complete: list.new(), rows: list.new(), outcomes: take outcomes)))
}

fn session[G: send, H: send](take s: Session[G, H]) -> Result[(), RegisterError] waits {
    let r = placed(s.place, s.n_place)?
    let mut id: Option[u64] = None
    let mut mark: Option[Sender[()]] = None
    sessioned(s, r, mut id, mut mark)
    // v2.14: a marked session drops its inbox and its mark, then offers one Drained; nothing
    // waits. The publisher's next sweep retires it.
    if s.marked {
        mark = None
        let Session(place: _, n_place: _, inbox: _, me: _, head: _, publisher: take to_pub, client: _, clock: _, tasks: _, q: _, marked: _) = take s
        if let Some(_) = id {
            let _ = channel.try_send(to_pub, PubIn(e: Drained))
        }
        return Ok(())
    }
    if let Some(n) = id {
        let _ = channel.send(s.publisher, PubIn(e: Left(n)))
    }
    Ok(())
}

// The session's first Subscribe joins it to the publisher, which mints its id. A marked
// session makes its mark here and keeps the Sender in `mark` (v2.14).
fn join_publisher[G: send, H: send](s: Session[G, H], mut mark: Option[Sender[()]]) -> Option[u64] waits {
    let made: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(1u64)
    let (told, hear) = match take made {
        Ok(take pair) => take pair,
        Error(_) => return None,
    }
    let mut held: Option[Receiver[()]] = None
    if s.marked {
        let made_mark: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
        match take made_mark {
            Ok(take pair) => {
                let (keep, give) = take pair
                mark = Some(take keep)
                held = Some(take give)
            },
            Error(_) => return None,
        }
    }
    if let Error(_) = channel.send(s.publisher, PubIn(e: Joined(Join(to: Seam(channel.sender(s.me)), told: take told, mark: take held, closed: None)))) {
        return None
    }
    match channel.receive(hear) {
        Ok(n) => Some(n),
        Error(_) => None,
    }
}

// The publisher's content for this session: one Batch with its complete subs and rows (G3:
// a sub's whole initial result in the Batch that names it), then its Ended subs; or a Reset.
// `dropped` holds the subs whose Unsubscribe met a full PubIn (v2.12 item 3): the publisher
// keeps them, and the owner drops their rows and Endeds until a Batch completes the sub's
// resubscription, an Ended ends it, or a Reset ends them all.
fn hand(to: Sender[Down], take o: Owe, mut dropped: List[u32]) -> () waits {
    let Owe(session: _, version: v, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    if reset {
        list.clear(mut dropped)
        let _ = channel.send(to, Reset)
        return
    }
    for sub in complete {
        forgive(mut dropped, sub)
    }
    let heard = unheard(take rows, dropped)
    if list.len(complete) > 0u64 || list.len(heard) > 0u64 {
        let _ = channel.send(to, Batched(KeyedBatch(version: v, complete: take complete, rows: take heard, outcomes: list.new())))
    }
    for take e in take ended {
        let (sub, take why) = take e
        if has_sub(dropped, sub) {
            forgive(mut dropped, sub)
        } else {
            let _ = channel.send(to, Ended(sub, take why))
        }
    }
}

fn has_sub(subs: List[u32], sub: u32) -> bool {
    for s in subs {
        if s == sub {
            return true
        }
    }
    false
}

fn forgive(mut dropped: List[u32], sub: u32) {
    let mut i = 0u64
    while i < list.len(dropped) {
        if dropped[i] == sub {
            let _ = list.remove(mut dropped, i)
        } else {
            i += 1u64
        }
    }
}

// The rows of subs not in `dropped`.
fn unheard(take rows: List[Row], dropped: List[u32]) -> List[Row] {
    if list.len(dropped) == 0u64 {
        return take rows
    }
    let mut kept: List[Row] = list.new()
    for take w in take rows {
        if !has_sub(dropped, w.sub) {
            result.unwrap(list.push(mut kept, take w))
        }
    }
    kept
}

// A session owner's inbox capacity: C, the run of takes after which a joined owner wakes the
// publisher (v2.13).
const INBOX: u64 = 64u64

// A joined owner's take (v2.13, L24): try_receive first, and a run of takes that finding the
// inbox empty resets. At C takes in a run it offers the publisher one Drained, never waiting
// (a full PubIn drops it), so a ledger a full inbox bounced is retried once the owner has made
// room, with no other traffic. An owner that keeps up finds its inbox empty first and never
// offers; one that has not joined keeps no run.
fn take_event[G: send, H: send](s: Session[G, H], joined: bool, mut run: u64) -> Option[Event] waits {
    if !joined {
        return match channel.receive(s.inbox) {
            Ok(take x) => Some(take x),
            Error(_) => None,
        }
    }
    let got = match channel.try_receive(s.inbox) {
        Ok(take x) => take x,
        Error(Empty) => {
            run = 0u64
            match channel.receive(s.inbox) {
                Ok(take x) => take x,
                Error(_) => return None,
            }
        },
        Error(_) => return None,
    }
    run += 1u64
    if run == INBOX {
        let _ = channel.try_send(s.publisher, PubIn(e: Drained))
        run = 0u64
    }
    Some(take got)
}

fn sessioned[G: send, H: send](s: Session[G, H], r: Registry[G, H], mut id: Option[u64], mut mark: Option[Sender[()]]) -> () waits {
    let mut dropped: List[u32] = list.new()
    let mut held: Map[Bytes, Held] = map.new()
    let mut used = 0u64
    let mut last = 0u64
    let mut generation = 0u64
    let mut run = 0u64
    loop {
        let joined = match id {
            Some(_) => true,
            None => false,
        }
        let got = match take_event(s, joined, mut run) {
            Some(take x) => take x,
            None => return,
        }
        let Event(e: take e) = take got
        match take e {
            Closing => return,
            Asked(take c) => {
                if let Some(take o) = refusal(r, s, c) {
                    let Call(stream: take stream, p: p, key: _, arg: _, deadline: _) = take c
                    tell(s.client, last, take stream, p, take o);
                    continue
                }
                let k = slot_key(c.stream, c.p)
                let d = store.request_digest(c.key, c.arg)
                let (fresh, owing, same) = match map.get(held, k) {
                    Some(h) => (false, list.len(h.owed), h.digest == d),
                    None => (true, 0u64, true),
                }
                // V2 (v2.11.3): other bytes at a held position are a protocol error. The
                // session ends, Close (1008) on this seam, with no row for either send:
                // rows name only (stream, p), so the two answers could not be told apart.
                if !same {
                    return
                }
                // A new position or a join takes a slot; a re-send of an Abandoned position
                // whose slot is still held reuses it.
                let grows = fresh || owing > 0u64
                if grows && used >= s.q + 1u64 {
                    let Call(stream: take stream, p: p, key: _, arg: _, deadline: _) = take c
                    tell(s.client, last, take stream, p, Refused(Overloaded));
                    continue
                }
                generation += 1u64
                let named: Bytes = result.unwrap(clone(c.stream))
                let t = Timer(clock: s.clock, at: c.deadline, to: channel.sender(s.me), stream: take named, p: c.p, generation: generation)
                let timing = match task.spawn(s.tasks, bytes 4096u64, take t, timer) {
                    Ok(take x) => take x,
                    Error(_) => {
                        let Call(stream: take stream, p: p, key: _, arg: _, deadline: _) = take c
                        tell(s.client, last, take stream, p, Refused(Overloaded));
                        continue
                    },
                }
                if grows {
                    used += 1u64
                }
                let mine = Owed(generation: generation, timer: take timing)
                // V2: a position already forwarded is joined locally, never forwarded twice.
                if fresh {
                    let Call(stream: take stream, p: p, key: take key, arg: take arg, deadline: _) = take c
                    let q = Req(stream: take stream, p: p, key: take key, arg: take arg, digest: d, reply_to: Seam(channel.sender(s.me)))
                    if let Error(_) = channel.send(s.head, take q) {
                        return
                    }
                    let mut owed: List[Owed] = list.new()
                    result.unwrap(list.push(mut owed, take mine))
                    result.unwrap(map.insert(mut held, take k, Held(digest: d, owed: take owed)))
                } else {
                    let mut h = option.unwrap(map.remove(mut held, k))
                    result.unwrap(list.push(mut h.owed, take mine))
                    result.unwrap(map.insert(mut held, take k, take h))
                }
            },
            Answered(take f) => {
                let owed = match map.remove(mut held, slot_key(f.stream, f.p)) {
                    Some(h) => {
                        used -= slots(list.len(h.owed))
                        list.len(h.owed)
                    },
                    None => 0u64,
                }
                if owed > 0u64 {
                    last = f.version
                    let Told(version: v, stream: take stream, p: p, outcome: take o) = take f
                    for _ in 1u64 .. owed {
                        let each: Outcome = result.unwrap(clone(o))
                        tell(s.client, v, result.unwrap(clone(stream)), p, take each)
                    }
                    tell(s.client, v, take stream, p, take o)
                }
            },
            // A Subscribe on a key that names no query is answered here, with nothing sent on.
            // The first Subscribe joins the session to the publisher.
            Subscribing(sub, take key, take arg) => {
                let known = match map.get(r.slots, key) {
                    Some(Query(_)) => true,
                    _ => false,
                }
                if !known {
                    let _ = channel.send(s.client, Ended(sub, Refused(NoEntry)))
                    continue
                }
                let who = match id {
                    Some(n) => n,
                    None => match join_publisher(s, mut mark) {
                        Some(n) => n,
                        None => return,
                    },
                }
                id = Some(who)
                // v2.12 item 3: the owner waits only on its own inbox. A full PubIn refuses
                // this Subscribe, and nothing is registered.
                match channel.try_send(s.publisher, PubIn(e: Subscribed(who, sub, take key, take arg))) {
                    Ok(_) => (),
                    Error(Full(_)) => {
                        let _ = channel.send(s.client, Ended(sub, Refused(Overloaded)))
                    },
                    Error(Closed(_)) => return,
                }
            },
            // An Unsubscribe that meets a full PubIn is applied here: the publisher keeps the
            // sub, and this owner drops its rows (v2.12 item 3).
            Unsubscribing(sub) => if let Some(who) = id {
                match channel.try_send(s.publisher, PubIn(e: Unsubscribed(who, sub))) {
                    Ok(_) => (),
                    Error(Full(_)) => if !has_sub(dropped, sub) {
                        result.unwrap(list.push(mut dropped, sub))
                    },
                    Error(Closed(_)) => return,
                }
            },
            Content(take o) => hand(s.client, take o, mut dropped),
            // One send's own deadline: that send alone is answered Abandoned; the slot stays.
            Expired(t) => {
                let k = slot_key(t.stream, t.p)
                if let Some(take found) = map.remove(mut held, k) {
                    let mut h = take found
                    let mut i = 0u64
                    let mut hit = false
                    while !hit && i < list.len(h.owed) {
                        if h.owed[i].generation == t.generation {
                            hit = true
                        } else {
                            i += 1u64
                        }
                    }
                    if hit {
                        let _ = list.remove(mut h.owed, i)
                        if list.len(h.owed) > 0u64 {
                            used -= 1u64
                        }
                    }
                    result.unwrap(map.insert(mut held, take k, take h))
                    if hit {
                        let named: Bytes = result.unwrap(clone(t.stream))
                        tell(s.client, last, take named, t.p, Abandoned)
                    }
                }
            },
        }
    }
}

// ---- R2's subscription law (RUNNER-SPEC §8.2: subs25's main_two_sessions, as hand-written
// steps). Table "data" holds perm (key 0), row0 (key 1) and row1 (key 2). Q1 reads perm and,
// when it is not 0, covers row0 and row1; otherwise it covers nothing. Qf reads row1 and
// covers it, and faults when row1 is 2. The client applies each owe to its cache per
// (session, sub); the expected caches are written out by hand from the store's values at each
// version, as a from-scratch run of the query would give them (K1), never from the publisher.
// A value is the u64 codec's 8 bytes little-endian (codec.md), so `word` is the oracle's.
type Qh: send { t: store.Shape[u64, u64] }

fn q1(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    let allowed = match store.fetch(tx, h.t, 0u64) {
        Ok(Some(p)) => p != 0u64,
        Ok(None) => false,
        Error(_) => fail("subs: q1 reads perm"),
    }
    if allowed {
        cover(h.t, Included(1u64), Included(2u64))
    } else {
        cover(h.t, Included(1u64), Excluded(1u64))
    }
}

fn qf(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    match store.fetch(tx, h.t, 2u64) {
        Ok(Some(v)) => if v == 2u64 {
            fail("subs: qf at row1 = 2")
        },
        _ => (),
    }
    cover(h.t, Included(2u64), Included(2u64))
}

fn subs_place(mut r: Registry[(), Qh]) -> Result[(), RegisterError] {
    query(mut r, code.describe(q1), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(qf), 65536u64, DEFAULT_STEPS)
}

fn subs_handles(mut db: store.Db) -> Result[Qh, store.Error] waits {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let t = store.table(mut db, "data", std.codec.key_u64(), cv)?
    Ok(Qh(t: store.shape(t)))
}

fn query_key(f: StaticFn[fn(store.Tx, Qh, take u32) -> Result[Cover, Capacity]]) -> Bytes {
    let ca: std.codec.Codec[u32] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take k, _) = result.unwrap(described(code.identity(f), Query, ca, cr))
    k
}

fn no_arg() -> Bytes {
    let ca: std.codec.Codec[u32] = std.codec.of()
    let mut a: Bytes = list.new()
    result.unwrap(std.codec.encode(ca, 0u32, mut a))
    a
}

fn word(v: u8) -> Bytes {
    let mut out: Bytes = list.new()
    result.unwrap(list.push(mut out, v))
    for _ in 0u64 .. 7u64 {
        result.unwrap(list.push(mut out, 0u8))
    }
    out
}

fn set(mut db: store.Db, t: store.Table[u64, u64], k: u64, v: u64) -> () waits {
    let done = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, t, k, v)
    })
    match take done {
        Ok(Committed(_)) => (),
        _ => fail("subs: a fixture put"),
    }
}

type Cached { who: u64, sub: u32, rows: Map[Bytes, Bytes] }

type Client { caches: List[Cached], last: List[(u64, u64)] }

fn cached(c: Client, who: u64, sub: u32) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who && c.caches[i].sub == sub {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn drop_cache(mut c: Client, who: u64, sub: u32) {
    if let Some(i) = cached(c, who, sub) {
        let _ = list.remove(mut c.caches, i)
    }
}

// The client's side of one owe: versions never decrease (K2); a complete sub starts its cache
// empty; a row for a sub with no cache is a row before its complete (L17).
fn apply(mut c: Client, take o: Owe) -> bool {
    let mut seen = false
    let mut i = 0u64
    while i < list.len(c.last) {
        if c.last[i].0 == o.session {
            if o.version < c.last[i].1 {
                return false
            }
            c.last[i].1 = o.version
            seen = true
        }
        i += 1u64
    }
    if !seen {
        result.unwrap(list.push(mut c.last, (o.session, o.version)))
    }
    if o.reset {
        while let Some(j) = first_of(c, o.session) {
            let _ = list.remove(mut c.caches, j)
        }
        return true
    }
    for sub in o.complete {
        drop_cache(mut c, o.session, sub)
        result.unwrap(list.push(mut c.caches, Cached(who: o.session, sub: sub, rows: map.new())))
    }
    let Owe(session: who, version: _, complete: _, rows: take rows, ended: take ended, reset: _) = take o
    for take row in rows {
        let Row(sub: sub, key: take key, value: take value) = take row
        let k = match cached(c, who, sub) {
            Some(k) => k,
            None => return false,
        }
        let _ = map.remove(mut c.caches[k].rows, key)
        if let Some(take v) = take value {
            result.unwrap(map.insert(mut c.caches[k].rows, take key, take v))
        }
    }
    for e in ended {
        drop_cache(mut c, who, e.0)
    }
    true
}

fn first_of(c: Client, who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn apply_all(mut c: Client, take owes: List[Owe]) -> bool {
    for take o in owes {
        if !apply(mut c, take o) {
            return false
        }
    }
    true
}

// The cache of (who, sub) holds exactly row0 and row1 (keys[1], keys[2]) with these values;
// None leaves a row out.
fn holds(c: Client, keys: List[Bytes], who: u64, sub: u32, row0: Option[u8], row1: Option[u8]) -> bool {
    let k = match cached(c, who, sub) {
        Some(k) => k,
        None => return false,
    }
    let rows = c.caches[k].rows
    let mut n = 0u64
    if let Some(v) = row0 {
        n += 1u64
        match map.get(rows, keys[1]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    if let Some(v) = row1 {
        n += 1u64
        match map.get(rows, keys[2]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    map.len(rows) == n
}

fn step[G: send, H: send](mut b: Board[G, H], db: store.Db) -> List[Owe] {
    b.newest = Some(store.snapshot(db))
    round(mut b)
}

pub fn law_subs_main(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    let empty = store.snapshot(db)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let mut keys: List[Bytes] = list.new()
    for ch in result.unwrap(store.changes(empty, base)) {
        result.unwrap(list.push(mut keys, result.unwrap(clone(ch.tree_key))))
    }
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let mut b = Board(r: take reg, h: take h, base: take base, newest: None, subs: list.new())
    let mut cl = Client(caches: list.new(), last: list.new())
    let k1 = query_key(code.describe(q1))
    let kf = query_key(code.describe(qf))
    // subscribe_at_latest: w0 commits and is released, then session 0 subscribes Q1 before the
    // round. Its result is the base's (row0 = 0), labelled with the base.
    set(mut db, t, 1u64, 1u64)
    b.newest = Some(store.snapshot(db))
    let first = at_base(mut b, 0u64, 1u32, result.unwrap(clone(k1)), no_arg())
    if first.version != 4u64 || list.len(first.complete) != 1u64 || !apply(mut cl, take first) || !holds(cl, keys, 0u64, 1u32, Some(0u8), Some(0u8)) {
        return false
    }
    if !apply_all(mut cl, round(mut b)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(0u8)) {
        return false
    }
    // shared_cache: session 1 subscribes Q1 with the same sub id; session 0 subscribes Qf.
    // Then row1 = 5 is a cover change for both Q1s and a re-run for Qf.
    if !apply(mut cl, at_base(mut b, 1u64, 1u32, result.unwrap(clone(k1)), no_arg())) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(0u8)) {
        return false
    }
    if !apply(mut cl, at_base(mut b, 0u64, 2u32, result.unwrap(clone(kf)), no_arg())) || !holds(cl, keys, 0u64, 2u32, None, Some(0u8)) {
        return false
    }
    set(mut db, t, 2u64, 5u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 0u64, 2u32, None, Some(5u8)) {
        return false
    }
    // rerun_without_retract: revoke re-runs both Q1s, whose Covers become empty, so both lose
    // row0 and row1. A Subscribe of Q1 now completes with an empty result (L17).
    set(mut db, t, 0u64, 0u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, None, None) || !holds(cl, keys, 1u64, 1u32, None, None) || !holds(cl, keys, 0u64, 2u32, None, Some(5u8)) {
        return false
    }
    let empty_result = at_base(mut b, 1u64, 3u32, result.unwrap(clone(k1)), no_arg())
    if list.len(empty_result.complete) != 1u64 || empty_result.complete[0] != 3u32 || list.len(empty_result.rows) != 0u64 || !apply(mut cl, take empty_result) {
        return false
    }
    // K7: grant, then the call's row1 = 2. Qf's re-run faults and ends Qf alone, with
    // Failed(Raised(5)) (Fail); session 0's Q1 follows row1 by its Cover.
    set(mut db, t, 0u64, 1u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 1u64, 3u32, Some(1u8), Some(5u8)) {
        return false
    }
    set(mut db, t, 2u64, 2u64)
    let owes = step(mut b, db)
    let mut faulted = false
    for o in owes {
        for e in o.ended {
            faulted = o.session == 0u64 && e.0 == 2u32 && match e.1 {
                Failed(Raised(n)) => n == 5u32,
                _ => false,
            }
        }
    }
    faulted && apply_all(mut cl, take owes) && cached(cl, 0u64, 2u32) == None && holds(cl, keys, 0u64, 1u32, Some(1u8), Some(2u8)) && holds(cl, keys, 1u64, 1u32, Some(1u8), Some(2u8))
}

// L22 (RUNNER-SPEC v2.12, subscribe_order): a Subscribe runs at the version of the last
// Released taken before it in PubIn's order, and each later Release reaches it as a round.
// The publisher's own loop drains one inbox filled in that order: Joined, c1's Release, the
// Subscribe, c2's Release, Halt. Sub 1's initial result holds c1 (row 1 = 1) at c1's version,
// and c2 (row 2 = 7) follows as a round at c2's version.
pub fn law_subscribe_order(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    let empty = store.snapshot(db)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let mut keys: List[Bytes] = list.new()
    for ch in result.unwrap(store.changes(empty, base)) {
        result.unwrap(list.push(mut keys, result.unwrap(clone(ch.tree_key))))
    }
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 1u64)
    let c1 = store.snapshot(db)
    set(mut db, t, 2u64, 7u64)
    let c2 = store.snapshot(db)
    let v1 = store.version(c1)
    let v2 = store.version(c2)
    let Mailbox(to: take to, from: take from) = result.unwrap(mailbox(8u64))
    let (ev_to, ev_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(8u64))
    let (told_to, told_from): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(1u64))
    let mut queue: List[ToPub] = list.new()
    result.unwrap(list.push(mut queue, Joined(Join(to: Seam(take ev_to), told: take told_to, mark: None, closed: None))))
    result.unwrap(list.push(mut queue, Released(Release(version: v1, snapshot: Some(take c1), answers: list.new()))))
    result.unwrap(list.push(mut queue, Subscribed(1u64, 1u32, query_key(code.describe(q1)), no_arg())))
    result.unwrap(list.push(mut queue, Released(Release(version: v2, snapshot: Some(take c2), answers: list.new()))))
    result.unwrap(list.push(mut queue, Halt))
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    publisher(take reg, take h, take base, take from)
    match channel.try_receive(told_from) {
        Ok(1u64) => (),
        _ => return false,
    }
    let mut cl = Client(caches: list.new(), last: list.new())
    let mut n = 0u64
    while let Ok(take x) = channel.try_receive(ev_from) {
        let Event(e: take e) = take x
        let o = match take e {
            Content(take o) => take o,
            _ => return false,
        }
        let ok = if n == 0u64 {
            o.version == v1 && list.len(o.complete) == 1u64 && apply(mut cl, take o) && holds(cl, keys, 1u64, 1u32, Some(1u8), Some(0u8))
        } else {
            o.version == v2 && list.len(o.complete) == 0u64 && apply(mut cl, take o) && holds(cl, keys, 1u64, 1u32, Some(1u8), Some(7u8))
        }
        if !ok {
            return false
        }
        n += 1u64
    }
    n == 2u64
}

// L25 (RUNNER-SPEC v2.14, retired_without_waiting): a marked session's end waits on nothing,
// and after the next message the publisher takes, Released or not, that session's
// subscriptions, Joiner (its ledger and mark) and waiting Told's are gone; a live session is
// unchanged by every sweep. The oracle is the state itself, in place of §8's retained-bytes
// figure (followups.md, 2026-11-17): a closed event channel for the publisher's Joiner, the
// Board's subs and the waiting list for the sweep, and the Drained messages on PubIn for the
// session's end.
pub fn law_retired_without_waiting(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    retired_at_publisher(c, r, tasks, true) && retired_at_publisher(c, r, tasks, false) && retired_state(c, r) && retired_session(c, tasks, 0u64) && retired_session(c, tasks, 1u64) && retired_session(c, tasks, 2u64) && retired_session(c, tasks, 3u64)
}

// A session joins the publisher and is told its id (0 if it could not): a sync point that is
// not a Released, since the publisher has taken every message sent before it.
fn join_as(to: Sender[PubIn], take ev: Sender[Event], take mark: Option[Receiver[()]]) -> u64 waits {
    let (told, hear): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(1u64))
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: Seam(take ev), told: take told, mark: take mark, closed: None)))) {
        return 0u64
    }
    match channel.receive(hear) {
        Ok(n) => n,
        Error(_) => 0u64,
    }
}

// Takes every event `from` holds: each Content's version, and whether any names `sub`.
// True if the channel is then closed, false if it is only empty.
fn drain_content(from: Receiver[Event], mut versions: List[u64], sub: u32, mut named: bool) -> bool {
    loop {
        match channel.try_receive(from) {
            Ok(take x) => {
                let Event(e: take e) = take x
                if let Content(take o) = take e {
                    for s in o.complete {
                        named = named || s == sub
                    }
                    for w in o.rows {
                        named = named || w.sub == sub
                    }
                    result.unwrap(list.push(mut versions, o.version))
                }
            },
            Error(Empty) => return false,
            Error(Closed) => return true,
        }
    }
}

// The publisher, as a task. Marked sessions L and M and an unmarked filler F join; L and M
// subscribe sub 1, and both take c1's round. M's mark then closes in a quiet place, and the
// next message is M's wake (woken) or, with the wake dropped, F's Unsubscribe followed by M's
// queued Subscribe of sub 2. After that and a Joined, with no Released between, M's event
// channel holds its two contents and is closed (its Joiner is gone), and sub 2 registered
// nothing. Then c2's round reaches L.
fn retired_at_publisher(c: Clock, r: Random, tasks: Tasks, woken: bool) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let v0 = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 1u64)
    let c1 = store.snapshot(db)
    set(mut db, t, 2u64, 7u64)
    let c2 = store.snapshot(db)
    let v1 = store.version(c1)
    let v2 = store.version(c2)
    let Mailbox(to: take to, from: take from) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = result.unwrap(channel.new(1u64))
    let p = Publish(place: code.describe(subs_place), n_place: 1048576u64, h: take h, base: take base, from: take from, ready: take ready_to)
    let publishing = match task.spawn(tasks, bytes 8388608u64, take p, publish) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    match channel.receive(ready_from) {
        Ok(None) => (),
        _ => return false,
    }
    let (l_to, l_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(16u64))
    let (l_send, l_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let mut l_keep = Some(take l_send)
    let l = join_as(to, take l_to, Some(take l_mark))
    let (m_to, m_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(16u64))
    let (m_send, m_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let mut m_keep = Some(take m_send)
    let m = join_as(to, take m_to, Some(take m_mark))
    let (f_to, f_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(16u64))
    let f = join_as(to, take f_to, None)
    let k1 = query_key(code.describe(q1))
    let mut queue: List[ToPub] = list.new()
    result.unwrap(list.push(mut queue, Subscribed(l, 1u32, result.unwrap(clone(k1)), no_arg())))
    result.unwrap(list.push(mut queue, Subscribed(m, 1u32, result.unwrap(clone(k1)), no_arg())))
    result.unwrap(list.push(mut queue, Released(Release(version: v1, snapshot: Some(take c1), answers: list.new()))))
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (g_to, g_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(1u64))
    let g = join_as(to, take g_to, None)
    // M ends: its mark's only Sender goes. Nothing is Released until M's channel is read.
    m_keep = None
    let mut quiet: List[ToPub] = list.new()
    if woken {
        result.unwrap(list.push(mut quiet, Drained))
    } else {
        result.unwrap(list.push(mut quiet, Unsubscribed(f, 9u32)))
        result.unwrap(list.push(mut quiet, Subscribed(m, 2u32, result.unwrap(clone(k1)), no_arg())))
    }
    for take e in quiet {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (n_to, n_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(1u64))
    let n = join_as(to, take n_to, None)
    let mut mv: List[u64] = list.new()
    let mut m2 = false
    let m_closed = drain_content(m_from, mut mv, 2u32, mut m2)
    if !m_closed || m2 || list.len(mv) != 2u64 || mv[0] != v0 || mv[1] != v1 {
        return false
    }
    if let Error(_) = channel.send(to, PubIn(e: Released(Release(version: v2, snapshot: Some(take c2), answers: list.new())))) {
        return false
    }
    let (k_to, k_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(1u64))
    let k = join_as(to, take k_to, None)
    let mut lv: List[u64] = list.new()
    let mut l2 = false
    let l_closed = drain_content(l_from, mut lv, 2u32, mut l2)
    if l_closed || l2 || list.len(lv) != 3u64 || lv[0] != v0 || lv[1] != v1 || lv[2] != v2 {
        return false
    }
    if let Error(_) = channel.send(to, PubIn(e: Halt)) {
        return false
    }
    let stopped = match task.join(take publishing) {
        Ok(_) => true,
        Error(_) => false,
    }
    l_keep = None
    let _ = (f_from, g_from, n_from, k_from)
    stopped && l != 0u64 && m != 0u64 && f != 0u64 && g != 0u64 && n != 0u64 && k != 0u64 && none(l_keep) && none(m_keep)
}

// The sweep's own state: session 2's mark is closed, session 1's is open. One sweep and the
// retry pass leave session 1's sub and Joiner, and remove session 2's two subs, its Joiner
// (with its waiting Ended and its mark) and its waiting Told.
fn retired_state(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    let base = store.snapshot(db)
    let at = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let mut b = Board(r: take reg, h: take h, base: take base, newest: None, subs: list.new())
    let k1 = query_key(code.describe(q1))
    let _ = at_base(mut b, 1u64, 1u32, result.unwrap(clone(k1)), no_arg())
    let _ = at_base(mut b, 2u64, 1u32, result.unwrap(clone(k1)), no_arg())
    let _ = at_base(mut b, 2u64, 2u32, result.unwrap(clone(k1)), no_arg())
    let (l_send, l_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (m_send, m_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let mut m_keep = Some(take m_send)
    m_keep = None
    let (l_to, l_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(4u64))
    let (m_to, m_from): (Sender[Event], Receiver[Event]) = result.unwrap(channel.new(4u64))
    let m_told = channel.sender(m_to)
    let mut m_inbox = Some(take m_from)
    m_inbox = None
    let mut ended: List[(u32, Outcome)] = list.new()
    result.unwrap(list.push(mut ended, (1u32, Refused(Overloaded))))
    let mut joined: List[Joiner] = list.new()
    result.unwrap(list.push(mut joined, Joiner(who: 1u64, to: Seam(take l_to), closed: None, ended: list.new(), reset: false, mark: Some(take l_mark))))
    result.unwrap(list.push(mut joined, Joiner(who: 2u64, to: Seam(take m_to), closed: None, ended: take ended, reset: false, mark: Some(take m_mark))))
    let mut waiting: List[Answer] = list.new()
    result.unwrap(list.push(mut waiting, Answer(to: Seam(take m_told), stream: no_arg(), p: 0u64, outcome: Refused(Overloaded))))
    sweep(mut b.subs, mut joined)
    settle(mut b.subs, mut joined, mut waiting, at)
    let mut live = 0u64
    for s in b.subs {
        if s.session != 1u64 {
            return false
        }
        live += 1u64
    }
    let _ = (l_send, l_from)
    live == 1u64 && list.len(joined) == 1u64 && joined[0].who == 1u64 && list.len(waiting) == 0u64 && none(m_keep) && none(m_inbox)
}

fn none[T](x: Option[T]) -> bool {
    match x {
        Some(_) => false,
        None => true,
    }
}

// The Drained messages `from` holds now; any other message counts as many.
fn drained(from: Receiver[PubIn]) -> u64 {
    let mut n = 0u64
    while let Ok(take x) = channel.try_receive(from) {
        let PubIn(e: take e) = take x
        n += match take e {
            Drained => 1u64,
            _ => 1000u64,
        }
    }
    n
}

fn is_ended(take d: Down, sub: u32) -> bool {
    match take d {
        Ended(s, take o) => s == sub && match o {
            Refused(Overloaded) => true,
            _ => false,
        },
        _ => false,
    }
}

// The session's end. A marked session on a mailbox of 2, with this law as its publisher,
// joins and subscribes sub 1; its mark is Empty while it lives. It ends (0) normally on an
// empty PubIn, (1) normally on a full one, (2) by a fault, or (3) by cancellation. Its end
// waits on nothing: the session's own Drained is on PubIn before `join_marked` in (0), and in
// (1) it was dropped, so `join_marked` adds only its own. In (2) and (3) only the joiner offers
// one. The mark is closed after the join in each. (1) also holds v2.12 item 3: on the full
// PubIn, a Subscribe of sub 2 is answered Ended(2, Refused(Overloaded)), and an Unsubscribe of
// sub 1 is applied at the owner, which drops sub 1's rows from later content.
fn retired_session(c: Clock, tasks: Tasks, end: u64) -> bool waits {
    let Mailbox(to: take to, from: take from) = result.unwrap(mailbox(2u64))
    let (head, heads): (Sender[Req], Receiver[Req]) = result.unwrap(channel.new(1u64))
    let (down_to, down): (Sender[Down], Receiver[Down]) = result.unwrap(channel.new(16u64))
    let pair = match connect(tasks, code.describe(subs_place), 1048576u64, head, to, take down_to, c, 1u64, 4194304u64, true) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let (inbox, started) = take pair
    let mut running = take started
    let k1 = query_key(code.describe(q1))
    if let Error(_) = channel.send(inbox, subscribe(1u32, result.unwrap(clone(k1)), no_arg())) {
        return false
    }
    let joining = match channel.receive(from) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let PubIn(e: take first) = take joining
    let (ses, held) = match take first {
        Joined(take j) => {
            let Join(to: take delivery, told: take told, mark: take given, closed: _) = take j
            let ses_to = match take delivery { Seam(take sender) => take sender, _ => return false }
            let _ = channel.try_send(told, 7u64)
            (take ses_to, take given)
        },
        _ => return false,
    }
    let m = match take held {
        Some(take x) => take x,
        None => return false,
    }
    let subscribing = match channel.receive(from) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let PubIn(e: take second) = take subscribing
    let subscribed = match take second {
        Subscribed(who, sub, _, _) => who == 7u64 && sub == 1u32,
        _ => false,
    }
    let live = match channel.try_receive(m) {
        Error(Empty) => true,
        _ => false,
    }
    if !subscribed || !live {
        return false
    }
    if end == 1u64 {
        for _ in 0u64 .. 2u64 {
            if let Error(_) = channel.send(to, PubIn(e: Drained)) {
                return false
            }
        }
        let mut rows: List[Row] = list.new()
        result.unwrap(list.push(mut rows, Row(sub: 1u32, key: no_arg(), value: None)))
        result.unwrap(list.push(mut rows, Row(sub: 3u32, key: no_arg(), value: None)))
        let o = Owe(session: 7u64, version: 9u64, complete: list.new(), rows: take rows, ended: list.new(), reset: false)
        if let Error(_) = channel.send(inbox, subscribe(2u32, result.unwrap(clone(k1)), no_arg())) {
            return false
        }
        if let Error(_) = channel.send(inbox, unsubscribe(1u32)) {
            return false
        }
        if let Error(_) = channel.send(ses, Event(e: Content(take o))) {
            return false
        }
        let refused = match channel.receive(down) {
            Ok(take d) => is_ended(take d, 2u32),
            Error(_) => false,
        }
        let only_three = match channel.receive(down) {
            Ok(Batched(take x)) => list.len(x.rows) == 1u64 && x.rows[0].sub == 3u32,
            _ => false,
        }
        if !refused || !only_three {
            return false
        }
    }
    if end == 2u64 {
        // A Told whose stream is over the session's bytes: slot_key's allocation faults.
        let mut big: Bytes = list.new()
        if let Error(_) = list.fill(mut big, 8388608u64, 0u8) {
            return false
        }
        if let Error(_) = channel.send(ses, Event(e: Answered(Told(version: 0u64, stream: take big, p: 0u64, outcome: Refused(Overloaded))))) {
            return false
        }
    } else if end == 3u64 {
        task.cancel(mut running)
    } else if let Error(_) = channel.send(inbox, hang_up()) {
        return false
    }
    // The session's end drops its client; this waits for that, never for the task.
    while let Ok(_) = channel.receive(down) {
    }
    let before = drained(from)
    let outcome = match join_marked(take running, to) {
        Ok(Ok(_)) => end <= 1u64,
        Error(Failed(_)) => end == 2u64,
        Error(Cancelled(_)) => end == 3u64,
        _ => false,
    }
    let after = drained(from)
    let closed = match channel.try_receive(m) {
        Error(Closed) => true,
        _ => false,
    }
    let want = if end == 0u64 {
        1u64
    } else if end == 1u64 {
        2u64
    } else {
        0u64
    }
    let _ = heads
    outcome && closed && before == want && after == 1u64
}


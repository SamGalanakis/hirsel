const ROWS: u64 = 24

const DIMS: u64 = 3

const ROUNDS: u64 = 160

type Points = store.Table[u64, List[i8]]

type Near = vector.Vectors[u64, List[i8]]

type Found = Result[List[vector.Hit[u64]], vector.Error]

type Step = Put(u64, List[i8]) | Delete(u64)

fn row_code(_key: u64, value: List[i8]) -> Result[List[i8], Capacity] {
    Ok(clone(value))
}

fn row_ordinal(key: u64) -> u64 {
    key
}

fn open_points(clock: Clock, random: Random, metric: vector.Metric) -> (store.Db, Points, Near) waits {
    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let mut d = result.unwrap(store.declare(db, Migrate))
    let codes: std.codec.Codec[List[i8]] = std.codec.of_list()
    let mut decl = result.unwrap(store.declare_table(mut d, "points", std.codec.key_u64(), codes))
    let near = result.unwrap(vector.declare(mut d, mut decl, "near", metric, code.describe(row_code), code.describe(row_ordinal)))
    let points = result.unwrap(store.finish(mut d, take decl))
    let _ = result.unwrap(store.seal(mut db, take d))
    (take db, points, take near)
}

// Runs the steps and then the query in one transaction, so the query sees
// the transaction's own writes.
fn run_query(mut db: store.Db, points: Points, near: Near, take steps: List[Step], q: List[i8], k: u64) -> Found waits {
    let ran = result.unwrap(store.run(mut db, None, (store.copy_env(points), store.copy_env(near), take steps, store.copy_env(q), k), fn(mut tx, input) -> Result[Found, store.Error] {
        for step in input.2 {
            match step {
                Put(key, c) => store.put(mut tx, input.0, key, clone(c))?,
                Delete(key) => {
                    let _ = store.delete(mut tx, input.0, key)?
                },
            }
        }
        Ok(vector.query(tx, input.1, input.3, input.4, Every))
    }))
    match take ran {
        Committed(take done) => clone(done.value),
        _ => fail("vector law: the transaction did not commit"),
    }
}

fn look_query(db: store.Db, near: Near, q: List[i8], k: u64) -> Found waits {
    let read_handle = result.unwrap(store.reader(db, 0u64))
    let looked = result.unwrap(store.look(read_handle, store.snapshot(db), None, (store.copy_env(near), store.copy_env(q), k), fn(tx, input) -> Found {
        vector.query(tx, input.0, input.1, input.2, Every)
    }))
    match take looked {
        Seen(take seen) => clone(seen.value),
        _ => fail("vector law: the look did not run"),
    }
}

// The model's brute force: score every present row with arithmetic written
// here, sort them all by score descending and key ascending, and keep k.
fn model_score(metric: vector.Metric, q: List[i8], c: List[i8]) -> i64 {
    let mut dot = 0i64
    let mut distance = 0i64
    for i in 0u64 .. list.len(q) {
        let a: i64 = int.widen(q[i])
        let b: i64 = int.widen(c[i])
        dot += a * b
        let gap = if a > b {
            a - b
        } else {
            b - a
        }
        distance += gap * gap
    }
    match metric {
        Dot => dot,
        L2 => 0i64 - distance,
    }
}

fn model_ranking(metric: vector.Metric, model: List[Option[List[i8]]], q: List[i8]) -> List[(u64, i64)] {
    let mut all: List[(u64, i64)] = list.new()
    for key in 0u64 .. list.len(model) {
        if let Some(c) = view model[key] {
            list.push(mut all, (key, model_score(metric, q, c)))
        }
    }
    std.list.sort(mut all, scoped fn(a: (u64, i64), b: (u64, i64)) -> Order {
        if a.1 > b.1 || (a.1 == b.1 && a.0 < b.0) {
            Less
        } else if a.1 == b.1 && a.0 == b.0 {
            Equal
        } else {
            Greater
        }
    })
    take all
}

fn exact(hits: List[vector.Hit[u64]], ranking: List[(u64, i64)], k: u64) -> bool {
    let want = if k < list.len(ranking) {
        k
    } else {
        list.len(ranking)
    }
    if list.len(hits) != want {
        return false
    }
    for i in 0u64 .. want {
        if hits[i].key != ranking[i].0 || hits[i].score != ranking[i].1 {
            return false
        }
    }
    true
}

fn present(model: List[Option[List[i8]]], key: u64) -> bool {
    match view model[key] {
        Some(_) => true,
        None => false,
    }
}

fn draw(mut state: u64) -> u64 {
    state = store.splitmix64(state)
    state
}

fn draw_code(mut state: u64) -> List[i8] {
    let mut c: List[i8] = list.new()
    let values: Inline[i8, 5] =[-2, -1, 0, 1, 2]
    for _ in 0u64 .. DIMS {
        list.push(mut c, values[draw(mut state) % 5])
    }
    take c
}

type Tally {
    straddles: u64,
    not_ready: u64,
    queries: u64
}

// One seeded history. Each round writes up to three steps (a put of a drawn
// code, a put of a row's own code again, or a delete that may find no row)
// and queries, inside that transaction or through a look after it commits.
// Some rounds rebuild the index or step its build: until the build ends a
// query may answer NotReady, and any answer it gives is exact.
fn history(clock: Clock, random: Random, metric: vector.Metric, seed: u64, mut tally: Tally) waits {
    let (take opened, points, near) = open_points(clock, random, metric)
    let mut db = take opened
    let mut model: List[Option[List[i8]]] = list.new()
    for _ in 0u64 .. ROWS {
        list.push(mut model, None)
    }
    let mut state = seed
    let mut building = false
    for _ in 0u64 .. ROUNDS {
        let pick = draw(mut state) % 16
        if pick == 0 && !building {
            result.unwrap(store.rebuild_index(mut db, vector.entry_index(near)))
            building = true
        } else if pick < 4 && building {
            let limit = 1 + draw(mut state) % 5
            if let None = result.unwrap(store.index_build_step(mut db, limit)) {
                building = false
            }
        }
        let mut steps: List[Step] = list.new()
        for _ in 0u64 .. draw(mut state) % 4 {
            let key = draw(mut state) % ROWS
            let kind = draw(mut state) % 4
            if kind == 0 {
                list.push(mut steps, Delete(key))
                model[key] = None
            } else if kind == 1 && present(model, key) {
                if let Some(same) = view model[key] {
                    list.push(mut steps, Put(key, clone(same)))
                }
            } else {
                let c = draw_code(mut state)
                list.push(mut steps, Put(key, clone(c)))
                model[key] = Some(take c)
            }
        }
        let q = draw_code(mut state)
        let k = draw(mut state) % (ROWS + 2)
        let found = if draw(mut state) % 2 == 0 {
            run_query(mut db, points, near, take steps, q, k)
        } else {
            let _ = run_query(mut db, points, near, take steps, q, 0)
            look_query(db, near, q, k)
        }
        let ranking = model_ranking(metric, model, q)
        if k > 0 && list.len(ranking) > k && ranking[k - 1].1 == ranking[k].1 {
            tally.straddles += 1
        }
        tally.queries += 1
        match take found {
            Error(Store(NotReady(name))) if building && name == "near" => {
                tally.not_ready += 1
            },
            Ok(take hits) => {
                if !exact(hits, ranking, k) {
                    fail("vector law: the top k differs from the model's brute-force ranking")
                }
                building = false
            },
            _ => fail("vector law: the query failed outside a build"),
        }
    }
    while let Some(_) = result.unwrap(store.index_build_step(mut db, 7)) {}
    for k in 0u64 .. ROWS + 2 {
        let q = draw_code(mut state)
        let Ok(hits) = look_query(db, near, q, k) else {
            fail("vector law: a built index refused a query")
        }
        if !exact(hits, model_ranking(metric, model, q), k) {
            fail("vector law: the top k differs from the model's brute-force ranking")
        }
    }
    result.unwrap(store.close(take db))
}

/// bug: a top-k that admits an equal score in place of an earlier key, or
/// that drops a deleted or overwritten row's old code, ranks differently
/// from the model's brute-force scan.
/// oracle: brute-force scoring over the test's model rows, with ties broken in key order.
@test
fn exact_top_k(clock: Clock, random: Random) -> Result[(), ()] waits {
    let mut tally = Tally(straddles: 0, not_ready: 0, queries: 0)
    let metrics: Inline[vector.Metric, 2] =[Dot, L2]
    for metric in metrics {
        for seed in 0u64 .. 6 {
            history(clock, random, metric, seed * 7919 + 1, mut tally)
        }
    }
    if tally.straddles == 0 || tally.not_ready == 0 {
        fail("vector law: no query had a tie across the k boundary, or none met a build")
    }
    Ok(())
}

fn expect_keys(take found: Found, keys: Inline[u64, 4], scores: Inline[i64, 4]) {
    let Ok(hits) = take found else {
        fail("vector extremes: the query failed")
    }
    if list.len(hits) != 4 {
        fail("vector extremes: expected four hits")
    }
    for i in 0u64 .. 4 {
        if hits[i].key != keys[i] || hits[i].score != scores[i] {
            fail("vector extremes: a hit differs from the hand-computed ranking")
        }
    }
}

fn four(a: i8, b: i8, c: i8, d: i8) -> List[i8] {
    let mut v: List[i8] = list.new()
    list.push(mut v, a)
    list.push(mut v, b)
    list.push(mut v, c)
    list.push(mut v, d)
    take v
}

/// bug: arithmetic that is not widened before it subtracts or multiplies
/// overflows at 127 and -128, and a code of another length is scored.
/// oracle: widened integer arithmetic over the hand-chosen i8 extremes and mismatched lengths.
@test
fn extremes(clock: Clock, random: Random) -> Result[(), ()] waits {
    let mut steps: List[Step] = list.new()
    list.push(mut steps, Put(1, four(127, 127, 127, 127)))
    list.push(mut steps, Put(2, four(-128, -128, -128, -128)))
    list.push(mut steps, Put(3, four(127, -128, 127, -128)))
    list.push(mut steps, Put(4, four(0, 0, 0, 0)))
    let q = four(-128, -128, -128, -128)
    // By hand, with q all -128: Dot is 4 * -16256, 4 * 16384,
    // 2 * -16256 + 2 * 16384 and 0; L2 is 4 * 255², 0, 2 * 255² and 4 * 128².
    let (take dot_db, dot_points, dot_near) = open_points(clock, random, Dot)
    let mut db = take dot_db
    expect_keys(run_query(mut db, dot_points, dot_near, clone(steps), q, 9),[2, 3, 4, 1],[65536, 256, 0, -65024])
    result.unwrap(store.close(take db))
    let (take l2_db, l2_points, l2_near) = open_points(clock, random, L2)
    db = take l2_db
    expect_keys(run_query(mut db, l2_points, l2_near, take steps, q, 4),[2, 4, 3, 1],[0, -65536, -130050, -260100])
    let mut short: List[i8] = list.new()
    list.push(mut short, 1)
    list.push(mut short, 2)
    let mut more: List[Step] = list.new()
    list.push(mut more, Put(0, take short))
    match run_query(mut db, l2_points, l2_near, take more, q, 4) {
        Error(Dimensions(4, 2)) => (),
        _ => fail("vector extremes: a two-element code must refuse a four-element query"),
    }
    let mut three: List[i8] = list.new()
    for _ in 0u64 .. 3 {
        list.push(mut three, 0)
    }
    match look_query(db, l2_near, three, 4) {
        Error(Dimensions(3, 2)) => (),
        _ => fail("vector extremes: the first row's length must refuse a three-element query"),
    }
    result.unwrap(store.close(take db))
    Ok(())
}

// Form B (ivf.hirsel) against form A on one table: 2048 rows of 32
// dimensions around 16 centres, probed 4 clusters of 16 at a time.
const IVF_ROWS: u64 = 2048

const IVF_DIMS: u64 = 32

const IVF_CENTRES: u64 = 16

const IVF_QUERIES: u64 = 16

const IVF_K: u64 = 10

const IVF_PROBES: u32 = 4

type Far = vector.Ivf[u64, List[i8]]

type Model = List[Option[List[i8]]]

fn open_far(clock: Clock, random: Random, metric: vector.Metric, ordinal: StaticFn[fn(u64) -> u64], shape: vector.Shape) -> (store.Db, Points, Near, Far) waits {
    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let mut d = result.unwrap(store.declare(db, Migrate))
    let codes: std.codec.Codec[List[i8]] = std.codec.of_list()
    let mut decl = result.unwrap(store.declare_table(mut d, "points", std.codec.key_u64(), codes))
    let near = result.unwrap(vector.declare(mut d, mut decl, "near", metric, code.describe(row_code), ordinal))
    let points = result.unwrap(store.finish(mut d, take decl))
    let far = result.unwrap(vector.declare_ivf(mut d, points, "far", metric, code.describe(row_code), ordinal, shape))
    let _ = result.unwrap(store.seal(mut db, take d))
    (take db, points, take near, take far)
}

fn recall_shape() -> vector.Shape {
    vector.Shape(dims: IVF_DIMS, clusters: 16, steps: 1099511627776u64)
}

fn far_run(mut db: store.Db, points: Points, far: Far, take steps: List[Step], q: List[i8], k: u64) -> Found waits {
    let ran = result.unwrap(store.run(mut db, None, (store.copy_env(points), store.copy_env(far), take steps, store.copy_env(q), k), fn(mut tx, input) -> Result[Found, store.Error] {
        for step in input.2 {
            match step {
                Put(key, c) => store.put(mut tx, input.0, key, clone(c))?,
                Delete(key) => {
                    let _ = store.delete(mut tx, input.0, key)?
                },
            }
        }
        Ok(vector.query_ivf(tx, input.1, input.3, input.4, IVF_PROBES, Every))
    }))
    match take ran {
        Committed(take done) => clone(done.value),
        _ => fail("ivf law: the transaction did not commit"),
    }
}

fn far_look(db: store.Db, far: Far, q: List[i8], k: u64, probes: u32) -> Found waits {
    let read_handle = result.unwrap(store.reader(db, 0u64))
    let looked = result.unwrap(store.look(read_handle, store.snapshot(db), None, (store.copy_env(far), store.copy_env(q), k, probes), fn(tx, input) -> Found {
        vector.query_ivf(tx, input.0, input.1, input.2, input.3, Every)
    }))
    match take looked {
        Seen(take seen) => clone(seen.value),
        _ => fail("ivf law: the look did not run"),
    }
}

// Steps the projector until it is idle, and counts the merges it made.
fn settle(mut db: store.Db, far: Far) -> u64 waits {
    let mut merged = 0u64
    for _ in 0u64 .. 4096 {
        match store.project_step(mut db, vector.ivf_name(far), store.Limits(rows: 256, byte_limit: 16777216)) {
            Ok(Idle) => return merged,
            Ok(Merged(_)) => {
                merged += 1
            },
            Ok(_) => (),
            Error(_) => fail("ivf law: a projector step failed"),
        }
    }
    fail("ivf law: the projector never went idle")
}

fn centre(c: u64) -> List[i8] {
    let mut state = 0x5eed0000u64 + c
    let mut out: List[i8] = list.new()
    for _ in 0u64 .. IVF_DIMS {
        let drawn: u8 = int.narrow(draw(mut state) % 161)
        let x: i64 = int.widen(drawn)
        list.push(mut out, int.narrow(x - 80))
    }
    take out
}

fn near_centre(c: u64, seed: u64) -> List[i8] {
    let mut state = seed
    let middle = centre(c)
    let mut out: List[i8] = list.new()
    for j in 0u64 .. IVF_DIMS {
        let drawn: u8 = int.narrow(draw(mut state) % 49)
        let noise: i64 = int.widen(drawn)
        let base: i64 = int.widen(middle[j])
        list.push(mut out, int.narrow(base + noise - 24))
    }
    take out
}

fn write_rows(mut db: store.Db, points: Points, far: Far, take steps: List[Step]) waits {
    let q: List[i8] = list.new()
    let _ = far_run(mut db, points, far, take steps, q, 0)
}

fn same_hits(a: List[vector.Hit[u64]], b: List[vector.Hit[u64]]) -> bool {
    if list.len(a) != list.len(b) {
        return false
    }
    for i in 0u64 .. list.len(a) {
        if a[i].key != b[i].key || a[i].score != b[i].score {
            return false
        }
    }
    true
}

fn far_query(i: u64) -> List[i8] {
    near_centre(i % IVF_CENTRES, 0x9e3779b9u64 * (i + 1))
}

// One store state: for each query, form B through a run and through a look
// gives one list, of distinct present rows at their exact scores, in rank
// order; with `exact`, it is form A's list. Returns how many of its hits
// score at least form A's k-th score, summed over the queries.
fn far_state(mut db: store.Db, points: Points, near: Near, far: Far, metric: vector.Metric, model: Model, whole: bool) -> u64 waits {
    let mut found = 0u64
    for i in 0u64 .. IVF_QUERIES {
        let q = far_query(i)
        let Ok(a) = look_query(db, near, q, IVF_K) else {
            fail("ivf law: form A refused a query")
        }
        let empty: List[Step] = list.new()
        let Ok(b) = far_run(mut db, points, far, take empty, q, IVF_K) else {
            fail("ivf law: form B refused a query in a run")
        }
        let Ok(seen) = far_look(db, far, q, IVF_K, IVF_PROBES) else {
            fail("ivf law: form B refused a query in a look")
        }
        if !same_hits(b, seen) {
            fail("ivf law: a run and a look of one state answer differently")
        }
        if whole && !same_hits(a, b) {
            fail("ivf law: form B with no image differs from form A")
        }
        if list.len(b) != list.len(a) {
            fail("ivf law: form B returned another number of hits")
        }
        for j in 0u64 .. list.len(b) {
            let Some(c) = view model[b[j].key] else {
                fail("ivf law: form B returned an absent row")
            }
            if b[j].score != model_score(metric, q, c) {
                fail("ivf law: a form B score is not the row's exact score")
            }
            if j > 0 && (b[j - 1].score < b[j].score || (b[j - 1].score == b[j].score && b[j - 1].key >= b[j].key)) {
                fail("ivf law: form B's hits are out of rank order")
            }
            if b[j].score >= a[list.len(a) - 1].score {
                found += 1
            }
        }
    }
    found
}

fn churn(mut model: Model, round: u64) -> List[Step] {
    let mut steps: List[Step] = list.new()
    let mut state = 0xc4u64 + round
    for _ in 0u64 .. 192 {
        let key = draw(mut state) % (IVF_ROWS + 64)
        if draw(mut state) % 3 == 0 {
            list.push(mut steps, Delete(key))
            model[key] = None
        } else {
            let toward = draw(mut state) % IVF_CENTRES
            let c = near_centre(toward, draw(mut state))
            list.push(mut steps, Put(key, clone(c)))
            model[key] = Some(take c)
        }
    }
    take steps
}

fn recall_line(found: u64) {
    // recall@10 of at least 0.95 over the queries
    if found * 100 < 95 * IVF_K * IVF_QUERIES {
        fail("ivf law: recall@10 against form A is below 0.95")
    }
}

fn ordered_import(clock: Clock, random: Random) waits {
    let shape = vector.Shape(dims: 4, clusters: 2, steps: 1099511627776u64)
    let (take opened, points, _, far) = open_far(clock, random, L2, code.describe(row_ordinal), shape)
    let mut db = take opened
    let mut model: Model = list.new()
    let mut steps: List[Step] = list.new()
    for key in 0u64 .. 256 {
        let raw = if key < 128 {
            // The old prefix trains exactly on (-1, -100) and (1, -100).
            let x = if key % 2 == 0 {
                -1i8
            } else {
                1i8
            }
            four(x, -100, 0, 0)
        } else if key == 128 {
            four(-1, 100, 0, 0)
        } else {
            four(-1, 90, 0, 0)
        }
        list.push(mut steps, Put(key, clone(raw)))
        list.push(mut model, Some(take raw))
    }
    write_rows(mut db, points, far, take steps)
    let _ = settle(mut db, far)
    // A held-out query from B probes x = +1 with the old centroids,
    // while every row of B was assigned to x = -1.
    let q = four(1, 100, 0, 0)
    let Ok(hits) = far_look(db, far, q, 1, 1) else {
        fail("ivf law: the ordered import query failed")
    }
    if !exact(hits, model_ranking(L2, model, q), 1) {
        fail("ivf law: one probe missed the ordered import's exact nearest neighbour")
    }
    result.unwrap(store.close(take db))
}

/// bug: a form B query that misses a row's newest generation mention, reads
/// a masked or tail-changed key from an old generation, mis-scores a
/// candidate, or prunes with a wrong 1-bit bound loses recall against form
/// A, returns an absent row, or answers a run and a look differently.
/// Training on a key prefix can omit a population and miss its nearest row at one probe.
/// oracle: the form A exhaustive scan and brute-force model scores over the same rows.
@test
fn ivf_recall(clock: Clock, random: Random) -> Result[(), ()] waits {
    ordered_import(clock, random)
    let metrics: Inline[vector.Metric, 2] =[L2, Dot]
    for metric in metrics {
        let (take opened, points, near, far) = open_far(clock, random, metric, code.describe(row_ordinal), recall_shape())
        let mut db = take opened
        let mut model: Model = list.new()
        for _ in 0u64 .. IVF_ROWS + 64 {
            list.push(mut model, None)
        }
        for batch in 0u64 .. IVF_ROWS / 256 {
            let mut steps: List[Step] = list.new()
            for r in batch * 256 .. batch * 256 + 256 {
                let c = near_centre(r % IVF_CENTRES, r + 1)
                list.push(mut steps, Put(r, clone(c)))
                model[r] = Some(take c)
            }
            write_rows(mut db, points, far, take steps)
        }
        // Before the first publication: every row is read exactly.
        let _ = far_state(mut db, points, near, far, metric, model, true)
        let _ = settle(mut db, far)
        recall_line(far_state(mut db, points, near, far, metric, model, false))
        // The tail: the first query's best row deleted, and another row
        // moved onto the query itself, out of its cluster.
        let q = far_query(0)
        let Ok(top) = look_query(db, near, q, 1) else {
            fail("ivf law: form A refused a query")
        }
        let moved = (top[0].key + 1) % IVF_ROWS
        let mut steps: List[Step] = list.new()
        list.push(mut steps, Delete(top[0].key))
        list.push(mut steps, Put(moved, clone(q)))
        model[top[0].key] = None
        model[moved] = Some(clone(q))
        write_rows(mut db, points, far, take steps)
        recall_line(far_state(mut db, points, near, far, metric, model, false))
        if let L2 = metric {
            let Ok(hits) = far_look(db, far, q, IVF_K, IVF_PROBES) else {
                fail("ivf law: form B refused a query")
            }
            if hits[0].key != moved || hits[0].score != 0 {
                fail("ivf law: a row moved in the tail is not read from the tail")
            }
        }
        // Churn folded into delta generations, and merged.
        let mut merged = 0u64
        for round in 0u64 .. 4 {
            write_rows(mut db, points, far, churn(mut model, round))
            merged += settle(mut db, far)
        }
        if merged == 0 {
            fail("ivf law: no merge ran")
        }
        recall_line(far_state(mut db, points, near, far, metric, model, false))
        result.unwrap(store.close(take db))
    }
    Ok(())
}

// Prefilters (Store 3.3) on both forms of one table: 512 rows of 32
// dimensions around 16 centres. Every query reads all 16 clusters and asks
// for at most 10 hits, so form B prunes nothing while the rows a filter
// allows number at most 10 * k: its scan is exhaustive.
const PF_ROWS: u64 = 512

const PF_PROBES: u32 = 16

const PF_ALL: u64 = 1024

const PF_BITS: u64 = 1000

type Both = (Found, Found)

// Not the identity, so a filter that confused a key with its ordinal
// selects other rows. Keys above 332 map past PF_BITS.
fn spread(key: u64) -> u64 {
    key * 3 + 1
}

fn member(bits: std.bitset.BitSet, key: u64) -> bool {
    let at = spread(key)
    at < std.bitset.len(bits) && std.bitset.get(bits, at)
}

// Keys 5, 18, 31, .. below 333: 26 rows. Bits 0, 3 and 999 are no row's
// ordinal, and keys 343, 356, .. would match but map past the bitset.
fn selective() -> std.bitset.BitSet {
    let mut bits = std.bitset.new(PF_BITS)
    for key in 0u64 .. PF_ROWS + 64 {
        if key % 13 == 5 && spread(key) < PF_BITS {
            std.bitset.set(mut bits, spread(key))
        }
    }
    std.bitset.set(mut bits, 0)
    std.bitset.set(mut bits, 3)
    std.bitset.set(mut bits, 999)
    take bits
}

fn both_queries(tx: store.Tx, near: Near, far: Far, q: List[i8], k: u64, filter: vector.Filter) -> (Both, Both) {
    let all: Both = (vector.query(tx, near, q, PF_ALL, Every), vector.query_ivf(tx, far, q, PF_ALL, PF_PROBES, Every))
    let only: Both = (vector.query(tx, near, q, k, filter), vector.query_ivf(tx, far, q, k, PF_PROBES, filter))
    (take all, take only)
}

fn both_run(mut db: store.Db, points: Points, near: Near, far: Far, take steps: List[Step], q: List[i8], k: u64, filter: vector.Filter) -> (Both, Both) waits {
    let ran = result.unwrap(store.run(mut db, None, (store.copy_env(points), store.copy_env(near), store.copy_env(far), take steps, store.copy_env(q), k, store.copy_env(filter)), fn(mut tx, input) -> Result[(Both, Both), store.Error] {
        for step in input.3 {
            match step {
                Put(key, c) => store.put(mut tx, input.0, key, clone(c))?,
                Delete(key) => {
                    let _ = store.delete(mut tx, input.0, key)?
                },
            }
        }
        Ok(both_queries(tx, input.1, input.2, input.4, input.5, input.6))
    }))
    match take ran {
        Committed(take done) => clone(done.value),
        _ => fail("prefilter law: the transaction did not commit"),
    }
}

fn both_look(db: store.Db, near: Near, far: Far, q: List[i8], k: u64, filter: vector.Filter) -> (Both, Both) waits {
    let read_handle = result.unwrap(store.reader(db, 0u64))
    let looked = result.unwrap(store.look(read_handle, store.snapshot(db), None, (store.copy_env(near), store.copy_env(far), store.copy_env(q), k, store.copy_env(filter)), fn(tx, input) -> (Both, Both) {
        both_queries(tx, input.0, input.1, input.2, input.3, input.4)
    }))
    match take looked {
        Seen(take seen) => clone(seen.value),
        _ => fail("prefilter law: the look did not run"),
    }
}

fn hits_or_fail(take found: Found) -> List[vector.Hit[u64]] {
    match take found {
        Ok(take hits) => take hits,
        Error(_) => fail("prefilter law: a query refused"),
    }
}

// The unfiltered list without the rows outside `bits`, cut at k.
fn without(all: List[vector.Hit[u64]], bits: std.bitset.BitSet, k: u64) -> List[vector.Hit[u64]] {
    let mut out: List[vector.Hit[u64]] = list.new()
    for h in all {
        if list.len(out) == k {
            break
        }
        if member(bits, h.key) {
            list.push(mut out, vector.Hit(key: h.key, score: h.score))
        }
    }
    take out
}

// The law on one query: both forms' unfiltered lists over every row agree,
// and each form's filtered list is its unfiltered list with the rows outside
// the filter removed. Returns whether the unfiltered top k held a row
// outside the filter, so that a filter applied after the cut would fail.
fn law_case(take answers: (Both, Both), bits: std.bitset.BitSet, k: u64) -> bool {
    let (take all, take only) = take answers
    let (take all_a, take all_b) = take all
    let (take only_a, take only_b) = take only
    let a = hits_or_fail(take all_a)
    let b = hits_or_fail(take all_b)
    if !same_hits(a, b) {
        fail("prefilter law: exhaustive form B differs from form A")
    }
    let want = without(a, bits, k)
    if !same_hits(hits_or_fail(take only_a), want) {
        fail("prefilter law: form A's filtered list is not its unfiltered list without the rows outside the filter")
    }
    if !same_hits(hits_or_fail(take only_b), want) {
        fail("prefilter law: form B's filtered list is not its unfiltered list without the rows outside the filter")
    }
    for i in 0u64 .. list.len(a) {
        if i == k {
            break
        }
        if !member(bits, a[i].key) {
            return true
        }
    }
    false
}

// Every query of one store state through a look, for the selective filter
// and for one that allows nothing, at k 4 and 10. Returns how many cases
// had a row outside the filter in the unfiltered top k.
fn pf_state(db: store.Db, near: Near, far: Far) -> u64 waits {
    let mut outside = 0u64
    let ks: Inline[u64, 2] =[4, 10]
    for i in 0u64 .. 4 {
        let q = far_query(i)
        for k in ks {
            let bits = selective()
            if law_case(both_look(db, near, far, q, k, Only(clone(bits))), bits, k) {
                outside += 1
            }
            let none = std.bitset.new(0)
            let _ = law_case(both_look(db, near, far, q, k, Only(clone(none))), none, k)
        }
    }
    outside
}

/// bug: a filter applied after form A's or form B's top-k cut, or after form
/// B's 10 * k candidate cut, returns fewer or other rows than the unfiltered
/// list without the rows outside the filter; so does a filter that reads a
/// key as its ordinal, lets a tail row or an ordinal past the bitset
/// through, or drops a tail key from the generations' mask.
/// oracle: the unfiltered model top-k list with the rows outside the filter removed.
@test
fn prefilter(clock: Clock, random: Random) -> Result[(), ()] waits {
    let metrics: Inline[vector.Metric, 2] =[L2, Dot]
    let mut outside = 0u64
    for metric in metrics {
        let (take opened, points, near, far) = open_far(clock, random, metric, code.describe(spread), recall_shape())
        let mut db = take opened
        let mut steps: List[Step] = list.new()
        for r in 0u64 .. PF_ROWS {
            list.push(mut steps, Put(r, near_centre(r % IVF_CENTRES, r + 1)))
        }
        write_rows(mut db, points, far, take steps)
        // Before the first publication form B scans every row exactly.
        outside += pf_state(db, near, far)
        let _ = settle(mut db, far)
        outside += pf_state(db, near, far)
        // The tail, in the writing transaction and after it: the filtered
        // best row deleted, another allowed row and a row past the bitset
        // moved onto the query.
        let q = far_query(0)
        let bits = selective()
        let (_, take only) = both_look(db, near, far, q, 1, Only(clone(bits)))
        let (take first, _) = take only
        let top = hits_or_fail(take first)[0].key
        let moved = if top == 5 {
            18u64
        } else {
            5u64
        }
        let mut tail: List[Step] = list.new()
        list.push(mut tail, Delete(top))
        list.push(mut tail, Put(moved, clone(q)))
        list.push(mut tail, Put(343, clone(q)))
        list.push(mut tail, Put(1, clone(q)))
        if law_case(both_run(mut db, points, near, far, take tail, q, 10, Only(clone(bits))), bits, 10) {
            outside += 1
        }
        outside += pf_state(db, near, far)
        result.unwrap(store.close(take db))
    }
    if outside == 0 {
        fail("prefilter law: no unfiltered top k held a row outside the filter")
    }
    Ok(())
}

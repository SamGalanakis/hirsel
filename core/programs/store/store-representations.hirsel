    match take value {
        MaxBatchBytes => MaxBatchBytes,
        MaxSlots => MaxSlots,
        MaxPins => MaxPins,
        HoldMs => HoldMs,
        IdlePollMs => IdlePollMs,
        IndexEvery => IndexEvery,
        SlotBytes => SlotBytes,
    }
}

fn stream_field_from_rep(take value: types.StreamFieldRep) -> StreamField {
    match take value {
        MaxBatchBytes => MaxBatchBytes,
        MaxSlots => MaxSlots,
        MaxPins => MaxPins,
        HoldMs => HoldMs,
        IdlePollMs => IdlePollMs,
        IndexEvery => IndexEvery,
        SlotBytes => SlotBytes,
    }
}

fn stream_key_to_rep(take value: StreamKey) -> format.StreamKeyRep {
    let StreamKey(caller: take caller, id: id) = take value
    format.StreamKeyRep(caller: caller_to_rep(take caller), id: stream_id_to_rep(id))
}

fn stream_key_from_rep(take value: format.StreamKeyRep) -> StreamKey {
    let format.StreamKeyRep(caller: take caller, id: id) = take value
    StreamKey(caller: caller_from_rep(take caller), id: stream_id_from_rep(id))
}


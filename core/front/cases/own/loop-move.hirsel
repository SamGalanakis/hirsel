// OWN-17, the spec's pair and proto-872 `loop`: a loop body that moves an outer slot without reassigning it before the back edge; refused at the body's closing `}`, the edge that repeats it. Reassigning first is accepted.
// expect: refuse OWN-17 at 11:67
// expect: gap values of this type are not built
fn ok(c: bool) {
  let mut cur = string.new()
  while c {
    let _ = string.into_bytes(take cur)
    cur = string.new()
  }
}
fn bad(take s: String) { loop { let _ = string.into_bytes(take s) } }

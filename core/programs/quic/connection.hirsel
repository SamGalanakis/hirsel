pub type ConnectionHandle: key = ConnectionHandle(u32)

pub type Controller = NewReno | Cubic

pub type RetryPolicy = Never | Always | Above(u32)

pub type EndpointConfig {
    member: u16,
    members: u16,
    cid_len: u8,
    max_mtu: u16,
    retry: RetryPolicy,
    reset_key: Secret,
    token_key: Secret,
    limits: EndpointLimits
}

pub type EndpointLimits {
    connections: u32,
    unvalidated: u32,
    datagram_bytes: u32
}

pub type TransportConfig {
    max_idle_ms: u32,
    initial_max_data: u64,
    initial_max_stream_data: u64,
    max_streams_bidi: u64,
    max_streams_uni: u64,
    max_datagram_frame: u16,
    send_bytes: u64,
    max_gaps: u16,
    cc: Controller,
    alpn: List[String],
    client_pins: Option[List[handshake.Pin]]
}

pub type PeerParams {
    max_idle_ms: u64,
    max_udp_payload: u64,
    max_ack_delay_ms: u64,
    max_datagram_frame: u64,
    reset_stream_at: bool,
    active_cid_limit: u64
}

pub type Output = Transmit(to: Addr, at: u64, len: u64, ecn: u8, send_at: u64) | Wake(at: u64)

pub type Event = Connected(c: ConnectionHandle, alpn: String) | Opened(ConnectionHandle, StreamId) | Readable(ConnectionHandle, StreamId) | Writable(ConnectionHandle, StreamId) | Acked(ConnectionHandle, StreamId) | Reset(c: ConnectionHandle, s: StreamId, code: u64, final_size: u64) | Stopped(ConnectionHandle, StreamId, u64) | Datagram(ConnectionHandle, PayloadSlice) | Closed(ConnectionHandle, CloseReason)

pub type CloseReason = Transport(code: u64, frame: u64) | Application(code: u64) | Idle | Reset | Refused(Refusal)

pub type Refusal = Version | Alpn | Pin | Limit(u32) | Token | Certificate

pub type QuicError = Config | Limit | Handshake(handshake.Error) | UnknownConnection | UnknownStream | StreamState | StreamReset(u64) | TooLarge(u64) | Unsupported

pub type DropReason: key = DatagramTooShort | SmallInitial | SmallUnsupportedVersion | VersionNegotiation | UnsupportedVersion | MalformedHeader | UnknownConnection | WrongPath | SampleTooShort | KeysUnavailable | PacketProtection | Duplicate | Draining | Gaps | ReceiveBuffer | DatagramBuffer | DatagramLate | Truncated

const MAX_NUMBER: u64 = (1u64 << 62) - 1

type ReceiveKeys {
    opener: packet.Opener,
    mask: packet.HeaderMask
}

type SendKeys {
    sealer: packet.Sealer,
    mask: packet.HeaderMask
}

type Reassembly {
    at: u64,
    data: Bytes,
    present: List[bool]
}

type Space {
    receive: Option[ReceiveKeys],
    send: Option[SendKeys],
    next: u64,
    sent: List[codec.AckRange],
    received: List[codec.AckRange],
    discard_before: u64,
    largest: Option[u64],
    ack_pending: bool,
    /// An ACK went into a packet this poll staged: the next one of the poll repeats none.
    ack_staged: bool,
    crypto_in: Reassembly,
    crypto_out: Bytes,
    crypto_committed: u64,
    flights: List[Flight],
    resend: List[Range],
    acked: List[Range],
    probes: u64,
    largest_at: u64,
    ecn_in: codec.EcnCounts,
    token: Bytes,
    key_phase: bool,
    path_out: Bytes,
    hold_data: bool
}

/// What an ack-eliciting packet carried that a loss or probe sends again.
type Flight {
    number: u64,
    crypto_at: u64,
    crypto_end: u64,
    done: bool
}

/// A half-open CRYPTO byte range [at, end) owed again.
type Range {
    at: u64,
    end: u64
}

type CloseFrame {
    code: u64,
    frame: u64,
    application: bool,
    reason: Bytes
}

type Closing {
    wire: CloseFrame,
    pending: bool,
    max_bytes: u64
}

type Life = Open | Closing(Closing) | Draining

pub opaque type Connection {
    handle: ConnectionHandle,
    side: schedule.Side,
    peer: Addr,
    local_id: Bytes,
    initial_id: Bytes,
    original_id: Bytes,
    retry_source: Option[Bytes],
    peer_id: Bytes,
    authenticated: bool,
    initial: Space,
    encrypted: Space,
    application: Space,
    tls: Option[handshake.Handshake],
    transport: TransportConfig,
    server_id: Option[handshake.Identity],
    params: Option[handshake.TransportParameters],
    peer_pin: Option[handshake.Pin],
    handshake_done: bool,
    done_acked: bool,
    life: Life,
    deadline: Option[u64],
    idle_rearmed: bool,
    recovery: recovery.Recovery,
    wake: Option[u64],
    streams: Streams,
    reset: Bytes,
    peer_reset: Option[Bytes],
    validated: bool,
    path_received: u64,
    path_sent: u64,
    keys: KeyUpdate,
    probe: Option[PathProbe],
    probing_only: bool,
    stream_packets: u64,
    mtu: PathMtu,
    tx_payload: Bytes,
    rx_ack_ranges: List[codec.AckRange],
    ack_acked: List[u64],
    ack_lost: List[u64]
}

fn inflight_capacity(send_bytes: u64) -> u64 {
    order.min(order.max((send_bytes + 1023) / 1024, 64), 256)
}

fn parameters(t: TransportConfig, take local_id: Bytes, mtu: u16) -> handshake.TransportParameters {
    let mut p = handshake.default_parameters(take local_id)
    p.max_idle_ms = int.widen(t.max_idle_ms)
    p.max_udp_payload = int.widen(mtu)
    p.initial_max_data = t.initial_max_data
    p.initial_max_stream_data_bidi_local = t.initial_max_stream_data
    p.initial_max_stream_data_bidi_remote = t.initial_max_stream_data
    p.initial_max_stream_data_uni = t.initial_max_stream_data
    p.initial_max_streams_bidi = t.max_streams_bidi
    p.initial_max_streams_uni = t.max_streams_uni
    p.max_datagram_frame = int.widen(t.max_datagram_frame)
    p.active_cid_limit = 8
    p.reset_stream_at = true
    take p
}

fn protocols(t: TransportConfig) -> List[Bytes] {
    let mut out: List[Bytes] = list.with_capacity(list.len(t.alpn))
    for name in t.alpn {
        list.push(mut out, clone(string.as_bytes(name)))
    }
    take out
}

fn new_connection(handle: ConnectionHandle, side: schedule.Side, peer: Addr, take local_id: Bytes, take initial_id: Bytes, take original_id: Bytes, take peer_id: Bytes, take transport: TransportConfig, take server_id: Option[handshake.Identity], mtu: u16, now: u64) -> Result[Connection, QuicError] {
    let mut initial = new_space()
    let Ok(take initial_schedule) = schedule.quic_initial(side, initial_id) else {
        return Error(Config)
    }
    let mut keys = take initial_schedule
    if !install_keys(mut initial, mut keys, Initial) {
        return Error(Config)
    }
    let algorithm: recovery.Algorithm = match transport.cc {
        NewReno => Reno,
        Cubic => CubicHystart,
    }
    let server = match side {
        Server => true,
        Client => false,
    }
    let cap = inflight_capacity(transport.send_bytes)
    let mut rec = recovery.new(algorithm, BASE_MTU, server)
    recovery.reserve_application(mut rec, cap)
    let mut c = Connection(handle: handle, side: side, peer: peer, local_id: take local_id, initial_id: take initial_id, original_id: take original_id, retry_source: None, peer_id: take peer_id, authenticated: false, initial: take initial, encrypted: new_space(), application: new_space(), tls: None, transport: take transport, server_id: take server_id, params: None, peer_pin: None, handshake_done: false, done_acked: false, life: Open, deadline: None, idle_rearmed: false, recovery: take rec, wake: None, streams: no_streams(), reset: b"", peer_reset: None, validated: !server, path_received: 0, path_sent: 0, keys: no_key_update(), probe: None, probing_only: false, stream_packets: 0, mtu: base_mtu(), tx_payload: list.with_capacity(order.max(int.widen(mtu), BASE_MTU)), rx_ack_ranges: list.with_capacity(64), ack_acked: list.with_capacity(order.min(cap, 128)), ack_lost: list.with_capacity(16))
    refresh_idle(mut c, now)
    Ok(take c)
}

/// RFC 9000 §8.1: before the peer's address is validated, a server sends at most three
/// times the bytes it received on the path, counted at `committed` with padding.
fn amplification_room(c: Connection) -> u64 {
    if c.validated {
        return 0xffffffffffffffff
    }
    let allowed = int.saturating_mul(3, c.path_received)
    allowed - order.min(allowed, c.path_sent)
}

/// RFC 9002 §6.2.2.1: a server that can send no full packet does not arm its PTO until
/// more arrives from the client, so a blocked server neither probes nor backs off.
fn amplification_blocked(c: Connection) -> bool {
    amplification_room(c) < BASE_MTU
}

fn open_life(c: Connection) -> bool {
    match c.life {
        Open => true,
        _ => false,
    }
}

fn deadline_after(now: u64, duration: u64) -> u64 {
    now + order.min(duration, 0xffffffffffffffff - now)
}

/// RFC 9000 §10.1 and §10.2: three times the current probe timeout.
fn three_pto(c: Connection) -> u64 {
    int.saturating_mul(3, recovery.pto(c.recovery))
}

fn refresh_idle(mut c: Connection, now: u64) {
    let local: u64 = int.widen(c.transport.max_idle_ms)
    let peer = match c.params {
        Some(p) => p.max_idle_ms,
        None => 0,
    }
    let ms = if local == 0 || peer == 0 {
        order.max(local, peer)
    } else {
        order.min(local, peer)
    }
    c.deadline = if ms == 0 {
        None
    } else {
        Some(deadline_after(now, order.max(three_pto(c), order.min(ms, 18446744073709) * 1000000)))
    }
}

fn start_closing(mut c: Connection, now: u64, take wire: CloseFrame) {
    c.life = Closing(Closing(wire: take wire, pending: true, max_bytes: 65527))
    c.deadline = Some(deadline_after(now, three_pto(c)))
}

fn start_draining(mut c: Connection, now: u64) {
    c.life = Draining
    c.deadline = Some(deadline_after(now, three_pto(c)))
}

fn transport_close(code: u64, frame: u64) -> CloseFrame {
    CloseFrame(code: code, frame: frame, application: false, reason: b"")
}

fn refuse(mut c: Connection, now: u64, code: u64, frame: u64, reason: CloseReason, mut events: List[Event]) {
    start_closing(mut c, now, transport_close(code, frame))
    list.push(mut events, Closed(c.handle, reason))
}

fn established(c: Connection) -> bool {
    if let Some(_) = c.params {
        return true
    }
    false
}

fn space_index(level: packet.Space) -> u64 {
    match level {
        Initial => recovery.INITIAL,
        Handshake => recovery.HANDSHAKE,
        _ => recovery.APPLICATION,
    }
}

/// RFC 9001 §4.9 and RFC 9002 A.11: discard a space's keys and its recovery state. The
/// second discard of a space is a no-op, so it never resets the PTO backoff again.
fn drop_space(mut c: Connection, index: u64, now: u64) {
    if index == recovery.INITIAL {
        if let None = c.initial.send {
            return
        }
        discard(mut c.initial)
    } else {
        if let None = c.encrypted.send {
            return
        }
        discard(mut c.encrypted)
    }
    recovery.discard(mut c.recovery, now, index)
}

/// RFC 9001 §4.1.2: the handshake is confirmed, so the Handshake space goes (§4.9.2).
fn confirm(mut c: Connection, now: u64) {
    drop_space(mut c, recovery.HANDSHAKE, now)
    recovery.confirm(mut c.recovery, now)
}

/// Apply recovery's verdict to the frames those packets carried.
fn settle(mut c: Connection, now: u64, index: u64, acked: List[u64], lost: List[u64], mut events: List[Event]) {
    let done = match index {
        0 => settle_space(mut c.initial, acked, lost),
        1 => settle_space(mut c.encrypted, acked, lost),
        _ => {
            settle_streams(mut c.streams, c.handle, acked, lost, mut events)
            settle_space(mut c.application, acked, lost)
        },
    }
    // RFC 9000 §13.3: HANDSHAKE_DONE is sent again only until one copy is acknowledged.
    c.done_acked = c.done_acked || done.acked
    c.handshake_done = (c.handshake_done || done.lost) && !c.done_acked
    settle_mtu(mut c, now, index, acked, lost)
}

/// Run the loss detection timer when it is due (RFC 9002 A.9). Returns true when loss or
/// PTO queued work that must be scheduled for transmission.
fn recovery_due(mut c: Connection, now: u64, mut events: List[Event]) -> bool {
    if !open_life(c) {
        return false
    }
    let Some(at) = recovery.timer(c.recovery) else {
        return false
    }
    if amplification_blocked(c) {
        return false
    }
    if at > now {
        return false
    }
    let mut lost = replace(mut c.ack_lost, list.new())
    let mut queued = false
    match recovery.on_timeout_into(mut c.recovery, now, mut lost) {
        TimeoutLost(index) => {
            let empty: List[u64] = list.new()
            settle(mut c, now, index, empty, lost, mut events)
            queued = true
        },
        TimeoutProbe(index) => {
            let count = order.min(order.max(recovery.pto_count(c.recovery), 1), 2)
            let done = match index {
                0 => {
                    let mut d = probe_space(mut c.initial, count)
                    if recovery.has_eliciting_in_flight(c.recovery, recovery.HANDSHAKE) {
                        d = d || probe_space(mut c.encrypted, count)
                    }
                    d
                },
                1 => {
                    let mut d = probe_space(mut c.encrypted, count)
                    if recovery.has_eliciting_in_flight(c.recovery, recovery.INITIAL) {
                        d = d || probe_space(mut c.initial, count)
                    }
                    d
                },
                _ => {
                    if !has_pending_streams(c.streams) {
                        probe_streams(mut c.streams)
                    }
                    probe_space(mut c.application, count)
                },
            }
            c.handshake_done = (c.handshake_done || done) && !c.done_acked
            queued = true
        },
        TimeoutIdle => (),
    }
    c.ack_lost = take lost
    queued
}

// Why an object endpoint cannot hold an objects@1 or sim@1 store (§12.2).
pub type EndpointRefusal: shareable + cross = Insecure | Unproven | NotSimulator | IgnoresIfNoneMatch | IgnoresIfMatch

pub fn endpoint_refusal_text(reason: EndpointRefusal) -> String {
    string.from(match reason {
        Insecure => "the object store endpoint is not https",
        Unproven => "the loopback endpoint did not answer with the simulator's proof",
        NotSimulator => "a sim@1 store needs a std.sim.s3 client",
        IgnoresIfNoneMatch => "the object store endpoint applied a PUT whose If-None-Match condition failed",
        IgnoresIfMatch => "the object store endpoint applied a PUT whose If-Match condition failed",
    })
}

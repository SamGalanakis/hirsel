// CONC-2, CONC-15, CONC-17: an Inbox is send but not cross, so a cross record may not hold
// one; a Client of a cross item is cross. A unit's entry must be cross (CONC-15: Arc is not
// cross), and a connection of a non-cross item cannot be named (Client[T: cross]).
type Hello: cross {
    back: Inbox[u64]
}

type Reply: cross {
    back: Client[u64],
    n: u64
}

fn serve(take a: Arc[u64]) -> u64 {
    1
}

fn start(tasks: Tasks, take a: Arc[u64]) waits {
    let _ = task.spawn_unit(tasks, bytes 64, take a, serve)
}

fn open() {
    let r: Result[(Client[Arc[u64]], Inbox[Arc[u64]]), Capacity] = conn.new(1, bytes 0)
}
// expect: refuse CONC-2 at 5:5
// expect: refuse CONC-15 at 18:46
// expect: compared CONC-2 at 5:5 | core@1/core/Inbox[u64] | cross
// expect: compared CONC-15 at 18:46 | core@1/core/Arc[u64] | cross
// expect: refuse LANG-12 at 22:27
// expect: refuse LANG-12 at 22:44
// expect: compared LANG-12 at 22:27 | core@1/core/Arc[u64] | cross
// expect: compared LANG-12 at 22:44 | core@1/core/Arc[u64] | cross

// A socket half still moves between tasks in a unit, but cannot be sent to
// another unit. Transfer the whole socket before splitting it.
fn send_read(take half: ReadHalf, to: Client[ReadHalf]) waits {
    let _ = conn.send(to, take half)
}

fn send_write(take half: WriteHalf, to: Client[WriteHalf]) waits {
    let _ = conn.send(to, take half)
}
// expect: refuse LANG-12 at 35:46
// expect: compared LANG-12 at 35:46 | core@1/core/ReadHalf | cross
// expect: refuse LANG-12 at 39:48
// expect: compared LANG-12 at 39:48 | core@1/core/WriteHalf | cross
// expect: refuse CONC-2 at 36:23
// expect: compared CONC-2 at 36:23 | core@1/core/ReadHalf | cross
// expect: refuse CONC-2 at 40:23
// expect: compared CONC-2 at 40:23 | core@1/core/WriteHalf | cross

// CONC-2: a variant type that declares cross is cross when each field of each case is, so
// a request with a String and Client reply arms crosses; one with a Sender arm is refused.
type Req: cross = Read(u64, String, Client[String]) | Stats(Client[u64])

type Fan: cross = Out(Sender[u64]) | Done

fn open_req() {
    let r: Result[(Client[Req], Inbox[Req]), Capacity] = conn.new(1, bytes 0)
}
// expect: refuse CONC-2 at 55:23
// expect: compared CONC-2 at 55:23 | core@1/core/Sender[u64] | cross

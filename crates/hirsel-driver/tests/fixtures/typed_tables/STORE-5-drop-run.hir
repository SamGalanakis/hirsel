// rule: STORE-5
// expect: run
// Dropping a table removes its rows and history and nothing else, in commits
// within the store's limits however large the table; refusals change nothing.
fn rows(a: Authority, mut s: store.Store, name: String) -> u64 {
  let Ok(snap) = store.snapshot(a, mut s, authority.floor(a)) else {
    return 0
  }
  let mut prefix: List[u8] = []
  bytes.append(mut prefix, b"hirsel.rows/")
  bytes.append(mut prefix, keys.encode(name))
  let (low, high) = store.prefix_bounds(bytes.from_list(take prefix))
  list.len(store.range(snap, low, high, Ascending(), 200))
}

// Nothing waits to be deleted.
fn settled(a: Authority, mut s: store.Store) -> bool {
  let Ok(snap) = store.snapshot(a, mut s, authority.floor(a)) else {
    return false
  }
  let (low, high) = store.prefix_bounds(b"hirsel.garbage/")
  list.len(store.range(snap, low, high, Ascending(), 10)) == 0
}

// Each table's creation is its own commit: one creation's descriptors are most
// of what the limits below allow.
fn create(mut tx: store.Tx, info: store.CallInfo, name: String) -> Result[
  (),
  store.TxError
] {
  let t: table.Table[u32, String] = table.named(name)
  table.create(mut tx, t)
}

fn keep(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), store.TxError] {
  let item: table.Table[u32, String] = table.named("item")
  for k in 1u32..6u32 {
    table.put(mut tx, item, k, "kept")?
  }
  Ok(())
}

// Rows `from` up to `from + 10` of `items`, one commit within the limits.
fn fill(mut tx: store.Tx, info: store.CallInfo, from: u32) -> Result[(), store.TxError] {
  let items: table.Table[u32, String] = table.named("items")
  for k in from..from + 10 {
    table.put(mut tx, items, k, "dropped")?
  }
  Ok(())
}

fn delete_all(mut tx: store.Tx, info: store.CallInfo, n: u32) -> Result[
  (),
  store.TxError
] {
  let items: table.Table[u32, String] = table.named("items")
  for k in 1u32..n {
    let _ = table.delete(mut tx, items, k)?
  }
  Ok(())
}

// The dropped table is gone, and one of the same name starts empty with a
// fresh history.
fn recreate(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[
  bool,
  store.TxError
] {
  let items: table.Table[u32, String] = table.named("items")
  let wrong: table.Table[u32, u64] = table.named("items")
  if table.get(tx, items, 1) != Error(NoTable()) || table.history(tx, "items") != Error(
    NoTable()
  ) {
    return Ok(false)
  }
  table.create(mut tx, wrong)?
  let fresh = table.range(tx, wrong, Unbounded(), Unbounded(), 10, Ascending())?
  Ok(list.len(fresh) == 0 && list.len(table.history(tx, "items")?) == 1)
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  // Under these limits no one commit deletes every row of `items`.
  let mut tight = store.default_config()
  tight.limits.transaction_bytes = 4000
  let mut small = store.open(a, tight) ? Store
  let items: table.Table[u32, String] = table.named("items")
  check(store.transact(mut small, create, "item") == Ok(()))?
  check(store.transact(mut small, create, "items") == Ok(()))?
  check(store.transact(mut small, keep, ()) == Ok(()))?
  for from in [1u32, 11, 21, 31, 41, 51, 61, 71, 81, 91] {
    let filled = store.transact(mut small, fill, from)
    check(filled == Ok(()))?
  }
  let too_large = store.transact(mut small, delete_all, 101u32)
  // Refused whether a write or the encoded commit first exceeds the limit.
  check(
    too_large == Error(Limit(TransactionBytes())) || too_large == Error(
      Aborted(Limit(TransactionBytes()))
    )
  )?
  let wrong: table.Table[u32, u64] = table.named("items")
  let invalid: table.Table[u32, String] = table.named("hirsel.items")
  let missing: table.Table[u32, String] = table.named("missing")
  check(table.drop(mut small, wrong) == Error(Aborted(Schema(ValueMismatch()))))?
  check(table.drop(mut small, invalid) == Error(Aborted(InvalidInput())))?
  check(table.drop(mut small, missing) == Error(Aborted(NoTable())))?
  check(rows(a, mut small, "items") == 100)?
  check(table.drop(mut small, items) == Ok(()))?
  check(table.drop(mut small, items) == Error(Aborted(NoTable())))?
  check(
    rows(a, mut small, "items") == 0 && rows(a, mut small, "item") == 5 && settled(
      a,
      mut small
    )
  )?
  let gone = store.transact(mut small, recreate, ())
  check(gone == Ok(true))?
  Ok(())
}

// rule: CLO-1
// expect: reject CLO-1 at line 16
// twin: CLO/CLO-1-tx-range-step-write-ok.hir
// `store.tx_range` reads the transaction while its step runs. The step
// captures `tx` by borrowing, so it cannot write through it: the keys and
// values it is given are views of that state.
fn copy_rows(mut tx: store.Tx) -> Result[u64, store.TxError] {
  store.tx_range(
    tx,
    Unbounded(),
    Unbounded(),
    8,
    Ascending(),
    0u64,
    fn(take n: u64, key: Bytes, value: Bytes) -> (u64, bool) {
      let _ = store.tx_put(mut tx, b"copied", unique value)
      (n + 1, true)
    }
  )
}

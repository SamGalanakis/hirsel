// rule: SEM-5
// expect: run
// cuts: 1..=26
// steps: 20000000
// Bulk construction and ordinary insertion agree across leaf and internal
// node boundaries. Invalid order is refused, including comparator-equal keys.
fn check(t: Io, condition: bool) -> () uses {} {
  failure.check(condition, Bounds())
}

fn by_value(a: u64, b: u64) -> i32 uses {} {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

fn backwards(a: u64, b: u64) -> i32 uses {} {
  by_value(b, a)
}

fn by_tens(a: u64, b: u64) -> i32 uses {} {
  by_value(a / 10, b / 10)
}

fn entries(m: ordered_map.OrderedMap[u64, u64]) -> List[(u64, u64)] {
  let initial: List[(u64, u64)] = []
  ordered_map.fold_range(
    m,
    Unbounded(),
    Unbounded(),
    Ascending(),
    take initial,
    fn(take acc: List[(u64, u64)], k: u64, v: u64) -> (List[(u64, u64)], bool) {
      let mut out = take acc
      list.push(mut out, (k, v))
      (take out, true)
    }
  )
}

fn range_entries(m: ordered_map.OrderedMap[u64, u64], lo: u64, hi: u64, down: bool) -> List[
  (u64, u64)
] {
  let initial: List[(u64, u64)] = []
  ordered_map.fold_range(
    m,
    Included(lo),
    Excluded(hi),
    if down {
      Descending()
    } else {
      Ascending()
    },
    take initial,
    fn(take acc: List[(u64, u64)], k: u64, v: u64) -> (List[(u64, u64)], bool) {
      let mut out = take acc
      list.push(mut out, (k, v))
      (take out, true)
    }
  )
}

fn refused(take rows: List[(u64, u64)]) -> bool {
  let made = ordered_map.from_sorted(by_value, take rows)
  match take made {
    Error(_) => true,
    Ok(_) => false,
  }
}

pub fn main(t: Io, args: Args) -> Result[(), ()] {
  let Ok(text) = arg.text(args, 0) else {
    return Error(())
  }
  let Ok(part) = u64.parse(text) else {
    return Error(())
  }
  // DEGREE=16; full two-level bulk tree=32*32-1. Sorted insertion
  // grows its third level near 512, so both constructions' boundaries appear.
  let sizes: List[u64] = [
    0,
    1,
    14,
    15,
    16,
    17,
    30,
    31,
    32,
    33,
    46,
    47,
    48,
    49,
    254,
    255,
    256,
    257,
    510,
    511,
    512,
    513,
    1022,
    1023,
    1024,
    1025
  ]
  let n = sizes[part - 1]
  {
    let mut rows: List[(u64, u64)] = []
    let mut inserted: ordered_map.OrderedMap[u64, u64] = ordered_map.empty(by_value)
    for k in 0u64..n {
      list.push(mut rows, (k, k * 3 + 7))
      ordered_map.insert(mut inserted, k, k * 3 + 7)
    }
    let retained = copy rows
    let Ok(built) = ordered_map.from_sorted(by_value, take rows) else {
      check(t, false)
      return Ok(())
    }
    check(t, ordered_map.valid(built) && ordered_map.valid(inserted))
    check(t, ordered_map.len(built) == n && entries(built) == retained)
    check(t, entries(built) == entries(inserted))
    check(
      t,
      range_entries(built, n / 3, n * 2 / 3 + 1, false) == range_entries(
        inserted,
        n / 3,
        n * 2 / 3 + 1,
        false
      )
    )
    check(
      t,
      range_entries(built, n / 3, n * 2 / 3 + 1, true) == range_entries(
        inserted,
        n / 3,
        n * 2 / 3 + 1,
        true
      )
    )
    check(t, ordered_map.first(built) == ordered_map.first(inserted))
    check(t, ordered_map.last(built) == ordered_map.last(inserted))
    for k in 0u64..n {
      check(t, ordered_map.get(built, k) == ordered_map.get(inserted, k))
    }
    let saved = copy built
    let mut changed = take built
    for k in 0u64..n {
      if k % 7 == 0 {
        check(
          t,
          ordered_map.remove(mut changed, k) == ordered_map.remove(mut inserted, k)
        )
      }
    }
    ordered_map.insert(mut changed, n + 2, 19)
    ordered_map.insert(mut inserted, n + 2, 19)
    check(t, ordered_map.valid(changed) && entries(changed) == entries(inserted))
    check(t, ordered_map.valid(saved) && entries(saved) == retained)
  }
  if part != 1 {
    return Ok(())
  }
  check(t, refused([(0u64, 1u64), (0, 2)]))
  check(t, refused([(2u64, 1u64), (1, 2)]))
  check(t, refused([(0u64, 1u64), (2, 2), (1, 3)]))
  for at in [1u64, 15, 16, 30, 31, 32, 39] {
    let mut bad: List[(u64, u64)] = []
    for k in 0u64..40 {
      list.push(mut bad, (k, k))
    }
    bad[at] = (at - 1, 5)
    check(t, refused(take bad))
  }
  let equal = ordered_map.from_sorted(by_tens, [(11u64, 1u64), (12, 2)])
  check(
    t,
    match take equal {
      Error(_) => true,
      Ok(_) => false,
    }
  )
  let Ok(reverse) = ordered_map.from_sorted(backwards, [(3u64, 7u64), (2, 8), (1, 9)]) else {
    check(t, false)
    return Ok(())
  }
  check(
    t,
    ordered_map.valid(reverse) && entries(reverse) == [(3u64, 7u64), (2, 8), (1, 9)]
  )
  Ok(())
}

// AV1 bitstream §5.3 and AV1 RTP payload format §4.5.
pub type Error = Truncated | InvalidHeader | InvalidLength

pub type Obu {
    kind: u8,
    temporal: u8,
    spatial: u8,
    payload_start: u64,
    end: u64
}

fn leb128(data: Bytes, mut at: u64, end: u64) -> Result[u64, Error] {
    let mut value: u64 = 0
    for octet in 0u64 .. 8 {
        if at == end {
            return Error(Truncated)
        }
        let byte = data[at]
        at += 1
        let part: u64 = int.widen(byte & 127)
        value |= part << (7 * octet)
        if (byte & 128) == 0 {
            if value > 4294967295 {
                return Error(InvalidLength)
            }
            return Ok(value)
        }
    }
    Error(InvalidLength)
}

// Parse one OBU beginning at start. The caller supplies exactly one remaining
// OBU when the header omits obu_size.
pub fn parse_obu(data: Bytes, start: u64) -> Result[Obu, Error] {
    let end = list.len(data)
    if start >= end {
        return Error(Truncated)
    }
    let header = data[start]
    if (header & 129) != 0 {
        return Error(InvalidHeader)
    }
    let mut at = start + 1
    let mut temporal: u8 = 0
    let mut spatial: u8 = 0
    if (header & 4) != 0 {
        if at == end {
            return Error(Truncated)
        }
        let extension = data[at]
        at += 1
        if (extension & 7) != 0 {
            return Error(InvalidHeader)
        }
        temporal = extension >> 5
        spatial = (extension >> 3) & 3
    }
    let size = if (header & 2) != 0 {
        leb128(data, mut at, end)?
    } else {
        end - at
    }
    if size > end - at {
        return Error(Truncated)
    }
    Ok(Obu(kind: (header >> 3) & 15, temporal: temporal, spatial: spatial, payload_start: at, end: at + size))
}

// Read the state needed to classify a frame from a sequence-header OBU payload.
pub fn reduced_still_picture(sequence_payload: Bytes) -> Result[bool, Error] {
    if list.len(sequence_payload) == 0 {
        return Error(Truncated)
    }
    let prefix = sequence_payload[0]
    let reduced = (prefix & 8) != 0
    if (prefix >> 5) > 2 || (reduced && (prefix & 16) == 0) {
        return Error(InvalidHeader)
    }
    Ok(reduced)
}

// Classify the prefix of a frame-header or frame OBU payload, once the
// sequence header is known. A show_existing_frame carries no new keyframe.
pub fn is_keyframe(frame_payload: Bytes, reduced: bool) -> Result[bool, Error] {
    if list.len(frame_payload) == 0 {
        return Error(Truncated)
    }
    Ok(reduced || (frame_payload[0] & 224) == 0)
}

pub type Aggregation {
    continues_previous: bool,
    continues_next: bool,
    starts_sequence: bool,
    count: u64
}

pub type Element {
    start: u64,
    end: u64,
    continues_previous: bool,
    continues_next: bool
}

fn aggregation_header(packet: Bytes) -> Result[u8, Error] {
    if list.len(packet) < 2 {
        return Error(Truncated)
    }
    let header = packet[0]
    if (header & 136) == 136 {
        return Error(InvalidHeader)
    }
    Ok(header)
}

fn next_element(packet: Bytes, header: u8, mut at: u64, index: u64) -> Result[Option[Element], Error] {
    let end = list.len(packet)
    let fixed: u64 = int.widen((header >> 4) & 3)
    if at == 0 || at > end {
        return Error(InvalidLength)
    }
    if at == end {
        if fixed != 0 && index != fixed {
            return Error(Truncated)
        }
        return Ok(None)
    }
    if fixed != 0 && index >= fixed {
        return Error(InvalidLength)
    }
    let size = if fixed != 0 && index == fixed - 1 {
        end - at
    } else {
        leb128(packet, mut at, end)?
    }
    if size == 0 {
        return Error(InvalidLength)
    }
    if size > end - at {
        return Error(Truncated)
    }
    let start = at
    at += size
    Ok(Some(Element(start: start, end: at, continues_previous: index == 0 && (header & 128) != 0, continues_next: at == end && (header & 64) != 0)))
}

// Validate element lengths and expose the aggregation flags. OBU contents may
// span packets and can be inspected separately once their header is available.
pub fn parse_rtp(packet: Bytes) -> Result[Aggregation, Error] {
    let header = aggregation_header(packet)?
    let mut at: u64 = 1
    let mut count: u64 = 0
    while let Some(_) = next_element(packet, header, mut at, count)? {
        count += 1
    }
    Ok(Aggregation(continues_previous: (header & 128) != 0, continues_next: (header & 64) != 0, starts_sequence: (header & 8) != 0, count: count))
}

// For the first element, use offset 1 and index 0.
pub fn rtp_next(packet: Bytes, mut at: u64, index: u64) -> Result[Option[Element], Error] {
    let header = aggregation_header(packet)?
    next_element(packet, header, mut at, index)
}

/// The parts of an AV1 sequence header that av1C and the RFC 6381 codec
/// string carry.
pub type Sequence {
    profile: u8,
    level: u8,
    tier: u8,
    high_bitdepth: bool,
    twelve_bit: bool,
    monochrome: bool,
    subsampling_x: bool,
    subsampling_y: bool,
    sample_position: u8,
    // max_frame_width_minus_1 + 1 and max_frame_height_minus_1 + 1.
    width: u32,
    height: u32
}

type Bits {
    at: u64,
    end: u64
}

fn read_bit(data: Bytes, mut b: Bits) -> Result[u64, Error] {
    if b.at >= b.end {
        return Error(InvalidHeader)
    }
    let byte = data[b.at / 8]
    let shift: u8 = int.narrow(7 - b.at % 8)
    b.at += 1
    Ok(int.widen((byte >> shift) & 1))
}

fn read_bits(data: Bytes, mut b: Bits, n: u64) -> Result[u64, Error] {
    let mut v = 0u64
    for _ in 0u64 .. n {
        v = v << 1 | read_bit(data, mut b)?
    }
    Ok(v)
}

fn uvlc(data: Bytes, mut b: Bits) -> Result[u64, Error] {
    let mut zeros = 0u64
    while read_bit(data, mut b)? == 0 {
        zeros += 1
        if zeros >= 32 {
            return Error(InvalidHeader)
        }
    }
    let _ = read_bits(data, mut b, zeros)?
    Ok(0)
}

/// AV1 §5.5.1 sequence_header_obu of a whole OBU, through the first operating
/// point, the maximum frame size and color_config.
pub fn sequence(obu: Bytes) -> Result[Sequence, Error] {
    let o = parse_obu(obu, 0)?
    if o.kind != 1 {
        return Error(InvalidHeader)
    }
    let mut b = Bits(at: o.payload_start * 8, end: o.end * 8)
    let profile = read_bits(obu, mut b, 3)?
    let _ = read_bit(obu, mut b)?
    let reduced = read_bit(obu, mut b)? == 1
    let mut level = 0u64
    let mut tier = 0u64
    if reduced {
        level = read_bits(obu, mut b, 5)?
    } else {
        let timing = read_bit(obu, mut b)? == 1
        let mut decoder_model = false
        let mut delay_length = 0u64
        if timing {
            let _ = read_bits(obu, mut b, 64)?
            if read_bit(obu, mut b)? == 1 {
                let _ = uvlc(obu, mut b)?
            }
            decoder_model = read_bit(obu, mut b)? == 1
            if decoder_model {
                delay_length = read_bits(obu, mut b, 5)? + 1
                let _ = read_bits(obu, mut b, 32 + 5 + 5)?
            }
        }
        let display_delay = read_bit(obu, mut b)? == 1
        let points = read_bits(obu, mut b, 5)? + 1
        for i in 0u64 .. points {
            let _ = read_bits(obu, mut b, 12)?
            let l = read_bits(obu, mut b, 5)?
            let t = if l > 7 {
                read_bits(obu, mut b, 1)?
            } else {
                0u64
            }
            if i == 0 {
                level = l
                tier = t
            }
            if decoder_model {
                if read_bit(obu, mut b)? == 1 {
                    let _ = read_bits(obu, mut b, 2 * delay_length + 1)?
                }
            }
            if display_delay {
                if read_bit(obu, mut b)? == 1 {
                    let _ = read_bits(obu, mut b, 4)?
                }
            }
        }
    }
    let width_bits = read_bits(obu, mut b, 4)? + 1
    let height_bits = read_bits(obu, mut b, 4)? + 1
    let width = read_bits(obu, mut b, width_bits)? + 1
    let height = read_bits(obu, mut b, height_bits)? + 1
    let mut frame_ids = false
    if !reduced {
        frame_ids = read_bit(obu, mut b)? == 1
    }
    if frame_ids {
        let _ = read_bits(obu, mut b, 7)?
    }
    // use_128x128_superblock, enable_filter_intra, enable_intra_edge_filter
    let _ = read_bits(obu, mut b, 3)?
    if !reduced {
        // interintra, masked compound, warped motion, dual filter
        let _ = read_bits(obu, mut b, 4)?
        let order_hint = read_bit(obu, mut b)? == 1
        if order_hint {
            let _ = read_bits(obu, mut b, 2)?
        }
        let mut force_screen = 2u64
        if read_bit(obu, mut b)? == 0 {
            force_screen = read_bit(obu, mut b)?
        }
        if force_screen > 0 {
            if read_bit(obu, mut b)? == 0 {
                let _ = read_bit(obu, mut b)?
            }
        }
        if order_hint {
            let _ = read_bits(obu, mut b, 3)?
        }
    }
    // enable_superres, enable_cdef, enable_restoration
    let _ = read_bits(obu, mut b, 3)?
    let high = read_bit(obu, mut b)? == 1
    let mut twelve = false
    if profile == 2 && high {
        twelve = read_bit(obu, mut b)? == 1
    }
    let mono = if profile == 1 {
        false
    } else {
        read_bit(obu, mut b)? == 1
    }
    let mut primaries = 2u64
    let mut transfer = 2u64
    let mut matrix = 2u64
    if read_bit(obu, mut b)? == 1 {
        primaries = read_bits(obu, mut b, 8)?
        transfer = read_bits(obu, mut b, 8)?
        matrix = read_bits(obu, mut b, 8)?
    }
    let mut sx = true
    let mut sy = true
    let mut position = 0u64
    if mono {
        let _ = read_bit(obu, mut b)?
    } else if primaries == 1 && transfer == 13 && matrix == 0 {
        sx = false
        sy = false
    } else {
        let _ = read_bit(obu, mut b)?
        if profile == 0 {
            sx = true
            sy = true
        } else if profile == 1 {
            sx = false
            sy = false
        } else if twelve {
            sx = read_bit(obu, mut b)? == 1
            sy = if sx {
                read_bit(obu, mut b)? == 1
            } else {
                false
            }
        } else {
            sx = true
            sy = false
        }
        if sx && sy {
            position = read_bits(obu, mut b, 2)?
        }
    }
    Ok(Sequence(profile: int.narrow(profile), level: int.narrow(level), tier: int.narrow(tier), high_bitdepth: high, twelve_bit: twelve, monochrome: mono, subsampling_x: sx, subsampling_y: sy, sample_position: int.narrow(position), width: int.narrow(width), height: int.narrow(height)))
}

#!/usr/bin/env python3
"""Refuse Git conflict markers in tracked text, including orphaned hunk ends.

Standalone ======= lines are valid Markdown setext underlines. Marker examples
in fixtures must be quoted or indented, just like any other literal source.
"""
from pathlib import Path
import subprocess
import sys


def main():
    paths = subprocess.check_output(['git', 'ls-files', '-z']).split(b'\0')
    errors = []
    for name in paths:
        if not name:
            continue
        path = Path(name.decode(sys.getfilesystemencoding(), 'surrogateescape'))
        if path.is_symlink() or not path.is_file():
            continue
        data = path.read_bytes()
        if b'\0' in data:
            continue
        inside = False
        for number, line in enumerate(data.splitlines(), 1):
            opening = line.startswith(b'<<<<<<< ')
            closing = line.startswith(b'>>>>>>> ')
            if opening or closing or (inside and line == b'======='):
                errors.append(f'{path}:{number}: unresolved conflict marker')
            if opening:
                inside = True
            elif closing:
                inside = False
    if errors:
        print('\n'.join(errors), file=sys.stderr)
    return bool(errors)


if __name__ == '__main__':
    sys.exit(main())

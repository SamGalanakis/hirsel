fn scrub_fill(mut db: Db, t: Table[u64, u64], rows: u64, add: u64) -> Result[(), Error] waits {
    let out = run(mut db, None, (copy_env(add), copy_env(rows), copy_env(t)), fn(mut tx, call_env) -> Result[(), Error] {
        for k in 0u64 .. call_env.1 {
            put(mut tx, call_env.2, k, k + call_env.0)?
        }
        Ok(())
    })?
    match out {
        Committed(_) => Ok(()),
        _ => Error(MigrationFault)
    }
}

fn scrub_to_end(mut tour: Scrub, budget: u64, mut faults: List[Fault]) -> Result[u64, Error] waits {
    loop {
        let report = scrub_step(mut tour, budget)?
        for found in report.faults {
            list.push(mut faults, clone(found))
        }
        if let None = report.next {
            return Ok(report.checked)
        }
    }
}

fn scrub_fault_is(fault: Fault, seq: u64, offset: u64, why: Why) -> Result[bool, Error] {
    let path = failure_result_from_rep(manifest.paged_pack_path(seq))?
    let matched = match fault.why {
        Checksum => match why {
            Checksum => true,
            _ => false
        },
        Kind(found) => match why {
            Kind(wanted) => found == wanted,
            _ => false
        },
        Truncated => match why {
            Truncated => true,
            _ => false
        },
        _ => false
    }
    Ok(fault.file == path && fault.offset == offset && matched)
}

// A misdirected write (TigerBeetle's storage fault model, §11.17): pack A's
// first frame, meant for A at 72, lands at 72 in pack B. A's slot keeps its
// old sector, zeros for a new file, and B's slot holds A's sealed bytes. The
// oracle is the injected place: A at 72 reads kind 0, and B at 72 holds a
// well-formed head whose check binds A's sequence, not B's.
@test
fn disk_test_scrub_misdirected(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 2000, 0)?
    let _ = checkpoint(mut db)?
    // Control: the undamaged generation reads clean, and the tour reads every
    // byte of every listed pack, by the files' own sizes.
    let mut listed: List[u64] = list.new()
    let mut data: List[u64] = list.new()
    let mut cursor = std.omap.range(manifest.pack_locations(disk_state(db).packs).packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut cursor) {
        list.push(mut listed, seq)
        if pack.class == 0 {
            list.push(mut data, seq)
        }
    }
    let mut total = 0u64
    for seq in listed {
        total += list.len(failure_result_from_rep(manifest.disk_read_paged_file(path, failure_result_from_rep(manifest.paged_pack_path(seq))?, 67108864))?)
    }
    let mut clean: List[Fault] = list.new()
    let control = begin_scrub(mut db)?
    let mut tour = take control
    if scrub_to_end(mut tour, 4096, mut clean)? != total || list.len(clean) != 0 || list.len(data) < 4 {
        return Error(MigrationFault)
    }
    // A is the first data pack whose first frame fits inside B, the second.
    let a = data[0u64]
    let b = data[1u64]
    let a_name = failure_result_from_rep(manifest.paged_pack_path(a))?
    let b_name = failure_result_from_rep(manifest.paged_pack_path(b))?
    let mut a_raw = failure_result_from_rep(manifest.disk_read_paged_file(path, a_name, 67108864))?
    let mut b_raw = failure_result_from_rep(manifest.disk_read_paged_file(path, b_name, 67108864))?
    let old_stamp = format.read_le(a_raw, 96, 8)
    let width = 16 + format.read_le(a_raw, 76, 4)
    if 72 + width > list.len(b_raw) {
        return Error(MigrationFault)
    }
    for at in 72u64 .. 72 + width {
        b_raw[at] = a_raw[at]
        a_raw[at] = 0u8
    }
    failure_result_from_rep(manifest.disk_write_synced(path, a_name, a_raw))?
    failure_result_from_rep(manifest.disk_write_synced(path, b_name, b_raw))?
    // A lost write over a leftover of the same pack number: C at 72 holds a
    // frame sealed for C at 72 whose last payload byte differs. The envelope
    // passes; only the generation's pointer to C at 72 tells the bytes apart.
    let c_seq = data[2u64]
    let c_name = failure_result_from_rep(manifest.paged_pack_path(c_seq))?
    let mut c_raw = failure_result_from_rep(manifest.disk_read_paged_file(path, c_name, 67108864))?
    let c_width = format.read_le(c_raw, 76, 4)
    c_raw[87 + c_width] = c_raw[87 + c_width] ^ 1u8
    let sealed = failure_result_from_rep(types.capacity(format.disk_check(format.DiskContext(store: store_key_to_rep(db.store), role: 3, seq: c_seq), 72, list.slice(c_raw, 72, 80), list.slice(c_raw, 88, 88 + c_width))))?
    list.set_word_le(mut c_raw, 80, sealed)
    failure_result_from_rep(manifest.disk_write_synced(path, c_name, c_raw))?
    // D's live frame is replaced by a same-width frame sealed for D at
    // this offset, but carrying the stamp of a different live frame.
    let d_seq = data[3u64]
    let d_name = failure_result_from_rep(manifest.paged_pack_path(d_seq))?
    let mut d_raw = failure_result_from_rep(manifest.disk_read_paged_file(path, d_name, 67108864))?
    let d_width = format.read_le(d_raw, 76, 4)
    if old_stamp == format.read_le(d_raw, 96, 8) {
        fail("the stale frame needs a different stamp")
    }
    list.set_word_le(mut d_raw, 96, old_stamp)
    let d_seal = failure_result_from_rep(types.capacity(format.disk_check(format.DiskContext(store: store_key_to_rep(db.store), role: 3, seq: d_seq), 72, list.slice(d_raw, 72, 80), list.slice(d_raw, 88, 88 + d_width))))?
    list.set_word_le(mut d_raw, 80, d_seal)
    failure_result_from_rep(manifest.disk_write_synced(path, d_name, d_raw))?
    let mut faults: List[Fault] = list.new()
    let damaged = begin_scrub(mut db)?
    let mut second = take damaged
    let _ = scrub_to_end(mut second, 1, mut faults)?
    if list.len(faults) < 3 || !scrub_fault_is(faults[0u64], a, 72, Kind(0))? || !scrub_fault_is(faults[1u64], b, 72, Checksum)? || !scrub_fault_is(faults[2u64], c_seq, 72, Checksum)? {
        return Error(MigrationFault)
    }
    if list.len(faults) != 4 || !scrub_fault_is(faults[3u64], d_seq, 72, Checksum)? {
        fail("scrub missed the sealed stale stamp at the live offset")
    }
    // Detection only: resident pages still answer.
    if get(result.unwrap(reader(db, 0u64)), snapshot(db), t, 1999)? != Some(1999u64) {
        return Error(MigrationFault)
    }
    trust_opt_out("scrub/misdirected", mut db)
    close(take db)
}

// Rewrites the stamp of row 0 in the first PACK_INDEX frame of a listed
// class-3 or class-4 pack and seals the frame again, so its envelope still
// verifies and only the row disagrees with the data frame it names.
fn scrub_restamp_index_row(dir: Dir, id: StoreId, seq: u64, index_at: u64) -> Result[String, Error] waits {
    let path = failure_result_from_rep(manifest.paged_pack_path(seq))?
    let mut raw = failure_result_from_rep(manifest.disk_read_paged_file(dir, path, 67108864))?
    let size = format.read_le(raw, index_at + 4, 4)
    let mut payload = failure_result_from_rep(types.copied(list.slice(raw, index_at + 16, index_at + 16 + size)))?
    // PACK_INDEX payload (§13.1): count u32, prev u64, then each row as
    // offset u64, len u32, kind u8, collection u32, stamp u64.
    let stamp = list.word_le(payload, 29)
    if stamp < 2 {
        fail("scrub PACK_INDEX: the first row's stamp leaves room for an older one")
    }
    list.set_word_le(mut payload, 29, stamp - 1)
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 3, seq: seq)
    let flags: u16 = int.truncate(format.read_le(raw, index_at + 2, 2))
    let sealed = failure_result_from_rep(types.capacity(format.disk_seal(ctx, index_at, manifest.PACK_INDEX_KIND, flags, payload)))?
    list.copy_from_slice(mut raw, index_at, sealed)
    failure_result_from_rep(manifest.disk_write_synced(dir, path, raw))?
    Ok(take path)
}

// §13.8 "What lazy open cannot see": a scrub tour checks a class-3 and a
// class-4 pack's PACK_INDEX against its frames. Each pack's index names one
// frame by an older stamp, in a frame whose own envelope verifies; the tour
// reports each pack once, and a tour before the damage reports nothing.
@test
fn disk_test_scrub_pack_index_names_its_frames(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let options = l96_tiered_options(182375272u64, 65536, 500)?
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    l96_put_bytes(mut db, rows, 0, l96_blob_value(1, 32))?
    l96_put_bytes(mut db, rows, 1, l96_blob_value(2, 2000))?
    set_residency(mut db, rows.id, Tiered)?
    let mut clean: List[Fault] = list.new()
    let mut before = begin_scrub(mut db)?
    let _ = scrub_to_end(mut before, 1048576, mut clean)?
    drop(take before)
    if list.len(clean) != 0 {
        fail("scrub PACK_INDEX: the undamaged Tiered packs are clean")
    }
    let mut damaged: List[String] = list.new()
    let mut classes: List[u8] = list.new()
    let mut listed = std.omap.range(manifest.pack_locations(disk_state(db).packs).packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut listed) {
        if pack.class >= 3 {
            list.push(mut damaged, scrub_restamp_index_row(path, db.store, seq, pack.index)?)
            list.push(mut classes, pack.class)
        }
    }
    if !list.contains(classes, 3u8) || !list.contains(classes, 4u8) {
        fail("scrub PACK_INDEX: the table seals a class-3 and a class-4 pack")
    }
    let mut faults: List[Fault] = list.new()
    let mut tour = begin_scrub(mut db)?
    let _ = scrub_to_end(mut tour, 1048576, mut faults)?
    drop(take tour)
    if list.len(faults) != list.len(damaged) {
        fail("scrub PACK_INDEX: each pack whose index misnames a frame is reported once")
    }
    for file in damaged {
        let mut named = false
        for found in faults {
            if found.file == file {
                named = true
            }
        }
        if !named {
            fail("scrub PACK_INDEX: the fault names the pack whose index misnames a frame")
        }
    }
    trust_opt_out("scrub/pack-index", mut db)
    close(take db)
}

@test
fn disk_test_scrub_damage_budget(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 2000, 0)?
    let _ = checkpoint(mut db)?
    let mut listed = std.omap.range(manifest.pack_locations(disk_state(db).packs).packs.values, Unbounded, Unbounded)
    let Some((first, _)) = std.omap.next(mut listed) else {
        return Error(MigrationFault)
    }
    let Some((second, _)) = std.omap.next(mut listed) else {
        return Error(MigrationFault)
    }
    let Some((third, _)) = std.omap.next(mut listed) else {
        return Error(MigrationFault)
    }
    let first_name = failure_result_from_rep(manifest.paged_pack_path(first))?
    let mut raw = failure_result_from_rep(manifest.disk_read_paged_file(path, first_name, 67108864))?
    // The 72-byte HEADER and the first frame's 16-byte envelope and payload.
    let budget = 72 + 16 + format.read_le(raw, 76, 4)
    raw[budget - 1] = raw[budget - 1] ^ 1u8
    failure_result_from_rep(manifest.disk_write_synced(path, first_name, raw))?
    let second_name = failure_result_from_rep(manifest.paged_pack_path(second))?
    let header = failure_result_from_rep(manifest.disk_read_paged_file(path, second_name, 67108864))?
    failure_result_from_rep(manifest.disk_write_synced(path, second_name, list.slice(header, 0, 7)))?
    let mut tour = begin_scrub(mut db)?
    let damaged = scrub_step(mut tour, budget)?
    if damaged.checked != budget || damaged.next != Some(second) || list.len(damaged.faults) != 1 || !scrub_fault_is(damaged.faults[0], first, 72, Checksum)? {
        fail("the damaged frame must spend the budget before the next pack")
    }
    let partial = scrub_step(mut tour, 7)?
    if partial.checked != budget + 7 || partial.next != Some(third) || list.len(partial.faults) != 1 || !scrub_fault_is(partial.faults[0], second, 0, Truncated)? {
        fail("the partial header must spend its seven bytes before the next pack")
    }
    drop(take tour)
    trust_opt_out("scrub/damage-budget", mut db)
    close(take db)
}

// §11.17's lease: a cut that retires every data pack while a tour holds them
// keeps the files; the tour reads them clean; after the tour ends, the next
// cut unlinks exactly the packs no longer listed.
@test
fn disk_test_scrub_lease(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 2000, 0)?
    let _ = checkpoint(mut db)?
    let started = begin_scrub(mut db)?
    let mut tour = take started
    let first = scrub_step(mut tour, 1)?
    if first.checked != 72 || list.len(first.faults) != 0 {
        return Error(MigrationFault)
    }
    // Every row changes, so every data page is rewritten and its old pack's
    // live bytes reach zero.
    scrub_fill(mut db, t, 2000, 1)?
    let _ = checkpoint(mut db)?
    let mut retired = 0u64
    for seq in tour.lease.packs {
        if !failure_result_from_rep(journal.disk_exists(path, failure_result_from_rep(manifest.paged_pack_path(seq))?))? {
            return Error(MigrationFault)
        }
    }
    // The cut carries each retirement the lease holds back.
    for seq in manifest.pack_carried(disk_state(db).packs) {
        if manifest.scrub_leased(manifest.pack_scrubs(disk_state(db).packs), seq) {
            retired += 1
        }
    }
    let mut faults: List[Fault] = list.new()
    let _ = scrub_to_end(mut tour, 4096, mut faults)?
    if retired == 0 || list.len(faults) != 0 {
        return Error(MigrationFault)
    }
    let leased: List[u64] = clone(tour.lease.packs)
    drop(take tour)
    let _ = checkpoint(mut db)?
    let mut gone = 0u64
    for seq in leased {
        let present = failure_result_from_rep(journal.disk_exists(path, failure_result_from_rep(manifest.paged_pack_path(seq))?))?
        let listed = match manifest.disk_index_get(manifest.pack_locations(disk_state(db).packs).packs, seq) {
            Some(_) => true,
            None => false
        }
        if present != listed {
            return Error(MigrationFault)
        }
        if !present {
            gone += 1
        }
    }
    if gone == 0 {
        return Error(MigrationFault)
    }
    close(take db)
}

// The head's driver (RUNNER-SPEC §12.5) runs a tour one slice at a time
// between commits and cuts. Nothing here damages a byte, so the oracle is no
// fault at all: frames appended to a listed pack after the tour began, and
// packs a cut retires under the lease, read clean to the tour's end.
@test
fn disk_test_scrub_interleaved(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 500, 0)?
    let _ = checkpoint(mut db)?
    let mut tour = begin_scrub(mut db)?
    let mut steps = 0u64
    loop {
        let report = scrub_step(mut tour, 256)?
        if list.len(report.faults) != 0 {
            fail("§11.17: a tour between commits and cuts found a fault")
        }
        if let None = report.next {
            break
        }
        steps += 1
        if steps > 100000 {
            fail("§11.17: the tour never ended")
        }
        scrub_fill(mut db, t, 50 + steps % 450, steps)?
        if steps % 4 == 0 {
            let _ = checkpoint(mut db)?
        }
    }
    if steps == 0 {
        fail("the fixture's tour fit one slice")
    }
    drop(take tour)
    let _ = checkpoint(mut db)?
    let mut again = begin_scrub(mut db)?
    let mut faults: List[Fault] = list.new()
    let _ = scrub_to_end(mut again, 4096, mut faults)?
    if list.len(faults) != 0 {
        fail("§11.17: the store after the tour has a fault")
    }
    drop(take again)
    close(take db)
}

type CheckDamage: key = PinPointer | KeyedPointer | LineageEnvelope | RepeatedStamp | SuffixChecksum | ForkKeyedMeta

fn check_test_dir(d: Dir) -> Dir waits {
    let mut label = string.with_capacity(64)
    string.push(mut label, "check-")
    result.unwrap(host.mkdtemp(d, mut label))
}

fn check_test_pack(d: Dir, id: StoreId, seq: u64, image: std.page.Image, stale: bool) -> Result[std.page.PagePtr, Error] waits {
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 3, seq: seq)
    let mut raw = failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?
    let mut ptr = capture_test_page(mut raw, ctx, image)?
    if stale {
        // The bytes on disk have a valid envelope. Only the pointer disagrees.
        ptr.checksum = ptr.checksum ^ 1u64
    }
    failure_result_from_rep(manifest.disk_write_synced(d, failure_result_from_rep(manifest.paged_pack_path(seq))?, raw))?
    Ok(ptr)
}

fn check_test_stamp(stamp: u64) -> Result[std.page.Image, Error] {
    let mut rows: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut rows, std.page.Entry(key: types.key_word(1), cell: InlineValue(b"x")))
    failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, stamp, Unprefixed)))
}

fn check_test_inventory(d: Dir, id: StoreId, second: bool, width: u64) -> Result[std.page.PagePtr, Error] waits {
    let mut rows: List[std.page.Entry] = list.with_capacity(2)
    let packed = manifest.encode_pack_row(pages.PagePack(foreign: None, class: 0, frames: 1, live: width, payload_bytes: width, index: 0))
    list.push(mut rows, std.page.Entry(key: types.key_word(1), cell: InlineValue(clone(packed))))
    if second {
        list.push(mut rows, std.page.Entry(key: types.key_word(2), cell: InlineValue(take packed)))
    }
    let image = failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, 2, Unprefixed)))?
    check_test_pack(d, id, 3, image, false)
}

fn check_test_packs(d: Dir, id: StoreId, mut m: manifest.PageManifest, damage: CheckDamage) -> Result[(String, u64, Why), Error] waits {
    let image = check_test_stamp(1)?
    let first = check_test_pack(d, id, 1, image, damage == PinPointer || damage == KeyedPointer)?
    m.next_stamp = 3
    m.next_pack = 4
    m.pack_root = check_test_inventory(d, id, damage == RepeatedStamp, int.widen(first.len))?
    if damage == KeyedPointer || damage == ForkKeyedMeta {
        let zero = std.page.unlocated(0)
        let mut keyed_roots: List[std.page.PagePtr] = list.with_capacity(7)
        list.push(mut keyed_roots, first)
        list.fill(mut keyed_roots, 6, zero)
        m.branches[0].roots.keyed = take keyed_roots
        return Ok(("p-1", 72u64, Checksum))
    }
    let held = if damage == RepeatedStamp {
        m.branches[0].roots.catalog = first
        check_test_pack(d, id, 2, image, false)?
    } else {
        first
    }
    let roots = pages.LocatedRoots(collections: std.page.unlocated(0), streams: std.page.unlocated(0), catalog: held, keyed: list.new())
    list.push(mut m.pins, manifest.LocatedPin(owner: ApplicationPin, name: "held", branch: 0, version: 0, roots: take roots, watermark: 3))
    if damage == RepeatedStamp {
        Ok(("p-2", 72u64, Malformed))
    } else {
        Ok(("p-1", 72u64, Checksum))
    }
}

fn check_test_lineage(d: Dir, id: StoreId, mut m: manifest.PageManifest) -> Result[u64, Error] waits {
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 3, seq: 1)
    let mut raw = failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?
    let edge = manifest.lineage_row(ForkRow(manifest.LineageFork(child: 1, parent: 0, watermark: 1, adopted: true)))
    let mut rows: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut rows, std.page.Entry(key: clone(edge.key), cell: InlineValue(clone(edge.value))))
    let image = failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, 1, Unprefixed)))?
    m.lineage = capture_test_page(mut raw, ctx, image)?
    let at = list.len(raw)
    let _ = capture_test_page(mut raw, ctx, check_test_stamp(2)?)?
    raw[at + 8] = raw[at + 8] ^ 1u8
    failure_result_from_rep(manifest.disk_write_synced(d, "p-1", raw))?
    m.next_pack = 2
    m.next_stamp = 3
    m.next_branch = 2
    Ok(at)
}

fn check_test_end(d: Dir, id: StoreId, end: u64) -> Result[(), Error] waits {
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 4, seq: 1)
    let mut raw = failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?
    let mut payload: Bytes = list.with_capacity(8)
    list.put_word_le(mut payload, end)
    list.append(mut raw, failure_result_from_rep(types.capacity(format.disk_seal(ctx, 72, 0x0012, 1, payload)))?)
    failure_result_from_rep(manifest.disk_write_synced(d, "j-1.end", raw))
}

fn check_test_damage(d: Dir, c: Clock, damage: CheckDamage) -> Result[(), Error] waits {
    let id = StoreId(hi: 7, lo: 3013)
    let mut m = manifest.page_manifest_empty(limits_to_rep(default_limits()))
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 2, seq: 1)
    let mut journal = failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?
    let (path, at, reason) = match damage {
        LineageEnvelope => ("p-1", check_test_lineage(d, id, mut m)?, Checksum),
        SuffixChecksum => {
            list.append(mut journal, capture_test_commit(ctx, 72, 1, 16, 0)?)
            let suffix_at = list.len(journal)
            list.append(mut journal, capture_test_commit(ctx, suffix_at, 2, 16, 0)?)
            journal[suffix_at + 8] = journal[suffix_at + 8] ^ 1u8
            check_test_end(d, id, list.len(journal))?
            ("j-1", suffix_at, Checksum)
        },
        ForkKeyedMeta => {
            let _ = check_test_packs(d, id, mut m, damage)?
            m.limits.meta = 4096 - 147
            capture_test_meta_ceiling(mut m)?
            m.limits.meta = 4096
            let payload = fork_test_payload(int.widen(m.next_branch), "fork")
            list.append(mut journal, failure_result_from_rep(types.capacity(format.disk_seal(ctx, 72, 0x0013, 1, payload)))?)
            ("j-1", 72u64, Malformed)
        },
        _ => check_test_packs(d, id, mut m, damage)?,
    }
    failure_result_from_rep(manifest.disk_write_synced(d, "LOCK", b""))?
    failure_result_from_rep(manifest.disk_write_synced(d, "MANIFEST", failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), m))?))?
    failure_result_from_rep(manifest.disk_write_synced(d, "j-1", journal))?
    let empty: List[Fault] = list.new()
    let observed: core.Cell[List[Fault]] = cell.new(take empty)
    let on_fault: scoped[view] fn(Fault) -> Result[(), Error] waits = scoped fn(found: Fault) -> Result[(), Error] {
        let retained: Fault = clone(found)
        cell.with(observed, take retained, fn(mut faults: List[Fault], take one: Fault) -> () {
            list.push(mut faults, take one)
        })
        Ok(())
    }
    match prepare(d, c, Check) {
        Ok(take prepared) => {
            let checked = check_capture(take prepared, on_fault) ?=> |_| MigrationFault
            if checked.faults != 1 {
                return Error(MigrationFault)
            }
        },
        Error(Corrupt(take fault)) => on_fault(fault)?,
        Error(take problem) => return Error(take problem),
    }
    let faults = cell.into_inner(take observed)
    if list.len(faults) != 1 || faults[0].file != path || faults[0].offset != at {
        return Error(MigrationFault)
    }
    match (faults[0].why, reason) {
        (Checksum, Checksum) => Ok(()),
        (Malformed, Malformed) => Ok(()),
        _ => Error(MigrationFault),
    }
}

@test
fn check_detects(d: Dir, c: Clock) -> Result[(), Error] waits {
    for damage in[PinPointer, KeyedPointer, LineageEnvelope, RepeatedStamp, SuffixChecksum, ForkKeyedMeta] {
        check_test_damage(check_test_dir(d), c, damage)?
    }
    Ok(())
}

/// bug: the pacer adds the header and frame envelopes to Tiered pack lengths twice.
/// oracle: the leased pack files' sizes, with a one-second target and bounds on either side of their sum.
@test
fn disk_test_scrub_paced_mixed_pack_bytes(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut db = open(tasks, path, c, r, l96_tiered_options(182375272u64, 65536, 500)?)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    l96_put_bytes(mut db, rows, 0, l96_blob_value(1, 32))?
    l96_put_bytes(mut db, rows, 1, l96_blob_value(2, 2000))?
    set_residency(mut db, rows.id, Tiered)?
    let tour = begin_scrub(mut db)?
    let mut total = 0u64
    let mut classes: List[u8] = list.new()
    for pack in tour.packs {
        let name = failure_result_from_rep(manifest.paged_pack_path(pack.seq))?
        total += failure_result_from_rep(manifest.disk_io(host.stat(path, name)))?.size
        list.push(mut classes, pack.class)
    }
    if !list.contains(classes, 0u8) || !list.contains(classes, 3u8) || !list.contains(classes, 4u8) {
        fail("paced scrub needs Memory pages and Tiered pages and blobs")
    }
    // At a one-second target the unclamped rate equals the sealed byte count.
    for (min_rate, max_rate, expected_rate) in[(1u64, 2 * total, total), (total + 1, 2 * total, total + 1), (1u64, total - 1, total - 1)] {
        let config = ScrubConfig(target_ms: 1000u64, max_rate_bps: max_rate, slice_bytes: 1u64, min_rate_bps: min_rate)
        let mut pacer = begin_scrub_pacer(db, config, 0u64)?
        let step = scrub_pacer_step(mut pacer, mut db, 0u64)?
        let status = step.status
        if !step.stepped || !status.active || status.generation != Some(tour.generation) || list.len(step.faults) != 0 {
            fail("paced scrub must start a clean slice of the leased generation")
        }
        if status.estimated_bytes != total || status.rate_bps != expected_rate {
            let mut msg = string.with_capacity(128)
            string.push(mut msg, "paced scrub expected bytes/rate ")
            string.push_u64(mut msg, total)
            string.push(mut msg, "/")
            string.push_u64(mut msg, expected_rate)
            string.push(mut msg, ", got ")
            string.push_u64(mut msg, status.estimated_bytes)
            string.push(mut msg, "/")
            string.push_u64(mut msg, status.rate_bps)
            fail(take msg)
        }
    }
    drop(take tour)
    close(take db)
}

// CLOUD #5 + T13: paced Directory scrub with completion target, actual byte
// debit, overdue signal, lease release on stop, and persisted SCRUB round
// history surfaced by `describe_capture`.
@test
fn disk_test_scrub_paced_and_history(d: Dir, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let (time, take clock_hand) = provide.clock(0, 1000u64)
    let mut wall = take clock_hand
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, time, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 1200, 0)?
    let _ = checkpoint(mut db)?
    // Independent oracle: sum of actual on-disk bytes of all listed packs.
    let mut total_bytes = 0u64
    let mut first_data_pack = 0u64
    let mut cursor = std.omap.range(manifest.pack_locations(disk_state(db).packs).packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut cursor) {
        total_bytes += list.len(failure_result_from_rep(manifest.disk_read_paged_file(path, failure_result_from_rep(manifest.paged_pack_path(seq))?, 67108864))?)
        if pack.class == 0 && first_data_pack == 0 {
            first_data_pack = seq
        }
    }
    if total_bytes < 4096 || first_data_pack == 0 {
        fail("paced scrub fixture needs multiple packs")
    }
    // 1. Infeasible target: rate clamped to max_rate_bps (4000 B/s), target 100 ms.
    let infeasible = ScrubConfig(target_ms: 100u64, max_rate_bps: 4000u64, slice_bytes: 512u64, min_rate_bps: 1000u64)
    let mut slow = begin_scrub_pacer(db, infeasible, 1000u64)?
    let step1 = scrub_pacer_step(mut slow, mut db, 1000u64)?
    if !step1.stepped || step1.completed != None || !step1.status.active || step1.status.rate_bps != 4000u64 {
        fail("infeasible pacer must start active and clamp to max_rate_bps")
    }
    let expected_debit = manifest.ceil_millis_ratio(step1.status.checked, 4000u64)
    if step1.status.next_due_ms != 1000u64 + expected_debit {
        fail("actual byte debit must drive next_due_ms")
    }
    // Stepping before next_due_ms does no work.
    if expected_debit > 1u64 {
        let early = scrub_pacer_step(mut slow, mut db, 1000u64 + expected_debit - 1u64)?
        if early.stepped {
            fail("pacer must not step before next_due_ms")
        }
    }
    // Past target_ms with no clean tour: overdue must be true, last_clean_ms None.
    let overdue_status = scrub_pacer_status(slow, 1200u64)
    if !overdue_status.overdue || overdue_status.last_clean_ms != None || overdue_status.clean_age_ms != None {
        fail("infeasible target past target_ms must report overdue with no clean timestamp")
    }
    // 2. Interrupting the tour drops the lease and persists an incomplete round
    // without advancing last_clean_ms.
    let mut leased_packs: List[u64] = list.new()
    let mut c2 = std.omap.range(manifest.pack_locations(disk_state(db).packs).packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut c2) {
        if pack.class == 0 {
            list.push(mut leased_packs, seq)
        }
    }
    scrub_fill(mut db, t, 1200, 1)?
    let _ = checkpoint(mut db)?
    for seq in leased_packs {
        if !failure_result_from_rep(journal.disk_exists(path, failure_result_from_rep(manifest.paged_pack_path(seq))?))? {
            fail("active pacer tour must hold its ScrubLease across cuts")
        }
    }
    let Some(interrupted) = scrub_pacer_stop(mut slow, db, 1250u64)? else {
        fail("stopping an active pacer must record an incomplete round")
    }
    if interrupted.complete || interrupted.examined != step1.status.checked {
        fail("interrupted round must record complete=false and actual examined bytes")
    }
    let _ = checkpoint(mut db)?
    let mut unlinked = 0u64
    for seq in leased_packs {
        if !failure_result_from_rep(journal.disk_exists(path, failure_result_from_rep(manifest.paged_pack_path(seq))?))? {
            unlinked += 1
        }
    }
    if unlinked == 0 {
        fail("stopping the pacer must release its ScrubLease")
    }
    let Some(hist_after_stop) = scrub_history(db)? else {
        fail("SCRUB history must exist after interrupted round")
    }
    if hist_after_stop.last_clean_ms != None || last_complete_scrub_round(hist_after_stop) != None {
        fail("interrupted round must never refresh last_clean_ms or last_complete_scrub_round")
    }
    // Recompute current on-disk pack bytes after the checkpoint above.
    let mut live_total = 0u64
    let mut live_data_pack = 0u64
    let mut c3 = std.omap.range(manifest.pack_locations(disk_state(db).packs).packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut c3) {
        live_total += list.len(failure_result_from_rep(manifest.disk_read_paged_file(path, failure_result_from_rep(manifest.paged_pack_path(seq))?, 67108864))?)
        if pack.class == 0 && live_data_pack == 0 {
            live_data_pack = seq
        }
    }
    // 3. Feasible target: finishes within target_ms under max_rate_bps, updates
    // last_clean_ms, persists round, and surfaces in describe_capture.
    let feasible = ScrubConfig(target_ms: 10000u64, max_rate_bps: 100000u64, slice_bytes: 1024u64, min_rate_bps: 10000u64)
    let mut now = 2000u64
    clock.set_wall(mut wall, now)
    let mut pacer = begin_scrub_pacer(db, feasible, now)?
    let mut done_round: Option[ScrubRound] = None
    let mut guard = 0u64
    while let None = done_round {
        guard += 1
        if guard > 10000u64 {
            fail("feasible paced tour did not finish")
        }
        let res = scrub_pacer_step(mut pacer, mut db, now)?
        if let Some(round) = res.completed {
            done_round = Some(round)
        } else {
            now = res.status.next_due_ms
            clock.set_wall(mut wall, now)
        }
    }
    let Some(clean_round) = done_round else {
        fail("expected completed clean round")
    }
    if !clean_round.complete || clean_round.faults != 0u64 || clean_round.examined != live_total || clean_round.ended_ms - clean_round.started_ms > feasible.target_ms {
        fail("feasible tour must complete clean within target_ms and match actual pack bytes")
    }
    let clean_status = scrub_pacer_status(pacer, now)
    if clean_status.active || clean_status.overdue || clean_status.last_clean_ms != Some(now) || clean_status.clean_age_ms != Some(0u64) || clean_status.tours_completed != 1u64 {
        fail("clean completion must advance last_clean_ms and clear overdue")
    }
    // Verify Describe emits the persisted clean round.
    let prepared = prepare(path, time, Describe)?
    let seen_round: core.Cell[Option[ScrubRound]] = cell.new(None)
    let _ = describe_capture(take prepared, scoped fn(fact: DescribeLine) -> Result[(), Error] {
        if let DescribeScrubRound(r_line) = fact {
            cell.with(seen_round, r_line, fn(mut slot: Option[ScrubRound], take found: ScrubRound) {
                slot = Some(found)
            })
        }
        Ok(())
    })?
    if cell.into_inner(take seen_round) != Some(clean_round) {
        fail("Describe must emit the persisted last complete scrub round")
    }
    // 4. Faulty tour: corrupt a listed pack, run a full tour to completion,
    // verify faults > 0, and verify last_clean_ms is NOT refreshed.
    let bad_name = failure_result_from_rep(manifest.paged_pack_path(live_data_pack))?
    let mut bad_raw = failure_result_from_rep(manifest.disk_read_paged_file(path, bad_name, 67108864))?
    bad_raw[80] = bad_raw[80] ^ 1u8
    failure_result_from_rep(manifest.disk_write_synced(path, bad_name, bad_raw))?
    now = clean_status.next_due_ms
    clock.set_wall(mut wall, now)
    let mut bad_done: Option[ScrubRound] = None
    let mut saw_damage = false
    guard = 0u64
    while let None = bad_done {
        guard += 1
        if guard > 10000u64 {
            fail("faulty paced tour did not finish")
        }
        let res = scrub_pacer_step(mut pacer, mut db, now)?
        for fault in res.faults {
            if scrub_fault_is(fault, live_data_pack, 72, Checksum)? {
                saw_damage = true
            }
        }
        if let Some(round) = res.completed {
            bad_done = Some(round)
        } else {
            now = res.status.next_due_ms
            clock.set_wall(mut wall, now)
        }
    }
    let Some(faulty_round) = bad_done else {
        fail("expected completed faulty round")
    }
    if !faulty_round.complete || faulty_round.faults == 0u64 || !saw_damage {
        fail("faulty tour must report the corrupted pack frame")
    }
    trust_opt_out("scrub/paced-history", mut db)
    let after_fault = scrub_pacer_status(pacer, now)
    if after_fault.last_clean_ms != Some(clean_round.ended_ms) {
        fail("faulty tour must never refresh last_clean_ms")
    }
    let Some(final_hist) = scrub_history(db)? else {
        fail("SCRUB history missing after faulty round")
    }
    if final_hist.last_clean_ms != Some(clean_round.ended_ms) || final_hist.last_clean_round != Some(clean_round) {
        fail("persisted SCRUB history must preserve last_clean_ms across faulty rounds")
    }
    if last_complete_scrub_round(final_hist) != Some(faulty_round) {
        fail("last_complete_scrub_round must report the latest completed round")
    }
    close(take db)
}

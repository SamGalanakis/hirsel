pub type TieredIndexRequest: send {
    pack: u64,
    offset: u64,
    listed: pages.TieredPagerPack,
    deadline: u64
}

pub fn checked_tiered_index(path: String, owner: types.StoreKey, pack_seq: u64, at: u64, width: u64, wire: Bytes) -> Result[u64, types.Failure] {
    let head = manifest.disk_read_frame_head(path, list.slice(wire, 0, 16), at)?
    if head.kind != manifest.PACK_INDEX_KIND || head.flags != 1 || head.size > width - 16 {
        return Error(format.disk_fault(path, at, Malformed))
    }
    let end = 16 + head.size
    let context = format.DiskContext(store: owner, role: 3, seq: pack_seq)
    if types.capacity(format.disk_check(context, at, list.slice(wire, 0, 16), list.slice(wire, 16, end)))? != head.checksum {
        return Error(format.disk_fault(path, at, Checksum))
    }
    Ok(end)
}

fn pin_tiered_index(cut: TieredPageSource, pack: u64, offset: u64, listed: pages.TieredPagerPack) -> Result[Arc[Bytes], types.Failure] waits {
    let request = TieredIndexRequest(pack: pack, offset: offset, listed: clone(listed), deadline: cut.deadline)
    let (answer, delivered) = manifest.disk_allocation(fn() -> Result[(Sender[Result[Arc[Bytes], types.Failure]], Receiver[Result[Arc[Bytes], types.Failure]]), types.Failure] {
        Ok(channel.new(1))
    })?
    let Some(requests) = view cut.pager else {
        return Error(Io(Closed))
    }
    channel.send(requests, PagerIndex(take request, take answer)) ?=> |_| Io(Closed)
    channel.receive(delivered) ?=> |_| Io(Closed)
}

// The cursor retains positions and the front-coded predecessor key. A cut
// brings its own visitor and installs the advanced cursor only on publication.
// A visitor that returns false stops the probe before that row: the cursor
// stays where it was, so a later cut decides the row again.
pub type TieredProbeCursor: send {
    index_at: u64,
    previous_index: u64,
    inside: Option[manifest.PackIndexCursor],
    next_data: u64,
    rows: u64
}

pub fn start_tiered_probe(pack: pages.PagePack) -> TieredProbeCursor {
    TieredProbeCursor(index_at: pack.index, previous_index: 0, inside: None, next_data: 72, rows: 0)
}

pub fn probe_tiered_index[S](cut: TieredPageSource, seq: u64, mut cursor: TieredProbeCursor, budget: u64, mut state: S, visit: scoped fn(mut S, manifest.PackIndexRow) -> Result[bool, types.Failure] waits) -> Result[bool, types.Failure] waits {
    let path = manifest.paged_pack_path(seq)?
    let Some(listed) = std.omap.get(cut.packs, seq) else {
        return Error(format.disk_fault(path, cursor.index_at, Absent))
    }
    let pack = listed.inventory
    let mut work = 0u64
    while work < budget && cursor.index_at < pack.payload_bytes {
        let at = cursor.index_at
        let raw = pin_tiered_index(cut, seq, at, listed)?
        let payload = list.slice(raw, 16, list.len(raw))
        let mut inside = match replace(mut cursor.inside, None) {
            Some(take saved) => take saved,
            None => {
                let (prev, take first) = manifest.start_pack_index(path, at, payload, 0)?
                if prev != cursor.previous_index {
                    return Error(format.disk_fault(path, at, Order))
                }
                take first
            },
        }
        while work < budget {
            let before: manifest.PackIndexCursor = clone(inside)
            let Some(take row) = manifest.next_pack_index(path, at, payload, mut inside)? else {
                break
            }
            let width: u64 = int.widen(row.len)
            let expected_kind = if pack.class == 3 {
                0x21u8
            } else {
                0x22u8
            }
            if row.kind != expected_kind || row.offset != cursor.next_data || row.stamp >= cut.next_stamp || row.offset >= pack.index || 16 + width > pack.index - row.offset || cursor.rows >= int.widen(pack.frames) {
                return Error(format.disk_fault(path, at, Malformed))
            }
            let _ = probe_routing_key(seq, row)?
            if !visit(mut state, row)? {
                cursor.inside = Some(take before)
                return Ok(false)
            }
            cursor.next_data += 16 + width
            cursor.rows += 1
            work += 1
        }
        if inside.remaining != 0 {
            cursor.inside = Some(take inside)
            return Ok(false)
        }
        cursor.previous_index = at
        cursor.index_at += list.len(raw)
    }
    if cursor.index_at == pack.payload_bytes {
        if cursor.next_data != pack.index || cursor.rows != int.widen(pack.frames) {
            return Error(format.disk_fault(path, cursor.index_at, Malformed))
        }
        return Ok(true)
    }
    Ok(false)
}

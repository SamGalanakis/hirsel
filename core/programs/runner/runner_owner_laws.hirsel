// §3 "Repair", the owner's take: an owner that takes Update 1 also takes the Updates queued
// behind it, in order, up to its inbox's capacity (1+q = 5) in one delivery job. The first
// other event ends the run and is held, not lost, and every take counts once toward the
// drain wake. Hand-derived: with the run at 3 of 5, taking Updates 2 and 3 and then `Dropped`
// is three takes, so the run wraps once (one wake) and ends at 1; Update 4 stays queued. A
// full backlog takes four more Updates and leaves the fifth queued.
pub fn law_owner_takes_queued() -> bool {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    let _ = channel.try_send(to, queued_update(2u64))
    let _ = channel.try_send(to, queued_update(3u64))
    let _ = channel.try_send(to, wire_event(Dropped))
    let _ = channel.try_send(to, queued_update(4u64))
    let mut updates: List[Update] = list.new()
    list.push(mut updates, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut held: Option[WireEvent] = None
    let mut run = 3u64
    let wakes = wire_take_queued(inbox, mut run, 5u64, mut updates, mut held)
    let held_sent = match take held { Some(WireEvent(e: Dropped)) => true, _ => false }
    let left = match channel.try_receive(inbox) { Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 4u64, _ => false }
    let mixed = wakes == 1u64 && run == 1u64 && held_sent && left && queued_versions(updates, 3u64)

    for v in 2u64 .. 7u64 { let _ = channel.try_send(to, queued_update(v)) }
    let mut full: List[Update] = list.new()
    list.push(mut full, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut kept: Option[WireEvent] = None
    let mut at = 0u64
    let _ = wire_take_queued(inbox, mut at, 5u64, mut full, mut kept)
    let rest = match channel.try_receive(inbox) { Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 6u64, _ => false }
    let capped = at == 4u64 && rest && (match kept { None => true, _ => false }) && queued_versions(full, 5u64)
    mixed && capped
}

pub fn law_owner_take_wakes() -> bool {
    let mut run = 0u64
    let mut wakes = 0u64
    for _ in 0u64 .. 129u64 { if wire_taken(mut run, 64u64) { wakes += 1u64 } }
    wakes == 2u64 && run == 1u64
}

// No wire configuration, for unit drivers whose registry fixes `G` and binds nothing.
fn no_wire[G: send]() -> Option[Wire[G, ()]] { None }

fn wire_service_seed[G: send, B: send](random: Random, take session_wire: Option[Wire[G, B]], head: Sender[HeadInput], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, B]] {
    wire_service_with_head(random, take session_wire, LifecycleHead(channel.sender(head)), clock, tasks, config, take target)
}

pub fn fixture_unsubscribe(owner: FixtureOwner, sub: u32) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Unsubscribed(owner.who, sub)))
}

pub fn fixture_try_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    if let Ok(take d) = channel.try_receive(owner.from) { return Ok(take d) }
    match channel.try_receive(owner.inbox) {
        Ok(take e) => { fixture_content(owner, take e); channel.try_receive(owner.from) },
        Error(e) => Error(e),
    }
}

@test
fn leaving_sub_does_not_block_successor(clock: Clock, random: Random, tasks: Tasks) -> Result[(), u64] waits {
    let (head_to, _head_from): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let (pub_to, pub_from): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    result.unwrap(channel.try_send(pub_to, PubIn(e: Drained)))
    let mut config = wire_defaults(1048576u64)
    config.max_subs = 1u64
    let service: Service[WireSession[(), ()]] = wire_service_seed(random, no_wire(), head_to, clock, tasks, config, string.new())
    let Service(context: take initial, ..) = take service
    let mut ctx = take initial
    ctx.phase = 3u8
    ctx.publisher = Some(take pub_to)
    ctx.joined = Some(23u64)
    ctx.next_sub = 8u64
    ctx.sub_generation = 1u64
    ctx.caller = Some(law_caller(1u64))
    list.push(mut ctx.subs, (7u32, 1u64))
    list.push(mut ctx.pub_subs, 7u32)
    let mut work = wire_work()
    work.check = Some(10u64)
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Unsubscribe(7u32), 0u64)))
    if !list.contains(ctx.pub_subs, 7u32) { return Error(1u64) }
    let reg = result.unwrap(placed(code.describe(http_law_place), HTTP_LAW_PLACE_BYTES))
    list.push(mut ctx.entries, http_law_key(reg.exported[1u64]))
    list.push(mut ctx.known, 1u8)
    let next = result.unwrap(wire_plan_subscribe(mut ctx, reg, 8u32, 0u32, b"\x00\x00\x00\x00", None))
    if let PlannedSubscribe(..) = next {} else { return Error(2u64) }
    result.unwrap(wire_apply_plan(mut ctx, mut work, take next))
    let excess = result.unwrap(wire_plan_subscribe(mut ctx, reg, 9u32, 0u32, b"\x00\x00\x00\x00", None))
    if let SubscriptionRefusal(9u32, Refused(NotAllowed)) = excess {} else { return Error(3u64) }
    // The first successor owns the outgoing sub's slot. It occupies no PubIn
    // cell until the writer finishes and the old read set can be removed.
    if list.len(ctx.deferred_subs) != 1u64 || ctx.deferred_subs[0u64].sub != 8u32 { return Error(4u64) }
    if !list.contains(ctx.pub_subs, 7u32) || list.contains(ctx.pub_subs, 8u32) { return Error(5u64) }
    let receiver = task.spawn(tasks, bytes 4096u64, take pub_from, owner_receive_successor)
    let _ = result.unwrap(wire_step(mut ctx, mut work, WSent))
    wire_flush_subscriptions(mut ctx, mut work)
    let (take remaining, exact) = result.unwrap(task.join(take receiver))
    if !exact || list.len(ctx.deferred_subs) != 0u64 || !list.contains(ctx.pub_subs, 8u32) { return Error(6u64) }
    if let Error(1002u16) = wire_plan_subscribe(mut ctx, reg, 8u32, 0u32, b"", None) {} else { return Error(8u64) }
    if let Error(1002u16) = wire_step(mut ctx, mut work, WClient(Set(8u32, None), 0u64)) {} else { return Error(9u64) }
    if let Error(1002u16) = wire_step(mut ctx, mut work, WClient(Send(10u32, None, b""), 0u64)) {} else { return Error(10u64) }
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Set(7u32, None), 0u64)))
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Send(6u32, None, b""), 0u64)))

    // With an idle writer there will be no Sent to push a lost unsubscribe.
    result.unwrap(channel.try_send(wire_publisher(ctx), PubIn(e: Drained)))
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Unsubscribe(8u32), 0u64)))
    let idle = task.spawn(tasks, bytes 4096u64, take remaining, owner_receive_idle_unsubscribe)
    wire_flush_subscriptions(mut ctx, mut work)
    if !result.unwrap(task.join(take idle)) || list.len(ctx.pub_subs) != 0u64 { return Error(7u64) }
    Ok(())
}

fn owner_receive_successor(take from: Receiver[PubIn]) -> (Receiver[PubIn], bool) waits {
    let first = match channel.receive(from) { Ok(PubIn(e: Drained)) => true, _ => false }
    let retired = match channel.receive(from) { Ok(PubIn(e: Unsubscribed(23u64, 7u32))) => true, _ => false }
    let successor = match channel.receive(from) { Ok(PubIn(e: WireSubscribed(23u64, 8u32, 2u64, _))) => true, _ => false }
    (take from, first && retired && successor)
}

fn owner_receive_idle_unsubscribe(take from: Receiver[PubIn]) -> bool waits {
    let first = match channel.receive(from) { Ok(PubIn(e: Drained)) => true, _ => false }
    let retired = match channel.receive(from) { Ok(PubIn(e: Unsubscribed(23u64, 8u32))) => true, _ => false }
    first && retired
}

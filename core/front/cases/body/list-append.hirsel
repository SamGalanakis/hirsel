// Capacity max(2+4,4,0)=6. In rejected, b"abcd" owns capacity 4, charged 8 of the bound's
// 17; growth to max(4+32, 2*4) = 36 requests round8(36) = 40, with 9 available.
// expect: accept
// expect: run appended() = 606
// expect: run unchanged() = 0
// expect: run rejected() = 4009 used 32
fn append[T: plain](mut xs: List[T], ys: List[T]) {
    list.append(mut xs, ys)
}

fn appended() -> u64 {
    let mut xs = b"ab"
    let ys = b"cdef"
    append(mut xs, ys)
    let a: u64 = int.widen(xs[0])
    let z: u64 = int.widen(xs[5])
    if a == 97 && z == 102 {
        list.len(xs) * 100 + list.capacity(xs)
    } else {
        0
    }
}

fn unchanged() -> u64 {
    let mut xs: List[u8] = list.new()
    let ys = b""
    append(mut xs, ys)
    list.capacity(xs)
}

fn rejected() -> u64 {
    let r = isolate(fn() -> Result[u64, Capacity] {
        let ys = b"01234567890123456789012345678901"
        bound bytes 17 {
            let mut xs = b"abcd"
            append(mut xs, ys)
            999u64
        }
    })
    match caught(take r) {
        Some(e) => e.requested * 100 + e.available,
        None => 0
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

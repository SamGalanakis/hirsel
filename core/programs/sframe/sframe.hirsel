// RFC 9605 SFrame for AES_128_GCM_SHA256_128 (docs/spec/sframe.md).
pub type Suite = Aes128GcmSha256_128()

pub fn suite_id(s: Suite) -> u16 {
    match s {
        Aes128GcmSha256_128() => 4,
    }
}

pub type Header {
    kid: u64,
    ctr: u64
}

pub type HeaderError = Short | Malformed

pub type Ratchet {
    generation: u64,
    bits: u8,
    step: u64
}

pub type Scheme = Fixed(u64) | Ratcheted(Ratchet)

pub type Follow {
    generation: u64,
    bits: u8,
    step: u64,
    at: u64,
    forward: u8,
    keep: u8,
    floor: u64
}

pub type Limits {
    frame: u64,
    window: u64,
    keys: u64,
    ranges: u64,
    jump: u64
}

pub fn limits() -> Limits {
    Limits(frame: 4194304, window: 128, keys: 16, ranges: 256, jump: 0)
}

pub type SframeError = Invalid | Framing | Unreserved | Exhausted | Keys | Schedule(schedule.ScheduleError) | Capacity(Capacity)

pub type Discard: key = Malformed | Replayed | TooOld | TooFar | Tampered

pub type OpenError = NoKey(u64) | Discarded(Discard) | Capacity(Capacity)

pub type Sealed {
    kid: u64,
    ctr: u64,
    len: u64
}

pub type Opened {
    kid: u64,
    ctr: u64,
    len: u64
}

pub type Mark {
    ctr: u64,
    volume: u64
}

const CTR_LIMIT: u64 = 0xffffffffffffffff

const VOLUME_LIMIT: u64 = 1 << 34

const TAG: u64 = 16

// ---------------------------------------------------------------- header (SFRAME-3)
fn w8(x: u8) -> u64 {
    int.widen(x)
}

fn value_len(x: u64) -> u64 {
    if x < 8 {
        return 0
    }
    let mut n: u64 = 1
    while n < 8 && (x >> (8 * n)) != 0 {
        n += 1
    }
    n
}

pub fn header_len(h: Header) -> u64 {
    1 + value_len(h.kid) + value_len(h.ctr)
}

fn spare(out: Bytes) -> u64 {
    list.capacity(out) - list.len(out)
}

fn short_of(out: Bytes, n: u64) -> Result[(), Capacity] {
    let room = spare(out)
    if room < n {
        return Error(Capacity(requested: n, available: room))
    }
    Ok(())
}

fn put_value(mut out: Bytes, x: u64, n: u64) {
    let mut i = n
    while i > 0 {
        i -= 1
        let b: u8 = int.truncate(x >> (8 * i))
        list.push(mut out, b)
    }
}

pub fn encode_header(h: Header, mut out: Bytes) -> Result[u64, Capacity] {
    let k = value_len(h.kid)
    let c = value_len(h.ctr)
    short_of(out, 1 + k + c)?
    let high: u64 = if k == 0 {
        h.kid
    } else {
        8 | (k - 1)
    }
    let low: u64 = if c == 0 {
        h.ctr
    } else {
        8 | (c - 1)
    }
    let config: u8 = int.narrow((high << 4) | low)
    list.push(mut out, config)
    put_value(mut out, h.kid, k)
    put_value(mut out, h.ctr, c)
    Ok(1 + k + c)
}

fn read_value(b: Bytes, at: u64, n: u64) -> Result[u64, HeaderError] {
    if b[at] == 0 {
        return Error(Malformed)
    }
    let mut x: u64 = 0
    for i in 0u64 .. n {
        x = (x << 8) | w8(b[at + i])
    }
    if x < 8 {
        return Error(Malformed)
    }
    Ok(x)
}

pub fn decode_header(b: Bytes, at: u64) -> Result[(Header, u64), HeaderError] {
    let end = list.len(b)
    if at >= end {
        return Error(Short)
    }
    let config: u64 = w8(b[at])
    let k: u64 = if config & 128 != 0 {
        ((config >> 4) & 7) + 1
    } else {
        0
    }
    let c: u64 = if config & 8 != 0 {
        (config & 7) + 1
    } else {
        0
    }
    if end - at < 1 + k + c {
        return Error(Short)
    }
    let id = if k == 0 {
        (config >> 4) & 7
    } else {
        read_value(b, at + 1, k)?
    }
    let ctr = if c == 0 {
        config & 7
    } else {
        read_value(b, at + 1 + k, c)?
    }
    Ok((Header(kid: id, ctr), 1 + k + c))
}

// ---------------------------------------------------------------- key schedule (SFRAME-4, SFRAME-14)
fn inline_bytes(x: Inline[u8, 32], n: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(n)
    let _ = bytebuf.append_inline(mut out, x, 0, n)
    take out
}

fn extract(base: Bytes) -> Bytes {
    inline_bytes(std.hmac.sha256(b"", base), 32)
}

// HKDF-Expand for one block: the first n (at most 32) bytes of HMAC(prk, info || 01).
fn expand(prk: Bytes, info: Bytes, n: u64) -> Bytes {
    let mut h = std.hmac.start(prk)
    std.hmac.add(mut h, info, 0, list.len(info))
    std.hmac.add_byte(mut h, 1)
    inline_bytes(std.hmac.finish(h), n)
}

/// The next step's base key, for a party that hands sender keys out as bytes (SFRAME-14).
/// Keys are derived only inside TLS-8 schedules; this is never a route for a granted key.
pub fn ratchet_key(base: Bytes) -> Bytes {
    expand(extract(base), b"SFrame 1.0 Ratchet", 32)
}

type Slot {
    opener: packet.Opener,
    floor: u64,
    window: std.replay.Window
}

fn check_limits(l: Limits) -> Result[(), SframeError] {
    if l.frame < 1 || l.frame > (1 << 30) || l.window < 64 || l.window > 4096 || l.keys < 1 || l.keys > 256 || l.ranges > 1024 || (l.jump != 0 && l.jump < l.window) {
        return Error(Invalid)
    }
    Ok(())
}

// The most steps one call moves a schedule from the step of its imported bytes (TLS-8).
const MAX_STEPS: u64 = 65536

fn distance(at: u64, step: u64) -> Result[u64, SframeError] {
    if at > step || step - at > MAX_STEPS {
        return Error(Invalid)
    }
    Ok(step - at)
}

// A ratchet at the distance of an opener just issued; TLS-8 makes it infallible.
fn commit_ratchet(mut keys: schedule.Schedule, steps: u64) {
    match schedule.sframe_ratchet(mut keys, steps) {
        Ok(()) => {},
        Error(_) => fail("sframe: the schedule refused a ratchet after issuing its opener"),
    }
}

fn blocks(n: u64) -> u64 {
    (n + 15) / 16
}

// ---------------------------------------------------------------- sender (SFRAME-5, SFRAME-8, SFRAME-14)
pub opaque type Sender {
    suite: Suite,
    framing: ranges.Framing,
    limits: Limits,
    ratcheted: bool,
    generation: u64,
    bits: u8,
    step: u64,
    kid: u64,
    keys: schedule.Schedule,
    sealer: packet.Sealer,
    next: u64,
    volume: u64,
    ceiling: Mark
}

fn ratchet_kid(generation: u64, bits: u8, step: u64) -> u64 {
    let b: u64 = w8(bits)
    (generation << b) | (step & ((1 << b) - 1))
}

fn check_generation(generation: u64, bits: u8) -> Result[(), SframeError] {
    if bits < 1 || bits > 16 {
        return Error(Invalid)
    }
    let b: u64 = w8(bits)
    if generation >> (64 - b) != 0 {
        return Error(Invalid)
    }
    Ok(())
}

// A scheme's ratchet state and KID, and how far its schedule moves from the imported step.
type Start {
    ratcheted: bool,
    generation: u64,
    bits: u8,
    step: u64,
    kid: u64,
    ahead: u64
}

fn opening(scheme: Scheme, at: u64, l: Limits) -> Result[Start, SframeError] {
    check_limits(l)?
    match scheme {
        Fixed(k) => Ok(Start(ratcheted: false, generation: 0, bits: 0, step: 0, kid: k, ahead: distance(at, 0)?)),
        Ratcheted(r) => {
            check_generation(r.generation, r.bits)?
            Ok(Start(ratcheted: true, generation: r.generation, bits: r.bits, step: r.step, kid: ratchet_kid(r.generation, r.bits, r.step), ahead: distance(at, r.step)?))
        },
    }
}

pub fn sender(suite: Suite, framing: ranges.Framing, scheme: Scheme, take keys: schedule.Schedule, at: u64, from: Mark, l: Limits) -> Result[Sender, (SframeError, schedule.Schedule)] {
    let st = match opening(scheme, at, l) {
        Ok(x) => x,
        Error(e) => return Error((e, take keys)),
    }
    let mut owned = take keys
    let issued = schedule.sframe_sealer(mut owned, st.ahead, st.kid, from.ctr)
    let sealer = match take issued {
        Ok(take x) => take x,
        Error(e) => return Error((Schedule(e), take owned)),
    }
    Ok(Sender(suite, framing, limits: l, ratcheted: st.ratcheted, generation: st.generation, bits: st.bits, step: st.step, kid: st.kid, keys: take owned, sealer: take sealer, next: from.ctr, volume: from.volume, ceiling: from))
}

pub fn current_kid(s: Sender) -> u64 {
    s.kid
}

pub fn next_ctr(s: Sender) -> u64 {
    s.next
}

pub fn reserve(mut s: Sender, frames: u64, volume: u64) -> Result[Mark, SframeError] {
    if s.next >= CTR_LIMIT || s.volume >= VOLUME_LIMIT {
        return Error(Exhausted)
    }
    let ctr = int.saturating_add(s.next, frames)
    let units = int.saturating_add(s.volume, volume)
    let top_ctr = if ctr > CTR_LIMIT {
        CTR_LIMIT
    } else {
        ctr
    }
    let top_volume = if units > VOLUME_LIMIT {
        VOLUME_LIMIT
    } else {
        units
    }
    if top_ctr > s.ceiling.ctr {
        s.ceiling.ctr = top_ctr
    }
    if top_volume > s.ceiling.volume {
        s.ceiling.volume = top_volume
    }
    Ok(s.ceiling)
}

// One `sframe_sealer(keys, 1, ..)`: a refusal leaves the sender sealing under its old step.
pub fn ratchet(mut s: Sender) -> Result[(), SframeError] {
    if !s.ratcheted {
        return Error(Invalid)
    }
    if s.step == CTR_LIMIT {
        return Error(Exhausted)
    }
    let id = ratchet_kid(s.generation, s.bits, s.step + 1)
    let issued = schedule.sframe_sealer(mut s.keys, 1, id, 0)
    s.sealer = match take issued {
        Ok(take x) => take x,
        Error(e) => return Error(Schedule(e)),
    }
    s.step += 1
    s.kid = id
    s.next = 0
    s.volume = 0
    s.ceiling = Mark(ctr: 0, volume: 0)
    Ok(())
}

// The refusals every seal makes before any work, in SFRAME-5's order after Framing and Invalid.
fn admit(s: Sender, cost: u64) -> Result[(), SframeError] {
    if s.next >= CTR_LIMIT || s.volume >= VOLUME_LIMIT || cost > VOLUME_LIMIT - s.volume {
        return Error(Exhausted)
    }
    if s.next >= s.ceiling.ctr || s.volume + cost > s.ceiling.volume {
        return Error(Unreserved)
    }
    Ok(())
}

fn spend(mut s: Sender, cost: u64) {
    s.next += 1
    s.volume += cost
}

fn is_rfc(f: ranges.Framing) -> bool {
    match f {
        Rfc => true,
        Ranged(_) => false,
    }
}

// Seals `src` onto `dst`, authenticating dst[aad_at..] and `extra`. A Capacity refusal changes
// nothing; Reused, Range and TooLong are ruled out by the library's own checks.
fn seal_frame(mut s: Sender, ctr: u64, src: Bytes, mut dst: Bytes, aad_at: u64, extra: Bytes) -> Result[(), SframeError] {
    match packet.seal_into(mut s.sealer, ctr, src, 0, mut dst, aad_at, extra) {
        Ok(_) => Ok(()),
        Error(Capacity(c)) => Error(Capacity(c)),
        Error(_) => fail("sframe: the sealer refused a frame the library admitted"),
    }
}

pub fn seal(mut s: Sender, metadata: Bytes, plain: Bytes, mut out: Bytes) -> Result[Sealed, SframeError] {
    if !is_rfc(s.framing) {
        return Error(Framing)
    }
    if list.len(plain) > s.limits.frame {
        return Error(Invalid)
    }
    let h = Header(kid: s.kid, ctr: s.next)
    let hlen = header_len(h)
    let cost = 1 + blocks(list.len(plain)) + blocks(hlen + list.len(metadata))
    admit(s, cost)?
    short_of(out, hlen + list.len(plain) + TAG) ?=> |c| Capacity(c)
    let start = list.len(out)
    let _ = encode_header(h, mut out) ?=> |c| Capacity(c)
    match seal_frame(mut s, h.ctr, plain, mut out, start, metadata) {
        Ok(()) => {},
        Error(e) => {
            list.truncate(mut out, start)
            return Error(e)
        },
    }
    spend(mut s, cost)
    Ok(Sealed(kid: h.kid, ctr: h.ctr, len: list.len(out) - start))
}

// ---------------------------------------------------------------- replay window (SFRAME-7)
fn window(size: u64) -> Result[std.replay.Window, Capacity] {
    match std.replay.window(size) {
        Ok(take w) => Ok(take w),
        Error(Capacity(c)) => Error(c),
        Error(ZeroWidth) => fail("sframe: replay width was validated"),
    }
}

fn check_window(slot: Slot, jump: u64, ctr: u64) -> Result[(), Discard] {
    if ctr < slot.floor {
        return Error(TooOld)
    }
    // Before the first frame the floor is the anchor of the jump bound.
    let anchor = match std.replay.top(slot.window) {
        Some(top) => top,
        None => slot.floor,
    }
    if jump != 0 && ctr > anchor && ctr - anchor > jump {
        return Error(TooFar)
    }
    match std.replay.seen(slot.window, ctr) {
        Fresh => Ok(()),
        Duplicate => Error(Replayed),
        TooOld => Error(TooOld),
    }
}

// ---------------------------------------------------------------- receiver (SFRAME-6, SFRAME-8, SFRAME-14)
type Generation {
    first: u64,
    bits: u8,
    forward: u8,
    keep: u8,
    step: u64,
    keys: schedule.Schedule
}

// A generation's last forward candidate, `d` steps past its current step, kept until a commit,
// an advance or its removal so forged frames at one distance issue it once.
type Pending {
    d: u64,
    opener: packet.Opener
}

type Claim {
    first: u64,
    bits: u8
}

pub opaque type Receiver {
    suite: Suite,
    framing: ranges.Framing,
    limits: Limits,
    slots: Map[u64, Slot],
    generations: Map[u64, Generation],
    pending: Map[u64, Pending],
    claims: List[Claim],
    used: u64
}

pub fn receiver(suite: Suite, framing: ranges.Framing, l: Limits) -> Result[Receiver, SframeError] {
    check_limits(l)?
    Ok(Receiver(suite, framing, limits: l, slots: map.new(), generations: map.new(), pending: map.new(), claims: list.new(), used: 0))
}

fn claimed(r: Receiver, id: u64) -> Option[Claim] {
    for c in r.claims {
        let b: u64 = w8(c.bits)
        if id >> b == c.first >> b {
            return Some(c)
        }
    }
    None
}

fn new_slot(keys: schedule.Schedule, ahead: u64, id: u64, size: u64, floor: u64) -> Result[Slot, SframeError] {
    let opener = schedule.sframe_opener(keys, ahead, id) ?=> |take e| Schedule(e)
    let w = window(size) ?=> |c| Capacity(c)
    Ok(Slot(opener: take opener, floor, window: take w))
}

fn put_slot(mut r: Receiver, id: u64, take slot: Slot) -> Result[(), SframeError] {
    map.try_reserve(mut r.slots, 1) ?=> |c| Capacity(c)
    map.insert(mut r.slots, id, take slot)
    Ok(())
}

pub fn install(mut r: Receiver, id: u64, keys: schedule.Schedule, floor: u64) -> Result[(), SframeError] {
    if let Some(_) = map.get(r.slots, id) {
        return Error(Invalid)
    }
    if let Some(_) = claimed(r, id) {
        return Error(Invalid)
    }
    if r.used + 1 > r.limits.keys {
        return Error(Keys)
    }
    let slot = new_slot(keys, 0, id, r.limits.window, floor)?
    put_slot(mut r, id, take slot)?
    r.used += 1
    Ok(())
}

// A member holding a shared group key as `send,<own kid>,0` opens the other members' KIDs with it.
pub fn install_from(mut r: Receiver, id: u64, s: Sender, floor: u64) -> Result[(), SframeError] {
    install(mut r, id, s.keys, floor)
}

// The library's checks for a new generation; the distance its schedule moves from `f.at`.
fn follow_check(r: Receiver, f: Follow) -> Result[u64, SframeError] {
    check_generation(f.generation, f.bits)?
    let span: u64 = 1 << w8(f.bits)
    let forward: u64 = w8(f.forward)
    let keep: u64 = w8(f.keep)
    if forward < 1 || forward > 16 || keep < forward || keep > 16 || keep + 1 + forward > span {
        return Error(Invalid)
    }
    let ahead = distance(f.at, f.step)?
    let first = f.generation << w8(f.bits)
    for c in r.claims {
        let b: u64 = if c.bits > f.bits {
            w8(c.bits)
        } else {
            w8(f.bits)
        }
        if c.first >> b == first >> b {
            return Error(Invalid)
        }
    }
    // A fixed key inside the claimed range: refuse. The table is small, so probe the claim.
    if span <= 65536 {
        for low in 0u64 .. span {
            if let Some(_) = map.get(r.slots, first | low) {
                return Error(Invalid)
            }
        }
    }
    if r.used + keep + 1 > r.limits.keys {
        return Error(Keys)
    }
    Ok(ahead)
}

fn room_for_generation(mut r: Receiver) -> Result[(), Capacity] {
    list.try_reserve(mut r.claims, 1)?
    map.try_reserve(mut r.generations, 1)?
    map.try_reserve(mut r.slots, 1)?
    map.try_reserve(mut r.pending, 1)?
    Ok(())
}

pub fn install_ratcheted(mut r: Receiver, f: Follow, take keys: schedule.Schedule) -> Result[(), (SframeError, schedule.Schedule)] {
    let ahead = match follow_check(r, f) {
        Ok(a) => a,
        Error(e) => return Error((e, take keys)),
    }
    let id = ratchet_kid(f.generation, f.bits, f.step)
    let made = new_slot(keys, ahead, id, r.limits.window, f.floor)
    let slot = match take made {
        Ok(take x) => take x,
        Error(e) => return Error((e, take keys)),
    }
    match room_for_generation(mut r) {
        Ok(()) => {},
        Error(c) => return Error((Capacity(c), take keys)),
    }
    let mut owned = take keys
    if ahead != 0 {
        commit_ratchet(mut owned, ahead)
    }
    let first = f.generation << w8(f.bits)
    map.insert(mut r.slots, id, take slot)
    list.push(mut r.claims, Claim(first, bits: f.bits))
    map.insert(mut r.generations, first, Generation(first, bits: f.bits, forward: f.forward, keep: f.keep, step: f.step, keys: take owned))
    r.used += w8(f.keep) + 1
    Ok(())
}

// Release the held steps of a generation outside [low, high].
fn release_steps(mut r: Receiver, first: u64, bits: u8, old_low: u64, old_high: u64, low: u64, high: u64) {
    let mut step = old_low
    while step <= old_high {
        if step < low || step > high {
            let _ = map.remove(mut r.slots, ratchet_kid(first >> w8(bits), bits, step))
        }
        if step == CTR_LIMIT {
            return
        }
        step += 1
    }
}

fn held_low(step: u64, keep: u8) -> u64 {
    let k: u64 = w8(keep)
    if step >= k {
        step - k
    } else {
        0
    }
}

// The generation `advance` moves: its first KID, current step and `keep`, and the new schedule's distance.
type Advance {
    first: u64,
    current: u64,
    keep: u8,
    ahead: u64
}

fn advance_check(r: Receiver, bits: u8, generation: u64, step: u64, at: u64) -> Result[Advance, SframeError] {
    check_generation(generation, bits)?
    let first = generation << w8(bits)
    let (current, keep) = match map.get(r.generations, first) {
        Some(g) => if g.bits == bits {
            (g.step, g.keep)
        } else {
            return Error(Invalid)
        },
        None => return Error(Invalid),
    }
    if step <= current {
        return Error(Invalid)
    }
    let ahead = distance(at, step)?
    Ok(Advance(first, current, keep, ahead))
}

pub fn advance(mut r: Receiver, bits: u8, generation: u64, step: u64, take keys: schedule.Schedule, at: u64, floor: u64) -> Result[(), (SframeError, schedule.Schedule)] {
    let a = match advance_check(r, bits, generation, step, at) {
        Ok(x) => x,
        Error(e) => return Error((e, take keys)),
    }
    let id = ratchet_kid(generation, bits, step)
    let made = new_slot(keys, a.ahead, id, r.limits.window, floor)
    let slot = match take made {
        Ok(take x) => take x,
        Error(e) => return Error((e, take keys)),
    }
    match map.try_reserve(mut r.slots, 1) {
        Ok(()) => {},
        Error(c) => return Error((Capacity(c), take keys)),
    }
    let mut owned = take keys
    if a.ahead != 0 {
        commit_ratchet(mut owned, a.ahead)
    }
    release_steps(mut r, a.first, bits, held_low(a.current, a.keep), a.current, held_low(step, a.keep), step - 1)
    let _ = map.remove(mut r.pending, a.first)
    map.insert(mut r.slots, id, take slot)
    let Some(take old) = map.remove(mut r.generations, a.first) else {
        fail("sframe: a checked generation is gone")
    }
    let Generation(first: _, bits: _, forward, keep, step: _, keys: _) = take old
    map.insert(mut r.generations, a.first, Generation(first: a.first, bits, forward, keep, step, keys: take owned))
    Ok(())
}

pub fn remove(mut r: Receiver, id: u64) -> bool {
    if let Some(_) = claimed(r, id) {
        return false
    }
    match map.remove(mut r.slots, id) {
        Some(_) => {
            r.used -= 1
            true
        },
        None => false,
    }
}

pub fn remove_generation(mut r: Receiver, bits: u8, generation: u64) -> bool {
    if bits < 1 || bits > 16 || generation >> (64 - w8(bits)) != 0 {
        return false
    }
    let first = generation << w8(bits)
    let (step, keep) = match map.get(r.generations, first) {
        Some(g) => if g.bits == bits {
            (g.step, g.keep)
        } else {
            return false
        },
        None => return false,
    }
    let _ = map.remove(mut r.generations, first)
    let _ = map.remove(mut r.pending, first)
    release_steps(mut r, first, bits, held_low(step, keep), step, 1, 0)
    let mut kept: List[Claim] = list.new()
    for c in r.claims {
        if c.first != first {
            list.push(mut kept, c)
        }
    }
    r.claims = take kept
    r.used -= w8(keep) + 1
    true
}

// Where a frame's key comes from: a held slot, or a forward candidate d steps past the current one.
type Found = Held | Candidate(first: u64, d: u64)

fn locate(r: Receiver, id: u64) -> Result[Found, OpenError] {
    if let Some(_) = map.get(r.slots, id) {
        return Ok(Held)
    }
    let Some(c) = claimed(r, id) else {
        return Error(NoKey(id))
    }
    let Some(g) = map.get(r.generations, c.first) else {
        return Error(NoKey(id))
    }
    let b: u64 = w8(g.bits)
    let span: u64 = 1 << b
    let low = id & (span - 1)
    let d = (low + span - (g.step & (span - 1))) & (span - 1)
    if d >= 1 && d <= w8(g.forward) && g.step <= CTR_LIMIT - d {
        return Ok(Candidate(first: c.first, d))
    }
    Error(NoKey(id))
}

fn opened(e: packet.PacketError) -> OpenError {
    match e {
        Tampered => Discarded(Tampered),
        Capacity(c) => Capacity(c),
        _ => fail("sframe: the opener refused a frame the library checked"),
    }
}

fn issue_refused(e: schedule.ScheduleError) -> OpenError {
    match e {
        Capacity(c) => Capacity(c),
        _ => Discarded(Tampered),
    }
}

// The generation's candidate for `d`: the kept one, or a new one that replaces it.
fn candidate(mut r: Receiver, first: u64, d: u64, id: u64) -> Result[(), OpenError] {
    if let Some(p) = map.get(r.pending, first) {
        if p.d == d {
            return Ok(())
        }
    }
    let _ = map.remove(mut r.pending, first)
    map.try_reserve(mut r.pending, 1) ?=> |c| Capacity(c)
    let opener = {
        let g = option.unwrap(map.get(r.generations, first))
        schedule.sframe_opener(g.keys, d, id) ?=> |take e| issue_refused(e)
    }
    map.insert(mut r.pending, first, Pending(d, opener: take opener))
    Ok(())
}

// The openers a commit to `d` steps on retains, `max(1, d - keep) <= j < d`, all or nothing:
// on a refusal the ones issued are removed again and the receiver is as it was.
fn intermediates(mut r: Receiver, first: u64, d: u64) -> Result[(), OpenError] {
    let (generation, bits, step, keep) = {
        let g = option.unwrap(map.get(r.generations, first))
        (first >> w8(g.bits), g.bits, g.step, w8(g.keep))
    }
    let low = if d > keep {
        d - keep
    } else {
        1
    }
    map.try_reserve(mut r.slots, d - low + 1) ?=> |c| Capacity(c)
    let mut j = low
    while j < d {
        let id = ratchet_kid(generation, bits, step + j)
        let made = {
            let g = option.unwrap(map.get(r.generations, first))
            new_slot(g.keys, j, id, r.limits.window, 0)
        }
        match take made {
            Ok(take slot) => map.insert(mut r.slots, id, take slot),
            Error(e) => {
                let mut i = low
                while i < j {
                    let _ = map.remove(mut r.slots, ratchet_kid(generation, bits, step + i))
                    i += 1
                }
                return Error(match e {
                    Capacity(c) => Capacity(c),
                    Schedule(s) => issue_refused(s),
                    _ => Discarded(Tampered),
                })
            },
        }
        j += 1
    }
    Ok(())
}

// After the candidate authenticated and its intermediates are held: move the schedule `d` steps,
// release the steps the new window drops, and make the candidate the step's opener.
fn commit(mut r: Receiver, first: u64, d: u64, id: u64, take w: std.replay.Window) {
    let (bits, step, keep) = {
        let g = option.unwrap(map.get(r.generations, first))
        (g.bits, g.step, g.keep)
    }
    let to = step + d
    release_steps(mut r, first, bits, held_low(step, keep), step, held_low(to, keep), to - 1)
    let _ = map.update(mut r.generations, first, scoped fn(mut g: Generation) -> () {
        commit_ratchet(mut g.keys, d)
        g.step = to
    })
    let Some(take p) = map.remove(mut r.pending, first) else {
        fail("sframe: a committed candidate is gone")
    }
    let Pending(d: _, opener: take opener) = take p
    map.insert(mut r.slots, id, Slot(opener: take opener, floor: 0, window: take w))
}

// The authenticated open shared by both framings: the window, capacity, AEAD and commit steps of
// SFRAME-6. `src[aad_at..at]` and `extra` are the AAD, `src[at..]` the ciphertext and tag.
fn open_core(mut r: Receiver, h: Header, src: Bytes, aad_at: u64, at: u64, extra: Bytes, room: u64, mut plain: Bytes) -> Result[(), OpenError] {
    let found = locate(r, h.kid)?
    let size = r.limits.window
    let jump = r.limits.jump
    let need = list.len(src) - at - TAG
    match found {
        Held => {
            {
                let slot = option.unwrap(map.get(r.slots, h.kid))
                check_window(slot, jump, h.ctr) ?=> |d| Discarded(d)
            }
            if room < need {
                return Error(Capacity(Capacity(requested: need, available: room)))
            }
            list.try_reserve(mut plain, need) ?=> |c| Capacity(c)
            {
                let slot = option.unwrap(map.get(r.slots, h.kid))
                let _ = packet.open_into(slot.opener, 0, h.ctr, src, aad_at, at, extra, mut plain) ?=> |take e| opened(e)
            }
            let _ = map.update(mut r.slots, h.kid, scoped fn(mut slot: Slot) -> () {
                let _ = std.replay.mark(mut slot.window, h.ctr)
            })
            Ok(())
        },
        Candidate(first, d) => {
            if room < need {
                return Error(Capacity(Capacity(requested: need, available: room)))
            }
            list.try_reserve(mut plain, need) ?=> |c| Capacity(c)
            // A new step's window is empty with floor 0: only the jump bound applies.
            if jump != 0 && h.ctr > jump {
                return Error(Discarded(TooFar))
            }
            candidate(mut r, first, d, h.kid)?
            let before = list.len(plain)
            {
                let p = option.unwrap(map.get(r.pending, first))
                let _ = packet.open_into(p.opener, 0, h.ctr, src, aad_at, at, extra, mut plain) ?=> |take e| opened(e)
            }
            let mut w = match window(size) {
                Ok(take x) => take x,
                Error(c) => {
                    list.truncate(mut plain, before)
                    return Error(Capacity(c))
                },
            }
            match intermediates(mut r, first, d) {
                Ok(()) => {},
                Error(e) => {
                    list.truncate(mut plain, before)
                    return Error(e)
                },
            }
            let _ = std.replay.mark(mut w, h.ctr)
            commit(mut r, first, d, h.kid, take w)
            Ok(())
        },
    }
}

pub fn open(mut r: Receiver, metadata: Bytes, frame: Bytes, mut out: Bytes) -> Result[Opened, OpenError] {
    if !is_rfc(r.framing) {
        return Error(Discarded(Malformed))
    }
    let n = list.len(frame)
    if n > r.limits.frame + 17 + TAG {
        return Error(Discarded(Malformed))
    }
    let (h, hlen) = decode_header(frame, 0) ?=> |_| Discarded(Malformed)
    if n - hlen < TAG {
        return Error(Discarded(Malformed))
    }
    let start = list.len(out)
    let room = spare(out)
    open_core(mut r, h, frame, 0, hlen, metadata, room, mut out)?
    Ok(Opened(kid: h.kid, ctr: h.ctr, len: list.len(out) - start))
}

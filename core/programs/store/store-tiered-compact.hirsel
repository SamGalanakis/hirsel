// §13.6 compaction on the log@1 cut (§13.6a T3, T8 steps 6 and 7).
// A pack whose `live` falls below `compact_permille` of its payload gets a
// compaction probe. Each cut walks up to `probe_budget` PACK_INDEX rows
// against the roots the cut publishes, and moves every match at that cut: the
// matched frame and the path above it become Hot copies with their own stamps
// (R6), so T2 emits each once into a fresh pack and every root that matched
// takes the one new location. The cut whose cursor reaches the end of the
// index retires the pack. Cursors are writer memory: a crash loses them and
// the next cut restarts the probe (§13.6 "Progress").
//
// Queue rows are their own roots (§13.6): a frame a `deferred_frees` row
// reaches moves like any match, the row's copy is emitted outside every root,
// and the row takes the new location (T8 step 3).
//
// Not built yet: recount probes (`repair_cuts`); moving deadlist cells with their frames, so a cell on a retiring pack is
// deleted with it and its holder's later kill is not filed (an over-count).
// AP16's redo keeps this cut's staged moves, queue rewrites included
// (§13.6a T8, v2.114); only a refused compaction step drops them.
type TieredCompaction: send {
    probes: Map[u64, TieredProbeCursor],
    // One share of each generation's read inventory. A Snapshot reads its
    // Cold slots through the inventory of the generation it was taken at, so
    // Remove defers a retired Tiered pack while a share other than this one
    // lists it (§13.5: on log@1 a lease defers Remove). Each cut drops the
    // shares nothing else holds.
    held: List[Arc[TieredReadInventory]]
}

fn no_tiered_compaction() -> TieredCompaction {
    TieredCompaction(probes: map.new(), held: list.new())
}

fn prune_tiered_leases(mut held: List[Arc[TieredReadInventory]]) {
    let mut slot = 0u64
    while slot < list.len(held) {
        let ended = match arc.with_unique(mut held[slot], fn(mut _inventory: TieredReadInventory) {}) {
            Some(_) => true,
            None => false
        }
        if ended {
            let _ = list.swap_remove(mut held, slot)
        } else {
            slot += 1
        }
    }
}

fn tiered_leased(held: List[Arc[TieredReadInventory]], seq: u64) -> bool {
    for inventory in held {
        if let Some(_) = std.omap.get(inventory.packs, seq) {
            return true
        }
    }
    false
}

// The participants' current inventories join the leases, once per generation.
fn lease_cut_inventories(installed: TieredCompaction, roots: List[Roots]) -> Result[List[Arc[TieredReadInventory]], Error] {
    let mut held: List[Arc[TieredReadInventory]] = clone(installed.held)
    for participant in roots {
        if let Some(inventory) = view participant.collections.paging {
            let mut known = false
            for leased in held {
                if leased.generation == inventory.generation {
                    known = true
                }
            }
            if !known {
                failure_result_from_rep(types.capacity(list.try_reserve(mut held, 1)))?
                list.push(mut held, arc.share(inventory))
            }
        }
    }
    Ok(take held)
}

// A queue row's value once this cut moved it: the copied page with its moved
// path, or the copied BLOB with the reference it had.
type TieredQueueValue: send = MovedQueuePage(std.page.Slot) | MovedQueueBlob(std.page.BlobRef, Arc[Bytes])

// A queue row this cut's compaction moved. T2 emits its copy under the
// collection, and a BLOB under the logical key, of the index row it matched.
type TieredQueueMove: send {
    branch_id: u32,
    collection: u32,
    key: Bytes,
    value: TieredQueueValue
}

type TieredCompactWork {
    roots: List[Roots],
    next_stamp: u64,
    // (pack, len) of each Cold ancestor a move re-emitted, once per stamp.
    moved: List[(u64, u64)],
    moved_stamps: Map[u64, ()],
    // The queue rows moved so far, by sequence: the installed rows' own and
    // the added rows' at `deferred_next` onward. A later index row descends
    // from the moved value.
    queue: Map[u64, TieredQueueMove]
}

type TieredCompactStep {
    probes: Map[u64, TieredProbeCursor],
    retiring: List[u64],
    moved: List[(u64, u64)],
    queue: Map[u64, TieredQueueMove]
}

fn compact_load(source: TieredPageSource, edge: std.page.Slot) -> Result[Arc[std.page.Page], Error] waits {
    match edge {
        ColdPage(ptr) => {
            let frame = fold_frame_at(source, TieredPage(ptr))?
            disk_allocation(scoped fn() -> Result[Arc[std.page.Page], Error] {
                Ok(std.page.copy_with_stamp(fold_page(frame), ptr.stamp))
            })
        },
        HotPage(page) => Ok(arc.share(page)),
    }
}

// The page with its stamp, one child or one BLOB replaced. Every other slot
// keeps its location.
fn compact_rebuild(page: Arc[std.page.Page], at: u64, child: Option[std.page.Slot], body: Option[std.page.BlobSlot]) -> Result[std.page.Slot, Error] {
    let image = std.page.image_of(page)
    disk_allocation(scoped fn() -> Result[std.page.Slot, Error] {
        let mut rows: List[std.page.Entry] = list.new()
        let mut kids: List[std.page.Slot] = list.new()
        let mut bodies: List[std.page.BlobSlot] = list.new()
        for slot in 0u64 .. std.page.count(image) {
            let mut row = option.unwrap(std.page.entry(image, slot))
            match row.cell {
                Child(mut edge) => {
                    let mut kept: std.page.Slot = clone(option.unwrap(std.page.child_slot(page, slot)))
                    if slot == at {
                        let Some(replacement) = view child else {
                            fail("store: compaction lost the moved child")
                        }
                        kept = clone(replacement)
                    }
                    edge.child = match kept {
                        ColdPage(ptr) => ptr,
                        HotPage(_) => std.page.unlocated(edge.child.stamp),
                    }
                    list.push(mut kids, take kept)
                },
                BlobValue(mut reference) => {
                    let mut kept: std.page.BlobSlot = clone(option.unwrap(std.page.blob_slot(page, reference.body)))
                    if slot == at {
                        let Some(replacement) = view body else {
                            fail("store: compaction lost the moved BLOB")
                        }
                        kept = clone(replacement)
                    }
                    reference = promotion_ref(reference, mut kept, int.truncate(list.len(bodies)))
                    list.push(mut bodies, take kept)
                },
                InlineValue(_) => (),
            }
            list.push(mut rows, take row)
        }
        let ready = page_result(std.page.encode(rows, std.page.level(image), std.page.stamp(image), std.page.key_domain(image)))?
        Ok(HotPage(page_result(std.page.attach(take ready, take kids, take bodies))?))
    })
}

fn compact_note_moved(mut work: TieredCompactWork, ptr: std.page.PagePtr) -> Result[(), Error] {
    if map.contains(work.moved_stamps, ptr.stamp) {
        return Ok(())
    }
    failure_result_from_rep(types.capacity(map.try_reserve(mut work.moved_stamps, 1)))?
    map.insert(mut work.moved_stamps, ptr.stamp, ())
    failure_result_from_rep(types.capacity(list.try_reserve(mut work.moved, 1)))?
    list.push(mut work.moved, (ptr.pack, int.widen(ptr.len)))
    Ok(())
}

// The path's copy from `depth` down. Each Cold ancestor's old copy is dead
// once every root that reached it takes the new path.
fn compact_relocate(source: TieredPageSource, edge: std.page.Slot, path: TieredProbePath, depth: u64, mut work: TieredCompactWork) -> Result[std.page.Slot, Error] waits {
    let page = compact_load(source, edge)?
    let path_end = list.len(path.slots)
    if depth == path_end {
        return Ok(HotPage(take page))
    }
    if let ColdPage(ptr) = view edge {
        compact_note_moved(mut work, ptr)?
    }
    let at = path.slots[depth]
    if depth + 1 == path_end {
        if let TieredBlob(ptr) = view path.target {
            let frame = fold_frame_at(source, TieredBlob(ptr))?
            let TieredValue(body) = view frame.payload else {
                fail("store: a BLOB reference resolved to a PAGE")
            }
            let moved_body = disk_allocation(scoped fn() -> Result[std.page.BlobSlot, Error] {
                Ok(HotBlob(arc.new(failure_result_from_rep(types.copied(body))?)))
            })?
            return compact_rebuild(page, at, None, Some(moved_body))
        }
    }
    let child: std.page.Slot = clone(option.unwrap(std.page.child_slot(page, at)))
    let moved_child = compact_relocate(source, child, path, depth + 1, mut work)?
    compact_rebuild(page, at, Some(moved_child), None)
}

fn compact_queue_page(source: TieredPageSource, slot: std.page.Slot, pack: u64, row: PackIndexRow, mut work: TieredCompactWork) -> Result[Option[TieredQueueValue], Error] waits {
    let Some(path) = probe_tiered_path(source, slot, pack, row)? else {
        return Ok(None)
    }
    let moved = compact_relocate(source, slot, path, 0, mut work)?
    Ok(Some(MovedQueuePage(take moved)))
}

// §13.6 "Queue rows are their own roots": a Page row is compared and then
// descended by the index row's key; a Blob row is compared. A match moves.
fn compact_queue_row(mut work: TieredCompactWork, source: TieredPageSource, at: u64, queued: DeferredFree, pack: u64, row: PackIndexRow) -> Result[(), Error] waits {
    let current: Option[TieredQueueValue] = match map.get(work.queue, at) {
        Some(earlier) => Some(clone(earlier.value)),
        None => None,
    }
    let found: Option[TieredQueueValue] = match take current {
        Some(MovedQueuePage(take slot)) => compact_queue_page(source, slot, pack, row, mut work)?,
        // A moved BLOB is Hot and names no frame.
        Some(MovedQueueBlob(_, _)) => None,
        None => match queued.target {
            TieredPage(ptr) => compact_queue_page(source, ColdPage(ptr), pack, row, mut work)?,
            TieredBlob(reference) => {
                if probe_frame_matches(pack, row, TieredBlob(reference))? {
                    let frame = fold_frame_at(source, TieredBlob(reference))?
                    let TieredValue(body) = view frame.payload else {
                        fail("store: a BLOB reference resolved to a PAGE")
                    }
                    let moved_body = disk_allocation(scoped fn() -> Result[Arc[Bytes], Error] {
                        Ok(arc.new(failure_result_from_rep(types.copied(body))?))
                    })?
                    Some(MovedQueueBlob(reference, take moved_body))
                } else {
                    None
                }
            },
        },
    }
    let Some(take value) = take found else {
        return Ok(())
    }
    let key = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        failure_result_from_rep(types.copied(row.key))
    })?
    failure_result_from_rep(types.capacity(map.try_reserve(mut work.queue, 1)))?
    map.insert(mut work.queue, at, TieredQueueMove(branch_id: queued.branch_id, collection: row.collection, key: take key, value: take value))
    Ok(())
}

// One PACK_INDEX row. Every queue row and every root that reaches the frame
// takes a moved path. The added rows are numbered from `first_added`, the
// installed `deferred_next`, as T8 step 3 will key them.
fn compact_row(mut work: TieredCompactWork, source: TieredPageSource, queued: List[DeferredFree], installed_queue: Arc[std.page.Page], first_added: u64, seq: u64, row: PackIndexRow) -> Result[bool, Error] waits {
    let mut rows = std.page.cursor_open(arc.share(installed_queue), None, true, false)
    while let Some(queue_row) = std.page.cursor_next(mut rows) {
        compact_queue_row(mut work, source, list.word_be(queue_row.key, 0), queued_free(queue_row.value), seq, row)?
    }
    for at in 0u64 .. list.len(queued) {
        compact_queue_row(mut work, source, first_added + at, queued[at], seq, row)?
    }
    let key = prefix(row.collection)?
    for slot in 0u64 .. list.len(work.roots) {
        let Some(edge) = promotion_collection_root(work.roots[slot].collections, row.collection)? else {
            continue
        }
        let Some(path) = probe_tiered_path(source, edge, seq, row)? else {
            continue
        }
        let moved_root = compact_relocate(source, edge, path, 0, mut work)?
        let (take mapped, following) = disk_allocation(scoped fn() -> Result[(Arc[std.page.Page], u64), Error] {
            let mut candidate = arc.share(work.roots[slot].collections.root)
            let mut draw = work.next_stamp
            page_result(std.page.install_tiered_root(mut candidate, key, moved_root, mut draw))?
            Ok((take candidate, draw))
        })?
        work.roots[slot].collections.root = take mapped
        work.next_stamp = following
    }
    Ok(true)
}

fn compact_probes(source: TieredPageSource, queued: List[DeferredFree], installed_queue: Arc[std.page.Page], first_added: u64, mut work: TieredCompactWork, mut probes: Map[u64, TieredProbeCursor], mut retiring: List[u64], budget: u64) -> Result[(), Error] waits {
    let mut packs_in_order: List[u64] = list.new()
    for (seq, _) in probes {
        failure_result_from_rep(types.capacity(list.try_reserve(mut packs_in_order, 1)))?
        list.push(mut packs_in_order, seq)
    }
    list.sort(mut packs_in_order, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    let mut left = budget
    for seq in packs_in_order {
        if left == 0 {
            break
        }
        let Some(take cursor) = map.remove(mut probes, seq) else {
            continue
        }
        let mut walk = take cursor
        let rows_before = walk.rows
        let finished = probe_tiered_index(source, seq, mut walk, left, mut work, scoped fn(mut state: TieredCompactWork, row: PackIndexRow) -> Result[bool, Error] waits {
            compact_row(mut state, source, queued, installed_queue, first_added, seq, row)
        })?
        left = int.saturating_sub(left, walk.rows - rows_before)
        if finished {
            failure_result_from_rep(types.capacity(list.try_reserve(mut retiring, 1)))?
            list.push(mut retiring, seq)
        } else {
            failure_result_from_rep(types.capacity(map.try_reserve(mut probes, 1)))?
            map.insert(mut probes, seq, take walk)
        }
    }
    Ok(())
}

// §13.6 selection: a listed Tiered pack below the ratio starts a probe. A
// pack keeps at most one probe. Shared by reading and Tiered-idle cuts.
fn pack_selected_for_compaction(seq: u64, pack: PagePack, running: Map[u64, TieredProbeCursor], permille: u64) -> bool {
    if pack.class != 3 && pack.class != 4 {
        return false
    }
    if map.contains(running, seq) {
        return true
    }
    // `live` counts frame payloads, so the ratio is taken over
    // the payload a fresh pack was emitted with: the data region
    // less one envelope per frame. A fresh pack is fully live.
    let frame_count: u64 = int.widen(pack.frames)
    let envelopes = 16 * frame_count
    if pack.index < 72 + envelopes {
        return false
    }
    let emitted_bytes = pack.index - 72 - envelopes
    let (Some(scaled), Some(threshold)) = (int.checked_mul(pack.live, 1000), int.checked_mul(emitted_bytes, permille)) else {
        return false
    }
    scaled < threshold
}

fn select_compaction(installed: PageLocations, running: Map[u64, TieredProbeCursor], permille: u64) -> Result[Map[u64, TieredProbeCursor], Error] {
    let mut probes: Map[u64, TieredProbeCursor] = map.new()
    let mut inventory = std.omap.range(installed.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if !pack_selected_for_compaction(seq, pack, running, permille) {
            continue
        }
        let cursor: TieredProbeCursor = match map.get(running, seq) {
            Some(kept) => clone(kept),
            None => start_tiered_probe(pack),
        }
        failure_result_from_rep(types.capacity(map.try_reserve(mut probes, 1)))?
        map.insert(mut probes, seq, take cursor)
    }
    Ok(take probes)
}

// §13.6 "Tiered-idle cuts" (v2.157, v2.161 D-TI-1): a candidate generation is
// Tiered-idle when no holder root (branch head, pin, import pin) has a Tiered
// collection descriptor, the candidate queue (installed and added rows) is
// empty, and there is no anchor (anchors are empty until archival lands).
fn cut_tiered_idle(roots: List[Roots], installed_queue: Arc[std.page.Page], queued: List[DeferredFree]) -> bool {
    !holders_tiered(roots) && std.page.count(std.page.image_of(installed_queue)) == 0 && list.len(queued) == 0
}

// D-TI-1 + v2.162 F2: a Tiered-idle cut reads nothing and needs no pager. It
// takes every listed class-3/4 pack in sequence order, retires each whole at
// this cut (charging its rows left against `budget`, finishing the pack it
// starts), removes the cursor of every pack it retires, and never installs or
// moves a cursor.
fn compact_idle_probes(installed: PageLocations, running: Map[u64, TieredProbeCursor], budget: u64) -> Result[(Map[u64, TieredProbeCursor], List[u64]), Error] {
    let mut probes: Map[u64, TieredProbeCursor] = clone(running)
    let mut retiring: List[u64] = list.new()
    let mut left = budget
    let mut inventory = std.omap.range(installed.packs.values, Unbounded, Unbounded)
    while left > 0 {
        let Some((seq, pack)) = std.omap.next(mut inventory) else {
            break
        }
        if pack.class != 3 && pack.class != 4 {
            continue
        }
        let done = match map.get(running, seq) {
            Some(cursor) => cursor.rows,
            None => 0u64,
        }
        let frame_count: u64 = int.widen(pack.frames)
        let rows_left = int.saturating_sub(frame_count, done)
        left = int.saturating_sub(left, rows_left)
        failure_result_from_rep(types.capacity(list.try_reserve(mut retiring, 1)))?
        list.push(mut retiring, seq)
        let _ = map.remove(mut probes, seq)
    }
    Ok((take probes, take retiring))
}

// AP16 item 3 for Tiered packs, after the fold and the candidate queue's
// added rows, before the drain. A refused allocation drops the cut's probe
// progress: the installed cursors stand, nothing retires, and every root
// is the one the cut staged before the probes ran, and no queue row is
// rewritten.
fn compact_cut(db: Db, pager: Option[View[Sender[TieredPagerMessage]]], mut roots: List[Roots], queued: List[DeferredFree], mut next_stamp: u64) -> Result[TieredCompactStep, Error] waits {
    let installed = disk_state(db).pages
    let running: Map[u64, TieredProbeCursor] = disk_allocation(scoped fn() -> Result[Map[u64, TieredProbeCursor], Error] {
        Ok(clone(installed.compaction.probes))
    })?
    let budget = disk_state(db).options.probe_budget
    let kept_probes: Map[u64, TieredProbeCursor] = disk_allocation(scoped fn() -> Result[Map[u64, TieredProbeCursor], Error] {
        Ok(clone(running))
    })?
    let unchanged = TieredCompactStep(probes: take kept_probes, retiring: list.new(), moved: list.new(), queue: map.new())
    if budget == 0 {
        return Ok(take unchanged)
    }
    if cut_tiered_idle(roots, installed.lists.deferred, queued) {
        let idle = disk_allocation(scoped fn() -> Result[(Map[u64, TieredProbeCursor], List[u64]), Error] {
            compact_idle_probes(installed.locations, running, budget)
        })
        return match take idle {
            Ok((take probes, take retiring)) => Ok(TieredCompactStep(probes: take probes, retiring: take retiring, moved: list.new(), queue: map.new())),
            Error(Full(Allocation(_))) => Ok(take unchanged),
            Error(take problem) => Error(take problem),
        }
    }
    let permille = disk_state(db).options.compact_permille
    // Selection, the probe inventory and the saved roots change nothing, so
    // a refusal among them skips the step like a refusal in the probes.
    let selecting = disk_allocation(scoped fn() -> Result[Map[u64, TieredProbeCursor], Error] {
        select_compaction(installed.locations, running, permille)
    })
    let selected = match take selecting {
        Ok(take chosen) => take chosen,
        Error(Full(Allocation(_))) => return Ok(take unchanged),
        Error(take problem) => return Error(take problem),
    }
    if map.len(selected) == 0 {
        return Ok(take unchanged)
    }
    let Some(requests) = pager else {
        return Error(Io(Closed))
    }
    let checkpointed = db.checkpointed
    let inventory_read = disk_allocation(scoped fn() -> Result[Arc[TieredReadInventory], Error] {
        recovered_tiered_inventory(installed.locations, None, checkpointed, next_stamp)
    })
    let paging = match take inventory_read {
        Ok(take ready) => take ready,
        Error(Full(Allocation(_))) => return Ok(take unchanged),
        Error(take problem) => return Error(take problem),
    }
    let source = TieredPageSource(pager: channel.sender(requests), packs: std.omap.snapshot(paging.packs), next_stamp: next_stamp, deadline: 0)
    // A refusal restores these, so no root keeps a move whose old ancestors
    // were never charged dead.
    let shared = disk_allocation(scoped fn() -> Result[List[Roots], Error] {
        let mut shares: List[Roots] = list.new()
        failure_result_from_rep(types.capacity(list.try_reserve(mut shares, list.len(roots))))?
        for held in roots {
            list.push(mut shares, PageRoots(collections: share_page_tree(held.collections), streams: share_page_tree(held.streams), catalog: share_page_tree(held.catalog), keyed: share_keyed_pages(held.keyed)))
        }
        Ok(take shares)
    })
    let saved = match take shared {
        Ok(take ready) => take ready,
        Error(Full(Allocation(_))) => return Ok(take unchanged),
        Error(take problem) => return Error(take problem),
    }
    let mut work = TieredCompactWork(roots: replace(mut roots, list.new()), next_stamp: next_stamp, moved: list.new(), moved_stamps: map.new(), queue: map.new())
    let mut probes = take selected
    let mut retiring: List[u64] = list.new()
    let ran = compact_probes(source, queued, installed.lists.deferred, installed.lists.deferred_next, mut work, mut probes, mut retiring, budget)
    next_stamp = work.next_stamp
    match ran {
        Ok(()) => {
            roots = replace(mut work.roots, list.new())
            Ok(TieredCompactStep(probes: take probes, retiring: take retiring, moved: replace(mut work.moved, list.new()), queue: replace(mut work.queue, map.new())))
        },
        Error(Full(Allocation(_))) => {
            roots = take saved
            Ok(take unchanged)
        },
        Error(take problem) => Error(take problem),
    }
}

fn queue_moves_in_order(moving: Map[u64, TieredQueueMove]) -> Result[List[u64], Error] {
    let mut seqs: List[u64] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut seqs, map.len(moving))))?
    for (at, _) in moving {
        list.push(mut seqs, at)
    }
    list.sort(mut seqs, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    Ok(take seqs)
}

// T2 for the moved queue rows: each copy is emitted once by stamp, outside
// every root (§13.6 "Queue rows are their own roots").
fn tiered_emit_queue(mut pending: TieredCutFrames, moving: Map[u64, TieredQueueMove]) -> Result[(), Error] {
    for at in queue_moves_in_order(moving)? {
        let Some(moved) = map.get(moving, at) else {
            continue
        }
        match moved.value {
            MovedQueuePage(slot) => tiered_emit_tree(mut pending, moved.collection, slot)?,
            MovedQueueBlob(reference, body) => {
                if !map.contains(pending.seen, reference.stamp) {
                    let key = failure_result_from_rep(types.copied(moved.key))?
                    let frame = PackFrame(stamp: reference.stamp, size: 8 + reference.len, body: BlobBody(arc.share(body)))
                    failure_result_from_rep(types.capacity(map.try_reserve(mut pending.seen, 1)))?
                    failure_result_from_rep(types.capacity(list.try_reserve(mut pending.blobs, 1)))?
                    map.insert(mut pending.seen, reference.stamp, ())
                    list.push(mut pending.blobs, TieredEmitFrame(collection: moved.collection, stamp_in_image: reference.stamp, key: take key, frame: take frame))
                }
            },
        }
    }
    Ok(())
}

// Each moved row's value at its emitted location (T8 step 3): an added row's
// in `added`, an installed row's in `rewritten`.
fn settle_queue_moves(mut queue: CutQueue, moving: Map[u64, TieredQueueMove], emitted: Map[u64, std.page.PagePtr], first_added: u64) -> Result[(), Error] {
    for at in queue_moves_in_order(moving)? {
        let Some(moved) = map.get(moving, at) else {
            continue
        }
        let target: format.TieredTarget = match moved.value {
            MovedQueuePage(slot) => {
                let HotPage(page) = view slot else {
                    fail("store: a moved queue row lost its copy")
                }
                let Some(place) = map.get(emitted, std.page.stamp(std.page.image_of(page))) else {
                    fail("store: the cut omitted a moved queue page")
                }
                TieredPage(place)
            },
            MovedQueueBlob(reference, _) => {
                let Some(place) = map.get(emitted, reference.stamp) else {
                    fail("store: the cut omitted a moved queue BLOB")
                }
                TieredBlob(std.page.BlobRef(stamp: reference.stamp, len: reference.len, checksum: place.checksum, pack: place.pack, offset: place.offset, body: reference.body))
            },
        }
        let row = DeferredFree(branch_id: moved.branch_id, target: take target)
        if at >= first_added {
            queue.added[at - first_added] = take row
        } else {
            failure_result_from_rep(types.capacity(list.try_reserve(mut queue.rewritten, 1)))?
            list.push(mut queue.rewritten, (at, take row))
        }
    }
    Ok(())
}

#!/usr/bin/env python3
"""Build HEAD twice in fresh checkouts and compare the bundles, then build the
release std at several job counts with the first bundle and compare those.

With --pgo both builds use one pinned profile: the given one, or one trained
once in the first checkout. Training is not reproducible, so a release takes a
profile as an input instead of training it."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[2]
CHUNK = 1024 * 1024
# A release std is built once per target and shipped, and programs key their
# parts on its bytes, so it must not depend on how many jobs built it.
STD_JOBS = (1, 2, 8)
STD_TARGET = 'x86_64-unknown-linux-gnu'


def build(revision, checkout, threads, arguments):
    if not checkout.exists():
        subprocess.run(['git', 'clone', '--quiet', '--shared', '--no-checkout', ROOT, checkout], check=True)
        subprocess.run(['git', 'checkout', '--quiet', '--detach', revision], cwd=checkout, check=True)
    try:
        subprocess.run([checkout / 'tools/toolchain-dist/build', '--local',
                        '--num-threads', str(threads), *arguments],
                       cwd=checkout, check=True)
    finally:
        buck = checkout / '.buck2/bin/buck2'
        if buck.is_file():
            subprocess.run([buck, 'kill'], cwd=checkout, check=True)


def first_difference(left, right):
    offset = 0
    with left.open('rb') as a, right.open('rb') as b:
        while True:
            x, y = a.read(CHUNK), b.read(CHUNK)
            if x != y:
                return offset + next((i for i, (u, v) in enumerate(zip(x, y)) if u != v),
                                     min(len(x), len(y)))
            if not x:
                return None
            offset += len(x)


def files(root, skip=()):
    return {p.relative_to(root) for p in root.rglob('*') if p.is_file() and p.name not in skip}


def compare(left, right, skip=()):
    left_files, right_files = files(left, skip), files(right, skip)
    equal = True
    for path in sorted(left_files | right_files):
        a, b = left / path, right / path
        if path not in left_files or path not in right_files:
            missing = a if path not in left_files else b
            print(f'{a} <> {b}: missing {missing}')
            equal = False
        elif (offset := first_difference(a, b)) is not None:
            print(f'{a} <> {b}: first differing byte at offset {offset}')
            equal = False
    if equal:
        print(f'check-repro: {len(left_files)} files match byte for byte')
    return equal


def std_at(prefix, run, jobs):
    """Build the release std from a fresh copy of `prefix` at `jobs` jobs, with
    its own home and cache, and return the store it wrote (`release-std/`)."""
    home = run / 'home'
    home.mkdir(parents=True)
    copy = run / 'prefix'
    shutil.copytree(prefix, copy, symlinks=True)
    env = dict(PATH=os.defpath, HOME=str(home), XDG_CACHE_HOME=str(home / 'cache'), TMPDIR=str(home),
               HIRSEL_JOBS=str(jobs), HIRSEL_MEMORY_LIMIT='8G')
    subprocess.run([copy / 'hirsel', 'std-product', '--store', run / 'store', '--target', STD_TARGET],
                   cwd=run, env=env, stdout=subprocess.DEVNULL, check=True)
    shutil.rmtree(copy)
    return run / 'store'


def check_std_jobs(prefix, work):
    """The release std store at each of STD_JOBS, byte for byte. `.budget` is a
    part cache's size estimate, not content."""
    print(f'check-repro: building the {STD_TARGET} release std at jobs {STD_JOBS}', flush=True)
    with ThreadPoolExecutor(len(STD_JOBS)) as pool:
        outputs = list(pool.map(lambda jobs: std_at(prefix, work / f'std-j{jobs}', jobs), STD_JOBS))
    equal = True
    for jobs, other in zip(STD_JOBS[1:], outputs[1:]):
        print(f'check-repro: release std at jobs {STD_JOBS[0]} against jobs {jobs}', flush=True)
        equal &= compare(outputs[0], other, skip=('.budget',))
    return equal


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True, help='fresh directory for the outputs')
    parser.add_argument('--num-threads', type=int, default=2, help='Buck2 execution threads per build')
    parser.add_argument('--pgo', nargs='?', const=True, type=Path, metavar='PROFILE',
                        help='build both compilers with one pinned profile (<sha256>.profdata); '
                             'without PROFILE, train it once first')
    parser.add_argument('--bolt', action='store_true', help='rewrite both compilers with BOLT')
    parser.add_argument('--std-jobs', type=Path, metavar='PREFIX',
                        help='only build the release std of this installed bundle at each job count')
    args = parser.parse_args()
    output = args.output.resolve()
    if output.is_relative_to(ROOT) or output.exists():
        parser.error('output must be a fresh directory outside the checkout')
    if args.num_threads < 1:
        parser.error('--num-threads must be positive')
    output.mkdir(parents=True)
    if args.std_jobs is not None:
        return 0 if check_std_jobs(args.std_jobs.resolve(), output) else 1
    revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
    left, right = output / 'first', output / 'second'
    with tempfile.TemporaryDirectory(prefix='hirsel-repro-', dir=output) as scratch:
        # The second checkout's path differs in length too, so an embedded path shows.
        first, second = Path(scratch) / 'checkout', Path(scratch) / 'second-checkout'
        profile = args.pgo.resolve() if isinstance(args.pgo, Path) else None
        if args.pgo is True:
            print(f'check-repro: training one profile at {revision}', flush=True)
            build(revision, first, args.num_threads, ['--train-profile', output / 'profile',
                                                      '--work', Path(scratch) / 'profile-work'])
            shutil.rmtree(Path(scratch) / 'profile-work')
            (profile,) = (output / 'profile').glob('*.profdata')
        flags = ['--pgo', profile] * bool(profile) + ['--bolt'] * args.bolt
        print(f'check-repro: building {revision} twice {" ".join(map(str, flags)) or "without PGO"}', flush=True)
        # A checkout's Buck2 state is about 18 GB; keep only the bundles.
        build(revision, first, args.num_threads, ['--output', left, *flags])
        shutil.rmtree(first)
        build(revision, second, args.num_threads, ['--output', right, *flags])
        shutil.rmtree(second)
    equal = compare(left, right)
    with tempfile.TemporaryDirectory(prefix='hirsel-std-jobs-', dir=output) as scratch:
        equal &= check_std_jobs(left, Path(scratch))
    return 0 if equal else 1


if __name__ == '__main__':
    raise SystemExit(main())

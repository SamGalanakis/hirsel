// Unused constants cannot hide an overflow or a cycle.
// expect: refuse LANG-20 at 6:17
// expect: refuse LANG-20 at 7:19
// UNUSED calls a function: it is computed (LANG-20), and its run returns 7.
fn identity(x: u8) -> u8 { x }
const BIG: u8 = 200 + 100
const CYCLE: u8 = CYCLE
const UNUSED: u8 = identity(7)
fn f() -> u8 { 1 }
// expect: refuse LANG-20 at 11:20
const WRONG: u64 = 1u8 == 1u8

// base and rows, as one schema commit.
fn schema_refusal_tables(mut db: Db) -> Result[Ticket, Error] waits {
    let mut d = declare(db, Migrate)?
    let base = declare_table(mut d, "base", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut d, take base)?
    let rows = declare_table(mut d, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut d, take rows)?
    seal(mut db, take d)
}

// Q1/K1: sweep task allowances through open and schema-cut refusal. A refused
// A table declaration leaves the base reader roots and durable generation unchanged.
pub fn disk_law_schema_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let limits: Inline[u64, 4] =[8192, 32768, 131072, 1048576]
    let mut refusals: u64 = 0
    let mut successes: u64 = 0
    for allowance in limits {
        let mut name = string.from("schema-cut-")
        string.reserve(mut name, 32)
        let child = result.unwrap(host.mkdtemp(d, mut name))
        let mut options = result.unwrap(sized(Directory, 2147483648u64))
        options.resident_limit = 1048576
        options.pack_bytes = 512
        let attempt = open(tasks, child, c, r, options)
        let mut db = match take attempt {
            Ok(take db) => take db,
            Error(Full(_)) => continue,
            _ => return false
        }
        match law_table(mut db, "base", std.codec.key_u64(), std.codec.of_u64()) {
            Ok(_) => {},
            Error(Full(_)) => {
                result.unwrap(close(take db));
                continue
            },
            _ => return false
        }
        let base = result.unwrap(table(mut db, "base", std.codec.key_u64(), std.codec.of_u64()))
        for k in 0u64 .. 512 {
            if !typed_put(mut db, base, k, k + 1) {
                return false
            }
        }
        let made = bound bytes allowance {
            schema_refusal_tables(mut db)
        }
        match take made {
            Ok(Error(Full(Allocation(_)))) => {
                refusals += 1
                if pages.holder_heads(db.holders)[0].head != 513 || db.resident != 260 + 512 * 94 || db.checkpointed != 2 || catalog.next_table_id(db.schema) != 2 || page_row_count(pages.holder_heads(db.holders)[0].roots.catalog) != 1 || page_row_count(pages.holder_heads(db.holders)[0].roots.collections) != 512 {
                    return false
                }
                let persisted = result.unwrap(disk_load(child, 1048576))
                if persisted.manifest.generation != 2 || persisted.manifest.branches[0].version != 1 || persisted.manifest.next_table != 2 || page_row_count(persisted.all[0u64].catalog) != 1 || page_row_count(persisted.all[0u64].collections) != 0 {
                    return false
                }
            },
            Ok(Ok(commit_ticket)) => {
                successes += 1
                if pages.holder_heads(db.holders)[0].head != 514 || db.checkpointed != 3 || catalog.next_table_id(db.schema) != 3 {
                    return false
                }
                result.unwrap(durable(mut db, commit_ticket))
            },
            _ => return false
        }
        result.unwrap(close(take db))
    }
    refusals > 0 && successes > 0
}

@test
fn disk_test_schema_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_schema_refusal(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L28(a). One BLOB dominates the scratch reservation, including its store
// header, frame header, stamp and Bytes codec envelope.
fn check_publish_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut db = open(tasks, directory, c, r, options)?
    let codec = std.codec.of_bytes()
    let _ = law_table(mut db, "values", std.codec.key_u64(), codec)?
    let t = table(mut db, "values", std.codec.key_u64(), codec)?
    let saved = run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        let mut value: Bytes = list.with_capacity(1024)
        list.fill(mut value, 1024, 7u8)
        put(mut tx, call_env, 1, value)
    })?
    let Committed(done) = saved else {
        return Error(Foreign)
    }
    durable(mut db, done.ticket)?
    let listed_entries = result.unwrap(std.dir.list(directory, None))
    let mut original: List[Bytes] = list.with_capacity(list.len(listed_entries))
    for file in listed_entries {
        list.push(mut original, failure_result_from_rep(manifest.disk_read_paged_file(directory, file.name, 4096))?)
    }
    let pack_size = 72u64 + 16 + 8 + 6 + 1024
    let pack = failure_result_from_rep(manifest.paged_pack_path(manifest.pack_next(disk_state(db).packs)))?
    let mut timing: Option[CutTiming] = None
    match disk_cut_with_limit(mut db, NoHolderChange, seal_page_manifest_file, None, options.pack_bytes, pack_size - 1, mut timing) {
        Error(Full(Allocation(problem))) if problem.requested == pack_size && problem.available == pack_size - 1 => (),
        _ => return Error(Foreign),
    }
    let after = result.unwrap(std.dir.list(directory, None))
    if list.len(after) != list.len(listed_entries) {
        return Error(Foreign)
    }
    for i in 0u64 .. list.len(listed_entries) {
        if after[i].name != listed_entries[i].name || failure_result_from_rep(manifest.disk_read_paged_file(directory, after[i].name, 4096))? != original[i] {
            return Error(Foreign)
        }
    }
    let committed_at = disk_cut_with_limit(mut db, NoHolderChange, scoped fn(mut raw: Bytes, context: format.DiskContext, fence: u32) -> Result[(), Error] {
        if list.capacity(raw) != pack_size {
            return Error(Foreign)
        }
        seal_page_manifest_file(mut raw, context, fence)
    }, None, options.pack_bytes, pack_size, mut timing)?
    durable(mut db, committed_at)?
    let written = failure_result_from_rep(manifest.disk_read_paged_file(directory, pack, pack_size))?
    if list.len(written) != pack_size || format.read_le(written, 72, 2) != 0x0022 {
        return Error(Foreign)
    }
    close(take db)
}

pub fn disk_law_publish_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    match check_publish_refusal(d, c, r, tasks) {
        Ok(()) => true,
        Error(_) => false,
    }
}

@test
fn disk_test_publish_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    check_publish_refusal(d, c, r, tasks)
}

pub fn disk_law_pack_bound(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 41943040
    options.resident_limit = 134217728
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(law_table(mut db, "large", std.codec.key_u64(), std.codec.of_string()))
    let t = result.unwrap(table(mut db, "large", std.codec.key_u64(), std.codec.of_string()))
    let base = db.resident
    let mut raw: Bytes = list.with_capacity(1048566)
    list.fill(mut raw, 1048566, 97u8)
    let text = result.unwrap(string.from_utf8(take raw))
    for k in 0u64 .. 36 {
        let saved = result.unwrap(run(mut db, None, (copy_env(t), copy_env(text), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, call_env.2, call_env.1)
        }))
        if let Committed(_) = saved {} else {
            return false
        }
    }
    let cut = result.unwrap(checkpoint(mut db))
    result.unwrap(durable(mut db, cut))
    let (_, page_record) = result.unwrap(read_page_manifest_file(d))
    let checked = result.unwrap(validate_page_manifest(d, db.store, clone(page_record)))
    let mut large_pack = false
    for (seq, pack) in checked.inventory {
        if pack.class != 1 {
            continue
        }
        let path = result.unwrap(failure_result_from_rep(manifest.paged_pack_path(seq)))
        let bytes_in_pack = result.unwrap(failure_result_from_rep(manifest.disk_read_paged_file(d, path, 41943040)))
        if list.len(bytes_in_pack) == 72 + 36 * (16 + 8 + 1048572) {
            large_pack = true
        }
    }
    if !large_pack {
        return false
    }
    result.unwrap(close(take db))
    options.pack_bytes = 512
    options.create = false
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    if reopened.resident != base + 36 * (62 + 16 + 1048576) {
        return false
    }
    for k in 0u64 .. 36 {
        match result.unwrap(get(result.unwrap(reader(reopened, 0u64)), snapshot(reopened), t, k)) {
            Some(take value) => if value != text {
                return false
            },
            None => return false
        }
    }
    result.unwrap(close(take reopened))
    true
}

@test
fn disk_pack_bound(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_pack_bound(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// AP15's resident report. The reference is the full scan: every distinct
// page image reachable from the heads, the pins and the two list roots,
// each distinct blob body, and the location table's charges.
fn law_resident_scan(db: Db) -> bool {
    let mut roots: List[pages.PageRoots] = list.with_capacity(list.len(pages.holder_heads(db.holders)) + list.len(pages.holder_pins(db.holders)))
    for head in pages.holder_heads(db.holders) {
        list.push(mut roots, pages.share_roots(head.roots))
    }
    for held in pages.holder_pins(db.holders) {
        list.push(mut roots, pages.share_roots(held.roots))
    }
    let images = manifest.resident_images(roots, Some(manifest.pack_lists(disk_state(db).packs)))
    accounts(db).resident == int.saturating_add(images, manifest.scan_location_storage_charge(manifest.pack_locations(disk_state(db).packs)))
}

fn law_empty_collection_pages() -> Result[List[Arc[std.page.Page]], Error] {
    let mut tree = pages.new_page_tree(CollectionMap, 1024)
    let mut stamps = 1u64
    for id in 1u32 .. 5 {
        failure_result_from_rep(catalog.define_collection(mut tree, id, 1, 1, mut stamps))?
        failure_result_from_rep(pages.put_page_row(mut tree, failure_result_from_rep(catalog.logical_key(id, types.key_word(1)))?, string.as_bytes("x"), 1, mut stamps))?
    }
    failure_result_from_rep(catalog.define_collection(mut tree, 5, 1, 1, mut stamps))?
    failure_result_from_rep(catalog.bulk_collection(mut tree, 6, 1, list.new(), 1, mut stamps))?
    for id in 1u32 .. 5 {
        if !failure_result_from_rep(pages.remove_page_row(mut tree, failure_result_from_rep(catalog.logical_key(id, types.key_word(1)))?, 1, mut stamps))? {
            return Error(Foreign)
        }
    }
    let mut children: List[Arc[std.page.Page]] = list.with_capacity(6)
    for id in 1u32 .. 7 {
        let Some((page, descriptor)) = std.page.collection_entry(tree.root, failure_result_from_rep(catalog.prefix(id))?) else {
            return Error(Foreign)
        }
        let image = std.page.image_of(page)
        if std.page.stamp(image) != 0 || std.page.count(image) != 0 || list.slice(descriptor, 0, 36) != std.page.encode_ptr(std.page.unlocated(0)) {
            return Error(Foreign)
        }
        list.push(mut children, arc.share(page))
    }
    Ok(take children)
}

fn law_empty_collection_resident() -> bool {
    let mut pages = result.unwrap(law_empty_collection_pages())
    let mut resident = 0u64
    // The fixture has dropped the map. Only the last handle to each distinct
    // allocation unwraps, so its image capacity contributes exactly once.
    while let Some(take page) = list.pop(mut pages) {
        let image_capacity = list.capacity(std.page.payload(std.page.image_of(page)))
        if let Ok(_) = arc.try_unwrap(take page) {
            resident += image_capacity
        }
    }
    // AP3's 24-byte header is the whole image of AP2's shared empty page.
    resident == 24
}

fn law_resident_text(state: u64) -> String {
    // Values of 1,500 bytes are over the 1,024-byte inline threshold.
    let width = if (state >> 40) % 4 == 0 {
        1500u64
    } else {
        1 + (state >> 44) % 48
    }
    let mut raw: Bytes = list.with_capacity(width)
    list.fill(mut raw, width, 97u8 + int.truncate((state >> 52) % 26))
    result.unwrap(string.from_utf8(take raw))
}

fn law_resident_name(lead: String, slot: u64) -> String {
    let mut name = string.from(lead)
    string.push(mut name, if slot == 0 {
        "0"
    } else if slot == 1 {
        "1"
    } else {
        "2"
    })
    take name
}

// A copied leaf keeps its rows but drops the installed leaf's spare slots.
fn law_location_cow_charge() -> Result[bool, Error] {
    let mut installed = manifest.new_page_locations()
    for stamp in 1u64 .. 3 {
        failure_result_from_rep(manifest.add_location(mut installed, std.page.unlocated(stamp), 0, 0, list.new()))?
    }
    let mut candidate = manifest.share_page_locations(installed)
    failure_result_from_rep(manifest.add_page_source(mut candidate, 1, HolderSource(0, 0, 0)))?
    let before = std.omap.storage_charge(installed.frames.values, bytes[u64], bytes[manifest.FrameLocation])
    let after = std.omap.storage_charge(candidate.frames.values, bytes[u64], bytes[manifest.FrameLocation])
    Ok(before > after && manifest.resident_location_charge(installed) == manifest.scan_location_storage_charge(installed) && manifest.resident_location_charge(candidate) == manifest.scan_location_storage_charge(candidate))
}

// Wrong implementations caught: a record charged twice when a second holder
// reaches it, a refund missed when unpin, delete_branch or a commit retires
// the last path to a page, a blob charged per leaf instead of per stamp, a
// relocation that charges a moved frame again, and an open whose seed
// disagrees with the pages a journal replay replaced.
pub fn disk_law_resident_charge(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    if !law_empty_collection_resident() || !result.unwrap(law_location_cow_charge()) {
        return false
    }
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 16777216
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_string()))
    let mut t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_string()))
    let _ = result.unwrap(checkpoint(mut db))
    let before = accounts(db).resident
    let installed = manifest.share_page_locations(manifest.pack_locations(disk_state(db).packs))
    let _ = result.unwrap(checkpoint(mut db))
    let frame_ids = manifest.pack_locations(disk_state(db).packs).frames.ids
    let pack_ids = manifest.pack_locations(disk_state(db).packs).packs.ids
    if before != accounts(db).resident || installed.frames.ids != frame_ids || installed.packs.ids != pack_ids || !law_resident_scan(db) {
        return false
    }
    let mut forked = 0u64
    let mut held = 0u64
    let mut state = 1721u64
    let mut cuts = 0u64
    for operation in 0u64 .. 96 {
        state = splitmix64(state + operation)
        let k = (state >> 8) % 48
        let slot = (state >> 16) % 3
        let bit = 1u64 << slot
        let choice = (state >> 24) % 16
        if choice < 6 {
            let text = law_resident_text(state)
            let out = result.unwrap(run(mut db, None, (copy_env(t), copy_env(k), copy_env(text)), fn(mut tx, call_env) -> Result[(), Error] {
                put(mut tx, call_env.0, call_env.1, call_env.2)
            }))
            if let Committed(_) = out {} else {
                return false
            }
        } else if choice == 6 {
            let out = result.unwrap(run(mut db, None, (copy_env(t), copy_env(k)), fn(mut tx, call_env) -> Result[bool, Error] {
                delete(mut tx, call_env.0, call_env.1)
            }))
            if let Committed(_) = out {} else {
                return false
            }
        } else if choice == 7 && forked & bit == 0 {
            let from = snapshot(db)
            let _ = result.unwrap(fork(mut db, law_resident_name("b", slot), from))
            forked = forked | bit
        } else if choice == 8 && forked & bit != 0 {
            let b = option.unwrap(branch(db, law_resident_name("b", slot)))
            let text = law_resident_text(splitmix64(state))
            let out = result.unwrap(run_on(mut db, b, None, (copy_env(t), copy_env(k), copy_env(text)), fn(mut tx, call_env) -> Result[(), Error] {
                put(mut tx, call_env.0, call_env.1, call_env.2)
            }))
            if let Committed(_) = out {} else {
                return false
            }
        } else if choice == 9 && forked & bit != 0 {
            let b = option.unwrap(branch(db, law_resident_name("b", slot)))
            let _ = result.unwrap(delete_branch(mut db, b))
            forked = forked & ~bit
            cuts += 1
            if !law_resident_scan(db) {
                return false
            }
        } else if choice == 10 && held & bit == 0 {
            let from = snapshot(db)
            let _ = result.unwrap(pin(mut db, law_resident_name("p", slot), from))
            held = held | bit
            cuts += 1
            if !law_resident_scan(db) {
                return false
            }
        } else if choice == 11 && held & bit != 0 {
            let _ = result.unwrap(unpin(mut db, law_resident_name("p", slot)))
            held = held & ~bit
            cuts += 1
            if !law_resident_scan(db) {
                return false
            }
        } else if choice < 14 {
            let _ = result.unwrap(checkpoint(mut db))
            cuts += 1
            if !law_resident_scan(db) {
                return false
            }
        } else if choice == 14 {
            // The journal tail since the last cut replays over the MANIFEST's pages.
            result.unwrap(close(take db))
            db = result.unwrap(open(tasks, d, c, r, options))
            t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_string()))
        }
    }
    let _ = result.unwrap(checkpoint(mut db))
    let good = cuts >= 8 && law_resident_scan(db)
    result.unwrap(close(take db))
    good
}

@test
fn disk_test_resident_charge(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_resident_charge(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn disk_test_directory(d: Dir) -> Dir waits {
    let mut name = string.with_capacity(64)
    string.push(mut name, "store-law-")
    result.unwrap(host.mkdtemp(d, mut name))
}

fn disk_crash_options(scenario: String) -> Options {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = if scenario == "refusal" {
        2097152u64 + 1048639
    } else {
        2097152u64
    }
    options.pack_bytes = if scenario == "oversize" {
        1
    } else {
        512
    }
    options
}

fn disk_crash_init(d: Dir, c: Clock, r: Random, tasks: Tasks, scenario: String) -> Result[(), Error] waits {
    let options = disk_crash_options(scenario)
    let mut db = open(tasks, d, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if scenario == "refusal" {
        // A second schema commit, as the read phase's head numbers expect.
        let _ = law_pair(mut db, "rows", std.codec.key_u64(), std.codec.of_u64(), "big", std.codec.key_u64(), std.codec.of_string())?
    }
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 96 {
        let inserted = run(mut db, None, (copy_env(t), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, call_env.1, call_env.1 + 1)
        })?
        match take inserted {
            Committed(_) => {},
            _ => fail("crash init put")
        }
    }
    let _ = checkpoint(mut db)?
    if scenario == "gap" {
        let loaded = disk_load(d, options.resident_limit)?
        let seq = loaded.manifest.next_pack
        let first_name = failure_result_from_rep(types.capacity(manifest.disk_path("p-", seq, "")))?
        let second_name = failure_result_from_rep(types.capacity(manifest.disk_path("p-", seq + 1, "")))?
        let first = failure_result_from_rep(types.capacity(format.disk_header_bytes(format.DiskContext(store: store_key_to_rep(db.store), role: 3, seq: seq), 0, 0)))?
        let second = failure_result_from_rep(types.capacity(format.disk_header_bytes(format.DiskContext(store: store_key_to_rep(db.store), role: 3, seq: seq + 1), 0, 0)))?
        failure_result_from_rep(manifest.disk_write_synced(d, first_name, first))?
        failure_result_from_rep(manifest.disk_write_synced(d, second_name, second))?
        failure_result_from_rep(manifest.disk_io(host.sync_dir(d)))?
        // Explicit legal post-cleanup gap from H3's partial-persistence model.
        // W2's restart itself still discards all volatile directory operations.
        let _ = failure_result_from_rep(manifest.disk_remove_optional(d, first_name))?
        failure_result_from_rep(manifest.disk_io(host.sync_dir(d)))?
    }
    if scenario == "checkpoint" || scenario == "gap" || scenario == "oversize" {
        // L4 cuts only the checkpoint. Its input commits are durable before
        // the adapter arms filesystem cuts, so every reopen must keep them.
        for k in 0u64 .. 64 {
            if !typed_put(mut db, t, k, k + 101) {
                fail("checkpoint input")
            }
        }
        let final_item = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
        durable(mut db, final_item)?
    }
    close(take db)
}

fn disk_crash_write(d: Dir, c: Clock, r: Random, tasks: Tasks, scenario: String) -> Result[(), Error] waits {
    if scenario == "genesis" {
        return disk_crash_init(d, c, r, tasks, scenario)
    }
    let options = disk_crash_options(scenario)
    let mut db = open(tasks, d, c, r, options)?
    if scenario == "schema" {
        let _ = law_pair(mut db, "rows", std.codec.key_u64(), std.codec.of_u64(), "added", std.codec.key_u64(), std.codec.of_u64())?
    } else if scenario == "refusal" {
        let big = table(mut db, "big", std.codec.key_u64(), std.codec.of_string())?
        let mut raw: Bytes = list.with_capacity(1048566)
        list.fill(mut raw, 1048566, 97u8)
        let large = result.unwrap(string.from_utf8(take raw))
        let inserted = run(mut db, None, (copy_env(big), copy_env(large)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, 1, call_env.1)
        })?
        match take inserted {
            Committed(_) => {},
            _ => fail("crash refusal put")
        }
        let cut = bound bytes 524288 {
            checkpoint(mut db)
        }
        match take cut {
            Ok(Error(Full(Allocation(_)))) => {},
            Ok(Error(take problem)) => return Error(take problem),
            Ok(Ok(_)) => fail("oversized cut unexpectedly fits"),
            Error(_) => fail("cut did not return its allocation refusal"),
        }
        let deleted = run(mut db, None, big, fn(mut tx, call_env) -> Result[bool, Error] {
            delete(mut tx, call_env, 1)
        })?
        match take deleted {
            Committed(done) => if !done.value {
                fail("crash refusal delete")
            },
            _ => fail("crash refusal delete")
        }
        let _ = checkpoint(mut db)?
    } else if scenario == "migrate" {
        let mut decl = declare_migration(db, tasks, code.describe(crash_migration))?
        crash_schema(mut decl)?
        let _ = seal(mut db, take decl)?
    } else if scenario == "branches" {
        // L7 at every W2 cut: pin, fork, a fork commit made durable, unpin.
        let arg10 = snapshot(db)
        let _ = pin(mut db, "p", arg10)?
        let arg11 = snapshot(db)
        let (b, _) = fork(mut db, "b", arg11)?
        let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
        let on_b = run_on(mut db, b, None, t, fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env, 0, 500)
        })?
        match take on_b {
            Committed(done) => durable(mut db, done.ticket)?,
            _ => fail("crash fork put")
        }
        let _ = unpin(mut db, "p")?
    } else {
        let _ = checkpoint(mut db)?
    }
    close(take db)
}

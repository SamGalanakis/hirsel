// RTC-4 egress: SSRC collisions, sealed media and RTX, NACK answers, reports and the session clock.
// ---- RTC-4: SSRC collisions ----
fn retire(mut p: PeerSession, ssrc: u32, mut out: Outbox) -> Result[(), PeerError] {
    let Some(to) = p.path else {
        return Ok(())
    }
    let mut b: Bytes = list.with_capacity(64)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = rtp.rtcp.write_rr(ssrc, view empty, mut b)
    let _ = rtp.rtcp.write_bye(ssrc, mut b)
    let tag = own_tag(p)
    if let Ok(_) = seal(mut p, true, mut b) {
        queue(mut out, to, b, tag)?
    }
    end_send(mut p, ssrc)
    Ok(())
}

/// A confirmed collision: an authenticated packet or report from the remote end uses
/// an SSRC this session sends on.
fn collide(mut p: PeerSession, now: u64, ssrc: u32, mut collided: List[u16], mut out: Outbox) -> Result[(), PeerError] {
    if ssrc == p.control {
        retire(mut p, ssrc, mut out)?
        let fresh = draw(mut p)
        p.control = fresh
        return Ok(())
    }
    for t in 0u64 .. list.len(p.tracks) {
        if p.tracks[t].ssrc == ssrc || (p.tracks[t].rtx_ssrc != 0 && p.tracks[t].rtx_ssrc == ssrc) {
            let old = p.tracks[t].ssrc
            let old_rtx = p.tracks[t].rtx_ssrc
            retire(mut p, old, mut out)?
            let fresh = draw(mut p)
            p.tracks[t].ssrc = fresh
            if old_rtx != 0 {
                retire(mut p, old_rtx, mut out)?
                let fresh_rtx = draw(mut p)
                p.tracks[t].rtx_ssrc = fresh_rtx
            }
            p.tracks[t].highest = EMPTY
            p.tracks[t].sent = rtp.stats.sent(0)
            let _ = rtp.history.clear(mut p.tracks[t].history)
            list.push(mut collided, int.narrow(t))
        }
    }
    Ok(())
}

// ---- Egress ----
fn has_rtx(a: sdp.Agreed) -> bool {
    for f in a.formats {
        if f.codec == Rtx {
            return true
        }
    }
    false
}

/// Make a down-track on a sending section. It draws its media SSRC and, for video
/// with RTX agreed, its RTX SSRC; both keep for the track's life while collision-free.
/// `first_seq` and `first_ts` are the outgoing stream's first number and timestamp
/// (RFC 3550 section 5.1: the router draws them at random).
pub fn add_track(mut p: PeerSession, section: u8, first_seq: u16, first_ts: u32) -> Result[u16, PeerError] {
    let si: u64 = int.widen(section)
    if si >= list.len(p.sections) || !p.sections[si].agreed.send {
        return Error(Sdp(AnswerMismatch(section)))
    }
    if list.len(p.tracks) >= int.widen(p.limits.down_tracks) {
        return Error(Capacity(Capacity(requested: list.len(p.tracks) + 1, available: int.widen(p.limits.down_tracks))))
    }
    let video = p.sections[si].agreed.media == Video
    let clock = match list.get(p.sections[si].agreed.formats, 0) {
        Some(f) => f.clock,
        None => 90000,
    }
    let ssrc = draw(mut p)
    let rtx = if video && has_rtx(p.sections[si].agreed) {
        draw(mut p)
    } else {
        0
    }
    let history: rtp.history.History[Record] = rtp.history.history(HISTORY_SLOTS, HISTORY_AGE_NS) ?=> |c| Capacity(c)
    let rewrite = rtp.rewrite.rewrite(clock, REWRITE_RANGES, REWRITE_FRAMES, int.widen(first_seq), first_ts) ?=> |c| Capacity(c)
    let pictures = rtp.counter.counter(15, Compact, COUNTER_SLOTS) ?=> |c| Capacity(c)
    let tl0s = rtp.counter.counter(8, Compact, COUNTER_SLOTS) ?=> |c| Capacity(c)
    list.try_reserve(mut p.tracks, 1) ?=> |c| Capacity(c)
    list.push(mut p.tracks, Track(section: section, video: video, ssrc: ssrc, rtx_ssrc: rtx, rtx_seq: 0, highest: EMPTY, sent: rtp.stats.sent(clock), history: take history, src: None, rewrite: take rewrite, gated: None, pictures: take pictures, tl0s: take tl0s, tl0: 0))
    Ok(int.narrow(list.len(p.tracks) - 1))
}

/// Point a down-track at a source layer (RTP-11 `target`). The router owns the map
/// from `Layer(e, s, t)` to `(source, i)` (RTC-6).
pub fn set_target(mut p: PeerSession, track: u16, t: rtp.rewrite.Target) -> Result[(), rtp.rewrite.TargetError] {
    let i: u64 = int.widen(track)
    if i < list.len(p.tracks) {
        rtp.rewrite.target(mut p.tracks[i].rewrite, t)?
    }
    Ok(())
}

/// A source's sender report, for the switch timeline (RTP-11 `on_sr`).
pub fn source_report(mut p: PeerSession, track: u16, source: u32, info: rtp.rtcp.SenderInfo, now: u64) {
    let i: u64 = int.widen(track)
    if i < list.len(p.tracks) {
        rtp.rewrite.on_sr(mut p.tracks[i].rewrite, source, info, now)
    }
}

/// The source a down-track waits to switch to, if any (RTP-11 `pending`).
pub fn pending(p: PeerSession, track: u16) -> Option[u32] {
    let i: u64 = int.widen(track)
    if i >= list.len(p.tracks) {
        return None
    }
    rtp.rewrite.pending(p.tracks[i].rewrite)
}

/// The target index the down-track forwards on `source`, if that is its current source.
pub fn current_layer(p: PeerSession, track: u16, source: u32) -> Option[u8] {
    let i: u64 = int.widen(track)
    if i >= list.len(p.tracks) {
        return None
    }
    rtp.rewrite.current(p.tracks[i].rewrite, source)
}

fn send_pt(a: sdp.Agreed, codec: sdp.Codec) -> Option[u8] {
    for f in a.formats {
        if f.codec == codec {
            return Some(f.pt)
        }
    }
    None
}

fn rtx_pt(a: sdp.Agreed, pt: u8) -> Option[u8] {
    for f in a.formats {
        if f.codec == Rtx && f.apt == Some(pt) {
            return Some(f.pt)
        }
    }
    None
}

// The subscriber leg's extensions: its MID value and, at send, the next number of
// its own transport (RTP-8). The publisher's MID, RID and transport number never pass.
fn leg_writer(mut p: PeerSession, now: u64, si: u64, size: u32, level: Option[u8], voice: bool) -> Result[rtp.ext.ExtWriter, PeerError] {
    let map = p.sections[si].map
    let mut w = rtp.ext.writer()
    let n = list.len(p.sections[si].mid)
    rtp.ext.put(mut w, map, Mid, p.sections[si].mid, 0, n) ?=> |_| Rtp(Form)
    if let Some(l) = level {
        rtp.ext.put_level(mut w, map, voice, l) ?=> |_| Rtp(Form)
    }
    if p.sections[si].twcc {
        let number = rtp.twcc.assign(mut p.send_log, now, size)
        list.clear(mut p.word)
        list.put_word_be(mut p.word, number)
        rtp.ext.put(mut w, map, TransportSeq, p.word, 0, 2) ?=> |_| Rtp(Form)
    }
    Ok(w)
}

// Seal the scratch packet in place and copy it into the subscriber's span of `out`.
fn seal_out(mut p: PeerSession, src: Gen, mut out: Outbox) -> Result[(), PeerError] {
    let Some(to) = p.path else {
        return Error(Closed)
    }
    let mut b = replace(mut p.pkt, list.new())
    let sealed = seal(mut p, false, mut b)
    let queued = match sealed {
        Ok(_) => queue(mut out, to, b, Tag(src: Some(src), dst: p.who.gen, room: p.who.room)),
        Error(take e) => Error(take e),
    }
    list.clear(mut b)
    p.pkt = take b
    queued
}

// The leg's codec descriptor values for one output frame: VP8's picture ID and
// TL0PICIDX, counted per down-track and keyed by the source frame (RTP-11 counters).
fn descriptor(mut p: PeerSession, t: u64, leg: Leg, payload: Bytes) -> (Option[u16], Option[u8]) {
    if leg.codec != Vp8 {
        return (None, None)
    }
    let Ok(d) = media_bits.vp8.parse(list.slice(payload, leg.from, leg.from + leg.len)) else {
        return (None, None)
    }
    let picture = match d.picture_id {
        Some(_) => match rtp.counter.forward(mut p.tracks[t].pictures, leg.ts, None, 15) {
            Ok(v) => {
                let w: u16 = int.narrow(v)
                Some(w)
            },
            Error(_) => None,
        },
        None => None,
    }
    let tl0 = match d.tl0picidx {
        Some(_) => {
            if d.temporal == Some(0) || d.temporal == None {
                if let Ok(v) = rtp.counter.forward(mut p.tracks[t].tl0s, leg.ts, None, 8) {
                    p.tracks[t].tl0 = int.narrow(v)
                }
            }
            Some(p.tracks[t].tl0)
        },
        None => None,
    }
    (picture, tl0)
}

// The payload as the leg sends it: the source bytes, with the descriptor's picture ID
// and TL0PICIDX rewritten in place in the scratch packet from `at`.
fn put_payload(mut p: PeerSession, at: u64, payload: Bytes, from: u64, len: u64, picture: Option[u16], tl0: Option[u8]) -> Result[(), PeerError] {
    if list.capacity(p.pkt) - list.len(p.pkt) < len + 16 {
        return Error(Capacity(Capacity(requested: len + 16, available: list.capacity(p.pkt) - list.len(p.pkt))))
    }
    list.append(mut p.pkt, list.slice(payload, from, from + len))
    if picture == None && tl0 == None {
        return Ok(())
    }
    // RFC 7741 section 4.2: the picture ID follows the two first octets, and TL0PICIDX follows it.
    let Ok(d) = media_bits.vp8.parse(list.slice(payload, from, from + len)) else {
        return Ok(())
    }
    let mut next = at + 2
    match d.picture_id {
        Some(ShortId(_)) => {
            if let Some(v) = picture {
                p.pkt[next] = int.narrow(v % 128)
            }
            next += 1
        },
        Some(LongId(_)) => {
            if let Some(v) = picture {
                let high: u8 = int.narrow((v >> 8) & 127)
                p.pkt[next] = 128 | high
                p.pkt[next + 1] = int.narrow(v & 255)
            }
            next += 2
        },
        None => (),
    }
    if d.tl0picidx != None {
        if let Some(v) = tl0 {
            p.pkt[next] = v
        }
    }
    Ok(())
}

fn write_rtx(mut p: PeerSession, now: u64, t: u64, index: u64, ts: u32, rec: Record, payload: Bytes, mut out: Outbox) -> Result[bool, PeerError] {
    let si: u64 = int.widen(p.tracks[t].section)
    let Some(rpt) = rtx_pt(p.sections[si].agreed, rec.pt) else {
        return Ok(false)
    }
    if p.tracks[t].rtx_ssrc == 0 {
        return Ok(false)
    }
    let size: u32 = int.narrow(12 + 2 + rec.len)
    let w = leg_writer(mut p, now, si, size, None, false)?
    let f = rtp.header.Fields(marker: rec.marker, pt: rpt, seq: p.tracks[t].rtx_seq, ts: ts, ssrc: p.tracks[t].rtx_ssrc)
    let head = rtp.ext.write_header(f, view w, mut p.pkt) ?=> |take x| Rtp(x)
    list.push(mut p.pkt, int.truncate(index >> 8))
    list.push(mut p.pkt, int.truncate(index))
    put_payload(mut p, head + 2, payload, rec.from, rec.len, rec.picture, rec.tl0)?
    p.tracks[t].rtx_seq = int.wrapping_add(p.tracks[t].rtx_seq, 1u16)
    seal_out(mut p, rec.src, mut out)?
    Ok(true)
}

/// Present one source packet to a down-track (RTC-5 fan-out step 2). The track's
/// `Rewrite` decides: `Forward` goes out on the media SSRC in the subscriber's wire
/// identity; `Late` goes out at once as an RFC 4588 repair on the RTX SSRC, or is
/// dropped and counted when the leg negotiated no RTX; `Drop` and `Wait` send nothing.
pub fn forward(mut p: PeerSession, now: u64, track: u16, leg: Leg, payload: Bytes, mut out: Outbox) -> Result[Sent, PeerError] {
    if p.closed {
        return Error(Closed)
    }
    let t: u64 = int.widen(track)
    if t >= list.len(p.tracks) {
        return Error(Sdp(AnswerMismatch(0)))
    }
    let decision = rtp.rewrite.on_packet(mut p.tracks[t].rewrite, leg.source, leg.index, leg.ts, now, leg.padding_only, leg.unit)
    // A new switch gates the history: a NACK from before it answers nothing.
    let switch = rtp.rewrite.switch_index(p.tracks[t].rewrite)
    if switch != p.tracks[t].gated {
        if let Some(i) = switch {
            rtp.history.gate(mut p.tracks[t].history, i)
        }
        p.tracks[t].gated = switch
    }
    let (index, ts, late) = match decision {
        Forward(i, w) => (i, w, false),
        Late(i, w) => (i, w, true),
        _ => return Ok(Held),
    }
    let si: u64 = int.widen(p.tracks[t].section)
    let Some(pt) = send_pt(p.sections[si].agreed, leg.codec) else {
        p.drops.format += 1
        return Ok(Dropped)
    }
    let (picture, tl0) = descriptor(mut p, t, leg, payload)
    let rec = Record(src: leg.src, handle: leg.handle, from: leg.from, len: leg.len, ts: ts, marker: leg.marker, pt: pt, picture: picture, tl0: tl0)
    if late {
        if !write_rtx(mut p, now, t, index, ts, rec, payload, mut out)? {
            p.drops.late += 1
            return Ok(Dropped)
        }
        if p.tracks[t].video {
            drop(rtp.history.put(mut p.tracks[t].history, index, now, rec))
        }
        return Ok(AsRepair)
    }
    let size: u32 = int.narrow(12 + leg.len)
    let w = leg_writer(mut p, now, si, size, leg.level, leg.voice)?
    let f = rtp.header.Fields(marker: leg.marker, pt: pt, seq: int.truncate(index), ts: ts, ssrc: p.tracks[t].ssrc)
    let head = rtp.ext.write_header(f, view w, mut p.pkt) ?=> |take x| Rtp(x)
    put_payload(mut p, head, payload, leg.from, leg.len, picture, tl0)?
    seal_out(mut p, leg.src, mut out)?
    p.tracks[t].highest = index
    p.tracks[t].src = Some(leg.src)
    rtp.stats.on_sent(mut p.tracks[t].sent, leg.len)
    if p.tracks[t].video {
        drop(rtp.history.put(mut p.tracks[t].history, index, now, rec))
    }
    Ok(OnMedia)
}

/// Answer a `RepairAsk` with the plaintext its handle names, rebuilt from the
/// recorded output rewrite, never from the track's current state.
pub fn resend(mut p: PeerSession, now: u64, ask: RepairAsk, payload: Bytes, mut out: Outbox) -> Result[bool, PeerError] {
    let t: u64 = int.widen(ask.track)
    if p.closed || t >= list.len(p.tracks) {
        return Ok(false)
    }
    let rec: Record = match rtp.history.entry(p.tracks[t].history, ask.index) {
        Some(r) => r,
        None => return Ok(false),
    }
    if rec.src != ask.src || rec.handle != ask.handle {
        return Ok(false)
    }
    write_rtx(mut p, now, t, ask.index, rec.ts, rec, payload, mut out)
}

/// Send the publisher of one inbound stream a keyframe request the router chose
/// (RTC-6): a PLI or a FIR with its command sequence number.
pub fn request_keyframe(mut p: PeerSession, ssrc: u32, req: rtp.loss.Request, mut out: Outbox) -> Result[(), PeerError] {
    // RR 8, CNAME chunk up to 264, FIR 20 and the SRTCP trailer 14 (RFC 3711 section 3.4).
    let mut b: Bytes = list.with_capacity(320)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = rtp.rtcp.write_rr(p.control, view empty, mut b)
    let _ = rtp.rtcp.write_cname(p.control, p.cname, mut b)
    match req {
        Pli => {
            let _ = rtp.rtcp.write_pli(p.control, ssrc, mut b)
        },
        Fir(n) => {
            let _ = rtp.rtcp.write_fir(p.control, ssrc, n, mut b)
        },
    }
    seal_rtcp_out(mut p, mut b, mut out)
}

/// The round-trip estimate of this session (RFC 3550 section 6.4.1, from RR blocks).
pub fn round_trip(p: PeerSession) -> Option[u64] {
    p.rtt
}

fn seal_rtcp_out(mut p: PeerSession, mut b: Bytes, mut out: Outbox) -> Result[(), PeerError] {
    let Some(to) = p.path else {
        return Ok(())
    }
    let tag = own_tag(p)
    if !connected(p) {
        return Ok(())
    }
    seal(mut p, true, mut b)?
    queue(mut out, to, b, tag)
}

// ---- Time ----
// NTP time for reports: the session clock in 32.32 fixed point.
fn ntp(now: u64) -> u64 {
    let secs = now / 1000000000
    let frac = ((now % 1000000000) << 32) / 1000000000
    (secs << 32) | frac
}

fn reports(mut p: PeerSession, now: u64, mut out: Outbox) -> Result[(), PeerError] {
    // One SR per down-track, under that track's SSRC and its own counts.
    for t in 0u64 .. list.len(p.tracks) {
        if p.tracks[t].highest == EMPTY {
            continue
        }
        let Some(ts) = rtp.rewrite.sr_timestamp(mut p.tracks[t].rewrite, now) else {
            continue
        }
        let ssrc = p.tracks[t].ssrc
        let info = rtp.stats.sender_info(p.tracks[t].sent, ssrc, ntp(now), ts)
        let mut b: Bytes = list.with_capacity(128)
        let empty: List[rtp.rtcp.Block] = list.new()
        let _ = rtp.rtcp.write_sr(info, view empty, mut b)
        let _ = rtp.rtcp.write_cname(ssrc, p.cname, mut b)
        seal_rtcp_out(mut p, mut b, mut out)?
    }
    let mut blocks: List[rtp.rtcp.Block] = list.new()
    for i in 0u64 .. list.len(p.inbound) {
        if !p.inbound[i].repair && list.len(blocks) < 31 {
            let ssrc = p.inbound[i].ssrc
            list.push(mut blocks, rtp.stats.report(mut p.inbound[i].stats, ssrc, now))
        }
    }
    if list.len(blocks) != 0 {
        let mut b: Bytes = list.with_capacity(1024)
        let _ = rtp.rtcp.write_rr(p.control, view blocks, mut b)
        let _ = rtp.rtcp.write_cname(p.control, p.cname, mut b)
        seal_rtcp_out(mut p, mut b, mut out)?
    }
    Ok(())
}

fn feedback(mut p: PeerSession, now: u64, mut out: Outbox) -> Result[(), PeerError] {
    let mut b: Bytes = list.with_capacity(1200)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = rtp.rtcp.write_rr(p.control, view empty, mut b)
    let _ = rtp.rtcp.write_cname(p.control, p.cname, mut b)
    let prefix = list.len(b)
    let rtt = p.rtt
    for i in 0u64 .. list.len(p.inbound) {
        let ssrc = p.inbound[i].ssrc
        let mut pairs: List[(u16, u16)] = list.with_capacity(int.widen(MAX_NACK_PAIRS))
        if p.inbound[i].nack {
            let _ = rtp.loss.due(mut p.inbound[i].losses, now, rtt, MAX_NACK_PAIRS, mut pairs)
        }
        if list.len(pairs) != 0 {
            let _ = rtp.rtcp.write_nack(p.control, ssrc, view pairs, mut b)
        }
    }
    let media = match list.get(p.inbound, 0) {
        Some(i) => i.ssrc,
        None => 0,
    }
    let _ = rtp.twcc.write(mut p.recv_log, p.control, media, 1000, mut b)
    if list.len(b) > prefix {
        seal_rtcp_out(mut p, mut b, mut out)?
    }
    Ok(())
}

pub fn poll(mut p: PeerSession, now: u64, mut out: Outbox) -> Poll {
    if p.closed {
        return Idle
    }
    let before = list.len(out.pkts)
    let dtls_wake = match flush_dtls(mut p, now, mut out) {
        Ok(w) => w,
        Error(_) => None,
    }
    if let Error(_) = start_srtp(mut p) {
        return Idle
    }
    if connected(p) {
        if now >= p.next_report {
            let _ = reports(mut p, now, mut out)
            p.next_report = now + REPORT_NS
        }
        if now >= p.next_feedback {
            let _ = feedback(mut p, now, mut out)
            p.next_feedback = now + FEEDBACK_NS
        }
    }
    if list.len(out.pkts) > before {
        return Transmit
    }
    let mut wake: Option[u64] = dtls_wake
    if connected(p) {
        let next = if p.next_report < p.next_feedback {
            p.next_report
        } else {
            p.next_feedback
        }
        wake = match wake {
            Some(w) if w < next => Some(w),
            _ => Some(next),
        }
    }
    match wake {
        Some(w) => WakeAt(w),
        None => Idle,
    }
}

/// Install a renegotiated agreement. Bindings of sections no longer receiving go.
pub fn renegotiated(mut p: PeerSession, agreed: sdp.Negotiated) -> Result[(), PeerError] {
    if p.closed {
        return Error(Closed)
    }
    let sections = build_sections(agreed, p.limits)?
    p.sections = take sections
    p.agreed = clone(agreed)
    let mut kept: List[Inbound] = list.new()
    let old = replace(mut p.inbound, list.new())
    for take i in take old {
        let si: u64 = int.widen(i.section)
        if si < list.len(p.sections) && p.sections[si].agreed.recv {
            list.push(mut kept, take i)
        }
    }
    p.inbound = take kept
    Ok(())
}

/// Erase the session. With `notify` (an ordinary leave), a DTLS close_notify is
/// appended; a revoke sends nothing.
pub fn close(take p: PeerSession, notify: bool, mut out: Outbox) {
    let mut s = take p
    if notify {
        if let Some(to) = s.path {
            let tag = own_tag(s)
            if let Some(take held) = replace(mut s.dtls, None) {
                let mut e = take held
                let mut d: Bytes = list.with_capacity(SLOT)
                if let Ok(_) = dtls.close(mut e, mut d) {
                    let _ = queue(mut out, to, d, tag)
                }
            }
        }
    }
    s.closed = true
    drop(take s)
}

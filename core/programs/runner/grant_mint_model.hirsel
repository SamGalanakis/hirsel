// A std.model of the place's grant mints (RUNNER-SPEC v2.69 CHANGES F1, F3 and F5,
// v2.70 F4 and F5, and §12.1 "Mint tasks"), with v2.67's single grant task (CHANGES-v2.67 item 1) as
// the variant that must fail.
//
// Each request is one use's ask for a G: a trigger attempt that came due, a wire call
// to a listed granted entry, a keyed claim's pre-authentication mint, or a bind
// (v2.70), the two unauthenticated requests. Each use's requests arrive in their own order, and the
// uses interleave freely. A minted G stays charged to the mint task that made it
// until its call, attempt or claim ends (MEM-20). Every G here costs one unit.
//
// v2.69 and v2.70: one mint task per use, each with its own queue and `bytes`. A mint never
// waits, and runs as `isolate` around `bound steps`, so a fault is `Raised` and a
// step overrun `OutOfTime` for that request alone, and the task keeps serving.
// v2.67: one grant task owns the seed, runs every mint from one queue in arrival
// order, so a waiting mint delays the next one, and charges every G to one `bytes`.
// Claims mint from `call` (item 4), and there is no bind mint. Its mint runs outside `isolate`, so a fault ends
// the task (v2.69 F1(b)). v2.67 states no step bound, so its runs use no looping mint.
//
// A mint asked to Refuse returns Error(c) with room left in its own allowance (RUNNER-SPEC
// v2.71 §12.1 "Mint tasks", Outcomes, line 2153: "`Error(c)` from the mint, or an allocation
// refused by the mint's `mint_bytes`, fails that request with `Failed(OutOfBytes(room))`
// ... The mint task keeps serving the next request"). So it fails its own request as
// OutOfBytes, takes no room, and its task goes on. Its asker sees what a full allowance
// gives: a wire call `Failed(OutOfBytes)` with no body run, and a bind Close 1013 with no
// binding run (v2.70 F5, line 58; v2.71 B4, line 37; §3 "Binding", line 1418: each bind
// first asks the bind mint, and a failed bind mint is not a credential failure).
type Use: key = Attempt | Call | Claim | Bind

type Ask: key = Plain | Faults | Loops | Refuses

type Cause: key = OutOfBytes | Raised | OutOfTime

type Phase: key = Unsent | Queued | Minting | Holding | Ended | Failed(Cause)

type Request: key {
    use: Use,
    ask: Ask,
    phase: Phase
}

type MintTask: key {
    queue: List[u64],
    busy: Option[u64],
    serving: bool,
    room: u64,
    held: u64
}

type Place: key {
    shared: bool,
    own_bytes: List[u64],
    requests: List[Request],
    tasks: List[MintTask]
}

type GrantAction: key = Open | Arrive(u64) | Mint(u64) | Resolve(u64) | Finish(u64)

fn use_index(u: Use) -> u64 {
    match u {
        Attempt => 0,
        Call => 1,
        Claim => 2,
        Bind => 3,
    }
}

fn task_of(p: Place, u: Use) -> u64 {
    if p.shared {
        0
    } else {
        use_index(u)
    }
}

fn mint_task(room: u64) -> MintTask {
    MintTask(queue: list.new(), busy: None, serving: true, room: room, held: 0)
}

fn add_requests(mut requests: List[Request], u: Use, asks: List[Ask]) {
    for ask in asks {
        list.push(mut requests, Request(use: u, ask: ask, phase: Unsent))
    }
}

// own_bytes is (attempt, call, claim, bind). v2.67's one allowance is their sum, so
// both variants have the same total room.
fn place(shared: bool, own_bytes: List[u64], attempts: List[Ask], calls: List[Ask], claims: List[Ask], binds: List[Ask]) -> Place {
    let mut requests: List[Request] = list.new()
    add_requests(mut requests, Attempt, attempts)
    add_requests(mut requests, Call, calls)
    add_requests(mut requests, Claim, claims)
    add_requests(mut requests, Bind, binds)
    let mut tasks: List[MintTask] = list.new()
    if shared {
        list.push(mut tasks, mint_task(own_bytes[0] + own_bytes[1] + own_bytes[2] + own_bytes[3]))
    } else {
        for room in own_bytes {
            list.push(mut tasks, mint_task(room))
        }
    }
    Place(shared: shared, own_bytes: clone(own_bytes), requests: take requests, tasks: take tasks)
}

fn first_unsent(p: Place, i: u64) -> bool {
    let r = view p.requests[i]
    if r.phase != Unsent {
        return false
    }
    for j in 0 .. i {
        if p.requests[j].use == r.use && p.requests[j].phase == Unsent {
            return false
        }
    }
    true
}

fn grant_actions(p: Place, mut out: List[GrantAction]) {
    for i in 0 .. list.len(p.requests) {
        if first_unsent(p, i) {
            list.push(mut out, Arrive(i))
        }
        if p.requests[i].phase == Holding {
            list.push(mut out, Finish(i))
        }
    }
    for t in 0 .. list.len(p.tasks) {
        let task = view p.tasks[t]
        match task.busy {
            Some(_) => list.push(mut out, Resolve(t)),
            None => {
                if task.serving && list.len(task.queue) > 0 {
                    list.push(mut out, Mint(t))
                }
            },
        }
    }
}

fn resolve(mut p: Place, t: u64, i: u64) {
    match p.requests[i].ask {
        Faults => {
            p.requests[i].phase = Failed(Raised)
            if p.shared {
                p.tasks[t].serving = false
            }
        },
        Loops => {
            p.requests[i].phase = Failed(OutOfTime)
        },
        Refuses => {
            p.requests[i].phase = Failed(OutOfBytes)
        },
        Plain => {
            if p.tasks[t].held + 1 > p.tasks[t].room {
                p.requests[i].phase = Failed(OutOfBytes)
            } else {
                p.tasks[t].held += 1
                p.requests[i].phase = Holding
            }
        },
    }
}

fn grant_step(p: Place, action: GrantAction) -> Place {
    let mut next: Place = clone(p)
    match action {
        Open => {},
        Arrive(i) => {
            let t = task_of(next, next.requests[i].use)
            next.requests[i].phase = Queued
            list.push(mut next.tasks[t].queue, i)
        },
        Mint(t) => {
            let i = list.remove(mut next.tasks[t].queue, 0)
            if next.shared {
                next.tasks[t].busy = Some(i)
                next.requests[i].phase = Minting
            } else {
                resolve(mut next, t, i)
            }
        },
        Resolve(t) => {
            let Some(i) = next.tasks[t].busy else {
                fail("grant model: resolve with no mint")
            }
            next.tasks[t].busy = None
            resolve(mut next, t, i)
        },
        Finish(i) => {
            let t = task_of(next, next.requests[i].use)
            next.requests[i].phase = Ended
            next.tasks[t].held -= 1
        },
    }
    take next
}

fn settled(p: Place) -> bool {
    for r in p.requests {
        match r.phase {
            Ended => {},
            Failed(_) => {},
            _ => return false,
        }
    }
    true
}

fn newly_failed(prev: Place, next: Place, i: u64) -> Option[Cause] {
    if let Failed(_) = prev.requests[i].phase {
        return None
    }
    match next.requests[i].phase {
        Failed(cause) => Some(cause),
        _ => None,
    }
}

// F1/F3: a fault, step overrun or refusal fails its own request, and its mint task keeps
// serving the requests queued behind it.
fn fault_contained(prev: Place, action: GrantAction, next: Place) -> bool {
    for t in 0 .. list.len(prev.tasks) {
        if prev.tasks[t].serving && !next.tasks[t].serving {
            return false
        }
    }
    for i in 0 .. list.len(next.requests) {
        let own = match newly_failed(prev, next, i) {
            None => true,
            Some(Raised) => next.requests[i].ask == Faults,
            Some(OutOfTime) => next.requests[i].ask == Loops,
            Some(OutOfBytes) => next.requests[i].ask == Plain || next.requests[i].ask == Refuses,
        }
        if !own {
            return false
        }
    }
    true
}

fn holding(p: Place, u: Use) -> u64 {
    let mut count: u64 = 0
    for r in p.requests {
        if r.use == u && r.phase == Holding {
            count += 1
        }
    }
    count
}

// F1/F3: a due attempt never queues behind a call or claim, never waits on their
// mint, and is refused for bytes only when attempts' own allowance is full or its own
// mint returned Error(c).
fn attempt_unblocked(prev: Place, action: GrantAction, next: Place) -> bool {
    for task in next.tasks {
        if let Some(i) = task.busy {
            if next.requests[i].use != Attempt && list.any(task.queue, scoped fn(j: u64) -> bool {
                next.requests[j].use == Attempt
            }) {
                return false
            }
        }
        let mut other_ahead = false
        for j in task.queue {
            if next.requests[j].use != Attempt {
                other_ahead = true
            } else if other_ahead {
                return false
            }
        }
    }
    for i in 0 .. list.len(next.requests) {
        if next.requests[i].use == Attempt {
            if let Some(OutOfBytes) = newly_failed(prev, next, i) {
                if next.requests[i].ask == Plain && holding(prev, Attempt) < next.own_bytes[0] {
                    return false
                }
            }
        }
    }
    true
}

fn attempt_while_calls_saturate(p: Place) -> bool {
    holding(p, Attempt) > 0 && holding(p, Call) == p.own_bytes[1]
}

fn call_out_of_own_bytes(p: Place) -> bool {
    for r in p.requests {
        if r.use == Call && r.ask == Plain && r.phase == Failed(OutOfBytes) {
            return true
        }
    }
    false
}

fn served_after_contained_failure(p: Place) -> bool {
    for i in 0 .. list.len(p.requests) {
        let contained = match p.requests[i].phase {
            Failed(Raised) => true,
            Failed(OutOfTime) => true,
            _ => false,
        }
        if contained {
            for j in i + 1 .. list.len(p.requests) {
                if p.requests[j].use == p.requests[i].use && p.requests[j].phase == Holding {
                    return true
                }
            }
        }
    }
    false
}

// A mint that returned Error(c) with room left, and a later request of its use served.
fn served_after_refusal(p: Place) -> bool {
    for i in 0 .. list.len(p.requests) {
        if p.requests[i].ask == Refuses && p.requests[i].phase == Failed(OutOfBytes) {
            for j in i + 1 .. list.len(p.requests) {
                if p.requests[j].use == p.requests[i].use && p.requests[j].phase == Holding {
                    return true
                }
            }
        }
    }
    false
}

fn show_grant(action: GrantAction, mut out: String) {
    let (name, n) = match action {
        Open => return string.push(mut out, "open"),
        Arrive(i) => ("arrive ", i),
        Mint(t) => ("mint ", t),
        Resolve(t) => ("resolve ", t),
        Finish(i) => ("finish ", i),
    }
    string.push(mut out, name)
    string.push_u64(mut out, n)
}

type Law = Contained | Unblocked

fn grant_model(take start: Place, laws: List[Law]) -> std.model.Model[Place, GrantAction] {
    let mut init: List[Place] = list.new()
    list.push(mut init, take start)
    let mut always: List[std.model.Always[Place, GrantAction]] = list.new()
    for law in laws {
        match law {
            Contained => list.push(mut always, std.model.Always(label: string.from("mint_fault_fails_only_its_own_request"), holds: fault_contained)),
            Unblocked => list.push(mut always, std.model.Always(label: string.from("due_attempt_never_blocked_by_call"), holds: attempt_unblocked)),
        }
    }
    let mut sometimes: List[std.model.Sometimes[Place]] = list.new()
    list.push(mut sometimes, std.model.Sometimes(label: string.from("attempt_runs_while_calls_saturate"), holds: attempt_while_calls_saturate))
    list.push(mut sometimes, std.model.Sometimes(label: string.from("call_out_of_own_bytes"), holds: call_out_of_own_bytes))
    list.push(mut sometimes, std.model.Sometimes(label: string.from("served_after_contained_failure"), holds: served_after_contained_failure))
    list.push(mut sometimes, std.model.Sometimes(label: string.from("served_after_refusal"), holds: served_after_refusal))
    std.model.Model(
        init: take init,
        start: Open,
        actions: grant_actions,
        step: grant_step,
        done: settled,
        always: take always,
        sometimes: take sometimes,
        sometimes_step: list.new(),
        show: show_grant,
    )
}

fn grant_bounds() -> std.model.Bounds {
    std.model.Bounds(depth: 64, states: 200000, step_steps: 100000, step_bytes: 1048576)
}

fn all_laws() -> List[Law] {
    let mut laws: List[Law] = list.new()
    list.push(mut laws, Contained)
    list.push(mut laws, Unblocked)
    take laws
}

// Trace conformance (lane 2563): the mints a built place's law saw, checked against this
// model with std.model.conforms.
//
// A law logs, in the order it saw them: each mode token it sent a mint (kind, then 1 to
// raise, 2 to loop, 3 to return Error(Capacity)); each mint's start record,
// kind * 100 + serial, with kind 1 for call, 2 for attempt and 3 for bind; and what that
// mint's asker then saw. The asks come from the tokens, which are the law's input, and the
// observations from the build.
//
// A mint's resolution is observed as (use, serial, what its asker saw), and the end of a
// served call or bind as SawDrop. Arrivals and the end of an attempt are internal: no law
// sees them. Every use's room is its request count, so no allowance is ever full, as in
// the laws, whose mint_bytes hold every G they mint.
//
// Token 3 is the Refuses ask, so every mint a law starts is in the walk.
pub type Saw: key = SawG | SawNoBytes | SawFault | SawSteps | SawClosed | SawDrop | SawOther

pub type MintEvent = MintMode(u64, u64) | MintStart(u64) | MintAnswer(u64, Saw)

type Step: key = Inside | MintStep | EndStep

type Record: key {
    use: Use,
    serial: u64,
    saw: Saw
}

fn serial_of(p: Place, i: u64) -> u64 {
    let mut n: u64 = 1
    for j in 0 .. i {
        if p.requests[j].use == p.requests[i].use {
            n += 1
        }
    }
    n
}

// A failed bind mint closes its Hello 1013 whatever the cause (v2.70 F5).
fn seen_mint(next: Place, i: u64) -> Option[Record] {
    let saw = match next.requests[i].phase {
        Holding => SawG,
        Failed(cause) => if next.requests[i].use == Bind {
            SawClosed
        } else {
            match cause {
                OutOfBytes => SawNoBytes,
                Raised => SawFault,
                OutOfTime => SawSteps,
            }
        },
        _ => return None,
    }
    Some(Record(use: next.requests[i].use, serial: serial_of(next, i), saw: saw))
}

fn observe_grant(prev: Place, action: GrantAction, next: Place) -> Option[Record] {
    match action {
        Mint(t) => seen_mint(next, prev.tasks[t].queue[0]),
        Resolve(t) => match prev.tasks[t].busy {
            Some(i) => seen_mint(next, i),
            None => None,
        },
        Finish(i) => if next.requests[i].use == Attempt {
            None
        } else {
            Some(Record(use: next.requests[i].use, serial: serial_of(next, i), saw: SawDrop))
        },
        _ => None,
    }
}

fn step_of(action: GrantAction) -> Step {
    match action {
        Mint(_) => MintStep,
        Resolve(_) => MintStep,
        Finish(_) => EndStep,
        _ => Inside,
    }
}

fn show_record(hint: Step, seen: Record, mut out: String) {
    string.push(mut out, match seen.use {
        Attempt => "attempt ",
        Call => "call ",
        Claim => "claim ",
        Bind => "bind ",
    })
    string.push_u64(mut out, seen.serial)
    string.push(mut out, match seen.saw {
        SawG => " served",
        SawNoBytes => " out of bytes",
        SawFault => " raised",
        SawSteps => " out of time",
        SawClosed => " closed 1013",
        SawDrop => " ended",
        SawOther => " answered otherwise",
    })
}

fn grant_boundary() -> std.model.Boundary[Place, GrantAction, Step, Record] {
    std.model.Boundary(label: step_of, observe: observe_grant, show: show_record)
}

fn kind_use(kind: u64) -> Use {
    match kind {
        1 => Call,
        2 => Attempt,
        3 => Bind,
        _ => fail("grant model: a mint record names no kind"),
    }
}

fn answer_for(events: List[MintEvent], record: u64) -> Saw {
    for event in events {
        if let MintAnswer(r, saw) = event {
            if r == record {
                return saw
            }
        }
    }
    SawOther
}

fn next_mode(mut modes: List[u64]) -> u64 {
    if list.len(modes) == 0 {
        0
    } else {
        list.remove(mut modes, 0)
    }
}

type MintCase {
    start: Place,
    trace: List[std.model.Seen[Step, Record]]
}

// modes and asks are indexed by kind - 1: call, attempt, bind.
fn mint_case(shared: bool, events: List[MintEvent]) -> MintCase {
    let mut modes: List[List[u64]] = list.new()
    let mut asks: List[List[Ask]] = list.new()
    for _ in 0u64 .. 3u64 {
        list.push(mut modes, list.new())
        list.push(mut asks, list.new())
    }
    let mut trace: List[std.model.Seen[Step, Record]] = list.new()
    for event in events {
        match event {
            MintMode(kind, mode) => {
                let _ = kind_use(kind)
                list.push(mut modes[kind - 1], mode)
            },
            MintStart(record) => {
                let kind = record / 100
                let u = kind_use(kind)
                list.push(mut asks[kind - 1], match next_mode(mut modes[kind - 1]) {
                    1 => Faults,
                    2 => Loops,
                    3 => Refuses,
                    _ => Plain,
                })
                list.push(mut trace, std.model.Seen(hint: MintStep, seen: Record(use: u, serial: record % 100, saw: answer_for(events, record))))
            },
            MintAnswer(record, saw) => {
                if saw == SawG && record / 100 != 2 {
                    list.push(mut trace, std.model.Seen(hint: EndStep, seen: Record(use: kind_use(record / 100), serial: record % 100, saw: SawDrop)))
                }
            },
        }
    }
    let mut rooms: List[u64] = list.new()
    list.push(mut rooms, order.max(list.len(asks[1]), 1))
    list.push(mut rooms, order.max(list.len(asks[0]), 1))
    list.push(mut rooms, 1u64)
    list.push(mut rooms, order.max(list.len(asks[2]), 1))
    MintCase(start: place(shared, rooms, clone(asks[1]), clone(asks[0]), list.new(), clone(asks[2])), trace: take trace)
}

/// Checks a law's mint log against the per-use mints.
pub fn check_mints(events: List[MintEvent]) -> Result[(), ()] {
    let MintCase(start: take start, trace: take trace) = mint_case(false, events)
    std.model.conforms_check(grant_model(take start, all_laws()), grant_bounds(), grant_boundary(), trace)
}

pub const KEYED_OP_RECORD_MAX: u64 = txn.KEYED_OP_RECORD_MAX

pub const CLAIM_DONE_MAX: u64 = format.CLAIM_DONE_MAX

pub type ClaimKey: shareable + send {
    op: Bytes,
    caller: Caller,
    key: Bytes
}

pub type KeyedPolicy: codec + shareable + send {
    retention_ms: u64,
    keys_max: u64,
    principal_keys_max: u64,
    arg_max: u64,
    call_record_max: u64,
    record: Bytes
}

type ClaimRow {
    digest: RequestDigest,
    expiry: u64,
    replied: bool
}

pub type ClaimAdmission = Accepted(ClaimCompletion) | Ownerless(ClaimCompletion) | Duplicate(Bytes) | Mismatch | MissingClaim

pub opaque type ClaimCompletion {
    ticket: Ticket,
    key: Bytes,
    request: RequestDigest,
    policy: KeyedPolicy,
    admitted_width: u64
}

pub fn claim_ticket(completion: ClaimCompletion) -> Ticket {
    completion.ticket
}

pub fn claim_key_bytes(key: ClaimKey) -> Result[Bytes, Error] {
    let address = claim_address(key)?
    let txn.ClaimAddress(full: take full, ..) = take address
    Ok(take full)
}

/// The stored horizon for a replied claim, including the NEVER sentinel.
pub fn claim_reply_expiry(db: Db, address: Bytes) -> Result[Option[u64], Error] {
    let Some(raw) = pages.keyed_lookup(pages.holder_heads(db.holders)[0u64].roots.keyed, format.CLAIMS, address) else {
        return Ok(None)
    }
    let row = claim_parse(raw)?
    Ok(if row.replied {
        Some(row.expiry)
    } else {
        None
    })
}

fn claim_address(key: ClaimKey) -> Result[txn.ClaimAddress, Error] {
    let len = list.len(key.key)
    if len == 0 || len > 255 {
        return Error(Limit(Key))
    }
    for byte in key.key {
        if byte < 0x21 || byte > 0x7e {
            return Error(Limit(Key))
        }
    }
    let op = failure_result_from_rep(txn.op_claim_key(key.op))?
    let mut principal = failure_result_from_rep(types.copied(op))?
    failure_result_from_rep(types.capacity(caller_key(key.caller, mut principal)))?
    let mut full = failure_result_from_rep(types.copied(principal))?
    list.push(mut full, int.narrow(len))
    list.append(mut full, key.key)
    Ok(txn.ClaimAddress(op: take op, principal: take principal, full: take full))
}

fn claim_parse(raw: Bytes) -> Result[ClaimRow, Error] {
    let width = list.len(raw)
    if width < 41 {
        return Error(failure_from_rep(pages.malformed(0)))
    }
    let expiry: u64 = list.word_le(raw, 33)
    if (raw[0u64] == 1 && expiry != 0) || (raw[0u64] == 2 && expiry == 0) || (raw[0u64] != 1 && raw[0u64] != 2) {
        return Error(failure_from_rep(pages.malformed(0)))
    }
    let mut digest_bytes: Inline[u8, 32] =[0u8; 32]
    for i in 0u64 .. 32u64 {
        digest_bytes[i] = raw[1 + i]
    }
    Ok(ClaimRow(digest: RequestDigest(b: take digest_bytes), expiry: expiry, replied: raw[0u64] == 2))
}

fn claim_value(digest: RequestDigest, expiry: u64, payload: Bytes) -> Bytes {
    let replied = expiry != 0
    let header = 41u64
    let mut raw: Bytes = list.with_capacity(header + list.len(payload))
    list.push(mut raw, if replied {
        2u8
    } else {
        1u8
    })
    for byte in digest.b {
        list.push(mut raw, byte)
    }
    list.put_word_le(mut raw, expiry)
    list.append(mut raw, payload)
    take raw
}

fn keyed_policy_bytes(policy: KeyedPolicy) -> Result[Bytes, Error] {
    let codec: std.codec.Codec[KeyedPolicy] = std.codec.of()
    let mut raw: Bytes = list.new()
    std.codec.encode(codec, policy, mut raw) ?=> |_| Limit(Value)
    if list.len(raw) > KEYED_OP_RECORD_MAX {
        return Error(Limit(Value))
    }
    Ok(take raw)
}

pub fn check_keyed_policy(policy: KeyedPolicy) -> Result[(), Error] {
    if policy.retention_ms == 0 || policy.retention_ms > 9007199254740992 || policy.principal_keys_max == 0 || policy.principal_keys_max > policy.keys_max || policy.call_record_max > FRAME_LIMIT || policy.arg_max > types.FORMAT_VALUE_MAX - 41 || terminal_frame_credit(policy) > FRAME_LIMIT {
        return Error(Limit(Value))
    }
    let _ = keyed_policy_bytes(policy)?
    Ok(())
}

fn read_keyed_policy(raw: Bytes) -> Result[KeyedPolicy, Error] {
    let codec: std.codec.Codec[KeyedPolicy] = std.codec.of()
    failure_result_from_rep(catalog.decoded(std.codec.decode(codec, raw)))
}

pub fn keyed_policy(db: Db, op: Bytes) -> Result[Option[KeyedPolicy], Error] {
    let name = failure_result_from_rep(txn.op_claim_key(op))?
    match pages.keyed_lookup(pages.holder_heads(db.holders)[0u64].roots.keyed, txn.KEYED_OPS, name) {
        Some(raw) => Ok(Some(read_keyed_policy(raw)?)),
        None => Ok(None),
    }
}

fn terminal_frame_credit(policy: KeyedPolicy) -> u64 {
    // Frame and commit headers, keyed-section header, four edits, and call.
    37 + 5 + (10 + 387 + 41 + CLAIM_DONE_MAX) + (10 + 460) + (10 + 526) + (6 + 387) + policy.call_record_max
}

fn claim_terminal_credit(ceiling: u64, policy: KeyedPolicy, admitted_width: u64) -> format.KeyedCredit {
    let frame = terminal_frame_credit(policy)
    let maximum_row = order.max(41 + policy.arg_max, 41 + CLAIM_DONE_MAX)
    let padding = format.round8(maximum_row) - format.round8(admitted_width)
    let retained = 4 * (6 * txn.keyed_page_height(ceiling) + 2) * 32768
    format.KeyedCredit(resident: 526 + 590 + frame + retained, padding: padding, journal: frame)
}

fn stage_claim_admit(mut tx: Tx, address: txn.ClaimAddress, d: RequestDigest, args: Bytes, policy: KeyedPolicy, credit: format.KeyedCredit) -> Result[(), Error] {
    let mut edits: List[format.KeyedEdit] = list.new()
    if let Some(raw) = pages.keyed_lookup(tx.roots.keyed, format.CLAIMS, address.full) {
        let row = claim_parse(raw)?
        failure_result_from_rep(txn.forget_claim(tx.roots, mut edits, address.full, row.expiry))?
    }
    if txn.claim_count_after(tx.roots, edits, txn.CLAIM_PCOUNT, address.principal) >= policy.principal_keys_max {
        failure_result_from_rep(txn.reclaim_claim_scope(tx.roots, mut edits, txn.CLAIM_PEXP, address.principal, tx.info.at))?
    }
    if txn.claim_count_after(tx.roots, edits, txn.CLAIM_COUNT, address.op) >= policy.keys_max {
        failure_result_from_rep(txn.reclaim_claim_scope(tx.roots, mut edits, txn.CLAIM_EXP, address.op, tx.info.at))?
    }
    let op_count = txn.claim_count_after(tx.roots, edits, txn.CLAIM_COUNT, address.op)
    let principal_count = txn.claim_count_after(tx.roots, edits, txn.CLAIM_PCOUNT, address.principal)
    if principal_count >= policy.principal_keys_max {
        return Error(Full(Resident(Capacity(requested: principal_count + 1, available: policy.principal_keys_max))))
    }
    if op_count >= policy.keys_max {
        return Error(Full(Resident(Capacity(requested: op_count + 1, available: policy.keys_max))))
    }
    if let None = pages.keyed_lookup(tx.roots.keyed, txn.KEYED_OPS, address.op) {
        failure_result_from_rep(txn.append_claim_edit(mut edits, txn.KEYED_OPS, address.op, Some(keyed_policy_bytes(policy)?)))?
    }
    failure_result_from_rep(txn.append_claim_edit(mut edits, format.CLAIMS, address.full, Some(claim_value(d, 0, args))))?
    failure_result_from_rep(txn.append_claim_edit(mut edits, txn.CLAIM_OPEN, address.full, Some(list.new())))?
    failure_result_from_rep(txn.set_claim_count(mut edits, txn.CLAIM_COUNT, address.op, op_count + 1))?
    failure_result_from_rep(txn.set_claim_count(mut edits, txn.CLAIM_PCOUNT, address.principal, principal_count + 1))?
    tx.keyed = Some(format.KeyedDraft(edits: take edits, after: credit))
    Ok(())
}

pub fn admit_claim(mut db: Db, key: ClaimKey, d: RequestDigest, args: Bytes, take supplied: Option[KeyedPolicy]) -> Result[ClaimAdmission, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let at = match supplied {
        Some(_) => keyed_time(db),
        None => pages.holder_heads(db.holders)[0u64].at
    }
    let address = claim_address(key)?
    let stored = keyed_policy(db, key.op)?
    if let Some(raw) = pages.keyed_lookup(pages.holder_heads(db.holders)[0u64].roots.keyed, format.CLAIMS, address.full) {
        let row = claim_parse(raw)?
        if !row.replied || !txn.claim_expired(row.expiry, at) {
            if row.digest != d {
                return Ok(Mismatch)
            }
            if row.replied {
                return Ok(Duplicate(failure_result_from_rep(types.copied(list.slice(raw, 41, list.len(raw))))?))
            }
            let committing = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, pages.holder_heads(db.holders)[0u64].head))
            let Some(take policy) = take stored else {
                return Error(failure_from_rep(pages.malformed(0)))
            }
            let width = list.len(raw)
            return Ok(Ownerless(ClaimCompletion(ticket: committing, key: failure_result_from_rep(types.copied(address.full))?, request: d, policy: take policy, admitted_width: width)))
        }
    }
    let Some(take offered) = take supplied else {
        return Ok(MissingClaim)
    }
    let policy = match take stored {
        Some(take fixed) => take fixed,
        None => take offered
    }
    if policy.retention_ms == 0 || policy.retention_ms > 9007199254740992 || policy.principal_keys_max == 0 || policy.principal_keys_max > policy.keys_max || policy.call_record_max > FRAME_LIMIT || policy.arg_max > types.FORMAT_VALUE_MAX - 41 || list.len(args) > policy.arg_max {
        return Error(Limit(Value))
    }
    let width = 41 + list.len(args)
    let exclusive_credit = claim_terminal_credit(db.accounting.ceiling, policy, width)
    if exclusive_credit.journal > FRAME_LIMIT {
        return Error(Limit(Transaction))
    }
    let after = txn.add_keyed_credit(db.call_streams.keyed_credit, exclusive_credit)
    let keep: Option[fn(Error) -> bool] = None
    let outcome = store_body_at(mut db, 0, at, None, keep, scoped fn(mut tx: Tx) -> Result[(), Error] {
        stage_claim_admit(mut tx, address, d, args, policy, after)
    })?
    let committed_ticket = match take outcome {
        Committed(done) => done.ticket,
        Refused(problem) => return Error(Full(problem)),
        Aborted(Undone(value: take problem, ..)) => return Error(take problem),
        _ => return Error(Missing("claim admission")),
    }
    durable(mut db, committed_ticket)?
    let txn.ClaimAddress(full: take full, ..) = take address
    Ok(Accepted(ClaimCompletion(ticket: committed_ticket, key: take full, request: d, policy: take policy, admitted_width: width)))
}

fn stage_claim_reply(mut tx: Tx, key: Bytes, digest: RequestDigest, retention_ms: u64, reply_bytes: Bytes, credit: format.KeyedCredit, take call: Option[format.KeyedCallSection]) -> Result[(), Error] {
    if list.len(reply_bytes) > CLAIM_DONE_MAX {
        return Error(Limit(Value))
    }
    let op_end = failure_result_from_rep(txn.claim_op_end(key))?
    let principal_end = failure_result_from_rep(txn.claim_principal_end(key, op_end))?
    let expiry = txn.claim_expiry(tx.info.at, retention_ms)
    let mut edits: List[format.KeyedEdit] = list.with_capacity(4)
    list.push(mut edits, format.KeyedEdit(tree: format.CLAIMS, key: failure_result_from_rep(types.copied(key))?, value: Some(claim_value(digest, expiry, reply_bytes)), call: take call))
    failure_result_from_rep(txn.append_claim_edit(mut edits, txn.CLAIM_EXP, failure_result_from_rep(txn.claim_index_key(list.slice(key, 0, op_end), expiry, key))?, Some(list.new())))?
    failure_result_from_rep(txn.append_claim_edit(mut edits, txn.CLAIM_PEXP, failure_result_from_rep(txn.claim_index_key(list.slice(key, 0, principal_end), expiry, key))?, Some(list.new())))?
    failure_result_from_rep(txn.append_claim_edit(mut edits, txn.CLAIM_OPEN, key, None))?
    tx.keyed = Some(format.KeyedDraft(edits: take edits, after: credit))
    Ok(())
}

fn validate_claim_completion(db: Db, completion: ClaimCompletion) -> Result[(), Error] {
    let bound_ticket = completion.ticket
    if !types.same(db.store.hi, db.store.lo, bound_ticket.store.hi, bound_ticket.store.lo) || open_number(db) != bound_ticket.open {
        return Error(Foreign)
    }
    let Some(raw) = pages.keyed_lookup(pages.holder_heads(db.holders)[0u64].roots.keyed, format.CLAIMS, completion.key) else {
        return Error(Missing("claim"))
    }
    let row = claim_parse(raw)?
    if row.replied || row.digest != completion.request {
        return Error(Missing("claim"))
    }
    Ok(())
}

pub fn conclude_claim(mut db: Db, take completion: ClaimCompletion, reply_bytes: Bytes) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    validate_claim_completion(db, completion)?
    let own_credit = claim_terminal_credit(db.accounting.ceiling, completion.policy, completion.admitted_width)
    let after = txn.remove_keyed_credit(db.call_streams.keyed_credit, own_credit)
    let keep: Option[fn(Error) -> bool] = None
    let outcome = store_body_on(mut db, 0, None, keep, scoped fn(mut tx: Tx) -> Result[(), Error] {
        stage_claim_reply(mut tx, completion.key, completion.request, completion.policy.retention_ms, reply_bytes, after, None)
    })?
    match take outcome {
        Committed(done) => {
            durable(mut db, done.ticket)?
            Ok(done.ticket)
        },
        Refused(problem) => Error(Full(problem)),
        Aborted(Undone(value: take problem, ..)) => Error(take problem),
        _ => Error(Missing("claim reply")),
    }
}

fn rebuild_keyed_credit(mut db: Db, uncovered: u64, journal_limit: u64) -> Result[(), Error] {
    let roots = pages.holder_heads(db.holders)[0u64].roots
    if list.len(roots.keyed) == 0 {
        return Ok(())
    }
    let open_slot: u64 = int.widen(txn.CLAIM_OPEN)
    let mut cursor = std.page.cursor_open(roots.keyed[open_slot].root, None, true, false)
    let prefix_bytes: Bytes = list.new()
    let mut credit = format.no_keyed_credit()
    while let Some((take key, _)) = std.page.cursor_next_key(mut cursor, prefix_bytes) {
        let op_end = failure_result_from_rep(txn.claim_op_end(key))?
        let Some(raw_policy) = pages.keyed_lookup(roots.keyed, txn.KEYED_OPS, list.slice(key, 0, op_end)) else {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        let Some(raw_claim) = pages.keyed_lookup(roots.keyed, format.CLAIMS, key) else {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        let policy = read_keyed_policy(raw_policy)?
        credit = txn.add_keyed_credit(credit, claim_terminal_credit(db.accounting.ceiling, policy, list.len(raw_claim)))
    }
    failure_result_from_rep(catalog.over_ceiling(int.saturating_add(db.accounting.resident, int.saturating_add(credit.resident, credit.padding)), db.accounting.ceiling))?
    if let Some(room) = txn.journal_refusal(uncovered, credit.journal, journal_limit) {
        return Error(Full(Journal(room)))
    }
    db.call_streams.keyed_credit = credit
    Ok(())
}

pub type KeyedCallRecord: codec + shareable + send {
    entry: Bytes,
    args: Bytes,
    revision: Option[Bytes],
    code: Bytes
}

type KeyedRun {
    policy: KeyedPolicy,
    admitted_width: u64,
    record: KeyedCallRecord
}

pub fn keyed_completion(take claim: ClaimCompletion, take record: KeyedCallRecord) -> Completion {
    let ClaimCompletion(ticket: admitted, key: take full, request: request, policy: take policy, admitted_width: width) = take claim
    Completion(admitted: admitted, stream: take full, p: 0, request: request, keyed: Some(KeyedRun(policy: take policy, admitted_width: width, record: take record)))
}

fn keyed_completion_credit(db: Db, completion: Completion) -> Option[format.KeyedCredit] {
    let Some(keyed) = view completion.keyed else {
        return None
    }
    let held = claim_terminal_credit(db.accounting.ceiling, keyed.policy, keyed.admitted_width)
    Some(txn.remove_keyed_credit(db.call_streams.keyed_credit, held))
}

fn check_keyed_completion(db: Db, completion: Completion, call_run: KeyedRun) -> Result[(), Error] {
    let Some(raw) = pages.keyed_lookup(pages.holder_heads(db.holders)[0u64].roots.keyed, format.CLAIMS, completion.stream) else {
        return Error(Missing("claim"))
    }
    let row = claim_parse(raw)?
    if row.replied || row.digest != completion.request || request_digest(call_run.record.entry, call_run.record.args) != row.digest || list.slice(raw, 41, list.len(raw)) != call_run.record.args {
        return Error(Missing("claim"))
    }
    if !format.call_code_size(list.len(call_run.record.code)) {
        return Error(Missing("code"))
    }
    if let Some(revision) = call_run.record.revision {
        if list.len(revision) != 32 {
            return Error(Missing("revision"))
        }
    }
    if format.keyed_record_size(call_run.record.entry, call_run.record.args, call_run.record.revision, call_run.record.code, None) + 33 > call_run.policy.call_record_max {
        return Error(Limit(Transaction))
    }
    Ok(())
}

// A ledger service. The ledger's place holds one store of account balances,
// opened once by the place's head, which serves two transaction entries and a
// query. The client calls them through a `db@1` runner: each transact call
// takes the next position of the client's call stream, and the store decides
// each position once, inside the commit, so a call its provider sends again
// returns the outcome recorded for its position instead of running twice.
@serializable
type Opening {
  account: u64,
  cents: u64,
}

@serializable
type Transfer {
  from: u64,
  to: u64,
  cents: u64,
}

fn opens(mut tx: store.Tx, info: store.CallInfo, req: Opening) -> Result[
  u64,
  ledger.Refusal
] {
  ledger.open(mut tx, req.account, req.cents)
}

fn moves(mut tx: store.Tx, info: store.CallInfo, req: Transfer) -> Result[
  ledger.Receipt,
  ledger.Refusal
] {
  ledger.transfer(mut tx, req.from, req.to, req.cents)
}

fn balance(tx: store.Tx, info: store.CallInfo, account: u64) -> Result[
  u64,
  ledger.Refusal
] {
  ledger.balance(tx, account)
}

/// The ledger place's head: it opens the store over the place's `ledger`
/// authority and serves the entries until its host stops.
pub fn head(rt: Io, a: ()) -> Result[(), store.StoreError] {
  let Ok(ledger) = io.authority(rt, "ledger") else {
    return Error(Corrupt("ledger"))
  }
  let Ok(inbox) = io.inbox(rt) else {
    return Error(Corrupt("inbox"))
  }
  let mut s = store.open(ledger, store.default_config())?
  store.serve(
    mut s,
    take inbox,
    [
      store.served_transact(opens),
      store.served_transact(moves),
      store.served_query(balance),
    ]
  )
}

pub type AppError = Grant(GrantError) | Output(OutputError)

type Op = Open(u64, u64) | Move(u64, u64, u64)

fn store_error(e: store.StoreError) -> String {
  match e {
    Storage(_) => "storage",
    Refused(_) => "refused",
    Corrupt(name) => f"corrupt {name}",
    Fenced() => "fenced",
    Closed() => "closed",
    Unsupported(_) => "unsupported",
    NoLevel() => "no such level",
    Foreign() => "foreign",
    InvalidInput() => "invalid input",
  }
}

fn shown(e: RunError[store.TxFailure[ledger.Refusal]]) -> String {
  match e {
    NotRun(_) => "not run",
    InDoubt(_) => "in doubt",
    Failed(Aborted(NoAccount(account))) => f"no account {account}",
    Failed(Aborted(Insufficient(have))) => f"insufficient: {have}",
    Failed(Aborted(Table(_))) => "table error",
    Failed(Storage(s)) => f"commit failed: {store_error(s)}",
    Failed(Unknown(s)) => f"commit unknown: {store_error(s)}",
    Failed(Faulted(f)) => f"transaction faulted: {f.rule}",
    Failed(_) => "not committed",
    Faulted(_) => "faulted",
    Canceled(_) => "canceled",
  }
}

/// One operation as a transact call on the client's stream.
fn perform(ledger: Runner, output: Stdout, op: Op) -> Result[(), AppError] {
  let line = match op {
    Open(account, cents) => match runner.transact(
      ledger,
      opens,
      Opening(account: account, cents: cents)
    ) {
      Ok(opened) => f"opened {account} with {opened}",
      Error(e) => shown(e),
    },
    Move(from, to, cents) => match runner.transact(
      ledger,
      moves,
      Transfer(from: from, to: to, cents: cents)
    ) {
      Ok(r) => f"moved {r.moved} from {r.from} to {r.to}, fee {r.fee}",
      Error(e) => shown(e),
    },
  }
  out.print(output, f"{line}\n") ? Output
  Ok(())
}

/// Opens three accounts, makes four transfers, then queries every balance.
pub fn main(rt: Io, args: Args) -> Result[(), AppError] {
  let output = io.stdout(rt) ? Grant
  let ledger = io.runner(rt, "ledger") ? Grant
  let ops: List[Op] = [
    Open(1, 500),
    Open(2, 100),
    Move(1, 2, 200),
    Open(3, 0),
    Move(2, 3, 50),
    Move(2, 1, 250),
    Move(1, 2, 900),
  ]
  for op in ops {
    perform(ledger, output, op)?
  }
  for account in [1u64, 2, 3, 4] {
    let line = match runner.query(ledger, balance, account) {
      Ok(cents) => f"account {account}: {cents}",
      Error(e) => f"account {account}: {shown(e)}",
    }
    out.print(output, f"{line}\n") ? Output
  }
  Ok(())
}

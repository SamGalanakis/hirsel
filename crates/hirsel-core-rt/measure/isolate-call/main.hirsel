// The standing isolate-call row (MEASUREMENTS.md "Isolate and bound calls"); RUNNER-SPEC section 8's p03, unchanged below.
// RUNNER-SPEC section 8 measurement: the p01 registry moved into a head task that owns it;
// a session sends (key, arg) on a channel and reads the Outcome back (the Inbox shape).
// argv: mode N. mode 0 empty loop, 1 direct function call, 2 registry call in the same
// task, 3 registry call through the head task (two channel hops per call).
pub type Kind: send = Compute | Transact | Query

pub type Refusal: send = NoEntry | Malformed(std.codec.DecodeError) | Overloaded | Deadline | Budget(Capacity)

pub type Fault: send = Raised(u32) | OutOfBytes(Capacity)

pub type Outcome: send = Returned(Bytes) | Failed(Fault) | Refused(Refusal) | Abandoned | InDoubt

pub type Described: send {
    kind: Kind,
    identity: Bytes,
    args_schema: Bytes,
    result_schema: Bytes,
    args: u64,
    result: u64
}

type DecodeFail: send { e: std.codec.DecodeError }

pub type Slot: send {
    run: own[send] fn(Bytes, u64) -> Outcome
}

pub type Registry: send {
    slots: Map[Bytes, Slot],
    described: List[Described]
}

pub fn registry() -> Registry {
    Registry(slots: map.new(), described: list.new())
}

fn cause_number(cs: Causes) -> u32 {
    for c in cs {
        return match c.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity => 7u32,
            OutOfTime => 8u32,
        }
    }
    0u32
}

// The one generic adapter of R13: decode A, call f under a byte budget inside isolate,
// encode R. Capacity anywhere is the call's own refusal or fault, never a failure.
fn adapt[A, R](f: StaticFn[fn(take A) -> Result[R, Capacity]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], arg: Bytes, budget: u64) -> Outcome {
    let body = code.callable(f)
    // Decode inside the domain: the argument is built under the call's budget.
    let ran = bound bytes budget {
        let run = scoped fn() -> Result[Result[R, Capacity], DecodeFail] {
            match std.codec.decode(ca, arg) {
                Ok(Ok(take a)) => Ok(body(take a)),
                Ok(Error(e)) => Error(DecodeFail(e: e)),
                Error(c) => Ok(Error(c)),
            }
        }
        isolate(run)
    }
    match take ran {
        Ok(Ok(Ok(Error(d)))) => Refused(Malformed(d.e)),
        Ok(Ok(Ok(Ok(Ok(take r))))) => {
            let mut out: Bytes = list.new()
            match std.codec.encode(cr, r, mut out) {
                Ok(()) => Returned(take out),
                Error(c) => Failed(OutOfBytes(c)),
            }
        },
        Ok(Ok(Ok(Ok(Error(c))))) => Failed(OutOfBytes(c)),
        Ok(Ok(Error(cs))) => Failed(Raised(cause_number(cs))),
        Ok(Error(c)) => Failed(OutOfBytes(c)),
        Error(c) => Refused(Budget(c)),
    }
}

fn key_of[A, R](f: StaticFn[fn(take A) -> Result[R, Capacity]], ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Result[(Bytes, Described), Capacity] {
    let id = code.identity(f)
    let mut identity: Bytes = list.with_capacity(list.len(id))?
    match list.append(mut identity, id) { Ok(()) => (), Error(c) => return Error(c) }
    let args_schema = std.codec.schema(ca)?
    let result_schema = std.codec.schema(cr)?
    let args = std.codec.fingerprint_of(args_schema)
    let result = std.codec.fingerprint_of(result_schema)
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)?
    match list.append(mut key, identity) { Ok(()) => (), Error(c) => return Error(c) }
    std.codec.put_u64(args, mut key)?
    std.codec.put_u64(result, mut key)?
    Ok((take key, Described(kind: Compute, identity: take identity, args_schema: take args_schema, result_schema: take result_schema, args: args, result: result)))
}

pub fn register[A, R](mut r: Registry, f: StaticFn[fn(take A) -> Result[R, Capacity]], take ca: std.codec.Codec[A], take cr: std.codec.Codec[R]) -> Result[(), Capacity] {
    let (take key, take d) = key_of(f, ca, cr)?
    let made = fn(arg: Bytes, budget: u64) -> Outcome { adapt(f, ca, cr, arg, budget) }
    let run = match made {
        Ok(take g) => take g,
        Error((c, _)) => return Error(c),
    }
    match map.insert(mut r.slots, take key, Slot(run: take run)) {
        Ok(()) => (),
        Error((c, _)) => return Error(c),
    }
    match list.push(mut r.described, take d) {
        Ok(()) => Ok(()),
        Error((c, _)) => Error(c),
    }
}

// A call in the same run: argument bytes in, an Outcome out.
pub fn call(r: Registry, key: Bytes, arg: Bytes, budget: u64) -> Outcome {
    match map.get(r.slots, key) {
        Some(s) => {
            let g = s.run
            g(arg, budget)
        },
        None => Refused(NoEntry),
    }
}


fn set(take x: u64) -> Result[bool, Capacity] {
    Ok(x % 2u64 == 1u64)
}

type Req: send { key: Bytes, arg: Bytes }

type Head: send { r: Registry, rx: Receiver[Req], tx: Sender[Outcome] }

fn head(take h: Head) -> u64 waits {
    let mut served = 0u64
    loop {
        match channel.receive(h.rx) {
            Ok(take q) => {
                if list.len(q.key) == 0u64 { return served }
                let o = call(h.r, q.key, q.arg, 4096u64)
                match channel.send(h.tx, take o) { Ok(()) => (), Error(_) => return served }
                served += 1u64
            },
            Error(_) => return served,
        }
    }
}

fn key_for(r: Registry, i: u64) -> Bytes {
    let d = r.described[i]
    let mut key: Bytes = list.new()
    result.unwrap(list.append(mut key, d.identity))
    result.unwrap(std.codec.put_u64(d.args, mut key))
    result.unwrap(std.codec.put_u64(d.result, mut key))
    take key
}

fn arg_of(i: u64) -> Bytes {
    let mut a: Bytes = list.new()
    result.unwrap(std.codec.put_u64(i, mut a))
    take a
}

pub fn main(tasks: Tasks, argv: Args) -> Result[(), Exit] waits {
    let Some(m) = args.get(argv, 0) else { return Error(Exit(status: 2)) }
    let Some(ns) = args.get(argv, 1) else { return Error(Exit(status: 2)) }
    let mode = result.unwrap(std.int.parse_uint(m, 10u32))
    let n = result.unwrap(std.int.parse_uint(ns, 10u32))
    let mut r = registry()
    result.unwrap(register(mut r, code.describe(set), std.codec.of_u64(), std.codec.of_bool()))
    let key = key_for(r, 0u64)
    let mut trues = 0u64
    if mode == 0u64 {
        for i in 0u64 .. n { if i % 2u64 == 1u64 { trues += 1u64 } }
    } else if mode == 1u64 {
        for i in 0u64 .. n {
            let a = arg_of(i)
            let mut at = 0u64
            let x = match std.codec.take_u64(a, mut at) { Ok(x) => x, Error(_) => 0u64 }
            if result.unwrap(set(x)) { trues += 1u64 }
        }
    } else if mode == 2u64 {
        for i in 0u64 .. n {
            match call(r, key, arg_of(i), 4096u64) {
                Returned(b) => { if b[0u64] == 1u8 { trues += 1u64 } },
                _ => return Error(Exit(status: 5)),
            }
        }
    } else {
        let q: (Sender[Req], Receiver[Req]) = result.unwrap(channel.new(64u64))
        let (qtx, qrx) = take q
        let o: (Sender[Outcome], Receiver[Outcome]) = result.unwrap(channel.new(64u64))
        let (otx, orx) = take o
        let h = match task.spawn(tasks, bytes 1048576u64, Head(r: take r, rx: take qrx, tx: take otx), head) {
            Ok(take h) => take h,
            Error(_) => return Error(Exit(status: 6)),
        }
        for i in 0u64 .. n {
            let mut k: Bytes = list.new()
            result.unwrap(list.append(mut k, key))
            match channel.send(qtx, Req(key: take k, arg: arg_of(i))) { Ok(()) => (), Error(_) => return Error(Exit(status: 7)) }
            match channel.receive(orx) {
                Ok(Returned(b)) => { if b[0u64] == 1u8 { trues += 1u64 } },
                _ => return Error(Exit(status: 8)),
            }
        }
        match channel.send(qtx, Req(key: list.new(), arg: list.new())) { Ok(()) => (), Error(_) => return Error(Exit(status: 9)) }
        let _ = task.join(take h)
    }
    if trues == n / 2u64 { Ok(()) } else { Error(Exit(status: 1)) }
}

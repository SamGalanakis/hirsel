// Generated by prepare_oracles.py with Pillow, libavif and Python hmac.
fn load(name: String) -> Bytes {
    let encoded = if name == "avif.image" {
        b""
    } else if name == "avif.rgb" {
        b""
    } else if name == "exif.jpg" {
        b""
    } else if name == "jfxx.jpg" {
        b""
    } else if name == "jpeg.image" {
        b""
    } else if name == "jpeg.rgb" {
        b""
    } else if name == "signed.path" {
        b"L29sZVZ5Z1oyT3NuckNPZWtoRHJGNWRRRDlXUW16dGxkSGdidjNmMUl5UkEvQVFDN2ZoakRfd1ctNVl1Q21mOHZZZVNXVnNxa2ZYZTBkbGwxYjZsTF9zcEFLd0FBQUdBQUFBQkE="
    } else if name == "tampered.path" {
        b"L29sZVZ5Z1oyT3NuckNPZWtoRHJGNWRRRDlXUW16dGxkSGdidjNmMUl5UkEvQVFDN2ZoakRfd1ctNVl1Q21mOHZZZVNXVnNxa2ZYZTBkbGwxYjZsTF9zcEFLd0FBQUdBQUFBQkI="
    } else if name == "unsigned.path" {
        b"L0FRQzdmaGpEX3dXLTVZdUNtZjh2WWVTV1ZzcWtmWGUwZGxsMWI2bExfc3BBS3dBQUFHQUFBQUJB"
    } else if name == "webp.image" {
        b""
    } else if name == "webp.rgb" {
        b""
    } else {
        fail("unknown thumbnail fixture")
    }
    let Some(take decoded) = std.base64.decode(encoded) else {
        fail("invalid encoded thumbnail fixture")
    }
    take decoded
}

// A place's triggers are ordinary typed table rows. Store frames and recovery
// treat these tables the same as the place's other tables.
pub type Due: send = AfterCommit | At(u64)

pub type Id: codec + key + send {
    store_hi: u64,
    store_lo: u64,
    branch: u32,
    version: u64,
    index: u64
}

pub type Hold: codec + send = Request(u64, u64, Bytes, Bytes) | Revision(Bytes, Bytes)

pub type Terminal: codec + send = Returned(Bytes) | Raised(u32) | OutOfTime(u64) | OutOfBytes(u64, u64) | Gone | Cancelled | Cap

pub type Error: send = Store(store.Error) | StaleAttempt | MissingEntry | AlreadyTriggerable | AttemptLimit | IndexLimit | NotHeld | CancelRequested | NotDue

type State: codec + send = Waiting | Running | Parked(Hold)

type Row: codec + send {
    path: Bytes,
    schema: Bytes,
    arg: Bytes,
    due: u64,
    granted: bool,
    attempt: u64,
    revision: Bytes,
    state: State,
    cancel: bool
}

pub opaque type Tables: send {
    rows: store.Table[Id, Row],
    due: store.Index[u64, Id, Row],
    outcomes: store.Table[Id, Terminal]
}

pub opaque type Entry[A] {
    ref: EntryRef,
    codec: std.codec.Codec[A]
}

type EntryRef: send { path: Bytes, schema: Bytes, granted: bool }

pub opaque type Entries: send { listed: List[EntryRef] }

pub opaque type Pending: send {
    id: Id,
    row: Row
}

pub opaque type PendingRows { rows: store.Rows[Id, Row] }

pub opaque type Attempt: send { id: Id, number: u64 }

pub type Started: send = Body(Attempt) | Held

fn rows_name() -> String { "store.triggers.pending" }
fn outcomes_name() -> String { "store.triggers.outcomes" }

fn put_id(id: Id, mut out: Bytes) {
    std.codec.put_key_u64(id.store_hi, mut out)
    std.codec.put_key_u64(id.store_lo, mut out)
    std.codec.put_key_u32(id.branch, mut out)
    std.codec.put_key_u64(id.version, mut out)
    std.codec.put_key_u64(id.index, mut out)
}

fn take_id(raw: Bytes, mut at: u64) -> Result[Id, std.codec.DecodeError] {
    let hi = std.codec.take_key_u64(raw, mut at)?
    let lo = std.codec.take_key_u64(raw, mut at)?
    let branch = std.codec.take_key_u32(raw, mut at)?
    let version = std.codec.take_key_u64(raw, mut at)?
    let index = std.codec.take_key_u64(raw, mut at)?
    Ok(Id(store_hi: hi, store_lo: lo, branch: branch, version: version, index: index))
}

fn id_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 5u64)?
    std.codec.schema_u64(mut s)
    std.codec.schema_u64(mut s)
    std.codec.schema_u32(mut s)
    std.codec.schema_u64(mut s)
    std.codec.schema_u64(mut s)
    Ok(())
}

fn id_key() -> std.codec.Key[Id] {
    std.codec.key_make(put_id, take_id, id_schema)
}

fn row_due(row: Row) -> Result[u64, Capacity] { Ok(row.due) }

fn created(take r: Result[(), store.Error]) -> Result[(), store.Error] {
    match take r {
        Error(Exists(_)) => Ok(()),
        other => take other,
    }
}

pub fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    let value: std.codec.Codec[Row] = std.codec.of()
    let terminal: std.codec.Codec[Terminal] = std.codec.of()
    let mut spec = store.spec(rows_name(), id_key(), value)
    store.with_index(mut spec, "due", code.describe(row_due), std.codec.key_u64())?
    created(store.migration_create_table(mut phase, take spec))?
    created(store.migration_create_table(mut phase, store.spec(outcomes_name(), id_key(), terminal)))
}

fn pending_table(source: store.Schema) -> Result[store.Table[Id, Row], store.Error] {
    let value: std.codec.Codec[Row] = std.codec.of()
    store.schema_table(source, rows_name(), id_key(), value)
}

pub fn tables(source: store.Schema) -> Result[Tables, store.Error] {
    let mut rows = pending_table(source)?
    let terminal: std.codec.Codec[Terminal] = std.codec.of()
    let due = store.schema_index(source, mut rows, "due", code.describe(row_due), std.codec.key_u64())?
    let outcomes = store.schema_table(source, outcomes_name(), id_key(), terminal)?
    Ok(Tables(rows: take rows, due: take due, outcomes: take outcomes))
}

pub opaque type PendingTable { table: Option[store.Table[Id, Row]] }

pub fn pending_table_if_present(source: store.Schema) -> Result[PendingTable, store.Error] {
    match pending_table(source) {
        Ok(take table) => Ok(PendingTable(table: Some(take table))),
        Error(Missing(_)) => Ok(PendingTable(table: None)),
        Error(take problem) => Error(take problem),
    }
}

pub fn scan_pending(s: store.Snapshot, t: PendingTable) -> Result[Option[PendingRows], store.Error] {
    match t.table {
        Some(table) => Ok(Some(PendingRows(rows: store.scan(s, store.shape(table), Unbounded, Unbounded)?))),
        None => Ok(None),
    }
}

pub fn next_scanned(mut cursor: PendingRows) -> Result[Option[Pending], store.Error] {
    while let Some((id, take row)) = store.next(mut cursor.rows)? {
        if id.branch == 0u32 { return Ok(Some(Pending(id: id, row: take row))) }
    }
    Ok(None)
}

pub fn tables_for_settlement(source: store.Schema, snapshot: store.Snapshot) -> Result[Option[Tables], store.Error] {
    let pending = pending_table_if_present(source)?
    let Some(take cursor) = scan_pending(snapshot, pending)? else { return Ok(None) }
    let mut remaining = take cursor
    if let None = next_scanned(mut remaining)? { return Ok(None) }
    Ok(Some(tables(source)?))
}

fn stored[T](take r: Result[T, store.Error]) -> Result[T, Error] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(take e) => Error(Store(take e)),
    }
}

fn copy_bytes(b: Bytes) -> Result[Bytes, Error] {
    Ok(clone(b))
}

fn definition_path(identity: Bytes) -> View[Bytes] in identity {
    // PROG-9 encodes a path between the version byte and the first '('.
    let mut end = 1u64
    while identity[end] != 40u8 { end += 1u64 }
    list.slice(identity, 1u64, end)
}

fn path[F](f: StaticFn[F]) -> Bytes {
    clone(definition_path(code.identity(f)))
}

fn entry[F, A: codec](f: StaticFn[F], carries_grants: bool) -> Result[Entry[A], std.codec.EncodeError] {
    let codec: std.codec.Codec[A] = std.codec.of()
    Ok(Entry(ref: EntryRef(path: path(f), schema: std.codec.schema(codec)?, granted: carries_grants), codec: codec))
}

pub fn transact[H, A: codec, R, E](f: StaticFn[fn(mut store.Tx, H, store.Caller, take A) -> Result[R, E]]) -> Result[Entry[A], std.codec.EncodeError] {
    entry(f, false)
}

pub fn granted[G, A: codec, R](f: StaticFn[fn(G, store.Caller, take A) -> Result[R, Capacity] waits]) -> Result[Entry[A], std.codec.EncodeError] {
    entry(f, true)
}

pub fn empty_entries() -> Entries { Entries(listed: list.new()) }

pub fn is_empty(entries: Entries) -> bool { list.len(entries.listed) == 0u64 }

pub fn allow[A](mut entries: Entries, target: Entry[A]) -> Result[(), Error] {
    for ref in entries.listed {
        if ref.path == target.ref.path { return Error(AlreadyTriggerable) }
    }
    let ref: EntryRef = clone(target.ref)
    Ok(list.push(mut entries.listed, take ref))
}

fn listed(entries: Entries, path_bytes: Bytes, schema: Bytes, carries_grants: bool) -> bool {
    for ref in entries.listed {
        if ref.path == path_bytes {
            return ref.schema == schema && ref.granted == carries_grants
        }
    }
    false
}

pub fn write[A](mut tx: store.Tx, t: Tables, entries: Entries, target: Entry[A], arg: A, when: Due) -> Result[Id, Error] {
    if !listed(entries, target.ref.path, target.ref.schema, target.ref.granted) { return Error(MissingEntry) }
    let info = store.info(mut tx)
    let mut id = Id(store_hi: info.id.store.hi, store_lo: info.id.store.lo, branch: info.id.branch, version: info.id.version, index: 0u64)
    let shape = store.shape(t.rows)
    while let Some(_) = stored(store.fetch(tx, shape, id))? {
        let Some(next) = int.checked_add(id.index, 1u64) else { return Error(IndexLimit) }
        id.index = next
    }
    let due = match when { AfterCommit => info.at, At(at) => at }
    let mut encoded: Bytes = list.new()
    std.codec.encode(target.codec, arg, mut encoded) ?=> |_| Store(Limit(Value))
    let row = Row(path: copy_bytes(target.ref.path)?, schema: copy_bytes(target.ref.schema)?, arg: take encoded, due: due,
        granted: target.ref.granted, attempt: 0u64, revision: list.new(), state: Waiting, cancel: false)
    stored(store.put(mut tx, t.rows, id, row))?
    Ok(id)
}

// The place supplies its durable main snapshot. The index sorts by due time,
// with the primary key as the tie breaker (store index order).
pub fn next_pending(s: store.Snapshot, t: Tables, active: scoped[view] fn(Id) -> bool) -> Result[Option[Pending], store.Error] {
    let mut rows = store.find(s, t.due, Unbounded, Unbounded)?
    while let Some((id, take row)) = store.next(mut rows)? {
        // An inherited trigger in a fork is inert.
        if id.branch == 0u32 && !active(id) && (!parked(row.state) || row.cancel) {
            return Ok(Some(Pending(id: id, row: take row)))
        }
    }
    Ok(None)
}

pub fn due_time(p: Pending) -> u64 { p.row.due }
pub fn pending_id(p: Pending) -> Id { p.id }
pub fn run_id(a: Attempt) -> Id { a.id }
pub fn number(a: Attempt) -> u64 { a.number }
pub fn is_granted(p: Pending) -> bool { p.row.granted }
pub fn argument(p: Pending) -> View[Bytes] in p { view p.row.arg }
pub fn entry_path(p: Pending) -> View[Bytes] in p { view p.row.path }
pub fn argument_schema(p: Pending) -> View[Bytes] in p { view p.row.schema }

pub fn is_allowed(p: Pending, choices: Entries) -> bool {
    listed(choices, p.row.path, p.row.schema, p.row.granted)
}

pub fn matches(p: Pending, identity: Bytes, schema: Bytes) -> bool {
    p.row.path == definition_path(identity) && p.row.schema == schema
}

pub fn cancelling(p: Pending) -> bool { p.row.cancel }

fn revision_mismatch(row: Row, image: Bytes) -> bool {
    row.attempt != 0u64 && row.revision != image
}

pub fn held_on_start(p: Pending, image: Bytes) -> bool {
    parked(p.row.state) || (p.row.granted && revision_mismatch(p.row, image))
}

fn read(tx: store.Tx, t: Tables, id: Id) -> Result[Row, Error] {
    match stored(store.fetch(tx, store.shape(t.rows), id))? {
        Some(take row) => Ok(take row),
        None => Error(StaleAttempt),
    }
}

fn parked(state: State) -> bool {
    match state { Parked(_) => true, _ => false }
}

fn running(state: State) -> bool {
    match state { Running => true, _ => false }
}

fn current_attempt(row: Row, a: Attempt) -> bool {
    row.attempt == a.number && running(row.state)
}

fn current(tx: store.Tx, t: Tables, a: Attempt) -> Result[Row, Error] {
    let row = read(tx, t, a.id)?
    if !current_attempt(row, a) { return Error(StaleAttempt) }
    Ok(take row)
}

pub fn fence(tx: store.Tx, t: Tables, a: Attempt) -> Result[bool, Error] {
    let row = current(tx, t, a)?
    Ok(row.cancel)
}

pub fn hold_mark(s: store.Snapshot, t: Tables, id: Id) -> Result[Option[Hold], store.Error] {
    match store.get(s, store.shape(t.rows), id)? {
        Some(Row(state: Parked(take mark), ..)) => Ok(Some(take mark)),
        _ => Ok(None),
    }
}

pub fn boundary(s: store.Snapshot, t: Tables, a: Attempt) -> Result[bool, Error] {
    let row = stored(store.get(s, store.shape(t.rows), a.id))?
    let Some(value) = row else { return Error(StaleAttempt) }
    if !current_attempt(value, a) { return Error(StaleAttempt) }
    Ok(value.cancel)
}

pub fn start(mut tx: store.Tx, t: Tables, p: Pending, revision: Bytes) -> Result[Started, Error] {
    let at = store.info(mut tx).at
    let mut row = read(tx, t, p.id)?
    if at < row.due { return Error(NotDue) }
    if row.cancel || parked(row.state) { return Error(StaleAttempt) }
    if revision_mismatch(row, revision) {
        row.state = Parked(Revision(copy_bytes(row.revision)?, copy_bytes(revision)?))
        stored(store.put(mut tx, t.rows, p.id, row))?
        return Ok(Held)
    }
    if row.attempt == 0u64 { row.revision = copy_bytes(revision)? }
    let Some(n) = int.checked_add(row.attempt, 1u64) else { return Error(AttemptLimit) }
    row.attempt = n
    row.state = Running
    stored(store.put(mut tx, t.rows, p.id, row))?
    Ok(Body(Attempt(id: p.id, number: n)))
}

pub fn hold(mut tx: store.Tx, t: Tables, a: Attempt, step: u64, expected: Bytes, actual: Bytes) -> Result[(), Error] {
    let mut row = current(tx, t, a)?
    if row.cancel { return Error(CancelRequested) }
    row.state = Parked(Request(a.number, step, copy_bytes(expected)?, copy_bytes(actual)?))
    stored(store.put(mut tx, t.rows, a.id, row))
}

pub fn release(mut tx: store.Tx, t: Tables, id: Id, revision: Option[Bytes]) -> Result[(), Error] {
    let mut row = read(tx, t, id)?
    match row.state {
        Parked(mark) => match revision {
            Some(selected) => { row.revision = copy_bytes(selected)? },
            None => if let Revision(_, _) = mark { return Error(NotHeld) },
        },
        _ => return Error(NotHeld),
    }
    row.state = Waiting
    stored(store.put(mut tx, t.rows, id, row))
}

pub fn request_cancel(mut tx: store.Tx, t: Tables, id: Id) -> Result[(), Error] {
    let mut row = read(tx, t, id)?
    row.cancel = true
    stored(store.put(mut tx, t.rows, id, row))
}

fn consume(mut tx: store.Tx, t: Tables, id: Id, terminal: Terminal) -> Result[(), Error] {
    stored(store.put(mut tx, t.outcomes, id, terminal))?
    let _ = stored(store.delete(mut tx, t.rows, id))?
    Ok(())
}

pub fn finish(mut tx: store.Tx, t: Tables, a: Attempt, terminal: Terminal) -> Result[(), Error] {
    let row = read(tx, t, a.id)?
    if row.attempt != a.number { return Error(StaleAttempt) }
    if row.cancel { return consume(mut tx, t, a.id, Cancelled) }
    if !running(row.state) { return Error(StaleAttempt) }
    consume(mut tx, t, a.id, terminal)
}

pub fn finish_cancel(mut tx: store.Tx, t: Tables, p: Pending) -> Result[(), Error] {
    let row = read(tx, t, p.id)?
    if !row.cancel { return Error(StaleAttempt) }
    consume(mut tx, t, p.id, Cancelled)
}

pub fn finish_transact(mut tx: store.Tx, t: Tables, p: Pending, terminal: Terminal) -> Result[(), Error] {
    let row = read(tx, t, p.id)?
    if row.granted { return Error(StaleAttempt) }
    consume(mut tx, t, p.id, terminal)
}

pub fn outcome(s: store.Snapshot, t: Tables, id: Id) -> Result[Option[Terminal], store.Error] {
    store.get(s, store.shape(t.outcomes), id)
}

pub fn fetch_outcome(tx: store.Tx, t: Tables, id: Id) -> Result[Option[Terminal], store.Error] {
    store.fetch(tx, store.shape(t.outcomes), id)
}

pub fn law_options() -> store.Options {
    let mut options = result.unwrap(store.sized(Directory, 2147483648u64))

    options.resident_limit = 1048576u64
    options.pack_bytes = 512u64
    options.group_commits = 2u32
    options.group_bytes = 1048576u32
    options
}

fn done[R](take result: Result[store.Outcome[R, Error], store.Error]) -> store.Done[R] {
    match take result {
        Ok(Committed(take v)) => take v,
        _ => fail("trigger law: expected a commit"),
    }
}

fn first(db: store.Db, t: Tables) -> Option[Pending] {
    result.unwrap(next_pending(store.snapshot(db), t, fn(id: Id) -> bool { false }))
}

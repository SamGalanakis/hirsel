pub type Kind: key = Mid | Rid | RepairedRid | AudioLevel | AbsSendTime | TransportSeq | DependencyDescriptor | VideoLayersAllocation | PlayoutDelay | VideoOrientation | AbsCaptureTime

pub type Form: key = OneOnly | TwoOnly | Mixed

pub type Error = Overrun | Value(Kind) | Buffer

pub type MapError = BadId | IdTaken | KindTaken | Full | Value(Kind)

pub type Element {
    id: u8,
    at: u64,
    len: u64
}

pub opaque type ExtMap {
    form: Form,
    ids: Inline[u8, 11],
    voice: bool
}

type Entry {
    id: u8,
    len: u8
}

pub opaque type ExtWriter {
    form: Form,
    conflicting_forms: bool,
    one_byte: bool,
    entries: Inline[Entry, 16],
    data: Inline[u8, 256],
    count: u64,
    used: u64
}

pub fn map(form: Form) -> ExtMap {
    ExtMap(form: form, ids:[0u8; 11], voice: false)
}

fn slot(k: Kind) -> u64 {
    match k {
        Mid => 0,
        Rid => 1,
        RepairedRid => 2,
        AudioLevel => 3,
        AbsSendTime => 4,
        TransportSeq => 5,
        DependencyDescriptor => 6,
        VideoLayersAllocation => 7,
        PlayoutDelay => 8,
        VideoOrientation => 9,
        AbsCaptureTime => 10,
    }
}

fn valid_id(form: Form, id: u8) -> bool {
    id != 0 && (form != OneOnly || id <= 14)
}

pub fn bind(mut m: ExtMap, id: u8, k: Kind) -> Result[(), MapError] {
    if !valid_id(m.form, id) {
        return Error(BadId)
    }
    for existing in m.ids {
        if existing == id {
            return Error(IdTaken)
        }
    }
    let at = slot(k)
    if m.ids[at] != 0 {
        return Error(KindTaken)
    }
    m.ids[at] = id
    Ok(())
}

pub fn vad(mut m: ExtMap, on: bool) {
    m.voice = on
}

fn block_fits(h: header.Header, start: u64, len: u64) -> bool {
    start >= 16 && h.end <= h.len && start <= h.end && len <= h.end - start
}

// The cursor is relative to the start of the extension block. The returned
// value offset is relative to the packet.
pub fn next(pkt: Bytes, h: header.Header, mut at: u64) -> Result[Option[Element], Error] {
    if list.len(pkt) != h.len {
        return Error(Buffer)
    }
    let (start, len, one_byte) = match h.block {
        NoBlock => {
            at = 0
            return Ok(None)
        },
        Opaque(len: size, ..) => {
            at = size
            return Ok(None)
        },
        OneByte(at: start, len: len) => (start, len, true),
        TwoByte(at: start, len: len) => (start, len, false),
    }
    if !block_fits(h, start, len) {
        return Error(Overrun)
    }
    let mut pos = at
    while pos < len {
        let first = pkt[start + pos]
        pos += 1
        if first == 0 {
            continue
        }
        let (id, octets) = if one_byte {
            let id = first >> 4
            if id == 0 || id == 15 {
                at = len
                return Ok(None)
            }
            (id, (first & 15) + 1)
        } else {
            if pos == len {
                return Error(Overrun)
            }
            let size = pkt[start + pos]
            pos += 1
            (first, size)
        }
        let size: u64 = int.widen(octets)
        if size > len - pos {
            return Error(Overrun)
        }
        at = pos + size
        return Ok(Some(Element(id: id, at: start + pos, len: size)))
    }
    at = len
    Ok(None)
}

// One walk of the block for every kind the map binds. A value's offset is
// kept relative to the block start; 0 means the kind was not found, since a
// value always follows at least its element's first byte.
pub opaque type Found {
    start: u64,
    ids: Inline[u8, 11],
    at: Inline[u32, 11],
    len: Inline[u8, 11]
}

pub fn scan(m: ExtMap, pkt: Bytes, h: header.Header) -> Result[Found, Error] {
    if list.len(pkt) != h.len {
        return Error(Buffer)
    }
    let mut f = Found(start: 0, ids: m.ids, at:[0u32; 11], len:[0u8; 11])
    let (start, len, one_byte) = match h.block {
        OneByte(at: start, len: len) => (start, len, true),
        TwoByte(at: start, len: len) => (start, len, false),
        _ => return Ok(f),
    }
    if !block_fits(h, start, len) {
        return Error(Overrun)
    }
    f.start = start
    let mut pos = 0u64
    while pos < len {
        let first = pkt[start + pos]
        pos += 1
        if first == 0 {
            continue
        }
        let (id, octets) = if one_byte {
            let id = first >> 4
            if id == 0 || id == 15 {
                return Ok(f)
            }
            (id, (first & 15) + 1)
        } else {
            if pos == len {
                return Error(Overrun)
            }
            let size = pkt[start + pos]
            pos += 1
            (first, size)
        }
        let size: u64 = int.widen(octets)
        if size > len - pos {
            return Error(Overrun)
        }
        // Bound ids are distinct and nonzero, and an element's id is never 0.
        let mut s = 0u64
        while s < 11 {
            if m.ids[s] == id {
                if f.at[s] == 0 {
                    f.at[s] = int.narrow(pos)
                    f.len[s] = octets
                }
                break
            }
            s += 1
        }
        pos += size
    }
    Ok(f)
}

pub fn found(f: Found, k: Kind) -> Option[Element] {
    let s = slot(k)
    let at = f.at[s]
    if at == 0 {
        return None
    }
    let offset: u64 = int.widen(at)
    Some(Element(id: f.ids[s], at: f.start + offset, len: int.widen(f.len[s])))
}

pub fn find(m: ExtMap, pkt: Bytes, h: header.Header, k: Kind) -> Result[Option[Element], Error] {
    Ok(found(scan(m, pkt, h)?, k))
}

fn value_in_block(h: header.Header, e: Element) -> bool {
    let (start, size) = match h.block {
        OneByte(at: start, len: size) => (start, size),
        TwoByte(at: start, len: size) => (start, size),
        _ => return false,
    }
    if !block_fits(h, start, size) || e.at <= start {
        return false
    }
    let offset = e.at - start
    offset <= size && e.len <= size - offset
}

fn alphanumeric(b: u8) -> bool {
    (b >= b'A' && b <= b'Z') || (b >= b'a' && b <= b'z') || (b >= b'0' && b <= b'9')
}

fn valid_token(b: u8, mid: bool) -> bool {
    alphanumeric(b) || (mid && (b == b'!' || (b >= b'#' && b <= b'\'') || b == b'*' || b == b'+' || b == b'-' || b == b'.' || (b >= b'^' && b <= b'`') || (b >= b'{' && b <= b'~')))
}

fn valid_value(value: Bytes, from: u64, len: u64, k: Kind) -> bool {
    match k {
        AudioLevel => return len == 1,
        AbsSendTime => return len == 3,
        TransportSeq => return len == 2,
        // AV1 RTP section A.8: three mandatory octets, then the extended fields.
        // The value is opaque here; `media_bits.dependency` reads it.
        DependencyDescriptor => return len >= 3 && len <= 255,
        // libwebrtc RtpVideoLayersAllocationExtension: a single 0 byte is the
        // empty allocation; `allocation` reads the rest of the grammar.
        VideoLayersAllocation => return len >= 1 && len <= 255,
        PlayoutDelay => return len == 3,
        VideoOrientation => return len == 1,
        AbsCaptureTime => return len == 8 || len == 16,
        _ => {},
    }
    if len == 0 || len > 255 {
        return false
    }
    let mid = k == Mid
    let mut i = 0u64
    while i < len {
        if !valid_token(value[from + i], mid) {
            return false
        }
        i += 1
    }
    true
}

fn check_value(pkt: Bytes, h: header.Header, e: Element, k: Kind) -> Result[(), Error] {
    if list.len(pkt) != h.len {
        return Error(Buffer)
    }
    if !value_in_block(h, e) || !valid_value(pkt, e.at, e.len, k) {
        return Error(Value(k))
    }
    Ok(())
}

pub fn audio_level(m: ExtMap, pkt: Bytes, h: header.Header, e: Element) -> Result[(Option[bool], u8), Error] {
    check_value(pkt, h, e, AudioLevel)?
    let b = pkt[e.at]
    Ok((if m.voice {
        Some((b & 128) != 0)
    } else {
        None
    }, b & 127))
}

pub fn abs_send_time(pkt: Bytes, h: header.Header, e: Element) -> Result[u32, Error] {
    check_value(pkt, h, e, AbsSendTime)?
    let high: u32 = int.widen(pkt[e.at])
    let low: u16 = list.word_be(pkt, e.at + 1)
    Ok((high << 16) | int.widen(low))
}

pub fn transport_seq(pkt: Bytes, h: header.Header, e: Element) -> Result[u16, Error] {
    check_value(pkt, h, e, TransportSeq)?
    Ok(list.word_be(pkt, e.at))
}

pub fn token(pkt: Bytes, h: header.Header, k: Kind, e: Element) -> Result[Element, Error] {
    if list.len(pkt) != h.len {
        return Error(Buffer)
    }
    if k != Mid && k != Rid && k != RepairedRid {
        return Error(Value(k))
    }
    check_value(pkt, h, e, k)?
    Ok(e)
}

// The CVO byte `0 0 0 0 C F R1 R0` (3GPP TS 26.114 section 7.4.5), unchanged:
// the forwarder carries it, it does not rotate.
pub fn orientation(pkt: Bytes, h: header.Header, e: Element) -> Result[u8, Error] {
    check_value(pkt, h, e, VideoOrientation)?
    Ok(pkt[e.at])
}

// 12-bit MIN then 12-bit MAX, in 10 ms units. libwebrtc's VideoPlayoutDelay
// refuses MIN above MAX, so the reader does too.
pub fn playout_delay(pkt: Bytes, h: header.Header, e: Element) -> Result[(u16, u16), Error] {
    check_value(pkt, h, e, PlayoutDelay)?
    let a: u16 = int.widen(pkt[e.at])
    let b: u16 = int.widen(pkt[e.at + 1])
    let c: u16 = int.widen(pkt[e.at + 2])
    let min = (a << 4) | (b >> 4)
    let max = ((b & 15) << 8) | c
    if min > max {
        return Error(Value(PlayoutDelay))
    }
    Ok((min, max))
}

// The UQ32.32 NTP capture timestamp, and the Q32.32 estimated capture clock
// offset when the value is 16 bytes.
pub fn abs_capture_time(pkt: Bytes, h: header.Header, e: Element) -> Result[(u64, Option[i64]), Error] {
    check_value(pkt, h, e, AbsCaptureTime)?
    let ts: u64 = list.word_be(pkt, e.at)
    if e.len == 8 {
        return Ok((ts, None))
    }
    let raw: u64 = list.word_be(pkt, e.at + 8)
    Ok((ts, Some(signed(raw))))
}

// Two's complement between a Q32.32 offset and its 64 wire bits.
fn signed(raw: u64) -> i64 {
    if raw < 0x8000000000000000 {
        return int.narrow(raw)
    }
    let below: i64 = int.narrow(~raw)
    -below - 1
}

fn unsigned(v: i64) -> u64 {
    if v >= 0 {
        return int.narrow(v)
    }
    let below: u64 = int.narrow(-(v + 1))
    ~below
}

// A video layers allocation (libwebrtc video-layers-allocation00). Layer
// (stream, sid) is active when bit sid of masks[stream] is set; its fields are
// at stream * 4 + sid, and its cumulative target for temporal layer tid at
// stream * 16 + sid * 4 + tid. All masks clear is the empty allocation, the
// single 0 byte. Widths, heights and rates are meaningful only when sized.
pub type Allocation {
    stream: u8,
    masks: Inline[u8, 4],
    temporal: Inline[u8, 16],
    kbps: Inline[u32, 64],
    sized: bool,
    width: Inline[u16, 16],
    height: Inline[u16, 16],
    fps: Inline[u8, 16]
}

pub fn empty_allocation() -> Allocation {
    Allocation(stream: 0, masks:[0u8; 4], temporal:[0u8; 16], kbps:[0u32; 64], sized: false, width:[0u16; 16], height:[0u16; 16], fps:[0u8; 16])
}

// The highest stream index with an active layer, or None when the allocation
// is empty.
pub fn last_stream(a: Allocation) -> Option[u64] {
    let mut s = 4u64
    while s > 0 {
        s -= 1
        if a.masks[s] != 0 {
            return Some(s)
        }
    }
    None
}

// The cumulative target of stream s's top layer, its highest active spatial
// layer at its highest temporal layer: all the stream sends, in kbps. None
// when the stream has no active layer.
pub fn stream_kbps(a: Allocation, s: u64) -> Option[u32] {
    if s >= 4 || a.masks[s] == 0 {
        return None
    }
    let mut sid = 4u64
    while sid > 0 {
        sid -= 1
        if (a.masks[s] & (1u8 << int.narrow(sid))) != 0 {
            let tl: u64 = int.widen(a.temporal[s * 4 + sid])
            return Some(a.kbps[s * 16 + sid * 4 + tl - 1])
        }
    }
    None
}

const MAX_KBPS: u64 = 1000000

pub fn allocation(pkt: Bytes, h: header.Header, e: Element) -> Result[Allocation, Error] {
    check_value(pkt, h, e, VideoLayersAllocation)?
    let Some(a) = parse_allocation(pkt, e.at, e.at + e.len) else {
        return Error(Value(VideoLayersAllocation))
    }
    Ok(a)
}

fn parse_allocation(pkt: Bytes, from: u64, end: u64) -> Option[Allocation] {
    let mut a = empty_allocation()
    let mut at = from
    let first = pkt[at]
    if end - from == 1 && first == 0 {
        return Some(a)
    }
    a.stream = first >> 6
    let streams: u64 = int.widen(((first >> 4) & 3) + 1)
    let shared = first & 15
    if shared != 0 {
        let mut i = 0u64
        while i < streams {
            a.masks[i] = shared
            i += 1
        }
    } else {
        at += 1
        if at == end {
            return None
        }
        a.masks[0] = pkt[at] >> 4
        a.masks[1] = pkt[at] & 15
        if streams > 2 {
            at += 1
            if at == end {
                return None
            }
            a.masks[2] = pkt[at] >> 4
            a.masks[3] = pkt[at] & 15
        }
    }
    at += 1
    if at == end {
        return None
    }
    // Two bits of (temporal layers - 1) per active layer, from the high bits.
    let mut shift = 8u8
    let mut layers = 0u64
    let mut s = 0u64
    while s < streams {
        let mut sid = 0u64
        while sid < 4 {
            if (a.masks[s] & (1u8 << int.narrow(sid))) != 0 {
                if shift == 0 {
                    shift = 6
                    at += 1
                    if at == end {
                        return None
                    }
                } else {
                    shift -= 2
                }
                a.temporal[s * 4 + sid] = ((pkt[at] >> shift) & 3) + 1
                layers += 1
            }
            sid += 1
        }
        s += 1
    }
    at += 1
    if at == end {
        return None
    }
    // leb128 kbps per temporal layer, in (stream, sid, tid) order.
    s = 0
    while s < streams {
        let mut sid = 0u64
        while sid < 4 {
            let tl: u64 = int.widen(a.temporal[s * 4 + sid])
            let mut tid = 0u64
            while tid < tl {
                let mut value = 0u64
                let mut bits = 0u64
                let mut more = true
                while more {
                    if at == end {
                        return None
                    }
                    let b = pkt[at]
                    at += 1
                    let low: u64 = int.widen(b & 127)
                    if low != 0 {
                        if bits > 20 {
                            return None
                        }
                        value |= low << bits
                        if value > MAX_KBPS {
                            return None
                        }
                    }
                    bits += 7
                    more = (b & 128) != 0
                }
                a.kbps[s * 16 + sid * 4 + tid] = int.narrow(value)
                tid += 1
            }
            sid += 1
        }
        s += 1
    }
    if at != end {
        if end - at != 5 * layers {
            return None
        }
        a.sized = true
        s = 0
        while s < streams {
            let mut sid = 0u64
            while sid < 4 {
                if a.temporal[s * 4 + sid] != 0 {
                    let w: u16 = list.word_be(pkt, at)
                    let hh: u16 = list.word_be(pkt, at + 2)
                    if w == 0xffff || hh == 0xffff {
                        return None
                    }
                    a.width[s * 4 + sid] = w + 1
                    a.height[s * 4 + sid] = hh + 1
                    a.fps[s * 4 + sid] = pkt[at + 4]
                    at += 5
                }
                sid += 1
            }
            s += 1
        }
    }
    // libwebrtc AllocationIsValid: the sending stream has an active layer
    // at or above its index.
    let Some(last) = last_stream(a) else {
        return None
    }
    let index: u64 = int.widen(a.stream)
    if index > last {
        return None
    }
    Some(a)
}

pub fn writer() -> ExtWriter {
    ExtWriter(form: Mixed, conflicting_forms: false, one_byte: true, entries:[Entry(id: 0, len: 0); 16], data:[0u8; 256], count: 0, used: 0)
}

// Empty the writer for the next header without touching its buffers: only
// the first `count` entries and `used` bytes are ever read.
pub fn reset(mut w: ExtWriter) {
    w.form = Mixed
    w.conflicting_forms = false
    w.one_byte = true
    w.count = 0
    w.used = 0
}

fn reserve_element(mut w: ExtWriter, form: Form, id: u8, len: u64) -> Result[u64, MapError] {
    if w.count == 16 || len > 256 - w.used {
        return Error(Full)
    }
    let start = w.used
    if w.count == 0 {
        w.form = form
    } else if w.form != form {
        w.conflicting_forms = true
    }
    w.one_byte = w.one_byte && id <= 14 && len >= 1 && len <= 16
    w.entries[w.count] = Entry(id: id, len: int.narrow(len))
    w.count += 1
    w.used += len
    Ok(start)
}

fn fits(value: Bytes, from: u64, len: u64) -> bool {
    let size = list.len(value)
    from <= size && len <= size - from
}

fn copy_element(mut w: ExtWriter, form: Form, id: u8, value: Bytes, from: u64, len: u64) -> Result[(), MapError] {
    let start = reserve_element(mut w, form, id, len)?
    let mut i = 0u64
    while i < len {
        w.data[start + i] = value[from + i]
        i += 1
    }
    Ok(())
}

pub fn put(mut w: ExtWriter, m: ExtMap, k: Kind, value: Bytes, from: u64, len: u64) -> Result[(), MapError] {
    let id = m.ids[slot(k)]
    if id == 0 {
        return Ok(())
    }
    if !fits(value, from, len) || !valid_value(value, from, len, k) {
        return Error(Value(k))
    }
    copy_element(mut w, m.form, id, value, from, len)
}

pub fn put_level(mut w: ExtWriter, m: ExtMap, voice: bool, level: u8) -> Result[(), MapError] {
    let id = m.ids[slot(AudioLevel)]
    if id == 0 {
        return Ok(())
    }
    if level > 127 {
        return Error(Value(AudioLevel))
    }
    let start = reserve_element(mut w, m.form, id, 1)?
    w.data[start] = if m.voice && voice {
        level | 128
    } else {
        level
    }
    Ok(())
}

pub fn put_other(mut w: ExtWriter, m: ExtMap, id: u8, value: Bytes, from: u64, len: u64) -> Result[(), MapError] {
    if !valid_id(m.form, id) {
        return Error(BadId)
    }
    if len > 255 || !fits(value, from, len) {
        return Error(Full)
    }
    copy_element(mut w, m.form, id, value, from, len)
}

pub fn put_orientation(mut w: ExtWriter, m: ExtMap, cvo: u8) -> Result[(), MapError] {
    let id = m.ids[slot(VideoOrientation)]
    if id == 0 {
        return Ok(())
    }
    let start = reserve_element(mut w, m.form, id, 1)?
    w.data[start] = cvo
    Ok(())
}

// MIN and MAX in 10 ms units, each at most 4095, MIN at most MAX.
pub fn put_playout_delay(mut w: ExtWriter, m: ExtMap, min: u16, max: u16) -> Result[(), MapError] {
    let id = m.ids[slot(PlayoutDelay)]
    if id == 0 {
        return Ok(())
    }
    if max > 4095 || min > max {
        return Error(Value(PlayoutDelay))
    }
    let start = reserve_element(mut w, m.form, id, 3)?
    w.data[start] = int.narrow(min >> 4)
    w.data[start + 1] = int.narrow(((min & 15) << 4) | (max >> 8))
    w.data[start + 2] = int.narrow(max & 255)
    Ok(())
}

pub fn put_abs_capture_time(mut w: ExtWriter, m: ExtMap, ts: u64, offset: Option[i64]) -> Result[(), MapError] {
    let id = m.ids[slot(AbsCaptureTime)]
    if id == 0 {
        return Ok(())
    }
    let len = match offset {
        Some(_) => 16u64,
        None => 8u64,
    }
    let start = reserve_element(mut w, m.form, id, len)?
    inline.set_word_be(mut w.data, start, ts)
    if let Some(o) = offset {
        inline.set_word_be(mut w.data, start + 8, unsigned(o))
    }
    Ok(())
}

fn leb128_size(v: u32) -> u64 {
    let mut n = 1u64
    let mut x = v >> 7
    while x != 0 {
        n += 1
        x = x >> 7
    }
    n
}

// The value size of a valid allocation, or None for one the reader would
// refuse: a temporal count outside 1 to 4 on an active layer, a rate above
// 1,000,000 kbps, a zero width or height when sized, or a sending stream
// index above the last active stream.
fn allocation_size(a: Allocation) -> Option[u64] {
    let Some(last) = last_stream(a) else {
        return if a.stream == 0 {
            Some(1)
        } else {
            None
        }
    }
    let index: u64 = int.widen(a.stream)
    if index > last {
        return None
    }
    let mut same = true
    let mut i = 1u64
    while i <= last {
        same = same && a.masks[i] == a.masks[0]
        i += 1
    }
    let mut size = if same {
        1u64
    } else if last >= 2 {
        3u64
    } else {
        2u64
    }
    let mut layers = 0u64
    let mut s = 0u64
    while s <= last {
        let mut sid = 0u64
        while sid < 4 {
            if (a.masks[s] & (1u8 << int.narrow(sid))) != 0 {
                let tl: u64 = int.widen(a.temporal[s * 4 + sid])
                if tl == 0 || tl > 4 {
                    return None
                }
                let mut tid = 0u64
                while tid < tl {
                    let k = a.kbps[s * 16 + sid * 4 + tid]
                    let wide: u64 = int.widen(k)
                    if wide > MAX_KBPS {
                        return None
                    }
                    size += leb128_size(k)
                    tid += 1
                }
                if a.sized && (a.width[s * 4 + sid] == 0 || a.height[s * 4 + sid] == 0) {
                    return None
                }
                layers += 1
            }
            sid += 1
        }
        s += 1
    }
    size += (layers + 3) / 4
    if a.sized {
        size += 5 * layers
    }
    Some(size)
}

// Writes `a` as libwebrtc's RtpVideoLayersAllocationExtension::Write does:
// one shared mask when every stream up to the last active one has the same
// mask, else the per-stream masks.
pub fn put_allocation(mut w: ExtWriter, m: ExtMap, a: Allocation) -> Result[(), MapError] {
    let id = m.ids[slot(VideoLayersAllocation)]
    if id == 0 {
        return Ok(())
    }
    let Some(size) = allocation_size(a) else {
        return Error(Value(VideoLayersAllocation))
    }
    if size > 255 {
        return Error(Value(VideoLayersAllocation))
    }
    let start = reserve_element(mut w, m.form, id, size)?
    let Some(last) = last_stream(a) else {
        w.data[start] = 0
        return Ok(())
    }
    let mut at = start
    let ns: u8 = int.narrow(last)
    let mut same = true
    let mut i = 1u64
    while i <= last {
        same = same && a.masks[i] == a.masks[0]
        i += 1
    }
    w.data[at] = (a.stream << 6) | (ns << 4) | if same {
        a.masks[0]
    } else {
        0u8
    }
    if !same {
        at += 1
        w.data[at] = (a.masks[0] << 4) | a.masks[1]
        if last >= 2 {
            at += 1
            w.data[at] = (a.masks[2] << 4) | a.masks[3]
        }
    }
    at += 1
    w.data[at] = 0
    let mut shift = 8u8
    let mut s = 0u64
    while s <= last {
        let mut sid = 0u64
        while sid < 4 {
            if (a.masks[s] & (1u8 << int.narrow(sid))) != 0 {
                if shift == 0 {
                    shift = 6
                    at += 1
                    w.data[at] = 0
                } else {
                    shift -= 2
                }
                w.data[at] = w.data[at] | ((a.temporal[s * 4 + sid] - 1) << shift)
            }
            sid += 1
        }
        s += 1
    }
    at += 1
    s = 0
    while s <= last {
        let mut sid = 0u64
        while sid < 4 {
            if (a.masks[s] & (1u8 << int.narrow(sid))) != 0 {
                let tl: u64 = int.widen(a.temporal[s * 4 + sid])
                let mut tid = 0u64
                while tid < tl {
                    let mut x = a.kbps[s * 16 + sid * 4 + tid]
                    while x >= 128 {
                        w.data[at] = int.narrow((x & 127) | 128)
                        at += 1
                        x = x >> 7
                    }
                    w.data[at] = int.narrow(x)
                    at += 1
                    tid += 1
                }
            }
            sid += 1
        }
        s += 1
    }
    if a.sized {
        s = 0
        while s <= last {
            let mut sid = 0u64
            while sid < 4 {
                if (a.masks[s] & (1u8 << int.narrow(sid))) != 0 {
                    inline.set_word_be(mut w.data, at, a.width[s * 4 + sid] - 1)
                    inline.set_word_be(mut w.data, at + 2, a.height[s * 4 + sid] - 1)
                    w.data[at + 4] = a.fps[s * 4 + sid]
                    at += 5
                }
                sid += 1
            }
            s += 1
        }
    }
    Ok(())
}

// Keep the writer's representation private across the header.write boundary.
pub fn write_header(f: header.Fields, w: View[ExtWriter], mut out: Bytes) -> Result[u64, header.WriteError] {
    if f.pt > 127 || w.conflicting_forms || (w.form == OneOnly && !w.one_byte) {
        return Error(Form)
    }
    let has_block = w.count != 0
    let one_byte = w.form != TwoOnly && w.one_byte
    let overhead = if one_byte {
        1u64
    } else {
        2u64
    }
    let elements_len = w.used + w.count * overhead
    let words = (elements_len + 3) / 4
    let size = if has_block {
        16 + words * 4
    } else {
        12
    }
    let available = list.capacity(out) - list.len(out)
    if size > available {
        return Error(Capacity(Capacity(requested: size, available: available)))
    }
    // Room is checked, so size the header once and store into it.
    let base = list.len(out)
    list.fill(mut out, size, 0u8)
    out[base] = if has_block {
        0x90u8
    } else {
        0x80u8
    }
    out[base + 1] = if f.marker {
        f.pt | 128
    } else {
        f.pt
    }
    list.set_word_be(mut out, base + 2, f.seq)
    list.set_word_be(mut out, base + 4, f.ts)
    list.set_word_be(mut out, base + 8, f.ssrc)
    if has_block {
        list.set_word_be(mut out, base + 12, if one_byte {
            0xbedeu16
        } else {
            0x1000u16
        })
        let word_count: u16 = int.narrow(words)
        list.set_word_be(mut out, base + 14, word_count)
        // The zero fill is the padding to the word boundary.
        let mut at = base + 16
        let mut value_at = 0u64
        let mut i = 0u64
        while i < w.count {
            let e = w.entries[i]
            if one_byte {
                out[at] = (e.id << 4) | (e.len - 1)
                at += 1
            } else {
                out[at] = e.id
                out[at + 1] = e.len
                at += 2
            }
            let len: u64 = int.widen(e.len)
            let end = value_at + len
            while value_at < end {
                out[at] = w.data[value_at]
                at += 1
                value_at += 1
            }
            i += 1
        }
    }
    Ok(size)
}

// What a disk store opened with these options holds at most: its resident pages, a pack
// and a journal group.
pub fn disk_store_bytes(options: store.Options) -> u64 {
    let journal: u64 = int.widen(options.group_bytes)
    let mut total = int.saturating_add(options.resident_limit, order.max(options.pack_bytes, 16777476))
    total = int.saturating_add(total, journal)
    int.saturating_add(total, 2097152u64)
}

const PLACE_KEEP: u64 = 1048576
const HEAD_OWN_BYTES: u64 = 2097152
const OPERATE_OWN_BYTES: u64 = 262144

fn add_place_bytes(a: u64, b: u64) -> Result[u64, Capacity] {
    match int.checked_add(a, b) {
        Some(n) => Ok(n),
        None => Error(Capacity(requested: b, available: 18446744073709551615u64 - a)),
    }
}

fn trigger_bytes[G: send, H: shareable + inert + send, S: send](config: Option[TriggerConfig[G, H, S]]) -> u64 {
    match config {
        Some(c) if !triggers.is_empty(c.entries) => c.grant_bytes,
        _ => 0u64,
    }
}

fn place_head_bytes(n_place: u64, n_publisher: u64, grant: u64) -> Result[u64, Capacity] {
    let names = add_place_bytes(n_place, n_publisher)?
    let head = add_place_bytes(names, HEAD_OWN_BYTES)?
    add_place_bytes(head, grant)
}

pub fn operate_bytes[G: send, H: shareable + inert + send, S: send, B: send](p: PlaceConfig[G, H, S, B]) -> Result[u64, Capacity] {
    let launch = launch_env()
    let n_place = if launch.n_place_explicit { launch.n_place } else { p.n_place }
    let head = place_head_bytes(n_place, p.n_publisher, trigger_bytes(p.triggers))?
    let serving = serving_bytes(p.session, p.max_sessions, n_place)?
    let tasks = add_place_bytes(head, serving)?
    add_place_bytes(tasks, OPERATE_OWN_BYTES)
}

fn place_store[G: send, H: shareable + inert + send, S: send, B: send](p: PlaceConfig[G, H, S, B], report: Option[Stderr]) -> Result[(store.Options, u64, u64, Option[store.FollowerPlan]), StartError] waits {
    let overhead = operate_bytes(p) ?=> Full
    let reserved = add_place_bytes(overhead, PLACE_KEEP) ?=> Full
    let limit = runtime.root_limit()
    let kind: store.Kind = match p.backing {
        Memory => Memory,
        Bucket(b) => Bucket(b.lanes),
        Sim(b) => Bucket(std.object.request_lanes(b.requests)),
        _ => Directory,
    }
    let weak_room = match p.backing { Sim(b) => store.sim_level_reservation(b.declaration), _ => 0u64 }
    let empty: List[store.FollowerPlan] = list.new()
    let capture = if let Bucket(_) = kind {
        let Some(service) = store.service_bytes(empty) else {
            return Error(Full(Capacity(requested: 18446744073709551615u64, available: limit)))
        }
        add_place_bytes(service, store.follower_starter_bytes()) ?=> Full
    } else { 0u64 }
    let required = add_place_bytes(add_place_bytes(reserved, capture) ?=> Full, weak_room) ?=> Full
    let Some(share) = int.checked_sub(limit, required) else {
        return Error(Full(Capacity(requested: required, available: limit)))
    }
    let (take options, reserved_store) = match store.sized_reservation(kind, share, p.sizes) {
        Ok(take sized) => take sized,
        Error(short) => {
            let cap: Capacity = if let Bucket(_) = kind {
                Capacity(requested: int.saturating_add(required, short.need), available: limit)
            } else { Capacity(requested: short.need, available: short.have) }
            report_store_shortage(report, short, cap)
            return Error(Full(cap))
        },
    }
    if let Bucket(lanes) = kind {
        let plan = match store.follower_plan(kind, options) {
            Ok(take made) => take made,
            Error(short) => {
                let cap: Capacity = Capacity(requested: short.need, available: short.have)
                report_store_shortage(report, short, cap)
                return Error(Full(cap))
            },
        }
        let mut plans: List[store.FollowerPlan] = list.with_capacity(1u64)
        list.push(mut plans, clone(plan))
        let Some(service) = store.service_bytes(plans) else {
            return Error(Full(Capacity(requested: 18446744073709551615u64, available: share)))
        }
        let Some(client) = std.object.lane_reservation(lanes) else {
            return Error(Full(Capacity(requested: 18446744073709551615u64, available: share)))
        }
        let peak_bytes = if let Some(transport_and_service) = int.checked_add(client, service) {
            int.checked_add(transport_and_service, store.follower_starter_bytes())
        } else { None }
        let Some(peak) = peak_bytes else {
            return Error(Full(Capacity(requested: 18446744073709551615u64, available: share)))
        }
        let sim_writer_room = add_place_bytes(reserved_store, weak_room) ?=> Full
        let shared_client = match p.backing { Sim(_) => client, _ => 0u64 }
        return Ok((take options, share, order.max(sim_writer_room, peak) - shared_client, Some(take plan)))
    }
    Ok((take options, share, reserved_store, None))
}

fn report_store_shortage(report: Option[Stderr], short: store.Shortage, cap: Capacity) waits {
    if launch_env().dry_run {
        let _ = launch_emit(string.as_bytes(shortage_text(short, cap)))
    } else if let Some(out) = report {
        let _ = stderr.write(out, shortage_text(short, cap))
    }
}

fn shortage_text(short: store.Shortage, cap: Capacity) -> String {
    let mut line = string.from("place store needs ")
    push_capacity(mut line, cap)
    for i in 0u64 .. list.len(short.parts) {
        let part = view short.parts[i]
        string.push(mut line, " ")
        string.push(mut line, part.0)
        string.push(mut line, "=")
        string.push_u64(mut line, part.1)
    }
    string.push(mut line, "\n")
    take line
}

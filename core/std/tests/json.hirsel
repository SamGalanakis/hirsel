// Contract tests for `json` (core/std/json.hirsel), written to run once an engine runs
// library bodies. Sizes come from the layout in the module header, by hand:
// a tag 1, a Text 4 + its bytes, a container 1 + 4 + 4 + its items + 4 per item, a member
// 4 + its key's bytes + its value.
fn size_of(s: String) -> u64 {
    match json.size(s) {
        Ok(n) => n,
        Error(_) => 999,
    }
}

fn syntax_at(s: String) -> u64 {
    match json.size(s) {
        Error(Syntax(i)) => i,
        _ => 999,
    }
}

fn not_finite_at(s: String) -> u64 {
    match json.size(s) {
        Error(NotFinite(i)) => i,
        _ => 999,
    }
}

// expect: run size_of_mixed() = 73
// 12 is 1 + 4 + 2 = 7; "ab" is 7; [true,30] is 9 + 1 + 7 + 8 = 25; [] is 9;
// the root is 9 + (7 + 7 + 25 + 9) + 16 = 73.
fn size_of_mixed() -> u64 {
    size_of("[12,\"ab\",[true,30],[]]")
}

// expect: run size_ignores_space() = 29
// 9 + (6 + 4) x 2: whitespace takes no bytes.
fn size_ignores_space() -> u64 {
    size_of(" [ 1 , 2 ] ")
}

// expect: run size_of_escapes() = 13
// Decoded: a 1, \n 1, U+00E9 2, the pair U+1F600 4: 8 bytes, and 5 + 8 = 13.
fn size_of_escapes() -> u64 {
    size_of("\"a\\n\\u00e9\\ud83d\\ude00\"")
}

// expect: run size_keeps_duplicates() = 39
// Both members stay in the blob: 9 + 2 x (4 + 1 + 6 + 4).
fn size_keeps_duplicates() -> u64 {
    size_of("{\"a\":1,\"a\":2}")
}

// expect: run size_of_scalars() = 1
fn size_of_scalars() -> u64 {
    size_of("null")
}

// expect: run size_of_negative() = 9
// The spelling "-2.5" is kept: 1 + 4 + 4.
fn size_of_negative() -> u64 {
    size_of("-2.5")
}

// expect: run size_of_empty_object() = 9
fn size_of_empty_object() -> u64 {
    size_of("{ }")
}

// expect: run trailing_comma() = 3
// After "1," the ']' at 3 is where a value must start.
fn trailing_comma() -> u64 {
    syntax_at("[1,]")
}

// expect: run infinite_number() = 1
fn infinite_number() -> u64 {
    not_finite_at("[1e999]")
}

// expect: run leading_zero() = 1
fn leading_zero() -> u64 {
    syntax_at("01")
}

// expect: run lone_low_surrogate() = 1
fn lone_low_surrogate() -> u64 {
    syntax_at("\"\\udc00\"")
}

// expect: run high_surrogate_alone() = 7
// "\ud800 is bytes 0 to 6; byte 7 should start the low half.
fn high_surrogate_alone() -> u64 {
    syntax_at("\"\\ud800x\"")
}

// expect: run unterminated_string() = 3
fn unterminated_string() -> u64 {
    syntax_at("\"ab")
}

// expect: run empty_input() = 0
fn empty_input() -> u64 {
    syntax_at("")
}

// expect: run trailing_bytes() = 2
fn trailing_bytes() -> u64 {
    syntax_at("1 x")
}

// expect: run unknown_escape() = 2
fn unknown_escape() -> u64 {
    syntax_at("\"\\x\"")
}

// expect: run truncated_literal() = 0
fn truncated_literal() -> u64 {
    syntax_at("nul")
}

// First-byte dispatch must still validate the whole keyword. Each literal takes one
// tag byte, so [null,true,false] is 9 +3 tags +3 offsets of4 =24. An unknown UTF-8
// head is Syntax at its first byte, without slicing through a later scalar.
// A mutant accepting any n/t/f head breaks nxll/truX; probing keywords before their
// first-byte branch breaks the unknown non-ASCII head instead of returning Syntax.
// expect: run keyword_dispatch_and_bad_heads() = true
fn keyword_dispatch_and_bad_heads() -> bool {
    size_of("[null,true,false]") == 24 &&
    syntax_at("nxll") == 0 && syntax_at("truX") == 0 && syntax_at("falsX") == 0 &&
    syntax_at("n") == 0 && syntax_at("tru") == 0 && syntax_at("fals") == 0 &&
    syntax_at("truex") == 4 && syntax_at("1x") == 1 &&
    not_finite_at("1e999x") == 0 && syntax_at("€€") == 0 && syntax_at(" [€€]") == 2
}

/// Whether v is a number spelled w.
fn spelled(v: json.Json, w: String) -> bool {
    match v {
        Num(t) => text.as_string(t) == w,
        _ => false,
    }
}

// expect: run parse_reads_items() = 42
// 4 items; item 1 is a Str of 2 bytes; item 3 is an empty Arr: 4 x 10 + 2.
fn parse_reads_items() -> u64 {
    region r {
        match result.unwrap(json.parse(r, "[12,\"ab\",[true,30],[]]")) {
            Arr(xs) => {
                let n = seq.len(xs) * 10
                let b = match indexed.get(xs, 1) {
                    Some(Str(t)) => text.len(t),
                    _ => 0,
                }
                let e = match indexed.get(xs, 3) {
                    Some(Arr(ys)) => seq.len(ys),
                    _ => 99,
                }
                n + b + e
            }
            _ => 0,
        }
    }
}

// expect: run lookup_takes_last() = true
// In {"b":1,"a":2,"b":3}, b is 3 (the last value), a is 2, and c is absent.
fn lookup_takes_last() -> bool {
    region r {
        match result.unwrap(json.parse(r, "{\"b\":1,\"a\":2,\"b\":3}")) {
            Obj(ms) => {
                let x = result.unwrap(json.index(ms))
                let b = match json.get(x, "b") {
                    Some(v) => spelled(v, "3"),
                    None => false,
                }
                let a = match json.get(x, "a") {
                    Some(v) => spelled(v, "2"),
                    None => false,
                }
                let c = match json.get(x, "c") {
                    Some(_) => false,
                    None => true,
                }
                b && a && c
            }
            _ => false,
        }
    }
}

// expect: run render_keeps_first_position() = true
// In {"b":1,"a":2,"b":3}: member 0 shows b with 3, member 1 shows a with 2, member 2 is
// hidden (b was shown at 0), and 3 is past the end.
fn render_keeps_first_position() -> bool {
    region r {
        match result.unwrap(json.parse(r, "{\"b\":1,\"a\":2,\"b\":3}")) {
            Obj(ms) => {
                let x = result.unwrap(json.index(ms))
                let first = match json.shown(x, 0) {
                    Some((k, v)) => k == "b" && spelled(v, "3"),
                    None => false,
                }
                let second = match json.shown(x, 1) {
                    Some((k, v)) => k == "a" && spelled(v, "2"),
                    None => false,
                }
                let third = match json.shown(x, 2) {
                    Some(_) => false,
                    None => true,
                }
                let past = match json.shown(x, 3) {
                    Some(_) => false,
                    None => true,
                }
                first && second && third && past
            }
            _ => false,
        }
    }
}

// expect: run equal_keys_order_by_ordinal() = true
// Three equal keys: the lookup gives the last (3); render shows the first position only.
fn equal_keys_order_by_ordinal() -> bool {
    region r {
        match result.unwrap(json.parse(r, "{\"k\":1,\"k\":2,\"k\":3}")) {
            Obj(ms) => {
                let x = result.unwrap(json.index(ms))
                let last = match json.get(x, "k") {
                    Some(v) => spelled(v, "3"),
                    None => false,
                }
                let shown_once = match (json.shown(x, 0), json.shown(x, 1), json.shown(x, 2)) {
                    (Some((_, v)), None, None) => spelled(v, "3"),
                    _ => false,
                }
                last && shown_once
            }
            _ => false,
        }
    }
}

// RFC 8259: remove insignificant whitespace; keep number spelling and duplicates.
// A comma-before-first or deduplicating printer changes this hand-written text.
// expect: run print_nested_round_trip() = true
fn print_nested_round_trip() -> bool {
    region r {
        let doc = result.unwrap(json.parse(r, " {\"b\": [null, false, true, -0.50e+2], \"b\":{}, \"a\": []} "))
        let mut out = result.unwrap(string.from("prefix:"))
        let _ = result.unwrap(json.push_json(mut out, doc))
        let expected = "{\"b\":[null,false,true,-0.50e+2],\"b\":{},\"a\":[]}"
        let again = result.unwrap(json.parse(r, string.slice(out, 7, string.byte_len(out))))
        let mut second = string.new()
        let _ = result.unwrap(json.push_json(mut second, again))
        string.slice(out, 7, string.byte_len(out)) == expected && second == expected
    }
}

// The short escapes, two hex escapes, quote, backslash, slash and UTF-8 runs.
// Omitting the escaping branch produces either different or invalid JSON.
// expect: run print_escapes_round_trip() = true
fn print_escapes_round_trip() -> bool {
    region r {
        let doc = result.unwrap(json.parse(r, "{\"\\u0000\\u001f\":\"é\\b\\t\\n\\f\\r\\\"\\\\/😀\"}"))
        let mut out = string.new()
        let _ = result.unwrap(json.push_json(mut out, doc))
        let expected = "{\"\\u0000\\u001f\":\"é\\b\\t\\n\\f\\r\\\"\\\\/😀\"}"
        let again = result.unwrap(json.parse(r, out))
        let mut second = string.new()
        let _ = result.unwrap(json.push_json(mut second, again))
        out == expected && second == expected
    }
}

// Syntax is checked before admission. Invalid input under zero capacity stays Syntax;
// valid null needs exactly one rounded8 block, with no parser staging allocation.
// expect: run parse_admission_order() = true
fn parse_admission_order() -> bool {
    result.unwrap(bound bytes 0 {
        region r {
            let bad = match json.parse(r, "[1,]") { Error(Syntax(3)) => true, _ => false }
            let good = match json.parse(r, "null") { Error(Build(Capacity(c))) => c.requested == 8 && c.available == 0, _ => false }
            bad && good
        }
    })
}

// Two exact one-tag blobs remain charged; the third refusal leaves both readable.
// expect: run parse_retains_admitted_prefix() = true
fn parse_retains_admitted_prefix() -> bool {
    result.unwrap(bound bytes 16 {
        region r {
            let a = result.unwrap(json.parse(r, "null"))
            let b = result.unwrap(json.parse(r, "true"))
            let refused = match json.parse(r, "false") { Error(Build(Capacity(c))) => c.requested == 8 && c.available == 0, _ => false }
            refused && match (a, b) { (Null, True) => true, _ => false }
        }
    })
}

// Output GROWTH starts at capacity4, rounded charge8. At limit8, quote+a+\n
// fills it and the next run is refused, keeping exactly those four bytes. At limit16,
// quote+abc fills it; reserving the whole six-byte hex escape requests16 with8 left.
// A printer that appends a hex escape piecemeal leaves a partial \u00 and fails this law.
// expect: run print_capacity_prefixes() = true
fn print_capacity_prefixes() -> bool {
    region r {
        let line = result.unwrap(json.parse(r, "\"a\\nb\""))
        let hex = result.unwrap(json.parse(r, "\"abc\\u0000\""))
        let zero = result.unwrap(bound bytes 0 {
            let mut s = string.new()
            let refused = match json.push_json(mut s, line) { Error(c) => c.requested == 8 && c.available == 0, _ => false }
            refused && s == ""
        })
        let run = result.unwrap(bound bytes 8 {
            let mut s = string.new()
            let refused = match json.push_json(mut s, line) { Error(c) => c.requested == 8 && c.available == 0, _ => false }
            refused && s == "\"a\\n"
        })
        let atomic_hex = result.unwrap(bound bytes 16 {
            let mut s = string.new()
            let refused = match json.push_json(mut s, hex) { Error(c) => c.requested == 16 && c.available == 8, _ => false }
            refused && s == "\"abc"
        })
        zero && run && atomic_hex
    }
}

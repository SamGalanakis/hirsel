fn l79_fold_base(d: Dir, owner: StoreId) -> Result[std.page.PagePtr, Error] waits {
    let mut rows: List[std.page.Entry] = list.with_capacity(3)
    for seq in 0u64 .. 3 {
        list.push(mut rows, std.page.Entry(key: types.key_word(seq), cell: InlineValue(string.into_bytes(string.from("stored")))))
    }
    let image = failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, 40, Collection)))?
    l68_write_page_pack(d, owner, 8, 40, std.page.payload(image))
}

fn l79_fold_parent(d: Dir, owner: StoreId, left: std.page.PagePtr) -> Result[(std.page.PagePtr, std.page.PagePtr), Error] waits {
    let mut rows: List[std.page.Entry] = list.with_capacity(2)
    for seq in 3u64 .. 5 {
        list.push(mut rows, std.page.Entry(key: types.key_word(seq), cell: InlineValue(string.into_bytes(string.from("stored")))))
    }
    let right_leaf = failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, 41, Collection)))?
    let right = l68_write_page_pack(d, owner, 6, 41, std.page.payload(right_leaf))?
    let mut children: List[std.page.Entry] = list.with_capacity(2)
    list.push(mut children, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: left, rows: 3, charge: 258))))
    list.push(mut children, std.page.Entry(key: types.key_word(3), cell: Child(std.page.Branch(child: right, rows: 2, charge: 172))))
    let branch_image = failure_result_from_rep(pages.page_result(std.page.encode(children, 1, 42, Collection)))?
    let root = l68_write_page_pack(d, owner, 10, 42, std.page.payload(branch_image))?
    Ok((root, right))
}

fn l79_fold_trims(first_charge: u64, final_charge: u64) -> Result[Arc[pages.ReplayOverlay], Error] {
    let mut overlay = pager.empty_replay_overlay(Some(3u64))
    let initial = pager.ReplayLogHead(first: 0, next: 3, cold_next: 3, row_bytes: 258)
    let middle = replay_overlay_trim(mut overlay, "j-1", 72, 9, initial, format.JournalTrim(floor: 2, dropped: first_charge))?
    let _ = replay_overlay_trim(mut overlay, "j-1", 90, 9, middle, format.JournalTrim(floor: 3, dropped: final_charge))?
    Ok(take overlay)
}

fn l79_fold_checks(source: pager.TieredPageSource, base: std.page.PagePtr) -> Result[(), Error] waits {
    // Each of the three rows costs 62 + round8(12) + round8(6) = 86.
    failure_result_from_rep(pager.verify_tiered_fold(source, base, l79_fold_trims(172, 86)?))?
    let Error(Corrupt(Fault(why: Malformed, ..))) = failure_result_from_rep(pager.verify_tiered_fold(source, base, l79_fold_trims(180, 78)?)) else {
        fail("L79: individually wrong trim charges passed with the right sum")
    }
    let mut overlay = pager.empty_replay_overlay(None)
    // Force an internal overlay node before placing bad evidence in its last leaf.
    for absent in 3u64 .. 36 {
        failure_result_from_rep(pager.replay_overlay_edit(mut overlay, "j-1", 110, failure_result_from_rep(pager.log_key(9, absent))?, 0, ReplayAbsent))?
    }
    let key = failure_result_from_rep(pager.log_key(9, 36))?
    failure_result_from_rep(pager.replay_overlay_edit(mut overlay, "j-1", 110, key, 7, ReplayAbsent))?
    let Error(Corrupt(Fault(why: Malformed, ..))) = failure_result_from_rep(pager.verify_tiered_fold(source, base, overlay)) else {
        fail("L68: fold accepted a recorded prior for an absent key")
    }
    l79_fold_materializes(source, base)
}

fn l79_fold_materializes(source: pager.TieredPageSource, base: std.page.PagePtr) -> Result[(), Error] waits {
    let mut overlay = pager.empty_replay_overlay(Some(3u64))
    let initial = pager.ReplayLogHead(first: 0, next: 3, cold_next: 3, row_bytes: 258)
    let _ = replay_overlay_trim(mut overlay, "j-1", 72, 9, initial, format.JournalTrim(floor: 2, dropped: 172))?
    let next_key = failure_result_from_rep(pager.log_key(9, 3))?
    failure_result_from_rep(pager.replay_overlay_edit(mut overlay, "j-1", 90, next_key, 0, ReplayPut(arc.new(string.into_bytes(string.from("next"))))))?
    failure_result_from_rep(pager.verify_tiered_fold(source, base, overlay))?
    let limits = pages.LogBoundsRep(first: 0, next: 3)
    let empty = std.page.empty(0, 0, Collection)
    let mut stamp = 41u64
    let mut ignored: Option[List[pager.TieredFoldEffect]] = None
    let kept = failure_result_from_rep(pager.fold_materialize_trim(source, ColdPage(base), empty, limits, 258, 2, mut stamp, mut ignored))?
    let appended = option.unwrap(pager.replay_overlay_at(overlay, next_key))
    let HotPage(take ready) = failure_result_from_rep(pager.fold_materialize_row(source, kept, empty, next_key, appended, 1024, true, 41, mut stamp, mut ignored))? else {
        fail("L79: the overlay append must make a fresh leaf")
    }
    if std.page.totals(ready) != (2u64, 172u64) || std.page.lookup(ready, types.key_word(0)) != None || std.page.lookup(ready, types.key_word(1)) != None || std.page.lookup(ready, types.key_word(2)) != Some(string.as_bytes("stored")) || std.page.lookup(ready, types.key_word(3)) != Some(string.as_bytes("next")) {
        fail("L79: only the retained Cold row and the replay append belong to the fold")
    }
    Ok(())
}

fn l79_cut_table(base: std.page.PagePtr, total_rows: u64, row_bytes: u64, mut next_stamp: u64) -> Result[pages.Roots, Error] {
    let key = failure_result_from_rep(catalog.prefix(9))?
    let mut descriptor = failure_result_from_rep(pages.collection_header(base.stamp, total_rows, row_bytes, 1, ResidentTiered))?
    list.copy_from_slice(mut descriptor, 0, std.page.encode_ptr(base))
    let mut rows: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut rows, std.page.Entry(key: take key, cell: InlineValue(take descriptor)))
    let image = failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, next_stamp, CollectionMap)))?
    next_stamp += 1
    let mut kids: List[std.page.Slot] = list.with_capacity(1)
    list.push(mut kids, ColdPage(base))
    let mut roots = pages.empty_roots()
    roots.collections.root = failure_result_from_rep(pages.page_result(std.page.attach(take image, take kids, list.new())))?
    Ok(take roots)
}

fn l79_cut_candidate(source: pager.TieredPageSource, base: std.page.PagePtr, body: Bytes, mut next_stamp: u64) -> Result[pages.Roots, Error] waits {
    let mut roots = l79_cut_table(base, 3, 258, mut next_stamp)?
    let mut account = pager.ReplayTieredAccount(total: 258, exact: true)
    let change = format.JournalOp(key: failure_result_from_rep(pager.log_key(9, 1))?, value: Some(clone(body)), prior: 7, trim: None)
    replay_tiered_op("j-1", mut roots.collections, mut next_stamp, mut account, pager.ReplayDescriptor(rows: 3, row_bytes: 258, seq_bounds: None), change)?
    let _ = failure_result_from_rep(pager.fold_page_tree(source, mut roots.collections, mut next_stamp))?
    Ok(take roots)
}

fn l79_cut_emits_folded_tree(source: pager.TieredPageSource, base: std.page.PagePtr, owner: StoreId) -> Result[(), Error] waits {
    let mut body: Bytes = list.with_capacity(1025)
    list.fill(mut body, 1025, 77u8)
    let mut stamp = 51u64
    let folded = l79_cut_candidate(source, base, body, mut stamp)?
    let mut holders: List[pages.Roots] = list.with_capacity(2)
    list.push(mut holders, pages.share_roots(folded))
    list.push(mut holders, pages.share_roots(folded))
    let pager.TieredCutFrames(blobs: take cut_blobs, pages: take cut_pages, ..) = failure_result_from_rep(pager.tiered_cut_frames(holders))?
    if list.len(cut_blobs) != 1 || list.len(cut_pages) != 1 || cut_pages[0u64].key != failure_result_from_rep(pager.log_key(9, 0))? || cut_blobs[0u64].key != failure_result_from_rep(pager.log_key(9, 1))? {
        fail("L79: the two holders must share one first-key PAGE and one owning-key BLOB")
    }
    let blob_run = failure_result_from_rep(pager.layout_tiered_packs(take cut_blobs, 4, 11, 4096))?
    let page_run = failure_result_from_rep(pager.layout_tiered_packs(take cut_pages, 3, blob_run.next_pack, 4096))?
    let mut emitted: Map[u64, std.page.PagePtr] = map.new()
    let (take blob_wire, blob_pack) = failure_result_from_rep(pager.encode_tiered_cut_pack(store_key_to_rep(owner), blob_run, blob_run.packs[0u64], mut emitted))?
    let (take page_wire, page_pack) = failure_result_from_rep(pager.encode_tiered_cut_pack(store_key_to_rep(owner), page_run, page_run.packs[0u64], mut emitted))?
    let sealed = failure_result_from_rep(pager.seal_holder_tiered(folded.collections, emitted))?
    if pages.tree_stamp(sealed) != pages.tree_stamp(folded.collections) {
        fail("T6: publishing a physical location must keep the Memory map's planned stamp")
    }
    let key = failure_result_from_rep(catalog.prefix(9))?
    let Some((ColdPage(ptr), descriptor)) = std.page.collection_slot(sealed.root, key) else {
        fail("L79: the prepared holder must name the emitted Tiered root")
    }
    let rows: u64 = list.word_le(descriptor, 36)
    let row_bytes: u64 = list.word_le(descriptor, 44)
    if ptr.pack != 12 || page_pack.class != 3 || blob_pack.class != 4 || blob_pack.live != 1033 || rows != 3 || row_bytes != 1282 {
        fail("L79: the prepared holder must keep the folded descriptor and class order")
    }
    let page = failure_result_from_rep(manifest.read_tiered_frame("p-12", store_key_to_rep(owner), TieredPage(ptr), page_wire, 0, stamp))?
    let leaf = manifest.fold_page(page)
    let Some(ColdBlob(reference)) = std.page.blob_slot(leaf, 0) else {
        fail("L79: the emitted leaf must point to the new Cold BLOB")
    }
    if reference.pack != 11 || reference.len != 1025 {
        fail("L79: the class-3 leaf must name its earlier class-4 body")
    }
    let stored = failure_result_from_rep(manifest.read_tiered_frame("p-11", store_key_to_rep(owner), TieredBlob(reference), blob_wire, 0, stamp))?
    let TieredValue(payload) = view stored.payload else {
        fail("L79: the emitted body must decode as a BLOB")
    }
    if list.compare_bytes(payload, body) != Equal {
        fail("L79: fold emission changed the overlay value")
    }
    if let Some(_) = sealed.replay {
        fail("L79: the prepared holder must have consumed its overlay")
    }
    Ok(())
}

fn l64_fold_with_writer_pin(source: pager.TieredPageSource, base: std.page.PagePtr, parent: std.page.PagePtr, right: std.page.PagePtr) -> Result[(), Error] waits {
    // The fixture's leaf frame occupies all writer room:
    // 16 + 24 + 7 + 3 * (2 + 1 + 1 + 2 + 6 + 2) = 89.
    let demand = pager.TieredPointDemand(target: TieredPage(base), key: types.key_word(2), values: ValuesNone, room: 0, direction: TieredPoint, paths: list.new(), siblings: list.new(), ahead: NoAhead, packs: std.omap.snapshot(source.packs), next_stamp: source.next_stamp, deadline: source.deadline, grant: None)
    let held = failure_result_from_rep(pager.tiered_point_delivery(source.pager, take demand))?
    l79_fold_checks(source, base)?
    let empty = std.page.empty(0, 0, Collection)
    let mut stamp = 43u64
    let mut dropped: Option[List[pager.TieredFoldEffect]] = Some(list.new())
    let ColdPage(survivor) = failure_result_from_rep(pager.fold_materialize_trim(source, ColdPage(parent), empty, pages.LogBoundsRep(first: 0, next: 5), 430, 3, mut stamp, mut dropped))? else {
        fail("L64: the fold must release the cut pin of an unchanged survivor")
    }
    let effects = option.unwrap(take dropped)
    if list.len(effects) != 2 {
        fail("L87(a): trim must replace the old parent and enqueue the detached leaf")
    }
    let FoldDropped(TieredPage(detached)) = effects[1u64] else {
        fail("L87(a): do not read or file detached subtrees during the trim")
    }
    if detached != base {
        fail("L87(a): the drop must retain the exact old Cold location")
    }
    if survivor != right || stamp != 43 {
        fail("L64: a collapsed root must keep its original Cold location")
    }
    if let Some(_) = held.failure {
        fail("L64: the writer's leaf must be readable")
    }
    if pager.CUT_PIN_BYTES != 19944296 || list.len(held.frames) != 1 || pager.tiered_frame_charge(held.frames[0u64]) != 89 {
        fail("L64: the independent fold must retain the full writer pin")
    }
    Ok(())
}

@test
fn test_l79_fold_checks_cold_evidence(d: Dir, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let owner = StoreId(hi: 3, lo: 4)
    let base = l79_fold_base(fixtures, owner)?
    let (parent, right) = l79_fold_parent(fixtures, owner, base)?
    let mut ids = 0u64
    let mut packs: std.omap.OMap[u64, pages.TieredPagerPack] = std.omap.new()
    for ptr in[base, right, parent] {
        let width: u64 = int.widen(ptr.len)
        let inventory = pages.PagePack(class: 3, frames: 1, live: width, payload_bytes: 116 + width, index: 88 + width)
        let (take updated, _) = std.omap.insert(mut ids, packs, ptr.pack, pages.TieredPagerPack(inventory: inventory, object: None))
        packs = take updated
    }
    let (queued_blob, blob_pack) = l87_probe_blob(fixtures, owner)?
    let (take all_packs, _) = std.omap.insert(mut ids, packs, 7u64, pages.TieredPagerPack(inventory: blob_pack, object: None))
    let funding = pager.TieredPagerFunding(cache_bytes: 89, writer_pin_bytes: 89, pager_task_bytes: 1048576, cut_pins: true)
    let (take requests, take worker) = start_tiered_pager(tasks, owner, 0, PagerDirectory(fixtures), funding, 4)?
    let source = pager.TieredPageSource(pager: take requests, packs: take all_packs, next_stamp: 43, deadline: 0)
    let checked = l79_fold_and_emit(source, base, parent, right, queued_blob, owner)
    let _ = take source
    let _ = result.unwrap(task.join(take worker))
    checked
}

fn l79_fold_and_emit(source: pager.TieredPageSource, base: std.page.PagePtr, parent: std.page.PagePtr, right: std.page.PagePtr, queued_blob: std.page.BlobRef, owner: StoreId) -> Result[(), Error] waits {
    l87_probe_queue_roots(source, parent, right, queued_blob)?
    l88_memory_load_restamps(source, parent, queued_blob)?
    l88_tiered_emission_restamps(owner)?
    l87_drain_skips_moved_row(source, parent, right, queued_blob)?
    l64_fold_with_writer_pin(source, base, parent, right)?
    l87_fold_fork_shape(source, parent)?
    l79_cut_emits_folded_tree(source, base, owner)
}

@test
fn test_l70_tiered_sizes_include_cut_quota(d: Dir, tasks: Tasks) -> Result[(), Error] waits {
    let mut overrides = derived_sizes()
    // W = D = q = 2 * 16,711,680 + 1,048,576 = 34,471,936.
    // U = 16,711,680 + 1,048,576 = 17,760,256, so C = W + U = 52,232,192.
    // C + K + D + P + Memory = 52,232,192 + 19,944,296 + 34,471,936
    // + ceil(34,471,936 / 4) + 67,108,864 = 182,375,272.
    let floor = 182375272u64
    overrides.resident_limit = Some(floor - 1)
    let below = sized_with(Directory, 2147483648, overrides) ?=> |_| Missing("tiered test sizing")
    if (below.cache_bytes, below.writer_pin_bytes, below.dirty_bytes, below.pager_task_bytes) != (0u64, 0u64, 0u64, 0u64) {
        fail("L70: the default Tiered plan must include the cut quota")
    }
    overrides.resident_limit = Some(floor)
    let exact = sized_with(Directory, 2147483648, overrides) ?=> |_| Missing("tiered test sizing")
    if (exact.cache_bytes, exact.writer_pin_bytes, exact.dirty_bytes, exact.pager_task_bytes) != (52232192u64, 34471936u64, 34471936u64, 8617984u64) {
        fail("L70: the Tiered plan must fit at the exact resident floor")
    }
    let owner = StoreId(hi: 3, lo: 4)
    let funding = pager.TieredPagerFunding(cache_bytes: exact.cache_bytes, writer_pin_bytes: exact.writer_pin_bytes, pager_task_bytes: exact.pager_task_bytes, cut_pins: true)
    let (take requests, take worker) = start_tiered_pager(tasks, owner, 0, PagerDirectory(d), funding, 1)?
    let _ = failure_result_from_rep(pager.pager_reader_grant(requests, VALUE_LIMIT + MIB))?
    let _ = take requests
    let _ = result.unwrap(task.join(take worker))
    // W + U now demands one extra cache byte at the same q. K stays fixed.
    overrides.readers = Some(VALUE_LIMIT + MIB + 1)
    overrides.resident_limit = Some(floor + 1)
    let readers_fit = sized_with(Directory, 2147483648, overrides) ?=> |_| Missing("tiered test sizing")
    if readers_fit.cache_bytes != 52232192 + 1 || readers_fit.writer_pin_bytes != 34471936 {
        fail("L70: Reader reservations and the separate cut quota must both fit")
    }
    overrides.readers = None
    // At the old floor, 64 MiB fits for both W and D. P is 16 MiB.
    // 268,030,824 - 19,944,296 - 67,108,864 - 16,777,216 - 67,108,864
    // leaves 97,091,584 for C, between W + U = 84,869,120 and 4q = 256 MiB.
    overrides.resident_limit = Some(268030824)
    let mid = sized_with(Directory, 2147483648, overrides) ?=> |_| Missing("tiered test sizing")
    if (mid.cache_bytes, mid.writer_pin_bytes, mid.dirty_bytes, mid.pager_task_bytes) != (97091584u64, 64 * MIB, 64 * MIB, 16 * MIB) {
        fail("L70: the cache must use the remainder after maximizing the quotas")
    }
    // An 88 MiB override is between W + U and the remainder at this q.
    overrides.cache_bytes = Some(88 * MIB)
    let fixed = sized_with(Directory, 2147483648, overrides) ?=> |_| Missing("tiered test sizing")
    if fixed.cache_bytes != 88 * MIB || fixed.writer_pin_bytes != 64 * MIB {
        fail("L70: the cache override must replace the derived cache")
    }
    // The cache at the floor is already exactly W + U.
    overrides.cache_bytes = Some(52232192 - 1)
    let short_cache = sized_with(Directory, 2147483648, overrides) ?=> |_| Missing("tiered test sizing")
    if (short_cache.cache_bytes, short_cache.writer_pin_bytes, short_cache.dirty_bytes, short_cache.pager_task_bytes) != (0u64, 0u64, 0u64, 0u64) {
        fail("L70: the cache override must cover the writer and Reader partitions")
    }
    Ok(())
}

fn l87_probe_blob(d: Dir, owner: StoreId) -> Result[(std.page.BlobRef, pages.PagePack), Error] waits {
    let body = arc.new(string.into_bytes(string.from("queued without a leaf")))
    let frame = manifest.PackFrame(stamp: 39, size: 8 + list.len(body), body: BlobBody(arc.share(body)))
    let mut draft = failure_result_from_rep(pager.begin_tiered_pack(store_key_to_rep(owner), 7, 4, 4096))?
    let place = option.unwrap(failure_result_from_rep(pager.add_tiered_pack_frame(mut draft, frame, 9, failure_result_from_rep(pager.log_key(9, 0))?, fn(stamp: u64) -> std.page.PagePtr {
        fail("L87(c): a BLOB has no children")
    }))?)
    let (take raw, packed) = failure_result_from_rep(pager.finish_tiered_pack(take draft))?
    failure_result_from_rep(manifest.disk_write_synced(d, "p-7", raw))?
    Ok((std.page.BlobRef(stamp: 39, len: list.len(body), checksum: place.checksum, pack: 7, offset: 72, body: 0), packed))
}

fn l87_probe_queue_roots(source: pager.TieredPageSource, parent: std.page.PagePtr, leaf: std.page.PagePtr, queued_blob: std.page.BlobRef) -> Result[(), Error] waits {
    let direct = manifest.blob_index_row(queued_blob, 9, failure_result_from_rep(pager.log_key(9, 0))?)
    let Some(pager.TieredProbePath(target: TieredBlob(found_blob), slots: blob_slots)) = failure_result_from_rep(pager.probe_deferred_root(source, TieredBlob(queued_blob), 7, direct))? else {
        fail("L87(c): a queued BLOB must match without an owning leaf")
    }
    if found_blob != queued_blob || list.len(blob_slots) != 0 {
        fail("L87(c): the matched BLOB is the queue value itself")
    }
    let descendant = manifest.page_index_row(leaf, 9, failure_result_from_rep(pager.log_key(9, 3))?)
    let Some(pager.TieredProbePath(target: TieredPage(found_leaf), slots: leaf_slots)) = failure_result_from_rep(pager.probe_deferred_root(source, TieredPage(parent), 6, descendant))? else {
        fail("L87(c): the queued PAGE must route the index key to its child")
    }
    if found_leaf != leaf || list.len(leaf_slots) != 1 || leaf_slots[0u64] != 1 {
        fail("L87(c): the child is under the queued root's second edge")
    }
    let queued_page = manifest.page_index_row(parent, 9, failure_result_from_rep(pager.log_key(9, 3))?)
    let Some(pager.TieredProbePath(target: TieredPage(found_root), slots: root_slots)) = failure_result_from_rep(pager.probe_deferred_root(source, TieredPage(parent), 10, queued_page))? else {
        fail("L87(a): a queued root itself must compare before descent")
    }
    if found_root != parent || list.len(root_slots) != 0 {
        fail("L87(a): the queue value names the matching root directly")
    }
    Ok(())
}

fn l87_fold_fork_shape(source: pager.TieredPageSource, base: std.page.PagePtr) -> Result[(), Error] waits {
    let mut stamp = 51u64
    let roots = l79_cut_table(base, 5, 430, mut stamp)?
    let mut page_record = manifest.page_manifest_empty(limits_to_rep(default_limits()))
    page_record.next_stamp = stamp
    page_record.account_tiered = 430
    let mut replay = failure_result_from_rep(pager.journal_replay_manifest(failure_result_from_rep(types.capacity(pages.main_state(take roots, 0, 0)))?, page_record))?
    let mut deleted: List[format.JournalOp] = list.with_capacity(1)
    list.push(mut deleted, format.JournalOp(key: failure_result_from_rep(pager.log_key(9, 2))?, value: None, prior: 7, trim: None))
    journal_apply("j-1", mut replay, Commit(format.JournalCommit(branch: 0, version: 1, at: 1, data: take deleted, streams: list.new(), keyed: list.new(), call: None, payload: 0)))?
    journal_apply("j-1", mut replay, Fork(format.JournalFork(id: 1, parent: 0, forked_at: 1, name: "beta", watermark: 60)))?
    journal_apply("j-1", mut replay, l68_replay_put(1, 2, 0, "stored")?)?
    let mut parent_tree = pages.share_page_tree(replay.state.tips[0u64].roots.collections)
    let mut child_tree = pages.share_page_tree(replay.state.tips[1u64].roots.collections)
    stamp = failure_result_from_rep(catalog.stamp_after(replay.next_node))?
    let parent_effects = failure_result_from_rep(pager.fold_page_tree(source, mut parent_tree, mut stamp))?
    let child_effects = failure_result_from_rep(pager.fold_page_tree(source, mut child_tree, mut stamp))?
    let mut observed: List[u64] = list.new()
    for effect in parent_effects {
        let FoldReplaced(frame) = effect else {
            fail("L87(d): the merge replaced pages without detaching a subtree")
        }
        list.push(mut observed, frame.stamp)
    }
    list.sort(mut observed, order.compare)
    if list.len(observed) != 3 || observed[0u64] != 40 || observed[1u64] != 41 || observed[2u64] != 42 || list.len(child_effects) != 0 {
        fail("L87(d): only the parent records both Cold leaves and the Cold parent")
    }
    let map_key = failure_result_from_rep(catalog.prefix(9))?
    let Some((HotPage(parent_rows), _)) = std.page.collection_slot(parent_tree.root, map_key) else {
        fail("L87(d): the parent's fold must materialize the merged leaf")
    }
    let Some((HotPage(child_rows), _)) = std.page.collection_slot(child_tree.root, map_key) else {
        fail("L87(d): the child must materialize its own inherited leaf")
    }
    let parent_image = std.page.image_of(parent_rows)
    let child_image = std.page.image_of(child_rows)
    // Deleting the last key in the left leaf merges the two underfull leaves.
    // Restoring that key in the child stays in its copy of the merged leaf.
    if std.page.level(parent_image) != 0 || std.page.level(child_image) != 0 || std.page.totals(parent_rows) != (4u64, 344u64) || std.page.totals(child_rows) != (5u64, 430u64) || std.page.stamp(parent_image) == std.page.stamp(child_image) {
        fail("L87(d): the child must apply its own edit after materializing the fork-time merge")
    }
    Ok(())
}

fn l87_drain_skips_moved_row(source: pager.TieredPageSource, parent: std.page.PagePtr, older: std.page.PagePtr, queued_blob: std.page.BlobRef) -> Result[(), Error] waits {
    let mut queue = manifest.TieredDeferredQueue(rows: std.omap.new(), issued: 0, next_seq: 0)
    let seq = enqueue_tiered_free(mut queue, manifest.DeferredFree(branch_id: 0, target: TieredPage(parent)))?
    let _ = enqueue_tiered_free(mut queue, manifest.DeferredFree(branch_id: 0, target: TieredPage(older)))?
    let _ = enqueue_tiered_free(mut queue, manifest.DeferredFree(branch_id: 0, target: TieredBlob(queued_blob)))?
    let mut rewritten: Map[u64, ()] = map.new()
    map.insert(mut rewritten, seq, ())
    let first = drain_tiered_frees(source, mut queue, rewritten, 1)?
    if list.len(first) != 1 || first[0u64].frame != manifest.replaced_page(older) || std.omap.len(queue.rows) != 2 || queue.next_seq != 3 {
        fail("L87(a): the drain must skip a rewritten row without spending a page read")
    }
    let (found_seq, kept) = {
        let Some(held) = std.omap.get(queue.rows, seq) else {
            fail("L87(a): a rewritten row must remain in the queue")
        }
        let std.page.Entry(key: order_key, cell: InlineValue(contents)) = manifest.deferred_free_entry(seq, held) else {
            fail("L87(a): a queue row must contain its own PAGE reference")
        }
        let mut page_record = manifest.page_manifest_empty(limits_to_rep(default_limits()))
        page_record.deferred_next = queue.next_seq
        let (found_seq, restored_free) = failure_result_from_rep(manifest.decode_deferred_free("deferred_frees", 72, order_key, contents, page_record))?
        let TieredPage(kept) = restored_free.target else {
            fail("L87(a): a queued PAGE must round-trip as a PAGE")
        }
        (found_seq, kept)
    }
    let mut inventory: Map[u64, pages.PagePack] = map.new()
    let parent_pack = option.unwrap(std.omap.get(source.packs, parent.pack))
    map.insert(mut inventory, parent.pack, clone(parent_pack.inventory))
    failure_result_from_rep(manifest.validate_deferred_target(manifest.RecoveryInventory(packs: view inventory, next_stamp: source.next_stamp, allow_tiered: true), TieredPage(kept)))?
    if found_seq != seq || kept != parent {
        fail("L87(a): T8 must write the retained queue value at its original sequence")
    }
    let second = drain_tiered_frees(source, mut queue, map.new(), 1)?
    if list.len(second) != 1 || second[0u64].frame != manifest.replaced_page(parent) || std.omap.len(queue.rows) != 3 || queue.next_seq != 5 {
        fail("L87(a): a subsequent cut drains the prior rewrite and appends its two children")
    }
    Ok(())
}

fn l88_memory_load_restamps(source: pager.TieredPageSource, root: std.page.PagePtr, body: std.page.BlobRef) -> Result[(), Error] waits {
    let mut next_stamp = 100u64
    let first = failure_result_from_rep(pager.resident_page_from_tiered(source, ColdPage(root), mut next_stamp))?
    let Some(HotPage(found)) = std.page.child_slot(first, 0) else {
        fail("L88(g): the new Memory tree must have resident children")
    }
    if std.page.stamp(std.page.image_of(found)) != 100 || std.page.stamp(std.page.image_of(first)) != 102 || next_stamp != 103 || std.page.totals(first) != (5u64, 430u64) {
        fail("L88(g): the old Cold tree must receive new stamps without changing its rows")
    }
    let mut queued: List[manifest.DeferredFree] = list.new()
    failure_result_from_rep(pager.residency_release(ColdPage(root), 2, mut queued))?
    if list.len(queued) != 1 {
        fail("L88(g): releasing the Cold tree must queue only its root")
    }
    let manifest.DeferredFree(branch_id: 2, target: TieredPage(released)) = queued[0u64] else {
        fail("L88(g): enqueue the old root for its branch")
    }
    if released != root {
        fail("L88(g): the old Cold location must remain a probe root")
    }
    let mut rows: List[std.page.Entry] = list.new()
    list.push(mut rows, std.page.Entry(key: types.key_word(0), cell: BlobValue(body)))
    let image = failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, 60, Collection)))?
    let mut bodies: List[std.page.BlobSlot] = list.new()
    list.push(mut bodies, ColdBlob(body))
    let dirty_root = failure_result_from_rep(pages.page_result(std.page.attach(take image, list.new(), take bodies)))?
    let second = failure_result_from_rep(pager.resident_page_from_tiered(source, HotPage(arc.share(dirty_root)), mut next_stamp))?
    let Some(BlobEdge(moved)) = std.page.owning_edge(std.page.image_of(second), 0) else {
        fail("L88(g): the resident leaf must retain its value body")
    }
    if moved.stamp != 103 || moved.pack != 0 || std.page.stamp(std.page.image_of(second)) != 104 || next_stamp != 105 {
        fail("L88(g): a dirty Tiered leaf and its body must receive fresh stamps")
    }
    failure_result_from_rep(pager.residency_release(HotPage(take dirty_root), 2, mut queued))?
    let Some(manifest.DeferredFree(branch_id: 2, target: TieredBlob(released_body))) = list.get(queued, 1) else {
        fail("L88(g): releasing a Hot leaf must queue the Cold BLOB it reached")
    }
    if released_body != body || list.len(queued) != 2 {
        fail("L88(g): the old Cold BLOB must remain a probe root")
    }
    Ok(())
}

fn l88_tiered_emission_restamps(owner: StoreId) -> Result[(), Error] {
    let mut body: Bytes = list.with_capacity(1025)
    list.fill(mut body, 1025, 77u8)
    let stored: Arc[Bytes] = arc.new(clone(body))
    let mut stamps = 60u64
    let mut memory_root = std.page.empty(0, 0, Collection)
    failure_result_from_rep(pages.page_result(std.page.insert_shared(mut memory_root, types.key_word(1), stored, 1024, 60, mut stamps)))?
    let old_page = std.page.stamp(std.page.image_of(memory_root))
    let Some(BlobEdge(original)) = std.page.owning_edge(std.page.image_of(memory_root), 0) else {
        fail("L88(g): the Memory leaf must own the large value")
    }
    let mut draw = 200u64
    let restamped = failure_result_from_rep(pager.restamp_tiered_emission(HotPage(arc.share(memory_root)), 9, mut draw))?
    let root_stamp = restamped.pages[0u64].frame.stamp
    let body_stamp = restamped.blobs[0u64].frame.stamp
    if root_stamp != 201 || body_stamp != 200 || draw != 202 || std.page.stamp(std.page.image_of(memory_root)) != old_page {
        fail("L88(g): T2 must draw fresh stamps without altering the old Memory holder")
    }
    let for_other_holder = failure_result_from_rep(pager.restamp_tiered_emission(HotPage(arc.share(memory_root)), 9, mut draw))?
    if for_other_holder.pages[0u64].frame.stamp != 203 || for_other_holder.blobs[0u64].frame.stamp != 202 {
        fail("L88(g): independent residency changes must not share stamped frames")
    }
    let pager.TieredCutFrames(blobs: take cut_blobs, pages: take cut_pages, ..) = take restamped
    let blob_run = failure_result_from_rep(pager.layout_tiered_packs(take cut_blobs, 4, 11, 4096))?
    let page_run = failure_result_from_rep(pager.layout_tiered_packs(take cut_pages, 3, blob_run.next_pack, 4096))?
    let mut emitted: Map[u64, std.page.PagePtr] = map.new()
    let (take body_wire, _) = failure_result_from_rep(pager.encode_tiered_cut_pack(store_key_to_rep(owner), blob_run, blob_run.packs[0u64], mut emitted))?
    let (take page_wire, _) = failure_result_from_rep(pager.encode_tiered_cut_pack(store_key_to_rep(owner), page_run, page_run.packs[0u64], mut emitted))?
    let location = option.unwrap(map.get(emitted, old_page))
    let page = failure_result_from_rep(manifest.read_tiered_frame("p-12", store_key_to_rep(owner), TieredPage(location), page_wire, 0, draw))?
    let Some(ColdBlob(reference)) = std.page.blob_slot(manifest.fold_page(page), 0) else {
        fail("L88(g): the Tiered leaf must carry its BLOB's fresh stamp")
    }
    if reference.stamp != body_stamp || reference.stamp == original.stamp || reference.pack != 11 {
        fail("L88(g): the leaf names the old Memory stamp instead of its class-4 frame")
    }
    let fetched = failure_result_from_rep(manifest.read_tiered_frame("p-11", store_key_to_rep(owner), TieredBlob(reference), body_wire, 0, draw))?
    let TieredValue(bytes_out) = view fetched.payload else {
        fail("L88(g): the fresh class-4 frame must decode as a BLOB")
    }
    if list.compare_bytes(bytes_out, body) != Equal {
        fail("L88(g): changing residency must preserve the stored row")
    }
    Ok(())
}

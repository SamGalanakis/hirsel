// Module harness: agent frames and the prompt view (ADR 0001). The history is
// append-only. A frame moves where the prompt starts and seeds it; a view
// leaves positions out of one request. Neither writes h.entries.

// Opens a frame at `o.base` when it is valid: strictly past the current
// frame, within the log, not starting on a tool result (a call and its result
// are never split), with an inline seed, and with no row at that base yet.
// The section and tool hashes are cleared, so the next plan() appends a
// baseline at or after the base and the System fold never needs an earlier
// entry. Answers whether a frame opened; an invalid open changes nothing.
fn open_frame(mut tx: store.Tx, h: Handles, mut s: Session, take o: FrameOpen) -> Result[bool, Refused] {
    if o.base <= s.frame || o.base > s.next_pos || string.byte_len(o.seed) > INLINE_LIMIT {
        return Ok(false)
    }
    if o.base < s.next_pos {
        if let Some(ToolResult(_, _)) = kept(store.fetch(tx, store.shape(h.entries), o.base))? {
            return Ok(false)
        }
    }
    if let Some(_) = kept(store.fetch(tx, store.shape(h.frames), o.base))? {
        return Ok(false)
    }
    let FrameOpen(base: base, reason: take reason, seed: take seed) = take o
    kept(store.put(mut tx, h.frames, base, Frame(parent: s.frame, reason: take reason, seed: take seed)))?
    s.frame = base
    s.active_sections_hashes = list.new()
    s.active_tools_hash = list.new()
    Ok(true)
}

fn pressure_of(s: Session, run: u64, round: u64) -> Pressure {
    Pressure(frame: s.frame, next_pos: s.next_pos, run: run, round: round)
}

// Asks the pressure hook once, bounded like a gate. Anything but a valid
// OpenFrame continues the run unchanged.
fn pressed[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], mut s: Session, run: u64, round: u64) -> Result[(), Refused] {
    let Some(hook) = a.pressure else {
        return Ok(())
    }
    let go = code.callable(hook)
    let at = pressure_of(s, run, round)
    let ran = bound bytes a.limits.gate_bytes {
        bound steps a.limits.gate_steps {
            go(tx, at)
        }
    }
    if let Ok(Ok(OpenFrame(take o))) = take ran {
        let _ = open_frame(mut tx, h, mut s, take o)?
    }
    Ok(())
}

fn is_result(tx: store.Tx, h: Handles, p: u64) -> Result[bool, Refused] {
    match kept(store.fetch(tx, store.shape(h.entries), p))? {
        Some(ToolResult(_, _)) => Ok(true),
        _ => Ok(false),
    }
}

// The view's omit ranges for one request, clamped to [frame, tail]. A range
// that would split a call from its result is dropped, and at most MAX_OMIT
// are kept. A failing or overrunning view omits nothing.
fn viewed[G: send](tx: store.Tx, h: Handles, a: Agent[G], s: Session, run: u64, round: u64) -> Result[List[Omit], Refused] {
    let mut out: List[Omit] = list.new()
    let Some(hook) = a.prompt_view else {
        return Ok(take out)
    }
    if s.next_pos == 0u64 {
        return Ok(take out)
    }
    let tail = s.next_pos - 1u64
    let go = code.callable(hook)
    let at = pressure_of(s, run, round)
    let ran = bound bytes a.limits.gate_bytes {
        bound steps a.limits.gate_steps {
            go(tx, at)
        }
    }
    let Ok(Ok(take asked)) = take ran else {
        return Ok(take out)
    }
    for r in asked {
        if list.len(out) == MAX_OMIT {
            break
        }
        let from = if r.from < s.frame { s.frame } else { r.from }
        let upto = if r.upto > tail { tail } else { r.upto }
        if from > upto || is_result(tx, h, from)? {
            continue
        }
        if upto < tail && is_result(tx, h, upto + 1u64)? {
            continue
        }
        list.push(mut out, Omit(from: from, upto: upto))
    }
    Ok(take out)
}

fn omitted(omit: List[Omit], p: u64) -> bool {
    for r in omit {
        if r.from <= p && p <= r.upto {
            return true
        }
    }
    false
}

// The model effect's repeat under the agent's charge safety: one first
// dispatch plus at most n duplicates.
fn repeat_of(c: ChargeSafety) -> Repeat {
    match c {
        RequireGuarantee => Once,
        BoundedDuplicate(n) => Repeatable(n + 1u64),
    }
}

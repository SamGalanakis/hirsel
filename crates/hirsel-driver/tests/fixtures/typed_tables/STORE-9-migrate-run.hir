// rule: STORE-9
// expect: run
// A value and key migration rewrites every row under the new schema across
// batches; a row function's error, a failure in it, a key collision or
// cancellation leaves the table unchanged.
@serializable
type Item {
  label: String,
  count: u32,
}

@serializable
type Priced {
  label: String,
  cents: u64,
}

@serializable
type Rejected = Unpriced(u32)

fn price(c: (), key: u32, old: Item) -> Result[(u32, Priced), Rejected] {
  Ok((key, Priced(label: unique old.label, cents: int.widen(old.count) * 100)))
}

// Reverses key order, so the new rows sort the other way round.
fn reverse(c: (), key: u32, old: Item) -> Result[(u64, Item), Rejected] {
  Ok((1000 - int.widen(key), unique old))
}

fn refuse_third(c: (), key: u32, old: Item) -> Result[(u32, Priced), Rejected] {
  if key == 3 {
    return Error(Unpriced(key))
  }
  price(c, key, old)
}

// Overflows on the third row: a failure, not an error.
fn fault_third(c: (), key: u32, old: Item) -> Result[(u32, Priced), Rejected] {
  let step: u8 = if key == 3 {
    255
  } else {
    0
  }
  let overflowed = step + 1
  price(c, key, old)
}

fn collapse(c: (), key: u32, old: Item) -> Result[(u32, Priced), Rejected] {
  Ok((7, Priced(label: unique old.label, cents: 0)))
}

fn items() -> table.Table[u32, Item] {
  table.named("items")
}

fn priced() -> table.Table[u32, Priced] {
  table.named("items")
}

fn reversed() -> table.Table[u64, Item] {
  table.named("items")
}

fn seed(mut s: store.Store, name: String) -> bool {
  store.transact(mut s, seed_rows, name) == Ok(())
}

fn seed_rows(mut tx: store.Tx, info: store.CallInfo, name: String) -> Result[
  (),
  store.TxError
] {
  let t: table.Table[u32, Item] = table.named(name)
  table.create(mut tx, t)?
  for k in 1u32..6u32 {
    table.put(mut tx, t, k, Item(label: f"item {k}", count: k))?
  }
  Ok(())
}

// Nothing of a discarded migration remains: no generation waits to be
// deleted, and the table's keys are its five rows.
fn no_leftovers(a: Authority, mut s: store.Store) -> bool {
  let Ok(snap) = store.snapshot(a, mut s, authority.floor(a)) else {
    return false
  }
  let (low, high) = store.prefix_bounds(b"hirsel.garbage/")
  let mut prefix: List[u8] = []
  bytes.append(mut prefix, b"hirsel.rows/")
  bytes.append(mut prefix, keys.encode("items"))
  let (rows_low, rows_high) = store.prefix_bounds(bytes.from_list(take prefix))
  list.len(store.range(snap, low, high, Ascending(), 10)) == 0 && list.len(
    store.range(snap, rows_low, rows_high, Ascending(), 10)
  ) == 5
}

// The five seeded rows are intact and the table accepts writes again.
fn unchanged(mut s: store.Store) -> bool {
  store.transact(mut s, intact, ()) == Ok(true)
}

fn intact(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[bool, store.TxError] {
  let rows = table.range(tx, items(), Unbounded(), Unbounded(), 10, Ascending())?
  if list.len(rows) != 5 || rows[2] != (3, Item(label: "item 3", count: 3)) {
    return Ok(false)
  }
  if list.len(table.history(tx, "items")?) != 1 {
    return Ok(false)
  }
  table.put(mut tx, items(), 6, Item(label: "item 6", count: 6))?
  Ok(table.delete(mut tx, items(), 6)?)
}

pub type Broken = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Broken] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Broken] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let Ok(side) = io.authority(rt, "side") else {
    return Error(Check())
  }
  let Ok(tasks) = io.tasks(rt) else {
    return Error(Check())
  }
  task.scope(
    tasks,
    fn(sc: Scope) -> Result[(), Broken] {
      scenario(a, side, tasks, sc)
    }
  )
}

fn scenario(a: Authority, side: Authority, tasks: Tasks, sc: Scope) -> Result[
  (),
  Broken
] {
  let mut s = store.open(a, store.default_config()) ? Store
  check(seed(mut s, "items"))?
  // A row function's error and a key collision discard the migration.
  check(
    table.migrate(sc, mut s, items(), priced(), refuse_third, 2) == Error(
      Failed(Unpriced(3))
    )
  )?
  check(no_leftovers(a, mut s) && unchanged(mut s))?
  check(table.migrate(sc, mut s, items(), priced(), collapse, 2) == Error(Collision()))?
  check(no_leftovers(a, mut s) && unchanged(mut s))?
  // A failure in the row function is caught and discards the migration too.
  let faulted = match table.migrate(sc, mut s, items(), priced(), fault_third, 2) {
    Error(Faulted(caught)) => caught.rule == "SEM-1",
    _ => false,
  }
  check(faulted && no_leftovers(a, mut s) && unchanged(mut s))?
  // A scope cancelled before the first batch discards the mark it finds.
  check(canceled_before_first_batch(side, tasks))?
  // Invalid arguments.
  let other: table.Table[u32, Priced] = table.named("other")
  check(
    table.migrate(sc, mut s, items(), other, price, 2) == Error(Table(InvalidInput()))
  )?
  check(
    table.migrate(sc, mut s, items(), priced(), price, 0) == Error(
      Table(InvalidInput())
    )
  )?
  // One more than the default `range_rows` limit, 10000 (storage.md).
  check(
    table.migrate(sc, mut s, items(), priced(), price, 10001) == Error(
      Table(InvalidInput())
    )
  )?
  let missing: table.Table[u32, Item] = table.named("missing")
  let missing_priced: table.Table[u32, Priced] = table.named("missing")
  check(
    table.migrate(sc, mut s, missing, missing_priced, price, 2) == Error(
      Table(NoTable())
    )
  )?
  // `from` must match the current schema.
  check(
    table.migrate(sc, mut s, reversed(), priced(), price_reversed, 2) == Error(
      Table(Schema(KeyMismatch()))
    )
  )?
  // A value migration over three batches.
  check(table.migrate(sc, mut s, items(), priced(), price, 2) == Ok(5))?
  check(no_leftovers(a, mut s))?
  let migrated = store.transact(mut s, check_priced, ())
  check(migrated == Ok(true))?
  // Already at the target schema: nothing to do.
  check(table.migrate(sc, mut s, items(), priced(), price, 2) == Ok(0))?
  // A key migration reverses the stored order and survives reopening.
  check(seed(mut s, "keyed"))?
  let keyed: table.Table[u32, Item] = table.named("keyed")
  let keyed_reversed: table.Table[u64, Item] = table.named("keyed")
  check(table.migrate(sc, mut s, keyed, keyed_reversed, reverse, 3) == Ok(5))?
  store.close(take s) ? Store
  let mut reopened = store.open(a, store.default_config()) ? Store
  let ordered = store.transact(mut reopened, check_reversed, ())
  check(ordered == Ok(true))?
  Ok(())
}

fn price_reversed(c: (), key: u64, old: Item) -> Result[(u32, Priced), Rejected] {
  Ok((7, Priced(label: unique old.label, cents: 0)))
}

// Migrates in a child task cancelled before its first batch: the call
// returns `Canceled` and leaves no mark, no shadow and the table as it was.
// The child's store is over the memory authority `side`.
fn canceled_before_first_batch(side: Authority, tasks: Tasks) -> bool {
  task.scope(
    tasks,
    fn(s: Scope) -> bool {
      let (go_tx, go_rx): (Sender[u8], Receiver[u8]) = channel.open(tasks)
      let h = task.async(
        s,
        fn() -> bool {
          let mut go = take go_rx
          // Returns `Canceled` once the parent cancels this task.
          let _ = channel.receive(tasks, mut go)
          task.scope(
            tasks,
            fn(inner: Scope) -> bool {
              let opened = store.open(side, store.default_config())
              let mut held = match take opened {
                Ok(o) => o,
                Error(_) => return false,
              }
              if !seed(mut held, "items") {
                return false
              }
              let outcome = table.migrate(inner, mut held, items(), priced(), price, 2)
              let canceled = match outcome {
                Error(Canceled(_)) => true,
                _ => false,
              }
              canceled && no_leftovers(side, mut held) && unchanged(mut held)
            }
          )
        }
      )
      task.cancel(s, h)
      let outcome = task.await(s, take h)
      let _ = take go_tx
      outcome
    }
  )
}

fn check_priced(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[
  bool,
  store.TxError
] {
  match table.get(tx, items(), 1) {
    Error(Schema(_)) => (),
    _ => return Ok(false),
  }
  let rows = table.range(tx, priced(), Unbounded(), Unbounded(), 10, Ascending())?
  if rows != [
    (1, Priced(label: "item 1", cents: 100)),
    (2, Priced(label: "item 2", cents: 200)),
    (3, Priced(label: "item 3", cents: 300)),
    (4, Priced(label: "item 4", cents: 400)),
    (5, Priced(label: "item 5", cents: 500))
  ] {
    return Ok(false)
  }
  let history = table.history(tx, "items")?
  let priced_by: Entry[
    fn(c: (), key: u32, old: Item) -> Result[(u32, Priced), Rejected]
  ] = price
  if list.len(history) != 2 || history[1].epoch != 1 || history[1].change != Migrated(
    runner.entry_id(priced_by)
  ) || history[1].key_schema != history[0].key_schema || history[1].value_schema == history[0].value_schema {
    return Ok(false)
  }
  // The new schema takes writes at its own epoch.
  table.put(mut tx, priced(), 6, Priced(label: "item 6", cents: 1))?
  Ok(table.get(tx, priced(), 6)? == Some(Priced(label: "item 6", cents: 1)))
}

fn check_reversed(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[
  bool,
  store.TxError
] {
  let keyed_reversed: table.Table[u64, Item] = table.named("keyed")
  let rows = table.range(tx, keyed_reversed, Unbounded(), Included(997), 2, Ascending())?
  if rows != [
    (995, Item(label: "item 5", count: 5)),
    (996, Item(label: "item 4", count: 4))
  ] {
    return Ok(false)
  }
  Ok(table.get(tx, keyed_reversed, 999)? == Some(Item(label: "item 1", count: 1)))
}

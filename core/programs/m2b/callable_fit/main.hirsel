pub fn main(out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let _ = argv
    let mut output = string.new()
    let _ = string.push_u64(mut output, case_minimal())
    let _ = string.push(mut output, "\n")
    match stdout.write(out, output) {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 2))
    }
}

// The front gets this door in the idle law. Every read request leaves a token
// before it reaches the normal hub. A one-slot queue detects any number of reads.
type ReadTrace: send {
    inbox: Receiver[Input],
    hub: Sender[Input],
    reads: Sender[()],
}

fn trace_requests(take trace: ReadTrace) -> () waits {
    while let Ok(take message) = channel.receive(trace.inbox) {
        if let Read(_, _) = view message {
            let _ = channel.try_send(trace.reads, ())
        }
        if let Error(_) = channel.send(trace.hub, take message) { return }
    }
}

pub fn trace_reads(tasks: Tasks, hub: Door) -> (Door, Receiver[()], Task[()]) {
    let (to, inbox): (Sender[Input], Receiver[Input]) = channel.new(64u64)
    let (reads, received): (Sender[()], Receiver[()]) = channel.new(1u64)
    let job = ReadTrace(inbox: take inbox, hub: channel.sender(hub.to), reads: take reads)
    let actor = task.spawn(tasks, bytes 65536u64, take job, trace_requests)
    (Door(to: take to, text_bytes: hub.text_bytes), take received, take actor)
}

// PROG-4: marked functions may name, call and take another test as a value.
// expect: accept
// expect: run called_failure() = fail Fail
@test
fn success() -> Result[(), ()] {
    Ok(())
}

@test
fn capabilities(out: Stdout, input: Stdin, errors: Stderr, d: Dir, net: Net, clock: Clock, random: Random, env: Env, process: Process, tasks: Tasks) -> Result[(), ()] {
    let cb: fn() -> Result[(), ()] = success
    let _ = cb()
    success()
}

@test
fn accepted() -> Result[(), ()] {
    let cb: fn() -> Result[(), ()] = success
    let _ = cb()
    invoke(success)
}

fn invoke(f: fn() -> Result[(), ()]) -> Result[(), ()] {
    f()
}

@test
fn failure() -> Result[(), ()] {
    fail("test failure")
}

@test
fn called_failure() -> Result[(), ()] {
    failure()
}

// A taken test value is an ordinary callback; the helper need not be a test.
// expect: run callback_failure() = fail Fail
@test
fn callback_failure() -> Result[(), ()] {
    invoke(failure)
}

// Module store: fork history and stream retention journal laws, then the
// Direct alignment and shared-segment fence laws (§3.3b).
// L50 B5. A Bytes value has a four-byte length and two-byte schema tag.
// A 994-byte input therefore contributes 78 + 1000 bytes per stored version.
fn fork_history(mut db: Db) -> Result[Branch, Error] waits {
    law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let mut value: Bytes = list.with_capacity(994)
    list.fill(mut value, 994, 0u8)
    let first = run(mut db, None, (copy_env(rows), copy_env(value)), fn(mut tx, call_env) -> Result[(), Error] {
        for slot_order in 0u64 .. 6 {
            put(mut tx, call_env.0, 6 - slot_order, call_env.1)?
        }
        Ok(())
    })?
    let Committed(_) = first else {
        return Error(Foreign)
    }
    if accounts(db).logical != 6728 {
        return Error(Foreign)
    }
    let saved = snapshot(db)
    let (beta, _) = fork(mut db, "beta", saved)?
    if accounts(db).logical != 6728 || !accounts(db).exact {
        return Error(Foreign)
    }
    let _ = list.set(mut value, 0, 1u8)
    let updated = run_on(mut db, beta, None, (copy_env(rows), copy_env(value)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.0, 6, call_env.1)
    })?
    let Committed(done) = updated else {
        return Error(Foreign)
    }
    durable(mut db, done.ticket)?
    if accounts(db).logical != 7806 {
        return Error(Foreign)
    }
    Ok(beta)
}

@test
fn journal_test_fork_history(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 1048576
    options.resident_limit = 7806
    let mut mem = memory(c, r, options)
    let _ = deploy_result(fork_history(mut mem))?
    deploy_result(close(take mem))?
    let child = disk_test_directory(d)
    let scratch = disk_test_directory(d)
    let mut db = deploy_result(open(tasks, child, c, r, options))?
    db.fence = 1
    let beta = deploy_result(fork_history(mut db))?
    let mut attempt: Bytes = list.with_capacity(16)
    list.fill(mut attempt, 16, 17u8)
    let captured = begin_export_copy(mut db, scratch, result.unwrap(copied(attempt)), 0)?
    let exported = export_copy(take captured)?
    let from_export = open_export(exported.dir, c, attempt, options)?
    if accounts(from_export.db).logical != 7806 {
        return Error(ExportMismatch)
    }
    release_export(mut db, attempt)
    deploy_result(close(take db))?
    let mut again = deploy_result(open(tasks, child, c, r, options))?
    if accounts(again).logical != 7806 || !accounts(again).exact {
        return Error(ExportMismatch)
    }
    let rows = deploy_result(table(mut again, "rows", std.codec.key_u64(), std.codec.of_bytes()))?
    let sibling = deploy_result(snapshot_of(again, beta))?
    let Some(old) = deploy_result(get(result.unwrap(reader(again, 0u64)), snapshot(again), rows, 6))? else {
        return Error(ExportMismatch)
    }
    let Some(new) = deploy_result(get(result.unwrap(reader(again, 0u64)), sibling, rows, 6))? else {
        return Error(ExportMismatch)
    }
    if list.len(old) != 994 || list.len(new) != 994 || old[0] != 0 || new[0] != 1 {
        return Error(ExportMismatch)
    }
    let _ = deploy_result(checkpoint(mut again))?
    if accounts(again).logical != 7806 || !accounts(again).exact {
        return Error(ExportMismatch)
    }
    deploy_result(close(take again))
}

@test
fn stream_age_refusal_survives_longer_retention(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), u64] waits {
    let dir = disk_test_directory(d)
    let mut options = journal_crash_options()
    options.stream_retention_ms = 3600000u64
    let mut before = result.unwrap(open(tasks, dir, c, r, options))
    let time = keyed_time(before)
    let name = StreamKey(caller: Caller(issuer: 2u8, subject: clone(b"age")), id: StreamId(t: time, n: 1u64))
    let raw = result.unwrap(stream_key_bytes(name))
    let digest = digest_for("age")
    if let Admitted(_) = result.unwrap(admit(mut before, name, 0u64, digest)) {} else {
        return Error(1u64)
    }
    let replied = result.unwrap(run(mut before, None, raw, fn(mut tx, tok) -> Result[(), Error] {
        reply(mut tx, tok, 0u64, clone(b"reply"))
    }))
    let Committed(saved) = replied else {
        return Error(2u64)
    }
    result.unwrap(durable(mut before, saved.ticket))
    let no_reply: Option[fn(Error) -> bool] = None
    let advanced = result.unwrap(store_body_at(mut before, 0u64, time + 3600000u64, None, no_reply, fn(mut _tx: Tx) -> Result[(), Error] {
        Ok(())
    }))
    if let Committed(_) = advanced {} else {
        return Error(3u64)
    }
    if let HistoryUnavailable = result.unwrap(admit(mut before, name, 0u64, digest)) {} else {
        return Error(4u64)
    }
    if !stream_reply_is(before, raw, b"reply") {
        return Error(5u64)
    }
    result.unwrap(close(take before))
    options.stream_retention_ms = 10800000u64
    let mut after = result.unwrap(open(tasks, dir, c, r, options))
    if !stream_reply_is(after, raw, b"reply") {
        return Error(6u64)
    }
    if let HistoryUnavailable = result.unwrap(admit(mut after, name, 0u64, digest)) {} else {
        return Error(7u64)
    }
    result.unwrap(close(take after))
    Ok(())
}

fn count_stream_effect(mut db: Db, key: Bytes, effect: u64) -> Ticket waits {
    let saved = result.unwrap(run(mut db, None, (copy_env(key), effect), fn(mut tx, args) -> Result[(), Error] {
        let row = logical_key(1u32, key_word(args.1))?
        let prior = match get_page_row(tx.roots.collections, row) {
            Some(value) => decode_word(value),
            None => 0u64,
        }
        put_bytes(mut tx, 1u32, key_word(args.1), key_word(prior + 1u64))?
        reply(mut tx, args.0, 0u64, key_word(args.1))
    }))
    let Committed(done) = saved else {
        fail("stream effect did not commit")
    }
    done.ticket
}

@test
fn stream_quota_reopen_lost_response(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), u64] waits {
    let dir = disk_test_directory(d)
    let mut options = journal_crash_options()
    options.streams_per_caller_max = 1u64
    options.streams_max = 1u64
    let mut before = result.unwrap(open(tasks, dir, c, r, options))
    result.unwrap(law_table(mut before, "effects", std.codec.key_u64(), std.codec.of_u64()))
    let birth = keyed_time(before)
    let caller = Caller(issuer: 2u8, subject: clone(b"shared"))
    let first = StreamKey(caller: clone(caller), id: StreamId(t: birth, n: 1u64))
    let second = StreamKey(caller: take caller, id: StreamId(t: birth, n: 2u64))
    let first_digest = digest_for("logical X")
    let second_digest = digest_for("logical Y")
    let first_raw = result.unwrap(stream_key_bytes(first))
    let second_raw = result.unwrap(stream_key_bytes(second))
    if let Admitted(_) = result.unwrap(admit(mut before, first, 0u64, first_digest)) {} else {
        return Error(1u64)
    }
    let x = count_stream_effect(mut before, first_raw, 10u64)
    result.unwrap(durable(mut before, x))
    result.unwrap(close(take before))
    // X did not receive its committed response. Reopening still has its reply.
    let mut reopened = result.unwrap(open(tasks, dir, c, r, options))
    match result.unwrap(admit(mut reopened, first, 0u64, first_digest)) {
        Duplicate(saved) if saved.reply == key_word(10u64) => (),
        _ => return Error(2u64),
    }
    if let Admitted(_) = result.unwrap(admit(mut reopened, second, 0u64, second_digest)) {} else {
        return Error(3u64)
    }
    let y = count_stream_effect(mut reopened, second_raw, 20u64)
    result.unwrap(durable(mut reopened, y))
    result.unwrap(close(take reopened))
    // After the eviction the old key cannot run again, even across another open.
    let mut after = result.unwrap(open(tasks, dir, c, r, options))
    if let HistoryUnavailable = result.unwrap(admit(mut after, first, 0u64, first_digest)) {} else {
        return Error(4u64)
    }
    match result.unwrap(admit(mut after, second, 0u64, second_digest)) {
        Duplicate(saved) if saved.reply == key_word(20u64) => (),
        _ => return Error(5u64),
    }
    for effect in[10u64, 20u64] {
        let row = result.unwrap(logical_key(1u32, key_word(effect)))
        match get_page_row(after.heads[0].roots.collections, row) {
            Some(value) if decode_word(value) == 1u64 => (),
            _ => return Error(effect),
        }
    }
    result.unwrap(close(take after))
    Ok(())
}

@test
fn anonymous_startup_scan_keeps_current_open_caller(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), u64] waits {
    let dir = disk_test_directory(d)
    let options = journal_crash_options()
    let mut initial = result.unwrap(open(tasks, dir, c, r, options))
    let birth = keyed_time(initial)
    let old = Caller(issuer: 1u8, subject: clone(b"cohort-a-subject"))
    let later = Caller(issuer: 1u8, subject: clone(b"cohort-z-subject"))
    let active = Caller(issuer: 1u8, subject: clone(b"cohort-n-subject"))
    let digest = digest_for("anonymous cohort")
    for n in 0u64 .. 20u64 {
        let key = StreamKey(caller: clone(old), id: StreamId(t: birth, n: n))
        if let Admitted(_) = result.unwrap(admit(mut initial, key, 0u64, digest)) {} else {
            return Error(1u64)
        }
    }
    let last_old = StreamKey(caller: clone(later), id: StreamId(t: birth, n: 0u64))
    if let Admitted(_) = result.unwrap(admit(mut initial, last_old, 0u64, digest)) {} else {
        return Error(2u64)
    }
    result.unwrap(close(take initial))
    let mut reopened = result.unwrap(open(tasks, dir, c, r, options))
    let mut cursor = result.unwrap(reclaim_startup_streams(mut reopened, anonymous_cursor(), fn(_name: Caller) -> bool {
        false
    }))
    if result.unwrap(stream_control(reopened)).count != 1u64 {
        return Error(3u64)
    }
    let current = StreamKey(caller: clone(active), id: StreamId(t: birth, n: 1u64))
    if let Admitted(_) = result.unwrap(admit(mut reopened, current, 0u64, digest)) {} else {
        return Error(4u64)
    }
    while let Some(take at) = replace(mut cursor, None) {
        cursor = result.unwrap(reclaim_startup_streams(mut reopened, at, fn(name: Caller) -> bool {
            name == active
        }))
    }
    if result.unwrap(stream_control(reopened)).count != 1u64 {
        return Error(5u64)
    }
    let key = result.unwrap(stream_key_bytes(current))
    if stream_now(reopened, key) != (0u64, 1u64) {
        return Error(6u64)
    }
    result.unwrap(close(take reopened))
    Ok(())
}

// §3.3b BL3: all three misalignments refuse before any write, even on tmpfs.
@test
fn journal_test_direct_alignment(d: Dir) -> Result[(), ()] waits {
    let mut file = result.unwrap(host.open(d, "direct", Direct))
    let mut raw: Bytes = list.with_capacity_aligned(8192, 4096)
    list.fill(mut raw, 8192, 53u8)
    let bad_offset = host.write_at(mut file, 1, list.slice(raw, 0, 4096))
    let bad_length = host.write_at(mut file, 0, list.slice(raw, 0, 4095))
    let bad_address = host.write_at(mut file, 0, list.slice(raw, 1, 4097))
    for outcome in[bad_offset, bad_length, bad_address] {
        match outcome {
            Error(WriteError(written: 0, error: Other(22))) => (),
            _ => return Error(()),
        }
    }
    if result.unwrap(host.stat_file(mut file)).size != 0 {
        return Error(())
    }
    result.unwrap(host.write_at(mut file, 0, list.slice(raw, 0, 4096)))
    match host.zero_at(mut file, 4096, 4095) {
        Error(Other(22)) => (),
        _ => return Error(()),
    }
    result.unwrap(host.zero_at(mut file, 4096, 4096))
    result.unwrap(host.close(take file))
    let found = result.unwrap(read_journal_prefix(d, "direct", 8192))
    if list.len(found) != 8192 || list.slice(found, 0, 4096) != list.slice(raw, 0, 4096) {
        return Error(())
    }
    for byte in list.slice(found, 4096, 8192) {
        if byte != 0 {
            return Error(())
        }
    }
    Ok(())
}

@test
fn journal_test_shared_segment_fences(d: Dir) -> Result[(), ()] waits {
    let mut writer = result.unwrap(host.open(d, "fence", ReadWrite))
    let mut first = result.unwrap(host.open(d, "fence", Read))
    let mut second = result.unwrap(host.open(d, "fence", Read))
    if !result.unwrap(host.try_lock_shared(mut first)) || !result.unwrap(host.try_lock_shared(mut second)) {
        return Error(())
    }
    if result.unwrap(host.try_lock(mut writer)) {
        return Error(())
    }
    result.unwrap(host.unlock(mut first))
    if result.unwrap(host.try_lock(mut writer)) {
        return Error(())
    }
    result.unwrap(host.close(take second))
    if !result.unwrap(host.try_lock(mut writer)) || result.unwrap(host.try_lock_shared(mut first)) {
        return Error(())
    }
    result.unwrap(host.close(take writer))
    if !result.unwrap(host.try_lock_shared(mut first)) {
        return Error(())
    }
    result.unwrap(host.close(take first))
    Ok(())
}

// §11.17 scrub. A tour rereads the packs listed at one generation from disk,
// apart from any resident page, and checks every frame envelope. It never
// repairs and never writes.
// The packs a tour may still read. The Db keeps one share; the tour keeps the
// other. A cut that finds its share unique drops it: the tour has ended.
pub type ScrubLease: shareable + send {
    objects: std.omap.OMap[u64, pages.TieredPagerPack],
    packs: List[u64]
}

pub type ScrubPack: send {
    object: Option[pages.HistoryRef],
    seq: u64,
    class: u8,
    frames: u64,
    payload_bytes: u64,
    index: u64
}

pub type ScrubInput {
    input: format.JournalInput,
    path: String,
    context: format.DiskContext,
    checked_pack: PackScan,
    expected: List[std.page.PagePtr],
    slot: u64,
    named: ScrubNamed
}

// A class-3 or class-4 pack's frames against its PACK_INDEX (§13.8). The data
// frames come first and their rows after, so each side folds its (offset,
// length, stamp) triples in order into one chained xxh3 and the pack's end
// compares the two: constant memory and no second read.
type ScrubNamed {
    scratch: Bytes,
    frames: u64,
    rows: u64,
    row_count: u64,
    prev_index: u64,
    last_row: u64
}

pub fn scrub_input(take input: format.JournalInput, take path: String, context: format.DiskContext, take checked_pack: PackScan, take expected: List[std.page.PagePtr]) -> Result[ScrubInput, types.Failure] {
    let scratch = disk_allocation(scoped fn() -> Result[Bytes, types.Failure] {
        let mut zeroed: Bytes = list.with_capacity(32)
        for _ in 0u64 .. 32 {
            list.push(mut zeroed, 0u8)
        }
        Ok(take zeroed)
    })?
    Ok(ScrubInput(input: take input, path: take path, context: context, checked_pack: take checked_pack, expected: take expected, slot: 0, named: ScrubNamed(scratch: take scratch, frames: 0, rows: 0, row_count: 0, prev_index: 0, last_row: 0)))
}

fn scrub_chain(mut scratch: Bytes, digest: u64, offset: u64, len: u64, stamp: u64) -> u64 {
    list.set_word_le(mut scratch, 0, digest)
    list.set_word_le(mut scratch, 8, offset)
    list.set_word_le(mut scratch, 16, len)
    list.set_word_le(mut scratch, 24, stamp)
    std.check.xxh3(scratch, 0, 32)
}

// One PACK_INDEX frame of a class-3 or class-4 pack: its envelope, its place
// in the chain of index frames, and its rows folded for the pack's end.
fn scrub_index_frame(mut reading: ScrubInput, at: u64, mut spent: u64) -> Result[u64, types.Failure] waits {
    let head = scrub_prefix(mut reading.input, reading.path, at, 16, mut spent)?
    let frame = disk_read_frame_head(reading.path, head, at)?
    if frame.size > format.PACK_INDEX_LIMIT {
        return Error(format.disk_fault(reading.path, at, Malformed))
    }
    let payload = disk_stream_payload_counted(mut reading.input, reading.path, reading.context, at, head, frame, frame.size, mut spent)?
    let _ = scan_pack_frame(mut reading.checked_pack, reading.path, at, frame.kind, frame.flags, frame.size, payload)?
    let row_kind = if reading.checked_pack.class == 3 {
        0x21u8
    } else {
        0x22u8
    }
    let (prev, take initial) = start_pack_index(reading.path, at, payload, reading.named.last_row)?
    if prev != reading.named.prev_index {
        return Error(format.disk_fault(reading.path, at, Order))
    }
    let mut cursor = take initial
    while let Some(take row) = next_pack_index(reading.path, at, payload, mut cursor)? {
        if row.kind != row_kind {
            return Error(format.disk_fault(reading.path, at, Malformed))
        }
        reading.named.rows = scrub_chain(mut reading.named.scratch, reading.named.rows, row.offset, int.widen(row.len), row.stamp)
        reading.named.row_count += 1
        reading.named.last_row = row.offset
    }
    reading.named.prev_index = at
    Ok(at + 16 + frame.size)
}

pub fn scrub_pack_pointers(known: PageLocations, seq: u64) -> Result[List[std.page.PagePtr], types.Failure] {
    let mut expected: List[std.page.PagePtr] = list.new()
    let mut members = std.omap.range(known.members.values, Included((seq, 0u64)), Included((seq, 18446744073709551615u64)))
    while let Some(((_, stamp), _)) = std.omap.next(mut members) {
        let location = option.unwrap(disk_index_get(known.frames, stamp))
        types.capacity(list.try_reserve(mut expected, 1))?
        list.push(mut expected, location.place)
    }
    list.sort(mut expected, fn(a: std.page.PagePtr, b: std.page.PagePtr) -> Order {
        order.compare(a.offset, b.offset)
    })
    Ok(take expected)
}

pub fn scrub_prefix(mut input: format.JournalInput, path: String, offset: u64, width: u64, mut spent: u64) -> Result[Bytes, types.Failure] waits {
    let available = order.min(width, format.journal_input_size(input) - offset)
    let raw = journal_read_prefix(mut input, path, offset, available, mut spent)?
    if available < width {
        return Error(format.disk_fault(path, offset, Truncated))
    }
    Ok(take raw)
}

// None is the pack's end, after its frame count and payload bytes match the
// record the generation listed.
pub fn scrub_frame(mut reading: ScrubInput, frames: u64, payload_bytes: u64, at: u64, mut spent: u64) -> Result[Option[u64], types.Failure] waits {
    let has_pointer = reading.slot < list.len(reading.expected)
    if at >= format.journal_input_size(reading.input) {
        if has_pointer {
            return Error(format.disk_fault(reading.path, reading.expected[reading.slot].offset, Checksum))
        }
        if !pack_scan_finished(reading.checked_pack, frames, payload_bytes, at) {
            return Error(format.disk_fault(reading.path, at, Malformed))
        }
        if reading.checked_pack.class >= 3 && (reading.named.row_count != frames || reading.named.rows != reading.named.frames) {
            return Error(format.disk_fault(reading.path, reading.checked_pack.index, Checksum))
        }
        return Ok(None)
    }
    if reading.checked_pack.class >= 3 && at >= reading.checked_pack.index {
        if has_pointer {
            return Error(format.disk_fault(reading.path, reading.expected[reading.slot].offset, Checksum))
        }
        return Ok(Some(scrub_index_frame(mut reading, at, mut spent)?))
    }
    let check_pointer = has_pointer && reading.expected[reading.slot].offset == at
    let frame = read_pack_frame(mut reading.input, reading.path, reading.context, mut reading.checked_pack, at, check_pointer, mut spent)?
    if check_pointer {
        let pointer = reading.expected[reading.slot]
        let width: u64 = int.widen(pointer.len)
        if frame.stamp != Some(pointer.stamp) || width != frame.size || pointer.checksum != frame.checksum {
            return Error(format.disk_fault(reading.path, at, Checksum))
        }
        reading.slot += 1
    }
    let end = at + 16 + frame.size
    if reading.checked_pack.class >= 3 {
        if let Some(stamp) = frame.stamp {
            reading.named.frames = scrub_chain(mut reading.named.scratch, reading.named.frames, at, frame.size, stamp)
        }
    }
    if reading.slot < list.len(reading.expected) && reading.expected[reading.slot].offset < end {
        return Error(format.disk_fault(reading.path, reading.expected[reading.slot].offset, Checksum))
    }
    Ok(Some(end))
}

type ScannedPackFrame {
    stamp: Option[u64],
    size: u64,
    checksum: u64
}

pub fn read_pack_frame(mut input: format.JournalInput, path: String, context: format.DiskContext, mut checked_pack: PackScan, at: u64, check_pointer: bool, mut spent: u64) -> Result[ScannedPackFrame, types.Failure] waits {
    let head = scrub_prefix(mut input, path, at, 16, mut spent)?
    let frame = disk_read_frame_head(path, head, at)?
    let keep = if frame.kind == checked_pack.kind {
        order.min(checked_pack.stamp_at + 8, frame.size)
    } else {
        0
    }
    let (take stamp_bytes, checksum) = if check_pointer && frame.kind == checked_pack.kind {
        let mut captured = disk_allocation(scoped fn() -> Result[Bytes, types.Failure] {
            Ok(list.with_capacity(keep))
        })?
        let plain = scrub_payload(mut input, path, context, at, head, frame, 8 - checked_pack.stamp_at, mut captured, mut spent)?
        (take captured, plain)
    } else {
        (disk_stream_payload_counted(mut input, path, context, at, head, frame, keep, mut spent)?, 0u64)
    }
    let stamp = scan_pack_frame(mut checked_pack, path, at, frame.kind, frame.flags, frame.size, stamp_bytes)?
    Ok(ScannedPackFrame(stamp, size: frame.size, checksum))
}

// Streams one payload: its bound check against the head, and the plain xxh3
// that a located pointer carries, over the payload from skip on (a PAGE's
// whole payload, a BLOB's body after its stamp). keep bytes of the payload
// go to captured.
fn scrub_payload(mut input: format.JournalInput, path: String, context: format.DiskContext, offset: u64, head: Bytes, frame: format.DiskFrameHead, skip: u64, mut captured: Bytes, mut spent: u64) -> Result[u64, types.Failure] waits {
    if frame.size > format.journal_input_size(input) - offset - 16 {
        return Error(format.disk_fault(path, offset, Truncated))
    }
    let keep = list.capacity(captured)
    let mut check = disk_allocation(scoped fn() -> Result[std.check.Xxh3, types.Failure] {
        types.capacity(format.disk_check_start(context, offset, head))
    })?
    let mut plain = std.check.start()
    let begin = offset + 16
    let end = begin + frame.size
    let mut at = begin
    while at < end {
        let start = journal_chunk(mut input, path, at)?
        let part = order.min(end - at, list.len(format.journal_input_chunk(input)) - start)
        std.check.add(mut check, format.journal_input_chunk(input), start, start + part)
        let from = at - begin
        if from + part > skip {
            let low = if from >= skip {
                start
            } else {
                start + (skip - from)
            }
            std.check.add(mut plain, format.journal_input_chunk(input), low, start + part)
        }
        if list.len(captured) < keep {
            let capture = order.min(part, keep - list.len(captured))
            list.append(mut captured, list.slice(format.journal_input_chunk(input), start, start + capture))
        }
        at += part
        spent = int.saturating_add(spent, part)
    }
    if std.check.finish(check) != frame.checksum {
        return Error(format.disk_fault(path, offset, Checksum))
    }
    Ok(std.check.finish(plain))
}

pub fn scrub_leased(scrubs: List[Arc[ScrubLease]], seq: u64) -> bool {
    for held in scrubs {
        for pack in held.packs {
            if pack == seq {
                return true
            }
        }
    }
    false
}

// A share nobody else holds belongs to a tour that ended.
pub fn prune_scrubs(mut scrubs: List[Arc[ScrubLease]]) {
    let mut slot = 0u64
    while slot < list.len(scrubs) {
        let ended = match arc.with_unique(mut scrubs[slot], fn(mut _held: ScrubLease) {}) {
            Some(_) => true,
            None => false
        }
        if ended {
            let _ = list.swap_remove(mut scrubs, slot)
        } else {
            slot += 1
        }
    }
}

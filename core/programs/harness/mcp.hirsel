// Catalog updates are trusted app transactions. Model input never supplies an
// endpoint, a bearer credential, or the remote name to send.
pub opaque type Remote: codec + send {
    server: String,
    definition: String,
    about: String,
    input: String,
    fingerprint: Bytes,
    deferred: bool,
}

pub type Peer {
    net: Net,
    clock: Clock,
    endpoint: mcp.client.Endpoint,
    identity: mcp.rpc.Identity,
}

fn table_name() -> String {
    "harness.mcp_catalog"
}

fn table_spec() -> store.TableSpec[String, Remote] {
    let row_codec: std.codec.Codec[Remote] = std.codec.of()
    store.spec(table_name(), std.codec.key_string(), row_codec)
}

pub fn declare_catalog(mut d: store.Declare) -> Result[store.Table[String, Remote], store.Error] {
    let row_codec: std.codec.Codec[Remote] = std.codec.of()
    let table = store.declare_table(mut d, table_name(), std.codec.key_string(), row_codec)?
    store.finish(mut d, take table)
}

pub fn reserved(name: String) -> bool {
    string.starts_with(name, "mcp__")
}

pub fn offered_name(server: String, name: String) -> String {
    let mut key: Bytes = list.new()
    std.codec.put_key_string(server, mut key)
    std.codec.put_key_string(name, mut key)
    let mut out = string.into_bytes("mcp__")
    let start = list.len(out)
    std.base64.encode(harness.digest(key), mut out)
    // SHA-256 is 32 bytes and produces one padding byte in Base64.
    let end = list.len(out) - 1u64
    list.truncate(mut out, end)
    for i in start .. end {
        match out[i] {
            b'+' => {
                out[i] = b'-'
            },
            b'/' => {
                out[i] = b'_'
            },
            _ => (),
        }
    }
    result.unwrap(string.from_utf8(take out))
}

pub fn about(remote: Remote) -> View[String] in remote {
    view remote.about
}

pub fn input(remote: Remote) -> View[String] in remote {
    view remote.input
}

pub fn fingerprint(remote: Remote) -> View[Bytes] in remote {
    view remote.fingerprint
}

pub fn deferred(remote: Remote) -> bool {
    remote.deferred
}

pub opaque type Listing: send {
    server: String,
    rows: Map[String, Remote],
    rejected: List[mcp.metadata.Malformed]
}

/// Validate the page sequence before entering the write transaction. Read
/// `rejected` for definitions that were excluded from the listing.
pub fn listing(server: String, pages: List[String]) -> Result[Listing, ()] {
    if list.len(pages) == 0u64 {
        return Error(())
    }
    let mut rows: Map[String, Remote] = map.new()
    let mut cursors: Map[String, bool] = map.new()
    let mut malformed: List[mcp.metadata.Malformed] = list.new()
    for i in 0u64 .. list.len(pages) {
        let Ok(fields) = mcp.rpc.object(pages[i]) else {
            return Error(())
        }
        if let Some(cursor) = map.get(fields, "nextCursor") {
            let Some(take cursor_text) = mcp.rpc.text(cursor) else {
                return Error(())
            }
            if i + 1u64 == list.len(pages) || map.contains(cursors, cursor_text) {
                return Error(())
            }
            map.insert(mut cursors, take cursor_text, true)
        } else if i + 1u64 != list.len(pages) {
            return Error(())
        }
        let Ok(take page) = mcp.metadata.tools(pages[i]) else {
            return Error(())
        }
        let mcp.metadata.Listed(tools: take tools, rejected: take issues) = take page
        for take issue in take issues {
            list.push(mut malformed, take issue)
        }
        for tool in tools {
            let raw = mcp.metadata.tool_source(tool)
            let name = mcp.metadata.tool_name(tool)
            let key = offered_name(server, name)
            if map.contains(rows, key) {
                return Error(())
            }
            let mut description = string.from(name)
            if let Some(text) = mcp.metadata.tool_description(tool) {
                string.push(mut description, ": ")
                string.push(mut description, text)
            }
            let mut fingerprint_bytes: Bytes = list.new()
            std.codec.put_key_string(server, mut fingerprint_bytes)
            list.append(mut fingerprint_bytes, string.as_bytes(raw))
            map.insert(mut rows, take key, Remote(server: clone(server), definition: clone(raw), about: take description, input: string.from(mcp.metadata.tool_schema(tool)), fingerprint: harness.digest(fingerprint_bytes), deferred: false))
        }
    }
    Ok(Listing(server: clone(server), rows: take rows, rejected: take malformed))
}

pub fn rejected(next: Listing) -> View[List[mcp.metadata.Malformed]] in next {
    view next.rejected
}

// Deferral is chosen by the trusted importer. The name is the server's wire name.
pub fn defer(mut next: Listing, name: String) -> bool {
    let key = offered_name(next.server, name)
    match map.update(mut next.rows, key, scoped fn(mut remote: Remote) {
        remote.deferred = true
    }) {
        Some(()) => true,
        None => false,
    }
}

pub fn replace(mut tx: store.Tx, table: store.Table[String, Remote], next: Listing) -> Result[(), store.Error] {
    let mut removed: List[String] = list.new()
    {
        let mut old = store.range(tx, table, Unbounded, Unbounded)?
        while let Some((take key, remote)) = store.next_in(tx, mut old)? {
            if remote.server == next.server && !map.contains(next.rows, key) {
                list.push(mut removed, take key)
            }
        }
    }
    for key in removed {
        let _ = store.delete(mut tx, table, key)?
    }
    for (key, remote) in next.rows {
        let prior = store.fetch(tx, table, key)?
        if let Some(row) = prior {
            if row.fingerprint == remote.fingerprint && row.deferred == remote.deferred {
                continue
            }
        }
        store.put(mut tx, table, key, clone(remote))?
    }
    Ok(())
}

pub fn server_id(remote: Remote) -> View[String] in remote {
    view remote.server
}

// The MCP envelope can hold results larger than the journal's inline limit.
// The effect's grant also bounds the allocations used to parse it.
pub const REPLY_LIMIT: u64 = 1048576u64

fn notice(_event: mcp.client.Notice) -> bool {
    true
}

fn with_session[T](peer: Peer, limit: u64, deadline: u64, request: scoped fn(mcp.client.Session) -> Result[T, mcp.client.Error] waits) -> Result[T, mcp.client.Error] waits {
    let mut retried = false
    loop {
        let response = match mcp.client.connect(peer.net, peer.clock, peer.endpoint, None, peer.identity, limit, limit, deadline) {
            Ok(session) => request(session),
            Error(take issue) => Error(take issue),
        }
        match take response {
            Error(SessionExpired) if !retried => {
                retried = true
            },
            take done => return take done,
        }
    }
}

fn discover_pages(peer: Peer, session: mcp.client.Session, limit: u64, deadline: u64) -> Result[List[String], mcp.client.Error] waits {
    let mut pages: List[String] = list.new()
    let mut cursors: Map[String, bool] = map.new()
    let mut params: mcp.rpc.Fields = map.new()
    loop {
        let mut id = string.new()
        string.push_u64(mut id, list.len(pages))
        let reply = mcp.client.call(peer.net, peer.clock, peer.endpoint, session, None, IntegerId(take id), "tools/list", take params, limit, limit, deadline, notice)?
        let mcp.client.Reply(body: take body, ..) = take reply
        let Ok(fields) = mcp.rpc.object(body) else {
            return Error(InvalidMessage)
        }
        list.push(mut pages, take body)
        let Some(cursor) = map.get(fields, "nextCursor") else {
            break
        }
        let Some(take value) = mcp.rpc.text(cursor) else {
            return Error(InvalidMessage)
        }
        if map.contains(cursors, value) {
            return Error(InvalidMessage)
        }
        map.insert(mut cursors, clone(value), true)
        params = map.new()
        mcp.rpc.put(mut params, "cursor", mcp.rpc.typed_json(value))
    }
    Ok(take pages)
}

pub fn discover(peer: Peer, server: String, limit: u64, deadline: u64) -> Result[Listing, harness.Fault] waits {
    // Cursors belong to the session that issued them. Restart at page one
    // after expiration and publish only the listing from the new session.
    let pages = match with_session(peer, limit, deadline, scoped fn(session: mcp.client.Session) -> Result[List[String], mcp.client.Error] waits {
        discover_pages(peer, session, limit, deadline)
    }) {
        Ok(take pages) => take pages,
        Error(InvalidMessage) => return Error(Refused("invalid MCP tool list")),
        Error(take issue) => return Error(wire_fault(take issue)),
    }
    match listing(server, pages) {
        Ok(take rows) => Ok(take rows),
        Error(()) => Error(Refused("invalid MCP tool list")),
    }
}

fn wire_fault(issue: mcp.client.Error) -> harness.Fault {
    match issue {
        InvalidRequest => BadArgs("invalid MCP arguments"),
        Transport(TooLarge) => TooLarge,
        Event(TooLarge) => TooLarge,
        Remote(failure) => Refused(clone(failure.message)),
        SessionExpired => Refused("MCP session expired"),
        _ => Unavailable,
    }
}

fn result_text(body: String) -> Result[Bytes, harness.Fault] {
    let Ok(fields) = mcp.rpc.object(body) else {
        return Error(Unavailable)
    }
    let Some(raw) = map.get(fields, "content") else {
        return Error(Unavailable)
    }
    let Ok(items) = mcp.rpc.array(raw) else {
        return Error(Unavailable)
    }
    let mut out = string.new()
    for i in 0u64 .. list.len(items) {
        let Ok(item) = mcp.rpc.object(items[i]) else {
            return Error(Unavailable)
        }
        if mcp.rpc.field_text(item, "type") != Some("text") {
            return Error(Refused("unsupported MCP content"))
        }
        let Some(text) = mcp.rpc.field_text(item, "text") else {
            return Error(Unavailable)
        }
        if i != 0u64 {
            string.push(mut out, "\n")
        }
        string.push(mut out, text)
    }
    if let Some(err) = map.get(fields, "isError") {
        if err == "true" {
            return Error(Refused(take out))
        }
        if err != "false" {
            return Error(Unavailable)
        }
    }
    Ok(string.into_bytes(take out))
}

// The one Outside body for every catalog row. Keep the RPC call bounded by
// the effect deadline and let the harness's Once policy handle doubt.
pub fn call(peer: Peer, remote: Remote, take args: Bytes, limit: u64, deadline: u64) -> Result[Bytes, harness.Fault] waits {
    let Ok(take arguments) = string.from_utf8(take args) else {
        return Error(BadArgs("invalid MCP arguments"))
    }
    let Ok(tool) = mcp.metadata.definition(remote.definition) else {
        return Error(Refused("invalid MCP definition"))
    }
    if let Error(_) = mcp.rpc.object(arguments) {
        return Error(BadArgs("invalid MCP arguments"))
    }
    let reply = std.result.map_err(with_session(peer, limit, deadline, scoped fn(session: mcp.client.Session) -> Result[mcp.client.Reply, mcp.client.Error] waits {
        mcp.client.call_tool(peer.net, peer.clock, peer.endpoint, session, None, TextId("call"), tool, string.from(arguments), None, limit, limit, deadline, notice)
    }), fn(take issue) -> harness.Fault {
        wire_fault(take issue)
    })?
    result_text(reply.body)
}

pub type Grant: codec = Dir(String) | Clock | Random | Tasks | Stdin | Stdout | Stderr | Process | Net(NetRule) | Env(List[String]) | Secret(parameter: String, source: Binding, policy: String) | Cred(parameter: String, source: String, policy: String) | Foreign(String) | Exec(policy: String, profiles: List[String])

pub type NetRule: codec = Listen(cidr: String, first_port: u16, last_port: u16) | Connect(cidr: String, first_port: u16, last_port: u16) | UnixRoot(label: String, path: String) | UnixListen(label: String, path: String) | UnixConnect(label: String, path: String) | Resolve(String) | Tls(String)

pub type Binding: codec = Environment(String) | File(String)

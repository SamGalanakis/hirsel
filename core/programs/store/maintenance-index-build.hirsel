// The index builder (STORE-SPEC §1.2). An index record is Backfilling while
// its entries are incomplete. A chunk reads up to INDEX_CHUNK rows after the
// record's cursor at the current head, writes their entries and moves the
// cursor in the same schema plan, so the cursor never commits apart from
// its entries. The chunk that reaches the table's end publishes the index.
// Every write maintains a Backfilling index as it maintains a Public one, so
// a row written after the record exists is right on either side of the cursor.
// The rows one chunk reads: STORE-SPEC §1.2 says why 4,096.
pub const INDEX_CHUNK: u64 = 4096

// Up to `limit` rows of table `table_id` after `cursor`, read from resident
// roots. The flag says the table has no rows past the last one returned.
pub fn resident_rows_after(roots: pages.Roots, table_id: u32, cursor: Option[Bytes], limit: u64) -> Result[(List[(Bytes, Bytes)], bool), types.Failure] {
    let start: std.omap.Bound[Bytes] = match cursor {
        Some(final_key) => {
            let mut k = catalog.prefix(table_id)?
            list.append(mut k, final_key)
            Excluded(take k)
        },
        None => Included(catalog.prefix(table_id)?),
    }
    let mut rows = read.byte_cursor(roots.collections, take start, catalog.prefix(table_id + 1)?)?
    let mut out: List[(Bytes, Bytes)] = list.new()
    while list.len(out) < limit {
        let Some((take key, raw)) = catalog.next_bytes(mut rows)? else {
            return Ok((take out, true))
        }
        list.push(mut out, (take key, types.copied(raw)?))
    }
    let done = match catalog.next_bytes(mut rows)? {
        Some(_) => false,
        None => true,
    }
    Ok((take out, done))
}

// A collection's row count from its descriptor, 0 when the map has no entry.
pub fn collection_rows(tree: pages.PageTree, id: u32) -> u64 {
    let Ok(key) = catalog.prefix(id) else {
        return 0
    }
    match pages.collection_by_key(tree, key) {
        Some(found) => found.rows,
        None => 0,
    }
}

// One chunk over `rows`, which follow the record's cursor in key order. It
// returns the first two primary keys found under one Unique key. Outside a
// preview that ends the chunk with `plan` untouched; a preview skips the
// later row and keeps building, as the scratch index keeps one row per key.
pub fn index_chunk(mut plan: catalog.SchemaPlan, key: Bytes, take chunk_record: indexes.Catalog, extractor: indexes.RegisteredIndex, rows: List[(Bytes, Bytes)], done: bool, preview: bool, record_steps: bool, mut steps: List[transfer.StepOp]) -> Result[Option[(Bytes, Bytes)], types.Failure] {
    let mut record = take chunk_record
    let mut roots = pages.share_roots(plan.roots)
    let mut live_bytes = plan.live
    let first = catalog.stamp_after(plan.next_node)?
    let mut next_stamp = first
    let mut duplicate: Option[(Bytes, Bytes)] = None
    let mut cursor: Option[Bytes] = None
    let mut chunk_steps: Option[List[transfer.StepOp]] = if record_steps {
        Some(list.new())
    } else {
        None
    }
    if let Sums = indexes.catalog_index(record)?.shape {
        add_chunk_totals(mut roots.collections, mut live_bytes, plan.retained, plan.ceiling, first, mut next_stamp, extractor, rows, mut chunk_steps)?
        if let Some((logical, _)) = list.last(rows) {
            cursor = Some(types.copied(list.slice(logical, 4, list.len(logical)))?)
        }
    } else {
        for (logical, raw) in rows {
            let primary = list.slice(logical, 4, list.len(logical))
            let values = indexes.extract_row(extractor, raw, primary)?
            for row in values.keys {
                if list.len(row) > 4096 {
                    return Error(Limit(Key))
                }
                let prior_width = format.stored_prior(pages.get_page_row(roots.collections, row))
                if let Some(prior) = pages.get_page_row(roots.collections, row) {
                    if let Entries(UniqueEntry) = indexes.catalog_index(record)?.shape {
                        let owner = list.slice(prior, 4, indexes.unique_owner_end(prior)?)
                        if owner != primary {
                            if let None = duplicate {
                                duplicate = Some((types.copied(owner)?, types.copied(primary)?))
                            }
                            if !preview {
                                return Ok(take duplicate)
                            }
                            continue
                        }
                    }
                    if !plan.retained {
                        live_bytes = int.saturating_sub(live_bytes, txn.entry(row, prior))
                    }
                }
                live_bytes = int.saturating_add(live_bytes, txn.entry(row, values.payload))
                catalog.over_ceiling(live_bytes, plan.ceiling)?
                pages.put_page_row(mut roots.collections, row, values.payload, first, mut next_stamp)?
                if let Some(mut step_rows) = chunk_steps {
                    types.capacity(list.try_reserve(mut step_rows, 1))?
                    list.push(mut step_rows, transfer.StepOp(key: types.copied(row)?, value: Some(types.copied(values.payload)?), prior: prior_width))
                }
            }
            cursor = Some(types.copied(primary)?)
        }
    }
    pages.canonical_tree(mut roots.collections)?
    plan.next_node = next_stamp - 1
    if done {
        indexes.set_index_state(mut record, Public)?
    } else if let Some(take final_key) = take cursor {
        indexes.set_index_state(mut record, Backfilling(Some(take final_key)))?
    }
    let raw = indexes.encode_catalog(record)?
    live_bytes = txn.catalog_recharge(live_bytes, roots, key, raw, plan.retained)
    roots = catalog.catalog_insert(mut plan.next_node, roots, key, raw)?
    let next_table = plan.next_table
    catalog.keep_schema(mut plan, take roots, live_bytes, next_table)?
    if let Some(take ops) = take chunk_steps {
        for take op in take ops {
            types.capacity(list.try_reserve(mut steps, 1))?
            list.push(mut steps, take op)
        }
    }
    Ok(take duplicate)
}

// A declaration's build runs inside the declaration's plan, so the index
// publishes with the schema commit that declares it. A preview reports the
// rows it read and wrote. An entry index is built bottom up (AP13): one pass
// extracts every row's entries, charging each to the workspace as it is
// kept, a sort orders them, and the collection built from them replaces the
// one the record had. A Backfilling record is rebuilt whole the same way: a
// write keeps its entries ahead of the cursor, so the result is the same.
// Inserting chunk by chunk copied every page a chunk touched once per chunk,
// and grew faster than the rows (store-child-build-2660). An aggregate keeps
// the chunked builder: its group rows add up parts, which a sort does not.
pub fn build_declared_index(mut plan: catalog.SchemaPlan, key: Bytes, record: indexes.Catalog, extractor: indexes.RegisteredIndex, preview: bool) -> Result[(Option[(Bytes, Bytes)], u64, u64), types.Failure] {
    if let Sums = indexes.catalog_index(record)?.shape {
        return chunked_declared_index(mut plan, key, record, extractor, preview)
    }
    let unique = if let Entries(UniqueEntry) = indexes.catalog_index(record)?.shape {
        true
    } else {
        false
    }
    let mut extracted: List[std.page.Row] = list.new()
    let mut read_count = 0u64
    let mut workspace = plan.live
    {
        let mut rows = read.byte_cursor(plan.roots.collections, Included(catalog.prefix(record.owner)?), catalog.prefix(record.owner + 1)?)?
        while let Some((take logical, raw)) = catalog.next_bytes(mut rows)? {
            read_count += 1
            extract_entries(mut extracted, mut workspace, plan.ceiling, extractor, logical, raw)?
        }
    }
    bulk_declared_index(mut plan, key, record, unique, take extracted, read_count, preview)
}

// One row's entries for a bottom-up build, each charged to `workspace` as it
// is kept.
pub fn extract_entries(mut extracted: List[std.page.Row], mut workspace: u64, ceiling: u64, extractor: indexes.RegisteredIndex, logical: Bytes, raw: Bytes) -> Result[(), types.Failure] {
    let primary = list.slice(logical, 4, list.len(logical))
    let values = indexes.extract_row(extractor, raw, primary)?
    for row in values.keys {
        if list.len(row) > 4096 {
            return Error(Limit(Key))
        }
        let charge = txn.entry(row, values.payload)
        workspace = int.saturating_add(workspace, charge + 8)
        catalog.over_ceiling(workspace, ceiling)?
        types.capacity(list.try_reserve(mut extracted, 1))?
        list.push(mut extracted, std.page.Row(key: types.copied(list.slice(row, 4, list.len(row)))?, value: types.copied(values.payload)?, charge: charge))
    }
    Ok(())
}

// Sorts the extracted entries and builds the collection from them, which
// replaces the one the record had (AP13).
pub fn bulk_declared_index(mut plan: catalog.SchemaPlan, key: Bytes, record: indexes.Catalog, unique: bool, take found: List[std.page.Row], read: u64, preview: bool) -> Result[(Option[(Bytes, Bytes)], u64, u64), types.Failure] {
    let mut extracted = take found
    // The sort keeps rows of one key in primary order, so the first is the
    // owner the chunked builder kept. The pair reported is the one a scan in
    // primary order meets first: the least repeating primary key.
    sort_bulk_rows(mut extracted)?
    let mut duplicate: Option[(Bytes, Bytes)] = None
    let mut kept: List[std.page.Row] = list.new()
    types.capacity(list.try_reserve(mut kept, list.len(extracted)))?
    for take row in take extracted {
        if let Some(previous) = list.last(kept) {
            if previous.key == row.key {
                if unique {
                    let owner = list.slice(previous.value, 4, indexes.unique_owner_end(previous.value)?)
                    let second = list.slice(row.value, 4, indexes.unique_owner_end(row.value)?)
                    let earlier = match view duplicate {
                        Some((_, met)) => second < met,
                        None => true,
                    }
                    if owner != second && earlier {
                        duplicate = Some((types.copied(owner)?, types.copied(second)?))
                    }
                }
                continue
            }
        }
        list.push(mut kept, take row)
    }
    if !preview {
        if let Some(_) = duplicate {
            return Ok((take duplicate, read, 0))
        }
    }
    let mut current = copied_record(record)?
    let mut roots = pages.share_roots(plan.roots)
    let mut live_bytes = plan.live
    let former = catalog.remove_store_collection(mut roots.collections, current.id, mut plan.next_node)?
    if !plan.retained {
        live_bytes = int.saturating_sub(live_bytes, former)
    }
    live_bytes = int.saturating_add(live_bytes, 126)
    for row in kept {
        live_bytes = int.saturating_add(live_bytes, row.charge)
    }
    catalog.over_ceiling(live_bytes, plan.ceiling)?
    let written = list.len(kept)
    catalog.bulk_store_collection(mut roots.collections, current.id, 2, take kept, mut plan.next_node)?
    // F4: mark the replaced collection id superseded so a non-empty bulk
    // redefinition under an export lease is caught as Drift at the cut.
    types.capacity(list.try_reserve(mut plan.superseded, 1))?
    list.push(mut plan.superseded, current.id)
    indexes.set_index_state(mut current, Public)?
    let raw = indexes.encode_catalog(current)?
    live_bytes = txn.catalog_recharge(live_bytes, roots, key, raw, plan.retained)
    roots = catalog.catalog_insert(mut plan.next_node, roots, key, raw)?
    let next_table = plan.next_table
    catalog.keep_schema(mut plan, take roots, live_bytes, next_table)?
    Ok((take duplicate, read, written))
}

// An aggregate's declared build: every chunk runs in the declaration's plan.
fn chunked_declared_index(mut plan: catalog.SchemaPlan, key: Bytes, record: indexes.Catalog, extractor: indexes.RegisteredIndex, preview: bool) -> Result[(Option[(Bytes, Bytes)], u64, u64), types.Failure] {
    let mut current = copied_record(record)?
    let mut read = 0u64
    let mut duplicate: Option[(Bytes, Bytes)] = None
    let mut no_steps: List[transfer.StepOp] = list.new()
    loop {
        let cursor = match indexes.catalog_index(current)?.state {
            Backfilling(Some(final_key)) => Some(types.copied(final_key)?),
            _ => None,
        }
        let (take rows, done) = resident_rows_after(plan.roots, current.owner, cursor, INDEX_CHUNK)?
        read += list.len(rows)
        let found = index_chunk(mut plan, key, copied_record(current)?, extractor, rows, done, preview, false, mut no_steps)?
        if let Some(take pair) = take found {
            if !preview {
                return Ok((Some(take pair), read, 0))
            }
            if let None = duplicate {
                duplicate = Some(take pair)
            }
        }
        current = indexes.catalog_entry_in(plan.roots.catalog, key)?
        if let Public = indexes.catalog_index(current)?.state {
            break
        }
    }
    let written = match std.page.collection_child(plan.roots.collections.root, catalog.prefix(record.id)?) {
        Some(root) => {
            let (rows, _) = std.page.totals(root)
            rows
        },
        None => 0u64,
    }
    Ok((take duplicate, read, written))
}

pub fn copied_record(record: indexes.Catalog) -> Result[indexes.Catalog, types.Failure] {
    indexes.decode_catalog(indexes.encode_catalog(record)?)
}

// The first index on main's head whose record is Backfilling and whose
// extractor this release binds, with its catalog key and record. An index
// this release does not bind waits for the release that declares it.
pub fn building_index(catalog_tree: pages.PageTree, owner: indexes.IndexOwner) -> Result[Option[(Bytes, indexes.Catalog)], types.Failure] {
    let mut first_key: Bytes = list.new()
    list.push(mut first_key, 2u8)
    let mut end_key: Bytes = list.new()
    list.push(mut end_key, 3u8)
    let mut records = read.byte_cursor(catalog_tree, Included(take first_key), end_key)?
    while let Some((take key, raw)) = catalog.next_bytes(mut records)? {
        if catalog.record_public(raw) {
            continue
        }
        let record = indexes.decode_catalog(raw)?
        let building = if let Backfilling(_) = indexes.catalog_index(record)?.state {
            true
        } else {
            false
        }
        if building {
            if let Some(_) = indexes.bound_extractor(owner, record) {
                return Ok(Some((take key, take record)))
            }
        }
    }
    Ok(None)
}

// The name of the first index in `catalog` whose record is not Public.
pub fn unready_index(catalog_tree: pages.PageTree) -> Result[Option[String], types.Failure] {
    let mut first_key: Bytes = list.new()
    list.push(mut first_key, 2u8)
    let mut end_key: Bytes = list.new()
    list.push(mut end_key, 3u8)
    let mut records = read.byte_cursor(catalog_tree, Included(take first_key), end_key)?
    while let Some((key, raw)) = catalog.next_bytes(mut records)? {
        if !catalog.record_public(raw) {
            return Ok(Some(catalog.declaration_index_name(key)?))
        }
    }
    Ok(None)
}

pub fn put_index_record(mut plan: catalog.SchemaPlan, key: Bytes, record: indexes.Catalog) -> Result[(), types.Failure] {
    let raw = indexes.encode_catalog(record)?
    let live_bytes = txn.catalog_recharge(plan.live, plan.roots, key, raw, plan.retained)
    let roots = catalog.catalog_insert(mut plan.next_node, plan.roots, key, raw)?
    let next_table = plan.next_table
    catalog.keep_schema(mut plan, take roots, live_bytes, next_table)
}

// Bytes [at, at + 8) of `key` as a big-endian word, zero past its end: two
// keys equal before `at` whose words differ order as their words do.
fn key_word_at(key: Bytes, at: u64) -> u64 {
    if list.len(key) >= at + 8 {
        let word: u64 = list.word_be(key, at)
        return word
    }
    let mut word = 0u64
    for i in at .. at + 8 {
        word = word << 8
        if i < list.len(key) {
            word = word | int.widen(key[i])
        }
    }
    word
}

// Orders rows by key, rows of one key in their present order. The sort runs
// over (first word, second word, position) triples held in one list, and
// reads two rows' keys only where both words tie: comparing through each
// row's own key buffer missed the cache on every step, and that grew with
// the rows (store 2660).
pub fn sort_bulk_rows(mut rows: List[std.page.Row]) -> Result[(), types.Failure] {
    let mut order_keys: List[(u64, u64, u64)] = list.new()
    let n = list.len(rows)
    types.capacity(list.try_reserve(mut order_keys, n))?
    for slot in 0u64 .. n {
        let key = view rows[slot].key
        list.push(mut order_keys, (key_word_at(key, 0), key_word_at(key, 8), slot))
    }
    list.sort(mut order_keys, scoped fn(a: (u64, u64, u64), b: (u64, u64, u64)) -> Order {
        if a.0 != b.0 {
            return order.compare(a.0, b.0)
        }
        if a.1 != b.1 {
            return order.compare(a.1, b.1)
        }
        match list.compare_bytes(rows[a.2].key, rows[b.2].key) {
            Equal => order.compare(a.2, b.2),
            different => different,
        }
    })
    let mut positions: List[u64] = list.new()
    types.capacity(list.try_reserve(mut positions, n))?
    for (_, _, slot) in order_keys {
        list.push(mut positions, slot)
    }
    order_keys = list.new()
    for first in 0u64 .. n {
        let mut at = first
        let mut source = positions[at]
        while source != first {
            list.swap(mut rows, at, source)
            positions[at] = at
            at = source
            source = positions[at]
        }
        positions[at] = at
    }
    Ok(())
}

// A build chunk's totals: each row's groups and values, gathered and
// sorted by group, then added to each group's totals in one write.
fn add_chunk_totals(mut collections: pages.PageTree, mut live_bytes: u64, retained: bool, ceiling: u64, first: u64, mut next_stamp: u64, extractor: indexes.RegisteredIndex, rows: List[(Bytes, Bytes)], mut written_ops: Option[List[transfer.StepOp]]) -> Result[(), types.Failure] {
    let mut parts: List[indexes.GroupPart] = list.new()
    for (logical, raw) in rows {
        let primary = list.slice(logical, 4, list.len(logical))
        let indexes.IndexValue(keys: take keys, sums: take sums, ..) = indexes.extract_row(extractor, raw, primary)?
        let mut at = 0u64
        for take group in take keys {
            list.push(mut parts, indexes.GroupPart(key: take group, value: sums[at]))
            at += 1
        }
    }
    let (take groups, take counts, take added_sums) = indexes.merged_groups(take parts)?
    for at in 0u64 .. list.len(groups) {
        let group = view groups[at]
        let added = counts[at]
        let total = added_sums[at]
        let prior_width = format.stored_prior(pages.get_page_row(collections, group))
        let (members, sum) = match pages.get_page_row(collections, group) {
            Some(prior) => {
                if !retained {
                    live_bytes = int.saturating_sub(live_bytes, txn.entry(group, prior))
                }
                indexes.group_totals(prior)?
            },
            None => (0u64, 0u64),
        }
        let Some(next_sum) = int.checked_add(sum, total) else {
            return Error(Limit(Value))
        }
        let value = indexes.totals_bytes(members + added, next_sum)?
        live_bytes = int.saturating_add(live_bytes, txn.entry(group, value))
        catalog.over_ceiling(live_bytes, ceiling)?
        pages.put_page_row(mut collections, group, value, first, mut next_stamp)?
        if let Some(mut step_rows) = written_ops {
            types.capacity(list.try_reserve(mut step_rows, 1))?
            list.push(mut step_rows, transfer.StepOp(key: types.copied(group)?, value: Some(types.copied(value)?), prior: prior_width))
        }
    }
    Ok(())
}

// Demotes an index to Backfilling(None) over an empty collection (§I.3), so
// reads refuse it and the builder rebuilds it from the table's first row.
// An index already Backfilling(None) is left as it is.
// Answers whether the record changed.
pub fn demote_index(mut plan: catalog.SchemaPlan, key: Bytes) -> Result[bool, types.Failure] {
    let mut record = indexes.catalog_entry_in(plan.roots.catalog, key)?
    if let Backfilling(None) = indexes.catalog_index(record)?.state {
        return Ok(false)
    }
    let mut roots = pages.share_roots(plan.roots)
    let id = record.id
    let tiered = transfer.table_is_tiered(roots.collections, id)?
    let charge = catalog.remove_store_collection(mut roots.collections, id, mut plan.next_node)?
    if tiered {
        transfer.discard_replayed_collection(mut roots.collections, id)?
        define_empty_tiered_index(mut roots.collections, id, mut plan.next_node)?
    } else {
        catalog.define_store_collection(mut roots.collections, id, 2, mut plan.next_node)?
    }
    // D-CU-1: demotion supersedes the collection id for Memory and Tiered alike.
    types.capacity(list.try_reserve(mut plan.superseded, 1))?
    list.push(mut plan.superseded, id)
    let mut live_bytes = plan.live
    if !plan.retained {
        live_bytes = int.saturating_sub(live_bytes, charge)
    }
    live_bytes = int.saturating_add(live_bytes, 126)
    let next_table = plan.next_table
    catalog.keep_schema(mut plan, take roots, live_bytes, next_table)?
    indexes.set_index_state(mut record, Backfilling(None))?
    put_index_record(mut plan, key, record)?
    Ok(true)
}

pub fn define_empty_tiered_index(mut tree: pages.PageTree, id: u32, mut final_item: u64) -> Result[(), types.Failure] {
    let (take record, take root) = {
        let Some(empty_root) = view tree.empty_collection else {
            fail("store: missing empty collection page")
        }
        (pages.rooted_collection_record(empty_root, 2, ResidentTiered)?, arc.share(empty_root))
    }
    let first = catalog.stamp_after(final_item)?
    let mut draw = first
    pages.page_result(std.page.insert(mut tree.root, catalog.prefix(id)?, record, Some(take root), tree.inline, first, mut draw))?
    pages.canonical_tree(mut tree)?
    final_item = draw - 1
    Ok(())
}

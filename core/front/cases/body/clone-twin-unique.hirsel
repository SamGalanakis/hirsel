// Reciprocal declarations name one pair, and distinct targets have distinct pairs.
// expect: run reciprocal() = 11
// expect: run disjoint() = 13
@twin(B)
type A { n: u64 }
@twin(A)
stable type B { n: u64 }
type C { n: u64 }
@twin(C)
stable type D { n: u64 }
fn reciprocal() -> u64 {
    region r {
        let x = A(n: 11u64)
        let frozen: B in r = result.unwrap(clone_in(r, x))
        let back: A = result.unwrap(clone(frozen))
        back.n
    }
}
fn disjoint() -> u64 {
    region r {
        let x = C(n: 13u64)
        let frozen: D in r = result.unwrap(clone_in(r, x))
        let back: C = result.unwrap(clone(frozen))
        back.n
    }
}

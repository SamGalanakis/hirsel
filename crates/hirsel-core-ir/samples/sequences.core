  addr a0 = v9 byte v15 : u16          ; the element at the cursor
  addr a1 = v9 byte v31 : u64          ; the trailer entry being stored
  addr a2 = v9 byte v7 : u64           ; the count
  addr a3 = v9 byte v36 : u64          ; the byte length
  addr a4 = v9 : u64                   ; header: used bytes
  addr a5 = v9 byte v38 : u64          ; header: W
  addr a6 = v9 byte v46 : u64          ; get: trailer entry 2
  addr a7 = v9 byte v48 : u16          ; get: the element it locates
b0(v0: u64, v1: u64):
  v2: ptr = region_open
  v3: u64 = const 7
  v4: u64 = add v1, v3
  v5: u64 = const 18446744073709551608
  v6: u64 = bitand v4, v5              ; round8(n)
  v7: u64 = const 16
  v8: u64 = add v1, v7                 ; the end
  v9: ptr, v10: u64, v11: u64 = alloc stable v8 align 8 charge v6 in v2
  v51: ptr = const 0x0
  v52: bool = ne v9, v51

// Relay authentication, connection state and protocol work, beside socket reservations.
const RELAY_WORK_BYTES: u64 = 67108864

const STREAM_WRITE_NS: u64 = 20000000

/// The sockets, policy and channels for one TURN relay task.
pub type Start: send {
    net: Net,
    clock: Clock,
    random: Random,
    tasks: Tasks,
    out: Stdout,
    listen: Addr,
    master: Secret,
    nonce: Secret,
    plan: signal.RelayPlan,
    sockets: signal.RelaySocketPlan,
    revokes: Receiver[signal.RelayRevoke],
    // Signals that the UDP and TCP listeners, allocation pool and relay are ready.
    ready: Sender[()],
    until: u64
}

/// The task reservation for protocol work, sockets and receive buffers.
pub fn reserve_bytes(sockets: signal.RelaySocketPlan) -> u64 {
    let udp_readers = signal.relay_allocation_limit(sockets) + 1u64
    let tcp_readers: u64 = int.widen(turn.DEFAULT_STREAMS)
    RELAY_WORK_BYTES + signal.relay_socket_bytes(sockets) + udp_readers * (datagram_reader_bytes(signal.relay_udp_options(sockets)) + DATAGRAM_FORWARD_BYTES) + tcp_readers * STREAM_TASK_BYTES
}

fn say(out: Stdout, line: String) waits {
    let mut text = string.from(line)
    string.push(mut text, "\n")
    let _ = stdout.write(out, text)
}

fn say_number(out: Stdout, tag: String, n: u64) waits {
    let mut line = string.from(tag)
    string.push(mut line, " ")
    string.push_u64(mut line, n)
    say(out, line)
}

fn copy_of(b: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(list.len(b))
    list.append(mut out, b)
    out
}

fn zeros(n: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(n)
    list.fill(mut b, n, 0)
    b
}

type Stream {
    conn: u64,
    client: Addr,
    writer: WriteHalf,
    buffer: Bytes,
    framer: turn.Framer,
    permit: Sender[()],
    reader: Task[()]
}

type Allocation {
    address: Addr,
    id: u64,
    port: DatagramPort
}

type Runtime {
    clock: Clock,
    random: Random,
    tasks: Tasks,
    out: Stdout,
    local: Addr,
    options: UdpOptions,
    relay: turn.Relay,
    inbox: Sender[RelayEvent],
    server: DatagramPort,
    spare: Map[Addr, DatagramSocket],
    active: List[Allocation],
    streams: List[Stream],
    next_conn: u64,
    next_allocation: u64,
    allocation_revision: u64,
    live: u64
}

fn now_of(clock: Clock) -> turn.Now {
    turn.Now(mono_ns: host.mono_ns(clock), unix_s: host.wall_ms(clock) / 1000)
}

fn send_all(mut writer: WriteHalf, data: Bytes, until: Until) -> bool waits {
    let end = list.len(data)
    let mut pos = 0u64
    while pos < end {
        let Ok(count) = host.send_pair(mut writer, list.slice(data, pos, end), b"", until) else {
            return false
        }
        if count == 0 {
            return false
        }
        pos += count
    }
    true
}

// A STUN request (RFC 8489 section 5: top bits 00, class bits 0) is logged whole, so N1 can
// read what a browser's TURN client sends.
fn capture(out: Stdout, transport: String, conn: u64, m: Bytes) waits {
    if list.len(m) < 20 || m[0] & 0xc0 != 0 || m[0] & 0x01 != 0 || m[1] & 0x10 != 0 {
        return
    }
    let mut line = string.from("turn ")
    string.push(mut line, transport)
    string.push(mut line, " ")
    string.push_u64(mut line, conn)
    string.push(mut line, " ")
    string.push(mut line, std.hex.encode(m))
    say(out, line)
}

fn stream_index(s: Runtime, conn: u64) -> Option[u64] {
    for i in 0u64 .. list.len(s.streams) {
        if s.streams[i].conn == conn {
            return Some(i)
        }
    }
    None
}

fn allocation_index(s: Runtime, address: Addr) -> Option[u64] {
    for i in 0u64 .. list.len(s.active) {
        if s.active[i].address == address {
            return Some(i)
        }
    }
    None
}

fn disconnect(mut s: Runtime, conn: u64) {
    if let Some(i) = stream_index(s, conn) {
        turn.disconnected(mut s.relay, conn)
        let _ = list.swap_remove(mut s.streams, i)
    }
}

// Check for changes only after TURN has assigned or returned an address.
fn sync_allocations(mut s: Runtime) -> Result[(), turn.TurnError] waits {
    let revision = turn.relay_allocation_revision(s.relay)
    if revision == s.allocation_revision {
        return Ok(())
    }
    s.allocation_revision = revision
    let mut i = 0u64
    while i < list.len(s.active) {
        let addr = s.active[i].address
        if turn.relay_allocated(s.relay, addr) {
            i += 1
        } else {
            let Allocation(port: take port, ..) = list.swap_remove(mut s.active, i)
            let socket = stop_datagrams(take port)?
            map.insert(mut s.spare, addr, take socket)
        }
    }
    i = 0
    while let Some(addr) = turn.relay_allocation_at(s.relay, i) {
        if let Some(take socket) = map.remove(mut s.spare, addr) {
            let id = s.next_allocation
            s.next_allocation += 1
            let port = start_datagrams(s.tasks, take socket, s.options, Peer(addr, id), s.inbox)?
            list.push(mut s.active, Allocation(address: addr, id, port: take port))
        }
        i += 1
    }
    Ok(())
}

fn next_wake(mut s: Runtime, now: turn.Now, until: u64) -> Result[u64, turn.TurnError] waits {
    loop {
        let due = match turn.relay_poll(mut s.relay, now) {
            Close(conn) => {
                disconnect(mut s, conn)
                continue
            },
            WakeAt(at) => order.min(at, until),
            _ => until,
        }
        sync_allocations(mut s)?
        let count = list.len(s.active)
        if count != s.live {
            s.live = count
            say_number(s.out, "allocations", count)
        }
        return Ok(due)
    }
}

fn to_client(mut s: Runtime, o: turn.Origin, data: Bytes) -> Result[(), turn.TurnError] waits {
    match o.ingress {
        Udp(_) => send_datagram(mut s.server, o.client, data)?,
        Stream(conn) => if let Some(i) = stream_index(s, conn) {
            let until = At(s.clock, host.mono_ns(s.clock) + STREAM_WRITE_NS)
            if !send_all(mut s.streams[i].writer, data, until) {
                disconnect(mut s, conn)
            }
        },
    }
    Ok(())
}

fn from_client(mut s: Runtime, o: turn.Origin, m: Bytes, until: u64) -> Result[(), turn.TurnError] waits {
    let now = now_of(s.clock)
    // Settle an old allocation before a request in this batch can reuse its address.
    let _ = next_wake(mut s, now, until)?
    if let Stream(conn) = o.ingress {
        if let None = stream_index(s, conn) {
            return Ok(())
        }
    }
    let mut packet = copy_of(m)
    let mut reply = zeros(0)
    let action = turn.from_client(mut s.relay, now, s.random, o, mut packet, mut reply)
    sync_allocations(mut s)?
    match action {
        Ok(Reply(to, k)) => to_client(mut s, to, list.slice(reply, 0, k))?,
        Ok(ToPeer(relayed, to, range)) => if let Some(i) = allocation_index(s, relayed) {
            send_datagram(mut s.active[i].port, to, list.slice(packet, range.lo, range.hi))?
        },
        _ => (),
    }
    Ok(())
}

fn accept(mut s: Runtime, take socket: Socket, client: Addr) -> Result[(), turn.TurnError] {
    let conn = s.next_conn
    s.next_conn += 1
    if let Ok(_) = turn.connected(mut s.relay, conn, s.local, client, now_of(s.clock)) {
        let (reader, writer) = net.split(take socket)
        let (permit, next): (Sender[()], Receiver[()]) = channel.new(1)
        let job = StreamWork(conn, reader: take reader, permit: take next, inbox: channel.sender(s.inbox))
        let child = task.try_spawn(s.tasks, bytes STREAM_TASK_BYTES, take job, read_stream) ?=> |(cap, _)| Capacity(cap)
        list.push(mut s.streams, Stream(conn, client, writer: take writer, buffer: list.new(), framer: turn.framer(), permit: take permit, reader: take child))
    }
    Ok(())
}

fn frame_stream(mut stream: Stream, data: Bytes, mut messages: List[Bytes]) -> bool {
    turn.frame_consumed(mut stream.framer, mut stream.buffer)
    list.append(mut stream.buffer, data)
    loop {
        match turn.frame_next(mut stream.framer, stream.buffer) {
            Ok(Message(range)) => list.push(mut messages, copy_of(list.slice(stream.buffer, range.lo, range.hi))),
            Ok(Pending) => return true,
            Error(_) => return false,
        }
    }
}

fn stream_bytes(mut s: Runtime, conn: u64, data: Bytes, until: u64) -> Result[(), turn.TurnError] waits {
    let Some(i) = stream_index(s, conn) else {
        return Ok(())
    }
    let origin = turn.Origin(ingress: Stream(conn), client: s.streams[i].client)
    let mut messages: List[Bytes] = list.new()
    let alive = frame_stream(mut s.streams[i], data, mut messages)
    for m in messages {
        capture(s.out, "tcp", int.widen(origin.client.port), m)
        from_client(mut s, origin, m, until)?
    }
    if !alive {
        disconnect(mut s, conn)
    } else if let Some(current) = stream_index(s, conn) {
        let _ = channel.send(s.streams[current].permit, ())
    }
    Ok(())
}

fn server_batch(mut s: Runtime, until: u64) -> Result[(), turn.TurnError] waits {
    let batch = channel.receive(s.server.batches) ?=> |_| Config
    for d in batch.packets {
        let UdpPacket(peer: from, at: start, len: size, truncated, ..) = d
        if !truncated {
            let m = list.slice(batch.data, start, start + size)
            capture(s.out, "udp", 0, m)
            let origin = turn.Origin(ingress: Udp(s.local), client: from)
            from_client(mut s, origin, m, until)?
        }
    }
    resume_datagrams(s.server, take batch)
}

fn peer_batch(mut s: Runtime, addr: Addr, id: u64) -> Result[(), turn.TurnError] waits {
    let Some(i) = allocation_index(s, addr) else {
        return Ok(())
    }
    if s.active[i].id != id {
        return Ok(())
    }
    let batch = channel.receive(s.active[i].port.batches) ?=> |_| Config
    for d in batch.packets {
        let UdpPacket(peer: from, at: start, len: size, truncated, ..) = d
        if !truncated {
            let lo = turn.HEADROOM
            let mut slot = zeros(lo)
            list.append(mut slot, list.slice(batch.data, start, start + size))
            list.append(mut slot, b"\x00\x00\x00")
            let now = now_of(s.clock)
            if let Ok(ToClient(o, range)) = turn.from_peer(mut s.relay, now, addr, from, mut slot, lo, lo + size) {
                to_client(mut s, o, list.slice(slot, range.lo, range.hi))?
            }
        }
    }
    resume_datagrams(s.active[i].port, take batch)
}

fn on_revoke(mut s: Runtime, revoke: signal.RelayRevoke) waits {
    let deleted = match signal.apply_revoke(mut s.relay, revoke, now_of(s.clock)) {
        Ok(k) => k,
        Error(_) => 0,
    }
    let mut line = string.from("revoked ")
    string.push(mut line, result.unwrap(string.from_utf8(copy_of(revoke.subject))))
    string.push(mut line, " ")
    string.push_u64(mut line, deleted)
    say(s.out, line)
}

/// Runs UDP and TCP TURN until the monotonic deadline in Start.
pub fn run(take s: Start) -> Result[(), turn.TurnError] waits {
    let Start(net: n, clock, random, tasks, out, listen: at, master: take master, nonce: take nonce, plan: take plan, sockets, revokes: take revokes, ready: take ready, until) = take s
    let options = signal.relay_udp_options(sockets)
    let Ok((take server_socket, local)) = host.udp_bind(n, at, options) else {
        say(out, "relay cannot bind its UDP port")
        return Error(Config)
    }
    let Ok((take listener, _)) = host.listen(n, local, 16) else {
        say(out, "relay cannot listen on its TCP port")
        return Error(Config)
    }
    let Ok((take bound_sockets, take pool_addrs)) = signal.bind_relay_pool(n, at.ip, sockets) else {
        say(out, "relay cannot bind the requested allocation sockets")
        return Error(Config)
    }
    let mut spare: Map[Addr, DatagramSocket] = map.new()
    let mut i = 0u64
    for take socket in take bound_sockets {
        map.insert(mut spare, pool_addrs[i], datagram_socket(take socket))
        i += 1
    }
    let config = signal.relay_config(plan)?
    let relay = turn.relay(take config, random, take master, take nonce, take pool_addrs)?
    let (to, inbox): (Sender[RelayEvent], Receiver[RelayEvent]) = channel.new(128)
    let server = start_datagrams(tasks, datagram_socket(take server_socket), options, Server, to)?
    let intake = AcceptWork(listener: take listener, inbox: channel.sender(to))
    let accepting = task.try_spawn(tasks, bytes 8192, take intake, accept_streams) ?=> |(cap, _)| Capacity(cap)
    let revoking = task.try_spawn(tasks, bytes 8192, (take revokes, channel.sender(to)), forward_revokes) ?=> |(cap, _)| Capacity(cap)
    let mut state = Runtime(clock, random, tasks, out, local, options, relay: take relay, inbox: take to, server: take server, spare: take spare, active: list.new(), streams: list.new(), next_conn: 1, next_allocation: 1, allocation_revision: 0, live: 0)
    say_number(out, "turn listening", int.widen(local.port))
    if let Error(_) = channel.send(ready, ()) {
        return Ok(())
    }
    while host.mono_ns(clock) < until {
        let due = next_wake(mut state, now_of(clock), until)?
        let Ok(take event) = channel.receive_until(inbox, At(clock, due)) else {
            continue
        }
        let now = now_of(clock)
        if now.mono_ns >= until {
            break
        }
        let _ = next_wake(mut state, now, until)?
        match take event {
            Datagrams(Server) => server_batch(mut state, until)?,
            Datagrams(Peer(addr, id)) => peer_batch(mut state, addr, id)?,
            DatagramEnded(Server) => return Error(Config),
            DatagramEnded(Peer(addr, id)) => if let Some(active) = allocation_index(state, addr) {
                if state.active[active].id == id {
                    return Error(Config)
                }
            },
            Accepted(take socket, from) => accept(mut state, take socket, from)?,
            AcceptEnded => return Error(Config),
            StreamBytes(conn, take data) => stream_bytes(mut state, conn, data, until)?,
            StreamEnded(conn) => disconnect(mut state, conn),
            Revoked(take revoke) => on_revoke(mut state, revoke),
        }
    }
    Ok(())
}

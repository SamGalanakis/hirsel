// R1–R3. The READY/DONE gate is std.omap's phase-measurement protocol.
pub type Account: send {
    id: u64,
    owner: String,
    balance: i64
}

fn account_put(a: Account, mut b: Bytes) -> Result[(), std.codec.EncodeError] {
    std.codec.put_u64(a.id, mut b)
    std.codec.put_i64(a.balance, mut b)
    std.codec.put_string(a.owner, mut b)
}

fn account_take(b: Bytes, mut at: u64) -> Result[Account, std.codec.DecodeError] {
    let id = std.codec.take_u64(b, mut at)?
    let balance = std.codec.take_i64(b, mut at)?
    let owner = std.codec.take_string(b, mut at)?
    Ok(Account(id: id, owner: take owner, balance: balance))
}

fn account_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[Account]) -> Result[(), std.codec.EncodeError] {
    std.codec.define(mut s, "store.bench.Account", 0)?
    if std.codec.record(mut s, 3)? {
        return Ok(())
    }
    std.codec.field(mut s, "id")?;
    std.codec.schema_u64(mut s)
    std.codec.field(mut s, "balance")?;
    std.codec.schema_i64(mut s)
    std.codec.field(mut s, "owner")?;
    std.codec.schema_string(mut s)
    std.codec.close(mut s)
    Ok(())
}

fn accounts() -> std.codec.Codec[Account] {
    std.codec.make(account_put, account_take, account_schema, 24)
}

fn bucket(a: Account) -> Result[u64, Capacity] {
    Ok(a.id % 4)
}

fn save(mut db: store.Db, t: store.Table[u64, Account], k: u64, balance: u64) -> u64 waits {
    let done = result.unwrap(store.run(mut db, None, (copy_env(balance), copy_env(k), copy_env(t)), fn(mut tx, call_env) -> Result[u64, store.Error] {
        let a = Account(id: call_env.1, owner: string.from("owner000"), balance: int.narrow(call_env.0))
        store.put(mut tx, call_env.2, call_env.1, a)?
        Ok(call_env.0)
    }))
    match take done {
        Committed(x) => x.value,
        _ => fail("unchanged-index put refused")
    }
}

pub fn main(dir: Dir, clock: Clock, random: Random, out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let mode = option.unwrap(args.get(argv, 0))
    let count: u64 = if mode == "0" {
        0
    } else if mode == "1" {
        1
    } else {
        3
    }
    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    result.unwrap(store.create_table(mut db, store.spec("accounts", std.codec.key_u64(), accounts())))
    let mut t = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), accounts()))
    for i in 0u64 .. count {
        let name = if i == 0 {
            "i0"
        } else if i == 1 {
            "i1"
        } else {
            "i2"
        }
        result.unwrap(store.create_index(mut db, t, name, code.describe(bucket), std.codec.key_u64()))
        let _ = result.unwrap(store.index(mut db, t, name, code.describe(bucket), std.codec.key_u64()))
    }
    for i in 0u64 .. 100000 {
        let _ = save(mut db, t, i, i)
    }
    let mut gate = result.unwrap(host.open(dir, "gate", Read))
    let mut byte: Bytes = list.with_capacity(1)
    result.unwrap(stdout.write(out, "READY\n"))
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    let start = host.mono_ns(clock)
    let mut sum: u64 = 0
    for i in 0u64 .. 10000 {
        sum += save(mut db, t, i, i + 100000)
    }
    let elapsed = host.mono_ns(clock) - start
    let mut rendered = string.new()
    string.push(mut rendered, "DONE ")
    string.push_u64(mut rendered, sum)
    string.push(mut rendered, " ")
    string.push_u64(mut rendered, elapsed)
    string.push(mut rendered, "\n")
    result.unwrap(stdout.write(out, rendered))
    list.clear(mut byte)
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    let snapshot = store.snapshot(db)
    let shape = view t
    for i in 0u64 .. 10000 {
        let a = option.unwrap(result.unwrap(store.get(result.unwrap(reader(db, 0u64)), snapshot, shape, i)))
        if a.id != i || a.balance != int.narrow(i + 100000) || a.owner != "owner000" {
            return Error(Exit(status: 8))
        }
    }
    result.unwrap(store.close(take db))
    Ok(())
}

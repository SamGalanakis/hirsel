// Module gateway (package harness): the Directory/Gateway. Each session is a keyed
// session of an in-process platform host (`platform.local`, RUNNER-SPEC §14.9), which keeps
// the catalog, routes and wakes. The host owns the wake: a route wakes a session on
// demand, a place unloads only by its own idle stop (§14.4), which never cuts active work,
// and an unloaded session holds no memory. Only a clean stop writes Clean; a trigger due
// later wakes the session then, and every other end leaves it Dirty and starts it again
// (§14.4, §14.5). This module seeds a session's store with a harness session and checks a
// cold session's ACL before a wake.

// The wire sessions a session's place admits at once. A front's following stream holds
// one for as long as the session is busy, so a history page, a status read, a message or
// a decision meanwhile needs its own, and a subagent's look at a child needs one more; a
// read never waits for a running turn to end.
const PLACE_SESSIONS: u64 = 4u64

// How a new session's store starts: an empty session, or a fork's exported prefix.
pub type Seeding: send = Fresh(String, harness.Narrow) | Adopt(harness.Prefix)
pub type Refused: send = Unknown | Full | Asleep | Denied | Place(platform.local.Refused) | Stopping

// `place_bytes` is the budget every live session's place shares, and `idle_ms` the idle
// time each place stops after (the host's Config, §14.2, §14.4).
pub type GatewayConfig[T: send]: send {
    root: Dir, options: store.Options, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits],
    factory: platform.local.Factory[T], max_sessions: u64, idle_ms: u64, place_bytes: u64,
    tasks: Tasks, clock: Clock, random: Random, net: Net, watch: Option[Sender[platform.local.Change]], seed: T,
}

pub opaque type Gateway { host: platform.local.Local }
pub opaque type Door: send { host: platform.local.Door }
// A gateway's inbox, made before the gateway so that its seed can hold a door to it
// (a session's subagent tool starts its child through that door).
pub opaque type Doorway: send { way: platform.local.Doorway }

fn refused(take r: platform.local.Refused) -> Refused {
    match take r {
        Unknown => Unknown,
        Full => Full,
        Busy => Asleep,
        Denied => Denied,
        Stopping => Stopping,
        other => Place(take other),
    }
}

fn mapped[A](take r: Result[A, platform.local.Refused]) -> Result[A, Refused] {
    match take r { Ok(take v) => Ok(take v), Error(take why) => Error(refused(take why)) }
}

// Seeds a session's store with its harness session and, for a visible one, its reader.
fn seeder(take seeding: Seeding, take reader: Option[store.Caller]) -> platform.local.Seed {
    fn(mut db: store.Db) -> Result[(), String] waits {
        let Ok(h) = store.with_schema(db, code.describe(harness.handles)) else { return Error(string.from("harness schema")) }
        let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), harness.Refused] {
            match seeding {
                Fresh(model, narrow) => harness.open_session(mut tx, h, clone(model), clone(narrow)),
                Adopt(prefix) => harness.adopt(mut tx, h, clone(prefix)),
            }?
            if let Some(caller) = reader { harness.set_reader(mut tx, h, caller, true)? }
            Ok(())
        })
        match take ran {
            Ok(Committed(done)) => match store.durable(mut db, done.ticket) { Ok(()) => Ok(()), Error(_) => Error(string.from("seed durable")) },
            Ok(Aborted(_)) => Error(string.from("seed refused")),
            _ => Error(string.from("seed store")),
        }
    }
}

// ---- the API ----

pub fn doorway() -> Doorway { Doorway(way: platform.local.doorway()) }

pub fn door_of(w: Doorway) -> Door { Door(host: platform.local.door_of(w.way)) }

pub fn copy_door(d: Door) -> Door { Door(host: platform.local.copy_door(d.host)) }

pub fn gateway[T: send](take way: Doorway, take config: GatewayConfig[T]) -> Result[Gateway, Refused] waits {
    let GatewayConfig(root: root, options: take options, migrate: migrate, factory: take making, max_sessions: max_sessions, idle_ms: idle_ms, place_bytes: place_bytes,
        tasks: tasks, clock: clock, random: random, net: net, watch: take watch, seed: take seed) = take config
    let lconfig = platform.local.Config(root: root, options: take options, migrate: migrate, factory: take making, seed: take seed, max_places: max_sessions, idle_ms: idle_ms,
        place_bytes: place_bytes, sessions: PLACE_SESSIONS, tasks: tasks, clock: clock, random: random, net: net, watch: take watch)
    let Doorway(way: take w) = take way
    match platform.local.local(take w, take lconfig) { Ok(take host) => Ok(Gateway(host: take host)), Error(take why) => Error(refused(take why)) }
}

pub fn door(g: Gateway) -> Door { Door(host: platform.local.door(g.host)) }

pub fn create(d: Door, take key: Bytes, take seeding: Seeding) -> Result[u64, Refused] waits {
    create_with(d, take key, take seeding, None)
}

// Seeds a private session and its initial reader before listing it.
pub fn create_visible(d: Door, key: Bytes, take seeding: Seeding, take caller: store.Caller) -> Result[u64, Refused] waits {
    let mut scoped_key: Bytes = list.new()
    if let Error(_) = runner.caller_key(caller, mut scoped_key) { return Error(Place(Failed(string.from("reader identity")))) }
    list.append(mut scoped_key, key)
    create_with(d, take scoped_key, take seeding, Some(take caller))
}

fn create_with(d: Door, take key: Bytes, take seeding: Seeding, take reader: Option[store.Caller]) -> Result[u64, Refused] waits {
    mapped(platform.local.create(d.host, take key, seeder(take seeding, take reader)))
}

// Exports a cold session's prefix up to the cut `arg` encodes.
fn export_cold(reader: store.ReadOnly, arg: Bytes) -> Result[Bytes, String] {
    let c_cut: std.codec.Codec[u64] = std.codec.of()
    let Ok(upto) = std.codec.decode(c_cut, arg) else {
        return Error(string.from("fork cut"))
    }
    let snap = store.read_only_snapshot(reader)
    let Ok(h) = harness.handles(store.snapshot_schema(snap)) else {
        return Error(string.from("harness schema"))
    }
    let Ok(prefix) = harness.export(snap, h, upto) else {
        return Error(string.from("fork cut"))
    }
    let c_prefix: std.codec.Codec[harness.Prefix] = std.codec.of()
    let mut out: Bytes = list.new()
    if let Error(_) = std.codec.encode(c_prefix, prefix, mut out) {
        return Error(string.from("fork prefix"))
    }
    Ok(take out)
}

// Forks `source` at `cut` into the visible session `key` names. The prefix is read from
// the source's committed store once its place, if live, has stopped.
pub fn fork(d: Door, source: u64, cut: u64, key: Bytes, take caller: store.Caller) -> Result[u64, Refused] waits {
    let c_cut: std.codec.Codec[u64] = std.codec.of()
    let mut arg: Bytes = list.new()
    if let Error(_) = std.codec.encode(c_cut, cut, mut arg) {
        return Error(Place(Failed(string.from("fork cut"))))
    }
    let raw = mapped(platform.local.read_cold(d.host, source, platform.local.ColdRead(arg: take arg, read: code.describe(export_cold))))?
    let c_prefix: std.codec.Codec[harness.Prefix] = std.codec.of()
    let Ok(prefix) = std.codec.decode(c_prefix, raw) else {
        return Error(Place(Failed(string.from("fork prefix"))))
    }
    create_visible(d, key, Adopt(take prefix), take caller)
}

// Unlists a session, then drains its place and deletes its store.
pub fn delete(d: Door, id: u64) -> Result[(), Refused] waits { mapped(platform.local.delete(d.host, id)) }

pub fn listing(d: Door) -> List[u64] waits { platform.local.listing(d.host) }

// Routes to a session, waking its place if it is unloaded. The lease's status holds the
// place's address. A lease does not hold the place: a client's session does (§14.9).
pub fn route(d: Door, id: u64) -> Result[platform.local.Lease, Refused] waits { mapped(platform.local.route(d.host, id)) }

// Enforces the session ACL before a cold wake. A returned lease still needs
// the live query under the credential bound to its wire connection.
pub fn access(d: Door, id: u64, caller: store.Caller, wake: bool) -> Result[Option[platform.local.Lease], Refused] waits {
    let check = platform.local.ColdCheck(caller: clone(caller), check: code.describe(harness.cold_reader_allowed))
    mapped(platform.local.access(d.host, id, take check, wake))
}

// Like `route`, but only to a session whose place serves; it never starts one.
pub fn peek(d: Door, id: u64) -> Result[platform.local.Lease, Refused] waits { mapped(platform.local.peek(d.host, id)) }

// Stops a session's place now, as an operator would (§14.4 "Unload"); a cut run is
// started again by the host.
pub fn unload(d: Door, id: u64) -> Result[platform.local.Unloaded, Refused] waits { mapped(platform.local.unload(d.host, id)) }

// Tells the gateway that a front changed a session, so streams that follow it look again.
pub fn nudge(d: Door, id: u64) -> () waits { platform.local.nudge(d.host, id) }

pub fn marks(d: Door, id: u64) -> platform.local.Marks waits { platform.local.marks(d.host, id) }

// The caller registers before sampling marks. A queued notification is enough
// because marks contain the cumulative counts.
pub fn watch_marks(d: Door, id: u64, notify: Sender[()]) -> Option[u64] waits { platform.local.watch_marks(d.host, id, notify) }

pub fn unwatch_marks(d: Door, id: u64, token: u64) -> () waits { platform.local.unwatch_marks(d.host, id, token) }

// Waits until the session's place has ended more than `after` times, and answers how many.
pub fn await_down(d: Door, id: u64, after: u64) -> Result[u64, Refused] waits { mapped(platform.local.await_down(d.host, id, after)) }

// Stops every live session through its graceful stop and answers how each ended.
pub fn stop(take g: Gateway) -> List[platform.local.Unloaded] waits {
    let Gateway(host: take host) = take g
    platform.local.stop(take host)
}

// ---- the reference subagent ----

// What a child session's place registers for its parent: a submit entry and a query
// over the ACL-checked transcript, and how to reach it.
pub type Child: send {
    submit: runner.client.Callee[harness.Submit, Result[harness.Disposition, harness.Refused]],
    shown: runner.client.Callee[harness.Window, ()], keys: List[Bytes], socket: std.wsock.Config, authority: Bytes,
    tasks: Tasks, clock: Clock, random: Random, net: Net, within_ms: u64,
}

// The credential the subagent presents to its child: 16 bytes derived from the child's
// key, so every connection to one child is one Caller under a binding that maps a
// 16-byte credential to a Caller (`runner.ingress.caller`).
pub fn child_credential(key: Bytes) -> Bytes {
    let tag = string.as_bytes("hirsel.harness.subagent.v1")
    let mut hash = std.sha256.start()
    std.sha256.add(mut hash, tag, 0u64, list.len(tag))
    std.sha256.add(mut hash, key, 0u64, list.len(key))
    let digest = std.sha256.finish(hash)
    let mut out: Bytes = list.with_capacity(16u64)
    for i in 0u64 .. 16u64 { list.push(mut out, digest[i]) }
    out
}

// The key of the child a parent's effect starts: the parent's place name and the
// effect's trigger run, which every attempt of that effect shares.
pub fn child_key(parent: String, ctx: runner.TriggerContext) -> Bytes {
    let mut key = string.into_bytes(string.from(parent))
    list.push(mut key, 0u8)
    let codec: std.codec.Codec[runner.triggers.Id] = std.codec.of()
    let _ = std.codec.encode(codec, runner.triggers.run_id(runner.trigger_attempt(ctx)), mut key)
    key
}

type Seen: send = Busy(String, u64) | Ended(String, String)

// One look at the child: its status and its last assistant line, read from one image
// of its transcript query.
fn look(d: Door, id: u64, c: Child, credential: Bytes, take submit: Option[harness.Submit]) -> Result[Seen, harness.Fault] waits {
    let Ok(lease) = route(d, id) else { return Error(Unavailable) }
    let Some(address) = latest.read(platform.local.status(lease)).addr else { return Error(Unavailable) }
    let Ok(take opened) = runner.client.client_at(c.net, c.clock, c.random, c.keys, c.socket, address, c.authority, Some(clone(credential)), 0u64, c.within_ms) else { return Error(Unavailable) }
    let _ = take lease
    let mut client = take opened
    if let Some(take m) = take submit {
        let placed = match runner.client.call(mut client, c.submit, take m, 5000u32) {
            Ok(runner.client.Replied(answer: Returned(Ok(_)), ..)) => true,
            _ => false,
        }
        if !placed { runner.client.close(take client); return Error(Unavailable) }
    }
    let Ok(sub) = runner.client.subscribe(mut client, c.shown, Transcript, c.within_ms) else { runner.client.close(take client); return Error(Unavailable) }
    let seen = runner.client.seen_at(mut client, sub, 0u64, c.within_ms)
    runner.client.close(take client)
    let Ok(image) = take seen else { return Error(Unavailable) }
    let codec: std.codec.Codec[harness.View] = std.codec.of()
    let mut status = string.new()
    let mut last = string.new()
    let mut last_at = 0u64
    let rows = list.len(image.rows)
    for r in image.rows {
        let Some(raw) = view r.value else { continue }
        // A query row's key carries the table's prefix before the u64 key, so the
        // position is the key's last eight bytes, big-endian.
        let width = list.len(r.key)
        if width < 8u64 { continue }
        let mut at = 0u64
        for i in width - 8u64 .. width { at = at * 256u64 + int.widen(r.key[i]) }
        match std.codec.decode(codec, raw) {
            Ok(Status(text)) => { status = clone(text) },
            Ok(Line(kind, text)) => if kind == "assistant" && at >= last_at {
                last_at = at
                last = clone(text)
            },
            Error(_) => (),
        }
    }
    if status == "" { return Error(Unavailable) }
    if status == "answered" || status == "out of rounds" || status == "cancelled" || string.starts_with(status, "stopped") { Ok(Ended(take status, take last)) } else { Ok(Busy(take status, rows)) }
}

// A subagent: an Outside tool body that starts the child session named by `key`, gives
// it `text` and waits for its run to end, then returns its last answer. It holds no
// lease and no connection while it waits; it looks at the child only after the child's
// place has stopped. A look wakes the child, which then stops again by itself, so when a
// look finds the child as the last one did (it waits on a person or a tool), the next
// look waits for a stop after that one: someone else must wake the child first. A child
// waiting on a person therefore costs one wake per outside wake, not a wake loop.
// Starting is idempotent by key and the submit by the child's Caller and client key, so
// a repeated attempt reaches the same child and the same run.
pub fn ask(d: Door, take key: Bytes, take seeding: Seeding, c: Child, take text: String) -> Result[Bytes, harness.Fault] waits {
    let credential = child_credential(key)
    let Ok(take caller) = runner.ingress.caller((), credential) else { return Error(Unavailable) }
    let id = match create_with(d, take key, take seeding, Some(take caller)) { Ok(n) => n, Error(_) => return Error(Unavailable) }
    let mut submit: Option[harness.Submit] = Some(harness.Submit(client_key: "parent", text: take text))
    let mut before: Option[(String, u64)] = None
    loop {
        let ended = marks(d, id).downs
        let (status, rows) = match look(d, id, c, credential, take submit)? {
            Ended(status, answer) => {
                if status == "answered" { return Ok(string.into_bytes(take answer)) }
                return Error(Refused(take status))
            },
            Busy(status, rows) => (take status, rows),
        }
        submit = None
        let unchanged = match before { Some((s0, r0)) => s0 == status && r0 == rows, None => false }
        if let Error(_) = await_down(d, id, ended) { return Error(Unavailable) }
        if unchanged {
            if let Error(_) = await_down(d, id, ended + 1u64) { return Error(Unavailable) }
        }
        before = Some((take status, rows))
    }
}

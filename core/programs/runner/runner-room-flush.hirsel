type RoomDiff {
    peer: u32,
    joined_bytes: u64,
    state_bytes: u64,
    left: bool,
}

fn relay_peer_id(relay: RoomRelay, peer: RoomPeer) -> u32 {
    match room_desk_slot(relay, peer.session, peer.seat) {
        Some(seat) => seat.member.peer,
        None => 0u32,
    }
}

fn room_diff(relay: RoomRelay, peers: List[Option[RoomPeer]], member: RoomMember, position: u64) -> RoomDiff {
    let previous = member.told[position]
    if let Some(peer) = peers[position] {
        if let Some(seat) = room_desk_slot(relay, peer.session, peer.seat) {
            let current = seat.member.peer
            let join_size = if current != previous {
                9u64 + list.len(seat.member.caller.subject)
            } else {
                0u64
            }
            let current_size = if seat.member.state_present {
                12u64 + list.len(seat.member.state)
            } else {
                8u64
            }
            return RoomDiff(peer: current, joined_bytes: join_size, state_bytes: current_size, left: previous != 0u32 && previous != current)
        }
    }
    RoomDiff(peer: 0u32, joined_bytes: 0u64, state_bytes: 0u64, left: previous != 0u32)
}

fn room_diff_size(diff: RoomDiff) -> u64 {
    diff.joined_bytes + diff.state_bytes + if diff.left {
        4u64
    } else {
        0u64
    }
}

fn room_head_message(relay: RoomRelay, peers: List[Option[RoomPeer]], member: RoomMember, mut ring: RoomRing, mut lost: u32) -> Option[(u64, RingMessage)] {
    let mut at = 0u64
    while at < ring.used {
        let entry = room_ring_message(ring, at)
        let len: u64 = int.widen(entry.len)
        let next = at + ROOM_RING_HEADER + len
        if !entry.consumed && entry.room_slot == member.room_slot {
            if entry.recv_adm != member.admission {
                room_ring_consume(mut ring, at)
            } else {
                let sender: u64 = int.widen(entry.from_slot)
                let current = match peers[sender] {
                    Some(peer) => relay_peer_id(relay, peer),
                    None => 0u32
                }
                if member.told[sender] == entry.from_peer || current == entry.from_peer {
                    return Some((at, entry))
                }
                room_ring_consume(mut ring, at)
                lost = int.saturating_add(lost, 1u32)
            }
        }
        at = next
    }
    None
}

type RoomPartSlots {
    available: u64,
    next: u64,
    blocked_state: bool,
}

// Reserve the head message and its sender's diff before visiting other slots.
// The roster buffer holds the new peer id for each selected slot, or None.
fn reserve_room_part(relay: RoomRelay, peers: List[Option[RoomPeer]], member: RoomMember, room_bytes: u64, head: Option[RingMessage], mut selected: List[Option[u32]]) -> Option[RoomPartSlots] {
    let you_bytes = if member.complete && member.peer != 0u32 {
        4u64
    } else {
        0u64
    }
    let capacity = int.checked_sub(room_bytes, ROOM_PART_FIXED + you_bytes)?
    let mut sender: Option[(u64, u32)] = None
    let mut diff_size = 0u64
    let mut message_size = 0u64
    if let Some(entry) = head {
        let from: u64 = int.widen(entry.from_slot)
        let len: u64 = int.widen(entry.len)
        message_size = 9u64 + len
        if member.changed[from] != 0u8 {
            let diff = room_diff(relay, peers, member, from)
            sender = Some((from, diff.peer))
            diff_size = room_diff_size(diff)
        }
    }
    let available = int.checked_sub(capacity, message_size + diff_size)?
    for i in 0u64 .. list.len(selected) {
        selected[i] = None
    }
    if let Some((roster_index, peer)) = sender {
        selected[roster_index] = Some(peer)
    }
    let mut plan = RoomPartSlots(available, next: member.cursor, blocked_state: false)
    for _ in 0u64 .. list.len(peers) {
        let pos = plan.next
        plan.next = (pos + 1u64) % list.len(peers)
        if member.changed[pos] == 0u8 || !none(selected[pos]) {
            continue
        }
        let diff = room_diff(relay, peers, member, pos)
        let Some(remaining) = int.checked_sub(plan.available, room_diff_size(diff)) else {
            plan.next = pos
            plan.blocked_state = true
            break
        }
        plan.available = remaining
        selected[pos] = Some(diff.peer)
    }
    Some(plan)
}

fn room_write_joins(relay: RoomRelay, peers: List[Option[RoomPeer]], member: RoomMember, selected: List[Option[u32]], mut out: Bytes) {
    let count_at = list.len(out)
    std.codec.put_u32(0u32, mut out)
    let mut count = 0u32
    for i in 0u64 .. list.len(peers) {
        if none(selected[i]) {
            continue
        }
        let Some(peer) = peers[i] else {
            continue
        }
        let Some(seat) = room_desk_slot(relay, peer.session, peer.seat) else {
            continue
        }
        if seat.member.peer == member.told[i] {
            continue
        }
        let source_caller: View[Caller] = seat.member.caller
        std.codec.put_u32(seat.member.peer, mut out)
        list.push(mut out, source_caller.issuer)
        std.codec.put_u32(int.narrow(list.len(source_caller.subject)), mut out)
        list.append(mut out, source_caller.subject)
        count += 1u32
    }
    list.set_word_le(mut out, count_at, count)
}

fn room_write_states(relay: RoomRelay, peers: List[Option[RoomPeer]], selected: List[Option[u32]], mut out: Bytes) {
    let count_at = list.len(out)
    std.codec.put_u32(0u32, mut out)
    let mut count = 0u32
    for i in 0u64 .. list.len(peers) {
        if none(selected[i]) {
            continue
        }
        let Some(peer) = peers[i] else {
            continue
        }
        let Some(seat) = room_desk_slot(relay, peer.session, peer.seat) else {
            continue
        }
        std.codec.put_u32(seat.member.peer, mut out)
        if seat.member.state_present {
            std.codec.put_u32(1u32, mut out)
            std.codec.put_u32(int.narrow(list.len(seat.member.state)), mut out)
            list.append(mut out, seat.member.state)
        } else {
            std.codec.put_u32(0u32, mut out)
        }
        count += 1u32
    }
    list.set_word_le(mut out, count_at, count)
}

fn room_write_left(member: RoomMember, selected: List[Option[u32]], mut out: Bytes) {
    let count_at = list.len(out)
    std.codec.put_u32(0u32, mut out)
    let mut count = 0u32
    for i in 0u64 .. list.len(selected) {
        let Some(current) = selected[i] else {
            continue
        }
        let previous = member.told[i]
        if previous != 0u32 && previous != current {
            std.codec.put_u32(previous, mut out)
            count += 1u32
        }
    }
    list.set_word_le(mut out, count_at, count)
}

fn room_write_messages(relay: RoomRelay, peers: List[Option[RoomPeer]], member: RoomMember, selected: List[Option[u32]], mut ring: RoomRing, mut out: Bytes, mut available: u64, mut dropped: u32) {
    let count_at = list.len(out)
    std.codec.put_u32(0u32, mut out)
    let mut count = 0u32
    let mut at = 0u64
    while at < ring.used {
        let entry = room_ring_message(ring, at)
        let len: u64 = int.widen(entry.len)
        let next = at + ROOM_RING_HEADER + len
        if !entry.consumed && entry.room_slot == member.room_slot && entry.recv_adm == member.admission {
            let sender: u64 = int.widen(entry.from_slot)
            let current = match peers[sender] {
                Some(peer) => relay_peer_id(relay, peer),
                None => 0u32
            }
            let seen = member.told[sender] == entry.from_peer || selected[sender] == Some(entry.from_peer)
            if seen {
                let width = 9u64 + len
                if width > available {
                    break
                }
                room_ring_emit(ring, at, entry, mut out)
                room_ring_consume(mut ring, at)
                available -= width
                count += 1u32
            } else if current != entry.from_peer || member.changed[sender] == 0u8 {
                room_ring_consume(mut ring, at)
                dropped = int.saturating_add(dropped, 1u32)
            }
        }
        at = next
    }
    list.set_word_le(mut out, count_at, count)
}

type RoomFlushResult = NoPart | BufferFull(u32) | FullPart | DataPart(RoomPartSlots)

fn room_flush_part(relay: RoomRelay, seat: RoomSeat, room_index: Option[u64], mut ring: RoomRing, mut live: RoomLiveBuffer, mut selected: List[Option[u32]]) -> RoomFlushResult {
    let member = view seat.member
    let identity = RoomPartIdentity(sub: member.sub, instance: member.grant.instance, member_epoch: member.grant.member_epoch, admission: member.admission)
    if room_denied(member.grant.grant) {
        return NoPart
    }
    if member.admission == 0u64 {
        if seat.full_sent {
            return NoPart
        }
        if room_live_available(live) < ROOM_PART_FIXED {
            return BufferFull(0u32)
        }
        room_live_full(mut live, identity)
        return FullPart
    }
    let roster = view relay.rooms[option.unwrap(room_index)]
    let peers = view roster.peers
    let mut gap = member.gap
    let head = room_head_message(relay, peers, member, mut ring, mut gap)
    if !member.complete && member.lost == 0u32 && gap == 0u32 && room_no_head(head) && !list.contains(member.changed, ROOM_STATE_PENDING) {
        return NoPart
    }
    let message: Option[RingMessage] = if member.state_turn {
        None
    } else {
        match head {
            Some((_, entry)) => Some(entry),
            None => None
        }
    }
    let Some(plan) = reserve_room_part(relay, peers, member, room_live_available(live), message, mut selected) else {
        return BufferFull(gap)
    }
    if member.state_turn && plan.blocked_state {
        let mut picked = false
        for peer in selected {
            if !none(peer) {
                picked = true;
                break
            }
        }
        if !picked {
            return BufferFull(gap)
        }
    }
    let mut room_to_send: u64 = plan.available
    if let Some(entry) = message {
        room_to_send += 9u64 + int.widen(entry.len)
    }
    room_live_append(mut live, identity, scoped fn(mut out: Bytes) {
        let you = if member.complete && member.peer != 0u32 {
            Some(member.peer)
        } else {
            None
        }
        // Every roster change marks its slot. An unblocked plan includes every pending slot.
        room_part_start(mut out, member.sub, member.complete, you, roster.incarnation, roster.revision, !plan.blocked_state)
        room_write_joins(relay, peers, member, selected, mut out)
        room_write_states(relay, peers, selected, mut out)
        room_write_messages(relay, peers, member, selected, mut ring, mut out, mut room_to_send, mut gap)
        room_write_left(member, selected, mut out)
        room_part_end(mut out, gap, member.lost, false)
    })
    DataPart(plan)
}

fn apply_room_part(mut seat: RoomSeat, part: RoomFlushResult, selected: List[Option[u32]]) {
    match part {
        BufferFull(gap) => {
            seat.member.gap = gap
        },
        FullPart => {
            seat.full_sent = true
        },
        DataPart(plan) => {
            seat.member.complete = false
            seat.member.lost = 0u32
            seat.member.gap = 0u32
            seat.member.cursor = plan.next
            // A head message can leave too little space for the next roster diff.
            // Give that diff the first reservation on the following Part.
            seat.member.state_turn = !seat.member.state_turn && plan.blocked_state
            for i in 0u64 .. list.len(seat.member.told) {
                if let Some(peer) = selected[i] {
                    seat.member.told[i] = peer
                    seat.member.changed[i] = 0u8
                }
            }
        },
        _ => (),
    }
}

fn room_no_head(head: Option[(u64, RingMessage)]) -> bool {
    match head {
        None => true,
        _ => false
    }
}

fn reconcile_room_senders(mut relay: RoomRelay, rounds: Latest[RoundAt], id: RoomSession, position: u8) -> Option[u64] {
    let room_index = {
        let member = room_desk_slot(relay, id, position)?
        find_room(relay.rooms, member.key)?
    }
    for i in 0u64 .. list.len(relay.rooms[room_index].peers) {
        if let Some(peer) = relay.rooms[room_index].peers[i] {
            room_reconcile_seat(mut relay, rounds, peer.session, peer.seat)
        }
    }
    Some(room_index)
}

fn room_desk_flush(mut relay: RoomRelay, rounds: Latest[RoundAt], id: RoomSession) {
    let Some(start_pos) = map.update(mut relay.desks, id, scoped fn(mut desk: Box[RoomDesk]) -> u64 {
        if list.len(desk.free) == 0u64 {
            return ROOMS_PER_SESSION
        }
        desk.cursor
    }) else {
        return
    }
    if start_pos == ROOMS_PER_SESSION {
        return
    }
    room_refresh(mut relay, rounds, id)
    let mut available: Option[Box[RoomLiveBuffer]] = None
    let mut retained: Option[RoomRing] = None
    let _ = map.update(mut relay.desks, id, scoped fn(mut desk: Box[RoomDesk]) {
        available = list.pop(mut desk.free)
        retained = replace(mut desk.ring, None)
    })
    let mut live = option.unwrap(take available)
    let mut ring = option.unwrap(take retained)
    room_live_clear(mut live)
    let mut cursor = start_pos
    for _ in 0u64 .. ROOMS_PER_SESSION {
        let current = cursor
        let room_index = reconcile_room_senders(mut relay, rounds, id, int.narrow(current))
        let mut selected = match room_index {
            Some(index) => replace(mut relay.rooms[index].selected, list.new()),
            None => list.new(),
        }
        let result = {
            let seat = room_desk_slot(relay, id, int.narrow(current))
            match seat {
                Some(member) => room_flush_part(relay, member, room_index, mut ring, mut live, mut selected),
                None => NoPart
            }
        }
        let _ = map.update(mut relay.desks, id, scoped fn(mut desk: Box[RoomDesk]) {
            let Some(take parked) = list.set(mut desk.seats, current, None) else {
                return
            }
            let mut seat = take parked
            apply_room_part(mut seat, result, selected)
            let _ = list.set(mut desk.seats, current, Some(take seat))
        })
        if let Some(index) = room_index {
            relay.rooms[index].selected = take selected
        }
        if let BufferFull(_) = result {
            break
        }
        cursor = (cursor + 1u64) % ROOMS_PER_SESSION
    }
    room_ring_reclaim(mut ring)
    let mut filled = Some(take live)
    let mut collected = Some(take ring)
    let _ = map.update(mut relay.desks, id, scoped fn(mut desk: Box[RoomDesk]) {
        let next_buffer = option.unwrap(replace(mut filled, None))
        desk.ring = replace(mut collected, None)
        desk.cursor = cursor
        if list.len(next_buffer.parts) == 0u64 {
            list.push(mut desk.free, take next_buffer)
        } else {
            room_out(mut desk, Fill(take next_buffer))
        }
    })
}

// The kept import and its delta rounds (STORE-SPEC §3.5a "The kept import").
//
// OLD validates the whole PREPARED file and keeps it while it still serves:
// `keep_import` puts the shipped ranges into an import pin, a manifest holder
// disjoint from main, and cuts, so every imported page is packed before the
// pause. Each later catch-up round ships only the entries the round changed
// (ROUND, written by the child's `catch_up_export`); OLD checks it
// (`validate_round`) and patches the kept trees in memory (`apply_round`).
// The install cut takes the ranges from the kept trees and drops the pin in
// the same manifest, so it writes only the pages the rounds changed. A crash
// at any point before that cut reopens OLD with the pin and no kept import;
// the next cut drops the orphan pin.
type KeptRange: send {
    id: u32,
    kind: u8,
    residency: std.page_descriptor.Residency
}

pub opaque type KeptImport: send {
    meta: PreparedMeta,
    delta: List[CatalogChange],
    ranges: List[KeptRange],
    rewrites: List[ActivationRewrite],
    // The shipped ranges at `meta.base`: the pin's packed pages, plus the
    // pages each applied round wrote, which no holder references yet.
    tree: pages.PageTree,
    digest: Inline[u8, 32],
    round: u64
}

// One ROUND file: the round's number, the export stamps it moves the kept
// import between, and each shipped range's row count at `to`.
type RoundMeta: codec + send {
    round: u64,
    from: ExportStamp,
    to: ExportStamp,
    ops: u64,
    totals: List[RangeTotal]
}

type RangeTotal: codec + send {
    id: u32,
    rows: u64
}

// One entry the round changed: its new value, or None when the round removed
// it, and whether the entry existed before the round.
type RoundOp: codec + send {
    key: Bytes,
    value: Option[Bytes],
    prior: bool
}

// The child's record of what PREPARED shipped and the last round it wrote.
type ShippedImport: send {
    ranges: List[KeptRange],
    round: u64,
    // Roots built by deferred Tiered index builds in `write_prepared`, handed
    // into `staged.plan` on the first catch-up round.
    staged_roots: Option[(pages.Roots, u64)]
}

pub opaque type ValidatedRound: send {
    meta: RoundMeta,
    ops: List[RoundOp]
}

const ROUND_ROLE: u8 = 9

// Owner 3 is a pin role keyed by name (§13.10a "Owner 3 is a pin role"):
// `import` holds a kept import, `build` a hot Tiered build.
const IMPORT_PIN: String = "import"

const BUILD_PIN: String = "build"

fn owner3_pin_slot(db: Db, name: String) -> Option[u64] {
    for slot in 0u64 .. list.len(pages.holder_pins(db.holders)) {
        let held = pages.holder_pins(db.holders)[slot]
        if held.owner == ImportPin && held.name == name {
            return Some(slot)
        }
    }
    None
}

fn import_pin_slot(db: Db) -> Option[u64] {
    owner3_pin_slot(db, IMPORT_PIN)
}

fn build_pin_slot(db: Db) -> Option[u64] {
    owner3_pin_slot(db, BUILD_PIN)
}

// Every owner-3 pin no in-memory owner holds, ascending by slot (§3.5a
// "Orphans"): the import pin when no kept import owns it (the deploy that kept
// it crashed, aborted, installed without its cut, or renewed its export), and
// any other owner-3 pin, since a hot build runs no holder-free cut.
fn orphan_owner3_pins(db: Db) -> List[u64] {
    let mut out: List[u64] = list.new()
    if !is_disk(db) {
        return take out
    }
    let kept_import = match disk_state(db).imported {
        Some(_) => true,
        None => false,
    }
    for slot in 0u64 .. list.len(pages.holder_pins(db.holders)) {
        let held = pages.holder_pins(db.holders)[slot]
        if held.owner == ImportPin && !(kept_import && held.name == IMPORT_PIN) {
            list.push(mut out, slot)
        }
    }
    take out
}

fn same_stamp(a: ExportStamp, b: ExportStamp) -> bool {
    a.attempt == b.attempt && a.store_hi == b.store_hi && a.store_lo == b.store_lo && a.opened == b.opened && a.branch == b.branch && a.head == b.head && a.next_table == b.next_table && a.activation == b.activation && a.terminal == b.terminal && a.end == b.end
}

// M3 associates the trees with the most recent reservation on this attempt,
// then packs them under the import pin: the cut that adds the pin writes every
// imported page while OLD still serves.
pub fn keep_import(mut db: Db, take completed: Imported) -> Result[(), DeployError] waits {
    if !is_disk(db) || !matches_export(db, completed.meta.base) || disk_state(db).reserving != Some(completed.digest) {
        return Error(ExportMismatch)
    }
    let Imported(meta: take meta, delta: take delta, ranges: take built, rewrites: take rewrites, digest: digest, dir: import_dir, pass2_low: pass2_low, pass2_high: pass2_high, pass2_inline: pass2_inline, has_tiered: has_tiered, rewrites_checked: rewrites_checked) = take completed
    if has_tiered && !store_has_tiered(db) {
        if !pager.has_requests(db.pager) {
            deploy_result(start_residency_pager(mut db))?
        }
    }
    if !rewrites_checked && list.len(rewrites) != 0 {
        let mut range_ids: List[ValidatedRange] = list.with_capacity(list.len(built))
        for item in built {
            list.push(mut range_ids, ValidatedRange(id: item.id, kind: item.kind, rows: list.new(), count: item.count, digest: item.digest, row_bytes: item.charge, over_inline: 0, residency: item.residency))
        }
        if let Error(take problem) = validate_rewrite_base_tiered(db, rewrites, meta.base.next_table, range_ids) {
            forget_import(mut db)
            return Error(take problem)
        }
    }
    let mut collections = pages.new_page_tree(CollectionMap, pages.holder_heads(db.holders)[0u64].roots.collections.inline)
    let private_from = deploy_result(failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders))))?
    let mut next_stamp = private_from
    let mut ranges: List[KeptRange] = list.with_capacity(list.len(built))
    for shipped_range in built {
        if shipped_range.kind != 0 && shipped_range.residency == ResidentMemory {
            let key = deploy_result(failure_result_from_rep(catalog.prefix(shipped_range.id)))?
            deploy_result(failure_result_from_rep(pages.put_collection(mut collections, key, shipped_range.tree, shipped_range.kind, private_from, mut next_stamp)))?
        }
        list.push(mut ranges, KeptRange(id: shipped_range.id, kind: shipped_range.kind, residency: shipped_range.residency))
    }
    deploy_result(failure_result_from_rep(pages.canonical_tree(mut collections)))?
    pages.set_next_node(mut db.holders, next_stamp - 1)
    // The reservation's charge is now the pin's, which the cut accounts.
    db.accounting.ceiling = disk_state(db).options.resident_limit
    if has_tiered {
        let Some(d) = import_dir else {
            forget_import(mut db)
            return Error(ImportMalformed)
        }
        match build_tiered_import_pass2(mut db, d, built, mut collections, pass2_low, pass2_high, pass2_inline) {
            Ok(()) => (),
            Error(take problem) => {
                forget_import(mut db)
                return Error(take problem)
            },
        }
    }
    let tree = hold_import(mut db, take collections)?
    let kept = KeptImport(meta: take meta, delta: take delta, ranges: take ranges, rewrites: take rewrites, tree: take tree, digest: digest, round: 0)
    write_disk(mut db.disk, take kept, scoped fn(mut state: DiskState, take ready: KeptImport) {
        state.imported = Some(take ready)
        state.reserving = None
    })
    Ok(())
}

// Holds `collections` as the import pin, replacing any import pin still
// held, and cuts: every page the kept trees gained since the last such cut is
// packed while OLD serves. Returns the packed tree.
fn hold_import(mut db: Db, take collections: pages.PageTree) -> Result[pages.PageTree, DeployError] waits {
    let (take packed, _) = hold_import_emitted(mut db, take collections)?
    Ok(take packed)
}

fn hold_import_emitted(mut db: Db, take collections: pages.PageTree) -> Result[(pages.PageTree, Map[u64, std.page.PagePtr]), DeployError] waits {
    deploy_result(hold_owner3_emitted(mut db, IMPORT_PIN, take collections))
}

// Sets the owner-3 pin `name` to `collections` (ReplacePin over a listed one,
// an orphan included; AddPin otherwise) in one writer cut, and returns the
// packed tree with the stamps the cut emitted. A kept import's keep and round
// cuts and a hot build's build cuts are this cut.
fn hold_owner3_emitted(mut db: Db, name: String, take collections: pages.PageTree) -> Result[(pages.PageTree, Map[u64, std.page.PagePtr]), Error] waits {
    let mut held = pages.empty_roots()
    held.collections = take collections
    let watermark = failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders)))?
    let Some(following) = int.checked_add(pages.holder_next_pin(db.holders), 1) else {
        return Error(Limit(Ids))
    }
    let held_pin = pages.Pin(owner: ImportPin, name: string.from(name), branch: 0u32, version: pages.holder_heads(db.holders)[0u64].head, serial: pages.holder_next_pin(db.holders), roots: take held, watermark: watermark)
    pages.set_next_pin(mut db.holders, following)
    let change = match owner3_pin_slot(db, name) {
        Some(stale) => ReplacePin(stale, take held_pin),
        None => AddPin(take held_pin),
    }
    let mut emitted: Option[Map[u64, std.page.PagePtr]] = Some(map.new())
    let _ = cut_install_emitted(mut db, take change, mut emitted)?
    let Some(slot) = owner3_pin_slot(db, name) else {
        return Error(Missing("owner-3 pin"))
    }
    let stamps = match take emitted {
        Some(take out) => take out,
        None => map.new(),
    }
    Ok((pages.share_page_tree(pages.holder_pins(db.holders)[slot].roots.collections), take stamps))
}

// Each range PREPARED ships, with the kind its catalog record gives it and its
// residency in `collections`; a range with no record is dropped (kind 0).
fn shipped_ranges(collections: pages.PageTree, ranges: List[RangeChange]) -> Result[List[KeptRange], Error] {
    let mut out: List[KeptRange] = list.with_capacity(list.len(ranges))
    for shipped_range in ranges {
        let (kind, residency) = match shipped_range.catalog {
            Some(raw) => {
                let k = pages.descriptor_kind_byte(indexes.catalog_kind(decode_catalog(raw)?.record))
                let res = match std.page.lookup(collections.root, failure_result_from_rep(catalog.prefix(shipped_range.id))?) {
                    Some(desc) => pages.collection_descriptor(desc).residency,
                    None => ResidentMemory,
                }
                (k, res)
            },
            None => (0u8, ResidentMemory),
        }
        list.push(mut out, KeptRange(id: shipped_range.id, kind: kind, residency: residency))
    }
    Ok(take out)
}

// The schema commits a round ships moved OLD's records under the kept
// delta: each change's `before` follows them, so the install still finds
// the catalog the delta expects.
fn rebase_kept_delta(mut kept: KeptImport, steps: List[ExportStep]) {
    for step in steps {
        for op in step.catalog {
            for i in 0u64 .. list.len(kept.delta) {
                if kept.delta[i].key == op.key {
                    kept.delta[i].before = clone(op.value)
                }
            }
        }
    }
}

// The install's ranges, from the kept trees.
fn kept_ranges(kept: KeptImport) -> Result[List[ImportedRange], DeployError] {
    let mut out: List[ImportedRange] = list.with_capacity(list.len(kept.ranges))
    for shipped_range in kept.ranges {
        if shipped_range.kind == 0 {
            list.push(mut out, ImportedRange(id: shipped_range.id, kind: 0, tree: None, slot: None, rows: 0, charge: 0, count: 0, digest: 0, residency: ResidentMemory))
            continue
        }
        let key = deploy_result(failure_result_from_rep(catalog.prefix(shipped_range.id)))?
        let Some((slot, desc)) = std.page.collection_slot(kept.tree.root, key) else {
            return Error(Store(Missing("import range")))
        }
        let fields = pages.collection_descriptor(desc)
        if fields.residency == ResidentMemory {
            let tree: Option[Arc[std.page.Page]] = match slot {
                HotPage(child) => {
                    let (rows, _) = std.page.totals(child)
                    if rows == 0 {
                        None
                    } else {
                        Some(arc.share(child))
                    }
                },
                ColdPage(_) => return Error(Store(Missing("import range"))),
            }
            list.push(mut out, ImportedRange(id: shipped_range.id, kind: shipped_range.kind, tree: take tree, slot: None, rows: fields.rows, charge: fields.row_bytes, count: fields.rows, digest: 0, residency: ResidentMemory))
        } else {
            let installed_slot: Option[std.page.Slot] = if fields.rows == 0 {
                None
            } else {
                Some(clone(slot))
            }
            list.push(mut out, ImportedRange(id: shipped_range.id, kind: shipped_range.kind, tree: None, slot: take installed_slot, rows: fields.rows, charge: fields.row_bytes, count: fields.rows, digest: 0, residency: ResidentTiered))
        }
    }
    Ok(take out)
}

// A key the round removed or wrote, with its entry before the round's
// first change to it. `seq` orders a key's notes, so its first one wins.
type Touch {
    key: Bytes
    seq: u64
    prior: Option[Bytes]
}

// Notes `key` before the round changes it in `tree`.
fn note_touch(mut touched: List[Touch], tree: pages.PageTree, key: Bytes) -> Result[(), Error] {
    let prior = match pages.get_page_row(tree, key) {
        Some(raw) => Some(failure_result_from_rep(types.copied(raw))?),
        None => None,
    }
    let seq = list.len(touched)
    let note = Touch(key: failure_result_from_rep(types.copied(key))?, seq: seq, prior: take prior)
    failure_result_from_rep(types.capacity(list.try_reserve(mut touched, 1)))?
    list.push(mut touched, take note)
    Ok(())
}

// The entries a round changed: each touched key's entry before the round
// against the shipped ranges after it. An entry the round removed and wrote
// back unchanged is not an op.
fn round_ops(after: pages.PageTree, mut touched: List[Touch]) -> Result[List[RoundOp], Error] {
    list.sort(mut touched, fn(a: Touch, b: Touch) -> Order {
        match bytes_order(a.key, b.key) {
            Equal => if a.seq < b.seq {
                Less
            } else if b.seq < a.seq {
                Greater
            } else {
                Equal
            },
            other => other,
        }
    })
    let mut ops: List[RoundOp] = list.new()
    for i in 0u64 .. list.len(touched) {
        let note = view touched[i]
        if i != 0 && touched[i - 1].key == note.key {
            continue
        }
        let new = pages.get_page_row(after, note.key)
        match new {
            Some(raw) => {
                let had = match note.prior {
                    Some(prior) => {
                        if prior == raw {
                            continue
                        }
                        true
                    },
                    None => false,
                }
                list.push(mut ops, RoundOp(key: failure_result_from_rep(types.copied(note.key))?, value: Some(failure_result_from_rep(types.copied(raw))?), prior: had))
            },
            None => {
                if let Some(_) = note.prior {
                    list.push(mut ops, RoundOp(key: failure_result_from_rep(types.copied(note.key))?, value: None, prior: true))
                }
            },
        }
    }
    Ok(take ops)
}

fn bytes_order(a: Bytes, b: Bytes) -> Order {
    if a < b {
        Less
    } else if b < a {
        Greater
    } else {
        Equal
    }
}

// Writes ROUND: the meta frame, then one frame per op in key order.
fn write_round(d: Dir, id: StoreId, take meta: RoundMeta, ops: List[RoundOp]) -> Result[(), DeployError] waits {
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: ROUND_ROLE, seq: meta.round)
    let meta_codec: std.codec.Codec[RoundMeta] = std.codec.of()
    let mut encoded: Bytes = list.new()
    std.codec.encode(meta_codec, meta, mut encoded) ?=> |_| Scratch(Limit(Value))
    if list.len(encoded) > option.unwrap(manifest.disk_kind_limit(0x0086)) {
        return Error(Scratch(Limit(Value)))
    }
    let mut file = scratch_result(open_frames(d, "ROUND", ctx))?
    scratch_result(write_prepared_payload(mut file, 0x0086, encoded))?
    let op_codec: std.codec.Codec[RoundOp] = std.codec.of()
    for op in ops {
        scratch_result(write_prepared_frame(mut file, 0x0087, op_codec, op))?
    }
    scratch_result(finish_frames(take file))
}

// A scratch frame file (PREPARED, ROUND) written in batches of about 1 MiB
// rather than a write per frame; the bytes are the same.
type FrameFile {
    file: HostFile,
    pending: Bytes,
    ctx: format.DiskContext,
    offset: u64
}

const FRAME_BATCH: u64 = 1048576

fn open_frames(d: Dir, name: String, ctx: format.DiskContext) -> Result[FrameFile, Error] waits {
    let file = failure_result_from_rep(manifest.disk_io(host.open(d, name, Write)))?
    let header = failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0u64, 0)))?
    Ok(FrameFile(file: take file, pending: take header, ctx: ctx, offset: 72u64))
}

fn write_prepared_frame[T](mut out: FrameFile, kind: u16, codec: std.codec.Codec[T], value: T) -> Result[(), Error] waits {
    let mut encoded: Bytes = list.new()
    std.codec.encode(codec, value, mut encoded) ?=> |_| Limit(Value)
    write_prepared_payload(mut out, kind, encoded)
}

fn write_prepared_payload(mut out: FrameFile, kind: u16, encoded: Bytes) -> Result[(), Error] waits {
    let raw = failure_result_from_rep(types.capacity(format.disk_seal(out.ctx, out.offset, kind, 1, encoded)))?
    out.offset += list.len(raw)
    failure_result_from_rep(types.capacity(list.try_reserve(mut out.pending, list.len(raw))))?
    list.append(mut out.pending, raw)
    if list.len(out.pending) >= FRAME_BATCH {
        flush_frames(mut out)?
    }
    Ok(())
}

fn flush_frames(mut out: FrameFile) -> Result[(), Error] waits {
    if list.len(out.pending) != 0 {
        if let Error(e) = host.write(mut out.file, out.pending) {
            return Error(Io(e.error))
        }
        list.clear(mut out.pending)
    }
    Ok(())
}

fn finish_frames(take out: FrameFile) -> Result[(), Error] waits {
    let mut done = take out
    flush_frames(mut done)?
    let FrameFile(file: take file, ..) = take done
    let mut written = take file
    failure_result_from_rep(manifest.disk_io(host.sync(mut written)))?
    failure_result_from_rep(manifest.disk_io(host.close(take written)))
}

// Reads and checks ROUND without touching the store: frames sealed for this
// store and round, ops in strictly increasing key order, each a well-formed
// entry change.
pub fn validate_round(d: Dir) -> Result[ValidatedRound, DeployError] waits {
    let mut file = scratch_result(failure_result_from_rep(manifest.disk_io(host.open(d, "ROUND", Read))))?
    let header = scratch_result(prepared_read(mut file, 72u64))?
    let head = deploy_result(failure_result_from_rep(manifest.disk_read_header("ROUND", header, ROUND_ROLE, None, optional_store_key_to_rep(None))))?
    let mut input = PreparedInput(file: take file, ctx: head.context, offset: 72u64, digest: std.sha256.start(), peek: None)
    let meta_codec: std.codec.Codec[RoundMeta] = std.codec.of()
    let op_codec: std.codec.Codec[RoundOp] = std.codec.of()
    let meta = prepared_frame(mut input, 0x0086, meta_codec)?
    if meta.round == 0 || meta.round != head.context.seq || meta.to.store_hi != head.context.store.hi || meta.to.store_lo != head.context.store.lo || meta.from.store_hi != meta.to.store_hi || meta.from.store_lo != meta.to.store_lo {
        return Error(ImportMalformed)
    }
    let mut ops: List[RoundOp] = list.with_capacity(order.min(meta.ops, 65536u64))
    for i in 0u64 .. meta.ops {
        let op = prepared_frame(mut input, 0x0087, op_codec)?
        if list.len(op.key) < 4 || (i != 0 && !(ops[i - 1u64].key < op.key)) {
            return Error(ImportMalformed)
        }
        if let None = op.value {
            if !op.prior {
                return Error(ImportMalformed)
            }
        }
        list.push(mut ops, take op)
    }
    let mut rest: Bytes = list.with_capacity(1)
    if scratch_result(failure_result_from_rep(manifest.disk_io(host.read(mut input.file, mut rest))))? != 0 {
        return Error(ImportMalformed)
    }
    let PreparedInput(file: take done, ..) = take input
    scratch_result(failure_result_from_rep(manifest.disk_io(host.close(take done))))?
    Ok(ValidatedRound(meta: take meta, ops: take ops))
}

// Applies a checked round to the kept import, on OLD's head. The round must
// follow the last one kept, end at the export lease, and change exactly the
// entries it names: an op that writes a new entry finds none, one that
// replaces or removes an entry finds it. Each shipped range then holds the
// row count the child counted. Any refusal forgets the kept import; the deploy
// is over and the next cut drops its pin.
pub fn apply_round(mut db: Db, take checked: ValidatedRound) -> Result[u64, DeployError] waits {
    deploy_result(healthy(db))?
    if !is_disk(db) || !matches_export(db, checked.meta.to) {
        return Error(ExportMismatch)
    }
    let taken = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Option[KeptImport] {
        replace(mut state.imported, None)
    })
    let Some(take kept) = take taken else {
        return Error(ExportMismatch)
    }
    let KeptImport(meta: take kept_meta, delta: take delta, ranges: take ranges, rewrites: take rewrites, tree: take kept_tree, digest: digest, round: kept_round) = take kept
    let ValidatedRound(meta: take meta, ops: take ops) = take checked
    if meta.round != kept_round + 1 || !same_stamp(meta.from, kept_meta.base) || list.len(meta.totals) != shipped_count(ranges) {
        return Error(ExportMismatch)
    }
    let mut tree = take kept_tree
    let dirty_bytes = disk_state(db).options.dirty_bytes
    let mut private_from = deploy_result(failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders))))?
    let mut next_stamp = private_from
    for take op in take ops {
        let RoundOp(key: take key, value: take value, prior: prior) = take op
        let owner: u32 = list.word_be(key, 0)
        if !ships(ranges, owner) {
            return Error(ImportMalformed)
        }
        if deploy_result(table_is_tiered(tree, owner))? {
            apply_one_tiered_round_op(mut db, mut tree, take key, take value, prior, private_from, mut next_stamp)?
            if deploy_result(tiered_tree_hot_bytes(tree))? >= dirty_bytes {
                deploy_result(failure_result_from_rep(pages.canonical_tree(mut tree)))?
                pages.set_next_node(mut db.holders, next_stamp - 1)
                let packed_tree = hold_import(mut db, take tree)?
                tree = take packed_tree
                private_from = deploy_result(failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders))))?
                next_stamp = private_from
            }
            continue
        }
        let present = is_present(pages.get_page_row(tree, key))
        match take value {
            Some(take raw) => {
                if present != prior {
                    return Error(ImportMalformed)
                }
                deploy_result(failure_result_from_rep(pages.put_page_row(mut tree, key, take raw, private_from, mut next_stamp)))?
            },
            None => {
                if !present {
                    return Error(ImportMalformed)
                }
                let _ = deploy_result(failure_result_from_rep(pages.remove_page_row(mut tree, key, private_from, mut next_stamp)))?
            },
        }
    }
    deploy_result(failure_result_from_rep(pages.canonical_tree(mut tree)))?
    pages.set_next_node(mut db.holders, next_stamp - 1)
    for total in meta.totals {
        if !ships(ranges, total.id) {
            return Error(ImportMalformed)
        }
        if deploy_result(range_rows(tree, total.id))? != total.rows {
            return Error(ImportMalformed)
        }
    }
    let RoundMeta(round: round, to: take to, ..) = take meta
    let PreparedMeta(target: take target, next_table: next_table, changes: change_count, ranges: range_count, ..) = take kept_meta
    let advanced = PreparedMeta(base: take to, target: take target, next_table: next_table, changes: change_count, ranges: range_count)
    // The round's pages are packed now, while OLD serves, never by the install.
    let packed = hold_import(mut db, take tree)?
    let kept_now = KeptImport(meta: take advanced, delta: take delta, ranges: take ranges, rewrites: take rewrites, tree: take packed, digest: digest, round: round)
    write_disk(mut db.disk, take kept_now, scoped fn(mut state: DiskState, take ready: KeptImport) {
        state.imported = Some(take ready)
    })
    Ok(round)
}

fn is_present(found: Option[View[Bytes]]) -> bool {
    match found {
        Some(_) => true,
        None => false,
    }
}

fn ships(ranges: List[KeptRange], id: u32) -> bool {
    for shipped_range in ranges {
        if shipped_range.id == id && shipped_range.kind != 0 {
            return true
        }
    }
    false
}

fn shipped_count(ranges: List[KeptRange]) -> u64 {
    let mut n = 0u64
    for shipped_range in ranges {
        if shipped_range.kind != 0 {
            n += 1
        }
    }
    n
}

// Each shipped range's row count in `tree`, in range order.
fn range_totals(tree: pages.PageTree, ranges: List[KeptRange]) -> Result[List[RangeTotal], Error] {
    let mut out: List[RangeTotal] = list.new()
    for shipped_range in ranges {
        if shipped_range.kind == 0 {
            continue
        }
        list.push(mut out, RangeTotal(id: shipped_range.id, rows: range_rows(tree, shipped_range.id)?))
    }
    Ok(take out)
}

fn range_rows(tree: pages.PageTree, id: u32) -> Result[u64, Error] {
    match std.page.lookup(tree.root, failure_result_from_rep(catalog.prefix(id))?) {
        Some(raw) => Ok(pages.collection_descriptor(raw).rows),
        None => Ok(0u64),
    }
}

// A holder-free cut's delta: every orphan owner-3 pin goes in this one cut.
fn orphan_owner3_delta(db: Db) -> HolderDelta {
    let orphans = orphan_owner3_pins(db)
    if list.len(orphans) == 0 {
        return NoHolderChange
    }
    RemovePins(take orphans)
}

// Drops `slots` (ascending) in descending order, so each slot still names
// its pin when it goes.
fn drop_pin_slots(mut db: Db, slots: List[u64]) {
    let mut at = list.len(slots)
    while at > 0 {
        at -= 1
        let slot = slots[at]
        let count_bytes = manifest.pin_root_bytes(pages.holder_pins(db.holders)[slot].name, pages.holder_pins(db.holders)[slot].roots)
        pages.drop_pin(mut db.holders, slot, count_bytes)
    }
}

fn one_slot(slot: u64) -> List[u64] {
    let mut out: List[u64] = list.with_capacity(1)
    list.push(mut out, slot)
    take out
}

// The pin slots a cut drops, ascending: a RemovePins, or the owner-3 pin a
// publish removes.
fn removed_pins(delta: HolderDelta) -> List[u64] {
    match delta {
        RemovePins(slots) => clone(slots),
        ReplaceMain(main, _) => match main.drop_pin {
            Some(slot) => one_slot(slot),
            None => list.new(),
        },
        _ => list.new(),
    }
}

// The installed state's account: the owner-3 pin the publish drops holds
// nothing main will not. Every other pin stays in the account.
fn install_account(db: Db, roots: pages.Roots, dropped: Option[u64]) -> Result[u64, DeployError] {
    let mut s = deploy_result(failure_result_from_rep(types.capacity(current_state(db))))?
    s.tips[0].roots = pages.share_roots(roots)
    if let Some(slot) = dropped {
        let _ = list.remove(mut s.pins, slot)
    }
    deploy_result(failure_result_from_rep(types.capacity(pages.state_account(s))))
}

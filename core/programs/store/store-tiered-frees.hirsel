type DeferredFree: shareable + send {
    branch_id: u32,
    target: TieredTarget
}

fn deferred_free_value(row: DeferredFree) -> Bytes {
    let (tag, take payload): (u8, Bytes) = match row.target {
        TieredPage(ptr) => (0, std.page.encode_ptr(ptr)),
        TieredBlob(reference) => (1, std.page.encode_ref(reference)),
    }
    let mut value: Bytes = list.with_capacity(5 + list.len(payload))
    list.push(mut value, tag)
    list.put_word_le(mut value, row.branch_id)
    list.append(mut value, payload)
    take value
}

fn deferred_free_entry(seq: u64, row: DeferredFree) -> std.page.Entry {
    let mut key: Bytes = list.with_capacity(8)
    list.put_word_be(mut key, seq)
    std.page.Entry(key: take key, cell: InlineValue(deferred_free_value(row)))
}

fn decode_deferred_free(file: String, at: u64, key: Bytes, value: Bytes, manifest: PageManifest) -> Result[(u64, DeferredFree), Error] {
    if list.len(key) != 8 || list.len(value) < 5 {
        return Error(disk_fault(file, at, Malformed))
    }
    let seq: u64 = list.word_be(key, 0)
    let branch_id: u32 = list.word_le(value, 1)
    if seq >= manifest.deferred_next || branch_id >= manifest.next_branch {
        return Error(disk_fault(file, at, Malformed))
    }
    let target = match value[0u64] {
        0 if list.len(value) == 41 => {
            let ptr = std.page.decode_ptr(list.slice(value, 5, 41)) ?=> |_| disk_fault(file, at, Malformed)
            TieredPage(ptr)
        },
        1 if list.len(value) == 47 => {
            let reference = std.page.decode_ref(list.slice(value, 5, 47)) ?=> |_| disk_fault(file, at, Malformed)
            TieredBlob(reference)
        },
        _ => return Error(disk_fault(file, at, Malformed)),
    }
    Ok((seq, DeferredFree(branch_id: branch_id, target: take target)))
}

fn validate_deferred_target(inventory: RecoveryInventory, target: TieredTarget) -> Result[(), Error] {
    let frame = tiered_frame_id(target)
    let path = paged_pack_path(frame.pack)?
    let (class, least, limit): (u8, u64, u64) = match target {
        TieredPage(_) => (3, 24, PAGE_LIMIT),
        TieredBlob(_) => (4, 8, BLOB_LIMIT),
    }
    let Some(pack) = map.get(inventory.packs, frame.pack) else {
        return Error(disk_fault(path, frame.offset, Malformed))
    }
    if pack.class != class || frame.stamp == 0 || frame.stamp >= inventory.next_stamp || frame.len < least || frame.len > limit || frame.offset < 72 || frame.offset >= pack.index || 16 + frame.len > pack.index - frame.offset {
        return Error(disk_fault(path, frame.offset, Malformed))
    }
    Ok(())
}

type TieredDeferredQueue {
    rows: std.omap.OMap[u64, DeferredFree],
    issued: u64,
    next_seq: u64
}

fn enqueue_tiered_free(mut queue: TieredDeferredQueue, take row: DeferredFree) -> Result[u64, Error] {
    let seq = queue.next_seq
    let following = stamp_after(seq)?
    let (take pending, issued) = disk_allocation(scoped fn() -> Result[(std.omap.OMap[u64, DeferredFree], u64), Error] {
        let mut draw = queue.issued
        let (take rows, _) = std.omap.insert(mut draw, queue.rows, seq, clone(row))
        Ok((take rows, draw))
    })?
    queue.rows = take pending
    queue.issued = issued
    queue.next_seq = following
    Ok(seq)
}

type TieredDrainKill: send {
    branch_id: u32,
    frame: ReplacedFrame
}

fn tiered_drain_page(cut: TieredPageSource, ptr: std.page.PagePtr, branch_id: u32, mut queue: TieredDeferredQueue) -> Result[(), Error] waits {
    let frame = fold_frame_at(cut, TieredPage(ptr))?
    let image = std.page.image_of(fold_page(frame))
    for slot in 0u64 .. std.page.count(image) {
        let edge: Option[TieredTarget] = match std.page.owning_edge(image, slot) {
            Some(PageEdge(child)) => Some(TieredPage(child)),
            Some(BlobEdge(body)) => Some(TieredBlob(body)),
            None => None,
        }
        if let Some(take child) = take edge {
            let _ = enqueue_tiered_free(mut queue, DeferredFree(branch_id: branch_id, target: take child))?
        }
    }
    Ok(())
}

fn drain_tiered_frees(cut: TieredPageSource, mut queue: TieredDeferredQueue, rewritten: Map[u64, ()], budget: u64) -> Result[List[TieredDrainKill], Error] waits {
    let mut lower: std.omap.Bound[u64] = Unbounded
    let mut pages = 0u64
    let mut killed: List[TieredDrainKill] = list.new()
    while pages < budget {
        let item: Option[(u64, DeferredFree)] = disk_allocation(scoped fn() -> Result[Option[(u64, DeferredFree)], Error] {
            let mut cursor = std.omap.range(queue.rows, lower, Unbounded)
            Ok(std.omap.next(mut cursor))
        })?
        let Some((seq, row)) = take item else {
            break
        }
        lower = Excluded(seq)
        if map.contains(rewritten, seq) {
            continue
        }
        let replaced = match row.target {
            TieredPage(ptr) => {
                tiered_drain_page(cut, ptr, row.branch_id, mut queue)?
                pages += 1
                replaced_page(ptr)
            },
            TieredBlob(body) => replaced_blob(body),
        }
        capacity(list.try_reserve(mut killed, 1))?
        let (take remaining, following) = disk_allocation(scoped fn() -> Result[(std.omap.OMap[u64, DeferredFree], u64), Error] {
            let mut draw = queue.issued
            let rows = std.omap.remove(mut draw, queue.rows, seq)
            Ok((take rows, draw))
        })?
        queue.rows = take remaining
        queue.issued = following
        list.push(mut killed, TieredDrainKill(branch_id: row.branch_id, frame: replaced))
    }
    Ok(take killed)
}

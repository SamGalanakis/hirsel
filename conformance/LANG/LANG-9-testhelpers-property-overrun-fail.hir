// rule: LANG-9
// expect: fail LANG-9 at line 21
// stdout: test log: evaluated=0: no case evaluated the law
// steps: 8000000
// 8200 draws overrun the 8192-choice limit, over five million steps
// entry: trial
fn generate(mut s: test.Source) -> u64 {
  let mut i: u64 = 0
  while i < 8200 {
    let _ = test.choice(mut s, 7)
    i += 1
  }
  0
}

fn law(value: u64) -> bool uses {} {
  true
}

pub fn trial(t: Test) -> Result[(), ()] {
  test.property_cases(t, 1, generate, law, u64.to_string)
  Ok(())
}

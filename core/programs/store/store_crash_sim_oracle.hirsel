// The crash-sim oracle's fault evidence (store_crash_sim_laws.hirsel). A
// tapped std.sim.fs server sends one Receipt for each fault it delivered and
// each damaged read it answered; the predicates below decide from those
// receipts which errors a step may return and how far a recovery may roll
// back.
type CsimEvidence {
    // The current mount's receipts, less any the server withdrew.
    seen: List[std.sim.world.Receipt],
    // Write faults delivered to journal segments since the last cut-level
    // point (a cut, or a cut-made pin, unpin, delete_branch or residency
    // change), across mounts.
    journal: List[CsimWrite],
    // Since the same point: the receipts of replies that made write damage
    // durable (a damaging write on a Durable or Direct handle, a sync of a
    // damaged file).
    persisted: List[std.sim.world.Receipt],
    // How often the driver dropped the Db without a clean close.
    crashes: u64,
    // The most commits one journal write takes (Options.group_commits).
    group: u64
}

// A damaging journal write, with the number of worlds the history held and
// the driver's crash count when its receipt was drained.
type CsimWrite {
    worlds: u64,
    crashes: u64,
    receipt: std.sim.world.Receipt
}

fn csim_evidence(group: u64) -> CsimEvidence {
    CsimEvidence(seen: list.new(), journal: list.new(), persisted: list.new(), crashes: 0, group: group)
}

// A cut-level point: no earlier journal write can explain a rollback.
fn csim_forget_journal(mut ev: CsimEvidence) {
    ev.journal = list.new()
    ev.persisted = list.new()
}

// The last component of a served path: `/s/j-3` is `j-3`.
fn csim_leaf(p: String) -> String {
    let mut from = 0u64
    while let Some(i) = string.find(p, from, "/") {
        from = i + 1
    }
    string.from(string.slice(p, from, string.byte_len(p)))
}

// A journal segment (`j-<seq>`), not its END file (`j-<seq>.end`).
fn csim_journal_segment(p: String) -> bool {
    let leaf = csim_leaf(p)
    string.starts_with(leaf, "j-") && !string.ends_with(leaf, ".end")
}

fn csim_without(rs: List[std.sim.world.Receipt], mount: u64, site: u64) -> List[std.sim.world.Receipt] {
    let mut kept: List[std.sim.world.Receipt] = list.new()
    for r in rs {
        if r.mount != mount || r.site != site {
            list.push(mut kept, clone(r))
        }
    }
    take kept
}

// Adds one receipt, drained when the history held `worlds` worlds. An
// Undelivered one withdraws its site's receipts: the reply that would have
// shown the fault never reached the store.
fn csim_note(mut ev: CsimEvidence, take r: std.sim.world.Receipt, worlds: u64) {
    match r.outcome {
        Undelivered => {
            ev.seen = csim_without(ev.seen, r.mount, r.site)
            ev.persisted = csim_without(ev.persisted, r.mount, r.site)
            let mut kept: List[CsimWrite] = list.new()
            for w in ev.journal {
                if w.receipt.mount != r.mount || w.receipt.site != r.site {
                    list.push(mut kept, CsimWrite(worlds: w.worlds, crashes: w.crashes, receipt: clone(w.receipt)))
                }
            }
            ev.journal = take kept
        },
        Acknowledged => {
            if csim_journal_segment(r.path) {
                list.push(mut ev.journal, CsimWrite(worlds: worlds, crashes: ev.crashes, receipt: clone(r)))
            }
            list.push(mut ev.seen, take r)
        },
        Persisted => list.push(mut ev.persisted, take r),
        _ => list.push(mut ev.seen, take r),
    }
}

fn csim_damaged_read(r: std.sim.world.Receipt) -> bool {
    match r.outcome {
        DamagedRead => true,
        _ => false,
    }
}

// An Io or Poisoned error is excused only by a refusal or a failed barrier
// the server delivered on this mount, or by a damaged read on it.
fn csim_io_excused(ev: CsimEvidence, e: Error) -> bool {
    if !csim_io(e) {
        return false
    }
    for r in ev.seen {
        match r.outcome {
            Refused => return true,
            Barrier(_) => return true,
            DamagedRead => return true,
            _ => (),
        }
    }
    false
}

// Corrupt is excused only by a damaged read of the file it names (by leaf,
// so damage a backup copied out of `s/` still names its source), and
// Unsupported by any damaged read on this mount.
fn csim_damage_excused(ev: CsimEvidence, e: Error) -> bool {
    for r in ev.seen {
        if csim_damaged_read(r) {
            match e {
                Corrupt(f) => if csim_leaf(r.path) == f.file {
                    return true
                },
                Unsupported(_) => return true,
                _ => return false,
            }
        }
    }
    false
}

fn csim_excused(ev: CsimEvidence, e: Error) -> bool {
    csim_io_excused(ev, e) || csim_damage_excused(ev, e)
}

// Whether a delivered reply made the damage of journal write `w` durable
// before any power cut: a Persisted receipt for its file from the same
// site or a later one, with the same crash count.
fn csim_synced(ev: CsimEvidence, w: std.sim.world.Receipt) -> bool {
    for p in ev.persisted {
        if p.node == w.node && p.crashes == w.crashes && (p.mount > w.mount || (p.mount == w.mount && p.site >= w.site)) {
            return true
        }
    }
    false
}

// Whether a recovery may show world `found` when the floor is `floor`
// (both indexes into the history since the last cut-level point). Below
// the floor only D6 (STORE-SPEC §3.4) explains it: a write fault delivered
// to a journal segment since that point and made durable, then a crash,
// then this mount's recovery reading the damaged bytes. The crash is a
// power cut (the read's receipt counts more of them than the write's) or
// a Db the driver dropped without a clean close after it drained the
// write. D6 drops the damaged frame and every frame after it; a
// frame holds at most `group` commits, the newest recorded by the time its
// receipt was drained, so the recovery goes back at most to just before
// the oldest of them. That bound holds for a lost write and a forward
// misdirect, which leave the older bytes of the file as they were. A
// backward misdirect damages an older frame, and so can a Corrupt: it flips
// one bit anywhere in the write, and a group write restarts at the tail's
// 4096-byte block, over every acknowledged frame the block holds. Only the
// cut-level point bounds those two. A Torn receipt explains nothing here: a
// power cut tears only a write whose success was never delivered.
fn csim_rollback_allowed(ev: CsimEvidence, found: u64, floor: u64) -> bool {
    if found >= floor {
        return true
    }
    for w in ev.journal {
        let older = match w.receipt.fault {
            Some(Corrupt) => true,
            _ => w.receipt.landed < w.receipt.at,
        }
        if csim_synced(ev, w.receipt) && (older || found + ev.group + 1 >= w.worlds) {
            for r in ev.seen {
                if csim_damaged_read(r) && r.node == w.receipt.node && (w.receipt.crashes < r.crashes || w.crashes < ev.crashes) {
                    return true
                }
            }
        }
    }
    false
}

// After an accepted recovery, drained `mark` journal receipts before its
// open. Open rotated to a new segment, so a fault in an older one now reads
// as Corrupt (below the successor's `prev_end`) and drops nothing; a fault
// in open's own writes bounds nothing but the recovered world.
fn csim_recovery_spends(mut ev: CsimEvidence, mark: u64) {
    let mut kept: List[CsimWrite] = list.new()
    for i in mark .. list.len(ev.journal) {
        list.push(mut kept, CsimWrite(worlds: 0, crashes: ev.journal[i].crashes, receipt: clone(ev.journal[i].receipt)))
    }
    ev.journal = take kept
}

// The receipts behind a failure, for its text.
fn csim_show_evidence(ev: CsimEvidence, mut text: String) {
    string.push(mut text, "; receipts:")
    for r in ev.seen {
        string.push(mut text, " ")
        string.push(mut text, r.op)
        string.push(mut text, " ")
        string.push(mut text, r.path)
        string.push(mut text, match r.outcome {
            Refused => " refused",
            Barrier(_) => " barrier",
            Acknowledged => " damaged-write",
            DamagedRead => " damaged-read",
            Undelivered => " undelivered",
            Persisted => " persisted",
            Torn(_) => " torn",
        })
        string.push(mut text, "@")
        string.push_u64(mut text, r.site)
        if let Torn(t) = r.outcome {
            string.push(mut text, " kept")
            for (at, n) in t.kept {
                string.push(mut text, " ")
                string.push_u64(mut text, at)
                string.push(mut text, "+")
                string.push_u64(mut text, n)
            }
        }
    }
}

pub opaque type Log[V]: shareable + send {
    binding: ValueCollection[V]
}

pub type LogBounds: shareable + send {
    first: u64,
    next: u64
}

pub fn log_identity[V](l: Log[V]) -> (StoreId, u32) {
    (l.binding.store, l.binding.id)
}

pub fn log_schemas[V](l: Log[V]) -> Arc[RowSchemas] {
    arc.share(l.binding.readers.schemas)
}

// A Log's retention (§14.4a). `Forever` keeps every entry. `Keep(n)` keeps
// the newest n: the head's retention sweep trims the older ones.
pub type Retain: codec = Forever | Keep(u64)

pub fn declare_log[V](mut d: Declare, name: String, take value: std.codec.Codec[V], retain: Retain) -> Result[Log[V], Error] {
    let schema = std.codec.key_schema(std.codec.key_u64()) ?=> |_| Schema(0)
    let collection = declare_value_collection(mut d, name, CatalogLog, schema, take value)?
    let keep: Option[u64] = match retain {
        Forever => None,
        Keep(n) => Some(n),
    }
    list.push(mut d.plan.schema.retention, catalog.LogRetention(id: collection.id, catalog_key: arc.share(collection.catalog_key), catalog_page: arc.share(collection.catalog_page), keep: keep))
    Ok(Log(binding: take collection))
}

// The store's retention is a whole declaration's (`seal`, an activation's
// install): every Log it declares `Keep(n)`, and no other.
fn bind_retention(mut db: Db, take declared: List[catalog.LogRetention]) {
    indexes.bind_retention(mut db.indexes, take declared)
}

// One slice of the retention sweep (§14.4a): one commit on main that trims
// the Logs declared `Keep(n)` towards their newest n, lowest id first,
// removing at most `limit` entries in all. None when no Log is over its
// retention. It runs under an export lease: catch-up replays a data commit
// (§3.5a). A Log that main's head no longer has (dropped or renamed away) is
// skipped.
pub fn retain_step(mut db: Db, limit: u64) -> Result[Option[Ticket], Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    if limit == 0 {
        return Error(Limit(Transaction))
    }
    let ids = indexes.retention_ids(db.indexes)
    let mut floors: List[(u32, u64)] = list.new()
    let mut budget = limit
    for id in ids {
        if budget == 0 {
            break
        }
        let Some(r) = indexes.retention(db.indexes, id) else {
            continue
        }
        let Some(keep) = r.keep else {
            continue
        }
        let roots = pages.holder_heads(db.holders)[0].roots
        if let Error(_) = failure_result_from_rep(catalog.readable(roots, r.catalog_key, r.catalog_page, id)) {
            continue
        }
        let Ok(held) = committed_log_bounds(roots.collections, id) else {
            continue
        }
        let rows = held.next - held.first
        if rows <= keep {
            continue
        }
        let removed = order.min(rows - keep, budget)
        budget -= removed
        list.push(mut floors, (id, held.first + removed))
    }
    if list.len(floors) == 0 {
        return Ok(None)
    }
    let at = keyed_time(db)
    let no_reply: Option[fn(Error) -> bool] = None
    let settled = store_body_at(mut db, 0u64, at, None, no_reply, scoped fn(mut tx: Tx) -> Result[(), Error] {
        failure_result_from_rep(txn.check_write_attempt(tx.inner))?
        for (id, floor) in floors {
            failure_result_from_rep(txn.trim_log_floor(mut tx.inner, id, floor))?
        }
        Ok(())
    })?
    match take settled {
        Committed(take done) => Ok(Some(done.ticket)),
        Refused(c) => Error(Full(c)),
        Aborted(Undone(value: take e, ..)) => Error(take e),
        _ => Error(Missing("retention")),
    }
}

pub fn bounds[V](tx: Tx, l: Log[V]) -> Result[LogBounds, Error] {
    readable_value(tx.info.id.store, txn.tx_roots(tx.inner), l.binding)?
    failure_result_from_rep(txn.note_read(tx.inner, Point(failure_result_from_rep(catalog.prefix(l.binding.id))?)))?
    transaction_log_bounds(tx, l.binding.id)
}

pub fn log_fetch[V](tx: Tx, l: Log[V], seq: u64) -> Result[Option[V], Error] {
    readable_value(tx.info.id.store, txn.tx_roots(tx.inner), l.binding)?
    let key = failure_result_from_rep(pager.log_key(l.binding.id, seq))?
    let current = transaction_log_bounds(tx, l.binding.id)?
    if seq < current.first || seq >= current.next {
        failure_result_from_rep(txn.note_read(tx.inner, Point(take key)))?
        return Ok(None)
    }
    let row = (txn.transaction_row(tx.inner, key) ?=> failure_from_rep)
    failure_result_from_rep(txn.note_read(tx.inner, Point(take key)))?
    decode_log_row(l, row)
}

pub fn last[V](tx: Tx, l: Log[V]) -> Result[Option[(u64, V)], Error] {
    readable_value(tx.info.id.store, txn.tx_roots(tx.inner), l.binding)?
    let id = l.binding.id
    let current = transaction_log_bounds(tx, id)?
    if current.first == current.next {
        failure_result_from_rep(txn.note_read(tx.inner, Span(failure_result_from_rep(catalog.prefix(id))?, failure_result_from_rep(catalog.prefix(id + 1))?)))?
        return Ok(None)
    }
    let seq = current.next - 1
    let key = failure_result_from_rep(pager.log_key(id, seq))?
    let row = (txn.transaction_row(tx.inner, key) ?=> failure_from_rep)
    failure_result_from_rep(txn.note_read(tx.inner, Span(take key, failure_result_from_rep(catalog.prefix(id + 1))?)))?
    decode_log_last(l, seq, row)
}

pub fn log_bounds[V](r: Reader, s: Snapshot, l: Log[V]) -> Result[LogBounds, Error] waits {
    read_access(r, s)?
    disk_allocation(scoped fn() -> Result[LogBounds, Error] {
        readable_value(s.store, s.roots, l.binding)?
        committed_log_bounds(s.roots.collections, l.binding.id)
    })
}

pub fn log_get[V](r: Reader, s: Snapshot, l: Log[V], seq: u64) -> Result[Option[V], Error] waits {
    read_access(r, s)?
    readable_value(s.store, s.roots, l.binding)?
    let key = failure_result_from_rep(pager.log_key(l.binding.id, seq))?
    snapshot_point(r, s, key, scoped fn(raw: Option[View[Bytes]]) -> Result[Option[V], Error] {
        decode_log_row(l, raw)
    })
}

pub fn log_last[V](r: Reader, s: Snapshot, l: Log[V]) -> Result[Option[(u64, V)], Error] waits {
    let current = log_bounds(r, s, l)?
    if current.first == current.next {
        return Ok(None)
    }
    let seq = current.next - 1
    let key = failure_result_from_rep(pager.log_key(l.binding.id, seq))?
    snapshot_point(r, s, key, scoped fn(raw: Option[View[Bytes]]) -> Result[Option[(u64, V)], Error] {
        decode_log_last(l, seq, raw)
    })
}

pub fn log_scan[V](r: Reader, s: Snapshot, l: Log[V], lo: Bound[u64], hi: Bound[u64]) -> Result[Rows[u64, V], Error] waits {
    read_access(r, s)?
    readable_value(s.store, s.roots, l.binding)?
    let id = l.binding.id
    let codec = std.codec.key_u64()
    let low = lower_bytes(id, typed_bound(codec, lo)?, false)?
    let high = lower_bytes(id, typed_bound(codec, hi)?, true)?
    open_snapshot_rows(s, id, take low, take high, false, log_decoder(l))
}

pub fn log_range[V](tx: Tx, l: Log[V], lo: Bound[u64], hi: Bound[u64]) -> Result[TxRows[u64, V], Error] in tx {
    readable_value(tx.info.id.store, txn.tx_roots(tx.inner), l.binding)?
    let id = l.binding.id
    let head = committed_log_bounds(txn.tx_roots(tx.inner).collections, id)?
    let current = transaction_log_bounds(tx, id)?
    let lower = order.max(log_endpoint(lo, false), current.first)
    let upper = order.min(log_endpoint(hi, true), current.next)
    let committed_low = failure_result_from_rep(pager.log_key(id, lower))?
    let committed_high = failure_result_from_rep(pager.log_key(id, order.min(upper, head.next)))?
    // Staged appends are read through the tail, so a Tiered cursor stages none.
    let tiered = failure_result_from_rep(txn.tx_tiered_rows(tx.inner, id, committed_low, committed_high, false))?
    let cursor: Option[pages.CollectionCursor] = if let Some(_) = tiered {
        None
    } else {
        failure_result_from_rep(catalog.collection_cursor(txn.tx_roots(tx.inner).collections, id, committed_low, committed_high, false))?
    }
    let tail = txn.LogRangeTail(id: id, seq: order.max(head.next, lower), end: upper)
    let codec = std.codec.key_u64()
    let low = lower_bytes(id, typed_bound(codec, lo)?, false)?
    let high = lower_bytes(id, typed_bound(codec, hi)?, true)?
    Ok(TxRows(cursor: take cursor, decoder: log_decoder(l), owner: tx.info.id, depth: txn.tx_own(tx.inner), reads: txn.tx_reads(tx.inner), low: take low, high: take high, reverse: false, log_tail: Some(tail), tiered: take tiered))
}

pub fn trim_before[V](mut tx: Tx, l: Log[V], seq: u64) -> Result[(), Error] {
    failure_result_from_rep(txn.check_write_attempt(tx.inner))?
    readable_value(tx.info.id.store, txn.tx_roots(tx.inner), l.binding)?
    failure_result_from_rep(txn.trim_log_floor(mut tx.inner, l.binding.id, seq))
}

pub fn published_log[V](l: Log[V], change: Change) -> Result[Option[Bytes], Error] {
    if list.len(change.tree_key) != 12 || list.slice(change.tree_key, 0, 4) != failure_result_from_rep(catalog.prefix(l.binding.id))? {
        return Error(Missing("log"))
    }
    publish_row(l.binding.id, l.binding.readers, change)
}

pub fn tail_window[V](r: Reader, s: Snapshot, l: Log[V], t: u64) -> Result[LogBounds, Error] waits {
    if t == 0 {
        return Error(Missing("n"))
    }
    let ends = log_bounds(r, s, l)?
    Ok(LogBounds(first: ends.next - order.min(t, ends.next - ends.first), next: ends.next))
}

fn window_insertions(r: Reader, mut out: ChangeOutput, after: Snapshot, id: u32, lo: u64, hi: u64) -> Result[(), Error] waits {
    if lo >= hi {
        return Ok(())
    }
    let low = failure_result_from_rep(pager.log_key(id, lo))?
    let high = failure_result_from_rep(pager.log_key(id, hi))?
    let tree = view after.roots.collections
    if let Some(inventory) = view tree.paging {
        let descriptor = option.unwrap(std.page.lookup(tree.root, list.slice(low, 0, 4)))
        if pages.collection_descriptor(descriptor).residency == ResidentTiered {
            let rows = snapshot_tiered_span(r, after, inventory, low, high)?
            failure_result_from_rep(types.capacity(list.try_reserve(mut out.rows, list.len(rows))))?
            for take row in take rows {
                list.push(mut out.rows, take row)
            }
            return Ok(())
        }
    }
    let mut rows = byte_cursor(tree, Included(take low), high)?
    while let Some((take key, take value)) = failure_result_from_rep(catalog.next_bytes(mut rows))? {
        list.push(mut out.rows, Change(tree_key: take key, value: Some(take value)))
    }
    Ok(())
}

pub fn window_changes[V](r: Reader, a: Snapshot, b: Snapshot, l: Log[V], t: u64) -> Result[List[Change], Error] waits {
    let old = tail_window(r, a, l, t)?
    let new = tail_window(r, b, l, t)?
    let id = l.binding.id
    let mut out = change_output(None)
    let overlap_first = order.max(old.first, new.first)
    let overlap_next = order.min(old.next, new.next)
    window_deletions(mut out, id, old.first, order.min(old.next, new.first))?
    window_insertions(r, mut out, b, id, new.first, order.min(new.next, old.first))?
    // Across branches the overlap is read by §1.5's two-sided resolver, each
    // side by its own descriptor, so a differing Cold root is paged (§14.9).
    if a.branch != b.branch && overlap_first < overlap_next && !shared_cold_window(mut out, a.roots.collections, b.roots.collections, id, overlap_first, overlap_next)? {
        let lo = failure_result_from_rep(pager.log_key(id, overlap_first))?
        let hi = failure_result_from_rep(pager.log_key(id, overlap_next))?
        let read.ChangeOutput(rows: take rows, ..) = tiered_changes(r, a, b, Some(take lo), Some(take hi), None)?
        failure_result_from_rep(types.capacity(list.try_reserve(mut out.rows, list.len(rows))))?
        for take row in take rows {
            list.push(mut out.rows, take row)
        }
    }
    window_deletions(mut out, id, order.max(old.first, new.next), old.next)?
    window_insertions(r, mut out, b, id, order.max(new.first, old.next), new.next)?
    let read.ChangeOutput(rows: take items, ..) = take out
    Ok(take items)
}

fn log_endpoint(limit: Bound[u64], high: bool) -> u64 {
    let endpoint: std.omap.Bound[u64] = match limit {
        Unbounded => Unbounded,
        Included(n) => Included(n),
        Excluded(n) => Excluded(n),
    }
    txn.log_endpoint(endpoint, high)
}

pub fn append[V](mut tx: Tx, l: Log[V], v: V) -> Result[u64, Error] {
    failure_result_from_rep(txn.check_write_attempt(tx.inner))?
    readable_value(tx.info.id.store, txn.tx_roots(tx.inner), l.binding)?
    let id = l.binding.id
    failure_result_from_rep(txn.append_log(mut tx.inner, id, l.binding.readers.current, l.binding.readers.codec, v))
}

fn committed_log_bounds(tree: pages.PageTree, id: u32) -> Result[LogBounds, Error] {
    let limits = failure_result_from_rep(txn.committed_log_bounds(tree, id))?
    Ok(LogBounds(first: limits.first, next: limits.next))
}

fn transaction_log_bounds(tx: Tx, id: u32) -> Result[LogBounds, Error] {
    let limits = failure_result_from_rep(txn.transaction_log_bounds(tx.inner, id))?
    Ok(LogBounds(first: limits.first, next: limits.next))
}

fn window_deletions(mut out: ChangeOutput, id: u32, lo: u64, hi: u64) -> Result[(), Error] {
    failure_result_from_rep(txn.window_deletions(mut out, id, lo, hi, log_window_change))
}

fn shared_cold_window(mut out: ChangeOutput, before: pages.PageTree, after: pages.PageTree, id: u32, lo: u64, hi: u64) -> Result[bool, Error] {
    failure_result_from_rep(txn.shared_cold_window(mut out, before, after, id, lo, hi, log_window_change))
}

fn log_window_change(take key: Bytes, take value: Option[Arc[Bytes]]) -> Change {
    Change(tree_key: take key, value: take value)
}

fn log_decoder[V](l: Log[V]) -> RowDecoder[u64, V] {
    txn.log_decoder(l.binding.id, l.binding.readers)
}

fn decode_log_row[V](l: Log[V], raw: Option[View[Bytes]]) -> Result[Option[V], Error] {
    failure_result_from_rep(txn.decode_log_row(l.binding.id, l.binding.readers, raw, read_row_value))
}

fn decode_log_last[V](l: Log[V], seq: u64, raw: Option[View[Bytes]]) -> Result[Option[(u64, V)], Error] {
    failure_result_from_rep(txn.decode_log_last(l.binding.id, l.binding.readers, seq, raw, read_row_value))
}

// expect: gap compact value row at a generic instance is not built (core-check-895 queue item15)
// SEM-7 / FORM #63: compare located bytes and packed fields, never locator addresses.
fn code[T:ordered](a:T,b:T)->u64 {
 let l=if a<b {1u64} else {0}
 let le=if a<=b {2u64} else {0}
 let g=if a>b {4u64} else {0}
 let ge=if a>=b {8u64} else {0}
 l+le+g+ge
}
@compact(u16) stable type Doc:ordered { text:Text }
fn compact_code(a:Doc,b:Doc)->u64 { code(a,b) }

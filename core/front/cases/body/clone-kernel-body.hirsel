// A core-declared clone owns the live-set walk, including a containing List.
// expect: accept
// Private Slots and hooks for clone_in/twin remain guarded in derivation tests.
fn direct(d: Deque[u64]) -> Result[Deque[u64], Capacity] { clone(d) }
fn containing(ds: List[Deque[u64]]) -> Result[List[Deque[u64]], Capacity] { clone(ds) }
fn counted(d: Rc[Deque[u64]]) -> Result[Rc[Deque[u64]], Capacity] { clone(d) }

// expect: run clone_wrapped_partial() = 123123
fn clone_wrapped_partial() -> u64 {
    let mut d: Deque[u64] = deque.new()
    for i in 0u64 .. 4 { result.unwrap(deque.push_back(mut d, i)) }
    let _ = deque.pop_front(mut d)
    let mut cloned: Deque[u64] = result.unwrap(clone(d))
    let mut a: u64 = 0
    let mut b: u64 = 0
    while deque.len(cloned) > 0 { a = a * 10 + option.unwrap(deque.pop_front(mut cloned)) }
    while deque.len(d) > 0 { b = b * 10 + option.unwrap(deque.pop_front(mut d)) }
    a * 1000 + b
}


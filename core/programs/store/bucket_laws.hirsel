fn bucket_m2_law_retained() -> Result[(), Error] {
    let ten = pages.HistoryRef(seq: 10, epoch: 1, len: 189, digest: 10)
    let twenty = pages.HistoryRef(seq: 20, epoch: 1, len: 189, digest: 20)
    let twenty_four = pages.HistoryRef(seq: 24, epoch: 2, len: 189, digest: 24)
    let mut earlier: List[pages.HistoryRef] = list.with_capacity(1)
    list.push(mut earlier, ten)
    let before = history.HistoryMark(activation: history.HistoryActivation(number: 0, binding: [0; 32]), manifest: twenty, floor: 10, retained: take earlier, depth: 0, locate_at: 0, locate_end: 0)
    let cut = failure_result_from_rep(object_writer.history_retain(before, twenty, 24, 1))?
    if cut.floor != 24 || list.len(cut.earlier) != 0 {
        fail("retain 1 kept an older checkpoint")
    }
    let short = history.HistoryMark(activation: history.HistoryActivation(number: 0, binding: [0; 32]), manifest: twenty_four, floor: 24, retained: list.new(), depth: 0, locate_at: 0, locate_end: 0)
    let widened = failure_result_from_rep(object_writer.history_retain(short, twenty_four, 28, 3))?
    if widened.floor != 24 || list.len(widened.earlier) != 1 || widened.earlier[0].seq != 24 {
        fail("raising retain revived a checkpoint")
    }
    Ok(())
}

// L58 rule 2, with c0=20: the retiring holder has no authority to erase an
// orphan at 15 even though it has names for every entry from 21 up to P=24.
@test
fn bucket_test_m2_reclaim_candidates() -> Result[(), Error] {
    bucket_m2_law_retained()?
    let mut chain: List[history.HistoryLink] = list.with_capacity(4)
    list.push(mut chain, history.HistoryLink(epoch: 1, len: 42, digest: 21))
    list.push(mut chain, history.HistoryLink(epoch: 2, len: 42, digest: 22))
    list.push(mut chain, history.HistoryLink(epoch: 2, len: 42, digest: 23))
    list.push(mut chain, history.HistoryLink(epoch: 2, len: 42, digest: 24))
    let mut live_bytes: Map[String, ()] = map.new()
    map.insert(mut live_bytes, string.from("p-00000000000000000002-00000000000000000001-0000000000000002"), ())
    let mut leased: Map[String, ()] = map.new()
    map.insert(mut leased, string.from("e-00000000000000000009-00000000000000000001-0000000000000009"), ())
    let pass = object_writer.ReclaimPass(epoch: 2, recovered_checkpoint: 20, position: 24, checkpoint: 24, floor: 10, generation: 4, next_pack: 100, chain: take chain, live: take live_bytes, leased: take leased)
    if object_writer.history_dead_key(pass, "e-00000000000000000015-00000000000000000001-000000000000ffff") || object_writer.history_dead_key(pass, "e-00000000000000000021-00000000000000000001-0000000000000015") || object_writer.history_dead_key(pass, "e-00000000000000000025-00000000000000000002-000000000000ffff") || object_writer.history_dead_key(pass, "e-00000000000000000009-00000000000000000001-0000000000000009") || object_writer.history_dead_key(pass, "p-00000000000000000002-00000000000000000001-0000000000000002") || object_writer.history_dead_key(pass, "p-00000000000000000003-00000000000000000003-0000000000000003") || object_writer.history_dead_key(pass, "p-00000000000000000100-00000000000000000002-0000000000000003") || object_writer.history_dead_upload(pass, "p-00000000000000000099-00000000000000000002-0000000000000003") {
        fail("the pass selected a live, leased or later name")
    }
    if !object_writer.history_dead_key(pass, "e-00000000000000000008-00000000000000000001-0000000000000008") || !object_writer.history_dead_key(pass, "e-00000000000000000021-00000000000000000001-000000000000ffff") || !object_writer.history_dead_key(pass, "p-00000000000000000099-00000000000000000002-0000000000000003") || !object_writer.history_dead_upload(pass, "p-00000000000000000099-00000000000000000001-0000000000000003") {
        fail("the pass retained a name known to be dead")
    }
    Ok(())
}

fn bucket_m2_pack_value() -> Bytes {
    let mut out: Bytes = list.with_capacity(2048)
    list.fill(mut out, 2048, 70u8)
    take out
}

fn bucket_m2_seed_checkpoint(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, result.unwrap(sized(Directory, 2147483648u64)))?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let data = bucket_m2_pack_value()
    let outcome = run(mut db, None, (copy_env(rows), copy_env(data)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.0, 7, call_env.1)
    })?
    if let Committed(_) = outcome {} else {
        fail("the checkpoint fixture refused its row")
    }
    let _ = checkpoint(mut db)?
    close(take db)
}

fn bucket_m2_object_header(mut raw: Bytes, id: StoreId, role: u8, seq: u64) -> Result[(), Error] {
    let mut header: Bytes = list.with_capacity(72 + format.BINDING_BYTES)
    failure_result_from_rep(types.capacity(format.history_append_header(mut header, format.DiskContext(store: store_key_to_rep(id), role, seq), 1, 1)))?
    for at in 0u64 .. 72 {
        raw[at] = header[at]
    }
    Ok(())
}

fn bucket_m2_pack_entry(mut raw: Bytes, id: StoreId, manifest: pages.HistoryRef, refs: List[pages.HistoryRef]) -> Result[pages.HistoryRef, Error] {
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 2, seq: 1)
    let empty = pages.HistoryRef(seq: 0, epoch: 0, len: 0, digest: 0)
    failure_result_from_rep(history.history_packet_header(mut raw, ctx, 1, 1, empty))?
    list.fill(mut raw, 16, 0u8)
    list.put_word_le(mut raw, manifest.seq)
    list.put_word_le(mut raw, manifest.epoch)
    list.put_word_le(mut raw, manifest.digest)
    list.put_word_le(mut raw, manifest.len)
    list.put_word_le(mut raw, 1u64)
    list.push(mut raw, 0u8)
    list.put_word_le(mut raw, 0u32)
    list.fill(mut raw, 40, 0u8)
    failure_result_from_rep(types.capacity(format.history_seal(mut raw, ctx, 112, 0x0090)))?
    let at = list.len(raw)
    list.fill(mut raw, 16, 0u8)
    for item in refs {
        history.history_ref_encode(mut raw, item)
    }
    failure_result_from_rep(types.capacity(format.history_seal(mut raw, ctx, at, 0x00C0)))?
    Ok(history.history_new_ref(1, 1, raw))
}

fn bucket_m2_upload_checkpoint(d: Dir, tasks: Tasks, sim: BucketSim) -> Result[(history.ObjectPackRead, history.HistoryHead), Error] waits {
    let (id, take selected) = read_page_manifest_file(d)?
    let validated = validate_page_manifest(d, id, take selected)?
    let manifest.ValidatedPageManifest(manifest: take initial, inventory: take inventory, ..) = take validated
    let mut page_record = take initial
    page_record.first_live = 1
    page_record.prev_first = 1
    let mut client = bucket_law_client_with(sim, tasks, "s3.test", 3, true)?
    let due = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    let mut refs: List[pages.HistoryRef] = list.with_capacity(map.len(inventory))
    let mut kinds = 0u8
    for (seq, pack) in inventory {
        kinds |= 1u8 << pack.class
        let file = failure_result_from_rep(manifest.paged_pack_path(seq))?
        let mut raw = failure_result_from_rep(manifest.disk_read_paged_file(d, file, 1048576))?
        bucket_m2_object_header(mut raw, id, 3, seq)?
        let item = history.history_new_ref(seq, 1, raw)
        let name = history.history_key("p-", item)
        let mut buffer: Bytes = list.with_capacity(item.len)
        failure_result_from_rep(history.history_create(mut client, name, mut raw, mut buffer, due))?
        list.push(mut refs, item)
    }
    if kinds != 7 {
        fail("the checkpoint fixture missed a pack class")
    }
    list.sort(mut refs, fn(a: pages.HistoryRef, b: pages.HistoryRef) -> Order {
        order.compare(a.seq, b.seq)
    })
    let mut raw_manifest = failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), page_record))?
    bucket_m2_object_header(mut raw_manifest, id, 1, page_record.generation)?
    let base = history.history_new_ref(page_record.generation, 1, raw_manifest)
    let mut compare: Bytes = list.with_capacity(65536)
    failure_result_from_rep(history.history_create(mut client, history.history_key("m-", base), mut raw_manifest, mut compare, due))?
    let mut raw_entry: Bytes = list.with_capacity(65536)
    let entry_ref = bucket_m2_pack_entry(mut raw_entry, id, base, refs)?
    failure_result_from_rep(history.history_create(mut client, history.history_key("e-", entry_ref), mut raw_entry, mut compare, due))?
    let head = history.HistoryHead(authority_kind: 1, store: store_key_to_rep(id), pair: history.HistoryPair(epoch: 1, holder: types.StoreKey(hi: 17, lo: 18)), activation: 0, entry: entry_ref, checkpoint: entry_ref, floor: 1, binding: [0; 32], origin: None)
    let source = history.history_reader(take client, due)
    Ok((take source, head))
}

fn bucket_m2_read_packs(d: Dir, tasks: Tasks, sim: BucketSim) -> Result[(), Error] waits {
    let (take loaded, head) = bucket_m2_upload_checkpoint(d, tasks, sim)?
    let mut source = take loaded
    let id = head.store
    let replay = history_paged_capture(mut source, head, 1048576)?
    let root = view replay.state.tips[0]
    let snap = Snapshot(store: store_key_from_rep(id), open: 0, branch: 0, head: root.head, roots: pages.share_roots(root.roots), watermark: 1, bases: pages.no_tail_bases())
    let rows = catalog_handle(store_key_from_rep(id), root.roots.catalog, string.from("rows"), std.codec.key_u64(), std.codec.of_bytes())?
    if version(snap) != 2 || get(law_reader(snap), snap, rows, 7)? != Some(bucket_m2_pack_value()) {
        fail("the object checkpoint did not reconstruct its row")
    }
    failure_result_from_rep(object_writer.teardown_validate_bucket_checkpoint(mut source.client, head, source.deadline))
}


// MEM-1: `region r { body }` binds `r: Region` for the body; Region is scoped and
// anchored to itself, so it is passed as a parameter but never returned (memory.md's
// examples: `width` is accepted; `leak`'s MEM-7 refusal is fenced by
// patterns/region-value-escape). `measure` passes r as a parameter. Hand-derived: "abc"
// copied into r has length 3, and measure("ab") gives 2.
// expect: run three() = 3
// expect: run measure() = 2
fn width(s: String) -> Result[u64, Capacity] {
  region r { let t = text.copy_in(r, s)?; Ok(text.len(t)) }
}
fn three() -> u64 { match width("abc") { Ok(n) => n, Error(_) => 0 } }
fn copy_len(r: Region, s: String) -> Result[u64, Capacity] {
  let t = text.copy_in(r, s)?
  Ok(text.len(t))
}
fn measure() -> u64 { region r { match copy_len(r, "ab") { Ok(n) => n, Error(_) => 0 } } }

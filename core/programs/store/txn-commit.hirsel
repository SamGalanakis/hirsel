pub fn keyed_credit_equal(a: format.KeyedCredit, b: format.KeyedCredit) -> bool {
    a.resident == b.resident && a.padding == b.padding && a.journal == b.journal
}

pub fn journal_refusal(uncovered: u64, frame: u64, limit: u64) -> Option[Capacity] {
    if uncovered > limit || frame > limit - uncovered {
        Some(Capacity(requested: int.saturating_add(uncovered, frame), available: limit))
    } else {
        None
    }
}

pub fn settled_tiered_bytes(total: u64, retained: bool, base: pages.PageTree, proposed: pages.PageTree, operations: pages.DataRows) -> Result[u64, types.Failure] {
    let order = types.capacity(pages.data_order(operations))?
    let mut prior_collection: Option[u32] = None
    let mut charged = total
    for slot in 0u64 .. pages.data_row_count(operations) {
        let op = pager.ordered_row(operations, order, slot)
        let id = list.slice(op.key, 0, 4)
        let Some(before) = std.page.lookup(base.root, id) else {
            continue
        }
        let fields = pages.collection_descriptor(before)
        if fields.residency != ResidentTiered {
            continue
        }
        if retained {
            if let Some(raw) = view op.value {
                charged = pager.replay_charge("MANIFEST", charged, 0, entry(op.key, format.staged_bytes(raw)))?
            }
        } else {
            let collection: u32 = list.word_be(id, 0)
            if prior_collection != Some(collection) {
                prior_collection = Some(collection)
                let after = option.unwrap(std.page.lookup(proposed.root, id))
                charged = pager.replay_charge("MANIFEST", charged, fields.row_bytes, pages.collection_descriptor(after).row_bytes)?
            }
        }
    }
    Ok(charged)
}

// With `memory_only`, rows of Tiered collections are left to the Tiered
// write plan, which stages them through the attempt's resolver.
pub fn materialize_rows(mut tree: pages.PageTree, operations: pages.DataRows, memory_only: bool, first: u64, mut draw: u64) -> Result[(), types.Failure] {
    let order = types.capacity(pages.data_order(operations))?
    materialize_ordered_rows(mut tree, operations, order, memory_only, first, mut draw)
}

pub fn materialize_ordered_rows(mut tree: pages.PageTree, operations: pages.DataRows, order: format.DataOrder, memory_only: bool, first: u64, mut draw: u64) -> Result[(), types.Failure] {
    let collection_map = pages.tree_domain(tree) == CollectionMap
    let mut processed = 0u64
    for slot_order in 0u64 .. pages.data_row_count(operations) {
        if slot_order < processed {
            continue
        }
        let op = pager.ordered_row(operations, order, slot_order)
        if collection_map {
            let collection = list.slice(op.key, 0, 4)
            if let Some(descriptor) = pages.collection_by_key(tree, collection) {
                if descriptor.kind == TableCollection || descriptor.kind == IndexCollection {
                    processed = slot_order + 1
                    while processed < pages.data_row_count(operations) {
                        let following = pager.ordered_row(operations, order, processed)
                        if list.slice(following.key, 0, 4) != collection {
                            break
                        }
                        processed += 1
                    }
                    if memory_only && descriptor.residency == ResidentTiered {
                        continue
                    }
                    if processed > slot_order + 1 {
                        materialize_collection_batch(mut tree, operations, order, slot_order, processed, first, mut draw)?
                        continue
                    }
                }
            }
        }
        materialize_row(mut tree, op, memory_only, first, mut draw)?
    }
    Ok(())
}

fn materialize_row(mut tree: pages.PageTree, op: format.DataOp, memory_only: bool, first: u64, mut draw: u64) -> Result[(), types.Failure] {
    if let Some(_) = op.trim {
        return Ok(())
    }
    if memory_only && pager.tiered_data_key(tree, op.key) {
        return Ok(())
    }
    if pages.tree_domain(tree) == CollectionMap {
        let kind = pages.collection_kind(tree, list.slice(op.key, 0, 4))
        if kind == Some(CellCollection) {
            return match op.value {
                Some(PendingChunk(_)) => fail("store: chunk in Cell"),
                Some(SealedChunk(_)) => fail("store: chunk in Cell"),
                Some(PageValue(raw)) => apply_cell(mut tree, op.key, Some(view raw), None, first, mut draw),
                Some(BlobBody(raw)) => apply_cell(mut tree, op.key, Some(view raw), Some(view raw), first, mut draw),
                None => apply_cell(mut tree, op.key, None, None, first, mut draw),
            }
        }
        if kind == Some(LogCollection) {
            return match op.value {
                Some(PendingChunk(_)) => fail("store: chunk in Log"),
                Some(SealedChunk(_)) => fail("store: chunk in Log"),
                Some(PageValue(raw)) => journal.apply_log_append(mut tree, op.key, raw, None, first, mut draw),
                Some(BlobBody(raw)) => journal.apply_log_append(mut tree, op.key, raw, Some(view raw), first, mut draw),
                None => fail("store: Log append has no value"),
            }
        }
    }
    match op.value {
        Some(PendingChunk(raw)) => pages.put_shared_page_row(mut tree, op.key, raw, first, mut draw),
        Some(SealedChunk(chunk)) => pages.put_direct_page_row(mut tree, op.key, chunk.place, Some(arc.share(chunk.stored)), first, mut draw),
        Some(PageValue(raw)) => pages.put_page_row(mut tree, op.key, raw, first, mut draw),
        Some(BlobBody(raw)) => pages.put_shared_page_row(mut tree, op.key, raw, first, mut draw),
        None => {
            let _ = pages.remove_page_row(mut tree, op.key, first, mut draw)?
            Ok(())
        },
    }
}

fn materialize_collection_batch(mut tree: pages.PageTree, operations: pages.DataRows, order: format.DataOrder, start: u64, end: u64, first: u64, mut draw: u64) -> Result[(), types.Failure] {
    let collection = list.slice(pager.ordered_row(operations, order, start).key, 0, 4)
    let edit_at = scoped fn(_unused: (), slot: u64, visit: scoped fn(std.page.SourceEdit) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
        visit_materialized_edit(operations, order, slot, visit)
    }
    pages.page_result(pages.apply_collection_batch(mut tree, collection, (), edit_at, start, end, first, mut draw))
}

fn visit_materialized_edit(operations: pages.DataRows, order: format.DataOrder, slot: u64, visit: scoped fn(std.page.SourceEdit) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
    let op = pager.ordered_row(operations, order, slot)
    let value: Option[(View[Bytes], Option[View[Arc[Bytes]]])] = match view op.value {
        Some(PendingChunk(raw)) => Some((view raw, Some(raw))),
        Some(SealedChunk(chunk)) => Some((view chunk.stored, Some(view chunk.stored))),
        Some(PageValue(raw)) => Some((raw, None)),
        Some(BlobBody(raw)) => Some((view raw, Some(raw))),
        None => None,
    }
    visit(std.page.SourceEdit(key: list.slice(op.key, 4, list.len(op.key)), value: value, prior: None))
}

pub type CutDecision = NoCut | PreCut | Reseal

pub fn settlement_cut(accounting: AccountingState, tiered: Option[u64], has_frame: bool) -> CutDecision {
    if accounting.settled == accounting.changes || tiered != None {
        return NoCut
    }
    if has_frame {
        Reseal
    } else {
        PreCut
    }
}

// A successful body or an application error with a reply to commit.
pub type Prepared[R, A] {
    outcome: Result[R, A],
    roots: Option[pages.Roots],
    tiered: Option[u64],
    plan: Option[pager.TieredWritePlan],
    live: u64,
    frame: Option[format.DraftFrame],
    ops: pages.DataRows,
    order: format.DataOrder,
    base_stamp: u64,
    frame_tail: u64,
    stream_ops: pages.DataRows,
    keyed: Option[format.KeyedDraft],
    first_stamp: u64,
    inline_plan: Option[InlineDraft],
    observed_info: bool,
    skipped: bool,
    call: Option[format.CallSection]
}

pub type BodyDraft[R, A] = BodyPrepared(Prepared[R, A]) | OutOfRoom(types.CapacityRep) | BodyAborted(A) | DuplicateIndex(String) | BodyDrifted(String, List[(u32, u32)])

pub fn finish_body[Event: inert + shareable + send, R, A](take state: TxState[Event], take outcome: Result[R, A], keep_reply: Option[fn(A) -> bool], base: pages.Roots, resident: u64, tiered_bytes: u64, tiered: bool, observed: core.Cell[bool]) -> BodyDraft[R, A] {
    let mut tx = take state
    if tx.own != 0 {
        fold_own(mut tx)
    }
    if let Some(c) = tx.refusal {
        return OutOfRoom(Allocation(c))
    }
    // A proven-wrong index fails the call however the body ended (§I.3).
    if let Some((take name, take evidence)) = take_drift(mut tx) {
        return BodyDrifted(take name, take evidence)
    }
    let value: Result[R, A] = match take outcome {
        Ok(take v) => {
            if let Some(Duplicate(take name)) = replace(mut tx.index_conflict, None) {
                return DuplicateIndex(take name)
            }
            Ok(take v)
        },
        Error(take a) => {
            let keep = match keep_reply {
                Some(decide) => decide(a),
                None => true
            }
            let keyed_reply = match tx.keyed {
                Some(_) => true,
                None => false
            }
            if !keep || (pages.data_row_count(tx.stream_ops.rows) == 0 && !keyed_reply) {
                return BodyAborted(take a)
            }
            // F2 keeps the streams and CALL writes with the old data roots.
            let live_bytes = match stream_live(resident, tx.retain_old, base.streams, tx.stream_ops) {
                Ok(n) => n,
                Error(c) => return OutOfRoom(Allocation(c))
            }
            tx.resident = live_bytes
            tx.roots = None
            tx.ops = pages.empty_ops()
            tx.rows = 0
            tx.frame_tail = pages.NO_FRAME_TAIL
            Error(take a)
        }
    }
    let mut first_stamp = tx.private_from
    let mut rows = match seal_log_trims(mut tx, mut first_stamp) {
        Ok(take operations) => take operations,
        Error(Full(problem)) => return OutOfRoom(problem),
        Error(_) => fail("store: invalid staged Log trim"),
    }
    if let Some(keyed) = tx.keyed {
        tx.resident = keyed_draft_live(base, keyed.edits, tx.retain_old, tx.resident)
    }
    let TxState(roots: take roots, resident: live_bytes, frame_tail: frame_tail, ops: take ops, stream_ops: take stream_ops, keyed: take keyed, call: take call, ..) = take tx
    let saw_info = cell.replace(observed, false)
    let pages.DataOps(cells: take cells, ..) = take ops
    seal_cell_edits(mut rows, cells)
    let order = match pages.data_order(rows) {
        Ok(take sorted) => take sorted,
        Error(problem) => return OutOfRoom(Allocation(problem)),
    }
    let pages.DataOps(rows: take stream_rows, ..) = take stream_ops
    let tiered_total = if tiered {
        Some(tiered_bytes)
    } else {
        None
    }
    BodyPrepared(Prepared(outcome: take value, roots: take roots, tiered: tiered_total, plan: None, live: live_bytes, frame: None, ops: take rows, order: take order, base_stamp: pages.tree_stamp(base.collections), frame_tail: frame_tail, stream_ops: take stream_rows, keyed: take keyed, first_stamp: first_stamp, inline_plan: None, observed_info: saw_info, skipped: false, call: take call))
}

// A body whose commit the admission bound decides (section 1.11): one that
// returned Ok, or one that returned Error after a reply, whose commit keeps
// only its streams writes and its CALL section (F2).
pub type Ran[R, A, Info, Event] {
    value: Result[R, A],
    roots: Option[pages.Roots],
    edits: pages.DataRows,
    order: format.DataOrder,
    replies: pages.DataRows,
    keyed: Option[format.KeyedDraft],
    first_stamp: u64,
    inline_plan: Option[InlineDraft],
    tiered: Option[u64],
    freed: Option[pager.TieredFreed],
    live: u64,
    exact: bool,
    admits_rows: bool,
    skipped: bool,
    frame: Option[format.DraftFrame],
    info: Info,
    reads: List[Event]
}

// Latched: the attempt's latch was set, so its result, writes, reads and
// issued ids are discarded and the driver serves or refuses the stop.
pub type Stage[Draft, Outcome, Failure] = Over(Outcome) | Ran(Draft) | DraftError(Failure) | Latched | DriftStop(String, List[(u32, u32)])

// Drifted: a remove proved an index wrong; the call fails with `Drift`
// and its driver counts and demotes the indexes (§I.3).
pub type Finished[R, A, Outcome, Failure] = RolledBack(Outcome) | Prepared(Prepared[R, A]) | DraftFault(Failure) | Drifted(String, List[(u32, u32)])

pub fn finish_stage[R, A, Info, Event, Outcome, Failure](take ci: Info, take finished: Finished[R, A, Outcome, Failure], take seen: List[Event]) -> Stage[Ran[R, A, Info, Event], Outcome, Failure] {
    let prepared = match take finished {
        RolledBack(take o) => return Over(take o),
        DraftFault(take problem) => return DraftError(take problem),
        Drifted(take name, take evidence) => return DriftStop(take name, take evidence),
        Prepared(take tx) => take tx,
    }
    let Prepared(outcome: take outcome, roots: take roots, tiered: tiered, plan: take plan, live: live_bytes, frame: take frame, ops: take operations, order: take order, stream_ops: take stream_edits, keyed: take keyed, first_stamp: first_stamp, inline_plan: take inline_plan, skipped: skipped, ..) = take prepared
    // A draft without a Tiered plan makes no call here: the draft's step
    // overhead is fixed (§13.3 call reserves).
    let freed = match take plan {
        Some(take written) => {
            let pager.TieredWritePlan(freed: take plan_freed, ..) = take written
            Some(take plan_freed)
        },
        None => None,
    }
    let keyed_writes = match keyed {
        Some(_) => true,
        None => false
    }
    let mut admits_rows = stream_edits.count_word != 0 || keyed_writes
    if !admits_rows {
        for slot in 0u64 .. pages.data_row_count(operations) {
            let edit = pages.data_row(operations, slot)
            if let Some(_) = edit.value {
                if let Some(held) = view roots {
                    if tiered != None && pager.tiered_data_key(held.collections, edit.key) {
                        continue
                    }
                }
                admits_rows = true;
                break
            }
        }
    }
    Ran(Ran(value: take outcome, roots: take roots, edits: take operations, order: take order, replies: take stream_edits, keyed: take keyed, first_stamp: first_stamp, inline_plan: take inline_plan, tiered: tiered, freed: take freed, live: live_bytes, exact: false, admits_rows: admits_rows, skipped: skipped, frame: take frame, info: take ci, reads: take seen))
}

// Charge page preparation to the existing call scope when the caller
// supplied a byte or step grant. Only application is outside that scope.
// Memory rows apply first; the Tiered plan then stages its collections over
// that tree, and its tree is the commit's collection map. Every stamp drawn
// here is raised into `issued`, so the watermark covers it.
pub fn prepare_metered_pages[R, A, Outcome, Failure](base: pages.Roots, issued: core.Cell[u64], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], take finished: Finished[R, A, Outcome, Failure]) -> Result[Finished[R, A, Outcome, Failure], types.Failure] {
    match take finished {
        RolledBack(take outcome) => Ok(RolledBack(take outcome)),
        DraftFault(take problem) => Ok(DraftFault(take problem)),
        Drifted(take name, take seen) => Ok(Drifted(take name, take seen)),
        Prepared(take staged) => {
            let mut prepared = take staged
            if pages.data_row_count(prepared.ops) == 0 && pages.data_row_count(prepared.stream_ops) == 0 {
                if let None = prepared.keyed {
                    return Ok(Prepared(take prepared))
                }
            }
            let first = prepared.first_stamp
            let mut draw = first
            let memory_only = match attempt {
                Some(_) => true,
                None => false,
            }
            if !memory_only && !pages.draft_has_chunks(prepared.ops) {
                prepared.inline_plan = plan_inline_draft(prepared, base, mut draw)?
            }
            if let None = prepared.inline_plan {
                let mut roots = match replace(mut prepared.roots, None) {
                    Some(take private_roots) => take private_roots,
                    None => pages.share_roots(base),
                }
                materialize_ordered_rows(mut roots.collections, prepared.ops, prepared.order, memory_only, first, mut draw)?
                materialize_rows(mut roots.streams, prepared.stream_ops, false, first, mut draw)?
                if let Some(record) = attempt {
                    if let Some(take tiered_plan) = pager.plan_tiered_edits(roots.collections, record, pins, prepared.ops, prepared.order, draw)? {
                        roots.collections = pages.share_page_tree(tiered_plan.tree)
                        draw = tiered_plan.next_stamp
                        prepared.plan = Some(take tiered_plan)
                    }
                }
                if let Some(keyed) = prepared.keyed {
                    pages.materialize_keyed_edits(mut roots, keyed.edits, first, mut draw)?
                }
                pages.canonical_roots(mut roots)?
                prepared.roots = Some(take roots)
            }
            let drawn = draw - 1
            let high = cell.replace(issued, drawn)
            if high > drawn {
                let _ = cell.replace(issued, high)
            }
            Ok(Prepared(take prepared))
        },
    }
}

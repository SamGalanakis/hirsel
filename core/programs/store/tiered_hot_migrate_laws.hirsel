// M3b-S5 (§13.10a "Lifts"): a hot Migrate on a Tiered log@1 store lifts
// everything except a Tiered build, which refuses `Tiered(Migrate)` until
// lane 3224 gives it a mechanism. Fixture: log@1, table `rows` u64 -> u64
// seeded with `k % 97`, then `set_residency(Tiered)`.
fn hot_options(dirty: u64) -> Result[Options, Error] {
    let mut overrides = derived_sizes()
    overrides.resident_limit = Some(268435456u64)
    overrides.writer_pin_bytes = Some(34471936u64)
    overrides.cache_bytes = Some(80u64 * 1048576u64)
    if dirty != 0 {
        overrides.dirty_bytes = Some(dirty)
    }
    Ok(sized_with(Directory, 2147483648u64, overrides) ?=> |_| Missing("hot migrate sizing"))
}

fn hot_seed(mut db: Db, n: u64) -> Result[Table[u64, u64], Error] waits {
    let mut decl = declare(db, Migrate)?
    let rows_decl = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = finish(mut decl, take rows_decl)?
    let other_decl = declare_table(mut decl, "other", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut decl, take other_decl)?
    let _ = seal(mut db, take decl)?
    let fixture: Table[u64, u64] = clone(rows)
    let Committed(_) = run(mut db, None, copy_env((fixture, n)), fn(mut tx: Tx, env: (Table[u64, u64], u64)) -> Result[(), Error] {
        for k in 0u64 .. env.1 {
            put(mut tx, env.0, k, k % 97)?
        }
        Ok(())
    })? else {
        fail("hot migrate: seed did not commit")
    }
    set_residency(mut db, rows.id, Tiered)?
    let _ = checkpoint(mut db)?
    Ok(rows)
}

// The rows of `name`, each checked against the seed's `k % 97`.
fn hot_rows(mut db: Db, name: String, n: u64) -> Result[(), Error] waits {
    let t = table(mut db, name, std.codec.key_u64(), std.codec.of_u64())?
    let Committed(Done(value: ok, ..)) = run(mut db, Some(100000000u64), copy_env((t, n)), fn(mut tx: Tx, env: (Table[u64, u64], u64)) -> Result[bool, Error] {
        for k in 0u64 .. env.1 {
            if fetch(tx, env.0, k)? != Some(k % 97) {
                return Ok(false)
            }
        }
        Ok(count(tx, env.0, Unbounded, Unbounded)? == env.1)
    })? else {
        fail("hot migrate: read did not commit")
    }
    if !ok {
        fail("hot migrate: the seeded rows changed")
    }
    Ok(())
}

fn hot_migrate(mut phase: Migration) -> Result[(), Error] {
    migrate_table(mut phase, "rows", std.codec.key_u64(), std.codec.of_u64(), "moved", std.codec.key_u64(), std.codec.of_u64(), fn(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
        Ok(Some((k, v)))
    })
}

// No owner-3 pin is listed (L102: after a publish, and after a holder-free
// cut that follows a refused or crashed build).
fn l102_owner3_pin(db: Db) -> bool {
    std.list.any(pages.holder_pins(db.holders), fn(held: pages.Pin) -> bool {
        held.owner == ImportPin
    })
}

// F2: the published `next_stamp` is above every stamp `id`'s tree reaches,
// and each reachable stamp sits at one location (`compact_walk` checks it).
fn l102_stamps(d: Dir, db: Db, id: u32) -> Result[(), Error] waits {
    let walk = compact_walk(d, db, id)?
    let watermark = pages.holder_next_node(db.holders)
    for (stamp, _) in walk.places {
        if stamp > watermark {
            fail("L102 F2: a reachable stamp is above the published next_stamp")
        }
    }
    Ok(())
}

// L102 (a) after the publish: `moved` holds exactly the model rows, `rows`
// is gone, no owner-3 pin is listed, and the stamps are published (F2).
fn l102_moved(d: Dir, mut db: Db, n: u64) -> Result[(), Error] waits {
    hot_rows(mut db, string.from("moved"), n)?
    if let Ok(_) = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()) {
        fail("L102 (a): the migrate source is still listed")
    }
    if l102_owner3_pin(db) {
        fail("L102 (a): an owner-3 pin is listed after the publish")
    }
    let moved = table(mut db, "moved", std.codec.key_u64(), std.codec.of_u64())?
    l102_stamps(d, db, moved.id)
}

// L102 (a): `run_migration` with an identity `migrate_table(rows -> moved)`
// on a Tiered table. Past `dirty_bytes` the build cuts at least once and ends
// with a partial chunk (F1), over a tail replayed at reopen; under it no build
// cut runs and no pin is held. Model: keys 0..n with `k % 97`. Red on main:
// `Tiered(Migrate)`, and before 3220b the target published empty.
@test
fn test_l102_hot_migrate_identity(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let big = disk_test_directory(d)
    let mut db = open(tasks, big, c, r, hot_options(65536)?)?
    let rows = hot_seed(mut db, 6000)?
    let Committed(_) = run(mut db, Some(100000000u64), copy_env(rows), fn(mut tx: Tx, t: Table[u64, u64]) -> Result[(), Error] {
        for k in 6000u64 .. 6050u64 {
            put(mut tx, t, k, k % 97)?
        }
        Ok(())
    })? else {
        fail("L102 (a): the tail did not commit")
    }
    close(take db)?
    let mut replayed = open(tasks, big, c, r, hot_options(65536)?)?
    run_migration(mut replayed, tasks, code.describe(hot_migrate))?
    l102_moved(big, mut replayed, 6050)?
    let _ = checkpoint(mut replayed)?
    close(take replayed)?
    let mut again = open(tasks, big, c, r, hot_options(65536)?)?
    l102_moved(big, mut again, 6050)?
    close(take again)?
    let small = disk_test_directory(d)
    let mut under = open(tasks, small, c, r, hot_options(0)?)?
    let _ = hot_seed(mut under, 500)?
    run_migration(mut under, tasks, code.describe(hot_migrate))?
    l102_moved(small, mut under, 500)?
    close(take under)?
    let mut reopened = open(tasks, small, c, r, hot_options(0)?)?
    l102_moved(small, mut reopened, 500)?
    close(take reopened)
}

fn hot_reverse(mut phase: Migration) -> Result[(), Error] {
    migrate_table(mut phase, "rows", std.codec.key_u64(), std.codec.of_u64(), "moved", std.codec.key_u64(), std.codec.of_u64(), fn(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
        Ok(Some((1000000u64 - k, v)))
    })?
    migrate_table(mut phase, "other", std.codec.key_u64(), std.codec.of_u64(), "moved2", std.codec.key_u64(), std.codec.of_u64(), fn(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
        Ok(Some((k, v)))
    })
}

// Seeds `other` with keys 0..n and `k % 97`, then makes it Tiered.
fn hot_seed_other(mut db: Db, n: u64) -> Result[(), Error] waits {
    let other = table(mut db, "other", std.codec.key_u64(), std.codec.of_u64())?
    let other_id = other.id
    let Committed(_) = run(mut db, Some(100000000u64), copy_env((other, n)), fn(mut tx: Tx, env: (Table[u64, u64], u64)) -> Result[(), Error] {
        for k in 0u64 .. env.1 {
            put(mut tx, env.0, k, k % 97)?
        }
        Ok(())
    })? else {
        fail("L102 merge: the second seed did not commit")
    }
    set_residency(mut db, other_id, Tiered)?
    let _ = checkpoint(mut db)?
    Ok(())
}

// The second target: model rows, stamps published (F2) and placed once.
fn l102_second(d: Dir, mut db: Db, n: u64) -> Result[(), Error] waits {
    hot_rows(mut db, string.from("moved2"), n)?
    let moved2 = table(mut db, "moved2", std.codec.key_u64(), std.codec.of_u64())?
    l102_stamps(d, db, moved2.id)
}

// `moved` holds exactly key 1,000,000 - k with value k % 97 for k in 0..n.
fn l102_reversed(d: Dir, mut db: Db, n: u64) -> Result[(), Error] waits {
    let t = table(mut db, "moved", std.codec.key_u64(), std.codec.of_u64())?
    let target_id = t.id
    let Committed(Done(value: ok, ..)) = run(mut db, Some(100000000u64), copy_env((t, n)), fn(mut tx: Tx, env: (Table[u64, u64], u64)) -> Result[bool, Error] {
        for k in 0u64 .. env.1 {
            if fetch(tx, env.0, 1000000u64 - k)? != Some(k % 97) {
                return Ok(false)
            }
        }
        Ok(count(tx, env.0, Unbounded, Unbounded)? == env.1)
    })? else {
        fail("L102 merge: read did not commit")
    }
    if !ok {
        fail("L102 merge: the reversed rows are not the model's")
    }
    if l102_owner3_pin(db) {
        fail("L102 merge: an owner-3 pin is listed after the publish")
    }
    l102_stamps(d, db, target_id)
}

fn hot_collide(mut phase: Migration) -> Result[(), Error] {
    migrate_table(mut phase, "rows", std.codec.key_u64(), std.codec.of_u64(), "moved", std.codec.key_u64(), std.codec.of_u64(), fn(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
        Ok(Some(((1000000u64 - k) % 3000u64, v)))
    })
}

// L102 (e) after build cuts: keys k and k + 3000 collide, never inside one
// run, so the duplicate is met in the merge, after scratch cuts set the build
// pin. The refusal is the Memory path's `Exists("moved")`, the source keeps
// its model rows, a holder-free cut leaves no owner-3 pin, and reopen agrees.
fn l102_merge_refused(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, hot_options(65536)?)?
    let _ = hot_seed(mut db, 6000)?
    match run_migration(mut db, tasks, code.describe(hot_collide)) {
        Error(Exists(name)) => {
            if name != "moved" {
                fail("L102 (e): the merge duplicate named another table")
            }
        },
        _ => fail("L102 (e): a duplicate met in the merge was not Exists"),
    }
    // Fixture guard: the build cut at least once before the refusal.
    if !l102_owner3_pin(db) {
        fail("L102 (e): the fixture refused before any build cut")
    }
    hot_rows(mut db, string.from("rows"), 6000)?
    let _ = checkpoint(mut db)?
    if l102_owner3_pin(db) {
        fail("L102 (e): an owner-3 pin outlived a holder-free cut after the refusal")
    }
    close(take db)?
    let mut again = open(tasks, d, c, r, hot_options(65536)?)?
    hot_rows(mut again, string.from("rows"), 6000)?
    if let Ok(_) = table(mut again, "moved", std.codec.key_u64(), std.codec.of_u64()) {
        fail("L102 (e): the refused target is listed after reopen")
    }
    close(take again)
}

// L102 (a), merge: a `migrate_table` that reverses key order. Each run past
// the first is below its predecessor, so the build turns to the merge (run 0
// in the second scratch id, later runs in the first), and the merged target
// must hold exactly the model rows with no scratch frame reachable. A second
// Tiered target in the same plan builds after it, cutting past `dirty_bytes`
// while the first's packed tree sits in the working map: each target's
// stamps must be published and placed once. Red before the merge:
// `MigrationFault` on the first out-of-order run.
@test
fn test_l102_hot_migrate_merge(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, hot_options(65536)?)?
    let _ = hot_seed(mut db, 6000)?
    hot_seed_other(mut db, 5000)?
    run_migration(mut db, tasks, code.describe(hot_reverse))?
    l102_reversed(d, mut db, 6000)?
    l102_second(d, mut db, 5000)?
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, d, c, r, hot_options(65536)?)?
    l102_reversed(d, mut again, 6000)?
    l102_second(d, mut again, 5000)?
    close(take again)?
    l102_merge_refused(disk_test_directory(d), c, r, tasks)
}

// L102 (d): a build cut whose probe relocates frames of an untouched second
// Tiered table. `other` (3000 Tiered rows) is half rewritten, so its packs
// hold dead frames. The store then reopens with `compact_permille` 1001, so
// every pack is under probe at every cut, and with a large `probe_budget`, so
// the hot build's cuts move `other`'s frames on main. The graft keeps main's
// current slot for an id the plan did not change (F3), so after the publish
// and after a reopen `other` reads all its model rows. The guard requires that
// some frame of `other` moved during the migrate.
@test
fn test_l102_hot_migrate_untouched(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut seeded = open(tasks, d, c, r, hot_options(65536)?)?
    let _ = hot_seed(mut seeded, 6000)?
    hot_seed_other(mut seeded, 3000)?
    let other = table(mut seeded, "other", std.codec.key_u64(), std.codec.of_u64())?
    let other_id = other.id
    let Committed(_) = run(mut seeded, Some(100000000u64), copy_env(other), fn(mut tx: Tx, t: Table[u64, u64]) -> Result[(), Error] {
        for k in 0u64 .. 1500u64 {
            put(mut tx, t, 2u64 * k, (2u64 * k) % 97)?
        }
        Ok(())
    })? else {
        fail("L102 (d): the rewrite did not commit")
    }
    let _ = checkpoint(mut seeded)?
    close(take seeded)?
    let mut options = hot_options(65536)?
    options.compact_permille = 1001
    options.probe_budget = 1073741824u64
    let mut db = open(tasks, d, c, r, options)?
    let before = compact_walk(d, db, other_id)?
    run_migration(mut db, tasks, code.describe(hot_migrate))?
    let after = compact_walk(d, db, other_id)?
    let mut relocated = false
    for (stamp, place) in before.places {
        match map.get(after.places, stamp) {
            Some(now) => {
                if now != place {
                    relocated = true
                }
            },
            None => {
                relocated = true
            },
        }
    }
    if !relocated {
        fail("L102 (d): no frame of the untouched table moved during the build")
    }
    l102_moved(d, mut db, 6000)?
    hot_rows(mut db, string.from("other"), 3000)?
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, d, c, r, options)?
    hot_rows(mut again, string.from("other"), 3000)?
    l102_moved(d, mut again, 6000)?
    close(take again)
}

// L102 (c): the "hot-migrate" W2 crash scenario (store_crash_tests.py). The
// write phase runs `hot_reverse` over 3000 Tiered rows at dirty 65536, so
// cuts land while runs stream, at the turn to the merge, in the merge, and at
// the publish.
// The crash binary runs under a 64 MiB process limit, so its cache is the
// smallest the Tiered floor admits: the writer's pins plus one reader
// (`VALUE_LIMIT` + 1 MiB).
fn l102_crash_options() -> Result[Options, Error] {
    let mut overrides = derived_sizes()
    overrides.resident_limit = Some(268435456u64)
    overrides.writer_pin_bytes = Some(34471936u64)
    overrides.cache_bytes = Some(34471936u64 + 17825792u64)
    overrides.dirty_bytes = Some(65536u64)
    Ok(sized_with(Directory, 2147483648u64, overrides) ?=> |_| Missing("hot crash sizing"))
}

fn l102_crash_init(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l102_crash_options()?)?
    let _ = hot_seed(mut db, 3000)?
    close(take db)
}

fn l102_crash_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l102_crash_options()?)?
    run_migration(mut db, tasks, code.describe(hot_reverse))?
    close(take db)
}

// The recovered state is exactly OLD (`rows` with its model rows, no
// `moved`) or exactly NEW (`moved` reversed, no `rows`); `required_new`
// demands NEW. One holder-free cut leaves no owner-3 pin, the surviving
// table's stamps are published (F2), and a further write and cut reopen to
// the same state with no pin.
fn l102_crash_state(d: Dir, mut db: Db, old: bool) -> Result[bool, Error] waits {
    if l102_owner3_pin(db) {
        return Ok(false)
    }
    if old {
        hot_rows(mut db, string.from("rows"), 3000)?
        if let Ok(_) = table(mut db, "moved", std.codec.key_u64(), std.codec.of_u64()) {
            return Ok(false)
        }
        let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
        l102_stamps(d, db, rows.id)?
        return Ok(true)
    }
    if let Ok(_) = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()) {
        return Ok(false)
    }
    l102_reversed(d, mut db, 3000)?
    Ok(true)
}

fn l102_crash_read(d: Dir, c: Clock, r: Random, tasks: Tasks, required_new: bool) -> Result[bool, Error] waits {
    let mut db = open(tasks, d, c, r, l102_crash_options()?)?
    trust_store(mut db)?
    let old = match table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()) {
        Ok(_) => true,
        Error(_) => false,
    }
    if old && required_new {
        return Ok(false)
    }
    let _ = checkpoint(mut db)?
    if !l102_crash_state(d, mut db, old)? {
        return Ok(false)
    }
    let (name, key) = if old {
        ("rows", 7u64)
    } else {
        ("moved", 1000000u64 - 7u64)
    }
    let t = table(mut db, name, std.codec.key_u64(), std.codec.of_u64())?
    let Committed(_) = run(mut db, Some(100000000u64), copy_env((t, key)), fn(mut tx: Tx, env: (Table[u64, u64], u64)) -> Result[(), Error] {
        put(mut tx, env.0, env.1, 7u64)
    })? else {
        return Ok(false)
    }
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, d, c, r, l102_crash_options()?)?
    let good = l102_crash_state(d, mut again, old)?
    close(take again)?
    Ok(good)
}

// L102 (b): the declaration that adds `by_v`, a `Many` index over `k % 97`.
// Its entries `(k % 97, k)` are not in primary order, so the build's runs
// overlap and it merges them.
// It also adds `by_band`, an aggregate of `k` grouped by `k / 1000`: groups
// arrive in primary order, so a group split across runs streams in order
// and its parts are combined where its runs meet.
fn l102_declare(mut db: Db, mode: Mode) -> Result[(Index[u64, u64, u64, ()], Aggregate[u64]), Error] waits {
    let mut decl = declare(db, mode)?
    let mut rows_decl = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let ix = index(mut decl, mut rows_decl, "by_v", Many, code.describe(crash_value), std.codec.key_u64())?
    let bands = aggregate(mut decl, mut rows_decl, "by_band", code.describe(l102_band), std.codec.key_u64())?
    let _ = finish(mut decl, take rows_decl)?
    let other_decl = declare_table(mut decl, "other", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut decl, take other_decl)?
    let _ = seal(mut db, take decl)?
    Ok((ix, bands))
}

fn l102_band(k: u64, _v: u64) -> Result[List[(u64, u64)], Capacity] {
    let mut parts: List[(u64, u64)] = list.new()
    list.push(mut parts, (k / 1000u64, k))
    Ok(take parts)
}

// L102 (b) oracle for `by_band`: each group's count and sum of `k`, summed
// here from the model keys 0..n.
fn l102_bands(db: Db, bands: Aggregate[u64], n: u64) -> Result[(), Error] waits {
    let Public = lix_state(db, "by_band")? else {
        fail("L102 (b): by_band is not Public")
    }
    let mut expected: List[Totals] = list.new()
    for k in 0u64 .. n {
        let g = k / 1000u64
        if g == list.len(expected) {
            list.push(mut expected, Totals(count: 0, sum: 0))
        }
        expected[g].count += 1
        expected[g].sum += k
    }
    let Seen(Seen(value: Ok(true), ..)) = look(reader(db, READER_PIN_MIN)?, snapshot(db), Some(100000000u64), (copy_env(bands), take expected), fn(tx: Tx, input: (Aggregate[u64], List[Totals])) -> Result[bool, Error] {
        for g in 0u64 .. list.len(input.1) + 1u64 {
            let seen = totals(tx, input.0, g)?
            let (members, total) = if g < list.len(input.1) {
                (input.1[g].count, input.1[g].sum)
            } else {
                (0u64, 0u64)
            }
            if seen.count != members || seen.sum != total {
                return Ok(false)
            }
        }
        Ok(true)
    })? else {
        fail("L102 (b): by_band differs from the model's totals")
    }
    Ok(())
}

// L102 (b) oracle: `by_v` is Public and holds exactly `(k % 97, k)` for the
// model keys 0..n, derived from the seed rather than read from the table.
fn l102_by_v(db: Db, ix: Index[u64, u64, u64, ()], n: u64) -> Result[(), Error] waits {
    let Public = lix_state(db, "by_v")? else {
        fail("L102 (b): by_v is not Public")
    }
    let mut model: List[(u64, u64)] = list.with_capacity(n)
    for k in 0u64 .. n {
        list.push(mut model, (k % 97, k))
    }
    let Seen(Seen(value: Ok(true), ..)) = look(reader(db, READER_PIN_MIN)?, snapshot(db), Some(100000000u64), (copy_env(ix), take model), fn(tx: Tx, input: (Index[u64, u64, u64, ()], List[(u64, u64)])) -> Result[bool, Error] {
        exact_index_entries(tx, input.0, clone(input.1))
    })? else {
        fail("L102 (b): by_v differs from the model's extraction")
    }
    Ok(())
}

// L102 (b): every pack the store lists is on disk, and every `p-*` file on
// disk is listed.
fn l102_packs(d: Dir, db: Db) -> Result[(), Error] waits {
    let mut names: List[String] = list.new()
    let mut inventory = std.omap.range(manifest.pack_locations(disk_state(db).packs).packs.values, Unbounded, Unbounded)
    while let Some((seq, _)) = std.omap.next(mut inventory) {
        list.push(mut names, failure_result_from_rep(manifest.paged_pack_path(seq))?)
    }
    let present = result.unwrap(std.dir.list(d, None))
    for name in names {
        let mut found = false
        for listed in present {
            if listed.name == name {
                found = true
            }
        }
        if !found {
            fail("L102 (b): a listed pack is not on disk")
        }
    }
    for listed in present {
        if string.starts_with(listed.name, "p-") && !list.contains(names, listed.name) {
            fail("L102 (b): a pack file on disk is not listed")
        }
    }
    Ok(())
}

// L102 (b): a Migrate declaration adds `by_v` on the Tiered table `rows`.
// Past `dirty_bytes` (6000 rows at 65536) the build cuts and merges; the
// index equals the model's extraction before and after reopen, with every
// pack file listed and the stamps published. F4: each entry is charged
// entry(20, 0) = 62 + 24 = 86 bytes, at least its page bytes, so B ≤
// 6000 × 86 = 516000 and one merge pass allows 2 × ⌈516000 ÷ 65536⌉ + 2 = 18
// build cuts. Then `rebuild_index` leaves `by_v` Backfilling over an empty
// Tiered tree and a second Migrate declaration rebuilds it at its own id
// past its first build cut (F3). Under `dirty_bytes` (500 rows) no build cut
// runs and no pin is held. Red on main: `Tiered(Migrate)` at `index`.
@test
fn test_l102_hot_index_build(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let big = disk_test_directory(d)
    let mut db = open(tasks, big, c, r, hot_options(65536)?)?
    let _ = hot_seed(mut db, 6000)?
    let before = db.checkpointed
    let (ix, ix_bands) = l102_declare(mut db, Migrate)?
    let cuts = db.checkpointed - before
    if cuts < 2 {
        fail("L102 (b): the fixture must run a build cut before its publish")
    }
    if cuts > 18 {
        fail("L102 (b): the build cut more than one merge pass allows (F4)")
    }
    l102_by_v(db, ix, 6000)?
    l102_bands(db, ix_bands, 6000)?
    if l102_owner3_pin(db) {
        fail("L102 (b): an owner-3 pin is listed after the publish")
    }
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, big, c, r, hot_options(65536)?)?
    let (reopened, reopened_bands) = l102_declare(mut again, Open)?
    l102_by_v(again, reopened, 6000)?
    l102_bands(again, reopened_bands, 6000)?
    l102_packs(big, again)?
    l102_stamps(big, again, reopened.id)?
    rebuild_index(mut again, reopened)?
    let Backfilling(None) = lix_state(again, "by_v")? else {
        fail("L102 (b): the fixture must leave by_v Backfilling")
    }
    let rebuilt_from = again.checkpointed
    let (rebuilt, rebuilt_bands) = l102_declare(mut again, Migrate)?
    if again.checkpointed - rebuilt_from < 2 {
        fail("L102 (b): the rebuild must run a build cut before its publish")
    }
    if rebuilt.id != reopened.id {
        fail("L102 (b): a Backfilling index is rebuilt at its own id")
    }
    l102_by_v(again, rebuilt, 6000)?
    l102_bands(again, rebuilt_bands, 6000)?
    let _ = checkpoint(mut again)?
    close(take again)?
    let mut third = open(tasks, big, c, r, hot_options(65536)?)?
    let (final_ix, final_ix_bands) = l102_declare(mut third, Open)?
    l102_by_v(third, final_ix, 6000)?
    l102_bands(third, final_ix_bands, 6000)?
    l102_packs(big, third)?
    l102_stamps(big, third, final_ix.id)?
    close(take third)?
    let small = disk_test_directory(d)
    let mut under = open(tasks, small, c, r, hot_options(0)?)?
    let _ = hot_seed(mut under, 500)?
    let (small_ix, small_ix_bands) = l102_declare(mut under, Migrate)?
    l102_by_v(under, small_ix, 500)?
    l102_bands(under, small_ix_bands, 500)?
    if l102_owner3_pin(under) {
        fail("L102 (b): an owner-3 pin is listed without a build cut")
    }
    close(take under)?
    let mut small_again = open(tasks, small, c, r, hot_options(0)?)?
    let (small_reopened, small_reopened_bands) = l102_declare(mut small_again, Open)?
    l102_by_v(small_again, small_reopened, 500)?
    l102_bands(small_again, small_reopened_bands, 500)?
    l102_packs(small, small_again)?
    close(take small_again)
}

// L102 (e): `by_u` maps each key to itself except the last, which repeats
// key 0, so the duplicate is met only in the build's final chunk.
fn l102_unique_key(k: u64, _v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    if k == 5999u64 {
        list.push(mut keys, 0u64)
    } else {
        list.push(mut keys, k)
    }
    Ok(take keys)
}

fn l102_lists(db: Db, name: String) -> Result[bool, Error] {
    let seen = attention(db)?
    Ok(std.list.any(seen.indexes, fn(report: IndexReport) -> bool {
        report.index == name
    }))
}

// L102 (e): a Migrate declaration adds the `Unique` index `by_u` on the
// Tiered table, whose duplicate key is met past the first build cut. Seal
// refuses `Conflict("by_u")` with main's head and catalog unchanged: `by_u`
// is not listed and `rows` holds the model. One holder-free cut drops the
// build pin, and a further write and cut reopen clean (F2). Red on main:
// `Tiered(Migrate)` at `index`.
@test
fn test_l102_hot_unique_conflict(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, hot_options(65536)?)?
    let rows = hot_seed(mut db, 6000)?
    let head = pages.holder_heads(db.holders)[0u64].head
    let before = db.checkpointed
    let mut decl = declare(db, Migrate)?
    let mut rows_decl = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let _ = index(mut decl, mut rows_decl, "by_u", Unique, code.describe(l102_unique_key), std.codec.key_u64())?
    let _ = finish(mut decl, take rows_decl)?
    let other_decl = declare_table(mut decl, "other", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut decl, take other_decl)?
    match seal(mut db, take decl) {
        Error(Conflict(name)) if name == "by_u" => (),
        _ => fail("L102 (e): the duplicate past the first build cut was not Conflict(by_u)"),
    }
    // Fixture guard: the build cut before it met the duplicate.
    if db.checkpointed == before || !l102_owner3_pin(db) {
        fail("L102 (e): the fixture refused before any build cut")
    }
    if pages.holder_heads(db.holders)[0u64].head != head {
        fail("L102 (e): the refusal moved main's head")
    }
    if l102_lists(db, string.from("by_u"))? {
        fail("L102 (e): the refused index is listed")
    }
    hot_rows(mut db, string.from("rows"), 6000)?
    let _ = checkpoint(mut db)?
    if l102_owner3_pin(db) {
        fail("L102 (e): a build pin outlived a holder-free cut after the refusal")
    }
    let Committed(_) = run(mut db, Some(100000000u64), copy_env(rows), fn(mut tx: Tx, t: Table[u64, u64]) -> Result[(), Error] {
        put(mut tx, t, 6000u64, 6000u64 % 97u64)
    })? else {
        fail("L102 (e): the write after the refusal did not commit")
    }
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, d, c, r, hot_options(65536)?)?
    hot_rows(mut again, string.from("rows"), 6001)?
    if l102_lists(again, string.from("by_u"))? {
        fail("L102 (e): the refused index is listed after reopen")
    }
    l102_stamps(d, again, rows.id)?
    close(take again)
}

fn l102_chain(mut phase: Migration) -> Result[(), Error] {
    migrate_table(mut phase, "rows", std.codec.key_u64(), std.codec.of_u64(), "mid", std.codec.key_u64(), std.codec.of_u64(), fn(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
        Ok(Some((k, v)))
    })?
    migrate_table(mut phase, "mid", std.codec.key_u64(), std.codec.of_u64(), "last", std.codec.key_u64(), std.codec.of_u64(), fn(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
        Ok(Some((k, v)))
    })
}

fn l102_chain_declare(mut decl: Declare) -> Result[Index[u64, u64, u64, ()], Error] {
    let mut last_decl = declare_table(mut decl, "last", std.codec.key_u64(), std.codec.of_u64())?
    let ix = index(mut decl, mut last_decl, "by_v", Many, code.describe(crash_value), std.codec.key_u64())?
    let _ = finish(mut decl, take last_decl)?
    let other_decl = declare_table(mut decl, "other", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut decl, take other_decl)?
    Ok(ix)
}

// L102 (f): one Migration migrates rows -> mid -> last, identity each, and
// its declaration adds `by_v` on `last`. Past `dirty_bytes` (6000 rows at
// 65536) `mid` builds through build cuts and ends with a partial run, and
// `last` reads it from the working map, not main's head. `last` and `by_v`
// equal the model before and after reopen; `rows` and `mid` are gone. Red
// on main: `Tiered(Migrate)` at the first `migrate_table`.
@test
fn test_l102_hot_chain(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, hot_options(65536)?)?
    let _ = hot_seed(mut db, 6000)?
    let before = db.checkpointed
    let mut decl = declare_migration(db, tasks, code.describe(l102_chain))?
    let ix = l102_chain_declare(mut decl)?
    let staged = finish_migration(db, take decl)?
    install_activation(mut db, take staged)?
    if db.checkpointed - before < 2 {
        fail("L102 (f): the fixture must run a build cut before its publish")
    }
    hot_rows(mut db, string.from("last"), 6000)?
    for gone in["rows", "mid"] {
        if let Ok(_) = table(mut db, gone, std.codec.key_u64(), std.codec.of_u64()) {
            fail("L102 (f): a chain source is still listed")
        }
    }
    l102_by_v(db, ix, 6000)?
    if l102_owner3_pin(db) {
        fail("L102 (f): an owner-3 pin is listed after the publish")
    }
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, d, c, r, hot_options(65536)?)?
    let mut reopened_decl = declare(again, Open)?
    let reopened = l102_chain_declare(mut reopened_decl)?
    let _ = seal(mut again, take reopened_decl)?
    hot_rows(mut again, string.from("last"), 6000)?
    l102_by_v(again, reopened, 6000)?
    l102_packs(d, again)?
    let final_table = table(mut again, "last", std.codec.key_u64(), std.codec.of_u64())?
    l102_stamps(d, again, final_table.id)?
    l102_stamps(d, again, reopened.id)?
    close(take again)
}

// L102 (c) for the index build: crash scenario `hot-index-build` cuts W2 at
// every boundary of (b)'s declaration on 3000 rows at the crash sizing.
fn l102_index_crash_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l102_crash_options()?)?
    let _ = l102_declare(mut db, Migrate)?
    close(take db)
}

// The recovered state is exactly OLD (neither index listed, `rows` holds the
// model) or exactly NEW (`by_v` and `by_band` Public and equal to the
// model); `required_new` demands NEW. After one holder-free cut no owner-3
// pin is listed and the stamps are published (F2); a further write and cut
// reopen to the same state.
fn l102_index_crash_state(d: Dir, mut db: Db, old: bool, n: u64) -> Result[bool, Error] waits {
    if l102_owner3_pin(db) {
        return Ok(false)
    }
    hot_rows(mut db, string.from("rows"), n)?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    l102_stamps(d, db, rows.id)?
    if old {
        return Ok(!l102_lists(db, string.from("by_v"))? && !l102_lists(db, string.from("by_band"))?)
    }
    let (ix, bands) = l102_declare(mut db, Open)?
    l102_by_v(db, ix, n)?
    l102_bands(db, bands, n)?
    l102_stamps(d, db, ix.id)?
    Ok(true)
}

fn l102_index_crash_read(d: Dir, c: Clock, r: Random, tasks: Tasks, required_new: bool) -> Result[bool, Error] waits {
    let mut db = open(tasks, d, c, r, l102_crash_options()?)?
    trust_store(mut db)?
    let old = !l102_lists(db, string.from("by_v"))?
    if old && required_new {
        return Ok(false)
    }
    let _ = checkpoint(mut db)?
    if !l102_index_crash_state(d, mut db, old, 3000)? {
        return Ok(false)
    }
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let Committed(_) = run(mut db, Some(100000000u64), copy_env(rows), fn(mut tx: Tx, t: Table[u64, u64]) -> Result[(), Error] {
        put(mut tx, t, 3000u64, 3000u64 % 97u64)
    })? else {
        return Ok(false)
    }
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, d, c, r, l102_crash_options()?)?
    let good = l102_index_crash_state(d, mut again, old, 3001)?
    close(take again)?
    Ok(good)
}

fn l70_rename(mut phase: Migration) -> Result[(), Error] {
    let listed = list_collections(phase)?
    if list.len(listed) != 2 {
        fail("L70(c): list_collections on a Tiered store")
    }
    rename_table(mut phase, "rows", "renamed")
}

fn l70_drop(mut phase: Migration) -> Result[(), Error] {
    drop_named_table(mut phase, "renamed")
}

fn l70_noop(mut _phase: Migration) -> Result[(), Error] {
    Ok(())
}

// L70 revised (§13.10a "Lifts", v2.169): on log@1, a hot Migrate that needs
// no Tiered build, export and install of a Tiered store succeed; objects@1
// `set_residency` stays `Tiered(Install)`. Red on main before M3b-S5: every
// step here was `Tiered(Migrate)` or `Tiered(Install)`.
@test
fn tiered_l70_refusals(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let store_dir = disk_test_directory(d)
    let scratch = disk_test_directory(d)
    let memory_db = memory(c, r, result.unwrap(sized(Memory, 1074790400u64)))
    if let Error(Tiered(Memory)) = require_tiered_storage(memory_db) {} else {
        fail("L70(c): expected Tiered(Memory) for memory residency")
    }
    if let Error(Tiered(Authority)) = require_archive_authority(memory_db) {} else {
        fail("L70(c): expected Tiered(Authority) for memory archive")
    }
    close(take memory_db)?
    let mut db = open(tasks, store_dir, c, r, hot_options(0)?)?
    let _ = hot_seed(mut db, 300)?
    if let Error(Tiered(Authority)) = require_archive_authority(db) {} else {
        fail("L70(c): expected Tiered(Authority) for log archive")
    }
    run_migration(mut db, tasks, code.describe(l70_rename))?
    hot_rows(mut db, string.from("renamed"), 300)?
    let export_attempt = b"l70-export-lift!"
    let scratch_before = refusal_directory(scratch)
    let leased_job = match begin_export_copy(mut db, scratch, failure_result_from_rep(types.copied(export_attempt))?, 0) {
        Ok(take job) => take job,
        Error(_) => fail("L70(c): expected log@1 Tiered export lease to succeed"),
    }
    let _ = take leased_job
    release_export(mut db, export_attempt)
    if !refusal_directory_unchanged(scratch, scratch_before) {
        fail("L70(c): export lease changed scratch before export_copy")
    }
    let staged = stage_migration(db, tasks, code.describe(l70_noop))?
    install_activation(mut db, take staged)?
    close(take db)?
    let mut again = open(tasks, store_dir, c, r, hot_options(0)?)?
    hot_rows(mut again, string.from("renamed"), 300)?
    run_migration(mut again, tasks, code.describe(l70_drop))?
    if let Ok(_) = table(mut again, "renamed", std.codec.key_u64(), std.codec.of_u64()) {
        fail("L70(c): the dropped Tiered table is still listed")
    }
    let _ = checkpoint(mut again)?
    close(take again)?
    let reopened = open(tasks, store_dir, c, r, hot_options(0)?)?
    close(take reopened)?
    let s = bucket_law_sim(tasks, c, 72, None, list.new())
    let opened = bucket_order_open(tasks, r, s.time, s.endpoint, 72, true)
    let mut ob = match take opened {
        Ok(take found) => take found,
        Error(take problem) => {
            let _ = bucket_law_report(take s)
            return Error(take problem)
        },
    }
    let mut decl = declare(ob, Migrate)?
    let t_decl = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = finish(mut decl, take t_decl)?
    let _ = seal(mut ob, take decl)?
    let head = version(snapshot(ob))
    let refused = set_residency(mut ob, t.id, Tiered)
    let after = version(snapshot(ob))
    let closed = close(take ob)
    let _ = bucket_law_report(take s)
    closed?
    if let Error(Tiered(Install)) = refused {} else {
        fail("L70(c): objects@1 set_residency was not Tiered(Install)")
    }
    if head != after {
        fail("L70(c): the refused objects@1 set_residency moved the head")
    }
    Ok(())
}

// §3 "Repair", the owner's take: an owner that takes Update 1 also takes the Updates queued
// behind it, in order, up to its inbox's capacity (1+q = 5) in one delivery job. The first
// other event ends the run and is held, not lost, and every take counts once toward the
// drain wake. Hand-derived: with the run at 3 of 5, taking Updates 2 and 3 and then `Dropped`
// is three takes, so the run wraps once (one wake) and ends at 1; Update 4 stays queued. A
// full backlog takes four more Updates and leaves the fifth queued.
pub fn law_owner_takes_queued() -> bool {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    let _ = channel.try_send(to, queued_update(2u64))
    let _ = channel.try_send(to, queued_update(3u64))
    let _ = channel.try_send(to, wire_event(Dropped))
    let _ = channel.try_send(to, queued_update(4u64))
    let mut updates: List[Update] = list.new()
    list.push(mut updates, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut held: Option[WireEvent] = None
    let mut run = 3u64
    let wakes = wire_take_queued(inbox, mut run, 5u64, mut updates, mut held)
    let held_sent = match take held { Some(WireEvent(e: Dropped)) => true, _ => false }
    let left = match channel.try_receive(inbox) { Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 4u64, _ => false }
    let mixed = wakes == 1u64 && run == 1u64 && held_sent && left && queued_versions(updates, 3u64)

    for v in 2u64 .. 7u64 { let _ = channel.try_send(to, queued_update(v)) }
    let mut full: List[Update] = list.new()
    list.push(mut full, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut kept: Option[WireEvent] = None
    let mut at = 0u64
    let _ = wire_take_queued(inbox, mut at, 5u64, mut full, mut kept)
    let rest = match channel.try_receive(inbox) { Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 6u64, _ => false }
    let capped = at == 4u64 && rest && (match kept { None => true, _ => false }) && queued_versions(full, 5u64)
    mixed && capped
}

pub fn law_owner_take_wakes() -> bool {
    let mut run = 0u64
    let mut wakes = 0u64
    for _ in 0u64 .. 129u64 { if wire_taken(mut run, 64u64) { wakes += 1u64 } }
    wakes == 2u64 && run == 1u64
}

// No wire configuration, for unit drivers whose registry fixes `G` and binds nothing.
fn no_wire[G: send]() -> Option[Wire[G, ()]] { None }

fn wire_service_seed[G: send, B: send](random: Random, take session_wire: Option[Wire[G, B]], head: Sender[HeadInput], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, B]] {
    wire_service_with_head(random, take session_wire, LifecycleHead(channel.sender(head)), clock, tasks, config, take target)
}

pub fn fixture_unsubscribe(owner: FixtureOwner, sub: u32) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Unsubscribed(owner.who, sub)))
}

pub fn fixture_try_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    if let Ok(take d) = channel.try_receive(owner.from) { return Ok(take d) }
    match channel.try_receive(owner.inbox) {
        Ok(take e) => { fixture_content(owner, take e); channel.try_receive(owner.from) },
        Error(e) => Error(e),
    }
}

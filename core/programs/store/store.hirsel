fn info_helper(mut tx: Tx) -> u64 {
    info(mut tx).id.version
}

// G2 positive control: run and a mut-Tx helper both have honest CallInfo.
pub fn law_info_mut(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    for _ in 0u64 .. 2 {
        let expected = db.head + 1
        let outcome = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[bool, ()] {
            let direct = info(mut tx).id.version
            let indirect = info_helper(mut tx)
            Ok(direct == expected && indirect == expected)
        }))
        match take outcome {
            Committed(done) => if !done.value {
                return false
            },
            _ => return false
        }
    }
    true
}


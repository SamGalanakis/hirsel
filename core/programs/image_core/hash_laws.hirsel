// Generated by the published JS implementation, with its f64 arithmetic.
@test
fn thumbhash_and_dhash_reference() -> Result[(), ()] {
    let limits = image.Limits(max_bytes: 4096, max_pixels: 1024, max_frames: 1, max_steps: 10000000)
    for i in 0u64 .. 4 {
        let (w, h, alpha, reference, pw, ph, digest): (u32, u32, bool, Bytes, u32, u32, String) = match i {
            0 => (7, 5, false, b"\xe0\xf7\x05\x1d\x92\x48\xc0\x5b\x48\x89\x95\x67\x84\x69\x78\x77\x10\x63\xf3\x6b\x65", 32, 23, "3399477a15210d9985422f3270321b482666cfe08d6a89c9ebcdb7ddb01ef220"),
            1 => (8, 8, true, b"\xe0\x07\x82\x1d\x0a\x08\xd2\xef\x78\x26\xa7\x84\x67\xfb\x67\x47\x8f\x85\x28\x81\x7a\xe1\x82\x10\x81", 32, 32, "dfeb80df3c06deaa80177a32c87dc6bc5d57eb3d570102287a6346ef0cf153e0"),
            2 => (3, 11, true, b"\xe0\x17\x82\x11\x06\x08\x6f\x94\x7a\x6e\x83\xf5\x34\x08\x54\x96\x75\x78\xa7\x75\x53\x57\x0b", 6, 32, "32807aa2be0d407e934a4415d7414cd2239a4b293096b3201e6148f56d568138"),
            _ => (5, 5, false, b"\xe1\x07\x06\x2f\x04\x87\x29\xc8\x82\xb0\x76\x16\x84\x10\x66\x92\x63\x78\x46\x05\x84\x55\x40\x05", 32, 32, "c673a12625867c4f03e593e8f7c30b3ecb283a70be275d707c818f12ad3256da"),
        }
        let count: u64 = int.widen(w * h)
        let mut pixels: Bytes = list.with_capacity(count * 4)
        for k in 0u64 .. count {
            list.push(mut pixels, int.narrow((k * 31 + 7) % 256))
            list.push(mut pixels, int.narrow((k * 73 + 19) % 256))
            list.push(mut pixels, int.narrow((k * 113 + 142) % 256))
            list.push(mut pixels, if alpha {
                int.narrow((k * 51 + 47) % 256)
            } else {
                255
            })
        }
        let hash = result.unwrap(image.thumbhash(image.Raster(width: w, height: h, rgba: take pixels), limits))
        if hash != reference {
            fail("ThumbHash bytes differ from the JS reference")
        }
        let rendered = result.unwrap(image.decode_thumbhash(hash, limits))
        let mut binary: Bytes = list.with_capacity(32)
        let hash_bytes = std.sha256.hash(rendered.rgba)
        for j in 0u64 .. 32 {
            list.push(mut binary, hash_bytes[j])
        }
        if rendered.width != pw || rendered.height != ph || std.hex.encode(binary) != digest {
            fail("ThumbHash preview differs from the JS reference")
        }
    }
    let mut gradient: Bytes = list.with_capacity(288)
    for _ in 0u64 .. 8 {
        for x in 0u64 .. 9 {
            let v: u8 = int.narrow(240 - x * 20)
            list.fill(mut gradient, 3, v)
            list.push(mut gradient, 255)
        }
    }
    if result.unwrap(image.dhash(image.Raster(width: 9, height: 8, rgba: take gradient), limits)) != 0xffffffffffffffff {
        fail("descending luminance must set every dHash comparison")
    }
    Ok(())
}

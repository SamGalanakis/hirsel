+namespace {
+// Records, in order, every path the linker asks its input filesystem about
+// and whether it was found, so a record of the link can guard the absent
+// candidates of each search as well as the files it opened.
+class SearchTraceFileSystem : public vfs::ProxyFileSystem {
+public:
+  explicit SearchTraceFileSystem(IntrusiveRefCntPtr<vfs::FileSystem> fs)
+      : ProxyFileSystem(std::move(fs)) {}
+  ErrorOr<vfs::Status> status(const Twine &path) override {
+    auto result = ProxyFileSystem::status(path);
+    note(path, bool(result));
+    return result;
+  }
+  bool exists(const Twine &path) override {
+    bool result = ProxyFileSystem::exists(path);
+    note(path, result);
+    return result;
+  }
+  ErrorOr<std::unique_ptr<vfs::File>>
+  openFileForRead(const Twine &path) override {
+    auto result = ProxyFileSystem::openFileForRead(path);
+    note(path, bool(result));
+    return result;
+  }
+  std::vector<std::pair<std::string, bool>> queries;
+  bool traceable = true;
+
+private:
+  void note(const Twine &path, bool found) {
+    std::string name = path.str();
+    if (name.find('\n') != std::string::npos)
+      traceable = false;
+    queries.emplace_back(std::move(name), found);
+  }
+};
+} // namespace

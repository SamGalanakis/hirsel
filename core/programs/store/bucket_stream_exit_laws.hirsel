// Stream exits, export/backup and sealed-cursor crash laws (§12.11.11, L90-E).
fn exit_attempt(tag: u8) -> Bytes {
    let mut b: Bytes = list.with_capacity(16)
    list.fill(mut b, 16, tag)
    take b
}

fn exit_open_opts(create: bool, group_commits: u32) -> Options {
    let mut o = bucket_law_options(create)
    o.claim_ms = 2000
    o.group_bytes = 65536
    o.group_commits = group_commits
    o
}

fn exit_open_attached_op(s: BucketSim, tasks: Tasks, r: Random, mut svc: JournalService, host_name: String, seed: u64, place_prefix: String, create: bool, group_commits: u32, op_ms: u64) -> Result[Db, Error] waits {
    let slot = journal_slot(mut svc)?
    let client = df_client_host(s.endpoint, s.time, tasks, host_name, seed, place_prefix, 2)?
    let attached = streamed(object_authority(take client, "bucket", op_ms), take slot)?
    match open_authority(tasks, take attached, s.time, r, exit_open_opts(create, group_commits)) {
        Ok(take db) => Ok(take db),
        Error(Refusal(error: take problem, ..)) => Error(take problem),
    }
}

fn exit_open_attached(s: BucketSim, tasks: Tasks, r: Random, mut svc: JournalService, host_name: String, seed: u64, place_prefix: String, create: bool, group_commits: u32) -> Result[Db, Error] waits {
    exit_open_attached_op(s, tasks, r, mut svc, host_name, seed, place_prefix, create, group_commits, DF_OP_MS)
}

fn exit_backup_rows(parent: Dir, target: Dir, tasks: Tasks, c: Clock, r: Random) -> Result[u64, Error] waits {
    let mut opts = bucket_law_options(false)
    opts.group_bytes = 65536
    let restored_dir = disk_test_directory(parent)
    match restore(target, restored_dir, c, opts) {
        Ok(_) => (),
        Error(_) => fail("L90-E: restore(backup) failed"),
    }
    let mut restored = open(tasks, restored_dir, c, r, opts)?
    let n = bucket_law_rows(mut restored)?
    close(take restored)?
    Ok(n)
}

// L90-E (exits, M5, M6):
// 1. Export/backup with `sealed` empty settles, keeps ATTACH, exports all rows,
//    and the holder keeps serving.
// 2. Export/backup with `sealed` non-empty runs a cut: returns the cut's refusal
//    if refused, or cuts and exports when admitted, keeping ATTACH.
// 3. With two sealed tails and one commit per GROUP, a crash after the
//    first GROUP head write leaves every commit recoverable exactly once.
@test
fn bucket_stream_exits_and_sealed_cursor(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = df_complete_expired_sim(tasks, c, 9098)
    let outcome = exit_l90_e_export_run(d, s, tasks, c, r)
    let report = bucket_law_report(take s)
    outcome?
    bucket_law_head_history(report)?
    exit_l90_e_sealed_cursor_crash(c, r, tasks)
}

fn exit_l90_e_export_run(d: Dir, s: BucketSim, tasks: Tasks, c: Clock, r: Random) -> Result[(), Error] waits {
    let sid_clean = HostStreamId(hi: 0x4142434445464748, lo: 0x494a4b4c4d4e4f50)
    let mut svc_clean = df_start_service_host(s, tasks, r, "spare.test", 601, sid_clean, 10, 0, DF_OP_MS)?
    let mut svc_bad = df_start_service_host(s, tasks, r, "s3.test", 602, df_sid_b(), 10, 0, DF_OP_MS)?
    // --- Variant 1: Export/backup with `sealed` empty settles and keeps ATTACH ---
    let mut p1 = exit_open_attached(s, tasks, r, mut svc_clean, "spare.test", 603, string.from("p1/"), true, 4)?
    bucket_law_commit(mut p1, 1)?
    bucket_law_commit(mut p1, 2)?
    let dir1 = disk_test_directory(d)
    let att1 = exit_attempt(1u8)
    let job1 = match begin_backup(mut p1, dir1, failure_result_from_rep(types.copied(att1))?) {
        Ok(take j) => take j,
        Error(_) => fail("L90-E(1): begin_backup failed with empty sealed"),
    }
    let _ = match export_copy(take job1) {
        Ok(take done) => take done,
        Error(_) => fail("L90-E(1): export_copy failed"),
    }
    release_export(mut p1, att1)
    let (_, attach1) = df_head_attach_live(s, tasks, "spare.test", 604, string.from("p1/"))?
    let Some(a1) = attach1 else {
        fail("L90-E(1): export with empty sealed dropped ATTACH")
    }
    let still_live1 = match a1.live {
        Some(_) => true,
        None => false,
    }
    if !still_live1 || a1.settles == 0 {
        fail("L90-E(1): export with empty sealed did not settle keeping ATTACH")
    }
    if exit_backup_rows(d, dir1, tasks, c, r)? != 2 {
        fail("L90-E(1): exported backup missing settled live-tail commits")
    }
    // Holder keeps serving with ATTACH intact.
    bucket_law_commit(mut p1, 3)?
    if bucket_law_rows(mut p1)? != 3 {
        fail("L90-E(1): holder stopped serving after export")
    }
    close(take p1)?
    // --- Variant 2a: Export with `sealed` non-empty returns cut refusal if cut refused ---
    let mut p2_a = exit_open_attached(s, tasks, r, mut svc_clean, "spare.test", 605, string.from("p2/"), true, 4)?
    bucket_law_commit(mut p2_a, 1)?
    let _ = take p2_a
    // Migrate to svc_bad on "s3.test": forced open-time cut refused -> sealed non-empty!
    let mut p2_b = exit_open_attached(s, tasks, r, mut svc_bad, "s3.test", 606, string.from("p2/"), false, 4)?
    let dir2a = disk_test_directory(d)
    let att2a = exit_attempt(2u8)
    match begin_backup(mut p2_b, dir2a, failure_result_from_rep(types.copied(att2a))?) {
        Error(Store(Remote(Uncertain(Status(200, _))))) => (),
        Ok(_) => fail("L90-E(2a): export succeeded despite refused cut with non-empty sealed"),
        Error(_) => fail("L90-E(2a): unexpected error on refused-cut export"),
    }
    let _ = take p2_b
    // --- Variant 2b: Export with `sealed` non-empty cuts and exports when cut admitted ---
    // Reopen p2/ on svc_clean (epoch 3 -> cut succeeds, sealed emptied), commit row 2,
    // then migrate on SAME svc_clean (epoch 4 -> sealed has 1 entry on same sid -> no open-time cut!),
    // commit row 3, then export -> cuts, clears sealed, keeps ATTACH, exports all 3 rows!
    let mut p2_c = exit_open_attached(s, tasks, r, mut svc_clean, "spare.test", 607, string.from("p2/"), false, 4)?
    bucket_law_commit(mut p2_c, 2)?
    let _ = take p2_c
    let mut p2_d = exit_open_attached(s, tasks, r, mut svc_clean, "spare.test", 608, string.from("p2/"), false, 4)?
    bucket_law_commit(mut p2_d, 3)?
    let (_, pre_exp_attach) = df_head_attach_live(s, tasks, "spare.test", 609, string.from("p2/"))?
    let Some(pre_a) = pre_exp_attach else {
        fail("L90-E(2b): ATTACH missing before export")
    }
    if list.len(pre_a.sealed) == 0 {
        fail("L90-E(2b): expected non-empty sealed before export")
    }
    let dir2b = disk_test_directory(d)
    let att2b = exit_attempt(3u8)
    let job2b = match begin_backup(mut p2_d, dir2b, failure_result_from_rep(types.copied(att2b))?) {
        Ok(take j) => take j,
        Error(_) => fail("L90-E(2b): begin_backup failed with non-empty sealed on clean host"),
    }
    let _ = match export_copy(take job2b) {
        Ok(take done) => take done,
        Error(_) => fail("L90-E(2b): export_copy failed"),
    }
    release_export(mut p2_d, att2b)
    let (_, post_exp_attach) = df_head_attach_live(s, tasks, "spare.test", 610, string.from("p2/"))?
    let Some(post_a) = post_exp_attach else {
        fail("L90-E(2b): export cut dropped ATTACH")
    }
    if list.len(post_a.sealed) != 0 {
        fail("L90-E(2b): export cut did not empty sealed")
    }
    if exit_backup_rows(d, dir2b, tasks, c, r)? != 3 {
        fail("L90-E(2b): exported backup missing rows after cut")
    }
    close(take p2_d)?
    close_journal_service(take svc_clean)?
    close_journal_service(take svc_bad)?
    Ok(())
}

// The first GROUP head write advances the cursor of the first sealed tail.
fn exit_l90_e_sealed_cursor_crash(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    // PUT p4/head: genesis, table cut, epoch 2 claim, epoch 3 claim,
    // the first GROUP (row 1), then the second GROUP (row 2).
    // Drop attempts 6..9 to exhaust epoch 3's 60 ms operation deadline.
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    list.push(mut holds, std.sim.s3.Hold(method: "PUT", key: string.from("p4/head"), from: 6, count: 4, until: At(0), then: Drop))
    let s = bucket_law_sim_holds(tasks, c, 9099, None, list.new(), take holds, std.sim.world.plan(9099))
    let outcome = exit_l90_e_crash_run(s, tasks, r)
    let report = bucket_law_report(take s)
    outcome?
    bucket_law_head_history(report)
}

fn exit_settle_sealed(mut db: Db) -> Result[host_stream.SettleOutcome, Error] waits {
    let (take paused, take resume) = take_object_journal_with(mut db, true)?
    let (take settled, take outcome) = object_writer.settle_object_sealed(take paused, 65536, 1)
    failure_result_from_rep(object_writer.return_object_journal(take settled, resume))?
    failure_result_from_rep(take outcome)
}

fn exit_l90_e_crash_run(s: BucketSim, tasks: Tasks, r: Random) -> Result[(), Error] waits {
    let mut svc = df_start_service_host(s, tasks, r, "s3.test", 701, df_sid_a(), 10, 0, DF_OP_MS)?
    // Epoch 1: create table and commit rows 1 & 2 (will need 2 GROUP entries under group_commits=1).
    let mut e1 = exit_open_attached(s, tasks, r, mut svc, "s3.test", 702, string.from("p4/"), true, 1)?
    let _ = bucket_law_rows_table(mut e1)?
    bucket_law_commit(mut e1, 1)?
    bucket_law_commit(mut e1, 2)?
    let _ = take e1
    // Epoch 2 (same svc): sealed = [tail_1 (rows 1, 2)], commit row 3 -> crash.
    let mut e2 = exit_open_attached(s, tasks, r, mut svc, "s3.test", 703, string.from("p4/"), false, 1)?
    bucket_law_commit(mut e2, 3)?
    let _ = take e2
    // Epoch 3 (same svc, short op_ms = 60): sealed = [tail_1 (rows 1, 2), tail_2 (row 3)], commit row 4 (live).
    let mut e3 = exit_open_attached_op(s, tasks, r, mut svc, "s3.test", 704, string.from("p4/"), false, 1, 60)?
    bucket_law_commit(mut e3, 4)?
    match exit_settle_sealed(mut e3) {
        Error(_) => (),
        Ok(SettleNotApplied) => (),
        Ok(_) => fail("L90-E(crash): expected the second GROUP head write to fail"),
    }
    let _ = take e3
    // Verify intermediate crash state on p4/head: 2 sealed tails remain, with
    // sealed[0]'s cursor moved past row 1 and both sealed `at` == head.entry.seq!
    let (crash_head, crash_attach) = df_head_attach_live(s, tasks, "s3.test", 705, string.from("p4/"))?
    let Some(ca) = crash_attach else {
        fail("L90-E(crash): ATTACH missing at crash point")
    }
    if list.len(ca.sealed) != 2 || ca.sealed[0u64].at != crash_head.entry.seq || ca.sealed[1u64].at != crash_head.entry.seq {
        fail("L90-E(crash): sealed cursor did not advance `at` on both sealed tails after 1st GROUP entry")
    }
    // Next open (epoch 4, generous op_ms = 2000): history must hold every commit 1..4 ONCE!
    let mut e4 = exit_open_attached_op(s, tasks, r, mut svc, "s3.test", 706, string.from("p4/"), false, 1, 2000)?
    if bucket_law_rows(mut e4)? != 4 {
        fail("L90-E(crash): next open did not recover all 4 rows cleanly after mid-rewrite crash")
    }
    if let Ok(SettleApplied) = exit_settle_sealed(mut e4) {} else {
        fail("L90-E(crash): sealed settlement did not resume after reopen")
    }
    let (_, finished_attach) = df_head_attach_live(s, tasks, "s3.test", 707, string.from("p4/"))?
    let Some(attached) = finished_attach else {
        fail("L90-E(crash): sealed settlement dropped ATTACH")
    }
    if list.len(attached.sealed) != 0 {
        fail("L90-E(crash): sealed settlement did not finish the remaining tails")
    }
    let cut_ok = checkpoint(mut e4)?
    durable(mut e4, cut_ok)?
    if bucket_law_rows(mut e4)? != 4 {
        fail("L90-E(crash): rows missing after recovery cut")
    }
    close(take e4)?
    close_journal_service(take svc)?
    Ok(())
}

type PausedStreamCancel: send {
    journal: Sender[object_writer.JournalMsg],
    through: u64
}

fn exit_cancelled_settle(take input: PausedStreamCancel) -> Result[(), Error] waits {
    let PausedStreamCancel(journal: take journal, through) = take input
    let (take handover, take paused): (Sender[object_writer.ObjectJournalStart], Receiver[object_writer.ObjectJournalStart]) = channel.new(1)
    let (take resume, take resuming): (Sender[object_writer.ObjectJournalStart], Receiver[object_writer.ObjectJournalStart]) = channel.new(1)
    result.unwrap(channel.send(journal, ObjectPause(take handover, take resuming)))
    let active = object_writer.object_journal_begin(result.unwrap(channel.receive(paused)))
    let (take settled, take outcome) = object_writer.settle_object_stream(take active, through, through + 1, false, 65536, 1)
    failure_result_from_rep(object_writer.return_object_journal(take settled, resume))?
    let _ = failure_result_from_rep(take outcome)?
    fail("the paused settle returned before cancellation")
}

@test
fn bucket_stream_cancelled_settle_joins_worker(c: Clock, tasks: Tasks, r: Random) -> Result[(), Error] waits {
    let mut batch_name = string.with_capacity(48)
    format.stream_batch_key(mut batch_name, 1, 2)
    let batch_key = stream_service_key(take batch_name)
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    list.push(mut holds, std.sim.s3.Hold(method: "GET", key: string.from(batch_key), from: 1, count: 1, until: Requested("GET", "settle-cancel-release", 1), then: Apply))
    let sim = bucket_law_sim_holds(tasks, c, 3267, None, list.new(), take holds, std.sim.world.plan(3267))
    let mut service = stream_unhold_service(sim, tasks, r, 4)?
    stream_unhold_make_place(sim, tasks, r)?
    let mut place = stream_unhold_open_attached(sim, tasks, r, mut service, 85)?
    let acknowledged = stream_unhold_commit_ticket(mut place, 1)?
    durable(mut place, acknowledged)?
    let job = PausedStreamCancel(journal: channel.sender(object_sender(disk_state(place))), through: 2)
    let mut waiter = task.spawn(tasks, bytes 16777216, take job, exit_cancelled_settle)
    result.unwrap(std.sim.s3.requested(sim.endpoint, "GET", batch_key, 1))
    task.cancel(mut waiter)
    let Error(Cancelled(_)) = task.join(take waiter) else {
        fail("the foreground settle did not unwind")
    }
    stream_service_marker(sim, tasks, string.from("settle-cancel-release"))?
    let Db(disk: take disk, ..) = take place
    let Some(DiskState(backend: ObjectBackend(take worker), ..)) = take disk else {
        fail("the attached Place did not have an Object worker")
    }
    failure_result_from_rep(object_writer.join_worker_law(take worker))?
    close_journal_service(take service)?
    let _ = bucket_law_report(take sim)
    Ok(())
}

type SimDiskMount: send {
    image: std.sim.fs.Fs,
    plan: std.sim.world.Plan,
    clock: Clock,
    port: core.Served[DirOp]
}

fn sim_disk_serve(take mount: SimDiskMount) -> std.sim.fs.Fs waits {
    let SimDiskMount(image: take saved, plan: take decisions, clock, port: take port) = take mount
    let mut image = take saved
    let mut plan = take decisions
    std.sim.fs.serve(mut image, mut plan, clock, take port)
    take image
}

fn sim_disk_mount(tasks: Tasks, c: Clock, take image: std.sim.fs.Fs, take plan: std.sim.world.Plan, room: u64) -> (Dir, Task[std.sim.fs.Fs]) {
    let (d, port) = provide.dir(bytes 65536)
    let server = task.spawn(tasks, bytes room, SimDiskMount(image: take image, plan: take plan, clock: c, port: take port), sim_disk_serve)
    (d, take server)
}

fn sim_disk_unmount(take d: Dir, take server: Task[std.sim.fs.Fs]) -> std.sim.fs.Fs waits {
    drop(take d)
    result.unwrap(task.join(take server))
}

fn scrub_sim_fault(tasks: Tasks, c: Clock, rates: std.sim.world.WriteFaults, kind: u64) -> Result[(), Error] waits {
    let name = "pack"
    let ctx = format.DiskContext(store: store_key_to_rep(StoreId(hi: 1, lo: 2)), role: 3, seq: 7)
    let frame = failure_result_from_rep(types.capacity(format.disk_seal(ctx, 0, 0x0021, 0, string.as_bytes("payload"))))?
    let width = list.len(frame)
    let mut blank: Bytes = list.with_capacity(width * 2)
    list.fill(mut blank, width * 2, 0u8)
    let (clean, server) = sim_disk_mount(tasks, c, std.sim.fs.new(), std.sim.world.plan(1), 1048576)
    disk_write_synced(clean, name, blank)?
    disk_io(host.sync_dir(clean))?
    let image = sim_disk_unmount(take clean, take server)
    let mut plan = std.sim.world.plan(2)
    std.sim.world.set_write_faults(mut plan, rates)
    let (d, writer) = sim_disk_mount(tasks, c, take image, take plan, 1048576)
    let mut f = disk_io(host.open(d, name, ReadWrite))?
    host.write_at(mut f, 0, frame) ?=> |e| Io(e.error)
    disk_io(host.sync(mut f))?
    disk_io(host.close(take f))?
    let mut crashed = sim_disk_unmount(take d, take writer)
    let mut cut = std.sim.world.plan(3)
    std.sim.fs.crash(mut crashed, mut cut)
    let (after, recovered) = sim_disk_mount(tasks, c, take crashed, std.sim.world.plan(4), 1048576)
    let raw = disk_read_paged_file(after, name, width * 2)?
    let first = list.slice(raw, 0, width)
    let second = list.slice(raw, width, width * 2)
    match kind {
        0 => {
            let mut changed = 0u64
            for i in 0u64 .. width {
                let diff = first[i] ^ frame[i]
                if diff != 0 {
                    if diff & (diff - 1u8) != 0 {
                        fail("corrupt write flipped more than one bit in a byte")
                    }
                    changed += 1
                }
            }
            if changed != 1 || second != list.slice(blank, width, width * 2) {
                fail("corrupt write must flip exactly one bit in the intended slot")
            }
        },
        1 => {
            if first != list.slice(blank, 0, width) || second != frame {
                fail("misdirected write must leave the old slot and copy the exact frame to the other slot")
            }
            match disk_read_frame(name, ctx, raw, width) {
                Error(Corrupt(Fault(why: Checksum, ..))) => (),
                _ => fail("the store accepted a well-formed frame at the wrong offset"),
            }
        },
        _ => if raw != blank {
            fail("lost write must leave both old slots")
        },
    }
    match disk_read_frame(name, ctx, raw, 0) {
        Error(Corrupt(_)) => (),
        _ => fail("the store accepted a damaged or missing frame"),
    }
    // A subsequent correct write repairs the source slot. Restoring it
    // must not require access to the simulator's pristine bytes.
    let mut repair_file = disk_io(host.open(after, name, ReadWrite))?
    host.write_at(mut repair_file, 0, frame) ?=> |e| Io(e.error)
    disk_io(host.close(take repair_file))?
    let repaired = disk_read_paged_file(after, name, width * 2)?
    let _ = disk_read_frame(name, ctx, repaired, 0)?
    let _ = sim_disk_unmount(take after, take recovered)
    Ok(())
}

@test
fn disk_test_seeded_write_faults(tasks: Tasks, c: Clock) -> Result[(), Error] waits {
    scrub_sim_fault(tasks, c, std.sim.world.WriteFaults(corrupt: 10000, misdirect: 0, lost_write: 0), 0)?
    scrub_sim_fault(tasks, c, std.sim.world.WriteFaults(corrupt: 0, misdirect: 10000, lost_write: 0), 1)?
    scrub_sim_fault(tasks, c, std.sim.world.WriteFaults(corrupt: 0, misdirect: 0, lost_write: 10000), 2)
}

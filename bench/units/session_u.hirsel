// The session server on units. Run under HIRSEL_UNTIED=W so its units share
// W pool workers.
//
// Arguments: port sessions partitions par tool_port k [ready_ack].
// The root makes `partitions` partition units, one shared service unit and k
// session units, and wires them with connections. The root accepts on one
// port and sends each socket to the next session unit in round-robin order.
//
// A turn request is 48 bytes: turn u64, seed u64, ncalls u8, par u8,
// shared u8, pad to 24, then one size code per call (0 1 KiB, 1 8 KiB,
// 2 64 KiB). Each tool call sends size u64 and seed u64 to the tool server
// and gets 8 bytes of held ns followed by size bytes. The session hashes them
// (std.sha256, the CPU work), XORs the first digest word into acc, calls the
// shared service when asked, sends a 64-byte record to its partition and
// waits for the group commit's sync before replying turn, acc, held. A par
// turn makes its calls in parallel tasks, each on its own tool connection.
//
// The root reports `session turns=<n> groups=<n> svc=<n>` at the end.
// A session task: buffers for one tool connection plus its requests.
const SESSION_BYTES: u64 = 98304

// A par session: 16 tool connections and their call tasks.
const PAR_SESSION_BYTES: u64 = 2097152

const UNIT_BYTES: u64 = 1048576

const COMMIT_BYTES: u64 = 4194304

const COMMIT_CAP: u64 = 4096

const SVC_CAP: u64 = 1024

const SVC_ROUNDS: u64 = 1000

const PAR_TOOLS: u64 = 16

fn kernel(seed: u64, rounds: u64) -> u64 {
    let mut x = seed
    for _ in 0 .. rounds {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
    }
    x
}

fn arg(argv: Args, i: u64) -> u64 {
    let Some(v) = args.get(argv, i) else {
        fail("missing argument")
    }
    result.unwrap(int.parse(v))
}

fn local_addr(port: u64) -> Addr {
    Addr(ip: V4(0x7f000001), port: int.truncate(port))
}

fn connect_retry(nw: Net, clock: Clock, a: Addr) -> Socket waits {
    loop {
        match host.connect(nw, a, Never) {
            Ok(take s) => return take s,
            Error(_) => host.sleep_until(clock, host.mono_ns(clock) + 200000),
        }
    }
}

fn send_all(mut w: WriteHalf, b: Bytes) waits {
    let n = result.unwrap(host.send_pair(mut w, b, string.as_bytes(""), Never))
    if n != list.len(b) {
        fail("short send")
    }
}

fn recv_exact(mut r: ReadHalf, mut buf: Bytes, size: u64) -> bool waits {
    list.clear(mut buf)
    while list.len(buf) < size {
        let want = size - list.len(buf)
        match host.recv_bounded(mut r, mut buf, want, Never) {
            Ok(got) => {
                if got == 0 {
                    return false
                }
            },
            Error(_) => return false,
        }
    }
    true
}

fn size_of(code: u8) -> u64 {
    if code == 0u8 {
        return 1024
    }
    if code == 1u8 {
        return 8192
    }
    65536
}

// ---- partition units: one committer each, group commit.
type Commit: cross {
    rec: Bytes,
    ack: Client[u64]
}

type Partition: cross {
    d: Dir,
    p: u64,
    hello: Client[Client[Commit]]
}

fn partition_name(p: u64) -> String {
    let mut s = string.new()
    result.unwrap(string.push(mut s, "p"))
    result.unwrap(string.push_u64(mut s, p))
    result.unwrap(string.push(mut s, ".log"))
    s
}

fn partition(take job: Partition) -> u64 waits {
    let Partition(d: d, p: p, hello: hello) = take job
    let mut file = result.unwrap(host.open(d, partition_name(p), Write))
    let (c, input): (Client[Commit], Inbox[Commit]) = result.unwrap(conn.new(COMMIT_CAP, bytes COMMIT_CAP * 64))
    result.unwrap(conn.send(hello, take c))
    let _ = take hello
    let mut groups = 0u64
    let mut batch: Bytes = result.unwrap(list.with_capacity(65536))
    let mut acks: List[Client[u64]] = list.new()
    while let Ok(take first) = conn.receive(input) {
        list.clear(mut batch)
        let Commit(rec: take r, ack: take a) = take first
        result.unwrap(list.append(mut batch, r))
        result.unwrap(list.push(mut acks, take a))
        let mut more = true
        while more {
            match conn.try_receive(input) {
                Ok(take more_c) => {
                    let Commit(rec: take r2, ack: take a2) = take more_c
                    result.unwrap(list.append(mut batch, r2))
                    result.unwrap(list.push(mut acks, take a2))
                },
                Error(_) => {
                    more = false
                },
            }
        }
        match host.write(mut file, batch) {
            Ok(_) => (),
            Error(_) => fail("partition write"),
        }
        result.unwrap(host.sync(mut file))
        groups = groups + 1
        while let Some(take done) = list.pop(mut acks) {
            let _ = conn.send(done, groups)
        }
    }
    groups
}

// ---- the shared service unit.
type SvcReq: cross {
    x: u64,
    reply: Client[u64]
}

type Service: cross {
    hello: Client[Client[SvcReq]]
}

fn service(take job: Service) -> u64 waits {
    let Service(hello: hello) = take job
    let (c, input): (Client[SvcReq], Inbox[SvcReq]) = result.unwrap(conn.new(SVC_CAP, bytes 0))
    result.unwrap(conn.send(hello, take c))
    let _ = take hello
    let mut calls = 0u64
    while let Ok(take q) = conn.receive(input) {
        let SvcReq(x: x, reply: take reply) = take q
        calls = calls + 1
        let _ = conn.send(reply, kernel(x, SVC_ROUNDS))
    }
    calls
}

// ---- tool calls.
type Tool: send {
    r: ReadHalf,
    w: WriteHalf,
    buf: Bytes,
}

// Returns (first digest word, held ns).
fn tool_call(mut t: Tool, size: u64, seed: u64) -> (u64, u64) waits {
    let mut req: Bytes = result.unwrap(list.with_capacity(16))
    result.unwrap(list.put_word_le(mut req, size))
    result.unwrap(list.put_word_le(mut req, seed))
    send_all(mut t.w, req)
    if !recv_exact(mut t.r, mut t.buf, 8 + size) {
        fail("tool closed")
    }
    let held: u64 = list.word_le(t.buf, 0)
    let mut s = std.sha256.start()
    std.sha256.add(mut s, t.buf, 8, 8 + size)
    let d = std.sha256.finish(s)
    let w0: u64 = inline.word_le(d, 0)
    (w0, held)
}

type Call: send {
    tool: Tool,
    size: u64,
    seed: u64,
}

type Done: send {
    tool: Tool,
    digest: u64,
    held: u64,
}

fn call_task(take c: Call) -> Done waits {
    let Call(tool: take t, size: size, seed: seed) = take c
    let mut tool = take t
    let (d, h) = tool_call(mut tool, size, seed)
    Done(tool: take tool, digest: d, held: h)
}

fn open_tool(nw: Net, clock: Clock, port: u64) -> Tool waits {
    let s = connect_retry(nw, clock, local_addr(port))
    let (rh, wh) = net.split(take s)
    Tool(r: take rh, w: take wh, buf: result.unwrap(list.with_capacity(65536 + 8)))
}

// ---- one session: a task in a session unit, owning its client's socket.
type Session: send {
    tasks: Tasks,
    nw: Net,
    clock: Clock,
    r: ReadHalf,
    w: WriteHalf,
    sid: u64,
    commit: Client[Commit],
    svc: Client[SvcReq],
    tool_port: u64,
    par: bool,
    ready_ack: bool,
}

fn session(take job: Session) -> u64 waits {
    let Session(tasks: tasks, nw: nw, clock: clock, r: take rh, w: take wh, sid: sid, commit: commit, svc: svc, tool_port: tool_port, par: par, ready_ack: ready_ack,) = take job
    let mut r = take rh
    let mut w = take wh
    // One connection answers both the service and the partition: each
    // request carries a client of it, as the twin's oneshot.
    let (back, answers): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    let mut tools: List[Tool] = list.new()
    let count = if par {
        PAR_TOOLS
    } else {
        1
    }
    for _ in 0 .. count {
        result.unwrap(list.push(mut tools, open_tool(nw, clock, tool_port)))
    }
    let mut req: Bytes = result.unwrap(list.with_capacity(48))
    let mut small: Bytes = result.unwrap(list.with_capacity(24))
    if ready_ack {
        result.unwrap(list.put_word_le(mut small, sid))
        send_all(mut w, small)
    }
    let mut turns = 0u64
    while recv_exact(mut r, mut req, 48) {
        let turn: u64 = list.word_le(req, 0)
        let seed: u64 = list.word_le(req, 8)
        let ncalls: u64 = int.widen(req[16])
        let in_par: u8 = req[17]
        let shared: u8 = req[18]
        let mut acc = 0u64
        let mut held = 0u64
        if in_par == 0u8 {
            let Some(take t) = list.pop(mut tools) else {
                fail("no tool")
            }
            let mut tool = take t
            for i in 0 .. ncalls {
                let (dg, h) = tool_call(mut tool, size_of(req[24 + i]), int.wrapping_add(seed, i))
                acc = acc ^ dg
                held = held + h
            }
            result.unwrap(list.push(mut tools, take tool))
        } else {
            let mut jobs: List[Task[Done]] = list.new()
            for i in 0 .. ncalls {
                let Some(take t) = list.pop(mut tools) else {
                    fail("no tool")
                }
                let c = Call(tool: take t, size: size_of(req[24 + i]), seed: int.wrapping_add(seed, i))
                result.unwrap(list.push(mut jobs, result.unwrap(task.spawn(tasks, bytes 4096, take c, call_task))))
            }
            while let Some(take h) = list.pop(mut jobs) {
                let Done(tool: take t, digest: dg, held: hd) = result.unwrap(task.join(take h))
                result.unwrap(list.push(mut tools, take t))
                acc = acc ^ dg
                if hd > held {
                    held = hd
                }
            }
        }
        if shared != 0u8 {
            result.unwrap(conn.send(svc, SvcReq(x: turn ^ seed, reply: conn.client(back))))
            acc = acc ^ result.unwrap(conn.receive(answers))
        }
        let mut rec: Bytes = result.unwrap(list.with_capacity(64))
        result.unwrap(list.put_word_le(mut rec, turn))
        result.unwrap(list.put_word_le(mut rec, acc))
        result.unwrap(list.put_word_le(mut rec, held))
        for _ in 0 .. 5u64 {
            result.unwrap(list.put_word_le(mut rec, 0u64))
        }
        result.unwrap(conn.send(commit, Commit(rec: take rec, ack: conn.client(back))))
        let _ = result.unwrap(conn.receive(answers))
        list.clear(mut small)
        result.unwrap(list.put_word_le(mut small, turn))
        result.unwrap(list.put_word_le(mut small, acc))
        result.unwrap(list.put_word_le(mut small, held))
        send_all(mut w, small)
        turns = turns + 1
    }
    turns
}

// Session units run one task per client.
type Front: cross {
    tasks: Tasks,
    nw: Net,
    clock: Clock,
    mine: u64,
    sessions: u64,
    partitions: u64,
    tool_port: u64,
    par: bool,
    ready_ack: bool,
    svc: Client[SvcReq],
    hello: Client[FrontWiring]
}

type FrontWiring: cross {
    commits: Client[Client[Commit]],
    sockets: Client[Socket]
}

// The hello, tolerating a connection the client dropped (a retried connect
// the server had already accepted): false when it never arrives whole.
fn read_hello(mut s: ReadHalf, mut buf: Bytes) -> bool waits {
    list.clear(mut buf)
    while list.len(buf) < 8 {
        let want = 8 - list.len(buf)
        match host.recv_bounded(mut s, mut buf, want, Never) {
            Ok(got) => {
                if got == 0 {
                    return false
                }
            },
            Error(_) => return false,
        }
    }
    true
}

fn front(take job: Front) -> u64 waits {
    let Front(tasks: tasks, nw: nw, clock: clock, mine: mine, sessions: sessions, partitions: partitions, tool_port: tool_port, par: par, ready_ack: ready_ack, svc: svc, hello: hello,) = take job
    // An inbox does not cross: the root sends the partitions' clients here.
    let (c, wiring): (Client[Client[Commit]], Inbox[Client[Commit]]) = result.unwrap(conn.new(partitions, bytes 0))
    let (sockets, incoming): (Client[Socket], Inbox[Socket]) = result.unwrap(conn.new(if mine == 0 { 1 } else { mine }, bytes 0))
    result.unwrap(conn.send(hello, FrontWiring(commits: take c, sockets: take sockets)))
    let _ = take hello
    let mut commits: List[Client[Commit]] = list.new()
    for _ in 0 .. partitions {
        result.unwrap(list.push(mut commits, result.unwrap(conn.receive(wiring))))
    }
    let _ = take wiring
    let per = if par {
        PAR_SESSION_BYTES
    } else {
        SESSION_BYTES
    }
    let mut jobs: List[Task[u64]] = list.new()
    let mut hello_buf: Bytes = result.unwrap(list.with_capacity(8))
    for _ in 0 .. mine {
        let s = result.unwrap(conn.receive(incoming))
        let (rh, wh) = net.split(take s)
        let mut r = take rh
        if !read_hello(mut r, mut hello_buf) {
            continue
        }
        let sid: u64 = list.word_le(hello_buf, 0)
        if sid >= sessions {
            continue
        }
        let Some(commit) = list.get(commits, sid % partitions) else {
            fail("no partition")
        }
        let one = Session(tasks: tasks, nw: nw, clock: clock, r: take r, w: take wh, sid: sid, commit: conn.client(commit), svc: conn.client(svc), tool_port: tool_port, par: par, ready_ack: ready_ack,)
        result.unwrap(list.push(mut jobs, result.unwrap(task.spawn(tasks, bytes per, take one, session))))
    }
    // Release this unit's own clients so the partitions and the service see
    // Closed once the sessions end.
    let _ = take commits
    let _ = take svc
    let mut turns = 0u64
    while let Some(take h) = list.pop(mut jobs) {
        turns = turns + result.unwrap(task.join(take h))
    }
    turns
}

fn join_all(take pending: List[Task[u64]]) -> u64 waits {
    let mut jobs = take pending
    let mut sum = 0u64
    while let Some(take h) = list.pop(mut jobs) {
        sum = sum + result.unwrap(task.join(take h))
    }
    sum
}

pub fn main(tasks: Tasks, nw: Net, clock: Clock, err: Stderr, d: Dir, argv: Args) -> Result[(), Exit] waits {
    let port = arg(argv, 0)
    let sessions = arg(argv, 1)
    if sessions == 0 {
        return Ok(())
    }
    let partitions = arg(argv, 2)
    let par = arg(argv, 3) != 0
    let tool_port = arg(argv, 4)
    let k = arg(argv, 5)
    let ready_ack = if args.len(argv) > 6 {
        arg(argv, 6) != 0
    } else {
        false
    }
    // Partitions and the service first: each session unit needs their clients.
    let (ph, ph_in): (Client[Client[Commit]], Inbox[Client[Commit]]) = result.unwrap(conn.new(partitions, bytes 0))
    let mut parts: List[Task[u64]] = list.new()
    let mut commits: List[Client[Commit]] = list.new()
    for p in 0 .. partitions {
        let job = Partition(d: d, p: p, hello: conn.client(ph))
        result.unwrap(list.push(mut parts, result.unwrap(task.spawn_unit(tasks, bytes COMMIT_BYTES, take job, partition))))
        result.unwrap(list.push(mut commits, result.unwrap(conn.receive(ph_in))))
    }
    let (sh, sh_in): (Client[Client[SvcReq]], Inbox[Client[SvcReq]]) = result.unwrap(conn.new(1, bytes 0))
    let svc_task = result.unwrap(task.spawn_unit(tasks, bytes UNIT_BYTES, Service(hello: take sh), service))
    let svc = result.unwrap(conn.receive(sh_in))
    let (fh, fh_in): (Client[FrontWiring], Inbox[FrontWiring]) = result.unwrap(conn.new(1, bytes 0))
    let per = if par {
        PAR_SESSION_BYTES
    } else {
        SESSION_BYTES
    }
    let mut fronts: List[Task[u64]] = list.new()
    let mut clients: List[Client[Socket]] = list.new()
    for u in 0 .. k {
        let mine = (sessions + k - 1 - u) / k
        let job = Front(tasks: tasks, nw: nw, clock: clock, mine: mine, sessions: sessions, partitions: partitions, tool_port: tool_port, par: par, ready_ack: ready_ack, svc: conn.client(svc), hello: conn.client(fh),)
        result.unwrap(list.push(mut fronts, result.unwrap(task.spawn_unit(tasks, bytes UNIT_BYTES + mine * per, take job, front))))
        let FrontWiring(commits: wiring, sockets: sockets) = result.unwrap(conn.receive(fh_in))
        result.unwrap(list.push(mut clients, take sockets))
        for p in 0 .. partitions {
            let Some(c) = list.get(commits, p) else {
                fail("no partition")
            }
            result.unwrap(conn.send(wiring, conn.client(c)))
        }
    }
    let (take l, _) = result.unwrap(host.listen(nw, local_addr(port), 4096))
    let mut listener = take l
    for i in 0 .. sessions {
        let (take socket, _) = result.unwrap(host.accept(mut listener, Never))
        let Some(client) = list.get(clients, i % k) else {
            fail("no session unit")
        }
        result.unwrap(conn.send(client, take socket))
    }
    let _ = take listener
    let _ = take clients
    let _ = take commits
    let _ = take svc
    let turns = join_all(take fronts)
    let groups = join_all(take parts)
    let calls = result.unwrap(task.join(take svc_task))
    let mut line = string.new()
    result.unwrap(string.push(mut line, "session turns="))
    result.unwrap(string.push_u64(mut line, turns))
    result.unwrap(string.push(mut line, " groups="))
    result.unwrap(string.push_u64(mut line, groups))
    result.unwrap(string.push(mut line, " svc="))
    result.unwrap(string.push_u64(mut line, calls))
    result.unwrap(string.push(mut line, "\n"))
    result.unwrap(stderr.write(err, line))
    Ok(())
}

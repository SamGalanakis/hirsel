fn client_initial() -> Bytes {
    option.unwrap(std.hex.decode(b""))
}

fn server_initial() -> Bytes {
    option.unwrap(std.hex.decode(b"cf000000010008f067a5502a4262b5004075c0d95a482cd0991cd25b0aac406a5816b6394100f37a1c69797554780bb38cc5a99f5ede4cf73c3ec2493a1839b3dbcba3f6ea46c5b7684df3548e7ddeb9c3bf9c73cc3f3bded74b562bfb19fb84022f8ef4cdd93795d77d06edbb7aaf2f58891850abbdca3d20398c276456cbc42158407dd074ee"))
}

fn open_initial(mut wire: Bytes, receiver: schedule.Side, number: u64) -> (codec.Header, codec.Span) {
    let mut at = 0u64
    let end = list.len(wire)
    let h = result.unwrap(codec.read_header(wire, mut at, end, 0))
    if at != end || h.kind != Initial {
        fail("RFC 9001 Initial header")
    }
    let keys = result.unwrap(schedule.quic_initial(receiver, b"\x83\x94\xc8\xf0\x3e\x51\x57\x08"))
    let mask = result.unwrap(schedule.header_mask(keys, Initial, false))
    let sample = result.unwrap(codec.sample(h))
    let mask_bytes = packet.mask(mask, wire, sample.at)
    wire[0] = wire[0] ^ (mask_bytes[0] & 0x0f)
    let pn_len: u64 = int.widen((wire[0] & 3) + 1)
    for i in 0u64 .. pn_len {
        let j = h.body.at + i
        wire[j] = wire[j] ^ mask_bytes[i + 1]
    }
    let opened = result.unwrap(codec.read_open_header(wire, h))
    if opened.number.truncated != number {
        fail("RFC 9001 Initial packet number")
    }
    let opener = result.unwrap(schedule.opener(keys, Initial))
    let len = result.unwrap(packet.open(opener, 0, number, mut wire, opened.aad.at, opened.payload.at, b""))
    (take h, codec.Span(at: opened.payload.at, len: len))
}

fn crypto_message(wire: Bytes, mut frames: codec.FrameReader, expected: u64) -> handshake.Message {
    let Some(Crypto(offset: offset, data: range)) = result.unwrap(codec.next_frame(wire, mut frames)) else {
        fail("expected a CRYPTO frame")
    }
    if offset != 0 || range.len != expected {
        fail("RFC 9001 Initial CRYPTO range")
    }
    let mut at = 0u64
    let message = result.unwrap(handshake.read_message(list.slice(wire, range.at, range.at + range.len), mut at))
    if at != expected {
        fail("whole TLS handshake message")
    }
    take message
}

fn client_vector() {
    let mut wire = client_initial()
    let (h, body) = open_initial(mut wire, Server, 2)
    let mut frames = result.unwrap(codec.frames(wire, body, Initial, 0))
    let message = crypto_message(wire, mut frames, 241)
    if message.kind != handshake.CLIENT_HELLO || body.len != 1162 || h.source.len != 0 {
        fail("RFC 9001 A.2 ClientHello envelope")
    }
    if result.unwrap(codec.next_frame(wire, mut frames)) != Some(Padding(917)) || result.unwrap(codec.next_frame(wire, mut frames)) != None {
        fail("RFC 9001 A.2 padding")
    }
    let offer = result.unwrap(handshake.read_client_hello(message.body))
    let public = option.unwrap(std.hex.decode(b"9370b2c9caa47fbabaf4559fedba753de171fa71f50f1ce15d43e994ec74d748"))
    let random_bytes = option.unwrap(std.hex.decode(b"ebf8fa56f12939b9584a3896472ec40bb863cfd3e86804fe3a47f06a2b69484c"))
    if offer.random != random_bytes || offer.name != Some(b"example.com") || list.len(offer.alpn) != 1 || offer.alpn[0] != b"alpn" || list.len(offer.suites) != 2 || offer.suites[0] != 0x1301 || offer.suites[1] != 0x1302 {
        fail("RFC 9001 A.2 ClientHello fields")
    }
    if let Some(point) = map.get(offer.shares, 29u16) {
        if point != public {
            fail("RFC 9001 A.2 X25519 share")
        }
    } else {
        fail("missing X25519 share")
    }
    let ids = handshake.PeerConnectionIds(initial_source: b"\x83\x94\xc8\xf0\x3e\x51\x57\x08", original_destination: None, retry_source: None)
    let p = result.unwrap(handshake.read_parameters(offer.parameters, Client, ids))
    if p.initial_max_data != 0x3fffffffffffffff || p.initial_max_stream_data_bidi_local != 65535 || p.initial_max_stream_data_bidi_remote != 65535 || p.initial_max_stream_data_uni != 65535 || p.initial_max_streams_bidi != 16 || p.initial_max_streams_uni != 16 || p.max_idle_ms != 30000 || p.max_udp_payload != 65527 {
        fail("RFC 9001 A.2 transport parameters")
    }
    // The appendix advertises the DCID as initial_source_connection_id, despite an empty SCID.
    let observed = handshake.PeerConnectionIds(initial_source: b"", original_destination: None, retry_source: None)
    if let Error(TransportParameterError) = handshake.read_parameters(offer.parameters, Client, observed) {} else {
        fail("RFC 9000 §7.3 SCID mismatch")
    }
}

fn server_vector() {
    let mut wire = server_initial()
    let (h, body) = open_initial(mut wire, Client, 1)
    let source = list.slice(wire, h.source.at, h.source.at + h.source.len)
    if list.compare_bytes(source, b"\xf0\x67\xa5\x50\x2a\x42\x62\xb5") != Equal {
        fail("RFC 9001 A.3 SCID")
    }
    let mut frames = result.unwrap(codec.frames(wire, body, Initial, 0))
    let Some(Ack(a)) = result.unwrap(codec.next_frame(wire, mut frames)) else {
        fail("RFC 9001 A.3 ACK")
    }
    if a.delay != 0 || list.len(a.ranges) != 1 || a.ranges[0].smallest != 0 || a.ranges[0].largest != 0 || a.ecn != None {
        fail("RFC 9001 A.3 ACK fields")
    }
    let message = crypto_message(wire, mut frames, 90)
    let hello = result.unwrap(handshake.read_server_hello(message.body))
    let public = option.unwrap(std.hex.decode(b"9d3c940d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a"))
    if message.kind != handshake.SERVER_HELLO || hello.retry || hello.public != public || result.unwrap(codec.next_frame(wire, mut frames)) != None {
        fail("RFC 9001 A.3 ServerHello")
    }
    match (hello.suite, hello.group) {
        (Aes128GcmSha256, Some(X25519)) => (),
        _ => fail("RFC 9001 A.3 suite and key share"),
    }
}

fn retry_vector() {
    let wire = option.unwrap(std.hex.decode(b"ff000000010008f067a5502a4262b5746f6b656e04a265ba2eff4d829058fb3f0f2496ba"))
    let end = list.len(wire)
    let mut at = 0u64
    let h = result.unwrap(codec.read_header(wire, mut at, end, 0))
    if h.kind != Retry || at != end || list.compare_bytes(list.slice(wire, h.token.at, h.token.at + h.token.len), b"token") != Equal {
        fail("RFC 9001 A.4 Retry header and token")
    }
    let key_bytes = option.unwrap(std.hex.decode(b"be0c690b9f66575a1d766b54e368c84e"))
    let key = result.unwrap(secret.seal(take key_bytes, "aead(aes128-gcm)"))
    let nonce = option.unwrap(std.hex.decode(b"461599d35d632bf2239825bb"))
    let mut aad = b"\x08\x83\x94\xc8\xf0\x3e\x51\x57\x08"
    list.append(mut aad, list.slice(wire, 0, end - 16))
    let mut tag: Bytes = list.with_capacity(16)
    list.append(mut tag, list.slice(wire, end - 16, end))
    let mut empty: Bytes = list.new()
    if result.unwrap(secret.aead_open(key, Aes128Gcm, nonce, aad, tag, mut empty)) != 0 {
        fail("RFC 9001 A.4 Retry integrity")
    }
    tag[0] = tag[0] ^ 1
    if let Error(Tampered) = secret.aead_open(key, Aes128Gcm, nonce, aad, tag, mut empty) {} else {
        fail("changed Retry tag was accepted")
    }
}

fn invalid_parameter_vectors() {
    let empty_ids = handshake.PeerConnectionIds(initial_source: b"", original_destination: None, retry_source: None)
    let values: Inline[Bytes, 8] =[b"\x0f\x00\x0f\x00", b"\x0f\x00\x21\x00\x40\x21\x00", b"\x0f\x00\x00\x00", b"\x0f\x00\x03\x02\x44\xaf", b"\x0f\x00\x1d\x01\x00", b"\x0f\x00\x0e\x01\x01", b"\x0f\x00\x0a\x01\x15", b"\x0f\x00\x04\x02\x01\x00"]
    for bad in values {
        if let Error(TransportParameterError) = handshake.read_parameters(bad, Client, empty_ids) {} else {
            fail("invalid or duplicate transport parameter")
        }
    }
    let retry_ids = handshake.PeerConnectionIds(initial_source: b"\xa1", original_destination: Some(b"\xa2"), retry_source: Some(b"\xa3"))
    let vectors: Inline[Bytes, 4] =[b"\x0f\x01\xa1\x00\x01\xa4\x10\x01\xa3", b"\x0f\x01\xa1\x10\x01\xa3", b"\x0f\x01\xa1\x00\x01\xa2\x10\x01\xa4", b"\x0f\x01\xa1\x00\x01\xa2"]
    for bad in vectors {
        if let Error(TransportParameterError) = handshake.read_parameters(bad, Server, retry_ids) {} else {
            fail("incorrect original or Retry connection ID")
        }
    }
    let p = result.unwrap(handshake.read_parameters(b"\x0f\x01\xa1\x00\x01\xa2\x10\x01\xa3\x1d\x00\x20\x02\x44\xb0", Server, retry_ids))
    if !p.reset_stream_at || p.max_datagram_frame != 1200 {
        fail("negotiated reset and DATAGRAM capability")
    }
}

/// bug: Misparse either published Initial or accept an invalid QUIC transport parameter.
/// oracle: RFC 9001 A.2–A.4, RFC 9000 §7.3 and §18.2, RFC 9221 §3.
@test
fn rfc9001_client_initial_parses() -> Result[(), ()] {
    client_vector()
    server_vector()
    retry_vector()
    invalid_parameter_vectors()
    Ok(())
}

// The reviewed corpus (core/tests/decoder-corpus/quic-tls.json): CRYPTO streams whose
// first TLS message is read as a ClientHello. Its expected classes, projections and
// partial steps are a Python reference's of RFC 8446 §4.1.2 over RFC 9001 A.2's hello,
// not this package's. Rows are `id class selector input projection schedules` with hex
// fields and `-` for an empty one; a schedule is `<fragment ends, big-endian u16>:<partial
// steps>`. Regenerate: tools/decoder-fuzz/fixtures.py rows quic-tls --write.
const REVIEWED_QUIC_TLS: String = "accepted-next-message-follows accepted 0   00f5:0,00f100f5:0,00f000f5:1\naccepted-no-server-name accepted 0   00dd:0,006e00dd:1\naccepted-rfc9001-a2 accepted 0   00f1:0,000100020003000400f1:4,0004006400f000f1:3\naccepted-two-protocols accepted 0   00f4:0\npartial-empty partial 0 - - 0000:1\npartial-header-only partial 0 010000ed - 0004:1,00030004:2\npartial-largest-message-header partial 0 01003ffc - 0004:1\npartial-stream-ends-early partial 0 010000ed0303ebf8fa56f12939b9584a3896472ec40bb863cfd3e86804fe3a47f06a2b69484c00000413011302010000c000000010000e00000b6578616d706c652e636f6dff01000100000a00080006001d0017001800100007000504616c706e000500 - 0064:1,00320064:2\nrefused-compression tls-alert 0  636f64653d333033 00f1:0\nrefused-crypto-buffer crypto-buffer 0 01003ffd 636f64653d3133 0004:0,00020004:1\nrefused-extensions-overrun tls-alert 0  636f64653d333036 00f0:0\nrefused-legacy-version-ssl3 tls-alert 0  636f64653d333236 00f1:0\nrefused-no-application-protocol tls-alert 0  636f64653d333736 00e6:0\nrefused-no-transport-parameters tls-alert 0  636f64653d333635 00bb:0\nrefused-server-hello other-message 0  6b696e643d32 00f1:0,007800f1:1\nrefused-session-id tls-alert 0  636f64653d3130 0111:0\nrefused-versions-tls12-only tls-alert 0  636f64653d333236 00f1:0\n"

fn reviewed_crypto_name(class: u8) -> String {
    match class {
        0u8 => "accepted",
        1u8 => "partial",
        2u8 => "tls-alert",
        3u8 => "crypto-buffer",
        4u8 => "other-message",
        _ => "law",
    }
}

fn reviewed_labelled(label: Bytes, n: u64) -> Bytes {
    let mut text = string.new()
    string.push_u64(mut text, n)
    let mut out: Bytes = list.new()
    list.append(mut out, label)
    list.append(mut out, string.as_bytes(text))
    take out
}

fn reviewed_hex(mut out: Bytes, data: Bytes) {
    list.append(mut out, string.as_bytes(std.hex.encode(data)))
}

fn reviewed_code(mut out: Bytes, code: u16) {
    let mut word: Bytes = list.with_capacity(2)
    list.put_word_be(mut word, code)
    reviewed_hex(mut out, word)
}

fn reviewed_codes(mut out: Bytes, label: Bytes, codes: List[u16]) {
    list.append(mut out, label)
    for i in 0u64 .. list.len(codes) {
        if i > 0 {
            list.push(mut out, 44)
        }
        reviewed_code(mut out, codes[i])
    }
}

fn reviewed_offer(o: handshake.ClientOffer) -> Bytes {
    let mut out: Bytes = list.new()
    list.append(mut out, b"random=")
    reviewed_hex(mut out, o.random)
    reviewed_codes(mut out, b" suites=", o.suites)
    reviewed_codes(mut out, b" groups=", o.groups)
    reviewed_codes(mut out, b" signatures=", o.signatures)
    list.append(mut out, b" shares=")
    let mut shown = 0u64
    for group in o.groups {
        if let Some(key) = map.get(o.shares, group) {
            if shown > 0 {
                list.push(mut out, 44)
            }
            shown += 1
            reviewed_code(mut out, group)
            list.push(mut out, 58)
            reviewed_hex(mut out, key)
        }
    }
    list.append(mut out, b" name=")
    match view o.name {
        Some(name) => list.append(mut out, name),
        None => list.push(mut out, 45),
    }
    list.append(mut out, b" alpn=")
    for i in 0u64 .. list.len(o.alpn) {
        if i > 0 {
            list.push(mut out, 44)
        }
        list.append(mut out, o.alpn[i])
    }
    list.append(mut out, b" parameters=")
    reviewed_hex(mut out, o.parameters)
    take out
}

fn reviewed_end(ends: Bytes, i: u64) -> u64 {
    let high: u64 = int.widen(ends[2 * i])
    let low: u64 = int.widen(ends[2 * i + 1])
    high * 256 + low
}

// The owner law of a reassembled message: it is the stream's first framed bytes, and the
// same fragments delivered last to first reassemble the same message.
fn reviewed_reassembled(raw: Bytes, ends: Bytes, wire: Bytes) -> bool {
    let n = list.len(wire)
    if n < 4 || n > list.len(raw) || wire != list.slice(raw, 0, n) {
        return false
    }
    let high: u64 = int.widen(raw[1])
    let middle: u64 = int.widen(raw[2])
    let low: u64 = int.widen(raw[3])
    if n != 4 + high * 65536 + middle * 256 + low {
        return false
    }
    let mut reader = quic.crypto_reader()
    let count = list.len(ends) / 2
    for k in 0u64 .. count {
        let i = count - 1 - k
        let from = if i == 0 {
            0u64
        } else {
            reviewed_end(ends, i - 1)
        }
        if !quic.crypto_receive(mut reader, from, list.slice(raw, from, reviewed_end(ends, i))) {
            return false
        }
    }
    match quic.crypto_message(mut reader) {
        Ok(Some(again)) => again == wire,
        _ => false,
    }
}

// One delivery of a CRYPTO stream on fresh state, a fragment per end: its class, its
// projection and the steps that left the first message partial. Class 9 is a broken
// owner law (reviewed_reassembled) or fragments that do not cover the input in order.
fn reviewed_crypto_case(raw: Bytes, ends: Bytes) -> (u8, Bytes, u64) {
    let size = list.len(raw)
    let mut reader = quic.crypto_reader()
    let mut partials = 0u64
    let mut from = 0u64
    let mut found: Option[Bytes] = None
    for i in 0u64 .. list.len(ends) / 2 {
        let stop = reviewed_end(ends, i)
        if stop < from || stop > size {
            return (9u8, b"", partials)
        }
        if let None = found {
            if !quic.crypto_receive(mut reader, from, list.slice(raw, from, stop)) {
                return (3u8, reviewed_labelled(b"code=", 0x0d), partials)
            }
            match quic.crypto_message(mut reader) {
                Ok(Some(wire)) => {
                    found = Some(wire)
                },
                Ok(None) => {
                    partials += 1
                },
                Error(code) => return (3u8, reviewed_labelled(b"code=", code), partials),
            }
        }
        from = stop
    }
    if from != size {
        return (9u8, b"", partials)
    }
    let Some(wire) = found else {
        return (1u8, b"", partials)
    }
    if !reviewed_reassembled(raw, ends, wire) {
        return (9u8, b"", partials)
    }
    let mut at = 0u64
    let message = match handshake.read_message(wire, mut at) {
        Ok(m) => m,
        Error(e) => return (2u8, reviewed_labelled(b"code=", handshake.error_code(e)), partials),
    }
    if message.kind != handshake.CLIENT_HELLO {
        return (4u8, reviewed_labelled(b"kind=", int.widen(message.kind)), partials)
    }
    match handshake.read_client_hello(message.body) {
        Ok(offer) => (0u8, reviewed_offer(offer), partials),
        Error(e) => (2u8, reviewed_labelled(b"code=", handshake.error_code(e)), partials),
    }
}

fn reviewed_field(row: String, mut at: u64) -> View[String] in row {
    let start = at
    let end = match string.find(row, start, " ") {
        Some(space) => space,
        None => string.byte_len(row),
    }
    at = end + 1
    string.slice(row, start, end)
}

fn reviewed_bytes(field: String) -> Bytes {
    if field == "-" {
        return b""
    }
    option.unwrap(std.hex.decode(string.as_bytes(field)))
}

fn reviewed_count(field: String) -> u64 {
    let digits = string.as_bytes(field)
    let mut n = 0u64
    for i in 0u64 .. list.len(digits) {
        let digit: u64 = int.widen(digits[i] - 48)
        n = n * 10 + digit
    }
    n
}

/// bug: Reassemble a fragmented CRYPTO stream into the wrong TLS message, read a published
/// ClientHello into the wrong offer, or answer a malformed one with the wrong alert.
/// oracle: core/tests/decoder-corpus/quic-tls.json, whose expected observations are a
/// Python reference's of RFC 8446 §4.1.2 and §4.2, RFC 9001 §8.1, §8.2, §8.4 and A.2 and
/// RFC 9000 §7.5. Every case runs twice per schedule, each from fresh state.
@test
fn reviewed_crypto_stream() -> Result[(), ()] {
    let data = REVIEWED_QUIC_TLS
    let mut at = 0u64
    let mut completed = 0u64
    while at < string.byte_len(data) {
        let end = option.unwrap(string.find(data, at, "\n"))
        let row = string.slice(data, at, end)
        let mut next = 0u64
        let id = reviewed_field(row, mut next)
        let class = reviewed_field(row, mut next)
        let _ = reviewed_field(row, mut next)
        let raw = reviewed_bytes(reviewed_field(row, mut next))
        let projection = reviewed_bytes(reviewed_field(row, mut next))
        let schedules = reviewed_field(row, mut next)
        let mut s = 0u64
        while s < string.byte_len(schedules) {
            let stop = match string.find(schedules, s, ",") {
                Some(comma) => comma,
                None => string.byte_len(schedules),
            }
            let colon = option.unwrap(string.find(schedules, s, ":"))
            let ends = reviewed_bytes(string.slice(schedules, s, colon))
            let partials = reviewed_count(string.slice(schedules, colon + 1, stop))
            let (first, shown, steps) = reviewed_crypto_case(raw, ends)
            let (second, replayed, again) = reviewed_crypto_case(raw, ends)
            if first != second || shown != replayed || steps != again || reviewed_crypto_name(first) != class || shown != projection || steps != partials {
                fail(string.from(id))
            }
            s = stop + 1
        }
        completed += 1
        at = end + 1
    }
    if completed != 17 {
        fail("reviewed quic-tls cases completed")
    }
    Ok(())
}

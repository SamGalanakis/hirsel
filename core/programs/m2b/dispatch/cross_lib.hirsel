pub fn len_of[F](s: StaticFn[F]) -> u64 {
    let id = code.identity(s)
    list.len(id)
}

pub fn same[F](s: StaticFn[F], want: Bytes) -> bool {
    code.identity(s) == want
}

pub fn sum_of[F](s: StaticFn[F]) -> u64 {
    let id = code.identity(s)
    let mut t: u64 = 0
    let mut i: u64 = 0
    while i < list.len(id) {
        let b: u64 = int.widen(id[i])
        t += b * (i + 1)
        i += 1
    }
    t
}

pub fn echo(b: Bytes) -> Result[Bytes, Capacity] {
    Ok(list.new())
}

pub fn mute(b: Bytes) -> Result[Bytes, Capacity] {
    Ok(list.new())
}

pub fn echo_code() -> StaticFn[fn(Bytes) -> Result[Bytes, Capacity]] {
    code.describe(echo)
}

// Hook D: a generic registration adapter may take an owned typed argument.
pub fn typed_call[A: codec, R: codec](f: StaticFn[fn(take A) -> Result[R, Capacity]], take a: A) -> Result[R, Capacity] {
    let _ = code.identity(f)
    let invoke = code.callable(f)
    invoke(take a)
}

pub fn typed_sum[A: codec, R: codec](f: StaticFn[fn(take A) -> Result[R, Capacity]]) -> u64 {
    sum_of(f)
}

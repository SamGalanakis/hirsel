// The client-visible version half of calls25 C5 and subs25 K2.
pub type State {
    last: Map[u64, u64],
    ran: Map[Bytes, u64],
    frames: List[observe.Reply],
    v: observe.Count,
    index: u64
}

pub fn state() -> State {
    State(last: map.new(), ran: map.new(), frames: list.new(), v: observe.count("V", Safety, false, false, false), index: 0u64)
}

fn version(mut s: State, conn: u64, value: u64) {
    s.v.hits += 1u64
    if let Some(previous) = map.get(s.last, conn) {
        if value < previous {
            observe.failed(mut s.v, observe.key(conn, list.new(), 0u64), s.index, s.index)
        }
    }
    map.insert(mut s.last, conn, value)
}

pub fn step(mut s: State, e: observe.Obs) {
    match e {
        Got(a) => {
            version(mut s, a.conn, a.version)
            list.push(mut s.frames, observe.own(a))
        },
        Ran(r) => map.insert(mut s.ran, observe.key(0u64, r.stream, r.p), r.version),
        Rx(w) => {
            // WIRE v2 tags 6 and 8 have their version immediately after the tag.
            if list.len(w.frame) >= 12u64 {
                let mut at = 0u64
                let tag = result.unwrap(std.codec.take_u32(w.frame, mut at))
                if tag == 6u32 || tag == 8u32 {
                    version(mut s, w.conn, result.unwrap(std.codec.take_u64(w.frame, mut at)))
                }
            }
        },
        _ => (),
    }
    s.index += 1u64
}

pub fn finish(s: State, h: observe.Header) -> List[observe.Verdict] {
    let mut v = observe.verdict(s.v, h)
    if h.has_ran {
        for a in s.frames {
            let replied = match a.outcome {
                ObsReturned(_) => true,
                _ => false
            }
            if replied {
                if let Some(ran_at) = map.get(s.ran, observe.key(0u64, a.stream, a.p)) {
                    if a.version < ran_at {
                        v = Failed(observe.Failure(clause: "V", key: observe.key(a.conn, a.stream, a.p), from: 0u64, to: s.index - 1u64))
                        break
                    }
                }
            }
        }
    }
    let mut vs: List[observe.Verdict] = list.new()
    list.push(mut vs, take v)
    vs
}

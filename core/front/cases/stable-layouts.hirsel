// expect: accept
// MEM-24 gives 1+4 logical bytes. MEM-9 packs 8+1, without padding.
type Point {
    x: u8,
    y: u32
}

@compact(u16)
type Small {
    n: u64,
    flag: bool
}

@compact(u32)
type Active = Small(u8) | Big(u64)
// expect: size Point 5
// expect: size Small 9
// expect: size Active -

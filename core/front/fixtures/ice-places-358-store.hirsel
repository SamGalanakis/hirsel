// kv-script over a memory store table (u64 -> u64).
type Fail = Usage | Unreadable | Bad(u64) | Setup | Write(WriteError)

type Op: key = Put(u64, u64) | Del(u64)

fn num(s: String) -> Option[u64] {
    if string.byte_len(s) == 0 {
        return None
    }
    for b in string.as_bytes(s) {
        if b < 0x30 || b > 0x39 {
            return None
        }
    }
    match std.int.parse_uint(s, 10) { Ok(v) => Some(v), Error(_) => None }
}

// The words of a line separated by single spaces.
fn words(line: String) -> List[String] {
    let mut ws: List[String] = list.new()
    let mut at: u64 = 0
    while let Some((w, next)) = std.string.next_split(line, at, " ") {
        let s = string.from(w)
        list.push(mut ws, take s)
        at = next
    }
    take ws
}

fn line_text(mut buf: String, s: String) {
    string.push(mut buf, s)
    string.push(mut buf, "\n")
}

fn line_num(mut buf: String, n: u64) {
    string.push_u64(mut buf, n)
    string.push(mut buf, "\n")
}

fn op_of(ws: List[String]) -> Option[Op] {
    let n = list.len(ws)
    if n == 3 && ws[0] == "put" {
        let Some(k) = num(ws[1]) else { return None }
        let Some(v) = num(ws[2]) else { return None }
        return Some(Put(k, v))
    }
    if n == 2 && ws[0] == "del" {
        let Some(k) = num(ws[1]) else { return None }
        return Some(Del(k))
    }
    None
}

fn run(out: Stdout, clock: Clock, rand: Random, d: Dir, argv: Args) -> Result[(), Fail] waits {
    if args.len(argv) != 1 {
        return Error(Usage)
    }
    let Some(path) = args.get(argv, 0) else { return Error(Usage) }
    let text = match std.file.read_string(d, path) { Ok(take s) => s, Error(_) => return Error(Unreadable) }
    let mut db = store.memory(clock, rand, store.defaults())
    match store.create_table(mut db, store.spec("kv", std.codec.key_u64(), std.codec.of_u64())) {
        Ok(_) => {},
        Error(_) => return Error(Setup)
    }
    let t = match store.table(mut db, "kv", std.codec.key_u64(), std.codec.of_u64()) {
        Ok(take t) => t,
        Error(_) => return Error(Setup)
    }
    // Parse every line first: a malformed line stops the script before any output.
    let mut lines: List[List[String]] = list.new()
    let mut at: u64 = 0
    while let Some((line, next)) = std.string.next_line(text, at) {
        let ws = words(line)
        list.push(mut lines, take ws)
        at = next
    }
    let mut i: u64 = 0
    let n = list.len(lines)
    while i < n {
        let ws = lines[i]
        let lineno = i + 1
        let ok = match list.len(ws) {
            2 => (ws[0] == "get" || ws[0] == "del" || ws[0] == "batch") && num(ws[1]) != None,
            3 => (ws[0] == "put" || ws[0] == "sum") && num(ws[1]) != None && num(ws[2]) != None,
            _ => false
        }
        if !ok {
            return Error(Bad(lineno))
        }
        if ws[0] == "batch" {
            let Some(m) = num(ws[1]) else { return Error(Bad(lineno)) }
            if m > n - i - 1 {
                return Error(Bad(lineno))
            }
            let mut j: u64 = 1
            while j <= m {
                if op_of(lines[i + j]) == None {
                    return Error(Bad(lineno + j))
                }
                j += 1
            }
            i += m + 1
        } else {
            i += 1
        }
    }
    let mut buf = string.new()
    i = 0
    while i < n {
        let ws = lines[i]
        let Some(a) = num(ws[1]) else { return Error(Bad(i + 1)) }
        if ws[0] == "put" {
            let Some(v) = num(ws[2]) else { return Error(Bad(i + 1)) }
            let w = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[(), store.Error] {
                store.put(mut tx, t, a, v)
            })
            match take w { Ok(Committed(_)) => {}, _ => return Error(Setup) }
            i += 1
        } else if ws[0] == "get" {
            let got = match store.get(store.snapshot(db), store.shape(t), a) { Ok(x) => x, Error(_) => return Error(Setup) }
            match got { Some(v) => line_num(mut buf, v), None => line_text(mut buf, "none") }
            i += 1
        } else if ws[0] == "del" {
            let w = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[bool, store.Error] {
                store.delete(mut tx, t, a)
            })
            let found = match take w { Ok(Committed(done)) => done.value, _ => return Error(Setup) }
            if found { line_text(mut buf, "deleted") } else { line_text(mut buf, "absent") }
            i += 1
        } else if ws[0] == "sum" {
            let Some(hi) = num(ws[2]) else { return Error(Bad(i + 1)) }
            let mut rows = match store.scan(store.snapshot(db), store.shape(t), Included(a), Excluded(hi)) {
                Ok(take rows) => rows,
                Error(_) => return Error(Setup)
            }
            let mut total: u64 = 0
            let mut over = false
            loop {
                match store.next(mut rows) {
                    Ok(Some((_, v))) => {
                        match int.checked_add(total, v) { Some(s) => { total = s }, None => { over = true } }
                    },
                    Ok(None) => break,
                    Error(_) => return Error(Setup)
                }
            }
            if over { line_text(mut buf, "overflow") } else { line_num(mut buf, total) }
            i += 1
        } else {
            // batch m: the next m lines in one transaction; an absent del aborts it all.
            let m = a
            let w = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[(), store.Error] {
                let mut j: u64 = 1
                while j <= m {
                    match op_of(lines[i + j]) {
                        Some(Put(k, v)) => store.put(mut tx, t, k, v)?,
                        Some(Del(k)) => {
                            if !store.delete(mut tx, t, k)? {
                                return Error(NotFound)
                            }
                        },
                        None => {}
                    }
                    j += 1
                }
                Ok(())
            })
            match take w {
                Ok(Committed(_)) => line_text(mut buf, "committed"),
                Ok(Aborted(_)) => line_text(mut buf, "aborted"),
                _ => return Error(Setup)
            }
            i += m + 1
        } else {
            i += 1
        }
    }
    let mut buf = string.new()
    i = 0
    while i < n {
        let ws = lines[i]
        let Some(a) = num(ws[1]) else { return Error(Bad(i + 1)) }
        if ws[0] == "put" {
            let Some(v) = num(ws[2]) else { return Error(Bad(i + 1)) }
            let w = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[(), store.Error] {
                store.put(mut tx, t, a, v)
            })
            match take w { Ok(Committed(_)) => {}, _ => return Error(Setup) }
            i += 1
        } else if ws[0] == "get" {
            let got = match store.get(store.snapshot(db), store.shape(t), a) { Ok(x) => x, Error(_) => return Error(Setup) }
            match got { Some(v) => line_num(mut buf, v), None => line_text(mut buf, "none") }
            i += 1
        } else if ws[0] == "del" {
            let w = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[bool, store.Error] {
                store.delete(mut tx, t, a)
            })
            let found = match take w { Ok(Committed(done)) => done.value, _ => return Error(Setup) }
            if found { line_text(mut buf, "deleted") } else { line_text(mut buf, "absent") }
            i += 1
        } else if ws[0] == "sum" {
            let Some(hi) = num(ws[2]) else { return Error(Bad(i + 1)) }
            let mut rows = match store.scan(store.snapshot(db), store.shape(t), Included(a), Excluded(hi)) {
                Ok(take rows) => rows,
                Error(_) => return Error(Setup)
            }
            let mut total: u64 = 0
            let mut over = false
            loop {
                match store.next(mut rows) {
                    Ok(Some((_, v))) => {
                        match int.checked_add(total, v) { Some(s) => { total = s }, None => { over = true } }
                    },
                    Ok(None) => break,
                    Error(_) => return Error(Setup)
                }
            }
            if over { line_text(mut buf, "overflow") } else { line_num(mut buf, total) }
            i += 1
        } else {
            // batch m: the next m lines in one transaction; an absent del aborts it all.
            let m = a
            let w = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[bool, store.Error] {
                let mut j: u64 = 1
                while j <= m {
                    match op_of(lines[i + j]) {
                        Some(Put(k, v)) => store.put(mut tx, t, k, v)?,
                        Some(Del(k)) => {
                            if !store.delete(mut tx, t, k)? {
                                return Ok(false)
                            }
                        },
                        None => {}
                    }
                    j += 1
                }
                Ok(true)
            })
            let committed = match take w { Ok(Committed(done)) => done.value, _ => return Error(Setup) }
            if committed { line_text(mut buf, "committed") } else { line_text(mut buf, "aborted") }
            i += m + 1
        }
    }
    match stdout.write(out, buf) { Ok(()) => Ok(()), Error(e) => Error(Write(e)) }
}

pub fn main(out: Stdout, clock: Clock, rand: Random, d: Dir, argv: Args) -> Result[(), Exit] waits {
    match run(out, clock, rand, d, argv) {
        Ok(()) => Ok(()),
        Error(Usage) => {
            match stdout.write(out, "usage: kv-script FILE\n") { _ => {} }
            Error(Exit(status: 2))
        },
        Error(Unreadable) => {
            match stdout.write(out, "error: cannot read file\n") { _ => {} }
            Error(Exit(status: 3))
        },
        Error(Bad(n)) => {
            let mut s = string.new()
            match string.push(mut s, "error: line ") { _ => {} }
            match string.push_u64(mut s, n) { _ => {} }
            match string.push(mut s, "\n") { _ => {} }
            match stdout.write(out, s) { _ => {} }
            Error(Exit(status: 2))
        },
        Error(_) => Error(Exit(status: 4)),
    }
}
// expect: refuse LANG-4 at 174:11

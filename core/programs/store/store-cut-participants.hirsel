pub scoped type CutChange = CutUnchanged | CutAddHead(View[pages.Head]) | CutRemoveHead(u64) | CutAddPin(View[pages.Pin], bool) | CutRemovePins(View[List[u64]]) | CutReplacePin(u64, View[pages.Pin], bool) | CutReplaceMain(View[pages.Roots], u64, u64, u32, Option[u64], Option[u64])

pub scoped type CutInput[in installed, in proposed] {
    heads: View[List[pages.Head]] in installed,
    pins: View[List[pages.Pin]] in installed,
    change: CutChange in proposed,
    record_bytes: u64,
    lease_span: Option[(u64, u64)],
    store: types.StoreKey,
    limits: types.LimitsRep,
    fence: u32,
    binding_id: u64,
    origin: Option[RestoreOrigin],
    next_branch: u32,
    next_table: u32
}

// Whether the cut drops the pin at `slot`: one of a CutRemovePins, or the
// owner-3 pin a publish removes.
fn cut_drops_pin(change: CutChange, slot: u64) -> bool {
    match change {
        CutRemovePins(slots) => list.contains(slots, slot),
        CutReplaceMain(_, _, _, _, _, dropped) => dropped == Some(slot),
        _ => false,
    }
}

fn cut_dropped_pins(change: CutChange) -> u64 {
    match change {
        CutRemovePins(slots) => list.len(slots),
        CutReplaceMain(_, _, _, _, _, Some(_)) => 1,
        _ => 0,
    }
}

// The holders a cut publishes: every head and pin with the holder delta applied.
pub fn note_held_roots(mut holders: List[HeldPage], kind: u8, owner: u64, roots: pages.Roots) {
    list.push(mut holders, HeldPage(source: HolderSource(kind, owner, 0), root: arc.share(roots.collections.root)))
    list.push(mut holders, HeldPage(source: HolderSource(kind, owner, 1), root: arc.share(roots.streams.root)))
    list.push(mut holders, HeldPage(source: HolderSource(kind, owner, 2), root: arc.share(roots.catalog.root)))
    for slot in 0u64 .. list.len(roots.keyed) {
        list.push(mut holders, HeldPage(source: HolderSource(kind, owner, int.narrow(3 + slot)), root: arc.share(roots.keyed[slot].root)))
    }
}

pub fn visit_cut_heads[T, E, in installed, in proposed](input: CutInput[in installed, in proposed], mut output: T, visit: scoped fn(mut T, pages.Head, pages.Roots, u64, u64) -> Result[(), E]) -> Result[(), E] {
    let removed: Option[u64] = match input.change {
        CutRemoveHead(slot) => Some(slot),
        CutReplaceMain(_, _, _, _, slot, _) => slot,
        _ => None,
    }
    for slot in 0u64 .. list.len(input.heads) {
        if removed == Some(slot) {
            continue
        }
        let head = input.heads[slot]
        if slot == 0 {
            if let CutReplaceMain(roots, head_version, at, _, _, _) = input.change {
                visit(mut output, head, roots, head_version, at)?
                continue
            }
        }
        visit(mut output, head, head.roots, head.head, head.at)?
    }
    if let CutAddHead(added) = input.change {
        visit(mut output, added, added.roots, added.head, added.at)?
    }
    Ok(())
}

pub fn visit_cut_pins[T, E, in installed, in proposed](input: CutInput[in installed, in proposed], mut output: T, visit: scoped fn(mut T, pages.Pin) -> Result[(), E]) -> Result[(), E] {
    let mut inserted = false
    for slot in 0u64 .. list.len(input.pins) {
        if cut_drops_pin(input.change, slot) {
            continue
        }
        if let CutReplacePin(at, replacement, _) = input.change {
            if at == slot {
                visit(mut output, replacement)?
                continue
            }
        }
        let held = input.pins[slot]
        if !inserted {
            if let CutAddPin(added, _) = input.change {
                if pin_order(added.name, added.owner, held.name, held.owner) == Less {
                    visit(mut output, added)?
                    inserted = true
                }
            }
        }
        visit(mut output, held)?
    }
    if !inserted {
        if let CutAddPin(added, _) = input.change {
            visit(mut output, added)?
        }
    }
    Ok(())
}

pub type CutParticipants {
    holders: List[HeldPage],
    roots: List[pages.Roots],
    // Each root's branch, for the rows a fold hands to `deferred_frees`.
    branches: List[u32],
    // The first `heads` roots are branch heads; the rest are pins.
    heads: u64,
    // The root a historical pin or a cut-path fork adds, which the Tiered
    // stage promotes (§13.5 step 2).
    promote: Option[u64]
}

pub fn cut_participants[in installed, in proposed](input: CutInput[in installed, in proposed]) -> Result[CutParticipants, types.Failure] {
    let n = list.len(input.heads) + list.len(input.pins) + 1
    let mut participants = CutParticipants(holders: list.with_capacity(3 * n), roots: list.with_capacity(n), branches: list.with_capacity(n), heads: 0, promote: None)
    visit_cut_heads(input, mut participants, scoped fn(mut current: CutParticipants, head: pages.Head, roots: pages.Roots, head_version: u64, at: u64) -> Result[(), types.Failure] {
        // A cut adds a head only for a fork of a Snapshot that is not the
        // live head; `fork_live` journals the other forks.
        if let CutAddHead(added) = input.change {
            if added.id == head.id {
                current.promote = Some(list.len(current.roots))
            }
        }
        note_held_roots(mut current.holders, 0, int.widen(head.id), roots)
        list.push(mut current.roots, pages.share_roots(roots))
        list.push(mut current.branches, head.id)
        current.heads += 1
        Ok(())
    })?
    visit_cut_pins(input, mut participants, scoped fn(mut current: CutParticipants, held: pages.Pin) -> Result[(), types.Failure] {
        let added = match input.change {
            CutAddPin(pinned_now, promotes) => promotes && pinned_now.serial == held.serial,
            CutReplacePin(_, pinned_now, promotes) => promotes && pinned_now.serial == held.serial,
            _ => false,
        }
        if added {
            current.promote = Some(list.len(current.roots))
        }
        note_held_roots(mut current.holders, 1, held.serial, held.roots)
        list.push(mut current.roots, pages.share_roots(held.roots))
        list.push(mut current.branches, held.branch)
        Ok(())
    })?
    Ok(take participants)
}

// AP16 item 9's MANIFEST. Each branch and pin names the root the cut
// published for it: `published` holds the participants' roots in
// `cut_participants` order, sealed or folded by the Tiered stage.
pub fn fill_cut_manifest[in installed, in proposed](mut raw: Bytes, input: CutInput[in installed, in proposed], published: List[pages.Roots], generation: u64, seq: u64, prev_first: u64, layout: PagedCutLayout, next_stamp: u64, account: u64, account_tiered: u64, write_seal: scoped fn(mut Bytes, format.DiskContext, u32) -> Result[(), types.Failure] waits) -> Result[(), types.Failure] waits {
    let tables = match input.change {
        CutReplaceMain(_, _, _, tables, _, _) => tables,
        _ => input.next_table
    }
    let main_transition = match input.change {
        CutReplaceMain(_, _, _, _, _, _) => true,
        _ => false,
    }
    let manifest = PageManifest(generation: generation, fence: input.fence, inline: input.heads[0u64].roots.collections.inline, limits: input.limits, next_stamp: next_stamp, next_branch: input.next_branch, next_table: tables, next_pack: layout.lists.run_packs.next_pack, first_live: seq, prev_first: prev_first, account_memory: account, account_tiered: account_tiered, lineage: published_tree_pointer(layout.locations, layout.lists.roots.lineage), deferred_frees: published_tree_pointer(layout.locations, layout.lists.roots.deferred), deferred_next: layout.lists.roots.deferred_next, binding_id: input.binding_id, main_transition, origin: input.origin, sweep: SweepCursor(position: 0, epoch: 0, digest: 0), pack_root: published_tree_pointer(layout.locations, layout.lists.roots.packs), branches: list.new(), pins: list.new())
    let context = format.DiskContext(store: input.store, role: 1, seq: generation)
    begin_page_manifest_file(mut raw, context)?
    append_page_manifest_fields(mut raw, manifest)?
    let heads = list.len(input.heads)
    let branch_count = match input.change {
        CutAddHead(_) => heads + 1,
        CutRemoveHead(_) => heads - 1,
        CutReplaceMain(_, _, _, _, Some(_), _) => heads - 1,
        _ => heads,
    }
    types.capacity(format.le(mut raw, branch_count, 4))?
    let mut slot = 0u64
    visit_cut_heads(input, mut raw, scoped fn(mut buffer: Bytes, head: pages.Head, _roots: pages.Roots, head_version: u64, at: u64) -> Result[(), types.Failure] {
        slot += 1
        append_page_manifest_branch(mut buffer, head.id, head.name, head.parent, head.forked_at, head_version, at, published_page_roots(layout.locations, published[slot - 1]), head.id == 0 && main_transition)
    })?
    let pins = list.len(input.pins)
    let pin_count = match input.change {
        CutAddPin(_, _) => pins + 1,
        _ => pins - cut_dropped_pins(input.change),
    }
    types.capacity(format.le(mut raw, pin_count, 4))?
    visit_cut_pins(input, mut raw, scoped fn(mut buffer: Bytes, held: pages.Pin) -> Result[(), types.Failure] {
        slot += 1
        append_page_manifest_pin(mut buffer, held.owner, held.name, held.branch, held.version, published_page_roots(layout.locations, published[slot - 1]), held.watermark)
    })?
    for order_slot in 0u64 .. list.len(published) {
        let keyed = view published[order_slot].keyed
        if list.len(keyed) != 0 {
            types.capacity(format.le(mut raw, order_slot, 4))?
            for tree in keyed {
                put_page_ptr(mut raw, published_page_pointer(layout.locations, tree))
            }
        }
    }
    write_seal(mut raw, context, input.fence)?
    append_restore_origin(mut raw, context, input.origin)
}

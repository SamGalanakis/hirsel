// The tail (STORE-SPEC §1.14 "The tail", Store 2.3): the rows of a
// projector's source that differ between the projector's published position
// and a transaction's own view, the transaction's staged writes included.
// It is the difference of two roots of the store's own tree, the projector's
// pin and the Tx's, so nothing else records what changed (D9). A form B
// reader reads the generations `live` names, masks the tail's keys out of
// them and scores the tail's rows from the rows themselves.
// A projector pin's root, as every Snapshot and Tx carries it. The store
// rebuilds the list whenever a pin changes, so a Snapshot's list names the
// pins of its own moment, and each pin's slot matches the projection row at
// that Snapshot's roots (§1.14 "Why a crash cannot split a step").
pub type TailBase: shareable + send {
    name: String,
    branch: u32,
    version: u64,
    roots: Roots
}

// None while no projector pin exists, so a store without projectors
// allocates nothing for them (its genesis writer state is unchanged, §1.1).
pub type TailBases = Option[Arc[List[TailBase]]]

pub fn no_tail_bases() -> TailBases {
    None
}

pub fn share_tail_bases(bases: TailBases) -> TailBases {
    match bases {
        Some(held) => Some(arc.share(held)),
        None => None,
    }
}

pub fn tail_bases(pins: List[Pin]) -> TailBases {
    let mut out: List[TailBase] = list.new()
    for held in pins {
        if held.owner == ProjectorPin {
            list.push(mut out, TailBase(name: clone(held.name), branch: held.branch, version: held.version, roots: share_roots(held.roots)))
        }
    }
    if list.len(out) == 0 {
        return None
    }
    Some(arc.new(take out))
}

pub fn tail_base(bases: List[TailBase], name: String, image_slot: u8, position: u64, on_branch: u32) -> Option[u64] {
    let wanted = projector_pin_name(name, image_slot)
    for k in 0u64 .. list.len(bases) {
        let held = view bases[k]
        if same_name(held.name, wanted) && held.branch == on_branch && held.version == position {
            return Some(k)
        }
    }
    None
}

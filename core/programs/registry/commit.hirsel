// Registry §4 bucket sequencer: 6-step commit & recovery protocol, uncertain-PUT
// readback, helper completion, quiet-log heartbeat, and takedown deletion markers.
pub type Error: send = InvalidInput | LabelConflict | EnrollmentConflict | StaleGeneration | Unauthorized | UnknownRoot | PredecessorConflict | TerminalStatus | TakenDown | NeedsReadmission | IntegrityFailure | WitnessFork | WitnessFailed | Uncertain | Interrupted | Storage(std.object.Error) | Checkpoint(checkpoint.CheckpointError)

pub type StepPoint: key + send = AfterAdmit | AfterScopeEvidence | AfterScopeReserve | AfterLabelReserve | AfterBlobPut | AfterPending | AfterTilePut | AfterWitnessReply(u64) | AfterHistoricalHead | BeforeCheckpointCas | AfterCheckpointCasBeforeReply | AfterTakedownStatusBeforeMarker

pub type FrameInput: send {
    root: String,
    compressed: Bytes,
}

pub type EvidenceInput: send {
    digest: String,
    data: Bytes,
}

pub type PublishRequest: send {
    scope: String,
    identity: String,
    version: String,
    root: String,
    generation: u64,
    signer: String,
    intent_digest: String,
    scope_bind_entry: Option[Bytes],
    scope_bind_evidence: List[EvidenceInput],
    release_entry: Bytes,
    frames: List[FrameInput],
    evidence: List[EvidenceInput],
}

pub type RebindRequest: send {
    scope: String,
    old_generation: u64,
    signer: String,
    intent_digest: String,
    rebind_entry: Bytes,
    evidence: List[EvidenceInput],
}

pub type StatusRequest: send {
    scope: String,
    root: String,
    previous_event: Option[String],
    authority: registry_auth.StatusAuthority,
    intent_digest: String,
    captured_status_parent: u64,
    captured_status_root: tlog.Hash,
    status_entry: Bytes,
    evidence: List[EvidenceInput],
}

pub type Receipt: send {
    origin: String,
    leaf_index: u64,
    head_size: u64,
    root: Option[String],
    checkpoint_wire: String,
}

pub type LogState: send {
    cfg: checkpoint.LogConfig,
    log: tlog.Log,
    witness_sizes: List[u64],
}

pub fn log_index(kind: checkpoint.LogKind) -> u64 {
    match kind {
        Release => 0,
        Status => 1,
    }
}

pub type Sequencer: send {
    logs: List[LogState],
    registry_origin: String,
    legal_key: Bytes,
    scopes: Map[String, pending.ScopeRecord],
    labels: Map[String, pending.ReleaseRecord],
    releases_by_root: Map[String, pending.ReleaseRecord],
    release_by_intent: Map[String, (u64, u64, Option[String])],
    statuses: Map[String, pending.RootStatus],
    status_by_intent: Map[String, (u64, u64, String)],
}

pub fn new(take release_cfg: checkpoint.LogConfig, take status_cfg: checkpoint.LogConfig, take registry_origin: String, take legal_key: Bytes) -> Sequencer {
    let mut logs: List[LogState] = list.with_capacity(2)
    list.push(mut logs, LogState(cfg: take release_cfg, log: tlog.empty(), witness_sizes: list.new()))
    list.push(mut logs, LogState(cfg: take status_cfg, log: tlog.empty(), witness_sizes: list.new()))
    Sequencer(logs: take logs, registry_origin: take registry_origin, legal_key: take legal_key, scopes: map.new(), labels: map.new(), releases_by_root: map.new(), release_by_intent: map.new(), statuses: map.new(), status_by_intent: map.new())
}

pub fn scope_state(seq: Sequencer, scope: String) -> Option[pending.ScopeRecord] {
    match map.get(seq.scopes, scope) {
        Some(rec) => Some(clone(rec)),
        None => None,
    }
}

pub fn release_for_root(seq: Sequencer, root: String) -> Option[pending.ReleaseRecord] {
    match map.get(seq.releases_by_root, root) {
        Some(rec) => Some(clone(rec)),
        None => None,
    }
}

pub fn root_status(seq: Sequencer, root: String) -> Option[pending.RootStatus] {
    match map.get(seq.statuses, root) {
        Some(st) => Some(clone(st)),
        None => None,
    }
}

pub fn lookup_takedown(seq: Sequencer, root: String) -> Option[(String, String)] {
    if let Some(st) = map.get(seq.statuses, root) {
        if let TakenDown(reason, message) = view st.state {
            return Some((string.from(reason), string.from(message)))
        }
    }
    None
}

fn prefix_key(prefix: String, tail: String) -> String {
    let mut out = string.from(prefix)
    string.push(mut out, tail)
    take out
}

fn frame_bucket_key(root: String) -> String {
    let mut out = string.from("c/")
    string.push(mut out, root)
    string.push(mut out, ".zst")
    take out
}

fn has_subject(subjects: List[String], signer: String) -> bool {
    for s in subjects {
        if s == signer {
            return true
        }
    }
    false
}

fn map_cp_err(take e: checkpoint.CheckpointError) -> Error {
    match take e {
        Uncertain => Uncertain,
        IntegrityFailure => IntegrityFailure,
        WitnessFailed => WitnessFailed,
        Interrupted => Interrupted,
        Storage(se) => Storage(se),
        other => Checkpoint(other),
    }
}

fn stage_entry(mut delta: pending.Fold, seq: Sequencer, kind: checkpoint.LogKind, index: u64, head_size: u64, raw: Bytes) -> Result[(), Error] {
    let folded = match kind {
        Release => pending.fold_release(mut delta, seq.scopes, seq.labels, index, head_size, raw),
        Status => pending.fold_status(mut delta, seq.statuses, index, head_size, raw),
    }
    match folded {
        Ok(()) => Ok(()),
        Error(_) => Error(IntegrityFailure),
    }
}

fn take_log(mut seq: Sequencer, kind: checkpoint.LogKind) -> tlog.Log {
    replace(mut seq.logs[log_index(kind)].log, tlog.empty())
}

fn restore_log(mut seq: Sequencer, kind: checkpoint.LogKind, take log: tlog.Log) {
    seq.logs[log_index(kind)].log = take log
}

fn sync_one_log(mut seq: Sequencer, mut client: std.object.Client, kind: checkpoint.LogKind, deadline_ns: u64) -> Result[Option[checkpoint.CurrentCheckpoint], Error] waits {
    let current_opt = checkpoint.read_checkpoint(mut client, seq.logs[log_index(kind)].cfg, deadline_ns)
    let current = match take current_opt {
        Ok(Some(take c)) => take c,
        Ok(None) => return Ok(None),
        Error(take e) => return Error(map_cp_err(take e)),
    }
    let target_size = tlog.note.tree_size(current.head)
    let target_root = tlog.note.tree_root(current.head)
    let local_size = tlog.size(seq.logs[log_index(kind)].log)
    if target_size < local_size {
        return Error(IntegrityFailure)
    }
    if target_size == local_size {
        let local_root = option.unwrap(tlog.root_at(seq.logs[log_index(kind)].log, local_size))
        if local_root != target_root {
            return Error(IntegrityFailure)
        }
        return Ok(Some(take current))
    }
    let added = match checkpoint.fetch_missing_entries(mut client, kind, local_size, target_size, deadline_ns) {
        Ok(take list_e) => take list_e,
        Error(take e) => return Error(map_cp_err(take e)),
    }
    let mut cand = take_log(mut seq, kind)
    let staged = stage_replay(seq, mut client, kind, mut cand, added, target_size, target_root, deadline_ns)
    match take staged {
        Ok(take delta) => pending.apply_fold(mut seq, take delta),
        Error(take e) => {
            tlog.truncate(mut cand, local_size)
            restore_log(mut seq, kind, take cand)
            return Error(take e)
        },
    }
    restore_log(mut seq, kind, take cand)
    Ok(Some(take current))
}

fn stage_replay(seq: Sequencer, mut client: std.object.Client, kind: checkpoint.LogKind, mut cand: tlog.Log, added: List[Bytes], target: u64, root: tlog.Hash, deadline_ns: u64) -> Result[pending.Fold, Error] waits {
    let start = tlog.size(cand)
    let mut delta = pending.empty_fold()
    let cfg = view seq.logs[log_index(kind)].cfg
    while tlog.size(cand) < target {
        let n = tlog.size(cand)
        let proposal = match checkpoint.read_pending(mut client, cfg, n, option.unwrap(tlog.root_at(cand, n)), deadline_ns) {
            Ok(Some(take p)) => take p,
            Ok(None) => return Error(IntegrityFailure),
            Error(take e) => return Error(map_cp_err(take e)),
        }
        let count = list.len(proposal.entries)
        if count == 0 || count > target - n {
            return Error(IntegrityFailure)
        }
        let end = n + count
        for e in proposal.entries {
            let index = tlog.size(cand)
            if e != added[index - start] {
                return Error(IntegrityFailure)
            }
            stage_entry(mut delta, seq, kind, index, end, e)?
            if let Error(_) = tlog.append(mut cand, clone(e)) {
                return Error(IntegrityFailure)
            }
        }
    }
    if tlog.root_at(cand, target) != Some(root) {
        return Error(IntegrityFailure)
    }
    Ok(take delta)
}

pub fn sync_release(mut seq: Sequencer, mut client: std.object.Client, deadline_ns: u64) -> Result[Option[checkpoint.CurrentCheckpoint], Error] waits {
    sync_one_log(mut seq, mut client, Release, deadline_ns)
}

pub fn sync_status(mut seq: Sequencer, mut client: std.object.Client, deadline_ns: u64) -> Result[Option[checkpoint.CurrentCheckpoint], Error] waits {
    sync_one_log(mut seq, mut client, Status, deadline_ns)
}

fn genesis_for_log(mut client: std.object.Client, mut state: LogState, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[checkpoint.CurrentCheckpoint, checkpoint.CheckpointError] waits {
    checkpoint.init_genesis(mut client, state.cfg, mut state.witness_sizes, random, deadline_ns, now_seconds, post)
}

/// Initializes genesis checkpoints for both release and status logs.
pub fn init_genesis(mut seq: Sequencer, mut client: std.object.Client, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(checkpoint.LogKind, u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[(), Error] waits {
    for idx in 0u64 .. list.len(seq.logs) {
        let kind = seq.logs[idx].cfg.kind
        let _ = result.map_err(genesis_for_log(mut client, mut seq.logs[idx], random, deadline_ns, now_seconds, scoped fn(i: u64, p: String, b: String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits {
            post_witness(kind, i, p, b)
        }), map_cp_err)?
    }
    let _ = sync_release(mut seq, mut client, deadline_ns)?
    let _ = sync_status(mut seq, mut client, deadline_ns)?
    Ok(())
}

fn validate_evidence(items: List[EvidenceInput]) -> Result[(), Error] {
    for ev in items {
        if !pending.lower_hex(ev.digest, 64) || pending.sha256_hex(ev.data) != ev.digest {
            return Error(InvalidInput)
        }
    }
    Ok(())
}

fn store_evidence_list(mut client: std.object.Client, items: List[EvidenceInput], deadline_ns: u64) -> Result[(), Error] waits {
    for ev in items {
        let key = prefix_key("e/", ev.digest)
        match checkpoint.put_no_clobber_readback(mut client, key, ev.data, order.max(list.len(ev.data), 1048576u64), deadline_ns) {
            Ok(CreatedNew) => (),
            Ok(ExistedBytes(existing)) => {
                if existing != ev.data {
                    return Error(IntegrityFailure)
                }
            },
            Error(take e) => return Error(map_cp_err(take e)),
        }
    }
    Ok(())
}

type FinishOutcome = CommittedBatch(checkpoint.CurrentCheckpoint) | AdvancedElsewhere

fn finish_winning_batch(mut seq: Sequencer, mut client: std.object.Client, kind: checkpoint.LogKind, take parent_in: checkpoint.CurrentCheckpoint, entries: List[Bytes], random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, on_step: scoped fn(StepPoint) -> Result[(), Error]) -> Result[FinishOutcome, Error] waits {
    let old_size = tlog.note.tree_size(parent_in.head)
    let new_size = old_size + list.len(entries)
    let mut delta = pending.empty_fold()
    for i in 0u64 .. list.len(entries) {
        stage_entry(mut delta, seq, kind, old_size + i, new_size, entries[i])?
    }
    let published = publish_staged(mut client, mut seq.logs[log_index(kind)], take parent_in, entries, random, deadline_ns, now_seconds, post_witness, on_step)
    if let Ok(CommittedBatch(_)) = view published {
        pending.apply_fold(mut seq, take delta)
    } else {
        tlog.truncate(mut seq.logs[log_index(kind)].log, old_size)
    }
    if let Ok(CommittedBatch(_)) = view published {
        on_step(AfterCheckpointCasBeforeReply)?
    }
    if let Ok(AdvancedElsewhere) = view published {
        let _ = sync_one_log(mut seq, mut client, kind, deadline_ns)?
    }
    take published
}

fn witness_for_log(mut state: LogState, size: u64, root: tlog.Hash, random: Random, now_seconds: scoped fn() -> u64, post: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, reply: scoped fn(u64) -> Result[(), checkpoint.CheckpointError]) -> Result[tlog.note.SignedHead, checkpoint.CheckpointError] waits {
    checkpoint.witness_candidate(state.cfg, state.log, size, root, mut state.witness_sizes, random, now_seconds, post, reply)
}

fn witnessed_batch(mut client: std.object.Client, mut state: LogState, old_size: u64, new_size: u64, new_root: tlog.Hash, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, reply: scoped fn(u64) -> Result[(), checkpoint.CheckpointError]) -> Result[Option[tlog.note.SignedHead], Error] waits {
    match witness_for_log(mut state, new_size, new_root, random, now_seconds, post, reply) {
        Ok(take h) => Ok(Some(take h)),
        Error(WitnessAhead(_)) => {
            let Some(cur) = result.map_err(checkpoint.read_checkpoint(mut client, state.cfg, deadline_ns), map_cp_err)? else {
                return Error(WitnessFork)
            }
            if tlog.note.tree_size(cur.head) > old_size {
                return Ok(None)
            }
            // This caller is already helping the immutable winner at old_size.
            Error(WitnessFork)
        },
        Error(take e) => Error(map_cp_err(take e)),
    }
}

fn publish_staged(mut client: std.object.Client, mut state: LogState, take parent_in: checkpoint.CurrentCheckpoint, entries: List[Bytes], random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, on_step: scoped fn(StepPoint) -> Result[(), Error]) -> Result[FinishOutcome, Error] waits {
    let mut parent = take parent_in
    let old_size = tlog.note.tree_size(parent.head)
    for e in entries {
        if let Error(_) = tlog.append(mut state.log, clone(e)) {
            return Error(IntegrityFailure)
        }
    }
    let new_size = tlog.size(state.log)
    let Some(new_root) = tlog.root_at(state.log, new_size) else {
        return Error(IntegrityFailure)
    }
    match checkpoint.materialize_tiles(mut client, state.cfg.kind, state.log, old_size, new_size, deadline_ns, scoped fn() -> Result[(), checkpoint.CheckpointError] {
        match on_step(AfterTilePut) {
            Ok(()) => Ok(()),
            Error(_) => Error(Interrupted),
        }
    }) {
        Ok(()) => (),
        Error(take e) => return Error(map_cp_err(take e)),
    }
    let observed = witnessed_batch(mut client, mut state, old_size, new_size, new_root, random, deadline_ns, now_seconds, post_witness, scoped fn(idx: u64) -> Result[(), checkpoint.CheckpointError] {
        match on_step(AfterWitnessReply(idx)) {
            Ok(()) => Ok(()),
            Error(_) => Error(Interrupted),
        }
    })?
    let mut witnessed = match take observed {
        Some(take h) => take h,
        None => return Ok(AdvancedElsewhere),
    }
    result.map_err(checkpoint.write_historical_head(mut client, state.cfg, witnessed, deadline_ns), map_cp_err)?
    on_step(AfterHistoricalHead)?
    let cp_key = checkpoint.checkpoint_key(state.cfg.kind)
    let mut cas_tries: u64 = 0
    while cas_tries < 16 {
        cas_tries += 1
        on_step(BeforeCheckpointCas)?
        let wire = string.from(tlog.note.envelope(witnessed))
        let (res, _) = std.object.store_if(mut client, cp_key, Match(parent.etag), string.into_bytes(clone(wire)), deadline_ns)
        let need_reconcile = match take res {
            Ok(Applied(meta)) => {
                return Ok(CommittedBatch(checkpoint.CurrentCheckpoint(head: take witnessed, etag: meta.etag, wire: take wire)))
            },
            Ok(Mismatch) => true,
            Error(e) => {
                if checkpoint.is_uncertain_object_err(e) {
                    true
                } else {
                    return Error(Storage(e))
                }
            },
        }
        if need_reconcile {
            let cur_opt = checkpoint.read_checkpoint(mut client, state.cfg, deadline_ns)
            let cur = match take cur_opt {
                Ok(Some(take c)) => take c,
                _ => return Error(Uncertain),
            }
            let cur_size = tlog.note.tree_size(cur.head)
            let cur_root = tlog.note.tree_root(cur.head)
            if cur_size < old_size {
                return Error(IntegrityFailure)
            }
            if cur_size == old_size {
                if cur_root != tlog.note.tree_root(parent.head) {
                    return Error(IntegrityFailure)
                }
                if !checkpoint.cosignatures_fresh(state.cfg, witnessed, now_seconds()) {
                    witnessed = match witnessed_batch(mut client, mut state, old_size, new_size, new_root, random, deadline_ns, now_seconds, post_witness, scoped fn(_idx: u64) -> Result[(), checkpoint.CheckpointError] {
                        Ok(())
                    })? {
                        Some(take h) => take h,
                        None => return Ok(AdvancedElsewhere),
                    }
                }
                parent = take cur
            } else {
                return Ok(AdvancedElsewhere)
            }
        }
    }
    Error(Uncertain)
}

fn propose_and_finish(mut seq: Sequencer, mut client: std.object.Client, kind: checkpoint.LogKind, take parent: checkpoint.CurrentCheckpoint, take my_batch: List[Bytes], random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, on_step: scoped fn(StepPoint) -> Result[(), Error]) -> Result[FinishOutcome, Error] waits {
    let n = tlog.note.tree_size(parent.head)
    let parent_hash_hex = pending.hash_to_hex(tlog.note.tree_root(parent.head))
    let origin = string.from(seq.logs[log_index(kind)].cfg.origin)
    let Ok(proposal_bytes) = pending.encode_proposal(origin, n, parent_hash_hex, my_batch) else {
        return Error(InvalidInput)
    }
    let pkey = checkpoint.pending_key(kind, n)
    let winner_entries = match checkpoint.put_no_clobber_readback(mut client, pkey, proposal_bytes, 1048576, deadline_ns) {
        Ok(CreatedNew) => {
            on_step(AfterPending)?
            take my_batch
        },
        Ok(ExistedBytes(existing_raw)) => {
            let Ok(take prop) = pending.decode_proposal(existing_raw) else {
                return Error(IntegrityFailure)
            }
            let pending.Proposal(origin: p_orig, parent_size: p_size, parent_hash: p_hash, entries: take p_entries) = take prop
            if p_orig != origin || p_size != n || p_hash != parent_hash_hex {
                return Error(IntegrityFailure)
            }
            take p_entries
        },
        Error(take e) => return Error(map_cp_err(take e)),
    }
    finish_winning_batch(mut seq, mut client, kind, take parent, winner_entries, random, deadline_ns, now_seconds, post_witness, on_step)
}

fn check_release_included(seq: Sequencer, identity: String, version: String, root: String, checkpoint_wire: String) -> Result[Option[Receipt], Error] {
    let lkey = pending.label_key_str(identity, version)
    if let Some(rec) = map.get(seq.labels, lkey) {
        if rec.root != root {
            return Error(LabelConflict)
        }
        return Ok(Some(Receipt(origin: string.from(seq.logs[0u64].cfg.origin), leaf_index: rec.leaf_index, head_size: rec.head_size, root: Some(string.from(rec.root)), checkpoint_wire: string.from(checkpoint_wire))))
    }
    Ok(None)
}

fn check_intent_included(seq: Sequencer, intent_digest: String, checkpoint_wire: String) -> Option[Receipt] {
    if let Some((leaf_index, head_size, root_opt)) = map.get(seq.release_by_intent, intent_digest) {
        return Some(Receipt(origin: string.from(seq.logs[0u64].cfg.origin), leaf_index: leaf_index, head_size: head_size, root: clone(root_opt), checkpoint_wire: string.from(checkpoint_wire)))
    }
    None
}

fn check_status_included(seq: Sequencer, intent_digest: String, prev: Option[String], checkpoint_wire: String) -> Option[Receipt] {
    let skey = pending.status_intent_key(intent_digest, prev)
    if let Some((leaf_index, head_size, root)) = map.get(seq.status_by_intent, skey) {
        return Some(Receipt(origin: string.from(seq.logs[1u64].cfg.origin), leaf_index: leaf_index, head_size: head_size, root: Some(string.from(root)), checkpoint_wire: string.from(checkpoint_wire)))
    }
    None
}

/// Full 6-step publication commit with optional G14 step interruption hook and parent-advance recheck.
pub fn commit_publish_with_hook(mut seq: Sequencer, mut client: std.object.Client, req: PublishRequest, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, recheck: scoped fn(u64) -> Result[(), Error], on_step: scoped fn(StepPoint) -> Result[(), Error]) -> Result[Receipt, Error] waits {
    let Ok(Release(rel_fields)) = pending.decode_release_entry(req.release_entry) else {
        return Error(InvalidInput)
    }
    let expected_gen = order.max(req.generation, 1u64)
    if rel_fields.generation != expected_gen || rel_fields.identity != req.identity || rel_fields.version != req.version || rel_fields.root != req.root || rel_fields.auth.subject != req.signer || rel_fields.auth.intent_digest != req.intent_digest {
        return Error(InvalidInput)
    }
    if pending.scope_of_identity(req.identity) != Some(string.from(req.scope)) {
        return Error(InvalidInput)
    }
    let mut has_head = false
    for f in req.frames {
        has_head = has_head || f.root == req.root
        if let Error(_) = pending.verify_zstd_frame(f.compressed, f.root, pending.MAX_COMPRESSED_FRAME, pending.MAX_EXPANDED_FRAME) {
            return Error(InvalidInput)
        }
    }
    if !has_head {
        return Error(InvalidInput)
    }
    validate_evidence(req.scope_bind_evidence)?
    validate_evidence(req.evidence)?
    let Some(initial_parent) = sync_release(mut seq, mut client, deadline_ns)? else {
        return Error(IntegrityFailure)
    }
    let _ = sync_status(mut seq, mut client, deadline_ns)?
    if let Some(take receipt) = check_release_included(seq, req.identity, req.version, req.root, initial_parent.wire)? {
        return Ok(take receipt)
    }
    if let Some(_) = lookup_takedown(seq, req.root) {
        return Error(TakenDown)
    }
    if let Some(scope_rec) = map.get(seq.scopes, req.scope) {
        if req.generation == 0 || req.scope_bind_entry != None {
            return Error(EnrollmentConflict)
        }
        if scope_rec.generation != req.generation {
            return Error(StaleGeneration)
        }
        if !has_subject(scope_rec.subjects, req.signer) {
            return Error(Unauthorized)
        }
    } else {
        if req.generation != 0 {
            return Error(StaleGeneration)
        }
        let Some(sb) = view req.scope_bind_entry else {
            return Error(EnrollmentConflict)
        }
        let Ok(ScopeBind(sb_scope, _, sb_subjects, _, _, _)) = pending.decode_release_entry(sb) else {
            return Error(InvalidInput)
        }
        if sb_scope != req.scope || !has_subject(sb_subjects, req.signer) {
            return Error(Unauthorized)
        }
    }
    on_step(AfterAdmit)?
    let mut saved_scope_bind: Option[Bytes] = None
    if req.generation == 0 {
        let Some(sb_bytes) = view req.scope_bind_entry else {
            return Error(EnrollmentConflict)
        }
        let Ok(ScopeBind(_, req_subjects_json, _, _, _, _)) = pending.decode_release_entry(sb_bytes) else {
            return Error(InvalidInput)
        }
        store_evidence_list(mut client, req.scope_bind_evidence, deadline_ns)?
        on_step(AfterScopeEvidence)?
        let skey = prefix_key("s/", req.scope)
        match checkpoint.put_no_clobber_readback(mut client, skey, sb_bytes, pending.MAX_ENTRY_BYTES, deadline_ns) {
            Ok(CreatedNew) => {
                saved_scope_bind = Some(clone(sb_bytes))
            },
            Ok(ExistedBytes(existing_sb)) => {
                let Ok(ScopeBind(ex_scope, ex_subjects_json, ex_subjects, _, _, _)) = pending.decode_release_entry(existing_sb) else {
                    return Error(IntegrityFailure)
                }
                if ex_scope != req.scope || ex_subjects_json != req_subjects_json {
                    return Error(EnrollmentConflict)
                }
                if !has_subject(ex_subjects, req.signer) {
                    return Error(Unauthorized)
                }
                saved_scope_bind = Some(take existing_sb)
            },
            Error(take e) => return Error(map_cp_err(take e)),
        }
        on_step(AfterScopeReserve)?
    }
    let lkey = prefix_key("l/", pending.label_key_str(req.identity, req.version))
    let p_bytes = string.into_bytes(string.from(req.root))
    match checkpoint.put_no_clobber_readback(mut client, lkey, p_bytes, 128, deadline_ns) {
        Ok(CreatedNew) => (),
        Ok(ExistedBytes(existing_p)) => {
            if existing_p != p_bytes {
                return Error(LabelConflict)
            }
            let Some(cur) = sync_release(mut seq, mut client, deadline_ns)? else {
                return Error(IntegrityFailure)
            }
            if let Some(take receipt) = check_release_included(seq, req.identity, req.version, req.root, cur.wire)? {
                return Ok(take receipt)
            }
        },
        Error(take e) => return Error(map_cp_err(take e)),
    }
    on_step(AfterLabelReserve)?
    store_evidence_list(mut client, req.evidence, deadline_ns)?
    for f in req.frames {
        if let Some(_) = lookup_takedown(seq, f.root) {
            return Error(TakenDown)
        }
        let fkey = frame_bucket_key(f.root)
        match checkpoint.put_no_clobber_readback(mut client, fkey, f.compressed, pending.MAX_COMPRESSED_FRAME, deadline_ns) {
            Ok(CreatedNew) => (),
            Ok(ExistedBytes(existing)) => {
                if list.len(existing) == 0 {
                    return Error(TakenDown)
                }
                if let Error(_) = pending.verify_zstd_frame(existing, f.root, pending.MAX_COMPRESSED_FRAME, pending.MAX_EXPANDED_FRAME) {
                    return Error(IntegrityFailure)
                }
            },
            Error(take e) => return Error(map_cp_err(take e)),
        }
    }
    on_step(AfterBlobPut)?
    let mut rounds: u64 = 0
    while rounds < 128 {
        rounds += 1
        let Some(parent) = sync_release(mut seq, mut client, deadline_ns)? else {
            return Error(IntegrityFailure)
        }
        if let Some(take receipt) = check_release_included(seq, req.identity, req.version, req.root, parent.wire)? {
            return Ok(take receipt)
        }
        recheck(tlog.note.tree_size(parent.head))?
        let mut my_batch: List[Bytes] = list.new()
        {
            if let Some(scope_rec) = map.get(seq.scopes, req.scope) {
                if req.generation == 0 {
                    return Error(NeedsReadmission)
                }
                if scope_rec.generation != req.generation {
                    return Error(StaleGeneration)
                }
                if !has_subject(scope_rec.subjects, req.signer) {
                    return Error(Unauthorized)
                }
                list.push(mut my_batch, clone(req.release_entry))
            } else {
                if req.generation != 0 {
                    return Error(StaleGeneration)
                }
                let Some(sb) = view saved_scope_bind else {
                    return Error(EnrollmentConflict)
                }
                list.push(mut my_batch, clone(sb))
                list.push(mut my_batch, clone(req.release_entry))
            }
        }
        if let CommittedBatch(cp) = propose_and_finish(mut seq, mut client, Release, take parent, take my_batch, random, deadline_ns, now_seconds, post_witness, on_step)? {
            if let Some(take receipt) = check_release_included(seq, req.identity, req.version, req.root, cp.wire)? {
                return Ok(take receipt)
            }
        }
    }
    Error(Uncertain)
}

pub fn commit_publish(mut seq: Sequencer, mut client: std.object.Client, req: PublishRequest, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[Receipt, Error] waits {
    commit_publish_with_hook(mut seq, mut client, req, random, deadline_ns, now_seconds, post_witness, scoped fn(_n: u64) -> Result[(), Error] {
        Ok(())
    }, scoped fn(_pt: StepPoint) -> Result[(), Error] {
        Ok(())
    })
}

fn rebind_authority(seq: Sequencer, req: RebindRequest) -> Result[(), Error] {
    let Some(rec) = map.get(seq.scopes, req.scope) else {
        return Error(StaleGeneration)
    }
    if rec.generation != req.old_generation || rec.generation == 18446744073709551615u64 {
        return Error(StaleGeneration)
    }
    if !has_subject(rec.subjects, req.signer) {
        return Error(Unauthorized)
    }
    Ok(())
}

/// Full commit for a scope-rebind entry on the release log (never mutates s/<scope>).
pub fn commit_rebind_with_hook(mut seq: Sequencer, mut client: std.object.Client, req: RebindRequest, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, recheck: scoped fn(u64) -> Result[(), Error], on_step: scoped fn(StepPoint) -> Result[(), Error]) -> Result[Receipt, Error] waits {
    let Ok(ScopeRebind(scope, old_gen, _, _, _, auth)) = pending.decode_release_entry(req.rebind_entry) else {
        return Error(InvalidInput)
    }
    if scope != req.scope || old_gen != req.old_generation || auth.subject != req.signer || auth.intent_digest != req.intent_digest {
        return Error(InvalidInput)
    }
    let Some(initial_parent) = sync_release(mut seq, mut client, deadline_ns)? else {
        return Error(IntegrityFailure)
    }
    if let Some(take receipt) = check_intent_included(seq, req.intent_digest, initial_parent.wire) {
        return Ok(take receipt)
    }
    rebind_authority(seq, req)?
    validate_evidence(req.evidence)?
    recheck(tlog.note.tree_size(initial_parent.head))?
    on_step(AfterAdmit)?
    store_evidence_list(mut client, req.evidence, deadline_ns)?
    on_step(AfterBlobPut)?
    let mut rounds: u64 = 0
    while rounds < 128 {
        rounds += 1
        let Some(parent) = sync_release(mut seq, mut client, deadline_ns)? else {
            return Error(IntegrityFailure)
        }
        if let Some(take receipt) = check_intent_included(seq, req.intent_digest, parent.wire) {
            return Ok(take receipt)
        }
        recheck(tlog.note.tree_size(parent.head))?
        rebind_authority(seq, req)?
        let mut my_batch: List[Bytes] = list.with_capacity(1)
        list.push(mut my_batch, clone(req.rebind_entry))
        if let CommittedBatch(cp) = propose_and_finish(mut seq, mut client, Release, take parent, take my_batch, random, deadline_ns, now_seconds, post_witness, on_step)? {
            if let Some(take receipt) = check_intent_included(seq, req.intent_digest, cp.wire) {
                return Ok(take receipt)
            }
        }
    }
    Error(Uncertain)
}

pub fn commit_rebind(mut seq: Sequencer, mut client: std.object.Client, req: RebindRequest, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[Receipt, Error] waits {
    commit_rebind_with_hook(mut seq, mut client, req, random, deadline_ns, now_seconds, post_witness, scoped fn(_n: u64) -> Result[(), Error] {
        Ok(())
    }, scoped fn(_pt: StepPoint) -> Result[(), Error] {
        Ok(())
    })
}

fn validate_status_transition(seq: Sequencer, entry: pending.StatusEntry, req: StatusRequest) -> Result[(), Error] {
    let Some(rel) = map.get(seq.releases_by_root, req.root) else {
        return Error(UnknownRoot)
    }
    if rel.scope != req.scope {
        return Error(Unauthorized)
    }
    match registry_auth.principal(req.authority) {
        Legal(key) => {
            if key != seq.legal_key {
                return Error(Unauthorized)
            }
        },
        Scope(generation, signer) => {
            let Some(rec) = map.get(seq.scopes, rel.scope) else {
                return Error(StaleGeneration)
            }
            if rec.generation != generation {
                return Error(StaleGeneration)
            }
            if !has_subject(rec.subjects, signer) {
                return Error(Unauthorized)
            }
        },
    }
    let current_state: pending.LifecycleState = match map.get(seq.statuses, req.root) {
        Some(st) => {
            if req.previous_event != Some(string.from(st.last_leaf_hash)) {
                return Error(PredecessorConflict)
            }
            clone(st.state)
        },
        None => {
            if req.previous_event != None {
                return Error(PredecessorConflict)
            }
            Active
        },
    }
    if let TakenDown(_, _) = current_state {
        return Error(TerminalStatus)
    }
    match entry {
        Retire(_, _, _, _, _, _) if current_state != Active => Error(PredecessorConflict),
        Reinstate(_, _, _, _, _) => match current_state {
            Retired(_, _) => Ok(()),
            _ => Error(PredecessorConflict),
        },
        Advise(_, _, id, digest, _, _) => {
            for ev in req.evidence {
                if ev.digest == digest {
                    return match registry_auth.advisory(ev.data, id, digest, rel.identity, rel.version) {
                        Ok(_) => Ok(()),
                        Error(_) => Error(InvalidInput),
                    }
                }
            }
            Error(InvalidInput)
        },
        _ => Ok(()),
    }
}

/// Replaces c/<P>.zst with a permanent zero-byte deletion marker using its strong ETag,
/// or creates the zero-byte marker with Absent if the frame was not yet uploaded.
pub fn install_deletion_marker(mut client: std.object.Client, root: String, deadline_ns: u64) -> Result[(), Error] waits {
    match checkpoint.install_deletion_marker(mut client, root, deadline_ns) {
        Ok(()) => Ok(()),
        Error(take e) => Error(map_cp_err(take e)),
    }
}

/// Resumes deletion marker cleanup for every committed takedown in status log after a crash.
pub fn reconcile_takedowns(mut seq: Sequencer, mut client: std.object.Client, deadline_ns: u64) -> Result[u64, Error] waits {
    let _ = sync_status(mut seq, mut client, deadline_ns)?
    let mut cleaned: u64 = 0
    let mut roots: List[String] = list.new()
    for (root, st) in seq.statuses {
        if let TakenDown(_, _) = view st.state {
            list.push(mut roots, string.from(root))
        }
    }
    for root in roots {
        install_deletion_marker(mut client, root, deadline_ns)?
        cleaned += 1
    }
    Ok(cleaned)
}

/// Full commit for a status change (retire, reinstate, advise, takedown) on the status log.
pub fn commit_status_with_hook(mut seq: Sequencer, mut client: std.object.Client, req: StatusRequest, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits, on_step: scoped fn(StepPoint) -> Result[(), Error]) -> Result[Receipt, Error] waits {
    let Ok(parsed) = pending.decode_status_entry(req.status_entry) else {
        return Error(InvalidInput)
    }
    let (root, prev, status, auth): (String, Option[String], registry_auth.Status, pending.AuthFields) = match view parsed {
        Retire(r, p, reason, msg, _, a) => (clone(r), clone(p), Retire(clone(reason), clone(msg)), clone(a)),
        Reinstate(r, p, msg, _, a) => (clone(r), clone(p), Reinstate(clone(msg)), clone(a)),
        Advise(r, p, id, hash, _, a) => (clone(r), clone(p), Advise(clone(id), clone(hash)), clone(a)),
        Takedown(r, p, reason, msg, _, a) => (clone(r), clone(p), Takedown(clone(reason), clone(msg)), clone(a)),
    }
    if root != req.root || prev != req.previous_event || auth.intent_digest != req.intent_digest {
        return Error(InvalidInput)
    }
    let generation = match registry_auth.principal(req.authority) {
        Scope(gen, _) => gen,
        Legal(key) => {
            if key != seq.legal_key {
                return Error(Unauthorized)
            }
            0u64
        },
    }
    let intent = registry_auth.Intent(origin: clone(seq.registry_origin), scope: clone(req.scope), generation: generation, action: ChangeStatus(take root, take prev, take status))
    if !registry_auth.status_authorized(req.authority, intent, pending.auth_wire(auth)) {
        return Error(Unauthorized)
    }
    let takedown = match view parsed {
        Takedown(_, _, _, _, _, _) => true,
        _ => false,
    }
    let _ = sync_release(mut seq, mut client, deadline_ns)?
    let Some(initial_parent) = sync_status(mut seq, mut client, deadline_ns)? else {
        return Error(IntegrityFailure)
    }
    if let Some(take receipt) = check_status_included(seq, req.intent_digest, req.previous_event, initial_parent.wire) {
        if takedown {
            install_deletion_marker(mut client, req.root, deadline_ns)?
        }
        return Ok(take receipt)
    }
    if tlog.note.tree_size(initial_parent.head) != req.captured_status_parent || tlog.note.tree_root(initial_parent.head) != req.captured_status_root {
        return Error(NeedsReadmission)
    }
    validate_evidence(req.evidence)?
    validate_status_transition(seq, parsed, req)?
    on_step(AfterAdmit)?
    store_evidence_list(mut client, req.evidence, deadline_ns)?
    on_step(AfterBlobPut)?
    let mut rounds: u64 = 0
    while rounds < 64 {
        rounds += 1
        let Some(parent) = sync_status(mut seq, mut client, deadline_ns)? else {
            return Error(IntegrityFailure)
        }
        if let Some(take receipt) = check_status_included(seq, req.intent_digest, req.previous_event, parent.wire) {
            if takedown {
                on_step(AfterTakedownStatusBeforeMarker)?
                install_deletion_marker(mut client, req.root, deadline_ns)?
            }
            return Ok(take receipt)
        }
        if tlog.note.tree_size(parent.head) != req.captured_status_parent || tlog.note.tree_root(parent.head) != req.captured_status_root {
            return Error(NeedsReadmission)
        }
        let mut my_batch: List[Bytes] = list.with_capacity(1)
        list.push(mut my_batch, clone(req.status_entry))
        if let CommittedBatch(cp) = propose_and_finish(mut seq, mut client, Status, take parent, take my_batch, random, deadline_ns, now_seconds, post_witness, on_step)? {
            if let Some(take receipt) = check_status_included(seq, req.intent_digest, req.previous_event, cp.wire) {
                if takedown {
                    on_step(AfterTakedownStatusBeforeMarker)?
                    install_deletion_marker(mut client, req.root, deadline_ns)?
                }
                return Ok(take receipt)
            }
        }
    }
    Error(Uncertain)
}

pub fn commit_status(mut seq: Sequencer, mut client: std.object.Client, req: StatusRequest, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[Receipt, Error] waits {
    commit_status_with_hook(mut seq, mut client, req, random, deadline_ns, now_seconds, post_witness, scoped fn(_pt: StepPoint) -> Result[(), Error] {
        Ok(())
    })
}

/// Explicitly recovers an orphaned pending/<N> proposal without any caller request.
pub fn recover_pending(mut seq: Sequencer, mut client: std.object.Client, kind: checkpoint.LogKind, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[bool, Error] waits {
    let Some(parent) = sync_one_log(mut seq, mut client, kind, deadline_ns)? else {
        return Ok(false)
    }
    help_pending_at(mut seq, mut client, kind, take parent, random, deadline_ns, now_seconds, post_witness)
}

fn help_pending_at(mut seq: Sequencer, mut client: std.object.Client, kind: checkpoint.LogKind, take parent: checkpoint.CurrentCheckpoint, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[bool, Error] waits {
    let n = tlog.note.tree_size(parent.head)
    let winner = {
        let cfg = view seq.logs[log_index(kind)].cfg
        result.map_err(checkpoint.read_pending(mut client, cfg, n, tlog.note.tree_root(parent.head), deadline_ns), map_cp_err)?
    }
    let Some(take proposal) = take winner else {
        return Ok(false)
    }
    let _ = finish_winning_batch(mut seq, mut client, kind, take parent, proposal.entries, random, deadline_ns, now_seconds, post_witness, scoped fn(_pt: StepPoint) -> Result[(), Error] {
        Ok(())
    })?
    Ok(true)
}

/// Quiet-log heartbeat: refreshes witness cosignatures over unchanged size/root via CAS,
/// never rolling back a concurrent forward commit.
pub fn heartbeat(mut seq: Sequencer, mut client: std.object.Client, kind: checkpoint.LogKind, random: Random, deadline_ns: u64, now_seconds: scoped fn() -> u64, post_witness: scoped fn(u64, String, String) -> Result[tlog.witness.HttpResponse, tlog.witness.Error] waits) -> Result[checkpoint.CurrentCheckpoint, Error] waits {
    let mut tries: u64 = 0
    while tries < 8 {
        tries += 1
        let Some(current) = sync_one_log(mut seq, mut client, kind, deadline_ns)? else {
            return Error(IntegrityFailure)
        }
        let size = tlog.note.tree_size(current.head)
        let root = tlog.note.tree_root(current.head)
        let observed = witness_for_log(mut seq.logs[log_index(kind)], size, root, random, now_seconds, post_witness, scoped fn(_i: u64) -> Result[(), checkpoint.CheckpointError] {
            Ok(())
        })
        let witnessed = match take observed {
            Ok(take h) => take h,
            Error(WitnessAhead(_)) => {
                let Some(latest) = sync_one_log(mut seq, mut client, kind, deadline_ns)? else {
                    return Error(WitnessFork)
                }
                if tlog.note.tree_size(latest.head) > size {
                    return Ok(take latest)
                }
                if help_pending_at(mut seq, mut client, kind, take latest, random, deadline_ns, now_seconds, post_witness)? {
                    continue
                }
                return Error(WitnessFork)
            },
            Error(take e) => return Error(map_cp_err(take e)),
        }
        let wire = string.from(tlog.note.envelope(witnessed))
        let cp_key = checkpoint.checkpoint_key(kind)
        let (res, _) = std.object.store_if(mut client, cp_key, Match(current.etag), string.into_bytes(clone(wire)), deadline_ns)
        let need_reconcile = match take res {
            Ok(Applied(meta)) => return Ok(checkpoint.CurrentCheckpoint(head: take witnessed, etag: meta.etag, wire: take wire)),
            Ok(Mismatch) => true,
            Error(e) => {
                if checkpoint.is_uncertain_object_err(e) {
                    true
                } else {
                    return Error(Storage(e))
                }
            },
        }
        if need_reconcile {
            let Some(latest) = sync_one_log(mut seq, mut client, kind, deadline_ns)? else {
                return Error(Uncertain)
            }
            let latest_size = tlog.note.tree_size(latest.head)
            if latest_size > size {
                return Ok(take latest)
            }
            if latest_size < size || tlog.note.tree_root(latest.head) != root {
                return Error(IntegrityFailure)
            }
            if latest.etag != current.etag {
                let is_fresh = checkpoint.cosignatures_fresh(seq.logs[log_index(kind)].cfg, latest.head, now_seconds())
                if is_fresh {
                    return Ok(take latest)
                }
            }
        }
    }
    Error(Uncertain)
}

// Applies any remaining slices of a sealed `(sid, inc)` tail in `[from_seq, cutoff]`
// that landed after step 1 stopped and before the claim's cutoff (Case B).
fn stream_follow_apply_sealed_range(mut client: std.object.Client, mut buffers: host_stream.TailBuffers, root: String, place_prefix: String, head_witness: Bytes, authority_kind: u8, st: format.SealedTail, from_seq: u64, store: StoreId, epoch: u64, mut replay: pager.JournalReplay, ceiling: u64, deadline: u64) -> Result[bool, Error] waits {
    let dir = host_stream.stream_key(root, host_stream.stream_dir(host_stream_id_to_rep(host_stream_id_from_rep(st.tail.sid))))
    let mut seal_lane = failure_result_from_rep(host_stream.stream_lane(host_stream_id_to_rep(host_stream_id_from_rep(st.tail.sid)), authority_kind, 2, store_key_to_rep(store)))?
    seal_lane.dir = string.from(dir)
    let mut seq = from_seq
    while seq <= st.cutoff {
        let skip: u64 = if seq == st.tail.from_seq {
            int.widen(st.tail.from_frame)
        } else {
            0
        }
        let ok = host_stream.stream_at_root(mut client, scoped fn(mut c: std.object.Client) -> Result[bool, Error] waits {
            match stream_tail_batch(mut c, mut seal_lane, mut buffers, place_prefix, head_witness, host_stream_id_from_rep(st.tail.sid), st.tail.inc, seq, store, epoch, skip, 18446744073709551615u64, true, false, mut replay, ceiling, deadline)? {
                TailRead(_) => Ok(true),
                TailHeadMoved => Ok(false),
                _ => Error(failure_from_rep(format.disk_fault("batch", 0, Absent))),
            }
        })?
        if !ok {
            return Ok(false)
        }
        seq += 1
    }
    Ok(true)
}

fn stream_follow_wrap_capture(head: history.HistoryHead, tag: std.object.ETag, take attach: Option[format.Attach], take head_bytes: Bytes, live_next_seq: u64, take replay: pager.JournalReplay) -> Result[Option[Arc[object_writer.FollowCapture]], Error] {
    let material = failure_result_from_rep(host_stream.stream_follow_make_capture(head, tag, take attach, take head_bytes, live_next_seq, take replay))?
    let (store, take state, resident, take remote, watermark) = host_stream.stream_follow_parts(take material)
    Ok(Some(failure_result_from_rep(object_writer.follow_capture(store_key_to_rep(store_key_from_rep(store)), take state, resident, Some(take remote), 0, watermark))?))
}

// Loads a head's settled history in §12.11.9 order, restarting if a sealed-tail
// 404 observes that `head` moved.
fn stream_follow_load_fresh(mut source: history.ObjectPackRead, root: String, place_prefix: String, expected: Option[StoreId], mut buffers: host_stream.TailBuffers, mut scratch: Bytes, ceiling: u64, initial: bool) -> Result[(history.HistoryHead, std.object.ETag, Option[format.Attach], Bytes, pager.JournalReplay), Error] waits {
    loop {
        let (take capture, take attach, tag) = failure_result_from_rep(host_stream.stream_follow_fetch_head(mut source.client, source.authority_kind, mut scratch, source.deadline, initial))?
        let head = capture.head
        failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(expected), head.store))?
        match take attach {
            None => {
                let replay = history_paged_capture(mut source, head, ceiling)?
                return Ok((head, tag, None, list.new(), take replay))
            },
            Some(take a) => {
                let loaded = stream_load_settled(mut source, head, a, root, place_prefix, scratch, source.authority_kind, mut buffers, ceiling)?
                if let Some(take replay) = take loaded {
                    let saved = failure_result_from_rep(types.copied(scratch))?
                    return Ok((head, tag, Some(take a), take saved, take replay))
                }
            },
        }
    }
}

fn stream_follow_capture(mut source: history.ObjectPackRead, previous: Option[Arc[object_writer.FollowCapture]], expected: Option[StoreId], ceiling: u64, require_fresh: bool) -> Result[Option[Arc[object_writer.FollowCapture]], Error] waits {
    let root = match view source.stream_root {
        Some(r) => string.from(r),
        None => return Error(Missing("stream_root")),
    }
    let place_prefix = std.object.bucket_config(source.client).prefix
    let old_charge = match previous {
        Some(old_capture) => old_capture.resident,
        None => 0u64,
    }
    let avail = ceiling - old_charge
    let mut buffers = failure_result_from_rep(host_stream.stream_tail_buffers())?
    let mut scratch = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(history.HISTORY_HEAD_LIMIT))
    })?
    let mut cur_head: history.HistoryHead = history.HistoryHead(authority_kind: source.authority_kind, store: types.StoreKey(hi: 0, lo: 0), pair: history.HistoryPair(epoch: 0, holder: types.StoreKey(hi: 0, lo: 0)), activation: 0, entry: pages.HistoryRef(seq: 0, epoch: 0, len: 0, digest: 0u64), checkpoint: pages.HistoryRef(seq: 0, epoch: 0, len: 0, digest: 0u64), floor: 0, binding:[0u8; 32], origin: None)
    let mut cur_tag = std.object.ETag(octets:[0u8; 64], len: 0)
    let mut cur_attach: Option[format.Attach] = None
    let mut cur_bytes: Bytes = list.new()
    let mut scan_from = 0u64
    let mut advanced_anything = false
    let mut replay: pager.JournalReplay = match previous {
        None => {
            let (head, tag, take attach, take saved_bytes, take loaded) = stream_follow_load_fresh(mut source, root, place_prefix, expected, mut buffers, mut scratch, avail, true)?
            match take attach {
                None => return stream_follow_wrap_capture(head, tag, None, list.new(), 0, take loaded),
                Some(take a) => match a.live {
                    None => return stream_follow_wrap_capture(head, tag, Some(take a), take saved_bytes, 0, take loaded),
                    Some(tail) => {
                        cur_head = head
                        cur_tag = tag
                        cur_attach = Some(take a)
                        cur_bytes = take saved_bytes
                        scan_from = tail.from_seq
                        advanced_anything = true
                        take loaded
                    },
                },
            }
        },
        Some(old_capture) => {
            let Some(old) = view old_capture.remote else {
                fail("stream follower missing remote head")
            }
            let reuse_live: Option[(format.Attach, format.StreamRef)] = match old.attach {
                Some(a) => match a.live {
                    Some(tail) => Some((clone(a), tail)),
                    None => None,
                },
                None => None,
            }
            match take reuse_live {
                Some((take old_a, _)) => {
                    let state = failure_result_from_rep(host_stream.copy_follow_state(old_capture.state))?
                    let initial = failure_result_from_rep(pager.journal_replay(take state, old.next_node, limits_to_rep(default_limits())))?
                    failure_result_from_rep(catalog.over_ceiling(failure_result_from_rep(journal.journal_account(initial))?, avail))?
                    cur_head = old.current
                    cur_tag = old.tag
                    cur_attach = Some(take old_a)
                    cur_bytes = failure_result_from_rep(types.copied(old.head_bytes))?
                    scan_from = old.live_next_seq
                    advanced_anything = false
                    take initial
                },
                None => {
                    // Direct service (`live == None`) or previously standalone:
                    // check `head` without touching `reg`.
                    let (take capture, take attach, tag) = failure_result_from_rep(host_stream.stream_follow_fetch_head(mut source.client, source.authority_kind, mut scratch, source.deadline, false))?
                    let head = capture.head
                    failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(expected), head.store))?
                    if head.floor < old.current.floor || head.entry.seq < old.current.entry.seq {
                        return Error(failure_from_rep(format.disk_fault("head", 72, Order)))
                    }
                    let old_had_attach = match old.attach {
                        Some(_) => true,
                        None => false,
                    }
                    let cur_no_attach = match attach {
                        None => true,
                        Some(_) => false,
                    }
                    if old_had_attach && scratch == old.head_bytes {
                        return Ok(None)
                    }
                    if !old_had_attach && cur_no_attach && history.history_ref_matches(head.entry, old.current.entry) {
                        return Ok(None)
                    }
                    match take attach {
                        None => {
                            let loaded = history_paged_capture(mut source, head, avail)?
                            return stream_follow_wrap_capture(head, tag, None, list.new(), 0, take loaded)
                        },
                        Some(take a) => {
                            let loaded_opt = stream_load_settled(mut source, head, a, root, place_prefix, scratch, source.authority_kind, mut buffers, avail)?
                            let (h2, t2, take a2_opt, take b2, take loaded) = match take loaded_opt {
                                Some(take r) => (head, tag, Some(take a), failure_result_from_rep(types.copied(scratch))?, take r),
                                None => stream_follow_load_fresh(mut source, root, place_prefix, expected, mut buffers, mut scratch, avail, false)?,
                            }
                            match take a2_opt {
                                None => return stream_follow_wrap_capture(h2, t2, None, list.new(), 0, take loaded),
                                Some(take a2) => match a2.live {
                                    None => return stream_follow_wrap_capture(h2, t2, Some(take a2), take b2, 0, take loaded),
                                    Some(tail) => {
                                        cur_head = h2
                                        cur_tag = t2
                                        cur_attach = Some(take a2)
                                        cur_bytes = take b2
                                        scan_from = tail.from_seq
                                        advanced_anything = true
                                        take loaded
                                    },
                                },
                            }
                        },
                    }
                },
            }
        },
    }
    // Follower round loop (§12.11.9) on `cur_head` with `cur_attach.live = Some(tail)`.
    let mut rounds = 0u64
    loop {
        rounds += 1
        if rounds > 32 {
            return Error(Remote(Retriable(Deadline)))
        }
        let live_opt: Option[format.StreamRef] = match view cur_attach {
            Some(a) => a.live,
            None => None,
        }
        let Some(tail) = live_opt else {
            return stream_follow_wrap_capture(cur_head, cur_tag, take cur_attach, take cur_bytes, 0, take replay)
        }
        let store = cur_head.store
        let epoch = cur_head.pair.epoch
        let mut lane = failure_result_from_rep(host_stream.stream_lane(host_stream_id_to_rep(host_stream_id_from_rep(tail.sid)), source.authority_kind, 2, store_key_to_rep(store_key_from_rep(store))))?
        lane.dir = host_stream.stream_key(root, host_stream.stream_dir(host_stream_id_to_rep(host_stream_id_from_rep(tail.sid))))
        let deadline = source.deadline
        // Step 1: read X's slices from `scan_from` until first not-yet-created.
        let (take slices, stop_seq, _) = host_stream.stream_at_root(mut source.client, scoped fn(mut c: std.object.Client) -> Result[(List[host_stream.FollowSlice], u64, bool), Error] waits {
            failure_result_from_rep(host_stream.stream_follow_scan_slices(mut c, mut lane, mut buffers, place_prefix, cur_bytes, tail, store_key_to_rep(store_key_from_rep(store)), epoch, scan_from, deadline))
        })?
        // Step 2: GET `S/reg`, issued AFTER the last batch read completed.
        host_stream.stream_at_root(mut source.client, scoped fn(mut c: std.object.Client) -> Result[(), Error] waits {
            failure_result_from_rep(host_stream.stream_reg_read(mut lane, mut c, deadline))
        })?
        // Step 3: GET X's `head`, issued AFTER step 2's response.
        let (take after_cap, take after_attach, after_tag) = failure_result_from_rep(host_stream.stream_follow_fetch_head(mut source.client, source.authority_kind, mut scratch, source.deadline, false))?
        failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(expected), after_cap.head.store))?
        // Step 4: decide by the four cases of §12.11.9.
        if scratch == cur_bytes {
            let clean = lane.reg.inc == tail.inc && !lane.reg.collecting && !host_stream.stream_follow_reg_has_row(lane.reg, store_key_to_rep(store_key_from_rep(store)), epoch)
            if clean {
                for item in slices {
                    stream_tail_apply(item.key, item.slice, item.row, item.batch_seq, store_key_from_rep(store), epoch, item.skip, mut replay, avail)?
                }
                if list.len(slices) == 0 && !advanced_anything && stop_seq == scan_from {
                    return Ok(None)
                }
                return stream_follow_wrap_capture(cur_head, cur_tag, take cur_attach, take cur_bytes, stop_seq, take replay)
            }
            // Case D: hold present or inc changed with head still Hd -> publish nothing new.
            if require_fresh {
                return Error(Behind(Position(store: store_key_from_rep(store), branch: 0, version: replay.state.tips[0].head)))
            }
            if advanced_anything {
                return stream_follow_wrap_capture(cur_head, cur_tag, take cur_attach, take cur_bytes, scan_from, take replay)
            }
            return Ok(None)
        }
        // Head changed: check Case B (epoch > e with sealed containing (S, inc, ..., cutoff k)).
        let after_head = after_cap.head
        let mut case_b_idx: Option[u64] = None
        if after_head.pair.epoch > epoch && after_head.checkpoint.seq <= cur_head.entry.seq {
            if let Some(na) = after_attach {
                case_b_idx = host_stream.stream_follow_find_sealed(na, host_stream_id_to_rep(host_stream_id_from_rep(tail.sid)), tail.inc)
            }
        }
        if let Some(j) = case_b_idx {
            let Some(take na) = take after_attach else {
                return Error(failure_from_rep(format.disk_fault("head", 72, Malformed)))
            }
            let st_j = na.sealed[j]
            let cutoff = st_j.cutoff
            let after_bytes = failure_result_from_rep(types.copied(scratch))?
            for item in slices {
                if item.batch_seq <= cutoff {
                    stream_tail_apply(item.key, item.slice, item.row, item.batch_seq, store_key_from_rep(store), epoch, item.skip, mut replay, avail)?
                }
            }
            let mut case_b_ok = true
            if stop_seq <= cutoff {
                case_b_ok = stream_follow_apply_sealed_range(mut source.client, mut buffers, root, place_prefix, after_bytes, source.authority_kind, st_j, stop_seq, store_key_from_rep(store), epoch, mut replay, avail, source.deadline)?
            }
            if case_b_ok {
                let chain = failure_result_from_rep(history.history_suffix(mut source.client, after_head, cur_head.entry, source.deadline))?
                let base_seq = cur_head.entry.seq
                let mut done_seq = base_seq
                let mut idx = j + 1
                while idx < list.len(na.sealed) {
                    let st = na.sealed[idx]
                    if st.at < done_seq || st.at > after_head.entry.seq {
                        return Error(failure_from_rep(format.disk_fault("head", 72, Malformed)))
                    }
                    if st.at > done_seq {
                        let lo = done_seq - base_seq
                        let hi = st.at - base_seq
                        let part = list.slice(chain, lo, hi)
                        history_apply_suffix(mut source.client, after_head, done_seq, part, mut replay, avail, source.deadline)?
                        done_seq = st.at
                    }
                    if !stream_apply_sealed_tail(mut source.client, mut buffers, root, place_prefix, after_bytes, source.authority_kind, st, store_key_from_rep(store), mut replay, avail, source.deadline)? {
                        case_b_ok = false
                        break
                    }
                    idx += 1
                }
                if case_b_ok && after_head.entry.seq > done_seq {
                    let lo = done_seq - base_seq
                    let hi = after_head.entry.seq - base_seq
                    let rest = list.slice(chain, lo, hi)
                    history_apply_suffix(mut source.client, after_head, done_seq, rest, mut replay, avail, source.deadline)?
                }
            }
            if case_b_ok {
                cur_head = after_head
                cur_tag = after_tag
                let next_live_seq = match na.live {
                    Some(nl) => nl.from_seq,
                    None => 0u64,
                }
                cur_attach = Some(take na)
                cur_bytes = take after_bytes
                scan_from = next_live_seq
                advanced_anything = true
                continue
            }
        }
        // Case C: re-follow from the new head in exact history order.
        let (h3, t3, take a3_opt, take b3, take loaded3) = stream_follow_load_fresh(mut source, root, place_prefix, expected, mut buffers, mut scratch, avail, false)?
        match take a3_opt {
            None => return stream_follow_wrap_capture(h3, t3, None, list.new(), 0, take loaded3),
            Some(take a3) => match a3.live {
                None => return stream_follow_wrap_capture(h3, t3, Some(take a3), take b3, 0, take loaded3),
                Some(nl) => {
                    cur_head = h3
                    cur_tag = t3
                    cur_attach = Some(take a3)
                    cur_bytes = take b3
                    replay = take loaded3
                    scan_from = nl.from_seq
                    advanced_anything = true
                },
            },
        }
    }
}

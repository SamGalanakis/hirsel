fn masked_log_append(states: Map[u32, pages.LogState], key: Bytes) -> bool {
    if list.len(key) != 12 {
        return false
    }
    let id: u32 = list.word_be(key, 0)
    let Some(state) = map.get(states, id) else {
        return false
    }
    let seq: u64 = list.word_be(key, 4)
    seq < state.limits.first
}

pub type LogRangeTail {
    id: u32,
    seq: u64,
    end: u64
}

pub fn log_endpoint(limit: std.omap.Bound[u64], high: bool) -> u64 {
    match limit {
        Unbounded => if high {
            18446744073709551615u64
        } else {
            0u64
        },
        Included(n) => if high {
            int.saturating_add(n, 1)
        } else {
            n
        },
        Excluded(n) => if high {
            n
        } else {
            int.saturating_add(n, 1)
        },
    }
}

pub fn trim_log_page(mut tree: pages.PageTree, key: Bytes, floor: u64, expected: Option[u64], first: u64, mut ids: u64) -> Result[u64, types.Failure] {
    let (take kept, next_seq, dropped) = {
        let Some((old, descriptor)) = std.page.collection_entry(tree.root, key) else {
            return Error(pages.malformed(0))
        }
        let fields = pages.collection_descriptor(descriptor)
        if fields.kind != LogCollection || fields.residency != ResidentMemory {
            return Error(pages.malformed(0))
        }
        let limits = pager.descriptor_bounds(descriptor)
        let previous = fields.row_bytes
        if floor < limits.first {
            return Error(pages.malformed(0))
        }
        if let Some(amount) = expected {
            if amount > previous {
                return Error(pages.malformed(0))
            }
        }
        let candidate = if floor >= limits.next {
            let Some(empty) = view tree.empty_collection else {
                fail("store: missing empty collection page")
            }
            arc.share(empty)
        } else {
            let suffix = types.key_word(floor)
            pages.page_result(std.page.cut_before(old, suffix, mut ids))?
        }
        let (rows, charge) = std.page.totals(candidate)
        let removed = order.min(floor, limits.next) - limits.first
        if rows != limits.next - limits.first - removed || charge > previous {
            return Error(pages.malformed(0))
        }
        (take candidate, order.max(floor, limits.next), previous - charge)
    }
    if let Some(amount) = expected {
        if dropped != amount {
            return Error(pages.malformed(0))
        }
    }
    let descriptor = pages.log_record(kept, floor, next_seq, ResidentMemory)?
    pages.page_result(std.page.insert(mut tree.root, key, descriptor, Some(take kept), tree.inline, first, mut ids))?
    Ok(dropped)
}

fn staged_log_state[Event: inert + shareable + send](tx: TxState[Event], id: u32) -> Option[pages.LogState] {
    if let Some(existing) = map.get(tx.ops.logs, id) {
        return Some(existing)
    }
    let mut layer = list.len(tx.below)
    while layer > 0 {
        layer -= 1
        if let Some(existing) = map.get(tx.below[layer].ops.logs, id) {
            return Some(existing)
        }
    }
    None
}

fn transaction_log_state[Event: inert + shareable + send](tx: TxState[Event], id: u32) -> Result[pages.LogState, types.Failure] {
    if let Some(existing) = staged_log_state(tx, id) {
        return Ok(existing)
    }
    let tree = view tx.roots.collections
    let key = catalog.prefix(id)?
    let Some(descriptor) = std.page.lookup(tree.root, key) else {
        return Error(Stale(id))
    }
    let head = pager.descriptor_bounds(descriptor)
    let height = if pages.collection_descriptor(descriptor).residency == ResidentTiered {
        transaction_write_height(tx, pager.log_key(id, head.next)?)?
    } else {
        collection_write_height(tree, key)
    }
    let staged_bounds = pages.LogBoundsRep(first: head.first, next: head.next)
    Ok(pages.LogState(head: staged_bounds, limits: staged_bounds, height: height))
}

pub fn next_log_range_tail[Event: inert + shareable + send](tx: TxState[Event], mut tail: LogRangeTail) -> Result[Option[(Bytes, Arc[Bytes])], types.Failure] {
    if tail.seq >= tail.end {
        return Ok(None)
    }
    let key = pager.log_key(tail.id, tail.seq)?
    let Some(raw) = transaction_row(tx, key)? else {
        return Error(pages.malformed(0))
    }
    let body = arc.new(types.copied(raw)?)
    tail.seq += 1
    Ok(Some((take key, take body)))
}

pub fn trim_log_floor[Event: inert + shareable + send](mut tx: TxState[Event], id: u32, seq: u64) -> Result[(), types.Failure] {
    let mut current = transaction_log_state(tx, id)?
    let floor = order.min(order.max(seq, current.limits.first), current.limits.next)
    if floor == current.limits.first {
        return Ok(())
    }
    let mut masked_charge = 0u64
    let mut masked_wire = 0u64
    for old_seq in order.max(current.head.next, current.limits.first) .. floor {
        let key = pager.log_key(id, old_seq)?
        let Some(raw) = transaction_row(tx, key)? else {
            fail("store: missing staged Log append")
        }
        masked_charge += memory_data_charge(tx, key, raw)
        if let Some(_) = tx.frame_bytes {
            masked_wire += 25 + list.len(raw)
        }
    }
    let first_trim = current.limits.first == current.head.first
    let frame: Option[u64] = match tx.frame_bytes {
        None => None,
        Some(before) => {
            let added = if first_trim {
                21u64
            } else {
                0u64
            }
            let after = before - masked_wire + added
            if int.saturating_add(after, tx.extra_bytes) - 16 > types.transaction_limit(tx.limits) {
                return Error(Limit(Transaction))
            }
            Some(after)
        },
    }
    let _ = reserve_ids(mut tx, current.height)?
    current.limits.first = floor
    map.insert(mut tx.ops.logs, id, current)
    if first_trim {
        tx.trim_rows += 1
    }
    tx.frame_bytes = frame
    tx.resident = int.saturating_sub(tx.resident, masked_charge)
    Ok(())
}

fn seal_log_trims[Event: inert + shareable + send](mut tx: TxState[Event], mut draw: u64) -> Result[pages.DataRows, types.Failure] {
    let mut operations = pages.new_data_rows()
    let first = draw
    let states = replace(mut tx.ops.logs, map.new())
    for (id, state) in states {
        if state.limits.first == state.head.first {
            continue
        }
        let key = catalog.prefix(id)?
        // A Tiered Log's floor is staged by the Tiered write plan, whose
        // `TieredDropped` figure the frame carries (§13.3).
        let dropped = if pager.tiered_data_key(tx.roots.collections, key) {
            0u64
        } else {
            let removed = trim_log_page(mut tx.roots.collections, key, state.limits.first, None, first, mut draw)?
            if !tx.retain_old {
                tx.resident = int.saturating_sub(tx.resident, removed)
            }
            removed
        }
        pages.push_data_row(mut operations, format.DataOp(key: take key, value: None, trim: Some(format.JournalTrim(floor: state.limits.first, dropped: dropped)), prior: None))
    }
    if pages.data_row_count(operations) == 0 {
        return Ok(replace(mut tx.ops.rows, pages.new_data_rows()))
    }
    tx.frame_tail = pages.NO_FRAME_TAIL
    for slot in 0u64 .. pages.data_row_count(tx.ops.rows) {
        let op = pages.data_row(tx.ops.rows, slot)
        if !masked_log_append(states, op.key) {
            pages.push_data_row(mut operations, clone(op))
        }
    }
    Ok(take operations)
}

pub fn append_log[Event: inert + shareable + send, V](mut tx: TxState[Event], id: u32, schema: u16, codec: std.codec.Codec[V], v: V) -> Result[u64, types.Failure] {
    let mut current = transaction_log_state(tx, id)?
    let seq = current.limits.next
    let Some(following) = int.checked_add(seq, 1u64) else {
        return Error(Limit(Ids))
    }
    let mut raw: Bytes = list.new()
    list.put_word_le(mut raw, schema)
    std.codec.encode(codec, v, mut raw) ?=> |_| Limit(Value)
    if list.len(raw) > tx.limits.value {
        return Error(Limit(Value))
    }
    let frame: Option[u64] = match tx.frame_bytes {
        None => None,
        Some(before) => {
            let after = before + 25 + list.len(raw)
            if int.saturating_add(after, tx.extra_bytes) - 16 > types.transaction_limit(tx.limits) {
                return Error(Limit(Transaction))
            }
            Some(after)
        },
    }
    let key = pager.log_key(id, seq)?
    let _ = reserve_ids(mut tx, current.height)?
    let charge = memory_data_charge(tx, key, raw)
    let staged = pages.stage_value(take raw, tx.roots.collections.inline)
    let _ = save_data_op(mut tx.ops, tx.below, false, mut tx.rows, take key, Some(take staged), None)
    current.limits.next = following
    map.insert(mut tx.ops.logs, id, current)
    tx.frame_bytes = frame
    tx.resident = int.saturating_add(tx.resident, charge)
    tx.wrote = true
    Ok(seq)
}

pub fn committed_log_bounds(tree: pages.PageTree, id: u32) -> Result[pages.LogBoundsRep, types.Failure] {
    let key = catalog.prefix(id)?
    let Some(descriptor) = std.page.lookup(tree.root, key) else {
        return Error(Stale(id))
    }
    let window = pager.descriptor_bounds(descriptor)
    Ok(pages.LogBoundsRep(first: window.first, next: window.next))
}

pub fn transaction_log_bounds[Event: inert + shareable + send](tx: TxState[Event], id: u32) -> Result[pages.LogBoundsRep, types.Failure] {
    if let Some(existing) = staged_log_state(tx, id) {
        return Ok(pages.LogBoundsRep(first: existing.limits.first, next: existing.limits.next))
    }
    committed_log_bounds(tx.roots.collections, id)
}

pub fn window_deletions[Row, Trim](mut out: read.ChangeOutput[Row, Trim], id: u32, lo: u64, hi: u64, change: fn(take Bytes, take Option[Arc[Bytes]]) -> Row) -> Result[(), types.Failure] {
    for seq in lo .. hi {
        list.push(mut out.rows, change(pager.log_key(id, seq)?, None))
    }
    Ok(())
}

// With a shared Cold Log root, only the retained suffix can differ. Dense
// sequence bounds make the two overlay cursors advance in lockstep.
pub fn shared_cold_window[Row, Trim](mut out: read.ChangeOutput[Row, Trim], before: pages.PageTree, after: pages.PageTree, id: u32, lo: u64, hi: u64, change: fn(take Bytes, take Option[Arc[Bytes]]) -> Row) -> Result[bool, types.Failure] {
    let key = catalog.prefix(id)?
    let Some((ColdPage(left), _)) = std.page.collection_slot(before.root, key) else {
        return Ok(false)
    }
    let Some((ColdPage(right), _)) = std.page.collection_slot(after.root, key) else {
        return Ok(false)
    }
    if left != right {
        return Ok(false)
    }
    let (Some(old_branch), Some(new_branch)) = (view before.replay, view after.replay) else {
        return Ok(true)
    }
    let (Some(old_log), Some(new_log)) = (std.omap.get(old_branch.collections, id), std.omap.get(new_branch.collections, id)) else {
        return Ok(true)
    }
    let path = manifest.paged_pack_path(left.pack)?
    let Some(cold_next) = old_log.cold_next else {
        return Error(format.disk_fault(path, left.offset, Malformed))
    }
    if new_log.cold_next != Some(cold_next) {
        return Error(format.disk_fault(path, left.offset, Malformed))
    }
    let start = order.max(lo, cold_next)
    if start >= hi {
        return Ok(true)
    }
    let rows = manifest.disk_allocation(scoped fn() -> Result[List[Row], types.Failure] {
        let mut old = std.omap.range(old_log.entries, Included(pager.log_key(id, start)?), Excluded(pager.log_key(id, hi)?))
        let mut new = std.omap.range(new_log.entries, Included(pager.log_key(id, start)?), Excluded(pager.log_key(id, hi)?))
        let mut changed: List[Row] = list.new()
        for seq in start .. hi {
            let Some((take old_key, pages.ReplayRow(now: ReplayPut(old_value), ..))) = std.omap.next(mut old) else {
                return Error(format.disk_fault(path, left.offset, Malformed))
            }
            let Some((take new_key, pages.ReplayRow(now: ReplayPut(take new_value), ..))) = std.omap.next(mut new) else {
                return Error(format.disk_fault(path, left.offset, Malformed))
            }
            if old_key != new_key || list.word_be(new_key, 4) != seq {
                return Error(format.disk_fault(path, left.offset, Malformed))
            }
            if old_value != new_value {
                list.push(mut changed, change(take new_key, Some(take new_value)))
            }
        }
        Ok(take changed)
    })?
    types.capacity(list.try_reserve(mut out.rows, list.len(rows)))?
    for take row in take rows {
        list.push(mut out.rows, take row)
    }
    Ok(true)
}

pub fn log_decoder[R: shareable + send](id: u32, registered: Arc[R]) -> read.RowDecoder[u64, R] {
    read.RowDecoder(table: id, key: std.codec.key_u64(), readers: arc.share(registered), unique: false, skip: None)
}

pub fn decode_log_row[V, R: shareable + send](id: u32, registered: Arc[R], raw: Option[View[Bytes]], decode: fn(R, u32, Bytes) -> Result[V, types.Failure]) -> Result[Option[V], types.Failure] {
    match raw {
        Some(stored) => {
            let v = decode(registered, id, stored)?
            Ok(Some(v))
        },
        None => Ok(None),
    }
}

pub fn decode_log_last[V, R: shareable + send](id: u32, registered: Arc[R], seq: u64, raw: Option[View[Bytes]], decode: fn(R, u32, Bytes) -> Result[V, types.Failure]) -> Result[Option[(u64, V)], types.Failure] {
    match raw {
        Some(stored) => {
            let v = decode(registered, id, stored)?
            Ok(Some((seq, v)))
        },
        None => Ok(None),
    }
}

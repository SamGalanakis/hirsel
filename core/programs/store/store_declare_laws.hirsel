fn bucket_keys(key: u64, value: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, value % 4)
    Ok(take keys)
}

fn declaration_law_rename(mut m: Migration) -> Result[(), Error] {
    rename_table(mut m, "items", "renamed")
}

fn migration_list_baseline(mut m: Migration) -> Result[(), Error] {
    let found = list_collections(m)?
    if list.len(found) != 3 || found[0].name != "Z" || found[1].name != "a" || found[2].name != "é" {
        fail("migration listing: expected only Z, a, é in byte order")
    }
    let (Table(), Cell(), Log()) = (found[0].kind, found[1].kind, found[2].kind) else {
        fail("migration listing: expected Edge as Table, Cell, Log")
    }
    Ok(())
}

// The listing reads the staged catalog: a rename staged in this migration
// moves Z to b, between a and é.
fn migration_list_staged(mut m: Migration) -> Result[(), Error] {
    rename_table(mut m, "Z", "b")?
    let found = list_collections(m)?
    if list.len(found) != 3 || found[0].name != "a" || found[1].name != "b" || found[2].name != "é" {
        fail("migration listing: expected the staged rename to b")
    }
    let Table() = found[1].kind else {
        fail("migration listing: expected b to be a Table")
    }
    Ok(())
}

fn migration_list_retire(mut m: Migration) -> Result[(), Error] {
    for item in list_collections(m)? {
        if item.name == "retired" {
            return drop_named_table(mut m, item.name)
        }
    }
    Ok(())
}

fn migration_list_schema(mut d: Declare) -> Result[(u32, u32), Error] {
    let log = declare_log(mut d, "é", std.codec.of_u64(), Forever)?
    let cell = declare_cell(mut d, "a", std.codec.of_u64())?
    let pair_key: std.codec.Key[(u64, u64)] = std.codec.key_of()
    let _ = declare_edge(mut d, "Z", "reverse", pair_key, std.codec.key_u64(), std.codec.key_u64())?
    let (_, log_id) = log_identity(log)
    let (_, cell_id) = cell_identity(cell)
    Ok((log_id, cell_id))
}

// L17: the retirement publishes once and the same migration and schema then open unchanged.
fn migration_list_retirement(mut db: Db, tasks: Tasks) -> Result[(), Error] waits {
    let mut with_retired = declare(db, Migrate)?
    let _ = migration_list_schema(mut with_retired)?
    let retired = declare_table(mut with_retired, "retired", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut with_retired, take retired)?
    let _ = seal(mut db, take with_retired)?
    let committed = version(snapshot(db)) + 1
    for _ in 0u64 .. 2 {
        let mut d = declare_migration(db, tasks, code.describe(migration_list_retire))?
        let _ = migration_list_schema(mut d)?
        let _ = seal(mut db, take d)?
        let after = snapshot(db)
        if has_table(after, "retired")? {
            fail("L17: the retired collection is still present")
        }
        if version(after) != committed {
            fail("L17: the retirement and its rerun must publish exactly once")
        }
    }
    Ok(())
}

@test
fn test_migration_list_collections(c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let _ = law_system_table(mut db, "hirsel.internal", std.codec.key_u64(), std.codec.of_u64())?
    let mut d = declare(db, Migrate)?
    let (log_id, cell_id) = migration_list_schema(mut d)?
    let _ = seal(mut db, take d)?
    let before = version(snapshot(db))
    run_migration(mut db, tasks, code.describe(migration_list_baseline))?
    if version(snapshot(db)) != before {
        fail("migration listing: a read-only migration published a new version")
    }
    let _ = stage_migration(db, tasks, code.describe(migration_list_staged))?
    migration_list_retirement(mut db, tasks)?
    // L70 revised: listing lifts on Tiered descriptors (v2.170).
    refusal_attach_descriptors(mut db, log_id, cell_id)?
    let _ = stage_migration(db, tasks, code.describe(migration_list_baseline))?
    Ok(())
}

@test
fn test_declaration_seal(c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let key = std.codec.key_u64()
    let value = std.codec.of_u64()
    let mut staged = declare(db, Migrate)?
    let mut items = declare_table(mut staged, "items", key, value)?
    let ix = index(mut staged, mut items, "bucket", Many, code.describe(bucket_keys), key)?
    let rows = finish(mut staged, take items)?
    let omitted = declare_table(mut staged, "omitted", key, value)?
    let _ = finish(mut staged, take omitted)?
    if version(snapshot(db)) != 0 {
        return Error(Foreign)
    }
    let _ = seal(mut db, take staged)?
    if version(snapshot(db)) != 1 || !typed_put(mut db, rows, 7, 6) {
        return Error(Foreign)
    }
    let mut found = find(result.unwrap(reader(db, 0u64)), snapshot(db), ix, Included(2), Included(2))?
    if next(law_reader(found.capture), mut found)? != Some((7, 6)) || next(law_reader(found.capture), mut found)? != None {
        return Error(Foreign)
    }
    let before = version(snapshot(db))
    let mut refused = declare(db, Migrate)?
    let extra = declare_table(mut refused, "extra", key, value)?
    let _ = finish(mut refused, take extra)?
    match seal(mut db, take refused) {
        Error(Undeclared(name)) if name == "items" => (),
        _ => return Error(Foreign),
    }
    if version(snapshot(db)) != before {
        return Error(Foreign)
    }
    let mut opened = declare(db, Open)?
    let opened_table = declare_table(mut opened, "extra", key, value)
    match take opened_table {
        Error(Missing(name)) if name == "extra" => (),
        _ => return Error(Foreign),
    }
    // §1.2: an application name in the reserved hirsel. namespace is
    // Missing(name), even in Migrate, so no reserved table is handed out
    // as a TableDecl that index could extend.
    let mut reserved = declare(db, Migrate)?
    match declare_table(mut reserved, "hirsel.items", key, value) {
        Error(Missing(name)) if name == "hirsel.items" => (),
        _ => return Error(Foreign),
    }
    if version(snapshot(db)) != before {
        return Error(Foreign)
    }
    let mut stale = declare(db, Open)?
    let mut declared_items = declare_table(mut stale, "items", key, value)?
    let _ = index(mut stale, mut declared_items, "bucket", Many, code.describe(bucket_keys), key)?
    let _ = finish(mut stale, take declared_items)?
    let declared_omitted = declare_table(mut stale, "omitted", key, value)?
    let _ = finish(mut stale, take declared_omitted)?
    if !typed_put(mut db, rows, 8, 10) {
        return Error(Foreign)
    }
    match seal(mut db, take stale) {
        Error(Foreign) => (),
        _ => return Error(Foreign),
    }
    let mut renamed = declare_migration(db, tasks, code.describe(declaration_law_rename))?
    let mut table_decl = declare_table(mut renamed, "renamed", key, value)?
    let _ = index(mut renamed, mut table_decl, "bucket", Many, code.describe(bucket_keys), key)?
    let new_handle = finish(mut renamed, take table_decl)?
    let untouched = declare_table(mut renamed, "omitted", key, value)?
    let _ = finish(mut renamed, take untouched)?
    let pre_rename = snapshot(db)
    let _ = seal(mut db, take renamed)?
    let after = snapshot(db)
    if version(after) != version(pre_rename) + 1 || get(result.unwrap(reader(db, 0u64)), after, new_handle, 7)? != Some(6) || get(result.unwrap(reader(db, 0u64)), pre_rename, rows, 7)? != Some(6) {
        return Error(Foreign)
    }
    match get(result.unwrap(reader(db, 0u64)), after, rows, 7) {
        Error(Stale(_)) => Ok(()),
        _ => Error(Foreign),
    }
}

fn backfill_keys(key: u64, value: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, value)
    list.push(mut keys, value)
    Ok(take keys)
}

fn unique_backfill_case(c: Clock, rows: u64, duplicate: Option[u64]) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let key = std.codec.key_u64()
    let value = std.codec.of_u64()
    let mut initial = declare(db, Migrate)?
    let first_decl = declare_table(mut initial, "rows", key, value)?
    let primary_table = finish(mut initial, take first_decl)?
    let _ = seal(mut db, take initial)?
    let result = run(mut db, None, (primary_table, rows, duplicate), fn(mut tx, input) -> Result[(), Error] {
        for i in 0u64 .. input.1 {
            put(mut tx, input.0, i, if input.2 == Some(i) {
                0u64
            } else {
                i
            })?
        }
        Ok(())
    })?
    if let Committed(_) = result {} else {
        return Error(MigrationFault)
    }
    let before = snapshot(db)
    let mut declaration = declare(db, Migrate)?
    let mut target_decl = declare_table(mut declaration, "rows", key, value)?
    let added = index(mut declaration, mut target_decl, "unique", Unique, code.describe(backfill_keys), key)
    if let Some(_) = duplicate {
        match take added {
            Error(Conflict(name)) if name == "unique" => (),
            _ => return Error(MigrationFault),
        }
        match seal(mut db, take declaration) {
            Error(Conflict(name)) if name == "unique" => (),
            _ => return Error(MigrationFault),
        }
        let after = snapshot(db)
        if version(before) != version(after) || pages.tree_stamp(before.roots.catalog) != pages.tree_stamp(after.roots.catalog) || pages.tree_stamp(before.roots.collections) != pages.tree_stamp(after.roots.collections) {
            return Error(MigrationFault)
        }
        return Ok(())
    }
    let ix = added?
    let _ = finish(mut declaration, take target_decl)?
    let _ = seal(mut db, take declaration)?
    let after = snapshot(db)
    let mut cursor = byte_cursor(after.roots.collections, Included(prefix(ix.id)?), prefix(ix.id + 1)?)?
    for expected in 0u64 .. rows {
        let Some((index_key, raw)) = next_bytes(mut cursor)? else {
            return Error(MigrationFault)
        }
        if list.len(index_key) != 12 || list.len(raw) != 12 || format.read_le(raw, 0, 4) != 8 {
            return Error(MigrationFault)
        }
        let j: u64 = list.word_be(index_key, 4)
        let k: u64 = list.word_be(raw, 4)
        if j != expected || k != expected {
            return Error(MigrationFault)
        }
    }
    if let Some(_) = next_bytes(mut cursor)? {
        return Error(MigrationFault)
    }
    Ok(())
}

fn law_unique_backfill(c: Clock) -> Result[(), Error] waits {
    let sizes: Inline[u64, 6] =[0, 1, 4095, 4096, 4097, 12289]
    let duplicates: Inline[u64, 10] =[1, 4095, 4096, 4097, 8191, 8192, 8193, 12287, 12288, 2]
    for rows in sizes {
        unique_backfill_case(c, rows, None)?
        for duplicate in duplicates {
            if duplicate < rows {
                unique_backfill_case(c, rows, Some(duplicate))?
            }
        }
    }
    Ok(())
}

fn stable_cover_key(key: u64, value: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, key)
    Ok(take keys)
}

fn cover_sum(key: u64, value: u64) -> Result[u64, Capacity] {
    Ok(key + value)
}

fn assert_cover_bytes(db: Db, index_id: u32, key: u64, expected: u64) -> Result[(), Error] {
    let mut logical = prefix(index_id)?
    list.put_word_be(mut logical, key)
    list.put_word_be(mut logical, key)
    let s = snapshot(db)
    let Some(raw) = pages.get_page_row(s.roots.collections, logical) else {
        return Error(MigrationFault)
    }
    if list.len(raw) != 10 || format.read_le(raw, 0, 2) != 0 || format.read_le(raw, 2, 8) != expected {
        return Error(MigrationFault)
    }
    Ok(())
}

// What changed between the release that built the index and this one.
type Drift = DriftExtractor | DriftProjection | DriftDefault | DriftFrom | DriftListFingerprint | DriftDefaultFingerprint | DriftKeyFingerprint

// A u64 on the wire as `{v, w: u64 = 7}`, read back as v + w: a row codec
// whose default and `via`-style `from` are the parts each drift changes.
fn drift_put(x: u64, mut out: Bytes) -> Result[(), std.codec.EncodeError] {
    std.codec.put_u64(x, mut out)
    std.codec.put_u64(0, mut out)
    Ok(())
}

fn drift_take(b: Bytes, mut at: u64) -> Result[u64, std.codec.DecodeError] {
    let v = std.codec.take_u64(b, mut at)?
    Ok(v + std.codec.take_u64(b, mut at)?)
}

fn drift_take_shifted(b: Bytes, mut at: u64) -> Result[u64, std.codec.DecodeError] {
    Ok(drift_take(b, mut at)? + 1000)
}

fn drift_schema(mut s: std.codec.Schema, c: std.codec.Codec[u64]) -> Result[(), std.codec.EncodeError] {
    drift_fields(mut s, 7)
}

fn drift_schema_eight(mut s: std.codec.Schema, c: std.codec.Codec[u64]) -> Result[(), std.codec.EncodeError] {
    drift_fields(mut s, 8)
}

fn drift_fields(mut s: std.codec.Schema, w: u64) -> Result[(), std.codec.EncodeError] {
    std.codec.define(mut s, "store.Drift", 0)?
    if std.codec.record(mut s, 2)? {
        return Ok(())
    }
    std.codec.field(mut s, "v")?
    std.codec.schema_u64(mut s)
    std.codec.field_default(mut s, "w", std.codec.of_u64(), w)?
    std.codec.close(mut s)
    Ok(())
}

fn drift_codec(drift: Drift) -> std.codec.Codec[u64] {
    match drift {
        DriftDefault => std.codec.make(code.describe(drift_put), code.describe(drift_take), code.describe(drift_schema_eight), 16),
        DriftFrom => std.codec.make(code.describe(drift_put), code.describe(drift_take_shifted), code.describe(drift_schema), 16),
        _ => std.codec.make(code.describe(drift_put), code.describe(drift_take), code.describe(drift_schema), 16),
    }
}

// The release `hirsel store verify --release` runs: its row codec is the
// drift's, its extractor and projection the original ones.
fn drift_release_with(mut d: Declare, value: std.codec.Codec[u64]) -> Result[(), Error] {
    d.versioned = true
    let key = std.codec.key_u64()
    let mut rows = declare_table(mut d, "rows", key, value)?
    let _ = covering(mut d, mut rows, "cover", Many, code.describe(stable_cover_key), key, code.describe(cover_sum), std.codec.of_u64())?
    let _ = finish(mut d, take rows)?
    Ok(())
}

fn drift_release(mut d: Declare) -> Result[(), Error] {
    drift_release_with(mut d, drift_codec(DriftExtractor))
}

fn drift_release_default(mut d: Declare) -> Result[(), Error] {
    drift_release_with(mut d, drift_codec(DriftDefault))
}

fn drift_release_from(mut d: Declare) -> Result[(), Error] {
    drift_release_with(mut d, drift_codec(DriftFrom))
}

fn covering_revision_case(d: Dir, c: Clock, r: Random, tasks: Tasks, drift: Drift) -> Result[(), Error] waits {
    match drift {
        DriftListFingerprint => return fingerprint_list_case(disk_test_directory(d), c, r, tasks),
        DriftDefaultFingerprint => return fingerprint_default_case(c),
        DriftKeyFingerprint => return fingerprint_key_case(c),
        _ => (),
    }
    let mut db = test_db(c, 1073741824)
    let key = std.codec.key_u64()
    let value = drift_codec(DriftExtractor)
    let payload = std.codec.of_u64()
    // Each declaration records revisions, as one over a disk store does.
    let mut initial = declare(db, Migrate)?
    initial.versioned = true
    let mut first_decl = declare_table(mut initial, "rows", key, value)?
    let ix = covering(mut initial, mut first_decl, "cover", Many, code.describe(stable_cover_key), key, code.describe(cover_sum), payload)?
    let primary_table = finish(mut initial, take first_decl)?
    let _ = seal(mut db, take initial)?
    if !typed_put(mut db, primary_table, 5, 7) {
        return Error(MigrationFault)
    }
    assert_cover_bytes(db, ix.id, 5, 12)?
    if !typed_put(mut db, primary_table, 5, 8) {
        return Error(MigrationFault)
    }
    assert_cover_bytes(db, ix.id, 5, 13)?
    // Use the catalog bytes a previous release would leave. Its function names
    // match and one revision differs: forged for the extractor or projection,
    // the row codec's own for a default or `from` this release changes. Give
    // its entry a different payload too.
    let mut prior = schema_plan(db)
    let mut record = catalog_entry_in(prior.roots.catalog, ix.catalog_key)?
    let mut prior_revision: Bytes = list.new()
    list.fill(mut prior_revision, 32, 1u8)
    match drift {
        DriftExtractor => {
            record.revision = take prior_revision
        },
        DriftProjection => {
            if let CatalogIndex(mut index_meta) = record.record {
                index_meta.projection = Some((failure_result_from_rep(types.copied(code.identity(code.describe(cover_sum))))?, take prior_revision))
            } else {
                return Error(failure_from_rep(pages.malformed(0)))
            }
        },
        _ => (),
    }
    let raw = encode_catalog(record)?
    prior.roots = catalog_insert(mut prior.next_node, pages.share_roots(prior.roots), ix.catalog_key, raw)?
    let mut fake_key = prefix(ix.id)?
    list.put_word_be(mut fake_key, 5u64)
    list.put_word_be(mut fake_key, 5u64)
    let mut fake_payload: Bytes = list.new()
    list.put_word_le(mut fake_payload, 0u16)
    list.put_word_le(mut fake_payload, 99u64)
    let _ = failure_result_from_rep(pages.put_page_row(mut prior.roots.collections, fake_key, fake_payload, prior.next_node + 1, mut prior.next_node))?
    prior.changed = true
    let _ = publish_schema_plan(mut db, take prior)?
    let now = drift_codec(drift)
    let read_modes: Inline[Mode, 2] =[Open, Follower]
    for mode in read_modes {
        let mut opened = declare(db, Open)?
        opened.mode = mode
        opened.versioned = true
        let mut open_decl = declare_table(mut opened, "rows", key, now)?
        match covering(mut opened, mut open_decl, "cover", Many, code.describe(stable_cover_key), key, code.describe(cover_sum), payload) {
            Error(Changed(name)) if name == "cover" => (),
            _ => return Error(MigrationFault),
        }
    }
    // `hirsel store verify --release` (Appendix A's store): this release
    // declares in verify mode, which names `cover` as changed instead of
    // refusing, and a report walk under its binding finds the stale entry,
    // from row 5 (rows phase) and again from the entry (entries phase).
    // Row 5 projects 5 + 8 = 13 (5 + 1008 under DriftFrom); the entry holds 99.
    let schema = match drift {
        DriftDefault => code.describe(drift_release_default),
        DriftFrom => code.describe(drift_release_from),
        _ => code.describe(drift_release),
    }
    let head = version(snapshot(db))
    let found = verify_release(mut db, schema)?
    if list.len(found.changed) != 1 || found.changed[0] != "cover" || list.len(found.faults) != 0 {
        return Error(MigrationFault)
    }
    if list.len(found.findings) != 2 || version(snapshot(db)) != head {
        return Error(MigrationFault)
    }
    for f in found.findings {
        if f.index != "cover" || f.entry != fake_key {
            return Error(MigrationFault)
        }
        if let Payload = f.fault {} else {
            return Error(MigrationFault)
        }
    }
    let mut migration = declare(db, Migrate)?
    migration.versioned = true
    let mut rebuilt_decl = declare_table(mut migration, "rows", key, now)?
    let rebuilt = covering(mut migration, mut rebuilt_decl, "cover", Many, code.describe(stable_cover_key), key, code.describe(cover_sum), payload)?
    let _ = finish(mut migration, take rebuilt_decl)?
    let _ = seal(mut db, take migration)?
    if rebuilt.id == ix.id {
        return Error(MigrationFault)
    }
    // The rebuild reads row 5 = 8 through this release's codec.
    let expected = match drift {
        DriftFrom => 1013u64,
        _ => 13u64
    }
    assert_cover_bytes(db, rebuilt.id, 5, expected)
}

@test
fn test_index_declaration_laws(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    law_unique_backfill(c)?
    covering_revision_case(d, c, r, tasks, DriftExtractor)?
    covering_revision_case(d, c, r, tasks, DriftProjection)?
    covering_revision_case(d, c, r, tasks, DriftDefault)?
    covering_revision_case(d, c, r, tasks, DriftFrom)?
    covering_revision_case(d, c, r, tasks, DriftListFingerprint)?
    covering_revision_case(d, c, r, tasks, DriftDefaultFingerprint)?
    covering_revision_case(d, c, r, tasks, DriftKeyFingerprint)
}

fn conflict_first(key: u64, value: (u64, u64)) -> Result[List[u64], Capacity] {
    backfill_keys(key, value.0)
}

fn conflict_second(key: u64, value: (u64, u64)) -> Result[List[u64], Capacity] {
    backfill_keys(key, value.1)
}

fn conflict_many(key: u64, value: (u64, u64)) -> Result[List[u64], Capacity] {
    backfill_keys(key, (value.0 + value.1) % 4)
}

fn conflict_setup(mut db: Db) -> Result[Table[u64, (u64, u64)], Error] waits {
    let mut schema = declare(db, Migrate)?
    let codec: std.codec.Codec[(u64, u64)] = std.codec.of()
    let key = std.codec.key_u64()
    let mut item_decl = declare_table(mut schema, "items", key, codec)?
    let _ = index(mut schema, mut item_decl, "z_first", Unique, code.describe(conflict_first), key)?
    let _ = index(mut schema, mut item_decl, "a_second", Unique, code.describe(conflict_second), key)?
    let _ = index(mut schema, mut item_decl, "many", Many, code.describe(conflict_many), key)?
    let items = finish(mut schema, take item_decl)?
    let _ = seal(mut db, take schema)?
    Ok(take items)
}

fn put_conflict_sequence(mut tx: Tx, items: Table[u64, (u64, u64)]) -> Result[(), Error] {
    put(mut tx, items, 1, (1, 2))?
    put(mut tx, items, 2, (3, 4))?
    let _ = delete(mut tx, items, 2)?
    put(mut tx, items, 4, (3, 4))?
    put(mut tx, items, 1, (1, 2))?
    let before = (tx.resident, tx.frame_bytes, tx.ids, tx.rows)
    match put(mut tx, items, 3, (1, 4)) {
        Error(Conflict(name)) if name == "z_first" => (),
        _ => return Error(MigrationFault),
    }
    if (tx.resident, tx.frame_bytes, tx.ids, tx.rows) != before {
        return Error(MigrationFault)
    }
    match delete(mut tx, items, 1) {
        Error(Conflict(name)) if name == "z_first" => (),
        _ => return Error(MigrationFault),
    }
    match put(mut tx, items, 5, (5, 6)) {
        Error(Conflict(name)) if name == "z_first" => (),
        _ => return Error(MigrationFault),
    }
    if (tx.resident, tx.frame_bytes, tx.ids, tx.rows) != before {
        return Error(MigrationFault)
    }
    Ok(())
}

@test
fn test_unique_conflict_atomic(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let items = conflict_setup(mut db)?
    let before = version(snapshot(db))
    let reads: core.Log[Read] = log.new()
    let issued: core.Cell[u64] = cell.new(0)
    let keep: Option[fn(Error) -> bool] = None
    let attempt = call_attempt(pages.holder_heads(db.holders)[0].roots.collections.root, db.writer_pin_bytes, 0)
    let no_pins: Map[TieredCacheKey, Arc[format.TieredFrame]] = map.new()
    let staged = draft_body(db, db.indexes, pages.holder_heads(db.holders)[0].roots, next_call_info(db), keep, reads, issued, attempt, no_pins, scoped fn(mut tx: Tx) -> Result[(), Error] {
        tx.frame_bytes = Some(42)
        put_conflict_sequence(mut tx, items)
    })
    match take staged {
        RolledBack(Failed(Conflict(name))) if name == "z_first" => (),
        _ => return Error(MigrationFault),
    }
    let observed = log.finish(take reads)
    if list.len(observed) != 6 {
        return Error(MigrationFault)
    }
    for probe in observed {
        if let Point(key) = probe {
            if list.len(key) != 12 {
                return Error(MigrationFault)
            }
        } else {
            return Error(MigrationFault)
        }
    }
    let attempted = run(mut db, None, items, fn(mut tx, handle) -> Result[(), Error] {
        put_conflict_sequence(mut tx, handle)
    })?
    match take attempted {
        Failed(Conflict(name)) if name == "z_first" => (),
        _ => return Error(MigrationFault),
    }
    let unchanged = snapshot(db)
    if version(unchanged) != before || get(result.unwrap(reader(db, 0)), unchanged, items, 1)? != None {
        return Error(MigrationFault)
    }
    let stream = law_stream_bytes(types.key_word(23), keyed_time(db))
    let request = request_digest(stream, stream)
    let admitted = admit_law_stream(mut db, stream, 0, request)?
    let Admitted(take complete) = take admitted else {
        return Error(MigrationFault)
    }
    let plan = Plan(n_e: 1048576, s_e: 1048576, reply_max: 16)
    let served = serve(mut db, take complete, plan, None, items, fn(mut tx, handle) -> Result[Bytes, Bytes] {
        result.unwrap(put_conflict_sequence(mut tx, handle))
        Error(types.key_word(7))
    })
    match take served {
        Ok(Kept(receipt)) if receipt.reply == types.key_word(7) => (),
        _ => return Error(MigrationFault),
    }
    if get(result.unwrap(reader(db, 0)), snapshot(db), items, 1)? != None {
        return Error(MigrationFault)
    }
    let next_admission = admit_law_stream(mut db, stream, 1, request)?
    let Admitted(take next_completion) = take next_admission else {
        return Error(MigrationFault)
    }
    let staged_base = version(snapshot(db))
    let next_result = serve(mut db, take next_completion, plan, None, items, fn(mut tx, handle) -> Result[Bytes, Bytes] {
        result.unwrap(put_conflict_sequence(mut tx, handle))
        Ok(types.key_word(8))
    })
    match take next_result {
        Ok(Failed(_, Conflict(name))) if name == "z_first" => (),
        _ => return Error(MigrationFault),
    }
    if version(snapshot(db)) != staged_base {
        return Error(MigrationFault)
    }
    Ok(())
}

fn typed_read_keys(k: (u8, u64), value: u64) -> Result[List[(u8, u64)], Capacity] {
    let mut keys: List[(u8, u64)] = list.new()
    list.push(mut keys, (k.0, value % 2))
    Ok(take keys)
}

fn typed_read_owner(k: (u8, u64), value: u64) -> Result[List[u64], Capacity] {
    backfill_keys(k.1, k.1)
}

fn typed_read_payload(k: (u8, u64), value: u64) -> Result[u64, Capacity] {
    Ok(k.1 + value)
}

fn typed_cursor_case(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let key: std.codec.Key[(u8, u64)] = std.codec.key_of()
    let value = std.codec.of_u64()
    let mut schema = declare(db, Migrate)?
    let mut item_decl = declare_table(mut schema, "items", key, value)?
    let covering_index = covering(mut schema, mut item_decl, "cover", Many, code.describe(typed_read_keys), key, code.describe(typed_read_payload), value)?
    let unique_index = covering_row(mut schema, mut item_decl, "owner", Unique, code.describe(typed_read_owner), std.codec.key_u64())?
    let items = finish(mut schema, take item_decl)?
    let _ = seal(mut db, take schema)?
    let inserted = run(mut db, None, items, fn(mut tx, target) -> Result[(), Error] {
        put(mut tx, target, (255u8, 1u64), 11)?
        put(mut tx, target, (255u8, 2u64), 13)?
        put(mut tx, target, (0u8, 20u64), 17)?
        if count(tx, target, Included((255u8, 0u64)), Unbounded)? != 2 {
            return Error(MigrationFault)
        }
        Ok(())
    })?
    if let Committed(_) = inserted {} else {
        return Error(MigrationFault)
    }
    let at = snapshot(db)
    let read_handle = reader(db, 0)?
    let observed = look(read_handle, at, None, (items, covering_index, unique_index), fn(tx, input) -> Result[(), Error] {
        let pair = (255u8, 1u64)
        let leading: std.codec.Key[u8] = std.codec.key_of()
        if fetch(tx, input.0, pair)? != Some(11u64) {
            return Error(MigrationFault)
        }
        let mut table_cursor = range_prefix(tx, input.0, 255u8, leading)?
        if next_in(tx, mut table_cursor)? != Some((pair, 11u64)) || next_in(tx, mut table_cursor)? != Some(((255u8, 2u64), 13u64)) || next_in(tx, mut table_cursor)? != None {
            return Error(MigrationFault)
        }
        match range_prefix(tx, input.0, 255u64, std.codec.key_u64()) {
            Error(Schema(0)) => (),
            _ => return Error(MigrationFault),
        }
        let mut joined = lookup_prefix(tx, input.1, 255u8, leading)?
        if next_indexed(mut joined)? != Some((pair, 11u64)) {
            return Error(MigrationFault)
        }
        let mut covering_cursor = entries(tx, input.1, Included(pair), Included(pair))?
        if next_entry(mut covering_cursor)? != Some((pair, pair, 12u64)) || next_entry(mut covering_cursor)? != Some((pair, (255u8, 2u64), 15u64)) || next_entry(mut covering_cursor)? != None {
            return Error(MigrationFault)
        }
        let mut owners = entries(tx, input.2, Included(2), Included(2))?
        if next_entry(mut owners)? != Some((2u64, (255u8, 2u64), 13u64)) || next_entry(mut owners)? != None {
            return Error(MigrationFault)
        }
        Ok(())
    })?
    match take observed {
        Seen(Seen(value: Ok(()), reads: observed_reads, ..)) => {
            let mut points = 0u64
            for cursor_read in observed_reads {
                if let Point(_) = cursor_read {
                    points += 1
                }
            }
            if points != 2 {
                return Error(MigrationFault)
            }
        },
        _ => return Error(MigrationFault),
    }
    Ok(())
}

@test
fn test_typed_read_laws(c: Clock) -> Result[(), Error] waits {
    if !law_typed_model(c) || !law_schema_numbers(c) || !lookup_cover_points(c) {
        return Error(MigrationFault)
    }
    typed_cursor_case(c)
}

fn preview_law_schema(mut d: Declare) -> Result[(), Error] {
    let key = std.codec.key_u64()
    let mut rows = declare_table(mut d, "rows", key, std.codec.of_u64())?
    let _ = index(mut d, mut rows, "unique", Unique, code.describe(backfill_keys), key)?
    let _ = finish(mut d, take rows)?
    Ok(())
}

@test
fn test_migration_preview_conflict(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut db = open(tasks, directory, c, r, options)?
    let mut initial = declare(db, Migrate)?
    let declared = declare_table(mut initial, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = finish(mut initial, take declared)?
    let _ = seal(mut db, take initial)?
    let saved = run(mut db, None, rows, fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 9u64, 22u64)?
        put(mut tx, t, 3u64, 22u64)?
        put(mut tx, t, 5u64, 17u64)
    })?
    let Committed(done) = saved else {
        return Error(MigrationFault)
    }
    durable(mut db, done.ticket)?
    let before = refusal_directory(directory)
    let head = version(snapshot(db))
    let result = preview_migration(db, tasks, None, code.describe(preview_law_schema))?
    if let Some(_) = result.failure {
        return Error(MigrationFault)
    }
    if list.len(result.changes) != 1u64 || list.len(result.backfills) != 1u64 {
        return Error(MigrationFault)
    }
    let CollectionAdded(added) = result.changes[0] else {
        return Error(MigrationFault)
    }
    let backfill = result.backfills[0]
    let Conflict(keys) = backfill.outcome else {
        return Error(MigrationFault)
    }
    if added.kind != 2u8 || added.name != "unique" || backfill.table != "rows" || backfill.index != Some("unique") || backfill.read != 3u64 || backfill.written != 2u64 || keys.first != b"\x00\x00\x00\x00\x00\x00\x00\x03" || keys.second != b"\x00\x00\x00\x00\x00\x00\x00\x09" || head != version(snapshot(db)) || !refusal_directory_unchanged(directory, before) {
        return Error(MigrationFault)
    }
    Ok(())
}

// What attention reports for the one index "bucket": 0 for Public, 1 for
// Backfilling(None), as a demotion leaves it, and 2 for anything else.
fn bucket_reported(db: Db) -> Result[u8, Error] {
    let reported = attention(db)?.indexes
    if list.len(reported) != 1 || reported[0].index != "bucket" {
        return Ok(2)
    }
    Ok(match reported[0].state {
        Public => 0u8,
        Backfilling(None) => 1u8,
        _ => 2u8,
    })
}

// §I.3: a raw delete removes row 7's one "bucket" entry (6 % 4 = 2); writing
// 5 moves the row to bucket 1, so the old entry's remove finds no target. The
// write fails with Drift, attention counts it, and the index is demoted:
// reads refuse until the builder rebuilds it, and then the write commits.
@test
fn test_index_drift_counted(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let key = std.codec.key_u64()
    let mut d = declare(db, Migrate)?
    let mut items = declare_table(mut d, "items", key, std.codec.of_u64())?
    let ix = index(mut d, mut items, "bucket", Many, code.describe(bucket_keys), key)?
    let rows = finish(mut d, take items)?
    let _ = seal(mut db, take d)?
    if !typed_put(mut db, rows, 7, 6) {
        return Error(Foreign)
    }
    let index_id = ix.id
    let cut = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[u64, Error] {
        let mut found = 0u64
        let mut target: Bytes = list.new()
        {
            let mut cursor = byte_cursor(tx.roots.collections, Included(prefix(index_id)?), prefix(index_id + 1)?)?
            while let Some((row_key, _)) = next_bytes(mut cursor)? {
                found += 1
                target = failure_result_from_rep(types.copied(row_key))?
            }
        }
        let Some(refund) = delete_refund(tx, target)? else {
            return Error(Missing("bucket entry"))
        }
        let frame = edit_frame(tx.ops, tx.below, tx.extra_bytes, target, None, tx.frame_bytes, types.transaction_limit(limits_to_rep(tx.limits)))?
        apply_delete(mut tx, take target, refund)?
        tx.frame_bytes = frame
        Ok(found)
    })?
    match take cut {
        Committed(done) => if done.value != 1 {
            return Error(Foreign)
        },
        _ => return Error(Foreign),
    }
    if list.len(attention(db)?.drift) != 0 || bucket_reported(db)? != 0 {
        return Error(Foreign)
    }
    let moved = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 7, 5)
    })?
    match take moved {
        Failed(Drift(name)) if name == "bucket" => (),
        _ => return Error(Foreign),
    }
    let seen = attention(db)?.drift
    if list.len(seen) != 1 || seen[0].index != "bucket" || seen[0].count != 1 || seen[0].demoted != 1 || typed_value(snapshot(db), rows, 7) != 6 || bucket_reported(db)? != 1 {
        return Error(Foreign)
    }
    match find(result.unwrap(reader(db, 0u64)), snapshot(db), ix, Unbounded, Unbounded) {
        Error(NotReady(name)) if name == "bucket" => (),
        _ => return Error(Foreign),
    }
    while let Some(_) = index_build_step(mut db, 16)? {}
    let rebuilt_seen = attention(db)?.drift
    if bucket_reported(db)? != 0 || list.len(rebuilt_seen) != 1 || rebuilt_seen[0].count != 1 || rebuilt_seen[0].demoted != 1 {
        return Error(Foreign)
    }
    if !typed_put(mut db, rows, 7, 5) || typed_value(snapshot(db), rows, 7) != 5 {
        return Error(Foreign)
    }
    let mut rebuilt = find(result.unwrap(reader(db, 0u64)), snapshot(db), ix, Included(1), Included(1))?
    if next(law_reader(rebuilt.capture), mut rebuilt)? != Some((7u64, 5u64)) {
        return Error(Foreign)
    }
    Ok(())
}

// ---- RTC-5: a subscriber leg's RTP header extensions ----
// The subscriber leg's extensions, written into the session's one reused writer
// (RTP-12): its MID value and, at send, the next number of its own transport
// (RTP-8). The publisher's MID, RID and transport number never pass. RTC-5's CVO,
// playout delay and abs-capture-time follow where the leg's section binds them; one
// that does not fit costs the packet only that extension.
fn leg_ext(mut p: PeerSession, now: u64, si: u64, size: u32, q: Paced) -> Result[(), PeerError] {
    let level = q.level
    let voice = q.voice
    let map = p.sections[si].map
    rtp.ext.reset(mut p.ext)
    let n = list.len(p.sections[si].mid)
    rtp.ext.put(mut p.ext, map, Mid, p.sections[si].mid, 0, n) ?=> |_| Rtp(Form)
    if let Some(l) = level {
        rtp.ext.put_level(mut p.ext, map, voice, l) ?=> |_| Rtp(Form)
    }
    if p.sections[si].twcc {
        let number = rtp.twcc.assign(mut p.send_log, now, size)
        p.numbered += 1
        list.clear(mut p.word)
        list.put_word_be(mut p.word, number)
        rtp.ext.put(mut p.ext, map, TransportSeq, p.word, 0, 2) ?=> |_| Rtp(Form)
    }
    if let Some(b) = q.cvo {
        let _ = rtp.ext.put_orientation(mut p.ext, map, b)
    }
    let t: u64 = int.widen(q.track)
    if let Media(guard: _) = q.stream {
        if t < list.len(p.tracks) {
            if let Some(d) = p.tracks[t].playout {
                let _ = rtp.ext.put_playout_delay(mut p.ext, map, d.min, d.max)
            }
        }
    }
    if let Some(c) = q.capture {
        let _ = rtp.ext.put_abs_capture_time(mut p.ext, map, c.ts, c.offset)
    }
    Ok(())
}

/// Set the static playout delay track `track` writes on its media packets (RTC-5),
/// or stop writing one. A delay outside 12 bits or with `min` above `max` is refused.
pub fn set_playout(mut p: PeerSession, track: u16, delay: Option[Delay]) -> bool {
    let t: u64 = int.widen(track)
    if t >= list.len(p.tracks) {
        return false
    }
    if let Some(d) = delay {
        if d.max > 4095 || d.min > d.max {
            return false
        }
    }
    p.tracks[t].playout = delay
    true
}

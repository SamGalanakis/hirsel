// FIPS 180-4 sections 5 and 6.2. Scalar compression adapted from RustCrypto
// sha2 0.10.9 src/sha256/soft_compact.rs:14-76. No CPU-specific operations.
const K: Inline[u32, 64] =[0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

pub opaque type Sha256 {
    h: Inline[u32, 8],
    pending: Inline[u8, 64],
    used: u64,
    total: u64
}

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

fn compress(mut h: Inline[u32, 8], mut w: Inline[u32, 64]) {
    for i in 16u64 .. 64u64 {
        let x = w[i - 15]
        let y = w[i - 2]
        let s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)
        let s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10)
        w[i] = int.wrapping_add(int.wrapping_add(int.wrapping_add(w[i - 16], s0), w[i - 7]), s1)
    }
    let mut a = h[0]
    let mut b = h[1]
    let mut c = h[2]
    let mut d = h[3]
    let mut e = h[4]
    let mut f = h[5]
    let mut g = h[6]
    let mut hh = h[7]
    for i in 0u64 .. 64u64 {
        let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        let ch = (e & f) ^ ((~e) & g)
        let t1 = int.wrapping_add(int.wrapping_add(int.wrapping_add(int.wrapping_add(hh, s1), ch), K[i]), w[i])
        let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = int.wrapping_add(s0, maj)
        hh = g
        g = f
        f = e
        e = int.wrapping_add(d, t1)
        d = c
        c = b
        b = a
        a = int.wrapping_add(t1, t2)
    }
    h[0] = int.wrapping_add(h[0], a)
    h[1] = int.wrapping_add(h[1], b)
    h[2] = int.wrapping_add(h[2], c)
    h[3] = int.wrapping_add(h[3], d)
    h[4] = int.wrapping_add(h[4], e)
    h[5] = int.wrapping_add(h[5], f)
    h[6] = int.wrapping_add(h[6], g)
    h[7] = int.wrapping_add(h[7], hh)
}

fn buffered(mut h: Inline[u32, 8], input: Inline[u8, 64]) {
    let mut w: Inline[u32, 64] =[0; 64]
    for i in 0u64 .. 16u64 {
        w[i] = inline.word_be(input, i * 4)
    }
    compress(mut h, mut w)
}

fn block(mut h: Inline[u32, 8], input: Bytes, at: u64) {
    let mut w: Inline[u32, 64] =[0; 64]
    for i in 0u64 .. 16u64 {
        w[i] = list.word_be(input, at + i * 4)
    }
    compress(mut h, mut w)
}

/// Initial SHA-256 state. Alloc: none. Cost: O(1).
pub fn start() -> Sha256 {
    Sha256(h:[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19], pending:[0; 64], used: 0, total: 0)
}

/// Append input[lo,hi), with list.slice's checked range semantics.
/// Alloc: none; retains no input view. Cost: O(hi-lo). Ex: `sha256.add(mut s, b, 0, list.len(b))`.
pub fn add(mut s: Sha256, input: Bytes, lo: u64, hi: u64) {
    let b = list.slice(input, lo, hi)
    let n = list.len(b)
    s.total = int.wrapping_add(s.total, n)
    let mut at: u64 = 0
    if s.used > 0 {
        let room = 64 - s.used
        let count = if n < room {
            n
        } else {
            room
        }
        for i in 0u64 .. count {
            s.pending[s.used + i] = b[i]
        }
        s.used += count
        at = count
        if s.used < 64 {
            return
        }
        buffered(mut s.h, s.pending)
        s.used = 0
    }
    while n - at >= 64 {
        block(mut s.h, b, at)
        at += 64
    }
    s.used = n - at
    for i in 0u64 .. s.used {
        s.pending[i] = b[at + i]
    }
}

/// Append one byte, as `add` of a one-byte input. Lets a caller frame its
/// input with tags and lengths without building a buffer.
/// Alloc: none. Cost: O(1), at most one compression block. Ex: `sha256.add_byte(mut s, 17)`.
pub fn add_byte(mut s: Sha256, x: u8) {
    s.total = int.wrapping_add(s.total, 1)
    s.pending[s.used] = x
    s.used += 1
    if s.used == 64 {
        buffered(mut s.h, s.pending)
        s.used = 0
    }
}

/// Thirty-two network-order digest bytes. Leaves s usable for further add calls.
/// Alloc: none. Cost: O(1), at most two compression blocks.
pub fn finish(s: Sha256) -> Inline[u8, 32] {
    let mut h = s.h
    let mut tail = s.pending
    tail[s.used] = 128
    for i in (s.used + 1) .. 64u64 {
        tail[i] = 0
    }
    if s.used >= 56 {
        buffered(mut h, tail)
        for i in 0u64 .. 64u64 {
            tail[i] = 0
        }
    }
    let bits = s.total << 3
    for i in 0u64 .. 8u64 {
        tail[56 + i] = int.truncate(bits >> ((7 - i) * 8))
    }
    buffered(mut h, tail)
    let mut out: Inline[u8, 32] =[0; 32]
    for i in 0u64 .. 32u64 {
        let shift: u32 = int.narrow(24 - (i % 4) * 8)
        out[i] = int.truncate(h[i / 4] >> shift)
    }
    out
}

/// FIPS 180-4 SHA-256 over all bytes. Alloc: none. Cost: O(n).
/// Ex: `sha256.hash(string.as_bytes("abc"))`.
pub fn hash(b: Bytes) -> Inline[u8, 32] {
    let mut s = start()
    add(mut s, b, 0, list.len(b))
    finish(s)
}

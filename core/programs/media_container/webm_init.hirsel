pub type TrackInfo {
    number: u64,
    kind: track.TrackKind,
    default_duration: u64,
    codec_delay: u64,
    seek_preroll: u64
}

pub type SegmentInfo {
    timestamp_scale: u64,
    next_element: u64,
    declared_end: Option[u64]
}

fn webm_float(input: Bytes, e: Element) -> Result[f64, Error] {
    let n = e.next - e.body
    let value = if n == 4 {
        let single = float.from_bits32(list.word_be(input, e.body))
        float.widen(single)
    } else if n == 8 {
        float.from_bits64(list.word_be(input, e.body))
    } else {
        return Error(InvalidElement)
    }
    if !float.is_finite(value) || float.lt(value, 0.0) {
        return Error(InvalidElement)
    }
    Ok(value)
}

fn track_info(input: Bytes, entry: Element, receive: scoped fn(TrackInfo, Bytes, Bytes)) -> Result[(), Error] {
    let mut number = 0u64
    let mut kind_number = 0u64
    let mut default_duration = 0u64
    let mut codec_delay = 0u64
    let mut seek_preroll = 0u64
    let mut width = 0u64
    let mut height = 0u64
    let mut channels = 0u64
    let mut sample_rate: Option[f64] = None
    let mut codec_lo = 0u64
    let mut codec_hi = 0u64
    let mut private_lo = 0u64
    let mut private_hi = 0u64
    let mut at = entry.body
    while at < entry.next {
        let e = read_element(input, at, entry.next)?
        if !e.known_size {
            return Error(InvalidTrack)
        }
        match e.id {
            0xd7 => {
                number = uint(input, e.body, e.next)?
            },
            0x83 => {
                kind_number = uint(input, e.body, e.next)?
            },
            0x23e383 => {
                default_duration = uint(input, e.body, e.next)?
            },
            0x56aa => {
                codec_delay = uint(input, e.body, e.next)?
            },
            0x56bb => {
                seek_preroll = uint(input, e.body, e.next)?
            },
            0x86 => {
                codec_lo = e.body
                codec_hi = e.next
            },
            0x63a2 => {
                private_lo = e.body
                private_hi = e.next
            },
            0xe0 => {
                let mut cursor = e.body
                while cursor < e.next {
                    let b = read_element(input, cursor, e.next)?
                    if !b.known_size {
                        return Error(InvalidTrack)
                    }
                    match b.id {
                        0xb0 => {
                            width = uint(input, b.body, b.next)?
                        },
                        0xba => {
                            height = uint(input, b.body, b.next)?
                        },
                        _ => {},
                    }
                    cursor = b.next
                }
            },
            0xe1 => {
                channels = 1
                sample_rate = Some(8000.0)
                let mut output_rate: Option[f64] = None
                let mut cursor = e.body
                while cursor < e.next {
                    let b = read_element(input, cursor, e.next)?
                    if !b.known_size {
                        return Error(InvalidTrack)
                    }
                    match b.id {
                        0xb5 => {
                            sample_rate = Some(webm_float(input, b)?)
                        },
                        0x78b5 => {
                            output_rate = Some(webm_float(input, b)?)
                        },
                        0x9f => {
                            channels = uint(input, b.body, b.next)?
                        },
                        _ => {},
                    }
                    cursor = b.next
                }
                if let Some(rate) = output_rate {
                    sample_rate = Some(rate)
                }
            },
            _ => {},
        }
        at = e.next
    }
    if number == 0 || kind_number == 0 || codec_lo == codec_hi {
        return Error(InvalidTrack)
    }
    let kind: track.TrackKind = if kind_number == TRACK_VIDEO {
        Video(width: width, height: height, rotation: None, hdr: track.empty_hdr())
    } else if kind_number == TRACK_AUDIO {
        Audio(channels: channels, sample_rate: sample_rate)
    } else {
        Other(kind_number)
    }
    let info = TrackInfo(number: number, kind: kind, default_duration: default_duration, codec_delay: codec_delay, seek_preroll: seek_preroll)
    receive(info, list.slice(input, codec_lo, codec_hi), list.slice(input, private_lo, private_hi))
    Ok(())
}

fn timestamp_scale(input: Bytes, info: Element) -> Result[u64, Error] {
    let mut at = info.body
    while at < info.next {
        let e = read_element(input, at, info.next)?
        if !e.known_size {
            return Error(InvalidElement)
        }
        if e.id == 0x2ad7b1 {
            let scale = uint(input, e.body, e.next)?
            if scale == 0 {
                return Error(InvalidElement)
            }
            return Ok(scale)
        }
        at = e.next
    }
    Ok(1000000)
}

fn doctype(input: Bytes, header: Element) -> Result[(), Error] {
    let mut at = header.body
    while at < header.next {
        let e = read_element(input, at, header.next)?
        if !e.known_size {
            return Error(InvalidElement)
        }
        if e.id == 0x4282 {
            let kind = list.slice(input, e.body, e.next)
            if kind == b"webm" || kind == b"matroska" {
                return Ok(())
            }
            return Error(Unsupported)
        }
        at = e.next
    }
    Error(InvalidElement)
}

// This takes the prefix through Segment Info and Tracks. A known Segment can
// declare bytes beyond the supplied window. The returned cursor is ready for
// the next Segment child and the byte loans cover each track's codec fields.
pub fn read_init(input: Bytes, at: u64, receive: scoped fn(TrackInfo, Bytes, Bytes)) -> Result[SegmentInfo, Error] {
    let limit = list.len(input)
    let ebml = read_element(input, at, limit)?
    if ebml.id != 0x1a45dfa3 || !ebml.known_size {
        return Error(InvalidElement)
    }
    doctype(input, ebml)?
    let segment = element_header(input, ebml.next, limit)?
    if segment.id != SEGMENT {
        return Error(InvalidElement)
    }
    let end_window = if segment.next < limit {
        segment.next
    } else {
        limit
    }
    let mut cursor = segment.body
    let mut info: Option[Element] = None
    let mut tracks: Option[Element] = None
    while cursor < end_window {
        let entry = read_element(input, cursor, end_window)?
        if !entry.known_size || entry.id == CLUSTER {
            return Error(Unsupported)
        }
        if entry.id == 0x1549a966 {
            info = Some(entry)
        } else if entry.id == 0x1654ae6b {
            tracks = Some(entry)
        }
        cursor = entry.next
        if let (Some(metadata), Some(entries)) = (info, tracks) {
            let scale = timestamp_scale(input, metadata)?
            let mut position = entries.body
            let mut found = false
            while position < entries.next {
                let track = read_element(input, position, entries.next)?
                if !track.known_size {
                    return Error(InvalidTrack)
                }
                if track.id == 0xae {
                    track_info(input, track, receive)?
                    found = true
                }
                position = track.next
            }
            if !found {
                return Error(InvalidTrack)
            }
            return Ok(SegmentInfo(timestamp_scale: scale, next_element: cursor, declared_end: element_next(segment)))
        }
    }
    Error(Truncated)
}

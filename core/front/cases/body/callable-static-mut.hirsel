pub fn generic_mut[T](f: StaticFn[fn(mut T)], mut x: T) {
    let _ = code.identity(f);
    let g = code.callable(f);
    g(mut x)
}

fn bump(mut n: u64) {
    n += 3u64
}

fn replace(mut s: String) {
    s = string.from("new")
}

pub fn two[T](f: StaticFn[fn(mut T, mut T)], mut x: T, mut y: T) {
    let _ = code.identity(f);
    let g = code.callable(f);
    g(mut x, mut y)
}

fn both(mut x: u64, mut y: u64) {
    x += 1u64;
    y += 2u64
}

type Pair {
    x: u64,
    y: u64
}

pub fn generic_scalar() -> u64 {
    let mut x = 4u64
    generic_mut(code.describe(bump), mut x)
    x
}

// expect: run generic_scalar() = 7
pub fn generic_string() -> u64 {
    let mut x = string.from("old value")
    generic_mut(code.describe(replace), mut x)
    list.len(string.as_bytes(x))
}

// expect: run generic_string() = 3
pub fn two_mut() -> u64 {
    let mut p = Pair(x: 3u64, y: 4u64)
    two(code.describe(both), mut p.x, mut p.y)
    p.x * 10u64 + p.y
}

// expect: run two_mut() = 46
resource type Cell {
    n: u64,
    expected: u64
} drop(c) {
    if c.n != c.expected {
        fail("last installed value changed")
    }
}

resource type Explode {
    zero: u64
} drop(b) {
    let _ = 1u64 / b.zero
}

fn before_write(mut c: Cell, take a: u64) {
    let bomb = result.unwrap(Explode(zero: 0u64))
}

fn after_write(mut c: Cell, take a: u64) {
    let bomb = result.unwrap(Explode(zero: 0u64));
    c.n = a
}

fn during_assignment(mut c: Cell, take a: u64) {
    c.n = failed_value()
}

fn failed_value() -> u64 {
    let bomb = result.unwrap(Explode(zero: 0u64));
    9u64
}

fn fail_call[A](f: StaticFn[fn(mut Cell, take A)], mut c: Cell, take a: A) {
    let _ = code.identity(f);
    let g = code.callable(f);
    g(mut c, take a)
}

pub fn failure_before_write() -> u64 {
    let caught = isolate(fn() -> u64 {
        let mut c = result.unwrap(Cell(n: 5u64, expected: 5u64))
        fail_call(code.describe(before_write), mut c, 9u64)
        99u64
    })
    match caught {
        Ok(Error(causes)) => {
            let mut count = 0u64;
            for cause in causes {
                count += 1u64
            };
            count
        },
        _ => 99u64,
    }
}

// expect: run failure_before_write() = 1
pub fn failure_after_write() -> u64 {
    let caught = isolate(fn() -> u64 {
        let mut c = result.unwrap(Cell(n: 5u64, expected: 9u64))
        fail_call(code.describe(after_write), mut c, 9u64)
        99u64
    })
    match caught {
        Ok(Error(causes)) => {
            let mut count = 0u64;
            for cause in causes {
                count += 1u64
            };
            count
        },
        _ => 99u64,
    }
}

// expect: run failure_after_write() = 1
pub fn failure_during_assignment() -> u64 {
    let caught = isolate(fn() -> u64 {
        let mut c = result.unwrap(Cell(n: 5u64, expected: 5u64))
        fail_call(code.describe(during_assignment), mut c, 9u64)
        99u64
    })
    match caught {
        Ok(Error(causes)) => {
            let mut count = 0u64;
            for cause in causes {
                count += 1u64
            };
            count
        },
        _ => 99u64,
    }
}
// expect: run failure_during_assignment() = 1

// CRC-32/ISO-HDLC check value (RevEng catalogue), the PNG IEND chunk
// (W3C PNG, Privacy Considerations example), and RFC 3720 B.4's byte ramp
// with the IEEE polynomial and expected residue from Python's binascii.crc32.
// expect: run ieee_vectors() = true
fn ieee_vectors() -> bool {
    let check = string.as_bytes("123456789")
    let iend = string.as_bytes("IEND")
    let ramp = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"
    if crc32.hash(check) != 0xcbf43926u32 || crc32.hash(iend) != 0xae426082u32 || crc32.hash(ramp) != 0x91267e8au32 {
        return false
    }
    for split in 0u64 .. 33 {
        let prefix = crc32.update(0, ramp, 0, split)
        if crc32.update(prefix, ramp, split, 32) != 0x91267e8au32 {
            return false
        }
    }
    crc32.hash(string.as_bytes("")) == 0
}

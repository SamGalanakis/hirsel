pub fn empty_replay_overlay(cold_next: Option[u64]) -> Arc[pages.ReplayOverlay] {
    arc.new(pages.ReplayOverlay(entries: std.omap.new(), cold_next: cold_next, floor: None, trims: std.omap.new(), ids: 0, charged: 0))
}

pub fn replay_overlay_at(overlay: Arc[pages.ReplayOverlay], logical: Bytes) -> Option[View[pages.ReplayRow]] in overlay {
    std.omap.get(overlay.entries, logical)
}

fn replay_value_width(stored: pages.ReplayValue) -> u64 {
    match stored {
        ReplayPut(bytes_value) => list.len(bytes_value),
        ReplayAbsent => 0,
    }
}

fn replay_value_prior(stored: pages.ReplayValue) -> u32 {
    match stored {
        ReplayPut(bytes_value) => int.truncate(1 + list.len(bytes_value)),
        ReplayAbsent => 0,
    }
}

// The Cold prior survives replacements and journaled forks.
pub fn replay_overlay_edit(mut overlay: Arc[pages.ReplayOverlay], path: String, at: u64, logical: Bytes, prior: u32, now: pages.ReplayValue) -> Result[(), types.Failure] {
    let charge = 24 + list.len(logical)
    let (base, removed) = match replay_overlay_at(overlay, logical) {
        Some(row) => {
            if replay_value_prior(row.now) != prior {
                return Error(format.disk_fault(path, at, Malformed))
            }
            (row.base, charge + replay_value_width(row.now))
        },
        None => (prior, 0u64),
    }
    let ready = manifest.disk_allocation(scoped fn() -> Result[Arc[pages.ReplayOverlay], types.Failure] {
        let mut ids = overlay.ids
        let row = pages.ReplayRow(base: base, now: clone(now))
        let (take overlay_entries, _) = std.omap.insert(mut ids, overlay.entries, clone(logical), take row)
        let charged = overlay.charged - removed + charge + replay_value_width(now)
        Ok(arc.new(pages.ReplayOverlay(entries: take overlay_entries, cold_next: overlay.cold_next, floor: overlay.floor, trims: clone(overlay.trims), ids: ids, charged: charged)))
    })?
    overlay = take ready
    Ok(())
}

pub type ReplayLogHead {
    first: u64,
    next: u64,
    cold_next: u64,
    row_bytes: u64
}

pub fn replay_overlay_count(overlay: Arc[pages.ReplayOverlay], low: Bytes, high: Bytes, base_count: u64) -> Result[u64, types.Failure] {
    if low >= high {
        return Ok(0u64)
    }
    manifest.disk_allocation(scoped fn() -> Result[u64, types.Failure] {
        let mut walked = std.omap.range(overlay.entries, Included(clone(low)), Excluded(clone(high)))
        let mut added = 0u64
        let mut removed = 0u64
        while let Some((_, row)) = std.omap.next(mut walked) {
            if let ReplayPut(_) = row.now {
                added += 1
            }
            if row.base != 0 {
                removed += 1
            }
        }
        let Some(surviving) = int.checked_sub(base_count, removed) else {
            return Error(format.disk_fault("overlay", 0, Malformed))
        }
        let Some(total) = int.checked_add(surviving, added) else {
            return Error(format.disk_fault("overlay", 0, Malformed))
        }
        Ok(total)
    })
}

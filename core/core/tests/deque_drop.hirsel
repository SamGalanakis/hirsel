// expect: stdout "DABC"
// expect: run normal_four3(out) = 4
fn normal_four3(out: Stdout) -> u64 { drop_ring(out, 4, 3, false) }

// expect: stdout "DABC"
// expect: run failed_four3(out) = fail Unwrap
fn failed_four3(out: Stdout) -> u64 { drop_ring(out, 4, 3, true) }

// Build capacity with silent resources, then test every partially live head.
fn drop_partial(out: Stdout, cap: u64, count: u64, head: u64, broken: bool) -> u64 {
    let mut d: Deque[DropLog] = deque.new()
    for i in 0u64 .. cap {
        result.unwrap(deque.push_back(mut d, result.unwrap(DropLog(out:out,id:i,broken:false,armed:false))))
    }
    while deque.len(d) != 0 { let _ = deque.pop_back(mut d) }
    for i in 0u64 .. count {
        result.unwrap(deque.push_back(mut d, result.unwrap(DropLog(out:out,id:i,broken:broken,armed:true))))
    }
    for _ in 0u64 .. head {
        let x = option.unwrap(deque.pop_front(mut d))
        result.unwrap(deque.push_back(mut d, take x))
    }
    count
}

// expect: stdout "A"
// expect: run partial_2_1_0_0(out) = 1
fn partial_2_1_0_0(out: Stdout) -> u64 { drop_partial(out, 2, 1, 0, false) }

// expect: stdout "A"
// expect: run partial_2_1_0_1(out) = fail Unwrap
fn partial_2_1_0_1(out: Stdout) -> u64 { drop_partial(out, 2, 1, 0, true) }


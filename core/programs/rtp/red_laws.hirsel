// RFC 2198 §3 layout, by hand. A redundant header is F=1 and the 7-bit PT, then a
// 14-bit timestamp offset and a 10-bit length: offset 320 is 0x05 then 0b000000
// in the high six bits of the third byte, and offset 16383 with length 1023 is
// every bit set.
// The RFC 2198 §4 example: LPC (PT 7) 320 ticks back as a 14-byte block behind a
// DVI4 (PT 5) primary of 6 bytes, in a buffer with 3 bytes before the payload.
fn rfc_example() -> Bytes {
    b"\xaa\xbb\xcc\x87\x05\x00\x0e\x05LLLLLLLLLLLLLLdddddd"
}

// An Opus chain: 3 bytes 1,920 ticks back, 300 bytes 960 back, then a 5-byte
// primary, every block PT 111 (0x6f). 1920 = 30 << 6, 960 = 15 << 6 and 300 =
// 0x12c, so the headers are ef 1e 00 03 and ef 0f 01 2c, then 6f.
fn opus_chain() -> Bytes {
    let mut b: Bytes = list.with_capacity(320)
    list.append(mut b, b"\xef\x1e\x00\x03\xef\x0f\x01\x2c\x6f")
    list.append(mut b, b"abc")
    list.fill(mut b, 300, 0x42u8)
    list.append(mut b, b"PRIME")
    b
}

fn expect_block(got: red.Block, pt: u8, offset: u16, at: u64, len: u64, take what: String) {
    if got.pt != pt || got.offset != offset || got.at != at || got.len != len {
        fail(take what)
    }
}

fn red_refused(pkt: Bytes, want: red.Error, take what: String) {
    let mut blocks: List[red.Block] = list.with_capacity(4)
    list.push(mut blocks, red.Block(pt: 0, offset: 0, at: 0, len: 0))
    let matched = match red.parse(pkt, 0, list.len(pkt), mut blocks) {
        Error(Short) => want == Short,
        Error(Overrun) => want == Overrun,
        Ok(_) => false,
    }
    if !matched || list.len(blocks) != 0 {
        fail(take what)
    }
    match red.primary(pkt, 0, list.len(pkt)) {
        Error(_) => {},
        Ok(_) => fail("primary accepts what parse refuses"),
    }
}

/// bug: Read the 14-bit offset or the 10-bit length across the wrong bits, take the first block for the primary, place a block's bytes from the start of the buffer rather than the payload, or accept a header or block length that runs past the payload.
/// oracle: RFC 2198 §3 and §4, by hand: the example's LPC block is PT 7, offset 320, 14 bytes at 8 and the DVI4 primary PT 5, 6 bytes at 22; the Opus chain's blocks are (111, 1920, 3 at 9), (111, 960, 300 at 12) and (111, 0, 5 at 312); offset 16383 and length 1023 set every bit of ff ff ff.
@test
fn red_parse() -> Result[(), ()] {
    let mut blocks: List[red.Block] = list.with_capacity(4)
    let rfc = rfc_example()
    result.unwrap(red.parse(rfc, 3, list.len(rfc) - 3, mut blocks))
    if list.len(blocks) != 2 {
        fail("the RFC example has two blocks")
    }
    expect_block(blocks[0], 7, 320, 8, 14, "the LPC block")
    expect_block(blocks[1], 5, 0, 22, 6, "the DVI4 primary")
    expect_block(result.unwrap(red.primary(rfc, 3, list.len(rfc) - 3)), 5, 0, 22, 6, "primary alone")
    let chain = opus_chain()
    result.unwrap(red.parse(chain, 0, list.len(chain), mut blocks))
    if list.len(blocks) != 3 {
        fail("the chain has three blocks")
    }
    expect_block(blocks[0], 111, 1920, 9, 3, "two back")
    expect_block(blocks[1], 111, 960, 12, 300, "one back")
    expect_block(blocks[2], 111, 0, 312, 5, "the chain's primary")
    // The widest header: offset 16383, length 1023, then a 1-byte primary.
    let mut wide: Bytes = list.with_capacity(1030)
    list.append(mut wide, b"\xef\xff\xff\xff\x6f")
    list.fill(mut wide, 1024, 7u8)
    result.unwrap(red.parse(wide, 0, list.len(wide), mut blocks))
    expect_block(blocks[0], 111, 16383, 5, 1023, "every offset and length bit")
    expect_block(blocks[1], 111, 0, 1028, 1, "a 1-byte primary")
    // A primary of zero bytes is legal (RFC 2198 leaves its length to the packet).
    result.unwrap(red.parse(b"\x6f", 0, 1, mut blocks))
    expect_block(blocks[0], 111, 0, 1, 0, "an empty primary")
    red_refused(b"", Short, "no payload")
    red_refused(b"\xef\x1e\x00", Short, "a cut redundant header")
    red_refused(b"\xef\x1e\x00\x03", Short, "no final header")
    red_refused(b"\xef\x1e\x00\x03\xef\x0f\x01\x2c", Short, "two headers and no final one")
    red_refused(b"\xef\x1e\x00\x03\x6fab", Overrun, "a 3-byte block in 2 bytes")
    red_refused(b"\xef\x1e\x00\x03\xef\x0f\x01\x2c\x6fabc", Overrun, "the chain cut after its first block")
    Ok(())
}

fn red_keep(mut r: red.Ring, index: u64, ts: u32, take data: Bytes) {
    red.keep(mut r, index, ts, data, 0, list.len(data))
}

fn red_written(r: red.Ring, index: u64, ts: u32, take primary: Bytes, distance: u8, since: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(1500)
    let n = result.unwrap(red.write(mut out, 111, r, index, ts, primary, 0, list.len(primary), distance, since))
    if n != list.len(out) {
        fail("write's length is the payload's")
    }
    out
}

fn red_same(got: Bytes, want: Bytes, take what: String) {
    if got != want {
        fail(take what)
    }
}

/// bug: Write the redundant blocks newest first, count the offset from the wrong end, carry a primary the receiver is past or one before the switch, keep a block too long or too old for its header, fail on a backwards or wrapped u32 timestamp instead of wrapping mod 2^32, append part of a payload that does not fit, or lose a byte between write and parse.
/// oracle: RFC 2198 §3, by hand: indices 7, 8 and 9 at timestamps 1000, 1960 and 2920 give ef 1e 00 03 (1920 = 30 << 6 back, 3 bytes), ef 0f 00 02 (960 = 15 << 6, 2 bytes), 6f, then abc, de and the primary; a 1,024-byte primary or one 16,384 ticks back carries no block; a backwards timestamp (1000 then 500) or an out-of-range wrap (0xffff0000 then 0) carries no block; a 960-tick wrap (0xfffffc40 then 0) carries offset 960 (ef 0f 00 02).
@test
fn red_write_round_trip() -> Result[(), ()] {
    let mut r = result.unwrap(red.ring(2))
    red_keep(mut r, 7, 1000, b"abc")
    red_keep(mut r, 8, 1960, b"de")
    let two = red_written(r, 9, 2920, b"PRIME", 2, 0)
    red_same(two, b"\xef\x1e\x00\x03\xef\x0f\x00\x02\x6fabcdePRIME", "distance 2")
    let mut blocks: List[red.Block] = list.with_capacity(4)
    result.unwrap(red.parse(two, 0, list.len(two), mut blocks))
    if list.len(blocks) != 3 || list.slice(two, blocks[0].at, blocks[0].at + blocks[0].len) != b"abc" || list.slice(two, blocks[1].at, blocks[1].at + blocks[1].len) != b"de" || list.slice(two, blocks[2].at, blocks[2].at + blocks[2].len) != b"PRIME" {
        fail("parse reads back what write wrote")
    }
    red_same(red_written(r, 9, 2920, b"PRIME", 1, 0), b"\xef\x0f\x00\x02\x6fdePRIME", "distance 1")
    red_same(red_written(r, 9, 2920, b"PRIME", 0, 0), b"\x6fPRIME", "distance 0 is the primary alone")
    red_same(red_written(r, 9, 2920, b"PRIME", 2, 8), b"\xef\x0f\x00\x02\x6fdePRIME", "nothing before the switch")
    red_same(red_written(r, 10, 3880, b"X", 2, 0), b"\xef\x1e\x00\x02\x6fdeX", "index 8 is two back, 9 was never kept")
    // A ring of depth 2 keeps 9 over 7: index 7 is gone.
    red_keep(mut r, 9, 2920, b"PRIME")
    red_same(red_written(r, 11, 4840, b"Y", 2, 0), b"\xef\x1e\x00\x05\x6fPRIMEY", "only 9 is in the ring for 11")
    // Too long, too old: no block.
    let mut long: Bytes = list.with_capacity(1024)
    list.fill(mut long, 1024, 1u8)
    red_keep(mut r, 20, 100000, take long)
    red_keep(mut r, 21, 100960, b"q")
    red_same(red_written(r, 22, 117344, b"Z", 2, 0), b"\x6fZ", "1,024 bytes and 16,384 ticks fit no header")
    red_same(red_written(r, 22, 117343, b"Z", 2, 0), b"\xef\xff\xfc\x01\x6fqZ", "16,383 ticks back fits")
    // Backwards timestamp (P0-2): offset wraps above MAX_OFFSET, so the block is left out.
    let mut rw = result.unwrap(red.ring(2))
    red_keep(mut rw, 7, 1000, b"abc")
    red_same(red_written(rw, 8, 500, b"PRIME", 1, 0), b"\x6fPRIME", "backwards timestamp leaves the block out")
    // Normal Opus u32 timestamp wrap at 2^32 (P0-2): 960 ticks across 0 carries the block; 65536 ticks does not.
    red_keep(mut rw, 7, 0xfffffc40, b"de")
    red_same(red_written(rw, 8, 0x00000000, b"PRIME", 1, 0), b"\xef\x0f\x00\x02\x6fdePRIME", "960-tick wrap carries offset 960")
    red_keep(mut rw, 7, 0xffff0000, b"de")
    red_same(red_written(rw, 8, 0x00000000, b"PRIME", 1, 0), b"\x6fPRIME", "out-of-range wrap leaves the block out")
    // No room: nothing appended.
    let mut tight: Bytes = list.with_capacity(6)
    list.push(mut tight, 9u8)
    match red.write(mut tight, 111, r, 22, 117343, b"Z", 0, 1, 2, 0) {
        Error(c) => {
            if c.requested != 7 || c.available != 5 || list.len(tight) != 1 {
                fail("a refused write names its size and appends nothing")
            }
        },
        Ok(_) => fail("7 bytes in 5"),
    }
    Ok(())
}

fn red_boundary_u32(mut src: std.prop.Source) -> u32 {
    match std.prop.below(mut src, 10) {
        0 => 0u32,
        1 => 1u32,
        2 => 960u32,
        3 => 16383u32,
        4 => 16384u32,
        5 => 0xfffffc40u32,
        6 => 0xffffc001u32,
        7 => 0xffffffffu32,
        _ => int.truncate(std.prop.word(mut src)),
    }
}

fn red_boundary_u64(mut src: std.prop.Source) -> u64 {
    match std.prop.below(mut src, 8) {
        0 => 0u64,
        1 => 1u64,
        2 => 2u64,
        3 => 0x3fffffffffffffffu64,
        4 => 0xfffffffffffffffeu64,
        5 => 0xffffffffffffffffu64,
        _ => std.prop.word(mut src),
    }
}

fn red_wire_gen() -> std.prop.Gen[Bytes] {
    let mut arms: List[std.prop.Gen[Bytes]] = list.new()
    list.push(mut arms, std.prop.bytes_of(0, 256))
    list.push(mut arms, std.prop.make(fn(mut src: std.prop.Source) -> Bytes {
        let mut out: Bytes = list.new()
        let headers = std.prop.below(mut src, 4)
        let mut body_len = 0u64
        for _ in 0u64 .. headers {
            let pt: u8 = int.narrow(std.prop.below(mut src, 128))
            let off: u16 = match std.prop.below(mut src, 5) {
                0 => 0u16,
                1 => 1u16,
                2 => 960u16,
                3 => 16383u16,
                _ => int.narrow(std.prop.below(mut src, 16384)),
            }
            let blen: u16 = match std.prop.below(mut src, 5) {
                0 => 0u16,
                1 => 1023u16,
                _ => int.narrow(std.prop.below(mut src, 24)),
            }
            list.push(mut out, 0x80u8 | pt)
            list.push(mut out, int.truncate(off >> 6))
            let hi_len: u8 = int.truncate(blen >> 8)
            let lo_off: u8 = int.truncate((off & 0x3fu16) << 2)
            list.push(mut out, lo_off | hi_len)
            list.push(mut out, int.truncate(blen & 0xffu16))
            body_len += int.widen(blen)
        }
        let primary_pt: u8 = int.narrow(std.prop.below(mut src, 128))
        list.push(mut out, primary_pt)
        let extra = std.prop.below(mut src, 16)
        let actual = if std.prop.weighted(mut src, 1, 3) && body_len > 0 {
            // Length one past the buffer (or exact minus 1).
            order.min(body_len - 1, 128)
        } else {
            order.min(body_len + extra, 192)
        }
        for _ in 0u64 .. actual {
            list.push(mut out, int.narrow(std.prop.below(mut src, 256)))
        }
        take out
    }, fn(b: Bytes, mut out: String) {
        string.push(mut out, "red_wire(len=")
        string.push_u64(mut out, list.len(b))
        string.push(mut out, ")")
    }))
    std.prop.one_of(take arms)
}

fn red_reencode(pkt: Bytes, blocks: List[red.Block]) -> Bytes {
    let mut re: Bytes = list.with_capacity(list.len(pkt))
    let n = list.len(blocks)
    for i in 0u64 .. n {
        let b = blocks[i]
        if i + 1 < n {
            list.push(mut re, 0x80u8 | b.pt)
            list.push(mut re, int.truncate(b.offset >> 6))
            let blen: u16 = int.narrow(b.len)
            let hi_len: u8 = int.truncate(blen >> 8)
            let lo_off: u8 = int.truncate((b.offset & 0x3fu16) << 2)
            list.push(mut re, lo_off | hi_len)
            list.push(mut re, int.truncate(blen & 0xffu16))
        } else {
            list.push(mut re, b.pt)
        }
    }
    for b in blocks {
        list.append(mut re, list.slice(pkt, b.at, b.at + b.len))
    }
    take re
}

fn red_decode_total_law(pkt: Bytes) -> Result[(), String] {
    let mut blocks: List[red.Block] = list.new()
    let p_res = red.parse(pkt, 0, list.len(pkt), mut blocks)
    let pri_res = red.primary(pkt, 0, list.len(pkt))
    match (p_res, pri_res) {
        (Ok(()), Ok(pri)) => {
            if list.len(blocks) == 0 {
                return Error(string.from("parse returned Ok with 0 blocks"))
            }
            let last = blocks[list.len(blocks) - 1]
            if last.pt != pri.pt || last.offset != pri.offset || last.at != pri.at || last.len != pri.len {
                return Error(string.from("primary disagreed with parse's last block"))
            }
            let re = red_reencode(pkt, blocks)
            if re != pkt {
                return Error(string.from("RED re-encode did not equal consumed packet"))
            }
        },
        (Error(_), Error(_)) => {
            if list.len(blocks) != 0 {
                return Error(string.from("parse left blocks after Error"))
            }
        },
        _ => return Error(string.from("parse and primary disagreed on validity")),
    }
    Ok(())
}

type RedWriteDraw {
    index: u64,
    ts: u32,
    ts1: u32,
    ts2: u32,
    distance: u8,
    since: u64,
    primary: Bytes,
    prev1: Bytes,
    prev2: Bytes
}

fn red_write_gen() -> std.prop.Gen[RedWriteDraw] {
    std.prop.make(fn(mut src: std.prop.Source) -> RedWriteDraw {
        let index = red_boundary_u64(mut src)
        let ts = red_boundary_u32(mut src)
        let ts1 = red_boundary_u32(mut src)
        let ts2 = red_boundary_u32(mut src)
        let distance: u8 = int.narrow(std.prop.below(mut src, 5))
        let since = if std.prop.weighted(mut src, 1, 2) {
            0u64
        } else {
            red_boundary_u64(mut src)
        }
        let primary = std.prop.draw(mut src, std.prop.bytes_of(0, 32))
        let prev1 = std.prop.draw(mut src, std.prop.bytes_of(0, 32))
        let prev2 = std.prop.draw(mut src, std.prop.bytes_of(0, 32))
        RedWriteDraw(index, ts, ts1, ts2, distance, since, primary: take primary, prev1: take prev1, prev2: take prev2)
    }, fn(d: RedWriteDraw, mut out: String) {
        string.push(mut out, "RedWrite(idx=")
        string.push_u64(mut out, d.index)
        string.push(mut out, ", ts=")
        string.push_u64(mut out, int.widen(d.ts))
        string.push(mut out, ", ts1=")
        string.push_u64(mut out, int.widen(d.ts1))
        string.push(mut out, ")")
    })
}

fn red_write_total_law(d: RedWriteDraw) -> Result[(), String] {
    let mut r = result.unwrap(red.ring(2))
    if d.index >= 2 {
        red.keep(mut r, d.index - 2, d.ts2, d.prev2, 0, list.len(d.prev2))
    }
    if d.index >= 1 {
        red.keep(mut r, d.index - 1, d.ts1, d.prev1, 0, list.len(d.prev1))
    }
    let mut out: Bytes = list.with_capacity(2048)
    let n = match red.write(mut out, 111, r, d.index, d.ts, d.primary, 0, list.len(d.primary), d.distance, d.since) {
        Ok(n) => n,
        Error(_) => return Error(string.from("red.write refused valid capacity")),
    }
    if n != list.len(out) {
        return Error(string.from("red.write length mismatch"))
    }
    let mut blocks: List[red.Block] = list.new()
    if let Error(_) = red.parse(out, 0, n, mut blocks) {
        return Error(string.from("red.parse refused red.write output"))
    }
    if red_reencode(out, blocks) != out {
        return Error(string.from("red.write output did not re-encode identically"))
    }
    let last = blocks[list.len(blocks) - 1]
    if list.slice(out, last.at, last.at + last.len) != d.primary {
        return Error(string.from("red.write primary payload mismatch"))
    }
    Ok(())
}

/// bug: Trap, overflow on backwards or wrapped u32 RTP timestamps, or accept a RED wire framing that does not re-encode to the exact consumed bytes.
/// oracle: RFC 2198 §3 wire encoder (independent of the decoder) and P0-2 modulo-2^32 timestamp offset rule.
@test
fn red_totality_and_reencode_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 160
    std.prop.check(c, red_wire_gen(), red_decode_total_law)?
    std.prop.check(c, red_write_gen(), red_write_total_law)
}

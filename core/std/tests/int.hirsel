// Contract tests for `int` (core/std/int.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names. Lists are read back as numbers, one decimal digit per element.
/// 0 for Ok, 1 for Empty, 100 + i for Invalid(i), 3 for OutOfRange.
fn unsigned_error(r: Result[u64, ParseError]) -> u64 {
    match r {
        Ok(_) => 0,
        Error(Empty) => 1,
        Error(Invalid(i)) => 100 + i,
        Error(OutOfRange) => 3,
    }
}

fn signed_error(r: Result[i64, ParseError]) -> u64 {
    match r {
        Ok(_) => 0,
        Error(Empty) => 1,
        Error(Invalid(i)) => 100 + i,
        Error(OutOfRange) => 3,
    }
}

// expect: run uint_hex() = 255
fn uint_hex() -> u64 {
    result.unwrap(int.parse_uint("ff", 16))
}

// expect: run uint_hex_upper() = 255
fn uint_hex_upper() -> u64 {
    result.unwrap(int.parse_uint("FF", 16))
}

// expect: run uint_max() = 18446744073709551615
fn uint_max() -> u64 {
    result.unwrap(int.parse_uint("18446744073709551615", 10))
}

// expect: run uint_empty() = 1
fn uint_empty() -> u64 {
    unsigned_error(int.parse_uint("", 10))
}

// expect: run uint_bad_digit() = 102
fn uint_bad_digit() -> u64 {
    unsigned_error(int.parse_uint("12a", 10))
}

// expect: run uint_digit_past_base() = 101
fn uint_digit_past_base() -> u64 {
    unsigned_error(int.parse_uint("12", 2))
}

// expect: run uint_past_max() = 3
fn uint_past_max() -> u64 {
    unsigned_error(int.parse_uint("18446744073709551616", 10))
}

// The overflow at the 20th digit is reported before the bad byte after it.
// expect: run uint_overflow_first() = 3
fn uint_overflow_first() -> u64 {
    unsigned_error(int.parse_uint("99999999999999999999x", 10))
}

// expect: run uint_bad_byte_first() = 101
fn uint_bad_byte_first() -> u64 {
    unsigned_error(int.parse_uint("1x99999999999999999999", 10))
}

// expect: run uint_no_sign() = 100
fn uint_no_sign() -> u64 {
    unsigned_error(int.parse_uint("+1", 10))
}

// expect: run uint_base_37() = fail Fail
fn uint_base_37() -> u64 {
    unsigned_error(int.parse_uint("1", 37))
}

// expect: run int_negative() = -128
fn int_negative() -> i64 {
    result.unwrap(int.parse_int("-128", 10))
}

// expect: run int_min() = -9223372036854775808
fn int_min() -> i64 {
    result.unwrap(int.parse_int("-9223372036854775808", 10))
}

// expect: run int_max() = 9223372036854775807
fn int_max() -> i64 {
    result.unwrap(int.parse_int("9223372036854775807", 10))
}

// expect: run int_negative_base_36() = -35
fn int_negative_base_36() -> i64 {
    result.unwrap(int.parse_int("-z", 36))
}

// expect: run int_past_max() = 3
fn int_past_max() -> u64 {
    signed_error(int.parse_int("9223372036854775808", 10))
}

// expect: run int_past_min() = 3
fn int_past_min() -> u64 {
    signed_error(int.parse_int("-9223372036854775809", 10))
}

// expect: run int_sign_alone() = 101
fn int_sign_alone() -> u64 {
    signed_error(int.parse_int("-", 10))
}

// expect: run int_two_signs() = 101
fn int_two_signs() -> u64 {
    signed_error(int.parse_int("--1", 10))
}

// expect: run int_plus() = 100
fn int_plus() -> u64 {
    signed_error(int.parse_int("+1", 10))
}

// expect: run int_empty() = 1
fn int_empty() -> u64 {
    signed_error(int.parse_int("", 10))
}

// Core int.parse (core/core/int.hirsel), against core.md "Integers": the grammar is checked
// to the end before the range.
fn parsed_u8(s: String) -> u64 {
    let r: Result[u8, ParseError] = int.parse(s)
    match r {
        Ok(x) => int.widen(x),
        Error(e) => 1000 + unsigned_error(Error(e)),
    }
}

fn parsed_i8(s: String) -> i64 {
    let r: Result[i8, ParseError] = int.parse(s)
    match r {
        Ok(x) => int.widen(x),
        Error(e) => {
            let code: i64 = int.narrow(unsigned_error(Error(e)))
            1000 + code
        },
    }
}

// u8: "0255" (a leading zero) is 255; "256" is OutOfRange (3); "-5" and "+5" are
// Invalid(0) (100), no sign for an unsigned T; "" is Empty (1); "1-" is Invalid(1) (101).
// expect: run parse_u8_cases() = true
fn parse_u8_cases() -> bool {
    parsed_u8("0255") == 255 && parsed_u8("256") == 1003 && parsed_u8("-5") == 1100 && parsed_u8("+5") == 1100 && parsed_u8("") == 1001 && parsed_u8("1-") == 1101
}

// i8: "-128" and "127" are the limits; "128" and "-129" are OutOfRange; "-" alone is
// Invalid(0); "--1" is Invalid(1); "-0" is 0; "-007" is -7.
// expect: run parse_i8_cases() = true
fn parse_i8_cases() -> bool {
    parsed_i8("-128") == -128 && parsed_i8("127") == 127 && parsed_i8("128") == 1003 && parsed_i8("-129") == 1003 && parsed_i8("-") == 1100 && parsed_i8("--1") == 1101 && parsed_i8("-0") == 0 && parsed_i8("-007") == -7
}

// u64's maximum, then one past it.
// expect: run parse_u64_limits() = 18446744073709551615
fn parse_u64_limits() -> u64 {
    let past: Result[u64, ParseError] = int.parse("18446744073709551616")
    if unsigned_error(past) != 3 {
        return 0
    }
    result.unwrap(int.parse("18446744073709551615"))
}

// i64's minimum.
// expect: run parse_i64_min() = -9223372036854775808
fn parse_i64_min() -> i64 {
    result.unwrap(int.parse("-9223372036854775808"))
}

// A numeral that does not fit is still read to the end: the bad byte at 20 wins.
// expect: run parse_grammar_before_range() = 120
fn parse_grammar_before_range() -> u64 {
    let r: Result[u64, ParseError] = int.parse("99999999999999999999x")
    unsigned_error(r)
}

// The body's u64 accumulator: up to 1844674407370955160 a step cannot wrap, so
// 18446744073709551609 is the largest value read without a check. 18446744073709551610 is
// read through the checked step and fits; 18446744073709551619 (whose last step starts past
// the bound, and would wrap to 3 without a check) and a 21-digit numeral do not (3). Leading zeros
// past 20 digits are still 42. A numeral too big for u64 is read to its bad byte at 30 (130).
// expect: run parse_u64_accumulator_edge() = true
fn parse_u64_accumulator_edge() -> bool {
    let a: Result[u64, ParseError] = int.parse("18446744073709551609")
    let b: Result[u64, ParseError] = int.parse("18446744073709551610")
    let c: Result[u64, ParseError] = int.parse("184467440737095516150")
    let d: Result[u64, ParseError] = int.parse("0000000000000000000000000042")
    let e: Result[u64, ParseError] = int.parse("184467440737095516160000000000x")
    let f: Result[u64, ParseError] = int.parse("18446744073709551619")
    result.unwrap(a) == 18446744073709551609 && result.unwrap(b) == 18446744073709551610 && unsigned_error(c) == 3 && result.unwrap(d) == 42 && unsigned_error(e) == 130 && unsigned_error(f) == 3
}

// i64 on both sides of its range: one past MIN and one past MAX are OutOfRange (3); -1 is
// read through the negative path with magnitude 1.
// expect: run parse_i64_range_edges() = true
fn parse_i64_range_edges() -> bool {
    let low: Result[i64, ParseError] = int.parse("-9223372036854775809")
    let high: Result[i64, ParseError] = int.parse("9223372036854775808")
    let one: Result[i64, ParseError] = int.parse("-1")
    signed_error(low) == 3 && signed_error(high) == 3 && result.unwrap(one) == -1
}

// The byte ASCII tests agree with the char ones (an independent body over the scalar) on
// every byte, so an edge off by one at 0x2F/0x3A, 0x40/0x5B, 0x60/0x7B or a fold that
// admits '@', '[', '`' or '{' gives the count of disagreeing bytes.
// expect: run byte_ascii_matches_char() = 0
fn byte_ascii_matches_char() -> u64 {
    let mut bad: u64 = 0
    for v in 0u32 .. 256u32 {
        let b: u8 = int.narrow(v)
        let c = option.unwrap(char.from_u32(v))
        if int.is_ascii_digit(b) != char.is_ascii_digit(c) {
            bad += 1
        }
        if int.is_ascii_alpha(b) != char.is_ascii_alpha(c) {
            bad += 1
        }
        let l: u32 = int.widen(int.to_ascii_lower(b))
        if l != char.to_u32(char.to_ascii_lower(c)) {
            bad += 1
        }
    }
    bad
}

; CoreIR sample, family: control flow (Jump, Branch, Switch, Return, block parameters).
;
; Source (package samples@0, module control):
;   i0  fn sum_to(n: u64) -> u64 { let mut t: u64 = 0; let mut i: u64 = 0; while i < n { i += 1; t += i }; t }
;   i1  fn days(month: u8) -> u8 { match month { 2 => 28, 4 | 6 | 9 | 11 => 30, _ => 31 } }
;
; The loop's mutable locals are carried as block parameters (b1's v2 = t, v3 = i);
; slots.core shows the same kind of loop over slots instead. Both are valid CoreIR.
;
; Behaviour, derived by hand:
; run: f0(0) -> 0
; run: f0(4) -> 10                   ; 1+2+3+4
; run: f0(100) -> 5050               ; n(n+1)/2
; run: f1(2) -> 28
; run: f1(9) -> 30
; run: f1(1) -> 31
; run: f1(12) -> 31
core v1
item i0 = samples@0/control/sum_to
item i1 = samples@0/control/days
sig g0 = (u64) -> (u64)
sig g1 = (u8) -> (u8)
inst n0 = samples@0/control/sum_to [] []
inst n1 = samples@0/control/days [] []
fn f0 = n0 g0 {
b0(v0: u64):
  v1: u64 = const 0
  jump b1(v1, v1)
b1(v2: u64, v3: u64):
  v4: bool = lt v3, v0
  branch v4, b2, b3
b2:
  v5: u64 = const 1
  v6: u64 = add v3, v5
  v7: u64 = add v2, v6
  jump b1(v7, v6)
b3:
  return v2
}
fn f1 = n1 g1 {
b0(v0: u8):
  v1: u8 = const 28
  v2: u8 = const 30
  v3: u8 = const 31
  switch v0 [2 -> b1(v1), 4 -> b1(v2), 6 -> b1(v2), 9 -> b1(v2), 11 -> b1(v2)] else b1(v3)
b1(v4: u8):
  return v4
}

// MEM-30: each send is step 2*i+1; each completed latch is step 2*i+2.
// expect: reference run loop_count(0,0) = 0
// expect: reference run loop_count(1,0) = 1
// expect: reference run loop_count(5,0) = 3
// expect: reference run loop_count(6,0) = 3
// expect: reference run loop_count(5,1) = 3
// expect: reference run loop_count(6,1) = 3
// expect: reference run loop_count(5,2) = 3
// expect: reference run loop_count(6,2) = 3
// expect: reference run loop_count(5,3) = 3
// expect: reference run loop_count(5,4) = 3
// expect: reference run exact(0) = 0
// expect: reference run exact(1) = 7
// expect: reference run nested(4) = 4
// expect: reference run nested(5) = 7
// expect: reference run reservation() = 1
// expect: reference run isolate_stop() = 50
fn loop_count(k: u64, form: u64) -> u64 {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(16)
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 3u64 { let _ = list.push(mut xs, i) }
    let _ = bound steps k {
        if form == 0 {
            loop { let _ = channel.try_send(tx, 1u64) }
        } else if form == 1 {
            let mut i = 0u64
            while i < 3 { let _ = channel.try_send(tx, 1u64); i += 1 }
        } else if form == 2 {
            for _ in 0u64 .. 3u64 { let _ = channel.try_send(tx, 1u64) }
        } else if form == 3 {
            loop { let _ = channel.try_send(tx, 1u64); continue }
        } else {
            for _ in xs { let _ = channel.try_send(tx, 1u64) }
        }
    }
    let mut count = 0u64
    while let Ok(_) = channel.try_receive(rx) { count += 1 }
    count
}
fn exact(k: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 7u64)
    match (bound steps k { list.get(xs, 0) }) {
        Ok(Some(v)) => v,
        Error(e) => e.steps,
        _ => 99,
    }
}
fn leaf() -> u64 { 7 }
fn nested(n: u64) -> u64 {
    match (bound steps n {
        let _ = bound steps 4 { for _ in 0u64 .. 3u64 { leaf(); } }
        leaf()
    }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn reservation() -> u64 {
    match (bound steps 3 {
        match (bound steps 4 { fail("not entered") }) {
            Error(e) => e.steps,
            _ => 0,
        }
    }) { Ok(4) => 1, _ => 0 }
}
fn spin() { loop {} }
fn isolate_stop() -> u64 {
    match (bound steps 50 { loop { let _ = isolate(fn() { spin() }) } }) {
        Error(e) => e.steps,
        _ => 0,
    }
}
// A callable call is one step; isolate's call and its callback entry are two.
// expect: reference run callback(0) = 0
// expect: reference run callback(1) = 7
// expect: reference run core_callback(1) = 1
// expect: reference run core_callback(2) = 7
// expect: reference run finalizer(1) = 1 trace 7
// expect: reference run finalizer(2) = 7 trace 7
// expect: reference run glue(0) = 7
// expect: reference run glue(100) = 7
// Spawns are the second and fourth parent steps, leaving copies of 16 and 14.
// After each entry, 15 steps give eight sends and 13 steps give seven sends.
// expect: reference run copy_spawn_budget(0) = 15
// expect: reference run mixed(0) = fail Division,OutOfTime trace 0
// Catching a used root primary retains its replacement cell (FAIL-16).
// expect: reference run isolated_mixed(0) = 12 trace 0 used 32
fn callback(k: u64) -> u64 {
    match (bound steps k { let f = fn() -> u64 { 7 }; f() }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn shared_callback(n: u64) -> u64 {
    let mut count = 0u64
    while count < n { count += 1 }
    count
}
// The call and three latches take four Steps. The same target runs outside
// the scope first. Its standalone root supplies the other cache build order.
// expect: reference run callback_both(3) = 133
// expect: reference run callback_both(4) = 33
fn callback_both(k: u64) -> u64 {
    let f = code.callable(code.describe(shared_callback))
    let first = f(3)
    match (bound steps k { f(3) }) {
        Ok(v) => first * 10 + v,
        Error(e) => first * 10 + e.steps + 100,
    }
}
pub fn unbounded() -> Result[(), Exit] {
    let f = code.callable(code.describe(shared_callback))
    if f(3) != 3 { return Error(Exit(status: 1)) }
    // MEM-28. The nine-byte literal fits at its logical charge on every build.
    let admitted = bound bytes 16 {
        let value: FrozenBytes = b"abcdefghi"
        let data = bytebuf.as_bytes(value)
        list.len(data) == 9 && data[8] == b'i'
    }
    match admitted {
        Ok(true) => Ok(()),
        _ => Error(Exit(status: 2)),
    }
}
pub fn bounded() -> Result[(), Exit] {
    // Three loop iterations cannot fit in two steps. A roomy bound lets the
    // same callable complete after its unbound call.
    if callback_both(2) == 132 && callback_both(1000) == 33 {
        Ok(())
    } else {
        Error(Exit(status: 1))
    }
}

fn stage_body(take state: (), key: u64, n: u64) -> ((), Option[u64]) {
    ((), Some(shared_callback(n)))
}
// The owner has no lexical bound. The descriptor's stage can spend only two
// Steps, so the call with three latches never publishes an Item.
pub fn flow_step_owner() -> Result[(), Exit] waits {
    let mut f = flow.new()
    let (sink, out): (Sink[u64], Into[u64]) = result.unwrap(flow.sink(mut f))
    let stage = result.unwrap(flow.stage(mut f, out, 1, bytes 0, steps 2, (), code.describe(stage_body)))
    let p = result.unwrap(flow.port(mut f, stage, 1))
    match flow.push(mut f, p, 7, 3u64) {
        Ok => (),
        _ => return Error(Exit(status: 1)),
    }
    flow.end(mut f, p)
    match flow.next(mut f, sink) {
        Dropped(from: 0, at: 7) => (),
        _ => return Error(Exit(status: 2)),
    }
    match flow.finish(take f) {
        Error(e) => match e.halt {
            OutOfTime => Ok(()),
            _ => Error(Exit(status: 3)),
        },
        Ok(()) => Error(Exit(status: 4)),
    }
}
fn core_callback(k: u64) -> u64 {
    match (bound steps k { isolate(fn() -> u64 { 7 }) }) {
        Ok(Ok(Ok(v))) => v,
        Error(e) => e.steps,
        _ => 99,
    }
}
resource type Marker { id: u64 } drop(m) {}
fn finalizer(k: u64) -> u64 {
    match (bound steps k { let m = result.unwrap(Marker(id: 7)); 7u64 }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn glue(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. n { let _ = list.push(mut xs, i) }
    match (bound steps 1 { let copied: List[u64] = clone(xs); let _ = take copied; 7u64 }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn worker(take tx: Sender[u64]) {
    loop { let _ = channel.try_send(tx, 1u64) }
}
fn copy_spawn_budget(tasks: Tasks) -> u64 waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(32)
    let _ = bound steps 18 {
        let a = channel.sender(tx)
        let first = task.spawn(tasks, bytes 4096, take a, worker)
        let b = channel.sender(tx)
        let second = task.spawn(tasks, bytes 4096, take b, worker)
        let _ = task.join(take first)
        let _ = task.join(take second)
    }
    let mut count = 0u64
    while let Ok(_) = channel.try_receive(rx) { count += 1 }
    count
}
resource type Failing { d: u64 } drop(f) { let _ = 1u64 / f.d }
fn mixed(d: u64) {
    let _ = bound steps 1 {
        let f = result.unwrap(Failing(d: 0))
        let _ = 1u64 / d
    }
}

// The unwrap and N-1 latches spend all N Steps. Division is an ordinary
// failure. Cleanup attempts entry to Failing's finalizer at Step N+1.
// expect: reference run exhausted_finalizer(65535,0) = fail Division,OutOfTime trace 0
// expect: reference run exhausted_finalizer(65536,0) = fail Division,OutOfTime trace 0
// expect: reference run exhausted_finalizer(65537,0) = fail Division,OutOfTime trace 0
fn exhausted_finalizer(n: u64, d: u64) {
    let _ = bound steps n {
        let f = result.unwrap(Failing(d: 0))
        for _ in 0u64 .. (n - 1) {}
        let _ = 1u64 / d
    }
}
pub fn failure_before_slice() -> Result[(), Exit] {
    exhausted_finalizer(65535, 0)
    Ok(())
}
pub fn failure_at_slice() -> Result[(), Exit] {
    exhausted_finalizer(65536, 0)
    Ok(())
}
pub fn failure_after_slice() -> Result[(), Exit] {
    exhausted_finalizer(65537, 0)
    Ok(())
}
fn isolated_mixed(d: u64) -> u64 {
    match isolate(fn() { mixed(d) }) {
        Ok(Error(cs)) => {
            let mut kinds = 0u64
            for c in cs {
                kinds = kinds * 10 + match c.kind { Division => 1u64, OutOfTime => 2u64, _ => 9u64 }
            }
            kinds
        },
        _ => 0,
    }
}

// expect: reference run sort_callback(1) = 1
// expect: reference run sort_callback(2) = 7
fn sort_callback(k: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 2u64)
    let _ = list.push(mut xs, 1u64)
    match (bound steps k {
        let mut ys = take xs
        let _ = list.sort_stable(mut ys, fn(a: u64, b: u64) -> Order { Equal })
        7u64
    }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
// S1, S2, S6 and S7: five loop forms send 3 each. The children send 8 and 7.
// hand-derived try-send: 30
pub fn main(tasks: Tasks) -> Result[(), Exit] waits {
    if callback_both(3) != 133 || callback_both(4) != 33 { return Error(Exit(status: 2)) }
    if loop_count(5, 0) == 3 && loop_count(5, 1) == 3 && loop_count(5, 2) == 3 && loop_count(5, 3) == 3 && loop_count(5, 4) == 3 && callback(1) == 7 && core_callback(1) == 1 && core_callback(2) == 7 && finalizer(1) == 1 && finalizer(2) == 7 && glue(0) == 7 && glue(100) == 7 && sort_callback(1) == 1 && sort_callback(2) == 7 && isolate_stop() == 50 && optimized_spin() == 1000 && chunk_range(8, 3) == 3 && chunk_range(8, 8) == 7 && chunk_range(100000, 65536) == 65536 && chunk_list(3) == 3 && merged_calls(1) == 1 && merged_calls(2) == 7 && chunk_nested(1, 9) == 9 && chunk_nested(1, 10) == 7 && chunk_nested(7000, 65536) == 65536 && copy_spawn_budget(tasks) == 15 && isolated_mixed(0) == 12 && mixed_chain(tasks) && partial_sweep() {
        Ok(())
    } else { Error(Exit(status: 1)) }
}

fn caught_child(take d: u64) -> u64 { isolated_mixed(d) }
// The outer isolate catches a Division-primary chain with secondary OutOfTime.
// expect: reference run mixed_chain(0) = true
fn mixed_chain(tasks: Tasks) -> bool waits {
    let h = task.spawn(tasks, bytes 4096, 0u64, caught_child)
    match task.join(take h) { Ok(12) => true, _ => false }
}

// MEM-30: the build must meter an infinite loop even without effects.
pub fn fuel_stops_infinite_loop() -> Result[(), Exit] {
    if optimized_spin() == 1000 { Ok(()) } else { Error(Exit(status: 1)) }
}
// expect: reference run optimized_spin() = 1000
fn optimized_spin() -> u64 {
    match (bound steps 1000 { loop {} }) { Error(e) => e.steps, _ => 0 }
}

// Whole chunks cannot stop early. A short window takes the checked copy and
// stops at precisely the next unpaid latch, including a list's final latch.
// expect: reference run chunk_range(8,3) = 3
// expect: reference run chunk_range(8,8) = 7
// expect: reference run chunk_range(100000,65536) = 65536
// expect: reference run chunk_list(3) = 3
// expect: reference run chunk_list(8) = 7
// expect: reference run merged_calls(1) = 1
// expect: reference run merged_calls(2) = 7
fn chunk_range(n: u64, budget: u64) -> u64 {
    match (bound steps budget {
        let mut sum = 0u64
        for x in 0u64 .. n { sum = sum ^ x }
        7u64
    }) { Error(e) => e.steps, Ok(v) => v }
}
fn chunk_list(budget: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    for x in 0u64 .. 8u64 { let _ = list.push(mut xs, x) }
    match (bound steps budget {
        let mut sum = 0u64
        for x in xs { sum = sum ^ x }
        7u64
    }) { Error(e) => e.steps, Ok(v) => v }
}
fn merged_calls(budget: u64) -> u64 {
    match (bound steps budget { let a = leaf(); let b = leaf(); a ^ b ^ 7u64 }) {
        Error(e) => e.steps, Ok(v) => v,
    }
}

// Each outer trip calls leaf once, takes eight inner latches and one outer latch.
// expect: reference run chunk_nested(1,9) = 9
// expect: reference run chunk_nested(1,10) = 7
// expect: reference run chunk_nested(7000,65536) = 65536
fn chunk_nested(n: u64, budget: u64) -> u64 {
    match (bound steps budget {
        let mut sum = 0u64
        for x in 0u64 .. n {
            sum = sum ^ leaf()
            for y in 0u32 .. 8u32 { sum = sum ^ (sum >> 1u64) }
        }
        7u64
    }) { Error(e) => e.steps, Ok(v) => v }
}

// Each call of the depth-six binary tree is one Step, 127 in all. A bound of
// s < 127 refuses a call. A subtree prepaid past the window would let the last
// subtrees finish, so every refusal point of the checked path is swept.
// expect: reference run partial_tree(1) = 1
// expect: reference run partial_tree(63) = 63
// expect: reference run partial_tree(64) = 64
// expect: reference run partial_tree(65) = 65
// expect: reference run partial_tree(126) = 126
// expect: reference run partial_tree(127) = 1127
// expect: reference run partial_tree(128) = 1127
fn tree(mut count: u64, depth: u64) {
    count += 1
    if depth != 0 {
        tree(mut count, depth - 1)
        tree(mut count, depth - 1)
    }
}
fn partial_tree(s: u64) -> u64 {
    match (bound steps s {
        let mut count = 0u64
        tree(mut count, 6)
        count
    }) {
        Ok(count) => 1000 + count,
        Error(e) => e.steps,
    }
}
fn partial_sweep() -> bool {
    let mut s = 0u64
    while s < 129 {
        let want = if s < 127 { s } else { 1127 }
        if partial_tree(s) != want { return false }
        s += 1
    }
    true
}

// MEM-30 step contexts. Each shared routine first runs with no bound current
// and then under one, reached from the bounded code by a route other than a
// direct call. Each case returns 100 * the unbounded sends + the sends the
// bound admits. The bounded count is the charged prefix: a body taken without
// its Steps would send all 20.
fn burst(tx: Sender[u64], n: u64) -> u64 {
    let mut sent = 0u64
    while sent < n {
        let _ = channel.try_send(tx, 1u64)
        sent += 1
    }
    sent
}
fn drain(rx: Receiver[u64]) -> u64 {
    let mut count = 0u64
    while let Ok(_) = channel.try_receive(rx) { count += 1 }
    count
}
fn burst_task(take tx: Sender[u64]) { let _ = burst(tx, 20) }
// A loop trip is a send and a latch, so r Steps left at burst's loop send
// ceil(r/2) times. The sender copy and the spawn take two of eleven, so the
// child copies nine. Its entry and the call to burst leave seven: four sends.
// expect: reference run route_spawn(0) = 2004
fn route_spawn(tasks: Tasks) -> u64 waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(64)
    let a = channel.sender(tx)
    let h = task.spawn(tasks, bytes 4096, take a, burst_task)
    let _ = task.join(take h)
    let first = drain(rx)
    let _ = bound steps 11 {
        let b = channel.sender(tx)
        let second = task.spawn(tasks, bytes 4096, take b, burst_task)
        let _ = task.join(take second)
    }
    first * 100 + drain(rx)
}
// The call by function value and the call to burst leave seven of nine.
// expect: reference run route_closure(0) = 2004
fn route_closure(seed: u64) -> u64 {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(64)
    let f = fn(t: Sender[u64], n: u64) -> u64 { burst(t, n) }
    let _ = f(tx, 20 + seed)
    let first = drain(rx)
    let _ = bound steps 9 { f(tx, 20 + seed) }
    first * 100 + drain(rx)
}
// Sorting two values compares them once. One sort instance and comparator
// run in both contexts.
fn sort_bursts(tx: Sender[u64], seed: u64) {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 2u64)
    let _ = list.push(mut xs, 1u64)
    let _ = list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { let _ = burst(tx, 20 + seed); Equal })
}
// The call to sort_bursts, its four core calls, the comparator's entry and
// the call to burst leave nine of sixteen: five sends.
// expect: reference run route_callback(0) = 2005
fn route_callback(seed: u64) -> u64 {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(64)
    sort_bursts(tx, seed)
    let first = drain(rx)
    let _ = bound steps 16 { sort_bursts(tx, seed) }
    first * 100 + drain(rx)
}
resource type Burst { tx: Sender[u64] } drop(b) { let _ = burst(b.tx, 20) }
// The constructor's unwrap, the finalizer's entry and its call to burst leave
// six of nine: three sends.
// expect: reference run route_finalizer(0) = 2003
fn route_finalizer(seed: u64) -> u64 {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(64)
    let a = channel.sender(tx)
    let _ = { let held = result.unwrap(Burst(tx: take a)); seed }
    let first = drain(rx)
    let b = channel.sender(tx)
    let _ = bound steps 9 { let held = result.unwrap(Burst(tx: take b)); seed }
    first * 100 + drain(rx)
}
type Gate: send { tx: Sender[u64], ready: Sender[u64], go: Receiver[u64] }
// The child blocks on go and resumes when the parent sends.
fn gated(take g: Gate) waits {
    let _ = channel.try_send(g.ready, 1u64)
    let _ = channel.receive(g.go)
    let _ = burst(g.tx, 20)
}
fn gate_round(tasks: Tasks, tx: Sender[u64]) waits {
    let (ready, ready_rx): (Sender[u64], Receiver[u64]) = channel.new(1)
    let (go, go_rx): (Sender[u64], Receiver[u64]) = channel.new(1)
    let g = Gate(tx: channel.sender(tx), ready: take ready, go: take go_rx)
    let h = task.spawn(tasks, bytes 4096, take g, gated)
    let _ = channel.receive(ready_rx)
    let _ = channel.try_send(go, 1u64)
    let _ = task.join(take h)
}
// The call to gate_round, its three core calls and the spawn take five of
// sixteen. The child's entry, ready send, receive and call to burst leave seven
// of its eleven: four sends after it resumes.
// expect: reference run route_resumed(0) = 2004
fn route_resumed(tasks: Tasks) -> u64 waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(64)
    gate_round(tasks, tx)
    let first = drain(rx)
    let _ = bound steps 16 { gate_round(tasks, tx) }
    first * 100 + drain(rx)
}
fn spin_to(n: u64) -> u64 {
    let mut i = 0u64
    while i < n { i += 1 }
    i
}
// This callback crosses a step slice. Every iteration costs at least one
// step, so fewer than n steps must stop regardless of the call's charge.
// expect: reference run route_slice(70000) = 11
fn route_slice(n: u64) -> u64 {
    let f = code.callable(code.describe(spin_to))
    let _ = f(n)
    let fits = match (bound steps 200000 { f(n) }) { Ok(v) => if v == n { 1u64 } else { 0 }, Error(_) => 0 }
    let stops = match (bound steps (n - 1) { f(n) }) { Error(e) => if e.steps == n - 1 { 10u64 } else { 0 }, Ok(_) => 0 }
    fits + stops
}
fn route_preserves_bound(count: u64) -> bool {
    // The unbounded pass sends all twenty. The tight pass cannot complete
    // all twenty loop iterations, though its prefix is build-specific.
    count >= 2000 && count < 2020
}
fn routes_hold(tasks: Tasks) -> bool waits {
    route_preserves_bound(route_spawn(tasks))
        && route_preserves_bound(route_closure(0))
        && route_preserves_bound(route_callback(0))
        && route_preserves_bound(route_finalizer(0))
        && route_preserves_bound(route_resumed(tasks))
        && route_slice(70000) == 11
}
pub fn routes(tasks: Tasks) -> Result[(), Exit] waits {
    if routes_hold(tasks) { Ok(()) } else { Error(Exit(status: 1)) }
}

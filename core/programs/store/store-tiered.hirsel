// Build the replacement root from the same sealed image the cut writes.
// The old root and its Hot slots still belong to prior captures.
pub fn sealed_tiered_root(root: Arc[std.page.Page], locate: scoped[view] fn(u64) -> std.page.PagePtr) -> Result[Arc[std.page.Page], types.Failure] {
    let image = std.page.image_of(root)
    if std.page.count(image) == 0 {
        return Ok(arc.share(root))
    }
    let size = std.page.sealed_size(image)
    let mut sealed: Bytes = list.with_capacity(size)
    pages.page_result(std.page.seal_located(mut sealed, root, size, locate))?
    let ready = pages.page_result(std.page.decode(take sealed, Collection))?
    pages.page_result(std.page.attach_cold(take ready))
}

// §13.8: each replaced-list row is charged 24 bytes (`branch u32, pack u64,
// len u32, stamp u64`) and each dropped-list row one 48-byte slot, with the
// dirty Tiered bytes.
pub const REPLACED_ROW: u64 = 24

pub const DROPPED_ROW: u64 = 48

// The live replaced and dropped lists since the installed cut (§13.6a T8).
// The cut that publishes them clears both.
pub type TieredDirty: send {
    replaced: List[manifest.BranchReplacements],
    replaced_rows: u64,
    dropped: List[manifest.DeferredFree]
}

pub fn clean_tiered_cut() -> TieredDirty {
    TieredDirty(replaced: list.new(), replaced_rows: 0, dropped: list.new())
}

// One commit's Cold frames that its plan stopped reaching: replaced edges,
// and subtrees or blobs a Log floor detached.
pub type TieredFreed: send {
    replaced: List[manifest.ReplacedFrame],
    dropped: List[format.TieredTarget]
}

fn no_tiered_freed() -> TieredFreed {
    TieredFreed(replaced: list.new(), dropped: list.new())
}

// Admission before the commit is decided: the lists' charge must fit
// `dirty_bytes`, and the room is reserved so the apply cannot fail.
pub fn reserve_tiered_commit(mut dirty: TieredDirty, freed: TieredFreed, limit: u64) -> Result[(), types.Failure] {
    let replaced_rows = int.saturating_add(dirty.replaced_rows, list.len(freed.replaced))
    let dropped_rows = int.saturating_add(list.len(dirty.dropped), list.len(freed.dropped))
    let requested = int.saturating_add(int.saturating_mul(replaced_rows, REPLACED_ROW), int.saturating_mul(dropped_rows, DROPPED_ROW))
    if requested > limit {
        return Error(Full(Resident(Capacity(requested: requested, available: limit))))
    }
    if list.len(freed.replaced) != 0 {
        types.capacity(list.try_reserve(mut dirty.replaced, 1))?
    }
    types.capacity(list.try_reserve(mut dirty.dropped, list.len(freed.dropped)))?
    Ok(())
}

pub fn admit_tiered_commit(mut dirty: TieredDirty, br: u32, take freed: TieredFreed) {
    let TieredFreed(replaced: take replaced, dropped: take dropped) = take freed
    dirty.replaced_rows += list.len(replaced)
    if list.len(replaced) != 0 {
        list.push(mut dirty.replaced, manifest.BranchReplacements(branch: br, frames: take replaced))
    }
    for take target in take dropped {
        list.push(mut dirty.dropped, manifest.DeferredFree(branch_id: br, target: take target))
    }
}

// The deciding and proposed collection maps are Memory. Settling a commit
// needs only their descriptors and its final staged puts (§13.1, §13.8).
pub fn tiered_data_key(tree: pages.PageTree, key: Bytes) -> bool {
    let Some(descriptor) = std.page.lookup(tree.root, list.slice(key, 0, 4)) else {
        return false
    }
    pages.collection_descriptor(descriptor).residency == ResidentTiered
}

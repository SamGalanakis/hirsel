// rule: SEM-5
// expect: run
// authorities: {"store":{"provider":"authority.sim@1","floor":"disk","seed":7,"represent":"log","levels":["cache","disk","replica"],"faults":{}}}
// stdout: levels ordered
// A Level orders by its authority's weakest-first list, directly, through a generic call
// and inside an aggregate.
pub type Failed = Failed()

fn earlier[T: ordered](a: T, b: T) -> bool {
  a < b
}

fn check(holds: bool) -> Result[(), Failed] {
  if holds {
    Ok(())
  } else {
    Error(Failed())
  }
}

fn levels(a: Authority) -> Result[(), Failed] {
  let (Some(cache), Some(disk), Some(replica)) = (
    authority.level(a, "cache"),
    authority.level(a, "disk"),
    authority.level(a, "replica")
  ) else {
    return Error(Failed())
  }
  check(cache < disk && disk < replica && replica > cache && disk == authority.floor(a))?
  check(earlier(cache, replica) && !earlier(replica, disk))?
  check([cache, replica] > [cache, disk])?
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Failed())
  }
  let Ok(a) = io.authority(rt, "store") else {
    return Error(Failed())
  }
  levels(a)?
  match out.print(stdout, "levels ordered\n") {
    Ok(_) => Ok(()),
    Error(_) => Error(Failed()),
  }
}

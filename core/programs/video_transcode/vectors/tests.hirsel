// Runs each prepared case through transcode.run into a simulated S3
// bucket, then writes every stored object (key with '/' as "__") and the
// run summary to the fixture directory for validate.py.

fn name(prefix: String, index: u64, suffix: String) -> String {
    let mut s: String = string.with_capacity(32)
    string.push(mut s, prefix)
    string.push_u64(mut s, index)
    string.push(mut s, suffix)
    s
}

type Bucket {
    endpoint: std.sim.s3.Endpoint,
    time: Clock,
    server: Task[std.sim.s3.Report],
    clock_task: Task[()],
    stopping: Sender[()]
}

type BucketClock: send {
    world: std.sim.world.World,
    stop_from: Receiver[()],
    real: Clock
}

fn bucket_clock(take fixture: BucketClock) waits {
    let BucketClock(world: take initial, stop_from: take stop_from, real) = take fixture
    let mut world = take initial
    loop {
        if std.sim.world.step(mut world) {
            continue
        }
        if let Ok(()) = channel.try_receive(stop_from) {
            return
        }
        host.sleep_until(real, clock.deadline_after_ms(host.mono_ns(real), 1))
    }
}

fn bucket(tasks: Tasks, real: Clock) -> Bucket {
    let address = Addr(ip: V4(2130706433), port: 8080)
    let mut network = std.sim.net.new(std.sim.net.defaults())
    let mut peers: List[Ip] = list.with_capacity(1)
    list.push(mut peers, address.ip)
    std.sim.net.resolve_as(mut network, "bucket.s3.test", take peers)
    // Public AWS SigV4 documentation example.
    let sample: Inline[u8, 32] = [219, 184, 147, 172, 192, 16, 150, 73, 24, 241, 253, 67, 58, 221, 135, 199, 14, 139, 13, 182, 190, 48, 193, 251, 234, 254, 250, 94, 198, 186, 131, 120]
    let mut signing_bytes: Bytes = list.with_capacity(32)
    let _ = bytebuf.append_inline(mut signing_bytes, sample, 0, 32)
    let signing_key = result.unwrap(secret.seal(take signing_bytes, "verify"))
    let config = std.sim.s3.Config(address, cut: None, network: take network, after_resolve: None, credential: "AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request", signing_key: take signing_key,
        faults: list.new(), holds: list.new(), exists_status: 412, fragment_bytes: 1048576, max_body: 268435456)
    let (take world, time) = std.sim.world.new(1123, 0, 1369353600000)
    let (stopping, stop_from): (Sender[()], Receiver[()]) = channel.new(1)
    let clock_task = task.spawn(tasks, bytes 65536, BucketClock(world: take world, stop_from: take stop_from, real), bucket_clock)
    let (endpoint, take server) = std.sim.s3.start_service(tasks, take config, std.sim.world.plan(1123), time, 16777216, 805306368)
    Bucket(endpoint, time, server: take server, clock_task: take clock_task, stopping: take stopping)
}

fn client(endpoint: std.sim.s3.Endpoint, time: Clock, tasks: Tasks) -> std.object.Client waits {
    let sample = string.into_bytes(string.from("wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"))
    let root = result.unwrap(secret.seal(take sample, "kdf"))
    let credentials = std.cred.from_secret("AKIAIOSFODNN7EXAMPLE", take root, "")
    let opts = std.object.Bucket(endpoint: "http://s3.test:8080", aws_region: "us-east-1", bucket: "bucket", prefix: "", style: Virtual)
    let lanes = std.object.LaneConfig(requested_lanes: 1, lane_bytes: 16777216)
    let deadline = clock.deadline_after_ms(host.mono_ns(time), 30000)
    result.unwrap(std.object.start_simulated(endpoint, tasks, take opts, take credentials, time, provide.random(7), lanes, deadline))
}

fn finish(take b: Bucket) -> std.sim.s3.Report waits {
    let Bucket(server: take server, clock_task: take clock_task, stopping: take stopping, ..) = take b
    result.unwrap(channel.send(stopping, ()))
    let report = result.unwrap(task.join(take server))
    result.unwrap(task.join(take clock_task))
    take report
}

fn word(b: Bytes, i: u64) -> u64 {
    list.word_le(b, 8 * i)
}

// case-<i>.cfg: u64 words workers, segment_ms, enc_mode, unit_bytes,
// rung count, then (height, qp) per rung.
fn case_config(d: Dir, index: u64) -> transcode.Config waits {
    let raw = result.unwrap(std.file.read(d, name("case-", index, ".cfg")))
    let mut rungs: List[transcode.Rung] = list.new()
    for r in 0u64 .. word(raw, 4) {
        list.push(mut rungs, transcode.Rung(height: int.narrow(word(raw, 5 + 2 * r)), qp: int.narrow(word(raw, 6 + 2 * r))))
    }
    transcode.Config(rungs: take rungs, enc_mode: int.narrow(word(raw, 2)), segment_ms: word(raw, 1), workers: word(raw, 0), unit_bytes: word(raw, 3), audio: Keep, limits: split.Limits(metadata_bytes: 67108864, samples: 1048576))
}

fn describe(e: transcode.Error) -> String {
    let mut s = string.from("transcode failed: ")
    match e {
        Split(_) => string.push(mut s, "split"),
        Read => string.push(mut s, "read"),
        Rung(h) => {
            string.push(mut s, "rung ")
            string.push_u64(mut s, int.widen(h))
        },
        Unit(j) => {
            string.push(mut s, "unit ")
            string.push_u64(mut s, j)
        },
        Map(j, status) => {
            string.push(mut s, "map job ")
            string.push_u64(mut s, j)
            string.push(mut s, match status {
                Done => " done",
                DecoderOpen => " decoder open",
                Decode => " decode",
                FrameCount => " frame count",
                FrameTime => " frame time",
                FrameSize => " frame size",
                PictureFormat => " picture format",
                Scale => " scale",
                EncoderOpen => " encoder open",
                Encode => " encode",
                PacketCount => " packet count",
            })
        },
        Stitch(_) => string.push(mut s, "stitch"),
        SequenceMismatch(j) => {
            string.push(mut s, "sequence mismatch at job ")
            string.push_u64(mut s, j)
        },
        Package(_) => string.push(mut s, "package"),
        Store(_) => string.push(mut s, "store"),
    }
    s
}

fn flat(index: u64, k: String) -> String {
    let mut s = name("out-", index, "/")
    let mut at = 0u64
    while let Some((c, next)) = string.next_scalar(k, at) {
        if c == '/' {
            string.push(mut s, "__")
        } else {
            string.push_char(mut s, c)
        }
        at = next
    }
    s
}

fn transcode_case(codecs: transcode.Codecs, tasks: Tasks, mut source: HostFile, cfg: transcode.Config, endpoint: std.sim.s3.Endpoint, time: Clock) -> Result[transcode.Summary, transcode.Error] waits {
    let mut c = client(endpoint, time, tasks)
    transcode.run(codecs, tasks, mut source, cfg, mut c, "")
}

/// bug: A GOP split, decode, rotate, tone map, scale, encode or CMAF/HLS/DASH stitch defect loses, duplicates or mistimes frames at GOP seams, breaks the manifests, drops picture quality or bends the tone curve.
/// oracle: validate.py: ffprobe/ffmpeg parse and decode every rendition outside Hirsel against the source's own sample table, PSNR against ffmpeg's rotated and area-scaled source, and an independent Python BT.2390 EETF.
@test
fn ladder(dav: Foreign[av1.DecoderCodec], svt: Foreign[av1.EncoderCodec], avc: Foreign[h264.H264], yuv: Foreign[video_yuv.Yuv], tasks: Tasks, real: Clock, d: Dir) -> Result[(), ()] waits {
    let codecs = transcode.Codecs(dav: dav, svt: svt, avc: avc, yuv: yuv)
    let count = word(result.unwrap(std.file.read(d, "cases")), 0)
    for index in 0u64 .. count {
        let cfg = case_config(d, index)
        let mut source = result.unwrap(std.file.open(d, name("case-", index, ".mp4"), Read))
        let b = bucket(tasks, real)
        let started = host.mono_ns(real)
        let outcome = transcode_case(codecs, tasks, mut source, cfg, b.endpoint, b.time)
        let elapsed = host.mono_ns(real) - started
        let report = finish(take b)
        let summary = match outcome {
            Ok(s) => s,
            Error(e) => fail(describe(e)),
        }
        for (k, object) in report.objects {
            result.unwrap(std.file.write(d, flat(index, k), object.data))
        }
        let mut words: Bytes = list.new()
        list.put_word_le(mut words, summary.jobs)
        list.put_word_le(mut words, summary.frames)
        list.put_word_le(mut words, summary.output_bytes)
        list.put_word_le(mut words, elapsed)
        result.unwrap(std.file.write(d, name("case-", index, ".summary"), words))
    }
    Ok(())
}

// Module `string` (SEM-3).
pub fn new() -> String

pub fn from(s: String) -> String {
    let src = string.as_bytes(s)
    // Exact capacity: the copy's length.
    let mut b: Bytes = list.with_capacity(list.len(src))
    list.append(mut b, src)
    of_bytes(take b)
}

/// An empty string with storage for n bytes. The byte list starts empty.
/// Fails: Capacity. Alloc: n bytes rounded to 8. Cost: O(1).
/// Ex: `let mut reply = string.with_capacity(256)`
pub fn with_capacity(n: u64) -> String {
    let b: Bytes = list.with_capacity(n)
    of_bytes(take b)
}

pub fn from_utf8(take b: Bytes) -> Result[String, Bytes] {
    if is_utf8(b) {
        Ok(of_bytes(take b))
    } else {
        Error(take b)
    }
}

// The encoder writes only RFC 4648 alphabet bytes and '=' padding.
pub fn encode_base64(b: Bytes) -> String {
    let mut out: Bytes = list.new()
    append_base64_bytes(b, mut out)
    of_bytes(take out)
}

const ALPHABET: Inline[u8, 64] =[b'A', b'B', b'C', b'D', b'E', b'F', b'G', b'H', b'I', b'J', b'K', b'L', b'M', b'N', b'O', b'P', b'Q', b'R', b'S', b'T', b'U', b'V', b'W', b'X', b'Y', b'Z', b'a', b'b', b'c', b'd', b'e', b'f', b'g', b'h', b'i', b'j', b'k', b'l', b'm', b'n', b'o', b'p', b'q', b'r', b's', b't', b'u', b'v', b'w', b'x', b'y', b'z', b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'+', b'/']

fn base64_symbol(x: u8) -> u8 {
    ALPHABET[int.widen(x & 63)]
}

// ADAPTED from base64-simd 0.8.0 src/encode.rs:128-268.
// Load 32 bytes at src - 4 so each 128-bit half holds four complete triples
// without crossing the 128-bit lane boundary: low half reads 4..15, high half
// reads 16..27. Each triple a,b,c becomes b,a,c,b in a u32 lane.
const ENCODE_PICK: Inline[u8, 32] =[5, 4, 6, 5, 8, 7, 9, 8, 11, 10, 12, 11, 14, 13, 15, 14, 17, 16, 18, 17, 20, 19, 21, 20, 23, 22, 24, 23, 26, 25, 27, 26]

// Offsets for uppercase (0..25), lowercase (26..51), ten digits (52..61), '+', '/'.
const ENCODE_ROLL: Inline[u8, 16] =[65, 71, 252, 252, 252, 252, 252, 252, 252, 252, 252, 252, 237, 240, 0, 0]

fn append_base64_blocks(b: Bytes, mut out: Bytes, n: u64, dst_start: u64) -> u64 {
    let mut at: u64 = 2
    let mut dst = dst_start
    let out_len = list.len(out)
    let pick: Simd[u8, 32] = simd.from(ENCODE_PICK)
    let roll: Simd[u8, 16] = simd.from(ENCODE_ROLL)
    let edge: Simd[i8, 32] = simd.splat(25)
    let m_a: Simd[u32, 8] = simd.splat(0x0000003f)
    let m_b: Simd[u32, 8] = simd.splat(0x00003f00)
    let m_c: Simd[u32, 8] = simd.splat(0x003f0000)
    let m_d: Simd[u32, 8] = simd.splat(0x3f000000)
    let sub51: Simd[u8, 32] = simd.splat(51)
    // Load 32 bytes at `at` (= src - 4) so bytes 4..27 hold eight triples
    // without crossing the 128-bit lane boundary. Write directly into the
    // pre-filled output tail with set_lanes.
    if n >= 58 && out_len >= 64 {
        let limit2 = n - 56
        let dst_limit2 = out_len - 64
        while at <= limit2 && dst <= dst_limit2 {
            let chunk = list.slice(b, at, at + 56)
            let i0: Simd[u8, 32] = list.lanes(chunk, 0)
            let i1: Simd[u8, 32] = list.lanes(chunk, 24)
            let t0: Simd[u32, 8] = simd.cast(simd.swizzle(i0, pick))
            let t1: Simd[u32, 8] = simd.cast(simd.swizzle(i1, pick))
            let d0: Simd[u8, 32] = simd.cast(((t0 >> 10) & m_a) | ((t0 << 4) & m_b) | ((t0 >> 6) & m_c) | ((t0 << 8) & m_d))
            let d1: Simd[u8, 32] = simd.cast(((t1 >> 10) & m_a) | ((t1 << 4) & m_b) | ((t1 >> 6) & m_c) | ((t1 << 8) & m_d))
            let s0: Simd[i8, 32] = simd.cast(d0)
            let s1: Simd[i8, 32] = simd.cast(d1)
            let u0: Simd[u8, 32] = simd.cast(simd.lt(edge, s0))
            let u1: Simd[u8, 32] = simd.cast(simd.lt(edge, s1))
            let c0 = simd.wrapping_sub(simd.saturating_sub(d0, sub51), u0)
            let c1 = simd.wrapping_sub(simd.saturating_sub(d1, sub51), u1)
            list.set_lanes(mut out, dst, simd.wrapping_add(d0, simd.swizzle(roll, c0)))
            list.set_lanes(mut out, int.wrapping_add(dst, 32), simd.wrapping_add(d1, simd.swizzle(roll, c1)))
            at = int.wrapping_add(at, 48)
            dst = int.wrapping_add(dst, 64)
        }
    }
    let limit = n - 32
    if out_len >= 32 {
        let dst_limit = out_len - 32
        while at <= limit && dst <= dst_limit {
            let input: Simd[u8, 32] = list.lanes(b, at)
            let triples: Simd[u32, 8] = simd.cast(simd.swizzle(input, pick))
            let digits: Simd[u8, 32] = simd.cast(((triples >> 10) & m_a) | ((triples << 4) & m_b) | ((triples >> 6) & m_c) | ((triples << 8) & m_d))
            let signed_digits: Simd[i8, 32] = simd.cast(digits)
            let above_uppercase: Simd[u8, 32] = simd.cast(simd.lt(edge, signed_digits))
            let class = simd.wrapping_sub(simd.saturating_sub(digits, sub51), above_uppercase)
            let ascii = simd.wrapping_add(digits, simd.swizzle(roll, class))
            list.set_lanes(mut out, dst, ascii)
            at = int.wrapping_add(at, 24)
            dst = int.wrapping_add(dst, 32)
        }
    }
    at + 4
}

/// Appends RFC 4648's standard alphabet with '=' padding. O(n).
/// A refusal leaves out unchanged. Ex: `string.append_base64_bytes(b, mut out)`.
pub fn append_base64_bytes(b: Bytes, mut out: Bytes) {
    let n = list.len(b)
    work_steps(3, n)
    let tail = n % 3
    let full = n - tail
    let size = (n / 3 + if tail == 0 {
        0
    } else {
        1
    }) * 4
    let dst0 = list.len(out)
    list.fill(mut out, size, b'=')
    let mut src: u64 = 0
    if n >= 34 {
        // Encode two leading triples (6 bytes -> 8 bytes) so the 32-byte SIMD
        // loop can safely load at src - 4.
        let mut head: u64 = 0
        let mut d0 = dst0
        while head < 6 {
            let a = b[head]
            let c = b[head + 1]
            let d = b[head + 2]
            out[d0] = base64_symbol(a >> 2)
            out[d0 + 1] = base64_symbol(((a & 3) << 4) | (c >> 4))
            out[d0 + 2] = base64_symbol(((c & 15) << 2) | (d >> 6))
            out[d0 + 3] = base64_symbol(d & 63)
            head += 3
            d0 += 4
        }
        src = append_base64_blocks(b, mut out, n, dst0 + 8)
    }
    let mut dst = dst0 + src / 3 * 4
    while src < full {
        let a = b[src]
        let c = b[src + 1]
        let d = b[src + 2]
        out[dst] = base64_symbol(a >> 2)
        out[dst + 1] = base64_symbol(((a & 3) << 4) | (c >> 4))
        out[dst + 2] = base64_symbol(((c & 15) << 2) | (d >> 6))
        out[dst + 3] = base64_symbol(d & 63)
        src += 3
        dst += 4
    }
    if tail != 0 {
        let a = b[full]
        let c: u8 = if tail == 2 {
            b[full + 1]
        } else {
            0
        }
        out[dst] = base64_symbol(a >> 2)
        out[dst + 1] = base64_symbol(((a & 3) << 4) | (c >> 4))
        if tail == 2 {
            out[dst + 2] = base64_symbol((c & 15) << 2)
        }
    }
}

// ADAPTED from simdutf8 0.1.5 src/implementation/algorithm.rs:69-170 (Keiser-Lemire).
// Error bit masks: TOO_SHORT=1, TOO_LONG=2, OVERLONG_3=4, TOO_LARGE=8,
// SURROGATE=16, OVERLONG_2=32, TOO_LARGE_1000/OVERLONG_4=64, TWO_CONTS=128.
// CARRY = TOO_SHORT | TOO_LONG | TWO_CONTS = 131.
const UTF8_BYTE1_HIGH: Inline[u8, 16] =[2, 2, 2, 2, 2, 2, 2, 2, 128, 128, 128, 128, 33, 1, 21, 73]

const UTF8_BYTE1_LOW: Inline[u8, 16] =[231, 163, 131, 131, 139, 203, 203, 203, 203, 203, 203, 203, 203, 219, 203, 203]

const UTF8_BYTE2_HIGH: Inline[u8, 16] =[1, 1, 1, 1, 1, 1, 1, 1, 230, 174, 186, 186, 1, 1, 1, 1]

// Back up from `at` past any incomplete multibyte scalar whose lead sits in
// the last 1..3 bytes before `at`.
fn utf8_back_up(b: Bytes, at: u64) -> u64 {
    if at > 0 && b[at - 1] >= 0xc0 {
        return at - 1
    }
    if at > 1 && b[at - 2] >= 0xe0 {
        return at - 2
    }
    if at > 2 && b[at - 3] >= 0xf0 {
        return at - 3
    }
    at
}

// Validate a prefix ending at a scalar boundary in two stages. Pure ASCII runs
// scan 128 bytes per step (`utf8_ascii_prefix`); multibyte text then validates 64
// bytes per step in vectors (`utf8_block_prefix`) and returns the last known-good
// scalar boundary on error so the scalar loop recovers the exact valid_up_to and
// error_len.
fn utf8_ascii_prefix(b: Bytes) -> u64 {
    let n = list.len(b)
    let mut i: u64 = 0
    // Fast ASCII prefix: 128 bytes per step.
    if n >= 128 {
        let last_ascii = n - 128
        while i <= last_ascii {
            let run = list.slice(b, i, i + 128)
            let a: Simd[u8, 32] = list.lanes(run, 0)
            let c: Simd[u8, 32] = list.lanes(run, 32)
            let d: Simd[u8, 32] = list.lanes(run, 64)
            let e: Simd[u8, 32] = list.lanes(run, 96)
            if simd.bitmask((a | c) | (d | e)) != 0 {
                break
            }
            i = int.wrapping_add(i, 128)
        }
    }
    // Finish remaining 32-byte pure ASCII blocks.
    if n - i >= 32 {
        let last_32 = n - 32
        while i <= last_32 {
            let block: Simd[u8, 32] = list.lanes(b, i)
            if simd.bitmask(block) != 0 {
                break
            }
            i = int.wrapping_add(i, 32)
        }
    }
    i
}

// The vector stage, from the ASCII prefix's end `start`.
fn utf8_block_prefix(b: Bytes, start: u64) -> u64 {
    let n = list.len(b)
    let mut i = start
    if n - i < 64 {
        return i
    }
    // Ensure i >= 3 at a valid scalar boundary so prev1/prev2/prev3 loads at
    // i - 1, i - 2, i - 3 stay in bounds.
    while i < 3 {
        let x = b[i]
        if x < 0x80 {
            i += 1
            continue
        }
        let Some(head) = utf8_head(x) else {
            return i
        }
        if let Error(_) = utf8_tail(head, n - i, fn(offset: u64) -> u8 {
            b[i + offset]
        }) {
            return i
        }
        i += head.width
    }
    if n - i < 64 {
        return i
    }
    let t1h: Simd[u8, 16] = simd.from(UTF8_BYTE1_HIGH)
    let t1l: Simd[u8, 16] = simd.from(UTF8_BYTE1_LOW)
    let t2h: Simd[u8, 16] = simd.from(UTF8_BYTE2_HIGH)
    let mask_0f: Simd[u8, 32] = simd.splat(0x0f)
    let mask_80: Simd[u8, 32] = simd.splat(0x80)
    let sub_df: Simd[u8, 32] = simd.splat(0xdf)
    let sub_ef: Simd[u8, 32] = simd.splat(0xef)
    let zero_i8: Simd[i8, 32] = simd.splat(0)
    let mut err: Simd[u8, 32] = simd.splat(0)
    let mut base = i - 3
    let last_base = n - 67
    while base <= last_base {
        let win = list.slice(b, base, int.wrapping_add(base, 67))
        let v0: Simd[u8, 32] = list.lanes(win, 3)
        let v1: Simd[u8, 32] = list.lanes(win, 35)
        if simd.bitmask(v0 | v1) == 0 {
            if win[2] >= 0xc0 || win[1] >= 0xe0 || win[0] >= 0xf0 {
                return 0
            }
            base = int.wrapping_add(base, 64)
            continue
        }
        let p1_0: Simd[u8, 32] = list.lanes(win, 2)
        let p2_0: Simd[u8, 32] = list.lanes(win, 1)
        let p3_0: Simd[u8, 32] = list.lanes(win, 0)
        let sc0 = simd.swizzle(t1h, p1_0 >> 4) & simd.swizzle(t1l, p1_0 & mask_0f) & simd.swizzle(t2h, v0 >> 4)
        let m23_0: Simd[i8, 32] = simd.cast(simd.saturating_sub(p2_0, sub_df) | simd.saturating_sub(p3_0, sub_ef))
        let c23_0: Simd[u8, 32] = simd.cast(simd.lt(zero_i8, m23_0))
        let e0 = (c23_0 & mask_80) ^ sc0
        let p1_1: Simd[u8, 32] = list.lanes(win, 34)
        let p2_1: Simd[u8, 32] = list.lanes(win, 33)
        let p3_1: Simd[u8, 32] = list.lanes(win, 32)
        let sc1 = simd.swizzle(t1h, p1_1 >> 4) & simd.swizzle(t1l, p1_1 & mask_0f) & simd.swizzle(t2h, v1 >> 4)
        let m23_1: Simd[i8, 32] = simd.cast(simd.saturating_sub(p2_1, sub_df) | simd.saturating_sub(p3_1, sub_ef))
        let c23_1: Simd[u8, 32] = simd.cast(simd.lt(zero_i8, m23_1))
        let e1 = (c23_1 & mask_80) ^ sc1
        err |= e0 | e1
        base = int.wrapping_add(base, 64)
    }
    if simd.any(err) {
        return 0
    }
    utf8_back_up(b, base + 3)
}

pub type Utf8Error {
    valid_up_to: u64,
    error_len: Option[u64]
}

/// The scalar width and valid second-byte range for a UTF-8 lead.
pub type Utf8Head {
    width: u64,
    low: u8,
    high: u8
}

pub fn utf8_head(b: u8) -> Option[Utf8Head] {
    if b < 0x80 {
        return Some(Utf8Head(width: 1, low: 0x80, high: 0xbf))
    }
    if b < 0xc2 || b > 0xf4 {
        return None
    }
    let width: u64 = if b < 0xe0 {
        2
    } else if b < 0xf0 {
        3
    } else {
        4
    }
    let low: u8 = if b == 0xe0 {
        0xa0
    } else if b == 0xf0 {
        0x90
    } else {
        0x80
    }
    let high: u8 = if b == 0xed {
        0x9f
    } else if b == 0xf4 {
        0x8f
    } else {
        0xbf
    }
    Some(Utf8Head(width, low, high))
}

/// Validates the continuation bytes of one unit, with available bytes including
/// its lead. An error counts the valid prefix of an invalid unit, or is None
/// when the input ends in an otherwise valid prefix.
pub fn utf8_tail(head: Utf8Head, available: u64, read: scoped fn(u64) -> u8) -> Result[(), Option[u64]] {
    for i in 1u64 .. head.width {
        if i >= available {
            return Error(None)
        }
        let byte = read(i)
        if i == 1 {
            if byte < head.low || byte > head.high {
                return Error(Some(i))
            }
        } else if byte & 0xc0 != 0x80 {
            return Error(Some(i))
        }
    }
    Ok(())
}

pub fn validate_utf8(b: Bytes) -> Result[(), Utf8Error] {
    let n = list.len(b)
    // Below the SIMD crossover, start with the scalar ASCII word scan. The ASCII
    // prefix takes the cheap row; every byte past it, multibyte vectors included,
    // the UTF-8 row.
    let ascii: u64 = if n >= 128 {
        utf8_ascii_prefix(b)
    } else {
        0
    }
    work_steps(6, ascii)
    work_steps(2, n - ascii)
    let mut i: u64 = if n >= 128 {
        utf8_block_prefix(b, ascii)
    } else {
        0
    }
    while i < n {
        if i & 7 == 0 {
            while i + 16 <= n && (list.word_le(b, i) | list.word_le(b, i + 8)) & 0x8080808080808080 == 0 {
                i += 16
            }
            while i < n && b[i] < 0x80 {
                i += 1
            }
            if i == n {
                break
            }
        }
        let x = b[i]
        if x < 0x80 {
            i += 1
            continue
        }
        let Some(head) = utf8_head(x) else {
            return Error(Utf8Error(valid_up_to: i, error_len: Some(1)))
        }
        if let Error(length) = utf8_tail(head, n - i, fn(offset: u64) -> u8 {
            b[i + offset]
        }) {
            return Error(Utf8Error(valid_up_to: i, error_len: length))
        }
        i += head.width
    }
    Ok(())
}

pub fn is_utf8(b: Bytes) -> bool {
    match validate_utf8(b) {
        Ok(()) => true,
        Error(_) => false,
    }
}

pub fn into_bytes(take s: String) -> Bytes {
    if list.capacity(string.as_bytes(s)) != 0 {
        return to_bytes(take s)
    }
    // Static storage: copied into exact capacity.
    let mut out: Bytes = list.with_capacity(string.byte_len(s))
    list.append(mut out, string.as_bytes(s))
    out
}

pub fn as_bytes(s: String) -> View[Bytes] in s

pub fn slice(s: String, lo: u64, hi: u64) -> View[String] in s {
    let b = string.as_bytes(s)
    // Bounds when lo > hi or hi is past the length.
    let v = list.slice(b, lo, hi)
    let n = list.len(b)
    if (lo < n && (b[lo] & 0xC0) == 0x80) || (hi < n && (b[hi] & 0xC0) == 0x80) {
        // Inside a scalar: Bounds, raised by the index n, which is past the end.
        let _ = b[n]
    }
    view_string(v)
}

pub fn next_scalar(s: String, at: u64) -> Option[(char, u64)] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if at == n {
        return None
    }
    // Past the end, b[at] fails with Bounds.
    let x = b[at]
    if (x & 0xC0) == 0x80 {
        // Inside a scalar: Bounds, raised by the index n, which is past the end.
        let _ = b[n]
    }
    let w: u64 = if x < 0x80 {
        1
    } else if x < 0xE0 {
        2
    } else if x < 0xF0 {
        3
    } else {
        4
    }
    let lead: u8 = if w == 1 {
        x
    } else if w == 2 {
        x & 0x1F
    } else if w == 3 {
        x & 0x0F
    } else {
        x & 0x07
    }
    let mut v: u32 = int.widen(lead)
    for k in 1 .. w {
        let y: u32 = int.widen(b[at + k] & 0x3F)
        v = (v << 6) | y
    }
    // s is valid UTF-8, so v is a scalar.
    Some((option.unwrap(char.from_u32(v)), at + w))
}

pub fn byte_len(s: String) -> u64

pub fn push(mut s: String, t: String)

pub fn push_char(mut s: String, c: char) {
    let v = char.to_u32(c)
    // ASCII into room the String owns: one byte, no growth. A static String has capacity 0.
    if v < 0x80 && string.byte_len(s) < list.capacity(string.as_bytes(s)) {
        let owned = replace(mut s, string.new())
        let mut b = to_bytes(take owned)
        // There is room, so this admits nothing.
        list.push(mut b, int.truncate(v))
        s = of_bytes(take b)
        return
    }
    push_scalar(mut s, v)
}

// Any scalar value v, growing (or copying out of static storage) first. One branch per UTF-8
// width with constant shifts: no shift loop and no shift-amount check.
cold fn push_scalar(mut s: String, v: u32) {
    let w: u64 = if v < 0x80 {
        1
    } else if v < 0x800 {
        2
    } else if v < 0x10000 {
        3
    } else {
        4
    }
    string.reserve(mut s, w)
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    // Room for w bytes is reserved, so no push below admits anything.
    if w == 1 {
        list.push(mut b, int.truncate(v))
    } else if w == 2 {
        list.push(mut b, int.truncate(0xC0 | (v >> 6)))
        list.push(mut b, int.truncate(0x80 | (v & 0x3F)))
    } else if w == 3 {
        list.push(mut b, int.truncate(0xE0 | (v >> 12)))
        list.push(mut b, int.truncate(0x80 | ((v >> 6) & 0x3F)))
        list.push(mut b, int.truncate(0x80 | (v & 0x3F)))
    } else {
        list.push(mut b, int.truncate(0xF0 | (v >> 18)))
        list.push(mut b, int.truncate(0x80 | ((v >> 12) & 0x3F)))
        list.push(mut b, int.truncate(0x80 | ((v >> 6) & 0x3F)))
        list.push(mut b, int.truncate(0x80 | (v & 0x3F)))
    }
    s = of_bytes(take b)
}

pub fn push_u64(mut s: String, n: u64) {
    let mut digits: Inline[u8, 64] =[0; 64]
    let start = int.radix_digits(n, 10, mut digits)
    string.reserve(mut s, 64 - start)
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    // The whole suffix was reserved and contains only ASCII digits.
    let _ = bytebuf.append_inline(mut b, digits, start, 64)
    s = of_bytes(take b)
}

pub fn reserve(mut s: String, n: u64)

pub fn truncate(mut s: String, n: u64) {
    {
        let b = string.as_bytes(s)
        let len = list.len(b)
        if n > len || (n < len && (b[n] & 0xC0) == 0x80) {
            // Past the length or inside a scalar: Bounds, raised by the index len.
            let _ = b[len]
        }
    }
    // The same bytes, shorter: a static String stays static, an owned one keeps its capacity.
    shorten(mut s, n)
}

pub fn make_ascii_upper(mut s: String) {
    if list.capacity(string.as_bytes(s)) == 0 && string.byte_len(s) != 0 {
        // Static storage with bytes: copied first, as into_bytes copies it. A refusal
        // raises Capacity before s changes.
        s = string.from(s)
    }
    // s owns its storage or is empty: the carrier moves to Bytes with no call.
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    work_steps(4, list.len(b))
    for i in 0 .. list.len(b) {
        let x = b[i]
        // One comparison: below b'a' wraps past 25. Every byte is stored, changed or not, so
        // the loop has no branch and vectorizes. Only a-z change, so b stays UTF-8.
        b[i] = if int.wrapping_sub(x, b'a') < 26 {
            int.wrapping_sub(x, 32)
        } else {
            x
        }
    }
    s = of_bytes(take b)
}

pub fn make_ascii_lower(mut s: String) {
    if list.capacity(string.as_bytes(s)) == 0 && string.byte_len(s) != 0 {
        // Static storage with bytes: copied first, as into_bytes copies it. A refusal
        // raises Capacity before s changes.
        s = string.from(s)
    }
    // s owns its storage or is empty: the carrier moves to Bytes with no call.
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    work_steps(4, list.len(b))
    for i in 0 .. list.len(b) {
        let x = b[i]
        // As make_ascii_upper: only A-Z change, so b stays UTF-8.
        b[i] = if int.wrapping_sub(x, b'A') < 26 {
            int.wrapping_add(x, 32)
        } else {
            x
        }
    }
    s = of_bytes(take b)
}

// The kernel, the only unchecked code in core. The String and Bytes carriers are one layout,
// {data, length, capacity}; these rewrite or reinterpret a carrier and check nothing, so each
// caller establishes the precondition stated on it.
// b is UTF-8. (As a List, b already owns its storage or is empty.)
fn of_bytes(take b: Bytes) -> String

// s owns its storage or is empty: capacity(as_bytes(s)) > 0 or byte_len(s) == 0. A static String
// with bytes never becomes a List, which would write in place; copy it or reserve first.
fn to_bytes(take s: String) -> Bytes

// b is UTF-8 cut at scalar boundaries at both ends.
fn view_string(b: Bytes) -> View[String] in b

// n <= byte_len(s), at a scalar boundary. Only the length changes: data and capacity stay.
fn shorten(mut s: String, n: u64)

// MEM-30's work charge for a loop in this module: `code` names a row of the
// work table (hirsel-core-ids work_steps::code: 0 walk, 1 parse, 2 UTF-8,
// 3 base64, 4 ASCII case, 6 UTF-8 ASCII prefix) and `units` its units.
fn work_steps(code: u64, units: u64)

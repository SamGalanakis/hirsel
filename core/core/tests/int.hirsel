// Laws of core.int's rotations and byte swap (semantics.md SEM-1), each result derived by hand.
// u8 0x81 = 1000_0001: left by 1 is 0000_0011 = 3, and 9 is 1 modulo 8. i8 -128 = 1000_0000
// left by 1 is 1: the count is not read as signed and the top bit wraps to bit 0. u64 2^63
// left by 65 (1 modulo 64) is 1.
// expect: run rotate_left_wraps() = true
fn rotate_left_wraps() -> bool {
    let a: u8 = 129
    let b: i8 = -128
    let c: u64 = 9223372036854775808
    int.rotate_left(a, 1) == 3 && int.rotate_left(a, 9) == 3 && int.rotate_left(b, 1) == 1 && int.rotate_left(c, 65) == 1
}

// u8 0x81 right by 1 is 1100_0000 = 192; by 0 and by 8 it is unchanged. u64 1 right by 1 is
// 2^63. u32 1 right by 33 (1 modulo 32) is 2^31. i16 1 right by 1 is 0x8000 = -32768.
// expect: run rotate_right_wraps() = true
fn rotate_right_wraps() -> bool {
    let a: u8 = 129
    let c: u64 = 1
    let d: u32 = 1
    let e: i16 = 1
    int.rotate_right(a, 1) == 192 && int.rotate_right(a, 0) == 129 && int.rotate_right(a, 8) == 129 && int.rotate_right(c, 1) == 9223372036854775808 && int.rotate_right(d, 33) == 2147483648 && int.rotate_right(e, 1) == -32768
}

// A narrow into a wider type keeps the value, so a negative signed source stays negative:
// i16 -20569 is -20569 at i32 and i64, i8 -1 is -1 at i16, and the same through try_narrow.
// A zero-extended source would read 0xAFA7 = 44967 and 0xFF = 255 instead.
// expect: run narrow_widening_keeps_sign() = true
fn narrow_widening_keeps_sign() -> bool {
    let x: i16 = -20569
    let y: i8 = -1
    let a: i32 = int.narrow(x)
    let b: i64 = int.narrow(x)
    let c: i16 = int.narrow(y)
    let d: Option[i32] = int.try_narrow(x)
    let some = match d {
        Some(v) => v == -20569,
        None => false
    }
    a == -20569 && b == -20569 && c == -1 && some
}

// u32 0x01020304 = 16909060 swaps to 0x04030201 = 67305985; u16 0x0102 = 258 to 0x0201 = 513;
// u8 0xAB stays; i16 0x00FF = 255 to 0xFF00 = -256; i64 1 to 0x0100_0000_0000_0000 = 2^56.
// expect: run swap_bytes_reverses() = true
fn swap_bytes_reverses() -> bool {
    let a: u32 = 16909060
    let b: u16 = 258
    let c: u8 = 171
    let d: i16 = 255
    let e: i64 = 1
    int.swap_bytes(a) == 67305985 && int.swap_bytes(b) == 513 && int.swap_bytes(c) == 171 && int.swap_bytes(d) == -256 && int.swap_bytes(e) == 72057594037927936
}

// int.ilog2 (SEM-1) against a reference that counts right shifts until one bit is left.
fn shifts(x: u64) -> u32 {
    let mut v = x
    let mut n: u32 = 0
    while v > 1 {
        v = v >> 1
        n += 1
    }
    n
}

// Some(log) with 2^log <= x < 2^(log+1) and log equal to the shift count; at the top bit
// the upper bound is 2^width, which every x of that width is below.
fn ilog2_holds(got: Option[u32], x: u64, width: u32) -> bool {
    let Some(log) = got else {
        return false
    }
    let shift: u64 = int.widen(log)
    log == shifts(x) && (1u64 << shift) <= x && (log + 1 == width || x < (1u64 << (shift + 1)))
}

// Each width at every power of two p (1 included), p - 1, and p | (p - 1), which at the top
// bit is MAX. Zero is None.
// expect: run ilog2_boundaries() = true
fn ilog2_boundaries() -> bool {
    let mut bit: u64 = 0
    while bit < 64 {
        let p = 1u64 << bit
        if !ilog2_all(p, bit) || (bit > 0 && !ilog2_all(p - 1, bit)) || !ilog2_all(p | (p - 1), bit) {
            return false
        }
        bit += 1
    }
    let none = match (int.ilog2(0u8), int.ilog2(0u16), int.ilog2(0u32), int.ilog2(0u64)) {
        (None, None, None, None) => true,
        _ => false,
    }
    none
}

// x at each width it fits, given its top bit is at most `bit`.
fn ilog2_all(x: u64, bit: u64) -> bool {
    let a: u8 = int.truncate(x)
    let b: u16 = int.truncate(x)
    let c: u32 = int.truncate(x)
    (bit >= 8 || ilog2_holds(int.ilog2(a), x, 8)) && (bit >= 16 || ilog2_holds(int.ilog2(b), x, 16)) && (bit >= 32 || ilog2_holds(int.ilog2(c), x, 32)) && ilog2_holds(int.ilog2(x), x, 64)
}

// Module `json` (std only: other packages write `std.json.`): a JSON document as one
// compact blob, written once in a region and never moved (MEM-4, MEM-9, MEM-12). This is
// the document library of the json workload's matched variant (NINE.md).
//
// Layout, W = u32 (MEM-9). Seven variants, so the tag is one byte.
//   Null, False, True                 1
//   Num(Text): the spelling as read   1 + 4 + len
//   Str(Text): the decoded string     1 + 4 + its UTF-8 length
//   Arr(IndexedSpan[Json])            1 + 4 count + 4 byte length + the elements + 4 per element
//   Obj(IndexedSpan[Member])          as Arr; a Member is 4 + len(key) + its value
// Every container is indexed, so `indexed.get(xs, i)` reaches element or member i after
// one bounds test and one load. `for x in xs` and `for m in ms` walk them in input order;
// `seq.len` counts them. Duplicate keys stay in the blob in input order; the first-position
// and last-value rule is ObjectIndex, below. A number keeps its spelling: the document is
// rendered as read, and no float is formatted.
//
// Sizing. `size` reads the input once, checks it, and returns the exact byte count of the
// document; `parse` then admits exactly that many bytes once (build_stream_in) and writes
// each value at its final offset. Nothing is staged and nothing moves. For n input bytes,
// the result is at most floor((13n - 1) / 2): nested `[[..]]` at 13 bytes per `[]` pair
// (goose-attack-898 ADVICE: every container indexed). Whitespace and escapes only lower
// it. A document of more than 2^32 - 1 bytes is Error(Build(Overflow)).
//
// Reading text. `text.as_string(t)` views a Str, a Num's spelling or a key as a String with
// no copy, so every string reader prints or compares it (`text.as_string(k) == step`).
@compact(u32)
pub type Json = Null | False | True | Num(Text) | Str(Text) | Arr(IndexedSpan[Json]) | Obj(IndexedSpan[Member])

/// One object member: its decoded key, then its value.
@compact(u32)
pub type Member {
    key: Text,
    value: Json
}

/// Syntax(i): byte i is where the input stops being JSON: a trailing comma, a control
/// byte in a string, a lone surrogate, a leading zero, trailing bytes, or the end of the
/// input. NotFinite(i): the number at i rounds to an infinity (`1e999`). Build(e): the
/// document did not fit (Capacity) or exceeds W's blob cap (Overflow). Depth means
/// the sizing pass encountered a 129th nested array or object. WrongKind(i)
/// means a cursor reader expected another kind at i. IntegerRange(i) means
/// the integer at i does not fit the requested width.
pub type Error = Syntax(u64) | NotFinite(u64) | Build(BuildError) | Depth | WrongKind(u64) | IntegerRange(u64)

const MAX_DEPTH: u64 = 128

/// Checks that s is one JSON value, which may have whitespace around it, and returns the
/// exact number of bytes its document takes. `parse` admits exactly that many.
/// Fails: Error(Syntax(i) | NotFinite(i)) at the first byte that is wrong, or
/// Error(Depth) at the first container beyond the 128-container nesting limit.
/// Alloc: nothing. Cost: O(len); each number once more through float.parse64.
/// Ex: `let n = std.json.size(line)?`; `[12,"ab",[true,30],[]]` takes 73 bytes
pub fn size(s: String) -> Result[u64, Error] {
    let mut i: u64 = 0
    let n = value_size(s, mut i)?
    skip(s, mut i)
    if i != string.byte_len(s) {
        return Error(Syntax(i))
    }
    Ok(n)
}

/// Parses s into one document in r: `size(s)`, then a single admission of that many bytes,
/// then each value written once at its final offset.
/// The sizing pass checks depth before the document is admitted or written.
/// Fails: as size; Error(Build(Overflow)) past 2^32 - 1 bytes. Raises Capacity when r's
/// limit refuses the admission, with nothing written.
/// Alloc: one block of exactly size(s) bytes (rounded to 8) in r.
/// Cost: two passes over s.
/// Ex: `region r { let doc = std.json.parse(r, line)?; .. }`
pub fn parse(r: Region, s: String) -> Result[Json in r, Error] {
    let n = size(s)?
    let mut i: u64 = 0
    match build_stream_in(r, bytes n, fn(take w: core.Writer[Json, in r]) -> Result[Child[Json], BuildError] {
        write_value(s, mut i, take w)
    }) {
        Ok(take b) => Ok(finish(take b)),
        Error(e) => Error(Build(e)),
    }
}

/// A byte cursor borrowed by the composable JSON readers. Start one with decode.
pub opaque type Cursor {
    at: u64
}

/// The six JSON value kinds.
pub type ValueKind: key = JsonNull | JsonBool | JsonNumber | JsonString | JsonArray | JsonObject

/// Decodes one whole JSON value, allowing leading and trailing JSON whitespace.
/// The reader composes record_of, list_of and the scalar readers for its type.
pub fn decode[T](s: String, read: scoped fn(String, mut Cursor) -> Result[T, Error]) -> Result[T, Error] {
    let mut c = Cursor(at: 0)
    let value = read(s, mut c)?
    skip(s, mut c.at)
    if c.at != string.byte_len(s) {
        return Error(Syntax(c.at))
    }
    Ok(take value)
}

/// Reads an array directly into a list of decoded elements.
pub fn list_of[T](s: String, mut c: Cursor, item: scoped fn(String, mut Cursor) -> Result[T, Error]) -> Result[List[T], Error] {
    opening(s, mut c.at, b'[')?
    let mut out: List[T] = list.new()
    if !ends(s, mut c.at, b']') {
        loop {
            let v = item(s, mut c)?
            list.push(mut out, take v)
            if after_item(s, mut c.at, b']')? {
                break
            }
        }
    }
    Ok(take out)
}

/// Reads an object into a caller's record. The callback consumes each field
/// value using the provided cursor, or uses skip_value for an unknown field.
/// Keys are decoded JSON strings. Fields visit in wire order, including duplicates.
pub fn record_of[T](s: String, mut c: Cursor, take seed: T, field: scoped fn(String, String, mut Cursor, mut T) -> Result[(), Error]) -> Result[T, Error] {
    opening(s, mut c.at, b'{')?
    let mut value = take seed
    if !ends(s, mut c.at, b'}') {
        loop {
            let (start, end, width) = member_name(s, mut c.at)?
            if end - start == width {
                field(string.slice(s, start, end), s, mut c, mut value)?
            } else {
                let key = decode_string(s, start)?
                field(key, s, mut c, mut value)?
            }
            if after_item(s, mut c.at, b'}')? {
                break
            }
        }
    }
    Ok(take value)
}

/// One owned JSON node with children already constructed as T.
pub type TreeValue[T] = Null | False | True | Num(String) | Str(String) | Arr(List[T]) | Obj(Map[String, T])

/// Parses one JSON value into the caller's owned tree, using the same input
/// grammar and error offsets as size. Calls before in preorder, before reading
/// each node, and make after reading its children. Object keys are validated
/// before allocation. Duplicate keys keep their first position and last value.
/// Fails: before's first error, or wrap of the first syntax, number or Capacity error.
/// Alloc: owned strings, lists and maps as consumed by make. Cost: O(input bytes)
/// plus callbacks and map insertions.
pub fn parse_tree[T, E](s: String, before: scoped fn() -> Result[(), E], make: scoped fn(take TreeValue[T]) -> T, wrap: scoped fn(take Error) -> E) -> Result[T, E] {
    let mut i: u64 = 0
    let value = tree_value(s, mut i, before, make, wrap)?
    skip(s, mut i)
    if i != string.byte_len(s) {
        return Error(wrap(Syntax(i)))
    }
    Ok(take value)
}

fn tree_value[T, E](s: String, mut i: u64, before: scoped fn() -> Result[(), E], make: scoped fn(take TreeValue[T]) -> T, wrap: scoped fn(take Error) -> E) -> Result[T, E] {
    before()?
    let node: TreeValue[T] = match result.map_err(value_start(s, mut i), wrap)? {
        ReadNull => Null,
        ReadFalse => False,
        ReadTrue => True,
        ReadNumber => {
            let start = i
            let _ = result.map_err(read_number(s, mut i), wrap)?
            let spelling = string.from(string.slice(s, start, i))
            Num(take spelling)
        },
        ReadString => {
            let start = i + 1
            let _ = result.map_err(string_size(s, mut i), wrap)?
            let value = result.map_err(decode_string(s, start), wrap)?
            Str(take value)
        },
        ReadArray => {
            let mut values: List[T] = list.new()
            if !ends(s, mut i, b']') {
                loop {
                    let value = tree_value(s, mut i, before, make, wrap)?
                    list.push(mut values, take value)
                    if result.map_err(after_item(s, mut i, b']'), wrap)? {
                        break
                    }
                }
            }
            Arr(take values)
        },
        ReadObject => {
            let mut members: Map[String, T] = map.new()
            if !ends(s, mut i, b'}') {
                loop {
                    let (start, _, _) = result.map_err(member_name(s, mut i), wrap)?
                    let key = result.map_err(decode_string(s, start), wrap)?
                    let value = tree_value(s, mut i, before, make, wrap)?
                    map.insert(mut members, take key, take value)
                    if result.map_err(after_item(s, mut i, b'}'), wrap)? {
                        break
                    }
                }
            }
            Obj(take members)
        },
    }
    Ok(make(take node))
}

/// Identifies the next value's kind without advancing the cursor.
pub fn peek(s: String, c: Cursor) -> Result[ValueKind, Error] {
    let mut pos = c.at
    skip(s, mut pos)
    value_start(s, mut pos)
}

/// Reads one JSON boolean.
pub fn read_bool(s: String, mut c: Cursor) -> Result[bool, Error] {
    let (start, end) = expect_kind(s, c.at, JsonBool)?
    c.at = end
    Ok(at(s, start) == b't')
}

/// Reads one JSON string, decoding its escapes.
pub fn read_string(s: String, mut c: Cursor) -> Result[String, Error] {
    let (start, quote) = expect_kind(s, c.at, JsonString)?
    let mut end = quote
    let _ = string_size(s, mut end)?
    let value = decode_string(s, start + 1)?
    c.at = end
    Ok(take value)
}

/// Reads one canonical signed decimal integer with an exact range check.
pub fn read_i64(s: String, mut c: Cursor) -> Result[i64, Error] {
    let (start, end) = integer_span(s, c.at)?
    let value: i64 = int.parse(string.slice(s, start, end)) ?=> |e| integer_error(e, start)
    c.at = end
    Ok(value)
}

/// Reads one canonical unsigned decimal integer with an exact range check.
pub fn read_u64(s: String, mut c: Cursor) -> Result[u64, Error] {
    let (start, end) = integer_span(s, c.at)?
    let value: u64 = int.parse(string.slice(s, start, end)) ?=> |e| integer_error(e, start)
    c.at = end
    Ok(value)
}

fn integer_span(s: String, from: u64) -> Result[(u64, u64), Error] {
    let (start, _) = expect_kind(s, from, JsonNumber)?
    let end = number_end(s, start)
    if !canonical_decimal(string.slice(s, start, end)) {
        return Error(Syntax(start))
    }
    Ok((start, end))
}

fn integer_error(e: ParseError, start: u64) -> Error {
    match e {
        OutOfRange => IntegerRange(start),
        Invalid(offset) => Syntax(start + offset),
        Empty => Syntax(start),
    }
}

fn expect_kind(s: String, from: u64, expected: ValueKind) -> Result[(u64, u64), Error] {
    let mut pos = from
    skip(s, mut pos)
    let start = pos
    if value_start(s, mut pos)? != expected {
        return Error(WrongKind(start))
    }
    Ok((start, pos))
}

/// Consumes null as None. Calls read_some for any other value.
pub fn read_option[T](s: String, mut c: Cursor, read_some: scoped fn(String, mut Cursor) -> Result[T, Error]) -> Result[Option[T], Error] {
    let mut pos = c.at
    skip(s, mut pos)
    if at(s, pos) == b'n' {
        literal(s, mut pos, "null")?
        c.at = pos
        return Ok(None)
    }
    let value = read_some(s, mut c)?
    Ok(Some(take value))
}

/// Checks and consumes one value, returning its original bytes without surrounding whitespace.
pub fn read_raw(s: String, mut c: Cursor) -> Result[View[String], Error] in s {
    let mut start = c.at
    skip(s, mut start)
    let (_, end) = sized_value(s, start)?
    c.at = end
    Ok(string.slice(s, start, end))
}

/// Reads one finite JSON number, with the same grammar as parse.
pub fn read_f64(s: String, mut c: Cursor) -> Result[f64, Error] {
    skip(s, mut c.at)
    let first = at(s, c.at)
    if first != b'-' && !int.is_ascii_digit(first) {
        return Error(Syntax(c.at))
    }
    read_number(s, mut c.at)
}

/// Checks and consumes one complete value without allocating a document.
pub fn skip_value(s: String, mut c: Cursor) -> Result[(), Error] {
    let _ = value_size(s, mut c.at)?
    Ok(())
}

fn opening(s: String, mut i: u64, expected: u8) -> Result[(), Error] {
    skip(s, mut i)
    if at(s, i) != expected {
        return Error(Syntax(i))
    }
    i += 1
    Ok(())
}

// Validate the quoted key and its colon before any decoder takes ownership of it.
fn member_name(s: String, mut i: u64) -> Result[(u64, u64, u64), Error] {
    skip(s, mut i)
    if at(s, i) != b'"' {
        return Error(Syntax(i))
    }
    let start = i + 1
    let width = string_size(s, mut i)?
    let end = i - 1
    opening(s, mut i, b':')?
    Ok((start, end, width))
}

fn decode_string(s: String, start: u64) -> Result[String, Error] {
    let mut key = string.new()
    let mut i = start
    while at(s, i) != b'"' {
        match decoded_string_part(s, mut i)? {
            StringRun(from, end) => string.push(mut key, string.slice(s, from, end)),
            StringEscape(c) => string.push_char(mut key, c),
        }
    }
    Ok(take key)
}

type EmitKind = Raw | Quoted | Key | Signed(i64) | Unsigned(u64) | Double(f64)

/// A scoped serializer that appends directly to the caller's String.
pub scoped type Writer {
    emit: scoped fn(EmitKind, String),
    pretty: bool
}

/// Separator state for the current array or object.
pub type Items {
    depth: u64,
    first: bool
}

/// Appends one value through build. Pretty uses two spaces per level.
/// A refusal raises Capacity, leaving the prefix of completed appends in out.
/// Alloc: GROWTH of out and allocations made by build. Cost: O(output bytes).
pub fn write(mut out: String, pretty: bool, build: scoped fn(json.Writer)) {
    let w = Writer(emit: scoped fn(kind: EmitKind, s: String) {
        match kind {
            Raw => string.push(mut out, s),
            Quoted => push_quoted(mut out, s),
            Key => {
                push_quoted(mut out, s)
                string.push(mut out, if pretty {
                    ": "
                } else {
                    ":"
                })
            },
            Signed(n) => string.push_i64(mut out, n),
            Unsigned(n) => string.push_u64(mut out, n),
            Double(n) => float.push_json_f64(mut out, n),
        }
    }, pretty)
    build(w)
}

fn append_raw(w: json.Writer, s: String) {
    (w.emit)(Raw, s)
}

/// Appends a quoted and escaped string.
pub fn write_string_value(w: json.Writer, s: String) {
    (w.emit)(Quoted, s)
}

/// Appends the original spelling of a number accepted by the JSON reader.
pub fn write_number_spelling(w: json.Writer, spelling: String) {
    append_raw(w, spelling)
}

/// Appends a signed integer as JSON.
pub fn write_i64(w: json.Writer, n: i64) {
    (w.emit)(Signed(n), "")
}

/// Appends an unsigned integer as JSON.
pub fn write_u64(w: json.Writer, value: u64) -> Result[(), Error] {
    (w.emit)(Unsigned(value), "")
    Ok(())
}

/// Appends raw only after checking that it contains one complete JSON value.
pub fn write_raw(w: json.Writer, raw: String) -> Result[(), Error] {
    let _ = size(raw)?
    (w.emit)(Raw, raw)
    Ok(())
}

/// Appends a binary64 using float.push_json_f64, including null for nonfinite.
pub fn write_f64(w: json.Writer, n: f64) {
    (w.emit)(Double(n), "")
}

/// Appends the JSON spelling of a boolean.
pub fn write_bool(w: json.Writer, b: bool) {
    append_raw(w, if b {
        "true"
    } else {
        "false"
    })
}

/// Appends JSON null.
pub fn write_null(w: json.Writer) {
    append_raw(w, "null")
}

fn indent_line(w: json.Writer, depth: u64) {
    append_raw(w, "\n")
    for _ in 0u64 .. depth {
        append_raw(w, "  ")
    }
}

fn container(w: json.Writer, depth: u64, open: String, close: String, body: scoped fn(json.Writer, mut Items)) {
    append_raw(w, open)
    let mut items = Items(depth: depth + 1, first: true)
    body(w, mut items)
    if w.pretty && !items.first {
        indent_line(w, depth)
    }
    append_raw(w, close)
}

/// Appends an array. The root depth is zero. The body calls element
/// before each value and uses items.depth for nested containers.
pub fn array(w: json.Writer, depth: u64, body: scoped fn(json.Writer, mut Items)) {
    container(w, depth, "[", "]", body)
}

/// Appends an object with the same depth convention as array.
/// The body calls write_member before each value.
pub fn object(w: json.Writer, depth: u64, body: scoped fn(json.Writer, mut Items)) {
    container(w, depth, "{", "}", body)
}

/// Writes the separator and any indentation before the next array value.
pub fn element(w: json.Writer, mut items: Items) {
    if !items.first {
        append_raw(w, ",")
    }
    if w.pretty {
        indent_line(w, items.depth)
    }
    items.first = false
}

/// Writes the separator, escaped key, and colon before the next member value.
pub fn write_member(w: json.Writer, mut items: Items, key: String) {
    element(w, mut items)
    (w.emit)(Key, key)
}

/// Appends compact JSON, with members and duplicates in document order. Numbers keep
/// their original spelling; strings escape controls, quotes and backslashes (RFC 8259).
/// Fails: Error(Capacity) at the first refused append. Prefix: all earlier appends stay
/// in s, possibly an unfinished JSON value; the refused append changes nothing.
/// Alloc: GROWTH of s. Cost: O(encoded bytes). Ex: std.json.push_json(mut s, doc)?
pub fn push_json(mut s: String, x: Json) {
    write(mut s, false, scoped fn(w: json.Writer) {
        write_document(w, x, 0, false)
    })
}

/// Appends JSON with two-space indentation and the ObjectIndex duplicate policy.
/// Fails: Capacity, preserving all completed appends. Alloc: GROWTH of s and
/// a temporary index for each object. Cost: O(encoded bytes) plus indexing.
pub fn push_pretty(mut s: String, x: Json) {
    write(mut s, true, scoped fn(w: json.Writer) {
        write_document(w, x, 0, true)
    })
}

fn write_document(w: json.Writer, x: Json, depth: u64, unique: bool) {
    match x {
        Null => write_null(w),
        False => write_bool(w, false),
        True => write_bool(w, true),
        Num(t) => write_number_spelling(w, text.as_string(t)),
        Str(t) => write_string_value(w, text.as_string(t)),
        Arr(xs) => array(w, depth, scoped fn(w2: json.Writer, mut items: Items) {
            for v in xs {
                element(w2, mut items)
                write_document(w2, v, items.depth, unique)
            }
        }),
        Obj(ms) => if unique {
            let order = index(ms)
            object(w, depth, scoped fn(w2: json.Writer, mut items: Items) {
                for i in 0u64 .. seq.len(ms) {
                    if let Some((key, value)) = shown(order, i) {
                        write_member(w2, mut items, key)
                        write_document(w2, value, items.depth, true)
                    }
                }
            })
        } else {
            object(w, depth, scoped fn(w2: json.Writer, mut items: Items) {
                for m in ms {
                    write_member(w2, mut items, text.as_string(m.key))
                    write_document(w2, m.value, items.depth, false)
                }
            })
        },
    }
}

// Goose stdlib/json.goose:35 and serde_json 1.0.154 ser.rs:2079: copy runs
// between ASCII escapes. Each cut is a UTF-8 boundary, including after an escape.
fn push_quoted(mut s: String, value: String) {
    string.push(mut s, "\"")
    let b = string.as_bytes(value)
    let mut start: u64 = 0
    for i in 0 .. list.len(b) {
        let c = b[i]
        if c < 0x20 || c == b'"' || c == b'\\' {
            string.push(mut s, string.slice(value, start, i))
            if c == b'"' {
                string.push(mut s, "\\\"")
            } else if c == b'\\' {
                string.push(mut s, "\\\\")
            } else if c == 8 {
                string.push(mut s, "\\b")
            } else if c == 9 {
                string.push(mut s, "\\t")
            } else if c == 10 {
                string.push(mut s, "\\n")
            } else if c == 12 {
                string.push(mut s, "\\f")
            } else if c == 13 {
                string.push(mut s, "\\r")
            } else {
                // Commit the whole six-byte escape in one append.
                string.reserve(mut s, 6)
                let mut hex: Inline[u8, 64] =[b'0'; 64]
                let control: u64 = int.widen(c)
                let _ = int.radix_digits(control, 16, mut hex)
                string.push(mut s, "\\u00")
                for j in 62u64 .. 64 {
                    let code: u32 = int.widen(hex[j])
                    string.push_char(mut s, option.unwrap(char.from_u32(code)))
                }
            }
            start = i + 1
        }
    }
    string.push(mut s, string.slice(value, start, list.len(b)))
    string.push(mut s, "\"")
}

/// Finds the last member of ms whose key equals k, as a view of its value.
/// Returns None when no member matches. Alloc: none. Cost: one pass.
/// Ex: `match std.json.find(ms, "name") { Some(v) => .., None => .. }`
pub fn find[in a](ms: IndexedSpan[Member] in a, k: String) -> Option[View[Json]] in ms {
    let mut found: Option[View[Json]] in ms = None
    for m in ms {
        if text.as_string(m.key) == k {
            found = Some(m.value)
        }
    }
    found
}

/// An object's members ordered for lookup: a permutation of member ordinals, sorted by key
/// bytes and then by ordinal (goose-attack-898 APPENDIX C7). The members themselves never
/// move. Opaque, so nothing outside this module replaces the members or adds ordinals that
/// were never checked. Cleaned with its list; the document is untouched.
pub opaque type ObjectIndex[in a] {
    members: IndexedSpan[Member] in a,
    ordinals: List[u32],
}

/// Indexes the members ms of one object.
/// Fails: Error(Capacity) when the list of ordinals cannot be reserved; nothing else is
/// admitted. Alloc: exactly 4 x seq.len(ms) bytes, in one list.
/// Cost: O(m log m) key comparisons, each O(key length).
/// Ex: `match doc { Obj(ms) => { let x = std.json.index(ms)?; .. }, _ => .. }`
pub fn index[in a](ms: IndexedSpan[Member] in a) -> ObjectIndex[in a] {
    let n = seq.len(ms)
    let mut ordinals: List[u32] = list.with_capacity(n)
    for i in 0 .. n {
        // The capacity is exactly n, so no push here admits anything.
        list.push(mut ordinals, int.narrow(i))
    }
    list.sort(mut ordinals, fn(x: u32, y: u32) -> Order {
        by_key(ms, x, y)
    })
    ObjectIndex(members: ms, ordinals: take ordinals)
}

/// Reports whether any decoded key occurs more than once in the indexed object.
pub fn has_duplicates[in a](x: ObjectIndex[in a]) -> bool {
    for i in 1u64 .. list.len(x.ordinals) {
        let previous = member(x.members, x.ordinals[i - 1])
        let current = member(x.members, x.ordinals[i])
        if previous.key == current.key {
            return true
        }
    }
    false
}

/// The value of key k: the value of k's last member (the last-value rule; RFC 8259 leaves
/// duplicates open, and Python's json.loads keeps the last). None when no member has k.
/// Cost: O(log m) key comparisons (an upper-bound search).
/// Ex: `match std.json.get(x, step) { Some(v) => .., None => .. }`
pub fn get[in a](x: ObjectIndex[in a], k: String) -> Option[View[Json]] in x {
    let p = above(x, k)
    if p == 0 {
        return None
    }
    let m = member(x.members, x.ordinals[p - 1])
    if text.as_string(m.key) == k {
        Some(m.value)
    } else {
        None
    }
}

/// Member i in render order. None when i is past the last member, or when an earlier
/// member has the same key (that key is shown there). Otherwise Some((key, value)): member
/// i's key, as a String view, with the value of that key's last member. For i from 0 to
/// seq.len(ms), this gives each key once, at its first position, with its last value.
/// Cost: O(log m) key comparisons.
/// Ex: `for i in 0 .. seq.len(ms) { if let Some((k, v)) = std.json.shown(x, i) { .. } }`
pub fn shown[in a](x: ObjectIndex[in a], i: u64) -> Option[(View[String], View[Json])] in x {
    if i >= list.len(x.ordinals) {
        return None
    }
    let k = text.as_string(member(x.members, int.narrow(i)).key)
    let first = below(x, k)
    if i != int.widen(x.ordinals[first]) {
        return None
    }
    let last = member(x.members, x.ordinals[above(x, k) - 1])
    Some((k, last.value))
}

/// The first position in x.ordinals whose key is above k.
fn above[in a](x: ObjectIndex[in a], k: String) -> u64 {
    match list.binary_search_by(x.ordinals, scoped fn(ordinal: u32) -> Order {
        if k < text.as_string(member(x.members, ordinal).key) {
            Greater
        } else {
            Less
        }
    }) {
        Ok(i) => i,
        Error(i) => i,
    }
}

/// The first position in x.ordinals whose key is not below k.
fn below[in a](x: ObjectIndex[in a], k: String) -> u64 {
    match list.binary_search_by(x.ordinals, scoped fn(ordinal: u32) -> Order {
        if text.as_string(member(x.members, ordinal).key) < k {
            Less
        } else {
            Greater
        }
    }) {
        Ok(i) => i,
        Error(i) => i,
    }
}

/// Orders ordinals x and y by their members' keys, then by ordinal.
fn by_key[in a](ms: IndexedSpan[Member] in a, x: u32, y: u32) -> Order {
    let kx = member(ms, x).key
    let ky = member(ms, y).key
    if kx < ky {
        Less
    } else if ky < kx {
        Greater
    } else if x < y {
        Less
    } else if y < x {
        Greater
    } else {
        Equal
    }
}

/// Member o of ms. Every ordinal in an index came from 0 .. seq.len(ms).
fn member[in a](ms: IndexedSpan[Member] in a, o: u32) -> View[Member] in ms {
    match indexed.get(ms, int.widen(o)) {
        Some(m) => m,
        None => fail("json: an ordinal past the members"),
    }
}

/// Reads a numeric node as an exact canonical i64.
pub fn as_i64(x: Json) -> Option[i64] {
    let Some(s) = integer_spelling(x) else {
        return None
    }
    let parsed: Result[i64, ParseError] = int.parse(s)
    match parsed {
        Ok(n) => Some(n),
        Error(_) => None,
    }
}

/// Reads a numeric node as an exact canonical u64.
pub fn as_u64(x: Json) -> Option[u64] {
    let Some(s) = integer_spelling(x) else {
        return None
    }
    let parsed: Result[u64, ParseError] = int.parse(s)
    match parsed {
        Ok(n) => Some(n),
        Error(_) => None,
    }
}

fn integer_spelling(x: Json) -> Option[View[String]] in x {
    let Num(spelling) = x else {
        return None
    }
    let s = text.as_string(spelling)
    if canonical_decimal(s) {
        Some(s)
    } else {
        None
    }
}

/// Reads a numeric node as a finite binary64.
pub fn as_f64(x: Json) -> Option[f64] {
    let Num(spelling) = x else {
        return None
    }
    match float.parse64(text.as_string(spelling)) {
        Ok(n) => Some(n),
        Error(_) => None,
    }
}

/// Resolves an RFC 6901 JSON Pointer and borrows the selected node from x.
pub fn pointer(x: Json, p: String) -> Option[View[Json]] in x {
    if string.byte_len(p) == 0 {
        return Some(view x)
    }
    if at(p, 0) != b'/' {
        return None
    }
    pointer_at(x, p, 1)
}

fn pointer_at(x: Json, p: String, start: u64) -> Option[View[Json]] in x {
    let length = string.byte_len(p)
    let end = match string.find(p, start, "/") {
        Some(i) => i,
        None => length,
    }
    let token = string.slice(p, start, end)
    let selected: Option[View[Json]] in x = match x {
        Obj(ms) => if let Some(_) = string.find(token, 0, "~") {
            let Some(key) = pointer_unescape(token) else {
                return None
            }
            pointer_member(ms, key)
        } else {
            pointer_member(ms, token)
        },
        Arr(xs) => {
            if !int.is_ascii_digit(at(token, 0)) || !canonical_decimal(token) {
                return None
            }
            let i: Result[u64, ParseError] = int.parse(token)
            let Ok(ordinal) = i else {
                return None
            }
            indexed.get(xs, ordinal)
        },
        _ => None,
    }
    if end == length {
        return selected
    }
    let Some(child) = selected else {
        return None
    }
    pointer_at(child, p, end + 1)
}

fn pointer_member[in a](ms: IndexedSpan[Member] in a, key: String) -> Option[View[Json]] in ms {
    let mut found: Option[View[Json]] in ms = None
    for m in ms {
        if text.as_string(m.key) == key {
            if let Some(_) = found {
                return None
            }
            found = Some(m.value)
        }
    }
    found
}

fn pointer_unescape(token: String) -> Option[String] {
    let mut key = string.new()
    let mut start: u64 = 0
    while let Some(i) = string.find(token, start, "~") {
        string.push(mut key, string.slice(token, start, i))
        match at(token, i + 1) {
            b'0' => string.push(mut key, "~"),
            b'1' => string.push(mut key, "/"),
            _ => return None,
        }
        start = i + 2
    }
    string.push(mut key, string.slice(token, start, string.byte_len(token)))
    Some(take key)
}

fn literal(s: String, mut i: u64, word: String) -> Result[(), Error] {
    if !list.starts_with_at(string.as_bytes(s), i, string.as_bytes(word)) {
        return Error(Syntax(i))
    }
    i += string.byte_len(word)
    Ok(())
}

fn value_start(s: String, mut i: u64) -> Result[ValueKind, Error] {
    let c = at(s, i)
    match c {
        b'n' => {
            literal(s, mut i, "null")?
            Ok(JsonNull)
        },
        b't' => {
            literal(s, mut i, "true")?
            Ok(JsonBool)
        },
        b'f' => {
            literal(s, mut i, "false")?
            Ok(JsonBool)
        },
        b'"' => Ok(JsonString),
        b'[' => {
            i += 1
            Ok(JsonArray)
        },
        b'{' => {
            i += 1
            Ok(JsonObject)
        },
        _ => if c == b'-' || int.is_ascii_digit(c) {
            Ok(JsonNumber)
        } else {
            Error(Syntax(i))
        },
    }
}

fn value_size(s: String, mut i: u64) -> Result[u64, Error] {
    let (n, after) = sized_value(s, i)?
    i = after
    Ok(n)
}

// One value from byte `from`: its size and the byte after it. Iterative, with
// serde_json's depth limit: each open container's closing bracket is one bit
// (1 = '}') of a 128-bit shift register, so nothing is initialized per call. The
// position comes in and goes out by value, so the walk stays one shared copy that
// size and every skip_value call, the way the recursive sizer did.
fn sized_value(s: String, from: u64) -> Result[(u64, u64), Error] {
    let mut i = from
    let mut n: u64 = 0
    let mut close: u8 = 0
    let mut depth: u64 = 0
    let mut low: u64 = 0
    let mut high: u64 = 0
    loop {
        skip(s, mut i)
        let opened: u8 = match value_start(s, mut i)? {
            JsonNull => {
                n += 1
                0
            },
            JsonBool => {
                n += 1
                0
            },
            JsonString => {
                n += 5 + string_size(s, mut i)?
                0
            },
            JsonNumber => {
                n += 5 + number_size(s, mut i)?
                0
            },
            JsonArray => b']',
            JsonObject => b'}',
        }
        if opened != 0 {
            if depth == MAX_DEPTH {
                return Error(Depth)
            }
            n += 9
        }
        if opened != 0 && !ends(s, mut i, opened) {
            let bit: u64 = if close == b'}' {
                1
            } else {
                0
            }
            high = (high << 1) | (low >> 63)
            low = (low << 1) | bit
            depth += 1
            close = opened
        } else {
            while close != 0 && after_item(s, mut i, close)? {
                depth -= 1
                close = if depth == 0 {
                    0
                } else if low & 1 == 1 {
                    b'}'
                } else {
                    b']'
                }
                low = (low >> 1) | (high << 63)
                high = high >> 1
            }
        }
        if close == 0 {
            return Ok((n, i))
        }
        n += 4
        if close == b'}' {
            let (_, _, width) = member_name(s, mut i)?
            n += 4 + width
        }
    }
}

// Stop before the first quote, escape or control in the complete blocks.
fn scan_string_blocks(input: Bytes, start: u64) -> u64 {
    let quote: Simd[u8, 32] = simd.splat(b'"')
    let slash: Simd[u8, 32] = simd.splat(b'\\')
    let space: Simd[u8, 32] = simd.splat(0x20)
    let end = list.len(input)
    let mut i = start
    while end - i >= 32 {
        let block: Simd[u8, 32] = list.lanes(input, i)
        let special = simd.eq(block, quote) | simd.eq(block, slash) | simd.lt(block, space)
        let mask = simd.bitmask(special)
        if mask != 0 {
            let offset: u64 = int.widen(int.trailing_zeros(mask))
            return i + offset
        }
        i += 32
    }
    i
}

// The first marked byte is exact. A borrow can only mark higher bytes.
fn string_word_prefix(b: Bytes, i: u64) -> u64 {
    let v = list.word_le(b, i)
    let q = v ^ 0x2222222222222222
    let slash = v ^ 0x5c5c5c5c5c5c5c5c
    let controls = int.wrapping_sub(v, 0x2020202020202020) & ~v
    let quotes = int.zero_byte_marks(q)
    let slashes = int.zero_byte_marks(slash)
    let mark = (controls | quotes | slashes) & 0x8080808080808080
    let bit: u64 = int.widen(int.trailing_zeros(mark))
    bit >> 3
}

/// At the opening '"': the decoded UTF-8 length of the string.
fn string_size(s: String, mut i: u64) -> Result[u64, Error] {
    i += 1
    let start = i
    let b = string.as_bytes(s)
    let end = list.len(b)
    // Size short, unescaped strings without entering the escape loop.
    // The cursor starts at an opening quote and each step stays within b.
    for _ in 0u32 .. 2 {
        if int.wrapping_sub(end, i) < 8 {
            break
        }
        let run = string_word_prefix(b, i)
        i = int.wrapping_add(i, run)
        if run != 8 {
            if b[i] == b'"' {
                let n = int.wrapping_sub(i, start)
                i += 1
                return Ok(n)
            }
            break
        }
    }
    let prefix = int.wrapping_sub(i, start)
    string_size_rest(s, mut i, prefix)
}

fn string_size_rest(s: String, mut i: u64, prefix: u64) -> Result[u64, Error] {
    let mut n = prefix
    let b = string.as_bytes(s)
    let end = list.len(b)
    loop {
        let c = at(s, i)
        if c == b'"' {
            i += 1
            return Ok(n)
        }
        if c < 0x20 {
            // A control byte, or the end of s, where `at` reads 0.
            return Error(Syntax(i))
        }
        if c != b'\\' {
            if i + 8 <= end {
                let run = string_word_prefix(b, i)
                if run != 8 {
                    n += run
                    i += run
                } else {
                    let start = i
                    i += 8
                    if end - i >= 32 {
                        i = scan_string_blocks(b, i)
                    }
                    n += i - start
                }
                continue
            }
            n += 1
            i += 1
        } else if at(s, i + 1) == b'u' {
            n += char.utf8_len(unicode(s, mut i)?)
        } else if is_escape(at(s, i + 1)) {
            n += 1
            i += 2
        } else {
            return Error(Syntax(i + 1))
        }
    }
}

/// At a number's first byte: the length of its spelling. float.parse64 checks the
/// grammar, which is JSON's, and the range.
fn number_size(s: String, mut i: u64) -> Result[u64, Error] {
    let start = i
    let _ = read_number(s, mut i)?
    Ok(i - start)
}

fn number_end(s: String, from: u64) -> u64 {
    let mut i = from
    let b = string.as_bytes(s)
    let end = list.len(b)
    loop {
        if i + 8 <= end {
            // fast-float2 common.rs::is_8digits. A valid digit prefix cannot carry
            // or borrow into the first non-digit, so its lowest mark is exact.
            let v = list.word_le(b, i)
            let high = int.wrapping_add(v, 0x4646464646464646)
            let low = int.wrapping_sub(v, 0x3030303030303030)
            let mark = (high | low) & 0x8080808080808080
            if mark == 0 {
                i += 8
                continue
            }
            let bit: u64 = int.widen(int.trailing_zeros(mark))
            i += bit >> 3
        }
        if !is_number_byte(at(s, i)) {
            break
        }
        i += 1
    }
    i
}

fn read_number(s: String, mut i: u64) -> Result[f64, Error] {
    let start = i
    i = number_end(s, start)
    match float.parse64(string.slice(s, start, i)) {
        Ok(v) => Ok(v),
        Error(OutOfRange) => Error(NotFinite(start)),
        Error(Invalid(p)) => Error(Syntax(start + p)),
        Error(Empty) => Error(Syntax(start)),
    }
}

/// Skips whitespace; if the byte at i is `end`, steps past it and returns true.
fn ends(s: String, mut i: u64, end: u8) -> bool {
    skip(s, mut i)
    if at(s, i) == end {
        i += 1
        true
    } else {
        false
    }
}

/// After an element: true when `end` closes the container. False after a ',', which
/// another element must follow, so a trailing comma is Syntax at the `end` after it.
fn after_item(s: String, mut i: u64, end: u8) -> Result[bool, Error] {
    skip(s, mut i)
    let c = at(s, i)
    if c == end {
        i += 1
        return Ok(true)
    }
    if c != b',' {
        return Error(Syntax(i))
    }
    i += 1
    Ok(false)
}

/// At the '\' of `\uXXXX`: the scalar it denotes, reading a surrogate pair as one scalar.
/// A lone surrogate is Syntax, because a Text holds valid UTF-8 only.
fn unicode(s: String, mut i: u64) -> Result[char, Error] {
    let start = i
    let hi = hex4(s, i + 2)?
    i += 6
    let mut cp = hi
    if hi >= 0xD800 && hi <= 0xDBFF {
        if at(s, i) != b'\\' || at(s, i + 1) != b'u' {
            return Error(Syntax(i))
        }
        let lo = hex4(s, i + 2)?
        if lo < 0xDC00 || lo > 0xDFFF {
            return Error(Syntax(i))
        }
        i += 6
        cp = 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
    }
    match char.from_u32(cp) {
        Some(c) => Ok(c),
        None => Error(Syntax(start)),
    }
}

/// The four hex digits at p.
fn hex4(s: String, p: u64) -> Result[u32, Error] {
    let mut v: u32 = 0
    for k in p .. p + 4 {
        let Some(digit) = int.ascii_digit(at(s, k), 16) else {
            return Error(Syntax(k))
        }
        let d: u32 = int.widen(digit)
        v = v * 16 + d
    }
    Ok(v)
}

// Writing pass. It runs only on input that `size` has accepted, and s is frozen for the
// call, so every check it would repeat has already passed. Where a branch cannot be
// reached, it fails (FOR SPEC 7).
fn write_value[in r](s: String, mut i: u64, take w: core.Writer[Json, in r]) -> Result[Child[Json], BuildError] {
    skip(s, mut i)
    let c = at(s, i)
    if c == b'n' {
        i += 4
        emit(take w, Null)
    } else if c == b't' {
        i += 4
        emit(take w, True)
    } else if c == b'f' {
        i += 5
        emit(take w, False)
    } else if c == b'"' {
        emit(take w, Str(emit(fn(take t: core.Writer[Text, in r]) -> Result[Child[Text], BuildError] {
            write_string(s, mut i, take t)
        })))
    } else if c == b'[' {
        i += 1
        emit(take w, Arr(emit(fn(take xs: core.Writer[IndexedSpan[Json], in r]) -> Result[Child[IndexedSpan[Json]], BuildError] {
            skip(s, mut i)
            while at(s, i) != b']' {
                writer.append(mut xs, fn(take x: core.Writer[Json, in r]) -> Result[Child[Json], BuildError] {
                    write_value(s, mut i, take x)
                })?
                skip(s, mut i)
                if at(s, i) == b',' {
                    i += 1
                }
            }
            i += 1
            writer.close(take xs)
        })))
    } else if c == b'{' {
        i += 1
        emit(take w, Obj(emit(fn(take ms: core.Writer[IndexedSpan[Member], in r]) -> Result[Child[IndexedSpan[Member]], BuildError] {
            skip(s, mut i)
            while at(s, i) != b'}' {
                writer.append(mut ms, fn(take m: core.Writer[Member, in r]) -> Result[Child[Member], BuildError] {
                    skip(s, mut i)
                    emit(take m, Member(key: emit(fn(take t: core.Writer[Text, in r]) -> Result[Child[Text], BuildError] {
                        write_string(s, mut i, take t)
                    }), value: emit(fn(take v: core.Writer[Json, in r]) -> Result[Child[Json], BuildError] {
                        skip(s, mut i)
                        i += 1
                        write_value(s, mut i, take v)
                    }),))
                })?
                skip(s, mut i)
                if at(s, i) == b',' {
                    i += 1
                    skip(s, mut i)
                }
            }
            i += 1
            writer.close(take ms)
        })))
    } else {
        // A number: its spelling, copied in one write.
        let start = i
        i = number_end(s, start)
        emit(take w, Num(string.slice(s, start, i)))
    }
}

type DecodedStringPart: key = StringRun(u64, u64) | StringEscape(char)

// Consumes a run or escape before the closing quote accepted by string_size.
// Runs stop at ASCII delimiters, so their offsets are String boundaries.
fn decoded_string_part(s: String, mut i: u64) -> Result[DecodedStringPart, Error] {
    if at(s, i) == b'\\' {
        let escape = at(s, i + 1)
        let c = if escape == b'u' {
            unicode(s, mut i)?
        } else {
            i += 2
            unescape(escape)
        }
        return Ok(StringEscape(c))
    }
    let start = i
    i += 1
    while at(s, i) != b'"' && at(s, i) != b'\\' {
        i += 1
    }
    Ok(StringRun(start, i))
}

/// At the opening '"': writes the decoded string, then closes it. Each run
/// between escapes is one push and each escape is one scalar.
fn write_string[in r](s: String, mut i: u64, take t: core.Writer[Text, in r]) -> Result[Child[Text], BuildError] {
    i += 1
    while at(s, i) != b'"' {
        let part = match decoded_string_part(s, mut i) {
            Ok(value) => value,
            Error(_) => fail("json: an escape that size accepted is refused"),
        }
        match part {
            StringRun(start, end) => writer.push(mut t, string.slice(s, start, end))?,
            StringEscape(c) => writer.scalar(mut t, c)?,
        }
    }
    i += 1
    writer.close(take t)
}

/// The character a one-letter escape denotes.
fn unescape(e: u8) -> char {
    if e == b'n' {
        '\n'
    } else if e == b't' {
        '\t'
    } else if e == b'r' {
        '\r'
    } else if e == b'b' {
        '\u{8}'
    } else if e == b'f' {
        '\u{c}'
    } else {
        // '"', '\\' or '/', each itself.
        ascii(e)
    }
}

// Bytes.
/// Byte i of s, or 0 past its end. 0 is no JSON token byte, so the end of s
/// is refused where a token is expected.
fn at(s: String, i: u64) -> u8 {
    let b = string.as_bytes(s)
    if i < list.len(b) {
        b[i]
    } else {
        0
    }
}

/// Skips JSON whitespace: space, tab, line feed, carriage return.
fn skip(s: String, mut i: u64) {
    loop {
        let c = at(s, i)
        if c != b' ' && c != b'\t' && c != b'\n' && c != b'\r' {
            return
        }
        i += 1
    }
}

/// A byte that can appear in a number's spelling. float.parse64 checks where each one may go.
fn is_number_byte(x: u8) -> bool {
    int.is_ascii_digit(x) || x == b'-' || x == b'+' || x == b'.' || x == b'e' || x == b'E'
}

fn is_escape(e: u8) -> bool {
    e == b'"' || e == b'\\' || e == b'/' || e == b'b' || e == b'f' || e == b'n' || e == b'r' || e == b't'
}

/// The char of an ASCII byte.
fn ascii(x: u8) -> char {
    match char.from_u32(int.widen(x)) {
        Some(c) => c,
        None => fail("json: an ASCII byte is a scalar"),
    }
}

// Typed JSON uses a prepared graph. Definition indices occupy its initial slots;
// structural expressions add nodes as the reachable definitions are expanded.
pub opaque type Format[T] {
    binary: codec.Codec[T],
    plan: JsonPlan
}

type JsonPlan {
    description: codec.Schema,
    root: u64,
    shapes: List[Shape],
    facts: List[ShapeFact],
    profile: Profile
}

type Profile: key = Strict | Interop

type Shape = Atom(u8) | Array(u64) | Pairs(u64, u64) | Optional(u64) | Outcome(u64, u64) | Record(List[Field]) | Sum(List[Variant]) | Via(u64)

type Field {
    name: String,
    shape: u64
}

type Variant {
    name: String,
    fields: List[u64],
    live: bool
}

type ShapeFact {
    // The underlying JSON shape, with all via layers stripped.
    form: u64,
    empty: bool,
    state: u8
}

pub type SchemaIssue = Tuple | NullableOption | EmptyListElement | EmptyMapEntry | NonConsumingCycle

pub type InputIssue = InvalidUtf8 | ExpectedValue | InvalidNumber | InvalidBase64 | UnknownMember | DuplicateMember | MissingMember | DepthLimit | CodecValue(codec.DecodeError)

/// Input offsets are byte offsets in the original JSON. Paths use RFC 6901
/// JSON Pointer, with the empty string denoting the root.
pub type TypedError = Input(u64, String, InputIssue) | Schema(u8, SchemaIssue) | CodecFormat(codec.EncodeError) | LengthOverflow | Capacity(Capacity)

/// Prepares the B-4 JSON profile of T. The format can be reused across values.
pub fn typed[T: codec]() -> Result[Format[T], TypedError] {
    prepare(Strict)
}

/// Prepares the external-API JSON profile of T.
pub fn interop[T: codec]() -> Result[Format[T], TypedError] {
    prepare(Interop)
}

fn prepare[T: codec](profile: Profile) -> Result[Format[T], TypedError] {
    let binary: codec.Codec[T] = codec.of()
    let description = codec.describe(binary) ?=> CodecFormat
    let count = codec.schema_definitions(description)
    let mut shapes: List[Shape] = list.with_capacity(count)
    let mut pending: List[u64] = list.new()
    for _ in 0u64 .. count {
        shape_push(mut shapes, Atom(255))?
    }
    let mut seen: Bytes = list.new()
    list.fill(mut seen, count, 0)
    let mut pos: u64 = 0
    let root = compile_shape(codec.schema_root(description), mut pos, mut shapes, mut seen, mut pending)?
    while let Some(node) = list.pop(mut pending) {
        let d = codec.schema_definition(description, node)
        let shape = compile_definition(d, mut shapes, mut seen, mut pending)?
        let _ = list.set(mut shapes, node, take shape)
    }
    let facts = shape_facts(shapes)?
    Ok(Format(binary, plan: JsonPlan(description: take description, root, shapes: take shapes, facts: take facts, profile)))
}

fn shape_push[T](mut values: List[T], take x: T) -> Result[(), TypedError] {
    list.push(mut values, take x)
    Ok(())
}

fn compile_shape(b: Bytes, mut pos: u64, mut shapes: List[Shape], mut seen: Bytes, mut pending: List[u64]) -> Result[u64, TypedError] {
    let op = b[pos]
    pos += 1
    let shape: Shape = match op {
        14 => Array(compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?),
        15 => {
            let key = compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?
            Pairs(key, compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?)
        },
        16 => Optional(compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?),
        17 => {
            let ok = compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?
            Outcome(ok, compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?)
        },
        18 => return Error(Schema(18, Tuple)),
        19 => {
            let node = codec.schema_word(b, pos)
            pos += 4
            if seen[node] == 0 {
                seen[node] = 1
                shape_push(mut pending, node)?
            }
            return Ok(node)
        },
        _ => Atom(op),
    }
    let node = list.len(shapes)
    shape_push(mut shapes, take shape)?
    Ok(node)
}

fn schema_name(b: Bytes, mut pos: u64) -> Result[String, TypedError] {
    let n = codec.schema_word(b, pos)
    pos += 4
    let mut name: Bytes = list.with_capacity(n)
    let _ = list.append(mut name, list.slice(b, pos, pos + n))
    pos += n
    match string.from_utf8(take name) {
        Ok(take s) => Ok(take s),
        Error(_) => fail("codec schema name is UTF-8"),
    }
}

fn compile_definition(b: Bytes, mut shapes: List[Shape], mut seen: Bytes, mut pending: List[u64]) -> Result[Shape, TypedError] {
    let mut pos: u64 = 1
    if b[0] == 2 {
        return Ok(Via(compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?))
    }
    let n = codec.schema_word(b, pos)
    pos += 4
    if b[0] == 0 {
        let mut fields: List[Field] = list.new()
        for _ in 0u64 .. n {
            let live = b[pos] == 0
            pos += 1
            let name = schema_name(b, mut pos)?
            if live {
                let shape = compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?
                shape_push(mut fields, Field(name: take name, shape))?
            } else {
                pos = codec.schema_next(b, pos)
            }
        }
        return Ok(Record(take fields))
    }
    let mut variants: List[Variant] = list.with_capacity(n)
    for _ in 0u64 .. n {
        let live = b[pos] == 0
        pos += 1
        let name = schema_name(b, mut pos)?
        let width = codec.schema_word(b, pos)
        pos += 4
        let mut fields: List[u64] = list.new()
        for _ in 0u64 .. width {
            if live {
                let child = compile_shape(b, mut pos, mut shapes, mut seen, mut pending)?
                shape_push(mut fields, child)?
            } else {
                pos = codec.schema_next(b, pos)
            }
        }
        shape_push(mut variants, Variant(name: take name, fields: take fields, live))?
    }
    Ok(Sum(take variants))
}

// Only a record or via can follow a required child before consuming any codec
// bytes. A DFS over just those edges both checks cycles and finds LEAST == 0.
fn shape_fact(shapes: List[Shape], mut facts: List[ShapeFact], node: u64) -> Result[(), TypedError] {
    match facts[node].state {
        2 => return Ok(()),
        1 => return Error(Schema(19, NonConsumingCycle)),
        _ => {},
    }
    facts[node].state = 1
    let mut empty = false
    let mut form = node
    match shapes[node] {
        Atom(op) => {
            empty = op == 0
        },
        Via(child) => {
            shape_fact(shapes, mut facts, child)?
            empty = facts[child].empty
            form = facts[child].form
        },
        Record(fields) => {
            empty = true
            for field in fields {
                shape_fact(shapes, mut facts, field.shape)?
                empty = empty && facts[field.shape].empty
            }
        },
        _ => {},
    }
    facts[node] = ShapeFact(form, empty, state: 2)
    Ok(())
}

fn shape_facts(shapes: List[Shape]) -> Result[List[ShapeFact], TypedError] {
    let mut facts: List[ShapeFact] = list.with_capacity(list.len(shapes))
    for i in 0u64 .. list.len(shapes) {
        shape_push(mut facts, ShapeFact(form: i, empty: false, state: 0))?
    }
    for i in 0u64 .. list.len(shapes) {
        shape_fact(shapes, mut facts, i)?
    }
    for s in shapes {
        match s {
            Optional(child) => match shapes[facts[child].form] {
                Atom(0) => return Error(Schema(16, NullableOption)),
                Optional(_) => return Error(Schema(16, NullableOption)),
                _ => {},
            },
            Array(child) => if facts[child].empty {
                return Error(Schema(14, EmptyListElement))
            },
            Pairs(key, value) => if facts[key].empty && facts[value].empty {
                return Error(Schema(15, EmptyMapEntry))
            },
            _ => {},
        }
    }
    Ok(take facts)
}

type ReadTyped {
    pos: u64,
    path: String,
    marks: List[SourceMark]
}

type SourceMark {
    pos: u64,
    source: u64,
    path: String,
    key: bool
}

/// Decodes one UTF-8 JSON value under format. The byte bound accounts for
/// scratch codec bytes, source locations and the actual codec decoder.
pub fn decode_typed[T](format: Format[T], take input: Bytes, byte_limit: u64) -> Result[T, TypedError] {
    let s = match string.from_utf8(take input) {
        Ok(take s) => take s,
        Error(b) => match utf8.validate(b) {
            Error(e) => return Error(Input(e.valid_up_to, string.new(), InvalidUtf8)),
            Ok(()) => fail("UTF-8 validation must agree"),
        },
    }
    from_string(format, s, byte_limit)
}

/// Decodes one JSON value from a borrowed String under the same byte bound.
pub fn from_string[T](format: Format[T], input: String, byte_limit: u64) -> Result[T, TypedError] {
    let decoded = bound bytes byte_limit {
        decode_profile(format, input)
    }
    match take decoded {
        Ok(take result) => take result,
        Error(e) => Error(Capacity(e)),
    }
}

fn decode_profile[T](format: Format[T], s: String) -> Result[T, TypedError] {
    let plan = view format.plan
    let mut d = ReadTyped(pos: 0, path: string.new(), marks: list.new())
    skip(s, mut d.pos)
    let start = d.pos
    let mut out: Bytes = list.new()
    read_shape(plan, plan.root, s, 0, mut d, mut out)?
    skip(s, mut d.pos)
    if d.pos != string.byte_len(s) {
        let stop = d.pos
        return input_error(mut d, stop, ExpectedValue)
    }
    match codec.decode(format.binary, out) {
        Ok(take value) => Ok(take value),
        Error(e) => codec_input_error(d, start, e),
    }
}

fn codec_input_error[T](d: ReadTyped, start: u64, e: codec.DecodeError) -> Result[T, TypedError] {
    let (pos, key) = match e {
        Duplicate(p) => (p, true),
        Value(p) => (p, false),
        _ => return Error(Input(start, string.new(), CodecValue(e))),
    }
    for mark in d.marks {
        if mark.pos == pos && mark.key == key {
            let path = string.from(mark.path)
            return Error(Input(mark.source, take path, CodecValue(e)))
        }
    }
    Error(Input(start, string.new(), CodecValue(e)))
}

fn input_error[T](mut d: ReadTyped, pos: u64, issue: InputIssue) -> Result[T, TypedError] {
    let path = replace(mut d.path, string.new())
    Error(Input(pos, take path, issue))
}

fn read_error[T](take r: Result[T, Error], mut d: ReadTyped) -> Result[T, TypedError] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(Syntax(pos)) => input_error(mut d, pos, ExpectedValue),
        Error(NotFinite(pos)) => input_error(mut d, pos, InvalidNumber),
        _ => fail("typed JSON uses lexical readers"),
    }
}

fn field_path(mut d: ReadTyped, name: String) -> Result[(), TypedError] {
    string.push(mut d.path, "/")
    let mut start: u64 = 0
    let b = string.as_bytes(name)
    for i in 0u64 .. list.len(b) {
        if b[i] == b'~' || b[i] == b'/' {
            string.push(mut d.path, string.slice(name, start, i))
            string.push(mut d.path, if b[i] == b'~' {
                "~0"
            } else {
                "~1"
            })
            start = i + 1
        }
    }
    string.push(mut d.path, string.slice(name, start, list.len(b)))
    Ok(())
}

fn index_path(mut d: ReadTyped, n: u64) -> Result[(), TypedError] {
    string.push(mut d.path, "/")
    string.push_u64(mut d.path, n)
    Ok(())
}

fn source_mark(mut d: ReadTyped, pos: u64, key: bool) -> Result[(), TypedError] {
    let path = string.from(d.path)
    let source = d.pos
    shape_push(mut d.marks, SourceMark(pos, source, path: take path, key))
}

const TYPED_DEPTH: u64 = 64

fn open_typed(s: String, depth: u64, bracket: u8, mut d: ReadTyped) -> Result[(), TypedError] {
    skip(s, mut d.pos)
    if depth == TYPED_DEPTH && at(s, d.pos) == bracket {
        let pos = d.pos
        return input_error(mut d, pos, DepthLimit)
    }
    let opened = opening(s, mut d.pos, bracket)
    read_error(take opened, mut d)
}

fn after_typed(s: String, bracket: u8, mut d: ReadTyped) -> Result[bool, TypedError] {
    let after = after_item(s, mut d.pos, bracket)
    read_error(take after, mut d)
}

fn close_typed(s: String, bracket: u8, mut d: ReadTyped) -> Result[(), TypedError] {
    let closed = opening(s, mut d.pos, bracket)
    read_error(take closed, mut d)
}

fn typed_string(s: String, mut d: ReadTyped) -> Result[String, TypedError] {
    let start = d.pos + 1
    let opened = at(s, d.pos) == b'"'
    if !opened {
        let pos = d.pos
        return input_error(mut d, pos, ExpectedValue)
    }
    let measured = string_size(s, mut d.pos)
    let _ = read_error(take measured, mut d)?
    read_error(decode_string(s, start), mut d)
}

fn typed_name(s: String, mut d: ReadTyped) -> Result[String, TypedError] {
    skip(s, mut d.pos)
    let name = typed_string(s, mut d)?
    close_typed(s, b':', mut d)?
    Ok(take name)
}

fn remember_member(mut seen: Map[String, ()], take name: String, pos: u64, mut d: ReadTyped) -> Result[(), TypedError] {
    if let Some(_) = map.get(seen, name) {
        return input_error(mut d, pos, DuplicateMember)
    }
    map.insert(mut seen, take name, ())
    Ok(())
}

fn skip_typed(s: String, depth: u64, mut d: ReadTyped) -> Result[(), TypedError] {
    skip(s, mut d.pos)
    let start = d.pos
    let head = value_start(s, mut d.pos)
    let close: u8 = match read_error(take head, mut d)? {
        JsonArray => b']',
        JsonObject => b'}',
        JsonString => {
            let measured = string_size(s, mut d.pos)
            let _ = read_error(take measured, mut d)?
            return Ok(())
        },
        JsonNumber => {
            let measured = number_size(s, mut d.pos)
            let _ = read_error(take measured, mut d)?
            return Ok(())
        },
        _ => return Ok(()),
    }
    if depth == TYPED_DEPTH {
        return input_error(mut d, start, DepthLimit)
    }
    let path = string.byte_len(d.path)
    let mut seen: Map[String, ()] = map.new()
    let mut i: u64 = 0
    if !ends(s, mut d.pos, close) {
        loop {
            if close == b'}' {
                skip(s, mut d.pos)
                let pos = d.pos
                let name = typed_name(s, mut d)?
                field_path(mut d, name)?
                remember_member(mut seen, take name, pos, mut d)?
            } else {
                index_path(mut d, i)?
                i += 1
            }
            skip_typed(s, depth + 1, mut d)?
            string.truncate(mut d.path, path)
            if after_typed(s, close, mut d)? {
                break
            }
        }
    }
    Ok(())
}

fn put_typed_count(n: u64, mut out: Bytes) -> Result[(), TypedError] {
    let narrowed: Option[u32] = int.try_narrow(n)
    let Some(count) = narrowed else {
        return Error(LengthOverflow)
    }
    codec.put_u32(count, mut out)
    Ok(())
}

fn patch_typed_count(mut out: Bytes, start: u64, n: u64) -> Result[(), TypedError] {
    if n > 4294967295 {
        return Error(LengthOverflow)
    }
    for i in 0u64 .. 4 {
        out[start + i] = int.truncate(n >> (8 * i))
    }
    Ok(())
}

fn read_shape(plan: JsonPlan, shape: u64, s: String, depth: u64, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    skip(s, mut d.pos)
    let form = plan.facts[shape].form
    if form != shape {
        source_mark(mut d, list.len(out), false)?
    }
    match plan.shapes[form] {
        Atom(op) => read_atom(plan.profile, op, s, mut d, mut out),
        Array(item) => if let Atom(3) = plan.shapes[item] {
            read_base64(s, mut d, mut out)
        } else {
            read_sequence(plan, item, None, s, depth, mut d, mut out)
        },
        Pairs(key, value) => if string_map(plan, key) {
            read_string_map(plan, value, s, depth, mut d, mut out)
        } else {
            read_sequence(plan, key, Some(value), s, depth, mut d, mut out)
        },
        Optional(item) => {
            if at(s, d.pos) == b'n' {
                let parsed = literal(s, mut d.pos, "null")
                read_error(take parsed, mut d)?
                codec.put_tag(0, mut out)
                Ok(())
            } else {
                codec.put_tag(1, mut out)
                read_shape(plan, item, s, depth, mut d, mut out)
            }
        },
        Outcome(ok, err) => read_outcome(plan, ok, err, s, depth, mut d, mut out),
        Record(fields) => read_record(plan, form, fields, s, depth, mut d, mut out),
        Sum(variants) => read_sum(plan, variants, s, depth, mut d, mut out),
        Via(_) => fail("prepared JSON form has no via layer"),
    }
}

fn read_base64(s: String, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    let start = d.pos
    let spelling = typed_string(s, mut d)?
    let Some(decoded) = base64.decode(string.as_bytes(spelling)) else {
        return input_error(mut d, start, InvalidBase64)
    }
    put_typed_count(list.len(decoded), mut out)?
    list.append(mut out, decoded)
    Ok(())
}

fn read_sequence(plan: JsonPlan, item: u64, value: Option[u64], s: String, depth: u64, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    open_typed(s, depth, b'[', mut d)?
    let start = list.len(out)
    codec.put_u32(0, mut out)
    let mut n: u64 = 0
    let path = string.byte_len(d.path)
    if !ends(s, mut d.pos, b']') {
        loop {
            index_path(mut d, n)?
            if let Some(child) = value {
                open_typed(s, depth + 1, b'[', mut d)?
                let pair = string.byte_len(d.path)
                index_path(mut d, 0)?
                skip(s, mut d.pos)
                source_mark(mut d, list.len(out), true)?
                read_shape(plan, item, s, depth + 2, mut d, mut out)?
                string.truncate(mut d.path, pair)
                close_typed(s, b',', mut d)?
                index_path(mut d, 1)?
                read_shape(plan, child, s, depth + 2, mut d, mut out)?
                string.truncate(mut d.path, pair)
                close_typed(s, b']', mut d)?
            } else {
                read_shape(plan, item, s, depth + 1, mut d, mut out)?
            }
            string.truncate(mut d.path, path)
            n += 1
            if after_typed(s, b']', mut d)? {
                break
            }
        }
    }
    patch_typed_count(mut out, start, n)
}

fn string_map(plan: JsonPlan, key: u64) -> bool {
    plan.profile == Interop && match plan.shapes[key] {
        Atom(13) => true,
        _ => false,
    }
}

fn read_string_map(plan: JsonPlan, value: u64, s: String, depth: u64, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    open_typed(s, depth, b'{', mut d)?
    let start = list.len(out)
    codec.put_u32(0, mut out)
    let mut seen: Map[String, ()] = map.new()
    let path = string.byte_len(d.path)
    if !ends(s, mut d.pos, b'}') {
        loop {
            skip(s, mut d.pos)
            let pos = d.pos
            let name = typed_name(s, mut d)?
            field_path(mut d, name)?
            if let Some(_) = map.get(seen, name) {
                return input_error(mut d, pos, DuplicateMember)
            }
            codec.put_string(name, mut out) ?=> |_| LengthOverflow
            map.insert(mut seen, take name, ())
            read_shape(plan, value, s, depth + 1, mut d, mut out)?
            string.truncate(mut d.path, path)
            if after_typed(s, b'}', mut d)? {
                break
            }
        }
    }
    patch_typed_count(mut out, start, map.len(seen))
}

fn single_member_end(s: String, name: String, mut d: ReadTyped) -> Result[(), TypedError] {
    if after_typed(s, b'}', mut d)? {
        return Ok(())
    }
    skip(s, mut d.pos)
    let start = d.pos
    let extra = typed_name(s, mut d)?
    field_path(mut d, extra)?
    if extra == name {
        input_error(mut d, start, DuplicateMember)
    } else {
        input_error(mut d, start, UnknownMember)
    }
}

fn read_outcome(plan: JsonPlan, ok: u64, err: u64, s: String, depth: u64, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    open_typed(s, depth, b'{', mut d)?
    skip(s, mut d.pos)
    let start = d.pos
    let name = typed_name(s, mut d)?
    let path = string.byte_len(d.path)
    field_path(mut d, name)?
    if name == "ok" {
        codec.put_tag(0, mut out)
        read_shape(plan, ok, s, depth + 1, mut d, mut out)?
    } else if name == "error" {
        codec.put_tag(1, mut out)
        read_shape(plan, err, s, depth + 1, mut d, mut out)?
    } else {
        return input_error(mut d, start, UnknownMember)
    }
    string.truncate(mut d.path, path)
    single_member_end(s, name, mut d)
}

type RecordPart {
    start: u64,
    end: u64,
    marks: u64,
    mark_end: u64
}

fn field_index(fields: List[Field], name: String) -> Option[u64] {
    for i in 0u64 .. list.len(fields) {
        if fields[i].name == name {
            return Some(i)
        }
    }
    None
}

// Visit in input order for diagnostics. Only a record stages field runs and
// moves them into declaration order, keeping source marks with their runs.
fn read_record(plan: JsonPlan, definition: u64, fields: List[Field], s: String, depth: u64, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    open_typed(s, depth, b'{', mut d)?
    let count = list.len(fields)
    let mut parts: List[Option[RecordPart]] = list.with_capacity(count)
    for _ in 0u64 .. count {
        shape_push(mut parts, None)?
    }
    let mut staged: Bytes = list.new()
    let mut ignored: Map[String, ()] = map.new()
    let path = string.byte_len(d.path)
    if !ends(s, mut d.pos, b'}') {
        loop {
            skip(s, mut d.pos)
            let member_at = d.pos
            let name = typed_name(s, mut d)?
            field_path(mut d, name)?
            let Some(i) = field_index(fields, name) else {
                if plan.profile == Strict {
                    return input_error(mut d, member_at, UnknownMember)
                }
                remember_member(mut ignored, take name, member_at, mut d)?
                skip_typed(s, depth + 1, mut d)?
                string.truncate(mut d.path, path)
                if after_typed(s, b'}', mut d)? {
                    break
                }
                continue
            }
            if let Some(_) = parts[i] {
                return input_error(mut d, member_at, DuplicateMember)
            }
            let start = list.len(staged)
            let marks = list.len(d.marks)
            read_shape(plan, fields[i].shape, s, depth + 1, mut d, mut staged)?
            let end = list.len(staged)
            let mark_end = list.len(d.marks)
            parts[i] = Some(RecordPart(start, end, marks, mark_end))
            string.truncate(mut d.path, path)
            if after_typed(s, b'}', mut d)? {
                break
            }
        }
    }
    for i in 0u64 .. count {
        if let Some(part) = parts[i] {
            let dest = list.len(out)
            list.append(mut out, list.slice(staged, part.start, part.end))
            for mark in part.marks .. part.mark_end {
                d.marks[mark].pos = dest + (d.marks[mark].pos - part.start)
            }
        } else if let Some(value) = codec.schema_default(plan.description, definition, fields[i].name) {
            list.append(mut out, value)
        } else if let Optional(_) = plan.shapes[plan.facts[fields[i].shape].form] {
            if fields[i].shape != plan.facts[fields[i].shape].form {
                field_path(mut d, fields[i].name)?
                source_mark(mut d, list.len(out), false)?
                string.truncate(mut d.path, path)
            }
            codec.put_tag(0, mut out)
        } else {
            field_path(mut d, fields[i].name)?
            let close = d.pos - 1
            return input_error(mut d, close, MissingMember)
        }
    }
    Ok(())
}

fn read_sum(plan: JsonPlan, variants: List[Variant], s: String, depth: u64, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    let wrapped = at(s, d.pos) == b'{'
    if wrapped {
        open_typed(s, depth, b'{', mut d)?
        skip(s, mut d.pos)
    }
    let start = d.pos
    let name = if wrapped {
        typed_name(s, mut d)?
    } else {
        typed_string(s, mut d)?
    }
    let path = string.byte_len(d.path)
    field_path(mut d, name)?
    for tag in 0u64 .. list.len(variants) {
        let v = variants[tag]
        if v.live && v.name == name {
            let fields = v.fields
            let n = list.len(fields)
            if wrapped != (n != 0) {
                return input_error(mut d, start, ExpectedValue)
            }
            put_typed_count(tag, mut out)?
            if n == 1 {
                read_shape(plan, fields[0], s, depth + 1, mut d, mut out)?
            } else if n > 1 {
                open_typed(s, depth + 1, b'[', mut d)?
                let variant = string.byte_len(d.path)
                for i in 0u64 .. n {
                    if i != 0 {
                        close_typed(s, b',', mut d)?
                    }
                    index_path(mut d, i)?
                    read_shape(plan, fields[i], s, depth + 2, mut d, mut out)?
                    string.truncate(mut d.path, variant)
                }
                close_typed(s, b']', mut d)?
            }
            string.truncate(mut d.path, path)
            if wrapped {
                single_member_end(s, name, mut d)?
            }
            return Ok(())
        }
    }
    input_error(mut d, start, UnknownMember)
}

fn read_atom(profile: Profile, op: u8, s: String, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    let start = d.pos
    match op {
        0 => {
            let parsed = literal(s, mut d.pos, "null")
            read_error(take parsed, mut d)
        },
        1 => {
            let yes = at(s, start) == b't'
            let parsed = literal(s, mut d.pos, if yes {
                "true"
            } else {
                "false"
            })
            read_error(take parsed, mut d)?
            codec.put_bool(yes, mut out)
            Ok(())
        },
        2 => {
            let text = typed_string(s, mut d)?
            let Some((scalar, end)) = string.next_scalar(text, 0) else {
                return input_error(mut d, start, ExpectedValue)
            }
            if end != string.byte_len(text) {
                return input_error(mut d, start, ExpectedValue)
            }
            codec.put_char(scalar, mut out)
            Ok(())
        },
        11 => read_float(profile, op, s, mut d, mut out),
        12 => read_float(profile, op, s, mut d, mut out),
        13 => {
            let text = typed_string(s, mut d)?
            codec.put_string(text, mut out) ?=> |_| LengthOverflow
            Ok(())
        },
        20 => input_error(mut d, start, ExpectedValue),
        _ => read_integer(profile, op, s, mut d, mut out),
    }
}

fn bare_number(s: String, mut d: ReadTyped) -> Result[u64, TypedError] {
    let start = d.pos
    let first = at(s, start)
    if first != b'-' && !int.is_ascii_digit(first) {
        return input_error(mut d, start, ExpectedValue)
    }
    d.pos = number_end(s, start)
    Ok(d.pos)
}

fn canonical_decimal(s: String) -> bool {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if n == 0 {
        return false
    }
    let start: u64 = if b[0] == b'-' {
        1
    } else {
        0
    }
    start < n && (b[start] != b'0' || n == 1)
}

fn read_integer(profile: Profile, op: u8, s: String, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    let start = d.pos
    if profile == Strict && (op == 6 || op == 10) {
        let spelling = typed_string(s, mut d)?
        return put_integer(op, spelling, start, mut d, mut out)
    }
    let end = bare_number(s, mut d)?
    put_integer(op, string.slice(s, start, end), start, mut d, mut out)
}

fn put_integer(op: u8, spelling: String, start: u64, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    if !canonical_decimal(spelling) {
        return input_error(mut d, start, InvalidNumber)
    }
    match op {
        3 => {
            let n = read_integer_value((int.parse(spelling) : Result[u8, ParseError]), start, mut d)?
            codec.put_u8(n, mut out)
            Ok(())
        },
        4 => {
            let n = read_integer_value((int.parse(spelling) : Result[u16, ParseError]), start, mut d)?
            codec.put_u16(n, mut out)
            Ok(())
        },
        5 => {
            let n = read_integer_value((int.parse(spelling) : Result[u32, ParseError]), start, mut d)?
            codec.put_u32(n, mut out)
            Ok(())
        },
        6 => {
            let n = read_integer_value((int.parse(spelling) : Result[u64, ParseError]), start, mut d)?
            codec.put_u64(n, mut out)
            Ok(())
        },
        7 => {
            let n = read_integer_value((int.parse(spelling) : Result[i8, ParseError]), start, mut d)?
            codec.put_i8(n, mut out)
            Ok(())
        },
        8 => {
            let n = read_integer_value((int.parse(spelling) : Result[i16, ParseError]), start, mut d)?
            codec.put_i16(n, mut out)
            Ok(())
        },
        9 => {
            let n = read_integer_value((int.parse(spelling) : Result[i32, ParseError]), start, mut d)?
            codec.put_i32(n, mut out)
            Ok(())
        },
        _ => {
            let n = read_integer_value((int.parse(spelling) : Result[i64, ParseError]), start, mut d)?
            codec.put_i64(n, mut out)
            Ok(())
        },
    }
}

fn read_integer_value[T](take parsed: Result[T, ParseError], start: u64, mut d: ReadTyped) -> Result[T, TypedError] {
    match take parsed {
        Ok(take n) => Ok(take n),
        Error(_) => input_error(mut d, start, InvalidNumber),
    }
}

fn read_float(profile: Profile, op: u8, s: String, mut d: ReadTyped, mut out: Bytes) -> Result[(), TypedError] {
    let start = d.pos
    if profile == Strict && at(s, start) == b'"' {
        let word = typed_string(s, mut d)?
        let bits: u64 = if word == "NaN" {
            0x7ff8000000000000
        } else if word == "Infinity" {
            0x7ff0000000000000
        } else if word == "-Infinity" {
            0xfff0000000000000
        } else {
            return input_error(mut d, start, InvalidNumber)
        }
        if op == 11 {
            let negative: u32 = int.truncate((bits >> 32) & 0x80000000)
            let nan: u32 = if bits == 0x7ff8000000000000 {
                0x400000
            } else {
                0
            }
            codec.put_f32(float.from_bits32(negative | 0x7f800000 | nan), mut out)
            return Ok(())
        }
        codec.put_f64(float.from_bits64(bits), mut out)
        return Ok(())
    }
    if op == 12 {
        let first = at(s, start)
        if first != b'-' && !int.is_ascii_digit(first) {
            return input_error(mut d, start, ExpectedValue)
        }
        let parsed = read_number(s, mut d.pos)
        let value = read_error(take parsed, mut d)?
        codec.put_f64(value, mut out)
        return Ok(())
    }
    let end = bare_number(s, mut d)?
    match float.parse32(string.slice(s, start, end)) {
        Ok(v) => {
            codec.put_f32(v, mut out)
            Ok(())
        },
        Error(Invalid(i)) => input_error(mut d, start + i, ExpectedValue),
        Error(_) => input_error(mut d, start, InvalidNumber),
    }
}

pub type TypedWriteError = DepthLimit | Binary(codec.DecodeError) | LengthOverflow | NonFinite

type WritePass: key = Measure | CheckAndWrite | WriteMeasured

scoped type TypedWriter {
    byte: scoped fn(u8),
    pass: WritePass
}

fn ignore_output_byte(_byte: u8) {}

/// Measures the canonical JSON of a value already encoded by format's codec.
/// No bytes are written and the transcoder allocates nothing.
pub fn typed_length[T](format: Format[T], binary: Bytes) -> Result[u64, TypedWriteError] {
    let w = TypedWriter(byte: ignore_output_byte, pass: Measure)
    write_profile(format.plan, binary, w)
}

/// Streams a codec value to send, one byte at a time, and returns its length.
/// Run typed_length first to check depth and obtain the length before writing.
pub fn write_typed[T](format: Format[T], binary: Bytes, send: scoped fn(u8)) -> Result[u64, TypedWriteError] {
    stream_typed(format, binary, send, CheckAndWrite)
}

fn stream_typed[T](format: Format[T], binary: Bytes, send: scoped fn(u8), pass: WritePass) -> Result[u64, TypedWriteError] {
    let w = TypedWriter(byte: scoped fn(x: u8) {
        send(x)
    }, pass)
    write_profile(format.plan, binary, w)
}

/// Encodes value into caller-owned scratch, measures it, then streams it. A
/// caller can reserve scratch ahead of time and reuse it across calls. The
/// length pass runs before start or send. No JSON buffer is allocated.
pub fn encode_typed[T](format: Format[T], value: T, mut scratch: Bytes, start: scoped fn(u64), send: scoped fn(u8)) -> Result[u64, TypedWriteError] {
    let length = measure_typed(format, value, mut scratch)?
    start(length)
    stream_typed(format, scratch, send, WriteMeasured)
}

/// Writes one typed JSON value to a new String.
pub fn to_string[T](format: Format[T], value: T) -> Result[String, TypedWriteError] {
    let mut out: Bytes = list.new()
    let mut scratch: Bytes = list.new()
    let _ = push_typed(format, value, mut out, mut scratch)?
    match string.from_utf8(take out) {
        Ok(take text) => Ok(take text),
        Error(_) => fail("typed JSON output is UTF-8"),
    }
}

/// Appends one typed JSON value and returns its byte length. Measures and
/// reserves the entire append before changing the contents of out.
pub fn push_typed[T](format: Format[T], value: T, mut out: Bytes, mut scratch: Bytes) -> Result[u64, TypedWriteError] {
    let length = measure_typed(format, value, mut scratch)?
    if let None = int.checked_add(list.len(out), length) {
        return Error(LengthOverflow)
    }
    list.reserve(mut out, length)
    stream_typed(format, scratch, scoped fn(byte: u8) {
        list.push(mut out, byte)
    }, WriteMeasured)
}

fn measure_typed[T](format: Format[T], value: T, mut scratch: Bytes) -> Result[u64, TypedWriteError] {
    list.clear(mut scratch)
    codec.encode(format.binary, value, mut scratch) ?=> |_| LengthOverflow
    typed_length(format, scratch)
}

fn binary_read[T](take r: Result[T, codec.DecodeError]) -> Result[T, TypedWriteError] {
    match take r {
        Ok(take value) => Ok(take value),
        Error(e) => Error(Binary(e)),
    }
}

fn output_count(mut length: u64, add: u64) -> Result[(), TypedWriteError] {
    let Some(n) = int.checked_add(length, add) else {
        return Error(LengthOverflow)
    }
    length = n
    Ok(())
}

fn output_byte(w: TypedWriter, mut length: u64, b: u8) -> Result[(), TypedWriteError] {
    output_count(mut length, 1)?
    if w.pass != Measure {
        (w.byte)(b)
    }
    Ok(())
}

fn output_literal(w: TypedWriter, mut length: u64, s: String) -> Result[(), TypedWriteError] {
    let b = string.as_bytes(s)
    output_count(mut length, list.len(b))?
    if w.pass != Measure {
        for x in b {
            (w.byte)(x)
        }
    }
    Ok(())
}

fn emit_open(w: TypedWriter, mut length: u64, mut depth: u64, b: u8) -> Result[(), TypedWriteError] {
    if depth == TYPED_DEPTH {
        return Error(DepthLimit)
    }
    depth += 1
    output_byte(w, mut length, b)
}

fn emit_close(w: TypedWriter, mut length: u64, mut depth: u64, b: u8) -> Result[(), TypedWriteError] {
    depth -= 1
    output_byte(w, mut length, b)
}

const FRAME_ARRAY: u64 = 0

const FRAME_MAP: u64 = 1

const FRAME_RECORD: u64 = 2

const FRAME_OBJECT: u64 = 3

const FRAME_VARIANT: u64 = 4

const FRAME_STRING_MAP: u64 = 5

// Frame word 0 holds a shape node and a kind. A resident Shape takes more
// than eight bytes, so its node fits above the three kind bits. Word 1 holds
// the progress within that shape. A multi-field variant packs its u32 tag
// above its u32 field node. A map uses three states per pair. Records use
// the low bit to track whether any member has been written.
fn emit_frame(mut frames: Inline[(u64, u64), 64], mut top: u64, node: u64, kind: u64, state: u64) {
    frames[top] = ((node << 3) | kind, state)
    top += 1
}

fn write_profile(plan: JsonPlan, binary: Bytes, w: TypedWriter) -> Result[u64, TypedWriteError] {
    let mut frames: Inline[(u64, u64), 64] =[(0, 0); 64]
    let mut top: u64 = 0
    let mut depth: u64 = 0
    let mut pos: u64 = 0
    let mut length: u64 = 0
    let mut pending = Some(plan.root)
    loop {
        if let Some(node) = pending {
            pending = None
            let id = plan.facts[node].form
            match plan.shapes[id] {
                Atom(op) => write_atom(plan.profile, op, binary, mut pos, w, mut length)?,
                Optional(item) => if binary_read(codec.take_tag(binary, mut pos, 2))? == 0 {
                    output_literal(w, mut length, "null")?
                } else {
                    pending = Some(item)
                },
                Array(item) => {
                    let n: u64 = int.widen(binary_read(codec.take_u32(binary, mut pos))?)
                    if let Atom(3) = plan.shapes[item] {
                        binary_read(codec.need(binary, pos, n))?
                        write_base64(w, mut length, list.slice(binary, pos, pos + n))?
                        pos += n
                    } else {
                        emit_open(w, mut length, mut depth, b'[')?
                        if n == 0 {
                            emit_close(w, mut length, mut depth, b']')?
                        } else {
                            emit_frame(mut frames, mut top, id, FRAME_ARRAY, n - 1)
                            pending = Some(item)
                        }
                    }
                },
                Pairs(key, _) => {
                    let n: u64 = int.widen(binary_read(codec.take_u32(binary, mut pos))?)
                    if plan.profile == Interop {
                        if let Atom(13) = plan.shapes[key] {
                            emit_open(w, mut length, mut depth, b'{')?
                            emit_frame(mut frames, mut top, id, FRAME_STRING_MAP, n << 1)
                            continue
                        }
                    }
                    emit_open(w, mut length, mut depth, b'[')?
                    emit_frame(mut frames, mut top, id, FRAME_MAP, n * 3)
                },
                Outcome(ok, err) => {
                    let tag = binary_read(codec.take_tag(binary, mut pos, 2))?
                    emit_open(w, mut length, mut depth, b'{')?
                    output_literal(w, mut length, if tag == 0 {
                        "\"ok\":"
                    } else {
                        "\"error\":"
                    })?
                    emit_frame(mut frames, mut top, id, FRAME_OBJECT, 0)
                    pending = Some(if tag == 0 {
                        ok
                    } else {
                        err
                    })
                },
                Record(_) => {
                    emit_open(w, mut length, mut depth, b'{')?
                    emit_frame(mut frames, mut top, id, FRAME_RECORD, 0)
                },
                Sum(variants) => {
                    let start = pos
                    let tag: u64 = int.widen(binary_read(codec.take_tag(binary, mut pos, int.narrow(list.len(variants))))?)
                    let variant = variants[tag]
                    if !variant.live {
                        return Error(Binary(Invalid(start)))
                    }
                    let count = list.len(variant.fields)
                    if count == 0 {
                        write_quoted(w, mut length, string.as_bytes(variant.name))?
                    } else {
                        emit_open(w, mut length, mut depth, b'{')?
                        write_key(w, mut length, variant.name)?
                        if count == 1 {
                            emit_frame(mut frames, mut top, id, FRAME_OBJECT, 0)
                            pending = Some(variant.fields[0])
                        } else {
                            emit_open(w, mut length, mut depth, b'[')?
                            emit_frame(mut frames, mut top, id, FRAME_VARIANT, tag << 32)
                        }
                    }
                },
                Via(_) => fail("prepared JSON form has no via layer"),
            }
            continue
        }
        if top == 0 {
            break
        }
        let (code, state) = frames[top - 1]
        let id = code >> 3
        match code & 7 {
            3 => {
                emit_close(w, mut length, mut depth, b'}')?
                top -= 1
            },
            0 => if state == 0 {
                emit_close(w, mut length, mut depth, b']')?
                top -= 1
            } else {
                let Array(item) = plan.shapes[id] else {
                    fail("array frame has an array shape")
                }
                output_byte(w, mut length, b',')?
                frames[top - 1] = (code, state - 1)
                pending = Some(item)
            },
            1 => if state == 0 {
                emit_close(w, mut length, mut depth, b']')?
                top -= 1
            } else {
                let Pairs(key, value) = plan.shapes[id] else {
                    fail("map frame has a map shape")
                }
                frames[top - 1] = (code, state - 1)
                match state % 3 {
                    0 => {
                        emit_open(w, mut length, mut depth, b'[')?
                        pending = Some(key)
                    },
                    2 => {
                        output_byte(w, mut length, b',')?
                        pending = Some(value)
                    },
                    _ => {
                        emit_close(w, mut length, mut depth, b']')?
                        if state > 1 {
                            output_byte(w, mut length, b',')?
                        }
                    },
                }
            },
            2 => {
                let Record(fields) = plan.shapes[id] else {
                    fail("record frame has a record shape")
                }
                let field = state >> 1
                if field == list.len(fields) {
                    emit_close(w, mut length, mut depth, b'}')?
                    top -= 1
                } else {
                    let mut shape = fields[field].shape
                    if plan.profile == Interop {
                        if let Optional(child) = plan.shapes[plan.facts[shape].form] {
                            if binary_read(codec.take_tag(binary, mut pos, 2))? == 0 {
                                frames[top - 1] = (code, state + 2)
                                continue
                            }
                            shape = child
                        }
                    }
                    if state & 1 != 0 {
                        output_byte(w, mut length, b',')?
                    }
                    write_key(w, mut length, fields[field].name)?
                    frames[top - 1] = (code, (state + 2) | 1)
                    pending = Some(shape)
                }
            },
            5 => {
                let remaining = state >> 1
                if remaining == 0 {
                    emit_close(w, mut length, mut depth, b'}')?
                    top -= 1
                } else {
                    let Pairs(_, value) = plan.shapes[id] else {
                        fail("string map frame has a map shape")
                    }
                    if state & 1 != 0 {
                        output_byte(w, mut length, b',')?
                    }
                    write_atom(plan.profile, 13, binary, mut pos, w, mut length)?
                    output_byte(w, mut length, b':')?
                    frames[top - 1] = (code, (state - 2) | 1)
                    pending = Some(value)
                }
            },
            _ => {
                let Sum(variants) = plan.shapes[id] else {
                    fail("variant frame has a sum shape")
                }
                let fields = variants[state >> 32].fields
                let item = state & 0xffffffff
                if item == list.len(fields) {
                    emit_close(w, mut length, mut depth, b']')?
                    emit_close(w, mut length, mut depth, b'}')?
                    top -= 1
                } else {
                    if item > 0 {
                        output_byte(w, mut length, b',')?
                    }
                    frames[top - 1] = (code, state + 1)
                    pending = Some(fields[item])
                }
            },
        }
    }
    if pos != list.len(binary) {
        return Error(Binary(Trailing(pos)))
    }
    Ok(length)
}

fn write_key(w: TypedWriter, mut length: u64, key: String) -> Result[(), TypedWriteError] {
    write_quoted(w, mut length, string.as_bytes(key))?
    output_byte(w, mut length, b':')
}

fn write_quoted(w: TypedWriter, mut length: u64, b: Bytes) -> Result[(), TypedWriteError] {
    output_byte(w, mut length, b'"')?
    for x in b {
        write_string_byte(w, mut length, x)?
    }
    output_byte(w, mut length, b'"')
}

fn write_string_byte(w: TypedWriter, mut length: u64, b: u8) -> Result[(), TypedWriteError] {
    if b < 32 {
        let hex = string.as_bytes("0123456789ABCDEF")
        output_literal(w, mut length, "\\u00")?
        output_byte(w, mut length, hex[int.widen(b >> 4)])?
        output_byte(w, mut length, hex[int.widen(b & 15)])
    } else {
        if b == b'"' || b == b'\\' {
            output_byte(w, mut length, b'\\')?
        }
        output_byte(w, mut length, b)
    }
}

fn write_char(w: TypedWriter, mut length: u64, c: char) -> Result[(), TypedWriteError] {
    output_byte(w, mut length, b'"')?
    let cp = char.to_u32(c)
    if cp < 0x80 {
        write_string_byte(w, mut length, int.narrow(cp))?
    } else {
        if cp < 0x800 {
            output_byte(w, mut length, int.narrow(0xc0 | (cp >> 6)))?
        } else {
            if cp < 0x10000 {
                output_byte(w, mut length, int.narrow(0xe0 | (cp >> 12)))?
            } else {
                output_byte(w, mut length, int.narrow(0xf0 | (cp >> 18)))?
                output_byte(w, mut length, int.narrow(0x80 | ((cp >> 12) & 63)))?
            }
            output_byte(w, mut length, int.narrow(0x80 | ((cp >> 6) & 63)))?
        }
        output_byte(w, mut length, int.narrow(0x80 | (cp & 63)))?
    }
    output_byte(w, mut length, b'"')
}

fn write_base64(w: TypedWriter, mut length: u64, b: Bytes) -> Result[(), TypedWriteError] {
    let n = list.len(b)
    if w.pass == Measure {
        // A codec Bytes value has a u32 count.
        return output_count(mut length, ((n + 2) / 3) * 4 + 2)
    }
    output_byte(w, mut length, b'"')?
    let alphabet = string.as_bytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    let mut i: u64 = 0
    while i < n {
        let a: u64 = int.widen(b[i])
        let more = n - i
        let mid: u64 = if more >= 2 {
            int.widen(b[i + 1])
        } else {
            0
        }
        let low: u64 = if more >= 3 {
            int.widen(b[i + 2])
        } else {
            0
        }
        output_byte(w, mut length, alphabet[a >> 2])?
        output_byte(w, mut length, alphabet[((a & 3) << 4) | (mid >> 4)])?
        output_byte(w, mut length, if more >= 2 {
            alphabet[((mid & 15) << 2) | (low >> 6)]
        } else {
            b'='
        })?
        output_byte(w, mut length, if more >= 3 {
            alphabet[low & 63]
        } else {
            b'='
        })?
        i += 3
    }
    output_byte(w, mut length, b'"')
}

fn write_atom(profile: Profile, op: u8, binary: Bytes, mut pos: u64, w: TypedWriter, mut length: u64) -> Result[(), TypedWriteError] {
    match op {
        0 => output_literal(w, mut length, "null"),
        1 => if binary_read(codec.take_bool(binary, mut pos))? {
            output_literal(w, mut length, "true")
        } else {
            output_literal(w, mut length, "false")
        },
        2 => write_char(w, mut length, binary_read(codec.take_char(binary, mut pos))?),
        3 => write_unsigned(w, mut length, int.widen(binary_read(codec.take_u8(binary, mut pos))?)),
        4 => write_unsigned(w, mut length, int.widen(binary_read(codec.take_u16(binary, mut pos))?)),
        5 => write_unsigned(w, mut length, int.widen(binary_read(codec.take_u32(binary, mut pos))?)),
        6 => {
            let value = binary_read(codec.take_u64(binary, mut pos))?
            if profile == Interop {
                write_unsigned(w, mut length, value)
            } else {
                output_byte(w, mut length, b'"')?
                write_unsigned(w, mut length, value)?
                output_byte(w, mut length, b'"')
            }
        },
        7 => write_signed(w, mut length, int.widen(binary_read(codec.take_i8(binary, mut pos))?)),
        8 => write_signed(w, mut length, int.widen(binary_read(codec.take_i16(binary, mut pos))?)),
        9 => write_signed(w, mut length, int.widen(binary_read(codec.take_i32(binary, mut pos))?)),
        10 => {
            let value = binary_read(codec.take_i64(binary, mut pos))?
            if profile == Interop {
                write_signed(w, mut length, value)
            } else {
                output_byte(w, mut length, b'"')?
                write_signed(w, mut length, value)?
                output_byte(w, mut length, b'"')
            }
        },
        11 => {
            let v = binary_read(codec.take_f32(binary, mut pos))?
            let widened = float.widen(v)
            if float.is_finite(widened) {
                let (coefficient, exponent) = float.shortest32(v)
                write_decimal(w, mut length, float.to_bits32(v) >> 31 != 0, coefficient, exponent)
            } else {
                write_nonfinite(profile, w, mut length, widened)
            }
        },
        12 => {
            let v = binary_read(codec.take_f64(binary, mut pos))?
            if float.is_finite(v) {
                let (coefficient, exponent) = float.shortest64(v)
                write_decimal(w, mut length, float.to_bits64(v) >> 63 != 0, coefficient, exponent)
            } else {
                write_nonfinite(profile, w, mut length, v)
            }
        },
        20 => Error(Binary(Invalid(pos))),
        _ => {
            let n: u64 = int.widen(binary_read(codec.take_u32(binary, mut pos))?)
            binary_read(codec.need(binary, pos, n))?
            let text = list.slice(binary, pos, pos + n)
            if w.pass != WriteMeasured {
                if let Error(e) = utf8.validate(text) {
                    return Error(Binary(Utf8(pos + e.valid_up_to)))
                }
            }
            write_quoted(w, mut length, text)?
            pos += n
            Ok(())
        },
    }
}

fn write_unsigned(w: TypedWriter, mut length: u64, n: u64) -> Result[(), TypedWriteError] {
    let mut digits: Inline[u8, 64] =[0; 64]
    let first = int.radix_digits(n, 10, mut digits)
    for i in first .. 64u64 {
        output_byte(w, mut length, digits[i])?
    }
    Ok(())
}

fn write_signed(w: TypedWriter, mut length: u64, n: i64) -> Result[(), TypedWriteError] {
    if n < 0 {
        output_byte(w, mut length, b'-')?
        let m: u64 = int.narrow(-(n + 1))
        write_unsigned(w, mut length, m + 1)
    } else {
        write_unsigned(w, mut length, int.narrow(n))
    }
}

fn write_nonfinite(profile: Profile, w: TypedWriter, mut length: u64, v: f64) -> Result[(), TypedWriteError] {
    if profile == Interop {
        return Error(NonFinite)
    }
    let bits = float.to_bits64(v)
    output_literal(w, mut length, if bits & 0xfffffffffffff != 0 {
        "\"NaN\""
    } else if bits >> 63 != 0 {
        "\"-Infinity\""
    } else {
        "\"Infinity\""
    })
}

// ECMA-262 Number::toString's decimal layout, with the source width's
// shortest digits. Keep the sign bit when the coefficient is zero.
fn write_decimal(w: TypedWriter, mut length: u64, negative: bool, coefficient: u64, exponent: i64) -> Result[(), TypedWriteError] {
    if negative {
        output_byte(w, mut length, b'-')?
    }
    let mut digits: Inline[u8, 64] =[0; 64]
    let first = int.radix_digits(coefficient, 10, mut digits)
    let width: i64 = int.narrow(64 - first)
    let point = width + exponent
    if point > 0 && point <= 21 {
        let slot: u64 = int.narrow(point)
        for i in 0u64 .. slot {
            if first + i < 64 {
                output_byte(w, mut length, digits[first + i])?
            } else {
                output_byte(w, mut length, b'0')?
            }
        }
        if point < width {
            output_byte(w, mut length, b'.')?
            for i in first + slot .. 64u64 {
                output_byte(w, mut length, digits[i])?
            }
        }
        return Ok(())
    }
    if point <= 0 && point > -6 {
        output_literal(w, mut length, "0.")?
        let zeros: u64 = int.narrow(-point)
        for _ in 0u64 .. zeros {
            output_byte(w, mut length, b'0')?
        }
        for i in first .. 64u64 {
            output_byte(w, mut length, digits[i])?
        }
        return Ok(())
    }
    output_byte(w, mut length, digits[first])?
    if width > 1 {
        output_byte(w, mut length, b'.')?
        for i in first + 1 .. 64u64 {
            output_byte(w, mut length, digits[i])?
        }
    }
    output_byte(w, mut length, b'e')?
    let e = point - 1
    if e >= 0 {
        output_byte(w, mut length, b'+')?
    }
    write_signed(w, mut length, e)
}

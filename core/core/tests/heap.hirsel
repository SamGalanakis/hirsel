// Min-heap laws use the hand-sorted model [1, 1, 2, 3, 4, 5, 9].
// Swapping the comparison or choosing the larger child changes this oracle.
// expect: run priority_order() = 1123459
fn priority_order() -> u64 {
    let mut h: Heap[u64] = heap.new()
    result.unwrap(heap.push(mut h, 5))
    result.unwrap(heap.push(mut h, 1))
    result.unwrap(heap.push(mut h, 9))
    result.unwrap(heap.push(mut h, 3))
    result.unwrap(heap.push(mut h, 1))
    result.unwrap(heap.push(mut h, 4))
    result.unwrap(heap.push(mut h, 2))
    let mut digits: u64 = 0
    while heap.len(h) > 0 { digits = digits * 10 + option.unwrap(heap.pop(mut h)) }
    digits
}

// expect: run empty_pop() = true
fn empty_pop() -> bool {
    let mut h: Heap[u64] = heap.new()
    match heap.pop(mut h) { None => true, _ => false }
}

// expect: run singleton_peek_pop() = 77
fn singleton_peek_pop() -> u64 {
    let mut h: Heap[u64] = heap.new()
    result.unwrap(heap.push(mut h, 7))
    let p: u64 = match heap.peek(h) { Some(v) => v, None => 99 }
    p * 10 + option.unwrap(heap.pop(mut h))
}

// Capacity returns an owned String, and the heap remains empty.
// expect: run capacity_returns_owner() = 3
fn capacity_returns_owner() -> u64 {
    let mut h: Heap[String] = heap.new()
    let x = result.unwrap(string.from("abc"))
    let r = bound bytes 0 { heap.push(mut h, take x) }
    match r {
        Ok(Error((_, take original))) => if original == "abc" { list.len(string.as_bytes(original)) + heap.len(h) } else { 99 },
        _ => 99,
    }
}

// expect: run interleaved() = 123
fn interleaved() -> u64 {
    let mut h: Heap[u64] = heap.new()
    result.unwrap(heap.push(mut h, 3))
    result.unwrap(heap.push(mut h, 1))
    let a = option.unwrap(heap.pop(mut h))
    result.unwrap(heap.push(mut h, 2))
    a * 100 + option.unwrap(heap.pop(mut h)) * 10 + option.unwrap(heap.pop(mut h))
}

// Every size0..17 exercises single-child and two-child sift paths, with a
// plain List as the model. The minimum is found by a separate linear scan.
// expect: run list_model() = true
fn list_model() -> bool {
    for n in 0u64 .. 18 {
        let mut h: Heap[u64] = heap.new()
        let mut model: List[u64] = list.new()
        for i in 0u64 .. n {
            let x = (i * 37 + 11) % 17
            result.unwrap(heap.push(mut h, x))
            result.unwrap(list.push(mut model, x))
        }
        while list.len(model) > 0 {
            let mut smallest: u64 = 0
            for i in 1u64 .. list.len(model) { if model[i] < model[smallest] { smallest = i } }
            let expected = model[smallest]
            let last = list.len(model) - 1
            list.swap(mut model, smallest, last)
            let _ = list.pop(mut model)
            if option.unwrap(heap.pop(mut h)) != expected { return false }
        }
        if heap.len(h) != 0 { return false }
        if let Some(_) = heap.pop(mut h) { return false }
    }
    true
}
// Prefix cloning is valid when a sift has closed its hole.
// expect: run clone_prefix() = 112233
fn clone_prefix() -> u64 {
    let mut h: Heap[u64] = heap.new()
    for i in 1u64 .. 4 { result.unwrap(heap.push(mut h, 4 - i)) }
    let mut cloned: Heap[u64] = result.unwrap(clone(h))
    let mut digits: u64 = 0
    while heap.len(h) > 0 {
        digits = digits * 10 + option.unwrap(heap.pop(mut h))
        digits = digits * 10 + option.unwrap(heap.pop(mut cloned))
    }
    digits
}
// expect: run pop_admits_nothing() = true
fn pop_admits_nothing() -> bool {
    let mut h: Heap[String] = heap.new()
    result.unwrap(heap.push(mut h, result.unwrap(string.from("b"))))
    result.unwrap(heap.push(mut h, result.unwrap(string.from("a"))))
    let r = bound bytes 0 { heap.pop(mut h) }
    match r { Ok(Some(take x)) => x == "a" && heap.len(h) == 1, _ => false }
}

// Refused growth must not move the existing minimum or consume the new owner.
// expect: run growth_returns_owner_unchanged() = true
fn growth_returns_owner_unchanged() -> bool {
    let mut h: Heap[String] = heap.new()
    result.unwrap(heap.push(mut h, result.unwrap(string.from("d"))))
    result.unwrap(heap.push(mut h, result.unwrap(string.from("b"))))
    result.unwrap(heap.push(mut h, result.unwrap(string.from("c"))))
    result.unwrap(heap.push(mut h, result.unwrap(string.from("a"))))
    let x = result.unwrap(string.from("e"))
    let r = bound bytes 0 { heap.push(mut h, take x) }
    let returned = match r { Ok(Error((c, take value))) => c.requested == 192 && value == "e", _ => false }
    returned && heap.len(h) == 4 && option.unwrap(heap.pop(mut h)) == "a" && option.unwrap(heap.pop(mut h)) == "b" && option.unwrap(heap.pop(mut h)) == "c" && option.unwrap(heap.pop(mut h)) == "d"
}

// expect: run carrier_bytes() = 24
fn carrier_bytes() -> u64 {
    let r = bound bytes 0 { let n: Result[List[Heap[u64]], Capacity] = list.with_capacity(1); n }
    match r { Ok(Error(c)) => c.requested, _ => 99 }
}

// expect: run rc_share_unwrap() = 123
fn rc_share_unwrap() -> u64 {
    let mut h: Heap[u64] = heap.new()
    for i in 1u64 .. 4 { result.unwrap(heap.push(mut h, 4 - i)) }
    let shared = result.unwrap(rc.new(take h))
    let other = rc.share(shared)
    let _ = take other
    let mut recovered = result.unwrap(rc.try_unwrap(take shared))
    option.unwrap(heap.pop(mut recovered)) * 100 + option.unwrap(heap.pop(mut recovered)) * 10 + option.unwrap(heap.pop(mut recovered))
}

// A24-byte tuple exercises every carried word and lexicographic ordered glue,
// including equal first keys as Graph/Maze priorities use.
// expect: run tuple_priority() = 12132124
fn tuple_priority() -> u64 {
    let mut h: Heap[(u64, u64, u64)] = heap.new()
    result.unwrap(heap.push(mut h, (2, 4, 24)))
    result.unwrap(heap.push(mut h, (1, 3, 13)))
    result.unwrap(heap.push(mut h, (2, 1, 21)))
    result.unwrap(heap.push(mut h, (1, 2, 12)))
    let mut n: u64 = 0
    while let Some(take x) = heap.pop(mut h) {
        if x.0 * 10 + x.1 != x.2 { return 99 }
        n = n * 100 + x.2
    }
    n
}

// A zero-sized heap and its clone admit nothing; clone capacity may be a
// non-power-of-two length, and a subsequent push must still grow correctly.
// expect: run zero_size_clone_grows() = 35
fn zero_size_clone_grows() -> u64 {
    let r = bound bytes 0 {
        let mut h: Heap[()] = heap.new()
        for _ in 0u64 .. 17 { result.unwrap(heap.push(mut h, ())) }
        let mut copied: Heap[()] = result.unwrap(clone(h))
        result.unwrap(heap.push(mut copied, ()))
        let mut n: u64 = 0
        while let Some(_) = heap.pop(mut h) { n += 1 }
        while let Some(_) = heap.pop(mut copied) { n += 1 }
        n
    }
    result.unwrap(r)
}

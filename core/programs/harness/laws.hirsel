// Offline laws for the harness. Each law runs a real place on a Disk backing
// against scripted, test-owned services, so what the services saw survives
// the place. See README.md for the list and each law's oracle.

const BYTES: u64 = 131072u64
const PLACE_BYTES: u64 = 1048576u64
const IDLE_MS: u64 = 300u64

// ---- scripted services ----

type ModelAsk: send = Ask(bool, Sender[harness.Answer]) | Asked(Sender[u64])
type ToolAsk: send = Run(Bytes, Sender[Bytes]) | Ran(Sender[u64])
type Services: send { model: Sender[ModelAsk], tool: Sender[ToolAsk] }
type Grants: send { context: store.runner.TriggerContext, model: Sender[ModelAsk], tool: Sender[ToolAsk] }

fn usage() -> harness.Usage { harness.Usage(input: 10u64, output: 5u64) }

// The script: with no tool result in the request, ask for one `bump` call;
// after a tool result, answer in text.
fn model_service(take inbox: Receiver[ModelAsk]) -> () waits {
    let mut asked = 0u64
    while let Ok(take request) = channel.receive(inbox) {
        match take request {
            Ask(after_tool, reply) => {
                asked += 1u64
                let mut calls: List[harness.Call] = list.new()
                if !after_tool {
                    list.push(mut calls, harness.Call(id: "c1", name: "bump", args: Inline(string.into_bytes("{}"))))
                }
                let text = if after_tool { "done" } else { "" }
                let _ = channel.send(reply, harness.Answer(text: text, calls: take calls, stop: "end", usage: usage()))
            },
            Asked(reply) => { let _ = channel.send(reply, asked) },
        }
    }
}

type ToolSeed: send { inbox: Receiver[ToolAsk], seen: Sender[()] }

// The first call is seen and then held forever: its reply never comes, as
// if the process died while the call was in flight.
fn tool_service(take seed: ToolSeed) -> () waits {
    let ToolSeed(inbox: take inbox, seen: take seen) = take seed
    let mut ran = 0u64
    let mut held: List[Sender[Bytes]] = list.new()
    while let Ok(take request) = channel.receive(inbox) {
        match take request {
            Run(_, take reply) => {
                ran += 1u64
                if ran == 1u64 {
                    list.push(mut held, take reply)
                    let _ = channel.send(seen, ())
                } else {
                    let _ = channel.send(reply, string.into_bytes("1"))
                }
            },
            Ran(reply) => { let _ = channel.send(reply, ran) },
        }
    }
}

fn copy_services(s: Services) -> Services { Services(model: channel.sender(s.model), tool: channel.sender(s.tool)) }

fn make_grants(s: Services, take ctx: store.runner.TriggerContext) -> Result[Grants, Capacity] {
    Ok(Grants(context: take ctx, model: channel.sender(s.model), tool: channel.sender(s.tool)))
}

fn scripted_model(g: Grants, take r: harness.Request) -> Result[harness.Answer, harness.Fault] waits {
    let mut after_tool = false
    for e in r.messages { if let ToolResult(_, _) = e { after_tool = true } }
    let (reply, replied): (Sender[harness.Answer], Receiver[harness.Answer]) = channel.new(1u64)
    if let Error(_) = channel.send(g.model, Ask(after_tool, take reply)) { return Error(Unavailable) }
    match channel.receive(replied) { Ok(take a) => Ok(take a), Error(_) => Error(Unavailable) }
}

fn bump(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    let (reply, replied): (Sender[Bytes], Receiver[Bytes]) = channel.new(1u64)
    if let Error(_) = channel.send(g.tool, Run(take args, take reply)) { return Error(Unavailable) }
    match channel.receive(replied) { Ok(take out) => Ok(take out), Error(_) => Error(Unavailable) }
}

// ---- the agent and its four forwarding entries ----

fn crash_agent() -> harness.Agent[Grants] {
    let mut a = harness.agent("crash", "scripted", code.describe(scripted_model))
    list.push(mut a.tools, harness.outside("bump", "adds one", "{}", Once, code.describe(bump)))
    a
}

fn wired() -> Result[harness.Wiring, harness.Refused] { harness.wiring(code.describe(advance), code.describe(effect)) }

fn advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: harness.Wake) -> Result[(), harness.Refused] {
    let w = wired()?
    harness.advance(mut tx, h, crash_agent(), w, take wake)
}

fn effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    harness.effect(g.context, g, take key, crash_agent(), code.describe(settle))
}

fn settle(mut tx: store.Tx, a: store.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = wired() else { return Error(Missing("harness: wiring")) }
    harness.settle(mut tx, crash_agent(), w, a, take m)
}

fn place(mut r: store.runner.Registry[Grants, harness.Handles]) -> Result[(), store.runner.RegisterError] {
    store.runner.transact(mut r, code.describe(advance), BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.granted(mut r, code.describe(effect), BYTES, store.runner.DEFAULT_STEPS)?
    harness.register(mut r, BYTES, store.runner.DEFAULT_STEPS)?
    let f: own[send] fn(mut store.Tx, store.triggers.Attempt, take harness.Settle) -> Result[harness.Filed, store.Error] = settle
    store.runner.register_attempt(mut r, code.describe(settle), take f, BYTES, store.runner.DEFAULT_STEPS)
}

// ---- running a place ----

type Life: send { config: store.runner.PlaceConfig[Grants, harness.Handles, Services, ()], stop: Receiver[()], status: Latest[store.runner.Status] }

fn live(take life: Life) -> Result[store.runner.Ended, store.runner.StartError] waits {
    let Life(config: take config, stop: take stop, status: take status) = take life
    store.runner.operate(take config, take stop, status, None)
}

fn settings(dir: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, take s: Services, idle: Option[u64]) -> store.runner.PlaceConfig[Grants, harness.Handles, Services, ()] {
    let w = result.unwrap(wired())
    let config = store.runner.TriggerConfig(entries: harness.entries(w), author: store.Caller(issuer: 0u8, subject: list.new()),
        grants: take s, grant: make_grants, grant_bytes: 65536u64)
    let mut wire = store.runner.wire_defaults(65536u64, PLACE_BYTES)
    wire.n_pool = 4194304u64
    store.runner.PlaceConfig(backing: Disk(dir, store.triggers.law_options()), selection: Reopen, place: code.describe(place), n_place: PLACE_BYTES,
        migrate: code.describe(harness.migrate), handles: code.describe(harness.handles), session: wire, max_sessions: 1u64,
        proxies: list.new(), n_publisher: PLACE_BYTES, listen: Addr(ip: V4(0x7f000001u32), port: 0u16),
        net: net, tasks: tasks, clock: clock, random: random, stop: store.runner.Stop(lag_ms: 0u64, grace_ms: 200u64),
        wire: None, triggers: Some(take config), idle: idle)
}

fn launch(tasks: Tasks, take config: store.runner.PlaceConfig[Grants, harness.Handles, Services, ()]) -> (Task[Result[store.runner.Ended, store.runner.StartError]], Sender[()], Latest[store.runner.Status]) {
    let (stop_to, stop_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let status = result.unwrap(store.runner.status_root())
    let life = Life(config: take config, stop: take stop_from, status: latest.handle(status))
    let running = task.spawn(tasks, bytes 50331648u64, take life, live)
    (take running, take stop_to, take status)
}

// One user message, committed before any place runs.
fn seed_session(dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> () waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, store.triggers.law_options()))
    result.unwrap(store.run_migration(mut db, tasks, code.describe(harness.migrate)))
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let w = result.unwrap(wired())
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[harness.Disposition, harness.Refused] {
        harness.open_session(mut tx, h, "scripted", All)?
        harness.submit(mut tx, h, crash_agent(), w, store.Caller(issuer: 1u8, subject: list.new()), harness.Submit(client_key: "k1", text: "bump it"))
    })
    let done = match take ran { Ok(Committed(row)) => row, _ => fail("seed: submit did not commit") }
    result.unwrap(store.durable(mut db, done.ticket))
    result.unwrap(store.close(take db))
}

fn model_asked(s: Services) -> u64 waits {
    let (reply, replied): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    result.unwrap(channel.send(s.model, Asked(take reply)))
    result.unwrap(channel.receive(replied))
}

fn tool_ran(s: Services) -> u64 waits {
    let (reply, replied): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    result.unwrap(channel.send(s.tool, Ran(take reply)))
    result.unwrap(channel.receive(replied))
}

fn is_user(e: Option[harness.Entry]) -> bool { match e { Some(User(_)) => true, _ => false } }
fn asks_tool(e: Option[harness.Entry]) -> bool { match e { Some(Assistant(a)) => list.len(a.calls) == 1u64, _ => false } }
fn doubted(e: Option[harness.Entry]) -> bool { match e { Some(ToolResult(id, InDoubt)) => id == "c1", _ => false } }
// The first request's baseline: no sections, and the one tool offered.
fn offers_bump(e: Option[harness.Entry]) -> bool {
    match e {
        Some(System(p)) => p.baseline && list.len(p.changes) == 0u64 && match p.tools { Some(d) => list.len(d) == 1u64 && d[0].name == "bump", None => false },
        _ => false,
    }
}
fn says_done(e: Option[harness.Entry]) -> bool { match e { Some(Assistant(a)) => list.len(a.calls) == 0u64 && a.text == "done", _ => false } }

// Law C1 (astra crash matrix: Once tool, place ends after begin): the place
// is stopped while a Once tool's only dispatch is in flight and its reply
// never comes. After reopening, the tool is never sent again, its result is
// InDoubt at once (no deadline wait), the answer that asked for it is not
// re-bought, and the run ends Answered. begin's Dispatched row is durable
// before the worker may send, because a fenced call is answered only after
// its commit is durable (RUNNER-SPEC §12.1, runner.trigger_call). This case
// stops the place; a std.sim.fs crash cut at the same boundary is open.
// Oracle: the services' own counts (tool 1, model 2: one per round) and the
// transcript and spend derived by hand from the script.
pub fn law_once_tool_crash(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> bool waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    seed_session(dir, clock, random, tasks)
    let (model, model_in): (Sender[ModelAsk], Receiver[ModelAsk]) = channel.new(4u64)
    let (tool, tool_in): (Sender[ToolAsk], Receiver[ToolAsk]) = channel.new(4u64)
    let (seen, saw): (Sender[()], Receiver[()]) = channel.new(1u64)
    let models = task.spawn(tasks, bytes 65536u64, take model_in, model_service)
    let tools = task.spawn(tasks, bytes 65536u64, ToolSeed(inbox: take tool_in, seen: take seen), tool_service)
    let services = Services(model: take model, tool: take tool)
    let (first, stop_first, _) = launch(tasks, settings(dir, clock, random, tasks, net, copy_services(services), None))
    if let Error(_) = channel.receive(saw) { fail("crash: the tool was never called") }
    result.unwrap(channel.send(stop_first, ()))
    let first_join = task.join(take first)
    let first_ended = match first_join { Ok(Ok(_)) => true, _ => false }
    let (second, _stop_second, _) = launch(tasks, settings(dir, clock, random, tasks, net, copy_services(services), Some(IDLE_MS)))
    let second_join = task.join(take second)
    let second_ended = match second_join { Ok(Ok(Stopped(_))) => true, _ => false }
    let asked = model_asked(services)
    let ran = tool_ran(services)
    let db = result.unwrap(store.open(tasks, dir, clock, random, store.triggers.law_options()))
    let snap = store.snapshot(db)
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let session = option.unwrap(result.unwrap(store.get(snap, store.shape(h.session), 0u64)))
    let run = option.unwrap(result.unwrap(store.get(snap, store.shape(h.runs), 0u64)))
    let finished = match run.phase { Finished(Answered) => true, _ => false }
    let spent = run.spend.known == 30u64 && run.spend.reserved == 0u64 && run.spend.unresolved == 0u64
    let transcript = session.next_pos == 5u64
        && is_user(result.unwrap(store.get(snap, store.shape(h.entries), 0u64)))
        && offers_bump(result.unwrap(store.get(snap, store.shape(h.entries), 1u64)))
        && asks_tool(result.unwrap(store.get(snap, store.shape(h.entries), 2u64)))
        && doubted(result.unwrap(store.get(snap, store.shape(h.entries), 3u64)))
        && says_done(result.unwrap(store.get(snap, store.shape(h.entries), 4u64)))
    let idle = match session.active_run { None => true, Some(_) => false }
    result.unwrap(store.close(take db))
    let Services(model: take m, tool: take t) = take services
    let _ = take m
    let _ = take t
    let _ = task.join(take models)
    let _ = task.join(take tools)
    result.unwrap(std.dir.remove_all(parent, name))
    first_ended && second_ended && asked == 2u64 && ran == 1u64 && finished && spent && transcript && idle
}

@test
fn test_once_tool_crash(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), ()] waits {
    if law_once_tool_crash(parent, clock, random, tasks, net) { Ok(()) } else { Error(()) }
}


// ---- journal bytes ----

// A session with `n` earlier entries, each a 200-byte user line, and no run.
fn history(dir: Dir, clock: Clock, random: Random, tasks: Tasks, n: u64) -> store.Db waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, store.triggers.law_options()))
    result.unwrap(store.run_migration(mut db, tasks, code.describe(harness.migrate)))
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let filled = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), harness.Refused] {
        harness.open_session(mut tx, h, "scripted", All)?
        for p in 0u64..n {
            match store.put(mut tx, h.entries, p, User(string.repeat("x", 200u64))) { Ok(()) => (), Error(_) => return Error(Storage) }
        }
        let mut s = match store.fetch(tx, store.shape(h.session), 0u64) { Ok(Some(take s)) => take s, _ => return Error(Storage) }
        s.next_pos = n
        match store.put(mut tx, h.session, 0u64, s) { Ok(()) => Ok(()), Error(_) => Error(Storage) }
    })
    match take filled { Ok(Committed(_)) => (), _ => fail("history: fill did not commit") }
    take db
}

// The bytes one submit transaction writes: the key and value of every row it
// changed, from the store's own diff of the snapshots around it.
fn round_bytes(dir: Dir, clock: Clock, random: Random, tasks: Tasks, n: u64) -> u64 waits {
    let mut db = history(dir, clock, random, tasks, n)
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let w = result.unwrap(wired())
    let before = store.snapshot(db)
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[harness.Disposition, harness.Refused] {
        harness.submit(mut tx, h, crash_agent(), w, store.Caller(issuer: 1u8, subject: list.new()), harness.Submit(client_key: "k", text: "bump it"))
    })
    match take ran { Ok(Committed(_)) => (), _ => fail("journal: submit did not commit") }
    let after = store.snapshot(db)
    let mut total = 0u64
    for c in result.unwrap(store.changes(before, after)) {
        total += list.len(c.tree_key)
        if let Some(v) = c.value { total += list.len(v) }
    }
    result.unwrap(store.close(take db))
    total
}

// Law J1 (Sam's steer: advance seals only the cutoff): the transaction that
// appends a user entry and prepares the model call writes the same bytes at
// 10 earlier entries as at 1,000, up to the patch (the 7-byte user entry and
// its visible line) and the few varint bytes of the larger positions. Oracle:
// the store's own diff; a body copied into any row or trigger argument would
// add about 200 bytes per entry, about 198,000 bytes between the two.
pub fn law_round_bytes_bounded(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> bool waits {
    let mut small_name = string.with_capacity(32u64)
    let small = result.unwrap(host.mkdtemp(parent, mut small_name))
    let mut large_name = string.with_capacity(32u64)
    let large = result.unwrap(host.mkdtemp(parent, mut large_name))
    let at_10 = round_bytes(small, clock, random, tasks, 10u64)
    let at_1000 = round_bytes(large, clock, random, tasks, 1000u64)
    result.unwrap(std.dir.remove_all(parent, small_name))
    result.unwrap(std.dir.remove_all(parent, large_name))
    let patch = 64u64
    let gap = if at_1000 > at_10 { at_1000 - at_10 } else { at_10 - at_1000 }
    at_10 > 0u64 && gap <= patch
}

@test
fn test_round_bytes_bounded(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_round_bytes_bounded(parent, clock, random, tasks) { Ok(()) } else { Error(()) }
}

// ---- gates, approvals and inside tools ----

fn pass_gate(c: harness.Call) -> harness.Verdict { Pass }
fn hold_gate(c: harness.Call) -> harness.Verdict { Hold("ask") }
fn deny_gate(c: harness.Call) -> harness.Verdict { Deny("no") }

fn gate_named(n: u8) -> harness.Gate {
    if n == 0u8 { harness.Gate(name: "pass", check: code.describe(pass_gate)) }
    else if n == 1u8 { harness.Gate(name: "hold", check: code.describe(hold_gate)) }
    else { harness.Gate(name: "deny", check: code.describe(deny_gate)) }
}

fn gated(take order: List[u8]) -> harness.Agent[Grants] {
    let mut a = crash_agent()
    for n in order { list.push(mut a.gates, gate_named(n)) }
    a
}

fn bump_call(take args: String) -> harness.Call { harness.Call(id: "c1", name: "bump", args: Inline(string.into_bytes(take args))) }

fn rank_of(v: harness.Verdict) -> u8 { match v { Pass => 0u8, Hold(_) => 1u8, Deny(_) => 2u8 } }

// Law G1 (Fable: monotonic gates): the verdict of a gate list is its
// greatest verdict under Pass < Hold < Deny, whatever the order. Oracle: the
// maximum of each list's ranks, computed by hand here from the list itself.
pub fn law_gates_fold_by_maximum() -> bool {
    // Every sequence of 0 to 3 gates (0 pass, 1 hold, 2 deny): 40 orders.
    let mut len = 0u64
    while len <= 3u64 {
      let mut count = 1u64
      for _ in 0u64..len { count = count * 3u64 }
      for i in 0u64..count {
        let mut order: List[u8] = list.new()
        let mut rest = i
        for _ in 0u64..len { let d = rest % 3u64
          list.push(mut order, if d == 0u64 { 0u8 } else if d == 1u64 { 1u8 } else { 2u8 })
          rest = rest / 3u64 }
        let mut want = 0u8
        for n in order { if n > want { want = n } }
        if rank_of(harness.verdict(gated(clone(order)), bump_call("{}"))) != want { return false }
      }
      len = len + 1u64
    }
    true
}

@test
fn test_gates_fold_by_maximum() -> Result[(), ()] {
    if law_gates_fold_by_maximum() { Ok(()) } else { Error(()) }
}

// Strips ASCII spaces: the arguments the gates and approvals see.
fn strip_spaces(raw: Bytes) -> Result[Bytes, harness.Fault] {
    let mut out: Bytes = list.new()
    for b in raw { if b != 32u8 { list.push(mut out, b) } }
    Ok(take out)
}

fn scribble_ok(mut tx: store.Tx, args: Bytes) -> Result[Bytes, harness.Fault] {
    let Ok(h) = harness.handles(store.tx_schema(tx)) else { return Error(Unavailable) }
    let Ok(()) = store.put(mut tx, h.views, 999u64, Status("scribbled")) else { return Error(Unavailable) }
    Ok(string.into_bytes("ok"))
}

fn scribble_bad(mut tx: store.Tx, args: Bytes) -> Result[Bytes, harness.Fault] {
    let Ok(h) = harness.handles(store.tx_schema(tx)) else { return Error(Unavailable) }
    let Ok(()) = store.put(mut tx, h.views, 999u64, Status("scribbled")) else { return Error(Unavailable) }
    Error(BadArgs("bad"))
}

fn alice() -> store.Caller { store.Caller(issuer: 1u8, subject: string.into_bytes("alice")) }

// A session whose run 0 has its model answer (one call) committed and not yet
// derived.
fn answered(dir: Dir, clock: Clock, random: Random, tasks: Tasks, take call: harness.Call) -> store.Db waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, store.triggers.law_options()))
    result.unwrap(store.run_migration(mut db, tasks, code.describe(harness.migrate)))
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let filled = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        let mut calls: List[harness.Call] = list.new()
        list.push(mut calls, clone(call))
        let answer = harness.Answer(text: "", calls: take calls, stop: "tool_use", usage: usage())
        store.put(mut tx, h.entries, 0u64, User("go"))?
        store.put(mut tx, h.entries, 1u64, Assistant(clone(answer)))?
        store.put(mut tx, h.session, 0u64, harness.Session(model: "scripted", tools_narrow: All, head_pos: 0u64, next_pos: 2u64,
            active_run: Some(0u64), next_run: 1u64, active_sections_hashes: list.new(), active_tools_hash: list.new()))?
        store.put(mut tx, h.runs, 0u64, harness.Run(caller: alice(), phase: AnswerReady(0u64), round: 0u64, rounds_left: 4u64,
            spend: harness.Spend(known: 15u64, reserved: 0u64, unresolved: 0u64)))?
        let model_key = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
        store.put(mut tx, h.effects, model_key, harness.Effect(cutoff: harness.Cutoff(head_pos: 0u64, tail_pos: 0u64, route: "scripted", policy: 0u64),
            call: None, repeat: Once, deadline: 0u64, phase: Settled(Model(take answer)), trigger: None, dispatches: 1u64, reserve: 0u64))
    })
    match take filled { Ok(Committed(_)) => (), _ => fail("answered: fill did not commit") }
    take db
}

fn kick(mut db: store.Db, a: harness.Agent[Grants]) -> () waits {
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let w = result.unwrap(wired())
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), harness.Refused] { harness.advance(mut tx, h, a, w, Kick) })
    match take ran { Ok(Committed(_)) => (), _ => fail("kick: advance did not commit") }
}

fn deciding(mut db: store.Db, a: harness.Agent[Grants], who: store.Caller, take d: harness.Decision) -> Result[(), harness.Refused] waits {
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let w = result.unwrap(wired())
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), harness.Refused] { harness.decide(mut tx, h, a, w, who, clone(d)) })
    match take ran {
        Ok(Committed(_)) => Ok(()),
        Ok(Aborted(store.Undone(value: take why, ..))) => Error(take why),
        _ => fail("decide: transaction failed"),
    }
}

fn member(db: store.Db) -> harness.EffectPhase {
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let key = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.TOOL, ordinal: 0u64)
    let Some(found) = result.unwrap(store.get(store.snapshot(db), store.shape(h.effects), key)) else { fail("member: no row") }
    clone(found.phase)
}

fn decision(take key: Bytes, allow: bool) -> harness.Decision { harness.Decision(run: 0u64, round: 0u64, ordinal: 0u64, key: take key, allow: allow) }

// Law G2 (astra: argument-bound approvals): a held call is approved only by
// its run's caller and only under the key of the tool, revision and
// arguments the gates saw, which are the repaired ones. A key for the
// unrepaired arguments or another revision conflicts and changes nothing.
// Oracle: hand-derived outcomes per decision; the call is sealed only after
// the one matching approval.
pub fn law_approval_bound_to_arguments(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> bool waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let mut hold_only: List[u8] = list.new()
    list.push(mut hold_only, 1u8)
    let mut a = gated(take hold_only)
    a.tools[0].repair = Some(code.describe(strip_spaces))
    let mut db = answered(dir, clock, random, tasks, bump_call("{ }"))
    kick(mut db, a)
    let held = match member(db) { Held => true, _ => false }
    let raw_key = harness.approval_key("bump", 1u64, Inline(string.into_bytes("{ }")))
    let rev_key = harness.approval_key("bump", 2u64, Inline(string.into_bytes("{}")))
    let right = harness.approval_key("bump", 1u64, Inline(string.into_bytes("{}")))
    let unrepaired = match deciding(mut db, a, alice(), decision(take raw_key, true)) { Error(Conflict) => true, _ => false }
    let revised = match deciding(mut db, a, alice(), decision(take rev_key, true)) { Error(Conflict) => true, _ => false }
    let stranger = match deciding(mut db, a, store.Caller(issuer: 1u8, subject: string.into_bytes("mallory")), decision(clone(right), true)) { Error(NotAllowed) => true, _ => false }
    let still_held = match member(db) { Held => true, _ => false }
    let approved = match deciding(mut db, a, alice(), decision(take right, true)) { Ok(()) => true, _ => false }
    let sealed = match member(db) { Sealed => true, _ => false }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    held && unrepaired && revised && stranger && still_held && approved && sealed
}

@test
fn test_approval_bound_to_arguments(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_approval_bound_to_arguments(parent, clock, random, tasks) { Ok(()) } else { Error(()) }
}

fn inside_case(parent: Dir, clock: Clock, random: Random, tasks: Tasks, good: bool) -> (bool, harness.EffectPhase) waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let mut a = crash_agent()
    let f = if good { code.describe(scribble_ok) } else { code.describe(scribble_bad) }
    list.push(mut a.tools, harness.inside("scribble", "writes a row", "{}", f))
    let mut db = answered(dir, clock, random, tasks, harness.Call(id: "c1", name: "scribble", args: Inline(string.into_bytes("{}"))))
    kick(mut db, a)
    let phase_after_derive = member(db)
    let _ = phase_after_derive
    kick(mut db, a)
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let wrote = match result.unwrap(store.get(store.snapshot(db), store.shape(h.views), 999u64)) { Some(_) => true, None => false }
    let phase = member(db)
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    (wrote, take phase)
}

// Law I1 (Fable: Inside tools run once in advance's transaction): an Inside
// tool's writes commit with its result, and a tool that returns an error
// leaves none of its writes, while the advance itself still commits the
// failure. Oracle: the row each tool writes, by hand.
pub fn law_inside_rolls_back_on_error(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> bool waits {
    let (kept_row, ok_phase) = inside_case(parent, clock, random, tasks, true)
    let (bad_row, bad_phase) = inside_case(parent, clock, random, tasks, false)
    let ok_settled = match ok_phase { Settled(Tool(Returned(Inline(out)))) => out == string.into_bytes("ok"), _ => false }
    let bad_settled = match bad_phase { Settled(Tool(Failed(why))) => why == "bad", _ => false }
    kept_row && ok_settled && !bad_row && bad_settled
}

@test
fn test_inside_rolls_back_on_error(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_inside_rolls_back_on_error(parent, clock, random, tasks) { Ok(()) } else { Error(()) }
}

// ---- system sections and reactions ----

// Each section shows the text in its views row; a missing row removes it and
// any other row makes its render fail.
fn section_text(tx: store.Tx, k: u64) -> Result[Option[String], store.Error] {
    let h = harness.handles(store.tx_schema(tx))?
    match store.fetch(tx, store.shape(h.views), k)? {
        Some(Status(text)) => Ok(Some(clone(text))),
        Some(_) => Error(Missing("section")),
        None => Ok(None),
    }
}
fn section_a(tx: store.Tx) -> Result[Option[String], store.Error] { section_text(tx, 1000u64) }
fn section_b(tx: store.Tx) -> Result[Option[String], store.Error] { section_text(tx, 1001u64) }
fn section_c(tx: store.Tx) -> Result[Option[String], store.Error] { section_text(tx, 1002u64) }

fn sectioned(reversed: bool) -> harness.Agent[Grants] {
    let mut a = crash_agent()
    let sa = harness.Section(key: "a", render: code.describe(section_a))
    let sb = harness.Section(key: "b", render: code.describe(section_b))
    let sc = harness.Section(key: "c", render: code.describe(section_c))
    if reversed { list.push(mut a.sections, take sc); list.push(mut a.sections, take sb); list.push(mut a.sections, take sa) }
    else { list.push(mut a.sections, take sa); list.push(mut a.sections, take sb); list.push(mut a.sections, take sc) }
    a
}

type Shows = Show(String) | Hidden | Broken

fn put_shows(mut tx: store.Tx, h: harness.Handles, k: u64, s: Shows) -> Result[(), store.Error] {
    match s {
        Show(text) => store.put(mut tx, h.views, k, Status(clone(text))),
        Hidden => { let _ = store.delete(mut tx, h.views, k)?; Ok(()) },
        Broken => store.put(mut tx, h.views, k, Line("broken", "")),
    }
}

fn fresh(dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> store.Db waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, store.triggers.law_options()))
    result.unwrap(store.run_migration(mut db, tasks, code.describe(harness.migrate)))
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let filled = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, h.entries, 0u64, User("go"))?
        store.put(mut tx, h.session, 0u64, harness.Session(model: "scripted", tools_narrow: All, head_pos: 0u64, next_pos: 1u64,
            active_run: Some(0u64), next_run: 1u64, active_sections_hashes: list.new(), active_tools_hash: list.new()))
    })
    match take filled { Ok(Committed(_)) => (), _ => fail("fresh: fill did not commit") }
    take db
}

// What one prepare showed: the request's system texts and tool names, and the
// System entries it appended as (baseline, changes, tools replaced).
type Prepared { system: List[String], tools: List[String], patches: List[(bool, u64, bool)] }

fn prepared(mut db: store.Db, a: harness.Agent[Grants], round: u64, take shows: List[Shows], narrow: bool) -> Prepared waits {
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let before = option.unwrap(result.unwrap(store.get(store.snapshot(db), store.shape(h.session), 0u64))).next_pos
    let set = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        for i in 0u64..list.len(shows) { put_shows(mut tx, h, 1000u64 + i, shows[i])? }
        if narrow {
            let Some(take found) = store.fetch(tx, store.shape(h.session), 0u64)? else { return Error(Missing("session")) }
            let mut s = take found
            s.tools_narrow = Only(list.new())
            store.put(mut tx, h.session, 0u64, s)?
        }
        store.put(mut tx, h.runs, 0u64, harness.Run(caller: alice(), phase: Preparing, round: round, rounds_left: 8u64,
            spend: harness.Spend(known: 0u64, reserved: 0u64, unresolved: 0u64)))
    })
    match take set { Ok(Committed(_)) => (), _ => fail("prepared: setup did not commit") }
    kick(mut db, a)
    let snap = store.snapshot(db)
    let after = option.unwrap(result.unwrap(store.get(snap, store.shape(h.session), 0u64))).next_pos
    let mut patches: List[(bool, u64, bool)] = list.new()
    for p in before..after {
        if let Some(System(patch)) = result.unwrap(store.get(snap, store.shape(h.entries), p)) {
            let replaced = match patch.tools { Some(_) => true, None => false }
            list.push(mut patches, (patch.baseline, list.len(patch.changes), replaced))
        }
    }
    let key = harness.EffectKey(run: 0u64, round: round, kind: harness.MODEL, ordinal: 0u64)
    let Some(e) = result.unwrap(store.get(snap, store.shape(h.effects), key)) else { fail("prepared: no model effect") }
    let asked = result.unwrap(harness.request(snap, h, key, e.cutoff))
    let mut tools: List[String] = list.new()
    for t in asked.tools { list.push(mut tools, clone(t.name)) }
    Prepared(system: clone(asked.system), tools: take tools, patches: take patches)
}

fn texts3(x: String, y: String, z: String, n: u64) -> List[String] {
    let mut out: List[String] = list.new()
    if n > 0u64 { list.push(mut out, clone(x)) }
    if n > 1u64 { list.push(mut out, clone(y)) }
    if n > 2u64 { list.push(mut out, clone(z)) }
    take out
}

fn shows3(take x: Shows, take y: Shows, take z: Shows) -> List[Shows] {
    let mut out: List[Shows] = list.new()
    list.push(mut out, take x)
    list.push(mut out, take y)
    list.push(mut out, take z)
    take out
}

fn one_patch(p: Prepared, baseline: bool, changes: u64, tools: bool) -> bool {
    list.len(p.patches) == 1u64 && p.patches[0].0 == baseline && p.patches[0].1 == changes && p.patches[0].2 == tools
}

// Law P1 (Fable: positional system patches): after each prepare, the fold of
// every System entry in the log is the list of sections the agent renders
// now, in the agent's order, with a failed section keeping its last text.
// Each patch is the smallest one: only changed keys, nothing when nothing
// changed, and a baseline only when the order changed. Oracle: the section
// texts each step writes, and the patch each step must append, by hand.
pub fn law_system_patches_fold_to_sections(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> u64 waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let mut db = fresh(dir, clock, random, tasks)
    let ab = sectioned(false)
    let cb = sectioned(true)
    let mut bad = 0u64
    // 1. a and b shown, c absent: the first request is a baseline.
    let p1 = prepared(mut db, ab, 0u64, shows3(Show("A1"), Show("B1"), Hidden), false)
    if bad == 0u64 && !(p1.system == texts3("A1", "B1", "", 2u64) && one_patch(p1, true, 2u64, true) && list.len(p1.tools) == 1u64) { bad = 1u64 }
    // 2. Nothing changed: no patch.
    let p2 = prepared(mut db, ab, 1u64, shows3(Show("A1"), Show("B1"), Hidden), false)
    if bad == 0u64 && !(p2.system == texts3("A1", "B1", "", 2u64) && list.len(p2.patches) == 0u64) { bad = 2u64 }
    // 3. b changes and c appears: two changes in place.
    let p3 = prepared(mut db, ab, 2u64, shows3(Show("A1"), Show("B2"), Show("C1")), false)
    if bad == 0u64 && !(p3.system == texts3("A1", "B2", "C1", 3u64) && one_patch(p3, false, 2u64, false)) { bad = 3u64 }
    // 4. a is removed: one change.
    let p4 = prepared(mut db, ab, 3u64, shows3(Hidden, Show("B2"), Show("C1")), false)
    if bad == 0u64 && !(p4.system == texts3("B2", "C1", "", 2u64) && one_patch(p4, false, 1u64, false)) { bad = 4u64 }
    // 5. b fails and keeps B2; c changes.
    let p5 = prepared(mut db, ab, 4u64, shows3(Hidden, Broken, Show("C2")), false)
    if bad == 0u64 && !(p5.system == texts3("B2", "C2", "", 2u64) && one_patch(p5, false, 1u64, false)) { bad = 5u64 }
    // 6. A release reverses the order, with a back: a baseline in the new order.
    let p6 = prepared(mut db, cb, 5u64, shows3(Show("A2"), Show("B3"), Show("C2")), false)
    if bad == 0u64 && !(p6.system == texts3("C2", "B3", "A2", 3u64) && one_patch(p6, true, 3u64, true)) { bad = 6u64 }
    // 7. Same order, b fails: nothing to patch.
    let p7 = prepared(mut db, cb, 6u64, shows3(Show("A2"), Broken, Show("C2")), false)
    if bad == 0u64 && !(p7.system == texts3("C2", "B3", "A2", 3u64) && list.len(p7.patches) == 0u64) { bad = 7u64 }
    // 8. The order changes back while b fails: the baseline would need b's
    // text, so it is put off and the prompt stays as it was.
    let p8 = prepared(mut db, ab, 7u64, shows3(Show("A2"), Broken, Show("C2")), false)
    if bad == 0u64 && !(p8.system == texts3("C2", "B3", "A2", 3u64) && list.len(p8.patches) == 0u64) { bad = 8u64 }
    // 9. b renders again: the put-off baseline.
    let p9 = prepared(mut db, ab, 8u64, shows3(Show("A2"), Show("B3"), Show("C2")), false)
    if bad == 0u64 && !(p9.system == texts3("A2", "B3", "C2", 3u64) && one_patch(p9, true, 3u64, true)) { bad = 9u64 }
    // 10. The session narrows its tools to none: a tools-only patch.
    let p10 = prepared(mut db, ab, 9u64, shows3(Show("A2"), Show("B3"), Show("C2")), true)
    if bad == 0u64 && !(p10.system == texts3("A2", "B3", "C2", 3u64) && one_patch(p10, false, 0u64, true) && list.len(p10.tools) == 0u64) { bad = 10u64 }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    bad
}

@test
fn test_system_patches_fold_to_sections(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), u64] waits {
    // The law answers the first step whose request or patch is wrong, or 0.
    let bad = law_system_patches_fold_to_sections(parent, clock, random, tasks)
    if bad == 0u64 { Ok(()) } else { Error(bad) }
}

fn mark_user(mut tx: store.Tx, at: u64, e: harness.Entry) -> Result[(), harness.Fault] {
    let User(_) = view e else { return Ok(()) }
    let Ok(h) = harness.handles(store.tx_schema(tx)) else { return Error(Unavailable) }
    let Ok(()) = store.put(mut tx, h.views, 2000u64 + at, Status("seen")) else { return Error(Unavailable) }
    Ok(())
}

fn mark_then_fail(mut tx: store.Tx, at: u64, e: harness.Entry) -> Result[(), harness.Fault] {
    let Ok(h) = harness.handles(store.tx_schema(tx)) else { return Error(Unavailable) }
    let Ok(()) = store.put(mut tx, h.views, 3000u64 + at, Status("half")) else { return Error(Unavailable) }
    Error(Refused("no"))
}

// Law R1 (Fable: reactions run in the appending transaction): a reaction's
// writes commit with the entry it reacts to, and a failing reaction can
// neither veto the entry nor leave a partial write; its failure is a Note.
// Oracle: the rows each reaction writes, by hand.
pub fn law_reactions_commit_with_entry(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> bool waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, store.triggers.law_options()))
    result.unwrap(store.run_migration(mut db, tasks, code.describe(harness.migrate)))
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let mut a = crash_agent()
    list.push(mut a.reactions, harness.After(name: "mark", run: code.describe(mark_user)))
    list.push(mut a.reactions, harness.After(name: "half", run: code.describe(mark_then_fail)))
    let w = result.unwrap(wired())
    let ran = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[harness.Disposition, harness.Refused] {
        harness.open_session(mut tx, h, "scripted", All)?
        harness.submit(mut tx, h, a, w, alice(), harness.Submit(client_key: "k", text: "hi"))
    })
    let placed = match take ran { Ok(Committed(store.Done(value: Placed(_), ..))) => true, _ => false }
    let snap = store.snapshot(db)
    let user = match result.unwrap(store.get(snap, store.shape(h.entries), 0u64)) { Some(User(t)) => t == "hi", _ => false }
    let marked = match result.unwrap(store.get(snap, store.shape(h.views), 2000u64)) { Some(_) => true, None => false }
    let half = match result.unwrap(store.get(snap, store.shape(h.views), 3000u64)) { Some(_) => true, None => false }
    let noted = match result.unwrap(store.get(snap, store.shape(h.entries), 1u64)) { Some(Note(why, who)) => why == "reaction failed" && who == string.into_bytes("half"), _ => false }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    placed && user && marked && !half && noted
}

@test
fn test_reactions_commit_with_entry(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_reactions_commit_with_entry(parent, clock, random, tasks) { Ok(()) } else { Error(()) }
}

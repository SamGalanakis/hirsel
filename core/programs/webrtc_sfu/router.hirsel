// RTC-5, RTC-6 and RTC-7 on one media unit (webrtc spec, slices S4 and S5): rooms,
// fences, publications, down-tracks, fan-out in the subscriber's wire identity,
// stable target maps and negotiated keyframe requests. The router is sans-IO. Every
// unit keeps the control state of every room; a unit holds the sessions, rings and
// tracks of its own participants, and posts what other units need as `Carried`
// messages. Inboxes, sockets and the turn are module `units`.
pub type RoomLimits {
    participants: u16,
    ids: u16,
    publications: u16,
    down_tracks: u32,
    audio_forward: u8,
    pause_delay_ms: u32,
    // RTC-6: whether the budget may pause a video down-track whose lowest encoding does
    // not fit (LiveKit's `allow_pause`); off, the lowest encoding is always taken.
    pause: bool
}

pub type RouterError = NoRoom | NoParticipant | NoPublication | Fenced | Suspended | Exists | Limit(u32) | Unrepresentable | Peer(peer.PeerError) | Capacity(Capacity)

pub type PublicationId: key = PublicationId(u64)

pub type Target: key + codec = Off | Layer(encoding: u8, spatial: u8, temporal: u8)

/// Router counters: keyframe requests the publisher's negotiation could not carry
/// (RTC-6: the down-track waits for the next independent frame), and repair asks
/// whose plaintext had left the ingress ring.
pub type Counts: key {
    unrequested: u64,
    ring_misses: u64,
    // Packets whose payload descriptor did not parse, so no leg could take them.
    unparsed: u64,
    // Leg packets a stream's layer ids put outside the stable map (RTC-6).
    unmapped: u64,
    // AV1 targets an unrepresentable structure refused (RTC-6): the down-track kept
    // its current target.
    refused: u64,
    // Datagrams from a 5-tuple outside the table that no local session's ICE
    // credentials named (RTC-3), dropped.
    unknown: u64,
    // Messages from another unit dropped when taken, because a fence or a suspension
    // covers their tag or their publication or session is gone (RTC-7 step 4).
    stale: u64
}

/// The plaintext of one publication's recent packets (the ingress RTX ring), in
/// fixed slots: `floor(rtx_bytes / 1500)` of them, fixed when the publication opens.
type Ring {
    slots: List[Bytes],
    handles: List[u64]
}

type Encoding {
    ssrc: u32,
    keyframes: rtp.loss.Keyframes,
    interval: u64,
    // VP9's per-source switching-up state (RTC-6), observed once per packet.
    vp9: media_bits.unit.Vp9Layers,
    // RTC-6's measured ingress rate in bits per second: the home unit's last closed
    // window that had packets, and every other unit's copy from `Media`; `counted`
    // is the home unit's open window.
    rate: u64,
    counted: u64,
    // RTC-6's planned rate in bits per second from the publisher's video layers
    // allocation, 0 when none came; it stands in for `rate` where present. A stream
    // the allocation leaves inactive keeps its last planned rate.
    planned: u64,
    // On the home unit, whether the last allocation left this stream inactive.
    idle: bool,
    // On the home unit, the dynacast mask (RTC-6): the units whose local mask holds
    // this encoding, whether its bit is published, and since when the union is empty.
    wanting: u64,
    on: bool,
    since: Option[u64],
    // AV1's template structure of this source (AV1 RTP section A.8), from its last
    // descriptor that carried one. The target map is derived from it.
    structure: media_bits.dependency.Structure,
    // The frame number of the keyframe that brought `structure`. A retransmitted or
    // late keyframe older than it must not bring back its older structure.
    structure_frame: Option[u16],
    // H.264's `after_end` facts of this source (rtp RTP-11): the newest packet index
    // seen, its extended timestamp, and its marker.
    last: Option[u64],
    last_ts: i64,
    last_marker: bool
}

// RTC-6's speaker score of an audio publication, in Q16, and its open window, in
// RTP ticks of the publication's clock (home unit). Every other unit keeps `score`
// as the home unit posted it.
type Voice {
    score: i64,
    observed: u64,
    active: u64,
    loudest: u8,
    highest: Option[i64],
    last: u64
}

type Publication {
    id: PublicationId,
    owner: peer.Gen,
    // The publisher's home unit: only it holds the session and the ring.
    home: u16,
    room: peer.RoomId,
    section: u8,
    codec: sdp.Codec,
    pli: bool,
    fir: bool,
    encodings: List[Encoding],
    ring: Ring,
    // RTP-13: an Opus publication's last primaries, kept on every unit with one of
    // its down-tracks, which rebuild RED from them. Other codecs keep none.
    red: rtp.red.Ring,
    // The local wanted mask this unit last told the home unit (RTC-6).
    local: u8,
    // The media clock rate and the start of the open rate window (home unit).
    clock: u32,
    window: Option[u64],
    voice: Voice,
    // RTC-6: the published encodings the publisher's allocation stopped, one bit per
    // encoding. The home unit derives it; every other unit takes it from `Media`.
    dropped: u8,
    // RTC-5: the last CVO byte the publisher sent, on any of its encodings.
    orientation: Option[u8]
}

type Down {
    sub: peer.Gen,
    // The subscriber's home unit: only it holds the track.
    home: u16,
    room: peer.RoomId,
    publication: PublicationId,
    // The subscriber's sending section the track lives on.
    section: u8,
    track: u16,
    target: Target,
    // RTC-6's effective target, the target lowered to the subscriber's estimate, and
    // whether `audio_forward` holds this audio down-track at `Off`.
    effective: Target,
    held: bool,
    // The H.264 parameter sets this leg has sent (media_bits `ParameterSets`) and the
    // source they came from. Only that source's packets are judged against them; any
    // other source has sent nothing since the last switch away from it (RTP-11).
    sets: media_bits.unit.ParameterSets,
    sets_source: Option[u32],
    // A rebind waiting for the new publication's keyframe: the publication that
    // still forwards until then.
    previous: Option[PublicationId],
    // AV1: the frame numbers this leg last forwarded per chain (AV1 RTP section A.5),
    // of its current source and of a rebind's new source.
    chains: media_bits.unit.Av1Chains,
    next_chains: media_bits.unit.Av1Chains
}

// A participant every unit knows of (RTC-5, Units): its home unit, which holds its
// session, and the counts its bounds are checked against.
type Seat {
    who: peer.Participant,
    home: u16,
    publications: u16,
    downs: u32
}

// A session of a participant whose home is this unit.
type Member {
    who: peer.Participant,
    session: peer.PeerSession,
    // The bandwidth estimate the last allocation used, and the rate it would take to
    // carry every target, when the estimate left one short of its target (RTC-6).
    estimate: u64,
    want: u64
}

type Room {
    id: peer.RoomId,
    limits: RoomLimits,
    suspended: bool,
    // Fence entries (RTC-7): one per admitted id, reserved at its first join and
    // kept until the room closes. `fenced` is the highest revoked epoch, if any.
    ids: List[u64],
    fenced: List[Option[u64]],
    // On the control unit: whether a score changed since the last 400 ms tick, the
    // next tick, and the top speakers last emitted (RTC-6).
    heard: bool,
    tick: u64,
    top: List[u64]
}

// The home unit's 5-tuple table (RTC-3): the selected path of each local session.
type Row {
    from: Addr,
    room: peer.RoomId,
    who: peer.Gen
}

/// A publication's codec facts, which its home unit reads from the agreement and
/// every other unit takes from the control order.
pub type Shape: key {
    codec: sdp.Codec,
    pli: bool,
    fir: bool,
    encodings: u8
}

/// One control change (RTC-5, the control order). The control unit applies each
/// call as one change on the unit that holds the session it touches first, then on
/// every other unit, in one order. A session is opened on its home unit and parked
/// there (`park`); `Admit` admits it.
pub type Change: cross = Open(room: peer.RoomId, limits: RoomLimits) | Admit(who: peer.Participant, home: u16) | Publish(room: peer.RoomId, who: peer.Gen, section: u8, id: PublicationId, shape: Option[Shape]) | Subscribe(room: peer.RoomId, who: peer.Gen, p: PublicationId, section: u8, target: Target) | Retarget(room: peer.RoomId, who: peer.Gen, p: PublicationId, target: Target) | Rebind(room: peer.RoomId, who: peer.Gen, from: PublicationId, to: PublicationId, target: Target) | Unsubscribe(room: peer.RoomId, who: peer.Gen, p: PublicationId) | Leave(room: peer.RoomId, who: peer.Gen) | Revoke(room: peer.RoomId, id: u64, epoch: u64) | Suspend(room: peer.RoomId, on: bool) | Playout(room: peer.RoomId, who: peer.Gen, p: PublicationId, delay: Option[peer.Delay])

/// What a unit answers when it has applied a change.
pub type Answer: cross = Done | Shaped(id: PublicationId, shape: Shape)

/// The control inboxes' messages: the control unit's changes, in order, and each
/// unit's acknowledgement once it has applied one.
pub type Control: cross = Order(seq: u64, change: Change) | Ack(seq: u64, unit: u16, answer: Result[Answer, RouterError])

/// The media inboxes' messages (RTC-5):
///
/// - `Media`: a packet of a publication for another unit's down-tracks (fan-out
///   step 3), with the publisher's generation, the home unit's ingress view and its
///   ring handle; the plaintext packet up to the payload's end is `packet`.
/// - `Ask`: a remote unit's NACK hit, which its down-track's egress history named.
/// - `Reply`: the home unit's answer to an `Ask`, the plaintext from its ring.
/// - `Key`: a keyframe a remote down-track needs (RTC-6); the home unit coalesces it.
/// - `Sender`: a publisher's sender report, for remote switch timelines (RTP-11).
///
/// RTC-6, each with the publisher's generation, so a fence drops it when taken:
///
/// - `Wanted`: a unit's local wanted mask of a publication, for its home unit.
/// - `Layers`: a published mask change, for the control unit's `Event.Layers`.
/// - `Score`: an audio publication's speaker score, for every unit of the room.
///
/// `Media` also carries the home unit's speaking state and its encoding's rate.
///
/// RTC-4's re-offer, from a session's home unit to the control unit, with the
/// participant's generation:
///
/// - `Offer`: the re-offer after a collision, its SDP in `packet`.
/// - `Shut`: a refused re-offer closed the session.
/// - `Answer`: the participant's answer to it, from the control unit to the home unit,
///   its SDP in `packet`.
pub type Carry: cross = Media(room: peer.RoomId, publication: PublicationId, src: peer.Gen, m: peer.MediaIn, handle: u64, speaking: bool, rate: u64, dropped: u8) | Wanted(room: peer.RoomId, publication: PublicationId, src: peer.Gen, unit: u16, mask: u8) | Layers(room: peer.RoomId, publication: PublicationId, src: peer.Gen, mask: u8) | Score(room: peer.RoomId, publication: PublicationId, src: peer.Gen, score: i64) | Ask(room: peer.RoomId, publication: PublicationId, src: peer.Gen, dst: peer.Gen, ask: peer.RepairAsk) | Reply(room: peer.RoomId, publication: PublicationId, src: peer.Gen, dst: peer.Gen, ask: peer.RepairAsk) | Key(room: peer.RoomId, publication: PublicationId, encoding: u8, why: rtp.loss.Why) | Sender(room: peer.RoomId, publication: PublicationId, owner: peer.Gen, source: u32, info: rtp.rtcp.SenderInfo) | Offer(room: peer.RoomId, src: peer.Gen, version: u64) | Shut(room: peer.RoomId, src: peer.Gen) | Answer(room: peer.RoomId, dst: peer.Gen, version: u64)

/// One media-inbox message: what it is, and the plaintext it carries (empty for
/// `Ask`, `Key` and `Sender`).
pub type Carried: cross {
    carry: Carry,
    packet: Shared[Bytes]
}

/// A message for unit `to`, which the unit layer sends after the step that made it.
pub type Post: cross {
    to: u16,
    carried: Carried
}

/// What the control unit raises for the signaling adapter (RTC-6): a publication's
/// published wanted mask, and a room's top speakers by participant id.
pub type Notice: cross = Layers(publication: PublicationId, mask: u8) | Speakers(room: peer.RoomId, top: Inline[u64, 8], count: u8) | Offer(who: peer.Gen, version: u64, text: Bytes) | Shut(who: peer.Gen)

pub opaque type Router {
    random: Random,
    // This unit's index among the media units (0 on a single unit).
    unit: u16,
    rooms: List[Room],
    roster: List[Seat],
    members: List[Member],
    publications: List[Publication],
    downs: List[Down],
    rows: List[Row],
    next_publication: u64,
    // Ring handles are unique across publications and units (the unit's index in the
    // low six bits), so a repair ask finds its plaintext in the one ring that holds it,
    // also while a rebind is pending.
    next_handle: u64,
    counts: Counts,
    posts: List[Post],
    // Sessions opened on this unit and not yet admitted.
    parked: List[Member],
    // The payload of messages that carry none, shared by all of them.
    empty: Shared[Bytes],
    notices: List[Notice],
    // A down-track ended or an effective target moved since the last poll (RTC-6).
    moved: bool
}

const PEERS_MAX: u16 = 256

const PUBLICATIONS_MAX: u16 = 8

const DOWN_TRACKS_MAX: u32 = 64

const ENCODINGS_MAX: u64 = 4

const RING_SLOT: u64 = 1500

const MIN_INTERVAL_NS: u64 = 100000000

const UNITS_MAX: u16 = 64

const NO_HANDLE: u64 = 0xffffffffffffffff

/// A router on a single unit.
pub fn router(r: Random) -> Router {
    on_unit(r, 0)
}

/// The router of media unit `unit` (RTC-5, at most 64 units).
pub fn on_unit(r: Random, unit: u16) -> Router {
    Router(random: r, unit: unit, rooms: list.new(), roster: list.new(), members: list.new(), publications: list.new(), downs: list.new(), rows: list.new(), next_publication: 1, next_handle: int.widen(unit), counts: Counts(unrequested: 0, ring_misses: 0, unparsed: 0, unmapped: 0, refused: 0, unknown: 0, stale: 0), posts: list.new(), parked: list.new(), empty: shared.new(list.new()), notices: list.new(), moved: false)
}

pub fn counts(r: Router) -> Counts {
    r.counts
}

/// The messages the last steps made for other units, oldest first.
pub fn take_posts(mut r: Router) -> List[Post] {
    replace(mut r.posts, list.new())
}

fn post(mut r: Router, to: u16, carry: Carry, take packet: Shared[Bytes]) {
    list.push(mut r.posts, Post(to: to, carried: Carried(carry: carry, packet: take packet)))
}

fn post_bare(mut r: Router, to: u16, carry: Carry) {
    let none = shared.share(r.empty)
    post(mut r, to, carry, take none)
}

fn room_at(r: Router, room: peer.RoomId) -> Option[u64] {
    for i in 0u64 .. list.len(r.rooms) {
        if r.rooms[i].id == room {
            return Some(i)
        }
    }
    None
}

fn seat_at(r: Router, room: peer.RoomId, who: peer.Gen) -> Option[u64] {
    for i in 0u64 .. list.len(r.roster) {
        if r.roster[i].who.room == room && r.roster[i].who.gen == who {
            return Some(i)
        }
    }
    None
}

fn member_at(r: Router, room: peer.RoomId, who: peer.Gen) -> Option[u64] {
    for i in 0u64 .. list.len(r.members) {
        if r.members[i].who.room == room && r.members[i].who.gen == who {
            return Some(i)
        }
    }
    None
}

fn publication_at(r: Router, room: peer.RoomId, p: PublicationId) -> Option[u64] {
    for i in 0u64 .. list.len(r.publications) {
        if r.publications[i].id == p && r.publications[i].room == room {
            return Some(i)
        }
    }
    None
}

fn down_at(r: Router, room: peer.RoomId, sub: peer.Gen, p: PublicationId) -> Option[u64] {
    for i in 0u64 .. list.len(r.downs) {
        let d = r.downs[i]
        if d.room == room && d.sub == sub && d.publication == p {
            return Some(i)
        }
    }
    None
}

// ---- The calls on a single unit, each one change ----
pub fn open_room(mut r: Router, room: peer.RoomId, limits: RoomLimits) -> Result[(), RouterError] {
    open(mut r, room, limits)
}

/// Admit an opened session to its room. The id's fence entry is reserved at its
/// first admission; an id the room has never admitted, when every entry is
/// reserved, is `Limit(ids)`, and an epoch at or below the id's fence is `Fenced`.
pub fn join(mut r: Router, take session: peer.PeerSession) -> Result[(), RouterError] {
    let who = peer.who(session)
    let unit = r.unit
    park(mut r, take session)?
    match admit(mut r, who, unit) {
        Ok(()) => Ok(()),
        Error(e) => {
            unpark(mut r, who)
            Error(e)
        },
    }
}

/// Park a session opened on this unit (its home) until the control order admits it.
pub fn park(mut r: Router, take session: peer.PeerSession) -> Result[(), RouterError] {
    let who = peer.who(session)
    for m in r.parked {
        if m.who.room == who.room && m.who.gen == who.gen {
            return Error(Exists)
        }
    }
    list.try_reserve(mut r.parked, 1) ?=> |c| Capacity(c)
    list.push(mut r.parked, Member(who: who, session: take session, estimate: 0, want: 0))
    Ok(())
}

fn unpark(mut r: Router, who: peer.Participant) {
    for i in 0u64 .. list.len(r.parked) {
        if r.parked[i].who.room == who.room && r.parked[i].who.gen == who.gen {
            let m = list.remove(mut r.parked, i)
            let Member(who: _, session: take s, estimate: _, want: _) = take m
            drop(take s)
            return
        }
    }
}

/// Make the receiving section `section` of `who`'s session a publication.
pub fn publish(mut r: Router, room: peer.RoomId, who: peer.Gen, section: u8) -> Result[PublicationId, RouterError] {
    let id = PublicationId(r.next_publication)
    let _ = add_publication(mut r, room, who, section, id, None)?
    r.next_publication += 1
    Ok(id)
}

/// The next publication id the control unit hands out.
pub fn next_publication(mut r: Router) -> PublicationId {
    let id = PublicationId(r.next_publication)
    r.next_publication += 1
    id
}

/// Subscribe `who` to a publication on its sending section `section`.
pub fn subscribe(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId, section: u8, target: Target, now: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    add_down(mut r, room, who, p, section, target, now, mut out)?
    rebalance(mut r, now, mut out)
}

/// Point a down-track at a layer. A layer on another source asks the publisher for
/// a keyframe of it (`Switch`), and the old source forwards until it arrives.
pub fn set_target(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId, target: Target, now: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    retarget(mut r, room, who, p, target, now, mut out)?
    rebalance(mut r, now, mut out)
}

/// Rebind `who`'s down-track from publication `from` to `to` (RTC-4, RTC-5): the
/// track keeps its SSRCs, sealers and `Rewrite`, so its numbering stays continuous.
/// `to`'s layer is pending until its keyframe, which is asked for at once, and
/// `from` forwards until then. `to`'s codec must have a payload type on the track's
/// section.
pub fn rebind(mut r: Router, room: peer.RoomId, who: peer.Gen, from: PublicationId, to: PublicationId, target: Target, now: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    move_down(mut r, room, who, from, to, target, now, mut out)?
    rebalance(mut r, now, mut out)
}

/// Set the static playout delay `who`'s down-track of `p` writes (RTC-5), or stop it.
pub fn set_playout(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId, delay: Option[peer.Delay]) -> Result[(), RouterError] {
    playout(mut r, room, who, p, delay)
}

pub fn unsubscribe(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId) -> Result[(), RouterError] {
    remove_down(mut r, room, who, p)
}

/// A participant leaves: its publications and down-tracks go, and its session is
/// closed with a DTLS close_notify.
pub fn leave(mut r: Router, room: peer.RoomId, who: peer.Gen, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Some(si) = seat_at(r, room, who) else {
        return Error(NoParticipant)
    }
    drop_seat(mut r, si, true, mut out)
    Ok(())
}

/// Fence `id` at `epoch` and below (RTC-7 steps 1 to 3 on this unit, and step 2 on
/// `out`): its sessions are erased without notice, every down-track it publishes or
/// subscribes to goes, and a later join at or below the epoch is `Fenced`.
pub fn revoke(mut r: Router, room: peer.RoomId, id: u64, epoch: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    fence(mut r, room, id, epoch, mut out)
}

/// Stop routing media and repair for the whole room (RTC-7, Suspend); ingress stays up.
pub fn suspend(mut r: Router, room: peer.RoomId, mut out: peer.Outbox) -> Result[(), RouterError] {
    hold(mut r, room, true, mut out)
}

pub fn resume(mut r: Router, room: peer.RoomId, mut out: peer.Outbox) -> Result[(), RouterError] {
    hold(mut r, room, false, mut out)
}

// ---- What each change does on a unit ----
fn open(mut r: Router, room: peer.RoomId, limits: RoomLimits) -> Result[(), RouterError] {
    if let Some(_) = room_at(r, room) {
        return Error(Exists)
    }
    if limits.participants > PEERS_MAX {
        return Error(Limit(int.widen(PEERS_MAX)))
    }
    if limits.ids < limits.participants {
        return Error(Limit(int.widen(limits.participants)))
    }
    if limits.publications > PUBLICATIONS_MAX {
        return Error(Limit(int.widen(PUBLICATIONS_MAX)))
    }
    if limits.down_tracks > DOWN_TRACKS_MAX {
        return Error(Limit(DOWN_TRACKS_MAX))
    }
    let n: u64 = int.widen(limits.ids)
    let mut ids: List[u64] = list.new()
    let mut fences: List[Option[u64]] = list.new()
    list.try_reserve(mut ids, n) ?=> |c| Capacity(c)
    list.try_reserve(mut fences, n) ?=> |c| Capacity(c)
    list.try_reserve(mut r.rooms, 1) ?=> |c| Capacity(c)
    list.push(mut r.rooms, Room(id: room, limits: limits, suspended: false, ids: take ids, fenced: take fences, heard: false, tick: 0, top: list.new()))
    Ok(())
}

fn admit(mut r: Router, who: peer.Participant, home: u16) -> Result[(), RouterError] {
    if home >= UNITS_MAX {
        return Error(Limit(int.widen(UNITS_MAX)))
    }
    let Some(ri) = room_at(r, who.room) else {
        return Error(NoRoom)
    }
    if r.rooms[ri].suspended {
        return Error(Suspended)
    }
    let Gen(id: id, epoch: epoch) = who.gen
    let entry = entry_of(r, ri, id)
    for s in r.roster {
        if s.who.room == who.room {
            let Gen(id: other, epoch: _) = s.who.gen
            if other == id {
                return Error(Exists)
            }
        }
    }
    if let Some(e) = entry {
        if let Some(f) = r.rooms[ri].fenced[e] {
            if epoch <= f {
                return Error(Fenced)
            }
        }
    }
    let mut present = 0u64
    for s in r.roster {
        if s.who.room == who.room {
            present += 1
        }
    }
    if present >= int.widen(r.rooms[ri].limits.participants) {
        return Error(Limit(int.widen(r.rooms[ri].limits.participants)))
    }
    if entry == None && list.len(r.rooms[ri].ids) >= int.widen(r.rooms[ri].limits.ids) {
        return Error(Limit(int.widen(r.rooms[ri].limits.ids)))
    }
    // The home unit holds the session, parked since it was opened there.
    let local = home == r.unit
    let mut parked: Option[u64] = None
    for i in 0u64 .. list.len(r.parked) {
        if r.parked[i].who.room == who.room && r.parked[i].who.gen == who.gen {
            parked = Some(i)
        }
    }
    if local && parked == None {
        return Error(NoParticipant)
    }
    list.try_reserve(mut r.roster, 1) ?=> |c| Capacity(c)
    list.try_reserve(mut r.members, 1) ?=> |c| Capacity(c)
    list.try_reserve(mut r.rows, 1) ?=> |c| Capacity(c)
    if entry == None {
        list.push(mut r.rooms[ri].ids, id)
        list.push(mut r.rooms[ri].fenced, None)
    }
    list.push(mut r.roster, Seat(who: who, home: home, publications: 0, downs: 0))
    if local {
        if let Some(i) = parked {
            let m = list.remove(mut r.parked, i)
            if let Some(at) = peer.selected(m.session) {
                list.push(mut r.rows, Row(from: at, room: who.room, who: who.gen))
            }
            list.push(mut r.members, take m)
        }
    }
    Ok(())
}

fn first_format(a: sdp.Agreed) -> Option[sdp.Format] {
    for f in a.formats {
        if f.codec != Rtx && f.codec != Red && f.codec != Ulpfec {
            return Some(clone(f))
        }
    }
    None
}

fn ring(rtx_bytes: u64) -> Result[Ring, RouterError] {
    let n = rtx_bytes / RING_SLOT
    let mut slots: List[Bytes] = list.new()
    let mut handles: List[u64] = list.new()
    list.try_reserve(mut slots, n) ?=> |c| Capacity(c)
    list.try_reserve(mut handles, n) ?=> |c| Capacity(c)
    for _ in 0u64 .. n {
        let mut b: Bytes = list.new()
        list.try_reserve(mut b, RING_SLOT) ?=> |c| Capacity(c)
        list.push(mut slots, take b)
        list.push(mut handles, NO_HANDLE)
    }
    Ok(Ring(slots: take slots, handles: take handles))
}

// The home unit reads the shape from the agreement and reserves the ring; every
// other unit takes the shape it was given and keeps no ring.
fn add_publication(mut r: Router, room: peer.RoomId, who: peer.Gen, section: u8, id: PublicationId, given: Option[Shape]) -> Result[Shape, RouterError] {
    let Some(ri) = room_at(r, room) else {
        return Error(NoRoom)
    }
    let Some(si) = seat_at(r, room, who) else {
        return Error(NoParticipant)
    }
    let limit = r.rooms[ri].limits.publications
    if r.roster[si].publications >= limit {
        return Error(Limit(int.widen(limit)))
    }
    for p in r.publications {
        if p.room == room && p.owner == who && p.section == section {
            return Error(Exists)
        }
    }
    let home = r.roster[si].home
    let mut clock = 0u32
    let (shape, held) = if home == r.unit {
        let Some(mi) = member_at(r, room, who) else {
            return Error(NoParticipant)
        }
        let Some(a) = peer.agreement(r.members[mi].session, section) else {
            return Error(Peer(Sdp(AnswerMismatch(section))))
        }
        if !a.recv {
            return Error(Peer(Sdp(AnswerMismatch(section))))
        }
        let Some(f) = first_format(a) else {
            return Error(Peer(Sdp(AnswerMismatch(section))))
        }
        let count = if list.len(a.streams) == 0 {
            1u64
        } else {
            list.len(a.streams)
        }
        clock = f.clock
        let g = ring(peer.session_limits(r.members[mi].session).rtx_bytes)?
        (Shape(codec: f.codec, pli: f.pli, fir: f.fir, encodings: int.narrow(count)), g)
    } else {
        let Some(sh) = given else {
            return Error(NoPublication)
        }
        (sh, Ring(slots: list.new(), handles: list.new()))
    }
    let mut encodings: List[Encoding] = list.new()
    list.try_reserve(mut encodings, ENCODINGS_MAX) ?=> |c| Capacity(c)
    for _ in 0u8 .. shape.encodings {
        // Every encoding starts published: the publisher sends all of them until a
        // mask says otherwise (RTC-6).
        list.push(mut encodings, Encoding(ssrc: 0, keyframes: rtp.loss.keyframes(shape.fir, MIN_INTERVAL_NS), interval: MIN_INTERVAL_NS, vp9: media_bits.unit.vp9_layers(), rate: 0, counted: 0, planned: 0, idle: false, wanting: 0, on: true, since: None, structure: media_bits.dependency.empty(), structure_frame: None, last: None, last_ts: 0, last_marker: false))
    }
    let depth = if shape.codec == Opus {
        rtp.red.MAX_DISTANCE
    } else {
        0u8
    }
    let red = rtp.red.ring(depth) ?=> |c| Capacity(c)
    list.try_reserve(mut r.publications, 1) ?=> |c| Capacity(c)
    list.push(mut r.publications, Publication(id: id, owner: who, home: home, room: room, section: section, codec: shape.codec, pli: shape.pli, fir: shape.fir, encodings: take encodings, ring: take held, red: take red, local: 0, clock: clock, window: None, voice: quiet(), dropped: 0, orientation: None))
    r.roster[si].publications += 1
    Ok(shape)
}

// RTP-11's source key of encoding `e` of publication index `pi`.
fn source(p: PublicationId, e: u8) -> u32 {
    let PublicationId(n) = p
    let wide: u64 = int.widen(e)
    int.truncate(n * ENCODINGS_MAX + wide)
}

/// RTC-6's stable target map: `i = t` clamped to 3 for VP8, `i = 4s + t` with each
/// clamped to 3 for VP9, 0 for H.264 without SVC and for audio, and for AV1 the
/// decode target of encoding `e`'s structure that `av1_target` picks. VP8's and VP9's
/// never depend on the layers seen. None is an AV1 target the structure cannot represent.
fn rewrite_target(p: Publication, t: Target) -> Option[rtp.rewrite.Target] {
    match t {
        Off => Some(Off),
        Layer(encoding: e, spatial: sid, temporal: tid) => {
            if p.codec == Av1 {
                let n: u64 = int.widen(e)
                let i = av1_target(view p.encodings[n].structure, sid, tid)?
                return Some(Layer(source: source(p.id, e), target: i))
            }
            let top_t = if tid > 3 {
                3u8
            } else {
                tid
            }
            let top_s = if sid > 3 {
                3u8
            } else {
                sid
            }
            let i = match p.codec {
                Vp8 => top_t,
                Vp9 => 4 * top_s + top_t,
                _ => 0u8,
            }
            Some(Layer(source: source(p.id, e), target: i))
        },
    }
}

/// RTC-6's AV1 map: the decode target `d` whose `(S_d, T_d)` (the highest spatial and
/// temporal ids over the templates that do not mark `d` Not Present) is `(s, t)`, or
/// else the one whose pair is the greatest at or below `(s, t)` in both coordinates.
/// None when two decode targets share a pair or no single greatest pair exists. Before
/// the source's first structure there is no map yet: the target is 0, and the router
/// maps it again at the keyframe that brings the structure.
fn av1_target(structure: View[media_bits.dependency.Structure], s: u8, t: u8) -> Option[u8] {
    let mut spatial: Inline[u8, 32] =[0; 32]
    let mut temporal: Inline[u8, 32] =[0; 32]
    let mut n = 0u64
    while n < 32 {
        let Some((sd, td)) = media_bits.dependency.target_layers(structure, n) else {
            break
        }
        for d in 0u64 .. n {
            if spatial[d] == sd && temporal[d] == td {
                return None
            }
        }
        spatial[n] = sd
        temporal[n] = td
        n += 1
    }
    if n == 0 {
        return Some(0)
    }
    let mut any = false
    let mut top_s: u8 = 0
    let mut top_t: u8 = 0
    for d in 0u64 .. n {
        if spatial[d] <= s && temporal[d] <= t {
            any = true
            top_s = order.max(top_s, spatial[d])
            top_t = order.max(top_t, temporal[d])
        }
    }
    if !any {
        return None
    }
    for d in 0u64 .. n {
        if spatial[d] == top_s && temporal[d] == top_t {
            return Some(int.narrow(d))
        }
    }
    None
}

fn add_down(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId, section: u8, target: Target, now: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Some(ri) = room_at(r, room) else {
        return Error(NoRoom)
    }
    if r.rooms[ri].suspended {
        return Error(Suspended)
    }
    let Some(si) = seat_at(r, room, who) else {
        return Error(NoParticipant)
    }
    let Some(_) = publication_at(r, room, p) else {
        return Error(NoPublication)
    }
    if let Some(_) = down_at(r, room, who, p) {
        return Error(Exists)
    }
    let limit = r.rooms[ri].limits.down_tracks
    if r.roster[si].downs >= limit {
        return Error(Limit(limit))
    }
    let home = r.roster[si].home
    let track = if home == r.unit {
        let Some(mi) = member_at(r, room, who) else {
            return Error(NoParticipant)
        }
        let mut b: Bytes = list.with_capacity(6)
        host.random(r.random, mut b)
        let first_seq: u16 = list.word_be(b, 0)
        let first_ts: u32 = list.word_be(b, 2)
        peer.add_track(mut r.members[mi].session, section, first_seq, first_ts) ?=> |take e| Peer(e)
    } else {
        0u16
    }
    list.try_reserve(mut r.downs, 1) ?=> |c| Capacity(c)
    list.push(mut r.downs, Down(sub: who, home: home, room: room, publication: p, section: section, track: track, target: Off, effective: Off, held: false, sets: media_bits.unit.parameter_sets(), sets_source: None, previous: None, chains: media_bits.unit.av1_chains(), next_chains: media_bits.unit.av1_chains()))
    r.roster[si].downs += 1
    retarget(mut r, room, who, p, target, now, mut out)
}

fn retarget(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId, target: Target, now: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    if suspended(r, room) {
        return Error(Suspended)
    }
    let Some(di) = down_at(r, room, who, p) else {
        return Error(NoPublication)
    }
    let Some(pi) = publication_at(r, room, p) else {
        return Error(NoPublication)
    }
    if let Layer(encoding: e, spatial: _, temporal: _) = target {
        let n: u64 = int.widen(e)
        if n >= list.len(r.publications[pi].encodings) {
            return Error(Limit(int.narrow(list.len(r.publications[pi].encodings))))
        }
    }
    // An AV1 target the encoding's structure cannot represent is refused, and the
    // down-track keeps its target (RTC-6).
    if r.downs[di].home == r.unit {
        if let None = rewrite_target(r.publications[pi], target) {
            r.counts.refused += 1
            return Error(Unrepresentable)
        }
    }
    let old = r.downs[di].target
    r.downs[di].target = target
    if r.downs[di].home != r.unit {
        return Ok(())
    }
    let Some(mi) = member_at(r, room, who) else {
        return Error(NoParticipant)
    }
    // RTC-6: the subscriber's allocation decides what the rewrite is pointed at.
    if let Error(e) = allocate(mut r, mi, Some(di), now, mut out) {
        r.downs[di].target = old
        let _ = allocate(mut r, mi, None, now, mut out)
        return Error(e)
    }
    Ok(())
}

// RTC-6: a new AV1 structure maps again the target of each local down-track on encoding
// `encoding` of publication `pi`. A target the structure cannot represent is refused
// and counted, and the down-track keeps its current target.
fn remap(mut r: Router, pi: u64, encoding: u8) {
    let room = r.publications[pi].room
    let id = r.publications[pi].id
    for d in 0u64 .. list.len(r.downs) {
        if r.downs[d].room != room || r.downs[d].publication != id || r.downs[d].home != r.unit {
            continue
        }
        if r.downs[d].held {
            continue
        }
        if let Layer(encoding: e, spatial: _, temporal: _) = r.downs[d].effective {
            if e != encoding {
                continue
            }
            let Some(si) = member_at(r, room, r.downs[d].sub) else {
                continue
            }
            let Some(t) = rewrite_target(r.publications[pi], r.downs[d].effective) else {
                r.counts.refused += 1
                continue
            }
            if let Error(_) = peer.set_target(mut r.members[si].session, r.downs[d].track, t) {
                r.counts.refused += 1
            }
        }
    }
}

fn move_down(mut r: Router, room: peer.RoomId, who: peer.Gen, from: PublicationId, to: PublicationId, target: Target, now: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Some(di) = down_at(r, room, who, from) else {
        return Error(NoPublication)
    }
    let Some(pi) = publication_at(r, room, to) else {
        return Error(NoPublication)
    }
    let Some(_) = seat_at(r, room, who) else {
        return Error(NoParticipant)
    }
    if let Some(_) = down_at(r, room, who, to) {
        return Error(Exists)
    }
    if r.downs[di].home == r.unit {
        let Some(mi) = member_at(r, room, who) else {
            return Error(NoParticipant)
        }
        let section = r.downs[di].section
        let Some(a) = peer.agreement(r.members[mi].session, section) else {
            return Error(Peer(Sdp(AnswerMismatch(section))))
        }
        let mut carried = false
        for f in a.formats {
            if f.codec == r.publications[pi].codec {
                carried = true
            }
        }
        if !carried {
            return Error(Peer(Sdp(AnswerMismatch(section))))
        }
    }
    // The publication the track forwards now keeps forwarding until the switch;
    // a second rebind while one waits replaces only the pending side, and a rebind
    // back to the forwarding publication cancels the wait.
    if r.downs[di].previous == Some(to) {
        r.downs[di].previous = None
    } else if r.downs[di].previous == None {
        r.downs[di].previous = Some(from)
    }
    r.downs[di].publication = to
    r.downs[di].next_chains = media_bits.unit.av1_chains()
    retarget(mut r, room, who, to, target, now, mut out)
}

// The switch to the rebound publication happened, or no longer waits: its AV1
// chains become the leg's, and the old publication stops reaching the track.
fn settle(mut r: Router, d: u64) {
    if r.downs[d].previous == None {
        return
    }
    r.downs[d].previous = None
    r.downs[d].chains = r.downs[d].next_chains
    r.downs[d].next_chains = media_bits.unit.av1_chains()
}

// Take down-track `d` out: its track ends on its home unit (`end_track`), and its
// subscriber's count drops.
fn end_down(mut r: Router, d: u64) {
    let room = r.downs[d].room
    let sub = r.downs[d].sub
    if r.downs[d].home == r.unit {
        if let Some(mi) = member_at(r, room, sub) {
            peer.end_track(mut r.members[mi].session, r.downs[d].track)
        }
    }
    if let Some(si) = seat_at(r, room, sub) {
        r.roster[si].downs -= 1
    }
    let _ = list.remove(mut r.downs, d)
    r.moved = true
}

fn remove_down(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId) -> Result[(), RouterError] {
    let Some(di) = down_at(r, room, who, p) else {
        return Error(NoPublication)
    }
    let Some(_) = seat_at(r, room, who) else {
        return Error(NoParticipant)
    }
    end_down(mut r, di)
    Ok(())
}

// ---- Readers ----
/// The media and RTX SSRCs of `who`'s down-track of a publication, on its home unit.
pub fn track_ssrcs(r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId) -> Option[(u32, u32)] {
    let di = down_at(r, room, who, p)?
    let mi = member_at(r, room, who)?
    peer.track_ssrcs(r.members[mi].session, r.downs[di].track)
}

pub fn session_drops(r: Router, room: peer.RoomId, who: peer.Gen) -> Option[peer.Drops] {
    let mi = member_at(r, room, who)?
    Some(peer.drops(r.members[mi].session))
}

pub fn control_ssrc(r: Router, room: peer.RoomId, who: peer.Gen) -> Option[u32] {
    let mi = member_at(r, room, who)?
    Some(peer.control_ssrc(r.members[mi].session))
}

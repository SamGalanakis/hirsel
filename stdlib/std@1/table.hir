/// An inert name and expected schema; authority comes from each operation's Tx.
pub opaque type Table[K: key + serializable, V: serializable]: copyable + data + key + inert + sendable uses {} {
  spelling: Inline[u8, 255],
  length: u64,
}

@serializable
pub type SchemaChange = Created | Renamed(String, String) | Migrated(EntryId)

@serializable
pub type SchemaEntry {
  epoch: u32,
  key_schema: String,
  value_schema: String,
  change: SchemaChange,
}

/// Why `table.migrate` returned without migrating; the table is unchanged.
@serializable
pub type MigrateError[E] = Failed(E) | Faulted(Failure) | Collision | Table(store.TxError) | Canceled(
  CancelCause
)

/// Names a table without opening or creating it. Operations validate its name.
pub fn named[K: key + serializable, V: serializable](name: String) -> Table[K, V] uses {} {
  let raw = string.as_bytes(name)
  let n = bytes.len(raw)
  let mut spelling: Inline[u8, 255] = [0u8; 255]
  if n <= 255 {
    let mut i: u64 = 0
    while i < n {
      spelling[i] = raw[i]
      i += 1
    }
  }
  Table(spelling: take spelling, length: n)
}

fn table_name[K: key + serializable, V: serializable](t: Table[K, V]) -> String uses {} {
  if t.length > 255 {
    return ""
  }
  let mut raw: List[u8] = []
  let mut i: u64 = 0
  while i < t.length {
    list.push(mut raw, t.spelling[i])
    i += 1
  }
  match string.from_bytes(bytes.from_list(take raw)) {
    Ok(name) => take name,
    Error(_) => "",
  }
}

// A table's immutable epoch descriptors and declarations. Row values hold only
// their epoch (u32 little endian) and canonical payload. No loaded constructor.
@serializable
type Epoch {
  key: Bytes,
  value: Bytes,
  change: SchemaChange,
}

// A live epoch's storage descriptors: what the history row of an epoch since
// the last creation or migration gives a row operation whose types are not
// the catalog's.
type Schemas {
  key: Bytes,
  value: Bytes,
}

// A table's catalog entry, all that a row operation reads when its types are
// the table's: a fixed 73-byte record, read without the codec. It holds the
// SHA-256 digests of the current key and value storage descriptors
// (`codec.descriptor_digest`), the generation the rows live under, and the
// live epochs: `count` of them from `base`, the creation or migration that
// wrote the current generation, and the renames declared since. Rows name
// only live epochs. The descriptors and renames are in the history rows.
// `Catalog` is the record after its digests, which an operation compares in
// place and never keeps.
type Catalog {
  generation: u8,
  base: u64,
  count: u64,
}

const DIGEST: u64 = 32
const RECORD: u64 = 73

fn encode_catalog(key: Bytes, value: Bytes, c: Catalog) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, key)
  bytes.append(mut out, value)
  list.push(mut out, c.generation)
  internal.table_schema.little(mut out, c.base, 4)
  internal.table_schema.little(mut out, c.count, 4)
  bytes.from_list(take out)
}

fn read_u32(raw: Bytes, at: u64) -> u64 uses {} {
  let mut n: u64 = 0
  let mut i: u64 = 0
  while i < 4 {
    let byte: u64 = int.widen(raw[at + i])
    n = n | byte << i * 8
    i += 1
  }
  n
}

// The digests of `t`'s key and value storage descriptors: static data.
fn digests[K: key + serializable, V: serializable](t: Table[K, V]) -> (Bytes, Bytes) uses {} {
  let k: Option[K] = None()
  let v: Option[V] = None()
  (codec.descriptor_digest(k), codec.descriptor_digest(v))
}

// The storage descriptors of `t`'s key and value types: static data.
fn descriptors[K: key + serializable, V: serializable](t: Table[K, V]) -> Schemas uses {} {
  let k: Option[K] = None()
  let v: Option[V] = None()
  Schemas(key: codec.descriptor(k), value: codec.descriptor(v))
}

// What a row operation knows of its table once the schemas are checked. Its
// rows are `plain`, the codec's own encodings of the caller's types, when the
// catalog's digests are the caller's: a rename changes names, never a
// payload. Otherwise `key` is the stored key descriptor (the base epoch's),
// `epochs` the live epochs' descriptors and `renames` those declared since,
// read from the history rows. `rows` is the key prefix of the generation's
// rows.
type Open {
  rows: Bytes,
  generation: u8,
  base: u64,
  count: u64,
  plain: bool,
  key: Bytes,
  epochs: List[Schemas],
  renames: List[(String, String)],
}

fn corrupt() -> store.TxError uses {} {
  let error: store.StoreError = Corrupt("typed table")
  Storage(take error)
}

fn valid(name: String) -> bool uses {} {
  let raw = string.as_bytes(name)
  if bytes.len(raw) == 0 || bytes.len(raw) > 255 || string.starts_with(name, "hirsel.") {
    return false
  }
  for byte in raw {
    if byte == 0 {
      return false
    }
  }
  true
}

fn metadata_key(name: String) -> Bytes uses {} {
  catalog_key(keys.encode(name))
}

// The catalog key of the table whose name has the key encoding `encoded`.
fn catalog_key(encoded: Bytes) -> Bytes uses {} {
  concat(b"hirsel.tables/", encoded)
}

// The table's history rows, one per epoch under the catalog key, a zero byte
// and the epoch as u32 big endian: read only by `history`, written by create,
// rename and a migration's install, and deleted as garbage by `drop`.
fn history_rows(name: String) -> Bytes uses {} {
  concat(metadata_key(name), b"\x00")
}

fn history_key(name: String, epoch: u64) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, history_rows(name))
  let mut i: u64 = 4
  while i > 0 {
    i -= 1
    list.push(mut out, int.truncate(epoch >> i * 8 & 255))
  }
  bytes.from_list(take out)
}

// The catalog entry and the history rows, the keys `scope` and `scope_keys`
// give a table besides its rows.
fn catalog_span(name: String, access: store.Access) -> store.KeyScope uses {} {
  store.interval(metadata_key(name), keys.prefix_end(history_rows(name)), access)
}

// Appends epoch `n` to the history rows.
fn record(mut tx: store.Tx, name: String, n: u64, e: Epoch) -> Result[(), store.TxError] {
  store.table_put(mut tx, history_key(name, n), codec.encode(e))
}

// Every generation of a table's rows.
fn table_rows(name: String) -> Bytes uses {} {
  concat(b"hirsel.rows/", keys.encode(name))
}

// One generation of a table's rows: the table's name, then the generation as
// one byte, then each row's encoded key. A migration writes the next
// generation, (g + 1) mod 256, and installs it by naming it in the catalog;
// the replaced or abandoned one is deleted before the operation returns, or by
// the next open, so no table holds rows under more than two.
fn rows_of(name: String, generation: u8) -> Bytes uses {} {
  generation_rows(keys.encode(name), generation)
}

fn generation_rows(encoded: Bytes, generation: u8) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, b"hirsel.rows/")
  bytes.append(mut out, encoded)
  list.push(mut out, generation)
  bytes.from_list(take out)
}

fn next_generation(g: u8) -> u8 uses {} {
  if g == 255 {
    0
  } else {
    g + 1
  }
}

fn concat(prefix: Bytes, suffix: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  list.reserve(mut out, bytes.len(prefix) + bytes.len(suffix))
  bytes.append(mut out, prefix)
  bytes.append(mut out, suffix)
  bytes.from_list(take out)
}

fn load_catalog(tx: store.Tx, name: String) -> Result[Catalog, store.TxError] {
  if !valid(name) {
    return Error(InvalidInput())
  }
  let (c, _) = read_catalog(tx, metadata_key(name), b"", b"")?
  Ok(c)
}

// The catalog record under `key`, and whether its digests are `key_digest`
// and `value_digest`, compared in the read view.
fn read_catalog(tx: store.Tx, take key: Bytes, key_digest: Bytes, value_digest: Bytes) -> Result[
  (Catalog, bool),
  store.TxError
] {
  let raw = match store.table_read(tx, take key)? {
    Some(raw) => raw,
    None() => return Error(NoTable()),
  }
  if bytes.len(raw) != RECORD {
    return Error(corrupt())
  }
  let count = read_u32(raw, 2 * DIGEST + 5)
  if count == 0 {
    return Error(corrupt())
  }
  let current = bytes.slice(raw, 0, DIGEST) == key_digest && bytes.slice(raw, DIGEST, 2 * DIGEST) == value_digest
  let c = Catalog(generation: raw[2 * DIGEST], base: read_u32(raw, 2 * DIGEST + 1), count: count)
  Ok((take c, current))
}

// The epoch the next schema change appends.
fn next_epoch(c: Catalog) -> u64 uses {} {
  c.base + c.count
}

fn digest_bytes(data: Bytes) -> Bytes uses {} {
  let d = sha256.digest(data)
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < DIGEST {
    list.push(mut out, d[i])
    i += 1
  }
  bytes.from_list(take out)
}

// The live epochs' descriptors and the renames declared since the base, from
// the history rows.
fn live(tx: store.Tx, name: String, c: Catalog) -> Result[
  (List[Schemas], List[(String, String)]),
  store.TxError
] {
  let mut epochs: List[Schemas] = []
  let mut renames: List[(String, String)] = []
  let mut n = c.base
  while n < next_epoch(c) {
    let key = history_key(name, n)
    let raw = match store.table_read(tx, take key)? {
      Some(raw) => raw,
      None() => return Error(corrupt()),
    }
    let decoded: Result[Epoch, DecodeError] = codec.decode(raw)
    let epoch = match take decoded {
      Ok(e) => e,
      Error(_) => return Error(corrupt()),
    }
    if let Renamed(from, to) = epoch.change {
      list.push(mut renames, (unique from, unique to))
    }
    list.push(mut epochs, Schemas(key: unique epoch.key, value: unique epoch.value))
    n += 1
  }
  Ok((take epochs, take renames))
}

// Whether the latest live epoch `latest` admits the descriptors `mine`.
fn admits(latest: Schemas, mine: Schemas) -> Result[(), store.TxError] uses {} {
  match internal.table_schema.equivalent(latest.key, mine.key, [], true) {
    Ok(()) => (),
    Error(e) => match e {
      Renamed(from, to) => return Error(Schema(Renamed(unique from, unique to))),
      _ => return Error(Schema(KeyMismatch())),
    },
  }
  internal.table_schema.equivalent(latest.value, mine.value, [], false) ? Schema
  Ok(())
}

// The table `t` names once its schemas are checked against `t`'s types: one
// read of the catalog entry when its digests are theirs, and of the live
// history rows besides when they are not.
fn opened[K: key + serializable, V: serializable](tx: store.Tx, t: Table[K, V]) -> Result[
  (Catalog, Open),
  store.TxError
] {
  let name = table_name(t)
  if !valid(name) {
    return Error(InvalidInput())
  }
  let encoded = keys.encode(name)
  let (key, value) = digests(t)
  let (c, current) = read_catalog(tx, catalog_key(encoded), key, value)?
  let rows = generation_rows(encoded, c.generation)
  if current {
    let o = Open(
      rows: take rows,
      generation: c.generation,
      base: c.base,
      count: c.count,
      plain: true,
      key: descriptors(t).key,
      epochs: [],
      renames: []
    )
    return Ok((take c, take o))
  }
  let (epochs, renames) = live(tx, name, c)?
  admits(unique epochs[list.len(epochs) - 1], descriptors(t))?
  let o = Open(
    rows: take rows,
    generation: c.generation,
    base: c.base,
    count: c.count,
    plain: false,
    key: unique epochs[0].key,
    epochs: take epochs,
    renames: take renames
  )
  Ok((take c, take o))
}

// Checks that a table's key prefix `rows`, a generation or the history rows,
// holds nothing before it is written: a generation number is reused after a
// wrap, a discard or a drop, and a name after a drop, only once its earlier
// life is deleted (STORE-9). Garbage left of that life refuses as corruption,
// so no write lands among stale rows.
fn unused(tx: store.Tx, take rows: Bytes) -> Result[(), store.TxError] {
  let pending = store.garbage(copy rows)
  if let Some(_) = store.table_read(tx, take pending)? {
    return Error(reused())
  }
  let left = store.table_range(
    tx,
    copy rows,
    keys.prefix_end(rows),
    1,
    Ascending(),
    false,
    fn(take seen: bool, key: Bytes, value: Bytes) -> (bool, bool) {
      (true, false)
    }
  )?
  if left {
    return Error(reused())
  }
  Ok(())
}

fn reused() -> store.TxError uses {} {
  let error: store.StoreError = Corrupt("typed table generation still holds rows")
  Storage(take error)
}

fn save(mut tx: store.Tx, name: String, key: Bytes, value: Bytes, c: Catalog) -> Result[
  (),
  store.TxError
] {
  store.table_put(mut tx, metadata_key(name), encode_catalog(key, value, c))
}

/// Creates an empty table with one schema entry; creation is explicit.
pub fn create[K: key + serializable, V: serializable](mut tx: store.Tx, t: Table[K, V]) -> Result[
  (),
  store.TxError
] {
  if !valid(table_name(t)) {
    return Error(InvalidInput())
  }
  let catalog = metadata_key(table_name(t))
  store.admit_write(tx, catalog)?
  if let Some(_) = store.table_read(tx, take catalog)? {
    return Error(TableExists())
  }
  let name = table_name(t)
  unused(tx, take rows_of(name, 0))?
  unused(tx, take history_rows(name))?
  let d = descriptors(t)
  record(mut tx, name, 0, Epoch(key: unique d.key, value: unique d.value, change: Created()))?
  let (key, value) = digests(t)
  save(mut tx, name, key, value, Catalog(generation: 0, base: 0, count: 1))
}

// `key`'s encoding under the stored key schema `schema`, the codec's own when
// the rows are `plain`.
fn encoded_key[K: key + serializable](
  schema: Bytes,
  key: K,
  renames: List[(String, String)],
  plain: bool
) -> Result[Bytes, store.TxError] uses {} {
  if plain {
    return Ok(keys.encode(key))
  }
  let data = match internal.table_schema.encode(schema, key, renames) {
    Ok(data) => data,
    Error(_) => return Error(corrupt()),
  }
  Ok(keys.encode_payload(schema, data))
}

fn row_key[K: key + serializable](o: Open, key: K) -> Result[Bytes, store.TxError] uses {} {
  // Metadata renames do not rewrite keys, so the physical key schema stays at
  // the generation's epoch until a migration atomically installs a new one.
  let mut out: List[u8] = []
  list.reserve(mut out, bytes.len(o.rows) + 16)
  bytes.append(mut out, o.rows)
  if o.plain {
    keys.encode_into(key, mut out)
  } else {
    bytes.append(mut out, encoded_key(o.key, key, o.renames, false)?)
  }
  Ok(bytes.from_list(take out))
}

// A row's stored value: the epoch `n`, then `value`'s payload under the
// value schema `schema`, the codec's own when the rows are `plain`.
fn row_value[V: serializable](n: u64, schema: Bytes, value: V, plain: bool) -> Result[
  Bytes,
  store.TxError
] uses {} {
  let mut out: List[u8] = []
  internal.table_schema.little(mut out, n, 4)
  if plain {
    bytes.append(mut out, codec.encode_payload(value))
  } else {
    let data = match internal.table_schema.encode(schema, value, []) {
      Ok(data) => data,
      Error(_) => return Error(corrupt()),
    }
    bytes.append(mut out, data)
  }
  Ok(bytes.from_list(take out))
}

// The value whose codec payload is `payload`.
fn from_payload[T: serializable](payload: Bytes) -> Result[T, DecodeError] uses {} {
  let none: Option[T] = None()
  codec.decode_payload(none, payload)
}

// The value a stored row value holds.
fn decode_value[V: serializable](o: Open, data: Bytes) -> Result[V, store.TxError] uses {} {
  if bytes.len(data) < 4 {
    return Error(corrupt())
  }
  let n = read_u32(data, 0)
  if n < o.base || n >= o.base + o.count {
    return Error(corrupt())
  }
  let payload = bytes.slice(data, 4, bytes.len(data))
  let value: Result[V, DecodeError] = if o.plain {
    from_payload(payload)
  } else {
    internal.table_schema.decode(o.epochs[n - o.base].value, payload, o.renames)
  }
  match take value {
    Ok(v) => Ok(take v),
    // A row past the codec's decode budgets is a value this run will not hold.
    Error(Limit()) => Error(Limit(ValueBytes())),
    Error(_) => Error(corrupt()),
  }
}

/// Returns a fresh value, or None when this transaction sees no row.
pub fn get[K: key + serializable, V: serializable](tx: store.Tx, t: Table[K, V], key: K) -> Result[
  Option[V],
  store.TxError
] {
  let (_, o) = opened(tx, t)?
  let encoded = row_key(o, key)?
  match store.table_read(tx, take encoded)? {
    Some(data) => {
      let value: V = decode_value(o, data)?
      Ok(Some(take value))
    },
    None() => Ok(None()),
  }
}

/// Inserts or replaces one row in the transaction's write set.
pub fn put[K: key + serializable, V: serializable](
  mut tx: store.Tx,
  t: Table[K, V],
  key: K,
  value: V
) -> Result[(), store.TxError] {
  let (c, o) = opened(tx, t)?
  let latest = if o.plain {
    b""
  } else {
    unique o.epochs[o.count - 1].value
  }
  let physical_key = row_key(o, key)?
  let encoded_value = row_value(next_epoch(c) - 1, latest, value, o.plain)?
  store.table_put(mut tx, take physical_key, take encoded_value)
}

/// Deletes one row and reports whether it existed in this transaction.
pub fn delete[K: key + serializable, V: serializable](
  mut tx: store.Tx,
  t: Table[K, V],
  key: K
) -> Result[bool, store.TxError] {
  let (_, o) = opened(tx, t)?
  let encoded = row_key(o, key)?
  store.admit_write(tx, encoded)?
  let exists = match store.table_read(tx, copy encoded)? {
    Some(_) => true,
    None() => false,
  }
  if exists {
    store.table_delete(mut tx, take encoded)?
  }
  Ok(exists)
}

// The least row key of `t`'s rows a lower bound admits.
fn lower[K: key + serializable](
  schema: Bytes,
  prefix: Bytes,
  renames: List[(String, String)],
  plain: bool,
  b: store.RangeBound[K]
) -> Result[Bytes, store.TxError] uses {} {
  match b {
    Included(key) => Ok(concat(prefix, encoded_key(schema, key, renames, plain)?)),
    Excluded(key) => Ok(successor(concat(prefix, encoded_key(schema, key, renames, plain)?))),
    Unbounded() => Ok(unique prefix),
  }
}

// The least row key above every key an upper bound admits; `None()` for none.
fn upper[K: key + serializable](
  schema: Bytes,
  prefix: Bytes,
  renames: List[(String, String)],
  plain: bool,
  b: store.RangeBound[K]
) -> Result[Option[Bytes], store.TxError] uses {} {
  match b {
    Included(key) => Ok(Some(successor(concat(prefix, encoded_key(schema, key, renames, plain)?)))),
    Excluded(key) => Ok(Some(concat(prefix, encoded_key(schema, key, renames, plain)?))),
    Unbounded() => Ok(keys.prefix_end(prefix)),
  }
}

// How a range reads its rows' keys: the stored key schema, parsed once, and
// its renames.
type KeyReader {
  schema: Bytes,
  parsed: keys.Envelope,
  renames: List[(String, String)],
  plain: bool,
}

fn key_reader(o: Open) -> KeyReader uses {} {
  KeyReader(
    parsed: keys.key_schema(o.key),
    schema: unique o.key,
    renames: unique o.renames,
    plain: o.plain
  )
}

// The key a row key's encoded part `raw` holds.
fn decode_key[K: key + serializable](r: KeyReader, raw: Bytes) -> Result[K, store.TxError] uses {} {
  let payload = match keys.decode_payload(r.parsed, raw) {
    Ok(p) => p,
    Error(_) => return Error(corrupt()),
  }
  let key: Result[K, DecodeError] = if r.plain {
    from_payload(payload)
  } else {
    internal.table_schema.decode(r.schema, payload, r.renames)
  }
  match take key {
    Ok(k) => Ok(take k),
    Error(Limit()) => Error(Limit(KeyBytes())),
    Error(_) => Error(corrupt()),
  }
}

fn successor(k: Bytes) -> Bytes uses {} {
  concat(k, b"\x00")
}

/// Scans in key value order with inclusive/exclusive bounds and a positive limit.
pub fn range[K: key + serializable, V: serializable](
  tx: store.Tx,
  t: Table[K, V],
  from: store.RangeBound[K],
  to: store.RangeBound[K],
  limit: u64,
  order: store.ScanOrder
) -> Result[List[(K, V)], store.TxError] {
  if limit == 0 {
    return Error(InvalidInput())
  }
  let (_, o) = opened(tx, t)?
  let prefix = unique o.rows
  let low = lower(o.key, prefix, o.renames, o.plain, from)?
  let high = upper(o.key, prefix, o.renames, o.plain, to)?
  let reader = key_reader(o)
  // Each row is decoded from the transaction's state in place.
  let initial: Result[List[(K, V)], store.TxError] = Ok([])
  let rows = store.table_range(
    tx,
    take low,
    take high,
    limit,
    order,
    take initial,
    fn(take acc: Result[List[(K, V)], store.TxError], key: Bytes, value: Bytes) -> (
      Result[List[(K, V)], store.TxError],
      bool
    ) {
      let mut out = match take acc {
        Ok(out) => out,
        Error(e) => return (Error(e), false),
      }
      let decoded: Result[(K, V), store.TxError] = decode_row(reader, o, prefix, key, value)
      match take decoded {
        Ok(row) => {
          list.push(mut out, take row)
          (Ok(take out), true)
        },
        Error(e) => (Error(e), false),
      }
    }
  )?
  take rows
}

// One row of a table's key prefix `prefix`, decoded.
fn decode_row[K: key + serializable, V: serializable](
  reader: KeyReader,
  o: Open,
  prefix: Bytes,
  key: Bytes,
  value: Bytes
) -> Result[(K, V), store.TxError] uses {} {
  if bytes.len(key) < bytes.len(prefix) || bytes.slice(key, 0, bytes.len(prefix)) != prefix {
    return Error(corrupt())
  }
  let k: K = decode_key(reader, bytes.slice(key, bytes.len(prefix), bytes.len(key)))?
  Ok((take k, decode_value(o, value)?))
}

/// The whole table with `access`: its rows, its catalog entry, where the
/// library keeps its live schemas and renames, and its schema history rows,
/// and read only, the garbage records of its rows and history, which `create`
/// checks before reusing them. Every key it holds names this table, so a `Tx`
/// narrowed to it learns nothing of another. It reads nothing, so it serves a
/// table the body will create. An invalid name holds no key.
pub fn scope[K: key + serializable, V: serializable](t: Table[K, V], access: store.Access) -> store.KeyScope uses {} {
  let name = table_name(t)
  if !valid(name) {
    return store.interval(b"", Some(b""), access)
  }
  let prefix = table_rows(name)
  let pending = store.garbage(copy prefix)
  let stale = store.garbage(history_rows(name))
  let owned = store.join(store.interval(copy prefix, keys.prefix_end(prefix), access), catalog_span(name, access))
  let garbage = store.join(
    store.interval(copy pending, keys.prefix_end(pending), Read()),
    store.interval(copy stale, keys.prefix_end(stale), Read())
  )
  store.join(owned, garbage)
}

/// The rows whose keys lie between `from` and `to` with `access`, and the
/// table's catalog entry and history rows read only: enough for get, put, delete, range and
/// history on those rows, and not to create, drop or rename the table. It reads
/// the catalog through `tx` to encode the bounds and fails as `get` does.
pub fn scope_keys[K: key + serializable, V: serializable](
  tx: store.Tx,
  t: Table[K, V],
  from: store.RangeBound[K],
  to: store.RangeBound[K],
  access: store.Access
) -> Result[store.KeyScope, store.TxError] {
  let (_, o) = opened(tx, t)?
  let name = table_name(t)
  let prefix = unique o.rows
  let low = lower(o.key, prefix, o.renames, o.plain, from)?
  let high = upper(o.key, prefix, o.renames, o.plain, to)?
  Ok(store.join(store.interval(low, high, access), catalog_span(name, Read())))
}

/// Returns the immutable schema history; hashes exclude package version text.
pub fn history(tx: store.Tx, name: String) -> Result[List[SchemaEntry], store.TxError] {
  let c = load_catalog(tx, name)?
  // The history rows are the table's own namespace: `range_rows` does not
  // bound reading them, as it did not bound the catalog value they were.
  let prefix = history_rows(name)
  let end = keys.prefix_end(prefix)
  let initial: Result[List[SchemaEntry], store.TxError] = Ok([])
  let read = store.table_all(
    tx,
    take prefix,
    take end,
    false,
    take initial,
    fn(take acc: Result[List[SchemaEntry], store.TxError], key: Bytes, value: Bytes) -> (
      Result[List[SchemaEntry], store.TxError],
      bool
    ) {
      let mut out = match take acc {
        Ok(out) => out,
        Error(e) => return (Error(e), false),
      }
      let n = list.len(out)
      if key != history_key(name, n) {
        return (Error(corrupt()), false)
      }
      let decoded: Result[Epoch, DecodeError] = codec.decode(value)
      let epoch = match take decoded {
        Ok(e) => e,
        Error(_) => return (Error(corrupt()), false),
      }
      list.push(
        mut out,
        SchemaEntry(
          epoch: int.truncate(n),
          key_schema: sha256.digest_hex(epoch.key),
          value_schema: sha256.digest_hex(epoch.value),
          change: unique epoch.change
        )
      )
      (Ok(take out), true)
    }
  )?
  let out = read?
  if list.len(out) != next_epoch(c) {
    return Error(corrupt())
  }
  Ok(take out)
}

/// Declares a spelling change once, appending metadata without rewriting rows.
pub fn rename(mut tx: store.Tx, name: String, from: String, to: String) -> Result[
  (),
  store.TxError
] {
  if from == "" || to == "" || from == to {
    return Error(InvalidInput())
  }
  if !valid(name) {
    return Error(InvalidInput())
  }
  store.admit_write(tx, metadata_key(name))?
  let c = load_catalog(tx, name)?
  let (epochs, _) = live(tx, name, c)?
  let latest = unique epochs[list.len(epochs) - 1]
  let key = internal.table_schema.rename_schema(latest.key, from, to)
  let value = internal.table_schema.rename_schema(latest.value, from, to)
  let mut changed = false
  let next_key = match take key {
    Ok(k) => {
      changed = true
      k
    },
    Error(_) => unique latest.key,
  }
  let next_value = match take value {
    Ok(v) => {
      changed = true
      v
    },
    Error(_) => unique latest.value,
  }
  if !changed {
    return Error(InvalidInput())
  }
  let next = Catalog(generation: c.generation, base: c.base, count: c.count + 1)
  let key_digest = digest_bytes(next_key)
  let value_digest = digest_bytes(next_value)
  let epoch = Epoch(key: take next_key, value: take next_value, change: Renamed(unique from, unique to))
  record(mut tx, name, next_epoch(c), epoch)?
  save(mut tx, name, key_digest, value_digest, next)
}

/// Removes the table, its rows and its schema history: one transaction removes
/// its catalog entry, and its rows and history go in transactions that each fit the
/// store's limits, so a drop is bounded by no commit limit. A refusal is
/// `Aborted(e)`, with the error `e` of the table operations.
pub fn drop[K: key + serializable, V: serializable](mut s: store.Store, t: Table[K, V]) -> Result[
  (),
  store.TxFailure[store.TxError]
] {
  store.transact_body(
    mut s,
    fn(mut tx: store.Tx) -> Result[(), store.TxError] {
      let (c, _) = opened(tx, t)?
      let name = table_name(t)
      store.table_delete(mut tx, metadata_key(name))?
      store.table_put(mut tx, store.garbage(history_rows(name)), b"")?
      store.table_put(mut tx, store.garbage(rows_of(name, c.generation)), b"")
    }
  )?
  store.collect(mut s) ? Storage
  Ok(())
}

// A migration transaction's outcome as the migration's.
fn settled[R, E](take r: Result[R, store.TxFailure[MigrateError[E]]]) -> Result[
  R,
  MigrateError[E]
] uses {} {
  match take r {
    Ok(v) => Ok(take v),
    Error(Aborted(why)) => Error(take why),
    Error(Storage(e)) => Error(Table(Storage(take e))),
    Error(Unknown(e)) => Error(Table(Storage(take e))),
    Error(Limit(l)) => Error(Table(Limit(l))),
    Error(Canceled(cause)) => Error(Canceled(cause)),
    Error(Faulted(failure)) => Error(Faulted(take failure)),
  }
}

// The first transaction: finish at once, or begin.
type Start = Current | Begun(Catalog, Open)

// Records the next generation as garbage, so a migration that does not install
// leaves the table as it was, after a crash too: the catalog entry still names
// the current generation, and `collect` deletes the next one at the latest
// when the store next opens.
fn start[
  J: key + serializable,
  A: serializable,
  K: key + serializable,
  B: serializable,
  E: serializable
](mut tx: store.Tx, from: Table[J, A], to: Table[K, B]) -> Result[Start, MigrateError[E]] {
  if let Ok(_) = opened(tx, to) {
    return Ok(Current())
  }
  let (c, o) = opened(tx, from) ? Table
  let name = table_name(from)
  let generation = next_generation(c.generation)
  unused(tx, take rows_of(name, generation)) ? Table
  store.table_put(mut tx, store.garbage(rows_of(name, generation)), b"") ? Table
  Ok(Begun(take c, take o))
}

// How far a migration has come: the last source key migrated and the rows
// migrated so far.
type Progress {
  cursor: Option[Bytes],
  count: u64,
}

// Applies `f` to up to `batch` rows after the cursor, in key order, writing
// each result into the next generation under the target schema. Returns the
// advanced progress and whether rows may remain.
fn advance[
  J: key + serializable,
  A: serializable,
  K: key + serializable,
  B: serializable,
  E: serializable
](
  mut tx: store.Tx,
  name: String,
  catalog: Catalog,
  o: Open,
  f: Entry[fn(c: (), key: J, old: A) -> Result[(K, B), E]],
  p: Progress,
  batch: u64
) -> Result[(Progress, bool), MigrateError[E]] {
  let prefix = rows_of(name, catalog.generation)
  let low = match p.cursor {
    Some(last) => successor(last),
    None() => copy prefix,
  }
  let reader = key_reader(o)
  let next = rows_of(name, next_generation(catalog.generation))
  let epoch = next_epoch(catalog)
  // The source rows are rewritten as they are read in place, and written once
  // the read is over, since `tx` cannot be written while it is read: each
  // rewritten row with the source key it came from, then the first failure.
  let initial: (List[(Bytes, Bytes, Bytes)], Option[MigrateError[E]]) = ([], None())
  let (rewritten, failed) = store.table_range(
    tx,
    take low,
    keys.prefix_end(prefix),
    batch,
    Ascending(),
    take initial,
    fn(take acc: (List[(Bytes, Bytes, Bytes)], Option[MigrateError[E]]), key: Bytes, value: Bytes) -> (
      (List[(Bytes, Bytes, Bytes)], Option[MigrateError[E]]),
      bool
    ) {
      let (rows, _) = take acc
      let mut out = take rows
      match rewrite(reader, o, f, next, epoch, prefix, key, value) {
        Ok((row, data)) => {
          list.push(mut out, (unique key, take row, take data))
          ((take out, None()), true)
        },
        Error(e) => ((take out, Some(take e)), false),
      }
    }
  ) ? Table
  let read = list.len(rewritten)
  let mut cursor: Option[Bytes] = match p.cursor {
    Some(last) => Some(unique last),
    None() => None(),
  }
  let mut count = p.count
  for (key, row, data) in rewritten {
    if let Some(_) = store.table_read(tx, copy row) ? Table {
      return Error(Collision())
    }
    store.table_put(mut tx, unique row, unique data) ? Table
    cursor = Some(unique key)
    count += 1
  }
  if let Some(e) = take failed {
    return Error(take e)
  }
  Ok((Progress(cursor: take cursor, count: count), read == batch))
}

// The row and value a source row of `prefix` becomes in the generation
// `next` under `f` and the target schema.
fn rewrite[
  J: key + serializable,
  A: serializable,
  K: key + serializable,
  B: serializable,
  E: serializable
](
  reader: KeyReader,
  o: Open,
  f: Entry[fn(c: (), key: J, old: A) -> Result[(K, B), E]],
  next: Bytes,
  epoch: u64,
  prefix: Bytes,
  key: Bytes,
  value: Bytes
) -> Result[(Bytes, Bytes), MigrateError[E]] {
  let old_key: J = decode_key(reader, bytes.slice(key, bytes.len(prefix), bytes.len(key))) ? Table
  let old: A = decode_value(o, value) ? Table
  let (new_key, new_value) = match core@1/runner.apply(f, (), old_key, old) {
    Ok(Ok(row)) => row,
    Ok(Error(e)) => return Error(Failed(take e)),
    Error(failure) => return Error(Faulted(take failure)),
  }
  // The target rows are the codec's own encodings of K and B.
  let row = concat(next, encoded_key(b"", new_key, [], true) ? Table)
  let data = row_value(epoch, b"", new_value, true) ? Table
  Ok((take row, take data))
}

// The install: the catalog names the next generation and the target schema
// as its only live epoch, the history gains that epoch, and the replaced
// generation becomes garbage. It writes four keys whatever the table's size.
fn install[K: key + serializable, B: serializable, E](
  mut tx: store.Tx,
  to: Table[K, B],
  c: Catalog,
  entry: EntryId
) -> Result[(), MigrateError[E]] {
  let name = table_name(to)
  let generation = next_generation(c.generation)
  let d = descriptors(to)
  let epoch = Epoch(key: unique d.key, value: unique d.value, change: Migrated(unique entry))
  record(mut tx, name, next_epoch(c), epoch) ? Table
  let (key, value) = digests(to)
  let next = Catalog(generation: generation, base: next_epoch(c), count: 1)
  save(mut tx, name, key, value, next) ? Table
  store.table_delete(mut tx, store.garbage(rows_of(name, generation))) ? Table
  store.table_put(mut tx, store.garbage(rows_of(name, c.generation)), b"") ? Table
  Ok(())
}

// Discards a migration and returns `why`, or the failure that prevented the
// discard.
fn abandon[R, E](mut s: store.Store, take why: MigrateError[E]) -> Result[
  R,
  MigrateError[E]
] {
  // An abandoned migration's next generation is garbage.
  if let Error(e) = store.collect(mut s) {
    return Error(Table(Storage(take e)))
  }
  Error(take why)
}

// Whether a step was refused for the commit's size: the table is unchanged,
// and the migration is discarded with `Table(Limit(l))`.
fn over_limit[R, E](r: Result[R, store.TxFailure[MigrateError[E]]]) -> Option[store.TxLimit] uses {} {
  match r {
    Error(Limit(l)) => Some(l),
    Error(Aborted(Table(Limit(l)))) => Some(l),
    _ => None(),
  }
}

/// Migrates every row of a table from schema (J, A) to (K, B) with the pure
/// row function `f`, in batches of `batch` rows per transaction, checking
/// `within` for cancellation between them (STORE-9). The new rows go to the
/// table's next generation, and one small transaction installs it, so a
/// migration is bounded by no commit limit. The table is unchanged unless
/// every row migrates: a row function's error, a failure in it, a key
/// collision, cancellation or a refused commit discards the migration.
pub fn migrate[
  J: key + serializable,
  A: serializable,
  K: key + serializable,
  B: serializable,
  E: serializable
](
  within: Scope,
  mut s: store.Store,
  from: Table[J, A],
  to: Table[K, B],
  f: Entry[fn(c: (), key: J, old: A) -> Result[(K, B), E]],
  batch: u64
) -> Result[u64, MigrateError[E]] {
  let name = table_name(from)
  if !valid(name) || table_name(to) != name || batch == 0 || batch > s.limits.range_rows {
    return Error(Table(InvalidInput()))
  }
  let begun = store.transact_body(
    mut s,
    fn(mut tx: store.Tx) -> Result[Start, MigrateError[E]] {
      start(mut tx, from, to)
    }
  )
  let (c, o) = match settled(take begun)? {
    Current() => return Ok(0),
    Begun(c, o) => (take c, take o),
  }
  let mut progress = Progress(cursor: None(), count: 0)
  let mut more = true
  while more {
    if let Error(Canceled(cause)) = core@1/task.check_canceled(within) {
      let canceled: MigrateError[E] = Canceled(cause)
      return abandon(mut s, take canceled)
    }
    let held = take progress
    let stepped = store.transact_body(
      mut s,
      fn(mut tx: store.Tx) -> Result[(Progress, bool), MigrateError[E]] {
        advance(mut tx, name, c, o, f, held, batch)
      }
    )
    if let Some(l) = over_limit(stepped) {
      let refused: MigrateError[E] = Table(Limit(l))
      return abandon(mut s, take refused)
    }
    match take stepped {
      Ok((next, rest)) => {
        progress = take next
        more = rest
      },
      Error(Aborted(why)) => return abandon(mut s, take why),
      Error(other) => {
        let failed: Result[u64, store.TxFailure[MigrateError[E]]] = Error(take other)
        return settled(take failed)
      },
    }
  }
  let entry = core@1/runner.entry_id(f)
  let installed = store.transact_body(
    mut s,
    fn(mut tx: store.Tx) -> Result[(), MigrateError[E]] {
      install(mut tx, to, c, entry)
    }
  )
  // The install writes the catalog entry, a history row and two garbage
  // entries; one too
  // large for a commit leaves the table as it was.
  if let Some(l) = over_limit(installed) {
    let refused: MigrateError[E] = Table(Limit(l))
    return abandon(mut s, take refused)
  }
  settled(take installed)?
  // The replaced generation is garbage.
  if let Error(e) = store.collect(mut s) {
    return Error(Table(Storage(take e)))
  }
  Ok(progress.count)
}

// rule: PROV-1
// expect: reject PROV-1 at line 11
// twin: STORE/STORE-11-authority-seam-run.hir
pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let a = io.authority(rt, "main")?
  let b = io.authority(rt, "other")?
  let Ok(claimed) = authority.claim(a) else {
    return Ok(())
  }
  let mut c = take claimed
  let _ = authority.durable(a, mut c, authority.floor(b))
  Ok(())
}

; LANG-19 through receivers: releasing a value whose depth runs through channel
; queues uses constant native stack. f0(n, m) opens a final channel of capacity
; m and makes the root Link(its receiver). It then builds m chains. Chain k
; (k = 1..m) starts as End(Tok k) and takes n hops. A hop opens a capacity-1
; channel, sends the current chain into it, closes the hop's sender and makes
; the chain Link(the hop's receiver). Each finished chain is sent into the
; final channel. The run closes the final sender and drops the root, so one
; ordinary release cleans every queue: each receiver cleans its queue last
; published first (CONC-9), so the Toks are cleaned m, m-1, ..., 1.
; Derived by hand: the run returns m, frees every channel and Tok (used 0), and
; makes m (n + 1) + 1 admissions (n hop channels and one Tok per chain, plus
; the final channel).
; run: f0(0, 1) -> 1 | used 0 | trace 1
; run: f0(3, 1) -> 1 | used 0 | trace 1
; run: f0(0, 2) -> 2 | used 0 | trace 2, 1
; run: f0(4, 2) -> 2 | used 0 | trace 2, 1
core v1
type t0 = resource "Tok" { id: u64 }
type t1 = own "Chain" | End { tok: t0 } | Link { r: receiver }
type t2 = own "Sender" { s: sender }
sig g0 = (u64, u64) -> (u64)
sig g1 = (u64) -> (ptr, ptr, u64)
sig g2 = (ptr, &take t1) -> (bool)
inst n0 = test@0/receiver_chain/run [] []
fn f0 = n0 g0 {
  slot s0 = t1                         ; the chain being built
  slot s1 = t2                         ; a hop's sender
  slot s2 = t1                         ; the root: Link(final receiver)
  slot s3 = t2                         ; the final sender
  addr a0 = s0 : t1
  addr a1 = s0 case 0 0 : ptr          ; End.tok
  addr a2 = s0 case 1 0 : ptr          ; Link.r
  addr a3 = s1 field 0 : ptr
  addr a4 = s1 : t2
  addr a5 = s2 : t1
  addr a6 = s2 case 1 0 : ptr
  addr a7 = s3 field 0 : ptr
  addr a8 = s3 : t2
  addr a9 = v14 : t0                   ; a new Tok
  addr a10 = a9 field 0 : u64
b0(v0: u64, v1: u64):
  live s0
  live s1
  live s2
  live s3
  address a0
  address a1
  address a2
  address a3
  address a4
  address a5
  address a6
  address a7
  address a8
  v2: ptr, v3: ptr, v4: u64 = call rt.channel_new[t1] g1 (v1)
  v5: ptr = const 0x0
  v6: bool = eq v2, v5
  v7: u64 = const 0
  branch v6, b15, b1
b1:
  store a7, v2
  set_case a5, 1
  store a6, v3
  jump b2(v7)
b2(v8: u64):                           ; chains finished
  v9: bool = lt v8, v1
  branch v9, b3, b12(v8)
b3:
  v10: u64 = const 1
  v11: u64 = wrapping_add v8, v10
  v12: u64 = const 8
  v13: u64 = const 40
  v14: ptr, v15: u64 = alloc resource grant 0 v12 align 8 charge v13
  v16: bool = ne v14, v5
  branch v16, b4, b12(v8)
b4:
  address a9
  address a10
  store a10, v11
  set_case a0, 0
  store a1, v14
  jump b5(v7)
b5(v17: u64):                          ; hops taken
  v18: bool = lt v17, v0
  branch v18, b6, b10
b6:
  v19: ptr, v20: ptr, v21: u64 = call rt.channel_new[t1] g1 (v10)
  v22: bool = eq v19, v5
  branch v22, b13(v8), b7
b7:
  store a3, v19
  v23: bool = call rt.send[t1] g2 (v19, &a0) fail b16
  branch v23, b9, b8
b8:
  drop a0 t1                           ; closed: the chain is still ours
  jump b9
b9:
  drop a4 t2                           ; close the hop's sender
  set_case a0, 1
  store a2, v20
  v24: u64 = wrapping_add v17, v10
  jump b5(v24)
b10:
  v25: bool = call rt.send[t1] g2 (v2, &a0) fail b14
  branch v25, b2(v11), b11
b11:
  drop a0 t1                           ; closed: the chain is still ours
  jump b2(v11)
b12(v26: u64):
  drop a8 t2                           ; close the final sender
  drop a5 t1                           ; LANG-19: the root's release
  dead s0
  dead s1
  dead s2
  dead s3
  return v26
b13(v27: u64):
  drop a0 t1
  jump b12(v27)
b14:
  drop a0 t1
  drop a8 t2
  drop a5 t1
  dead s0
  dead s1
  dead s2
  dead s3
  propagate
b15:
  dead s0
  dead s1
  dead s2
  dead s3
  return v7
b16:                       ; the send failed: the chain is still ours
  drop a0 t1
  drop a4 t2
  set_case a0, 1
  store a2, v20
  jump b14
}

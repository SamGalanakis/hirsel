type DiskState {
    scrub_reader: Option[(std.object.Opener, u64)],
    preview: Option[pager.PreviewRead],
    random: Random,
    open: u64,
    options: Options,
    transfer: transfer.TransferState,
    // The schema commits main published since the lease last moved
    // (§3.5a "Catch-up"): they reach the child as the round's STEPS.
    retention: journal.RecordRetention,
    packs: manifest.PackDiskState,
    archive_hold: manifest.DirArchiveHold,
    pending_binding: Option[u64],
    archiver: Option[ArchiveLane],
    backend: Backend,
    tasks: Tasks,
    tiered: pager.DiskPagerState
}

fn log_directory(db: Db) -> Result[Dir, Error] {
    let Some(d) = disk_directory(disk_state(db)) else {
        return Error(Unsupported(1))
    }
    Ok(d)
}

fn object_writer_healthy(db: Db) -> Result[(), Error] {
    if let Some(connection) = db.disk {
        if let ObjectBackend(writer) = connection.backend {
            return failure_result_from_rep(object_writer.healthy(writer))
        }
    }
    Ok(())
}

fn object_writer_open(db: Db) -> bool {
    if let Some(connection) = db.disk {
        if let ObjectBackend(_) = connection.backend {
            return true
        }
    }
    false
}

fn object_state(db: Db) -> View[object_writer.ObjectWriterState] in db {
    match disk_state(db).backend {
        ObjectBackend(w) => view w,
        DirBackend(_) => fail("object writer state required"),
    }
}

fn cut_locator(db: Db) -> Option[View[history.HistoryLocator]] in db {
    match disk_state(db).backend {
        ObjectBackend(writer) => Some(object_writer.object_locator(writer)),
        DirBackend(_) => None,
    }
}

fn object_cut_due(db: Db) -> bool {
    if let ObjectBackend(writer) = disk_state(db).backend {
        return object_writer.entries(writer) >= disk_state(db).options.checkpoint_entries
    }
    false
}

pub type Refusal {
    error: Error,
    authority: Authority
}

pub fn open_authority(tasks: Tasks, take authority: Authority, c: Clock, r: Random, options: Options) -> Result[Db, Refusal] waits {
    match take authority {
        LogAuthority(d, None) => Ok(open(tasks, d, c, r, options) ?=> |problem| Refusal(error: take problem, authority: log_authority(d))),
        LogAuthority(d, Some(take arch)) => {
            let ArchiveAttachConfig(sink: take sink, options: arch_opts) = take arch
            let mut db = match open_directory_bound(tasks, d, c, r, options, arch_opts.binding_id, arch_opts.hold_bytes) {
                Ok(take opened) => take opened,
                Error(take problem) => return Error(Refusal(error: take problem, authority: LogAuthority(d, Some(ArchiveAttachConfig(sink: take sink, options: arch_opts))))),
            }
            if archive_binding_id(db) == 0 {
                if let Error(take problem) = bind_archive_hold(mut db, arch_opts.binding_id, arch_opts.hold_bytes) {
                    let _ = close(take db)
                    return Error(Refusal(error: take problem, authority: LogAuthority(d, Some(ArchiveAttachConfig(sink: take sink, options: arch_opts)))))
                }
            }
            if let Error(take problem) = start_archive_lane(mut db, take sink, arch_opts, false) {
                let _ = close(take db)
                return Error(Refusal(error: take problem, authority: log_authority(d)))
            }
            Ok(take db)
        },
        ObjectAuthority(take config) => open_object_writer(tasks, take config, c, r, options, 1, None),
        SimAuthority(take config) => open_object_writer(tasks, take config, c, r, options, 2, None),
    }
}

type ObjectWriterOpen {
    db: Db,
    register: history.HistoryRegister,
    metadata: Bytes,
    workspace: history.HistoryBuffers,
    blank: history.HistoryOpenBase,
    journal_worker: object_writer.ObjectWorkerOpen,
    tiered: pager.DiskPagerState,
    claim: Option[pager.ClaimPacks],
    options: Options,
    levels: List[String],
    link: Option[host_stream.SlotLink]
}

fn prepare_object_writer(tasks: Tasks, mut opening: Option[history.ObjectPackRead], c: Clock, r: Random, options: Options, level_name: String, op_ms: u64, sim: Option[(List[String], LevelSync)], authority_kind: u8, stream: Option[JournalSlot], cache: Option[pager.ObjectsCache]) -> Result[ObjectWriterOpen, Error] waits {
    let group_room: u64 = int.widen(options.group_bytes)
    let simulated = match opening {
        Some(source) => std.object.simulated(source.client),
        None => fail("object writer requires a source"),
    }
    if authority_kind == 2 && !simulated {
        return Error(Endpoint(NotSimulator))
    }
    let name_count = match sim {
        Some((names, _)) => list.len(names),
        None => 0u64
    }
    if name_count > 15 {
        return Error(Limit(Name))
    }
    let declaration = disk_allocation(scoped fn() -> Result[history.HistoryConfig, Error] {
        let mut names_in_order: List[String] = list.with_capacity(name_count + 1)
        if let Some((names, _)) = sim {
            for name in names {
                list.push(mut names_in_order, string.from(name))
            }
        }
        list.push(mut names_in_order, string.from(level_name))
        let place = match opening {
            Some(source) => std.object.bucket_config(source.client),
            None => fail("object writer requires a source"),
        }
        Ok(history.HistoryConfig(place: take place, levels: take names_in_order))
    })?
    let genesis_authority = failure_result_from_rep(history.history_config_bytes(declaration))?
    let mut workspace = failure_result_from_rep(history.history_buffers(object_writer.object_writer_entry_room(group_room)))?
    let slot = match stream {
        Some(handle) => Some(view handle.inner),
        None => None,
    }
    let weak_config = match sim {
        Some((names, sync)) => Some((view names, view sync.commands)),
        None => None,
    }
    let (take worker, take initial_link) = failure_result_from_rep(object_writer.prepare_worker(tasks, c, group_room, int.widen(options.group_commits), options.head_poll_ms, slot, weak_config))?
    let mut journal_worker = take worker
    let mut link = take initial_link
    let mut blank = disk_allocation(fn() -> Result[history.HistoryOpenBase, Error] {
        Ok(history.genesis_open_base())
    })?
    let held_options = disk_allocation(scoped fn() -> Result[Options, Error] {
        Ok(clone(options))
    })?
    let preview = match opening {
        Some(source) => match source.preview {
            Some(s) => Some(pager.share_preview(s)),
            None => None,
        },
        None => None,
    }
    let (take register, take opened, (take started, take tiered), take metadata) = history_open_with(mut opening, c, r, options, declaration.levels, authority_kind, take genesis_authority, mut workspace, op_ms, mut link, scoped fn(id: StoreId, epoch: u64, deferred: bool, client: std.object.Client, replay: pager.JournalReplay) -> Result[(Db, pager.DiskPagerState), Error] {
        failure_result_from_rep(txn.check_stream_quota(replay.state.tips[0u64].roots.streams, options.streams_max))?
        let mut state = failure_result_from_rep(host_stream.copy_follow_state(replay.state))?
        let mut tiered = pager.disk_pager_state(None)
        seed_claim_snapshots(replay, mut state, mut tiered)?
        let mut prepared = disk_allocation(scoped fn() -> Result[Db, Error] {
            Ok(empty_db(c, id, options))
        })?
        open_heads(mut prepared, take state)?
        pages.set_next_node(mut prepared.holders, replay.next_node)
        prepared.limits = limits_from_rep(replay.limits)
        catalog.set_next_table(mut prepared.schema, replay.state.next_table)
        prepared.accounting.tiered = replay.tiered.total
        prepared.accounting.resident = failure_result_from_rep(journal.journal_account(replay))?
        rebuild_keyed_credit(mut prepared, 0, options.journal_limit)?
        let pager_task = if deferred || store_has_tiered(prepared) {
            let funding = pager.TieredPagerFunding(cache_bytes: options.cache_bytes, writer_pin_bytes: options.writer_pin_bytes, pager_task_bytes: options.pager_task_bytes, cut_pins: true)
            let authority = disk_allocation(scoped fn() -> Result[pager.TieredPagerSource, Error] {
                match preview {
                    Some(s) => Ok(PreviewBucket(std.object.opener(client), op_ms, cache, pager.share_preview(s))),
                    None => Ok(PagerBucket(std.object.opener(client), op_ms, cache)),
                }
            })?
            let connected = failure_result_from_rep(object_writer.start_tiered_pager_link(tasks, store_key_to_rep(id), epoch, take authority, funding, pager.TIERED_PAGER_QUEUE))?
            Some(attach_tiered_pager(mut prepared, take connected))
        } else {
            None
        }
        if let Some(take connected_worker) = take pager_task {
            pager.set_worker(mut tiered, take connected_worker)
        }
        Ok((take prepared, take tiered))
    })?
    if let Some(mut attaching) = link {
        if let Some(take answers) = host_stream.slot_take_answers(mut attaching) {
            failure_result_from_rep(object_writer.start_slot_relay(mut journal_worker, tasks, take answers))?
        }
    }
    // The journaled forks after the checkpoint wait for the next cut's rows.
    let pager.JournalReplay(forked: take forked, claim_packs: take claim, ..) = take opened
    let uninstalled: Option[List[manifest.LineageFork]] = match opening {
        Some(mut source) => match source.admitted_base {
            Some(mut admitted) => {
                history.set_open_base_forks(mut admitted, take forked)
                None
            },
            None => Some(take forked),
        },
        None => fail("object writer requires a source"),
    }
    if let Some(take forks) = take uninstalled {
        history.set_open_base_forks(mut blank, take forks)
    }
    let history.HistoryConfig(levels: take names_in_order, ..) = take declaration
    Ok(ObjectWriterOpen(db: take started, register: take register, metadata: take metadata, workspace: take workspace, blank: take blank, journal_worker: take journal_worker, tiered: take tiered, claim: take claim, options: take held_options, levels: take names_in_order, link: take link))
}

fn wrap_object_authority(take config: ObjectAuthorityConfig, kind: u8) -> Authority {
    if kind == 1 {
        ObjectAuthority(take config)
    } else {
        SimAuthority(take config)
    }
}

fn open_object_writer(tasks: Tasks, take config: ObjectAuthorityConfig, c: Clock, r: Random, options: Options, authority_kind: u8, take preview: Option[pager.PreviewRead]) -> Result[Db, Refusal] waits {
    if let Error(take problem) = failure_result_from_rep(object_writer.object_open_checks(options.group_commits, options.group_bytes, optional_limits_to_rep(options.limits), options.checkpoint_bytes, options.journal_limit, options.head_poll_ms, options.checkpoint_entries, options.retain)) {
        return Error(Refusal(error: take problem, authority: wrap_object_authority(take config, authority_kind)))
    }
    if let Some(_) = config.stream_root {
        return Error(Refusal(error: Unsupported(0), authority: wrap_object_authority(take config, authority_kind)))
    }
    let ObjectAuthorityConfig(client: take client, level_name: take level_name, op_ms, sim: take sim, stream: take stream, stream_root: take stream_root, cache, archive: take archive) = take config
    let mut initial_source = history.history_reader(take client, 0)
    initial_source.writer_claim = true
    initial_source.archiving = match archive {
        Some(_) => true,
        None => false
    }
    initial_source.preview = take preview
    initial_source.cache = cache
    let mut opening = Some(take initial_source)
    let outcome = prepare_object_writer(tasks, mut opening, c, r, options, level_name, op_ms, sim, authority_kind, stream, cache)
    let read_source = option.unwrap(take opening)
    let prepared = match take outcome {
        Ok(take ready) => take ready,
        Error(take problem) => {
            let history.ObjectPackRead(client: take returned, ..) = take read_source
            return Error(Refusal(error: take problem, authority: wrap_object_authority(ObjectAuthorityConfig(client: take returned, level_name: take level_name, op_ms, sim: take sim, stream: take stream, stream_root: take stream_root, cache, archive: take archive), authority_kind)))
        },
    }
    let ObjectWriterOpen(db: take started, register: take register, metadata: take metadata, workspace: take workspace, blank: take blank, journal_worker: take journal_worker, tiered: take tiered, claim: take claim, options: take held_options, levels: take names_in_order, link: take link) = take prepared
    let mut db = take started
    let head = history.register_head(register)
    let history.ObjectPackRead(preview: take source_preview, client: take owned_client, locator: take locator, admitted_base: take base, ..) = take read_source
    let scrub_reader = std.object.opener(owned_client)
    let src_bucket = std.object.bucket_config(owned_client)
    let chosen_base = match take base {
        Some(take admitted) => take admitted,
        None => take blank,
    }
    let binding_id = history.open_base_binding_id(chosen_base)
    let (generation, fence, recorded_after, sweep, take checkpoint_packs) = history.open_base_parts(take chosen_base)
    let mut pages = take checkpoint_packs
    if let Some(take won) = take claim {
        let pager.ClaimPacks(disk: take accepted, ..) = take won
        manifest.install_claim_packs(mut pages, take accepted)
    }
    let (take requests, take workers) = std.object.split(take owned_client)
    let activation = object_writer.activate_worker(take journal_worker, take requests, take workers, take src_bucket, take register, take metadata, take workspace, op_ms, sweep, generation, manifest.pack_allocation_next(pages), take names_in_order, take locator, cache, take link)
    let (take object, force_open_cut) = match take activation {
        Ok(take active) => take active,
        Error((take returned, take returned_workers)) => {
            let restored = std.object.attach(take returned, take returned_workers)
            return Error(Refusal(error: Io(Closed), authority: wrap_object_authority(ObjectAuthorityConfig(client: take restored, level_name: take level_name, op_ms, sim: take sim, stream: take stream, stream_root: take stream_root, cache, archive: take archive), authority_kind)))
        },
    }
    db.accounting.checkpointed = generation
    catalog.restore_fence(mut db.schema, fence)
    db.accounting.page_resident = manifest.resident_location_charge(manifest.pack_locations(pages))
    db.disk = Some(DiskState(scrub_reader: Some((take scrub_reader, op_ms)), preview: take source_preview, random: r, open: head.pair.epoch, options: take held_options, transfer: transfer.new_state(), retention: journal.record_retention(head.checkpoint.seq, recorded_after), packs: take pages, archive_hold: manifest.recovered_archive_hold(binding_id, None, head.checkpoint.seq, list.new()), pending_binding: None, archiver: None, backend: ObjectBackend(take object), tasks, tiered: take tiered))
    // Forced open-time cut (§12.11.5 step 7, AP16): a refused cut does not fail open.
    if force_open_cut {
        if let Ok(cut_ticket) = checkpoint(mut db) {
            let _ = durable(mut db, cut_ticket)
        }
    }
    if let Some(take arch) = take archive {
        let ArchiveAttachConfig(sink: take sink, options: arch_opts) = take arch
        if binding_id != 0 && binding_id != arch_opts.binding_id {
            let _ = close(take db)
            return Error(Refusal(error: Conflict("archive binding"), authority: wrap_object_authority(ObjectAuthorityConfig(client: take sink, level_name: take level_name, op_ms, sim: take sim, stream: take stream, stream_root: take stream_root, cache, archive: None), authority_kind)))
        }
        if binding_id == 0 {
            if let Error(take problem) = bind_archive_hold(mut db, arch_opts.binding_id, arch_opts.hold_bytes) {
                let _ = close(take db)
                return Error(Refusal(error: take problem, authority: wrap_object_authority(ObjectAuthorityConfig(client: take sink, level_name: take level_name, op_ms, sim: take sim, stream: take stream, stream_root: take stream_root, cache, archive: None), authority_kind)))
            }
        }
        if let Error((take problem, take back_sink)) = start_archive_lane_returning(mut db, take sink, arch_opts, false) {
            let _ = close(take db)
            return Error(Refusal(error: take problem, authority: wrap_object_authority(ObjectAuthorityConfig(client: take back_sink, level_name: take level_name, op_ms, sim: take sim, stream: take stream, stream_root: take stream_root, cache, archive: None), authority_kind)))
        }
    }
    Ok(take db)
}

pub fn claim_of(db: Db) -> Result[Claim, Error] {
    if let Some(connection) = db.disk {
        if let ObjectBackend(writer) = connection.backend {
            return claim_from_pair(object_writer.claim_pair(writer))
        }
    }
    Error(Missing("head"))
}

pub fn origin_of(db: Db) -> Result[Option[Origin], Error] {
    if let Some(connection) = db.disk {
        if let ObjectBackend(writer) = connection.backend {
            return match object_writer.claim_origin(writer) {
                Some(o) => Ok(Some(origin_from_history(o)?)),
                None => Ok(None),
            }
        }
    }
    Error(Missing("head"))
}

fn object_stream_close(mut db: Db) -> Result[(), Error] waits {
    let (reply_send, reply_receive): (Sender[Result[(), types.Failure]], Receiver[Result[(), types.Failure]]) = channel.new(1)
    let closed = match channel.send(object_sender(disk_state(db)), ObjectClose(take reply_send)) {
        Ok(()) => false,
        Error(_) => true,
    }
    if closed {
        journal_poll(mut db)?
        return Error(Io(Closed))
    }
    match channel.receive(reply_receive) {
        Ok(take outcome) => failure_result_from_rep(take outcome),
        Error(_) => {
            journal_poll(mut db)?
            Error(Io(Closed))
        },
    }
}

fn object_cut_close(mut db: Db) -> Result[(), Error] waits {
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        if let ObjectBackend(mut writer) = state.backend {
            object_writer.set_drop_attach(mut writer, true)
        }
    })
    let result = cut_install(mut db, NoHolderChange)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        if let ObjectBackend(mut writer) = state.backend {
            object_writer.set_drop_attach(mut writer, false)
        }
    })
    let _ = result?
    Ok(())
}

fn take_object_journal(mut db: Db) -> Result[(object_writer.ObjectJournalSession, Sender[object_writer.ObjectJournalStart]), Error] waits {
    take_object_journal_with(mut db, false)
}

fn take_object_journal_with(mut db: Db, allow_attached: bool) -> Result[(object_writer.ObjectJournalSession, Sender[object_writer.ObjectJournalStart]), Error] waits {
    if !allow_attached {
        if let ObjectBackend(writer) = disk_state(db).backend {
            if let Some(sid) = object_writer.attached_stream(writer) {
                return Error(Attached(Some(host_stream_id_from_rep(sid))))
            }
        }
    }
    let (handover, paused): (Sender[object_writer.ObjectJournalStart], Receiver[object_writer.ObjectJournalStart]) = channel.new(1)
    let (resume, resuming): (Sender[object_writer.ObjectJournalStart], Receiver[object_writer.ObjectJournalStart]) = channel.new(1)
    let closed = match channel.send(object_sender(disk_state(db)), ObjectPause(take handover, take resuming)) {
        Ok(()) => false,
        Error(_) => true,
    }
    if closed {
        journal_poll(mut db)?
        return Error(Io(Closed))
    }
    let owned = match channel.receive(paused) {
        Ok(take object_io) => take object_io,
        Error(_) => {
            journal_poll(mut db)?
            return Error(Io(Closed))
        },
    }
    Ok((object_writer.object_journal_begin(take owned), take resume))
}

fn object_cut_state(mut db: Db, take delta: HolderDelta, write_seal: scoped fn(mut Bytes, format.DiskContext, u32) -> Result[(), Error] waits, target: Option[manifest.TargetLimits], pack_bytes: u64, limit: u64) -> Result[Ticket, Error] waits {
    let latest_receipt = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    durable(mut db, latest_receipt)?
    prepare_holder_slot(mut db, delta)?
    let (take paused, take resume) = take_object_journal_with(mut db, true)?
    let mut lane = take paused
    // §12.11.11 M6 (settle-then-archive): when bound and attached, settle sealed
    // tails in claim order then the eligible live prefix into Place GROUP entries
    // before the bound cut folds them.
    let effective_binding = match disk_state(db).pending_binding {
        Some(next_b) => next_b,
        None => disk_state(db).archive_hold.binding_id,
    }
    if effective_binding != 0 {
        let (take settled_lane, take settle_res) = object_writer.archive_settle_attached_lane(take lane, int.widen(disk_state(db).options.group_bytes), int.widen(disk_state(db).options.group_commits), Some(db.clock))
        lane = take settled_lane
        if let Error(take problem) = take settle_res {
            failure_result_from_rep(object_writer.return_object_journal(take lane, resume))?
            return Error(failure_from_rep(take problem))
        }
    }
    let mut observed: Option[host_stream.DeferredSlotReport] = None
    let mut completion: Option[host_stream.DeferredSlotReport] = None
    let outcome = object_cut_work(mut db, mut lane, take delta, write_seal, target, pack_bytes, limit, mut observed, mut completion)
    let allocated = object_writer.cut_next_pack(lane)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        manifest.reserve_pack_frontier(mut state.packs, allocated)
    })
    if let Error(problem) = outcome {
        if object_writer.paused_terminal(lane) {
            let saved: Error = clone(problem)
            write_disk(mut db.disk, take saved, scoped fn(mut state: DiskState, take terminal: Error) {
                if let ObjectBackend(mut writer) = state.backend {
                    object_writer.latch_failure(mut writer, failure_to_rep(take terminal))
                }
            })
        }
    }
    failure_result_from_rep(object_writer.return_object_journal(take lane, resume))?
    if let Some(take head_report) = take observed {
        host_stream.deliver_slot_report(take head_report)
    }
    if let Some(take completion_report) = take completion {
        host_stream.deliver_slot_report(take completion_report)
    }
    take outcome
}

fn object_cut_work(mut db: Db, mut lane: object_writer.ObjectJournalSession, take change: HolderDelta, write_seal: scoped fn(mut Bytes, format.DiskContext, u32) -> Result[(), Error] waits, target: Option[manifest.TargetLimits], pack_bytes: u64, limit: u64, mut observed: Option[host_stream.DeferredSlotReport], mut completion: Option[host_stream.DeferredSlotReport]) -> Result[Ticket, Error] waits {
    let mut delta = take change
    let old = object_writer.paused_head(lane)
    let seq = failure_result_from_rep(history.history_next_id(old.entry.seq))?
    let activation = match delta {
        ReplaceMain(main, _) => main.activation,
        _ => None,
    }
    let now = object_writer.paused_deadline(lane)
    let (take previous, _) = failure_result_from_rep(object_writer.read_checkpoint(mut lane, old, now))?
    let cut_binding = match disk_state(db).pending_binding {
        Some(next_b) => next_b,
        None => disk_state(db).archive_hold.binding_id,
    }
    let participants = disk_allocation(scoped fn() -> Result[manifest.CutParticipants, Error] {
        cut_participants(db, delta)
    })?
    let manifest.CutParticipants(holders: take participants_held, roots: take roots, branches: take branches, heads, promote) = take participants
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        manifest.prune_pack_scrubs(mut state.packs)
        pager.prune_leases(mut state.tiered)
    })
    let mut staged = stage_tiered_cut(db, delta, take roots, branches, heads, promote, pack_bytes, order.max(object_writer.cut_next_pack(lane), manifest.pack_allocation_next(disk_state(db).packs)))?
    pages.set_next_node(mut db.holders, staged.stamp_end - 1)
    raise_materialized_pin(mut delta, staged)
    let holders = failure_result_from_rep(pager.sealed_cut_holders(take participants_held, staged))?
    let read_packs = failure_result_from_rep(object_writer.reclaim_read_packs(staged.compaction.held, manifest.pack_scrubs(disk_state(db).packs)))?
    let mut base = cut_page_base(db, holders, staged)?
    let lineage_rows = settle_lineage_kills(cut_lineage_rows(db, delta, branches, staged.queue.added)?, db, delta, staged.queue, mut base.locations.packs)?
    failure_result_from_rep(catalog.over_ceiling(base.account, txn.available_resident(db.accounting, db.call_streams.keyed_credit)))?
    if let Some(wanted) = target {
        if let Some(problem) = types.journal_floor(wanted.checkpoint, wanted.journal, wanted.frame) {
            return Error(Full(Journal(problem)))
        }
        failure_result_from_rep(catalog.over_ceiling(base.account, wanted.resident))?
    }
    let manifest_bytes = cut_manifest_size(db, delta)
    let mut next_stamp = failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders)))?
    let mut workspace = failure_result_from_rep(history.history_buffers(65536))?
    let cache_dir = object_writer.cache_directory(object_state(db))
    let check_target = match target {
        Some(_) => true,
        None => false,
    }
    let plan = prepare_page_cut(base.locations, mut next_stamp, scoped fn(marks: Map[u64, ()], relocated: Option[View[core.Log[bool]]], mut stamp: u64) -> Result[(manifest.PackDiskState, pager.TieredCompaction, object_writer.PublishedCut, u64, u64, pages.TailBases), Error] waits {
        let cut_plan = {
            let installed = disk_state(db).packs
            plan_page_cut(base, holders, manifest.pack_lists(installed), staged.queue, lineage_rows, None, staged.next_pack, pack_bytes, marks, relocated, mut stamp)?
        }
        let mut buffers = failure_result_from_rep(manifest.cut_output_buffers(cut_plan, manifest_bytes, limit))?
        let (generation, take layout, take refs) = failure_result_from_rep(object_writer.write_cut_packs(mut lane, old, take cut_plan, staged.packs, object_writer.object_locator(object_state(db)), manifest.direct_packs(disk_state(db).packs), cache_dir, mut buffers, mut workspace, now))?
        fill_cut_manifest(mut buffers.out, db, delta, staged.roots, generation, seq, seq, layout, stamp, base.account, write_seal)?
        let (take pages, take compaction, _) = disk_allocation(scoped fn() -> Result[(manifest.PackDiskState, pager.TieredCompaction, journal.DiskRemovals), Error] {
            failure_result_from_rep(journal.cut_retirement(layout, holders, None, list.new(), staged.compaction, None, seq, seq))
        })?
        let (_, take parsed) = disk_read_page_manifest("MANIFEST", buffers.out)?
        let page_record = take parsed
        let mut locator = failure_result_from_rep(history.locator_for_cut(refs))?
        let settled = failure_result_from_rep(history.prepare_tiered_install(mut staged, manifest.pack_locations(pages), Some(view locator), generation, stamp))?
        let tails = prepare_sealed_tail_bases(db, delta, staged, heads)?
        let (installed, take locate_root) = failure_result_from_rep(object_writer.prepare_page_publication(mut lane, old, seq, take page_record, take refs, object_writer.object_locator(object_state(db)), mut locator, check_target, mut workspace, now))?
        let ordinary_keys = failure_result_from_rep(object_writer.ordinary_cut_names(mut lane, locator, read_packs, cut_binding != 0))?
        let retained = failure_result_from_rep(object_writer.archive_retain_for_cut_with_live(mut lane, previous, old.checkpoint, seq, disk_state(db).options.retain, cut_binding, disk_state(db).archive_hold.hold_bytes, disk_state(db).archive_hold.hold_bytes_explicit, archive_witnessed_through(db), ordinary_keys, now))?
        let published = failure_result_from_rep(object_writer.publish_cut(mut lane, installed, retained, locate_root, activation, take locator, object_writer.drops_attach(object_state(db)), mut workspace, now, mut observed, mut completion))?
        Ok((take pages, take compaction, take published, generation, settled, take tails))
    })
    pages.set_next_node(mut db.holders, next_stamp - 1)
    let (take candidate_pages, take compaction, take published, generation, settled, take tails) = plan?
    let resident_pages = manifest.resident_location_charge(manifest.pack_locations(candidate_pages))
    let recorded_after = match delta {
        ReplaceMain(main, _) => main.head,
        _ => pages.holder_heads(db.holders)[0].head,
    }
    write_disk(mut db.disk, (take candidate_pages, take published), scoped fn(mut state: DiskState, take installation: (manifest.PackDiskState, object_writer.PublishedCut)) {
        let (take installed, take installed_cut) = take installation
        manifest.install_pack_cut(mut state.packs, take installed)
        state.retention = journal.record_retention(seq, recorded_after)
        if let Some(next_binding) = replace(mut state.pending_binding, None) {
            state.archive_hold.binding_id = next_binding
        }
        if let ObjectBackend(mut writer) = state.backend {
            object_writer.install_cut(mut writer, take installed_cut)
        }
    })
    write_disk(mut db.disk, take compaction, scoped fn(mut state: DiskState, take candidate: pager.TieredCompaction) {
        pager.install_disk_cut(mut state.tiered, take candidate)
    })
    db.accounting.tiered = settled
    db.accounting.checkpointed = generation
    db.accounting.resident = base.account
    db.accounting.page_resident = resident_pages
    db.accounting.settled = db.accounting.changes
    let held_delta = install_tiered_holders(mut db, take delta, take staged)
    install_holder_delta(mut db, take held_delta)
    if let Some(take bases) = take tails {
        pages.set_holder_bases(mut db.holders, Some(take bases))
    }
    let authority = object_state(db)
    object_writer.schedule_reclaim(mut lane, object_writer.recovered_checkpoint(authority), generation, manifest.pack_next(disk_state(db).packs), take read_packs)
    Ok(Ticket(store: store_key_from_rep(old.store), open: old.pair.epoch, mark: Cut(generation)))
}

pub fn fresh_snapshot(mut db: Db, deadline_ns: u64) -> Result[Snapshot, Error] waits {
    journal_poll(mut db)?
    let receipt = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    durable(mut db, receipt)?
    if object_writer_open(db) {
        let (destination, pending): (Sender[Result[(), types.Failure]], Receiver[Result[(), types.Failure]]) = channel.new(1)
        let closed = match channel.send(object_sender(disk_state(db)), ObjectFresh(take destination, deadline_ns)) {
            Ok(()) => false,
            Error(_) => true,
        }
        if closed {
            journal_poll(mut db)?
            return Error(Io(Closed))
        }
        match channel.receive(pending) {
            Ok(Ok(())) => (),
            Ok(Error(Behind(_))) => return Error(Behind(Position(store: db.store, branch: 0, version: pages.holder_heads(db.holders)[0].head))),
            Ok(Error(take problem)) => return Error(failure_from_rep(take problem)),
            Error(_) => {
                journal_poll(mut db)?
                return Error(Io(Closed))
            },
        }
    }
    Ok(snapshot(db))
}

fn object_skip_fence(mut db: Db) -> Result[(), Error] waits {
    let (destination, pending): (Sender[Result[(), types.Failure]], Receiver[Result[(), types.Failure]]) = channel.new(1)
    let closed = match channel.send(object_sender(disk_state(db)), ObjectSkipFence(take destination)) {
        Ok(()) => false,
        Error(_) => true,
    }
    if closed {
        journal_poll(mut db)?
        return Error(Io(Closed))
    }
    match channel.receive(pending) {
        Ok(Ok(())) => Ok(()),
        Ok(Error(Fenced(epoch))) => {
            edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
                if let ObjectBackend(mut writer) = state.backend {
                    object_writer.latch_failure(mut writer, Fenced(epoch))
                }
            })
            Error(Fenced(epoch))
        },
        Ok(Error(take problem)) => Error(failure_from_rep(take problem)),
        Error(_) => {
            journal_poll(mut db)?
            Error(Io(Closed))
        },
    }
}

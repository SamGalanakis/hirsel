// Module `ids`: a u32 index allocator with a free list and a one-bit liveness
// check. It owns no element storage: storage stays in the caller's Lists (or a
// later column store), so element places such as `nodes[i].left` remain ordinary
// List places. Field legend: API.md; design: api/ids.md.
//
// `next` is the first never-issued fresh index and the allocator's limit. Index
// 2^32 - 1 is never issued, so it remains available to callers as a sentinel.
// Bits in `live` are one per index below `next`; a set bit means the index is
// live. Recycled indexes are a LIFO free list. Every growth is reserved before
// the index or the caller's row changes, so a refusal never issues an index
// without its row.
pub opaque type Ids {
    free: List[u32],
    next: u32,
    live: bitset.BitSet
}

const EXHAUSTED: u32 = 4294967295

fn fresh(a: Ids) -> u32 {
    if a.next == EXHAUSTED {
        fail("ids: fresh index space exhausted")
    }
    a.next
}

fn reused(a: Ids) -> Option[u32] {
    let n = list.len(a.free)
    if n == 0 {
        None
    } else {
        Some(a.free[n - 1])
    }
}

fn live(a: Ids, i: u32) -> bool {
    i < a.next && bitset.get(a.live, (int.widen(i) : u64))
}

fn reserve_words(mut a: Ids, bits: u64) {
    bitset.resize(mut a.live, bits)
}

fn try_reserve_words(mut a: Ids, bits: u64) -> Result[(), Capacity] {
    bitset.try_resize(mut a.live, bits)
}

fn commit(mut a: Ids, i: u32, fresh_index: bool) {
    if fresh_index {
        a.next += 1
    } else {
        let _ = list.pop(mut a.free)
    }
    bitset.set(mut a.live, (int.widen(i) : u64))
}

/// An empty allocator with no storage. Alloc: nothing. Ex: `let mut ids = std.ids.new()`
pub fn new() -> Ids {
    Ids(free: list.new(), next: 0, live: bitset.new(0))
}

/// Indexes ever issued, and the storage length when every index is kept through
/// `place`. Cost: O(1). Ex: `std.ids.limit(ids)`
pub fn limit(a: Ids) -> u32 {
    a.next
}

/// Takes a recycled index (the most recently given first) or the next fresh one.
/// Fails: a refused liveness growth raises Capacity before any index is issued;
/// exhausting the fresh index space raises Fail. Alloc: at most one u64 word of
/// liveness storage. Cost: amortised O(1). Ex: `let i = std.ids.take_index(mut ids)`
pub fn take_index(mut a: Ids) -> u32 {
    match reused(a) {
        Some(i) => {
            commit(mut a, i, false)
            i
        },
        None => {
            let i = fresh(a)
            let bits: u64 = (int.widen(i) : u64) + 1
            reserve_words(mut a, bits)
            commit(mut a, i, true)
            i
        },
    }
}

/// Like `take_index`, returning a refused growth as Error(c) with the allocator
/// unchanged. Ex: `let i = std.ids.try_take(mut ids)?`
pub fn try_take(mut a: Ids) -> Result[u32, Capacity] {
    match reused(a) {
        Some(i) => {
            commit(mut a, i, false)
            Ok(i)
        },
        None => {
            let i = fresh(a)
            let bits: u64 = (int.widen(i) : u64) + 1
            try_reserve_words(mut a, bits)?
            commit(mut a, i, true)
            Ok(i)
        },
    }
}

/// Gives back a live index. Fails: Fail when i is not live, which catches a
/// double free; a refused free-list growth raises Capacity before the allocator
/// changes. The caller first clears a slot that holds resources. Alloc: at most
/// GROWTH of free. Cost: amortised O(1). Ex: `std.ids.give(mut ids, old)`
pub fn give(mut a: Ids, i: u32) {
    if !live(a, i) {
        fail("ids.give: index is not live")
    }
    list.reserve(mut a.free, 1)
    bitset.clear(mut a.live, (int.widen(i) : u64))
    list.push(mut a.free, i)
}

fn check_storage[T](items: List[T], i: u32) {
    if list.len(items) != (int.widen(i) : u64) {
        fail("ids.place: storage length differs from limit")
    }
}

/// Takes an index and installs v as its row: pushes when the index is fresh and
/// overwrites when it was recycled. `items` is the storage for indexes issued
/// through `place`, so its length is `limit` before the call. Fails: Fail when
/// that length differs; a refused growth raises Capacity before either the row
/// or the allocator changes. Alloc: at most one row of GROWTH in items and one
/// u64 word of liveness storage. Cost: amortised O(1) plus cleaning the old row.
/// Ex: `let i = std.ids.place(mut t.ids, mut t.nodes, take node)`
pub fn place[T](mut a: Ids, mut items: List[T], take v: T) -> u32 {
    check_storage(items, limit(a))
    match reused(a) {
        Some(i) => {
            let _ = list.set(mut items, (int.widen(i) : u64), take v)
            commit(mut a, i, false)
            i
        },
        None => {
            let i = fresh(a)
            list.reserve(mut items, 1)
            let bits: u64 = (int.widen(i) : u64) + 1
            reserve_words(mut a, bits)
            list.push(mut items, take v)
            commit(mut a, i, true)
            i
        },
    }
}

/// Like `place`, returning a refused growth as Error(c). A refusal leaves
/// `limit` and `list.len(items)` unchanged. Ex:
/// `match std.ids.try_place(mut t.ids, mut t.nodes, take node) { Error(_) => .., Ok(i) => .. }`
pub fn try_place[T](mut a: Ids, mut items: List[T], take v: T) -> Result[u32, Capacity] {
    check_storage(items, limit(a))
    match reused(a) {
        Some(i) => {
            let _ = list.set(mut items, (int.widen(i) : u64), take v)
            commit(mut a, i, false)
            Ok(i)
        },
        None => {
            let i = fresh(a)
            list.try_reserve(mut items, 1)?
            let bits: u64 = (int.widen(i) : u64) + 1
            try_reserve_words(mut a, bits)?
            list.push(mut items, take v)
            commit(mut a, i, true)
            Ok(i)
        },
    }
}

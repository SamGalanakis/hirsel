fn reference(d: Inline[u8, 32], n: u64) -> bool {
    for i in 0u64 .. 8u64 {
        let a: u32 = int.widen(d[i * 4])
        let b: u32 = int.widen(d[i * 4 + 1])
        let c: u32 = int.widen(d[i * 4 + 2])
        let e: u32 = int.widen(d[i * 4 + 3])
        if ((a << 24) | (b << 16) | (c << 8) | e) != HASHES[n * 8 + i] {
            return false
        }
    }
    true
}

fn differential(lo: u64, hi: u64) -> bool {
    let mut b: Bytes = list.with_capacity(202)
    list.push(mut b, 99u8)
    for i in 0u64 .. 200u64 {
        list.push(mut b, int.truncate(i * 17 + 3))
    }
    list.push(mut b, 77u8)
    for n in lo .. hi {
        if !reference(sha256.hash(list.slice(b, 1, n + 1)), n) {
            return false
        }
        for cut in 0u64 .. (n + 1) {
            let mut s = sha256.start()
            sha256.add(mut s, b, 1, cut + 1)
            sha256.add(mut s, b, cut + 1, n + 1)
            if !reference(sha256.finish(s), n) {
                return false
            }
        }
        let mut s = sha256.start()
        for i in 0u64 .. n {
            sha256.add(mut s, b, i + 1, i + 2)
        }
        if !reference(sha256.finish(s), n) {
            return false
        }
    }
    true
}

// expect: run lengths_0_19() = true
fn lengths_0_19() -> bool {
    differential(0, 20)
}

// expect: run lengths_20_39() = true
fn lengths_20_39() -> bool {
    differential(20, 40)
}

// expect: run lengths_40_59() = true
fn lengths_40_59() -> bool {
    differential(40, 60)
}

// expect: run lengths_60_79() = true
fn lengths_60_79() -> bool {
    differential(60, 80)
}

// expect: run lengths_80_99() = true
fn lengths_80_99() -> bool {
    differential(80, 100)
}

// expect: run lengths_100_119() = true
fn lengths_100_119() -> bool {
    differential(100, 120)
}

// expect: run lengths_120_139() = true
fn lengths_120_139() -> bool {
    differential(120, 140)
}

// expect: run lengths_140_159() = true
fn lengths_140_159() -> bool {
    differential(140, 160)
}

// expect: run lengths_160_179() = true
fn lengths_160_179() -> bool {
    differential(160, 180)
}

// expect: run lengths_180_199() = true
fn lengths_180_199() -> bool {
    differential(180, 200)
}

// expect: run lengths_200_200() = true
fn lengths_200_200() -> bool {
    differential(200, 201)
}

// Source: NIST CAVP SHA256ShortMsg.rsp and SHA256LongMsg.rsp, CAVS 11.0, public domain.
// expect: run cavp_sha256() = true
fn cavp_sha256() -> bool {
    for row in sha256_cavp_data() {
        let (input, hex) = row
        if !matches(sha256.hash(input), hex) {
            return false
        }
    }
    true
}

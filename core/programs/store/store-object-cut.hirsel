const HISTORY_LOCATE_ROWS: u64 = 32768

const HISTORY_PART_BYTES: u64 = 8388608

const HISTORY_UPLOAD_ATTEMPTS: u64 = 5

type HistoryLocateRoot {
    depth: u8,
    rows: List[HistoryRef]
}

type HistoryActivation {
    number: u64,
    binding: Inline[u8, 32]
}

fn history_mark_ref(mut raw: Bytes, item: HistoryRef) {
    list.put_word_le(mut raw, item.seq)
    list.put_word_le(mut raw, item.epoch)
    list.put_word_le(mut raw, item.digest)
    list.put_word_le(mut raw, item.len)
}

fn history_checkpoint_packet(mut raw: Bytes, ctx: DiskContext, epoch: u64, kind: u8, predecessor: HistoryRef, manifest: HistoryRef, retained: HistoryRetention, locator: HistoryLocateRoot) -> Result[HistoryRef, Error] {
    history_packet_header(mut raw, ctx, epoch, kind, predecessor)?
    list.fill(mut raw, 16, 0u8)
    history_mark_ref(mut raw, manifest)
    list.put_word_le(mut raw, retained.floor)
    list.push(mut raw, locator.depth)
    let earlier_count: u32 = int.narrow(list.len(retained.earlier))
    list.put_word_le(mut raw, earlier_count)
    for older in retained.earlier {
        history_mark_ref(mut raw, older)
    }
    capacity(history_seal(mut raw, ctx, 112, 0x0090))?
    let at = list.len(raw)
    history_encode_locator(mut raw, locator.rows)
    capacity(history_seal(mut raw, ctx, at, 0x00C0))?
    Ok(history_new_ref(ctx.seq, epoch, raw))
}

fn history_encode_locator(mut raw: Bytes, rows: List[HistoryRef]) {
    list.fill(mut raw, 16, 0u8)
    for item in rows {
        history_ref_encode(mut raw, item)
    }
}

fn history_reusable_chunk(inherited: HistoryLocator, rows: List[HistoryRef], first_index: u64, minimum_end: u64, depth: u8) -> Option[(HistoryRef, u64)] {
    let candidate = map.get(inherited.reuse, history_chunk_key(depth, rows[first_index]))?
    let until = first_index + candidate.row_count
    if until > list.len(rows) || until < minimum_end || !history_ref_matches(rows[until - 1], candidate.last_row) {
        return None
    }
    // Strictly ordered leaf rows plus the matching endpoints and count identify
    // the old chunk's range. Check each row against the admitted old locator.
    for i in first_index .. until {
        let expected: HistoryRef = if depth == 0 {
            clone(map.get(inherited.rows, rows[i].seq)?)
        } else {
            candidate.children[i - first_index]
        }
        if !history_ref_matches(rows[i], expected) {
            return None
        }
    }
    Some((candidate.reference, until))
}

fn history_make_locator_reusing(mut client: std.object.Client, id: StoreId, seq: u64, epoch: u64, kind: u8, take packs: List[HistoryRef], inherited: HistoryLocator, mut located: HistoryLocator, mut workspace: HistoryBuffers, deadline: u64) -> Result[HistoryLocateRoot, Error] waits {
    let mut rows = take packs
    let mut depth = 0u8
    let mut layer_capacity = HISTORY_LOCATE_ROWS
    while layer_capacity < list.len(rows) {
        let Some(larger) = int.checked_mul(layer_capacity, HISTORY_LOCATE_ROWS) else {
            return Error(Limit(Ids))
        }
        layer_capacity = larger
    }
    if list.len(rows) > HISTORY_LOCATE_ROWS {
        list.clear(mut workspace.packet)
        capacity(list.try_reserve(mut workspace.packet, 88 + 32 * HISTORY_LOCATE_ROWS + BINDING_BYTES))?
        list.clear(mut workspace.compare)
        capacity(list.try_reserve(mut workspace.compare, 88 + 32 * HISTORY_LOCATE_ROWS))?
    }
    while list.len(rows) > HISTORY_LOCATE_ROWS {
        let row_count = list.len(rows)
        let length = (row_count - 1) / HISTORY_LOCATE_ROWS + 1
        layer_capacity /= HISTORY_LOCATE_ROWS
        let mut parents = disk_allocation(scoped fn() -> Result[List[HistoryRef], Error] {
            Ok(list.with_capacity(length))
        })?
        let ctx = DiskContext(store: id, role: 8, seq)
        let mut first_index = 0u64
        while first_index < row_count {
            let remaining = (layer_capacity - list.len(parents) - 1) * HISTORY_LOCATE_ROWS
            let minimum_end = order.max(first_index + 1, int.saturating_sub(row_count, remaining))
            let (chunk, chunk_end) = match history_reusable_chunk(inherited, rows, first_index, minimum_end, depth) {
                Some(found) => found,
                None => {
                    let mut until = first_index + order.min(row_count - first_index, HISTORY_LOCATE_ROWS)
                    if map.len(inherited.reuse) != 0 {
                        for probe in minimum_end .. until {
                            if let Some(_) = history_reusable_chunk(inherited, rows, probe, probe + 1, depth) {
                                until = probe
                                break
                            }
                        }
                    }
                    let slice_rows = list.slice(rows, first_index, until)
                    list.clear(mut workspace.packet)
                    capacity(history_append_header(mut workspace.packet, ctx, epoch, kind))?
                    history_encode_locator(mut workspace.packet, slice_rows)
                    capacity(history_seal(mut workspace.packet, ctx, 72, 0x00C0))?
                    let reference = history_new_ref(seq, epoch, workspace.packet)
                    history_fill_key(mut workspace.key, "l-", reference)
                    history_create(mut client, workspace.key, mut workspace.packet, mut workspace.compare, deadline)?
                    (reference, until)
                },
            }
            let mut children: List[HistoryRef] = list.new()
            if depth > 0 {
                capacity(list.try_reserve(mut children, chunk_end - first_index))?
                list.append(mut children, list.slice(rows, first_index, chunk_end))
            }
            history_remember_chunk(mut located, chunk, depth, chunk_end - first_index, rows[first_index], rows[chunk_end - 1], take children)?
            capacity(list.try_reserve(mut parents, 1))?
            list.push(mut parents, chunk)
            first_index = chunk_end
        }
        rows = take parents
        depth += 1
    }
    Ok(HistoryLocateRoot(depth, rows: take rows))
}

fn history_make_locator(mut client: std.object.Client, id: StoreId, seq: u64, epoch: u64, kind: u8, take packs: List[HistoryRef], mut workspace: HistoryBuffers, deadline: u64) -> Result[HistoryLocateRoot, Error] waits {
    let inherited = empty_history_locator()
    let mut located = empty_history_locator()
    history_make_locator_reusing(mut client, id, seq, epoch, kind, take packs, inherited, mut located, mut workspace, deadline)
}

fn history_publish_checkpoint(mut client: std.object.Client, mut register: HistoryRegister, authority: Bytes, manifest: HistoryRef, retained: HistoryRetention, locator: HistoryLocateRoot, activation_update: Option[HistoryActivation], mut workspace: HistoryBuffers, deadline: u64) -> Result[HistoryWrite, Error] waits {
    let mut candidate = register.head
    let seq = history_next_id(candidate.entry.seq)?
    let ctx = DiskContext(store: candidate.store, role: 2, seq)
    let width = 189 + 32 * (list.len(retained.earlier) + list.len(locator.rows))
    list.clear(mut workspace.packet)
    capacity(list.try_reserve(mut workspace.packet, width + BINDING_BYTES))?
    list.clear(mut workspace.compare)
    capacity(list.try_reserve(mut workspace.compare, width))?
    let base = history_checkpoint_packet(mut workspace.packet, ctx, candidate.pair.epoch, candidate.authority_kind, candidate.entry, manifest, retained, locator)?
    candidate.entry = base
    candidate.checkpoint = base
    candidate.floor = retained.floor
    if let Some(changed) = activation_update {
        candidate.activation = changed.number
        candidate.binding = changed.binding
    }
    history_register_publish(mut client, mut register, candidate, authority, mut workspace, deadline, fn(ignored: u64) {})
}

fn history_create_manifest(mut client: std.object.Client, id: StoreId, epoch: u64, kind: u8, manifest: PageManifest, mut workspace: HistoryBuffers, deadline: u64) -> Result[HistoryRef, Error] waits {
    let (take prepared, take header) = disk_allocation(scoped fn() -> Result[(Bytes, Bytes), Error] {
        let raw = disk_page_manifest_bytes(id, manifest)?
        let mut leader: Bytes = list.with_capacity(72 + BINDING_BYTES)
        let ctx = DiskContext(store: id, role: 1, seq: manifest.generation)
        capacity(history_append_header(mut leader, ctx, epoch, kind))?
        Ok((take raw, take leader))
    })?
    let mut raw = take prepared
    for i in 0u64 .. 72 {
        raw[i] = header[i]
    }
    let item = history_new_ref(manifest.generation, epoch, raw)
    history_fill_key(mut workspace.key, "m-", item)
    if item.len > list.capacity(workspace.compare) {
        workspace.compare = disk_allocation(scoped fn() -> Result[Bytes, Error] {
            Ok(list.with_capacity(item.len))
        })?
    }
    history_create(mut client, workspace.key, mut raw, mut workspace.compare, deadline)?
    Ok(item)
}

fn history_copy_header(mut raw: Bytes, ctx: DiskContext, epoch: u64, kind: u8) -> Result[(), Error] {
    let header = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        let mut leader: Bytes = list.with_capacity(72 + BINDING_BYTES)
        capacity(history_append_header(mut leader, ctx, epoch, kind))?
        Ok(take leader)
    })?
    for i in 0u64 .. 72 {
        raw[i] = header[i]
    }
    Ok(())
}

fn history_pack_parts(mut client: std.object.Client, mut upload: std.object.Upload, raw: Bytes, mut bodies: List[Bytes], deadline: u64) -> Result[(), Error] waits {
    let mut at = 0u64
    while at < list.len(raw) {
        let end = at + order.min(list.len(raw) - at, HISTORY_PART_BYTES)
        list.clear(mut bodies[0u64])
        list.append(mut bodies[0u64], list.slice(raw, at, end))
        let (take sent, take returned) = std.object.parts(mut client, mut upload, replace(mut bodies, list.new()), deadline)
        bodies = take returned
        if let Error(take problem) = sent {
            return Error(Remote(take problem))
        }
        at = end
    }
    Ok(())
}

fn history_confirm_pack(mut client: std.object.Client, key: String, raw: Bytes, mut scratch: Bytes, deadline: u64) -> Result[bool, Error] waits {
    list.clear(mut scratch)
    capacity(list.try_reserve(mut scratch, list.len(raw)))?
    let (take fetched, take bytes_back) = std.object.fetch(mut client, key, replace(mut scratch, list.new()), deadline)
    scratch = take bytes_back
    match take fetched {
        Ok(meta) if meta.size == list.len(raw) && scratch == raw => Ok(true),
        Ok(_) => Error(disk_fault(key, 0, Malformed)),
        Error(TooLarge) => Error(disk_fault(key, 0, Malformed)),
        Error(NotFound) => Ok(false),
        Error(take problem) => Error(Remote(take problem)),
    }
}

fn history_upload_pack(mut client: std.object.Client, key: String, raw: Bytes, mut scratch: Bytes, deadline: u64) -> Result[(), Error] waits {
    let mut bodies = disk_allocation(scoped fn() -> Result[List[Bytes], Error] {
        let mut part_batch: List[Bytes] = list.with_capacity(1)
        list.push(mut part_batch, list.with_capacity(order.min(list.len(raw), HISTORY_PART_BYTES)))
        Ok(take part_batch)
    })?
    let mut last_upload_error: std.object.Error = Retriable(Deadline)
    for _ in 0u64 .. HISTORY_UPLOAD_ATTEMPTS {
        if std.object.deadline_after_ms(client, 0) >= deadline {
            break
        }
        let mut upload = match std.object.upload(mut client, key, NoClobber, deadline) {
            Ok(take active) => take active,
            Error(take problem) => return Error(Remote(take problem)),
        }
        if let Error(take problem) = history_pack_parts(mut client, mut upload, raw, mut bodies, deadline) {
            let _ = std.object.abort(mut client, take upload, deadline)
            return Error(take problem)
        }
        let (restart, completed): (bool, std.object.Error) = match std.object.complete_unresolved(mut client, upload, deadline) {
            Ok(Created(_)) => return Ok(()),
            Ok(Exists) => (false, NotFound),
            Error(take problem) => (true, take problem),
        }
        let found = match completed {
            Uncertain(_) => history_confirm_pack(mut client, key, raw, mut scratch, deadline),
            NotFound => history_confirm_pack(mut client, key, raw, mut scratch, deadline),
            Fatal(Status(409, code)) if code == string.as_bytes("ConditionalRequestConflict") => history_confirm_pack(mut client, key, raw, mut scratch, deadline),
            _ => Error(Remote(clone(completed))),
        }
        let _ = std.object.abort(mut client, take upload, deadline)
        if found? {
            return Ok(())
        }
        if !restart {
            return Error(Remote(take completed))
        }
        last_upload_error = take completed
    }
    Error(Remote(take last_upload_error))
}

fn history_write_pack_run(mut client: std.object.Client, id: StoreId, epoch: u64, kind: u8, cache: Option[ObjectsCache], pack_layout: PackRun, mut known: PageLocations, mut pack_objects: Map[u64, HistoryRef], mut buffers: PackBuffers, mut workspace: HistoryBuffers, deadline: u64) -> Result[(), Error] waits {
    for pack in pack_layout.packs {
        encode_pack(id, pack_layout, pack, mut known, mut buffers.out)?
        history_copy_header(mut buffers.out, DiskContext(store: id, role: 3, seq: pack.seq), epoch, kind)?
        let item = history_new_ref(pack.seq, epoch, buffers.out)
        history_fill_key(mut workspace.key, "p-", item)
        history_upload_pack(mut client, workspace.key, buffers.out, mut workspace.compare, deadline)?
        if let Some(local) = cache {
            if item.len <= local.capacity_bytes {
                pack_cache_write(local, workspace.key, buffers.out, false)
            }
        }
        map.insert(mut pack_objects, pack.seq, item)
    }
    Ok(())
}

fn history_write_page_cut(mut client: std.object.Client, id: StoreId, epoch: u64, kind: u8, take prepared: PagedCutLayout, inherited: HistoryLocator, cache: Option[ObjectsCache], mut buffers: PackBuffers, mut workspace: HistoryBuffers, deadline: u64) -> Result[(PagedCutLayout, List[HistoryRef]), Error] waits {
    let (take uploaded, take covered_packs) = disk_allocation(scoped fn() -> Result[(Map[u64, HistoryRef], List[HistoryRef]), Error] {
        let new_packs = list.len(prepared.blobs.packs) + list.len(prepared.data_pages.packs) + list.len(prepared.lists.run_packs.packs)
        let mut refs: Map[u64, HistoryRef] = map.new()
        capacity(map.try_reserve(mut refs, new_packs))?
        Ok((take refs, list.with_capacity(std.omap.len(prepared.locations.packs.values))))
    })?
    list.clear(mut workspace.compare)
    capacity(list.try_reserve(mut workspace.compare, 65536))?
    let PagedCutLayout(locations: take locations, blobs: take blobs, data_pages: take data_pages, lists: take lists) = take prepared
    let mut known = take locations
    let mut packs = take uploaded
    let mut rows = take covered_packs
    history_write_pack_run(mut client, id, epoch, kind, cache, blobs, mut known, mut packs, mut buffers, mut workspace, deadline)?
    history_write_pack_run(mut client, id, epoch, kind, cache, data_pages, mut known, mut packs, mut buffers, mut workspace, deadline)?
    history_write_pack_run(mut client, id, epoch, kind, cache, lists.run_packs, mut known, mut packs, mut buffers, mut workspace, deadline)?
    let mut cursor = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, record)) = std.omap.next(mut cursor) {
        if record.live == 0 {
            continue
        }
        let item = match map.get(packs, seq) {
            Some(created) => created,
            None => option.unwrap(map.get(inherited.rows, seq)),
        }
        list.push(mut rows, item)
    }
    Ok((PagedCutLayout(locations: take known, blobs: take blobs, data_pages: take data_pages, lists: take lists), take rows))
}

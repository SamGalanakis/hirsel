// ---- RTC-6 probing laws (W24) ----
// One publisher sends the simulcast encodings q, h and f to the router; one
// subscriber, behind a token-bucket policer, receives a down-track and answers TWCC
// feedback. The run is event driven: the router is polled at each publisher packet,
// each feedback and each wake it asks for.
// The publisher's encodings, each a VP8 keyframe whose payload ends in its own byte.
const FILL_Q: u8 = 0x51

const FILL_H: u8 = 0x52

const FILL_F: u8 = 0x53

// The policer on the subscriber's path: 2 Mbit/s, four 1,220-byte packets deep, as
// rtp's net_laws.
const POLICE_BPS: u64 = 2000000

const POLICE_DEPTH: u64 = 4880

// The subscriber's section: VP8 on 96, RTX on 97 when it offers RTX, MID on 1 and
// TWCC on 3.
const SUB_RTX_PT: u8 = 97

const SUB_TWCC: u8 = 3

// When the subscriber subscribes: after the 1 s rate window that closes at 1,000 ms.
const SUBSCRIBE_AT: u64 = 1100

// Packet sizes in bytes of q and h (every 20 ms) and f (every 10 ms); 0 sends none.
type Shape {
    q: u64,
    h: u64,
    f: u64
}

/// One packet the subscriber received past the policer: when, its header, and the
/// encoding it carries (`FILL_Q`, `FILL_H`, `FILL_F`) or 0 for padding.
type Heard {
    at: u64,
    h: rtp.header.Header,
    fill: u8
}

type Probed {
    r: router.Router,
    out: peer.Outbox,
    p: Client,
    s: Client,
    log: rtp.twcc.RecvLog,
    // The policer's credit in bit-nanoseconds per second, refilled to `filled`.
    credit: u64,
    filled: u64,
    media: u32,
    seqs: List[u16],
    heard: List[Heard]
}

fn probe_room(seed: u64, limits: router.RoomLimits, rtx: Bytes) -> Probed {
    probe_room_from(seed, limits, rtx, 300000)
}

// The same, with the subscriber's session starting its estimate at `start_bps`.
fn probe_room_from(seed: u64, limits: router.RoomLimits, rtx: Bytes, start_bps: u64) -> Probed {
    let mut r = router.router(provide.random(seed))
    result.unwrap(router.open_room(mut r, room_id(), limits))
    let out = result.unwrap(peer.outbox(262144, 256))
    let p = admit(mut r, seed + 1, simulcast_offer(), 1)
    let mut offer = minimal_head(b" d")
    recv_section(mut offer, b"d", b"96", rtx, b"1", b"3")
    let s = admit_limits(mut r, seed + 2, offer, 2, peer.PeerLimits(sections: 8, down_tracks: 4, rtx_bytes: 1048576, pacer_packets: 64, start_bps: start_bps, dtls_transport: peer.DTLS_DEFAULT))
    let mut seqs: List[u16] = list.new()
    for k in 0u16 .. 3u16 {
        list.push(mut seqs, 100 * k)
    }
    Probed(r: take r, out: take out, p: take p, s: take s, log: result.unwrap(rtp.twcc.recv_log(1024)), credit: POLICE_DEPTH * 8 * 1000000000, filled: 0, media: 0, seqs: take seqs, heard: list.new())
}

// The publisher's packet of encoding `e` (0 q, 1 h, 2 f) at `now`: `size` bytes up to
// its payload's end (20 bytes of header with MID and RID), a keyframe filled with the
// encoding's byte.
fn publish_one(mut w: Probed, e: u64, size: u64, now: u64) {
    let fills =[FILL_Q, FILL_H, FILL_F]
    publish_from(mut w.r, mut w.p, mut w.seqs, e, size, fills[e], now, mut w.out)
}

// The same from publisher `p`, filled with `fill`.
fn publish_from(mut r: router.Router, mut p: Client, mut seqs: List[u16], e: u64, size: u64, fill: u8, now: u64, mut out: peer.Outbox) {
    let rids =[b"q", b"h", b"f"]
    let mut body = vp8_key()
    while list.len(body) + 20 < size {
        list.push(mut body, fill)
    }
    let seq = seqs[e]
    seqs[e] = seq + 1
    let ssrc = E0 + int.narrow(e)
    let ts: u32 = int.truncate(now / MS * 90)
    let packet = rid_media(mut p.cs, ssrc, seq, ts, rids[e], body)
    feed(mut r, now, p.who, p.at, packet, mut out)
}

// Everything the router sent the subscriber since the last call arrives at `now`
// through the policer; each RTP packet that passes is logged for TWCC and heard.
fn arrive(mut w: Probed, now: u64) {
    for tx in w.out.pkts {
        let UdpTx(to, at, len, ecn: _) = tx
        if to != w.s.at {
            continue
        }
        w.credit = order.min(w.credit + (now - w.filled) * POLICE_BPS, POLICE_DEPTH * 8 * 1000000000)
        w.filled = now
        let cost = len * 8 * 1000000000
        if cost > w.credit {
            continue
        }
        w.credit -= cost
        let mut b = copy_of(list.slice(w.out.data, at, at + len))
        if (b[0] >> 6) != 2 || (b[1] >= 192 && b[1] <= 223) {
            continue
        }
        let opened = match srtp.unprotect_rtp(mut w.s.cs, mut b) {
            Ok(o) => o,
            Error(_) => fail("the subscriber could not open a packet from the router"),
        }
        list.truncate(mut b, opened.length)
        let h = result.unwrap(rtp.header.parse(b))
        let g = Got(h: h, pkt: copy_of(b))
        let Some(tn) = ext_value(g, SUB_TWCC, TransportSeq) else {
            fail("a packet to the subscriber has no transport-wide sequence number")
        }
        rtp.twcc.on_packet(mut w.log, list.word_be(tn, 0), now)
        // The payload ends before the padding (RFC 3550 section 5.1): padding-only
        // packets have none and are heard as 0.
        let body_end = if h.padded {
            let pad: u64 = int.widen(b[list.len(b) - 1])
            list.len(b) - pad
        } else {
            list.len(b)
        }
        let fill = if body_end > h.end {
            b[body_end - 1]
        } else {
            0
        }
        if h.padded && fill != 0 {
            fail("a padded packet to the subscriber carries a payload")
        }
        if fill != 0 && w.media == 0 {
            w.media = h.ssrc
        }
        list.push(mut w.heard, Heard(at: now, h: h, fill: fill))
    }
    peer.clear_outbox(mut w.out)
}

// The subscriber's compound feedback at `now`: receiver report, CNAME and TWCC.
fn feed_back(mut w: Probed, now: u64) {
    let mut b: Bytes = list.with_capacity(1500)
    let empty: List[rtp.rtcp.Block] = list.new()
    let _ = result.unwrap(rtp.rtcp.write_rr(CLIENT_SSRC, view empty, mut b))
    let _ = result.unwrap(rtp.rtcp.write_cname(CLIENT_SSRC, b"browser", mut b))
    if result.unwrap(rtp.twcc.write(mut w.log, CLIENT_SSRC, w.media, 1200, mut b)) == 0 {
        return
    }
    feed(mut w.r, now, w.s.who, w.s.at, sealed_rtcp(mut w.s.cs, take b), mut w.out)
}

// Run from 0 to `until` ms: the publisher sends `shape`, the subscriber subscribes
// to `target` at `SUBSCRIBE_AT` and, when `feedback`, answers every 50 ms after.
fn run(mut w: Probed, shape: Shape, target: router.Target, feedback: bool, until: u64) {
    run_gap(mut w, shape, target, feedback, until, 0, 0)
}

// The same, with f silent from `quiet` ms until `back` ms.
fn run_gap(mut w: Probed, shape: Shape, target: router.Target, feedback: bool, until: u64, quiet: u64, back: u64) {
    let room = room_id()
    let pa = result.unwrap(router.publish(mut w.r, room, w.p.who, 0))
    let sub = SUBSCRIBE_AT * MS
    let end = until * MS
    let mut subscribed = false
    let mut next_pub = 0u64
    let mut next_answer = sub + 50 * MS
    let mut now = 0u64
    while now < end {
        if now == next_pub {
            if now % (20 * MS) == 0 {
                if shape.q != 0 {
                    publish_one(mut w, 0, shape.q, now)
                }
                if shape.h != 0 {
                    publish_one(mut w, 1, shape.h, now)
                }
            }
            if shape.f != 0 && (now < quiet * MS || now >= back * MS) {
                publish_one(mut w, 2, shape.f, now)
            }
            next_pub += 10 * MS
        }
        if !subscribed && now == sub {
            result.unwrap(router.subscribe(mut w.r, room, w.s.who, pa, 0, target, now, mut w.out))
            subscribed = true
        }
        if feedback && now == next_answer {
            feed_back(mut w, now)
            next_answer += 50 * MS
        }
        // A session that transmitted answers `now`: poll again until it waits.
        let mut wake = router.poll(mut w.r, now, mut w.out)
        let mut again = 0u64
        while wake == Some(now) && again < 64 {
            wake = router.poll(mut w.r, now, mut w.out)
            again += 1
        }
        arrive(mut w, now)
        let mut next = order.min(next_pub, if subscribed {
            next_answer
        } else {
            sub
        })
        if !feedback && subscribed {
            next = next_pub
        }
        if let Some(t) = wake {
            if t > now && t < next {
                next = t
            }
        }
        now = next
    }
}

fn first_of(w: Probed, fill: u8) -> Option[u64] {
    for x in w.heard {
        if x.fill == fill {
            return Some(x.at)
        }
    }
    None
}

fn shape_ramp() -> Shape {
    Shape(q: 300, h: 1250, f: 1250)
}

fn top_f() -> router.Target {
    Layer(encoding: 2, spatial: 0, temporal: 0)
}

/// bug: never probe, so an estimate that starts below a down-track's target stays there and the leg sits on q for good; probe only on the start estimate and not again after the first result; drop the media packets of a running cluster from its members; or retry a cluster only after the 5 s gate when the last one raised the estimate.
/// oracle: RTC-6 and RTP-9 by hand. Rates from packet sizes: q 300 B every 20 ms = 120,000, h 1,250 B every 20 ms = 500,000 and f 1,250 B every 10 ms = 1,000,000 bit/s. At subscribe (1,100 ms) the 300,000 start estimate takes q (the first step) and leaves 180,000, under h's step of 380,000, so the down-track is short of f and asks for 1,250,000 (f's rate plus a quarter). Without probing the estimate cannot rise: delay-based increase stops at 1.5 x the 120,000 acked + 10,000 = 190,000, under 300,000. Round 1 probes at min(1,250,000, 2 x 300,000) = 600,000; its result, read at the 50 ms feedback, is at least 0.98 x 600,000 = 588,000 (TWCC's 250 us arrival quantum over a 15 ms cluster), so h's step fits (588,000 - 120,000 >= 380,000) and f's does not. Round 2 starts at once since the estimate rose, at min(1,250,000, 2 x 588,000) >= 1,176,000, read at the next feedback as >= 1,152,000, so f's step of 500,000 fits beside h (1,152,000 - 500,000). Every f packet is a keyframe, so the switch lands within f's 10 ms; the policer's 2 Mbit/s passes the 1,176,000 cluster and f. Bound: 50 ms + 50 ms + 10 ms + one 50 ms feedback of slack = 160 ms after subscribe; after the switch the down-track forwards f only.
@test
fn probe_ramps_to_top_layer() -> Result[(), router.RouterError] {
    let mut w = probe_room(2690, room_limits(), b"97")
    run(mut w, shape_ramp(), top_f(), true, SUBSCRIBE_AT + 600)
    let sub = SUBSCRIBE_AT * MS
    let Some(f_at) = first_of(w, FILL_F) else {
        fail("the down-track never reached f: the estimate stayed below its target")
    }
    if f_at > sub + 160 * MS {
        fail("the down-track reached f later than two probe rounds and a keyframe after subscribe")
    }
    let Some(h_at) = first_of(w, FILL_H) else {
        fail("the down-track skipped h: the first probe's 600,000 could not carry f")
    }
    if h_at > f_at {
        fail("h came after f: the first probe was not capped at twice the estimate")
    }
    for x in w.heard {
        if x.at > f_at + 20 * MS && x.fill != 0 && x.fill != FILL_F {
            fail("the down-track left f after reaching it")
        }
    }
    Ok(())
}

/// bug: pad without limit (the pacer's padding rate left at the target), send padding on the media SSRC or payload type when the leg has RTX, carry a media payload in padding, skip or reuse RTX sequence numbers, or start a new cluster while the last is outstanding.
/// oracle: RTP-9, RTP-10 and RFC 4588 by hand. With q at 120,000 and the 300,000 start estimate the down-track is short of f, so one cluster at 600,000 bit/s starts at subscribe. Its probes are max(200, 600,000 / 8,000) = 200 bytes, one per 200 x 8 / 600,000 = 2.67 ms; the cluster ends at the first probe that is at least the 5th and at least 15 ms after the first, the 7th at 16 ms, or sooner when q's media fills slots; so 5 to 7 padding packets. With no feedback the cluster gives no result and is outstanding for 1 s: nothing more pads in the run, which ends just before 1 s after subscribe. Each padding packet goes on the leg's RTX payload type 97 and its own SSRC (not the media SSRC), with the P bit set and no payload before the pad count, on consecutive RTX sequence numbers.
@test
fn probe_padding_stays_in_budget() -> Result[(), router.RouterError] {
    let mut w = probe_room(2700, room_limits(), b"97")
    run(mut w, shape_ramp(), top_f(), false, SUBSCRIBE_AT + 1000)
    let mut n = 0u64
    let mut last: Option[u16] = None
    for x in w.heard {
        if x.fill != 0 {
            continue
        }
        n += 1
        if x.h.pt != SUB_RTX_PT || x.h.ssrc == w.media || x.h.ssrc == 0 {
            fail("padding is not on the leg's RTX payload type and SSRC")
        }
        if !x.h.padded {
            fail("a padding packet lacks the P bit")
        }
        if let Some(prev) = last {
            if x.h.seq != int.wrapping_add(prev, 1u16) {
                fail("padding skipped or reused an RTX sequence number")
            }
        }
        last = Some(x.h.seq)
    }
    if n < 5 || n > 7 {
        fail("padding is not one cluster of 5 to 7 probes")
    }
    if w.media == 0 {
        fail("no media reached the subscriber")
    }
    Ok(())
}

/// bug: retry a cluster that raised nothing only after the 5 s gate from the session's start, so a first cluster that gets no result (feedback not yet flowing) leaves the leg on q for 5 s; or keep retrying every second for good, so a link that cannot carry more is probed at every chance.
/// oracle: RTC-6 and libwebrtc's ProbeController (repeated initial probing: initial_probing 5 s, kMaxWaitingTimeForProbingResult 1 s; then kAlrPeriodicProbingInterval 5 s) by hand. With no feedback no cluster raises the 300,000 estimate, so the down-track stays short of f. The first cluster starts at subscribe, 1,100 ms. Within 5 s of it the next starts 1 s after the last: 2,100, 3,100, 4,100 and 5,100 ms (each expired at exactly 1 s, and the run polls every 10 ms on the publisher's packets). At 6,100 ms the window has closed, so the next waits 5 s from 5,100, to 10,100 ms, past the run's end at 8,100. So five clusters, each heard within 20 ms of its start (its 5 to 7 probes take at most 16 ms), and no padding after 5,120 ms.
@test
fn initial_probes_retry_each_second() -> Result[(), router.RouterError] {
    let mut w = probe_room(2740, room_limits(), b"97")
    run(mut w, shape_ramp(), top_f(), false, SUBSCRIBE_AT + 7000)
    let mut starts: List[u64] = list.new()
    let mut last = 0u64
    for x in w.heard {
        if x.fill != 0 {
            continue
        }
        if list.len(starts) == 0 || x.at > last + 100 * MS {
            list.push(mut starts, x.at)
        }
        last = x.at
    }
    if list.len(starts) < 2 {
        fail("a cluster that raised nothing was not retried within the initial 5 s")
    }
    if list.len(starts) != 5 {
        fail("not five initial clusters: retried other than every second for 5 s")
    }
    for k in 0u64 .. 5u64 {
        let at = (SUBSCRIBE_AT + 1000 * k) * MS
        if starts[k] < at || starts[k] > at + 20 * MS {
            fail("an initial cluster did not start 1 s after the last")
        }
    }
    if last > (SUBSCRIBE_AT + 4020) * MS {
        fail("padding went on past the initial clusters")
    }
    Ok(())
}

fn pause_limits(pause: bool) -> router.RoomLimits {
    router.RoomLimits(participants: 16, ids: 16, publications: 8, down_tracks: 8, audio_forward: 0, pause_delay_ms: 5000, pause: pause)
}

/// bug: let the opt-in pause also apply when the room does not declare it (2651's stall again), keep a paused leg out of the probe's want so it never resumes, or forward a paused leg's media.
/// oracle: RTC-6 and LiveKit's allowPause by hand. q alone at 1,000 B every 20 ms = 400,000 bit/s, over the 300,000 start estimate. Without pause the first step is taken anyway, so q reaches the subscriber from its first packet after subscribe (within 20 ms). With pause the leg starts Off and asks for 400,000 + a quarter = 500,000; the cluster at min(500,000, 600,000) gives at least 0.98 x 500,000 = 490,000 at the 50 ms feedback, q fits, and its next keyframe (20 ms) resumes it: no media before the feedback, media within 50 + 20 + one 50 ms feedback of slack = 120 ms.
@test
fn probe_resumes_paused_leg() -> Result[(), router.RouterError] {
    let base: router.Target = Layer(encoding: 0, spatial: 0, temporal: 0)
    let shape = Shape(q: 1000, h: 0, f: 0)
    let sub = SUBSCRIBE_AT * MS
    let mut kept = probe_room(2710, pause_limits(false), b"97")
    run(mut kept, shape, base, true, SUBSCRIBE_AT + 300)
    let Some(k_at) = first_of(kept, FILL_Q) else {
        fail("without pause the base layer was not given")
    }
    if k_at > sub + 20 * MS {
        fail("without pause the base layer waited for an estimate")
    }
    let mut paused = probe_room(2720, pause_limits(true), b"97")
    run(mut paused, shape, base, true, SUBSCRIBE_AT + 300)
    let Some(p_at) = first_of(paused, FILL_Q) else {
        fail("the paused leg never resumed: no probe asked for its base layer")
    }
    if p_at < sub + 50 * MS {
        fail("the paused leg sent media before a probe raised the estimate")
    }
    if p_at > sub + 120 * MS {
        fail("the paused leg resumed later than one probe round and a keyframe")
    }
    Ok(())
}

/// bug: start a cluster that has no packet to pad on when the leg has no RTX, pad on another SSRC or payload type than the leg's media, pad inside a frame, or leave the next media packet's number where it was, so the subscriber sees padding reuse a media number or a gap it NACKs.
/// oracle: RTP-11 `pad`, RFC 3550 section 5.1 and RTC-6 by hand. The leg negotiated no RTX, so padding goes on its media SSRC and payload type 96, with the P bit and no payload, at the timestamp of the media packet before it. Every q packet is a one-packet frame, so each number after the first forwarded q packet is free for padding; the cluster starts once one is forwarded (the q at 1,120 ms) and, as in the RTX case, sends 5 to 7 probes of 200 bytes at 600,000 bit/s. The media SSRC's numbers, media and padding together, run without a gap or a repeat from the first to the last heard, and each padding number follows a packet that ended a frame (marker set) or another padding packet. With no feedback the estimate stays at 300,000, so the leg stays on q and hears every q frame from 1,120 ms to 2,080 ms: 49.
@test
fn probe_pads_media_without_rtx() -> Result[(), router.RouterError] {
    let mut w = probe_room(2730, room_limits(), b"")
    run(mut w, shape_ramp(), top_f(), false, SUBSCRIBE_AT + 1000)
    let mut seqs: List[u16] = list.new()
    let mut pads = 0u64
    for x in w.heard {
        if x.h.ssrc != w.media {
            fail("a packet went out on an SSRC other than the leg's media SSRC")
        }
        if x.fill == 0 {
            pads += 1
            if x.h.pt != 96 || !x.h.padded {
                fail("padding is not on the media payload type with the P bit")
            }
        }
        list.push(mut seqs, x.h.seq)
    }
    if pads < 5 || pads > 7 {
        fail("padding is not one cluster of 5 to 7 probes")
    }
    if list.len(w.heard) - pads != 49 {
        fail("a q frame was lost: padding took a number media needed")
    }
    // In number order, each number follows the last, and padding follows a frame end.
    let first = seqs[0]
    let n = list.len(seqs)
    for k in 0u64 .. n {
        let want = int.wrapping_add(first, int.truncate(k))
        let mut found: Option[u64] = None
        for j in 0u64 .. n {
            if w.heard[j].h.seq == want {
                if found != None {
                    fail("two packets on the media SSRC share a number")
                }
                found = Some(j)
            }
        }
        let Some(j) = found else {
            fail("the media SSRC's numbers have a gap")
        }
        if w.heard[j].fill == 0 {
            if k == 0 {
                fail("padding came before any media")
            }
            let prev = int.wrapping_add(first, int.truncate(k - 1))
            for i in 0u64 .. n {
                if w.heard[i].h.seq == prev {
                    let x = w.heard[i]
                    if x.fill != 0 && !x.h.marker {
                        fail("padding split a frame")
                    }
                    if x.h.ts != w.heard[j].h.ts {
                        fail("padding does not carry the timestamp of the packet before it")
                    }
                }
            }
        }
    }
    Ok(())
}

// The encodings the subscriber heard media of, as a mask: bit 0 q, 1 h, 2 f.
fn heard_mask(w: Probed) -> u64 {
    let mut mask = 0u64
    for x in w.heard {
        if x.fill == FILL_Q {
            mask = mask | 1
        } else if x.fill == FILL_H {
            mask = mask | 2
        } else if x.fill == FILL_F {
            mask = mask | 4
        }
    }
    mask
}

/// bug: start every session's estimate at a hard-coded 300,000 bit/s whatever its `PeerLimits.start_bps` says, so a deployment that knows its links are fast still opens every leg on its lowest layer and waits for probing.
/// oracle: RTC-6's allocation by hand from the start estimate, with no feedback so the estimate never moves. The rates of `shape_ramp` are q 120,000, h 500,000 and f 1,000,000 bit/s, so the steps cost 120,000, 380,000 and 500,000. From 1,200,000: q leaves 1,080,000, h 700,000 and f 200,000, so the down-track is given f at subscribe and, f being all keyframes, hears its first f packet within f's 10 ms and never q or h. From 600,000: q leaves 480,000 and h 100,000, under f's 500,000, so the down-track is given h and hears only h. With the start hard-coded at 300,000 both legs hear only q.
@test
fn start_estimate_is_the_sessions() -> Result[(), router.RouterError] {
    let sub = SUBSCRIBE_AT * MS
    let mut fast = probe_room_from(2740, room_limits(), b"97", 1200000)
    run(mut fast, shape_ramp(), top_f(), false, SUBSCRIBE_AT + 500)
    if heard_mask(fast) != 4 {
        fail("from a 1,200,000 start the down-track did not hear f alone")
    }
    let Some(f_at) = first_of(fast, FILL_F) else {
        fail("from a 1,200,000 start the down-track heard no f")
    }
    if f_at > sub + 10 * MS {
        fail("from a 1,200,000 start f came later than its first keyframe after subscribe")
    }
    let mut middle = probe_room_from(2750, room_limits(), b"97", 600000)
    run(mut middle, shape_ramp(), top_f(), false, SUBSCRIBE_AT + 500)
    if heard_mask(middle) != 2 {
        fail("from a 600,000 start the down-track did not hear h alone")
    }
    Ok(())
}

// A's fills in `two_publishers`.
const FILL_AQ: u8 = 0x61

const FILL_AH: u8 = 0x62

const FILL_AF: u8 = 0x63

// W24's room with two simulcast publishers, A (published first, so the lower id)
// and B (`w.p`), and a subscriber with two receiving sections whose estimate starts
// at `start_bps`. A sends q and h as `shape_ramp` and f in `a_f`-byte packets every
// 10 ms (0 sends none); B sends all three as `shape_ramp`. The subscriber subscribes
// to A on its first section and B on its second, both at f, at `SUBSCRIBE_AT`, and
// gives no feedback. Returns what it heard.
fn two_publishers(seed: u64, until: u64, a_f: u64, start_bps: u64) -> List[Heard] {
    let room = room_id()
    let mut r = router.router(provide.random(seed))
    result.unwrap(router.open_room(mut r, room, room_limits()))
    let out = result.unwrap(peer.outbox(262144, 256))
    let mut a = admit(mut r, seed + 1, simulcast_offer(), 1)
    let p = admit(mut r, seed + 3, simulcast_offer(), 3)
    let mut offer = minimal_head(b" d e")
    recv_section(mut offer, b"d", b"96", b"97", b"1", b"3")
    recv_section(mut offer, b"e", b"96", b"97", b"1", b"3")
    let s = admit_limits(mut r, seed + 2, offer, 2, peer.PeerLimits(sections: 8, down_tracks: 4, rtx_bytes: 1048576, pacer_packets: 64, start_bps: start_bps, dtls_transport: peer.DTLS_DEFAULT))
    let mut a_seqs: List[u16] = list.new()
    let mut seqs: List[u16] = list.new()
    for k in 0u16 .. 3u16 {
        list.push(mut a_seqs, 100 * k)
        list.push(mut seqs, 100 * k)
    }
    let mut w = Probed(r: take r, out: take out, p: take p, s: take s, log: result.unwrap(rtp.twcc.recv_log(1024)), credit: POLICE_DEPTH * 8 * 1000000000, filled: 0, media: 0, seqs: take seqs, heard: list.new())
    let pa = result.unwrap(router.publish(mut w.r, room, a.who, 0))
    let pb = result.unwrap(router.publish(mut w.r, room, w.p.who, 0))
    let sub = SUBSCRIBE_AT * MS
    let mut now = 0u64
    while now < until * MS {
        if now % (20 * MS) == 0 {
            publish_from(mut w.r, mut a, mut a_seqs, 0, 300, FILL_AQ, now, mut w.out)
            publish_from(mut w.r, mut a, mut a_seqs, 1, 1250, FILL_AH, now, mut w.out)
            publish_one(mut w, 0, 300, now)
            publish_one(mut w, 1, 1250, now)
        }
        if a_f != 0 {
            publish_from(mut w.r, mut a, mut a_seqs, 2, a_f, FILL_AF, now, mut w.out)
        }
        publish_one(mut w, 2, 1250, now)
        if now == sub {
            result.unwrap(router.subscribe(mut w.r, room, w.s.who, pa, 0, top_f(), now, mut w.out))
            result.unwrap(router.subscribe(mut w.r, room, w.s.who, pb, 1, top_f(), now, mut w.out))
        }
        let mut wake = router.poll(mut w.r, now, mut w.out)
        let mut again = 0u64
        while wake == Some(now) && again < 64 {
            wake = router.poll(mut w.r, now, mut w.out)
            again += 1
        }
        arrive(mut w, now)
        now += 10 * MS
    }
    replace(mut w.heard, list.new())
}

/// bug: price a step to an encoding the publisher never sent at its rate of 0, so the cost is negative (0 less the rate of the level it leaves): the down-track is given the silent encoding over the live one below it and freezes waiting for a keyframe that never comes, and the negative cost hands its budget to the next publication, which is raised past what the estimate carries.
/// oracle: RTC-6's allocation by hand, with no feedback so the estimate stays at its 1,200,000 start. Rates from packet sizes: q 120,000, h 500,000 and B's f 1,000,000 bit/s; A's f sent nothing in the window that closed at 1,000 ms and was never measured, so it is stopped and the allocation passes over it. Ascending id, A first. Round 1: A's q 120,000 and B's q 120,000 leave 960,000. Round 2: A's h and B's h at 380,000 each leave 200,000. Round 3: A has no next step (its f is stopped) and B's f costs 500,000, over 200,000. So A forwards h and B forwards h, each heard from its first keyframe after subscribe (h every 20 ms), and the subscriber never hears q or B's f. Pricing A's f at 0 - 500,000 instead leaves A pending on f, heard never, and 700,000 for B's f, which it takes.
@test
fn stopped_stream_is_not_priced() -> Result[(), router.RouterError] {
    let sub = SUBSCRIBE_AT * MS
    let heard = two_publishers(2760, SUBSCRIBE_AT + 500, 0, 1200000)
    let mut a_h = false
    let mut b_h = false
    for x in heard {
        if x.fill == FILL_F {
            fail("B's down-track was given f on a budget A's silent f made")
        }
        if x.fill == FILL_AH {
            a_h = true
        } else if x.fill == FILL_H {
            b_h = true
        } else if x.fill != 0 {
            fail("a down-track forwarded another encoding than h")
        }
        if x.at > sub + 20 * MS && !(a_h && b_h) {
            fail("A's or B's down-track heard no h by its first keyframe after subscribe")
        }
    }
    if !(a_h && b_h) {
        fail("A's down-track waited on its silent f instead of forwarding h")
    }
    Ok(())
}

/// bug: keep forwarding, or waiting on, a stream the publisher stopped without a layers allocation saying so (the freeze); treat one quiet window as a stop; or leave the subscriber on the lower stream once the publisher resumes the stopped one.
/// oracle: RTC-6 by hand, with no feedback so the estimate stays at 1,200,000, and the rates of `shape_ramp` (q 120,000, h 500,000, f 1,000,000; the window closing at 2,000 ms measures f's last half second at 500,000). The down-track is given f at subscribe and hears only f until f's last packet at 1,490 ms. Rate windows close at 2,000, 3,000 and 4,000 ms; f had packets in the first, none in the next two, so it is stopped at the q packet of 4,000 ms. The allocation passes over f, gives h (budget 1,200,000 - 120,000 - 380,000), and h's keyframe at 4,000 ms switches the down-track: nothing is heard in [1,500, 4,000) and h from 4,000 ms. f's packet at 5,000 ms ends the stop; f at 500,000 costs 0 over h and is given again, and that packet, a keyframe, switches the down-track back: after 5,000 ms only f is heard.
@test
fn silent_stream_moves_its_viewers() -> Result[(), router.RouterError] {
    let mut w = probe_room_from(2770, room_limits(), b"97", 1200000)
    run_gap(mut w, shape_ramp(), top_f(), false, 5500, 1500, 5000)
    let mut h_at: Option[u64] = None
    let mut f_back = false
    for x in w.heard {
        if x.fill == 0 {
            continue
        }
        let ms = x.at / MS
        if ms < 1500 && x.fill != FILL_F {
            fail("before f stopped the down-track heard another encoding than f")
        }
        if ms >= 1500 && ms < 4000 {
            fail("the down-track heard media while f was quiet and not yet stopped")
        }
        if ms >= 4000 && ms < 5000 && x.fill != FILL_H {
            fail("after f stopped the down-track heard another encoding than h")
        }
        if x.fill == FILL_H && h_at == None {
            h_at = Some(ms)
        }
        if ms > 5000 && x.fill != FILL_F {
            fail("after f resumed the down-track stayed off it")
        }
        if ms >= 5000 && x.fill == FILL_F {
            f_back = true
        }
    }
    if h_at != Some(4000) {
        fail("the down-track did not move to h at the window that stopped f")
    }
    if !f_back {
        fail("the down-track did not go back to f when the publisher resumed it")
    }
    Ok(())
}

/// bug: price a step to an encoding whose rate is below the level it leaves (a publisher whose top stream runs leaner than the one under it, or a remote unit still holding a stale rate) at that negative difference, so the step frees budget and the next publication is raised past what the estimate carries.
/// oracle: RTC-6's allocation by hand, with no feedback so the estimate stays at its 1,300,000 start. A sends q 120,000, h 500,000 and f in 300-byte packets every 10 ms, 240,000 bit/s; B sends `shape_ramp`, f at 1,000,000. Ascending id, A first. Round 1: both q at 120,000 leave 1,060,000. Round 2: both h at 380,000 leave 300,000. Round 3: A's f costs max(240,000 - 500,000, 0) = 0 and is taken; B's f costs 500,000, over 300,000. So A forwards f and B h, each from its first keyframe after subscribe, and B's f is never heard. At the negative cost A's step frees 260,000, leaving 560,000, and B takes f.
@test
fn step_cost_is_never_negative() -> Result[(), router.RouterError] {
    let sub = SUBSCRIBE_AT * MS
    let heard = two_publishers(2780, SUBSCRIBE_AT + 500, 300, 1300000)
    let mut a_f = false
    let mut b_h = false
    for x in heard {
        if x.fill == FILL_F {
            fail("B's down-track was given f on budget A's cheaper f freed")
        }
        if x.fill == FILL_AF {
            a_f = true
        } else if x.fill == FILL_H {
            b_h = true
        } else if x.fill != 0 {
            fail("a down-track forwarded another encoding than A's f or B's h")
        }
        if x.at > sub + 20 * MS && !(a_f && b_h) {
            fail("A's f or B's h was not heard by its first keyframe after subscribe")
        }
    }
    if !(a_f && b_h) {
        fail("A's down-track did not reach its f, or B's its h")
    }
    Ok(())
}

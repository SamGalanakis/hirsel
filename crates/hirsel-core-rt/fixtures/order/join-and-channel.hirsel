// hand-derived stdout: R7
// C closes the channel R waits on, then ends and readies P's join.
type Input:send { rx: Receiver[u64], out: Stdout }
fn receive(take input: Input) waits {
    let Input(rx: rx, out: out) = take input
    match channel.receive(rx) {
        Error(_) => result.unwrap(stdout.write(out, "R")),
        Ok(_) => result.unwrap(stdout.write(out, "?"))
    }
}
fn close(take tx: Sender[u64]) -> u64 {
    { let _ = take tx }
    7u64
}
pub fn main(tasks: Tasks, out: Stdout) -> Result[(), Exit] waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(1)
    let r = task.spawn(tasks, bytes 4096, Input(rx: take rx, out: out), receive)
    let c = task.spawn(tasks, bytes 4096, take tx, close)
    if result.unwrap(task.join(take c)) == 7u64 { result.unwrap(stdout.write(out, "7")) }
    result.unwrap(task.join(take r))
    Ok(())
}

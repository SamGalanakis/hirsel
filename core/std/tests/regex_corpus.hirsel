fn oracle_name(pattern: String, name: String, expected: Option[u64]) -> bool {
    match new(pattern) {
        Ok(re) => group_index(re, name) == expected,
        Error(_) => false,
    }
}

// expect: run regex_group_names() = true
fn regex_group_names() -> bool {
    if !oracle_name("(a)|b(?<gone>c){0}", "gone", None) {
        return false
    }
    if !oracle_name("(?<gone>a){0}(?<live>a)", "gone", None) {
        return false
    }
    if !oracle_name("(?<gone>a){0}(?<live>a)", "live", Some(2)) {
        return false
    }
    if !oracle_name("(?<empty>)a", "empty", Some(1)) {
        return false
    }
    if !oracle_name("(?P<x>^a)|(?P<y>a)", "x", Some(1)) {
        return false
    }
    if !oracle_name("(?P<x>^a)|(?P<y>a)", "y", Some(2)) {
        return false
    }
    if !oracle_name("(?<é.2[3]>a)", "é.2[3]", Some(1)) {
        return false
    }
    true
}


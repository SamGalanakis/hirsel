// rule: STORE-11
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"}}
// steps: 20000000
// A finalizer follows the code that drops its value (storage.md STORE-11
// "Energy"). Dropped in a transaction body it is charged: a finalizer whose loop
// is far over the budget ends the transaction Limit(Energy()) with nothing
// committed, and one far under it commits. That holds both for a direct drop and
// for one through a container's drop glue. Dropped in uncharged code, the same
// finalizer runs to completion unmetered.
@serializable
type Spun = Db(store.TxError)

resource type Spin {
  n: u64,
}
drop(x) {
  let mut sum: u64 = 0
  for i in 0u64..x.n {
    sum = int.wrapping_add(sum, i)
  }
  let _ = sum
}

// Writes n's low byte under `held`, then drops a Spin of `n` iterations.
fn holds(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[u64, Spun] {
  let mut v: List[u8] = []
  list.push(mut v, int.truncate(n))
  store.tx_put(mut tx, b"held", bytes.from_list(take v)) ? Db
  let _ = Spin(n: n)
  Ok(n)
}

// The same through drop glue: the Spin is dropped with the list holding it.
fn listed(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[u64, Spun] {
  let mut v: List[u8] = []
  list.push(mut v, int.truncate(n))
  store.tx_put(mut tx, b"listed", bytes.from_list(take v)) ? Db
  let _ = [Spin(n: n)]
  Ok(n)
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let at = authority.floor(a)
  let mut config = store.default_config()
  config.energy = 100000
  let mut s = store.open(a, config) ? Store
  let under: Result[u64, store.TxFailure[Spun]] = store.transact(mut s, holds, 10u64)
  check(under == Ok(10))?
  let over: Result[u64, store.TxFailure[Spun]] = store.transact(
    mut s,
    holds,
    10000000u64
  )
  check(over == Error(Limit(Energy())))?
  let listed_under: Result[u64, store.TxFailure[Spun]] = store.transact(
    mut s,
    listed,
    10u64
  )
  check(listed_under == Ok(10))?
  let listed_over: Result[u64, store.TxFailure[Spun]] = store.transact(
    mut s,
    listed,
    10000000u64
  )
  check(listed_over == Error(Limit(Energy())))?
  let after = store.snapshot(a, mut s, at) ? Store
  check(store.get(take after, b"held") == Some(b"\x0a"))?
  let later = store.snapshot(a, mut s, at) ? Store
  check(store.get(take later, b"listed") == Some(b"\x0a"))?
  store.close(take s) ? Store
  // Uncharged: a finalizer of twice the budget runs to its end.
  let _ = Spin(n: 200000u64)
  Ok(())
}

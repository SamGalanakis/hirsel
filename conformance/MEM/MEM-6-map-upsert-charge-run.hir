// rule: MEM-6
// expect: run
// A vacant entry is charged before initialization; a hit consumes no budget.
pub fn main(t: Test) -> Result[(), ()] {
  let over = arena.bounded(
    0u64,
    fn(a: Arena) -> u64 {
      let mut m: unique Map[u64, u64] in a = map.empty()
      std@1/map.upsert(
        mut m,
        1,
        fn() -> unique u64 uses {} {
          failure.check(false, Bounds())
          0
        },
        fn(mut v: unique u64) -> () uses {} {
          v += 1
        }
      )
      0
    }
  )
  failure.check(over == Error(OutOfSpace()), Bounds())
  let fits = arena.bounded(
    16u64,
    fn(a: Arena) -> u64 {
      let mut m: unique Map[u64, u64] in a = map.empty()
      std@1/map.upsert(
        mut m,
        1,
        fn() -> unique u64 uses {} {
          1
        },
        fn(mut v: unique u64) -> () uses {} {
          v += 1
        }
      )
      std@1/map.upsert(
        mut m,
        1,
        fn() -> unique u64 uses {} {
          failure.check(false, Bounds())
          0
        },
        fn(mut v: unique u64) -> () uses {} {
          v += 2
        }
      )
      failure.check(
        std@1/map.update(
          mut m,
          1,
          fn(mut v: unique u64) -> () uses {} {
            v += 4
          }
        ),
        Bounds()
      )
      match map.get(m, 1) {
        Some(v) => v,
        None() => 0,
      }
    }
  )
  failure.check(fits == Ok(7u64), Bounds())
  // Fallible entry initializers obey the same sixteen-byte pair charge.
  let absent = arena.bounded(
    0u64,
    fn(a: Arena) -> u64 {
      let mut m: Map[u64, u64] in a = map.empty()
      let mut state: u64 = 0
      let _ = std@1/map.try_insert(
        mut m,
        1,
        mut state,
        fn(mut cursor: u64) -> Result[u64, u64] uses {} {
          failure.check(false, Bounds())
          Ok(0)
        }
      )
      state
    }
  )
  failure.check(absent == Error(OutOfSpace()), Bounds())
  let no_refund = arena.bounded(
    16u64,
    fn(a: Arena) -> u64 {
      let mut m: Map[u64, u64] in a = map.empty()
      let mut state: u64 = 0
      failure.check(
        std@1/map.try_insert(
          mut m,
          1,
          mut state,
          fn(mut cursor: u64) -> Result[u64, u64] uses {} {
            cursor += 1
            Error(7)
          }
        ) == Error(7),
        Bounds()
      )
      failure.check(state == 1 && map.len(m) == 0, Bounds())
      let _ = std@1/map.try_insert(
        mut m,
        1,
        mut state,
        fn(mut cursor: u64) -> Result[u64, u64] uses {} {
          failure.check(false, Bounds())
          Ok(0)
        }
      )
      state
    }
  )
  failure.check(no_refund == Error(OutOfSpace()), Bounds())
  Ok(())
}

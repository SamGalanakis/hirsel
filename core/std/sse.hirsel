pub opaque type EventBuf: send {
    data: Bytes
}

pub type SseError: key = Field | Utf8 | TooLarge

pub type FeedControl[E] = Continue | Stop | Fail(E)

pub type FeedProgress: key = Consumed(u64) | Stopped(u64)

pub type FeedError[E] = Decode(SseError, u64) | Callback(E, u64)

pub fn buffer(size: u64) -> EventBuf {
    let data: Bytes = list.with_capacity(size)
    EventBuf(data: take data)
}

pub fn as_bytes(out: EventBuf) -> View[Bytes] in out {
    view out.data
}

pub fn into_bytes(take out: EventBuf) -> Bytes {
    let EventBuf(data: take data) = take out
    take data
}

fn valid_field(value: String, id_field: bool) -> bool {
    for c in string.as_bytes(value) {
        if c == b'\r' || c == b'\n' || id_field && c == 0 {
            return false
        }
    }
    true
}

fn line(raw: Bytes, from: u64) -> (u64, u64) {
    let n = list.len(raw)
    let Some(end) = list.find_byte2(raw, from, n, b'\r', b'\n') else {
        return (n, n)
    }
    if raw[end] == b'\r' && end + 1 < n && raw[end + 1] == b'\n' {
        (end, end + 2)
    } else {
        (end, end + 1)
    }
}

fn size_for_lines(raw: Bytes, prefix: u64) -> u64 {
    let n = list.len(raw)
    let mut start: u64 = 0
    let mut needed: u64 = 0
    loop {
        let (end, next) = line(raw, start)
        needed = int.saturating_add(needed, int.saturating_add(end - start, prefix + 1))
        if end == n {
            return needed
        }
        start = next
    }
}

fn push_line(mut data: Bytes, prefix: String, value: Bytes) {
    let _ = list.append(mut data, string.as_bytes(prefix))
    let _ = list.append(mut data, value)
    let _ = list.push(mut data, b'\n')
}

fn push_lines(mut data: Bytes, prefix: String, raw: Bytes) {
    let n = list.len(raw)
    let mut start: u64 = 0
    loop {
        let (end, next) = line(raw, start)
        push_line(mut data, prefix, list.slice(raw, start, end))
        if end == n {
            return
        }
        start = next
    }
}

fn spare(out: EventBuf) -> u64 {
    list.capacity(out.data) - list.len(out.data)
}

pub fn event(mut out: EventBuf, name: Option[String], id: Option[String], data: Bytes) -> Result[(), SseError] {
    let mut size = int.saturating_add(size_for_lines(data, 6), 1)
    if let Some(value) = name {
        if !valid_field(value, false) {
            return Error(Field)
        }
        size = int.saturating_add(size, int.saturating_add(string.byte_len(value), 8))
    }
    if let Some(value) = id {
        if !valid_field(value, true) {
            return Error(Field)
        }
        size = int.saturating_add(size, int.saturating_add(string.byte_len(value), 5))
    }
    if !string.is_utf8(data) {
        return Error(Utf8)
    }
    if size > spare(out) {
        return Error(TooLarge)
    }
    if let Some(value) = name {
        push_line(mut out.data, "event: ", string.as_bytes(value))
    }
    if let Some(value) = id {
        push_line(mut out.data, "id: ", string.as_bytes(value))
    }
    push_lines(mut out.data, "data: ", data)
    let _ = list.push(mut out.data, b'\n')
    Ok(())
}

pub fn comment(mut out: EventBuf, text: String) -> Result[(), SseError] {
    let prefix = if text == "" {
        ":"
    } else {
        ": "
    }
    let raw = string.as_bytes(text)
    if int.saturating_add(size_for_lines(raw, string.byte_len(prefix)), 1) > spare(out) {
        return Error(TooLarge)
    }
    push_lines(mut out.data, prefix, raw)
    let _ = list.push(mut out.data, b'\n')
    Ok(())
}

pub fn retry(mut out: EventBuf, milliseconds: u64) -> Result[(), SseError] {
    let mut digits: Inline[u8, 64] =[0; 64]
    let start = int.radix_digits(milliseconds, 10, mut digits)
    if 9 + (64 - start) > spare(out) {
        return Error(TooLarge)
    }
    let _ = list.append(mut out.data, string.as_bytes("retry: "))
    let _ = bytebuf.append_inline(mut out.data, digits, start, 64)
    let _ = list.append(mut out.data, string.as_bytes("\n\n"))
    Ok(())
}

pub opaque type Decoder: send {
    max_bytes: u64,
    line: Bytes,
    data: Bytes,
    name: Bytes,
    pending_id: Bytes,
    last_id: Bytes,
    id_changed: bool,
    retry: Option[u64],
    first_line: bool,
    skip_lf: bool,
    stopped: bool
}

/// Allocates fixed storage for a line, event data, name and two ID buffers.
pub fn decoder(max_bytes: u64) -> Decoder {
    let line_buffer: Bytes = list.with_capacity(max_bytes)
    let data: Bytes = list.with_capacity(max_bytes)
    let name: Bytes = list.with_capacity(max_bytes)
    let pending: Bytes = list.with_capacity(max_bytes)
    let last: Bytes = list.with_capacity(max_bytes)
    Decoder(max_bytes, line: take line_buffer, data: take data, name: take name, pending_id: take pending, last_id: take last, id_changed: false, retry: None, first_line: true, skip_lf: false, stopped: false)
}

pub fn last_event_id(d: Decoder) -> View[Bytes] in d {
    view d.last_id
}

pub fn retry_ms(d: Decoder) -> Option[u64] {
    d.retry
}

fn bounded_append(mut out: Bytes, raw: Bytes, max: u64) -> Result[(), SseError] {
    if list.len(raw) > max - list.len(out) {
        return Error(TooLarge)
    }
    let _ = list.append(mut out, raw)
    Ok(())
}

// ASCII separators cannot be part of a UTF-8 continuation. Decode complete
// field values, using one replacement per invalid UTF-8 unit.
fn append_utf8(mut out: Bytes, raw: Bytes, max: u64) -> Result[(), SseError] {
    let n = list.len(raw)
    let mut start: u64 = 0
    while start < n {
        let rest = list.slice(raw, start, n)
        match string.validate_utf8(rest) {
            Ok(()) => return bounded_append(mut out, rest, max),
            Error(e) => {
                bounded_append(mut out, list.slice(rest, 0, e.valid_up_to), max)?
                bounded_append(mut out, string.as_bytes("�"), max)?
                match e.error_len {
                    Some(width) => {
                        start += e.valid_up_to + width
                    },
                    None => return Ok(()),
                }
            },
        }
    }
    Ok(())
}

fn retry_digits(value: Bytes) -> Result[Option[u64], SseError] {
    if list.len(value) == 0 {
        return Ok(None)
    }
    // A nondigit anywhere in the value makes even an overflowing prefix invalid.
    for c in value {
        if !int.is_ascii_digit(c) {
            return Ok(None)
        }
    }
    match int.parse_decimal_span(value, 0, list.len(value), 18446744073709551615) {
        Ok(n) => Ok(Some(n)),
        Error(_) => Error(TooLarge),
    }
}

fn dispatch[E](mut d: Decoder, on_event: scoped fn(Bytes, Bytes, Bytes) -> FeedControl[E]) -> FeedControl[E] {
    if d.id_changed {
        let next = replace(mut d.pending_id, list.new())
        d.pending_id = replace(mut d.last_id, take next)
        list.clear(mut d.pending_id)
        d.id_changed = false
    }
    let control = if list.len(d.data) != 0 {
        let name = if list.len(d.name) == 0 {
            string.as_bytes("message")
        } else {
            view d.name
        }
        let control = on_event(name, list.slice(d.data, 0, list.len(d.data) - 1), d.last_id)
        list.clear(mut d.data)
        take control
    } else {
        Continue
    }
    list.clear(mut d.name)
    take control
}

// WHATWG HTML, "Interpreting an event stream". Field names are case-sensitive.
fn decode_line[E](mut d: Decoder, on_event: scoped fn(Bytes, Bytes, Bytes) -> FeedControl[E]) -> Result[FeedControl[E], SseError] {
    let end = list.len(d.line)
    let mut start: u64 = 0
    if d.first_line {
        if end >= 3 && d.line[0] == 0xef && d.line[1] == 0xbb && d.line[2] == 0xbf {
            start = 3
        }
        d.first_line = false
    }
    if start == end {
        return Ok(dispatch(mut d, on_event))
    }
    let colon = match list.find_byte(d.line, start, end, b':') {
        Some(at) => at,
        None => end,
    }
    let mut at = colon
    if at < end {
        at += 1
        if at < end && d.line[at] == b' ' {
            at += 1
        }
    }
    let name = list.slice(d.line, start, colon)
    let value = list.slice(d.line, at, end)
    if name == string.as_bytes("data") {
        append_utf8(mut d.data, value, d.max_bytes)?
        bounded_append(mut d.data, string.as_bytes("\n"), d.max_bytes)?
    } else if name == string.as_bytes("event") {
        list.clear(mut d.name)
        append_utf8(mut d.name, value, d.max_bytes)?
    } else if name == string.as_bytes("id") && list.find_byte(value, 0, list.len(value), 0) == None {
        list.clear(mut d.pending_id)
        append_utf8(mut d.pending_id, value, d.max_bytes)?
        d.id_changed = true
    } else if name == string.as_bytes("retry") {
        if let Some(n) = retry_digits(value)? {
            d.retry = Some(n)
        }
    }
    Ok(Continue)
}

/// Emits complete events until input ends or on_event returns Stop or Fail.
/// Every outcome reports the number of bytes consumed from input.
pub fn feed[E](mut d: Decoder, input: Bytes, on_event: scoped fn(Bytes, Bytes, Bytes) -> FeedControl[E]) -> Result[FeedProgress, FeedError[E]] {
    if d.stopped {
        return Error(Decode(TooLarge, 0))
    }
    let end = list.len(input)
    let mut consumed: u64 = 0
    while consumed < end {
        let c = input[consumed]
        if d.skip_lf {
            d.skip_lf = false
            if c == b'\n' {
                consumed += 1
                continue
            }
        }
        if c == b'\r' || c == b'\n' {
            consumed += 1
            d.skip_lf = c == b'\r' && consumed == end
            if c == b'\r' && consumed < end && input[consumed] == b'\n' {
                consumed += 1
            }
            let control = match decode_line(mut d, on_event) {
                Ok(take control) => take control,
                Error(e) => {
                    d.stopped = true
                    return Error(Decode(e, consumed))
                },
            }
            list.clear(mut d.line)
            match control {
                Continue => (),
                Stop => return Ok(Stopped(consumed)),
                Fail(take e) => return Error(Callback(take e, consumed)),
            }
        } else {
            if list.len(d.line) == d.max_bytes {
                d.stopped = true
                return Error(Decode(TooLarge, consumed))
            }
            let _ = list.push(mut d.line, c)
            consumed += 1
        }
    }
    Ok(Consumed(consumed))
}

/// Discards an unfinished event at EOF. Committed reconnect state survives.
pub fn finish(mut d: Decoder) {
    list.clear(mut d.line)
    list.clear(mut d.data)
    list.clear(mut d.name)
    list.clear(mut d.pending_id)
    d.id_changed = false
    d.stopped = true
}

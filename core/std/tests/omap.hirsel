// Public persistent-map laws against a sorted-list model.
fn put(mut ids: u64, m: omap.OMap[u64, u64], k: u64, v: u64) -> omap.OMap[u64, u64] {
    {
        let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, k, v))
        take next_map
    }
}

fn model(old: List[(u64, u64)], key: u64, value: u64, deleting: bool) -> List[(u64, u64)] {
    let mut out: List[(u64, u64)] = result.unwrap(list.with_capacity(list.len(old) + 1))
    let mut installed = deleting
    for pair in old {
        if !installed && key < pair.0 {
            result.unwrap(list.push(mut out, (key, value)))
            installed = true
        }
        if pair.0 == key {
            if !deleting {
                result.unwrap(list.push(mut out, (key, value)))
            }
            installed = true
        } else {
            result.unwrap(list.push(mut out, pair))
        }
    }
    if !installed {
        result.unwrap(list.push(mut out, (key, value)))
    }
    out
}

fn equal(m: omap.OMap[u64, u64], xs: List[(u64, u64)]) -> bool {
    if omap.len(m) != list.len(xs) {
        return false
    }
    let mut rows = result.unwrap(omap.range(m, Unbounded, Unbounded))
    for pair in xs {
        match result.unwrap(omap.next(mut rows)) {
            Some((k, v)) => if k != pair.0 || v != pair.1 {
                return false
            },
            None => return false,
        }
        match omap.get(m, pair.0) {
            Some(v) => if v != pair.1 {
                return false
            },
            None => return false,
        }
    }
    if let Some(_) = result.unwrap(omap.next(mut rows)) {
        return false
    }
    if list.len(xs) == 0 {
        if let Some(_) = omap.first(m) {
            return false
        }
        if let Some(_) = omap.last(m) {
            return false
        }
    } else {
        match omap.first(m) {
            Some((k, v)) => if k != xs[0].0 || v != xs[0].1 {
                return false
            },
            None => return false
        }
        let end = list.len(xs) - 1
        match omap.last(m) {
            Some((k, v)) => if k != xs[end].0 || v != xs[end].1 {
                return false
            },
            None => return false
        }
    }
    true
}

fn key_at(n: Arc[omap.Node[u64, u64]], i: u64) -> u64 {
    match omap.node_key(n, i) {
        Some(k) => k,
        None => fail("missing node key")
    }
}

fn value_at(n: Arc[omap.Node[u64, u64]], i: u64) -> u64 {
    match omap.node_value(n, i) {
        Some(v) => v,
        None => fail("missing node value")
    }
}

fn nodes(n: Arc[omap.Node[u64, u64]], is_root: bool) -> bool {
    let count = omap.node_count(n)
    if count == 0 || count > 32 || (!is_root && count < 16) {
        return false
    }
    let mut size: u64 = 0
    let level = omap.node_level(n)
    for i in 0 .. count {
        if level == 0 {
            if let None = omap.node_value(n, i) {
                return false
            }
            size += 1
        } else {
            let c = option.unwrap(omap.node_child(n, i))
            if omap.node_id(c) >= omap.node_id(n) || omap.node_level(c) + 1 != level || !nodes(c, false) {
                return false
            }
            if key_at(n, i) != key_at(c, 0) {
                return false
            }
            size += omap.node_len(c)
        }
        if i > 0 && key_at(n, i - 1) >= key_at(n, i) {
            return false
        }
    }
    size == omap.node_len(n)
}

// Four independent generators; after each operation compare EVERY held version
// with the simple sorted-list model, including all earlier snapshots.
// expect: run held_version_sequences() = true
fn held_version_sequences() -> bool {
    for seed in 0u64 .. 4 {
        let mut ids: u64 = 0
        let mut m: omap.OMap[u64, u64] = omap.new()
        let mut xs: List[(u64, u64)] = list.new()
        let mut versions: List[omap.OMap[u64, u64]] = result.unwrap(list.with_capacity(97))
        let mut models: List[List[(u64, u64)]] = result.unwrap(list.with_capacity(97))
        result.unwrap(list.push(mut versions, omap.snapshot(m)))
        result.unwrap(list.push(mut models, list.new()))
        let mut state = seed + 1
        for step in 0u64 .. 96 {
            state = int.wrapping_add(int.wrapping_mul(state, 6364136223846793005u64), 1442695040888963407u64)
            let key = (state / 65536) % 70
            let deleting = (state / 256) % 3 == 0
            m = if deleting {
                result.unwrap(omap.remove(mut ids, m, key))
            } else {
                put(mut ids, m, key, step + 1)
            }
            xs = model(xs, key, step + 1, deleting)
            result.unwrap(list.push(mut versions, omap.snapshot(m)))
            let copied: Result[List[(u64, u64)], Capacity] = clone(xs)
            result.unwrap(list.push(mut models, result.unwrap(take copied)))
            for i in 0 .. list.len(versions) {
                if !equal(versions[i], models[i]) {
                    return false
                }
            }
            if let Some(n) = omap.root(m) {
                if !nodes(n, true) {
                    return false
                }
            }
        }
    }
    true
}

// Monotone and reverse insertions force root splits; both deletion directions
// force redistribution, merges and root collapse while a full snapshot lives.
// expect: run split_merge_collapse() = true
fn split_merge_collapse() -> bool {
    for direction in 0u64 .. 2 {
        let mut ids: u64 = 0
        let mut m: omap.OMap[u64, u64] = omap.new()
        for i in 0u64 .. 1100 {
            let k = if direction == 0 {
                i
            } else {
                1099 - i
            }
            m = put(mut ids, m, k, k + 1)
        }
        let pinned = omap.snapshot(m)
        if omap.node_level(option.unwrap(omap.root(m))) < 2 {
            return false
        }
        for i in 0u64 .. 1100 {
            let k = if direction == 0 {
                i
            } else {
                1099 - i
            }
            m = result.unwrap(omap.remove(mut ids, m, k))
            if omap.len(m) != 1099 - i {
                return false
            }
            if let Some(n) = omap.root(m) {
                if !nodes(n, true) {
                    return false
                }
            }
        }
        if omap.len(m) != 0 || omap.len(pinned) != 1100 {
            return false
        }
        for i in 0u64 .. 1100 {
            if option.unwrap(omap.get(pinned, i)) != i + 1 {
                return false
            }
        }
    }
    true
}

// Inclusive/exclusive/unbounded endpoints, empty/reversed ranges and missing
// endpoints exercise cursor seek through internal nodes and leaf transitions.
// expect: run range_endpoints() = true
fn range_endpoints() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    for i in 0u64 .. 160 {
        m = put(mut ids, m, i * 2, i + 1)
    }
    for lo in 0u64 .. 3 {
        for hi in 0u64 .. 3 {
            let lower: omap.Bound[u64] = if lo == 0 {
                Unbounded
            } else if lo == 1 {
                Included(64)
            } else {
                Excluded(64)
            }
            let upper: omap.Bound[u64] = if hi == 0 {
                Unbounded
            } else if hi == 1 {
                Included(130)
            } else {
                Excluded(130)
            }
            let mut c = result.unwrap(omap.range(m, take lower, take upper))
            for i in 0u64 .. 160 {
                let k = i * 2
                let wanted = (lo == 0 || (lo == 1 && k >= 64) || (lo == 2 && k > 64)) && (hi == 0 || (hi == 1 && k <= 130) || (hi == 2 && k < 130))
                if wanted {
                    match result.unwrap(omap.next(mut c)) {
                        Some((a, b)) => if a != k || b != i + 1 {
                            return false
                        },
                        None => return false,
                    }
                }
            }
            if let Some(_) = result.unwrap(omap.next(mut c)) {
                return false
            }
        }
    }
    let mut empty = result.unwrap(omap.range(m, Included(100), Excluded(90)))
    if let Some(_) = result.unwrap(omap.next(mut empty)) {
        return false
    }
    let mut absent = result.unwrap(omap.range(m, Included(65), Excluded(67)))
    match result.unwrap(omap.next(mut absent)) {
        Some((k, v)) => k == 66 && v == 34,
        None => false
    }
}

// Payloads need ordered/shareable/send, never plain. No Arc payload copying on
// snapshots, and copying a returned value under Capacity does not consume it.
// expect: run owned_payload_and_capacity() = true
fn owned_payload_and_capacity() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[String, List[String]] = omap.new()
    let mut v: List[String] = list.new()
    result.unwrap(list.push(mut v, result.unwrap(string.from("row"))))
    m = {
        let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, result.unwrap(string.from("key")), take v))
        take next_map
    }
    let pinned = result.unwrap(bound bytes 0 {
        omap.snapshot(m)
    })
    let mut c = result.unwrap(omap.range(m, Included(result.unwrap(string.from("key"))), Unbounded))
    let attempt = result.unwrap(bound bytes 0 {
        omap.next(mut c)
    })
    if let Ok(_) = attempt {
        return false
    }
    let pair = option.unwrap(result.unwrap(omap.next(mut c)))
    if pair.0 != "key" || pair.1[0] != "row" || omap.len(pinned) != 1 {
        return false
    }
    let key = result.unwrap(string.from("kept"))
    let value: List[String] = list.new()
    let denied = result.unwrap(bound bytes 0 {
        omap.insert(mut ids, m, take key, take value)
    })
    match denied {
        Error((_, (take k, take returned))) => k == "kept" && list.len(returned) == 0 && omap.len(m) == 1,
        _ => false
    }
}

// Rebuild all nodes bottom-up with their original ids, without a codec or
// invariant re-validation in the map. Contents and node metadata round-trip.
fn reload(n: Arc[omap.Node[u64, u64]]) -> Arc[omap.Node[u64, u64]] {
    let mut keys: List[u64] = list.new()
    let mut values: List[u64] = list.new()
    let mut children: List[Arc[omap.Node[u64, u64]]] = list.new()
    for i in 0 .. omap.node_count(n) {
        result.unwrap(list.push(mut keys, key_at(n, i)))
        if omap.node_level(n) == 0 {
            result.unwrap(list.push(mut values, value_at(n, i)))
        } else {
            result.unwrap(list.push(mut children, reload(option.unwrap(omap.node_child(n, i)))))
        }
    }
    if omap.node_level(n) == 0 {
        result.unwrap(omap.leaf(omap.node_id(n), take keys, take values))
    } else {
        result.unwrap(omap.branch(omap.node_id(n), take keys, take children))
    }
}

// expect: run checkpoint_rebuild_and_ids() = true
fn checkpoint_rebuild_and_ids() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    for i in 0u64 .. 1100 {
        m = put(mut ids, m, i, i + 7)
    }
    let pin = omap.snapshot(m)
    let cutoff = ids
    m = put(mut ids, m, 0, 999)
    let before = option.unwrap(omap.root(pin))
    let after = option.unwrap(omap.root(m))
    if omap.node_id(after) <= cutoff || omap.node_id(before) > cutoff {
        return false
    }
    let old_last = option.unwrap(omap.node_child(before, omap.node_count(before) - 1))
    let new_last = option.unwrap(omap.node_child(after, omap.node_count(after) - 1))
    if omap.node_id(old_last) != omap.node_id(new_last) {
        return false
    }
    let rebuilt = omap.from_root(Some(reload(after)))
    let mut expected: List[(u64, u64)] = list.new()
    for i in 0u64 .. 1100 {
        result.unwrap(list.push(mut expected, (i, if i == 0 {
            999u64
        } else {
            i + 7
        })))
    }
    equal(rebuilt, expected) && nodes(option.unwrap(omap.root(rebuilt)), true)
}

type ReadInput: send {
    map: omap.OMap[u64, u64],
    rows: omap.Cursor[u64, u64],
    gate: Receiver[u64]
}

fn read_child(take input: ReadInput) -> u64 waits {
    let ReadInput(map: held_map, rows: held_rows, gate: ready_gate) = take input
    let _ = result.unwrap(channel.receive(ready_gate))
    let mut rows = held_rows
    let mut sum: u64 = 0
    while let Some((k, v)) = result.unwrap(omap.next(mut rows)) {
        sum += k + v
    }
    let present = option.unwrap(omap.get(held_map, 0))
    sum + present
}

// A child holds both a version and a path cursor while the parent writes.
// expect: run second_task(tasks) = true
fn second_task(tasks: Tasks) -> bool waits {
    task_version(tasks, false)
}

// expect: run second_task_owned(tasks) = true
fn second_task_owned(tasks: Tasks) -> bool waits {
    task_version(tasks, true)
}

fn task_version(tasks: Tasks, consuming: bool) -> bool waits {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    for i in 0u64 .. 100 {
        m = put(mut ids, m, i, i + 1)
    }
    let rows = result.unwrap(omap.range(m, Included(20), Excluded(40)))
    let (tx, rx): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(1))
    let input = ReadInput(map: omap.snapshot(m), rows: take rows, gate: take rx)
    let h = result.unwrap(task.spawn(tasks, bytes 1048576, take input, read_child))
    for i in 0u64 .. 100 {
        if consuming {
            let previous = take m
            let changed = {
                let (take next_map, _) = result.unwrap(omap.insert_owned(mut ids, take previous, i, 999))
                take next_map
            }
            m = take changed
        } else {
            m = put(mut ids, m, i, 999)
        }
    }
    result.unwrap(channel.send(tx, 1))
    result.unwrap(task.join(take h)) == 1201 && option.unwrap(omap.get(m, 0)) == 999
}

// A thousand independently held roots remain readable after a thousand writes.
// expect: run thousand_snapshots() = true
fn thousand_snapshots() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    for i in 0u64 .. 64 {
        m = put(mut ids, m, i, i)
    }
    let mut held: List[omap.OMap[u64, u64]] = result.unwrap(list.with_capacity(1000))
    for i in 0u64 .. 1000 {
        result.unwrap(list.push(mut held, omap.snapshot(m)))
        m = put(mut ids, m, i % 64, 1000 + i)
    }
    for version in 0u64 .. 1000 {
        for k in 0u64 .. 64 {
            let expected = if version <= k {
                k
            } else {
                1000 + k + ((version - 1 - k) / 64) * 64
            }
            if option.unwrap(omap.get(held[version], k)) != expected {
                return false
            }
        }
    }
    true
}

// M4's concrete K=V=Bytes: lexicographic bytes, including prefix order and FF.
// expect: run byte_rows() = true
fn byte_rows() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[Bytes, Bytes] = omap.new()
    m = {
        let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, result.unwrap(b"\x01\x00"), result.unwrap(b"two")))
        take next_map
    }
    m = {
        let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, result.unwrap(b"\xff"), result.unwrap(b"three")))
        take next_map
    }
    m = {
        let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, result.unwrap(b"\x01"), result.unwrap(b"one")))
        take next_map
    }
    let mut rows = result.unwrap(omap.range(m, Unbounded, Unbounded))
    let a = option.unwrap(result.unwrap(omap.next(mut rows)))
    let b = option.unwrap(result.unwrap(omap.next(mut rows)))
    let c = option.unwrap(result.unwrap(omap.next(mut rows)))
    list.len(a.0) == 1 && a.0[0] == 1 && list.len(b.0) == 2 && b.0[1] == 0 && c.0[0] == 255 && a.1[0] == 111 && b.1[0] == 116 && c.1[0] == 116
}

// Refuse at successive allocations throughout one multi-level path. Every
// failure returns both owned inputs and keeps old contents and node ids intact.
// expect: run partial_capacity_rollback() = true
fn partial_capacity_rollback() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, String] = omap.new()
    for i in 0u64 .. 80 {
        m = {
            let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, i, "old"))
            take next_map
        }
    }
    let old_id = omap.node_id(option.unwrap(omap.root(m)))
    let mut refused: u64 = 0
    let mut succeeded: u64 = 0
    for i in 0u64 .. 48 {
        let budget = i * 64
        let answer = result.unwrap(bound bytes budget {
            omap.insert(mut ids, m, 81, "new")
        })
        match answer {
            Error((_, (k, take v))) => {
                if k != 81 || v != "new" {
                    return false
                }
                refused += 1
            },
            Ok((take changed, _)) => {
                if omap.len(changed) != 81 {
                    return false
                }
                succeeded += 1
            },
        }
        if omap.len(m) != 80 || omap.node_id(option.unwrap(omap.root(m))) != old_id {
            return false
        }
        if let Some(_) = omap.get(m, 81) {
            return false
        }
    }
    refused > 0 && succeeded > 0
}

// Partition boundaries include two minimally occupied leaves and a third level.
// expect: run sorted_build() = true
fn sorted_build() -> bool {
    for case in 0u64 .. 7 {
        let n = if case == 0 {
            0u64
        } else if case == 1 {
            1u64
        } else if case == 2 {
            16u64
        } else if case == 3 {
            32u64
        } else if case == 4 {
            33u64
        } else if case == 5 {
            65u64
        } else {
            1100u64
        }
        let mut keys: List[u64] = result.unwrap(list.with_capacity(n))
        let mut values: List[u64] = result.unwrap(list.with_capacity(n))
        let mut expected: List[(u64, u64)] = result.unwrap(list.with_capacity(n))
        for i in 0 .. n {
            result.unwrap(list.push(mut keys, i * 2))
            result.unwrap(list.push(mut values, i + 7))
            result.unwrap(list.push(mut expected, (i * 2, i + 7)))
        }
        let mut ids: u64 = 0
        let map = result.unwrap(omap.from_sorted(mut ids, keys, values))
        if !equal(map, expected) {
            return false
        }
        if let Some(root) = omap.root(map) {
            if !nodes(root, true) {
                return false
            }
        }
    }
    true
}

// Unique writes alternate with shared roots. Every checkpoint keeps its model.
// expect: run owned_versions() = true
fn owned_versions() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    let mut xs: List[(u64, u64)] = list.new()
    let mut held: List[omap.OMap[u64, u64]] = result.unwrap(list.with_capacity(17))
    let mut models: List[List[(u64, u64)]] = result.unwrap(list.with_capacity(17))
    for step in 0u64 .. 128 {
        if step % 8 == 0 {
            result.unwrap(list.push(mut held, omap.snapshot(m)))
            let copied_model: Result[List[(u64, u64)], Capacity] = clone(xs)
            result.unwrap(list.push(mut models, result.unwrap(take copied_model)))
        }
        let k = (step * 79) % 151
        let previous = take m
        let changed = {
            let (take next_map, _) = result.unwrap(omap.insert_owned(mut ids, take previous, k, step + 7))
            take next_map
        }
        m = take changed
        xs = model(xs, k, step + 7, false)
        if !equal(m, xs) {
            return false
        }
        if !nodes(option.unwrap(omap.root(m)), true) {
            return false
        }
        for i in 0 .. list.len(held) {
            if !equal(held[i], models[i]) {
                return false
            }
        }
    }
    true
}

// A refused consuming update can discard its draft; the rollback root is held.
// expect: run owned_capacity() = true
fn owned_capacity() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, String] = omap.new()
    for i in 0u64 .. 80 {
        m = {
            let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, i, "old"))
            take next_map
        }
    }
    let held = omap.snapshot(m)
    let old_id = omap.node_id(option.unwrap(omap.root(held)))
    m = {
        let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, 80, "draft"))
        take next_map
    }
    let refused = result.unwrap(bound bytes 0 {
        omap.insert_owned(mut ids, take m, 81, "new")
    })
    match take refused {
        Error((_, (k, take v))) => k == 81 && v == "new" && omap.len(held) == 80 && omap.node_id(option.unwrap(omap.root(held))) == old_id && option.unwrap(omap.get(held, 0)) == "old",
        Ok(take changed) => false
    }
}

// Unique writes split leaves, branches and roots; reversed writes cross siblings.
// expect: run owned_splits() = true
fn owned_splits() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    for i in 0u64 .. 1100 {
        let previous = take m
        let changed = {
            let (take next_map, _) = result.unwrap(omap.insert_owned(mut ids, take previous, i, i + 5))
            take next_map
        }
        m = take changed
    }
    let held = omap.snapshot(m)
    let held_id = omap.node_id(option.unwrap(omap.root(held)))
    for i in 0u64 .. 1100 {
        let k = 2199 - i
        let previous = take m
        let changed = {
            let (take next_map, _) = result.unwrap(omap.insert_owned(mut ids, take previous, k, k + 5))
            take next_map
        }
        m = take changed
    }
    let mut expected: List[(u64, u64)] = result.unwrap(list.with_capacity(2200))
    let mut old: List[(u64, u64)] = result.unwrap(list.with_capacity(1100))
    for i in 0u64 .. 2200 {
        result.unwrap(list.push(mut expected, (i, i + 5)))
        if i < 1100 {
            result.unwrap(list.push(mut old, (i, i + 5)))
        }
    }
    equal(m, expected) && equal(held, old) && omap.node_id(option.unwrap(omap.root(held))) == held_id && nodes(option.unwrap(omap.root(m)), true) && nodes(option.unwrap(omap.root(held)), true)
}

// Every possible insertion position in a full leaf, including both sides of
// the 16/17 split. A shifted-source-index mutant duplicates one entry and
// loses its neighbour. Check complete contents and the held original.
// expect: run split_boundary_entries() = true
fn split_boundary_entries() -> bool {
    for at in 0u64 .. 33 {
        let mut ids: u64 = 0
        let mut m: omap.OMap[u64, u64] = omap.new()
        let mut xs: List[(u64, u64)] = result.unwrap(list.with_capacity(32))
        for i in 0u64 .. 32 {
            m = put(mut ids, m, i * 2 + 1, i + 100)
            result.unwrap(list.push(mut xs, (i * 2 + 1, i + 100)))
        }
        let held = omap.snapshot(m)
        m = put(mut ids, m, at * 2, 777)
        let expected = model(xs, at * 2, 777, false)
        if !equal(m, expected) || !equal(held, xs) || !nodes(option.unwrap(omap.root(m)), true) {
            return false
        }
    }
    true
}

fn byte_key(i: u64) -> Bytes {
    let mut out: Bytes = result.unwrap(list.with_capacity(1))
    result.unwrap(list.push(mut out, int.narrow(i)))
    out
}

fn byte_equal(m: omap.OMap[Bytes, Bytes], xs: List[(u64, u64)]) -> bool {
    if omap.len(m) != list.len(xs) {
        return false
    }
    let mut rows = result.unwrap(omap.range(m, Unbounded, Unbounded))
    for pair in xs {
        let (k, v) = option.unwrap(result.unwrap(omap.next(mut rows)))
        if list.len(k) != 1 || list.len(v) != 1 || k[0] != int.narrow(pair.0) || v[0] != int.narrow(pair.1) {
            return false
        }
        let found = option.unwrap(omap.get(m, byte_key(pair.0)))
        if list.len(found) != 1 || found[0] != int.narrow(pair.1) {
            return false
        }
    }
    if let Some(_) = result.unwrap(omap.next(mut rows)) {
        return false
    }
    true
}

fn reload_bytes(n: Arc[omap.Node[Bytes, Bytes]]) -> Arc[omap.Node[Bytes, Bytes]] {
    let mut ks: List[Bytes] = result.unwrap(list.with_capacity(omap.node_count(n)))
    let mut vs: List[Bytes] = result.unwrap(list.with_capacity(omap.node_count(n)))
    let mut children: List[Arc[omap.Node[Bytes, Bytes]]] = result.unwrap(list.with_capacity(omap.node_count(n)))
    for i in 0u64 .. omap.node_count(n) {
        let key: Result[Bytes, Capacity] = clone(option.unwrap(omap.node_key(n, i)))
        result.unwrap(list.push(mut ks, result.unwrap(take key)))
        if omap.node_level(n) == 0 {
            let value: Result[Bytes, Capacity] = clone(option.unwrap(omap.node_value(n, i)))
            result.unwrap(list.push(mut vs, result.unwrap(take value)))
        } else {
            if let Some(_) = omap.node_value(n, i) {
                fail("branch exposes a value")
            }
            result.unwrap(list.push(mut children, reload_bytes(option.unwrap(omap.node_child(n, i)))))
        }
    }
    if omap.node_level(n) == 0 {
        result.unwrap(omap.leaf(omap.node_id(n), take ks, take vs))
    } else {
        result.unwrap(omap.branch(omap.node_id(n), take ks, take children))
    }
}

// Owned byte payloads are shared across split, overwrite and remove paths.
// Every held version stays equal to its model; decoded views reconstruct it.
// expect: run shared_byte_versions() = true
fn shared_byte_versions() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[Bytes, Bytes] = omap.new()
    let mut xs: List[(u64, u64)] = list.new()
    let mut held: List[omap.OMap[Bytes, Bytes]] = result.unwrap(list.with_capacity(9))
    let mut models: List[List[(u64, u64)]] = result.unwrap(list.with_capacity(9))
    for i in 0u64 .. 80 {
        m = {
            let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, byte_key(i), byte_key(i)))
            take next_map
        }
        xs = model(xs, i, i, false)
    }
    for step in 0u64 .. 64 {
        if step % 8 == 0 {
            result.unwrap(list.push(mut held, omap.snapshot(m)))
            let copied_model: Result[List[(u64, u64)], Capacity] = clone(xs)
            result.unwrap(list.push(mut models, result.unwrap(take copied_model)))
        }
        let k = (step * 47) % 96
        let deleting = step % 3 == 0
        m = if deleting {
            result.unwrap(omap.remove(mut ids, m, byte_key(k)))
        } else {
            {
                let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, byte_key(k), byte_key(step + 100)))
                take next_map
            }
        }
        xs = model(xs, k, step + 100, deleting)
        if !byte_equal(m, xs) {
            return false
        }
        for i in 0u64 .. list.len(held) {
            if !byte_equal(held[i], models[i]) {
                return false
            }
        }
    }
    let h = option.unwrap(omap.root(m))
    let restored = omap.from_root(Some(reload_bytes(h)))
    byte_equal(restored, xs) && omap.node_id(option.unwrap(omap.root(restored))) == omap.node_id(h)
}

// Refusal returns the same complete map, even without a rollback snapshot.
// Exercise both unique and shared roots across successive allocation budgets.
// expect: run recover_capacity() = true
fn recover_capacity() -> bool {
    let mut refused: u64 = 0
    let mut succeeded: u64 = 0
    for shared in 0u64 .. 2 {
        for budget_step in 0u64 .. 48 {
            let mut ids: u64 = 0
            let mut m: omap.OMap[u64, String] = omap.new()
            for i in 0u64 .. 80 {
                let previous = take m
                m = {
                    let (take next_map, _) = result.unwrap(omap.insert_owned(mut ids, take previous, i, "old"))
                    take next_map
                }
            }
            let old_id = omap.node_id(option.unwrap(omap.root(m)))
            let held = if shared == 1 {
                omap.snapshot(m)
            } else {
                omap.new()
            }
            let answer = result.unwrap(bound bytes budget_step * 64 {
                omap.insert_recover(mut ids, take m, 81, "new")
            })
            match take answer {
                Error((_, (take recovered, (k, take v)))) => {
                    if k != 81 || v != "new" || omap.len(recovered) != 80 || omap.node_id(option.unwrap(omap.root(recovered))) != old_id {
                        return false
                    }
                    for i in 0u64 .. 80 {
                        if option.unwrap(omap.get(recovered, i)) != "old" {
                            return false
                        }
                    }
                    if let Some(_) = omap.get(recovered, 81) {
                        return false
                    }
                    refused += 1
                },
                Ok((take changed, _)) => {
                    if omap.len(changed) != 81 || option.unwrap(omap.get(changed, 81)) != "new" {
                        return false
                    }
                    succeeded += 1
                }
            }
            if shared == 1 && (omap.len(held) != 80 || omap.node_id(option.unwrap(omap.root(held))) != old_id) {
                return false
            }
        }
    }
    refused > 0 && succeeded > 0
}

// Success through the recovering API keeps all earlier versions.
// expect: run recover_versions() = true
fn recover_versions() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    let mut xs: List[(u64, u64)] = list.new()
    let mut held: List[omap.OMap[u64, u64]] = result.unwrap(list.with_capacity(97))
    let mut models: List[List[(u64, u64)]] = result.unwrap(list.with_capacity(97))
    for step in 0u64 .. 96 {
        result.unwrap(list.push(mut held, omap.snapshot(m)))
        let copied_model: Result[List[(u64, u64)], Capacity] = clone(xs)
        result.unwrap(list.push(mut models, result.unwrap(take copied_model)))
        let k = (step * 47) % 71
        let previous = take m
        m = {
            let (take next_map, _) = result.unwrap(omap.insert_recover(mut ids, take previous, k, step + 1))
            take next_map
        }
        xs = model(xs, k, step + 1, false)
        if !equal(m, xs) {
            return false
        }
        for i in 0u64 .. list.len(held) {
            if !equal(held[i], models[i]) {
                return false
            }
        }
    }
    true
}

// All insert forms return the stored old value from the same descent. A held
// result outlives its original map, and snapshots keep their previous values.
// expect: run replaced_entry() = true
fn replaced_entry() -> bool {
    for form in 0u64 .. 3 {
        for shared in 0u64 .. 2 {
            let mut ids: u64 = 0
            let mut m: omap.OMap[u64, Bytes] = omap.new()
            for i in 0u64 .. 80 {
                let (take next, take old) = result.unwrap(omap.insert_owned(mut ids, take m, i, byte_key(i)))
                if let Some(_) = old {
                    return false
                }
                m = take next
            }
            let held = if shared == 1 {
                omap.snapshot(m)
            } else {
                omap.new()
            }
            let prior: Bytes = result.unwrap(clone(option.unwrap(omap.get(m, 31))))
            let (take changed, take old) = if form == 0 {
                result.unwrap(omap.insert(mut ids, m, 31, byte_key(200)))
            } else if form == 1 {
                result.unwrap(omap.insert_owned(mut ids, take m, 31, byte_key(200)))
            } else {
                result.unwrap(omap.insert_recover(mut ids, take m, 31, byte_key(200)))
            }
            let replaced = option.unwrap(take old)
            if omap.replaced_value(replaced) != prior || option.unwrap(omap.get(changed, 31)) != byte_key(200) || omap.len(changed) != 80 {
                return false
            }
            if shared == 1 && option.unwrap(omap.get(held, 31)) != prior {
                return false
            }
            // Drop the new map too; only the result need retain the old bytes.
            let _ = take changed
            if omap.replaced_value(replaced) != prior {
                return false
            }
        }
    }
    true
}

// A failed replacement returns the original root and inputs, with no result
// entry. Try allocation failures before and after copying part of the path.
// expect: run replaced_capacity() = true
fn replaced_capacity() -> bool {
    let mut refused: u64 = 0
    let mut succeeded: u64 = 0
    for budget in 0u64 .. 48 {
        let mut ids: u64 = 0
        let mut m: omap.OMap[u64, String] = omap.new()
        for i in 0u64 .. 80 {
            let (take next, _) = result.unwrap(omap.insert_owned(mut ids, take m, i, "stored"))
            m = take next
        }
        let id = omap.node_id(option.unwrap(omap.root(m)))
        let answer = result.unwrap(bound bytes budget * 64 {
            omap.insert_recover(mut ids, take m, 31, "updated")
        })
        match take answer {
            Error((_, (take original, (k, take v)))) => {
                if k != 31 || v != "updated" || omap.node_id(option.unwrap(omap.root(original))) != id || omap.len(original) != 80 {
                    return false
                }
                for i in 0u64 .. 80 {
                    if option.unwrap(omap.get(original, i)) != "stored" {
                        return false
                    }
                }
                refused += 1
            },
            Ok((take changed, take old)) => {
                if omap.replaced_value(option.unwrap(take old)) != "stored" || option.unwrap(omap.get(changed, 31)) != "updated" {
                    return false
                }
                succeeded += 1
            }
        }
    }
    refused > 0 && succeeded > 0
}

fn separator_key(i: u64) -> Bytes {
    let mut out: Bytes = result.unwrap(list.with_capacity(128))
    result.unwrap(list.push(mut out, int.narrow(i / 256)))
    result.unwrap(list.push(mut out, int.narrow(i % 256)))
    for _ in 0u64 .. 126 {
        result.unwrap(list.push(mut out, 0u8))
    }
    out
}

// A retained tree with 128-byte keys needs room for one copied leaf, not
// another payload copy of every separator in both branch levels.
// expect: run separator_payload_budget() = true
fn separator_payload_budget() -> bool {
    let mut ids: u64 = 0
    let mut keys: List[Bytes] = result.unwrap(list.with_capacity(1100))
    let mut values: List[u64] = result.unwrap(list.with_capacity(1100))
    for i in 0u64 .. 1100 {
        result.unwrap(list.push(mut keys, separator_key(i)))
        result.unwrap(list.push(mut values, i))
    }
    let m = result.unwrap(omap.from_sorted(mut ids, keys, values))
    let k = separator_key(500)
    let answer = result.unwrap(bound bytes 7500 {
        omap.insert(mut ids, m, take k, 9000)
    })
    match take answer {
        Error(_) => false,
        Ok((take changed, take old)) => {
            omap.replaced_value(option.unwrap(take old)) == 500 && option.unwrap(omap.get(changed, separator_key(500))) == 9000 && option.unwrap(omap.get(m, separator_key(500))) == 500 && omap.len(changed) == 1100 && omap.len(m) == 1100
        }
    }
}

// Existing nodes and list capacities admit an overwrite under zero new bytes.
// The old unwrap/new path frees the node and then refuses its replacement here.
// expect: run owned_unique_reuses_nodes() = true
fn owned_unique_reuses_nodes() -> bool {
    let mut ids = 0u64
    let mut m: omap.OMap[u64, u64] = omap.new()
    for i in 0u64 .. 80 {
        let previous = take m
        let (take next_map, _) = result.unwrap(omap.insert_owned(mut ids, take previous, i, i + 5))
        m = take next_map
    }
    let previous = take m
    let changed = result.unwrap(bound bytes 0 {
        omap.insert_owned(mut ids, take previous, 40, 999)
    })
    match take changed {
        Ok((take next_map, take old)) => omap.len(next_map) == 80 && option.unwrap(omap.get(next_map, 40)) == 999 && option.unwrap(omap.get(next_map, 39)) == 44 && option.unwrap(omap.get(next_map, 41)) == 46 && match take old {
            Some(take replaced) => omap.replaced_value(replaced) == 45,
            None => false
        },
        Error(_) => false
    }
}

// 1100 keys force leaf and branch splits. For values i+1, i+2 and i+3,
// arithmetic-series sums are 605550, 606650 and 607750 respectively.
// The first overwrite is unique; the second keeps an independent version.
// expect: run owned_replaced_checksums() = true
fn owned_replaced_checksums() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[u64, u64] = omap.new()
    for i in 0u64 .. 1100 {
        let previous = take m
        let (take changed, take old) = result.unwrap(omap.insert_owned(mut ids, take previous, i, i + 1))
        if let Some(_) = old {
            return false
        }
        m = take changed
    }
    let mut first_sum: u64 = 0
    for i in 0u64 .. 1100 {
        let previous = take m
        let (take changed, take old) = result.unwrap(omap.insert_owned(mut ids, take previous, i, i + 2))
        let replaced = option.unwrap(take old)
        first_sum += omap.replaced_value(replaced)
        m = take changed
    }
    let held = omap.snapshot(m)
    let mut second_sum: u64 = 0
    for i in 0u64 .. 1100 {
        let previous = take m
        let (take changed, take old) = result.unwrap(omap.insert_owned(mut ids, take previous, i, i + 3))
        let replaced = option.unwrap(take old)
        second_sum += omap.replaced_value(replaced)
        m = take changed
    }
    let mut held_sum: u64 = 0
    let mut final_sum: u64 = 0
    for i in 0u64 .. 1100 {
        let old_value: u64 = match omap.get(held, i) {
            Some(v) => v,
            None => return false
        }
        let new_value: u64 = match omap.get(m, i) {
            Some(v) => v,
            None => return false
        }
        if old_value != i + 2 || new_value != i + 3 {
            return false
        }
        held_sum += old_value
        final_sum += new_value
    }
    first_sum == 605550 && second_sum == 606650 && held_sum == 606650 && final_sum == 607750 && omap.len(m) == 1100 && omap.len(held) == 1100
}

fn large_byte_row(i: u64) -> Bytes {
    let mut out: Bytes = result.unwrap(list.with_capacity(1024))
    for _ in 0u64 .. 1024 {
        result.unwrap(list.push(mut out, int.narrow(i)))
    }
    take out
}

// A copied 32-row leaf needs 256 bytes of holders, one node and one new row.
// Its 64 KiB of existing payload must remain shared within this 8 KiB bound.
// expect: run shared_payload_copy_budget() = true
fn shared_payload_copy_budget() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[Bytes, Bytes] = omap.new()
    for i in 0u64 .. 32 {
        let (take next_map, _) = result.unwrap(omap.insert(mut ids, m, large_byte_row(i), large_byte_row(i)))
        m = take next_map
    }
    let held = omap.snapshot(m)
    let key = large_byte_row(16)
    let value = large_byte_row(99)
    let answer = result.unwrap(bound bytes 8192 {
        omap.insert_owned(mut ids, take m, take key, take value)
    })
    match take answer {
        Error(_) => false,
        Ok((take next_map, take old)) => {
            let old_row = option.unwrap(take old)
            let original = option.unwrap(omap.get(held, large_byte_row(16)))
            let changed = option.unwrap(omap.get(next_map, large_byte_row(16)))
            let old_value = omap.replaced_value(old_row)
            original[0] == 16 && original[1023] == 16 && changed[0] == 99 && changed[1023] == 99 && old_value[0] == 16 && omap.len(held) == 32 && omap.len(next_map) == 32
        }
    }
}

// Inputs already own their 2 KiB payload. Only holders and nodes are charged
// inside the bound, including for an empty consuming map's reserved leaf.
// expect: run insert_moves_payloads() = true
fn insert_moves_payloads() -> bool {
    for mode in 0u64 .. 3 {
        let mut ids: u64 = 0
        let m: omap.OMap[Bytes, Bytes] = omap.new()
        let key = large_byte_row(7)
        let value = large_byte_row(9)
        if mode == 0 {
            let answer = result.unwrap(bound bytes 1024 {
                omap.insert(mut ids, m, take key, take value)
            })
            match take answer {
                Ok((take changed, _)) => if omap.len(changed) != 1 || option.unwrap(omap.get(changed, large_byte_row(7)))[1023] != 9 {
                    return false
                },
                Error(_) => return false
            }
        } else if mode == 1 {
            let answer = result.unwrap(bound bytes 1024 {
                omap.insert_owned(mut ids, take m, take key, take value)
            })
            match take answer {
                Ok((take changed, _)) => if omap.len(changed) != 1 || option.unwrap(omap.get(changed, large_byte_row(7)))[1023] != 9 {
                    return false
                },
                Error(_) => return false
            }
        } else {
            let answer = result.unwrap(bound bytes 1024 {
                omap.insert_recover(mut ids, take m, take key, take value)
            })
            match take answer {
                Ok((take changed, _)) => if omap.len(changed) != 1 || option.unwrap(omap.get(changed, large_byte_row(7)))[1023] != 9 {
                    return false
                },
                Error(_) => return false
            }
        }
    }
    true
}

// Refuse before row allocation and after partial path construction. Recovered
// dynamic payloads must survive intact after every temporary holder is freed.
// expect: run moved_capacity_payloads() = true
fn moved_capacity_payloads() -> bool {
    let mut ids: u64 = 0
    let mut m: omap.OMap[Bytes, Bytes] = omap.new()
    for i in 0u64 .. 80 {
        let (take changed, _) = result.unwrap(omap.insert(mut ids, m, byte_key(i), byte_key(i)))
        m = take changed
    }
    let old_id = omap.node_id(option.unwrap(omap.root(m)))
    let mut refused: u64 = 0
    let mut completed: u64 = 0
    for i in 0u64 .. 32 {
        let key = large_byte_row(81)
        let value = large_byte_row(99)
        let held = omap.snapshot(m)
        let answer = result.unwrap(bound bytes i * 64 {
            omap.insert_recover(mut ids, take held, take key, take value)
        })
        match take answer {
            Error((_, (take returned_map, (take returned_key, take returned_value)))) => {
                refused += 1
                if omap.len(returned_map) != 80 || omap.node_id(option.unwrap(omap.root(returned_map))) != old_id || list.len(returned_key) != 1024 || returned_key[0] != 81 || returned_key[1023] != 81 || list.len(returned_value) != 1024 || returned_value[0] != 99 || returned_value[1023] != 99 {
                    return false
                }
            },
            Ok((take changed, _)) => {
                completed += 1
                if omap.len(changed) != 81 {
                    return false
                }
            }
        }
    }
    refused > 1 && completed > 0 && omap.len(m) == 80
}

// A full 32-child root and full leaves force one borrowed branch split.
// The retained version keeps all 1024 original values and its root identity.
// expect: run borrowed_branch_split_keeps_snapshot() = true
fn borrowed_branch_split_keeps_snapshot() -> bool {
    let mut ids: u64 = 0
    let mut keys: List[u64] = result.unwrap(list.with_capacity(1024))
    let mut values: List[u64] = result.unwrap(list.with_capacity(1024))
    for i in 0u64 .. 1024 {
        result.unwrap(list.push(mut keys, i))
        result.unwrap(list.push(mut values, i + 1))
    }
    let old = result.unwrap(omap.from_sorted(mut ids, take keys, take values))
    let old_id = omap.node_id(option.unwrap(omap.root(old)))
    let changed = put(mut ids, old, 1024, 1025)
    if omap.len(old) != 1024 || omap.len(changed) != 1025 || omap.node_id(option.unwrap(omap.root(old))) != old_id {
        return false
    }
    if let Some(_) = omap.get(old, 1024) {
        return false
    }
    for i in 0u64 .. 1024 {
        if option.unwrap(omap.get(old, i)) != i + 1 || option.unwrap(omap.get(changed, i)) != i + 1 {
            return false
        }
    }
    option.unwrap(omap.get(changed, 1024)) == 1025 && nodes(option.unwrap(omap.root(old)), true) && nodes(option.unwrap(omap.root(changed)), true)
}

// An 8-byte key clone fits, then the 16-byte value clone is refused.
// The temporary key must release its charge and the retry must see that row.
// expect: run next_value_clone_refusal_retries() = true
fn next_value_clone_refusal_retries() -> bool {
    let mut ids: u64 = 0
    let m: omap.OMap[String, String] = omap.new()
    let key = result.unwrap(string.from("key"))
    let value = result.unwrap(string.from("long value"))
    let (take inserted, _) = result.unwrap(omap.insert(mut ids, m, take key, take value))
    let mut c = result.unwrap(omap.range(inserted, Unbounded, Unbounded))
    let checked = result.unwrap(bound bytes 8 {
        let refusal = match omap.next(mut c) {
            Error(e) => e.requested == 16 && e.available == 0,
            _ => false
        }
        let reservation: Result[List[u8], Capacity] = list.with_capacity(8)
        let refunded = match reservation {
            Ok(probe) => list.capacity(probe) == 8,
            Error(_) => false
        }
        refusal && refunded
    })
    if !checked {
        return false
    }
    match result.unwrap(omap.next(mut c)) {
        Some((k, v)) => k == "key" && v == "long value",
        None => false
    }
}

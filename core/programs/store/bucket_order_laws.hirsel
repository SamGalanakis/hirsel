type WireOrder: send = LostReply | Overtaken | FencedAfterRead

type OrderedWriter: send {
    tasks: Tasks,
    r: Random,
    clock: Clock,
    endpoint: std.sim.s3.Endpoint,
    ordering: WireOrder,
    read_done: Sender[()],
    retry: Receiver[()]
}

fn bucket_order_options(create: bool) -> Options {
    let mut options = bucket_law_options(create)
    options.group_bytes = 65536
    options.group_commits = 1
    options.head_poll_ms = 600000
    take options
}

fn bucket_order_open(tasks: Tasks, r: Random, clock: Clock, endpoint: std.sim.s3.Endpoint, seed: u64, create: bool) -> Result[Db, Error] waits {
    let client = bucket_endpoint_client(endpoint, std.sim.s3.endpoint_network(endpoint), clock, tasks, "s3.test", seed, true, 0)?
    let authority = object_authority(take client, "bucket", BUCKET_LAW_OP_MS)
    Ok(open_authority(tasks, take authority, clock, r, bucket_order_options(create)) ?=> |Refusal(error: take problem, ..)| take problem)
}

// An empty commit still advances the main version. This keeps schema changes
// and their automatic cuts out of the head request schedule.
fn bucket_order_commit(mut db: Db) -> Result[Ticket, Error] waits {
    let written = run(mut db, None, (), fn(mut tx, unused_env) -> Result[(), Error] { Ok(()) })?
    let Committed(done) = written else { fail("the ordered test commit was refused") }
    Ok(done.ticket)
}

fn bucket_order_fresh(take writer: OrderedWriter) -> Result[(), Error] waits {
    let mut db = bucket_order_open(writer.tasks, writer.r, writer.clock, writer.endpoint, 1, true)?
    for _ in 0u64 .. 2 {
        let receipt = bucket_order_commit(mut db)?
        durable(mut db, receipt)?
    }
    let third = bucket_order_commit(mut db)?
    let until = clock.deadline_after_ms(host.mono_ns(writer.clock), BUCKET_LAW_OP_MS)
    let observed = fresh_snapshot(mut db, until)
    if let Overtaken = writer.ordering {
        match observed {
            Error(Fenced(1)) => (),
            _ => fail("L57-a: an overtaken fresh read did not report Fenced"),
        }
        if let Ok(()) = durable(mut db, third) {
            fail("L57-a: an unapplied commit was acknowledged")
        }
        return Ok(())
    }
    if version(observed?) != 3 { fail("L57-a: fresh missed the applied position 5") }
    durable(mut db, third)?
    if let FencedAfterRead = writer.ordering {
        let _ = channel.send(writer.read_done, ())
        let _ = channel.receive(writer.retry)
        match fresh_snapshot(mut db, until) {
            Error(Fenced(1)) => (),
            _ => fail("L57-a: fresh did not see the later claim"),
        }
        durable(mut db, third)?
    }
    Ok(())
}

fn bucket_order_history(report: std.sim.s3.Report) -> bool {
    let mut found = 0u64
    let request_id = report.head_writes[4].request
    // Successful PUT (reply lost), conditional retry, Q5 witness, fresh probe.
    for req in report.requests {
        if req.key != "head" { continue }
        if req.request == request_id { found = 1; continue }
        match found {
            0 => (),
            1 if req.method == "PUT" && req.status == 412 && !req.applied => { found += 1 },
            2 if req.method == "GET" && req.status == 200 => { found += 1 },
            3 if req.method == "GET" && req.status == 304 => return true,
            _ => return false,
        }
    }
    false
}

fn bucket_order_fresh_case(tasks: Tasks, c: Clock, r: Random, seed: u64, ordering: WireOrder) -> Result[(), Error] waits {
    let hold: std.sim.s3.Hold = match ordering {
        Overtaken => std.sim.s3.Hold(method: "PUT", key: "head", from: 5, count: 1, until: Applied("PUT", "head", 6), then: Apply),
        _ => std.sim.s3.Hold(method: "PUT", key: "head", from: 5, count: 1, until: At(50000000), then: ApplyLoseReply),
    }
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    list.push(mut holds, take hold)
    let sim = bucket_law_sim_holds(tasks, c, seed, None, list.new(), take holds, std.sim.world.plan(seed))
    let (first_done, complete): (Sender[()], Receiver[()]) = channel.new(1)
    let (go, retry): (Sender[()], Receiver[()]) = channel.new(1)
    let writer = OrderedWriter(tasks, r, clock: sim.time, endpoint: sim.endpoint, ordering, read_done: take first_done, retry: take retry)
    let running = task.spawn(tasks, bytes 33554432, take writer, bucket_order_fresh)
    match ordering {
        LostReply => (),
        Overtaken => {
            result.unwrap(std.sim.s3.requested(sim.endpoint, "PUT", "head", 5))
            let successor = bucket_order_open(tasks, r, sim.time, sim.endpoint, 2, false)?
            if version(snapshot(successor)) != 2 { fail("L57-a: the successor recovered the unapplied commit") }
            close(take successor)?
        },
        FencedAfterRead => {
            result.unwrap(channel.receive(complete))
            let successor = bucket_order_open(tasks, r, sim.time, sim.endpoint, 2, false)?
            if version(snapshot(successor)) != 3 { fail("L57-a: the successor lost the applied commit") }
            close(take successor)?
            result.unwrap(channel.send(go, ()))
        },
    }
    let tested = result.unwrap(task.join(take running))
    let report = bucket_law_finish(take sim)
    tested?
    match ordering {
        Overtaken => {
            for write in report.head_writes {
                if read_le(write.data, 88, 8) == 1 && read_le(write.data, 120, 8) >= 5 {
                    fail("L57-a: the overtaken holder advanced its prefix")
                }
            }
        },
        _ => {
            if list.len(report.head_writes) < 5 || read_le(report.head_writes[4].data, 120, 8) != 5 ||
                !bucket_order_history(report) {
                fail("L57-a: head requests did not follow the reply-loss and fresh sequence")
            }
        },
    }
    Ok(())
}

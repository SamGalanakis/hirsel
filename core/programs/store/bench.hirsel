// R1–R3. The READY/DONE gate is std.omap's phase-measurement protocol.
pub type Account: send + codec {
    id: u64,
    balance: i64,
    owner: String
}

fn insert(mut db: store.Db, t: store.Table[u64, Account], i: u64) -> u64 waits {
    let done = result.unwrap(store.run(mut db, None, (store.copy_env(i), store.copy_env(t)), fn(mut tx, call_env) -> Result[u64, store.Error] {
        let a = Account(id: call_env.0, balance: int.narrow(call_env.0), owner: string.from("owner000"))
        store.put(mut tx, call_env.1, call_env.0, a)?
        let back = option.unwrap(store.fetch(tx, call_env.1, call_env.0)?)
        if back.id != call_env.0 || back.balance != int.narrow(call_env.0) || back.owner != "owner000" {
            fail("store R1 wrong row")
        }
        Ok(back.id + string.byte_len(back.owner))
    }))
    match take done {
        Committed(x) => x.value,
        _ => fail("store R1 refused")
    }
}

type Reader: send {
    handle: store.Reader,
    held: store.Snapshot,
    sh: store.Table[u64, Account]
}

fn read_source(take r: Reader) -> u64 waits {
    let mut state: u64 = 1
    let mut sum: u64 = 0
    for _ in 0u64 .. 100000 {
        let k = store.splitmix64(state) % 100000
        state = int.wrapping_add(state, 0x9E3779B97F4A7C15u64)
        let a = option.unwrap(result.unwrap(store.get(r.handle, r.held, r.sh, k)))
        if a.id != k || a.balance != int.narrow(k) || a.owner != "owner000" {
            fail("store R3 wrong row")
        }
        sum += a.id + string.byte_len(a.owner)
    }
    sum
}

pub fn main(dir: Dir, clock: Clock, random: Random, tasks: Tasks, out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let mode = option.unwrap(args.get(argv, 0))
    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let accounts: std.codec.Codec[Account] = std.codec.of()
    let mut schema = result.unwrap(store.declare(db, Migrate))
    let declared = result.unwrap(store.declare_table(mut schema, "accounts", std.codec.key_u64(), accounts))
    let t = result.unwrap(store.finish(mut schema, take declared))
    let _ = result.unwrap(store.seal(mut db, take schema))
    if mode != "R1" {
        for i in 0u64 .. 100000 {
            let _ = insert(mut db, t, i)
        }
    }
    let held = store.snapshot(db)
    let sh: store.Table[u64, Account] = clone(t)
    let mut gate = result.unwrap(host.open(dir, "gate", Read))
    let mut byte: Bytes = list.with_capacity(1)
    result.unwrap(stdout.write(out, "READY\n"))
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    let start = host.mono_ns(clock)
    let mut sum: u64 = 0
    if mode == "R1" {
        for i in 0u64 .. 100000 {
            sum += insert(mut db, t, i)
        }
    } else if mode == "R2" {
        let handle = result.unwrap(store.reader(db, 0u64))
        let mut rows = result.unwrap(store.scan(handle, held, sh, Unbounded, Unbounded))
        while let Some((k, a)) = result.unwrap(store.next(handle, mut rows)) {
            if a.id != k || a.balance != int.narrow(k) || a.owner != "owner000" {
                fail("store R2 wrong row")
            }
            sum += a.id + string.byte_len(a.owner)
        }
    } else {
        let payload = Reader(handle: result.unwrap(store.reader(db, 0u64)), held: take held, sh: take sh)
        let h = task.spawn(tasks, bytes 16777216, take payload, read_source)
        sum = result.unwrap(task.join(take h))
    }
    let elapsed = host.mono_ns(clock) - start
    let mut rendered = string.new()
    string.push(mut rendered, "DONE ")
    string.push_u64(mut rendered, sum)
    string.push(mut rendered, " ")
    string.push_u64(mut rendered, elapsed)
    string.push(mut rendered, "\n")
    result.unwrap(stdout.write(out, rendered))
    list.clear(mut byte)
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    if store.version(store.snapshot(db)) != 100001 {
        return Error(Exit(status: 6))
    }
    Ok(())
}

// The P-256 test identity of core/programs/quic (authentication_vectors.hirsel), copied: the
// certificate and its SHA-256 pin, made with Python cryptography (OpenSSL) and hashlib.
fn cert_old() -> Bytes {
    option.unwrap(std.hex.decode(b""))
}

fn old_digest() -> Inline[u8, 32] {
    [22, 152, 95, 217, 108, 32, 99, 25, 28, 177, 201, 36, 198, 124, 23, 187, 129, 43, 78, 68, 81, 35, 158, 172, 159, 56, 49, 60, 242, 53, 214, 166]
}

// A row's index values: its sorted, distinct keys and the payload each
// carries; an aggregate's `sums` give each group's value, by position.
pub type IndexValue {
    keys: List[Bytes],
    payload: Bytes,
    sums: List[u64]
}

pub opaque type RegisteredIndex: send {
    id: u32,
    schema: u16,
    ordinal: u64,
    by: Bytes,
    key: Bytes,
    extract: own[send] fn(Bytes, Bytes) -> Result[IndexValue, types.Failure],
    // Where a Many entry's primary key starts in the entry key: after the
    // four-byte id and the index key. The verify walker reads it (§1.2a).
    key_end: own[send] fn(Bytes) -> Result[u64, types.Failure]
}

pub opaque type IndexRegistration: send {
    table: u32,
    index: RegisteredIndex
}

pub opaque type IndexRegistry: send {
    entries: Map[(u32, u32, u16), RegisteredIndex],
    next_ordinal: u64,
    // Each Log the declaration keeps to its newest n (§14.4a), by id.
    retention: Map[u32, catalog.LogRetention]
}

pub fn empty_index_registry() -> IndexRegistry {
    IndexRegistry(entries: map.new(), next_ordinal: 0, retention: map.new())
}

pub fn entry_key_end[J](key: std.codec.Key[J]) -> own[send] fn(Bytes) -> Result[u64, types.Failure] {
    let end: own[send] fn(Bytes) -> Result[u64, types.Failure] = fn(raw: Bytes) -> Result[u64, types.Failure] {
        let mut at = 4u64
        let _ = catalog.decoded(std.codec.take_key_with(raw, mut at, key))?
        Ok(at)
    }
    take end
}

pub fn index_registration(table: u32, schema: u16, record: Catalog, take extract: own[send] fn(Bytes, Bytes) -> Result[IndexValue, types.Failure], take key_end: own[send] fn(Bytes) -> Result[u64, types.Failure]) -> IndexRegistration {
    IndexRegistration(table: table, index: RegisteredIndex(id: record.id, schema: schema, ordinal: 0, by: clone(record.by), key: clone(record.key), extract: take extract, key_end: take key_end))
}

fn register_index(mut registry: IndexRegistry, take schema_binding: IndexRegistration) {
    let IndexRegistration(table: table_id, index: take incoming) = take schema_binding
    let mut bound_index = take incoming
    let key = (table_id, bound_index.id, bound_index.schema)
    bound_index.ordinal = registry.next_ordinal
    registry.next_ordinal += 1
    map.insert(mut registry.entries, key, take bound_index)
}

pub fn unique_owner_end(raw: Bytes) -> Result[u64, types.Failure] {
    let mut at = 0u64
    let width = take_le(raw, mut at, 4)?
    if width > list.len(raw) - at {
        return Error(pages.malformed(at))
    }
    Ok(at + width)
}

pub fn find_index_name(catalog_tree: pages.PageTree, table_id: u32, index_id: u32) -> Result[String, types.Failure] {
    let mut cursor = pages.open_page_range(catalog_tree, Some(catalog.index_prefix(table_id)?), true, false, Some(types.copied(catalog.index_prefix(table_id + 1)?)?))?
    while let Some((key, raw)) = catalog.next_bytes(mut cursor)? {
        if format.read_le(raw, 1, 4) == int.widen(index_id) {
            return catalog.declaration_index_name(key)
        }
    }
    Error(Stale(index_id))
}

pub type Catalog {
    record: CatalogRecord,
    id: u32,
    owner: u32,
    epoch: u64,
    key: Bytes,
    schemas: List[catalog.ValueSchema],
    next: u16,
    by: Bytes,
    // The length-prefixed composite identity, empty when absent.
    revision: Bytes
}

pub type CatalogRecord = CatalogTable | CatalogCell | CatalogLog | CatalogIndex(IndexRecord)

pub type IndexRecord {
    shape: IndexShape,
    payload_schemas: List[Bytes],
    projection: Option[(Bytes, Bytes)],
    state: BuildState
}

pub fn catalog_kind(record: CatalogRecord) -> std.page_descriptor.CollectionKind {
    match record {
        CatalogTable => TableCollection,
        CatalogIndex(_) => IndexCollection,
        CatalogCell => CellCollection,
        CatalogLog => LogCollection,
    }
}

pub fn catalog_index(catalog: Catalog) -> Result[View[IndexRecord], types.Failure] in catalog {
    let CatalogIndex(index_record) = view catalog.record else {
        return Error(pages.malformed(0))
    }
    Ok(view index_record)
}

pub fn set_index_state(mut catalog: Catalog, take state: BuildState) -> Result[(), types.Failure] {
    if let CatalogIndex(mut index_record) = catalog.record {
        index_record.state = take state
        return Ok(())
    }
    Error(pages.malformed(0))
}

// What an index record's collection holds (§1.2): the entries of a Many or
// Unique index, or an aggregate's one count-and-sum row per group.
pub type IndexShape: send = Entries(EntryKind) | Sums

pub type EntryKind: send = ManyEntry | UniqueEntry

// The build state tag is the last catalog byte, so a read can check Public
// without decoding the record.
pub type BuildState: shareable + send = Backfilling(Option[Bytes]) | Public | Failed(Bytes, Bytes)

pub fn copy_build_state(state: BuildState) -> Result[BuildState, types.Failure] {
    Ok(match state {
        Public => Public,
        Backfilling(None) => Backfilling(None),
        Backfilling(Some(cursor)) => Backfilling(Some(types.copied(cursor)?)),
        Failed(first, second) => Failed(types.copied(first)?, types.copied(second)?),
    })
}

// The shape's catalog byte, which also compares two shapes.
pub fn shape_byte(shape: IndexShape) -> u64 {
    match shape {
        Entries(ManyEntry) => 0,
        Entries(UniqueEntry) => 1,
        Sums => 2,
    }
}

// The kind an entry-index handle reads with. An aggregate has no entries.
pub fn entry_kind(shape: IndexShape) -> Result[EntryKind, types.Failure] {
    match shape {
        Entries(kind) => Ok(kind),
        Sums => Error(Schema(0)),
    }
}

// Whether the index holds a row's values: every row of a Public index, and
// the rows at or before a building index's cursor. A Failed index is
// incomplete and claims none.
pub fn index_claims(state: BuildState, primary: Bytes) -> bool {
    match state {
        Public => true,
        Backfilling(Some(cursor)) => primary <= cursor,
        _ => false,
    }
}

pub fn take_le(raw: Bytes, mut at: u64, width: u64) -> Result[u64, types.Failure] {
    if at > list.len(raw) || width > list.len(raw) - at {
        return Error(pages.malformed(at))
    }
    let n = format.read_le(raw, at, width)
    at += width
    Ok(n)
}

fn take_blob(raw: Bytes, mut at: u64) -> Result[Bytes, types.Failure] {
    let n = take_le(raw, mut at, 4)?
    if n > list.len(raw) - at {
        return Error(pages.malformed(at))
    }
    let data = list.slice(raw, at, at + n)
    let out = types.copied(data)?
    at += n
    Ok(take out)
}

pub fn decode_catalog(raw: Bytes) -> Result[Catalog, types.Failure] {
    let mut at: u64 = 0
    let kind: u8 = int.truncate(take_le(raw, mut at, 1)?)
    let id: u32 = int.truncate(take_le(raw, mut at, 4)?)
    let owner: u32 = int.truncate(take_le(raw, mut at, 4)?)
    let epoch = take_le(raw, mut at, 8)?
    if kind < 1 || kind > 4 || id == 0 || epoch == 0 || (kind == 2 && owner == 0) {
        return Error(pages.malformed(0))
    }
    let key = take_blob(raw, mut at)?
    if kind == 3 && list.len(key) != 0 {
        return Error(pages.malformed(17))
    }
    if kind == 4 {
        let expected = std.codec.key_schema(std.codec.key_u64()) ?=> |_| pages.malformed(17)
        if key != expected {
            return Error(pages.malformed(17))
        }
    }
    let schema_count = take_le(raw, mut at, 2)?
    let mut schemas: List[catalog.ValueSchema] = list.new()
    for _ in 0u64 .. schema_count {
        let number: u16 = int.truncate(take_le(raw, mut at, 2)?)
        let fingerprint = take_le(raw, mut at, 8)?
        let schema = take_blob(raw, mut at)?
        list.push(mut schemas, catalog.ValueSchema(number: number, fingerprint: fingerprint, schema: take schema))
    }
    let next_number: u16 = int.truncate(take_le(raw, mut at, 2)?)
    let by = take_blob(raw, mut at)?
    let revision = take_blob(raw, mut at)?
    let record: CatalogRecord = match kind {
        1 => CatalogTable,
        2 => CatalogIndex(decode_index_record(raw, mut at)?),
        3 => CatalogCell,
        4 => CatalogLog,
        _ => return Error(pages.malformed(0)),
    }
    if at != list.len(raw) {
        return Error(pages.malformed(at))
    }
    Ok(Catalog(record: take record, id: id, owner: owner, epoch: epoch, key: take key, schemas: take schemas, next: next_number, by: take by, revision: take revision))
}

fn decode_index_record(raw: Bytes, mut at: u64) -> Result[IndexRecord, types.Failure] {
    let shape: IndexShape = match take_le(raw, mut at, 1)? {
        0 => Entries(ManyEntry),
        1 => Entries(UniqueEntry),
        2 => Sums,
        _ => return Error(pages.malformed(at - 1)),
    }
    let mut payload_schemas: List[Bytes] = list.new()
    let payload_count = take_le(raw, mut at, 2)?
    for _ in 0u64 .. payload_count {
        list.push(mut payload_schemas, take_blob(raw, mut at)?)
    }
    let project_id = take_blob(raw, mut at)?
    let project_revision = take_blob(raw, mut at)?
    let projection_record = if list.len(project_id) > 0 {
        Some((take project_id, take project_revision))
    } else {
        if list.len(project_revision) > 0 {
            return Error(pages.malformed(at))
        }
        None
    }
    // An aggregate's rows carry totals, never a payload.
    if let Sums = shape {
        let projected = if let Some(_) = projection_record {
            true
        } else {
            false
        }
        if payload_count != 0 || projected {
            return Error(pages.malformed(at))
        }
    }
    if at >= list.len(raw) {
        return Error(pages.malformed(at))
    }
    let tag_at = list.len(raw) - 1
    let state: BuildState = match raw[tag_at] {
        0 => Public,
        1 => Backfilling(None),
        2 => Backfilling(Some(take_blob(raw, mut at)?)),
        3 => {
            let first = take_blob(raw, mut at)?
            Failed(take first, take_blob(raw, mut at)?)
        },
        _ => return Error(pages.malformed(tag_at)),
    }
    if at != tag_at {
        return Error(pages.malformed(at))
    }
    at += 1
    Ok(IndexRecord(shape, payload_schemas: take payload_schemas, projection: take projection_record, state: take state))
}

pub fn encode_catalog(c: Catalog) -> Result[Bytes, types.Failure] {
    let mut raw: Bytes = list.new()
    types.capacity(format.le(mut raw, int.widen(pages.descriptor_kind_byte(catalog_kind(c.record))), 1))?
    types.capacity(format.le(mut raw, int.widen(c.id), 4))?
    types.capacity(format.le(mut raw, int.widen(c.owner), 4))?
    types.capacity(format.le(mut raw, c.epoch, 8))?
    types.capacity(format.blob(mut raw, c.key))?
    types.capacity(format.le(mut raw, list.len(c.schemas), 2))?
    for schema in c.schemas {
        types.capacity(format.le(mut raw, int.widen(schema.number), 2))?
        types.capacity(format.le(mut raw, schema.fingerprint, 8))?
        types.capacity(format.blob(mut raw, schema.schema))?
    }
    types.capacity(format.le(mut raw, int.widen(c.next), 2))?
    types.capacity(format.blob(mut raw, c.by))?
    types.capacity(format.blob(mut raw, c.revision))?
    if let CatalogIndex(index_meta) = view c.record {
        types.capacity(format.le(mut raw, shape_byte(index_meta.shape), 1))?
        types.capacity(format.le(mut raw, list.len(index_meta.payload_schemas), 2))?
        for schema in index_meta.payload_schemas {
            types.capacity(format.blob(mut raw, schema))?
        }
        match index_meta.projection {
            Some((project_id, revision)) => {
                types.capacity(format.blob(mut raw, project_id))?
                types.capacity(format.blob(mut raw, revision))?
            },
            None => types.capacity(format.le(mut raw, 0, 8))?,
        }
        match index_meta.state {
            Public => types.capacity(format.le(mut raw, 0, 1))?,
            Backfilling(None) => types.capacity(format.le(mut raw, 1, 1))?,
            Backfilling(Some(cursor)) => {
                types.capacity(format.blob(mut raw, cursor))?
                types.capacity(format.le(mut raw, 2, 1))?
            },
            Failed(first, second) => {
                types.capacity(format.blob(mut raw, first))?
                types.capacity(format.blob(mut raw, second))?
                types.capacity(format.le(mut raw, 3, 1))?
            },
        }
    }
    if list.len(raw) > 1048576 {
        return Error(Limit(Value))
    }
    Ok(take raw)
}

pub type DataEdit = StoreRow(Bytes, Bytes) | RemoveRow(Bytes, DataRefund)

pub type IndexEdits {
    probes: List[(u32, Bytes)],
    drift: Option[List[(u32, u32)]],
    first: Option[DataEdit],
    rest: List[DataEdit]
}

pub fn push_index_edit(mut edits: IndexEdits, take edit: DataEdit) {
    if let None = edits.first {
        edits.first = Some(take edit)
    } else {
        list.push(mut edits.rest, take edit)
    }
}

pub fn stage_index_drift(mut edits: IndexEdits, record: Catalog) {
    let mut seen: List[(u32, u32)] = list.new()
    list.push(mut seen, (record.owner, record.id))
    stage_drift(mut edits.drift, take seen)
}

pub fn stage_drift(mut into: Option[List[(u32, u32)]], take seen: List[(u32, u32)]) {
    if let Some(mut held) = into {
        for (owner, id) in seen {
            list.push(mut held, (owner, id))
        }
    } else {
        into = Some(take seen)
    }
}

pub fn index_catalog_in(catalog_tree: pages.PageTree, id: u32) -> Result[List[Catalog], types.Failure] {
    let low = catalog.index_prefix(id)?
    let high = catalog.index_prefix(id + 1)?
    // The catalog is resident and flat, so its ranks count the table's index
    // records without a cursor; a table with none, the common case, opens none.
    if std.page.rank(catalog_tree.root, high, false) == std.page.rank(catalog_tree.root, low, false) {
        return Ok(list.new())
    }
    let mut cursor = pages.open_page_range(catalog_tree, Some(take low), true, false, Some(types.copied(high)?))?
    let mut out: List[Catalog] = list.new()
    while let Some((_, raw)) = catalog.next_bytes(mut cursor)? {
        list.push(mut out, decode_catalog(raw)?)
    }
    Ok(take out)
}

pub type DeletePlan {
    edits: IndexEdits,
    refund: DataRefund,
    frame: Option[u64],
    indexed: bool
}

// The composite identity is the extractor revision, then the storage fingerprints
// of the table key, row, index key and payload codecs. The ends name each part
// for dry-run. Memory stores omit the composite.
pub const INDEX_IDENTITY_BYTES: u64 = 160

// Why a declared index differs from its stored record (`hirsel dry-run`'s
// rebuild report): the catalog changes and the parts of the composite identity.
// Older identities lack comparable storage fingerprints.
pub fn rebuild_cause(old: Catalog, proposed: Catalog, ends: List[u64]) -> Result[String, types.Failure] {
    let old_index = catalog_index(old)?
    let proposed_index = catalog_index(proposed)?
    let mut out = string.new()
    if shape_byte(old_index.shape) != shape_byte(proposed_index.shape) {
        catalog.note_cause(mut out, "shape")
    }
    if old.by != proposed.by {
        catalog.note_cause(mut out, "extractor")
    }
    if old.key != proposed.key {
        catalog.note_cause(mut out, "index key schema")
    }
    if old_index.payload_schemas != proposed_index.payload_schemas {
        catalog.note_cause(mut out, "payload schema")
    }
    if old_index.projection != proposed_index.projection {
        catalog.note_cause(mut out, "projection")
    }
    if old.revision != proposed.revision {
        if list.len(old.revision) != INDEX_IDENTITY_BYTES || list.len(proposed.revision) != INDEX_IDENTITY_BYTES {
            catalog.note_cause(mut out, "revision layout")
        } else {
            let mut from = 0u64
            for i in 0u64 .. list.len(ends) {
                let end = ends[i]
                if list.slice(old.revision, from, end) != list.slice(proposed.revision, from, end) {
                    catalog.note_cause(mut out, catalog.revision_part(i))
                }
                from = end
            }
        }
    }
    Ok(take out)
}

pub fn edit_frame(ops: pages.DataOps, below: List[Arc[pages.Staged]], extra: u64, key: Bytes, value_size: Option[u64], frame: Option[u64], transaction: u64) -> Result[Option[u64], types.Failure] {
    let Some(current) = frame else {
        return Ok(None)
    }
    let width = match value_size {
        Some(size) => 13 + size,
        None => 9u64,
    } + list.len(key)
    let after = int.saturating_add(current - pages.old_data_op_size(ops, below, false, key), width)
    if int.saturating_add(after, extra) - 16 > transaction {
        return Error(Limit(Transaction))
    }
    Ok(Some(after))
}

pub type DataRefund {
    charge: u64,
    prior: Option[u32]
}

pub fn catalog_entry_in(catalog_tree: pages.PageTree, k: Bytes) -> Result[Catalog, types.Failure] {
    match pages.get_page_row(catalog_tree, k) {
        Some(raw) => decode_catalog(raw),
        None => Error(Stale(0))
    }
}

pub opaque type IndexBindings: send {
    items: List[IndexRegistration]
}

pub fn empty_bindings() -> IndexBindings {
    IndexBindings(items: list.new())
}

pub fn add_binding(mut bindings: IndexBindings, take binding: IndexRegistration) {
    list.push(mut bindings.items, take binding)
}

pub fn binding_extractor(binding: IndexRegistration) -> View[RegisteredIndex] in binding {
    view binding.index
}

pub fn binding_at(bindings: IndexBindings, slot: u64) -> View[RegisteredIndex] in bindings {
    view bindings.items[slot].index
}

pub fn find_binding_index(bindings: IndexBindings, table_id: u32, index_id: u32) -> Option[u64] {
    let n = list.len(bindings.items)
    for i in 0u64 .. n {
        let slot = n - 1 - i
        let binding = view bindings.items[slot]
        if binding.table == table_id && binding.index.id == index_id {
            return Some(slot)
        }
    }
    None
}

fn matches_record(index: RegisteredIndex, record: Catalog) -> bool {
    index.id == record.id && index.by == record.by && index.key == record.key
}

pub fn matching_binding_index(bindings: IndexBindings, record: Catalog) -> Option[u64] {
    let n = list.len(bindings.items)
    for i in 0u64 .. n {
        let slot = n - 1 - i
        let binding = view bindings.items[slot]
        if binding.table == record.owner && matches_record(binding.index, record) {
            return Some(slot)
        }
    }
    None
}

pub fn binding_for_schema(bindings: IndexBindings, table_id: u32, schema: u16, record: Catalog) -> Option[View[RegisteredIndex]] in bindings {
    let n = list.len(bindings.items)
    for i in 0u64 .. n {
        let binding = view bindings.items[n - 1 - i]
        let held = view binding.index
        if binding.table == table_id && held.schema == schema && matches_record(held, record) {
            return Some(held)
        }
    }
    None
}

pub opaque type IndexOwner: send {
    registry: IndexRegistry,
    drift: List[DriftRep]
}

pub fn empty_index_owner() -> IndexOwner {
    IndexOwner(registry: empty_index_registry(), drift: list.new())
}

pub fn index_registry(owner: IndexOwner) -> View[IndexRegistry] in owner {
    view owner.registry
}

pub fn take_registry(mut owner: IndexOwner) -> IndexRegistry {
    replace(mut owner.registry, empty_index_registry())
}

pub fn restore_registry(mut owner: IndexOwner, take registry: IndexRegistry) {
    owner.registry = take registry
}

pub fn declared_index_registry(take bindings: IndexBindings) -> IndexRegistry {
    let mut registry = empty_index_registry()
    register_bindings(mut registry, take bindings)
    take registry
}

pub fn install_declaration(mut owner: IndexOwner, take bindings: IndexBindings) {
    owner.registry = declared_index_registry(take bindings)
}

pub fn install_bindings(mut owner: IndexOwner, take bindings: IndexBindings) {
    register_bindings(mut owner.registry, take bindings)
}

fn register_bindings(mut registry: IndexRegistry, take bindings: IndexBindings) {
    let IndexBindings(items: take items) = take bindings
    for take binding in take items {
        register_index(mut registry, take binding)
    }
}

pub fn registered_index(registry: IndexRegistry, table_id: u32, schema: u16, record: Catalog) -> Option[View[RegisteredIndex]] in registry {
    if let Some(held) = map.get(registry.entries, (table_id, record.id, schema)) {
        if matches_record(held, record) {
            return Some(held)
        }
    }
    None
}

pub fn bound_extractor(owner: IndexOwner, record: Catalog) -> Option[View[RegisteredIndex]] in owner {
    for ((table_id, index_id, _), held) in owner.registry.entries {
        if table_id == record.owner && index_id == record.id && held.by == record.by && held.key == record.key {
            return Some(held)
        }
    }
    None
}

pub fn ordinal(extractor: RegisteredIndex) -> u64 {
    extractor.ordinal
}

pub fn extract_row(extractor: RegisteredIndex, raw: Bytes, primary: Bytes) -> Result[IndexValue, types.Failure] {
    (extractor.extract)(raw, primary)
}

pub fn entry_primary_offset(extractor: RegisteredIndex, raw: Bytes) -> Result[u64, types.Failure] {
    (extractor.key_end)(raw)
}

// The whole declaration supplies the Logs retained by the installed registry.
pub fn bind_retention(mut owner: IndexOwner, take declared: List[catalog.LogRetention]) {
    let mut held: Map[u32, catalog.LogRetention] = map.new()
    for take r in take declared {
        let id = r.id
        if let Some(_) = r.keep {
            map.insert(mut held, id, take r)
        }
    }
    owner.registry.retention = take held
}

pub fn retention_ids(owner: IndexOwner) -> List[u32] {
    let mut ids: List[u32] = list.new()
    for (id, _) in owner.registry.retention {
        list.push(mut ids, id)
    }
    list.sort(mut ids, fn(a: u32, b: u32) -> Order {
        order.compare(a, b)
    })
    take ids
}

pub fn retention(owner: IndexOwner, id: u32) -> Option[View[catalog.LogRetention]] in owner {
    map.get(owner.registry.retention, id)
}

pub type DriftRep: send {
    table: u32,
    id: u32,
    index: String,
    count: u64,
    demoted: u64
}

pub fn drift_rows(owner: IndexOwner) -> View[List[DriftRep]] in owner {
    view owner.drift
}

fn drift_slot(owner: IndexOwner, table: u32, id: u32) -> Option[u64] {
    for at in 0u64 .. list.len(owner.drift) {
        if owner.drift[at].table == table && owner.drift[at].id == id {
            return Some(at)
        }
    }
    None
}

pub fn count_drift(mut owner: IndexOwner, tree: pages.PageTree, seen: List[(u32, u32)]) -> Result[(), types.Failure] {
    for (table, id) in seen {
        if let Some(at) = drift_slot(owner, table, id) {
            owner.drift[at].count = int.saturating_add(owner.drift[at].count, 1)
        } else {
            let name = find_index_name(tree, table, id)?
            types.capacity(list.try_reserve(mut owner.drift, 1))?
            list.push(mut owner.drift, DriftRep(table: table, id: id, index: take name, count: 1, demoted: 0))
        }
    }
    Ok(())
}

pub fn count_demotions(mut owner: IndexOwner, demoted: List[(u32, u32)]) {
    for (table, id) in demoted {
        if let Some(at) = drift_slot(owner, table, id) {
            owner.drift[at].demoted = int.saturating_add(owner.drift[at].demoted, 1)
        }
    }
}

pub fn value_schema(extractor: RegisteredIndex) -> u16 {
    extractor.schema
}

// One group a row is in, by its encoded key, and the value it adds there.
pub type GroupPart {
    key: Bytes,
    value: u64
}

fn by_group(a: GroupPart, b: GroupPart) -> Order {
    list.compare_bytes(a.key, b.key)
}

// Sorts parts by group and merges each group's parts: the distinct keys,
// how many parts each had, and the sum of their values, by position.
pub fn merged_groups(take parts: List[GroupPart]) -> Result[(List[Bytes], List[u64], List[u64]), types.Failure] {
    let mut sorted = take parts
    list.sort_stable(mut sorted, by_group)
    let mut keys: List[Bytes] = list.new()
    let mut counts: List[u64] = list.new()
    let mut sums: List[u64] = list.new()
    let mut pending: Option[(Bytes, u64, u64)] = None
    for take GroupPart(key: take key, value: value) in take sorted {
        if let Some((take held, members, sum)) = take pending {
            if held == key {
                let Some(total) = int.checked_add(sum, value) else {
                    return Error(Limit(Value))
                }
                pending = Some((take held, members + 1, total))
                continue
            }
            list.push(mut keys, take held)
            list.push(mut counts, members)
            list.push(mut sums, sum)
        }
        pending = Some((take key, 1u64, value))
    }
    if let Some((take held, members, sum)) = take pending {
        list.push(mut keys, take held)
        list.push(mut counts, members)
        list.push(mut sums, sum)
    }
    Ok((take keys, take counts, take sums))
}

pub fn group_totals(raw: Bytes) -> Result[(u64, u64), types.Failure] {
    if list.len(raw) != 16 {
        return Error(pages.malformed(0))
    }
    Ok((format.read_le(raw, 0, 8), format.read_le(raw, 8, 8)))
}

pub fn totals_bytes(members: u64, sum: u64) -> Result[Bytes, types.Failure] {
    let mut raw: Bytes = list.with_capacity(16)
    types.capacity(format.le(mut raw, members, 8))?
    types.capacity(format.le(mut raw, sum, 8))?
    Ok(take raw)
}

// expect: accept
// expect: run fresh_push() = 711
// expect: run grew() = 711
// expect: run stored_input() = 7 trace 7
// expect: run grant_failure() = fail Capacity
// A drop has no grant, so grow raises out of a push there: the taken element is
// the caller's until a store consumes it, so the raise drops it exactly once.
// expect: run raised_push() = fail Capacity trace 7
// The pushed place is evaluated once.
// expect: run effectful_place() = 107
fn push[T](mut xs: List[T], take x: T) {
    list.push(mut xs, take x)
}

fn fresh_push() -> u64 {
    let mut xs: List[u64] = list.new()
    push(mut xs, 7u64)
    push(mut xs, 11u64)
    if list.len(xs) == 2 && list.capacity(xs) == 4 {
        xs[0] * 100 + xs[1]
    } else {
        0
    }
}

fn grew() -> u64 {
    let mut xs: List[u64] = list.with_capacity(1)
    push(mut xs, 7u64)
    push(mut xs, 11u64)
    if list.len(xs) == 2 && list.capacity(xs) == 4 {
        xs[0] * 100 + xs[1]
    } else {
        0
    }
}

resource type Mark {
    id: u64
} drop(m) {
    let _ = m.id
}

fn stored_input() -> u64 {
    let mut xs: List[Mark] = list.new()
    let x = result.unwrap(Mark(id: 7))
    list.push(mut xs, take x)
    xs[0].id
}

resource type Grow {
    xs: List[u64]
} drop(m) {
    let _ = list.reserve(mut m.xs, 2)
}

fn grant_failure() -> u64 {
    let xs: List[u64] = list.with_capacity(1)
    match Grow(xs: take xs) {
        Ok(_g) => 0u64,
        Error(_) => 999
    }
}

resource type Pusher {
    xs: List[Mark],
    x: Option[Mark]
} drop(p) {
    if let Some(x) = replace(mut p.x, None) {
        let _ = list.push(mut p.xs, take x)
    }
}

fn raised_push() -> u64 {
    let x = result.unwrap(Mark(id: 7))
    match Pusher(xs: list.new(), x: Some(take x)) {
        Ok(_p) => 0u64,
        Error(_) => 999
    }
}

fn bump(mut n: u64) -> u64 {
    n += 1
    0
}

fn effectful_place() -> u64 {
    let mut xs: List[List[u64]] = list.new()
    list.push(mut xs, list.new())
    let mut n: u64 = 0
    list.push(mut xs[bump(mut n)], 7)
    n * 100 + xs[0][0]
}

// Module `list`, extended (LANG-7): library members of the core module `list` (SEM-4). The
// core members (new, with_capacity, len, capacity, reserve, get, slice, push, pop, set,
// clear, fill, append, sum) are declared in core/core/list.hirsel; a call names both sets
// the same way, `list.push` and `list.sort`. `Bytes` is `List[u8]` (SEM-3), so every
// operation here applies to Bytes. Field legend, GROWTH and FREEZE: API.md, "Reading a
// contract".
//
// Representation (MEM-13, MEM-24, MEM-26): own; a 24-byte header inline in its owner; one
// block of capacity x size(T), rounded up to 8, charged to the limit current where the list
// was made. GROWTH: max(needed, 4, 2 x capacity), admitted before the old block is
// refunded. Removing never allocates or shrinks; storage is refunded when the list is
// cleaned.
/// A view of the first element, or None when empty: `list.get(xs, 0)`, returned under
/// OWN-20. View: anchored to xs; FREEZE xs. Cost: O(1).
/// Ex: `let Some(h) = list.first(lines) else { return Error(Empty) }`
pub fn first[T](xs: List[T]) -> Option[View[T]] in xs {
    list.get(xs, 0)
}

/// A view of the last element, or None when empty. View: anchored to xs; FREEZE xs.
/// Cost: O(1). Ex: `if let Some(top) = list.last(stack) { .. }`
pub fn last[T](xs: List[T]) -> Option[View[T]] in xs {
    let n = list.len(xs)
    if n == 0 {
        None
    } else {
        list.get(xs, n - 1)
    }
}

/// Removes and returns element i, shifting i+1.. down; order kept. Library code: a chain
/// of `list.set` from the end after a `list.pop`.
/// Fails: Bounds (failure) when i >= len. Alloc: nothing. Cost: O(len - i) moves.
/// Ex: `let oldest = list.remove(mut undo, 0)`
pub fn remove[T](mut xs: List[T], i: u64) -> T {
    check_index(xs, i)
    let mut x = option.unwrap(list.pop(mut xs))
    let mut j = list.len(xs)
    while j > i {
        j -= 1
        let y = list.set(mut xs, j, take x)
        x = y
    }
    x
}

/// Inserts x at i, shifting i.. up by one.
/// Fails: Bounds (failure) when i > len, checked before growth; Error((c, x)) when GROWTH
/// is refused, xs unchanged. Alloc: GROWTH. Cost: O(len - i) moves.
/// Ex: `list.insert(mut xs, 0, take s)?`
pub fn insert[T](mut xs: List[T], i: u64, take x: T) -> Result[(), (Capacity, T)] {
    let n = list.len(xs)
    if i != n {
        check_index(xs, i)
    }
    if let Error(c) = list.reserve(mut xs, 1) {
        return Error((c, take x))
    }
    let mut cur = x
    for j in i .. n {
        let y = list.set(mut xs, j, take cur)
        cur = y
    }
    push_reserved(mut xs, take cur)
    Ok(())
}

/// Removes and returns element i, moving the last element into its place; order not kept.
/// Fails: Bounds (failure) when i >= len. Alloc: nothing. Cost: O(1).
/// Ex: `let x = list.swap_remove(mut xs, i)`
pub fn swap_remove[T](mut xs: List[T], i: u64) -> T {
    check_index(xs, i)
    let tail = option.unwrap(list.pop(mut xs))
    if i == list.len(xs) {
        tail
    } else {
        list.set(mut xs, i, take tail)
    }
}

/// Exchanges elements i and j. Fails: Bounds (failure) when either is >= len.
/// Alloc: nothing (the pop and push it is built from stay within capacity). Cost: O(1).
/// Ex: `list.swap(mut xs, 0, list.len(xs) - 1)`
pub fn swap[T](mut xs: List[T], i: u64, j: u64) {
    check_index(xs, i)
    check_index(xs, j)
    if i == j {
        return
    }
    let a = order.min(i, j)
    let b = order.max(i, j)
    let tail = option.unwrap(list.pop(mut xs))
    if b == list.len(xs) {
        // tail is element b: put it at a and element a at the end.
        let old_a = list.set(mut xs, a, take tail)
        push_reserved(mut xs, take old_a)
    } else {
        let old_a = list.set(mut xs, a, take tail)
        let old_b = list.set(mut xs, b, take old_a)
        let back = list.set(mut xs, a, take old_b)
        push_reserved(mut xs, take back)
    }
}

/// Cleans elements n.. from the highest index down; no change when n >= len.
/// Alloc: nothing. Cost: O(len - n). Ex: `list.truncate(mut xs, 64)`
pub fn truncate[T](mut xs: List[T], n: u64) {
    while list.len(xs) > n {
        let _ = list.pop(mut xs)
    }
}

/// Reverses the elements in place. Alloc: nothing. Cost: O(len). Ex: `list.reverse(mut path)`
pub fn reverse[T](mut xs: List[T]) {
    let mut i: u64 = 0
    let mut j = list.len(xs)
    while i + 1 < j {
        j -= 1
        swap(mut xs, i, j)
        i += 1
    }
}

/// Sorts in place; `before(a, b)` returns Less when a goes first. Not stable.
/// Introsort: quicksort with a median-of-three pivot, insertion sort below 17 elements and
/// heapsort past 2 log2(len) partition levels (Rust's sort_unstable is pdqsort, which adds
/// pattern detection on top of the same three parts).
/// `before` is a `scoped fn` (OWN-21): it may view the caller's locals and does not wait;
/// it does not escape the call. If it is not a total order, xs still holds each element exactly once, in an unspecified
/// order. A failure inside `before` propagates with the same guarantee.
/// Alloc: nothing. Cost: O(len log len) worst case.
/// Ex: `list.sort(mut xs, fn(a: u64, b: u64) -> Order { std.order.compare(a, b) })`
pub fn sort[T](mut xs: List[T], before: scoped fn(T, T) -> Order) {
    let n = list.len(xs)
    let mut limit: u64 = 0
    let mut m = n
    while m > 1 {
        limit += 2
        m = m / 2
    }
    sort_range(mut xs, 0, n, limit, before)
}

/// Sum of the bytes of b in u64: the corpus checksum. `list.sum` sums in u8 and would fail
/// with Overflow; there is no generic widening sum (no numeric bound, OWN-4). Cannot
/// overflow below 2^56 bytes. Alloc: nothing. Cost: O(len).
/// Ex: `let s = list.sum_bytes(string.as_bytes(out))`
pub fn sum_bytes(b: Bytes) -> u64 {
    let n = list.len(b)
    if n < 72057594037927936 {
        let mut a: u64 = 0
        let mut c: u64 = 0
        let mut d: u64 = 0
        let mut e: u64 = 0
        let mut i: u64 = 0
        while n - i >= 4 {
            a = int.wrapping_add(a, int.widen(b[i]))
            c = int.wrapping_add(c, int.widen(b[i + 1]))
            d = int.wrapping_add(d, int.widen(b[i + 2]))
            e = int.wrapping_add(e, int.widen(b[i + 3]))
            i += 4
        }
        let mut total = int.wrapping_add(int.wrapping_add(a, c), int.wrapping_add(d, e))
        while i < n {
            total = int.wrapping_add(total, int.widen(b[i]))
            i += 1
        }
        total
    } else {
        let mut total: u64 = 0
        for x in b { total += int.widen(x) }
        total
    }
}

// Private helpers. Moving elements uses only `list.pop`, `list.set` and `list.push`:
// `list.set` returns the element it replaces, so no placeholder value is needed.
/// Fails with Bounds when i >= len, at the index.
fn check_index[T](xs: List[T], i: u64) {
    let _ = view xs[i]
}

/// Pushes into capacity a `list.reserve` or a `list.pop` already made spare, so the push
/// admits nothing and cannot be refused.
fn push_reserved[T](mut xs: List[T], take x: T) {
    match list.push(mut xs, take x) {
        Ok(()) => {},
        Error(_) => fail("list: a push into reserved capacity was refused"),
    }
}

fn less[T](xs: List[T], i: u64, j: u64, before: scoped fn(T, T) -> Order) -> bool {
    match before(xs[i], xs[j]) {
        Less => true,
        _ => false,
    }
}

/// Sorts xs[start..end]; recurses into the smaller part and loops on the larger, so the
/// depth is at most log2(len).
fn sort_range[T](mut xs: List[T], start: u64, end: u64, limit: u64, before: scoped fn(T, T) -> Order) {
    let mut a = start
    let mut b = end
    let mut depth = limit
    while b - a > 16 {
        if depth == 0 {
            heapsort(mut xs, a, b, before)
            return
        }
        depth -= 1
        let p = partition(mut xs, a, b, before)
        if p - a < b - p {
            sort_range(mut xs, a, p, depth, before)
            a = p + 1
        } else {
            sort_range(mut xs, p + 1, b, depth, before)
            b = p
        }
    }
    insertion_sort(mut xs, a, b, before)
}

/// Lomuto partition of xs[a..b] (b - a >= 3) around the median of its first, middle and
/// last elements; returns the pivot's final index.
fn partition[T](mut xs: List[T], a: u64, b: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let mid = a + (b - a) / 2
    let hi = b - 1
    if less(xs, mid, a, before) {
        swap(mut xs, mid, a)
    }
    if less(xs, hi, a, before) {
        swap(mut xs, hi, a)
    }
    if less(xs, mid, hi, before) {
        swap(mut xs, mid, hi)
    }
    let mut store = a
    for i in a .. hi {
        if less(xs, i, hi, before) {
            swap(mut xs, i, store)
            store += 1
        }
    }
    swap(mut xs, store, hi)
    store
}

fn insertion_sort[T](mut xs: List[T], a: u64, b: u64, before: scoped fn(T, T) -> Order) {
    if b - a < 2 {
        return
    }
    for i in (a + 1) .. b {
        let mut j = i
        while j > a && less(xs, j, j - 1, before) {
            swap(mut xs, j, j - 1)
            j -= 1
        }
    }
}

fn heapsort[T](mut xs: List[T], a: u64, b: u64, before: scoped fn(T, T) -> Order) {
    let n = b - a
    let mut i = n / 2
    while i > 0 {
        i -= 1
        sift_down(mut xs, a, i, n, before)
    }
    let mut end = n
    while end > 1 {
        end -= 1
        swap(mut xs, a, a + end)
        sift_down(mut xs, a, 0, end, before)
    }
}

/// Restores the max-heap below `root` in the heap xs[base..base + n].
fn sift_down[T](mut xs: List[T], base: u64, root: u64, n: u64, before: scoped fn(T, T) -> Order) {
    let mut r = root
    loop {
        let mut child = 2 * r + 1
        if child >= n {
            break
        }
        if child + 1 < n && less(xs, base + child, base + child + 1, before) {
            child += 1
        }
        if !less(xs, base + r, base + child, before) {
            break
        }
        swap(mut xs, base + r, base + child)
        r = child
    }
}

/// Whether x occurs, using structural equality. Alloc: nothing. Cost: O(len).
pub fn contains[T: key](xs: List[T], x: T) -> bool {
    for y in xs { if y == x { return true } }
    false
}

/// First equal index, or Error(insertion index), in an ascending sorted list.
/// Alloc: nothing. Cost: O(log len) comparisons. Ex: `list.binary_search(ids, id)`
pub fn binary_search[T: ordered](xs: List[T], x: T) -> Result[u64, u64] {
    let mut lo: u64 = 0
    let mut hi = list.len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] < x { lo = mid + 1 } else { hi = mid }
    }
    if lo < list.len(xs) && !(x < xs[lo]) { Ok(lo) } else { Error(lo) }
}

/// Keeps the first of each consecutive run of equal elements, preserving order.
/// Alloc: nothing. Cost: O(len) comparisons and moves; removed values are cleaned.
pub fn dedup[T: key](mut xs: List[T]) {
    let n = list.len(xs)
    if n < 2 { return }
    let mut write: u64 = 1
    let mut read: u64 = 1
    while read < n {
        if !(xs[read] == xs[write - 1]) {
            swap(mut xs, read, write)
            write += 1
        }
        read += 1
    }
    truncate(mut xs, write)
}

/// Appends copies of ys. Fails: Capacity leaves xs unchanged.
/// Alloc: one list GROWTH. Cost: O(len ys), plus growth copies.
pub fn extend[T: plain](mut xs: List[T], ys: List[T]) -> Result[(), Capacity] {
    list.append(mut xs, ys)
}

/// Stable ascending-by-comparator merge sort: equal elements retain their order.
/// Fails: Capacity leaves xs unchanged. A comparator failure leaves xs unchanged too.
/// Alloc: two u64 index lists, 16 bytes per element before GROWTH rounding.
/// Cost: O(n log n) comparisons and O(n) element swaps. The comparator is scoped
/// and never stored. Indirect sorting keeps every owned element in xs throughout.
pub fn sort_stable[T](mut xs: List[T], before: scoped fn(T, T) -> Order) -> Result[(), Capacity] {
    let n = list.len(xs)
    if n < 2 { return Ok(()) }
    let mut indices: List[u64] = list.with_capacity(n)?
    let mut scratch: List[u64] = list.with_capacity(n)?
    for i in 0u64 .. n {
        let _ = list.push(mut indices, i)
        let _ = list.push(mut scratch, 0)
    }
    let mut width: u64 = 1
    while width < n {
        let mut lo: u64 = 0
        while lo < n {
            let mid = lo + order.min(width, n - lo)
            let end = mid + order.min(width, n - mid)
            let mut a = lo
            let mut b = mid
            let mut out = lo
            while out < end {
                let right = if b == end { false } else if a == mid { true } else {
                    match before(xs[indices[b]], xs[indices[a]]) { Less => true, _ => false }
                }
                let selected = if right { let k = indices[b]; b += 1; k } else { let k = indices[a]; a += 1; k }
                let _ = list.set(mut scratch, out, selected)
                out += 1
            }
            lo = end
        }
        let old = replace(mut indices, take scratch)
        scratch = take old
        if width > n / 2 { break }
        width *= 2
    }
    // Convert output->input permutation to input->output in the spare index list.
    for i in 0u64 .. n { let _ = list.set(mut scratch, indices[i], i) }
    for i in 0u64 .. n {
        while scratch[i] != i {
            let to = scratch[i]
            swap(mut xs, i, to)
            swap(mut scratch, i, to)
        }
    }
    Ok(())
}

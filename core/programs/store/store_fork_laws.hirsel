fn range_boundary_points(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "boundary", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "boundary", std.codec.key_u64(), std.codec.of_u64()))
    let sh = view t
    // The review's one-row witness, before any node split can distract from it.
    let witness = result.unwrap(run(mut db, None, (copy_env(t), copy_env(sh)), fn(mut tx, call_env) -> Result[bool, Error] {
        put(mut tx, call_env.0, 32, 7)?
        let mut rows = range(tx, call_env.1, Included(32), Included(32))?
        Ok(next_in(tx, mut rows)? == Some((32u64, 7u64)) && next_in(tx, mut rows)? == None)
    }))
    match take witness {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    for k in 0u64 .. 96 {
        if !typed_put(mut db, t, k, k + 1) {
            return false
        }
    }
    let points: Inline[u64, 10] =[0, 15, 16, 31, 32, 33, 63, 64, 95, 96]
    for i in 0u64 .. 10 {
        let pivot = points[i]
        for a in 0u64 .. 3 {
            for b in 0u64 .. 3 {
                let lo: Bound[u64] = match a {
                    0 => Unbounded,
                    1 => Included(pivot),
                    _ => Excluded(pivot)
                }
                let hi: Bound[u64] = match b {
                    0 => Unbounded,
                    1 => Included(pivot + 1),
                    _ => Excluded(pivot + 1)
                }
                let outcome = result.unwrap(run(mut db, None, (copy_env(sh), copy_env(pivot), copy_env(a), copy_env(b), copy_env(lo), copy_env(hi)), fn(mut tx, call_env) -> Result[bool, Error] {
                    let mut rows = range(tx, call_env.0, call_env.4, call_env.5)?
                    for k in 0u64 .. 96 {
                        let lower = call_env.2 == 0 || (call_env.2 == 1 && k >= call_env.1) || (call_env.2 == 2 && k > call_env.1)
                        let upper = call_env.3 == 0 || (call_env.3 == 1 && k <= call_env.1 + 1) || (call_env.3 == 2 && k < call_env.1 + 1)
                        if lower && upper {
                            if next_in(tx, mut rows)? != Some((k, k + 1)) {
                                return Ok(false)
                            }
                        }
                    }
                    Ok(next_in(tx, mut rows)? == None)
                }))
                match take outcome {
                    Committed(done) => if !done.value {
                        return false
                    },
                    _ => return false
                }
            }
        }
    }
    let (_, second_table) = result.unwrap(law_pair(mut db, "boundary", std.codec.key_u64(), std.codec.of_u64(), "other_boundary", std.codec.key_u64(), std.codec.of_u64()))
    let second_shape = view second_table
    let second_witness = result.unwrap(run(mut db, None, (copy_env(second_table), copy_env(second_shape)), fn(mut tx, call_env) -> Result[bool, Error] {
        put(mut tx, call_env.0, 32, 17)?
        let mut rows = range(tx, call_env.1, Included(32), Included(32))?
        Ok(next_in(tx, mut rows)? == Some((32u64, 17u64)) && next_in(tx, mut rows)? == None)
    }))
    match take second_witness {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    true
}

fn stale_reads(tx: Tx, sh: Table[u64, u64], ix: Index[u64, u64, u64, ()], table_id: u32, index_id: u32) -> bool {
    let point = match fetch(tx, sh, 1) {
        Error(Stale(id)) => id == table_id,
        _ => false
    }
    let span = match range(tx, sh, Unbounded, Unbounded) {
        Error(Stale(id)) => id == table_id,
        _ => false
    }
    let index_read = match lookup(tx, ix, Unbounded, Unbounded) {
        Error(Stale(id)) => id == index_id,
        _ => false
    }
    point && span && index_read
}

// L16/I3: catalog liveness belongs to the roots read. Epoch changes alone do
// not invalidate readers; drop/recreate replaces the incarnation (ids1 ->4).
pub fn law_read_liveness(c: Clock, tasks: Tasks) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    let mut old = result.unwrap(table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    let old_shape: Table[u64, u64] = clone(old)
    if !typed_put(mut db, old, 1, 10) {
        return false
    }
    let mut d = result.unwrap(declare(db, Migrate))
    let mut declared = result.unwrap(declare_table(mut d, "live", std.codec.key_u64(), std.codec.of_u64()))
    let old_index = result.unwrap(index(mut d, mut declared, "bucket", Many, code.describe(bucket), std.codec.key_u64()))
    let _ = result.unwrap(index(mut d, mut declared, "other", Many, code.describe(quotient), std.codec.key_u64()))
    let _ = result.unwrap(finish(mut d, take declared))
    let _ = result.unwrap(seal(mut db, take d))
    let before = snapshot(db)
    if result.unwrap(get(result.unwrap(reader(db, 0u64)), before, old_shape, 1)) != Some(10u64) {
        return false
    }
    let mut old_matches = result.unwrap(find(result.unwrap(reader(db, 0u64)), before, old_index, Included(2), Included(2)))
    if result.unwrap(next(law_reader(old_matches.capture), mut old_matches)) != Some((1u64, 10u64)) {
        return false
    }
    result.unwrap(law_drop(mut db, tasks))
    match get(result.unwrap(reader(db, 0u64)), snapshot(db), old_shape, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    result.unwrap(law_table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    let (newer, fresh_index) = result.unwrap(law_indexed(mut db, "live", std.codec.key_u64(), std.codec.of_u64(), "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_shape = view newer
    if newer.id != 4 || fresh_index.id != 5 || !typed_put(mut db, newer, 1, 20) {
        return false
    }
    let current = snapshot(db)
    match get(result.unwrap(reader(db, 0u64)), current, old_shape, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match scan(result.unwrap(reader(db, 0u64)), current, old_shape, Unbounded, Unbounded) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match find(result.unwrap(reader(db, 0u64)), current, old_index, Unbounded, Unbounded) {
        Error(Stale(2)) => {},
        _ => return false
    }
    let observed = result.unwrap(run(mut db, None, (copy_env(old_shape), copy_env(old_index)), fn(mut tx, call_env) -> Result[bool, Error] {
        Ok(stale_reads(tx, call_env.0, call_env.1, 1, 2))
    }))
    match take observed {
        Committed(done) => if !done.value || list.len(done.reads) != 0 {
            return false
        },
        _ => return false
    }
    let query = result.unwrap(look(result.unwrap(reader(db, 0u64)), current, None, (copy_env(old_shape), copy_env(old_index)), fn(tx, call_env) -> bool {
        stale_reads(tx, call_env.0, call_env.1, 1, 2)
    }))
    match take query {
        Seen(done) => if !done.value || list.len(done.reads) != 0 {
            return false
        },
        _ => return false
    }
    if result.unwrap(get(result.unwrap(reader(db, 0u64)), before, old_shape, 1)) != Some(10u64) {
        return false
    }
    let mut old_rows = result.unwrap(scan(result.unwrap(reader(db, 0u64)), before, old_shape, Unbounded, Unbounded))
    if result.unwrap(next(law_reader(old_rows.capture), mut old_rows)) != Some((1u64, 10u64)) || result.unwrap(next(law_reader(old_rows.capture), mut old_rows)) != None {
        return false
    }
    match get(result.unwrap(reader(db, 0u64)), before, fresh_shape, 1) {
        Error(Stale(4)) => {},
        _ => return false
    }
    match scan(result.unwrap(reader(db, 0u64)), before, fresh_shape, Unbounded, Unbounded) {
        Error(Stale(4)) => {},
        _ => return false
    }
    match find(result.unwrap(reader(db, 0u64)), before, fresh_index, Unbounded, Unbounded) {
        Error(Stale(5)) => {},
        _ => return false
    }
    let old_query = result.unwrap(look(result.unwrap(reader(db, 0u64)), before, None, (copy_env(fresh_index), copy_env(fresh_shape)), fn(tx, call_env) -> bool {
        stale_reads(tx, call_env.1, call_env.0, 4, 5)
    }))
    match take old_query {
        Seen(done) => done.value && list.len(done.reads) == 0,
        _ => false
    }
}

// L27(a). The catalog row is 134 bytes, the collection descriptor is 126,
// and the current row is 94. The 448-byte ceiling has room for one extra row.
pub fn law_overwrite_account(c: Clock) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 448
    let mut db = memory_at(c, StoreId(hi: 1, lo: 2), options)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if db.resident != 260 {
        return false
    }
    for operation in 0u64 .. 100000 {
        if !typed_put(mut db, t, 1, operation + 1) || db.resident != 354 {
            return false
        }
    }
    result.unwrap(get(result.unwrap(reader(db, 0u64)), snapshot(db), t, 1)) == Some(100000u64)
}

// L30, AA1's trace by hand. Main is at v1 after its first declaration; b forks there
// (parent 0, forked_at 1). Main's A (k1 = 100) is main v2, b's B (k1 = 200)
// is b v2, and c forks from b at 2, so c's parent is b. adopt(c) is
// Diverged(c) and main still reads A at v2. A fork of main with no main
// commit since adopts as a fast-forward; one more main commit after a fork
// makes it Diverged; adopt(main) is Diverged(0). Branch ids are b 1, c 2,
// d 3, e 4, never reused. Wrong implementation caught: an adopt that
// compares versions only, which gives main B at v2.
pub fn law_branches(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = view t
    if version(snapshot(db)) != 1 {
        return false
    }
    let arg1 = snapshot(db)
    let (b, _) = result.unwrap(fork(mut db, "b", arg1))
    let arg2 = snapshot(db)
    match fork(mut db, "b", arg2) {
        Error(Exists(_)) => {},
        _ => return false
    }
    if !typed_put(mut db, t, 1, 100) {
        return false
    }
    let on_b = result.unwrap(run_on(mut db, b, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 1, 200)
    }))
    match take on_b {
        Committed(done) => if done.info.id.branch != 1 || done.info.id.version != 2 {
            return false
        },
        _ => return false
    }
    let at_b = result.unwrap(snapshot_of(db, b))
    if version(at_b) != 2 || result.unwrap(get(result.unwrap(reader(db, 0u64)), at_b, sh, 1)) != Some(200u64) {
        return false
    }
    let (cb, _) = result.unwrap(fork(mut db, "c", at_b))
    match adopt(mut db, cb) {
        Error(Diverged(id)) => if id != 2 {
            return false
        },
        _ => return false
    }
    if version(snapshot(db)) != 2 || result.unwrap(get(result.unwrap(reader(db, 0u64)), snapshot(db), sh, 1)) != Some(100u64) {
        return false
    }
    let arg3 = main_branch(db)
    match adopt(mut db, arg3) {
        Error(Diverged(id)) => if id != 0 {
            return false
        },
        _ => return false
    }
    // D5 per branch: b's handle sees b's commits and not main's.
    let h = result.unwrap(follow(mut db, b))
    if version(latest.read(h)) != 2 {
        return false
    }
    let on_b_again = result.unwrap(run_on(mut db, b, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 4, 500)
    }))
    match take on_b_again {
        Committed(_) => {},
        _ => return false
    }
    if version(latest.read(h)) != 3 || result.unwrap(get(law_reader(latest.read(h)), latest.read(h), sh, 4)) != Some(500u64) {
        return false
    }
    // (b) a fork of main with no main commit since its fork: a fast-forward.
    let arg4 = snapshot(db)
    let (dd, _) = result.unwrap(fork(mut db, "d", arg4))
    let on_d = result.unwrap(run_on(mut db, dd, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 2, 300)
    }))
    match take on_d {
        Committed(_) => {},
        _ => return false
    }
    let _ = result.unwrap(adopt(mut db, dd))
    let main_now = snapshot(db)
    if version(main_now) != 3 || result.unwrap(get(result.unwrap(reader(db, 0u64)), main_now, sh, 2)) != Some(300u64) || result.unwrap(get(result.unwrap(reader(db, 0u64)), main_now, sh, 1)) != Some(100u64) {
        return false
    }
    if let Some(_) = branch(db, "d") {
        return false
    }
    match snapshot_of(db, dd) {
        Error(Missing(_)) => {},
        _ => return false
    }
    match adopt(mut db, dd) {
        Error(Diverged(id)) => if id != 3 {
            return false
        },
        _ => return false
    }
    // (d) one more main commit after the fork.
    let arg5 = snapshot(db)
    let (e, _) = result.unwrap(fork(mut db, "e", arg5))
    if e.id != 4 || !typed_put(mut db, t, 3, 400) {
        return false
    }
    match adopt(mut db, e) {
        Error(Diverged(id)) => if id != 4 {
            return false
        },
        _ => return false
    }
    let _ = result.unwrap(delete_branch(mut db, e))
    match snapshot_of(db, e) {
        Error(Missing(_)) => {},
        _ => return false
    }
    let arg6 = main_branch(db)
    match delete_branch(mut db, arg6) {
        Error(Missing(_)) => {},
        _ => return false
    }
    // A pin reads its version after later commits; unpin forgets it.
    let arg7 = snapshot(db)
    let _ = result.unwrap(pin(mut db, "p", arg7))
    let arg8 = snapshot(db)
    match pin(mut db, "p", arg8) {
        Error(Exists(_)) => {},
        _ => return false
    }
    if !typed_put(mut db, t, 3, 401) {
        return false
    }
    match pinned(db, "p") {
        Some(s) => if version(s) != 4 || result.unwrap(get(law_reader(s), s, sh, 3)) != Some(400u64) {
            return false
        },
        None => return false
    }
    let _ = result.unwrap(unpin(mut db, "p"))
    if let Some(_) = pinned(db, "p") {
        return false
    }
    match unpin(mut db, "p") {
        Error(Missing(_)) => {},
        _ => return false
    }
    // L20: a Snapshot of another store or of another open is Foreign.
    let other = memory_at(c, StoreId(hi: 3, lo: 4), result.unwrap(sized(Memory, 1074790400u64)))
    match fork(mut db, "x", snapshot(other)) {
        Error(Foreign) => {},
        _ => return false
    }
    let mut stale = snapshot(db)
    stale.open = 9
    match pin(mut db, "x", stale) {
        Error(Foreign) => {},
        _ => return false
    }
    match branch(db, "b") {
        Some(found) => found.id == 1 && version(snapshot(db)) == 5,
        None => false
    }
}

// L27(b). The descriptor and catalog charge 260 and each row version 94.
// A conservative overwrite reaches 542. The next overwrite settles the
// proposed union to 448, for the pinned and proposed versions.
pub fn law_pin_settle(c: Clock) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 542
    let mut db = memory_at(c, StoreId(hi: 1, lo: 2), options)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, t, 1, 1) || db.resident != 354 {
        return false
    }
    let arg9 = snapshot(db)
    let _ = result.unwrap(pin(mut db, "p", arg9))
    if db.resident != 354 {
        return false
    }
    for operation in 0u64 .. 100 {
        if !typed_put(mut db, t, 1, operation + 2) {
            return false
        }
        if db.resident != (if operation % 2 == 0 {
            448u64
        } else {
            542u64
        }) {
            return false
        }
    }
    let _ = result.unwrap(checkpoint(mut db))
    if db.resident != 448 {
        return false
    }
    let _ = result.unwrap(unpin(mut db, "p"))
    if db.resident != 354 || !typed_put(mut db, t, 1, 7) || db.resident != 354 {
        return false
    }
    result.unwrap(get(result.unwrap(reader(db, 0u64)), snapshot(db), t, 1)) == Some(7u64)
}

// AP15. The catalog and descriptor cost 260 and one row version costs 94.
// Rewriting or restoring the pinned value keeps the union at 354. Adding a
// second key costs 448 in total, even if the draft also rewrites the first.
fn pinned_draft_at_bound(mut db: Db) -> Result[(), Error] waits {
    law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !typed_put(mut db, rows, 1, 1) {
        return Error(Foreign)
    }
    let base = snapshot(db)
    let _ = pin(mut db, "p", base)?
    if accounts(db).logical != 354 || !accounts(db).exact {
        return Error(Foreign)
    }
    if !typed_put(mut db, rows, 1, 1) {
        return Error(Foreign)
    }
    if accounts(db).logical != 354 || !accounts(db).exact {
        return Error(Foreign)
    }
    let deleted = run(mut db, None, rows, fn(mut tx, call_env) -> Result[bool, Error] {
        delete(mut tx, call_env, 1)
    })?
    if let Committed(Done(value: true, ..)) = deleted {} else {
        return Error(Foreign)
    }
    if accounts(db).logical != 354 || accounts(db).exact {
        return Error(Foreign)
    }
    let cut = db.checkpointed
    let restored = run(mut db, None, rows, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 1, 1)
    })?
    let Committed(done) = restored else {
        return Error(Foreign)
    }
    if db.checkpointed != cut + 1 {
        return Error(Foreign)
    }
    durable(mut db, done.ticket)?
    let journal = accounts(db).journal
    let refused = run(mut db, None, rows, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 1, 1)?
        put(mut tx, call_env, 2, 2)
    })?
    let Refused(Resident(cap)) = refused else {
        return Error(Foreign)
    }
    let head = snapshot(db)
    if cap.requested != 448 || cap.available != 354 || accounts(db).journal != journal || accounts(db).logical != 354 || !accounts(db).exact || version(head) != 5 || get(result.unwrap(reader(db, 0u64)), head, rows, 1)? != Some(1u64) || get(result.unwrap(reader(db, 0u64)), head, rows, 2)? != None {
        return Error(Foreign)
    }
    Ok(())
}

@test
fn test_pinned_draft_at_bound(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 354
    options.pack_bytes = 512
    let mut mem = memory(c, r, options)
    pinned_draft_at_bound(mut mem)?
    close(take mem)?
    let child = disk_test_directory(d)
    let mut db = open(tasks, child, c, r, options)?
    pinned_draft_at_bound(mut db)?
    close(take db)?
    let mut reopened = open(tasks, child, c, r, options)?
    let rows = table(mut reopened, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let head = snapshot(reopened)
    if accounts(reopened).logical != 354 || !accounts(reopened).exact || version(head) != 5 || get(result.unwrap(reader(reopened, 0u64)), head, rows, 1)? != Some(1u64) || get(result.unwrap(reader(reopened, 0u64)), head, rows, 2)? != None {
        return Error(Foreign)
    }
    close(take reopened)
}

// L27(c)(i) and L51(h). A live-head fork shares the 354-byte account.
pub fn law_fork_shared_head(c: Clock) -> bool waits {
    let mut db = test_db(c, 500)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, t, 1, 1) || db.resident != 354 {
        return false
    }
    let from = snapshot(db)
    let cut = db.checkpointed
    let before = db.changes
    match fork(mut db, "fork", from) {
        Ok((b, receipt)) => {
            result.unwrap(durable(mut db, receipt))
            db.resident == 354 && db.checkpointed == cut && journal_mark(receipt) == before + 1 && accounts(db).exact && option.unwrap(branch(db, "fork")).id == b.id && result.unwrap(get(result.unwrap(reader(db, 0u64)), result.unwrap(snapshot_of(db, b)), t, 1)) == Some(1u64)
        },
        _ => false,
    }
}

fn fork_tip_round(mut db: Db, from: Snapshot, rows: Table[u64, u64]) -> Result[bool, Error] waits {
    let (child, _) = fork(mut db, "measured", from)?
    let before = accounts(db).logical
    let written = run_on(mut db, child, None, rows, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 1, 2)
    })?
    let Committed(_) = written else {
        return Ok(false)
    }
    let tip = snapshot_of(db, child)?
    Ok(get(result.unwrap(reader(db, 0u64)), tip, rows, 1)? == Some(2u64) && get(law_reader(from), from, rows, 1)? == Some(1u64) && accounts(db).logical == before + 94)
}

fn fork_tip_fits(c: Clock, depth: u64, steps: u64) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let rows = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, rows, 1, 1) {
        fail("fork depth: fixture write")
    }
    // Give both runs the same live branch set and tree. Only the fork source
    // changes. The new branch uses the same id, slot and name in each run.
    let mut source = main_branch(db)
    let mut tip = source
    for id in 1u64 .. 33 {
        let from = result.unwrap(snapshot_of(db, tip))
        let name = result.unwrap(disk_path("depth-", id, ""))
        let (child, _) = result.unwrap(fork(mut db, name, from))
        tip = child
        if id == depth {
            source = child
        }
    }
    let from = result.unwrap(snapshot_of(db, source))
    let owned = take db
    let measured = bound steps steps {
        let mut active = take owned
        fork_tip_round(mut active, from, rows)
    }
    match take measured {
        Error(_) => false,
        Ok(Ok(true)) => true,
        _ => fail("fork depth: fork, write or read failed"),
    }
}

fn fork_tip_steps(c: Clock, depth: u64) -> u64 waits {
    let mut low = 0u64
    let mut high = 65536u64
    if !fork_tip_fits(c, depth, high) {
        fail("fork depth: no successful probe")
    }
    while low < high {
        let mid = low + (high - low) / 2
        if fork_tip_fits(c, depth, mid) {
            high = mid
        } else {
            low = mid + 1
        }
    }
    low
}

// STORE-SPEC §11.13 AP18: a live-head fork does no ancestry walk. With
// identical roots and no cut, the fork, put and get may differ by at most
// 16 metered steps for the variation in the binary search for the source.
@test
fn test_fork_depth(c: Clock) -> Result[(), (u64, u64)] waits {
    let shallow = fork_tip_steps(c, 1)
    let deep = fork_tip_steps(c, 32)
    if deep <= shallow + 16 && shallow <= deep + 16 {
        Ok(())
    } else {
        Error((shallow, deep))
    }
}

// L27(c). Adding the reader's older version would cost 448 bytes,
// one more than the available 447. The refused cut consumes its branch id.
pub fn law_fork_old_snapshot(c: Clock) -> bool waits {
    let mut db = test_db(c, 447)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, t, 1, 1) {
        return false
    }
    let held = snapshot(db)
    if !typed_put(mut db, t, 1, 2) || db.resident != 354 {
        return false
    }
    let cut = db.checkpointed
    let next_id = db.next_branch
    match fork(mut db, "fork", held) {
        Error(Full(Resident(cap))) => if cap.requested != 448 || cap.available != 447 {
            return false
        },
        _ => return false,
    }
    let head = snapshot(db)
    if let Some(_) = branch(db, "fork") {
        return false
    }
    db.checkpointed == cut && db.next_branch == next_id + 1 && db.resident == 354 && version(head) == 3 && result.unwrap(get(result.unwrap(reader(db, 0u64)), head, t, 1)) == Some(2u64) && result.unwrap(get(result.unwrap(reader(db, 0u64)), held, t, 1)) == Some(1u64)
}

// L27(c). A pin of the empty table keeps the descriptor and catalog once.
// Four writes charge 636 bytes. The live-head fork preserves that exact
// conservative bound and its unsettled status.
pub fn law_fork_settle(c: Clock) -> bool waits {
    let mut db = test_db(c, 636)
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let empty = snapshot(db)
    result.unwrap(pin(mut db, "empty", empty))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    for v in 1u64 .. 5 {
        if !typed_put(mut db, t, 1, v) {
            return false
        }
    }
    if db.resident != 636 {
        return false
    }
    let from = snapshot(db)
    let settled = db.settled
    let cut = db.checkpointed
    match fork(mut db, "fork", from) {
        Ok((b, _)) => db.resident == 636 && !accounts(db).exact && db.settled == settled && db.checkpointed == cut && result.unwrap(get(result.unwrap(reader(db, 0u64)), result.unwrap(snapshot_of(db, b)), t, 1)) == Some(4u64) && result.unwrap(get(result.unwrap(reader(db, 0u64)), option.unwrap(pinned(db, "empty")), t, 1)) == None,
        _ => false,
    }
}


// Module store_tool: `libexec/hirsel/store_tool`, the installed body of `hirsel store backup`
// and `hirsel store restore` (STORE-SPEC §15.4). The driver opens both directories, makes
// the target if it is absent, and passes them as fds 3 and 4; the grants name them as
// /proc/self/fd/3 and /proc/self/fd/4.
//
// argv: `backup` (fd 3 the store, fd 4 the empty target) or `restore` (fd 3 the backup,
// fd 4 the empty new store directory). It prints `backup <store id> head <H>` or
// `restored <store id> head <H>`. Exit 0 done, 1 refused (details on stderr), 2 usage,
// 75 the store is held by a writer.
//
// `inspect` and `stats` (§15.6) capture fd 3, beside a live
// writer; `verify` scrubs fd 3, a cloned image the driver made, and exits 1 on a
// fault. Each ignores fd 4, which the driver points at fd 3.
fn id_hex(hi: u64, lo: u64) -> String {
    let mut raw: Bytes = list.with_capacity(16)
    for word in[hi, lo] {
        for i in 0u64 .. 8 {
            list.push(mut raw, int.truncate(word >> (56u64 - i * 8u64)))
        }
    }
    std.hex.encode(raw)
}

fn push_capacity_case(mut line: String, name: String, capacity: Capacity) {
    string.push(mut line, name)
    string.push(mut line, "(requested: ")
    string.push_u64(mut line, capacity.requested)
    string.push(mut line, ", available: ")
    string.push_u64(mut line, capacity.available)
    string.push(mut line, ")")
}

fn full_refusal(cause: store.StoreCapacity) -> String {
    let mut line = string.from("Full(")
    match cause {
        Journal(c) => push_capacity_case(mut line, "Journal", c),
        Resident(c) => push_capacity_case(mut line, "Resident", c),
        Allocation(c) => push_capacity_case(mut line, "Allocation", c),
        Cache(c) => push_capacity_case(mut line, "Cache", c),
        Slots(c) => push_capacity_case(mut line, "Slots", c),
        Pins(c) => push_capacity_case(mut line, "Pins", c),
        Register(c) => push_capacity_case(mut line, "Register", c),
    }
    string.push(mut line, ")")
    take line
}

fn store_refusal(e: store.Error) -> String {
    match e {
        Held => "Held",
        NotFound => "NotFound",
        Corrupt(_) => "Corrupt",
        Unsupported(_) => "Unsupported",
        Io(_) => "Io",
        Full(cause) => full_refusal(cause),
        Exists(_) => "Exists",
        ExportDirectory => "ExportDirectory",
        Tiered(_) => "Tiered",
        _ => "Refused",
    }
}

fn deploy_refusal(e: store.DeployError) -> String {
    match e {
        Store(inner) => store_refusal(inner),
        Scratch(inner) => store_refusal(inner),
        ExportMismatch => "ExportMismatch",
        AttemptBusy => "AttemptBusy",
        _ => "Refused",
    }
}

fn refused(err: Stderr, name: String) -> Result[(), Exit] waits {
    let mut line = string.from("hirsel store: refused: ")
    string.push(mut line, name)
    string.push(mut line, "\n")
    let _ = stderr.write(err, line)
    Error(Exit(status: 1u8))
}

fn finished(out: Stdout, verb: String, stamp: store.ExportStamp) -> Result[(), Exit] waits {
    let mut line = string.from(verb)
    string.push(mut line, " ")
    string.push(mut line, id_hex(stamp.store_hi, stamp.store_lo))
    string.push(mut line, " head ")
    string.push_u64(mut line, stamp.head)
    string.push(mut line, "\n")
    match stdout.write(out, line) {
        Ok(_) => Ok(()),
        Error(_) => Error(Exit(status: 1u8)),
    }
}

fn backup(from: Dir, to: Dir, c: Clock, r: Random, tasks: Tasks, take options: store.Options, out: Stdout, err: Stderr) -> Result[(), Exit] waits {
    // §15.4: a backup never creates the store it names.
    options.create = false
    let mut db = match store.open(tasks, from, c, r, options) {
        Ok(take opened) => take opened,
        Error(Held) => {
            let _ = stderr.write(err, "hirsel store: the store is held by a writer\n")
            return Error(Exit(status: 75u8))
        },
        Error(e) => return refused(err, store_refusal(e)),
    }
    let mut attempt: Bytes = list.with_capacity(16)
    host.random(r, mut attempt)
    let mut kept: Bytes = list.with_capacity(16)
    list.append(mut kept, attempt)
    let copied = match store.begin_backup(mut db, to, take attempt) {
        Ok(take job) => store.export_copy(take job),
        Error(e) => {
            let _ = store.close(take db)
            return refused(err, deploy_refusal(e))
        },
    }
    store.release_export(mut db, kept)
    let closed = store.close(take db)
    let exported = match copied {
        Ok(take done) => take done,
        Error(e) => return refused(err, deploy_refusal(e)),
    }
    if let Error(e) = closed {
        return refused(err, store_refusal(e))
    }
    finished(out, "backup", exported.stamp)
}

fn say(out: Stdout, line: String) -> Result[(), Exit] waits {
    match stdout.write(out, line) {
        Ok(_) => Ok(()),
        Error(_) => Error(Exit(status: 1u8)),
    }
}

fn form_text(form: store.EntryForm) -> String {
    match form {
        TableForm => "table",
        IndexForm(Many) => "index Many",
        IndexForm(Unique) => "index Unique",
        AggregateForm => "aggregate",
        CellForm => "cell",
        LogForm => "log",
    }
}

fn state_text(state: u8) -> String {
    match state {
        0 => "Public",
        3 => "Failed",
        _ => "Backfilling",
    }
}

fn describe_entry(entry: store.DescribeEntry, stats: bool) -> String {
    let mut text = string.from(form_text(entry.form))
    string.push(mut text, " ")
    if entry.table != entry.name {
        string.push(mut text, entry.table)
        string.push(mut text, ".")
    }
    string.push(mut text, entry.name)
    let derived = match entry.form {
        IndexForm(_) => true,
        AggregateForm => true,
        _ => false,
    }
    if derived {
        string.push(mut text, " ")
        string.push(mut text, state_text(entry.state))
        if list.len(entry.revision) != 0 {
            string.push(mut text, " revision ")
            string.push(mut text, std.hex.encode(entry.revision))
        }
    }
    string.push(mut text, ": ")
    string.push_u64(mut text, entry.rows)
    string.push(mut text, " rows")
    if stats {
        string.push(mut text, ", ")
        string.push_u64(mut text, entry.charge)
        string.push(mut text, " bytes")
    }
    take text
}

fn describe_fact(fact: store.DescribeLine, stats: bool, out: Stdout, err: Stderr) -> Result[(), store.Error] waits {
    let rendered = match fact {
        DescribeHead(id, head) => {
            let mut text = string.from("store ")
            string.push(mut text, id_hex(id.hi, id.lo))
            string.push(mut text, " head ")
            string.push_u64(mut text, head)
            take text
        },
        DescribeCollection(entry) => describe_entry(entry, stats),
        DescribeOpenPacks(held) => {
            let mut text = string.from("hirsel store: ")
            string.push_u64(mut text, held)
            string.push(mut text, " open packs\n")
            let _ = stderr.write(err, text)
            return Ok(())
        },
        _ if !stats => return Ok(()),
        DescribeAccount(generation, amount) => {
            let mut text = string.from("account at cut ")
            string.push_u64(mut text, generation)
            string.push(mut text, ": ")
            string.push_u64(mut text, amount)
            take text
        },
        DescribeJournal(summary) => {
            let mut text = string.from("journal: ")
            string.push_u64(mut text, summary.segments)
            string.push(mut text, " segments, ")
            string.push_u64(mut text, summary.journal_bytes)
            string.push(mut text, " bytes, ")
            string.push_u64(mut text, summary.frames)
            string.push(mut text, " frames")
            take text
        },
        DescribePin(owner, name, branch_id, version) => {
            let mut text = string.from("pin ")
            string.push(mut text, match owner {
                1 => "application ",
                2 => "projector ",
                _ => "import ",
            })
            string.push(mut text, name)
            string.push(mut text, " branch ")
            string.push_u64(mut text, int.widen(branch_id))
            string.push(mut text, " version ")
            string.push_u64(mut text, version)
            take text
        },
        DescribePack(seq, class, frames, live, amount) => {
            let mut text = string.from("p-")
            string.push_u64(mut text, seq)
            string.push(mut text, " class ")
            string.push_u64(mut text, int.widen(class))
            string.push(mut text, " frames ")
            string.push_u64(mut text, int.widen(frames))
            string.push(mut text, " live ")
            string.push_u64(mut text, live)
            string.push(mut text, " bytes ")
            string.push_u64(mut text, amount)
            take text
        },
    }
    let mut text = take rendered
    string.push(mut text, "\n")
    match stdout.write(out, text) {
        Ok(_) => Ok(()),
        Error(_) => Error(Io(Closed)),
    }
}

fn describe_shortage(err: Stderr, verb: String, c: Capacity, parts: List[store.Part]) -> Result[(), Exit] waits {
    let mut text = string.from("hirsel store: refused: ")
    string.push(mut text, full_refusal(Allocation(c)))
    string.push(mut text, ": ")
    string.push(mut text, verb)
    string.push(mut text, " needs these parts\n")
    let _ = stderr.write(err, text)
    for part in parts {
        let mut detail = string.from("  ")
        string.push(mut detail, part.name)
        string.push(mut detail, " ")
        string.push_u64(mut detail, part.amount)
        string.push(mut detail, "\n")
        let _ = stderr.write(err, detail)
    }
    let _ = stderr.write(err, "hirsel store: no store_tool route reads a catalog this large\n")
    Error(Exit(status: 1u8))
}

fn describe(d: Dir, c: Clock, verb: String, out: Stdout, err: Stderr) -> Result[(), Exit] waits {
    let stats = verb == "stats"
    loop {
        let prepared = match store.prepare(d, c, Describe) {
            Ok(take selected) => take selected,
            Error(Full(Allocation(cause))) => {
                let mut parts: List[store.Part] = list.with_capacity(1)
                list.push(mut parts, store.Part(name: "bootstrap", amount: cause.requested))
                return describe_shortage(err, verb, cause, parts)
            },
            Error(Io(Other(24))) => return refused(err, "Io(Other(24)): EMFILE, 0 open packs"),
            Error(e) => return refused(err, store_refusal(e)),
        }
        let budget = store.capture_need(prepared)
        let result = bound bytes budget.total {
            store.describe_capture(take prepared, scoped fn(fact: store.DescribeLine) -> Result[(), store.Error] waits {
                describe_fact(fact, stats, out, err)
            })
        }
        match take result {
            Error(cause) => return describe_shortage(err, verb, cause, budget.parts),
            Ok(Error(Changed(file))) if file == "MANIFEST" => continue,
            Ok(Error(Io(Other(24)))) => return refused(err, "Io(Other(24)): EMFILE"),
            Ok(Error(e)) => return refused(err, store_refusal(e)),
            Ok(Ok(_)) => {
                let mut text = string.from("hirsel store ")
                string.push(mut text, verb)
                string.push(mut text, " needs ")
                string.push_u64(mut text, budget.total)
                string.push(mut text, " bytes\n")
                let _ = stderr.write(err, text)
                return Ok(())
            },
        }
    }
}

// `verify` without a release: one full scrub tour over the image, every
// page's checksum and structure. Each fault is printed; any fault exits 1.
fn scrub_image(d: Dir, c: Clock, r: Random, tasks: Tasks, take options: store.Options, out: Stdout, err: Stderr) -> Result[(), Exit] waits {
    options.create = false
    let mut db = match store.open(tasks, d, c, r, options) {
        Ok(take opened) => take opened,
        Error(e) => return refused(err, store_refusal(e)),
    }
    let mut tour = match store.begin_scrub(mut db) {
        Ok(take t) => take t,
        Error(e) => return refused(err, store_refusal(e)),
    }
    let mut text = string.new()
    let mut faults = 0u64
    let mut checked = 0u64
    loop {
        let report = match store.scrub_step(mut tour, 16777216u64) {
            Ok(take seen) => take seen,
            Error(e) => return refused(err, store_refusal(e)),
        }
        checked = report.checked
        for fault in report.faults {
            faults += 1u64
            string.push(mut text, "scrub fault ")
            string.push(mut text, fault.file)
            string.push(mut text, " at ")
            string.push_u64(mut text, fault.offset)
            string.push(mut text, "\n")
        }
        if let None = report.next {
            break
        }
    }
    let _ = store.close(take db)
    string.push(mut text, "verify: scrubbed ")
    string.push_u64(mut text, checked)
    string.push(mut text, " bytes, ")
    string.push_u64(mut text, faults)
    string.push(mut text, " faults\n")
    say(out, text)?
    if faults != 0 {
        return Error(Exit(status: 1u8))
    }
    Ok(())
}

pub fn main(from: Dir, to: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout, err: Stderr, argv: Args) -> Result[(), Exit] waits {
    let options = match store.sized(Directory, 2147483648u64) {
        Ok(take sized) => take sized,
        Error(_) => return refused(err, "Full"),
    }
    let Some(verb) = args.get(argv, 0u64) else {
        return Error(Exit(status: 2u8))
    }
    if verb == "backup" {
        return backup(from, to, c, r, tasks, take options, out, err)
    }
    if verb == "inspect" || verb == "stats" {
        return describe(from, c, verb, out, err)
    }
    if verb == "verify" {
        return scrub_image(from, c, r, tasks, take options, out, err)
    }
    if verb != "restore" {
        return Error(Exit(status: 2u8))
    }
    match store.restore(from, to, c, options) {
        Ok(take stamp) => finished(out, "restored", stamp),
        Error(e) => refused(err, deploy_refusal(e)),
    }
}

// rule: STORE-2
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"},"small":{"provider":"authority.memory@1","floor":"memory"},"edge":{"provider":"authority.memory@1","floor":"memory"}}
// store.transact runs a transaction entry: it commits the entry's writes as
// one commit when it returns Ok, discards them and returns Aborted when it
// returns Error, refuses a commit over a limit with no effect, and ends a run
// that fails as Faulted with nothing committed and the store still usable; a
// reopened store holds exactly the committed transactions.
// store.query runs its entry on its snapshot, not the latest commit.
// Limits no group could frame within the authority's 64 MiB entries are
// refused at open, and a commit encoding past transaction_bytes is refused
// definitely and leaves the store open.
@serializable
type Short = TooFew(u64) | Db(store.TxError)

fn count(tx: store.Tx) -> Result[u64, Short] {
  match store.tx_get(tx, b"count") {
    Ok(Some(b)) => Ok(int.widen(b[0])),
    Ok(None()) => Ok(0),
    Error(e) => Error(Db(unique e)),
  }
}

fn set_count(mut tx: store.Tx, n: u64) -> Result[(), Short] {
  let mut v: List[u8] = []
  list.push(mut v, int.truncate(n))
  store.tx_put(mut tx, b"count", bytes.from_list(take v)) ? Db
  Ok(())
}

fn first(mut tx: store.Tx, call: store.CallInfo, n: u64) -> Result[u64, Short] {
  set_count(mut tx, n)?
  store.tx_put(mut tx, b"name", b"ada") ? Db
  Ok(count(tx)?)
}

// An abort leaves nothing behind, though the body wrote and read its write.
fn short(mut tx: store.Tx, call: store.CallInfo, n: u64) -> Result[u64, Short] {
  set_count(mut tx, n)?
  store.tx_delete(mut tx, b"name") ? Db
  let seen = count(tx)?
  if seen < 10 {
    return Error(TooFew(seen))
  }
  Ok(0)
}

// A value over the configured limit refuses the whole commit.
fn big(mut tx: store.Tx, call: store.CallInfo, n: u64) -> Result[(), Short] {
  set_count(mut tx, n)?
  store.tx_put(mut tx, b"big", b"too long") ? Db
  Ok(())
}

// A run that fails after writing: its writes are discarded with it.
fn overflows(mut tx: store.Tx, call: store.CallInfo, n: u8) -> Result[(), Short] {
  set_count(mut tx, 7)?
  let broken = n + 255
  Ok(())
}

// Reads the count.
fn peek(tx: store.Tx, call: store.CallInfo, n: u64) -> Result[u64, Short] {
  count(tx)
}

@serializable
type Pair {
  key: Bytes,
  value: Bytes,
}

fn puts(mut tx: store.Tx, info: store.CallInfo, p: Pair) -> Result[(), store.TxError] {
  store.tx_put(mut tx, unique p.key, unique p.value)
}

fn filled(n: u64) -> Bytes {
  let mut v: List[u8] = []
  for _ in 0u64..n {
    list.push(mut v, 97)
  }
  bytes.from_list(take v)
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let at = authority.floor(a)
  let mut config = store.default_config()
  config.limits.value_bytes = 4
  let mut s = store.open(a, config) ? Store
  let empty = store.snapshot(a, mut s, at) ? Store
  let one: Result[u64, store.TxFailure[Short]] = store.transact(mut s, first, 5u64)
  check(one == Ok(5))?
  let after_one = store.snapshot(a, mut s, at) ? Store
  let two: Result[u64, store.TxFailure[Short]] = store.transact(mut s, short, 9u64)
  check(two == Error(Aborted(TooFew(9))))?
  let three: Result[(), store.TxFailure[Short]] = store.transact(mut s, big, 1u64)
  check(three == Error(Limit(ValueBytes())))?
  let four: Result[(), store.TxFailure[Short]] = store.transact(mut s, overflows, 1u8)
  let faulted = match four {
    Error(Faulted(f)) => f.rule == "SEM-1",
    _ => false,
  }
  check(faulted)?
  // Neither the abort, the limit nor the fault committed anything.
  let settled = store.snapshot(a, mut s, at) ? Store
  check(store.version(a, settled) == store.version(a, after_one))?
  // The store is usable after the fault.
  let five: Result[u64, store.TxFailure[Short]] = store.transact(mut s, first, 5u64)
  check(five == Ok(5))?
  let snap = store.snapshot(a, mut s, at) ? Store
  check(
    store.get(snap, b"count") == Some(b"\x05") && store.get(snap, b"name") == Some(
      b"ada"
    ) && store.get(snap, b"big") == None()
  )?
  check(store.version(a, after_one) < store.version(a, snap))?
  check(store.query(copy snap, peek, 0u64) == Ok(5))?
  check(store.query(take empty, peek, 0u64) == Ok(0))?
  store.close(take s) ? Store
  sizes(rt)?
  let mut again = store.open(a, store.default_config()) ? Store
  let reopened = store.snapshot(a, mut again, at) ? Store
  check(
    store.get(reopened, b"count") == Some(b"\x05") && store.get(reopened, b"name") == Some(
      b"ada"
    )
  )?
  Ok(())
}

// The group overhead is 8192 bytes, so transaction_bytes of 64 MiB less 8191
// needs 64 MiB and one byte and is refused before any claim. transaction_bytes
// bounds the encoded commit, its call record and outcome included: a store whose
// limit is exactly that size commits it, and one whose limit is a byte less
// refuses it with no effect, as it refuses a far larger one.
fn sizes(rt: Io) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "small") else {
    return Error(Check())
  }
  let mut config = store.default_config()
  config.limits.transaction_bytes = 67100673
  let over = match store.open(a, config) {
    Error(Unsupported(Size(needed: 67108865, max_entry: 67108864))) => true,
    _ => false,
  }
  check(over)?
  let fits = Pair(key: b"big", value: filled(20))
  let exact = encoded_size(fits)
  config.limits.transaction_bytes = exact
  let mut s = store.open(a, config) ? Store
  let oversized: Result[(), store.TxFailure[store.TxError]] = store.transact(
    mut s,
    puts,
    Pair(key: b"big", value: filled(200))
  )
  check(oversized == Error(Limit(TransactionBytes())))?
  let small: Result[(), store.TxFailure[store.TxError]] = store.transact(
    mut s,
    puts,
    copy fits
  )
  check(small == Ok(()))?
  let snap = store.snapshot(a, mut s, authority.floor(a)) ? Store
  check(store.get(snap, b"big") == Some(filled(20)))?
  store.close(take s) ? Store
  let Ok(e) = io.authority(rt, "edge") else {
    return Error(Check())
  }
  config.limits.transaction_bytes = exact - 1
  let mut t = store.open(e, config) ? Store
  let past: Result[(), store.TxFailure[store.TxError]] = store.transact(
    mut t,
    puts,
    take fits
  )
  check(past == Error(Limit(TransactionBytes())))?
  let none = store.snapshot(e, mut t, authority.floor(e)) ? Store
  check(store.get(none, b"big") == None())?
  store.close(take t) ? Store
  Ok(())
}

// The size of a local `puts` commit of `p` laid out by the History format
// (storage.md): kind, def, at, seed, an empty caller, stream 0, the argument
// and outcome bytes (each a byte string of its codec encoding), then the writes:
// a count and one put of the key and the value.
fn encoded_size(p: Pair) -> u64 {
  let ok: Result[(), store.TxFailure[store.TxError]] = Ok(())
  let args = bytes.len(codec.encode(p))
  let outcome = bytes.len(codec.encode(ok))
  let record = 1u64 + 4 + 8 + 8 + 4 + 1 + (4 + args) + (4 + outcome)
  record + 4 + 1 + (4 + bytes.len(p.key)) + (4 + bytes.len(p.value))
}

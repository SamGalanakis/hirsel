fn after_ms(at: u64, ms: u64) -> u64 {
    at + ms * 1000000
}

fn test_config() -> http.Config {
    http.Config(ingress: list.new(), sockets_max: 2, http_max: 2, upgrades_max: 0, conns_max: 2, ip_sockets_max: 2, refuse_max: 1, refuse_ms: 5, inbox_cap: 2, head_max: 8192, fields_max: 64, pipeline_max: 8192, body_inline: 16384, body_max: 16384, out_cap: 128, handler_bytes: 4096, first_head_ms: 16, idle_ms: 100, head_ms: 20, body_ms: 100, handler_ms: 100, write_ms: 30, drain_ms: 10, linger_ms: 5, drain_max: 16, streams_max: 0, state_max: 0, reads_max: 0, heartbeat_ms: 0, lease_ms: 0)
}

type TestServer: send {
    listener: Listener,
    c: Clock,
    tasks: Tasks,
    cfg: http.Config,
    routes: router.Router[EchoState]
}

type EchoState: shareable + send {
    clock: Clock
}

fn echo(req: http.Request, scratch: Region, mut b: http.Body, state: EchoState) -> Result[http.Outcome, http.ResponseError] waits {
    let mut out: Bytes = list.with_capacity(192)
    let raw_path = http.path(req)
    if raw_path == string.as_bytes("/scratch") {
        let mut buf: SpanBuilder[u8, in scratch] = span.with_capacity(scratch, 3072)
        let second = isolate(fn() -> Result[u64, Capacity] {
            let more: SpanBuilder[u8, in scratch] = span.with_capacity(scratch, 4096)
            let _ = take more
            Ok(0)
        })
        let charged = match caught(take second) {
            Some(_) => true,
            None => false,
        }
        span.push(mut buf, b'x')
        let contents = span.finish(take buf)
        if !charged || contents[0] != b'x' {
            return Ok(Reply(http.response(500, take out, true)?))
        }
    } else if raw_path == string.as_bytes("/large") {
        list.fill(mut out, 160, b'x')
    } else if raw_path == string.as_bytes("/direct") {
        list.fill(mut out, 2048, b'Z')
    } else if raw_path == string.as_bytes("/when") {
        let mut time = string.new()
        string.push_u64(mut time, host.mono_ns(state.clock))
        let _ = list.append(mut out, string.as_bytes(time))
    } else if raw_path != string.as_bytes("/skip") {
        if let Some(inline) = http.inline_body(req) {
            let _ = list.append(mut out, inline)
        } else {
            loop {
                match http.read(mut b, mut out) {
                    Ok(0) => break,
                    Ok(_) => {},
                    Error(_) => break,
                }
            }
        }
    }
    Ok(Reply(http.response(200, take out, false)?))
}

fn test_server(take server: TestServer) waits {
    let TestServer(listener: take l, c, tasks, cfg: take cfg, routes: take routes) = take server
    let mut listeners: List[Listener] = list.with_capacity(1)
    list.push(mut listeners, take l)
    result.unwrap(http.serve(take listeners, c, tasks, take cfg, take routes, EchoState(clock: c)))
}

fn listen_for_law(n: Net, c: Clock, tasks: Tasks, take cfg: http.Config) -> (Task[()], Addr) waits {
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/{tail...}", router.raw(echo)))
    result.unwrap(router.add(mut routes, "POST", "/{tail...}", router.raw(echo)))
    listen_with_routes(n, c, tasks, take cfg, result.unwrap(router.build(take routes)))
}

fn listen_with_routes(n: Net, c: Clock, tasks: Tasks, take cfg: http.Config, take routes: router.Router[EchoState]) -> (Task[()], Addr) waits {
    let addr = Addr(ip: V4(2130706433), port: 0)
    let (listener, where_to) = result.unwrap(host.listen(n, addr, 8))
    let job = TestServer(listener: take listener, c, tasks, cfg: take cfg, routes: take routes)
    (task.spawn(tasks, bytes 262144, take job, test_server), where_to)
}

// The client resumes independently of the writer under test.
fn client_send(mut w: WriteHalf, data: Bytes, until: Until) -> bool waits {
    let mut delivered: u64 = 0
    let end = list.len(data)
    while delivered < end {
        match host.send_pair(mut w, list.slice(data, delivered, end), string.as_bytes(""), until) {
            Ok(0) => return false,
            Ok(n) => {
                delivered += n
            },
            Error(_) => return false,
        }
    }
    true
}

fn client_head(mut r: ReadHalf, mut received: Bytes, c: Clock, deadline: u64) -> u16 waits {
    let mut h = http1.head()
    loop {
        match http1.response(received, mut h) {
            Complete => return h.status,
            Partial => {},
            _ => return 0,
        }
        let max = list.capacity(received)
        match host.recv_bounded(mut r, mut received, max, At(c, deadline)) {
            Ok(0) => return 0,
            Ok(_) => {},
            Error(_) => return 0,
        }
    }
}

fn client_end(mut r: ReadHalf, mut received: Bytes, until: Until) -> bool waits {
    loop {
        let max = list.capacity(received)
        match host.recv_bounded(mut r, mut received, max, until) {
            Ok(0) => return true,
            Ok(_) => {},
            Error(_) => return false,
        }
    }
}

type Drip: send {
    w: WriteHalf,
    c: Clock,
    start: u64,
    first_ms: u64,
    every_ms: u64
}

fn drip(take plan: Drip) waits {
    let Drip(w: take w, c, start, first_ms, every_ms) = take plan
    let mut output = take w
    let raw = string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\n\r\n")
    for i in 0u64 .. list.len(raw) {
        host.sleep_until(c, after_ms(start, first_ms + i * every_ms))
        if !client_send(mut output, list.slice(raw, i, i + 1), At(c, after_ms(start, 70))) {
            return
        }
    }
}

fn within_wake(ns: u64, planned_ms: u64, wake_ms: u64) -> bool {
    ns + 1000 >= planned_ms * 1000000 && ns <= (planned_ms + wake_ms) * 1000000
}

// L3. The first deadline is accept + 16 ms, with the client beginning at
// 8 ms. On the reused socket, the first byte at +5 ms starts a 20 ms deadline.
// A reset on progress would complete the head or exceed either window.
// expect: run http_absolute_deadlines(network) = true
fn http_absolute_deadlines(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let accepted = host.mono_ns(c)
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let sender = task.spawn(tasks, bytes 1024, Drip(w: take w, c, start: accepted, first_ms: 8, every_ms: 4), drip)
    let mut received: Bytes = list.with_capacity(512)
    if client_head(mut input, mut received, c, after_ms(accepted, 60)) != 408 || !within_wake(host.mono_ns(c) - accepted, 16, 4) {
        return false
    }
    let _ = task.join(take sender)
    let s = result.unwrap(host.connect(n, addr, Never))
    let (r2, w2) = net.split(take s)
    let mut input2 = take r2
    let mut output2 = take w2
    let end = after_ms(host.mono_ns(c), 60)
    if !client_send(mut output2, string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\n\r\n"), At(c, end)) {
        return false
    }
    list.clear(mut received)
    if client_head(mut input2, mut received, c, end) != 200 {
        return false
    }
    let previous = host.mono_ns(c)
    let later = task.spawn(tasks, bytes 1024, Drip(w: take output2, c, start: previous, first_ms: 5, every_ms: 5), drip)
    list.clear(mut received)
    client_head(mut input2, mut received, c, after_ms(previous, 60)) == 408 && within_wake(host.mono_ns(c) - previous, 25, 5)
}

// L4/L6. The model admits at most eight bytes per send. The head followed
// by exactly 160 x bytes exceeds the 128-byte writer and must arrive intact.
// The virtual clock has no timer advances in this exchange, so Date is epoch.
// expect: run http_committed_prefix(network) = true
fn http_committed_prefix(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let mut output = take w
    let end = At(c, after_ms(host.mono_ns(c), 60))
    if !client_send(mut output, string.as_bytes("GET /large HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), end) {
        return false
    }
    let mut received: Bytes = list.with_capacity(512)
    if !client_end(mut input, mut received, end) {
        return false
    }
    let expected = string.as_bytes("HTTP/1.1 200 OK\r\nContent-Length: 160\r\nConnection: close\r\nDate: Thu, 01 Jan 1970 00:00:00 GMT\r\n\r\n")
    let offset = list.len(expected)
    if list.len(received) != offset + 160 || list.slice(received, 0, offset) != expected {
        return false
    }
    for i in offset .. list.len(received) {
        if received[i] != b'x' {
            return false
        }
    }
    true
}

// Expect remains pending until read. The peer sends three bytes only after
// 100, then sees a 200 whose body is those exact bytes.
// expect: run http_lazy_continue(network) = true
fn http_lazy_continue(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let mut output = take w
    let until = after_ms(host.mono_ns(c), 90)
    let request = string.as_bytes("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 3\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n")
    if !client_send(mut output, request, At(c, until)) {
        return false
    }
    let mut received: Bytes = list.with_capacity(512)
    if client_head(mut input, mut received, c, until) != 100 || received != string.as_bytes("HTTP/1.1 100 Continue\r\n\r\n") || !client_send(mut output, string.as_bytes("abc"), At(c, until)) {
        return false
    }
    list.clear(mut received)
    if !client_end(mut input, mut received, At(c, until)) {
        return false
    }
    let mut h = http1.head()
    http1.response(received, mut h) == Complete && h.status == 200 && list.slice(received, h.end, list.len(received)) == string.as_bytes("abc")
}

type ClientJob: send {
    w: WriteHalf,
    raw: Bytes,
    until: Until
}

fn client_write(take job: ClientJob) waits {
    let ClientJob(w: take w, raw: take raw, until) = take job
    let mut output = take w
    let _ = client_send(mut output, raw, until)
}

fn pipelined(n: Net, c: Clock, tasks: Tasks, take requests: Bytes, count: u64, last_body: u64) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let end = At(c, after_ms(host.mono_ns(c), 90))
    let writer = task.spawn(tasks, bytes 1024, ClientJob(w: take w, raw: take requests, until: end), client_write)
    let mut received: Bytes = list.with_capacity(1024)
    if !client_end(mut input, mut received, end) {
        return false
    }
    let nbytes = list.len(received)
    let mut offset: u64 = 0
    for _ in 0u64 .. count {
        let mut h = http1.head()
        if http1.response(list.slice(received, offset, nbytes), mut h) != Complete || h.status != 200 {
            return false
        }
        offset += h.end
    }
    nbytes - offset == last_body
}

// HTTP-6. Scratch hits the request allowance and the next request on the
// same connection can use the full allowance again.
// expect: run http_request_scratch(network) = true
fn http_request_scratch(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let requests = b"GET /scratch HTTP/1.1\r\nHost: a\r\n\r\nGET /scratch HTTP/1.1\r\nHost: a\r\n\r\nGET /scratch HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"
    pipelined(n, c, tasks, take requests, 3, 0)
}

fn capture_reply(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    let body = match http.capture(req, "id") {
        Some(s) => http.copy_bytes(string.as_bytes(s)),
        None => list.new(),
    }
    Ok(Reply(http.response(200, take body, false)?))
}

fn static_reply(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    Ok(Reply(http.response(201, b"fixed", false)?))
}

fn explicit_head(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    Ok(Reply(http.response(202, b"head", false)?))
}

fn tail_reply(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    if let Some(tail) = http.capture_tail(req, "rest") {
        if list.len(tail) == 2 && tail[0] == "a/b" && tail[1] == "end" {
            return Ok(Reply(http.response(204, list.new(), false)?))
        }
    }
    Ok(Reply(http.response(500, list.new(), true)?))
}

fn route_wire(n: Net, c: Clock, addr: Addr, request: Bytes, status: u16, length: String, allow: String, body: Bytes) -> bool waits {
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut input = take r
    let mut output = take w
    let until = At(c, after_ms(host.mono_ns(c), 90))
    let mut received: Bytes = list.with_capacity(512)
    if !client_send(mut output, request, until) || !client_end(mut input, mut received, until) {
        return false
    }
    let mut h = http1.head()
    if http1.response(received, mut h) != Complete || h.status != status || list.slice(received, h.end, list.len(received)) != body {
        return false
    }
    let mut saw_length = length == ""
    let mut saw_allow = allow == ""
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        let name = list.slice(received, f.name.start, f.name.end)
        let value = list.slice(received, f.value.start, f.value.end)
        if http1.equal_ascii(name, string.as_bytes("Content-Length")) {
            saw_length = value == string.as_bytes(length)
        }
        if http1.equal_ascii(name, string.as_bytes("Allow")) {
            saw_allow = value == string.as_bytes(allow)
        }
    }
    saw_length && saw_allow
}

// HTTP-11. A literal outranks a capture in either order. Decoding happens
// within each segment. HEAD has fallback and explicit-route precedence.
// expect: run http_router_dispatch(network) = true
fn http_router_dispatch(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/item/{id}", router.raw(capture_reply)))
    result.unwrap(router.add(mut routes, "GET", "/item/static", router.raw(static_reply)))
    result.unwrap(router.add(mut routes, "HEAD", "/item/head", router.raw(explicit_head)))
    result.unwrap(router.add(mut routes, "POST", "/item/static", router.Route(handler: static_reply, body_max: Some(1), upgrade_bytes: None, stream_bytes: None, steps: None)))
    result.unwrap(router.add(mut routes, "GET", "/other/a%2Fb", router.raw(static_reply)))
    result.unwrap(router.add(mut routes, "GET", "/other/{id}", router.raw(capture_reply)))
    result.unwrap(router.add(mut routes, "GET", "/files/{rest...}", router.raw(tail_reply)))
    let mut cfg = test_config()
    cfg.out_cap = 256
    let (server, addr) = listen_with_routes(n, c, tasks, take cfg, result.unwrap(router.build(take routes)))
    route_wire(n, c, addr, string.as_bytes("GET /item/static HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 201, "5", "", string.as_bytes("fixed")) && route_wire(n, c, addr, string.as_bytes("GET /item/a%2Fb HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 200, "3", "", string.as_bytes("a/b")) && route_wire(n, c, addr, string.as_bytes("HEAD /item/static HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 201, "5", "", string.as_bytes("")) && route_wire(n, c, addr, string.as_bytes("HEAD /item/head HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 202, "4", "", string.as_bytes("")) && route_wire(n, c, addr, string.as_bytes("GET /other/a%2fb HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 201, "5", "", string.as_bytes("fixed")) && route_wire(n, c, addr, string.as_bytes("GET /files/a%2Fb/end HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 204, "", "", string.as_bytes("")) && route_wire(n, c, addr, string.as_bytes("POST /item/static HTTP/1.1\r\nHost: a\r\nConnection: close\r\nContent-Length: 2\r\n\r\nab"), 413, "0", "", string.as_bytes("")) && route_wire(n, c, addr, string.as_bytes("GET /missing HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 404, "0", "", string.as_bytes("")) && route_wire(n, c, addr, string.as_bytes("PUT /item/static HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 405, "0", "GET, HEAD, POST", string.as_bytes("")) && route_wire(n, c, addr, string.as_bytes("OPTIONS * HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 204, "", "GET, HEAD, POST", string.as_bytes(""))
}

// HTTP-11. Both routes match /a/b and each accepts paths the other rejects.
// expect: run http_router_conflict() = true
fn http_router_conflict() -> bool {
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/a/{x}", router.raw(capture_reply)))
    result.unwrap(router.add(mut routes, "GET", "/{x}/b", router.raw(capture_reply)))
    match router.build(take routes) {
        Error(_) => true,
        Ok(_) => false,
    }
}

fn upgrade_echo(take handover: upgrade.Taken) waits {
    let started: Result[upgrade.Started[u64], upgrade.StartError] = upgrade.start(take handover)
    let mut session = match take started {
        Ok(take session) => take session,
        Error(_) => return,
    }
    if session.argument != 7 || !upgrade.established(mut session.socket) {
        return
    }
    let mut incoming: Bytes = list.with_capacity(3)
    let until = At(session.clock, after_ms(host.mono_ns(session.clock), 20))
    while list.len(incoming) < 3 {
        match upgrade.read(mut session.socket, mut incoming, until) {
            Ok(0) => return,
            Ok(_) => {},
            Error(_) => return,
        }
    }
    if incoming == string.as_bytes("xyz") {
        let reply = string.as_bytes("ok")
        let mut sent: u64 = 0
        while sent < list.len(reply) {
            match upgrade.write(mut session.socket, list.slice(reply, sent, list.len(reply)), until) {
                Ok(0) => return,
                Ok(n) => {
                    sent += n
                },
                Error(_) => return,
            }
        }
    }
}

fn upgrade_route(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    Ok(Upgrade(upgrade.spec(req, "echo", 4096, 7u64, upgrade_echo)?))
}

// HTTP-10. The protocol receives the bytes after the head and writes only
// after 101. A body is refused before the route, and an exhausted upgrade
// population refuses the transfer before the 101 is committed.
// expect: run http_upgrade_handoff(network) = true
fn http_upgrade_handoff(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.upgrades_max = 1
    cfg.conns_max = 1
    cfg.http_max = 1
    cfg.state_max = 64
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/echo", router.Route(handler: upgrade_route, body_max: None, upgrade_bytes: Some(4096), stream_bytes: None, steps: None)))
    result.unwrap(router.add(mut routes, "GET", "/plain", router.raw(static_reply)))
    let (server, addr) = listen_with_routes(n, c, tasks, take cfg, result.unwrap(router.build(take routes)))
    if !route_wire(n, c, addr, string.as_bytes("GET /echo HTTP/1.1\r\nHost: a\r\nConnection: Upgrade\r\nUpgrade: echo\r\nContent-Length: 1\r\n\r\nx"), 400, "0", "", string.as_bytes("")) {
        return false
    }
    host.sleep_until(c, after_ms(host.mono_ns(c), 6))
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut input = take r
    let mut output = take w
    let until = after_ms(host.mono_ns(c), 90)
    let request = string.as_bytes("GET /echo HTTP/1.1\r\nHost: a\r\nConnection: Upgrade\r\nUpgrade: echo\r\n\r\n")
    if !client_send(mut output, request, At(c, until)) {
        return false
    }
    let mut received: Bytes = list.with_capacity(512)
    if client_head(mut input, mut received, c, until) != 101 {
        return false
    }
    if !route_wire(n, c, addr, string.as_bytes("GET /plain HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 201, "5", "", string.as_bytes("fixed")) {
        return false
    }
    host.sleep_until(c, after_ms(host.mono_ns(c), 6))
    if !route_wire(n, c, addr, request, 503, "0", "", string.as_bytes("")) {
        return false
    }
    if !client_send(mut output, string.as_bytes("xyz"), At(c, until)) || !client_end(mut input, mut received, At(c, until)) {
        return false
    }
    let mut h = http1.head()
    if http1.response(received, mut h) != Complete || h.status != 101 || list.slice(received, h.end, list.len(received)) != string.as_bytes("ok") {
        return false
    }
    host.sleep_until(c, after_ms(host.mono_ns(c), 6))
    let tail = string.as_bytes("GET /echo HTTP/1.1\r\nHost: a\r\nConnection: Upgrade\r\nUpgrade: echo\r\n\r\nxyz")
    route_wire(n, c, addr, tail, 101, "", "", string.as_bytes("ok"))
}

fn next_stream_item(mut index: u64) -> Result[Option[Bytes], Capacity] {
    index += 1
    if index == 1 {
        Ok(Some(b"one"))
    } else if index == 2 {
        Ok(Some(b"two"))
    } else {
        Ok(None)
    }
}

fn stream_items(take seed: stream.Seed) waits {
    stream.produce(take seed, next_stream_item)
}

fn stream_route(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    let room = stream.Bounds(event_max: 128, producer_bytes: 4096, producer_steps: 256)
    Ok(Stream(stream.spec(req, 200, room, 0u64, stream_items)?))
}

// HTTP-10 and §2. The finite producer changes its decoded state between
// events. HTTP/1.1 chunks each event and terminates with a zero chunk.
// HTTP/1.0 sends the same body, delimited by close.
// expect: run http_raw_stream(network) = true
fn http_raw_stream(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.streams_max = 1
    cfg.out_cap = 256
    cfg.state_max = 64
    cfg.heartbeat_ms = 10
    cfg.lease_ms = 40
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/items", router.Route(handler: stream_route, body_max: None, upgrade_bytes: None, stream_bytes: Some(32768), steps: None)))
    let (server, addr) = listen_with_routes(n, c, tasks, take cfg, result.unwrap(router.build(take routes)))
    if !route_wire(n, c, addr, string.as_bytes("GET /items HTTP/1.1\r\nHost: a\r\n\r\n"), 200, "", "", string.as_bytes("3\r\none\r\n3\r\ntwo\r\n0\r\n\r\n")) {
        return false
    }
    host.sleep_until(c, after_ms(host.mono_ns(c), 6))
    if !route_wire(n, c, addr, string.as_bytes("GET /items HTTP/1.0\r\n\r\n"), 200, "", "", string.as_bytes("onetwo")) {
        return false
    }
    host.sleep_until(c, after_ms(host.mono_ns(c), 6))
    route_wire(n, c, addr, string.as_bytes("HEAD /items HTTP/1.1\r\nHost: a\r\n\r\n"), 200, "", "", string.as_bytes(""))
}

fn stalled_item(mut index: u64) -> Result[Option[Bytes], Capacity] waits {
    let (tx, rx): (Sender[()], Receiver[()]) = channel.new(1)
    let _ = channel.receive(rx)
    let _ = channel.try_send(tx, ())
    Ok(None)
}

fn stalled_stream(take seed: stream.Seed) waits {
    stream.produce(take seed, stalled_item)
}

fn heartbeat_route(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    let room = stream.Bounds(event_max: 128, producer_bytes: 4096, producer_steps: 256)
    let mut spec = stream.spec(req, 200, room, 0u64, stalled_stream)?
    let name = b"Content-Type"
    let value = b"text/event-stream"
    stream.header(mut spec, take name, take value)?
    Ok(Stream(take spec))
}

// §2. An empty source wait may run longer than the lease. Heartbeats are
// separate output units and do not move the lease set at commit.
// expect: run http_stream_lease(network) = true
fn http_stream_lease(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.streams_max = 1
    cfg.out_cap = 256
    cfg.state_max = 64
    cfg.heartbeat_ms = 5
    cfg.lease_ms = 12
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/live", router.Route(handler: heartbeat_route, body_max: None, upgrade_bytes: None, stream_bytes: Some(32768), steps: None)))
    let (server, addr) = listen_with_routes(n, c, tasks, take cfg, result.unwrap(router.build(take routes)))
    route_wire(n, c, addr, string.as_bytes("GET /live HTTP/1.1\r\nHost: a\r\n\r\n"), 200, "", "", string.as_bytes("3\r\n:\n\n\r\n3\r\n:\n\n\r\n0\r\n\r\n"))
}

type AssetServer: send {
    listener: Listener,
    c: Clock,
    tasks: Tasks,
    entries: assets.Manifest
}

fn asset_reply(req: http.Request, scratch: Region, mut out: http.Responder, state: assets.Manifest) -> Result[http.Outcome, http.HandlerError] {
    Ok(Reply(assets.respond(req, state)?))
}

fn serve_asset_law(take job: AssetServer) waits {
    let AssetServer(listener: take listener, c: clock, tasks, entries: take state) = take job
    let mut listeners: List[Listener] = list.with_capacity(1)
    list.push(mut listeners, take listener)
    let mut routes: router.Builder[assets.Manifest] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/{path...}", router.raw(asset_reply)))
    let mut cfg = test_config()
    cfg.out_cap = 512
    result.unwrap(http.serve(take listeners, clock, tasks, take cfg, result.unwrap(router.build(take routes)), take state))
}

fn gzip_hello() -> Bytes {
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xcb\x48\xcd\xc9\xc9\x07\x00\x86\xa6\x10\x36\x05\x00\x00\x00"
}

const IDENTITY_TAG: String = "\"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824\""

const GZIP_TAG: String = "\"3223ab15154bd181c783e5b434b108c68f5798bf10be7eb681faba9b6668bc65\""

fn asset_manifest() -> assets.Manifest {
    let identity = assets.representation(Identity, b"hello", string.from(IDENTITY_TAG))
    let gzip = assets.representation(Gzip, gzip_hello(), string.from(GZIP_TAG))
    let mut formats: List[assets.Representation] = list.with_capacity(2)
    list.push(mut formats, take identity)
    list.push(mut formats, take gzip)
    let mut names: List[String] = list.with_capacity(1)
    list.push(mut names, string.from("index.html"))
    let item = assets.Entry(path: take names, fingerprint: string.from("index-2cf24dba.html"), media_type: string.from("text/html"), formats: take formats)
    let mut entries: List[assets.Entry] = list.with_capacity(1)
    list.push(mut entries, take item)
    assets.manifest(take entries)
}

fn asset_field(raw: Bytes, h: http1.Head, name: String, expected: String) -> bool {
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        if http1.equal_ascii(list.slice(raw, f.name.start, f.name.end), string.as_bytes(name)) {
            return list.slice(raw, f.value.start, f.value.end) == string.as_bytes(expected)
        }
    }
    expected == ""
}

fn asset_wire(n: Net, c: Clock, addr: Addr, request: String, status: u16, tag: String, cache: String, coding: String, length: String, payload: Bytes) -> bool waits {
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut input = take r
    let mut output = take w
    let until = At(c, after_ms(host.mono_ns(c), 90))
    let mut received: Bytes = list.with_capacity(768)
    if !client_send(mut output, string.as_bytes(request), until) || !client_end(mut input, mut received, until) {
        return false
    }
    let mut h = http1.head()
    http1.response(received, mut h) == Complete && h.status == status && asset_field(received, h, "ETag", tag) && asset_field(received, h, "Cache-Control", cache) && asset_field(received, h, "Content-Encoding", coding) && asset_field(received, h, "Content-Length", length) && asset_field(received, h, "Vary", "Accept-Encoding") && list.slice(received, h.end, list.len(received)) == payload
}

// HTTP-14. The gzip tag validates only gzip, while the original name is
// revalidated and the fingerprinted alias is immutable. HEAD does not send
// the representation body and Range does not change GET's status or bytes.
// expect: run http_asset_validators(network) = true
fn http_asset_validators(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (listener, addr) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 8))
    let job = AssetServer(listener: take listener, c, tasks, entries: asset_manifest())
    let server = task.spawn(tasks, bytes 262144, take job, serve_asset_law)
    asset_wire(n, c, addr, "GET /index.html HTTP/1.1\r\nHost: a\r\nConnection: close\r\nRange: bytes=0-1\r\n\r\n", 200, IDENTITY_TAG, "no-cache", "", "5", string.as_bytes("hello")) && asset_wire(n, c, addr, "GET /index-2cf24dba.html HTTP/1.1\r\nHost: a\r\nConnection: close\r\nAccept-Encoding: gzip\r\nIf-None-Match: \"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824\"\r\n\r\n", 200, GZIP_TAG, "public, max-age=31536000, immutable", "gzip", "25", gzip_hello()) && asset_wire(n, c, addr, "GET /index.html HTTP/1.1\r\nHost: a\r\nConnection: close\r\nAccept-Encoding: gzip\r\nIf-None-Match: W/\"3223ab15154bd181c783e5b434b108c68f5798bf10be7eb681faba9b6668bc65\"\r\n\r\n", 304, GZIP_TAG, "no-cache", "gzip", "", string.as_bytes("")) && asset_wire(n, c, addr, "HEAD /index.html HTTP/1.1\r\nHost: a\r\nConnection: close\r\nAccept-Encoding: gzip;q=0\r\n\r\n", 200, IDENTITY_TAG, "no-cache", "", "5", string.as_bytes(""))
}

fn step_work(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    let mut sum: u64 = 0
    for i in 0u64 .. 128 {
        sum += i
    }
    Ok(Reply(http.response(if sum == 8128 {
        204
    } else {
        500
    }, list.new(), false)?))
}

// HTTP-5/MEM-30. One route exhausts its step bound during computation. The
// server releases that exchange and runs the same handler under another bound.
// expect: run http_handler_steps(network) = true
fn http_handler_steps(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/small", router.Route(handler: step_work, body_max: None, upgrade_bytes: None, stream_bytes: None, steps: Some(64))))
    result.unwrap(router.add(mut routes, "GET", "/large", router.Route(handler: step_work, body_max: None, upgrade_bytes: None, stream_bytes: None, steps: Some(4096))))
    let (server, addr) = listen_with_routes(n, c, tasks, test_config(), result.unwrap(router.build(take routes)))
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut input = take r
    let mut output = take w
    let deadline = At(c, after_ms(host.mono_ns(c), 90))
    let request = string.as_bytes("GET /small HTTP/1.1\r\nHost: a\r\n\r\n")
    let mut received: Bytes = list.with_capacity(512)
    if !client_send(mut output, request, deadline) || !client_end(mut input, mut received, deadline) || list.len(received) != 0 {
        return false
    }
    route_wire(n, c, addr, string.as_bytes("GET /large HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), 204, "", "", string.as_bytes(""))
}

type StopServer: send {
    listener: Listener,
    c: Clock,
    tasks: Tasks,
    stop: Receiver[u64]
}

fn stop_server(take job: StopServer) waits {
    let StopServer(listener: take listener, c, tasks, stop: take stop) = take job
    let mut listeners: List[Listener] = list.with_capacity(1)
    list.push(mut listeners, take listener)
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/{tail...}", router.raw(echo)))
    result.unwrap(router.add(mut routes, "GET", "/live", router.Route(handler: heartbeat_route, body_max: None, upgrade_bytes: None, stream_bytes: Some(32768), steps: None)))
    result.unwrap(router.add(mut routes, "GET", "/protocol", router.Route(handler: controlled_upgrade_route, body_max: None, upgrade_bytes: Some(4096), stream_bytes: None, steps: None)))
    let routing = result.unwrap(router.build(take routes))
    let mut cfg = test_config()
    cfg.out_cap = 256
    cfg.streams_max = 1
    cfg.upgrades_max = 1
    cfg.state_max = 64
    cfg.heartbeat_ms = 80
    cfg.lease_ms = 200
    result.unwrap(http.serve_with_stop(take listeners, c, tasks, take cfg, take routing, EchoState(clock: c), take stop))
}

fn stop_fixture(n: Net, c: Clock, tasks: Tasks) -> (Task[()], Addr, Sender[u64]) waits {
    let (listener, addr) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 8))
    let (stop, receive_stop): (Sender[u64], Receiver[u64]) = channel.new(1)
    let server = task.spawn(tasks, bytes 262144, StopServer(listener: take listener, c, tasks, stop: take receive_stop), stop_server)
    (take server, addr, take stop)
}

// HTTP-1/O34. The idle socket closes when admission closes. A committed
// response completes, and its connection then closes before another head.
// expect: run http_stop_exchange(network) = true
fn http_stop_exchange(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr, stop) = stop_fixture(n, c, tasks)
    let end = after_ms(host.mono_ns(c), 90)
    let until = At(c, end)
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, until)))
    let mut idle_read = take r
    let mut idle_write = take w
    if empty_get(mut idle_write, mut idle_read, string.as_bytes("GET /skip HTTP/1.1\r\nHost: a\r\n\r\n"), c, end) != 200 {
        return false
    }
    let (ar, aw) = net.split(result.unwrap(host.connect(n, addr, until)))
    let mut active_read = take ar
    let mut active_write = take aw
    if !client_send(mut active_write, string.as_bytes("GET /large HTTP/1.1\r\nHost: a\r\n\r\n"), until) {
        return false
    }
    let mut reply: Bytes = list.with_capacity(512)
    if client_head(mut active_read, mut reply, c, end) != 200 {
        return false
    }
    let stop_at = host.mono_ns(c)
    if let Error(_) = channel.send(stop, after_ms(stop_at, 40)) {
        return false
    }
    let mut idle_tail: Bytes = list.with_capacity(16)
    if !client_end(mut idle_read, mut idle_tail, until) || list.len(idle_tail) != 0 || host.mono_ns(c) >= after_ms(stop_at, 40) {
        return false
    }
    if let Ok(_) = host.connect(n, addr, until) {
        return false
    }
    if !client_end(mut active_read, mut reply, until) {
        return false
    }
    let mut head = http1.head()
    if http1.response(reply, mut head) != Complete || list.len(reply) != head.end + 160 {
        return false
    }
    for i in head.end .. list.len(reply) {
        if reply[i] != b'x' {
            return false
        }
    }
    if let Ok(()) = task.join(take server) {
        return host.mono_ns(c) < after_ms(stop_at, 40)
    }
    false
}

// HTTP-1/O28. A parked write keeps its committed prefix and is interrupted
// at D, even though its own 30 ms output deadline has more time left.
// expect: run http_stop_deadline(network) = true
fn http_stop_deadline(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr, stop) = stop_fixture(n, c, tasks)
    let end = after_ms(host.mono_ns(c), 90)
    let until = At(c, end)
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, until)))
    let mut input = take r
    let mut output = take w
    let request = string.as_bytes("GET /large HTTP/1.1\r\nHost: a\r\n\r\n")
    let mut reply: Bytes = list.with_capacity(512)
    if !client_send(mut output, request, until) || client_head(mut input, mut reply, c, end) != 200 {
        return false
    }
    let at = host.mono_ns(c)
    if let Error(_) = channel.send(stop, after_ms(at, 2)) {
        return false
    }
    host.sleep_until(c, after_ms(at, 3))
    if !client_end(mut input, mut reply, until) || !within_wake(host.mono_ns(c) - at, 3, 1) {
        return false
    }
    let mut h = http1.head()
    if http1.response(reply, mut h) != Complete || list.len(reply) >= h.end + 160 {
        return false
    }
    for i in h.end .. list.len(reply) {
        if reply[i] != b'x' {
            return false
        }
    }
    if let Ok(()) = task.join(take server) {
        true
    } else {
        false
    }
}

// HTTP-1 and §2. A committed stream whose producer and timer are both
// parked receives Stop immediately and sends its terminal unit before D.
// expect: run http_stop_stream(network) = true
fn http_stop_stream(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr, stop) = stop_fixture(n, c, tasks)
    let end = after_ms(host.mono_ns(c), 90)
    let until = At(c, end)
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, until)))
    let mut input = take r
    let mut output = take w
    let mut reply: Bytes = list.with_capacity(512)
    if !client_send(mut output, string.as_bytes("GET /live HTTP/1.1\r\nHost: a\r\n\r\n"), until) || client_head(mut input, mut reply, c, end) != 200 {
        return false
    }
    let d = after_ms(host.mono_ns(c), 40)
    if let Error(_) = channel.send(stop, d) {
        return false
    }
    if !client_end(mut input, mut reply, until) {
        return false
    }
    let mut h = http1.head()
    if http1.response(reply, mut h) != Complete || list.slice(reply, h.end, list.len(reply)) != string.as_bytes("0\r\n\r\n") {
        return false
    }
    if let Ok(()) = task.join(take server) {
        host.mono_ns(c) < d
    } else {
        false
    }
}

fn controlled_upgrade(take handover: upgrade.Taken) waits {
    let started: Result[upgrade.Started[()], upgrade.StartError] = upgrade.start(take handover)
    let mut session = result.unwrap(take started)
    if !upgrade.established(mut session.socket) {
        return
    }
    let mut data: Bytes = list.with_capacity(8)
    if let Ok(1) = upgrade.read(mut session.socket, mut data, Never) {
        if let Some(d) = upgrade.stop_deadline(session.socket) {
            list.clear(mut data)
            list.put_word_le(mut data, d)
            let mut sent: u64 = 0
            while sent < 8 {
                match upgrade.write(mut session.socket, list.slice(data, sent, 8), Never) {
                    Ok(0) => return,
                    Ok(n) => {
                        sent += n
                    },
                    Error(_) => return,
                }
            }
        }
    }
}

fn controlled_upgrade_route(req: http.Request, scratch: Region, mut out: http.Responder, state: EchoState) -> Result[http.Outcome, http.HandlerError] {
    Ok(Upgrade(upgrade.spec(req, "echo", 4096, (), controlled_upgrade)?))
}

// HTTP-1. The established protocol reads the caller's exact stop deadline.
// expect: run http_stop_upgrade(network) = true
fn http_stop_upgrade(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr, stop) = stop_fixture(n, c, tasks)
    let end = after_ms(host.mono_ns(c), 90)
    let until = At(c, end)
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, until)))
    let mut input = take r
    let mut output = take w
    let mut reply: Bytes = list.with_capacity(512)
    let request = string.as_bytes("GET /protocol HTTP/1.1\r\nHost: a\r\nConnection: Upgrade\r\nUpgrade: echo\r\n\r\n")
    if !client_send(mut output, request, until) || client_head(mut input, mut reply, c, end) != 101 {
        return false
    }
    let now = host.mono_ns(c)
    let d = after_ms(now, 47)
    if let Error(_) = channel.send(stop, d) {
        return false
    }
    host.sleep_until(c, after_ms(now, 1))
    if !client_send(mut output, string.as_bytes("x"), until) || !client_end(mut input, mut reply, until) {
        return false
    }
    let mut h = http1.head()
    if http1.response(reply, mut h) != Complete || list.len(reply) != h.end + 8 || list.word_le(reply, h.end) != d {
        return false
    }
    if let Ok(()) = task.join(take server) {
        true
    } else {
        false
    }
}

// L5. When ignoring a one-byte body the next head is preserved. An unread
// 24-byte body is over the 16-byte drain limit. An invalid chunk caught by the
// handler also closes, even though the handler returns a 200.
// expect: run http_drain_and_sticky_failure(network) = true
fn http_drain_and_sticky_failure(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    pipelined(n, c, tasks, b"POST /skip HTTP/1.1\r\nHost: a\r\nContent-Length: 1\r\n\r\nxGET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n", 2, 0) && pipelined(n, c, tasks, b"POST /skip HTTP/1.1\r\nHost: a\r\nContent-Length: 24\r\n\r\nabcdefghijklmnopqrstuvwxGET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n", 1, 0) && pipelined(n, c, tasks, b"POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\nQ\r\nGET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n", 1, 0) && pipelined(n, c, tasks, b"POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n4001\r\nGET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n", 1, 0)
}

// L5. With an eight-byte model queue, an unread 160-byte response cannot
// finish. Give it 35 ms against the 30 ms unit deadline before draining the
// client end. The client must see the accepted prefix followed by EOF.
// expect: run http_output_deadline(network) = true
fn http_output_deadline(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let start = host.mono_ns(c)
    let end = At(c, after_ms(start, 60))
    let raw = b"GET /large HTTP/1.1\r\nHost: a\r\n\r\nGET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"
    let sender = task.spawn(tasks, bytes 1024, ClientJob(w: take w, raw: take raw, until: end), client_write)
    host.sleep_until(c, after_ms(start, 35))
    let mut received: Bytes = list.with_capacity(512)
    if !client_end(mut input, mut received, end) {
        return false
    }
    let prefix = string.as_bytes("HTTP/1.1")
    let len = order.min(list.len(received), list.len(prefix))
    len > 0 && list.len(received) < 160 && received[0] == b'H' && list.slice(received, 0, len) == list.slice(prefix, 0, len)
}

// L6. The next two requests are sent without waiting for the prior reply.
// Exactly three responses must arrive in order, with the long body last.
// expect: run http_pipeline_order(network) = true
fn http_pipeline_order(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    pipelined(n, c, tasks, b"GET / HTTP/1.1\r\nHost: a\r\n\r\nGET / HTTP/1.1\r\nHost: a\r\n\r\nGET /large HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n", 3, 160)
}

// L11a. Completing a first response releases its first-phase slot, but
// the idle socket still reserves its only HTTP slot. A refusal worker stays
// occupied until its peer writes EOF or its own deadline expires.
// expect: run http_socket_caps(network) = true
fn http_socket_caps(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.http_max = 1
    cfg.conns_max = 1
    cfg.inbox_cap = 1
    let (server, addr) = listen_for_law(n, c, tasks, take cfg)
    let accepted = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take accepted)
    let mut input = take r
    let mut output = take w
    let deadline = after_ms(host.mono_ns(c), 80)
    let request = string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\n\r\n")
    let mut received: Bytes = list.with_capacity(512)
    if !client_send(mut output, request, At(c, deadline)) || client_head(mut input, mut received, c, deadline) != 200 {
        return false
    }
    let refused = result.unwrap(host.connect(n, addr, Never))
    let (rr, rw) = net.split(take refused)
    let mut first_refusal = take rr
    list.clear(mut received)
    if !client_end(mut first_refusal, mut received, At(c, deadline)) || received != string.as_bytes("HTTP/1.1 503 Service Unavailable\r\nRetry-After: 1\r\nConnection: close\r\nContent-Length: 0\r\n\r\n") {
        return false
    }
    let other = result.unwrap(host.connect(n, addr, Never))
    let (r3, w3) = net.split(take other)
    let mut second_refusal = take r3
    list.clear(mut received)
    if !client_end(mut second_refusal, mut received, At(c, deadline)) || list.len(received) != 0 {
        return false
    }
    client_send(mut output, request, At(c, deadline)) && client_head(mut input, mut received, c, deadline) == 200
}

fn empty_get(mut w: WriteHalf, mut r: ReadHalf, raw: Bytes, c: Clock, until: u64) -> u16 waits {
    let mut got: Bytes = list.with_capacity(512)
    if client_send(mut w, raw, At(c, until)) {
        client_head(mut r, mut got, c, until)
    } else {
        0
    }
}

// L11a. Two first-phase sockets cannot coexist when conns_max is one.
// The first completed response releases that count while retaining HTTP C.
// expect: run http_first_phase_refund(network) = true
fn http_first_phase_refund(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.conns_max = 1
    let (server, addr) = listen_for_law(n, c, tasks, take cfg)
    let left = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take left)
    let mut left_in = take r
    let mut left_out = take w
    let until = after_ms(host.mono_ns(c), 80)
    let excess = result.unwrap(host.connect(n, addr, Never))
    let (bad_in, bad_out) = net.split(take excess)
    let mut refused = take bad_in
    let mut got: Bytes = list.with_capacity(512)
    if client_head(mut refused, mut got, c, until) != 503 {
        return false
    }
    let raw = string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\n\r\n")
    if empty_get(mut left_out, mut left_in, raw, c, until) != 200 {
        return false
    }
    let right = result.unwrap(host.connect(n, addr, Never))
    let (r2, w2) = net.split(take right)
    let mut right_in = take r2
    let mut right_out = take w2
    empty_get(mut right_out, mut right_in, raw, c, until) == 200
}

// HTTP-1. The TCP peer gets the first slot. Its validated forwarding field
// moves that count away, letting the next TCP socket reach the same check.
// That connection still cannot borrow the first source's reservation.
// expect: run http_trusted_source_caps(network) = true
fn http_trusted_source_caps(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.ip_sockets_max = 1
    list.push(mut cfg.ingress, wsock.Prefix(ip: V4(2130706433), bits: 32))
    let (server, addr) = listen_for_law(n, c, tasks, take cfg)
    let left = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take left)
    let mut left_in = take r
    let mut left_out = take w
    let until = after_ms(host.mono_ns(c), 80)
    let raw = string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\nX-Forwarded-For: 192.0.2.1\r\n\r\n")
    if empty_get(mut left_out, mut left_in, raw, c, until) != 200 {
        return false
    }
    let right = result.unwrap(host.connect(n, addr, Never))
    let (r2, w2) = net.split(take right)
    let mut right_in = take r2
    let mut right_out = take w2
    if empty_get(mut right_out, mut right_in, raw, c, until) != 503 {
        return false
    }
    empty_get(mut left_out, mut left_in, raw, c, until) == 200
}

// HTTP-4(11). HEAD preserves the GET length and finishes at the blank line.
// expect: run http_head_response(network) = true
fn http_head_response(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let mut output = take w
    let end = At(c, after_ms(host.mono_ns(c), 60))
    if !client_send(mut output, string.as_bytes("HEAD /large HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), end) {
        return false
    }
    let mut received: Bytes = list.with_capacity(512)
    client_end(mut input, mut received, end) && received == string.as_bytes("HTTP/1.1 200 OK\r\nContent-Length: 160\r\nConnection: close\r\nDate: Thu, 01 Jan 1970 00:00:00 GMT\r\n\r\n")
}

// L5. The peer leaves one body byte unread and keeps its own write half open.
// Drain ends in 10 ms and linger in 5 ms. A later socket can use the HTTP slot
// even while the original peer still holds both of its halves.
// expect: run http_drain_timeout_and_linger(network) = true
fn http_drain_timeout_and_linger(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.http_max = 1
    let (server, addr) = listen_for_law(n, c, tasks, take cfg)
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let mut output = take w
    let until = after_ms(host.mono_ns(c), 90)
    let raw = string.as_bytes("POST /skip HTTP/1.1\r\nHost: a\r\nContent-Length: 1\r\n\r\n")
    if empty_get(mut output, mut input, raw, c, until) != 200 {
        return false
    }
    let started = host.mono_ns(c)
    let mut got: Bytes = list.with_capacity(128)
    if !client_end(mut input, mut got, At(c, until)) || list.len(got) != 0 || !within_wake(host.mono_ns(c) - started, 10, 1) {
        return false
    }
    host.sleep_until(c, after_ms(started, 16))
    let second = result.unwrap(host.connect(n, addr, At(c, until)))
    let (r2, w2) = net.split(take second)
    let mut read_next = take r2
    let mut write_next = take w2
    empty_get(mut write_next, mut read_next, string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\n\r\n"), c, until) == 200
}

// L6. Withholding client reads until +5 ms prevents the first oversized
// response from committing. A timestamp taken at the next handler's entry
// must therefore be at or after +5 ms, even though the client sends both
// requests immediately.
// expect: run http_handler_starts_after_commit(network) = true
fn http_handler_starts_after_commit(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let start = host.mono_ns(c)
    let read_start = after_ms(start, 5)
    let end = At(c, after_ms(start, 60))
    let raw = b"GET /large HTTP/1.1\r\nHost: a\r\n\r\nGET /when HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"
    let writer = task.spawn(tasks, bytes 1024, ClientJob(w: take w, raw: take raw, until: end), client_write)
    host.sleep_until(c, read_start)
    let mut received: Bytes = list.with_capacity(1024)
    if !client_end(mut input, mut received, end) {
        return false
    }
    let mut first = http1.head()
    let mut second = http1.head()
    if http1.response(received, mut first) != Complete || first.status != 200 || list.len(received) < first.end + 160 {
        return false
    }
    let rest = list.slice(received, first.end + 160, list.len(received))
    if http1.response(rest, mut second) != Complete || second.status != 200 {
        return false
    }
    let stamp = http.copy_bytes(list.slice(rest, second.end, list.len(rest)))
    let text = result.unwrap(string.from_utf8(take stamp))
    match int.parse_uint(text, 10) {
        Ok(at) => at >= read_start,
        Error(_) => false,
    }
}

// L6. The live handler scope reserves its whole 4096 B. The connection has
// only 1272 B of spare J and hand-off allowance, so the 128-byte writer
// cannot grow to hold this 2048-byte body. Direct sends must still finish.
// expect: run http_large_body_fits_connection(network) = true
fn http_large_body_fits_connection(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let socket = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take socket)
    let mut input = take r
    let mut output = take w
    let end = At(c, after_ms(host.mono_ns(c), 60))
    if !client_send(mut output, string.as_bytes("GET /direct HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"), end) {
        return false
    }
    let mut received: Bytes = list.with_capacity(4096)
    if !client_end(mut input, mut received, end) {
        return false
    }
    let mut h = http1.head()
    if http1.response(received, mut h) != Complete || h.status != 200 || list.len(received) != h.end + 2048 {
        return false
    }
    for i in h.end .. list.len(received) {
        if received[i] != b'Z' {
            return false
        }
    }
    true
}

// HTTP-1/3. Configured bounds below the parser's fixed ceilings are still
// enforced. A long request line gets 414. Excess fields get 431.
// expect: run http_configured_head_bounds(network) = true
fn http_configured_head_bounds(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.head_max = 40
    cfg.fields_max = 1
    let (server, addr) = listen_for_law(n, c, tasks, take cfg)
    let first = result.unwrap(host.connect(n, addr, Never))
    let (r, w) = net.split(take first)
    let mut input = take r
    let mut output = take w
    let until = after_ms(host.mono_ns(c), 60)
    // The unfinished request line hits the 40-byte head bound. Stop sending
    // there so the client can read the error even on a bounded pipe.
    let long = string.as_bytes("GET /abcdefghijklmnopqrstuvwxyzabcdefghi")
    if empty_get(mut output, mut input, long, c, until) != 414 {
        return false
    }
    let second = result.unwrap(host.connect(n, addr, Never))
    let (r2, w2) = net.split(take second)
    let mut next_in = take r2
    let mut next_out = take w2
    let extra = string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\nX: y\r\n\r\n")
    empty_get(mut next_out, mut next_in, extra, c, until) == 431
}

fn response_split(wire: Bytes, split: u64, head_only: bool, expected_status: u16, expected_body: String, next: bool) -> bool {
    let mut r = result.unwrap(http_client.reader())
    let mut body: Bytes = list.with_capacity(64)
    let mut piece: Bytes = list.with_capacity(2)
    let mut have_head = false
    let mut ended = false
    for (start, stop) in[(0u64, split), (split, list.len(wire))] {
        if http_client.feed(mut r, list.slice(wire, start, stop)) != stop - start {
            return false
        }
        if !have_head {
            have_head = result.unwrap(http_client.parse_head(mut r, head_only, 64))
        }
        if have_head && !ended {
            loop {
                list.clear(mut piece)
                match result.unwrap(http_client.read_buffered(mut r, mut piece)) {
                    NeedInput => break,
                    Data(n) => {
                        if n != list.len(piece) {
                            return false
                        }
                        list.append(mut body, piece)
                    },
                    End => {
                        ended = true
                        break
                    },
                }
            }
        }
    }
    http_client.end_input(mut r)
    if !have_head || !ended && result.unwrap(http_client.read_buffered(mut r, mut piece)) != End {
        return false
    }
    {
        let response = http_client.response_head(r)
        let Some((name, value)) = http_client.field_at(response, 0) else {
            return false
        }
        if http_client.status(response) != expected_status || name != string.as_bytes("X-Test") || value != string.as_bytes("yes") || body != string.as_bytes(expected_body) {
            return false
        }
    }
    if next {
        return result.unwrap(http_client.parse_head(mut r, false, 0)) && http_client.status(http_client.response_head(r)) == 202
    }
    true
}

fn invalid_response(wire: Bytes, over_head: bool) -> bool {
    let mut r = result.unwrap(http_client.reader())
    let _ = http_client.feed(mut r, wire)
    if over_head {
        return match http_client.parse_head(mut r, false, 0) {
            Error(TooLarge) => true,
            _ => false,
        }
    }
    match http_client.parse_head(mut r, false, 64) {
        Error(BodyFraming) => true,
        Ok(true) => {
            let mut out: Bytes = list.with_capacity(64)
            match http_client.read_buffered(mut r, mut out) {
                Error(BodyFraming) => true,
                _ => false,
            }
        },
        _ => false,
    }
}

// RFC 9112 §6.3 and §7.1. Every boundary, including a split inside
// interim and final heads, must preserve the decoded bytes and the next head.
// expect: run http_client_response_fragments() = true
fn http_client_response_fragments() -> bool {
    let rows: Inline[(String, u16, String, bool, bool), 7] =[
        ("HTTP/1.1 200 OK\r\nX-Test: yes\r\nTransfer-Encoding: chunked\r\n\r\n2;tag=\"a;b\"\r\nhi\r\n3\r\nbye\r\n0\r\nX-Trailer: end\r\n\r\n", 200, "hibye", false, true),
        ("HTTP/1.1 200 OK\r\nX-Test: yes\r\nContent-Length: 5\r\n\r\nhello", 200, "hello", false, true),
        ("HTTP/1.0 200 OK\r\nX-Test: yes\r\n\r\nhello", 200, "hello", false, false),
        ("HTTP/1.1 200 OK\r\nX-Test: yes\r\nContent-Length: 100\r\n\r\n", 200, "", true, true),
        ("HTTP/1.1 204 No Content\r\nX-Test: yes\r\n\r\n", 204, "", false, true),
        ("HTTP/1.1 304 Not Modified\r\nX-Test: yes\r\nContent-Length: 100\r\n\r\n", 304, "", false, true),
        ("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nX-Test: yes\r\nContent-Length: 3\r\n\r\nyes", 200, "yes", false, true),
    ]
    for (response, status, body, head_only, next) in rows {
        let mut wire: Bytes = list.with_capacity(512)
        list.append(mut wire, string.as_bytes(response))
        if next {
            list.append(mut wire, string.as_bytes("HTTP/1.1 202 Accepted\r\nContent-Length: 0\r\n\r\n"))
        }
        for i in 0u64 .. list.len(wire) + 1 {
            if !response_split(wire, i, head_only, status, body, next) {
                return false
            }
        }
    }
    // RFC 9112 §6.3 rejects ambiguous framing. §7.1 warns against overflow.
    let both = string.as_bytes("HTTP/1.1 200 OK\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n")
    let overflow = string.as_bytes("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n10000000000000000\r\n")
    let mut long: Bytes = list.with_capacity(8192)
    list.append(mut long, string.as_bytes("HTTP/1.1 200 OK\r\nX: "))
    let room = 8192 - list.len(long)
    list.fill(mut long, room, b'a')
    invalid_response(both, false) && invalid_response(overflow, false) && invalid_response(long, true)
}

fn post_echo(mut client: http_client.Connection, expected: String) -> bool waits {
    result.unwrap(http_client.finish_request(mut client, 128))
    if http_client.status(http_client.head(client)) != 200 {
        return false
    }
    let mut data: Bytes = list.with_capacity(128)
    while result.unwrap(http_client.read(mut client, mut data)) != 0 {}
    data == string.as_bytes(expected) && http_client.reusable(client)
}

// The std HTTP server echoes the decoded request payload. Reuse the same
// socket for a fixed upload and a chunked upload, checking both responses.
// expect: run http_client_round_trip(network) = true
fn http_client_round_trip(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, address) = listen_for_law(n, c, tasks, test_config())
    let fixed = http_client.Request(method: "POST", target: "/echo?source=client", headers: list.new(), body: Fixed(5))
    let end = after_ms(host.mono_ns(c), 100)
    let mut client = result.unwrap(http_client.open(n, address, "example.test", c, end))
    if http_client.request_started(client) || !http_client.reusable(client) {
        fail("opening a connection started a request")
    }
    result.unwrap(http_client.start(mut client, fixed, end))
    if !http_client.request_started(client) {
        fail("a successful start committed no request bytes")
    }
    result.unwrap(http_client.write(mut client, string.as_bytes("hel")))
    result.unwrap(http_client.write(mut client, string.as_bytes("lo")))
    if !post_echo(mut client, "hello") {
        return false
    }
    let chunked = http_client.Request(method: "POST", target: "/echo", headers: list.new(), body: Chunked)
    result.unwrap(http_client.start(mut client, chunked, after_ms(host.mono_ns(c), 100)))
    result.unwrap(http_client.write(mut client, string.as_bytes("good")))
    result.unwrap(http_client.write(mut client, string.as_bytes("bye")))
    let passed = post_echo(mut client, "goodbye")
    http_client.close(take client)
    let mut server_task = take server
    task.cancel(mut server_task)
    let _ = task.join(take server_task)
    passed
}

type ResponseNetwork: send {
    port: Served[NetOp],
    clock: Clock,
}

fn response_clock(take input: sim.world.World) waits {
    let mut world = take input
    sim.world.run(mut world)
}

fn response_network(take input: ResponseNetwork) waits {
    let ResponseNetwork(port: take port, clock) = take input
    let config = sim.net.Config(queue_bytes: 32768, fragment_bytes: 32768, latency_ns: 0)
    // Maximum draws make every simulated send and receive take its full offer.
    let mut draws: List[u64] = list.with_capacity(128)
    list.fill(mut draws, 128, 18446744073709551615u64)
    let mut streams: List[List[u64]] = list.with_capacity(1)
    list.push(mut streams, take draws)
    let script = sim.world.Script(tail_seed: 0, streams: take streams)
    let mut plan = sim.world.plan_from(script, 0)
    let _ = sim.net.serve(sim.net.new(config), mut plan, clock, take port)
}

fn read_response_train(n: Net, c: Clock) -> bool waits {
    let (bound_listener, address) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 1))
    let mut listener = take bound_listener
    let socket = result.unwrap(host.connect(n, address, Never))
    let (peer, _) = result.unwrap(host.accept(mut listener, Never))
    let (server_input, server_output) = net.split(take peer)
    let mut output = take server_output
    let request = http_client.Request(method: "GET", target: "/", headers: list.new(), body: Fixed(0))
    let end = after_ms(host.mono_ns(c), 100)
    let mut client = result.unwrap(http_client.attach(take socket, "example.test", c, request, end))
    let until = At(c, end)
    let head = string.as_bytes("HTTP/1.1 200 OK\r\nContent-Length: 9003\r\n\r\nabc")
    if !client_send(mut output, head, until) {
        fail("failed to send the head and its payload prefix")
    }
    result.unwrap(http_client.finish_request(mut client, 9003))
    let mut body: Bytes = list.with_capacity(9004)
    if result.unwrap(http_client.read(mut client, mut body)) != 3 || body != string.as_bytes("abc") {
        fail("read-ahead payload differs from the sent prefix")
    }
    let mut sent: Bytes = list.with_capacity(9000)
    list.fill(mut sent, 8997, b'x')
    list.append(mut sent, string.as_bytes("end"))
    if !client_send(mut output, sent, until) {
        fail("failed to send the large payload fragment")
    }
    if result.unwrap(http_client.read(mut client, mut body)) != 9000 {
        fail("read did not accept the offered 9000-byte payload fragment")
    }
    if list.slice(body, 3, 9003) != sent {
        fail("direct payload differs from the sent bytes")
    }
    if result.unwrap(http_client.read(mut client, mut body)) != 0 || !http_client.reusable(client) {
        fail("fixed response did not end on a reusable connection")
    }
    result.unwrap(http_client.start(mut client, request, end))
    let first = string.as_bytes("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhe")
    if !client_send(mut output, first, until) {
        fail("failed to send the chunked head and first payload prefix")
    }
    result.unwrap(http_client.finish_request(mut client, 8))
    let mut small: Bytes = list.with_capacity(2)
    while list.len(small) < 2 {
        if result.unwrap(http_client.read(mut client, mut small)) == 0 {
            fail("unexpected EOF before the two-byte buffer filled")
        }
    }
    if small != string.as_bytes("he") {
        fail("first chunk prefix differs from the sent bytes")
    }
    if let Error(NoSpace) = http_client.read(mut client, mut small) {
        if small != string.as_bytes("he") {
            fail("NoSpace changed the caller buffer")
        }
    } else {
        fail("a full caller buffer did not return NoSpace")
    }
    list.clear(mut body)
    if !client_send(mut output, string.as_bytes("llo\r"), until) || result.unwrap(http_client.read(mut client, mut body)) != 3 {
        fail("read did not resume with the rest of the first chunk")
    }
    let last = string.as_bytes("\n3;tag=ok\r\nbye\r\n0\r\nX-Trailer: end\r\n\r\n")
    if !client_send(mut output, last, until) || result.unwrap(http_client.read(mut client, mut body)) != 3 {
        fail("read did not cross the split chunk delimiter")
    }
    let eof = result.unwrap(http_client.read(mut client, mut body)) == 0
    if !eof || body != string.as_bytes("llobye") || !http_client.reusable(client) {
        fail("chunked response did not deliver the sent payload and preserve reuse")
    }
    http_client.close(take client)
    let _ = take server_input
    true
}

// Queue each wire fragment before the client reads. The 9000-byte payload
// fragment exceeds the head buffer. The chunk delimiter spans two sends.
// expect: run http_client_direct_response_body(tasks) = true
fn http_client_direct_response_body(tasks: Tasks) -> bool waits {
    let (world, c) = sim.world.new(1, 0, 0)
    let (n, port) = provide.net(bytes 65536)
    let driver = task.spawn(tasks, bytes 65536, take world, response_clock)
    let server = task.spawn(tasks, bytes 4194304, ResponseNetwork(port: take port, clock: c), response_network)
    let passed = read_response_train(n, c)
    result.unwrap(task.join(take server))
    result.unwrap(task.join(take driver))
    passed
}

// TLS-2, TL10, TL11 and TL17. The loopback fixture checks every HTTP head and
// upload byte. It returns a chunked "world", "ok" to a form body whose
// Content-Length counts two form-encoded secrets (the second ends the body),
// "ok" to a chunk whose size counts one, then conflicting body framing. On a
// second connection a body secret sealed to beta.test, after a protected
// header granted to alpha.test, is Denied with no byte sent.
// expect: stdout "GET /reject\nAuthorization: Bearer [secret]\nX-Trace: enabled\nX-Second: [secret]\n"
// expect: stderr "BodyFraming\nGET /reject\nAuthorization: Bearer [secret]\nX-Trace: enabled\nX-Second: [secret]\n"
// expect: run http_client_https_round_trip(https) = true
fn http_client_https_round_trip(n: Net, c: Clock, address: Addr, token: Secret, out: Stdout, err: Stderr) -> bool waits {
    let end = 18446744073709551615u64
    let upload = http_client.Request(method: "POST", target: "/upload", headers: list.new(), body: Fixed(5))
    let mut client = result.unwrap(http_client.https(n, address, "alpha.test", "alpha.test", System, c, upload, end))
    result.unwrap(http_client.write(mut client, string.as_bytes("hello")))
    if !post_echo(mut client, "world") {
        return false
    }
    // Every byte form-urlencoding changes: a+b%2Bc%26d%3De%25f%FF.
    let mut odd = string.into_bytes("a b+c&d=e%f")
    list.push(mut odd, 255u8)
    let client_secret = result.unwrap(secret.seal(take odd, "tls_send(alpha.test)"))
    let mut form: List[http_client.Segment] = list.new()
    list.push(mut form, Plain(string.into_bytes("grant_type=refresh_token&refresh_token=")))
    list.push(mut form, Sealed(secret.share(token), Form))
    list.push(mut form, Plain(string.into_bytes("&client_secret=")))
    list.push(mut form, Sealed(secret.share(client_secret), Form))
    let mut form_fields: List[http_client.Header] = list.new()
    list.push(mut form_fields, http_client.Header(name: "Content-Type", value: Public(string.into_bytes("application/x-www-form-urlencoded"))))
    let refresh = http_client.Request(method: "POST", target: "/token", headers: take form_fields, body: Segments(take form))
    result.unwrap(http_client.start(mut client, refresh, end))
    if !post_echo(mut client, "ok") {
        return false
    }
    let chunked = http_client.Request(method: "POST", target: "/chunk", headers: list.new(), body: Chunked)
    result.unwrap(http_client.start(mut client, chunked, end))
    let mut chunk: List[http_client.Segment] = list.new()
    list.push(mut chunk, Plain(string.into_bytes("v=")))
    list.push(mut chunk, Sealed(secret.share(client_secret), Form))
    result.unwrap(http_client.write_segments(mut client, chunk))
    if !post_echo(mut client, "ok") {
        return false
    }
    // Protected header with a plain-only Segments body (fetch/fetch_all POST shape).
    let mut auth_json_fields: List[http_client.Header] = list.new()
    list.push(mut auth_json_fields, http_client.Header(name: "Authorization", value: Protected(string.into_bytes("Bearer "), secret.share(token))))
    list.push(mut auth_json_fields, http_client.Header(name: "Content-Type", value: Public(string.into_bytes("application/json"))))
    let mut auth_json_body: List[http_client.Segment] = list.new()
    list.push(mut auth_json_body, Plain(string.into_bytes("{\"ok\":")))
    list.push(mut auth_json_body, Plain(string.into_bytes("true}")))
    let auth_json = http_client.Request(method: "POST", target: "/json", headers: take auth_json_fields, body: Segments(take auth_json_body))
    result.unwrap(http_client.start(mut client, auth_json, end))
    if !post_echo(mut client, "ok") {
        return false
    }
    let mut fields: List[http_client.Header] = list.new()
    let bearer = string.into_bytes("Bearer ")
    let enabled = string.into_bytes("enabled")
    list.push(mut fields, http_client.Header(name: "Authorization", value: Protected(take bearer, secret.share(token))))
    list.push(mut fields, http_client.Header(name: "X-Trace", value: Public(take enabled)))
    list.push(mut fields, http_client.Header(name: "X-Second", value: Protected(list.new(), secret.share(token))))
    let request = http_client.Request(method: "GET", target: "/reject", headers: take fields, body: Fixed(0))
    result.unwrap(http_client.start(mut client, request, end))
    let mut description: Bytes = list.with_capacity(256)
    result.unwrap(http_client.render_request(mut description, request))
    result.unwrap(stdout.write(out, result.unwrap(string.from_utf8(take description))))
    let failure: http_client.Error = match http_client.finish_request(mut client, 128) {
        Error(BodyFraming) => BodyFraming,
        _ => return false,
    }
    let mut rendered: Bytes = list.with_capacity(256)
    result.unwrap(http_client.render_error(mut rendered, failure, request))
    let message = result.unwrap(string.from_utf8(take rendered))
    let events: Log[String] = log.new()
    log.append(events, take message)
    let entries = log.finish(take events)
    result.unwrap(stderr.write(err, entries[0]))
    http_client.close(take client)
    let other = result.unwrap(secret.seal(string.into_bytes("other"), "tls_send(beta.test)"))
    let mut refused_fields: List[http_client.Header] = list.new()
    list.push(mut refused_fields, http_client.Header(name: "Authorization", value: Protected(string.into_bytes("Bearer "), secret.share(token))))
    let mut refused_body: List[http_client.Segment] = list.new()
    list.push(mut refused_body, Plain(string.into_bytes("k=")))
    list.push(mut refused_body, Sealed(secret.share(other), Raw))
    let refused = http_client.Request(method: "POST", target: "/token", headers: take refused_fields, body: Segments(take refused_body))
    let denied = match http_client.https(n, address, "alpha.test", "alpha.test", System, c, refused, end) {
        Error(Write(Denied)) => true,
        Ok(take connection) => {
            http_client.close(take connection)
            false
        },
        Error(_) => false,
    }
    list.len(entries) == 1 && denied
}

fn listen_with_budget(n: Net, c: Clock, tasks: Tasks, take cfg: http.Config, budget: u64) -> (Task[()], Addr) waits {
    let mut routes: router.Builder[EchoState] = router.builder()
    result.unwrap(router.add(mut routes, "GET", "/{tail...}", router.raw(echo)))
    result.unwrap(router.add(mut routes, "POST", "/{tail...}", router.raw(echo)))
    let addr = Addr(ip: V4(2130706433), port: 0)
    let (listener, where_to) = result.unwrap(host.listen(n, addr, 8))
    let job = TestServer(listener: take listener, c, tasks, cfg: take cfg, routes: result.unwrap(router.build(take routes)))
    (task.spawn(tasks, bytes budget, take job, test_server), where_to)
}

fn client_response(mut r: ReadHalf, mut received: Bytes, c: Clock, deadline: u64) -> (u16, u64, u64) waits {
    let mut h = http1.head()
    loop {
        match http1.response(received, mut h) {
            Complete => break,
            Partial => {},
            _ => return (0, 0, 0),
        }
        let max = list.capacity(received)
        match host.recv_bounded(mut r, mut received, max, At(c, deadline)) {
            Ok(0) => return (0, 0, 0),
            Ok(_) => {},
            Error(_) => return (0, 0, 0),
        }
    }
    let mut content_len: u64 = 0
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        if http1.equal_ascii(list.slice(received, f.name.start, f.name.end), string.as_bytes("Content-Length")) {
            if let Ok(n) = int.parse_decimal_span(received, f.value.start, f.value.end, 65536) {
                content_len = n
            }
        }
    }
    while list.len(received) < h.end + content_len {
        let max = list.capacity(received)
        match host.recv_bounded(mut r, mut received, max, At(c, deadline)) {
            Ok(0) => return (0, 0, 0),
            Ok(_) => {},
            Error(_) => return (0, 0, 0),
        }
    }
    (h.status, h.end, h.end + content_len)
}

// HTTP-6/HTTP-7. A connection that starts with a bodyless request must still
// materialize body scratch for a later body read (under handler_bytes < 8192),
// and a fresh connection must materialize it for an unread body drain while
// preserving the pipelined next request.
// expect: run http_lazy_scratch_read_and_drain(network) = true
fn http_lazy_scratch_read_and_drain(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (server, addr) = listen_for_law(n, c, tasks, test_config())
    let until = after_ms(host.mono_ns(c), 90)
    let (r, w) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut input = take r
    let mut output = take w
    if empty_get(mut output, mut input, string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\n\r\n"), c, until) != 200 {
        return false
    }
    let post_head = string.as_bytes("POST /echo HTTP/1.1\r\nHost: a\r\nContent-Length: 10\r\nExpect: 100-continue\r\n\r\n")
    if !client_send(mut output, post_head, At(c, until)) {
        return false
    }
    let mut received: Bytes = list.with_capacity(512)
    if client_head(mut input, mut received, c, until) != 100 {
        return false
    }
    if !client_send(mut output, string.as_bytes("0123456789"), At(c, until)) {
        return false
    }
    list.clear(mut received)
    let (st1, b1_start, b1_end) = client_response(mut input, mut received, c, until)
    if st1 != 200 || list.slice(received, b1_start, b1_end) != string.as_bytes("0123456789") {
        return false
    }
    let chunked_head = string.as_bytes("POST /echo HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n")
    if !client_send(mut output, chunked_head, At(c, until)) {
        return false
    }
    host.sleep_until(c, after_ms(host.mono_ns(c), 2))
    if !client_send(mut output, string.as_bytes("5\r\nhello\r\n0\r\n\r\n"), At(c, until)) {
        return false
    }
    list.clear(mut received)
    if !client_end(mut input, mut received, At(c, until)) {
        return false
    }
    let mut h = http1.head()
    if http1.response(received, mut h) != Complete || h.status != 200 || list.slice(received, h.end, list.len(received)) != string.as_bytes("hello") {
        return false
    }
    let (r2, w2) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut drain_in = take r2
    let mut drain_out = take w2
    // L5 allows two drain reads with this drain_max. Two unread bytes fit
    // even when the pipe returns one byte per read.
    let skip_head = string.as_bytes("POST /skip HTTP/1.1\r\nHost: a\r\nContent-Length: 2\r\n\r\n")
    if !client_send(mut drain_out, skip_head, At(c, until)) {
        return false
    }
    list.clear(mut received)
    let (st2, _, _) = client_response(mut drain_in, mut received, c, until)
    if st2 != 200 {
        return false
    }
    let tail = string.as_bytes("abGET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    if !client_send(mut drain_out, tail, At(c, until)) {
        return false
    }
    list.clear(mut received)
    if !client_end(mut drain_in, mut received, At(c, until)) {
        return false
    }
    let mut h2 = http1.head()
    http1.response(received, mut h2) == Complete && h2.status == 200 && h2.end == list.len(received)
}

// HTTP-1/MEM-24. Each connection reserves C = read(32768) + out(128) +
// scratch(8192) + J/reply(1272) + handler(4096) = 46456, plus T(0) = 288 and
// Completion = 72, so 46816 per connection. With supervisor fixed overhead
// (~10094), a budget of 99600 admits one bodyless connection and refuses a
// second concurrent bodyless connection with 503 (short by ~4126, less than
// 8192), while 105000 admits both.
// expect: run http_bodyless_connection_admission_budget(network) = true
fn http_bodyless_connection_admission_budget(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let until = after_ms(host.mono_ns(c), 90)
    let req = string.as_bytes("GET / HTTP/1.1\r\nHost: a\r\n\r\n")
    let (tight_server, tight_addr) = listen_with_budget(n, c, tasks, test_config(), 99600)
    let (r1, w1) = net.split(result.unwrap(host.connect(n, tight_addr, Never)))
    let mut in1 = take r1
    let mut out1 = take w1
    if empty_get(mut out1, mut in1, req, c, until) != 200 {
        return false
    }
    let (r2, w2) = net.split(result.unwrap(host.connect(n, tight_addr, Never)))
    let mut in2 = take r2
    let mut received: Bytes = list.with_capacity(512)
    if !client_end(mut in2, mut received, At(c, until)) {
        return false
    }
    let mut h = http1.head()
    if http1.response(received, mut h) != Complete || h.status != 503 {
        return false
    }
    let (room_server, room_addr) = listen_with_budget(n, c, tasks, test_config(), 105000)
    let (r3, w3) = net.split(result.unwrap(host.connect(n, room_addr, Never)))
    let mut in3 = take r3
    let mut out3 = take w3
    if empty_get(mut out3, mut in3, req, c, until) != 200 {
        return false
    }
    let (r4, w4) = net.split(result.unwrap(host.connect(n, room_addr, Never)))
    let mut in4 = take r4
    let mut out4 = take w4
    empty_get(mut out4, mut in4, req, c, until) == 200
}

// HTTP-7/MEM-24. After a body read materializes the 8192 B scratch under
// handler_bytes = 4096, closing must release scratch before net.finish
// allocates its own 8192 B linger scratch (only 5368 B remain otherwise),
// and exiting must refund the full connection budget for the next socket.
// expect: run http_body_scratch_release_and_linger(network) = true
fn http_body_scratch_release_and_linger(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let mut cfg = test_config()
    cfg.sockets_max = 1
    cfg.http_max = 1
    cfg.conns_max = 1
    cfg.ip_sockets_max = 1
    cfg.linger_ms = 10
    let (server, addr) = listen_with_budget(n, c, tasks, take cfg, 58000)
    let until = after_ms(host.mono_ns(c), 90)
    let (r1, w1) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut in1 = take r1
    let mut out1 = take w1
    let post = string.as_bytes("POST /echo HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n")
    if !client_send(mut out1, post, At(c, until)) {
        return false
    }
    let mut received: Bytes = list.with_capacity(512)
    if client_head(mut in1, mut received, c, until) != 100 || !client_send(mut out1, string.as_bytes("hello"), At(c, until)) {
        return false
    }
    list.clear(mut received)
    if !client_end(mut in1, mut received, At(c, until)) {
        return false
    }
    let mut h1 = http1.head()
    if http1.response(received, mut h1) != Complete || h1.status != 200 || list.slice(received, h1.end, list.len(received)) != string.as_bytes("hello") {
        return false
    }
    let closed_at = host.mono_ns(c)
    // Peer write half out1 is still open, so net.finish must linger for 10 ms.
    let (rb, wb) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut busy_in = take rb
    list.clear(mut received)
    if !client_end(mut busy_in, mut received, At(c, until)) {
        return false
    }
    let mut hb = http1.head()
    if http1.response(received, mut hb) != Complete || hb.status != 503 {
        return false
    }
    host.sleep_until(c, after_ms(closed_at, 14))
    let (r2, w2) = net.split(result.unwrap(host.connect(n, addr, Never)))
    let mut in2 = take r2
    let mut out2 = take w2
    if !client_send(mut out2, post, At(c, until)) {
        return false
    }
    list.clear(mut received)
    if client_head(mut in2, mut received, c, until) != 100 || !client_send(mut out2, string.as_bytes("world"), At(c, until)) {
        return false
    }
    list.clear(mut received)
    if !client_end(mut in2, mut received, At(c, until)) {
        return false
    }
    let mut h2 = http1.head()
    http1.response(received, mut h2) == Complete && h2.status == 200 && list.slice(received, h2.end, list.len(received)) == string.as_bytes("world")
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

type FetchPoolPeer: send {
    listener: Listener,
    clock: Clock,
    count: u64,
    stop: Receiver[()]
}

fn fetch_pool_peer(take input: FetchPoolPeer) -> bool waits {
    let FetchPoolPeer(listener: take listener, clock, count, stop: take stop) = take input
    let mut site = take listener
    let (socket, _) = result.unwrap(host.accept(mut site, Never))
    let (rx, tx) = net.split(take socket)
    let mut incoming = take rx
    let mut outgoing = take tx
    let until = At(clock, after_ms(host.mono_ns(clock), 2000))
    let expected = b"GET /pool HTTP/1.1\r\n"
    let mut request: Bytes = list.with_capacity(1024)
    for i in 0u64 .. count {
        let mut h = http1.head()
        loop {
            if http1.request(request, mut h) == Complete {
                break
            }
            let spare = 1024 - list.len(request)
            if result.unwrap(host.recv_bounded(mut incoming, mut request, spare, until)) == 0 {
                return false
            }
        }
        if h.end != list.len(request) || list.slice(request, 0, list.len(expected)) != expected {
            return false
        }
        list.clear(mut request)
        if !client_send(mut outgoing, b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", until) {
            return false
        }
    }
    let signal = take stop
    let _ = channel.receive(signal)
    result.unwrap(host.recv_bounded(mut incoming, mut request, 1024, until)) == 0
}

fn fetch_pool_fixture(n: Net, c: Clock, tasks: Tasks, count: u64) -> (Task[bool], Sender[()], Addr, http_client.Fetch) waits {
    let (listener, address) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 2))
    let (signal, receive): (Sender[()], Receiver[()]) = channel.new(1)
    let server = task.spawn(tasks, bytes 65536, FetchPoolPeer(listener: take listener, clock: c, count, stop: take receive), fetch_pool_peer)
    let mut url = string.from("http://127.0.0.1:")
    string.push_u64(mut url, int.widen(address.port))
    string.push(mut url, "/pool")
    let request = http_client.Fetch(method: "GET", url: take url, headers: list.new(), body: list.new())
    (take server, take signal, address, take request)
}

fn fetch_room() -> u64 {
    let probe = bound bytes 0xffffffffffffffffu64 {
        ()
    }
    match probe {
        Error(c) => c.available,
        Ok(()) => fail("capacity probe admitted"),
    }
}

fn empty_fetch(cl: http_client.Client, req: http_client.Fetch, end: u64) waits {
    let mut reply = result.unwrap(http_client.fetch(cl, req, end))
    let mut sink: Bytes = list.with_capacity(8)
    if result.unwrap(http_client.fetch_read(mut reply, mut sink)) != 0 {
        fail("expected an empty body")
    }
}

// HTTP-18 / MEM-20. A handler that exits while its connection is parked leaves
// no charge behind: the connection, its lease and its origin key are the pool's.
// The peer accepts once, so the second handler reuses the parked connection.
// expect: run http_fetch_pool_parked_handler(network) = true
fn http_fetch_pool_parked_handler(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (peer, signal, _, request) = fetch_pool_fixture(n, c, tasks, 2)
    let before = fetch_room()
    let p = result.unwrap(http_client.pool(n, c, tasks, System, http_client.limits(1024)))
    let cl = http_client.handle(p)
    let pooled = fetch_room()
    let end = after_ms(host.mono_ns(c), 2000)
    result.unwrap(bound bytes 131072 {
        empty_fetch(cl, request, end)
    })
    let first = fetch_room()
    result.unwrap(bound bytes 131072 {
        empty_fetch(cl, request, end)
    })
    let second = fetch_room()
    let _ = take cl
    let _ = take p
    let after = fetch_room()
    let stop = take signal
    result.unwrap(channel.send(stop, ()))
    result.unwrap(task.join(take peer)) && before > pooled && first == pooled && second == pooled && after == before
}

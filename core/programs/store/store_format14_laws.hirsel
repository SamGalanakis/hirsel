fn current_manifest_vector_law() -> Result[(), Error] {
    let path = "MANIFEST"
    let id = StoreId(hi: 1, lo: 2)
    // A Format 12 MANIFEST is refused with Unsupported(12).
    match disk_read_page_manifest(path, format12_manifest()) {
        Error(Unsupported(12)) => (),
        _ => return Error(Foreign),
    }
    let mut retired = current_manifest_vector()
    list.set_word_le(mut retired, 24, 13u32)
    list.set_word_le(mut retired, 8, 0x385c623e93bae484u64)
    match disk_read_page_manifest(path, retired) {
        Error(Unsupported(13)) => (),
        _ => return Error(Foreign),
    }
    list.set_word_le(mut retired, 24, 14u32)
    list.set_word_le(mut retired, 8, 0x327c4caf22dd8b88u64)
    match disk_read_page_manifest(path, retired) {
        Error(Unsupported(14)) => (),
        _ => return Error(Foreign),
    }
    let mut m = manifest.page_manifest_empty(limits_to_rep(default_limits()))
    m.next_stamp = 100
    m.next_pack = 50
    m.first_live = 7
    m.prev_first = 3
    m.account_memory = 37
    m.account_tiered = 83
    m.lineage = std.page.PagePtr(pack: 3, offset: 80, len: 111, checksum: 12, stamp: 41)
    m.deferred_frees = std.page.PagePtr(pack: 4, offset: 90, len: 112, checksum: 13, stamp: 42)
    m.deferred_next = 55
    m.sweep = manifest.SweepCursor(position: 88, epoch: 99, digest: 101)
    let roots: pages.LocatedRoots = clone(m.branches[0].roots)
    list.push(mut m.pins, manifest.LocatedPin(owner: ProjectorPin, name: "p", branch: 0, version: 9, roots: roots, watermark: 92))
    let raw = failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), m))?
    if raw != current_manifest_vector() {
        return Error(Foreign)
    }
    let (_, take parsed) = disk_read_page_manifest(path, raw)?
    if manifest.manifest_account(parsed) != 120 || parsed.account_memory != 37 || parsed.account_tiered != 83 || parsed.lineage != m.lineage || parsed.deferred_frees != m.deferred_frees || parsed.deferred_next != 55 || parsed.sweep.position != 88 || parsed.sweep.epoch != 99 || parsed.sweep.digest != 101 || parsed.pins[0].owner != ProjectorPin || parsed.pins[0].watermark != 92 || failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), parsed))? != raw {
        return Error(Foreign)
    }
    let payload = list.slice(raw, 88, list.len(raw))
    if !disk_corrupt(failure_result_from_rep(manifest.decode_page_manifest(path, list.slice(payload, 0, list.len(payload) - 1), 1))) {
        return Error(Foreign)
    }
    let mut invalid_owner = failure_result_from_rep(types.copied(payload))?
    invalid_owner[383] = 0
    if !disk_corrupt(failure_result_from_rep(manifest.decode_page_manifest(path, invalid_owner, 1))) {
        return Error(Foreign)
    }
    let mut bound_payload = failure_result_from_rep(types.copied(payload))?
    list.set_word_le(mut bound_payload, 160, 0x0123456789abcdefu64)
    let bound_parsed = failure_result_from_rep(manifest.decode_page_manifest(path, bound_payload, 1))?
    if bound_parsed.binding_id != 0x0123456789abcdefu64 {
        return Error(Foreign)
    }
    let mut bound_manifest: manifest.PageManifest = clone(m)
    bound_manifest.binding_id = 0x0123456789abcdefu64
    let bound_raw = failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), bound_manifest))?
    let (_, take bound_roundtrip) = disk_read_page_manifest(path, bound_raw)?
    if bound_roundtrip.binding_id != 0x0123456789abcdefu64 {
        return Error(Foreign)
    }
    let token = format.RestoreBoundary(source_kind: 0, base_ordinal: 8, base_digest: 71, unit: 12, epoch: 0, unit_digest: 72, frame_end: 300)
    bound_manifest.origin = Some(manifest.RestoreOrigin(parent: types.StoreKey(hi: 3, lo: 4), binding_id: 0, branch: 2, version: 9, at: 100, boundary: token, attempt: [7; 16], capture_attempt: [19; 16], intent: Successor))
    let child_raw = failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), bound_manifest))?
    let (_, take child) = disk_read_page_manifest(path, child_raw)?
    let Some(origin) = child.origin else {
        fail("a restored MANIFEST lost RESTORE_ORIGIN")
    }
    if list.len(child_raw) != list.len(bound_raw) + 166 || origin.parent != types.StoreKey(hi: 3, lo: 4) || origin.binding_id != 0 || origin.branch != 2 || origin.version != 9 || origin.at != 100 || origin.boundary != token || origin.attempt !=[7u8; 16] || origin.capture_attempt !=[19u8; 16] {
        fail("RESTORE_ORIGIN changed its parent, selected transition or attempt")
    }
    let mut overflow = failure_result_from_rep(types.copied(payload))?
    list.set_word_le(mut overflow, 64, 18446744073709551615u64)
    if !disk_corrupt(failure_result_from_rep(manifest.decode_page_manifest(path, overflow, 1))) {
        return Error(Foreign)
    }
    Ok(())
}

fn format14_pack_row_law() -> Result[(), Error] {
    let expected: Inline[u8, 30] =[4, 2, 0, 0, 0, 82, 4, 0, 0, 0, 0, 0, 0, 58, 6, 0, 0, 0, 0, 0, 0, 220, 5, 0, 0, 0, 0, 0, 0, 0]
    let mut raw: Bytes = list.with_capacity(30)
    for byte in expected {
        list.push(mut raw, byte)
    }
    let pack = failure_result_from_rep(manifest.pack_record("p-6", 72, raw))?
    if pack.class != 4 || pack.frames != 2 || pack.live != 1106 || pack.payload_bytes != 1594 || pack.index != 1500 || manifest.encode_pack_row(pack) != raw {
        return Error(Foreign)
    }
    let _ = list.set(mut raw, 0, 0u8)
    if !disk_corrupt(failure_result_from_rep(manifest.pack_record("p-6", 72, raw))) || !disk_corrupt(failure_result_from_rep(manifest.pack_record("p-6", 72, list.slice(raw, 0, 21)))) {
        return Error(Foreign)
    }
    Ok(())
}

fn format14_index_law() -> Result[(), Error] {
    let path = "p-6"
    let id = StoreId(hi: 1, lo: 2)
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 3, seq: 6)
    let expected = format14_blob_index()
    let following_wire = format14_blob_index_next()
    let mut key: Bytes = list.new()
    list.put_word_be(mut key, 7u32)
    list.append(mut key, string.as_bytes("ax"))
    let mut other = failure_result_from_rep(types.copied(key))?
    let _ = list.set(mut other, 5, 121u8)
    let first = std.page.BlobRef(stamp: 17, len: 1025, checksum: 0, pack: 6, offset: 72, body: 0)
    let second = std.page.BlobRef(stamp: 19, len: 65, checksum: 0, pack: 6, offset: 1121, body: 1)
    let mut rows: List[manifest.PackIndexRow] = list.new()
    list.push(mut rows, manifest.blob_index_row(first, 7, failure_result_from_rep(types.copied(key))?))
    list.push(mut rows, manifest.blob_index_row(second, 7, failure_result_from_rep(types.copied(other))?))
    let mut out: Bytes = list.new()
    list.fill(mut out, 1500, 0u8)
    let at = failure_result_from_rep(manifest.append_pack_index(mut out, ctx, rows))?
    if at != 1500 || list.slice(out, at, list.len(out)) != expected {
        return Error(Foreign)
    }
    let second_at = list.len(out)
    let mut remaining: List[manifest.PackIndexRow] = list.new()
    let third = std.page.BlobRef(stamp: 21, len: 4, checksum: 0, pack: 6, offset: 1210, body: 2)
    list.push(mut remaining, manifest.blob_index_row(third, 7, failure_result_from_rep(types.copied(key))?))
    failure_result_from_rep(manifest.append_pack_index_frame(mut out, ctx, at, remaining, 0, 1, 47))?
    if list.slice(out, second_at, list.len(out)) != following_wire {
        return Error(Foreign)
    }
    let frame = failure_result_from_rep(manifest.disk_read_frame(path, ctx, out, at))?
    let payload = list.slice(out, frame.payload, frame.end)
    let mut final_item = 0u64
    let parsed = failure_result_from_rep(manifest.decode_pack_index(path, at, payload, mut final_item))?
    let tail = failure_result_from_rep(manifest.decode_pack_index(path, second_at, list.slice(following_wire, 16, list.len(following_wire)), mut final_item))?
    if frame.kind != 0x0023 || frame.flags != 1 || parsed.prev != 0 || list.len(parsed.rows) != 2 || parsed.rows[0].offset != 72 || parsed.rows[0].len != 1033 || parsed.rows[0].kind != 0x22 || parsed.rows[0].collection != 7 || parsed.rows[0].stamp != 17 || parsed.rows[0].key != key || parsed.rows[1].len != 73 || parsed.rows[1].key != other || tail.prev != at || tail.rows[0].key != key || final_item != 1210 {
        return Error(Foreign)
    }
    let mut corrupt = failure_result_from_rep(types.copied(payload))?
    let _ = list.set(mut corrupt, 37, 1u8)
    final_item = 0
    if !disk_corrupt(failure_result_from_rep(manifest.decode_pack_index(path, at, corrupt, mut final_item))) || !disk_corrupt(failure_result_from_rep(manifest.decode_pack_index(path, at, list.slice(payload, 0, list.len(payload) - 1), mut final_item))) {
        return Error(Foreign)
    }
    final_item = 72
    if !disk_corrupt(failure_result_from_rep(manifest.decode_pack_index(path, at, payload, mut final_item))) {
        return Error(Foreign)
    }
    let page_ctx = format.DiskContext(store: store_key_to_rep(id), role: 3, seq: 7)
    let ptr = std.page.PagePtr(pack: 7, offset: 72, len: 47, checksum: 0, stamp: 23)
    let mut page_key: Bytes = list.new()
    list.put_word_be(mut page_key, 9u32)
    list.push(mut page_key, 122u8)
    let mut page_rows: List[manifest.PackIndexRow] = list.new()
    list.push(mut page_rows, manifest.page_index_row(ptr, 9, take page_key))
    let mut page_out: Bytes = list.new()
    list.fill(mut page_out, 135, 0u8)
    let page_at = failure_result_from_rep(manifest.append_pack_index(mut page_out, page_ctx, page_rows))?
    if page_at != 135 || list.slice(page_out, page_at, list.len(page_out)) != format14_page_index() {
        return Error(Foreign)
    }
    Ok(())
}

@test
fn disk_test_format14() -> Result[(), Error] {
    current_manifest_vector_law()?
    format14_pack_row_law()?
    format14_index_law()
}

// Format 15 references resolve through corpus_directory_files, the same bytes
// used by test_frozen_format_corpus. Regenerate with fixtures.py rows store-format15 --write.
const REVIEWED_STORE_FORMAT15: String = "accepted-blob-index accepted 4 010000000000000000000000480000000000000011000000220b0000001100000000000000000015000000000b0200000000000000050000000000000001 05000000000000003e00000000000000000000000000000048000000000000004800000011220000000b00000000000000110000000b0200000000000000050000000000000001 -\naccepted-direct-blob-op4 accepted 2 000000000000000000000000000000000000000001000100000004150000000000000b020000000000000005000000000000000100000000110000000000000009000000000000001300000000000000060000000000000048000000000000000000000000000000b7000000000000001600000000000000 0300000000000000780000000000000000000000000000000000000000000000110000000000000009000000000000001300000000000000060000000000000048000000000000000000000000000000b700000000000000160000000b0200000000000000050000000000000001 -\naccepted-foreign-pack-row accepted 1 04010000001100000000000000b700000000000000690000000000000001030000000000000004000000000000000102030405060708090a0b0c0d0e0f100700000000000000b7000000000000001600000000000000 020400000001000000000000001100000000000000b70000000000000069000000000000000300000000000000040102030405060708090a0b0c0d0e0f10000000000000000700000000000000b70000000000000016 -\naccepted-local-pack-row accepted 1 04010000001100000000000000b700000000000000690000000000000000 010400000001000000000000001100000000000000b70000000000000069 -\naccepted-manifest-identity accepted 0 @directory/MANIFEST 00000000000000000f00000000000002f2956df45cbf4b7ef6413dd10b3e66528200000000000000050000000000000267000000000000000b0000000000000005 -\naccepted-page-index accepted 3 @directory/p-8 040000000000000164000000000000000000000000000000480000000000000048000000bf210000000200000000000002580000000200000000000000000000000000000000 -\nrefused-invalid-pack-tag malformed 1 04010000001100000000000000b700000000000000690000000000000002 0000000000000000 -\nrefused-short-direct-descriptor truncated 2 000000000000000000000000000000000000000001000100000004150000000000000b020000000000000005000000000000000100000000110000000000000009000000000000001300000000000000060000000000000048000000000000000000000000000000b70000000000000016000000000000 0000000000000038 -\nrefused-short-manifest truncated 0 0100 0000000000000000 -\n"

fn reviewed_store_input(field: String) -> Bytes {
    if string.starts_with(field, "@directory/") {
        let name = string.slice(field, 11, string.byte_len(field))
        for (file, raw) in corpus_directory_files() {
            if file == name {
                return clone(raw)
            }
        }
        fail("unknown reviewed Format 15 reference")
    }
    option.unwrap(std.hex.decode(string.as_bytes(field)))
}

fn reviewed_store_pack(raw: Bytes) -> Result[Bytes, types.Failure] {
    let p = manifest.pack_record("pack row", 0, raw)?
    let mut shown: Bytes = list.new()
    list.push(mut shown, if p.foreign == None {
        1u8
    } else {
        2u8
    })
    list.push(mut shown, p.class)
    list.put_word_be(mut shown, p.frames)
    list.put_word_be(mut shown, p.live)
    list.put_word_be(mut shown, p.payload_bytes)
    list.put_word_be(mut shown, p.index)
    if let Some(parent) = p.foreign {
        list.put_word_be(mut shown, parent.parent.hi)
        list.put_word_be(mut shown, parent.parent.lo)
        for byte in parent.incarnation {
            list.push(mut shown, byte)
        }
        list.put_word_be(mut shown, parent.epoch)
        list.put_word_be(mut shown, parent.len)
        list.put_word_be(mut shown, parent.digest)
    }
    if manifest.encode_pack_row(p) != raw {
        fail("reviewed Format 15 pack row did not re-encode")
    }
    Ok(take shown)
}

fn reviewed_store_direct(raw: Bytes) -> Result[Bytes, types.Failure] {
    let path = "direct COMMIT"
    let mut ops = format.capture_data_ops(path, raw)?
    let Some(CaptureDirect(key_at, key_len, prior, d)) = format.capture_next_op(path, raw, 1024, mut ops)? else {
        fail("reviewed Format 15 COMMIT lacked op 4")
    }
    if ops.at != list.len(raw) || ops.left != 0 {
        fail("reviewed Format 15 op 4 consumed a different span")
    }
    let mut shown: Bytes = list.new()
    list.push(mut shown, 3u8)
    list.put_word_be(mut shown, ops.at)
    list.put_word_be(mut shown, ops.left)
    list.put_word_be(mut shown, prior)
    for value in[d.stamp, d.len, d.checksum, d.pack, d.offset, d.epoch, d.pack_len, d.digest] {
        list.put_word_be(mut shown, value)
    }
    list.append(mut shown, list.slice(raw, key_at, key_at + key_len))
    Ok(take shown)
}

fn reviewed_store_index(raw: Bytes, page_pack: bool) -> Result[Bytes, types.Failure] {
    let mut at = 105u64
    let payload = if page_pack {
        let header = manifest.disk_read_header("p-8", raw, 3, Some(8), None)?
        at = 279
        let frame = manifest.disk_read_frame("p-8", header.context, raw, at)?
        if frame.kind != 0x23 || frame.end != list.len(raw) {
            fail("reviewed Format 15 PAGE pack index frame")
        }
        list.slice(raw, frame.payload, frame.end)
    } else {
        list.slice(raw, 0, list.len(raw))
    }
    let mut last_row = 0u64
    let decoded_index = manifest.decode_pack_index("PACK_INDEX", at, payload, mut last_row)?
    if list.len(decoded_index.rows) != 1 {
        fail("reviewed Format 15 pack index row count")
    }
    let row = decoded_index.rows[0]
    let mut shown: Bytes = list.new()
    list.push(mut shown, if page_pack {
        4u8
    } else {
        5u8
    })
    list.put_word_be(mut shown, list.len(raw))
    list.put_word_be(mut shown, decoded_index.prev)
    list.put_word_be(mut shown, last_row)
    list.put_word_be(mut shown, row.offset)
    list.put_word_be(mut shown, row.len)
    list.push(mut shown, row.kind)
    list.put_word_be(mut shown, row.collection)
    list.put_word_be(mut shown, row.stamp)
    list.append(mut shown, row.key)
    Ok(take shown)
}

fn reviewed_store_decode(surface: u8, raw: Bytes) -> Result[Bytes, types.Failure] {
    match surface {
        0 => {
            let (id, take m) = manifest.disk_read_page_manifest("MANIFEST", raw)?
            let mut shown: Bytes = list.new()
            list.push(mut shown, 0u8)
            for value in[format.DISK_FORMAT, list.len(raw), id.hi, id.lo, m.generation, m.next_stamp, m.next_pack, m.first_live] {
                list.put_word_be(mut shown, value)
            }
            Ok(take shown)
        },
        1 => reviewed_store_pack(raw),
        2 => reviewed_store_direct(raw),
        3 => reviewed_store_index(raw, true),
        4 => reviewed_store_index(raw, false),
        _ => fail("unknown reviewed Format 15 decoder"),
    }
}

fn reviewed_store_case(surface: String, raw: Bytes) -> (String, Bytes) {
    match reviewed_store_decode(string.as_bytes(surface)[0] - 48, raw) {
        Ok(take observed_bytes) => ("accepted", take observed_bytes),
        Error(Corrupt(fault)) => {
            let class = match fault.why {
                Truncated => "truncated",
                Malformed => "malformed",
                _ => fail("unexpected reviewed Format 15 corruption"),
            }
            let mut shown: Bytes = list.new()
            list.put_word_be(mut shown, fault.offset)
            (class, take shown)
        },
        Error(_) => fail("unexpected reviewed Format 15 refusal"),
    }
}

fn reviewed_store_field(row: String, mut at: u64) -> View[String] in row {
    let start = at
    let end = option.unwrap(string.find(row, start, " "))
    at = end + 1
    string.slice(row, start, end)
}

fn reviewed_store_matches(actual: String, observed_bytes: Bytes, expected: String, fields: Bytes) -> bool {
    actual == expected && observed_bytes == fields
}

/// bug: Report the same disposition for a different decoded family, field, cursor or refusal.
/// oracle: STORE-SPEC §§3.5 and 13.5 and the frozen Directory manifest and PAGE pack. The reviewed bundle supplies each expected observed_bytes.
@test
fn reviewed_store_format15() -> Result[(), ()] {
    let data = REVIEWED_STORE_FORMAT15
    let mut at = 0u64
    let mut completed = 0u64
    let mut accepted = 0u64
    let mut families = 0u64
    while at < string.byte_len(data) {
        let end = option.unwrap(string.find(data, at, "\n"))
        let row = string.slice(data, at, end)
        let mut column = 0u64
        let id = reviewed_store_field(row, mut column)
        let expected = reviewed_store_field(row, mut column)
        let surface = reviewed_store_field(row, mut column)
        let raw = reviewed_store_input(reviewed_store_field(row, mut column))
        let observed_bytes = reviewed_store_field(row, mut column)
        let fields = if observed_bytes == "-" {
            b""
        } else {
            option.unwrap(std.hex.decode(string.as_bytes(observed_bytes)))
        }
        let (class, take first) = reviewed_store_case(surface, raw)
        let (replayed, take second) = reviewed_store_case(surface, raw)
        if class != replayed || first != second || !reviewed_store_matches(class, first, expected, fields) {
            fail(string.from(id))
        }
        // Feed a wrong expectation through the same comparison.
        let wrong_fields = if expected == "accepted" {
            b""
        } else {
            fields
        }
        if reviewed_store_matches(class, first, "accepted", wrong_fields) {
            fail("wrong reviewed expectation matched")
        }
        completed += 1
        if class == "accepted" {
            accepted += 1
            let family: u64 = int.widen(first[0])
            families = families | (1u64 << family)
        }
        at = end + 1
    }
    if completed != 9 || accepted != 6 || families != 63 {
        fail("reviewed store decode counts or accepted families")
    }
    Ok(())
}

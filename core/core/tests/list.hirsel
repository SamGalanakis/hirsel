// list.fill laws (core.md): fill appends n copies of x after the existing elements.
// Elements are compared one by one against the spec, not with ==.
// n = 0 appends nothing: one element too many would show as a second element.
// expect: run fill_none() = true
fn fill_none() -> bool {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 5)
    list.fill(mut xs, 0, 9)
    list.len(xs) == 1 && xs[0] == 5
}

// n = 1 after a two-element prefix: [5, 6, 9].
// expect: run fill_one() = true
fn fill_one() -> bool {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 5)
    list.push(mut xs, 6)
    list.fill(mut xs, 1, 9)
    list.len(xs) == 3 && xs[0] == 5 && xs[1] == 6 && xs[2] == 9
}

// Every element after a one-element prefix equals x, for u8 and i32 (u64 is above), with
// a general value and with zero and all-ones (the values a lowering may turn into memset).
// Counts 37 and 13 cross the 16- and 32-byte store widths and leave tails; a stride or
// count mistake in a store loop puts a wrong value or length here.
// expect: run fill_each_width() = true
fn fill_each_width() -> bool {
    let mut b: Bytes = list.new()
    list.push(mut b, 3)
    list.fill(mut b, 37, 0xA5)
    list.fill(mut b, 37, 0)
    list.fill(mut b, 37, 0xFF)
    let mut ok = list.len(b) == 112 && b[0] == 3
    let mut i: u64 = 1
    while i < 112 {
        let want: u8 = if i < 38 {
            0xA5
        } else if i < 75 {
            0
        } else {
            0xFF
        }
        ok = ok && b[i] == want
        i += 1
    }
    let mut w: List[i32] = list.new()
    list.push(mut w, 4)
    list.fill(mut w, 13, -7)
    list.fill(mut w, 13, -1)
    ok = ok && list.len(w) == 27 && w[0] == 4
    i = 1
    while i < 27 {
        let want: i32 = if i < 14 {
            -7
        } else {
            -1
        }
        ok = ok && w[i] == want
        i += 1
    }
    ok
}

fn fill_plain[T: plain](mut xs: List[T], n: u64, x: T) {
    list.fill(mut xs, n, x)
}

// A tuple exercises the generic copy recipe, and a unit list needs no stores.
// expect: run fill_generic_plain() = true
fn fill_generic_plain() -> bool {
    let mut xs: List[(u8, u64)] = list.new()
    fill_plain(mut xs, 3, (7u8, 91u64))
    let mut units: List[()] = list.new()
    fill_plain(mut units, 999, ())
    let mut ok = list.len(xs) == 3 && list.len(units) == 999
    let mut i: u64 = 0
    while i < 3 {
        let (a, b) = xs[i]
        ok = ok && a == 7 && b == 91
        i += 1
    }
    let mut scalars: List[u64] = list.new()
    fill_plain(mut scalars, 2, 42u64)
    ok && scalars[0] == 42 && scalars[1] == 42
}

// The length bound (SEM-4, MEM-22, MEM-24): storage is charged round8(capacity × size(T))
// in exact arithmetic, and a charge past 2^64 − 1 is refused with requested 2^64 − 1. So no
// List[T] of logical size s >= 2 holds more than (2^64 − 8) / s elements, which engines
// may assume (FORM #113).
// A product computed in wrapping u64 arithmetic would admit 2^61 u64s as 0 bytes here.
// 2^61 − 1 u64s charge exactly 2^64 − 8, refused against the 64 bytes of the scope.
// engine-fact: List len and capacity ranges (core-form-883 FORM #113, LLVM !range)
// expect: run length_bound_refused() = true
fn length_bound_refused() -> bool {
    let mut xs: List[u64] = list.new()
    let grown = bound bytes 64 {
        list.try_reserve(mut xs, 18446744073709551615)
    }
    maximal(isolate(fn() -> Result[List[u64], Capacity] {
        bound bytes 64 {
            list.with_capacity(2305843009213693952)
        }
    })) && match refusal(isolate(fn() -> Result[List[u64], Capacity] {
        bound bytes 64 {
            list.with_capacity(2305843009213693951)
        }
    })) {
        Some(c) => c.requested == 18446744073709551608 && c.available == 64,
        None => false,
    } && maximal(isolate(fn() -> Result[List[(u64, u64)], Capacity] {
        bound bytes 64 {
            list.with_capacity(1152921504606846976)
        }
    })) && maximal(isolate(fn() -> Result[u64, Capacity] {
        bound bytes 64 {
            let mut ys: List[u64] = list.new()
            list.fill(mut ys, 2305843009213693952, 0)
            list.len(ys)
        }
    })) && match grown {
        Ok(Error(c)) => c.requested == 18446744073709551615 && c.available == 64,
        _ => false,
    } && list.len(xs) == 0 && list.capacity(xs) == 0
}

fn maximal[R](r: Result[Result[R, Causes], Capacity]) -> bool {
    match refusal(r) {
        Some(c) => c.requested == 18446744073709551615 && c.available == 64,
        None => false,
    }
}

// A tuple stride, a borrowed middle slice, and untouched destination sentinels.
// expect: run copy_from_slice_list() = true
fn copy_from_slice_list() -> bool {
    let mut src: List[(u8, u64)] = list.new()
    list.fill(mut src, 3, (4u8, 67u64))
    src[0] = (8u8, 3u64)
    src[2] = (6u8, 12u64)
    let mut dst: List[(u8, u64)] = list.new()
    list.fill(mut dst, 4, (10u8, 29u64))
    let capacity = list.capacity(dst)
    list.copy_from_slice(mut dst, 1, list.slice(src, 1, 3))
    list.copy_from_slice(mut dst, 4, (list.new() : List[(u8, u64)]))
    list.len(dst) == 4 && list.capacity(dst) == capacity && dst[0] == (10u8, 29u64) && dst[1] == (4u8, 67u64) && dst[2] == (6u8, 12u64) && dst[3] == (10u8, 29u64)
}

// expect: run copy_from_slice_inline_step() = true
fn copy_from_slice_inline_step() -> bool {
    let run = bound steps 1 {
        let mut dst: Inline[i32, 4] =[8, 7, 6, 5]
        let src: Inline[i32, 4] =[1, 2, 3, 4]
        inline.copy_from_slice(mut dst, 1, src, 2)
        dst[0] == 8 && dst[1] == 1 && dst[2] == 2 && dst[3] == 5
    }
    match run {
        Ok(valid) => valid,
        Error(_) => false,
    }
}

// expect: run copy_from_slice_overflow() = fail Bounds
fn copy_from_slice_overflow() -> bool {
    let src: Inline[u64, 2] =[3, 7]
    let mut dst: Inline[u64, 2] =[11, 13]
    inline.copy_from_slice(mut dst, 18446744073709551615, src, 2)
    dst[0] == 11
}

// Even without storage, an overwrite must fit the destination's live elements.
// expect: run copy_from_slice_unit_bounds() = fail Bounds
fn copy_from_slice_unit_bounds() -> bool {
    let mut src: List[()] = list.new()
    let mut dst: List[()] = list.new()
    list.fill(mut src, 2, ())
    list.fill(mut dst, 2, ())
    list.copy_from_slice(mut dst, 1, src)
    list.len(dst) == 2
}

// The words start one byte into the buffer. The reference bytes spell the
// numbers directly so matching read and write mistakes cannot cancel.
// expect: run word_widths_unaligned() = true
fn word_widths_unaligned() -> bool {
    let mut b: Bytes = list.with_capacity(22)
    list.push(mut b, 0xff)
    list.put_word_le(mut b, 0x0201u16)
    list.put_word_be(mut b, 0x0304u16)
    list.put_word_le(mut b, 0x08070605u32)
    list.put_word_be(mut b, 0x090a0b0cu32)
    list.put_word_be(mut b, 0x0d0e0f1011121314u64)
    let little16: u16 = list.word_le(b, 1)
    let big16: u16 = list.word_be(b, 3)
    let little32: u32 = list.word_le(b, 5)
    let big32: u32 = list.word_be(b, 9)
    let big64: u64 = list.word_be(b, 13)
    if list.len(b) != 21 || b[0] != 0xff {
        return false
    }
    for i in 1u64 .. 21 {
        if b[i] != int.truncate(i) {
            return false
        }
    }
    little16 == 0x0201 && big16 == 0x0304 && little32 == 0x08070605 && big32 == 0x090a0b0c && big64 == 0x0d0e0f1011121314
}

// With one byte left only a one-byte read would fit.
// expect: run word_widths_truncated() = fail Bounds
fn word_widths_truncated() -> u16 {
    list.word_be(string.as_bytes("abc"), 2)
}

// The original one-byte list charges eight. A two-byte append needs capacity
// four, also charged as eight, and there are zero bytes left to admit it.
// expect: run word_widths_capacity() = true
fn word_widths_capacity() -> bool {
    match refusal(isolate(fn() -> Result[(), Capacity] {
        bound bytes 8 {
            let mut b: Bytes = list.with_capacity(1)
            list.push(mut b, 0xa5)
            list.put_word_be(mut b, 0x1234u16)
        }
    })) {
        Some(c) => c.requested == 8 && c.available == 0,
        None => false,
    }
}

// Inline reads use the same unaligned byte positions.
// expect: run inline_word_widths() = true
fn inline_word_widths() -> bool {
    let raw: Inline[u8, 5] =[0xff, 1, 2, 3, 4]
    let little: u32 = inline.word_le(raw, 1)
    let big: u32 = inline.word_be(raw, 1)
    little == 0x04030201 && big == 0x01020304
}

// No start offset can fit a word in a zero-length byte array.
// expect: run inline_word_widths_empty() = fail Bounds
fn inline_word_widths_empty() -> u16 {
    let raw: Inline[u8, 0] =[0; 0]
    inline.word_le(raw, 0)
}

// The primary cause of a caught failure, when it is a refused admission.
fn refusal[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

fn refused_request[R](r: Result[Result[R, Causes], Capacity]) -> u64 {
    match refusal(r) {
        Some(c) => c.requested,
        None => 99,
    }
}

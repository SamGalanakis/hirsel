// Module `list` (SEM-4). Bytes is List[u8].
pub fn new[T]() -> List[T]

pub fn with_capacity[T](n: u64) -> Result[List[T], Capacity]

pub fn len[T](xs: List[T]) -> u64

pub fn capacity[T](xs: List[T]) -> u64

pub fn reserve[T](mut xs: List[T], n: u64) -> Result[(), Capacity]

pub fn get[T](xs: List[T], i: u64) -> Option[View[T]] in xs

pub fn slice[T](xs: List[T], lo: u64, hi: u64) -> View[List[T]] in xs

pub fn word_le(b: Bytes, at: u64) -> u64

// Append eight little-endian bytes; Capacity leaves the buffer unchanged.
pub fn put_word_le(mut b: Bytes, x: u64) -> Result[(), Capacity]

// The front expands push in place: a full test, a cold call to grow in its true
// arm (MEM-24 from needed = len + 1), then a store within capacity.
pub fn push[T](mut xs: List[T], take x: T) -> Result[(), (Capacity, T)]

// The full arm's growth as a function of its own: reserve is expanded where it
// is called, so only a call keeps it out of the caller.
fn grow[T](mut xs: List[T]) -> Result[(), Capacity] {
    reserve(mut xs, 1)
}

pub fn pop[T](mut xs: List[T]) -> Option[T]

pub fn set[T](mut xs: List[T], i: u64, take x: T) -> T

pub fn swap[T](mut xs: List[T], i: u64, j: u64)

pub fn clear[T](mut xs: List[T])

pub fn fill[T: plain](mut xs: List[T], n: u64, x: T) -> Result[(), Capacity]

pub fn append[T: plain](mut xs: List[T], ys: List[T]) -> Result[(), Capacity]

pub fn sum[T: integer](xs: List[T]) -> T {
    let mut t: T = int.narrow(0u8)
    for x in xs {
        let next: Option[T] = int.checked_add(t, x)
        match next {
            Some(v) => {
                t = v
            },
            None => {
                // Overflow, raised by a conversion that does not fit.
                let wide: u16 = 256
                let _: u8 = int.narrow(wide)
            },
        }
    }
    t
}

// Private uninhabited storage. len is the number of live slots, not a prefix.
// Callers must empty it before free or normalize it before ordinary cleanup.
// Sort aliases keep len0 on scratch; Hole alone tracks and restores its live set.
type Slots[T] {
    raw: List[T]
}

fn slots_empty[T]() -> Slots[T]

fn slots_new[T](n: u64) -> Result[Slots[T], Capacity]

fn slots_put[T](mut s: Slots[T], i: u64, take x: T)

fn slots_take[T](mut s: Slots[T], i: u64) -> T

fn slots_view[T](s: Slots[T], i: u64) -> View[T] in s

// Distinct mutable carriers. Updates both live counts.
fn slots_move[T](mut src: Slots[T], i: u64, mut dst: Slots[T], j: u64, n: u64)

// Same carrier, including i == j. Keeps its live count.
fn slots_shift[T](mut s: Slots[T], i: u64, j: u64)

fn slots_free[T](take s: Slots[T])

// Discard only a no-drop element ring; preserves evaluator liveness.
fn slots_forget_ring[T](mut s: Slots[T], head: u64)

// Stable natural merges, ordered by the first differing bit of adjacent
// run midpoints (Powersort, as used in Rust's driftsort).
pub fn sort_stable[T](mut xs: List[T], before: scoped fn(T, T) -> Order) -> Result[(), Capacity] {
    let n = list.len(xs)
    if n < 2 {
        return Ok(())
    }
    let scratch: Slots[T] = slots_new(n)?
    let mut g = Hole(xs: view xs, scratch: take scratch, state: empty_merge())
    let mut lo: u64 = 0
    let mut mid = sorted_run_end(mut g, lo, n, before)
    // Powers strictly increase up the stack. A u64 bit position has only 64 values.
    let mut starts: Inline[u64, 64] =[0; 64]
    let mut powers: Inline[u32, 64] =[0; 64]
    let mut depth: u64 = 0
    while mid < n {
        let end = sorted_run_end(mut g, mid, n, before)
        let left = lo + (mid - lo) / 2
        let right = mid + (end - mid) / 2
        let power = int.leading_zeros(left ^ right)
        while depth > 0 && powers[depth - 1] >= power {
            depth -= 1
            let earlier = starts[depth]
            merge_runs(mut g, earlier, lo, mid, before)
            lo = earlier
        }
        starts[depth] = lo
        powers[depth] = power
        depth += 1
        lo = mid
        mid = end
    }
    while depth > 0 {
        depth -= 1
        let earlier = starts[depth]
        merge_runs(mut g, earlier, lo, n, before)
        lo = earlier
    }
    let _ = take g
    Ok(())
}

fn precedes[T](a: T, b: T, before: scoped fn(T, T) -> Order) -> bool {
    match before(a, b) {
        Less => true,
        _ => false,
    }
}

fn sorted_run_end[T](mut g: Hole[T], lo: u64, n: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let mut end = lo + 1
    if end == n {
        return end
    }
    let descending = precedes(slots_list_view(g.xs, end), slots_list_view(g.xs, lo), before)
    end += 1
    while end < n && precedes(slots_list_view(g.xs, end), slots_list_view(g.xs, end - 1), before) == descending {
        end += 1
    }
    // Only strictly descending runs are reversed, so equal keys never cross.
    if descending {
        let mut a = lo
        let mut b = end - 1
        while a < b {
            slots_from_list(g.xs, a, mut g.scratch, 0, 1)
            slots_from_list(g.xs, b, mut g.scratch, 1, 1)
            slots_to_list(mut g.scratch, 0, g.xs, b, 1)
            slots_to_list(mut g.scratch, 1, g.xs, a, 1)
            a += 1
            b -= 1
        }
    }
    // A run shorter than 16 is extended to 16 by insertion, as in Goose's stable_sort and
    // Timsort's minrun: random input otherwise merges runs of two, a full pass per doubling.
    // Adjacent swaps keep xs whole at every comparator call. Moves only past strictly
    // preceding elements keep it stable.
    let stop = if n - lo <= 16 {
        n
    } else {
        lo + 16
    }
    while end < stop {
        let mut j = end
        while j > lo && precedes(slots_list_view(g.xs, j), slots_list_view(g.xs, j - 1), before) {
            slots_from_list(g.xs, j - 1, mut g.scratch, 0, 1)
            slots_from_list(g.xs, j, mut g.scratch, 1, 1)
            slots_to_list(mut g.scratch, 0, g.xs, j, 1)
            slots_to_list(mut g.scratch, 1, g.xs, j - 1, 1)
            j -= 1
        }
        end += 1
    }
    end
}

fn merge_runs[T](mut g: Hole[T], lo: u64, mid: u64, end: u64, before: scoped fn(T, T) -> Order) {
    if !precedes(slots_list_view(g.xs, mid), slots_list_view(g.xs, mid - 1), before) {
        return
    }
    g.state = MergeState(lo: lo, left: lo, mid: mid, right: mid)
    while g.state.left < mid && g.state.right < end {
        let at = int.wrapping_add(g.state.left, int.wrapping_sub(g.state.right, mid))
        if precedes(slots_list_view(g.xs, g.state.right), slots_list_view(g.xs, g.state.left), before) {
            slots_from_list(g.xs, g.state.right, mut g.scratch, at, 1)
            g.state.right = int.wrapping_add(g.state.right, 1)
        } else {
            slots_from_list(g.xs, g.state.left, mut g.scratch, at, 1)
            g.state.left = int.wrapping_add(g.state.left, 1)
        }
    }
    let at = int.wrapping_add(g.state.left, int.wrapping_sub(g.state.right, mid))
    if g.state.left < mid {
        slots_from_list(g.xs, g.state.left, mut g.scratch, at, int.wrapping_sub(mid, g.state.left))
    } else if g.state.right < end {
        slots_from_list(g.xs, g.state.right, mut g.scratch, at, int.wrapping_sub(end, g.state.right))
    }
    slots_to_list(mut g.scratch, lo, g.xs, lo, int.wrapping_sub(end, lo))
    g.state = empty_merge()
}

// Only the comparator can fail while the pair has holes. The consumed
// prefixes of the two runs are then empty, and scratch holds exactly that
// many elements starting at lo. Restore those slots before dropping xs.
type MergeState {
    lo: u64,
    left: u64,
    mid: u64,
    right: u64
}

fn empty_merge() -> MergeState {
    MergeState(lo: 0, left: 0, mid: 0, right: 0)
}

scoped type Hole[T] {
    xs: View[List[T]],
    scratch: Slots[T],
    state: MergeState
} drop(g) {
    if g.state.lo < g.state.left {
        slots_to_list(mut g.scratch, g.state.lo, g.xs, g.state.lo, int.wrapping_sub(g.state.left, g.state.lo))
    }
    if g.state.mid < g.state.right {
        slots_to_list(mut g.scratch, g.state.left, g.xs, g.state.mid, int.wrapping_sub(g.state.right, g.state.mid))
    }
    slots_finish_list(g.xs)
}

// Header access is trusted and private. xs stays frozen by Hole's view while
// its live set is temporarily holed. Both headers stay fixed: xs retains n,
// scratch retains0, and Hole restores every original slot before field cleanup.
fn slots_list_view[T](xs: View[List[T]], i: u64) -> View[T] in xs

fn slots_from_list[T](src: View[List[T]], i: u64, mut dst: Slots[T], j: u64, n: u64)

fn slots_to_list[T](mut src: Slots[T], i: u64, dst: View[List[T]], j: u64, n: u64)

// Sort touches only the original prefix and restores it before handing back.
// No tail slot was marked, so unmark live over the restored prefix is complete.
fn slots_finish_list[T](xs: View[List[T]])

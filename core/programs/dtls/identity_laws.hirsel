// openssl req -new -x509 -outform DER with the RFC 6979 A.2.5 P-256 key.
fn identity_certificate() -> Bytes {
    option.unwrap(std.hex.decode(b""))
}

fn identity_key(r: Random) -> Secret {
    let mut point: Bytes = list.with_capacity(65)
    result.unwrap(secret.p256_key(r, "sign(p256)", mut point))
}

fn identity_random() -> Random {
    provide.random_tape(option.unwrap(std.hex.decode(b"c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")))
}

/// bug: accept a DER certificate that belongs to a different signing key.
/// oracle: OpenSSL certificate for the RFC 6979 A.2.5 key and TLS-5 share lifetime.
@test
fn identity_shares_key() -> Result[(), ()] {
    let r = identity_random()
    let id = result.unwrap(dtls.identity(identity_key(r), identity_certificate(), r))
    let shared = dtls.share_identity(id)
    drop(take id)
    drop(dtls.share_identity(shared))
    let other = provide.random(7)
    if let Error(Config) = dtls.identity(identity_key(other), identity_certificate(), other) {} else {
        fail("certificate accepted with another signing key")
    }
    let invalid_cert_random = identity_random()
    if let Error(Config) = dtls.identity(identity_key(invalid_cert_random), b"", invalid_cert_random) {} else {
        fail("empty certificate accepted")
    }
    let denied = result.unwrap(secret.seal(b"", "kdf"))
    if let Error(Key(Denied)) = dtls.identity(take denied, identity_certificate(), r) {} else {
        fail("signing refusal lost its key error")
    }
    Ok(())
}

fn peer_p384_certificate() -> Bytes {
    option.unwrap(std.hex.decode(b""))
}

fn check_fingerprint_text(id: dtls.Identity, hash: dtls.HashFunc, expected: Bytes) {
    let fp = dtls.fingerprint(id, hash)
    let mut out = b"fingerprint:"
    let written = dtls.fingerprint_text(fp, mut out)
    let start = 12u64
    let end = list.len(out)
    if written != list.len(expected) || end != start + written || list.slice(out, 0, start) != b"fingerprint:" || list.slice(out, start, end) != expected {
        fail("fingerprint text differs from OpenSSL")
    }
    let parsed = result.unwrap(dtls.parse_fingerprint(list.slice(out, start, end)))
    if parsed.hash != hash || parsed.digest != fp.digest {
        fail("formatted fingerprint did not round-trip")
    }
}

fn refuse_fingerprint(text: Bytes) {
    if let Error(Fingerprint) = dtls.parse_fingerprint(text) {} else {
        fail("malformed fingerprint accepted")
    }
}

/// bug: authenticate a different certificate, reject a later matching pin, or hash less than the whole DER.
/// oracle: RFC 8122 sections 5 and 6.2 and openssl x509 -noout -fingerprint for each algorithm.
@test
fn fingerprint_pins_peer() -> Result[(), ()] {
    let sha256 = b"sha-256 20:DC:80:97:A3:0B:C8:EE:78:6A:0D:01:BA:8F:D6:31:EC:92:F9:67:63:BE:9A:AF:A1:37:02:1C:A6:3B:AD:AC"
    let sha384 = b"sha-384 2D:7C:A9:AC:B3:4E:6F:64:90:3B:80:CA:DE:CF:0E:97:2F:C6:7E:50:81:D3:FA:F3:33:EC:A3:09:28:DC:CD:F4:AD:F3:4E:BB:16:B3:CA:A6:56:E1:04:5F:C4:43:B9:EC"
    let sha512 = b"sha-512 36:07:64:AE:EA:AA:43:45:C9:57:4C:97:27:94:34:41:4F:DB:4C:41:E0:D2:CA:04:A0:54:6D:62:5F:B9:C1:E6:66:E8:F0:2A:8F:B0:A5:60:7A:2F:C4:3F:A2:65:95:95:17:AE:B2:F1:0B:83:7B:44:D3:A1:3F:D7:1A:FE:0E:F6"
    let r = identity_random()
    let original = result.unwrap(dtls.identity(identity_key(r), identity_certificate(), r))
    let id = dtls.share_identity(original)
    drop(take original)
    check_fingerprint_text(id, Sha256, sha256)
    check_fingerprint_text(id, Sha384, sha384)
    check_fingerprint_text(id, Sha512, sha512)
    let cert = identity_certificate()
    let mut pins: List[dtls.Fingerprint] = list.new()
    if dtls.matches_peer_fingerprint(cert, pins) {
        fail("empty pin list authenticated a certificate")
    }
    list.push(mut pins, result.unwrap(dtls.parse_fingerprint(b"sha-256 20:DC:80:97:A3:0B:C8:EE:78:6A:0D:01:BA:8F:D6:31:EC:92:F9:67:63:BE:9A:AF:A1:37:02:1C:A6:3B:AD:AD")))
    if dtls.matches_peer_fingerprint(cert, pins) {
        fail("one-byte fingerprint mismatch authenticated a certificate")
    }
    let mixed = result.unwrap(dtls.parse_fingerprint(b"sHa-256 20:dc:80:97:a3:0b:c8:ee:78:6a:0d:01:ba:8f:d6:31:ec:92:f9:67:63:be:9a:af:a1:37:02:1c:a6:3b:ad:ac"))
    list.push(mut pins, take mixed)
    if !dtls.matches_peer_fingerprint(cert, pins) || dtls.matches_peer_fingerprint(peer_p384_certificate(), pins) {
        fail("multiple pins did not authenticate only the matching certificate")
    }
    let mut altered = identity_certificate()
    let last = list.len(altered) - 1
    altered[last] = altered[last] ^ 1
    if dtls.matches_peer_fingerprint(altered, pins) {
        fail("certificate signature was omitted from the digest")
    }
    list.clear(mut pins)
    list.push(mut pins, result.unwrap(dtls.parse_fingerprint(sha384)))
    if !dtls.matches_peer_fingerprint(cert, pins) {
        fail("SHA-384 pin did not match")
    }
    list.clear(mut pins)
    list.push(mut pins, result.unwrap(dtls.parse_fingerprint(sha512)))
    if !dtls.matches_peer_fingerprint(cert, pins) {
        fail("SHA-512 pin did not match")
    }
    list.clear(mut pins)
    list.push(mut pins, result.unwrap(dtls.parse_fingerprint(b"sha-256 BD:5F:BF:0F:24:1A:06:C7:F1:BC:3A:D0:D2:85:CD:43:83:60:89:07:6B:AC:84:08:1B:F8:5F:98:8E:8B:8A:1E")))
    if !dtls.matches_peer_fingerprint(peer_p384_certificate(), pins) {
        fail("P-384 peer certificate did not match")
    }
    let invalid_pin = dtls.Fingerprint(hash: Sha256, digest: b"")
    let mut text = b"prefix"
    if dtls.fingerprint_text(invalid_pin, mut text) != 0 || text != b"prefix" {
        fail("formatter wrote a fingerprint with the wrong digest length")
    }
    refuse_fingerprint(b"")
    refuse_fingerprint(b"sha-256 20")
    let mut malformed = b"sha-256 20:DC:80:97:A3:0B:C8:EE:78:6A:0D:01:BA:8F:D6:31:EC:92:F9:67:63:BE:9A:AF:A1:37:02:1C:A6:3B:AD:AC"
    malformed[7] = b'\t'
    refuse_fingerprint(malformed)
    malformed[7] = b' '
    malformed[10] = b'-'
    refuse_fingerprint(malformed)
    malformed[10] = b':'
    malformed[8] = b'G'
    refuse_fingerprint(malformed)
    malformed[8] = b'2'
    malformed[6] = b'4'
    refuse_fingerprint(malformed)
    malformed[6] = b'6'
    list.push(mut malformed, b' ')
    refuse_fingerprint(malformed)
    Ok(())
}

fn check_setup(offer: dtls.Setup, answer: dtls.Setup, expected: Option[schedule.Side]) {
    match (dtls.negotiate_setup(offer, answer), expected) {
        (Ok(Client), Some(Client)) => (),
        (Ok(Server), Some(Server)) => (),
        (Error(Setup), None) => (),
        _ => fail("setup negotiation differs from the offer/answer table"),
    }
}

/// bug: accept an actpass answer or reverse the active role.
/// oracle: RFC 5763 section 5 and RFC 8842 section 5 setup rules.
@test
fn setup_roles() -> Result[(), ()] {
    check_setup(Active, Active, None)
    check_setup(Active, Passive, Some(Client))
    check_setup(Active, ActPass, None)
    check_setup(Passive, Active, Some(Server))
    check_setup(Passive, Passive, None)
    check_setup(Passive, ActPass, None)
    check_setup(ActPass, Active, Some(Server))
    check_setup(ActPass, Passive, Some(Client))
    check_setup(ActPass, ActPass, None)
    Ok(())
}

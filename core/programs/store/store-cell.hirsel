const CELL_INLINE: u64 = 256

type ValueCollection[V]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    readers: Arc[Readers[V]]
}

pub opaque type Cell[V]: shareable + send {
    binding: ValueCollection[V],
    key: Arc[Bytes]
}

pub fn cell_identity[V](c: Cell[V]) -> (StoreId, u32) {
    (c.binding.store, c.binding.id)
}

pub fn cell_schemas[V](c: Cell[V]) -> Arc[RowSchemas] {
    arc.share(c.binding.readers.schemas)
}

pub fn declare_cell[V](mut d: Declare, name: String, take value: std.codec.Codec[V]) -> Result[Cell[V], Error] {
    let cell_binding = declare_value_collection(mut d, name, CatalogCell, list.new(), take value)?
    let key = arc.new(failure_result_from_rep(catalog.prefix(cell_binding.id))?)
    Ok(Cell(binding: take cell_binding, key: take key))
}

fn declare_value_collection[V](mut d: Declare, name: String, take form: CatalogRecord, key_schema: Bytes, take value: std.codec.Codec[V]) -> Result[ValueCollection[V], Error] {
    if d.failed {
        return Error(MigrationFault)
    }
    d.failed = true
    failure_result_from_rep(catalog.declaration_name(name))?
    let key = failure_result_from_rep(catalog.table_key(name))?
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    let (take selected, created) = match pages.get_page_row(d.plan.schema.roots.catalog, key) {
        Some(raw) => {
            let existing = decode_catalog(raw)?
            if catalog_kind(existing.record) != catalog_kind(form) {
                if let Migrate = d.mode {
                    return Error(Exists(failure_result_from_rep(catalog.named(name))?))
                }
                return Error(Changed(failure_result_from_rep(catalog.named(name))?))
            }
            if map.contains(d.tables, existing.id) {
                return Error(Exists(failure_result_from_rep(catalog.named(name))?))
            }
            (take existing, false)
        },
        None => {
            let Migrate = d.mode else {
                return Error(Missing(failure_result_from_rep(catalog.named(name))?))
            }
            let initial = Catalog(record: take form, id: d.plan.schema.next_table, owner: 0, epoch: 1, key: failure_result_from_rep(types.copied(key_schema))?, schemas: list.new(), next: 0, by: list.new(), revision: list.new())
            (take initial, true)
        },
    }
    let mut record = take selected
    let mut number = record.next
    for old in record.schemas {
        if old.fingerprint == fp && old.schema == schema {
            number = old.number
        }
    }
    if number == record.next {
        let Migrate = d.mode else {
            return Error(Missing("schema"))
        }
        if number == 65535 {
            return Error(Limit(Ids))
        }
    }
    let resolved = readers(value, record, number, schema)?
    if number == record.next {
        list.push(mut record.schemas, catalog.ValueSchema(number: number, fingerprint: fp, schema: take schema))
        record.next += 1
        stage_value_collection(mut d.plan, key, record, created)?
    }
    map.insert(mut d.tables, record.id, true)
    d.failed = false
    Ok(ValueCollection(store: d.plan.store, id: record.id, catalog_key: failure_result_from_rep(catalog.catalog_key_handle(take key))?, catalog_page: failure_result_from_rep(catalog.catalog_page(d.plan.schema.roots.catalog))?, readers: take resolved))
}

fn stage_value_collection(mut plan: SchemaPlan, key: Bytes, record: Catalog, created: bool) -> Result[(), Error] {
    let wire = encode_catalog(record)?
    let mut live_bytes = catalog_recharge(plan.schema.live, plan.schema.roots, key, wire, plan.schema.retained)
    let base = pages.share_roots(plan.schema.roots)
    let mut roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, base, key, wire))?
    let mut next_id = plan.schema.next_table
    if created {
        if next_id == 4294967295 {
            return Error(Limit(Ids))
        }
        failure_result_from_rep(catalog.define_store_collection(mut roots.collections, record.id, pages.descriptor_kind_byte(catalog_kind(record.record)), mut plan.schema.next_node))?
        live_bytes = int.saturating_add(live_bytes, 126)
        next_id += 1
    }
    keep_schema(mut plan, take roots, live_bytes, next_id)
}

fn readable_value[V](store_id: StoreId, roots: pages.Roots, schema_binding: ValueCollection[V]) -> Result[(), Error] {
    if !types.same(store_id.hi, store_id.lo, schema_binding.store.hi, schema_binding.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.readable(roots, schema_binding.catalog_key, schema_binding.catalog_page, schema_binding.id))
}

fn lower_cell_edit(layers: List[Arc[pages.Staged]], id: u32) -> Option[View[pages.CellEdit]] in layers {
    let mut layer = list.len(layers)
    while layer > 0 {
        layer -= 1
        if let Some(edit) = map.get(layers[layer].ops.cells, id) {
            return Some(edit)
        }
    }
    None
}

fn cell_edit(tx: Tx, id: u32) -> Option[View[pages.CellEdit]] in tx {
    if let Some(edit) = map.get(tx.ops.cells, id) {
        return Some(edit)
    }
    lower_cell_edit(tx.below, id)
}

fn cell_current(tx: Tx, id: u32, key: Bytes) -> Option[View[Bytes]] in tx {
    match cell_edit(tx, id) {
        Some(CellPut(value)) => Some(format.staged_bytes(value)),
        Some(CellDelete) => None,
        _ => cell_page_row(tx.roots.collections, key),
    }
}

pub fn cell_fetch[V](tx: Tx, c: Cell[V]) -> Result[Option[V], Error] {
    readable_value(tx.store, tx.roots, c.binding)?
    note_read(tx, Point(failure_result_from_rep(types.copied(c.key))?))?
    let value = match cell_current(tx, c.binding.id, c.key) {
        Some(raw) => Some(row_value(c.binding.readers, c.binding.id, raw)?),
        None => None,
    }
    Ok(take value)
}

pub fn cell_get[V](r: Reader, s: Snapshot, c: Cell[V]) -> Result[Option[V], Error] waits {
    read_access(r, s)?
    readable_value(s.store, s.roots, c.binding)?
    match cell_page_row(s.roots.collections, c.key) {
        Some(raw) => Ok(Some(row_value(c.binding.readers, c.binding.id, raw)?)),
        None => Ok(None),
    }
}

fn cell_page_row(tree: pages.PageTree, key: Bytes) -> Option[View[Bytes]] in tree {
    let (root, descriptor) = std.page.collection_entry(tree.root, key)?
    if let Some(raw) = pages.inline_cell(descriptor) {
        return Some(raw)
    }
    // A spilled Cell stores its only row at the empty key.
    std.page.lookup(root, list.new())
}

fn cell_walk_value(walking: std.page_walk.Walk) -> Option[Arc[Bytes]] {
    let descriptor = option.unwrap(std.page_walk.value(walking))
    pages.owned_cell(std.page_walk.collection(walking), descriptor)
}

fn apply_cell(mut tree: pages.PageTree, key: Bytes, raw: Option[View[Bytes]], shared: Option[View[Arc[Bytes]]], first: u64, mut ids: u64) -> Result[(), Error] {
    let mut root = {
        let Some(empty) = view tree.empty_collection else {
            fail("store: missing empty collection page")
        }
        arc.share(empty)
    }
    let inline = match raw {
        Some(value) if list.len(value) <= CELL_INLINE => Some(value),
        Some(value) => {
            if let Some(contents) = shared {
                failure_result_from_rep(pages.page_result(std.page.insert_shared(mut root, list.new(), contents, tree.inline, first, mut ids)))?
            } else {
                failure_result_from_rep(pages.page_result(std.page.insert(mut root, list.new(), value, None, tree.inline, first, mut ids)))?
            }
            None
        },
        None => None,
    }
    let descriptor = failure_result_from_rep(pages.cell_record(root, inline))?
    failure_result_from_rep(pages.page_result(std.page.insert(mut tree.root, key, descriptor, Some(take root), tree.inline, first, mut ids)))
}

pub fn cell_set[V](mut tx: Tx, c: Cell[V], v: V) -> Result[(), Error] {
    readable_value(tx.store, tx.roots, c.binding)?
    let mut raw: Bytes = list.new()
    list.put_word_le(mut raw, c.binding.readers.current)
    std.codec.encode(c.binding.readers.codec, v, mut raw) ?=> |_| Limit(Value)
    if list.len(raw) > tx.limits.value {
        return Error(Limit(Value))
    }
    stage_cell(mut tx, c.binding.id, Some(take raw))
}

pub fn cell_clear[V](mut tx: Tx, c: Cell[V]) -> Result[(), Error] {
    readable_value(tx.store, tx.roots, c.binding)?
    stage_cell(mut tx, c.binding.id, None)
}

fn cell_wire_size(edit: Option[View[pages.CellEdit]]) -> u64 {
    match edit {
        Some(CellPut(value)) => 17 + list.len(format.staged_bytes(value)),
        Some(CellDelete) => 13,
        _ => 0,
    }
}

fn cell_charge(raw: Option[View[Bytes]]) -> u64 {
    match raw {
        Some(value) => 70 + format.round8(list.len(value)),
        None => 0,
    }
}

fn cell_matches(before: Option[View[Bytes]], after: Option[Bytes]) -> bool {
    match after {
        Some(right) => match before {
            Some(left) => left == right,
            None => false,
        },
        None => before == None,
    }
}

fn stage_cell(mut tx: Tx, id: u32, take wanted: Option[Bytes]) -> Result[(), Error] {
    let key = failure_result_from_rep(catalog.prefix(id))?
    let (reverts, old_width, old_charge) = {
        let current = cell_current(tx, id, key)
        if cell_matches(current, wanted) {
            return Ok(())
        }
        let previous = cell_edit(tx, id)
        let was = if tx.retain_old {
            match previous {
                Some(CellPut(raw)) => cell_charge(Some(format.staged_bytes(raw))),
                _ => 0u64,
            }
        } else {
            cell_charge(current)
        }
        (cell_matches(pages.get_page_row(tx.roots.collections, key), wanted), cell_wire_size(previous), was)
    }
    let (new_width, new_charge) = match view wanted {
        Some(raw) => (17 + list.len(raw), 70 + format.round8(list.len(raw))),
        None => (13u64, 0u64),
    }
    let effective_width = if reverts {
        0u64
    } else {
        new_width
    }
    let old_count = if old_width == 0 {
        0u64
    } else {
        1u64
    }
    let new_count = if effective_width == 0 {
        0u64
    } else {
        1u64
    }
    let cell_rows = tx.cell_rows - old_count + new_count
    let frame: Option[u64] = match tx.frame_bytes {
        None => None,
        Some(current) => {
            let after = current - old_width + effective_width
            let data_head = if tx.streams != 0 && tx.rows + cell_rows + tx.trim_rows == 0 {
                5u64
            } else {
                0u64
            }
            if int.saturating_add(after, tx.extra_bytes) - 16 - data_head > types.transaction_limit(limits_to_rep(tx.limits)) {
                return Error(Limit(Transaction))
            }
            Some(after)
        },
    }
    if reverts {
        remove_cell_edit(mut tx.ops.cells, tx.below, id)
    } else {
        let height = collection_write_height(tx.roots.collections, key)
        let _ = reserve_ids(mut tx, height)?
        let edit: pages.CellEdit = match take wanted {
            Some(take raw) => CellPut(pages.stage_value(take raw, tx.roots.collections.inline)),
            None => CellDelete,
        }
        map.insert(mut tx.ops.cells, id, take edit)
    }
    let added = if tx.retain_old && reverts {
        0u64
    } else {
        new_charge
    }
    tx.resident = int.saturating_add(int.saturating_sub(tx.resident, old_charge), added)
    tx.frame_bytes = frame
    tx.cell_rows = cell_rows
    Ok(())
}

fn remove_cell_edit(mut cells: Map[u32, pages.CellEdit], layers: List[Arc[pages.Staged]], id: u32) {
    match lower_cell_edit(layers, id) {
        Some(CellPut(_)) => map.insert(mut cells, id, CellRevert),
        Some(CellDelete) => map.insert(mut cells, id, CellRevert),
        _ => {
            let _ = map.remove(mut cells, id)
        },
    }
}

fn fold_cell_edits(mut cells: Map[u32, pages.CellEdit], layers: List[Arc[pages.Staged]], newer: Map[u32, pages.CellEdit]) {
    for (id, edit) in newer {
        match edit {
            CellRevert => remove_cell_edit(mut cells, layers, id),
            _ => map.insert(mut cells, id, clone(edit)),
        }
    }
}

fn seal_cell_edits(mut rows: pages.DataRows, cells: Map[u32, pages.CellEdit]) {
    for (id, edit) in cells {
        let key = result.unwrap(failure_result_from_rep(catalog.prefix(id)))
        match edit {
            CellPut(value) => pages.push_data_row(mut rows, format.DataOp(key: take key, value: Some(clone(value)), trim: None, prior: None)),
            CellDelete => pages.push_data_row(mut rows, format.DataOp(key: take key, value: None, trim: None, prior: None)),
            CellRevert => (),
        }
    }
}

pub fn published_cell[V](c: Cell[V], change: Change) -> Result[Option[Bytes], Error] {
    if change.tree_key != failure_result_from_rep(catalog.prefix(c.binding.id))? {
        return Error(Missing("cell"))
    }
    publish_row(c.binding.id, c.binding.readers, change)
}

// L2: an aborted body needs no COMMIT allocation. Encoding after Error turns
// this abort into Refused at the 80-byte Log/Log/isolate admission boundary.
pub fn law_abort_budget(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    let values: Inline[u64, 2] =[7, 19]
    for i in 0u64 .. 2 {
        let value = values[i]
        let outcome = result.unwrap(bound bytes 80 {
            execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), u64] {
                let _ = info(mut tx)
                Error(value)
            })
        })
        match take outcome {
            Ok(Aborted(Undone(value: actual, ticket: None))) => if actual != value {
                return false
            },
            _ => return false
        }
    }
    db.heads[0].head == 0 && db.resident == 0
}


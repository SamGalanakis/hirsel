// L4's native case (RUNNER-SPEC v2.5 §8): one program, two modes, compared by
// core/tools/runner_tests.py on the charge-observation runtime's peak_retained_bytes.
// argv: mode. Mode 0: one valid call through a session and the head. Mode 1: 10,000
// malformed calls (a 4,096-byte String plus one byte, so each decode reads the whole
// String before it is refused), then the same valid call. Refused frames leave nothing
// behind, so the two modes' peaks are equal.
type Hd: send { t: store.Table[u64, u64] }

type Calls = runner.Registry[(), Hd]

fn handles(mut db: store.Db) -> Result[Hd, store.Error] waits {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let t = store.table(mut db, "data", std.codec.key_u64(), cv)?
    Ok(Hd(t: t))
}

fn query_handles(h: Hd) -> Hd {
    Hd(t: store.query_table(h.t))
}


fn named(mut tx: store.Tx, h: Hd, take s: String) -> Result[u64, u32] {
    match store.put(mut tx, h.t, 0u64, string.byte_len(s)) {
        Ok(()) => Ok(string.byte_len(s)),
        Error(_) => Error(1u32),
    }
}

fn place(mut r: Calls) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(named), 16384u64, runner.DEFAULT_STEPS)
}

fn k_named() -> Bytes {
    let mut key: Bytes = list.new()
    result.unwrap(list.append(mut key, code.identity(code.describe(named))))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(std.codec.of_string())), mut key))
    let carried: std.codec.Codec[Result[u64, u32]] = std.codec.of()
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(carried)), mut key))
    key
}

fn string_arg(n: u64, trailing: bool) -> Bytes {
    let mut s: Bytes = list.new()
    for _ in 0u64 .. n {
        result.unwrap(list.push(mut s, 97u8))
    }
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_string(result.unwrap(string.from_utf8(take s)), mut b))
    if trailing {
        result.unwrap(list.push(mut b, 0u8))
    }
    b
}

type D: send { authority: store.AuthorityReader, head: Sender[runner.Req], post: Sender[runner.PubIn], clock: Clock, tasks: Tasks, flood: u64, net: Net, random: Random, policy: ingress.Ingress }

fn answer(cn: wire_client.Conn) -> runner.Outcome waits {
    match wire_client.next(cn) {
        Ok(Batch(_, _, _, take outcomes)) => {
            for take t in outcomes {
                let runner.Done(stream: _, p: _, outcome: take o) = take t
                return take o
            }
            fail("runner_rss: empty Batch")
        },
        Ok(_) => fail("runner_rss: a frame other than a Batch"),
        Error(_) => fail("runner_rss: client socket closed"),
    }
}

fn drive(take d: D) -> () waits {
    let mut requested: List[Bytes] = list.new()
    result.unwrap(list.push(mut requested, k_named()))
    let (cn, session) = result.unwrap(wire_client.pair(d.tasks, d.net, d.clock, d.random, d.policy, d.head, d.post, d.authority, code.describe(place), requested, None, 1u64, 2097152u64))
    let bad = string_arg(4096u64, true)
    for _ in 0u64 .. d.flood {
        let a: Bytes = result.unwrap(clone(bad))
        let request: runner.Frame = Call(0u32, 0u64, 0u32, 4294967295u32, take a)
        wire_client.send_frame(cn, take request)
        match answer(cn) {
            Refused(Malformed(_)) => (),
            _ => fail("runner_rss: a malformed call not Refused(Malformed)"),
        }
    }
    let request: runner.Frame = Call(0u32, 0u64, 0u32, 4294967295u32, string_arg(4096u64, false))
    wire_client.send_frame(cn, take request)
    match answer(cn) {
        Returned(_) => (),
        _ => fail("runner_rss: the valid call not Returned"),
    }
    let _ = wire_client.close(take cn)
    let _ = task.join(take session)
}

pub fn main(clock: Clock, random: Random, tasks: Tasks, argv: Args, net: Net) -> Result[(), Exit] waits {
    let Some(m) = args.get(argv, 0) else { return Error(Exit(status: 2)) }
    let flood = if result.unwrap(std.int.parse_uint(m, 10u32)) == 1u64 { 10000u64 } else { 0u64 }
    let mut db = store.memory(clock, random, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let made: Result[(Sender[runner.Req], Receiver[runner.Req]), Capacity] = channel.new(64u64)
    let (head, inbox) = result.unwrap(take made)
    let mail = result.unwrap(runner.mailbox(4u64))
    let mut limits = ingress.defaults()
    limits.call_period_ns = 1u64
    let (policy, take policy_handle) = result.unwrap(ingress.start(tasks, clock, random, limits, 1048576u64))
    let mut policy_task = take policy_handle
    let d = D(authority: store.authority_reader(db), head: take head, post: runner.post(mail), clock: clock, tasks: tasks, flood: flood, net: net, random: random, policy: ingress.share(policy))
    let driving = match task.spawn(tasks, bytes 33554432u64, take d, drive) {
        Ok(take t) => take t,
        Error(_) => return Error(Exit(status: 3)),
    }
    match runner.place_head(take db, code.describe(place), 1048576u64, code.describe(handles), code.describe(query_handles), take inbox, take mail, tasks, 1048576u64) {
        Ok(()) => (),
        Error(_) => return Error(Exit(status: 4)),
    }
    task.cancel(mut policy_task)
    let _ = task.join(take policy_task)
    match task.join(take driving) {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 6)),
    }
}

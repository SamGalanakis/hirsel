// The prepare child of a hot deploy (docs/spec/launch.md "Preparing the pending
// trigger report"; RUNNER-SPEC §14.6 "The activation fate").
pub fn prepare_place[G: send, H: shareable + inert + send, S: send](take p: PlaceConfig[G, H, S], take attempt: Bytes, take image: Bytes, take fates: fate.Fates, errors: Stderr) -> Result[Ended, StartError] waits {
    let (take options, _, _, _, _) = place_store(placing_of(p), p, Some(errors))?
    let n_place = p.n_place
    prepare_placed(take p, take options, n_place, take attempt, take image, take fates)
}

// The fates arrive as the launch's value-codec bytes; ones that do not decode,
// or whose entries are unsorted or repeated, refuse the launch.
fn operate_prepare[G: send, H: shareable + inert + send, S: send](take p: PlaceConfig[G, H, S], take options: store.Options, n_place: u64, attempt: LaunchBytes, image: LaunchBytes, held: LaunchBytes) -> Result[Ended, StartError] waits {
    let Some(take fates) = fate.decode(launch_bytes(held)) else {
        return Error(Missing("prepare fates"))
    }
    prepare_placed(take p, take options, n_place, launch_bytes(attempt), launch_bytes(image), take fates)
}

fn prepare_placed[G: send, H: shareable + inert + send, S: send](take p: PlaceConfig[G, H, S], take options: store.Options, n_place: u64, take attempt: Bytes, take image: Bytes, take fates: fate.Fates) -> Result[Ended, StartError] waits {
    let PlaceConfig(backing: take backing, place: place, on_migrate: on_migrate, schema: schema, clock: clock, tasks: tasks, triggers: take config, ..) = take p
    let Disk(scratch) = backing else {
        return Error(Missing("scratch"))
    }
    let entries = match take config {
        Some(TriggerConfig(entries: take listed, ..)) => take listed,
        None => triggers.empty_entries(),
    }
    let setup = PrepareConfig(scratch: scratch, options: take options, attempt: take attempt, image_digest: take image, clock: clock, tasks: tasks, n_place: n_place, place: place, on_migrate: on_migrate, schema: schema, triggers: take entries, fates: take fates)
    match prepare_deploy(setup) {
        Ok(()) => Ok(Unstarted),
        Error(Open(take problem)) => Error(Open(take problem)),
        Error(Identity) => Error(Open(IdentityUnknown)),
        Error(Deploy(Store(take problem))) => Error(Open(Store(take problem))),
        Error(Deploy(Scratch(Limit(Triggers)))) => Error(Open(Store(Limit(Triggers)))),
        Error(Deploy(_)) => Error(Missing("prepared")),
    }
}

pub type PrepareError: send = Open(OpenError) | Deploy(store.DeployError) | Identity

pub type PrepareConfig[G: send, H: shareable + inert + send] {
    scratch: Dir,
    options: store.Options,
    attempt: Bytes,
    image_digest: Bytes,
    clock: Clock,
    tasks: Tasks,
    n_place: u64,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    on_migrate: Option[StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits]],
    schema: StaticFn[fn(mut store.Declare) -> Result[H, store.Error]],
    triggers: triggers.Entries,
    fates: fate.Fates
}

pub type TriggerScanClass: codec + key + send = Cancelling | Held | Gone | Changed | Unchanged

// One group of the prepare scan. `hold` and `fate` are `Some` exactly on a
// `Held` group; `fate` is the deploy's fate for the group's entry path.
pub type TriggerScanRow: codec + send {
    class: TriggerScanClass,
    kind: Kind,
    path: Bytes,
    schema: Bytes,
    hold: Option[fate.HeldBy],
    fate: Option[fate.HeldFate],
    count: u64,
    earliest_due: u64
}

// TRIGGERS contains one value-codec TriggerReport. `unmatched` lists each fates
// entry path that is the entry path of no pending row and of no entry OLD or
// NEW registers.
pub type TriggerReport: codec + send {
    rows: List[TriggerScanRow],
    unmatched: List[Bytes]
}

/// The report holds the deploy for the operator's decision: a held group has no fate, or
/// an entry path is unmatched (RUNNER-SPEC §14.6 "The activation fate").
pub fn trigger_report_unsettled(report: TriggerReport) -> bool {
    if list.len(report.unmatched) > 0u64 {
        return true
    }
    for row in report.rows {
        if let Held = row.class {
            if let None = row.fate {
                return true
            }
        }
    }
    false
}

pub type PrepareArgs {
    attempt: Bytes,
    digest: Bytes,
    fates: fate.Fates
}

pub fn launch_prepare_args(a: Args) -> Result[Option[PrepareArgs], Exit] {
    let Some(mode) = args.get(a, 0u64) else {
        return Ok(None)
    }
    if mode != "--hirsel-prepare" {
        return Ok(None)
    }
    let invalid = Exit(status: 1u8)
    if args.len(a) != 5u64 {
        return Error(invalid)
    }
    let Some(attempt_text) = args.get(a, 2u64) else {
        return Error(invalid)
    }
    let Some(image_text) = args.get(a, 3u64) else {
        return Error(invalid)
    }
    let Some(fates_text) = args.get(a, 4u64) else {
        return Error(invalid)
    }
    let attempt = prepare_hex(attempt_text, Some(16u64))
    let digest = prepare_hex(image_text, Some(32u64))
    let fates = match prepare_hex(fates_text, None) {
        Some(raw) => fate.decode(raw),
        None => None,
    }
    match (take attempt, take digest, take fates) {
        (Some(take ticket), Some(take image), Some(take held)) => Ok(Some(PrepareArgs(attempt: take ticket, digest: take image, fates: take held))),
        _ => Error(invalid),
    }
}

// The launcher passes the attempt and image digest as fixed-width lowercase
// hex, and the fates as lowercase hex of any length.
fn prepare_hex(text: String, count: Option[u64]) -> Option[Bytes] {
    let raw = string.as_bytes(text)
    if let Some(n) = count {
        if list.len(raw) != 2u64 * n {
            return None
        }
    }
    for byte in raw {
        if byte >= b'A' && byte <= b'F' {
            return None
        }
    }
    std.hex.decode(raw)
}

fn prepare_result[T](take outcome: Result[T, store.DeployError]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Deploy(take reason)),
    }
}

fn prepare_open_result[T](take outcome: Result[T, store.Error]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Open(Store(take reason))),
    }
}

// The process receives its export directory as a scratch capability. It
// creates no listener or live-store lock.
pub fn prepare_deploy[G: send, H: shareable + inert + send](p: PrepareConfig[G, H]) -> Result[(), PrepareError] waits {
    let mut source = prepare_result(store.open_export(p.scratch, p.clock, p.attempt, p.options))?
    let digest = match launch_digest() {
        Ok(take hash) => take hash,
        Error(c) => return Error(Open(Store(Full(Allocation(c))))),
    }
    if list.len(digest) != 32 || digest != p.image_digest || launch_env().revision.size == 0u64 {
        return Error(Identity)
    }
    prepare_export(p, mut source)
}

fn prepare_export[G: send, H: shareable + inert + send](p: PrepareConfig[G, H], mut source: store.Preparation) -> Result[(), PrepareError] waits {
    let registered = match placed(p.place, p.n_place) {
        Ok(take reg) => take reg,
        Error(take error) => return Error(Open(Place(take error))),
    }
    if let Error(take problem) = activation_identity(code.identity(p.place), p.on_migrate, code.identity(p.schema)) {
        return Error(Open(take problem))
    }
    let mut declaration = store.declare_export(source, p.tasks, p.on_migrate) ?=> |problem| Open(Migrate(problem))
    let handles = (code.callable(p.schema))(mut declaration) ?=> |problem| Open(Migrate(problem))
    let mut staged = store.finish_export_declaration(source, take declaration) ?=> |problem| Open(Migrate(problem))
    if let Error(take problem) = store.validate_preparation(source, staged) {
        return Error(Open(Store(take problem)))
    }
    let (take description, take record) = prepare_activation(registered, p.n_place, prepare_open_result(store.describe_declarations(p.clock, p.schema))?) ?=> |problem| Open(Place(problem))
    let ReleaseRecord(release: take release, digest: take image, binding: take binding, ..) = take record
    let target = store.PreparedTarget(describe: take description, release: take release, digest: take image, resident_limit: p.options.resident_limit, pack_bytes: p.options.pack_bytes, checkpoint_bytes: p.options.checkpoint_bytes, journal_limit: p.options.journal_limit)
    let snapshot = store.staged_snapshot(source, staged)
    let tables = prepare_open_result(declared_triggers(registered, handles, snapshot))?
    let old = prepare_old_entries(source)?
    let report = prepare_trigger_scan(source, snapshot, tables, registered, p.triggers, old, binding, p.fates, mut staged)?
    let unsettled = trigger_report_unsettled(report)
    let codec: std.codec.Codec[TriggerReport] = std.codec.of()
    let mut raw: Bytes = list.new()
    std.codec.encode(codec, report, mut raw) ?=> |_| trigger_scan_limit()
    write_trigger_scan(p.scratch, take raw)?
    // An unsettled deploy ends here: TRIGGERS and no PREPARED, so the host
    // holds it for the operator's decision before any cut.
    if unsettled {
        return Ok(())
    }
    prepare_result(store.write_prepared(mut source, staged, p.scratch, take target))
}

// OLD's registered entries, from the activation the export carries.
fn prepare_old_entries(source: store.Preparation) -> Result[List[Exported], PrepareError] waits {
    let raw = match store.export_system_get(source, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes(), 0u8) {
        Ok(take row) => take row,
        Error(Missing(_)) => None,
        Error(take problem) => return Error(Open(Store(take problem))),
    }
    let Some(take prior_description) = take raw else {
        return Ok(list.new())
    }
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let Describe(exported: take prior_entries, ..) = std.codec.decode(codec, prior_description) ?=> |problem| Open(Store(Decode(problem)))
    Ok(take prior_entries)
}

fn trigger_scan_limit() -> PrepareError {
    Deploy(Scratch(Limit(Triggers)))
}

// The scan groups every pending row, then settles the held ones into `staged`
// with the install's own `fate.settle_read`, so prepare and install agree on
// what is settled and what is unmatched. A store with no trigger tables has no
// rows and no unmatched path.
fn prepare_trigger_scan[G: send, H: shareable + inert + send](source: store.Preparation, snapshot: store.Snapshot, tables: Option[triggers.Tables], reg: Registry[G, H], choices: triggers.Entries, old: List[Exported], digest: Bytes, f: fate.Fates, mut staged: store.StagedMigration) -> Result[TriggerReport, PrepareError] waits {
    let Some(table) = view tables else {
        return Ok(TriggerReport(rows: list.new(), unmatched: list.new()))
    }
    let read_handle = prepare_open_result(store.staged_reader(source, store.READER_PIN_MIN))?
    let cursor = prepare_open_result(triggers.scan_pending(read_handle, snapshot, table))?
    let rows = collect_trigger_scan(read_handle, take cursor, reg, choices, old, digest, f)?
    let mut registered: List[Bytes] = list.new()
    for entry in reg.t.exported {
        list.push(mut registered, triggers.identity_path(entry.described.identity))
    }
    for entry in old {
        list.push(mut registered, triggers.identity_path(entry.described.identity))
    }
    let unmatched = match prepare_open_result(fate.settle_read(read_handle, snapshot, mut staged, table, digest, registered, f))? {
        Some(take report) => {
            let fate.HeldReport(unmatched: take unmatched, ..) = take report
            take unmatched
        },
        None => list.new(),
    }
    Ok(TriggerReport(rows: take rows, unmatched: take unmatched))
}

fn collect_trigger_scan[G: send, H: shareable + inert + send](read_handle: store.Reader, take cursor: triggers.PendingRows, reg: Registry[G, H], choices: triggers.Entries, old: List[Exported], digest: Bytes, f: fate.Fates) -> Result[List[TriggerScanRow], PrepareError] waits {
    let mut remaining = take cursor
    let mut grouped: Map[(TriggerScanClass, Kind, Bytes, Bytes, Option[fate.HeldBy]), (u64, u64)] = map.new()
    while let Some(take pending) = prepare_open_result(triggers.next_scanned(read_handle, mut remaining))? {
        let class = prepare_open_result(trigger_scan_class(reg, choices, old, pending, digest))?
        let due = triggers.due_time(pending)
        let path: Bytes = clone(triggers.entry_path(pending))
        let schema: Bytes = clone(triggers.argument_schema(pending))
        let kind: Kind = if triggers.is_granted(pending) {
            Granted
        } else {
            Transact
        }
        let hold: Option[fate.HeldBy] = if let Held = class {
            Some(fate.held_by(pending, digest))
        } else {
            None
        }
        let key = (class, kind, take path, take schema, hold)
        map.update_or_insert(mut grouped, take key, (0u64, due), scoped fn(mut totals: (u64, u64)) {
            totals = (totals.0 + 1u64, std.order.min(totals.1, due))
        })
    }
    let mut rows: List[TriggerScanRow] = list.with_capacity(map.len(grouped))
    for take ((class, kind, take path, take schema, hold), (count, earliest)) in take grouped {
        let chosen: Option[fate.HeldFate] = if let Some(_) = hold {
            fate.resolve(f, path)
        } else {
            None
        }
        list.push(mut rows, TriggerScanRow(class: class, kind: kind, path: take path, schema: take schema, hold: hold, fate: chosen, count: count, earliest_due: earliest))
    }
    Ok(take rows)
}

fn trigger_scan_class[G: send, H: shareable + inert + send](reg: Registry[G, H], choices: triggers.Entries, old: List[Exported], pending: triggers.Pending, digest: Bytes) -> Result[TriggerScanClass, store.Error] {
    if triggers.cancelling(pending) {
        return Ok(Cancelling)
    }
    if triggers.held_on_start(pending, digest) {
        return Ok(Held)
    }
    let Some((_, index)) = trigger_key(reg, pending, choices)? else {
        return Ok(Gone)
    }
    for entry in old {
        if trigger_matches(pending, entry.described) {
            return Ok(if entry.revision != reg.t.exported[index].revision {
                Changed
            } else {
                Unchanged
            })
        }
    }
    Ok(Unchanged)
}

fn write_trigger_scan(d: Dir, raw: Bytes) -> Result[(), PrepareError] waits {
    let mut file = host.open(d, "TRIGGERS", Write) ?=> |e| Deploy(Scratch(Io(e)))
    host.write(mut file, raw) ?=> |e| Deploy(Scratch(Io(e.error)))
    host.sync(mut file) ?=> |e| Deploy(Scratch(Io(e)))
    host.close(take file) ?=> |e| Deploy(Scratch(Io(e)))
    Ok(())
}

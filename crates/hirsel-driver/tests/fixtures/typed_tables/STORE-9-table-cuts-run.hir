// rule: STORE-9
// expect: run
// A typed table over a simulated log whose history is cut at each authority
// request in turn. The run grants one kind's authorities `kN`, each cutting
// request N: `fN` refuses it and then fails the power, `lN` applies it, loses
// its answer and then fails the power, `tN` fails the power partway through
// it, and `cN` fails the power right after its answer. The one level is disk
// and the floor, so an Ok commit is durable. The table is more than one commit
// holds, both to write and to delete.
// The history is fixed: open a store, create table `items`, seed its eight
// rows one to a transaction, migrate it to a new value schema a row to a
// batch, drop it, close.
// After each cut the store reopens and the table is whole: none, the seeded
// rows 1..m with one schema entry, or all eight rows migrated with two. It is
// none only if its creation was not acknowledged or the drop began; the seeded
// rows only if the creation began, the migration did not return Ok and the
// drop did not begin, with m between the acknowledged and the possible seeds;
// migrated only if the migration began and the drop did not return Ok. No
// garbage record remains, and the keys under the table's rows are exactly its
// rows. Then the table is brought to the migrated state from wherever it is
// (dropped and created and seeded again if migrated, its seed finished if
// seeded), which reuses its generations, and a reopen holds all eight rows
// migrated with no leftovers, which one transaction cannot delete.
// Every `kN` up to the history's last request stops the history there, and
// the first one past it lets the history finish, which ends the sweep. The
// driver grants each kind (stdlib_table.rs).
@serializable
type Item {
  label: String,
  count: u64,
}

@serializable
type Priced {
  label: String,
  cents: u64,
}

fn price(c: (), key: String, old: Item) -> Result[(String, Priced), ()] {
  Ok((unique key, Priced(label: unique old.label, cents: old.count * 100)))
}

fn items() -> table.Table[String, Item] {
  table.named("items")
}

fn priced() -> table.Table[String, Priced] {
  table.named("items")
}

// Keys long enough that deleting every row outgrows one commit.
fn row_key(k: u64) -> String uses {} {
  let mut out = f"row {k}"
  let mut i: u32 = 0
  while i < 9 {
    out = f"{out} under a key long enough that deleting every row outgrows a commit"
    i += 1
  }
  out
}

fn tight() -> store.StoreConfig uses {} {
  let mut config = store.default_config()
  config.limits.transaction_bytes = 4000
  config
}

// The rows: ROWS of them, seeded PER to a transaction after the table is
// created in one of its own (`from` 0): the catalog record is most of a commit.
const ROWS: u64 = 8

const PER: u64 = 1

// Rows migrated to a batch.
const BATCH: u64 = 1

fn seed_rows(mut tx: store.Tx, info: store.CallInfo, from: u64) -> Result[
  (),
  store.TxError
] {
  if from == 0 {
    return table.create(mut tx, items())
  }
  for k in from..from + PER {
    table.put(mut tx, items(), row_key(k), Item(label: f"item {k}", count: k))?
  }
  Ok(())
}

pub type Failed = Check(String) | Store(store.StoreError)

fn check(ok: bool, take what: String) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check(what))
  }
}

// What the history learned. Rows: `low` seeded rows an Ok covered and `high` the
// most that may have been seeded. Each of the creation, the migration and the
// drop: 0 not begun, 1 begun with no answer or a failure, 2 returned Ok.
type Known {
  made: u8,
  low: u64,
  high: u64,
  migrate: u8,
  drop: u8,
  finished: bool,
}

// The fixed history, stopping at the first failure.
fn history(a: Authority, sc: Scope, mut k: Known) -> () {
  let Ok(opened) = store.open(a, tight()) else {
    return ()
  }
  let mut s = take opened
  k.made = 1
  let made: Result[(), store.TxFailure[store.TxError]] = store.transact(
    mut s,
    seed_rows,
    0u64
  )
  if made != Ok(()) {
    return ()
  }
  k.made = 2
  let mut from: u64 = 1
  while from <= ROWS {
    let r: Result[(), store.TxFailure[store.TxError]] = store.transact(
      mut s,
      seed_rows,
      from
    )
    match r {
      Ok(()) => {
        k.low = from + PER - 1
        k.high = k.low
      },
      Error(Unknown(_)) => {
        k.high = from + PER - 1
        return ()
      },
      _ => return (),
    }
    from += PER
  }
  k.migrate = 1
  if table.migrate(sc, mut s, items(), priced(), price, BATCH) != Ok(ROWS) {
    return ()
  }
  k.migrate = 2
  k.drop = 1
  if table.drop(mut s, priced()) != Ok(()) {
    return ()
  }
  k.drop = 2
  if store.close(take s) == Ok(()) {
    k.finished = true
  }
}

// The table after recovery: 0 none, 1 the seeded rows 1..m, 2 those rows migrated.
@serializable
type Seen {
  form: u8,
  rows: u64,
  epochs: u64,
}

fn seen(tx: store.Tx, info: store.CallInfo, a: ()) -> Result[Seen, store.TxError] {
  match table.history(tx, "items") {
    Error(NoTable()) => return Ok(Seen(form: 0, rows: 0, epochs: 0)),
    Error(e) => return Error(e),
    Ok(h) => {
      let epochs = list.len(h)
      if let Ok(old) = table.range(
        tx,
        items(),
        Unbounded(),
        Unbounded(),
        100,
        Ascending()
      ) {
        let m = list.len(old)
        let mut want: List[(String, Item)] = []
        for k in 1u64..m + 1 {
          list.push(mut want, (row_key(k), Item(label: f"item {k}", count: k)))
        }
        let form: u8 = if old == want {
          1
        } else {
          255
        }
        return Ok(Seen(form: form, rows: m, epochs: epochs))
      }
      let new = table.range(tx, priced(), Unbounded(), Unbounded(), 100, Ascending())?
      let m = list.len(new)
      let mut want: List[(String, Priced)] = []
      for k in 1u64..m + 1 {
        list.push(mut want, (row_key(k), Priced(label: f"item {k}", cents: k * 100)))
      }
      let form: u8 = if new == want {
        2
      } else {
        255
      }
      Ok(Seen(form: form, rows: m, epochs: epochs))
    },
  }
}

// Keys under the store's garbage records, and under the table's rows of any
// generation.
fn leftovers(a: Authority, mut s: store.Store) -> Result[(u64, u64), Failed] {
  let snap = store.snapshot(a, mut s, authority.floor(a)) ? Store
  let (low, high) = store.prefix_bounds(b"hirsel.garbage/")
  let mut prefix: List[u8] = []
  bytes.append(mut prefix, b"hirsel.rows/")
  bytes.append(mut prefix, keys.encode("items"))
  let (rows_low, rows_high) = store.prefix_bounds(bytes.from_list(take prefix))
  Ok(
    (
      list.len(store.range(snap, low, high, Ascending(), 100)),
      list.len(store.range(snap, rows_low, rows_high, Ascending(), 100))
    )
  )
}

// What a failed transaction says.
fn why[E](e: store.TxFailure[E]) -> String uses {} {
  match e {
    Aborted(_) => "Aborted",
    Canceled(_) => "Canceled",
    Faulted(f) => f"Faulted({f.rule})",
    Storage(_) => "Storage",
    Limit(KeyBytes()) => "Limit(KeyBytes)",
    Limit(ValueBytes()) => "Limit(ValueBytes)",
    Limit(TransactionBytes()) => "Limit(TransactionBytes)",
    Limit(_) => "Limit(other)",
    Unknown(_) => "Unknown",
  }
}

fn look(a: Authority, mut s: store.Store, name: String) -> Result[Seen, Failed] {
  // A read through a snapshot: it commits nothing, so the tight transaction
  // limit does not bound what it reads.
  let snap = store.snapshot(a, mut s, authority.floor(a)) ? Store
  let r: Result[Seen, store.TxFailure[store.TxError]] = store.query(take snap, seen, ())
  let t = match take r {
    Ok(t) => t,
    Error(e) => return Error(Check(f"{name}: reading the table failed: {why(e)}")),
  }
  check(
    t.form != 255,
    f"{name}: the table is neither the seeded rows nor them migrated"
  )?
  let (garbage, stored) = leftovers(a, mut s)?
  check(garbage == 0, f"{name}: {garbage} garbage records after reopening")?
  check(
    stored == t.rows,
    f"{name}: {stored} row keys under the table for {t.rows} rows"
  )?
  Ok(t)
}

// Deletes every row in one transaction: its writes alone exceed the tight
// limit, so the delete refuses it.
fn clear(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), store.TxError] {
  for k in 1u64..ROWS + 1 {
    let _ = table.delete(mut tx, priced(), row_key(k))?
  }
  Ok(())
}

fn reseed(mut s: store.Store) -> Result[(), String] {
  let mut from: u64 = 0
  while from <= ROWS {
    let r: Result[(), store.TxFailure[store.TxError]] = store.transact(
      mut s,
      seed_rows,
      from
    )
    if let Error(e) = r {
      return Error(f"rows {from}: {why(e)}")
    }
    from = if from == 0 {
      1
    } else {
      from + PER
    }
  }
  Ok(())
}

// Recovers the store a cut history left and checks it against `k`.
fn recover(a: Authority, sc: Scope, name: String, k: Known) -> Result[(), Failed] {
  let opened = store.open(a, tight())
  let mut s = match take opened {
    Ok(o) => o,
    Error(_) => return Error(Check(f"{name}: reopen refused")),
  }
  let t = look(a, mut s, name)?
  let story = f"form {t.form} rows {t.rows}, history made {k.made} rows {k.low}..{k.high} migrate {k.migrate} drop {k.drop}"
  // The whole old table, the whole migrated one, or none.
  match t.form {
    0 => check(
      t.rows == 0 && (k.made < 2 || k.drop > 0),
      f"{name}: the table is gone: {story}"
    )?,
    1 => check(
      k.made > 0 && k.migrate < 2 && k.drop == 0 && t.epochs == 1 && k.low <= t.rows && t.rows <= k.high && t.rows % PER == 0,
      f"{name}: the seeded table: {story}"
    )?,
    _ => check(
      k.migrate > 0 && k.drop < 2 && t.epochs == 2 && t.rows == ROWS,
      f"{name}: the migrated table: {story}"
    )?,
  }
  // The generations are reused safely: bring the table to the migrated state
  // from wherever it is.
  if t.form == 2 {
    check(table.drop(mut s, priced()) == Ok(()), f"{name}: drop after recovery failed")?
  }
  if t.form != 1 {
    if let Error(e) = reseed(mut s) {
      return Error(Check(f"{name}: seeding after recovery failed: {e}"))
    }
  } else if t.rows < ROWS {
    let mut from = t.rows + 1
    while from <= ROWS {
      let r: Result[(), store.TxFailure[store.TxError]] = store.transact(
        mut s,
        seed_rows,
        from
      )
      check(r == Ok(()), f"{name}: finishing the seed after recovery failed")?
      from += PER
    }
  }
  check(
    table.migrate(sc, mut s, items(), priced(), price, BATCH) == Ok(ROWS),
    f"{name}: migration after recovery failed"
  )?
  store.close(take s) ? Store
  let again = store.open(a, tight())
  let mut last = match take again {
    Ok(o) => o,
    Error(_) => return Error(Check(f"{name}: second reopen refused")),
  }
  let after = look(a, mut last, name)?
  let whole: Result[(), store.TxFailure[store.TxError]] = store.transact(
    mut last,
    clear,
    ()
  )
  check(
    whole == Error(Aborted(Limit(TransactionBytes()))),
    f"{name}: deleting the whole table in one commit: {match whole {
      Ok(_) => "Ok",
      Error(e) => why(e),
    }}"
  )?
  check(
    after.form == 2 && after.rows == ROWS,
    f"{name}: after recovery and a migration: form {after.form} rows {after.rows}"
  )?
  Ok(())
}

pub fn main(rt: Io) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Check("stdout"))
  }
  let Ok(tasks) = io.tasks(rt) else {
    return Error(Check("tasks"))
  }
  let mut kind = ""
  for k in ["f", "l", "t", "c"] {
    if let Ok(_) = io.authority(rt, f"{k}1") {
      kind = copy k
    }
  }
  let r = task.scope(
    tasks,
    fn(sc: Scope) -> Result[(), Failed] {
      sweep(rt, stdout, sc, kind)
    }
  )
  if let Error(Check(what)) = r {
    let _ = out.print(stdout, f"{what}\n")
  }
  r
}

// Cuts each request of the history in turn with the kind's authorities,
// recovering after each, until a cut lands past the history's end.
fn sweep(rt: Io, stdout: Stdout, sc: Scope, kind: String) -> Result[(), Failed] {
  let mut failures: u64 = 0
  let mut n: u64 = 1
  let mut last = false
  while !last {
    let name = f"{kind}{n}"
    let Ok(a) = io.authority(rt, name) else {
      return Error(Check(f"{name} not granted: the history is longer than the grants"))
    }
    let mut cut = Known(made: 0, low: 0, high: 0, migrate: 0, drop: 0, finished: false)
    history(a, sc, mut cut)
    if cut.finished {
      // Every cut stops the history at its request, so a history that
      // finished had none: request n is past its end.
      last = true
      check(n > 1, "request 1 was not cut")?
    } else if let Error(e) = recover(a, sc, name, cut) {
      failures += 1
      let line = match e {
        Check(what) => what,
        Store(_) => f"{name}: store error",
      }
      let _ = out.print(stdout, f"{line}\n")
    }
    n += 1
  }
  let _ = out.print(stdout, f"tables: {failures}\n")
  Ok(())
}

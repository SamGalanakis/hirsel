// AWFY JavaScript json.js. Keep the benchmark's own parser and hash-indexed
// object representation, including the original first lookup path.
type Value = Null | True | False | Number(String) | Str(String) | Array(List[Value]) | Object(Members)

type Members {
    names: List[String],
    values: List[Value],
    hash_index: Inline[u64, 32]
}

type Cursor {
    index: u64,
    line: u64,
    column: u64,
    capture_start: u64,
    capture: String
}

type Error = Syntax | Memory(Capacity)

fn memory(take c: Capacity) -> Error {
    Memory(c)
}

fn slot(name: String) -> u64 {
    int.wrapping_mul(string.byte_len(name), 1402589) & 31
}

fn byte(input: String, c: Cursor) -> u8 {
    let input_bytes = string.as_bytes(input)
    if c.index < list.len(input_bytes) {
        input_bytes[c.index]
    } else {
        0
    }
}

fn advance(input: String, mut c: Cursor) {
    if byte(input, c) == 10 {
        c.line += 1
        c.column = 0
    }
    c.index += 1
    c.column += 1
}

fn skip_whitespace(input: String, mut c: Cursor) {
    let mut current = byte(input, c)
    while current == 32 || current == 9 || current == 10 || current == 13 {
        advance(input, mut c)
        current = byte(input, c)
    }
}

fn consume(input: String, mut c: Cursor, expected: u8) -> bool {
    if byte(input, c) != expected {
        return false
    }
    advance(input, mut c)
    true
}

fn required(input: String, mut c: Cursor, expected: u8) -> Result[(), Error] {
    if consume(input, mut c, expected) {
        Ok(())
    } else {
        Error(Syntax)
    }
}

fn literal(input: String, mut c: Cursor, spelling: String) -> Result[(), Error] {
    for b in string.as_bytes(spelling) {
        required(input, mut c, b)?
    }
    Ok(())
}

fn digit(input: String, mut c: Cursor) -> bool {
    let current = byte(input, c)
    if current < 48 || current > 57 {
        return false
    }
    advance(input, mut c)
    true
}

fn capture_piece(input: String, mut c: Cursor) -> Result[(), Error] {
    let part = string.slice(input, c.capture_start, c.index)
    Ok(string.push(mut c.capture, part))
}

fn finish_capture(input: String, mut c: Cursor) -> Result[String, Error] {
    if string.byte_len(c.capture) == 0 {
        Ok(string.from(string.slice(input, c.capture_start, c.index)))
    } else {
        capture_piece(input, mut c)?
        Ok(replace(mut c.capture, string.new()))
    }
}

fn number(input: String, mut c: Cursor) -> Result[Value, Error] {
    c.capture_start = c.index
    let _ = consume(input, mut c, 45)
    let leading_zero = byte(input, c) == 48
    if !digit(input, mut c) {
        return Error(Syntax)
    }
    if !leading_zero {
        while digit(input, mut c) {}
    }
    if consume(input, mut c, 46) {
        if !digit(input, mut c) {
            return Error(Syntax)
        }
        while digit(input, mut c) {}
    }
    if consume(input, mut c, 101) || consume(input, mut c, 69) {
        if !consume(input, mut c, 43) {
            let _ = consume(input, mut c, 45)
        }
        if !digit(input, mut c) {
            return Error(Syntax)
        }
        while digit(input, mut c) {}
    }
    Ok(Number(finish_capture(input, mut c)?))
}

fn read_string(input: String, mut c: Cursor) -> Result[String, Error] {
    required(input, mut c, 34)?
    c.capture_start = c.index
    while byte(input, c) != 34 {
        if byte(input, c) == 92 {
            capture_piece(input, mut c)?
            advance(input, mut c)
            let scalar = match byte(input, c) {
                34 => 34u32,
                47 => 47u32,
                92 => 92u32,
                98 => 8u32,
                102 => 12u32,
                110 => 10u32,
                114 => 13u32,
                116 => 9u32,
                _ => return Error(Syntax),
            }
            string.push_char(mut c.capture, option.unwrap(char.from_u32(scalar)))
            advance(input, mut c)
            c.capture_start = c.index
        } else {
            if byte(input, c) < 32 {
                return Error(Syntax)
            }
            advance(input, mut c)
        }
    }
    let captured = finish_capture(input, mut c)?
    advance(input, mut c)
    Ok(take captured)
}

fn array(input: String, mut c: Cursor) -> Result[Value, Error] {
    advance(input, mut c)
    let mut elements: List[Value] = list.new()
    skip_whitespace(input, mut c)
    if !consume(input, mut c, 93) {
        let mut more = true
        while more {
            skip_whitespace(input, mut c)
            let element = value(input, mut c)?
            list.push(mut elements, take element)
            skip_whitespace(input, mut c)
            more = consume(input, mut c, 44)
        }
        required(input, mut c, 93)?
    }
    Ok(Array(take elements))
}

fn object(input: String, mut c: Cursor) -> Result[Value, Error] {
    advance(input, mut c)
    let mut members = Members(names: list.new(), values: list.new(), hash_index:[0; 32])
    skip_whitespace(input, mut c)
    if !consume(input, mut c, 125) {
        let mut more = true
        while more {
            skip_whitespace(input, mut c)
            let name = read_string(input, mut c)?
            skip_whitespace(input, mut c)
            required(input, mut c, 58)?
            skip_whitespace(input, mut c)
            let child = value(input, mut c)?
            let index = list.len(members.names)
            members.hash_index[slot(name)] = if index < 255 {
                index + 1
            } else {
                0
            }
            list.push(mut members.names, take name)
            list.push(mut members.values, take child)
            skip_whitespace(input, mut c)
            more = consume(input, mut c, 44)
        }
        required(input, mut c, 125)?
    }
    Ok(Object(take members))
}

fn value(input: String, mut c: Cursor) -> Result[Value, Error] {
    match byte(input, c) {
        110 => {
            literal(input, mut c, "null")?
            Ok(Null)
        },
        116 => {
            literal(input, mut c, "true")?
            Ok(True)
        },
        102 => {
            literal(input, mut c, "false")?
            Ok(False)
        },
        34 => Ok(Str(read_string(input, mut c)?)),
        91 => array(input, mut c),
        123 => object(input, mut c),
        _ => number(input, mut c),
    }
}

fn member(members: Members, name: String) -> Option[View[Value]] in members {
    let index = members.hash_index[slot(name)]
    if index > 0 && members.names[index - 1] == name {
        return list.get(members.values, index - 1)
    }
    None
}

fn verify(root: Value) -> bool {
    match root {
        Object(members) => verify_object(members),
        _ => false,
    }
}

fn verify_object(members: Members) -> bool {
    if let Some(head) = member(members, "head") {
        if let Object(_) = head {
            if let Some(operations) = member(members, "operations") {
                if let Array(elements) = operations {
                    return list.len(elements) == 156
                }
            }
        }
    }
    false
}

pub fn benchmark(input: String) -> Result[bool, Capacity] {
    let mut c = Cursor(index: 0, line: 1, column: 0, capture_start: 0, capture: string.new())
    skip_whitespace(input, mut c)
    match value(input, mut c) {
        Error(Syntax) => Ok(false),
        Error(Memory(capacity)) => Error(capacity),
        Ok(take document) => {
            skip_whitespace(input, mut c)
            Ok(c.index == string.byte_len(input) && verify(document))
        },
    }
}

#!/usr/bin/env python3
"""Build benchmark executables through the production `hirsel build --release` command."""
import argparse
import json
import subprocess
import time
from pathlib import Path
from suite import ROOT, buck2_build, native_environment, sha, text_size

CONFIGURATIONS = ('regions-on-whole', 'regions-on-singleton', 'regions-off-size-class', 'regions-off-system')
PRODUCTION = 'regions-on-whole'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--case', action='append', default=[])
    parser.add_argument('--output', type=Path, default=ROOT / 'build/hirsel.json')
    parser.add_argument('--configuration', action='append', choices=CONFIGURATIONS)
    args = parser.parse_args()
    repo = ROOT.parent.parent
    bundle = Path(buck2_build('--target-platforms', '//tools/buck2:release',
                              '//:hirsel-toolchain')['hirsel-toolchain'])
    compiler = bundle / 'hirsel'
    env = native_environment({'HIRSEL_DAEMON': 'off'})
    revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo, text=True).strip()
    specs = json.loads(args.output.read_text()) if args.output.exists() else {}
    grants = ROOT / 'build/hirsel-grants.json'
    grants.parent.mkdir(parents=True, exist_ok=True)
    grants.write_text(json.dumps({'io': {'stdout': 'stdout.bytes@1',
        'dirs': [{'path': '', 'host': str(ROOT), 'access': 'read'}]}}, indent=2) + '\n')
    for config in CONFIGURATIONS:
        spec = specs.setdefault(config, {'cases': {}})
        for case, record in list(spec['cases'].items()):
            if config != PRODUCTION or record.get('compile_kind') != 'production hirsel build --release; retained tool caches':
                del spec['cases'][case]
                spec.setdefault('unavailable', {})[case] = dict(
                    reason='Retired batch build; rebuild this case through production hirsel build --release.',
                    compiler_revision=revision)
    for case in args.case or ['binarytrees']:
        source = ROOT / 'programs' / f'{case.replace("/", "-")}.hir'
        generated = ROOT / 'build/hirsel-source' / source.name
        generated.parent.mkdir(parents=True, exist_ok=True)
        generated.write_text(source.read_text() + '\n' + (ROOT / 'programs/common.hir').read_text())
        sidecar = dict(schema=1, package=dict(name='benchmark', version='1'),
                       entry=dict(module=[], name='main'), sources=[dict(path=generated.name, module=[])],
                       dependencies=[dict(manifest=str(repo / 'stdlib/std@1/hirsel.json'),
                                          package=dict(name='std', version='1'), expose=[])])
        generated.with_suffix('.hir.json').write_text(json.dumps(sidecar, indent=2) + '\n')
        for config in args.configuration or CONFIGURATIONS:
            specs[config]['cases'].pop(case, None)
            if config != PRODUCTION:
                reason = 'Production release builds expose whole partitioning with regions and the production allocator; this batch-only configuration has no CLI equivalent.'
                specs[config].setdefault('unavailable', {})[case] = dict(reason=reason, compiler_revision=revision)
                print(f'{case}/{config}: unavailable ({reason})', flush=True)
                continue
            binary = ROOT / 'build/hirsel' / config / source.stem / 'program'
            binary.parent.mkdir(parents=True, exist_ok=True)
            started = time.monotonic()
            proc = subprocess.run([str(repo / 'tools/capped'), str(compiler), 'build', '--release',
                                   str(generated), '-o', str(binary)], capture_output=True, text=True, env=env)
            elapsed = time.monotonic() - started
            if proc.returncode:
                specs[config].setdefault('unavailable', {})[case] = dict(reason=proc.stderr,
                    source_sha256=sha(generated), compiler_revision=revision, compiler_sha256=sha(compiler))
                print(f'{case}/{config}: unavailable\n{proc.stderr}', flush=True)
                continue
            specs[config].get('unavailable', {}).pop(case, None)
            record = dict(compiler_revision=revision, compiler_sha256=sha(compiler),
                compile_seconds=elapsed, compile_kind='production hirsel build --release; retained tool caches',
                configuration=config, partition='whole', regions=True, hirsel_opt_level='O2', hirsel_lto=False,
                command=[str(binary), '--hirsel-grants', str(grants), '{case}', '{input}', '{rounds}', '{emit}'],
                binary_sha256=sha(binary), source_sha256=sha(generated), text_bytes=text_size(binary),
                launch_manifest_sha256=sha(generated.with_suffix('.hir.json')), grants_sha256=sha(grants),
                counter_status='Production release runtime has no measurement counters; no instrumented batch surrogate.',
                dependency_source_sha256={str(p.relative_to(repo)): sha(p)
                    for p in sorted((repo / 'stdlib/std@1').glob('*')) if p.is_file()})
            if case in ('binarytrees', 'binarytrees-region'):
                record['binarytrees_storage'] = 'arena' if case == 'binarytrees-region' else 'heap'
            specs[config]['cases'][case] = record
            print(f'{case}/{config}: built in {elapsed:.3f}s', flush=True)
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(specs, indent=2) + '\n')
    print(args.output)


if __name__ == '__main__':
    main()

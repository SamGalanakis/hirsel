// Test-only seams. This file is listed under [tests.sources] and joins module quic in
// the package's own test runs and in no other build (packages.md), so nothing here is
// in the shipped API.
/// Hostile-peer test seam: raw frame bytes sent once, unchecked and never retransmitted,
/// in the connection's next 1-RTT packet. Laws use it to act as a peer that breaks the
/// rules (credit past MAX_DATA, a changed reset) or grants 2^62 of credit.
pub fn send_frames(mut e: Endpoint, c: ConnectionHandle, frames: Bytes) -> Result[(), QuicError] {
    let i = stream_slot(e, c)?
    if let Some(mut conn) = e.connections[i] {
        list.append(mut conn.streams.seam, frames)
        return Ok(())
    }
    Error(UnknownConnection)
}

/// Q7 seam: the connections an endpoint holds, so a law can see a Retry kept no state.
pub fn live_connections(e: Endpoint) -> u64 {
    e.live
}

/// Q7 seam: the token a client's Initials carry (a Retry's, once one is accepted).
pub fn initial_token(e: Endpoint, c: ConnectionHandle) -> Bytes {
    let Some(i) = slot_at(e, c) else {
        return b""
    }
    if let Some(conn) = e.connections[i] {
        return clone(conn.initial.token)
    }
    b""
}

/// Q7 seam: replace the token a client's next Initials carry, to present a token that
/// was minted for another connection or relabeled to the other type.
pub fn set_initial_token(mut e: Endpoint, c: ConnectionHandle, take token: Bytes) {
    let Some(i) = slot_at(e, c) else {
        return
    }
    if let Some(mut conn) = e.connections[i] {
        conn.initial.token = take token
    }
}

/// Q7 seam: the NEW_TOKEN token this server would issue to `peer` at `now`.
pub fn mint_address_token(e: Endpoint, peer: Addr, now: u64) -> Bytes {
    seal_token(e.random, e.config.token_key, TOKEN_ADDRESS, peer, b"", b"", now)
}

/// Q13 seam: scale the §6.6 confidentiality limits down (update at `update_at` seals
/// under one key, close at `limit`) and block or allow key updates.
pub fn set_aead_limits(mut e: Endpoint, c: ConnectionHandle, update_at: u64, limit: u64, blocked: bool) {
    let Some(i) = slot_at(e, c) else {
        return
    }
    if let Some(mut conn) = e.connections[i] {
        conn.keys.update_at = update_at
        conn.keys.limit = limit
        conn.keys.blocked = blocked
    }
}

/// Q13 seam: the key updates a connection initiated and the ones it made in answer.
pub fn key_updates(e: Endpoint, c: ConnectionHandle) -> (u64, u64) {
    let Some(i) = slot_at(e, c) else {
        return (0, 0)
    }
    if let Some(conn) = e.connections[i] {
        return (conn.keys.initiated, conn.keys.answered)
    }
    (0, 0)
}

// Module `core`: the prelude. Every `pub` declaration here is named unqualified
// (LANG-7). A type declared with no body is built in: its kind, bounds, size and layout are
// the ones the specification gives it (docs/spec/core.md, "Built-in types").
// Contracts: docs/spec/core.md.
pub type Option[T] = None | Some(T)

pub type Result[T, E] = Ok(T) | Error(E)

pub type Order: key + ordered = Less | Equal | Greater

pub type Exit: key {
    status: u8
}

pub opaque type Never

pub opaque type String

pub opaque type List[T]

// A sequence of T rows stored by column, with List's row operations and charge
// (module `columns`, MEM-24). A record T has one column per field, c.f.
pub opaque type Columns[T]

pub type Bytes = List[u8]

pub opaque type FrozenBytes

pub type Deque[T] = deque.Deque[T]

pub type Heap[T: ordered] = heap.Heap[T]

pub type Log[E: inert] = log.Log[E]

pub opaque type Map[K: key, V]

pub opaque type Box[T]

pub opaque type Rc[T: shareable]

pub opaque type Arc[T: shareable + send]

pub opaque type Shared[T: shareable + cross]

pub opaque resource type Latest[T: shareable + send]

pub opaque resource type Client[T: cross]

pub opaque resource type Inbox[T: cross]

pub opaque resource type Flow

pub opaque type Into[T]

pub opaque type Port[T]

pub opaque type Sink[T]

pub type Wire = Foreign | Started | Zero | Refused(Capacity)

pub type Push[T: plain] = Ok | Ended(T) | Order(T) | Closed(T) | Stalled(T)

pub type Pull[T: plain] = Item(key: u64, from: u32, x: T) | Dropped(from: u32, at: u64) | End | Stalled

pub type Halt = OutOfTime | Failed

pub type Failure {
    stage: u32,
    key: u64,
    halt: Halt
}

pub opaque type View[T]

pub opaque type Unique: key

pub opaque type Region

pub opaque type Text

pub opaque type FixedSpan[T: plain]

pub opaque type SeqSpan[T: packed]

pub opaque type IndexedSpan[T: packed]

pub opaque type SeqIndex[T: packed, in a]

pub opaque type Link[T]

pub opaque type Dest[T]

pub opaque type Writer[T, in r]

pub opaque type Child[T]

pub opaque type SpanBuilder[T: plain, in r]

pub opaque type Builder[T, in r]

pub opaque type Task[R: send]

pub opaque type Sender[T: send]

pub opaque type Receiver[T: send]

pub opaque type Args

pub opaque type Dir

pub opaque type Net

pub opaque type Clock

pub opaque type Random

pub opaque type Stdout

pub opaque type Stderr

// A terminal's size in character cells (`stdout.size`, `stderr.size`).
pub type TermSize {
    cols: u16,
    rows: u16
}

pub opaque type Stdin

pub opaque type Env

pub opaque type Process

pub opaque type Tasks

pub opaque resource type Secret

pub opaque type Foreign[I]

pub opaque type Exec

pub opaque type Cred

pub type CredError = Room(key_id: u64, token: u64) | Net(NetError) | Token(IoError) | Status(u16) | Malformed

pub opaque resource type Proc

pub type ExecOp = Spawn(program: u64, args: u64, env: u64, dir: u64, path: u64, stdin: Stdio, stdout: Stdio, stderr: Stdio) | Await(proc: u64) | Signal(proc: u64, signal: Signal) | Recv(pipe: u64, room: u64, max: u64) | Send(pipe: u64, prefix: u64, tail: u64) | Released(id: u64, part: Part)

pub type ExecReply = Done | Failed(ExecError) | IoFailed(NetError) | Count(u64) | Started(proc: u64, stdin: u64, stdout: u64, stderr: u64) | Ended(Termination)

pub type Stdio = Discard | Piped

pub type Launch {
    program: String,
    args: List[Bytes],
    env: List[(String, Bytes)],
    dir: String,
    path: String,
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio
}

pub type Spawned = Spawned(Proc, Option[WriteHalf], Option[ReadHalf], Option[ReadHalf])

pub type ExecError = Denied | TimedOut | Aborted | Other(u32)

pub type Termination = Exited(u8) | Signalled(u8)

pub type Signal = SigInt | SigTerm | SigKill

pub type ArgToken = Lit(Bytes) | Any | Rest

pub type ExecRule = Programs(names: String) | Form(program: String, form: List[ArgToken]) | EnvKeys(program: String, keys: String) | Dirs(program: String, labels: String)

pub type SecretError = Invalid | Capacity(Capacity)

pub type MacError = Denied()

pub type JwsMacAlg = Sha256 | Sha384 | Sha512

pub type JwsMacError = Denied() | ShortKey()

pub type KeyError = Denied | Invalid | Tampered | Capacity(Capacity)

pub type SignAlg = Ed25519 | P256 | Rs256

pub type AeadAlg = ChaCha20Poly1305 | Aes128Gcm | Aes256Gcm

pub opaque resource type Socket

pub opaque resource type ReadHalf

pub opaque resource type WriteHalf

pub opaque resource type Listener

pub opaque resource type UnixListener

pub opaque resource type UnixDatagram

pub opaque resource type UdpSocket

pub type Steer = Hash | Quic

pub type UdpOptions = UdpOptions(slots: u32, slot_bytes: u32)

pub type UdpPacket = UdpPacket(peer: Addr, at: u64, len: u64, truncated: bool, ecn: u8)

pub type UdpTx = UdpTx(to: Addr, at: u64, len: u64, ecn: u8)

pub type UdpStaged = UdpStaged(peer: Addr, len: u64, appended: u64, ecn: u8)

pub type Received = Received(len: u64, truncated: bool)

pub type Ip: key = V4(u32) | V6(u64, u64)

pub type Addr: key {
    ip: Ip,
    port: u16
}

pub type Until = Never | At(Clock, u64)

pub type NetError = Denied | Refused | Unreachable | InUse | Reset | TimedOut | Aborted | Other(u32) | Tls(TlsFailure) | BoundNotListening(u32) | EphemeralOutsideNetGrant | Oversize(max: u32) | Exhausted

pub type Trust: send = System | Roots(Bytes)

pub type Handshake {
    protocol: Option[u64],
    peer: (u64, u64, u64, u64)
}

pub type TlsFailure = Certificate(CertFailure) | Name | Alpn | Roots | Protocol(u8) | Closed | Truncated | Chain | Key

pub type CertFailure = UnknownIssuer | NameMismatch | Expired | NotYetValid | Invalid

pub type NetDirection = Connect | Listen | UdpBind | UdpSend

pub type TlsPin = SystemPin | Sha256(Bytes)

pub type UnixDirection = UnixConnect | UnixListen | UnixBind | UnixSend

// NET-18: a Connect rule's reach. `Public` covers only addresses `net.class` calls public.
pub type Reach = Any | Public

pub type Rule = Rule(dir: NetDirection, prefix: Ip, bits: u8, ports: (u16, u16), reach: Reach) | Tls(names: String, ports: (u16, u16), trust: TlsPin) | Resolve(names: String) | Unix(dir: UnixDirection, root: String, path: String)

pub type RuleError = Invalid()

// NET-18's address-class table (`net.class`).
pub type AddressClass = Public | Unspecified | ThisNetwork | Private | SharedCgnat | Loopback | LinkLocal | Protocol | Documentation | Relay6to4 | Benchmarking | Multicast | Reserved | Broadcast | UniqueLocal | Nat64Local | NotGlobal6

// NET-18: the connects a provider refused, by part of the public-only check.
pub type NetDenials {
    not_public: u64,
    own_address: u64
}

pub opaque resource type HostFile

pub opaque resource type HostEntries

// The hand that moves a `provide.clock` Clock, and the trigger that stops a
// `provide.process` Process (core.md, Provide).
pub opaque resource type ClockHand

pub opaque resource type StopTrigger

// A served port's server end and one call taken from it (core.md, Provide).
pub opaque resource type Served[Op]

pub opaque resource type Call[Op]

pub type Withdrawn = Withdrawn()

pub type StreamOp = Write(len: u64)

pub type StreamReply = Done | WriteFailed(WriteError)

// A served Dir's operations and answers: a path or data field is its byte
// length; ids name the server's objects, 0 the Dir `provide.dir` returned.
pub type DirOp = Open(dir: u64, path: u64, mode: OpenMode) | OpenDir(dir: u64, path: u64) | Mkdtemp(dir: u64, prefix: u64, room: u64) | Stat(dir: u64, path: u64) | Mkdir(dir: u64, path: u64) | Remove(dir: u64, path: u64) | RemoveTree(dir: u64, path: u64) | Rename(dir: u64, from: u64, to: u64) | SyncDir(dir: u64) | Entries(dir: u64, path: u64) | Read(file: u64, room: u64) | ReadAt(file: u64, at: u64, room: u64) | Write(file: u64, len: u64) | WriteAt(file: u64, at: u64, len: u64) | StatFile(file: u64) | Sync(file: u64) | TryLock(file: u64) | Unlock(file: u64) | Close(file: u64) | NextEntries(entries: u64, room: u64) | Released(id: u64) | Mkstemp(dir: u64, prefix: u64, room: u64) | ZeroExtension(dir: u64) | TryLockShared(file: u64) | ZeroAt(file: u64, at: u64, len: u64)

pub type DirReply = Done | Failed(IoError) | WriteFailed(WriteError) | Count(u64) | Locked(bool) | Stat(Stat) | File(u64) | Dir(u64) | Entries(u64) | ZeroExtensionSupported(bool)

// A socket's part a dropped handle releases: the whole socket, or one half
// of a split one (core.md, Provide).
pub type Part = Whole | Read | Write

// A served Net's operations and answers: a name or data field is its byte
// length; ids name the server's sockets and listeners.
pub type NetOp = Connect(addr: Addr, public: bool) | Resolve(name: u64, room: u64) | Listen(addr: Addr, backlog: u16) | Accept(listener: u64) | Recv(socket: u64, room: u64, max: u64) | Send(socket: u64, prefix: u64, tail: u64) | Handshake(socket: u64, name: u64, alpn: u64, system: bool) | SendSecret(socket: u64, wire: u64, secrets: u64, marks: u64) | Released(id: u64, part: Part) | ConnectUnix(root: u64, path: u64) | ListenUnix(root: u64, path: u64, backlog: u16) | AcceptUnix(listener: u64) | OpenDatagram | BindDatagram(root: u64, path: u64) | ConnectDatagram(datagram: u64, root: u64, path: u64) | SendDatagram(datagram: u64, len: u64) | SendTo(datagram: u64, root: u64, path: u64, len: u64) | RecvDatagram(datagram: u64, room: u64) | Ready(socket: u64) | LocalAddr(id: u64) | PeerAddr(socket: u64) | UdpOpen(v6: bool, slots: u32, slot_bytes: u32) | UdpBind(addr: Addr, slots: u32, slot_bytes: u32, members: u16, steer: Steer) | UdpRecv(socket: u64, room: u64, entries: u64) | UdpSend(socket: u64, data: u64, pkts: u64) | UdpLocal(socket: u64) | Hello(socket: u64, room: u64) | Serve(socket: u64, chain: u64, alpn: u64)

pub type NetReply = Done | Failed(NetError) | Count(u64) | Socket(u64, Addr) | Listener(u64, Addr) | Secured(Handshake) | UnixSocket(u64) | UnixListening(u64) | Datagram(u64) | Packet(len: u64, truncated: bool) | Address(Addr) | UdpSockets(first: u64, count: u16, addr: Addr) | UdpPackets(count: u64) | Accepted(protocol: Option[u64])

pub type Kind = File | Directory | Symlink | Other

pub type Stat {
    kind: Kind,
    size: u64,
    modified_ns: i64
}

pub type OpenMode = Read | Write | Append | CreateNew | ReadWrite | Durable | Direct

pub type Capacity {
    requested: u64,
    available: u64
}

pub type Argon2Cost {
    memory_kib: u32,
    passes: u32,
    lanes: u32
}

pub type Argon2Error = Params | Capacity(Capacity)

pub type OutOfTime {
    steps: u64
}

pub type Closed[T] = Closed(T)

pub type SendError[T] = Full(T) | Closed(T)

pub type ReceiveError = Empty | Closed

pub type InboxError = Closed | Capacity(Capacity)

pub type InboxPoll = Empty | Closed | Capacity(Capacity)

pub type JoinError = Failed(Causes) | Cancelled(Causes)

pub opaque type Site

/// Returns the native site word within the current program image.
pub fn site_word(site: Site) -> u64

// A cause chain, owned. Read it with `for c in causes`: a view of each Cause, primary
// cause first (docs/spec/core.md, "Built-in types").
pub opaque type Causes

// A task-local cell: one value, written through a view (MEM-29).
pub opaque type Cell[T]

pub opaque type StaticFn[F]

pub type Cause {
    kind: CauseKind,
    site: Site
}

pub type CauseKind = Overflow | Bounds | Division | Unwrap | Fail(String) | Cancelled | Capacity(Capacity) | OutOfTime | Stack

pub type BuildError = Overflow()

pub type IoError = NotFound | Denied | Exists | Closed | Other(u32)

pub type WriteError {
    written: u64,
    error: IoError
}

pub type ParseError = Empty | Invalid(u64) | OutOfRange

pub type FloatError = NaN | OutOfRange

pub fn fail(take msg: String) -> Never

/// Ends the owner here, including its implicit finalizer.
pub fn drop[T](take x: T) {}

pub fn isolate[R](body: scoped fn() -> R) -> Result[Result[R, Causes], Capacity]

pub fn replace[T](mut q: T, take v: T) -> T

pub fn clone[T, U](x: T) -> U

pub fn clone_in[T, U](r: Region, x: T) -> U in r

pub fn build_in[T](r: Region, bytes n: u64, w: scoped fn(mut Dest[T]) -> Result[Child[T], BuildError]) -> Result[Builder[T, in r], BuildError]

pub fn finish[T, in r](take b: Builder[T, in r]) -> T in r

pub fn finish_trim[T, in r](take b: Builder[T, in r]) -> T in r

pub fn build_stream_in[T: streamable](r: Region, bytes n: u64, w: scoped fn(take Writer[T, in r]) -> Result[Child[T], BuildError]) -> Result[Builder[T, in r], BuildError]

// `emit` is a built-in form: x is a construction literal of a compact T, a value of a scalar,
// a plain literal, a view of a String for Text or of a List for FixedSpan, and a field's
// operand in a literal may be `emit(f)` with f a scoped callback taking that field's writer (MEM-4).
pub fn emit[T, in r](take w: Writer[T, in r], x: T) -> Result[Child[T], BuildError]

// An unanchored replacement that reads the captured scalar is OWN-21.
// expect: refuse OWN-21 at 9:9
fn checked() -> u64 {
    let mut n: u64 = 7
    let mut cb = scoped fn() -> u64 {
        n
    }
    let change = scoped fn() {
        cb = scoped fn() -> u64 {
            n += 1;
            n
        }
    }
    change()
    cb()
}

fn accept_cutover(mut db: Db, request: Cutover) -> Result[KeptImport, DeployError] waits {
    deploy_result(healthy(db))?
    if !is_disk(db) {
        return Error(ExportMismatch)
    }
    let final_item = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    deploy_result(durable(mut db, final_item))?
    let finished = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Option[KeptImport] {
        replace(mut state.imported, None)
    })
    let Some(take staged) = take finished else {
        return Error(ExportMismatch)
    }
    let agrees = {
        let base = view staged.meta.base
        staged.digest == request.digest && base.attempt == request.attempt && base.opened == open_number(db) && base.store_hi == db.store.hi && base.store_lo == db.store.lo && base.branch == 0
    }
    if !agrees {
        return Error(ExportMismatch)
    }
    Ok(take staged)
}

// V2 can be observed while the admission timer and control inbox are live.
// The head remains the sole reader of both writers' acknowledgement channels.
pub fn cutover_settled(mut db: Db) -> Result[bool, Error] {
    healthy(db)?
    if !is_disk(db) {
        return Ok(true)
    }
    journal_poll(mut db)?
    Ok(covered(db, Journal(db.frame_seq, 0, 0)))
}

fn install_prepared[V](mut db: Db, request: Cutover, current_activation: u64, old_describe: Bytes, release_codec: std.codec.Codec[V], release_from: fn(PreparedTarget, Inline[u8, 32]) -> Result[V, DeployError], target_binding: Option[Inline[u8, 32]], before_cut: scoped fn() -> bool) -> Result[u64, DeployError] waits {
    let staged = accept_cutover(mut db, request)?
    let base = view staged.meta.base
    if pages.holder_heads(db.holders)[0].head != base.head || catalog.next_table_id(db.schema) != base.next_table || current_activation != base.activation {
        return Error(Drift)
    }
    let target = view staged.meta.target
    if let Some(wanted) = target.limits {
        if !types.same_limits(limits_to_rep(wanted), limits_to_rep(db.limits)) {
            return Error(Store(LimitsDiffer(db.limits)))
        }
    }
    if let Some(problem) = types.journal_floor(target.checkpoint_bytes, target.journal_limit, db.limits.frame) {
        return Error(FullNew(Journal(problem)))
    }
    let disk_limit = disk_state(db).options.resident_limit
    let mut schema_change = schema_plan(db)
    schema_change.schema.ceiling = disk_limit
    planned_catalog(mut schema_change, staged.delta)?
    let ranges = kept_ranges(staged)?
    planned_ranges(mut schema_change, ranges)?
    let has_tiered = pages.tiered_collections(schema_change.schema.roots.collections.root) || store_has_tiered(db)
    let started_pager = if has_tiered {
        match db.pager {
            Some(_) => false,
            None => {
                deploy_result(start_residency_pager(mut db))?
                true
            },
        }
    } else {
        false
    }
    if let Error(take problem) = apply_import_rewrites_tiered(db, mut schema_change, staged.rewrites) {
        if started_pager {
            stop_residency_pager(mut db)
        }
        return Error(take problem)
    }
    // STORE-SPEC §1.2: a release activates only over Public indexes.
    if let Some(take name) = deploy_result(unready_index(schema_change.schema.roots.catalog))? {
        if started_pager {
            stop_residency_pager(mut db)
        }
        return Error(Store(NotReady(take name)))
    }
    let tiered_reserve = tiered_plan_reserve(disk_state(db).options)
    schema_change.schema.next_table = staged.meta.next_table
    schema_change.schema.live = install_account(db, schema_change.schema.roots)?
    let admitted_before = if has_tiered {
        int.saturating_add(schema_change.schema.live, tiered_reserve)
    } else {
        schema_change.schema.live
    }
    deploy_result(failure_result_from_rep(catalog.over_ceiling(admitted_before, disk_limit)))?
    let mut installation = staged_migration(db, take schema_change, false, list.new())
    let Some(release_at) = int.checked_add(base.head, 1u64) else {
        return Error(Store(Limit(Ids)))
    }
    let activation_update = if object_writer_open(db) {
        let Some(schema_binding) = target_binding else {
            return Error(Store(Missing("binding")))
        }
        Some(HistoryActivation(number: release_at, binding: schema_binding))
    } else {
        None
    }
    let prior = deploy_result(failure_result_from_rep(types.copied(old_describe)))?
    let release = release_from(target, request.digest)?
    deploy_result(stage_activation(mut installation, release_at, Some(take prior), target.describe, release_codec, release))?
    installation.plan.schema.live = install_account(db, installation.plan.schema.roots)?
    let admitted_after = if has_tiered {
        int.saturating_add(installation.plan.schema.live, tiered_reserve)
    } else {
        installation.plan.schema.live
    }
    deploy_result(failure_result_from_rep(catalog.over_ceiling(admitted_after, disk_limit)))?
    if host.mono_ns(db.clock) >= request.deadline || !before_cut() {
        if started_pager {
            stop_residency_pager(mut db)
        }
        return Error(Expired)
    }
    db.ceiling = disk_limit
    let limits = manifest.TargetLimits(resident: target.resident_limit, pack: target.pack_bytes, checkpoint: target.checkpoint_bytes, journal: target.journal_limit, frame: db.limits.frame, tiered_reserve: tiered_reserve, has_tiered: has_tiered)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        state.target = Some(limits)
    })
    let StagedMigration(plan: take ready, ..) = take installation
    // The same cut drops the import pin: the installed main now holds its pages.
    let import_slot = import_pin_slot(db)
    let installed = publish_schema_plan_binding(mut db, take ready, activation_update, import_slot)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        state.target = None
    })
    match take installed {
        Ok(_) => Ok(release_at),
        Error(Full(cause)) => {
            if started_pager {
                stop_residency_pager(mut db)
            }
            Error(FullNew(cause))
        },
        Error(take fault) => {
            if started_pager {
                stop_residency_pager(mut db)
            }
            Error(Store(take fault))
        },
    }
}

// The runner has paused admission and settled its workers before this call.
pub fn perform_cutover[V](mut db: Db, request: Cutover, current_activation: u64, old_describe: Bytes, release_codec: std.codec.Codec[V], release_from: fn(PreparedTarget, Inline[u8, 32]) -> Result[V, DeployError], before_cut: scoped fn() -> bool) -> Result[u64, DeployError] waits {
    perform_cutover_with(mut db, request, current_activation, old_describe, release_codec, release_from, None, before_cut)
}

/// Installs a validated preparation and publishes the object store's release binding with it.
pub fn perform_bound_cutover[V](mut db: Db, request: Cutover, current_activation: u64, old_describe: Bytes, release_codec: std.codec.Codec[V], release_from: fn(PreparedTarget, Inline[u8, 32]) -> Result[V, DeployError], target_binding: Inline[u8, 32], before_cut: scoped fn() -> bool) -> Result[u64, DeployError] waits {
    perform_cutover_with(mut db, request, current_activation, old_describe, release_codec, release_from, Some(target_binding), before_cut)
}

fn perform_cutover_with[V](mut db: Db, request: Cutover, current_activation: u64, old_describe: Bytes, release_codec: std.codec.Codec[V], release_from: fn(PreparedTarget, Inline[u8, 32]) -> Result[V, DeployError], target_binding: Option[Inline[u8, 32]], before_cut: scoped fn() -> bool) -> Result[u64, DeployError] waits {
    let outcome = install_prepared(mut db, request, current_activation, old_describe, release_codec, release_from, target_binding, before_cut)
    if is_disk(db) {
        forget_import(mut db)
    }
    take outcome
}

fn forget_import(mut db: Db) {
    db.ceiling = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> u64 {
        state.imported = None
        state.reserving = None
        state.lease = None
        state.steps = list.new()
        if let Some(mut object_writer) = state.object {
            object_writer.export_lifetime = None
        }
        state.options.resident_limit
    })
}

/// CRC-32C of b, with initial/final complement. Empty is zero; "123456789"
/// is 0xe3069283. Allocates nothing. Cost: O(len(b)).
fn crc32c(b: Bytes) -> u32 {
    crc32c_append(0, b)
}

/// CRC-32C of prefix followed by b, where prefix is the CRC of the prefix bytes.
/// Allocates nothing; accepts arbitrary byte chunks, including an empty chunk.
fn crc32c_append(prefix: u32, b: Bytes) -> u32 {
    let mut crc = prefix ^ 0xffffffffu32
    for byte in b {
        let i: u8 = int.truncate(crc ^ int.widen(byte))
        crc = CRC[int.widen(i)] ^ (crc >> 8)
    }
    crc ^ 0xffffffffu32
}

// R9: 10,000 CRCs of the same 4-KiB image. Runtime Args prevents constant folding.
pub fn main(argv: Args, out: Stdout) -> Result[(), Exit] waits {
    let argument = option.unwrap(args.get(argv, 0))
    let loops: u64 = result.unwrap(int.parse(argument))
    let mut image: Bytes = list.with_capacity(4096)
    for i in 0u64 .. 4096 {
        list.push(mut image, int.truncate(i * 17 + 3))
    }
    let mut crc: u32 = 0
    for _ in 0u64 .. loops {
        crc = crc32c_append(crc, image)
    }
    let mut rendered = string.new()
    string.push_u64(mut rendered, int.widen(crc))
    string.push(mut rendered, "\n")
    match stdout.write(out, rendered) {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 8))
    }
}

type IndexBuildSchema {
    rows: Table[u64, u64],
    by_v: Index[u64, u64, u64, ()],
    by_sum: Aggregate[u64]
}

fn location_group(k: u64, value: Bytes) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.with_capacity(1)
    let tag: u64 = int.widen(value[0u64])
    list.push(mut keys, tag * 4 + k % 4)
    Ok(take keys)
}

fn location_owner(k: u64, _value: Bytes) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.with_capacity(1)
    list.push(mut keys, 0xffffffffffffffffu64 - k)
    Ok(take keys)
}

fn location_index_schema(mut db: Db, mode: Mode) -> Result[(Table[u64, Bytes], Index[u64, u64, Bytes, ()], Index[u64, u64, Bytes, ()]), Error] waits {
    let mut d = declare(db, mode)?
    let key = std.codec.key_u64()
    let mut declared = declare_table(mut d, "rows", key, std.codec.of_bytes())?
    let grouped = index(mut d, mut declared, "by_group", Many, code.describe(location_group), key)?
    let owners = index(mut d, mut declared, "by_owner", Unique, code.describe(location_owner), key)?
    let rows = finish(mut d, take declared)?
    let _ = seal(mut db, take d)?
    Ok((rows, take grouped, take owners))
}

// Compare the complete index against the ordered (index key, primary key)
// pairs from a table scan of the same recovered snapshot.
fn exact_index_entries[V](tx: Tx, ix: Index[u64, u64, V, ()], take expected: List[(u64, u64)]) -> Result[bool, Error] {
    let mut keys = take expected
    list.sort(mut keys, order.compare)
    let mut actual = entries(tx, ix, Unbounded, Unbounded)?
    for (key, primary) in keys {
        if next_entry(mut actual)? != Some((key, primary, ())) {
            return Ok(false)
        }
    }
    Ok(next_entry(mut actual)? == None)
}

fn location_indexes_match(tx: Tx, input: (Table[u64, Bytes], Index[u64, u64, Bytes, ()], Index[u64, u64, Bytes, ()])) -> Result[bool, Error] {
    let mut rows = range(tx, input.0, Unbounded, Unbounded)?
    let mut grouped: List[(u64, u64)] = list.new()
    let mut owners: List[(u64, u64)] = list.new()
    while let Some((key, value)) = next_in(tx, mut rows)? {
        let groups = capacity(location_group(key, value))?
        for group in groups {
            list.push(mut grouped, (group, key))
        }
        let unique = capacity(location_owner(key, value))?
        list.push(mut owners, (unique[0u64], key))
    }
    Ok(list.len(owners) == 6666 && exact_index_entries(tx, input.1, take grouped)? && exact_index_entries(tx, input.2, take owners)?)
}

fn index_build_entries_match(tx: Tx, input: (Table[u64, u64], Index[u64, u64, u64, ()])) -> Result[bool, Error] {
    let mut rows = range(tx, input.0, Unbounded, Unbounded)?
    let mut expected: List[(u64, u64)] = list.new()
    while let Some((key, value)) = next_in(tx, mut rows)? {
        list.push(mut expected, (value, key))
    }
    Ok(list.len(expected) == 96 && exact_index_entries(tx, input.1, take expected)?)
}

fn index_build_parts(k: u64, v: u64) -> Result[List[(u64, u64)], Capacity] {
    let mut parts: List[(u64, u64)] = list.with_capacity(3)
    list.push(mut parts, (k % 5, v))
    list.push(mut parts, (k % 5, 1u64))
    if v % 2 == 0 {
        list.push(mut parts, (5 + k % 3, v))
    }
    Ok(take parts)
}

fn index_build_open(d: Dir, c: Clock, r: Random, tasks: Tasks, create: bool) -> Result[(Db, IndexBuildSchema), Error] waits {
    let mut options = disk_crash_options("index-build")
    options.create = create
    let mut db = open(tasks, d, c, r, options)?
    let schema = index_build_schema(mut db, Open)?
    Ok((take db, take schema))
}

fn index_build_schema(mut db: Db, mode: Mode) -> Result[IndexBuildSchema, Error] waits {
    let mut d = declare(db, mode)?
    let mut declared = declare_table(mut d, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let ix = index(mut d, mut declared, "by_v", Many, code.describe(crash_value), std.codec.key_u64())?
    let groups = aggregate(mut d, mut declared, "by_sum", code.describe(index_build_parts), std.codec.key_u64())?
    let t = finish(mut d, take declared)?
    let _ = seal(mut db, take d)?
    Ok(IndexBuildSchema(rows: t, by_v: take ix, by_sum: groups))
}

fn index_build_init(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    disk_crash_init(d, c, r, tasks, "index-build")?
    let mut db = open(tasks, d, c, r, disk_crash_options("index-build"))?
    let _ = index_build_schema(mut db, Migrate)?
    let _ = checkpoint(mut db)?
    close(take db)
}

// Demotes both indexes and rebuilds them in chunks of 16 rows, one row changing
// between chunks (behind the cursor or ahead of it).
fn index_build_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let (take opened, schema) = index_build_open(d, c, r, tasks, true)?
    let mut db = take opened
    rebuild_index(mut db, schema.by_v)?
    rebuild_aggregate(mut db, schema.by_sum)?
    let mut round = 0u64
    while let Some(_) = index_build_step(mut db, 16)? {
        let k = (round * 37) % 96
        lix_write(mut db, schema.rows, k, Some(k + 500))?
        round += 1
    }
    close(take db)
}

// Fold the table independently of the extractor and aggregate read path.
// Compare the exact collection, including its size, so extra groups fail.
fn index_build_sums_match(db: Db, schema: IndexBuildSchema) -> Result[bool, Error] waits {
    let mut members: Inline[u64, 8] =[0; 8]
    let mut sums: Inline[u64, 8] =[0; 8]
    let image = snapshot(db)
    let reading = reader(db, 0)?
    for k in 0u64 .. 96 {
        let Some(v) = get(reading, image, schema.rows, k)? else {
            return Ok(false)
        }
        members[k % 5] += 1
        sums[k % 5] += v + 1
        if v % 2 == 0 {
            members[5 + k % 3] += 1
            sums[5 + k % 3] += v
        }
    }
    let id = schema.by_sum.id
    let mut stored = byte_cursor(image.roots.collections, Included(prefix(id)?), prefix(id + 1)?)?
    for group in 0u64 .. 8 {
        let Some((key, raw)) = next_bytes(mut stored)? else {
            return Ok(false)
        }
        if list.len(key) != 12 || list.len(raw) != 16 {
            return Ok(false)
        }
        let found_group: u64 = list.word_be(key, 4)
        if found_group != group || read_le(raw, 0, 8) != members[group] || read_le(raw, 8, 8) != sums[group] {
            return Ok(false)
        }
    }
    Ok(match next_bytes(mut stored)? {
        None => true,
        Some(_) => false,
    })
}

fn index_build_read(d: Dir, c: Clock, r: Random, tasks: Tasks, required_new: bool) -> Result[bool, Error] waits {
    let (take opened, schema) = index_build_open(d, c, r, tasks, false)?
    let mut db = take opened
    trust_store(mut db)?
    let mut good = !required_new
    if lix_serves(db, schema.by_v, "by_v")? {
        let handles: (Table[u64, u64], Index[u64, u64, u64, ()]) = (clone(schema.rows), clone(schema.by_v))
        let Seen(Seen(value: take matches, ..)) = look(reader(db, 0)?, snapshot(db), None, handles, index_build_entries_match)? else {
            return Ok(false)
        }
        good = matches?
    }
    if let Public = lix_state(db, "by_sum")? {
        good = good && index_build_sums_match(db, schema)?
    } else {
        good = good && !required_new
    }
    // Resume the aggregate before overwrites can hide an incorrect total.
    while let Backfilling(_) = lix_state(db, "by_sum")? {
        if let None = index_build_step(mut db, 16)? {
            return Ok(false)
        }
    }
    good = good && index_build_sums_match(db, schema)?
    for k in 0u64 .. 96 {
        lix_write(mut db, schema.rows, k, Some(k + 2000))?
    }
    while let Some(_) = index_build_step(mut db, 16)? {}
    good = good && lix_serves(db, schema.by_v, "by_v")? && index_build_sums_match(db, schema)?
    let id = schema.by_v.id
    let mut expected: List[Bytes] = list.new()
    for k in 0u64 .. 96 {
        let mut logical = prefix(id)?
        list.put_word_be(mut logical, k + 2000)
        list.put_word_be(mut logical, k)
        list.push(mut expected, take logical)
    }
    good = good && lix_entries(db, id)? == expected
    trust_indexes(mut db)?
    close(take db)?
    Ok(good)
}

fn d7_index_write(mut db: Db, rows: Table[u64, u64], key: u64, value: u64) -> Result[(), Error] waits {
    let ran = run(mut db, Some(100000), (copy_env(rows), key, value), fn(mut tx, input) -> Result[(), Error] {
        put(mut tx, input.0, input.1, input.2)
    })?
    match take ran {
        Committed(done) => durable(mut db, done.ticket),
        Aborted(Undone(value: take problem, ..)) => Error(take problem),
        _ => fail("L68: expected a committed write to the Tiered index"),
    }
}

fn d7_demote_input(d: Dir, c: Clock, r: Random, tasks: Tasks, overwrite: bool) -> Result[(Db, IndexBuildSchema), Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(182375272)?)?
    let schema = index_build_schema(mut db, Migrate)?
    d7_index_write(mut db, schema.rows, 1u64, 10u64)?
    // The fixture skips only set_residency's public kind check.
    residency_to_tiered(mut db, schema.by_v.id, prefix(schema.by_v.id)?)?
    {
        let base = view db.heads[0].roots.collections
        let Some((ColdPage(_), descriptor)) = std.page.collection_slot(base.root, prefix(schema.by_v.id)?) else {
            fail("L68: the checkpoint must store the index in a Cold leaf")
        }
        if collection_descriptor(descriptor).row_bytes != 86 {
            fail("L68: the initial Many entry has a 20-byte key and an empty payload")
        }
    }
    let primary = if overwrite {
        1u64
    } else {
        2u64
    }
    d7_index_write(mut db, schema.rows, primary, 20u64)?
    close(take db)?
    let mut reopened = open(tasks, d, c, r, l70_open_options(182375272)?)?
    let rebound = index_build_schema(mut reopened, Open)?
    {
        let tree = view reopened.heads[0].roots.collections
        let inserted = law_read_key(rebound.by_v.id, 20u64, Some(primary))
        let Some(ReplayRow(base: 0, now: ReplayPut(raw))) = tiered_replayed_row(tree, inserted) else {
            fail("L68: the durable insert must replay with prior zero")
        }
        if list.len(raw) != 0 {
            fail("L68: the replayed Many payload must be empty")
        }
        let old = law_read_key(rebound.by_v.id, 10u64, Some(1u64))
        if overwrite {
            let Some(ReplayRow(base: 1, now: ReplayAbsent)) = tiered_replayed_row(tree, old) else {
                fail("L68(f): deleting a present empty payload needs prior one")
            }
        } else if let Some(_) = tiered_replayed_row(tree, old) {
            fail("L68(g): the insert-only suffix must keep the original entry")
        }
    }
    Ok((take reopened, take rebound))
}

fn d7_check_demoted(db: Db, schema: IndexBuildSchema, primary: u64) -> Result[(), Error] {
    let Backfilling(None) = lix_state(db, "by_v")? else {
        fail("L68: the schema cut must publish Backfilling(None)")
    }
    let tree = view db.heads[0].roots.collections
    let Some((HotPage(root), fields)) = std.page.collection_slot(tree.root, prefix(schema.by_v.id)?) else {
        fail("L68: the schema cut must publish the empty index root")
    }
    let descriptor = collection_descriptor(fields)
    if descriptor.residency != ResidentTiered || descriptor.rows != 0 || descriptor.row_bytes != 0 || std.page.totals(root) != (0u64, 0u64) {
        fail("L68: superseded entries must not reappear in the rebuilt root")
    }
    if let Some(_) = tiered_replayed_row(tree, law_read_key(schema.by_v.id, 20u64, Some(primary))) {
        fail("L68: the new root must not retain the old overlay")
    }
    let logical = law_read_key(schema.rows.id, primary, None)
    let Some(raw) = get_page_row(tree, logical) else {
        fail("L68: the acknowledged table row must survive demotion")
    }
    if read_le(raw, 2, 8) != 20u64 {
        fail("L68: the table row must retain its acknowledged value")
    }
    Ok(())
}

// Seal the real demotion candidate through the same cut used by rebuild.
fn d7_demote_seal(mut db: Db, schema: IndexBuildSchema) -> Result[Bytes, Error] waits {
    let mut plan = schema_plan(db)
    if !demote_index(mut plan, schema.by_v.catalog_key)? {
        fail("L68(f): the fixture must start with a Public index")
    }
    let SchemaPlan(roots: take roots, next_node: ids, next_table: tables, superseded: take superseded, ..) = take plan
    db.next_node = ids
    let replacement = ProposedMain(roots: take roots, head: db.heads[0].head + 1, at: db.heads[0].at, tables: tables, activation: None, drop_pin: None, superseded: take superseded)
    refused_cut_bytes(mut db, ReplaceMain(take replacement, None))
}

fn d7_demote_law(d: Dir, c: Clock, r: Random, tasks: Tasks, overwrite: bool, drift: bool) -> Result[(), Error] waits {
    let (take opened, schema) = d7_demote_input(d, c, r, tasks, overwrite)?
    let mut db = take opened
    let primary = if overwrite {
        let sealed = d7_demote_seal(mut db, schema)?
        close(take db)?
        let name = if drift {
            "MANIFEST.tmp"
        } else {
            "MANIFEST"
        }
        disk_write_synced(d, name, sealed)?
        1u64
    } else {
        rebuild_index(mut db, schema.by_v)?
        d7_check_demoted(db, schema, 2u64)?
        close(take db)?
        2u64
    }
    let mut recovered = open(tasks, d, c, r, l70_open_options(182375272)?)?
    let rebound = index_build_schema(mut recovered, Open)?
    if drift {
        let Public = lix_state(recovered, "by_v")? else {
            fail("L68(f): the previous catalog survives a refused schema cut")
        }
        let inserted = law_read_key(rebound.by_v.id, 20u64, Some(1u64))
        if let None = tiered_replayed_row(recovered.heads[0].roots.collections, inserted) {
            fail("L68(f): the previous overlay survives a refused schema cut")
        }
        let mut evidence: List[(u32, u32)] = list.new()
        list.push(mut evidence, (rebound.rows.id, rebound.by_v.id))
        trip_drift(mut recovered, 0, evidence)?
    }
    d7_check_demoted(recovered, rebound, primary)?
    close(take recovered)
}

@test
fn test_l68_demote_prior_one(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    d7_demote_law(d, c, r, tasks, true, false)
}

@test
fn test_l68_drift_before_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    d7_demote_law(d, c, r, tasks, true, true)
}

@test
fn test_l68_demote_insert(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    d7_demote_law(d, c, r, tasks, false, false)
}

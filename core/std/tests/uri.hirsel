fn port_is(text: String, expected: u16) -> bool {
    let u = result.unwrap(uri.parse(text))
    uri.port_number(text, u) == Some(expected) && recomposes(text)
}

// U3. RFC 3986 §3.2.3, rfc3986.txt:1158-1182 and retired SEM-3-uri-strict-numeric.
// Mutants: reject a long string of leading zeros, or truncate at 16 bits.
// expect: run numeric_ports() = true
fn numeric_ports() -> bool {
    port_is("https://example.test:0/", 0) && port_is("https://[::1]:080/", 80) && port_is("https://example.test:0000000000000000000080/", 80) && port_is("https://[::1]:65535/", 65535) && invalid("https://[::1]:65536/", 14) && invalid("https://example.test:999999999999999999999999999999999999/", 21)
}

fn quote_table(set: uri.Set, oracle: String) -> bool {
    let mut raw: Bytes = list.new()
    let mut coded = string.new()
    let mut decoded: Bytes = list.new()
    let mut at: u64 = 0
    for i in 0u64 .. 256 {
        list.clear(mut raw)
        result.unwrap(list.push(mut raw, int.narrow(i)))
        string.truncate(mut coded, 0)
        list.clear(mut decoded)
        let end = match string.find(oracle, at, "|") {
            Some(p) => p,
            None => string.byte_len(oracle)
        }
        result.unwrap(uri.encode(mut coded, raw, set))
        if coded != string.slice(oracle, at, end) {
            return false
        }
        result.unwrap(uri.decode(coded, full(coded), mut decoded))
        if decoded != raw {
            return false
        }
        at = end + 1
    }
    at == string.byte_len(oracle) + 1
}


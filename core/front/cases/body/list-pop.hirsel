// Pop transfers the last element and preserves the allocation (b"abc" owns capacity 3).
// expect: accept
// expect: run values() = 110704
// expect: run empty() = 0
// expect: run static_value() = 990203
// expect: run resource_value() = 7 trace 7
fn pop[T](mut xs: List[T]) -> Option[T] {
    list.pop(mut xs)
}

fn values() -> u64 {
    let mut xs: List[u64] = list.new()
    result.unwrap(list.push(mut xs, 7u64))
    result.unwrap(list.push(mut xs, 11u64))
    let b = option.unwrap(pop(mut xs))
    let a = option.unwrap(pop(mut xs))
    b * 10000 + a * 100 + list.capacity(xs)
}

fn empty() -> u64 {
    let mut xs: List[u64] = list.new()
    match pop(mut xs) {
        None => list.capacity(xs),
        Some(_) => 999
    }
}

fn static_value() -> u64 {
    let mut xs = result.unwrap(b"abc")
    let last: u64 = int.widen(option.unwrap(pop(mut xs)))
    last * 10000 + list.len(xs) * 100 + list.capacity(xs)
}

resource type Mark {
    id: u64
} drop(m) {
    let _ = m.id
}

fn resource_value() -> u64 {
    let mut xs: List[Mark] = list.new()
    result.unwrap(list.push(mut xs, result.unwrap(Mark(id: 7))))
    let x = option.unwrap(list.pop(mut xs))
    x.id + list.len(xs)
}

fn bytes_of(s: String) -> Bytes { string.into_bytes(clone(s)) }

// The same body fed in pieces of `size` bytes, so every event boundary and
// every line ending falls inside a chunk at least once across the sizes used.
fn read_in(d: provider.Dialect, body: String, size: u64) -> Result[harness.Answer, harness.ModelFault] {
    let all = bytes_of(body)
    let b = provider.bounds()
    let mut dec = provider.decoder(b)
    let mut st = provider.stream(d, b)
    let mut at = 0u64
    let n = list.len(all)
    while at < n {
        let mut piece: Bytes = list.new()
        let mut j = at
        while j < n && j < at + size {
            list.push(mut piece, all[j])
            j += 1u64
        }
        if provider.feed(mut dec, mut st, piece)? { break }
        at = j
    }
    std.sse.finish(mut dec)
    provider.answer(take st)
}

fn args_are(c: harness.Call, pointer: String, want: String) -> bool {
    let Inline(raw) = view c.args else { return false }
    let Ok(take s) = string.from_utf8(clone(raw)) else { return false }
    region r {
        match std.json.parse(r, s) {
            Ok(x) => match std.json.pointer(x, pointer) {
                Some(Str(t)) => text.as_string(t) == want,
                _ => false,
            },
            Error(_) => false,
        }
    }
}

// The documented example: text "Okay, let's check the weather for San
// Francisco, CA:", one get_weather call whose partial_json pieces join to
// {"location": "San Francisco, CA"}, stop reason tool_use, 472 input tokens
// from message_start and 89 output tokens from the cumulative message_delta.
fn anthropic_ok(a: harness.Answer) -> bool {
    a.text == "Okay, let's check the weather for San Francisco, CA:"
        && list.len(a.calls) == 1u64
        && a.calls[0].id == "toolu_01T1x1fJ34qAmk2tNTrN7Up6"
        && a.calls[0].name == "get_weather"
        && args_are(a.calls[0], "/location", "San Francisco, CA")
        && a.stop == "tool_use"
        && a.usage.input == 472u64
        && a.usage.output == 89u64
}

fn openai_ok(a: harness.Answer) -> bool {
    a.text == "Checking now."
        && list.len(a.calls) == 2u64
        && a.calls[0].id == "call_abc"
        && a.calls[0].name == "get_weather"
        && args_are(a.calls[0], "/location", "Paris")
        && a.calls[1].id == "call_def"
        && a.calls[1].name == "get_time"
        && a.stop == "tool_calls"
        && a.usage.input == 31u64
        && a.usage.output == 17u64
}

// Law S1: a documented stream reads to the documented answer however the
// transport splits it. Answers the first failing chunk size, or 0.
@test
fn test_documented_streams_read() -> Result[(), u64] {
    let sizes = [1u64, 2u64, 7u64, 61u64, 100000u64]
    for s in sizes {
        match read_in(Anthropic, anthropic_docs(), s) {
            Ok(a) => if !anthropic_ok(a) { return Error(s) },
            Error(_) => return Error(s),
        }
        match read_in(OpenAi, openai_tools(), s) {
            Ok(a) => if !openai_ok(a) { return Error(1000000u64 + s) },
            Error(_) => return Error(1000000u64 + s),
        }
    }
    Ok(())
}

@test
fn test_stream_fits_notes_worker() -> Result[(), ()] {
    let decoded = bound bytes 131072u64 {
        match read_in(OpenAi, openai_tools(), 61u64) {
            Ok(a) => openai_ok(a),
            Error(_) => false,
        }
    }
    match decoded { Ok(true) => Ok(()), _ => Error(()) }
}

// Law S2: no answer without the success terminator. A stream that stops
// before `message_stop` or `[DONE]`, or carries an error event, has no
// answer: the request went out, so the worker must record doubt rather than
// seal a partial reply. Answers the failing case, or 0.
@test
fn test_answer_needs_terminator() -> Result[(), u64] {
    if let Ok(_) = read_in(Anthropic, anthropic_cut(), 100000u64) { return Error(1u64) }
    if let Ok(_) = read_in(Anthropic, anthropic_error(), 100000u64) { return Error(2u64) }
    if let Ok(_) = read_in(OpenAi, openai_cut(), 100000u64) { return Error(3u64) }
    // An Anthropic stream that is cut while a tool argument is half written.
    let docs = anthropic_docs()
    let half = string.from(string.slice(docs, 0u64, string.byte_len(docs) / 2u64 + 40u64))
    if let Ok(_) = read_in(Anthropic, half, 100000u64) { return Error(4u64) }
    Ok(())
}

fn request() -> harness.Request {
    let mut calls: List[harness.Call] = list.new()
    list.push(mut calls, harness.Call(id: "t1", name: "get_weather", args: Inline(bytes_of("{\"location\":\"Paris\"}"))))
    list.push(mut calls, harness.Call(id: "t2", name: "get_time", args: Inline(bytes_of("{}"))))
    let mut messages: List[harness.Entry] = list.new()
    list.push(mut messages, User("weather and time in Paris?"))
    list.push(mut messages, Assistant(harness.Answer(text: "", calls: take calls, stop: "tool_use", usage: harness.Usage(input: 0u64, output: 0u64, cache_read: 0u64, cache_write: 0u64, reasoning: 0u64))))
    list.push(mut messages, ToolResult("t1", Returned(Inline(bytes_of("sunny"))), harness.worded(Returned(Inline(bytes_of("sunny"))))))
    list.push(mut messages, ToolResult("t2", Failed("clock offline"), harness.worded(Failed("clock offline"))))
    let mut tools: List[harness.ToolDef] = list.new()
    list.push(mut tools, harness.ToolDef(name: "get_weather", about: "weather", input: "{\"type\":\"object\"}", rev: 1u64, catalog: None))
    let mut system: List[String] = list.new()
    list.push(mut system, "be brief")
    harness.Request(route: "m", system: take system, tools: take tools, messages: take messages, key: bytes_of("k"), stream: true, warm: false)
}

fn str_is(x: std.json.Json, p: String, want: String) -> bool {
    match std.json.pointer(x, p) { Some(Str(t)) => text.as_string(t) == want, _ => false }
}

fn is_true(x: std.json.Json, p: String) -> bool { match std.json.pointer(x, p) { Some(True) => true, _ => false } }
fn is_false(x: std.json.Json, p: String) -> bool { match std.json.pointer(x, p) { Some(False) => true, _ => false } }
fn is_obj(x: std.json.Json, p: String) -> bool { match std.json.pointer(x, p) { Some(Obj(_)) => true, _ => false } }
fn absent(x: std.json.Json, p: String) -> bool { match std.json.pointer(x, p) { None => true, _ => false } }

// Law W1: request bodies follow each provider's documented message shape.
// Anthropic: system is top level, both results of one assistant turn go in
// ONE user message as tool_result blocks (separate user messages are
// rejected), a failed call is marked is_error, and tool_use input is a JSON
// object. OpenAI: system is a message, assistant arguments are a JSON string,
// each result is its own `tool` message, and usage is requested so the final
// chunk can report spend. Answers the failing check, or 0.
@test
fn test_request_bodies_follow_wire_format() -> Result[(), u64] {
    let anth = provider.Model(dialect: Anthropic, name: "claude-x", max_tokens: 1024u64, cache_control: Off)
    let Ok(take a) = provider.body(anth, request()) else { return Error(1u64) }
    let ok_a = region r {
        match std.json.parse(r, a) {
            Ok(x) => {
                if !str_is(x, "/system", "be brief") { 2u64 }
                else if !is_true(x, "/stream") { 3u64 }
                else if !str_is(x, "/messages/1/role", "assistant") { 4u64 }
                else if !str_is(x, "/messages/1/content/0/type", "tool_use") { 5u64 }
                else if !str_is(x, "/messages/1/content/0/input/location", "Paris") { 6u64 }
                else if !is_obj(x, "/messages/1/content/1/input") { 7u64 }
                else if !str_is(x, "/messages/2/role", "user") { 8u64 }
                else if !str_is(x, "/messages/2/content/0/tool_use_id", "t1") { 9u64 }
                else if !is_false(x, "/messages/2/content/0/is_error") { 10u64 }
                else if !str_is(x, "/messages/2/content/1/tool_use_id", "t2") { 11u64 }
                else if !is_true(x, "/messages/2/content/1/is_error") { 12u64 }
                else if !absent(x, "/messages/3") { 13u64 }
                else if !is_obj(x, "/tools/0/input_schema") { 14u64 }
                else { 0u64 }
            },
            Error(_) => 15u64,
        }
    }
    if ok_a != 0u64 { return Error(ok_a) }
    let oai = provider.Model(dialect: OpenAi, name: "gpt-x", max_tokens: 1024u64, cache_control: Off)
    let Ok(take o) = provider.body(oai, request()) else { return Error(20u64) }
    let ok_o = region r {
        match std.json.parse(r, o) {
            Ok(x) => {
                if !str_is(x, "/messages/0/role", "system") { 21u64 }
                else if !str_is(x, "/messages/2/tool_calls/0/function/arguments", "{\"location\":\"Paris\"}") { 22u64 }
                else if !str_is(x, "/messages/3/role", "tool") { 23u64 }
                else if !str_is(x, "/messages/3/tool_call_id", "t1") { 24u64 }
                else if !str_is(x, "/messages/4/tool_call_id", "t2") { 25u64 }
                else if !is_true(x, "/stream_options/include_usage") { 26u64 }
                else if !is_obj(x, "/tools/0/function/parameters") { 27u64 }
                else { 0u64 }
            },
            Error(_) => 28u64,
        }
    }
    if ok_o != 0u64 { return Error(ok_o) }
    Ok(())
}

// ---- transport over a simulated TLS network ----
//
// A Secret leaves only over a verified TLS stream (TLS-5), so the transport
// law runs on std.sim.net, which answers the handshake for the provider's
// name. The provider is a scripted peer task.

const PEER: String = "api.provider.test"

type Link: send { port: Served[NetOp], clock: Clock, plan: std.sim.world.Plan, queue_bytes: u64 }

fn drive_clock(take input: std.sim.world.World) waits {
    let mut world = take input
    std.sim.world.run(mut world)
}

fn serve_link(take input: Link) waits {
    let Link(port: take port, clock: clock, plan: take initial, queue_bytes: queue_bytes) = take input
    let mut plan = take initial
    let mut cfg = std.sim.net.defaults()
    cfg.queue_bytes = queue_bytes
    let mut link = std.sim.net.new(cfg)
    std.sim.net.handshake_as(mut link, string.from(PEER), Ok(Handshake(protocol: Some(0), peer: (0, 0, 0, 0))))
    let _ = std.sim.net.serve(link, mut plan, clock, take port)
}

// What the scripted provider does after it has read the request body: send
// these bytes (possibly none) and close. std.sim.net confirms a SendSecret
// without delivering its bytes, so the request head (which carries the key)
// never reaches the peer; the peer reads the body, whose length the law
// computes from provider.body.
type Script: send { listener: Listener, clock: Clock, reply: Bytes, expect: u64, heard: Sender[Bytes] }

fn later(clock: Clock) -> Until { At(clock, host.mono_ns(clock) + 5000000000u64) }

fn scripted(take s: Script) -> () waits {
    let Script(listener: take l, clock: clock, reply: take reply, expect: expect, heard: heard) = take s
    let mut listener = take l
    let Ok((socket, _)) = host.accept(mut listener, later(clock)) else { return () }
    let (take input, take output) = net.split(take socket)
    let mut r = take input
    let mut w = take output
    let mut got: Bytes = list.with_capacity(65536u64)
    while list.len(got) < expect {
        let Ok(k) = host.recv_bounded(mut r, mut got, 65536u64, later(clock)) else { break }
        if k == 0u64 { break }
    }
    let _ = channel.send(heard, take got)
    let end = list.len(reply)
    let mut at = 0u64
    while at < end {
        let Ok(k) = host.send_pair(mut w, list.slice(reply, at, end), b"", later(clock)) else { break }
        if k == 0u64 { break }
        at += k
    }
}

fn reply_with(status: String, media: String, body: String) -> Bytes {
    let mut out = string.from("HTTP/1.1 ")
    string.push(mut out, status)
    string.push(mut out, "\r\nContent-Type: ")
    string.push(mut out, media)
    string.push(mut out, "\r\nConnection: close\r\n\r\n")
    string.push(mut out, body)
    string.into_bytes(take out)
}

fn route(d: provider.Dialect, at: Addr) -> provider.Provider {
    let mut uses = string.from("tls_send(")
    string.push(mut uses, PEER)
    string.push(mut uses, ")")
    provider.Provider(
        model: provider.Model(dialect: d, name: "m", max_tokens: 64u64, cache_control: Off),
        endpoint: provider.Endpoint(address: at, authority: PEER, prefix: "", security: Https(PEER, System)),
        key: result.unwrap(secret.seal(bytes_of("sk-test-0001"), uses)), bounds: provider.bounds(), deadline_ms: 5000u64)
}

fn simple_request() -> harness.Request {
    let mut messages: List[harness.Entry] = list.new()
    list.push(mut messages, User("weather in San Francisco?"))
    harness.Request(route: "m", system: list.new(), tools: list.new(), messages: take messages, key: bytes_of("k"), stream: true, warm: false)
}

// One exchange in a fresh simulated world. With `reply` = None nobody
// listens; otherwise the peer reads the request and sends the reply. Answers
// the result and the request bytes the peer heard.
fn exchange(tasks: Tasks, seed: u64, d: provider.Dialect, take reply: Option[Bytes]) -> (Result[harness.Answer, harness.ModelFault], String) waits {
    exchange_with_bounds(tasks, seed, d, take reply, provider.bounds())
}

fn exchange_with_bounds(tasks: Tasks, seed: u64, d: provider.Dialect, take reply: Option[Bytes], caps: provider.Bounds) -> (Result[harness.Answer, harness.ModelFault], String) waits {
    let mut sink: Option[harness.preview.Source] = None
    exchange_preview(tasks, seed, d, take reply, caps, simple_request(), mut sink)
}

fn exchange_preview(tasks: Tasks, seed: u64, d: provider.Dialect, take reply: Option[Bytes], caps: provider.Bounds, take req: harness.Request,
    mut sink: Option[harness.preview.Source]) -> (Result[harness.Answer, harness.ModelFault], String) waits {
    let (initial, clock) = std.sim.world.new(seed, 0u64, 0u64)
    let mut world = take initial
    let plan = std.sim.world.detach(mut world)
    let timer = task.spawn(tasks, bytes 65536u64, take world, drive_clock)
    let (n, port) = provide.net(bytes 4096u64)
    let link = task.spawn(tasks, bytes 4194304u64, Link(port: take port, clock: clock, plan: take plan, queue_bytes: 8u64), serve_link)
    let (listener, at) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433u32), port: 0u16), 1u16))
    let mut p = route(d, at)
    p.bounds = caps
    let mut said = string.new()
    let got = match take reply {
        None => {
            let _ = take listener
            provider.ask(n, clock, take p, take req)
        },
        Some(take bytes_out) => {
            let (heard, hears): (Sender[Bytes], Receiver[Bytes]) = channel.new(1u64)
            let expect = match provider.body(p.model, req) { Ok(b) => string.byte_len(b), Error(_) => 0u64 }
            let server = task.spawn(tasks, bytes 1048576u64, Script(listener: take listener, clock: clock, reply: take bytes_out, expect: expect, heard: take heard), scripted)
            let answered = provider.ask_with_preview(n, clock, take p, take req, mut sink)
            if let Ok(take b) = channel.receive(hears) {
                if let Ok(take s) = string.from_utf8(take b) { said = take s }
            }
            let _ = task.join(take server)
            take answered
        },
    }
    drop(take n)
    let _ = task.join(take link)
    let _ = task.join(take timer)
    (take got, take said)
}

fn has(s: String, part: String) -> bool { match string.find(s, 0u64, part) { Some(_) => true, None => false } }

// Law T1: distinguish a failure before send, an incomplete response, and an
// HTTP rejection. A complete stream yields its documented answer.
@test
fn test_doubt_only_after_send(tasks: Tasks, seed_grant: Env) -> Result[(), u64] waits {
    let seed = match std.sim.world.test_seed(seed_grant) { Some(n) => n, None => 0u64 }
    let (nobody, _) = exchange(tasks, seed, Anthropic, None)
    match nobody { Error(Rejected(_)) => (), _ => return Error(2u64) }
    let sse = "text/event-stream"
    let (whole, heard) = exchange(tasks, seed, Anthropic, Some(reply_with("200 OK", sse, anthropic_docs())))
    match whole { Ok(a) => if !anthropic_ok(a) { return Error(3u64) }, Error(_) => return Error(4u64) }
    if !has(heard, "\"stream\":true") { return Error(5u64) }
    let (cut, _) = exchange(tasks, seed, Anthropic, Some(reply_with("200 OK", sse, anthropic_cut())))
    match cut { Error(StreamDropped(_)) => (), _ => return Error(8u64) }
    let (silent, _) = exchange(tasks, seed, Anthropic, Some(list.new()))
    match silent { Error(StreamDropped(_)) => (), _ => return Error(9u64) }
    let (rejected, _) = exchange(tasks, seed, Anthropic, Some(reply_with("400 Bad Request", "application/json", "{\"type\":\"error\",\"error\":{\"type\":\"invalid_request_error\",\"message\":\"bad\"}}")))
    match rejected { Error(Rejected(why)) if why == "HTTP 400: bad" => (), _ => return Error(10u64) }
    let (overloaded, _) = exchange(tasks, seed, OpenAi, Some(reply_with("503 Service Unavailable", "application/json", "{\"error\":{\"message\":\"service warming up\"}}")))
    match overloaded { Error(Transient(why, 2u64)) if why == "HTTP 503: service warming up" => (), _ => return Error(16u64) }
    let (oai, oai_heard) = exchange(tasks, seed, OpenAi, Some(reply_with("200 OK", sse, openai_tools())))
    match oai { Ok(a) => if !openai_ok(a) { return Error(11u64) }, Error(_) => return Error(12u64) }
    if !has(oai_heard, "\"include_usage\":true") { return Error(13u64) }
    let (oai_cut, _) = exchange(tasks, seed, OpenAi, Some(reply_with("200 OK", sse, openai_cut())))
    match oai_cut { Error(StreamDropped(_)) => (), _ => return Error(15u64) }
    Ok(())
}

// Captured OpenRouter SSE body for the notes tool call, including usage.
fn openrouter_note() -> String { "data: {\"id\":\"gen-1795430590-zFvFoYoTcUHbGqw2GwuX\",\"object\":\"chat.completion.chunk\",\"created\":1795430590,\"model\":\"deepseek/deepseek-v4.1-flash-1017\",\"provider\":\"Particle AI\",\"choices\":[{\"index\":0,\"delta\":{\"content\":null,\"role\":\"assistant\",\"tool_calls\":[{\"index\":0,\"id\":\"call_5a03597ee4034608bed14b02\",\"type\":\"function\",\"function\":{\"name\":\"note_add\",\"arguments\":\"\"}}]},\"finish_reason\":null,\"native_finish_reason\":null}]}\n\ndata: {\"id\":\"gen-1795430590-zFvFoYoTcUHbGqw2GwuX\",\"object\":\"chat.completion.chunk\",\"created\":1795430590,\"model\":\"deepseek/deepseek-v4.1-flash-1017\",\"provider\":\"Particle AI\",\"choices\":[{\"index\":0,\"delta\":{\"content\":null,\"role\":\"assistant\",\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"{\\\"text\\\": \\\"The team meeting moved to Thursday.\\\"}\"}}]},\"finish_reason\":null,\"native_finish_reason\":null}]}\n\ndata: {\"id\":\"gen-1795430590-zFvFoYoTcUHbGqw2GwuX\",\"object\":\"chat.completion.chunk\",\"created\":1795430590,\"model\":\"deepseek/deepseek-v4.1-flash-1017\",\"provider\":\"Particle AI\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"\",\"role\":\"assistant\"},\"finish_reason\":\"tool_calls\",\"native_finish_reason\":\"tool_calls\"}]}\n\ndata: {\"id\":\"gen-1795430590-zFvFoYoTcUHbGqw2GwuX\",\"object\":\"chat.completion.chunk\",\"created\":1795430590,\"model\":\"deepseek/deepseek-v4.1-flash-1017\",\"provider\":\"Particle AI\",\"service_tier\":\"default\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"\",\"role\":\"assistant\"},\"finish_reason\":\"tool_calls\",\"native_finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":327,\"completion_tokens\":44,\"total_tokens\":371,\"cost\":0.00004382,\"is_byok\":false,\"prompt_tokens_details\":{\"cached_tokens\":0,\"cache_write_tokens\":0,\"audio_tokens\":0,\"video_tokens\":0},\"cost_details\":{\"upstream_inference_cost\":0.00004382,\"upstream_inference_prompt_cost\":0.00001962,\"upstream_inference_completions_cost\":0.0000242},\"completion_tokens_details\":{\"reasoning_tokens\":1,\"image_tokens\":0,\"audio_tokens\":0}}}\n\ndata: [DONE]\n\n" }

// Each event fits in 800 bytes. The full 1,907-byte response fits in 2,048.
@test
fn test_openrouter_body_and_event_bounds(tasks: Tasks, seed_grant: Env) -> Result[(), u64] waits {
    let seed = match std.sim.world.test_seed(seed_grant) { Some(n) => n, None => 0u64 }
    let mut caps = provider.bounds()
    caps.event_bytes = 800u64
    caps.body_bytes = 2048u64
    let (got, _) = exchange_with_bounds(tasks, seed, OpenAi, Some(reply_with("200 OK", "text/event-stream", openrouter_note())), caps)
    let Ok(a) = got else { return Error(1u64) }
    if a.text != "" || a.stop != "tool_calls" || a.usage.input != 327u64 || a.usage.output != 44u64 { return Error(2u64) }
    if list.len(a.calls) != 1u64 { return Error(3u64) }
    let c = a.calls[0]
    if c.id != "call_5a03597ee4034608bed14b02" || c.name != "note_add" || !args_are(c, "/text", "The team meeting moved to Thursday.") { return Error(4u64) }
    caps.body_bytes = 800u64
    let (too_large, _) = exchange_with_bounds(tasks, seed, OpenAi, Some(reply_with("200 OK", "text/event-stream", openrouter_note())), caps)
    match too_large { Error(Rejected(_)) => Ok(()), _ => Error(5u64) }
}

// The provider sends reasoning and tool arguments alongside assistant text.
// Only the literal assistant text is eligible for the gateway preview.
@test
fn test_preview_only_provider_text(tasks: Tasks, clock: Clock, seed_grant: Env) -> Result[(), u64] waits {
    let seed = match std.sim.world.test_seed(seed_grant) { Some(n) => n, None => 0u64 }
    let hub = harness.preview.start(tasks, 1048576u64, 4096u64)
    let door = harness.preview.door(hub)
    let caller = store.Caller(issuer: 2u8, subject: bytes_of("owner"))
    let target = harness.preview.target(door, "s0", clock)
    let watch = option.unwrap(harness.preview.observe(door, "s0", caller))
    let dispatch = runner.triggers.Id(store_hi: 1u64, store_lo: 2u64, branch: 0u32, version: 3u64, index: 0u64)
    let key = harness.preview.Key(dispatch: dispatch, run: 0u64, entry: 2u64, tool: None, attempt: 1u64)
    let mut sink = harness.preview.source(target, caller, key)
    let mut response = string.from("data: {\"choices\":[{\"delta\":{\"reasoning_content\":\"hidden reasoning\"}}]}\n\n")
    string.push(mut response, openai_tools())
    let (answer, _) = exchange_preview(tasks, seed, OpenAi, Some(reply_with("200 OK", "text/event-stream", response)), provider.bounds(), simple_request(), mut sink)
    let Ok(got) = answer else { return Error(1u64) }
    if !openai_ok(got) { return Error(2u64) }
    let Some(preview_text) = harness.preview.read(watch) else { return Error(3u64) }
    if preview_text.text != "Checking now." { return Error(4u64) }
    harness.preview.unobserve(take watch)
    harness.preview.stop(take hub)
    Ok(())
}

fn law_cache_usage() -> bool {
    // Anthropic's message_delta updates cumulative usage and can omit
    // counters already supplied by message_start.
    let anthropic = "data: {\"type\":\"message_start\",\"message\":{\"usage\":{\"input_tokens\":17,\"output_tokens\":1,\"cache_read_input_tokens\":120,\"cache_creation_input_tokens\":250}}}\n\ndata: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"end_turn\"},\"usage\":{\"output_tokens\":3}}\n\ndata: {\"type\":\"message_stop\"}\n\n"
    let openai = "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: {\"choices\":[],\"usage\":{\"prompt_tokens\":129,\"completion_tokens\":11,\"prompt_tokens_details\":{\"cached_tokens\":128},\"completion_tokens_details\":{\"reasoning_tokens\":8}}}\n\ndata: [DONE]\n\n"
    let Ok(a) = read_in(Anthropic, anthropic, 7u64) else { return false }
    let Ok(o) = read_in(OpenAi, openai, 2u64) else { return false }
    if a.usage.input != 17u64 || a.usage.output != 3u64 || a.usage.cache_read != 120u64 || a.usage.cache_write != 250u64 { return false }
    if o.usage.input != 129u64 || o.usage.output != 11u64 || o.usage.cache_read != 128u64 || o.usage.cache_write != 0u64 || o.usage.reasoning != 8u64 { return false }
    let mut model = provider.Model(dialect: Anthropic, name: "claude-x", max_tokens: 32u64, cache_control: Off)
    let mut req = request()
    list.push(mut req.tools, harness.ToolDef(name: "get_time", about: "time", input: "{}", rev: 1u64, catalog: None))
    list.push(mut req.messages, Note("not sent", list.new()))
    let Ok(off) = provider.body(model, req) else { return false }
    model.cache_control = Ephemeral
    let Ok(on) = provider.body(model, req) else { return false }
    !has(off, "\"cache_control\"") && region r {
        match std.json.parse(r, on) {
            Ok(x) => str_is(x, "/system/0/cache_control/type", "ephemeral")
                && str_is(x, "/system/0/text", "be brief")
                && str_is(x, "/tools/1/cache_control/type", "ephemeral")
                && str_is(x, "/messages/2/content/1/cache_control/type", "ephemeral")
                && absent(x, "/tools/0/cache_control")
                && absent(x, "/messages/2/content/0/cache_control")
                && absent(x, "/messages/1/content/1/cache_control")
                && absent(x, "/messages/0/content/0/cache_control"),
            Error(_) => false,
        }
    }
}

fn retry_model(clock: Clock, take req: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    std.clock.sleep_ns(clock, 0u64)
    Error(Rejected("test drives settlement"))
}

fn retry_entry(clock: Clock, caller: store.Caller, take key: harness.EffectKey) -> Result[(), Capacity] waits {
    std.clock.sleep_ns(clock, 0u64)
    Ok(())
}

fn retry_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    Ok(())
}

fn retry_effect(db: store.Db, h: harness.Handles, key: harness.EffectKey) -> harness.Effect waits {
    option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.effects, key)))
}

fn retry_pending(db: store.Db, h: harness.Handles, id: runner.triggers.Id) -> Option[runner.triggers.Pending] waits {
    result.unwrap(runner.triggers.next_pending(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.triggers, scoped fn(other) { other != id }))
}

fn file_fault(mut db: store.Db, h: harness.Handles, a: harness.Agent[Clock, ()], w: harness.Wiring, key: harness.EffectKey,
    p: runner.triggers.Pending, take fault: harness.ModelFault) -> u64 waits {
    let ran = store.run(mut db, None, (store.copy_env(a), store.copy_env(fault), store.copy_env(h), store.copy_env(key), store.copy_env(p), store.copy_env(w)), fn(mut tx, call_env) -> Result[harness.Filed, store.Error] {
        let started = runner.triggers.start(mut tx, call_env.2.triggers, call_env.4, b"revision") ?=> |err| {
            match err {
                NotDue => Missing("retry trigger is not due"),
                StaleAttempt => Missing("stale retry trigger"),
                _ => Missing("retry trigger failed to start"),
            }
        }
        let Body(attempt) = started else { return Error(Missing("started trigger")) }
        let Some(take saved) = store.fetch(tx, call_env.2.effects, call_env.3)? else { return Error(Missing("model effect")) }
        let mut e = take saved
        e.phase = Dispatched(runner.triggers.number(attempt))
        e.dispatches += 1u64
        store.put(mut tx, call_env.2.effects, call_env.3, e)?
        harness.settle(mut tx, call_env.2, call_env.0, call_env.5, attempt, harness.Settle(key: call_env.3, receipt: Some(ModelFailed(clone(call_env.1)))))
    })
    match take ran {
        Ok(Committed(store.Done(value: Recorded, info: info, ..))) => info.at,
        Ok(Committed(_)) => fail("model fault was ignored"),
        Ok(Aborted(store.Undone(value: Missing(take why), ..))) => fail(take why),
        _ => fail("model fault did not commit"),
    }
}

fn law_typed_retry(tasks: Tasks, random: Random, seed: u64) -> bool waits {
    let throttled = bytes_of("HTTP/1.1 429 Too Many Requests\r\nRetry-After: 7\r\nConnection: close\r\n\r\n{\"error\":{\"message\":\"slow down\"}}")
    let (limited, _) = exchange(tasks, seed, Anthropic, Some(take throttled))
    let Error(take throttle) = take limited else { return false }
    let throttled_as_sent = match throttle { Throttled(why, 7u64) => why == "HTTP 429: slow down", _ => false }
    if !throttled_as_sent { return false }
    let date = bytes_of("HTTP/1.1 503 Unavailable\r\nRetry-After: Thu, 01 Jan 1970 00:00:07 GMT\r\nConnection: close\r\n\r\n")
    let (dated, _) = exchange(tasks, seed, OpenAi, Some(take date))
    let Error(Transient(_, 7u64)) = dated else { return false }
    let (context, _) = exchange(tasks, seed, OpenAi, Some(reply_with("400 Bad Request", "application/json", "{\"error\":{\"code\":\"context_length_exceeded\"}}")))
    let Error(ContextExceeded(_)) = context else { return false }
    let cut = reply_with("200 OK", "text/event-stream", "data: {\"choices\":[{\"delta\":{\"content\":\"partial\"}}]}\n\ndata: {\"choices\":[")
    let (dropped, streamed) = exchange(tasks, seed, OpenAi, Some(take cut))
    let Error(take drop_fault) = take dropped else { return false }
    let stream_dropped = match drop_fault { StreamDropped(_) => true, _ => false }
    if !stream_dropped { return false }
    if !has(streamed, "\"stream\":true") { return false }

    let (time, take controller) = provide.clock(0u64, 1000000u64)
    let mut hand = take controller
    let mut db = store.memory(time, random, runner.triggers.law_options())
    let h = result.unwrap(store.bind_declaration(mut db, Migrate, harness.declare_tables))
    let w = result.unwrap(harness.wiring(code.describe(retry_advance), code.describe(retry_entry)))
    let mut a = harness.agent("retry", "m", code.describe(retry_model), ())
    a.charge = BoundedDuplicate(5u64)
    let caller = store.Caller(issuer: 1u8, subject: b"test")
    let prepared = store.run(mut db, None, (store.copy_env(h), store.copy_env(w), store.copy_env(a), store.copy_env(caller)), fn(mut tx, call_env) -> Result[(), harness.Refused] {
        harness.open_session(mut tx, call_env.0, "m", All)?
        let _ = harness.submit(mut tx, call_env.0, call_env.2, call_env.1, call_env.3, NextTurn, harness.Submit(client_key: "key", text: "weather in San Francisco?"))?
        harness.advance(mut tx, call_env.0, call_env.2, call_env.1, Kick)
    })
    let Ok(Committed(_)) = prepared else { fail("retry setup did not commit") }
    let key = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
    let first = retry_effect(db, h, key)
    let pending = option.unwrap(retry_pending(db, h, option.unwrap(first.trigger)))
    let at = file_fault(mut db, h, a, w, key, pending, take throttle)
    let waiting = retry_effect(db, h, key)
    let second_id = option.unwrap(waiting.trigger)
    let delayed = option.unwrap(retry_pending(db, h, second_id))
    if first.trigger == waiting.trigger || runner.triggers.due_time(delayed) != at + 7000u64 || !waiting.stream { return false }

    clock.set_wall(mut hand, at + 7000u64)
    let drop_at = file_fault(mut db, h, a, w, key, delayed, take drop_fault)
    let fallback = retry_effect(db, h, key)
    let fallback_id = option.unwrap(fallback.trigger)
    let next = option.unwrap(retry_pending(db, h, fallback_id))
    if fallback.stream || fallback_id == second_id || runner.triggers.due_time(next) != drop_at { return false }
    let req = result.unwrap(harness.request(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h, key, fallback))
    let mut sink: Option[harness.preview.Source] = None
    let reply = reply_with("200 OK", "application/json", "{\"choices\":[{\"message\":{\"content\":\"complete\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":5,\"completion_tokens\":2}}")
    let (completed, heard) = exchange_preview(tasks, seed, OpenAi, Some(take reply), provider.bounds(), take req, mut sink)
    let Ok(answer) = completed else { return false }
    if answer.text != "complete" || !has(heard, "\"stream\":false") || has(heard, "stream_options") { return false }
    let _ = file_fault(mut db, h, a, w, key, next, StreamDropped("fallback cut too"))
    let terminal = retry_effect(db, h, key)
    let settled = match terminal.phase { Settled(ModelFailed(StreamDropped(_))) => true, _ => false }
    result.unwrap(store.close(take db))
    settled && terminal.dispatches == 3u64 && terminal.trigger == Some(fallback_id)
}

fn law_blob_excerpt() -> bool {
    // A 20-byte marker leaves five or six bytes. Rounding both cuts
    // inwards leaves two ASCII bytes on each side.
    let text = "AB界界界界界界界界界界YZ"
    let want = "AB\n[30 bytes omitted]\nYZ"
    let excerpt = harness.truncate_middle(text, 25u64)
    if excerpt != want { return false }
    if harness.truncate_middle(text, 26u64) != want { return false }
    let ref = harness.BlobRef(digest: list.new(), len: 34u64, mime: "text/plain", excerpt: Some(clone(excerpt)))
    let mut req = simple_request()
    let shown = harness.worded(Returned(Blob(clone(ref))))
    list.push(mut req.messages, ToolResult("c", Returned(Blob(take ref)), take shown))
    let m = provider.Model(dialect: OpenAi, name: "m", max_tokens: 64u64, cache_control: Off)
    let Ok(body) = provider.body(m, req) else { return false }
    region r {
        match std.json.parse(r, body) {
            Ok(x) => str_is(x, "/messages/1/content", want),
            Error(_) => false,
        }
    }
}

@test
fn test_harness_fixes(tasks: Tasks, random: Random, seed_grant: Env) -> Result[(), u64] waits {
    let seed = match std.sim.world.test_seed(seed_grant) { Some(n) => n, None => 0u64 }
    if !law_cache_usage() { return Error(1u64) }
    if !law_typed_retry(tasks, random, seed) { return Error(2u64) }
    if !law_blob_excerpt() { return Error(3u64) }
    Ok(())
}

fn read_session(db: store.Db, h: harness.Handles) -> harness.Session waits {
    option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.session, 0u64)))
}

fn pending_id(db: store.Db, h: harness.Handles, wanted: runner.triggers.Id) -> runner.triggers.Pending waits {
    option.unwrap(result.unwrap(runner.triggers.next_pending(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.triggers, scoped fn(id) { id != wanted })))
}

fn warm_agent() -> harness.Agent[Clock, ()] {
    let mut a = harness.agent("warm", "m", code.describe(retry_model), ())
    a.keep_warm = Some(harness.KeepWarm(cache: Ephemeral, lifetime_ms: 5000u64, margin_ms: 1000u64, requests: 2u64))
    take a
}

fn warm_tick(mut db: store.Db, h: harness.Handles, w: harness.Wiring, wake: harness.Wake) waits {
    let advanced = store.run(mut db, None, (store.copy_env(h), store.copy_env(w), store.copy_env(wake)), fn(mut tx, call_env) -> Result[(), harness.Refused] {
        harness.advance(mut tx, call_env.0, warm_agent(), call_env.1, clone(call_env.2))
    })
    if let Ok(Committed(_)) = advanced {} else { fail("warm: advance refused") }
}

fn warm_answer(mut db: store.Db, h: harness.Handles, w: harness.Wiring, key: harness.EffectKey) -> u64 waits {
    let e = retry_effect(db, h, key)
    let p = pending_id(db, h, option.unwrap(e.trigger))
    let ran = store.run(mut db, None, (store.copy_env(h), store.copy_env(key), store.copy_env(w), store.copy_env(e), store.copy_env(p)), fn(mut tx, call_env) -> Result[harness.Filed, store.Error] {
        let started = runner.triggers.start(mut tx, call_env.0.triggers, call_env.4, b"revision") ?=> |_| Missing("warm trigger")
        let Body(attempt) = started else { return Error(Missing("warm attempt")) }
        let mut dispatched: harness.Effect = clone(call_env.3)
        dispatched.phase = Dispatched(runner.triggers.number(attempt))
        dispatched.dispatches = 1u64
        store.put(mut tx, call_env.0.effects, call_env.1, dispatched)?
        let answer = harness.Answer(text: "answered", calls: list.new(), stop: "stop",
            usage: harness.Usage(input: 0u64, output: 0u64, cache_read: 0u64, cache_write: 0u64, reasoning: 0u64))
        let filed = harness.settle(mut tx, call_env.0, warm_agent(), call_env.2, attempt, harness.Settle(key: call_env.1, receipt: Some(Model(take answer))))?
        runner.triggers.finish(mut tx, call_env.0.triggers, attempt, Returned(b"")) ?=> |_| Missing("finish warm trigger")
        Ok(filed)
    })
    match ran {
        Ok(Committed(store.Done(value: Recorded, info: info, ..))) => info.at,
        _ => fail("warm: model answer did not settle"),
    }
}

fn warm_wait(db: store.Db, h: harness.Handles, due: u64) -> runner.triggers.Id waits {
    let Some(Waiting(_, park, _)) = read_session(db, h).warm else { fail("warm: no timer") }
    let reader = result.unwrap(store.reader(db, 0u64))
    let id = option.unwrap(result.unwrap(runner.park.pending_trigger(reader, store.snapshot(db), h.wakes, park)))
    if runner.triggers.due_time(pending_id(db, h, id)) != due { fail("warm: wrong due time") }
    id
}

fn warm_submit(mut db: store.Db, h: harness.Handles, w: harness.Wiring, key: String) waits {
    let ran = store.run(mut db, None, (store.copy_env(h), store.copy_env(key), store.copy_env(w)), fn(mut tx, call_env) -> Result[harness.Disposition, harness.Refused] {
        let caller = store.Caller(issuer: 1u8, subject: b"warm")
        harness.submit(mut tx, call_env.0, warm_agent(), call_env.2, caller, NextTurn, harness.Submit(client_key: clone(call_env.1), text: "keep this prefix"))
    })
    if let Ok(Committed(_)) = ran {} else { fail("warm: submit refused") }
}

fn law_warm_bounds(tasks: Tasks, random: Random, seed: Option[u64]) -> Result[(), u64] waits {
    let (time, take controller) = provide.clock(0u64, 1000u64)
    let mut hand = take controller
    let mut db = store.memory(time, random, runner.triggers.law_options())
    let h = result.unwrap(store.bind_declaration(mut db, Migrate, harness.declare_tables))
    let w = result.unwrap(harness.wiring(code.describe(retry_advance), code.describe(retry_entry)))
    let opened = store.run(mut db, None, h, fn(mut tx, call_env) -> Result[(), harness.Refused] {
        harness.open_session(mut tx, call_env, "m", All)
    })
    if let Ok(Committed(_)) = opened {} else { return Error(1u64) }
    warm_submit(mut db, h, w, "one")
    warm_tick(mut db, h, w, Warm(0u64))
    if read_session(db, h).warm_left != 0u64 { return Error(2u64) }
    let model = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
    let answered = warm_answer(mut db, h, w, model)
    clock.set_wall(mut hand, answered + 100u64)
    warm_tick(mut db, h, w, Kick)
    let _ = warm_wait(db, h, answered + 4000u64)
    let before = read_session(db, h).next_pos
    let p = harness.provider.Model(dialect: Anthropic, name: "m", max_tokens: 64u64, cache_control: Ephemeral)
    let mut due = answered + 4000u64
    if let Some(n) = seed {
        let mut plan = std.sim.world.plan(n)
        clock.set_wall(mut hand, answered + 100u64 + std.sim.world.pick(mut plan, 3899u64))
        warm_tick(mut db, h, w, Warm(0u64))
        if read_session(db, h).warm_left != 2u64 { return Error(3u64) }
    }
    clock.set_wall(mut hand, due - 1u64)
    warm_tick(mut db, h, w, Warm(0u64))
    if read_session(db, h).warm_left != 2u64 { return Error(3u64) }
    for i in 0u64 .. 2u64 {
        let ordinal = 2u64 - i
        clock.set_wall(mut hand, due)
        warm_tick(mut db, h, w, Warm(1u64))
        if read_session(db, h).warm_left != ordinal { return Error(4u64) }
        warm_tick(mut db, h, w, Warm(0u64))
        let key = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.WARM, ordinal: ordinal)
        let refresh = retry_effect(db, h, key)
        let req = result.unwrap(harness.request(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h, key, refresh))
        let wire = result.unwrap(provider.body(p, req))
        if req.stream || !req.warm || list.len(req.messages) != 1u64 || !has(wire, "\"max_tokens\":1") ||
            !has(wire, "\"stream\":false") || !has(wire, "keep this prefix") || has(wire, "answered") ||
            refresh.cutoff.tail_pos != retry_effect(db, h, model).cutoff.tail_pos {
            return Error(5u64)
        }
        let at = warm_answer(mut db, h, w, key)
        due = at + 4000u64
        if ordinal == 2u64 { let _ = warm_wait(db, h, due) }
    }
    clock.set_wall(mut hand, due)
    warm_tick(mut db, h, w, Warm(0u64))
    let idle = read_session(db, h)
    if idle.warm_left != 0u64 || idle.next_pos != before { return Error(6u64) }
    if let Some(_) = idle.warm { return Error(7u64) }

    warm_submit(mut db, h, w, "two")
    let second = harness.EffectKey(run: 1u64, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
    let at = warm_answer(mut db, h, w, second)
    warm_tick(mut db, h, w, Kick)
    let timer = warm_wait(db, h, at + 4000u64)
    warm_submit(mut db, h, w, "three")
    if !runner.triggers.cancelling(pending_id(db, h, timer)) { return Error(8u64) }
    clock.set_wall(mut hand, at + 4000u64)
    warm_tick(mut db, h, w, Warm(0u64))
    let active = read_session(db, h)
    if active.active_run != Some(2u64) || active.warm_left != 0u64 { return Error(9u64) }
    if let Some(_) = active.warm { return Error(10u64) }

    let third = harness.EffectKey(run: 2u64, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
    let _ = warm_answer(mut db, h, w, third)
    let off = store.run(mut db, None, (store.copy_env(h), store.copy_env(w)), fn(mut tx, call_env) -> Result[(), harness.Refused] {
        let mut a = warm_agent()
        a.keep_warm = Some(harness.KeepWarm(cache: Off, lifetime_ms: 5000u64, margin_ms: 1000u64, requests: 2u64))
        harness.advance(mut tx, call_env.0, a, call_env.1, Kick)
    })
    if let Ok(Committed(_)) = off {} else { return Error(11u64) }
    let cold = read_session(db, h)
    if cold.warm_left != 0u64 { return Error(12u64) }
    if let Some(_) = cold.warm { return Error(13u64) }
    result.unwrap(store.close(take db))
    Ok(())
}

const HEDGE_ENTRY_BYTES: u64 = 1048576u64

type HedgePeer: send { listener: Listener, clock: Clock, hedge: bool }

fn provider_socket(mut listener: Listener) -> (ReadHalf, WriteHalf) waits {
    let Ok((take c, _)) = host.accept(mut listener, Never) else { fail("hedge peer: accept failed") }
    let (take input, take output) = net.split(take c)
    let mut reader = take input
    let mut received: Bytes = list.with_capacity(8192u64)
    loop {
        let Ok(n) = host.recv_bounded(mut reader, mut received, 8192u64, Never) else { fail("hedge peer: read failed") }
        if n == 0u64 { fail("hedge peer: incomplete request") }
        if complete_request(received) { return (take reader, take output) }
    }
}

fn complete_request(raw: Bytes) -> bool {
    if raw[list.len(raw) - 1u64] != b'}' { return false }
    let Ok(take text) = string.from_utf8(clone(raw)) else { return false }
    region r {
        match std.json.parse(r, text) { Ok(_) => true, Error(_) => false }
    }
}

fn serve_hedge_peer(take job: HedgePeer) -> u64 waits {
    let HedgePeer(listener: take l, clock: clock, hedge: hedge) = take job
    let mut listener = take l
    let head = reply_with("200 OK", "text/event-stream", "")
    let sse = bytes_of("data: {\"choices\":[{\"delta\":{\"content\":\"answer\"},\"finish_reason\":\"stop\"}]}\n\ndata: {\"choices\":[],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1}}\n\ndata: [DONE]\n\n")
    let fast = if hedge { 9u64 } else { 0u64 }
    for _ in 0u64 .. fast {
        let (take request_in, take output) = provider_socket(mut listener)
        let mut writer = take output
        if let Error(_) = std.http.write_wire(mut writer, head, sse, clock, std.clock.deadline_after_ms(host.mono_ns(clock), 5000u64)) {
            fail("hedge peer: fast reply failed")
        }
        drop(take request_in)
    }
    let (take slow_in, take slow_out) = provider_socket(mut listener)
    let mut slow = take slow_out
    let deadline = std.clock.deadline_after_ms(host.mono_ns(clock), 5000u64)
    if let Error(_) = std.http.write_wire(mut slow, head, b"", clock, deadline) { fail("hedge peer: response head failed") }
    if !hedge {
        std.clock.sleep_ns(clock, 1750000000u64)
        if let Error(_) = std.http.write_wire(mut slow, sse, b"", clock, deadline) { fail("hedge peer: slow reply failed") }
        return 1u64
    }
    let (take winner_in, take winner_out) = provider_socket(mut listener)
    let mut winner = take winner_out
    let won = bytes_of("data: {\"choices\":[{\"delta\":{\"content\":\"winner\"},\"finish_reason\":\"stop\"}]}\n\ndata: {\"choices\":[],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1}}\n\ndata: [DONE]\n\n")
    if let Error(_) = std.http.write_wire(mut winner, head, won, clock, deadline) { fail("hedge peer: hedge reply failed") }
    drop(take winner_in)
    let mut reader = take slow_in
    let mut after: Bytes = list.with_capacity(8192u64)
    // The primary receives no response body. It must close when the second
    // connection wins, while the peer still owns its writer.
    loop {
        match host.recv_bounded(mut reader, mut after, 8192u64, At(clock, deadline)) {
            Ok(0u64) => return 11u64,
            Ok(_) => list.clear(mut after),
            Error(_) => return 0u64,
        }
    }
}

type HedgeServices: send { worker: provider.Worker, net: Net, address: Addr, clock: Clock, enabled: bool }
type HedgeGrants: send { handles: harness.Handles, context: runner.TriggerContext, service: HedgeServices }

fn grant_hedge(s: HedgeServices, h: harness.Handles, take ctx: runner.TriggerContext) -> Result[HedgeGrants, Capacity] {
    Ok(HedgeGrants(handles: clone(h), context: take ctx, service: HedgeServices(worker: provider.share_worker(s.worker), net: s.net,
        address: s.address, clock: s.clock, enabled: s.enabled)))
}

fn model_single(g: HedgeGrants, take req: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let s = view g.service
    provider.ask_with_preview(s.net, s.clock, route(OpenAi, s.address), take req, mut sink)
}

fn model_hedged(g: HedgeGrants, take req: harness.Request, mut sink: Option[harness.preview.Source], permit: harness.Hedge) -> Result[harness.Answer, harness.ModelFault] waits {
    let s = view g.service
    if !s.enabled { return Error(Rejected("guaranteed model entered the hedge worker")) }
    let answer = provider.ask_hedged(s.worker, s.net, s.clock, route(OpenAi, s.address), take req, mut sink, permit)?
    if answer.text == "winner" {
        if harness.try_hedge(permit) { return Error(Rejected("second hedge admitted")) }
    }
    Ok(take answer)
}

fn hedge_agent(enabled: bool) -> harness.Agent[HedgeGrants, ()] {
    let mut a = harness.agent("hedge", "m", code.describe(model_single), ())
    if enabled { a.charge = BoundedDuplicate(2u64) }
    a.hedged_model = Some(code.describe(model_hedged))
    a.limits.model_reserve = 2u64
    take a
}

fn hedge_wire() -> harness.Wiring {
    result.unwrap(harness.wiring(code.describe(hedge_advance), code.describe(hedge_effect)))
}

fn hedge_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    harness.advance_park(mut tx, h, hedge_agent(true), hedge_wire(), take wake)
}

fn hedge_effect(g: HedgeGrants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    harness.effect(g.context, g.handles, g, take key, hedge_agent(g.service.enabled), code.describe(hedge_settle), None)
}

fn hedge_settle(mut tx: store.Tx, h: harness.Handles, attempt: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    harness.settle(mut tx, h, hedge_agent(false), hedge_wire(), attempt, take m)
}

fn hedge_place(mut r: runner.Registry[HedgeGrants, harness.Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(hedge_advance), code.describe(hedge_effect), code.describe(hedge_settle), harness.select_handles, 131072u64, HEDGE_ENTRY_BYTES)
}

fn hedge_submit(mut tx: store.Tx, h: harness.Handles, i: u64, enabled: bool) -> Result[(), harness.Refused] {
    let mut key = string.new()
    string.push_u64(mut key, i)
    let caller = store.Caller(issuer: 1u8, subject: b"hedge")
    let _ = harness.submit(mut tx, h, hedge_agent(enabled), hedge_wire(), caller, NextTurn, harness.Submit(client_key: take key, text: "test"))?
    Ok(())
}

fn seed_hedge(dir: Dir, clock: Clock, random: Random, tasks: Tasks, enabled: bool) waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let h = result.unwrap(store.bind_declaration(mut db, Migrate, harness.declare_tables))
    let setup = store.run(mut db, None, (store.copy_env(enabled), store.copy_env(h)), fn(mut tx, call_env) -> Result[(), harness.Refused] {
        harness.open_session(mut tx, call_env.1, "m", All)?
        let count = if call_env.0 { 10u64 } else { 1u64 }
        for i in 0u64 .. count { hedge_submit(mut tx, call_env.1, i, call_env.0)? }
        Ok(())
    })
    if let Ok(Committed(_)) = setup {} else { fail("hedge: could not seed") }
    result.unwrap(store.close(take db))
}

fn law_hedge_charge(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, enabled: bool, seed: u64) -> Result[(), u64] waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    seed_hedge(dir, clock, random, tasks, enabled)
    let (initial, virtual_clock) = std.sim.world.new(seed, 0u64, 0u64)
    let mut world = take initial
    let plan = std.sim.world.detach(mut world)
    let (fake, port) = provide.net(bytes 65536u64)
    let link = task.spawn(tasks, bytes 4194304u64, Link(port: take port, clock: virtual_clock, plan: take plan, queue_bytes: 8192u64), serve_link)
    let loopback = Addr(ip: V4(2130706433u32), port: 0u16)
    let (listener, address) = result.unwrap(host.listen(fake, loopback, 2u16))
    let peer = task.spawn(tasks, bytes 1048576u64, HedgePeer(listener: take listener, clock: clock, hedge: enabled), serve_hedge_peer)
    let (worker, history) = provider.worker(tasks, 262144u64)
    let service = HedgeServices(worker: take worker, net: fake, address: address, clock: clock, enabled: enabled)
    let config = runner.TriggerConfig(entries: harness.entries(hedge_wire()), author: store.Caller(issuer: 0u8, subject: b""),
        grants: take service, grant: grant_hedge, grant_bytes: 65536u64)
    let mut session = runner.wire_defaults(65536u64)
    session.n_pool = 4194304u64
    let settings: runner.PlaceConfig[HedgeGrants, harness.Handles, HedgeServices, ()] = runner.PlaceConfig(
        backing: Disk(dir), sizes: store.Overrides(resident_limit: Some(1048576u64), journal_limit: None, checkpoint_bytes: Some(4194304u64), pack_bytes: Some(512u64), group_bytes: Some(1048576u64), group_commits: Some(2u32), lock_wait_ms: None,
            cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: Reopen, place: code.describe(hedge_place), n_place: HEDGE_ENTRY_BYTES,
        on_migrate: None, schema: code.describe(harness.declare_tables), session: take session, max_sessions: 1u64,
        proxies: list.new(), n_publisher: HEDGE_ENTRY_BYTES, listen: loopback, net: net, tasks: tasks,
        clock: clock, random: random, stop: runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: None, triggers: Some(take config), idle: Some(300u64))
    let (stop, from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let status = result.unwrap(runner.status_root())
    let ended = runner.operate(take settings, take from, latest.handle(status), None)
    let _ = take stop
    let observed = task.join(take peer)
    drop(take fake)
    let _ = task.join(take link)
    let _ = task.join(take history)
    let _ = take world
    let Ok(_) = ended else { return Error(20u64) }
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let expected = if enabled { 10u64 } else { 1u64 }
    for id in 0u64 .. expected {
        let key = harness.EffectKey(run: id, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
        let e = retry_effect(db, h, key)
        let raced = enabled && id == 9u64
        let dispatches = if raced { 2u64 } else { 1u64 }
        let text = if raced { "winner" } else { "answer" }
        let Settled(Model(answer)) = view e.phase else {
            let mut message = string.from("model did not settle for run ")
            string.push_u64(mut message, id)
            if let Settled(ModelFailed(fault)) = view e.phase {
                match fault {
                    Rejected(why) => { string.push(mut message, " rejected "); string.push(mut message, why) },
                    StreamDropped(why) => { string.push(mut message, " dropped "); string.push(mut message, why) },
                    _ => (),
                }
            }
            fail(take message)
        }
        if answer.text != text || e.dispatches != dispatches { return Error(23u64) }
        let run = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.runs, id)))
        if run.spend.reserved != 0u64 || run.spend.known != 2u64 || run.spend.unresolved != (dispatches - 1u64) * 2u64 {
            return Error(24u64)
        }
    }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    match take observed {
        Ok(n) if n == (if enabled { 11u64 } else { 1u64 }) => Ok(()),
        Error(Failed(causes)) => {
            for cause in causes {
                if let Fail(why) = cause.kind { fail(clone(why)) }
            }
            Error(21u64)
        },
        _ => Error(21u64),
    }
}

@test
fn test_warm_and_hedge(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, seed_grant: Env) -> Result[(), u64] waits {
    let seed = std.sim.world.test_seed(seed_grant)
    let wire_seed = match seed { Some(n) => n, None => 0u64 }
    law_warm_bounds(tasks, random, seed)?
    law_hedge_charge(parent, clock, random, tasks, net, true, wire_seed)?
    law_hedge_charge(parent, clock, random, tasks, net, false, wire_seed)
}

// The last refill is sized exactly to the selected end. Both the frame parser
// and host reads stop there, even when a live writer extends the file.
type CaptureChunk {
    raw: Bytes,
    base: u64,
    deadline: Option[(Clock, u64)],
    end: u64
}

fn new_capture_chunk(end: u64) -> CaptureChunk {
    CaptureChunk(raw: list.new(), base: end, deadline: None, end: end)
}

fn capture_chunk_at(mut file: HostFile, path: String, mut source: CaptureChunk, at: u64) -> Result[u64, types.Failure] waits {
    if at >= source.base && at - source.base < list.len(source.raw) {
        return Ok(at - source.base)
    }
    source.raw = list.new()
    source.base = at
    let width = order.min(journal.JOURNAL_CHUNK_BYTES, source.end - at)
    source.raw = manifest.disk_read_buffer(width)?
    while list.len(source.raw) < width {
        format.check_journal_deadline(source.deadline)?
        let off = at + list.len(source.raw)
        if manifest.disk_io(host.read_at(mut file, off, mut source.raw))? == 0 {
            return Error(format.disk_fault(path, off, Truncated))
        }
    }
    Ok(0u64)
}

fn capture_prefix(mut file: HostFile, path: String, mut source: CaptureChunk, at: u64, size: u64) -> Result[Bytes, types.Failure] waits {
    if at > source.end || size > source.end - at {
        return Error(format.disk_fault(path, at, Truncated))
    }
    let mut raw = manifest.disk_read_buffer(size)?
    while list.len(raw) < size {
        let start = capture_chunk_at(mut file, path, mut source, at + list.len(raw))?
        let width = order.min(size - list.len(raw), list.len(source.raw) - start)
        list.append(mut raw, list.slice(source.raw, start, start + width))
    }
    Ok(take raw)
}

pub type CapturePayload: key = SkipPayload | KeepCommit | KeepEvents

fn capture_read_frame(mut file: HostFile, path: String, mut source: CaptureChunk, ctx: format.DiskContext, limits: types.LimitsRep, at: u64, keep: CapturePayload) -> Result[format.JournalFrame, types.Failure] waits {
    let head = capture_prefix(mut file, path, mut source, at, 16)?
    let frame = manifest.disk_read_frame_head(path, head, at)?
    if frame.size > source.end - at - 16 {
        return Error(format.disk_fault(path, at, Truncated))
    }
    let oversized = frame.kind == 0x0011 && frame.size > types.transaction_limit(limits)
    let retained = !oversized && ((keep == KeepCommit && frame.kind == 0x0011) || (keep == KeepEvents && format.journal_event_kind(frame.kind)))
    let mut payload = manifest.disk_read_buffer(if retained {
        frame.size
    } else {
        0u64
    })?
    let mut check = types.capacity(format.disk_check_start(ctx, at, head))?
    let end = at + 16 + frame.size
    let mut offset = at + 16
    while offset < end {
        let start = capture_chunk_at(mut file, path, mut source, offset)?
        let width = order.min(end - offset, list.len(source.raw) - start)
        std.check.add(mut check, source.raw, start, start + width)
        if retained {
            list.append(mut payload, list.slice(source.raw, start, start + width))
        }
        offset += width
    }
    if std.check.finish(check) != frame.checksum {
        return Error(format.disk_fault(path, at, Checksum))
    }
    manifest.disk_check_frame_kind(path, ctx, frame.kind, frame.flags, at)?
    Ok(format.JournalFrame(end: end, kind: frame.kind, payload: if retained {
        Some(take payload)
    } else {
        None
    }))
}

pub fn capture_scan_frames[S](mut file: HostFile, id: types.StoreKey, seq: u64, limits: types.LimitsRep, durable_end: u64, end: u64, torn: bool, keep: CapturePayload, deadline: Option[(Clock, u64)], mut state: S, consume: scoped[view] fn(mut S, String, u64, u16, Bytes) -> Result[(), types.Failure] waits) -> Result[(u64, u64), types.Failure] waits {
    let path = manifest.journal_path(seq, "")?
    if durable_end < 72 || end < durable_end || manifest.disk_io(host.stat_file(mut file))?.size < end {
        return Error(format.disk_fault(path, end, Truncated))
    }
    let mut source = new_capture_chunk(end)
    source.deadline = deadline
    let header = manifest.disk_read_header(path, capture_prefix(mut file, path, mut source, 0, 72)?, 2, Some(seq), Some(id))?
    let mut at = 72u64
    let mut frames = 0u64
    while at < end {
        let frame = match capture_read_frame(mut file, path, mut source, header.context, limits, at, keep) {
            Ok(take good) => take good,
            Error(Corrupt(take fault)) => {
                if torn && at >= durable_end && format.journal_torn(fault.why) {
                    break
                }
                return Error(Corrupt(take fault))
            },
            Error(take problem) => return Error(take problem),
        }
        if at < durable_end && frame.end > durable_end {
            return Error(format.disk_fault(path, at, Truncated))
        }
        if frame.kind == 0x0011 && frame.end - at - 16 > types.transaction_limit(limits) {
            return Error(format.disk_fault(path, at, Malformed))
        }
        if let Some(payload) = view frame.payload {
            consume(mut state, path, at, frame.kind, payload)?
        }
        frames += 1
        at = frame.end
    }
    Ok((at, frames))
}

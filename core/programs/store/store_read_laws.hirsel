// L13 by hand on a memory store, whose commit_ticket marks count commits. Wrong
// implementations caught: admitting latest+1 over an unreplied latest
// (no_s7); an aborted body's data writes kept (abort_keeps_data), its reply
// dropped (abort_drops_reply) or kept without a ticket (abort_no_ticket); an
// over-bound abort that keeps its reply; an admit of an unreplied position
// admitted in this open that commits again or answers Admitted; a new
// stream admitting p > 0; a reply at a position not Admitted; a record
// without a reply, twice, or with a 31-byte revision. L29: COMMIT sizes with
// a streams section, with and without a data head, and a CALL section.
pub fn law_streams(c: Clock) -> bool waits {
    let mut db = raw_test_db(c, 1073741824)
    let s = result.unwrap(copied(string.as_bytes("s")))
    let d = digest_for("d")
    let e = digest_for("e")
    match result.unwrap(admit(mut db, s, 1, d)) {
        Rejected(0) => {},
        _ => return false
    }
    if db.heads[0].head != 0 {
        return false
    }
    match result.unwrap(admit(mut db, s, 0, d)) {
        Admitted(t) => if !mark_is(ticket(t), 1) {
            return false
        },
        _ => return false
    }
    if db.heads[0].head != 1 || stream_now(db, s) != (0u64, 1u64) {
        return false
    }
    // S7: latest + 1 over an unreplied latest commits nothing.
    match result.unwrap(admit(mut db, s, 1, d)) {
        Rejected(0) => {},
        _ => return false
    }
    // AH1: another request at latest mismatches before Abandoned, binds
    // nothing, and the bound request is still Abandoned after it.
    match result.unwrap(admit(mut db, s, 0, e)) {
        RequestMismatch => {},
        _ => return false
    }
    match result.unwrap(admit(mut db, s, 0, d)) {
        Abandoned(t) => if !mark_is(ticket(t), 1) {
            return false
        },
        _ => return false
    }
    if db.heads[0].head != 1 {
        return false
    }
    // The effect and its reply in one commit.
    let replied = result.unwrap(run(mut db, None, s, fn(mut tx, call_env) -> Result[(), u64] {
        if !missing_is(reply(mut tx, call_env, 1, list.new()), "reply") {
            return Error(1)
        }
        if let Error(_) = put_bytes(mut tx, 1, key_word(1), key_word(11)) {
            return Error(2)
        }
        if let Error(_) = reply(mut tx, call_env, 0, result.unwrap(copied(string.as_bytes("r0")))) {
            return Error(3)
        }
        // Ruling 2: position 0 is now Replied, so a second reply is refused.
        if !missing_is(reply(mut tx, call_env, 0, list.new()), "reply") {
            return Error(4)
        }
        Ok(())
    }))
    match take replied {
        Committed(_) => {},
        _ => return false
    }
    if db.heads[0].head != 2 || stream_now(db, s) != (0u64, 2u64) || !stream_reply_is(db, s, string.as_bytes("r0")) {
        return false
    }
    match get_page_row(db.heads[0].roots.collections, result.unwrap(logical_key(1, key_word(1)))) {
        Some(v) => if decode_word(v) != 11 {
            return false
        },
        None => return false
    }
    // The reply keeps d: e still mismatches, before Duplicate, and d's
    // Duplicate follows it.
    match result.unwrap(admit(mut db, s, 0, e)) {
        RequestMismatch => {},
        _ => return false
    }
    match result.unwrap(admit(mut db, s, 0, d)) {
        Duplicate(r) => if r.reply != string.as_bytes("r0") {
            return false
        },
        _ => return false
    }
    if db.heads[0].head != 2 {
        return false
    }
    match result.unwrap(admit(mut db, s, 1, d)) {
        Admitted(t) => if !mark_is(ticket(t), 3) {
            return false
        },
        _ => return false
    }
    // F2: a body that replies and returns Error keeps the reply alone.
    let kept = result.unwrap(run(mut db, None, s, fn(mut tx, call_env) -> Result[(), u64] {
        if let Error(_) = put_bytes(mut tx, 1, key_word(2), key_word(22)) {
            return Error(1)
        }
        if let Error(_) = reply(mut tx, call_env, 1, result.unwrap(copied(string.as_bytes("r1")))) {
            return Error(2)
        }
        // A 95-byte reply frame plus the 5-byte data head and one 29-byte put.
        let ci = info(mut tx)
        if list.len(result.unwrap(encode_sections(ci, mut tx.ops.rows, tx.stream_ops.rows, None, 1, 72))) != 129 {
            return Error(3)
        }
        Error(7)
    }))
    match take kept {
        Aborted(Undone(value: 7, ticket: Some(t))) => if !mark_is(t, 4) {
            return false
        },
        _ => return false
    }
    if db.heads[0].head != 4 || stream_now(db, s) != (1u64, 2u64) || !stream_reply_is(db, s, string.as_bytes("r1")) {
        return false
    }
    if let Some(_) = get_page_row(db.heads[0].roots.collections, result.unwrap(logical_key(1, key_word(2)))) {
        return false
    }
    match result.unwrap(admit(mut db, s, 2, d)) {
        Admitted(t) => if !mark_is(ticket(t), 5) {
            return false
        },
        _ => return false
    }
    // Aborted without a reply, Failed and Refused keep nothing; each later
    // admit of 2 is Abandoned with the commit_ticket of 5 and commits nothing.
    let dropped = result.unwrap(run(mut db, None, (), fn(mut tx, unused_env) -> Result[(), u64] {
        if let Error(_) = put_bytes(mut tx, 1, key_word(3), key_word(33)) {
            return Error(1)
        }
        Error(8)
    }))
    match take dropped {
        Aborted(Undone(value: 8, ticket: None)) => {},
        _ => return false
    }
    match result.unwrap(admit(mut db, s, 2, d)) {
        Abandoned(t) => if !mark_is(ticket(t), 5) {
            return false
        },
        _ => return false
    }
    let faulted = result.unwrap(run(mut db, None, s, fn(mut tx, call_env) -> Result[(), u64] {
        if let Error(_) = reply(mut tx, call_env, 2, list.new()) {
            return Error(1)
        }
        fail("L13 injected fault")
    }))
    match take faulted {
        Failed(_) => {},
        _ => return false
    }
    match result.unwrap(admit(mut db, s, 2, d)) {
        Abandoned(t) => if !mark_is(ticket(t), 5) {
            return false
        },
        _ => return false
    }
    // An 8-byte reply grows the stored row's value from 41 to 49 bytes, past
    // the admitted row's 48. A ceiling below the current resident therefore
    // refuses it on both exits.
    let ceiling = db.ceiling
    db.ceiling = db.resident - 1
    let over = result.unwrap(run(mut db, None, s, fn(mut tx, call_env) -> Result[(), u64] {
        if let Error(_) = reply(mut tx, call_env, 2, key_word(9)) {
            return Error(1)
        }
        Ok(())
    }))
    match take over {
        Refused(_) => {},
        _ => return false
    }
    let over_abort = result.unwrap(run(mut db, None, s, fn(mut tx, call_env) -> Result[(), u64] {
        if let Error(_) = reply(mut tx, call_env, 2, key_word(9)) {
            return Error(1)
        }
        Error(9)
    }))
    match take over_abort {
        Refused(_) => {},
        _ => return false
    }
    // Ruling 3: an admit over the bound is Full and binds nothing.
    match admit(mut db, string.as_bytes("u"), 0, e) {
        Error(Full(_)) => {},
        _ => return false
    }
    db.ceiling = ceiling
    match result.unwrap(admit(mut db, s, 2, d)) {
        Abandoned(t) => if !mark_is(ticket(t), 5) {
            return false
        },
        _ => return false
    }
    if db.heads[0].head != 5 || stream_now(db, s) != (2u64, 1u64) {
        return false
    }
    // AH2: below latest there is no digest to compare, whatever the bytes.
    for (p, x) in[(1u64, d), (1u64, e), (0u64, d)] {
        match result.unwrap(admit(mut db, s, p, x)) {
            HistoryUnavailable => {},
            _ => return false
        }
    }
    for p in[3u64, 5u64] {
        match result.unwrap(admit(mut db, s, p, d)) {
            Rejected(2) => {},
            _ => return false
        }
    }
    if db.heads[0].head != 5 {
        return false
    }
    // Recording checks the admission, revision, and one-CALL-per-frame rule.
    let unadmitted = result.unwrap(run(mut db, None, s, fn(mut tx, call_env) -> Result[(), u64] {
        if !missing_is(reply(mut tx, string.as_bytes("t"), 0, list.new()), "reply") {
            return Error(1)
        }
        if !missing_is(reply_recorded(mut tx, 3, list.new(), call_for(call_env, 32)), "reply") {
            return Error(2)
        }
        if !missing_is(reply_recorded(mut tx, 2, list.new(), call_for(call_env, 31)), "revision") {
            return Error(3)
        }
        if let Error(_) = reply_recorded(mut tx, 2, result.unwrap(copied(string.as_bytes("r2"))), call_for(call_env, 32)) {
            return Error(4)
        }
        match reply_recorded(mut tx, 2, list.new(), call_for(call_env, 32)) {
            Error(Exists(n)) => if n != "call" {
                return Error(5)
            },
            _ => return Error(6)
        }
        Ok(())
    }))
    match take unadmitted {
        Committed(_) => {},
        _ => return false
    }
    if db.heads[0].head != 6 {
        return false
    }
    match result.unwrap(admit(mut db, s, 3, d)) {
        Admitted(t) => if !mark_is(ticket(t), 7) {
            return false
        },
        _ => return false
    }
    // L29 by section 2.4: head 16, call info 21, streams section 5 + op
    // (1 + 4 + 1 + 4 + 43) = 58, so 95 with no data section. The CALL
    // is 145 B (four blobs of sizes 32, 16, 32 and 48, and the settle byte).
    // A 12-byte key and 8-byte value add 34 B for data.
    let measured = result.unwrap(run(mut db, None, s, fn(mut tx, call_env) -> Result[(), u64] {
        if let Error(_) = reply_recorded(mut tx, 3, result.unwrap(copied(string.as_bytes("ab"))), call_for(call_env, 32)) {
            return Error(1)
        }
        let ci = info(mut tx)
        let one = list.len(result.unwrap(encode_sections(ci, mut tx.ops.rows, tx.stream_ops.rows, None, 1, 72)))
        if one != 95 {
            return Error(2)
        }
        let two = list.len(result.unwrap(encode_sections(ci, mut tx.ops.rows, tx.stream_ops.rows, tx.call, 1, 72)))
        if two != 240 {
            return Error(4)
        }
        if let Error(_) = put_bytes(mut tx, 1, key_word(4), key_word(44)) {
            return Error(5)
        }
        let three = list.len(result.unwrap(encode_sections(ci, mut tx.ops.rows, tx.stream_ops.rows, tx.call, 1, 72)))
        if three != 274 {
            return Error(6)
        }
        Ok(())
    }))
    match take measured {
        Committed(_) => {},
        _ => return false
    }
    // The Full admit of e at u bound nothing: d admits there.
    match result.unwrap(admit(mut db, string.as_bytes("u"), 0, d)) {
        Admitted(_) => true,
        _ => false
    }
}

// G1: a refused run leaves the version and rows unchanged. Readmission
// of the same position finds the original admit, with no saved reply.
fn refused_reply(c: Clock, oversized: bool) -> bool waits {
    let mut db = raw_test_db(c, 1073741824)
    let stream = string.as_bytes("s")
    let digest = digest_for("request")
    match result.unwrap(admit(mut db, stream, 0, digest)) {
        Admitted(t) => if !mark_is(ticket(t), 1) {
            return false
        },
        _ => return false
    }
    let attempted = result.unwrap(run(mut db, None, (copy_env(oversized), copy_env(stream)), fn(mut tx, call_env) -> Result[(), Error] {
        if call_env.0 {
            // Section 2.4: 26 + 16*21 + 15*1048576 + 1048086
            // leaves 192 bytes for the streams and CALL sections.
            for k in 1u64 .. 17 {
                let size = if k == 16 {
                    1048086u64
                } else {
                    1048576u64
                }
                let mut v: Bytes = list.with_capacity(size)
                list.fill(mut v, size, 0u8)
                put_bytes(mut tx, 1, key_word(k), v)?
            }
        } else {
            put_bytes(mut tx, 1, key_word(1), key_word(10))?
        }
        let mut call = call_for(call_env.1, if call_env.0 {
            32u64
        } else {
            31u64
        })
        if call_env.0 {
            list.fill(mut call.args, 1024, 0u8)
        }
        reply_recorded(mut tx, 0, copied(string.as_bytes("success"))?, take call)
    }))
    match take attempted {
        Aborted(Undone(value: Limit(Transaction), ticket: None)) => if !oversized {
            return false
        },
        Aborted(Undone(value: Missing(what), ticket: None)) => if oversized || what != "revision" {
            return false
        },
        _ => return false
    }
    let head = snapshot(db)
    if version(head) != 1 {
        return false
    }
    if let Some(_) = result.unwrap(get_raw(head, 1, key_word(1))) {
        return false
    }
    match result.unwrap(admit(mut db, stream, 0, digest)) {
        Abandoned(t) => if !mark_is(ticket(t), 1) {
            return false
        },
        _ => return false
    }
    if oversized {
        return true
    }
    // A runner refusal also discards an already staged reply and CALL.
    let rejected = result.unwrap(run_with_reply(mut db, None, fn(_error: Error) -> bool {
        false
    }, stream, fn(mut tx, call_env) -> Result[(), Error] {
        reply_recorded(mut tx, 0, copied(string.as_bytes("success"))?, call_for(call_env, 32))?
        Error(Limit(Transaction))
    }))
    match take rejected {
        Aborted(Undone(value: Limit(Transaction), ticket: None)) => {},
        _ => return false
    }
    if version(snapshot(db)) != 1 {
        return false
    }
    match result.unwrap(admit(mut db, stream, 0, digest)) {
        Abandoned(t) => mark_is(ticket(t), 1),
        _ => false
    }
}

pub fn law_refused_reply(c: Clock) -> bool waits {
    let frame = refused_reply(c, true)
    let revision = refused_reply(c, false)
    frame && revision
}

@test
fn test_refused_reply(c: Clock) -> Result[(), ()] waits {
    if law_refused_reply(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn digest_hex(d: RequestDigest, hex: String) -> bool {
    let alphabet = string.as_bytes("0123456789abcdef")
    let want = string.as_bytes(hex)
    for i in 0u64 .. 32 {
        if alphabet[int.widen(d.b[i] >> 4)] != want[i * 2] || alphabet[int.widen(d.b[i] & 15)] != want[i * 2 + 1] {
            return false
        }
    }
    true
}

// L35: STORE-SPEC v2.24's vectors, RUN by Python hashlib (l35-digest-
// vectors.py). Wrong implementations caught: no tag or lengths (no_framing:
// both values differ, and a byte moved from key to args hashes the same);
// big-endian lengths; xxh3 as the identity (xxh3_identity).
pub fn law_request_digest() -> bool {
    let mut key: Bytes = list.with_capacity(32)
    for i in 0u8 .. 32u8 {
        list.push(mut key, i)
    }
    let args: Bytes = b"\x01\x02\x03"
    let empty: Bytes = list.new()
    if !digest_hex(request_digest(key, args), "172630b31e7cd5050e8c06447738d3002e79578c1bb18836380fa604eb1c2135") || !digest_hex(request_digest(key, empty), "2b8d69847b046143da891fdb319ab0fb26033ef1b8116ff0e61e544adceb307b") {
        return false
    }
    let mut changed = result.unwrap(copied(key))
    changed[5] = 0xff
    let short = list.slice(key, 0, 31)
    let moved: Bytes = b"\x1f\x01\x02\x03"
    request_digest(changed, args) != request_digest(key, args) && request_digest(short, moved) != request_digest(key, args)
}

@test
fn test_request_digest() -> Result[(), ()] {
    if law_request_digest() {
        Ok(())
    } else {
        Error(())
    }
}

@test
fn test_streams(c: Clock) -> Result[(), ()] waits {
    if law_streams(c) {
        Ok(())
    } else {
        Error(())
    }
}

// J1: same J rewrites only the primary key; changing J rewrites old+new index
// entries. Three indexes make these counts1 and7, independent of tree shape.
pub fn law_index_writes(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("writes", std.codec.key_u64(), std.codec.of_u64())))
    let mut t = result.unwrap(table(mut db, "writes", std.codec.key_u64(), std.codec.of_u64()))
    for i in 0u64 .. 3 {
        let name = if i == 0 {
            "i0"
        } else if i == 1 {
            "i1"
        } else {
            "i2"
        }
        result.unwrap(create_index(mut db, t, name, code.describe(bucket), std.codec.key_u64()))
        let _ = result.unwrap(index(mut db, t, name, code.describe(bucket), std.codec.key_u64()))
    }
    if !typed_put(mut db, t, 1, 17) {
        return false
    }
    let same_j = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[u64, Error] {
        put(mut tx, call_env, 1, 21)?;
        Ok(tx.ops.rows.count)
    }))
    match take same_j {
        Committed(done) => if done.value != 1 {
            return false
        },
        _ => return false
    }
    let changed_j = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[u64, Error] {
        put(mut tx, call_env, 1, 22)?;
        Ok(tx.ops.rows.count)
    }))
    match take changed_j {
        Committed(done) => done.value == 7,
        _ => false
    }
}


// rule: STORE-8
// expect: run
// authorities: {"pins":{"provider":"authority.sim@1","floor":"cache","seed":5,"represent":"log","levels":["cache","disk"],"faults":{}},"c1":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":1}},"c2":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":2}},"c3":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":3}},"c4":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":4}},"c5":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":5}},"c6":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":6}},"c7":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":7}},"c8":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":8}},"c9":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":9}},"c10":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":10}},"c11":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":11}},"c12":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":12}},"c13":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":13}},"c14":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":14}},"c15":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":15}},"c16":{"provider":"authority.sim@1","floor":"cache","seed":1,"represent":"log","levels":["cache","disk"],"faults":{"crash_at":16}}}
// steps: 20000000
// A reader pin holds the version its acquire ran at, read with store.at_pin
// from the readers table durable at the strongest declared level, so the
// pinned state is readable as soon as the acquire returns, though the place
// commits at cache and the table only counts at disk. Asking the acquire's
// stream position again returns the recorded Ok with one holder; a token held
// already is Taken() at a new position. A takeover inherits the table and a
// compaction past the pinned version keeps the checkpoint it relies on, while
// an unpinned version below the newest checkpoint is NotRetained(). A pin its
// caller drops, or one the operator releases, is PinReleased(), and its
// version is no longer retained. A token acquired again after its drop holds
// a later version, and the earlier acquire's held pin stays PinReleased()
// rather than reading the later holder's state. Of three holders relying on a
// checkpoint a later compaction keeps for them alone, with room for deltas,
// the second's drop is a ReaderDelta and the last one's, which gives the
// checkpoint up, is a fold.
// Authority `cN` fails the power right after answering request N, keeping only
// what is durable at disk. Whatever request it cuts, an acquire that returned
// Ok has a pin that reads the pinned state after the cut.
fn put_x(mut tx: store.Tx, info: store.CallInfo, n: u8) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"x", bytes.from_list([n]))
}

fn request(position: u64, name: Bytes) -> CallRequest {
  CallRequest(
    stream: d32(b"reader"),
    epoch: 1,
    position: position,
    digest: d32(name),
    acknowledged: 0
  )
}

// Streams and request digests are 32 bytes: the SHA-256 of a name.
fn d32(name: Bytes) -> Bytes {
  bytes.from_inline(sha256.digest(name))
}

fn acquire(mut s: store.Store, position: u64, name: Bytes, p: store.ReaderPin) -> Result[
  store.HeldPin,
  store.CallFailure[store.PinError]
] {
  store.call(mut s, request(position, name), store.acquire_reader_pin, p)
}

// True when `p` reads the state whose `x` is `n`, at version `v`.
fn holds(a: Authority, p: store.HeldPin, n: u8, v: store.Version of a) -> bool {
  match store.at_pin(a, p) {
    Ok(snap) => store.get(snap, b"x") == Some(bytes.from_list([n])) && store.version(
      a,
      snap
    ) == v,
    Error(_) => false,
  }
}

fn released(a: Authority, p: store.HeldPin) -> bool {
  match store.at_pin(a, p) {
    Error(PinReleased()) => true,
    _ => false,
  }
}

fn dropped(a: Authority, v: store.Version of a) -> bool {
  match store.at(a, v) {
    Error(NotRetained()) => true,
    _ => false,
  }
}

fn reads(a: Authority, v: store.Version of a, n: u8) -> bool {
  match store.at(a, v) {
    Ok(snap) => store.get(snap, b"x") == Some(bytes.from_list([n])),
    Error(_) => false,
  }
}

// True when `p` reads the state whose `x` is `n`, at whatever version it holds.
fn pinned_x(a: Authority, p: store.HeldPin, n: u8) -> bool {
  match store.at_pin(a, p) {
    Ok(snap) => store.get(snap, b"x") == Some(bytes.from_list([n])),
    Error(_) => false,
  }
}

// What the newest record holds of the retention state: a fold, a ReaderDelta,
// or neither.
type Kind = Fold | Delta | Neither

fn newest_kind(a: Authority) -> Result[Kind, Failed] {
  let Ok(records) = authority.read(a, 0, authority.floor(a), 4096) else {
    return Error(Check())
  }
  let mut kind: Kind = Neither
  for rec in records {
    let Appended(entry, _, _) = rec else {
      continue
    }
    let Ok(g) = history.decode_group(entry) else {
      return Error(Check())
    }
    kind = Neither
    for c in g.commits {
      match c.body {
        Engine(Retain(..)) => {
          kind = Fold
        },
        Engine(ReaderDelta(_)) => {
          kind = Delta
        },
        _ => {},
      }
    }
  }
  Ok(kind)
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

fn write(mut s: store.Store, n: u8) -> Result[(), Failed] {
  let done: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put_x, n)
  check(done == Ok(()))
}

// One cut run over `name`: true when the acquire returned Ok before the cut,
// so its pin must hold after it.
fn cut(rt: Io, r: Random, name: String) -> Result[bool, Failed] {
  let Ok(c) = io.authority(rt, name) else {
    return Error(Check())
  }
  let Ok(p) = store.new_reader_pin(r) else {
    return Error(Check())
  }
  let Ok(opened) = store.open(c, store.default_config()) else {
    return Ok(false)
  }
  let mut s = take opened
  let done: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put_x, 1)
  let Ok(first) = store.snapshot(c, mut s, authority.floor(c)) else {
    return Ok(false)
  }
  let pinned = store.version(c, first)
  if done != Ok(()) {
    return Ok(false)
  }
  let Ok(h) = acquire(mut s, 1, b"a", p) else {
    return Ok(false)
  }
  check(holds(c, h, 1, pinned))?
  let _ = store.close(take s)
  Ok(true)
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "pins") else {
    return Error(Check())
  }
  let Some(cache) = authority.level(a, "cache") else {
    return Error(Check())
  }
  let Ok(r) = io.random(rt) else {
    return Error(Check())
  }
  let Ok(p) = store.new_reader_pin(r) else {
    return Error(Check())
  }
  let Ok(q) = store.new_reader_pin(r) else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  write(mut s, 1)?
  let first = store.snapshot(a, mut s, cache) ? Store
  let pinned = store.version(a, first)
  // The acquire's reply waits for its Retain at disk, so the pin reads at once.
  let Ok(hp) = acquire(mut s, 1, b"a", p) else {
    return Error(Check())
  }
  check(holds(a, hp, 1, pinned))?
  // The lost reply asked again, and the token asked at a new position.
  check(acquire(mut s, 1, b"a", p) == Ok(hp))?
  check(acquire(mut s, 2, b"b", p) == Error(Tx(Aborted(Taken()))))?
  let held = store.reader_pins(a, mut s) ? Store
  check(list.len(held) == 1)?
  check(store.pin_principal(held[0]) == "")?
  write(mut s, 2)?
  let second = store.snapshot(a, mut s, cache) ? Store
  let unpinned = store.version(a, second)
  write(mut s, 3)?
  store.close(take s) ? Store
  // A takeover holds the same pin, and a compaction keeps what it reads.
  let mut again = store.open(a, store.default_config()) ? Store
  let Ok(inherited) = store.reader_pins(a, mut again) else {
    return Error(Check())
  }
  check(list.len(inherited) == 1)?
  for h in inherited {
    check(store.pin_version(a, h) == pinned && store.pin_principal(h) == "")?
  }
  store.compact(mut again) ? Store
  check(dropped(a, unpinned))?
  check(holds(a, hp, 1, pinned) && reads(a, pinned, 1))?
  // The caller drops its pin.
  let gone: Result[(), store.CallFailure[()]] = store.call(
    mut again,
    request(3, b"c"),
    store.drop_reader_pin,
    hp
  )
  check(gone == Ok(()))?
  check(released(a, hp) && dropped(a, pinned))?
  // The same token acquired again holds a later version; the dropped pin
  // stays released.
  write(mut again, 4)?
  let Ok(later) = acquire(mut again, 4, b"e", p) else {
    return Error(Check())
  }
  check(released(a, hp))?
  // A holder seen before the drop names the earlier acquire: releasing it
  // leaves the later one held.
  check(store.release_reader_pin(mut again, copy inherited[0]) == Ok(false))?
  check(!released(a, later))?
  // The operator releases one of two holders, once.
  let Ok(hq) = acquire(mut again, 5, b"d", q) else {
    return Error(Check())
  }
  let Ok(others) = store.reader_pins(a, mut again) else {
    return Error(Check())
  }
  check(list.len(others) == 2)?
  check(store.release_reader_pin(mut again, copy others[0]) == Ok(true))?
  check(released(a, later) != released(a, hq))?
  check(store.release_reader_pin(mut again, copy others[0]) == Ok(false))?
  // Six more holders rely on the checkpoint already kept, so later changes
  // have room for ReaderDelta commits. Three holders after a compaction rely
  // on its checkpoint, which a later compaction keeps for them alone. Each
  // reads its state while held. The second's drop leaves the kept checkpoints
  // as they are, a ReaderDelta; the last one's gives that checkpoint up, which
  // only a fold may (storage.md STORE-8, "The readers table on the history").
  for i in 0u64..6 {
    let Ok(t) = store.new_reader_pin(r) else {
      return Error(Check())
    }
    let Ok(_) = acquire(mut again, 6 + i, bytes.from_list([int.truncate(102 + i)]), t) else {
      return Error(Check())
    }
  }
  store.compact(mut again) ? Store
  write(mut again, 6)?
  let mut trio: List[store.HeldPin] = []
  for i in 0u64..3 {
    let Ok(t) = store.new_reader_pin(r) else {
      return Error(Check())
    }
    let Ok(h) = acquire(mut again, 12 + i, bytes.from_list([int.truncate(108 + i)]), t) else {
      return Error(Check())
    }
    list.push(mut trio, h)
  }
  write(mut again, 7)?
  store.compact(mut again) ? Store
  let mut kinds: List[Kind] = []
  for i in 0u64..3 {
    check(pinned_x(a, trio[i], 6))?
    let off: Result[(), store.TxFailure[()]] = store.transact(
      mut again,
      store.drop_reader_pin,
      trio[i]
    )
    check(off == Ok(()))?
    list.push(mut kinds, newest_kind(a)?)
  }
  check(kinds[1] == Delta && kinds[2] == Fold && released(a, trio[2]))?
  store.close(take again) ? Store
  let mut acquired: u64 = 0
  for k in 1u64..17 {
    if cut(rt, r, f"c{k}")? {
      acquired += 1
    }
  }
  check(acquired > 0 && acquired < 16)?
  Ok(())
}

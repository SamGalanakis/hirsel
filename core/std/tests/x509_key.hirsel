fn rejects(der: Bytes) -> bool {
    match x509_key.read(der) {
        Invalid => true,
        _ => false,
    }
}

// The certificates come from openssl req -new -x509 -outform DER.
// The expected points come from openssl x509 -pubkey piped to
// openssl ec -pubin -pubout -conv_form uncompressed -outform DER.
// expect: run openssl_certificate_keys() = true
fn openssl_certificate_keys() -> bool {
    let mut p256 = option.unwrap(hex.decode(b""))
    let p384 = option.unwrap(hex.decode(b""))
    let rsa = option.unwrap(hex.decode(b""))
    let p256_point = option.unwrap(hex.decode(b"04466164e55cc2184bbda3dddb4b19ed586ddfbf295f40c770660120dd6bad24107bb54850603c60686ccbfacd0cd4619fbbff1c0953bf1f43c945f784f3e698fb"))
    let p384_point = option.unwrap(hex.decode(b"04790d74809f0dbb69b081f2dfddb2668c7ada2c38730513b02c7820c46fcc136403219727e0980d94991737ef54f3a9fad63a429ef78fa6ac9e7c78d8aa3e19f8555cd6d51f3074e9b7c99c003523deeca74c81935623786ad750d3a0d5df1544"))
    let matches_p256 = match x509_key.read(p256) {
        P256(point) => point == p256_point,
        _ => false,
    }
    let matches_p384 = match x509_key.read(p384) {
        P384(point) => point == p384_point,
        _ => false,
    }
    if !matches_p256 || !matches_p384 || !rejects(rsa) {
        return false
    }
    // Add a leading zero to the outer long-form length.
    let mut nonminimal = b"\x30\x83\x00"
    list.append(mut nonminimal, list.slice(p256, 2, list.len(p256)))
    if !rejects(nonminimal) || !rejects(list.slice(p256, 0, list.len(p256) - 1)) {
        return false
    }
    // The SPKI BIT STRING starts at offset 127, with zero unused bits at 129.
    p256[129] = 1
    if !rejects(p256) {
        return false
    }
    p256[129] = 0
    p256[130] = 2
    if !rejects(p256) {
        return false
    }
    p256[130] = 4
    list.push(mut p256, 0u8)
    rejects(p256)
}

// RFC 8410 §10.1 SPKI inside a structurally framed certificate. The
// surrounding fields are opaque to this reader. The SEQUENCE starts at 15.
// expect: run rfc8410_ed25519_spki_range() = true
fn rfc8410_ed25519_spki_range() -> bool {
    let mut cert = option.unwrap(hex.decode(b"303e30370201013000300030003000302a300506032b657003210019bf44096984cdfe8541bac167dc3b96c85086aa30b6b6cb0c5c38ad703166e13000030100"))
    let point = option.unwrap(hex.decode(b"19bf44096984cdfe8541bac167dc3b96c85086aa30b6b6cb0c5c38ad703166e1"))
    let spki = option.unwrap(hex.decode(b"302a300506032b657003210019bf44096984cdfe8541bac167dc3b96c85086aa30b6b6cb0c5c38ad703166e1"))
    let Some(range) = x509_key.spki_range(cert) else {
        return false
    }
    if range.start != 15 || range.end != 59 || list.compare_bytes(list.slice(cert, range.start, range.end), spki) != Equal {
        return false
    }
    match x509_key.read(cert) {
        Ed25519(key) if key == point => (),
        _ => return false,
    }
    let null_parameters = option.unwrap(hex.decode(b"304030390201013000300030003000302c300706032b6570050003210019bf44096984cdfe8541bac167dc3b96c85086aa30b6b6cb0c5c38ad703166e13000030100"))
    cert[26] = 1
    rejects(cert) && rejects(null_parameters)
}

fn old_op_size(ops: std.omap.OMap[Bytes, Option[Bytes]], key: Bytes) -> u64 {
    match std.omap.get(ops, key) {
        None => 0,
        Some(v) => match v {
            None => 5 + list.len(key),
            Some(raw) => 9 + list.len(key) + list.len(raw)
        }
    }
}

fn le(mut out: Bytes, x: u64, width: u64) -> Result[(), Capacity] {
    match width {
        1 => {
            list.reserve(mut out, 1)?
            result.capacity_only(list.push(mut out, int.truncate(x)))
        },
        2 => {
            let word: u16 = int.truncate(x)
            list.put_word_le(mut out, word)
        },
        4 => {
            let word: u32 = int.truncate(x)
            list.put_word_le(mut out, word)
        },
        8 => list.put_word_le(mut out, x),
        _ => fail("store: invalid frame word width"),
    }
}

fn blob(mut out: Bytes, b: Bytes) -> Result[(), Capacity] {
    le(mut out, list.len(b), 4)?
    list.append(mut out, b)
}

fn encode_commit(ci: CallInfo, ops: std.omap.OMap[Bytes, Option[Bytes]], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    let streams: std.omap.OMap[Bytes, Option[Bytes]] = std.omap.new()
    encode_sections(ci, ops, streams, None, seq, offset)
}

fn encode_ops(mut payload: Bytes, tag: u64, ops: std.omap.OMap[Bytes, Option[Bytes]]) -> Result[(), Capacity] {
    le(mut payload, tag, 1)?
    le(mut payload, std.omap.len(ops), 4)?
    let mut cursor = result.capacity_only(std.omap.range(ops, Unbounded, Unbounded))?
    while let Some((k, v)) = std.omap.next(mut cursor)? {
        match v {
            None => { le(mut payload, 2, 1)?; blob(mut payload, k)? },
            Some(raw) => { le(mut payload, 1, 1)?; blob(mut payload, k)?; blob(mut payload, raw)? }
        }
    }
    Ok(())
}

fn encode_staged(ci: CallInfo, ops: std.omap.OMap[Bytes, Option[Bytes]], streams: std.omap.OMap[Bytes, Option[Bytes]], call: Option[CallSection], rec: Option[CallRecord], settlement: Option[Settlement], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    if let Some(record) = rec {
        return encode_frame(ci, ops, streams, Some(view record), settlement, seq, offset)
    }
    encode_sections(ci, ops, streams, call, seq, offset)
}

fn encode_sections(ci: CallInfo, ops: std.omap.OMap[Bytes, Option[Bytes]], streams: std.omap.OMap[Bytes, Option[Bytes]], call: Option[CallSection], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    match call {
        Some(section) => encode_frame(ci, ops, streams, Some(view section.record), section.settlement, seq, offset),
        None => encode_frame(ci, ops, streams, None, None, seq, offset),
    }
}

fn encode_frame(ci: CallInfo, ops: std.omap.OMap[Bytes, Option[Bytes]], streams: std.omap.OMap[Bytes, Option[Bytes]], call: Option[View[CallRecord]], settlement: Option[Settlement], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    let data = std.omap.len(ops) != 0 || std.omap.len(streams) == 0
    let stream = std.omap.len(streams) != 0
    let mut sections = if data { 1u64 } else { 0u64 }
    if stream { sections += 1 }
    if let Some(_) = call { sections += 1 }
    let mut payload: Bytes = list.new()
    le(mut payload, int.widen(ci.id.branch), 4)?
    le(mut payload, ci.id.version, 8)?
    le(mut payload, ci.at, 8)?
    le(mut payload, sections, 1)?
    if data { encode_ops(mut payload, 0, ops)? }
    if stream { encode_ops(mut payload, 1, streams)? }
    if let Some(c) = call {
        le(mut payload, 2, 1)?
        blob(mut payload, c.key)?
        blob(mut payload, c.args)?
        blob(mut payload, c.stream)?
        // AD1: u32 length 0 for None, 32 for Some.
        if let Some(r) = c.revision { blob(mut payload, r)? } else { le(mut payload, 0, 4)? }
        blob(mut payload, c.code)?
        match settlement {
            None => le(mut payload, 0, 1)?,
            Some(context) => {
                le(mut payload, int.widen(context.way), 1)?
                append_be(mut payload, context.base, 8)?
                append_be(mut payload, context.at, 8)?
                append_be(mut payload, context.seed, 8)?
            }
        }
    }
    disk_seal(DiskContext(store: ci.id.store, role: 2, seq: seq), offset, 0x0011, 1, payload)
}

// Hand-derived COMMIT bytes: delete key 1, then put key 2 = 33. Check from
// libxxhash 0.8.2, including store/file/offset binding and head[0..8] + payload.
// Wrong implementation caught: insertion order, duplicate ops, wrong check extent.
pub fn law_frames(c: Clock) -> bool {
    if !frame_boundary_points() {
        return false
    }
    let mut db = test_db(c, 1073741824)
    let outcome = execute(mut db, 0, 30, None, fn(mut tx: Tx) -> Result[Bytes, Error] {
        put_bytes(mut tx, 1, key_word(2), key_word(22))?
        put_bytes(mut tx, 1, key_word(1), key_word(11))?
        put_bytes(mut tx, 1, key_word(2), key_word(33))?
        let _ = delete_bytes(mut tx, 1, key_word(1))?
        if tx.frame_bytes != 88 || std.omap.len(tx.ops) != 2 {
            return Error(Foreign)
        }
        capacity(encode_commit(info(mut tx), tx.ops, 1, 72))
    })
    match take outcome {
        Ok(Committed(done)) => {
            let expected: Inline[u8, 88] =[17u8, 0u8, 1u8, 0u8, 72u8, 0u8, 0u8, 0u8, 113u8, 81u8, 236u8, 174u8, 179u8, 213u8, 128u8, 52u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 30u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 2u8, 0u8, 0u8, 0u8, 2u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 2u8, 8u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 33u8]
            if list.len(done.value) != 88 {
                return false
            }
            for i in 0u64 .. 88 {
                if done.value[i] != expected[i] {
                    return false
                }
            }
            value_at(snapshot(db), 1) == 0 && value_at(snapshot(db), 2) == 33
        },
        _ => false
    }
}


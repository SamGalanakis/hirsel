type HttpSlotPlan: shareable + send {
    name: String,
    key: Arc[std.json.JsonPlan],
    value: Arc[std.json.JsonPlan],
}

pub opaque resource type HttpReadAccess: send {
    publisher: Sender[PubIn],
    tables: Arc[Map[u32, String]],
    frame_limit: u64,
} drop(access) {
    let _ = channel.try_send(access.publisher, PubIn(e: Drained))
}

pub fn http_read_access(to: Sender[PubIn], declarations: List[store.DeclaredCollection], frame_limit: u64) -> HttpReadAccess {
    let mut tables: Map[u32, String] = map.new()
    for collection in declarations {
        let mut name = string.new()
        openapi_text(mut name, collection.name)
        map.insert(mut tables, collection.id, take name)
    }
    result.unwrap(HttpReadAccess(publisher: channel.sender(to), tables: arc.new(take tables), frame_limit: frame_limit))
}

pub fn http_read_endpoint(original: HttpReadAccess) -> HttpReadAccess {
    result.unwrap(HttpReadAccess(publisher: channel.sender(original.publisher), tables: arc.share(original.tables), frame_limit: original.frame_limit))
}

resource type HttpRetirement: send {
    mark: Option[Sender[()]],
    publisher: Sender[PubIn]
} drop(retirement) {
    if let Some(_) = retirement.mark {
        retirement.mark = None
        let _ = channel.try_send(retirement.publisher, PubIn(e: Drained))
    }
}

type HttpOwner: send {
    retirement: HttpRetirement,
    from: Receiver[WireEvent],
    to: Sender[WireEvent],
    admit: Receiver[Admit],
    fence: Latest[Fence],
    round: Option[Latest[RoundAt]],
    progress: Sender[()],
    closing: Sender[()],
    publisher: Sender[PubIn],
}

type HttpBatchCredit: send {
    take_from: Receiver[()],
    refund: Sender[()]
}

// A Batch holds its credit across inbox, queue and writer. Terminal content
// can still reach the owner while both Batch credits are in use.
fn offer_content(owner: Joiner, take notice: Notice) -> Offered {
    let Some(credit) = view owner.http_credit else {
        return offer(owner.to, take notice)
    }
    let batch = match notice.e {
        Updated(current) => match current.content {
            Some(content) => list.len(content.groups) != 0u64,
            None => false
        },
        _ => false,
    }
    if !batch {
        return offer(owner.to, take notice)
    }
    match channel.try_receive(credit.take_from) {
        Ok(()) => (),
        Error(Empty) => return Bounced(take notice),
        Error(Closed) => return Shut,
    }
    let delivered = offer(owner.to, take notice)
    if let Took = delivered {} else {
        let _ = channel.try_send(credit.refund, ())
    }
    take delivered
}

type HttpJoinPorts: send {
    telling: Sender[Admit],
    marked: Receiver[()],
    closed: Receiver[()],
    progress: Receiver[()],
}

fn http_owner(pub_to: Sender[PubIn], inbox_size: u64) -> Result[(HttpOwner, HttpJoinPorts), Refusal] {
    let (to, from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(inbox_size)
    let (telling, admit): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    let (mark, marked): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (token, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    let fence = latest.new(arc.new(std.http.ReleaseFence(prior: 0u64, latest: 0u64)))
    let retirement = HttpRetirement(mark: Some(take mark), publisher: channel.sender(pub_to)) ?=> |(c, _)| Budget(capacity_room(c))
    let listening = HttpOwner(retirement: take retirement, from: take from, to: take to, admit: take admit, fence: take fence, round: None, progress: take token, closing: take closing, publisher: channel.sender(pub_to))
    Ok((take listening, HttpJoinPorts(telling: take telling, marked: take marked, closed: take closed, progress: take progress)))
}

fn http_join(owner: HttpOwner, take ports: HttpJoinPorts, take input: SubscriptionInput, take credit: Option[HttpBatchCredit]) -> Result[(), Refusal] {
    let HttpJoinPorts(telling: take telling, marked: take marked, closed: take closed, progress: take progress) = take ports
    let join = Join(to: channel.sender(owner.to), told: take telling, mark: Some(take marked), closed: Some(take closed), identity: None, fence: Some(latest.handle(owner.fence)), progress: Some(take progress), taken: None, first: Some(JoinSubscribe(sub: 0u32, generation: 1u64, input: take input)), http_credit: take credit)
    channel.try_send(owner.publisher, PubIn(e: Joined(take join))) ?=> |_| Overloaded
    Ok(())
}

fn http_subscription_input(take caller: Caller, take key: Bytes, take arg: Bytes, budget: u64, frame_limit: u64) -> Result[SubscriptionInput, Refusal] {
    let mut quota = subscription_room(budget, 1u64, budget, frame_limit) ?=> |c| Budget(capacity_room(c))
    Ok(subscription_hold_for(mut quota, take caller, take key, take arg, true) ?=> |c| Budget(capacity_room(c)))
}

fn http_subscribe(access: HttpReadAccess, take sent: Send, budget: u64) -> Result[HttpOwner, Refusal] {
    let Send(stream: store.StreamKey(caller: take caller, ..), key: take key, arg: take arg, ..) = take sent
    let input = http_subscription_input(take caller, take key, take arg, budget, access.frame_limit)?
    let (take owner, take ports) = http_owner(access.publisher, 3u64)?
    http_join(owner, take ports, take input, None)?
    Ok(take owner)
}

type HttpFrame: send = HttpBatch(u64, bool, Arc[Bytes]) | HttpEnded(u64, Outcome) | HttpReset(u64)

fn http_admitted(mut owner: HttpOwner) -> Result[(), Refusal] {
    let Admit(who: id, round: take register) = channel.try_receive(owner.admit) ?=> |_| Overloaded
    if id == 0u64 {
        return Error(Overloaded)
    }
    owner.round = Some(take register)
    Ok(())
}

fn http_frame(take notice: Notice) -> Option[HttpFrame] {
    if let Notice(e: Updated(Update(version: version, content: Some(take update_body), ..))) = take notice {
        let Owe(reset: reset, complete: complete, groups: take groups, ended: take ended, ..) = take update_body
        if reset {
            return Some(HttpReset(version))
        }
        for take terminal in take ended {
            let TerminalUpdate(outcome: take outcome, version: at, ..) = take terminal
            return Some(HttpEnded(at, take outcome))
        }
        for take group in take groups {
            let OwedGroup(payload: take data, ..) = take group
            return Some(HttpBatch(version, list.len(complete) > 0u64, take data))
        }
    }
    None
}

fn http_next_frame(mut owner: HttpOwner) -> Result[HttpFrame, Refusal] waits {
    loop {
        let WireEvent(e: take notice) = channel.receive(owner.from) ?=> |_| Overloaded
        match take notice {
            JoinReady => http_admitted(mut owner)?,
            FromRunner(Notice(e: Expired(_))) => return Error(Deadline),
            FromRunner(take publication) => if let Some(take frame) = http_frame(take publication) {
                return Ok(take frame)
            },
            _ => (),
        }
    }
}

fn http_initial_frame(mut owner: HttpOwner, clock: Clock, tasks: Tasks, deadline: u64) -> Result[HttpFrame, Refusal] waits {
    let expired = wire_event(FromRunner(Notice(e: Expired(Tick(stream: list.new(), p: 0u64, generation: 0u64)))))
    let alarm = std.clock.alarm(tasks, clock, deadline, owner.to, take expired)
    let frame = http_next_frame(mut owner)
    let _ = std.task.cancel_join(take alarm)
    if host.mono_ns(clock) >= deadline {
        return Error(Deadline)
    }
    take frame
}

fn http_one_shot(req: std.http.Request, resp: std.http.Responder, access: HttpReadAccess, operation: HttpOperation, take sent: Send, budget: u64, clock: Clock, tasks: Tasks) -> Result[std.http.Response, std.http.HandlerError] waits {
    let Some(take permit) = std.http.read_slot(resp, tasks) else {
        return http_refusal(Overloaded)
    }
    let mut owner = match http_subscribe(access, take sent, budget) {
        Ok(take running) => take running,
        Error(take problem) => {
            std.http.read_done(take permit)
            return http_refusal(take problem)
        },
    }
    let answer = http_initial_frame(mut owner, clock, tasks, std.http.handler_deadline(req))
    let mut reply = http_read_reply(owner, operation, access.tables, take answer)?
    let mark = replace(mut owner.retirement.mark, None)
    std.http.hold_read(mut reply, take permit, take mark)
    Ok(take reply)
}

fn http_read_reply(owner: HttpOwner, operation: HttpOperation, tables: Arc[Map[u32, String]], take answer: Result[HttpFrame, Refusal]) -> Result[std.http.Response, std.http.HandlerError] {
    match take answer {
        Ok(HttpBatch(version, true, take data)) => {
            let mut reply = http_batch_reply(operation, tables, version, take data)?
            let Some(register) = view owner.round else {
                return http_refusal(Overloaded)
            }
            std.http.guard_response(mut reply, register, owner.fence, version)
            Ok(take reply)
        },
        Ok(HttpEnded(version, take outcome)) => {
            let mut reply = http_ended_reply(take outcome)?
            let Some(register) = view owner.round else {
                return http_refusal(Overloaded)
            }
            std.http.guard_response(mut reply, register, owner.fence, version)
            Ok(take reply)
        },
        Ok(_) => http_reply(503u16, "{\"refused\":\"reset\"}", false, true, false),
        Error(Deadline) => http_reply(503u16, "", false, true, false),
        Error(take why) => http_refusal(take why),
    }
}

fn http_ended_reply(take outcome: Outcome) -> Result[std.http.Response, std.http.HandlerError] {
    match take outcome {
        Refused(Budget(problem)) => {
            let mut text = string.from("{\"refused\":\"budget\",\"requested\":\"")
            string.push_u64(mut text, problem.requested)
            string.push(mut text, "\",\"available\":\"")
            string.push_u64(mut text, problem.available)
            string.push(mut text, "\"}")
            http_reply(503u16, take text, false, false, false)
        },
        Refused(take why) => http_refusal(take why),
        Failed(detail) => http_fault(detail, false),
        _ => fail("subscription ended with a call outcome"),
    }
}

type HttpStreamSeed: codec + send {
    route: u64,
    caller: Caller,
    key: Bytes,
    arg: Bytes,
    budget: u64,
    expires_at_ms: Option[u64]
}

fn http_stream_offer(req: std.http.Request, take sent: Send, budget: u64) -> Result[std.stream.Spec, std.http.HandlerError] {
    let Send(stream: store.StreamKey(caller: take caller, ..), key: take key, arg: take arg, expires_at_ms, ..) = take sent
    let seed = HttpStreamSeed(route: std.http.route_tag(req), caller: take caller, key: take key, arg: take arg, budget: budget, expires_at_ms)
    let mut stream = std.stream.spec_managed(req, seed)?
    std.stream.expire_at(mut stream, seed.expires_at_ms)
    std.stream.header(mut stream, b"Content-Type", b"text/event-stream")?
    Ok(take stream)
}

type HttpStreamSite: send {
    publisher: Sender[PubIn],
    tables: Arc[Map[u32, String]],
    frame_limit: u64,
    outcome: Arc[std.json.JsonPlan],
    inbox_size: u64,
    routes: Arc[HttpRoutes],
}

/// Serves the generated routes and promotes subscriptions into the configured stream slots.
pub fn http_serve[G: send, H: shareable + inert + send, B: shareable + send](take listeners: List[Listener], clock: Clock, tasks: Tasks, take cfg: std.http.Config, take routes: std.router.Router[HttpConnection[G, H, B]], plans: Arc[HttpRoutes], reads: HttpReadAccess, state_bytes: u64, make_state: scoped[view] fn() -> HttpConnection[G, H, B], q: u64, take stop: Option[Receiver[u64]]) -> Result[(), std.http.ServeError] waits {
    if q > 4u64 {
        return Error(Configuration)
    }
    let inbox_size = 1u64 + q
    let format: std.codec.Codec[Outcome] = std.codec.of()
    let shape = result.unwrap(std.codec.describe(format))
    let outcome = arc.new(result.unwrap(std.json.prepare_schema(take shape, Strict)))
    let make: scoped[view] fn() -> HttpStreamSite = fn() -> HttpStreamSite {
        HttpStreamSite(publisher: channel.sender(reads.publisher), tables: arc.share(reads.tables), frame_limit: reads.frame_limit, outcome: arc.share(outcome), inbox_size: inbox_size, routes: arc.share(plans))
    }
    let make_connection: scoped[view] fn() -> std.http.ConnectionPlan[HttpConnection[G, H, B], HttpConnectionRetirement] = fn() -> std.http.ConnectionPlan[HttpConnection[G, H, B], HttpConnectionRetirement] {
        let mut state = make_state()
        http_enable_reads(mut state, http_read_endpoint(reads))
        http_connection_plan(take state)
    }
    let retire: scoped[view] fn() = fn() {
        let _ = channel.try_send(reads.publisher, PubIn(e: Drained))
    }
    let request_done: fn(HttpConnection[G, H, B]) waits = http_request_finished
    std.http.serve_with_stream_factory(take listeners, clock, tasks, take cfg, take routes, state_bytes, make_connection, request_done, http_needs_retirement, http_retire_connection, 256u64, make, http_stream_drive, retire, take stop)
}

fn http_stream_notice(take event: std.stream.Delivery) -> WireEvent {
    wire_event(HttpStream(take event))
}

fn http_stream_drive(take work: std.stream.Work, take site: HttpStreamSite) waits {
    let (clock, pre_head, lease_ms, write_ms, expires_at_ms) = std.stream.managed_timing(work)
    let Ok((take owner, take ports)) = http_owner(site.publisher, site.inbox_size) else {
        return
    }
    let mut joined = take owner
    let Some(take writer) = std.stream.start_managed(take work, joined.to, http_stream_notice) else {
        return
    }
    http_stream_loop(writer, mut joined, take ports, site, clock, pre_head, lease_ms, write_ms, expires_at_ms)
    std.stream.finish_managed(take writer)
    let _ = take joined
}

type HttpStreamEnd: send = EndNormally | EndWithFrame(HttpFrame) | EndWithRefusal(Refusal) | EndWithExpiry

type HttpQueuedBatch: send {
    version: u64,
    complete: bool,
    payload: Arc[Bytes],
    charge: u64
}

fn http_stream_loop(writer: std.stream.ManagedWriter, mut owner: HttpOwner, take ports: HttpJoinPorts, site: HttpStreamSite, clock: Clock, pre_head: u64, lease_ms: u64, write_ms: u64, expires_at_ms: Option[u64]) waits {
    let (refund, available): (Sender[()], Receiver[()]) = channel.new(2u64)
    let _ = channel.try_send(refund, ())
    let _ = channel.try_send(refund, ())
    let mut join_ports = Some(take ports)
    let mut credit = Some(HttpBatchCredit(take_from: take available, refund: channel.sender(refund)))
    let mut operation_index = 0u64
    let mut budget = 0u64
    let mut held = 0u64
    let mut sending = 0u64
    let mut version = 0u64
    let mut batches: List[HttpQueuedBatch] = list.with_capacity(2u64)
    let mut busy = false
    let mut taken = 0u64
    let mut awaiting_admit = false
    let mut lease: Option[u64] = None
    let mut ending: Option[(u64, HttpStreamEnd)] = None
    while let Ok(WireEvent(e: take event)) = channel.receive(owner.from) {
        let now = host.mono_ns(clock)
        let end_at = std.clock.deadline_after_ms(now, write_ms)
        let mut heartbeat = false
        let mut expired = std.stream.auth_lapsed(clock, expires_at_ms)
        if let HttpStream(delivery) = event {
            expired = expired || std.stream.expiry_wake(delivery)
        }
        if expired && http_stream_open(ending) {
            ending = Some((end_at, EndWithExpiry))
        }
        if awaiting_admit && http_stream_open(ending) {
            match channel.try_receive(owner.admit) {
                Ok(Admit(who: id, round: take register)) => {
                    awaiting_admit = false
                    if id == 0u64 {
                        ending = Some((end_at, EndWithRefusal(Overloaded)))
                    } else {
                        owner.round = Some(take register)
                    }
                },
                Error(Closed) => {
                    ending = Some((end_at, EndWithRefusal(Overloaded)))
                },
                Error(Empty) => (),
            }
        }
        if let Some(_) = owner.round {
            if wire_taken(mut taken, site.inbox_size) {
                http_stream_progress(owner)
            }
        }
        match take event {
            HttpStream(Committed(at)) => {
                lease = Some(std.clock.deadline_after_ms(at, lease_ms))
            },
            HttpStream(WriteFailed) => return,
            HttpStream(Sent(EndSent)) => return,
            HttpStream(ReadEnd) if lease == None => return,
            HttpStream(ReadEnd) => if let None = ending {
                ending = Some((end_at, EndNormally))
            },
            HttpStream(Sent(_)) => {
                busy = false
                if sending != 0u64 {
                    held -= sending
                    sending = 0u64
                    let _ = channel.try_send(refund, ())
                    http_stream_progress(owner)
                }
            },
            HttpStream(UnitExpired) => {
                busy = false
                if let Some((until, _)) = ending {
                    ending = Some((until, EndWithExpiry))
                }
            },
            HttpStream(UnitDropped) => {
                busy = false
                if http_stream_open(ending) || matches_normal(ending) {
                    if let Some(register) = view owner.round {
                        version = latest.read(register).at
                    }
                    let deadline = match ending {
                        Some((until, _)) => until,
                        None => end_at
                    }
                    ending = Some((deadline, EndWithFrame(HttpReset(version))))
                }
            },
            HttpStream(Tick) => {
                heartbeat = true
            },
            HttpStream(Staged(take packet, at)) if now < pre_head && http_stream_open(ending) => {
                let HttpStreamSeed(route, caller: take caller, key: take key, arg: take arg, budget: limit, expires_at_ms: _) = result.unwrap((std.stream.managed_state(packet, at) : Result[HttpStreamSeed, std.codec.DecodeError]))
                operation_index = route - 1u64
                budget = limit
                let started = http_stream_join(owner, option.unwrap(replace(mut join_ports, None)), take caller, take key, take arg, limit, site.frame_limit, replace(mut credit, None))
                match take started {
                    Ok(()) => {
                        awaiting_admit = true
                    },
                    Error(take refusal) => {
                        ending = Some((end_at, EndWithRefusal(take refusal)))
                    },
                }
            },
            FromRunner(take notice) if http_stream_open(ending) => {
                if let Some(take frame) = http_frame(take notice) {
                    match take frame {
                        HttpBatch(at, complete, take payload) => {
                            version = at
                            let charge = wire_round(list.capacity(payload)) + 32u64 + (if complete {
                                28u64
                            } else {
                                24u64
                            })
                            if int.saturating_add(held, charge) > budget {
                                ending = Some((end_at, EndWithFrame(HttpReset(at))))
                            } else {
                                held += charge
                                list.push(mut batches, HttpQueuedBatch(version: at, complete, payload: take payload, charge: charge))
                            }
                        },
                        HttpReset(at) => {
                            ending = Some((end_at, EndWithFrame(HttpReset(at))))
                        },
                        HttpEnded(at, take outcome) => {
                            ending = Some((end_at, EndWithFrame(HttpEnded(at, take outcome))))
                        },
                    }
                }
            },
            _ => (),
        }
        if let Some(stop_at) = std.stream.managed_stop(writer) {
            if lease == None {
                return
            }
            if http_stream_open(ending) {
                ending = Some((std.order.min(end_at, stop_at), EndNormally))
            }
        }
        if lease == None && now >= pre_head && !busy && !matches_expiry(ending) {
            std.stream.managed_deadline(writer)
            busy = true
            continue
        }
        if let Some(at) = lease {
            if now >= at && http_stream_open(ending) {
                ending = Some((end_at, EndNormally))
            }
        }
        if let Some((until, _)) = ending {
            if now >= until {
                return
            }
            list.clear(mut batches)
            if busy {
                continue
            }
            let (_, take reason) = option.unwrap(replace(mut ending, None))
            if lease == None {
                match take reason {
                    EndNormally => return,
                    EndWithExpiry => std.stream.managed_auth_refusal(writer),
                    EndWithRefusal(take why) => std.stream.managed_failure(writer, result.unwrap(http_refusal(take why)), None),
                    EndWithFrame(take terminal) => match take terminal {
                        HttpEnded(at, take outcome) => std.stream.managed_failure(writer, result.unwrap(http_ended_reply(take outcome)), http_stream_gate(owner, at)),
                        _ => std.stream.managed_failure(writer, result.unwrap(http_reset_reply()), None),
                    },
                }
                ending = Some((until, EndNormally))
                busy = true
                continue
            }
            match take reason {
                EndWithExpiry => {
                    std.stream.managed_expired(writer, http_sse_expired(), until)
                    ending = Some((until, EndNormally))
                },
                EndWithFrame(take terminal) => {
                    let control = match http_sse_control(owner, site.outcome, take terminal) {
                        Ok(take unit) => take unit,
                        Error(_) => http_sse_reset(version),
                    }
                    if !std.stream.managed_offer(writer, take control, until, false) {
                        return
                    }
                    // After the final event, close the chunked message under the same deadline.
                    ending = Some((until, EndNormally))
                },
                _ => {
                    std.stream.managed_terminal(writer, until)
                    ending = Some((until, EndNormally))
                },
            }
            busy = true
            continue
        }
        if busy {
            continue
        }
        if list.len(batches) != 0u64 {
            if lease == None && !batches[0u64].complete {
                return
            }
            let HttpQueuedBatch(version: at, complete, payload: take payload, charge) = list.remove(mut batches, 0u64)
            let spec = view site.routes.operations[operation_index]
            let initial = lease == None
            match http_sse_batch(spec, site.tables, at, complete, take payload, initial, http_stream_gate(owner, at)) {
                Ok(take item) => {
                    if !std.stream.managed_offer(writer, take item, 18446744073709551615u64, initial) {
                        return
                    }
                    sending = charge
                    busy = true
                },
                Error(fault) => {
                    if initial {
                        let reply = if let DepthLimit = fault {
                            http_reply(500u16, "{\"fault\":\"depth\"}", false, false, false)
                        } else {
                            http_reply(500u16, "{\"fault\":\"codec\"}", false, false, false)
                        }
                        std.stream.managed_failure(writer, result.unwrap(take reply), None)
                        busy = true
                    } else {
                        let reset = http_sse_reset(at)
                        if !std.stream.managed_offer(writer, take reset, end_at, false) {
                            return
                        }
                        busy = true
                    }
                    ending = Some((end_at, EndNormally))
                },
            }
        } else if heartbeat && lease != None {
            std.stream.managed_heartbeat(writer)
            busy = true
        }
    }
}

fn http_stream_progress(owner: HttpOwner) {
    let _ = channel.try_send(owner.progress, ())
    let _ = channel.try_send(owner.publisher, PubIn(e: Drained))
}

fn http_stream_open(ending: Option[(u64, HttpStreamEnd)]) -> bool {
    if let None = ending {
        true
    } else {
        false
    }
}

fn matches_expiry(ending: Option[(u64, HttpStreamEnd)]) -> bool {
    if let Some((_, EndWithExpiry)) = ending {
        true
    } else {
        false
    }
}

fn matches_normal(ending: Option[(u64, HttpStreamEnd)]) -> bool {
    if let Some((_, EndNormally)) = ending {
        true
    } else {
        false
    }
}

fn http_stream_join(owner: HttpOwner, take ports: HttpJoinPorts, take caller: Caller, take key: Bytes, take arg: Bytes, budget: u64, frame_limit: u64, take credit: Option[HttpBatchCredit]) -> Result[(), Refusal] {
    let input = http_subscription_input(take caller, take key, take arg, budget, frame_limit)?
    http_join(owner, take ports, take input, take credit)
}

fn http_stream_gate(owner: HttpOwner, version: u64) -> Option[std.http.ReleaseGate] {
    let Some(register) = view owner.round else {
        return None
    }
    Some(std.http.ReleaseGate(fence: latest.handle(owner.fence), round: latest.handle(register), version: version))
}

fn http_reset_reply() -> Result[std.http.Response, std.http.HandlerError] {
    http_reply(503u16, "{\"refused\":\"reset\"}", false, true, false)
}

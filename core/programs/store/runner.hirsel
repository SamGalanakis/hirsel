// Module runner (package store): the entries of a place (RUNNER-SPEC v2.10).
// Room and Bad mirror Capacity and DecodeError, which are not codec (OWN-4).
pub type Room: codec + send { requested: u64, available: u64 }

pub type Bad: codec + send { kind: u32, at: u64 }

pub type Kind: codec + key + send = Compute | Transact | Query | Granted

pub type Refusal: codec + send = NoEntry | Malformed(Bad) | Overloaded | Deadline | Budget(Room) | NotAllowed | RequestMismatch | HistoryUnavailable

pub type Fault: codec + send = Raised(u32) | OutOfBytes(Room) | OutOfTime(u64) | Gone

pub type Outcome: codec + send = Returned(Bytes) | Failed(Fault) | Refused(Refusal) | Abandoned | InDoubt

pub type Described: codec + send { kind: Kind, identity: Bytes, args: Bytes, result: Bytes }

// WIRE-SPEC v2 §3. Declared variant order fixes the u32 wire tags, Hello 0 to Reset 8.
pub type Want: codec + send { identity: Bytes, args_fp: u64, result_fp: u64 }

pub type Entry: codec + send = Ready(u32) | Resolve(u32, Bytes) | Gone

pub type Done: codec + send { stream: u32, p: u64, outcome: Outcome }

// key is the data-tree key (table id and key-codec integers big-endian). value is
// the current value codec's bytes, without a stored schema prefix; None removes it.
pub type Row: codec + send { sub: u32, key: Bytes, value: Option[Bytes] }

pub type Frame: codec + send = Hello(Option[Bytes], List[Want]) | Call(u32, u64, u32, u32, Bytes) | Subscribe(u32, u32, Bytes, Option[Bytes]) | Unsubscribe(u32) | Welcome(Caller, u32, u64, Bytes, String, u64) | Placed(Entry) | Batch(u64, List[u32], List[Row], List[Done]) | Ended(u32, Outcome) | Reset(u64, List[Done])

pub type RegisterError: send = Full(Capacity) | AlreadyRegistered(Bytes) | Bounds

pub const DEFAULT_STEPS: u64 = 1 << 30

pub type Caller = store.Caller
pub const SUBJECT_MAX: u64 = 64u64

pub fn caller_key(c: Caller, mut out: Bytes) -> Result[(), Capacity] {
    let n = list.len(c.subject)
    if n > SUBJECT_MAX { return Error(Capacity(requested: n, available: SUBJECT_MAX)) }
    list.reserve(mut out, n + 2u64)
    let _ = list.push(mut out, c.issuer)
    let _ = list.push(mut out, int.narrow(n))
    Ok(list.append(mut out, c.subject))
}

pub fn stream_key(c: Caller, number: u32) -> Result[Bytes, Capacity] {
    let mut stream: Bytes = list.with_capacity(list.len(c.subject) + 6u64)
    caller_key(c, mut stream)?
    std.codec.encode_key(std.codec.key_u32(), number, mut stream)
    Ok(take stream)
}

pub type FoundActivation: send = Empty | Legacy | Active(u64, Bytes)
pub type Selection: send = Current(u64) | Install
pub type OpenError: send = Store(store.Error) | Place(RegisterError) | Migrate(store.Error) | NotCurrent(FoundActivation) | IdentityUnknown | PublisherStopped

pub type Step: send = Recovering | Activating | Publishing | Listening(Addr)
pub type Phase: send = Starting(Step) | Ready | Draining | Paused
pub type Status: shareable + send { phase: Phase, digest: Bytes, target: String, n_place: u64, release: Bytes, activation: u64, addr: Option[Addr] }
pub type Stop: codec + send { lag_ms: u64, grace_ms: u64 }
pub type Backing: send = Memory | Disk(Dir, store.Options) | Temp(Dir)
pub type PlaceConfig[G: send, H: send, S: send]: send {
    backing: Backing, selection: Selection, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64,
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    session: WireConfig, max_sessions: u64, proxies: List[std.wsock.Prefix], n_publisher: u64,
    listen: Addr, net: Net, tasks: Tasks, clock: Clock, random: Random, stop: Stop,
    wire: Option[Wire[G]], triggers: Option[TriggerConfig[G, S]], idle: Option[u64],
}
// Grants are made per attempt. The context routes place calls back to the
// same head and carries the attempt fence.
pub type TriggerConfig[G: send, S: send]: send {
    entries: triggers.Entries,
    author: Caller,
    grants: S,
    grant: fn(S, take TriggerContext) -> Result[G, Capacity] waits,
    grant_bytes: u64,
}

pub opaque type TriggerContext: send {
    attempt: triggers.Attempt,
    to: Sender[HeadInput]
}

pub type StartError: send = Open(OpenError) | Listen(NetError) | Missing(String) | Full(Capacity)
pub type Ended: codec + send = Stopped(Option[u64]) | Unstarted | Forced(u64)

// Private runtime-supplied launch metadata. The body is a declaration placeholder;
// the call is lowered to the immutable launch transport on every engine.
fn launch_word(field: u64, index: u64) -> u64 { 0u64 }
fn launch_socket() -> Option[Socket] { None }
fn launch_scratch() -> Option[Dir] { None }

fn launch_digest() -> Result[Bytes, Capacity] {
    let len = launch_word(1u64, 0u64)
    let mut digest: Bytes = list.with_capacity(len)
    for i in 0u64..len {
        list.push(mut digest, int.narrow(launch_word(2u64, i)))
    }
    Ok(take digest)
}

fn launch_text(a: Args) -> View[String] in a { "" }

fn launch_target(a: Args) -> String {
    string.from(launch_text(a))
}

fn launch_owned_target() -> Result[String, Capacity] {
    let count = launch_word(3u64, 0u64)
    let mut text_bytes: Bytes = list.with_capacity(count)
    for index in 0u64 .. count {
        list.push(mut text_bytes, int.narrow(launch_word(4u64, index)))
    }
    Ok(result.unwrap(string.from_utf8(take text_bytes)))
}

pub fn status_root() -> Result[Latest[Status], Capacity] {
    let initial = Status(phase: Starting(Recovering), digest: launch_digest()?, target: launch_owned_target()?, n_place: launch_word(0u64, 0u64), release: list.new(), activation: 0u64, addr: None)
    let shared = arc.new(take initial)
    Ok(latest.new(take shared))
}

fn status_hex(input: Bytes) -> Result[String, Capacity] {
    let digits = string.as_bytes("0123456789abcdef")
    let mut out: Bytes = list.with_capacity(2u64 * list.len(input))
    for value in input {
        list.push(mut out, digits[int.widen(value >> 4)])
        list.push(mut out, digits[int.widen(value & 15)])
    }
    Ok(result.unwrap(string.from_utf8(take out)))
}

fn status_response(value: Status) -> Result[(bool, String), Capacity] {
    let (ready, phase) = match value.phase {
        Ready => (true, "ready"),
        Paused => (true, "paused"),
        Draining => (false, "draining"),
        Starting(_) => (false, "starting"),
    }
    let digest = status_hex(value.digest)?
    let release = status_hex(value.release)?
    let mut allowance = string.new()
    string.push_u64(mut allowance, value.n_place)
    let mut body = string.new()
    std.json.write(mut body, false, scoped fn(json: std.json.Writer) {
        std.json.object(json, 0u64, scoped fn(w: std.json.Writer, mut keys: std.json.Items) {
            std.json.write_member(w, mut keys, "phase")
            std.json.write_string_value(w, phase)
            std.json.write_member(w, mut keys, "digest")
            std.json.write_string_value(w, digest)
            std.json.write_member(w, mut keys, "target")
            std.json.write_string_value(w, value.target)
            std.json.write_member(w, mut keys, "n_place")
            std.json.write_number_spelling(w, allowance)
            std.json.write_member(w, mut keys, "release")
            std.json.write_string_value(w, release)
        })
    })
    Ok((ready, take body))
}

type IncomingStop: send { from: Receiver[()], to: Sender[LifeEvent] }

fn watch_stop(take seed: IncomingStop) -> () waits {
    let _ = channel.receive(seed.from)
    let _ = channel.send(seed.to, StopRequested)
}

type DrainTimer: send { to: Sender[LifeEvent], clock: Clock, window: DrainWindow }

fn drain_timer(take alarm: DrainTimer) -> () waits {
    host.sleep_until(alarm.clock, alarm.window.admission)
    let _ = channel.send(alarm.to, AdmissionClose)
    host.sleep_until(alarm.clock, alarm.window.deadline)
    let _ = channel.send(alarm.to, DrainExpired)
}

resource type TemporaryBacking { dir: Dir, name: String } drop(temporary) {
    if list.len(string.as_bytes(temporary.name)) != 0u64 { let _ = std.dir.remove_all(temporary.dir, temporary.name) }
}

fn publish_phase(status: Latest[Status], watch: Option[Sender[Phase]], mut current: Status, phase: Phase) -> Result[(), StartError] {
    current.phase = phase
    let copied: Status = clone(current)
    let value = take copied
    let shared = arc.new(take value)
    latest.publish(status, take shared)
    if let Some(to) = watch { let _ = channel.try_send(to, phase) }
    Ok(())
}

fn copy_status(value: Status) -> Status { clone(value) }

fn status_watch(take watch: Option[Sender[Receiver[Phase]]]) -> Result[Option[Sender[Phase]], StartError] {
    match take watch {
        Some(take handoff) => {
            let (to, from): (Sender[Phase], Receiver[Phase]) = channel.new(6u64)
            if let Error(_) = channel.try_send(handoff, take from) { return Ok(None) }
            Ok(Some(take to))
        },
        None => Ok(None),
    }
}

type CutStatus: shareable + send { started: bool }
type CutActivity: send { root: Latest[CutStatus], started: Arc[CutStatus], stopped: Arc[CutStatus] }

fn cut_activity() -> Result[CutActivity, StartError] {
    let started = arc.new(CutStatus(started: true))
    let stopped = arc.new(CutStatus(started: false))
    let root = latest.new(arc.share(stopped))
    Ok(CutActivity(root: take root, started: take started, stopped: take stopped))
}

fn serve_inbox_capacity(limit: u64) -> u64 { int.saturating_add(int.saturating_mul(limit, 2u64), 22u64) }

fn start_drain(stop: Stop, started: u64, clock: Clock, tasks: Tasks, events: Sender[LifeEvent], root: Latest[Option[DrainWindow]]) -> Result[Task[()], StartError] {
    let deadline = std.clock.deadline_after_ms(started, stop.grace_ms)
    let admission = std.clock.deadline_after_ms(started, if stop.lag_ms < stop.grace_ms { stop.lag_ms } else { stop.grace_ms })
    let window = DrainWindow(admission: admission, deadline: deadline)
    let wanted: Option[DrainWindow] = Some(window)
    let shared = arc.new(take wanted)
    latest.publish(root, take shared)
    let alarm = DrainTimer(to: channel.sender(events), clock: clock, window: window)
    Ok(task.spawn(tasks, bytes 4096u64, take alarm, drain_timer))
}

fn head_bytes(backing: Backing, n_place: u64, n_publisher: u64) -> u64 {
    let options = match backing { Disk(_, options) => options, _ => store.defaults() }
    let mut total = int.saturating_add(options.resident_limit, int.saturating_add(n_place, n_publisher))
    let on_disk = match backing { Memory => false, _ => true }
    if on_disk {
        let journal: u64 = int.widen(options.group_bytes)
        total = int.saturating_add(total, order.max(options.pack_bytes, 16777476))
        total = int.saturating_add(total, if journal > 16777296u64 { journal } else { 16777296u64 })
    }
    int.saturating_add(total, 2097152u64)
}

// What `operate` spends of its task's bytes (RUNNER-SPEC §13.4): the head's allowance,
// the serve side's reserve and its inbox, and operate's own inboxes, timers and status copies.
const OPERATE_OWN_BYTES: u64 = 262144u64

pub fn operate_bytes[G: send, H: send, S: send](p: PlaceConfig[G, H, S]) -> Result[u64, Capacity] {
    let serving = serving_bytes(p.session, p.max_sessions)?
    let grant = match p.triggers { Some(config) => config.grant_bytes, None => 0u64 }
    let head = int.saturating_add(head_bytes(p.backing, p.n_place, p.n_publisher), grant)
    Ok(int.saturating_add(int.saturating_add(head, serving), OPERATE_OWN_BYTES))
}

pub fn operate[G: send, H: send, S: send](take p: PlaceConfig[G, H, S], take stop: Receiver[()], status: Latest[Status], take watching: Option[Sender[Receiver[Phase]]]) -> Result[Ended, StartError] waits {
    if launch_word(9u64, 0u64) != 0u64 { return operate_prepare(take p) }
    let launch_idle = launch_word(13u64, 0u64)
    if p.idle == Some(0u64) { return Error(Missing("idle")) }
    if p.stop.grace_ms == 0u64 { return Error(Missing("grace_ms")) }
    if p.max_sessions == 0u64 || !wire_configuration(p.session) { return Error(Missing("session")) }
    let PlaceConfig(backing: take backing, selection: selection, place: place, migrate: migrate, handles: handles, n_place: configured, n_publisher: n_publisher,
        session: wire_config, max_sessions: limit, proxies: take proxies,
        listen: listen, net: net, tasks: tasks, clock: clock, random: random, stop: stop_config, wire: take supplied_wire, triggers: take trigger_config, idle: configured_idle) = take p
    let idle = if launch_idle != 0u64 { Some(launch_idle) } else { configured_idle }
    let n_place = if !none(launch_scratch()) { launch_word(0u64, 0u64) } else { configured }
    let mut session_config = wire_config
    session_config.n_place = n_place
    if limit == 0u64 || limit > WIRE_OWNER_LIMIT || !wire_configuration(session_config) { return Error(Missing("socket")) }
    let watch = status_watch(take watching)?
    let mut current = copy_status(latest.read(status))
    publish_phase(status, watch, mut current, Starting(Recovering))?
    let (to, inbox): (Sender[LifeEvent], Receiver[LifeEvent]) = channel.new(12u64)
    let (head_to, inbox_head): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(64u64)
    let hosting = start_host_control(tasks, clock, n_place, head_to)?
    let (finish_to, finish_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let serving_total = match serving_bytes(session_config, limit) { Ok(total) => total, Error(cap) => return Error(Full(cap)) }
    let serve_slots = serve_inbox_capacity(limit)
    // The supervisor allocates this channel before the serving task starts.
    // OwnerReady has the largest message: its tag, id and two senders cost 64 B.
    let serving_reserve = serving_total - (64u64 + serve_slots * 64u64)
    let (serve_to, inbox_serve): (Sender[ServeInput], Receiver[ServeInput]) = channel.new(serve_slots)
    let initial: Option[DrainWindow] = None
    let root = arc.new(initial)
    let drain = latest.new(take root)
    let stopping: Option[Task[()]] = match channel.try_receive(stop) {
        Error(Empty) => {
            let incoming = IncomingStop(from: take stop, to: channel.sender(to))
            Some(task.spawn(tasks, bytes 4096u64, take incoming, watch_stop))
        },
        _ => { let _ = channel.try_send(to, StopRequested); None },
    }
    let grant_bytes = match trigger_config {
        Some(config) => if triggers.is_empty(config.entries) { 0u64 } else { config.grant_bytes },
        None => 0u64,
    }
    let allowance = int.saturating_add(head_bytes(backing, n_place, n_publisher), grant_bytes)
    let activity = cut_activity()?
    let cut = latest.handle(activity.root)
    let head_job = ManagedHead(backing: take backing, selection: selection, tasks: tasks, clock: clock, random: random, place: place, migrate: migrate, handles: handles,
        n_place: n_place, n_publisher: n_publisher, inbox: take inbox_head, finish_from: take finish_from, to: channel.sender(to), drain: latest.handle(drain),
        head_to: channel.sender(head_to), cut: take activity, triggering: take trigger_config, idle: idle)
    let head_run: fn(take ManagedHead[G, H, S]) -> () waits = head_ended
    let mut heading: Option[Task[()]] = Some(task.spawn(tasks, bytes allowance, take head_job, head_run))
    let mut serving: Option[Task[()]] = None
    let mut drain_waiter: Option[Task[()]] = None
    let mut ready: Option[(Listener, Sender[PubIn])] = None
    let mut unused_listener_inputs = Some((take proxies, take supplied_wire, take inbox_serve))
    let mut stopped = false
    let mut stop_after_cut = false
    let mut online = false
    let mut retiring = false
    let mut store_id = (0u64, 0u64)
    let mut retain_from = 0u64
    let mut expired = false
    let mut settled = false
    let mut serve_done: Option[u64] = None
    let mut head_done = false
    let mut next_due: Option[u64] = None
    let mut finishing = false
    let mut start_failure: Option[StartError] = None
    let mut idle_alarm: Option[Task[()]] = None
    let mut head_idle = false
    let mut serve_idle = false
    let mut idle_since: Option[u64] = None
    let mut idle_checking = false
    let mut hold_serve: Option[Sender[()]] = None
    loop {
        if !expired && stopped && !latest.read(cut).started {
            if let Some(window) = drain_window(latest.read(drain)) {
                if host.mono_ns(clock) >= window.deadline {
                    expired = true
                    let _ = channel.try_send(serve_to, ServeWake)
                }
            }
        }
        if expired && !latest.read(cut).started && (match serving { None => true, _ => false }) {
            if let Some(take handle) = replace(mut heading, None) {
                let mut active_head = take handle
                task.cancel(mut active_head)
                let _ = task.join(take active_head)
            }
            return Ok(Forced(match serve_done { Some(count) => count, None => 0u64 }))
        } else if !expired && head_done && none(serving) && (!retiring || serve_done != None) {
            if let Some(take problem) = replace(mut start_failure, None) { return Error(take problem) }
            return Ok(if online { Stopped(next_due) } else { Unstarted })
        } else if !expired && (settled || retiring) && !finishing {
            if let Some(_) = serve_done {
                let _ = channel.try_send(finish_to, ())
                let _ = channel.try_send(head_to, HeadFinish)
                finishing = true
            }
        }
        let next = match channel.try_receive(inbox) { Ok(take event) => Some(take event), _ => None }
        let event = match take next {
            Some(take event) => take event,
            None => {
                if let Some((take listener, take pub_to)) = replace(mut ready, None) {
                    let (take addresses, take session_wire, take from_serve) = option.unwrap(replace(mut unused_listener_inputs, None))
                    let target = string.from(current.target)
                    let serving_config = ServePlace(listener: take listener, config: session_config, tasks: tasks, clock: clock, random: random, wire: take session_wire,
                        max_sessions: limit, proxies: take addresses, target: take target, publisher: take pub_to, place: place,
                        head: channel.sender(head_to), inbox: take from_serve, to: channel.sender(serve_to), events: channel.sender(to), drain: latest.handle(drain),
                        status: latest.handle(status), idle: idle, first_write: match hosting { Some(host) => Some(channel.sender(host.ack)), None => None })
                    let run: fn(take ServePlace[G, H]) -> () waits = run_serve_place
                    serving = Some(task.spawn(tasks, bytes serving_reserve, take serving_config, run))
                }
                match channel.receive(inbox) { Ok(take incoming_event) => take incoming_event, Error(_) => return Error(Missing("lifecycle")) }
            },
        }
        let (life_input, hold_head) = match take event {
            HeadIdleChecked(Some(take held)) if !stopped && !retiring && head_idle && serve_idle && !none(idle_since) =>
                (StopRequested, Some(take held)),
            take other => (take other, None),
        }
        match take life_input {
            StopRequested => {
                if stopped { continue }
                if latest.read(cut).started {
                    stop_after_cut = true
                    continue
                }
                let started = host.mono_ns(clock)
                stopped = true
                let idle_stop = !none(hold_head)
                let bounds = if idle_stop { Stop(lag_ms: 0u64, grace_ms: stop_config.grace_ms) } else { stop_config }
                drain_waiter = Some(start_drain(bounds, started, clock, tasks, to, drain)?)
                publish_phase(status, watch, mut current, Draining)?
                let _ = replace(mut idle_alarm, None)
                if idle_stop {
                    let _ = channel.try_send(head_to, HeadClose)
                } else {
                    let _ = channel.try_send(head_to, PauseDeadline(0u64))
                    if let Some(_) = replace(mut ready, None) { let _ = channel.try_send(head_to, HeadClose) }
                }
                let _ = take hold_head
                let _ = replace(mut hold_serve, None)
                if !online { let _ = channel.try_send(serve_to, ServeWake) }
            },
            Recovered => if stopped { let _ = channel.try_send(head_to, HeadClose) } else {
                publish_phase(status, watch, mut current, Starting(Activating))?
                let _ = channel.try_send(head_to, HeadContinue)
            },
            Activated(take release, version, identity, retained) => {
                current.release = take release
                current.activation = version
                store_id = identity
                retain_from = retained
                if stopped {
                    publish_phase(status, None, mut current, Draining)?
                    let _ = channel.try_send(head_to, HeadClose)
                } else {
                    publish_phase(status, watch, mut current, Starting(Publishing))?
                    let _ = channel.try_send(head_to, HeadContinue)
                }
            },
            Published(take pub_to) => if stopped { let _ = channel.try_send(head_to, HeadClose) } else {
                match host.listen(net, listen, 128u16) {
                    Ok((take listener, address)) => {
                        current.addr = Some(address)
                        publish_phase(status, watch, mut current, Starting(Listening(address)))?
                        ready = Some((take listener, take pub_to))
                    },
                    Error(problem) => { start_failure = Some(Listen(problem)); let _ = channel.try_send(head_to, HeadClose) },
                }
            },
            ServePrepared => {
                if stopped {
                    let _ = channel.try_send(serve_to, ServeWake)
                    let _ = channel.try_send(head_to, HeadClose)
                } else {
                    publish_phase(status, watch, mut current, Ready)?
                    online = true
                    if let Some(ms) = idle { idle_alarm = Some(idle_sweep(tasks, clock, ms, to)) }
                    let _ = channel.try_send(head_to, HeadContinue)
                    if let Some(control) = hosting {
                        let ready_ns = host.mono_ns(clock)
                        let release: Bytes = clone(current.release)
                        let _ = channel.try_send(control.answer, PlaceOpened(PlaceReady(version: current.activation, store_hi: store_id.0, store_lo: store_id.1, release: take release, retain_from: retain_from, ready_ns: ready_ns)))
                    }
                    let _ = channel.try_send(serve_to, ServeStart)
                }
            },
            AdmissionClose => {
                if let Some(_) = serving { let _ = channel.try_send(head_to, HeadClose); let _ = channel.try_send(serve_to, ServeWake) }
            },
            DrainExpired => {
                if !latest.read(cut).started {
                    expired = true
                    let _ = channel.try_send(serve_to, ServeWake)
                }
            },
            IdleSweep => if !stopped && !retiring {
                let ms = option.unwrap(idle)
                idle_alarm = Some(idle_sweep(tasks, clock, ms, to))
                if head_idle && serve_idle && !idle_checking {
                    let now = host.mono_ns(clock)
                    match idle_since {
                        None => { idle_since = Some(now) },
                        Some(since) if now >= std.clock.deadline_after_ms(since, ms) => {
                            if let Ok(()) = channel.try_send(serve_to, CheckServeIdle) { idle_checking = true }
                        },
                        _ => (),
                    }
                }
            },
            HeadIdle(value) => { head_idle = value; if !value { idle_since = None } },
            ServeIdle(value) => { serve_idle = value; if !value { idle_since = None } },
            ServeIdleChecked(take held) => {
                if !stopped && !retiring && !none(held) && head_idle && !none(idle_since) {
                    if let Ok(()) = channel.try_send(head_to, CheckHeadIdle) {
                        hold_serve = take held
                        continue
                    }
                }
                idle_checking = false
                idle_since = None
            },
            HeadIdleChecked(_) => {
                let _ = replace(mut hold_serve, None)
                idle_checking = false
                idle_since = None
            },
            Settled => { settled = true },
            WritesPaused => if !stopped { publish_phase(status, watch, mut current, Paused)? },
            WritesResumed => {
                if stop_after_cut {
                    stop_after_cut = false
                    let _ = channel.try_send(to, StopRequested)
                } else if !stopped {
                    publish_phase(status, watch, mut current, Ready)?
                }
            },
            RetirePlace => {
                retiring = true
                let _ = replace(mut hold_serve, None)
                if let Error(_) = channel.send(serve_to, ServeRetire) { serve_done = Some(0u64) }
            },
            HeadEnded(take ending) => {
                if let Some(take handle) = replace(mut heading, None) { let _ = task.join(take handle) }
                head_done = true
                match take ending {
                    Ok(due) => { next_due = due },
                    Error(take problem) => {
                        if let Some(host) = hosting {
                            let response = match problem {
                                Open(NotCurrent(Active(version, description))) => {
                                    PlaceCurrent(version, clone(description))
                                },
                                Open(NotCurrent(Legacy)) => PlaceRefused("Legacy"),
                                Open(NotCurrent(Empty)) => PlaceRefused("Empty"),
                                Full(_) => PlaceRefused("Full"),
                                Open(Store(Full(_))) => PlaceRefused("Full"),
                                Open(Store(Missing(name))) => {
                                    PlaceRefused(clone(name))
                                },
                                Open(Store(Schema(_))) => PlaceRefused("Schema"),
                                Open(Store(Decode(_))) => PlaceRefused("Decode"),
                                Open(Store(Corrupt(_))) => PlaceRefused("Corrupt"),
                                Open(Store(Held)) => PlaceRefused("Held"),
                                Open(Store(Poisoned(_))) => PlaceRefused("Poisoned"),
                                Open(Store(Io(_))) => PlaceRefused("Io"),
                                Open(Place(_)) => PlaceRefused("Place"),
                                Open(IdentityUnknown) => PlaceRefused("Identity"),
                                Open(PublisherStopped) => PlaceRefused("PublisherStopped"),
                                _ => PlaceRefused("Open"),
                            }
                            let _ = channel.send(host.answer, take response)
                            if let Ok(()) = channel.receive(host.sent) {}
                        }
                        if !stopped || online {
                            if let None = start_failure { start_failure = Some(take problem) }
                        }
                    },
                }
            },
            ServeEnded(take ending) => {
                if let Some(take handle) = replace(mut serving, None) { let _ = task.join(take handle) }
                match take ending {
                    Ok(count) => { serve_done = Some(count) },
                    Error(take problem) => if online { return Error(take problem) } else {
                        start_failure = Some(take problem)
                        let _ = channel.try_send(head_to, HeadClose)
                    },
                }
            },
        }
    }
}

fn prepare_bytes(field: u64, size: u64) -> Result[Bytes, StartError] {
    let mut value: Bytes = list.with_capacity(size)
    for i in 0u64 .. size { list.push(mut value, int.narrow(launch_word(field, i))) }
    Ok(take value)
}

fn operate_prepare[G: send, H: send, S: send](take p: PlaceConfig[G, H, S]) -> Result[Ended, StartError] waits {
    let PlaceConfig(backing: take backing, place: place, migrate: migrate, handles: handles, clock: clock, tasks: tasks, triggers: take config, ..) = take p
    let (scratch, options) = match backing { Disk(scratch, options) => (scratch, options), _ => return Error(Missing("scratch")) }
    let entries = match take config {
        Some(TriggerConfig(entries: take listed, ..)) => take listed,
        None => triggers.empty_entries(),
    }
    let setup = PrepareConfig(scratch: scratch, options: options, attempt: prepare_bytes(10u64, 16u64)?, image_digest: prepare_bytes(11u64, 32u64)?,
        clock: clock, tasks: tasks, n_place: launch_word(0u64, 0u64), place: place, migrate: migrate, handles: handles, triggers: take entries)
    match prepare_deploy(setup) {
        Ok(()) => Ok(Unstarted),
        Error(Open(take problem)) => Error(Open(take problem)),
        Error(Identity) => Error(Open(IdentityUnknown)),
        Error(Deploy(Store(take problem))) => Error(Open(Store(take problem))),
        Error(Deploy(Scratch(Limit(Triggers)))) => Error(Open(Store(Limit(Triggers)))),
        Error(Deploy(_)) => Error(Missing("prepared")),
    }
}

// One erased adapter per kind, holding the entry's byte bound n from registration
// (RUNNER-SPEC v2.4 §1.1). A compute slot runs in the caller's task; a granted slot
// starts a task under `bytes n` that holds the grant. A transact slot has two: the
// session's check (rule 5: decode the argument, keep nothing) and the head's run, with the
// entry's step bound and its code.revision, which each call record carries (R5, §7).
type Slot[G: send, H: send]: send = Compute(own[send] fn(Bytes) -> Outcome) | Granted(own[send] fn(Tasks, take JobGrant[G], take Caller, take Bytes, take Option[JobReport]) -> Result[Task[Outcome], Capacity]) | Transact(u64, u64, Option[Bytes], own[send] fn(Bytes) -> Option[Refusal], own[send] fn(mut store.Tx, H, Caller, Bytes) -> Ran) | Query(u64, u64, own[send] fn(store.Snapshot, H, Caller, Bytes, store.Snapshot, Option[View[Cover]], u32, Log[Row]) -> Queried) | Fenced(u64, u64, own[send] fn(mut store.Tx, triggers.Attempt, Bytes) -> Result[Bytes, store.Error])

pub opaque type Registry[G: send, H: send]: send {
    slots: Map[Bytes, Slot[G, H]],
    exported: List[Exported],
    checks: Map[Bytes, own[send] fn(Bytes) -> Option[Refusal]],
    gone: Map[Bytes, ()]
}

pub fn registry[G: send, H: send]() -> Registry[G, H] {
    Registry(slots: map.new(), exported: list.new(), checks: map.new(), gone: map.new())
}

fn check_call_reserve(n_e: u64, s_e: u64) -> Result[(), RegisterError] {
    let plan = store.Plan(n_e: n_e, s_e: s_e, reply_max: MAX_RETURNED_BYTES + 8u64)
    match store.call_reserves(plan) { Some(_) => Ok(()), None => Error(Bounds) }
}

fn room(c: Capacity) -> Room {
    Room(requested: c.requested, available: c.available)
}

fn store_capacity(cause: store.StoreCapacity) -> Capacity {
    match cause {
        Journal(c) => c,
        Resident(c) => c,
        Allocation(c) => c,
    }
}

// RUNNER-SPEC §1.1's fixed Bad.kind table.
fn bad(e: std.codec.DecodeError) -> Bad {
    match e {
        Truncated(at) => Bad(kind: 0u32, at: at),
        Invalid(at) => Bad(kind: 1u32, at: at),
        Utf8(at) => Bad(kind: 2u32, at: at),
        Duplicate(at) => Bad(kind: 3u32, at: at),
        Trailing(at) => Bad(kind: 4u32, at: at),
        Schema(at) => Bad(kind: 5u32, at: at),
        Value(at) => Bad(kind: 6u32, at: at),
    }
}

// RUNNER-SPEC v2.10 §1.1: fixed wire kinds, independent of core ordinals.
fn raised(cs: Causes) -> u32 {
    for c in cs {
        return match c.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity(_) => 7u32,
            OutOfTime => 8u32,
        }
    }
    0u32
}

type DecodeFail { e: std.codec.DecodeError }

fn encoded[R](cr: std.codec.Codec[R], r: R) -> Outcome {
    let mut out: Bytes = list.new()
    match std.codec.encode(cr, r, mut out) {
        Ok(()) => limited_reply(take out),
        Error(_) => fail("runner: unrepresentable reply count"),
    }
}

// The compute adapter: decode A, call f and encode R, all inside `bound bytes n` and
// `isolate`. A budget the place cannot grant is Refused(Budget); exhaustion after entry
// is Failed(OutOfBytes); a fault is Failed(Raised).
fn adapt_compute[A, R](f: StaticFn[fn(take A) -> Result[R, Capacity]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], arg: Bytes, n: u64, s: u64) -> Outcome {
    let body = code.callable(f)
    let ran = bound bytes n {
        let run = scoped fn() -> Result[Result[Outcome, DecodeFail], OutOfTime] {
            bound steps s {
            match std.codec.decode(ca, arg) {
                Ok(take a) => match body(take a) {
                    Ok(take r) => Ok(encoded(cr, r)),
                    Error(c) => Ok(Failed(OutOfBytes(room(c)))),
                },
                Error(e) => Error(DecodeFail(e: e)),
            }
            }
        }
        isolate(run)
    }
    match take ran {
        Ok(Ok(Ok(Ok(Ok(take o))))) => take o,
        Ok(Ok(Ok(Ok(Error(d))))) => Refused(Malformed(bad(d.e))),
        Ok(Ok(Ok(Error(e)))) => Failed(OutOfTime(e.steps)),
        Ok(Ok(Error(cs))) => {
            for cause in cs {
                if let Capacity(c) = cause.kind { return Failed(OutOfBytes(room(c))) }
                break
            }
            Failed(Raised(raised(cs)))
        },
        Ok(Error(c)) => Failed(OutOfBytes(room(c))),
        Error(c) => Refused(Budget(room(c))),
    }
}

type JobGrant[G: send]: send = Direct(G) | FromPlace(Sender[GrantRequest[G]], TriggerContext)

type Job[G: send, A, R]: send {
    f: StaticFn[fn(G, Caller, take A) -> Result[R, Capacity] waits],
    ca: std.codec.Codec[A],
    cr: std.codec.Codec[R],
    grant: JobGrant[G],
    caller: Caller,
    arg: Bytes,
    steps: u64
}

// The granted adapter, the body of the task `start` spawns under `bytes n`.
fn adapt_granted[G: send, A, R](take j: Job[G, A, R]) -> Outcome waits {
    let allowance = j.steps
    let ran = bound steps allowance {
        let Job(f: f, ca: ca, cr: cr, grant: take source, caller: take caller, arg: take arg, steps: _) = take j
        let grants = match take source {
            Direct(take value) => take value,
            FromPlace(to, take ctx) => match attempt_grants(to, take ctx) {
                Ok(take value) => take value,
                Error(take outcome) => return take outcome,
            },
        }
        let body = code.callable(f)
        match std.codec.decode(ca, arg) {
            Ok(take a) => match body(grants, caller, take a) {
                Ok(take r) => encoded(cr, r),
                Error(c) => Failed(OutOfBytes(room(c))),
            },
            Error(e) => Refused(Malformed(bad(e))),
        }
    }
    match take ran { Ok(take o) => take o, Error(e) => Failed(OutOfTime(e.steps)) }
}

// Key = identity ++ fingerprint(A) ++ fingerprint(reply), each fingerprint u64 little-endian.
// The reply is the type the Returned bytes carry: Result[R, E] for transact, R for compute
// and granted (RUNNER-SPEC v2.11.2), so a change to E alone changes the Key.
fn described[A, R](identity: View[Bytes], revision: Option[View[Bytes]], kind: Kind, ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Result[(Bytes, Exported), std.codec.EncodeError] {
    let args = std.codec.schema(ca)?
    let result = std.codec.schema(cr)?
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)
    list.append(mut key, identity)
    let args_fp = std.codec.fingerprint_of(args)
    let result_fp = std.codec.fingerprint_of(result)
    std.codec.put_u64(args_fp, mut key)
    std.codec.put_u64(result_fp, mut key)
    let mut id: Bytes = list.with_capacity(list.len(identity))
    list.append(mut id, identity)
    let mut rev: Bytes = list.new()
    if let Some(digest) = revision { list.append(mut rev, digest) }
    let d = Described(kind: kind, identity: take id, args: take args, result: take result)
    Ok((take key, Exported(described: take d, args_fp: args_fp, result_fp: result_fp, revision: take rev)))
}

// The one insertion: a key already present is refused and the registry is unchanged.
fn insert[G: send, H: send](mut r: Registry[G, H], take key: Bytes, take d: Exported, take s: Slot[G, H]) -> Result[(), RegisterError] {
    if map.contains(r.slots, key) {
        return Error(AlreadyRegistered(take key))
    }
    list.reserve(mut r.exported, 1u64)
    map.insert(mut r.slots, take key, take s)
    list.push(mut r.exported, take d)
    Ok(())
}

pub fn compute[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(take A) -> Result[R, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Compute, ca, cr) {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(arg: Bytes) -> Outcome { adapt_compute(f, ca, cr, arg, n, s) }
    insert(mut r, take key, take d, Compute(made))
}

pub fn granted[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(G, Caller, take A) -> Result[R, Capacity] waits], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Granted, ca, cr) {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(tasks: Tasks, take g: JobGrant[G], take caller: Caller, take arg: Bytes, take notice: Option[JobReport]) -> Result[Task[Outcome], Capacity] {
        let j = Job(f: f, ca: ca, cr: cr, grant: take g, caller: take caller, arg: take arg, steps: s)
        if let Some(take report) = take notice {
            let watched = WatchedJob(job: take j, report: take report, tasks: tasks, allowance: n)
            return Ok(task.spawn(tasks, bytes int.saturating_add(n, 4096u64), take watched, watch_granted))
        }
        Ok(task.spawn(tasks, bytes n, take j, adapt_granted))
    }
    insert(mut r, take key, take d, Granted(made))
}

// The export list in registration order: the codec of List[Described].
pub fn describe[G: send, H: send](r: Registry[G, H], mut out: Bytes) -> Result[(), std.codec.EncodeError] {
    let c: std.codec.Codec[Described] = std.codec.of()
    let count = list.len(r.exported)
    if count > 0xffffffffu64 { return Error(CountOverflow(count)) }
    std.codec.put_u32(int.truncate(count), mut out)
    for entry in r.exported { std.codec.put_with(entry.described, c, mut out)? }
    Ok(())
}

pub type Exported: codec + send { described: Described, args_fp: u64, result_fp: u64, revision: Bytes }

pub fn release_digest(exported: List[Exported]) -> Result[Bytes, std.codec.EncodeError] {
    let codec: std.codec.Codec[List[Exported]] = std.codec.of_list()
    let mut payload: Bytes = list.new()
    std.codec.encode(codec, exported, mut payload)?
    let mut hash = std.sha256.start()
    let domain = string.as_bytes("hirsel.release.v1")
    std.sha256.add_byte(mut hash, int.truncate(list.len(domain)))
    std.sha256.add(mut hash, domain, 0u64, list.len(domain))
    std.sha256.add(mut hash, payload, 0u64, list.len(payload))
    let digest = std.sha256.finish(hash)
    let mut out: Bytes = list.with_capacity(32u64)
    for index in 0u64 .. 32u64 {
        list.push(mut out, digest[index])
    }
    Ok(take out)
}

pub type Describe: codec + send { digest: Bytes, target: String, n_place: u64, exported: List[Exported] }

pub type Preview: codec + send { describe: Describe, release: Bytes, answers: List[Entry] }

pub type ReleaseManifest: codec + send {
    describe: Describe,
    release: Bytes,
    grants: List[String],
    root_limit: u64,
    recipe: Bytes
}

fn preview_old_entries() -> Result[List[Exported], RegisterError] {
    let count = launch_word(7u64, 0u64)
    let mut payload: Bytes = list.with_capacity(count)
    for i in 0u64 .. count {
        list.push(mut payload, int.narrow(launch_word(8u64, i)))
    }
    let codec: std.codec.Codec[List[Exported]] = std.codec.of_list()
    match std.codec.decode(codec, payload) {
        Ok(take entries) => Ok(take entries),
        Error(_) => Error(Bounds),
    }
}

fn preview_answers[G: send, H: send](r: Registry[G, H]) -> Result[List[Entry], RegisterError] {
    let old = preview_old_entries()?
    let mut answers: List[Entry] = list.with_capacity(list.len(old))
    for i in 0u64 .. list.len(old) {
        let row = view old[i]
        let key = match entry_key(view row.described.identity, row.args_fp, row.result_fp) {
            Ok(take key) => take key, Error(c) => return Error(Full(c)),
        }
        list.push(mut answers, answer_want(r, key, int.narrow(i)))
    }
    Ok(take answers)
}

fn encode_preview(take description: Describe, take answers: List[Entry]) -> Result[Bytes, RegisterError] {
    let release = release_digest(description.exported) ?=> |_| Bounds
    let preview = Preview(describe: take description, release: take release, answers: take answers)
    let codec: std.codec.Codec[Preview] = std.codec.of()
    let mut out: Bytes = list.new()
    match std.codec.encode(codec, preview, mut out) {
        Ok(()) => Ok(take out),
        Error(_) => Error(Bounds),
    }
}

pub type DescribeError: codec + send = PlaceCapacity(Room) | AlreadyRegistered(Bytes) | Bounds

fn launch_emit(data: Bytes) -> bool { false }

fn encode_describe(description: Describe) -> Result[Bytes, std.codec.EncodeError] {
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let mut out: Bytes = list.new()
    std.codec.encode(codec, description, mut out)?
    Ok(take out)
}

fn describe_registered[G: send, H: send](a: Args, take r: Registry[G, H]) -> Result[Bytes, RegisterError] {
    let preview = if launch_word(6u64, 0u64) != 0u64 { Some(preview_answers(r)?) } else { None }
    let Registry(exported: take exported, ..) = take r
    let digest = match launch_digest() {
        Ok(take digest) => take digest,
        Error(c) => return Error(Full(c)),
    }
    let target = launch_target(a)
    let description = Describe(digest: take digest, target: take target, n_place: launch_word(0u64, 0u64), exported: take exported)
    if let Some(take answers) = take preview { return encode_preview(take description, take answers) }
    Ok(encode_describe(description) ?=> |_| Bounds)
}

pub type ReleaseRecord: codec + send { release: Bytes, digest: Bytes }

fn current_description(db: store.Db) -> Result[Option[Bytes], store.Error] {
    match store.system_table(db, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes()) {
        Ok(take table) => store.get(store.snapshot(db), store.shape(table), 0u8),
        Error(Missing(_)) => Ok(None),
        Error(take problem) => Error(take problem),
    }
}

fn activation_window(db: store.Db) -> Result[(u64, u64), store.Error] {
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    let table = store.system_table(db, "hirsel.runner.releases", std.codec.key_u64(), codec)?
    let mut rows = store.scan(store.snapshot(db), store.shape(table), Unbounded, Unbounded)?
    let mut latest: u64 = 0
    let mut previous = 0u64
    let mut live = 0u64
    let first_record = int.saturating_add(store.retained_main_after(db), 1u64)
    while let Some((version, _)) = store.next(mut rows)? {
        previous = latest
        latest = version
        if version <= first_record { live = version }
    }
    if latest == 0u64 { return Error(Missing("activation version")) }
    let recent = if previous == 0u64 { latest } else { previous }
    Ok((latest, if live == 0u64 { recent } else { std.order.min(recent, live) }))
}

pub fn activation_version(db: store.Db) -> Result[u64, store.Error] {
    let (version, _) = activation_window(db)?
    Ok(version)
}

// Keep these options in Args so they are also present during Run tape replay.
pub fn launch_selection(a: Args) -> Result[Selection, Exit] {
    let mut selected: Option[Selection] = None
    for i in 0u64 .. args.len(a) {
        let name = option.unwrap(args.get(a, i))
        let choice = if name == "--hirsel-install" {
            Install
        } else if let Some(value) = std.string.strip_prefix(name, "--hirsel-activation=") {
            let Ok(v) = (int.parse(value) : Result[u64, ParseError]) else { return Error(Exit(status: 1u8)) }
            Current(v)
        } else {
            continue
        }
        if let Some(_) = selected { return Error(Exit(status: 1u8)) }
        selected = Some(choice)
    }
    Ok(match selected { Some(choice) => choice, None => Current(0u64) })
}

fn prepare_activation[G: send, H: send](r: Registry[G, H], n_place: u64) -> Result[(Bytes, ReleaseRecord), RegisterError] {
    let release = release_digest(r.exported) ?=> |_| Bounds
    let image = launch_digest() ?=> Full
    let target = launch_owned_target() ?=> Full
    let description = Describe(digest: take image, target: take target, n_place: n_place, exported: clone(r.exported))
    let payload = encode_describe(description) ?=> |_| Bounds
    let Describe(digest: take digest, ..) = take description
    Ok((take payload, ReleaseRecord(release: take release, digest: take digest)))
}

fn describe_response[G: send, H: send](a: Args, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]]) -> Result[Bytes, RegisterError] {
    let run = code.callable(place)
    // The isolate's cause cell belongs to the parent, outside n_place.
    let ran = isolate(scoped fn() -> Result[Result[Bytes, RegisterError], Capacity] {
        bound bytes launch_word(0u64, 0u64) {
            let mut r: Registry[G, H] = registry()
            match run(mut r) {
                Ok(()) => describe_registered(a, take r),
                Error(take e) => Error(take e),
            }
        }
    })
    match take ran {
        Ok(Ok(Ok(take answer))) => take answer,
        Ok(Ok(Error(c))) => Error(Full(c)),
        Ok(Error(causes)) => {
            for cause in causes {
                if let Capacity(c) = cause.kind { return Error(Full(c)) }
                break
            }
            fail("runner: describe failed")
        },
        Error(c) => Error(Full(c)),
    }
}

type HostStop: send { process: Process, to: Sender[()] }

fn wait_for_host_stop(take stop: HostStop) -> () waits {
    let HostStop(process: process, to: take to) = take stop
    host.stopped(process)
    let _ = take to
}

pub type MainError: send = Usage(Exit) | Start(StartError)

pub fn main[G: send, H: send](a: Args, process: Process, errors: Stderr, tasks: Tasks, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn(take Receiver[()]) -> Result[Ended, MainError] waits) -> Result[(), Exit] waits {
    let serving = scoped fn() -> Result[(), Exit] waits {
        let full = Exit(status: 1u8)
        let (to, from): (Sender[()], Receiver[()]) = channel.new(1u64)
        let seed = HostStop(process: process, to: take to)
        let mut waiting = task.spawn(tasks, bytes 4096u64, take seed, wait_for_host_stop)
        let ended = start_server(take from)
        task.cancel(mut waiting)
        let _ = task.join(take waiting)
        match take ended {
            Ok(Stopped(due)) => {
                if launch_word(12u64, 0u64) != 0u64 {
                    let codec: std.codec.Codec[Option[u64]] = std.codec.of()
                    let mut report: Bytes = list.with_capacity(12u64)
                    if let Error(_) = std.codec.encode(codec, due, mut report) { return Error(full) }
                    if !launch_emit(report) { return Error(full) }
                }
                Ok(())
            },
            Ok(Unstarted) => Ok(()),
            Ok(Forced(count)) => {
                let mut line = string.from("place: forced at the drain deadline, ")
                string.push_u64(mut line, count)
                string.push(mut line, " sends abandoned\n")
                let _ = stderr.write(errors, line)
                Error(full)
            },
            Error(Start(problem)) => {
                let mut line = string.from("place: ")
                match problem {
                    Missing(name) => { string.push(mut line, "missing or invalid "); string.push(mut line, name) },
                    Full(_) => string.push(mut line, "out of capacity"),
                    Listen(_) => string.push(mut line, "could not listen"),
                    Open(Store(Held)) => string.push(mut line, "store is held"),
                    Open(Store(_)) => string.push(mut line, "store error"),
                    Open(Place(_)) => string.push(mut line, "place registration failed"),
                    Open(Migrate(_)) => string.push(mut line, "migration failed"),
                    Open(NotCurrent(_)) => string.push(mut line, "activation is not current"),
                    Open(IdentityUnknown) => string.push(mut line, "image identity is unavailable"),
                    Open(PublisherStopped) => string.push(mut line, "publisher stopped"),
                }
                string.push(mut line, "\n")
                let _ = stderr.write(errors, line)
                Error(full)
            },
            Error(Usage(exit)) => Error(exit),
        }
    }
    launch_server(a, place, serving)
}

// The first branch precedes the caller's ordinary serve callback, including its
// store open, listener and every capability use. No n_place runtime argument.
pub fn launch_server[G: send, H: send](a: Args, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn() -> Result[(), Exit] waits) -> Result[(), Exit] waits {
    if launch_word(5u64, 0u64) == 0u64 {
        return start_server()
    }
    match describe_response(a, place) {
        Ok(take payload) => if launch_emit(payload) { Ok(()) } else { Error(Exit(status: 1u8)) },
        Error(take e) => {
            let error: DescribeError = match take e {
                Full(c) => PlaceCapacity(room(c)),
                AlreadyRegistered(take key) => AlreadyRegistered(take key),
                Bounds => Bounds,
            }
            let codec: std.codec.Codec[DescribeError] = std.codec.of()
            let mut out: Bytes = list.new()
            match std.codec.encode(codec, error, mut out) {
                Ok(()) => { let _ = launch_emit(out) },
                Error(_) => (),
            }
            Error(Exit(status: 2u8))
        },
    }
}

// A compute call in the caller's task, under the entry's n. A key that names no compute
// entry is NoEntry.
pub fn call[G: send, H: send](r: Registry[G, H], key: Bytes, arg: Bytes) -> Outcome {
    match map.get(r.slots, key) {
        Some(Compute(run)) => run(arg),
        _ => Refused(NoEntry),
    }
}

// A granted call: a task under the entry's `bytes n` holding g. A key that names no
// granted entry is NoEntry; a task the place cannot grant is Budget.
pub fn start[G: send, H: send](r: Registry[G, H], tasks: Tasks, take g: G, take caller: Caller, key: Bytes, take arg: Bytes) -> Result[Task[Outcome], Refusal] {
    match map.get(r.slots, key) {
        Some(Granted(go)) => match go(tasks, Direct(take g), take caller, take arg, None) {
            Ok(take t) => Ok(take t),
            Error(c) => Error(Budget(room(c))),
        },
        _ => Error(NoEntry),
    }
}

pub fn finish(take t: Task[Outcome]) -> Outcome waits {
    match task.join(take t) {
        Ok(take o) => take o,
        Error(Failed(cs)) => Failed(Raised(raised(cs))),
        Error(Cancelled(cs)) => Failed(Raised(raised(cs))),
    }
}

// ---- R1 (RUNNER-SPEC v2.4 §2, §3): transact, the head, sessions and the publisher.

// Rule 10: every task that runs entries runs the place's one `place` function itself,
// here under `bytes n_place`, so the head's, the publisher's and each session's lists
// are the same list.
fn placed[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64) -> Result[Registry[G, H], RegisterError] {
    let go = code.callable(place)
    let built: Result[Result[Registry[G, H], RegisterError], Capacity] = bound bytes n_place {
        let mut r: Registry[G, H] = registry()
        match go(mut r) {
            Ok(()) => Ok(take r),
            Error(take e) => Error(take e),
        }
    }
    match take built {
        Ok(take x) => take x,
        Error(c) => Error(Full(c)),
    }
}

// A transact run, for the head: an effect to commit with its reply, a typed error whose
// reply is kept alone, a fault after entry, or a refusal that records nothing.
type Ran: send = Commit(Bytes) | Abort(Bytes) | Exhausted(Capacity) | Refuse(Refusal)

// The session's check (rule 5): the argument decodes under n, and the value is dropped.
// Running out of n is not a refusal; the head's run answers it with Failed(OutOfBytes).
fn check_arg[A](ca: std.codec.Codec[A], arg: Bytes, n: u64) -> Option[Refusal] {
    let seen = bound bytes n {
        match std.codec.decode(ca, arg) {
            Error(e) => {
                let why: Refusal = Malformed(bad(e))
                Some(take why)
            },
            _ => None,
        }
    }
    match take seen {
        Ok(take o) => take o,
        Error(c) => Some(Budget(room(c))),
    }
}

// The store's entry bound covers decoding, execution and reply encoding.
fn adapt_transact[H: send, A, R, E](f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], ce: std.codec.Codec[E], mut tx: store.Tx, h: H, author: Caller, arg: Bytes) -> Ran {
    let body = code.callable(f)
    match std.codec.decode(ca, arg) {
        Ok(take a) => {
            let res = body(mut tx, h, author, take a)
            let kept = match res { Ok(_) => true, Error(_) => false }
            let mut out: Bytes = list.new()
            match std.codec.put_result(res, cr, ce, mut out) {
                Ok(()) => {
                    let length = list.len(out)
                    if length > MAX_RETURNED_BYTES {
                        Exhausted(Capacity(requested: length, available: MAX_RETURNED_BYTES))
                    } else if kept { Commit(take out) } else { Abort(take out) }
                },
                Error(_) => fail("runner: unrepresentable reply count"),
            }
        },
        Error(e) => Refuse(Malformed(bad(e))),
    }
}

pub fn transact[G: send, H: send, A: codec, R: codec, E: codec](mut r: Registry[G, H], f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], n: u64, s: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, s)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let ce: std.codec.Codec[E] = std.codec.of()
    let carried: std.codec.Codec[Result[R, E]] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Transact, ca, carried) {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    let revision: Option[Bytes] = if list.len(d.revision) == 0u64 {
        None
    } else {
        let copied: Bytes = clone(d.revision)
        Some(take copied)
    }
    register_check(mut r, key, ca, n, s)?
    let check = fn(arg: Bytes) -> Option[Refusal] { check_arg(ca, arg, n) }
    let run = fn(mut tx: store.Tx, h: H, author: Caller, arg: Bytes) -> Ran { adapt_transact(f, ca, cr, ce, mut tx, h, author, arg) }
    insert(mut r, take key, take d, Transact(n, s, take revision, check, run))
}

pub fn attempt_key[F, A, R](definition: StaticFn[F], arg: std.codec.Codec[A], reply: std.codec.Codec[R]) -> Result[Bytes, std.codec.EncodeError] {
    let identity = code.identity(definition)
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)
    list.append(mut key, identity)
    std.codec.put_u64(std.codec.fingerprint(arg)?, mut key)
    std.codec.put_u64(std.codec.fingerprint(reply)?, mut key)
    Ok(take key)
}

// An attempt entry has no wire slot or call record. Only the head can attach
// the checked attempt, and the application must register the entry at open.
pub fn register_attempt[G: send, H: send, F, A: codec, R: codec](mut registered: Registry[G, H], definition: StaticFn[F],
    take run: own[send] fn(mut store.Tx, triggers.Attempt, take A) -> Result[R, store.Error], n: u64, steps: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, steps)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let key = attempt_key(definition, ca, cr) ?=> |_| Bounds
    if map.contains(registered.slots, key) { return Error(AlreadyRegistered(take key)) }
    let made = fn(mut tx: store.Tx, attempt: triggers.Attempt, arg: Bytes) -> Result[Bytes, store.Error] {
        let value = match std.codec.decode(ca, arg) {
            Ok(take decoded) => take decoded,
            Error(_) => return Error(Missing("attempt argument")),
        }
        let answer = run(mut tx, attempt, take value)?
        let mut raw: Bytes = list.new()
        std.codec.encode(cr, answer, mut raw) ?=> |_| Limit(Value)
        Ok(take raw)
    }
    let adapter = take made
    map.insert(mut registered.slots, take key, Fenced(n, steps, take adapter))
    Ok(())
}

// ---- R2 (RUNNER-SPEC v2.11 §4): queries and their Covers.

// A Cover names one data-tree key range [low, high) of one table (I1), without reading it. It
// keeps that table's published value, erased once here (v2.11.1, STORE-SPEC AG3), so the
// publisher normalizes a Cover's initial rows and its changed rows alike (F10).
pub opaque type Cover: send {
    low: Bytes,
    high: Bytes,
    value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error]
}

pub fn cover[K, V](t: store.Shape[K, V], lo: store.Bound[K], hi: store.Bound[K]) -> Result[Cover, Capacity] {
    let (take low, take high) = match store.key_span(t, lo, hi) {
        Ok(Span(take l, take h)) => (take l, take h),
        Error(Full(c)) => return Error(store_capacity(c)),
        _ => fail("runner: a Cover's bounds do not encode"),
    }
    let mine: store.Shape[K, V] = clone(t)
    let made = fn(c: store.Change) -> Result[Option[Bytes], store.Error] { store.published_value(mine, c) }
    Ok(Cover(low: take low, high: take high, value: made))
}

// What a query run at a Snapshot gives the publisher: its Cover and read set, an Outcome
// that ends the subscription (with the reads the run made before it stopped, when it got
// that far), or a store error, which is a Reset.
type Viewed { cover: Cover, reads: List[store.Read] }

type Queried = Covered(Viewed) | Stopped(Outcome) | Faulted(Outcome, List[store.Read]) | Lost(store.Error)

// A query body of either registration kind (rule 2). A `Plain` body never receives the
// Caller, so its result is a function of the snapshot and the argument alone; an `As` body
// receives the Caller of the session whose subscription it runs for, at every run.
type QueryBody[H, A] = Plain(StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]]) | As(StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Cover, Capacity]])

fn query_body[H, A](body: QueryBody[H, A], tx: store.Tx, h: H, caller: Caller, take a: A) -> Result[Cover, Capacity] {
    match body {
        Plain(f) => code.callable(f)(tx, h, take a),
        As(f) => code.callable(f)(tx, h, caller, take a),
    }
}

// The query adapter: decode A and call the body inside `look`, all inside `bound bytes n`. A
// fault, or exhaustion after entry, ends the subscription with Failed. The run is isolated
// inside `look`'s body, so `look` returns the reads it made before it stopped: that partial
// read log is the ended entry (§3 "Ended entries"). `caller` is the subscribing session's.
fn adapt_query[H: send, A](body: QueryBody[H, A], ca: std.codec.Codec[A], s: store.Snapshot, h: H, caller: Caller, arg: Bytes, n: u64, steps: u64, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
    let looked = bound bytes n {
        store.look(s, None, scoped fn(tx: store.Tx) -> Result[Cover, Queried] {
          let ran = isolate(fn() -> Result[Result[Cover, Queried], OutOfTime] {
           bound steps steps {
            let c = match std.codec.decode(ca, arg) {
                Ok(take a) => match query_body(body, tx, h, caller, take a) {
                    Ok(take value) => take value,
                    Error(c) => return Ok(Error(Stopped(Failed(OutOfBytes(room(c)))))),
                },
                Error(e) => return Ok(Error(Stopped(Refused(Malformed(bad(e)))))),
            }
            let projected = match old {
                Some(previous) => rerun_rows(prior, previous, s, c, sub, rows),
                None => cover_rows(s, c, sub, rows),
            }
            match take projected {
                Ok(()) => Ok(take c),
                Error(take e) => Error(projection_error(take e)),
            }
           }
          })
          match take ran {
              Ok(Ok(Ok(take v))) => take v,
              Ok(Ok(Error(e))) => Error(Stopped(Failed(OutOfTime(e.steps)))),
              Ok(Error(cs)) => Error(Stopped(Failed(Raised(raised(cs))))),
              Error(c) => Error(Stopped(Failed(OutOfBytes(room(c))))),
          }
        })
    }
    match take looked {
        Ok(Ok(Seen(take x))) => {
            let store.Seen(value: take v, version: _, reads: take reads) = take x
            match take v {
                Ok(take c) => Covered(Viewed(cover: take c, reads: take reads)),
                Error(Stopped(take why)) => Faulted(take why, take reads),
                Error(take other) => take other,
            }
        },
        Ok(Ok(Failed(cs))) => Stopped(Failed(Raised(raised(cs)))),
        Ok(Ok(Refused(c))) => Stopped(Failed(OutOfBytes(room(store_capacity(c))))),
        Ok(Ok(Stopped(e))) => Stopped(Failed(OutOfTime(e.steps))),
        Ok(Error(e)) => Lost(e),
        Error(c) => Stopped(Refused(Budget(room(c)))),
    }
}

// Rule 2's two query kinds. `query` registers a caller-independent body, which has no Caller
// parameter; `query_as` registers a caller-dependent one, which takes the Caller. The kind is
// the body's type, so a body that reads the Caller cannot be registered with `query`.
pub fn query[G: send, H: send, A: codec](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    register_query(mut r, Plain(f), n, s)
}

pub fn query_as[G: send, H: send, A: codec](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Cover, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    register_query(mut r, As(f), n, s)
}

// A query's rows travel in Batches under their tables' codecs, so its described result is
// the unit schema.
fn register_query[G: send, H: send, A: codec](mut r: Registry[G, H], body: QueryBody[H, A], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let described_query = match body {
        Plain(f) => described(code.identity(f), code.revision(f), Query, ca, cr),
        As(f) => described(code.identity(f), code.revision(f), Query, ca, cr),
    }
    let (take key, take d) = match take described_query {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(at: store.Snapshot, h: H, caller: Caller, arg: Bytes, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
        adapt_query(body, ca, at, h, caller, arg, n, s, prior, old, sub, rows)
    }
    insert(mut r, take key, take d, Query(n, s, made))
}

// ---- The publisher's subscriptions (G2, G3). A subscription keeps its Cover and read set at
// the base, never its rows (F4): rows are enumerated from the snapshots the publisher holds.
// Fields drop in reverse order: return the room after freeing the Caller, argument and key.
// `caller` is the subscribing session's, the one a caller-dependent query runs with at
// subscribe, at every rerun and at repair (rule 2).
pub opaque type SubscriptionInput: send { room: Option[SubscriptionLease], key: Bytes, arg: Bytes, caller: Caller }

resource type SubscriptionLease: send { refund: Sender[u64], charge: u64 } drop(lease) {
    let _ = channel.try_send(lease.refund, lease.charge)
}

// A live sub has its Cover. An ended entry (§3 "Ended entries") has none: it no longer runs,
// but its read set stays indexed, and its input stays charged to the session, until its first
// read-set hit, its owner's removal or the session's end.
// `due` (§3 "Repair"): a full owner inbox bounced content of this live sub. Its hits still
// fence, its diffs stop, and on its owner's progress one full `complete` replaces it.
type Sub { generation: u64, input: SubscriptionInput, cover: Option[Cover], routes: List[RouteKey], due: bool }

type SubId { who: u64, sub: u32, serial: u64 }

// The publisher holds one balanced interval tree for the data-tree keys of its open.
// Points have an inclusive upper endpoint and Covers and Spans have an exclusive one.
// Each node also holds the greatest upper endpoint in its subtree.
type RouteEnd { at: Arc[Bytes], included: bool }
type RouteKey { low: Arc[Bytes], serial: u64, slot: u64 }
type Route {
    key: RouteKey,
    id: SubId,
    end: RouteEnd,
    max: RouteEnd,
    height: u64,
    left: Option[Box[Route]],
    right: Option[Box[Route]]
}

type Subscriptions { by_session: Map[u64, Map[u32, Sub]], root: Option[Box[Route]], serial: u64 }

fn subscriptions() -> Subscriptions {
    Subscriptions(by_session: map.new(), root: None, serial: 0u64)
}

fn route_before(a: RouteKey, b: RouteKey) -> bool {
    let low_a: View[Bytes] = a.low
    let low_b: View[Bytes] = b.low
    if low_a != low_b { return low_a < low_b }
    if a.serial != b.serial { return a.serial < b.serial }
    a.slot < b.slot
}

fn end_reaches(end: RouteEnd, key: Bytes) -> bool {
    let high: View[Bytes] = end.at
    key < high || (end.included && key == high)
}

fn raise_end(mut end: RouteEnd, candidate: RouteEnd) {
    let high: View[Bytes] = candidate.at
    if !end_reaches(end, high) {
        end.at = arc.share(candidate.at)
        end.included = candidate.included
    }
}

fn route_height(root: Option[Box[Route]]) -> u64 {
    match root { Some(node) => node.height, None => 0u64 }
}

fn measure_route(mut node: Box[Route]) {
    let left = route_height(node.left)
    let right = route_height(node.right)
    node.height = 1u64 + if left > right { left } else { right }
    let mut far = RouteEnd(at: arc.share(node.end.at), included: node.end.included)
    if let Some(child) = node.left { raise_end(mut far, child.max) }
    if let Some(child) = node.right { raise_end(mut far, child.max) }
    node.max = take far
}

fn rotate_route_left(take node: Box[Route]) -> Box[Route] {
    let mut parent = take node
    let mut next = option.unwrap(replace(mut parent.right, None))
    parent.right = replace(mut next.left, None)
    measure_route(mut parent)
    next.left = Some(take parent)
    measure_route(mut next)
    take next
}

fn rotate_route_right(take node: Box[Route]) -> Box[Route] {
    let mut parent = take node
    let mut next = option.unwrap(replace(mut parent.left, None))
    parent.left = replace(mut next.right, None)
    measure_route(mut parent)
    next.right = Some(take parent)
    measure_route(mut next)
    take next
}

fn balance_route(take node: Box[Route]) -> Box[Route] {
    let mut root = take node
    let left = route_height(root.left)
    let right = route_height(root.right)
    if left > right + 1u64 {
        let child = option.unwrap(replace(mut root.left, None))
        root.left = Some(if route_height(child.right) > route_height(child.left) {
            rotate_route_left(take child)
        } else { take child })
        return rotate_route_right(take root)
    }
    if right > left + 1u64 {
        let child = option.unwrap(replace(mut root.right, None))
        root.right = Some(if route_height(child.left) > route_height(child.right) {
            rotate_route_right(take child)
        } else { take child })
        return rotate_route_left(take root)
    }
    measure_route(mut root)
    take root
}

fn put_route(take top: Option[Box[Route]], take node: Box[Route]) -> Box[Route] {
    let Some(take old) = take top else { return take node }
    let mut root = take old
    if route_before(node.key, root.key) {
        let child = replace(mut root.left, None)
        root.left = Some(put_route(take child, take node))
    } else {
        let child = replace(mut root.right, None)
        root.right = Some(put_route(take child, take node))
    }
    balance_route(take root)
}

fn take_first_route(take root: Box[Route], mut rest: Option[Box[Route]]) -> Box[Route] {
    let mut node = take root
    if let Some(take left) = replace(mut node.left, None) {
        let first = take_first_route(take left, mut node.left)
        rest = Some(balance_route(take node))
        take first
    } else {
        rest = replace(mut node.right, None)
        take node
    }
}

fn drop_route(take top: Option[Box[Route]], key: RouteKey) -> Option[Box[Route]] {
    let mut root = option.unwrap(take top)
    if route_before(key, root.key) {
        let child = replace(mut root.left, None)
        root.left = drop_route(take child, key)
    } else if route_before(root.key, key) {
        let child = replace(mut root.right, None)
        root.right = drop_route(take child, key)
    } else {
        let right = replace(mut root.right, None)
        let Some(take child) = take right else { return replace(mut root.left, None) }
        let mut rest: Option[Box[Route]] = None
        let mut next = take_first_route(take child, mut rest)
        next.left = replace(mut root.left, None)
        next.right = take rest
        return Some(balance_route(take next))
    }
    Some(balance_route(take root))
}

// Allocate before changing the tree. An insertion or removal only moves boxes.
fn stage_route(mut nodes: List[Box[Route]], id: SubId, slot: u64, take interval: store.Read) -> Result[(), Capacity] {
    let (take low, take end) = match take interval {
        Point(take point) => {
            let endpoint = arc.new(take point)
            (arc.share(endpoint), RouteEnd(at: take endpoint, included: true))
        },
        Span(take lo, take hi) => {
            if hi <= lo { return Ok(()) }
            let upper = arc.new(take hi)
            (arc.new(take lo), RouteEnd(at: take upper, included: false))
        },
    }
    let max = RouteEnd(at: arc.share(end.at), included: end.included)
    let node = Route(key: RouteKey(low: take low, serial: id.serial, slot: slot), id: id,
        end: take end, max: take max, height: 1u64, left: None, right: None)
    Ok(list.push(mut nodes, box.new(take node)))
}

fn cover_view(c: Option[Cover]) -> Option[View[Cover]] in c {
    match c {
        Some(x) => Some(x),
        None => None,
    }
}

// Slot 0 is the Cover's route, which an ended entry does not have; reads take slots from 1.
fn stage_routes(id: SubId, c: Option[View[Cover]], take reads: List[store.Read]) -> Result[(List[Box[Route]], List[RouteKey]), Capacity] {
    let mut nodes: List[Box[Route]] = list.with_capacity(list.len(reads) + 1u64)
    if let Some(span) = c { stage_route(mut nodes, id, 0u64, Span(clone(span.low), clone(span.high)))? }
    let mut slot = 0u64
    for take read in reads {
        slot += 1u64
        stage_route(mut nodes, id, slot, take read)?
    }
    let mut keys: List[RouteKey] = list.with_capacity(list.len(nodes))
    for node in nodes {
        let key = node.key
        list.push(mut keys, RouteKey(low: arc.share(key.low), serial: key.serial, slot: key.slot))
    }
    Ok((take nodes, take keys))
}

fn install_routes(mut root: Option[Box[Route]], take nodes: List[Box[Route]]) {
    for take node in nodes {
        let previous = replace(mut root, None)
        root = Some(put_route(take previous, take node))
    }
}

fn unregister_routes(mut root: Option[Box[Route]], keys: List[RouteKey]) {
    for key in keys {
        let previous = replace(mut root, None)
        root = drop_route(take previous, key)
    }
}

fn route_key(root: Option[Box[Route]], key: Bytes, mut hits: Map[u64, (SubId, bool)]) -> Result[(), Capacity] {
    let Some(node) = view root else { return Ok(()) }
    if !end_reaches(node.max, key) { return Ok(()) }
    route_key(node.left, key, mut hits)?
    let low: View[Bytes] = node.key.low
    if key < low { return Ok(()) }
    if end_reaches(node.end, key) {
        let read = node.key.slot != 0u64
        if read || !map.contains(hits, node.id.serial) {
            map.insert(mut hits, node.id.serial, (node.id, read))
        }
    }
    route_key(node.right, key, mut hits)
}

fn sub_at(subs: Subscriptions, who: u64, sub: u32) -> Option[View[Sub]] in subs {
    match map.get(subs.by_session, who) {
        Some(group) => map.get(group, sub),
        None => None,
    }
}

fn put_sub(mut subs: Subscriptions, id: SubId, take value: Sub) -> Result[(), Capacity] {
    if !map.contains(subs.by_session, id.who) {
        map.insert(mut subs.by_session, id.who, map.new())
    }
    let mut incoming = Some(take value)
    let inserted = option.unwrap(map.update(mut subs.by_session, id.who, scoped fn(mut group: Map[u32, Sub]) -> Result[(), Capacity] {
        let pending_sub = option.unwrap(replace(mut incoming, None))
        Ok(map.insert(mut group, id.sub, take pending_sub))
    }))
    if let Error(_) = inserted {
        if map.len(option.unwrap(map.get(subs.by_session, id.who))) == 0u64 {
            let _ = map.remove(mut subs.by_session, id.who)
        }
    }
    inserted
}

fn remove_sub(mut subs: Subscriptions, who: u64, sub: u32) -> Option[Sub] {
    let Some((take removed, empty)) = map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> (Option[Sub], bool) {
        let removed = map.remove(mut group, sub)
        (take removed, map.len(group) == 0u64)
    }) else { return None }
    if empty { let _ = map.remove(mut subs.by_session, who) }
    if let Some(s) = view removed { unregister_routes(mut subs.root, s.routes) }
    take removed
}

// The publisher ends a live sub (§3 "Ended entries"): its Cover's route leaves the index and
// its read routes stay, as an ended entry. Nothing is allocated.
fn end_entry(mut subs: Subscriptions, who: u64, sub: u32) {
    let dropped = map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> Option[RouteKey] {
        match map.update(mut group, sub, scoped fn(mut entry: Sub) -> Option[RouteKey] {
            entry.cover = None
            entry.due = false
            if list.len(entry.routes) > 0u64 && entry.routes[0].slot == 0u64 { Some(list.remove(mut entry.routes, 0u64)) } else { None }
        }) {
            Some(take key) => take key,
            None => None,
        }
    })
    if let Some(Some(take key)) = take dropped {
        let previous = replace(mut subs.root, None)
        subs.root = drop_route(take previous, key)
    }
}

// A publisher-made Reset ends every live sub of the session; each stays as an ended entry.
fn end_session(mut subs: Subscriptions, who: u64) {
    let mut live: List[u32] = list.new()
    if let Some(group) = map.get(subs.by_session, who) {
        for (sub, entry) in group {
            if let Some(_) = entry.cover { list.push(mut live, sub) }
        }
    }
    for sub in live { end_entry(mut subs, who, sub) }
}

fn ended_entry(subs: Subscriptions, id: SubId) -> bool {
    match sub_at(subs, id.who, id.sub) {
        Some(entry) => match entry.cover { Some(_) => false, None => true },
        None => false,
    }
}

fn due_entry(subs: Subscriptions, id: SubId) -> bool {
    match sub_at(subs, id.who, id.sub) {
        Some(entry) => entry.due,
        None => false,
    }
}

// Marks a live sub for repair (§3 "Repair"); an ended entry or a removed sub is not marked.
fn mark_due(mut subs: Subscriptions, who: u64, sub: u32) -> bool {
    match map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> bool {
        match map.update(mut group, sub, scoped fn(mut entry: Sub) -> bool {
            match entry.cover {
                Some(_) => { entry.due = true; true },
                None => false,
            }
        }) {
            Some(marked) => marked,
            None => false,
        }
    }) {
        Some(marked) => marked,
        None => false,
    }
}

fn due_subs(subs: Subscriptions, who: u64) -> List[u32] {
    let mut due: List[u32] = list.new()
    if let Some(group) = map.get(subs.by_session, who) {
        for (sub, entry) in group {
            if entry.due { list.push(mut due, sub) }
        }
    }
    take due
}

// What one step owes one session: at `version`, the subs whose whole initial result it
// carries, its rows and its Ended subs; or, with `reset`, a Reset and nothing else.
type Owe: send { session: u64, version: u64, generations: List[(u32, u64)], complete: List[u32], rows: List[Row], ended: List[(u32, u64, Outcome)], reset: bool }

type Board[G: send, H: send] { r: Registry[G, H], h: H, base: store.Snapshot, newest: Option[store.Snapshot], subs: Subscriptions }

fn sub_generation(generations: List[(u32, u64)], sub: u32) -> Option[u64] {
    for (id, generation) in generations { if id == sub { return Some(generation) } }
    None
}

fn stamp_rows(mut generations: List[(u32, u64)], sub: u32, generation: u64) {
    if generation != 0u64 { list.push(mut generations, (sub, generation)) }
}

fn owe(mut owes: List[Owe], who: u64, version: u64) -> u64 {
    let mut i = 0u64
    while i < list.len(owes) {
        if owes[i].session == who {
            return i
        }
        i += 1u64
    }
    list.push(mut owes, Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false))
    i
}

fn run_query[G: send, H: send](r: Registry[G, H], h: H, s: store.Snapshot, input: SubscriptionInput, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
    match map.get(r.slots, input.key) {
        Some(Query(_, _, go)) => go(s, h, input.caller, input.arg, prior, old, sub, rows),
        _ => Stopped(Refused(NoEntry)),
    }
}

fn projection_error(take e: store.Error) -> Queried {
    match take e {
        Full(c) => Stopped(Failed(OutOfBytes(room(store_capacity(c))))),
        take other => Lost(take other),
    }
}

// The log's backing list belongs to the publisher. The row bytes and codec
// scratch created during projection are charged to the subscription's bound.
fn row_log() -> Result[Log[Row], Capacity] {
    let output: Log[Row] = log.new()
    log.append(output, Row(sub: 0u32, key: list.new(), value: None))
    Ok(take output)
}

fn read_rows(take output: Log[Row]) -> List[Row] {
    let mut rows = log.finish(take output)
    let _ = list.remove(mut rows, 0u64)
    take rows
}

fn projection_row(out: Log[Row], sub: u32, take ch: store.Change, take value: Option[Bytes]) -> Result[(), store.Error] {
    let store.Change(tree_key: take key, value: _) = take ch
    log.append(out, Row(sub: sub, key: take key, value: take value))
    Ok(())
}

// The rows inside a Cover at s, each with its published value (F10).
fn cover_rows(s: store.Snapshot, c: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    let mut rows = store.open_span_changes(s, c.low, c.high)?
    while let Some(take ch) = store.next_span_change(mut rows)? {
        let value = (c.value)(ch)?
        projection_row(out, sub, take ch, take value)?
    }
    Ok(())
}

// G3: the query runs at the base, and its whole result goes in one owe naming it complete.
fn at_base[G: send, H: send](mut b: Board[G, H], who: u64, sub: u32, take key: Bytes, take arg: Bytes) -> Owe {
    at_base_generation(mut b, who, sub, 0u64, SubscriptionInput(room: None, key: take key, arg: take arg, caller: law_caller(who)))
}

// The in-file laws' sessions: session `who` is bound to its own Caller, as a session without
// a binding is to its fresh anonymous one (issuer 1).
fn law_caller(who: u64) -> Caller {
    let mut subject: Bytes = list.new()
    std.codec.put_u64(who, mut subject)
    store.Caller(issuer: 1u8, subject: take subject)
}

fn at_base_generation[G: send, H: send](mut b: Board[G, H], who: u64, sub: u32, generation: u64, take input: SubscriptionInput) -> Owe {
    let _ = remove_sub(mut b.subs, who, sub)
    let version = store.version(b.base)
    let mut o = Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false)
    let rows = match row_log() {
        Ok(take x) => take x,
        Error(c) => {
            list.push(mut o.ended, (sub, generation, Refused(Budget(room(c)))))
            return take o
        },
    }
    match run_query(b.r, b.h, b.base, input, b.base, None, sub, rows) {
        Covered(take v) => {
            let Viewed(cover: take c, reads: take reads) = take v
            match add_subscription(mut b.subs, who, sub, generation, take input, Some(take c), take reads) {
                Ok(()) => {
                    o.rows = read_rows(take rows)
                    stamp_rows(mut o.generations, sub, generation)
                    list.push(mut o.complete, sub)
                },
                // Its read set cannot be indexed, so no content of it may go: a Reset, whose
                // other subs stay as ended entries (§3 "Ended entries").
                Error(_) => { o.reset = true },
            }
        },
        Stopped(take why) => list.push(mut o.ended, (sub, generation, take why)),
        // A faulted or refused run: its partial read log is its ended entry.
        Faulted(take why, take reads) => match add_subscription(mut b.subs, who, sub, generation, take input, None, take reads) {
            Ok(()) => list.push(mut o.ended, (sub, generation, take why)),
            Error(_) => { o.reset = true },
        },
        Lost(_) => {
            o.reset = true
        },
    }
    take o
}

fn add_subscription(mut subs: Subscriptions, who: u64, sub: u32, generation: u64, take input: SubscriptionInput, take c: Option[Cover], take reads: List[store.Read]) -> Result[(), Capacity] {
    subs.serial += 1u64
    let id = SubId(who: who, sub: sub, serial: subs.serial)
    let (take nodes, take keys) = stage_routes(id, cover_view(c), take reads)?
    put_sub(mut subs, id, Sub(generation: generation, input: take input, cover: take c, routes: take keys, due: false))?
    install_routes(mut subs.root, take nodes)
    Ok(())
}

// The rerun's difference: the keys inside the old Cover at a against the keys inside the new
// Cover at b, removals included, each new or changed key with its published value at b.
fn rerun_rows(a: store.Snapshot, old: Cover, b: store.Snapshot, new: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    let mut before = store.open_span_changes(a, old.low, old.high)?
    let mut after = store.open_span_changes(b, new.low, new.high)?
    let mut previous = store.next_span_change(mut before)?
    let mut next = store.next_span_change(mut after)?
    loop {
        let order = match (view previous, view next) {
            (Some(x), Some(y)) => if x.tree_key < y.tree_key { 0u8 } else if x.tree_key == y.tree_key { 1u8 } else { 2u8 },
            (Some(_), None) => 0u8,
            (None, Some(_)) => 2u8,
            (None, None) => return Ok(()),
        }
        if order == 0u8 {
            let removed = option.unwrap(replace(mut previous, None))
            projection_row(out, sub, take removed, None)?
            previous = store.next_span_change(mut before)?
            continue
        }
        let was = if order == 1u8 {
            let row = option.unwrap(replace(mut previous, None))
            let v = (old.value)(row)?
            previous = store.next_span_change(mut before)?
            take v
        } else {
            None
        }
        let row = option.unwrap(replace(mut next, None))
        let now = (new.value)(row)?
        if was != now {
            projection_row(out, sub, take row, take now)?
        }
        next = store.next_span_change(mut after)?
    }
}

// The changed keys inside a Cover, with their published values at b.
fn covered_rows(d: List[store.Change], c: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    for ch in d {
        let v = (c.value)(ch)?
        let copied: Bytes = clone(ch.tree_key)
        let key = take copied
        log.append(out, Row(sub: sub, key: take key, value: take v))
    }
    Ok(())
}

fn change_offset(d: List[store.Change], key: Bytes) -> u64 {
    match list.binary_search_by(d, scoped fn(ch: store.Change) -> Order {
        if ch.tree_key < key { Less } else { Greater }
    }) {
        Ok(i) => i,
        Error(i) => i,
    }
}

fn project_changes[G: send, H: send](r: Registry[G, H], key: Bytes, d: List[store.Change], c: Cover, sub: u32, rows: Log[Row]) -> Result[(), Queried] {
    // changes walks the two data trees in key order, with at most one change per key.
    let first = change_offset(d, c.low)
    let past = change_offset(d, c.high)
    match map.get(r.slots, key) {
        Some(Query(allowance, steps, _)) => bounded_changes(allowance, steps, list.slice(d, first, past), c, sub, rows),
        _ => Error(Stopped(Refused(NoEntry))),
    }
}

fn bounded_changes(allowance: u64, steps: u64, d: List[store.Change], c: Cover, sub: u32, rows: Log[Row]) -> Result[(), Queried] {
    let attempt = bound bytes allowance {
        isolate(fn() -> Result[Result[(), store.Error], OutOfTime] {
            bound steps steps { covered_rows(d, c, sub, rows) }
        })
    }
    match take attempt {
        Ok(Ok(Ok(Ok(Ok(()))))) => Ok(()),
        Ok(Ok(Ok(Ok(Error(e))))) => Error(projection_error(take e)),
        Ok(Ok(Ok(Error(e)))) => Error(Stopped(Failed(OutOfTime(e.steps)))),
        Ok(Ok(Error(cs))) => Error(Stopped(Failed(Raised(raised(cs))))),
        Ok(Error(f)) => Error(Stopped(Failed(OutOfBytes(room(f))))),
        Error(f) => Error(Stopped(Refused(Budget(room(f))))),
    }
}

// A session Reset ends all its subscriptions, whose read sets stay as ended entries, and
// replaces its owed content.
fn reset_session(mut subs: Subscriptions, mut owes: List[Owe], who: u64, version: u64) {
    end_session(mut subs, who)
    let k = owe(mut owes, who, version)
    owes[k] = Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: true)
}

fn reset_subscriptions(mut subs: Subscriptions, mut owes: List[Owe], version: u64) {
    let groups = replace(mut subs.by_session, map.new())
    subs.root = None
    for (who, _) in groups { reset_session(mut subs, mut owes, who, version) }
}

fn affected_subscriptions(subs: Subscriptions, changes: List[store.Change]) -> Result[List[(SubId, bool)], Capacity] {
    let mut hits: Map[u64, (SubId, bool)] = map.new()
    for ch in changes { route_key(subs.root, ch.tree_key, mut hits)? }
    let mut ordered: List[(SubId, bool)] = list.with_capacity(map.len(hits))
    for (_, hit) in hits { list.push(mut ordered, hit) }
    // Both projection and reruns observe the same subscription order as G3.
    list.sort(mut ordered, scoped fn(a: (SubId, bool), b: (SubId, bool)) -> Order {
        if a.0.serial < b.0.serial { Less } else if a.0.serial > b.0.serial { Greater } else { Equal }
    })
    Ok(take ordered)
}

// A re-run's Cover and read set replace the sub's, or, with no Cover, its partial read log
// makes it an ended entry.
fn replace_routes(mut subs: Subscriptions, id: SubId, take c: Option[Cover], take reads: List[store.Read]) -> Result[(), Capacity] {
    let (take nodes, take keys) = stage_routes(id, cover_view(c), take reads)?
    let mut incoming = Some((take c, take keys))
    let old = option.unwrap(option.unwrap(map.update(mut subs.by_session, id.who, scoped fn(mut group: Map[u32, Sub]) -> Option[List[RouteKey]] {
        map.update(mut group, id.sub, scoped fn(mut entry: Sub) -> List[RouteKey] {
            let (take cover_next, take routes_next) = option.unwrap(replace(mut incoming, None))
            entry.cover = take cover_next
            replace(mut entry.routes, take routes_next)
        })
    })))
    unregister_routes(mut subs.root, old)
    install_routes(mut subs.root, take nodes)
    Ok(())
}

// The sub keeps the read set of its last run as its ended entry.
fn end_round_sub(mut subs: Subscriptions, mut out: Owe, id: SubId, generation: u64, take why: Outcome) {
    list.push(mut out.ended, (id.sub, generation, take why))
    end_entry(mut subs, id.who, id.sub)
}

fn append_round_rows(mut out: Owe, id: SubId, generation: u64, take rows: Log[Row]) {
    let before = list.len(out.rows)
    for take row in read_rows(take rows) { list.push(mut out.rows, take row) }
    if list.len(out.rows) != before { stamp_rows(mut out.generations, id.sub, generation) }
}

type SubUpdate = Rows(Log[Row]) | Refreshed(Viewed, Log[Row]) | EndSub(Outcome) | EndRead(Outcome, List[store.Read]) | ResetSubs

fn advance_sub[G: send, H: send](b: Board[G, H], newest: store.Snapshot, d: List[store.Change], id: SubId, read: bool) -> Option[(u64, SubUpdate)] {
    let Some(entry) = sub_at(b.subs, id.who, id.sub) else { return None }
    let generation = entry.generation
    let rows = match row_log() {
        Ok(take x) => take x,
        Error(f) => return Some((generation, EndSub(Refused(Budget(room(f)))))),
    }
    let advanced = if read {
        match run_query(b.r, b.h, newest, entry.input, b.base, cover_view(entry.cover), id.sub, rows) {
            Covered(take v) => Refreshed(take v, take rows),
            Stopped(take why) => EndSub(take why),
            Faulted(take why, take reads) => EndRead(take why, take reads),
            Lost(_) => ResetSubs,
        }
    } else {
        let Some(c) = entry.cover else { return None }
        match project_changes(b.r, entry.input.key, d, c, id.sub, rows) {
            Ok(()) => Rows(take rows),
            Error(Stopped(take why)) => EndSub(take why),
            Error(_) => ResetSubs,
        }
    }
    Some((generation, take advanced))
}

// G2: one round from the base to the newest snapshot released.
// `fenced` gets every session with a read-set hit, found before any sub is advanced or ended;
// a lost diff fences them all.
fn round[G: send, H: send](mut b: Board[G, H], mut fenced: Fenced) -> List[Owe] {
    let mut owes: List[Owe] = list.new()
    let Some(take newest) = replace(mut b.newest, None) else { return take owes }
    let version = store.version(newest)
    let d = match store.changes(b.base, newest) {
        Ok(take x) => take x,
        Error(_) => {
            fenced.all = true
            reset_subscriptions(mut b.subs, mut owes, version)
            b.base = take newest
            return take owes
        },
    }
    let hits = match affected_subscriptions(b.subs, d) {
        Ok(take x) => take x,
        Error(_) => {
            fenced.all = true
            reset_subscriptions(mut b.subs, mut owes, version)
            b.base = take newest
            return take owes
        },
    }
    for (id, read) in hits {
        if read && !list.contains(fenced.sessions, id.who) {
            list.push(mut fenced.sessions, id.who)
        }
    }
    for (id, read) in hits {
        // An ended entry's hit is a read-set hit, fenced above: from this round's E every writer
        // drops all of its content, so the entry leaves.
        if ended_entry(b.subs, id) {
            let _ = remove_sub(mut b.subs, id.who, id.sub)
            continue
        }
        // A due sub's hit is fenced above and its diff is not computed: the repair's full
        // image replaces whatever this round changed (§3 "Repair").
        if due_entry(b.subs, id) { continue }
        let Some((generation, take advanced)) = advance_sub(b, newest, d, id, read) else { continue }
        let k = owe(mut owes, id.who, version)
        match take advanced {
            Rows(take rows) => append_round_rows(mut owes[k], id, generation, take rows),
            Refreshed(Viewed(cover: take c, reads: take reads), take rows) => {
                match replace_routes(mut b.subs, id, Some(take c), take reads) {
                    Ok(()) => append_round_rows(mut owes[k], id, generation, take rows),
                    Error(f) => end_round_sub(mut b.subs, mut owes[k], id, generation, Refused(Budget(room(f)))),
                }
            },
            EndSub(take why) => end_round_sub(mut b.subs, mut owes[k], id, generation, take why),
            EndRead(take why, take reads) => match replace_routes(mut b.subs, id, None, take reads) {
                Ok(()) => list.push(mut owes[k].ended, (id.sub, generation, take why)),
                Error(_) => reset_session(mut b.subs, mut owes, id.who, version),
            },
            ResetSubs => reset_session(mut b.subs, mut owes, id.who, version),
        }
    }
    b.base = take newest
    take owes
}

// The stream's reply at p is the Outcome's codec bytes (STORE-SPEC §1.8 reply).
fn encode_runner_reply(o: Outcome) -> Result[Bytes, store.Error] {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let mut b: Bytes = list.new()
    std.codec.encode(co, o, mut b) ?=> |_| Limit(Value)
    Ok(take b)
}

// ---- P2: the head (H1-H4) and its gate (V3, V4).

// A request at the head. The session computed its digest at ingress (store.request_digest
// over the requested key and the exact argument bytes, v2.11.3) and never takes one from a
// client.
pub opaque type Req: send { e: HeadIn }

type HeadIn: send = Requested(Request) | OwnerLeft

type Request: send {
    caller: Caller,
    stream: Bytes,
    p: u64,
    key: Bytes,
    arg: Bytes,
    digest: store.RequestDigest,
    deadline: u64,
    reply_to: Sender[WireEvent],
    live: Latest[HeadLife],
    identity: Latest[OwnerNumber],
    seed: Option[Arc[OwnerNumber]]
}

type Recipient: send { owner: u64, to: Sender[WireEvent] }

type Answer: send { recipient: Recipient, row: KeyedDone }

type Replies: send { recipient: Recipient, rows: List[KeyedDone] }

// With a snapshot, a Release carries its group's durable version (V4). Without one it
// carries commitless answers, which the publisher sends at its base (V3).
pub opaque type Release: send {
    version: u64,
    snapshot: Option[store.Snapshot],
    answers: List[Answer]
}

// The publisher's one inbox (v2.12, ruled 2026-11-17: one mailbox per actor). The head's
// Releases, a session's join, its Subscribes and Unsubscribes, its leaving and the head's
// last word arrive here in send order, so a Subscribe is ordered against every Release (G3)
// without selection, which v1 lacks.
pub opaque type PubIn: send { e: ToPub }

type ToPub: send = Released(Release) | Joined(Join) | Subscribed(u64, u32, Caller, Bytes, Bytes) | WireSubscribed(u64, u32, u64, SubscriptionInput) | Unsubscribed(u64, u32) | Left(u64) | Halt | Drained

// A session's join, on its first Subscribe: where its content goes, and where the
// publisher answers with the id it mints for the session.
// v2.14: a marked session (an HTTP group or one-shot read) sends the Receiver of its
// retirement mark, a channel it keeps the only Sender of and never sends on.
// v2.19: a session's fence root holds a handle the publisher publishes on (§3 "The release
// check"), and the publisher answers with the session's id and a handle to the round register.
// v2.20: `progress` is the owner's drain token (§3 "Repair"), a capacity-1 channel the owner
// sends on before each `Drained`; with none, a due session repairs on every pass.
// v2.22: `taken` is the session's taken register (§3 "Repair"): the count of `complete`s the
// owner has taken and no longer holds unsent. `first` is the Subscribe that made the owner
// join, registered as the publisher takes the Join, so a join needs one PubIn message.
type Join: send { to: Sender[WireEvent], told: Sender[Admit], mark: Option[Receiver[()]], closed: Option[Receiver[()]], identity: Option[Latest[OwnerNumber]], fence: Option[Latest[Fence]], progress: Option[Receiver[()]], taken: Option[Latest[Taken]], first: Option[JoinSubscribe] }

// v2.22: the owner's first Subscribe, with its instance, carried in its Join.
type JoinSubscribe: send { sub: u32, generation: u64, input: SubscriptionInput }

// v2.22: how many `complete`s the owner has taken from its inbox, published only while it
// holds none of them unsent (§3 "Repair").
type Taken: shareable + send { n: u64 }

type Admit: send { who: u64, round: Latest[RoundAt] }

// v2.19 (§3 "The release check"): `latest` is the newest commit that hit a read set of the
// session, and `prior` the value `latest` had before it.
pub type Fence: shareable + send { prior: u64, latest: u64 }

// The round register's value R: the newest version whose fences are all published.
// u64::MAX is the deploy halt's, and drops every content unit.
type RoundAt: shareable + send { at: u64 }

const ROUND_HALTED: u64 = 18446744073709551615u64

// The publisher's `PubIn` capacity in an operated place (§3 queue table: 64 in the reference
// server). A full `PubIn` ends an owner's Join or Subscribe with Refused(Overloaded).
const PUBLISHER_INBOX: u64 = 64u64

// The publisher's inbox, both ends, and the place's round register with its reserved Arcs.
// `post` gives each session a sender; place_head then takes the mailbox whole, its head
// sending Releases on the same channel.
pub opaque type Mailbox: send { to: Sender[PubIn], from: Receiver[PubIn], rounds: RoundRegister }

// The round register and every Arc a round publishes from (§3 "Admission"): the current
// value (the publisher's own share), the spares, which no reader reaches through the root,
// and u64::MAX. `mailbox` reserves one spare and each fenced `Joined` one more, so with at
// most one share per writer some spare is always unshared. The register fails closed: a
// publisher that ends by anything but `Halt` (a trap included) publishes R = u64::MAX as it
// is cleaned, before its inbox closes, so no commit after the trap is released unfenced.
resource type RoundRegister: send { round: Latest[RoundAt], halted: Arc[RoundAt], current: Arc[RoundAt], spares: List[Arc[RoundAt]] } drop(rounds) {
    latest.publish(rounds.round, arc.share(rounds.halted))
}

// `Halt`: the publisher stops on the head's word, and R stays where it is.
fn round_disarm(take rounds: RoundRegister) {
    let RoundRegister(round: _, halted: _, current: _, spares: _) = take rounds
}

pub fn mailbox(n: u64) -> Result[Mailbox, Capacity] {
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(n)
    let first = arc.new(RoundAt(at: 0u64))
    let register = latest.new(arc.share(first))
    let halted = arc.new(RoundAt(at: ROUND_HALTED))
    let next = arc.new(RoundAt(at: 0u64))
    let mut spares: List[Arc[RoundAt]] = list.new()
    list.push(mut spares, take next)
    let rounds = RoundRegister(round: take register, halted: take halted, current: take first, spares: take spares) ?=> |(c, _)| c
    Ok(Mailbox(to: take to, from: take from, rounds: take rounds))
}

// A session's fence root and the Arcs its fence step publishes from: the current one (the
// publisher's own share) and two spares. Its writer holds at most one share at a time, so
// one spare is always unshared.
type FenceSet: send { root: Latest[Fence], current: Arc[Fence], a: Arc[Fence], b: Arc[Fence] }

// `Joined`'s reservation: the session's two fence spares and one more round spare. A refusal
// admits nothing and the join is answered with id 0.
fn fence_reserve(mut rounds: RoundRegister, take root: Latest[Fence]) -> Result[FenceSet, Capacity] {
    let a = arc.new(Fence(prior: 0u64, latest: 0u64))
    let b = arc.new(Fence(prior: 0u64, latest: 0u64))
    let spare = arc.new(RoundAt(at: 0u64))
    list.push(mut rounds.spares, take spare)
    let current = latest.read(root)
    Ok(FenceSet(root: take root, current: take current, a: take a, b: take b))
}

// Publishes Fence{prior: the current latest, latest: b} from an unshared spare, the old
// current becoming that spare. A fence already at b is left. False only if no spare is
// unshared and no Arc can be made.
fn fence_advance(mut fences: FenceSet, b: u64) -> bool {
    let prior = fences.current.latest
    if prior >= b { return true }
    let in_a = arc.with_unique(mut fences.a, scoped fn(mut f: Fence) { f.prior = prior; f.latest = b })
    let fresh = if let Some(_) = in_a {
        let kept = arc.share(fences.current)
        replace(mut fences.a, take kept)
    } else {
        let in_b = arc.with_unique(mut fences.b, scoped fn(mut f: Fence) { f.prior = prior; f.latest = b })
        if let Some(_) = in_b {
            let kept = arc.share(fences.current)
            replace(mut fences.b, take kept)
        } else {
            arc.new(Fence(prior: prior, latest: b))
        }
    }
    let _ = replace(mut fences.current, take fresh)
    latest.publish(fences.root, arc.share(fences.current))
    true
}

// Publishes R = at from an unshared spare, the old current becoming that spare, and frees
// spares beyond one per joined session plus one, keeping every shared spare and one unshared
// one. False only if no spare is unshared and no Arc can be made.
fn round_advance(mut rounds: RoundRegister, at: u64, live: u64) -> bool {
    let mut chosen: Option[u64] = None
    let mut i = 0u64
    while i < list.len(rounds.spares) {
        let unique = match arc.with_unique(mut rounds.spares[i], scoped fn(mut v: RoundAt) { v.at = at }) { Some(_) => true, None => false }
        if unique {
            if let None = chosen {
                chosen = Some(i)
            } else if list.len(rounds.spares) > live + 1u64 {
                let _ = list.remove(mut rounds.spares, i)
                continue
            }
        }
        i += 1u64
    }
    let index = match chosen {
        Some(x) => x,
        None => {
            let made = arc.new(RoundAt(at: at))
            list.push(mut rounds.spares, take made)
            list.len(rounds.spares) - 1u64
        },
    }
    let kept = arc.share(rounds.current)
    let fresh = list.set(mut rounds.spares, index, take kept)
    let _ = replace(mut rounds.current, take fresh)
    latest.publish(rounds.round, arc.share(rounds.current))
    true
}

// The release check's decision (§3), one function for every transport: R = u64::MAX drops
// every content unit; otherwise the fence acts at `latest` once R has reached it, and at
// `prior` before, and a unit passes if that fence is at most its version.
pub fn release_passes(r: u64, f: Fence, version: u64) -> bool {
    if r == ROUND_HALTED { return false }
    let effective = if f.latest <= r { f.latest } else { f.prior }
    effective <= version
}

// The writer's check: R first, then the fence, each copied and its share released before
// the decision.
fn release_load(register: Latest[RoundAt], fence: Latest[Fence], version: u64) -> bool {
    let r = latest.read(register).at
    let f = {
        let held = latest.read(fence)
        Fence(prior: held.prior, latest: held.latest)
    }
    release_passes(r, f, version)
}

pub fn post(m: Mailbox) -> Sender[PubIn] {
    channel.sender(m.to)
}

// A stream's worker, from its commit until the gate releases its group.
type Worker: send { p: u64, digest: store.RequestDigest, version: u64, outcome: Outcome, waiters: List[Recipient] }

type Waiting: send { req: Request, parked: bool, held_by_pause: bool }

type Head[G: send, H: send] {
    db: store.Db,
    r: Registry[G, H],
    replay_identity: Bytes,
    h: H,
    out: Sender[PubIn],
    busy: Map[Bytes, Worker],
    waiting: List[Waiting],
    group: List[Bytes],
    last: Option[store.Ticket],
    minted: u64,
    // The publisher refused a Release: it has stopped, and R = u64::MAX is published. The
    // head commits nothing more and the place ends with OpenError.PublisherStopped.
    cut: bool,
    trigger_drive: Option[Box[TriggerDrive[G]]]
}

type Publish[G: send, H: send]: send {
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    n_place: u64,
    h: H,
    base: store.Snapshot,
    from: Receiver[PubIn],
    rounds: RoundRegister,
    ready: Sender[Option[RegisterError]]
}

// The publisher task runs `place` itself and tells the head whether it could.
fn publish[G: send, H: send](take p: Publish[G, H]) -> () waits {
    let Publish(place: place, n_place: n_place, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready) = take p
    let r = match placed(place, n_place) {
        Ok(take x) => take x,
        Error(take e) => {
            let _ = channel.send(ready, Some(take e))
            return
        },
    }
    if let Error(_) = channel.send(ready, None) {
        return
    }
    publisher(take r, take h, take base, take from, take rounds)
}

// The head selects the release under the store's LOCK before opening handles.
pub fn place_head[G: send, H: send](take db: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: Receiver[Req], take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    place_head_selected(take db, Current(0u64), place, n_place, migrate, handles, DirectRequests(take inbox), take mail, tasks, n_publisher)
}

pub fn place_head_requests[G: send, H: send](take db: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: HeadRequests, take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    place_head_selected(take db, Current(0u64), place, n_place, migrate, handles, take inbox, take mail, tasks, n_publisher)
}

pub fn place_head_selected[G: send, H: send](take db: store.Db, selection: Selection, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: HeadRequests, take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    let mut owned = take db
    let persistent = store.is_disk(owned)
    let prepared = head_prepare(mut owned, selection, persistent, place, migrate, handles, n_place, tasks)
    let (r, h, h2, _, replay_identity) = match take prepared {
        Ok(take ready) => take ready,
        Error(take problem) => { let _ = close_store(take owned); return Error(take problem) },
    }
    let _ = run_head(take owned, take r, take replay_identity, take h, take h2, place, n_place, take inbox, take mail, tasks, n_publisher, None, None)?
    Ok(())
}

fn run_head[G: send, H: send](take db: store.Db, take r: Registry[G, H], take replay_identity: Bytes, take h: H, take h2: H,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, take inbox: HeadRequests,
    take mail: Mailbox, tasks: Tasks, n_publisher: u64, take drain: Option[HeadDrain], take trigger_drive: Option[Box[TriggerDrive[G]]]) -> Result[Option[u64], OpenError] waits {
    let mut owned = take db
    let publishing = start_publisher(owned, place, n_place, take h2, take mail, tasks, n_publisher)
    let (out, publisher_task) = match take publishing {
        Ok(take started) => take started,
        Error(take problem) => { let _ = close_store(take owned); return Error(take problem) },
    }
    if let Some(control) = drain {
        if let ManagedRequests(from) = inbox {
            if !head_advance(control.events, from, Published(channel.sender(out))) {
                let mut stopping = take publisher_task
                task.cancel(mut stopping)
                let _ = task.join(take stopping)
                close_store(take owned)?
                return Ok(None)
            }
        }
    }
    let mut hd = Head(db: take owned, r: take r, replay_identity: take replay_identity, h: take h, out: take out, busy: map.new(), waiting: list.new(), group: list.new(), last: None, minted: 0u64, cut: false, trigger_drive: take trigger_drive)
    let mut tables: Option[triggers.Tables] = None
    let served = serve_head(mut hd, take inbox, take drain, mut tables)
    finish_head(take hd, take publisher_task, take served, take tables)
}

fn finish_head[G: send, H: send](take head: Head[G, H], take publishing: Task[()], take served: Result[bool, store.Error], take drained_tables: Option[triggers.Tables]) -> Result[Option[u64], OpenError] waits {
    let Head(db: take kept, out: take last_word, cut: cut, trigger_drive: take drive, ..) = take head
    let tables = match take drive {
        Some(take scheduled) => Some(stop_triggers(take scheduled)),
        None => take drained_tables,
    }
    if let Ok(true) = served {} else { let _ = channel.send(last_word, PubIn(e: Halt)) }
    let stopped = match task.join(take publishing) { Ok(()) => cut, Error(_) => true }
    match take served { Ok(_) => (), Error(take problem) => return Error(Store(take problem)) }
    if stopped {
        let _ = close_store(take kept)
        return Error(PublisherStopped)
    }
    let due = match tables {
        Some(trigger_tables) => next_trigger_due(kept, trigger_tables) ?=> Store,
        None => None,
    }
    close_store(take kept)?
    Ok(due)
}

fn next_trigger_due(db: store.Db, tables: triggers.Tables) -> Result[Option[u64], store.Error] {
    let next = triggers.next_pending(store.snapshot(db), tables, fn(id: triggers.Id) -> bool { false })?
    Ok(match next { Some(pending) => Some(triggers.due_time(pending)), None => None })
}

fn close_store(take db: store.Db) -> Result[(), OpenError] waits {
    match store.close(take db) { Ok(()) => Ok(()), Error(take problem) => Error(Store(take problem)) }
}

fn open_handles[H: send](db: store.Db, handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]]) -> Result[H, OpenError] {
    match store.with_schema(db, handles) {
        Ok(take h) => Ok(take h),
        Error(take problem) => Error(Store(take problem)),
    }
}

fn start_publisher[G: send, H: send](owned: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, take h2: H, take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(Sender[PubIn], Task[()]), OpenError] waits {
    let Mailbox(to: take out, from: take from, rounds: take rounds) = take mail
    let (ready, readied): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let p = Publish(place: place, n_place: n_place, h: take h2, base: store.snapshot(owned), from: take from, rounds: take rounds, ready: take ready)
    let publishing = task.spawn(tasks, bytes n_publisher, take p, publish)
    match channel.receive(readied) {
        Ok(None) => (),
        Ok(Some(take e)) => {
            let _ = task.join(take publishing)
            return Error(Place(take e))
        },
        // The task ended without a word: `place` already ran here, so the task's own
        // allowance could not hold it.
        Error(_) => {
            let _ = task.join(take publishing)
            return Error(Place(Full(Capacity(requested: n_publisher, available: 0u64))))
        },
    }
    Ok((take out, take publishing))
}

type DrainWindow: shareable + send { admission: u64, deadline: u64 }

type LifeEvent: send = StopRequested | Recovered | Activated(Bytes, u64, (u64, u64), u64) | Published(Sender[PubIn]) | ServePrepared | Settled | HeadEnded(Result[Option[u64], StartError]) | AdmissionClose | DrainExpired | ServeEnded(Result[u64, StartError])
    | WritesPaused | WritesResumed | RetirePlace
    | IdleSweep | HeadIdle(bool) | ServeIdle(bool) | HeadIdleChecked(Option[Sender[()]]) | ServeIdleChecked(Option[Sender[()]])

fn idle_sweep(tasks: Tasks, clock: Clock, idle: u64, to: Sender[LifeEvent]) -> Task[()] {
    let next = std.clock.deadline_after_ms(host.mono_ns(clock), std.order.max(idle / 2u64, 1u64))
    std.clock.alarm(tasks, clock, next, to, IdleSweep)
}

// The owner parks while operate accepts or declines its idle vote. The sender
// stays with operate until the drain window is published or the vote is refused.
fn idle_vote(to: Sender[LifeEvent], head: bool, idle: bool) -> () waits {
    if idle {
        let (release, parked): (Sender[()], Receiver[()]) = channel.new(1u64)
        let vote = if head { HeadIdleChecked(Some(take release)) } else { ServeIdleChecked(Some(take release)) }
        if let Ok(()) = channel.send(to, take vote) { let _ = channel.receive(parked) }
    } else {
        let _ = channel.send(to, if head { HeadIdleChecked(None) } else { ServeIdleChecked(None) })
    }
}

pub type HeadInput: send = RunRequest(Req) | HeadContinue | HeadClose | HeadFinish | TriggerWake(u64) | TriggerMessage(Box[TriggerInput]) | TriggerDone(triggers.Attempt, Option[Outcome])
    | StartCutover(Box[CutoverWork]) | AbortCutover(Bytes) | PauseDeadline(u64)
    | ExportCommand(Box[ExportCommand]) | ReserveImport(Box[ReserveImport]) | KeepImport(Box[KeepImport]) | CheckHeadIdle

pub type CutoverWork: send { request: store.Cutover, result_to: Sender[Result[(u64, bool), store.DeployError]] }

pub type ExportCommand: send {
    scratch: Dir, attempt: Bytes, retry: bool, answer: Sender[Result[store.ExportCopy, store.DeployError]],
}
pub type ReserveImport: send { checked: store.ValidatedImport, answer: Sender[Result[store.ImportWork, store.DeployError]] }
pub type KeepImport: send { built: store.Imported, answer: Sender[Result[Inline[u8, 32], store.DeployError]] }

pub type HostCommand: codec + send = HostExport(Bytes, bool) | HostImport(Bytes, Bytes, Bytes)
    | HostCutover(Bytes, Bytes, u64, bool) | HostAbort(Bytes)
pub type PlaceReady: codec + send { version: u64, store_hi: u64, store_lo: u64, release: Bytes, retain_from: u64, ready_ns: u64 }
pub type HostReply: codec + send = PlaceOpened(PlaceReady) | PlaceCurrent(u64, Bytes) | PlaceRefused(String)
    | PlaceExported(u64, String) | PlaceImported(Bytes) | PlaceInstalled(u64, bool) | PlaceDrift | PlaceAborted | PlaceUncertain | PlaceWriteAck(u64)

type HostControl {
    answer: Sender[HostReply], sent: Receiver[()], reading: Task[()], writing: Task[()],
    ack: Sender[u64], acknowledging: Task[()],
}
type HostReader: send {
    input: ReadHalf, to_head: Sender[HeadInput], answer: Sender[HostReply], scratch: Dir, clock: Clock, maximum: u64,
}
type HostWriter: send { output: WriteHalf, responses: Receiver[HostReply], sent: Sender[()] }

fn start_host_control(tasks: Tasks, clock: Clock, n_place: u64, to_head: Sender[HeadInput]) -> Result[Option[HostControl], StartError] {
    let Some(take control) = launch_socket() else { return Ok(None) }
    let Some(scratch) = launch_scratch() else { return Error(Missing("scratch")) }
    let (take input, take output) = net.split(take control)
    let (answer, responses): (Sender[HostReply], Receiver[HostReply]) = channel.new(2u64)
    let (notice, sent): (Sender[()], Receiver[()]) = channel.new(1u64)
    let writer = task.spawn(tasks, bytes 16384u64, HostWriter(output: take output, responses: take responses, sent: take notice), host_writer)
    let reader = task.spawn(tasks, bytes n_place, HostReader(input: take input, to_head: channel.sender(to_head), answer: channel.sender(answer), scratch: scratch, clock: clock, maximum: n_place), host_reader)
    let (ack, take first_write): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    let request = (take first_write, channel.sender(answer))
    let acknowledging = task.spawn(tasks, bytes 4096u64, take request, forward_first_write)
    Ok(Some(HostControl(answer: take answer, sent: take sent, reading: take reader, writing: take writer, ack: take ack, acknowledging: take acknowledging)))
}

fn forward_first_write(take notice: (Receiver[u64], Sender[HostReply])) -> () waits {
    let (take from, take answer) = take notice
    let first = channel.receive(from)
    let _ = take from
    if let Ok(at) = first { let _ = channel.send(answer, PlaceWriteAck(at)) }
}

fn read_control(mut input: ReadHalf, maximum: u64) -> Option[HostCommand] waits {
    let mut header: Bytes = list.with_capacity(4u64)
    if !read_control_bytes(mut input, mut header, 4u64) { return None }
    let mut at = 0u64
    let size: u64 = match std.codec.take_u32(header, mut at) { Ok(n) => int.widen(n), _ => return None }
    if size > maximum { return None }
    let mut body: Bytes = list.with_capacity(size)
    if !read_control_bytes(mut input, mut body, size) { return None }
    let codec: std.codec.Codec[HostCommand] = std.codec.of()
    match std.codec.decode(codec, body) { Ok(take command) => Some(take command), _ => None }
}

fn read_control_bytes(mut input: ReadHalf, mut out: Bytes, size: u64) -> bool waits {
    while list.len(out) < size {
        let left = size - list.len(out)
        match host.recv_bounded(mut input, mut out, left, Never) {
            Ok(n) if n > 0u64 => (),
            _ => return false,
        }
    }
    true
}

fn send_control(mut output: WriteHalf, host_result: HostReply) -> bool waits {
    let codec: std.codec.Codec[HostReply] = std.codec.of()
    let mut body: Bytes = list.new()
    if let Error(_) = std.codec.encode(codec, host_result, mut body) { return false }
    let mut header: Bytes = list.new()
    if list.len(body) > 4294967295u64 { return false }
    std.codec.put_u32(int.narrow(list.len(body)), mut header)
    let mut offset = 0u64
    while offset < 4u64 + list.len(body) {
        match host.send_pair(mut output, list.slice(header, std.order.min(offset, 4u64), 4u64), list.slice(body, int.saturating_sub(offset, 4u64), list.len(body)), Never) {
            Ok(n) if n > 0u64 => { offset += n },
            _ => return false,
        }
    }
    true
}

fn host_writer(take writer: HostWriter) -> () waits {
    let HostWriter(output: take output, responses: take responses, sent: take sent) = take writer
    let mut socket = take output
    while let Ok(take host_result) = channel.receive(responses) {
        if !send_control(mut socket, host_result) { return }
        let _ = channel.try_send(sent, ())
    }
}

fn host_head[T: send](head: Sender[HeadInput], request: scoped fn(take Sender[T]) -> Result[HeadInput, Capacity]) -> Option[T] waits {
    let (host_result, response): (Sender[T], Receiver[T]) = channel.new(1u64)
    let message = match request(take host_result) { Ok(take command) => take command, Error(_) => return None }
    if let Error(_) = channel.send(head, take message) { return None }
    match channel.receive(response) { Ok(take value) => Some(take value), Error(_) => None }
}

fn host_refusal(why: store.DeployError) -> String {
    match why {
        Store(Full(_)) => "Full",
        Store(Missing(_)) => "Missing",
        Store(Exists(_)) => "Exists",
        Store(_) => "Store",
        Scratch(_) => "Scratch",
        ExportMismatch => "ExportMismatch",
        AttemptBusy => "Busy",
        ImportMalformed => "ImportMalformed",
        IdBound => "IdBound",
        Drift => "Drift",
        Expired => "Expired",
        FullNew(_) => "Full(New)",
    }
}

fn host_export(head: Sender[HeadInput], scratch: Dir, attempt: Bytes, retry: bool) -> Result[store.Exported, store.DeployError] waits {
    let response = host_head(head, scoped fn(take answer: Sender[Result[store.ExportCopy, store.DeployError]]) -> Result[HeadInput, Capacity] {
        let payload = ExportCommand(scratch: scratch, attempt: clone(attempt), retry: retry, answer: take answer)
        let command = box.new(take payload)
        Ok(ExportCommand(take command))
    })
    let Some(take started) = take response else { return Error(AttemptBusy) }
    store.export_copy(started?)
}

fn host_import(head: Sender[HeadInput], exported: store.Exported, description: Bytes, release: Bytes, digest: Bytes) -> Result[Inline[u8, 32], store.DeployError] waits {
    let checked = store.validate_prepared(exported.dir)?
    if !store.prepared_matches(checked, description, release, digest) { return Error(ImportMalformed) }
    let mut awaiting = Some(take checked)
    let reserved = host_head(head, scoped fn(take answer: Sender[Result[store.ImportWork, store.DeployError]]) -> Result[HeadInput, Capacity] {
        let payload = ReserveImport(checked: option.unwrap(replace(mut awaiting, None)), answer: take answer)
        let command = box.new(take payload)
        Ok(ReserveImport(take command))
    })
    let Some(take reserved_work) = take reserved else { return Error(AttemptBusy) }
    let mut built = Some(store.import_trees(reserved_work?)?)
    let kept = host_head(head, scoped fn(take answer: Sender[Result[Inline[u8, 32], store.DeployError]]) -> Result[HeadInput, Capacity] {
        let payload = KeepImport(built: option.unwrap(replace(mut built, None)), answer: take answer)
        let command = box.new(take payload)
        Ok(KeepImport(take command))
    })
    match take kept { Some(take answer) => take answer, None => Error(AttemptBusy) }
}

fn host_cutover(head: Sender[HeadInput], attempt: Bytes, digest: Bytes, deadline: u64) -> HostReply waits {
    if list.len(attempt) != 16u64 || list.len(digest) != 32u64 { return PlaceRefused("ExportMismatch") }
    let mut hash: Inline[u8, 32] = [0u8; 32]
    for i in 0u64 .. 32u64 { hash[i] = digest[i] }
    let response = host_head(head, scoped fn(take host_result: Sender[Result[(u64, bool), store.DeployError]]) -> Result[HeadInput, Capacity] {
        let request = store.Cutover(attempt: clone(attempt), digest: hash, deadline: deadline)
        let command = box.new(CutoverWork(request: take request, result_to: take host_result))
        Ok(StartCutover(take command))
    })
    match take response {
        Some(Ok((version, waiting))) => PlaceInstalled(version, waiting),
        Some(Error(Drift)) => PlaceDrift,
        Some(Error(Store(Poisoned(_)))) => PlaceUncertain,
        Some(Error(why)) => PlaceRefused(host_refusal(why)),
        None => PlaceUncertain,
    }
}

fn host_reader(take reader: HostReader) -> () waits {
    let HostReader(input: take socket, to_head: take head, answer: take answer, scratch: scratch, clock: clock, maximum: maximum) = take reader
    let mut input = take socket
    let mut exported: Option[store.Exported] = None
    while let Some(take request) = read_control(mut input, maximum) {
        let host_result: HostReply = match take request {
            HostExport(attempt, retry) => match host_export(head, scratch, attempt, retry) {
                Ok(take found) => {
                    let version = found.stamp.head
                    let name: String = clone(found.name)
                    exported = Some(take found)
                    PlaceExported(version, take name)
                },
                Error(why) => PlaceRefused(host_refusal(why)),
            },
            HostImport(description, release, digest) => match exported {
                Some(info) => match host_import(head, info, description, release, digest) {
                    Ok(hash) => {
                        let mut wire_hash: Bytes = list.with_capacity(32u64)
                        for byte in hash { list.push(mut wire_hash, byte) }
                        PlaceImported(take wire_hash)
                    },
                    Error(why) => PlaceRefused(host_refusal(why)),
                },
                None => PlaceRefused("ExportMismatch"),
            },
            HostCutover(attempt, digest, max_pause_ms, retry) => {
                let deadline = if retry { 0u64 } else { std.clock.deadline_after_ms(host.mono_ns(clock), max_pause_ms) }
                let _ = replace(mut exported, None)
                host_cutover(head, attempt, digest, deadline)
            },
            HostAbort(take attempt) => {
                let _ = replace(mut exported, None)
                let _ = channel.send(head, AbortCutover(take attempt))
                PlaceAborted
            },
        }
        if let Error(_) = channel.send(answer, take host_result) { return }
    }
}

type WritePause {
    deadline: u64,
    attempt: Bytes,
    deadline_task: Task[()],
    work: Option[CutoverWork],
}

pub type HeadRequests = DirectRequests(Receiver[Req]) | ManagedRequests(Receiver[HeadInput])
type HeadDrain {
    finish: Receiver[()], events: Sender[LifeEvent], window: Latest[Option[DrainWindow]],
    clock: Clock, tasks: Tasks, head_to: Sender[HeadInput], n_place: u64, cut: CutActivity, idle: Option[u64],
}

type ManagedHead[G: send, H: send, S: send]: send {
    backing: Backing, selection: Selection, tasks: Tasks, clock: Clock, random: Random,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    n_place: u64, n_publisher: u64, inbox: Receiver[HeadInput], finish_from: Receiver[()],
    to: Sender[LifeEvent], drain: Latest[Option[DrainWindow]],
    head_to: Sender[HeadInput], cut: CutActivity,
    triggering: Option[TriggerConfig[G, S]], idle: Option[u64],
}

fn head_advance(to: Sender[LifeEvent], inbox: Receiver[HeadInput], take progress: LifeEvent) -> bool waits {
    if let Error(_) = channel.send(to, take progress) { return false }
    match channel.receive(inbox) { Ok(HeadContinue) => true, _ => false }
}

fn head_ended[G: send, H: send, S: send](take job: ManagedHead[G, H, S]) -> () waits {
    let to = channel.sender(job.to)
    let ended = managed_head(take job)
    let _ = channel.send(to, HeadEnded(take ended))
}

fn managed_head[G: send, H: send, S: send](take job: ManagedHead[G, H, S]) -> Result[Option[u64], StartError] waits {
    let ManagedHead(backing: take backing, selection: selection, tasks: tasks, clock: clock, random: random, place: place, migrate: migrate, handles: handles,
        n_place: n_place, n_publisher: n_publisher, inbox: take inbox, finish_from: take finish_from, to: take to, drain: take drain,
        head_to: take head_to, cut: take cut, triggering: take triggering, idle: idle) = take job
    let persistent = match backing { Disk(_, _) => true, _ => false }
    let mut temporary: Option[TemporaryBacking] = None
    let opened: Result[store.Db, store.Error] = match backing {
        Memory => Ok(store.memory(clock, random, store.defaults())),
        Disk(dir, options) => store.open(tasks, dir, clock, random, options),
        Temp(parent) => {
            let name = string.with_capacity(32u64)
            let mut cleanup = match TemporaryBacking(dir: parent, name: take name) { Ok(take guard) => take guard, Error((cap, _)) => return Error(Full(cap)) }
            let dir = match std.dir.create_temp(parent, mut cleanup.name) { Ok(dir) => dir, Error(problem) => return Error(Open(Store(Io(problem)))) }
            temporary = Some(take cleanup)
            store.open(tasks, dir, clock, random, store.defaults())
        },
    }
    let mut db = match take opened { Ok(take db) => take db, Error(take problem) => return Error(Open(Store(take problem))) }
    if !head_advance(to, inbox, Recovered) { return head_closed(take db) }
    let prepared = head_prepare(mut db, selection, persistent, place, migrate, handles, n_place, tasks)
    let (reg, local, publisher_handles, release, replay_identity) = match take prepared {
        Ok(take values) => take values,
        Error(take problem) => { let _ = close_store(take db); return Error(Open(take problem)) },
    }
    // A place directory reopens a disk store at this version (RUNNER-SPEC §13.3).
    let (version, retain_from) = if persistent {
        match activation_window(db) { Ok(found) => found, Error(take problem) => { let _ = close_store(take db); return Error(Open(Store(take problem))) } }
    } else { (0u64, 0u64) }
    if !head_advance(to, inbox, Activated(clone(release), version, store.identity_words(db), retain_from)) { return head_closed(take db) }
    let trigger_drive = match open_trigger_drive(db, clock, tasks, channel.sender(head_to), release, take triggering) {
        Ok(take drive) => take drive,
        Error(take problem) => { let _ = close_store(take db); return Error(Open(Store(take problem))) },
    }
    let mail = match mailbox(PUBLISHER_INBOX) {
        Ok(take mail) => take mail,
        Error(cap) => { let _ = close_store(take db); return Error(Full(cap)) },
    }
    let closing = HeadDrain(finish: take finish_from, events: take to, window: take drain, clock: clock, tasks: tasks, head_to: take head_to, n_place: n_place, cut: take cut, idle: idle)
    let ended = run_head(take db, take reg, take replay_identity, take local, take publisher_handles, place, n_place, ManagedRequests(take inbox), take mail, tasks, n_publisher, Some(take closing), take trigger_drive)
    let _ = take temporary
    match take ended {
        Ok(due) => Ok(due),
        Error(Store(Full(cap))) => Error(Full(store_capacity(cap))),
        Error(take problem) => Error(Open(take problem)),
    }
}

fn head_closed(take db: store.Db) -> Result[Option[u64], StartError] waits {
    close_store(take db) ?=> Open
    Ok(None)
}

fn head_prepare[G: send, H: send](mut db: store.Db, selection: Selection, persistent: bool,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], n_place: u64, tasks: Tasks) -> Result[(Registry[G, H], H, H, Bytes, Bytes), OpenError] waits {
    if !store.is_disk(db) {
        let mut local_registry = match placed(place, n_place) { Ok(take registered) => take registered, Error(take problem) => return Error(Place(take problem)) }
        let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
        if let Error(take problem) = store.run_migration(mut db, tasks, migrate) { return Error(Migrate(take problem)) }
        let h = open_handles(db, handles)?
        let h2 = open_handles(db, handles)?
        let release = release_digest(local_registry.exported) ?=> |_| Place(Bounds)
        return Ok((take local_registry, take h, take h2, take release, take identity))
    }
    let current = activation_result(current_description(db))?
    let selected: Option[u64] = match selection {
        Install => None,
        Current(expected) => match current {
            None => {
                if expected != 0u64 { return Error(NotCurrent(Empty)) }
                None
            },
            Some(_) => {
                if store.fence_level(db) == 0 && persistent { return Error(NotCurrent(Legacy)) }
                let version = activation_result(activation_version(db))?
                if version != expected { return Error(NotCurrent(Active(version, option.unwrap(take current)))) }
                Some(version)
            },
        },
    }
    if persistent && selected == None && launch_word(1u64, 0u64) == 0u64 { return Error(IdentityUnknown) }
    let mut reg = match placed(place, n_place) { Ok(take reg) => take reg, Error(take problem) => return Error(Place(take problem)) }
    let (description, record) = prepare_activation(reg, n_place) ?=> Place
    if let Some(version) = selected {
        let old = option.unwrap(take current)
        if old != description { return Error(NotCurrent(Active(version, take old))) }
        let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
        let h = open_handles(db, handles)?
        let h2 = open_handles(db, handles)?
        let ReleaseRecord(release: take release, ..) = take record
        return Ok((take reg, take h, take h2, take release, take identity))
    }
    let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
    let mut stage = match store.stage_migration(db, tasks, migrate) {
        Ok(take staged) => take staged,
        Error(take problem) => return Error(Migrate(take problem)),
    }
    let version = store.version(store.snapshot(db)) + 1u64
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    activation_result(store.stage_activation(mut stage, version, current, description, release_codec, record))?
    let h = activation_result(store.with_staged_schema(stage, handles))?
    let h2 = activation_result(store.with_staged_schema(stage, handles))?
    if let Error(take problem) = store.install_activation(mut db, take stage) { return Error(Store(take problem)) }
    let ReleaseRecord(release: take release, ..) = take record
    Ok((take reg, take h, take h2, take release, take identity))
}

fn activation_result[T](take answer: Result[T, store.Error]) -> Result[T, OpenError] {
    match take answer {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Store(take problem)),
    }
}

fn activation_identity(place_id: Bytes, migrate_id: Bytes, handles_id: Bytes) -> Result[Bytes, OpenError] {
    match replay_identity_of(place_id, migrate_id, handles_id) {
        Ok(take digest) => Ok(take digest),
        Error(problem) => Error(Store(Full(Allocation(problem)))),
    }
}

fn replay_identity_of(place_id: Bytes, migrate_id: Bytes, handles_id: Bytes) -> Result[Bytes, Capacity] {
    let launch = launch_digest()?
    if list.len(launch) == 0 { return Ok(list.new()) }
    let mut raw = take launch
    be_word(mut raw, list.len(place_id), 4)?
    list.append(mut raw, place_id)
    be_word(mut raw, list.len(migrate_id), 4)?
    list.append(mut raw, migrate_id)
    be_word(mut raw, list.len(handles_id), 4)?
    list.append(mut raw, handles_id)
    let mut hash = std.sha256.start()
    std.sha256.add(mut hash, raw, 0, list.len(raw))
    let digest = std.sha256.finish(hash)
    let mut identity: Bytes = list.with_capacity(32)
    for byte in digest { list.push(mut identity, byte) }
    Ok(take identity)
}

pub type PrepareError: send = Open(OpenError) | Deploy(store.DeployError) | Identity

pub type PrepareConfig[G: send, H: send] {
    scratch: Dir,
    options: store.Options,
    attempt: Bytes,
    image_digest: Bytes,
    clock: Clock,
    tasks: Tasks,
    n_place: u64,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits],
    handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    triggers: triggers.Entries
}

pub type TriggerScanClass: codec + key + send = Cancelling | Held | Gone | Changed | Unchanged

// TRIGGERS contains one value-codec List[TriggerScanRow].
pub type TriggerScanRow: codec + send {
    class: TriggerScanClass,
    kind: Kind,
    path: Bytes,
    schema: Bytes,
    count: u64,
    earliest_due: u64
}

pub type PrepareArgs { attempt: Bytes, digest: Bytes }

pub fn launch_prepare_args(a: Args) -> Result[Option[PrepareArgs], Exit] {
    let Some(mode) = args.get(a, 0u64) else { return Ok(None) }
    if mode != "--hirsel-prepare" { return Ok(None) }
    let invalid = Exit(status: 1u8)
    if args.len(a) != 4u64 { return Error(invalid) }
    let Some(attempt_text) = args.get(a, 2u64) else { return Error(invalid) }
    let Some(image_text) = args.get(a, 3u64) else { return Error(invalid) }
    let attempt = std.base64.decode(string.as_bytes(attempt_text))
    let digest = std.base64.decode(string.as_bytes(image_text))
    match (take attempt, take digest) {
        (Some(take ticket), Some(take image)) => {
            if list.len(ticket) != 16 || list.len(image) != 32 { return Error(invalid) }
            Ok(Some(PrepareArgs(attempt: take ticket, digest: take image)))
        },
        _ => Error(invalid),
    }
}

fn prepare_result[T](take outcome: Result[T, store.DeployError]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Deploy(take reason)),
    }
}

fn prepare_open_result[T](take outcome: Result[T, store.Error]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Open(Store(take reason))),
    }
}

// The process receives its export directory as a scratch capability. It
// creates no listener or live-store lock.
pub fn prepare_deploy[G: send, H: send](p: PrepareConfig[G, H]) -> Result[(), PrepareError] waits {
    let source = prepare_result(store.open_export(p.scratch, p.clock, p.attempt, p.options))?
    let digest = match launch_digest() {
        Ok(take hash) => take hash,
        Error(c) => return Error(Open(Store(Full(Allocation(c))))),
    }
    if list.len(digest) != 32 || digest != p.image_digest { return Error(Identity) }
    prepare_export(p, source, digest)
}

fn prepare_export[G: send, H: send](p: PrepareConfig[G, H], source: store.Preparation, digest: Bytes) -> Result[(), PrepareError] waits {
    let registered = match placed(p.place, p.n_place) {
        Ok(take reg) => take reg,
        Error(take error) => return Error(Open(Place(take error))),
    }
    if let Error(take problem) = activation_identity(code.identity(p.place), code.identity(p.migrate), code.identity(p.handles)) {
        return Error(Open(take problem))
    }
    let staged = match store.stage_export_migration(source, p.tasks, p.migrate) {
        Ok(take staged) => take staged,
        Error(take error) => return Error(Open(Migrate(take error))),
    }
    let _ = prepare_open_result(store.with_staged_schema(staged, p.handles))?
    let _ = prepare_open_result(store.with_staged_schema(staged, p.handles))?
    if let Error(take problem) = store.validate_preparation(source, staged) { return Error(Open(Store(take problem))) }
    let (take description, take record) = prepare_activation(registered, p.n_place) ?=> |problem| Open(Place(problem))
    let ReleaseRecord(release: take release, digest: take image) = take record
    let target = store.PreparedTarget(describe: take description, release: take release, digest: take image,
        resident_limit: p.options.resident_limit, pack_bytes: p.options.pack_bytes,
        checkpoint_bytes: p.options.checkpoint_bytes, journal_limit: p.options.journal_limit)
    let scan = prepare_trigger_scan(source, staged, registered, p.triggers, digest)?
    write_trigger_scan(p.scratch, scan)?
    prepare_result(store.write_prepared(source, staged, p.scratch, take target))
}

fn trigger_scan_limit() -> PrepareError { Deploy(Scratch(Limit(Triggers))) }

fn prepare_trigger_scan[G: send, H: send](source: store.Preparation, staged: store.StagedMigration, reg: Registry[G, H], choices: triggers.Entries, digest: Bytes) -> Result[Bytes, PrepareError] {
    let scanned = isolate(scoped fn() -> Result[Bytes, PrepareError] {
        let table = prepare_open_result(store.with_staged_schema(staged, code.describe(triggers.pending_table_if_present)))?
        let snapshot = store.staged_snapshot(source, staged)
        let rows = match prepare_open_result(triggers.scan_pending(snapshot, table))? {
            Some(take cursor) => collect_trigger_scan(take cursor, source, reg, choices, digest)?,
            None => list.new(),
        }
        let codec: std.codec.Codec[List[TriggerScanRow]] = std.codec.of_list()
        let mut raw: Bytes = list.new()
        std.codec.encode(codec, rows, mut raw) ?=> |_| trigger_scan_limit()
        Ok(take raw)
    })
    match take scanned {
        Ok(Ok(Error(Open(Store(Full(Allocation(_))))))) => Error(trigger_scan_limit()),
        Ok(Ok(take report)) => take report,
        Error(_) => Error(trigger_scan_limit()),
        Ok(Error(causes)) => {
            for cause in causes {
                if let Capacity(_) = cause.kind { return Error(trigger_scan_limit()) }
                break
            }
            fail("runner: trigger scan failed")
        },
    }
}

fn collect_trigger_scan[G: send, H: send](take cursor: triggers.PendingRows, source: store.Preparation, reg: Registry[G, H], choices: triggers.Entries, digest: Bytes) -> Result[List[TriggerScanRow], PrepareError] {
    let mut remaining = take cursor
    let raw = match store.export_system_get(source, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes(), 0u8) {
        Ok(take row) => take row,
        Error(Missing(_)) => None,
        Error(take problem) => return Error(Open(Store(take problem))),
    }
    let old = if let Some(take prior_description) = take raw {
        let codec: std.codec.Codec[Describe] = std.codec.of()
        let Describe(exported: take prior_entries, ..) = std.codec.decode(codec, prior_description) ?=> |problem| Open(Store(Decode(problem)))
        take prior_entries
    } else { list.new() }
    let mut grouped: Map[(TriggerScanClass, Kind, Bytes, Bytes), (u64, u64)] = map.new()
    while let Some(take pending) = prepare_open_result(triggers.next_scanned(mut remaining))? {
        let class = prepare_open_result(trigger_scan_class(reg, choices, old, pending, digest))?
        let due = triggers.due_time(pending)
        let path: Bytes = clone(triggers.entry_path(pending))
        let schema: Bytes = clone(triggers.argument_schema(pending))
        let kind: Kind = if triggers.is_granted(pending) { Granted } else { Transact }
        let key = (class, kind, take path, take schema)
        map.update_or_insert(mut grouped, take key, (0u64, due), scoped fn(mut totals: (u64, u64)) {
            totals = (totals.0 + 1u64, std.order.min(totals.1, due))
        })
    }
    let mut rows: List[TriggerScanRow] = list.with_capacity(map.len(grouped))
    for take ((class, kind, take path, take schema), (count, earliest)) in take grouped {
        list.push(mut rows, TriggerScanRow(class: class, kind: kind,
            path: take path, schema: take schema, count: count, earliest_due: earliest))
    }
    Ok(take rows)
}

fn trigger_scan_class[G: send, H: send](reg: Registry[G, H], choices: triggers.Entries, old: List[Exported], pending: triggers.Pending, digest: Bytes) -> Result[TriggerScanClass, store.Error] {
    if triggers.cancelling(pending) { return Ok(Cancelling) }
    if triggers.held_on_start(pending, digest) { return Ok(Held) }
    let Some((_, index)) = trigger_key(reg, pending, choices)? else { return Ok(Gone) }
    for entry in old {
        if trigger_matches(pending, entry.described) {
            return Ok(if entry.revision != reg.exported[index].revision { Changed } else { Unchanged })
        }
    }
    Ok(Unchanged)
}

fn write_trigger_scan(d: Dir, raw: Bytes) -> Result[(), PrepareError] waits {
    let mut file = host.open(d, "TRIGGERS", Write) ?=> |e| Deploy(Scratch(Io(e)))
    host.write(mut file, raw) ?=> |e| Deploy(Scratch(Io(e.error)))
    host.sync(mut file) ?=> |e| Deploy(Scratch(Io(e)))
    host.close(take file) ?=> |e| Deploy(Scratch(Io(e)))
    Ok(())
}

fn target_release(target: store.PreparedTarget) -> Result[ReleaseRecord, store.DeployError] {
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let decoded = std.codec.decode(codec, target.describe)
    let description = match take decoded {
        Ok(take description) => take description,
        Error(_) => return Error(ImportMalformed),
    }
    if description.digest != target.digest { return Error(ImportMalformed) }
    let release = release_digest(description.exported) ?=> |_| ImportMalformed
    if release != target.release { return Error(ImportMalformed) }
    let digest: Bytes = clone(target.digest)
    Ok(ReleaseRecord(release: take release, digest: take digest))
}

fn cutover_store[G: send, H: send](mut db: store.Db, request: store.Cutover, reg: Registry[G, H], n_place: u64, before_cut: scoped fn() -> bool) -> Result[u64, store.DeployError] waits {
    let description = match prepare_activation(reg, n_place) {
        Ok((take description, _)) => take description,
        Error(Full(c)) => { store.release_export(mut db, request.attempt); return Error(Store(Full(Allocation(c)))) },
        Error(_) => { store.release_export(mut db, request.attempt); return Error(Drift) },
    }
    let selected = current_description(db)
    match take selected {
        Ok(Some(known)) => if known != description { store.release_export(mut db, request.attempt); return Error(Drift) },
        Ok(None) => { store.release_export(mut db, request.attempt); return Error(Drift) },
        Error(take problem) => { store.release_export(mut db, request.attempt); return Error(Store(take problem)) },
    }
    let version = match activation_version(db) {
        Ok(version) => version,
        Error(take problem) => { store.release_export(mut db, request.attempt); return Error(Store(take problem)) },
    }
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    store.perform_cutover(mut db, request, version, description, codec, target_release, before_cut)
}

pub type CutoverOutcome = Installed(u64, Result[(), store.Error]) | Refused(store.DeployError, store.Db)

// The request reaches this point only after the head settles its admitted
// calls. Once installed, the callback retires publication and the sessions;
// the caller cannot regain a writer for the old image.
pub fn cutover[G: send, H: send](take db: store.Db, request: store.Cutover, reg: Registry[G, H], n_place: u64,
    retire: scoped fn(u64) -> () waits) -> CutoverOutcome waits {
    let mut owned = take db
    match cutover_store(mut owned, request, reg, n_place, scoped fn() -> bool { true }) {
        Ok(version) => {
            retire(version)
            Installed(version, store.close(take owned))
        },
        Error(take problem) => Refused(take problem, take owned),
    }
}

fn closing_at(drain: Latest[Option[DrainWindow]], clock: Clock) -> bool {
    match drain_window(latest.read(drain)) { Some(window) => host.mono_ns(clock) >= window.admission, None => false }
}

fn drain_window(window: Option[DrainWindow]) -> Option[DrainWindow] { window }

fn head_next(inbox: HeadRequests, waiting: bool) -> Option[HeadInput] waits {
    match inbox {
        DirectRequests(from) => if waiting {
            match channel.receive(from) { Ok(take req) => Some(RunRequest(take req)), _ => None }
        } else { match channel.try_receive(from) { Ok(take req) => Some(RunRequest(take req)), _ => None } },
        ManagedRequests(from) => if waiting {
            match channel.receive(from) { Ok(take req) => Some(take req), _ => None }
        } else { match channel.try_receive(from) { Ok(take req) => Some(take req), _ => None } },
    }
}

// H3's group ends when the inbox stays empty while every task that was ready
// has had its turn: arrivals that a reader or owner is already carrying join
// this group instead of each paying a durable, a Release and a fan-out round.
// A try_receive that finds Empty is a poll, and the head yields to ready tasks
// only when its polls end a CONC-10 turn (64 polls). The bound is one full
// turn, so every settle crosses a turn boundary before the gate; at 32 half
// the groups gate without yielding, and 1,000 clients at 500 calls/s fall
// behind.
const SETTLE_PROBES: u64 = 64

fn settle_probe(inbox: HeadRequests) -> Option[HeadInput] waits {
    let mut polls = 0u64
    while polls < SETTLE_PROBES {
        if let Some(take more) = head_next(inbox, false) { return Some(take more) }
        polls += 1u64
    }
    None
}

fn close_head_admission[G: send, H: send](mut head: Head[G, H]) -> Result[(), store.Error] waits {
    let waiting = replace(mut head.waiting, list.new())
    for take entry in take waiting {
        let Waiting(req: take req, ..) = take entry
        commitless(mut head, take req, Refused(Overloaded))?
    }
    Ok(())
}

fn start_write_pause(mut pause: Option[WritePause], take work: CutoverWork, control: HeadDrain) -> Result[(), store.DeployError] waits {
    let attempt: Bytes = clone(work.request.attempt)
    if let Some(take previous) = replace(mut pause, None) {
        let mut active = take previous
        if !none(active.work) {
            pause = Some(take active)
            return Error(AttemptBusy)
        }
        if work.request.deadline != 0u64 || active.attempt != attempt {
            pause = Some(take active)
            return Error(ExportMismatch)
        }
        let CutoverWork(request: take request, result_to: take host_result) = take work
        let store.Cutover(attempt: take id, digest: digest, ..) = take request
        active.work = Some(CutoverWork(request: store.Cutover(attempt: take id, digest: digest, deadline: active.deadline), result_to: take host_result))
        pause = Some(take active)
        return Ok(())
    }
    let deadline = work.request.deadline
    if host.mono_ns(control.clock) >= deadline { return Error(Expired) }
    let timer = std.clock.alarm(control.tasks, control.clock, deadline, control.head_to, PauseDeadline(deadline))
    pause = Some(WritePause(deadline: deadline, attempt: take attempt, deadline_task: take timer, work: Some(take work)))
    let _ = channel.send(control.events, WritesPaused)
    Ok(())
}

fn pause_expires(pause: Option[WritePause], now: u64) -> bool {
    match pause { Some(active) => now >= active.deadline, None => false }
}

fn retry_export(mut pause: Option[WritePause], attempt: Bytes) -> Result[(), store.DeployError] {
    let Some(take previous) = replace(mut pause, None) else { return Error(Expired) }
    let mut active = take previous
    let outcome: Result[(), store.DeployError] = if none(active.work) {
        active.attempt = clone(attempt)
        Ok(())
    } else { Error(AttemptBusy) }
    pause = Some(take active)
    outcome
}

fn pause_has_work(pause: Option[WritePause]) -> bool {
    match pause { Some(active) => !none(active.work), None => false }
}

fn end_write_pause(mut db: store.Db, mut pause: Option[WritePause], control: HeadDrain, take why: store.DeployError) -> () waits {
    if let Some(take active) = replace(mut pause, None) {
        let WritePause(attempt: take id, deadline_task: take timer, work: take work, ..) = take active
        let _ = take timer
        store.release_export(mut db, id)
        if let Some(CutoverWork(result_to: host_result, ..)) = take work {
            let _ = channel.try_send(host_result, Error(take why))
        }
        let _ = channel.send(control.events, WritesResumed)
    }
}

fn pause_progress[G: send, H: send](mut head: Head[G, H], mut pause: Option[WritePause], control: HeadDrain, waiting: bool) -> Result[bool, store.Error] waits {
    let deadline = match pause { Some(active) => active.deadline, None => return Ok(false) }
    if !store.cutover_settled(mut head.db)? {
        let now = host.mono_ns(control.clock)
        host.sleep_until(control.clock, std.order.min(deadline, int.saturating_add(now, 1000000u64)))
        return Ok(false)
    }
    if list.len(head.group) != 0u64 { gate(mut head)? }
    let mut active = option.unwrap(replace(mut pause, None))
    let work = replace(mut active.work, None)
    let CutoverWork(request: take request, result_to: take host_result) = option.unwrap(take work)
    let activate_cut = scoped fn() -> bool {
        if !none(drain_window(latest.read(control.window))) { return false }
        latest.publish(control.cut.root, arc.share(control.cut.started))
        true
    }
    let committed = cutover_store(mut head.db, request, head.r, control.n_place, activate_cut)
    match take committed {
        Ok(version) => {
            let _ = replace(mut pause, None)
            let _ = channel.try_send(host_result, Ok((version, waiting)))
            Ok(true)
        },
        Error(Drift) => {
            latest.publish(control.cut.root, arc.share(control.cut.stopped))
            pause = Some(take active)
            let _ = channel.try_send(host_result, Error(Drift))
            Ok(false)
        },
        Error(Store(Poisoned(e))) => {
            let _ = channel.try_send(host_result, Error(Store(Poisoned(e))))
            Error(Poisoned(e))
        },
        Error(take why) => {
            latest.publish(control.cut.root, arc.share(control.cut.stopped))
            pause = Some(take active)
            let _ = channel.try_send(host_result, Error(take why))
            end_write_pause(mut head.db, mut pause, control, AttemptBusy)
            Ok(false)
        },
    }
}

fn head_is_idle[G: send, H: send](head: Head[G, H], idle: u64) -> Result[bool, store.Error] {
    if map.len(head.busy) != 0u64 || list.len(head.waiting) != 0u64 || store.export_leased(head.db) { return Ok(false) }
    if let Some(drive) = head.trigger_drive {
        if map.len(drive.active) != 0u64 { return Ok(false) }
        if let Some(due) = next_trigger_due(head.db, drive.tables)? {
            let at = store.next_call_info(head.db).at
            return Ok(due >= at && due - at >= idle)
        }
    }
    Ok(true)
}

fn serve_head[G: send, H: send](mut head: Head[G, H], take inbox: HeadRequests, take drain: Option[HeadDrain], mut tables: Option[triggers.Tables]) -> Result[bool, store.Error] waits {
    let mut closed = false
    let mut settled = false
    let mut input: Option[HeadInput] = None
    let mut pause: Option[WritePause] = None
    let mut held_write = false
    let mut resuming = false
    let mut idle = false
    loop {
        if head.cut { return Ok(false) }
        if let Some(control) = drain {
            if let Ok(()) = channel.try_receive(control.finish) { return Ok(false) }
            if let Some(_) = drain_window(latest.read(control.window)) {
                end_write_pause(mut head.db, mut pause, control, AttemptBusy)
                // A drain cuts running attempts. Their current rows stay until
                // the next open, which starts a higher attempt.
                if let Some(take scheduled) = replace(mut head.trigger_drive, None) { tables = Some(stop_triggers(take scheduled)) }
            } else if let Some(ms) = control.idle {
                let eligible = none(pause) && head_is_idle(head, ms)?
                if eligible != idle {
                    idle = eligible
                    let _ = channel.send(control.events, HeadIdle(idle))
                }
            }
            if !none(pause) && pause_expires(pause, host.mono_ns(control.clock)) {
                end_write_pause(mut head.db, mut pause, control, Expired)
                refresh_waiting(mut head, true)
                resuming = true
            }
            if !closed && closing_at(control.window, control.clock) {
                closed = true
                close_head_admission(mut head)?
            }
            if closed && !settled && list.len(head.group) == 0u64 {
                let _ = channel.send(control.events, Settled)
                settled = true
            }
        }
        if none(pause) && !closed {
            if resuming {
                if next_waiting(mut head, drain)? { continue }
                resuming = list.len(head.waiting) != 0u64
            }
            if advance_triggers(mut head)? { continue }
        }
        let next = match replace(mut input, None) {
            Some(take next) => Some(take next),
            None => head_next(inbox, false),
        }
        match take next {
            Some(RunRequest(take req)) => {
                head_arrival(mut head, take req, closed, !none(pause) || resuming)?
                if none(pause) { continue }
                held_write = held_write || list.len(head.waiting) != 0u64
            },
            Some(StartCutover(take boxed)) => {
                let starting = none(pause)
                let work = box.unbox(take boxed)
                let host_result = channel.sender(work.result_to)
                if let Some(control) = drain {
                    if closed || !none(drain_window(latest.read(control.window))) {
                        let _ = channel.try_send(host_result, Error(AttemptBusy))
                    } else if let Error(take why) = start_write_pause(mut pause, take work, control) {
                        let _ = channel.try_send(host_result, Error(take why))
                    } else {
                        if starting { held_write = list.len(head.waiting) != 0u64 }
                        for i in 0u64 .. list.len(head.waiting) { head.waiting[i].held_by_pause = true }
                    }
                } else { let _ = channel.try_send(host_result, Error(AttemptBusy)) }
                continue
            },
            Some(AbortCutover(attempt)) => {
                store.release_export(mut head.db, attempt)
                if let Some(control) = drain {
                    let current = match pause { Some(active) => active.attempt == attempt, None => false }
                    if current {
                        end_write_pause(mut head.db, mut pause, control, AttemptBusy)
                        refresh_waiting(mut head, true)
                        resuming = true
                    }
                }
                continue
            },
            Some(ExportCommand(take command)) => {
                let ExportCommand(scratch: scratch, attempt: take attempt, retry: retry, answer: take host_result) = box.unbox(take command)
                let allowed: Result[(), store.DeployError] = if none(drain) || closed { Error(AttemptBusy) }
                    else if retry { retry_export(mut pause, attempt) }
                    else if !none(pause) { Error(AttemptBusy) } else { Ok(()) }
                let exported: Result[store.ExportCopy, store.DeployError] = match take allowed {
                    Ok(()) => match activation_version(head.db) {
                        Ok(version) => store.begin_export_copy(mut head.db, scratch, take attempt, version),
                        Error(take why) => Error(Store(take why)),
                    },
                    Error(take why) => Error(take why),
                }
                let _ = channel.try_send(host_result, take exported)
                continue
            },
            Some(ReserveImport(take command)) => {
                let ReserveImport(checked: take checked, answer: take host_result) = box.unbox(take command)
                let reserved = store.reserve_import(mut head.db, take checked)
                let _ = channel.try_send(host_result, take reserved)
                continue
            },
            Some(KeepImport(take command)) => {
                let KeepImport(built: take built, answer: take host_result) = box.unbox(take command)
                let digest = store.imported_digest(built)
                let kept: Result[Inline[u8, 32], store.DeployError] = match store.keep_import(mut head.db, take built) {
                    Ok(()) => Ok(digest), Error(take why) => Error(take why),
                }
                let _ = channel.try_send(host_result, take kept)
                continue
            },
            Some(HeadClose) => { if !closed { closed = true; close_head_admission(mut head)? }; continue },
            Some(HeadFinish) => return Ok(false),
            Some(CheckHeadIdle) => {
                if let Some(control) = drain {
                    let eligible = match control.idle {
                        Some(ms) => !closed && none(pause) && head_is_idle(head, ms)?,
                        None => false,
                    }
                    idle_vote(control.events, true, eligible)
                }
                continue
            },
            Some(TriggerWake(at)) => { clear_trigger_timer(mut head, at); continue },
            Some(TriggerMessage(take message)) => { trigger_message(mut head, take message, closed)?; continue },
            Some(TriggerDone(a, take outcome)) => { trigger_done(mut head, a, take outcome, closed)?; continue },
            Some(_) => continue,
            None => (),
        }
        if let Some(control) = drain {
            if pause_has_work(pause) {
                if pause_progress(mut head, mut pause, control, held_write)? {
                    let _ = channel.send(head.out, PubIn(e: Halt))
                    let _ = channel.send(control.events, RetirePlace)
                    let _ = channel.receive(control.finish)
                    return Ok(true)
                }
                if none(pause) { refresh_waiting(mut head, true); resuming = true }
                continue
            }
        }
        if none(pause) && !closed && next_waiting(mut head, drain)? { continue }
        if list.len(head.group) > 0u64 {
            if let Some(take more) = settle_probe(inbox) { input = Some(take more); continue }
            gate(mut head)?
            continue
        }
        match head_next(inbox, true) { Some(take message) => { input = Some(take message) }, None => return Ok(false) }
    }
}

fn head_arrival[G: send, H: send](mut hd: Head[G, H], take message: Req, closed: bool, hold: bool) -> Result[(), store.Error] waits {
    let Req(e: take e) = take message
    match take e {
        Requested(take q) => {
            refresh_waiting(mut hd, true)
            if latest.read(q.live).active {
                let mut req = take q
                if latest.read(req.identity).number == 0u64 {
                    hd.minted += 1u64
                    let number = hd.minted
                    let mut id = option.unwrap(replace(mut req.seed, None))
                    let _ = arc.with_unique(mut id, scoped fn(mut value: OwnerNumber) { value.number = number })
                    latest.publish(req.identity, take id)
                    if !latest.read(req.live).active {
                        return Ok(())
                    }
                }
                if hold && !closed {
                    list.push(mut hd.waiting, Waiting(req: take req, parked: false, held_by_pause: true))
                } else { route_admission(mut hd, take req, closed)? }
            }
        },
        OwnerLeft => refresh_waiting(mut hd, false),
    }
    Ok(())
}

// Read the owner's mark before keeping an old request or admitting replacement work.
fn refresh_waiting[G: send, H: send](mut hd: Head[G, H], unpark: bool) {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        if !latest.read(hd.waiting[i].req.live).active {
            let _ = list.remove(mut hd.waiting, i)
        } else {
            if unpark {
                hd.waiting[i].parked = false
            }
            i += 1u64
        }
    }
}

// H1: a request for its stream's worker position joins the waiters if its digest equals the
// worker's, and is otherwise answered Refused(RequestMismatch) as V3 without running (v2.11.3);
// another position waits.
fn route_admission[G: send, H: send](mut hd: Head[G, H], take q: Request, closed: bool) -> Result[(), store.Error] waits {
    let running = match map.get(hd.busy, q.stream) {
        Some(w) => Some((w.p, w.digest == q.digest)),
        None => None,
    }
    match running {
        Some((p, same)) => if p == q.p && !same {
            commitless(mut hd, take q, Refused(RequestMismatch))
        } else if p == q.p {
            let owner = latest.read(q.identity).number
            let Request(stream: take stream, reply_to: take to, ..) = take q
            let mut w = match map.remove(mut hd.busy, stream) {
                Some(take x) => take x,
                None => return Ok(()),
            }
            list.push(mut w.waiters, Recipient(owner: owner, to: take to))
            map.insert(mut hd.busy, take stream, take w)
            Ok(())
        } else if closed {
            commitless(mut hd, take q, Refused(Overloaded))
        } else {
            list.push(mut hd.waiting, Waiting(req: take q, parked: false, held_by_pause: false))
            Ok(())
        },
        None => if closed { commitless(mut hd, take q, Refused(Overloaded)) } else { begin(mut hd, take q) },
    }
}

// The first unparked waiting request whose stream has no worker starts.
fn next_waiting[G: send, H: send](mut hd: Head[G, H], drain: Option[HeadDrain]) -> Result[bool, store.Error] waits {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        if !hd.waiting[i].parked && !map.contains(hd.busy, hd.waiting[i].req.stream) {
            let Waiting(req: take q, held_by_pause: held, ..) = list.remove(mut hd.waiting, i)
            if held {
                if let Some(control) = drain {
                    if host.mono_ns(control.clock) >= q.deadline { continue }
                }
            }
            if latest.read(q.live).active {
                begin(mut hd, take q)?
                return Ok(true)
            }
            continue
        }
        i += 1u64
    }
    Ok(false)
}

// H2 on the store's admit (STORE-SPEC v2.24). Below latest the store cannot say whether p
// ran these bytes (AH2), and at latest another digest is not this request (AH1): both are
// answered commitless (V3), Refused(HistoryUnavailable) or Refused(RequestMismatch), and
// neither marks the stream.
fn begin[G: send, H: send](mut hd: Head[G, H], take q: Request) -> Result[(), store.Error] waits {
    let a = match store.admit(mut hd.db, q.stream, q.p, q.digest) {
        Ok(take x) => take x,
        Error(Full(_)) => return commitless(mut hd, take q, Refused(Overloaded)),
        Error(e) => return Error(e),
    }
    match take a {
        Admitted(take complete) => execute(mut hd, take q, take complete),
        Abandoned(take complete) => execute(mut hd, take q, take complete),
        Duplicate(stored) => duplicate_reply(mut hd, take q, stored),
        Rejected(_) => {
            list.push(mut hd.waiting, Waiting(req: take q, parked: true, held_by_pause: false))
            Ok(())
        },
        HistoryUnavailable => commitless(mut hd, take q, Refused(HistoryUnavailable)),
        RequestMismatch => commitless(mut hd, take q, Refused(RequestMismatch)),
    }
}

fn copy_bytes(b: Bytes) -> Result[Bytes, store.Error] {
    let mut out: Bytes = list.new()
    list.append(mut out, b)
    Ok(take out)
}

fn be_word(mut raw: Bytes, value: u64, width: u64) -> Result[(), Capacity] {
    for i in 0u64 .. width {
        list.push(mut raw, int.truncate(value >> int.truncate(8 * (width - 1 - i))))
    }
    Ok(())
}

// CALL's code (RUNNER-SPEC §7): u64 n ‖ u64 s, big-endian, then the replay identity.
fn code_bytes(n: u64, s: u64, replay_identity: Bytes) -> Result[Bytes, Capacity] {
    let mut raw: Bytes = list.with_capacity(16 + list.len(replay_identity))
    be_word(mut raw, n, 8)?
    be_word(mut raw, s, 8)?
    list.append(mut raw, replay_identity)
    Ok(take raw)
}

fn record_request(q: Request, revision: Option[Bytes], n: u64, s: u64, replay_identity: Bytes) -> Result[store.CallRecord, store.Error] {
    let rev = match revision { Some(bytes_in) => Some(copy_bytes(bytes_in)?), None => None }
    let code = match code_bytes(n, s, replay_identity) {
        Ok(take bytes_in) => take bytes_in,
        Error(problem) => return Error(Full(Allocation(problem))),
    }
    Ok(store.CallRecord(key: copy_bytes(q.key)?, args: copy_bytes(q.arg)?, stream: copy_bytes(q.stream)?, revision: take rev, code: take code))
}

fn encode_entry_reply(mut tx: store.Tx, take result: Ran) -> Result[Bytes, Bytes] {
    let (keep, take outcome): (bool, Outcome) = match take result {
        Commit(take raw) => (true, Returned(take raw)),
        Abort(take raw) => (false, Returned(take raw)),
        Refuse(take reason) => (false, Refused(take reason)),
        Exhausted(problem) => {
            store.body_capacity(mut tx, problem)
            return Error(list.new())
        },
    }
    match encode_runner_reply(outcome) {
        Ok(take wire_bytes) => if keep { Ok(take wire_bytes) } else { Error(take wire_bytes) },
        Error(Full(problem)) => { store.body_capacity(mut tx, store_capacity(problem)); Error(list.new()) },
        Error(_) => fail("runner: reply encoding failed"),
    }
}

fn failed_stop(stop: store.Stop) -> Outcome {
    match stop {
        Raised(reason) => Failed(Raised(reason)),
        OutOfSteps(steps) => Failed(OutOfTime(steps)),
        OutOfBytes(problem) => Failed(OutOfBytes(room(problem))),
    }
}

type Effect = Served(Result[store.Served, store.ServeError]) | Unregistered(store.Pending)

fn run_effect[G: send, H: send](mut db: store.Db, identity: Bytes, locations: Registry[G, H],
        handles: H, q: Request, take complete: store.Completion) -> Result[Effect, store.Error] waits {
    match map.get(locations.slots, q.key) {
        Some(Transact(n, s, revision, _, go)) => {
            let rec = record_request(q, revision, n, s, identity)?
            // The stored Outcome adds a four-byte tag and a four-byte length.
            let plan = store.Plan(n_e: n, s_e: s, reply_max: MAX_RETURNED_BYTES + 8u64)
            Ok(Served(store.serve(mut db, take complete, plan, Some(take rec),
                scoped fn(mut tx: store.Tx) -> Result[Bytes, Bytes] {
                    let outcome = go(mut tx, handles, q.caller, q.arg)
                    encode_entry_reply(mut tx, take outcome)
                })))
        },
        _ => {
            let attempted = store.next_call_info(db)
            Ok(Unregistered(store.untried(take complete, None, attempted)))
        },
    }
}

fn execute[G: send, H: send](mut hd: Head[G, H], take q: Request, take complete: store.Completion) -> Result[(), store.Error] waits {
    let tried = run_effect(mut hd.db, hd.replay_identity, hd.r, hd.h, q, take complete)
    let ran = match take tried {
        Ok(Served(take result)) => take result,
        Ok(Unregistered(take pending_run)) => return reply_only(mut hd, take q, take pending_run, Failed(Gone)),
        Error(Full(_)) => return commitless(mut hd, take q, Refused(Overloaded)),
        Error(take problem) => return Error(take problem),
    }
    match take ran {
        Ok(Committed(take receipt)) => answered(mut hd, take q, take receipt),
        Ok(Kept(take receipt)) => answered(mut hd, take q, take receipt),
        Ok(Failed(take pending_run, stop)) => reply_only(mut hd, take q, take pending_run, failed_stop(stop)),
        Ok(NoRoom(_, _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(Full(_), _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(take problem, _)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
    }
}

fn answered[G: send, H: send](mut hd: Head[G, H], take q: Request, take receipt: store.Receipt) -> Result[(), store.Error] {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let version = store.version(store.snapshot(hd.db))
    match std.codec.decode(co, receipt.reply) {
        Ok(take outcome) => worker(mut hd, take q, take outcome, receipt.ticket, version),
        _ => fail("runner: stored reply did not decode"),
    }
}

fn reply_only[G: send, H: send](mut hd: Head[G, H], take q: Request, take pending_run: store.Pending, take outcome: Outcome) -> Result[(), store.Error] waits {
    let wire_bytes = encode_runner_reply(outcome)?
    let settled = store.conclude(mut hd.db, take pending_run, take wire_bytes, Resident)
    match take settled {
        Ok(Committed(receipt)) => {
            let version = store.version(store.snapshot(hd.db))
            worker(mut hd, take q, take outcome, receipt.ticket, version)
        },
        Ok(NoRoom(_, _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(Full(_), _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(take problem, _)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
        _ => fail("runner: invalid conclude outcome"),
    }
}

fn duplicate_reply[G: send, H: send](mut hd: Head[G, H], take q: Request, stored: store.Stored) -> Result[(), store.Error] waits {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let outcome = match std.codec.decode(co, stored.reply) {
        Ok(take value) => take value,
        _ => fail("runner: a stored reply does not decode"),
    }
    // A duplicate gets its saved reply as it was committed (ruling 73 as amended).
    commitless(mut hd, take q, take outcome)
}

fn worker[G: send, H: send](mut hd: Head[G, H], take q: Request, take o: Outcome, t: store.Ticket, version: u64) -> Result[(), store.Error] {
    let owner = latest.read(q.identity).number
    let Request(stream: take stream, p: p, digest: d, reply_to: take to, ..) = take q
    let mut waiters: List[Recipient] = list.new()
    list.push(mut waiters, Recipient(owner: owner, to: take to))
    let named: Bytes = clone(stream)
    map.insert(mut hd.busy, take named, Worker(p: p, digest: d, version: version, outcome: take o, waiters: take waiters))
    list.push(mut hd.group, take stream)
    hd.last = Some(t)
    Ok(())
}

// V3: a commitless answer goes at once, in a snapshot-less Release behind every earlier
// Release on the one FIFO to the publisher.
fn commitless[G: send, H: send](mut hd: Head[G, H], take q: Request, take o: Outcome) -> Result[(), store.Error] waits {
    let owner = latest.read(q.identity).number
    let Request(stream: take stream, p: p, reply_to: take to, ..) = take q
    let mut answers: List[Answer] = list.new()
    list.push(mut answers, Answer(recipient: Recipient(owner: owner, to: take to), row: KeyedDone(stream: take stream, p: p, outcome: take o)))
    if let Error(_) = channel.send(hd.out, PubIn(e: Released(Release(version: 0u64, snapshot: None, answers: take answers)))) { hd.cut = true }
    Ok(())
}

// H3, V4: one durable and one Release for the group, with every worker's answer
// in commit order. The publisher can now expose the version in one update per owner.
fn gate[G: send, H: send](mut hd: Head[G, H]) -> Result[(), store.Error] waits {
    if let Some(t) = replace(mut hd.last, None) {
        store.durable(mut hd.db, t)?
    }
    let d = store.version(store.snapshot(hd.db))
    let group = replace(mut hd.group, list.new())
    let mut answers: List[Answer] = list.new()
    for stream in group {
        let w = match map.remove(mut hd.busy, stream) {
            Some(take x) => take x,
            None => continue,
        }
        let Worker(p: p, digest: _, version: _, outcome: take o, waiters: take waiters) = take w
        for take recipient in waiters {
            let s: Bytes = clone(stream)
            let each: Outcome = clone(o)
            list.push(mut answers, Answer(recipient: take recipient, row: KeyedDone(stream: take s, p: p, outcome: take each)))
        }
    }
    if let Error(_) = channel.send(hd.out, PubIn(e: Released(Release(version: d, snapshot: Some(store.snapshot(hd.db)), answers: take answers)))) { hd.cut = true }
    refresh_waiting(mut hd, true)
    Ok(())
}

// These messages travel on the existing head inbox, so a run can only write
// through the same writer that starts and finishes attempts.
pub type TriggerCallError: send = Closed | Capacity(Capacity) | Store(store.Error) | StaleAttempt | Cancelled

pub type FencedRefusal: send = Refusal(TriggerCallError) | BodyOutcome(Outcome)

type TriggerAction: send =
    Invoke(triggers.Attempt, Bytes, Bytes, Sender[Result[Outcome, TriggerCallError]])
    | Boundary(triggers.Attempt, Sender[Result[(), TriggerCallError]])
    | MarkHold(triggers.Attempt, u64, Bytes, Bytes, Sender[Result[(), TriggerCallError]])

pub opaque type TriggerInput: send { action: TriggerAction }

pub fn trigger_attempt(ctx: TriggerContext) -> triggers.Attempt { ctx.attempt }

fn trigger_request[P, R: send](ctx: TriggerContext, take payload: P, message: fn(triggers.Attempt, take P, take Sender[Result[R, TriggerCallError]]) -> TriggerAction) -> Result[R, TriggerCallError] waits {
    let (to, from): (Sender[Result[R, TriggerCallError]], Receiver[Result[R, TriggerCallError]]) = channel.new(1u64)
    let request = TriggerInput(action: message(ctx.attempt, take payload, take to))
    let msg = box.new(take request)
    if let Error(_) = channel.send(ctx.to, TriggerMessage(take msg)) { return Error(Closed) }
    match channel.receive(from) { Ok(take answer) => take answer, Error(_) => Error(Closed) }
}

pub fn trigger_call(ctx: TriggerContext, take key: Bytes, take arg: Bytes) -> Result[Outcome, TriggerCallError] waits {
    trigger_request(ctx, (take key, take arg), fn(a: triggers.Attempt, take p: (Bytes, Bytes), take to: Sender[Result[Outcome, TriggerCallError]]) -> TriggerAction {
        let (take wanted, take value) = take p
        Invoke(a, take wanted, take value, take to)
    })
}

pub fn trigger_boundary(ctx: TriggerContext) -> Result[(), TriggerCallError] waits {
    trigger_request(ctx, (), fn(a: triggers.Attempt, take p: (), take to: Sender[Result[(), TriggerCallError]]) -> TriggerAction {
        Boundary(a, take to)
    })
}

pub fn trigger_hold(ctx: TriggerContext, step_index: u64, take expected: Bytes, take actual: Bytes) -> Result[(), TriggerCallError] waits {
    trigger_request(ctx, (step_index, take expected, take actual), fn(a: triggers.Attempt, take p: (u64, Bytes, Bytes), take to: Sender[Result[(), TriggerCallError]]) -> TriggerAction {
        let (position, take wanted, take observed) = take p
        MarkHold(a, position, take wanted, take observed, take to)
    })
}

type GrantRequest[G: send]: send { ctx: TriggerContext, reply: Sender[Result[G, Capacity]] }
type GrantWorker[G: send, S: send]: send {
    grants: S,
    grant: fn(S, take TriggerContext) -> Result[G, Capacity] waits,
    inbox: Receiver[GrantRequest[G]],
}

fn supply_grants[G: send, S: send](take supply: GrantWorker[G, S]) -> () waits {
    // A grant callback may wait. Keep it off the head that serves its context.
    while let Ok(take request) = channel.receive(supply.inbox) {
        let GrantRequest(ctx: take ctx, reply: take reply) = take request
        let given = (supply.grant)(supply.grants, take ctx)
        let _ = channel.send(reply, take given)
    }
}

fn attempt_grants[G: send](to: Sender[GrantRequest[G]], take ctx: TriggerContext) -> Result[G, Outcome] waits {
    let (reply, inbox): (Sender[Result[G, Capacity]], Receiver[Result[G, Capacity]]) = channel.new(1u64)
    if let Error(_) = channel.send(to, GrantRequest(ctx: take ctx, reply: take reply)) {
        return Error(Failed(Gone))
    }
    match channel.receive(inbox) {
        Ok(Ok(take given)) => Ok(take given),
        Ok(Error(cap)) => Error(Failed(OutOfBytes(room(cap)))),
        Error(_) => Error(Failed(Gone)),
    }
}

type ArmedTimer { at: u64, task_handle: Task[()] }

type TriggerGrants[G: send] { to: Sender[GrantRequest[G]], worker: Task[()] }

type TriggerDrive[G: send] {
    tables: triggers.Tables,
    revision: Bytes,
    clock: Clock,
    tasks: Tasks,
    to: Sender[HeadInput],
    entries: triggers.Entries,
    author: Caller,
    grants: Option[TriggerGrants[G]],
    active: Map[triggers.Id, Task[Outcome]],
    timer: Option[ArmedTimer]
}

fn make_trigger_drive[G: send, S: send](db: store.Db, clock: Clock, tasks: Tasks, take to: Sender[HeadInput], revision: Bytes, take config: TriggerConfig[G, S]) -> Result[Box[TriggerDrive[G]], store.Error] {
    let tables = store.with_schema(db, code.describe(triggers.tables))?
    let stamp = trigger_stamp(revision)?
    let TriggerConfig(entries: take entries, author: take author, grants: take seed, grant: grant, grant_bytes: allowance) = take config
    let (grants, inbox): (Sender[GrantRequest[G]], Receiver[GrantRequest[G]]) = channel.new(1u64)
    let supply = GrantWorker(grants: take seed, grant: grant, inbox: take inbox)
    let granting = task.spawn(tasks, bytes allowance, take supply, supply_grants)
    let drive = TriggerDrive(tables: take tables, revision: take stamp, clock: clock, tasks: tasks, to: take to,
        entries: take entries, author: take author, grants: Some(TriggerGrants(to: take grants, worker: take granting)), active: map.new(), timer: None)
    Ok(box.new(take drive))
}

fn trigger_stamp(revision: Bytes) -> Result[Bytes, store.Error] {
    let image = launch_digest() ?=> |cap| Full(Allocation(cap))
    if list.len(image) == 0u64 { copy_bytes(revision) } else { Ok(take image) }
}

fn open_trigger_drive[G: send, S: send](db: store.Db, clock: Clock, tasks: Tasks, take to: Sender[HeadInput], revision: Bytes, take config: Option[TriggerConfig[G, S]]) -> Result[Option[Box[TriggerDrive[G]]], store.Error] {
    if let Some(take configured) = take config {
        if !triggers.is_empty(configured.entries) {
            return Ok(Some(make_trigger_drive(db, clock, tasks, take to, revision, take configured)?))
        }
    }
    let snapshot = store.snapshot(db)
    let Some(take tables) = triggers.tables_for_settlement(store.snapshot_schema(snapshot), snapshot)? else { return Ok(None) }
    let drive: TriggerDrive[G] = TriggerDrive(tables: take tables, revision: trigger_stamp(revision)?, clock: clock, tasks: tasks, to: take to,
        entries: triggers.empty_entries(), author: store.Caller(issuer: 0u8, subject: list.new()), grants: None, active: map.new(), timer: None)
    Ok(Some(box.new(take drive)))
}

fn arm_trigger_timer[G: send](mut drive: Box[TriggerDrive[G]], at: u64) -> Result[(), store.Error] waits {
    let prior = replace(mut drive.timer, None)
    drive.timer = Some(arm_wall_timer(take prior, drive.tasks, drive.clock, drive.to, at))
    Ok(())
}

// One absolute wall-time wait: no wakeup before `at`. The head still samples
// wall time when TriggerWake arrives, before it starts a trigger.
fn arm_wall_timer(take prior: Option[ArmedTimer], tasks: Tasks, c: Clock, to: Sender[HeadInput], at: u64) -> ArmedTimer waits {
    if let Some(take armed) = take prior {
        if armed.at == at { return take armed }
        let ArmedTimer(at: _, task_handle: take running) = take armed
        let _ = task.cancel_join(take running)
    }
    let waiting = std.clock.wall_alarm(tasks, c, at, to, TriggerWake(at))
    ArmedTimer(at: at, task_handle: take waiting)
}

fn trigger_woken(from: Receiver[HeadInput]) -> List[u64] {
    let mut woken: List[u64] = list.new()
    while let Ok(take input) = channel.try_receive(from) {
        if let TriggerWake(at) = take input { list.push(mut woken, at) }
    }
    take woken
}

// The head's trigger timer for an At(T) trigger armed one hour ahead. Monotonic and
// wall time walk forward together, stopping at every deadline the clock reports, and
// the head's re-arm after each early wake is replayed. The arm time plus the hour is
// the oracle: the timer wakes the head never before T and once at T (0 wakeups in the
// hour; the 1000 ms polling cap gave 3,600). A wall clock set back after arming must
// not wake it early either.
pub fn law_trigger_timer_wall_wait(tasks: Tasks) -> bool waits {
    let armed_ms = 1700000000000u64
    let hour_ms = 3600000u64
    let at = armed_ms + hour_ms
    let (c, h) = provide.clock(0u64, armed_ms)
    let mut ticks = take h
    let (to, from): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let mut timer = arm_wall_timer(None, tasks, c, to, at)
    let mut early = 0u64
    while let Some(deadline) = clock.idle(mut ticks) {
        if deadline >= hour_ms * 1000000u64 { break }
        clock.advance_to(mut ticks, deadline)
        clock.set_wall(mut ticks, armed_ms + deadline / 1000000u64)
        let _ = clock.idle(mut ticks)
        for _ in trigger_woken(from) {
            early += 1u64
            timer = arm_wall_timer(None, tasks, c, to, at)
        }
    }
    clock.advance_to(mut ticks, hour_ms * 1000000u64 - 1000000u64)
    clock.set_wall(mut ticks, at - 1u64)
    let _ = clock.idle(mut ticks)
    let before = list.len(trigger_woken(from))
    clock.set_wall(mut ticks, armed_ms)
    let _ = clock.idle(mut ticks)
    let set_back = list.len(trigger_woken(from))
    clock.set_wall(mut ticks, at)
    let _ = clock.idle(mut ticks)
    let woken = trigger_woken(from)
    let once = list.len(woken) == 1u64 && woken[0u64] == at
    early == 0u64 && before == 0u64 && set_back == 0u64 && once
}

fn clear_trigger_timer[G: send, H: send](mut hd: Head[G, H], at: u64) -> () waits {
    let Some(take drive) = replace(mut hd.trigger_drive, None) else { return () }
    let mut owned = take drive
    let clear = match owned.timer { Some(armed) => armed.at == at, None => false }
    if clear {
        if let Some(ArmedTimer(at: _, task_handle: take elapsed)) = replace(mut owned.timer, None) {
            let _ = task.cancel_join(take elapsed)
        }
    }
    hd.trigger_drive = Some(take owned)
}

fn stop_triggers[G: send](take drive: Box[TriggerDrive[G]]) -> triggers.Tables waits {
    let TriggerDrive(tables: take tables, active: take active, timer: take timer, grants: take grants, ..) = box.unbox(take drive)
    if let Some(ArmedTimer(at: _, task_handle: take armed)) = take timer {
        let _ = task.cancel_join(take armed)
    }
    for take (_, take watcher) in take active {
        let _ = task.cancel_join(take watcher)
    }
    if let Some(TriggerGrants(worker: take grant_task, ..)) = take grants { let _ = task.cancel_join(take grant_task) }
    take tables
}

fn trigger_matches(p: triggers.Pending, entry: Described) -> bool {
    let matches_kind = match entry.kind {
        Granted => triggers.is_granted(p),
        Transact => !triggers.is_granted(p),
        _ => false,
    }
    matches_kind && triggers.matches(p, entry.identity, entry.args)
}

fn trigger_key[G: send, H: send](r: Registry[G, H], p: triggers.Pending, choices: triggers.Entries) -> Result[Option[(Bytes, u64)], store.Error] {
    if !triggers.is_allowed(p, choices) { return Ok(None) }
    for index in 0u64 .. list.len(r.exported) {
        let entry = view r.exported[index]
        if trigger_matches(p, entry.described) {
            let mut key = copy_bytes(entry.described.identity)?
            std.codec.put_u64(entry.args_fp, mut key)
            std.codec.put_u64(entry.result_fp, mut key)
            return Ok(Some((take key, index)))
        }
    }
    Ok(None)
}

fn trigger_store_error(take problem: triggers.Error) -> store.Error {
    match take problem {
        Store(take underlying) => take underlying,
        AttemptLimit => Limit(Transaction),
        _ => Missing("trigger"),
    }
}

fn trigger_commit[R](take ran: Result[store.Outcome[R, triggers.Error], store.Error]) -> Result[store.Done[R], store.Error] {
    match take ran {
        Ok(Committed(take committed)) => Ok(take committed),
        Ok(Aborted(store.Undone(value: take problem, ..))) => Error(trigger_store_error(take problem)),
        Ok(Refused(cap)) => Error(Full(cap)),
        Error(take problem) => Error(take problem),
        _ => Error(Missing("trigger commit")),
    }
}

fn publish_trigger[G: send, H: send](mut hd: Head[G, H], ticket: store.Ticket) -> Result[(), store.Error] waits {
    hd.last = Some(ticket)
    gate(mut hd)
}

type TriggerBodyError: send = Store(triggers.Error) | Terminal(triggers.Terminal) | NotDue

fn trigger_terminal(take outcome: Outcome) -> triggers.Terminal {
    match take outcome {
        Returned(take raw) => Returned(take raw),
        Failed(Raised(reason)) => Raised(reason),
        Failed(OutOfTime(steps)) => OutOfTime(steps),
        Failed(OutOfBytes(cap)) => OutOfBytes(cap.requested, cap.available),
        Refused(Budget(cap)) => OutOfBytes(cap.requested, cap.available),
        _ => Gone,
    }
}

fn run_trigger_transaction[G: send, H: send](mut hd: Head[G, H], mut drive: Box[TriggerDrive[G]], p: triggers.Pending, take key: Option[Bytes]) -> Result[bool, store.Error] waits {
    let completed = invoke_trigger_transaction(mut hd.db, hd.r, hd.h, drive, p, key)?
    let final = match take completed {
        TriggerApplied(ticket) => { publish_trigger(mut hd, ticket)?; return Ok(true) },
        TriggerSettled(take outcome) => take outcome,
        TriggerNotDue => { arm_trigger_timer(mut drive, triggers.due_time(p))?; return Ok(false) },
    }
    // The draft that returned an error or fault left no writes. Only this
    // settlement commits, and it consumes the row with the outcome.
    let collected = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.finish_transact(mut tx, drive.tables, p, final)
    })
    let committed = trigger_commit(take collected)?
    publish_trigger(mut hd, committed.ticket)?
    Ok(true)
}

type TriggerDraft = TriggerApplied(store.Ticket) | TriggerSettled(triggers.Terminal) | TriggerNotDue

fn invoke_trigger_transaction[G: send, H: send](mut db: store.Db, r: Registry[G, H], h: H, drive: Box[TriggerDrive[G]], p: triggers.Pending, key: Option[Bytes]) -> Result[TriggerDraft, store.Error] waits {
    let slot = match key { Some(wanted) => map.get(r.slots, wanted), None => None }
    let terminal: triggers.Terminal = if let Some(Transact(n, steps, _, _, go)) = slot {
        let ran = store.run(mut db, Some(steps), scoped fn(mut tx: store.Tx) -> Result[(), TriggerBodyError] {
            // The wall can move backwards between the scheduler's sample
            // and this transaction. The body sees this CallInfo, so use it.
            if store.info(mut tx).at < triggers.due_time(p) { return Error(NotDue) }
            let body = bound bytes n { go(mut tx, h, drive.author, triggers.argument(p)) }
            let terminal: triggers.Terminal = match take body {
                Ok(Commit(take payload)) => Returned(take payload),
                Ok(Abort(take payload)) => return Error(Terminal(Returned(take payload))),
                Ok(Exhausted(cap)) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
                Ok(Refuse(_)) => return Error(Terminal(Gone)),
                Error(cap) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
            }
            match triggers.finish_transact(mut tx, drive.tables, p, terminal) {
                Ok(()) => Ok(()),
                Error(take problem) => Error(Store(take problem)),
            }
        })
        match take ran {
            Ok(Committed(committed)) => return Ok(TriggerApplied(committed.ticket)),
            Ok(Aborted(store.Undone(value: Terminal(take terminal), ..))) => take terminal,
            Ok(Aborted(store.Undone(value: NotDue, ..))) => return Ok(TriggerNotDue),
            Ok(Aborted(store.Undone(value: Store(take problem), ..))) => return Error(trigger_store_error(take problem)),
            Ok(Failed(causes)) => Raised(raised(causes)),
            Ok(Stopped(limit)) => OutOfTime(limit.steps),
            Ok(Refused(cause)) => {
                let cap = store_capacity(cause)
                OutOfBytes(cap.requested, cap.available)
            },
            Error(take problem) => return Error(take problem),
        }
    } else { Gone }
    Ok(TriggerSettled(take terminal))
}

type TriggerReport: send { attempt: triggers.Attempt, to: Sender[HeadInput] }

type WireGrantReport: send { tick: Tick, to: Sender[WireEvent], clock: Clock, deadline: u64 }
type JobReport: send = Triggered(TriggerReport) | WireGrant(WireGrantReport)

type WatchedJob[G: send, A, R]: send {
    job: Job[G, A, R], report: JobReport, tasks: Tasks, allowance: u64
}

fn watch_granted[G: send, A, R](take watched: WatchedJob[G, A, R]) -> Outcome waits {
    let WatchedJob(job: take work, report: take report, tasks: tasks, allowance: n) = take watched
    let finished: Option[Outcome] = match task.spawn(tasks, bytes n, take work, adapt_granted) {
        take running => match task.join(take running) {
            Ok(take outcome) => Some(take outcome),
            Error(Failed(causes)) => Some(Failed(Raised(raised(causes)))),
            Error(Cancelled(_)) => None,
        },
    }
    match take report {
        Triggered(note) => { let _ = channel.send(note.to, TriggerDone(note.attempt, take finished)) },
        WireGrant(take note) => {
            let WireGrantReport(tick: take tick, to: take to, clock: clock, deadline: deadline) = take note
            let outcome: Outcome = if host.mono_ns(clock) >= deadline { Abandoned } else {
                match take finished { Some(take result) => take result, None => Abandoned }
            }
            let _ = channel.send(to, wire_event(GrantedDone(take tick, take outcome)))
        },
    }
    Abandoned
}

fn launch_trigger[G: send, H: send](r: Registry[G, H], mut drive: Box[TriggerDrive[G]], p: triggers.Pending, a: triggers.Attempt, key: Bytes) -> Result[(), Refusal] {
    let Some(Granted(go)) = map.get(r.slots, key) else { return Error(NoEntry) }
    let grant_to = match drive.grants {
        Some(grants) => channel.sender(grants.to),
        None => return Error(NoEntry),
    }
    map.reserve(mut drive.active, 1u64)
    let context = TriggerContext(attempt: a, to: channel.sender(drive.to))
    let source = FromPlace(take grant_to, take context)
    let raw: Bytes = match copy_bytes(triggers.argument(p)) {
        Ok(take payload) => take payload,
        Error(Full(cap)) => return Error(Budget(room(store_capacity(cap)))),
        Error(_) => return Error(NoEntry),
    }
    let notice = TriggerReport(attempt: a, to: channel.sender(drive.to))
    let copied: Caller = clone(drive.author)
    let caller = take copied
    match go(drive.tasks, take source, take caller, take raw, Some(Triggered(take notice))) {
        Ok(take watcher) => {
            map.insert(mut drive.active, triggers.run_id(a), take watcher)
            Ok(())
        },
        Error(cap) => Error(Budget(room(cap))),
    }
}

fn finish_trigger[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], a: triggers.Attempt, outcome: triggers.Terminal) -> Result[(), store.Error] waits {
    let settled = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.finish(mut tx, drive.tables, a, outcome)
    })
    match take settled {
        Ok(Aborted(store.Undone(value: StaleAttempt, ..))) => Ok(()),
        other => {
            let committed = trigger_commit(take other)?
            publish_trigger(mut hd, committed.ticket)
        },
    }
}

fn advance_trigger[G: send, H: send](mut hd: Head[G, H], mut drive: Box[TriggerDrive[G]]) -> Result[bool, store.Error] waits {
    let snapshot = store.snapshot(hd.db)
    let next = triggers.next_pending(snapshot, drive.tables, scoped fn(id: triggers.Id) -> bool { map.contains(drive.active, id) })?
    let Some(take p) = take next else { return Ok(false) }
    let due = triggers.due_time(p)
    if store.next_call_info(hd.db).at < due {
        arm_trigger_timer(mut drive, due)?
        return Ok(false)
    }
    if let Some(_) = hd.last { gate(mut hd)? }
    if hd.cut { return Ok(false) }
    if triggers.cancelling(p) {
        let settled = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
            triggers.finish_cancel(mut tx, drive.tables, p)
        })
        let committed = trigger_commit(take settled)?
        publish_trigger(mut hd, committed.ticket)?
        return Ok(true)
    }
    let key = match trigger_key(hd.r, p, drive.entries)? {
        Some((take key, _)) => Some(take key),
        None => None,
    }
    if !triggers.is_granted(p) {
        return run_trigger_transaction(mut hd, mut drive, p, take key)
    }
    let ran = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[triggers.Started, triggers.Error] {
        triggers.start(mut tx, drive.tables, p, drive.revision)
    })
    let committed = match take ran {
        Ok(Aborted(store.Undone(value: NotDue, ..))) => {
            arm_trigger_timer(mut drive, due)?
            return Ok(false)
        },
        other => trigger_commit(take other)?,
    }
    publish_trigger(mut hd, committed.ticket)?
    if hd.cut { return Ok(false) }
    match committed.value {
        Held => (),
        Body(a) => {
            if let Some(wanted) = key {
                if let Error(take problem) = launch_trigger(hd.r, mut drive, p, a, wanted) {
                    finish_trigger(mut hd, drive, a, trigger_terminal(Refused(take problem)))?
                }
            } else { finish_trigger(mut hd, drive, a, Gone)? }
        },
    }
    Ok(true)
}

fn advance_triggers[G: send, H: send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    let Some(take selected) = replace(mut hd.trigger_drive, None) else { return Ok(false) }
    let mut drive = take selected
    let advanced = advance_trigger(mut hd, mut drive)
    hd.trigger_drive = Some(take drive)
    take advanced
}

fn trigger_done[G: send, H: send](mut hd: Head[G, H], a: triggers.Attempt, take outcome: Option[Outcome], closed: bool) -> Result[(), store.Error] waits {
    let Some(take selected) = replace(mut hd.trigger_drive, None) else { return Ok(()) }
    let mut drive = take selected
    let watched = map.remove(mut drive.active, triggers.run_id(a))
    let completed = if let Some(take watcher) = take watched {
        let _ = task.join(take watcher)
        if let Some(take result) = take outcome {
            if !closed { finish_trigger(mut hd, drive, a, trigger_terminal(take result)) } else { Ok(()) }
        } else { Ok(()) }
    } else { Ok(()) }
    hd.trigger_drive = Some(take drive)
    take completed
}

fn trigger_message[G: send, H: send](mut hd: Head[G, H], take pending: Box[TriggerInput], closed: bool) -> Result[(), store.Error] waits {
    let TriggerInput(action: take action) = box.unbox(take pending)
    let Some(take drive) = replace(mut hd.trigger_drive, None) else { return Ok(()) }
    let result = answer_trigger(mut hd, drive, take action, closed)
    hd.trigger_drive = Some(take drive)
    take result
}

fn checked_boundary(take seen: Result[bool, triggers.Error]) -> Result[(), TriggerCallError] {
    match take seen {
        Ok(false) => Ok(()),
        Ok(true) => Error(Cancelled),
        Error(Store(take problem)) => Error(Store(take problem)),
        Error(_) => Error(StaleAttempt),
    }
}

fn answer_trigger[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], take action: TriggerAction, closed: bool) -> Result[(), store.Error] waits {
    if let Some(_) = hd.last { gate(mut hd)? }
    let stopped = closed || hd.cut
    match take action {
        Invoke(a, take key, take arg, take answer) => {
            let reply: Result[Outcome, TriggerCallError] =
                if stopped { Error(Closed) } else { trigger_effect(mut hd, drive.tables, drive.author, a, key, arg)? }
            let _ = channel.send(answer, take reply)
        },
        Boundary(a, take answer) => {
            let reply: Result[(), TriggerCallError] = if stopped { Error(Closed) } else {
                checked_boundary(triggers.boundary(store.snapshot(hd.db), drive.tables, a))
            }
            let _ = channel.send(answer, take reply)
        },
        MarkHold(a, position, take expected, take actual, take answer) => {
            let reply: Result[(), TriggerCallError] = if stopped { Error(Closed) } else {
                mark_trigger_hold(mut hd, drive, a, position, expected, actual)?
            }
            let _ = channel.send(answer, take reply)
        },
    }
    Ok(())
}

fn mark_trigger_hold[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], a: triggers.Attempt, position: u64, expected: Bytes, actual: Bytes) -> Result[Result[(), TriggerCallError], store.Error] waits {
    let written = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), TriggerCallError] {
        match triggers.hold(mut tx, drive.tables, a, position, expected, actual) {
            Ok(()) => Ok(()),
            Error(Store(take problem)) => Error(Store(take problem)),
            Error(CancelRequested) => Error(Cancelled),
            Error(_) => Error(StaleAttempt),
        }
    })
    match take written {
        Ok(Committed(done)) => { publish_trigger(mut hd, done.ticket)?; Ok(Ok(())) },
        Ok(Aborted(store.Undone(value: take problem, ..))) => Ok(Error(take problem)),
        Ok(Refused(cap)) => Ok(Error(Capacity(store_capacity(cap)))),
        Error(take problem) => Error(take problem),
        _ => Error(Missing("trigger hold")),
    }
}

fn trigger_effect[G: send, H: send](mut hd: Head[G, H], trigger_tables: triggers.Tables, author: Caller, a: triggers.Attempt, key: Bytes, arg: Bytes) -> Result[Result[Outcome, TriggerCallError], store.Error] waits {
    let invoked = apply_attempt(mut hd.db, hd.r, hd.h, trigger_tables, author, a, key, arg)
    match take invoked {
        Ok(Committed(store.Done(value: take value, ticket: ticket, ..))) => {
            publish_trigger(mut hd, ticket)?
            Ok(Ok(take value))
        },
        Ok(Aborted(store.Undone(value: BodyOutcome(take outcome), ..))) => Ok(Ok(take outcome)),
        Ok(Aborted(store.Undone(value: Refusal(take problem), ..))) => Ok(Error(take problem)),
        Ok(Failed(causes)) => Ok(Ok(Failed(Raised(raised(causes))))),
        Ok(Stopped(limit)) => Ok(Ok(Failed(OutOfTime(limit.steps)))),
        Ok(Refused(cap)) => Ok(Error(Capacity(store_capacity(cap)))),
        Error(take problem) => Error(take problem),
    }
}

// The W2 fixture calls the same release gate as trigger_message. It owns the
// database and reads the volatile head separately from the answer.
pub fn journal_attempt_gate(take db: store.Db, take registered: Registry[(), ()], t: triggers.Tables, a: triggers.Attempt, key: Bytes, arg: Bytes)
    -> (store.Db, u64, Result[Result[Outcome, TriggerCallError], store.Error]) waits {
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(2u64)
    let mut head = Head(db: take db, r: take registered, replay_identity: list.new(), h: (), out: take to,
        busy: map.new(), waiting: list.new(), group: list.new(), last: None, minted: 0u64, cut: false, trigger_drive: None)
    let response = trigger_effect(mut head, t, store.Caller(issuer: 0u8, subject: list.new()), a, key, arg)
    let at = store.version(store.snapshot(head.db))
    let Head(db: take kept, ..) = take head
    let _ = take from
    (take kept, at, take response)
}

pub fn apply_attempt[G: send, H: send](mut db: store.Db, registered: Registry[G, H], h: H, trigger_tables: triggers.Tables, author: Caller, a: triggers.Attempt, key: Bytes, arg: Bytes) -> Result[store.Outcome[Outcome, FencedRefusal], store.Error] waits {
    let slot = map.get(registered.slots, key)
    let steps = match slot { Some(Transact(_, limit, _, _, _)) => Some(limit), Some(Fenced(_, limit, _)) => Some(limit), _ => None }
    store.run(mut db, steps, scoped fn(mut tx: store.Tx) -> Result[Outcome, FencedRefusal] {
        match triggers.fence(tx, trigger_tables, a) {
            Ok(false) => (),
            Ok(true) => return Error(Refusal(Cancelled)),
            Error(StaleAttempt) => return Error(Refusal(StaleAttempt)),
            Error(Store(take problem)) => return Error(Refusal(Store(take problem))),
            Error(_) => return Error(Refusal(StaleAttempt)),
        }
        if let Some(Fenced(n, _, go)) = slot {
            let ran = bound bytes n { go(mut tx, a, arg) }
            return match take ran {
                Ok(Ok(take payload)) => Ok(Returned(take payload)),
                Ok(Error(take problem)) => Error(Refusal(Store(take problem))),
                Error(cap) => Error(Refusal(Capacity(cap))),
            }
        }
        if let Some(Transact(n, _, _, _, go)) = slot {
            let ran = bound bytes n { go(mut tx, h, author, arg) }
            match take ran {
                Ok(Commit(take payload)) => Ok(Returned(take payload)),
                Ok(Abort(take payload)) => Error(BodyOutcome(Returned(take payload))),
                Ok(Refuse(take refusal)) => Error(BodyOutcome(Refused(take refusal))),
                Ok(Exhausted(cap)) => Error(BodyOutcome(Failed(OutOfBytes(room(cap))))),
                Error(cap) => Error(BodyOutcome(Failed(OutOfBytes(room(cap))))),
            }
        } else { Error(BodyOutcome(Refused(NoEntry))) }
    })
}

type TriggerLawTables: send { effects: store.Table[u64, u64] }

fn trigger_law_migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    triggers.migrate(mut phase)?
    let codec: std.codec.Codec[u64] = std.codec.of()
    store.migration_create_table(mut phase, store.spec("trigger-law-effects", std.codec.key_u64(), codec))
}

fn trigger_law_handles(catalog: store.Schema) -> Result[TriggerLawTables, store.Error] {
    let codec: std.codec.Codec[u64] = std.codec.of()
    let effects = store.schema_table(catalog, "trigger-law-effects", std.codec.key_u64(), codec)?
    Ok(TriggerLawTables(effects: take effects))
}

fn trigger_law_body(mut tx: store.Tx, h: TriggerLawTables, author: Caller, take digit: u64) -> Result[u64, u64] {
    let old = match result.unwrap(store.fetch(tx, store.shape(h.effects), 0u64)) { Some(value) => value, None => 0u64 }
    let next = old * 10u64 + digit
    result.unwrap(store.put(mut tx, h.effects, 0u64, next))
    if digit == 2u64 { return Error(22u64) }
    if digit == 3u64 { fail("trigger law: abort on fault") }
    if digit == 4u64 {
        let info = store.info(mut tx)
        result.unwrap(store.put(mut tx, h.effects, 1u64, info.at))
    }
    Ok(next)
}

fn trigger_law_grants(seed: (), take ctx: TriggerContext) -> Result[TriggerContext, Capacity] { Ok(take ctx) }

fn trigger_law_config(take entries: triggers.Entries) -> TriggerConfig[TriggerContext, ()] {
    TriggerConfig(entries: take entries, author: store.Caller(issuer: 0u8, subject: list.new()),
        grants: (), grant: trigger_law_grants, grant_bytes: 65536u64)
}

fn trigger_law_places(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    transact(mut reg, code.describe(trigger_law_body), 131072u64, DEFAULT_STEPS)?
    granted(mut reg, code.describe(trigger_law_granted_body), 131072u64, DEFAULT_STEPS)
}

fn trigger_law_initial(take db: store.Db, c: Clock, tasks: Tasks, take to: Sender[HeadInput], take allowed: triggers.Entries) -> (Head[TriggerContext, TriggerLawTables], Receiver[PubIn]) {
    let revision = result.unwrap(copy_bytes(string.as_bytes("trigger-law-r1")))
    let config = trigger_law_config(take allowed)
    let drive = result.unwrap(make_trigger_drive(db, c, tasks, take to, revision, take config))
    let reg = result.unwrap(placed(code.describe(trigger_law_places), 1048576u64))
    let h = result.unwrap(store.with_schema(db, code.describe(trigger_law_handles)))
    let (out, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(32u64)
    let head = Head(db: take db, r: take reg, replay_identity: list.new(), h: take h, out: take out,
        busy: map.new(), waiting: list.new(), group: list.new(), last: None, minted: 0u64, cut: false,
        trigger_drive: Some(take drive))
    (take head, take from)
}

fn trigger_law_outcome[G: send, H: send](head: Head[G, H], id: triggers.Id) -> Option[triggers.Terminal] {
    match head.trigger_drive {
        Some(drive) => result.unwrap(triggers.outcome(store.snapshot(head.db), drive.tables, id)),
        None => None,
    }
}

fn trigger_law_value(head: Head[TriggerContext, TriggerLawTables]) -> Option[u64] {
    result.unwrap(store.get(store.snapshot(head.db), store.shape(head.h.effects), 0u64))
}

fn trigger_law_invoked(outcome: Option[triggers.Terminal], expected: Result[u64, u64]) -> bool {
    let Some(Returned(raw)) = view outcome else { return false }
    let codec: std.codec.Codec[Result[u64, u64]] = std.codec.of()
    match std.codec.decode(codec, raw) {
        Ok(value) => match value {
            Ok(n) => match expected { Ok(want) => n == want, _ => false },
            Error(n) => match expected { Error(want) => n == want, _ => false },
        },
        _ => false,
    }
}

// ENDSTATE Triggers T1/T2 and Transact. A later-due row is written first,
// followed by AfterCommit, a typed error and a fault. The clock crosses T
// while the store is closed. The fault and error write a digit before failing,
// so only a rollback followed by outcome-only consumption leaves 14.
pub fn journal_law_trigger_transact(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = triggers.law_directory(d)
    let mut initial = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    result.unwrap(store.run_migration(mut initial, tasks, code.describe(trigger_law_migrate)))
    let tables = result.unwrap(store.with_schema(initial, code.describe(triggers.tables)))
    let target: triggers.Entry[u64] = result.unwrap(triggers.transact(code.describe(trigger_law_body)))
    let mut allowed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut allowed, target))
    let latest = store.next_call_info(initial).at + 10u64
    let written = store.run(mut initial, None, scoped fn(mut tx: store.Tx) -> Result[(triggers.Id, triggers.Id, triggers.Id, triggers.Id), triggers.Error] {
        let later = triggers.write(mut tx, tables, allowed, target, 4u64, At(latest))?
        let early = triggers.write(mut tx, tables, allowed, target, 1u64, AfterCommit)?
        let aborted = triggers.write(mut tx, tables, allowed, target, 2u64, At(latest))?
        let faulted = triggers.write(mut tx, tables, allowed, target, 3u64, At(latest))?
        Ok((early, later, aborted, faulted))
    })
    let committed = result.unwrap(trigger_commit(take written))
    let (early, later, aborted, faulted) = committed.value
    if later.index != 0u64 || early.index != 1u64 || aborted.index != 2u64 || faulted.index != 3u64 { return false }
    if early.version != committed.info.id.version || early.branch != committed.info.id.branch { return false }
    result.unwrap(store.durable(mut initial, committed.ticket))
    result.unwrap(store.close(take initial))
    while host.wall_ms(c) < latest {
        host.sleep_until(c, host.mono_ns(c) + 10000000u64)
    }

    let reopened = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    let (wake, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let (take built, take published) = trigger_law_initial(take reopened, c, tasks, take wake, take allowed)
    let mut head = take built
    let initial_version = store.version(store.snapshot(head.db))
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if !trigger_law_invoked(trigger_law_outcome(head, early), Ok(1u64)) { return false }
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if !trigger_law_invoked(trigger_law_outcome(head, later), Ok(14u64)) { return false }
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if !trigger_law_invoked(trigger_law_outcome(head, aborted), Error(22u64)) { return false }
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if let Some(Raised(5u32)) = trigger_law_outcome(head, faulted) { } else { return false }
    if trigger_law_value(head) != Some(14u64) { return false }
    let final_snapshot = store.snapshot(head.db)
    if store.version(final_snapshot) != initial_version + 4u64 { return false }
    let at = result.unwrap(store.get(final_snapshot, store.shape(head.h.effects), 1u64))
    if let Some(seen) = at { if seen < latest { return false } } else { return false }
    if result.unwrap(advance_triggers(mut head)) { return false }
    let Head(db: take kept, ..) = take head
    result.unwrap(store.close(take kept))

    let mut recovered = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    let recovered_tables = result.unwrap(store.with_schema(recovered, code.describe(triggers.tables)))
    let due = result.unwrap(triggers.next_pending(store.snapshot(recovered), recovered_tables, fn(id: triggers.Id) -> bool { false }))
    if let Some(_) = due { return false }
    if let Some(Raised(5u32)) = result.unwrap(triggers.outcome(store.snapshot(recovered), recovered_tables, faulted)) { } else { return false }
    result.unwrap(store.close(take recovered))
    true
}

@test
fn journal_test_trigger_transact(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_trigger_transact(d, c, r, tasks) { Ok(()) } else { Error(()) }
}

fn trigger_law_entry_key() -> Result[Bytes, std.codec.EncodeError] {
    let args: std.codec.Codec[u64] = std.codec.of()
    let returned: std.codec.Codec[Result[u64, u64]] = std.codec.of()
    let (take key, _) = described(code.identity(code.describe(trigger_law_body)), None, Transact, args, returned)?
    Ok(take key)
}

fn trigger_law_argument(n: u64) -> Result[Bytes, Capacity] {
    let mut raw: Bytes = list.new()
    std.codec.put_u64(n, mut raw)
    Ok(take raw)
}

fn trigger_law_granted_body(ctx: TriggerContext, caller: Caller, take digit: u64) -> Result[u64, Capacity] waits {
    match trigger_boundary(ctx) {
        Ok(()) => (),
        Error(Cancelled) => return Ok(0u64),
        _ => fail("trigger law: unexpected boundary result"),
    }
    if digit == 5u64 {
        let expected = trigger_law_argument(1u64)?
        let actual = trigger_law_argument(2u64)?
        result.unwrap(trigger_hold(ctx, 3u64, take expected, take actual))
        return Ok(0u64)
    }
    let key = result.unwrap(trigger_law_entry_key())
    let arg = trigger_law_argument(digit)?
    match trigger_call(ctx, take key, take arg) {
        Ok(Returned(_)) => Ok(triggers.number(trigger_attempt(ctx))),
        Error(Cancelled) => Ok(0u64),
        _ => fail("trigger law: unexpected fenced call result"),
    }
}

// ENDSTATE granted Start/End and steps law 7. After the start is durable,
// close before a body can write. Reopen and run attempt 2, then try the old
// attempt's write during attempt 2. The first attempt must have changed no row,
// the late write must be refused, and exactly one terminal outcome must remain.
pub fn journal_law_trigger_granted(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = triggers.law_directory(d)
    let mut initial = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    result.unwrap(store.run_migration(mut initial, tasks, code.describe(trigger_law_migrate)))
    let t = result.unwrap(store.with_schema(initial, code.describe(triggers.tables)))
    let target: triggers.Entry[u64] = result.unwrap(triggers.granted(code.describe(trigger_law_granted_body)))
    let mut allowed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut allowed, target))
    let armed = store.run(mut initial, None, scoped fn(mut tx: store.Tx) -> Result[triggers.Id, triggers.Error] {
        triggers.write(mut tx, t, allowed, target, 7u64, AfterCommit)
    })
    let committed = result.unwrap(trigger_commit(take armed))
    result.unwrap(store.durable(mut initial, committed.ticket))
    let (first_to, first_inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let first_allowed: triggers.Entries = clone(allowed)
    let (take first_head, take first_published) = trigger_law_initial(take initial, c, tasks, take first_to, take first_allowed)
    let mut running_head = take first_head
    if !result.unwrap(advance_triggers(mut running_head)) { return false }
    // The body is waiting at its first boundary. Close without answering it
    // and leave its durable start as the last write.
    let pending = result.unwrap(channel.receive(first_inbox))
    let TriggerMessage(first_request) = view pending else { return false }
    let Boundary(old, _) = view first_request.action else { return false }
    if triggers.number(old) != 1u64 { return false }
    let Head(db: take before, trigger_drive: take active, ..) = take running_head
    let _ = stop_triggers(option.unwrap(take active))
    result.unwrap(store.close(take before))

    let reopened = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    let (to, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let (take built, take published) = trigger_law_initial(take reopened, c, tasks, take to, take allowed)
    let mut head = take built
    if !result.unwrap(advance_triggers(mut head)) { return false }
    let selected = replace(mut head.trigger_drive, None)
    let drive = option.unwrap(take selected)
    let wrong = result.unwrap(trigger_law_argument(9u64))
    let key = result.unwrap(trigger_law_entry_key())
    let stale = trigger_effect(mut head, drive.tables, drive.author, old, key, wrong)
    head.trigger_drive = Some(take drive)
    match stale { Ok(Error(StaleAttempt)) => (), _ => return false }
    let boundary = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take check) = take boundary else { return false }
    result.unwrap(trigger_message(mut head, take check, false))
    let inbound = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take request) = take inbound else { return false }
    result.unwrap(trigger_message(mut head, take request, false))
    let scope_end = result.unwrap(channel.receive(inbox))
    let TriggerDone(a, take answer) = take scope_end else { return false }
    if triggers.number(a) != 2u64 || triggers.run_id(a) != committed.value { return false }
    result.unwrap(trigger_done(mut head, a, take answer, false))
    if trigger_law_value(head) != Some(7u64) || result.unwrap(advance_triggers(mut head)) { return false }
    let Some(Returned(take raw)) = trigger_law_outcome(head, committed.value) else { return false }
    let mut offset = 0u64
    if result.unwrap(std.codec.take_u64(raw, mut offset)) != 2u64 { return false }
    let Head(db: take kept, ..) = take head
    result.unwrap(store.close(take kept))
    true
}

@test
fn journal_test_trigger_granted(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_trigger_granted(d, c, r, tasks) { Ok(()) } else { Error(()) }
}

fn trigger_scan_law_unchanged(mut tx: store.Tx, h: TriggerLawTables, author: Caller, take value: u64) -> Result[u64, u64] { Ok(value) }

fn trigger_scan_law_removed(mut tx: store.Tx, h: TriggerLawTables, author: Caller, take value: u64) -> Result[u64, u64] { Ok(value) }

fn trigger_scan_law_removed_run(ctx: TriggerContext, caller: Caller, take value: u64) -> Result[u64, Capacity] waits {
    let _ = trigger_boundary(ctx)
    Ok(value)
}

fn trigger_scan_law_new(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    trigger_law_places(mut reg)?
    transact(mut reg, code.describe(trigger_scan_law_unchanged), 131072u64, DEFAULT_STEPS)
}

fn trigger_scan_law_old(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    trigger_scan_law_new(mut reg)?
    transact(mut reg, code.describe(trigger_scan_law_removed), 131072u64, DEFAULT_STEPS)?
    granted(mut reg, code.describe(trigger_scan_law_removed_run), 131072u64, DEFAULT_STEPS)
}

fn trigger_scan_law_keep_schema(mut phase: store.Migration) -> Result[(), store.Error] { Ok(()) }

fn trigger_scan_law_bytes(n: u64, byte: u8) -> Bytes {
    let mut raw: Bytes = list.with_capacity(n)
    list.fill(mut raw, n, byte)
    take raw
}

// L40. Use the real export and prepare writer against a recorded OLD revision.
@test
fn trigger_scan_classes(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    let mut options = triggers.law_options()
    options.pack_bytes = 1048576u64
    trigger_scan_image(d, c, r, tasks, options, false)?
    trigger_scan_image(d, c, r, tasks, options, true)?
    trigger_scan_last_entry(d, c, r, tasks, options, false)?
    trigger_scan_last_entry(d, c, r, tasks, options, true)
}

fn trigger_scan_image(d: Dir, c: Clock, r: Random, tasks: Tasks, options: store.Options, same_image: bool) -> Result[(), ()] waits {
    let dir = triggers.law_directory(d)
    let mut db = result.unwrap(store.open(tasks, dir, c, r, options))
    let n_place = 1048576u64
    let old_digest = trigger_scan_law_bytes(32u64, 1u8)
    let new_digest = trigger_scan_law_bytes(32u64, if same_image { 1u8 } else { 2u8 })
    let new_place = if same_image { code.describe(trigger_scan_law_old) } else { code.describe(trigger_scan_law_new) }
    let new_n_place = if same_image { n_place * 2u64 } else { n_place }
    let mut old_reg = result.unwrap(placed(code.describe(trigger_scan_law_old), n_place))
    // Model an older body at the same path and schema, as recorded by OLD.
    if !same_image { old_reg.exported[0u64].revision = trigger_scan_law_bytes(32u64, 3u8) }
    let Registry(exported: take exported, ..) = take old_reg
    let release = result.unwrap(release_digest(exported))
    let old_desc = result.unwrap(encode_describe(Describe(digest: clone(old_digest),
        target: "", n_place: n_place, exported: take exported)))
    let mut staged = result.unwrap(store.stage_migration(db, tasks, code.describe(trigger_law_migrate)))
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    result.unwrap(store.stage_activation(mut staged, 1u64, None, old_desc, release_codec,
        ReleaseRecord(release: take release, digest: clone(old_digest))))
    result.unwrap(store.install_activation(mut db, take staged))
    let tables = result.unwrap(store.with_schema(db, code.describe(triggers.tables)))

    let changed = result.unwrap(triggers.transact(code.describe(trigger_law_body)))
    let unchanged = result.unwrap(triggers.transact(code.describe(trigger_scan_law_unchanged)))
    let removed = result.unwrap(triggers.transact(code.describe(trigger_scan_law_removed)))
    let kept_run = result.unwrap(triggers.granted(code.describe(trigger_law_granted_body)))
    let removed_run = result.unwrap(triggers.granted(code.describe(trigger_scan_law_removed_run)))
    let mut new_entries = triggers.empty_entries()
    result.unwrap(triggers.allow(mut new_entries, changed))
    result.unwrap(triggers.allow(mut new_entries, unchanged))
    result.unwrap(triggers.allow(mut new_entries, kept_run))
    let mut old_entries: triggers.Entries = clone(new_entries)
    result.unwrap(triggers.allow(mut old_entries, removed))
    result.unwrap(triggers.allow(mut old_entries, removed_run))
    let written = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(triggers.Id, triggers.Id, triggers.Id, triggers.Id, triggers.Id, Option[triggers.Id]), triggers.Error] {
        let kept = triggers.write(mut tx, tables, old_entries, kept_run, 7u64, At(0u64))?
        let lost = triggers.write(mut tx, tables, old_entries, removed_run, 0u64, At(1u64))?
        let gone = triggers.write(mut tx, tables, old_entries, removed, 0u64, At(2u64))?
        let cancel = triggers.write(mut tx, tables, old_entries, removed, 0u64, At(3u64))?
        let park_cancel = triggers.write(mut tx, tables, old_entries, removed_run, 0u64, At(4u64))?
        let _ = triggers.write(mut tx, tables, old_entries, changed, 1u64, At(5u64))?
        let _ = triggers.write(mut tx, tables, old_entries, unchanged, 0u64, At(7u64))?
        let _ = triggers.write(mut tx, tables, old_entries, unchanged, 0u64, At(6u64))?
        let staying = if same_image { Some(triggers.write(mut tx, tables, old_entries, kept_run, 0u64, At(8u64))?) } else { None }
        Ok((kept, lost, gone, cancel, park_cancel, staying))
    })
    let (kept, lost, gone, cancel, park_cancel, staying) = result.unwrap(trigger_commit(take written)).value
    let base = store.snapshot(db)
    let first = option.unwrap(result.unwrap(triggers.next_pending(base, tables, fn(id: triggers.Id) -> bool { false })))
    let second = option.unwrap(result.unwrap(triggers.next_pending(base, tables, scoped fn(id: triggers.Id) -> bool { id == kept })))
    let cancelling_row = option.unwrap(result.unwrap(triggers.next_pending(base, tables, scoped fn(id: triggers.Id) -> bool { id != park_cancel })))
    let parked_row = result.unwrap(triggers.next_pending(base, tables, scoped fn(id: triggers.Id) -> bool { Some(id) != staying }))
    let started = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        let _ = triggers.start(mut tx, tables, first, old_digest)?
        let _ = triggers.start(mut tx, tables, second, old_digest)?
        let Body(park) = triggers.start(mut tx, tables, cancelling_row, old_digest)? else { return Error(StaleAttempt) }
        triggers.hold(mut tx, tables, park, 0u64, list.new(), list.new())?
        if let Some(row_to_park) = parked_row {
            let Body(hold) = triggers.start(mut tx, tables, row_to_park, old_digest)? else { return Error(StaleAttempt) }
            triggers.hold(mut tx, tables, hold, 0u64, list.new(), list.new())?
        }
        triggers.request_cancel(mut tx, tables, cancel)?
        triggers.request_cancel(mut tx, tables, park_cancel)
    })
    let _ = result.unwrap(trigger_commit(take started))

    let attempt = trigger_scan_law_bytes(16u64, 4u8)
    let copying = result.unwrap(store.begin_export_copy(mut db, d, clone(attempt), 1u64))
    let exported_store = result.unwrap(store.export_copy(take copying))
    let source = result.unwrap(store.open_export(exported_store.dir, c, attempt, options))
    let setup = PrepareConfig(scratch: exported_store.dir, options: options, attempt: clone(attempt), image_digest: clone(new_digest),
        clock: c, tasks: tasks, n_place: new_n_place, place: new_place,
        migrate: code.describe(trigger_scan_law_keep_schema), handles: code.describe(trigger_law_handles), triggers: clone(new_entries))
    result.unwrap(prepare_export(setup, source, new_digest))
    let raw = result.unwrap(std.file.read(exported_store.dir, "TRIGGERS"))
    let codec: std.codec.Codec[List[TriggerScanRow]] = std.codec.of_list()
    let rows = result.unwrap(std.codec.decode(codec, raw))
    if list.len(rows) != (if same_image { 8u64 } else { 7u64 }) { fail("L40: wrong number of report rows") }
    let schema = result.unwrap(std.codec.schema(std.codec.of_u64()))
    let mut seen = 0u64
    for row in rows {
        let (path, granted_kind, count, expected_class): (String, bool, u64, TriggerScanClass) = match row.earliest_due {
            0u64 => ("trigger_law_granted_body", true, 1u64, if same_image { Unchanged } else { Held }),
            1u64 => ("trigger_scan_law_removed_run", true, 1u64, if same_image { Gone } else { Held }),
            2u64 => ("trigger_scan_law_removed", false, 1u64, Gone),
            3u64 => ("trigger_scan_law_removed", false, 1u64, Cancelling),
            4u64 => ("trigger_scan_law_removed_run", true, 1u64, Cancelling),
            5u64 => ("trigger_law_body", false, 1u64, if same_image { Unchanged } else { Changed }),
            6u64 => ("trigger_scan_law_unchanged", false, 2u64, Unchanged),
            8u64 => if same_image { ("trigger_law_granted_body", true, 1u64, Held) } else { fail("L40: unexpected parked run") },
            _ => fail("L40: wrong earliest due time"),
        }
        let mut qualified: String = clone("store@1/runner/")
        string.push(mut qualified, path)
        let expected_kind: Kind = if granted_kind { Granted } else { Transact }
        let bit = 1u64 << int.narrow(row.earliest_due)
        if row.path != string.as_bytes(qualified) { fail("L40: wrong entry path") }
        if row.schema != schema || row.kind != expected_kind { fail("L40: wrong argument schema or kind") }
        if row.count != count || (seen & bit) != 0u64 { fail("L40: wrong count or duplicate row") }
        if row.class != expected_class { fail("L40: wrong trigger class") }
        seen |= bit
    }
    store.release_export(mut db, attempt)
    let (to, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let (take running, take published) = trigger_law_initial(take db, c, tasks, take to, take new_entries)
    let mut head = take running
    head.r = result.unwrap(placed(new_place, new_n_place))
    let mut drive = option.unwrap(replace(mut head.trigger_drive, None))
    drive.revision = clone(new_digest)
    head.trigger_drive = Some(take drive)
    for i in 0u64 .. 8u64 {
        if !result.unwrap(advance_triggers(mut head)) { fail("L40: due trigger did not advance") }
    }
    let snapshot = store.snapshot(head.db)
    if let Some(Gone) = trigger_law_outcome(head, gone) {} else { fail("L40: removed transact trigger did not end Gone") }
    if let Some(Cancelled) = trigger_law_outcome(head, cancel) {} else { fail("L40: cancel did not settle") }
    if let Some(Cancelled) = trigger_law_outcome(head, park_cancel) {} else { fail("L40: parked cancel did not settle") }
    if let Some(parked_id) = staying {
        if let Some(Gone) = trigger_law_outcome(head, lost) {} else { fail("L40: same-image retry of removed entry did not end Gone") }
        if let Some(Request(1u64, 0u64, _, _)) = result.unwrap(triggers.hold_mark(snapshot, tables, parked_id)) {} else { fail("L40: same-image Request hold changed") }
        for i in 0u64 .. 2u64 {
            let TriggerMessage(take message) = result.unwrap(channel.receive(inbox)) else { fail("L40: retry did not reach its trigger call") }
            result.unwrap(trigger_message(mut head, take message, false))
        }
        let TriggerDone(retried, take verdict) = result.unwrap(channel.receive(inbox)) else { fail("L40: retry did not finish") }
        if triggers.run_id(retried) != kept || triggers.number(retried) != 2u64 { fail("L40: wrong retry attempt") }
        result.unwrap(trigger_done(mut head, retried, take verdict, false))
        if let Some(Returned(_)) = trigger_law_outcome(head, kept) {} else { fail("L40: retry did not return") }
    } else {
        for id in [kept, lost] {
            match result.unwrap(triggers.hold_mark(snapshot, tables, id)) {
                Some(Revision(before, after)) => if before != old_digest || after != new_digest { fail("L40: wrong image digests in hold") },
                _ => fail("L40: changed image did not park the run"),
            }
        }
    }
    let Head(db: take done, trigger_drive: take active, ..) = take head
    stop_triggers(option.unwrap(take active))
    result.unwrap(store.close(take done))
    Ok(())
}

fn trigger_scan_law_last(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    transact(mut reg, code.describe(trigger_scan_law_removed), 131072u64, DEFAULT_STEPS)
}

fn trigger_scan_law_empty(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] { Ok(()) }

fn trigger_scan_law_install(mut db: store.Db, tasks: Tasks, n_place: u64,
    place: StaticFn[fn(mut Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits]) -> u64 waits {
    let reg = result.unwrap(placed(place, n_place))
    let (take description, take record) = result.unwrap(prepare_activation(reg, n_place))
    let mut pending_install = result.unwrap(store.stage_migration(db, tasks, migrate))
    let version = store.version(store.snapshot(db)) + 1u64
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    result.unwrap(store.stage_activation(mut pending_install, version, result.unwrap(current_description(db)), description, release_codec, record))
    result.unwrap(store.install_activation(mut db, take pending_install))
    version
}

fn trigger_scan_last_entry(d: Dir, c: Clock, r: Random, tasks: Tasks, options: store.Options, explicit_empty: bool) -> Result[(), ()] waits {
    let dir = triggers.law_directory(d)
    let n_place = 1048576u64
    let mut db = result.unwrap(store.open(tasks, dir, c, r, options))
    let _ = trigger_scan_law_install(mut db, tasks, n_place, code.describe(trigger_scan_law_last), code.describe(trigger_law_migrate))
    let tables = result.unwrap(store.with_schema(db, code.describe(triggers.tables)))
    let target = result.unwrap(triggers.transact(code.describe(trigger_scan_law_removed)))
    let mut listed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut listed, target))
    let due = host.wall_ms(c) + 100u64
    let written = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[triggers.Id, triggers.Error] {
        triggers.write(mut tx, tables, listed, target, 0u64, At(due))
    })
    let id = result.unwrap(trigger_commit(take written)).value
    let attempt = trigger_scan_law_bytes(16u64, 9u8)
    let digest = trigger_scan_law_bytes(32u64, 2u8)
    let copying = result.unwrap(store.begin_export_copy(mut db, d, clone(attempt), 1u64))
    let exported_store = result.unwrap(store.export_copy(take copying))
    let source = result.unwrap(store.open_export(exported_store.dir, c, attempt, options))
    let setup = PrepareConfig(scratch: exported_store.dir, options: options, attempt: clone(attempt), image_digest: clone(digest),
        clock: c, tasks: tasks, n_place: n_place, place: code.describe(trigger_scan_law_empty),
        migrate: code.describe(trigger_scan_law_keep_schema), handles: code.describe(trigger_law_handles), triggers: triggers.empty_entries())
    result.unwrap(prepare_export(setup, source, digest))
    let raw = result.unwrap(std.file.read(exported_store.dir, "TRIGGERS"))
    let codec: std.codec.Codec[List[TriggerScanRow]] = std.codec.of_list()
    let rows = result.unwrap(std.codec.decode(codec, raw))
    if list.len(rows) != 1u64 || rows[0u64].class != Gone || rows[0u64].count != 1u64 || rows[0u64].earliest_due != due {
        fail("L40: final entry did not scan as Gone")
    }
    store.release_export(mut db, attempt)
    let selection = Current(trigger_scan_law_install(mut db, tasks, n_place, code.describe(trigger_scan_law_empty), code.describe(trigger_scan_law_keep_schema)))
    result.unwrap(store.close(take db))

    let (to, events): (Sender[LifeEvent], Receiver[LifeEvent]) = channel.new(12u64)
    let (head_to, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(8u64)
    let (finish_to, finish_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let initial_window: Option[DrainWindow] = None
    let drain = latest.new(arc.new(initial_window))
    let triggering = if explicit_empty { Some(trigger_law_config(triggers.empty_entries())) } else { None }
    let job = ManagedHead(backing: Disk(dir, options), selection: selection, tasks: tasks, clock: c, random: r,
        place: code.describe(trigger_scan_law_empty), migrate: code.describe(trigger_scan_law_keep_schema),
        handles: code.describe(trigger_law_handles), n_place: n_place, n_publisher: 1048576u64, inbox: take inbox,
        finish_from: take finish_from, to: take to, drain: take drain, head_to: channel.sender(head_to),
        cut: result.unwrap(cut_activity()), triggering: take triggering, idle: None)
    let allowance = head_bytes(job.backing, job.n_place, job.n_publisher)
    let server = task.spawn(tasks, bytes allowance, take job, head_ended)
    if let Ok(Recovered) = channel.receive(events) {} else { fail("L40: serving head did not recover") }
    result.unwrap(channel.send(head_to, HeadContinue))
    if let Ok(Activated(_, _, _, _)) = channel.receive(events) {} else { fail("L40: serving head did not activate") }
    result.unwrap(channel.send(head_to, HeadContinue))
    if let Ok(Published(_)) = channel.receive(events) {} else { fail("L40: serving head did not publish") }
    host.sleep_until_wall(c, due)
    result.unwrap(channel.send(head_to, HeadContinue))
    // The serving loop dispatches due rows before it receives HeadClose.
    result.unwrap(channel.send(head_to, HeadClose))
    if let Ok(Settled) = channel.receive(events) {} else { fail("L40: serving head did not settle") }
    result.unwrap(channel.send(head_to, HeadFinish))
    if let Ok(HeadEnded(Ok(None))) = channel.receive(events) {} else { fail("L40: serving head did not close") }
    result.unwrap(task.join(take server))
    let reopened = result.unwrap(store.open(tasks, dir, c, r, options))
    let outcome = result.unwrap(triggers.outcome(store.snapshot(reopened), tables, id))
    result.unwrap(store.close(take reopened))
    if let Some(Gone) = outcome { Ok(()) } else { fail("L40: Gone did not survive reopen") }
}

// ENDSTATE steps law 7. A committed request reaches the waiting body at its
// boundary. Its ordinary return cannot replace the Cancelled terminal outcome.
pub fn journal_law_trigger_cancel(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = triggers.law_directory(d)
    let mut db = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    result.unwrap(store.run_migration(mut db, tasks, code.describe(trigger_law_migrate)))
    let tables = result.unwrap(store.with_schema(db, code.describe(triggers.tables)))
    let target: triggers.Entry[u64] = result.unwrap(triggers.granted(code.describe(trigger_law_granted_body)))
    let mut allowed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut allowed, target))
    let queued = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(triggers.Id, triggers.Id), triggers.Error] {
        let live = triggers.write(mut tx, tables, allowed, target, 7u64, AfterCommit)?
        let held = triggers.write(mut tx, tables, allowed, target, 5u64, AfterCommit)?
        Ok((live, held))
    })
    let writing = result.unwrap(trigger_commit(take queued))
    let (live, held) = writing.value
    result.unwrap(store.durable(mut db, writing.ticket))
    let (to, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let (take built, take published) = trigger_law_initial(take db, c, tasks, take to, take allowed)
    let mut head = take built
    if !result.unwrap(advance_triggers(mut head)) { return false }

    let cancellation = store.run(mut head.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.request_cancel(mut tx, tables, live)
    })
    let requested = result.unwrap(trigger_commit(take cancellation))
    result.unwrap(store.durable(mut head.db, requested.ticket))
    let boundary = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take check) = take boundary else { return false }
    result.unwrap(trigger_message(mut head, take check, false))
    let inbound = result.unwrap(channel.receive(inbox))
    let TriggerDone(a, take response) = take inbound else { return false }
    result.unwrap(trigger_done(mut head, a, take response, false))
    if let Some(Cancelled) = trigger_law_outcome(head, live) { } else { return false }
    if trigger_law_value(head) != None || !result.unwrap(advance_triggers(mut head)) { return false }
    let step_check = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take step_request) = take step_check else { return false }
    result.unwrap(trigger_message(mut head, take step_request, false))
    let holding = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take hold_request) = take holding else { return false }
    result.unwrap(trigger_message(mut head, take hold_request, false))
    let held_done = result.unwrap(channel.receive(inbox))
    let TriggerDone(held_attempt, take held_response) = take held_done else { return false }
    result.unwrap(trigger_done(mut head, held_attempt, take held_response, false))
    if let Some(_) = trigger_law_outcome(head, held) { return false }
    if result.unwrap(advance_triggers(mut head)) { return false }

    let cancel_held = store.run(mut head.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.request_cancel(mut tx, tables, held)
    })
    let marked = result.unwrap(trigger_commit(take cancel_held))
    result.unwrap(store.durable(mut head.db, marked.ticket))
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if let Some(Cancelled) = trigger_law_outcome(head, held) { } else { return false }
    if result.unwrap(advance_triggers(mut head)) { return false }
    let Head(db: take kept, ..) = take head
    result.unwrap(store.close(take kept))
    true
}

@test
fn journal_test_trigger_cancel(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_trigger_cancel(d, c, r, tasks) { Ok(()) } else { Error(()) }
}

// ---- The publisher, on its one inbox. A Release with a snapshot runs one G2 round to it
// and moves the base there. Each owner's diff or Reset travels with all its
// owed answers in one update (G1). A Release without a snapshot carries commitless
// answers at the base (V3). A Subscribe runs at the base (G3), in its place among Releases.
//
// The publisher never blocks on a session (L23): every send to an owner is a try_send. A
// closed inbox drops that session's subs. A full one marks each live sub whose content did
// not fit due for repair (§3 "Repair"), with no Ended and no Reset: `due` says some sub of
// the session is due. On the owner's progress the publisher reruns each due sub at its base
// and sends its whole image as a `complete`. A bounced Ended (or Reset) and bounced answers
// wait until the inbox takes them, retried at the current base with any new content.
// `ended_at` is the oldest computation version among `ended` (u64::MAX when empty): a waiting
// Ended keeps the version it was computed at when it is folded into later content.
// v2.22: `handed` counts the `complete`s the owner's inbox took, and `taken` is the owner's
// count of those it no longer holds unsent; a due session is repaired only when they agree.
type Joiner { who: u64, to: Sender[WireEvent], closed: Option[Receiver[()]], ended: List[(u32, u64, Outcome)], ended_at: u64, reset: bool, mark: Option[Receiver[()]], identity: Option[Latest[OwnerNumber]], fence: Option[FenceSet], due: bool, progress: Option[Receiver[()]], progressed: bool, taken: Option[Latest[Taken]], handed: u64 }

// One try_send to an owner: taken, bounced back by a full inbox, or shut.
type Offered = Took | Bounced(Notice) | Shut

fn offer(to: Sender[WireEvent], take e: Notice) -> Offered {
    match channel.try_send(to, wire_event(FromRunner(take e))) {
        Ok(()) => Took,
        Error(Full(WireEvent(e: FromRunner(take back)))) => Bounced(take back),
        _ => Shut,
    }
}

fn publisher[G: send, H: send](take r: Registry[G, H], take h: H, take base: store.Snapshot, take from: Receiver[PubIn], take register: RoundRegister) -> () waits {
    let mut at = store.version(base)
    let mut b = Board(r: take r, h: take h, base: take base, newest: None, subs: subscriptions())
    let mut joined: List[Joiner] = list.new()
    let mut waiting: List[Replies] = list.new()
    let mut minted = 0u64
    // Declared last, so a trap cleans it first (FAIL-8): R = u64::MAX is published before any
    // owner channel or the inbox closes.
    let mut rounds = take register
    fence_round(mut joined, Fenced(sessions: list.new(), all: false), at, mut rounds)
    // A message taken while coalescing Releases, handled next in inbox order.
    let mut held: Option[PubIn] = None
    loop {
        let got = match replace(mut held, None) {
            Some(take x) => take x,
            None => match channel.receive(from) {
                Ok(take x) => take x,
                Error(_) => return,
            },
        }
        let PubIn(e: take e) = take got
        let mut owes: List[Owe] = list.new()
        match take e {
            Halt => {
                round_disarm(take rounds)
                return
            },
            Released(take rel) => {
                let Release(version: v, snapshot: take snap, answers: take answers) = take rel
                keep_answers(mut waiting, take answers)
                let mut newest = take snap
                let mut newest_at = v
                // G1: drain the Releases queued behind this one, in order, and run one round at
                // the newest snapshot, so a slow publisher coalesces. Every Release's answers are
                // kept. A Drained carries nothing but the pass below, so it joins the run; any
                // other message ends it and is handled next.
                loop {
                    match channel.try_receive(from) {
                        Ok(PubIn(e: Released(take more))) => {
                            let Release(version: mv, snapshot: take ms, answers: take ma) = take more
                            keep_answers(mut waiting, take ma)
                            if let Some(take s) = take ms {
                                newest = Some(take s)
                                newest_at = mv
                            }
                        },
                        Ok(PubIn(e: Drained)) => (),
                        Ok(take other) => { held = Some(take other); break },
                        Error(_) => break,
                    }
                }
                if let Some(take s) = take newest {
                    at = newest_at
                    b.newest = Some(take s)
                    let mut fenced = Fenced(sessions: list.new(), all: false)
                    owes = round(mut b, mut fenced)
                    // G2 step 3: every fence of the round, then R, before anything is offered.
                    fence_round(mut joined, take fenced, newest_at, mut rounds)
                }
            },
            Joined(take j) => {
                let Join(to: take to, told: take told, mark: take mark, closed: take closed, identity: take id, fence: take fence, progress: take progress, taken: take taken, first: take first) = take j
                let wake: Option[Sender[WireEvent]] = match closed { Some(_) => Some(channel.sender(to)), _ => None }
                // A fenced session's Arcs are reserved here (§3 "Admission"); a refusal answers id 0.
                let reserved: Result[Option[FenceSet], Capacity] = match take fence {
                    Some(take root) => match fence_reserve(mut rounds, take root) { Ok(take fences) => Ok(Some(take fences)), Error(c) => Error(c) },
                    None => Ok(None),
                }
                match take reserved {
                    Ok(take fences) => {
                        minted += 1u64
                        list.push(mut joined, Joiner(who: minted, to: take to, closed: take closed, ended: list.new(), ended_at: ROUND_HALTED, reset: false, mark: take mark, identity: take id, fence: take fences, due: false, progress: take progress, progressed: false, taken: take taken, handed: 0u64))
                        let _ = channel.try_send(told, Admit(who: minted, round: latest.handle(rounds.round)))
                        // v2.22: the Subscribe that made the owner join, at this base (G3).
                        if let Some(take f) = take first {
                            let JoinSubscribe(sub: sub, generation: generation, input: take input) = take f
                            publish_wire_subscription(mut b, mut joined, mut owes, minted, sub, generation, take input)
                        }
                    },
                    Error(_) => { let _ = channel.try_send(told, Admit(who: 0u64, round: latest.handle(rounds.round))) },
                }
                if let Some(sender) = wake { let _ = channel.try_send(sender, wire_event(JoinReady)) }
            },
            Subscribed(who, sub, take caller, take key, take arg) =>
                publish_wire_subscription(mut b, mut joined, mut owes, who, sub, 0u64, SubscriptionInput(room: None, key: take key, arg: take arg, caller: take caller)),
            WireSubscribed(who, sub, generation, take input) =>
                publish_wire_subscription(mut b, mut joined, mut owes, who, sub, generation, take input),
            Unsubscribed(who, sub) => { let _ = remove_sub(mut b.subs, who, sub) },
            Left(who) => forget(mut b.subs, mut joined, who),
            // An owner made room (v2.13), or a marked session ended (v2.14): the sweep and the
            // retry below are the whole of it.
            Drained => (),
        }
        sweep(mut b.subs, mut joined)
        repair(mut b, mut joined, mut owes)
        settle(mut b.subs, mut joined, mut waiting, take owes, at)
    }
}

// The sessions a round's read-set hits fence: each named session, or every joined session
// when the round could not tell which (a lost diff resets them all).
type Fenced { sessions: List[u64], all: bool }

// G2 step 3 (§3 "The release check"): publish every fence of round b, then R = b, each from
// its reservation. A publisher that cannot is stopped, which publishes R = u64::MAX as it is
// cleaned (RoundRegister), and the head ends the place when its next Release is refused.
fn fence_round(mut joined: List[Joiner], take fenced: Fenced, b: u64, mut rounds: RoundRegister) {
    let Fenced(sessions: take sessions, all: all) = take fenced
    let mut i = 0u64
    while i < list.len(joined) {
        if all || list.contains(sessions, joined[i].who) {
            if let Some(take held) = replace(mut joined[i].fence, None) {
                let mut fences = take held
                let published = fence_advance(mut fences, b)
                joined[i].fence = Some(take fences)
                if !published { fail("release check: no fence Arc for the round") }
            }
        }
        i += 1u64
    }
    if !round_advance(mut rounds, b, list.len(joined)) { fail("release check: no round Arc for the round") }
}

fn publish_wire_subscription[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], mut owes: List[Owe], who: u64, sub: u32, generation: u64, take input: SubscriptionInput) {
    if let Some(i) = joiner(joined, who) {
        unend(mut joined[i].ended, sub)
        list.push(mut owes, at_base_generation(mut b, who, sub, generation, take input))
    }
}

fn reply_bucket(waiting: List[Replies], owner: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(waiting) {
        if waiting[i].recipient.owner == owner {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn keep_answers(mut waiting: List[Replies], take answers: List[Answer]) {
    for take a in answers {
        let Answer(recipient: take recipient, row: take row) = take a
        match reply_bucket(waiting, recipient.owner) {
            Some(i) => list.push(mut waiting[i].rows, take row),
            None => {
                let mut rows: List[KeyedDone] = list.new()
                list.push(mut rows, take row)
                list.push(mut waiting, Replies(recipient: take recipient, rows: take rows))
            },
        }
    }
}

// A resubscribed sub's waiting Ended is moot: the new Subscribe's Batch replaces it.
fn unend(mut ended: List[(u32, u64, Outcome)], sub: u32) {
    let mut i = 0u64
    while i < list.len(ended) {
        if ended[i].0 == sub {
            let _ = list.remove(mut ended, i)
        } else {
            i += 1u64
        }
    }
}

// Fold the ledger and this round into the same attempt as the owner's pending outcomes.
fn settle(mut subs: Subscriptions, mut joined: List[Joiner], mut waiting: List[Replies], take owes: List[Owe], at: u64) {
    let mut contents = take owes
    // There is one entry per owner. The joined list walks increasing owner numbers.
    list.sort(mut contents, scoped fn(a: Owe, b: Owe) -> Order { std.order.compare(a.session, b.session) })
    let mut content_index = 0u64
    let mut bounced: List[Replies] = list.new()
    let mut i = 0u64
    while i < list.len(joined) {
        let who = joined[i].who
        let closed = match joined[i].closed { Some(from) => match channel.try_receive(from) { Ok(()) => true, _ => false }, _ => false }
        if closed {
            forget(mut subs, mut joined, who)
            continue
        }
        let owner = match joined[i].identity { Some(id) => latest.read(id).number, None => 0u64 }
        let empty = Owe(session: who, version: at, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false)
        while content_index < list.len(contents) && contents[content_index].session < who {
            content_index += 1u64
        }
        let mut next = if content_index < list.len(contents) && contents[content_index].session == who {
            let found = list.set(mut contents, content_index, take empty)
            content_index += 1u64
            take found
        } else {
            take empty
        }
        let old = replace(mut joined[i].ended, list.new())
        let old_at = joined[i].ended_at
        joined[i].ended_at = ROUND_HALTED
        if joined[i].reset || next.reset {
            let _ = replace(mut next.generations, list.new())
            let _ = replace(mut next.complete, list.new())
            let _ = replace(mut next.rows, list.new())
            let _ = replace(mut next.ended, list.new())
            next.reset = true
            end_session(mut subs, who)
            joined[i].due = false
        } else if list.len(old) > 0u64 {
            // A unit is checked at its oldest component (§3).
            if old_at < next.version { next.version = old_at }
            let now = replace(mut next.ended, take old)
            for take ended in now {
                list.push(mut next.ended, take ended)
            }
        }
        joined[i].reset = false
        let (take recipient, take rows) = match reply_bucket(waiting, owner) {
            Some(k) => {
                let Replies(recipient: take r, rows: take rows) = list.remove(mut waiting, k)
                (Some(take r), take rows)
            },
            None => (None, list.new()),
        }
        let has_content = next.reset || list.len(next.complete) > 0u64 || list.len(next.rows) > 0u64 || list.len(next.ended) > 0u64
        if !has_content && list.len(rows) == 0u64 {
            i += 1u64
            continue
        }
        let handing = list.len(next.complete)
        let content = if has_content { Some(take next) } else { None }
        match offer(joined[i].to, update(at, take content, take rows)) {
            Took => { joined[i].handed += handing },
            Shut => {
                forget(mut subs, mut joined, who)
                continue
            },
            Bounced(Notice(e: Updated(Update(version: _, content: take back, outcomes: take outcomes)))) => {
                if let Some(take r) = take recipient {
                    list.push(mut bounced, Replies(recipient: take r, rows: take outcomes))
                }
                if let Some(take o) = take back {
                    overloaded(mut subs, mut joined[i], take o)
                }
            },
            _ => (),
        }
        i += 1u64
    }
    let retry = replace(mut waiting, take bounced)
    for take bucket in retry {
        let Replies(recipient: take recipient, rows: take rows) = take bucket
        if let Bounced(Notice(e: Updated(Update(version: _, content: _, outcomes: take back)))) = offer(recipient.to, update(at, None, take rows)) {
            list.push(mut waiting, Replies(recipient: take recipient, rows: take back))
        }
    }
}

// A full inbox bounced this content: a Reset waits and covers it all; otherwise each live sub
// it named (complete or a row) is due for repair (§3 "Repair") and its Ended subs wait.
fn overloaded(mut subs: Subscriptions, mut j: Joiner, take o: Owe) {
    let Owe(session: who, version: computed, generations: _, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    // A token taken before this bounce never counts after it (§3 "Repair").
    j.progressed = false
    if reset || j.reset {
        j.reset = true
        j.ended = list.new()
        j.ended_at = ROUND_HALTED
        return
    }
    for sub in complete {
        if mark_due(mut subs, who, sub) { j.due = true }
    }
    for r in rows {
        if mark_due(mut subs, who, r.sub) { j.due = true }
    }
    if list.len(ended) == 0u64 { return }
    if computed < j.ended_at { j.ended_at = computed }
    for take x in ended {
        list.push(mut j.ended, take x)
    }
}

// §3 "Repair", before the offers of each pass: every owner's drain token is taken, so a token
// sent before a bounce never counts after it. A due session that progressed (or has no token
// channel) reruns each due sub at the base, with its generation and input, into its owe as a
// complete. Removing the sub drops its old read set: any commit since that read set's run
// that hit it has fenced the session, and if none did the rerun reads the same keys.
fn repair[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], mut owes: List[Owe]) {
    let at = store.version(b.base)
    let mut i = 0u64
    while i < list.len(joined) {
        let took = match joined[i].progress {
            Some(from) => match channel.try_receive(from) { Ok(()) => true, _ => false },
            None => true,
        }
        if took { joined[i].progressed = true }
        if joined[i].due && joined[i].progressed && !joined[i].reset && caught_up(joined[i]) {
            joined[i].due = false
            joined[i].progressed = false
            let who = joined[i].who
            for sub in due_subs(b.subs, who) {
                let Some(take old) = remove_sub(mut b.subs, who, sub) else { continue }
                let Sub(generation: generation, input: take input, cover: _, routes: _, due: _) = take old
                let fresh = at_base_generation(mut b, who, sub, generation, take input)
                let k = owe(mut owes, who, at)
                merge_owe(mut owes[k], take fresh)
            }
        }
        i += 1u64
    }
}

// v2.22 (§3 "Repair"): the owner holds no `complete` it took and has not sent. A session with
// no taken register (the HTTP and one-shot sessions) is always caught up.
fn caught_up(j: Joiner) -> bool {
    match j.taken { Some(t) => latest.read(t).n >= j.handed, None => true }
}

fn merge_owe(mut into: Owe, take from: Owe) {
    let Owe(session: _, version: v, generations: take generations, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take from
    if v < into.version { into.version = v }
    if reset { into.reset = true }
    for g in generations { list.push(mut into.generations, g) }
    for sub in complete { list.push(mut into.complete, sub) }
    for take r in rows { list.push(mut into.rows, take r) }
    for take e in ended { list.push(mut into.ended, take e) }
}

fn joiner(joined: List[Joiner], who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(joined) {
        if joined[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

// v2.14: after every message but Halt, in join order, a marked session whose mark answers
// Closed has ended, and is retired: its subscriptions, its ledger and mark (in its Joiner)
// go. The retry pass that follows drops its waiting replies, whose inbox is closed (Shut).
fn sweep(mut subs: Subscriptions, mut joined: List[Joiner]) {
    let mut i = 0u64
    while i < list.len(joined) {
        let ended = match joined[i].mark {
            Some(m) => match channel.try_receive(m) {
                Error(Closed) => true,
                _ => false,
            },
            None => false,
        }
        if ended {
            let who = joined[i].who
            forget(mut subs, mut joined, who)
        } else {
            i += 1u64
        }
    }
}

fn forget_subs(mut subs: Subscriptions, who: u64) {
    if let Some(take group) = map.remove(mut subs.by_session, who) {
        for (_, sub) in group { unregister_routes(mut subs.root, sub.routes) }
    }
}

fn forget(mut subs: Subscriptions, mut joined: List[Joiner], who: u64) {
    forget_subs(mut subs, who)
    if let Some(j) = joiner(joined, who) {
        let _ = list.remove(mut joined, j)
    }
}

// ---- §3: publisher delivery to the wire owner.

// One publisher update carries the owner's forwarded positions and subscription content.
type Update: send { version: u64, content: Option[Owe], outcomes: List[KeyedDone] }

fn update(at: u64, take content: Option[Owe], take outcomes: List[KeyedDone]) -> Notice {
    Notice(e: Updated(Update(version: at, content: take content, outcomes: take outcomes)))
}

pub fn head_request(take author: Caller, take stream: Bytes, p: u64, take key: Bytes, take arg: Bytes, take reply_to: Sender[WireEvent]) -> Req {
    let digest = store.request_digest(key, arg)
    let alive = arc.new(HeadLife(active: true))
    let live = latest.new(take alive)
    let blank = arc.new(OwnerNumber(number: 0u64))
    let identity = latest.new(take blank)
    let seed = arc.new(OwnerNumber(number: 0u64))
    Req(e: Requested(Request(caller: take author, stream: take stream, p: p, key: take key, arg: take arg, digest: digest,
        deadline: 18446744073709551615u64, reply_to: take reply_to, live: take live, identity: take identity, seed: Some(take seed))))
}

pub fn head_outcome(take event: WireEvent) -> Option[KeyedDone] {
    let WireEvent(e: take input) = take event
    let FromRunner(Notice(e: take notice)) = take input else { return None }
    match take notice {
        Updated(Update(outcomes: take outcomes, ..)) if list.len(outcomes) == 1u64 => {
            let mut rows = take outcomes
            Some(list.remove(mut rows, 0u64))
        },
        _ => None,
    }
}

// What a session hands its client, before the wire Frame (WIRE-SPEC §3): the Frame's Batch,
// Ended and Reset with each answered send named by the store's stream key, until R3 gives
// sessions stream slots. A KeyedBatch at `version` names in `complete` each sub whose whole
// initial result it carries (F11), and carries the wire's subscription Rows (F10: the
// data-tree key and the published value at `version`, None for a removal) and KeyedDone
// rows, one per send answered.
pub type KeyedDone: send { stream: Bytes, p: u64, outcome: Outcome }

pub type KeyedBatch: send { version: u64, complete: List[u32], rows: List[Row], outcomes: List[KeyedDone] }

pub type Down: send = Batched(KeyedBatch) | Ended(u32, Outcome) | KeyedReset(u64, List[KeyedDone])

pub opaque type Tick: send { stream: Bytes, p: u64, generation: u64 }

// The wire owner receives publisher answers, subscription content and deadline timers
// through the same WireEvent inbox as its reader and writer.
type PublisherEvent: send = Updated(Update) | Expired(Tick)

type HeadLife: shareable + send { active: bool }

// Only the head assigns a number. The publisher and every subscription join can
// read the same number, including after a wire Reset replaced its Joiner.
type OwnerNumber: shareable + send { number: u64 }

resource type HeadLease: send { head: WireHead, live: Latest[HeadLife], dead: Arc[HeadLife], identity: Latest[OwnerNumber] } drop(lease) {
    latest.publish(lease.live, arc.share(lease.dead))
    if latest.read(lease.identity).number != 0u64 {
        let _ = try_head(lease.head, Req(e: OwnerLeft))
    }
}

fn head_lease(take head: WireHead) -> Result[HeadLease, Capacity] {
    let alive = arc.new(HeadLife(active: true))
    let dead = arc.new(HeadLife(active: false))
    let live = latest.new(take alive)
    let blank = arc.new(OwnerNumber(number: 0u64))
    let identity = latest.new(take blank)
    Ok(HeadLease(head: take head, live: take live, dead: take dead, identity: take identity) ?=> |(c, _)| c)
}

fn owner_seed(lease: HeadLease) -> Result[Option[Arc[OwnerNumber]], Capacity] {
    if latest.read(lease.identity).number != 0u64 {
        return Ok(None)
    }
    let blank = arc.new(OwnerNumber(number: 0u64))
    Ok(Some(take blank))
}

pub opaque type Notice: send { e: PublisherEvent }

// v2.14: a marked session's joiner. A failed or cancelled session skipped its own end, so
// whatever the outcome, the joiner offers the publisher one Drained, never waiting.
pub fn join_marked[R: send](take t: Task[R], to_publisher: Sender[PubIn]) -> Result[R, JoinError] waits {
    let got = task.join(take t)
    let _ = channel.try_send(to_publisher, PubIn(e: Drained))
    got
}

fn slot_key(stream: Bytes, p: u64) -> Bytes {
    let mut k: Bytes = list.with_capacity(list.len(stream) + 8u64)
    list.append(mut k, stream)
    std.codec.put_u64(p, mut k)
    k
}

// The publisher's content for this session: one Batch with its complete subs and rows (G3:
// a sub's whole initial result in the Batch that names it), then its Ended subs; or a Reset.
// `dropped` holds the subs whose Unsubscribe met a full PubIn (v2.12 item 3): the publisher
// keeps them, and the owner drops their rows and Endeds until a Batch completes the sub's
// resubscription, an Ended ends it, or a Reset ends them all.
fn hand(to: Sender[Down], take o: Owe, mut dropped: List[u32], take outcomes: List[KeyedDone]) -> () waits {
    let Owe(session: _, version: v, generations: _, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    if reset {
        list.clear(mut dropped)
        let _ = channel.send(to, KeyedReset(v, take outcomes))
        return
    }
    for sub in complete {
        forgive(mut dropped, sub)
    }
    let heard = unheard(take rows, dropped)
    if list.len(complete) > 0u64 || list.len(heard) > 0u64 || list.len(outcomes) > 0u64 {
        let _ = channel.send(to, Batched(KeyedBatch(version: v, complete: take complete, rows: take heard, outcomes: take outcomes)))
    }
    for take e in take ended {
        let (sub, _, take why) = take e
        if has_sub(dropped, sub) {
            forgive(mut dropped, sub)
        } else {
            let _ = channel.send(to, Ended(sub, take why))
        }
    }
}

fn has_sub(subs: List[u32], sub: u32) -> bool {
    for s in subs {
        if s == sub {
            return true
        }
    }
    false
}

fn forgive(mut dropped: List[u32], sub: u32) {
    let mut i = 0u64
    while i < list.len(dropped) {
        if dropped[i] == sub {
            let _ = list.remove(mut dropped, i)
        } else {
            i += 1u64
        }
    }
}

// The rows of subs not in `dropped`.
fn unheard(take rows: List[Row], dropped: List[u32]) -> List[Row] {
    if list.len(dropped) == 0u64 {
        return take rows
    }
    let mut kept: List[Row] = list.new()
    for take w in take rows {
        if !has_sub(dropped, w.sub) {
            list.push(mut kept, take w)
        }
    }
    kept
}

// A session owner's inbox capacity: C, the run of takes after which a joined owner wakes the
// publisher (v2.13).
const INBOX: u64 = 64u64

// ---- R2's subscription law (RUNNER-SPEC §8.2: subs25's main_two_sessions, as hand-written
// steps). Table "data" holds perm (key 0), row0 (key 1) and row1 (key 2). Q1 reads perm and,
// when it is not 0, covers row0 and row1; otherwise it covers nothing. Qf reads row1 and
// covers it, and faults when row1 is 2. The client applies each owe to its cache per
// (session, sub); the expected caches are written out by hand from the store's values at each
// version, as a from-scratch run of the query would give them (K1), never from the publisher.
// A value is the u64 codec's 8 bytes little-endian (codec.md), so `word` is the oracle's.
type Qh: send { t: store.Shape[u64, u64] }

fn q1(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    let allowed = match store.fetch(tx, h.t, 0u64) {
        Ok(Some(p)) => p != 0u64,
        Ok(None) => false,
        Error(_) => fail("subs: q1 reads perm"),
    }
    if allowed {
        cover(h.t, Included(1u64), Included(2u64))
    } else {
        cover(h.t, Included(1u64), Excluded(1u64))
    }
}

fn qf(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    match store.fetch(tx, h.t, 2u64) {
        Ok(Some(v)) => if v == 2u64 {
            fail("subs: qf at row1 = 2")
        },
        _ => (),
    }
    cover(h.t, Included(2u64), Included(2u64))
}

// q_late reads row1 and covers it. When row1 is 2 it also reads perm, then faults, so its
// partial read log holds a key its last good run never read.
fn q_late(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    match store.fetch(tx, h.t, 2u64) {
        Ok(Some(v)) => if v == 2u64 {
            let _ = store.fetch(tx, h.t, 0u64)
            fail("subs: q_late at row1 = 2")
        },
        _ => (),
    }
    cover(h.t, Included(2u64), Included(2u64))
}

fn q_moving(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    let selector = option.unwrap(result.unwrap(store.fetch(tx, h.t, 0u64)))
    let key = if selector == 0u64 {
        3u64
    } else {
        4u64
    }
    let mut scan = match store.range(tx, h.t, Included(key), Excluded(key + 1u64)) {
        Ok(take rows) => take rows,
        Error(_) => fail("subs: q_moving range")
    }
    let chosen = match result.unwrap(store.next_range(mut scan)) {
        Some((_, _)) => 2u64,
        None => 1u64
    }
    cover(h.t, Included(chosen), Included(chosen))
}

fn q_range_prefix(tx: store.Tx, h: Qh, take limit: u32) -> Result[Cover, Capacity] {
    let mut rows = match store.range(tx, h.t, Included(1u64), Excluded(10u64)) {
        Ok(take cursor) => take cursor,
        Error(_) => fail("subs: prefix range")
    }
    let mut key = 0u64
    for _ in 0u64 .. int.widen(limit) {
        match result.unwrap(store.next_range(mut rows)) {
            Some((k, _)) => {
                key = k
            },
            None => {
                break
            }
        }
    }
    cover(h.t, Included(key), Included(key))
}

fn subs_place(mut r: Registry[(), Qh]) -> Result[(), RegisterError] {
    query(mut r, code.describe(q1), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(qf), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(q_late), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(q_moving), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(q_range_prefix), 65536u64, DEFAULT_STEPS)
}

fn subs_handles(mut db: store.Db) -> Result[Qh, store.Error] waits {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let t = store.table(mut db, "data", std.codec.key_u64(), cv)?
    Ok(Qh(t: store.shape(t)))
}

fn query_key(f: StaticFn[fn(store.Tx, Qh, take u32) -> Result[Cover, Capacity]]) -> Bytes {
    let ca: std.codec.Codec[u32] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take k, _) = result.unwrap(described(code.identity(f), None, Query, ca, cr))
    k
}

fn no_arg() -> Bytes {
    let ca: std.codec.Codec[u32] = std.codec.of()
    let mut a: Bytes = list.new()
    result.unwrap(std.codec.encode(ca, 0u32, mut a))
    a
}

fn word(v: u8) -> Bytes {
    let mut out: Bytes = list.new()
    list.push(mut out, v)
    for _ in 0u64 .. 7u64 {
        list.push(mut out, 0u8)
    }
    out
}

fn set(mut db: store.Db, t: store.Table[u64, u64], k: u64, v: u64) -> () waits {
    let done = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, t, k, v)
    })
    match take done {
        Ok(Committed(_)) => (),
        _ => fail("subs: a fixture put"),
    }
}

type Cached { who: u64, sub: u32, rows: Map[Bytes, Bytes] }

type Client { caches: List[Cached], last: List[(u64, u64)] }

fn cached(c: Client, who: u64, sub: u32) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who && c.caches[i].sub == sub {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn drop_cache(mut c: Client, who: u64, sub: u32) {
    if let Some(i) = cached(c, who, sub) {
        let _ = list.remove(mut c.caches, i)
    }
}

// The client's side of one owe: versions never decrease (K2); a complete sub starts its cache
// empty; a row for a sub with no cache is a row before its complete (L17).
fn apply(mut c: Client, take o: Owe) -> bool {
    let mut seen = false
    let mut i = 0u64
    while i < list.len(c.last) {
        if c.last[i].0 == o.session {
            if o.version < c.last[i].1 {
                return false
            }
            c.last[i].1 = o.version
            seen = true
        }
        i += 1u64
    }
    if !seen {
        list.push(mut c.last, (o.session, o.version))
    }
    if o.reset {
        while let Some(j) = first_of(c, o.session) {
            let _ = list.remove(mut c.caches, j)
        }
        return true
    }
    for sub in o.complete {
        drop_cache(mut c, o.session, sub)
        list.push(mut c.caches, Cached(who: o.session, sub: sub, rows: map.new()))
    }
    let Owe(session: who, version: _, generations: _, complete: _, rows: take rows, ended: take ended, reset: _) = take o
    for take row in rows {
        let Row(sub: sub, key: take key, value: take value) = take row
        let k = match cached(c, who, sub) {
            Some(k) => k,
            None => return false,
        }
        let _ = map.remove(mut c.caches[k].rows, key)
        if let Some(take v) = take value {
            map.insert(mut c.caches[k].rows, take key, take v)
        }
    }
    for e in ended {
        drop_cache(mut c, who, e.0)
    }
    true
}

fn first_of(c: Client, who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn apply_all(mut c: Client, take owes: List[Owe]) -> bool {
    for take o in owes {
        if !apply(mut c, take o) {
            return false
        }
    }
    true
}

// The cache of (who, sub) holds exactly row0 and row1 (keys[1], keys[2]) with these values;
// None leaves a row out.
fn holds(c: Client, keys: List[Bytes], who: u64, sub: u32, row0: Option[u8], row1: Option[u8]) -> bool {
    let k = match cached(c, who, sub) {
        Some(k) => k,
        None => return false,
    }
    let rows = c.caches[k].rows
    let mut n = 0u64
    if let Some(v) = row0 {
        n += 1u64
        match map.get(rows, keys[1]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    if let Some(v) = row1 {
        n += 1u64
        match map.get(rows, keys[2]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    map.len(rows) == n
}

fn step_held[G: send, H: send](mut b: Board[G, H]) -> List[Owe] {
    let mut fenced = Fenced(sessions: list.new(), all: false)
    round(mut b, mut fenced)
}

fn step[G: send, H: send](mut b: Board[G, H], db: store.Db) -> List[Owe] {
    b.newest = Some(store.snapshot(db))
    let mut fenced = Fenced(sessions: list.new(), all: false)
    round(mut b, mut fenced)
}

pub fn law_subs_main(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    let empty = store.snapshot(db)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let mut keys: List[Bytes] = list.new()
    for ch in result.unwrap(store.changes(empty, base)) {
        list.push(mut keys, clone(ch.tree_key))
    }
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let mut b = Board(r: take reg, h: take h, base: take base, newest: None, subs: subscriptions())
    let mut cl = Client(caches: list.new(), last: list.new())
    let k1 = query_key(code.describe(q1))
    let kf = query_key(code.describe(qf))
    // subscribe_at_latest: w0 commits and is released, then session 0 subscribes Q1 before the
    // round. Its result is the base's (row0 = 0), labelled with the base.
    set(mut db, t, 1u64, 1u64)
    b.newest = Some(store.snapshot(db))
    let first = at_base(mut b, 0u64, 1u32, clone(k1), no_arg())
    if first.version != 4u64 || list.len(first.complete) != 1u64 || !apply(mut cl, take first) || !holds(cl, keys, 0u64, 1u32, Some(0u8), Some(0u8)) {
        return false
    }
    if !apply_all(mut cl, step_held(mut b)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(0u8)) {
        return false
    }
    // shared_cache: session 1 subscribes Q1 with the same sub id; session 0 subscribes Qf.
    // Then row1 = 5 is a cover change for both Q1s and a re-run for Qf.
    if !apply(mut cl, at_base(mut b, 1u64, 1u32, clone(k1), no_arg())) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(0u8)) {
        return false
    }
    if !apply(mut cl, at_base(mut b, 0u64, 2u32, clone(kf), no_arg())) || !holds(cl, keys, 0u64, 2u32, None, Some(0u8)) {
        return false
    }
    set(mut db, t, 2u64, 5u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 0u64, 2u32, None, Some(5u8)) {
        return false
    }
    // rerun_without_retract: revoke re-runs both Q1s, whose Covers become empty, so both lose
    // row0 and row1. A Subscribe of Q1 now completes with an empty result (L17).
    set(mut db, t, 0u64, 0u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, None, None) || !holds(cl, keys, 1u64, 1u32, None, None) || !holds(cl, keys, 0u64, 2u32, None, Some(5u8)) {
        return false
    }
    let empty_result = at_base(mut b, 1u64, 3u32, clone(k1), no_arg())
    if list.len(empty_result.complete) != 1u64 || empty_result.complete[0] != 3u32 || list.len(empty_result.rows) != 0u64 || !apply(mut cl, take empty_result) {
        return false
    }
    // K7: grant, then the call's row1 = 2. Qf's re-run faults and ends Qf alone, with
    // Failed(Raised(5)) (Fail); session 0's Q1 follows row1 by its Cover.
    set(mut db, t, 0u64, 1u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 1u64, 3u32, Some(1u8), Some(5u8)) {
        return false
    }
    set(mut db, t, 2u64, 2u64)
    let owes = step(mut b, db)
    let mut faulted = false
    for o in owes {
        for e in o.ended {
            faulted = o.session == 0u64 && e.0 == 2u32 && match e.2 {
                Failed(Raised(n)) => n == 5u32,
                _ => false,
            }
        }
    }
    if !faulted || !apply_all(mut cl, take owes) || cached(cl, 0u64, 2u32) != None || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(2u8)) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(2u8)) {
        return false
    }
    // Moving the selector invalidates the Point and moves the read Span from [4,5) to
    // [3,4). A write at the old lower bound must miss both Spans. The new lower bound
    // must rerun the query and move its Cover from row0 to row1.
    let moving = at_base(mut b, 2u64, 1u32, query_key(code.describe(q_moving)), no_arg())
    if !apply(mut cl, take moving) || !holds(cl, keys, 2u64, 1u32, Some(1u8), None) { return false }
    set(mut db, t, 0u64, 0u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 2u64, 1u32, Some(1u8), None) { return false }
    set(mut db, t, 4u64, 20u64)
    if list.len(step(mut b, db)) != 0u64 { return false }
    set(mut db, t, 3u64, 21u64)
    apply_all(mut cl, step(mut b, db)) && holds(cl, keys, 2u64, 1u32, None, Some(2u8))
}

fn range_limit(n: u32) -> Bytes {
    let mut out: Bytes = list.new()
    std.codec.put_u32(n, mut out)
    take out
}

// A tail insert misses a prefix subscription but hits a cursor that received
// None. An insert before the prefix's first row also changes its Cover.
pub fn law_range_reruns(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv = std.codec.of_u64()
    result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 3, 30)
    set(mut db, t, 7, 70)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576))
    let h = result.unwrap(subs_handles(mut db))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    let _ = at_base(mut b, 1, 1, query_key(code.describe(q_range_prefix)), range_limit(1))
    let _ = at_base(mut b, 2, 1, query_key(code.describe(q_range_prefix)), range_limit(8))
    set(mut db, t, 8, 80)
    let delta = result.unwrap(store.changes(b.base, store.snapshot(db)))
    let hits = result.unwrap(affected_subscriptions(b.subs, delta))
    if list.len(hits) != 1 || hits[0].0 .who != 2 || !hits[0].1 {
        return false
    }
    let updated = step(mut b, db)
    if list.len(updated) != 1 || updated[0].session != 2 {
        return false
    }
    set(mut db, t, 2, 20)
    let changed = result.unwrap(store.changes(b.base, store.snapshot(db)))
    let reruns = result.unwrap(affected_subscriptions(b.subs, changed))
    if list.len(reruns) != 2 || !reruns[0].1 || !reruns[1].1 {
        return false
    }
    let projected = step(mut b, db)
    if list.len(projected) != 2 {
        return false
    }
    for owed in projected {
        if owed.session == 1 {
            if list.len(owed.rows) != 2 {
                return false
            }
        } else if owed.session != 2 || list.len(owed.rows) != 0 {
            return false
        }
    }
    true
}

@test
fn test_range_reruns(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_range_reruns(c, r) {
        Ok(())
    } else {
        Error(())
    }
}

pub fn law_subs_reset_keeps_diff(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    let h = result.unwrap(subs_handles(mut db))
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    let _ = at_base(mut b, 1u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 2u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 3u64, 1u32, query_key(code.describe(q1)), no_arg())
    let schema = 7u64
    let rejected = fn(_ch: store.Change) -> Result[Option[Bytes], store.Error] { Error(Schema(schema)) }
    let value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error] = take rejected
    let mut next = Some(take value)
    let _ = map.update(mut b.subs.by_session, 2u64, scoped fn(mut group: Map[u32, Sub]) {
        let _ = map.update(mut group, 1u32, scoped fn(mut entry: Sub) {
            let mut kept = option.unwrap(replace(mut entry.cover, None))
            kept.value = option.unwrap(replace(mut next, None))
            entry.cover = Some(take kept)
        })
    })
    set(mut db, t, 1u64, 7u64)
    let owes = step(mut b, db)
    list.len(owes) == 3u64
        && owes[0].session == 1u64 && list.len(owes[0].rows) == 1u64
        && owes[1].session == 2u64 && owes[1].reset
        && owes[2].session == 3u64 && list.len(owes[2].rows) == 1u64
}

@test
fn test_subs_reset_keeps_diff(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_subs_reset_keeps_diff(c, r) { Ok(()) } else { Error(()) }
}

// L22 (RUNNER-SPEC v2.12, subscribe_order): a Subscribe runs at the version of the last
// Released taken before it in PubIn's order, and each later Release reaches it in a round.
// The publisher's own loop drains one inbox filled in that order: Joined, c1's Release, the
// Subscribe, c2's Release, a Release outside the sub's reads, Halt. Sub 1's initial result
// holds c1 (row 1 = 1, row 2 = 0) at c1's version. The two later Releases are queued
// together, so G1 coalesces them (v2.23): c2 (row 2 = 7) follows in one round at the newest
// version.
pub fn law_subscribe_order(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    let empty = store.snapshot(db)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let mut keys: List[Bytes] = list.new()
    for ch in result.unwrap(store.changes(empty, base)) {
        list.push(mut keys, clone(ch.tree_key))
    }
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 1u64)
    let c1 = store.snapshot(db)
    set(mut db, t, 2u64, 7u64)
    let c2 = store.snapshot(db)
    set(mut db, t, 4u64, 1u64)
    let outside = store.snapshot(db)
    let v1 = store.version(c1)
    let v2 = store.version(c2)
    let v3 = store.version(outside)
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ev_to, ev_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let (told_to, told_from): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    let mut queue: List[ToPub] = list.new()
    list.push(mut queue, Joined(Join(to: take ev_to, told: take told_to, mark: None, closed: None, identity: None, fence: None, progress: None, taken: None, first: None)))
    list.push(mut queue, Released(Release(version: v1, snapshot: Some(take c1), answers: list.new())))
    list.push(mut queue, Subscribed(1u64, 1u32, law_caller(1u64), query_key(code.describe(q1)), no_arg()))
    list.push(mut queue, Released(Release(version: v2, snapshot: Some(take c2), answers: list.new())))
    list.push(mut queue, Released(Release(version: store.version(outside), snapshot: Some(take outside), answers: list.new())))
    list.push(mut queue, Halt)
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    publisher(take reg, take h, take base, take from, take rounds)
    match channel.try_receive(told_from) {
        Ok(a) => if a.who != 1u64 { return false },
        _ => return false,
    }
    let mut cl = Client(caches: list.new(), last: list.new())
    let mut n = 0u64
    while let Ok(take x) = channel.try_receive(ev_from) {
        let Notice(e: take e) = publisher_notice(take x)
        let o = match take e {
            Updated(Update(version: _, content: Some(take o), outcomes: _)) => take o,
            _ => return false,
        }
        let ok = if n == 0u64 {
            o.version == v1 && list.len(o.complete) == 1u64 && apply(mut cl, take o) && holds(cl, keys, 1u64, 1u32, Some(1u8), Some(0u8))
        } else {
            o.version == v3 && list.len(o.complete) == 0u64 && apply(mut cl, take o) && holds(cl, keys, 1u64, 1u32, Some(1u8), Some(7u8))
        }
        if !ok {
            return false
        }
        n += 1u64
    }
    n == 2u64
}

// L25 (RUNNER-SPEC v2.14, retired_without_waiting): a marked session's end waits on nothing,
// and after the next message the publisher takes, Released or not, that session's
// subscriptions, Joiner (its ledger and mark) and waiting replies are gone; a live session is
// unchanged by every sweep. The oracle is the state itself, in place of §8's retained-bytes
// figure (followups.md, 2026-11-17): a closed event channel for the publisher's Joiner, the
// Board's subs and the waiting list for the sweep, and the Drained messages on PubIn for the
// session's end.
pub fn law_retired_without_waiting(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    retired_at_publisher(c, r, tasks, true) && retired_at_publisher(c, r, tasks, false) && retired_state(c, r) && retired_session(c, r, tasks, 0u64) && retired_session(c, r, tasks, 1u64) && retired_session(c, r, tasks, 2u64) && retired_session(c, r, tasks, 3u64)
}

// A session joins the publisher and is told its id (0 if it could not): a sync point that is
// not a Released, since the publisher has taken every message sent before it.
fn join_as(to: Sender[PubIn], take ev: Sender[WireEvent], take mark: Option[Receiver[()]]) -> u64 waits {
    join_with(to, take ev, take mark, None)
}

fn join_with(to: Sender[PubIn], take ev: Sender[WireEvent], take mark: Option[Receiver[()]], take progress: Option[Receiver[()]]) -> u64 waits {
    let (told, hear): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: take ev, told: take told, mark: take mark, closed: None, identity: None, fence: None, progress: take progress, taken: None, first: None)))) {
        return 0u64
    }
    match channel.receive(hear) {
        Ok(a) => a.who,
        Error(_) => 0u64,
    }
}

// Takes every event `from` holds: each Content's version, and whether any names `sub`.
// True if the channel is then closed, false if it is only empty.
fn drain_content(from: Receiver[WireEvent], mut versions: List[u64], sub: u32, mut named: bool) -> bool {
    loop {
        match channel.try_receive(from) {
            Ok(take x) => {
                let Notice(e: take e) = publisher_notice(take x)
                if let Updated(Update(version: _, content: Some(take o), outcomes: _)) = take e {
                    for s in o.complete {
                        named = named || s == sub
                    }
                    for w in o.rows {
                        named = named || w.sub == sub
                    }
                    list.push(mut versions, o.version)
                }
            },
            Error(Empty) => return false,
            Error(Closed) => return true,
        }
    }
}

// The publisher, as a task. Marked sessions L and M and an unmarked filler F join; L and M
// subscribe sub 1, and both take c1's round. M's mark then closes in a quiet place, and the
// next message is M's wake (woken) or, with the wake dropped, F's Unsubscribe followed by M's
// queued Subscribe of sub 2. After that and a Joined, with no Released between, M's event
// channel holds its two contents and is closed (its Joiner is gone), and sub 2 registered
// nothing. Then c2's round reaches L.
fn retired_at_publisher(c: Clock, r: Random, tasks: Tasks, woken: bool) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let v0 = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 1u64)
    let c1 = store.snapshot(db)
    set(mut db, t, 2u64, 7u64)
    let c2 = store.snapshot(db)
    let v1 = store.version(c1)
    let v2 = store.version(c2)
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let p = Publish(place: code.describe(subs_place), n_place: 1048576u64, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready_to)
    let publishing = task.spawn(tasks, bytes 8388608u64, take p, publish)
    match channel.receive(ready_from) {
        Ok(None) => (),
        _ => return false,
    }
    let (l_to, l_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(16u64)
    let (l_send, l_mark): (Sender[()], Receiver[()]) = channel.new(1u64)
    let mut l_keep = Some(take l_send)
    let l = join_as(to, take l_to, Some(take l_mark))
    let (m_to, m_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(16u64)
    let (m_send, m_mark): (Sender[()], Receiver[()]) = channel.new(1u64)
    let mut m_keep = Some(take m_send)
    let m = join_as(to, take m_to, Some(take m_mark))
    let (f_to, f_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(16u64)
    let f = join_as(to, take f_to, None)
    let k1 = query_key(code.describe(q1))
    let mut queue: List[ToPub] = list.new()
    list.push(mut queue, Subscribed(l, 1u32, law_caller(l), clone(k1), no_arg()))
    list.push(mut queue, Subscribed(m, 1u32, law_caller(m), clone(k1), no_arg()))
    list.push(mut queue, Released(Release(version: v1, snapshot: Some(take c1), answers: list.new())))
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (g_to, g_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let g = join_as(to, take g_to, None)
    // M ends: its mark's only Sender goes. Nothing is Released until M's channel is read.
    m_keep = None
    let mut quiet: List[ToPub] = list.new()
    if woken {
        list.push(mut quiet, Drained)
    } else {
        list.push(mut quiet, Unsubscribed(f, 9u32))
        list.push(mut quiet, Subscribed(m, 2u32, law_caller(m), clone(k1), no_arg()))
    }
    for take e in quiet {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (n_to, n_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let n = join_as(to, take n_to, None)
    let mut mv: List[u64] = list.new()
    let mut m2 = false
    let m_closed = drain_content(m_from, mut mv, 2u32, mut m2)
    if !m_closed || m2 || list.len(mv) != 2u64 || mv[0] != v0 || mv[1] != v1 {
        return false
    }
    if let Error(_) = channel.send(to, PubIn(e: Released(Release(version: v2, snapshot: Some(take c2), answers: list.new())))) {
        return false
    }
    let (k_to, k_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let k = join_as(to, take k_to, None)
    let mut lv: List[u64] = list.new()
    let mut l2 = false
    let l_closed = drain_content(l_from, mut lv, 2u32, mut l2)
    if l_closed || l2 || list.len(lv) != 3u64 || lv[0] != v0 || lv[1] != v1 || lv[2] != v2 {
        return false
    }
    if let Error(_) = channel.send(to, PubIn(e: Halt)) {
        return false
    }
    let stopped = match task.join(take publishing) {
        Ok(_) => true,
        Error(_) => false,
    }
    l_keep = None
    let _ = (f_from, g_from, n_from, k_from)
    stopped && l != 0u64 && m != 0u64 && f != 0u64 && g != 0u64 && n != 0u64 && k != 0u64 && none(l_keep) && none(m_keep)
}

// The sweep's own state: session 2's mark is closed, session 1's is open. One sweep and the
// retry pass leave session 1's sub and Joiner, and remove session 2's two subs, its Joiner
// (with its waiting Ended and its mark) and its waiting Told.
fn retired_state(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    let base = store.snapshot(db)
    let at = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let mut b = Board(r: take reg, h: take h, base: take base, newest: None, subs: subscriptions())
    let k1 = query_key(code.describe(q1))
    let _ = at_base(mut b, 1u64, 1u32, clone(k1), no_arg())
    let _ = at_base(mut b, 2u64, 1u32, clone(k1), no_arg())
    let _ = at_base(mut b, 2u64, 2u32, clone(k1), no_arg())
    let (l_send, l_mark): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (m_send, m_mark): (Sender[()], Receiver[()]) = channel.new(1u64)
    let mut m_keep = Some(take m_send)
    m_keep = None
    let (l_to, l_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(4u64)
    let (m_to, m_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(4u64)
    let m_told = channel.sender(m_to)
    let mut m_inbox = Some(take m_from)
    m_inbox = None
    let mut ended: List[(u32, u64, Outcome)] = list.new()
    list.push(mut ended, (1u32, 0u64, Refused(Overloaded)))
    let mut joined: List[Joiner] = list.new()
    list.push(mut joined, Joiner(who: 1u64, to: take l_to, closed: None, ended: list.new(), ended_at: ROUND_HALTED, reset: false, mark: Some(take l_mark), identity: None, fence: None, due: false, progress: None, progressed: false, taken: None, handed: 0u64))
    list.push(mut joined, Joiner(who: 2u64, to: take m_to, closed: None, ended: take ended, ended_at: ROUND_HALTED, reset: false, mark: Some(take m_mark), identity: None, fence: None, due: false, progress: None, progressed: false, taken: None, handed: 0u64))
    let mut outcomes: List[KeyedDone] = list.new()
    list.push(mut outcomes, KeyedDone(stream: no_arg(), p: 0u64, outcome: Refused(Overloaded)))
    let mut waiting: List[Replies] = list.new()
    list.push(mut waiting, Replies(recipient: Recipient(owner: 2u64, to: take m_told), rows: take outcomes))
    sweep(mut b.subs, mut joined)
    settle(mut b.subs, mut joined, mut waiting, list.new(), at)
    let _ = (l_send, l_from)
    map.len(b.subs.by_session) == 1u64 && map.contains(b.subs.by_session, 1u64) && list.len(joined) == 1u64 && joined[0].who == 1u64 && list.len(waiting) == 0u64 && none(m_keep) && none(m_inbox)
}

fn none[T](x: Option[T]) -> bool {
    match x {
        Some(_) => false,
        None => true,
    }
}

// The Drained messages `from` holds now; any other message counts as many.
fn drained(from: Receiver[PubIn]) -> u64 {
    let mut n = 0u64
    while let Ok(take x) = channel.try_receive(from) {
        let PubIn(e: take e) = take x
        n += match take e {
            Drained => 1u64,
            _ => 1000u64,
        }
    }
    n
}

fn is_ended(take d: Down, sub: u32) -> bool {
    match take d {
        Ended(s, take o) => s == sub && match o {
            Refused(Overloaded) => true,
            _ => false,
        },
        _ => false,
    }
}

// The session's end. A marked session on a mailbox of 2, with this law as its publisher,
// joins and subscribes sub 1; its mark is Empty while it lives. It ends (0) normally on an
// empty PubIn, (1) normally on a full one, (2) by a fault, or (3) by cancellation. Its end
// waits on nothing: the session's own Drained is on PubIn before `join_marked` in (0), and in
// (1) it was dropped, so `join_marked` adds only its own. In (2) and (3) only the joiner offers
// one. The mark is closed after the join in each. (1) also holds v2.12 item 3: on the full
// PubIn, a Subscribe of sub 2 is answered Ended(2, Refused(Overloaded)), and an Unsubscribe of
// sub 1 is applied at the owner, which drops sub 1's rows from later content.
fn fixture_generations(g: u64) -> List[(u32, u64)] {
    let mut stamps: List[(u32, u64)] = list.new()
    list.push(mut stamps, (1u32, 1u64))
    list.push(mut stamps, (3u32, g))
    stamps
}

// This unit driver feeds the production wire service, including its finish path.
// It owns no public client transport. The existing publisher tests exercise marks.
type RetiredOwner: send { service: Service[WireSession[(), Qh]], from: Receiver[WireEvent], output: Sender[Down], publisher: Sender[PubIn] }

fn retired_owner(take seed: RetiredOwner) -> Result[(), ()] waits {
    let RetiredOwner(service: take initial, from: take from, output: take output, publisher: take pub_to) = take seed
    let mut service = take initial
    let mut work = wire_work()
    loop {
        wire_join_send(mut work, pub_to)
        let event = match channel.receive(from) { Ok(take x) => take x, _ => break }
        let WireEvent(e: take input_event) = take event
        let input = match take input_event {
            Input(take frame, at) => WClient(take frame, at),
            FromRunner(take notice) => WRunner(take notice),
            JoinReady => WPoll(false),
            Ended(_) => break,
            _ => continue,
        }
        let _ = result.unwrap((service.step)(mut service.context, mut work, take input))
        while let Some(take frame) = result.unwrap((service.step)(mut service.context, mut work, WPoll(true))) {
            let _ = result.unwrap((service.step)(mut service.context, mut work, WSent))
            let down = match take frame {
                Batch(v, take complete, take rows, _) => Batched(KeyedBatch(version: v, complete: take complete, rows: take rows, outcomes: list.new())),
                Ended(sub, take outcome) => Ended(sub, take outcome),
                Reset(v, _) => KeyedReset(v, list.new()),
                _ => continue,
            }
            let _ = channel.send(output, take down)
        }
    }
    wire_finish_owner(mut service, pub_to)
    Ok(())
}

fn retired_session(c: Clock, r: Random, tasks: Tasks, end: u64) -> bool waits {
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(2u64))
    let (head, heads): (Sender[Req], Receiver[Req]) = channel.new(1u64)
    let (down_to, down): (Sender[Down], Receiver[Down]) = channel.new(16u64)
    let (inbox, events): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(16u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut service = wire_service_seed(take reg, r, None, head, c, tasks, wire_defaults(1048576u64, 1048576u64), "fixture")
    service.context.marked = true
    service.context.phase = 3u8
    // Past hello every session holds a Caller; a Subscribe without one ends it (1008).
    service.context.caller = Some(law_caller(7u64))
    service.context.me = Some(channel.sender(inbox))
    service.context.publisher = Some(channel.sender(to))
    let k1 = query_key(code.describe(q1))
    list.push(mut service.context.entries, clone(k1))
    let seed = RetiredOwner(service: take service, from: take events, output: take down_to, publisher: channel.sender(to))
    let mut running = task.spawn(tasks, bytes 4194304u64, take seed, retired_owner)
    if let Error(_) = channel.send(inbox, wire_event(Input(Subscribe(1u32, 0u32, no_arg(), None), 0u64))) { return false }
    let joining = match channel.receive(from) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let PubIn(e: take first) = take joining
    // v2.22: the Subscribe that made the owner join rides in its Join.
    let (ses, held, subscribed) = match take first {
        Joined(take j) => {
            let Join(to: take delivery, told: take told, mark: take given, closed: _, identity: _, fence: _, progress: _, taken: _, first: take carried) = take j
            let ses_to = take delivery
            let _ = channel.try_send(told, Admit(who: 7u64, round: latest.handle(rounds.round)))
            let _ = channel.send(ses_to, wire_event(JoinReady))
            let one = match carried { Some(f) => f.sub == 1u32, None => false }
            (take ses_to, take given, one)
        },
        _ => return false,
    }
    let m = match take held {
        Some(take x) => take x,
        None => return false,
    }
    let live = match channel.try_receive(m) {
        Error(Empty) => true,
        _ => false,
    }
    if !subscribed || !live {
        return false
    }
    if end == 1u64 {
        if let Error(_) = channel.send(inbox, wire_event(Input(Subscribe(3u32, 0u32, no_arg(), None), 0u64))) { return false }
        let generation = match channel.receive(from) {
            Ok(take x) => { let PubIn(e: take e) = take x; match take e { WireSubscribed(7u64, 3u32, g, _) => g, _ => return false } },
            _ => return false,
        }
        for _ in 0u64 .. 2u64 {
            if let Error(_) = channel.send(to, PubIn(e: Drained)) {
                return false
            }
        }
        let mut rows: List[Row] = list.new()
        list.push(mut rows, Row(sub: 1u32, key: no_arg(), value: None))
        list.push(mut rows, Row(sub: 3u32, key: no_arg(), value: None))
        let o = Owe(session: 7u64, version: 9u64, generations: fixture_generations(generation), complete: list.new(), rows: take rows, ended: list.new(), reset: false)
        if let Error(_) = channel.send(inbox, wire_event(Input(Subscribe(2u32, 0u32, no_arg(), None), 0u64))) {
            return false
        }
        if let Error(_) = channel.send(inbox, wire_event(Input(Unsubscribe(1u32), 0u64))) {
            return false
        }
        if let Error(_) = channel.send(inbox, wire_event(FromRunner(update(9u64, Some(take o), list.new())))) {
            return false
        }
        let refused = match channel.receive(down) {
            Ok(take d) => is_ended(take d, 2u32),
            Error(_) => false,
        }
        let only_three = match channel.receive(down) {
            Ok(Batched(take x)) => list.len(x.rows) == 1u64 && x.rows[0].sub == 3u32,
            _ => false,
        }
        if !refused || !only_three {
            return false
        }
    }
    if end == 2u64 {
        // A Told whose stream is over the session's bytes: slot_key's allocation faults.
        let mut big: Bytes = list.new()
        list.fill(mut big, 8388608u64, 0u8)
        let mut answers: List[KeyedDone] = list.new()
        list.push(mut answers, KeyedDone(stream: take big, p: 0u64, outcome: Refused(Overloaded)))
        if let Error(_) = channel.send(inbox, wire_event(FromRunner(update(0u64, None, take answers)))) {
            return false
        }
    } else if end == 3u64 {
        task.cancel(mut running)
    } else if let Error(_) = channel.send(inbox, wire_event(Ended(1000u16))) {
        return false
    }
    // The session's end drops its client; this waits for that, never for the task.
    while let Ok(_) = channel.receive(down) {
    }
    let before = drained(from)
    let outcome = match join_marked(take running, to) {
        Ok(Ok(_)) => end <= 1u64,
        Error(Failed(_)) => end == 2u64,
        Error(Cancelled(_)) => end == 3u64,
        _ => false,
    }
    let after = drained(from)
    let closed = match channel.try_receive(m) {
        Error(Closed) => true,
        _ => false,
    }
    let want = if end == 0u64 {
        1u64
    } else if end == 1u64 {
        2u64
    } else {
        0u64
    }
    let _ = heads
    outcome && closed && before == want && after == 1u64
}

@test
fn test_retired_without_waiting(c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_retired_without_waiting(c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L28 (RUNNER-SPEC v2.19.2, stale_never_released): once commit b's round register value is
// published, no writer accepts a content unit below b for a session whose read set b hit.
// The decision rows are hand-derived from §3: R = u64::MAX drops; the fence acts at `latest`
// once R has reached it and at `prior` before. The trace runs the publisher as a task: one
// session joins with its fence root and subscribes q1 at v0 (q1 reads perm, covers rows 0
// and 1). Commit c writes only a covered row, so the fence stays at 0 and R = c; commit b
// clears perm, a read hit, so the fence becomes {0, b} and R = b, and the writer's check
// then refuses a unit at c and accepts one at b.
pub fn law_stale_never_released(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let table = !release_passes(ROUND_HALTED, Fence(prior: 0u64, latest: 0u64), 5u64)
        && !release_passes(7u64, Fence(prior: 3u64, latest: 7u64), 5u64)
        && release_passes(5u64, Fence(prior: 3u64, latest: 9u64), 4u64)
        && !release_passes(5u64, Fence(prior: 3u64, latest: 9u64), 2u64)
        && release_passes(9u64, Fence(prior: 3u64, latest: 9u64), 9u64)
    table && stale_trace(c, r, tasks) && trap_trace(c, r, tasks) && ended_trace(c, r)
}

// v2.19.2 ended entries (RECHECK B1, B1a): a sub the publisher ends keeps its read set
// indexed until a read-set hit fences its session. Three sessions end at commit c with no
// fence of their own: session 1's q1 by a Cover-only conversion that faults (Ended), session
// 2's q1 by one that loses (a publisher-made Reset), and session 3's q_late by a re-run that
// faults after reading perm, which its last good run never read. Session 4's q1 gets round
// c's rows, which bounce at its full owner inbox after c's R is published (B1d), so it is due
// for repair (§3 "Repair"): no Ended, no fence. Commit b then writes only perm: all four
// sessions are fenced at b, and nothing is owed, since session 4's sub is due and is not re-run.
// A second write to perm fences only session 4, whose due sub keeps its read set; each ended
// entry left at its first hit. Repair waits for session 4's drain token, then owes q1's whole
// image at the base: perm is set, so rows 1 and 2, in one `complete`.
fn ended_trace(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let h = result.unwrap(subs_handles(mut db))
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    let _ = at_base(mut b, 1u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 2u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 3u64, 1u32, query_key(code.describe(q_late)), no_arg())
    let _ = at_base(mut b, 4u64, 1u32, query_key(code.describe(q1)), no_arg())
    let schema = 7u64
    let faults = fn(_ch: store.Change) -> Result[Option[Bytes], store.Error] {
        if schema != 0u64 { fail("subs: a Cover's value faults") }
        Error(Schema(schema))
    }
    let loses = fn(_ch: store.Change) -> Result[Option[Bytes], store.Error] { Error(Schema(schema)) }
    let faulting_value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error] = take faults
    let losing_value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error] = take loses
    let mut faulting = Some(take faulting_value)
    let mut losing = Some(take losing_value)
    let _ = map.update(mut b.subs.by_session, 1u64, scoped fn(mut group: Map[u32, Sub]) {
        let _ = map.update(mut group, 1u32, scoped fn(mut entry: Sub) {
            let mut kept = option.unwrap(replace(mut entry.cover, None))
            kept.value = option.unwrap(replace(mut faulting, None))
            entry.cover = Some(take kept)
        })
    })
    let _ = map.update(mut b.subs.by_session, 2u64, scoped fn(mut group: Map[u32, Sub]) {
        let _ = map.update(mut group, 1u32, scoped fn(mut entry: Sub) {
            let mut kept = option.unwrap(replace(mut entry.cover, None))
            kept.value = option.unwrap(replace(mut losing, None))
            entry.cover = Some(take kept)
        })
    })
    set(mut db, t, 2u64, 2u64)
    b.newest = Some(store.snapshot(db))
    let mut at_c = Fenced(sessions: list.new(), all: false)
    let mut owes_c = round(mut b, mut at_c)
    let (full_to, _full_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let (progressed, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    let mut joined: List[Joiner] = list.new()
    list.push(mut joined, Joiner(who: 4u64, to: take full_to, closed: None, ended: list.new(), ended_at: ROUND_HALTED, reset: false, mark: None, identity: None, fence: None, due: false, progress: Some(take progress), progressed: false, taken: None, handed: 0u64))
    let mut bounced = 0u64
    let mut i = 0u64
    while i < list.len(owes_c) {
        if owes_c[i].session == 4u64 {
            let o = list.remove(mut owes_c, i)
            if list.len(o.rows) > 0u64 { bounced += 1u64 }
            overloaded(mut b.subs, mut joined[0], take o)
        } else {
            i += 1u64
        }
    }
    let marked = joined[0].due && list.len(joined[0].ended) == 0u64
    let mut ended = 0u64
    for o in owes_c {
        if o.session == 2u64 && o.reset { ended += 1u64 }
        for e in o.ended {
            let raised_fail = match e.2 { Failed(Raised(n)) => n == 5u32, _ => false }
            if (o.session == 1u64 || o.session == 3u64) && e.0 == 1u32 && raised_fail { ended += 1u64 }
        }
    }
    let c_fences = !at_c.all && list.len(at_c.sessions) == 1u64 && list.contains(at_c.sessions, 3u64)
    set(mut db, t, 0u64, 5u64)
    b.newest = Some(store.snapshot(db))
    let mut at_b = Fenced(sessions: list.new(), all: false)
    let owes_b = round(mut b, mut at_b)
    let b_fences = !at_b.all && list.len(at_b.sessions) == 4u64 && list.contains(at_b.sessions, 1u64)
        && list.contains(at_b.sessions, 2u64) && list.contains(at_b.sessions, 3u64) && list.contains(at_b.sessions, 4u64)
    set(mut db, t, 0u64, 6u64)
    b.newest = Some(store.snapshot(db))
    let mut again = Fenced(sessions: list.new(), all: false)
    let owes_again = round(mut b, mut again)
    let kept = !again.all && list.len(again.sessions) == 1u64 && list.contains(again.sessions, 4u64) && list.len(owes_again) == 0u64
    let mut idle: List[Owe] = list.new()
    repair(mut b, mut joined, mut idle)
    let _ = channel.try_send(progressed, ())
    let mut fixed: List[Owe] = list.new()
    repair(mut b, mut joined, mut fixed)
    let image = list.len(fixed) == 1u64 && fixed[0].session == 4u64 && fixed[0].version == store.version(b.base)
        && list.len(fixed[0].complete) == 1u64 && fixed[0].complete[0] == 1u32 && list.len(fixed[0].ended) == 0u64 && !fixed[0].reset
        && list.len(fixed[0].rows) == 2u64 && fixed[0].rows[0].sub == 1u32 && fixed[0].rows[1].sub == 1u32 && !joined[0].due
    bounced == 1u64 && marked && ended == 3u64 && c_fences && b_fences && list.len(owes_b) == 0u64
        && kept && list.len(idle) == 0u64 && image
}

// publisher_trap_open: a publisher that traps publishes R = u64::MAX before it goes, so the
// head's next commit is never released unfenced. The trap is real: one commitless Release
// carries more answers for one owner than the publisher's byte limit holds, and
// keep_answers' push unwraps the refusal.
fn trap_trace(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    let base = store.snapshot(db)
    let v0 = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let p = Publish(place: code.describe(subs_place), n_place: 131072u64, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready_to)
    let publishing = task.spawn(tasks, bytes 524288u64, take p, publish)
    match channel.receive(ready_from) {
        Ok(None) => (),
        _ => return false,
    }
    let (s_to, s_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let (told, hear): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: channel.sender(s_to), told: take told, mark: None, closed: None, identity: None, fence: None, progress: None, taken: None, first: None)))) {
        return false
    }
    let Admit(who: s, round: take register) = match channel.receive(hear) {
        Ok(take a) => take a,
        Error(_) => return false,
    }
    let before = latest.read(register).at == v0
    let mut answers: List[Answer] = list.new()
    for i in 0u64 .. 16384u64 {
        let row = KeyedDone(stream: list.new(), p: i, outcome: Abandoned)
        list.push(mut answers, Answer(recipient: Recipient(owner: 999u64, to: channel.sender(s_to)), row: take row))
    }
    let _ = channel.send(to, PubIn(e: Released(Release(version: 0u64, snapshot: None, answers: take answers))))
    let trapped = match task.join(take publishing) {
        Ok(_) => false,
        Error(_) => true,
    }
    let refused = match channel.send(to, PubIn(e: Drained)) { Error(_) => true, Ok(_) => false }
    let at = latest.read(register).at
    let _ = (s_from, take s_to)
    before && s != 0u64 && trapped && refused && at == ROUND_HALTED && !release_passes(at, Fence(prior: 0u64, latest: 0u64), v0)
}

fn stale_trace(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let v0 = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 5u64)
    let cs = store.snapshot(db)
    set(mut db, t, 0u64, 0u64)
    let bs = store.snapshot(db)
    let vc = store.version(cs)
    let vb = store.version(bs)
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let p = Publish(place: code.describe(subs_place), n_place: 1048576u64, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready_to)
    let publishing = task.spawn(tasks, bytes 8388608u64, take p, publish)
    match channel.receive(ready_from) {
        Ok(None) => (),
        _ => return false,
    }
    let first = arc.new(Fence(prior: 0u64, latest: 0u64))
    let root = latest.new(take first)
    let (s_to, s_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(16u64)
    let (told, hear): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: take s_to, told: take told, mark: None, closed: None, identity: None, fence: Some(latest.handle(root)), progress: None, taken: None, first: None)))) {
        return false
    }
    let Admit(who: s, round: take register) = match channel.receive(hear) {
        Ok(take a) => take a,
        Error(_) => return false,
    }
    let mut queue: List[ToPub] = list.new()
    list.push(mut queue, Subscribed(s, 1u32, law_caller(s), query_key(code.describe(q1)), no_arg()))
    list.push(mut queue, Released(Release(version: vc, snapshot: Some(take cs), answers: list.new())))
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (x_to, x_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let x = join_as(to, take x_to, None)
    // Round c named only q1's cover: no fence moved.
    let at_c = latest.read(register).at == vc && latest.read(root).latest == 0u64
        && release_load(register, root, v0) && release_load(register, root, vc)
    if let Error(_) = channel.send(to, PubIn(e: Released(Release(version: vb, snapshot: Some(take bs), answers: list.new())))) {
        return false
    }
    let (y_to, y_from): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let y = join_as(to, take y_to, None)
    let at_b = {
        let f = latest.read(root)
        f.prior == 0u64 && f.latest == vb
    } && latest.read(register).at == vb && !release_load(register, root, vc) && release_load(register, root, vb)
    if let Error(_) = channel.send(to, PubIn(e: Halt)) {
        return false
    }
    let stopped = match task.join(take publishing) {
        Ok(_) => true,
        Error(_) => false,
    }
    let _ = (s_from, x_from, y_from)
    stopped && s != 0u64 && x != 0u64 && y != 0u64 && at_c && at_b
}


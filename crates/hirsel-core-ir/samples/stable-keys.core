; CoreIR sample, family: equality, order and hash of stable values held by locator
; (crate docs, "Compact data"; SEM-5, SEM-7, MEM-12), as the per-instance helpers emit
; them. A standalone `Text`, `FixedSpan[T]` or `SeqSpan[T]` is `{at: locator X}`: the
; locator names X, so a helper reads X's recipe from the row and nothing else.
; - Every read starts the same way (f1): W from the blob header (at 8), the value's
;   first W bytes are its count (f0 reads a W-wide word: 2, 4 or 8 bytes).
; - Text (f2, f3): its bytes follow the count. Order and equality are
;   `rt.compare_bytes` (`==` is `eq r, 0`), its hash word `rt.hash_bytes`, exactly as
;   for a `String` with the same bytes, whatever the blob's W.
; - FixedSpan[u32] (f4): elements follow the count at the packed stride 4; order is
;   lexicographic over the elements, then a proper prefix first (SEM-7).
; - SeqSpan[Text] (f5): count, byte length, then the elements; equality is equal
;   counts, then element by element, each element a compact value, so it is decoded to
;   its locator {blob, at} in a frame slot and compared by the Text helper (f2); the
;   walk advances by the element's extent at the holder's W (Text: W + count).
;
; Source (package samples@0, module keys), the helpers instantiated for these types:
;   f6: fn texts() { ("abc" <=> "abd", "abc" <=> "ab", A."abc" <=> B."abc",
;                     hash word of A."abc", of B."abc") }
;   f7: fn fixed() { ([1,2,3] <=> [1,2], [1,2] <=> [1,5], [1,2] <=> [1,2], [1,5] <=> [1,2,3]) }
;   f8: fn seqs() { (["ab","c"] == ["ab","d"], ["ab","c"] == ["ab","c"]) }
;
; Data, derived by hand. Blob A (d0), W 4, used 98: Text "abc" at 16 (count 3 then
; 61 62 63), "abd" at 23, "ab" at 30; FixedSpan[u32] [1,2,3] at 36 (count 3, then
; 1, 2, 3), [1,2] at 52, [1,5] at 64; SeqSpan[Text] ["ab","c"] at 76 (count 2, byte
; length 11 = (4 + 2) + (4 + 1), then the two Texts), ["ab","d"] at 95. Blob B (d1),
; W 2, used 5: Text "abc" at 16 (count 3 as a u16, then the bytes).
; "abc" < "abd" at byte 2; "ab" is a proper prefix of "abc"; A."abc" and B."abc" have
; the same bytes at different W, so they are equal and hash alike. The hash word is
; rt.hash_bytes("abc") from the rule in the crate docs ("Maps"): h = 3, one word
; 0x636261: h = rotl((3 ^ 0x636261) * 0x9E3779B97F4A7C15, 26), then h ^ (h >> 32)
; = 3235988236793466238.
; run: f6() -> -1, 1, 0, 3235988236793466238, 3235988236793466238 | used 0
; [1,2,3] vs [1,2]: equal for 2 elements, then the longer is greater. [1,2] vs [1,5]:
; 2 < 5. [1,5] vs [1,2,3]: 5 > 2 decides before the lengths.
; run: f7() -> 1, -1, 0, 1 | used 0
; ["ab","c"] vs ["ab","d"]: counts 2 = 2, "ab" = "ab", "c" != "d".
; run: f8() -> false, true | used 0
core v1
type t0 = own "Text" { at: locator text }
type t1 = own "FixedSpan[u32]" { at: locator fixed u32 }
type t2 = own "SeqSpan[Text]" { at: locator seqspan text }
static d0 = align 8 hex 62000000000000000400000000000000030000006162630300000061626402000000616203000000010000000200000003000000020000000100000002000000020000000100000005000000020000000b0000000200000061620100000063020000000b0000000200000061620100000064
static d1 = align 8 hex 050000000000000002000000000000000300616263

type HttpLawScalars: codec {
    unit: (),
    flag: bool,
    scalar: char,
    a: u8,
    b: u16,
    c: u32,
    d: u64,
    e: i8,
    f: i16,
    g: i32,
    h: i64,
    single: f32,
    double: f64,
    text: String
}

type HttpLawPositive: codec via u8(to: http_law_to, from: http_law_from) {
    value: u8
}

fn http_law_to(n: HttpLawPositive) -> View[u8] in n {
    view n.value
}

fn http_law_from(take n: u8) -> Result[HttpLawPositive, ()] {
    if n == 0u8 {
        Error(())
    } else {
        Ok(HttpLawPositive(value: n))
    }
}

type HttpLawArg: codec {
    request: HttpLawValue
}

type HttpLawValue: codec = Unit | Scalars(HttpLawScalars) | Collections(Bytes, List[u16], Map[String, ()]) | Optional(Option[String]) | ResultValue(Result[u8, String]) | Validated(HttpLawPositive) | Normalized(Map[HttpLawFolded, ()]) | RejectSame

type HttpLawFolded: codec + key via String(to: http_law_fold_spelling, from: http_law_fold_key) {
    spelling: String
}

fn http_law_fold_spelling(key: HttpLawFolded) -> View[String] in key {
    view key.spelling
}

fn http_law_fold_key(take spelling: String) -> Result[HttpLawFolded, ()] {
    Ok(HttpLawFolded(spelling: string.to_lower(spelling)))
}

type HttpLawError: codec {
    refused: String
}

type HttpLawHandles: shareable + send {
    counter: store.Table[u64, u64]
}

fn http_law_increment(mut tx: store.Tx, tables: HttpLawHandles, _author: Caller, take request: HttpLawArg) -> Result[u64, HttpLawError] {
    if let RejectSame = request.request {
        return Error(HttpLawError(refused: "request_mismatch"))
    }
    let prior = match result.unwrap(store.fetch(tx, tables.counter, 0u64)) {
        Some(n) => n,
        None => 0u64
    }
    result.unwrap(store.put(mut tx, tables.counter, 0u64, prior + 1u64))
    Ok(prior + 1u64)
}

fn http_law_query(_tx: store.Tx, _tables: HttpLawHandles, take _input: HttpLawArg) -> Result[Answer[()], Capacity] {
    Ok(Answer(value: (), covers: covers()))
}

fn http_law_schema(mut declared: store.Declare) -> Result[HttpLawHandles, store.Error] {
    let table = store.declare_table(mut declared, "counter", std.codec.key_u64(), std.codec.of_u64())?
    Ok(HttpLawHandles(counter: store.finish(mut declared, take table)?))
}

fn http_law_place(mut reg: Registry[(), HttpLawHandles]) -> Result[(), RegisterError] {
    transact(mut reg, code.describe(http_law_increment), 65536u64, DEFAULT_STEPS)?
    query(mut reg, code.describe(http_law_query), slots(), 65536u64, DEFAULT_STEPS)?
    let mut fields: List[FieldSource] = list.with_capacity(1u64)
    list.push(mut fields, FieldSource(field: "request", source: Body))
    let entry = http_law_key(reg.exported[0u64])
    bind(mut reg, HttpBinding(op: "increment", method: Post, path: "/generated", entry: take entry, fields: take fields, mode: Stream, ok_status: 200u16, error_status: 422u16, body_max: HTTP_LAW_ARG_MAX, arg_max: 65536u64, deadline_ms: 1000u64, steps: DEFAULT_STEPS))
}

fn http_law_binding(_seed: (), credential: Bytes) -> Result[BoundCaller, BindRefusal] {
    if credential == b"unavailable" {
        return Error(Unavailable)
    }
    ingress.caller((), credential)
}

// The law's binding with the unit bind mint `running` serves.
fn http_law_bind(running: PlaceGrants[()]) -> Option[BindGrant[()]] {
    grant_binds_of(running, wire(code.describe(http_law_binding), 4096u64, 65536u64))
}

fn http_law_credential() -> Bytes {
    std.http.copy_bytes(b"h5-law-token-123")
}

const HTTP_LAW_PLACE_BYTES: u64 = 1048576u64

const HTTP_LAW_ARG_MAX: u64 = 1024u64

type HttpLawRoute: send {
    clock: Clock,
    random: Random,
    tasks: Tasks,
    relay: Relay,
    writes: Bytes,
    reads: Bytes,
    reg: Registry[(), HttpLawHandles]
}

fn http_law_route(clock: Clock, random: Random, tasks: Tasks, relay: Relay) -> HttpLawRoute {
    let reg = result.unwrap(placed(code.describe(http_law_place), HTTP_LAW_PLACE_BYTES))
    HttpLawRoute(clock: clock, random: random, tasks: tasks, relay: relay_endpoint(relay), writes: http_law_key(reg.exported[0u64]), reads: http_law_key(reg.exported[1u64]), reg: take reg)
}

fn http_law_config() -> std.http.Config {
    std.http.Config(ingress: list.new(), sockets_max: 2u64, http_max: 2u64, upgrades_max: 0u64, conns_max: 2u64, ip_sockets_max: 2u64, refuse_max: 1u64, refuse_ms: 1000u64, inbox_cap: 8u64, head_max: 8192u64, fields_max: 64u64, pipeline_max: 8192u64, body_inline: 16384u64, body_max: HTTP_LAW_ARG_MAX, out_cap: 1024u64, handler_bytes: 262144u64, first_head_ms: 1000u64, idle_ms: 2000u64, head_ms: 1000u64, body_ms: 1000u64, handler_ms: 2000u64, write_ms: 1000u64, drain_ms: 100u64, linger_ms: 5u64, drain_max: 1024u64, streams_max: 0u64, state_max: 0u64, reads_max: 0u64, heartbeat_ms: 0u64, lease_ms: 0u64)
}

fn http_law_decimal(b: Bytes) -> Option[u64] {
    if list.len(b) == 0u64 || (list.len(b) > 1u64 && b[0u64] == b'0') {
        return None
    }
    let mut n = 0u64
    for digit in b {
        if !int.is_ascii_digit(digit) {
            return None
        }
        let d: u64 = int.widen(digit - b'0')
        n = int.checked_add(int.checked_mul(n, 10u64)?, d)?
    }
    Some(n)
}

fn http_law_identity(b: Bytes) -> Option[(u32, u64)] {
    let size = list.len(b)
    if size < 5u64 || b[0u64] != b'"' || b[size - 1u64] != b'"' {
        return None
    }
    for i in 2u64 .. size - 2u64 {
        if b[i] == b'.' {
            let stream = http_law_decimal(list.slice(b, 1u64, i))?
            if stream > 4294967295u64 {
                return None
            }
            let position = http_law_decimal(list.slice(b, i + 1u64, size - 1u64))?
            return Some((int.narrow(stream), position))
        }
    }
    None
}

fn http_law_refused(why: Refusal) -> u16 {
    match why {
        NoEntry => 404u16,
        Malformed(_) => 400u16,
        NotAllowed => 403u16,
        Deadline => 504u16,
        Overloaded => 503u16,
        Budget(_) => 503u16,
        RequestMismatch => 422u16,
        HistoryUnavailable => 410u16,
    }
}

fn http_law_reply(status: u16, take body: Bytes, replayed: bool) -> Result[std.http.Outcome, std.http.HandlerError] {
    let mut response = std.http.response(status, take body, true)?
    if replayed {
        std.http.header(mut response, std.http.copy_bytes(b"Idempotent-Replayed"), std.http.copy_bytes(b"true"))?
    }
    if status == 503u16 || status == 409u16 {
        std.http.header(mut response, std.http.copy_bytes(b"Retry-After"), std.http.copy_bytes(b"1"))?
    }
    Ok(Reply(take response))
}

// The H5 raw arm forwards the original codec bytes. The route does not
// decode a typed argument, make a Req, or build a digest.
fn http_law_raw(req: std.http.Request, _scratch: Region, mut resp: std.http.Responder, state: HttpLawRoute) -> Result[std.http.Outcome, std.http.HandlerError] waits {
    let id = match std.http.field(req, b"idempotency-key") {
        Some(value) => http_law_identity(value),
        None => None,
    }
    let Some((stream, p)) = id else {
        return http_law_reply(400u16, list.new(), false)
    }
    let ms: u32 = match std.http.field(req, b"x-law-deadline") {
        Some(n) => match http_law_decimal(n) {
            Some(ms) => int.narrow(ms),
            None => 0u32
        },
        None => 1000u32,
    }
    let mut input: Bytes = list.with_capacity(HTTP_LAW_ARG_MAX)
    if let Some(inline) = std.http.inline_body(req) {
        list.append(mut input, inline)
    } else {
        loop {
            match std.http.read(mut resp, mut input) {
                Ok(0u64) => break,
                Ok(_) => (),
                Error(_) => return http_law_reply(400u16, list.new(), false),
            }
        }
    }
    let credential = match std.http.field(req, b"authorization") {
        Some(value) => Some(std.http.copy_bytes(value)),
        None => None,
    }
    let mut entries: List[Bytes] = list.with_capacity(1u64)
    list.push(mut entries, clone(state.writes))
    let handler_deadline = std.http.handler_deadline(req)
    let binds = ingress.bind_task(state.tasks)
    let bound_http = bind_http(http_law_bind(binds), take credential, take entries, state.random, state.clock, state.tasks, handler_deadline, 65536u64, HTTP_LAW_ARG_MAX)
    stop_grants(Some(take binds))
    let admit = match take bound_http {
        Ok(take context) => take context,
        Error(RejectedCredential) => return http_law_reply(401u16, list.new(), false),
        Error(_) => return http_law_reply(503u16, list.new(), false),
    }
    if ms == 0u32 {
        return http_law_reply(504u16, list.new(), false)
    }
    let denied = std.http.path(req) == b"/denied"
    let want = CallWant(key: if denied {
        clone(state.reads)
    } else {
        clone(state.writes)
    }, stream: store.StreamId(t: 0u64, n: int.widen(stream)), p: p, arg: take input, deadline_ms: ms)
    let send = match prepare(state.reg, admit, take want) {
        Ok(take sent) => take sent,
        Error(take why) => return http_law_reply(http_law_refused(why), list.new(), false),
    }
    let delivered = match relay_call(state.relay, take send, state.clock, state.tasks, handler_deadline) {
        Answered(take reply) => take reply,
        RefusedBeforePost(take why) => return http_law_reply(http_law_refused(why), list.new(), false),
        Unanswered(take why) => return http_law_reply(http_law_refused(why), list.new(), false),
    }
    let RelayOutcome(payload: take body, replayed: replayed, ..) = take delivered
    let codec: std.codec.Codec[Outcome] = std.codec.of()
    let status = match result.unwrap(std.codec.decode(codec, body)) {
        Returned(_) => 200u16,
        Failed(_) => 500u16,
        Refused(why) => http_law_refused(why),
        Abandoned => 409u16,
        InDoubt => 502u16,
    }
    http_law_reply(status, take body, replayed)
}

type HttpLawServer: send {
    generated: bool,
    relay: Relay,
    listener: Listener,
    clock: Clock,
    random: Random,
    tasks: Tasks
}

fn http_law_serve(take job: HttpLawServer) waits {
    let HttpLawServer(generated: generated, relay: take endpoint, listener: take listener, clock, random, tasks) = take job
    let mut listeners: List[Listener] = list.with_capacity(1u64)
    list.push(mut listeners, take listener)
    if generated {
        let binds = ingress.bind_task(tasks)
        let reg = result.unwrap(placed(code.describe(http_law_place), HTTP_LAW_PLACE_BYTES))
        let builder: std.router.Builder[HttpConnection[(), HttpLawHandles]] = std.router.builder()
        let (take router, take prepared_routes) = result.unwrap(http_router(reg, None, take builder))
        let connection: scoped[view] fn() -> HttpConnection[(), HttpLawHandles] = fn() -> HttpConnection[(), HttpLawHandles] {
            let registry_copy = result.unwrap(placed(code.describe(http_law_place), HTTP_LAW_PLACE_BYTES))
            http_connection(take registry_copy, arc.share(prepared_routes), http_law_bind(binds), relay_endpoint(endpoint), random, clock, tasks, 65536u64)
        }
        result.unwrap(http_serve_connections(take listeners, clock, tasks, http_law_config(), take router, 2097152u64, connection, None))
        stop_grants(Some(take binds))
        return
    }
    let mut routes: std.router.Builder[HttpLawRoute] = std.router.builder()
    result.unwrap(std.router.add(mut routes, "POST", "/run", std.router.raw(http_law_raw)))
    result.unwrap(std.router.add(mut routes, "POST", "/denied", std.router.raw(http_law_raw)))
    let make: scoped[view] fn() -> HttpLawRoute = fn() -> HttpLawRoute {
        http_law_route(clock, random, tasks, endpoint)
    }
    result.unwrap(std.http.serve_with_factory(take listeners, clock, tasks, http_law_config(), result.unwrap(std.router.build(take routes)), 2097152u64, make, None))
}

fn http_law_write(mut writer: WriteHalf, input: Bytes, until: Until) waits {
    let mut at = 0u64
    while at < list.len(input) {
        let sent = result.unwrap(host.send_pair(mut writer, list.slice(input, at, list.len(input)), b"", until))
        if sent == 0u64 {
            fail("HTTP law request did not write")
        }
        at += sent
    }
}

type HttpLawReply {
    status: u16,
    outcome: Option[Outcome],
    replayed: bool,
    committed: bool,
    retry_after: Option[u64],
    body: Bytes,
    dedup_until: Option[Bytes],
    refused: Option[Bytes]
}

fn http_law_post(n: Net, clock: Clock, addr: Addr, path: String, credential: Bytes, stream: u32, p: u64, data: Bytes, deadline_ms: u32) -> HttpLawReply waits {
    http_law_post_with_caller(n, clock, addr, path, credential, stream, p, data, deadline_ms, None)
}

fn http_law_post_with_caller(n: Net, clock: Clock, addr: Addr, path: String, credential: Bytes, stream: u32, p: u64, data: Bytes, deadline_ms: u32, expected: Option[String]) -> HttpLawReply waits {
    http_law_request("POST", n, clock, addr, path, credential, stream, p, data, deadline_ms, expected)
}

fn http_law_request(method: String, n: Net, clock: Clock, addr: Addr, path: String, credential: Bytes, stream: u32, p: u64, data: Bytes, deadline_ms: u32, expected: Option[String]) -> HttpLawReply waits {
    let until = At(clock, std.clock.deadline_after_ms(host.mono_ns(clock), 4000u64))
    let (take read_half, take write_half) = net.split(result.unwrap(host.connect(n, addr, until)))
    let mut input = take read_half
    let mut output = take write_half
    let mut head = string.from(method)
    string.push(mut head, " ")
    string.push(mut head, path)
    string.push(mut head, " HTTP/1.1\r\nHost: a\r\nConnection: close\r\nIdempotency-Key: \"")
    string.push_uint(mut head, int.widen(stream), 16u32, 32u64, '0')
    string.push(mut head, ".")
    string.push_u64(mut head, p)
    string.push(mut head, "\"\r\nX-Law-Deadline: ")
    string.push_u64(mut head, int.widen(deadline_ms))
    string.push(mut head, "\r\nContent-Length: ")
    string.push_u64(mut head, list.len(data))
    string.push(mut head, "\r\nAuthorization: ")
    let mut request = std.http.copy_bytes(string.as_bytes(head))
    list.append(mut request, credential)
    if let Some(encoded_caller) = expected {
        list.append(mut request, b"\r\nHirsel-Expected-Caller: ")
        list.append(mut request, string.as_bytes(encoded_caller))
    }
    list.append(mut request, b"\r\nContent-Type: application/json\r\n\r\n")
    list.append(mut request, data)
    http_law_write(mut output, request, until)
    let mut received: Bytes = list.with_capacity(8192u64)
    loop {
        if list.len(received) == list.capacity(received) {
            list.reserve(mut received, 8192u64)
        }
        let available = list.capacity(received) - list.len(received)
        let size = result.unwrap(host.recv_bounded(mut input, mut received, available, until))
        if size == 0u64 {
            break
        }
    }
    let mut parsed = std.http1.head()
    if std.http1.response(received, mut parsed) != Complete {
        fail("HTTP law response head was incomplete")
    }
    let mut replayed = false
    let mut committed = false
    let mut retry_after: Option[u64] = None
    let mut dedup_until: Option[Bytes] = None
    let mut marker: Option[Bytes] = None
    for field in parsed.fields {
        let name = list.slice(received, field.name.start, field.name.end)
        if std.http1.equal_ascii(name, b"Idempotent-Replayed") {
            replayed = list.slice(received, field.value.start, field.value.end) == b"true"
        }
        if std.http1.equal_ascii(name, b"Idempotent-Outcome") {
            committed = list.slice(received, field.value.start, field.value.end) == b"committed"
        }
        if std.http1.equal_ascii(name, b"Retry-After") {
            retry_after = http_law_decimal(list.slice(received, field.value.start, field.value.end))
        }
        if std.http1.equal_ascii(name, b"Hirsel-Dedup-Until") {
            dedup_until = Some(std.http.copy_bytes(list.slice(received, field.value.start, field.value.end)))
        }
        if std.http1.equal_ascii(name, b"Hirsel-Refused") {
            marker = Some(std.http.copy_bytes(list.slice(received, field.value.start, field.value.end)))
        }
    }
    let codec: std.codec.Codec[Outcome] = std.codec.of()
    let payload = list.slice(received, parsed.end, list.len(received))
    let decoded = match std.codec.decode(codec, payload) {
        Ok(take value) => Some(take value),
        _ => None
    }
    HttpLawReply(status: parsed.status, outcome: take decoded, replayed: replayed, committed: committed, retry_after: retry_after, body: std.http.copy_bytes(payload), dedup_until: take dedup_until, refused: take marker)
}

type HttpLawCase: key + send = RawParity | RawRefusals | GeneratedParity | BindCodes

type HttpLawDrive: send {
    head: Sender[HeadInput],
    publisher_out: Sender[PubIn],
    net: Net,
    clock: Clock,
    random: Random,
    tasks: Tasks,
    case: HttpLawCase,
}

fn http_law_drive(take d: HttpLawDrive) waits {
    let reg = result.unwrap(placed(code.describe(http_law_place), HTTP_LAW_PLACE_BYTES))
    let (take relay, take relay_task) = result.unwrap(start_relay(reg, d.head, d.publisher_out, d.clock, d.tasks, RelayConfig(http_max: 2u64, sends_max: 2u64, positions_max: 1u64, arg_max: HTTP_LAW_ARG_MAX)))
    let (take listener, addr) = result.unwrap(host.listen(d.net, Addr(ip: V4(0x7f000001u32), port: 0u16), 8u16))
    let generated = d.case == GeneratedParity || d.case == BindCodes
    let job = HttpLawServer(generated: generated, relay: take relay, listener: take listener, clock: d.clock, random: d.random, tasks: d.tasks)
    let server = task.spawn(d.tasks, bytes 4194304u64, take job, http_law_serve)
    let keys = http_law_keys(reg)
    let (take socket, take wire_task) = result.unwrap(http_law_socket(d, keys, http_law_credential()))
    match d.case {
        RawParity => http_law_parity(d, addr, socket),
        RawRefusals => http_law_refusals(d, addr, socket, keys),
        GeneratedParity => http_law_lexical(d, addr, socket),
        BindCodes => http_law_binding_codes(d, addr, keys),
    }
    let _ = wire_client.close(take socket)
    let _ = std.task.cancel_join(take wire_task)
    let _ = std.task.cancel_join(take server)
    let _ = std.task.cancel_join(take relay_task)
}

fn http_law_keys(reg: Registry[(), HttpLawHandles]) -> List[Bytes] {
    let mut keys: List[Bytes] = list.with_capacity(2u64)
    for export in reg.exported {
        list.push(mut keys, http_law_key(export))
    }
    take keys
}

fn http_law_socket(d: HttpLawDrive, keys: List[Bytes], take credential: Bytes) -> Result[(wire_client.Conn, Task[Result[(), std.wsock.Error]]), std.wsock.Error] waits {
    let binds = ingress.bind_task(d.tasks)
    let paired = wire_client.pair(d.tasks, d.net, d.clock, d.random, http_law_bind(binds), d.head, d.publisher_out, code.describe(http_law_place), keys, Some(take credential), 2u64, 4194304u64)
    stop_grants(Some(take binds))
    paired
}

fn http_law_wire(s: wire_client.Conn, stream: u32, p: u64, index: u32, deadline_ms: u32, data: Bytes) -> Outcome waits {
    wire_client.send_frame(s, Call(store.StreamId(t: 0u64, n: int.widen(stream)), p, index, deadline_ms, clone(data)))
    loop {
        match result.unwrap(wire_client.next(s)) {
            Batch(_, _, _, take outcomes) => {
                for row in outcomes {
                    if row.stream == store.StreamId(t: 0u64, n: int.widen(stream)) && row.p == p {
                        return clone(row.outcome)
                    }
                }
            },
            _ => fail("HTTP law did not get a wire Outcome"),
        }
    }
}

fn http_law_key(row: Exported) -> Bytes {
    entry_key(view row.described.identity, row.args_fp, row.result_fp)
}

fn http_law_count(value: Outcome) -> u64 {
    if let Returned(raw) = value {
        let codec: std.codec.Codec[Result[u64, HttpLawError]] = std.codec.of()
        return result.unwrap(result.unwrap(std.codec.decode(codec, raw)))
    }
    fail("HTTP law did not return the counter")
}

fn http_law_reply_count(reply: HttpLawReply) -> u64 {
    if let Some(value) = reply.outcome {
        return http_law_count(value)
    }
    fail("HTTP law did not deliver an Outcome")
}

fn http_law_parity(d: HttpLawDrive, addr: Addr, socket: wire_client.Conn) waits {
    let credential = http_law_credential()
    let mut p = 0u64
    // The codec uses LE payloads and 32-bit tags and lengths. In the Map,
    // "9", "-0", "2" appear in that order, each with a zero-byte unit value.
    for payload in[
        b"\x00\x00\x00\x00",
        b"\x01\x00\x00\x00\x01\xbb\x03\x00\x00\xff\x34\x12\x78\x56\x34\x12\x01\x00\x00\x00\x00\x00\x20\x00\xff\xfe\xff\xfd\xff\xff\xff\xfc\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\xf8\x7f\x03\x00\x00\x00h\xc3\xa9",
        b"\x02\x00\x00\x00\x02\x00\x00\x00\x00\xff\x02\x00\x00\x00\x01\x00\x00\x01\x03\x00\x00\x00\x01\x00\x00\x009\x02\x00\x00\x00-0\x01\x00\x00\x002",
        b"\x03\x00\x00\x00\x00\x00\x00\x00",
        b"\x03\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00",
        b"\x04\x00\x00\x00\x00\x00\x00\x00\x07",
        b"\x04\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00x",
        b"\x05\x00\x00\x00\x09",
    ] {
        let expected = p + 1u64
        if p % 2u64 == 0u64 {
            let first = http_law_post(d.net, d.clock, addr, "/run", credential, 7u32, p, payload, 1000u32)
            if first.status != 200u16 || first.replayed || http_law_reply_count(first) != expected || http_law_count(http_law_wire(socket, 7u32, p, 0u32, 1000u32, payload)) != expected {
                fail("L10 HTTP-first pair disagreed with the single counter increment")
            }
        } else {
            let first = http_law_wire(socket, 7u32, p, 0u32, 1000u32, payload)
            let second = http_law_post(d.net, d.clock, addr, "/run", credential, 7u32, p, payload, 1000u32)
            if http_law_count(first) != expected || second.status != 200u16 || !second.replayed || http_law_reply_count(second) != expected {
                fail("L10 wire-first pair disagreed with the single counter increment")
            }
        }
        p += 1u64
    }
}

// L67's transport cases use an application-selected refusal before any call is admitted.
fn http_law_binding_codes(d: HttpLawDrive, address: Addr, keys: List[Bytes]) waits {
    let refusals =[
        (b"unavailable", 1013u16, 503u16, Some(5u64)),
        (b"rejected", 1008u16, 401u16, (None : Option[u64])),
    ]
    for (credential, close_code, status, retry_after) in refusals {
        match http_law_socket(d, keys, std.http.copy_bytes(credential)) {
            Error(Protocol(code)) if code == close_code => (),
            _ => fail("L67 the Hello got the wrong binding close code"),
        }
        let reply = http_law_post(d.net, d.clock, address, "/generated", credential, 7u32, 0u64, b"{\"request\":\"Unit\"}", 1000u32)
        if reply.status != status || reply.retry_after != retry_after || reply.committed || reply.replayed {
            fail("L67 the HTTP bind refusal got the wrong status or headers")
        }
    }
    let accepted = http_law_post(d.net, d.clock, address, "/generated", http_law_credential(), 7u32, 0u64, b"{\"request\":\"Unit\"}", 1000u32)
    if accepted.status != 200u16 || !accepted.committed || accepted.replayed || accepted.body != b"\"1\"" {
        fail("L67 a refused bind consumed the call's position")
    }
}

fn http_law_lexical(d: HttpLawDrive, addr: Addr, socket: wire_client.Conn) waits {
    let credential = http_law_credential()
    let mut position = 0u64
    // These are L10's hand-derived codec bytes. The single record field
    // changes the HTTP shape without adding any bytes to the codec value.
    for (text, binary) in[
        (b"{\"request\":\"Unit\"}", b"\x00\x00\x00\x00"),
        (b"{\"request\":{\"Scalars\":{\"text\":\"h\\u00e9\",\"double\":\"NaN\",\"single\":-0,\"h\":\"-4\",\"g\":-3,\"f\":-2,\"e\":-1,\"d\":\"9007199254740993\",\"c\":305419896,\"b\":4660,\"a\":255,\"scalar\":\"\\u03bb\",\"flag\":true,\"unit\":null}}}", b"\x01\x00\x00\x00\x01\xbb\x03\x00\x00\xff\x34\x12\x78\x56\x34\x12\x01\x00\x00\x00\x00\x00\x20\x00\xff\xfe\xff\xfd\xff\xff\xff\xfc\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\xf8\x7f\x03\x00\x00\x00h\xc3\xa9"),
        (b"{\"request\":{\"Collections\":[\"AP8=\",[1,256],[[\"9\",null],[\"-0\",null],[\"2\",null]]]}}", b"\x02\x00\x00\x00\x02\x00\x00\x00\x00\xff\x02\x00\x00\x00\x01\x00\x00\x01\x03\x00\x00\x00\x01\x00\x00\x009\x02\x00\x00\x00-0\x01\x00\x00\x002"),
        (b"{\"request\":{\"Optional\":null}}", b"\x03\x00\x00\x00\x00\x00\x00\x00"),
        (b"{\"request\":{\"Optional\":\"\"}}", b"\x03\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00"),
        (b"{\"request\":{\"ResultValue\":{\"ok\":7}}}", b"\x04\x00\x00\x00\x00\x00\x00\x00\x07"),
        (b"{\"request\":{\"ResultValue\":{\"error\":\"x\"}}}", b"\x04\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00x"),
        (b"{\"request\":{\"Validated\":9}}", b"\x05\x00\x00\x00\x09"),
    ] {
        let expect = position + 1u64
        let route = if position % 2u64 == 0u64 {
            "/generated"
        } else {
            "/.hirsel/op/increment"
        }
        let response = http_law_post(d.net, d.clock, addr, route, credential, 7u32, position, text, 1000u32)
        let mut expected_body = string.from("\"")
        string.push_u64(mut expected_body, expect)
        string.push(mut expected_body, "\"")
        if response.status != 200u16 || !response.committed || response.replayed || response.body != string.as_bytes(expected_body) || http_law_count(http_law_wire(socket, 7u32, position, 0u32, 1000u32, binary)) != expect {
            fail("L10j JSON and WebSocket bytes disagree")
        }
        position += 1u64
    }
    let body = b"{\"request\":\"RejectSame\"}"
    let committed_error = http_law_post(d.net, d.clock, addr, "/.hirsel/op/increment", credential, 8u32, 0u64, body, 1000u32)
    let refusal = http_law_post(d.net, d.clock, addr, "/.hirsel/op/increment", credential, 8u32, 0u64, b"{\"request\":\"Unit\"}", 1000u32)
    if committed_error.status != 422u16 || !committed_error.committed || refusal.status != 422u16 || refusal.committed || committed_error.body != b"{\"refused\":\"request_mismatch\"}" || refusal.body != committed_error.body {
        fail("L10j the committed 422 and protocol 422 lacked distinct authoritative markers")
    }
    let duplicate = b"{\"request\":{\"Normalized\":[[\"A\",null],[\"a\",null]]}}"
    let response = http_law_post(d.net, d.clock, addr, "/generated", credential, 7u32, position, duplicate, 1000u32)
    if response.status != 400u16 || response.committed || response.body != b"{\"refused\":\"malformed\",\"kind\":3}" {
        fail("L10j the live codec accepted keys equal after via decoding")
    }
    if http_law_count(http_law_wire(socket, 7u32, position, 0u32, 1000u32, b"\x00\x00\x00\x00")) != position + 1u64 {
        fail("L10j a duplicate key consumed a position")
    }
}

fn http_law_refusals(d: HttpLawDrive, addr: Addr, socket: wire_client.Conn, keys: List[Bytes]) waits {
    let credential = http_law_credential()
    if let Error(Protocol(1008u16)) = http_law_socket(d, keys, std.http.copy_bytes(b"bad")) {} else {
        fail("L11 the wire binding did not refuse the credential")
    }
    let unit_arg = b"\x00\x00\x00\x00"
    if http_law_post(d.net, d.clock, addr, "/run", b"bad", 4u32, 0u64, unit_arg, 1000u32).status != 401u16 || http_law_post(d.net, d.clock, addr, "/denied", credential, 4u32, 0u64, unit_arg, 1000u32).status != 403u16 || http_law_post(d.net, d.clock, addr, "/run", credential, 4u32, 0u64, b"\xff", 1000u32).status != 400u16 || http_law_post(d.net, d.clock, addr, "/run", credential, 4u32, 0u64, unit_arg, 0u32).status != 504u16 {
        fail("L11 an HTTP refusal had the wrong status")
    }
    if let Refused(NotAllowed) = http_law_wire(socket, 4u32, 0u64, 1u32, 1000u32, unit_arg) {} else {
        fail("L11 wire allowed a query as Call")
    }
    if let Refused(Malformed(_)) = http_law_wire(socket, 4u32, 0u64, 0u32, 1000u32, b"\xff") {} else {
        fail("L11 wire allowed malformed arguments")
    }
    if let Refused(Deadline) = http_law_wire(socket, 4u32, 0u64, 0u32, 0u32, unit_arg) {} else {
        fail("L11 wire allowed a zero send deadline")
    }
    if http_law_count(http_law_wire(socket, 4u32, 0u64, 0u32, 1000u32, unit_arg)) != 1u64 {
        fail("L11 a refusal ran the body or closed the position")
    }
    // With position zero missing, the head waits on position one. The send
    // can expire, but release of its one position must wait for the head.
    if http_law_post(d.net, d.clock, addr, "/run", credential, 9u32, 1u64, unit_arg, 100u32).status != 409u16 || http_law_post(d.net, d.clock, addr, "/run", credential, 10u32, 0u64, unit_arg, 1000u32).status != 503u16 {
        fail("L11 the expired send released the held position")
    }
    if http_law_count(http_law_wire(socket, 10u32, 0u64, 0u32, 1000u32, unit_arg)) != 2u64 {
        fail("L11 the relay capacity refusal forwarded the request")
    }
}

fn http_law_run(c: Clock, r: Random, tasks: Tasks, n: Net, case: HttpLawCase) -> Result[(), ()] waits {
    let info = result.unwrap(store.sized(Memory, 33554432u64))
    let db = store.memory(c, r, info)
    let (head, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(32u64)
    let mail = result.unwrap(mailbox(16u64))
    let drive = HttpLawDrive(head: take head, publisher_out: post(mail), net: n, clock: c, random: r, tasks: tasks, case: case)
    let work = task.spawn(tasks, bytes 16777216u64, take drive, http_law_drive)
    result.unwrap(place_head(take db, code.describe(http_law_place), HTTP_LAW_PLACE_BYTES, None, code.describe(http_law_schema), take inbox, take mail, tasks, 1048576u64))
    match task.join(take work) {
        Ok(()) => Ok(()),
        Error(Failed(causes)) => fail(http_law_cause(causes)),
        Error(Cancelled(causes)) => fail(http_law_cause(causes)),
    }
}

fn http_law_cause(causes: Causes) -> String {
    let mut message = string.from("HTTP law child: ")
    for cause in causes {
        match cause.kind {
            Fail(detail) => string.push(mut message, detail),
            Capacity(problem) => {
                string.push(mut message, "Capacity ")
                string.push_u64(mut message, problem.requested)
                string.push(mut message, " of ")
                string.push_u64(mut message, problem.available)
            },
            Overflow => string.push(mut message, "Overflow"),
            Bounds => string.push(mut message, "Bounds"),
            Division => string.push(mut message, "Division"),
            Unwrap => string.push(mut message, "Unwrap"),
            Cancelled => string.push(mut message, "Cancelled"),
            OutOfTime => string.push(mut message, "OutOfTime"),
        }
        string.push(mut message, " at native site ")
        string.push_u64(mut message, site_word(cause.site))
        break
    }
    take message
}

@test
fn test_l10(c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), ()] waits {
    http_law_run(c, r, tasks, n, RawParity)
}

@test
fn test_l11(c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), ()] waits {
    http_law_run(c, r, tasks, n, RawRefusals)
}

@test
fn test_l10j(c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), ()] waits {
    http_law_run(c, r, tasks, n, GeneratedParity)
}

pub fn law_j2_binding(c: Clock, r: Random, tasks: Tasks, n: Net) -> bool waits {
    runner_calls.law_granted_copied(c, r, tasks, n) && runner_calls.law_bind_granted(c, r, tasks, n) && match http_law_run(c, r, tasks, n, BindCodes) {
        Ok(()) => true,
        Error(()) => false
    }
}

@test
fn test_j2_binding(r: Random, tasks: Tasks, n: Net) -> Result[(), ()] waits {
    let (clock, take test_clock_hand) = provide.clock(0u64, 1000u64)
    let passed = law_j2_binding(clock, r, tasks, n)
    let _ = take test_clock_hand
    if passed {
        Ok(())
    } else {
        Error(())
    }
}

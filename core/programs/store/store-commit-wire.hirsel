pub scoped type CallView {
    key: View[Bytes],
    args: View[Bytes],
    issuer: u8,
    subject: View[Bytes],
    t: u64,
    n: u64,
    revision: View[Option[Bytes]],
    code: View[Bytes]
}

pub fn encode_call(mut payload: Bytes, record: CallView, settlement: Option[Settlement]) -> Result[(), Capacity] {
    encode_call_fields(mut payload, record.key, record.args, record.revision, record.code, settlement)
}

pub fn encode_call_fields(mut payload: Bytes, entry_key: Bytes, args: Bytes, revision: Option[Bytes], signature: Bytes, settlement: Option[Settlement]) -> Result[(), Capacity] {
    blob(mut payload, entry_key)?
    blob(mut payload, args)?
    if let Some(raw) = revision {
        blob(mut payload, raw)?
    } else {
        le(mut payload, 0, 4)?
    }
    blob(mut payload, signature)?
    match settlement {
        None => le(mut payload, 0, 1),
        Some(context) => {
            le(mut payload, int.widen(context.way), 1)?
            types.append_be(mut payload, context.base, 8)?
            types.append_be(mut payload, context.at, 8)?
            types.append_be(mut payload, context.seed, 8)?
            match context.stop {
                Some(Raised) => le(mut payload, 1, 1),
                Some(OutOfSteps(steps)) => {
                    le(mut payload, 2, 1)?
                    types.append_be(mut payload, steps, 8)
                },
                Some(OutOfBytes) => le(mut payload, 3, 1),
                Some(Conflict) => le(mut payload, 4, 1),
                None => Ok(()),
            }
        }
    }
}

pub fn call_section_bytes(key: Bytes, args: Bytes, revision: Option[Bytes], code_raw: Bytes, settlement: Option[Settlement]) -> u64 {
    call_fields_size(key, args, revision, code_raw, settlement)
}

pub fn keyed_record_size(entry: Bytes, args: Bytes, revision: Option[Bytes], code_raw: Bytes, settlement: Option[Settlement]) -> u64 {
    call_fields_size(entry, args, revision, code_raw, settlement)
}

pub fn call_fields_size(entry_key: Bytes, args: Bytes, revision: Option[Bytes], signature: Bytes, settlement: Option[Settlement]) -> u64 {
    let revision_bytes = match revision {
        Some(raw) => list.len(raw),
        None => 0u64
    }
    let extra: u64 = match settlement {
        Some(Settlement(stop: Some(OutOfSteps(_)), ..)) => 33,
        Some(Settlement(stop: Some(_), ..)) => 25,
        Some(_) => 24,
        None => 0,
    }
    17 + list.len(entry_key) + list.len(args) + revision_bytes + list.len(signature) + extra
}

pub fn decode_call(file: String, raw: Bytes, mut at: u64, take stream: Bytes) -> Result[CallSection, types.Failure] {
    let (take fields, settlement) = decode_call_fields(file, raw, mut at)?
    let Some(take name) = parse_stream_key(stream) else {
        return Error(disk_fault(file, at, Malformed))
    }
    let KeyedCallRecordRep(entry: take entry_key, args: take args, revision: take revision, code: take signature) = take fields
    let record = CallRecordRep(key: take entry_key, args: take args, stream: take name, revision: take revision, code: take signature)
    Ok(CallSection(record: take record, settlement: settlement))
}

pub fn decode_call_fields(file: String, raw: Bytes, mut at: u64) -> Result[(KeyedCallRecordRep, Option[Settlement]), types.Failure] {
    let key = disk_blob(file, raw, mut at, 16777280)?
    let args = disk_blob(file, raw, mut at, 16777280)?
    let revision_at = at
    let revision_bytes = disk_blob(file, raw, mut at, 32)?
    let revision: Option[Bytes] = match list.len(revision_bytes) {
        0 => None,
        32 => Some(take revision_bytes),
        _ => return Error(disk_fault(file, revision_at, Malformed))
    }
    let code_at = at
    let code = disk_blob(file, raw, mut at, 48)?
    if !call_code_size(list.len(code)) {
        return Error(disk_fault(file, code_at, Malformed))
    }
    let way: u8 = int.truncate(disk_number(file, raw, mut at, 1)?)
    let settlement: Option[Settlement] = match way {
        0 => None,
        1 => Some(decode_settlement(file, raw, mut at, way)?),
        2 => Some(decode_settlement(file, raw, mut at, way)?),
        _ => return Error(disk_fault(file, at - 1, Malformed)),
    }
    Ok((KeyedCallRecordRep(entry: take key, args: take args, revision: take revision, code: take code), settlement))
}

pub type DataOrder = InOrder | ReversePair | SortedSlots(List[u64])

pub fn stored_prior(raw: Option[View[Bytes]]) -> u32 {
    match raw {
        Some(value) => int.truncate(1 + list.len(value)),
        None => 0,
    }
}

fn expect_row(step: sqlite.Step) {
    match step {
        Row => {},
        Done => fail("expected a SQLite row"),
    }
}

fn expect_error(e: sqlite.SqliteError, code: i32, text: String) {
    if e.code != code || e.message != text {
        fail("unexpected SQLite error")
    }
}

@test
fn fl8_blob_round_trip(f: Foreign[sqlite.Sqlite]) -> Result[(), sqlite.SqliteError] waits {
    let mut db = sqlite.open_memory(f)?
    sqlite.exec(mut db, "create table t(b blob)")?
    let mut insert = sqlite.prepare(mut db, "insert into t values (?1)")?
    let mut src: Bytes = list.new()
    sqlite.bind_bytes(mut insert, 1, src)?
    list.fill(mut src, 2, 9)
    let _ = sqlite.step(mut insert)?
    sqlite.reset(mut insert)?
    sqlite.bind_null(mut insert, 1)?
    let _ = sqlite.step(mut insert)?
    sqlite.reset(mut insert)?
    list.clear(mut src)
    list.push(mut src, 0)
    list.push(mut src, 255)
    sqlite.bind_bytes(mut insert, 1, src)?
    list.clear(mut src)
    list.fill(mut src, 2, 9)
    let _ = sqlite.step(mut insert)?
    sqlite.finalize(take insert)?
    let mut select = sqlite.prepare(mut db, "select b from t order by rowid")?
    let mut out: Bytes = list.new()
    expect_row(sqlite.step(mut select)?)
    match sqlite.column_kind(mut select, 0) {
        Blob => {},
        _ => fail("empty blob changed kind"),
    }
    sqlite.column_bytes(mut select, 0, mut out)?
    if list.len(out) != 0 {
        fail("empty blob changed length")
    }
    expect_row(sqlite.step(mut select)?)
    match sqlite.column_kind(mut select, 0) {
        Null => {},
        _ => fail("NULL changed kind"),
    }
    expect_row(sqlite.step(mut select)?)
    match sqlite.column_kind(mut select, 0) {
        Blob => {},
        _ => fail("blob changed kind"),
    }
    sqlite.column_bytes(mut select, 0, mut out)?
    if list.len(out) != 2 || out[0] != 0 || out[1] != 255 {
        fail("bound bytes changed")
    }
    sqlite.finalize(take select)?
    sqlite.close(take db)
}


// L4's native case (RUNNER-SPEC v2.5 §8): one program, two modes, compared by
// core/tools/runner_tests.py on the charge-observation runtime's peak_retained_bytes.
// argv: number of malformed calls before the valid call. Each malformed call appends
// one byte to a 4,096-byte String, so the decoder reads the full String before refusal.
type Hd: shareable + send {
    t: store.Table[u64, u64]
}

type Calls = runner.Registry[(), Hd]

fn schema(mut d: store.Declare) -> Result[Hd, store.Error] {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let table = store.declare_table(mut d, "data", std.codec.key_u64(), cv)?
    let t = store.finish(mut d, take table)?
    Ok(Hd(t: t))
}

fn named(mut tx: store.Tx, h: Hd, author: runner.Caller, take s: String) -> Result[u64, u32] {
    match store.put(mut tx, h.t, 0u64, string.byte_len(s)) {
        Ok(()) => Ok(string.byte_len(s)),
        Error(_) => Error(1u32),
    }
}

fn place(mut r: Calls) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(named), 16384u64, runner.DEFAULT_STEPS)
}

fn k_named() -> Bytes {
    let mut key: Bytes = list.new()
    list.append(mut key, code.identity(code.describe(named)))
    std.codec.put_u64(result.unwrap(std.codec.fingerprint(std.codec.of_string())), mut key)
    let carried: std.codec.Codec[Result[u64, u32]] = std.codec.of()
    std.codec.put_u64(result.unwrap(std.codec.fingerprint(carried)), mut key)
    key
}

fn string_arg(n: u64, trailing: bool) -> Bytes {
    let mut s: Bytes = list.new()
    for _ in 0u64 .. n {
        list.push(mut s, 97u8)
    }
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_string(result.unwrap(string.from_utf8(take s)), mut b))
    if trailing {
        list.push(mut b, 0u8)
    }
    b
}

type D: send {
    head: Sender[runner.HeadInput],
    post: Sender[runner.PubIn],
    clock: Clock,
    tasks: Tasks,
    flood: u64,
    net: Net,
    random: Random
}

fn answer(cn: wire_client.Conn) -> runner.Outcome waits {
    match wire_client.next(cn) {
        Ok(Batch(_, _, _, take outcomes)) => {
            for take t in outcomes {
                let runner.Done(stream: _, p: _, outcome: take o) = take t
                return take o
            }
            fail("runner_rss: empty Batch")
        },
        Ok(_) => fail("runner_rss: a frame other than a Batch"),
        Error(_) => fail("runner_rss: client socket closed"),
    }
}

fn drive(take d: D) -> () waits {
    let mut requested: List[Bytes] = list.new()
    list.push(mut requested, k_named())
    let unbound: Option[runner.BindGrant[()]] = None
    let (cn, session) = result.unwrap(wire_client.pair(d.tasks, d.net, d.clock, d.random, take unbound, d.head, d.post, code.describe(place), requested, None, 1u64, 2097152u64))
    let bad = string_arg(4096u64, true)
    for _ in 0u64 .. d.flood {
        let a: Bytes = clone(bad)
        let request: runner.Frame = Call(store.StreamId(t: 0u64, n: 0u64), 0u64, 0u32, 4294967295u32, take a)
        wire_client.send_frame(cn, take request)
        match answer(cn) {
            Refused(Malformed(_)) => (),
            _ => fail("runner_rss: a malformed call not Refused(Malformed)"),
        }
    }
    let request: runner.Frame = Call(store.StreamId(t: 0u64, n: 0u64), 0u64, 0u32, 4294967295u32, string_arg(4096u64, false))
    wire_client.send_frame(cn, take request)
    match answer(cn) {
        Returned(_) => (),
        _ => fail("runner_rss: the valid call not Returned"),
    }
    let _ = wire_client.close(take cn)
    let _ = task.join(take session)
}

pub fn main(clock: Clock, random: Random, tasks: Tasks, argv: Args, net: Net) -> Result[(), Exit] waits {
    let Some(m) = args.get(argv, 0) else {
        return Error(Exit(status: 2))
    }
    let flood = result.unwrap(std.int.parse_uint(m, 10u32))
    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mail = result.unwrap(runner.mailbox(4u64))
    let d = D(head: take head, post: runner.post(mail), clock: clock, tasks: tasks, flood: flood, net: net, random: random)
    let driving = task.spawn(tasks, bytes 33554432u64, take d, drive)
    match runner.place_head(take db, code.describe(place), 1048576u64, None, code.describe(schema), take inbox, take mail, tasks, 1048576u64) {
        Ok(()) => (),
        Error(_) => return Error(Exit(status: 4)),
    }
    match task.join(take driving) {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 6)),
    }
}

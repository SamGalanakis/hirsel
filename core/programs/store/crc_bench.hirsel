// R9: 10,000 CRCs of the same 4-KiB image. Runtime Args prevents constant folding.
pub fn main(argv: Args, out: Stdout) -> Result[(), Exit] waits {
    let loops = result.unwrap(int.parse(option.unwrap(args.get(argv, 0))))
    let mut image: Bytes = result.unwrap(list.with_capacity(4096))
    for i in 0u64 .. 4096 {
        result.unwrap(list.push(mut image, int.truncate(i * 17 + 3)))
    }
    let mut sum: u64 = 0
    for _ in 0u64 .. loops {
        sum = int.wrapping_add(sum, int.widen(std.check.crc32c(image)))
    }
    let mut rendered = string.new()
    result.unwrap(string.push_u64(mut rendered, sum))
    result.unwrap(string.push(mut rendered, "\n"))
    match stdout.write(out, rendered) { Ok(()) => Ok(()), Error(_) => Error(Exit(status: 8)) }
}

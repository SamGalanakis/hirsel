// hand-derived step slices: 3
// hand-derived try-send by task: 43690,43690
// Spawn costs the parent one step, so the child starts with 131071.
// The parent's unwrap and the child's entry each cost one. Both then have
// 131070 steps for trips of send, receive and latch. Each stops at its
// 43691st send, regardless of which one runs first. The parent has two
// slice ends and the child has one.
type Pair: send { tx: Sender[u64], rx: Receiver[u64] }
fn spin(take p: Pair) {
    loop { let _ = channel.try_send(p.tx, 0u64); let _ = channel.try_receive(p.rx) }
}
pub fn main(tasks: Tasks) -> Result[(), Exit] waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    let (peer_tx, peer_rx): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    let peer = Pair(tx: take peer_tx, rx: take peer_rx)
    let stopped = bound steps 131072 {
        let child = task.spawn(tasks, bytes 4096, take peer, spin)
        loop { let _ = channel.try_send(tx, 0u64); let _ = channel.try_receive(rx) }
    }
    match stopped {
        Error(e) => if e.steps == 131072 { Ok(()) } else { Error(Exit(status: 1)) },
        _ => Error(Exit(status: 2)),
    }
}

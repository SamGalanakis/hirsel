// Module `int` (SEM-1).

pub fn wrapping_add[T: integer](a: T, b: T) -> T
pub fn wrapping_sub[T: integer](a: T, b: T) -> T
pub fn wrapping_mul[T: integer](a: T, b: T) -> T
pub fn wrapping_neg[T: integer](a: T) -> T
pub fn wrapping_shl[T: integer](a: T, n: u32) -> T
pub fn checked_add[T: integer](a: T, b: T) -> Option[T]
pub fn checked_sub[T: integer](a: T, b: T) -> Option[T]
pub fn checked_mul[T: integer](a: T, b: T) -> Option[T]
pub fn checked_div[T: integer](a: T, b: T) -> Option[T]
pub fn saturating_add[T: integer](a: T, b: T) -> T
pub fn saturating_sub[T: integer](a: T, b: T) -> T
pub fn saturating_mul[T: integer](a: T, b: T) -> T
pub fn mul_wide(a: u64, b: u64) -> (u64, u64)
pub fn leading_zeros[T: integer](x: T) -> u32
pub fn widen[T: integer, U: integer](x: T) -> U
pub fn narrow[T: integer, U: integer](x: T) -> U
pub fn try_narrow[T: integer, U: integer](x: T) -> Option[U]
pub fn truncate[T: integer, U: integer](x: T) -> U
pub fn parse[T: integer](s: String) -> Result[T, ParseError] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if n == 0 {
        return Error(Empty)
    }
    let ten: T = int.narrow(10u8)
    // T is signed exactly when it holds -1.
    let minus_one: Option[T] = int.try_narrow(-1i8)
    let negative = b[0] == b'-' && match minus_one {
        Some(_) => true,
        None => false,
    }
    let start: u64 = if negative {
        1
    } else {
        0
    }
    if start == n {
        return Error(Invalid(0))
    }
    // The grammar is checked to the end before the range: past the first value that does
    // not fit, the digits are still read.
    let mut v: T = int.narrow(0u8)
    let mut fits = true
    for i in start .. n {
        let x = b[i]
        if x < b'0' || x > b'9' {
            return Error(Invalid(i))
        }
        if fits {
            let d: T = int.narrow(x - b'0')
            // Toward the sign, so a signed MIN fits.
            let next: Option[T] = match int.checked_mul(v, ten) {
                Some(m) => if negative {
                    int.checked_sub(m, d)
                } else {
                    int.checked_add(m, d)
                },
                None => None,
            }
            match next {
                Some(m) => {
                    v = m
                },
                None => {
                    fits = false
                },
            }
        }
    }
    if fits {
        Ok(v)
    } else {
        Error(OutOfRange)
    }
}

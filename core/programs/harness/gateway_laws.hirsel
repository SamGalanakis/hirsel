// Laws for the gateway. Each session's place runs in the gateway's directory on a
// Disk backing, against scripted, test-owned services. See README.md.
const BYTES: u64 = 131072u64

const PLACE_BYTES: u64 = 1048576u64

const IDLE_MS: u64 = 300u64

const WITHIN_MS: u64 = 5000u64

// An effect may run the subagent, whose wire client spawns a 1 MiB reader and writer.
const EFFECT_BYTES: u64 = 6291456u64

const EFFECT_GRANT: u64 = 8388608u64

// ---- scripted services ----
// What every session's place shares: the scripted model, the test's hold on `tally`, and
// the gateway's door for the subagent tool. Each place adds its own name and services.
type Services: send {
    model: Sender[Sender[()]],
    tallies: Sender[Sender[()]],
    door: harness.gateway.Door,
    name: String,
    tasks: Tasks,
    clock: Clock,
    random: Random,
    net: Net,
    preview: Option[harness.preview.Door],
    chunks: u64,
}

type Grants: send {
    handles: harness.Handles,
    context: runner.TriggerContext,
    s: Services
}

fn usage() -> harness.Usage {
    harness.Usage(input: 10u64, output: 5u64, cache_read: 0u64, cache_write: 0u64, reasoning: 0u64)
}

fn call_of(take name: String) -> harness.Call {
    harness.Call(id: "c1", name: take name, args: Inline(string.into_bytes("{}")))
}

fn asking(take name: String) -> harness.Answer {
    let mut calls: List[harness.Call] = list.new()
    list.push(mut calls, call_of(take name))
    harness.Answer(text: "", calls: take calls, stop: "end", usage: usage())
}

fn finished() -> harness.Answer {
    harness.Answer(text: "done", calls: list.new(), stop: "end", usage: usage())
}

// The model must wait (LANG-8), so it asks a service that answers every ask at once.
fn model_service(take inbox: Receiver[Sender[()]]) -> () waits {
    while let Ok(reply) = channel.receive(inbox) {
        let _ = channel.send(reply, ())
    }
}

fn ask_service(to: Sender[Sender[()]]) -> Result[(), harness.Fault] waits {
    let (reply, replied): (Sender[()], Receiver[()]) = channel.new(1u64)
    if let Error(_) = channel.send(to, take reply) {
        return Error(Unavailable)
    }
    match channel.receive(replied) {
        Ok(()) => Ok(()),
        Error(_) => Error(Unavailable)
    }
}

// The script: once a tool has answered, end with "done"; before that, call the tool the
// user's message names ("bump it", "tally it", "delegate it").
fn scripted_model(g: Grants, take r: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    if g.s.chunks > 0u64 {
        return streaming_model(g, take r, mut sink)
    }
    let mut tool = "bump"
    for e in r.messages {
        match e {
            ToolResult(_, _, _) => return Ok(finished()),
            User(text) => if text == "tally it" {
                tool = "tally"
            } else if text == "delegate it" {
                tool = "delegate"
            },
            _ => (),
        }
    }
    ask_service(g.s.model) ?=> |_| Rejected("scripted model unavailable")
    Ok(asking(string.from(tool)))
}

fn preview_answer() -> harness.Answer {
    let mut text = string.with_capacity(10000u64)
    for i in 0u64 .. 10000u64 {
        string.push(mut text, "x")
    }
    harness.Answer(text: take text, calls: list.new(), stop: "end", usage: usage())
}

fn streaming_model(g: Grants, take r: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let answer = preview_answer()
    let width = 10000u64 / g.s.chunks
    ask_service(g.s.model) ?=> |_| Rejected("scripted model unavailable")
    for i in 0u64 .. g.s.chunks {
        if let Some(mut p) = sink {
            harness.preview.delta(mut p, string.slice(answer.text, i * width, (i + 1u64) * width))
        }
        if i == 0u64 {
            ask_service(g.s.model) ?=> |_| Rejected("scripted model unavailable")
        }
    }
    Ok(take answer)
}

fn bump(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    if let Some(_) = view g.s.preview {
        ask_service(g.s.tallies)?
    } else {
        ask_service(g.s.model)?
    }
    Ok(string.into_bytes("1"))
}

// Answers when the test lets it; the test counts each run.
fn tally(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    ask_service(g.s.tallies)?
    Ok(string.into_bytes("1"))
}

fn child_of(s: Services) -> harness.gateway.Child {
    let views: std.codec.Codec[harness.View] = std.codec.of()
    harness.gateway.Child(submit: runner.client.transact_entry(code.describe(submit_entry)), shown: runner.client.query_as_entry(code.describe(harness.window), result.unwrap(harness.window_slots())), keys: result.unwrap(runner.client.entry_keys(code.describe(place))), socket: wire().socket, authority: string.into_bytes("localhost"), tasks: s.tasks, clock: s.clock, random: s.random, net: s.net, within_ms: WITHIN_MS)
}

// The subagent: a child session, keyed by this place and this effect's trigger run,
// asked to tally.
fn delegate(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    let key = harness.gateway.child_key(g.s.name, g.context)
    harness.gateway.ask(g.s.door, take key, Fresh("scripted", All), child_of(g.s), "tally it")
}

fn hold_bump(tx: store.Tx, h: harness.Handles, app: (), ask: harness.Ask) -> harness.Verdict {
    if ask.call.name == "bump" {
        Hold("bump needs approval")
    } else {
        Pass
    }
}

// ---- the session place: the agent, its trigger entries and its wire entries ----
fn gated_agent() -> harness.Agent[Grants, ()] {
    let mut a = harness.agent("gated", "scripted", code.describe(scripted_model), ())
    list.push(mut a.tools, harness.outside("bump", "adds one", "{}", Once, code.describe(bump)))
    list.push(mut a.tools, harness.outside("tally", "counts one", "{}", Once, code.describe(tally)))
    list.push(mut a.tools, harness.outside("delegate", "asks a subagent", "{}", Once, code.describe(delegate)))
    list.push(mut a.gates, harness.Gate(name: "hold", check: code.describe(hold_bump)))
    a
}

fn wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(advance), code.describe(effect))
}

fn advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    let w = wired()?
    harness.advance_park(mut tx, h, gated_agent(), w, take wake)
}

fn effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    let target = match g.s.preview {
        Some(p) => Some(harness.preview.target(p, g.s.name, g.s.clock)),
        None => None,
    }
    harness.effect(g.context, g.handles, g, take key, gated_agent(), code.describe(settle), take target)
}

fn settle(mut tx: store.Tx, h: harness.Handles, a: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = wired() else {
        return Error(Missing("harness: wiring"))
    }
    harness.settle(mut tx, h, gated_agent(), w, a, take m)
}

fn submit_entry(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take m: harness.Submit) -> Result[harness.Disposition, harness.Refused] {
    let w = wired()?
    harness.submit(mut tx, h, gated_agent(), w, caller, NextTurn, take m)
}

fn decide_entry(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take d: harness.Decision) -> Result[harness.Ruling, harness.Refused] {
    let w = wired()?
    harness.decide(mut tx, h, gated_agent(), w, caller, take d)
}

fn revoke_reader(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take unused: ()) -> Result[(), harness.Refused] {
    harness.set_reader(mut tx, h, caller, false)
}

fn place(mut r: runner.Registry[Grants, harness.Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(advance), code.describe(effect), code.describe(settle), harness.select_handles, BYTES, EFFECT_BYTES)?
    runner.transact(mut r, code.describe(submit_entry), BYTES, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(decide_entry), BYTES, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(revoke_reader), BYTES, runner.DEFAULT_STEPS)?
    harness.pending_waits_entry(mut r, BYTES, runner.DEFAULT_STEPS)?
    let windows: std.codec.Codec[harness.View] = std.codec.of()
    runner.query_as(mut r, code.describe(harness.window), harness.window_slots()?, BYTES, runner.DEFAULT_STEPS)?
    runner.query_as(mut r, code.describe(harness.history_cuts), harness.cut_slots()?, BYTES, runner.DEFAULT_STEPS)
}

fn services_of(s: Services, take name: String) -> Services {
    Services(model: channel.sender(s.model), tallies: channel.sender(s.tallies), door: harness.gateway.copy_door(s.door), name: take name, tasks: s.tasks, clock: s.clock, random: s.random, net: s.net, preview: match s.preview {
        Some(p) => Some(harness.preview.copy_door(p)),
        None => None
    }, chunks: s.chunks)
}

fn make_grants(s: Services, h: harness.Handles, take ctx: runner.TriggerContext) -> Result[Grants, Capacity] {
    Ok(Grants(handles: clone(h), context: take ctx, s: services_of(s, string.from(s.name))))
}

fn wire() -> runner.WireConfig {
    let mut w = runner.wire_defaults(65536u64)
    w.n_pool = 4194304u64
    w
}

// The host replaces the backing, selection, idle time and wire session count with its own (§14.9). The binding maps
// one credential to one Caller across connections, as a browser's login would.
fn session_place(take supplied: platform.local.Supplied, s: Services) -> Result[runner.PlaceConfig[Grants, harness.Handles, Services, ()], Capacity] {
    let w = result.unwrap(wired())
    let config = runner.TriggerConfig(entries: harness.entries(w), author: store.Caller(issuer: 0u8, subject: list.new()))
    let config_grants: runner.Grants[Grants, harness.Handles, Services] = runner.Grants(seed: services_of(s, string.from(supplied.name)), attempt: Some(make_grants), call: None, grant_bytes: EFFECT_GRANT)
    Ok(runner.PlaceConfig(backing: Memory, sizes: store.derived_sizes(), selection: Reopen, place: code.describe(place), n_place: PLACE_BYTES, on_migrate: None, schema: code.describe(harness.declare_tables), session: wire(), max_sessions: 1u64, proxies: list.new(), n_publisher: PLACE_BYTES, listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: supplied.net, tasks: supplied.tasks, clock: supplied.clock, random: supplied.random, stop: runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: Some(runner.wire_bind(latest.new(arc.new(())), code.describe(runner.ingress.caller), 4096u64, 65536u64)), grants: Some(take config_grants), triggers: Some(take config), idle: Some(IDLE_MS)))
}

fn session_factory() -> platform.local.Factory[Services] {
    platform.local.seeded_factory(session_place)
}

// ---- driving a session through the gateway ----
fn bytes_of[A: codec](a: A) -> Bytes {
    let codec: std.codec.Codec[A] = std.codec.of()
    let mut raw: Bytes = list.new()
    result.unwrap(std.codec.encode(codec, a, mut raw))
    take raw
}

// Routes to a session (waking it), makes one wire call and lets go of the session.
fn call_routed[A: codec, R: codec](door: harness.gateway.Door, id: u64, credential: Bytes, first_p: u64, e: runner.fixture.Callee[A, R], take a: A, tasks: Tasks, clock: Clock, random: Random, net: Net) -> Result[R, u64] waits {
    let lease = match harness.gateway.route(door, id) {
        Ok(take l) => take l,
        Error(Place(_)) => return Error(101u64),
        Error(_) => return Error(100u64)
    }
    let Some(address) = latest.read(platform.local.status(lease)).addr else {
        return Error(102u64)
    }
    let Ok(keys) = runner.fixture.entry_keys(code.describe(place)) else {
        return Error(103u64)
    }
    let Ok(take c) = runner.fixture.client_at(tasks, net, clock, random, keys, wire().socket, address, Some(clone(credential)), first_p, WITHIN_MS) else {
        return Error(104u64)
    }
    let mut client = take c
    let replied = runner.fixture.call(mut client, e, take a, 5000u32)
    runner.fixture.close(take client)
    let _ = take lease
    match take replied {
        Ok(runner.fixture.Replied(answer: Returned(take r), ..)) => Ok(take r),
        Ok(runner.fixture.Replied(answer: Failed(_), ..)) => Error(105u64),
        Ok(runner.fixture.Replied(answer: Refused(_), ..)) => Error(106u64),
        Ok(_) => Error(107u64),
        Error(_) => Error(108u64),
    }
}

// Waits for the session's place to stop by itself.
fn stopped(changes: Receiver[platform.local.Change]) -> bool waits {
    while let Ok(c) = channel.receive(changes) {
        if let Down(u) = c {
            return match u.ended {
                Ok(Stopped(_)) => true,
                _ => false
            }
        }
    }
    false
}

fn transcript_of(dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> List[Bytes] waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let snap = store.snapshot(db)
    let mut out: List[Bytes] = list.new()
    if let Ok(Some(s)) = store.get(result.unwrap(store.reader(db, 0u64)), snap, h.session, 0u64) {
        for p in 0u64 .. s.next_pos {
            if let Ok(Some(e)) = store.get(result.unwrap(store.reader(db, 0u64)), snap, h.entries, p) {
                list.push(mut out, bytes_of(e))
            }
        }
    }
    result.unwrap(store.close(take db))
    out
}

// The session's log, derived by hand from the script: the user's message, the first
// request's baseline offering `bump`, the answer that calls it, its result and the end.
fn expected_log() -> List[Bytes] {
    log_of("bump", Returned(Inline(string.into_bytes("1"))))
}

fn log_of(take tool: String, take outcome: harness.Outcome) -> List[Bytes] {
    let mut defs: List[harness.ToolDef] = list.new()
    list.push(mut defs, harness.ToolDef(name: "bump", about: "adds one", input: "{}", rev: 1u64, catalog: None))
    list.push(mut defs, harness.ToolDef(name: "tally", about: "counts one", input: "{}", rev: 1u64, catalog: None))
    list.push(mut defs, harness.ToolDef(name: "delegate", about: "asks a subagent", input: "{}", rev: 1u64, catalog: None))
    let mut said = string.from(tool)
    string.push(mut said, " it")
    let mut entries_want: List[harness.Entry] = list.new()
    list.push(mut entries_want, User(take said))
    list.push(mut entries_want, System(harness.Patch(baseline: true, changes: list.new(), tools: Some(take defs))))
    list.push(mut entries_want, Assistant(asking(take tool)))
    list.push(mut entries_want, ToolResult("c1", clone(outcome), harness.worded(outcome)))
    list.push(mut entries_want, Assistant(finished()))
    let mut log: List[Bytes] = list.new()
    for e in entries_want {
        list.push(mut log, bytes_of(e))
    }
    log
}

// Law W1 (wake on demand): a session whose place stopped by itself while a call waits
// for approval is woken by the route that carries the approval, and resumes: the log
// read while it was unloaded is unchanged, and the run finishes it exactly as the script
// says. Oracle: the hand-derived log; the first three entries are the log at unload.
// The answer is the first check that failed, or 0.
pub fn law_wake_resumes_transcript(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> u64 waits {
    let mut name = string.with_capacity(32u64)
    let root = result.unwrap(host.mkdtemp(parent, mut name))
    let (asks, inbox): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let modelling = task.spawn(tasks, bytes 1048576u64, take inbox, model_service)
    let (tallies, _held): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let (watch, changes): (Sender[platform.local.Change], Receiver[platform.local.Change]) = channel.new(64u64)
    let way: harness.gateway.Doorway = harness.gateway.doorway(harness.declare_tables)
    let door = harness.gateway.door_of(way)
    let seed = Services(model: take asks, tallies: take tallies, door: harness.gateway.door_of(way), name: "", tasks: tasks, clock: clock, random: random, net: net, preview: None, chunks: 0u64)
    let config = harness.gateway.GatewayConfig(root: root, options: runner.triggers.law_options(), factory: session_factory(), max_sessions: 1u64, idle_ms: IDLE_MS, place_bytes: 67108864u64, tasks: tasks, clock: clock, random: random, net: net, watch: Some(take watch), seed: take seed)
    let g = match harness.gateway.gateway(take way, take config) {
        Ok(take made) => take made,
        Error(_) => return 1u64
    }
    let id = match harness.gateway.create(door, string.into_bytes("first"), Fresh("scripted", All)) {
        Ok(n) => n,
        Error(_) => return 2u64
    }
    let submit = runner.fixture.transact_entry(code.describe(submit_entry))
    let credential = runner.ingress.credential(random)
    let placed = match call_routed(door, id, credential, 0u64, submit, harness.Submit(client_key: "k1", text: "bump it"), tasks, clock, random, net) {
        Ok(Ok(Placed(_))) => true,
        Error(n) => return n,
        _ => false,
    }
    if !placed {
        return 3u64
    }
    if !stopped(changes) {
        return 4u64
    }
    let session_dir = result.unwrap(std.dir.narrow(root, "s0"))
    let at_unload = transcript_of(session_dir, clock, random, tasks)
    let want = expected_log()
    if list.len(at_unload) != 3u64 {
        return 5u64
    }
    for i in 0u64 .. 3u64 {
        if at_unload[i] != want[i] {
            return 6u64
        }
    }
    let key = harness.approval_key("bump", 1u64, Inline(string.into_bytes("{}")))
    let decide = runner.fixture.transact_entry(code.describe(decide_entry))
    let d = harness.Decision(run: 0u64, round: 0u64, ordinal: 0u64, key: take key, allow: true)
    match call_routed(door, id, credential, 1u64, decide, take d, tasks, clock, random, net) {
        Ok(Ok(Approved)) => (),
        Ok(_) => return 7u64,
        Error(n) => return n + 100u64,
    }
    if !stopped(changes) {
        return 8u64
    }
    let _ = harness.gateway.stop(take g)
    let resumed = transcript_of(session_dir, clock, random, tasks)
    let _ = task.join(take modelling)
    result.unwrap(std.dir.remove_all(parent, name))
    if list.len(resumed) != list.len(want) {
        return 9u64
    }
    for i in 0u64 .. list.len(want) {
        if resumed[i] != want[i] {
            return 10u64
        }
    }
    0u64
}

@test
fn test_wake_resumes_transcript(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_wake_resumes_transcript(parent, clock, random, tasks, net)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

// ---- law S1: the subagent's Once tool across a crash ----
fn same(got: List[Bytes], want: List[Bytes]) -> bool {
    if list.len(got) != list.len(want) {
        return false
    }
    for i in 0u64 .. list.len(want) {
        if got[i] != want[i] {
            return false
        }
    }
    true
}

// Waits until both sessions' places have stopped by themselves.
fn both_stopped(changes: Receiver[platform.local.Change]) -> bool waits {
    let mut parent_done = false
    let mut child_done = false
    while let Ok(c) = channel.receive(changes) {
        if let Down(u) = c {
            if let Ok(Stopped(_)) = u.ended {
                if u.name == "s0" {
                    parent_done = true
                } else if u.name == "s1" {
                    child_done = true
                }
            }
        }
        if parent_done && child_done {
            return true
        }
    }
    false
}

fn unload_task(take job: (harness.gateway.Door, u64, Sender[Result[platform.local.Unloaded, harness.gateway.Refused]])) -> () waits {
    let (door, id, reply) = take job
    let _ = channel.send(reply, harness.gateway.unload(door, id))
}

// Law S1 (a subagent's Once tool runs at most once across a crash of either place): the
// parent's `delegate` starts a child session that calls `tally`, which the test holds.
// With `crash_child` the test cuts the child's place while tally runs; otherwise it cuts
// the parent's while delegate waits, then lets tally answer. Either way the gateway wakes
// the cut place, the cut call settles InDoubt, tally ran exactly once, there are exactly
// two sessions, and both logs are as the script says. Oracle: the hand-derived logs and
// the test's own count of tally runs. The answer is the first check that failed, or 0.
pub fn law_subagent_once(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, crash_child: bool) -> u64 waits {
    let mut name = string.with_capacity(32u64)
    let root = result.unwrap(host.mkdtemp(parent, mut name))
    let (asks, inbox): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let modelling = task.spawn(tasks, bytes 1048576u64, take inbox, model_service)
    let (tallies, held): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let (watch, changes): (Sender[platform.local.Change], Receiver[platform.local.Change]) = channel.new(256u64)
    let way: harness.gateway.Doorway = harness.gateway.doorway(harness.declare_tables)
    let door = harness.gateway.door_of(way)
    let seed = Services(model: take asks, tallies: take tallies, door: harness.gateway.door_of(way), name: "", tasks: tasks, clock: clock, random: random, net: net, preview: None, chunks: 0u64)
    let config = harness.gateway.GatewayConfig(root: root, options: runner.triggers.law_options(), factory: session_factory(), max_sessions: 2u64, idle_ms: IDLE_MS, place_bytes: 134217728u64, tasks: tasks, clock: clock, random: random, net: net, watch: Some(take watch), seed: take seed)
    let g = match harness.gateway.gateway(take way, take config) {
        Ok(take made) => take made,
        Error(_) => return 1u64
    }
    let id = match harness.gateway.create(door, string.into_bytes("parent"), Fresh("scripted", All)) {
        Ok(n) => n,
        Error(_) => return 2u64
    }
    let submit = runner.fixture.transact_entry(code.describe(submit_entry))
    let credential = runner.ingress.credential(random)
    match call_routed(door, id, credential, 0u64, submit, harness.Submit(client_key: "k1", text: "delegate it"), tasks, clock, random, net) {
        Ok(Ok(Placed(_))) => (),
        Error(n) => return n,
        _ => return 3u64,
    }
    // Tally's first run: the child exists and its call is in flight.
    let Ok(first) = channel.receive(held) else {
        return 4u64
    }
    let sessions = harness.gateway.listing(door)
    if list.len(sessions) != 2u64 {
        return 5u64
    }
    let child = if sessions[0] == id {
        sessions[1]
    } else {
        sessions[0]
    }
    let cut = if crash_child {
        child
    } else {
        id
    }
    // The cut: a client left open on the place makes its stop end Forced at the grace
    // deadline, with the held call still in flight; the stop must end while it is held.
    let lease = match harness.gateway.route(door, cut) {
        Ok(take l) => take l,
        Error(_) => return 14u64
    }
    let Some(address) = latest.read(platform.local.status(lease)).addr else {
        return 15u64
    }
    let Ok(keys) = runner.fixture.entry_keys(code.describe(place)) else {
        return 16u64
    }
    let Ok(take lingering) = runner.fixture.client_at(tasks, net, clock, random, keys, wire().socket, address, Some(runner.ingress.credential(random)), 0u64, WITHIN_MS) else {
        return 17u64
    }
    let _ = take lease
    let (unloaded, unload_answer): (Sender[Result[platform.local.Unloaded, harness.gateway.Refused]], Receiver[Result[platform.local.Unloaded, harness.gateway.Refused]]) = channel.new(1u64)
    let unloading = task.spawn(tasks, bytes 1048576u64, (harness.gateway.copy_door(door), cut, take unloaded), unload_task)
    let mut ended: Option[Result[platform.local.Unloaded, harness.gateway.Refused]] = None
    for i in 0u64 .. 50u64 {
        if let Ok(take got) = channel.try_receive(unload_answer) {
            ended = Some(take got);
            break
        }
        std.clock.sleep_ns(clock, 100000000u64)
    }
    if crash_child {
        let _ = take first
    } else {
        let _ = channel.send(first, ())
    }
    runner.fixture.close(take lingering)
    let _ = task.join(take unloading)
    match take ended {
        Some(Ok(u)) => match u.ended {
            Ok(Forced(_)) => (),
            Ok(Stopped(_)) => return 60u64,
            Ok(Unstarted) => return 61u64,
            Error(_) => return 62u64
        },
        Some(Error(_)) => return 7u64,
        None => return 63u64,
    }
    if !both_stopped(changes) {
        return 8u64
    }
    let _ = harness.gateway.stop(take g)
    let _ = task.join(take modelling)
    let mut runs = 1u64
    while let Ok(_) = channel.try_receive(held) {
        runs += 1u64
    }
    if runs != 1u64 {
        return 11u64
    }
    let parent_log = transcript_of(result.unwrap(std.dir.narrow(root, "s0")), clock, random, tasks)
    let child_log = transcript_of(result.unwrap(std.dir.narrow(root, "s1")), clock, random, tasks)
    let parent_want = log_of("delegate", if crash_child {
        Returned(Inline(string.into_bytes("done")))
    } else {
        InDoubt
    })
    let child_want = log_of("tally", if crash_child {
        InDoubt
    } else {
        Returned(Inline(string.into_bytes("1")))
    })
    result.unwrap(std.dir.remove_all(parent, name))
    if !same(parent_log, parent_want) {
        return 12u64
    }
    if !same(child_log, child_want) {
        return 13u64
    }
    0u64
}

@test
fn test_subagent_once_child_crash(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_subagent_once(parent, clock, random, tasks, net, true)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

@test
fn test_subagent_once_parent_crash(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_subagent_once(parent, clock, random, tasks, net, false)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

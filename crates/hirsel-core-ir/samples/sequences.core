b1:
  v12: u64 = const 0
  v13: u64 = const 32
  v14: bool = le v13, v8               ; the count and byte length, reserved
  branch v14, b2(v13, v12), b9
b2(v15: u64, v16: u64):
  v17: bool = lt v16, v0
  branch v17, b3, b5
b3:
  v18: u64 = const 2
  v19: u64 = add v15, v18
  v20: bool = le v19, v8
  branch v20, b4, b9
b4:
  address a0
  v21: u64 = mul v16, v3
  v22: u16 = truncate v21
  store a0, v22                        ; element i is 7i
  v23: u64 = const 1
  v24: u64 = add v16, v23
  jump b2(v19, v24)
b5:
  v25: u64 = sub v15, v13              ; the byte length, without the trailer
  v26: u64 = const 8
  v27: u64 = mul v16, v26
  v28: u64 = add v15, v27
  v29: bool = le v28, v8               ; the whole trailer, before any entry is stored

fn page_planted_manifest_vector() -> Bytes {
    let mut raw = page_manifest_vector()
    // The pack-list PagePtr's offset is at byte 88 + 236 + 8.
    list.set_word_le(mut raw, 332, 88u64)
    list.set_word_le(mut raw, 80, 0x7d1ea689eab5fc73u64)
    take raw
}

// rule: SEM-5
// expect: run
fn by_key(a: u64, b: u64) -> i32 uses {} {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

pub opaque type Acc: () uses {} {
  values: List[u64],
}

fn step(take acc: Acc, key: u64, value: u64) -> (Acc, bool) uses {} {
  let mut folded = take acc
  list.push(mut folded.values, key + value)
  (take folded, true)
}

pub fn main() -> Result[(), ()] {
  let mut m: ordered_map.OrderedMap[u64, u64] = ordered_map.empty(by_key)
  ordered_map.insert(mut m, 2, 20)
  ordered_map.insert(mut m, 1, 10)
  let initial = Acc(values: [])
  let actual = ordered_map.fold_range(
    m,
    Unbounded(),
    Unbounded(),
    Ascending(),
    take initial,
    step
  )
  failure.check(actual.values == [11u64, 22u64], Bounds())
  Ok(())
}

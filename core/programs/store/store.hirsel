pub fn law_typed_model(c: Clock) -> bool waits {
    for seed in 0u64 .. 2 {
        let mut db = test_db(c, 1073741824)
        result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
        let mut t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
        result.unwrap(create_index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
        let _ = result.unwrap(index(db, mut t, "bucket", code.describe(bucket), std.codec.key_u64()))
        let ix = result.unwrap(index(db, mut t, "bucket", code.describe(bucket), std.codec.key_u64()))
        let sh = shape(t)
        let mut model: List[u64] = result.unwrap(list.with_capacity(24))
        result.unwrap(list.fill(mut model, 24, 0u64))
        for step in 0u64 .. 64 {
            let wall = seed * 64 + step
            let model_state = splitmix64(wall)
            let k = model_state % 24
            let choice = (model_state >> 8) % 5
            let out = execute(mut db, 0, wall, None, fn(mut tx: Tx) -> Result[(u64, u64), Error] {
                let at = info(mut tx).at
                let state = splitmix64(at)
                let key = state % 24
                let action = (state >> 8) % 5
                if action == 0 {
                    let _ = delete(mut tx, t, key)?
                } else {
                    put(mut tx, t, key, at + 1)?
                    if option.unwrap(fetch(tx, shape(t), key)?) != at + 1 {
                        return Error(Missing("law"))
                    }
                }
                let mut bucket_rows = range(tx, shape(t), Excluded(4), Included(17))?
                let mut a: u64 = 0
                while let Some((_, v)) = next(mut bucket_rows)? {
                    a += v
                }
                let mut matches = lookup(tx, ix, Included(2), Included(2))?
                let mut b: u64 = 0
                while let Some((_, v)) = next_indexed(mut matches)? {
                    b += v
                }
                if action == 3 {
                    return Error(Foreign)
                }
                if action == 4 {
                    fail("typed model fault")
                }
                Ok((a, b))
            })
            match take out {
                Ok(Committed(done)) => {
                    if choice >= 3 {
                        return false
                    }
                    let _ = list.set(mut model, k, if choice == 0 {
                        0u64
                    } else {
                        wall + 1
                    })
                    let mut a: u64 = 0
                    let mut b: u64 = 0
                    for i in 0u64 .. 24 {
                        if i > 4 && i <= 17 {
                            a += model[i]
                        }
                        if model[i] % 4 == 2 {
                            b += model[i]
                        }
                    }
                    if done.value != (a, b) {
                        return false
                    }
                },
                Ok(Aborted(Undone(value: Foreign, ticket: None))) => if choice != 3 {
                    return false
                },
                Ok(Failed(_)) => if choice != 4 {
                    return false
                },
                _ => return false
            }
            let held = snapshot(db)
            for i in 0u64 .. 24 {
                if typed_value(held, sh, i) != model[i] {
                    return false
                }
            }
        }
    }
    true
}


// L55's host level uses the directory journal's published sync frontier.
@test
fn log_level_uses_host_barrier(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let mut db = open(tasks, directory, c, r, defaults())?
    let declared = levels(db)
    if list.len(declared) != 1 || declared[0] != "host" {
        fail("the directory store did not declare host")
    }
    if let Error(NoLevel(missing)) = level(db, "process") {
        if missing != "process" {
            fail("the refusal named the wrong level")
        }
    } else {
        fail("an undeclared level resolved")
    }
    let host_level = level(db, "host")?
    let mem = memory(c, r, defaults())
    let memory_level = level(mem, "memory")?
    let schema = create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64()))?
    if let Error(Foreign) = durable_at(mut db, schema, memory_level) {} else {
        fail("a level from another store was accepted")
    }
    durable_at(mut db, schema, host_level)?
    close(take db)
}

// L57. A receipt keeps its branch version across later journal rotations.
@test
fn position_survives_three_cuts(d: Dir, c: Clock, r: Random, tasks: Tasks, seed_grant: Env) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let mut db = open(tasks, directory, c, r, defaults())?
    let _ = create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64()))?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let committed = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, rows, 7, 70)
    })?
    let Committed(done) = committed else {
        fail("the position law did not commit")
    }
    let receipt = done.ticket
    let seed = std.sim.world.test_seed(seed_grant)
    let mut plan = std.sim.world.plan(match seed {
        Some(active) => active,
        None => 0,
    })
    let mut frontier = 2u64
    for i in 0u64 .. 3 {
        let cut = checkpoint(mut db)?
        if let Error(Missing(_)) = position(mut db, cut) {} else {
            fail("a cut received a commit Position")
        }
        if seed != None && std.sim.world.pick(mut plan, 2) == 1 {
            let after_cut = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
                put(mut tx, rows, i + 8, 80 + i)
            })?
            let Committed(continued) = after_cut else {
                fail("the position law did not commit after the cut")
            }
            durable(mut db, continued.ticket)?
            frontier += 1
        }
    }
    let saved = position(mut db, receipt)?
    if !same(saved.store, db.store) || saved.branch != 0 || saved.version != 2 {
        fail("the ticket lost its original branch version")
    }
    close(take db)?
    let mut ids = followers()
    let mut first = follower(mut ids, tasks, log_authority(directory), c, defaults())?
    let second = follower(mut ids, tasks, log_authority(directory), c, defaults())?
    let main = option.unwrap(follower_branch(first, "main"))
    let due = clock.deadline_after_ms(host.mono_ns(c), 1000)
    let found = at_least(mut first, saved, due)?
    let refreshed = fresh(mut first, due)?
    if refreshed.open != found.open || version(refreshed) != frontier {
        fail("fresh replaced the follower's open identity or lost a row")
    }
    let also = snapshot_follower(second, main)?
    if found.open == also.open || version(found) != frontier || version(also) != frontier {
        fail("log followers did not keep distinct capture identities")
    }
    let source = follower_table(second, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if get(also, shape(source), 7)? != Some(70) || get(found, shape(source), 7)? != Some(70) {
        fail("the follower missed the committed row")
    }
    Ok(())
}

// Captures still admit the 416-byte pre-v2.172 index revision until the next format word.
const CATALOG_REVISION_MAX: u64 = 32 + 4 * 96

type CaptureCatalog {
    kind: u8,
    id: u32,
    owner: u32,
    shape: u8,
    state: u8,
    revision: Bytes
}

type CaptureCatalogCount {
    records: u64,
    name_bytes: u64,
    last: Bytes
}

fn capture_catalog_name(path: String, at: u64, key: Bytes) -> Result[String, Error] {
    if list.len(key) == 0 {
        return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
    }
    let name_at = match key[0] {
        1 => 1u64,
        2 => 5u64,
        _ => return Error(failure_from_rep(format.disk_fault(path, at, Malformed))),
    }
    if list.len(key) < name_at || list.len(key) - name_at > 255 {
        return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
    }
    catalog_collection_name(key, if name_at == 5 {
        2u8
    } else {
        1u8
    })
}

fn capture_count_catalog(mut packs: CapturePacks, root: std.page.PagePtr) -> Result[(u64, u64), Error] waits {
    let mut counted = CaptureCatalogCount(records: 0, name_bytes: 0, last: list.new())
    let mut pages = 0u64
    capture_walk_pages(mut packs, root, 0, None, mut counted, mut pages, fn(mut _packs: CapturePacks, mut tally: CaptureCatalogCount, path: String, at: u64, key: Bytes, _value: std.page.Cell) -> Result[(), Error] {
        if list.len(tally.last) != 0 && order.compare(tally.last, key) != Less {
            return Error(failure_from_rep(format.disk_fault(path, at, Order)))
        }
        let name = capture_catalog_name(path, at, key)?
        tally.records = capture_add(tally.records, 1)
        tally.name_bytes = capture_add(tally.name_bytes, format.round8(string.byte_len(name)))
        tally.last = failure_result_from_rep(types.copied(key))?
        Ok(())
    })?
    Ok((counted.records, counted.name_bytes))
}

fn capture_catalog_cell(mut packs: CapturePacks, path: String, at: u64, value: std.page.Cell) -> Result[CaptureCatalog, Error] waits {
    match value {
        InlineValue(raw) => {
            let mut ignored = ()
            let mut inline_source = ()
            capture_catalog_fields(mut ignored, mut inline_source, path, at, list.len(raw), scoped fn(mut _target: (), mut _read: (), offset: u64, width: u64) -> Result[u64, Error] {
                Ok(format.read_le(raw, offset, width))
            }, scoped fn(mut _target: (), mut _read: (), offset: u64, width: u64) -> Result[Bytes, Error] {
                failure_result_from_rep(types.copied(list.slice(raw, offset, offset + width)))
            })
        },
        BlobValue(reference) => capture_catalog_blob(mut packs, reference),
        Child(_) => Error(failure_from_rep(format.disk_fault(path, at, Malformed))),
    }
}

fn capture_catalog_blob(mut packs: CapturePacks, reference: std.page.BlobRef) -> Result[CaptureCatalog, Error] waits {
    let path = paged_pack_path(reference.pack)?
    let id = packs.id
    // The file is lent from the held table throughout both the checksum and
    // projection. Read field lengths by offset and skip their schema bytes.
    capture_with_pack(mut packs, path, reference.pack, reference.stamp, reference.offset, 1, scoped fn(mut file: HostFile) -> Result[CaptureCatalog, Error] waits {
        let size = disk_io(host.stat_file(mut file))?.size
        if reference.offset > size || 24 + reference.len > size - reference.offset {
            return Error(failure_from_rep(format.disk_fault(path, reference.offset, Truncated)))
        }
        let start = reference.offset + 24
        let end = start + reference.len
        let mut source = new_capture_chunk(end)
        let head = capture_prefix(mut file, path, mut source, reference.offset, 16)?
        let frame = disk_read_frame_head(path, head, reference.offset)?
        let ctx = format.DiskContext(store: store_key_to_rep(id), role: 3, seq: reference.pack)
        disk_check_frame_kind(path, ctx, frame.kind, frame.flags, reference.offset)?
        let stamp = capture_prefix(mut file, path, mut source, reference.offset + 16, 8)?
        let actual_stamp: u64 = list.word_le(stamp, 0)
        if frame.kind != 0x0022 || frame.size != 8 + reference.len || actual_stamp != reference.stamp {
            return Error(failure_from_rep(format.disk_fault(path, reference.offset, Checksum)))
        }
        let mut envelope = failure_result_from_rep(types.capacity(format.disk_check_start(ctx, reference.offset, head)))?
        let mut check = std.check.start()
        std.check.add(mut envelope, stamp, 0, 8)
        let mut offset = start
        while offset < end {
            let lo = capture_chunk_at(mut file, path, mut source, offset)?
            let width = order.min(end - offset, list.len(source.raw) - lo)
            std.check.add(mut envelope, source.raw, lo, lo + width)
            std.check.add(mut check, source.raw, lo, lo + width)
            offset += width
        }
        if std.check.finish(envelope) != frame.checksum || std.check.finish(check) != reference.checksum {
            return Error(failure_from_rep(format.disk_fault(path, reference.offset, Checksum)))
        }
        capture_catalog_blob_fields(mut file, path, start, reference.len, mut source)
    })
}

fn capture_catalog_blob_fields(mut file: HostFile, path: String, start: u64, width: u64, mut source: CaptureChunk) -> Result[CaptureCatalog, Error] waits {
    capture_catalog_fields(mut file, mut source, path, start, width, scoped fn(mut handle: HostFile, mut chunk: CaptureChunk, offset: u64, n: u64) -> Result[u64, Error] waits {
        let raw = capture_prefix(mut handle, path, mut chunk, start + offset, n)?
        Ok(format.read_le(raw, 0, n))
    }, scoped fn(mut handle: HostFile, mut chunk: CaptureChunk, offset: u64, n: u64) -> Result[Bytes, Error] waits {
        capture_prefix(mut handle, path, mut chunk, start + offset, n)
    })
}

type CaptureCatalogCursor {
    at: u64,
    len: u64
}

fn capture_catalog_advance(path: String, offset: u64, mut cursor: CaptureCatalogCursor, width: u64) -> Result[u64, Error] {
    if width > cursor.len - cursor.at {
        return Error(failure_from_rep(format.disk_fault(path, offset + cursor.at, Malformed)))
    }
    let from = cursor.at
    cursor.at += width
    Ok(from)
}

fn capture_catalog_fields[T, S](mut target: T, mut source: S, path: String, offset: u64, width: u64, number: scoped fn(mut T, mut S, u64, u64) -> Result[u64, Error] waits, copy_field: scoped fn(mut T, mut S, u64, u64) -> Result[Bytes, Error] waits) -> Result[CaptureCatalog, Error] waits {
    let mut pos = CaptureCatalogCursor(at: 0, len: width)
    let kind: u8 = int.truncate(number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 1)?, 1)?)
    let id: u32 = int.truncate(number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?)
    let owner: u32 = int.truncate(number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?)
    let epoch = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 8)?, 8)?
    if kind < 1 || kind > 4 || id == 0 || epoch == 0 || (kind == 2 && owner == 0) {
        return Error(failure_from_rep(format.disk_fault(path, offset, Malformed)))
    }
    let key_width = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?
    let _ = capture_catalog_advance(path, offset, mut pos, key_width)?
    let schemas = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 2)?, 2)?
    for _ in 0u64 .. schemas {
        let _ = capture_catalog_advance(path, offset, mut pos, 10)?
        let n = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?
        let _ = capture_catalog_advance(path, offset, mut pos, n)?
    }
    let _ = capture_catalog_advance(path, offset, mut pos, 2)?
    let by_width = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?
    let _ = capture_catalog_advance(path, offset, mut pos, by_width)?
    let rev_width = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?
    let rev_at = capture_catalog_advance(path, offset, mut pos, rev_width)?
    if rev_width > CATALOG_REVISION_MAX {
        return Error(failure_from_rep(format.disk_fault(path, offset + rev_at, Malformed)))
    }
    let revision = copy_field(mut target, mut source, rev_at, rev_width)?
    let mut shape = 0u8
    let mut state = 0u8
    if kind == 2 {
        shape = int.truncate(number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 1)?, 1)?)
        if shape > 2 {
            return Error(failure_from_rep(format.disk_fault(path, offset + pos.at - 1, Malformed)))
        }
        let payloads = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 2)?, 2)?
        for _ in 0u64 .. payloads + 2 {
            let n = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?
            let _ = capture_catalog_advance(path, offset, mut pos, n)?
        }
        if pos.at == width {
            return Error(failure_from_rep(format.disk_fault(path, offset + pos.at, Malformed)))
        }
        state = int.truncate(number(mut target, mut source, width - 1, 1)?)
        if state > 3 {
            return Error(failure_from_rep(format.disk_fault(path, offset + width - 1, Malformed)))
        }
        let state_fields = if state == 2 {
            1u64
        } else if state == 3 {
            2u64
        } else {
            0u64
        }
        for _ in 0u64 .. state_fields {
            let n = number(mut target, mut source, capture_catalog_advance(path, offset, mut pos, 4)?, 4)?
            let _ = capture_catalog_advance(path, offset, mut pos, n)?
        }
        let _ = capture_catalog_advance(path, offset, mut pos, 1)?
    }
    if pos.at != width {
        return Error(failure_from_rep(format.disk_fault(path, offset + pos.at, Malformed)))
    }
    Ok(CaptureCatalog(kind: kind, id: id, owner: owner, shape: shape, state: state, revision: take revision))
}

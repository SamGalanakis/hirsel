// The reference agent for the harness: a notes keeper. It wires each part an
// app composes from: an Inside tool (`note_add`, `note_delete`), an Outside
// tool (`clock`), a gate that holds a call for approval (`confirm_delete`), a
// subagent (`summarize`, an Outside tool that asks another place), a
// reaction (`tally`) and a system section (`notes`).
//
// The default run uses a scripted model. See README.md.
pub const BYTES: u64 = 131072u64

const PLACE_BYTES: u64 = 1048576u64

pub const IDLE_MS: u64 = 200u64

pub const OPENROUTER: String = "openrouter.ai"

pub const LIVE_MODEL: String = "deepseek/deepseek-v4.1-flash-1017"

// The notes place shares its task with a helper. Keep its resident and journal buffers small.
fn sizes() -> store.Overrides {
    store.Overrides(resident_limit: Some(4194304u64), journal_limit: None, checkpoint_bytes: None, pack_bytes: Some(1048576u64), group_bytes: Some(1048576u64), group_commits: None, lock_wait_ms: None,
        cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None)
}

pub fn options() -> store.Options {
    result.unwrap(store.sized_with(Directory, 67108864u64, sizes()))
}

// ---- the app's own tables ----
fn notes_name() -> String {
    "notes.notes"
}

fn stats_name() -> String {
    "notes.stats"
}

// stats keys: the next note id, and the tool results the reaction counted.
const NEXT_ID: u64 = 0u64

pub const RESULTS: u64 = 1u64

pub type Tables: shareable + send {
    notes: store.Table[u64, String],
    stats: store.Table[u64, u64]
}

pub type Handles: shareable + send {
    harness: harness.Handles,
    tables: Tables,
}

pub fn schema(mut d: store.Declare) -> Result[Handles, store.Error] {
    let handles = harness.declare_tables(mut d)?
    let c_note: std.codec.Codec[String] = std.codec.of()
    let notes = store.declare_table(mut d, notes_name(), std.codec.key_u64(), c_note)?
    let notes_table = store.finish(mut d, take notes)?
    let stats = store.declare_table(mut d, stats_name(), std.codec.key_u64(), std.codec.of_u64())?
    let stats_table = store.finish(mut d, take stats)?
    Ok(Handles(harness: take handles, tables: Tables(notes: take notes_table, stats: take stats_table)))
}

fn harness_handles(h: Handles) -> harness.Handles { clone(h.harness) }

pub fn seed_schema(mut d: store.Declare) -> Result[harness.Handles, store.Error] {
    let Handles(harness: take handles, ..) = schema(mut d)?
    Ok(take handles)
}

fn stat(tx: store.Tx, t: Tables, k: u64) -> Result[u64, store.Error] {
    match store.fetch(tx, t.stats, k)? {
        Some(n) => Ok(n),
        None => Ok(0u64)
    }
}

// ---- tool arguments ----
fn text_arg(raw: Bytes, field: String) -> Result[String, harness.Fault] {
    let Ok(take s) = string.from_utf8(clone(raw)) else {
        return Error(BadArgs("arguments are not UTF-8"))
    }
    let mut pointer = string.from("/")
    string.push(mut pointer, field)
    region r {
        match std.json.parse(r, s) {
            Ok(x) => match std.json.pointer(x, pointer) {
                Some(Str(t)) => Ok(string.from(text.as_string(t))),
                _ => Error(BadArgs("a text field is missing")),
            },
            Error(_) => Error(BadArgs("arguments are not JSON")),
        }
    }
}

fn id_arg(raw: Bytes) -> Result[u64, harness.Fault] {
    let Ok(take s) = string.from_utf8(clone(raw)) else {
        return Error(BadArgs("arguments are not UTF-8"))
    }
    region r {
        match std.json.parse(r, s) {
            Ok(x) => match std.json.pointer(x, "/id") {
                Some(v) => match std.json.as_u64(v) {
                    Some(n) => Ok(n),
                    None => Error(BadArgs("id is not a number"))
                },
                None => Error(BadArgs("id is missing")),
            },
            Error(_) => Error(BadArgs("arguments are not JSON")),
        }
    }
}

fn numbered(take head: String, n: u64) -> Bytes {
    let mut s = take head
    string.push_u64(mut s, n)
    string.into_bytes(take s)
}

// ---- Inside tools: they run in advance's transaction ----
fn note_add(mut tx: store.Tx, h: harness.Handles, t: Tables, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let line = text_arg(inv.args, "text")?
    let Ok(id) = stat(tx, t, NEXT_ID) else {
        return Error(Unavailable)
    }
    let Ok(()) = store.put(mut tx, t.notes, id, line) else {
        return Error(Unavailable)
    }
    let Ok(()) = store.put(mut tx, t.stats, NEXT_ID, id + 1u64) else {
        return Error(Unavailable)
    }
    Ok(Now(numbered("added note ", id)))
}

fn note_delete(mut tx: store.Tx, h: harness.Handles, t: Tables, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    let id = id_arg(inv.args)?
    match store.fetch(tx, t.notes, id) {
        Ok(Some(_)) => (),
        Ok(None) => return Error(BadArgs("no such note")),
        Error(_) => return Error(Unavailable),
    }
    let Ok(_) = store.delete(mut tx, t.notes, id) else {
        return Error(Unavailable)
    }
    Ok(Now(numbered("deleted note ", id)))
}

// ---- the gate, the reaction and the section ----
// Deleting is the one call that needs a person: it is held until the run's
// caller approves these exact arguments.
fn confirm_delete(tx: store.Tx, h: harness.Handles, t: Tables, ask: harness.Ask) -> harness.Verdict {
    if ask.call.name == "note_delete" {
        Hold("deleting a note needs your approval")
    } else {
        Pass
    }
}

// Counts tool results in the transaction that appends each one.
fn tally(mut tx: store.Tx, h: harness.Handles, t: Tables, at: u64, e: harness.Entry) -> Result[(), harness.Fault] {
    let ToolResult(_, _, _) = view e else {
        return Ok(())
    }
    let Ok(n) = stat(tx, t, RESULTS) else {
        return Error(Unavailable)
    }
    let Ok(()) = store.put(mut tx, t.stats, RESULTS, n + 1u64) else {
        return Error(Unavailable)
    }
    Ok(())
}

// The notes as the model sees them, rendered from rows before each request.
fn notes_section(tx: store.Tx, h: harness.Handles, t: Tables) -> Result[Option[String], store.Error] {
    let mut out = string.from("Notes:")
    let next = stat(tx, t, NEXT_ID)?
    for id in 0u64 .. next {
        if let Some(line) = store.fetch(tx, t.notes, id)? {
            string.push(mut out, "\n")
            string.push_u64(mut out, id)
            string.push(mut out, ". ")
            string.push(mut out, line)
        }
    }
    Ok(Some(take out))
}

// ---- grants: what Outside tools and the model are given ----
pub type Live: send {
    net: Net,
    address: Addr,
    key: Secret,
    out: Stdout,
    preview: harness.preview.Door,
    group: String,
    model: String,
}

// A scripted session's draft: the preview hub and the session's group.
pub type Stream: send {
    door: harness.preview.Door,
    group: String
}

pub type Services: send {
    helper: Sender[HelperAsk],
    clock: Clock,
    live: Option[Live],
    stream: Option[Stream]
}

pub type Grants: send {
    handles: Handles,
    context: runner.TriggerContext,
    helper: Sender[HelperAsk],
    clock: Clock,
    live: Option[Live],
    stream: Option[Stream]
}

pub fn copy_stream(s: Option[Stream], group: String) -> Option[Stream] {
    let Some(d) = view s else {
        return None
    }
    Some(Stream(door: harness.preview.copy_door(d.door), group: string.from(group)))
}

pub fn copy_live(l: Live, group: String) -> Live {
    Live(net: l.net, address: l.address, key: secret.share(l.key), out: l.out, preview: harness.preview.copy_door(l.preview), group: string.from(group), model: string.from(l.model))
}

fn make_grants(s: Services, h: Handles, take ctx: runner.TriggerContext) -> Result[Grants, Capacity] {
    let live = match s.live {
        Some(l) => Some(copy_live(l, l.group)),
        None => None,
    }
    let group = match s.stream {
        Some(d) => string.from(d.group),
        None => string.new(),
    }
    let stream = copy_stream(s.stream, group)
    Ok(Grants(handles: clone(h), context: take ctx, helper: channel.sender(s.helper), clock: s.clock, live: take live, stream: take stream))
}

// ---- Outside tools: they run in a worker, off the write lock ----
fn clock_tool(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] {
    Ok(numbered("wall clock ms ", host.wall_ms(g.clock)))
}

// The subagent: asks the helper place and returns its final answer.
fn summarize(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    let line = text_arg(args, "text")?
    let (reply, replied): (Sender[Result[String, String]], Receiver[Result[String, String]]) = channel.new(1u64)
    if let Error(_) = channel.send(g.helper, Summarize(take line, take reply)) {
        return Error(Unavailable)
    }
    // The helper's place may have run its model before it failed, so a
    // failure after the ask is in doubt, not a refusal.
    match channel.receive(replied) {
        Ok(Ok(take s)) => Ok(string.into_bytes(take s)),
        _ => Error(Unavailable),
    }
}

// ---- the parent agent ----
fn usage() -> harness.Usage {
    harness.Usage(input: 10u64, output: 5u64, cache_read: 0u64, cache_write: 0u64, reasoning: 0u64)
}

fn call(take id: String, take name: String, take args: String) -> harness.Call {
    harness.Call(id: take id, name: take name, args: Inline(string.into_bytes(take args)))
}

fn returned(r: harness.Request, id: String) -> String {
    for e in r.messages {
        if let ToolResult(at, Returned(Inline(b)), _) = e {
            if at == id {
                if let Ok(take s) = string.from_utf8(clone(b)) {
                    return take s
                }
            }
        }
    }
    string.new()
}

// Three rounds, chosen by how many tool results the request carries.
fn scripted_model(g: Grants, take r: harness.Request) -> Result[harness.Answer, harness.ModelFault] waits {
    let mut results = 0u64
    let mut prompt = string.new()
    for e in r.messages {
        match e {
            User(text) => { prompt = string.from(text) },
            ToolResult(_, _, _) => { results += 1u64 },
            _ => (),
        }
    }
    let mut calls: List[harness.Call] = list.new()
    let mut words = string.new()
    if prompt == "Reply with READY and nothing else." {
        words = "READY"
    } else if prompt == "Reply with FORKED and nothing else." {
        words = "FORKED"
    } else if let Some((written, result)) = scripted_release(r) {
        if let Some(text) = result {
            words = string.from(text)
        } else if written {
            list.push(mut calls, call("release", "propose_release", "{\"summary\":\"Update the example source\"}"))
        } else {
            list.push(mut calls, call("write", "write_source", "{\"path\":\"main.hirsel\",\"text\":\"pub fn main() {}\"}"))
        }
    } else if results == 0u64 {
        list.push(mut calls, call("c1", "note_add", "{\"text\":\"The team meeting moved to Thursday.\"}"))
        list.push(mut calls, call("c2", "clock", "{}"))
    } else if results == 2u64 {
        list.push(mut calls, call("c3", "summarize", "{\"text\":\"The team meeting moved to Thursday. Note 0 said Tuesday and is out of date.\"}"))
        list.push(mut calls, call("c4", "note_delete", "{\"id\":0}"))
    } else {
        string.push(mut words, "Saved the move and removed the stale note. ")
        string.push(mut words, returned(r, "c3"))
    }
    let stop = if list.len(calls) == 0u64 {
        "end"
    } else {
        "tool_use"
    }
    // The agent's model must be a waiting function and a waiting function
    // must wait (LANG-8), so the scripted answer is handed over a channel.
    let (reply, replied): (Sender[harness.Answer], Receiver[harness.Answer]) = channel.new(1u64)
    let _ = channel.send(reply, harness.Answer(text: take words, calls: take calls, stop: stop, usage: usage()))
    match channel.receive(replied) {
        Ok(take a) => Ok(take a),
        Error(_) => Error(Rejected("scripted model unavailable"))
    }
}

fn scripted_release(r: harness.Request) -> Option[(bool, Option[String])] {
    let mut releasing = false
    let mut written = false
    let mut result: Option[String] = None
    for e in r.messages {
        match e {
            User(text) => {
                releasing = text == "File an example release.";
                written = false;
                result = None
            },
            ToolResult(id, outcome, _) => {
                if id == "write" {
                    if let Returned(_) = outcome { written = true }
                }
                if id == "release" {
                    match outcome {
                        Returned(Inline(raw)) => {
                            if let Ok(take text) = string.from_utf8(clone(raw)) { result = Some(take text) }
                        },
                        Failed(why) => { result = Some(string.from(why)) },
                        _ => (),
                    }
                }
            },
            _ => (),
        }
    }
    if releasing { Some((written, take result)) } else { None }
}

// The scripted answer, its text drafted in eight pieces over about a second.
fn scripted_stream(g: Grants, take request: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let answer = scripted_model(g, take request)?
    let n = string.byte_len(answer.text)
    if list.len(answer.calls) == 0u64 && n > 0u64 {
        let mut from = 0u64
        for i in 1u64 .. 9u64 {
            let mut to = n * i / 8u64
            while to < n && (string.as_bytes(answer.text)[to] & 192u8) == 128u8 {
                to += 1u64
            }
            if let Some(mut p) = sink {
                harness.preview.delta(mut p, string.slice(answer.text, from, to))
            }
            from = to
            std.clock.sleep_ns(g.clock, 150000000u64)
        }
    }
    Ok(take answer)
}

// Live asks OpenRouter, stream drafts the script, otherwise the script answers.
fn model(g: Grants, take request: harness.Request, mut draft: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    if let Some(live) = view g.live {
        return live_model(g, live, take request, mut draft)
    }
    if let Some(_) = view g.stream {
        return scripted_stream(g, take request, mut draft)
    }
    scripted_model(g, take request)
}

fn live_model(g: Grants, live: Live, take request: harness.Request, mut draft: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let m = harness.provider.Model(dialect: OpenAi, name: string.from(live.model), max_tokens: 512u64, cache_control: Off)
    let endpoint = harness.provider.Endpoint(address: live.address, authority: OPENROUTER, prefix: "/api", security: Https(OPENROUTER, System))
    let p = harness.provider.Provider(model: take m, endpoint: take endpoint, key: secret.share(live.key), bounds: harness.provider.bounds(), deadline_ms: 45000u64)
    emit(live.out, "OpenRouter request attempted", "")
    let response = harness.provider.ask_with_preview(live.net, g.clock, take p, take request, mut draft)
    match take response {
        Ok(take a) => {
            let hit = a.usage.cache_read
            if hit <= a.usage.input {
                let mut s = string.from("OpenRouter prompt tokens: hit ")
                string.push_u64(mut s, hit)
                string.push(mut s, ", miss ")
                string.push_u64(mut s, a.usage.input - hit)
                emit(live.out, take s, "")
            }
            Ok(take a)
        },
        Error(take fault) => {
            let why = match fault {
                Throttled(message, _) => string.from(message),
                Transient(message, _) => string.from(message),
                ContextExceeded(message) => string.from(message),
                StreamDropped(message) => string.from(message),
                Rejected(message) => string.from(message),
            }
            emit(live.out, "OpenRouter ", why)
            Error(take fault)
        },
    }
}

pub fn notes_agent(tables: Tables) -> harness.Agent[Grants, Tables] {
    let mut a: harness.Agent[Grants, Tables] = harness.agent("notes", "notes", code.describe(model), clone(tables))
    list.push(mut a.tools, harness.inside("note_add", "saves a note", "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}", code.describe(note_add)))
    list.push(mut a.tools, harness.inside("note_delete", "deletes a note by id", "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"}},\"required\":[\"id\"]}", code.describe(note_delete)))
    list.push(mut a.tools, harness.outside("clock", "reads the wall clock", "{\"type\":\"object\"}", Repeatable(3u64), code.describe(clock_tool)))
    list.push(mut a.tools, harness.outside("summarize", "asks a helper agent for a one-line summary", "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}", Once, code.describe(summarize)))
    harness.release.add_tools(mut a)
    list.push(mut a.gates, harness.Gate(name: "confirm_delete", check: code.describe(confirm_delete)))
    list.push(mut a.reactions, harness.After(name: "tally", run: code.describe(tally)))
    list.push(mut a.sections, harness.Section(key: "notes", render: code.describe(notes_section)))
    a
}

// The four entries the place registers. Each rebuilds the agent from code,
// so a trigger never carries the agent itself.
fn wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(advance), code.describe(effect))
}

fn advance(mut tx: store.Tx, h: Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    let w = wired()?
    harness.advance_park(mut tx, h.harness, notes_agent(h.tables), w, take wake)
}

fn effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    let mut target: Option[harness.preview.Target] = None
    if let Some(d) = view g.stream {
        target = Some(harness.preview.target(d.door, d.group, g.clock))
    }
    if let Some(l) = view g.live {
        target = Some(harness.preview.target(l.preview, l.group, g.clock))
    }
    harness.effect(g.context, g.handles.harness, g, take key, notes_agent(g.handles.tables), code.describe(settle), take target)
}

fn settle(mut tx: store.Tx, h: Handles, a: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = wired() else {
        return Error(Missing("harness: wiring"))
    }
    harness.settle(mut tx, h.harness, notes_agent(h.tables), w, a, take m)
}

pub fn submit_entry(mut tx: store.Tx, h: Handles, caller: store.Caller, take m: harness.Submit) -> Result[harness.Disposition, harness.Refused] {
    let w = wired()?
    harness.submit(mut tx, h.harness, notes_agent(h.tables), w, caller, NextTurn, take m)
}

pub fn decide_entry(mut tx: store.Tx, h: Handles, caller: store.Caller, take d: harness.Decision) -> Result[harness.Ruling, harness.Refused] {
    let w = wired()?
    harness.decide(mut tx, h.harness, notes_agent(h.tables), w, caller, take d)
}

pub fn settle_release_entry(mut tx: store.Tx, h: Handles, caller: store.Caller, take ask: harness.release.DevSettlement) -> Result[harness.Filed, harness.Refused] {
    harness.release.dev_settle(mut tx, h.harness, caller, notes_agent(h.tables), wired()?, take ask)
}

pub fn place(mut r: runner.Registry[Grants, Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(advance), code.describe(effect), code.describe(settle), harness_handles, BYTES, BYTES)?
    runner.transact(mut r, code.describe(submit_entry), BYTES, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(decide_entry), BYTES, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(settle_release_entry), BYTES, runner.DEFAULT_STEPS)?
    let proposals: std.codec.Codec[harness.release.Proposal] = std.codec.of()
    runner.query_as_with(mut r, code.describe(harness.release.dev_proposals), harness.release.proposal_slots()?, harness_handles, BYTES, runner.DEFAULT_STEPS)?
    runner.query_as_with(mut r, code.describe(harness.pending_waits), harness.wait_slots()?, harness_handles, BYTES, runner.DEFAULT_STEPS)?
    let windows: std.codec.Codec[harness.View] = std.codec.of()
    runner.query_as_with(mut r, code.describe(harness.window), harness.window_slots()?, harness_handles, BYTES, runner.DEFAULT_STEPS)?
    runner.query_as_with(mut r, code.describe(harness.history_cuts), harness.cut_slots()?, harness_handles, BYTES, runner.DEFAULT_STEPS)
}

// ---- the helper agent: a second place, one session of its own ----
type HelperGrants: send {
    handles: harness.Handles,
    context: runner.TriggerContext
}

fn helper_grants(s: (), h: harness.Handles, take ctx: runner.TriggerContext) -> Result[HelperGrants, Capacity] {
    Ok(HelperGrants(handles: clone(h), context: take ctx))
}

// Answers with the first sentence of the newest user message.
fn helper_model(g: HelperGrants, take r: harness.Request, mut draft: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let mut last = string.new()
    for e in r.messages {
        if let User(t) = e {
            last = clone(t)
        }
    }
    let mut first: Bytes = list.new()
    for b in string.into_bytes(take last) {
        list.push(mut first, b)
        if b == 46u8 {
            break
        }
    }
    let mut words = string.from("Summary: ")
    if let Ok(take s) = string.from_utf8(take first) {
        string.push(mut words, s)
    }
    let (reply, replied): (Sender[harness.Answer], Receiver[harness.Answer]) = channel.new(1u64)
    let _ = channel.send(reply, harness.Answer(text: take words, calls: list.new(), stop: "end", usage: harness.Usage(input: 4u64, output: 2u64, cache_read: 0u64, cache_write: 0u64, reasoning: 0u64)))
    match channel.receive(replied) {
        Ok(take a) => Ok(take a),
        Error(_) => Error(Rejected("scripted model unavailable"))
    }
}

fn helper_agent() -> harness.Agent[HelperGrants, ()] {
    harness.agent("helper", "scripted", code.describe(helper_model), ())
}

fn helper_wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(helper_advance), code.describe(helper_effect))
}

fn helper_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    let w = helper_wired()?
    harness.advance_park(mut tx, h, helper_agent(), w, take wake)
}

fn helper_effect(g: HelperGrants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    harness.effect(g.context, g.handles, g, take key, helper_agent(), code.describe(helper_settle), None)
}

fn helper_settle(mut tx: store.Tx, h: harness.Handles, a: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = helper_wired() else {
        return Error(Missing("harness: wiring"))
    }
    harness.settle(mut tx, h, helper_agent(), w, a, take m)
}

fn helper_place(mut r: runner.Registry[HelperGrants, harness.Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(helper_advance), code.describe(helper_effect), code.describe(helper_settle), harness.select_handles, BYTES, BYTES)
}

// The helper's service: it owns the helper place's directory and, per ask,
// submits the text, runs the place until it is idle and reads the answer.
pub type HelperAsk: send = Summarize(String, Sender[Result[String, String]])

pub type HelperSeed: send {
    inbox: Receiver[HelperAsk],
    dir: Dir,
    clock: Clock,
    random: Random,
    tasks: Tasks,
    net: Net
}

fn helper_settings(dir: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> runner.PlaceConfig[HelperGrants, harness.Handles, (), ()] {
    let w = result.unwrap(helper_wired())
    let config = runner.TriggerConfig(entries: harness.entries(w), author: store.Caller(issuer: 0u8, subject: list.new()), grants: (), grant: helper_grants, grant_bytes: 65536u64)
    runner.PlaceConfig(backing: Disk(dir), sizes: sizes(), selection: Reopen, place: code.describe(helper_place), n_place: PLACE_BYTES, on_migrate: None, schema: code.describe(harness.declare_tables), session: wire(), max_sessions: 1u64, proxies: list.new(), n_publisher: PLACE_BYTES, listen: loopback(), net: net, tasks: tasks, clock: clock, random: random, stop: runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: None, triggers: Some(take config), idle: Some(IDLE_MS))
}

fn helper_ask(seed: HelperSeed, n: u64, take line: String) -> Result[String, String] waits {
    let mut db = match store.open(seed.tasks, seed.dir, seed.clock, seed.random, options()) {
        Ok(take v) => take v,
        Error(_) => return Error("helper: open")
    }
    let Ok(h) = store.bind_declaration(mut db, Migrate, harness.declare_tables) else {
        return Error("helper: schema")
    }
    let Ok(w) = helper_wired() else {
        return Error("helper: wiring")
    }
    let mut client_key = string.from("ask-")
    string.push_u64(mut client_key, n)
    let ran = store.run(mut db, None, (store.copy_env(line), store.copy_env(n), store.copy_env(h), store.copy_env(w), store.copy_env(client_key)), fn(mut tx, call_env) -> Result[harness.Disposition, harness.Refused] {
        if call_env.1 == 0u64 {
            harness.open_session(mut tx, call_env.2, "scripted", All)?
        }
        harness.submit(mut tx, call_env.2, helper_agent(), call_env.3, you(), NextTurn, harness.Submit(client_key: clone(call_env.4), text: clone(call_env.0)))
    })
    let Ok(Committed(done)) = take ran else {
        return Error("helper: submit did not commit")
    }
    let Ok(()) = store.durable(mut db, done.ticket) else {
        return Error("helper: durable")
    }
    let Ok(()) = store.close(take db) else {
        return Error("helper: close")
    }
    until_idle(helper_settings(seed.dir, seed.clock, seed.random, seed.tasks, seed.net))?
    let Ok(db2) = store.open(seed.tasks, seed.dir, seed.clock, seed.random, options()) else {
        return Error("helper: reopen")
    }
    let snap = store.snapshot(db2)
    let Ok(Some(session)) = store.get(result.unwrap(store.reader(db2, 0u64)), snap, h.session, 0u64) else {
        return Error("helper: no session")
    }
    let last = session.next_pos - 1u64
    let answer: Result[String, String] = match store.get(result.unwrap(store.reader(db2, 0u64)), snap, h.entries, last) {
        Ok(Some(Assistant(a))) => Ok(clone(a.text)),
        _ => Error("helper: the run did not end in an answer"),
    }
    let _ = store.close(take db2)
    answer
}

pub fn helper_service(take seed: HelperSeed) -> () waits {
    let mut n = 0u64
    while let Ok(take ask) = channel.receive(seed.inbox) {
        let Summarize(take line, reply) = take ask
        let _ = channel.send(reply, helper_ask(seed, n, take line))
        n += 1u64
    }
}

// ---- running a place ----
fn you() -> store.Caller {
    store.Caller(issuer: 1u8, subject: string.into_bytes("you"))
}

pub fn loopback() -> Addr {
    Addr(ip: V4(0x7f000001u32), port: 0u16)
}

pub fn wire() -> runner.WireConfig {
    let mut w = runner.wire_defaults(65536u64)
    w.n_pool = 4194304u64
    w
}

// Runs a place until it is idle: no run can move without a person or a
// timer, so `operate` returns.
fn until_idle[G: send, H: shareable + inert + send, S: send](take config: runner.PlaceConfig[G, H, S, ()]) -> Result[(), String] waits {
    let (stop, stopped): (Sender[()], Receiver[()]) = channel.new(1u64)
    let Ok(status) = runner.status_root() else {
        return Error("place: status")
    }
    let ended = runner.operate(take config, take stopped, latest.handle(status), None)
    let _ = take stop
    match ended {
        Ok(Stopped(_)) => Ok(()),
        Ok(_) => Error("place: it ended without stopping"),
        Error(Open(_)) => Error("place: its store did not open"),
        Error(Listen(_)) => Error("place: it could not listen"),
        Error(Missing(take what)) => {
            let mut s = string.from("place: missing ")
            string.push(mut s, what)
            Error(take s)
        },
        Error(Exceeds(_)) => Error("place: a bound was exceeded"),
        Error(Full(_)) => Error("place: out of capacity"),
    }
}

pub fn settings(take backing: runner.Backing, clock: Clock, random: Random, tasks: Tasks, net: Net, take s: Services) -> runner.PlaceConfig[Grants, Handles, Services, ()] {
    let w = result.unwrap(wired())
    let grant_bytes = if let Some(_) = view s.live {
        LIVE_GRANT_BYTES
    } else {
        65536u64
    }
    let config = runner.TriggerConfig(entries: harness.entries(w), author: store.Caller(issuer: 0u8, subject: list.new()), grants: take s, grant: make_grants, grant_bytes: grant_bytes)
    runner.PlaceConfig(backing: take backing, sizes: sizes(), selection: Reopen, place: code.describe(place), n_place: PLACE_BYTES, on_migrate: None, schema: code.describe(schema), session: wire(), max_sessions: 1u64, proxies: list.new(), n_publisher: PLACE_BYTES, listen: loopback(), net: net, tasks: tasks, clock: clock, random: random, stop: runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: None, triggers: Some(take config), idle: Some(IDLE_MS))
}

// ---- printing ----
fn say(out: Stdout, s: String) -> () waits {
    let _ = stdout.write(out, s)
}

pub fn emit(out: Stdout, take head: String, rest: String) -> () waits {
    let mut s = take head
    string.push(mut s, rest)
    string.push(mut s, "\n")
    say(out, s)
}

fn args_text(p: harness.Payload) -> String {
    match p {
        Inline(b) => match string.from_utf8(clone(b)) {
            Ok(take s) => take s,
            Error(_) => string.from("(bytes)")
        },
        Blob(_) => string.from("(blob)"),
    }
}

fn show_entry(out: Stdout, e: harness.Entry) -> () waits {
    match e {
        User(t) => emit(out, "  user: ", t),
        Assistant(a) => {
            if string.byte_len(a.text) > 0u64 {
                emit(out, "  assistant: ", a.text)
            }
            for c in a.calls {
                let mut s = string.from("  assistant calls ")
                string.push(mut s, c.name)
                string.push(mut s, " ")
                emit(out, take s, args_text(c.args))
            }
        },
        ToolResult(id, _, shown) => {
            let words = view shown.text
            let mut s = string.from("  result ")
            string.push(mut s, id)
            string.push(mut s, ": ")
            emit(out, take s, words)
        },
        System(p) => {
            let mut s = string.from("  system: ")
            string.push_u64(mut s, list.len(p.changes))
            string.push(mut s, " section change(s)")
            if let Some(d) = p.tools {
                string.push(mut s, ", ")
                string.push_u64(mut s, list.len(d))
                string.push(mut s, " tools")
            }
            emit(out, take s, "")
        },
        Inform(t) => emit(out, "  inform: ", t),
        Note(t, _) => emit(out, "  note: ", t),
    }
}

pub fn quit(out: Stdout, why: String) -> Result[(), Exit] waits {
    emit(out, "notes: ", why)
    Error(Exit(status: 1u8))
}

const LIVE_GRANT_BYTES: u64 = 4194304u64

pub const HTTP_MS: u64 = 5000u64

pub fn count(out: Stdout, label: String, value: u64) -> () waits {
    let mut text = string.new()
    string.push_u64(mut text, value)
    emit(out, string.from(label), text)
}

// ---- the program ----
fn seed_place(dir: Dir, clock: Clock, random: Random, tasks: Tasks, prompt: String) -> Result[(), String] waits {
    let mut db = match store.open(tasks, dir, clock, random, options()) {
        Ok(take v) => take v,
        Error(_) => return Error("open")
    }
    let Ok(h) = store.bind_declaration(mut db, Migrate, schema) else {
        return Error("schema")
    }
    let Ok(w) = wired() else {
        return Error("wiring")
    }
    let ran = store.run(mut db, None, (store.copy_env(prompt), store.copy_env(h), store.copy_env(w)), fn(mut tx, call_env) -> Result[harness.Disposition, harness.Refused] {
        harness.open_session(mut tx, call_env.1.harness, "scripted", All)?
        harness.set_reader(mut tx, call_env.1.harness, you(), true)?
        let t = view call_env.1.tables
        let Ok(()) = store.put(mut tx, t.notes, 0u64, "Team meeting on Tuesday.") else {
            return Error(Storage)
        }
        let Ok(()) = store.put(mut tx, t.stats, NEXT_ID, 1u64) else {
            return Error(Storage)
        }
        harness.submit(mut tx, call_env.1.harness, notes_agent(call_env.1.tables), call_env.2, you(), NextTurn, harness.Submit(client_key: "k1", text: string.from(call_env.0)))
    })
    let Ok(Committed(done)) = take ran else {
        return Error("submit did not commit")
    }
    let Ok(()) = store.durable(mut db, done.ticket) else {
        return Error("durable")
    }
    let Ok(()) = store.close(take db) else {
        return Error("close")
    }
    Ok(())
}

// Finds the open approval, shows the held call and approves it under its key.
fn approve(out: Stdout, dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), String] waits {
    let mut db = match store.open(tasks, dir, clock, random, options()) {
        Ok(take v) => take v,
        Error(_) => return Error("open")
    }
    let Ok(h) = store.bind_declaration(mut db, Open, schema) else {
        return Error("schema")
    }
    let snap = store.snapshot(db)
    let Ok(waits) = harness.pending_approvals(result.unwrap(store.reader(db, 0u64)), snap, h.harness, you()) else { return Error("read approvals") }
    if list.len(waits) != 1u64 { return Error("expected one open approval") }
    let wait = waits[0u64]
    let ek = harness.EffectKey(run: wait.run, round: wait.round, kind: harness.TOOL, ordinal: wait.ordinal)
    let Ok(Some(held)) = store.get(result.unwrap(store.reader(db, 0u64)), snap, h.harness.effects, ek) else {
        return Error("the held call is missing")
    }
    if let Some(c) = held.call {
        let mut s = string.from("held for approval: ")
        string.push(mut s, c.name)
        string.push(mut s, " ")
        emit(out, take s, args_text(c.args))
    }
    let Ok(w) = wired() else {
        return Error("wiring")
    }
    let d = harness.Decision(run: wait.run, round: wait.round, ordinal: wait.ordinal, key: clone(wait.key), allow: true)
    let ran = store.run(mut db, None, (store.copy_env(h), store.copy_env(w), store.copy_env(d)), fn(mut tx, call_env) -> Result[harness.Ruling, harness.Refused] {
        harness.decide(mut tx, call_env.0.harness, notes_agent(call_env.0.tables), call_env.1, you(), clone(call_env.2))
    })
    let Ok(Committed(done)) = take ran else {
        return Error("the decision did not commit")
    }
    let Ok(()) = store.durable(mut db, done.ticket) else {
        return Error("durable")
    }
    emit(out, "you approved it", "")
    let Ok(()) = store.close(take db) else {
        return Error("close")
    }
    Ok(())
}

fn report(out: Stdout, dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), String] waits {
    let Ok(take opened) = store.open(tasks, dir, clock, random, options()) else {
        return Error("open")
    }
    let mut db = take opened
    let Ok(handles) = store.bind_declaration(mut db, Open, schema) else {
        return Error("schema")
    }
    let h = view handles.harness
    let t = view handles.tables
    let snap = store.snapshot(db)
    let Ok(Some(session)) = store.get(result.unwrap(store.reader(db, 0u64)), snap, h.session, 0u64) else {
        return Error("no session")
    }
    emit(out, "transcript:", "")
    for pos in 0u64 .. session.next_pos {
        if let Ok(Some(e)) = store.get(result.unwrap(store.reader(db, 0u64)), snap, h.entries, pos) {
            show_entry(out, e)
        }
    }
    emit(out, "notes:", "")
    let mut rows = match store.scan(result.unwrap(store.reader(db, 0u64)), snap, t.notes, Unbounded, Unbounded) {
        Ok(take v) => take v,
        Error(_) => return Error("scan")
    }
    while let Ok(Some((id, text))) = store.next(result.unwrap(store.reader(db, 0u64)), mut rows) {
        let mut s = string.from("  ")
        string.push_u64(mut s, id)
        string.push(mut s, ". ")
        emit(out, take s, text)
    }
    let counted = match store.get(result.unwrap(store.reader(db, 0u64)), snap, t.stats, RESULTS) {
        Ok(Some(n)) => n,
        _ => 0u64
    }
    let mut tallied = string.from("tool results counted by the reaction: ")
    string.push_u64(mut tallied, counted)
    emit(out, take tallied, "")
    let Ok(Some(run)) = store.get(result.unwrap(store.reader(db, 0u64)), snap, h.runs, 0u64) else {
        return Error("no run")
    }
    let mut s = string.from("spend: ")
    string.push_u64(mut s, run.spend.known)
    string.push(mut s, " tokens, ")
    string.push_u64(mut s, run.spend.reserved)
    string.push(mut s, " reserved")
    emit(out, take s, "")
    let _ = store.close(take db)
    Ok(())
}

pub fn main(out: Stdout, data: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), Exit] waits {
    let prompt = "The team meeting moved to Thursday. Please note it and tidy up."
    let mut parent_name = string.with_capacity(32u64)
    let Ok(parent) = host.mkdtemp(data, mut parent_name) else {
        return quit(out, "cannot make the place directory")
    }
    let mut helper_name = string.with_capacity(32u64)
    let Ok(helper) = host.mkdtemp(data, mut helper_name) else {
        return quit(out, "cannot make the helper directory")
    }
    if let Error(take why) = seed_place(parent, clock, random, tasks, prompt) {
        return quit(out, why)
    }
    emit(out, "you: ", prompt)
    let (ask, asks): (Sender[HelperAsk], Receiver[HelperAsk]) = channel.new(1u64)
    let config = helper_settings(helper, clock, random, tasks, net)
    let writer = store.writer_bytes(result.unwrap(store.writer_plan(Directory, options())))
    // Runner's 1 MiB keep and 8 MiB for the helper's submit and read work.
    let allowance = result.unwrap(runner.operate_bytes(config)) + 9 * 1048576u64 + writer
    let helping = task.spawn(tasks, bytes allowance, HelperSeed(inbox: take asks, dir: helper, clock: clock, random: random, tasks: tasks, net: net), helper_service)
    let first = until_idle(settings(Disk(parent), clock, random, tasks, net, Services(helper: channel.sender(ask), clock: clock, live: None, stream: None)))
    if let Error(take why) = first {
        return quit(out, why)
    }
    if let Error(take why) = approve(out, parent, clock, random, tasks) {
        return quit(out, why)
    }
    let second = until_idle(settings(Disk(parent), clock, random, tasks, net, Services(helper: channel.sender(ask), clock: clock, live: None, stream: None)))
    if let Error(take why) = second {
        return quit(out, why)
    }
    let summarized = report(out, parent, clock, random, tasks)
    let _ = take ask
    let _ = task.join(take helping)
    let _ = std.dir.remove_all(data, parent_name)
    let _ = std.dir.remove_all(data, helper_name)
    match take summarized {
        Ok(()) => Ok(()),
        Error(take why) => quit(out, why)
    }
}

fn disk_watermark_rows(s: Snapshot, sh: Table[u64, u64], expected: Option[(u64, u64)]) -> Result[bool, Error] waits {
    let old = match expected {
        Some((1, v)) => Some(v),
        _ => None
    }
    let new = match expected {
        Some((2, v)) => Some(v),
        _ => None
    }
    if get(law_reader(s), s, sh, 1)? != old || get(law_reader(s), s, sh, 2)? != new {
        return Ok(false)
    }
    let mut rows = scan(law_reader(s), s, sh, Unbounded, Unbounded)?
    if next(law_reader(rows.capture), mut rows)? != expected || next(law_reader(rows.capture), mut rows)? != None {
        return Ok(false)
    }
    let inspected = look(law_reader(s), s, None, (copy_env(expected), copy_env(sh), copy_env(old), copy_env(new)), fn(tx, call_env) -> Result[bool, Error] {
        if fetch(tx, call_env.1, 1)? != call_env.2 || fetch(tx, call_env.1, 2)? != call_env.3 {
            return Ok(false)
        }
        let mut ranged = range(tx, call_env.1, Unbounded, Unbounded)?
        Ok(next_in(tx, mut ranged)? == call_env.0 && next_in(tx, mut ranged)? == None)
    })?
    match take inspected {
        Seen(take seen) => {
            let Seen(value: take result_value, ..) = take seen
            take result_value
        },
        _ => Ok(false)
    }
}

// STORE-SPEC §§1.5, 1.9 and 3.4. The checkpoint contains the table and no
// data rows. The discarded COMMIT inserts (1, 10). After recovery, the first
// insert (2, 20) reuses the discarded leaf's id. Reads from each snapshot
// stay on its own leaf, and the old snapshot confers no authority to fork.
fn disk_watermark_cut(d: Dir, c: Clock, r: Random, tasks: Tasks, torn: bool) -> Result[(), Error] waits {
    let mut options = disk_crash_options("watermark-absent")
    let mut db = open(tasks, d, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let sh = view t
    let (_, take page_record) = disk_read_page_manifest("MANIFEST", failure_result_from_rep(manifest.disk_read_file(d, "MANIFEST", 4096))?)?
    let segment = failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(db), "")))?
    let end = failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(db), ".end")))?
    let durable_prefix = read_journal_prefix(d, segment, file_end(db))?
    let boundary = failure_result_from_rep(manifest.disk_read_file(d, end, 4096))?
    if !typed_put(mut db, t, 1, 10) {
        fail("watermark: old insert did not commit")
    }
    let old = snapshot(db)
    let old_id = pages.tree_stamp(old.roots.collections)
    if old_id < page_record.next_stamp {
        fail("watermark: old node was below the cut")
    }
    // Drain the writer to materialize the frame, then construct the two
    // legal power-cut images before its sync: absent write or torn tail.
    // The retained Snapshot models a reader holding the old-open roots.
    let frame_end = file_end(db)
    close(take db)?
    if torn {
        if frame_end <= list.len(durable_prefix) + 1 {
            fail("watermark: no frame to tear")
        }
        let torn_prefix = read_journal_prefix(d, segment, frame_end - 1)?
        failure_result_from_rep(manifest.disk_write_synced(d, segment, torn_prefix))?
    } else {
        failure_result_from_rep(manifest.disk_write_synced(d, segment, durable_prefix))?
    }
    failure_result_from_rep(manifest.disk_write_synced(d, end, boundary))?
    options.create = false
    let mut reopened = open(tasks, d, c, r, options)?
    let recovered = snapshot(reopened)
    if !types.same(old.store.hi, old.store.lo, recovered.store.hi, recovered.store.lo) || old.open == recovered.open {
        fail("watermark: missing reopen fence")
    }
    if !disk_watermark_rows(recovered, sh, None)? {
        fail("watermark: discarded row visible after reopen")
    }
    let reopened_table = table(mut reopened, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !typed_put(mut reopened, reopened_table, 2, 20) {
        fail("watermark: new insert did not commit")
    }
    let new = snapshot(reopened)
    let new_id = pages.tree_stamp(new.roots.collections)
    if new_id != old_id {
        fail("watermark: fixture did not reissue the old node id")
    }
    if !disk_watermark_rows(old, sh, Some((1, 10)))? || !disk_watermark_rows(new, sh, Some((2, 20)))? {
        fail("watermark: snapshots alias after node id reissue")
    }
    if !is_foreign(changes(law_reader(old), old, new)) || !is_foreign(changes(law_reader(new), new, old)) || !is_foreign(fork(mut reopened, "stale", old)) || !is_foreign(pin(mut reopened, "stale", old)) {
        fail("watermark: accepted an old-open snapshot with a reissued node id")
    }
    let (b, _) = fork(mut reopened, "fresh", new)?
    if !disk_watermark_rows(snapshot_of(reopened, b)?, sh, Some((2, 20)))? {
        fail("watermark: fresh fork saw the discarded row")
    }
    close(take reopened)
}

pub fn disk_law_watermark_reissue(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    result.unwrap(disk_watermark_cut(disk_test_directory(d), c, r, tasks, false))
    result.unwrap(disk_watermark_cut(disk_test_directory(d), c, r, tasks, true))
    true
}

// L28 caller component: Full is not poison, a refused cut changes no version
// or manifest generation, and deleting the oversized row permits the retry.
pub fn disk_law_db_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    // S3 also admits the queued 1 MiB frame.
    options.resident_limit = 2097152 + 1048639
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(law_table(mut db, "large", std.codec.key_u64(), std.codec.of_string()))
    let t = result.unwrap(table(mut db, "large", std.codec.key_u64(), std.codec.of_string()))
    let mut raw: Bytes = list.with_capacity(1048566)
    list.fill(mut raw, 1048566, 97u8)
    let large = result.unwrap(string.from_utf8(take raw))
    let saved = result.unwrap(run(mut db, None, (copy_env(t), copy_env(large)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.0, 1, call_env.1)
    }))
    match take saved {
        Committed(_) => {},
        _ => return false
    }
    let before = version(snapshot(db))
    if before != 2 {
        return false
    }
    match (bound bytes 524288 {
        checkpoint(mut db)
    }) {
        Ok(Error(Full(Allocation(_)))) => {},
        _ => return false
    }
    if version(snapshot(db)) != before || db.checkpointed != 2 {
        return false
    }
    if let Some(_) = journal_poison(db) {
        return false
    }
    let unchanged = result.unwrap(disk_load(d, 2097152))
    if unchanged.manifest.generation != 2 || unchanged.manifest.branches[0].version != 1 {
        return false
    }
    let removed = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[bool, Error] {
        delete(mut tx, call_env, 1)
    }))
    match take removed {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    let commit_ticket = result.unwrap(checkpoint(mut db))
    match commit_ticket.mark {
        Cut(3) => {},
        _ => return false
    }
    if version(snapshot(db)) != 3 {
        return false
    }
    result.unwrap(close(take db))
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    let value = result.unwrap(get(result.unwrap(reader(reopened, 0u64)), snapshot(reopened), t, 1))
    let good = version(snapshot(reopened)) == 3 && value == None
    result.unwrap(close(take reopened))
    if !good {
        return false
    }
    // Loading the graph in the worker can be refused too. Each room either
    // opens at version3 or refuses with Full; a refusal leaves MANIFEST at
    // generation3 and releases LOCK, so the next open goes ahead.
    let mut load_refused: u64 = 0
    let mut load_opened: u64 = 0
    let rooms: Inline[u64, 4] =[128, 1024, 20971520, 33554432]
    for room in rooms {
        match (bound bytes room {
            open(tasks, d, c, r, options)
        }) {
            Ok(Ok(take opened)) => {
                load_opened += 1
                let at = version(snapshot(opened))
                result.unwrap(close(take opened))
                if at != 3 {
                    return false
                }
            },
            Ok(Error(Full(_))) => {
                load_refused += 1
                let kept = result.unwrap(disk_load(d, 2097152))
                if kept.manifest.generation != 3 {
                    return false
                }
            },
            _ => return false,
        }
    }
    load_refused > 0 && load_opened > 0
}

@test
fn disk_test_db_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_db_refusal(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }

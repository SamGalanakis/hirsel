fn commit_ran[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[Outcome[R, A], Error] {
    let checked = prepare_run_commit(mut db, i, take ran)?
    match take checked {
        Ready(take draft, take publication) => Ok(commit_prepared(mut db, i, take draft, take publication)),
        OverLimit(_, c) => Ok(Refused(c))
    }
}

// Runs and commits without the I4 settle: the S1 laws' direct entry.
fn execute[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] {
    let keep_reply: Option[fn(A) -> bool] = None
    let attempt = call_attempt(db.heads[i].roots.collections.root, db.writer_pin_bytes)
    let no_pins: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    match stage(mut db, i, wall, steps, keep_reply, attempt, no_pins, body) {
        Over(take o) => Ok(take o),
        Ran(take ran) => commit_ran(mut db, i, take ran),
        DraftError(take problem) => Error(take problem),
        Latched => fail("execute: a Hot law's attempt latched")
    }
}

fn fetch_raw(tx: Tx, id: u32, key: Bytes) -> Result[Option[Bytes], Error] {
    match fetch_logical(tx, logical_key(id, key)?)? {
        Some(v) => Ok(Some(copied(v)?)),
        None => Ok(None)
    }
}

fn put_bytes(mut tx: Tx, id: u32, key: Bytes, val: Bytes) -> Result[(), Error] {
    let p = logical_key(id, key)?
    let frame = put_frame(tx, p, val, tx.frame_bytes)?
    let exists = match std.page.collection_child(tx.roots.collections.root, list.slice(p, 0, 4)) {
        Some(_) => true,
        None => false,
    }
    if !exists {
        let height = tree_height(tx.roots.collections)
        let mut draw = reserve_ids(mut tx, height)?
        define_collection(mut tx.roots.collections, id, 1, tx.private_from, mut draw)?
        tx.resident += 126
    }
    apply_put(mut tx, take p, copied(val)?, false)?
    tx.frame_bytes = frame
    Ok(())
}

fn put_logical_key(mut tx: Tx, take p: Bytes, take val: Bytes) -> Result[(), Error] {
    let frame = put_frame(tx, p, val, tx.frame_bytes)?
    apply_put(mut tx, take p, take val, false)?
    tx.frame_bytes = frame
    Ok(())
}

fn delete_bytes(mut tx: Tx, id: u32, key: Bytes) -> Result[bool, Error] {
    let p = logical_key(id, key)?
    let Some(refund) = delete_refund(tx, p)? else {
        return Ok(false)
    }
    let frame = edit_frame(tx.ops, tx.below, tx.extra_bytes, p, None, tx.frame_bytes)?
    apply_delete(mut tx, take p, refund)?
    tx.frame_bytes = frame
    Ok(true)
}

// The COMMIT frame this Tx encodes (section 2.4). A frame with stream ops and
// no data ops has no data head.
// G1: admit the entire frame before staging either the reply or the CALL.
fn reply_recorded(mut tx: Tx, p: u64, take r: Bytes, take c: CallRecord) -> Result[(), Error] {
    if let Some(_) = tx.call {
        return Error(Exists("call"))
    }
    for layer in tx.below {
        if let Some(_) = layer.call {
            return Error(Exists("call"))
        }
    }
    let (take key, take value) = reply_row(tx, result.unwrap(stream_key_bytes(c.stream)), p, r)?
    call_checked(c)?
    let size = call_section_bytes(c, None)
    stream_write(mut tx, take key, take value, size)?
    tx.call = Some(CallSection(record: take c, settlement: None))
    Ok(())
}

fn get_raw(s: Snapshot, id: u32, key: Bytes) -> Result[Option[Bytes], Error] {
    let p = logical_key(id, key)?
    match get_page_row(s.roots.collections, p) {
        Some(v) => Ok(Some(copied(v)?)),
        None => Ok(None)
    }
}

fn decode_word(b: Bytes) -> u64 {
    let mut n: u64 = 0
    for byte in b {
        n = (n << 8) | int.widen(byte)
    }
    n
}

fn raw_test_db(c: Clock, cap: u64) -> Db {
    let mut db = test_db(c, cap)
    result.unwrap(define_store_collection(mut db.heads[0].roots.collections, 1, 1, mut db.next_node))
    db.resident = 126
    take db
}

fn put_one(mut db: Db, k: u64, v: u64) -> bool {
    let outcome = execute(mut db, 0, 20, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(k), key_word(v))
    })
    match take outcome {
        Ok(Committed(_)) => true,
        _ => false
    }
}

fn value_at(s: Snapshot, k: u64) -> u64 {
    match result.unwrap(get_raw(s, 1, key_word(k))) {
        Some(raw) => decode_word(raw),
        None => 0
    }
}

// L1: sorted slot model, own writes, abort and fault never change published roots.
// Wrong implementation caught: publish before body success; omit old-root lookup.
// The commands come from a std.prop tape, so a failing sequence shrinks to a
// minimal one. A command is (kind, slot): kind 0 deletes, 1 and 2 put, 3 puts
// then aborts, 4 puts then faults. Command i runs at wall i and puts wall + 1.
pub fn law_model(seed: u64) -> Result[(), ()] {
    let command = std.prop.pair(std.prop.u64_in(0, 4), std.prop.u64_in(0, 23))
    let commands = std.prop.make(fn(mut src: std.prop.Source) -> List[(u64, u64)] {
        let mut tape: List[(u64, u64)] = list.new()
        for i in 0u64 ..= 128 {
            let drawn = std.prop.span(mut src, 1, fn(mut choice: std.prop.Source) -> Option[(u64, u64)] {
                // 99% continuation puts about half the tapes at depth 64.
                // Record a stop at the cap too, so deleting a span still replays.
                let more = std.prop.weighted(mut choice, if i < 128 { 99 } else { 0 }, 100)
                if more && i < 128 { Some(std.prop.draw(mut choice, command)) } else { None }
            })
            let Some(operation) = drawn else { break }
            list.push(mut tape, operation)
        }
        take tape
    }, model_show_tape)
    let mut config = std.prop.config()
    config.seed = seed
    std.prop.check(config, take commands, model_run)
}

fn model_show_tape(tape: List[(u64, u64)], mut out: String) {
    string.push(mut out, "[")
    let mut sep = ""
    for (kind, slot) in tape {
        string.push(mut out, sep)
        string.push(mut out, "(")
        string.push_u64(mut out, kind)
        string.push(mut out, ", ")
        string.push_u64(mut out, slot)
        string.push(mut out, ")")
        sep = ", "
    }
    string.push(mut out, "]")
}

// A closure cannot capture the test's Clock (LANG-14), so each run takes a
// virtual one; the store reads no time beyond the wall each command passes.
fn model_run(tape: List[(u64, u64)]) -> Result[(), String] {
    let _ = std.prop.sometimes("64 or more commands", list.len(tape) >= 64)
    let (c, _hand) = provide.clock(0u64, 0u64)
    let mut db = raw_test_db(c, 1073741824)
    let mut model: List[u64] = list.with_capacity(24)
    list.fill(mut model, 24, 0u64)
    let mut wall: u64 = 0
    for (kind, k) in tape {
        if !model_step(mut db, wall, kind, k) {
            return Error(model_miss("outcome", wall, kind, k))
        }
        if kind < 3 {
            let _ = list.set(mut model, k, if kind == 0 {
                0u64
            } else {
                wall + 1
            })
        }
        let held = snapshot(db)
        for at in 0u64 .. 24 {
            if value_at(held, at) != model[at] {
                return Error(model_miss("published slots", wall, kind, k))
            }
        }
        wall += 1
    }
    Ok(())
}

fn model_miss(what: String, wall: u64, kind: u64, k: u64) -> String {
    let mut out = string.from("L1: ")
    string.push(mut out, what)
    string.push(mut out, " differ from the model after command ")
    string.push_u64(mut out, wall)
    string.push(mut out, " (kind ")
    string.push_u64(mut out, kind)
    string.push(mut out, ", slot ")
    string.push_u64(mut out, k)
    string.push(mut out, ")")
    out
}

// L2: an escaped cursor and snapshot retain exactly the transaction's frozen tree.
// Wrong implementation caught: cursor over the current head or in-place mutation.
pub fn law_snapshots(c: Clock) -> bool {
    let mut db = raw_test_db(c, 1073741824)
    for k in 0u64 .. 24 {
        if !put_one(mut db, k, k + 1) {
            return false
        }
    }
    let held = snapshot(db)
    let before = version(held)
    let rows_result = execute(mut db, 0, 30, None, fn(mut tx: Tx) -> Result[PageRange, Error] {
        let rows = byte_cursor(tx.roots.collections, Included(prefix(1)?), prefix(2)?)?
        put_bytes(mut tx, 1, key_word(0), key_word(9999))?
        Ok(take rows)
    })
    let mut rows = match take rows_result {
        Ok(Committed(take done)) => {
            let Done(value: take cursor, ticket: _, info: _, reads: _) = take done;
            take cursor
        },
        _ => return false
    }
    for k in 0u64 .. 1000 {
        if !put_one(mut db, k % 24, 10000 + k) {
            return false
        }
    }
    for k in 0u64 .. 24 {
        if value_at(held, k) != k + 1 {
            return false
        }
        match result.unwrap(next_bytes(mut rows)) {
            Some((_, v)) => if decode_word(v) != k + 1 {
                return false
            },
            None => return false
        }
    }
    version(held) == before && result.unwrap(next_bytes(mut rows)) == None
}

// L15: reads see their own writes. The two point reads precede the adjacent
// gaps that cover exactly the exhausted range.
pub fn law_reads_ranges(c: Clock) -> bool waits {
    if !range_boundary_points(c) {
        return false
    }
    let mut db = test_db(c, 1073741824)
    let cv = std.codec.of_u64()
    result.unwrap(create_table(mut db, spec("range-law", std.codec.key_u64(), cv)))
    let t = result.unwrap(table(mut db, "range-law", std.codec.key_u64(), cv))
    let sh = view t
    for k in 0u64 .. 6 {
        if !typed_put(mut db, t, k, k + 1) {
            return false
        }
    }
    let outcome = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[u64, Error] {
        let _ = fetch(tx, sh, 1)?
        put(mut tx, t, 2, 42)?
        if fetch(tx, sh, 2)? != Some(42u64) {
            return Error(Foreign)
        }
        let mut rows = range(tx, sh, Excluded(1), Included(3))?
        let mut sum: u64 = 0
        while let Some((_, val)) = next_in(tx, mut rows)? {
            sum += val
        }
        Ok(sum)
    })
    match take outcome {
        Ok(Committed(done)) => {
            if done.value != 46 || list.len(done.reads) != 4 {
                return false
            }
            let one = result.unwrap(logical_key(t.id, key_word(1)))
            let two = result.unwrap(logical_key(t.id, key_word(2)))
            let lo = result.unwrap(lower_bytes(t.id, Excluded(key_word(1)), false))
            let middle = result.unwrap(lower_bytes(t.id, Excluded(key_word(2)), false))
            let hi = result.unwrap(lower_bytes(t.id, Included(key_word(3)), true))
            same_read(done.reads[0], Point(take one)) && same_read(done.reads[1], Point(take two)) && same_read(done.reads[2], Span(take lo, result.unwrap(copied(middle)))) && same_read(done.reads[3], Span(take middle, take hi))
        },
        _ => false
    }
}

// L18a,b,d: published SplitMix64 vector, backward wall clock, branch in id/seed.
// Wrong implementation caught: seed=0, raw clock, branch omitted from the id.
pub fn law_call_info(c: Clock) -> bool {
    if !seed_boundary_points() {
        return false
    }
    if splitmix64(0) != 0xE220A8397B1DCDAFu64 {
        return false
    }
    let id = StoreId(hi: 1, lo: 2)
    let a = call_info(id, 0, 1, 30, 0)
    let b = call_info(id, 1, 1, 20, 0)
    if a.seed != 0xC817A9BF84F9A191u64 || a.id.branch == b.id.branch || a.seed == b.seed {
        return false
    }
    let mut db = test_db(c, 1073741824)
    for wall in 0u64 .. 4 {
        let outcome = execute(mut db, 0, 30 - wall, None, fn(mut tx: Tx) -> Result[u64, ()] {
            Ok(info(mut tx).at)
        })
        match take outcome {
            Ok(Committed(done)) => if done.value != 30 || done.info.at != 30 {
                return false
            },
            _ => return false
        }
    }
    true
}

// Resident: exact entry arithmetic, ignored operation failure still refuses a commit.
// Wrong implementation caught: charge payload alone or publish beyond the ceiling.
pub fn law_resident(c: Clock) -> bool {
    if !resident_rounding_points() {
        return false
    }
    let mut db = raw_test_db(c, 212)
    if !put_one(mut db, 1, 10) || db.resident != 212 {
        return false
    }
    let refused_write = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(2), key_word(20))
    })
    match take refused_write {
        Ok(Refused(Resident(cap))) => if cap.requested != 298 || cap.available != 212 {
            return false
        },
        _ => return false
    }
    if value_at(snapshot(db), 2) != 0 || db.heads[0].head != 1 {
        return false
    }
    let removed = execute(mut db, 0, 2, None, fn(mut tx: Tx) -> Result[bool, Error] {
        delete_bytes(mut tx, 1, key_word(1))
    })
    match take removed {
        Ok(Committed(done)) => if !done.value {
            return false
        },
        _ => return false
    }
    db.resident == 126 && value_at(snapshot(db), 1) == 0
}

// L20's byte-core handle boundary; typed handles await S0's reader ruling.
pub fn law_foreign(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let stores: Inline[StoreId, 3] =[StoreId(hi: 9, lo: 2), StoreId(hi: 1, lo: 9), StoreId(hi: 9, lo: 9)]
    for i in 0u64 .. 3 {
        let foreign = Branch(store: stores[i], id: 0)
        let outcome = run_on(mut db, foreign, None, (), fn(mut tx, unused_env) -> Result[(), ()] {
            fail("foreign body must not run")
        })
        match take outcome {
            Error(Foreign) => if db.heads[0].head != 0 {
                return false
            },
            _ => return false
        }
    }
    true
}

fn model_step(mut db: Db, wall: u64, kind: u64, k: u64) -> bool {
    let outcome = execute(mut db, 0, wall, None, fn(mut tx: Tx) -> Result[u64, Error] {
        let v = info(mut tx).at + 1
        if kind == 0 {
            let _ = delete_bytes(mut tx, 1, key_word(k))?
        } else {
            put_bytes(mut tx, 1, key_word(k), key_word(v))?
            let raw = option.unwrap(fetch_raw(tx, 1, key_word(k))?)
            if decode_word(raw) != v {
                return Error(Missing("law"))
            }
        }
        if kind == 3 {
            return Error(Foreign)
        }
        if kind == 4 {
            fail("L1 injected fault")
        }
        Ok(1)
    })
    match take outcome {
        Ok(Committed(_)) => kind < 3,
        Ok(Aborted(Undone(value: Foreign, ticket: None))) => kind == 3,
        Ok(Failed(_)) => kind == 4,
        _ => false
    }
}


// rule: LANG-13
// expect: run
// An owned nested match must retain conditional payload flags across tag observations.
type S = Closed | Corrupt(String) | Other

type E = Storage(S) | Limit(String) | Extra(String)

fn describe(take v: Result[(), E]) -> String {
  match take v {
    Ok(_) => "ok",
    Error(Storage(Closed())) => "closed",
    Error(Storage(Corrupt(m))) => copy m,
    Error(Storage(_)) => "other storage",
    Error(Limit(_)) => "limit",
    _ => "other",
  }
}

pub fn main() -> Result[(), ()] {
  failure.check(describe(Ok(())) == "ok", Arithmetic())
  failure.check(describe(Error(Storage(Closed()))) == "closed", Arithmetic())
  failure.check(describe(Error(Storage(Corrupt("bad")))) == "bad", Arithmetic())
  failure.check(describe(Error(Storage(Other()))) == "other storage", Arithmetic())
  failure.check(describe(Error(Limit("l"))) == "limit", Arithmetic())
  failure.check(describe(Error(Extra("e"))) == "other", Arithmetic())
  Ok(())
}

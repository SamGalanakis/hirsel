// Module runner (package store): the entries of a place (RUNNER-SPEC v2.10).
// Room and Bad mirror Capacity and DecodeError, which are not codec (OWN-4).
pub type Room: codec + send { requested: u64, available: u64 }

pub type Bad: codec + send { kind: u32, at: u64 }

pub type Kind: codec + key + send = Compute | Transact | Query | Granted

pub type Refusal: codec + send = NoEntry | Malformed(Bad) | Overloaded | Deadline | Budget(Room) | NotAllowed | RequestMismatch | HistoryUnavailable

pub type Fault: codec + send = Raised(u32) | OutOfBytes(Room) | OutOfTime(u64) | Gone

pub type Outcome: codec + send = Returned(Bytes) | Failed(Fault) | Refused(Refusal) | Abandoned | InDoubt

pub type Described: codec + send { kind: Kind, identity: Bytes, args: Bytes, result: Bytes }

// WIRE-SPEC v2 §3. Declared variant order fixes the u32 wire tags, Hello 0 to Reset 8.
pub type Want: codec + send { identity: Bytes, args_fp: u64, result_fp: u64 }

pub type Entry: codec + send = Ready(u32) | Resolve(u32, Bytes) | Gone

pub type Done: codec + send { stream: u32, p: u64, outcome: Outcome }

// key is the data-tree key (table id and key-codec integers big-endian). value is
// the current value codec's bytes, without a stored schema prefix; None removes it.
pub type Row: codec + send { sub: u32, key: Bytes, value: Option[Bytes] }

pub type Frame: codec + send = Hello(Option[Bytes], List[Want]) | Call(u32, u64, u32, u32, Bytes) | Subscribe(u32, u32, Bytes, Option[Bytes]) | Unsubscribe(u32) | Welcome(Caller, u32, u64, Bytes, String, u64) | Placed(Entry) | Batch(u64, List[u32], List[Row], List[Done]) | Ended(u32, Outcome) | Reset(u64, List[Done])

pub type RegisterError: send = Full(Capacity) | AlreadyRegistered(Bytes) | Bounds

pub const DEFAULT_STEPS: u64 = 1 << 30

pub type Caller = store.Caller
pub const SUBJECT_MAX: u64 = 64u64

pub fn caller_key(c: Caller, mut out: Bytes) -> Result[(), Capacity] {
    let n = list.len(c.subject)
    if n > SUBJECT_MAX { return Error(Capacity(requested: n, available: SUBJECT_MAX)) }
    list.reserve(mut out, n + 2u64)
    let _ = list.push(mut out, c.issuer)
    let _ = list.push(mut out, int.narrow(n))
    Ok(list.append(mut out, c.subject))
}

pub fn stream_key(c: Caller, number: u32) -> Result[Bytes, Capacity] {
    let mut stream: Bytes = list.with_capacity(list.len(c.subject) + 6u64)
    caller_key(c, mut stream)?
    std.codec.encode_key(std.codec.key_u32(), number, mut stream)
    Ok(take stream)
}

pub type FoundActivation: send = Empty | Legacy | Active(u64, Bytes, Bytes)
// `Reopen` opens the store at its current activation, or runs genesis on an empty
// store; it is what a launch without `--hirsel-activation` selects (RUNNER-SPEC §6).
pub type Selection: send = Current(u64) | Reopen | Install | InstallAt(u64)
pub type OpenError: send = Store(store.Error) | Place(RegisterError) | Migrate(store.Error) | NotCurrent(FoundActivation) | IdentityUnknown | StoreMismatch((u64, u64), (u64, u64)) | PublisherStopped | InstallVersion(u64) | InstallUncertain(store.Error)

pub type Step: send = Recovering | Activating | Publishing | Listening(Addr)
pub type Phase: send = Starting(Step) | Ready | Draining | Paused
// `store_id` and `retain_from` are the opened store's identity and retained head, as a
// hosted place reports them in `PlaceReady`; an in-process launcher reads them here.
pub type Status: shareable + send { phase: Phase, digest: Bytes, target: String, n_place: u64, release: Bytes, activation: u64, store_id: (u64, u64), retain_from: u64, addr: Option[Addr] }
pub type Stop: codec + send { lag_ms: u64, grace_ms: u64 }
pub type Backing: send = Memory | Disk(Dir) | Temp(Dir)
pub type PlaceConfig[G: send, H: send, S: send, B: send]: send {
    backing: Backing, sizes: store.Overrides, selection: Selection, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64,
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    session: WireConfig, max_sessions: u64, proxies: List[std.wsock.Prefix], n_publisher: u64,
    listen: Addr, net: Net, tasks: Tasks, clock: Clock, random: Random, stop: Stop,
    wire: Option[Wire[G, B]], triggers: Option[TriggerConfig[G, S]], idle: Option[u64],
}
// Grants are made per attempt. The context routes place calls back to the
// same head and carries the attempt fence.
pub type TriggerConfig[G: send, S: send]: send {
    entries: triggers.Entries,
    author: Caller,
    grants: S,
    grant: fn(S, take TriggerContext) -> Result[G, Capacity] waits,
    grant_bytes: u64,
}

// `Exceeds` names a PlaceConfig or WireConfig setting, its value and the most this
// place accepts for it (RUNNER-SPEC §12.1, runner.md "Sizing a place").
pub type Bound: send { name: String, value: u64, limit: u64 }
pub type StartError: send = Open(OpenError) | Listen(NetError) | Missing(String) | Exceeds(Bound) | Full(Capacity)
pub type Ended: codec + send = Stopped(Option[u64]) | Unstarted | Forced(u64)

// Private runtime-supplied launch metadata. The body is a declaration placeholder;
// the call is lowered to the immutable launch transport on every engine.
fn launch_word(field: u64, index: u64) -> u64 { 0u64 }
fn launch_socket() -> Option[Socket] { None }
fn launch_scratch() -> Option[Dir] { None }

fn launch_text(a: Args) -> View[String] in a { "" }

fn launch_target(a: Args) -> String { string.from(launch_text(a)) }

pub fn status_root() -> Result[Latest[Status], Capacity] {
    let launch = launch_env()
    let initial = Status(phase: Starting(Recovering), digest: launch_bytes(launch.digest), target: owned_launch_target(launch.target), n_place: launch.n_place, release: list.new(), activation: 0u64, store_id: (0u64, 0u64), retain_from: 0u64, addr: None)
    let shared = arc.new(take initial)
    Ok(latest.new(take shared))
}

fn status_hex(input: Bytes) -> Result[String, Capacity] {
    let digits = string.as_bytes("0123456789abcdef")
    let mut out: Bytes = list.with_capacity(2u64 * list.len(input))
    for value in input {
        list.push(mut out, digits[int.widen(value >> 4)])
        list.push(mut out, digits[int.widen(value & 15)])
    }
    Ok(result.unwrap(string.from_utf8(take out)))
}

fn status_response(value: Status) -> Result[(bool, String), Capacity] {
    let (ready, phase) = match value.phase {
        Ready => (true, "ready"),
        Paused => (true, "paused"),
        Draining => (false, "draining"),
        Starting(_) => (false, "starting"),
    }
    let digest = status_hex(value.digest)?
    let release = status_hex(value.release)?
    let mut allowance = string.new()
    string.push_u64(mut allowance, value.n_place)
    let mut body = string.new()
    std.json.write(mut body, false, scoped fn(json: std.json.Writer) {
        std.json.object(json, 0u64, scoped fn(w: std.json.Writer, mut keys: std.json.Items) {
            std.json.write_member(w, mut keys, "phase")
            std.json.write_string_value(w, phase)
            std.json.write_member(w, mut keys, "digest")
            std.json.write_string_value(w, digest)
            std.json.write_member(w, mut keys, "target")
            std.json.write_string_value(w, value.target)
            std.json.write_member(w, mut keys, "n_place")
            std.json.write_number_spelling(w, allowance)
            std.json.write_member(w, mut keys, "release")
            std.json.write_string_value(w, release)
        })
    })
    Ok((ready, take body))
}

type IncomingStop: send { from: Receiver[()], to: Sender[LifeEvent] }

fn watch_stop(take seed: IncomingStop) -> () waits {
    let _ = channel.receive(seed.from)
    let _ = channel.send(seed.to, StopRequested)
}

type DrainTimer: send { to: Sender[LifeEvent], clock: Clock, window: DrainWindow }

fn drain_timer(take alarm: DrainTimer) -> () waits {
    host.sleep_until(alarm.clock, alarm.window.admission)
    let _ = channel.send(alarm.to, AdmissionClose)
    host.sleep_until(alarm.clock, alarm.window.deadline)
    let _ = channel.send(alarm.to, DrainExpired)
}

resource type TemporaryBacking { dir: Dir, name: String } drop(temporary) {
    if list.len(string.as_bytes(temporary.name)) != 0u64 { let _ = std.dir.remove_all(temporary.dir, temporary.name) }
}

fn publish_phase(status: Latest[Status], watch: Option[Sender[Phase]], mut current: Status, phase: Phase) -> Result[(), StartError] {
    current.phase = phase
    let copied: Status = clone(current)
    let value = take copied
    let shared = arc.new(take value)
    latest.publish(status, take shared)
    if let Some(to) = watch { let _ = channel.try_send(to, phase) }
    Ok(())
}

fn copy_status(value: Status) -> Status { clone(value) }

fn status_watch(take watch: Option[Sender[Receiver[Phase]]]) -> Result[Option[Sender[Phase]], StartError] {
    match take watch {
        Some(take handoff) => {
            let (to, from): (Sender[Phase], Receiver[Phase]) = channel.new(6u64)
            if let Error(_) = channel.try_send(handoff, take from) { return Ok(None) }
            Ok(Some(take to))
        },
        None => Ok(None),
    }
}

type CutStatus: shareable + send { started: bool }
type CutActivity: send { root: Latest[CutStatus], started: Arc[CutStatus], stopped: Arc[CutStatus] }

fn cut_activity() -> Result[CutActivity, StartError] {
    let started = arc.new(CutStatus(started: true))
    let stopped = arc.new(CutStatus(started: false))
    let root = latest.new(arc.share(stopped))
    Ok(CutActivity(root: take root, started: take started, stopped: take stopped))
}

fn serve_inbox_capacity(limit: u64) -> u64 { int.saturating_add(int.saturating_mul(limit, 2u64), 22u64) }

fn start_drain(stop: Stop, started: u64, clock: Clock, tasks: Tasks, events: Sender[LifeEvent], root: Latest[Option[DrainWindow]]) -> Result[Task[()], StartError] {
    let deadline = std.clock.deadline_after_ms(started, stop.grace_ms)
    let admission = std.clock.deadline_after_ms(started, if stop.lag_ms < stop.grace_ms { stop.lag_ms } else { stop.grace_ms })
    let window = DrainWindow(admission: admission, deadline: deadline)
    let wanted: Option[DrainWindow] = Some(window)
    let shared = arc.new(take wanted)
    latest.publish(root, take shared)
    let alarm = DrainTimer(to: channel.sender(events), clock: clock, window: window)
    Ok(task.spawn(tasks, bytes 4096u64, take alarm, drain_timer))
}

pub fn operate[G: send, H: send, S: send, B: send](take p: PlaceConfig[G, H, S, B], take stop: Receiver[()], status: Latest[Status], take watching: Option[Sender[Receiver[Phase]]]) -> Result[Ended, StartError] waits {
    operate_with_report(take p, take stop, status, take watching, None)
}

pub fn operate_report[G: send, H: send, S: send, B: send](take p: PlaceConfig[G, H, S, B], take stop: Receiver[()], status: Latest[Status], take watching: Option[Sender[Receiver[Phase]]], errors: Stderr) -> Result[Ended, StartError] waits {
    operate_with_report(take p, take stop, status, take watching, Some(errors))
}

fn operate_with_report[G: send, H: send, S: send, B: send](take p: PlaceConfig[G, H, S, B], take stop: Receiver[()], status: Latest[Status], take watching: Option[Sender[Receiver[Phase]]], report: Option[Stderr]) -> Result[Ended, StartError] waits {
    let launch = launch_env()
    let n_place = if launch.n_place_explicit { launch.n_place } else { p.n_place }
    let sized_store = place_store(p, report)
    let (take options, _, store_bytes) = match take sized_store {
        Ok(take sized) => take sized,
        Error(take e) => {
            if let Some(_) = launch.install { return finish_install(Error(take e)) }
            return Error(take e)
        },
    }
    if let Some((attempt, image)) = launch.prepare { return operate_prepare(take p, take options, n_place, attempt, image) }
    if let Some(version) = launch.install {
        let result = operate_install(take p, take options, InstallAt(version), n_place)
        return finish_install(take result)
    }
    let installing = match p.selection { Install => true, InstallAt(_) => true, _ => false }
    if installing {
        let selection = p.selection
        let _ = operate_install(take p, take options, selection, n_place)?
        return Ok(Unstarted)
    }
    if p.idle == Some(0u64) { return Error(Missing("idle")) }
    if p.stop.grace_ms == 0u64 { return Error(Missing("grace_ms")) }
    let PlaceConfig(backing: take backing, selection: selection, place: place, migrate: migrate, handles: handles, n_publisher: n_publisher,
        session: wire_config, max_sessions: limit, proxies: take proxies,
        listen: listen, net: net, tasks: tasks, clock: clock, random: random, stop: stop_config, wire: take supplied_wire, triggers: take trigger_config, idle: configured_idle, ..) = take p
    let idle = match launch.idle { Some(ms) => Some(ms), None => configured_idle }
    if let Some(take problem) = session_problem(wire_config, limit, launch.target.size) { return Error(take problem) }
    let watch = status_watch(take watching)?
    let mut current = copy_status(latest.read(status))
    let mut opening_read: Bytes = list.new()
    current.n_place = n_place
    publish_phase(status, watch, mut current, Starting(Recovering))?
    let (to, inbox): (Sender[LifeEvent], Receiver[LifeEvent]) = channel.new(12u64)
    let (head_to, inbox_head): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(64u64)
    let hosting = start_host_control(tasks, clock, n_place, head_to, to)?
    let (finish_to, finish_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let serving_total = match serving_bytes(wire_config, limit, n_place) { Ok(total) => total, Error(cap) => return Error(Full(cap)) }
    let serve_slots = serve_inbox_capacity(limit)
    // The supervisor allocates this channel before the serving task starts.
    // OwnerReady has the largest message: its tag, id and two senders cost 64 B.
    let serving_reserve = serving_total - (64u64 + serve_slots * 64u64)
    let (serve_to, inbox_serve): (Sender[ServeInput], Receiver[ServeInput]) = channel.new(serve_slots)
    let initial: Option[DrainWindow] = None
    let root = arc.new(initial)
    let drain = latest.new(take root)
    let stopping: Option[Task[()]] = match channel.try_receive(stop) {
        Error(Empty) => {
            let incoming = IncomingStop(from: take stop, to: channel.sender(to))
            Some(task.spawn(tasks, bytes 4096u64, take incoming, watch_stop))
        },
        _ => { let _ = channel.try_send(to, StopRequested); None },
    }

    let head = place_head_bytes(n_place, n_publisher, trigger_bytes(trigger_config)) ?=> Full
    let allowance = add_place_bytes(head, store_bytes) ?=> Full
    let activity = cut_activity()?
    let cut = latest.handle(activity.root)
    let head_job = ManagedHead(backing: take backing, options: take options, selection: selection, tasks: tasks, clock: clock, random: random, place: place, migrate: migrate, handles: handles,
        n_place: n_place, n_publisher: n_publisher, inbox: take inbox_head, finish_from: take finish_from, to: channel.sender(to), drain: latest.handle(drain),
        head_to: channel.sender(head_to), cut: take activity, triggering: take trigger_config, idle: idle, expected_store: launch.store_id)
    let head_run: fn(take ManagedHead[G, H, S]) -> () waits = head_ended
    // The head is the place's largest task; a root limit too small for it is a resource
    // failure that names the bytes, not a fault at this line.
    let mut heading: Option[Task[()]] = match task.try_spawn(tasks, bytes allowance, take head_job, head_run) {
        Ok(take running) => Some(take running),
        Error((cap, _)) => return Error(Full(cap)),
    }
    let mut serving: Option[Task[()]] = None
    let mut drain_waiter: Option[Task[()]] = None
    let mut ready: Option[(Listener, Sender[PubIn])] = None
    let mut unused_listener_inputs = Some((take proxies, take supplied_wire, take inbox_serve))
    let mut phase: PlacePhase = OpeningPlace
    let mut finishing: PlaceFinish = WaitingToFinish
    let mut serve_done: Option[u64] = None
    let mut next_due: Option[u64] = None
    let mut start_failure: Option[StartError] = None
    let mut idle_state: IdleState = IdleWaiting
    let mut head_idle = false
    let mut serve_idle = false
    loop {
        if place_online(phase) && !place_stopping(phase) && !place_retiring(finishing) && head_idle && serve_idle {
            if let Some(ms) = idle {
                if let IdleWaiting = idle_state {
                    let at = std.clock.deadline_after_ms(host.mono_ns(clock), ms)
                    idle_state = IdleArmed(at, std.clock.alarm(tasks, clock, at, to, IdleDeadline(at)))
                }
            }
        }
        if let DrainingPlace(was_online) = phase {
            if !latest.read(cut).started {
                if let Some(window) = drain_window(latest.read(drain)) {
                    if host.mono_ns(clock) >= window.deadline {
                        phase = ExpiredPlace(was_online)
                        let _ = channel.try_send(serve_to, ServeWake)
                    }
                }
            }
        }
        if place_expired(phase) && !latest.read(cut).started && (match serving { None => true, _ => false }) {
            if let Some(take handle) = replace(mut heading, None) {
                let mut active_head = take handle
                task.cancel(mut active_head)
                let _ = task.join(take active_head)
            }
            return Ok(Forced(match serve_done { Some(count) => count, None => 0u64 }))
        } else if !place_expired(phase) {
            if none(heading) && none(serving) && (!place_retiring(finishing) || serve_done != None) {
                if let Some(take problem) = replace(mut start_failure, None) { return Error(take problem) }
                return Ok(if place_online(phase) { Stopped(next_due) } else { Unstarted })
            }
            if serve_done != None {
                let can_finish = match finishing { SettledPlace => true, RetiringPlace => true, _ => false }
                if can_finish {
                    let _ = channel.try_send(finish_to, ())
                    let _ = channel.try_send(head_to, HeadFinish)
                    finishing = if place_retiring(finishing) { FinishingRetired } else { FinishSent }
                }
            }
        }
        let next = match channel.try_receive(inbox) { Ok(take event) => Some(take event), _ => None }
        let event = match take next {
            Some(take event) => take event,
            None => {
                if let Some((take listener, take pub_to)) = replace(mut ready, None) {
                    let (take addresses, take session_wire, take from_serve) = option.unwrap(replace(mut unused_listener_inputs, None))
                    let target = string.from(current.target)
                    let serving_config = ServePlace(listener: take listener, config: wire_config, tasks: tasks, clock: clock, random: random, wire: take session_wire,
                        max_sessions: limit, proxies: take addresses, target: take target, publisher: take pub_to, place: place, n_place: n_place,
                        head: channel.sender(head_to), inbox: take from_serve, to: channel.sender(serve_to), events: channel.sender(to), drain: latest.handle(drain),
                        status: latest.handle(status), idle: idle, first_write: match hosting { Some(host) => Some(channel.sender(host.ack)), None => None })
                    let run: fn(take ServePlace[G, H, B]) -> () waits = run_serve_place
                    serving = Some(task.spawn(tasks, bytes serving_reserve, take serving_config, run))
                }
                match channel.receive(inbox) { Ok(take incoming_event) => take incoming_event, Error(_) => return Error(Missing("lifecycle")) }
            },
        }
        let (life_input, hold_head) = match take event {
            HeadIdleChecked(Some(take held)) if !place_stopping(phase) && !place_retiring(finishing) && head_idle && serve_idle && idle_pending(idle_state) =>
                (StopRequested, Some(take held)),
            take other => (take other, None),
        }
        let accepted_input = match take life_input {
            ServePrepared if !place_stopping(phase) => {
                let _ = channel.try_send(head_to, HeadContinue)
                if let Some(control) = hosting {
                    let ready_ns = host.mono_ns(clock)
                    let release: Bytes = clone(current.release)
                    if let Error(_) = channel.send(control.answer, PlaceOpened(PlaceReady(version: current.activation, store_hi: current.store_id.0, store_lo: current.store_id.1, release: take release, retain_from: current.retain_from, ready_ns: ready_ns, read: clone(opening_read)))) {
                        return Error(Missing("host control"))
                    }
                    continue
                }
                StoreAccepted
            },
            take other => take other,
        }
        match take accepted_input {
            StopRequested => {
                if place_stopping(phase) { continue }
                let was_online = place_online(phase)
                if latest.read(cut).started {
                    phase = DeferredStop(was_online)
                    continue
                }
                let started = host.mono_ns(clock)
                phase = DrainingPlace(was_online)
                let idle_stop = !none(hold_head)
                let bounds = if idle_stop { Stop(lag_ms: 0u64, grace_ms: stop_config.grace_ms) } else { stop_config }
                drain_waiter = Some(start_drain(bounds, started, clock, tasks, to, drain)?)
                publish_phase(status, watch, mut current, Draining)?
                idle_state = IdleWaiting
                if idle_stop {
                    let _ = channel.try_send(head_to, HeadClose)
                } else {
                    let _ = channel.try_send(head_to, PauseDeadline(0u64))
                    if let Some(_) = replace(mut ready, None) { let _ = channel.try_send(head_to, HeadClose) }
                }
                let _ = take hold_head
                if !was_online { let _ = channel.try_send(serve_to, ServeWake) }
            },
            Recovered => if place_stopping(phase) { let _ = channel.try_send(head_to, HeadClose) } else {
                publish_phase(status, watch, mut current, Starting(Activating))?
                let _ = channel.try_send(head_to, HeadContinue)
            },
            Activated(take release, version, identity, retained, take read) => {
                opening_read = take read
                current.release = take release
                current.activation = version
                current.store_id = identity
                current.retain_from = retained
                if place_stopping(phase) {
                    publish_phase(status, None, mut current, Draining)?
                    let _ = channel.try_send(head_to, HeadClose)
                } else {
                    publish_phase(status, watch, mut current, Starting(Publishing))?
                    let _ = channel.try_send(head_to, HeadContinue)
                }
            },
            Published(take pub_to) => if place_stopping(phase) { let _ = channel.try_send(head_to, HeadClose) } else {
                match host.listen(net, listen, 128u16) {
                    Ok((take listener, address)) => {
                        current.addr = Some(address)
                        publish_phase(status, watch, mut current, Starting(Listening(address)))?
                        ready = Some((take listener, take pub_to))
                    },
                    Error(problem) => { start_failure = Some(Listen(problem)); let _ = channel.try_send(head_to, HeadClose) },
                }
            },
            ServePrepared => {
                let _ = channel.try_send(serve_to, ServeWake)
                let _ = channel.try_send(head_to, HeadClose)
            },
            StoreAccepted => if !place_online(phase) && !place_stopping(phase) {
                publish_phase(status, watch, mut current, Ready)?
                phase = match phase { DeferredStop(_) => DeferredStop(true), _ => OnlinePlace }
                let _ = channel.try_send(serve_to, ServeStart)
            },
            AdmissionClose => {
                if let Some(_) = serving { let _ = channel.try_send(head_to, HeadClose); let _ = channel.try_send(serve_to, ServeWake) }
            },
            DrainExpired => {
                if !latest.read(cut).started {
                    phase = ExpiredPlace(place_online(phase))
                    let _ = channel.try_send(serve_to, ServeWake)
                }
            },
            IdleDeadline(at) => if !place_stopping(phase) && !place_retiring(finishing) {
                if let IdleArmed(due, _) = idle_state {
                    if at == due {
                        idle_state = match channel.try_send(serve_to, CheckServeIdle) {
                            Ok(()) => CheckingServe(Some(due)),
                            Error(_) => IdleWaiting,
                        }
                    }
                }
            },
            HeadIdle(value) => {
                head_idle = value
                if !value { invalidate_idle(mut idle_state) }
            },
            ServeIdle(value) => {
                serve_idle = value
                if !value { invalidate_idle(mut idle_state) }
            },
            ServeIdleChecked(take held) => {
                if !place_stopping(phase) && !place_retiring(finishing) && head_idle {
                    if let CheckingServe(Some(due)) = idle_state {
                        if let Some(take permit) = take held {
                            if let Ok(()) = channel.try_send(head_to, CheckHeadIdle) {
                                idle_state = CheckingHead(Some(due), take permit)
                                continue
                            }
                        }
                    }
                }
                idle_state = IdleWaiting
            },
            HeadIdleChecked(_) => { idle_state = IdleWaiting },
            Settled => if let WaitingToFinish = finishing { finishing = SettledPlace },
            WritesPaused => if !place_stopping(phase) { publish_phase(status, watch, mut current, Paused)? },
            WritesResumed => match phase {
                DeferredStop(was_online) => {
                    phase = if was_online { OnlinePlace } else { OpeningPlace }
                    let _ = channel.try_send(to, StopRequested)
                },
                DrainingPlace(_) => (),
                ExpiredPlace(_) => (),
                _ => publish_phase(status, watch, mut current, Ready)?,
            },
            RetirePlace => {
                finishing = match finishing { FinishSent => FinishingRetired, FinishingRetired => FinishingRetired, _ => RetiringPlace }
                idle_state = IdleWaiting
                if let Error(_) = channel.send(serve_to, ServeRetire) { serve_done = Some(0u64) }
            },
            HeadEnded(take ending) => {
                if let Some(take handle) = replace(mut heading, None) { let _ = task.join(take handle) }
                match take ending {
                    Ok(due) => { next_due = due },
                    Error(take problem) => {
                        if place_online(phase) {
                            // A failed head cannot settle calls or participate in a drain.
                            if let Some(take handle) = replace(mut serving, None) { let _ = task.cancel_join(take handle) }
                            return Error(take problem)
                        }
                        if let Some(host) = hosting {
                            let response = match problem {
                                Open(NotCurrent(Active(version, _, read))) => {
                                    PlaceCurrent(version, clone(read))
                                },
                                Open(NotCurrent(Legacy)) => PlaceRefused("Legacy"),
                                Open(NotCurrent(Empty)) => PlaceRefused("Empty"),
                                Full(_) => PlaceRefused("Full"),
                                Open(Store(Full(_))) => PlaceRefused("Full"),
                                Open(Store(Missing(name))) => {
                                    PlaceRefused(clone(name))
                                },
                                Open(Store(Schema(_))) => PlaceRefused("Schema"),
                                Open(Store(Decode(_))) => PlaceRefused("Decode"),
                                Open(Store(Corrupt(_))) => PlaceRefused("Corrupt"),
                                Open(Store(Held)) => PlaceRefused("Held"),
                                Open(Store(Poisoned(_))) => PlaceRefused("Poisoned"),
                                Open(Store(Io(_))) => PlaceRefused("Io"),
                                Open(Place(_)) => PlaceRefused("Place"),
                                Open(IdentityUnknown) => PlaceRefused("Identity"),
                                Open(StoreMismatch((ehi, elo), (ahi, alo))) => PlaceStoreMismatch(ehi, elo, ahi, alo),
                                Open(PublisherStopped) => PlaceRefused("PublisherStopped"),
                                _ => PlaceRefused("Open"),
                            }
                            let _ = channel.send(host.answer, take response)
                            if let Ok(()) = channel.receive(host.sent) {}
                        }
                        if !place_stopping(phase) {
                            if let None = start_failure { start_failure = Some(take problem) }
                        }
                    },
                }
            },
            ServeEnded(take ending) => {
                if let Some(take handle) = replace(mut serving, None) { let _ = task.join(take handle) }
                match take ending {
                    Ok(count) => { serve_done = Some(count) },
                    Error(take problem) => if place_online(phase) { return Error(take problem) } else {
                        start_failure = Some(take problem)
                        let _ = channel.try_send(head_to, HeadClose)
                    },
                }
            },
        }
    }
}

// Installation shares the serving head's open and activation, then closes the store
// before it sends proof. No publisher, triggers, or listener start for this launch.
fn operate_install[G: send, H: send, S: send, B: send](take p: PlaceConfig[G, H, S, B], take options: store.Options, selection: Selection, n_place: u64) -> Result[u64, StartError] waits {
    let PlaceConfig(backing: take backing, tasks: tasks, clock: clock, random: random, place: place, migrate: migrate, handles: handles, ..) = take p
    let persistent = match backing { Disk(_) => true, _ => false }
    if let InstallAt(_) = selection {
        if !persistent { return Error(Missing("disk store")) }
    }
    let (take db, take temporary) = open_backing(take backing, options, tasks, clock, random)?
    let mut opened = take db
    let installed: Result[u64, StartError] = match head_prepare(mut opened, selection, persistent, place, migrate, handles, n_place, tasks) {
        Ok(_) => if persistent {
            match activation_version(opened) { Ok(version) => Ok(version), Error(take problem) => Error(Open(InstallUncertain(take problem))) }
        } else { Ok(0u64) },
        Error(take problem) => {
            let _ = close_store(take opened)
            return Error(Open(take problem))
        },
    }
    store.close(take opened) ?=> |problem| Open(InstallUncertain(problem))
    let _ = take temporary
    take installed
}

fn finish_install(take result: Result[u64, StartError]) -> Result[Ended, StartError] {
    // A failed durability barrier or close can leave the activation on disk.
    // Let a recovery open decide it if we reached the cut without proof.
    let reply: Option[HostReply] = match result {
        Error(Open(InstallUncertain(_))) => None,
        Ok(version) => Some(PlaceInstalled(version, false)),
        Error(problem) => Some(PlaceInstallRefused(match problem {
            Open(Store(Held)) => InstallHeld,
            Open(Store(Full(_))) => InstallCapacity,
            Full(_) => InstallCapacity,
            Open(Store(_)) => InstallStore,
            Open(Place(_)) => InstallPlace,
            Open(Migrate(_)) => InstallMigration,
            Open(NotCurrent(_)) => InstallCurrent,
            Open(IdentityUnknown) => InstallIdentity,
            Open(InstallVersion(next)) => InstallWrongVersion(next),
            _ => InstallConfig,
        })),
    }
    if let Some(take value) = take reply {
        let codec: std.codec.Codec[HostReply] = std.codec.of()
        let mut answer: Bytes = list.with_capacity(16u64)
        let _ = std.codec.encode(codec, value, mut answer) ?=> |_| Missing("install answer")
        if !launch_emit(answer) { return Error(Missing("install answer")) }
    }
    match take result { Ok(_) => Ok(Unstarted), Error(take problem) => Error(take problem) }
}

pub fn prepare_place[G: send, H: send, S: send, B: send](take p: PlaceConfig[G, H, S, B], take attempt: Bytes, take image: Bytes, errors: Stderr) -> Result[Ended, StartError] waits {
    let (take options, _, _) = place_store(p, Some(errors))?
    let n_place = p.n_place
    prepare_placed(take p, take options, n_place, take attempt, take image)
}

fn operate_prepare[G: send, H: send, S: send, B: send](take p: PlaceConfig[G, H, S, B], take options: store.Options, n_place: u64, attempt: LaunchBytes, image: LaunchBytes) -> Result[Ended, StartError] waits {
    prepare_placed(take p, take options, n_place, launch_bytes(attempt), launch_bytes(image))
}

fn prepare_placed[G: send, H: send, S: send, B: send](take p: PlaceConfig[G, H, S, B], take options: store.Options, n_place: u64, take attempt: Bytes, take image: Bytes) -> Result[Ended, StartError] waits {
    let PlaceConfig(backing: take backing, place: place, migrate: migrate, handles: handles, clock: clock, tasks: tasks, triggers: take config, ..) = take p
    let Disk(scratch) = backing else { return Error(Missing("scratch")) }
    let entries = match take config {
        Some(TriggerConfig(entries: take listed, ..)) => take listed,
        None => triggers.empty_entries(),
    }
    let setup = PrepareConfig(scratch: scratch, options: take options, attempt: take attempt, image_digest: take image,
        clock: clock, tasks: tasks, n_place: n_place, place: place, migrate: migrate, handles: handles, triggers: take entries)
    match prepare_deploy(setup) {
        Ok(()) => Ok(Unstarted),
        Error(Open(take problem)) => Error(Open(take problem)),
        Error(Identity) => Error(Open(IdentityUnknown)),
        Error(Deploy(Store(take problem))) => Error(Open(Store(take problem))),
        Error(Deploy(Scratch(Limit(Triggers)))) => Error(Open(Store(Limit(Triggers)))),
        Error(Deploy(_)) => Error(Missing("prepared")),
    }
}

// One erased adapter per kind, holding the entry's byte bound n from registration
// (RUNNER-SPEC v2.4 §1.1). A compute slot runs in the caller's task; a granted slot
// starts a task under `bytes n` that holds the grant. A transact slot has two: the
// session's check (rule 5: decode the argument, keep nothing) and the head's run, with the
// entry's step bound and its code.revision, which each call record carries (R5, §7).
type Slot[G: send, H: send]: send = Compute(own[send] fn(Bytes) -> Outcome) | Granted(own[send] fn() -> GrantedLaunch[G]) | Transact(u64, u64, Option[Bytes], own[send] fn(Bytes) -> Option[Refusal], own[send] fn(mut store.Tx, H, Caller, Bytes) -> Ran) | Query(u64, u64, own[send] fn(store.Snapshot, H, Caller, Bytes, store.Snapshot, Option[View[Cover]], u32, Log[Row]) -> Queried) | Fenced(u64, u64, own[send] fn(mut store.Tx, triggers.Attempt, Bytes) -> Result[Bytes, store.Error])

// One granted call's launcher, made from its slot where the Registry is and called by the
// task that holds the grant (§3 "One Registry").
type GrantedLaunch[G: send]: send { go: own[send] fn(Tasks, take JobGrant[G], take Caller, take Bytes, take Option[JobReport]) -> Result[Task[Outcome], Capacity] }

pub opaque type Registry[G: send, H: send]: send {
    slots: Map[Bytes, Slot[G, H]],
    exported: List[Exported],
    checks: Map[Bytes, own[send] fn(Bytes) -> Option[Refusal]],
    gone: Map[Bytes, ()]
}

pub fn registry[G: send, H: send]() -> Registry[G, H] {
    Registry(slots: map.new(), exported: list.new(), checks: map.new(), gone: map.new())
}

fn check_call_reserve(n_e: u64, s_e: u64) -> Result[(), RegisterError] {
    let plan = store.Plan(n_e: n_e, s_e: s_e, reply_max: MAX_RETURNED_BYTES + 8u64)
    match store.call_reserves(plan) { Some(_) => Ok(()), None => Error(Bounds) }
}

fn room(c: Capacity) -> Room {
    Room(requested: c.requested, available: c.available)
}

fn store_capacity(cause: store.StoreCapacity) -> Capacity {
    match cause {
        Journal(c) => c,
        Resident(c) => c,
        Allocation(c) => c,
    }
}

// RUNNER-SPEC §1.1's fixed Bad.kind table.
fn bad(e: std.codec.DecodeError) -> Bad {
    match e {
        Truncated(at) => Bad(kind: 0u32, at: at),
        Invalid(at) => Bad(kind: 1u32, at: at),
        Utf8(at) => Bad(kind: 2u32, at: at),
        Duplicate(at) => Bad(kind: 3u32, at: at),
        Trailing(at) => Bad(kind: 4u32, at: at),
        Schema(at) => Bad(kind: 5u32, at: at),
        Value(at) => Bad(kind: 6u32, at: at),
    }
}

// RUNNER-SPEC v2.10 §1.1: fixed wire kinds, independent of core ordinals.
fn raised(cs: Causes) -> u32 {
    for c in cs {
        return match c.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity(_) => 7u32,
            OutOfTime => 8u32,
        }
    }
    0u32
}

type DecodeFail { e: std.codec.DecodeError }

fn encoded[R](cr: std.codec.Codec[R], r: R) -> Outcome {
    let mut out: Bytes = list.new()
    match std.codec.encode(cr, r, mut out) {
        Ok(()) => limited_reply(take out),
        Error(_) => fail("runner: unrepresentable reply count"),
    }
}

// The compute adapter: decode A, call f and encode R, all inside `bound bytes n` and
// `isolate`. A budget the place cannot grant is Refused(Budget); exhaustion after entry
// is Failed(OutOfBytes); a fault is Failed(Raised).
fn adapt_compute[A, R](f: StaticFn[fn(take A) -> Result[R, Capacity]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], arg: Bytes, n: u64, s: u64) -> Outcome {
    let body = code.callable(f)
    let ran = bound bytes n {
        let run = scoped fn() -> Result[Result[Outcome, DecodeFail], OutOfTime] {
            bound steps s {
            match std.codec.decode(ca, arg) {
                Ok(take a) => match body(take a) {
                    Ok(take r) => Ok(encoded(cr, r)),
                    Error(c) => Ok(Failed(OutOfBytes(room(c)))),
                },
                Error(e) => Error(DecodeFail(e: e)),
            }
            }
        }
        isolate(run)
    }
    match take ran {
        Ok(Ok(Ok(Ok(Ok(take o))))) => take o,
        Ok(Ok(Ok(Ok(Error(d))))) => Refused(Malformed(bad(d.e))),
        Ok(Ok(Ok(Error(e)))) => Failed(OutOfTime(e.steps)),
        Ok(Ok(Error(cs))) => {
            for cause in cs {
                if let Capacity(c) = cause.kind { return Failed(OutOfBytes(room(c))) }
                break
            }
            Failed(Raised(raised(cs)))
        },
        Ok(Error(c)) => Failed(OutOfBytes(room(c))),
        Error(c) => Refused(Budget(room(c))),
    }
}

type JobGrant[G: send]: send = Direct(G) | FromPlace(Sender[GrantRequest[G]], TriggerContext)

type Job[G: send, A, R]: send {
    f: StaticFn[fn(G, Caller, take A) -> Result[R, Capacity] waits],
    ca: std.codec.Codec[A],
    cr: std.codec.Codec[R],
    grant: JobGrant[G],
    caller: Caller,
    arg: Bytes,
    steps: u64
}

// The granted adapter, the body of the task `start` spawns under `bytes n`.
fn adapt_granted[G: send, A, R](take j: Job[G, A, R]) -> Outcome waits {
    let allowance = j.steps
    let ran = bound steps allowance {
        let Job(f: f, ca: ca, cr: cr, grant: take source, caller: take caller, arg: take arg, steps: _) = take j
        let grants = match take source {
            Direct(take value) => take value,
            FromPlace(to, take ctx) => match attempt_grants(to, take ctx) {
                Ok(take value) => take value,
                Error(take outcome) => return take outcome,
            },
        }
        let body = code.callable(f)
        match std.codec.decode(ca, arg) {
            Ok(take a) => match body(grants, caller, take a) {
                Ok(take r) => encoded(cr, r),
                Error(c) => Failed(OutOfBytes(room(c))),
            },
            Error(e) => Refused(Malformed(bad(e))),
        }
    }
    match take ran { Ok(take o) => take o, Error(e) => Failed(OutOfTime(e.steps)) }
}

// Key = identity ++ fingerprint(A) ++ fingerprint(result), each fingerprint u64 little-endian.
// Calls describe their Returned payload. Queries describe the ordered key and current value.
fn described[A, R](identity: View[Bytes], revision: Option[View[Bytes]], kind: Kind, ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Result[(Bytes, Exported), std.codec.EncodeError] {
    described_result(identity, revision, kind, ca, std.codec.schema(cr)?)
}

fn described_result[A](identity: View[Bytes], revision: Option[View[Bytes]], kind: Kind, ca: std.codec.Codec[A], take result: Bytes) -> Result[(Bytes, Exported), std.codec.EncodeError] {
    let args = std.codec.schema(ca)?
    let args_fp = std.codec.fingerprint_of(args)
    let result_fp = std.codec.fingerprint_of(result)
    let key = entry_key(identity, args_fp, result_fp)
    let mut id: Bytes = list.with_capacity(list.len(identity))
    list.append(mut id, identity)
    let mut rev: Bytes = list.new()
    if let Some(digest) = revision { list.append(mut rev, digest) }
    let d = Described(kind: kind, identity: take id, args: take args, result: take result)
    Ok((take key, Exported(described: take d, args_fp: args_fp, result_fp: result_fp, revision: take rev)))
}

// The one insertion: a key already present is refused and the registry is unchanged.
fn insert[G: send, H: send](mut r: Registry[G, H], take key: Bytes, take d: Exported, take s: Slot[G, H]) -> Result[(), RegisterError] {
    if map.contains(r.slots, key) {
        return Error(AlreadyRegistered(take key))
    }
    list.reserve(mut r.exported, 1u64)
    map.insert(mut r.slots, take key, take s)
    list.push(mut r.exported, take d)
    Ok(())
}

pub fn compute[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(take A) -> Result[R, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Compute, ca, cr) {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(arg: Bytes) -> Outcome { adapt_compute(f, ca, cr, arg, n, s) }
    insert(mut r, take key, take d, Compute(made))
}

pub fn granted[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(G, Caller, take A) -> Result[R, Capacity] waits], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Granted, ca, cr) {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn() -> GrantedLaunch[G] { GrantedLaunch(go: fn(tasks: Tasks, take g: JobGrant[G], take caller: Caller, take arg: Bytes, take notice: Option[JobReport]) -> Result[Task[Outcome], Capacity] {
        let j = Job(f: f, ca: ca, cr: cr, grant: take g, caller: take caller, arg: take arg, steps: s)
        if let Some(take report) = take notice {
            let watched = WatchedJob(job: take j, report: take report, tasks: tasks, allowance: n)
            return Ok(task.spawn(tasks, bytes int.saturating_add(n, 4096u64), take watched, watch_granted))
        }
        Ok(task.spawn(tasks, bytes n, take j, adapt_granted))
    }) }
    insert(mut r, take key, take d, Granted(made))
}

// The export list in registration order: the codec of List[Described].
pub fn describe[G: send, H: send](r: Registry[G, H], mut out: Bytes) -> Result[(), std.codec.EncodeError] {
    let c: std.codec.Codec[Described] = std.codec.of()
    let count = list.len(r.exported)
    if count > 0xffffffffu64 { return Error(CountOverflow(count)) }
    std.codec.put_u32(int.truncate(count), mut out)
    for entry in r.exported { std.codec.put_with(entry.described, c, mut out)? }
    Ok(())
}

pub type Exported: codec + send { described: Described, args_fp: u64, result_fp: u64, revision: Bytes }

pub fn release_digest(exported: List[Exported]) -> Result[Bytes, std.codec.EncodeError] {
    let codec: std.codec.Codec[List[Exported]] = std.codec.of_list()
    let mut payload: Bytes = list.new()
    std.codec.encode(codec, exported, mut payload)?
    let mut hash = std.sha256.start()
    let domain = string.as_bytes("hirsel.release.v1")
    std.sha256.add_byte(mut hash, int.truncate(list.len(domain)))
    std.sha256.add(mut hash, domain, 0u64, list.len(domain))
    std.sha256.add(mut hash, payload, 0u64, list.len(payload))
    let digest = std.sha256.finish(hash)
    let mut out: Bytes = list.with_capacity(32u64)
    for index in 0u64 .. 32u64 {
        list.push(mut out, digest[index])
    }
    Ok(take out)
}

pub type Describe: codec + send { digest: Bytes, target: String, n_place: u64, revision: Bytes, exported: List[Exported] }

pub type Preview: codec + send { describe: Describe, release: Bytes, answers: List[Entry] }

pub type ReleaseManifest: codec + send {
    describe: Describe,
    release: Bytes,
    grants: List[String],
    root_limit: u64,
    recipe: Bytes
}

fn preview_old_entries(old: LaunchBytes) -> Result[List[Exported], RegisterError] {
    let payload = launch_bytes(old)
    let codec: std.codec.Codec[List[Exported]] = std.codec.of_list()
    match std.codec.decode(codec, payload) {
        Ok(take entries) => Ok(take entries),
        Error(_) => Error(Bounds),
    }
}

fn preview_answers[G: send, H: send](r: Registry[G, H], previous: LaunchBytes) -> Result[List[Entry], RegisterError] {
    let old = preview_old_entries(previous)?
    let mut answers: List[Entry] = list.with_capacity(list.len(old))
    for i in 0u64 .. list.len(old) {
        let row = view old[i]
        let key = entry_key(view row.described.identity, row.args_fp, row.result_fp)
        list.push(mut answers, answer_want(r, key, int.narrow(i)))
    }
    Ok(take answers)
}

fn encode_preview(take description: Describe, take answers: List[Entry]) -> Result[Bytes, RegisterError] {
    let release = release_digest(description.exported) ?=> |_| Bounds
    let preview = Preview(describe: take description, release: take release, answers: take answers)
    let codec: std.codec.Codec[Preview] = std.codec.of()
    let mut out: Bytes = list.new()
    match std.codec.encode(codec, preview, mut out) {
        Ok(()) => Ok(take out),
        Error(_) => Error(Bounds),
    }
}

pub type DescribeError: codec + send = PlaceCapacity(Room) | AlreadyRegistered(Bytes) | Bounds

fn launch_emit(data: Bytes) -> bool { false }

fn encode_describe(description: Describe) -> Result[Bytes, std.codec.EncodeError] {
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let mut out: Bytes = list.new()
    std.codec.encode(codec, description, mut out)?
    Ok(take out)
}

fn describe_registered[G: send, H: send](launch: LaunchEnv, take r: Registry[G, H]) -> Result[Bytes, RegisterError] {
    let preview = match launch.preview { Some(old) => Some(preview_answers(r, old)?), None => None }
    let Registry(exported: take exported, ..) = take r
    let description = Describe(digest: launch_bytes(launch.digest), target: owned_launch_target(launch.target), n_place: launch.n_place, revision: launch_bytes(launch.revision), exported: take exported)
    if let Some(take answers) = take preview { return encode_preview(take description, take answers) }
    Ok(encode_describe(description) ?=> |_| Bounds)
}

fn current_description(db: store.Db) -> Result[Option[Bytes], store.Error] {
    match store.system_table(db, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes()) {
        Ok(take table) => store.get(store.snapshot(db), table, 0u8),
        Error(Missing(_)) => Ok(None),
        Error(take problem) => Error(take problem),
    }
}

fn activation_window(db: store.Db) -> Result[(u64, u64), store.Error] {
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    let table = store.system_table(db, "hirsel.runner.releases", std.codec.key_u64(), codec)?
    let mut rows = store.scan(store.snapshot(db), table, Unbounded, Unbounded)?
    let mut latest: u64 = 0
    let mut previous = 0u64
    let mut live = 0u64
    let first_record = int.saturating_add(store.retained_main_after(db), 1u64)
    while let Some((version, _)) = store.next(mut rows)? {
        previous = latest
        latest = version
        if version <= first_record { live = version }
    }
    if latest == 0u64 { return Error(Missing("activation version")) }
    let recent = if previous == 0u64 { latest } else { previous }
    Ok((latest, if live == 0u64 { recent } else { std.order.min(recent, live) }))
}

pub fn activation_version(db: store.Db) -> Result[u64, store.Error] {
    let (version, _) = activation_window(db)?
    Ok(version)
}

// Keep these options in Args so they are also present during Run tape replay.
pub fn launch_selection(a: Args) -> Result[Selection, Exit] {
    let mut selected: Option[Selection] = None
    for i in 0u64 .. args.len(a) {
        let name = option.unwrap(args.get(a, i))
        let choice = if name == "--hirsel-install" {
            Install
        } else if let Some(value) = std.string.strip_prefix(name, "--hirsel-activation=") {
            let Ok(v) = (int.parse(value) : Result[u64, ParseError]) else { return Error(Exit(status: 1u8)) }
            Current(v)
        } else {
            continue
        }
        if let Some(_) = selected { return Error(Exit(status: 1u8)) }
        selected = Some(choice)
    }
    Ok(match selected { Some(choice) => choice, None => Reopen })
}

fn describe_response[G: send, H: send](launch: LaunchEnv, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]]) -> Result[Bytes, RegisterError] {
    let run = code.callable(place)
    // The isolate's cause cell belongs to the parent, outside n_place.
    let ran = isolate(scoped fn() -> Result[Result[Bytes, RegisterError], Capacity] {
        bound bytes launch.n_place {
            let mut r: Registry[G, H] = registry()
            match run(mut r) {
                Ok(()) => describe_registered(launch, take r),
                Error(take e) => Error(take e),
            }
        }
    })
    match take ran {
        Ok(Ok(Ok(take answer))) => take answer,
        Ok(Ok(Error(c))) => Error(Full(c)),
        Ok(Error(causes)) => {
            for cause in causes {
                if let Capacity(c) = cause.kind { return Error(Full(c)) }
                break
            }
            fail("runner: describe failed")
        },
        Error(c) => Error(Full(c)),
    }
}

type HostStop: send { process: Process, to: Sender[()] }

fn wait_for_host_stop(take stop: HostStop) -> () waits {
    let HostStop(process: process, to: take to) = take stop
    host.stopped(process)
    let _ = take to
}

pub type MainError: send = Usage(Exit) | Start(StartError)

fn push_hex_prefix(mut line: String, digest: Bytes) {
    let short = if list.len(digest) > 6u64 { list.slice(digest, 0u64, 6u64) } else { list.slice(digest, 0u64, list.len(digest)) }
    match status_hex(std.http.copy_bytes(short)) {
        Ok(take hex) => string.push(mut line, hex),
        Error(_) => string.push(mut line, "?"),
    }
}
fn push_store_error(mut line: String, problem: store.Error) {
    match problem {
        Held => string.push(mut line, "the store directory is held by another process (its LOCK)"),
        NotFound => string.push(mut line, "the store directory has no store"),
        Corrupt(fault) => { string.push(mut line, "the store is corrupt at "); string.push(mut line, fault.file); string.push(mut line, " offset "); string.push_u64(mut line, fault.offset) },
        Unsupported(version) => { string.push(mut line, "the store's format version "); string.push_u64(mut line, version); string.push(mut line, " is not this build's") },
        Io(_) => string.push(mut line, "an I/O error in the store directory"),
        Poisoned(_) => string.push(mut line, "an earlier write failed, so the store refuses further writes"),
        Full(Journal(cap)) => { string.push(mut line, "the journal options do not fit: "); push_capacity(mut line, cap) },
        Full(Resident(cap)) => { string.push(mut line, "the store's resident bound is full: "); push_capacity(mut line, cap) },
        Full(Allocation(cap)) => { string.push(mut line, "out of memory opening the store: "); push_capacity(mut line, cap) },
        Limit(_) => string.push(mut line, "a store limit was exceeded"),
        Schema(_) => string.push(mut line, "a table's stored schema differs from this build's handles"),
        Stale(_) => string.push(mut line, "a stale table handle"),
        Decode(_) => string.push(mut line, "a stored value does not decode with this build's codec"),
        Exists(name) => { string.push(mut line, "already exists: "); string.push(mut line, name) },
        Missing(name) => { string.push(mut line, "missing: "); string.push(mut line, name) },
        Changed(name) => { string.push(mut line, "changed index: "); string.push(mut line, name) },
        Undeclared(name) => { string.push(mut line, "undeclared table or index: "); string.push(mut line, name) },
        NoLevel(name) => { string.push(mut line, "unknown durability level "); string.push(mut line, name) },
        Behind(_) => string.push(mut line, "the follower has not applied the requested version"),
        Gone(id) => { string.push(mut line, "deleted branch "); string.push_u64(mut line, int.widen(id)) },
        Unseen(id) => { string.push(mut line, "unseen branch "); string.push_u64(mut line, int.widen(id)) },
        Diverged(_) => string.push(mut line, "the store diverged"),
        Foreign => string.push(mut line, "a handle from another store"),
        MigrationFault => string.push(mut line, "the migration faulted"),
        ExportDirectory => string.push(mut line, "an export directory, not a place store"),
        Fenced(_) => string.push(mut line, "another writer claimed the bucket store"),
        Lost => string.push(mut line, "the bucket store writer claim was lost"),
        Undecided => string.push(mut line, "the object store head write has an unknown outcome"),
        Declared(_) => string.push(mut line, "the durability level differs from the store declaration"),
        NotCurrent(version) => { string.push(mut line, "the store is at activation "); string.push_u64(mut line, version) },
        Unqualified(_) => string.push(mut line, "the object store provider did not pass conditional write qualification"),
        HistoryMissing(_, _) => string.push(mut line, "the object store history is missing an object"),
        Reclaimed(_) => string.push(mut line, "the requested object store history was reclaimed"),
        Remote(_) => string.push(mut line, "a bucket operation failed"),
        Tiered(reason) => string.push(mut line, match reason {
            Memory => "a memory store cannot use Tiered residency",
            Migrate => "a store with Tiered collections cannot migrate",
            Export => "a store with Tiered collections cannot export",
            Install => "a store with Tiered collections cannot install a release",
            Authority => "archival requires a bucket authority",
        }),
    }
}
fn push_capacity(mut line: String, cap: Capacity) {
    string.push_u64(mut line, cap.requested)
    string.push(mut line, " bytes requested, ")
    string.push_u64(mut line, cap.available)
    string.push(mut line, " available")
}

// One line naming why a place did not start and what to change (RUNNER-SPEC §12.1).
pub fn start_text(problem: StartError) -> String {
    let mut line = string.from("place: ")
    match problem {
        Missing(name) => { string.push(mut line, "missing or invalid "); string.push(mut line, name) },
        Exceeds(over) => {
            string.push(mut line, over.name)
            string.push(mut line, " is ")
            string.push_u64(mut line, over.value)
            string.push(mut line, ", above the most this place accepts, ")
            string.push_u64(mut line, over.limit)
        },
        Full(cap) => {
            string.push(mut line, "the executable's root limit cannot hold this place: ")
            push_capacity(mut line, cap)
            string.push(mut line, "; rebuild with a larger --limit (runner.operate_bytes(config) is what operate spends)")
        },
        Listen(_) => string.push(mut line, "could not listen"),
        Open(Store(e)) => { string.push(mut line, "store: "); push_store_error(mut line, e) },
        Open(Place(_)) => string.push(mut line, "place registration failed"),
        Open(Migrate(e)) => { string.push(mut line, "migration failed: "); push_store_error(mut line, e) },
        Open(NotCurrent(Empty)) => string.push(mut line, "the store is empty, but --hirsel-activation named a version; start without --hirsel-activation for genesis"),
        Open(NotCurrent(Legacy)) => string.push(mut line, "the store holds data without an activation; start it once with --hirsel-install"),
        Open(NotCurrent(Active(version, description, _))) => {
            string.push(mut line, "the store is at activation ")
            string.push_u64(mut line, version)
            let codec: std.codec.Codec[Describe] = std.codec.of()
            match std.codec.decode(codec, description) {
                Ok(take stored) => {
                    string.push(mut line, " of image ")
                    push_hex_prefix(mut line, stored.digest)
                    string.push(mut line, " with n_place ")
                    string.push_u64(mut line, stored.n_place)
                },
                Error(_) => (),
            }
            string.push(mut line, ", and this launch is image ")
            match launch_digest() {
                Ok(take digest) => push_hex_prefix(mut line, digest),
                Error(_) => string.push(mut line, "?"),
            }
            string.push(mut line, "; start the build that wrote it, or stop it and start this build once with --hirsel-install to migrate the store to it")
        },
        Open(IdentityUnknown) => string.push(mut line, "release identity is unavailable"),
        Open(StoreMismatch(expected, actual)) => string.push(mut line, store_mismatch(expected, actual)),
        Open(PublisherStopped) => string.push(mut line, "publisher stopped"),
        Open(InstallUncertain(e)) => { string.push(mut line, "install outcome unknown: "); push_store_error(mut line, e) },
        Open(InstallVersion(next)) => {
            string.push(mut line, "the next install activation is ")
            string.push_u64(mut line, next)
        },
    }
    take line
}

pub fn main[G: send, H: send](_a: Args, process: Process, errors: Stderr, tasks: Tasks, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn(take Receiver[()]) -> Result[Ended, MainError] waits) -> Result[(), Exit] waits {
    let launch = launch_env()
    let serving = scoped fn() -> Result[(), Exit] waits {
        let full = Exit(status: 1u8)
        let (to, from): (Sender[()], Receiver[()]) = channel.new(1u64)
        let seed = HostStop(process: process, to: take to)
        let mut waiting = task.spawn(tasks, bytes 4096u64, take seed, wait_for_host_stop)
        let ended = start_server(take from)
        task.cancel(mut waiting)
        let _ = task.join(take waiting)
        match take ended {
            Ok(Stopped(due)) => {
                if launch.wake {
                    let codec: std.codec.Codec[Option[u64]] = std.codec.of()
                    let mut report: Bytes = list.with_capacity(12u64)
                    if let Error(_) = std.codec.encode(codec, due, mut report) { return Error(full) }
                    if !launch_emit(report) { return Error(full) }
                }
                Ok(())
            },
            Ok(Unstarted) => Ok(()),
            Ok(Forced(count)) => {
                let mut line = string.from("place: forced at the drain deadline, ")
                string.push_u64(mut line, count)
                string.push(mut line, " sends abandoned\n")
                let _ = stderr.write(errors, line)
                Error(full)
            },
            Error(Start(problem)) => {
                let mut line = start_text(problem)
                string.push(mut line, "\n")
                let _ = stderr.write(errors, line)
                Error(full)
            },
            Error(Usage(exit)) => Error(exit),
        }
    }
    launch_with(launch, place, serving)
}

// The first branch precedes the caller's ordinary serve callback, including its
// store open, listener and every capability use. No n_place runtime argument.
pub fn launch_server[G: send, H: send](_a: Args, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn() -> Result[(), Exit] waits) -> Result[(), Exit] waits {
    launch_with(launch_env(), place, start_server)
}

fn launch_with[G: send, H: send](launch: LaunchEnv, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn() -> Result[(), Exit] waits) -> Result[(), Exit] waits {
    if !launch.describe {
        return start_server()
    }
    match describe_response(launch, place) {
        Ok(take payload) => if launch_emit(payload) { Ok(()) } else { Error(Exit(status: 1u8)) },
        Error(take e) => {
            let error: DescribeError = match take e {
                Full(c) => PlaceCapacity(room(c)),
                AlreadyRegistered(take key) => AlreadyRegistered(take key),
                Bounds => Bounds,
            }
            let codec: std.codec.Codec[DescribeError] = std.codec.of()
            let mut out: Bytes = list.new()
            match std.codec.encode(codec, error, mut out) {
                Ok(()) => { let _ = launch_emit(out) },
                Error(_) => (),
            }
            Error(Exit(status: 2u8))
        },
    }
}

// A compute call in the caller's task, under the entry's n. A key that names no compute
// entry is NoEntry.
pub fn call[G: send, H: send](r: Registry[G, H], key: Bytes, arg: Bytes) -> Outcome {
    match map.get(r.slots, key) {
        Some(Compute(run)) => run(arg),
        _ => Refused(NoEntry),
    }
}

// A granted call: a task under the entry's `bytes n` holding g. A key that names no
// granted entry is NoEntry; a task the place cannot grant is Budget.
pub fn start[G: send, H: send](r: Registry[G, H], tasks: Tasks, take g: G, take caller: Caller, key: Bytes, take arg: Bytes) -> Result[Task[Outcome], Refusal] {
    match map.get(r.slots, key) {
        Some(Granted(bind)) => match (bind().go)(tasks, Direct(take g), take caller, take arg, None) {
            Ok(take t) => Ok(take t),
            Error(c) => Error(Budget(room(c))),
        },
        _ => Error(NoEntry),
    }
}

pub fn finish(take t: Task[Outcome]) -> Outcome waits {
    match task.join(take t) {
        Ok(take o) => take o,
        Error(Failed(cs)) => Failed(Raised(raised(cs))),
        Error(Cancelled(cs)) => Failed(Raised(raised(cs))),
    }
}

// ---- R1 (RUNNER-SPEC v2.4 §2, §3): transact, the head, sessions and the publisher.

// Rule 10: the head, the publisher and the serving task each run the place's one `place`
// function under `bytes n_place`, so their lists are the same list; the serving task's
// Registry is built once and every session plans against it.
fn placed[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64) -> Result[Registry[G, H], RegisterError] {
    let go = code.callable(place)
    let built: Result[Result[Registry[G, H], RegisterError], Capacity] = bound bytes n_place {
        let mut r: Registry[G, H] = registry()
        match go(mut r) {
            Ok(()) => Ok(take r),
            Error(take e) => Error(take e),
        }
    }
    match take built {
        Ok(take x) => take x,
        Error(c) => Error(Full(c)),
    }
}

// A transact run, for the head: an effect to commit with its reply, a typed error whose
// reply is kept alone, a fault after entry, or a refusal that records nothing.
type Ran: send = Commit(Bytes) | Abort(Bytes) | Exhausted(Capacity) | Refuse(Refusal)

// The session's check (rule 5): the argument decodes under n, and the value is dropped.
// Running out of n is not a refusal; the head's run answers it with Failed(OutOfBytes).
fn check_arg[A](ca: std.codec.Codec[A], arg: Bytes, n: u64) -> Option[Refusal] {
    let seen = bound bytes n {
        match std.codec.decode(ca, arg) {
            Error(e) => {
                let why: Refusal = Malformed(bad(e))
                Some(take why)
            },
            _ => None,
        }
    }
    match take seen {
        Ok(take o) => take o,
        Error(c) => Some(Budget(room(c))),
    }
}

// The store's entry bound covers decoding, execution and reply encoding.
fn adapt_transact[H: send, A, R, E](f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], ce: std.codec.Codec[E], mut tx: store.Tx, h: H, author: Caller, arg: Bytes) -> Ran {
    let body = code.callable(f)
    match std.codec.decode(ca, arg) {
        Ok(take a) => {
            let res = body(mut tx, h, author, take a)
            let kept = match res { Ok(_) => true, Error(_) => false }
            let mut out: Bytes = list.new()
            match std.codec.put_result(res, cr, ce, mut out) {
                Ok(()) => {
                    let length = list.len(out)
                    if length > MAX_RETURNED_BYTES {
                        Exhausted(Capacity(requested: length, available: MAX_RETURNED_BYTES))
                    } else if kept { Commit(take out) } else { Abort(take out) }
                },
                Error(_) => fail("runner: unrepresentable reply count"),
            }
        },
        Error(e) => Refuse(Malformed(bad(e))),
    }
}

pub fn transact[G: send, H: send, A: codec, R: codec, E: codec](mut r: Registry[G, H], f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], n: u64, s: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, s)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let ce: std.codec.Codec[E] = std.codec.of()
    let carried: std.codec.Codec[Result[R, E]] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Transact, ca, carried) {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    let revision: Option[Bytes] = if list.len(d.revision) == 0u64 {
        None
    } else {
        let copied: Bytes = clone(d.revision)
        Some(take copied)
    }
    register_check(mut r, key, ca, n, s)?
    let check = fn(arg: Bytes) -> Option[Refusal] { check_arg(ca, arg, n) }
    let run = fn(mut tx: store.Tx, h: H, author: Caller, arg: Bytes) -> Ran { adapt_transact(f, ca, cr, ce, mut tx, h, author, arg) }
    insert(mut r, take key, take d, Transact(n, s, take revision, check, run))
}

pub fn attempt_key[F, A, R](definition: StaticFn[F], arg: std.codec.Codec[A], reply: std.codec.Codec[R]) -> Result[Bytes, std.codec.EncodeError] {
    let identity = code.identity(definition)
    Ok(entry_key(identity, std.codec.fingerprint(arg)?, std.codec.fingerprint(reply)?))
}

// An attempt entry has no wire slot or call record. Only the head can attach
// the checked attempt, and the application must register the entry at open.
pub fn register_attempt[G: send, H: send, F, A: codec, R: codec](mut registered: Registry[G, H], definition: StaticFn[F],
    take run: own[send] fn(mut store.Tx, triggers.Attempt, take A) -> Result[R, store.Error], n: u64, steps: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, steps)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let key = attempt_key(definition, ca, cr) ?=> |_| Bounds
    if map.contains(registered.slots, key) { return Error(AlreadyRegistered(take key)) }
    let made = fn(mut tx: store.Tx, attempt: triggers.Attempt, arg: Bytes) -> Result[Bytes, store.Error] {
        let value = match std.codec.decode(ca, arg) {
            Ok(take decoded) => take decoded,
            Error(_) => return Error(Missing("attempt argument")),
        }
        let answer = run(mut tx, attempt, take value)?
        let mut raw: Bytes = list.new()
        std.codec.encode(cr, answer, mut raw) ?=> |_| Limit(Value)
        Ok(take raw)
    }
    let adapter = take made
    map.insert(mut registered.slots, take key, Fenced(n, steps, take adapter))
    Ok(())
}

// ---- R2 (RUNNER-SPEC v2.11 §4): queries and their Covers.

// A Cover names one data-tree key range [low, high) of one table (I1), without reading it. It
// keeps that table's published value, erased once here (v2.11.1, STORE-SPEC AG3), so the
// publisher normalizes a Cover's initial rows and its changed rows alike (F10).
pub opaque type Cover: send {
    low: Bytes,
    high: Bytes,
    schemas: Arc[store.RowSchemas],
    value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error]
}

pub fn cover[K, V](t: store.Table[K, V], lo: store.Bound[K], hi: store.Bound[K]) -> Result[Cover, Capacity] {
    let (take low, take high) = match store.key_span(t, lo, hi) {
        Ok(Span(take l, take h)) => (take l, take h),
        Error(Full(c)) => return Error(store_capacity(c)),
        _ => fail("runner: a Cover's bounds do not encode"),
    }
    let mine: store.Table[K, V] = clone(t)
    let made = fn(c: store.Change) -> Result[Option[Bytes], store.Error] { store.published_value(mine, c) }
    Ok(Cover(low: take low, high: take high, schemas: store.row_schemas(t), value: made))
}

// What a query run at a Snapshot gives the publisher: its Cover and read set, an Outcome
// that ends the subscription (with the reads the run made before it stopped, when it got
// that far), or a store error, which is a Reset.
type Viewed { cover: Cover, reads: List[store.Read] }

type Queried = Covered(Viewed) | Stopped(Outcome) | Faulted(Outcome, List[store.Read]) | Lost(store.Error)

// A query body of either registration kind (rule 2). A `Plain` body never receives the
// Caller, so its result is a function of the snapshot and the argument alone; an `As` body
// receives the Caller of the session whose subscription it runs for, at every run.
type QueryBody[H, A] = Plain(StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]]) | As(StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Cover, Capacity]])

fn query_body[H, A](body: QueryBody[H, A], tx: store.Tx, h: H, caller: Caller, take a: A) -> Result[Cover, Capacity] {
    match body {
        Plain(f) => code.callable(f)(tx, h, take a),
        As(f) => code.callable(f)(tx, h, caller, take a),
    }
}

// The query adapter: decode A and call the body inside `look`, all inside `bound bytes n`. A
// fault, or exhaustion after entry, ends the subscription with Failed. The run is isolated
// inside `look`'s body, so `look` returns the reads it made before it stopped: that partial
// read log is the ended entry (§3 "Ended entries"). `caller` is the subscribing session's.
fn adapt_query[H: send, A](body: QueryBody[H, A], ca: std.codec.Codec[A], schemas: store.RowSchemas, s: store.Snapshot, h: H, caller: Caller, arg: Bytes, n: u64, steps: u64, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
    let looked = bound bytes n {
        store.look(s, None, scoped fn(tx: store.Tx) -> Result[Cover, Queried] {
          let ran = isolate(fn() -> Result[Result[Cover, Queried], OutOfTime] {
           bound steps steps {
            let c = match std.codec.decode(ca, arg) {
                Ok(take a) => match query_body(body, tx, h, caller, take a) {
                    Ok(take value) => take value,
                    Error(c) => return Ok(Error(Stopped(Failed(OutOfBytes(room(c)))))),
                },
                Error(e) => return Ok(Error(Stopped(Refused(Malformed(bad(e)))))),
            }
            if c.schemas.key != schemas.key || c.schemas.value != schemas.value {
                fail("runner: query Cover schema does not match registration")
            }
            let projected = match old {
                Some(previous) => rerun_rows(prior, previous, s, c, sub, rows),
                None => cover_rows(s, c, sub, rows),
            }
            match take projected {
                Ok(()) => Ok(take c),
                Error(take e) => Error(projection_error(take e)),
            }
           }
          })
          match take ran {
              Ok(Ok(Ok(take v))) => take v,
              Ok(Ok(Error(e))) => Error(Stopped(Failed(OutOfTime(e.steps)))),
              Ok(Error(cs)) => Error(Stopped(Failed(Raised(raised(cs))))),
              Error(c) => Error(Stopped(Failed(OutOfBytes(room(c))))),
          }
        })
    }
    match take looked {
        Ok(Ok(Seen(take x))) => {
            let store.Seen(value: take v, version: _, reads: take reads) = take x
            match take v {
                Ok(take c) => Covered(Viewed(cover: take c, reads: take reads)),
                Error(Stopped(take why)) => Faulted(take why, take reads),
                Error(take other) => take other,
            }
        },
        Ok(Ok(Failed(cs))) => Stopped(Failed(Raised(raised(cs)))),
        Ok(Ok(Refused(c))) => Stopped(Failed(OutOfBytes(room(store_capacity(c))))),
        Ok(Ok(Stopped(e))) => Stopped(Failed(OutOfTime(e.steps))),
        Ok(Error(e)) => Lost(e),
        Error(c) => Stopped(Refused(Budget(room(c)))),
    }
}

// Rule 2's two query kinds. `query` registers a caller-independent body, which has no Caller
// parameter; `query_as` registers a caller-dependent one, which takes the Caller. The kind is
// the body's type, so a body that reads the Caller cannot be registered with `query`.
pub fn query[G: send, H: send, A: codec, K, V](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]], ck: std.codec.Key[K], cv: std.codec.Codec[V], n: u64, s: u64) -> Result[(), RegisterError] {
    register_query(mut r, Plain(f), ck, cv, n, s)
}

pub fn query_as[G: send, H: send, A: codec, K, V](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Cover, Capacity]], ck: std.codec.Key[K], cv: std.codec.Codec[V], n: u64, s: u64) -> Result[(), RegisterError] {
    register_query(mut r, As(f), ck, cv, n, s)
}

fn query_codecs[K, V](ck: std.codec.Key[K], cv: std.codec.Codec[V]) -> Result[store.RowSchemas, std.codec.EncodeError] {
    Ok(store.RowSchemas(key: std.codec.key_schema(ck)?, value: std.codec.schema(cv)?))
}

fn encode_query_schemas(schemas: store.RowSchemas) -> Result[Bytes, std.codec.EncodeError] {
    let c: std.codec.Codec[store.RowSchemas] = std.codec.of()
    let mut out: Bytes = list.new()
    std.codec.encode(c, schemas, mut out)?
    Ok(take out)
}

// The bytes hashed into a query's result fingerprint and sent in Describe.
pub fn query_result_schema[K, V](ck: std.codec.Key[K], cv: std.codec.Codec[V]) -> Result[Bytes, std.codec.EncodeError] {
    encode_query_schemas(query_codecs(ck, cv)?)
}

fn register_query[G: send, H: send, A: codec, K, V](mut r: Registry[G, H], body: QueryBody[H, A], ck: std.codec.Key[K], cv: std.codec.Codec[V], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let schemas = query_codecs(ck, cv) ?=> |_| Bounds
    let result = encode_query_schemas(schemas) ?=> |_| Bounds
    let described_query = match body {
        Plain(f) => described_result(code.identity(f), code.revision(f), Query, ca, take result),
        As(f) => described_result(code.identity(f), code.revision(f), Query, ca, take result),
    }
    let (take key, take d) = match take described_query {
        Ok(take kd) => take kd,
        Error(_) => return Error(Bounds),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(at: store.Snapshot, h: H, caller: Caller, arg: Bytes, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
        adapt_query(body, ca, schemas, at, h, caller, arg, n, s, prior, old, sub, rows)
    }
    insert(mut r, take key, take d, Query(n, s, made))
}

// ---- The publisher's subscriptions (G2, G3). A subscription keeps its Cover and read set at
// the base, never its rows (F4): rows are enumerated from the snapshots the publisher holds.
// Fields drop in reverse order: return the room after freeing the Caller, argument and key.
// `caller` is the subscribing session's, the one a caller-dependent query runs with at
// subscribe, at every rerun and at repair (rule 2).
pub opaque type SubscriptionInput: send { room: Option[SubscriptionLease], key: Bytes, arg: Bytes, caller: Caller }

resource type SubscriptionLease: send { refund: Sender[u64], charge: u64 } drop(lease) {
    let _ = channel.try_send(lease.refund, lease.charge)
}

// A live sub has its Cover. An ended entry (§3 "Ended entries") has none: it no longer runs,
// but its read set stays indexed, and its input stays charged to the session, until its first
// read-set hit, its owner's removal or the session's end.
// `due` (§3 "Repair"): a full owner inbox bounced content of this live sub. Its hits still
// fence, its diffs stop, and on its owner's progress one full `complete` replaces it.
type Sub { generation: u64, input: SubscriptionInput, cover: Option[Cover], routes: List[RouteKey], due: bool }

type SubId { who: u64, sub: u32, serial: u64 }

// The publisher holds one balanced interval tree for the data-tree keys of its open.
// Points have an inclusive upper endpoint and Covers and Spans have an exclusive one.
// Each node also holds the greatest upper endpoint in its subtree.
type RouteEnd { at: Arc[Bytes], included: bool }
type RouteKey { low: Arc[Bytes], serial: u64, slot: u64 }
type Route {
    key: RouteKey,
    id: SubId,
    end: RouteEnd,
    max: RouteEnd,
    height: u64,
    left: Option[Box[Route]],
    right: Option[Box[Route]]
}

type Subscriptions { by_session: Map[u64, Map[u32, Sub]], root: Option[Box[Route]], serial: u64 }

fn subscriptions() -> Subscriptions {
    Subscriptions(by_session: map.new(), root: None, serial: 0u64)
}

fn route_before(a: RouteKey, b: RouteKey) -> bool {
    let low_a: View[Bytes] = a.low
    let low_b: View[Bytes] = b.low
    if low_a != low_b { return low_a < low_b }
    if a.serial != b.serial { return a.serial < b.serial }
    a.slot < b.slot
}

fn end_reaches(end: RouteEnd, key: Bytes) -> bool {
    let high: View[Bytes] = end.at
    key < high || (end.included && key == high)
}

fn raise_end(mut end: RouteEnd, candidate: RouteEnd) {
    let high: View[Bytes] = candidate.at
    if !end_reaches(end, high) {
        end.at = arc.share(candidate.at)
        end.included = candidate.included
    }
}

fn route_height(root: Option[Box[Route]]) -> u64 {
    match root { Some(node) => node.height, None => 0u64 }
}

fn measure_route(mut node: Box[Route]) {
    let left = route_height(node.left)
    let right = route_height(node.right)
    node.height = 1u64 + if left > right { left } else { right }
    let mut far = RouteEnd(at: arc.share(node.end.at), included: node.end.included)
    if let Some(child) = node.left { raise_end(mut far, child.max) }
    if let Some(child) = node.right { raise_end(mut far, child.max) }
    node.max = take far
}

fn rotate_route_left(take node: Box[Route]) -> Box[Route] {
    let mut parent = take node
    let mut next = option.unwrap(replace(mut parent.right, None))
    parent.right = replace(mut next.left, None)
    measure_route(mut parent)
    next.left = Some(take parent)
    measure_route(mut next)
    take next
}

fn rotate_route_right(take node: Box[Route]) -> Box[Route] {
    let mut parent = take node
    let mut next = option.unwrap(replace(mut parent.left, None))
    parent.left = replace(mut next.right, None)
    measure_route(mut parent)
    next.right = Some(take parent)
    measure_route(mut next)
    take next
}

fn balance_route(take node: Box[Route]) -> Box[Route] {
    let mut root = take node
    let left = route_height(root.left)
    let right = route_height(root.right)
    if left > right + 1u64 {
        let child = option.unwrap(replace(mut root.left, None))
        root.left = Some(if route_height(child.right) > route_height(child.left) {
            rotate_route_left(take child)
        } else { take child })
        return rotate_route_right(take root)
    }
    if right > left + 1u64 {
        let child = option.unwrap(replace(mut root.right, None))
        root.right = Some(if route_height(child.left) > route_height(child.right) {
            rotate_route_right(take child)
        } else { take child })
        return rotate_route_left(take root)
    }
    measure_route(mut root)
    take root
}

fn put_route(take top: Option[Box[Route]], take node: Box[Route]) -> Box[Route] {
    let Some(take old) = take top else { return take node }
    let mut root = take old
    if route_before(node.key, root.key) {
        let child = replace(mut root.left, None)
        root.left = Some(put_route(take child, take node))
    } else {
        let child = replace(mut root.right, None)
        root.right = Some(put_route(take child, take node))
    }
    balance_route(take root)
}

fn take_first_route(take root: Box[Route], mut rest: Option[Box[Route]]) -> Box[Route] {
    let mut node = take root
    if let Some(take left) = replace(mut node.left, None) {
        let first = take_first_route(take left, mut node.left)
        rest = Some(balance_route(take node))
        take first
    } else {
        rest = replace(mut node.right, None)
        take node
    }
}

fn drop_route(take top: Option[Box[Route]], key: RouteKey) -> Option[Box[Route]] {
    let mut root = option.unwrap(take top)
    if route_before(key, root.key) {
        let child = replace(mut root.left, None)
        root.left = drop_route(take child, key)
    } else if route_before(root.key, key) {
        let child = replace(mut root.right, None)
        root.right = drop_route(take child, key)
    } else {
        let right = replace(mut root.right, None)
        let Some(take child) = take right else { return replace(mut root.left, None) }
        let mut rest: Option[Box[Route]] = None
        let mut next = take_first_route(take child, mut rest)
        next.left = replace(mut root.left, None)
        next.right = take rest
        return Some(balance_route(take next))
    }
    Some(balance_route(take root))
}

// Allocate before changing the tree. An insertion or removal only moves boxes.
fn stage_route(mut nodes: List[Box[Route]], id: SubId, slot: u64, take interval: store.Read) -> Result[(), Capacity] {
    let (take low, take end) = match take interval {
        Point(take point) => {
            let endpoint = arc.new(take point)
            (arc.share(endpoint), RouteEnd(at: take endpoint, included: true))
        },
        Span(take lo, take hi) => {
            if hi <= lo { return Ok(()) }
            let upper = arc.new(take hi)
            (arc.new(take lo), RouteEnd(at: take upper, included: false))
        },
    }
    let max = RouteEnd(at: arc.share(end.at), included: end.included)
    let node = Route(key: RouteKey(low: take low, serial: id.serial, slot: slot), id: id,
        end: take end, max: take max, height: 1u64, left: None, right: None)
    Ok(list.push(mut nodes, box.new(take node)))
}

fn cover_view(c: Option[Cover]) -> Option[View[Cover]] in c {
    match c {
        Some(x) => Some(x),
        None => None,
    }
}

// Slot 0 is the Cover's route, which an ended entry does not have; reads take slots from 1.
fn stage_routes(id: SubId, c: Option[View[Cover]], take reads: List[store.Read]) -> Result[(List[Box[Route]], List[RouteKey]), Capacity] {
    let mut nodes: List[Box[Route]] = list.with_capacity(list.len(reads) + 1u64)
    if let Some(span) = c { stage_route(mut nodes, id, 0u64, Span(clone(span.low), clone(span.high)))? }
    let mut slot = 0u64
    for take read in reads {
        slot += 1u64
        stage_route(mut nodes, id, slot, take read)?
    }
    let mut keys: List[RouteKey] = list.with_capacity(list.len(nodes))
    for node in nodes {
        let key = node.key
        list.push(mut keys, RouteKey(low: arc.share(key.low), serial: key.serial, slot: key.slot))
    }
    Ok((take nodes, take keys))
}

fn install_routes(mut root: Option[Box[Route]], take nodes: List[Box[Route]]) {
    for take node in nodes {
        let previous = replace(mut root, None)
        root = Some(put_route(take previous, take node))
    }
}

fn unregister_routes(mut root: Option[Box[Route]], keys: List[RouteKey]) {
    for key in keys {
        let previous = replace(mut root, None)
        root = drop_route(take previous, key)
    }
}

fn route_key(root: Option[Box[Route]], key: Bytes, mut hits: Map[u64, (SubId, bool)]) -> Result[(), Capacity] {
    let Some(node) = view root else { return Ok(()) }
    if !end_reaches(node.max, key) { return Ok(()) }
    route_key(node.left, key, mut hits)?
    let low: View[Bytes] = node.key.low
    if key < low { return Ok(()) }
    if end_reaches(node.end, key) {
        let read = node.key.slot != 0u64
        if read || !map.contains(hits, node.id.serial) {
            map.insert(mut hits, node.id.serial, (node.id, read))
        }
    }
    route_key(node.right, key, mut hits)
}

fn sub_at(subs: Subscriptions, who: u64, sub: u32) -> Option[View[Sub]] in subs {
    match map.get(subs.by_session, who) {
        Some(group) => map.get(group, sub),
        None => None,
    }
}

fn put_sub(mut subs: Subscriptions, id: SubId, take value: Sub) -> Result[(), Capacity] {
    if !map.contains(subs.by_session, id.who) {
        map.insert(mut subs.by_session, id.who, map.new())
    }
    let mut incoming = Some(take value)
    let inserted = option.unwrap(map.update(mut subs.by_session, id.who, scoped fn(mut group: Map[u32, Sub]) -> Result[(), Capacity] {
        let pending_sub = option.unwrap(replace(mut incoming, None))
        Ok(map.insert(mut group, id.sub, take pending_sub))
    }))
    if let Error(_) = inserted {
        if map.len(option.unwrap(map.get(subs.by_session, id.who))) == 0u64 {
            let _ = map.remove(mut subs.by_session, id.who)
        }
    }
    inserted
}

fn remove_sub(mut subs: Subscriptions, who: u64, sub: u32) -> Option[Sub] {
    let Some((take removed, empty)) = map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> (Option[Sub], bool) {
        let removed = map.remove(mut group, sub)
        (take removed, map.len(group) == 0u64)
    }) else { return None }
    if empty { let _ = map.remove(mut subs.by_session, who) }
    if let Some(s) = view removed { unregister_routes(mut subs.root, s.routes) }
    take removed
}

// The publisher ends a live sub (§3 "Ended entries"): its Cover's route leaves the index and
// its read routes stay, as an ended entry. Nothing is allocated.
fn end_entry(mut subs: Subscriptions, who: u64, sub: u32) {
    let dropped = map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> Option[RouteKey] {
        match map.update(mut group, sub, scoped fn(mut entry: Sub) -> Option[RouteKey] {
            entry.cover = None
            entry.due = false
            if list.len(entry.routes) > 0u64 && entry.routes[0].slot == 0u64 { Some(list.remove(mut entry.routes, 0u64)) } else { None }
        }) {
            Some(take key) => take key,
            None => None,
        }
    })
    if let Some(Some(take key)) = take dropped {
        let previous = replace(mut subs.root, None)
        subs.root = drop_route(take previous, key)
    }
}

// A publisher-made Reset ends every live sub of the session; each stays as an ended entry.
fn end_session(mut subs: Subscriptions, who: u64) {
    let mut live: List[u32] = list.new()
    if let Some(group) = map.get(subs.by_session, who) {
        for (sub, entry) in group {
            if let Some(_) = entry.cover { list.push(mut live, sub) }
        }
    }
    for sub in live { end_entry(mut subs, who, sub) }
}

fn ended_entry(subs: Subscriptions, id: SubId) -> bool {
    match sub_at(subs, id.who, id.sub) {
        Some(entry) => match entry.cover { Some(_) => false, None => true },
        None => false,
    }
}

fn due_entry(subs: Subscriptions, id: SubId) -> bool {
    match sub_at(subs, id.who, id.sub) {
        Some(entry) => entry.due,
        None => false,
    }
}

// Marks a live sub for repair (§3 "Repair"); an ended entry or a removed sub is not marked.
fn mark_due(mut subs: Subscriptions, who: u64, sub: u32) -> bool {
    match map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> bool {
        match map.update(mut group, sub, scoped fn(mut entry: Sub) -> bool {
            match entry.cover {
                Some(_) => { entry.due = true; true },
                None => false,
            }
        }) {
            Some(marked) => marked,
            None => false,
        }
    }) {
        Some(marked) => marked,
        None => false,
    }
}

fn due_subs(subs: Subscriptions, who: u64) -> List[u32] {
    let mut due: List[u32] = list.new()
    if let Some(group) = map.get(subs.by_session, who) {
        for (sub, entry) in group {
            if entry.due { list.push(mut due, sub) }
        }
    }
    take due
}

// What one step owes one session: at `version`, the subs whose whole initial result it
// carries, its rows and its Ended subs; or, with `reset`, a Reset and nothing else.
type Owe: send { session: u64, version: u64, generations: List[(u32, u64)], complete: List[u32], rows: List[Row], ended: List[(u32, u64, Outcome)], reset: bool }

type Board[G: send, H: send] { r: Registry[G, H], h: H, base: store.Snapshot, newest: Option[store.Snapshot], subs: Subscriptions }

fn sub_generation(generations: List[(u32, u64)], sub: u32) -> Option[u64] {
    for (id, generation) in generations { if id == sub { return Some(generation) } }
    None
}

fn stamp_rows(mut generations: List[(u32, u64)], sub: u32, generation: u64) {
    if generation != 0u64 { list.push(mut generations, (sub, generation)) }
}

fn owe(mut owes: List[Owe], who: u64, version: u64) -> u64 {
    let mut i = 0u64
    while i < list.len(owes) {
        if owes[i].session == who {
            return i
        }
        i += 1u64
    }
    list.push(mut owes, Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false))
    i
}

fn run_query[G: send, H: send](r: Registry[G, H], h: H, s: store.Snapshot, input: SubscriptionInput, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
    match map.get(r.slots, input.key) {
        Some(Query(_, _, go)) => go(s, h, input.caller, input.arg, prior, old, sub, rows),
        _ => Stopped(Refused(NoEntry)),
    }
}

fn projection_error(take e: store.Error) -> Queried {
    match take e {
        Full(c) => Stopped(Failed(OutOfBytes(room(store_capacity(c))))),
        take other => Lost(take other),
    }
}

// The log's backing list belongs to the publisher. The row bytes and codec
// scratch created during projection are charged to the subscription's bound.
fn row_log() -> Result[Log[Row], Capacity] {
    let output: Log[Row] = log.new()
    log.append(output, Row(sub: 0u32, key: list.new(), value: None))
    Ok(take output)
}

fn read_rows(take output: Log[Row]) -> List[Row] {
    let mut rows = log.finish(take output)
    let _ = list.remove(mut rows, 0u64)
    take rows
}

fn projection_row(out: Log[Row], sub: u32, take ch: store.Change, take value: Option[Bytes]) -> Result[(), store.Error] {
    let store.Change(tree_key: take key, value: _) = take ch
    log.append(out, Row(sub: sub, key: take key, value: take value))
    Ok(())
}

// The rows inside a Cover at s, each with its published value (F10).
fn cover_rows(s: store.Snapshot, c: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    let mut rows = store.open_span_changes(s, c.low, c.high)?
    while let Some(take ch) = store.next_span_change(mut rows)? {
        let value = (c.value)(ch)?
        projection_row(out, sub, take ch, take value)?
    }
    Ok(())
}

fn at_base_generation[G: send, H: send](mut b: Board[G, H], who: u64, sub: u32, generation: u64, take input: SubscriptionInput) -> Owe {
    let _ = remove_sub(mut b.subs, who, sub)
    let version = store.version(b.base)
    let mut o = Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false)
    let rows = match row_log() {
        Ok(take x) => take x,
        Error(c) => {
            list.push(mut o.ended, (sub, generation, Refused(Budget(room(c)))))
            return take o
        },
    }
    match run_query(b.r, b.h, b.base, input, b.base, None, sub, rows) {
        Covered(take v) => {
            let Viewed(cover: take c, reads: take reads) = take v
            match add_subscription(mut b.subs, who, sub, generation, take input, Some(take c), take reads) {
                Ok(()) => {
                    o.rows = read_rows(take rows)
                    stamp_rows(mut o.generations, sub, generation)
                    list.push(mut o.complete, sub)
                },
                // Its read set cannot be indexed, so no content of it may go: a Reset, whose
                // other subs stay as ended entries (§3 "Ended entries").
                Error(_) => { o.reset = true },
            }
        },
        Stopped(take why) => list.push(mut o.ended, (sub, generation, take why)),
        // A faulted or refused run: its partial read log is its ended entry.
        Faulted(take why, take reads) => match add_subscription(mut b.subs, who, sub, generation, take input, None, take reads) {
            Ok(()) => list.push(mut o.ended, (sub, generation, take why)),
            Error(_) => { o.reset = true },
        },
        Lost(_) => {
            o.reset = true
        },
    }
    take o
}

fn add_subscription(mut subs: Subscriptions, who: u64, sub: u32, generation: u64, take input: SubscriptionInput, take c: Option[Cover], take reads: List[store.Read]) -> Result[(), Capacity] {
    subs.serial += 1u64
    let id = SubId(who: who, sub: sub, serial: subs.serial)
    let (take nodes, take keys) = stage_routes(id, cover_view(c), take reads)?
    put_sub(mut subs, id, Sub(generation: generation, input: take input, cover: take c, routes: take keys, due: false))?
    install_routes(mut subs.root, take nodes)
    Ok(())
}

// The rerun's difference: the keys inside the old Cover at a against the keys inside the new
// Cover at b, removals included, each new or changed key with its published value at b.
fn rerun_rows(a: store.Snapshot, old: Cover, b: store.Snapshot, new: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    let mut before = store.open_span_changes(a, old.low, old.high)?
    let mut after = store.open_span_changes(b, new.low, new.high)?
    let mut previous = store.next_span_change(mut before)?
    let mut next = store.next_span_change(mut after)?
    loop {
        let order = match (view previous, view next) {
            (Some(x), Some(y)) => if x.tree_key < y.tree_key { 0u8 } else if x.tree_key == y.tree_key { 1u8 } else { 2u8 },
            (Some(_), None) => 0u8,
            (None, Some(_)) => 2u8,
            (None, None) => return Ok(()),
        }
        if order == 0u8 {
            let removed = option.unwrap(replace(mut previous, None))
            projection_row(out, sub, take removed, None)?
            previous = store.next_span_change(mut before)?
            continue
        }
        let was = if order == 1u8 {
            let row = option.unwrap(replace(mut previous, None))
            let v = (old.value)(row)?
            previous = store.next_span_change(mut before)?
            take v
        } else {
            None
        }
        let row = option.unwrap(replace(mut next, None))
        let now = (new.value)(row)?
        if was != now {
            projection_row(out, sub, take row, take now)?
        }
        next = store.next_span_change(mut after)?
    }
}

// The changed keys inside a Cover, with their published values at b.
fn covered_rows(d: List[store.Change], c: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    for ch in d {
        let v = (c.value)(ch)?
        let copied: Bytes = clone(ch.tree_key)
        let key = take copied
        log.append(out, Row(sub: sub, key: take key, value: take v))
    }
    Ok(())
}

fn change_offset(d: List[store.Change], key: Bytes) -> u64 {
    match list.binary_search_by(d, scoped fn(ch: store.Change) -> Order {
        if ch.tree_key < key { Less } else { Greater }
    }) {
        Ok(i) => i,
        Error(i) => i,
    }
}

fn project_changes[G: send, H: send](r: Registry[G, H], key: Bytes, d: List[store.Change], c: Cover, sub: u32, rows: Log[Row]) -> Result[(), Queried] {
    // changes walks the two data trees in key order, with at most one change per key.
    let first = change_offset(d, c.low)
    let past = change_offset(d, c.high)
    match map.get(r.slots, key) {
        Some(Query(allowance, steps, _)) => bounded_changes(allowance, steps, list.slice(d, first, past), c, sub, rows),
        _ => Error(Stopped(Refused(NoEntry))),
    }
}

fn bounded_changes(allowance: u64, steps: u64, d: List[store.Change], c: Cover, sub: u32, rows: Log[Row]) -> Result[(), Queried] {
    let attempt = bound bytes allowance {
        isolate(fn() -> Result[Result[(), store.Error], OutOfTime] {
            bound steps steps { covered_rows(d, c, sub, rows) }
        })
    }
    match take attempt {
        Ok(Ok(Ok(Ok(Ok(()))))) => Ok(()),
        Ok(Ok(Ok(Ok(Error(e))))) => Error(projection_error(take e)),
        Ok(Ok(Ok(Error(e)))) => Error(Stopped(Failed(OutOfTime(e.steps)))),
        Ok(Ok(Error(cs))) => Error(Stopped(Failed(Raised(raised(cs))))),
        Ok(Error(f)) => Error(Stopped(Failed(OutOfBytes(room(f))))),
        Error(f) => Error(Stopped(Refused(Budget(room(f))))),
    }
}

// A session Reset ends all its subscriptions, whose read sets stay as ended entries, and
// replaces its owed content.
fn reset_session(mut subs: Subscriptions, mut owes: List[Owe], who: u64, version: u64) {
    end_session(mut subs, who)
    let k = owe(mut owes, who, version)
    owes[k] = Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: true)
}

fn reset_subscriptions(mut subs: Subscriptions, mut owes: List[Owe], version: u64) {
    let groups = replace(mut subs.by_session, map.new())
    subs.root = None
    for (who, _) in groups { reset_session(mut subs, mut owes, who, version) }
}

fn affected_subscriptions(subs: Subscriptions, changes: List[store.Change]) -> Result[List[(SubId, bool)], Capacity] {
    let mut hits: Map[u64, (SubId, bool)] = map.new()
    for ch in changes { route_key(subs.root, ch.tree_key, mut hits)? }
    let mut ordered: List[(SubId, bool)] = list.with_capacity(map.len(hits))
    for (_, hit) in hits { list.push(mut ordered, hit) }
    // Both projection and reruns observe the same subscription order as G3.
    list.sort(mut ordered, scoped fn(a: (SubId, bool), b: (SubId, bool)) -> Order {
        if a.0.serial < b.0.serial { Less } else if a.0.serial > b.0.serial { Greater } else { Equal }
    })
    Ok(take ordered)
}

// A re-run's Cover and read set replace the sub's, or, with no Cover, its partial read log
// makes it an ended entry.
fn replace_routes(mut subs: Subscriptions, id: SubId, take c: Option[Cover], take reads: List[store.Read]) -> Result[(), Capacity] {
    let (take nodes, take keys) = stage_routes(id, cover_view(c), take reads)?
    let mut incoming = Some((take c, take keys))
    let old = option.unwrap(option.unwrap(map.update(mut subs.by_session, id.who, scoped fn(mut group: Map[u32, Sub]) -> Option[List[RouteKey]] {
        map.update(mut group, id.sub, scoped fn(mut entry: Sub) -> List[RouteKey] {
            let (take cover_next, take routes_next) = option.unwrap(replace(mut incoming, None))
            entry.cover = take cover_next
            replace(mut entry.routes, take routes_next)
        })
    })))
    unregister_routes(mut subs.root, old)
    install_routes(mut subs.root, take nodes)
    Ok(())
}

// The sub keeps the read set of its last run as its ended entry.
fn end_round_sub(mut subs: Subscriptions, mut out: Owe, id: SubId, generation: u64, take why: Outcome) {
    list.push(mut out.ended, (id.sub, generation, take why))
    end_entry(mut subs, id.who, id.sub)
}

fn append_round_rows(mut out: Owe, id: SubId, generation: u64, take rows: Log[Row]) {
    let before = list.len(out.rows)
    for take row in read_rows(take rows) { list.push(mut out.rows, take row) }
    if list.len(out.rows) != before { stamp_rows(mut out.generations, id.sub, generation) }
}

type SubUpdate = Rows(Log[Row]) | Refreshed(Viewed, Log[Row]) | EndSub(Outcome) | EndRead(Outcome, List[store.Read]) | ResetSubs

fn advance_sub[G: send, H: send](b: Board[G, H], newest: store.Snapshot, d: List[store.Change], id: SubId, read: bool) -> Option[(u64, SubUpdate)] {
    let Some(entry) = sub_at(b.subs, id.who, id.sub) else { return None }
    let generation = entry.generation
    let rows = match row_log() {
        Ok(take x) => take x,
        Error(f) => return Some((generation, EndSub(Refused(Budget(room(f)))))),
    }
    let advanced = if read {
        match run_query(b.r, b.h, newest, entry.input, b.base, cover_view(entry.cover), id.sub, rows) {
            Covered(take v) => Refreshed(take v, take rows),
            Stopped(take why) => EndSub(take why),
            Faulted(take why, take reads) => EndRead(take why, take reads),
            Lost(_) => ResetSubs,
        }
    } else {
        let Some(c) = entry.cover else { return None }
        match project_changes(b.r, entry.input.key, d, c, id.sub, rows) {
            Ok(()) => Rows(take rows),
            Error(Stopped(take why)) => EndSub(take why),
            Error(_) => ResetSubs,
        }
    }
    Some((generation, take advanced))
}

// G2: one round from the base to the newest snapshot released.
// `fenced` gets every session with a read-set hit, found before any sub is advanced or ended;
// a lost diff fences them all.
fn round[G: send, H: send](mut b: Board[G, H], mut fenced: Fenced) -> List[Owe] {
    let mut owes: List[Owe] = list.new()
    let Some(take newest) = replace(mut b.newest, None) else { return take owes }
    let version = store.version(newest)
    let d = match store.changes(b.base, newest) {
        Ok(take x) => take x,
        Error(_) => {
            fenced.all = true
            reset_subscriptions(mut b.subs, mut owes, version)
            b.base = take newest
            return take owes
        },
    }
    let hits = match affected_subscriptions(b.subs, d) {
        Ok(take x) => take x,
        Error(_) => {
            fenced.all = true
            reset_subscriptions(mut b.subs, mut owes, version)
            b.base = take newest
            return take owes
        },
    }
    for (id, read) in hits {
        if read && !list.contains(fenced.sessions, id.who) {
            list.push(mut fenced.sessions, id.who)
        }
    }
    for (id, read) in hits {
        // An ended entry's hit is a read-set hit, fenced above: from this round's E every writer
        // drops all of its content, so the entry leaves.
        if ended_entry(b.subs, id) {
            let _ = remove_sub(mut b.subs, id.who, id.sub)
            continue
        }
        // A due sub's hit is fenced above and its diff is not computed: the repair's full
        // image replaces whatever this round changed (§3 "Repair").
        if due_entry(b.subs, id) { continue }
        let Some((generation, take advanced)) = advance_sub(b, newest, d, id, read) else { continue }
        let k = owe(mut owes, id.who, version)
        match take advanced {
            Rows(take rows) => append_round_rows(mut owes[k], id, generation, take rows),
            Refreshed(Viewed(cover: take c, reads: take reads), take rows) => {
                match replace_routes(mut b.subs, id, Some(take c), take reads) {
                    Ok(()) => append_round_rows(mut owes[k], id, generation, take rows),
                    Error(f) => end_round_sub(mut b.subs, mut owes[k], id, generation, Refused(Budget(room(f)))),
                }
            },
            EndSub(take why) => end_round_sub(mut b.subs, mut owes[k], id, generation, take why),
            EndRead(take why, take reads) => match replace_routes(mut b.subs, id, None, take reads) {
                Ok(()) => list.push(mut owes[k].ended, (id.sub, generation, take why)),
                Error(_) => reset_session(mut b.subs, mut owes, id.who, version),
            },
            ResetSubs => reset_session(mut b.subs, mut owes, id.who, version),
        }
    }
    b.base = take newest
    take owes
}

// The stream's reply at p is the Outcome's codec bytes (STORE-SPEC §1.8 reply).
fn encode_runner_reply(o: Outcome) -> Result[Bytes, store.Error] {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let mut b: Bytes = list.new()
    std.codec.encode(co, o, mut b) ?=> |_| Limit(Value)
    Ok(take b)
}

// ---- P2: the head (H1-H4) and its gate (V3, V4).

// A request at the head. The session computed its digest at ingress (store.request_digest
// over the requested key and the exact argument bytes, v2.11.3) and never takes one from a
// client.
pub opaque type Req: send { e: HeadIn }

type HeadIn: send = Requested(Request) | OwnerLeft

type Request: send {
    caller: Caller,
    stream: Bytes,
    p: u64,
    key: Bytes,
    arg: Bytes,
    digest: store.RequestDigest,
    deadline: u64,
    reply_to: Sender[WireEvent],
    live: Latest[HeadLife],
    identity: Latest[OwnerNumber],
    seed: Option[Arc[OwnerNumber]]
}

type Recipient: send { owner: u64, to: Sender[WireEvent] }

type Answer: send { recipient: Recipient, row: KeyedDone }

type Replies: send { recipient: Recipient, rows: List[KeyedDone] }

// With a snapshot, a Release carries its group's durable version (V4). Without one it
// carries commitless answers, which the publisher sends at its base (V3).
pub opaque type Release: send {
    version: u64,
    snapshot: Option[store.Snapshot],
    answers: List[Answer]
}

// The publisher's one inbox (v2.12, ruled 2026-11-17: one mailbox per actor). The head's
// Releases, a session's join, its Subscribes and Unsubscribes, its leaving and the head's
// last word arrive here in send order, so a Subscribe is ordered against every Release (G3)
// without selection, which v1 lacks.
pub opaque type PubIn: send { e: ToPub }

type ToPub: send = Released(Release) | Joined(Join) | Subscribed(u64, u32, Caller, Bytes, Bytes) | WireSubscribed(u64, u32, u64, SubscriptionInput) | Unsubscribed(u64, u32) | Left(u64) | Halt | Drained

// A session's join, on its first Subscribe: where its content goes, and where the
// publisher answers with the id it mints for the session.
// v2.14: a marked session (an HTTP group or one-shot read) sends the Receiver of its
// retirement mark, a channel it keeps the only Sender of and never sends on.
// v2.19: a session's fence root holds a handle the publisher publishes on (§3 "The release
// check"), and the publisher answers with the session's id and a handle to the round register.
// v2.20: `progress` is the owner's drain token (§3 "Repair"), a capacity-1 channel the owner
// sends on before each `Drained`; with none, a due session repairs on every pass.
// v2.22: `taken` is the session's taken register (§3 "Repair"): the count of `complete`s the
// owner has taken and no longer holds unsent. `first` is the Subscribe that made the owner
// join, registered as the publisher takes the Join, so a join needs one PubIn message.
type Join: send { to: Sender[WireEvent], told: Sender[Admit], mark: Option[Receiver[()]], closed: Option[Receiver[()]], identity: Option[Latest[OwnerNumber]], fence: Option[Latest[Fence]], progress: Option[Receiver[()]], taken: Option[Latest[Taken]], first: Option[JoinSubscribe] }

// v2.22: the owner's first Subscribe, with its instance, carried in its Join.
type JoinSubscribe: send { sub: u32, generation: u64, input: SubscriptionInput }

// v2.22: how many `complete`s the owner has taken from its inbox, published only while it
// holds none of them unsent (§3 "Repair").
type Taken: shareable + send { n: u64 }

type Admit: send { who: u64, round: Latest[RoundAt] }

// v2.19 (§3 "The release check"): `latest` is the newest commit that hit a read set of the
// session, and `prior` the value `latest` had before it.
pub type Fence: shareable + send { prior: u64, latest: u64 }

// The round register's value R: the newest version whose fences are all published.
// u64::MAX is the deploy halt's, and drops every content unit.
type RoundAt: shareable + send { at: u64 }

const ROUND_HALTED: u64 = 18446744073709551615u64

// The publisher's `PubIn` capacity in an operated place (§3 queue table: 64 in the reference
// server). A full `PubIn` ends an owner's Join or Subscribe with Refused(Overloaded).
const PUBLISHER_INBOX: u64 = 64u64

// The publisher's inbox, both ends, and the place's round register with its reserved Arcs.
// `post` gives each session a sender; place_head then takes the mailbox whole, its head
// sending Releases on the same channel.
pub opaque type Mailbox: send { to: Sender[PubIn], from: Receiver[PubIn], rounds: RoundRegister }

// The round register and every Arc a round publishes from (§3 "Admission"): the current
// value (the publisher's own share), the spares, which no reader reaches through the root,
// and u64::MAX. `mailbox` reserves one spare and each fenced `Joined` one more, so with at
// most one share per writer some spare is always unshared. The register fails closed: a
// publisher that ends by anything but `Halt` (a trap included) publishes R = u64::MAX as it
// is cleaned, before its inbox closes, so no commit after the trap is released unfenced.
resource type RoundRegister: send { round: Latest[RoundAt], halted: Arc[RoundAt], current: Arc[RoundAt], spares: List[Arc[RoundAt]] } drop(rounds) {
    latest.publish(rounds.round, arc.share(rounds.halted))
}

// `Halt`: the publisher stops on the head's word, and R stays where it is.
fn round_disarm(take rounds: RoundRegister) {
    let RoundRegister(round: _, halted: _, current: _, spares: _) = take rounds
}

pub fn mailbox(n: u64) -> Result[Mailbox, Capacity] {
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(n)
    let first = arc.new(RoundAt(at: 0u64))
    let register = latest.new(arc.share(first))
    let halted = arc.new(RoundAt(at: ROUND_HALTED))
    let next = arc.new(RoundAt(at: 0u64))
    let mut spares: List[Arc[RoundAt]] = list.new()
    list.push(mut spares, take next)
    let rounds = RoundRegister(round: take register, halted: take halted, current: take first, spares: take spares) ?=> |(c, _)| c
    Ok(Mailbox(to: take to, from: take from, rounds: take rounds))
}

// A session's fence root and the Arcs its fence step publishes from: the current one (the
// publisher's own share) and two spares. Its writer holds at most one share at a time, so
// one spare is always unshared.
type FenceSet: send { root: Latest[Fence], current: Arc[Fence], a: Arc[Fence], b: Arc[Fence] }

// `Joined`'s reservation: the session's two fence spares and one more round spare. A refusal
// admits nothing and the join is answered with id 0.
fn fence_reserve(mut rounds: RoundRegister, take root: Latest[Fence]) -> Result[FenceSet, Capacity] {
    let a = arc.new(Fence(prior: 0u64, latest: 0u64))
    let b = arc.new(Fence(prior: 0u64, latest: 0u64))
    let spare = arc.new(RoundAt(at: 0u64))
    list.push(mut rounds.spares, take spare)
    let current = latest.read(root)
    Ok(FenceSet(root: take root, current: take current, a: take a, b: take b))
}

// Publishes Fence{prior: the current latest, latest: b} from an unshared spare, the old
// current becoming that spare. A fence already at b is left. False only if no spare is
// unshared and no Arc can be made.
fn fence_advance(mut fences: FenceSet, b: u64) -> bool {
    let prior = fences.current.latest
    if prior >= b { return true }
    let in_a = arc.with_unique(mut fences.a, scoped fn(mut f: Fence) { f.prior = prior; f.latest = b })
    let fresh = if let Some(_) = in_a {
        let kept = arc.share(fences.current)
        replace(mut fences.a, take kept)
    } else {
        let in_b = arc.with_unique(mut fences.b, scoped fn(mut f: Fence) { f.prior = prior; f.latest = b })
        if let Some(_) = in_b {
            let kept = arc.share(fences.current)
            replace(mut fences.b, take kept)
        } else {
            arc.new(Fence(prior: prior, latest: b))
        }
    }
    let _ = replace(mut fences.current, take fresh)
    latest.publish(fences.root, arc.share(fences.current))
    true
}

// Publishes R = at from an unshared spare, the old current becoming that spare, and frees
// spares beyond one per joined session plus one, keeping every shared spare and one unshared
// one. False only if no spare is unshared and no Arc can be made.
fn round_advance(mut rounds: RoundRegister, at: u64, live: u64) -> bool {
    let mut chosen: Option[u64] = None
    let mut i = 0u64
    while i < list.len(rounds.spares) {
        let unique = match arc.with_unique(mut rounds.spares[i], scoped fn(mut v: RoundAt) { v.at = at }) { Some(_) => true, None => false }
        if unique {
            if let None = chosen {
                chosen = Some(i)
            } else if list.len(rounds.spares) > live + 1u64 {
                let _ = list.remove(mut rounds.spares, i)
                continue
            }
        }
        i += 1u64
    }
    let index = match chosen {
        Some(x) => x,
        None => {
            let made = arc.new(RoundAt(at: at))
            list.push(mut rounds.spares, take made)
            list.len(rounds.spares) - 1u64
        },
    }
    let kept = arc.share(rounds.current)
    let fresh = list.set(mut rounds.spares, index, take kept)
    let _ = replace(mut rounds.current, take fresh)
    latest.publish(rounds.round, arc.share(rounds.current))
    true
}

// The release check's decision (§3), one function for every transport: R = u64::MAX drops
// every content unit; otherwise the fence acts at `latest` once R has reached it, and at
// `prior` before, and a unit passes if that fence is at most its version.
pub fn release_passes(r: u64, f: Fence, version: u64) -> bool {
    if r == ROUND_HALTED { return false }
    let effective = if f.latest <= r { f.latest } else { f.prior }
    effective <= version
}

// The writer's check: R first, then the fence, each copied and its share released before
// the decision.
fn release_load(register: Latest[RoundAt], fence: Latest[Fence], version: u64) -> bool {
    let r = latest.read(register).at
    let f = {
        let held = latest.read(fence)
        Fence(prior: held.prior, latest: held.latest)
    }
    release_passes(r, f, version)
}

pub fn post(m: Mailbox) -> Sender[PubIn] {
    channel.sender(m.to)
}

// A stream's worker, from its commit until the gate releases its group.
type Worker: send { p: u64, digest: store.RequestDigest, version: u64, outcome: Outcome, waiters: List[Recipient] }

type Waiting: send { req: Request, parked: bool, held_by_pause: bool }

type Head[G: send, H: send] {
    db: store.Db,
    r: Registry[G, H],
    replay_identity: Bytes,
    h: H,
    out: Sender[PubIn],
    busy: Map[Bytes, Worker],
    waiting: List[Waiting],
    group: List[Bytes],
    last: Option[store.Ticket],
    // Closed groups waiting for their own sync, oldest first, and the commitless
    // Releases that arrived behind them (V3 FIFO). Their workers stay in `busy`.
    held: List[Held],
    // Sync notices reach the inbox as SyncWake, so the head runs later work while
    // a group's sync is outstanding; without them each group waits at its close.
    wakes: bool,
    minted: u64,
    // The publisher refused a Release: it has stopped, and R = u64::MAX is published. The
    // head commits nothing more and the place ends with OpenError.PublisherStopped.
    cut: bool,
    trigger_drive: Option[Box[TriggerDrive[G]]]
}

type Publish[G: send, H: send]: send {
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    n_place: u64,
    h: H,
    base: store.Snapshot,
    from: Receiver[PubIn],
    rounds: RoundRegister,
    ready: Sender[Option[RegisterError]]
}

// The publisher task runs `place` itself and tells the head whether it could.
fn publish[G: send, H: send](take p: Publish[G, H]) -> () waits {
    let Publish(place: place, n_place: n_place, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready) = take p
    let r = match placed(place, n_place) {
        Ok(take x) => take x,
        Error(take e) => {
            let _ = channel.send(ready, Some(take e))
            return
        },
    }
    if let Error(_) = channel.send(ready, None) {
        return
    }
    publisher(take r, take h, take base, take from, take rounds)
}

// The head selects the release under the store's LOCK before opening handles.
pub fn place_head[G: send, H: send](take db: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: Receiver[HeadInput], take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    place_head_selected(take db, Current(0u64), place, n_place, migrate, handles, take inbox, take mail, tasks, n_publisher)
}

pub fn place_head_selected[G: send, H: send](take db: store.Db, selection: Selection, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: Receiver[HeadInput], take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    let mut owned = take db
    let persistent = store.is_disk(owned)
    let prepared = head_prepare(mut owned, selection, persistent, place, migrate, handles, n_place, tasks)
    let (r, h, h2, _, replay_identity) = match take prepared {
        Ok(take ready) => take ready,
        Error(take problem) => { let _ = close_store(take owned); return Error(take problem) },
    }
    let _ = run_head(take owned, take r, take replay_identity, take h, take h2, place, n_place, take inbox, take mail, tasks, n_publisher, None, None)?
    Ok(())
}

fn run_head[G: send, H: send](take db: store.Db, take r: Registry[G, H], take replay_identity: Bytes, take h: H, take h2: H,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, take inbox: Receiver[HeadInput],
    take mail: Mailbox, tasks: Tasks, n_publisher: u64, take drain: Option[HeadDrain], take trigger_drive: Option[Box[TriggerDrive[G]]]) -> Result[Option[u64], OpenError] waits {
    let mut owned = take db
    let publishing = start_publisher(owned, place, n_place, take h2, take mail, tasks, n_publisher)
    let (out, publisher_task) = match take publishing {
        Ok(take started) => take started,
        Error(take problem) => { let _ = close_store(take owned); return Error(take problem) },
    }
    if let Some(control) = drain {
        if !head_advance(control.events, inbox, Published(channel.sender(out))) {
            let mut stopping = take publisher_task
            task.cancel(mut stopping)
            let _ = task.join(take stopping)
            close_store(take owned)?
            return Ok(None)
        }
    }
    let mut hd = Head(db: take owned, r: take r, replay_identity: take replay_identity, h: take h, out: take out, busy: map.new(), waiting: list.new(), group: list.new(), last: None, held: list.new(), wakes: false, minted: 0u64, cut: false, trigger_drive: take trigger_drive)
    let mut tables: Option[triggers.Tables] = None
    let (take woken, take helpers) = head_wakes(mut hd, take inbox, drain, tasks)
    let served = serve_head(mut hd, take woken, take drain, mut tables)
    for take helper in take helpers {
        let mut stopping = take helper
        task.cancel(mut stopping)
        let _ = task.join(take stopping)
    }
    finish_head(take hd, take publisher_task, take served, take tables)
}

type SyncRelay: send { notices: Receiver[()], to: Sender[HeadInput] }

// One SyncWake per sync notice, and a last one when the journal worker ends, so a head
// waiting on its inbox looks at its held groups again. A full inbox drops the wake: the
// head then has input to take, and it polls the journal before it waits again.
fn relay_syncs(take relay: SyncRelay) -> () waits {
    loop {
        let more = match channel.receive(relay.notices) { Ok(()) => true, Error(_) => false }
        let _ = channel.try_send(relay.to, SyncWake)
        if !more { return }
    }
}

type Forward: send { from: Receiver[HeadInput], to: Sender[HeadInput] }

// A head the caller feeds through its own channel gets one inbox that also carries the
// relay's wakes. The caller closing its channel arrives as InboxEnded.
fn forward_requests(take forward: Forward) -> () waits {
    loop {
        match head_next(forward.from, true) {
            Some(take message) => if let Error(_) = channel.send(forward.to, take message) { return },
            None => {
                let _ = channel.send(forward.to, InboxEnded)
                return
            },
        }
    }
}

// A journaled store's syncs wake the head through its inbox (Head.wakes). A store
// without a journal is durable at commit, so its groups release at close.
fn head_wakes[G: send, H: send](mut hd: Head[G, H], take inbox: Receiver[HeadInput], drain: Option[HeadDrain], tasks: Tasks) -> (Receiver[HeadInput], List[Task[()]]) {
    let mut helpers: List[Task[()]] = list.new()
    let Some(take notices) = store.sync_notices(mut hd.db) else { return (take inbox, take helpers) }
    let (to, woken): (Sender[HeadInput], Receiver[HeadInput]) = match drain {
        Some(control) => (channel.sender(control.head_to), take inbox),
        None => {
            let (to, from): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(64u64)
            let forward = Forward(from: take inbox, to: channel.sender(to))
            match task.try_spawn(tasks, bytes 65536u64, take forward, forward_requests) {
                Ok(take running) => list.push(mut helpers, take running),
                Error((_, take back)) => {
                    let Forward(from: take original, ..) = take back
                    return (take original, take helpers)
                },
            }
            (take to, take from)
        },
    }
    let relay = SyncRelay(notices: take notices, to: take to)
    if let Ok(take running) = task.try_spawn(tasks, bytes 65536u64, take relay, relay_syncs) {
        list.push(mut helpers, take running)
        hd.wakes = true
    }
    (take woken, take helpers)
}

fn finish_head[G: send, H: send](take head: Head[G, H], take publishing: Task[()], take served: Result[bool, store.Error], take drained_tables: Option[triggers.Tables]) -> Result[Option[u64], OpenError] waits {
    let Head(db: take kept, out: take last_word, cut: cut, trigger_drive: take drive, ..) = take head
    let tables = match take drive {
        Some(take scheduled) => Some(stop_triggers(take scheduled)),
        None => take drained_tables,
    }
    if let Ok(true) = served {} else { let _ = channel.send(last_word, PubIn(e: Halt)) }
    let stopped = match task.join(take publishing) { Ok(()) => cut, Error(_) => true }
    match take served { Ok(_) => (), Error(take problem) => return Error(Store(take problem)) }
    if stopped {
        let _ = close_store(take kept)
        return Error(PublisherStopped)
    }
    let due = match tables {
        Some(trigger_tables) => next_trigger_due(kept, trigger_tables) ?=> Store,
        None => None,
    }
    close_store(take kept)?
    Ok(due)
}

fn next_trigger_due(db: store.Db, tables: triggers.Tables) -> Result[Option[u64], store.Error] {
    let next = triggers.next_pending(store.snapshot(db), tables, fn(id: triggers.Id) -> bool { false })?
    Ok(match next { Some(pending) => Some(triggers.due_time(pending)), None => None })
}

fn close_store(take db: store.Db) -> Result[(), OpenError] waits {
    match store.close(take db) { Ok(()) => Ok(()), Error(take problem) => Error(Store(take problem)) }
}

fn open_handles[H: send](mut db: store.Db, handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]]) -> Result[H, OpenError] {
    match store.with_schema(mut db, handles) {
        Ok(take h) => Ok(take h),
        Error(take problem) => Error(Store(take problem)),
    }
}

fn start_publisher[G: send, H: send](owned: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, take h2: H, take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(Sender[PubIn], Task[()]), OpenError] waits {
    let Mailbox(to: take out, from: take from, rounds: take rounds) = take mail
    let (ready, readied): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let p = Publish(place: place, n_place: n_place, h: take h2, base: store.snapshot(owned), from: take from, rounds: take rounds, ready: take ready)
    let publishing = task.spawn(tasks, bytes n_publisher, take p, publish)
    match channel.receive(readied) {
        Ok(None) => (),
        Ok(Some(take e)) => {
            let _ = task.join(take publishing)
            return Error(Place(take e))
        },
        // The task ended without a word: `place` already ran here, so the task's own
        // allowance could not hold it.
        Error(_) => {
            let _ = task.join(take publishing)
            return Error(Place(Full(Capacity(requested: n_publisher, available: 0u64))))
        },
    }
    Ok((take out, take publishing))
}

type DrainWindow: shareable + send { admission: u64, deadline: u64 }
type LifeEvent: send = StopRequested | Recovered | Activated(Bytes, u64, (u64, u64), u64, Bytes) | Published(Sender[PubIn]) | ServePrepared | StoreAccepted | Settled | HeadEnded(Result[Option[u64], StartError]) | AdmissionClose | DrainExpired | ServeEnded(Result[u64, StartError])
    | WritesPaused | WritesResumed | RetirePlace
    | IdleDeadline(u64) | HeadIdle(bool) | ServeIdle(bool) | HeadIdleChecked(Option[Sender[()]]) | ServeIdleChecked(Option[Sender[()]])

// The owner parks while operate accepts or declines its idle vote. The sender
// stays with operate until the drain window is published or the vote is refused.
fn idle_vote(to: Sender[LifeEvent], head: bool, idle: bool) -> () waits {
    if idle {
        let (release, parked): (Sender[()], Receiver[()]) = channel.new(1u64)
        let vote = if head { HeadIdleChecked(Some(take release)) } else { ServeIdleChecked(Some(take release)) }
        if let Ok(()) = channel.send(to, take vote) { let _ = channel.receive(parked) }
    } else {
        let _ = channel.send(to, if head { HeadIdleChecked(None) } else { ServeIdleChecked(None) })
    }
}

pub type HeadInput: send = RunRequest(Req) | HeadContinue | HeadClose | HeadFinish | TriggerWake(u64) | TriggerMessage(Box[TriggerInput]) | TriggerDone(triggers.Attempt, Option[Outcome])
    | StartCutover(Box[CutoverWork]) | AbortCutover(Bytes, Option[Bytes], Sender[()]) | PauseDeadline(u64)
    | ExportCommand(Box[ExportCommand]) | ReserveImport(Box[ReserveImport]) | KeepImport(Box[KeepImport]) | CheckHeadIdle
    | SyncWake | InboxEnded

pub type CutoverWork: send { request: store.Cutover, result_to: Sender[Result[(u64, bool), store.DeployError]] }

pub type ExportCommand: send {
    scratch: Dir, attempt: Bytes, retry: bool, answer: Sender[Result[store.ExportCopy, store.DeployError]],
}
pub type ReserveImport: send { checked: store.ValidatedImport, answer: Sender[Result[store.ImportWork, store.DeployError]] }
pub type KeepImport: send { built: store.Imported, answer: Sender[Result[Inline[u8, 32], store.DeployError]] }

pub type HostCommand: codec + send = HostExport(Bytes, bool) | HostImport(Bytes, Bytes, Bytes)
    | HostCutover(Bytes, Bytes, u64, bool) | HostAbort(Bytes, Option[Bytes]) | HostStoreAccepted
pub type PlaceReady: codec + send { version: u64, store_hi: u64, store_lo: u64, release: Bytes, retain_from: u64, ready_ns: u64, read: Bytes }
pub type HostReply: codec + send = PlaceOpened(PlaceReady) | PlaceCurrent(u64, Bytes) | PlaceRefused(String)
    | PlaceExported(u64, String) | PlaceImported(Bytes) | PlaceInstalled(u64, bool) | PlaceDrift | PlaceAborted | PlaceUncertain | PlaceWriteAck(u64)
    | PlaceStoreMismatch(u64, u64, u64, u64) | PlaceInstallRefused(InstallRefusal)

pub type InstallRefusal: codec + send = InstallHeld | InstallStore | InstallPlace | InstallMigration
    | InstallCurrent | InstallIdentity | InstallCapacity | InstallConfig | InstallWrongVersion(u64)

pub fn store_mismatch(expected: (u64, u64), actual: (u64, u64)) -> String {
    let mut msg = string.from("store identity mismatch (expected ")
    string.push_uint(mut msg, expected.0, 16u32, 16u64, '0')
    string.push_uint(mut msg, expected.1, 16u32, 16u64, '0')
    string.push(mut msg, ", found ")
    string.push_uint(mut msg, actual.0, 16u32, 16u64, '0')
    string.push_uint(mut msg, actual.1, 16u32, 16u64, '0')
    string.push(mut msg, ")")
    take msg
}

type HostControl {
    answer: Sender[HostReply], sent: Receiver[()], reading: Task[()], writing: Task[()],
    ack: Sender[u64], acknowledging: Task[()],
}
type HostReader: send {
    input: ReadHalf, to_head: Sender[HeadInput], life: Sender[LifeEvent], answer: Sender[HostReply], scratch: Dir, clock: Clock, maximum: u64,
}
type HostWriter: send { output: WriteHalf, responses: Receiver[HostReply], sent: Sender[()] }

fn start_host_control(tasks: Tasks, clock: Clock, n_place: u64, to_head: Sender[HeadInput], life: Sender[LifeEvent]) -> Result[Option[HostControl], StartError] {
    let Some(take control) = launch_socket() else { return Ok(None) }
    let Some(scratch) = launch_scratch() else { return Error(Missing("scratch")) }
    let (take input, take output) = net.split(take control)
    let (answer, responses): (Sender[HostReply], Receiver[HostReply]) = channel.new(2u64)
    let (notice, sent): (Sender[()], Receiver[()]) = channel.new(1u64)
    let writer = task.spawn(tasks, bytes 16384u64, HostWriter(output: take output, responses: take responses, sent: take notice), host_writer)
    let reader = task.spawn(tasks, bytes n_place, HostReader(input: take input, to_head: channel.sender(to_head), life: channel.sender(life), answer: channel.sender(answer), scratch: scratch, clock: clock, maximum: n_place), host_reader)
    let (ack, take first_write): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    let request = (take first_write, channel.sender(answer))
    let acknowledging = task.spawn(tasks, bytes 4096u64, take request, forward_first_write)
    Ok(Some(HostControl(answer: take answer, sent: take sent, reading: take reader, writing: take writer, ack: take ack, acknowledging: take acknowledging)))
}

fn forward_first_write(take notice: (Receiver[u64], Sender[HostReply])) -> () waits {
    let (take from, take answer) = take notice
    let first = channel.receive(from)
    let _ = take from
    if let Ok(at) = first { let _ = channel.send(answer, PlaceWriteAck(at)) }
}

fn read_control(mut input: ReadHalf, maximum: u64) -> Option[HostCommand] waits {
    let Some(body) = read_frame(mut input, maximum, Never) else { return None }
    let codec: std.codec.Codec[HostCommand] = std.codec.of()
    match std.codec.decode(codec, body) { Ok(take command) => Some(take command), _ => None }
}

fn send_control(mut output: WriteHalf, host_result: HostReply) -> bool waits {
    let codec: std.codec.Codec[HostReply] = std.codec.of()
    let mut body: Bytes = list.new()
    if let Error(_) = std.codec.encode(codec, host_result, mut body) { return false }
    send_frame(mut output, body, 4294967295u64, Never)
}

fn host_writer(take writer: HostWriter) -> () waits {
    let HostWriter(output: take output, responses: take responses, sent: take sent) = take writer
    let mut socket = take output
    while let Ok(take host_result) = channel.receive(responses) {
        if !send_control(mut socket, host_result) { return }
        let _ = channel.try_send(sent, ())
    }
}

fn host_head[T: send](head: Sender[HeadInput], request: scoped fn(take Sender[T]) -> Result[HeadInput, Capacity]) -> Option[T] waits {
    let (host_result, response): (Sender[T], Receiver[T]) = channel.new(1u64)
    let message = match request(take host_result) { Ok(take command) => take command, Error(_) => return None }
    if let Error(_) = channel.send(head, take message) { return None }
    match channel.receive(response) { Ok(take value) => Some(take value), Error(_) => None }
}

fn host_refusal(why: store.DeployError) -> String {
    match why {
        Store(Full(_)) => "Full",
        Store(Missing(_)) => "Missing",
        Store(Exists(_)) => "Exists",
        Store(_) => "Store",
        Scratch(_) => "Scratch",
        ExportMismatch => "ExportMismatch",
        AttemptBusy => "Busy",
        ImportMalformed => "ImportMalformed",
        IdBound => "IdBound",
        Drift => "Drift",
        Expired => "Expired",
        FullNew(_) => "Full(New)",
    }
}

fn host_export(head: Sender[HeadInput], scratch: Dir, attempt: Bytes, retry: bool) -> Result[store.Exported, store.DeployError] waits {
    let response = host_head(head, scoped fn(take answer: Sender[Result[store.ExportCopy, store.DeployError]]) -> Result[HeadInput, Capacity] {
        let payload = ExportCommand(scratch: scratch, attempt: clone(attempt), retry: retry, answer: take answer)
        let command = box.new(take payload)
        Ok(ExportCommand(take command))
    })
    let Some(take started) = take response else { return Error(AttemptBusy) }
    store.export_copy(started?)
}

fn host_import(head: Sender[HeadInput], exported: store.Exported, description: Bytes, release: Bytes, digest: Bytes) -> Result[Inline[u8, 32], store.DeployError] waits {
    let checked = store.validate_prepared(exported.dir)?
    if !store.prepared_matches(checked, description, release, digest) { return Error(ImportMalformed) }
    let mut awaiting = Some(take checked)
    let reserved = host_head(head, scoped fn(take answer: Sender[Result[store.ImportWork, store.DeployError]]) -> Result[HeadInput, Capacity] {
        let payload = ReserveImport(checked: option.unwrap(replace(mut awaiting, None)), answer: take answer)
        let command = box.new(take payload)
        Ok(ReserveImport(take command))
    })
    let Some(take reserved_work) = take reserved else { return Error(AttemptBusy) }
    let mut built = Some(store.import_trees(reserved_work?)?)
    let kept = host_head(head, scoped fn(take answer: Sender[Result[Inline[u8, 32], store.DeployError]]) -> Result[HeadInput, Capacity] {
        let payload = KeepImport(built: option.unwrap(replace(mut built, None)), answer: take answer)
        let command = box.new(take payload)
        Ok(KeepImport(take command))
    })
    match take kept { Some(take answer) => take answer, None => Error(AttemptBusy) }
}

fn host_cutover(head: Sender[HeadInput], attempt: Bytes, digest: Bytes, deadline: u64) -> HostReply waits {
    if list.len(attempt) != 16u64 || list.len(digest) != 32u64 { return PlaceRefused("ExportMismatch") }
    let mut hash: Inline[u8, 32] = [0u8; 32]
    for i in 0u64 .. 32u64 { hash[i] = digest[i] }
    let response = host_head(head, scoped fn(take host_result: Sender[Result[(u64, bool), store.DeployError]]) -> Result[HeadInput, Capacity] {
        let request = store.Cutover(attempt: clone(attempt), digest: hash, deadline: deadline)
        let command = box.new(CutoverWork(request: take request, result_to: take host_result))
        Ok(StartCutover(take command))
    })
    match take response {
        Some(Ok((version, waiting))) => PlaceInstalled(version, waiting),
        Some(Error(Drift)) => PlaceDrift,
        Some(Error(Store(Poisoned(_)))) => PlaceUncertain,
        Some(Error(why)) => PlaceRefused(host_refusal(why)),
        None => PlaceUncertain,
    }
}

fn host_reader(take reader: HostReader) -> () waits {
    let HostReader(input: take socket, to_head: take head, life: take life, answer: take answer, scratch: scratch, clock: clock, maximum: maximum) = take reader
    let mut input = take socket
    let mut exported: Option[store.Exported] = None
    while let Some(take request) = read_control(mut input, maximum) {
        let host_result: HostReply = match take request {
            HostExport(attempt, retry) => match host_export(head, scratch, attempt, retry) {
                Ok(take found) => {
                    let version = found.stamp.head
                    let name: String = clone(found.name)
                    exported = Some(take found)
                    PlaceExported(version, take name)
                },
                Error(why) => PlaceRefused(host_refusal(why)),
            },
            HostImport(description, release, digest) => match exported {
                Some(info) => match host_import(head, info, description, release, digest) {
                    Ok(hash) => {
                        let mut wire_hash: Bytes = list.with_capacity(32u64)
                        for byte in hash { list.push(mut wire_hash, byte) }
                        PlaceImported(take wire_hash)
                    },
                    Error(why) => PlaceRefused(host_refusal(why)),
                },
                None => PlaceRefused("ExportMismatch"),
            },
            HostCutover(attempt, digest, max_pause_ms, retry) => {
                let deadline = if retry { 0u64 } else { std.clock.deadline_after_ms(host.mono_ns(clock), max_pause_ms) }
                let _ = replace(mut exported, None)
                host_cutover(head, attempt, digest, deadline)
            },
            HostStoreAccepted => {
                let _ = channel.send(life, StoreAccepted)
                continue
            },
            HostAbort(attempt, retry_of) => {
                let releasing = match exported {
                    Some(held) => abort_matches(held.stamp.attempt, attempt, retry_of),
                    None => false,
                }
                if releasing { let _ = replace(mut exported, None) }
                let aborted = host_head(head, scoped fn(take done: Sender[()]) -> Result[HeadInput, Capacity] {
                    Ok(AbortCutover(clone(attempt), clone(retry_of), take done))
                })
                if let None = aborted { return }
                PlaceAborted
            },
        }
        if let Error(_) = channel.send(answer, take host_result) { return }
    }
}

type WritePause {
    deadline: u64,
    attempt: Bytes,
    deadline_task: Task[()],
    work: Option[CutoverWork],
}

type HeadDrain {
    finish: Receiver[()], events: Sender[LifeEvent], window: Latest[Option[DrainWindow]],
    clock: Clock, tasks: Tasks, head_to: Sender[HeadInput], n_place: u64, cut: CutActivity, idle: Option[u64],
}

type ManagedHead[G: send, H: send, S: send]: send {
    backing: Backing, options: store.Options, selection: Selection, tasks: Tasks, clock: Clock, random: Random,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    n_place: u64, n_publisher: u64, inbox: Receiver[HeadInput], finish_from: Receiver[()],
    to: Sender[LifeEvent], drain: Latest[Option[DrainWindow]],
    head_to: Sender[HeadInput], cut: CutActivity,
    triggering: Option[TriggerConfig[G, S]], idle: Option[u64], expected_store: Option[(u64, u64)],
}

fn head_advance(to: Sender[LifeEvent], inbox: Receiver[HeadInput], take progress: LifeEvent) -> bool waits {
    if let Error(_) = channel.send(to, take progress) { return false }
    match channel.receive(inbox) { Ok(HeadContinue) => true, _ => false }
}

fn head_ended[G: send, H: send, S: send](take job: ManagedHead[G, H, S]) -> () waits {
    let to = channel.sender(job.to)
    let ended = managed_head(take job)
    let _ = channel.send(to, HeadEnded(take ended))
}

fn open_backing(take backing: Backing, options: store.Options, tasks: Tasks, clock: Clock, random: Random) -> Result[(store.Db, Option[TemporaryBacking]), StartError] waits {
    let mut temporary: Option[TemporaryBacking] = None
    let opened: Result[store.Db, store.Error] = match backing {
        Memory => Ok(store.memory(clock, random, options)),
        Disk(dir) => store.open(tasks, dir, clock, random, options),
        Temp(parent) => {
            let name = string.with_capacity(32u64)
            let mut cleanup = match TemporaryBacking(dir: parent, name: take name) { Ok(take guard) => take guard, Error((cap, _)) => return Error(Full(cap)) }
            let dir = match std.dir.create_temp(parent, mut cleanup.name) { Ok(dir) => dir, Error(problem) => return Error(Open(Store(Io(problem)))) }
            temporary = Some(take cleanup)
            store.open(tasks, dir, clock, random, options)
        },
    }
    let db = match take opened { Ok(take db) => take db, Error(take problem) => return Error(Open(Store(take problem))) }
    Ok((take db, take temporary))
}

fn managed_head[G: send, H: send, S: send](take job: ManagedHead[G, H, S]) -> Result[Option[u64], StartError] waits {
    let ManagedHead(backing: take backing, options: take options, selection: selection, tasks: tasks, clock: clock, random: random, place: place, migrate: migrate, handles: handles,
        n_place: n_place, n_publisher: n_publisher, inbox: take inbox, finish_from: take finish_from, to: take to, drain: take drain,
        head_to: take head_to, cut: take cut, triggering: take triggering, idle: idle, expected_store: expected_store) = take job
    let persistent = match backing { Disk(_) => true, _ => false }
    let (take opened, take temporary) = open_backing(take backing, options, tasks, clock, random)?
    let mut db = take opened
    if let Some(expected) = expected_store {
        let actual = store.identity_words(db)
        if expected != actual {
            let _ = close_store(take db)
            return Error(Open(StoreMismatch(expected, actual)))
        }
    }
    if !head_advance(to, inbox, Recovered) { return head_closed(take db) }
    let prepared = head_prepare(mut db, selection, persistent, place, migrate, handles, n_place, tasks)
    let (reg, local, publisher_handles, release, replay_identity) = match take prepared {
        Ok(take values) => take values,
        Error(take problem) => { let _ = close_store(take db); return Error(Open(take problem)) },
    }
    // A place directory reopens a disk store at this version (RUNNER-SPEC §13.3).
    let (version, retain_from) = if persistent {
        match activation_window(db) { Ok(found) => found, Error(take problem) => { let _ = close_store(take db); return Error(Open(Store(take problem))) } }
    } else { (0u64, 0u64) }
    let read: Bytes = if persistent {
        match capture_release(db, version, launch_env().witness) {
            Ok(take raw) => take raw,
            Error(take problem) => { let _ = close_store(take db); return Error(Open(Store(take problem))) },
        }
    } else { list.new() }
    if !head_advance(to, inbox, Activated(clone(release), version, store.identity_words(db), retain_from, take read)) { return head_closed(take db) }
    let trigger_drive = match open_trigger_drive(mut db, clock, tasks, channel.sender(head_to), reg.exported, n_place, take triggering) {
        Ok(take drive) => take drive,
        Error(take problem) => { let _ = close_store(take db); return Error(Open(Store(take problem))) },
    }
    let mail = match mailbox(PUBLISHER_INBOX) {
        Ok(take mail) => take mail,
        Error(cap) => { let _ = close_store(take db); return Error(Full(cap)) },
    }
    let closing = HeadDrain(finish: take finish_from, events: take to, window: take drain, clock: clock, tasks: tasks, head_to: take head_to, n_place: n_place, cut: take cut, idle: idle)
    let ended = run_head(take db, take reg, take replay_identity, take local, take publisher_handles, place, n_place, take inbox, take mail, tasks, n_publisher, Some(take closing), take trigger_drive)
    let _ = take temporary
    match take ended {
        Ok(due) => Ok(due),
        Error(Store(Full(cap))) => Error(Full(store_capacity(cap))),
        Error(take problem) => Error(Open(take problem)),
    }
}

fn head_closed(take db: store.Db) -> Result[Option[u64], StartError] waits {
    close_store(take db) ?=> Open
    Ok(None)
}

fn head_prepare[G: send, H: send](mut db: store.Db, selection: Selection, persistent: bool,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], n_place: u64, tasks: Tasks) -> Result[(Registry[G, H], H, H, Bytes, Bytes), OpenError] waits {
    if !store.is_disk(db) {
        let mut local_registry = match placed(place, n_place) { Ok(take registered) => take registered, Error(take problem) => return Error(Place(take problem)) }
        let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
        if let Error(take problem) = store.run_migration(mut db, tasks, migrate) { return Error(Migrate(take problem)) }
        let h = open_handles(mut db, handles)?
        let h2 = open_handles(mut db, handles)?
        let release = release_digest(local_registry.exported) ?=> |_| Place(Bounds)
        return Ok((take local_registry, take h, take h2, take release, take identity))
    }
    if persistent && launch_env().revision.size == 0u64 { return Error(IdentityUnknown) }
    let current = activation_result(current_description(db))?
    let selected: Option[u64] = match selection {
        Install => None,
        InstallAt(target) => {
            let next = store.version(store.snapshot(db)) + 1u64
            if next != (if target == 0u64 { 1u64 } else { target }) {
                return Error(InstallVersion(next))
            }
            None
        },
        Reopen => match current {
            None => None,
            Some(_) => {
                if store.fence_level(db) == 0 && persistent { return Error(NotCurrent(Legacy)) }
                Some(activation_result(activation_version(db))?)
            },
        },
        Current(expected) => match current {
            None => {
                if expected != 0u64 { return Error(NotCurrent(Empty)) }
                None
            },
            Some(_) => {
                if store.fence_level(db) == 0 && persistent { return Error(NotCurrent(Legacy)) }
                let version = activation_result(activation_version(db))?
                if version != expected { return Error(not_current_activation(db, version, option.unwrap(take current))) }
                Some(version)
            },
        },
    }
    let mut reg = match placed(place, n_place) { Ok(take reg) => take reg, Error(take problem) => return Error(Place(take problem)) }
    let (description, record) = prepare_activation(reg, n_place) ?=> Place
    if let Some(version) = selected {
        let old = option.unwrap(take current)
        let prior = activation_result(release_record(db, version))?
        let matches = match prior { Some(row) => row.binding == record.binding, None => false }
        if !matches { return Error(not_current_activation(db, version, take old)) }
        let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
        let h = open_handles(mut db, handles)?
        let h2 = open_handles(mut db, handles)?
        let ReleaseRecord(release: take release, ..) = take record
        return Ok((take reg, take h, take h2, take release, take identity))
    }
    let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
    let mut stage = match store.stage_migration(db, tasks, migrate) {
        Ok(take staged) => take staged,
        Error(take problem) => return Error(Migrate(take problem)),
    }
    let version = store.version(store.snapshot(db)) + 1u64
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    activation_result(store.stage_activation(mut stage, version, current, description, release_codec, record))?
    let h = activation_result(store.with_staged_schema(mut stage, handles))?
    let h2 = activation_result(store.with_staged_schema(mut stage, handles))?
    if let Error(take problem) = store.install_activation(mut db, take stage) {
        if let Tiered(Install) = problem { return Error(Store(take problem)) }
        if let InstallAt(_) = selection { return Error(InstallUncertain(take problem)) }
        return Error(Store(take problem))
    }
    let ReleaseRecord(release: take release, ..) = take record
    Ok((take reg, take h, take h2, take release, take identity))
}

fn activation_result[T](take answer: Result[T, store.Error]) -> Result[T, OpenError] {
    match take answer {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Store(take problem)),
    }
}

fn activation_identity(place_id: Bytes, migrate_id: Bytes, handles_id: Bytes) -> Result[Bytes, OpenError] {
    match replay_identity_of(place_id, migrate_id, handles_id) {
        Ok(take digest) => Ok(take digest),
        Error(problem) => Error(Store(Full(Allocation(problem)))),
    }
}

fn replay_identity_of(place_id: Bytes, migrate_id: Bytes, handles_id: Bytes) -> Result[Bytes, Capacity] {
    let launch = launch_digest()?
    if list.len(launch) == 0 { return Ok(list.new()) }
    let mut raw = take launch
    be_word(mut raw, list.len(place_id), 4)?
    list.append(mut raw, place_id)
    be_word(mut raw, list.len(migrate_id), 4)?
    list.append(mut raw, migrate_id)
    be_word(mut raw, list.len(handles_id), 4)?
    list.append(mut raw, handles_id)
    let mut hash = std.sha256.start()
    std.sha256.add(mut hash, raw, 0, list.len(raw))
    let digest = std.sha256.finish(hash)
    let mut identity: Bytes = list.with_capacity(32)
    for byte in digest { list.push(mut identity, byte) }
    Ok(take identity)
}

pub type PrepareError: send = Open(OpenError) | Deploy(store.DeployError) | Identity

pub type PrepareConfig[G: send, H: send] {
    scratch: Dir,
    options: store.Options,
    attempt: Bytes,
    image_digest: Bytes,
    clock: Clock,
    tasks: Tasks,
    n_place: u64,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits],
    handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    triggers: triggers.Entries
}

pub type TriggerScanClass: codec + key + send = Cancelling | Held | Gone | Changed | Unchanged

// TRIGGERS contains one value-codec List[TriggerScanRow].
pub type TriggerScanRow: codec + send {
    class: TriggerScanClass,
    kind: Kind,
    path: Bytes,
    schema: Bytes,
    count: u64,
    earliest_due: u64
}

pub type PrepareArgs { attempt: Bytes, digest: Bytes }

pub fn launch_prepare_args(a: Args) -> Result[Option[PrepareArgs], Exit] {
    let Some(mode) = args.get(a, 0u64) else { return Ok(None) }
    if mode != "--hirsel-prepare" { return Ok(None) }
    let invalid = Exit(status: 1u8)
    if args.len(a) != 4u64 { return Error(invalid) }
    let Some(attempt_text) = args.get(a, 2u64) else { return Error(invalid) }
    let Some(image_text) = args.get(a, 3u64) else { return Error(invalid) }
    let attempt = prepare_hex(attempt_text, 16u64)
    let digest = prepare_hex(image_text, 32u64)
    match (take attempt, take digest) {
        (Some(take ticket), Some(take image)) => Ok(Some(PrepareArgs(attempt: take ticket, digest: take image))),
        _ => Error(invalid),
    }
}

// The launcher passes the attempt and image digest as fixed-width hex.
fn prepare_hex(text: String, count: u64) -> Option[Bytes] {
    let raw = string.as_bytes(text)
    if list.len(raw) != 2u64 * count { return None }
    let mut out: Bytes = list.with_capacity(count)
    for i in 0u64 .. count {
        let Some(hi) = hex_digit(raw[2u64 * i]) else { return None }
        let Some(lo) = hex_digit(raw[2u64 * i + 1u64]) else { return None }
        list.push(mut out, (hi << 4u8) | lo)
    }
    Some(take out)
}

fn hex_digit(byte: u8) -> Option[u8] {
    if byte >= b'0' && byte <= b'9' { return Some(byte - b'0') }
    if byte >= b'a' && byte <= b'f' { return Some(byte - b'a' + 10u8) }
    None
}

fn prepare_result[T](take outcome: Result[T, store.DeployError]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Deploy(take reason)),
    }
}

fn prepare_open_result[T](take outcome: Result[T, store.Error]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Open(Store(take reason))),
    }
}

// The process receives its export directory as a scratch capability. It
// creates no listener or live-store lock.
pub fn prepare_deploy[G: send, H: send](p: PrepareConfig[G, H]) -> Result[(), PrepareError] waits {
    let source = prepare_result(store.open_export(p.scratch, p.clock, p.attempt, p.options))?
    let digest = match launch_digest() {
        Ok(take hash) => take hash,
        Error(c) => return Error(Open(Store(Full(Allocation(c))))),
    }
    if list.len(digest) != 32 || digest != p.image_digest || launch_env().revision.size == 0u64 { return Error(Identity) }
    prepare_export(p, source)
}

fn prepare_export[G: send, H: send](p: PrepareConfig[G, H], source: store.Preparation) -> Result[(), PrepareError] waits {
    let registered = match placed(p.place, p.n_place) {
        Ok(take reg) => take reg,
        Error(take error) => return Error(Open(Place(take error))),
    }
    if let Error(take problem) = activation_identity(code.identity(p.place), code.identity(p.migrate), code.identity(p.handles)) {
        return Error(Open(take problem))
    }
    let mut staged = match store.stage_export_migration(source, p.tasks, p.migrate) {
        Ok(take staged) => take staged,
        Error(take error) => return Error(Open(Migrate(take error))),
    }
    let _ = prepare_open_result(store.with_staged_schema(mut staged, p.handles))?
    let _ = prepare_open_result(store.with_staged_schema(mut staged, p.handles))?
    if let Error(take problem) = store.validate_preparation(source, staged) { return Error(Open(Store(take problem))) }
    let (take description, take record) = prepare_activation(registered, p.n_place) ?=> |problem| Open(Place(problem))
    let ReleaseRecord(release: take release, digest: take image, binding: take binding, ..) = take record
    let target = store.PreparedTarget(describe: take description, release: take release, digest: take image,
        resident_limit: p.options.resident_limit, pack_bytes: p.options.pack_bytes,
        checkpoint_bytes: p.options.checkpoint_bytes, journal_limit: p.options.journal_limit)
    let scan = prepare_trigger_scan(source, staged, registered, p.triggers, binding)?
    write_trigger_scan(p.scratch, scan)?
    prepare_result(store.write_prepared(source, staged, p.scratch, take target))
}

fn trigger_scan_limit() -> PrepareError { Deploy(Scratch(Limit(Triggers))) }

fn prepare_trigger_scan[G: send, H: send](source: store.Preparation, staged: store.StagedMigration, reg: Registry[G, H], choices: triggers.Entries, digest: Bytes) -> Result[Bytes, PrepareError] {
    let scanned = isolate(scoped fn() -> Result[Bytes, PrepareError] {
        let snapshot = store.staged_snapshot(source, staged)
        let table = prepare_open_result(triggers.pending_table_if_present(store.snapshot_schema(snapshot)))?
        let rows = match prepare_open_result(triggers.scan_pending(snapshot, table))? {
            Some(take cursor) => collect_trigger_scan(take cursor, source, reg, choices, digest)?,
            None => list.new(),
        }
        let codec: std.codec.Codec[List[TriggerScanRow]] = std.codec.of_list()
        let mut raw: Bytes = list.new()
        std.codec.encode(codec, rows, mut raw) ?=> |_| trigger_scan_limit()
        Ok(take raw)
    })
    match take scanned {
        Ok(Ok(Error(Open(Store(Full(Allocation(_))))))) => Error(trigger_scan_limit()),
        Ok(Ok(take report)) => take report,
        Error(_) => Error(trigger_scan_limit()),
        Ok(Error(causes)) => {
            for cause in causes {
                if let Capacity(_) = cause.kind { return Error(trigger_scan_limit()) }
                break
            }
            fail("runner: trigger scan failed")
        },
    }
}

fn collect_trigger_scan[G: send, H: send](take cursor: triggers.PendingRows, source: store.Preparation, reg: Registry[G, H], choices: triggers.Entries, digest: Bytes) -> Result[List[TriggerScanRow], PrepareError] {
    let mut remaining = take cursor
    let raw = match store.export_system_get(source, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes(), 0u8) {
        Ok(take row) => take row,
        Error(Missing(_)) => None,
        Error(take problem) => return Error(Open(Store(take problem))),
    }
    let old = if let Some(take prior_description) = take raw {
        let codec: std.codec.Codec[Describe] = std.codec.of()
        let Describe(exported: take prior_entries, ..) = std.codec.decode(codec, prior_description) ?=> |problem| Open(Store(Decode(problem)))
        take prior_entries
    } else { list.new() }
    let mut grouped: Map[(TriggerScanClass, Kind, Bytes, Bytes), (u64, u64)] = map.new()
    while let Some(take pending) = prepare_open_result(triggers.next_scanned(mut remaining))? {
        let class = prepare_open_result(trigger_scan_class(reg, choices, old, pending, digest))?
        let due = triggers.due_time(pending)
        let path: Bytes = clone(triggers.entry_path(pending))
        let schema: Bytes = clone(triggers.argument_schema(pending))
        let kind: Kind = if triggers.is_granted(pending) { Granted } else { Transact }
        let key = (class, kind, take path, take schema)
        map.update_or_insert(mut grouped, take key, (0u64, due), scoped fn(mut totals: (u64, u64)) {
            totals = (totals.0 + 1u64, std.order.min(totals.1, due))
        })
    }
    let mut rows: List[TriggerScanRow] = list.with_capacity(map.len(grouped))
    for take ((class, kind, take path, take schema), (count, earliest)) in take grouped {
        list.push(mut rows, TriggerScanRow(class: class, kind: kind,
            path: take path, schema: take schema, count: count, earliest_due: earliest))
    }
    Ok(take rows)
}

fn trigger_scan_class[G: send, H: send](reg: Registry[G, H], choices: triggers.Entries, old: List[Exported], pending: triggers.Pending, digest: Bytes) -> Result[TriggerScanClass, store.Error] {
    if triggers.cancelling(pending) { return Ok(Cancelling) }
    if triggers.held_on_start(pending, digest) { return Ok(Held) }
    let Some((_, index)) = trigger_key(reg, pending, choices)? else { return Ok(Gone) }
    for entry in old {
        if trigger_matches(pending, entry.described) {
            return Ok(if entry.revision != reg.exported[index].revision { Changed } else { Unchanged })
        }
    }
    Ok(Unchanged)
}

fn write_trigger_scan(d: Dir, raw: Bytes) -> Result[(), PrepareError] waits {
    let mut file = host.open(d, "TRIGGERS", Write) ?=> |e| Deploy(Scratch(Io(e)))
    host.write(mut file, raw) ?=> |e| Deploy(Scratch(Io(e.error)))
    host.sync(mut file) ?=> |e| Deploy(Scratch(Io(e)))
    host.close(take file) ?=> |e| Deploy(Scratch(Io(e)))
    Ok(())
}

fn target_release(target: store.PreparedTarget, prepared: Inline[u8, 32]) -> Result[ReleaseRecord, store.DeployError] {
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let decoded = std.codec.decode(codec, target.describe)
    let description = match take decoded {
        Ok(take description) => take description,
        Error(_) => return Error(ImportMalformed),
    }
    let binding = identity_digest(description) ?=> |_| ImportMalformed
    let release = release_digest(description.exported) ?=> |_| ImportMalformed
    if release != target.release { return Error(ImportMalformed) }
    let mut witness: Bytes = list.with_capacity(32u64)
    for byte in prepared { list.push(mut witness, byte) }
    Ok(ReleaseRecord(release: take release, digest: clone(description.digest), binding: take binding, n_place: description.n_place, prepared: take witness))
}

fn cutover_store[G: send, H: send](mut db: store.Db, request: store.Cutover, reg: Registry[G, H], n_place: u64, before_cut: scoped fn() -> bool) -> Result[u64, store.DeployError] waits {
    let binding = match prepare_activation(reg, n_place) {
        Ok((_, ReleaseRecord(binding: take binding, ..))) => take binding,
        Error(Full(c)) => { store.release_export(mut db, request.attempt); return Error(Store(Full(Allocation(c)))) },
        Error(_) => { store.release_export(mut db, request.attempt); return Error(Drift) },
    }
    let selected = current_description(db)
    let description = match take selected {
        Ok(Some(take known)) => take known,
        Ok(None) => { store.release_export(mut db, request.attempt); return Error(Drift) },
        Error(take problem) => { store.release_export(mut db, request.attempt); return Error(Store(take problem)) },
    }
    let version = match activation_version(db) {
        Ok(version) => version,
        Error(take problem) => { store.release_export(mut db, request.attempt); return Error(Store(take problem)) },
    }
    match release_record(db, version) {
        Ok(Some(row)) if row.binding == binding => (),
        Ok(_) => { store.release_export(mut db, request.attempt); return Error(Drift) },
        Error(take problem) => { store.release_export(mut db, request.attempt); return Error(Store(take problem)) },
    }
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    store.perform_cutover(mut db, request, version, description, codec, target_release, before_cut)
}

pub type CutoverOutcome = Installed(u64, Result[(), store.Error]) | Refused(store.DeployError, store.Db)

// The request reaches this point only after the head settles its admitted
// calls. Once installed, the callback retires publication and the sessions;
// the caller cannot regain a writer for the old image.
pub fn cutover[G: send, H: send](take db: store.Db, request: store.Cutover, reg: Registry[G, H], n_place: u64,
    retire: scoped fn(u64) -> () waits) -> CutoverOutcome waits {
    let mut owned = take db
    match cutover_store(mut owned, request, reg, n_place, scoped fn() -> bool { true }) {
        Ok(version) => {
            retire(version)
            Installed(version, store.close(take owned))
        },
        Error(take problem) => Refused(take problem, take owned),
    }
}

fn closing_at(drain: Latest[Option[DrainWindow]], clock: Clock) -> bool {
    match drain_window(latest.read(drain)) { Some(window) => host.mono_ns(clock) >= window.admission, None => false }
}

fn drain_window(window: Option[DrainWindow]) -> Option[DrainWindow] { window }

fn head_next(inbox: Receiver[HeadInput], waiting: bool) -> Option[HeadInput] waits {
    if waiting {
        match channel.receive(inbox) { Ok(take req) => Some(take req), _ => None }
    } else {
        match channel.try_receive(inbox) { Ok(take req) => Some(take req), _ => None }
    }
}

// H3's group ends when the inbox stays empty while every task that was ready
// has had its turn: arrivals that a reader or owner is already carrying join
// this group instead of each paying a durable, a Release and a fan-out round.
// A try_receive that finds Empty is a poll, and the head yields to ready tasks
// only when its polls end a CONC-10 turn (64 polls). The bound is one full
// turn, so every settle crosses a turn boundary before the gate; at 32 half
// the groups gate without yielding, and 1,000 clients at 500 calls/s fall
// behind.
const SETTLE_PROBES: u64 = 64

fn settle_probe(inbox: Receiver[HeadInput]) -> Option[HeadInput] waits {
    let mut polls = 0u64
    while polls < SETTLE_PROBES {
        if let Some(take more) = head_next(inbox, false) { return Some(take more) }
        polls += 1u64
    }
    None
}

fn close_head_admission[G: send, H: send](mut head: Head[G, H]) -> Result[(), store.Error] waits {
    let waiting = replace(mut head.waiting, list.new())
    for take entry in take waiting {
        let Waiting(req: take req, ..) = take entry
        commitless(mut head, take req, Refused(Overloaded))?
    }
    Ok(())
}

fn start_write_pause(mut pause: Option[WritePause], take work: CutoverWork, control: HeadDrain) -> Result[(), store.DeployError] waits {
    let attempt: Bytes = clone(work.request.attempt)
    if let Some(take previous) = replace(mut pause, None) {
        let mut active = take previous
        if !none(active.work) {
            pause = Some(take active)
            return Error(AttemptBusy)
        }
        if work.request.deadline != 0u64 || active.attempt != attempt {
            pause = Some(take active)
            return Error(ExportMismatch)
        }
        let CutoverWork(request: take request, result_to: take host_result) = take work
        let store.Cutover(attempt: take id, digest: digest, ..) = take request
        active.work = Some(CutoverWork(request: store.Cutover(attempt: take id, digest: digest, deadline: active.deadline), result_to: take host_result))
        pause = Some(take active)
        return Ok(())
    }
    let deadline = work.request.deadline
    if host.mono_ns(control.clock) >= deadline { return Error(Expired) }
    let timer = std.clock.alarm(control.tasks, control.clock, deadline, control.head_to, PauseDeadline(deadline))
    pause = Some(WritePause(deadline: deadline, attempt: take attempt, deadline_task: take timer, work: Some(take work)))
    let _ = channel.send(control.events, WritesPaused)
    Ok(())
}

fn pause_expires(pause: Option[WritePause], now: u64) -> bool {
    match pause { Some(active) => now >= active.deadline, None => false }
}

fn retry_export(mut pause: Option[WritePause], attempt: Bytes) -> Result[(), store.DeployError] {
    let Some(take previous) = replace(mut pause, None) else { return Error(Expired) }
    let mut active = take previous
    let outcome: Result[(), store.DeployError] = if none(active.work) {
        active.attempt = clone(attempt)
        Ok(())
    } else { Error(AttemptBusy) }
    pause = Some(take active)
    outcome
}

fn pause_has_work(pause: Option[WritePause]) -> bool {
    match pause { Some(active) => !none(active.work), None => false }
}

fn abort_matches(held: Bytes, attempt: Bytes, retry_of: Option[Bytes]) -> bool {
    if held == attempt { return true }
    match retry_of {
        Some(previous) => held == previous,
        None => false,
    }
}

fn end_write_pause(mut db: store.Db, mut pause: Option[WritePause], control: HeadDrain, take why: store.DeployError) -> () waits {
    if let Some(take active) = replace(mut pause, None) {
        let WritePause(attempt: take id, deadline_task: take timer, work: take work, ..) = take active
        let _ = take timer
        store.release_export(mut db, id)
        if let Some(CutoverWork(result_to: host_result, ..)) = take work {
            let _ = channel.try_send(host_result, Error(take why))
        }
        let _ = channel.send(control.events, WritesResumed)
    }
}

fn pause_progress[G: send, H: send](mut head: Head[G, H], mut pause: Option[WritePause], control: HeadDrain, waiting: bool) -> Result[bool, store.Error] waits {
    let deadline = match pause { Some(active) => active.deadline, None => return Ok(false) }
    if !store.cutover_settled(mut head.db)? {
        let now = host.mono_ns(control.clock)
        host.sleep_until(control.clock, std.order.min(deadline, int.saturating_add(now, 1000000u64)))
        return Ok(false)
    }
    if unreleased(head) { gate(mut head)? }
    let mut active = option.unwrap(replace(mut pause, None))
    let work = replace(mut active.work, None)
    let CutoverWork(request: take request, result_to: take host_result) = option.unwrap(take work)
    let activate_cut = scoped fn() -> bool {
        if !none(drain_window(latest.read(control.window))) { return false }
        latest.publish(control.cut.root, arc.share(control.cut.started))
        true
    }
    let committed = cutover_store(mut head.db, request, head.r, control.n_place, activate_cut)
    match take committed {
        Ok(version) => {
            let _ = replace(mut pause, None)
            let _ = channel.try_send(host_result, Ok((version, waiting)))
            Ok(true)
        },
        Error(Drift) => {
            latest.publish(control.cut.root, arc.share(control.cut.stopped))
            pause = Some(take active)
            let _ = channel.try_send(host_result, Error(Drift))
            Ok(false)
        },
        Error(Store(Poisoned(e))) => {
            let _ = channel.try_send(host_result, Error(Store(Poisoned(e))))
            Error(Poisoned(e))
        },
        Error(take why) => {
            latest.publish(control.cut.root, arc.share(control.cut.stopped))
            pause = Some(take active)
            let _ = channel.try_send(host_result, Error(take why))
            end_write_pause(mut head.db, mut pause, control, AttemptBusy)
            Ok(false)
        },
    }
}

fn head_is_idle[G: send, H: send](head: Head[G, H], idle: u64) -> Result[bool, store.Error] {
    if map.len(head.busy) != 0u64 || list.len(head.waiting) != 0u64 || store.export_leased(head.db) { return Ok(false) }
    if let Some(drive) = head.trigger_drive {
        if map.len(drive.active) != 0u64 { return Ok(false) }
        if let Some(due) = next_trigger_due(head.db, drive.tables)? {
            let at = store.next_call_info(head.db).at
            return Ok(due >= at && due - at >= idle)
        }
    }
    Ok(true)
}

fn serve_head[G: send, H: send](mut head: Head[G, H], take inbox: Receiver[HeadInput], take drain: Option[HeadDrain], mut tables: Option[triggers.Tables]) -> Result[bool, store.Error] waits {
    let mut closed = false
    let mut settled = false
    let mut input: Option[HeadInput] = None
    let mut pause: Option[WritePause] = None
    let mut held_write = false
    let mut resuming = false
    let mut idle = false
    // The forwarded request channel closed (InboxEnded); the head ends once idle.
    let mut ended = false
    loop {
        if head.cut { return Ok(false) }
        if let Some(control) = drain {
            if let Ok(()) = channel.try_receive(control.finish) { release_held(mut head, true)?; return Ok(false) }
            if let Some(_) = drain_window(latest.read(control.window)) {
                end_write_pause(mut head.db, mut pause, control, AttemptBusy)
                // A drain cuts running attempts. Their current rows stay until
                // the next open, which starts a higher attempt.
                if let Some(take scheduled) = replace(mut head.trigger_drive, None) { tables = Some(stop_triggers(take scheduled)) }
            } else if let Some(ms) = control.idle {
                let eligible = none(pause) && head_is_idle(head, ms)?
                if eligible != idle {
                    idle = eligible
                    let _ = channel.send(control.events, HeadIdle(idle))
                }
            }
            if !none(pause) && pause_expires(pause, host.mono_ns(control.clock)) {
                end_write_pause(mut head.db, mut pause, control, Expired)
                refresh_waiting(mut head, true)
                resuming = true
            }
            if !closed && closing_at(control.window, control.clock) {
                closed = true
                close_head_admission(mut head)?
            }
            if closed && !settled && list.len(head.group) == 0u64 && list.len(head.held) == 0u64 {
                let _ = channel.send(control.events, Settled)
                settled = true
            }
        }
        if none(pause) && !closed {
            if resuming {
                if next_waiting(mut head, drain)? { continue }
                resuming = list.len(head.waiting) != 0u64
            }
            if advance_triggers(mut head)? { continue }
        }
        let next = match replace(mut input, None) {
            Some(take next) => Some(take next),
            None => head_next(inbox, false),
        }
        match take next {
            Some(RunRequest(take req)) => {
                head_arrival(mut head, take req, closed, !none(pause) || resuming)?
                if none(pause) { continue }
                held_write = held_write || list.len(head.waiting) != 0u64
            },
            Some(StartCutover(take boxed)) => {
                let starting = none(pause)
                let work = box.unbox(take boxed)
                let host_result = channel.sender(work.result_to)
                if let Some(control) = drain {
                    if closed || !none(drain_window(latest.read(control.window))) {
                        let _ = channel.try_send(host_result, Error(AttemptBusy))
                    } else if let Error(take why) = start_write_pause(mut pause, take work, control) {
                        let _ = channel.try_send(host_result, Error(take why))
                    } else {
                        if starting { held_write = list.len(head.waiting) != 0u64 }
                        for i in 0u64 .. list.len(head.waiting) { head.waiting[i].held_by_pause = true }
                    }
                } else { let _ = channel.try_send(host_result, Error(AttemptBusy)) }
                continue
            },
            Some(AbortCutover(attempt, retry_of, done)) => {
                store.release_export(mut head.db, attempt)
                if let Some(previous) = retry_of {
                    store.release_export(mut head.db, previous)
                }
                if let Some(control) = drain {
                    let current = match pause {
                        Some(active) => abort_matches(active.attempt, attempt, retry_of),
                        None => false,
                    }
                    if current {
                        end_write_pause(mut head.db, mut pause, control, AttemptBusy)
                        refresh_waiting(mut head, true)
                        resuming = true
                    }
                }
                let _ = channel.try_send(done, ())
                continue
            },
            Some(ExportCommand(take command)) => {
                let ExportCommand(scratch: scratch, attempt: take attempt, retry: retry, answer: take host_result) = box.unbox(take command)
                let allowed: Result[(), store.DeployError] = if none(drain) || closed { Error(AttemptBusy) }
                    else if retry { retry_export(mut pause, attempt) }
                    else if !none(pause) { Error(AttemptBusy) } else { Ok(()) }
                let exported: Result[store.ExportCopy, store.DeployError] = match take allowed {
                    Ok(()) => match activation_version(head.db) {
                        Ok(version) => store.begin_export_copy(mut head.db, scratch, take attempt, version),
                        Error(take why) => Error(Store(take why)),
                    },
                    Error(take why) => Error(take why),
                }
                if let Error(Store(Poisoned(e))) = exported { return Error(Poisoned(e)) }
                let _ = channel.try_send(host_result, take exported)
                continue
            },
            Some(ReserveImport(take command)) => {
                let ReserveImport(checked: take checked, answer: take host_result) = box.unbox(take command)
                let reserved = store.reserve_import(mut head.db, take checked)
                let _ = channel.try_send(host_result, take reserved)
                continue
            },
            Some(KeepImport(take command)) => {
                let KeepImport(built: take built, answer: take host_result) = box.unbox(take command)
                let digest = store.imported_digest(built)
                let kept: Result[Inline[u8, 32], store.DeployError] = match store.keep_import(mut head.db, take built) {
                    Ok(()) => Ok(digest), Error(take why) => Error(take why),
                }
                let _ = channel.try_send(host_result, take kept)
                continue
            },
            Some(HeadClose) => { if !closed { closed = true; close_head_admission(mut head)? }; continue },
            Some(HeadFinish) => { release_held(mut head, true)?; return Ok(false) },
            Some(SyncWake) => { release_held(mut head, false)?; continue },
            Some(InboxEnded) => { ended = true; continue },
            Some(CheckHeadIdle) => {
                if let Some(control) = drain {
                    let eligible = match control.idle {
                        Some(ms) => !closed && none(pause) && head_is_idle(head, ms)?,
                        None => false,
                    }
                    idle_vote(control.events, true, eligible)
                }
                continue
            },
            Some(TriggerWake(at)) => { clear_trigger_timer(mut head, at); continue },
            Some(TriggerMessage(take message)) => { trigger_message(mut head, take message, closed)?; continue },
            Some(TriggerDone(a, take outcome)) => { trigger_done(mut head, a, take outcome, closed)?; continue },
            Some(_) => continue,
            None => (),
        }
        if let Some(control) = drain {
            if pause_has_work(pause) {
                if pause_progress(mut head, mut pause, control, held_write)? {
                    let _ = channel.send(head.out, PubIn(e: Halt))
                    let _ = channel.send(control.events, RetirePlace)
                    let _ = channel.receive(control.finish)
                    return Ok(true)
                }
                if none(pause) { refresh_waiting(mut head, true); resuming = true }
                continue
            }
        }
        if none(pause) && !closed && next_waiting(mut head, drain)? { continue }
        if list.len(head.group) > 0u64 {
            if let Some(take more) = settle_probe(inbox) { input = Some(take more); continue }
            // The group's sync runs while the head takes later work; its replies wait
            // for that sync (release_held), behind every earlier group's.
            close_group(mut head)
            let blocking = !head.wakes
            release_held(mut head, blocking)?
            continue
        }
        if list.len(head.held) != 0u64 {
            // Every group is closed. A SyncWake or new work ends this wait.
            release_held(mut head, false)?
            if list.len(head.held) != 0u64 {
                match head_next(inbox, true) { Some(take message) => { input = Some(take message) }, None => { release_held(mut head, true)?; return Ok(false) } }
            }
            continue
        }
        if ended { return Ok(false) }
        match head_next(inbox, true) { Some(take message) => { input = Some(take message) }, None => return Ok(false) }
    }
}

fn head_arrival[G: send, H: send](mut hd: Head[G, H], take message: Req, closed: bool, hold: bool) -> Result[(), store.Error] waits {
    let Req(e: take e) = take message
    match take e {
        Requested(take q) => {
            refresh_waiting(mut hd, true)
            if latest.read(q.live).active {
                let mut req = take q
                if latest.read(req.identity).number == 0u64 {
                    hd.minted += 1u64
                    let number = hd.minted
                    let mut id = option.unwrap(replace(mut req.seed, None))
                    let _ = arc.with_unique(mut id, scoped fn(mut value: OwnerNumber) { value.number = number })
                    latest.publish(req.identity, take id)
                    if !latest.read(req.live).active {
                        return Ok(())
                    }
                }
                if hold && !closed {
                    list.push(mut hd.waiting, Waiting(req: take req, parked: false, held_by_pause: true))
                } else { route_admission(mut hd, take req, closed)? }
            }
        },
        OwnerLeft => refresh_waiting(mut hd, false),
    }
    Ok(())
}

// Read the owner's mark before keeping an old request or admitting replacement work.
fn refresh_waiting[G: send, H: send](mut hd: Head[G, H], unpark: bool) {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        if !latest.read(hd.waiting[i].req.live).active {
            let _ = list.remove(mut hd.waiting, i)
        } else {
            if unpark {
                hd.waiting[i].parked = false
            }
            i += 1u64
        }
    }
}

// H1: a request for its stream's worker position joins the waiters if its digest equals the
// worker's, and is otherwise answered Refused(RequestMismatch) as V3 without running (v2.11.3);
// another position waits.
fn route_admission[G: send, H: send](mut hd: Head[G, H], take q: Request, closed: bool) -> Result[(), store.Error] waits {
    let running = match map.get(hd.busy, q.stream) {
        Some(w) => Some((w.p, w.digest == q.digest)),
        None => None,
    }
    match running {
        Some((p, same)) => if p == q.p && !same {
            commitless(mut hd, take q, Refused(RequestMismatch))
        } else if p == q.p {
            let owner = latest.read(q.identity).number
            let Request(stream: take stream, reply_to: take to, ..) = take q
            let mut w = match map.remove(mut hd.busy, stream) {
                Some(take x) => take x,
                None => return Ok(()),
            }
            list.push(mut w.waiters, Recipient(owner: owner, to: take to))
            map.insert(mut hd.busy, take stream, take w)
            Ok(())
        } else if closed {
            commitless(mut hd, take q, Refused(Overloaded))
        } else {
            list.push(mut hd.waiting, Waiting(req: take q, parked: false, held_by_pause: false))
            Ok(())
        },
        None => if closed { commitless(mut hd, take q, Refused(Overloaded)) } else { begin(mut hd, take q) },
    }
}

// The first unparked waiting request whose stream has no worker starts.
fn next_waiting[G: send, H: send](mut hd: Head[G, H], drain: Option[HeadDrain]) -> Result[bool, store.Error] waits {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        if !hd.waiting[i].parked && !map.contains(hd.busy, hd.waiting[i].req.stream) {
            let Waiting(req: take q, held_by_pause: held, ..) = list.remove(mut hd.waiting, i)
            if held {
                if let Some(control) = drain {
                    if host.mono_ns(control.clock) >= q.deadline { continue }
                }
            }
            if latest.read(q.live).active {
                begin(mut hd, take q)?
                return Ok(true)
            }
            continue
        }
        i += 1u64
    }
    Ok(false)
}

// H2 on the store's admit (STORE-SPEC v2.24). Below latest the store cannot say whether p
// ran these bytes (AH2), and at latest another digest is not this request (AH1): both are
// answered commitless (V3), Refused(HistoryUnavailable) or Refused(RequestMismatch), and
// neither marks the stream.
fn begin[G: send, H: send](mut hd: Head[G, H], take q: Request) -> Result[(), store.Error] waits {
    let a = match store.admit(mut hd.db, q.stream, q.p, q.digest) {
        Ok(take x) => take x,
        Error(Full(_)) => return commitless(mut hd, take q, Refused(Overloaded)),
        Error(e) => return Error(e),
    }
    match take a {
        Admitted(take complete) => execute(mut hd, take q, take complete),
        Abandoned(take complete) => execute(mut hd, take q, take complete),
        Duplicate(stored) => duplicate_reply(mut hd, take q, stored),
        Rejected(_) => {
            list.push(mut hd.waiting, Waiting(req: take q, parked: true, held_by_pause: false))
            Ok(())
        },
        HistoryUnavailable => commitless(mut hd, take q, Refused(HistoryUnavailable)),
        RequestMismatch => commitless(mut hd, take q, Refused(RequestMismatch)),
    }
}

fn copy_bytes(b: Bytes) -> Result[Bytes, store.Error] {
    let mut out: Bytes = list.new()
    list.append(mut out, b)
    Ok(take out)
}

fn be_word(mut raw: Bytes, value: u64, width: u64) -> Result[(), Capacity] {
    for i in 0u64 .. width {
        list.push(mut raw, int.truncate(value >> int.truncate(8 * (width - 1 - i))))
    }
    Ok(())
}

fn record_request(q: Request, revision: Option[Bytes], n: u64, s: u64, replay_identity: Bytes) -> Result[store.CallRecord, store.Error] {
    let rev = match revision { Some(bytes_in) => Some(copy_bytes(bytes_in)?), None => None }
    let code = match code_bytes(n, s, replay_identity) {
        Ok(take bytes_in) => take bytes_in,
        Error(problem) => return Error(Full(Allocation(problem))),
    }
    Ok(store.CallRecord(key: copy_bytes(q.key)?, args: copy_bytes(q.arg)?, stream: copy_bytes(q.stream)?, revision: take rev, code: take code))
}

fn encode_entry_reply(mut tx: store.Tx, take result: Ran) -> Result[Bytes, Bytes] {
    let (keep, take outcome): (bool, Outcome) = match take result {
        Commit(take raw) => (true, Returned(take raw)),
        Abort(take raw) => (false, Returned(take raw)),
        Refuse(take reason) => (false, Refused(take reason)),
        Exhausted(problem) => {
            store.body_capacity(mut tx, problem)
            return Error(list.new())
        },
    }
    match encode_runner_reply(outcome) {
        Ok(take wire_bytes) => if keep { Ok(take wire_bytes) } else { Error(take wire_bytes) },
        Error(Full(problem)) => { store.body_capacity(mut tx, store_capacity(problem)); Error(list.new()) },
        Error(_) => fail("runner: reply encoding failed"),
    }
}

fn failed_stop(stop: store.Stop) -> Outcome {
    match stop {
        Raised(reason) => Failed(Raised(reason)),
        OutOfSteps(steps) => Failed(OutOfTime(steps)),
        OutOfBytes(problem) => Failed(OutOfBytes(room(problem))),
    }
}

type Effect = Served(Result[store.Served, store.ServeError]) | Unregistered(store.Pending)

fn run_effect[G: send, H: send](mut db: store.Db, identity: Bytes, locations: Registry[G, H],
        handles: H, q: Request, take complete: store.Completion) -> Result[Effect, store.Error] waits {
    match map.get(locations.slots, q.key) {
        Some(Transact(n, s, revision, _, go)) => {
            let rec = record_request(q, revision, n, s, identity)?
            // The stored Outcome adds a four-byte tag and a four-byte length.
            let plan = store.Plan(n_e: n, s_e: s, reply_max: MAX_RETURNED_BYTES + 8u64)
            Ok(Served(store.serve(mut db, take complete, plan, Some(take rec),
                scoped fn(mut tx: store.Tx) -> Result[Bytes, Bytes] {
                    let outcome = go(mut tx, handles, q.caller, q.arg)
                    encode_entry_reply(mut tx, take outcome)
                })))
        },
        _ => {
            let attempted = store.next_call_info(db)
            Ok(Unregistered(store.untried(take complete, None, attempted)))
        },
    }
}

fn execute[G: send, H: send](mut hd: Head[G, H], take q: Request, take complete: store.Completion) -> Result[(), store.Error] waits {
    let tried = run_effect(mut hd.db, hd.replay_identity, hd.r, hd.h, q, take complete)
    let ran = match take tried {
        Ok(Served(take result)) => take result,
        Ok(Unregistered(take pending_run)) => return reply_only(mut hd, take q, take pending_run, Failed(Gone)),
        Error(Full(_)) => return commitless(mut hd, take q, Refused(Overloaded)),
        Error(take problem) => return Error(take problem),
    }
    match take ran {
        Ok(Committed(take receipt)) => answered(mut hd, take q, take receipt),
        Ok(Kept(take receipt)) => answered(mut hd, take q, take receipt),
        Ok(Failed(take pending_run, stop)) => reply_only(mut hd, take q, take pending_run, failed_stop(stop)),
        Ok(NoRoom(_, _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(Full(_), _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(take problem, _)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
    }
}

fn answered[G: send, H: send](mut hd: Head[G, H], take q: Request, take receipt: store.Receipt) -> Result[(), store.Error] {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let version = store.version(store.snapshot(hd.db))
    match std.codec.decode(co, receipt.reply) {
        Ok(take outcome) => worker(mut hd, take q, take outcome, receipt.ticket, version),
        _ => fail("runner: stored reply did not decode"),
    }
}

fn reply_only[G: send, H: send](mut hd: Head[G, H], take q: Request, take pending_run: store.Pending, take outcome: Outcome) -> Result[(), store.Error] waits {
    let wire_bytes = encode_runner_reply(outcome)?
    let settled = store.conclude(mut hd.db, take pending_run, take wire_bytes, Resident)
    match take settled {
        Ok(Committed(receipt)) => {
            let version = store.version(store.snapshot(hd.db))
            worker(mut hd, take q, take outcome, receipt.ticket, version)
        },
        Ok(NoRoom(_, _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(Full(_), _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(take problem, _)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
        _ => fail("runner: invalid conclude outcome"),
    }
}

fn duplicate_reply[G: send, H: send](mut hd: Head[G, H], take q: Request, stored: store.Stored) -> Result[(), store.Error] waits {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let outcome = match std.codec.decode(co, stored.reply) {
        Ok(take value) => take value,
        _ => fail("runner: a stored reply does not decode"),
    }
    // A duplicate gets its saved reply as it was committed (ruling 73 as amended).
    commitless(mut hd, take q, take outcome)
}

fn worker[G: send, H: send](mut hd: Head[G, H], take q: Request, take o: Outcome, t: store.Ticket, version: u64) -> Result[(), store.Error] {
    let owner = latest.read(q.identity).number
    let Request(stream: take stream, p: p, digest: d, reply_to: take to, ..) = take q
    let mut waiters: List[Recipient] = list.new()
    list.push(mut waiters, Recipient(owner: owner, to: take to))
    let named: Bytes = clone(stream)
    map.insert(mut hd.busy, take named, Worker(p: p, digest: d, version: version, outcome: take o, waiters: take waiters))
    list.push(mut hd.group, take stream)
    hd.last = Some(t)
    Ok(())
}

// V3: a commitless answer goes at once, in a snapshot-less Release behind every earlier
// Release on the one FIFO to the publisher, held ones included.
fn commitless[G: send, H: send](mut hd: Head[G, H], take q: Request, take o: Outcome) -> Result[(), store.Error] waits {
    let owner = latest.read(q.identity).number
    let Request(stream: take stream, p: p, reply_to: take to, ..) = take q
    let mut answers: List[Answer] = list.new()
    list.push(mut answers, Answer(recipient: Recipient(owner: owner, to: take to), row: KeyedDone(stream: take stream, p: p, outcome: take o)))
    let release = Release(version: 0u64, snapshot: None, answers: take answers)
    if list.len(hd.held) != 0u64 {
        list.push(mut hd.held, Loose(take release))
    } else {
        publish_release(mut hd, take release)
    }
    Ok(())
}

type Held = Sealed(store.Ticket, u64, store.Snapshot, List[Bytes]) | Loose(Release)

fn publish_release[G: send, H: send](mut hd: Head[G, H], take release: Release) waits {
    if let Error(_) = channel.send(hd.out, PubIn(e: Released(take release))) { hd.cut = true }
}

fn unreleased[G: send, H: send](hd: Head[G, H]) -> bool {
    !none(hd.last) || list.len(hd.held) != 0u64
}

// H3: the open group closes behind the held ones with the version and snapshot it
// committed; later commits never reach its Release.
fn close_group[G: send, H: send](mut hd: Head[G, H]) {
    if let Some(t) = replace(mut hd.last, None) {
        let at = store.snapshot(hd.db)
        let d = store.version(at)
        let group = replace(mut hd.group, list.new())
        list.push(mut hd.held, Sealed(t, d, take at, take group))
    }
}

// V4: held entries leave in order, each group only once its own sync covers its last
// commit, with every worker's answer in commit order and the waiters that joined it.
// With `wait` each sync is awaited; otherwise the first unsynced group stops the scan.
fn release_held[G: send, H: send](mut hd: Head[G, H], wait: bool) -> Result[(), store.Error] waits {
    while list.len(hd.held) != 0u64 {
        let ticket = match hd.held[0] { Sealed(t, ..) => Some(t), Loose(_) => None }
        if let Some(t) = ticket {
            if wait { store.durable(mut hd.db, t)? } else if !store.durable_now(mut hd.db, t)? { return Ok(()) }
        }
        match list.remove(mut hd.held, 0u64) {
            Loose(take release) => publish_release(mut hd, take release),
            Sealed(_, d, take at, take group) => {
                let mut answers: List[Answer] = list.new()
                for stream in group {
                    let w = match map.remove(mut hd.busy, stream) {
                        Some(take x) => take x,
                        None => continue,
                    }
                    let Worker(p: p, digest: _, version: _, outcome: take o, waiters: take waiters) = take w
                    for take recipient in waiters {
                        let s: Bytes = clone(stream)
                        let each: Outcome = clone(o)
                        list.push(mut answers, Answer(recipient: take recipient, row: KeyedDone(stream: take s, p: p, outcome: take each)))
                    }
                }
                publish_release(mut hd, Release(version: d, snapshot: Some(take at), answers: take answers))
                refresh_waiting(mut hd, true)
            },
        }
    }
    Ok(())
}

// H3, V4: every commit so far is durable and released, in commit order.
fn gate[G: send, H: send](mut hd: Head[G, H]) -> Result[(), store.Error] waits {
    close_group(mut hd)
    release_held(mut hd, true)
}

// These messages travel on the existing head inbox, so a run can only write
// through the same writer that starts and finishes attempts.
pub type TriggerCallError: send = Closed | Capacity(Capacity) | Store(store.Error) | StaleAttempt | Cancelled

pub type FencedRefusal: send = Refusal(TriggerCallError) | BodyOutcome(Outcome)

type TriggerAction: send =
    Invoke(triggers.Attempt, Bytes, Bytes, Sender[Result[Outcome, TriggerCallError]])
    | Boundary(triggers.Attempt, Sender[Result[(), TriggerCallError]])
    | MarkHold(triggers.Attempt, u64, Bytes, Bytes, Sender[Result[(), TriggerCallError]])
    | Snap(triggers.Attempt, Sender[Result[store.Snapshot, TriggerCallError]])

pub opaque type TriggerInput: send { action: TriggerAction }

fn trigger_request[P, R: send](ctx: TriggerContext, take payload: P, message: fn(triggers.Attempt, take P, take Sender[Result[R, TriggerCallError]]) -> TriggerAction) -> Result[R, TriggerCallError] waits {
    let (to, from): (Sender[Result[R, TriggerCallError]], Receiver[Result[R, TriggerCallError]]) = channel.new(1u64)
    let request = TriggerInput(action: message(ctx.attempt, take payload, take to))
    let msg = box.new(take request)
    if let Error(_) = channel.send(ctx.to, TriggerMessage(take msg)) { return Error(Closed) }
    match channel.receive(from) { Ok(take answer) => take answer, Error(_) => Error(Closed) }
}

pub fn trigger_call(ctx: TriggerContext, take key: Bytes, take arg: Bytes) -> Result[Outcome, TriggerCallError] waits {
    trigger_request(ctx, (take key, take arg), fn(a: triggers.Attempt, take p: (Bytes, Bytes), take to: Sender[Result[Outcome, TriggerCallError]]) -> TriggerAction {
        let (take wanted, take value) = take p
        Invoke(a, take wanted, take value, take to)
    })
}

pub fn trigger_boundary(ctx: TriggerContext) -> Result[(), TriggerCallError] waits {
    trigger_request(ctx, (), fn(a: triggers.Attempt, take p: (), take to: Sender[Result[(), TriggerCallError]]) -> TriggerAction {
        Boundary(a, take to)
    })
}

// A granted run reads the store through a read-only snapshot taken by the
// head after the release gate and the attempt fence. A fenced-out attempt
// gets StaleAttempt and never sees a snapshot.
pub fn trigger_snapshot(ctx: TriggerContext) -> Result[store.Snapshot, TriggerCallError] waits {
    trigger_request(ctx, (), fn(a: triggers.Attempt, take p: (), take to: Sender[Result[store.Snapshot, TriggerCallError]]) -> TriggerAction {
        Snap(a, take to)
    })
}

pub fn trigger_hold(ctx: TriggerContext, step_index: u64, take expected: Bytes, take actual: Bytes) -> Result[(), TriggerCallError] waits {
    trigger_request(ctx, (step_index, take expected, take actual), fn(a: triggers.Attempt, take p: (u64, Bytes, Bytes), take to: Sender[Result[(), TriggerCallError]]) -> TriggerAction {
        let (position, take wanted, take observed) = take p
        MarkHold(a, position, take wanted, take observed, take to)
    })
}

type GrantRequest[G: send]: send { ctx: TriggerContext, reply: Sender[Result[G, Capacity]] }
type GrantWorker[G: send, S: send]: send {
    grants: S,
    grant: fn(S, take TriggerContext) -> Result[G, Capacity] waits,
    inbox: Receiver[GrantRequest[G]],
}

fn supply_grants[G: send, S: send](take supply: GrantWorker[G, S]) -> () waits {
    // A grant callback may wait. Keep it off the head that serves its context.
    while let Ok(take request) = channel.receive(supply.inbox) {
        let GrantRequest(ctx: take ctx, reply: take reply) = take request
        let given = (supply.grant)(supply.grants, take ctx)
        let _ = channel.send(reply, take given)
    }
}

fn attempt_grants[G: send](to: Sender[GrantRequest[G]], take ctx: TriggerContext) -> Result[G, Outcome] waits {
    let (reply, inbox): (Sender[Result[G, Capacity]], Receiver[Result[G, Capacity]]) = channel.new(1u64)
    if let Error(_) = channel.send(to, GrantRequest(ctx: take ctx, reply: take reply)) {
        return Error(Failed(Gone))
    }
    match channel.receive(inbox) {
        Ok(Ok(take given)) => Ok(take given),
        Ok(Error(cap)) => Error(Failed(OutOfBytes(room(cap)))),
        Error(_) => Error(Failed(Gone)),
    }
}

type ArmedTimer { at: u64, task_handle: Task[()] }

type TriggerGrants[G: send] { to: Sender[GrantRequest[G]], worker: Task[()] }

type TriggerDrive[G: send] {
    tables: triggers.Tables,
    revision: Bytes,
    clock: Clock,
    tasks: Tasks,
    to: Sender[HeadInput],
    entries: triggers.Entries,
    author: Caller,
    grants: Option[TriggerGrants[G]],
    active: Map[triggers.Id, Task[Outcome]],
    timer: Option[ArmedTimer]
}

fn make_trigger_drive[G: send, S: send](mut db: store.Db, clock: Clock, tasks: Tasks, take to: Sender[HeadInput], revision: Bytes, take config: TriggerConfig[G, S]) -> Result[Box[TriggerDrive[G]], store.Error] {
    let tables = store.with_schema(mut db, code.describe(triggers.tables))?
    let stamp = copy_bytes(revision)?
    let TriggerConfig(entries: take entries, author: take author, grants: take seed, grant: grant, grant_bytes: allowance) = take config
    let (grants, inbox): (Sender[GrantRequest[G]], Receiver[GrantRequest[G]]) = channel.new(1u64)
    let supply = GrantWorker(grants: take seed, grant: grant, inbox: take inbox)
    let granting = task.spawn(tasks, bytes allowance, take supply, supply_grants)
    let drive = TriggerDrive(tables: take tables, revision: take stamp, clock: clock, tasks: tasks, to: take to,
        entries: take entries, author: take author, grants: Some(TriggerGrants(to: take grants, worker: take granting)), active: map.new(), timer: None)
    Ok(box.new(take drive))
}

fn open_trigger_drive[G: send, S: send](mut db: store.Db, clock: Clock, tasks: Tasks, take to: Sender[HeadInput], exported: List[Exported], n_place: u64, take config: Option[TriggerConfig[G, S]]) -> Result[Option[Box[TriggerDrive[G]]], store.Error] {
    if let Some(take configured) = take config {
        if !triggers.is_empty(configured.entries) {
            return Ok(Some(make_trigger_drive(mut db, clock, tasks, take to, trigger_stamp(exported, n_place)?, take configured)?))
        }
    }
    let snapshot = store.snapshot(db)
    let Some(_) = triggers.tables_for_settlement(store.snapshot_schema(snapshot), snapshot)? else { return Ok(None) }
    let tables = store.with_schema(mut db, code.describe(triggers.tables))?
    let drive: TriggerDrive[G] = TriggerDrive(tables: take tables, revision: trigger_stamp(exported, n_place)?, clock: clock, tasks: tasks, to: take to,
        entries: triggers.empty_entries(), author: store.Caller(issuer: 0u8, subject: list.new()), grants: None, active: map.new(), timer: None)
    Ok(Some(box.new(take drive)))
}

fn arm_trigger_timer[G: send](mut drive: Box[TriggerDrive[G]], at: u64) -> Result[(), store.Error] waits {
    let prior = replace(mut drive.timer, None)
    drive.timer = Some(arm_wall_timer(take prior, drive.tasks, drive.clock, drive.to, at))
    Ok(())
}

// One absolute wall-time wait: no wakeup before `at`. The head still samples
// wall time when TriggerWake arrives, before it starts a trigger.
fn arm_wall_timer(take prior: Option[ArmedTimer], tasks: Tasks, c: Clock, to: Sender[HeadInput], at: u64) -> ArmedTimer waits {
    if let Some(take armed) = take prior {
        if armed.at == at { return take armed }
        let ArmedTimer(at: _, task_handle: take running) = take armed
        let _ = task.cancel_join(take running)
    }
    let waiting = std.clock.wall_alarm(tasks, c, at, to, TriggerWake(at))
    ArmedTimer(at: at, task_handle: take waiting)
}

fn clear_trigger_timer[G: send, H: send](mut hd: Head[G, H], at: u64) -> () waits {
    let Some(take drive) = replace(mut hd.trigger_drive, None) else { return () }
    let mut owned = take drive
    let clear = match owned.timer { Some(armed) => armed.at == at, None => false }
    if clear {
        if let Some(ArmedTimer(at: _, task_handle: take elapsed)) = replace(mut owned.timer, None) {
            let _ = task.cancel_join(take elapsed)
        }
    }
    hd.trigger_drive = Some(take owned)
}

fn stop_triggers[G: send](take drive: Box[TriggerDrive[G]]) -> triggers.Tables waits {
    let TriggerDrive(tables: take tables, active: take active, timer: take timer, grants: take grants, ..) = box.unbox(take drive)
    if let Some(ArmedTimer(at: _, task_handle: take armed)) = take timer {
        let _ = task.cancel_join(take armed)
    }
    for take (_, take watcher) in take active {
        let _ = task.cancel_join(take watcher)
    }
    if let Some(TriggerGrants(worker: take grant_task, ..)) = take grants { let _ = task.cancel_join(take grant_task) }
    take tables
}

fn trigger_matches(p: triggers.Pending, entry: Described) -> bool {
    let matches_kind = match entry.kind {
        Granted => triggers.is_granted(p),
        Transact => !triggers.is_granted(p),
        _ => false,
    }
    matches_kind && triggers.matches(p, entry.identity, entry.args)
}

fn trigger_key[G: send, H: send](r: Registry[G, H], p: triggers.Pending, choices: triggers.Entries) -> Result[Option[(Bytes, u64)], store.Error] {
    if !triggers.is_allowed(p, choices) { return Ok(None) }
    for index in 0u64 .. list.len(r.exported) {
        let entry = view r.exported[index]
        if trigger_matches(p, entry.described) {
            return Ok(Some((entry_key(view entry.described.identity, entry.args_fp, entry.result_fp), index)))
        }
    }
    Ok(None)
}

fn trigger_store_error(take problem: triggers.Error) -> store.Error {
    match take problem {
        Store(take underlying) => take underlying,
        AttemptLimit => Limit(Transaction),
        _ => Missing("trigger"),
    }
}

fn trigger_commit[R](take ran: Result[store.Outcome[R, triggers.Error], store.Error]) -> Result[store.Done[R], store.Error] {
    match take ran {
        Ok(Committed(take committed)) => Ok(take committed),
        Ok(Aborted(store.Undone(value: take problem, ..))) => Error(trigger_store_error(take problem)),
        Ok(Refused(cap)) => Error(Full(cap)),
        Error(take problem) => Error(take problem),
        _ => Error(Missing("trigger commit")),
    }
}

fn publish_trigger[G: send, H: send](mut hd: Head[G, H], ticket: store.Ticket) -> Result[(), store.Error] waits {
    hd.last = Some(ticket)
    gate(mut hd)
}

type TriggerBodyError: send = Store(triggers.Error) | Terminal(triggers.Terminal) | NotDue

fn trigger_terminal(take outcome: Outcome) -> triggers.Terminal {
    match take outcome {
        Returned(take raw) => Returned(take raw),
        Failed(Raised(reason)) => Raised(reason),
        Failed(OutOfTime(steps)) => OutOfTime(steps),
        Failed(OutOfBytes(cap)) => OutOfBytes(cap.requested, cap.available),
        Refused(Budget(cap)) => OutOfBytes(cap.requested, cap.available),
        _ => Gone,
    }
}

fn run_trigger_transaction[G: send, H: send](mut hd: Head[G, H], mut drive: Box[TriggerDrive[G]], p: triggers.Pending, take key: Option[Bytes]) -> Result[bool, store.Error] waits {
    let completed = invoke_trigger_transaction(mut hd.db, hd.r, hd.h, drive, p, key)?
    let final = match take completed {
        TriggerApplied(ticket) => { publish_trigger(mut hd, ticket)?; return Ok(true) },
        TriggerSettled(take outcome) => take outcome,
        TriggerNotDue => { arm_trigger_timer(mut drive, triggers.due_time(p))?; return Ok(false) },
    }
    // The draft that returned an error or fault left no writes. Only this
    // settlement commits, and it consumes the row with the outcome.
    let collected = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.finish_transact(mut tx, drive.tables, p, final)
    })
    let committed = trigger_commit(take collected)?
    publish_trigger(mut hd, committed.ticket)?
    Ok(true)
}

type TriggerDraft = TriggerApplied(store.Ticket) | TriggerSettled(triggers.Terminal) | TriggerNotDue

fn invoke_trigger_transaction[G: send, H: send](mut db: store.Db, r: Registry[G, H], h: H, drive: Box[TriggerDrive[G]], p: triggers.Pending, key: Option[Bytes]) -> Result[TriggerDraft, store.Error] waits {
    let slot = match key { Some(wanted) => map.get(r.slots, wanted), None => None }
    let terminal: triggers.Terminal = if let Some(Transact(n, steps, _, _, go)) = slot {
        let ran = store.run(mut db, Some(steps), scoped fn(mut tx: store.Tx) -> Result[(), TriggerBodyError] {
            // The wall can move backwards between the scheduler's sample
            // and this transaction. The body sees this CallInfo, so use it.
            if store.info(mut tx).at < triggers.due_time(p) { return Error(NotDue) }
            let body = bound bytes n { go(mut tx, h, drive.author, triggers.argument(p)) }
            let terminal: triggers.Terminal = match take body {
                Ok(Commit(take payload)) => Returned(take payload),
                Ok(Abort(take payload)) => return Error(Terminal(Returned(take payload))),
                Ok(Exhausted(cap)) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
                Ok(Refuse(_)) => return Error(Terminal(Gone)),
                Error(cap) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
            }
            match triggers.finish_transact(mut tx, drive.tables, p, terminal) {
                Ok(()) => Ok(()),
                Error(take problem) => Error(Store(take problem)),
            }
        })
        match take ran {
            Ok(Committed(committed)) => return Ok(TriggerApplied(committed.ticket)),
            Ok(Aborted(store.Undone(value: Terminal(take terminal), ..))) => take terminal,
            Ok(Aborted(store.Undone(value: NotDue, ..))) => return Ok(TriggerNotDue),
            Ok(Aborted(store.Undone(value: Store(take problem), ..))) => return Error(trigger_store_error(take problem)),
            Ok(Failed(causes)) => Raised(raised(causes)),
            Ok(Stopped(limit)) => OutOfTime(limit.steps),
            Ok(Refused(cause)) => {
                let cap = store_capacity(cause)
                OutOfBytes(cap.requested, cap.available)
            },
            Error(take problem) => return Error(take problem),
        }
    } else { Gone }
    Ok(TriggerSettled(take terminal))
}

type TriggerReport: send { attempt: triggers.Attempt, to: Sender[HeadInput] }

type WireGrantReport: send { tick: Tick, to: Sender[WireEvent], clock: Clock, deadline: u64 }
type JobReport: send = Triggered(TriggerReport) | WireGrant(WireGrantReport)

type WatchedJob[G: send, A, R]: send {
    job: Job[G, A, R], report: JobReport, tasks: Tasks, allowance: u64
}

fn watch_granted[G: send, A, R](take watched: WatchedJob[G, A, R]) -> Outcome waits {
    let WatchedJob(job: take work, report: take report, tasks: tasks, allowance: n) = take watched
    let finished: Option[Outcome] = match task.spawn(tasks, bytes n, take work, adapt_granted) {
        take running => match task.join(take running) {
            Ok(take outcome) => Some(take outcome),
            Error(Failed(causes)) => Some(Failed(Raised(raised(causes)))),
            Error(Cancelled(_)) => None,
        },
    }
    match take report {
        Triggered(note) => { let _ = channel.send(note.to, TriggerDone(note.attempt, take finished)) },
        WireGrant(take note) => {
            let WireGrantReport(tick: take tick, to: take to, clock: clock, deadline: deadline) = take note
            let outcome: Outcome = if host.mono_ns(clock) >= deadline { Abandoned } else {
                match take finished { Some(take result) => take result, None => Abandoned }
            }
            let _ = channel.send(to, wire_event(GrantedDone(take tick, take outcome)))
        },
    }
    Abandoned
}

fn launch_trigger[G: send, H: send](r: Registry[G, H], mut drive: Box[TriggerDrive[G]], p: triggers.Pending, a: triggers.Attempt, key: Bytes) -> Result[(), Refusal] {
    let Some(Granted(bind)) = map.get(r.slots, key) else { return Error(NoEntry) }
    let go = bind().go
    let grant_to = match drive.grants {
        Some(grants) => channel.sender(grants.to),
        None => return Error(NoEntry),
    }
    map.reserve(mut drive.active, 1u64)
    let context = TriggerContext(attempt: a, to: channel.sender(drive.to))
    let source = FromPlace(take grant_to, take context)
    let raw: Bytes = match copy_bytes(triggers.argument(p)) {
        Ok(take payload) => take payload,
        Error(Full(cap)) => return Error(Budget(room(store_capacity(cap)))),
        Error(_) => return Error(NoEntry),
    }
    let notice = TriggerReport(attempt: a, to: channel.sender(drive.to))
    let copied: Caller = clone(drive.author)
    let caller = take copied
    match go(drive.tasks, take source, take caller, take raw, Some(Triggered(take notice))) {
        Ok(take watcher) => {
            map.insert(mut drive.active, triggers.run_id(a), take watcher)
            Ok(())
        },
        Error(cap) => Error(Budget(room(cap))),
    }
}

fn finish_trigger[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], a: triggers.Attempt, outcome: triggers.Terminal) -> Result[(), store.Error] waits {
    let settled = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.finish(mut tx, drive.tables, a, outcome)
    })
    match take settled {
        Ok(Aborted(store.Undone(value: StaleAttempt, ..))) => Ok(()),
        other => {
            let committed = trigger_commit(take other)?
            publish_trigger(mut hd, committed.ticket)
        },
    }
}

fn advance_trigger[G: send, H: send](mut hd: Head[G, H], mut drive: Box[TriggerDrive[G]]) -> Result[bool, store.Error] waits {
    let snapshot = store.snapshot(hd.db)
    let next = triggers.next_pending(snapshot, drive.tables, scoped fn(id: triggers.Id) -> bool { map.contains(drive.active, id) })?
    let Some(take p) = take next else { return Ok(false) }
    let due = triggers.due_time(p)
    if store.next_call_info(hd.db).at < due {
        arm_trigger_timer(mut drive, due)?
        return Ok(false)
    }
    if unreleased(hd) { gate(mut hd)? }
    if hd.cut { return Ok(false) }
    if triggers.cancelling(p) {
        let settled = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
            triggers.finish_cancel(mut tx, drive.tables, p)
        })
        let committed = trigger_commit(take settled)?
        publish_trigger(mut hd, committed.ticket)?
        return Ok(true)
    }
    let key = match trigger_key(hd.r, p, drive.entries)? {
        Some((take key, _)) => Some(take key),
        None => None,
    }
    if !triggers.is_granted(p) {
        return run_trigger_transaction(mut hd, mut drive, p, take key)
    }
    let ran = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[triggers.Started, triggers.Error] {
        triggers.start(mut tx, drive.tables, p, drive.revision)
    })
    let committed = match take ran {
        Ok(Aborted(store.Undone(value: NotDue, ..))) => {
            arm_trigger_timer(mut drive, due)?
            return Ok(false)
        },
        other => trigger_commit(take other)?,
    }
    publish_trigger(mut hd, committed.ticket)?
    if hd.cut { return Ok(false) }
    match committed.value {
        Held => (),
        Body(a) => {
            if let Some(wanted) = key {
                if let Error(take problem) = launch_trigger(hd.r, mut drive, p, a, wanted) {
                    finish_trigger(mut hd, drive, a, trigger_terminal(Refused(take problem)))?
                }
            } else { finish_trigger(mut hd, drive, a, Gone)? }
        },
    }
    Ok(true)
}

fn advance_triggers[G: send, H: send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    let Some(take selected) = replace(mut hd.trigger_drive, None) else { return Ok(false) }
    let mut drive = take selected
    let advanced = advance_trigger(mut hd, mut drive)
    hd.trigger_drive = Some(take drive)
    take advanced
}

fn trigger_done[G: send, H: send](mut hd: Head[G, H], a: triggers.Attempt, take outcome: Option[Outcome], closed: bool) -> Result[(), store.Error] waits {
    let Some(take selected) = replace(mut hd.trigger_drive, None) else { return Ok(()) }
    let mut drive = take selected
    let watched = map.remove(mut drive.active, triggers.run_id(a))
    let completed = if let Some(take watcher) = take watched {
        let _ = task.join(take watcher)
        if let Some(take result) = take outcome {
            if !closed { finish_trigger(mut hd, drive, a, trigger_terminal(take result)) } else { Ok(()) }
        } else { Ok(()) }
    } else { Ok(()) }
    hd.trigger_drive = Some(take drive)
    take completed
}

fn trigger_message[G: send, H: send](mut hd: Head[G, H], take pending: Box[TriggerInput], closed: bool) -> Result[(), store.Error] waits {
    let TriggerInput(action: take action) = box.unbox(take pending)
    let Some(take drive) = replace(mut hd.trigger_drive, None) else { return Ok(()) }
    let result = answer_trigger(mut hd, drive, take action, closed)
    hd.trigger_drive = Some(take drive)
    take result
}

fn checked_boundary(take seen: Result[bool, triggers.Error]) -> Result[(), TriggerCallError] {
    match take seen {
        Ok(false) => Ok(()),
        Ok(true) => Error(Cancelled),
        Error(Store(take problem)) => Error(Store(take problem)),
        Error(_) => Error(StaleAttempt),
    }
}

fn answer_trigger[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], take action: TriggerAction, closed: bool) -> Result[(), store.Error] waits {
    if unreleased(hd) { gate(mut hd)? }
    let stopped = closed || hd.cut
    match take action {
        Invoke(a, take key, take arg, take answer) => {
            let reply: Result[Outcome, TriggerCallError] =
                if stopped { Error(Closed) } else { trigger_effect(mut hd, drive.tables, drive.author, a, key, arg)? }
            let _ = channel.send(answer, take reply)
        },
        Boundary(a, take answer) => {
            let reply: Result[(), TriggerCallError] = if stopped { Error(Closed) } else {
                checked_boundary(triggers.boundary(store.snapshot(hd.db), drive.tables, a))
            }
            let _ = channel.send(answer, take reply)
        },
        MarkHold(a, position, take expected, take actual, take answer) => {
            let reply: Result[(), TriggerCallError] = if stopped { Error(Closed) } else {
                mark_trigger_hold(mut hd, drive, a, position, expected, actual)?
            }
            let _ = channel.send(answer, take reply)
        },
        Snap(a, take answer) => {
            let reply: Result[store.Snapshot, TriggerCallError] = if stopped { Error(Closed) } else {
                let seen = store.snapshot(hd.db)
                match checked_boundary(triggers.boundary(seen, drive.tables, a)) {
                    Ok(()) => Ok(seen),
                    Error(take problem) => Error(take problem),
                }
            }
            let _ = channel.send(answer, take reply)
        },
    }
    Ok(())
}

fn mark_trigger_hold[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], a: triggers.Attempt, position: u64, expected: Bytes, actual: Bytes) -> Result[Result[(), TriggerCallError], store.Error] waits {
    let written = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), TriggerCallError] {
        match triggers.hold(mut tx, drive.tables, a, position, expected, actual) {
            Ok(()) => Ok(()),
            Error(Store(take problem)) => Error(Store(take problem)),
            Error(CancelRequested) => Error(Cancelled),
            Error(_) => Error(StaleAttempt),
        }
    })
    match take written {
        Ok(Committed(done)) => { publish_trigger(mut hd, done.ticket)?; Ok(Ok(())) },
        Ok(Aborted(store.Undone(value: take problem, ..))) => Ok(Error(take problem)),
        Ok(Refused(cap)) => Ok(Error(Capacity(store_capacity(cap)))),
        Error(take problem) => Error(take problem),
        _ => Error(Missing("trigger hold")),
    }
}

fn trigger_effect[G: send, H: send](mut hd: Head[G, H], trigger_tables: triggers.Tables, author: Caller, a: triggers.Attempt, key: Bytes, arg: Bytes) -> Result[Result[Outcome, TriggerCallError], store.Error] waits {
    let invoked = apply_attempt(mut hd.db, hd.r, hd.h, trigger_tables, author, a, key, arg)
    match take invoked {
        Ok(Committed(store.Done(value: take value, ticket: ticket, ..))) => {
            publish_trigger(mut hd, ticket)?
            Ok(Ok(take value))
        },
        Ok(Aborted(store.Undone(value: BodyOutcome(take outcome), ..))) => Ok(Ok(take outcome)),
        Ok(Aborted(store.Undone(value: Refusal(take problem), ..))) => Ok(Error(take problem)),
        Ok(Failed(causes)) => Ok(Ok(Failed(Raised(raised(causes))))),
        Ok(Stopped(limit)) => Ok(Ok(Failed(OutOfTime(limit.steps)))),
        Ok(Refused(cap)) => Ok(Error(Capacity(store_capacity(cap)))),
        Error(take problem) => Error(take problem),
    }
}

// The W2 fixture calls the same release gate as trigger_message. It owns the
// database and reads the volatile head separately from the answer.
pub fn journal_attempt_gate(take db: store.Db, take registered: Registry[(), ()], t: triggers.Tables, a: triggers.Attempt, key: Bytes, arg: Bytes)
    -> (store.Db, u64, Result[Result[Outcome, TriggerCallError], store.Error]) waits {
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(2u64)
    let mut head = Head(db: take db, r: take registered, replay_identity: list.new(), h: (), out: take to,
        busy: map.new(), waiting: list.new(), group: list.new(), last: None, held: list.new(), wakes: false, minted: 0u64, cut: false, trigger_drive: None)
    let response = trigger_effect(mut head, t, store.Caller(issuer: 0u8, subject: list.new()), a, key, arg)
    let at = store.version(store.snapshot(head.db))
    let Head(db: take kept, ..) = take head
    let _ = take from
    (take kept, at, take response)
}

pub fn apply_attempt[G: send, H: send](mut db: store.Db, registered: Registry[G, H], h: H, trigger_tables: triggers.Tables, author: Caller, a: triggers.Attempt, key: Bytes, arg: Bytes) -> Result[store.Outcome[Outcome, FencedRefusal], store.Error] waits {
    let slot = map.get(registered.slots, key)
    let steps = match slot { Some(Transact(_, limit, _, _, _)) => Some(limit), Some(Fenced(_, limit, _)) => Some(limit), _ => None }
    store.run(mut db, steps, scoped fn(mut tx: store.Tx) -> Result[Outcome, FencedRefusal] {
        match triggers.fence(tx, trigger_tables, a) {
            Ok(false) => (),
            Ok(true) => return Error(Refusal(Cancelled)),
            Error(StaleAttempt) => return Error(Refusal(StaleAttempt)),
            Error(Store(take problem)) => return Error(Refusal(Store(take problem))),
            Error(_) => return Error(Refusal(StaleAttempt)),
        }
        if let Some(Fenced(n, _, go)) = slot {
            let ran = bound bytes n { go(mut tx, a, arg) }
            return match take ran {
                Ok(Ok(take payload)) => Ok(Returned(take payload)),
                Ok(Error(take problem)) => Error(Refusal(Store(take problem))),
                Error(cap) => Error(Refusal(Capacity(cap))),
            }
        }
        if let Some(Transact(n, _, _, _, go)) = slot {
            let ran = bound bytes n { go(mut tx, h, author, arg) }
            match take ran {
                Ok(Commit(take payload)) => Ok(Returned(take payload)),
                Ok(Abort(take payload)) => Error(BodyOutcome(Returned(take payload))),
                Ok(Refuse(take refusal)) => Error(BodyOutcome(Refused(take refusal))),
                Ok(Exhausted(cap)) => Error(BodyOutcome(Failed(OutOfBytes(room(cap))))),
                Error(cap) => Error(BodyOutcome(Failed(OutOfBytes(room(cap))))),
            }
        } else { Error(BodyOutcome(Refused(NoEntry))) }
    })
}

// ---- The publisher, on its one inbox. A Release with a snapshot runs one G2 round to it
// and moves the base there. Each owner's diff or Reset travels with all its
// owed answers in one update (G1). A Release without a snapshot carries commitless
// answers at the base (V3). A Subscribe runs at the base (G3), in its place among Releases.
//
// The publisher never blocks on a session (L23): every send to an owner is a try_send. A
// closed inbox drops that session's subs. A full one marks each live sub whose content did
// not fit due for repair (§3 "Repair"), with no Ended and no Reset: `due` says some sub of
// the session is due. On the owner's progress the publisher reruns each due sub at its base
// and sends its whole image as a `complete`. A bounced Ended (or Reset) and bounced answers
// wait until the inbox takes them, retried at the current base with any new content.
// `ended_at` is the oldest computation version among `ended` (u64::MAX when empty): a waiting
// Ended keeps the version it was computed at when it is folded into later content.
// v2.22: `handed` counts the `complete`s the owner's inbox took, and `taken` is the owner's
// count of those it no longer holds unsent; a due session is repaired only when they agree.
type Joiner { who: u64, to: Sender[WireEvent], closed: Option[Receiver[()]], ended: List[(u32, u64, Outcome)], ended_at: u64, reset: bool, mark: Option[Receiver[()]], identity: Option[Latest[OwnerNumber]], fence: Option[FenceSet], due: bool, progress: Option[Receiver[()]], progressed: bool, taken: Option[Latest[Taken]], handed: u64 }

// One try_send to an owner: taken, bounced back by a full inbox, or shut.
type Offered = Took | Bounced(Notice) | Shut

fn offer(to: Sender[WireEvent], take e: Notice) -> Offered {
    match channel.try_send(to, wire_event(FromRunner(take e))) {
        Ok(()) => Took,
        Error(Full(WireEvent(e: FromRunner(take back)))) => Bounced(take back),
        _ => Shut,
    }
}

fn publisher[G: send, H: send](take r: Registry[G, H], take h: H, take base: store.Snapshot, take from: Receiver[PubIn], take register: RoundRegister) -> () waits {
    let mut at = store.version(base)
    let mut b = Board(r: take r, h: take h, base: take base, newest: None, subs: subscriptions())
    let mut joined: List[Joiner] = list.new()
    let mut waiting: List[Replies] = list.new()
    let mut minted = 0u64
    // Declared last, so a trap cleans it first (FAIL-8): R = u64::MAX is published before any
    // owner channel or the inbox closes.
    let mut rounds = take register
    fence_round(mut joined, Fenced(sessions: list.new(), all: false), at, mut rounds)
    // A message taken while coalescing Releases, handled next in inbox order.
    let mut held: Option[PubIn] = None
    loop {
        let got = match replace(mut held, None) {
            Some(take x) => take x,
            None => match channel.receive(from) {
                Ok(take x) => take x,
                Error(_) => return,
            },
        }
        let PubIn(e: take e) = take got
        let mut owes: List[Owe] = list.new()
        match take e {
            Halt => {
                round_disarm(take rounds)
                return
            },
            Released(take rel) => {
                let Release(version: v, snapshot: take snap, answers: take answers) = take rel
                keep_answers(mut waiting, take answers)
                let mut newest = take snap
                let mut newest_at = v
                // G1: drain the Releases queued behind this one, in order, and run one round at
                // the newest snapshot, so a slow publisher coalesces. Every Release's answers are
                // kept. A Drained carries nothing but the pass below, so it joins the run; any
                // other message ends it and is handled next.
                loop {
                    match channel.try_receive(from) {
                        Ok(PubIn(e: Released(take more))) => {
                            let Release(version: mv, snapshot: take ms, answers: take ma) = take more
                            keep_answers(mut waiting, take ma)
                            if let Some(take s) = take ms {
                                newest = Some(take s)
                                newest_at = mv
                            }
                        },
                        Ok(PubIn(e: Drained)) => (),
                        Ok(take other) => { held = Some(take other); break },
                        Error(_) => break,
                    }
                }
                if let Some(take s) = take newest {
                    at = newest_at
                    b.newest = Some(take s)
                    let mut fenced = Fenced(sessions: list.new(), all: false)
                    owes = round(mut b, mut fenced)
                    // G2 step 3: every fence of the round, then R, before anything is offered.
                    fence_round(mut joined, take fenced, newest_at, mut rounds)
                }
            },
            Joined(take j) => {
                let Join(to: take to, told: take told, mark: take mark, closed: take closed, identity: take id, fence: take fence, progress: take progress, taken: take taken, first: take first) = take j
                let wake: Option[Sender[WireEvent]] = match closed { Some(_) => Some(channel.sender(to)), _ => None }
                // A fenced session's Arcs are reserved here (§3 "Admission"); a refusal answers id 0.
                let reserved: Result[Option[FenceSet], Capacity] = match take fence {
                    Some(take root) => match fence_reserve(mut rounds, take root) { Ok(take fences) => Ok(Some(take fences)), Error(c) => Error(c) },
                    None => Ok(None),
                }
                match take reserved {
                    Ok(take fences) => {
                        minted += 1u64
                        list.push(mut joined, Joiner(who: minted, to: take to, closed: take closed, ended: list.new(), ended_at: ROUND_HALTED, reset: false, mark: take mark, identity: take id, fence: take fences, due: false, progress: take progress, progressed: false, taken: take taken, handed: 0u64))
                        let _ = channel.try_send(told, Admit(who: minted, round: latest.handle(rounds.round)))
                        // v2.22: the Subscribe that made the owner join, at this base (G3).
                        if let Some(take f) = take first {
                            let JoinSubscribe(sub: sub, generation: generation, input: take input) = take f
                            publish_wire_subscription(mut b, mut joined, mut owes, minted, sub, generation, take input)
                        }
                    },
                    Error(_) => { let _ = channel.try_send(told, Admit(who: 0u64, round: latest.handle(rounds.round))) },
                }
                if let Some(sender) = wake { let _ = channel.try_send(sender, wire_event(JoinReady)) }
            },
            Subscribed(who, sub, take caller, take key, take arg) =>
                publish_wire_subscription(mut b, mut joined, mut owes, who, sub, 0u64, SubscriptionInput(room: None, key: take key, arg: take arg, caller: take caller)),
            WireSubscribed(who, sub, generation, take input) =>
                publish_wire_subscription(mut b, mut joined, mut owes, who, sub, generation, take input),
            Unsubscribed(who, sub) => { let _ = remove_sub(mut b.subs, who, sub) },
            Left(who) => forget(mut b.subs, mut joined, who),
            // An owner made room (v2.13), or a marked session ended (v2.14): the sweep and the
            // retry below are the whole of it.
            Drained => (),
        }
        sweep(mut b.subs, mut joined)
        repair(mut b, mut joined, mut owes)
        settle(mut b.subs, mut joined, mut waiting, take owes, at)
    }
}

// The sessions a round's read-set hits fence: each named session, or every joined session
// when the round could not tell which (a lost diff resets them all).
type Fenced { sessions: List[u64], all: bool }

// G2 step 3 (§3 "The release check"): publish every fence of round b, then R = b, each from
// its reservation. A publisher that cannot is stopped, which publishes R = u64::MAX as it is
// cleaned (RoundRegister), and the head ends the place when its next Release is refused.
fn fence_round(mut joined: List[Joiner], take fenced: Fenced, b: u64, mut rounds: RoundRegister) {
    let Fenced(sessions: take sessions, all: all) = take fenced
    let mut i = 0u64
    while i < list.len(joined) {
        if all || list.contains(sessions, joined[i].who) {
            if let Some(take held) = replace(mut joined[i].fence, None) {
                let mut fences = take held
                let published = fence_advance(mut fences, b)
                joined[i].fence = Some(take fences)
                if !published { fail("release check: no fence Arc for the round") }
            }
        }
        i += 1u64
    }
    if !round_advance(mut rounds, b, list.len(joined)) { fail("release check: no round Arc for the round") }
}

fn publish_wire_subscription[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], mut owes: List[Owe], who: u64, sub: u32, generation: u64, take input: SubscriptionInput) {
    if let Some(i) = joiner(joined, who) {
        unend(mut joined[i].ended, sub)
        list.push(mut owes, at_base_generation(mut b, who, sub, generation, take input))
    }
}

fn reply_bucket(waiting: List[Replies], owner: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(waiting) {
        if waiting[i].recipient.owner == owner {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn keep_answers(mut waiting: List[Replies], take answers: List[Answer]) {
    for take a in answers {
        let Answer(recipient: take recipient, row: take row) = take a
        match reply_bucket(waiting, recipient.owner) {
            Some(i) => list.push(mut waiting[i].rows, take row),
            None => {
                let mut rows: List[KeyedDone] = list.new()
                list.push(mut rows, take row)
                list.push(mut waiting, Replies(recipient: take recipient, rows: take rows))
            },
        }
    }
}

// A resubscribed sub's waiting Ended is moot: the new Subscribe's Batch replaces it.
fn unend(mut ended: List[(u32, u64, Outcome)], sub: u32) {
    let mut i = 0u64
    while i < list.len(ended) {
        if ended[i].0 == sub {
            let _ = list.remove(mut ended, i)
        } else {
            i += 1u64
        }
    }
}

// Fold the ledger and this round into the same attempt as the owner's pending outcomes.
fn settle(mut subs: Subscriptions, mut joined: List[Joiner], mut waiting: List[Replies], take owes: List[Owe], at: u64) {
    let mut contents = take owes
    // There is one entry per owner. The joined list walks increasing owner numbers.
    list.sort(mut contents, scoped fn(a: Owe, b: Owe) -> Order { std.order.compare(a.session, b.session) })
    let mut content_index = 0u64
    let mut bounced: List[Replies] = list.new()
    let mut i = 0u64
    while i < list.len(joined) {
        let who = joined[i].who
        let closed = match joined[i].closed { Some(from) => match channel.try_receive(from) { Ok(()) => true, _ => false }, _ => false }
        if closed {
            forget(mut subs, mut joined, who)
            continue
        }
        let owner = match joined[i].identity { Some(id) => latest.read(id).number, None => 0u64 }
        let empty = Owe(session: who, version: at, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false)
        while content_index < list.len(contents) && contents[content_index].session < who {
            content_index += 1u64
        }
        let mut next = if content_index < list.len(contents) && contents[content_index].session == who {
            let found = list.set(mut contents, content_index, take empty)
            content_index += 1u64
            take found
        } else {
            take empty
        }
        let old = replace(mut joined[i].ended, list.new())
        let old_at = joined[i].ended_at
        joined[i].ended_at = ROUND_HALTED
        if joined[i].reset || next.reset {
            let _ = replace(mut next.generations, list.new())
            let _ = replace(mut next.complete, list.new())
            let _ = replace(mut next.rows, list.new())
            let _ = replace(mut next.ended, list.new())
            next.reset = true
            end_session(mut subs, who)
            joined[i].due = false
        } else if list.len(old) > 0u64 {
            // A unit is checked at its oldest component (§3).
            if old_at < next.version { next.version = old_at }
            let now = replace(mut next.ended, take old)
            for take ended in now {
                list.push(mut next.ended, take ended)
            }
        }
        joined[i].reset = false
        let (take recipient, take rows) = match reply_bucket(waiting, owner) {
            Some(k) => {
                let Replies(recipient: take r, rows: take rows) = list.remove(mut waiting, k)
                (Some(take r), take rows)
            },
            None => (None, list.new()),
        }
        let has_content = next.reset || list.len(next.complete) > 0u64 || list.len(next.rows) > 0u64 || list.len(next.ended) > 0u64
        if !has_content && list.len(rows) == 0u64 {
            i += 1u64
            continue
        }
        let handing = list.len(next.complete)
        let content = if has_content { Some(take next) } else { None }
        match offer(joined[i].to, update(at, take content, take rows)) {
            Took => { joined[i].handed += handing },
            Shut => {
                forget(mut subs, mut joined, who)
                continue
            },
            Bounced(Notice(e: Updated(Update(version: _, content: take back, outcomes: take outcomes)))) => {
                if let Some(take r) = take recipient {
                    list.push(mut bounced, Replies(recipient: take r, rows: take outcomes))
                }
                if let Some(take o) = take back {
                    overloaded(mut subs, mut joined[i], take o)
                }
            },
            _ => (),
        }
        i += 1u64
    }
    let retry = replace(mut waiting, take bounced)
    for take bucket in retry {
        let Replies(recipient: take recipient, rows: take rows) = take bucket
        if let Bounced(Notice(e: Updated(Update(version: _, content: _, outcomes: take back)))) = offer(recipient.to, update(at, None, take rows)) {
            list.push(mut waiting, Replies(recipient: take recipient, rows: take back))
        }
    }
}

// A full inbox bounced this content: a Reset waits and covers it all; otherwise each live sub
// it named (complete or a row) is due for repair (§3 "Repair") and its Ended subs wait.
fn overloaded(mut subs: Subscriptions, mut j: Joiner, take o: Owe) {
    let Owe(session: who, version: computed, generations: _, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    // A token taken before this bounce never counts after it (§3 "Repair").
    j.progressed = false
    if reset || j.reset {
        j.reset = true
        j.ended = list.new()
        j.ended_at = ROUND_HALTED
        return
    }
    for sub in complete {
        if mark_due(mut subs, who, sub) { j.due = true }
    }
    for r in rows {
        if mark_due(mut subs, who, r.sub) { j.due = true }
    }
    if list.len(ended) == 0u64 { return }
    if computed < j.ended_at { j.ended_at = computed }
    for take x in ended {
        list.push(mut j.ended, take x)
    }
}

// §3 "Repair", before the offers of each pass: every owner's drain token is taken, so a token
// sent before a bounce never counts after it. A due session that progressed (or has no token
// channel) reruns each due sub at the base, with its generation and input, into its owe as a
// complete. Removing the sub drops its old read set: any commit since that read set's run
// that hit it has fenced the session, and if none did the rerun reads the same keys.
fn repair[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], mut owes: List[Owe]) {
    let at = store.version(b.base)
    let mut i = 0u64
    while i < list.len(joined) {
        let took = match joined[i].progress {
            Some(from) => match channel.try_receive(from) { Ok(()) => true, _ => false },
            None => true,
        }
        if took { joined[i].progressed = true }
        if joined[i].due && joined[i].progressed && !joined[i].reset && caught_up(joined[i]) {
            joined[i].due = false
            joined[i].progressed = false
            let who = joined[i].who
            for sub in due_subs(b.subs, who) {
                let Some(take old) = remove_sub(mut b.subs, who, sub) else { continue }
                let Sub(generation: generation, input: take input, cover: _, routes: _, due: _) = take old
                let fresh = at_base_generation(mut b, who, sub, generation, take input)
                let k = owe(mut owes, who, at)
                merge_owe(mut owes[k], take fresh)
            }
        }
        i += 1u64
    }
}

// v2.22 (§3 "Repair"): the owner holds no `complete` it took and has not sent. A session with
// no taken register (the HTTP and one-shot sessions) is always caught up.
fn caught_up(j: Joiner) -> bool {
    match j.taken { Some(t) => latest.read(t).n >= j.handed, None => true }
}

fn merge_owe(mut into: Owe, take from: Owe) {
    let Owe(session: _, version: v, generations: take generations, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take from
    if v < into.version { into.version = v }
    if reset { into.reset = true }
    for g in generations { list.push(mut into.generations, g) }
    for sub in complete { list.push(mut into.complete, sub) }
    for take r in rows { list.push(mut into.rows, take r) }
    for take e in ended { list.push(mut into.ended, take e) }
}

fn joiner(joined: List[Joiner], who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(joined) {
        if joined[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

// v2.14: after every message but Halt, in join order, a marked session whose mark answers
// Closed has ended, and is retired: its subscriptions, its ledger and mark (in its Joiner)
// go. The retry pass that follows drops its waiting replies, whose inbox is closed (Shut).
fn sweep(mut subs: Subscriptions, mut joined: List[Joiner]) {
    let mut i = 0u64
    while i < list.len(joined) {
        let ended = match joined[i].mark {
            Some(m) => match channel.try_receive(m) {
                Error(Closed) => true,
                _ => false,
            },
            None => false,
        }
        if ended {
            let who = joined[i].who
            forget(mut subs, mut joined, who)
        } else {
            i += 1u64
        }
    }
}

fn forget_subs(mut subs: Subscriptions, who: u64) {
    if let Some(take group) = map.remove(mut subs.by_session, who) {
        for (_, sub) in group { unregister_routes(mut subs.root, sub.routes) }
    }
}

fn forget(mut subs: Subscriptions, mut joined: List[Joiner], who: u64) {
    forget_subs(mut subs, who)
    if let Some(j) = joiner(joined, who) {
        let _ = list.remove(mut joined, j)
    }
}

// ---- §3: publisher delivery to the wire owner.

// One publisher update carries the owner's forwarded positions and subscription content.
type Update: send { version: u64, content: Option[Owe], outcomes: List[KeyedDone] }

fn update(at: u64, take content: Option[Owe], take outcomes: List[KeyedDone]) -> Notice {
    Notice(e: Updated(Update(version: at, content: take content, outcomes: take outcomes)))
}

pub fn head_request(take author: Caller, take stream: Bytes, p: u64, take key: Bytes, take arg: Bytes, take reply_to: Sender[WireEvent]) -> Req {
    let digest = store.request_digest(key, arg)
    let alive = arc.new(HeadLife(active: true))
    let live = latest.new(take alive)
    let blank = arc.new(OwnerNumber(number: 0u64))
    let identity = latest.new(take blank)
    let seed = arc.new(OwnerNumber(number: 0u64))
    Req(e: Requested(Request(caller: take author, stream: take stream, p: p, key: take key, arg: take arg, digest: digest,
        deadline: 18446744073709551615u64, reply_to: take reply_to, live: take live, identity: take identity, seed: Some(take seed))))
}

pub fn head_outcome(take event: WireEvent) -> Option[KeyedDone] {
    let WireEvent(e: take input) = take event
    let FromRunner(Notice(e: take notice)) = take input else { return None }
    match take notice {
        Updated(Update(outcomes: take outcomes, ..)) if list.len(outcomes) == 1u64 => {
            let mut rows = take outcomes
            Some(list.remove(mut rows, 0u64))
        },
        _ => None,
    }
}

// What a session hands its client, before the wire Frame (WIRE-SPEC §3): the Frame's Batch,
// Ended and Reset with each answered send named by the store's stream key, until R3 gives
// sessions stream slots. A KeyedBatch at `version` names in `complete` each sub whose whole
// initial result it carries (F11), and carries the wire's subscription Rows (F10: the
// data-tree key and the published value at `version`, None for a removal) and KeyedDone
// rows, one per send answered.
pub type KeyedDone: send { stream: Bytes, p: u64, outcome: Outcome }

pub type KeyedBatch: send { version: u64, complete: List[u32], rows: List[Row], outcomes: List[KeyedDone] }

pub type Down: send = Batched(KeyedBatch) | Ended(u32, Outcome) | KeyedReset(u64, List[KeyedDone])

pub opaque type Tick: send { stream: Bytes, p: u64, generation: u64 }

// The wire owner receives publisher answers, subscription content and deadline timers
// through the same WireEvent inbox as its reader and writer.
type PublisherEvent: send = Updated(Update) | Expired(Tick)

type HeadLife: shareable + send { active: bool }

// Only the head assigns a number. The publisher and every subscription join can
// read the same number, including after a wire Reset replaced its Joiner.
type OwnerNumber: shareable + send { number: u64 }

resource type HeadLease: send { head: WireHead, live: Latest[HeadLife], dead: Arc[HeadLife], identity: Latest[OwnerNumber] } drop(lease) {
    latest.publish(lease.live, arc.share(lease.dead))
    if latest.read(lease.identity).number != 0u64 {
        let _ = try_head(lease.head, Req(e: OwnerLeft))
    }
}

fn head_lease(take head: WireHead) -> Result[HeadLease, Capacity] {
    let alive = arc.new(HeadLife(active: true))
    let dead = arc.new(HeadLife(active: false))
    let live = latest.new(take alive)
    let blank = arc.new(OwnerNumber(number: 0u64))
    let identity = latest.new(take blank)
    Ok(HeadLease(head: take head, live: take live, dead: take dead, identity: take identity) ?=> |(c, _)| c)
}

fn owner_seed(lease: HeadLease) -> Result[Option[Arc[OwnerNumber]], Capacity] {
    if latest.read(lease.identity).number != 0u64 {
        return Ok(None)
    }
    let blank = arc.new(OwnerNumber(number: 0u64))
    Ok(Some(take blank))
}

pub opaque type Notice: send { e: PublisherEvent }

// v2.14: a marked session's joiner. A failed or cancelled session skipped its own end, so
// whatever the outcome, the joiner offers the publisher one Drained, never waiting.
pub fn join_marked[R: send](take t: Task[R], to_publisher: Sender[PubIn]) -> Result[R, JoinError] waits {
    let got = task.join(take t)
    let _ = channel.try_send(to_publisher, PubIn(e: Drained))
    got
}

fn slot_key(stream: Bytes, p: u64) -> Bytes {
    let mut k: Bytes = list.with_capacity(list.len(stream) + 8u64)
    list.append(mut k, stream)
    std.codec.put_u64(p, mut k)
    k
}

// The publisher's content for this session: one Batch with its complete subs and rows (G3:
// a sub's whole initial result in the Batch that names it), then its Ended subs; or a Reset.
// `dropped` holds the subs whose Unsubscribe met a full PubIn (v2.12 item 3): the publisher
// keeps them, and the owner drops their rows and Endeds until a Batch completes the sub's
// resubscription, an Ended ends it, or a Reset ends them all.
fn hand(to: Sender[Down], take o: Owe, mut dropped: List[u32], take outcomes: List[KeyedDone]) -> () waits {
    let Owe(session: _, version: v, generations: _, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    if reset {
        list.clear(mut dropped)
        let _ = channel.send(to, KeyedReset(v, take outcomes))
        return
    }
    for sub in complete {
        forgive(mut dropped, sub)
    }
    let heard = unheard(take rows, dropped)
    if list.len(complete) > 0u64 || list.len(heard) > 0u64 || list.len(outcomes) > 0u64 {
        let _ = channel.send(to, Batched(KeyedBatch(version: v, complete: take complete, rows: take heard, outcomes: take outcomes)))
    }
    for take e in take ended {
        let (sub, _, take why) = take e
        if has_sub(dropped, sub) {
            forgive(mut dropped, sub)
        } else {
            let _ = channel.send(to, Ended(sub, take why))
        }
    }
}

fn has_sub(subs: List[u32], sub: u32) -> bool {
    for s in subs {
        if s == sub {
            return true
        }
    }
    false
}

fn forgive(mut dropped: List[u32], sub: u32) {
    let mut i = 0u64
    while i < list.len(dropped) {
        if dropped[i] == sub {
            let _ = list.remove(mut dropped, i)
        } else {
            i += 1u64
        }
    }
}

// The rows of subs not in `dropped`.
fn unheard(take rows: List[Row], dropped: List[u32]) -> List[Row] {
    if list.len(dropped) == 0u64 {
        return take rows
    }
    let mut kept: List[Row] = list.new()
    for take w in take rows {
        if !has_sub(dropped, w.sub) {
            list.push(mut kept, take w)
        }
    }
    kept
}

fn word(v: u8) -> Bytes {
    let mut out: Bytes = list.new()
    list.push(mut out, v)
    for _ in 0u64 .. 7u64 {
        list.push(mut out, 0u8)
    }
    out
}

fn set(mut db: store.Db, t: store.Table[u64, u64], k: u64, v: u64) -> () waits {
    let done = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, t, k, v)
    })
    match take done {
        Ok(Committed(_)) => (),
        _ => fail("subs: a fixture put"),
    }
}

type Cached { who: u64, sub: u32, rows: Map[Bytes, Bytes] }

type Client { caches: List[Cached], last: List[(u64, u64)] }

fn cached(c: Client, who: u64, sub: u32) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who && c.caches[i].sub == sub {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn drop_cache(mut c: Client, who: u64, sub: u32) {
    if let Some(i) = cached(c, who, sub) {
        let _ = list.remove(mut c.caches, i)
    }
}

// The client's side of one owe: versions never decrease (K2); a complete sub starts its cache
// empty; a row for a sub with no cache is a row before its complete (L17).
fn apply(mut c: Client, take o: Owe) -> bool {
    let mut seen = false
    let mut i = 0u64
    while i < list.len(c.last) {
        if c.last[i].0 == o.session {
            if o.version < c.last[i].1 {
                return false
            }
            c.last[i].1 = o.version
            seen = true
        }
        i += 1u64
    }
    if !seen {
        list.push(mut c.last, (o.session, o.version))
    }
    if o.reset {
        while let Some(j) = first_of(c, o.session) {
            let _ = list.remove(mut c.caches, j)
        }
        return true
    }
    for sub in o.complete {
        drop_cache(mut c, o.session, sub)
        list.push(mut c.caches, Cached(who: o.session, sub: sub, rows: map.new()))
    }
    let Owe(session: who, version: _, generations: _, complete: _, rows: take rows, ended: take ended, reset: _) = take o
    for take row in rows {
        let Row(sub: sub, key: take key, value: take value) = take row
        let k = match cached(c, who, sub) {
            Some(k) => k,
            None => return false,
        }
        let _ = map.remove(mut c.caches[k].rows, key)
        if let Some(take v) = take value {
            map.insert(mut c.caches[k].rows, take key, take v)
        }
    }
    for e in ended {
        drop_cache(mut c, who, e.0)
    }
    true
}

fn first_of(c: Client, who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

// The cache of (who, sub) holds exactly row0 and row1 (keys[1], keys[2]) with these values;
// None leaves a row out.
fn holds(c: Client, keys: List[Bytes], who: u64, sub: u32, row0: Option[u8], row1: Option[u8]) -> bool {
    let k = match cached(c, who, sub) {
        Some(k) => k,
        None => return false,
    }
    let rows = c.caches[k].rows
    let mut n = 0u64
    if let Some(v) = row0 {
        n += 1u64
        match map.get(rows, keys[1]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    if let Some(v) = row1 {
        n += 1u64
        match map.get(rows, keys[2]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    map.len(rows) == n
}

fn step[G: send, H: send](mut b: Board[G, H], db: store.Db) -> List[Owe] {
    b.newest = Some(store.snapshot(db))
    let mut fenced = Fenced(sessions: list.new(), all: false)
    round(mut b, mut fenced)
}

fn join_with(to: Sender[PubIn], take ev: Sender[WireEvent], take mark: Option[Receiver[()]], take progress: Option[Receiver[()]]) -> u64 waits {
    let (told, hear): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: take ev, told: take told, mark: take mark, closed: None, identity: None, fence: None, progress: take progress, taken: None, first: None)))) {
        return 0u64
    }
    match channel.receive(hear) {
        Ok(a) => a.who,
        Error(_) => 0u64,
    }
}

fn none[T](x: Option[T]) -> bool {
    match x {
        Some(_) => false,
        None => true,
    }
}

// The Drained messages `from` holds now; any other message counts as many.
fn drained(from: Receiver[PubIn]) -> u64 {
    let mut n = 0u64
    while let Ok(take x) = channel.try_receive(from) {
        let PubIn(e: take e) = take x
        n += match take e {
            Drained => 1u64,
            _ => 1000u64,
        }
    }
    n
}

type New { balance: u64, bonus: u64 }

pub const WIRE_OWNER_LIMIT: u64 = 10000u64
pub const WIRE_OWNER_FLOOR: u64 = 65536u64
const WIRE_OWNER_TASK_BYTES: u64 = 320u64
const WIRE_OVERHEAD: u64 = 67108864u64
const WIRE_SESSION_CEILING: u64 = 16777216u64
pub const WIRE_POOL_BYTES: u64 = 384u64 * 1024u64 * 1024u64
pub type WireConfig: send { n_pool: u64, n_granted: u64, max_subs: u64, socket: std.wsock.Config, q: u64, budget: u64, n_service: u64, site: Option[std.wsock.Site] }

pub fn wire_defaults(n_service: u64) -> WireConfig {
    WireConfig(n_pool: WIRE_POOL_BYTES, n_granted: 0u64, max_subs: 128u64, socket: std.wsock.defaults(), q: 4, budget: 1048576, n_service: n_service, site: None)
}

fn wire_round(n: u64) -> u64 { (n + 7u64) & 0xfffffffffffffff8u64 }

// The reader child's own state, plus its receive loan (std.wsock.refill's 8192
// bytes) and, while settle copies the unread tail out of that loan, the tail's
// storage of at most 8192 bytes more (§3, Reader child).
const WSOCK_LOAN: u64 = 8192u64
pub fn reader_bytes() -> u64 { 4096u64 + 2u64 * WSOCK_LOAN }

fn wire_outcome_reserve(c: WireConfig) -> u64 {
    (1u64 + c.q) * (DONE_MAX + 36u64)
}

fn wire_service_job_bytes(c: WireConfig) -> u64 {
    c.n_service + 6u64 * c.socket.max_frame + 32768u64
}

fn wire_variable_peak(c: WireConfig) -> u64 {
    let m = c.socket.max_frame
    let units = 1u64 + c.q
    // Read credits bound typed inbox/deferred values. Head positions retain
    // a key and argument each, both at most one frame, plus stream and caller.
    let input = units * (4u64 * m + 128u64) + units * (2u64 * m + 256u64)
    let transport = wire_round(3u64 * m / 2u64) + 2u64 * wire_round(m + 14u64)
    let retained = 4u64 * m + 2u64 * c.budget + wire_outcome_reserve(c)
    input + transport + retained + wire_service_job_bytes(c) + 32768u64
}

fn wire_configuration(c: WireConfig) -> bool { none(wire_problem(c, launch_target_bytes().size)) }

fn exceeds(name: String, value: u64, limit: u64) -> Option[StartError] {
    Some(Exceeds(Bound(name: clone(name), value: value, limit: limit)))
}

fn session_problem(c: WireConfig, max_sessions: u64, target_size: u64) -> Option[StartError] {
    if max_sessions == 0u64 { return Some(Missing("max_sessions")) }
    if max_sessions > WIRE_OWNER_LIMIT { return exceeds("max_sessions", max_sessions, WIRE_OWNER_LIMIT) }
    wire_problem(c, target_size)
}

// The first WireConfig setting a session cannot run with. The place's one Registry is
// the serving task's (serving_bytes), not a session's.
fn wire_problem(c: WireConfig, target_size: u64) -> Option[StartError] {
    if c.q > 4u64 { return exceeds("q", c.q, 4u64) }
    if c.socket.max_frame > 262144u64 { return exceeds("socket.max_frame", c.socket.max_frame, 262144u64) }
    if c.socket.pending_max > 1024u64 { return exceeds("socket.pending_max", c.socket.pending_max, 1024u64) }
    if c.budget > 1048576u64 { return exceeds("budget", c.budget, 1048576u64) }
    if c.max_subs == 0u64 { return Some(Missing("max_subs")) }
    if c.n_pool == 0u64 { return Some(Missing("n_pool")) }
    if c.n_pool > WIRE_POOL_BYTES { return exceeds("n_pool", c.n_pool, WIRE_POOL_BYTES) }
    if c.n_service > WIRE_SESSION_CEILING { return exceeds("n_service", c.n_service, WIRE_SESSION_CEILING) }
    if c.n_granted > WIRE_SESSION_CEILING { return exceeds("n_granted", c.n_granted, WIRE_SESSION_CEILING) }
    let peak = wire_variable_peak(c) + c.n_granted
    if peak > WIRE_SESSION_CEILING { return exceeds("session peak", peak, WIRE_SESSION_CEILING) }
    // Welcome carries one issuer byte, at most SUBJECT_MAX subject bytes and a 32-byte digest.
    // The launch target belongs to this run, so its size is known at serve.
    let welcome = 69u64 + SUBJECT_MAX + target_size
    let mandatory = if welcome > 125u64 { welcome } else { 125u64 }
    let floor = std.order.max(mandatory, wire_outcome_reserve(c) + 28u64)
    if c.socket.max_frame < floor { return Some(Missing("socket.max_frame (below the Welcome and outcome frames)")) }
    if c.budget < wire_round(mandatory + 14u64) { return Some(Missing("budget (below one Welcome frame)")) }
    None
}

fn wire_decode(b: Bytes) -> Result[Frame, u16] {
    if list.len(b) < 4u64 || b[0u64] >= 4u8 || b[1u64] != 0u8 || b[2u64] != 0u8 || b[3u64] != 0u8 {
        return Error(1007u16)
    }
    let codec: std.codec.Codec[Frame] = std.codec.of()
    Ok(std.codec.decode(codec, b) ?=> |_| 1007u16)
}

pub const DONE_MAX: u64 = 8192
const MAX_RETURNED_BYTES: u64 = DONE_MAX - 20u64

// WIRE W3b. The service owns admission, dedup and outcomes.
// Each owner holds the one publisher sender. Another transport calls the same dispatch.
pub type ServiceInput: send = WAttach(Ip, Sender[WireEvent], Sender[PubIn]) | WClient(Frame, u64) | WRunner(Notice) | WGrantedDone(Tick, Outcome) | WPrepared(Box[ServicePlan]) | WDrained | WSent | WDropped | WPoll(bool) | WClose(u64) | WForce

pub type Service[C: send]: send {
    context: C,
    step: fn(mut C, mut WireWork, take ServiceInput) -> Result[Option[Frame], u16],
    ready: fn(C) -> bool,
    finish: fn(mut C) -> Option[PubIn],
    check: fn(C, Frame) -> Option[u16]
}

pub fn dispatch[C: send](mut service: Service[C], take frame: Frame) -> Result[Option[Frame], u16] {
    let mut work = wire_work()
    (service.step)(mut service.context, mut work, WClient(take frame, 0u64))
}

pub fn writer_bytes() -> u64 { 4096u64 }

// The owner result has charge-v1 size 32. Its 320-byte task
// record is part of the floor, which also covers its child tasks.
pub fn serving_bytes(c: WireConfig, owners: u64, n_place: u64) -> Result[u64, Capacity] {
    if c.n_granted > WIRE_SESSION_CEILING { return Error(Capacity(requested: c.n_granted, available: WIRE_SESSION_CEILING)) }
    if owners > WIRE_OWNER_LIMIT { return Error(Capacity(requested: owners, available: WIRE_OWNER_LIMIT)) }
    let floors = owners * (WIRE_OWNER_FLOOR + c.n_granted)
    // Use less supervisor room when a caller deliberately serves fewer owners.
    let metadata = 2097152u64 + owners * 6711u64
    let overhead = if metadata < WIRE_OVERHEAD { metadata } else { WIRE_OVERHEAD }
    // The place's one Registry, built once under bytes n_place for every session.
    let fixed = match int.checked_add(overhead + floors, n_place) { Some(f) => f, None => return Error(Capacity(requested: n_place, available: 0xffffffffffffffffu64 - (overhead + floors))) }
    match int.checked_add(fixed, c.n_pool) {
        Some(total) => Ok(total),
        None => Error(Capacity(requested: c.n_pool, available: 0xffffffffffffffffu64 - fixed)),
    }
}

pub opaque type WireEvent: send { e: WireInput }

fn wire_event(take e: WireInput) -> WireEvent { WireEvent(e: take e) }

type WireInput: send = Input(Frame, u64) | FromRunner(Notice) | HelloBound(Option[Caller]) | GrantedDone(Tick, Outcome) | JoinReady | HelloExpired | Published(Frame) | Control(u8, Box[std.websocket.Control]) | Sent(Box[std.wsock.Writer]) | Dropped | WriteTimedOut(u64) | ReadClosed(Box[std.websocket.Control], Box[std.wsock.Reader]) | WriteClosed(Box[std.wsock.Writer]) | Ended(u16) | DrainWake | RetireWire

type WirePacket: send = Fragment | Decoded(Frame, u64) | Pinged(Box[std.websocket.Control]) | Ponged | PeerClosed(Box[std.websocket.Control])
type WireParsed: send { reader: Box[std.wsock.Reader], packet: Result[Option[WirePacket], std.wsock.Error] }
type WireAllocation[C: send]: send = Decode(Box[std.wsock.Reader], u64, Sender[WireParsed]) | Encode(Frame, Sender[Result[Bytes, std.wsock.Error]]) | AllocateService(Box[Service[C]], ServiceAllocation, Sender[Option[AllocatedState[C]]])
type WirePool[C: send]: send { inbox: Receiver[WireAllocation[C]], config: std.wsock.Config, clock: Clock, service_bytes: u64, allocate: own[send] fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16] }
pub type ServiceAllocation: send = AcceptHello(Option[Caller]) | PlanCall | ValidateSubscribe(u32, u32, Bytes, Option[Bytes]) | DeliverUpdate(DeliveryJob)
pub opaque type DeliveryJob: send { updates: List[Update], output: List[WireOutput], drain: Option[Latest[Option[DrainWindow]]] }
type AllocatedState[C: send]: send { service: Box[Service[C]], status: Result[Box[ServicePlan], u16] }
type ServiceAllocationJob[C: send]: send { service: Box[Service[C]], plan: ServiceAllocation }

fn wire_allocate_job[C: send](take job: ServiceAllocationJob[C], allocate: own[send] fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16]) -> AllocatedState[C] {
    let ServiceAllocationJob(service: take owned, plan: take plan) = take job
    let mut session = take owned
    let status: Result[Box[ServicePlan], u16] = match allocate(mut session.context, take plan) {
        Ok(take result_plan) => Ok(box.new(take result_plan)),
        Error(code) => Error(code),
    }
    AllocatedState(service: take session, status: status)
}

fn wire_parse(mut reader: std.wsock.Reader, at: u64, clock: Clock) -> Result[Option[WirePacket], std.wsock.Error] {
    match std.wsock.decode_buffered(mut reader)? {
        None => Ok(None),
        Some(Need) => Ok(Some(Fragment)),
        Some(Ping(control)) => Ok(Some(Pinged(box.new(control)))),
        Some(Pong(_)) => Ok(Some(Ponged)),
        Some(Closed(control)) => Ok(Some(PeerClosed(box.new(control)))),
        Some(Reject(code)) => Error(Protocol(code)),
        Some(Text(_)) => Error(Protocol(1003u16)),
        Some(Ended) => Error(Eof),
        Some(Message(take payload)) => {
            match wire_decode(payload) {
                Ok(take frame) => {
                    let arrived = match frame { Hello(_, _) => host.mono_ns(clock), _ => at }
                    Ok(Some(Decoded(take frame, arrived)))
                },
                Error(code) => Error(Protocol(code)),
            }
        },
    }
}

fn wire_pool[C: send](take pool: WirePool[C]) -> () waits {
    let WirePool(inbox: take inbox, config: config, clock: clock, service_bytes: service_bytes, allocate: take allocate) = take pool
    let encoder = match std.wsock.outbound(Server, config, None) { Ok(out) => out, Error(_) => return }
    while let Ok(take work) = channel.receive(inbox) {
        match take work {
            Decode(take input, at, take to) => {
                let mut reader = take input
                let packet = wire_parse(mut reader, at, clock)
                let _ = channel.try_send(to, WireParsed(reader: take reader, packet: take packet))
            },
            Encode(take frame, take to) => {
                let encoded_frame = wire_encode(encoder, frame)
                let _ = channel.try_send(to, take encoded_frame)
            },
            AllocateService(take owned, take plan, take to) => {
                // A bounded, isolated step: its body takes the job from a slot charged to the bound, so a failure drops the session (None).
                let ran = bound bytes service_bytes {
                    let (slot, job): (Sender[ServiceAllocationJob[C]], Receiver[ServiceAllocationJob[C]]) = channel.new(1u64)
                    let _ = channel.try_send(slot, ServiceAllocationJob(service: take owned, plan: take plan))
                    isolate(scoped fn() -> Option[AllocatedState[C]] { match channel.try_receive(job) { Ok(take next) => Some(wire_allocate_job(take next, allocate)), _ => None } })
                }
                let returned = match take ran { Ok(Ok(Ok(take completed))) => take completed, _ => None }
                let _ = channel.try_send(to, take returned)
            },
        }
    }
}

/// One whole binary frame for f, its codec bytes written once behind the header.
pub fn wire_encode(out: std.wsock.Outbound, f: Frame) -> Result[Bytes, std.wsock.Error] {
    let codec: std.codec.Codec[Frame] = std.codec.of()
    std.wsock.try_encode_with(out, codec, f, wire_output_size(f))
}

fn start_wire_pool[C: send](tasks: Tasks, c: WireConfig, clock: Clock, n: u64, slots: u64, take allocate: own[send] fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16]) -> Result[(Sender[WireAllocation[C]], Task[()]), Capacity] {
    let (to, inbox): (Sender[WireAllocation[C]], Receiver[WireAllocation[C]]) = channel.new(slots)
    // Hello key growth is bounded by the wire payload, rounded identities and the
    // list of Bytes handles; the place's one Registry is in `allocate`, made outside.
    let pool = WirePool(inbox: take inbox, config: c.socket, clock: clock, service_bytes: wire_service_job_bytes(c), allocate: take allocate)
    let run: fn(take WirePool[C]) -> () waits = wire_pool
    let handle = task.spawn(tasks, bytes n, take pool, run)
    Ok((take to, take handle))
}

fn wire_pack[C: send](pool: Sender[WireAllocation[C]], to: Sender[Result[Bytes, std.wsock.Error]], inbox: Receiver[Result[Bytes, std.wsock.Error]], take frame: Frame) -> Result[Bytes, std.wsock.Error] waits {
    if let Error(_) = channel.try_send(pool, Encode(take frame, channel.sender(to))) { return Error(Protocol(1013u16)) }
    match channel.receive(inbox) {
        Ok(Error(Allocation(_))) => Error(Protocol(1013u16)),
        Ok(take result) => take result,
        Error(_) => Error(Protocol(1013u16)),
    }
}

fn wire_allocate[C: send](pool: Sender[WireAllocation[C]], to: Sender[Option[AllocatedState[C]]], inbox: Receiver[Option[AllocatedState[C]]], take service: Box[Service[C]], take plan: ServiceAllocation) -> Option[AllocatedState[C]] waits {
    match channel.try_send(pool, AllocateService(take service, take plan, channel.sender(to))) {
        Ok(()) => match channel.receive(inbox) { Ok(take returned) => take returned, Error(_) => None },
        Error(Full(AllocateService(take back, _, _))) => Some(AllocatedState(service: take back, status: Error(1013u16))),
        Error(Closed(AllocateService(take back, _, _))) => Some(AllocatedState(service: take back, status: Error(1013u16))),
        _ => None,
    }
}

// Read credits cover the inbox and a reader blocked on handing off a packet.
type WireRead[C: send]: send { reader: Box[std.wsock.Reader], to: Sender[WireEvent], credits: Receiver[()], clock: Clock, config: std.wsock.Config, pool: Sender[WireAllocation[C]] }
// A staged frame: its deadline, whether a Close may still follow, its first-write notice.
type WireWrite: send { writer: Box[std.wsock.Writer], to: Sender[WireEvent], out: std.wsock.Outbound, clock: Clock, config: std.wsock.Config, end: u64, can_close: bool, close: bool, report: Option[Sender[u64]] }

// One encoded frame to write. A content unit carries its version and handles to the
// round register and its session's fence root; the owner applies the release check before
// its first byte (§3).
type WireUnit: send { frame: Bytes, check: Option[WireCheck], write_ack: bool }
type WireCheck: send { version: u64, round: Latest[RoundAt], fence: Latest[Fence] }

// A content unit is built only with both handles; the owner has them from the join that let
// the content in, so a missing one is a broken invariant and ends the session, unwritten.
fn wire_unit(work: WireWork, take frame: Bytes, check: Option[u64], report_writes: bool) -> WireUnit {
    let checked = match check {
        Some(version) => match work.round {
            Some(register) => match work.fence {
                Some(fence) => Some(WireCheck(version: version, round: latest.handle(register), fence: latest.handle(fence))),
                None => fail("runner: a content unit without its fence"),
            },
            None => fail("runner: a content unit without the round register"),
        },
        None => None,
    }
    let mut write_ack = false
    if report_writes {
        for mark in work.sending {
            if let WriteUnit(_) = mark { write_ack = true; break }
        }
    }
    WireUnit(frame: take frame, check: take checked, write_ack: write_ack)
}

fn wire_return_reader(to: Sender[WireEvent], take control: Box[std.websocket.Control], take input: Box[std.wsock.Reader]) -> () waits {
    let mut reader = take input
    std.wsock.finish_read(mut reader)
    let _ = channel.send(to, wire_event(ReadClosed(take control, take reader)))
}

fn wire_read[C: send](take x: WireRead[C]) -> () waits {
    let WireRead(reader: take initial, to: take to, credits: take credits, clock: clock, config: config, pool: take pool) = take x
    let (reply, packets): (Sender[WireParsed], Receiver[WireParsed]) = channel.new(1u64)
    let mut r = take initial
    let mut probing = false
    loop {
        match channel.try_receive(credits) {
            Ok(_) => {},
            Error(Closed) => return,
            Error(Empty) => {
                if let Error(_) = std.wsock.settle(mut r) { wire_return_reader(to, wire_close_control(1013u16), take r); return }
                if let Error(_) = channel.receive(credits) { return }
            },
        }
        let next: WireInput = loop {
            let end = std.clock.deadline_after_ms(host.mono_ns(clock), config.idle_ms)
            let packet = loop {
                match channel.try_send(pool, Decode(take r, host.mono_ns(clock), channel.sender(reply))) {
                    Ok(()) => {},
                    Error(Full(Decode(take back, _, _))) => { wire_return_reader(to, wire_close_control(1013u16), take back); return },
                    Error(_) => return,
                }
                let WireParsed(reader: take returned, packet: take attempted) = match channel.receive(packets) {
                    Ok(take frame) => take frame,
                    Error(_) => return,
                }
                r = take returned
                match take attempted {
                    Ok(None) => {},
                    take complete => break take complete,
                }
                match std.wsock.refill(mut r, At(clock, end)) {
                    Ok(()) => if host.mono_ns(clock) >= end { break Error(Network(TimedOut)) },
                    Error(e) => break Error(e),
                }
            }
            match take packet {
                Ok(Some(Fragment)) => { probing = false },
                Ok(Some(Ponged)) => { probing = false },
                Ok(Some(Decoded(take frame, at))) => { probing = false; break Input(take frame, at) },
                Ok(Some(Pinged(take control))) => { probing = false; break Control(10u8, take control) },
                Ok(Some(PeerClosed(take control))) => { wire_return_reader(to, take control, take r); return },
                Error(Protocol(code)) => { wire_return_reader(to, wire_close_control(code), take r); return },
                Error(Allocation(_)) => { wire_return_reader(to, wire_close_control(1013u16), take r); return },
                Error(Network(TimedOut)) => {
                    if probing { wire_return_reader(to, wire_close_control(1001u16), take r); return }
                    probing = true
                    break Control(9u8, box.new(std.websocket.Control(data: [0u8; 125], len: 0u64)))
                },
                _ => { wire_return_reader(to, wire_close_control(1001u16), take r); return },
            }
        }
        if let Error(_) = channel.send(to, wire_event(take next)) { return }
    }
}

// Writes x's staged frame; without `wait`, Ok(false) is a send that would block (v2.44).
fn wire_push_frame(mut x: WireWrite, wait: bool) -> Result[bool, u16] waits {
    loop {
        let flushed: Result[bool, std.wsock.Error] = if !wait { std.wsock.flush(mut x.writer, mut x.out, At(x.clock, 0u64)) }
            else if host.mono_ns(x.clock) >= x.end { Error(Network(TimedOut)) } else { std.wsock.flush(mut x.writer, mut x.out, At(x.clock, x.end)) }
        match flushed {
            Ok(true) => break,
            Ok(false) => {},
            Error(Network(TimedOut)) => {
                if !wait { return Ok(false) }
                if !x.can_close { return Error(1001u16) }
                // The Close frame cannot overtake a partial frame. Give the
                // sole writer the same close deadline as the owner.
                x.end = std.clock.deadline_after_ms(x.end, x.config.close_ms)
                x.can_close = false
                if let Error(_) = channel.send(x.to, wire_event(WriteTimedOut(x.end))) { return Error(1001u16) }
            },
            Error(_) => return Error(1001u16),
        }
    }
    if let Some(take report) = replace(mut x.report, None) { let _ = channel.try_send(report, host.mono_ns(x.clock)) }
    Ok(true)
}

fn wire_written(take x: WireWrite) -> WireInput {
    let WireWrite(writer: take writer, to: _, report: _, close: close, ..) = take x
    if close { WriteClosed(take writer) } else { Sent(take writer) }
}

// The writer child finishes one blocked frame, returns the Writer with its event, and exits.
fn wire_write(take x: WireWrite) -> () waits {
    let to = channel.sender(x.to)
    let mut w = take x
    let done = match wire_push_frame(mut w, true) { Ok(_) => wire_written(take w), Error(code) => Ended(code) }
    let _ = channel.send(to, wire_event(take done))
}

// Spawns the writer only for a send that would block. A refused spawn ends the session with
// 1001, as a write error does: part of the frame may be on the wire, so no Close can follow.
fn wire_start(tasks: Tasks, take x: WireWrite) -> Result[Task[()], WireInput] waits {
    let mut w = take x
    match wire_push_frame(mut w, false) {
        Ok(true) => Error(wire_written(take w)),
        Ok(false) => match task.try_spawn(tasks, bytes writer_bytes(), take w, wire_write) { Ok(take h) => Ok(take h), Error(_) => Error(Ended(1001u16)) },
        Error(code) => Error(Ended(code)),
    }
}

// busy is set from staging until Sent or Dropped, so the session holds one frame to write.
fn wire_ready(busy: bool) -> bool { !busy }

// Tokio JoinSet::shutdown aborts all before draining. Goose's contained
// workers release on wait, but lack cancellation. Both children are unshielded.
fn wire_join(take first: Task[()], take second: Option[Task[()]]) -> () waits {
    let mut reader = take first
    task.cancel(mut reader)
    if let Some(take h) = take second { let mut writer = take h; task.cancel(mut writer); let _ = task.join(take writer) }
    let _ = task.join(take reader)
}

pub fn wire_publish(to: Sender[WireEvent], take frame: Frame) -> Result[(), SendError[WireEvent]] {
    channel.try_send(to, wire_event(Published(take frame)))
}

fn wire_close_control(code: u16) -> Box[std.websocket.Control] {
    let mut data: Inline[u8, 125] = [0u8; 125]
    data[0u64] = int.narrow(code >> 8u16)
    data[1u64] = int.truncate(code)
    box.new(std.websocket.Control(data: data, len: 2u64))
}

fn wire_close_payload(code: u16) -> Bytes {
    let mut b: Bytes = list.with_capacity(2u64)
    let high: u8 = int.narrow(code >> 8u16)
    let low: u8 = int.truncate(code)
    list.push(mut b, high)
    list.push(mut b, low)
    b
}

type WireOwner[C: send]: send { upgraded: std.wsock.Upgraded, service: Box[Service[C]], publisher: Sender[PubIn], config: WireConfig, clock: Clock, tasks: Tasks, managed: Option[OwnerControl], allocate: Option[own[send] fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16]] }

fn wire_connection_pool_bytes(c: WireConfig) -> u64 {
    let peak = wire_variable_peak(c)
    if c.n_pool < peak { c.n_pool } else { peak }
}

// Serves an already upgraded connection. W3c constructs the service at Hello;
// its sender joins the one publisher inbox lazily at the first Subscribe.
pub fn serve_connection[C: send](tasks: Tasks, take upgraded: std.wsock.Upgraded, take service: Service[C], take allocate: own[send] fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16], to_publisher: Sender[PubIn], c: WireConfig, clock: Clock) -> Result[Task[Result[(), std.wsock.Error]], Capacity] {
    let boxed = box.new(take service)
    let x = WireOwner(upgraded: take upgraded, service: take boxed, publisher: channel.sender(to_publisher), config: c, clock: clock, tasks: tasks, managed: None, allocate: Some(take allocate))
    let run: fn(take WireOwner[C]) -> Result[(), std.wsock.Error] waits = wire_connection_owner
    let allowance = if wire_configuration(c) { WIRE_OWNER_FLOOR - WIRE_OWNER_TASK_BYTES + c.n_granted + wire_connection_pool_bytes(c) + 8192u64 } else { 0u64 }
    Ok(task.spawn(tasks, bytes allowance, take x, run))
}

fn wire_connection_owner[C: send](take x: WireOwner[C]) -> Result[(), std.wsock.Error] waits {
    if !wire_configuration(x.config) { return Error(Configuration) }
    let c = x.config
    let mut owner = take x
    let allocate = match replace(mut owner.allocate, None) { Some(take a) => take a, None => return Error(Configuration) }
    // The reader and owner each wait for their single allocation request.
    let allocated: Result[(Sender[WireAllocation[C]], Task[()]), Capacity] = start_wire_pool(owner.tasks, c, owner.clock, wire_connection_pool_bytes(c), 2u64, take allocate)
    let (take to, take holding) = match take allocated {
        Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)),
    }
    wire_owner(take owner, take to, Pooled(take holding))
}

// What the owner holds for whoever started it until it ends: the accept
// loop's completion, or a lone connection's own allocation pool task.
type WireTail = Served(OwnerCompletion) | Pooled(Task[()])

// Ends the owner's hold: the completion reports the count of sends its work
// abandoned, or the pool task is dropped; then the pool sender goes.
fn wire_tail[C: send](take tail: WireTail, take pool: Sender[WireAllocation[C]], abandoned: u64) {
    match take tail {
        Served(take completion) => {
            let mut report = take completion
            report.abandoned = abandoned
        },
        Pooled(take holding) => { let _ = take holding },
    }
    let _ = take pool
}

// The owner's steady phase owns all it needs, so nothing of the setup is
// left to finish after it, and the task enters it in place of its setup's
// frames (returnable.rs, transfer sites).
type WireSteady[C: send] { st: WireLoop[C], service: Box[Service[C]], pool: Sender[WireAllocation[C]], tail: WireTail }

// The owner's state across its event loop. wire_owner_setup builds it and
// returns, so the setup's temporaries leave the stack before the loop runs, and
// each event kind is handled in a call of its own, so the loop's frame holds
// one event's temporaries rather than every arm's.
type WireLoop[C: send] {
    apply_input: fn(mut C, mut WireWork, take ServiceInput) -> Result[Option[Frame], u16],
    work: WireWork, c: WireConfig, clock: Clock, tasks: Tasks, managed: Option[OwnerControl], pub_to: Sender[PubIn],
    to: Sender[WireEvent], inbox: Receiver[WireEvent], credit: Sender[()], out: std.wsock.Outbound, first_write: Option[Sender[u64]], done: Option[WireEvent],
    encoded_to: Sender[Result[Bytes, std.wsock.Error]], encoded_from: Receiver[Result[Bytes, std.wsock.Error]],
    allocation_to: Sender[Option[AllocatedState[C]]], allocation_from: Receiver[Option[AllocatedState[C]]],
    encoder: std.wsock.Outbound, rh: Task[()], wh: Option[Task[()]], lease: Option[std.wsock.Pending],
    hello_at: Option[u64], hello_seen: bool, hello_alarm: Option[Task[()]],
    run: u64, held: Option[WireEvent], held_credit: bool, deferred: List[(Frame, u64)], busy: bool, control: Option[Bytes], closing: bool, alarm: Option[Task[()]],
    read_back: Option[Box[std.wsock.Reader]], writer: Option[Box[std.wsock.Writer]], read_closed: bool, write_closed: bool, close_at: Option[u64], expired: bool,
}

// What one step of the owner's loop asks of it: go on with this frame (if
// any), start the next event, or leave the loop with this result.
type WireStep = Go(Option[Frame]) | Again | Stop(Result[(), std.wsock.Error])

fn wire_owner[C: send](take x: WireOwner[C], take pool: Sender[WireAllocation[C]], take tail: WireTail) -> Result[(), std.wsock.Error] waits {
    let (take st, take service) = match wire_owner_setup(take x, pool) {
        Ok(take ready) => take ready,
        Error(take done) => {
            wire_tail(take tail, take pool, 0u64)
            return take done
        },
    }
    wire_owner_run(WireSteady(st: take st, service: take service, pool: take pool, tail: take tail))
}

// Error(r) is the owner's result when it ends before its loop.
fn wire_owner_setup[C: send](take x: WireOwner[C], pool: Sender[WireAllocation[C]]) -> Result[(WireLoop[C], Box[Service[C]]), Result[(), std.wsock.Error]] waits {
    let WireOwner(upgraded: take up, service: take initial_service, publisher: take pub_to, config: c, clock: clock, tasks: tasks, managed: take managed, allocate: _) = take x
    let std.wsock.Upgraded(reader: take reader, writer: take writer, source: source, timers: timers, pending: take pending) = take up
    let lease = Some(take pending)
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64 + c.q)
    if let Some(life) = managed {
        let (ready_to, ready_from): (Sender[()], Receiver[()]) = channel.new(1u64)
        if let Error(_) = channel.send(life.to, OwnerReady(life.id, channel.sender(to), take ready_to)) { return Error(Ok(())) }
        if let Error(_) = channel.receive(ready_from) { return Error(Ok(())) }
    }
    let (credit, credits): (Sender[()], Receiver[()]) = channel.new(1u64 + c.q)
    for _ in 0u64 .. 1u64 + c.q { let _ = channel.try_send(credit, ()) }
    let (encoded_to, encoded_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = channel.new(1u64)
    let (allocation_to, allocation_from): (Sender[Option[AllocatedState[C]]], Receiver[Option[AllocatedState[C]]]) = channel.new(1u64)
    let out = match std.wsock.outbound(Server, c.socket, None) { Ok(o) => o, Error(e) => return Error(Error(e)) }
    let encoder = match std.wsock.outbound(Server, c.socket, None) { Ok(o) => o, Error(e) => return Error(Error(e)) }
    let reading = WireRead(reader: box.new(take reader), to: channel.sender(to), credits: take credits, clock: clock, config: c.socket, pool: channel.sender(pool))
    let read_task: fn(take WireRead[C]) -> () waits = wire_read
    let mut rh = task.spawn(tasks, bytes reader_bytes(), take reading, read_task)
    let first_write = match managed { Some(life) => copy_write_notice(life.first_write), None => None }
    let mut service = take initial_service
    let apply_input = service.step
    let mut work = wire_work()
    if let Some(life) = managed { work.drain = Some(latest.handle(life.drain)) }
    if let Error(code) = apply_input(mut service.context, mut work, WAttach(source, channel.sender(to), channel.sender(pub_to))) { wire_join(take rh, None); return Error(Error(Protocol(code))) }
    let hello_at = std.wsock.hello_deadline(timers)
    let mut hello_alarm: Option[Task[()]] = None
    if let Some(at) = hello_at {
        let h = std.clock.alarm(tasks, clock, at, to, wire_event(HelloExpired))
        hello_alarm = Some(take h)
    }
    let st = WireLoop(apply_input: apply_input, work: take work, c: c, clock: clock, tasks: tasks, managed: take managed, pub_to: take pub_to,
        to: take to, inbox: take inbox, credit: take credit, out: out, first_write: take first_write, done: None,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: encoder, rh: take rh, wh: None, lease: take lease, hello_at: hello_at, hello_seen: false, hello_alarm: take hello_alarm,
        run: 0u64, held: None, held_credit: false, deferred: list.new(), busy: false, control: None, closing: false, alarm: None,
        read_back: None, writer: Some(box.new(take writer)), read_closed: false, write_closed: false, close_at: None, expired: false)
    Ok((take st, take service))
}

fn wire_owner_run[C: send](take job: WireSteady[C]) -> Result[(), std.wsock.Error] waits {
    let WireSteady(st: take initial, service: take initial_service, pool: take pool, tail: take tail) = take job
    let mut abandoned = 0u64
    let mut st = take initial
    let mut service = take initial_service
    // Every normal exit goes through wire_join, including service refusal and
    // either child's Ended. Cancellation uses CONC-8 on the two owned handles.
    let result: Result[(), std.wsock.Error] = loop {
        wire_owner_join(mut st, mut service)
        if !wire_post(mut st.work) { wire_owner_refuse(mut st, 1011u16) }
        let received = match wire_owner_next(mut st, mut service) {
            Some(take e) => take e,
            None => break Ok(()),
        }
        let frame = match take received {
            Input(take f, at) => {
                if st.closing { let _ = channel.try_send(st.credit, ()); continue }
                match wire_owner_input(mut st, take service, pool, take f, at) {
                    Some((take kept, take outcome)) => {
                        service = take kept
                        match take outcome { Go(take next) => take next, Again => continue, Stop(take r) => break take r }
                    },
                    None => {
                        let lost = wire_owner_lost(take st)
                        wire_tail(take tail, take pool, 0u64)
                        return lost
                    },
                }
            },
            FromRunner(take e) => {
                if st.closing { continue }
                match wire_owner_runner(mut st, take service, pool, take e) {
                    Some((take kept, take next)) => { service = take kept; take next },
                    None => {
                        let lost = wire_owner_lost(take st)
                        wire_tail(take tail, take pool, 0u64)
                        return lost
                    },
                }
            },
            HelloBound(take identity_result) => {
                let _ = replace(mut st.work.asking, None)
                match wire_owner_hello(mut st, take service, pool, take identity_result) {
                    Some(take kept) => { service = take kept; None },
                    None => {
                        let lost = wire_owner_lost(take st)
                        wire_tail(take tail, take pool, 0u64)
                        return lost
                    },
                }
            },
            GrantedDone(take tick, take outcome) => {
                if st.closing { continue }
                match (st.apply_input)(mut service.context, mut st.work, WGrantedDone(take tick, take outcome)) {
                    Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
                }
            },
            JoinReady => None,
            DrainWake => None,
            HelloExpired => {
                if st.hello_seen { continue }
                wire_owner_refuse(mut st, 1008u16)
                None
            },
            Published(take f) => { if st.closing { continue }; Some(take f) },
            Control(op, payload) => match wire_owner_control(mut st, op, payload) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            Sent(take returned) => {
                st.writer = Some(take returned)
                if let Some(take h) = replace(mut st.wh, None) { let _ = task.join(take h) }
                st.busy = false
                let _ = (st.apply_input)(mut service.context, mut st.work, WSent)
                None
            },
            Dropped => {
                st.busy = false
                if let Error(code) = (st.apply_input)(mut service.context, mut st.work, WDropped) { wire_owner_refuse(mut st, code) }
                None
            },
            WriteTimedOut(end) => match wire_owner_write_timeout(mut st, end) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            ReadClosed(payload, take returned) => match wire_owner_read_closed(mut st, payload, take returned) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            WriteClosed(take returned) => {
                st.writer = Some(take returned)
                if let Some(take h) = replace(mut st.wh, None) { let _ = task.join(take h) }
                st.write_closed = true
                if st.read_closed { break Ok(()) }
                None
            },
            Ended(_) => break Ok(()),
            RetireWire => {
                wire_owner_refuse(mut st, 1012u16)
                None
            },
        }
        let outgoing = match wire_owner_poll(mut st, mut service, take frame) { Go(take next) => take next, Again => continue, Stop(take r) => break take r }
        match wire_owner_send(mut st, mut service, pool, take outgoing) { Stop(take r) => break take r, _ => {} }
    }
    if st.expired { abandoned = st.work.abandoned }
    let ended = wire_owner_end(take st, mut service, take result)
    let _ = take service
    wire_tail(take tail, take pool, abandoned)
    ended
}

// v2.22 (§3): the owner's Join goes into PubIn with a waiting send, like connect's. The
// publisher never waits on an owner, so the wait is at most one drain; the owner holds no sub
// and no content of this join until it is admitted. A closed inbox drops the Join, and the
// next poll refuses its first Subscribe.
fn wire_join_send(mut work: WireWork, to: Sender[PubIn]) waits {
    if let Some(take join) = replace(mut work.join, None) { let _ = channel.send(to, take join) }
}

// v2.23: the requests a full head inbox did not take go in with a waiting send, in order. The
// head never waits on an owner (it answers through the publisher, which never waits on one
// either), so the wait ends when the head takes its next message. False when the head is gone.
fn wire_post(mut work: WireWork) -> bool waits {
    if list.len(work.posts) == 0u64 { return true }
    let head = match work.head { Some(lease) => copy_wire_head(lease.head), None => fail("runner: missing head lease") }
    while list.len(work.posts) != 0u64 {
        let req = list.remove(mut work.posts, 0u64)
        let sent = match head {
            LifecycleHead(to) => match channel.send(to, RunRequest(take req)) { Ok(()) => true, Error(_) => false },
        }
        if !sent { work.posts = list.new(); return false }
    }
    true
}

fn wire_owner_join[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) waits {
    if let None = st.work.join { return }
    wire_join_send(mut st.work, st.pub_to)
    let _ = (st.apply_input)(mut service.context, mut st.work, WPoll(false))
}

// The next event, or None when the loop ends: the inbox closed, or the work's
// cut passed (the owner then expires).
fn wire_owner_next[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) -> Option[WireInput] waits {
    let event = if let Some(take e) = replace(mut st.done, None) { take e } else if (service.ready)(service.context) && list.len(st.deferred) != 0u64 {
        let (take pending_frame, at) = list.remove(mut st.deferred, 0u64)
        wire_event(Input(take pending_frame, at))
    } else if let Some(take e) = replace(mut st.held, None) {
        take e
    } else {
        let e = match channel.try_receive(st.inbox) {
            Ok(take e) => take e,
            Error(Empty) => { st.run = 0u64; match channel.receive(st.inbox) { Ok(take e) => take e, Error(_) => return None } },
            _ => return None,
        }
        if wire_taken(mut st.run, 1u64 + st.c.q) { let _ = (st.apply_input)(mut service.context, mut st.work, WDrained) }
        take e
    }
    if wire_owner_cut(mut st, mut service) { return None }
    if let Some(life) = st.managed {
        if let Some(window) = drain_window(latest.read(life.drain)) {
            if host.mono_ns(st.clock) >= window.admission && (match st.work.deadline { None => true, _ => false }) {
                let _ = (st.apply_input)(mut service.context, mut st.work, WClose(window.deadline))
            }
        }
    }
    let WireEvent(e: take received) = take event
    Some(take received)
}

// Whether the work's cut has passed; the service is then forced and the owner
// expires.
fn wire_owner_cut[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) -> bool {
    if !wire_cut(st.work, st.clock) { return false }
    let _ = (st.apply_input)(mut service.context, mut st.work, WForce)
    st.expired = true
    true
}

// Queues a close with this code and starts closing.
fn wire_owner_refuse[C: send](mut st: WireLoop[C], code: u16) {
    st.control = Some(result.unwrap(std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(code))))
    st.closing = true
}

// The service's answer to a frame from the client. None when the allocation
// pool is gone with the service.
fn wire_owner_input[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take f: Frame, at: u64) -> Option[(Box[Service[C]], WireStep)] waits {
    let mut service = take held
    let mut checked = (service.check)(service.context, f)
    if let Hello(_, _) = f {
        if !st.hello_seen {
            if let Some(end) = st.hello_at { if at >= end { checked = Some(1008u16) } }
            st.hello_seen = true
        }
    }
    if match checked { None => true, _ => false } && !(service.ready)(service.context) {
        list.push(mut st.deferred, (take f, at))
        return Some((take service, Again))
    }
    if let Hello(_, _) = f { let _ = replace(mut st.hello_alarm, None) }
    let handled: Result[Option[Frame], u16] = match checked {
        Some(code) => Error(code),
        None => if let Subscribe(sub, slot, take arg, take resume) = f {
            let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take service, ValidateSubscribe(sub, slot, take arg, take resume)) {
                Some(take returned) => take returned,
                None => return None,
            }
            service = take restored
            match take status {
                Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
                Error(code) => Error(code),
            }
        } else { (st.apply_input)(mut service.context, mut st.work, WClient(take f, at)) },
    }
    if st.work.plan_call {
        st.work.plan_call = false
        match wire_owner_call(mut st, take service, pool) {
            Some((take kept, take next)) => {
                service = take kept
                let _ = channel.try_send(st.credit, ())
                return Some((take service, Go(take next)))
            },
            None => return None,
        }
    }
    if (service.ready)(service.context) { let _ = channel.try_send(st.credit, ()) } else { st.held_credit = true }
    let outcome = match take handled {
        Ok(take next) => Go(take next),
        Error(code) => {
            let payload = wire_close_payload(code)
            match std.wsock.encode(mut st.encoder, true, 8u8, payload) {
                Ok(take refused) => { st.control = Some(take refused) },
                Error(e) => return Some((take service, Stop(Error(e)))),
            }
            st.closing = true
            Go(None)
        },
    }
    Some((take service, take outcome))
}

// The service's answer to a publisher notice. None when the allocation pool is
// gone with the service.
fn wire_owner_runner[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take e: Notice) -> Option[(Box[Service[C]], Option[Frame])] waits {
    let mut service = take held
    let applied = if let Notice(e: Updated(take published)) = e {
        // Content of a fresh join can come before the owner has seen its Admit.
        let _ = (st.apply_input)(mut service.context, mut st.work, WPoll(false))
        let drain: Option[Latest[Option[DrainWindow]]] = match st.work.drain { Some(root) => Some(latest.handle(root)), None => None }
        let output = replace(mut st.work.output, list.new())
        let mut updates: List[Update] = list.new()
        list.push(mut updates, take published)
        wire_take_updates(mut st, mut service, mut updates)
        let job = DeliveryJob(updates: take updates, output: take output, drain: take drain)
        let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take service, DeliverUpdate(take job)) {
            Some(take returned) => take returned,
            None => return None,
        }
        service = take restored
        match take status {
            Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
            Error(code) => Error(code),
        }
    } else {
        (st.apply_input)(mut service.context, mut st.work, WRunner(take e))
    }
    let next = match take applied {
        Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
    }
    Some((take service, take next))
}

// §3 "Repair": the publisher's Updates already queued behind this one are taken in the same
// run, in inbox order, and staged by one delivery job, so an owner whose staging falls behind
// the publisher's rounds takes its backlog at once instead of one job per round.
fn wire_take_updates[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], mut updates: List[Update]) {
    let wakes = wire_take_queued(st.inbox, mut st.run, 1u64 + st.c.q, mut updates, mut st.held)
    if wakes != 0u64 { let _ = (st.apply_input)(mut service.context, mut st.work, WDrained) }
}

// Takes queued Updates into `updates` until it holds `capacity`, the inbox is empty, or an
// event of another kind comes; that event is kept in `held` and handled next. Each take
// counts toward the drain wake as any take does; returns the wakes due.
fn wire_take_queued(inbox: Receiver[WireEvent], mut run: u64, capacity: u64, mut updates: List[Update], mut held: Option[WireEvent]) -> u64 {
    let mut wakes = 0u64
    while list.len(updates) < capacity {
        let e = match channel.try_receive(inbox) { Ok(take e) => take e, _ => return wakes }
        if wire_taken(mut run, capacity) { wakes += 1u64 }
        match take e {
            WireEvent(e: FromRunner(Notice(e: Updated(take more)))) => list.push(mut updates, take more),
            take other => { held = Some(take other); return wakes },
        }
    }
    wakes
}

// Installs the Hello binding's result through the allocation pool.
fn wire_owner_hello[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take identity_result: Option[Caller]) -> Option[Box[Service[C]]] waits {
    let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take held, AcceptHello(take identity_result)) {
        Some(take returned) => take returned,
        None => return None,
    }
    if let Error(code) = status { wire_owner_refuse(mut st, code) }
    Some(take restored)
}

// Prepares a call under the allocation pool's budget.
fn wire_owner_call[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]]) -> Option[(Box[Service[C]], Option[Frame])] waits {
    let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take held, PlanCall) {
        Some(take returned) => take returned,
        None => return None,
    }
    let mut service = take restored
    let applied = match take status {
        Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
        Error(code) => Error(code),
    }
    let next = match take applied {
        Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
    }
    Some((take service, take next))
}

fn wire_owner_control[C: send](mut st: WireLoop[C], op: u8, payload: Box[std.websocket.Control]) -> WireStep {
    let _ = channel.try_send(st.credit, ())
    if st.closing { return Again }
    let mut b: Bytes = list.with_capacity(125u64)
    for i in 0u64 .. payload.len { let _ = list.push(mut b, payload.data[i]) }
    match std.wsock.encode(mut st.encoder, true, op, b) {
        Ok(take encoded_control) => { st.control = Some(take encoded_control) },
        Error(e) => return Stop(Error(e)),
    }
    if op == 8u8 { st.closing = true }
    Go(None)
}

fn wire_owner_write_timeout[C: send](mut st: WireLoop[C], end: u64) -> WireStep {
    if !st.closing {
        st.close_at = Some(end)
        match std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(1001u16)) {
            Ok(take close_frame) => { st.control = Some(take close_frame) },
            Error(e) => return Stop(Error(e)),
        }
        st.closing = true
    }
    Go(None)
}

fn wire_owner_read_closed[C: send](mut st: WireLoop[C], payload: Box[std.websocket.Control], take returned: Box[std.wsock.Reader]) -> WireStep {
    st.read_back = Some(take returned)
    st.read_closed = true
    if st.write_closed { return Stop(Ok(())) }
    if !st.closing {
        let mut b: Bytes = list.with_capacity(125u64)
        for i in 0u64 .. payload.len { list.push(mut b, payload.data[i]) }
        match std.wsock.encode(mut st.encoder, true, 8u8, b) {
            Ok(take close_bytes) => { st.control = Some(take close_bytes) },
            Error(e) => return Stop(Error(e)),
        }
    }
    st.closing = true
    Go(None)
}

// After an event: queues its frame, polls the service, and decides the frame to
// write now, if any.
fn wire_owner_poll[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], take frame: Option[Frame]) -> WireStep {
    if wire_owner_cut(mut st, mut service) { return Stop(Ok(())) }
    let mut outgoing: Option[Frame] = None
    if !st.closing {
        if let Some(take f) = take frame {
            if let Error(e) = wire_queue_external(mut st.work, st.c, take f, None) { return Stop(Error(e)) }
        }
        let writable = wire_ready(st.busy) && !st.write_closed && none(st.control)
            && (list.len(st.work.output) == 0u64 || !st.work.output[0u64].external)
        match (st.apply_input)(mut service.context, mut st.work, WPoll(writable)) {
            Ok(Some(take f)) => {
                if writable { outgoing = Some(take f) }
                else {
                    let held_check = replace(mut st.work.check, None)
                    if let Error(e) = wire_queue_external(mut st.work, st.c, take f, held_check) { return Stop(Error(e)) }
                }
            },
            Ok(None) => {},
            Error(code) => wire_owner_refuse(mut st, code),
        }
    }
    if st.held_credit && (service.ready)(service.context) { let _ = channel.try_send(st.credit, ()); st.held_credit = false }
    if !st.closing && map.len(st.work.timers) == 0u64 && wire_ready(st.busy) && list.len(st.work.output) == 0u64 &&
        (service.ready)(service.context) && list.len(st.deferred) == 0u64 {
        if let Some(_) = st.work.deadline {
            if let None = outgoing { wire_owner_refuse(mut st, 1001u16) }
        }
    }
    Go(take outgoing)
}

// Packs and offers the next data frame or the queued control frame, and arms
// the close alarm once closing.
fn wire_owner_send[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], pool: Sender[WireAllocation[C]], take outgoing: Option[Frame]) -> WireStep waits {
    let mut data_frame: Option[(Bytes, bool, Option[u64])] = None
    if wire_ready(st.busy) && !st.write_closed && !st.closing && none(st.control) {
        let next = match take outgoing {
            Some(take f) => Some(take f),
            None => if list.len(st.work.output) != 0u64 && st.work.output[0u64].external {
                let WireOutput(frame: take f, marks: _, generations: _, external: _, check: held_check) = list.remove(mut st.work.output, 0u64)
                st.work.check = held_check
                Some(take f)
            } else { None },
        }
        if let Some(take f) = take next {
            let welcome = match f { Welcome(_, _, _, _, _, _) => true, _ => false }
            let check = replace(mut st.work.check, None)
            match wire_pack(pool, st.encoded_to, st.encoded_from, take f) {
                Ok(take b) => { data_frame = Some((take b, welcome, check)) },
                Error(Protocol(1013u16)) => {
                    match std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(1013u16)) {
                        Ok(take refused) => { st.control = Some(take refused) },
                        Error(e) => return Stop(Error(e)),
                    }
                    st.closing = true
                },
                Error(e) => return Stop(Error(e)),
            }
            if wire_owner_cut(mut st, mut service) { return Stop(Ok(())) }
        }
    }
    let unarmed = match st.alarm { None => true, _ => false }
    if st.closing && unarmed {
        let own_close = match st.close_at {
            Some(end) => end,
            None => std.clock.deadline_after_ms(host.mono_ns(st.clock), st.c.socket.close_ms),
        }
        let deadline = match st.work.deadline { Some(cut) => if cut < own_close { cut } else { own_close }, None => own_close }
        st.close_at = Some(deadline)
        let h = std.clock.alarm(st.tasks, st.clock, deadline, st.to, wire_event(Ended(1001u16)))
        st.alarm = Some(take h)
    }
    if wire_ready(st.busy) && !st.write_closed {
        if let Some(take b) = replace(mut st.control, None) {
            wire_owner_write(mut st, WireUnit(frame: take b, check: None, write_ack: false))
            return Again
        }
        if let Some((take packed, welcome, check)) = take data_frame {
            // The check version travels with the unit; WSent or WDropped clears the copy.
            st.work.check = check
            let unit = wire_unit(st.work, take packed, check, !none(st.first_write))
            wire_owner_write(mut st, take unit)
            if welcome {
                if let Some(take accepted) = replace(mut st.lease, None) { std.wsock.hello_accepted(take accepted) }
            }
        }
    }
    Go(None)
}

// Stages one unit after its release check (§3) and writes it without waiting; its Sent,
// Dropped or end is the owner's next event.
fn wire_owner_write[C: send](mut st: WireLoop[C], take u: WireUnit) waits {
    let WireUnit(frame: take frame, check: take check, write_ack: write_ack) = take u
    st.busy = true
    if let Some(c) = check { if !release_load(c.round, c.fence, c.version) { st.done = Some(wire_event(Dropped)); return } }
    let mut writer = match replace(mut st.writer, None) { Some(take w) => take w, None => fail("runner: a write while the writer is out") }
    let close = list.len(frame) != 0u64 && frame[0u64] & 15u8 == 8u8
    let end = if close { std.clock.deadline_after_ms(host.mono_ns(st.clock), st.c.socket.close_ms) } else { int.saturating_add(host.mono_ns(st.clock), std.wsock.MESSAGE_NS) }
    let _ = std.wsock.stage(mut writer, take frame)
    let report = if write_ack { replace(mut st.first_write, None) } else { None }
    let x = WireWrite(writer: take writer, to: channel.sender(st.to), out: st.out, clock: st.clock, config: st.c.socket, end: end, can_close: !close, close: close, report: take report)
    match wire_start(st.tasks, take x) { Ok(take h) => { st.wh = Some(take h) }, Error(take e) => { st.done = Some(wire_event(take e)) } }
}

// The allocation pool went with the service: join both children and refuse.
fn wire_owner_lost[C: send](take st: WireLoop[C]) -> Result[(), std.wsock.Error] waits {
    // Every owned field stays bound, so it drops after the join as it did
    // when the loop was inline.
    let WireLoop(pub_to: take pub_to, managed: take managed, lease: take lease, to: take to, inbox: take inbox, credit: take credit, first_write: take first_write, done: take done,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: take encoder, rh: take rh, wh: take wh, work: take work, hello_alarm: take hello_alarm, deferred: take deferred, held: take held, control: take control,
        alarm: take alarm, read_back: take read_back, writer: take write_back, write_closed: write_closed, clock: clock, close_at: close_at, expired: expired, ..) = take st
    wire_join(take rh, take wh)
    Error(Protocol(1013u16))
}

fn wire_owner_end[C: send](take st: WireLoop[C], mut service: Box[Service[C]], take result: Result[(), std.wsock.Error]) -> Result[(), std.wsock.Error] waits {
    // Every owned field stays bound, so it drops at the end as it did when the
    // loop was inline; only copyable fields are left out.
    let WireLoop(pub_to: take pub_to, managed: take managed, lease: take lease, to: take to, inbox: take inbox, credit: take credit, first_write: take first_write, done: take done,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: take encoder, rh: take rh, wh: take wh, work: take work, hello_alarm: take hello_alarm, deferred: take deferred, held: take held, control: take control,
        alarm: take alarm, read_back: take read_back, writer: take write_back, write_closed: write_closed, clock: clock, close_at: close_at, expired: expired, ..) = take st
    if let Some(take h) = take alarm {
        let mut timing = take h
        task.cancel(mut timing)
        wire_join(take rh, take wh)
        let _ = task.join(take timing)
    } else {
        wire_join(take rh, take wh)
    }
    if !expired && write_closed && (match managed { None => true, _ => false }) {
        if let Some(take returned_reader) = take read_back {
            if let Some(take returned_writer) = take write_back {
                if let Some(deadline) = close_at {
                    let _ = std.wsock.finish(box.unbox(take returned_writer), box.unbox(take returned_reader), clock, deadline)
                }
            }
        }
    }
    wire_finish_owner(mut service, pub_to)
    result
}

// At most one inbox capacity of uninterrupted takes between publisher wakes.
fn wire_taken(mut run: u64, capacity: u64) -> bool {
    run += 1u64
    if run == capacity { run = 0u64; true } else { false }
}

fn wire_finish_owner[C: send](mut service: Service[C], pub_to: Sender[PubIn]) {
    if let Some(take left) = (service.finish)(mut service.context) { let _ = channel.try_send(pub_to, take left) }
}

// The accept loop retains at most max_sessions owner handles and reaps completed
// ones on the next acceptance. Upgrade runs in the owner, so a stalled HTTP
// client cannot prevent the listener accepting another connection.
type WireAccept[C: send]: send {
    socket: Socket, peer: Ip, accepted: u64, slot: std.wsock.Pending, proxies: List[std.wsock.Prefix],
    service: Box[Service[C]], publisher: Sender[PubIn], c: WireConfig, clock: Clock, tasks: Tasks,
    control: Option[OwnerControl], completion: OwnerCompletion, allocation: Sender[WireAllocation[C]],
}

fn wire_accepted[C: send](take x: WireAccept[C]) -> Result[(), std.wsock.Error] waits {
    let WireAccept(completion: take completion, socket: take socket, peer: peer, accepted: accepted, slot: take slot, proxies: take proxies,
        service: take service, publisher: take pub_to, c: c, clock: clock, tasks: tasks, control: take control, allocation: take allocation) = take x
    let admission = scoped fn(ip: Ip) -> bool {
        match control { Some(life) => !closing_at(life.drain, clock), None => true }
    }
    let raw = scoped fn(path: Bytes) -> Result[Option[(bool, String)], Capacity] {
        if path != string.as_bytes("/hirsel/status") { return Ok(None) }
        match control {
            Some(life) => Ok(Some(status_response(latest.read(life.status))?)),
            None => Ok(None),
        }
    }
    let received = std.wsock.server_with_site(take socket, take slot, peer, proxies, c.socket, clock, accepted, c.site, raw, admission)
    let _ = take proxies
    let ended: Result[(), std.wsock.Error] = match take received {
        Ok(Some(take up)) => return wire_owner(WireOwner(upgraded: take up, service: take service, publisher: take pub_to, config: c, clock: clock, tasks: tasks, managed: take control, allocate: None), take allocation, Served(take completion)),
        Ok(None) => Ok(()),
        Error(e) => Error(e),
    }
    wire_tail(Served(take completion), take allocation, 0u64)
    ended
}

type ServeInput: send = AcceptedSocket(Socket, Ip, u64) | AcceptEnded(NetError) | OwnerReady(u64, Sender[WireEvent], Sender[()]) | OwnerEnded(u64, u64) | ServeStart | ServeWake | ServeRetire | CheckServeIdle | AcceptIdle

type OwnerControl: send { id: u64, to: Sender[ServeInput], drain: Latest[Option[DrainWindow]], status: Latest[Status], first_write: Option[Sender[u64]] }

fn copy_write_notice(notice: Option[Sender[u64]]) -> Option[Sender[u64]] {
    match notice { Some(to) => Some(channel.sender(to)), None => None }
}

resource type OwnerCompletion: send { to: Sender[ServeInput], id: u64, abandoned: u64 } drop(completion) {
    let _ = channel.try_send(completion.to, OwnerEnded(completion.id, completion.abandoned))
}

type Acceptor: send { listener: Listener, clock: Clock, interrupt: Clock, to: Sender[ServeInput], permit: Receiver[u64] }

fn accept_sockets(take seed: Acceptor) -> () waits {
    let Acceptor(listener: take listener, clock: clock, interrupt: interrupt, to: take to, permit: take permit) = take seed
    let mut bound_listener = take listener
    while let Ok(at) = channel.receive(permit) {
        let until: Until = if at == 0u64 { Never } else { At(interrupt, at) }
        match host.accept(mut bound_listener, until) {
            Ok((take socket, peer)) => if let Error(_) = channel.send(to, AcceptedSocket(take socket, peer.ip, host.mono_ns(clock))) { return },
            Error(TimedOut) if at != 0u64 => if let Error(_) = channel.send(to, AcceptIdle) { return },
            Error(problem) => { let _ = channel.send(to, AcceptEnded(problem)); return },
        }
    }
}

type ManagedRefusal: send { socket: Socket, clock: Clock, until: u64, completion: OwnerCompletion }

fn refuse_managed_socket(take seed: ManagedRefusal) -> () waits {
    let ManagedRefusal(socket: take socket, clock: clock, until: until, completion: take completion) = take seed
    let _ = std.wsock.refuse_socket(take socket, 503u16, At(clock, until))
    let _ = take completion
}

type SessionTask { handle: Task[Result[(), std.wsock.Error]], wake: Option[Sender[WireEvent]] }

type ServeTransport {
    listener: Listener, config: WireConfig, tasks: Tasks, clock: Clock,
    limit: u64, proxies: List[std.wsock.Prefix], publisher: Sender[PubIn], inbox: Receiver[ServeInput], to: Sender[ServeInput],
}

type ServeDrain { events: Sender[LifeEvent], window: Latest[Option[DrainWindow]], status: Latest[Status], idle: Option[u64], first_write: Option[Sender[u64]] }

fn serve_closing(lifecycle: Option[ServeDrain], clock: Clock) -> bool {
    match lifecycle { Some(control) => closing_at(control.window, clock), _ => false }
}

type ServePlace[G: send, H: send, B: send]: send {
    listener: Listener, config: WireConfig, tasks: Tasks, clock: Clock, random: Random, wire: Option[Wire[G, B]],
    max_sessions: u64, proxies: List[std.wsock.Prefix], target: String, publisher: Sender[PubIn],
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, head: Sender[HeadInput],
    inbox: Receiver[ServeInput], to: Sender[ServeInput], events: Sender[LifeEvent], drain: Latest[Option[DrainWindow]], status: Latest[Status], idle: Option[u64], first_write: Option[Sender[u64]],
}

fn run_serve_place[G: send, H: send, B: send](take seed: ServePlace[G, H, B]) -> () waits {
    let events = channel.sender(seed.events)
    let serving = supervise_serve(take seed)
    let _ = channel.send(events, ServeEnded(take serving))
}

fn supervise_serve[G: send, H: send, B: send](take seed: ServePlace[G, H, B]) -> Result[u64, StartError] waits {
    let ServePlace(listener: take listener, config: config, tasks: tasks, clock: clock, random: random, wire: take session_wire,
        max_sessions: limit, proxies: take proxies, target: take target, publisher: take pub_to, place: place, n_place: n_place,
        head: take head_to, inbox: take inbox, to: take to, events: take events, drain: take drain, status: take status, idle: idle, first_write: take first_write) = take seed
    let registered = match placed(place, n_place) { Ok(take r) => take r, Error(take problem) => return Error(Open(Place(take problem))) }
    let make: scoped[view] fn() -> Service[WireSession[G, B]] = fn() -> Service[WireSession[G, B]] {
        wire_service_with_head(random, copy_wire(session_wire), LifecycleHead(channel.sender(head_to)), clock, tasks, config, clone(target))
    }
    let transport = ServeTransport(listener: take listener, config: config, tasks: tasks, clock: clock,
        limit: limit, proxies: take proxies, publisher: take pub_to, inbox: take inbox, to: take to)
    match serve_sockets(take transport, Some(ServeDrain(events: take events, window: take drain, status: take status, idle: idle, first_write: take first_write)), make, wire_allocator(take registered, n_place)) {
        Ok(count) => Ok(count), Error(Allocation(cap)) => Error(Full(cap)), Error(Network(problem)) => Error(Listen(problem)), _ => Error(Missing("socket")),
    }
}

fn serve_sockets[C: send](take seed: ServeTransport, take lifecycle: Option[ServeDrain], make: scoped[view] fn() -> Service[C], take allocate: own[send] fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16]) -> Result[u64, std.wsock.Error] waits {
    let ServeTransport(listener: take listener, config: config, tasks: tasks, clock: time,
        limit: limit, proxies: take proxies, publisher: take pub_to, inbox: take inbox, to: take to) = take seed
    let pool = std.wsock.pending(config.socket)?
    let allocated: Result[(Sender[WireAllocation[C]], Task[()]), Capacity] = start_wire_pool(tasks, config, time, config.n_pool, 1024u64, take allocate)
    let (allocation, allocation_task) = match take allocated {
        Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)),
    }
    let (permit, permits): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    // Advancing this clock interrupts a blocked accept only for an idle vote.
    let (interrupt, interrupt_hand) = provide.clock(0u64, 0u64)
    let mut accept_clock = take interrupt_hand
    let mut accept_at = match lifecycle { Some(control) if !none(control.idle) => 1u64, _ => 0u64 }
    let acceptor = Acceptor(listener: take listener, clock: time, interrupt: interrupt, to: channel.sender(to), permit: take permits)
    let mut accepting: Option[Task[()]] = Some(task.spawn(tasks, bytes 8192u64, take acceptor, accept_sockets))
    if let Some(control) = lifecycle {
        if let Error(_) = channel.send(control.events, ServePrepared) { return Ok(0u64) }
        if let Ok(ServeStart) = channel.receive(inbox) {} else { return Ok(0u64) }
    }
    let _ = channel.try_send(permit, accept_at)
    let mut owners: Map[u64, SessionTask] = map.new()
    let mut refusing: Map[u64, Task[()]] = map.new()
    let mut serial = 0u64
    let mut abandoned = 0u64
    let mut retiring = false
    let mut idle = false
    let mut checking_idle = false
    loop {
        if retiring || serve_closing(lifecycle, time) {
            if let Some(take accept_task) = replace(mut accepting, None) {
                let mut counted = take accept_task
                task.cancel(mut counted)
                let _ = task.join(take counted)
                let _ = replace(mut refusing, map.new())
                let mut closing_ids: List[u64] = list.new()
                for (id, owner_task) in owners {
                    match owner_task.wake {
                        Some(wake) => {
                            if retiring {
                                let _ = channel.send(wake, wire_event(RetireWire))
                            } else {
                                let _ = channel.try_send(wake, wire_event(DrainWake))
                            }
                        },
                        None => list.push(mut closing_ids, id),
                    }
                }
                for id in closing_ids { let _ = map.remove(mut owners, id) }
            }
            if map.len(owners) == 0u64 { return Ok(abandoned) }
        }
        if let Some(control) = lifecycle {
            if !none(control.idle) {
                let eligible = map.len(owners) == 0u64
                if idle != eligible {
                    idle = eligible
                    let _ = channel.send(control.events, ServeIdle(idle))
                }
            }
        }
        let event = match channel.receive(inbox) { Ok(take event) => take event, Error(_) => return Ok(abandoned) }
        match take event {
            ServeStart => (),
            CheckServeIdle => if let Some(control) = lifecycle {
                if idle && none(drain_window(latest.read(control.window))) {
                    checking_idle = true
                    clock.advance_to(mut accept_clock, accept_at)
                    accept_at += 1u64
                } else {
                    idle_vote(control.events, false, false)
                }
            },
            AcceptIdle => if let Some(control) = lifecycle {
                // The acceptor has returned to its permit channel. Leave it
                // there while the head votes and, on acceptance, through drain.
                if checking_idle {
                    checking_idle = false
                    idle_vote(control.events, false, idle && none(drain_window(latest.read(control.window))))
                }
                if !serve_closing(lifecycle, time) { let _ = channel.try_send(permit, accept_at) }
            },
            ServeRetire => { retiring = true },
            ServeWake => for (_, owner_task) in owners { if let Some(wake) = owner_task.wake { let _ = channel.try_send(wake, wire_event(DrainWake)) } },
            AcceptEnded(problem) => if !retiring && !serve_closing(lifecycle, time) { return Error(Network(problem)) },
            OwnerReady(id, take wake, take acknowledgement) => {
                if !retiring && !serve_closing(lifecycle, time) {
                    if let Some(take owner_task) = map.remove(mut owners, id) {
                        let mut promoted = take owner_task
                        promoted.wake = Some(take wake)
                        map.insert(mut owners, id, take promoted)
                        let _ = channel.try_send(acknowledgement, ())
                    }
                }
            },
            OwnerEnded(id, count) => {
                abandoned += count
                if let Some(SessionTask(handle: take handle, wake: _)) = map.remove(mut owners, id) { let _ = task.join(take handle) }
                if let Some(take handle) = map.remove(mut refusing, id) { let _ = task.join(take handle) }
            },
            AcceptedSocket(take socket, peer, at) => {
                if checking_idle {
                    checking_idle = false
                    if let Some(control) = lifecycle { idle_vote(control.events, false, false) }
                }
                if retiring || serve_closing(lifecycle, time) { continue }
                if idle {
                    idle = false
                    if let Some(control) = lifecycle { let _ = channel.send(control.events, ServeIdle(false)) }
                }
                let _ = channel.try_send(permit, accept_at)
                let id = serial
                serial += 1u64
                let pending: Option[std.wsock.Pending] = if map.len(owners) >= limit { None } else { match std.wsock.acquire(pool) { Ok(take slot) => take slot, _ => None } }
                let slot = match take pending {
                    Some(take slot) => take slot,
                    None => { start_socket_refusal(tasks, take socket, time, at, config, to, id, mut refusing); continue },
                }
                let copied: List[std.wsock.Prefix] = clone(proxies)
                let prefixes = take copied
                let made = bound bytes config.n_service { make() }
                let service = match take made { Ok(take instance) => take instance, Error(_) => { start_socket_refusal(tasks, take socket, time, at, config, to, id, mut refusing); continue } }
                let boxed = box.new(take service)
                let completion = match OwnerCompletion(to: channel.sender(to), id: id, abandoned: 0u64) { Ok(take completion) => take completion, Error(_) => continue }
                let control: Option[OwnerControl] = match lifecycle {
                    Some(life) => Some(OwnerControl(id: id, to: channel.sender(to), drain: latest.handle(life.window), status: latest.handle(life.status), first_write: copy_write_notice(life.first_write))), _ => None,
                }
                let job = WireAccept(socket: take socket, peer: peer, accepted: at, slot: take slot, proxies: take prefixes,
                    service: take boxed, publisher: channel.sender(pub_to), c: config,
                    clock: time, tasks: tasks, control: take control, completion: take completion, allocation: channel.sender(allocation))
                let run: fn(take WireAccept[C]) -> Result[(), std.wsock.Error] waits = wire_accepted
                let handle = task.spawn(tasks, bytes (WIRE_OWNER_FLOOR - WIRE_OWNER_TASK_BYTES + config.n_granted), take job, run)
                map.insert(mut owners, id, SessionTask(handle: take handle, wake: None))
            },
        }
    }
}

fn start_socket_refusal(tasks: Tasks, take socket: Socket, clock: Clock, at: u64, config: WireConfig, to: Sender[ServeInput], id: u64, mut refusing: Map[u64, Task[()]]) {
    if map.len(refusing) >= 16u64 { return }
    if let Ok(take completion) = OwnerCompletion(to: channel.sender(to), id: id, abandoned: 0u64) {
        let job = ManagedRefusal(socket: take socket, clock: clock, until: std.clock.deadline_after_ms(at, config.socket.upgrade_ms), completion: take completion)
        let _ = map.insert(mut refusing, id, task.spawn(tasks, bytes 16384u64, take job, refuse_managed_socket))
    }
}

pub fn serve[C: send](take listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, take proxies: List[std.wsock.Prefix], make: scoped[view] fn() -> Service[C], take allocate: own[send] fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16]) -> Result[(), std.wsock.Error] waits {
    if max_sessions == 0u64 || max_sessions > WIRE_OWNER_LIMIT || !wire_configuration(c) { return Error(Configuration) }
    // The caller supplies an allocator that already owns its Registry.
    let required = match serving_bytes(c, max_sessions, 0u64) { Ok(total) => total, Error(cap) => return Error(Allocation(cap)) }
    let served: Result[Result[(), std.wsock.Error], Capacity] = bound bytes required {
        let (to, inbox): (Sender[ServeInput], Receiver[ServeInput]) = channel.new(serve_inbox_capacity(max_sessions))
        let transport = ServeTransport(listener: take listener, config: c, tasks: tasks, clock: clock,
            limit: max_sessions, proxies: take proxies, publisher: channel.sender(to_publisher), inbox: take inbox, to: take to)
        match serve_sockets(take transport, None, make, take allocate) { Ok(_) => Ok(()), Error(problem) => Error(problem) }
    }
    match take served { Ok(take ended) => take ended, Error(cap) => Error(Allocation(cap)) }
}

fn limited_reply(take b: Bytes) -> Outcome {
    if list.len(b) > MAX_RETURNED_BYTES {
        Failed(OutOfBytes(Room(requested: list.len(b), available: MAX_RETURNED_BYTES)))
    } else { Returned(take b) }
}

fn register_check[G: send, H: send, A](mut r: Registry[G, H], key: Bytes, ca: std.codec.Codec[A], n: u64, steps: u64) -> Result[(), RegisterError] {
    let check = fn(arg: Bytes) -> Option[Refusal] {
        let seen = bound bytes n {
            let validate = scoped fn() -> Result[Option[Refusal], OutOfTime] {
                bound steps steps {
                    match std.codec.decode(ca, arg) {
                        Ok(_) => { let no_refusal: Option[Refusal] = None; no_refusal },
                        Error(e) => Some(Malformed(bad(e))),
                    }
                }
            }
            isolate(validate)
        }
        match take seen {
            Ok(Ok(Ok(Ok(take why)))) => take why,
            Ok(Ok(Ok(Error(_)))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Ok(Error(_))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Error(c)) => Some(Budget(room(c))),
            Error(c) => Some(Budget(room(c))),
        }
    }
    let go = check
    let copied_result: Bytes = clone(key)
    let copied: Bytes = take copied_result
    map.insert(mut r.checks, take copied, take go)
    Ok(())
}

// The composition root supplies previous/current activation keys. A current key
// always wins; retaining a gone key never substitutes a newly registered entry.
pub fn retain_gone[G: send, H: send](mut r: Registry[G, H], take key: Bytes) -> Result[(), RegisterError] {
    map.insert(mut r.gone, take key, ())
    Ok(())
}

pub opaque type Admitted: send {
    caller: Caller, entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64
}

pub fn admitted(take caller: Caller, take entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64) -> Admitted {
    Admitted(caller: take caller, entries: take entries, arrived: arrived, now: now, budget: budget, arg_max: arg_max)
}

pub type CallWant: send { key: Bytes, stream: u32, p: u64, arg: Bytes, deadline_ms: u32 }
pub opaque type Send: send { key: Bytes, stream: Bytes, p: u64, arg: Bytes, digest: store.RequestDigest, deadline: u64, budget: u64 }

pub fn prepare[G: send, H: send](r: Registry[G, H], a: Admitted, take want: CallWant) -> Result[Send, Refusal] {
    let known = map.contains(r.slots, want.key)
    if !known && !map.contains(r.gone, want.key) { return Error(NoEntry) }
    let mut allowed = false
    for key in a.entries { if key == want.key { allowed = true } }
    if !allowed { return Error(NotAllowed) }
    let size = list.len(want.arg)
    if size > a.arg_max { return Error(Budget(Room(requested: size, available: a.arg_max))) }
    if size > a.budget { return Error(Budget(Room(requested: size, available: a.budget))) }
    let relative: u64 = int.widen(want.deadline_ms)
    let end = std.clock.deadline_after_ms(a.arrived, relative)
    if want.deadline_ms == 0u32 || end <= a.now { return Error(Deadline) }
    if let Some(check) = map.get(r.checks, want.key) {
        if let Some(take why) = check(want.arg) { return Error(take why) }
    }
    let digest = store.request_digest(want.key, want.arg)
    let stream = match stream_key(a.caller, want.stream) { Ok(take b) => take b, Error(c) => return Error(Budget(room(c))) }
    let CallWant(key: take key, stream: _, p: p, arg: take arg, deadline_ms: _) = take want
    Ok(Send(key: take key, stream: take stream, p: p, arg: take arg, digest: digest, deadline: end, budget: a.budget))
}

// The wire owner owns this state.
type WireOwed: send { generation: u64, reply: Bytes }

// v2.19: `fence` is the session's fence root, made at join, and `round` the place's round
// register, from the join's answer. `check` and `sending_done` are the unit handed out last:
// its version, and a copy of its Outcome rows, which a Dropped Reset carries (§3).
pub opaque type WireWork { head: Option[HeadLease], asking: Option[Task[()]], plan_call: bool, timers: Map[u64, Task[()]], granted: Map[u64, Task[Outcome]], output: List[WireOutput], sending: List[WireMark], deadline: Option[u64], drain: Option[Latest[Option[DrainWindow]]], abandoned: u64, fence: Option[Latest[Fence]], round: Option[Latest[RoundAt]], check: Option[u64], sending_done: List[Done], join: Option[PubIn], sending_complete: bool, posts: List[Req] }

fn wire_work() -> WireWork { WireWork(head: None, asking: None, plan_call: false, timers: map.new(), granted: map.new(), output: list.new(), sending: list.new(), deadline: None, drain: None, abandoned: 0u64, fence: None, round: None, check: None, sending_done: list.new(), join: None, sending_complete: false, posts: list.new()) }

fn wire_cut(work: WireWork, clock: Clock) -> bool {
    wire_cut_at(work.drain, clock)
}

fn wire_cut_at(drain: Option[Latest[Option[DrainWindow]]], clock: Clock) -> bool {
    if let Some(root) = drain {
        if let Some(window) = drain_window(latest.read(root)) { return host.mono_ns(clock) >= window.deadline }
    }
    false
}

fn wire_admission_closed(work: WireWork, clock: Clock) -> bool {
    match work.drain { Some(root) => closing_at(root, clock), _ => false }
}
type WireHeld: send { stream: u32, p: u64, digest: store.RequestDigest, forwarded: bool, queued: u64, owed: List[WireOwed] }
type WireMark: send = Unit(Bytes) | V1 | WriteUnit(Bytes)

// The service and public transport callbacks share this owner-local queue. An
// external item has no outcome units or subscription generations to retire.
// `check` is a content unit's version, the oldest of its content components' (§3 "The release
// check"); None for a unit that carries no content and passes unchecked.
type WireOutput: send { frame: Frame, marks: List[WireMark], generations: List[(u32, u64)], external: bool, check: Option[u64] }
type WirePending: send { stream: u32, p: u64, slot: u32, deadline: u32, arg: Bytes, at: u64, grows: bool }
fn anonymous_caller(random: Random) -> Option[Caller] {
    let mut nonce: Bytes = list.with_capacity(16u64)
    host.random(random, mut nonce)
    Some(store.Caller(issuer: 1u8, subject: take nonce))
}

type WireHello[G: send]: send {
    binding: Option[(BindingJob[G], u64)], random: Random, tasks: Tasks, to: Sender[WireEvent]
}

fn wire_bind_hello[G: send](take job: WireHello[G]) -> () waits {
    let WireHello(binding: take binding, random: random, tasks: tasks, to: take to) = take job
    let identity_result: Option[Caller] = match take binding {
        Some((take app, allowance)) => bound_caller(tasks, take app, allowance),
        None => anonymous_caller(random),
    }
    let _ = channel.send(to, wire_event(HelloBound(take identity_result)))
}

fn deadline_notice(take stream: Bytes, p: u64, generation: u64) -> WireEvent {
    wire_event(FromRunner(Notice(e: Expired(Tick(stream: take stream, p, generation)))))
}

type WireHead: send = LifecycleHead(Sender[HeadInput])
type HeadOffer = Posted | InboxFull(Req) | InboxClosed

fn copy_wire_head(head: WireHead) -> WireHead {
    match head {
        LifecycleHead(to) => LifecycleHead(channel.sender(to)),
    }
}

fn try_head(head: WireHead, take req: Req) -> HeadOffer {
    match head {
        LifecycleHead(to) => match channel.try_send(to, RunRequest(take req)) {
            Ok(()) => Posted,
            Error(Full(RunRequest(take back))) => InboxFull(take back),
            Error(Full(_)) => fail("runner: the head inbox returned another input"),
            Error(Closed(_)) => InboxClosed,
        },
    }
}

type SubscriptionRoom: send {
    to: Sender[u64], from: Receiver[u64], slots: u64, limit: u64, held: u64, used: u64,
}

fn subscription_room(limit: u64, max_subs: u64) -> Result[SubscriptionRoom, Capacity] {
    let possible = int.saturating_sub(limit, 64u64) / 8u64
    let wanted = int.saturating_add(max_subs, 1u64)
    let slots = if wanted < possible { wanted } else { possible }
    if slots == 0u64 { return Error(Capacity(requested: 72u64, available: limit)) }
    let (to, from): (Sender[u64], Receiver[u64]) = channel.new(slots)
    Ok(SubscriptionRoom(to: take to, from: take from, slots: slots, limit: limit - (64u64 + slots * 8u64), held: 0u64, used: 0u64))
}

fn subscription_hold(mut quota: SubscriptionRoom, take caller: Caller, take key: Bytes, take arg: Bytes) -> Result[SubscriptionInput, Capacity] {
    while let Ok(charge) = channel.try_receive(quota.from) {
        quota.held -= charge
        quota.used -= 1u64
    }
    // Include the lease record. One refund fits for every issued lease.
    let charge = wire_round(list.capacity(key)) + wire_round(list.capacity(arg)) + wire_round(list.capacity(caller.subject)) + 64u64
    let available = quota.limit - quota.held
    if quota.used == quota.slots || charge > available { return Error(Capacity(requested: charge, available: available)) }
    let lease = match SubscriptionLease(refund: channel.sender(quota.to), charge: charge) { Ok(take l) => take l, Error((c, _)) => return Error(c) }
    quota.held += charge
    quota.used += 1u64
    Ok(SubscriptionInput(room: Some(take lease), key: take key, arg: take arg, caller: take caller))
}

// A place's wire configuration (§3 "Binding"): the binding's plain seed `B` and, when wire
// calls may reach `Granted` entries, the plain grant `G` each such call copies. The copiers
// carry the plain bounds into sessions that also support registries with movable trigger
// grants. `wire` makes both halves from one plain `G`; `wire_bind` makes the binding alone,
// so a registry whose `G` is movable still binds its sessions, and its wire calls to
// `Granted` entries are refused.
pub opaque type Wire[G: send, B: send]: send {
    grant: Option[WireGrant[G]], seed: B, duplicate: fn(B) -> B,
    bind: Option[StaticFn[fn(B, Bytes) -> Result[Caller, ()] waits]], bind_bytes: u64, bind_steps: u64,
}

type WireGrant[G: send]: send { value: G, duplicate: fn(G) -> G }

fn copy_plain[G: plain](g: G) -> G { g }

pub fn wire[G: plain + send](grant: G, bind: Option[StaticFn[fn(G, Bytes) -> Result[Caller, ()] waits]], bind_bytes: u64, bind_steps: u64) -> Wire[G, G] {
    let duplicate: fn(G) -> G = copy_plain
    Wire(grant: Some(WireGrant(value: grant, duplicate: duplicate)), seed: grant, duplicate: duplicate, bind: bind, bind_bytes: bind_bytes, bind_steps: bind_steps)
}

pub fn wire_bind[G: send, B: plain + send](seed: B, bind: StaticFn[fn(B, Bytes) -> Result[Caller, ()] waits], bind_bytes: u64, bind_steps: u64) -> Wire[G, B] {
    let duplicate: fn(B) -> B = copy_plain
    Wire(grant: None, seed: seed, duplicate: duplicate, bind: Some(bind), bind_bytes: bind_bytes, bind_steps: bind_steps)
}

fn copy_wire[G: send, B: send](supplied: Option[Wire[G, B]]) -> Option[Wire[G, B]] {
    match supplied {
        Some(w) => {
            let grant = match w.grant { Some(g) => Some(WireGrant(value: (g.duplicate)(g.value), duplicate: g.duplicate)), None => None }
            Some(Wire(grant: take grant, seed: (w.duplicate)(w.seed), duplicate: w.duplicate, bind: w.bind, bind_bytes: w.bind_bytes, bind_steps: w.bind_steps))
        },
        None => None,
    }
}

pub opaque type WireSession[G: send, B: send]: send {
    random: Random, wire: Option[Wire[G, B]], head: WireHead, clock: Clock, tasks: Tasks, config: WireConfig, target: String, n_place: u64,
    me: Option[Sender[WireEvent]], publisher: Option[Sender[PubIn]], caller: Option[Caller],
    // known: per entry, 1 registered, 2 gone, 0 neither (set at Hello from the one Registry).
    phase: u8, wants: List[Want], entries: List[Bytes], known: List[u8], launch: Option[GrantedLaunch[G]], placing: u64,
    pending: Option[WirePending],
    held: Map[Bytes, WireHeld], refusals: u64, last: u64, generation: u64,
    joined: Option[u64], joining: Option[Receiver[Admit]], join_lease: Option[WireJoinLease], marked: bool, mark: Option[Sender[()]], subscription: Option[(u32, u64)], subscription_room: Option[SubscriptionRoom], sub_generation: u64, subs: List[(u32, u64)], pub_subs: List[u32], reset_seen: bool,
    holding: bool, leaving: List[WireJoinLease], resubs: List[WireResub],
    // §3 "Repair": the drain token's sender, made at each join; the publisher holds the receiver.
    progress: Option[Sender[()]],
    // v2.22 (§3 "Repair"): this join's taken register, the `complete`s taken for this join, and
    // the count last published in the register.
    taken: Option[Latest[Taken]], completes: u64, told_taken: u64
}

// v2.19.2 (§3 "The owner asks for removal"): a replacing Subscribed held while the writer
// holds a content unit. The owner already counts the new instance as live.
type WireResub: send { sub: u32, generation: u64, input: SubscriptionInput }

pub fn wire_service[G: send, B: send](random: Random, take session_wire: Option[Wire[G, B]], head: Sender[HeadInput], clock: Clock, tasks: Tasks, config: WireConfig, a: Args) -> Service[WireSession[G, B]] {
    wire_service_with_head(random, take session_wire, LifecycleHead(channel.sender(head)), clock, tasks, config, launch_target(a))
}

fn wire_service_with_head[G: send, B: send](random: Random, take session_wire: Option[Wire[G, B]], take head: WireHead, clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, B]] {
    let context: WireSession[G, B] = WireSession(random: random, wire: take session_wire, head: take head, clock: clock, tasks: tasks, config: config, target: take target, n_place: 0u64,
        me: None, publisher: None, caller: None, phase: 0u8, wants: list.new(), entries: list.new(), known: list.new(), launch: None, placing: 0u64,
        pending: None, held: map.new(), refusals: 0u64, last: 0u64, generation: 0u64,
        joined: None, joining: None, join_lease: None, marked: false, mark: None, subscription: None, subscription_room: None, sub_generation: 0u64, subs: list.new(), pub_subs: list.new(), reset_seen: false,
        holding: false, leaving: list.new(), resubs: list.new(), progress: None, taken: None, completes: 0u64, told_taken: 0u64)
    Service(context: take context, step: wire_step, ready: wire_can_read, finish: wire_finish, check: wire_check_live)
}

fn wire_can_read[G: send, B: send](s: WireSession[G, B]) -> bool {
    (s.phase == 0u8 || s.phase == 3u8) && (match s.pending { None => true, _ => false }) && match s.joining { None => true, _ => false }
}

pub fn entry_key(identity: View[Bytes], args_fp: u64, result_fp: u64) -> Bytes {
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)
    list.append(mut key, identity)
    std.codec.put_u64(args_fp, mut key)
    std.codec.put_u64(result_fp, mut key)
    take key
}

fn wire_key(w: Want) -> Bytes { entry_key(view w.identity, w.args_fp, w.result_fp) }

fn answer_want[G: send, H: send](r: Registry[G, H], key: Bytes, slot: u32) -> Entry {
    if map.contains(r.slots, key) { Ready(slot) } else { Gone }
}

fn wire_stream(caller: Caller, number: u32) -> Bytes {
    result.unwrap(stream_key(caller, number))
}

fn wire_units[G: send, B: send](s: WireSession[G, B]) -> u64 {
    let mut units = 0u64
    for (_, h) in s.held {
        let live = list.len(h.owed) + h.queued
        units += if h.forwarded && live == 0u64 { 1u64 } else { live }
    }
    if let Some(p) = s.pending { if p.grows { units += 1u64 } }
    units
}

// std codec: a u32 tag, u32 lengths and integers at their width. A Done is
// stream 4 and p 8, then the Outcome's tag 4 and payload. Every variant is
// named, so a new one cannot fall into another's size.
fn wire_done_size(o: Outcome) -> u64 {
    12u64 + match o {
        Returned(b) => 8u64 + list.len(b),
        Failed(OutOfBytes(_)) => 24u64,
        Failed(OutOfTime(_)) => 16u64,
        Failed(Raised(_)) => 12u64,
        Failed(Gone) => 8u64,
        Refused(Budget(_)) => 24u64,
        Refused(Malformed(_)) => 20u64,
        Refused(NoEntry) => 8u64,
        Refused(Overloaded) => 8u64,
        Refused(Deadline) => 8u64,
        Refused(NotAllowed) => 8u64,
        Refused(RequestMismatch) => 8u64,
        Refused(HistoryUnavailable) => 8u64,
        Abandoned => 4u64,
        InDoubt => 4u64,
    }
}

fn wire_rows_size(rows: List[Row]) -> u64 {
    let mut size = 0u64
    for row in rows {
        size += 12u64 + list.len(row.key)
        if let Some(value) = row.value { size += 4u64 + list.len(value) }
    }
    size
}

fn wire_optional_bytes(b: Option[Bytes]) -> u64 {
    match b { Some(value) => 4u64 + list.len(value), None => 0u64 }
}

fn wire_done_bytes(done: List[Done]) -> u64 {
    let mut size = 0u64
    for d in done { size += wire_done_size(d.outcome) }
    size
}

fn wire_output_size(f: Frame) -> u64 {
    match f {
        Hello(token, wanted) => {
            let mut size = 12u64 + wire_optional_bytes(token)
            for entry in wanted { size += 20u64 + list.len(entry.identity) }
            size
        },
        Call(_, _, _, _, arg) => 28u64 + list.len(arg),
        Subscribe(_, _, arg, resume) => 20u64 + list.len(arg) + wire_optional_bytes(resume),
        Unsubscribe(_) => 8u64,
        Welcome(caller, _, _, digest, target, _) => 37u64 + list.len(caller.subject) + list.len(digest) + string.byte_len(target),
        Placed(Ready(_)) => 12u64,
        Placed(Resolve(_, args)) => 16u64 + list.len(args),
        Placed(Gone) => 8u64,
        Batch(_, complete, rows, done) => 24u64 + 4u64 * list.len(complete) + wire_rows_size(rows) + wire_done_bytes(done),
        Reset(_, done) => 16u64 + wire_done_bytes(done),
        Ended(_, o) => 8u64 + wire_done_size(o) - 12u64,
    }
}

// Retained row storage includes the 60-byte Row records and the rounded
// backing buffers of their key and value lists (WIRE-SPEC F4).
fn wire_rows_retained(rows: List[Row]) -> u64 {
    let mut size = wire_round(60u64 * list.capacity(rows))
    for row in rows {
        size += wire_round(list.capacity(row.key))
        if let Some(value) = row.value { size += wire_round(list.capacity(value)) }
    }
    size
}

fn wire_batch_charge(complete: List[u32], rows: List[Row], done: List[Done], reserved: bool) -> u64 {
    let row_payload = wire_rows_size(rows)
    let retained = wire_rows_retained(rows)
    24u64 + 4u64 * list.len(complete) + (if retained > row_payload { retained } else { row_payload })
        + (if reserved { 0u64 } else { wire_done_bytes(done) })
}

fn wire_output_charge(f: Frame, reserved: bool) -> u64 {
    // Slot and V1 marks already hold the outcome reserve through handoff.
    match f {
        Batch(_, complete, rows, done) => wire_batch_charge(complete, rows, done, reserved),
        Reset(_, _) => if reserved { 16u64 } else { wire_output_size(f) },
        _ => wire_output_size(f),
    }
}

fn wire_queued_bytes(output: List[WireOutput]) -> u64 {
    // WireOutput's charge-v1 size is Frame (88), two Lists (24 each)
    // and the external flag (1).
    let mut size = wire_round(137u64 * list.capacity(output))
    for o in output { size += wire_output_charge(o.frame, list.len(o.marks) != 0u64) }
    size
}

fn wire_queue_external(mut work: WireWork, c: WireConfig, take frame: Frame, check: Option[u64]) -> Result[(), std.wsock.Error] {
    if wire_output_size(frame) > c.socket.max_frame { return Error(Protocol(1009u16)) }
    if list.len(work.output) >= 1u64 + c.q || wire_queued_bytes(work.output) + wire_output_charge(frame, false) > c.budget { return Error(Busy) }
    let item = WireOutput(frame: take frame, marks: list.new(), generations: list.new(), external: true, check: check)
    list.push(mut work.output, take item)
    Ok(())
}

fn wire_queue(mut output: List[WireOutput], take frame: Frame, take marks: List[WireMark], take generations: List[(u32, u64)]) {
    wire_queue_checked(mut output, take frame, take marks, take generations, None)
}

fn wire_queue_checked(mut output: List[WireOutput], take frame: Frame, take marks: List[WireMark], take generations: List[(u32, u64)], check: Option[u64]) {
    list.push(mut output, WireOutput(frame: take frame, marks: take marks, generations: take generations, external: false, check: check))
}

fn wire_refused[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, stream: u32, p: u64, take why: Refusal) -> Result[(), u16] {
    if s.refusals >= 1u64 + s.config.q { return Error(1008u16) }
    s.refusals += 1u64
    let mut done: List[Done] = list.new()
    list.push(mut done, Done(stream: stream, p: p, outcome: Refused(take why)))
    let mut marks: List[WireMark] = list.new()
    list.push(mut marks, V1)
    let version = s.last
    wire_queue(mut work.output, Batch(version, list.new(), list.new(), take done), take marks, list.new())
    Ok(())
}

fn wire_row[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, key: Bytes, stream: u32, p: u64, version: u64, take outcome: Outcome) {
    let mut done: List[Done] = list.new()
    list.push(mut done, Done(stream: stream, p: p, outcome: take outcome))
    let mut marks: List[WireMark] = list.new()
    list.push(mut marks, Unit(clone(key)))
    wire_queue(mut work.output, Batch(version, list.new(), list.new(), take done), take marks, list.new())
}

fn wire_reset[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], version: u64) -> Result[(), u16] {
    if s.reset_seen { return Error(1008u16) }
    s.reset_seen = true
    wire_reset_rows(mut s, mut output, version, list.new(), list.new())
}

fn wire_reset_rows[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], version: u64, take latest_done: List[Done], take latest_marks: List[WireMark]) -> Result[(), u16] {
    let mut done: List[Done] = list.new()
    let mut marks: List[WireMark] = list.new()
    let all = replace(mut output, list.new())
    for take o in take all {
        if o.external {
            list.push(mut output, take o)
            continue
        }
        let WireOutput(frame: take f, marks: take held, generations: _, external: _, check: _) = take o
        for take m in take held { list.push(mut marks, take m) }
        match take f {
            Batch(_, _, _, take ds) => for take d in take ds { list.push(mut done, take d) },
            Reset(_, take ds) => for take d in take ds { list.push(mut done, take d) },
            _ => {},
        }
    }
    for take d in latest_done { list.push(mut done, take d) }
    for take m in latest_marks { list.push(mut marks, take m) }
    let _ = replace(mut s.subs, list.new())
    let _ = replace(mut s.pub_subs, list.new())
    wire_leave(mut s)
    s.joined = None
    let _ = replace(mut s.joining, None)
    let _ = replace(mut s.subscription, None)
    wire_queue(mut output, Reset(version, take done), take marks, list.new())
    Ok(())
}

fn wire_drop_stale(mut generations: List[(u32, u64)], active: List[(u32, u64)]) -> bool {
    let mut index = list.len(generations)
    let mut changed = false
    while index != 0u64 {
        index -= 1u64
        let (sub, generation) = generations[index]
        if sub_generation(active, sub) != Some(generation) {
            let _ = list.remove(mut generations, index)
            changed = true
        }
    }
    changed
}

fn wire_current_output(active: List[(u32, u64)], take output: WireOutput) -> Option[WireOutput] {
    if output.external { return Some(take output) }
    let WireOutput(frame: take f, marks: take marks, generations: take stamps, external: external, check: check) = take output
    let mut generations = take stamps
    if let Ended(sub, _) = f {
        // A terminal frame has no active subscription unless the id was reused.
        if let Some(generation) = sub_generation(active, sub) {
            if sub_generation(generations, sub) != Some(generation) { return None }
        }
    } else {
        if wire_drop_stale(mut generations, active) {
            if let Batch(version, take complete, take rows, take done) = take f {
                let mut live_complete = take complete
                let mut kept = 0u64
                for index in 0u64 .. list.len(live_complete) {
                    if let Some(_) = sub_generation(generations, live_complete[index]) {
                        list.swap(mut live_complete, kept, index)
                        kept += 1u64
                    }
                }
                while list.len(live_complete) > kept { let _ = list.pop(mut live_complete) }
                let mut live_rows = take rows
                kept = 0u64
                for index in 0u64 .. list.len(live_rows) {
                    if let Some(_) = sub_generation(generations, live_rows[index].sub) {
                        list.swap(mut live_rows, kept, index)
                        kept += 1u64
                    }
                }
                while list.len(live_rows) > kept { let _ = list.pop(mut live_rows) }
                if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 && list.len(done) == 0u64 { return None }
                // Content left out of a unit is gone from it; what stays keeps the unit's version.
                let kept_check: Option[u64] = if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 { None } else { check }
                return Some(WireOutput(frame: Batch(version, take live_complete, take live_rows, take done), marks: take marks, generations: take generations, external: external, check: kept_check))
            }
            return None
        }
    }
    Some(WireOutput(frame: take f, marks: take marks, generations: take generations, external: external, check: check))
}

// A `complete` replaces its sub's image from empty (v2.20 item 5), so whatever the owner still
// holds of the same instance ahead of it, rows or an earlier `complete`, is superseded and goes
// before `budget` is checked: the rows a Reset weighs are coalesced (§3). Outcomes, their marks
// and other subs' content stay.
fn wire_supersede(mut output: List[WireOutput], replacing: List[(u32, u64)]) {
    let mut kept = 0u64
    for index in 0u64 .. list.len(output) {
        let empty = WireOutput(frame: Reset(0u64, list.new()), marks: list.new(), generations: list.new(), external: false, check: None)
        let queued = list.set(mut output, index, take empty)
        if let Some(take current) = wire_superseded(take queued, replacing) {
            let _ = list.set(mut output, kept, take current)
            kept += 1u64
        }
    }
    while list.len(output) > kept { let _ = list.pop(mut output) }
}

fn wire_superseded(take output: WireOutput, replacing: List[(u32, u64)]) -> Option[WireOutput] {
    if output.external { return Some(take output) }
    let WireOutput(frame: take f, marks: take marks, generations: take stamps, external: external, check: check) = take output
    let mut generations = take stamps
    let mut gone: List[(u32, u64)] = list.new()
    if let Batch(_, _, _, _) = f {
        let mut index = list.len(generations)
        while index != 0u64 {
            index -= 1u64
            let (sub, generation) = generations[index]
            if sub_generation(replacing, sub) == Some(generation) {
                let _ = list.remove(mut generations, index)
                list.push(mut gone, (sub, generation))
            }
        }
    }
    if list.len(gone) == 0u64 { return Some(WireOutput(frame: take f, marks: take marks, generations: take generations, external: external, check: check)) }
    if let Batch(version, take complete, take rows, take done) = take f {
        let mut live_complete = take complete
        let mut kept = 0u64
        for index in 0u64 .. list.len(live_complete) {
            if let None = sub_generation(gone, live_complete[index]) {
                list.swap(mut live_complete, kept, index)
                kept += 1u64
            }
        }
        while list.len(live_complete) > kept { let _ = list.pop(mut live_complete) }
        let mut live_rows = take rows
        kept = 0u64
        for index in 0u64 .. list.len(live_rows) {
            if let None = sub_generation(gone, live_rows[index].sub) {
                list.swap(mut live_rows, kept, index)
                kept += 1u64
            }
        }
        while list.len(live_rows) > kept { let _ = list.pop(mut live_rows) }
        if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 && list.len(done) == 0u64 { return None }
        let kept_check: Option[u64] = if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 { None } else { check }
        return Some(WireOutput(frame: Batch(version, take live_complete, take live_rows, take done), marks: take marks, generations: take generations, external: external, check: kept_check))
    }
    None
}

fn wire_prune_output[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], retired: Option[u32]) {
    let mut kept = 0u64
    for index in 0u64 .. list.len(output) {
        let empty = WireOutput(frame: Reset(0u64, list.new()), marks: list.new(), generations: list.new(), external: false, check: None)
        let queued = list.set(mut output, index, take empty)
        if !queued.external { if let Ended(sub, _) = queued.frame { if retired == Some(sub) { continue } } }
        if let Some(take current) = wire_current_output(s.subs, take queued) {
            let _ = list.set(mut output, kept, take current)
            kept += 1u64
        }
    }
    while list.len(output) > kept { let _ = list.pop(mut output) }
}

// A content unit's Outcome rows are copied before it is handed out, so a Dropped Reset can
// carry them (§3); a copy that cannot be made closes the session (1013) rather than send the
// unit unchecked or lose the rows.
fn wire_take_output[G: send, B: send](s: WireSession[G, B], mut work: WireWork) -> Result[Option[Frame], u16] {
    let selected = loop {
        if list.len(work.output) == 0u64 { return Ok(None) }
        let next = list.remove(mut work.output, 0u64)
        if let Some(take current) = wire_current_output(s.subs, take next) { break take current }
    }
    let WireOutput(frame: take f, marks: take marks, generations: _, external: _, check: check) = take selected
    work.sending = take marks
    work.check = check
    work.sending_done = list.new()
    work.sending_complete = wire_carries_complete(f)
    if let Some(_) = check {
        if let Batch(_, _, _, done) = f {
            if list.len(done) != 0u64 {
                let copied: List[Done] = clone(done)
                { work.sending_done = take copied }
            }
        }
    }
    Ok(Some(take f))
}

// v2.19 (§3): the writer dropped the content unit it was handed. Every content component
// the owner holds goes; every Outcome row, the dropped unit's included, rides in one Reset
// that never counts toward the protocol-error close.
fn wire_dropped[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork) -> Result[(), u16] {
    let marks = replace(mut work.sending, list.new())
    let done = replace(mut work.sending_done, list.new())
    work.check = None
    work.sending_complete = false
    let version = s.last
    wire_reset_rows(mut s, mut work.output, version, take done, take marks)
}

fn wire_sent[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork) {
    work.check = None
    work.sending_complete = false
    work.sending_done = list.new()
    let marks = replace(mut work.sending, list.new())
    for take mark in take marks {
        let key = match take mark {
            V1 => { s.refusals -= 1u64; continue },
            Unit(take key) => take key,
            WriteUnit(take key) => take key,
        }
        if let Some(take found) = map.remove(mut s.held, key) {
            let mut h = take found
            h.queued -= 1u64
            if h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64 { map.insert(mut s.held, take key, take h) }
        }
    }
}

fn wire_begin_hello[G: send, B: send](s: WireSession[G, B], mut work: WireWork, take credential: Option[Bytes]) -> Result[(), u16] {
    let to = match s.me { Some(to) => channel.sender(to), None => return Error(1008u16) }
    let mut binding: Option[(BindingJob[B], u64)] = None
    let mut allowance = 4096u64
    if let Some(w) = s.wire {
        if let Some(bind) = w.bind {
            let raw = match take credential { Some(take payload) => take payload, None => list.new() }
            let app = BindingJob(seed: (w.duplicate)(w.seed), bind: bind, credential: take raw, steps: w.bind_steps)
            allowance = int.saturating_add(allowance, w.bind_bytes)
            binding = Some((take app, w.bind_bytes))
        }
    }
    let job = WireHello(binding: take binding, random: s.random, tasks: s.tasks, to: take to)
    let run: fn(take WireHello[B]) -> () waits = wire_bind_hello
    let h = task.spawn(s.tasks, bytes allowance, take job, run)
 work.asking = Some(take h); Ok(())
}

pub type CallRun: send = Computed(Outcome) | Launched | Durable | Uncallable
pub type ServicePlan: send = NoAction | PlanRefusal(u32, u64, Refusal) | PlannedCall(Send, Admitted, u32, Bytes, CallRun) | PlannedUpdate(List[WireOutput], List[u64]) | PlannedSubscribe(u32, SubscriptionInput) | SubscriptionRefusal(u32, Outcome) | ResumeReset

fn wire_plan_call[G: send, H: send, B: send](mut s: WireSession[G, B], r: Registry[G, H], take pending: WirePending) -> Result[ServicePlan, u16] {
    let WirePending(stream: stream, p: p, slot: slot, deadline: deadline_ms, arg: take arg, at: at, grows: _) = take pending
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { return Ok(PlanRefusal(stream, p, NoEntry)) }
    let caller: Caller = match s.caller {
        Some(a) => {
            let copied: Caller = clone(a)
            take copied
        },
        _ => return Error(1008u16),
    }
    let mut entries: List[Bytes] = list.new()
    let copied_key: Bytes = clone(s.entries[index])
    let key = take copied_key
    let copied_entry: Bytes = clone(key)
    let key_copy = take copied_entry
    list.push(mut entries, take key_copy)
    let context = admitted(take caller, take entries, at, host.mono_ns(s.clock), s.config.budget, s.config.socket.max_frame)
    let want = CallWant(key: take key, stream: stream, p: p, arg: take arg, deadline_ms: deadline_ms)
    match prepare(r, context, take want) {
        Ok(take sent) => {
            let backing: Bytes = list.with_capacity(DONE_MAX)
            let run = match map.get(r.slots, sent.key) {
                Some(Compute(_)) => Computed(call(r, sent.key, sent.arg)),
                Some(Granted(bind)) => { s.launch = Some(bind()); Launched },
                Some(Transact(_, _, _, _, _)) => Durable,
                None => Durable,
                _ => Uncallable,
            }
            Ok(PlannedCall(take sent, take context, stream, take backing, take run))
        },
        Error(take why) => Ok(PlanRefusal(stream, p, take why)),
    }
}

fn wire_apply_plan[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, take plan: ServicePlan) -> Result[(), u16] {
    let (take sent, take context, stream, take reply, take run) = match take plan {
        NoAction => return Ok(()),
        PlanRefusal(stream, p, take why) => return wire_refused(mut s, mut work, stream, p, take why),
        PlannedUpdate(take output, take completed) => {
            work.output = take output
            for id in completed { let _ = map.remove(mut work.timers, id) }
            return Ok(())
        },
        PlannedSubscribe(sub, take input) => return wire_apply_subscribe(mut s, mut work, sub, take input),
        SubscriptionRefusal(sub, take why) => { wire_end(mut s, mut work.output, sub, take why); return Ok(()) },
        ResumeReset => {
            let version = s.last
            return wire_reset_rows(mut s, mut work.output, version, list.new(), list.new())
        },
        PlannedCall(take prepared, take caller_context, stream, take reply, take planned) =>
            (take prepared, take caller_context, stream, take reply, take planned),
    }
    let p = sent.p
    let k = slot_key(sent.stream, p)
    let (forwarded, queued) = match map.get(s.held, k) {
        Some(h) => {
            if (h.forwarded || list.len(h.owed) != 0u64) && h.digest != sent.digest { return Error(1008u16) }
            (h.forwarded, h.queued)
        },
        None => (false, 0u64),
    }
    if wire_admission_closed(work, s.clock) && !forwarded { return wire_refused(mut s, mut work, stream, p, Overloaded) }
    let computed = match take run {
        Launched => {
            let Admitted(caller: take caller, ..) = take context
            return wire_start_granted(mut s, mut work, take caller, take sent, take k, stream, take reply)
        },
        Uncallable => return wire_refused(mut s, mut work, stream, p, NotAllowed),
        Computed(take result) => Some(take result),
        Durable => None,
    }
    if let Some(take outcome) = take computed {
        if wire_cut(work, s.clock) { work.abandoned += 1u64; return Ok(()) }
        let held = WireHeld(stream: stream, p: p, digest: sent.digest, forwarded: false, queued: queued + 1u64, owed: list.new())
        map.insert(mut s.held, clone(k), take held)
        let version = s.last
        wire_row(mut s, mut work, k, stream, p, version, take outcome)
        return Ok(())
    }
    if let None = work.head {
        match head_lease(copy_wire_head(s.head)) {
            Ok(take lease) => { work.head = Some(take lease) },
            Error(_) => return wire_refused(mut s, mut work, stream, p, Overloaded),
        }
    }
    let seed = if !forwarded {
        let made = match work.head { Some(lease) => owner_seed(lease), None => fail("runner: missing head lease") }
        match take made { Ok(take x) => take x, Error(_) => return wire_refused(mut s, mut work, stream, p, Overloaded) }
    } else {
        None
    }
    s.generation += 1u64
    let until = match work.deadline { Some(cut) => if cut < sent.deadline { cut } else { sent.deadline }, None => sent.deadline }
    let h = match s.me {
        Some(to) => std.clock.alarm(s.tasks, s.clock, until, to, deadline_notice(clone(sent.stream), p, s.generation)),
        None => return Error(1008u16),
    }
    map.reserve(mut work.timers, 1u64)
    map.reserve(mut s.held, 1u64)
    let owed = WireOwed(generation: s.generation, reply: take reply)
    if forwarded {
        let mut held = option.unwrap(map.remove(mut s.held, k))
        list.push(mut held.owed, take owed)
        map.insert(mut s.held, take k, take held)
    } else {
        let Send(key: take entry, stream: take named, p: position, arg: take argument, digest: digest, deadline: deadline, budget: _) = take sent
        let (live, identity) = match work.head {
            Some(lease) => (latest.handle(lease.live), latest.handle(lease.identity)),
            None => fail("runner: missing head lease"),
        }
        let Admitted(caller: take principal, ..) = take context
        let request = Request(caller: take principal, stream: take named, p: position, key: take entry, arg: take argument, digest: digest, deadline: deadline, reply_to: wire_me(s), live: take live, identity: take identity, seed: take seed)
        let mut sends: List[WireOwed] = list.new()
        list.push(mut sends, take owed)
        // v2.23: a full head inbox does not refuse. The request waits in `posts`, in order, and
        // the owner loop posts it with a waiting send (wire_post). The slot table still bounds a
        // session to 1 + q requests at the head.
        let req = Req(e: Requested(take request))
        if list.len(work.posts) != 0u64 {
            list.push(mut work.posts, take req)
        } else {
            match try_head(s.head, take req) {
                Posted => (),
                InboxFull(take back) => list.push(mut work.posts, take back),
                InboxClosed => return Error(1011u16),
            }
        }
        map.insert(mut s.held, take k, WireHeld(stream: stream, p: p, digest: digest, forwarded: true, queued: queued, owed: take sends))
    }
    map.insert(mut work.timers, s.generation, take h)
    Ok(())
}

fn wire_start_granted[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, take caller: Caller, take sent: Send, take key: Bytes, stream: u32, take reply: Bytes) -> Result[(), u16] {
    let launch = replace(mut s.launch, None)
    let Send(key: _, stream: take named, p: p, arg: take argument, digest: digest, deadline: deadline, budget: _) = take sent
    let copied: Option[G] = match s.wire {
        Some(w) => match w.grant { Some(g) => Some((g.duplicate)(g.value)), None => None },
        None => None,
    }
    let seed = match take copied {
        Some(take g) => take g,
        None => return wire_refused(mut s, mut work, stream, p, NotAllowed),
    }
    if host.mono_ns(s.clock) >= deadline { return wire_refused(mut s, mut work, stream, p, Deadline) }
    map.reserve(mut work.timers, 1u64)
    map.reserve(mut work.granted, 1u64)
    map.reserve(mut s.held, 1u64)
    let mut fresh: List[WireOwed] = list.new()
    let reserved: Result[(), Capacity] = match map.update(mut s.held, key, scoped fn(mut held: WireHeld) -> Result[(), Capacity] {
        list.try_reserve(mut held.owed, 1u64)
    }) {
        Some(outcome) => outcome,
        None => list.try_reserve(mut fresh, 1u64),
    }
    if let Error(cap) = reserved { return wire_refused(mut s, mut work, stream, p, Budget(room(cap))) }
    s.generation += 1u64
    let generation = s.generation
    let until = match work.deadline { Some(cut) => if cut < deadline { cut } else { deadline }, None => deadline }
    let to = wire_me(s)
    let timer = std.clock.alarm(s.tasks, s.clock, until, to, deadline_notice(clone(named), p, generation))
    let report = WireGrantReport(tick: Tick(stream: take named, p: p, generation: generation), to: take to, clock: s.clock, deadline: until)
    let launched: Result[Task[Outcome], Refusal] = match take launch {
        Some(take prepared) => match (prepared.go)(s.tasks, Direct(take seed), take caller, take argument, Some(WireGrant(take report))) {
            Ok(take handle) => Ok(take handle),
            Error(cap) => Error(Budget(room(cap))),
        },
        None => Error(NoEntry),
    }
    let job = match take launched {
        Ok(take handle) => take handle,
        Error(take reason) => return wire_refused(mut s, mut work, stream, p, take reason),
    }
    let mut held = match map.remove(mut s.held, key) {
        Some(take previous) => take previous,
        None => WireHeld(stream: stream, p: p, digest: digest, forwarded: false, queued: 0u64, owed: take fresh),
    }
    list.push(mut held.owed, WireOwed(generation: generation, reply: take reply))
    map.insert(mut s.held, take key, take held)
    map.insert(mut work.timers, generation, take timer)
    map.insert(mut work.granted, generation, take job)
    Ok(())
}

// An Ended the owner makes itself passes unchecked; a publisher-made one is content (§3).
fn wire_end[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], sub: u32, take outcome: Outcome) {
    wire_end_checked(mut s, mut output, sub, take outcome, None)
}

fn wire_end_checked[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], sub: u32, take outcome: Outcome, check: Option[u64]) {
    let mut generations: List[(u32, u64)] = list.new()
    if let Some(generation) = sub_generation(s.subs, sub) { stamp_rows(mut generations, sub, generation) }
    wire_stop_sub(mut s, mut output, sub)
    wire_queue_checked(mut output, Ended(sub, take outcome), list.new(), take generations, check)
}

fn wire_subscribed[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, sub: u32, take input: SubscriptionInput) {
    let who = option.unwrap(s.joined)
    let to_pub = wire_publisher(s)
    s.sub_generation += 1u64
    let generation = s.sub_generation
    let mut index = 0u64
    while index < list.len(s.subs) && s.subs[index].0 != sub { index += 1u64 }
    if index == list.len(s.subs) {
        list.reserve(mut s.subs, 1u64)
    }
    let registered = list.contains(s.pub_subs, sub)
    if !registered {
        list.reserve(mut s.pub_subs, 1u64)
    }
    if registered && s.holding {
        // v2.19.2: this Subscribed removes the publisher's live instance, so it waits for the writer.
        let mut at = 0u64
        while at < list.len(s.resubs) && s.resubs[at].sub != sub { at += 1u64 }
        let held = WireResub(sub: sub, generation: generation, input: take input)
        if at == list.len(s.resubs) {
            list.reserve(mut s.resubs, 1u64)
            list.push(mut s.resubs, take held)
        } else {
            let _ = list.set(mut s.resubs, at, take held)
        }
    } else {
        let sent = channel.try_send(to_pub, PubIn(e: WireSubscribed(who, sub, generation, take input)))
        if let Error(_) = take sent { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return }
    }
    if index == list.len(s.subs) {
        list.push(mut s.subs, (sub, generation))
    } else {
        s.subs[index] = (sub, generation)
    }
    if !registered { list.push(mut s.pub_subs, sub) }
}

fn wire_plan_subscribe[G: send, H: send, B: send](mut s: WireSession[G, B], r: Registry[G, H], sub: u32, slot: u32, take arg: Bytes, take resume: Option[Bytes]) -> Result[ServicePlan, u16] {
    if s.phase != 3u8 { return Error(1008u16) }
    if let Some(_) = resume { return Ok(ResumeReset) }
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { return Ok(SubscriptionRefusal(sub, Refused(NoEntry))) }
    let cloned: Bytes = clone(s.entries[index])
    let key = take cloned
    if !map.contains(r.slots, key) {
        let outcome: Outcome = if map.contains(r.gone, key) { Failed(Gone) } else { Refused(NoEntry) }
        return Ok(SubscriptionRefusal(sub, take outcome))
    }
    let is_query = match map.get(r.slots, key) { Some(Query(_, _, _)) => true, _ => false }
    if !is_query { return Ok(SubscriptionRefusal(sub, Refused(NoEntry))) }
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if !registered && list.len(s.pub_subs) >= s.config.max_subs { return Ok(SubscriptionRefusal(sub, Refused(NotAllowed))) }
    let refused = match map.get(r.checks, key) { Some(check) => check(arg), _ => { let no_refusal: Option[Refusal] = None; no_refusal } }
    if let Some(take why) = take refused { return Ok(SubscriptionRefusal(sub, Refused(take why))) }
    if let None = s.subscription_room {
        let limit = int.saturating_sub(WIRE_SESSION_CEILING, wire_variable_peak(s.config) + s.config.n_granted)
        match subscription_room(limit, s.config.max_subs) {
            Ok(take quota) => { s.subscription_room = Some(take quota) },
            Error(_) => return Ok(SubscriptionRefusal(sub, Refused(Overloaded))),
        }
    }
    let caller: Caller = match s.caller {
        Some(held) => clone(held),
        None => return Error(1008u16),
    }
    let mut quota = option.unwrap(replace(mut s.subscription_room, None))
    let held = subscription_hold(mut quota, take caller, take key, take arg)
    s.subscription_room = Some(take quota)
    match take held {
        Ok(take input) => Ok(PlannedSubscribe(sub, take input)),
        Error(_) => Ok(SubscriptionRefusal(sub, Refused(Overloaded))),
    }
}

fn wire_apply_subscribe[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, sub: u32, take input: SubscriptionInput) -> Result[(), u16] {
    if wire_admission_closed(work, s.clock) {
        wire_end(mut s, mut work.output, sub, Refused(Overloaded))
        return Ok(())
    }
    if let Some(_) = s.joined { wire_subscribed(mut s, mut work, sub, take input); return Ok(()) }
    let (told, hear): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    // v2.19: the session's fence root, at {0, 0}; the publisher gets a handle in the Join.
    let fence = latest.new(arc.new(Fence(prior: 0u64, latest: 0u64)))
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (token, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    if let None = work.head {
        match head_lease(copy_wire_head(s.head)) {
            Ok(take h) => { work.head = Some(take h) },
            Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) },
        }
    }
    let identity = match work.head { Some(h) => latest.handle(h.identity), None => fail("runner: missing head lease") }
    // v2.22: the first Subscribe rides in the Join, so its room is reserved now.
    list.reserve(mut s.subs, 1u64)
    list.reserve(mut s.pub_subs, 1u64)
    let taken = latest.new(arc.new(Taken(n: 0u64)))
    s.sub_generation += 1u64
    let generation = s.sub_generation
    let first = Some(JoinSubscribe(sub: sub, generation: generation, input: take input))
    let join = if s.marked {
        s.mark = Some(take closing)
        Join(to: wire_me(s), told: take told, mark: Some(take closed), closed: None, identity: Some(take identity), fence: Some(latest.handle(fence)), progress: Some(take progress), taken: Some(latest.handle(taken)), first: take first)
    } else {
        list.reserve(mut s.leaving, 1u64)
        let lease = match WireJoinLease(closing: take closing, publisher: wire_publisher(s)) { Ok(take l) => take l, Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) } }
        s.join_lease = Some(take lease)
        Join(to: wire_me(s), told: take told, mark: None, closed: Some(take closed), identity: Some(take identity), fence: Some(latest.handle(fence)), progress: Some(take progress), taken: Some(latest.handle(taken)), first: take first)
    }
    // v2.22: the owner's loop sends the Join with a waiting send (§3); it holds no sub yet.
    work.join = Some(PubIn(e: Joined(take join)))
    work.fence = Some(take fence)
    s.progress = Some(take token)
    s.taken = Some(take taken)
    s.completes = 0u64
    s.told_taken = 0u64
    // A fresh join can wait for its id while an old terminal frame is queued.
    wire_prune_output(mut s, mut work.output, Some(sub))
    s.joining = Some(take hear)
    s.subscription = Some((sub, generation))
    Ok(())
}

fn wire_update[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, take upd: Update) -> Result[(), u16] {
    let mut completed: List[u64] = list.new()
    let result = wire_stage_update(mut s, mut work.output, mut completed, work.drain, take upd)
    for id in completed { let _ = map.remove(mut work.timers, id) }
    result
}

fn wire_stage_update[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], mut completed: List[u64], drain: Option[Latest[Option[DrainWindow]]], take upd: Update) -> Result[(), u16] {
    let Update(version: at, content: take content, outcomes: take answers) = take upd
    let mut done: List[Done] = list.new()
    let mut marks: List[WireMark] = list.new()
    for answer in answers {
        wire_answer(mut s, mut completed, drain, answer, mut done, mut marks)?
    }
    let current = match content {
        Some(o) => match s.joined { Some(who) => who == o.session, _ => false },
        None => false,
    }
    if !current && list.len(done) == 0u64 { return Ok(()) }
    s.last = if at > s.last { at } else { s.last }
    let version = s.last
    let mut live_rows: List[Row] = list.new()
    let mut live_complete: List[u32] = list.new()
    let mut ended: List[(u32, u64, Outcome)] = list.new()
    let mut generations: List[(u32, u64)] = list.new()
    let mut computed = 0u64
    if current {
        let Owe(session: _, version: content_version, generations: take stamps, complete: take complete, rows: take rows, ended: take stopped, reset: reset) = option.unwrap(take content)
        computed = content_version
        s.completes += list.len(complete)
        if reset {
            if s.reset_seen { return Error(1008u16) }
            s.reset_seen = true
            return wire_reset_rows(mut s, mut output, version, take done, take marks)
        }
        generations = take stamps
        let _ = wire_drop_stale(mut generations, s.subs)
        for take row in rows {
            if let Some(_) = sub_generation(generations, row.sub) { list.push(mut live_rows, take row) }
        }
        for sub in complete {
            if let Some(_) = sub_generation(generations, sub) { list.push(mut live_complete, sub) }
        }
        ended = take stopped
    }
    let reserve = wire_outcome_reserve(s.config)
    let envelope = 24u64 + 4u64 * list.len(live_complete)
    let allowance = int.saturating_sub(s.config.socket.max_frame, reserve + envelope)
    let requested = wire_rows_size(live_rows)
    if requested > allowance {
        if list.len(live_complete) == 0u64 {
            if s.reset_seen { return Error(1008u16) }
            s.reset_seen = true
            return wire_reset_rows(mut s, mut output, version, take done, take marks)
        }
        for sub in live_complete { wire_end(mut s, mut output, sub, Refused(Budget(Room(requested: requested, available: allowance)))) }
        live_complete = list.new()
        live_rows = list.new()
        generations = list.new()
    }
    if list.len(live_complete) != 0u64 {
        let mut replacing: List[(u32, u64)] = list.new()
        for sub in live_complete {
            if let Some(generation) = sub_generation(generations, sub) { list.push(mut replacing, (sub, generation)) }
        }
        wire_supersede(mut output, replacing)
    }
    if list.len(live_rows) != 0u64 || list.len(live_complete) != 0u64 || list.len(done) != 0u64 {
        let charge = wire_batch_charge(live_complete, live_rows, done, list.len(marks) != 0u64)
        if wire_queued_bytes(output) + charge > s.config.budget {
            wire_prune_output(mut s, mut output, None)
            if wire_queued_bytes(output) + charge > s.config.budget {
                if s.reset_seen { return Error(1008u16) }
                s.reset_seen = true
                return wire_reset_rows(mut s, mut output, version, take done, take marks)
            }
        }
        let check = if list.len(live_rows) != 0u64 || list.len(live_complete) != 0u64 { Some(computed) } else { None }
        let frame: Frame = Batch(version, take live_complete, take live_rows, take done)
        wire_queue_checked(mut output, take frame, take marks, take generations, check)
    }
    for take e in ended {
        let (sub, generation, take why) = take e
        if sub_generation(s.subs, sub) == Some(generation) {
            wire_forget_sub(mut s, sub)
            wire_end_checked(mut s, mut output, sub, take why, Some(computed))
        }
    }
    Ok(())
}

fn wire_answer[G: send, B: send](mut s: WireSession[G, B], mut completed: List[u64], drain: Option[Latest[Option[DrainWindow]]], told: KeyedDone, mut done: List[Done], mut marks: List[WireMark]) -> Result[(), u16] {
    if wire_cut_at(drain, s.clock) { return Ok(()) }
    // A pre-W3c stored reply can exceed today's producer bound. Preserve its
    // bytes in the store and fail delivery explicitly before retaining its row.
    if let Returned(b) = told.outcome { if list.len(b) > MAX_RETURNED_BYTES { return Error(1009u16) } }
    let key = slot_key(told.stream, told.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        h.forwarded = false
        let owed = replace(mut h.owed, list.new())
        let count = list.len(owed)
        h.queued += count
        for take owing in owed {
            let WireOwed(generation: generation, reply: take backing) = take owing
            list.push(mut completed, generation)
            let outcome: Outcome = match told.outcome {
                Returned(payload) => {
                    let mut reply = take backing
                    list.append(mut reply, payload)
                    let updated: Outcome = Returned(take reply)
                    take updated
                },
                _ => clone(told.outcome),
            }
            let mark_key: Bytes = clone(key)
            let mark: WireMark = match outcome {
                Returned(_) => WriteUnit(take mark_key),
                Failed(_) => WriteUnit(take mark_key),
                _ => Unit(take mark_key),
            }
            list.push(mut done, Done(stream: h.stream, p: h.p, outcome: take outcome))
            list.push(mut marks, take mark)
        }
        if h.queued != 0u64 { map.insert(mut s.held, take key, take h) }
    }
    Ok(())
}

fn wire_expired[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, tick: Tick) {
    let _ = map.remove(mut work.granted, tick.generation)
    wire_finish_owed(mut s, mut work, tick, Abandoned)
}

fn wire_finish_granted[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, tick: Tick, take outcome: Outcome) {
    if let Some(_) = map.remove(mut work.granted, tick.generation) {
        wire_finish_owed(mut s, mut work, tick, take outcome)
    }
}

fn wire_finish_owed[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, tick: Tick, take outcome: Outcome) {
    let _ = map.remove(mut work.timers, tick.generation)
    let version = s.last
    let key = slot_key(tick.stream, tick.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        let mut index = 0u64
        let mut hit = false
        while index < list.len(h.owed) && !hit {
            if h.owed[index].generation == tick.generation { hit = true } else { index += 1u64 }
        }
        if hit {
            let _ = list.remove(mut h.owed, index)
            h.queued += 1u64
            wire_row(mut s, mut work, key, h.stream, h.p, version, take outcome)
        }
        map.insert(mut s.held, take key, take h)
    }
}

fn wire_service_allocate[G: send, H: send, B: send](mut s: WireSession[G, B], r: Registry[G, H], take allocation: ServiceAllocation) -> Result[ServicePlan, u16] {
    match take allocation {
        AcceptHello(take identity_result) => { wire_accept_hello(mut s, r, take identity_result)?; Ok(NoAction) },
        PlanCall => {
            match replace(mut s.pending, None) {
                Some(take pending) => wire_plan_call(mut s, r, take pending),
                None => Ok(NoAction),
            }
        },
        ValidateSubscribe(sub, slot, take arg, take resume) => wire_plan_subscribe(mut s, r, sub, slot, take arg, take resume),
        DeliverUpdate(take delivery) => {
            let DeliveryJob(updates: take published, output: take previous, drain: take drain) = take delivery
            let mut output = take previous
            let mut completed: List[u64] = list.new()
            for take upd in published {
                wire_stage_update(mut s, mut output, mut completed, drain, take upd)?
            }
            Ok(PlannedUpdate(take output, take completed))
        },
    }
}

// Adds a Hello entry with what the shared Registry knows of it: 1 registered, 2 gone, 0 neither.
fn wire_know[G: send, H: send, B: send](mut s: WireSession[G, B], r: Registry[G, H], take key: Bytes) {
    list.push(mut s.known, if map.contains(r.slots, key) { 1u8 } else if map.contains(r.gone, key) { 2u8 } else { 0u8 })
    list.push(mut s.entries, take key)
}

fn wire_accept_hello[G: send, H: send, B: send](mut s: WireSession[G, B], r: Registry[G, H], take identity_result: Option[Caller]) -> Result[(), u16] {
    let caller = match take identity_result { Some(take value) => take value, None => return Error(1008u16) }
    if list.len(caller.subject) > SUBJECT_MAX { return Error(1008u16) }
    s.caller = Some(take caller)
    let wanted = replace(mut s.wants, list.new())
    for take want in take wanted { wire_know(mut s, r, wire_key(want)) }
    s.phase = 2u8
    Ok(())
}

// The publisher's answer to this session's Join. Id 0 (it could not reserve the session's fence
// Arcs) or a Join the publisher never took (its inbox closed) refuses the first Subscribe;
// otherwise that Subscribe, carried in the Join (v2.22), is live at the generation it was sent with.
fn wire_poll_admit[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork) {
    if let Some(_) = work.join { return }
    let received: Option[Option[Admit]] = match s.joining {
        Some(hear) => match channel.try_receive(hear) { Ok(take a) => Some(Some(take a)), Error(Empty) => None, _ => Some(None) },
        _ => None,
    }
    let Some(take answer) = take received else { return }
    let _ = replace(mut s.joining, None)
    match take answer {
        Some(Admit(who: who, round: take register)) if who != 0u64 => {
            s.joined = Some(who)
            work.round = Some(take register)
            if let Some((sub, generation)) = replace(mut s.subscription, None) {
                list.push(mut s.subs, (sub, generation))
                list.push(mut s.pub_subs, sub)
            }
        },
        _ => {
            let _ = replace(mut s.join_lease, None)
            let _ = replace(mut s.mark, None)
            let _ = replace(mut s.taken, None)
            work.fence = None
            if let Some((sub, _)) = replace(mut s.subscription, None) { wire_end(mut s, mut work.output, sub, Refused(Overloaded)) }
        },
    }
}

// v2.22 (§3 "Repair"): once the owner holds no `complete` it took and has not sent, it publishes
// how many it has taken for this join and wakes the publisher, so a due sub held back for an
// unsent repair is repaired without waiting for another drain.
fn wire_offer_taken[G: send, B: send](mut s: WireSession[G, B], work: WireWork) {
    if s.completes == s.told_taken || work.sending_complete { return }
    for o in work.output { if wire_carries_complete(o.frame) { return } }
    let made = arc.new(Taken(n: s.completes))
    let next = take made
    match s.taken { Some(root) => latest.publish(root, take next), None => return }
    s.told_taken = s.completes
    let _ = channel.try_send(wire_publisher(s), PubIn(e: Drained))
}

fn wire_carries_complete(f: Frame) -> bool {
    match f { Batch(_, complete, _, _) => list.len(complete) != 0u64, _ => false }
}

fn wire_step[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, take input: ServiceInput) -> Result[Option[Frame], u16] {
    let stepped = wire_step_input(mut s, mut work, take input)
    wire_offer_taken(mut s, work)
    stepped
}

fn wire_step_input[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork, take input: ServiceInput) -> Result[Option[Frame], u16] {
    s.holding = match work.check { Some(_) => true, None => false }
    match take input {
        WAttach(_, take me, take pub_to) => {
            s.me = Some(take me); s.publisher = Some(take pub_to)
        },
        WClient(take frame, at) => match take frame {
            Hello(take token, take wanted) => {
                if s.phase != 0u8 { return Error(1008u16) }
                s.phase = 1u8
                s.wants = take wanted
                wire_begin_hello(s, mut work, take token)?
            },
            Call(stream, p, slot, deadline, take arg) => {
                if s.phase != 3u8 { return Error(1008u16) }
                let key = match s.caller { Some(caller) => slot_key(wire_stream(caller, stream), p), _ => return Error(1008u16) }
                let grows = match map.get(s.held, key) { Some(h) => !h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64, _ => true }
                let held = match map.get(s.held, key) { Some(h) => h.forwarded, _ => false }
                if (wire_admission_closed(work, s.clock) && !held) || (grows && wire_units(s) >= 1u64 + s.config.q) {
                    wire_refused(mut s, mut work, stream, p, Overloaded)?
                } else {
                    s.pending = Some(WirePending(stream: stream, p: p, slot: slot, deadline: deadline, arg: take arg, at: at, grows: grows))
                    work.plan_call = true
                }
            },
            // The owner plans each Subscribe against the shared Registry (ValidateSubscribe)
            // and steps the plan as WPrepared; a Subscribe never reaches the step.
            Subscribe(_, _, _, _) => return Error(1008u16),
            Unsubscribe(sub) => {
                if s.phase != 3u8 { return Error(1008u16) }
                wire_stop_sub(mut s, mut work.output, sub)
            },
            _ => return Error(1007u16),
        },
        WGrantedDone(take tick, take outcome) => wire_finish_granted(mut s, mut work, tick, take outcome),
        WPrepared(take plan) => wire_apply_plan(mut s, mut work, box.unbox(take plan))?,
        WRunner(take e) => {
            let Notice(e: take received) = take e
            match take received {
                Updated(take upd) => wire_update(mut s, mut work, take upd)?,
                Expired(tick) => wire_expired(mut s, mut work, tick),
                _ => {},
            }
        },
        WSent => { wire_sent(mut s, mut work); wire_flush(mut s, mut work); return Ok(None) },
        WDropped => { wire_dropped(mut s, mut work)?; wire_flush(mut s, mut work); return Ok(None) },
        WDrained => {
            // The token goes first, so the wake it rides on finds it (§3 "Repair").
            if let Some(to) = s.progress { let _ = channel.try_send(to, ()) }
            if let Some(_) = work.head { let _ = channel.try_send(wire_publisher(s), PubIn(e: Drained)) }
        },
        WClose(deadline) => { work.deadline = Some(deadline) },
        WForce => {
            work.abandoned += map.len(work.timers)
            let _ = replace(mut work.granted, map.new())
            let _ = replace(mut s.held, map.new())
            return Ok(None)
        },
        WPoll(writable) => {
            wire_poll_admit(mut s, mut work)
            if !writable { return Ok(None) }
            if s.phase == 4u8 { s.phase = 3u8 }
            if s.phase == 2u8 {
                if s.placing == 0u64 {
                    s.placing += 1u64
                    if list.len(s.entries) == 0u64 { s.phase = 4u8 }
                    let caller: Caller = match s.caller {
                        Some(caller) => clone(caller),
                        None => return Error(1008u16),
                    }
                    let q: u32 = int.narrow(s.config.q)
                    return Ok(Some(Welcome(take caller, q, s.config.budget, result.unwrap(launch_digest()), clone(s.target), s.n_place)))
                }
                let index = s.placing - 1u64
                let slot: u32 = int.narrow(index)
                let answer: Entry = if s.known[index] == 1u8 { Ready(slot) } else { Gone }
                s.placing += 1u64
                if index + 1u64 == list.len(s.entries) { s.phase = 4u8 }
                return Ok(Some(Placed(take answer)))
            }
            return wire_take_output(s, mut work)
        },
    }
    let version = s.last
    if wire_queued_bytes(work.output) > s.config.budget {
        wire_prune_output(mut s, mut work.output, None)
        if wire_queued_bytes(work.output) > s.config.budget { wire_reset(mut s, mut work.output, version)? }
    }
    Ok(None)
}

fn wire_me[G: send, B: send](s: WireSession[G, B]) -> Sender[WireEvent] {
    match s.me { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}

fn wire_publisher[G: send, B: send](s: WireSession[G, B]) -> Sender[PubIn] {
    match s.publisher { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}

fn wire_finish[G: send, B: send](mut s: WireSession[G, B]) -> Option[PubIn] {
    s.mark = None
    if s.marked { Some(PubIn(e: Drained)) }
    else { match s.joined { Some(who) => Some(PubIn(e: Left(who))), _ => None } }
}

// Embedded hosts and socket fixtures supply their launch target directly.
pub fn wire_target_service[G: send, B: send](random: Random, take session_wire: Option[Wire[G, B]], head: Sender[HeadInput], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, B]] {
    wire_service_with_head(random, take session_wire, LifecycleHead(channel.sender(head)), clock, tasks, config, take target)
}

// The place's one Registry, built once under `bytes n_place` and owned by the allocation
// pool's step for every session the pool serves (§3 "One Registry").
pub fn wire_place_allocator[G: send, H: send, B: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64) -> Result[own[send] fn(mut WireSession[G, B], take ServiceAllocation) -> Result[ServicePlan, u16], RegisterError] {
    Ok(wire_allocator(placed(place, n_place)?, n_place))
}

fn wire_allocator[G: send, H: send, B: send](take r: Registry[G, H], n_place: u64) -> own[send] fn(mut WireSession[G, B], take ServiceAllocation) -> Result[ServicePlan, u16] {
    fn(mut s: WireSession[G, B], take allocation: ServiceAllocation) -> Result[ServicePlan, u16] {
        if let AcceptHello(_) = view allocation { s.n_place = n_place }
        wire_service_allocate(mut s, r, take allocation)
    }
}

resource type WireJoinLease: send { closing: Sender[()], publisher: Sender[PubIn] } drop(lease) {
    let _ = channel.try_send(lease.closing, ())
    let _ = channel.try_send(lease.publisher, PubIn(e: Drained))
}

fn wire_remove_sub[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.subs) { if s.subs[i].0 == sub { let _ = list.remove(mut s.subs, i) } else { i += 1u64 } }
    wire_prune_output(mut s, mut output, Some(sub))
}

fn wire_forget_sub[G: send, B: send](mut s: WireSession[G, B], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.pub_subs) { if s.pub_subs[i] == sub { let _ = list.remove(mut s.pub_subs, i) } else { i += 1u64 } }
}

fn wire_stop_sub[G: send, B: send](mut s: WireSession[G, B], mut output: List[WireOutput], sub: u32) {
    wire_remove_sub(mut s, mut output, sub)
    let mut at = 0u64
    while at < list.len(s.resubs) {
        if s.resubs[at].sub == sub { let _ = list.remove(mut s.resubs, at) } else { at += 1u64 }
    }
    if list.len(s.subs) == 0u64 {
        wire_leave(mut s)
        let _ = replace(mut s.joining, None)
        let _ = replace(mut s.subscription, None)
        s.joined = None
        let _ = replace(mut s.pub_subs, list.new())
        return
    }
    if !s.holding { wire_unsubscribe(mut s, sub) }
}

fn wire_unsubscribe[G: send, B: send](mut s: WireSession[G, B], sub: u32) {
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if registered {
        if let Some(who) = s.joined {
            if let Ok(()) = channel.try_send(wire_publisher(s), PubIn(e: Unsubscribed(who, sub))) { wire_forget_sub(mut s, sub) }
        }
    }
}

// v2.19.2 (§3 "The owner asks for removal"): the session leaves by dropping its join lease,
// which tells the publisher to forget it. While the writer holds a content unit the lease
// is parked, so the publisher keeps fencing the read sets that unit was computed from. The
// join that made the lease reserved its parking slot, so parking allocates nothing.
fn wire_leave[G: send, B: send](mut s: WireSession[G, B]) {
    while let Some(_) = list.pop(mut s.resubs) {}
    if let Some(take lease) = replace(mut s.join_lease, None) {
        if s.holding { list.push(mut s.leaving, take lease) }
    }
}

// The writer holds no content unit: the removals held for it go now, in the order the
// publisher must apply them. A replacing Subscribed goes before the Unsubscribeds, and a
// sub the owner no longer has but the publisher may (pub_subs) owes an Unsubscribed.
fn wire_flush[G: send, B: send](mut s: WireSession[G, B], mut work: WireWork) {
    s.holding = false
    while let Some(_) = list.pop(mut s.leaving) {}
    while list.len(s.resubs) != 0u64 {
        let WireResub(sub: sub, generation: generation, input: take input) = list.remove(mut s.resubs, 0u64)
        let who = option.unwrap(s.joined)
        if let Error(_) = channel.try_send(wire_publisher(s), PubIn(e: WireSubscribed(who, sub, generation, take input))) {
            wire_end(mut s, mut work.output, sub, Refused(Overloaded))
        }
    }
    let mut at = 0u64
    while at < list.len(s.pub_subs) {
        let sub = s.pub_subs[at]
        let before = list.len(s.pub_subs)
        if let None = sub_generation(s.subs, sub) { wire_unsubscribe(mut s, sub) }
        if list.len(s.pub_subs) == before { at += 1u64 }
    }
}

// A second digest at a live position closes before preparing another call. Otherwise
// a head answer could reach the writer while that conflicting send is being prepared.
fn wire_check_live[G: send, B: send](s: WireSession[G, B], f: Frame) -> Option[u16] {
    if let Call(stream, p, slot, _, arg) = f {
        let index: u64 = int.widen(slot)
        if index >= list.len(s.entries) { return None }
        let key = s.entries[index]
        if s.known[index] == 0u8 { return None }
        let named: Bytes = match s.caller { Some(caller) => wire_stream(caller, stream), _ => return None }
        let position = slot_key(named, p)
        let prior: Option[store.RequestDigest] = match map.get(s.held, position) { Some(h) => if h.forwarded || list.len(h.owed) != 0u64 { Some(h.digest) } else { None }, _ => None }
        if let Some(digest) = prior {
            if digest != store.request_digest(key, arg) { return Some(1008u16) }
        }
    }
    None
}

// Publisher harness: a joined inbox whose consumer the law can hold still.
// This fixture does not create a session or a second call transport.
// The owner subscribes as `caller`, the Caller a session binds at Hello.
pub type FixtureOwner { inbox: Receiver[WireEvent], out: Sender[Down], from: Receiver[Down], post: Sender[PubIn], who: u64, progress: Sender[()], caller: Caller }

pub fn fixture_owner(pub_in: Sender[PubIn], take caller: Caller) -> FixtureOwner waits {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(64u64)
    let (progressed, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    let who = join_with(pub_in, take to, None, Some(take progress))
    let (out, from): (Sender[Down], Receiver[Down]) = channel.new(64u64)
    FixtureOwner(inbox: take inbox, out: take out, from: take from, post: channel.sender(pub_in), who: who, progress: take progressed, caller: take caller)
}

pub fn fixture_subscribe(owner: FixtureOwner, sub: u32, take key: Bytes, take arg: Bytes) -> () waits {
    let copied: Caller = clone(owner.caller)
    let _ = channel.send(owner.post, PubIn(e: Subscribed(owner.who, sub, take copied, take key, take arg)))
}

fn fixture_content(owner: FixtureOwner, take event: WireEvent) -> () waits {
    let Notice(e: take e) = publisher_notice(take event)
    let mut dropped: List[u32] = list.new()
    if let Updated(Update(version: _, content: Some(take o), outcomes: take outcomes)) = take e {
        hand(owner.out, take o, mut dropped, take outcomes)
    }
    let _ = channel.try_send(owner.progress, ())
    let _ = channel.try_send(owner.post, PubIn(e: Drained))
}

pub fn fixture_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    loop {
        if let Ok(take d) = channel.try_receive(owner.from) { return Ok(take d) }
        match channel.receive(owner.inbox) {
            Ok(take e) => fixture_content(owner, take e),
            Error(_) => return Error(Closed),
        }
    }
}

pub fn fixture_close(take owner: FixtureOwner) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Left(owner.who)))
}

fn publisher_notice(take event: WireEvent) -> Notice {
    let WireEvent(e: take input) = take event
    match take input { FromRunner(take notice) => take notice, _ => fail("publisher fixture: non-publisher event") }
}

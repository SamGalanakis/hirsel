// rule: STORE-12
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"}}
// steps: 8000000
// twenty calls each checksum and write a log object, and two opens recover the store
// store.call runs each stream position once: a duplicate with the same digest
// returns the recorded outcome without running the body, an abort is recorded
// like a success, a changed digest, a gap or an acknowledged position is
// Rejected, an older executor epoch is Denied, a run that fails is Faulted and
// recorded nowhere, so its position stays the next one, and the recorded
// outcomes survive a reopen.
@serializable
type Short = Empty | Db(store.TxError)

fn request(position: u64, digest: Bytes, epoch: u64, acknowledged: u64) -> CallRequest {
  CallRequest(
    stream: d32(b"caller-1"),
    epoch: epoch,
    position: position,
    digest: d32(digest),
    acknowledged: acknowledged
  )
}

fn counted(mut tx: store.Tx, info: store.CallInfo, fail: bool) -> Result[u64, Short] {
  let n: u64 = match store.tx_get(tx, b"counter") {
    Ok(Some(b)) => int.widen(b[0]),
    Ok(None()) => 0,
    Error(e) => return Error(Db(unique e)),
  }
  store.tx_put(mut tx, b"counter", bytes.from_list([int.truncate(n + 1)])) ? Db
  if fail {
    return Error(Empty())
  }
  Ok(n + 1)
}

// Writes the counter, then fails.
fn faults(mut tx: store.Tx, info: store.CallInfo, n: u8) -> Result[u64, Short] {
  store.tx_put(mut tx, b"counter", b"\xff") ? Db
  let max: u8 = 255
  let broken = max + n
  Ok(0)
}

// Adds one to the counter and returns its new value; Empty when asked to
// fail.
fn bump(mut s: store.Store, req: CallRequest, fail: bool) -> Result[
  u64,
  store.CallFailure[Short]
] {
  store.call(mut s, req, counted, fail)
}

fn counter(a: Authority, mut s: store.Store) -> Option[Bytes] {
  match store.snapshot(a, mut s, authority.floor(a)) {
    Ok(snap) => store.get(snap, b"counter"),
    Error(_) => None(),
  }
}

// Streams and request digests are 32 bytes: the SHA-256 of a name.
fn d32(name: Bytes) -> Bytes {
  bytes.from_inline(sha256.digest(name))
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  check(bump(mut s, request(1, b"a", 1, 0), false) == Ok(1))?
  check(bump(mut s, request(2, b"b", 1, 0), false) == Ok(2))?
  // Duplicates of applied positions return their outcomes; nothing runs.
  check(bump(mut s, request(1, b"a", 1, 0), false) == Ok(1))?
  check(bump(mut s, request(2, b"b", 1, 0), true) == Ok(2))?
  check(counter(a, mut s) == Some(b"\x02"))?
  // Another request at a retained position, a gap, and an
  // acknowledgement at or past the position itself.
  check(bump(mut s, request(2, b"x", 1, 0), false) == Error(Rejected()))?
  check(bump(mut s, request(4, b"d", 1, 0), false) == Error(Rejected()))?
  check(bump(mut s, request(3, b"c", 1, 3), false) == Error(Rejected()))?
  // An abort writes nothing but is recorded, so its duplicate returns it.
  check(bump(mut s, request(3, b"c", 1, 1), true) == Error(Tx(Aborted(Empty()))))?
  check(bump(mut s, request(3, b"c", 1, 1), false) == Error(Tx(Aborted(Empty()))))?
  check(counter(a, mut s) == Some(b"\x02"))?
  // Position 1 was acknowledged by the last request and is forgotten.
  check(bump(mut s, request(1, b"a", 1, 1), false) == Error(Rejected()))?
  store.close(take s) ? Store
  let mut again = store.open(a, store.default_config()) ? Store
  check(bump(mut again, request(2, b"b", 1, 1), false) == Ok(2))?
  // A later executor fences the stream, even through a duplicate.
  check(bump(mut again, request(3, b"c", 2, 1), false) == Error(Tx(Aborted(Empty()))))?
  check(bump(mut again, request(4, b"d", 1, 1), false) == Error(Denied()))?
  let faulted = match store.call(mut again, request(4, b"d", 2, 3), faults, 1u8) {
    Error(Tx(Faulted(f))) => f.rule == "SEM-1",
    _ => false,
  }
  check(faulted)?
  check(counter(a, mut again) == Some(b"\x02"))?
  check(bump(mut again, request(4, b"d", 2, 3), false) == Ok(3))?
  check(counter(a, mut again) == Some(b"\x03"))?
  Ok(())
}

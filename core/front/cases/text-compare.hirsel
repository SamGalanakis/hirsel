// expect: run go(0) = 1
// expect: run go(1) = 1
// expect: run go(2) = 2
// expect: run go(3) = 3
// SEM-7: Text orders bytewise, then by length, like String. "abc" < "abd" by the third
// byte, "ab" < "abc" as a prefix, "abc" == "abc", and "b" > "abc" by the first byte.
@compact(u32) stable type P { a: Text, b: Text }
fn pair[in r](take w: Writer[P, in r], x: String, y: String) -> Result[Child[P], BuildError] {
  emit(take w, P(a: x, b: y))
}
fn make(r: Region, x: String, y: String) -> Result[P in r, BuildError] {
  match build_stream_in(r, bytes 64, fn(take w: Writer[P, in r]) -> Result[Child[P], BuildError] { pair(take w, x, y) }) {
    Ok(take b) => Ok(finish(take b)),
    Error(e) => Error(e),
  }
}
fn order(p: P) -> u64 { if p.a < p.b { 1 } else if p.a == p.b { 2 } else { 3 } }
fn go(k: u64) -> u64 {
  region r {
    let made = if k == 0 { make(r, "abc", "abd") } else if k == 1 { make(r, "ab", "abc") } else if k == 2 { make(r, "abc", "abc") } else { make(r, "b", "abc") }
    match made { Ok(p) => order(p), Error(_) => 99 }
  }
}

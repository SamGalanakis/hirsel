fn tiered_range_inventory_direct(d: Dir, id: StoreId, writer_pin_bytes: u64, snap: Snapshot, collection_id: u32) -> Result[(u64, u64), Error] waits {
    let Some(inventory) = view snap.roots.collections.paging else {
        return Error(Io(Closed))
    }
    let low = failure_result_from_rep(catalog.prefix(collection_id))?
    let high = failure_result_from_rep(catalog.prefix(collection_id + 1u32))?
    let mut previous: Option[Bytes] = None
    let mut row_total = 0u64
    let mut checksum = std.check.start()
    while let Some((take key, value, take resume)) = snapshot_tiered_span_step_direct(d, id, writer_pin_bytes, snap, inventory, low, high, previous)? {
        failure_result_from_rep(transfer.checksum_row(mut checksum, key, value))?
        row_total += 1
        previous = Some(take resume)
    }
    Ok((row_total, std.check.finish(checksum)))
}

fn write_tiered_prepared_rows_direct(mut file: transfer.FrameFile, d: Dir, id: StoreId, writer_pin_bytes: u64, snap: Snapshot, collection_id: u32, row_codec: std.codec.Codec[transfer.PreparedRow]) -> Result[(), DeployError] waits {
    let Some(inventory) = view snap.roots.collections.paging else {
        return Error(Store(Io(Closed)))
    }
    let low = deploy_result(failure_result_from_rep(catalog.prefix(collection_id)))?
    let high = deploy_result(failure_result_from_rep(catalog.prefix(collection_id + 1u32)))?
    let mut previous: Option[Bytes] = None
    while let Some((take key, value, take resume)) = deploy_result(snapshot_tiered_span_step_direct(d, id, writer_pin_bytes, snap, inventory, low, high, previous))? {
        let row = transfer.PreparedRow(key: take key, value: deploy_result(failure_result_from_rep(types.copied(value)))?)
        scratch_result(failure_result_from_rep(transfer.write_prepared_frame(mut file, 0x0084, row_codec, row)))?
        previous = Some(take resume)
    }
    Ok(())
}

// Finishes every deferred Tiered range diff at the two captured roots
// (`before` and `after`) through PagerDirect on `d`. Each present side is
// read by its own descriptor (§13.10a "Finishes the Tiered diff"): a Memory
// side needs no inventory, and a Tiered side without one cannot be finished,
// which is `Drift`.
fn catch_up_tiered_diffs(d: Dir, id: StoreId, writer_pin_bytes: u64, before: Snapshot, after: Snapshot, deferred: List[pager.TieredRowDiff]) -> Result[List[transfer.CatchUpChange], DeployError] waits {
    let mut out: List[transfer.CatchUpChange] = list.new()
    for diff in deferred {
        if (diff.before && deploy_result(catch_up_side_unread(before, diff.id))?) || (diff.after && deploy_result(catch_up_side_unread(after, diff.id))?) {
            return Error(Drift)
        }
        let low = match diff.start {
            Some(suffix) => deploy_result(failure_result_from_rep(catalog.logical_key(diff.id, suffix)))?,
            None => deploy_result(failure_result_from_rep(catalog.prefix(diff.id)))?,
        }
        let high = match diff.stop {
            Some(suffix) => deploy_result(failure_result_from_rep(catalog.logical_key(diff.id, suffix)))?,
            None => deploy_result(failure_result_from_rep(catalog.prefix(diff.id + 1u32)))?,
        }
        let mut left_prev: Option[Bytes] = None
        let mut right_prev: Option[Bytes] = None
        let mut left_cur: Option[(Bytes, Arc[Bytes])] = None
        let mut right_cur: Option[(Bytes, Arc[Bytes])] = None
        let mut left_done = !diff.before
        let mut right_done = !diff.after
        loop {
            if !left_done && left_cur == None {
                let next_left = deploy_result(catch_up_next_row(d, id, writer_pin_bytes, before, diff.id, low, high, left_prev))?
                match take next_left {
                    Some((take k, take v, take res)) => {
                        left_prev = Some(take res)
                        left_cur = Some((take k, take v))
                    },
                    None => {
                        left_done = true
                    },
                }
            }
            if !right_done && right_cur == None {
                let next_right = deploy_result(catch_up_next_row(d, id, writer_pin_bytes, after, diff.id, low, high, right_prev))?
                match take next_right {
                    Some((take k, take v, take res)) => {
                        right_prev = Some(take res)
                        right_cur = Some((take k, take v))
                    },
                    None => {
                        right_done = true
                    },
                }
            }
            let cmp = match (view left_cur, view right_cur) {
                (None, None) => break,
                (None, Some(_)) => Greater,
                (Some(_), None) => Less,
                (Some((lk, _)), Some((rk, _))) => list.compare_bytes(lk, rk),
            }
            match cmp {
                Less => {
                    let Some((take lk, take lv)) = replace(mut left_cur, None) else {
                        break
                    }
                    list.push(mut out, transfer.CatchUpChange(tree_key: take lk, before: Some(take lv), after: None))
                },
                Greater => {
                    let Some((take rk, take rv)) = replace(mut right_cur, None) else {
                        break
                    }
                    list.push(mut out, transfer.CatchUpChange(tree_key: take rk, before: None, after: Some(take rv)))
                },
                Equal => {
                    let Some((_, take lv)) = replace(mut left_cur, None) else {
                        break
                    }
                    let Some((take rk, take rv)) = replace(mut right_cur, None) else {
                        break
                    }
                    if lv != rv {
                        list.push(mut out, transfer.CatchUpChange(tree_key: take rk, before: Some(take lv), after: Some(take rv)))
                    }
                },
            }
        }
    }
    Ok(take out)
}

// A present side the child cannot read: a Tiered collection with no
// inventory to resolve its Cold slots.
fn catch_up_side_unread(snap: Snapshot, collection_id: u32) -> Result[bool, Error] {
    let key = failure_result_from_rep(catalog.prefix(collection_id))?
    let Some((_, desc)) = std.page.collection_slot(snap.roots.collections.root, key) else {
        return Ok(false)
    }
    Ok(pages.collection_descriptor(desc).residency != ResidentMemory && !snapshot_paged(snap))
}

fn catch_up_next_row(d: Dir, id: StoreId, writer_pin_bytes: u64, snap: Snapshot, collection_id: u32, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] waits {
    let key = failure_result_from_rep(catalog.prefix(collection_id))?
    let Some((_, desc)) = std.page.collection_slot(snap.roots.collections.root, key) else {
        return Ok(None)
    }
    if pages.collection_descriptor(desc).residency != ResidentMemory {
        let Some(inventory) = view snap.roots.collections.paging else {
            return Error(Io(Closed))
        }
        return snapshot_tiered_span_step_direct(d, id, writer_pin_bytes, snap, inventory, low, high, previous)
    }
    let start = match previous {
        Some(prev) => Excluded(failure_result_from_rep(types.copied(prev))?),
        None => Included(failure_result_from_rep(types.copied(low))?),
    }
    let mut cursor = byte_cursor(snap.roots.collections, take start, high)?
    match failure_result_from_rep(catalog.next_bytes(mut cursor))? {
        Some((take k, take v)) => {
            let res = failure_result_from_rep(types.copied(k))?
            Ok(Some((take k, take v, take res)))
        },
        None => Ok(None),
    }
}

// ---------------------------------------------------------------------------
// Tiered round application on OLD (`apply_round`) and on Child
// ---------------------------------------------------------------------------
// Applies one Tiered round op to `tree` via OLD's writer partition call
// attempt (`pager.pin_partition(db.pager)`).
fn apply_one_tiered_round_op(mut db: Db, mut tree: pages.PageTree, key: Bytes, take value: Option[Bytes], prior: bool, private_from: u64, mut next_stamp: u64) -> Result[(), DeployError] waits {
    let collection_bytes = deploy_result(failure_result_from_rep(types.copied(list.slice(key, 0, 4))))?
    let suffix = deploy_result(failure_result_from_rep(types.copied(list.slice(key, 4, list.len(key)))))?
    let mut pins = pager.empty_tiered_pins(txn.tiered_pin_root(open_number(db), 0u32, tree), pager.pin_partition(db.pager))
    let mut pending: Option[(format.TieredTarget, types.Failure)] = None
    let replay_val: pages.ReplayValue = match take value {
        Some(take raw) => ReplayPut(arc.new(take raw)),
        None => ReplayAbsent,
    }
    loop {
        let attempt = pager.tiered_attempt(pager.pin_partition(db.pager), 0)
        let apply_res = disk_allocation(scoped fn() -> Result[Result[(pages.PageTree, u64), DeployError], Error] {
            let mut staged = pages.share_page_tree(tree)
            let staged_inline = staged.inline
            let (take ready, kind_byte, draw0) = {
                let Some((edge, desc)) = std.page.collection_slot(staged.root, collection_bytes) else {
                    return Ok(Error(ImportMalformed))
                }
                let fields = pages.collection_descriptor(desc)
                pager.tiered_seek(attempt, SeekKey(failure_result_from_rep(types.copied(suffix))?))
                let prior_width = failure_result_from_rep(pager.tiered_plan_prior(attempt, pins.frames, staged, key))?
                let present = prior_width != 0
                match view replay_val {
                    ReplayPut(_) => if present != prior {
                        return Ok(Error(ImportMalformed))
                    },
                    ReplayAbsent => if !present {
                        return Ok(Error(ImportMalformed))
                    },
                }
                let Some(empty_root) = view staged.empty_collection else {
                    fail("store: missing empty collection page")
                }
                let mut stamp_draw = next_stamp
                let ready = failure_result_from_rep(pager.stage_tiered_row(attempt, pins.frames, edge, empty_root, suffix, transfer.clone_replay_value(replay_val), staged_inline, fields.kind == LogCollection, private_from, mut stamp_draw))?
                (take ready, pages.descriptor_kind_byte(fields.kind), stamp_draw)
            }
            let mut draw = draw0
            let revised = failure_result_from_rep(pages.rooted_collection_record(ready, kind_byte, ResidentTiered))?
            failure_result_from_rep(pages.page_result(std.page.insert(mut staged.root, collection_bytes, revised, Some(take ready), staged_inline, private_from, mut draw)))?
            failure_result_from_rep(pager.restore_planned_root(mut staged.root, collection_bytes, private_from, pins.frames, mut draw))?
            Ok(Ok((take staged, draw)))
        })
        let state = pager.tiered_finish(take attempt)
        match state.stopped {
            None => {
                let inner = deploy_result(take apply_res)?
                let (take updated, draw) = inner?
                tree = take updated
                next_stamp = draw
                return Ok(())
            },
            Some(AttemptMiss(_)) => {
                revoke_parked(mut db)
                deploy_result(deliver_call_miss(db, tree, pages.no_tail_bases(), state, mut pins, mut pending))?
            },
            Some(AttemptPinLimit(problem)) => return Error(Store(Full(Cache(problem)))),
            Some(AttemptAllocation(problem)) => return Error(Store(Full(Allocation(problem)))),
            Some(AttemptFold(_)) => return Error(ImportMalformed),
        }
    }
}

// ---------------------------------------------------------------------------
// Queued Cold `stage_rewrite` validation and activation application (§3.5)
// ---------------------------------------------------------------------------
fn child_cut_context(source: Preparation) -> transfer.ChildCutContext {
    let next_seq = cell.with(source.next_pack, (), fn(mut v: u64, take _u: ()) -> u64 {
        v
    })
    transfer.ChildCutContext(dir: source.dir, store: store_key_to_rep(source.db.store), next_pack: next_seq, pack_bytes: source.pack_bytes, dirty_bytes: source.dirty_bytes, writer_pin_bytes: pager.pin_partition(source.db.pager))
}

fn save_child_cut_pack(source: Preparation, next_pack: u64) {
    cell.set(source.next_pack, next_pack)
}

// Runs one writer call attempt over every queued Cold rewrite in `staged`,
// checking existence (`Missing("row")`) and index invariance (`Changed(<ix>)`)
// pinned against `writer_pin_bytes` (`Full(Cache(Capacity))`).
fn check_queued_rewrites(take backend: pager.TieredPageBackend, writer_pin_bytes: u64, opened: u64, store_id: StoreId, staged: StagedMigration, staged_collections: pages.PageTree) -> Result[(), Error] waits {
    if list.len(staged.queued_rewrites) == 0 {
        return Ok(())
    }
    let grant = disk_allocation(scoped fn() -> Result[Arc[pager.TieredReaderGrant], Error] {
        Ok(arc.new(pager.TieredReaderGrant(store: store_key_to_rep(store_id), opened: opened, pin_bytes: writer_pin_bytes)))
    })?
    let inventory = match view staged_collections.paging {
        Some(inv) => arc.share(inv),
        None => match view staged.base_rows.paging {
            Some(inv) => arc.share(inv),
            None => return Error(Io(Closed)),
        },
    }
    let root = pager.TieredPinRoot(domain: opened, branch: 0u32, generation: inventory.generation, root_stamp: pages.tree_stamp(staged_collections), tails: list.new())
    let empty_hint: Bytes = list.new()
    retry_tiered_read_with(take backend, std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, empty_hint, None, TieredPoint, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[(), Error] {
        for qr in staged.queued_rewrites {
            let tree = if qr.staged_range {
                view staged_collections
            } else {
                view staged.base_rows
            }
            let old_bytes: Option[Bytes] = if let Some(row) = pager.tiered_replayed_row(tree, qr.logical) {
                match row.now {
                    ReplayPut(v) => Some(failure_result_from_rep(types.copied(v))?),
                    ReplayAbsent => None,
                }
            } else {
                let Some((edge, _)) = std.page.collection_slot(tree.root, list.slice(qr.logical, 0, 4)) else {
                    return Error(Missing("row"))
                }
                pager.tiered_seek(attempt, SeekKey(failure_result_from_rep(types.copied(qr.key))?))
                pager.tiered_reading(attempt, ValuesAt)
                let backing = pager.TieredBorrowedRoot(edge: view edge, pins: view visible)
                match pager.tiered_point_bytes(attempt, backing, qr.key) ?=> failure_from_rep {
                    Some(raw) => Some(failure_result_from_rep(types.copied(raw))?),
                    None => None,
                }
            }
            let Some(take old) = take old_bytes else {
                return Error(Missing("row"))
            }
            failure_result_from_rep(transfer.check_rewrite_indexes(staged.plan.schema.roots.catalog, staged.plan.bindings, qr.id, qr.schema, qr.key, old, qr.raw))?
        }
        Ok(())
    })
}

fn resolve_queued_rewrites(take backend: pager.TieredPageBackend, writer_pin_bytes: u64, opened: u64, store_id: StoreId, mut staged: StagedMigration, mut child_cut: Option[transfer.ChildCutContext]) -> Result[List[transfer.ActivationRewrite], Error] waits {
    if list.len(staged.queued_rewrites) == 0 {
        return Ok(list.new())
    }
    check_queued_rewrites(transfer.clone_pager_backend(backend), writer_pin_bytes, opened, store_id, staged, staged.plan.schema.roots.collections)?
    let queued = replace(mut staged.queued_rewrites, list.new())
    let rows = failure_result_from_rep(transfer.apply_queued_rewrites(take backend, writer_pin_bytes, opened, store_key_to_rep(store_id), mut staged.plan.schema.roots.collections, mut staged.plan.schema.next_node, queued, mut child_cut))?
    staged.plan.schema.changed = true
    Ok(take rows)
}

// OLD's leased-base check for activation rewrites on Cold rows (§3.5): runs
// as one call attempt on OLD's writer partition against `lease.collections`.
fn validate_rewrite_base_tiered(db: Db, rewrites: List[transfer.ActivationRewrite], base_next_table: u32, ranges: List[transfer.ValidatedRange]) -> Result[(), DeployError] waits {
    if list.len(rewrites) == 0 {
        return Ok(())
    }
    let Some(lease) = transfer.active_lease(disk_state(db).transfer) else {
        return Error(ExportMismatch)
    }
    let tree = view lease.collections
    let mut cold_rows: List[(u32, Bytes, Bytes)] = list.new()
    for row in rewrites {
        if row.id == 0 || row.id >= base_next_table {
            return Error(ImportMalformed)
        }
        if let Ok(_) = list.binary_search_by(ranges, scoped fn(checked_range: transfer.ValidatedRange) -> Order {
            order.compare(checked_range.id, row.id)
        }) {
            return Error(ImportMalformed)
        }
        let id_key = deploy_result(failure_result_from_rep(catalog.prefix(row.id)))?
        let Some((_, desc)) = std.page.collection_slot(tree.root, id_key) else {
            return Error(ImportMalformed)
        }
        let fields = pages.collection_descriptor(desc)
        if fields.kind != TableCollection {
            return Error(ImportMalformed)
        }
        let logical = failure_result_from_rep(catalog.logical_key(row.id, row.key)) ?=> |_| ImportMalformed
        if fields.residency == ResidentMemory {
            let Some(_) = pages.get_page_row(tree, logical) else {
                return Error(ImportMalformed)
            }
        } else {
            list.push(mut cold_rows, (row.id, deploy_result(failure_result_from_rep(types.copied(row.key)))?, take logical))
        }
    }
    if list.len(cold_rows) == 0 {
        return Ok(())
    }
    let Some(inventory) = view tree.paging else {
        return Error(ImportMalformed)
    }
    let backend: pager.TieredPageBackend = match pager.pager_requests(db.pager) {
        Some(sender) => PagerTask(channel.sender(sender)),
        None => PagerDirect(deploy_result(log_directory(db))?, store_key_to_rep(db.store)),
    }
    let grant = deploy_result(disk_allocation(scoped fn() -> Result[Arc[pager.TieredReaderGrant], Error] {
        Ok(arc.new(pager.TieredReaderGrant(store: store_key_to_rep(db.store), opened: open_number(db), pin_bytes: pager.pin_partition(db.pager))))
    }))?
    let root = txn.tiered_pin_root(open_number(db), 0u32, tree)
    let empty_hint: Bytes = list.new()
    let checked = retry_tiered_read_with(take backend, std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, empty_hint, None, TieredPoint, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[bool, Error] {
        for (cid, key, logical) in cold_rows {
            if let Some(replayed) = pager.tiered_replayed_row(tree, logical) {
                match replayed.now {
                    ReplayPut(_) => continue,
                    ReplayAbsent => return Ok(false),
                }
            }
            let Some((edge, _)) = std.page.collection_slot(tree.root, failure_result_from_rep(catalog.prefix(cid))?) else {
                return Ok(false)
            }
            pager.tiered_seek(attempt, SeekKey(failure_result_from_rep(types.copied(key))?))
            pager.tiered_reading(attempt, ValuesAt)
            let backing = pager.TieredBorrowedRoot(edge: view edge, pins: view visible)
            let Some(_) = pager.tiered_point_bytes(attempt, backing, key) ?=> failure_from_rep else {
                return Ok(false)
            }
        }
        Ok(true)
    })
    match take checked {
        Ok(true) => Ok(()),
        Ok(false) => Error(ImportMalformed),
        Error(take problem) => Error(Store(take problem)),
    }
}

// Activation cut rewrite application (§3.5): Memory tables use `insert_row`,
// Tiered tables use a cut read on K (`CUT_PIN_BYTES`) through `retry_fold_edit`.
fn apply_import_rewrites_tiered(db: Db, mut plan: SchemaPlan, rewrites: List[transfer.ActivationRewrite]) -> Result[(), DeployError] waits {
    for row in rewrites {
        let key = deploy_result(failure_result_from_rep(catalog.logical_key(row.id, row.key)))?
        let raw = deploy_result(failure_result_from_rep(types.copied(row.value)))?
        if !deploy_result(failure_result_from_rep(transfer.table_is_tiered(plan.schema.roots.collections, row.id)))? {
            let _ = deploy_result(failure_result_from_rep(catalog.insert_row(mut plan.schema.next_node, mut plan.schema.roots, take key, take raw)))?
            continue
        }
        let pager_link: Option[View[Sender[pager.TieredPagerMessage]]] = match pager.pager_requests(db.pager) {
            Some(requests) => Some(view requests),
            None => None,
        }
        let id_key = deploy_result(failure_result_from_rep(catalog.prefix(row.id)))?
        let first = deploy_result(failure_result_from_rep(catalog.stamp_after(plan.schema.next_node)))?
        let (take updated, rows, charge, kind_byte, draw0) = {
            let cut = deploy_result(failure_result_from_rep(pager.tx_page_source(pager_link, plan.schema.roots.collections)))?
            let Some((edge, desc)) = std.page.collection_slot(plan.schema.roots.collections.root, id_key) else {
                return Error(ImportMalformed)
            }
            let desc_fields = pages.collection_descriptor(desc)
            let kind_byte = pages.descriptor_kind_byte(desc_fields.kind)
            let Some(empty_root) = view plan.schema.roots.collections.empty_collection else {
                fail("store: missing empty collection page")
            }
            let mut stamp_draw = first
            let mut effects: Option[List[pager.TieredFoldEffect]] = None
            let updated = deploy_result(failure_result_from_rep(pager.fold_materialize_row(cut, edge, empty_root, key, pages.ReplayRow(base: 0u32, now: ReplayPut(arc.new(take raw))), plan.schema.roots.collections.inline, false, first, mut stamp_draw, mut effects)))?
            let (rows, charge) = match view updated {
                HotPage(p) => std.page.totals(p),
                ColdPage(_) => (desc_fields.rows, desc_fields.row_bytes),
            }
            (take updated, rows, charge, kind_byte, stamp_draw)
        }
        let mut draw = draw0
        deploy_result(failure_result_from_rep(transfer.put_collection_with_residency(mut plan.schema.roots.collections, id_key, Some(take updated), rows, charge, kind_byte, ResidentTiered, first, mut draw)))?
        deploy_result(failure_result_from_rep(pages.canonical_tree(mut plan.schema.roots.collections)))?
        plan.schema.next_node = draw - 1
    }
    Ok(())
}

// ---------------------------------------------------------------------------
// Chunked Tiered `migrate_table` and Tiered declared index build (§4.4)
// ---------------------------------------------------------------------------
// Runs every deferred Tiered `migrate_table` build queued in `plan`, reading
// each source span through `snapshot_tiered_span_step_direct`, converting rows,
// writing into the Tiered target collection, and cutting at `dirty_bytes`.
fn run_deferred_migrates(mut ctx: transfer.ChildCutContext, opened: u64, mut plan: SchemaPlan) -> Result[(), Error] waits {
    if list.len(plan.pending_migrates) == 0 {
        return Ok(())
    }
    let pending = replace(mut plan.pending_migrates, list.new())
    for take job in take pending {
        let low = failure_result_from_rep(catalog.prefix(job.from_id))?
        let high = failure_result_from_rep(catalog.prefix(job.from_id + 1u32))?
        let mut previous: Option[Bytes] = None
        let mut read = 0u64
        let mut written = 0u64
        loop {
            let mut batch: List[(Bytes, Bytes)] = list.new()
            {
                let snap = Snapshot(store: store_key_from_rep(ctx.store), open: opened, branch: 0u32, head: 0u64, roots: pages.share_roots(plan.schema.roots), watermark: plan.schema.next_node + 1, bases: pages.no_tail_bases())
                let Some(inventory) = view plan.schema.roots.collections.paging else {
                    return Error(Io(Closed))
                }
                while list.len(batch) < INDEX_CHUNK {
                    let Some((take k, v, take res)) = snapshot_tiered_span_step_direct(ctx.dir, store_key_from_rep(ctx.store), ctx.writer_pin_bytes, snap, inventory, low, high, previous)? else {
                        break
                    }
                    list.push(mut batch, (take k, failure_result_from_rep(types.copied(v))?))
                    previous = Some(take res)
                }
            }
            if list.len(batch) == 0 {
                break
            }
            read += list.len(batch)
            let private_from = failure_result_from_rep(catalog.stamp_after(plan.schema.next_node))?
            let mut draw = private_from
            for (logical, raw) in batch {
                let suffix = list.slice(logical, 4, list.len(logical))
                if let Some((take new_key, take new_raw)) = failure_result_from_rep((job.convert)(suffix, raw))? {
                    let target_key = failure_result_from_rep(catalog.logical_key(job.to_id, new_key))?
                    if let Some(_) = failure_result_from_rep(transfer.child_get_row(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, plan.schema.roots.collections, target_key))? {
                        return Error(Exists(failure_result_from_rep(catalog.named(job.to_name))?))
                    }
                    failure_result_from_rep(transfer.child_apply_tiered_op(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, mut plan.schema.roots.collections, take target_key, ReplayPut(arc.new(take new_raw)), private_from, mut draw))?
                    written += 1
                }
            }
            failure_result_from_rep(pages.canonical_tree(mut plan.schema.roots.collections))?
            plan.schema.next_node = draw - 1
            if failure_result_from_rep(transfer.tiered_tree_hot_bytes(plan.schema.roots.collections))? >= ctx.dirty_bytes {
                failure_result_from_rep(transfer.child_cut_tiered(mut plan.schema.roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, plan.schema.next_node))?
            }
        }
        // Drop source table and its old indexes from collections.
        let former = failure_result_from_rep(catalog.remove_store_collection(mut plan.schema.roots.collections, job.from_id, mut plan.schema.next_node))?
        failure_result_from_rep(transfer.discard_replayed_collection(mut plan.schema.roots.collections, job.from_id))?
        if !plan.schema.retained {
            plan.schema.live = int.saturating_sub(plan.schema.live, former)
        }
        for old_id in job.olds {
            let charge = failure_result_from_rep(catalog.remove_store_collection(mut plan.schema.roots.collections, old_id, mut plan.schema.next_node))?
            failure_result_from_rep(transfer.discard_replayed_collection(mut plan.schema.roots.collections, old_id))?
            if !plan.schema.retained {
                plan.schema.live = int.saturating_sub(plan.schema.live, charge)
            }
        }
        if failure_result_from_rep(transfer.tiered_tree_hot_bytes(plan.schema.roots.collections))? >= ctx.dirty_bytes {
            failure_result_from_rep(transfer.child_cut_tiered(mut plan.schema.roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, plan.schema.next_node))?
        }
        if let Some(slot) = job.preview_slot {
            if let Some(mut backfills) = plan.preview {
                backfills[slot].read = read
                backfills[slot].written = written
            }
        }
    }
    Ok(())
}

fn find_binding_index(bindings: indexes.IndexBindings, table_id: u32, index_id: u32) -> Result[u64, Error] {
    match indexes.find_binding_index(bindings, table_id, index_id) {
        Some(slot) => Ok(slot),
        None => Error(MigrationFault),
    }
}

// Runs every deferred Tiered index build queued in `pending` in chunks against
// `roots` / `next_node`, reading source rows via `snapshot_tiered_span_step_direct`
// (or resident cursor if Memory table + Tiered index) and cutting at `dirty_bytes`.
fn run_deferred_index_builds_roots(mut ctx: transfer.ChildCutContext, opened: u64, pending: List[transfer.DeferredIndexBuild], bindings: indexes.IndexBindings, mut roots: pages.Roots, mut next_node: u64, live_bytes: u64, ceiling: u64, retained: bool) -> Result[(), Error] waits {
    if list.len(pending) == 0 {
        return Ok(())
    }
    for job in pending {
        let record = decode_catalog(job.record_raw)?
        let bind_idx = find_binding_index(bindings, record.owner, record.id)?
        let shape = catalog_index(record)?.shape
        let target_tiered = failure_result_from_rep(transfer.table_is_tiered(roots.collections, record.id))?
        let source_tiered = failure_result_from_rep(transfer.table_is_tiered(roots.collections, record.owner))?
        let low = failure_result_from_rep(catalog.prefix(record.owner))?
        let high = failure_result_from_rep(catalog.prefix(record.owner + 1u32))?
        let mut previous: Option[Bytes] = None
        loop {
            let mut batch: List[(Bytes, Bytes)] = list.new()
            if source_tiered {
                let snap = Snapshot(store: store_key_from_rep(ctx.store), open: opened, branch: 0u32, head: 0u64, roots: pages.share_roots(roots), watermark: next_node + 1, bases: pages.no_tail_bases())
                let Some(inventory) = view roots.collections.paging else {
                    return Error(Io(Closed))
                }
                while list.len(batch) < INDEX_CHUNK {
                    let Some((take k, v, take res)) = snapshot_tiered_span_step_direct(ctx.dir, store_key_from_rep(ctx.store), ctx.writer_pin_bytes, snap, inventory, low, high, previous)? else {
                        break
                    }
                    list.push(mut batch, (take k, failure_result_from_rep(types.copied(v))?))
                    previous = Some(take res)
                }
            } else {
                let cursor: Option[Bytes] = match previous {
                    Some(prev) => Some(failure_result_from_rep(types.copied(list.slice(prev, 4, list.len(prev))))?),
                    None => None,
                }
                let (take mem_rows, _) = resident_rows_after(roots, record.owner, cursor, INDEX_CHUNK)?
                if let Some((last_k, _)) = list.last(mem_rows) {
                    previous = Some(failure_result_from_rep(types.copied(last_k))?)
                }
                batch = take mem_rows
            }
            if list.len(batch) == 0 {
                break
            }
            if !target_tiered {
                let mut tmp = SchemaPlan(schema: catalog.schema_plan(pages.share_roots(roots), next_node, 0u32, live_bytes, ceiling, retained, VALUE_LIMIT), store: store_key_from_rep(ctx.store), bindings: indexes.empty_bindings(), chunk_freed: None, step_rows: list.new(), step_drift: false, migrate_sources: list.new(), pending_migrates: list.new(), pending_indexes: list.new(), preview: None, staged_map: pages.share_page_tree(roots.collections))
                let dup = index_chunk(mut tmp, job.catalog_key, copied_record(record)?, indexes.binding_at(bindings, bind_idx), batch, false, false, false)?
                if let Some(_) = dup {
                    return Error(Conflict(failure_result_from_rep(catalog.named(job.name))?))
                }
                roots = pages.share_roots(tmp.schema.roots)
                next_node = tmp.schema.next_node
                continue
            }
            let private_from = failure_result_from_rep(catalog.stamp_after(next_node))?
            let mut draw = private_from
            for (logical, raw) in batch {
                let primary = list.slice(logical, 4, list.len(logical))
                let indexes.IndexValue(keys: take keys, payload: take payload, sums: sums) = extract_index(indexes.binding_at(bindings, bind_idx), raw, primary)?
                let mut part = 0u64
                for take entry_key in take keys {
                    if list.len(entry_key) > 4096 {
                        return Error(Limit(Key))
                    }
                    let prior: Option[Bytes] = if let Entries(ManyEntry) = shape {
                        None
                    } else {
                        failure_result_from_rep(transfer.child_get_row(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, roots.collections, entry_key))?
                    }
                    let val = match shape {
                        Entries(UniqueEntry) => {
                            if let Some(existing) = view prior {
                                let owner = list.slice(existing, 4, failure_result_from_rep(indexes.unique_owner_end(existing))?)
                                if owner != primary {
                                    return Error(Conflict(failure_result_from_rep(catalog.named(job.name))?))
                                }
                            }
                            failure_result_from_rep(types.copied(payload))?
                        },
                        Entries(ManyEntry) => failure_result_from_rep(types.copied(payload))?,
                        Sums => {
                            let (members, sum) = match prior {
                                Some(body) => group_totals(body)?,
                                None => (0u64, 0u64),
                            }
                            let Some(total) = int.checked_add(sum, sums[part]) else {
                                return Error(Limit(Value))
                            }
                            totals_bytes(members + 1, total)?
                        },
                    }
                    part += 1
                    failure_result_from_rep(transfer.child_apply_tiered_op(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, mut roots.collections, take entry_key, ReplayPut(arc.new(take val)), private_from, mut draw))?
                }
            }
            failure_result_from_rep(pages.canonical_tree(mut roots.collections))?
            next_node = draw - 1
            if failure_result_from_rep(transfer.tiered_tree_hot_bytes(roots.collections))? >= ctx.dirty_bytes {
                failure_result_from_rep(transfer.child_cut_tiered(mut roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, next_node))?
            }
        }
        let mut published = copied_record(record)?
        failure_result_from_rep(indexes.set_index_state(mut published, Public))?
        let raw_cat = encode_catalog(published)?
        roots = failure_result_from_rep(catalog.catalog_insert(mut next_node, roots, job.catalog_key, raw_cat))?
    }
    Ok(())
}

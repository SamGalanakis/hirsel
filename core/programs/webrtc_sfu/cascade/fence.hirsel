// CAS-4, CAS-5 & CAS-7: Cross-node fences, directory-committed revokes,
// transitive leases with drift bounds, per-unit deadline enforcement through
// `router.Observer` + `Change.{Revoke, Suspend, SetLease}`, persistent grant
// ledgers surviving link loss, staged batch purging, term fencing, and ordered reattach.
pub type FenceTraceKind: key = TraceFenceTable | TraceFenceTableAck | TraceLeaseGrant | TraceFence | TraceFenceAck

pub type FenceTrace {
    kind: FenceTraceKind,
    room_num: u32,
    term: u64,
    seq: u64,
    at_ms: u64
}

pub type PendingRevoke {
    room_name: Bytes,
    term: u64,
    fence_seq: u64,
    participant: u64,
    epoch: u64,
    committed: bool,
    started_ms: u64
}

pub type LeaseLedgerEntry {
    room_name: Bytes,
    peer: NodeId,
    handle: Option[quic.ConnectionHandle],
    room_num: u32,
    linked: bool,
    fence_table_acked: bool,
    fence_table_seq: u64,
    fence_table_covers_seq: u64,
    last_grant_ms: u64,
    has_grant: bool,
    pending_fence_seq: Option[u64],
    acked_fence_seq: u64
}

type LeaseReqRecord {
    room_name: Bytes,
    seq: u64,
    sent_ms: u64
}

type PendingFenceAck {
    room: peer.RoomId,
    handle: quic.ConnectionHandle,
    room_num: u32,
    term: u64,
    seq: u64,
    fences: List[(u64, u64)],
    is_table: bool
}

/// Cascade-specific lease scheduling state; authoritative deadline and suspension
/// causes live in `router.Router` and are read via `a.obs`.
type RoomLease {
    room_name: Bytes,
    enforced: bool,
    // Highest deadline proposed to `router.Router` (prevents duplicate proposals in one tick).
    proposed_deadline_ms: u64,
    lease_suspend_proposed: bool,
    next_req_seq: u64,
    last_req_ms: u64,
    term_renew_seq: u64,
    last_renew_ms: u64,
    fence_table_applied: bool,
    next_fence_seq: u64
}

pub type FenceState {
    leases: List[RoomLease],
    ledger: List[LeaseLedgerEntry],
    pending_reqs: List[LeaseReqRecord],
    pending_revokes: List[PendingRevoke],
    pending_acks: List[PendingFenceAck],
    severed: List[(Bytes, NodeId)],
    trace: List[FenceTrace],
    dropped_fenced_media: u64,
    dropped_expired_media: u64,
    stale_msgs_ignored: u64,
    late_grants_ignored: u64,
    detached_malformed: List[u32]
}

pub fn new_fence_state() -> FenceState {
    FenceState(leases: list.new(), ledger: list.new(), pending_reqs: list.new(), pending_revokes: list.new(), pending_acks: list.new(), severed: list.new(), trace: list.new(), dropped_fenced_media: 0, dropped_expired_media: 0, stale_msgs_ignored: 0, late_grants_ignored: 0, detached_malformed: list.new())
}

pub fn take_severed(mut a: CascadeAdapter) -> List[(Bytes, NodeId)] {
    replace(mut a.fence.severed, list.new())
}

pub fn take_fence_trace(mut a: CascadeAdapter) -> List[FenceTrace] {
    replace(mut a.fence.trace, list.new())
}

pub fn take_detached_malformed(mut a: CascadeAdapter) -> List[u32] {
    replace(mut a.fence.detached_malformed, list.new())
}

pub fn fence_stats(a: CascadeAdapter) -> (u64, u64, u64, u64) {
    (a.fence.dropped_fenced_media, a.fence.dropped_expired_media, a.fence.stale_msgs_ignored, a.fence.late_grants_ignored)
}

/// Current connection handle recorded in the home grant ledger for `(room_name, peer)`.
pub fn ledger_handle(a: CascadeAdapter, room_name: Bytes, peer: NodeId) -> Option[quic.ConnectionHandle] {
    let idx = find_ledger(a.fence, room_name, peer)?
    a.fence.ledger[idx].handle
}

fn find_lease(fs: FenceState, room_name: Bytes) -> Option[u64] {
    for i in 0u64 .. list.len(fs.leases) {
        if list.compare_bytes(fs.leases[i].room_name, room_name) == Equal {
            return Some(i)
        }
    }
    None
}

fn ensure_lease(mut fs: FenceState, room_name: Bytes) -> u64 {
    if let Some(i) = find_lease(fs, room_name) {
        return i
    }
    list.push(mut fs.leases, RoomLease(room_name: clone(room_name), enforced: false, proposed_deadline_ms: 0, lease_suspend_proposed: false, next_req_seq: 1, last_req_ms: 0, term_renew_seq: 1, last_renew_ms: 0, fence_table_applied: false, next_fence_seq: 1))
    list.len(fs.leases) - 1
}

fn find_ledger(fs: FenceState, room_name: Bytes, peer: NodeId) -> Option[u64] {
    for i in 0u64 .. list.len(fs.ledger) {
        if fs.ledger[i].peer == peer && list.compare_bytes(fs.ledger[i].room_name, room_name) == Equal {
            return Some(i)
        }
    }
    None
}

fn find_ledger_by_handle(fs: FenceState, room_name: Bytes, h: quic.ConnectionHandle) -> Option[u64] {
    for i in 0u64 .. list.len(fs.ledger) {
        if fs.ledger[i].handle == Some(h) && list.compare_bytes(fs.ledger[i].room_name, room_name) == Equal {
            return Some(i)
        }
    }
    None
}

/// Enable strict CAS-5 lease & CAS-7 ordered-reattach enforcement for `room_name`.
/// Proposes `Change.SetLease` and directory-committed `Change.Revoke`s into the control order.
pub fn enable_leases(mut a: CascadeAdapter, room_name: Bytes, initial_deadline_ms: u64, fences: List[(u64, u64)]) {
    let li = ensure_lease(mut a.fence, room_name)
    a.fence.leases[li].enforced = true
    a.fence.leases[li].proposed_deadline_ms = initial_deadline_ms
    if let Some(ri) = find_room(a, room_name) {
        let room = a.rooms[ri].room
        list.push(mut a.changes, SetLease(room: room, deadline_ms: Some(initial_deadline_ms), guard_ms: a.limits.guard_ms))
        for (p, ep) in fences {
            list.push(mut a.changes, Revoke(room: room, id: p, epoch: ep))
        }
    }
}

/// Advance a room's highest seen term (CAS-1, CAS-7). Ends any old-term lease, purges
/// staged packets and queued datagrams, clears demand, and suspends with cause `Term`.
pub fn advance_room_term(mut a: CascadeAdapter, mut hub: LinkHub, room_name: Bytes, new_term: u64, now_ns: u64) {
    let Some(ri) = find_room(a, room_name) else {
        return
    }
    if new_term > a.rooms[ri].term {
        a.rooms[ri].term = new_term
        let room = a.rooms[ri].room
        let li = ensure_lease(mut a.fence, room_name)
        a.fence.leases[li].proposed_deadline_ms = 0
        a.fence.leases[li].fence_table_applied = false
        let _ = discard_staged(mut hub, now_ns)
        drop_all_room_datagrams(a, mut hub, ri)
        clear_local_demand(mut a, ri)
        list.push(mut a.changes, SetLease(room: room, deadline_ms: Some(0), guard_ms: a.limits.guard_ms))
        list.push(mut a.changes, Suspend(room: room, cause: Term, on: true))
    }
}

/// Current lease deadline (ms) for `room_name` from `router.Observer`.
pub fn room_lease_deadline(a: CascadeAdapter, room_name: Bytes) -> Option[u64] {
    let ri = find_room(a, room_name)?
    let (dl, _) = router.observer_lease(a.obs, a.rooms[ri].room)?
    Some(dl)
}

/// Whether `room_name` is suspended for `Lease` (bit 2) or `Term` (bit 4) in `router.Observer`.
pub fn room_lease_suspended(a: CascadeAdapter, room_name: Bytes) -> bool {
    match find_room(a, room_name) {
        Some(ri) => (router.observer_causes(a.obs, a.rooms[ri].room) & 6u8) != 0,
        None => false,
    }
}

/// Whether `(participant, epoch)` is covered by `room_name`'s fence table in `router.Observer` (CAS-4).
pub fn is_fenced(a: CascadeAdapter, room_name: Bytes, participant: u64, epoch: u64) -> bool {
    let Some(ri) = find_room(a, room_name) else {
        return false
    }
    router.observer_fenced(a.obs, a.rooms[ri].room, Gen(id: participant, epoch: epoch))
}

/// CAS-5 check performed right where media leaves (and at ingress), delegated to `router.Observer`.
pub fn lease_allows_media(a: CascadeAdapter, room_name: Bytes, now_ms: u64) -> bool {
    let Some(ri) = find_room(a, room_name) else {
        return false
    }
    router.observer_routing_allowed(a.obs, a.rooms[ri].room, now_ms)
}

/// CAS-5: Enforce lease deadlines right before committing QUIC packets.
/// Discards any staged send batch (`discard_staged`), drops queued link datagrams with
/// `drop_room_datagrams` once `now_ms + guard_ms > deadline_ms`, and proposes `Suspend(Lease, true)`.
pub fn enforce_leases(mut a: CascadeAdapter, mut hub: LinkHub, now_ms: u64) {
    let now_ns = now_ms * 1000000
    for li in 0u64 .. list.len(a.fence.leases) {
        if !a.fence.leases[li].enforced {
            continue
        }
        let rname: Bytes = clone(a.fence.leases[li].room_name)
        let Some(ri) = find_room(a, rname) else {
            continue
        }
        let room = a.rooms[ri].room
        let Some((dl, guard)) = router.observer_lease(a.obs, room) else {
            continue
        }
        let expired = int.saturating_add(now_ms, int.widen(guard)) > dl
        if expired {
            let _ = discard_staged(mut hub, now_ns)
            drop_all_room_datagrams(a, mut hub, ri)
            if (router.observer_causes(a.obs, room) & 2u8) == 0 && !a.fence.leases[li].lease_suspend_proposed {
                a.fence.leases[li].lease_suspend_proposed = true
                list.push(mut a.changes, Suspend(room: room, cause: Lease, on: true))
            }
        }
    }
}

/// Home renews its term lease with `RoomDirectory` (CAS-1).
/// Counts the lease from `home_now_ms` (before `renew`) for the returned `lease_ms`,
/// proposing `SetLease` and clearing `Lease`/`Term` suspension on success or setting
/// `Suspend(Term, true)` on stale term.
pub fn home_renew_term(mut a: CascadeAdapter, mut dir: RoomDirectory, room_name: Bytes, home_now_ms: u64) -> Result[u32, DirError] waits {
    let Some(ri) = find_room(a, room_name) else {
        return Error(Unknown)
    }
    let room = a.rooms[ri].room
    let term = a.rooms[ri].term
    let li = ensure_lease(mut a.fence, room_name)
    let seq = a.fence.leases[li].term_renew_seq
    a.fence.leases[li].term_renew_seq += 1
    a.fence.leases[li].last_renew_ms = home_now_ms
    match renew(mut dir, room_name, a.node, term, seq) {
        Ok(lease_ms) => {
            let dl = home_now_ms + int.widen(lease_ms)
            let cur_dl = match router.observer_lease(a.obs, room) {
                Some((d, _)) => order.max(d, a.fence.leases[li].proposed_deadline_ms),
                None => a.fence.leases[li].proposed_deadline_ms,
            }
            let new_dl = order.max(dl, cur_dl)
            a.fence.leases[li].enforced = true
            a.fence.leases[li].proposed_deadline_ms = new_dl
            a.fence.leases[li].lease_suspend_proposed = false
            list.push(mut a.changes, SetLease(room: room, deadline_ms: Some(new_dl), guard_ms: a.limits.guard_ms))
            list.push(mut a.changes, Suspend(room: room, cause: Lease, on: false))
            list.push(mut a.changes, Suspend(room: room, cause: Term, on: false))
            Ok(lease_ms)
        },
        Error(Stale(term: t)) => {
            a.fence.leases[li].proposed_deadline_ms = 0
            list.push(mut a.changes, SetLease(room: room, deadline_ms: Some(0), guard_ms: a.limits.guard_ms))
            list.push(mut a.changes, Suspend(room: room, cause: Term, on: true))
            Error(Stale(term: t))
        },
        Error(e) => Error(e),
    }
}

/// Edge sends a `LeaseRequest` every `L / 3` ms on the link control stream (CAS-5).
pub fn step_edge_leases(mut a: CascadeAdapter, mut hub: LinkHub, now_ms: u64) {
    let lease_w: u64 = int.widen(a.limits.lease_ms)
    let period: u64 = order.max(1u64, lease_w / 3u64)
    for ri in 0u64 .. list.len(a.rooms) {
        if a.rooms[ri].role != Edge || !a.rooms[ri].edge_attached {
            continue
        }
        let rname: Bytes = clone(a.rooms[ri].room_name)
        let li = ensure_lease(mut a.fence, rname)
        if !a.fence.leases[li].enforced || !a.fence.leases[li].fence_table_applied {
            continue
        }
        if a.fence.leases[li].last_req_ms != 0 && now_ms < a.fence.leases[li].last_req_ms + period {
            continue
        }
        let Some(h) = a.rooms[ri].home_handle else {
            continue
        }
        let rn = a.rooms[ri].edge_room_num
        let term = a.rooms[ri].term
        let seq = a.fence.leases[li].next_req_seq
        a.fence.leases[li].next_req_seq += 1
        a.fence.leases[li].last_req_ms = now_ms
        list.push(mut a.fence.pending_reqs, LeaseReqRecord(room_name: clone(rname), seq: seq, sent_ms: now_ms))
        let _ = send_control(mut hub, h, LeaseRequest(room_num: rn, term: term, seq: seq))
    }
}

/// CAS-7: Called when Home attaches an edge: registers/updates the edge in Home's persistent
/// grant ledger and sends `FenceTable` (from `router.Observer`) FIRST before any `LeaseGrant`.
pub fn on_home_edge_attached(mut a: CascadeAdapter, mut hub: LinkHub, ri: u64, h: quic.ConnectionHandle, rn: u32, peer: NodeId, now_ms: u64) {
    let room = a.rooms[ri].room
    let rname: Bytes = clone(a.rooms[ri].room_name)
    let term = a.rooms[ri].term
    let li = ensure_lease(mut a.fence, rname)
    let ft_seq = a.rooms[ri].next_ctrl_seq
    a.rooms[ri].next_ctrl_seq += 1
    let covers_seq = a.fence.leases[li].next_fence_seq - 1
    let existing = find_ledger(a.fence, rname, peer)
    match existing {
        Some(idx) => {
            a.fence.ledger[idx].handle = Some(h)
            a.fence.ledger[idx].room_num = rn
            a.fence.ledger[idx].linked = true
            a.fence.ledger[idx].fence_table_acked = !a.fence.leases[li].enforced
            a.fence.ledger[idx].fence_table_seq = ft_seq
            a.fence.ledger[idx].fence_table_covers_seq = covers_seq
        },
        None => {
            list.push(mut a.fence.ledger, LeaseLedgerEntry(room_name: clone(rname), peer: peer, handle: Some(h), room_num: rn, linked: true, fence_table_acked: !a.fence.leases[li].enforced, fence_table_seq: ft_seq, fence_table_covers_seq: covers_seq, last_grant_ms: 0, has_grant: false, pending_fence_seq: None, acked_fence_seq: 0))
        },
    }
    if a.fence.leases[li].enforced {
        let fences: List[(u64, u64)] = router.observer_fences(a.obs, room)
        list.push(mut a.fence.trace, FenceTrace(kind: TraceFenceTable, room_num: rn, term: term, seq: ft_seq, at_ms: now_ms))
        let _ = send_control(mut hub, h, FenceTable(room_num: rn, term: term, seq: ft_seq, fences: take fences))
    }
}

/// CAS-7: On link loss (`LinkDown`), end room attachments on both sides, recompute demand
/// so dead edges stop pulling layers, and KEEP Home's grant ledger entries intact so pending
/// and future revokes still wait for their leases!
pub fn on_link_lost(mut a: CascadeAdapter, h: quic.ConnectionHandle) {
    for ri in 0u64 .. list.len(a.rooms) {
        if a.rooms[ri].role == Edge {
            if a.rooms[ri].home_handle == Some(h) {
                a.rooms[ri].home_handle = None
                a.rooms[ri].edge_attached = false
                list.clear(mut a.rooms[ri].local_layers)
                clear_local_demand(mut a, ri)
                for pi in 0u64 .. list.len(a.rooms[ri].remote_links) {
                    list.clear(mut a.rooms[ri].remote_links[pi].layers)
                    a.rooms[ri].remote_links[pi].last_sent_mask = 0
                }
                let rname: Bytes = clone(a.rooms[ri].room_name)
                let li = ensure_lease(mut a.fence, rname)
                a.fence.leases[li].fence_table_applied = false
            }
        } else {
            let mut removed = false
            let mut ei = 0u64
            while ei < list.len(a.rooms[ri].edges) {
                if a.rooms[ri].edges[ei].handle == h {
                    let _ = list.remove(mut a.rooms[ri].edges, ei)
                    removed = true
                } else {
                    ei += 1
                }
            }
            if removed {
                recompute_room_demand(mut a, ri)
            }
        }
    }
    // Grant ledger outlives the link (CAS-5): mark unlinked, never remove!
    for i in 0u64 .. list.len(a.fence.ledger) {
        if a.fence.ledger[i].handle == Some(h) {
            a.fence.ledger[i].linked = false
            a.fence.ledger[i].handle = None
        }
    }
}

/// Edge reattaches an existing room onto a new link `new_home_handle` under a fresh
/// link-local room number (CAS-7). Preserves existing `RemoteLink.pub_id` and `published_mask`
/// so local down-tracks resume cleanly once `FenceTable -> FenceTableAck -> LeaseGrant` completes.
pub fn reattach_edge_room(mut a: CascadeAdapter, mut hub: LinkHub, room_name: Bytes, new_home_handle: quic.ConnectionHandle, term: u64) -> Result[u32, LinkError] {
    let Some(ri) = find_room(a, room_name) else {
        return Error(UnknownRoom)
    }
    let rn = alloc_room_num(mut hub, new_home_handle)?
    attach_room_stream(mut hub, new_home_handle, rn, term, true)?
    let seq = a.rooms[ri].next_ctrl_seq
    a.rooms[ri].next_ctrl_seq += 1
    send_control(mut hub, new_home_handle, Attach(room_num: rn, term: term, seq: seq, room_name: clone(room_name)))?
    a.rooms[ri].home_handle = Some(new_home_handle)
    a.rooms[ri].edge_room_num = rn
    a.rooms[ri].edge_attached = false
    if term > a.rooms[ri].term {
        a.rooms[ri].term = term
    }
    let li = ensure_lease(mut a.fence, room_name)
    a.fence.leases[li].fence_table_applied = false
    a.fence.leases[li].last_req_ms = 0
    list.clear(mut a.rooms[ri].local_layers)
    for pi in 0u64 .. list.len(a.rooms[ri].remote_links) {
        list.clear(mut a.rooms[ri].remote_links[pi].layers)
        a.rooms[ri].remote_links[pi].last_sent_mask = 0
    }
    let _ = find_congestion(mut a, new_home_handle)
    Ok(rn)
}

/// CAS-4 step 0-2: Start a cross-node `revoke(room, participant, epoch)` on Home.
/// Commits the fence to `RoomDirectory` first (compare-and-set on term), proposes
/// `Change.Revoke` for local RTC-7 barrier, discards staged packets + room datagrams +
/// repair history, and sends `Fence` on urgency-0 link control stream to EVERY linked edge
/// while marking EVERY ledger entry (linked OR unlinked) as pending `fseq` (blocks renewals!).
pub fn begin_revoke(mut a: CascadeAdapter, mut hub: LinkHub, mut dir: RoomDirectory, room_name: Bytes, participant: u64, epoch: u64, now_ms: u64) -> Result[u64, CascadeError] waits {
    let Some(ri) = find_room(a, room_name) else {
        return Error(Router(NoRoom))
    }
    let room = a.rooms[ri].room
    let term = a.rooms[ri].term
    // Step 0: durable directory commit (CAS on term).
    match commit_fence(mut dir, room_name, term, participant, epoch) {
        Ok(()) => (),
        Error(Stale(term: t)) => return Error(Term(t)),
        Error(_) => return Error(Router(Suspended)),
    }
    // Step 1: propose local RTC-7 Revoke barrier and immediately purge staged/queued media & repair.
    list.push(mut a.changes, Revoke(room: room, id: participant, epoch: epoch))
    let _ = discard_staged(mut hub, now_ms * 1000000)
    drop_all_room_datagrams(a, mut hub, ri)
    purge_repair_fenced(mut a, room_name, participant, epoch)
    let li = ensure_lease(mut a.fence, room_name)
    let fseq = a.fence.leases[li].next_fence_seq
    a.fence.leases[li].next_fence_seq += 1
    // Step 2: send Fence to every linked edge in the grant ledger, and mark EVERY
    // entry in the ledger (linked OR unlinked) as pending `fseq` (blocks renewals!).
    for idx in 0u64 .. list.len(a.fence.ledger) {
        if list.compare_bytes(a.fence.ledger[idx].room_name, room_name) != Equal {
            continue
        }
        a.fence.ledger[idx].pending_fence_seq = Some(fseq)
        if a.fence.ledger[idx].linked {
            if let Some(eh) = a.fence.ledger[idx].handle {
                let ern = a.fence.ledger[idx].room_num
                list.push(mut a.fence.trace, FenceTrace(kind: TraceFence, room_num: ern, term: term, seq: fseq, at_ms: now_ms))
                let _ = send_control(mut hub, eh, Fence(room_num: ern, term: term, seq: fseq, participant: participant, epoch: epoch))
            }
        }
    }
    list.push(mut a.fence.pending_revokes, PendingRevoke(room_name: clone(room_name), term: term, fence_seq: fseq, participant: participant, epoch: epoch, committed: true, started_ms: now_ms))
    Ok(fseq)
}

/// CAS-4 step 4 / CAS-5: Advance pending revokes at `now_ms` (Home's lease clock).
/// Returns `true` only once the local `router.Observer` has applied `Revoke` AND every edge
/// in the grant ledger (linked OR unlinked) has either acknowledged `fence_seq` or waited
/// `ceil(L * (1 + d) / (1 - d))` ms since its last grant (emitting `Severed`).
pub fn poll_revoke(mut a: CascadeAdapter, mut hub: LinkHub, room_name: Bytes, fence_seq: u64, now_ms: u64) -> bool {
    let Some(ri) = find_room(a, room_name) else {
        return false
    }
    let room = a.rooms[ri].room
    // Local RTC-7 barrier must hold in `router.Observer` before revoke can settle.
    for pr in a.fence.pending_revokes {
        if pr.fence_seq == fence_seq && list.compare_bytes(pr.room_name, room_name) == Equal {
            if !router.observer_fenced(a.obs, room, Gen(id: pr.participant, epoch: pr.epoch)) {
                return false
            }
            break
        }
    }
    let wait = lease_wait_ms(a.limits.lease_ms, a.limits.drift_ppm)
    let mut all_settled = true
    let mut i = 0u64
    while i < list.len(a.fence.ledger) {
        if list.compare_bytes(a.fence.ledger[i].room_name, room_name) != Equal {
            i += 1
            continue
        }
        if a.fence.ledger[i].acked_fence_seq >= fence_seq {
            if a.fence.ledger[i].pending_fence_seq == Some(fence_seq) {
                a.fence.ledger[i].pending_fence_seq = None
            }
            i += 1
            continue
        }
        if !a.fence.ledger[i].has_grant {
            // Edge was never granted a lease in this term; cannot forward media.
            a.fence.ledger[i].pending_fence_seq = None
            i += 1
            continue
        }
        if now_ms >= a.fence.ledger[i].last_grant_ms + wait {
            // CAS-5: edge's lease has provably ended even under worst-case ±drift_ppm!
            let peer = a.fence.ledger[i].peer
            let ern = a.fence.ledger[i].room_num
            if let Some(eh) = a.fence.ledger[i].handle {
                detach_room(mut hub, eh, ern)
            }
            let mut removed = false
            let mut ei = 0u64
            while ei < list.len(a.rooms[ri].edges) {
                if a.rooms[ri].edges[ei].peer == peer {
                    let _ = list.remove(mut a.rooms[ri].edges, ei)
                    removed = true
                } else {
                    ei += 1
                }
            }
            if removed {
                recompute_room_demand(mut a, ri)
            }
            list.push(mut a.fence.severed, (clone(room_name), peer))
            let _ = list.remove(mut a.fence.ledger, i)
            continue
        }
        all_settled = false
        i += 1
    }
    if all_settled {
        let mut r = 0u64
        while r < list.len(a.fence.pending_revokes) {
            if a.fence.pending_revokes[r].fence_seq == fence_seq && list.compare_bytes(a.fence.pending_revokes[r].room_name, room_name) == Equal {
                let _ = list.remove(mut a.fence.pending_revokes, r)
            } else {
                r += 1
            }
        }
    }
    all_settled
}

/// Emit any deferred `FenceAck` / `FenceTableAck` once every fence it carries is applied in `a.obs`.
pub fn flush_pending_fence_acks(mut a: CascadeAdapter, mut hub: LinkHub, now_ms: u64) {
    let mut i = 0u64
    while i < list.len(a.fence.pending_acks) {
        let room = a.fence.pending_acks[i].room
        let mut ready = true
        for (p, ep) in a.fence.pending_acks[i].fences {
            if !router.observer_fenced(a.obs, room, Gen(id: p, epoch: ep)) {
                ready = false
                break
            }
        }
        if !ready {
            i += 1
            continue
        }
        let ack = list.remove(mut a.fence.pending_acks, i)
        if ack.is_table {
            if let Some(ri) = find_room_by_id(a, ack.room) {
                let rname: Bytes = clone(a.rooms[ri].room_name)
                let li = ensure_lease(mut a.fence, rname)
                a.fence.leases[li].fence_table_applied = true
                a.fence.leases[li].last_req_ms = 0
            }
            let _ = send_control(mut hub, ack.handle, FenceTableAck(room_num: ack.room_num, term: ack.term, seq: ack.seq))
            list.push(mut a.fence.trace, FenceTrace(kind: TraceFenceTableAck, room_num: ack.room_num, term: ack.term, seq: ack.seq, at_ms: now_ms))
        } else {
            let _ = send_control(mut hub, ack.handle, FenceAck(room_num: ack.room_num, term: ack.term, seq: ack.seq))
            list.push(mut a.fence.trace, FenceTrace(kind: TraceFenceAck, room_num: ack.room_num, term: ack.term, seq: ack.seq, at_ms: now_ms))
        }
    }
}

/// Handle CAS-4/5/7 link control messages (`LeaseRequest`, `LeaseGrant`, `Fence`,
/// `FenceAck`, `FenceTable`, `FenceTableAck`).
pub fn on_fence_ctrl_msg(mut a: CascadeAdapter, mut hub: LinkHub, h: quic.ConnectionHandle, take msg: LinkMsg, now_ms: u64) {
    match take msg {
        LeaseRequest(room_num: rn, term: term, seq: req_seq) => {
            let Some(ri) = find_room_by_link(a, h, rn) else {
                return
            }
            if a.rooms[ri].role != Home || term != a.rooms[ri].term {
                a.fence.stale_msgs_ignored += 1
                return
            }
            let room = a.rooms[ri].room
            let rname: Bytes = clone(a.rooms[ri].room_name)
            let Some(idx) = find_ledger_by_handle(a.fence, rname, h) else {
                return
            }
            // CAS-7: never grant before edge acknowledges the room's fence table!
            if !a.fence.ledger[idx].fence_table_acked {
                return
            }
            // CAS-5: no renewal across a pending fence!
            if a.fence.ledger[idx].pending_fence_seq != None {
                return
            }
            let li = ensure_lease(mut a.fence, rname)
            let grant_rem: u32 = if a.fence.leases[li].enforced {
                let home_dl = match router.observer_lease(a.obs, room) {
                    Some((d, _)) => d,
                    None => 0u64,
                }
                let home_rem = int.saturating_sub(home_dl, now_ms)
                let trans = transitive_remaining_ms(home_rem, a.limits.drift_ppm, a.limits.guard_ms)
                if trans == 0 {
                    return
                }
                let lease_w: u64 = int.widen(a.limits.lease_ms)
                int.narrow(order.min(lease_w, trans))
            } else {
                a.limits.lease_ms
            }
            a.fence.ledger[idx].last_grant_ms = now_ms
            a.fence.ledger[idx].has_grant = true
            list.push(mut a.fence.trace, FenceTrace(kind: TraceLeaseGrant, room_num: rn, term: term, seq: req_seq, at_ms: now_ms))
            let _ = send_control(mut hub, h, LeaseGrant(room_num: rn, term: term, seq: req_seq, remaining_ms: grant_rem))
        },
        LeaseGrant(room_num: rn, term: term, seq: grant_seq, remaining_ms: rem_ms) => {
            let Some(ri) = find_room_by_link(a, h, rn) else {
                return
            }
            if term < a.rooms[ri].term {
                a.fence.stale_msgs_ignored += 1
                return
            }
            let room = a.rooms[ri].room
            let rname: Bytes = clone(a.rooms[ri].room_name)
            // CAS-5: match `grant_seq` against a request this edge actually sent, and
            // count from `sent_ms` (never from receipt time!).
            let mut found_sent: Option[u64] = None
            let mut i = 0u64
            while i < list.len(a.fence.pending_reqs) {
                if list.compare_bytes(a.fence.pending_reqs[i].room_name, rname) == Equal && a.fence.pending_reqs[i].seq == grant_seq {
                    found_sent = Some(a.fence.pending_reqs[i].sent_ms)
                    let _ = list.remove(mut a.fence.pending_reqs, i)
                    break
                }
                i += 1
            }
            let Some(sent_ms) = found_sent else {
                a.fence.late_grants_ignored += 1
                return
            }
            let li = ensure_lease(mut a.fence, rname)
            if a.fence.leases[li].enforced && !a.fence.leases[li].fence_table_applied {
                a.fence.late_grants_ignored += 1
                return
            }
            let lease_w: u64 = int.widen(a.limits.lease_ms)
            let rem_w: u64 = int.widen(rem_ms)
            let dur = order.min(lease_w, rem_w)
            let cand_dl = sent_ms + dur
            let cur_dl = match router.observer_lease(a.obs, room) {
                Some((d, _)) => order.max(d, a.fence.leases[li].proposed_deadline_ms),
                None => a.fence.leases[li].proposed_deadline_ms,
            }
            if cand_dl <= cur_dl {
                a.fence.late_grants_ignored += 1
                return
            }
            a.fence.leases[li].enforced = true
            a.fence.leases[li].proposed_deadline_ms = cand_dl
            list.push(mut a.changes, SetLease(room: room, deadline_ms: Some(cand_dl), guard_ms: a.limits.guard_ms))
            let guard: u64 = int.widen(a.limits.guard_ms)
            if int.saturating_add(now_ms, guard) <= cand_dl {
                // Lift `Lease` (bit 2), and `Term` (bit 4) once the current term's fence table is applied;
                // never lifts `Signaling` (bit 1).
                let causes = router.observer_causes(a.obs, room)
                if (causes & 2u8) != 0 || a.fence.leases[li].lease_suspend_proposed {
                    a.fence.leases[li].lease_suspend_proposed = false
                    list.push(mut a.changes, Suspend(room: room, cause: Lease, on: false))
                }
                if (causes & 4u8) != 0 && a.fence.leases[li].fence_table_applied && term == a.rooms[ri].term {
                    list.push(mut a.changes, Suspend(room: room, cause: Term, on: false))
                }
            }
            list.push(mut a.fence.trace, FenceTrace(kind: TraceLeaseGrant, room_num: rn, term: term, seq: grant_seq, at_ms: now_ms))
        },
        Fence(room_num: rn, term: term, seq: fseq, participant: p, epoch: ep) => {
            let Some(ri) = find_room_by_link(a, h, rn) else {
                return
            }
            if term < a.rooms[ri].term {
                a.fence.stale_msgs_ignored += 1
                return
            }
            let room = a.rooms[ri].room
            let rname: Bytes = clone(a.rooms[ri].room_name)
            list.push(mut a.changes, Revoke(room: room, id: p, epoch: ep))
            let _ = discard_staged(mut hub, now_ms * 1000000)
            drop_all_room_datagrams(a, mut hub, ri)
            purge_repair_fenced(mut a, rname, p, ep)
            list.push(mut a.fence.trace, FenceTrace(kind: TraceFence, room_num: rn, term: term, seq: fseq, at_ms: now_ms))
            let mut fs: List[(u64, u64)] = list.with_capacity(1)
            list.push(mut fs, (p, ep))
            list.push(mut a.fence.pending_acks, PendingFenceAck(room: room, handle: h, room_num: rn, term: term, seq: fseq, fences: take fs, is_table: false))
            flush_pending_fence_acks(mut a, mut hub, now_ms)
        },
        FenceAck(room_num: rn, term: term, seq: fseq) => {
            let Some(ri) = find_room_by_link(a, h, rn) else {
                return
            }
            if term < a.rooms[ri].term {
                a.fence.stale_msgs_ignored += 1
                return
            }
            let rname: Bytes = clone(a.rooms[ri].room_name)
            if let Some(idx) = find_ledger_by_handle(a.fence, rname, h) {
                if fseq > a.fence.ledger[idx].acked_fence_seq {
                    a.fence.ledger[idx].acked_fence_seq = fseq
                }
                if a.fence.ledger[idx].pending_fence_seq == Some(fseq) {
                    a.fence.ledger[idx].pending_fence_seq = None
                }
            }
            list.push(mut a.fence.trace, FenceTrace(kind: TraceFenceAck, room_num: rn, term: term, seq: fseq, at_ms: now_ms))
        },
        FenceTable(room_num: rn, term: term, seq: ft_seq, fences: fs) => {
            let Some(ri) = find_room_by_link(a, h, rn) else {
                return
            }
            if term < a.rooms[ri].term {
                a.fence.stale_msgs_ignored += 1
                return
            }
            let room = a.rooms[ri].room
            let rname: Bytes = clone(a.rooms[ri].room_name)
            for (p, ep) in fs {
                list.push(mut a.changes, Revoke(room: room, id: p, epoch: ep))
                purge_repair_fenced(mut a, clone(rname), p, ep)
            }
            if list.len(fs) != 0 {
                let _ = discard_staged(mut hub, now_ms * 1000000)
                drop_all_room_datagrams(a, mut hub, ri)
            }
            list.push(mut a.fence.trace, FenceTrace(kind: TraceFenceTable, room_num: rn, term: term, seq: ft_seq, at_ms: now_ms))
            list.push(mut a.fence.pending_acks, PendingFenceAck(room: room, handle: h, room_num: rn, term: term, seq: ft_seq, fences: take fs, is_table: true))
            flush_pending_fence_acks(mut a, mut hub, now_ms)
        },
        FenceTableAck(room_num: rn, term: term, seq: ft_seq) => {
            let Some(ri) = find_room_by_link(a, h, rn) else {
                return
            }
            if term < a.rooms[ri].term {
                a.fence.stale_msgs_ignored += 1
                return
            }
            let rname: Bytes = clone(a.rooms[ri].room_name)
            if let Some(idx) = find_ledger_by_handle(a.fence, rname, h) {
                if a.fence.ledger[idx].fence_table_seq == ft_seq {
                    a.fence.ledger[idx].fence_table_acked = true
                    let covers = a.fence.ledger[idx].fence_table_covers_seq
                    if covers > a.fence.ledger[idx].acked_fence_seq {
                        a.fence.ledger[idx].acked_fence_seq = covers
                    }
                    if let Some(ps) = a.fence.ledger[idx].pending_fence_seq {
                        if ps <= covers {
                            a.fence.ledger[idx].pending_fence_seq = None
                        }
                    }
                }
            }
            list.push(mut a.fence.trace, FenceTrace(kind: TraceFenceTableAck, room_num: rn, term: term, seq: ft_seq, at_ms: now_ms))
        },
        _ => (),
    }
}

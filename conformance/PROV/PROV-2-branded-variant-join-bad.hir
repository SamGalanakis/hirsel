// rule: PROV-2
// expect: reject PROV-2 at line 12
// twin: PROV/PROV-1-branded-variant-call-result-ok.hir
// A payload joined from two clocks' instants has no single brand, so inferring
// the construction from it cannot make an `Option[Instant of c]`.
fn either(c: MonotonicClock, d: MonotonicClock, early: bool) -> Result[
  Option[Instant of c],
  ClockError
] {
  let a = clock.monotonic(c)?
  let b = clock.monotonic(d)?
  let t = Some(
    if early {
      a
    } else {
      b
    }
  )
  Ok(t)
}

@test
fn cookie_origin_policy() -> Result[(), ()] {
    if let Ok(_) = request_policy(b"GET", true, true, false, false) {
        fail("cookie upgrade requires matching origin")
    }
    if let Ok(_) = request_policy(b"POST", true, false, false, true) {
        fail("missing or mismatched origin")
    }
    if let Ok(_) = request_policy(b"POST", true, false, true, false) {
        fail("missing or mismatched fetch site")
    }
    let _ = result.unwrap(request_policy(b"GET", true, false, false, false))
    let _ = result.unwrap(request_policy(b"POST", true, false, true, true))
    let _ = result.unwrap(request_policy(b"GET", true, true, true, true))
    Ok(())
}

@test
fn browser_stream_get() -> Result[(), ()] {
    if let Error(_) = stream_policy(b"GET", true, false, false, false, true) {
        fail("same-origin browser GET without Origin must open")
    }
    if let Ok(_) = stream_policy(b"GET", true, false, true, false, true) {
        fail("mismatched Origin on stream")
    }
    if let Ok(_) = stream_policy(b"GET", true, true, false, false, true) {
        fail("upgrade without Origin")
    }
    if let Ok(_) = stream_policy(b"GET", true, false, false, false, false) {
        fail("stream without same-origin evidence")
    }
    Ok(())
}

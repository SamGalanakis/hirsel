#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/bin" "$work/home"
python3 "$root/tools/toolchain-dist/product.py" installer > "$work/install.sh"
export HOME="$work/home" PATH="$work/bin:$PATH"
export HIRSEL_INSTALL_DIR="$work/home/.hirsel" HIRSEL_DOWNLOAD_BASE='' HIRSEL_VERSION=''
export GH_TOKEN='' GITHUB_TOKEN='' EXPECTED_API_AUTH=''
export RELEASES="$work/releases" NEXT_RELEASES="$work/next-releases" EXPECTED_TAG=''
export HOST_OS=Linux HOST_ARCH=x86_64 HOST_GLIBC=2.28 HOST_MACOS=26.0 TRANSLATED=0

cat > "$work/bin/uname" <<'EOF'
#!/bin/sh
case "$*" in
    -s) printf '%s\n' "$HOST_OS" ;;
    -m) printf '%s\n' "$HOST_ARCH" ;;
    *) exit 1 ;;
esac
EOF
cat > "$work/bin/getconf" <<'EOF'
#!/bin/sh
[ "$HOST_OS:$*" = Linux:GNU_LIBC_VERSION ] || exit 1
printf 'glibc %s\n' "$HOST_GLIBC"
EOF
cat > "$work/bin/sw_vers" <<'EOF'
#!/bin/sh
[ "$HOST_OS:$*" = Darwin:-productVersion ] || exit 1
printf '%s\n' "$HOST_MACOS"
EOF
cat > "$work/bin/sysctl" <<'EOF'
#!/bin/sh
[ "$HOST_OS:$*" = 'Darwin:-n sysctl.proc_translated' ] || exit 1
printf '%s\n' "$TRANSLATED"
EOF

cat > "$work/bin/curl" <<'EOF'
#!/bin/sh
auth=''
prev=''
for arg do
    if [ "$prev" = '-H' ]; then
        case "$arg" in
            'Authorization: '*) auth=$arg ;;
        esac
    fi
    case "$arg" in
        --header='Authorization: '*) auth=${arg#--header=} ;;
    esac
    prev=$arg
    url=$arg
done
case "$url" in
    'https://api.github.com/repos/SamGalanakis/hirsel/releases?per_page=100&page=1')
        [ "$auth" = "${EXPECTED_API_AUTH:-}" ] || exit 1
        cat "$RELEASES" ;;
    'https://api.github.com/repos/SamGalanakis/hirsel/releases?per_page=100&page=2')
        [ "$auth" = "${EXPECTED_API_AUTH:-}" ] || exit 1
        cat "$NEXT_RELEASES" ;;
    "https://github.com/SamGalanakis/hirsel/releases/download/$EXPECTED_TAG/SHA256SUMS")
        [ -z "$auth" ] || exit 1
        printf '%064d  hirsel-%s-x86_64-unknown-linux-gnu.tar.gz\n' 0 "$EXPECTED_TAG" ;;
    *) exit 1 ;;
esac
EOF
chmod +x "$work/bin/uname" "$work/bin/getconf" "$work/bin/sw_vers" "$work/bin/sysctl" "$work/bin/curl"
ln -s curl "$work/bin/wget"

run_installer() {
    dash "$work/install.sh" --no-modify-path
}

check_error() {
    if run_installer > "$work/stdout" 2> "$work/stderr"; then
        printf '%s\n' 'installer unexpectedly succeeded' >&2
        exit 1
    fi
    if [ "$(cat "$work/stderr")" != "hirsel installer: $1" ]; then
        printf 'Expected: %s\n' "$1" >&2
        cat "$work/stderr" >&2
        exit 1
    fi
}

check_tag() {
    EXPECTED_TAG=$1
    check_error "cannot download hirsel-$EXPECTED_TAG-x86_64-unknown-linux-gnu.tar.gz"
}

# The public releases list on 2026-11-22, reduced to the fields relevant here.
cat > "$RELEASES" <<'EOF'
[
  {"tag_name": "toolchain-llvm-23.1.5", "prerelease": false, "draft": false}
]
EOF
check_error 'no Hirsel release published yet'

cat > "$RELEASES" <<'EOF'
[
  {"tag_name": "v1.10.0-rc.9"},
  {"tag_name": "toolchain-llvm-23.1.5", "assets": [{"tag_name": "v99.0.0"}]},
  {"tag_name": "v1.9.99-rc.20"},
  {"tag_name": "v1.10.0-rc.10+linux"},
  {"tag_name": "vnext"}
]
EOF
check_tag v1.10.0-rc.10+linux

# Fill the first page to exercise a stable release on the next page.
awk 'BEGIN {
    print "[ {\"tag_name\":\"v1.9.99\"}, {\"tag_name\":\"v2.0.0-rc.1\"}"
    for (i = 1; i <= 98; i++) printf ", {\"tag_name\":\"toolchain-llvm-23.1.%d\"}\n", i
    print "]"
}' > "$RELEASES"
printf '%s\n' '[{"tag_name":"v1.10.0"}, {"tag_name":"v1.2.3"}]' > "$NEXT_RELEASES"
GH_TOKEN='' GITHUB_TOKEN='' EXPECTED_API_AUTH='' check_tag v1.10.0
GH_TOKEN='gh-secret-token' GITHUB_TOKEN='gha-ignored' EXPECTED_API_AUTH='Authorization: Bearer gh-secret-token' check_tag v1.10.0
GH_TOKEN='' GITHUB_TOKEN='gha-secret-token' EXPECTED_API_AUTH='Authorization: Bearer gha-secret-token' check_tag v1.10.0

rm "$RELEASES"
HIRSEL_VERSION=1.2.3 check_tag v1.2.3
HOST_GLIBC=2.27 check_error 'Hirsel requires glibc 2.28 or later (found 2.27)'
HOST_ARCH=aarch64 check_error 'Hirsel requires an x86_64 host'

export HIRSEL_VERSION=v1.2.3 HIRSEL_DOWNLOAD_BASE="file://$work"
linux_asset=hirsel-$HIRSEL_VERSION-x86_64-unknown-linux-gnu.tar.gz
darwin_asset=hirsel-$HIRSEL_VERSION-aarch64-apple-darwin.tar.gz
make_bundle() {
    touch "$work/bundle/$2"
    tar -czf "$work/$1" -C "$work/bundle" .
    rm "$work/bundle/$2"
    (cd "$work" && sha256sum "$1") > "$work/SHA256SUMS"
}

mkdir -p "$work/bundle/bin" "$work/bundle/lib" "$work/bundle/link/kit"
touch "$work/bundle/bin/ld.lld" "$work/bundle/hirsel-core-toolchain.json"
printf '%s\n' '#!/bin/sh' 'printf "%s\n" "bundle v1.2.3"' > "$work/bundle/hirsel"
chmod +x "$work/bundle/hirsel" "$work/bundle/bin/ld.lld"
linux_llvm=$(python3 "$root/tools/toolchain-dist/product.py" llvm-path x86_64-unknown-linux-gnu)
darwin_llvm=$(python3 "$root/tools/toolchain-dist/product.py" llvm-path aarch64-apple-darwin)
make_bundle "$linux_asset" "$linux_llvm"
run_installer
[ "$("$HIRSEL_INSTALL_DIR/bin/hirsel")" = 'bundle v1.2.3' ]

export HOST_OS=Darwin HOST_ARCH=arm64 HIRSEL_INSTALL_DIR="$work/home/darwin"
HOST_MACOS=15.7.2 check_error 'Hirsel requires macOS 26.0 or later (found 15.7.2)'
HOST_MACOS=25.99 check_error 'Hirsel requires macOS 26.0 or later (found 25.99)'
HOST_ARCH=x86_64 check_error 'Hirsel requires x86_64 Linux or an Apple silicon Mac'
check_error 'v1.2.3 has no aarch64-apple-darwin build in this release'
printf 'invalid  %s\n' "$darwin_asset" > "$work/SHA256SUMS"
check_error "SHA256SUMS must list exactly one valid digest for $darwin_asset"
make_bundle "$darwin_asset" "$linux_llvm"
check_error 'release bundle is incomplete'
make_bundle "$darwin_asset" "$darwin_llvm"
run_installer
[ "$("$HIRSEL_INSTALL_DIR/bin/hirsel")" = 'bundle v1.2.3' ]
HOST_ARCH=x86_64 TRANSLATED=1 HOST_MACOS=26.0.1 run_installer

printf '%s\n' 'Installer release resolution and platform checks passed.'

// L20's native case (RUNNER-SPEC v2.11 §8, cover_only_retention): one program, two modes,
// compared by core/tools/runner_tests.py on the charge-observation runtime's retained bytes
// at the `subscribed` checkpoint. argv: mode. Both modes store the same 1,954 rows and hold
// one subscription to `span`, which makes no lookup; its Cover spans 10 rows (mode 0) or all
// 1,954 (mode 1). The client takes the initial Batch and drops it, then takes a barrier
// subscription's empty Batch (the session and the publisher handle events in order, so both
// are past the first Batch by then; the barrier is the same in both modes), then calls
// task.check_cancel(), the event at which core/tools/runner_mark.c records the checkpoint.
// A subscription keeps its Cover and read set, never its rows, so the two figures are equal.
type Hc: send { t: store.Table[u64, u64] }

type Spans = runner.Registry[(), Hc]

const ROWS: u64 = 1954u64

fn migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    let codec: std.codec.Codec[u64] = std.codec.of()
    match store.migration_create_table(mut phase, store.spec("data", std.codec.key_u64(), codec)) {
        Ok(()) => Ok(()),
        Error(Exists(_)) => Ok(()),
        Error(take problem) => Error(take problem),
    }
}

fn handles(catalog: store.Schema) -> Result[Hc, store.Error] {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let t = store.schema_table(catalog, "data", std.codec.key_u64(), cv)?
    Ok(Hc(t: t))
}


// Keys 0 to n - 1 of "data".
fn span(tx: store.Tx, h: Hc, take n: u64) -> Result[runner.Cover, Capacity] {
    runner.cover(store.shape(h.t), Included(0u64), Excluded(n))
}

// The query's bound also holds the rows it projects into the initial Batch: 1,954 in mode 1.
fn place(mut r: Spans) -> Result[(), runner.RegisterError] {
    runner.query(mut r, code.describe(span), 524288u64, runner.DEFAULT_STEPS)
}

// identity ++ fingerprint(A) ++ fingerprint(()), as a client builds a query's key.
fn k_span() -> Bytes {
    let mut key: Bytes = list.new()
    result.unwrap(list.append(mut key, code.identity(code.describe(span))))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(std.codec.of_u64())), mut key))
    let unit: std.codec.Codec[()] = std.codec.of_unit()
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(unit)), mut key))
    key
}

fn arg(n: u64) -> Bytes {
    let mut a: Bytes = list.new()
    result.unwrap(std.codec.encode(std.codec.of_u64(), n, mut a))
    a
}

type D: send { authority: store.AuthorityReader, head: Sender[runner.Req], post: Sender[runner.PubIn], clock: Clock, tasks: Tasks, net: Net, random: Random, policy: ingress.Ingress, covered: u64 }

// The initial Batch of `sub`, whole: it names sub complete and carries `rows` rows.
fn initial(cn: wire_client.Conn, sub: u32, rows: u64) -> () waits {
    match wire_client.next(cn) {
        Ok(Batch(_, take complete, take got, _)) => {
            if list.len(complete) != 1u64 || complete[0u64] != sub || list.len(got) != rows {
                fail("runner_cover: an initial Batch not whole")
            }
        },
        Ok(_) => fail("runner_cover: a frame other than a Batch"),
        Error(_) => fail("runner_cover: client channel closed"),
    }
}

fn drive(take d: D) -> () waits {
    let mut keys: List[Bytes] = list.new()
    result.unwrap(list.push(mut keys, k_span()))
    let mut config = runner.wire_defaults(131072u64, 65536u64)
    config.q = 0u64
    config.budget = 262144u64
    config.socket.max_frame = 131072u64
    // The session task funds the connection owner's floor and its pool, which at 128 KiB
    // frames is above 2 MiB.
    let (cn, session) = result.unwrap(wire_client.pair_config(d.tasks, d.net, d.clock, d.random, d.policy,
        d.head, d.post, d.authority, code.describe(place), keys, None, config, 8388608u64))
    wire_client.send_frame(cn, Subscribe(1u32, 0u32, arg(d.covered), None))
    initial(cn, 1u32, d.covered)
    wire_client.send_frame(cn, Subscribe(2u32, 0u32, arg(0u64), None))
    initial(cn, 2u32, 0u64)
    task.check_cancel()
    let _ = wire_client.close(take cn)
    let _ = task.join(take session)
}

fn fill(mut db: store.Db, t: store.Table[u64, u64], from: u64, to: u64) -> () waits {
    let done = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        for k in from .. to {
            store.put(mut tx, t, k, k)?
        }
        Ok(())
    })
    match take done {
        Ok(Committed(_)) => (),
        _ => fail("runner_cover: a fixture put"),
    }
}

pub fn main(clock: Clock, random: Random, tasks: Tasks, net: Net, argv: Args) -> Result[(), Exit] waits {
    let Some(m) = args.get(argv, 0) else { return Error(Exit(status: 2)) }
    let covered = if result.unwrap(std.int.parse_uint(m, 10u32)) == 1u64 { ROWS } else { 10u64 }
    let mut db = store.memory(clock, random, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let h = match store.with_schema(db, code.describe(handles)) {
        Ok(take h) => take h,
        Error(_) => return Error(Exit(status: 5)),
    }
    let mut k = 0u64
    while k < ROWS {
        let next = if k + 100u64 < ROWS { k + 100u64 } else { ROWS }
        fill(mut db, h.t, k, next)
        k = next
    }
    let made: Result[(Sender[runner.Req], Receiver[runner.Req]), Capacity] = channel.new(64u64)
    let (head, inbox) = result.unwrap(take made)
    let mail = result.unwrap(runner.mailbox(4u64))
    let (policy, take policy_handle) = result.unwrap(ingress.start(tasks, clock, random, ingress.defaults(), 1048576u64))
    let d = D(authority: store.authority_reader(db), head: take head, post: runner.post(mail), clock: clock, tasks: tasks, net: net, random: random, policy: ingress.share(policy), covered: covered)
    let driving = match task.spawn(tasks, bytes 33554432u64, take d, drive) {
        Ok(take t) => take t,
        Error(_) => return Error(Exit(status: 3)),
    }
    match runner.place_head(take db, code.describe(place), 1048576u64, code.describe(migrate), code.describe(handles), take inbox, take mail, tasks, 1048576u64) {
        Ok(()) => (),
        Error(_) => return Error(Exit(status: 4)),
    }
    let driven = task.join(take driving)
    let mut policy_task = take policy_handle
    task.cancel(mut policy_task)
    let _ = task.join(take policy_task)
    match driven {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 6)),
    }
}

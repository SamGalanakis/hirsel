// latest.publish and read across tasks: the reader reads after its go.
type In:send { h: Latest[u64], go: Receiver[u64], out: Stdout }
fn number(x: u64) -> u64 { x }
fn reader(take s: In) -> u64 waits {
    let In(h: h, go: go, out: out) = take s
    let first = number(latest.read(h))
    result.unwrap(stdout.write(out, "r"))
    let _ = result.unwrap(channel.receive(go))
    let second = number(latest.read(h))
    result.unwrap(stdout.write(out, "s"))
    first * 10u64 + second
}
pub fn main(tasks: Tasks, out: Stdout) -> Result[(), Exit] waits {
    let h = latest.new(arc.new(1u64))
    let (go, go_rx): (Sender[u64], Receiver[u64]) = channel.new(1)
    let t = task.spawn(tasks, bytes 4096, In(h: latest.handle(h), go: take go_rx, out: out), reader)
    latest.publish(h, arc.new(2u64))
    result.unwrap(stdout.write(out, "p"))
    result.unwrap(channel.send(go, 0u64))
    latest.publish(h, arc.new(3u64))
    result.unwrap(stdout.write(out, "q"))
    let seen = result.unwrap(task.join(take t))
    if seen == 23u64 { result.unwrap(stdout.write(out, "=")) } else if seen == 33u64 { result.unwrap(stdout.write(out, "3")) } else if seen == 22u64 { result.unwrap(stdout.write(out, "2")) } else { result.unwrap(stdout.write(out, "?")) }
    Ok(())
}

// Empty Map has no allocation, including through a generic body.
// expect: run checked() = 0
fn empty[K: key, V]() -> Map[K,V] { map.new() }
fn count[K: key, V](m: Map[K,V]) -> u64 { map.len(m) }
fn checked() -> u64 {
  let a: Map[u64,u64] = map.new()
  let b: Map[u8,(u64,u8)] = empty()
  map.len(a) + count(b)
}

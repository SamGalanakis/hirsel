// Module `codec` (SEM-10): Codec[T], the protocol a generated codec calls, the byte format,
// the built-in codecs of core.md's codec rows, schemas, writer/reader resolution and the
// fingerprint. Field legend: API.md.
//
// Format. Integers at their width, a float as its IEEE bits, a `char` as its scalar in a
// u32, all little-endian; `bool` one byte, 0 or 1; `()` nothing. String, List and Map: a
// u32 count, then the UTF-8 bytes, the elements, or key and value per entry in insertion
// order. Option, Result and every sum: the declared variant index, removed variants
// counted, as a u32, then the variant's fields. A record or tuple: its fields in
// declaration order; a removed field is not written. Nothing frames a value but its
// type, so a value is decoded against the schema that wrote it. The version byte of a
// schema fixes these widths: a decoder written from a version-3 schema alone, in any
// language, reads u32 counts and lengths and u32 tags. Counts above u32::MAX return
// CountOverflow(count) before the count is written.
/// SEM-10's decode errors; each u64 is a byte offset, into the writer's schema for
/// `Schema` and into the decoded bytes otherwise. `Value(i)`: the `from` of a `via` codec
/// refused the value that starts at i.
pub type DecodeError = Truncated(u64) | Invalid(u64) | Utf8(u64) | Duplicate(u64) | Trailing(u64) | Schema(u64) | Value(u64)

/// An encoder could not represent a count in the format's u32 field.
pub type EncodeError = CountOverflow(u64)

/// The codec of T: plain, so a store's shape holds it. Generated codecs and the built-in
/// codecs below provide `of`. `least` is a lower bound on encoded length.
pub opaque type Codec[T] {
    encoder: fn(T, mut Bytes) -> Result[(), EncodeError],
    decoder: fn(Bytes, mut u64) -> Result[T, DecodeError],
    describer: fn(mut Schema, Codec[T]) -> Result[(), EncodeError],
    smallest: u64,
    empty: bool,
}

/// A codec from its parts; a generated codec calls this once per type.
/// Ex: `codec.make(row_encode, row_decode, row_schema, 9)`
pub fn make[T](e: fn(T, mut Bytes) -> Result[(), EncodeError], d: fn(Bytes, mut u64) -> Result[T, DecodeError], w: fn(mut Schema, Codec[T]) -> Result[(), EncodeError], n: u64) -> Codec[T] {
    make_derived(e, d, w, n, false)
}

/// The maker used by derivation, which knows whether the type has any encodings.
pub fn make_derived[T](e: fn(T, mut Bytes) -> Result[(), EncodeError], d: fn(Bytes, mut u64) -> Result[T, DecodeError], w: fn(mut Schema, Codec[T]) -> Result[(), EncodeError], n: u64, empty: bool) -> Codec[T] {
    Codec(encoder: e, decoder: d, describer: w, smallest: n, empty: empty)
}

/// Whether the derived codec has no encodings.
pub fn is_empty[T](c: Codec[T]) -> bool {
    c.empty
}

/// A lower bound on the encoded length of any value of this type. Cost: O(1).
pub fn least[T](c: Codec[T]) -> u64 {
    c.smallest
}

// The whole-value entry points.
/// Appends x's bytes to out. Fails: Capacity; out then holds a prefix of x's bytes.
/// Error(CountOverflow(n)) reports an unrepresentable count before it is written.
/// Ex: `codec.encode(rows, row, mut out)?`
pub fn encode[T](c: Codec[T], x: T, mut out: Bytes) -> Result[(), EncodeError] {
    (c.encoder)(x, mut out)
}

/// Decodes all of b against c's own schema: exactly the bytes encode produces.
/// Returns DecodeError for bytes no value encodes to. Refused admission raises
/// Capacity. Either way nothing it admitted remains. Ex: `codec.decode(rows, b)?`
pub fn decode[T](c: Codec[T], b: Bytes) -> Result[T, DecodeError] {
    decode_at(c, b, 0)
}

/// Decodes b from `start` to its end, as decode does; offsets are into b. A stored
/// value behind a header is read in place. Ex: `codec.decode_at(rows, row, 2)?`
pub fn decode_at[T](c: Codec[T], b: Bytes, start: u64) -> Result[T, DecodeError] {
    if start > list.len(b) {
        return Error(Truncated(list.len(b)))
    }
    let mut at = start
    match take_with(b, mut at, c) {
        Ok(x) => {
            if at != list.len(b) {
                return Error(Trailing(at))
            }
            Ok(take x)
        }
        Error(e) => Error(e),
    }
}

// The protocol: one put and one take per format row. A generated encode calls the puts
// in declaration order and a generated decode the takes; `at` is the read offset.
/// Truncated at `at` unless n more bytes follow it.
pub fn need(b: Bytes, at: u64, n: u64) -> Result[(), DecodeError] {
    if list.len(b) - at < n {
        return Error(Truncated(at))
    }
    Ok(())
}

fn put_byte(mut out: Bytes, x: u8) {
    list.push(mut out, x)
}

pub fn put_unit(x: (), mut out: Bytes) {}

pub fn take_unit(b: Bytes, mut at: u64) -> Result[(), DecodeError] {
    Ok(())
}

pub fn put_bool(x: bool, mut out: Bytes) {
    put_byte(mut out, if x {
        1
    } else {
        0
    })
}

pub fn take_bool(b: Bytes, mut at: u64) -> Result[bool, DecodeError] {
    need(b, at, 1)?
    let x = b[at]
    if x > 1 {
        return Error(Invalid(at))
    }
    at += 1
    Ok(x == 1)
}

pub fn put_u8(x: u8, mut out: Bytes) {
    put_byte(mut out, x)
}

pub fn take_u8(b: Bytes, mut at: u64) -> Result[u8, DecodeError] {
    need(b, at, 1)?
    let x = b[at]
    at += 1
    Ok(x)
}

pub fn put_u16(x: u16, mut out: Bytes) {
    list.put_word_le(mut out, x)
}

pub fn take_u16(b: Bytes, mut at: u64) -> Result[u16, DecodeError] {
    need(b, at, 2)?
    let x: u16 = list.word_le(b, at)
    at += 2
    Ok(x)
}

pub fn put_u32(x: u32, mut out: Bytes) {
    list.put_word_le(mut out, x)
}

pub fn take_u32(b: Bytes, mut at: u64) -> Result[u32, DecodeError] {
    need(b, at, 4)?
    let x: u32 = list.word_le(b, at)
    at += 4
    Ok(x)
}

pub fn put_u64(x: u64, mut out: Bytes) {
    list.put_word_le(mut out, x)
}

pub fn take_u64(b: Bytes, mut at: u64) -> Result[u64, DecodeError] {
    need(b, at, 8)?
    let x = list.word_le(b, at)
    at += 8
    Ok(x)
}

pub fn put_i8(x: i8, mut out: Bytes) {
    put_byte(mut out, int.truncate(x))
}

pub fn take_i8(b: Bytes, mut at: u64) -> Result[i8, DecodeError] {
    let x = take_u8(b, mut at)?
    Ok(int.truncate(x))
}

pub fn put_i16(x: i16, mut out: Bytes) {
    let bits: u16 = int.truncate(x)
    put_u16(bits, mut out)
}

pub fn take_i16(b: Bytes, mut at: u64) -> Result[i16, DecodeError] {
    let x = take_u16(b, mut at)?
    Ok(int.truncate(x))
}

pub fn put_i32(x: i32, mut out: Bytes) {
    let bits: u32 = int.truncate(x)
    put_u32(bits, mut out)
}

pub fn take_i32(b: Bytes, mut at: u64) -> Result[i32, DecodeError] {
    let x = take_u32(b, mut at)?
    Ok(int.truncate(x))
}

pub fn put_i64(x: i64, mut out: Bytes) {
    let bits: u64 = int.truncate(x)
    list.put_word_le(mut out, bits)
}

pub fn take_i64(b: Bytes, mut at: u64) -> Result[i64, DecodeError] {
    let x = take_u64(b, mut at)?
    Ok(int.truncate(x))
}

/// SEM-2's one NaN is 0x7fc00000; any other NaN pattern is no f32's bytes.
pub fn put_f32(x: f32, mut out: Bytes) {
    put_u32(float.to_bits32(x), mut out)
}

pub fn take_f32(b: Bytes, mut at: u64) -> Result[f32, DecodeError] {
    let start = at
    let x = take_u32(b, mut at)?
    if x & 0x7f800000 == 0x7f800000 && x & 0x7fffff != 0 && x != 0x7fc00000 {
        return Error(Invalid(start))
    }
    Ok(float.from_bits32(x))
}

/// SEM-2's one NaN is 0x7ff8000000000000; any other NaN pattern is no f64's bytes.
pub fn put_f64(x: f64, mut out: Bytes) {
    list.put_word_le(mut out, float.to_bits64(x))
}

pub fn take_f64(b: Bytes, mut at: u64) -> Result[f64, DecodeError] {
    need(b, at, 8)?
    let x = list.word_le(b, at)
    if x & 0x7ff0000000000000 == 0x7ff0000000000000 && x & 0xfffffffffffff != 0 && x != 0x7ff8000000000000 {
        return Error(Invalid(at))
    }
    at += 8
    Ok(float.from_bits64(x))
}

pub fn put_char(x: char, mut out: Bytes) {
    put_u32(char.to_u32(x), mut out)
}

pub fn take_char(b: Bytes, mut at: u64) -> Result[char, DecodeError] {
    let start = at
    let x = take_u32(b, mut at)?
    match char.from_u32(x) {
        Some(c) => Ok(c),
        None => Error(Invalid(start))
    }
}

// Check the wire width before any narrowing or output admission.
fn checked_count(n: u64) -> Result[u32, EncodeError] {
    if n > 0xffffffff {
        return Error(CountOverflow(n))
    }
    Ok(int.truncate(n))
}

fn put_count(n: u64, mut out: Bytes) -> Result[(), EncodeError] {
    let mut bits = checked_count(n)?
    list.fill(mut out, 4, 0u8)
    let end = list.len(out)
    for i in end - 4 .. end {
        out[i] = int.truncate(bits)
        bits = bits >> 8
    }
    Ok(())
}

pub fn put_string(x: String, mut out: Bytes) -> Result[(), EncodeError] {
    let raw = string.as_bytes(x)
    let mut bits = checked_count(list.len(raw))?
    // Keep prefix and payload in one encoder; put_count's growth body prevents inlining.
    list.fill(mut out, 4, 0u8)
    let end = list.len(out)
    for i in end - 4 .. end {
        out[i] = int.truncate(bits)
        bits = bits >> 8
    }
    list.append(mut out, raw)
    Ok(())
}

/// The count, then exactly that many bytes, copied into exact capacity and checked UTF-8.
pub fn take_string(b: Bytes, mut at: u64) -> Result[String, DecodeError] {
    let start = at
    let n: u64 = int.widen(take_u32(b, mut at)?)
    if list.len(b) - at < n {
        return Error(Truncated(start))
    }
    let mut buf: Bytes = list.with_capacity(n)
    let _ = list.append(mut buf, list.slice(b, at, at + n))
    match string.from_utf8(take buf) {
        Ok(s) => {
            at += n
            Ok(take s)
        }
        Error(_) => {
            let stop = match utf8.validate(list.slice(b, at, at + n)) {
                Ok(()) => n,
                Error(e) => e.valid_up_to,
            }
            Error(Utf8(at + stop))
        },
    }
}

/// A variant tag: the declared index of the variant, below `count`, else Invalid at it.
/// Written as a u32 whatever the number of variants (SEM-10).
pub fn put_tag(x: u32, mut out: Bytes) {
    put_u32(x, mut out)
}

pub fn take_tag(b: Bytes, mut at: u64, count: u32) -> Result[u32, DecodeError] {
    let start = at
    let x = take_u32(b, mut at)?
    if x >= count {
        return Error(Invalid(start))
    }
    Ok(x)
}

/// x with its codec: what a generated codec calls for a field of a non-scalar type.
pub fn put_with[T](x: T, c: Codec[T], mut out: Bytes) -> Result[(), EncodeError] {
    (c.encoder)(x, mut out)
}

pub fn take_with[T](b: Bytes, mut at: u64, c: Codec[T]) -> Result[T, DecodeError] {
    let start = at
    take_payload(b, mut at, c, start)
}

fn take_payload[T](b: Bytes, mut at: u64, c: Codec[T], start: u64) -> Result[T, DecodeError] {
    if c.empty {
        return Error(Invalid(start))
    }
    (c.decoder)(b, mut at)
}

pub fn put_list[T](xs: List[T], c: Codec[T], mut out: Bytes) -> Result[(), EncodeError] {
    put_count(list.len(xs), mut out)?
    for x in xs {
        (c.encoder)(x, mut out)?
    }
    Ok(())
}

/// A List's or Map's count, Truncated at the count when n items of at least `least`
/// bytes each cannot fit in what remains. A frame loop calls it for a recursive field.
pub fn take_count(b: Bytes, mut at: u64, size: u64) -> Result[u64, DecodeError] {
    let start = at
    let n: u64 = int.widen(take_u32(b, mut at)?)
    if size != 0 && n > (list.len(b) - at) / size {
        return Error(Truncated(start))
    }
    Ok(n)
}

/// An empty list with room for exactly n elements.
pub fn room[T](n: u64) -> List[T] {
    list.with_capacity(n)
}

/// The count, then the elements. A count no remaining bytes could hold is Truncated at
/// the list before anything is admitted, so the list's storage is admitted once, exactly.
pub fn take_list[T](b: Bytes, mut at: u64, c: Codec[T]) -> Result[List[T], DecodeError] {
    let n = take_count(b, mut at, c.smallest)?
    let mut xs: List[T] = room(n)
    let mut i: u64 = 0
    while i < n {
        let x = take_with(b, mut at, c)?
        list.push(mut xs, take x)
        i += 1
    }
    Ok(take xs)
}

pub fn put_map[K: key, V](m: Map[K, V], ck: Codec[K], cv: Codec[V], mut out: Bytes) -> Result[(), EncodeError] {
    put_count(map.len(m), mut out)?
    for (k, v) in m {
        (ck.encoder)(k, mut out)?
        (cv.encoder)(v, mut out)?
    }
    Ok(())
}

/// The count, then key and value per entry in insertion order; a key equal to an earlier
/// one is Duplicate at the key.
pub fn take_map[K: key, V](b: Bytes, mut at: u64, ck: Codec[K], cv: Codec[V]) -> Result[Map[K, V], DecodeError] {
    let n = take_count(b, mut at, ck.smallest + cv.smallest)?
    let mut m: Map[K, V] = map.new()
    map.reserve(mut m, n)
    let mut i: u64 = 0
    while i < n {
        let key_at = at
        let k = take_with(b, mut at, ck)?
        if map.contains(m, k) {
            return Error(Duplicate(key_at))
        }
        let v = take_with(b, mut at, cv)?
        map.insert(mut m, take k, take v)
        i += 1
    }
    Ok(take m)
}

pub fn put_option[T](x: Option[T], c: Codec[T], mut out: Bytes) -> Result[(), EncodeError] {
    match x {
        None => {
            put_tag(0, mut out)
            Ok(())
        },
        Some(v) => {
            put_tag(1, mut out)
            (c.encoder)(v, mut out)
        }
    }
}

pub fn take_option[T](b: Bytes, mut at: u64, c: Codec[T]) -> Result[Option[T], DecodeError] {
    let start = at
    if take_tag(b, mut at, 2)? == 0 {
        return Ok(None)
    }
    let v = take_payload(b, mut at, c, start)?
    Ok(Some(take v))
}

pub fn put_result[T, E](x: Result[T, E], ct: Codec[T], ce: Codec[E], mut out: Bytes) -> Result[(), EncodeError] {
    match x {
        Ok(v) => {
            put_tag(0, mut out)
            (ct.encoder)(v, mut out)
        }
        Error(e) => {
            put_tag(1, mut out)
            (ce.encoder)(e, mut out)
        }
    }
}

pub fn take_result[T, E](b: Bytes, mut at: u64, ct: Codec[T], ce: Codec[E]) -> Result[Result[T, E], DecodeError] {
    let start = at
    if take_tag(b, mut at, 2)? == 0 {
        let v = take_payload(b, mut at, ct, start)?
        return Ok(Ok(take v))
    }
    let e = take_payload(b, mut at, ce, start)?
    Ok(Error(take e))
}

/// A `codec via R (to, from)` type decodes an R under R's codec, then calls from once; an
/// Error from it is dropped and the result is Value where the R began (SEM-10). Encoding
/// needs no step of its own: `to` returns a view anchored to its argument, which no
/// callable type holds (LANG-13), so a generated encode is `put_with(to(x), c, mut out)`.
pub fn take_via[T, R, E](b: Bytes, mut at: u64, c: Codec[R], from: fn(take R) -> Result[T, E]) -> Result[T, DecodeError] {
    let start = at
    let r = take_with(b, mut at, c)?
    match from(take r) {
        Ok(x) => Ok(take x),
        Error(_) => Error(Value(start))
    }
}

// A built-in codec's describer: its scalar's schema.
fn describe_unit(mut s: Schema, _c: Codec[()]) -> Result[(), EncodeError] {
    schema_unit(mut s)
    Ok(())
}

fn describe_bool(mut s: Schema, _c: Codec[bool]) -> Result[(), EncodeError] {
    schema_bool(mut s)
    Ok(())
}

fn describe_char(mut s: Schema, _c: Codec[char]) -> Result[(), EncodeError] {
    schema_char(mut s)
    Ok(())
}

fn describe_u8(mut s: Schema, _c: Codec[u8]) -> Result[(), EncodeError] {
    schema_u8(mut s)
    Ok(())
}

fn describe_u16(mut s: Schema, _c: Codec[u16]) -> Result[(), EncodeError] {
    schema_u16(mut s)
    Ok(())
}

fn describe_u32(mut s: Schema, _c: Codec[u32]) -> Result[(), EncodeError] {
    schema_u32(mut s)
    Ok(())
}

fn describe_u64(mut s: Schema, _c: Codec[u64]) -> Result[(), EncodeError] {
    schema_u64(mut s)
    Ok(())
}

fn describe_i8(mut s: Schema, _c: Codec[i8]) -> Result[(), EncodeError] {
    schema_i8(mut s)
    Ok(())
}

fn describe_i16(mut s: Schema, _c: Codec[i16]) -> Result[(), EncodeError] {
    schema_i16(mut s)
    Ok(())
}

fn describe_i32(mut s: Schema, _c: Codec[i32]) -> Result[(), EncodeError] {
    schema_i32(mut s)
    Ok(())
}

fn describe_i64(mut s: Schema, _c: Codec[i64]) -> Result[(), EncodeError] {
    schema_i64(mut s)
    Ok(())
}

fn describe_f32(mut s: Schema, _c: Codec[f32]) -> Result[(), EncodeError] {
    schema_f32(mut s)
    Ok(())
}

fn describe_f64(mut s: Schema, _c: Codec[f64]) -> Result[(), EncodeError] {
    schema_f64(mut s)
    Ok(())
}

fn describe_string(mut s: Schema, _c: Codec[String]) -> Result[(), EncodeError] {
    schema_string(mut s)
    Ok(())
}

/// T's codec. The checker resolves each call by the instance's T (SEM-10): to the built-in
/// codec below for a scalar, `()`, Never and String, to the structural codec for List,
/// Option, Map and Result, to a componentwise codec for a tuple, and to the codec
/// generated from T's declaration for a nominal type. No instance
/// of `of` is ever built, so this body, which only states the signature in checked Hirsel,
/// never runs.
pub fn of[T: codec]() -> Codec[T] {
    of()
}

// The structural codecs: `of` resolves to these at List, Option, Map and Result (Bytes is
// List[u8]). Each is the field path itself, put_list and the rest with `of()` for the
// elements, so a value encodes as the same type does as a field.
/// The codec of List[E]: the u32 count, then each element. Ex: `let c: Codec[List[u64]] = codec.of()`
pub fn of_list[E: codec]() -> Codec[List[E]] {
    make(list_encode, list_decode, describe_list, 4)
}

/// The codec of Bytes (List[u8]), which `of` resolves to at List[u8]: the u32 count, then
/// the bytes, moved in bulk. Its bytes, charges, failures and schema are of_list's at u8.
pub fn of_bytes() -> Codec[Bytes] {
    make(put_bytes, take_bytes, describe_bytes, 4)
}

/// The count, then the bytes. out grows as pushing them one by one grows it, by one
/// growth at a time, so a Capacity leaves the same prefix and the same capacity.
fn put_bytes(xs: Bytes, mut out: Bytes) -> Result[(), EncodeError] {
    put_count(list.len(xs), mut out)?
    let n = list.len(xs)
    let mut i: u64 = 0
    while i < n {
        let space = list.capacity(out) - list.len(out)
        if space == 0 {
            // Growth only where put_byte's push would grow out, by MEM-24 as it does.
            put_byte(mut out, xs[i])
            i += 1
        } else {
            let k = if space < n - i {
                space
            } else {
                n - i
            }
            list.append(mut out, list.slice(xs, i, i + k))
            i += k
        }
    }
    Ok(())
}

/// The count, Truncated at the count when fewer bytes remain, then exactly that many.
fn take_bytes(b: Bytes, mut at: u64) -> Result[Bytes, DecodeError] {
    let n = take_count(b, mut at, 1)?
    let mut xs: Bytes = room(n)
    // Within the exact capacity room admitted, so the append never grows.
    let _ = list.append(mut xs, list.slice(b, at, at + n))
    at += n
    Ok(take xs)
}

fn describe_bytes(mut s: Schema, _c: Codec[Bytes]) -> Result[(), EncodeError] {
    schema_list(mut s, of_u8())
}

/// The codec of Option[E]: tag 0 for None, or tag 1 then the value.
pub fn of_option[E: codec]() -> Codec[Option[E]] {
    make(option_encode, option_decode, describe_option, 4)
}

/// The codec of Map[K, V]: the u32 count, then key and value per entry in insertion order.
pub fn of_map[K: key + codec, V: codec]() -> Codec[Map[K, V]] {
    make(map_encode, map_decode, describe_map, 4)
}

/// The codec of Result[T, E]: tag 0 then the Ok value, or tag 1 then the Error value.
pub fn of_result[T: codec, E: codec]() -> Codec[Result[T, E]] {
    let ct: Codec[T] = of()
    let ce: Codec[E] = of()
    make_derived(result_encode, result_decode, describe_result, 4, ct.empty && ce.empty)
}

fn list_encode[E: codec](xs: List[E], mut out: Bytes) -> Result[(), EncodeError] {
    put_list(xs, of(), mut out)
}

fn list_decode[E: codec](b: Bytes, mut at: u64) -> Result[List[E], DecodeError] {
    let c: Codec[E] = of()
    take_list(b, mut at, c)
}

fn describe_list[E: codec](mut s: Schema, _c: Codec[List[E]]) -> Result[(), EncodeError] {
    let c: Codec[E] = of()
    schema_list(mut s, c)
}

fn option_encode[E: codec](x: Option[E], mut out: Bytes) -> Result[(), EncodeError] {
    put_option(x, of(), mut out)
}

fn option_decode[E: codec](b: Bytes, mut at: u64) -> Result[Option[E], DecodeError] {
    let c: Codec[E] = of()
    take_option(b, mut at, c)
}

fn describe_option[E: codec](mut s: Schema, _c: Codec[Option[E]]) -> Result[(), EncodeError] {
    let c: Codec[E] = of()
    schema_option(mut s, c)
}

fn map_encode[K: key + codec, V: codec](m: Map[K, V], mut out: Bytes) -> Result[(), EncodeError] {
    put_map(m, of(), of(), mut out)
}

fn map_decode[K: key + codec, V: codec](b: Bytes, mut at: u64) -> Result[Map[K, V], DecodeError] {
    let ck: Codec[K] = of()
    let cv: Codec[V] = of()
    take_map(b, mut at, ck, cv)
}

fn describe_map[K: key + codec, V: codec](mut s: Schema, _c: Codec[Map[K, V]]) -> Result[(), EncodeError] {
    let ck: Codec[K] = of()
    let cv: Codec[V] = of()
    schema_map(mut s, ck, cv)
}

fn result_encode[T: codec, E: codec](x: Result[T, E], mut out: Bytes) -> Result[(), EncodeError] {
    put_result(x, of(), of(), mut out)
}

fn result_decode[T: codec, E: codec](b: Bytes, mut at: u64) -> Result[Result[T, E], DecodeError] {
    let ct: Codec[T] = of()
    let ce: Codec[E] = of()
    take_result(b, mut at, ct, ce)
}

fn describe_result[T: codec, E: codec](mut s: Schema, _c: Codec[Result[T, E]]) -> Result[(), EncodeError] {
    let ct: Codec[T] = of()
    let ce: Codec[E] = of()
    schema_result(mut s, ct, ce)
}

// The built-in codecs: core.md's codec rows. `of` resolves to these at scalar types.
fn encode_unit(x: (), mut out: Bytes) -> Result[(), EncodeError] {
    put_unit(x, mut out)
    Ok(())
}

pub fn of_unit() -> Codec[()] {
    make(encode_unit, take_unit, describe_unit, 0)
}

fn take_never(b: Bytes, mut at: u64) -> Result[Never, DecodeError] {
    Error(Invalid(at))
}

fn describe_never(mut s: Schema, _c: Codec[Never]) -> Result[(), EncodeError] {
    opcode(mut s, 20)
    Ok(())
}

fn encode_never(x: Never, mut out: Bytes) -> Result[(), EncodeError] {
    x
}

pub fn of_never() -> Codec[Never] {
    make_derived(encode_never, take_never, describe_never, 0, true)
}

fn encode_bool(x: bool, mut out: Bytes) -> Result[(), EncodeError] {
    put_bool(x, mut out)
    Ok(())
}

pub fn of_bool() -> Codec[bool] {
    make(encode_bool, take_bool, describe_bool, 1)
}

fn encode_char(x: char, mut out: Bytes) -> Result[(), EncodeError] {
    put_char(x, mut out)
    Ok(())
}

pub fn of_char() -> Codec[char] {
    make(encode_char, take_char, describe_char, 4)
}

fn encode_u8(x: u8, mut out: Bytes) -> Result[(), EncodeError] {
    put_u8(x, mut out)
    Ok(())
}

pub fn of_u8() -> Codec[u8] {
    make(encode_u8, take_u8, describe_u8, 1)
}

fn encode_u16(x: u16, mut out: Bytes) -> Result[(), EncodeError] {
    put_u16(x, mut out)
    Ok(())
}

pub fn of_u16() -> Codec[u16] {
    make(encode_u16, take_u16, describe_u16, 2)
}

fn encode_u32(x: u32, mut out: Bytes) -> Result[(), EncodeError] {
    put_u32(x, mut out)
    Ok(())
}

pub fn of_u32() -> Codec[u32] {
    make(encode_u32, take_u32, describe_u32, 4)
}

fn encode_u64(x: u64, mut out: Bytes) -> Result[(), EncodeError] {
    put_u64(x, mut out)
    Ok(())
}

pub fn of_u64() -> Codec[u64] {
    make(encode_u64, take_u64, describe_u64, 8)
}

fn encode_i8(x: i8, mut out: Bytes) -> Result[(), EncodeError] {
    put_i8(x, mut out)
    Ok(())
}

pub fn of_i8() -> Codec[i8] {
    make(encode_i8, take_i8, describe_i8, 1)
}

fn encode_i16(x: i16, mut out: Bytes) -> Result[(), EncodeError] {
    put_i16(x, mut out)
    Ok(())
}

pub fn of_i16() -> Codec[i16] {
    make(encode_i16, take_i16, describe_i16, 2)
}

fn encode_i32(x: i32, mut out: Bytes) -> Result[(), EncodeError] {
    put_i32(x, mut out)
    Ok(())
}

pub fn of_i32() -> Codec[i32] {
    make(encode_i32, take_i32, describe_i32, 4)
}

fn encode_i64(x: i64, mut out: Bytes) -> Result[(), EncodeError] {
    put_i64(x, mut out)
    Ok(())
}

pub fn of_i64() -> Codec[i64] {
    make(encode_i64, take_i64, describe_i64, 8)
}

fn encode_f32(x: f32, mut out: Bytes) -> Result[(), EncodeError] {
    put_f32(x, mut out)
    Ok(())
}

pub fn of_f32() -> Codec[f32] {
    make(encode_f32, take_f32, describe_f32, 4)
}

fn encode_f64(x: f64, mut out: Bytes) -> Result[(), EncodeError] {
    put_f64(x, mut out)
    Ok(())
}

pub fn of_f64() -> Codec[f64] {
    make(encode_f64, take_f64, describe_f64, 8)
}

pub fn of_string() -> Codec[String] {
    make(put_string, take_string, describe_string, 4)
}

/// DecodeError's codec, as the derive writes a sum's: a store can keep a refusal.
pub fn of_decode_error() -> Codec[DecodeError] {
    make(decode_error_encode, decode_error_decode, decode_error_schema, 12)
}

fn decode_error_encode(x: DecodeError, mut out: Bytes) -> Result[(), EncodeError] {
    match x {
        Truncated(i) => {
            put_tag(0, mut out)
            put_u64(i, mut out)
        }
        Invalid(i) => {
            put_tag(1, mut out)
            put_u64(i, mut out)
        }
        Utf8(i) => {
            put_tag(2, mut out)
            put_u64(i, mut out)
        }
        Duplicate(i) => {
            put_tag(3, mut out)
            put_u64(i, mut out)
        }
        Trailing(i) => {
            put_tag(4, mut out)
            put_u64(i, mut out)
        }
        Schema(i) => {
            put_tag(5, mut out)
            put_u64(i, mut out)
        }
        Value(i) => {
            put_tag(6, mut out)
            put_u64(i, mut out)
        }
    }
    Ok(())
}

fn decode_error_decode(b: Bytes, mut at: u64) -> Result[DecodeError, DecodeError] {
    let tag = take_tag(b, mut at, 7)?
    let i = take_u64(b, mut at)?
    if tag == 0 {
        Ok(Truncated(i))
    } else if tag == 1 {
        Ok(Invalid(i))
    } else if tag == 2 {
        Ok(Utf8(i))
    } else if tag == 3 {
        Ok(Duplicate(i))
    } else if tag == 4 {
        Ok(Trailing(i))
    } else if tag == 5 {
        Ok(Schema(i))
    } else {
        Ok(Value(i))
    }
}

fn decode_error_schema(mut s: Schema, _c: Codec[DecodeError]) -> Result[(), EncodeError] {
    define(mut s, "std.codec.DecodeError", 0)?
    if sum(mut s, 7)? {
        return Ok(())
    }
    variant(mut s, "Truncated", 1)?
    schema_u64(mut s)
    variant(mut s, "Invalid", 1)?
    schema_u64(mut s)
    variant(mut s, "Utf8", 1)?
    schema_u64(mut s)
    variant(mut s, "Duplicate", 1)?
    schema_u64(mut s)
    variant(mut s, "Trailing", 1)?
    schema_u64(mut s)
    variant(mut s, "Schema", 1)?
    schema_u64(mut s)
    variant(mut s, "Value", 1)?
    schema_u64(mut s)
    close(mut s)
    Ok(())
}

// Schemas. A schema is bytes: a version byte (3), the definitions (a u32 count, then
// each), then the root type. A type is an opcode byte: 0 (), 1 bool, 2 char, 3-6 u8-u64,
// 7-10 i8-i64, 11 f32, 12 f64, 13 String, 14 List and its element, 15 Map, its key and
// value, 16 Option and its type, 17 Result, its ok and error types, 18 a tuple (a u32
// arity, then the components), 19 a definition (its u32 index). A definition is its
// nominal path, its type arguments (a u32 count, then each), a kind byte and a body:
// 0 record (a u32 entry count, then per entry 0 for a field or 1 for a removed one, its
// name and type), 1 sum (a u32 variant count, then per variant 0, or 1 for a removed one,
// its name, a u32 field count and the field types), 2 via (the type it is written as).
// A name is a u32 byte count and UTF-8. Definitions are numbered in the order a
// depth-first walk from the root first meets them, so a type has one schema; defaults
// are the reader's, never in the bytes.
/// A schema being built: what a codec's schema function writes into.
pub opaque type Schema {
    cur: Bytes,
    saved: List[Bytes],
    open: List[u64],
    keys: List[Bytes],
    defs: List[Bytes],
    defaults: List[Default]
}

type Default: shareable + send {
    def: u64,
    field: String,
    value: Bytes
}

fn opcode(mut s: Schema, x: u8) {
    put_byte(mut s.cur, x)
}

fn name(mut s: Schema, n: String) -> Result[(), EncodeError] {
    put_string(n, mut s.cur)
}

pub fn schema_unit(mut s: Schema) {
    opcode(mut s, 0)
}

pub fn schema_bool(mut s: Schema) {
    opcode(mut s, 1)
}

pub fn schema_char(mut s: Schema) {
    opcode(mut s, 2)
}

pub fn schema_u8(mut s: Schema) {
    opcode(mut s, 3)
}

pub fn schema_u16(mut s: Schema) {
    opcode(mut s, 4)
}

pub fn schema_u32(mut s: Schema) {
    opcode(mut s, 5)
}

pub fn schema_u64(mut s: Schema) {
    opcode(mut s, 6)
}

pub fn schema_i8(mut s: Schema) {
    opcode(mut s, 7)
}

pub fn schema_i16(mut s: Schema) {
    opcode(mut s, 8)
}

pub fn schema_i32(mut s: Schema) {
    opcode(mut s, 9)
}

pub fn schema_i64(mut s: Schema) {
    opcode(mut s, 10)
}

pub fn schema_f32(mut s: Schema) {
    opcode(mut s, 11)
}

pub fn schema_f64(mut s: Schema) {
    opcode(mut s, 12)
}

pub fn schema_string(mut s: Schema) {
    opcode(mut s, 13)
}

/// The type c writes, in place: a field's, an element's, a type argument's.
pub fn schema_of[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    (c.describer)(mut s, c)
}

pub fn schema_list[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    opcode(mut s, 14)
    (c.describer)(mut s, c)
}

pub fn schema_map[K: key, V](mut s: Schema, ck: Codec[K], cv: Codec[V]) -> Result[(), EncodeError] {
    opcode(mut s, 15)
    (ck.describer)(mut s, ck)?
    (cv.describer)(mut s, cv)
}

pub fn schema_option[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    opcode(mut s, 16)
    (c.describer)(mut s, c)
}

pub fn schema_result[T, E](mut s: Schema, ct: Codec[T], ce: Codec[E]) -> Result[(), EncodeError] {
    opcode(mut s, 17)
    (ct.describer)(mut s, ct)?
    (ce.describer)(mut s, ce)
}

/// A tuple of n components; schema_of each follows.
pub fn schema_tuple(mut s: Schema, n: u64) -> Result[(), EncodeError] {
    opcode(mut s, 18)
    put_count(n, mut s.cur)
}

/// Starts the definition of a nominal type at its path; then its type arguments
/// (`argument`), then `record`, `sum` or `via`, its entries and `close`.
pub fn define(mut s: Schema, path: String, arguments: u64) -> Result[(), EncodeError] {
    let parent = replace(mut s.cur, list.new())
    push_own(mut s.saved, take parent)
    name(mut s, path)?
    put_count(arguments, mut s.cur)
}

/// One type argument of the definition begun by `define`.
pub fn argument[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    (c.describer)(mut s, c)
}

/// A record of n entries (fields and removed fields). Ok(true) when the definition is
/// already written: its reference is, and the schema function returns at once.
pub fn record(mut s: Schema, n: u64) -> Result[bool, EncodeError] {
    body(mut s, 0, n)
}

/// A sum of n variants, live and removed, in declared order; as `record`.
pub fn sum(mut s: Schema, n: u64) -> Result[bool, EncodeError] {
    body(mut s, 1, n)
}

/// A `codec via R` type; schema_of R's codec follows, then `close`.
pub fn via(mut s: Schema) -> Result[bool, EncodeError] {
    body(mut s, 2, 1)
}

// The definition's identity is its path and arguments, the bytes `define` began. A known
// one is a reference in the enclosing type; a new one takes the next index, its
// reference goes to the enclosing type and its body follows.
fn body(mut s: Schema, kind: u8, n: u64) -> Result[bool, EncodeError] {
    let count = list.len(s.keys)
    let mut index: u64 = 0
    while index < count && s.keys[index] != s.cur {
        index += 1
    }
    if index < count {
        restore(mut s)
        reference(mut s.cur, index)?
        return Ok(true)
    }
    let mut key: Bytes = list.with_capacity(list.len(s.cur))
    let _ = list.append(mut key, s.cur)
    push_own(mut s.keys, take key)
    push_own(mut s.defs, list.new())
    push_plain(mut s.open, index)
    let mut parent = replace(mut s.cur, list.new())
    let referenced = match list.pop(mut s.saved) {
        Some(p) => {
            let mut q = take p
            let wrote = reference(mut q, index)
            let _ = list.push(mut s.saved, take q)
            wrote
        }
        None => Ok(())
    }
    let _ = replace(mut s.cur, take parent)
    referenced?
    opcode(mut s, kind)
    if kind != 2 {
        put_count(n, mut s.cur)?
    }
    Ok(false)
}

fn reference(mut b: Bytes, index: u64) -> Result[(), EncodeError] {
    put_byte(mut b, 19)
    put_count(index, mut b)
}

// The enclosing type's bytes become current again.
fn restore(mut s: Schema) {
    let parent = match list.pop(mut s.saved) {
        Some(p) => take p,
        None => list.new()
    }
    let _ = replace(mut s.cur, take parent)
}

/// Ends the definition begun by the latest `define` that `record`, `sum` or `via` left open.
pub fn close(mut s: Schema) {
    let index = match list.pop(mut s.open) {
        Some(i) => i,
        None => return
    }
    let parent = match list.pop(mut s.saved) {
        Some(p) => take p,
        None => list.new()
    }
    let done = replace(mut s.cur, take parent)
    let _ = list.set(mut s.defs, index, take done)
}

/// A field of the record being defined, in declaration order; its type follows (a
/// `schema_` call).
pub fn field(mut s: Schema, path: String) -> Result[(), EncodeError] {
    opcode(mut s, 0)
    name(mut s, path)
}

/// A field of type F with a default: the reader's value when the writer's schema lacks
/// the field. Writes the type too.
pub fn field_default[F](mut s: Schema, path: String, c: Codec[F], v: F) -> Result[(), EncodeError] {
    field(mut s, path)?
    (c.describer)(mut s, c)?
    let def = s.open[list.len(s.open) - 1]
    let mut value: Bytes = list.new()
    (c.encoder)(v, mut value)?
    let copied = string.from(path)
    list.push(mut s.defaults, Default(def, field: take copied, value: take value))
    Ok(())
}

/// A removed field of the record being defined, where the field was; its type follows
/// (a `schema_` call), resolved against a writer's field of that name (SEM-10).
pub fn removed_field(mut s: Schema, path: String) -> Result[(), EncodeError] {
    opcode(mut s, 1)
    name(mut s, path)
}

/// A removed variant of the sum being defined, with n fields; schema_of each follows.
pub fn removed_variant(mut s: Schema, path: String, n: u64) -> Result[(), EncodeError] {
    opcode(mut s, 1)
    name(mut s, path)?
    put_count(n, mut s.cur)
}

/// A live variant of the sum being defined, with n fields; schema_of each follows.
pub fn variant(mut s: Schema, path: String, n: u64) -> Result[(), EncodeError] {
    opcode(mut s, 0)
    name(mut s, path)?
    put_count(n, mut s.cur)
}

fn push_own[T](mut xs: List[T], take x: T) {
    list.push(mut xs, take x)
}

fn push_plain(mut xs: List[u64], x: u64) {
    list.push(mut xs, x)
}

fn builder() -> Schema {
    Schema(cur: list.new(), saved: list.new(), open: list.new(), keys: list.new(), defs: list.new(), defaults: list.new())
}

fn built[T](c: Codec[T]) -> Result[Schema, EncodeError] {
    let mut s = builder()
    (c.describer)(mut s, c)?
    Ok(take s)
}

fn finish(s: Schema) -> Result[Bytes, EncodeError] {
    let mut size: u64 = 5 + list.len(s.cur)
    for d in s.defs {
        size += list.len(d)
    }
    let mut out: Bytes = list.with_capacity(size)
    put_byte(mut out, 3)
    put_count(list.len(s.defs), mut out)?
    for d in s.defs {
        list.append(mut out, d)
    }
    list.append(mut out, s.cur)
    Ok(take out)
}

/// The schema c writes: what a store keeps beside the bytes. Ex: `codec.schema(rows)?`
pub fn schema[T](c: Codec[T]) -> Result[Bytes, EncodeError] {
    let s = built(c)?
    finish(s)
}

/// Builds a codec description with its reader defaults. The schema views below
/// borrow the description, which remains valid across value transcodes.
pub fn describe[T](c: Codec[T]) -> Result[Schema, EncodeError] {
    built(c)
}

/// The root type expression of a completed description.
pub fn schema_root(s: Schema) -> View[Bytes] in s {
    view s.cur
}

/// The number of nominal definitions in a completed description.
pub fn schema_definitions(s: Schema) -> u64 {
    list.len(s.defs)
}

/// Definition bytes starting with the kind byte, after the nominal path and arguments.
pub fn schema_definition(s: Schema, index: u64) -> View[Bytes] in s {
    let d = s.defs[index]
    list.slice(d, kind_at(d, 0), list.len(d))
}

/// Reads a u32 count, byte length or definition index from a description.
pub fn schema_word(b: Bytes, offset: u64) -> u64 {
    count_at(b, offset)
}

/// The end offset of the type expression at at in a completed description.
pub fn schema_next(b: Bytes, at: u64) -> u64 {
    skip(b, at)
}

/// A declared field's pre-encoded default, when the description has one.
pub fn schema_default(s: Schema, def: u64, field_name: String) -> Option[View[Bytes]] in s {
    for d in s.defaults {
        if d.def == def && d.field == field_name {
            return Some(view d.value)
        }
    }
    None
}

/// The stable fingerprint of c's schema: CRC-64-AVRO (Rabin) of its bytes, so equal
/// schemas, tombstones and variant order included, have equal fingerprints.
pub fn fingerprint[T](c: Codec[T]) -> Result[u64, EncodeError] {
    let b = schema(c)?
    Ok(fingerprint_of(b))
}

// Apache Avro 1.12.0, SchemaNormalization.FP64. Start each entry with its
// byte index and apply eight reflected rounds with polynomial 0xc15d213aa4d7a795.
const FINGERPRINT_TABLE: Inline[u64, 256] =[0x0000000000000000, 0x2cf1cba6b75351fa, 0x59e3974d6ea6a3f4, 0x75125cebd9f5f20e, 0xb3c72e9add4d47e8, 0x9f36e53c6a1e1612, 0xea24b9d7b3ebe41c, 0xc6d5727104b8b5e6, 0xe5341f40f335c0fb, 0xc9c5d4e644669101, 0xbcd7880d9d93630f, 0x902643ab2ac032f5, 0x56f331da2e788713, 0x7a02fa7c992bd6e9, 0x0f10a69740de24e7, 0x23e16d31f78d751d, 0x48d27cf4afc4cedd, 0x6423b75218979f27, 0x1131ebb9c1626d29, 0x3dc0201f76313cd3, 0xfb15526e72898935, 0xd7e499c8c5dad8cf, 0xa2f6c5231c2f2ac1, 0x8e070e85ab7c7b3b, 0xade663b45cf10e26, 0x8117a812eba25fdc, 0xf405f4f93257add2, 0xd8f43f5f8504fc28, 0x1e214d2e81bc49ce, 0x32d0868836ef1834, 0x47c2da63ef1aea3a, 0x6b3311c55849bbc0, 0x91a4f9e95f899dba, 0xbd55324fe8dacc40, 0xc8476ea4312f3e4e, 0xe4b6a502867c6fb4, 0x2263d77382c4da52, 0x0e921cd535978ba8, 0x7b80403eec6279a6, 0x57718b985b31285c, 0x7490e6a9acbc5d41, 0x58612d0f1bef0cbb, 0x2d7371e4c21afeb5, 0x0182ba427549af4f, 0xc757c83371f11aa9, 0xeba60395c6a24b53, 0x9eb45f7e1f57b95d, 0xb24594d8a804e8a7, 0xd976851df04d5367, 0xf5874ebb471e029d, 0x809512509eebf093, 0xac64d9f629b8a169, 0x6ab1ab872d00148f, 0x464060219a534575, 0x33523cca43a6b77b, 0x1fa3f76cf4f5e681, 0x3c429a5d0378939c, 0x10b351fbb42bc266, 0x65a10d106dde3068, 0x4950c6b6da8d6192, 0x8f85b4c7de35d474, 0xa3747f616966858e, 0xd666238ab0937780, 0xfa97e82c07c0267a, 0xa1f3b1a7f6bc745f, 0x8d027a0141ef25a5, 0xf81026ea981ad7ab, 0xd4e1ed4c2f498651, 0x12349f3d2bf133b7, 0x3ec5549b9ca2624d, 0x4bd7087045579043, 0x6726c3d6f204c1b9, 0x44c7aee70589b4a4, 0x68366541b2dae55e, 0x1d2439aa6b2f1750, 0x31d5f20cdc7c46aa, 0xf700807dd8c4f34c, 0xdbf14bdb6f97a2b6, 0xaee31730b66250b8, 0x8212dc9601310142, 0xe921cd535978ba82, 0xc5d006f5ee2beb78, 0xb0c25a1e37de1976, 0x9c3391b8808d488c, 0x5ae6e3c98435fd6a, 0x7617286f3366ac90, 0x03057484ea935e9e, 0x2ff4bf225dc00f64, 0x0c15d213aa4d7a79, 0x20e419b51d1e2b83, 0x55f6455ec4ebd98d, 0x79078ef873b88877, 0xbfd2fc8977003d91, 0x9323372fc0536c6b, 0xe6316bc419a69e65, 0xcac0a062aef5cf9f, 0x3057484ea935e9e5, 0x1ca683e81e66b81f, 0x69b4df03c7934a11, 0x454514a570c01beb, 0x839066d47478ae0d, 0xaf61ad72c32bfff7, 0xda73f1991ade0df9, 0xf6823a3fad8d5c03, 0xd563570e5a00291e, 0xf9929ca8ed5378e4, 0x8c80c04334a68aea, 0xa0710be583f5db10, 0x66a47994874d6ef6, 0x4a55b232301e3f0c, 0x3f47eed9e9ebcd02, 0x13b6257f5eb89cf8, 0x788534ba06f12738, 0x5474ff1cb1a276c2, 0x2166a3f7685784cc, 0x0d976851df04d536, 0xcb421a20dbbc60d0, 0xe7b3d1866cef312a, 0x92a18d6db51ac324, 0xbe5046cb024992de, 0x9db12bfaf5c4e7c3, 0xb140e05c4297b639, 0xc452bcb79b624437, 0xe8a377112c3115cd, 0x2e7605602889a02b, 0x0287cec69fdaf1d1, 0x7795922d462f03df, 0x5b64598bf17c5225, 0xc15d213aa4d7a795, 0xedacea9c1384f66f, 0x98beb677ca710461, 0xb44f7dd17d22559b, 0x729a0fa0799ae07d, 0x5e6bc406cec9b187, 0x2b7998ed173c4389, 0x0788534ba06f1273, 0x24693e7a57e2676e, 0x0898f5dce0b13694, 0x7d8aa9373944c49a, 0x517b62918e179560, 0x97ae10e08aaf2086, 0xbb5fdb463dfc717c, 0xce4d87ade4098372, 0xe2bc4c0b535ad288, 0x898f5dce0b136948, 0xa57e9668bc4038b2, 0xd06cca8365b5cabc, 0xfc9d0125d2e69b46, 0x3a487354d65e2ea0, 0x16b9b8f2610d7f5a, 0x63abe419b8f88d54, 0x4f5a2fbf0fabdcae, 0x6cbb428ef826a9b3, 0x404a89284f75f849, 0x3558d5c396800a47, 0x19a91e6521d35bbd, 0xdf7c6c14256bee5b, 0xf38da7b29238bfa1, 0x869ffb594bcd4daf, 0xaa6e30fffc9e1c55, 0x50f9d8d3fb5e3a2f, 0x7c0813754c0d6bd5, 0x091a4f9e95f899db, 0x25eb843822abc821, 0xe33ef64926137dc7, 0xcfcf3def91402c3d, 0xbadd610448b5de33, 0x962caaa2ffe68fc9, 0xb5cdc793086bfad4, 0x993c0c35bf38ab2e, 0xec2e50de66cd5920, 0xc0df9b78d19e08da, 0x060ae909d526bd3c, 0x2afb22af6275ecc6, 0x5fe97e44bb801ec8, 0x7318b5e20cd34f32, 0x182ba427549af4f2, 0x34da6f81e3c9a508, 0x41c8336a3a3c5706, 0x6d39f8cc8d6f06fc, 0xabec8abd89d7b31a, 0x871d411b3e84e2e0, 0xf20f1df0e77110ee, 0xdefed65650224114, 0xfd1fbb67a7af3409, 0xd1ee70c110fc65f3, 0xa4fc2c2ac90997fd, 0x880de78c7e5ac607, 0x4ed895fd7ae273e1, 0x62295e5bcdb1221b, 0x173b02b01444d015, 0x3bcac916a31781ef, 0x60ae909d526bd3ca, 0x4c5f5b3be5388230, 0x394d07d03ccd703e, 0x15bccc768b9e21c4, 0xd369be078f269422, 0xff9875a13875c5
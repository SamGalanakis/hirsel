#!/usr/bin/env python3
"""Measure one already-built release compiler against this checkout's stdlib.

    tools/fresh-std-sample --toolchain DIR \
        --commit BUILT_SHA --cpu 8 --output NEW_DIRECTORY

Build every compared compiler with the same release profile and toolchain.
Use this checkout's stdlib and the same CPU for every compared compiler.
This runs only fresh std, once, with absent products, none@1, caches off, jobs1 and 2 GiB.
Samples using this command share a per-user lock; the wall timer starts after admission.
"""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time


ROOT = Path(__file__).resolve().parents[1]
FORBIDDEN = set(range(12, 16)) | set(range(28, 32))
CHILD = '''import json, resource, subprocess, sys
p = subprocess.run(sys.argv[2:])
with open(sys.argv[1], 'w') as f:
    json.dump({'exit': p.returncode, 'rss_kib': resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss}, f)
raise SystemExit(p.returncode if p.returncode >= 0 else 128 - p.returncode)
'''

def perf_instructions(text):
    counts = {}
    for line in text.splitlines():
        fields = line.split(';')
        if len(fields) > 2 and fields[2] in ('instructions:u', 'instructions'):
            if fields[2] in counts or len(fields) < 5 or float(fields[4]) != 100:
                raise ValueError('fresh std requires one unscaled whole-process count per counter')
            count = int(fields[0])
            if count <= 0:
                raise ValueError('fresh std counted no instructions')
            counts[fields[2]] = count
    if counts.keys() != {'instructions:u', 'instructions'}:
        raise ValueError('fresh std requires user and inclusive instruction counters')
    return counts

def environment(toolchain, scratch, fresh):
    env = {key: os.environ[key] for key in
           ('PATH', 'HOME', 'XDG_RUNTIME_DIR', 'DBUS_SESSION_BUS_ADDRESS') if key in os.environ}
    llvm = ROOT / 'tools/buck2/toolchains/llvm-files'
    env.update(LC_ALL='C', HIRSEL_DAEMON='off', HIRSEL_PROGRAM_CACHE='off',
               HIRSEL_RESULTS='none@1', HIRSEL_JOBS='1', HIRSEL_MEMORY_LIMIT='2G',
               LLVM_SYS_231_PREFIX=str(llvm), LD_LIBRARY_PATH=str(llvm / 'lib'),
               LLVM_PROFILE_FILE=os.devnull,
               HIRSEL_PRODUCTS=str(scratch / 'absent-products' if fresh else toolchain / 'hirsel-std.products'))
    return env

def measure(toolchain, path, cpu, scratch, fresh):
    counters, status, stderr = (scratch / name for name in ('perf', 'status', 'stderr'))
    command = [str(ROOT / 'tools/capped'), 'taskset', '-c', str(cpu),
               'perf', 'stat', '-x', ';', '-o', str(counters),
               '-e', 'instructions:u,instructions', '--', sys.executable, '-c', CHILD, str(status),
               str(toolchain / 'hirsel'), 'check', '--timings=json', str(path)]
    try:
        with stderr.open('w') as err:
            done = subprocess.run(command, cwd=ROOT, env=environment(toolchain, scratch, fresh),
                                  stdout=subprocess.DEVNULL, stderr=err)
    except OSError as error:
        return None, str(error)
    text = stderr.read_text()
    reports, diagnostics = [], []
    for line in text.splitlines():
        try:
            report = json.loads(line)
        except ValueError:
            report = None
        if isinstance(report, dict) and report.get('schema') == 1 and 'phases' in report:
            reports.append(report)
        else:
            diagnostics.append(line)
    child = json.loads(status.read_text()) if status.exists() else {}
    if done.returncode or child.get('exit') != 0:
        return None, f'exit {done.returncode}, compiler {child.get("exit", "unobserved")}; ' + '\n'.join(diagnostics)[-2000:]
    try:
        counts = perf_instructions(counters.read_text())
        if not reports or not isinstance(reports[-1].get('counts'), dict) or not reports[-1]['counts']:
            raise ValueError('compiler work counters missing')
        if child.get('rss_kib', 0) <= 0:
            raise ValueError('compiler peak RSS missing')
        return dict({'instructions:u': counts['instructions:u'], 'peak_rss_kib': child['rss_kib']},
                    **{'work/' + key: value for key, value in reports[-1]['counts'].items()}), ''
    except (OSError, ValueError) as error:
        return None, str(error)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--toolchain', type=Path, required=True)
    parser.add_argument('--commit', required=True, help='commit built into the supplied release bundle')
    parser.add_argument('--cpu', type=int, required=True)
    parser.add_argument('--output', type=Path, required=True, help='new evidence directory')
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    if args.cpu not in os.sched_getaffinity(0) or args.cpu in FORBIDDEN:
        parser.error('CPU must be available and outside 12-15 and 28-31')
    toolchain = args.toolchain.resolve()
    source = root / 'stdlib/std@1/hirsel.json'
    if not (toolchain / 'hirsel').is_file() or not source.is_file():
        parser.error('release hirsel binary and checkout std manifest must exist')
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=False)
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    lock_directory = runtime if runtime.is_dir() else Path('/tmp')
    with (lock_directory / f'hirsel-fresh-std-{os.getuid()}.lock').open('a') as lock:
        print('Waiting for the shared fresh-std measurement lock.', flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
        source_revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()
        started = time.monotonic()
        values, error = measure(toolchain, source, args.cpu, output, True)
        elapsed = time.monotonic() - started
    reports = []
    for line in (output / 'stderr').read_text().splitlines():
        try:
            report = json.loads(line)
        except ValueError:
            continue
        if isinstance(report, dict) and report.get('schema') == 1 and 'phases' in report:
            reports.append(report)
    report = reports[-1] if reports else {}
    result = dict(sha=args.commit, source_revision=source_revision, cpu=args.cpu, source=str(source), values=values,
                  phase_calls={phase['phase']: phase['calls'] for phase in report.get('phases', [])},
                  process_cpu_ns=report.get('process_cpu_ns'),
                  compiler_wall_ns=report.get('wall_ns'),
                  error=error, wall_seconds=elapsed)
    text = json.dumps(result, indent=2) + '\n'
    (output / 'result.json').write_text(text)
    print(text, end='')
    return 0 if values is not None else 1


if __name__ == '__main__':
    raise SystemExit(main())

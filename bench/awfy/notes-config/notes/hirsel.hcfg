pkg_v1.Package(
    name: "local/notes",
    version: "1.0.0",
    charge: ChargeV1,
    sources: [
        ("main.hirsel", "main"),
    ],
    dependencies: [
        ("std", Toolchain(package: "std", major: 1, authority: [])),
        ("store", Toolchain(package: "store", major: 1, authority: [])),
        ("runner", Toolchain(package: "runner", major: 1, authority: [])),
        ("harness", Path(
            package: "local/harness",
            major: 1,
            path: "../harness",
            authority: [Dir, Net, Clock, Random, Tasks, Secret],
        )),
    ],
    program: Some(Program(module: Some("main"))),
)

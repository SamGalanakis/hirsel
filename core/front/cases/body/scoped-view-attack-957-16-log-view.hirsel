fn run(l: Log[u64]) -> Result[Result[u64, Causes], Capacity] {
    isolate(fn() -> u64 {
        log.append(l, 7u64)
        1u64
    })
}

pub fn case() -> Result[u64, Capacity] {
    let l: Log[u64] = log.new()
    let o = run(l)?
    let n = list.len(log.finish(take l))
    match o {
        Ok(v) => Ok(v + n),
        Error(_) => Ok(0u64)
    }
}

pub fn oracle() -> u64 {
    match case() {
        Ok(n) => n,
        _ => 99
    }
}
// expect: run oracle() = 2

// LAYOUT family 2: exclusive updates, generation-checked churn, Rc snapshots and Arc
// snapshots are distinct entry points. Single task, no hash table or hidden thread.
type Node { value: u64, edge: u32 }
type RNode: shareable { value: u64, tail: Option[Rc[RNode]] }
type ANode: shareable + send { value: u64, tail: Option[Arc[ANode]] }

fn exclusive(n: u64, rounds: u64) -> Result[u64, Capacity] {
    let mut nodes: List[Node] = list.with_capacity(n)?
    for i in 0 .. n { let _ = list.push(mut nodes, Node(value: i, edge: int.narrow((i + 1) % n))) }
    for _ in 0 .. rounds {
        for i in 0 .. n { nodes[i].value += 1 }
    }
    let mut sum: u64 = 0
    let mut at: u64 = 0
    for _ in 0 .. n { sum += nodes[at].value; at = int.widen(nodes[at].edge) }
    Ok(sum)
}
fn inserted(take r: Result[std.pool.Id[Node], (Capacity, Node)]) -> Result[std.pool.Id[Node], Capacity] {
    match take r { Ok(h) => Ok(h), Error((c, take value)) => Error(c) }
}
fn churn(n: u64, rounds: u64) -> Result[u64, Capacity] {
    let mut p: std.pool.Pool[Node] = std.pool.with_capacity(n)?
    let mut ids: List[std.pool.Id[Node]] = list.with_capacity(n)?
    for i in 0 .. n {
        let h = inserted(std.pool.insert(mut p, Node(value: i, edge: int.narrow((i + 1) % n))))?
        let _ = list.push(mut ids, h)
    }
    let mut stale: u64 = 0
    for _ in 0 .. rounds {
        for i in 0 .. n {
            let old = ids[i]
            let mut node = result.unwrap(std.pool.remove(mut p, old))
            node.value += 1
            let fresh = inserted(std.pool.insert(mut p, take node))?
            if !std.pool.contains(p, old) { stale += 1 }
            let _ = list.set(mut ids, i, fresh)
        }
    }
    let mut sum = stale
    for h in ids { sum += result.unwrap(std.pool.get(p, h)).value }
    Ok(sum)
}
fn copy_rc(node: Rc[RNode], depth: u64) -> Result[Rc[RNode], Capacity] {
    let tail = if depth == 0 {
        match node.tail { Some(t) => Some(rc.share(t)), None => None }
    } else {
        match node.tail { Some(t) => Some(copy_rc(t, depth - 1)?), None => None }
    }
    result.capacity_only(rc.new(RNode(value: node.value + 1, tail: take tail)))
}
fn copy_arc(node: Arc[ANode], depth: u64) -> Result[Arc[ANode], Capacity] {
    let tail = if depth == 0 {
        match node.tail { Some(t) => Some(arc.share(t)), None => None }
    } else {
        match node.tail { Some(t) => Some(copy_arc(t, depth - 1)?), None => None }
    }
    result.capacity_only(arc.new(ANode(value: node.value + 1, tail: take tail)))
}
fn sum_rc(node: Rc[RNode]) -> u64 {
    node.value + match node.tail { Some(t) => sum_rc(t), None => 0 }
}
fn sum_arc(node: Arc[ANode]) -> u64 {
    node.value + match node.tail { Some(t) => sum_arc(t), None => 0 }
}
fn snapshots_rc(n: u64, versions: u64) -> Result[u64, Capacity] {
    let mut root: Option[Rc[RNode]] = None
    for i in 0 .. n {
        let old = replace(mut root, None)
        root = Some(result.capacity_only(rc.new(RNode(value: i, tail: take old)))?)
    }
    let mut held: List[Rc[RNode]] = list.with_capacity(versions)?
    for _ in 0 .. versions {
        let next = match root { Some(t) => copy_rc(t, n / 2)?, None => fail("empty graph") }
        let _ = list.push(mut held, rc.share(next))
        root = Some(take next)
    }
    let mut sum: u64 = 0
    for head in held { sum += sum_rc(head) }
    Ok(sum)
}
fn snapshots_arc(n: u64, versions: u64) -> Result[u64, Capacity] {
    let mut root: Option[Arc[ANode]] = None
    for i in 0 .. n {
        let old = replace(mut root, None)
        root = Some(result.capacity_only(arc.new(ANode(value: i, tail: take old)))?)
    }
    let mut held: List[Arc[ANode]] = list.with_capacity(versions)?
    for _ in 0 .. versions {
        let next = match root { Some(t) => copy_arc(t, n / 2)?, None => fail("empty graph") }
        let _ = list.push(mut held, arc.share(next))
        root = Some(take next)
    }
    let mut sum: u64 = 0
    for head in held { sum += sum_arc(head) }
    Ok(sum)
}
fn show(out: Stdout, value: Result[u64, Capacity]) -> Result[(), Exit] waits {
    let n = match value { Ok(n) => n, Error(_) => return Error(Exit(status: 2)) }
    let mut s = string.new()
    if let Error(_) = string.push_u64(mut s, n) { return Error(Exit(status: 2)) }
    if let Error(_) = string.push(mut s, "\n") { return Error(Exit(status: 2)) }
    match stdout.write(out, s) { Ok(()) => Ok(()), Error(_) => Error(Exit(status: 3)) }
}
pub fn exclusive_main(out: Stdout) -> Result[(), Exit] waits { show(out, exclusive(8192, 32)) }
pub fn churn_main(out: Stdout) -> Result[(), Exit] waits { show(out, churn(4096, 16)) }
pub fn rc_main(out: Stdout) -> Result[(), Exit] waits { show(out, snapshots_rc(64, 256)) }
pub fn arc_main(out: Stdout) -> Result[(), Exit] waits { show(out, snapshots_arc(64, 256)) }
// Hand-derived: exclusive 0+1+2+3 +4*2 =14; churn final sum14 +8 stale probes=22;
// Three-node snapshots sum5,7,9: two copied nodes increase per version, total21.
pub fn small_law() -> bool {
    result.unwrap(exclusive(4, 2)) == 14 && result.unwrap(churn(4, 2)) == 22 &&
    result.unwrap(snapshots_rc(3, 3)) == 21 && result.unwrap(snapshots_arc(3, 3)) == 21
}
// Logical charge-v1 laws, independent of native layout and Option niche decisions.
// Node is8+4=12; Slot[Node] is8+max(8+12,16)=28; Id is24.
// A snapshot node charges 8 + Option[Rc](16) + count(8) = 32 bytes.
// Releasing the initial 33-node prefix leaves 31 shared nodes and 256*33 copied
// nodes. Add the 256 eight-byte holders: (31+256*33)*32 +256*8 = 273376.
// Exact budgets admit; one byte less must refuse. The bound includes the full lifetime.
const SNAPSHOT_BUDGET: u64 = (31 + 256 * 33) * 32 + 256 * 8

pub fn charges_main(out: Stdout) -> Result[(), Exit] waits {
    let churn_ok = match (bound bytes 212992 { churn(4096, 16) }) { Ok(Ok(8517632)) => true, _ => false }
    let churn_short = match (bound bytes 212991 { churn(4096, 16) }) { Ok(Error(c)) => c.requested == 98304 && c.available == 98303, _ => false }
    let rc_ok = match (bound bytes SNAPSHOT_BUDGET { snapshots_rc(64, 256) }) { Ok(Ok(1601664)) => true, _ => false }
    let rc_short = match (bound bytes (SNAPSHOT_BUDGET - 1) { snapshots_rc(64, 256) }) { Ok(Error(c)) => c.requested == 32 && c.available == 31, _ => false }
    let arc_ok = match (bound bytes SNAPSHOT_BUDGET { snapshots_arc(64, 256) }) { Ok(Ok(1601664)) => true, _ => false }
    let arc_short = match (bound bytes (SNAPSHOT_BUDGET - 1) { snapshots_arc(64, 256) }) { Ok(Error(c)) => c.requested == 32 && c.available == 31, _ => false }
    let mask: u64 = (if churn_ok { 1u64 } else { 0 }) + (if churn_short { 2u64 } else { 0 }) +
        (if rc_ok { 4u64 } else { 0 }) + (if rc_short { 8u64 } else { 0 }) +
        (if arc_ok { 16u64 } else { 0 }) + (if arc_short { 32u64 } else { 0 })
    show(out, Ok(mask))
}
fn lifetime() -> Result[u64, Capacity] {
    let a = exclusive(8192, 32)?
    let b = churn(4096, 16)?
    let c = snapshots_rc(64, 256)?
    let d = snapshots_arc(64, 256)?
    Ok(a + b + c + d)
}
pub fn lifetime_main(out: Stdout) -> Result[(), Exit] waits { show(out, lifetime()) }

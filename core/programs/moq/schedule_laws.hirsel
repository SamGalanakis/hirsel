// MS3 Scheduling & Delivery Timeout laws: M6 (priority_order) and
// M7 (delivery_timeouts_start_and_stop_apart).
const MS_NS: u64 = 1000000

fn make_tagged_payload(tag: u8, size: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(size)
    list.push(mut b, tag)
    for _ in 1u64 .. size {
        list.push(mut b, 0xaa)
    }
    take b
}

fn make_props_timeout(obj_ms: u64, sg_ms: u64) -> Bytes {
    let mut kvs: List[codec.KeyValue] = list.new()
    if obj_ms > 0 {
        list.push(mut kvs, Number(kind: moq.PROP_OBJECT_DELIVERY_TIMEOUT, value: obj_ms))
    }
    if sg_ms > 0 {
        list.push(mut kvs, Number(kind: moq.PROP_SUBGROUP_DELIVERY_TIMEOUT, value: sg_ms))
    }
    let mut b: Bytes = list.new()
    if list.len(kvs) > 0 {
        result.unwrap(codec.write_key_values(kvs, mut b))
    }
    take b
}

fn accept_all_subscribes(mut server: Peer) {
    let mut ids: List[moq.RequestId] = list.new()
    for ev in server.events {
        if let Subscribe(id: id, ..) = ev {
            list.push(mut ids, id)
        }
    }
    list.clear(mut server.events)
    if let Some(mut ss) = server.sess {
        for id in ids {
            moq.accept(mut ss, mut server.io, id, Ok(()))
        }
    }
}

/// Drain one single QUIC packet at a time from server to client (and ACKs back), recording
/// each object's first payload tag byte in the order the client receives it.
fn drain_one_by_one(mut server: Peer, mut client: Peer, mut now: u64) -> Bytes {
    let mut wire: Bytes = list.with_capacity(64 * 1200)
    let mut packets: List[quic.Output] = list.with_capacity(65)
    let mut order_tags: Bytes = list.new()
    for _ in 0u64 .. 500 {
        list.clear(mut wire)
        list.clear(mut packets)
        let _ = quic.poll(mut server.io.q, now, mut wire, mut packets)
        let mut sent = 0u64
        for output in packets {
            if let Transmit(at: at, len: len, ..) = output {
                sent += 1
                // Commit and deliver one packet at a time to observe QUIC scheduling order.
                quic.committed(mut server.io.q, now, 1)
                let mut qev: List[quic.Event] = list.new()
                quic.receive_datagram(mut client.io.q, now, MOQ_SERVER_ADDR, 0, mut wire, at, len, mut qev)
                if let Some(mut cs) = client.sess {
                    let mut tevs: List[moq.TransportEvent] = list.new()
                    for ev in qev {
                        list.push(mut tevs, Quic(clone(ev)))
                    }
                    let before = list.len(client.events)
                    moq.receive(mut cs, mut client.io, now, tevs, mut client.events)
                    for k in before .. list.len(client.events) {
                        if let Received(o) = client.events[k] {
                            if list.len(o.payload) > 0 {
                                list.push(mut order_tags, o.payload[0])
                            }
                        }
                    }
                }
                break
            }
        }
        // Let client send ACKs back so server's cwnd advances smoothly.
        let _ = deliver_peer(mut client, mut server, MOQ_CLIENT_ADDR, now, mut wire, mut packets)
        if sent == 0 {
            // One more check in case server was pacing or waiting on ACK.
            now += 10 * MS_NS
            list.clear(mut wire)
            list.clear(mut packets)
            let _ = quic.poll(mut server.io.q, now, mut wire, mut packets)
            let mut more = false
            for output in packets {
                if let Transmit(..) = output {
                    more = true
                }
            }
            if !more {
                break
            }
        } else {
            now += MS_NS
        }
    }
    take order_tags
}

/// bug: MoQ priority mapping mis-orders subscriber priority, publisher priority, group order
/// (including large groups near 2^32 and 2^47), subgroup ids past 2^16, or datagram vs stream,
/// or wraps group rank past 2^48 instead of ending with PUBLISH_DONE.
/// oracle: moqt-23 §5.1.2 and MOQ-5 worked by hand.
@test
fn priority_order() -> Result[(), ()] {
    let lim = moq_limits()
    let mut client = native_client(801)
    let mut server = native_server(802, lim)
    establish_native(mut client, mut server, lim, b"prio.test", b"/m", None)
    // Two tracks:
    //   tr_hi: subscriber priority 10, Descending group order (higher group id goes FIRST)
    //   tr_lo: subscriber priority 20, Ascending group order (lower group id goes FIRST)
    let tr_hi = track(ns1(b"prio"), b"hi")
    let tr_lo = track(ns1(b"prio"), b"lo")
    if let Some(mut cs) = client.sess {
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut client.io, 10, clone(tr_hi), NoFilter, 10, Descending, 0, 0, None))
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut client.io, 10, clone(tr_lo), NoFilter, 20, Ascending, 0, 0, None))
    }
    settle_pair(mut client, mut server, 11)
    accept_all_subscribes(mut server)
    settle_pair(mut client, mut server, 12)
    list.clear(mut client.events)
    // Scripted queue pushed in REVERSE priority order before any packet leaves server:
    // Each payload is ~900 bytes so each object takes its own QUIC packet (MTU 1200).
    // Expected §5.1.2 sending order:
    //   1. tag 1: tr_hi (sub 10), pub 5,  group 2^47 + 5 (desc -> highest), Datagram obj 2 (dg < stream)
    //   2. tag 2: tr_hi (sub 10), pub 5,  group 2^47 + 5 (desc),             Subgroup 70000
    //   3. tag 3: tr_hi (sub 10), pub 5,  group 2^47 + 5 (desc),             Subgroup 70001
    //   4. tag 4: tr_hi (sub 10), pub 5,  group 2^32 + 9 (desc -> lower),    Subgroup 1
    //   5. tag 5: tr_hi (sub 10), pub 50, group 2^47 + 9 (lower pub prio),   Subgroup 0
    //   6. tag 6: tr_lo (sub 20), pub 1,  group 2^32 + 1 (asc -> lower grp), Subgroup 0
    //   7. tag 7: tr_lo (sub 20), pub 1,  group 2^47 + 1 (asc -> higher grp),Subgroup 0
    let g32: u64 = 1u64 << 32
    let g47: u64 = 1u64 << 47
    if let Some(mut ss) = server.sess {
        result.unwrap(moq.publish_at(mut ss, mut server.io, 20, 20, make_obj(clone(tr_lo), g47 + 1, 0, 0, Subgroup, 1, make_tagged_payload(7, 900)), true))
        result.unwrap(moq.publish_at(mut ss, mut server.io, 20, 20, make_obj(clone(tr_lo), g32 + 1, 0, 0, Subgroup, 1, make_tagged_payload(6, 900)), true))
        result.unwrap(moq.publish_at(mut ss, mut server.io, 20, 20, make_obj(clone(tr_hi), g47 + 9, 0, 0, Subgroup, 50, make_tagged_payload(5, 900)), true))
        result.unwrap(moq.publish_at(mut ss, mut server.io, 20, 20, make_obj(clone(tr_hi), g32 + 9, 1, 0, Subgroup, 5, make_tagged_payload(4, 900)), true))
        result.unwrap(moq.publish_at(mut ss, mut server.io, 20, 20, make_obj(clone(tr_hi), g47 + 5, 70001, 1, Subgroup, 5, make_tagged_payload(3, 900)), true))
        result.unwrap(moq.publish_at(mut ss, mut server.io, 20, 20, make_obj(clone(tr_hi), g47 + 5, 70000, 0, Subgroup, 5, make_tagged_payload(2, 900)), true))
        result.unwrap(moq.publish_at(mut ss, mut server.io, 20, 20, make_obj(clone(tr_hi), g47 + 5, 0, 2, Datagram, 5, make_tagged_payload(1, 900)), true))
    }
    let mut t_drain = 30 * MS_NS
    let got = drain_one_by_one(mut server, mut client, mut t_drain)
    let want: Bytes = b"\x01\x02\x03\x04\x05\x06\x07"
    if got != want {
        let mut msg = "sending order did not match moqt-23 §5.1.2 priority order: got "
        for b in got {
            string.push_uint(mut msg, int.widen(b), 10, 0, '0')
            string.push(mut msg, ",")
        }
        fail(take msg)
    }
    // Group past base + 2^48 ends the subscription with PUBLISH_DONE, never wrapping rank.
    list.clear(mut client.events)
    let overflow_group: u64 = 1u64 << 48
    if let Some(mut ss) = server.sess {
        result.unwrap(moq.publish(mut ss, mut server.io, 500 * MS_NS, make_obj(clone(tr_lo), overflow_group, 0, 0, Subgroup, 1, b"overflow")))
    }
    settle_pair(mut client, mut server, 501 * MS_NS)
    let mut saw_done = false
    for ev in client.events {
        if let Done(code: c, ..) = ev {
            if c == moq.DONE_TOO_FAR_BEHIND {
                saw_done = true
            }
        }
    }
    if !saw_done {
        fail("group past base + 2^48 did not end subscription with PUBLISH_DONE")
    }
    Ok(())
}

/// bug: OBJECT_DELIVERY_TIMEOUT and SUBGROUP_DELIVERY_TIMEOUT share one timer, start before
/// FIN, fail to fire on handover vs Acked, ignore min(pub, sub) / max_timeout_ms cap, or apply
/// the wrong rule to datagrams.
/// oracle: moqt-23 §5.2 and MOQ-5 (M7), every edge worked by hand.
@test
fn delivery_timeouts_start_and_stop_apart() -> Result[(), ()] {
    // 1. OBJECT 50 ms: header arrived 60 ms before handover -> reset with DELIVERY_TIMEOUT;
    //    handed over at 40 ms -> delivered even if ACK arrives 500 ms later.
    let lim = moq.Limits(requests: 16, tracks: 16, control_bytes: 65535, object_bytes: 65536, filter_ranges: 8, max_early_streams: 4, max_timeout_ms: 500)
    let mut c1 = native_client(901)
    let mut s1 = native_server(902, lim)
    establish_native(mut c1, mut s1, lim, b"to.test", b"/1", None)
    let tr1 = track(ns1(b"to"), b"obj")
    if let Some(mut cs) = c1.sess {
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut c1.io, 0, clone(tr1), NoFilter, 10, Ascending, 50, 0, None))
    }
    settle_pair(mut c1, mut s1, 1 * MS_NS)
    accept_all_subscribes(mut s1)
    settle_pair(mut c1, mut s1, 2 * MS_NS)
    list.clear(mut c1.events)
    let t0 = 100 * MS_NS
    if let Some(mut ss) = s1.sess {
        // Group 1, obj 0: born at t0, handed over at t0 + 40 ms (< 50 ms) -> MUST succeed!
        result.unwrap(moq.publish_at(mut ss, mut s1.io, t0 + 40 * MS_NS, t0, make_obj(clone(tr1), 1, 0, 0, Subgroup, 10, b"ok-40ms"), false))
        // Group 2, obj 0: open subgroup at t0, then obj 1 born at t0 handed over at t0 + 60 ms (>= 50 ms) -> reset!
        result.unwrap(moq.publish_at(mut ss, mut s1.io, t0, t0, make_obj(clone(tr1), 2, 0, 0, Subgroup, 10, b"first"), false))
        result.unwrap(moq.publish_at(mut ss, mut s1.io, t0 + 60 * MS_NS, t0, make_obj(clone(tr1), 2, 0, 1, Subgroup, 10, b"late-60ms"), false))
        if moq.timed_out_objects(ss) != 1 {
            fail("60ms object did not trigger OBJECT_DELIVERY_TIMEOUT (50ms)")
        }
        // Subsequent object on timed-out subgroup (2, 0) must not open a new stream.
        result.unwrap(moq.publish_at(mut ss, mut s1.io, t0 + 61 * MS_NS, t0 + 61 * MS_NS, make_obj(clone(tr1), 2, 0, 2, Subgroup, 10, b"after-reset"), false))
    }
    // Deliver much later (t0 + 500 ms) — group 1 obj 0 was already handed to quic at 40 ms so it arrives!
    settle_pair(mut c1, mut s1, t0 + 500 * MS_NS)
    let got1 = received_objects(c1.events)
    let mut saw_40 = false
    let mut saw_60 = false
    let mut saw_after = false
    for o in got1 {
        if o.group == 1 && o.id == 0 {
            saw_40 = true
        }
        if o.group == 2 && o.id == 1 {
            saw_60 = true
        }
        if o.group == 2 && o.id == 2 {
            saw_after = true
        }
    }
    if !saw_40 || saw_60 || saw_after {
        fail("OBJECT_DELIVERY_TIMEOUT did not send 40ms object or failed to suppress 60ms/follow-up")
    }
    // 2. SUBGROUP 200 ms: never starts before FIN; fires 200 ms after FIN if un-Acked;
    //    does NOT fire if Acked at 190 ms.
    let mut c2 = native_client(911)
    let mut s2 = native_server(912, lim)
    establish_native(mut c2, mut s2, lim, b"to.test", b"/2", None)
    let tr2 = track(ns1(b"to"), b"sg")
    if let Some(mut cs) = c2.sess {
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut c2.io, 0, clone(tr2), NoFilter, 10, Ascending, 0, 200, None))
    }
    settle_pair(mut c2, mut s2, 1 * MS_NS)
    accept_all_subscribes(mut s2)
    settle_pair(mut c2, mut s2, 2 * MS_NS)
    // Subgroup (10, 0): open without FIN and poll 400 ms later -> timer MUST NOT fire before FIN!
    if let Some(mut ss) = s2.sess {
        result.unwrap(moq.publish_at(mut ss, mut s2.io, 10 * MS_NS, 10 * MS_NS, make_obj(clone(tr2), 10, 0, 0, Subgroup, 10, b"open"), false))
        let _ = moq.poll(mut ss, mut s2.io, 410 * MS_NS)
        if moq.timed_out_subgroups(ss) != 0 {
            fail("SUBGROUP_DELIVERY_TIMEOUT fired before FIN")
        }
        // Now FIN at 420 ms; do NOT deliver/Ack to client, poll at 620 ms (+200 ms) -> MUST fire!
        moq.finish_subgroup(mut ss, mut s2.io, 420 * MS_NS, clone(tr2), 10, 0)
        let _ = moq.poll(mut ss, mut s2.io, 619 * MS_NS)
        if moq.timed_out_subgroups(ss) != 0 {
            fail("SUBGROUP_DELIVERY_TIMEOUT fired early at 199ms")
        }
        let _ = moq.poll(mut ss, mut s2.io, 620 * MS_NS)
        if moq.timed_out_subgroups(ss) != 1 {
            fail("SUBGROUP_DELIVERY_TIMEOUT did not fire at 200ms after FIN without Ack")
        }
    }
    // Subgroup (11, 0): FIN at 700 ms, Acked at 890 ms (190 ms later), poll at 950 ms -> NOT reset!
    if let Some(mut ss) = s2.sess {
        result.unwrap(moq.publish_at(mut ss, mut s2.io, 700 * MS_NS, 700 * MS_NS, make_obj(clone(tr2), 11, 0, 0, Subgroup, 10, b"acked-190"), true))
    }
    settle_pair(mut c2, mut s2, 890 * MS_NS)
    if let Some(mut ss) = s2.sess {
        let _ = moq.poll(mut ss, mut s2.io, 950 * MS_NS)
        if moq.timed_out_subgroups(ss) != 1 {
            fail("subgroup Acked at 190ms was wrongly reset")
        }
    }
    // 3. Precedence: pub 80 + sub 50 -> 50; pub 0 + sub 50 -> 50; pub 80 + sub 0 -> 80;
    //    both 0 + max_timeout_ms 500 -> 500. Plus datagram OBJECT 100 + SUBGROUP 30 -> 30.
    let mut c3 = native_client(921)
    let mut s3 = native_server(922, lim)
    establish_native(mut c3, mut s3, lim, b"to.test", b"/3", None)
    let tr_min = track(ns1(b"to"), b"min")
    let tr_pub = track(ns1(b"to"), b"pub")
    let tr_cap = track(ns1(b"to"), b"cap")
    let tr_dg = track(ns1(b"to"), b"dg")
    if let Some(mut ss) = s3.sess {
        moq.set_track_timeouts(mut ss, clone(tr_min), 80, 0)
        moq.set_track_timeouts(mut ss, clone(tr_pub), 80, 0)
        moq.set_track_timeouts(mut ss, clone(tr_dg), 100, 30)
    }
    if let Some(mut cs) = c3.sess {
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut c3.io, 0, clone(tr_min), NoFilter, 10, Ascending, 50, 0, None))
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut c3.io, 0, clone(tr_pub), NoFilter, 10, Ascending, 0, 0, None))
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut c3.io, 0, clone(tr_cap), NoFilter, 10, Ascending, 0, 0, None))
        let _ = result.unwrap(moq.subscribe_with(mut cs, mut c3.io, 0, clone(tr_dg), NoFilter, 10, Ascending, 0, 0, None))
    }
    settle_pair(mut c3, mut s3, 1 * MS_NS)
    accept_all_subscribes(mut s3)
    settle_pair(mut c3, mut s3, 2 * MS_NS)
    let base_t = 1000 * MS_NS
    if let Some(mut ss) = s3.sess {
        // pub 80 + sub 50 -> 50: 45ms passes, 55ms times out.
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 45 * MS_NS, base_t, make_obj(clone(tr_min), 1, 0, 0, Subgroup, 10, b"a"), true))
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 55 * MS_NS, base_t, make_obj(clone(tr_min), 2, 0, 0, Subgroup, 10, b"b"), true))
        if moq.timed_out_objects(ss) != 1 {
            fail("pub 80 / sub 50 did not apply 50ms")
        }
        // pub 80 + sub 0 -> 80: 70ms passes, 85ms times out.
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 70 * MS_NS, base_t, make_obj(clone(tr_pub), 1, 0, 0, Subgroup, 10, b"c"), true))
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 85 * MS_NS, base_t, make_obj(clone(tr_pub), 2, 0, 0, Subgroup, 10, b"d"), true))
        if moq.timed_out_objects(ss) != 2 {
            fail("pub 80 / sub 0 did not apply 80ms")
        }
        // both 0 + max_timeout_ms 500 -> 500: 450ms passes, 510ms times out.
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 450 * MS_NS, base_t, make_obj(clone(tr_cap), 1, 0, 0, Subgroup, 10, b"e"), true))
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 510 * MS_NS, base_t, make_obj(clone(tr_cap), 2, 0, 0, Subgroup, 10, b"f"), true))
        if moq.timed_out_objects(ss) != 3 {
            fail("both 0 with max_timeout_ms 500 did not apply 500ms cap")
        }
        // Datagram with OBJECT 100ms + SUBGROUP 30ms -> dropped at 30ms, sent at 20ms.
        let dg_props = make_props_timeout(100, 30)
        let dg_ok = moq.Object(track: clone(tr_dg), group: 1, subgroup: 0, id: 0, mode: Datagram, publisher_priority: 10, status: Normal, properties: clone(dg_props), payload: shared.new(b"dg-ok"))
        let dg_late = moq.Object(track: clone(tr_dg), group: 1, subgroup: 0, id: 1, mode: Datagram, publisher_priority: 10, status: Normal, properties: take dg_props, payload: shared.new(b"dg-late"))
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 20 * MS_NS, base_t, take dg_ok, false))
        result.unwrap(moq.publish_at(mut ss, mut s3.io, base_t + 30 * MS_NS, base_t, take dg_late, false))
        if moq.timed_out_objects(ss) != 4 {
            fail("datagram with OBJECT 100ms and SUBGROUP 30ms was not dropped at 30ms")
        }
    }
    Ok(())
}

pub type HistoryWrite = HistoryApplied(std.object.ETag) | HistoryConflict(std.object.ETag) | HistoryRefused(std.object.Error) | HistoryUndecided

pub fn history_fetch_head(mut client: std.object.Client, mut raw_bytes: Bytes, deadline: u64) -> Result[std.object.ETag, std.object.Error] waits {
    list.clear(mut raw_bytes)
    let (take outcome, take buffer) = std.object.fetch(mut client, "head", replace(mut raw_bytes, list.new()), deadline)
    raw_bytes = take buffer
    let meta = outcome?
    if meta.size != list.len(raw_bytes) || meta.etag.len == 0 {
        return Error(Fatal(Malformed))
    }
    Ok(meta.etag)
}

pub fn history_write_head_issue(mut client: std.object.Client, precondition: std.object.Precondition, mut raw_bytes: Bytes, deadline: u64) -> Result[std.object.PendingStore, std.object.Error] waits {
    match std.object.store_if_issue(mut client, "head", precondition, replace(mut raw_bytes, list.new()), deadline) {
        Ok(take pending) => Ok(take pending),
        Error((take buffer, take problem)) => {
            raw_bytes = take buffer
            Error(take problem)
        },
    }
}

pub fn history_write_head_finish(mut client: std.object.Client, take issued: Result[std.object.PendingStore, std.object.Error], mut raw_bytes: Bytes, mut witness: Bytes, deadline: u64) -> HistoryWrite waits {
    let (take outcome, take buffer) = match take issued {
        Ok(take pending) => std.object.store_if_finish(mut client, take pending),
        Error(take problem) => return HistoryRefused(take problem),
    }
    raw_bytes = take buffer
    match take outcome {
        Ok(Applied(meta)) => HistoryApplied(meta.etag),
        Ok(Mismatch) => {
            let Ok(tag) = history_fetch_head(mut client, mut witness, deadline) else {
                return HistoryUndecided
            }
            if raw_bytes == witness {
                HistoryApplied(tag)
            } else {
                HistoryConflict(tag)
            }
        },
        Error(Uncertain(_)) => HistoryUndecided,
        Error(take problem) => HistoryRefused(take problem),
    }
}

// `attach` is the head's ATTACH while the Place is attached to a host stream
// (§12.11.2); every head write carries it after AUTHORITY.
pub opaque type HistoryRegister: send {
    head: HistoryHead,
    tag: std.object.ETag,
    terminal: Option[HistoryTerminal],
    attach: Option[format.Attach]
}

// Encodes `head` with AUTHORITY, optional ATTACH, and optional ORIGIN.
pub fn history_encode_register_head(mut raw: Bytes, head: HistoryHead, authority: Bytes, attach: Option[format.Attach]) -> Result[(), types.Failure] {
    history_encode_base_head(mut raw, head, authority)?
    let ctx = format.DiskContext(store: head.store, role: 7, seq: head.entry.seq)
    if let Some(a) = attach {
        format.stream_attach_append(mut raw, ctx, a)?
    }
    if let Some(o) = head.origin {
        history_origin_append(mut raw, ctx, o)?
    }
    Ok(())
}

// The end of AUTHORITY's frame in a decoded head: the authority bytes a new
// head copies, never a trailing ATTACH.
pub fn history_authority_end(raw: Bytes) -> Result[u64, types.Failure] {
    let (context, field) = history_head_frame(raw)?
    Ok(manifest.history_frame("head", context, raw, field.end, 0x00D0)?.end)
}

pub type HistoryTerminal: send = HistoryFault(types.Failure) | HistoryUnknown

pub const HISTORY_BUFFER_KEY_BYTES: u64 = 60

pub type HistoryBuffers: send {
    body: Bytes,
    witness: Bytes,
    packet: Bytes,
    compare: Bytes,
    key: String
}

pub fn history_buffers(packet_bytes: u64) -> Result[HistoryBuffers, types.Failure] {
    let room = order.max(packet_bytes, 152 + format.BINDING_BYTES)
    manifest.disk_allocation(scoped fn() -> Result[HistoryBuffers, types.Failure] {
        Ok(HistoryBuffers(body: list.with_capacity(HISTORY_HEAD_LIMIT), witness: list.with_capacity(HISTORY_HEAD_LIMIT), packet: list.with_capacity(room), compare: list.with_capacity(room), key: string.with_capacity(HISTORY_BUFFER_KEY_BYTES)))
    })
}

pub fn history_packet_header(mut raw: Bytes, ctx: format.DiskContext, epoch: u64, kind: u8, predecessor: pages.HistoryRef) -> Result[(), types.Failure] {
    list.clear(mut raw)
    types.capacity(format.history_append_header(mut raw, ctx, epoch, kind))?
    list.fill(mut raw, 16, 0u8)
    list.put_word_le(mut raw, predecessor.epoch)
    list.put_word_le(mut raw, predecessor.len)
    list.put_word_le(mut raw, predecessor.digest)
    types.capacity(format.history_seal(mut raw, ctx, 72, 0x00B0))
}

pub fn history_new_ref(seq: u64, epoch: u64, raw: Bytes) -> pages.HistoryRef {
    pages.HistoryRef(seq, epoch, len: list.len(raw), digest: std.check.xxh3(raw, 0, list.len(raw)))
}

pub fn history_fetch(mut client: std.object.Client, key: String, mut raw: Bytes, deadline: u64) -> Result[std.object.Meta, types.Failure] waits {
    list.clear(mut raw)
    let (take outcome, take buffer) = std.object.fetch(mut client, key, replace(mut raw, list.new()), deadline)
    raw = take buffer
    match take outcome {
        Ok(meta) => {
            if meta.size != list.len(raw) {
                return Error(format.disk_fault(key, 0, Truncated))
            }
            Ok(meta)
        },
        Error(take e) => Error(Remote(take e)),
    }
}

pub fn history_create(mut client: std.object.Client, key: String, mut raw: Bytes, mut compare: Bytes, deadline: u64) -> Result[(), types.Failure] waits {
    let (take outcome, take buffer) = std.object.store_if_retry(mut client, key, Absent, replace(mut raw, list.new()), deadline)
    raw = take buffer
    match take outcome {
        Ok(Applied(_)) => Ok(()),
        Ok(Mismatch) => {
            let _ = history_fetch(mut client, key, mut compare, deadline)?
            if raw != compare {
                return Error(format.disk_fault(key, 0, Malformed))
            }
            Ok(())
        },
        Error(take problem) => Error(Remote(take problem)),
    }
}

pub fn history_register_advance(mut client: std.object.Client, mut register: HistoryRegister, authority: Bytes, mut buffers: HistoryBuffers, deadline: u64) -> Result[HistoryWrite, types.Failure] waits {
    let mut candidate = register.head
    let seq = history_next_id(candidate.entry.seq)?
    candidate.entry = history_new_ref(seq, candidate.pair.epoch, buffers.packet)
    history_register_publish(mut client, mut register, candidate, authority, mut buffers, deadline, fn(ignored: u64) {})
}

pub fn history_register_publish(mut client: std.object.Client, mut register: HistoryRegister, candidate: HistoryHead, authority: Bytes, mut buffers: HistoryBuffers, deadline: u64, entry_created: scoped fn(u64)) -> Result[HistoryWrite, types.Failure] waits {
    if let Some(stopped) = register.terminal {
        return match stopped {
            HistoryFault(problem) => Error(clone(problem)),
            HistoryUnknown => Ok(HistoryUndecided),
        }
    }
    pager.history_fill_key(mut buffers.key, "e-", candidate.entry)
    history_encode_register_head(mut buffers.body, candidate, authority, register.attach)?
    if let Error(take problem) = history_create(mut client, buffers.key, mut buffers.packet, mut buffers.compare, deadline) {
        register.terminal = Some(HistoryFault(clone(problem)))
        return Error(take problem)
    }
    entry_created(candidate.entry.seq)
    let issued_head = history_write_head_issue(mut client, Match(register.tag), mut buffers.body, deadline)
    match history_write_head_finish(mut client, take issued_head, mut buffers.body, mut buffers.witness, deadline) {
        HistoryApplied(tag) => {
            register.head = candidate
            register.tag = tag
            Ok(HistoryApplied(tag))
        },
        HistoryConflict(_) => {
            let fenced: types.Failure = Fenced(register.head.pair.epoch)
            register.terminal = Some(HistoryFault(clone(fenced)))
            Error(fenced)
        },
        HistoryRefused(take problem) => {
            let remote: types.Failure = Remote(take problem)
            register.terminal = Some(HistoryFault(clone(remote)))
            Error(take remote)
        },
        HistoryUndecided => {
            register.terminal = Some(HistoryUnknown)
            Ok(HistoryUndecided)
        },
    }
}

pub fn history_claim_packet(mut raw: Bytes, head: HistoryHead) -> Result[(), types.Failure] {
    let seq = history_next_id(head.entry.seq)?
    let ctx = format.DiskContext(store: head.store, role: 2, seq)
    history_packet_header(mut raw, ctx, head.pair.epoch, head.authority_kind, head.entry)?
    list.fill(mut raw, 16, 0u8)
    list.put_word_le(mut raw, head.pair.epoch)
    list.put_word_le(mut raw, head.pair.holder.hi)
    list.put_word_le(mut raw, head.pair.holder.lo)
    types.capacity(format.history_seal(mut raw, ctx, 112, 0x0040))
}

pub fn history_manifest_packet(mut raw: Bytes, id: types.StoreKey, kind: u8, limits: types.LimitsRep) -> Result[pages.HistoryRef, types.Failure] {
    raw = manifest.disk_page_manifest_bytes(id, manifest.page_manifest_empty(limits))?
    let ctx = format.DiskContext(store: id, role: 1, seq: 1)
    let mut header: Bytes = list.with_capacity(72 + format.BINDING_BYTES)
    types.capacity(format.history_append_header(mut header, ctx, 1, kind))?
    for at in 0u64 .. 72 {
        raw[at] = header[at]
    }
    Ok(history_new_ref(1, 1, raw))
}

pub fn history_genesis_packet(mut raw: Bytes, id: types.StoreKey, kind: u8, manifest: pages.HistoryRef, locator: HistoryLocateRoot) -> Result[pages.HistoryRef, types.Failure] {
    let ctx = format.DiskContext(store: id, role: 2, seq: 1)
    let none = pages.HistoryRef(seq: 0, epoch: 0, len: 0, digest: 0)
    let retained = HistoryRetention(floor: 1, earlier: list.new())
    history_checkpoint_packet(mut raw, ctx, 1, kind, none, manifest, retained, locator, HistoryActivation(number: 0, binding:[0; 32]))
}

// The tag no object carries: If-Match with it must fail on every key.
const HISTORY_PROBE_TAG: String = "\"hirsel-store-condition-probe\""

fn history_probe_tag() -> std.object.ETag {
    let text = string.as_bytes(HISTORY_PROBE_TAG)
    let mut tag = std.object.ETag(octets:[0; 64], len: list.len(text))
    for i in 0u64 .. tag.len {
        tag.octets[i] = text[i]
    }
    tag
}

// STORE §12.2: an endpoint that applies a PUT whose condition fails lets two
// writers both win the head. Before genesis writes a head, both conditions
// are sent with the immutable entry it just created, so an endpoint that
// ignores them rewrites identical bytes and nothing changes.
pub fn history_check_conditions(mut client: std.object.Client, key: String, mut raw: Bytes, deadline: u64) -> Result[(), types.Failure] waits {
    let (take absent, take returned) = std.object.store_if_retry(mut client, key, Absent, replace(mut raw, list.new()), deadline)
    raw = take returned
    match take absent {
        Ok(Mismatch) => (),
        Ok(Applied(_)) => return Error(Endpoint(IgnoresIfNoneMatch)),
        Error(take problem) => return Error(Remote(take problem)),
    }
    let (take stale, take again) = std.object.store_if_retry(mut client, key, Match(history_probe_tag()), replace(mut raw, list.new()), deadline)
    raw = take again
    match take stale {
        Ok(Mismatch) => Ok(()),
        Ok(Applied(_)) => Error(Endpoint(IgnoresIfMatch)),
        Error(take problem) => Error(Remote(take problem)),
    }
}

pub fn history_publish_genesis(mut client: std.object.Client, id: types.StoreKey, holder: types.StoreKey, kind: u8, authority: Bytes, mut buffers: HistoryBuffers, deadline: u64, limits: types.LimitsRep, take attach: Option[format.Attach]) -> Result[HistoryRegister, types.Failure] waits {
    let manifest = history_manifest_packet(mut buffers.packet, id, kind, limits)?
    history_create(mut client, history_key("m-", manifest), mut buffers.packet, mut buffers.compare, deadline)?
    let locator = HistoryLocateRoot(depth: 0, rows: list.new())
    history_publish_base(mut client, id, holder, kind, authority, manifest, locator, mut buffers, deadline, take attach)
}

// With `attach` the head is a streamed genesis's (§12.11.5): no step 5a probe.
pub fn history_publish_base(mut client: std.object.Client, id: types.StoreKey, holder: types.StoreKey, kind: u8, authority: Bytes, manifest: pages.HistoryRef, locator: HistoryLocateRoot, mut buffers: HistoryBuffers, deadline: u64, take attach: Option[format.Attach]) -> Result[HistoryRegister, types.Failure] waits {
    let bytes_wanted = 229 + 32 * list.len(locator.rows)
    list.clear(mut buffers.packet)
    list.clear(mut buffers.compare)
    types.capacity(list.try_reserve(mut buffers.packet, bytes_wanted + format.BINDING_BYTES))?
    types.capacity(list.try_reserve(mut buffers.compare, bytes_wanted))?
    let base = history_genesis_packet(mut buffers.packet, id, kind, manifest, locator)?
    let base_key = history_key("e-", base)
    history_create(mut client, base_key, mut buffers.packet, mut buffers.compare, deadline)?
    if let None = attach {
        history_check_conditions(mut client, base_key, mut buffers.packet, deadline)?
    }
    let head = HistoryHead(authority_kind: kind, store: id, pair: HistoryPair(epoch: 1, holder), activation: 0, entry: base, checkpoint: base, floor: 1, binding:[0; 32], origin: None)
    history_encode_register_head(mut buffers.body, head, authority, attach)?
    let issued_head = history_write_head_issue(mut client, Absent, mut buffers.body, deadline)
    match history_write_head_finish(mut client, take issued_head, mut buffers.body, mut buffers.witness, deadline) {
        HistoryApplied(tag) => Ok(HistoryRegister(head, tag, terminal: None, attach: take attach)),
        HistoryConflict(_) => Error(Exists("head")),
        HistoryRefused(take problem) => Error(Remote(take problem)),
        HistoryUndecided => Error(Undecided),
    }
}

pub type HistoryClaimResult = HistoryClaimed(HistoryRegister) | HistoryClaimMoved(bool) | HistoryClaimLost | HistoryClaimUncertain

// Keep only the bytes changed by the claim so the final GET can overwrite
// the admitted buffer. All other bytes must match the prepared replacement.
pub fn history_claim_saved(admitted: Bytes) -> Inline[u8, 48] {
    let mut saved: Inline[u8, 48] =[0; 48]
    for i in 0u64 .. 8 {
        saved[i] = admitted[8 + i]
        saved[8 + i] = admitted[48 + i]
    }
    for i in 0u64 .. 32 {
        saved[16 + i] = admitted[80 + i]
    }
    saved
}

pub fn history_claim_saved_origin(admitted: Bytes, authority_end: u64) -> Option[Inline[u8, 65]] {
    if list.len(admitted) == authority_end {
        return None
    }
    let mut saved: Inline[u8, 65] =[0; 65]
    for i in 0u64 .. 65 {
        saved[i] = admitted[authority_end + i]
    }
    Some(saved)
}

pub fn history_claim_same(candidate_base: Bytes, saved: Inline[u8, 48], saved_origin: Option[Inline[u8, 65]], observed: Bytes) -> bool {
    let base_len = list.len(candidate_base)
    let want_len = match saved_origin {
        Some(_) => base_len + ORIGIN_FRAME_BYTES,
        None => base_len,
    }
    if list.len(observed) != want_len || list.slice(observed, 0, 8) != list.slice(candidate_base, 0, 8) || list.slice(observed, 16, 48) != list.slice(candidate_base, 16, 48) || list.slice(observed, 56, 80) != list.slice(candidate_base, 56, 80) || list.slice(observed, 112, base_len) != list.slice(candidate_base, 112, base_len) {
        return false
    }
    for i in 0u64 .. 8 {
        if saved[i] != observed[8 + i] || saved[8 + i] != observed[48 + i] {
            return false
        }
    }
    for i in 0u64 .. 32 {
        if saved[16 + i] != observed[80 + i] {
            return false
        }
    }
    if let Some(old_origin) = saved_origin {
        for i in 0u64 .. 65 {
            if old_origin[i] != observed[base_len + i] {
                return false
            }
        }
    }
    true
}

pub fn history_claim_changed(head: HistoryHead, observed: Bytes, backoff: bool) -> Result[HistoryClaimResult, types.Failure] {
    let (_, field) = history_head_frame(observed)?
    if !history_pair_matches(head.pair, history_frame_pair(observed, field)) {
        return Ok(HistoryClaimLost)
    }
    let latest = history_decode_head(observed)?
    if latest.head.entry.seq <= head.entry.seq {
        return Error(format.disk_fault("head", 72, Malformed))
    }
    Ok(HistoryClaimMoved(backoff))
}

pub fn register_head(register: HistoryRegister) -> HistoryHead {
    register.head
}

pub fn register_tag(register: HistoryRegister) -> std.object.ETag {
    register.tag
}

pub fn register_attach(register: HistoryRegister) -> View[Option[format.Attach]] in register {
    view register.attach
}

pub fn register_terminal(register: HistoryRegister) -> View[Option[HistoryTerminal]] in register {
    view register.terminal
}

pub fn fence_register(mut register: HistoryRegister, take problem: types.Failure) {
    register.terminal = Some(HistoryFault(take problem))
}

pub opaque type PreparedRegisterHead {
    head: HistoryHead,
    attach: Option[format.Attach],
    raw: Bytes
}

pub fn prepare_register_head(mut raw: Bytes, head: HistoryHead, authority: Bytes, take attach: Option[format.Attach]) -> Result[PreparedRegisterHead, types.Failure] {
    history_encode_register_head(mut raw, head, authority, clone(attach))?
    Ok(PreparedRegisterHead(head, attach: take attach, raw: replace(mut raw, list.new())))
}

pub type RegisterClaimWrite = RegisterClaimApplied(HistoryRegister) | RegisterClaimConflict | RegisterClaimRefused(std.object.Error) | RegisterClaimUndecided

pub fn return_prepared_body(take prepared: PreparedRegisterHead, mut body: Bytes) {
    let PreparedRegisterHead(raw: take raw, ..) = take prepared
    body = take raw
}

pub opaque type IssuedRegisterHead {
    head: HistoryHead,
    attach: Option[format.Attach],
    pending: std.object.PendingStore
}

pub fn issue_prepared_register(mut client: std.object.Client, precondition: std.object.Precondition, take prepared: PreparedRegisterHead, deadline: u64) -> Result[IssuedRegisterHead, (PreparedRegisterHead, std.object.Error)] waits {
    let PreparedRegisterHead(head, attach: take attach, raw: take raw) = take prepared
    match std.object.store_if_issue(mut client, "head", precondition, take raw, deadline) {
        Ok(take pending) => Ok(IssuedRegisterHead(head, attach: take attach, pending: take pending)),
        Error((take encoded, take problem)) => Error((PreparedRegisterHead(head, attach: take attach, raw: take encoded), take problem)),
    }
}

pub fn finish_prepared_register(mut client: std.object.Client, take issued: IssuedRegisterHead, mut body: Bytes, mut witness: Bytes, deadline: u64) -> RegisterClaimWrite waits {
    let IssuedRegisterHead(head, attach: take attach, pending: take pending) = take issued
    match history_write_head_finish(mut client, Ok(take pending), mut body, mut witness, deadline) {
        HistoryApplied(tag) => RegisterClaimApplied(HistoryRegister(head, tag, terminal: None, attach: take attach)),
        HistoryConflict(_) => RegisterClaimConflict,
        HistoryRefused(take problem) => RegisterClaimRefused(take problem),
        HistoryUndecided => RegisterClaimUndecided,
    }
}

pub fn write_prepared_register(mut client: std.object.Client, precondition: std.object.Precondition, take prepared: PreparedRegisterHead, mut body: Bytes, mut witness: Bytes, deadline: u64) -> RegisterClaimWrite waits {
    match issue_prepared_register(mut client, precondition, take prepared, deadline) {
        Ok(take issued) => finish_prepared_register(mut client, take issued, mut body, mut witness, deadline),
        Error((PreparedRegisterHead(raw: take raw, ..), take problem)) => {
            body = take raw
            RegisterClaimRefused(take problem)
        },
    }
}

pub fn publish_register_head(mut client: std.object.Client, mut register: HistoryRegister, candidate: HistoryHead, authority: Bytes, take attach: Option[format.Attach], mut buffers: HistoryBuffers, deadline: u64) -> Result[HistoryWrite, types.Failure] waits {
    history_encode_register_head(mut buffers.body, candidate, authority, attach)?
    let issued = history_write_head_issue(mut client, Match(register.tag), mut buffers.body, deadline)
    let written = history_write_head_finish(mut client, take issued, mut buffers.body, mut buffers.witness, deadline)
    if let HistoryApplied(tag) = written {
        register.head = candidate
        register.tag = tag
        register.attach = take attach
    }
    Ok(written)
}

pub fn replace_admitted_claim(mut client: std.object.Client, admitted: HistoryHead, candidate: HistoryHead, mut buffers: HistoryBuffers, deadline: u64, attach: Option[format.Attach]) -> Result[HistoryClaimResult, types.Failure] waits {
    let saved = history_claim_saved(buffers.witness)
    let authority_end = history_authority_end(buffers.witness)?
    let saved_origin = history_claim_saved_origin(buffers.witness, authority_end)
    history_encode_base_head(mut buffers.body, candidate, list.slice(buffers.witness, 240, authority_end))?
    let standalone_end = list.len(buffers.body)
    let ctx = format.DiskContext(store: candidate.store, role: 7, seq: candidate.entry.seq)
    if let Some(a) = attach {
        format.stream_attach_append(mut buffers.body, ctx, a)?
    }
    if let Some(o) = candidate.origin {
        history_origin_append(mut buffers.body, ctx, o)?
    }
    let observed = history_fetch(mut client, "head", mut buffers.witness, deadline)?
    if !history_claim_same(list.slice(buffers.body, 0, standalone_end), saved, saved_origin, buffers.witness) {
        return history_claim_changed(admitted, buffers.witness, false)
    }
    let issued_head = history_write_head_issue(mut client, Match(observed.etag), mut buffers.body, deadline)
    match history_write_head_finish(mut client, take issued_head, mut buffers.body, mut buffers.witness, deadline) {
        HistoryApplied(tag) => Ok(HistoryClaimed(HistoryRegister(head: candidate, tag, terminal: None, attach: clone(attach)))),
        HistoryConflict(_) => history_claim_changed(admitted, buffers.witness, true),
        HistoryRefused(take problem) => Error(Remote(take problem)),
        HistoryUndecided => Ok(HistoryClaimUncertain),
    }
}

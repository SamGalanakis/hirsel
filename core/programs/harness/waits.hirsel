// Session authorization and the active run's pending approvals.

pub fn cold_reader_allowed(reader: store.ReadOnly, caller: store.Caller) -> Result[bool, store.Error] {
    let key = reader_key(caller) ?=> |_| Missing("reader identity")
    let readers = store.read_only_table(reader, "harness.readers", std.codec.key_bytes(), std.codec.of_bool())?
    Ok(store.read_only_get(reader, readers, key)? == Some(true))
}

// Pending decisions belong to the active run's caller. The HTTP view
// includes only Open rows from this cover.
pub fn pending_waits(tx: store.Tx, h: Handles, caller: store.Caller, take unused: ()) -> Result[runner.Cover, Capacity] {
    let waits = view h.waits
    let zero = first_wait(0u64)
    if reader_allowed(tx, h, caller)? {
        if let Ok(Some(s)) = store.fetch(tx, h.session, 0u64) {
            if let Some(id) = s.active_run {
                if let Ok(Some(r)) = store.fetch(tx, h.runs, id) {
                    if r.caller.issuer == caller.issuer && r.caller.subject == caller.subject {
                        return runner.cover(waits, Included(first_wait(id)), Included(last_wait(id)))
                    }
                }
            }
        }
    }
    runner.cover(waits, Included(zero), Excluded(zero))
}

fn first_wait(id: u64) -> WaitKey {
    WaitKey(run: id, slot: 0u64, kind: 0u8, generation: 0u64)
}

fn last_wait(id: u64) -> WaitKey {
    WaitKey(run: id, slot: 18446744073709551615u64, kind: 255u8, generation: 18446744073709551615u64)
}

pub type PendingWait: codec + send { run: u64, round: u64, ordinal: u64, key: Bytes, expires: u64 }

pub fn open_wait(k: WaitKey, take w: Wait) -> Option[PendingWait] {
    if k.kind == APPROVAL {
        if let Open(take key, expires) = take w {
            return Some(PendingWait(run: k.run, round: k.generation, ordinal: k.slot, key: take key, expires: expires))
        }
    }
    None
}

// The same pending decisions for a trusted application with a local snapshot.
pub fn pending_approvals(snap: store.Snapshot, h: Handles, caller: store.Caller) -> Result[List[PendingWait], Refused] {
    let mut pending: List[PendingWait] = list.new()
    let key = reader_key(caller) ?=> |_| NotAllowed
    if kept(store.get(snap, h.readers, key))? != Some(true) {
        return Error(NotAllowed)
    }
    let Some(s) = kept(store.get(snap, h.session, 0u64))? else { return Ok(take pending) }
    let Some(id) = s.active_run else { return Ok(take pending) }
    let Some(r) = kept(store.get(snap, h.runs, id))? else { return Ok(take pending) }
    if r.caller.issuer != caller.issuer || r.caller.subject != caller.subject {
        return Ok(take pending)
    }
    let mut rows = kept(store.scan(snap, h.waits, Included(first_wait(id)), Included(last_wait(id))))?
    while let Some((k, take w)) = kept(store.next(mut rows))? {
        if let Some(take row) = open_wait(k, take w) {
            list.push(mut pending, take row)
        }
    }
    Ok(take pending)
}

pub fn pending_waits_entry[G: send](mut r: runner.Registry[G, Handles], n: u64, steps: u64) -> Result[(), runner.RegisterError] {
    let codec: std.codec.Codec[Wait] = std.codec.of()
    runner.query_as(mut r, code.describe(pending_waits), wait_key(), codec, n, steps)
}


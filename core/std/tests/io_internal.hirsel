// test-of: std.io
// test-reason: the private raw-byte LF scanner must return the range end when no newline is inside.
// Every prefix length and LF lane, with misaligned input and invalid UTF-8.
// expect: run scan_prefix_bounds() = true
fn scan_prefix_bounds() -> bool {
    let mut b: Bytes = result.unwrap(list.with_capacity(96))
    for _ in 0u64 .. 96 {
        result.unwrap(list.push(mut b, 255u8))
    }
    for base in 0u64 .. 8 {
        for n in 0u64 .. 35 {
            let end = base + n
            b[end] = 10
            if newline_or_end(b, base, end) != end {
                return false
            }
            for at in 0u64 .. n {
                b[base + at] = 10
                let found = newline_or_end(b, base, end)
                b[base + at] = 255
                if found != base + at {
                    return false
                }
            }
            b[end] = 255
        }
    }
    true
}

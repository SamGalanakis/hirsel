// The admission bound, then the commit on branch `i` (section 1.11, run step 4).
type AdmittedDraft[R, A] = Ready(Ran[R, A], Publication) | OverLimit(Ran[R, A], StoreCapacity)

// A follower publication or a retained-root settle needs the proposed roots
// before admission. Apply the same plan to a private holder for that case.
fn candidate_for_admission[R, A](mut db: Db, i: u64, mut draft: Ran[R, A]) -> Result[(), Error] {
    if let Some(_) = draft.roots {
        return Ok(())
    }
    let mut roots = disk_allocation(scoped fn() -> Result[pages.Roots, Error] {
        Ok(pages.share_roots(pages.holder_heads(db.holders)[i].roots))
    })?
    let Some(take inline_plan) = replace(mut draft.inline_plan, None) else {
        draft.roots = Some(take roots)
        return Ok(())
    }
    let mut plan = take inline_plan
    failure_result_from_rep(types.capacity(txn.reserve_inline_tree(mut roots.collections, mut plan.data)))?
    failure_result_from_rep(types.capacity(txn.reserve_inline_tree(mut roots.streams, mut plan.streams)))?
    txn.install_inline_tree(mut roots.collections, mut plan.data, draft.edits, draft.order)
    txn.install_inline_tree(mut roots.streams, mut plan.streams, draft.replies, InOrder)
    draft.roots = Some(take roots)
    Ok(())
}

fn reserve_head_plan(mut db: Db, i: u64, mut plan: txn.InlineDraft) -> Result[(), Capacity] {
    pages.edit_head_collection(mut db.holders, i, scoped fn(mut tree: pages.PageTree) -> Result[(), Capacity] {
        txn.reserve_inline_tree(mut tree, mut plan.data)
    })?
    pages.edit_head_streams(mut db.holders, i, scoped fn(mut tree: pages.PageTree) -> Result[(), Capacity] {
        txn.reserve_inline_tree(mut tree, mut plan.streams)
    })
}

fn prepare_run_commit[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[AdmittedDraft[R, A], Error] {
    if over_bound(db, ran) {
        let needed = ran.live
        let available = txn.available_resident(db.accounting, txn.draft_credit(db.call_streams.keyed_credit, ran.keyed))
        return Ok(OverLimit(take ran, Resident(Capacity(requested: needed, available: available))))
    }
    let mut draft = take ran
    let branch_id = pages.holder_heads(db.holders)[i].id
    if let Some(_) = branch_follower_slot(db.followers, branch_id) {
        match candidate_for_admission(mut db, i, mut draft) {
            Ok(()) => (),
            Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
            Error(take problem) => return Error(take problem),
        }
    }
    let reserved = match draft.inline_plan {
        Some(mut plan) => reserve_head_plan(mut db, i, mut plan),
        None => Ok(()),
    }
    if let Error(problem) = reserved {
        return Ok(OverLimit(take draft, Allocation(problem)))
    }
    if let Some(roots) = draft.roots {
        let extra = int.saturating_sub(manifest.keyed_root_record_bytes(roots.keyed), manifest.keyed_root_record_bytes(pages.holder_heads(db.holders)[i].roots.keyed))
        check_manifest_addition(db, extra)?
    }
    if let Some(_) = draft.tiered {
        let total = match draft.roots {
            Some(roots) => failure_result_from_rep(txn.settled_tiered_bytes(db.accounting.tiered, retaining(db), pages.holder_heads(db.holders)[i].roots.collections, roots.collections, draft.edits)),
            None => Ok(db.accounting.tiered),
        }
        match total {
            Ok(n) => {
                draft.tiered = Some(n)
            },
            Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
            Error(take problem) => return Error(take problem),
        }
    }
    if let None = branch_follower_slot(db.followers, pages.holder_heads(db.holders)[i].id) {
        return Ok(Ready(take draft, Publication(followed: None)))
    }
    let drafted_publication = disk_allocation(scoped fn() -> Result[Publication, Error] {
        let Some(roots) = view draft.roots else {
            fail("store: prepared draft has no roots")
        }
        failure_result_from_rep(types.capacity(prepare_publication(db, i, pages.holder_heads(db.holders)[i].head + 1, roots, pages.holder_next_node(db.holders))))
    })
    let publication = match take drafted_publication {
        Ok(take plan) => take plan,
        Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
        Error(take problem) => return Error(take problem),
    }
    Ok(Ready(take draft, take publication))
}

// §13.8's charge for the commit's replaced and dropped rows, checked and
// reserved once the commit is otherwise decided, so applying it cannot fail.
fn reserve_tiered_freed[R, A](mut db: Db, ran: Ran[R, A]) -> Option[StoreCapacity] {
    let Some(freed) = view ran.freed else {
        return None
    }
    if !is_disk(db) || (list.len(freed.replaced) == 0 && list.len(freed.dropped) == 0) {
        return None
    }
    let limit = disk_state(db).options.dirty_bytes
    let reserved = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Result[(), Error] {
        failure_result_from_rep(pager.reserve_dirty(mut state.tiered, freed, limit))
    })
    match reserved {
        Ok(()) => None,
        Error(Full(problem)) => Some(problem),
        Error(_) => fail("store: a list reservation refuses only with Full"),
    }
}

fn commit_prepared[R, A](mut db: Db, i: u64, take ran: Ran[R, A], take publication: Publication) -> Outcome[R, A] {
    db.call_streams.keyed_credit = txn.draft_credit(db.call_streams.keyed_credit, ran.keyed)
    if i == 0u64 {
        for reply_slot in 0u64 .. pages.data_row_count(ran.replies) {
            let drafted_reply = pages.data_row(ran.replies, reply_slot)
            if map.contains(db.call_streams.admits, drafted_reply.key) {
                let settled = match drafted_reply.value {
                    None => true,
                    Some(raw) => result.unwrap(txn.stream_state(format.staged_bytes(raw))).state == 2u8,
                }
                if settled {
                    let _ = map.remove(mut db.call_streams.admits, drafted_reply.key)
                }
            }
        }
    }
    let mut ready = take ran
    if let Some(take inline_plan) = replace(mut ready.inline_plan, None) {
        let mut plan = take inline_plan
        pages.edit_head_collection(mut db.holders, i, scoped fn(mut tree: pages.PageTree) {
            txn.install_inline_tree(mut tree, mut plan.data, ready.edits, ready.order)
        })
        pages.edit_head_streams(mut db.holders, i, scoped fn(mut tree: pages.PageTree) {
            txn.install_inline_tree(mut tree, mut plan.streams, ready.replies, InOrder)
        })
    }
    let txn.Ran(value: take value, roots: take roots, live: live_bytes, tiered: tiered, freed: take freed, exact: exact, frame: take frame, info: ci, reads: take seen, ..) = take ready
    let branch_id = pages.holder_heads(db.holders)[i].id
    match db.disk {
        Some(mut state) => {
            if let Some(take written) = take freed {
                pager.admit_dirty(mut state.tiered, branch_id, take written)
            }
            let size = match frame {
                Some(raw) => list.len(raw),
                None => 0u64
            }
            stage_disk_frame(mut state, size, take frame)
            db.frame_seq += 1
        },
        None => {
            let _ = take frame
        },
    }
    if let Some(take candidate) = take roots {
        let old_bytes = manifest.keyed_root_record_bytes(pages.holder_heads(db.holders)[i].roots.keyed)
        let count_bytes = manifest.keyed_root_record_bytes(candidate.keyed)
        pages.commit_roots(mut db.holders, i, take candidate, old_bytes, count_bytes)
    }
    db.accounting.resident = live_bytes
    if let Some(n) = tiered {
        db.accounting.tiered = n
    }
    pages.advance_head(mut db.holders, i, ci.at)
    db.accounting.changes += 1
    if exact {
        db.accounting.settled = db.accounting.changes
    }
    publish(take publication)
    let sent_sequence = if !is_disk(db) {
        db.accounting.changes
    } else {
        db.frame_seq
    }
    let commit_ticket = Ticket(store: db.store, open: open_number(db), mark: Journal(sent_sequence, pages.holder_heads(db.holders)[i].id, pages.holder_heads(db.holders)[i].head))
    match take value {
        Ok(take v) => Committed(Done(value: take v, ticket: commit_ticket, info: Some(ci), reads: take seen)),
        Error(take a) => Aborted(Undone(value: take a, ticket: Some(commit_ticket)))
    }
}

fn commit_skipped[R, A](db: Db, i: u64, take ran: Ran[R, A]) -> Outcome[R, A] {
    let txn.Ran(value: take value, reads: take seen, ..) = take ran
    let sent_sequence = if !is_disk(db) {
        db.accounting.changes
    } else {
        db.frame_seq
    }
    let commit_ticket = Ticket(store: db.store, open: open_number(db), mark: Journal(sent_sequence, pages.holder_heads(db.holders)[i].id, pages.holder_heads(db.holders)[i].head))
    match take value {
        Ok(take v) => Committed(Done(value: take v, ticket: commit_ticket, info: None, reads: take seen)),
        Error(_) => fail("store: skipped commit must return Ok"),
    }
}

fn keyed_draft_empty(db: Db, keyed: Option[format.KeyedDraft]) -> bool {
    match keyed {
        None => true,
        Some(draft) => list.len(draft.edits) == 0 && txn.keyed_credit_equal(draft.after, db.call_streams.keyed_credit),
    }
}

fn draft_is_empty[R, A](db: Db, force_frame: bool, rec: Option[CallRecord], settlement: Option[format.Settlement], prepared: txn.Prepared[R, A]) -> bool {
    if force_frame || prepared.observed_info {
        return false
    }
    if let Error(_) = prepared.outcome {
        return false
    }
    if pages.data_row_count(prepared.ops) != 0 || pages.data_row_count(prepared.stream_ops) != 0 {
        return false
    }
    if !keyed_draft_empty(db, prepared.keyed) {
        return false
    }
    if let Some(_) = prepared.call {
        return false
    }
    if let Some(_) = rec {
        return false
    }
    if let Some(_) = settlement {
        return false
    }
    true
}

fn draft_row_account(db: Db, i: u64, proposed: pages.Roots) -> Result[u64, Error] {
    disk_allocation(scoped fn() -> Result[u64, Error] {
        let mut roots: List[pages.Roots] = list.with_capacity(list.len(pages.holder_heads(db.holders)) + list.len(pages.holder_pins(db.holders)))
        for slot in 0u64 .. list.len(pages.holder_heads(db.holders)) {
            let root = if slot == i {
                pages.share_roots(proposed)
            } else {
                pages.share_roots(pages.holder_heads(db.holders)[slot].roots)
            }
            list.push(mut roots, take root)
        }
        for held in pages.holder_pins(db.holders) {
            list.push(mut roots, pages.share_roots(held.roots))
        }
        Ok(pages.page_row_account(roots))
    })
}

// AP15: an over-bound retained-root draft is admitted on its proposed union.
// If settling old charges rotates the journal, rebind the staged frame.
fn settle_draft[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[(AdmittedDraft[R, A], Option[txn.CutDecision]), Error] waits {
    if ran.skipped {
        return Ok((Ready(take ran, Publication(followed: None)), None))
    }
    if is_disk(db) {
        let refusal = match ran.frame {
            Some(raw) => txn.journal_refusal(queue_accounting(disk_state(db)).uncovered, list.len(raw), txn.available_journal(disk_state(db).options.journal_limit, txn.draft_credit(db.call_streams.keyed_credit, ran.keyed))),
            None => None,
        }
        if let Some(overflow) = refusal {
            return Ok((OverLimit(take ran, Journal(overflow)), None))
        }
    }
    if !over_bound(db, ran) || !retaining(db) {
        wait_for_frame_room(mut db, ran.frame)?
        return Ok((prepare_run_commit(mut db, i, take ran)?, None))
    }
    let mut settled = take ran
    match candidate_for_admission(mut db, i, mut settled) {
        Ok(()) => (),
        Error(Full(problem)) => return Ok((OverLimit(take settled, problem), None)),
        Error(take problem) => return Error(take problem),
    }
    let counted = {
        let Some(roots) = view settled.roots else {
            fail("store: settled draft has no roots")
        }
        draft_row_account(db, i, roots)
    }
    let live_bytes = match take counted {
        Ok(live_bytes) => live_bytes,
        Error(Full(problem)) => return Ok((OverLimit(take settled, problem), None)),
        Error(take problem) => return Error(take problem),
    }
    settled.live = live_bytes
    settled.exact = true
    let checked = prepare_run_commit(mut db, i, take settled)?
    let (take admitted, take publication) = match take checked {
        Ready(take ready, take plan) => (take ready, take plan),
        OverLimit(take rejected, problem) => return Ok((OverLimit(take rejected, problem), None)),
    }
    let cut = txn.settlement_cut(db.accounting, admitted.tiered, admitted.frame != None)
    Ok((Ready(take admitted, take publication), Some(cut)))
}

fn settle_and_wait[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[AdmittedDraft[R, A], Error] waits {
    let (take checked, cut) = settle_draft(mut db, i, take ran)?
    let Some(decision) = cut else {
        return Ok(take checked)
    }
    let (take admitted, take publication) = match take checked {
        Ready(take ready, take plan) => (take ready, take plan),
        OverLimit(take rejected, problem) => return Ok(OverLimit(take rejected, problem)),
    }
    let mut draft = take admitted
    if let NoCut = decision {} else {
        match cut_install(mut db, NoHolderChange) {
            Ok(_) => {},
            Error(Full(c)) => return Ok(OverLimit(take draft, c)),
            Error(take e) => return Error(take e)
        }
        if let (Reseal, Some(take frame)) = (decision, replace(mut draft.frame, None)) {
            let mut raw = take frame
            if let Error(c) = format.seal_frame(mut raw, format.DiskContext(store: store_key_to_rep(db.store), role: 2, seq: file_seq(db)), file_end(db)) {
                return Ok(OverLimit(take draft, Allocation(c)))
            }
            draft.frame = Some(take raw)
        }
    }
    wait_for_frame_room(mut db, draft.frame)?
    Ok(Ready(take draft, take publication))
}

fn settle_admit[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[Outcome[R, A], Error] waits {
    let checked = settle_and_wait(mut db, i, take ran)?
    match take checked {
        Ready(take draft, take publication) => {
            if draft.skipped {
                let _ = take publication
                if object_writer_open(db) {
                    journal_poll(mut db)?
                    if covered(db, Journal(db.frame_seq, 0, 0)) {
                        object_skip_fence(mut db)?
                    }
                }
                return Ok(commit_skipped(db, i, take draft))
            }
            if let Some(problem) = reserve_tiered_freed(mut db, draft) {
                return Ok(Refused(problem))
            }
            Ok(commit_prepared(mut db, i, take draft, take publication))
        },
        OverLimit(_, c) => Ok(Refused(c)),
    }
}

fn frame_draft[R, A](db: Db, base: pages.PageTree, ci: CallInfo, rec: Option[CallRecord], settlement: Option[format.Settlement], force_frame: bool, take finished: Finished[R, A]) -> Result[Finished[R, A], Capacity] {
    match take finished {
        RolledBack(take outcome) => Ok(RolledBack(take outcome)),
        DraftFault(take problem) => Ok(DraftFault(take problem)),
        Drifted(take name, take seen) => Ok(Drifted(take name, take seen)),
        Prepared(take ready) => {
            let mut prepared = take ready
            let skipped = draft_is_empty(db, force_frame, rec, settlement, prepared)
            prepared.skipped = skipped
            if !skipped && is_disk(db) {
                let deltas: Option[View[List[Option[format.TieredDataDelta]]]] = match prepared.plan {
                    Some(plan) => Some(view plan.deltas),
                    None => None,
                }
                prepared.frame = Some(encode_staged(ci, Some(view base), Some(prepared.base_stamp), deltas, mut prepared.ops, prepared.order, prepared.frame_tail, prepared.stream_ops, prepared.call, rec, settlement, prepared.keyed, file_seq(db), file_end(db), db.limits.frame)?)
            }
            Ok(Prepared(take prepared))
        },
    }
}

fn over_bound[R, A](db: Db, ran: Ran[R, A]) -> bool {
    ran.admits_rows && ran.live > txn.available_resident(db.accounting, txn.draft_credit(db.call_streams.keyed_credit, ran.keyed))
}

fn store_body_at[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    store_body_at_with(mut db, i, wall, steps, keep_reply, false, body)
}

fn store_body_at_with[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], force_frame: bool, body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let outcome = append_transaction_at_with(mut db, i, wall, steps, keep_reply, force_frame, body)
    if let Ok(Refused(Journal(_))) = outcome {
        return take outcome
    }
    if let Ok(Committed(Done(info: None, ..))) = outcome {
        return take outcome
    }
    maybe_checkpoint(mut db)?
    take outcome
}

fn append_transaction_at[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    append_transaction_at_with(mut db, i, wall, steps, keep_reply, false, body)
}

fn append_transaction_at_with[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], force_frame: bool, body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let outcome: Result[Outcome[R, A], Error] = match staged_until_decided(mut db, i, wall, steps, keep_reply, force_frame, body)? {
        Over(take o) => Ok(take o),
        Ran(take ran) => settle_admit(mut db, i, take ran),
        DraftError(take problem) => Error(take problem),
        Latched => fail("store: a decided stage is latched"),
        DriftStop(take name, take seen) => {
            trip_drift(mut db, i, take seen)?
            Ok(Failed(Drift(take name)))
        },
    }
    handoff(mut db)?
    take outcome
}

fn prepare_metered_pages[R, A](base: pages.Roots, issued: core.Cell[u64], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], take finished: Finished[R, A]) -> Result[Finished[R, A], Error] {
    failure_result_from_rep(txn.prepare_metered_pages(base, issued, attempt, pins, take finished))
}

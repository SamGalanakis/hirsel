// test-of: core.map
// test-reason: private slot state is required to prove moved entries are not cleaned twice
fn word(i: u64) -> String {
    result.unwrap(string.from(match i {
        0 => "a",
        1 => "b",
        2 => "c",
        3 => "d",
        4 => "e",
        5 => "f",
        6 => "g",
        7 => "h",
        8 => "i",
        9 => "j",
        10 => "k",
        11 => "l",
        12 => "m",
        13 => "n",
        14 => "o",
        15 => "p",
        _ => "q"
    }))
}

// Removing eight entries and filling the table forces compact before key16.
// The resulting live insertion order is 8,9,10,11,12,13,14,15,16.
// expect: run drained_after_compact() = 9
fn drained_after_compact() -> u64 {
    let mut m: Map[u64, String] = map.new()
    for i in 0u64 .. 9 {
        result.unwrap(map.insert(mut m, i, word(i)))
    }
    let _ = map.remove(mut m, 0)
    let _ = map.remove(mut m, 2)
    let _ = map.remove(mut m, 4)
    let _ = map.remove(mut m, 6)
    let _ = map.remove(mut m, 1)
    let _ = map.remove(mut m, 3)
    let _ = map.remove(mut m, 5)
    let _ = map.remove(mut m, 7)
    for i in 9u64 .. 16 {
        result.unwrap(map.insert(mut m, i, word(i)))
    }
    result.unwrap(map.insert(mut m, 16, word(16)))
    let mut count: u64 = 0
    for take (k, v) in m {
        if k != count + 8 || v != word(k) {
            return 99
        }
        count += 1
    }
    count
}

// Removals without a compaction leave dead slots before and between live
// entries. The loop steps past each dead slot and moves out the live entries
// once each, in insertion order: 1 then 3.
// expect: run drained_past_dead_slots() = 13
fn drained_past_dead_slots() -> u64 {
    let mut m: Map[u64, String] = map.new()
    for i in 0u64 .. 4 {
        result.unwrap(map.insert(mut m, i, word(i)))
    }
    let _ = map.remove(mut m, 0)
    let _ = map.remove(mut m, 2)
    let mut seen: u64 = 0
    for take (k, v) in m {
        if v != word(k) {
            return 99
        }
        seen = seen * 10 + k
    }
    seen
}

// The current binding is cleaned before the unreached map tail.
// expect: run early_break_cleans_tail() = 0
fn early_break_cleans_tail() -> u64 {
    let mut m: Map[u64, String] = map.new()
    for i in 0u64 .. 4 {
        result.unwrap(map.insert(mut m, i, word(i)))
    }
    let mut count: u64 = 0
    for take (k, v) in m {
        count += k
        break
    }
    count
}

// A failing body leaves the current binding and every unreached entry owned.
// The evaluator's moved-slot checks catch both duplicate cleanup and leaks.
// expect: run failing_body_cleans_tail() = fail Unwrap
fn failing_body_cleans_tail() -> u64 {
    let mut m: Map[u64, String] = map.new()
    for i in 0u64 .. 4 {
        result.unwrap(map.insert(mut m, i, word(i)))
    }
    let mut count: u64 = 0
    for take (k, v) in m {
        count += k
        let none: Option[u64] = None
        let _ = option.unwrap(none)
    }
    count
}

// expect: run narrow_map_keys_use_value_parameters() = 42
fn narrow_map_keys_use_value_parameters() -> u64 {
    let mut counts: Map[u32, u64] = map.new()
    result.unwrap(map.insert(mut counts, 5u32, 42u64))
    match map.get(counts, 5u32) {
        Some(value) => value,
        None => 0,
    }
}

// Insertion uses the supplied initial value. A second call updates the same
// entry and ignores its initial value. Both calls return the callback's result.
// expect: run update_or_insert_once() = true
fn update_or_insert_once() -> bool {
    let mut m: Map[u64, u64] = map.new()
    let mut calls: u64 = 0
    let (first, second) = {
        let bump = scoped fn(mut value: u64) -> u64 {
            calls += 1
            value += 1
            value
        }
        let first = result.unwrap(map.update_or_insert(mut m, 5u64, 7u64, bump))
        let second = result.unwrap(map.update_or_insert(mut m, 5u64, 50u64, bump))
        (first, second)
    }
    let saved = option.unwrap(map.get(m, 5u64))
    first == 8 && second == 9 && saved == 9 && calls == 2 && map.len(m) == 1
}

// Admission refusal returns both owned inputs and skips the callback.
// expect: run update_or_insert_refused() = true
fn update_or_insert_refused() -> bool {
    result.unwrap(bound bytes 0 {
        let mut m: Map[String, String] = map.new()
        let mut called = false
        let response = map.update_or_insert(mut m, "key", "value", scoped fn(mut value: String) {
            called = true
            value = "changed"
        })
        match take response {
            Error((c, (key, value))) => c.available == 0 && key == "key" && value == "value" && !called && map.len(m) == 0,
            Ok(()) => false,
        }
    })
}

// PROG-8: a name error poisons its construct, not its definition. The call of `nope`,
// `q` bound from it and `q + 1u64` built on `q` are silent; each later independent error
// in the same body is reported at the site it has when checked alone.
fn f(a: u64) -> u64 {
  let q = nope(a)
  let r = q + 1u64
  let m: String = a
  let k: u64 = "s"
  a
}

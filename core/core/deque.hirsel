// A power-of-two ring of uninhabited slots, following Rust's VecDeque.
pub opaque type Deque[T]: shareable + send {
    ring: Slots[T],
    head: u64
} drop(d) {
    // Normalize the live interval before List's resumable element cleanup.
    // The finalizer itself moves only and cannot fail.
    if d.head == 0 {
        return
    }
    if !slots_needs_drop(d.ring) {
        let head = d.head
        slots_forget_ring(mut d.ring, head)
        return
    }
    let count = list.len(d.ring.raw)
    let cap = list.capacity(d.ring.raw)
    let tail = int.wrapping_sub(cap, d.head)
    let wrapped: u64 = if count > tail {
        int.wrapping_sub(count, tail)
    } else {
        0
    }
    let moved: u64 = if count > tail {
        tail
    } else {
        count
    }
    let mut i: u64 = 0
    while count != cap && i < moved {
        slots_shift(mut d.ring, int.wrapping_add(d.head, i), int.wrapping_add(wrapped, i))
        i = int.wrapping_add(i, 1)
    }
    reverse(mut d.ring, 0, wrapped)
    reverse(mut d.ring, wrapped, count)
    reverse(mut d.ring, 0, count)
    d.head = 0
}

pub fn new[T]() -> Deque[T] {
    Deque(ring: slots_empty(), head: 0)
}

pub fn len[T](d: Deque[T]) -> u64 {
    list.len(d.ring.raw)
}

pub fn push_back[T](mut d: Deque[T], take x: T) {
    if list.len(d.ring.raw) == list.capacity(d.ring.raw) {
        grow(mut d)
    }
    // Opaque ring invariants make the masked index arithmetic non-failing.
    let i = int.wrapping_add(d.head, list.len(d.ring.raw)) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    slots_put(mut d.ring, i, take x)
}

pub fn push_front[T](mut d: Deque[T], take x: T) {
    if list.len(d.ring.raw) == list.capacity(d.ring.raw) {
        grow(mut d)
    }
    d.head = int.wrapping_sub(d.head, 1) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    slots_put(mut d.ring, d.head, take x)
}

// Logical index i counts from the front. Each accessor follows List's
// convention: a view or None for reads, Bounds for a write or removal at
// i >= len. None of them admits anything.
pub fn get[T](d: Deque[T], i: u64) -> Option[View[T]] in d {
    if i >= list.len(d.ring.raw) {
        return None
    }
    Some(slots_view(d.ring, slot(d, i)))
}

pub fn front[T](d: Deque[T]) -> Option[View[T]] in d {
    get(d, 0)
}

pub fn back[T](d: Deque[T]) -> Option[View[T]] in d {
    get(d, int.wrapping_sub(list.len(d.ring.raw), 1))
}

// Replaces element i and returns the old one.
pub fn set[T](mut d: Deque[T], i: u64, take x: T) -> T {
    check_index(d, i)
    let at = slot(d, i)
    let old = slots_take(mut d.ring, at)
    slots_put(mut d.ring, at, take x)
    old
}

// Removes element i, keeping order: moves the shorter side by one, as
// VecDeque::remove does.
pub fn remove[T](mut d: Deque[T], i: u64) -> T {
    check_index(d, i)
    let count = list.len(d.ring.raw)
    let head = d.head
    let mask = int.wrapping_sub(list.capacity(d.ring.raw), 1)
    let x = slots_take(mut d.ring, int.wrapping_add(head, i) & mask)
    if i < int.wrapping_sub(int.wrapping_sub(count, 1), i) {
        let mut j = i
        while j > 0 {
            let to = int.wrapping_add(head, j) & mask
            j = int.wrapping_sub(j, 1)
            slots_shift(mut d.ring, int.wrapping_add(head, j) & mask, to)
        }
        d.head = int.wrapping_add(head, 1) & mask
    } else {
        let mut j = i
        while int.wrapping_add(j, 1) < count {
            let to = int.wrapping_add(head, j) & mask
            j = int.wrapping_add(j, 1)
            slots_shift(mut d.ring, int.wrapping_add(head, j) & mask, to)
        }
    }
    x
}

// Removes element i and moves the back element into its place.
pub fn swap_remove_back[T](mut d: Deque[T], i: u64) -> T {
    check_index(d, i)
    let last = int.wrapping_sub(list.len(d.ring.raw), 1)
    let at = slot(d, i)
    let from = slot(d, last)
    let x = slots_take(mut d.ring, at)
    if i != last {
        slots_shift(mut d.ring, from, at)
    }
    x
}

// Removes element i and moves the front element into its place.
pub fn swap_remove_front[T](mut d: Deque[T], i: u64) -> T {
    check_index(d, i)
    let at = slot(d, i)
    let head = d.head
    let next = slot(d, 1)
    let x = slots_take(mut d.ring, at)
    if i != 0 {
        slots_shift(mut d.ring, head, at)
    }
    d.head = next
    x
}

// The ring slot of logical index i. Only meaningful for a non-empty ring.
fn slot[T](d: Deque[T], i: u64) -> u64 {
    int.wrapping_add(d.head, i) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
}

// Bounds when i >= len, raised by indexing the slot list past its live count.
fn check_index[T](d: Deque[T], i: u64) {
    if i >= list.len(d.ring.raw) {
        let _ = view d.ring.raw[i]
    }
}

fn prepare_push[T](d: Deque[T], i: u64) {
    slots_unmark_spare(d.ring, i)
}

fn finish_prepared_push[T](mut d: Deque[T], i: u64, at_front: bool) {
    if at_front {
        d.head = i
    }
    slots_publish_spare(mut d.ring, i)
}

pub fn pop_front[T](mut d: Deque[T]) -> Option[T] {
    if list.len(d.ring.raw) == 0 {
        return None
    }
    let x = slots_take(mut d.ring, d.head)
    d.head = int.wrapping_add(d.head, 1) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    Some(take x)
}

pub fn pop_back[T](mut d: Deque[T]) -> Option[T] {
    if list.len(d.ring.raw) == 0 {
        return None
    }
    let i = int.wrapping_add(d.head, int.wrapping_sub(list.len(d.ring.raw), 1)) & int.wrapping_sub(list.capacity(d.ring.raw), 1)
    Some(slots_take(mut d.ring, i))
}

fn grow[T](mut d: Deque[T]) {
    let cap = list.capacity(d.ring.raw)
    let count = list.len(d.ring.raw)
    if count < cap {
        return
    }
    // The next power of two does not fit. List's counter-overflow admission
    // raises Capacity with the current room and cannot move the full ring.
    if cap > 9223372036854775807 {
        list.reserve(mut d.ring.raw, cap)
        return
    }
    let next: u64 = if cap == 0 {
        1
    } else {
        cap * 2
    }
    let mut ring: Slots[T] = slots_new(next)
    // The live interval is at most two runs. Relocate each run once, with
    // admission complete before either move and no fallible step between them.
    let head = d.head
    let tail = int.wrapping_sub(cap, head)
    let first = if count < tail {
        count
    } else {
        tail
    }
    let second = int.wrapping_sub(count, first)
    slots_move(mut d.ring, head, mut ring, 0, first)
    slots_move(mut d.ring, 0, mut ring, first, second)
    let old = replace(mut d.ring, take ring)
    slots_free(take old)
    d.head = 0
}

fn reverse[T](mut s: Slots[T], lo: u64, hi: u64) {
    let mut a = lo
    let mut b = hi
    while a < b {
        b = int.wrapping_sub(b, 1)
        if a < b {
            let x = slots_take(mut s, a)
            slots_shift(mut s, b, a)
            slots_put(mut s, b, take x)
        }
        a = int.wrapping_add(a, 1)
    }
}

type Slots[T]: shareable + send {
    raw: List[T]
}

fn slots_empty[T]() -> Slots[T]

fn slots_new[T](n: u64) -> Slots[T]

fn slots_unmark_spare[T](s: Slots[T], i: u64)

fn slots_publish_spare[T](mut s: Slots[T], i: u64)

fn slots_put[T](mut s: Slots[T], i: u64, take x: T)

fn slots_take[T](mut s: Slots[T], i: u64) -> T

fn slots_move[T](mut src: Slots[T], i: u64, mut dst: Slots[T], j: u64, n: u64)

fn slots_shift[T](mut s: Slots[T], i: u64, j: u64)

fn slots_free[T](take s: Slots[T])

// Copy the logical live range, independent of the source's holes and head.
// A valid MEM-17 call guarantees the element's resource/scoped/opaque-free holds.
clone[T](d: Deque[T]) {
    let count = list.len(d.ring.raw)
    if count == 0 {
        return Deque(ring: slots_empty(), head: 0)
    }
    // Least power-of-two capacity not below length, as ruled by the orchestrator.
    let mut capacity: u64 = 1
    while capacity < count {
        capacity *= 2
    }
    // A refusal raises Capacity; cleanup drops the elements built so far.
    let mut built: Deque[T] = Deque(ring: slots_new(capacity), head: 0)
    let mask = list.capacity(d.ring.raw) - 1
    let mut i: u64 = 0
    while i < count {
        let index = int.wrapping_add(d.head, i) & mask
        let x: T = clone(slots_view(d.ring, index))
        slots_put(mut built.ring, i, take x)
        i += 1
    }
    take built
}

fn slots_view[T](s: Slots[T], i: u64) -> View[T] in s

fn slots_needs_drop[T](s: Slots[T]) -> bool

fn slots_forget_ring[T](mut s: Slots[T], head: u64)

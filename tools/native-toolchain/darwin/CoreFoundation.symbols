# Every CoreFoundation symbol a Hirsel program may import on aarch64-apple-darwin, one
# Mach-O name per line, sorted. link_kit.py turns it into the kit's CoreFoundation.tbd.
# Only Trust.System reaches it (the Keychain roots, DECISIONS D4); a program that
# never reaches Trust.System drops the framework at link time (-dead_strip_dylibs).

_CFArrayCreate
_CFArrayGetCount
_CFArrayGetValueAtIndex
_CFDataGetBytePtr
_CFDataGetLength
_CFDictionaryGetValueIfPresent
_CFEqual
_CFNumberGetValue
_CFRelease
_CFRetain
_CFStringCreateWithBytesNoCopy
_CFStringGetBytes
_CFStringGetCStringPtr
_CFStringGetLength
_kCFAllocatorDefault
_kCFAllocatorNull
_kCFTypeArrayCallBacks

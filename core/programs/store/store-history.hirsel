const HISTORY_HEAD_LIMIT: u64 = 65776

const HISTORY_ENTRY_READ_LIMIT: u64 = 72 + 40 + 4294967296 + 16 + 16777280

const HISTORY_OPEN_LIMIT: u64 = 9223372036854775808

type HistoryRef {
    seq: u64,
    epoch: u64,
    len: u64,
    digest: u64
}

type HistoryPair {
    epoch: u64,
    holder: StoreId
}

const ORIGIN_PAYLOAD_BYTES: u64 = 49

const ORIGIN_FRAME_BYTES: u64 = 16 + ORIGIN_PAYLOAD_BYTES

type HistoryOrigin: shareable + send {
    epoch: u64,
    attempt: Inline[u8, 16],
    class: u8,
    permit_epoch: u64,
    permit_attempt: Inline[u8, 16]
}

type HistoryHead {
    authority_kind: u8,
    store: StoreId,
    pair: HistoryPair,
    activation: u64,
    entry: HistoryRef,
    checkpoint: HistoryRef,
    floor: u64,
    binding: Inline[u8, 32],
    origin: Option[HistoryOrigin]
}

type HistoryConfig {
    place: std.object.Bucket,
    levels: List[String]
}

type HistoryCapture {
    head: HistoryHead,
    config: HistoryConfig
}

fn history_fill_key(mut key: String, lead: String, reference: HistoryRef) {
    string.clear(mut key)
    string.push(mut key, lead)
    format.history_number(mut key, reference.seq)
    string.push_char(mut key, '-')
    format.history_number(mut key, reference.epoch)
    string.push_char(mut key, '-')
    std.hex.push_u64(mut key, reference.digest)
}

fn history_key(lead: String, reference: HistoryRef) -> String {
    let mut key = string.with_capacity(60)
    history_fill_key(mut key, lead, reference)
    take key
}

fn history_pair_matches(a: HistoryPair, b: HistoryPair) -> bool {
    a.epoch == b.epoch && types.same(a.holder.hi, a.holder.lo, b.holder.hi, b.holder.lo)
}

fn history_ref_matches(a: HistoryRef, b: HistoryRef) -> bool {
    a.seq == b.seq && a.epoch == b.epoch && a.len == b.len && a.digest == b.digest
}

fn history_entry_range(item: HistoryRef, epoch: u64) -> bool {
    item.epoch != 0 && item.epoch <= epoch && item.len >= 112 && item.len <= HISTORY_ENTRY_READ_LIMIT
}

fn history_frame(path: String, ctx: format.DiskContext, raw: Bytes, at: u64, kind: u16) -> Result[format.DiskFrame, Error] {
    let frame = disk_frame_bytes(path, ctx, raw, at)?
    if frame.kind != kind {
        if frame.flags == 1 && disk_kind_limit(frame.kind) == None {
            return Error(Unsupported(int.widen(frame.kind)))
        }
        return Error(failure_from_rep(format.disk_fault(path, at, Malformed)))
    }
    if frame.flags != 1 {
        return Error(failure_from_rep(format.disk_fault(path, at, Flags)))
    }
    Ok(frame)
}

fn history_text(raw: Bytes, mut cursor: u64, lo: u64, hi: u64, frame_at: u64) -> Result[String, Error] {
    if list.len(raw) - cursor < 2 {
        return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
    }
    let size = format.read_le(raw, cursor, 2)
    cursor += 2
    if size < lo || size > hi || size > list.len(raw) - cursor {
        return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
    }
    let text: Bytes = failure_result_from_rep(types.capacity(bound bytes format.round8(size) {
        clone(list.slice(raw, cursor, cursor + size))
    }))?
    let Ok(take parsed) = string.from_utf8(take text) else {
        return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
    }
    cursor += size
    Ok(take parsed)
}

fn history_config(raw: Bytes, frame_at: u64, authority_kind: u8) -> Result[HistoryConfig, Error] {
    if list.len(raw) == 0 || raw[0] > 1 {
        return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
    }
    let style: std.object.Style = if raw[0] == 0 {
        Virtual
    } else {
        Path
    }
    let mut cursor = 1u64
    let endpoint = history_text(raw, mut cursor, 1, 2048, frame_at)?
    let aws_region_name = history_text(raw, mut cursor, 0, 64, frame_at)?
    let bucket_name = history_text(raw, mut cursor, 3, 63, frame_at)?
    let key_prefix = history_text(raw, mut cursor, 0, 1024, frame_at)?
    if cursor == list.len(raw) {
        return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
    }
    let level_total: u64 = int.widen(raw[cursor])
    if level_total == 0 || level_total > 16 || (authority_kind == 1 && level_total != 1) {
        return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
    }
    cursor += 1
    let mut names: List[String] = failure_result_from_rep(types.capacity(bound bytes (24 * level_total) {
        list.with_capacity(level_total)
    }))?
    for slot_index in 0u64 .. level_total {
        let name = history_text(raw, mut cursor, 1, 64, frame_at)?
        let survives = if slot_index + 1 == level_total {
            2u8
        } else {
            0u8
        }
        if cursor == list.len(raw) || raw[cursor] != survives || list.contains(names, name) {
            return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
        }
        cursor += 1
        list.push(mut names, take name)
    }
    if cursor != list.len(raw) {
        return Error(failure_from_rep(format.disk_fault("head", frame_at, Malformed)))
    }
    let place = std.object.Bucket(endpoint: take endpoint, aws_region: take aws_region_name, bucket: take bucket_name, prefix: take key_prefix, style)
    Ok(HistoryConfig(place: take place, levels: take names))
}

fn history_head_frame(raw: Bytes) -> Result[(format.DiskContext, format.DiskFrame), Error] {
    if list.len(raw) < 72 {
        return Error(failure_from_rep(format.disk_fault("head", 0, Truncated)))
    }
    if list.len(raw) > HISTORY_HEAD_LIMIT {
        return Error(failure_from_rep(format.disk_fault("head", 0, Malformed)))
    }
    let id = StoreId(hi: format.read_le(raw, 32, 8), lo: format.read_le(raw, 40, 8))
    let context = format.DiskContext(store: store_key_to_rep(id), role: 7, seq: format.read_le(raw, 56, 8))
    let header = history_frame("head", context, raw, 0, 0x0001)?
    if header.end != 72 || list.slice(raw, 16, 24) != string.as_bytes("HIRSTORE") || raw[28] != 7 || format.read_le(raw, 30, 2) != 0 || format.read_le(raw, 64, 8) != 0 {
        return Error(failure_from_rep(format.disk_fault("head", 0, Header)))
    }
    let disk_version = format.read_le(raw, 24, 4)
    if disk_version != format.DISK_FORMAT {
        return Error(Unsupported(disk_version))
    }
    if raw[29] != 1 && raw[29] != 2 {
        return Error(Unsupported(int.widen(raw[29])))
    }
    let field = history_frame("head", context, raw, 72, 0x00A0)?
    if field.end - field.payload != 136 {
        return Error(failure_from_rep(format.disk_fault("head", 72, Malformed)))
    }
    Ok((context, field))
}

fn history_frame_pair(raw: Bytes, field: format.DiskFrame) -> HistoryPair {
    let at = field.payload
    HistoryPair(epoch: format.read_le(raw, at, 8), holder: StoreId(hi: format.read_le(raw, at + 8, 8), lo: format.read_le(raw, at + 16, 8)))
}

// A head carrying ATTACH is refused here: only the stream's openers read it
// (§12.11.2, "A non-streamed opener refuses an attached head").
fn history_decode_head(raw: Bytes) -> Result[HistoryCapture, Error] {
    let (take capture, take attach) = history_decode_head_attach(raw)?
    if let Some(a) = attach {
        return Error(Attached(optional_host_stream_id_from_rep(format.stream_attached_sid(a))))
    }
    Ok(take capture)
}

fn history_origin_zero_bytes(bytes_in: Inline[u8, 16]) -> bool {
    for i in 0u64 .. 16 {
        if bytes_in[i] != 0u8 {
            return false
        }
    }
    true
}

fn history_origin_same_bytes(a: Inline[u8, 16], b: Inline[u8, 16]) -> bool {
    for i in 0u64 .. 16 {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

// The objects@1 head's own frame kinds (ORIGIN), then the host stream's.
fn history_kind_limit(kind: u16) -> Option[u64] {
    if kind == 0x00E0 {
        return Some(ORIGIN_PAYLOAD_BYTES)
    }
    format.stream_kind_limit(kind)
}

fn history_origin_decode(raw: Bytes, frame: format.DiskFrame, head_epoch: u64) -> Result[HistoryOrigin, Error] {
    let at = frame.payload - 16
    if frame.flags != 1 {
        return Error(failure_from_rep(format.disk_fault("head", at, Flags)))
    }
    if frame.end - frame.payload != ORIGIN_PAYLOAD_BYTES {
        return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
    }
    let p = frame.payload
    let epoch = format.read_le(raw, p, 8)
    let mut attempt: Inline[u8, 16] =[0; 16]
    for i in 0u64 .. 16 {
        attempt[i] = raw[p + 8 + i]
    }
    let class = raw[p + 24]
    let permit_epoch = format.read_le(raw, p + 25, 8)
    let mut permit_attempt: Inline[u8, 16] =[0; 16]
    for i in 0u64 .. 16 {
        permit_attempt[i] = raw[p + 33 + i]
    }
    // Rules O3–O4: ORIGIN.epoch == HEAD.epoch, class in 0..=2, and permit
    // fields match the class invariant.
    if epoch != head_epoch || head_epoch < 2 || class > 2 {
        return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
    }
    if class == 0 {
        if permit_epoch != epoch || !history_origin_same_bytes(permit_attempt, attempt) {
            return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
        }
    } else {
        if permit_epoch >= epoch {
            return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
        }
        if permit_epoch == 0 {
            if !history_origin_zero_bytes(permit_attempt) {
                return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
            }
        } else if permit_epoch < 2 {
            return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
        }
    }
    Ok(HistoryOrigin(epoch, attempt, class, permit_epoch, permit_attempt))
}

fn history_origin_append(mut raw_bytes: Bytes, ctx: format.DiskContext, origin: HistoryOrigin) -> Result[(), Error] {
    let needed = ORIGIN_FRAME_BYTES + format.BINDING_BYTES
    let room = list.capacity(raw_bytes) - list.len(raw_bytes)
    if room < needed {
        return Error(Full(Allocation(Capacity(requested: list.len(raw_bytes) + needed, available: list.capacity(raw_bytes)))))
    }
    let at = list.len(raw_bytes)
    list.fill(mut raw_bytes, 16, 0u8)
    list.put_word_le(mut raw_bytes, origin.epoch)
    for i in 0u64 .. 16 {
        list.push(mut raw_bytes, origin.attempt[i])
    }
    list.push(mut raw_bytes, origin.class)
    list.put_word_le(mut raw_bytes, origin.permit_epoch)
    for i in 0u64 .. 16 {
        list.push(mut raw_bytes, origin.permit_attempt[i])
    }
    failure_result_from_rep(types.capacity(format.history_seal(mut raw_bytes, ctx, at, 0x00E0)))
}

fn history_optional_tail_frame(raw: Bytes, ctx: format.DiskContext, at: u64) -> Result[format.DiskFrame, Error] {
    let frame = disk_frame_bytes("head", ctx, raw, at)?
    if frame.kind != 0x0100 && frame.kind != 0x00E0 {
        if frame.flags == 1 && disk_kind_limit(frame.kind) == None {
            return Error(Unsupported(int.widen(frame.kind)))
        }
        return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
    }
    if frame.flags != 1 {
        return Error(failure_from_rep(format.disk_fault("head", at, Flags)))
    }
    Ok(frame)
}

fn history_decode_head_attach(raw: Bytes) -> Result[(HistoryCapture, Option[format.Attach]), Error] {
    let (context, field) = history_head_frame(raw)?
    let head = list.slice(raw, field.payload, field.end)
    let pair = history_frame_pair(raw, field)
    let epoch = pair.epoch
    let newest = HistoryRef(seq: format.read_le(head, 32, 8), epoch: format.read_le(head, 40, 8), len: format.read_le(head, 48, 8), digest: format.read_le(head, 56, 8))
    let base = HistoryRef(seq: format.read_le(head, 64, 8), epoch: format.read_le(head, 72, 8), len: format.read_le(head, 80, 8), digest: format.read_le(head, 88, 8))
    let floor = format.read_le(head, 96, 8)
    if epoch == 0 || floor == 0 || floor > base.seq || base.seq > newest.seq || context.seq != newest.seq || format.read_le(raw, 48, 8) != epoch {
        return Error(failure_from_rep(format.disk_fault("head", 72, Malformed)))
    }
    if !history_entry_range(newest, epoch) || !history_entry_range(base, epoch) || (newest.seq == base.seq && !history_ref_matches(newest, base)) {
        return Error(failure_from_rep(format.disk_fault("head", 72, Malformed)))
    }
    let mut schema_binding: Inline[u8, 32] =[0; 32]
    for i in 0u64 .. 32 {
        schema_binding[i] = head[104 + i]
    }
    let config = history_frame("head", context, raw, field.end, 0x00D0)?
    if config.end - config.payload > AUTHORITY_LIMIT {
        return Error(failure_from_rep(format.disk_fault("head", field.end, Malformed)))
    }
    let meta = history_config(list.slice(raw, config.payload, config.end), field.end, raw[29])?
    // Frame order after AUTHORITY: [ATTACH (0x0100)] || [ORIGIN (0x00E0)].
    let mut at = config.end
    let mut attach: Option[format.Attach] = None
    let mut origin: Option[HistoryOrigin] = None
    if at < list.len(raw) {
        let first_tail = history_optional_tail_frame(raw, context, at)?
        if first_tail.kind == 0x0100 {
            attach = Some(failure_result_from_rep(format.stream_attach_decode(raw, first_tail, newest.seq))?)
            at = first_tail.end
            if at < list.len(raw) {
                let second_tail = history_frame("head", context, raw, at, 0x00E0)?
                origin = Some(history_origin_decode(raw, second_tail, epoch)?)
                at = second_tail.end
            }
        } else {
            origin = Some(history_origin_decode(raw, first_tail, epoch)?)
            at = first_tail.end
        }
    }
    if at < list.len(raw) {
        let extra = disk_frame_bytes("head", context, raw, at)?
        if extra.flags == 1 && disk_kind_limit(extra.kind) == None {
            return Error(Unsupported(int.widen(extra.kind)))
        }
        return Error(failure_from_rep(format.disk_fault("head", at, Malformed)))
    }
    // Format 11: ORIGIN is absent at genesis epoch 1 and required at epoch >= 2.
    let has_origin = match origin {
        Some(_) => true,
        None => false,
    }
    if (epoch == 1 && has_origin) || (epoch >= 2 && !has_origin) {
        return Error(failure_from_rep(format.disk_fault("head", config.end, Malformed)))
    }
    let captured = HistoryHead(authority_kind: raw[29], store: store_key_from_rep(context.store), pair, activation: format.read_le(head, 24, 8), entry: newest, checkpoint: base, floor, binding: schema_binding, origin)
    Ok((HistoryCapture(head: captured, config: take meta), take attach))
}

fn history_next_id(n: u64) -> Result[u64, Error] {
    if n >= HISTORY_OPEN_LIMIT - 1 {
        return Error(Limit(Ids))
    }
    Ok(n + 1)
}

fn history_ref_encode(mut raw_bytes: Bytes, reference: HistoryRef) {
    list.put_word_le(mut raw_bytes, reference.seq)
    list.put_word_le(mut raw_bytes, reference.epoch)
    list.put_word_le(mut raw_bytes, reference.len)
    list.put_word_le(mut raw_bytes, reference.digest)
}

const AUTHORITY_LIMIT: u64 = 65536

fn history_append_text(mut raw: Bytes, text: String) {
    let size: u16 = int.narrow(string.byte_len(text))
    list.put_word_le(mut raw, size)
    list.append(mut raw, string.as_bytes(text))
}

fn history_config_bytes(config: HistoryConfig) -> Result[Bytes, Error] {
    let place = view config.place
    let endpoint = string.byte_len(place.endpoint)
    let name = string.byte_len(place.bucket)
    if endpoint == 0 || endpoint > 2048 || name < 3 || name > 63 || string.byte_len(place.aws_region) > 64 || string.byte_len(place.prefix) > 1024 {
        return Error(Limit(Name))
    }
    let mut level_bytes = 0u64
    let level_total = list.len(config.levels)
    if level_total == 0 || level_total > 16 {
        return Error(Limit(Name))
    }
    for i in 0u64 .. level_total {
        let level_name = view config.levels[i]
        let size = string.byte_len(level_name)
        if size == 0 || size > 64 {
            return Error(Limit(Name))
        }
        if list.contains(list.slice(config.levels, 0, i), level_name) {
            return Error(Exists(string.from(level_name)))
        }
        level_bytes += 3 + size
    }
    disk_allocation(scoped fn() -> Result[Bytes, Error] {
        let mut raw_bytes: Bytes = list.with_capacity(10 + endpoint + name + level_bytes + string.byte_len(place.aws_region) + string.byte_len(place.prefix))
        list.push(mut raw_bytes, if place.style == Virtual {
            0u8
        } else {
            1u8
        })
        history_append_text(mut raw_bytes, place.endpoint)
        history_append_text(mut raw_bytes, place.aws_region)
        history_append_text(mut raw_bytes, place.bucket)
        history_append_text(mut raw_bytes, place.prefix)
        list.push(mut raw_bytes, int.narrow(level_total))
        for i in 0u64 .. level_total {
            history_append_text(mut raw_bytes, config.levels[i])
            list.push(mut raw_bytes, if i + 1 == level_total {
                2u8
            } else {
                0u8
            })
        }
        Ok(take raw_bytes)
    })
}

fn history_encode_base_head(mut raw_bytes: Bytes, head: HistoryHead, authority: Bytes) -> Result[(), Error] {
    let needed = 240 + list.len(authority) + format.BINDING_BYTES
    if list.capacity(raw_bytes) < needed {
        return Error(Full(Allocation(Capacity(requested: needed, available: list.capacity(raw_bytes)))))
    }
    let ctx = format.DiskContext(store: store_key_to_rep(head.store), role: 7, seq: head.entry.seq)
    list.clear(mut raw_bytes)
    failure_result_from_rep(types.capacity(format.history_append_header(mut raw_bytes, ctx, head.pair.epoch, head.authority_kind)))?
    list.fill(mut raw_bytes, 16, 0u8)
    list.put_word_le(mut raw_bytes, head.pair.epoch)
    list.put_word_le(mut raw_bytes, head.pair.holder.hi)
    list.put_word_le(mut raw_bytes, head.pair.holder.lo)
    list.put_word_le(mut raw_bytes, head.activation)
    history_ref_encode(mut raw_bytes, head.entry)
    history_ref_encode(mut raw_bytes, head.checkpoint)
    list.put_word_le(mut raw_bytes, head.floor)
    for i in 0u64 .. 32 {
        list.push(mut raw_bytes, head.binding[i])
    }
    failure_result_from_rep(types.capacity(format.history_seal(mut raw_bytes, ctx, 72, 0x00A0)))?
    let at = list.len(raw_bytes)
    list.fill(mut raw_bytes, 16, 0u8)
    list.append(mut raw_bytes, authority)
    failure_result_from_rep(types.capacity(format.history_seal(mut raw_bytes, ctx, at, 0x00D0)))
}

fn history_encode_head(mut raw_bytes: Bytes, head: HistoryHead, authority: Bytes) -> Result[(), Error] {
    history_encode_base_head(mut raw_bytes, head, authority)?
    if let Some(o) = head.origin {
        history_origin_append(mut raw_bytes, format.DiskContext(store: store_key_to_rep(head.store), role: 7, seq: head.entry.seq), o)?
    }
    Ok(())
}

fn history_claim_origin(prior: Option[HistoryOrigin], epoch: u64, auth: ClaimAuth) -> Result[HistoryOrigin, Error] {
    if list.len(auth.attempt) != 16 {
        return Error(Missing("claim_auth"))
    }
    let mut attempt: Inline[u8, 16] =[0; 16]
    for i in 0u64 .. 16 {
        attempt[i] = auth.attempt[i]
    }
    match auth.class {
        Permit => Ok(HistoryOrigin(epoch, attempt, class: 0, permit_epoch: epoch, permit_attempt: attempt)),
        Continue => {
            let (pe, pa) = match prior {
                Some(prev) => (prev.permit_epoch, prev.permit_attempt),
                None => (0u64,[0u8; 16]),
            }
            Ok(HistoryOrigin(epoch, attempt, class: 1, permit_epoch: pe, permit_attempt: pa))
        },
        Adopt => {
            let (pe, pa) = match prior {
                Some(prev) => (prev.permit_epoch, prev.permit_attempt),
                None => (0u64,[0u8; 16]),
            }
            Ok(HistoryOrigin(epoch, attempt, class: 2, permit_epoch: pe, permit_attempt: pa))
        },
    }
}

fn history_claim_head(current: HistoryHead, holder: StoreId, auth: ClaimAuth) -> Result[HistoryHead, Error] {
    let epoch = history_next_id(current.pair.epoch)?
    let _ = history_next_id(current.entry.seq)?
    let origin = history_claim_origin(current.origin, epoch, auth)?
    let mut candidate = current
    candidate.pair = HistoryPair(epoch, holder)
    candidate.origin = Some(origin)
    Ok(candidate)
}

fn object_history_config(take place: std.object.Bucket, take single_name: String) -> HistoryConfig {
    let mut names: List[String] = list.with_capacity(1)
    list.push(mut names, take single_name)
    HistoryConfig(place: take place, levels: take names)
}

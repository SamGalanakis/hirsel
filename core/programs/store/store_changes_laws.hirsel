pub fn law_drop_recreate(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let old = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let saved = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, old, 1, 10) {
        return false
    }
    let held = snapshot(db)
    let sh = view saved
    result.unwrap(drop_table(mut db, take old))
    match get(snapshot(db), sh, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    if db.resident != 0 || typed_value(held, sh, 1) != 10 {
        return false
    }
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let newer = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if newer.id != 2 {
        return false
    }
    // K2 / runner p17 step4a: the old H's Table reads a recreated, empty
    // table. The result is Stale(1), never the old S1 result Ok(None).
    match get(snapshot(db), sh, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    let stale = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, saved, 1, 99)
    })
    match take stale {
        Ok(Aborted(Undone(value: Stale(1), ticket: None))) => {},
        _ => return false
    }
    if typed_value(snapshot(db), newer, 1) != 0 || typed_value(held, sh, 1) != 10 {
        return false
    }
    if !typed_put(mut db, newer, 1, 20) {
        return false
    }
    let second_saved = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let second_held = snapshot(db)
    let second_shape = view second_saved
    result.unwrap(drop_table(mut db, take newer))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let third = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if third.id != 3 {
        return false
    }
    match get(snapshot(db), second_shape, 1) {
        Error(Stale(2)) => {},
        _ => return false
    }
    let stale_second = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, second_saved, 1, 99)
    })
    match take stale_second {
        Ok(Aborted(Undone(value: Stale(2), ticket: None))) => {},
        _ => return false
    }
    typed_value(second_held, second_shape, 1) == 20 && typed_value(snapshot(db), third, 1) == 0
}

@test
fn test_drop_recreate(c: Clock) -> Result[(), ()] waits {
    if law_drop_recreate(c) {
        Ok(())
    } else {
        Error(())
    }
}

pub fn law_typed_resident(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    // Scalar schemas are 1 + 4 + 1 = 6 bytes each. Catalog size is
    // 17 + (4 + 6) + 2 + (2 + 8 + 4 + 6) + 2 + 4 + 4 = 59 bytes.
    // Key 1||"rows" is 5 bytes. The charge is r8(59) + r8(5) + 62 = 260.
    if db.resident != 260 {
        return false
    }
    db.ceiling = 354
    if !typed_put(mut db, t, 1, 10) || db.resident != 354 {
        return false
    }
    let out = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 2, 20)
    })
    match take out {
        Ok(Refused(Resident(f))) => if f.requested != 448 || f.available != 354 {
            return false
        },
        _ => return false
    }
    let removed = run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        delete(mut tx, t, 1)
    })
    match take removed {
        Ok(Committed(done)) => if !done.value {
            return false
        },
        _ => return false
    }
    db.resident == 260
}

@test
fn test_typed_resident(c: Clock) -> Result[(), ()] waits {
    if law_typed_resident(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn view_law_payload(length: u64, seed: u64) -> Bytes {
    let mut payload: Bytes = list.with_capacity(length)
    for i in 0u64 .. length {
        list.push(mut payload, int.truncate(splitmix64(seed + i)))
    }
    take payload
}

fn view_law_stored(payload: Bytes) -> Bytes {
    let mut raw: Bytes = list.with_capacity(6 + list.len(payload))
    list.put_word_le(mut raw, 0u16)
    let width: u32 = int.truncate(list.len(payload))
    list.put_word_le(mut raw, width)
    list.append(mut raw, payload)
    take raw
}

// L38: the first two keys share a page prefix. The third has a BlobRef.
// The final key and its inline value require a one-entry oversize leaf.
fn law_view_geometry(c: Clock, seed: u64) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("views", std.codec.key_bytes(), std.codec.of_bytes())))
    let t = result.unwrap(table(mut db, "views", std.codec.key_bytes(), std.codec.of_bytes()))
    let sh = view t
    let mut large_key: Bytes = list.with_capacity(4000)
    list.fill(mut large_key, 4000, 122u8)
    let first: Bytes = clone(string.as_bytes("prefix/a"))
    let second: Bytes = clone(string.as_bytes("prefix/b"))
    let third: Bytes = clone(string.as_bytes("prefix/c"))
    let keys =[take first, take second, take third, take large_key]
    let lengths =[31u64, 1018u64, 1019u64, 1018u64]
    let written = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        for i in 0u64 .. 4 {
            let payload = view_law_payload(lengths[i], seed + i)
            put(mut tx, t, keys[i], payload)?
            let Some(raw) = fetch_bytes(tx, sh, keys[i])? else {
                return Ok(false)
            }
            let Some(owned) = fetch(tx, sh, keys[i])? else {
                return Ok(false)
            }
            if raw != view_law_stored(payload) || owned != payload {
                return Ok(false)
            }
        }
        Ok(true)
    }))
    match take written {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    let held = snapshot(db)
    let mut values = result.unwrap(scan_bytes(held, sh, Unbounded, Unbounded))
    let mut typed = result.unwrap(scan(held, sh, Unbounded, Unbounded))
    for i in 0u64 .. 4 {
        let payload = view_law_payload(lengths[i], seed + i)
        let expected = view_law_stored(payload)
        let point = match get_bytes(held, sh, keys[i]) {
            Ok(Some(raw)) => raw == expected,
            _ => false,
        }
        let Some(owned) = result.unwrap(get(held, sh, keys[i])) else {
            return false
        }
        if !point || owned != payload {
            return false
        }
        // The only table has id 1. These keys contain no zero bytes to escape.
        let mut logical: Bytes = list.with_capacity(6 + list.len(keys[i]))
        list.put_word_be(mut logical, 1u32)
        list.append(mut logical, keys[i])
        list.put_word_le(mut logical, 0u16)
        if result.unwrap(next_view(mut values)) != Some(logical) || value_view(values) != expected || result.unwrap(next(mut typed)) != Some((clone(keys[i]), take payload)) {
            return false
        }
    }
    let reads = result.unwrap(look(held, None, fn(tx: Tx) -> Result[bool, Error] {
        for i in 0u64 .. 4 {
            let Some(raw) = fetch_bytes(tx, sh, keys[i])? else {
                return Ok(false)
            }
            if raw != view_law_stored(view_law_payload(lengths[i], seed + i)) {
                return Ok(false)
            }
        }
        Ok(true)
    }))
    match take reads {
        Seen(Seen(value: Ok(true), ..)) => {},
        _ => return false
    }
    let mut bounded = result.unwrap(scan_bytes(held, sh, Excluded(clone(keys[0])), Included(clone(keys[1]))))
    result.unwrap(next_view(mut bounded)) != None && value_view(bounded) == view_law_stored(view_law_payload(lengths[1], seed + 1)) && result.unwrap(next_view(mut bounded)) == None && result.unwrap(next_view(mut bounded)) == None && result.unwrap(next_view(mut values)) == None && result.unwrap(next(mut typed)) == None
}

pub fn law_typed_model(c: Clock) -> bool waits {
    for seed in 0u64 .. 2 {
        if !law_view_geometry(c, seed) {
            return false
        }
        let mut db = test_db(c, 1073741824)
        result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
        let mut t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
        result.unwrap(create_index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
        let _ = result.unwrap(index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
        let ix = result.unwrap(index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
        let sh = view t
        let mut model: List[u64] = list.with_capacity(24)
        list.fill(mut model, 24, 0u64)
        for step in 0u64 .. 64 {
            let wall = seed * 64 + step
            let model_state = splitmix64(wall)
            let k = model_state % 24
            let choice = (model_state >> 8) % 5
            let out = execute(mut db, 0, wall, None, fn(mut tx: Tx) -> Result[(u64, u64), Error] {
                let at = info(mut tx).at
                let state = splitmix64(at)
                let key = state % 24
                let action = (state >> 8) % 5
                if action == 0 {
                    let _ = delete(mut tx, t, key)?
                } else {
                    put(mut tx, t, key, at + 1)?
                    if option.unwrap(fetch(tx, t, key)?) != at + 1 {
                        return Error(Missing("law"))
                    }
                }
                let mut bucket_rows = range(tx, t, Excluded(4), Included(17))?
                let mut a: u64 = 0
                while let Some((_, v)) = next_range(mut bucket_rows)? {
                    a += v
                }
                let mut matches = lookup(tx, ix, Included(2), Included(2))?
                let mut b: u64 = 0
                while let Some((_, v)) = next_indexed(mut matches)? {
                    b += v
                }
                if action == 3 {
                    return Error(Foreign)
                }
                if action == 4 {
                    fail("typed model fault")
                }
                Ok((a, b))
            })
            match take out {
                Ok(Committed(done)) => {
                    if choice >= 3 {
                        return false
                    }
                    let _ = list.set(mut model, k, if choice == 0 {
                        0u64
                    } else {
                        wall + 1
                    })
                    let mut a: u64 = 0
                    let mut b: u64 = 0
                    for i in 0u64 .. 24 {
                        if i > 4 && i <= 17 {
                            a += model[i]
                        }
                        if model[i] % 4 == 2 {
                            b += model[i]
                        }
                    }
                    if done.value != (a, b) {
                        return false
                    }
                },
                Ok(Aborted(Undone(value: Foreign, ticket: None))) => if choice != 3 {
                    return false
                },
                Ok(Failed(_)) => if choice != 4 {
                    return false
                },
                _ => return false
            }
            let held = snapshot(db)
            for i in 0u64 .. 24 {
                if typed_value(held, sh, i) != model[i] {
                    return false
                }
            }
        }
    }
    true
}


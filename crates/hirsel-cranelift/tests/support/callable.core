; An own callable holds code/environment. The environment's first uncharged
; word names its row's fixed descriptor, which the alloc writes; one u64
; capture charges 8.
core v1
type t0 = own "Callable" { f: ownfn }
type t1 = own "Captures" { x: u64 }
sig g0 = (u64) -> (u64)
sig g1 = (ptr) -> (u64)
sig g2 = () -> (u64)
inst n0 = test@0/callable/run [] []
inst n1 = test@0/callable/invoke [] []
inst n2 = test@0/callable/empty [] []
fn f0 = n0 g0 {
  slot s0 = t0
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 0 byte v1 : ptr
  addr a2 = v3 byte v1 : u64
  addr a3 = s0 : t0
b0(v0: u64):
  live s0
  v1: u64 = const 8
  v2: u64 = const 16
  v3: ptr, v4: u64 = alloc env t1 v2 align 8 charge v1
  v5: ptr = fnref f1
  address a0
  address a1
  address a2
  address a3
  store a2, v0
  store a0, v5
  store a1, v3
  v6: u64 = call v5 g1 (v3)
  drop a3 t0
  dead s0
  return v6
}
fn f1 = n1 g1 {
  addr a0 = v0 byte v1 : u64
b0(v0: ptr):
  v1: u64 = const 8
  address a0
  v2: u64 = read a0
  return v2
}
fn f2 = n2 g2 {
  slot s0 = t0
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 0 byte v1 : ptr
  addr a2 = s0 : t0
b0:
  live s0
  v0: ptr = const 0x0
  v1: u64 = const 8
  address a0
  address a1
  address a2
  store a0, v0
  store a1, v0
  drop a2 t0
  dead s0
  v2: u64 = const 13
  return v2
}

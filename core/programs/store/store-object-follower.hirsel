type ObjectAuthorityConfig {
    client: std.object.Client,
    level_name: String,
    op_ms: u64,
    sim: Option[(List[String], LevelSync)],
    // The host stream slot whose writer opens attach (§12.11.1 `streamed`).
    stream: Option[JournalSlot],
    // Read-only stream root from `stream_reader` (§12.11.1, §12.11.9).
    stream_root: Option[String],
    cache: Option[pager.ObjectsCache]
}

pub fn object_authority(take c: std.object.Client, level_name: String, op_ms: u64) -> Authority {
    ObjectAuthority(ObjectAuthorityConfig(client: take c, level_name: string.from(level_name), op_ms, sim: None, stream: None, stream_root: None, cache: None))
}

pub fn sim_authority(take c: std.object.Client, declared: SimLevels, take sync: LevelSync, op_ms: u64) -> Authority {
    SimAuthority(ObjectAuthorityConfig(client: take c, level_name: string.from(declared.strongest), op_ms, sim: Some((clone(declared.weak), take sync)), stream: None, stream_root: None, cache: None))
}

pub type Claim: codec + key + shareable + cross {
    epoch: u64,
    holder: Bytes
}

pub type ClaimClass: codec + key + shareable + cross = Permit | Continue | Adopt

pub type ClaimAuth: codec + key + shareable + cross {
    expect: Option[Claim],
    attempt: Bytes,
    class: ClaimClass
}

pub type Origin: codec + key + shareable + cross {
    epoch: u64,
    attempt: Bytes,
    class: ClaimClass,
    permit_epoch: u64,
    permit_attempt: Bytes
}

pub type HeadSettlement: codec + key + shareable + cross = HeadOpen | HeadWon(u64) | HeadDead(Claim)

pub type HeadView {
    store: StoreId,
    activation: u64,
    binding: Bytes,
    claim: Claim,
    origin: Option[Origin]
}

fn claim_from_pair(pair: history.HistoryPair) -> Result[Claim, Error] {
    disk_allocation(scoped fn() -> Result[Claim, Error] {
        let mut owner: Bytes = list.with_capacity(16)
        list.put_word_le(mut owner, pair.holder.hi)
        list.put_word_le(mut owner, pair.holder.lo)
        Ok(Claim(epoch: pair.epoch, holder: take owner))
    })
}

fn claim_class_from_tag(tag: u8) -> ClaimClass {
    match tag {
        0 => Permit,
        1 => Continue,
        _ => Adopt,
    }
}

fn origin_from_history(o: history.HistoryOrigin) -> Result[Origin, Error] {
    disk_allocation(scoped fn() -> Result[Origin, Error] {
        let mut attempt: Bytes = list.with_capacity(16)
        let _ = bytebuf.append_inline(mut attempt, o.attempt, 0, 16)
        let mut permit_attempt: Bytes = list.with_capacity(16)
        let _ = bytebuf.append_inline(mut permit_attempt, o.permit_attempt, 0, 16)
        Ok(Origin(epoch: o.epoch, attempt: take attempt, class: claim_class_from_tag(o.class), permit_epoch: o.permit_epoch, permit_attempt: take permit_attempt))
    })
}

fn history_head_view(current: history.HistoryHead) -> Result[HeadView, Error] {
    let claim = claim_from_pair(current.pair)?
    let origin = match current.origin {
        Some(o) => Some(origin_from_history(o)?),
        None => None,
    }
    disk_allocation(scoped fn() -> Result[HeadView, Error] {
        let mut opaque_binding: Bytes = list.with_capacity(32)
        let _ = bytebuf.append_inline(mut opaque_binding, current.binding, 0, 32)
        Ok(HeadView(store: store_key_from_rep(current.store), activation: current.activation, binding: take opaque_binding, claim: clone(claim), origin: clone(origin)))
    })
}

pub fn follower_head(f: Follower) -> Result[HeadView, Error] {
    let Some(record) = f.capture.remote else {
        return Error(Missing("head"))
    }
    history_head_view(record.current)
}

// One-GET read-only head inspection for move/claim settlement (STORE-SPEC
// §12.3): fetches `head` once, verifies namespace and optional expected store,
// and returns its `HeadView` including `ORIGIN`. Performs zero writes and
// never opens a writer or reads tails.
pub fn head_view(mut client: std.object.Client, expect: Option[StoreId], op_ms: u64) -> Result[HeadView, Error] waits {
    let deadline = std.object.deadline_after_ms(client, op_ms)
    let mut scratch = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(history.HISTORY_HEAD_LIMIT))
    })?
    let outcome = failure_result_from_rep(history.history_fetch(mut client, "head", mut scratch, deadline))
    match take outcome {
        Ok(_) => (),
        Error(Remote(NotFound)) => return Error(NotFound),
        Error(take problem) => return Error(take problem),
    }
    let (take capture, _) = failure_result_from_rep(history.history_decode_head_attach(scratch))?
    failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(expect), capture.head.store))?
    failure_result_from_rep(history.history_check_namespace(capture, client))?
    history_head_view(capture.head)
}

// Settles an outstanding Fleet `Permit` (STORE-SPEC §12.3 "Settlement")
// from one fresh GET of `store`'s head through the caller's trusted client.
// `predecessor` is the pair the Permit named and `attempt` its unique id.
// Open: the head still names `predecessor`, so the H may yet apply and the
// permit stays outstanding. Won(e): `ORIGIN.permit_attempt` is `attempt` and
// the permit installed exactly `predecessor.epoch + 1`, a receipt that
// survives the winner's later Continue/Adopt claims; it describes a
// historical claim and confers no present writer authority. Dead names the
// current pair. A foreign Store, another namespace, or a head older than or
// beside `predecessor` is an error and closes nothing. Writes nothing.
pub fn settle_permit(mut client: std.object.Client, store: StoreId, predecessor: Claim, attempt: Bytes, op_ms: u64) -> Result[HeadSettlement, Error] waits {
    let observed = head_view(mut client, Some(store), op_ms)?
    history_settle(observed, predecessor, attempt)
}

fn history_settle(head: HeadView, predecessor: Claim, attempt: Bytes) -> Result[HeadSettlement, Error] {
    if head.claim.epoch == predecessor.epoch && head.claim.holder == predecessor.holder {
        return Ok(HeadOpen)
    }
    if head.claim.epoch <= predecessor.epoch {
        return Error(failure_from_rep(format.disk_fault("head", 72, Regressed)))
    }
    if let Some(o) = head.origin {
        if o.permit_epoch == predecessor.epoch + 1 && o.permit_attempt == attempt {
            return Ok(HeadWon(o.permit_epoch))
        }
    }
    Ok(HeadDead(clone(head.claim)))
}

fn object_follow_replay(mut source: history.ObjectPackRead, latest: history.HistoryHead, previous: Option[Arc[object_writer.FollowCapture]], ceiling: u64) -> Result[pager.JournalReplay, Error] waits {
    if let Some(old_capture) = previous {
        let Some(old) = view old_capture.remote else {
            fail("object follower missing remote head")
        }
        if latest.checkpoint.seq <= old.current.entry.seq {
            let state = failure_result_from_rep(host_stream.copy_follow_state(old_capture.state))?
            let initial = failure_result_from_rep(pager.journal_replay(take state, old.next_node, limits_to_rep(default_limits())))?
            failure_result_from_rep(catalog.over_ceiling(failure_result_from_rep(journal.journal_account(initial))?, ceiling))?
            return history_rebase_suffix(mut source, latest, old.current.entry, take initial, ceiling)
        }
    }
    history_paged_capture(mut source, latest, ceiling)
}

fn object_follow_capture(mut source: history.ObjectPackRead, previous: Option[Arc[object_writer.FollowCapture]], expected: Option[StoreId], ceiling: u64, require_fresh: bool) -> Result[Option[Arc[object_writer.FollowCapture]], Error] waits {
    if let Some(_) = source.stream_root {
        return stream_follow_capture(mut source, previous, expected, ceiling, require_fresh)
    }
    let mut scratch = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(history.HISTORY_HEAD_LIMIT))
    })?
    let fetched = failure_result_from_rep(object_writer.object_follow_head(mut source, previous, mut scratch))?
    let Some((take head_capture, tag)) = take fetched else {
        return Ok(None)
    }
    let latest = head_capture.head
    failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(expected), latest.store))?
    let old_charge = if let Some(old_capture) = previous {
        let Some(old) = view old_capture.remote else {
            fail("object follower missing remote head")
        }
        if latest.floor < old.current.floor || latest.entry.seq < old.current.entry.seq {
            return Error(failure_from_rep(format.disk_fault("head", 72, Order)))
        }
        if history.history_ref_matches(latest.entry, old.current.entry) {
            return disk_allocation(scoped fn() -> Result[Option[Arc[object_writer.FollowCapture]], Error] {
                Ok(Some(arc.new(object_writer.FollowCapture(store: latest.store, state: arc.share(old_capture.state), resident: old_capture.resident, remote: Some(host_stream.ObjectFollowHead(current: latest, tag, next_node: old.next_node, attach: None, head_bytes: list.new(), live_next_seq: 0)), log_id: 0, watermark: old_capture.watermark))))
            })
        }
        old_capture.resident
    } else {
        0u64
    }
    let recovered = object_follow_replay(mut source, latest, previous, ceiling - old_charge)
    let replay = match take recovered {
        Ok(take ready) => take ready,
        Error(Full(Resident(cap))) => return Error(Full(Resident(Capacity(requested: int.saturating_add(old_charge, cap.requested), available: ceiling)))),
        Error(HistoryMissing(take file, missing_seq)) => {
            let witness = failure_result_from_rep(history.history_witness(mut source.client, latest, None, file, missing_seq, mut scratch, source.deadline))?
            if let HistoryEvicted(newer) = witness {
                return Error(Reclaimed(newer.head.floor))
            }
            if let Some(old_capture) = previous {
                return Error(Behind(Position(store: store_key_from_rep(old_capture.store), branch: 0, version: old_capture.state.tips[0].head)))
            }
            return Error(Remote(Retriable(Deadline)))
        },
        Error(take problem) => return Error(take problem),
    }
    let resident = failure_result_from_rep(journal.journal_account(replay))?
    let pager.JournalReplay(state: take built, next_node, ..) = take replay
    let remote = host_stream.ObjectFollowHead(current: latest, tag, next_node, attach: None, head_bytes: list.new(), live_next_seq: 0)
    Ok(Some(failure_result_from_rep(object_writer.follow_capture(store_key_to_rep(store_key_from_rep(latest.store)), take built, resident, Some(remote), 0, failure_result_from_rep(catalog.stamp_after(next_node))?))?))
}

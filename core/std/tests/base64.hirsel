// test-env: HIRSEL_ISA_CAP=2
fn vector(raw: Bytes, coded: Bytes) -> bool {
    let mut out: Bytes = list.new()
    base64.encode(raw, mut out)
    let encoded: String = base64.encode_string(raw)
    out == coded && string.as_bytes(encoded) == coded && match base64.decode(coded) {
        Some(b) => b == raw,
        None => false
    }
}

// RFC 4648 section 10. Mutant: pad_wrong writes A instead of '='.
// expect: run rfc4648() = true
fn rfc4648() -> bool {
    vector(b"", b"") && vector(b"f", b"Zg==") && vector(b"fo", b"Zm8=") && vector(b"foo", b"Zm9v") && vector(b"foob", b"Zm9vYg==") && vector(b"fooba", b"Zm9vYmE=") && vector(b"foobar", b"Zm9vYmFy")
}

// RFC 4648 sections 3.2, 3.3 and 3.5. Mutant: skip pad-bit validation.
// expect: run canonical() = true
fn canonical() -> bool {
    base64.decode(b"Zh==") == None && base64.decode(b"Zm9=") == None && base64.decode(b"Zg") == None && base64.decode(b"Z g=") == None && base64.decode(b"====") == None && base64.decode(b"Zg==AAAA") == None
}

// RFC 4648 alphabet on a vector long enough to fill several output words.
// A wrong carry between the second and third words changes the decoded bytes.
// expect: run word_boundaries() = true
fn word_boundaries() -> bool {
    let raw = b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ>??>>>!"
    let coded = b"MDEyMzQ1Njc4OUFCQ0RFRkdISUpLTE1OT1BRUlNUVVZXWFlaPj8/Pj4+IQ=="
    let mut out = b"prefix:"
    base64.encode(raw, mut out)
    out == b"prefix:MDEyMzQ1Njc4OUFCQ0RFRkdISUpLTE1OT1BRUlNUVVZXWFlaPj8/Pj4+IQ==" && base64.decode(coded) == Some(raw) && base64.decode(b"/DEyMzQ@Njc4OUFCQ0RFRkdISUpLTE1OT1BRUlNUVVZXWFlaPj8/Pj4+IQ==") == None
}

// RFC 4648's arithmetic alphabet is independent of the vector offset tables.
fn reference_digit(digit: u8) -> u8 {
    if digit < 26 {
        return b'A' + digit
    }
    if digit < 52 {
        return b'a' + (digit - 26)
    }
    if digit < 62 {
        return b'0' + (digit - 52)
    }
    if digit == 62 {
        b'+'
    } else {
        b'/'
    }
}

fn reference_base64(raw: Bytes) -> Bytes {
    let n = list.len(raw)
    let mut out: Bytes = list.new()
    let mut at: u64 = 0
    while at < n {
        let left = n - at
        let a: u32 = int.widen(raw[at])
        let b: u32 = if left > 1 {
            int.widen(raw[at + 1])
        } else {
            0
        }
        let c: u32 = if left > 2 {
            int.widen(raw[at + 2])
        } else {
            0
        }
        let word = (a << 16) | (b << 8) | c
        list.push(mut out, reference_digit(int.truncate(word >> 18)))
        list.push(mut out, reference_digit(int.truncate((word >> 12) & 63)))
        list.push(mut out, if left > 1 {
            reference_digit(int.truncate((word >> 6) & 63))
        } else {
            b'='
        })
        list.push(mut out, if left > 2 {
            reference_digit(int.truncate(word & 63))
        } else {
            b'='
        })
        at += 3
    }
    take out
}

// Lengths straddle the input lookahead, vector output boundaries and both pads.
// A high byte or punctuation in any block must still refuse before allocation.
// expect: run vector_blocks_match_rfc4648() = true
fn vector_blocks_match_rfc4648() -> bool {
    let mut random: u64 = 0x5281f625bd4c3315
    for n in 0u64 .. 130u64 {
        let mut raw: Bytes = list.with_capacity(n)
        for _ in 0u64 .. n {
            random ^= random << 13
            random ^= random >> 7
            random ^= random << 17
            list.push(mut raw, int.truncate(random))
        }
        let mut coded = reference_base64(raw)
        if !vector(raw, coded) {
            return false
        }
        if n != 0 {
            let position = random % list.len(coded)
            coded[position] = if random & 1 == 0 {
                255
            } else {
                b'%'
            }
            let refused = bound bytes 0 {
                base64.decode(coded) == None
            }
            match refused {
                Ok(true) => (),
                _ => return false,
            }
        }
    }
    true
}

// Source: Rust base64 src/engine/tests.rs, decode_detect_1_valid_symbol_in_last_quad_invalid_length,
// decode_padding_starts_before_final_chunk_error_invalid_byte_at_first_pad, and
// decode_too_little_data_before_padding_error_invalid_byte, 0695a61d83f568f4892ac3036001925a9b5c375b, MIT.
// The existing canonical cases already check forbidden characters and tail bits.
// expect: run rust_base64_rejects_bad_quanta() = true
fn rust_base64_rejects_bad_quanta() -> bool {
    let cases: Inline[String, 6] =["A", "AAAAA", "A===", "ABCDA===", "AAAAAAAAAAAAAAAAAAAAAAAAAAAA====", "AAAAAAAAAAAAAAAAAAAAAAAAAAA=====",]
    for input in cases {
        let refused = bound bytes 0 {
            base64.decode(string.as_bytes(input)) == None
        }
        match refused {
            Ok(true) => (),
            _ => return false,
        }
    }
    true
}

// A refused output buffer raises Capacity, and a tight step bound stops encoding
// cleanly on long input.
// expect: run encode_capacity_and_steps() = true
fn encode_capacity_and_steps() -> bool {
    let mut raw: Bytes = list.with_capacity(256)
    for i in 0u64 .. 256 {
        list.push(mut raw, int.truncate(i * 17 + 3))
    }
    let cap_refused = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 0 {
            let mut out: Bytes = list.new()
            base64.encode(raw, mut out)
            list.len(out)
        }
    })
    let ok_cap = match caught(take cap_refused) {
        Some(_) => true,
        None => false,
    }
    let tight = bound steps 1 {
        base64.encode_string(raw)
    }
    let ok_steps = match tight {
        Error(_) => true,
        Ok(_) => false,
    }
    ok_cap && ok_steps
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

type Choice {
    value: u64,
    limit: u64
}

type Span {
    label: u64,
    start: u64,
    end: u64,
    parent: Option[u64]
}

pub opaque type Source {
    pcg: rand.Pcg,
    prefix: Option[List[u64]],
    tape: List[Choice],
    spans: List[Span],
    parent: Option[u64],
    max_choices: u64,
    overrun: bool,
    invalid: bool,
    enumerating: bool,
    rendering: bool,
    rendered: Option[String]
}

pub type Gen[T] {
    draw: own fn(mut Source) -> T,
    show: own fn(T, mut String)
}

pub fn make[T](take draw_fn: own fn(mut Source) -> T, take show_fn: own fn(T, mut String)) -> Gen[T] {
    Gen(draw: take draw_fn, show: take show_fn)
}

pub fn draw[T](mut s: Source, g: Gen[T]) -> T {
    if !s.rendering {
        return (g.draw)(mut s)
    }
    // A custom generator owns the presentation of its final value.
    s.rendering = false
    let value = (g.draw)(mut s)
    s.rendering = true
    take value
}

fn source(seed: u64, index: u64, max_choices: u64, prefix: Option[List[u64]]) -> Source {
    let replay_prefix: Option[List[u64]] = clone(prefix)
    Source(pcg: rand.new(seed, index), prefix: take replay_prefix, tape: list.new(), spans: list.new(), parent: None, max_choices, overrun: false, invalid: false, enumerating: false, rendering: false, rendered: None)
}

fn stop_enumeration(take reason: String) -> Never {
    fail(take reason)
}

// After a discard, return zero without advancing either input stream.
fn ready(mut s: Source) -> bool {
    if s.overrun || s.invalid {
        return false
    }
    let i = list.len(s.tape)
    if s.enumerating {
        if i >= s.max_choices {
            stop_enumeration("")
        }
        return true
    }
    let past_prefix = match s.prefix {
        Some(values) => i >= list.len(values),
        None => false,
    }
    s.overrun = i >= s.max_choices || past_prefix
    !s.overrun
}

fn replay_choice(s: Source, limit: u64) -> Option[u64] {
    if let Some(values) = s.prefix {
        let i = list.len(s.tape)
        if s.enumerating && i >= list.len(values) {
            return Some(0)
        }
        let value = values[i]
        return Some(if limit == 0 || value < limit {
            value
        } else {
            0
        })
    }
    None
}

fn record(mut s: Source, value: u64, limit: u64) -> u64 {
    list.push(mut s.tape, Choice(value, limit))
    value
}

pub fn below(mut s: Source, n: u64) -> u64 {
    if !ready(mut s) {
        return 0
    }
    if n == 0 {
        let _ = string.as_bytes("")[0]
    }
    if let Some(value) = replay_choice(s, n) {
        return record(mut s, value, n)
    }
    let limit = if rand.below(mut s.pcg, 4) == 0 {
        order.min(n, 16)
    } else {
        n
    }
    let value = rand.below(mut s.pcg, limit)
    record(mut s, value, n)
}

pub fn word(mut s: Source) -> u64 {
    if !ready(mut s) {
        return 0
    }
    if s.enumerating {
        let mut at = string.new()
        string.push_u64(mut at, list.len(s.tape))
        stop_enumeration(take at)
    }
    let value = match replay_choice(s, 0) {
        Some(value) => value,
        None => rand.next(mut s.pcg),
    }
    record(mut s, value, 0)
}

pub fn weighted(mut s: Source, k: u64, n: u64) -> bool {
    if !ready(mut s) {
        return false
    }
    if n == 0 || k > n {
        let _ = string.as_bytes("")[0]
    }
    let value = match replay_choice(s, 2) {
        Some(value) => value,
        None => if rand.below(mut s.pcg, n) < k {
            1
        } else {
            0
        },
    }
    record(mut s, value, 2) != 0
}

pub fn span[T](mut s: Source, label: u64, body: scoped fn(mut Source) -> T) -> T {
    if s.invalid || s.overrun {
        return body(mut s)
    }
    let i = list.len(s.spans)
    let start = list.len(s.tape)
    let parent = s.parent
    list.push(mut s.spans, Span(label, start, end: start, parent))
    s.parent = Some(i)
    let value = body(mut s)
    s.parent = parent
    s.spans[i].end = list.len(s.tape)
    take value
}

pub fn reject(mut s: Source) {
    s.invalid = true
}

fn require_range(ok: bool) {
    if !ok {
        let _ = string.as_bytes("")[0]
    }
}

fn inclusive(mut s: Source, distance: u64) -> u64 {
    if distance == 18446744073709551615 {
        word(mut s)
    } else {
        below(mut s, distance + 1)
    }
}

fn show_unsigned(value: u64, mut out: String) {
    string.push_u64(mut out, value)
}

fn show_signed(value: i64, mut out: String) {
    string.push_i64(mut out, value)
}

pub fn bool_() -> Gen[bool] {
    make(fn(mut s: Source) -> bool {
        below(mut s, 2) != 0
    }, fn(value: bool, mut out: String) {
        string.push(mut out, if value {
            "true"
        } else {
            "false"
        })
    })
}

pub fn u64_in(lo: u64, hi: u64) -> Gen[u64] {
    require_range(lo <= hi)
    let distance = hi - lo
    make(fn(mut s: Source) -> u64 {
        lo + inclusive(mut s, distance)
    }, show_unsigned)
}

const SIGN_BIT: u64 = 0x8000000000000000

const SIGNED_MIN: i64 = -9223372036854775808

fn signed_rank(x: i64) -> u64 {
    if x < 0 {
        int.narrow(x - SIGNED_MIN)
    } else {
        let n: u64 = int.narrow(x)
        SIGN_BIT + n
    }
}

fn signed_value(rank: u64) -> i64 {
    if rank < SIGN_BIT {
        let n: i64 = int.narrow(rank)
        SIGNED_MIN + n
    } else {
        int.narrow(rank - SIGN_BIT)
    }
}

fn zigzag(index: u64, origin: u64, left: u64, right: u64) -> u64 {
    let both = order.min(left, right)
    if index > both * 2 {
        if right > left {
            origin + (index - both)
        } else {
            origin - (index - both)
        }
    } else if index % 2 == 0 {
        origin - index / 2
    } else {
        origin + index / 2 + 1
    }
}

pub fn i64_in(lo: i64, hi: i64) -> Gen[i64] {
    require_range(lo <= hi)
    let first = signed_rank(lo)
    let last = signed_rank(hi)
    let origin = order.max(first, order.min(SIGN_BIT, last))
    make(fn(mut s: Source) -> i64 {
        let index = inclusive(mut s, last - first)
        signed_value(zigzag(index, origin, origin - first, last - origin))
    }, show_signed)
}

pub fn u8_any() -> Gen[u8] {
    make(fn(mut s: Source) -> u8 {
        int.narrow(below(mut s, 256))
    }, fn(value: u8, mut out: String) {
        string.push_u64(mut out, int.widen(value))
    })
}

fn scalar_rank(c: char) -> u64 {
    let code: u64 = int.widen(char.to_u32(c))
    if code >= 0xe000 {
        code - 0x800
    } else {
        code
    }
}

fn push_escaped(mut out: String, c: char, quote: char) {
    if c == quote || c == '\\' {
        string.push_char(mut out, '\\')
        string.push_char(mut out, c)
    } else if char.to_u32(c) < 32 || char.to_u32(c) == 127 {
        string.push(mut out, "\\u{")
        string.push_uint(mut out, int.widen(char.to_u32(c)), 16, 0, '0')
        string.push_char(mut out, '}')
    } else {
        string.push_char(mut out, c)
    }
}

fn show_char(c: char, mut out: String) {
    string.push_char(mut out, '\'')
    push_escaped(mut out, c, '\'')
    string.push_char(mut out, '\'')
}

pub fn char_in(lo: char, hi: char) -> Gen[char] {
    let first = scalar_rank(lo)
    let last = scalar_rank(hi)
    require_range(first <= last)
    make(fn(mut s: Source) -> char {
        let rank = first + below(mut s, last - first + 1)
        let code = if rank >= 0xd800 {
            rank + 0x800
        } else {
            rank
        }
        option.unwrap(char.from_u32(int.narrow(code)))
    }, show_char)
}

pub fn ascii() -> Gen[char] {
    char_in(' ', '~')
}

fn display[T](value: T, mut out: String) {
    string.push(mut out, "<generated>")
}

fn show_part[T](mut s: Source, g: Gen[T], mut out: String) -> T {
    let value = (g.draw)(mut s)
    if s.rendering {
        let saved = replace(mut s.rendered, None)
        match take saved {
            Some(text) => string.push(mut out, text),
            None => (g.show)(value, mut out),
        }
    }
    take value
}

fn show_open(s: Source, mut out: String, text: String) {
    if s.rendering {
        string.push(mut out, text)
    }
}

fn show_close(mut s: Source, take text: String, close: String) {
    if s.rendering {
        let mut rendered = take text
        string.push(mut rendered, close)
        s.rendered = Some(take rendered)
    }
}

pub fn list_of[T](take g: Gen[T], min: u64, max: u64) -> Gen[List[T]] {
    require_range(min <= max)
    make(fn(mut s: Source) -> List[T] {
        let mut values: List[T] = list.new()
        let mut text = string.new()
        show_open(s, mut text, "[")
        for i in 0u64 .. max {
            let element = span(mut s, 1, fn(mut src: Source) -> Option[T] {
                if i >= min && !weighted(mut src, 7, 8) {
                    return None
                }
                if i != 0 {
                    show_open(src, mut text, ", ")
                }
                Some(show_part(mut src, g, mut text))
            })
            match take element {
                Some(take v) => list.push(mut values, take v),
                None => break,
            }
            if s.invalid || s.overrun {
                break
            }
        }
        show_close(mut s, take text, "]")
        take values
    }, display)
}

pub fn bytes_of(min: u64, max: u64) -> Gen[Bytes] {
    list_of(u8_any(), min, max)
}

fn collect_chars(chars: List[char]) -> String {
    let mut out = string.new()
    for c in chars {
        string.push_char(mut out, c)
    }
    take out
}

fn show_string(value: String, mut out: String) {
    string.push_char(mut out, '"')
    let mut at: u64 = 0
    while let Some((c, next)) = string.next_scalar(value, at) {
        push_escaped(mut out, c, '"')
        at = next
    }
    string.push_char(mut out, '"')
}

pub fn string_of(take chars: Gen[char], min: u64, max: u64) -> Gen[String] {
    map_shown(list_of(take chars, min, max), collect_chars, show_string)
}

pub fn option_of[T](take g: Gen[T]) -> Gen[Option[T]] {
    make(fn(mut s: Source) -> Option[T] {
        let mut text = string.new()
        if below(mut s, 2) == 0 {
            show_close(mut s, take text, "None")
            return None
        }
        show_open(s, mut text, "Some(")
        let value = span(mut s, 2, fn(mut src: Source) -> T {
            show_part(mut src, g, mut text)
        })
        show_close(mut s, take text, ")")
        Some(take value)
    }, display)
}

pub fn one_of[T](take gs: List[Gen[T]]) -> Gen[T] {
    require_range(list.len(gs) != 0)
    make(fn(mut s: Source) -> T {
        let i = below(mut s, list.len(gs))
        let mut text = string.new()
        let value = span(mut s, 3, fn(mut src: Source) -> T {
            show_part(mut src, gs[i], mut text)
        })
        show_close(mut s, take text, "")
        take value
    }, display)
}

pub fn pair[A, B](take a: Gen[A], take b: Gen[B]) -> Gen[(A, B)] {
    make(fn(mut s: Source) -> (A, B) {
        let mut text = string.new()
        show_open(s, mut text, "(")
        let first = span(mut s, 4, fn(mut src: Source) -> A {
            show_part(mut src, a, mut text)
        })
        show_open(s, mut text, ", ")
        let second = span(mut s, 4, fn(mut src: Source) -> B {
            show_part(mut src, b, mut text)
        })
        show_close(mut s, take text, ")")
        (take first, take second)
    }, display)
}

pub fn triple[A, B, C](take a: Gen[A], take b: Gen[B], take c: Gen[C]) -> Gen[(A, B, C)] {
    make(fn(mut s: Source) -> (A, B, C) {
        let mut text = string.new()
        show_open(s, mut text, "(")
        let first = span(mut s, 4, fn(mut src: Source) -> A {
            show_part(mut src, a, mut text)
        })
        show_open(s, mut text, ", ")
        let second = span(mut s, 4, fn(mut src: Source) -> B {
            show_part(mut src, b, mut text)
        })
        show_open(s, mut text, ", ")
        let third = span(mut s, 4, fn(mut src: Source) -> C {
            show_part(mut src, c, mut text)
        })
        show_close(mut s, take text, ")")
        (take first, take second, take third)
    }, display)
}

pub fn just[T: plain + inert](value: T) -> Gen[T] {
    make(fn(mut s: Source) -> T {
        value
    }, display)
}

pub fn map[A, B](take g: Gen[A], take transform: own fn(A) -> B) -> Gen[B] {
    make(fn(mut s: Source) -> B {
        let mut text = string.new()
        show_open(s, mut text, "map(")
        let value = show_part(mut s, g, mut text)
        let mapped = transform(value)
        show_close(mut s, take text, ")")
        take mapped
    }, display)
}

pub fn map_shown[A, B](take g: Gen[A], take transform: own fn(A) -> B, take show_fn: own fn(B, mut String)) -> Gen[B] {
    make(fn(mut s: Source) -> B {
        transform(draw(mut s, g))
    }, take show_fn)
}

pub fn bind[A, B](take g: Gen[A], take next_gen: own fn(A) -> Gen[B]) -> Gen[B] {
    make(fn(mut s: Source) -> B {
        let first = draw(mut s, g)
        let next = next_gen(first)
        let mut text = string.new()
        let value = span(mut s, 5, fn(mut src: Source) -> B {
            show_part(mut src, next, mut text)
        })
        show_close(mut s, take text, "")
        take value
    }, display)
}

pub fn filter[T](take g: Gen[T], take pred: own fn(T) -> bool) -> Gen[T] {
    make(fn(mut s: Source) -> T {
        let mut attempts: u64 = 0
        loop {
            let mut text = string.new()
            let value = span(mut s, 6, fn(mut src: Source) -> T {
                show_part(mut src, g, mut text)
            })
            if pred(value) {
                show_close(mut s, take text, "")
                break take value
            }
            attempts += 1
            if attempts == 3 || s.enumerating {
                reject(mut s)
                break take value
            }
        }
    }, display)
}

pub type Config {
    seed: u64,
    cases: u64,
    max_choices: u64,
    max_rejects: u64,
    max_shrinks: u64,
    gen_steps: u64,
    case_steps: u64,
    case_bytes: u64,
    sim_seed: Option[u64],
    replay: Option[String]
}

pub fn config() -> Config {
    Config(seed: 0, cases: 100, max_choices: 4096, max_rejects: 1000, max_shrinks: 1000, gen_steps: 1000000, case_steps: 10000000, case_bytes: 262144, sim_seed: None, replay: None)
}

/// Returns `cond`. The law observer counts true calls under `label`.
pub fn sometimes(label: String, cond: bool) -> bool {
    cond
}

pub fn replay(take c: Config, text: String) -> Config {
    let mut next = take c
    next.replay = Some(string.from(text))
    take next
}

pub type Outcome = Passed(u64) | GaveUp(u64, u64) | Falsified(Found)

pub type AllOutcome = Held(u64, u64) | Truncated(u64, u64) | Unbounded(u64) | Falsified(Found)

type AllTrial[T] = Trial(T, Source) | TrialTruncated | WordAt(u64)

pub opaque type Found {
    index: u64,
    tape: List[Choice],
    cases: u64,
    shrinks: u64,
    sim_seed: Option[u64],
    rendered: String,
    message: String,
    class: FailureClass
}

type Replay {
    index: u64,
    values: List[u64]
}

fn put_uleb(mut data: Bytes, n: u64) {
    let mut left = n
    while left >= 128 {
        list.push(mut data, int.narrow((left & 127) | 128))
        left >>= 7
    }
    list.push(mut data, int.narrow(left))
}

fn read_uleb(data: Bytes, mut at: u64) -> Option[u64] {
    let mut n: u64 = 0
    for i in 0u64 .. 10 {
        if at >= list.len(data) {
            return None
        }
        let byte = data[at]
        at += 1
        if i == 9 && byte > 1 {
            return None
        }
        let chunk: u64 = int.widen(byte & 127)
        n |= chunk << (i * 7)
        if byte < 128 {
            return if i != 0 && byte == 0 {
                None
            } else {
                Some(n)
            }
        }
    }
    None
}

fn bad_token() -> Never {
    fail("prop: config: bad replay token")
}

fn parse_token(text: String, max_choices: u64) -> Replay {
    let data = match base64.decode(string.as_bytes(text)) {
        Some(take value) => take value,
        None => bad_token(),
    }
    if list.len(data) == 0 || data[0] != 1 {
        bad_token()
    }
    let mut at: u64 = 1
    let index = match read_uleb(data, mut at) {
        Some(n) => n,
        None => bad_token(),
    }
    let count = match read_uleb(data, mut at) {
        Some(n) => n,
        None => bad_token(),
    }
    if count > max_choices || count > list.len(data) - at {
        bad_token()
    }
    let mut values: List[u64] = list.with_capacity(count)
    for _ in 0u64 .. count {
        match read_uleb(data, mut at) {
            Some(n) => list.push(mut values, n),
            None => bad_token(),
        }
    }
    if at != list.len(data) {
        bad_token()
    }
    Replay(index, values: take values)
}

pub fn token(f: Found, mut out: String) {
    let mut data: Bytes = list.new()
    list.push(mut data, 1u8)
    put_uleb(mut data, f.index)
    put_uleb(mut data, list.len(f.tape))
    for choice in f.tape {
        put_uleb(mut data, choice.value)
    }
    string.push(mut out, base64.encode_string(data))
}

fn push_excerpt(mut out: String, text: String) {
    if string.byte_len(text) <= 1024 {
        string.push(mut out, text)
        return
    }
    let data = string.as_bytes(text)
    let mut end: u64 = 1021
    while data[end] & 0xc0 == 0x80 {
        end -= 1
    }
    string.push(mut out, string.slice(text, 0, end))
    string.push(mut out, "…")
}

fn excerpt(text: String) -> String {
    let mut out = string.new()
    push_excerpt(mut out, text)
    take out
}

pub fn report(f: Found, mut out: String) {
    string.push(mut out, "prop: falsified: ")
    if let Some(seed) = f.sim_seed {
        string.push(mut out, "sim seed ")
        string.push_u64(mut out, seed)
        string.push(mut out, "; ")
    }
    string.push(mut out, "reproduce: prop.replay(cfg, \"")
    token(f, mut out)
    string.push(mut out, "\"); after ")
    string.push_u64(mut out, f.cases)
    string.push(mut out, " cases, ")
    string.push_u64(mut out, f.shrinks)
    string.push(mut out, " shrinks: ")
    string.push(mut out, f.rendered)
    string.push(mut out, "; law: ")
    string.push(mut out, f.message)
}

fn config_bytes(requested: u64) -> Never {
    let mut text = string.from("prop: config: case_bytes ")
    string.push_u64(mut text, requested)
    string.push(mut text, " refused")
    fail(take text)
}

fn generation_failed(index: u64) -> Never {
    let mut text = string.from("prop: generator failed at case ")
    string.push_u64(mut text, index)
    fail(take text)
}

fn failure_info(kind: FailureClass, text: String) -> FailureInfo {
    FailureInfo(class: kind, message: excerpt(text))
}

fn cause_failure(causes: Causes) -> FailureInfo {
    for cause in causes {
        let site = cause.site
        return match cause.kind {
            Fail(text) => failure_info(AtSite(0, site), text),
            Overflow => failure_info(AtSite(1, site), "Overflow"),
            Bounds => failure_info(AtSite(2, site), "Bounds"),
            Division => failure_info(AtSite(3, site), "Division"),
            Unwrap => failure_info(AtSite(4, site), "Unwrap"),
            Cancelled => failure_info(AtSite(5, site), "Cancelled"),
            Capacity(_) => failure_info(ByteCapacity, "Capacity"),
            OutOfTime => failure_info(TimedOut, "OutOfTime"),
            Stack => failure_info(AtSite(6, site), "Stack"),
        }
    }
    fail("prop: empty failure causes")
}

fn generate[T](cfg: Config, g: Gen[T], index: u64, prefix: Option[List[u64]]) -> Option[(T, Source)] {
    let run = isolate(fn() -> Result[(T, Source), OutOfTime] {
        bound steps cfg.gen_steps {
            let mut s = source(cfg.seed, index, cfg.max_choices, prefix)
            let value = draw(mut s, g)
            (take value, take s)
        }
    })
    match take run {
        Ok(Ok(Ok((take value, take s)))) => Some((take value, take s)),
        _ => None,
    }
}

fn case_failure[T](cfg: Config, v: T, law: own fn(T) -> Result[(), String]) -> Option[FailureInfo] {
    let run = bound bytes cfg.case_bytes {
        isolate(fn() -> Result[Result[(), String], OutOfTime] {
            bound steps cfg.case_steps {
                law(v)
            }
        })
    }
    match take run {
        Error(_) => config_bytes(cfg.case_bytes),
        Ok(Error(_)) => Some(failure_info(ByteCapacity, "Capacity")),
        Ok(Ok(Error(causes))) => Some(cause_failure(causes)),
        Ok(Ok(Ok(Error(_)))) => Some(failure_info(TimedOut, "OutOfTime")),
        Ok(Ok(Ok(Ok(Error(text))))) => Some(failure_info(Returned, text)),
        Ok(Ok(Ok(Ok(Ok(()))))) => None,
    }
}

fn render_at[T](cfg: Config, g: Gen[T], index: u64, tape: List[Choice]) -> String {
    let mut values: List[u64] = list.with_capacity(list.len(tape))
    for choice in tape {
        list.push(mut values, choice.value)
    }
    let prefix = Some(take values)
    let run = isolate(fn() -> Result[String, OutOfTime] {
        bound steps cfg.gen_steps {
            let mut s = source(cfg.seed, index, cfg.max_choices, prefix)
            s.rendering = true
            let mut text = string.new()
            let _ = show_part(mut s, g, mut text)
            excerpt(text)
        }
    })
    match take run {
        Ok(Ok(Ok(take text))) => take text,
        _ => string.from("<rendering failed>"),
    }
}

type FailureClass: key = Returned | ReturnedLabel(u64) | AtSite(u8, Site) | TimedOut | ByteCapacity

type FailureInfo {
    class: FailureClass,
    message: String
}

type Counterexample {
    tape: List[Choice],
    spans: List[Span],
    failure: FailureInfo
}

type Edit = Cut(u64, u64) | Zero(u64, u64) | Descendant(Span, Span) | Lower(u64, u64) | LowerEqual(u64, u64) | Transfer(u64, u64, u64) | SortSiblings(u64)

type Cursor {
    pass: u64,
    left: u64,
    right: u64,
    span_width: u64,
    block: u64,
    phase: u64,
    bit: u64,
    base: u64,
    good: u64,
    bad: u64,
    units: u64,
    amount: u64
}

type Shrink {
    best: Counterexample,
    cursor: Cursor,
    trials: u64,
    changed: bool
}

fn cursor(pass: u64) -> Cursor {
    Cursor(pass, left: 0, right: 1, span_width: 18446744073709551615, block: 5, phase: 0, bit: 64, base: 0, good: 0, bad: 0, units: 0, amount: 0)
}

fn smaller(a: List[Choice], b: List[Choice]) -> bool {
    let len_a = list.len(a)
    let len_b = list.len(b)
    if len_a != len_b {
        return len_a < len_b
    }
    for i in 0u64 .. len_a {
        if a[i].value != b[i].value {
            return a[i].value < b[i].value
        }
    }
    false
}

fn cut_span(mut scan: Cursor, spans: List[Span]) -> Option[Edit] {
    let mut best: Option[u64] = None
    let mut width: u64 = 0
    for i in 0u64 .. list.len(spans) {
        let size = spans[i].end - spans[i].start
        if size > width && (size < scan.span_width || (size == scan.span_width && i >= scan.left)) {
            best = Some(i)
            width = size
        }
    }
    if let Some(i) = best {
        scan.span_width = width
        scan.left = i + 1
        return Some(Cut(spans[i].start, spans[i].end))
    }
    None
}

fn cut_block(mut scan: Cursor, len: u64) -> Option[Edit] {
    while scan.block > 0 {
        if scan.block <= len && scan.left <= len - scan.block {
            let left = scan.left
            scan.left += 1
            return Some(Cut(left, left + scan.block))
        }
        scan.block -= 1
        scan.left = 0
    }
    None
}

fn zero_span(mut scan: Cursor, best: Counterexample) -> Option[Edit] {
    while scan.left < list.len(best.spans) {
        let item = best.spans[scan.left]
        scan.left += 1
        for i in item.start .. item.end {
            if best.tape[i].value != 0 {
                return Some(Zero(item.start, item.end))
            }
        }
    }
    None
}

fn enclosed(spans: List[Span], outer: u64, inner: u64) -> bool {
    let mut at = spans[inner].parent
    while let Some(i) = at {
        if i <= outer {
            return i == outer
        }
        at = spans[i].parent
    }
    false
}

fn next_pair(mut scan: Cursor) {
    scan.left += 1
    scan.right = scan.left + 1
    scan.amount = 0
}

fn pass_descendant(mut scan: Cursor, spans: List[Span]) -> Option[Edit] {
    let n = list.len(spans)
    while scan.left < n {
        let outer = spans[scan.left]
        while scan.right < n && enclosed(spans, scan.left, scan.right) {
            let inner = spans[scan.right]
            scan.right += 1
            if inner.label == outer.label && inner.end - inner.start < outer.end - outer.start {
                return Some(Descendant(outer, inner))
            }
        }
        next_pair(mut scan)
    }
    None
}

fn stride(scan: Cursor) -> u64 {
    if scan.phase == 4 {
        2
    } else {
        1
    }
}

fn next_subtraction(mut scan: Cursor, improved: bool) {
    if improved {
        scan.good = scan.units
    } else {
        scan.bad = scan.units
    }
    if scan.bad == 0 && scan.good < scan.base / stride(scan) {
        scan.units = order.min(scan.base / stride(scan), int.saturating_mul(scan.units, 2))
    } else if scan.bad > scan.good && scan.bad - scan.good > 1 {
        scan.units = scan.good + (scan.bad - scan.good) / 2
    } else {
        scan.phase += 1
        scan.units = 0
    }
}

fn next_number(mut scan: Cursor, value: u64) -> Option[u64] {
    while scan.phase < 6 && value != 0 {
        match scan.phase {
            0 => {
                scan.phase = 1
                return Some(0)
            },
            1 => {
                scan.phase = 2
                if value > 1 {
                    return Some(1)
                }
            },
            2 => {
                while scan.bit > 1 {
                    scan.bit -= 1
                    let masked = value & ((1u64 << scan.bit) - 1)
                    if masked < value && masked > 1 {
                        return Some(masked)
                    }
                }
                scan.bit = 0
                scan.phase = 3
            },
            3 => {
                while scan.bit < 63 {
                    scan.bit += 1
                    let shifted = value >> scan.bit
                    if shifted > 1 {
                        return Some(shifted)
                    }
                }
                scan.phase = 4
            },
            _ => {
                if scan.units == 0 {
                    scan.base = value
                    scan.good = 0
                    scan.bad = 0
                    scan.units = 1
                }
                if scan.units > scan.base / stride(scan) {
                    scan.phase += 1
                    scan.units = 0
                } else {
                    let lowered = scan.base - stride(scan) * scan.units
                    if lowered < value && lowered > 1 {
                        return Some(lowered)
                    }
                    next_subtraction(mut scan, lowered >= value)
                }
            },
        }
    }
    None
}

fn group_start(tape: List[Choice], i: u64) -> bool {
    let value = tape[i].value
    for j in 0u64 .. i {
        if tape[j].value == value {
            return false
        }
    }
    for j in i + 1 .. list.len(tape) {
        if tape[j].value == value {
            return true
        }
    }
    false
}

fn minimize(mut scan: Cursor, tape: List[Choice]) -> Option[Edit] {
    while scan.left < list.len(tape) {
        let value = tape[scan.left].value
        if scan.pass == 5 || (value != 0 && group_start(tape, scan.left)) {
            if let Some(lowered) = next_number(mut scan, value) {
                return Some(if scan.pass == 5 {
                    Lower(scan.left, lowered)
                } else {
                    LowerEqual(value, lowered)
                })
            }
        }
        scan.left += 1
        scan.phase = 0
        scan.bit = 64
        scan.units = 0
    }
    None
}

fn transfer_pair(mut scan: Cursor, tape: List[Choice]) -> Option[Edit] {
    let n = list.len(tape)
    while scan.left < n {
        let value = tape[scan.left].value
        while value != 0 && scan.right < n {
            let target = tape[scan.right]
            let highest = int.wrapping_sub(target.limit, 1)
            if scan.amount == 0 {
                scan.amount = order.min(value, highest - target.value)
            }
            if scan.amount != 0 {
                return Some(Transfer(scan.left, scan.right, scan.amount))
            }
            scan.right += 1
        }
        next_pair(mut scan)
    }
    None
}

fn span_order(a: Span, b: Span, tape: List[Choice]) -> Order {
    let na = a.end - a.start
    let nb = b.end - b.start
    for i in 0u64 .. order.min(na, nb) {
        let va = tape[a.start + i].value
        let vb = tape[b.start + i].value
        if va != vb {
            return order.compare(va, vb)
        }
    }
    order.compare(na, nb)
}

fn same_siblings(a: Span, b: Span) -> bool {
    a.parent == b.parent && a.label == b.label && a.start < a.end && b.start < b.end
}

fn first_sibling(spans: List[Span], at: u64) -> bool {
    let selected = spans[at]
    for i in 0u64 .. at {
        if same_siblings(spans[i], selected) {
            return false
        }
    }
    true
}

fn unordered_siblings(best: Counterexample, at: u64) -> bool {
    let mut previous = best.spans[at]
    for i in at + 1 .. list.len(best.spans) {
        let current = best.spans[i]
        if same_siblings(previous, current) {
            if span_order(previous, current, best.tape) == Greater {
                return true
            }
            previous = current
        }
    }
    false
}

fn sort_siblings(mut scan: Cursor, best: Counterexample) -> Option[Edit] {
    while scan.left < list.len(best.spans) {
        let at = scan.left
        scan.left += 1
        if first_sibling(best.spans, at) && unordered_siblings(best, at) {
            return Some(SortSiblings(at))
        }
    }
    None
}

fn next_edit(mut scan: Cursor, best: Counterexample) -> Option[Edit] {
    match scan.pass {
        1 => cut_span(mut scan, best.spans),
        2 => cut_block(mut scan, list.len(best.tape)),
        3 => zero_span(mut scan, best),
        4 => pass_descendant(mut scan, best.spans),
        5 ..= 6 => minimize(mut scan, best.tape),
        7 => transfer_pair(mut scan, best.tape),
        8 => sort_siblings(mut scan, best),
        _ => None,
    }
}

fn push_values(mut out: List[u64], tape: List[Choice], start: u64, end: u64) {
    for i in start .. end {
        list.push(mut out, tape[i].value)
    }
}

fn edit_value(edit: Edit, tape: List[Choice], i: u64) -> u64 {
    let value = tape[i].value
    match edit {
        Zero(first, last) if first <= i && i < last => 0,
        Lower(at, target) if at == i => target,
        LowerEqual(from, target) if from == value => target,
        Transfer(from, _, delta) if from == i => value - delta,
        Transfer(_, to, delta) if to == i => value + delta,
        _ => value,
    }
}

fn push_sorted_siblings(mut out: List[u64], best: Counterexample, first: u64) {
    let mut siblings: List[u64] = list.new()
    let group = best.spans[first]
    for i in first .. list.len(best.spans) {
        if same_siblings(group, best.spans[i]) {
            list.push(mut siblings, i)
        }
    }
    let mut sorted: List[u64] = clone(siblings)
    list.sort_stable(mut sorted, fn(a: u64, b: u64) -> Order {
        span_order(best.spans[a], best.spans[b], best.tape)
    })
    let mut from: u64 = 0
    for i in 0u64 .. list.len(siblings) {
        let old = best.spans[siblings[i]]
        let item = best.spans[sorted[i]]
        push_values(mut out, best.tape, from, old.start)
        push_values(mut out, best.tape, item.start, item.end)
        from = old.end
    }
    push_values(mut out, best.tape, from, list.len(best.tape))
}

fn apply_edit(best: Counterexample, edit: Edit) -> List[u64] {
    let tape = view best.tape
    let n = list.len(tape)
    let mut out: List[u64] = list.with_capacity(n)
    match edit {
        Cut(first, last) => {
            push_values(mut out, tape, 0, first)
            push_values(mut out, tape, last, n)
        },
        Descendant(a, b) => {
            push_values(mut out, tape, 0, a.start)
            push_values(mut out, tape, b.start, b.end)
            push_values(mut out, tape, a.end, n)
        },
        SortSiblings(at) => push_sorted_siblings(mut out, best, at),
        _ => {
            for i in 0u64 .. n {
                list.push(mut out, edit_value(edit, tape, i))
            }
        },
    }
    take out
}

fn next_trial(mut shrink: Shrink, cap: u64) -> Option[List[u64]] {
    while shrink.trials < cap {
        if let Some(edit) = next_edit(mut shrink.cursor, shrink.best) {
            shrink.trials += 1
            return Some(apply_edit(shrink.best, edit))
        }
        if shrink.cursor.pass < 8 {
            shrink.cursor = cursor(shrink.cursor.pass + 1)
        } else if shrink.changed {
            shrink.cursor = cursor(1)
            shrink.changed = false
        } else {
            return None
        }
    }
    None
}

fn review_trial(mut shrink: Shrink, take trial: Option[Counterexample]) {
    let mut improved = false
    if let Some(take candidate) = take trial {
        if candidate.failure.class == shrink.best.failure.class && smaller(candidate.tape, shrink.best.tape) {
            shrink.best = take candidate
            shrink.changed = true
            improved = true
        }
    }
    match shrink.cursor.pass {
        1 if improved => {
            shrink.cursor = cursor(1)
        },
        2 if improved => {
            shrink.cursor.left -= 1
        },
        5 ..= 6 if shrink.cursor.phase >= 4 => next_subtraction(mut shrink.cursor, improved),
        7 => {
            if improved {
                shrink.cursor.amount = 0
            } else {
                shrink.cursor.amount /= 2
                if shrink.cursor.amount == 0 {
                    shrink.cursor.right += 1
                }
            }
        },
        _ => {},
    }
}

fn counterexample(take s: Source, take input: FailureInfo, label: Option[fn(String) -> u64]) -> Counterexample {
    let mut failure = take input
    if failure.class == Returned {
        if let Some(classify) = label {
            failure.class = ReturnedLabel(classify(failure.message))
        }
    }
    let Source(tape: take tape, spans: take spans, ..) = take s
    Counterexample(tape: take tape, spans: take spans, failure: take failure)
}

fn pure_candidate[T](cfg: Config, g: Gen[T], law: own fn(T) -> Result[(), String], index: u64, prefix: Option[List[u64]], label: Option[fn(String) -> u64]) -> Option[Counterexample] {
    let Some((take value, take s)) = generate(cfg, g, index, prefix) else {
        return None
    }
    if s.invalid || s.overrun {
        return None
    }
    let Some(take info) = case_failure(cfg, value, law) else {
        return None
    }
    Some(counterexample(take s, take info, label))
}

fn shrink_case[T](cfg: Config, g: Gen[T], law: own fn(T) -> Result[(), String], index: u64, take original: Counterexample, label: Option[fn(String) -> u64]) -> (Counterexample, u64) {
    let mut state = Shrink(best: take original, cursor: cursor(1), trials: 0, changed: false)
    while let Some(take values) = next_trial(mut state, cfg.max_shrinks) {
        let trial = pure_candidate(cfg, g, law, index, Some(take values), label)
        review_trial(mut state, take trial)
    }
    let Shrink(best: take best, trials, ..) = take state
    (take best, trials)
}

fn found[T](cfg: Config, g: Gen[T], index: u64, cases: u64, shrinks: u64, take example: Counterexample) -> Found {
    let Counterexample(tape: take tape, failure: FailureInfo(class, message: take message), ..) = take example
    let rendered = render_at(cfg, g, index, tape)
    Found(index, tape: take tape, cases, shrinks, sim_seed: cfg.sim_seed, rendered: take rendered, message: take message, class)
}

fn shrink_from[T](cfg: Config, g: Gen[T], law: own fn(T) -> Result[(), String], take values: List[u64]) -> Found {
    let initial = match pure_candidate(cfg, g, law, 0, Some(take values), None) {
        Some(take example) => take example,
        None => fail("prop: starting tape does not fail"),
    }
    let (take smallest, n) = shrink_case(cfg, g, law, 0, take initial, None)
    found(cfg, g, 0, 1, n, take smallest)
}

fn replay_one[T](cfg: Config, g: Gen[T], law: own fn(T) -> Result[(), String], text: String) -> Outcome {
    let Replay(index, values: take values) = parse_token(text, cfg.max_choices)
    let prefix = Some(take values)
    let Some((take value, take s)) = generate(cfg, g, index, prefix) else {
        generation_failed(index)
    }
    if !s.overrun && !s.invalid {
        if let Some(take info) = case_failure(cfg, value, law) {
            return Falsified(found(cfg, g, index, 1, 0, counterexample(take s, take info, None)))
        }
    }
    fail("prop: replay token no longer fails")
}

pub fn search[T](c: Config, g: Gen[T], law: own fn(T) -> Result[(), String]) -> Outcome {
    search_labeled(c, g, law, None)
}

fn search_labeled[T](c: Config, g: Gen[T], law: own fn(T) -> Result[(), String], label: Option[fn(String) -> u64]) -> Outcome {
    if let Some(text) = c.replay {
        return replay_one(c, g, law, text)
    }
    let empty: Option[List[u64]] = None
    let mut cases: u64 = 0
    let mut rejected: u64 = 0
    let mut index: u64 = 0
    while cases < c.cases {
        let Some((take value, take s)) = generate(c, g, index, empty) else {
            generation_failed(index)
        }
        if s.overrun || s.invalid {
            rejected += 1
            if rejected > c.max_rejects {
                return GaveUp(cases, rejected)
            }
        } else {
            cases += 1
            if let Some(take info) = case_failure(c, value, law) {
                let (take smallest, n) = shrink_case(c, g, law, index, counterexample(take s, take info, label), label)
                return Falsified(found(c, g, index, cases, n, take smallest))
            }
        }
        index += 1
    }
    Passed(cases)
}

fn enumeration_stop_site() -> Site {
    // Identify the private failure site so a generator's own Fail text cannot stop the walk.
    if let Ok(Error(causes)) = isolate(fn() {
        stop_enumeration("")
    }) {
        for cause in causes {
            return cause.site
        }
    }
    fail("prop: could not read enumeration stop site")
}

fn enumerate_trial[T](c: Config, g: Gen[T], index: u64, prefix: Option[List[u64]]) -> AllTrial[T] {
    let run = isolate(fn() -> Result[(T, Source), OutOfTime] {
        bound steps c.gen_steps {
            let mut s = source(0, 0, c.max_choices, prefix)
            s.enumerating = true
            let value = draw(mut s, g)
            (take value, take s)
        }
    })
    match take run {
        Ok(Ok(Ok((take value, take s)))) => Trial(take value, take s),
        Ok(Ok(Error(_))) => TrialTruncated,
        Ok(Error(causes)) => {
            for cause in causes {
                if let OutOfTime = cause.kind {
                    return TrialTruncated
                }
                if let Fail(reason) = cause.kind {
                    if cause.site == enumeration_stop_site() {
                        return match int.parse_uint(reason, 10) {
                            Ok(at) => WordAt(at),
                            Error(_) => TrialTruncated,
                        }
                    }
                }
                break
            }
            generation_failed(index)
        },
        Error(_) => generation_failed(index),
    }
}

fn next_prefix(tape: List[Choice]) -> Option[List[u64]] {
    let mut end = list.len(tape)
    while end > 0 {
        end -= 1
        let choice = tape[end]
        if choice.value + 1 < choice.limit {
            let mut prefix: List[u64] = list.with_capacity(end + 1)
            push_values(mut prefix, tape, 0, end)
            list.push(mut prefix, choice.value + 1)
            return Some(take prefix)
        }
    }
    None
}

pub fn all[T](c: Config, g: Gen[T], law: own fn(T) -> Result[(), String]) -> AllOutcome {
    if let Some(_) = c.replay {
        fail("prop: config: all does not take a replay token")
    }
    let mut prefix: Option[List[u64]] = Some(list.new())
    let mut run: u64 = 0
    let mut discarded: u64 = 0
    for index in 0u64 .. c.cases {
        match enumerate_trial(c, g, index, prefix) {
            WordAt(at) => return Unbounded(at),
            TrialTruncated => return Truncated(run, discarded),
            Trial(take value, take s) => {
                if s.invalid {
                    discarded += 1
                } else {
                    run += 1
                    if let Some(take info) = case_failure(c, value, law) {
                        return Falsified(found(c, g, index, run, 0, counterexample(take s, take info, None)))
                    }
                }
                let Some(take next) = next_prefix(s.tape) else {
                    return Held(run, discarded)
                }
                prefix = Some(take next)
            },
        }
    }
    Truncated(run, discarded)
}

pub fn check[T](c: Config, g: Gen[T], law: own fn(T) -> Result[(), String]) -> Result[(), ()] {
    finish_check(search(c, g, law))
}

fn finish_check(take outcome: Outcome) -> Result[(), ()] {
    let mut out = string.new()
    match outcome {
        Passed(_) => return Ok(()),
        GaveUp(cases, rejected) => {
            string.push(mut out, "prop: gave up after ")
            string.push_u64(mut out, cases)
            string.push(mut out, " cases, ")
            string.push_u64(mut out, rejected)
            string.push(mut out, " rejected")
        },
        Falsified(f) => report(f, mut out),
    }
    fail(take out)
}

pub type Case[T: send]: send {
    value: T,
    index: u64,
    world_seed: u64,
    tasks: Tasks
}

fn mix(seed: u64) -> u64 {
    // SplitMix64, as used for the first draw of std.sim.world.plan.
    let advanced = int.wrapping_add(seed, 0x9e3779b97f4a7c15)
    let a = int.wrapping_mul(advanced ^ (advanced >> 30), 0xbf58476d1ce4e5b9)
    let b = int.wrapping_mul(a ^ (a >> 27), 0x94d049bb133111eb)
    b ^ (b >> 31)
}

pub fn world_seed(sim: u64, index: u64) -> u64 {
    mix(sim ^ mix(index))
}

fn task_failure[T: send](tasks: Tasks, cfg: Config, take value: T, index: u64, law: fn(take Case[T]) -> Result[(), String] waits) -> Option[FailureInfo] waits {
    let sim = match cfg.sim_seed {
        Some(seed) => seed,
        None => 0,
    }
    let input = Case(value: take value, index, world_seed: world_seed(sim, index), tasks)
    let spawned = bound steps cfg.case_steps {
        task.try_spawn(tasks, bytes cfg.case_bytes, take input, law)
    }
    let child = match take spawned {
        Error(_) => return Some(failure_info(TimedOut, "OutOfTime")),
        Ok(Error(_)) => config_bytes(cfg.case_bytes),
        Ok(Ok(take handle)) => take handle,
    }
    match task.join(take child) {
        Ok(Ok(())) => None,
        Ok(Error(text)) => Some(failure_info(Returned, text)),
        Error(Failed(causes)) => Some(cause_failure(causes)),
        Error(Cancelled(causes)) => Some(cause_failure(causes)),
    }
}

fn tasks_candidate[T: send](tasks: Tasks, cfg: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits, index: u64, prefix: Option[List[u64]], label: Option[fn(String) -> u64]) -> Option[Counterexample] waits {
    let Some((take value, take s)) = generate(cfg, g, index, prefix) else {
        return None
    }
    if s.invalid || s.overrun {
        return None
    }
    let Some(take info) = task_failure(tasks, cfg, take value, index, law) else {
        return None
    }
    Some(counterexample(take s, take info, label))
}

fn shrink_tasks_case[T: send](tasks: Tasks, cfg: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits, index: u64, take original: Counterexample, label: Option[fn(String) -> u64]) -> (Counterexample, u64) waits {
    let mut state = Shrink(best: take original, cursor: cursor(1), trials: 0, changed: false)
    while let Some(take values) = next_trial(mut state, cfg.max_shrinks) {
        let trial = tasks_candidate(tasks, cfg, g, law, index, Some(take values), label)
        review_trial(mut state, take trial)
    }
    let Shrink(best: take best, trials, ..) = take state
    (take best, trials)
}

/// Shrinks a failing task case from an explicit tape at its original index.
pub fn shrink_tasks_from[T: send](tasks: Tasks, cfg: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits, index: u64, values: List[u64]) -> Found waits {
    let prefix: List[u64] = clone(values)
    let Some((take value, take s)) = generate(cfg, g, index, Some(take prefix)) else {
        generation_failed(index)
    }
    if !consumed(s, values) {
        fail("prop: fixed tape did not round trip")
    }
    let Some(take info) = task_failure(tasks, cfg, take value, index, law) else {
        fail("prop: starting tape does not fail")
    }
    let (take smallest, n) = shrink_tasks_case(tasks, cfg, g, law, index, counterexample(take s, take info, None), None)
    found(cfg, g, index, 1, n, take smallest)
}

fn replay_tasks_one[T: send](tasks: Tasks, cfg: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits, text: String) -> Outcome waits {
    let Replay(index, values: take values) = parse_token(text, cfg.max_choices)
    let prefix = Some(take values)
    let Some((take value, take s)) = generate(cfg, g, index, prefix) else {
        generation_failed(index)
    }
    if !s.overrun && !s.invalid {
        if let Some(take info) = task_failure(tasks, cfg, take value, index, law) {
            return Falsified(found(cfg, g, index, 1, 0, counterexample(take s, take info, None)))
        }
    }
    fail("prop: replay token no longer fails")
}

fn search_tasks[T: send](tasks: Tasks, c: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits) -> Outcome waits {
    search_tasks_labeled(tasks, c, g, law, None)
}

fn search_tasks_labeled[T: send](tasks: Tasks, c: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits, label: Option[fn(String) -> u64]) -> Outcome waits {
    if let Some(text) = c.replay {
        return replay_tasks_one(tasks, c, g, law, text)
    }
    let empty: Option[List[u64]] = None
    let mut cases: u64 = 0
    let mut rejected: u64 = 0
    let mut index: u64 = 0
    while cases < c.cases {
        let Some((take value, take s)) = generate(c, g, index, empty) else {
            generation_failed(index)
        }
        if s.overrun || s.invalid {
            rejected += 1
            if rejected > c.max_rejects {
                return GaveUp(cases, rejected)
            }
        } else {
            cases += 1
            if let Some(take info) = task_failure(tasks, c, take value, index, law) {
                let (take smallest, n) = shrink_tasks_case(tasks, c, g, law, index, counterexample(take s, take info, label), label)
                return Falsified(found(c, g, index, cases, n, take smallest))
            }
        }
        index += 1
    }
    Passed(cases)
}

pub fn check_tasks[T: send](tasks: Tasks, c: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits) -> Result[(), ()] waits {
    finish_check(search_tasks(tasks, c, g, law))
}

/// Identifies the generator and optionally classifies the law's returned errors.
pub type Corpus {
    generator: u64,
    label: Option[fn(String) -> u64]
}

fn corpus_input(e: Env) -> Option[String] {
    match env.get(e, "HIRSEL_TEST_PROPERTY_CORPUS") {
        Ok(Some(text)) => Some(string.from(text)),
        _ => None
    }
}

fn choice_bounds(tape: List[Choice]) -> String {
    let mut data: Bytes = list.new()
    for choice in tape {
        put_uleb(mut data, choice.limit)
    }
    // A zero-choice tape needs a nonempty field.
    list.push(mut data, 0u8)
    base64.encode_string(data)
}

fn corpus_number(mut out: String, n: u64) {
    string.push_u64(mut out, n)
    string.push(mut out, " ")
}

fn corpus_fingerprint(f: Found, mut out: String) {
    match f.class {
        Returned => string.push(mut out, "returned"),
        ReturnedLabel(label) => {
            string.push(mut out, "returned-")
            string.push_u64(mut out, label)
        },
        AtSite(kind, site) => {
            string.push(mut out, "raised-")
            let n: u64 = int.widen(kind)
            string.push_u64(mut out, n)
            string.push(mut out, " @")
            string.push_u64(mut out, site_word(site))
        },
        TimedOut => string.push(mut out, "steps"),
        ByteCapacity => string.push(mut out, "bytes"),
    }
}

fn corpus_report(cfg: Config, key: Corpus, f: Found) -> Never {
    let mut out = string.from("prop-corpus-v2 ")
    corpus_number(mut out, key.generator)
    corpus_number(mut out, cfg.seed)
    match cfg.sim_seed {
        Some(seed) => corpus_number(mut out, seed),
        None => string.push(mut out, "- "),
    }
    corpus_number(mut out, cfg.cases)
    corpus_number(mut out, cfg.max_choices)
    corpus_number(mut out, cfg.max_rejects)
    corpus_number(mut out, cfg.max_shrinks)
    corpus_number(mut out, cfg.gen_steps)
    corpus_number(mut out, cfg.case_steps)
    corpus_number(mut out, cfg.case_bytes)
    token(f, mut out)
    string.push(mut out, " ")
    string.push(mut out, choice_bounds(f.tape))
    string.push(mut out, " ")
    corpus_fingerprint(f, mut out)
    string.push(mut out, " | ")
    report(f, mut out)
    fail(take out)
}

fn corpus_field(input: String, mut at: u64) -> View[String] in input {
    let Some((part, next)) = string.next_split(input, at, " ") else {
        fail("prop: invalid runner corpus input")
    }
    at = next
    part
}

fn corpus_u64(text: String) -> u64 {
    let value: Result[u64, ParseError] = int.parse(text)
    match value {
        Ok(n) => n,
        Error(_) => fail("prop: invalid runner corpus number"),
    }
}

fn corpus_stale() -> Never {
    fail("prop-corpus-v2 stale")
}

fn corpus_replay(input: String, active: Config, key: Corpus) -> (Config, Replay, String) {
    let mut at: u64 = 0
    if corpus_u64(corpus_field(input, mut at)) != key.generator {
        corpus_stale()
    }
    let seed = corpus_u64(corpus_field(input, mut at))
    let sim = corpus_field(input, mut at)
    let sim_seed: Option[u64] = if sim == "-" {
        None
    } else {
        Some(corpus_u64(sim))
    }
    let cases = corpus_u64(corpus_field(input, mut at))
    let max_choices = corpus_u64(corpus_field(input, mut at))
    let max_rejects = corpus_u64(corpus_field(input, mut at))
    let max_shrinks = corpus_u64(corpus_field(input, mut at))
    let gen_steps = corpus_u64(corpus_field(input, mut at))
    let case_steps = corpus_u64(corpus_field(input, mut at))
    let case_bytes = corpus_u64(corpus_field(input, mut at))
    if max_choices > active.max_choices || gen_steps > active.gen_steps || case_steps > active.case_steps || case_bytes > active.case_bytes {
        fail("prop: saved case exceeds active replay limits")
    }
    let saved_tape = parse_token(corpus_field(input, mut at), max_choices)
    let bounds = string.from(corpus_field(input, mut at))
    (Config(seed, cases, max_choices, max_rejects, max_shrinks, gen_steps, case_steps, case_bytes, sim_seed, replay: None), take saved_tape, take bounds)
}

fn consumed(s: Source, values: List[u64]) -> bool {
    if s.overrun || s.invalid || list.len(s.tape) != list.len(values) {
        return false
    }
    for i in 0u64 .. list.len(s.tape) {
        if s.tape[i].value != values[i] {
            return false
        }
    }
    true
}

// The ordinary shrinker can repair dependent choices. Corpus replay requires an
// exact tape, including every draw bound, before the law runs.
fn corpus_draw[T](cfg: Config, g: Gen[T], saved: Replay, bounds: String) -> (T, Source) {
    let values: List[u64] = clone(saved.values)
    let prefix = Some(take values)
    let Some((take value, take s)) = generate(cfg, g, saved.index, prefix) else {
        generation_failed(saved.index)
    }
    if !consumed(s, saved.values) || choice_bounds(s.tape) != bounds {
        corpus_stale()
    }
    (take value, take s)
}

fn corpus_finish(cfg: Config, key: Corpus, take outcome: Outcome) -> Result[(), ()] {
    if let Falsified(f) = outcome {
        corpus_report(cfg, key, f)
    }
    finish_check(take outcome)
}

pub fn check_corpus[T](e: Env, key: Corpus, c: Config, g: Gen[T], law: own fn(T) -> Result[(), String]) -> Result[(), ()] {
    let Some(input) = corpus_input(e) else {
        return check(c, g, law)
    }
    if let Some(_) = c.replay {
        fail("prop: an explicit replay token cannot use the runner corpus")
    }
    if input == "search" {
        return corpus_finish(c, key, search_labeled(c, g, law, key.label))
    }
    let (take cfg, take saved, take bounds) = corpus_replay(input, c, key)
    let (take value, take s) = corpus_draw(cfg, g, saved, bounds)
    let Some(take info) = case_failure(cfg, value, law) else {
        corpus_stale()
    }
    corpus_report(cfg, key, found(cfg, g, saved.index, 1, 0, counterexample(take s, take info, key.label)))
}

pub fn check_tasks_corpus[T: send](e: Env, tasks: Tasks, key: Corpus, c: Config, g: Gen[T], law: fn(take Case[T]) -> Result[(), String] waits) -> Result[(), ()] waits {
    let Some(input) = corpus_input(e) else {
        return check_tasks(tasks, c, g, law)
    }
    if let Some(_) = c.replay {
        fail("prop: an explicit replay token cannot use the runner corpus")
    }
    if input == "search" {
        return corpus_finish(c, key, search_tasks_labeled(tasks, c, g, law, key.label))
    }
    let (take cfg, take saved, take bounds) = corpus_replay(input, c, key)
    let (take value, take s) = corpus_draw(cfg, g, saved, bounds)
    let Some(take info) = task_failure(tasks, cfg, take value, saved.index, law) else {
        corpus_stale()
    }
    corpus_report(cfg, key, found(cfg, g, saved.index, 1, 0, counterexample(take s, take info, key.label)))
}

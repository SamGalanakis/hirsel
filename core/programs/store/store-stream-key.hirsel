pub type StreamId: codec + key + shareable + send {
    t: u64,
    n: u64
}

pub type StreamKey: codec + key + shareable + send {
    caller: Caller,
    id: StreamId
}

pub const SUBJECT_MAX: u64 = 64u64

pub const STREAM_RETENTION_MS: u64 = 5184000000u64

pub const STREAM_FUTURE_SLACK_MS: u64 = 300000u64

pub fn caller_key(caller: Caller, mut out: Bytes) -> Result[(), Capacity] {
    let size = list.len(caller.subject)
    if size > SUBJECT_MAX {
        return Error(Capacity(requested: size, available: SUBJECT_MAX))
    }
    list.reserve(mut out, size + 2u64)
    list.push(mut out, caller.issuer)
    list.push(mut out, int.narrow(size))
    list.append(mut out, caller.subject)
    Ok(())
}

pub fn stream_key_bytes(stream: StreamKey) -> Result[Bytes, Capacity] {
    let mut key: Bytes = list.with_capacity(list.len(stream.caller.subject) + 18u64)
    caller_key(stream.caller, mut key)?
    std.codec.put_key_u64(stream.id.t, mut key)
    std.codec.put_key_u64(stream.id.n, mut key)
    Ok(take key)
}

fn parse_stream_key(raw: Bytes) -> Option[StreamKey] {
    if list.len(raw) < 18u64 {
        return None
    }
    let size: u64 = int.widen(raw[1u64])
    if size > SUBJECT_MAX || list.len(raw) != size + 18u64 {
        return None
    }
    let mut at = size + 2u64
    let t = result.unwrap(std.codec.take_key_u64(raw, mut at))
    let n = result.unwrap(std.codec.take_key_u64(raw, mut at))
    let subject: Bytes = clone(list.slice(raw, 2u64, size + 2u64))
    Some(StreamKey(caller: Caller(issuer: raw[0u64], subject: take subject), id: StreamId(t, n)))
}

pub fn stream_record_matches(raw: Bytes, name: StreamKey) -> bool {
    let size = list.len(name.caller.subject)
    list.len(raw) == size + 18u64 && raw[0u64] == name.caller.issuer && raw[1u64] == int.truncate(size) && list.starts_with_at(raw, 2u64, name.caller.subject) && word_be(raw, size + 2u64) == name.id.t && word_be(raw, size + 10u64) == name.id.n
}

pub fn keyed_time(db: Db) -> u64 {
    order.max(host.wall_ms(db.clock), db.heads[0].at)
}

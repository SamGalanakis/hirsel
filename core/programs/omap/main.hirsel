// READY/DONE bracket only the operation; the harness controls perf through a
// separate FIFO. The two gate reads keep setup and final drops outside it.
fn populated(mut ids: u64) -> std.omap.OMap[u64, u64] {
    let mut m: std.omap.OMap[u64, u64] = std.omap.new()
    for i in 0u64 .. 100000 {
        m = result.unwrap(std.omap.insert(mut ids, m, i, i + 1))
    }
    m
}

fn value(m: std.omap.OMap[u64, u64], k: u64) -> u64 {
    match std.omap.get(m, k) {
        Some(v) => v,
        None => fail("benchmark missing key")
    }
}

fn unique_inserts(mut ids: u64) -> std.omap.OMap[u64, u64] {
    let mut m: std.omap.OMap[u64, u64] = std.omap.new()
    for i in 0u64 .. 100000 {
        let previous = take m
        let replacement = result.unwrap(std.omap.insert_owned(mut ids, take previous, i, i + 1))
        m = take replacement
    }
    m
}

type EditNode: shareable + send {
    value: u64,
    children: List[Arc[u64]]
}

fn edit_node() -> Arc[EditNode] {
    let mut children: List[Arc[u64]] = result.unwrap(list.with_capacity(32))
    for i in 0u64 .. 32 {
        result.unwrap(list.push(mut children, result.unwrap(arc.new(i))))
    }
    result.unwrap(arc.new(EditNode(value: 0, children: take children)))
}

fn unwrap_edits(mut edits: List[Arc[EditNode]]) -> u64 {
    let mut h = option.unwrap(list.pop(mut edits))
    for i in 0u64 .. 100000 {
        let previous = take h
        let replacement = match arc.try_unwrap(take previous) {
            Ok(take node) => {
                let mut owned = take node
                owned.value += 1
                result.unwrap(arc.new(take owned))
            },
            Error(take shared) => fail("microbenchmark unexpectedly shared")
        }
        h = take replacement
    }
    let observed = h.value
    result.unwrap(list.push(mut edits, take h))
    observed
}

fn work(mut ids: u64, mut m: std.omap.OMap[u64, u64], mut held: List[std.omap.OMap[u64, u64]], mut edits: List[Arc[EditNode]], keys: List[u64], values: List[u64], mode: String) -> u64 {
    if mode == "unique" {
        m = unique_inserts(mut ids);
        return std.omap.len(m)
    }
    if mode == "unwrap" {
        return unwrap_edits(mut edits)
    }
    if mode == "bulk" {
        m = result.unwrap(std.omap.from_sorted(mut ids, keys, values))
        return std.omap.len(m)
    }
    if mode == "insert" {
        for i in 0u64 .. 100000 {
            m = result.unwrap(std.omap.insert(mut ids, m, i, i + 1))
        }
        return std.omap.len(m)
    }
    if mode == "lookup" {
        let mut sum: u64 = 0
        for i in 0u64 .. 100000 {
            sum += value(m, (i * 65537) % 100000)
        }
        return sum
    }
    if mode == "range" {
        let mut rows = result.unwrap(std.omap.range(m, Included(25000), Excluded(75000)))
        let mut sum: u64 = 0
        while let Some((k, v)) = result.unwrap(std.omap.next(mut rows)) {
            sum += k + v
        }
        return sum
    }
    if mode == "snapshots" {
        for i in 0u64 .. 1000 {
            result.unwrap(list.push(mut held, std.omap.snapshot(m)))
            m = result.unwrap(std.omap.insert(mut ids, m, i, 100000 + i))
        }
        let mut sum: u64 = 0
        for i in 0u64 .. 1000 {
            sum += value(held[i], i)
        }
        return sum
    }
    fail("benchmark unknown mode")
}

pub fn main(argv: Args, out: Stdout, dir: Dir, clock: Clock) -> Result[(), Exit] waits {
    let mode = option.unwrap(args.get(argv, 0))
    let mut ids: u64 = 0
    let mut m: std.omap.OMap[u64, u64] = if mode == "insert" || mode == "unique" || mode == "bulk" || mode == "unwrap" {
        std.omap.new()
    } else {
        populated(mut ids)
    }
    let mut edits: List[Arc[EditNode]] = list.new()
    if mode == "unwrap" {
        result.unwrap(list.reserve(mut edits, 1))
        result.unwrap(list.push(mut edits, edit_node()))
    }
    let mut keys: List[u64] = list.new()
    let mut values: List[u64] = list.new()
    if mode == "bulk" {
        result.unwrap(list.reserve(mut keys, 100000))
        result.unwrap(list.reserve(mut values, 100000))
        for i in 0u64 .. 100000 {
            result.unwrap(list.push(mut keys, i))
            result.unwrap(list.push(mut values, i + 1))
        }
    }
    let mut held: List[std.omap.OMap[u64, u64]] = result.unwrap(list.with_capacity(1000))
    let mut gate = result.unwrap(host.open(dir, "gate", Read))
    let mut byte: Bytes = result.unwrap(list.with_capacity(1))
    result.unwrap(stdout.write(out, "READY\n"))
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    let start = host.mono_ns(clock)
    let sum = work(mut ids, mut m, mut held, mut edits, keys, values, mode)
    let elapsed = host.mono_ns(clock) - start
    let expected = if mode == "insert" || mode == "unique" || mode == "bulk" || mode == "unwrap" {
        100000u64
    } else if mode == "lookup" {
        5000050000u64
    } else if mode == "range" {
        5000000000u64
    } else {
        500500u64
    }
    if sum != expected {
        return Error(Exit(status: 9))
    }
    let mut rendered = string.new()
    result.unwrap(string.push(mut rendered, "DONE "))
    result.unwrap(string.push_u64(mut rendered, sum))
    result.unwrap(string.push(mut rendered, " "))
    result.unwrap(string.push_u64(mut rendered, elapsed))
    result.unwrap(string.push(mut rendered, "\n"))
    result.unwrap(stdout.write(out, rendered))
    list.clear(mut byte)
    if result.unwrap(host.read(mut gate, mut byte)) != 1 {
        return Error(Exit(status: 7))
    }
    // Keep both roots and snapshots alive until perf and RSS have been read.
    if (mode == "unwrap" && list.len(edits) != 1) || (mode != "unwrap" && std.omap.len(m) != 100000) || (mode == "snapshots" && list.len(held) != 1000) {
        return Error(Exit(status: 6))
    }
    Ok(())
}

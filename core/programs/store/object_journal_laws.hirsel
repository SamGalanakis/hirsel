fn object_writer_law(c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), Error] waits {
    let first = bucket_law_https_client(sim, tasks, "s3.test", 1)?
    let mut options = result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64))
    options.group_bytes = 65536
    options.head_poll_ms = 10000
    let mut incumbent = open_authority(tasks, object_authority(take first, "bucket", BUCKET_LAW_OP_MS), c, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    let _ = create_table(mut incumbent, spec("rows", std.codec.key_u64(), std.codec.of_bytes()))?
    let rows = table(mut incumbent, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let value = bucket_m2_pack_value()
    let outcome = run(mut incumbent, None, (copy_env(rows), copy_env(value)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.0, 7, call_env.1)
    })?
    let Committed(first_write) = outcome else { fail("the first writer could not commit") }
    durable(mut incumbent, first_write.ticket)?
    let saved = position(mut incumbent, first_write.ticket)?
    let _ = checkpoint(mut incumbent)?
    // Issue the old holder's ticket before the new claim, with its journal
    // paused. The claim cannot race admission of the ticket under test.
    let (take paused, take resume) = take_object_journal(mut incumbent)?
    let late = run(mut incumbent, None, (copy_env(rows), copy_env(value)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.0, 8, call_env.1)
    })?
    let Committed(losing) = late else { fail("the losing write could not be staged") }
    let next_client = bucket_law_client_with(sim, tasks, "s3.test", 2, true)?
    options.create = false
    options.expect = Some(saved.store)
    let successor = open_authority(tasks, object_authority(take next_client, "bucket", BUCKET_LAW_OP_MS), c, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    let mut surviving = take successor
    let current = snapshot(surviving)
    if get(result.unwrap(reader(surviving, 0u64)), current, rows, 7)? != Some(clone(value)) || current.head != saved.version || claim_of(surviving)?.epoch != 2 {
        fail("a new holder did not recover the durable checkpoint")
    }
    return_object_journal(take paused, resume)?
    if let Error(Fenced(1)) = durable(mut incumbent, losing.ticket) {} else {
        fail("a stale holder acknowledged a fenced group")
    }
    durable(mut incumbent, first_write.ticket)?
    if let Error(Fenced(1)) = close(take incumbent) {} else {
        fail("the old holder lost its sticky fence")
    }
    let _ = checkpoint(mut surviving)?
    let read_source = bucket_law_client_with(sim, tasks, "s3.test", 3, true)?
    let mut process = followers()
    let plan = follower_law_plan(Bucket(bucket_law_lanes(0)), options)
    let service = follower_law_service(tasks, plan, 1)?
    let follower_view = follower(mut process, follower_slot(follower_owner(service)?, plan)?, object_authority(take read_source, "bucket", BUCKET_LAW_OP_MS), sim.time, options.expect)?
    let visible = snapshot_follower(follower_view, Branch(store: saved.store, id: 0))?
    if get(result.unwrap(follower_reader(follower_view, 0u64)), visible, rows, 7)? != Some(clone(value)) || get(result.unwrap(follower_reader(follower_view, 0u64)), visible, rows, 8)? != None {
        fail("the surviving history lost a durable row or exposed a fenced row")
    }
    close(take surviving)
}


// Module provider: worker-local TTFT samples and an extra-request allowance.
const HEDGE_FLOOR_NS: u64 = 1500000000u64
const TTFT_WINDOW: u64 = 64u64
const REQUESTS_PER_HEDGE: u64 = 10u64

type HistoryMessage: send = Threshold(Sender[Option[u64]]) | Sent | Claim(Sender[bool]) | Sample(u64)

pub opaque type Worker: send {
    tasks: Tasks,
    history: Sender[HistoryMessage],
    probe_bytes: u64,
}

type TokenTiming: send { history: Sender[HistoryMessage], clock: Clock, start: u64 }

// Share one worker across dispatches to the same provider route.
pub fn worker(tasks: Tasks, probe_bytes: u64) -> (Worker, Task[()]) {
    let (to, from): (Sender[HistoryMessage], Receiver[HistoryMessage]) = channel.new(64u64)
    let history = task.spawn(tasks, bytes 32768u64, take from, serve_history)
    (Worker(tasks: tasks, history: take to, probe_bytes: probe_bytes), take history)
}

pub fn share_worker(w: Worker) -> Worker {
    Worker(tasks: w.tasks, history: channel.sender(w.history), probe_bytes: w.probe_bytes)
}

fn serve_history(take from: Receiver[HistoryMessage]) waits {
    let mut samples: List[u64] = list.with_capacity(TTFT_WINDOW)
    let mut next = 0u64
    let mut credit = 0u64
    while let Ok(take msg) = channel.receive(from) {
        match take msg {
            Sample(ns) => {
                if list.len(samples) < TTFT_WINDOW { list.push(mut samples, ns) } else { samples[next] = ns }
                next = (next + 1u64) % TTFT_WINDOW
            },
            Sent => { credit = order.min(credit + 1u64, REQUESTS_PER_HEDGE) },
            Threshold(take to) => {
                let delay = if credit >= REQUESTS_PER_HEDGE - 1u64 { Some(hedge_delay(samples)) } else { None }
                let _ = channel.send(to, delay)
            },
            Claim(take to) => {
                let allowed = credit == REQUESTS_PER_HEDGE
                if let Ok(()) = channel.send(to, allowed) {
                    if allowed { credit = 0u64 }
                }
            },
        }
    }
}

fn hedge_delay(samples: List[u64]) -> u64 {
    let count = list.len(samples)
    if count == 0u64 { return HEDGE_FLOOR_NS }
    let mut sorted: List[u64] = clone(samples)
    list.sort(mut sorted, fn(a: u64, b: u64) -> Order { order.compare(a, b) })
    let rank = (9u64 * count + 9u64) / 10u64
    order.max(HEDGE_FLOOR_NS, sorted[rank - 1u64])
}

fn threshold(w: Worker) -> Option[u64] waits {
    let (to, from): (Sender[Option[u64]], Receiver[Option[u64]]) = channel.new(1u64)
    if let Error(_) = channel.send(w.history, Threshold(take to)) { return None }
    match channel.receive(from) { Ok(delay) => delay, Error(_) => None }
}

fn claim_hedge(w: Worker) -> bool waits {
    let (to, from): (Sender[bool], Receiver[bool]) = channel.new(1u64)
    if let Error(_) = channel.send(w.history, Claim(take to)) { return false }
    match channel.receive(from) { Ok(allowed) => allowed, Error(_) => false }
}

fn record_token(timing: TokenTiming) {
    let _ = channel.try_send(timing.history, Sample(host.mono_ns(timing.clock) - timing.start))
}

type FirstBytes: send { response: Response, chunk: Bytes, started: u64 }

type ProbeEvent: send = Timer | Probe(bool, Result[FirstBytes, harness.ModelFault])

type ProbeTimer: send { clock: Clock, at: u64, to: Sender[ProbeEvent] }

fn fire_probe_timer(take timer: ProbeTimer) waits {
    host.sleep_until(timer.clock, timer.at)
    let _ = channel.send(timer.to, Timer)
}

type ProbeEndpoint: send {
    address: Addr,
    authority: String,
    prefix: String,
    tls: Option[(String, Option[Bytes])],
}

type ProbeJob: send {
    to: Sender[ProbeEvent],
    net: Net,
    clock: Clock,
    model: Model,
    endpoint: ProbeEndpoint,
    key: Secret,
    bounds: Bounds,
    body: String,
    deadline: u64,
    extra: Option[harness.Hedge],
    history: Option[Sender[HistoryMessage]],
}

fn open_stream(n: Net, clock: Clock, p: Provider, text: String, deadline: u64, history: Option[Sender[HistoryMessage]]) -> Result[Response, harness.ModelFault] waits {
    let mut response = open_response(n, clock, p, text, true, deadline, history)?
    if response.status != 200u16 { return Error(http_fault(mut response.connection, response.status, response.delay)) }
    if !response.events { return Error(Rejected("provider did not send an event stream")) }
    Ok(take response)
}

fn first_bytes(job: ProbeJob) -> Result[FirstBytes, harness.ModelFault] waits {
    if let Some(permit) = job.extra {
        if !harness.try_hedge(permit) { return Error(Rejected("hedge refused")) }
    }
    let started = host.mono_ns(job.clock)
    let security = match job.endpoint.tls {
        None => Plain,
        Some((name, None)) => Https(clone(name), System),
        Some((name, Some(roots))) => Https(clone(name), Roots(clone(roots))),
    }
    let endpoint = Endpoint(address: job.endpoint.address, authority: clone(job.endpoint.authority), prefix: clone(job.endpoint.prefix), security: take security)
    let provider = Provider(model: clone(job.model), endpoint: take endpoint, key: secret.share(job.key), bounds: job.bounds, deadline_ms: 0u64)
    let mut response = open_stream(job.net, job.clock, provider, job.body, job.deadline, job.history)?
    let mut chunk: Bytes = list.with_capacity(8192u64)
    if stream_chunk(mut response.connection, mut chunk)? == 0u64 {
        return Error(StreamDropped("provider sent an empty response stream"))
    }
    Ok(FirstBytes(response: take response, chunk: take chunk, started: started))
}

fn run_probe(take job: ProbeJob) waits {
    let extra = match job.extra { Some(_) => true, None => false }
    let reply = first_bytes(job)
    let _ = channel.send(job.to, Probe(extra, take reply))
}

fn probe(w: Worker, to: Sender[ProbeEvent], n: Net, clock: Clock, p: Provider, text: String, deadline: u64,
    take extra: Option[harness.Hedge]) -> Option[Task[()]] {
    let size = w.probe_bytes
    let tls: Option[(String, Option[Bytes])] = match p.endpoint.security {
        Plain => None,
        Https(name, System) => Some((clone(name), None)),
        Https(name, Roots(roots)) => Some((clone(name), Some(clone(roots)))),
    }
    let endpoint = ProbeEndpoint(address: p.endpoint.address, authority: clone(p.endpoint.authority), prefix: clone(p.endpoint.prefix), tls: take tls)
    let history: Option[Sender[HistoryMessage]] = match extra { Some(_) => None, None => Some(channel.sender(w.history)) }
    let job = ProbeJob(to: channel.sender(to), net: n, clock: clock, model: clone(p.model), endpoint: take endpoint,
        key: secret.share(p.key), bounds: p.bounds, body: clone(text), deadline: deadline, extra: take extra, history: take history)
    match task.try_spawn(w.tasks, bytes size, take job, run_probe) {
        Ok(take task) => Some(take task),
        Error(_) => None,
    }
}

fn await_primary(from: Receiver[ProbeEvent]) -> Result[FirstBytes, harness.ModelFault] waits {
    while let Ok(take event) = channel.receive(from) {
        if let Probe(false, take result) = take event { return take result }
    }
    Error(StreamDropped("model worker lost the primary response"))
}

fn race(w: Worker, n: Net, clock: Clock, p: Provider, text: String, started: u64, deadline: u64, delay: u64,
    take permit: harness.Hedge) -> Option[Result[FirstBytes, harness.ModelFault]] waits {
    let (to, from): (Sender[ProbeEvent], Receiver[ProbeEvent]) = channel.new(3u64)
    let Some(take main_probe) = probe(w, to, n, clock, p, text, deadline, None) else { return None }
    let alarm = ProbeTimer(clock: clock, at: int.saturating_add(started, delay), to: channel.sender(to))
    let timer = match task.try_spawn(w.tasks, bytes 4096u64, take alarm, fire_probe_timer) {
        Ok(take child) => take child,
        Error(_) => {
            let _ = take to
            return Some(await_primary(from))
        },
    }
    let first = match channel.receive(from) {
        Ok(Probe(_, take result)) => return Some(take result),
        Error(_) => return Some(Error(StreamDropped("model worker lost the primary response"))),
        Ok(Timer) => channel.try_receive(from),
    }
    if let Ok(Probe(_, take result)) = take first { return Some(take result) }
    let _ = take timer
    let mut extra: Option[Task[()]] = if claim_hedge(w) {
        probe(w, to, n, clock, p, text, deadline, Some(take permit))
    } else {
        None
    }
    let _ = take to
    if let None = extra { return Some(await_primary(from)) }
    let mut primary = take main_probe
    let mut primary_fault: Option[harness.ModelFault] = None
    while let Ok(take event) = channel.receive(from) {
        match take event {
            Probe(true, Ok(take ready)) => {
                task.cancel(mut primary)
                return Some(Ok(take ready))
            },
            Probe(false, Ok(take ready)) => {
                if let Some(mut other) = extra { task.cancel(mut other) }
                return Some(Ok(take ready))
            },
            Probe(false, Error(take fault)) => { primary_fault = Some(take fault) },
            _ => (),
        }
    }
    Some(Error(match take primary_fault {
        Some(take fault) => take fault,
        None => StreamDropped("model worker lost both responses"),
    }))
}

pub fn ask_hedged(w: Worker, n: Net, clock: Clock, p: Provider, take req: harness.Request,
    mut sink: Option[preview.Source], permit: harness.Hedge) -> Result[harness.Answer, harness.ModelFault] waits {
    if !req.stream { return ask_with_preview(n, clock, p, take req, mut sink) }
    let text = body(p.model, req) ?=> |why| Rejected(clone(why))
    let started = host.mono_ns(clock)
    let deadline = std.clock.deadline_after_ms(started, p.deadline_ms)
    if let Some(delay) = threshold(w) {
        if int.saturating_add(started, delay) < deadline {
            if let Some(take first) = race(w, n, clock, p, text, started, deadline, delay, harness.share_hedge(permit)) {
                let packet = match take first { Ok(take got) => take got, Error(take fault) => return Error(take fault) }
                let FirstBytes(response: take response, chunk: take chunk, started: start) = take packet
                let mut ready = take response
                return read_stream(mut ready.connection, p.model.dialect, p.bounds, ready.delay, mut sink, take chunk,
                    Some(TokenTiming(history: channel.sender(w.history), clock: clock, start: start)))
            }
        }
    }
    let mut response = open_stream(n, clock, p, text, deadline, Some(channel.sender(w.history)))?
    read_stream(mut response.connection, p.model.dialect, p.bounds, response.delay, mut sink, list.with_capacity(8192u64),
        Some(TokenTiming(history: channel.sender(w.history), clock: clock, start: started)))
}

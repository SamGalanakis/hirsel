// L42. A pin and a journaled sibling still own the indexed collection after
// dropping it from main. Their two versions use 2*94 + 2*86 bytes.
fn journaled_branch_drop(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let options = journal_crash_options()
    let mut db = open(tasks, d, c, r, options)?
    law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let mut rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let by = code.describe(crash_value)
    let (_, ix) = law_indexed(mut db, "rows", std.codec.key_u64(), std.codec.of_u64(), "iv", by, std.codec.key_u64())?
    if !typed_put(mut db, rows, 1, 11) {
        return Error(Foreign)
    }
    let original = snapshot(db)
    let _ = pin(mut db, "saved", original)?
    let (beta, forked) = fork(mut db, "beta", original)?
    if !covered(db, forked.mark) {
        return Error(Foreign)
    }
    if !typed_put(mut db, rows, 1, 12) {
        return Error(Foreign)
    }
    let updated = run_on(mut db, beta, None, rows, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 1, 13)
    })?
    let Committed(_) = updated else {
        return Error(Foreign)
    }
    let sh: Table[u64, u64] = clone(rows)
    let first = manifest.pack_next(disk_state(db).packs)
    let _ = law_drop(mut db, tasks)?
    let after = manifest.pack_next(disk_state(db).packs)
    let mut stamps: Map[u64, ()] = map.new()
    for seq in first .. after {
        let raw = failure_result_from_rep(manifest.disk_read_file(d, failure_result_from_rep(types.capacity(manifest.disk_path("p-", seq, "")))?, 8500))?
        let mut at = 72u64
        while at < list.len(raw) {
            let kind = format.read_le(raw, at, 2)
            let stamp = format.read_le(raw, at + (if kind == 33 {
                24u64
            } else {
                16u64
            }), 8)
            if map.contains(stamps, stamp) {
                return Error(Foreign)
            }
            map.insert(mut stamps, stamp, ())
            at += 16 + format.read_le(raw, at + 4, 4)
        }
    }
    let page_record = failure_result_from_rep(manifest.disk_read_file(d, "MANIFEST", 4096))?
    // The index catalog key is 1 + 4 + 2 bytes. The value's 44 fixed bytes
    // include the index kind, payload count and two empty projection fields.
    // A disk value holds the composite identity: the extractor's 32-byte code
    // revision, then a 32-byte storage fingerprint for each of K, V, J and P.
    let schema = std.codec.key_schema(std.codec.key_u64()) ?=> |_| Schema(0)
    let index_charge = 62 + format.round8(7 + 44 + list.len(schema) + list.len(code.identity(by)) + 160)
    let logical = 2 * 126 + 2 * 94 + 2 * 86 + 134 + index_charge
    if format.read_le(page_record, 152, 8) != logical {
        return Error(Foreign)
    }
    close(take db)?
    let reopened = open(tasks, d, c, r, options)?
    if reopened.resident != logical {
        return Error(Foreign)
    }
    if let Error(Stale(_)) = get(result.unwrap(reader(reopened, 0u64)), snapshot(reopened), sh, 1) {} else {
        return Error(Foreign)
    }
    let saved = option.unwrap(pinned(reopened, "saved"))
    let sibling = snapshot_of(reopened, beta)?
    if get(result.unwrap(reader(reopened, 0u64)), saved, sh, 1)? != Some(11u64) || get(result.unwrap(reader(reopened, 0u64)), sibling, sh, 1)? != Some(13u64) {
        return Error(Foreign)
    }
    let mut in_pin = find(result.unwrap(reader(reopened, 0u64)), saved, ix, Included(11u64), Included(11u64))?
    let mut in_child = find(result.unwrap(reader(reopened, 0u64)), sibling, ix, Included(13u64), Included(13u64))?
    if next(law_reader(in_pin.capture), mut in_pin)? != Some((1u64, 11u64)) || next(law_reader(in_pin.capture), mut in_pin)? != None || next(law_reader(in_child.capture), mut in_child)? != Some((1u64, 13u64)) || next(law_reader(in_child.capture), mut in_child)? != None {
        return Error(Foreign)
    }
    close(take reopened)
}


// Module `float`, extended (LANG-7): library members of the core module `float` (SEM-2),
// over its core conversions (from_int, to_int, widen, narrow, to_bits32/64,
// from_bits32/64; core/core/float.hirsel).
//
// A library function cannot be generic over f32 and f64: no bound names the float types
// (OWN-4), so each operation is written at each width it serves, as Go's ParseFloat takes
// a bit size. An f32 result is not `float.narrow` of the f64 one: that rounds twice.
//
// Parsing (Rust core::num::dec2flt, Go strconv.ParseFloat). The decimal mantissa is read
// into a u64 (19 significant digits) and a decimal exponent.
//  1. Exact fast path (Clinger): mantissa below 2^53 (f32: 2^24) and |exponent| <= 22
//     (f32: 10): `float.from_int` of the mantissa, multiplied or divided by an exact power
//     of ten, which IEEE rounds once.
//  2. Eisel-Lemire: a 128-bit product of the mantissa and a truncated power of five
//     (`int.mul_wide`), assembled into the result's bits and made with
//     `float.from_bits64` (`from_bits32`). The 651 powers of five, two u64 words each, are
//     derived at compile time in `WIDE_POWER5.parse`.
//  3. Slow path, when step 2 cannot decide the rounding (more than 19 significant digits
//     near a halfway point): a big decimal of at most 768 significant digits, shifted by
//     powers of two, held in a local `Inline[u8, 768]` as Rust holds it on the stack.
//     No step allocates, so parsing returns only ParseError.
/// Parses the whole of s as a decimal f64: an optional '-', digits with an optional
/// fraction, an optional exponent (the JSON number grammar plus a leading '+' in the
/// exponent; "inf", "nan", '+' before the number and hex are refused). Correctly rounded,
/// ties to even.
/// Fails: Error(Empty | Invalid(i)), i the byte position; Error(OutOfRange)
/// when the value rounds to an infinity (Go returns ErrRange there; Rust returns inf).
/// A value too small rounds to a signed zero and is Ok. Alloc: nothing.
/// Cost: O(len); step 3 is O(digits x shifts), at most about 768 x 30 digit steps.
/// Ex: `let x = float.parse64(token)?`
pub fn parse64(s: String) -> Result[f64, ParseError] {
    let n = scan(s)?
    if !n.many && n.exponent >= -22 && n.exponent <= 22 && n.mantissa <= 9007199254740992 {
        let mut v: f64 = float.from_int(n.mantissa)
        if n.exponent < 0 {
            let k: u64 = int.narrow(-n.exponent)
            v = v / POW10_64[k]
        } else {
            let k: u64 = int.narrow(n.exponent)
            v = v * POW10_64[k]
        }
        return Ok(if n.negative {
            -v
        } else {
            v
        })
    }
    let fmt = format64()
    let (m, e) = decide(fmt, s, n)
    if e == fmt.inf {
        return Error(OutOfRange)
    }
    let biased: u64 = int.narrow(e)
    let sign: u64 = if n.negative {
        1
    } else {
        0
    }
    Ok(float.from_bits64(m | (biased << 52) | (sign << 63)))
}

/// As parse64, rounded once to f32. Ex: `let y = float.parse32(token)?`
pub fn parse32(s: String) -> Result[f32, ParseError] {
    let n = scan(s)?
    if !n.many && n.exponent >= -10 && n.exponent <= 10 && n.mantissa <= 16777216 {
        let mut v: f32 = float.from_int(n.mantissa)
        if n.exponent < 0 {
            let k: u64 = int.narrow(-n.exponent)
            v = v / POW10_32[k]
        } else {
            let k: u64 = int.narrow(n.exponent)
            v = v * POW10_32[k]
        }
        return Ok(if n.negative {
            -v
        } else {
            v
        })
    }
    let fmt = format32()
    let (m, e) = decide(fmt, s, n)
    if e == fmt.inf {
        return Error(OutOfRange)
    }
    let low: u32 = int.narrow(m)
    let biased: u32 = int.narrow(e)
    let sign: u32 = if n.negative {
        1
    } else {
        0
    }
    Ok(float.from_bits32(low | (biased << 23) | (sign << 31)))
}

/// Whether x is neither infinite nor NaN: its exponent bits (`float.to_bits64`) are not
/// all ones. For an f32 use `float.is_finite(float.widen(x))`, which is exact.
/// Cost: O(1). Ex: `float.is_finite(x)`
pub fn is_finite(x: f64) -> bool {
    float.to_bits64(x) & 0x7ff0000000000000 != 0x7ff0000000000000
}

// The parse, after Rust's core::num::dec2flt (itself after fast_float and Go's strconv).
/// One float width's parameters, as Rust's RawFloat constants.
type Format {
    bits: u64, // explicit mantissa bits
    min_exp: i64, // the exponent bias, negated
    inf: i64, // the biased exponent of the infinities
    smallest10: i64, // below this decimal exponent every value rounds to zero
    largest10: i64, // above it every value but zero rounds to an infinity
    even_lo: i64, // the decimal exponents where a product can be exactly halfway
    even_hi: i64,
}

fn format64() -> Format {
    Format(bits: 52, min_exp: -1023, inf: 2047, smallest10: -342, largest10: 308, even_lo: -4, even_hi: 23)
}

fn format32() -> Format {
    Format(bits: 23, min_exp: -127, inf: 255, smallest10: -65, largest10: 38, even_lo: -17, even_hi: 10)
}

/// The number as scanned: its first 19 significant digits and a decimal exponent, so the
/// value lies in [mantissa, mantissa + 1) x 10^exponent, exactly mantissa x 10^exponent
/// unless `many` (more than 19 significant digits). `at` is the first byte after the sign.
type Scanned {
    negative: bool,
    mantissa: u64,
    exponent: i64,
    many: bool,
    at: u64,
    written: WrittenExponent
}

type WrittenExponent {
    magnitude: u64,
    negative: bool,
}

// Beyond this margin both conversion paths have settled overflow or underflow.
const EXPONENT_MARGIN: u64 = 400

fn add_written(point: i64, written: WrittenExponent) -> i64 {
    if written.magnitude == 0 {
        return point
    }
    let mut negative = point < 0
    let magnitude: u64 = int.narrow(if negative {
        -point
    } else {
        point
    })
    let combined = if negative == written.negative {
        int.saturating_add(magnitude, written.magnitude)
    } else if magnitude < written.magnitude {
        negative = written.negative
        written.magnitude - magnitude
    } else {
        magnitude - written.magnitude
    }
    let bounded: i64 = if combined > EXPONENT_MARGIN {
        int.narrow(EXPONENT_MARGIN)
    } else {
        int.narrow(combined)
    }
    if negative {
        -bounded
    } else {
        bounded
    }
}

/// Scans s against the grammar: '-'?, '0' or a non-zero digit and digits, then optionally
/// '.' and digits, then optionally 'e' or 'E', a sign and digits, and nothing after.
/// As Rust's parse_number: every digit goes into a wrapping u64, eight at a time where
/// eight are there, and the exponent is the fraction's length; only a number of more than
/// 19 significant digits, whose wrapped mantissa is wrong, is scanned again (`long`).
fn scan(s: String) -> Result[Scanned, ParseError] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if n == 0 {
        return Error(Empty)
    }
    let negative = b[0] == b'-'
    let at: u64 = if negative {
        1
    } else {
        0
    }
    let mut i = at
    if i >= n || !int.is_ascii_digit(b[i]) {
        return Error(Invalid(i))
    }
    let mut mantissa: u64 = 0
    if b[i] == b'0' {
        i += 1
    } else {
        let (end, x) = accumulate(b, i, 0)
        i = end
        mantissa = x
    }
    let mut count = i - at
    let mut exponent: i64 = 0
    if i < n && b[i] == b'.' {
        i += 1
        let first = i
        let (end, x) = accumulate(b, i, mantissa)
        i = end
        mantissa = x
        if i == first {
            return Error(Invalid(i))
        }
        count += i - first
        let places: i64 = int.narrow(i - first)
        exponent = -places
    }
    let mut written = WrittenExponent(magnitude: 0, negative: false)
    if i < n && (b[i] == b'e' || b[i] == b'E') {
        i += 1
        written.negative = i < n && b[i] == b'-'
        if i < n && (b[i] == b'-' || b[i] == b'+') {
            i += 1
        }
        if i >= n || !int.is_ascii_digit(b[i]) {
            return Error(Invalid(i))
        }
        // A point displacement cannot exceed the number of significand digits.
        // A magnitude past this limit stays out of range after any cancellation.
        let limit = count + EXPONENT_MARGIN
        while i < n && int.is_ascii_digit(b[i]) {
            if written.magnitude < limit {
                let digit: u64 = int.widen(b[i] - b'0')
                let next = int.saturating_add(int.saturating_mul(written.magnitude, 10), digit)
                written.magnitude = if next > limit {
                    limit
                } else {
                    next
                }
            }
            i += 1
        }
    }
    if i < n {
        return Error(Invalid(i))
    }
    if count > 19 {
        // Leading zeros (and the point among them) are not significant.
        let mut j = at
        while j < n && (b[j] == b'0' || b[j] == b'.') {
            if b[j] == b'0' {
                count -= 1
            }
            j += 1
        }
        if count > 19 {
            return Ok(long(b, negative, at, written))
        }
    }
    Ok(Scanned(negative, mantissa, exponent: add_written(exponent, written), many: false, at, written))
}

/// The digits of b from i accumulated onto x, wrapping (the caller rescans past 19
/// significant digits), and the index of the first byte that is not a digit.
fn accumulate(b: Bytes, i: u64, from: u64) -> (u64, u64) {
    let n = list.len(b)
    let mut x = from
    let mut k = i
    while k + 8 <= n {
        let w = list.word_le(b, k)
        if (int.wrapping_add(w, 0x4646464646464646) | int.wrapping_sub(w, 0x3030303030303030)) & 0x8080808080808080 != 0 {
            break
        }
        x = int.wrapping_add(int.wrapping_mul(x, 100000000), eight(w))
        k += 8
    }
    while k < n {
        let d = int.wrapping_sub(b[k], b'0')
        if d >= 10 {
            break
        }
        let wide: u64 = int.widen(d)
        x = int.wrapping_add(int.wrapping_mul(x, 10), wide)
        k += 1
    }
    (k, x)
}

/// The value of eight ASCII digits read little-endian, the first digit most significant
/// (Rust's parse_8digits): pairs, then fours, then the eight, by multiply-and-shift.
fn eight(w: u64) -> u64 {
    let v = w - 0x3030303030303030
    let pairs = int.wrapping_mul(v, 10) + (v >> 8)
    let low = int.wrapping_mul(pairs & 0x000000FF000000FF, 0x000F424000000064)
    let high = int.wrapping_mul((pairs >> 16) & 0x000000FF000000FF, 0x0000271000000001)
    (int.wrapping_add(low, high) >> 32) & 0xFFFFFFFF
}

/// A number of more than 19 significant digits, already checked against the grammar,
/// scanned again as Rust's: its first 19 significant digits (leading zeros leave the
/// mantissa 0), the exponent they leave, and `many`; `written` is the explicit exponent.
fn long(b: Bytes, negative: bool, at: u64, written: WrittenExponent) -> Scanned {
    let n = list.len(b)
    let mut x: u64 = 0
    let mut i = at
    while i < n && int.is_ascii_digit(b[i]) && x < 1000000000000000000 {
        let wide: u64 = int.widen(b[i] - b'0')
        x = x * 10 + wide
        i += 1
    }
    let mut exponent: i64 = 0
    if x >= 1000000000000000000 {
        // 19 digits in the integer part: the rest of it only scales.
        let mut j = i
        while j < n && int.is_ascii_digit(b[j]) {
            j += 1
        }
        exponent = int.narrow(j - i)
    } else {
        // Fewer: the rest are in the fraction, after the point at i.
        i += 1
        let first = i
        while i < n && int.is_ascii_digit(b[i]) && x < 1000000000000000000 {
            let wide: u64 = int.widen(b[i] - b'0')
            x = x * 10 + wide
            i += 1
        }
        let places: i64 = int.narrow(i - first)
        exponent = -places
    }
    Scanned(negative, mantissa: x, exponent: add_written(exponent, written), many: true, at, written)
}

/// The rounded (mantissa, biased exponent) of a scanned number that missed the exact fast
/// path: Eisel-Lemire, then the big decimal when Lemire cannot decide. An exponent of
/// fmt.inf is an infinity.
fn decide(fmt: Format, s: String, n: Scanned) -> (u64, i64) {
    let (m, e) = lemire(fmt, n.exponent, n.mantissa)
    if e >= 0 {
        if !n.many {
            return (m, e)
        }
        // The value lies in [mantissa, mantissa + 1) x 10^exponent: decided when both ends
        // round alike.
        let (m1, e1) = lemire(fmt, n.exponent, n.mantissa + 1)
        if m1 == m && e1 == e {
            return (m, e)
        }
    }
    slow(fmt, string.as_bytes(s), n.at, n.written)
}

const ALL_ONES: u64 = 0xffffffffffffffff

/// Eisel-Lemire: w x 10^q rounded to fmt as (mantissa, biased exponent), or an exponent of
/// -1 when the truncated power of five cannot decide the rounding.
fn lemire(fmt: Format, q: i64, w: u64) -> (u64, i64) {
    if w == 0 || q < fmt.smallest10 {
        return (0, 0)
    }
    if q > fmt.largest10 {
        return (0, fmt.inf)
    }
    let lz = leading_zeros(w)
    let (lo, hi) = product(q, w << lz, fmt.bits + 3)
    if lo == ALL_ONES && (q < -27 || q > 55) {
        return (0, -1)
    }
    let upper = hi >> 63
    let s = upper + 64 - fmt.bits - 3
    let mut m = hi >> s
    let up: i64 = int.narrow(upper)
    let zeros: i64 = int.narrow(lz)
    let mut p2 = power(q) + up - zeros - fmt.min_exp
    let hidden: u64 = 1 << fmt.bits
    if p2 <= 0 {
        // Subnormal: shift into place, round half up on the bit below, and a mantissa
        // that carried into the hidden bit is the smallest normal.
        if 1 - p2 >= 64 {
            return (0, 0)
        }
        let k: u64 = int.narrow(1 - p2)
        m = m >> k
        m += m & 1
        m = m >> 1
        let e: i64 = if m >= hidden {
            1
        } else {
            0
        }
        return (m, e)
    }
    // Exactly halfway between two floats: round to even, not up.
    if lo <= 1 && q >= fmt.even_lo && q <= fmt.even_hi && m & 3 == 1 && m << s == hi {
        m = m & ~1
    }
    m += m & 1
    m = m >> 1
    if m >= hidden << 1 {
        m = hidden
        p2 += 1
    }
    if m >= hidden {
        m -= hidden
    }
    if p2 >= fmt.inf {
        return (0, fmt.inf)
    }
    (m, p2)
}

/// floor(log2(10^q)) + 63, for q in -342..=308.
fn power(q: i64) -> i64 {
    (int.wrapping_mul(q, 217706) >> 16) + 63
}

/// The high 64 bits of w x 5^q (w normalized), in two products only when the first leaves
/// the bits below `precision` undecided; returned (low, high) as Rust's.
fn product(q: i64, w: u64, precision: u64) -> (u64, u64) {
    let mask = ALL_ONES >> precision
    let index: u64 = int.narrow(q + 342)
    let (hi5, lo5) = WIDE_POWER5.parse[index]
    let (hi, lo) = int.mul_wide(w, hi5)
    let mut high = hi
    let mut low = lo
    if high & mask == mask {
        let (carry, _) = int.mul_wide(w, lo5)
        low = int.wrapping_add(low, carry)
        if carry > low {
            high += 1
        }
    }
    (low, high)
}

/// The leading zero bits of x, which is not 0.
fn leading_zeros(x: u64) -> u64 {
    int.widen(int.leading_zeros(x))
}

// The slow path: the digits as a big decimal, shifted by powers of two until it is in
// [1/2, 1), then by the mantissa width, and rounded (Rust dec2flt's slow.rs and decimal.rs,
// Go's decimal.go). Digits past 768 are dropped and remembered in `truncated`.
const DIGITS: u64 = 768

/// 0.d[0]d[1]..d[count-1] x 10^point, each d a digit value.
type Decimal {
    digits: Inline[u8, 768],
    count: u64,
    point: i64,
    truncated: bool
}

/// The binary shift that moves the decimal point by at most n places, 60 past 18.
const SHIFTS: Inline[u64, 19] = decimal_shifts()

fn decimal_shifts() -> Inline[u64, 19] {
    let mut shifts: Inline[u64, 19] =[0; 19]
    let mut ten_to_i: u64 = 1
    for i in 1u64 .. 19 {
        ten_to_i *= 10
        shifts[i] = 63 - leading_zeros(ten_to_i)
    }
    shifts
}

fn shift_for(n: i64) -> u64 {
    if n < 19 {
        let k: u64 = int.narrow(n)
        SHIFTS[k]
    } else {
        60
    }
}

fn slow(fmt: Format, b: Bytes, at: u64, written: WrittenExponent) -> (u64, i64) {
    let mut d = decimal(b, at, written)
    if d.count == 0 || d.point < -324 {
        return (0, 0)
    }
    if d.point >= 310 {
        return (0, fmt.inf)
    }
    let mut e2: i64 = 0
    while d.point > 0 {
        let k = shift_for(d.point)
        shift_right(mut d, k)
        if d.point < -2047 {
            return (0, 0)
        }
        let step: i64 = int.narrow(k)
        e2 += step
    }
    while d.point <= 0 {
        let k: u64 = if d.point == 0 {
            if d.digits[0] >= 5 {
                break
            }
            if d.digits[0] <= 1 {
                2
            } else {
                1
            }
        } else {
            shift_for(-d.point)
        }
        shift_left(mut d, k)
        if d.point > 2047 {
            return (0, fmt.inf)
        }
        let step: i64 = int.narrow(k)
        e2 -= step
    }
    e2 -= 1
    while fmt.min_exp + 1 > e2 {
        let mut k = fmt.min_exp + 1 - e2
        if k > 60 {
            k = 60
        }
        shift_right(mut d, int.narrow(k))
        e2 += k
    }
    if e2 - fmt.min_exp >= fmt.inf {
        return (0, fmt.inf)
    }
    shift_left(mut d, fmt.bits + 1)
    let mut m = round_decimal(d)
    let top: u64 = 1 << (fmt.bits + 1)
    if m >= top {
        shift_right(mut d, 1)
        e2 += 1
        m = round_decimal(d)
        if e2 - fmt.min_exp >= fmt.inf {
            return (0, fmt.inf)
        }
    }
    let mut p2 = e2 - fmt.min_exp
    let hidden: u64 = 1 << fmt.bits
    if m < hidden {
        p2 -= 1
    }
    (m & (hidden - 1), p2)
}

/// The digits of b[at..], which `scan` accepted, as a Decimal.
fn decimal(b: Bytes, at: u64, written: WrittenExponent) -> Decimal {
    let mut d = Decimal(digits:[0; 768], count: 0, point: 0, truncated: false)
    let n = list.len(b)
    let mut i = at
    while i < n && b[i] == b'0' {
        i += 1
    }
    while i < n && int.is_ascii_digit(b[i]) {
        add_digit(mut d, b[i] - b'0')
        i += 1
    }
    if i < n && b[i] == b'.' {
        i += 1
        let first = i
        if d.count == 0 {
            while i < n && b[i] == b'0' {
                i += 1
            }
        }
        while i < n && int.is_ascii_digit(b[i]) {
            add_digit(mut d, b[i] - b'0')
            i += 1
        }
        let read: i64 = int.narrow(i - first)
        d.point = -read
    }
    if d.count != 0 {
        // Trailing zeros are not digits.
        let mut zeros: u64 = 0
        let mut j = i
        while j > at {
            j -= 1
            if b[j] == b'0' {
                zeros += 1
            } else if b[j] != b'.' {
                break
            }
        }
        d.count -= zeros
        let moved: i64 = int.narrow(zeros + d.count)
        d.point += moved
        if d.count > DIGITS {
            d.truncated = true
            d.count = DIGITS
        }
    }
    d.point = add_written(d.point, written)
    d
}

/// Appends digit x; past DIGITS only the count grows.
fn add_digit(mut d: Decimal, x: u8) {
    if d.count < DIGITS {
        d.digits[d.count] = x
    }
    d.count += 1
}

fn trim(mut d: Decimal) {
    while d.count != 0 && d.digits[d.count - 1] == 0 {
        d.count -= 1
    }
}

/// The integer part of d, rounded half to even; all ones when it has more than 18 digits.
fn round_decimal(d: Decimal) -> u64 {
    if d.count == 0 || d.point < 0 {
        return 0
    }
    if d.point > 18 {
        return ALL_ONES
    }
    let dp: u64 = int.narrow(d.point)
    let mut v: u64 = 0
    for i in 0 .. dp {
        v = v * 10
        if i < d.count {
            let x: u64 = int.widen(d.digits[i])
            v += x
        }
    }
    let mut up = false
    if dp < d.count {
        up = d.digits[dp] >= 5
        if d.digits[dp] == 5 && dp + 1 == d.count {
            up = d.truncated || (dp != 0 && d.digits[dp - 1] & 1 != 0)
        }
    }
    if up {
        v += 1
    }
    v
}

/// d divided by 2^k, k at most 60.
///
/// Every `10 * v + x` here has v below 2^k <= 2^60 and x <= 9, so it is below 2^64 - 2^62 and
/// the wrapping forms are exact (Rust's dec2flt decimal.rs uses plain arithmetic here too).
/// Checked forms would add an unreachable overflow branch to each digit step.
fn shift_right(mut d: Decimal, k: u64) {
    let mut r: u64 = 0
    let mut w: u64 = 0
    let mut v: u64 = 0
    while v >> k == 0 {
        if r < d.count {
            let x: u64 = int.widen(d.digits[r])
            v = int.wrapping_add(int.wrapping_mul(v, 10), x)
            r += 1
        } else if v == 0 {
            return
        } else {
            while v >> k == 0 {
                v = int.wrapping_mul(v, 10)
                r += 1
            }
            break
        }
    }
    let consumed: i64 = int.narrow(r)
    d.point -= consumed - 1
    if d.point < -2047 {
        d.count = 0
        d.point = 0
        d.truncated = false
        return
    }
    let mask: u64 = (1 << k) - 1
    while r < d.count {
        let x: u64 = int.widen(d.digits[r])
        let next: u8 = int.narrow(v >> k)
        v = int.wrapping_add(int.wrapping_mul(v & mask, 10), x)
        r += 1
        d.digits[w] = next
        w += 1
    }
    while v > 0 {
        let next: u8 = int.narrow(v >> k)
        v = int.wrapping_mul(v & mask, 10)
        if w < DIGITS {
            d.digits[w] = next
            w += 1
        } else if next > 0 {
            d.truncated = true
        }
    }
    d.count = w
    trim(mut d)
}

/// d multiplied by 2^k, k at most 60, written from the last digit back.
fn shift_left(mut d: Decimal, k: u64) {
    if d.count == 0 {
        return
    }
    let added = new_digits(d, k)
    let mut r = d.count
    let mut w = d.count + added
    let mut v: u64 = 0
    while r != 0 {
        r -= 1
        w -= 1
        let x: u64 = int.widen(d.digits[r])
        v += x << k
        let quotient = v / 10
        let digit: u8 = int.narrow(v - 10 * quotient)
        if w < DIGITS {
            d.digits[w] = digit
        } else if digit > 0 {
            d.truncated = true
        }
        v = quotient
    }
    while v > 0 {
        w -= 1
        let quotient = v / 10
        let digit: u8 = int.narrow(v - 10 * quotient)
        if w < DIGITS {
            d.digits[w] = digit
        } else if digit > 0 {
            d.truncated = true
        }
        v = quotient
    }
    d.count += added
    if d.count > DIGITS {
        d.count = DIGITS
    }
    let grown: i64 = int.narrow(added)
    d.point += grown
    trim(mut d)
}

/// How many digits multiplying d by 2^k adds in front: k + 1 - len(5^k), less one when
/// d's digits are below those of 5^k (Rust and Go read this from a table; here the digits
/// of 5^k are computed, at most 42 of them).
fn new_digits(d: Decimal, k: u64) -> u64 {
    let mut p: Inline[u8, 42] =[0; 42]
    p[0] = 1
    let mut len: u64 = 1
    for _ in 0 .. k {
        // p = p x 5, from the last digit back.
        let mut carry: u8 = 0
        let mut i = len
        while i > 0 {
            i -= 1
            let x = p[i] * 5 + carry
            p[i] = x % 10
            carry = x / 10
        }
        if carry > 0 {
            let mut j = len
            while j > 0 {
                p[j] = p[j - 1]
                j -= 1
            }
            p[0] = carry
            len += 1
        }
    }
    let whole = k + 1 - len
    for i in 0 .. len {
        if i >= d.count {
            return whole - 1
        }
        if d.digits[i] != p[i] {
            return if d.digits[i] < p[i] {
                whole - 1
            } else {
                whole
            }
        }
    }
    whole
}

/// Exact powers of ten for the fast path.
const POW10_64: Inline[f64, 23] = exact_powers10_64()

fn exact_powers10_64() -> Inline[f64, 23] {
    let mut powers: Inline[f64, 23] =[1.0; 23]
    let mut value: f64 = 1.0
    for i in 1u64 .. 23 {
        value *= 10.0
        powers[i] = value
    }
    powers
}

const POW10_32: Inline[f32, 11] = exact_powers10_32()

fn exact_powers10_32() -> Inline[f32, 11] {
    let mut powers: Inline[f32, 11] =[1.0; 11]
    let mut value: f32 = 1.0
    for i in 1u64 .. 11 {
        value *= 10.0
        powers[i] = value
    }
    powers
}

/// Appends x as Rust's `{}` prints an f64: the shortest decimal that parses back to x
/// (`shortest64`), never in exponent form: "0.1", "1", "-0", "1000000000000000000000",
/// "0.000001"; "NaN", "inf", "-inf". Fails: Error(c); s then holds a prefix of the text.
/// Alloc: GROWTH of s only. Cost: O(digits of x).
/// Ex: `float.push_f64(mut line, 0.1)` appends "0.1"
pub fn push_f64(mut s: String, x: f64) {
    push_shortest(mut s, x, false)
}

/// Appends the shortest round-trip number with serde_json's spelling. Finite
/// values keep a fractional digit in integral decimal form and use scientific
/// notation below 1e-5 or at or above 1e16. Nonfinite values append null.
/// Fails: Error(c); s then holds a prefix of the text. Alloc: GROWTH of s only.
/// Cost: O(digits).
pub fn push_json_f64(mut s: String, x: f64) {
    push_shortest(mut s, x, true)
}

// Append to the String directly so the plain writer keeps its append path.
fn push_shortest(mut s: String, x: f64, json: bool) {
    let bits = float.to_bits64(x)
    if !is_finite(x) {
        return string.push(mut s, if json {
            "null"
        } else {
            special(bits)
        })
    }
    if bits >> 63 != 0 {
        string.push(mut s, "-")
    }
    let (c, p) = shortest64(x)
    if c == 0 {
        return string.push(mut s, if json {
            "0.0"
        } else {
            "0"
        })
    }
    let layout = shortest_layout(c, p, json)
    if layout.whole != 0 {
        string.push_u64(mut s, layout.whole)
    }
    if layout.fractional {
        string.push(mut s, decimal_point(layout.whole))
    }
    push_zeros(mut s, layout.zeros)
    if layout.fractional {
        string.push_u64(mut s, layout.fraction)
    } else if json && !layout.scientific {
        string.push(mut s, ".0")
    }
    if layout.scientific {
        let (sign, digits) = exponent_parts(layout.point - 1)
        string.push(mut s, sign)
        string.push_u64(mut s, digits)
    }
}

/// Writes the JSON number using callbacks for literal text and unpadded decimal digits.
pub fn write_json_f64[T](mut out: T, x: f64, text: scoped fn(mut T, String), digits: scoped fn(mut T, u64)) {
    let bits = float.to_bits64(x)
    if !is_finite(x) {
        return text(mut out, "null")
    }
    if bits >> 63 != 0 {
        text(mut out, "-")
    }
    let (c, p) = shortest64(x)
    if c == 0 {
        return text(mut out, "0.0")
    }
    let layout = shortest_layout(c, p, true)
    if layout.whole != 0 {
        digits(mut out, layout.whole)
    }
    if layout.fractional {
        text(mut out, decimal_point(layout.whole))
    }
    write_zeros(mut out, layout.zeros, text)
    if layout.fractional {
        digits(mut out, layout.fraction)
    } else if !layout.scientific {
        text(mut out, ".0")
    }
    if layout.scientific {
        let (sign, magnitude) = exponent_parts(layout.point - 1)
        text(mut out, sign)
        digits(mut out, magnitude)
    }
}

type ShortestLayout {
    whole: u64,
    fraction: u64,
    fractional: bool,
    zeros: u64,
    scientific: bool,
    point: i64
}

fn shortest_layout(c: u64, p: i64, json: bool) -> ShortestLayout {
    let len = decimal_len(c)
    let width: i64 = int.narrow(len)
    let point = width + p
    let scientific = json && (point <= -5 || point > 16)
    let mut whole = c
    let mut fraction: u64 = 0
    let mut places: u64 = 0
    if !scientific && point <= 0 {
        let lead: u64 = int.narrow(-point)
        whole = 0
        fraction = c
        places = len + lead
    } else if scientific || point < width {
        places = if scientific {
            len - 1
        } else {
            int.narrow(width - point)
        }
        let scale = POW10_U64[places]
        whole = c / scale
        fraction = c % scale
    }
    let zeros: u64 = if places != 0 {
        places - decimal_len(fraction)
    } else if scientific {
        0
    } else {
        int.narrow(p)
    }
    ShortestLayout(whole, fraction, fractional: places != 0, zeros, scientific, point)
}

fn decimal_point(whole: u64) -> String {
    if whole == 0 {
        "0."
    } else {
        "."
    }
}

fn exponent_parts(exponent: i64) -> (String, u64) {
    // serde_json 1.0.154 uses Zmij's signed exponent spelling.
    if exponent < 0 {
        ("e-", int.narrow(-exponent))
    } else {
        ("e+", int.narrow(exponent))
    }
}

/// The number of decimal digits push_u64 writes for v: 1 for 0.
fn decimal_len(v: u64) -> u64 {
    // Treat zero as one. For other values the low bit cannot cross a power of ten.
    let value = v | 1
    let bits = 64 - leading_zeros(value)
    // For bit widths 1 through 64 this is floor(bits * log10(2)).
    // Values of one bit width span at most one decimal boundary.
    let digits = (bits * 1233) >> 12
    if value < POW10_U64[digits] {
        digits
    } else {
        digits + 1
    }
}

fn push_zeros(mut s: String, n: u64) {
    let zeros = "00000000000000000000000000000000"
    let mut left = n
    while left > 32 {
        string.push(mut s, zeros)
        left -= 32
    }
    if left == 0 {
        return
    }
    string.push(mut s, string.slice(zeros, 0, left))
}

fn write_zeros[T](mut s: T, n: u64, text: scoped fn(mut T, String)) {
    let zeros = "00000000000000000000000000000000"
    let mut left = n
    while left > 32 {
        text(mut s, zeros)
        left -= 32
    }
    if left == 0 {
        return
    }
    text(mut s, string.slice(zeros, 0, left))
}

/// Appends x rounded to `digits` places after the point, as Rust's `{:.N}` prints an f64:
/// the exact binary value rounded half to even, with no exponent and a '-' whenever x's
/// sign bit is set ("-0.0000000" for -0.00000001 at 7); "NaN", "inf", "-inf".
/// Fails: Error(c); s then holds a prefix of the text; Fail when the text length overflows
/// u64. Alloc: the text (at most 310 + digits bytes), then the push into s.
/// Cost: O(digits + digits of x).
/// Ex: `float.push_fixed64(mut line, 0.125, 2)` appends "0.12"
pub fn push_fixed64(mut s: String, x: f64, digits: u64) {
    let bits = float.to_bits64(x)
    if !is_finite(x) {
        return string.push(mut s, special(bits))
    }
    if bits >> 63 != 0 {
        string.push(mut s, "-")
    }
    let (m, e) = parts(bits)
    if let Some(q) = fixed_scaled(m, e, digits) {
        return push_scaled(mut s, q, digits)
    }
    push_fixed_decimal64(mut s, m, e, digits)
}

cold fn push_fixed_decimal64(mut s: String, m: u64, e: i64, digits: u64) {
    let d = exact(m, e)
    let whole: u64 = if d.count != 0 && d.point > 0 {
        int.narrow(d.point)
    } else {
        1
    }
    let total = match int.checked_add(whole, digits) {
        Some(t) => t,
        None => fail("float.push_fixed64: text length overflows u64"),
    }
    // o = a spare byte for a carry, the whole digits, then '.' and the places.
    let n = match int.checked_add(total, if digits > 0 {
        2
    } else {
        1
    }) {
        Some(t) => t,
        None => fail("float.push_fixed64: text length overflows u64"),
    }
    let mut o: Bytes = list.with_capacity(n)
    list.fill(mut o, n, b'0')
    if digits > 0 {
        o[1 + whole] = b'.'
    }
    // Output digit q has place 10^(whole - 1 - q); it is d's digit base + q.
    let lp: i64 = int.narrow(whole)
    let base = d.point - lp
    let count: i64 = int.narrow(d.count)
    let mut i: i64 = if base < 0 {
        0
    } else {
        base
    }
    let end: i64 = if base + int.narrow(total) < count {
        base + int.narrow(total)
    } else {
        count
    }
    while i < end {
        let q: u64 = int.narrow(i - base)
        let iu: u64 = int.narrow(i)
        o[place(q, whole)] = b'0' + d.digits[iu]
        i += 1
    }
    // The first dropped digit is d's digit p: round half to even on the exact value.
    let p = base + int.narrow(total)
    let mut up = false
    if p >= 0 && p < count {
        let pu: u64 = int.narrow(p)
        let dp = d.digits[pu]
        if dp > 5 {
            up = true
        } else if dp == 5 {
            up = pu + 1 < d.count || (pu > 0 && p - 1 >= base && d.digits[pu - 1] & 1 == 1)
        }
    }
    let mut start: u64 = 1
    if up {
        let mut q = total
        let mut carry = true
        while carry && q > 0 {
            q -= 1
            let at = place(q, whole)
            if o[at] == b'9' {
                o[at] = b'0'
            } else {
                o[at] += 1
                carry = false
            }
        }
        if carry {
            o[0] = b'1'
            start = 0
        }
    }
    let text = match string.from_utf8(take o) {
        Ok(take t) => take t,
        Error(_) => fail("float.push_fixed64: digits are ASCII"),
    }
    string.push(mut s, string.slice(text, start, n))
}

/// The shortest decimal that parses back to x, as (c, p) with |x| = c × 10^p and
/// no trailing zeros. When several shortest decimals round to x, choose the
/// nearest one, breaking decimal ties toward an even coefficient. (0, 0) for
/// either signed zero. Fails: Fail when x is not finite. Alloc: nothing.
/// Cost: O(1) for binary64.
/// Ex: `float.shortest64(0.3)` is (3, -1)
pub fn shortest64(x: f64) -> (u64, i64) {
    let bits = float.to_bits64(x)
    let biased: i64 = int.truncate((bits >> 52) & 0x7ff)
    if biased == 2047 {
        fail("float.shortest64: x is not finite")
    }
    let fraction = bits & 0xfffffffffffff
    if biased == 0 && fraction == 0 {
        return (0, 0)
    }
    ryu64(fraction, biased)
}

/// The shortest decimal that parses back to a finite f32, as (c, p) with
/// |x| = c × 10^p and no trailing zeros. (0, 0) for either signed zero.
/// Fails: Fail when x is not finite. Alloc: nothing. Cost: O(1) for binary32.
pub fn shortest32(x: f32) -> (u64, i64) {
    let bits = float.to_bits32(x)
    let biased: i64 = int.widen((bits >> 23) & 255)
    if biased == 255 {
        fail("float.shortest32: x is not finite")
    }
    let fraction = bits & 0x7fffff
    if biased == 0 && fraction == 0 {
        return (0, 0)
    }
    ryu32(fraction, biased)
}

// Binary32 interval scaling and digit removal adapted from Ryū f2s.rs.
// Copyright 2018 Ulf Adams, Apache-2.0. See third-party/NOTICES.md.
fn ryu32(fraction: u32, biased: i64) -> (u64, i64) {
    let (m, e) = if biased == 0 {
        (fraction, -151i64)
    } else {
        (fraction | 0x800000, biased - 152)
    }
    // Use two extra bits to represent both endpoints exactly. Only powers
    // of two above the smallest normal have a narrower gap below them.
    let center = m << 2
    let upper = center + 2
    let wider_below = fraction != 0 || biased <= 1
    let lower = center - if wider_below {
        2
    } else {
        1
    }
    let even = m & 1 == 0
    let mut vr: u32 = 0
    let mut vp: u32 = 0
    let mut vm: u32 = 0
    let mut vr_exact = false
    let mut vm_exact = false
    let mut last: u32 = 0
    let scale_power = if e >= 0 {
        let q = (e * 78913) >> 18
        let shift = q + ryu_pow5_bits(q) + 60 - e
        let factor = WIDE_POWER5.ryu32_inv[int.truncate(q)]
        vr = ryu32_mul_shift(center, factor, shift)
        vp = ryu32_mul_shift(upper, factor, shift)
        vm = ryu32_mul_shift(lower, factor, shift)
        if q != 0 && (vp - 1) / 10 <= vm / 10 {
            let finer = q - 1
            let finer_shift = finer + ryu_pow5_bits(finer) + 60 - e
            last = ryu32_mul_shift(center, WIDE_POWER5.ryu32_inv[int.truncate(finer)], finer_shift) % 10
        }
        if q <= 9 {
            let divisor: u32 = int.truncate(POW5_U64[int.truncate(q)])
            if center % 5 == 0 {
                vr_exact = center % divisor == 0
            } else if even {
                vm_exact = lower % divisor == 0
            } else if upper % divisor == 0 {
                vp -= 1
            }
        }
        q
    } else {
        let q = ((-e) * 732923) >> 20
        let i = -e - q
        let shift = q + 61 - ryu_pow5_bits(i)
        let factor = WIDE_POWER5.ryu32[int.truncate(i)]
        vr = ryu32_mul_shift(center, factor, shift)
        vp = ryu32_mul_shift(upper, factor, shift)
        vm = ryu32_mul_shift(lower, factor, shift)
        if q != 0 && (vp - 1) / 10 <= vm / 10 {
            let finer = i + 1
            let finer_shift = q + 60 - ryu_pow5_bits(finer)
            last = ryu32_mul_shift(center, WIDE_POWER5.ryu32[int.truncate(finer)], finer_shift) % 10
        }
        if q <= 1 {
            vr_exact = true
            if even {
                vm_exact = wider_below
            } else {
                vp -= 1
            }
        } else if q < 31 {
            let zero_bits: u32 = int.truncate(q - 1)
            vr_exact = (center & ((1u32 << zero_bits) - 1)) == 0
        }
        q + e
    }
    // Remove a digit while the resulting interval still contains a candidate.
    let mut removed: i64 = 0
    if vm_exact || vr_exact {
        while vp / 10 > vm / 10 {
            vm_exact = vm_exact && vm % 10 == 0
            vr_exact = vr_exact && last == 0
            last = vr % 10
            vr /= 10
            vp /= 10
            vm /= 10
            removed += 1
        }
        if vm_exact {
            while vm % 10 == 0 {
                vr_exact = vr_exact && last == 0
                last = vr % 10
                vr /= 10
                vm /= 10
                removed += 1
            }
        }
        if vr_exact && last == 5 && vr & 1 == 0 {
            last = 4
        }
    } else {
        while vp / 10 > vm / 10 {
            last = vr % 10
            vr /= 10
            vp /= 10
            vm /= 10
            removed += 1
        }
    }
    if (vr == vm && !vm_exact) || last >= 5 {
        vr += 1
    }
    strip(int.widen(vr), scale_power + removed)
}

// A power of five scaled into [2^182, 2^183) and rounded down in three
// base-2^61 limbs. Three spare bits per limb leave room to multiply by five
// or bring down a division remainder.
type Power5 {
    hi: u64,
    mid: u64,
    lo: u64,
}

const POWER5_ONE: Power5 = Power5(hi: 1u64 << 60, mid: 0, lo: 0)

const LIMB_MASK: u64 = (1u64 << 61) - 1

fn power5_mul(p: Power5, shift: u64) -> Power5 {
    let lo = p.lo * 5
    let mid = p.mid * 5 + (lo >> 61)
    let hi = p.hi * 5 + (mid >> 61)
    let join = 61 - shift
    let next_mid = ((hi << join) | ((mid & LIMB_MASK) >> shift)) & LIMB_MASK
    let next_lo = ((mid << join) | ((lo & LIMB_MASK) >> shift)) & LIMB_MASK
    Power5(hi: hi >> shift, mid: next_mid, lo: next_lo)
}

fn power5_div(p: Power5, shift: u64) -> Power5 {
    let join = 61 - shift
    let hi = (p.hi << shift) | (p.mid >> join)
    let mid = (((p.mid << shift) | (p.lo >> join)) & LIMB_MASK) | ((hi % 5) << 61)
    let lo = ((p.lo << shift) & LIMB_MASK) | ((mid % 5) << 61)
    Power5(hi: hi / 5, mid: mid / 5, lo: lo / 5)
}

// Each recurrence rounds down by less than one low-limb unit. Any later
// normalized power can amplify a unit by less than two, the ratio of
// two significands in [1, 2). After at most 342 steps the error is below
// 1024 units. Refuse if that error could change the top 128 bits.
fn power5_prefix(p: Power5) -> (u64, u64) {
    if (p.lo & ((1u64 << 55) - 1)) >= (1u64 << 55) - 1024 {
        core.fail("power of five needs more guard bits")
    }
    ((p.hi << 3) | (p.mid >> 58), (p.mid << 6) | (p.lo >> 55))
}

fn power5_round_up(hi: u64, lo: u64) -> (u64, u64) {
    let next = int.wrapping_add(lo, 1)
    (if next == 0 {
        hi + 1
    } else {
        hi
    }, next)
}

type WidePower5Tables {
    parse: Inline[(u64, u64), 651],
    ryu32: Inline[u64, 48],
    ryu32_inv: Inline[u64, 31],
    ryu64: Inline[(u64, u64), 326],
    ryu64_inv: Inline[(u64, u64), 291],
}

const WIDE_POWER5: WidePower5Tables = wide_power5_tables()

fn wide_power5_tables() -> WidePower5Tables {
    let mut tables = WidePower5Tables(
        parse:[(0, 0); 651],
        ryu32:[0; 48],
        ryu32_inv:[0; 31],
        ryu64:[(0, 0); 326],
        ryu64_inv:[(0, 0); 291],
    )
    // Ryū's reciprocal of 1 has one more bit than its other reciprocals.
    tables.ryu32_inv[0] = (1u64 << 61) + 1
    tables.ryu64_inv[0] = (1u64 << 61, 1)
    let mut p = POWER5_ONE
    let mut inv = POWER5_ONE
    let mut prev_bits: u64 = 1
    for q in 0u64 .. 343 {
        let bits: u64 = int.truncate(ryu_pow5_bits(int.truncate(q)))
        // The change in bit length determines how to renormalize both powers.
        let shift = bits - prev_bits
        if q < 326 {
            if q != 0 {
                p = power5_mul(p, shift)
            }
            let (hi, lo) = power5_prefix(p)
            if q <= 308 {
                tables.parse[342 + q] = (hi, lo)
            }
            if q < 48 {
                tables.ryu32[q] = hi >> 3
            }
            tables.ryu64[q] = (hi >> 3, (hi << 61) | (lo >> 3))
        }
        if q != 0 {
            inv = power5_div(inv, if q == 1 {
                bits
            } else {
                shift
            })
            let (hi, lo) = power5_prefix(inv)
            // The parser rounds its first 27 reciprocals up. Ryū rounds all
            // reciprocals up at its own precision.
            tables.parse[342 - q] = if q <= 27 {
                power5_round_up(hi, lo)
            } else {
                (hi, lo)
            }
            if q < 31 {
                tables.ryu32_inv[q] = (hi >> 3) + 1
            }
            if q < 291 {
                tables.ryu64_inv[q] = power5_round_up(hi >> 3, (hi << 61) | (lo >> 3))
            }
        }
        prev_bits = bits
    }
    tables
}

fn ryu_pow5_bits(n: i64) -> i64 {
    ((n * 1217359) >> 19) + 1
}

// The scaled value fits u32 and the shift is between 32 and 64. Each
// partial product fits u64, including their sum after dropping the low limb.
fn ryu32_mul_shift(m: u32, factor: u64, shift: i64) -> u32 {
    let value: u64 = int.widen(m)
    let low = int.wrapping_mul(value, factor & 0xffffffff)
    let high = int.wrapping_mul(value, factor >> 32)
    let sum = int.wrapping_add(high, low >> 32)
    let distance: u64 = int.truncate(shift - 32)
    int.truncate(sum >> distance)
}

fn special(bits: u64) -> String {
    if bits & 0xfffffffffffff != 0 {
        "NaN"
    } else if bits >> 63 != 0 {
        "-inf"
    } else {
        "inf"
    }
}

/// A finite f64's magnitude as m x 2^e.
fn parts(bits: u64) -> (u64, i64) {
    let biased = (bits >> 52) & 0x7ff
    let fraction = bits & 0xfffffffffffff
    if biased == 0 {
        (fraction, -1074)
    } else {
        let b: i64 = int.narrow(biased)
        (fraction | 4503599627370496, b - 1075)
    }
}

// Fixed-precision formatting follows Rust's core::num::flt2dec exact mode.
/// m x 2^e exactly, as a Decimal. A binary64 value has at most 767 significant digits.
fn exact(m: u64, e: i64) -> Decimal {
    let mut d = Decimal(digits:[0; 768], count: 0, point: 0, truncated: false)
    if m == 0 {
        return d
    }
    let mut t: Inline[u8, 20] =[0; 20]
    let len = digits_of(m, mut t)
    for i in 0 .. len {
        add_digit(mut d, t[i])
    }
    d.point = int.narrow(len)
    trim(mut d)
    let mut k = e
    while k > 0 {
        let step: i64 = if k > 60 {
            60
        } else {
            k
        }
        shift_left(mut d, int.narrow(step))
        k -= step
    }
    while k < 0 {
        let step: i64 = if k < -60 {
            60
        } else {
            -k
        }
        shift_right(mut d, int.narrow(step))
        k += step
    }
    d
}

/// The decimal digits of v > 0 into t, most significant first; returns their count.
fn digits_of(v: u64, mut t: Inline[u8, 20]) -> u64 {
    if v == 0 {
        return 0
    }
    let mut digits: Inline[u8, 64] =[0; 64]
    let start = int.radix_digits(v, 10, mut digits)
    for i in start .. 64 {
        t[i - start] = digits[i] - b'0'
    }
    64 - start
}

// 5^k for k in 0..=27, the powers below 2^64.
const POW5_U64: Inline[u64, 28] = integer_powers5()

fn integer_powers5() -> Inline[u64, 28] {
    let mut powers: Inline[u64, 28] =[1; 28]
    let mut value: u64 = 1
    for i in 1u64 .. 28 {
        value *= 5
        powers[i] = value
    }
    powers
}

// 10^k for k in 0..=19, the powers below 2^64.
const POW10_U64: Inline[u64, 20] = integer_powers10()

fn integer_powers10() -> Inline[u64, 20] {
    let mut powers: Inline[u64, 20] =[1; 20]
    let mut value: u64 = 1
    for i in 1u64 .. 20 {
        value *= 10
        powers[i] = value
    }
    powers
}

// Binary64 interval scaling and digit removal adapted from Ryū d2s.rs and
// d2s_intrinsics.rs. Copyright 2018 Ulf Adams, Apache-2.0. See third-party/NOTICES.md.
fn ryu64(fraction: u64, biased: i64) -> (u64, i64) {
    // Use two extra bits to represent both endpoints exactly. Only powers
    // of two above the smallest normal have a narrower gap below them.
    let (m, e) = if biased == 0 {
        (fraction, -1076i64)
    } else {
        (fraction | 0x10000000000000, biased - 1077)
    }
    let center = m << 2
    let upper = center + 2
    let wider_below = fraction != 0 || biased <= 1
    let lower = center - if wider_below {
        2
    } else {
        1
    }
    let even = m & 1 == 0
    let mut vr: u64 = 0
    let mut vp: u64 = 0
    let mut vm: u64 = 0
    let mut vr_exact = false
    let mut vm_exact = false
    let scale_power = if e >= 0 {
        let q = ((e * 78913) >> 18) - if e > 3 {
            1
        } else {
            0
        }
        let shift = q + ryu_pow5_bits(q) + 124 - e
        let (hi, lo) = WIDE_POWER5.ryu64_inv[int.truncate(q)]
        vr = ryu64_mul_shift(center, hi, lo, shift)
        vp = ryu64_mul_shift(upper, hi, lo, shift)
        vm = ryu64_mul_shift(lower, hi, lo, shift)
        if q <= 21 {
            let divisor = POW5_U64[int.truncate(q)]
            if center % 5 == 0 {
                vr_exact = center % divisor == 0
            } else if even {
                vm_exact = lower % divisor == 0
            } else if upper % divisor == 0 {
                vp -= 1
            }
        }
        q
    } else {
        let q = (((-e) * 732923) >> 20) - if e < -1 {
            1
        } else {
            0
        }
        let i = -e - q
        let shift = q + 125 - ryu_pow5_bits(i)
        let (hi, lo) = WIDE_POWER5.ryu64[int.truncate(i)]
        vr = ryu64_mul_shift(center, hi, lo, shift)
        vp = ryu64_mul_shift(upper, hi, lo, shift)
        vm = ryu64_mul_shift(lower, hi, lo, shift)
        if q <= 1 {
            vr_exact = true
            if even {
                vm_exact = wider_below
            } else {
                vp -= 1
            }
        } else if q < 63 {
            let zero_bits: u64 = int.truncate(q)
            vr_exact = (center & ((1u64 << zero_bits) - 1)) == 0
        }
        q + e
    }
    // Keep removing digits while the interval still contains a candidate.
    let mut removed: i64 = 0
    if !vr_exact && !vm_exact {
        // The common case: the dropped digits only round, two at a step first.
        let mut round_up = false
        if vp / 100 > vm / 100 {
            let vr100 = vr / 100
            round_up = vr - 100 * vr100 >= 50
            vr = vr100
            vp = vp / 100
            vm = vm / 100
            removed = 2
        }
        while vp / 10 > vm / 10 {
            let vr10 = vr / 10
            round_up = vr - 10 * vr10 >= 5
            vr = vr10
            vp = vp / 10
            vm = vm / 10
            removed += 1
        }
        let c = if vr == vm || round_up {
            vr + 1
        } else {
            vr
        }
        return strip(c, scale_power + removed)
    }
    let mut last: u64 = 0
    while vp / 10 > vm / 10 {
        let vm10 = vm / 10
        let vr10 = vr / 10
        vm_exact = vm_exact && vm - 10 * vm10 == 0
        vr_exact = vr_exact && last == 0
        last = vr - 10 * vr10
        vr = vr10
        vp = vp / 10
        vm = vm10
        removed += 1
    }
    if vm_exact {
        while vm % 10 == 0 {
            let vr10 = vr / 10
            vr_exact = vr_exact && last == 0
            last = vr - 10 * vr10
            vr = vr10
            vp = vp / 10
            vm = vm / 10
            removed += 1
        }
    }
    if vr_exact && last == 5 && vr % 2 == 0 {
        last = 4
    }
    let c = if (vr == vm && !vm_exact) || last >= 5 {
        vr + 1
    } else {
        vr
    }
    strip(c, scale_power + removed)
}

// The shift is in 118..=125. After dropping the lowest 64 bits, the
// remaining product is m × hi plus the upper limb of m × lo.
fn ryu64_mul_shift(m: u64, hi: u64, lo: u64, shift: i64) -> u64 {
    let (low_high, _) = int.mul_wide(m, lo)
    let (high, low) = int.mul_wide(m, hi)
    let sum = int.wrapping_add(low, low_high)
    let top = if sum < low {
        high + 1
    } else {
        high
    }
    let distance: u64 = int.truncate(shift - 64)
    (top << (64 - distance)) | (sum >> distance)
}

/// m x 2^e x 10^digits rounded half to even, when digits <= 19 and that is m x 5^digits
/// shifted right by 1 to 63 bits into a u64; None elsewhere. Exact: the remainder is
/// the bits shifted out.
fn fixed_scaled(m: u64, e: i64, digits: u64) -> Option[u64] {
    if digits > 19 || m == 0 {
        return None
    }
    let d: i64 = int.narrow(digits)
    let shift = -e - d
    if shift < 1 || shift > 63 {
        return None
    }
    let (hi, lo) = int.mul_wide(m, POW5_U64[digits])
    let s: u64 = int.narrow(shift)
    let q = (hi << (64 - s)) | (lo >> s)
    // The rounded value must fit too.
    if hi >> s != 0 || q == ALL_ONES {
        return None
    }
    let rest = lo & ((1u64 << s) - 1)
    let half: u64 = 1 << (s - 1)
    if rest > half || (rest == half && (q & 1) == 1) {
        Some(q + 1)
    } else {
        Some(q)
    }
}

/// q / 10^digits with `digits` places, as push_fixed64 writes it.
fn push_scaled(mut s: String, q: u64, digits: u64) {
    if digits == 0 {
        return string.push_u64(mut s, q)
    }
    let scale = POW10_U64[digits]
    let places = q % scale
    string.push_u64(mut s, q / scale)
    string.push(mut s, ".")
    let mut width: u64 = 1
    while width < digits && places >= POW10_U64[width] {
        width += 1
    }
    if places == 0 {
        return string.push(mut s, string.slice("0000000000000000000", 0, digits))
    }
    string.push(mut s, string.slice("0000000000000000000", 0, digits - width))
    string.push_u64(mut s, places)
}

fn strip(c: u64, p: i64) -> (u64, i64) {
    let mut v = c
    let mut q = p
    while v % 10 == 0 {
        v = v / 10
        q += 1
    }
    (v, q)
}

/// The index in push_fixed64's text of output digit q: after the carry byte, and past the
/// '.' once the whole digits end.
fn place(q: u64, whole: u64) -> u64 {
    if q < whole {
        1 + q
    } else {
        2 + q
    }
}

// Arm optimized-routines exp (Szabolcs Nagy, 2018; MIT; musl's and glibc's exp carry the
// same code and data): N = 128, x = k ln2/N + r, Shift = 1.5 x 2^52 rounds k into kd's
// low bits, and C2..C5 approximate e^r - 1 - r on |r| <= ln2/256.

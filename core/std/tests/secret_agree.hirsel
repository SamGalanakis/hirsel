fn nibble(c: u8) -> u8 {
    if c >= b'a' {
        c - b'a' + 10u8
    } else {
        c - b'0'
    }
}

fn unhex(s: String) -> Bytes {
    let h = string.as_bytes(s)
    let mut out: Bytes = list.with_capacity(list.len(h) / 2)
    for i in 0u64 .. list.len(h) / 2 {
        list.push(mut out, nibble(h[2 * i]) * 16u8 + nibble(h[2 * i + 1]))
    }
    out
}

// RFC 6979 A.2.5. The signed cell's next draw must match a separate cell.
// expect: run p256_sign_keeps_next_draw() = true
fn p256_sign_keeps_next_draw() -> bool {
    let random = provide.random(7)
    let control = provide.random(7)
    let pkcs8 = unhex("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721a1440342000460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
    let key = result.unwrap(secret.seal(take pkcs8, "sign(p256)"))
    let point = unhex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
    let message = string.as_bytes("sample")
    let mut sig: Bytes = list.with_capacity(64)
    let n = result.unwrap(secret.sign(key, P256, random, message, mut sig))
    let expected = unhex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    let mut next: Bytes = list.with_capacity(8)
    let mut untouched: Bytes = list.with_capacity(8)
    host.random(random, mut next)
    host.random(control, mut untouched)
    n == 64 && sig == expected && next == untouched && p256.verify(point, message, sig) && !p256.verify(point, string.as_bytes("rample"), sig)
}

// RFC 6979 A.2.5 chooses the second 32-byte draw. The first is out of range.
// A failed admission keeps the tape and output untouched.
// expect: run p256_generation_draws_and_charge() = true
fn p256_generation_draws_and_charge() -> bool {
    let tape = unhex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffc9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f67211122334455667788")
    let random = provide.random_tape(take tape)
    let expected = unhex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
    let mut rejected: Bytes = list.with_capacity(65)
    let reject = result.unwrap(bound bytes 175 {
        match secret.p256_key(random, "sign(p256)", mut rejected) {
            Error(Capacity(c)) => c.requested == 176 && c.available == 175,
            _ => false,
        }
    })
    let other = provide.random(7)
    let mut other_point: Bytes = list.with_capacity(65)
    let mut point: Bytes = list.with_capacity(65)
    let document = result.unwrap(bound bytes 176 {
        let previous = result.unwrap(secret.p256_key(other, "sign(p256)", mut other_point))
        drop(take previous)
        let key = result.unwrap(secret.p256_key(random, "sign(p256)", mut point))
        take key
    })
    let message = string.as_bytes("sample")
    let mut sig: Bytes = list.with_capacity(64)
    let n = result.unwrap(secret.sign(document, P256, random, message, mut sig))
    let want_sig = unhex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    let mut next: Bytes = list.with_capacity(8)
    host.random(random, mut next)
    reject && list.len(rejected) == 0 && list.len(other_point) == 65 && point == expected && n == 64 && sig == want_sig && next == unhex("1122334455667788")
}

// RFC 7748 §6.1 Alice. Both share types pay exactly 64 bytes.
// expect: run key_share_keeps_private_keys_and_refunds() = true
fn key_share_keeps_private_keys_and_refunds() -> bool {
    let scalar = unhex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    let random = provide.random_tape(take scalar)
    let scalar_p256 = unhex("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    let random_p256 = provide.random_tape(take scalar_p256)
    let mut x25519_point: Bytes = list.with_capacity(32)
    let mut p256_point: Bytes = list.with_capacity(65)
    let short = result.unwrap(bound bytes 63 {
        match secret.key_share(random, X25519, mut x25519_point) {
            Error(Capacity(c)) => c.requested == 64 && c.available == 63,
            _ => false,
        }
    })
    let generated = result.unwrap(bound bytes 64 {
        let share = result.unwrap(secret.key_share(random, X25519, mut x25519_point))
        drop(take share)
        let second = result.unwrap(secret.key_share(random_p256, P256, mut p256_point))
        drop(take second)
        true
    })
    short && generated && x25519_point == unhex("8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a") && p256_point == unhex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
}

fn share_for_parent(take random: Random) -> secret.KeyShare {
    let mut point: Bytes = list.with_capacity(32)
    result.unwrap(secret.key_share(random, X25519, mut point))
}

fn key_share_room() -> u64 {
    let probe: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 4320)
    match probe {
        Ok(take pair) => {
            drop(take pair)
            4392
        },
        Error(c) => c.available,
    }
}

// A unit's share retains 64 bytes of the reservation until its last holder drops it.
// expect: run key_share_crosses_unit_with_charge(tasks) = true
fn key_share_crosses_unit_with_charge(tasks: Tasks) -> bool waits {
    let random = provide.random(7)
    result.unwrap(bound bytes 4392 {
        let worker = result.unwrap(task.spawn_unit(tasks, bytes 4096, take random, share_for_parent))
        let share = result.unwrap(task.join(take worker))
        let retains_charge = key_share_room() == 4328
        drop(take share)
        retains_charge && key_share_room() == 4392
    })
}

// RFC 9001 Appendix A.2. Unprotected header and protected payload, including its tag.
// expect: run quic_initial_packets_match_rfc9001() = true
fn quic_initial_packets_match_rfc9001() -> bool {
    let dcid = unhex("8394c8f03e515708")
    let header = unhex("c300000001088394c8f03e5157080000449e00000002")
    let mut plain: Bytes = list.with_capacity(1162)
    let frames = unhex("")
    for byte in frames {
        list.push(mut plain, byte)
    }
    while list.len(plain) < 1162 {
        list.push(mut plain, 0u8)
    }
    let ciphertext = unhex("")
    let extra: Bytes = list.new()
    let mut client = result.unwrap(schedule.quic_initial(Client, dcid))
    let server = result.unwrap(schedule.quic_initial(Server, dcid))
    let mut sender = result.unwrap(schedule.sealer(mut client, Initial, 0, 2))
    let opener = result.unwrap(schedule.opener(server, Initial))
    let mask = result.unwrap(schedule.header_mask(client, Initial, true))
    let duplicate = match schedule.sealer(mut client, Initial, 0, 3) {
        Error(Issued) => true,
        _ => false,
    }
    let mut sent: Bytes = list.with_capacity(1200)
    for byte in header {
        list.push(mut sent, byte)
    }
    let written = result.unwrap(packet.seal_into(mut sender, 2, plain, 0, mut sent, 0, extra))
    let matches_wire = list.len(sent) == 1200 && list.slice(sent, 22, 1200) == list.slice(ciphertext, 0, 1178)
    let sample = packet.mask(mask, sent, 22)
    let matches_mask = sample[0] == 0x43 && sample[1] == 0x7b && sample[2] == 0x9a && sample[3] == 0xec && sample[4] == 0x36
    let domain = match packet.open(opener, 1, 2, mut sent, 0, 22, extra) {
        Error(Range) => true,
        _ => false,
    }
    let opened = result.unwrap(packet.open(opener, 0, 2, mut sent, 0, 22, extra))
    duplicate && written == 1178 && matches_wire && matches_mask && domain && opened == 1162 && list.slice(sent, 22, 1184) == list.slice(plain, 0, 1162)
}

// RFC 9147 §5.9 key and IV labels. Python hmac and OpenSSL AES-GCM
// independently generated the payload for sequence 2^48.
// expect: run dtls13_import_keeps_direction_spend_and_width() = true
fn dtls13_import_keeps_direction_spend_and_width() -> bool {
    let profile: schedule.Profile13 = Dtls13(Aes128GcmSha256)
    let tx_material = unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let rx_material = unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let tx = result.unwrap(secret.seal(take tx_material, "traffic_import(send)"))
    let rx = result.unwrap(secret.seal(take rx_material, "traffic_import(receive)"))
    let alias = secret.share(tx)
    let mut sending = result.unwrap(schedule.import_traffic(profile, take tx))
    let mut receiving = result.unwrap(schedule.import_traffic(profile, take rx))
    let spent = match schedule.import_traffic(profile, take alias) {
        Error((Spent, Some(take returned_alias))) => {
            drop(take returned_alias)
            true
        },
        _ => false,
    }
    let no_open = match schedule.opener(sending, Application) {
        Error(Invalid) => true,
        _ => false,
    }
    let no_seal = match schedule.sealer(mut receiving, Application, 0, 0) {
        Error(Invalid) => true,
        _ => false,
    }
    let mut sealer = result.unwrap(schedule.sealer(mut sending, Application, 0, 0))
    let opener = result.unwrap(schedule.opener(receiving, Application))
    let mut buf: Bytes = list.with_capacity(31)
    for b in unhex("2c0001") {
        list.push(mut buf, b)
    }
    let plain = string.as_bytes("dtls13 width")
    for b in plain {
        list.push(mut buf, b)
    }
    let empty: Bytes = list.new()
    let seq = 281474976710656u64
    let tag = result.unwrap(packet.seal(mut sealer, seq, mut buf, 0, 3, empty))
    let wire = unhex("2c00013b9f811ad532922364df49738c048631aa857afa5ef2d2d2009a38c9")
    let same = buf == wire
    let count = result.unwrap(packet.open(opener, 0, seq, mut buf, 0, 3, empty))
    spent && no_open && no_seal && same && tag == 16 && count == 12 && list.slice(buf, 3, 15) == list.slice(plain, 0, 12)
}

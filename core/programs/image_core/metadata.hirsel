fn tiff_short(input: Bytes, at: u64, little: bool) -> u16 {
    if little {
        list.word_le(input, at)
    } else {
        list.word_be(input, at)
    }
}

fn tiff_long(input: Bytes, at: u64, little: bool) -> u32 {
    if little {
        list.word_le(input, at)
    } else {
        list.word_be(input, at)
    }
}

fn exif_orientation(input: Bytes, start: u64, end: u64) -> Result[u8, Error] {
    if end - start < 8 {
        return Error(Truncated)
    }
    let order: u16 = list.word_be(input, start)
    let little = order == 0x4949
    if (!little && order != 0x4d4d) || tiff_short(input, start + 2, little) != 42 {
        return Error(Malformed)
    }
    let offset: u64 = int.widen(tiff_long(input, start + 4, little))
    if offset < 8 || offset > end - start - 2 {
        return Error(Malformed)
    }
    let first = start + offset + 2
    let count: u64 = int.widen(tiff_short(input, first - 2, little))
    if count * 12 > end - first {
        return Error(Truncated)
    }
    let mut orientation = 0u8
    for i in 0u64 .. count {
        let at = first + i * 12
        if tiff_short(input, at, little) == 0x0112 {
            if orientation != 0 || tiff_short(input, at + 2, little) != 3 || tiff_long(input, at + 4, little) != 1 {
                return Error(Malformed)
            }
            let value = tiff_short(input, at + 8, little)
            if value < 1 || value > 8 {
                return Error(Malformed)
            }
            orientation = int.narrow(value)
        }
    }
    if orientation == 0 {
        Ok(1)
    } else {
        Ok(orientation)
    }
}

fn png_icc_offset(input: Bytes, start: u64, end: u64) -> Result[u64, Error] {
    let mut at = start
    while at < end && at - start < 80 && input[at] != 0 {
        at += 1
    }
    if at == start || at - start == 80 || end - at < 3 || input[at + 1] != 0 {
        return Error(Malformed)
    }
    Ok(at + 2)
}

fn icc_header(input: Bytes, start: u64, end: u64) -> Result[(), Error] {
    if end - start < 132 {
        return Error(Malformed)
    }
    let size: u64 = int.widen(tiff_long(input, start, false))
    let signature: u32 = list.word_be(input, start + 36)
    let tags: u64 = int.widen(tiff_long(input, start + 128, false))
    if size != end - start || signature != 0x61637370 || tags > (size - 132) / 12 {
        return Error(Malformed)
    }
    for i in 0u64 .. tags {
        let entry = start + 132 + 12 * i
        let offset: u64 = int.widen(tiff_long(input, entry + 4, false))
        let length: u64 = int.widen(tiff_long(input, entry + 8, false))
        if offset < 132 + 12 * tags || offset > size || length > size - offset {
            return Error(Malformed)
        }
    }
    Ok(())
}

fn exif_signature(input: Bytes, at: u64) -> bool {
    let name: u32 = list.word_be(input, at)
    let zero: u16 = list.word_be(input, at + 4)
    name == 0x45786966 && zero == 0
}

fn jpeg_icc_signature(input: Bytes, at: u64) -> bool {
    let first: u64 = list.word_be(input, at)
    let rest: u32 = list.word_be(input, at + 8)
    first == 0x4943435f50524f46 && rest == 0x494c4500
}

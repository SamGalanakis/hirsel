// The caller holds LOCK. The export opener uses the reader and validator
// directly, so it never selects or removes files in the captured directory.
fn read_selected_page_manifest(d: Dir) -> Result[(StoreId, manifest.ValidatedPageManifest), Error] waits {
    let (id, take page_record) = read_page_manifest_file(d)?
    let validated = validate_store_manifest(d, id, take page_record)?
    let holds = failure_result_from_rep(manifest.directory_cleanup_plan(d, store_key_to_rep(id), validated, list.new()))?
    let _ = failure_result_from_rep(manifest.cleanup_page_manifest_with_holds(d, validated.manifest, take holds))?
    Ok((id, take validated))
}

fn publish_page_manifest(d: Dir, id: StoreId, m: manifest.PageManifest, target: Option[manifest.TargetLimits], mut scratch: Bytes) -> Result[(), Error] waits {
    failure_result_from_rep(manifest.fill_page_manifest_file(mut scratch, store_key_to_rep(id), m))?
    if let Some(wanted) = target {
        let none = manifest.new_page_locations()
        validate_new_page_manifest(d, id, scratch, wanted, manifest.SettledPacks(below: 0, locations: view none))?
    }
    failure_result_from_rep(manifest.publish_page_manifest_bytes(d, scratch))
}

// Independently encoded from AP3, AP14 (Format 15), AP20 and §13.1
// using libxxhash.
// The 30-byte local pack row has a zero index offset and source tag. Both live PAGEs start at byte 72.
fn page_manifest_vector() -> Bytes {
    let words: Inline[u64, 59] =[
        0x0000003800010001,
        0x4033654e2bfb850a,
        0x45524f5453524948,
        0x000000010000000f,
        0x0000000000000001,
        0x0000000000000002,
        0x0000000000000000,
        0x0000000000000001,
        0x0000000000000000,
        0x0000017f00010031,
        0x4ba369658f59975b,
        0x0000000000000001,
        0x0100000000ff0000,
        0x0100004000000400,
        0x0000000000000003,
        0x0000000100000001,
        0x0000000000000003,
        0x0000000000000001,
        0x0000000000000001,
        0x000000000000004e,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000002,
        0x0000000000000048,
        0x10c85ac300000045,
        0x0000000244fcf287,
        0x0000000100000000,
        0x616d000400000000,
        0x0000000000006e69,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000010000,
        0x0000000000480000,
        0x33c6000000210000,
        0x0001222e8df641cc,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
    ]
    let mut raw: Bytes = list.with_capacity(472)
    for word in words {
        list.put_word_le(mut raw, word)
    }
    list.truncate(mut raw, 471)
    take raw
}


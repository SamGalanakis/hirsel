# Rust
/target/
**/target/
**/*.rs.bk

# Node / web (app/ has its own .gitignore too)
node_modules/
app/node_modules/
dist/
app/dist/
.vite/
dev-dist/
*.tsbuildinfo

# Runtime state & data
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Secrets & local config
.env
.env.*
*.local
**/iroh-secret-key
!*.example

# Logs & scratch
*.log
tmp/
scratch/
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.playwright-cli/

# Android / Gradle
.gradle/
**/build/
android/local.properties
.cxx/
**/.externalNativeBuild/
captures/
*.apk
*.aab
*.ap_
*.dex

# Signing material — never commit
*.keystore
*.jks
*.p12
*.pem
keystore.properties
signing.properties

# Firebase secrets — never commit
**/google-services.json
**/*service-account*.json
**/fcm-*service*.json
GoogleService-Info.plist

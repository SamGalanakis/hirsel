// rule: STORE-11
// expect: run
// authorities: {"batches":{"provider":"authority.memory@1","floor":"memory"},"batchesobjects":{"provider":"authority.objects@1","floor":"disk","level":"disk","objects":{"provider":"objects.sim@1","seed":1}},"listed":{"provider":"authority.memory@1","floor":"memory"},"unlisted":{"provider":"authority.memory@1","floor":"memory"},"retired":{"provider":"authority.memory@1","floor":"memory"},"takeover":{"provider":"authority.memory@1","floor":"memory"},"takeoverobjects":{"provider":"authority.objects@1","floor":"disk","level":"disk","objects":{"provider":"objects.sim@1","seed":1}}}
// steps: 20000000
// Every checkpoint node is hashed with the interpreted SHA-256, three checkpoints over two stores.
// stdout: batches: one fresh node per batch, each but the last by an Objects record
// stdout: batches: the same state again reuses every node
// stdout: batches: one write makes fewer fresh nodes than the first checkpoint
// stdout: batches: only the third publication retires nodes, each one removed
// stdout: batches: reopened, both rows kept
// stdout: batchesobjects: one fresh node per batch, each but the last by an Objects record
// stdout: batchesobjects: the same state again reuses every node
// stdout: batchesobjects: one write makes fewer fresh nodes than the first checkpoint
// stdout: batchesobjects: only the third publication retires nodes, each one removed
// stdout: batchesobjects: reopened, both rows kept
// stdout: listed: opened, forged row kept
// stdout: unlisted: corrupt history/5
// stdout: retired: corrupt history/7
// stdout: takeover: the unfollowed batch removed, every followed node kept
// stdout: takeoverobjects: the unfollowed batch removed, every followed node kept
// A checkpoint's nodes are objects of the claim that publishes it, each inventoried by
// one record of the publication, and a later checkpoint reuses the nodes the head
// already holds. A store of nodes of 64 to 1024 bytes and checkpoint batches of 0
// bytes, so each batch holds one fresh node, commits 60 rows and compacts three times,
// over a local history (memory) and object storage (objects.sim@1): the first
// publication is one Objects record per fresh node but the last, which its Checkpoint
// record inventories; a second compaction of the same state finds every node and
// inventories none; after one write a third inventories some nodes, fewer than the
// first (the changed leaf and its ancestors). Only the third retires nodes, those the
// tree no longer holds, and once it returns none of them can be read. A reopen
// recovers from the third checkpoint, most of whose nodes the first one put, and
// holds the rows written, so no node of it was retired or removed.
// A history's recovery reads a checkpoint's nodes only as inventoried: on a store of
// one row, a later claim puts a one-leaf checkpoint of another row, its object of
// the claim's next position, and submits its Checkpoint. When the record inventories
// the leaf (listed) the store opens with that checkpoint's row; when it does not
// (unlisted) the open is corruption of that record, position 5 (claim, Genesis, the
// row's group, the second claim, the Checkpoint). When one record inventories the
// leaf, the next retires it and the Checkpoint after them names it (retired), the
// open is corruption of the Checkpoint's record, position 7: a checkpoint names only
// objects its history made and has not retired.
// Batches across a takeover: a store compacts, so each of its batches is followed by
// the record inventorying it, and closes; a later claim puts a batch at its next
// position and ends without a record, as a writer cut between its batch and the
// batch's record leaves it. The successor store's compaction removes that unfollowed
// batch, and keeps every node a record inventoried, all of which its checkpoint
// still holds.
pub type Failed = Failed(String)

fn say(stdout: Stdout, line: String) -> Result[(), Failed] {
  match out.print(stdout, f"{line}\n") {
    Ok(_) => Ok(()),
    Error(_) => Error(Failed("print")),
  }
}

// Puts `count` keys of `key` bytes, `k` and then the key's index plus `k`, each
// with a value of `value` bytes.
fn put(mut tx: store.Tx, info: store.CallInfo, w: (u64, u64, u64)) -> Result[
  (),
  store.TxError
] {
  let (count, key, value) = w
  for i in 0u64..count {
    let mut k: List[u8] = []
    for _ in 1u64..key {
      list.push(mut k, 107)
    }
    list.push(mut k, int.truncate(107 + i))
    let mut v: List[u8] = []
    for _ in 0u64..value {
      list.push(mut v, 118)
    }
    store.tx_put(mut tx, bytes.from_list(take k), bytes.from_list(take v))?
  }
  Ok(())
}

fn commits(mut s: store.Store, w: (u64, u64, u64)) -> bool {
  let r: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put, w)
  r == Ok(())
}

// 8-byte keys, 16-byte values, nodes of 64 to 1024 bytes, one fresh node a batch.
fn tight() -> store.StoreConfig {
  let mut c = store.default_config()
  c.limits.key_bytes = 8
  c.limits.value_bytes = 16
  c.limits.transaction_bytes = 4096
  c.nodes = history.Bounds(node_min: 64, node_mean: 128, node_max: 1024)
  c.batch_bytes = 0
  c
}

// One publication: the Objects records inventorying its batches just before
// its Checkpoint record, whether each record inventories at most one object,
// how many objects the publication inventories, and how many its Checkpoint
// record and the Objects records after it retire.
pub type Publication {
  batches: u64,
  single: bool,
  objects: u64,
  retired: u64,
}

// The store's publications and every object the history retires.
fn publications(a: Authority) -> Result[(List[Publication], List[ObjectRef]), Failed] {
  let Ok(records) = authority.read(a, 0, authority.floor(a), 4096) else {
    return Error(Failed("read"))
  }
  let mut out: List[Publication] = []
  let mut gone: List[ObjectRef] = []
  let mut batches: u64 = 0
  let mut single = true
  let mut objects: u64 = 0
  for r in records {
    let (entry, created, retired) = match r {
      Claimed(..) => {
        batches = 0
        single = true
        objects = 0
        continue
      },
      Appended(entry, created, retired) => (copy entry, copy created, copy retired),
    }
    for x in retired {
      list.push(mut gone, copy x)
    }
    let Ok(g) = history.decode_group(entry) else {
      return Error(Failed("decode"))
    }
    let mut creates = false
    let mut publishes = false
    for c in g.commits {
      match c.body {
        Engine(Objects()) => {
          creates = true
        },
        Engine(Checkpoint(_)) => {
          publishes = true
        },
        _ => {},
      }
    }
    let n = list.len(created)
    let m = list.len(retired)
    if publishes {
      list.push(
        mut out,
        Publication(
          batches: batches,
          single: single && n <= 1,
          objects: objects + n,
          retired: m
        )
      )
      batches = 0
      single = true
      objects = 0
    } else if creates && n == 0 && list.len(out) > 0 {
      // Retirements after the Checkpoint's record.
      let Some(p) = list.pop(mut out) else {
        return Error(Failed("pop"))
      }
      list.push(
        mut out,
        Publication(
          batches: p.batches,
          single: p.single,
          objects: p.objects,
          retired: p.retired + m
        )
      )
    } else if creates {
      batches = batches + 1
      single = single && n == 1
      objects = objects + n
    } else {
      batches = 0
      single = true
      objects = 0
    }
  }
  Ok((take out, take gone))
}

fn batched(rt: Io, stdout: Stdout, name: String) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, name) else {
    return Error(Failed("authority"))
  }
  let Ok(made) = store.open(a, tight()) else {
    return Error(Failed("open"))
  }
  let mut s = take made
  // 30 keys of 8 bytes and 30 of 7, each with a 16-byte value: 1890 bytes of
  // leaf entries, several leaves.
  if !(commits(mut s, (30, 8, 16)) && commits(mut s, (30, 7, 16))) {
    return Error(Failed("commit"))
  }
  let Ok(()) = store.compact(mut s) else {
    return Error(Failed("compact"))
  }
  let Ok(()) = store.compact(mut s) else {
    return Error(Failed("compact again"))
  }
  // `kkkkkkkk` again, with a 15-byte value.
  if !commits(mut s, (1, 8, 15)) {
    return Error(Failed("commit"))
  }
  let Ok(()) = store.compact(mut s) else {
    return Error(Failed("compact a third time"))
  }
  let Ok(()) = store.close(take s) else {
    return Error(Failed("close"))
  }
  let (p, gone) = publications(a)?
  if list.len(p) != 3 {
    return say(stdout, f"{name}: {list.len(p)} checkpoints")
  }
  let (b0, one0, n0) = (p[0].batches, p[0].single, p[0].objects)
  let (b1, n1) = (p[1].batches, p[1].objects)
  let n2 = p[2].objects
  if one0 && n0 > 2 && b0 + 1 == n0 {
    say(
      stdout,
      f"{name}: one fresh node per batch, each but the last by an Objects record"
    )?
  } else {
    say(stdout, f"{name}: first checkpoint of {n0} objects in {b0} batches")?
  }
  if b1 == 0 && n1 == 0 {
    say(stdout, f"{name}: the same state again reuses every node")?
  } else {
    say(stdout, f"{name}: the same state again made {n1} nodes")?
  }
  if n2 > 0 && n2 < n0 {
    say(stdout, f"{name}: one write makes fewer fresh nodes than the first checkpoint")?
  } else {
    say(stdout, f"{name}: one write made {n2} of {n0}")?
  }
  let mut removed = true
  for r in gone {
    removed = removed && match authority.get(a, r) {
      Ok(None()) => true,
      _ => false,
    }
  }
  if p[0].retired == 0 && p[1].retired == 0 && p[2].retired > 0 && p[2].retired == list.len(
    gone
  ) && removed {
    say(stdout, f"{name}: only the third publication retires nodes, each one removed")?
  } else {
    say(
      stdout,
      f"{name}: retired {p[0].retired}, {p[1].retired} and {p[2].retired}, removed {removed}"
    )?
  }
  let Ok(again) = store.open(a, store.default_config()) else {
    return say(stdout, f"{name}: reopen refused")
  }
  let mut s2 = take again
  let Ok(snap) = store.snapshot(a, mut s2, authority.floor(a)) else {
    return Error(Failed("snapshot"))
  }
  let touched = match store.get(snap, b"kkkkkkkk") {
    Some(v) => bytes.len(v) == 15,
    None() => false,
  }
  let last = match store.get(
    snap,
    bytes.from_list([107u8, 107, 107, 107, 107, 107, 136])
  ) {
    Some(v) => bytes.len(v) == 16,
    None() => false,
  }
  if touched && last {
    say(stdout, f"{name}: reopened, both rows kept")
  } else {
    say(stdout, f"{name}: reopened, rows lost")
  }
}

// An entry's payload: a group holding one engine commit.
fn group(body: history.Engine) -> Bytes {
  let (data, _) = history.encode_group(
    history.Group(
      retain: history.NO_LOCATOR,
      commits: [history.Commit(body: Engine(copy body), writes: [])],
      defs: []
    )
  )
  data
}

fn forged(rt: Io, stdout: Stdout, name: String, listed: bool, retire: bool) -> Result[
  (),
  Failed
] {
  let Ok(a) = io.authority(rt, name) else {
    return Error(Failed("authority"))
  }
  let Ok(made) = store.open(a, store.default_config()) else {
    return Error(Failed("open"))
  }
  let mut s = take made
  if !commits(mut s, (1, 1, 1)) {
    return Error(Failed("commit"))
  }
  let Ok(()) = store.close(take s) else {
    return Error(Failed("close"))
  }
  let Ok(claimed) = authority.claim(a) else {
    return Error(Failed("claim"))
  }
  let mut c = take claimed
  // The newest group's last version and digest, and the claim's epoch.
  let Ok(records) = authority.read(a, 0, authority.floor(a), 64) else {
    return Error(Failed("read"))
  }
  let mut version: u64 = 0
  let mut last: (u64, Bytes) = (0, history.zero_digest())
  let mut epoch: u64 = 0
  for r in records {
    match r {
      Claimed(e, _, _) => {
        version = version + 1
        epoch = e
      },
      Appended(entry, _, _) => {
        let Ok(g) = history.decode_group(entry) else {
          return Error(Failed("decode"))
        }
        version = version + list.len(g.commits)
        last = (version, history.digest(entry))
      },
    }
  }
  let place = history.Placement(
    live: ordered_map.empty(store.compare_keys),
    epoch: epoch,
    start: claim.end(c) + 1,
    refs: 64,
    bytes: 67108864
  )
  let tree = history.build_tree(
    [(b"forged", b"row")],
    history.default_bounds(),
    take place
  )
  let mut refs: List[ObjectRef] = []
  for batch in tree.batches {
    for (r, node) in batch {
      let Ok(()) = authority.put(a, mut c, r, copy node) else {
        return Error(Failed("put"))
      }
      list.push(mut refs, copy r)
    }
  }
  let mut created = if listed {
    copy refs
  } else {
    []
  }
  if retire {
    // The leaf's own record, then one retiring it.
    let inventory = authority.submit(
      a,
      mut c,
      group(Objects()),
      take created,
      [],
      authority.floor(a)
    )
    let Ok(p) = inventory else {
      return Error(Failed("submit objects"))
    }
    let Ok(q) = authority.submit(
      a,
      mut c,
      group(Objects()),
      [],
      copy refs,
      authority.floor(a)
    ) else {
      return Error(Failed("submit retirement"))
    }
    let (Advanced(_), Advanced(_)) = (
      authority.wait(a, mut c, p),
      authority.wait(a, mut c, q)
    ) else {
      return Error(Failed("append"))
    }
    created = []
  }
  let (v, d) = take last
  let entry = group(Checkpoint(history.descriptor(tree, v, d)))
  let Ok(p) = authority.submit(
    a,
    mut c,
    take entry,
    take created,
    [],
    authority.floor(a)
  ) else {
    return Error(Failed("submit"))
  }
  let Advanced(_) = authority.wait(a, mut c, p) else {
    return Error(Failed("append"))
  }
  match store.open(a, store.default_config()) {
    Ok(opened) => {
      let mut s2 = take opened
      let Ok(snap) = store.snapshot(a, mut s2, authority.floor(a)) else {
        return Error(Failed("snapshot"))
      }
      match store.get(snap, b"forged") {
        Some(_) => say(stdout, f"{name}: opened, forged row kept"),
        None() => say(stdout, f"{name}: opened, forged row lost"),
      }
    },
    Error(Corrupt(object)) => say(stdout, f"{name}: corrupt {object}"),
    Error(_) => say(stdout, f"{name}: refused"),
  }
}

// Every object the records of `a` inventory.
fn inventoried(a: Authority) -> Result[List[ObjectRef], Failed] {
  let Ok(records) = authority.read(a, 0, authority.floor(a), 4096) else {
    return Error(Failed("read"))
  }
  let mut out: List[ObjectRef] = []
  for r in records {
    if let Appended(_, created, _) = r {
      for x in created {
        list.push(mut out, copy x)
      }
    }
  }
  Ok(take out)
}

fn succeeded(rt: Io, stdout: Stdout, name: String) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, name) else {
    return Error(Failed("authority"))
  }
  let Ok(made) = store.open(a, tight()) else {
    return Error(Failed("open"))
  }
  let mut s = take made
  if !(commits(mut s, (30, 8, 16)) && commits(mut s, (30, 7, 16))) {
    return Error(Failed("commit"))
  }
  let Ok(()) = store.compact(mut s) else {
    return Error(Failed("compact"))
  }
  let Ok(()) = store.close(take s) else {
    return Error(Failed("close"))
  }
  let followed = inventoried(a)?
  let Ok(claimed) = authority.claim(a) else {
    return Error(Failed("claim"))
  }
  let mut c = take claimed
  let Ok(records) = authority.read(a, 0, authority.floor(a), 4096) else {
    return Error(Failed("read"))
  }
  let mut epoch: u64 = 0
  for r in records {
    if let Claimed(e, _, _) = r {
      epoch = e
    }
  }
  let place = history.Placement(
    live: ordered_map.empty(store.compare_keys),
    epoch: epoch,
    start: claim.end(c) + 1,
    refs: 64,
    bytes: 67108864
  )
  let tree = history.build_tree(
    [(b"stray", b"row")],
    history.default_bounds(),
    take place
  )
  let mut unfollowed: List[ObjectRef] = []
  for batch in tree.batches {
    for (r, node) in batch {
      let Ok(()) = authority.put(a, mut c, r, copy node) else {
        return Error(Failed("put"))
      }
      list.push(mut unfollowed, copy r)
    }
  }
  let Ok(again) = store.open(a, tight()) else {
    return Error(Failed("reopen"))
  }
  let mut s2 = take again
  let Ok(()) = store.compact(mut s2) else {
    return Error(Failed("successor compact"))
  }
  let Ok(()) = store.close(take s2) else {
    return Error(Failed("successor close"))
  }
  let mut removed = list.len(unfollowed) > 0
  for r in unfollowed {
    removed = removed && match authority.get(a, r) {
      Ok(None()) => true,
      _ => false,
    }
  }
  let mut kept = list.len(followed) > 2
  for r in followed {
    kept = kept && match authority.get(a, r) {
      Ok(Some(_)) => true,
      _ => false,
    }
  }
  if removed && kept {
    say(stdout, f"{name}: the unfollowed batch removed, every followed node kept")
  } else {
    say(stdout, f"{name}: unfollowed removed {removed}, followed kept {kept}")
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Failed("stdout"))
  }
  batched(rt, stdout, "batches")?
  batched(rt, stdout, "batchesobjects")?
  forged(rt, stdout, "listed", true, false)?
  forged(rt, stdout, "unlisted", false, false)?
  forged(rt, stdout, "retired", true, true)?
  succeeded(rt, stdout, "takeover")?
  succeeded(rt, stdout, "takeoverobjects")?
  Ok(())
}

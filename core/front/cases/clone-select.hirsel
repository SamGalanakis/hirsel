@compact(u32) type RowS { name: Text, n: u64 }

type P: shareable { s: String }
fn freeze(r: Region, x: Text) -> Result[Text in r, Capacity] { clone_in(r, x) }
fn inner(b: Box[Rc[P]]) -> Result[P, Capacity] { clone(b) }
fn same(p: P) -> Result[P, Capacity] { clone(p) }
fn wrong(x: u64) -> Result[String, Capacity] { clone(x) }
fn dup(r: Region, b: SpanBuilder[u8, in r]) -> Result[SpanBuilder[u8, in r], Capacity] { clone(b) }
fn chain(c: Causes) -> Result[Causes, Capacity] { clone(c) }
fn items[T](xs: List[T]) -> Result[List[T], Capacity] { clone(xs) }

fn convert(r: Region, x: String) -> Result[Text in r, Capacity] { clone_in(r, x) }
fn wrong_region_type(r: Region, x: Text) -> Result[RowS in r, Capacity] { clone_in(r, x) }

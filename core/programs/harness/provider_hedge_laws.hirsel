const HEDGE_ENTRY_BYTES: u64 = 1048576u64

type HedgePeer: send {
    listener: Listener,
    clock: Clock,
    hedge: bool
}

fn provider_socket(mut listener: Listener) -> (ReadHalf, WriteHalf) waits {
    let Ok((take c, _)) = host.accept(mut listener, Never) else {
        fail("hedge peer: accept failed")
    }
    let (take input, take output) = net.split(take c)
    let mut reader = take input
    let mut received: Bytes = list.with_capacity(8192u64)
    loop {
        let Ok(n) = host.recv_bounded(mut reader, mut received, 8192u64, Never) else {
            fail("hedge peer: read failed")
        }
        if n == 0u64 {
            fail("hedge peer: incomplete request")
        }
        if complete_request(received) {
            return (take reader, take output)
        }
    }
}

fn complete_request(raw: Bytes) -> bool {
    if raw[list.len(raw) - 1u64] != b'}' {
        return false
    }
    let Ok(take text) = string.from_utf8(clone(raw)) else {
        return false
    }
    region r {
        match std.json.parse(r, text) {
            Ok(_) => true,
            Error(_) => false
        }
    }
}

fn serve_hedge_peer(take job: HedgePeer) -> u64 waits {
    let HedgePeer(listener: take l, clock: clock, hedge: hedge) = take job
    let mut listener = take l
    let head = reply_with("200 OK", "text/event-stream", "")
    let sse = bytes_of("data: {\"choices\":[{\"delta\":{\"content\":\"answer\"},\"finish_reason\":\"stop\"}]}\n\ndata: {\"choices\":[],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1}}\n\ndata: [DONE]\n\n")
    let fast = if hedge {
        9u64
    } else {
        0u64
    }
    for _ in 0u64 .. fast {
        let (take request_in, take output) = provider_socket(mut listener)
        let mut writer = take output
        if let Error(_) = std.http.write_wire(mut writer, head, sse, clock, std.clock.deadline_after_ms(host.mono_ns(clock), 5000u64)) {
            fail("hedge peer: fast reply failed")
        }
        drop(take request_in)
    }
    let (take slow_in, take slow_out) = provider_socket(mut listener)
    let mut slow = take slow_out
    let deadline = std.clock.deadline_after_ms(host.mono_ns(clock), 5000u64)
    if let Error(_) = std.http.write_wire(mut slow, head, b"", clock, deadline) {
        fail("hedge peer: response head failed")
    }
    if !hedge {
        std.clock.sleep_ns(clock, 1750000000u64)
        if let Error(_) = std.http.write_wire(mut slow, sse, b"", clock, deadline) {
            fail("hedge peer: slow reply failed")
        }
        return 1u64
    }
    let (take winner_in, take winner_out) = provider_socket(mut listener)
    let mut winner = take winner_out
    let won = bytes_of("data: {\"choices\":[{\"delta\":{\"content\":\"winner\"},\"finish_reason\":\"stop\"}]}\n\ndata: {\"choices\":[],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1}}\n\ndata: [DONE]\n\n")
    if let Error(_) = std.http.write_wire(mut winner, head, won, clock, deadline) {
        fail("hedge peer: hedge reply failed")
    }
    drop(take winner_in)
    let mut reader = take slow_in
    let mut after: Bytes = list.with_capacity(8192u64)
    // The primary receives no response body. It must close when the second
    // connection wins, while the peer still owns its writer.
    loop {
        match host.recv_bounded(mut reader, mut after, 8192u64, At(clock, deadline)) {
            Ok(0u64) => return 11u64,
            Ok(_) => list.clear(mut after),
            Error(_) => return 0u64,
        }
    }
}

type HedgeServices: send {
    worker: provider.Worker,
    net: Net,
    address: Addr,
    clock: Clock,
    enabled: bool
}

type HedgeGrants: send {
    handles: harness.Handles,
    context: runner.TriggerContext,
    service: HedgeServices
}

fn grant_hedge(s: HedgeServices, h: harness.Handles, ctx: runner.TriggerContext) -> Result[HedgeGrants, Capacity] {
    Ok(HedgeGrants(handles: clone(h), context: runner.share_trigger_context(ctx), service: HedgeServices(worker: provider.share_worker(s.worker), net: s.net, address: s.address, clock: s.clock, enabled: s.enabled)))
}

fn model_single(g: HedgeGrants, take req: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.ModelFault] waits {
    let s = view g.service
    provider.ask_with_preview(s.net, s.clock, route(OpenAi, s.address), take req, mut sink)
}

fn model_hedged(g: HedgeGrants, take req: harness.Request, mut sink: Option[harness.preview.Source], permit: harness.Hedge) -> Result[harness.Answer, harness.ModelFault] waits {
    let s = view g.service
    if !s.enabled {
        return Error(Rejected("guaranteed model entered the hedge worker"))
    }
    let answer = provider.ask_hedged(s.worker, s.net, s.clock, route(OpenAi, s.address), take req, mut sink, permit)?
    if answer.text == "winner" {
        if harness.try_hedge(permit) {
            return Error(Rejected("second hedge admitted"))
        }
    }
    Ok(take answer)
}

fn hedge_agent(enabled: bool) -> harness.Agent[HedgeGrants, ()] {
    let mut a = harness.agent("hedge", "m", code.describe(model_single), ())
    if enabled {
        a.charge = BoundedDuplicate(2u64)
    }
    a.hedged_model = Some(code.describe(model_hedged))
    a.limits.model_reserve = 2u64
    take a
}

fn hedge_wire() -> harness.Wiring {
    result.unwrap(harness.wiring(code.describe(hedge_advance), code.describe(hedge_effect)))
}

fn hedge_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    harness.advance_park(mut tx, h, hedge_agent(true), hedge_wire(), take wake)
}

fn hedge_effect(g: HedgeGrants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    harness.effect(g.context, g.handles, g, take key, hedge_agent(g.service.enabled), code.describe(hedge_settle), None)
}

fn hedge_settle(mut tx: store.Tx, h: harness.Handles, attempt: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    harness.settle(mut tx, h, hedge_agent(false), hedge_wire(), attempt, take m)
}

fn hedge_place(mut r: runner.Registry[HedgeGrants, harness.Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(hedge_advance), code.describe(hedge_effect), code.describe(hedge_settle), harness.select_handles, 131072u64, HEDGE_ENTRY_BYTES)
}

fn hedge_submit(mut tx: store.Tx, h: harness.Handles, i: u64, enabled: bool) -> Result[(), harness.Refused] {
    let mut key = string.new()
    string.push_u64(mut key, i)
    let caller = store.Caller(issuer: 1u8, subject: b"hedge")
    let _ = harness.submit(mut tx, h, hedge_agent(enabled), hedge_wire(), caller, NextTurn, harness.Submit(client_key: take key, text: "test"))?
    Ok(())
}

fn seed_hedge(dir: Dir, clock: Clock, random: Random, tasks: Tasks, enabled: bool) waits {
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let h = result.unwrap(store.bind_declaration(mut db, Migrate, harness.declare_tables))
    let setup = store.run(mut db, None, (store.copy_env(enabled), store.copy_env(h)), fn(mut tx, call_env) -> Result[(), harness.Refused] {
        harness.open_session(mut tx, call_env.1, "m", All)?
        let count = if call_env.0 {
            10u64
        } else {
            1u64
        }
        for i in 0u64 .. count {
            hedge_submit(mut tx, call_env.1, i, call_env.0)?
        }
        Ok(())
    })
    if let Ok(Committed(_)) = setup {} else {
        fail("hedge: could not seed")
    }
    result.unwrap(store.close(take db))
}

fn law_hedge_charge(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, enabled: bool, seed: u64) -> Result[(), u64] waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    seed_hedge(dir, clock, random, tasks, enabled)
    let (initial, virtual_clock) = std.sim.world.new(seed, 0u64, 0u64)
    let mut world = take initial
    let plan = std.sim.world.detach(mut world)
    let (fake, port) = provide.net(bytes 65536u64)
    let link = task.spawn(tasks, bytes 4194304u64, Link(port: take port, clock: virtual_clock, plan: take plan, queue_bytes: 8192u64), serve_link)
    let loopback = Addr(ip: V4(2130706433u32), port: 0u16)
    let (listener, address) = result.unwrap(host.listen(fake, loopback, 2u16))
    let peer = task.spawn(tasks, bytes 1048576u64, HedgePeer(listener: take listener, clock: clock, hedge: enabled), serve_hedge_peer)
    let (worker, history) = provider.worker(tasks, 262144u64)
    let service = HedgeServices(worker: take worker, net: fake, address: address, clock: clock, enabled: enabled)
    let config = runner.TriggerConfig(entries: harness.entries(hedge_wire()), author: store.Caller(issuer: 0u8, subject: b""))
    let config_grants: runner.Grants[HedgeGrants, harness.Handles, HedgeServices] = runner.Grants(attempt: Some(runner.Mint(seed: take service, mint: grant_hedge, mint_bytes: 65536u64, mint_steps: runner.DEFAULT_STEPS)), call: None, claim: None, bind: None)
    let mut session = runner.wire_defaults(65536u64)
    session.n_pool = 4194304u64
    let settings: runner.PlaceConfig[HedgeGrants, harness.Handles, HedgeServices] = runner.PlaceConfig(backing: Disk(dir), sizes: store.Overrides(resident_limit: Some(1048576u64), journal_limit: None, checkpoint_bytes: Some(4194304u64), pack_bytes: Some(512u64), group_bytes: Some(1048576u64), group_commits: Some(2u32), lock_wait_ms: None, cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: Reopen, place: code.describe(hedge_place), n_place: HEDGE_ENTRY_BYTES, on_migrate: None, schema: code.describe(harness.declare_tables), session: take session, max_sessions: 1u64, proxies: list.new(), n_publisher: HEDGE_ENTRY_BYTES, listen: loopback, net: net, tasks: tasks, clock: clock, random: random, stop: runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: None, grants: Some(take config_grants), triggers: Some(take config), idle: Some(300u64))
    let (stop, from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let status = result.unwrap(runner.status_root())
    let ended = runner.operate(take settings, take from, latest.handle(status), None)
    let _ = take stop
    let observed = task.join(take peer)
    drop(take fake)
    let _ = task.join(take link)
    let _ = task.join(take history)
    let _ = take world
    let Ok(_) = ended else {
        return Error(20u64)
    }
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let expected = if enabled {
        10u64
    } else {
        1u64
    }
    for id in 0u64 .. expected {
        let key = harness.EffectKey(run: id, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
        let e = retry_effect(db, h, key)
        let raced = enabled && id == 9u64
        let dispatches = if raced {
            2u64
        } else {
            1u64
        }
        let text = if raced {
            "winner"
        } else {
            "answer"
        }
        let Settled(Model(answer)) = view e.phase else {
            let mut message = string.from("model did not settle for run ")
            string.push_u64(mut message, id)
            if let Settled(ModelFailed(fault)) = view e.phase {
                match fault {
                    Rejected(why) => {
                        string.push(mut message, " rejected ");
                        string.push(mut message, why)
                    },
                    StreamDropped(why) => {
                        string.push(mut message, " dropped ");
                        string.push(mut message, why)
                    },
                    _ => (),
                }
            }
            fail(take message)
        }
        if answer.text != text || e.dispatches != dispatches {
            return Error(23u64)
        }
        let run = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.runs, id)))
        if run.spend.reserved != 0u64 || run.spend.known != 2u64 || run.spend.unresolved != (dispatches - 1u64) * 2u64 {
            return Error(24u64)
        }
    }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    match take observed {
        Ok(n) if n == (if enabled {
            11u64
        } else {
            1u64
        }) => Ok(()),
        Error(Failed(causes)) => {
            for cause in causes {
                if let Fail(why) = cause.kind {
                    fail(clone(why))
                }
            }
            Error(21u64)
        },
        _ => Error(21u64),
    }
}

@test
fn test_warm_and_hedge(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, seed_grant: Env) -> Result[(), u64] waits {
    let seed = std.sim.world.test_seed(seed_grant)
    let wire_seed = match seed {
        Some(n) => n,
        None => 0u64
    }
    law_warm_bounds(tasks, random, seed)?
    law_hedge_charge(parent, clock, random, tasks, net, true, wire_seed)?
    law_hedge_charge(parent, clock, random, tasks, net, false, wire_seed)
}

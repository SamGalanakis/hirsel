fn decode_keyed_edits(file: String, raw: Bytes, mut at: u64) -> Result[List[format.KeyedEdit], Error] {
    let edit_count = failure_result_from_rep(format.disk_count(file, raw, mut at, 7))?
    if edit_count == 0 {
        return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
    }
    let mut edits: List[format.KeyedEdit] = list.new()
    let mut saw_keyed_call = false
    for _ in 0u64 .. edit_count {
        let tree: u8 = int.truncate(failure_result_from_rep(format.disk_number(file, raw, mut at, 1))?)
        let width = match tree {
            0 => 65u64,
            4 => 65u64,
            1 => 387u64,
            6 => 387u64,
            2 => 460u64,
            3 => 526u64,
            5 => 131u64,
            _ => return Error(failure_from_rep(format.disk_fault(file, at - 1, Malformed))),
        }
        let kind = failure_result_from_rep(format.disk_number(file, raw, mut at, 1))?
        if kind == 3 {
            if tree != format.CLAIMS || saw_keyed_call {
                return Error(failure_from_rep(format.disk_fault(file, at - 1, Malformed)))
            }
            let reply = failure_result_from_rep(format.disk_blob(file, raw, mut at, 41 + CLAIM_DONE_MAX))?
            let state = claim_parse(reply) ?=> |_| failure_from_rep(format.disk_fault(file, at, Malformed))
            let claim = failure_result_from_rep(format.disk_blob(file, raw, mut at, width))?
            let op_end = failure_result_from_rep(txn.claim_op_end(claim))?
            let _ = failure_result_from_rep(txn.claim_principal_end(claim, op_end))?
            let (take record, settlement) = failure_result_from_rep(format.decode_call_fields(file, raw, mut at))?
            if !state.replied || request_digest(record.entry, record.args) != RequestDigest(b: state.digest) {
                return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
            }
            saw_keyed_call = true
            let call = format.KeyedCallSection(record: take record, settlement)
            list.push(mut edits, format.KeyedEdit(tree, key: take claim, value: Some(take reply), call: Some(take call)))
            continue
        }
        let key = failure_result_from_rep(format.disk_blob(file, raw, mut at, width))?
        if list.len(key) == 0 {
            return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
        }
        let value: Option[Bytes] = match kind {
            1 => {
                let maximum = match tree {
                    0 => 16384u64,
                    1 => types.FORMAT_VALUE_MAX,
                    4 => 8u64,
                    5 => 8u64,
                    _ => 0u64,
                }
                Some(failure_result_from_rep(format.disk_blob(file, raw, mut at, maximum))?)
            },
            2 => None,
            _ => return Error(failure_from_rep(format.disk_fault(file, at - 1, Malformed))),
        }
        list.push(mut edits, format.KeyedEdit(tree, key: take key, value: take value, call: None))
    }
    Ok(take edits)
}

// RTC-9 readers for a unit that holds no session: the recorder (media_record)
// applies the control order to an observer router and reads what it records.
/// A router that holds no session (media_record): every seat is remote to it.
/// It applies the control order like any unit, so it knows the rooms, seats,
/// publications, down-tracks and fences (RTC-7), and makes no post of its own.
pub fn observer(r: Random) -> Router {
    on_unit(r, UNITS_MAX)
}

/// A down-track as every unit knows it.
pub type DownInfo: key {
    room: peer.RoomId,
    sub: peer.Gen,
    publication: PublicationId,
    target: Target
}

/// The down-tracks whose subscriber's home is unit `home`.
pub fn downs_on(r: Router, home: u16) -> List[DownInfo] {
    let mut out: List[DownInfo] = list.new()
    for d in r.downs {
        if d.home == home {
            list.push(mut out, DownInfo(room: d.room, sub: d.sub, publication: d.publication, target: d.target))
        }
    }
    out
}

/// A publication as every unit knows it: its owner, the owner's home unit and
/// its shape.
pub type PublicationInfo: key {
    owner: peer.Gen,
    home: u16,
    shape: Shape
}

pub fn publication_info(r: Router, room: peer.RoomId, p: PublicationId) -> Option[PublicationInfo] {
    let pi = publication_at(r, room, p)?
    let x = r.publications[pi]
    Some(PublicationInfo(owner: x.owner, home: x.home, shape: Shape(codec: x.codec, pli: x.pli, fir: x.fir, encodings: int.narrow(list.len(x.encodings)))))
}

// ---- Readers ----
/// The media and RTX SSRCs of `who`'s down-track of a publication, on its home unit.
pub fn track_ssrcs(r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId) -> Option[(u32, Option[u32])] {
    let di = down_at(r, room, who, p)?
    let mi = member_at(r, room, who)?
    peer.track_ssrcs(r.members[mi].session, r.downs[di].track)
}

pub fn session_drops(r: Router, room: peer.RoomId, who: peer.Gen) -> Option[peer.Drops] {
    let mi = member_at(r, room, who)?
    Some(peer.drops(r.members[mi].session))
}

/// The live down-tracks of `who`'s session, on its home unit.
pub fn live_tracks(r: Router, room: peer.RoomId, who: peer.Gen) -> Option[u64] {
    let mi = member_at(r, room, who)?
    Some(peer.live_tracks(r.members[mi].session))
}

pub fn control_ssrc(r: Router, room: peer.RoomId, who: peer.Gen) -> Option[u32] {
    let mi = member_at(r, room, who)?
    Some(peer.control_ssrc(r.members[mi].session))
}

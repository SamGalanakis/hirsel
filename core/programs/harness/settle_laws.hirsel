// Extend J1 through settlement. The first worker is halted after the blob
// write. Reopen the cut filesystem and verify that the Once dispatch
// is in doubt and the body never hits the journal.
fn law_blob_results(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, seed: Option[u64]) -> bool waits {
    let wire_seed = match seed {
        Some(n) => n,
        None => 7u64
    }
    let (model, model_in): (Sender[ModelAsk], Receiver[ModelAsk]) = channel.new(4u64)
    let (tool, tool_in): (Sender[ToolAsk], Receiver[ToolAsk]) = channel.new(4u64)
    let models = task.spawn(tasks, bytes 65536u64, take model_in, model_service)
    let tools = task.spawn(tasks, bytes 262144u64, take tool_in, blob_tools)
    let services = Services(model: take model, tool: take tool, blobs: None)
    let (first_dir, disk) = mount(tasks, clock, std.sim.fs.new(), std.sim.world.plan(0u64))
    seed_session(first_dir, clock, random, tasks)
    let (take cutting, first_server) = blob_fixture(tasks, clock, random, BLOB_SIZE, wire_seed)
    let (stop, stop_in): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (checkpoint, checkpoints): (Sender[BlobCut], Receiver[BlobCut]) = channel.new(1u64)
    let mut cut_fixture = take cutting
    cut_fixture.cut = Some(channel.sender(checkpoint))
    let mut cut_services = copy_services(services)
    cut_services.blobs = Some(take cut_fixture)
    let config = blob_settings(first_dir, clock, random, tasks, net, take cut_services)
    let allowance = life_bytes(config)
    let status = result.unwrap(runner.status_root())
    let life = Life(config: take config, stop: take stop_in, status: take status)
    let first = task.spawn(tasks, bytes allowance, FirstBlobLife(life: take life, checkpoint: take checkpoint), first_blob_life)
    if let PlaceEnded = result.unwrap(channel.receive(checkpoints)) {
        fail("blob: place ended before the PUT acknowledgement")
    }
    result.unwrap(channel.send(stop, ()))
    result.unwrap(task.join(take first))
    if model_asked(services) != 1u64 || tool_ran(services) != 1u64 {
        fail("blob: missed the cut before settle")
    }
    let (take image, _) = unmount(take first_dir, take disk)
    let orphan = result.unwrap(task.join(take first_server))
    if !saved_blob(orphan, 1u64) {
        fail("blob: the acknowledged PUT left no object")
    }
    let mut crashed = take image
    let mut plan = std.sim.world.plan(match seed {
        Some(n) => n,
        None => 1u64
    })
    std.sim.fs.crash(mut crashed, mut plan)
    let (reopened, replay) = mount(tasks, clock, take crashed, std.sim.world.plan(0u64))
    let (second, _stop_second, _) = launch(tasks, blob_settings(reopened, clock, random, tasks, net, copy_services(services)))
    let _ = result.unwrap(result.unwrap(task.join(take second)))
    let _ = stored_blob(reopened, clock, random, tasks, true)
    let _ = unmount(take reopened, take replay)
    if model_asked(services) != 2u64 || tool_ran(services) != 1u64 {
        fail("blob: the Once effect dispatched again")
    }
    let mut name = string.with_capacity(32u64)
    let clean = result.unwrap(host.mkdtemp(parent, mut name))
    seed_session(clean, clock, random, tasks)
    let (fixture, server) = blob_fixture(tasks, clock, random, BLOB_SIZE, wire_seed)
    // A Served port closes at quiescence. Keep it available while the
    // place is idle and while its journal is reopened for readback.
    let (world, _) = std.sim.world.new(2u64, 0u64, 0u64)
    let (done, finishing): (Sender[()], Receiver[()]) = channel.new(1u64)
    let keeper = task.spawn(tasks, bytes 65536u64, KeepServer(world: take world, real: clock, stop: take finishing), keep_blob_server)
    let mut clean_services = copy_services(services)
    clean_services.blobs = Some(copy_blob_fixture(fixture))
    let (third, _stop_third, _) = launch(tasks, blob_settings(clean, clock, random, tasks, net, take clean_services))
    let _ = result.unwrap(result.unwrap(task.join(take third)))
    let reference = option.unwrap(stored_blob(clean, clock, random, tasks, false))
    let checked = check_blob(fixture, reference) && model_asked(services) == 4u64 && tool_ran(services) == 2u64
    drop(take services)
    drop(take fixture)
    let _ = result.unwrap(task.join(take models))
    let _ = result.unwrap(task.join(take tools))
    result.unwrap(std.dir.remove_all(parent, name))
    result.unwrap(channel.send(done, ()))
    result.unwrap(task.join(take keeper))
    let observed = result.unwrap(task.join(take server))
    checked && saved_blob(observed, 2u64)
}

type Tally {
    users: u64,
    systems: u64,
    answers: u64,
    calls: u64,
    results: u64,
    returned: u64,
    resumed: u64,
    ordered: bool
}

fn tally(read_handle: store.Reader, snap: store.Snapshot, h: harness.Handles, n: u64) -> Tally waits {
    let mut t = Tally(users: 0u64, systems: 0u64, answers: 0u64, calls: 0u64, results: 0u64, returned: 0u64, resumed: 0u64, ordered: true)
    let bump_bytes = string.into_bytes("1")
    let resume_bytes = string.into_bytes("woke")
    for pos in 0u64 .. n {
        match result.unwrap(store.get(read_handle, snap, h.entries, pos)) {
            Some(User(_)) => {
                t.users += 1u64
                if pos != 0u64 {
                    t.ordered = false
                }
            },
            Some(System(p)) => {
                if t.systems == 0u64 && (pos != 1u64 || !p.baseline) {
                    t.ordered = false
                }
                t.systems += 1u64
            },
            Some(Assistant(a)) => {
                if t.answers == 0u64 && pos != 2u64 {
                    t.ordered = false
                }
                if t.answers == 1u64 && (pos + 1u64 != n || a.text != "done") {
                    t.ordered = false
                }
                t.answers += 1u64
                t.calls += list.len(a.calls)
            },
            Some(ToolResult(id, outcome, _)) => {
                t.results += 1u64
                let expected = if t.results == 1u64 {
                    "c1"
                } else {
                    "c2"
                }
                if id != expected || t.answers != 1u64 {
                    t.ordered = false
                }
                match outcome {
                    Returned(Inline(out)) if id == "c1" && out == bump_bytes => {
                        t.returned += 1u64
                    },
                    Returned(Inline(out)) if id == "c2" && out == resume_bytes => {
                        t.resumed += 1u64
                    },
                    InDoubt if id == "c1" => (),
                    _ => {
                        t.ordered = false
                    },
                }
            },
            _ => {
                t.ordered = false
            },
        }
    }
    t
}

type Cut: send = Reached(bool, bool) | Beyond

const MATRIX_IDLE_MS: u64 = 100u64

fn approval_rows(read_handle: store.Reader, snap: store.Snapshot, h: harness.Handles, answers: u64) -> bool waits {
    let wait = result.unwrap(store.get(read_handle, snap, h.waits, wait_zero()))
    let reaction = result.unwrap(store.get(read_handle, snap, h.views, 1000u64))
    let runs = result.unwrap(store.get(read_handle, snap, h.views, 4000u64))
    let patch = result.unwrap(store.get(read_handle, snap, h.entries, 5u64))
    if answers == 0u64 {
        return match (take wait, take reaction, take runs, take patch) {
            (None, None, None, None) => true,
            _ => false
        }
    }
    let approved = match wait {
        Some(Decided(_, true)) => true,
        _ => false
    }
    let reacted_once = match reaction {
        Some(Status(text)) => text == "x",
        _ => false
    }
    let parked_once = match runs {
        Some(Status(text)) => text == "x",
        _ => false
    }
    let parked_key = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.TOOL, ordinal: 1u64)
    let armed_deadline = match result.unwrap(store.get(read_handle, snap, h.effects, parked_key)) {
        Some(e) => e.deadline > 0u64,
        None => false,
    }
    let patched = match patch {
        Some(System(p)) => !p.baseline && list.len(p.changes) == 1u64 && p.changes[0].key == "a" && match p.changes[0].text {
            Some(text) => text == "x",
            None => false
        },
        _ => false,
    }
    approved && reacted_once && parked_once && armed_deadline && patched
}

// Law M1 (astra crash matrix over every filesystem operation): the first
// life fails its k-th filesystem operation with EIO and ends; the image is
// then cut at a seeded point that keeps every synced write; a second life
// reopens it and runs until idle. Oracle, derived by hand from the script
// (two rounds, 10+5 tokens each, one Once `bump`, a Once model):
// the tool runs at most once and a Returned result means it ran; the model
// is asked at most once per round, and an ask with no durable answer is a
// doubt that ends the run, never a second ask; known spend is 15 per
// durable answer, nothing stays reserved, and a doubted ask leaves exactly
// its 4096 reserve unresolved; the run finishes and the session is idle; an
// Answered run has the complete transcript in order. The approval and park
// scenario adds one approval, one resumed tool, and a patch from the reaction.
fn matrix_case(clock: Clock, random: Random, tasks: Tasks, net: Net, scenario: MatrixScenario, site: u64, cut_seed: u64) -> Cut waits {
    let (seed_dir, seed_server) = mount(tasks, clock, std.sim.fs.new(), std.sim.world.plan(0u64))
    if scenario == ToolAndAnswer {
        seed_session(seed_dir, clock, random, tasks)
    } else {
        seed_with(seed_dir, clock, random, tasks, matrix_agent(), result.unwrap(matrix_wired()))
    }
    let (seeded, _) = unmount(take seed_dir, take seed_server)
    let mut faults = std.sim.world.plan(site)
    std.sim.world.script(mut faults, site, Eio)
    let (model, model_in): (Sender[ModelAsk], Receiver[ModelAsk]) = channel.new(4u64)
    let (tool, tool_in): (Sender[ToolAsk], Receiver[ToolAsk]) = channel.new(4u64)
    let models = task.spawn(tasks, bytes 65536u64, MatrixModel(inbox: take model_in, scenario: scenario), matrix_model)
    let tools = task.spawn(tasks, bytes 65536u64, take tool_in, answering_tools)
    let services = Services(model: take model, tool: take tool, blobs: None)
    let (first_dir, first_server) = mount(tasks, clock, take seeded, take faults)
    let (first, _stop_first, status) = launch(tasks, matrix_settings(scenario, first_dir, clock, random, tasks, net, copy_services(services)))
    let (first_ended, poisoned) = match task.join(take first) {
        Ok(Error(Open(Store(Poisoned(Other(5)))))) => (true, match latest.read(status).phase {
            Ready => true,
            _ => false
        }),
        Ok(Error(_)) => (true, false),
        Ok(Ok(Stopped(_))) => (true, false),
        _ => (false, false),
    }
    let (image, after) = unmount(take first_dir, take first_server)
    let mut left = take after
    if let Some(_) = std.sim.world.take_fault(mut left, site) {
        let Services(model: take m, tool: take t, ..) = take services
        let _ = take m
        let _ = take t
        let _ = task.join(take models)
        let _ = task.join(take tools)
        return Beyond
    }
    let mut cut = take image
    let mut cutting = std.sim.world.plan(cut_seed)
    std.sim.fs.crash(mut cut, mut cutting)
    let (second_dir, second_server) = mount(tasks, clock, take cut, std.sim.world.plan(0u64))
    let (second, _stop_second, _) = launch(tasks, matrix_settings(scenario, second_dir, clock, random, tasks, net, copy_services(services)))
    let second_ended = match task.join(take second) {
        Ok(Ok(Stopped(_))) => true,
        _ => false
    }
    let asked = model_asked(services)
    let ran = tool_ran(services)
    let (finished_image, _) = unmount(take second_dir, take second_server)
    let (check_dir, check_server) = mount(tasks, clock, take finished_image, std.sim.world.plan(0u64))
    let mut db = result.unwrap(store.open(tasks, check_dir, clock, random, runner.triggers.law_options()))
    let snap = store.snapshot(db)
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let session = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.session, 0u64)))
    let run = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.runs, 0u64)))
    let t = tally(result.unwrap(store.reader(db, 0u64)), snap, h, session.next_pos)
    let extra = scenario == ApprovalAndPark
    let approvals = !extra || approval_rows(result.unwrap(store.reader(db, 0u64)), snap, h, t.answers)
    let (finished, done_ok, doubt) = match run.phase {
        Finished(Answered) => (true, true, false),
        Finished(Stopped(why)) if why == "model call in doubt" => (true, false, true),
        _ => (false, false, false),
    }
    result.unwrap(store.close(take db))
    let _ = unmount(take check_dir, take check_server)
    let Services(model: take m, tool: take t2, ..) = take services
    let _ = take m
    let _ = take t2
    let _ = task.join(take models)
    let _ = task.join(take tools)
    let doubts = if doubt {
        1u64
    } else {
        0u64
    }
    let calls = if extra {
        2u64
    } else {
        1u64
    }
    let once = ran <= 1u64 && (t.returned == 0u64 || ran == 1u64)
    let model_once = asked <= 2u64 && asked >= t.answers && asked <= t.answers + doubts
    let spend = run.spend.known == 15u64 * t.answers && run.spend.reserved == 0u64 && run.spend.unresolved == 4096u64 * doubts
    let idle = match session.active_run {
        None => true,
        Some(_) => false
    }
    let shape = t.ordered && t.users == 1u64 && if t.answers == 0u64 {
        ran == 0u64 && session.next_pos == 2u64 && t.results == 0u64
    } else {
        let systems = if extra {
            2u64
        } else {
            1u64
        }
        let resumes = if extra {
            1u64
        } else {
            0u64
        }
        t.systems == systems && t.results == calls && t.calls == calls && t.resumed == resumes && session.next_pos == 1u64 + systems + t.answers + t.results && (!done_ok || t.answers == 2u64)
    }
    Reached(first_ended && second_ended && finished && once && model_once && spend && idle && shape && approvals, poisoned)
}

fn check_matrix(clock: Clock, random: Random, tasks: Tasks, net: Net, scenario: MatrixScenario) -> () waits {
    let mut site = 0u64
    let mut poisoned = 0u64
    loop {
        match matrix_case(clock, random, tasks, net, scenario, site, site + 1u64) {
            Beyond => break,
            Reached(true, saw_poison) => if saw_poison {
                poisoned += 1u64
            },
            Reached(false, _) => {
                let mut why = string.from(if scenario == ToolAndAnswer {
                    "tool crash matrix: filesystem operation "
                } else {
                    "approval and park crash matrix: filesystem operation "
                })
                string.push_u64(mut why, site)
                fail(take why)
            },
        }
        site += 1u64
    }
    // Fewer than 20 sites means the fault plan never reached the place's writes.
    if site < 20u64 {
        fail("crash matrix: the faults never reached the run's writes")
    }
    if poisoned == 0u64 {
        fail("crash matrix: no EIO exited an online head with a poison error")
    }
}

@test
fn test_crash_matrix(clock: Clock, random: Random, tasks: Tasks, net: Net, seed_grant: Env) -> Result[(), ()] waits {
    if let Some(seed) = std.sim.world.test_seed(seed_grant) {
        // The ordinary law sweeps every site. A campaign seed samples a
        // scenario, EIO site and crash image, with a reached site required.
        let mut plan = std.sim.world.plan(seed)
        let scenario = if std.sim.world.pick(mut plan, 2u64) == 0u64 {
            ToolAndAnswer
        } else {
            ApprovalAndPark
        }
        let site = std.sim.world.pick(mut plan, 256u64)
        let cut_seed = std.sim.world.pick(mut plan, 0xffffffffffffffffu64)
        match matrix_case(clock, random, tasks, net, scenario, site, cut_seed) {
            Reached(true, _) => return Ok(()),
            Reached(false, _) => return Error(()),
            Beyond => (),
        }
        match matrix_case(clock, random, tasks, net, scenario, site % 20u64, cut_seed) {
            Reached(true, _) => return Ok(()),
            _ => return Error(()),
        }
    }
    check_matrix(clock, random, tasks, net, ToolAndAnswer)
    check_matrix(clock, random, tasks, net, ApprovalAndPark)
    Ok(())
}

// ---- deadline races ----
// The race agent's deadlines, and how long each case's service holds its
// reply.
const RACE_MODEL_MS: u64 = 1000u64

const RACE_TOOL_MS: u64 = 3000u64

const LATE_MODEL_MS: u64 = 2500u64

const LATE_TOOL_MS: u64 = 4000u64

const SLOW_TOOL_MS: u64 = 2000u64

fn race_agent() -> harness.Agent[Grants, ()] {
    let mut a = crash_agent()
    a.limits.model_ms = RACE_MODEL_MS
    a.limits.tool_ms = RACE_TOOL_MS
    a
}

fn race_wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(race_advance), code.describe(race_effect))
}

fn race_advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: runner.park.ParkId) -> Result[(), harness.Refused] {
    let w = race_wired()?
    harness.advance_park(mut tx, h, race_agent(), w, take wake)
}

fn race_effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    let Some(ctx) = view g.context else {
        fail("only an attempt's G reaches an effect; a bind's G has no trigger context")
    }
    harness.effect(ctx, g.handles, g, take key, race_agent(), code.describe(race_settle), None)
}

fn race_settle(mut tx: store.Tx, h: harness.Handles, a: runner.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = race_wired() else {
        return Error(Missing("harness: wiring"))
    }
    harness.settle(mut tx, h, race_agent(), w, a, take m)
}

fn race_place(mut r: runner.Registry[Grants, harness.Handles]) -> Result[(), runner.RegisterError] {
    harness.register_standard(mut r, code.describe(race_advance), code.describe(race_effect), code.describe(race_settle), harness.select_handles, BYTES, BYTES)
}

// Which reply comes after its deadline.
type Late: key + send = SlowTool | LateModel | LateTool

type LateModelSeed: send {
    inbox: Receiver[ModelAsk],
    clock: Clock,
    hold_ms: u64
}

type LateToolSeed: send {
    inbox: Receiver[ToolAsk],
    clock: Clock,
    hold_ms: u64
}

// The script's model; its first reply waits hold_ms.
fn late_model_service(take seed: LateModelSeed) -> () waits {
    let LateModelSeed(inbox: take inbox, clock, hold_ms) = take seed
    let mut asked = 0u64
    while let Ok(take request) = channel.receive(inbox) {
        match take request {
            Ask(after_tool, reply) => {
                asked += 1u64
                if asked == 1u64 && hold_ms > 0u64 {
                    std.clock.sleep_ns(clock, hold_ms * 1000000u64)
                }
                let _ = channel.send(reply, scripted_answer(after_tool))
            },
            Asked(reply) => {
                let _ = channel.send(reply, asked)
            },
        }
    }
}

// `bump`; its reply waits hold_ms.
fn late_tool_service(take seed: LateToolSeed) -> () waits {
    let LateToolSeed(inbox: take inbox, clock, hold_ms) = take seed
    let mut ran = 0u64
    while let Ok(take request) = channel.receive(inbox) {
        match take request {
            Run(_, take reply) => {
                ran += 1u64
                if hold_ms > 0u64 {
                    std.clock.sleep_ns(clock, hold_ms * 1000000u64)
                }
                let _ = channel.send(reply, string.into_bytes("1"))
            },
            Ran(reply) => {
                let _ = channel.send(reply, ran)
            },
        }
    }
}

type Raced {
    asked: u64,
    ran: u64,
    finish: Option[harness.Finish],
    spend: harness.Spend,
    next_pos: u64,
    result: Option[harness.Outcome],
    said: String
}

fn race_case(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, late: Late) -> Raced waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    seed_with(dir, clock, random, tasks, race_agent(), result.unwrap(race_wired()))
    let (model, model_in): (Sender[ModelAsk], Receiver[ModelAsk]) = channel.new(4u64)
    let (tool, tool_in): (Sender[ToolAsk], Receiver[ToolAsk]) = channel.new(4u64)
    let model_hold = if late == LateModel {
        LATE_MODEL_MS
    } else {
        0u64
    }
    let tool_hold = match late {
        LateTool => LATE_TOOL_MS,
        SlowTool => SLOW_TOOL_MS,
        LateModel => 0u64
    }
    let models = task.spawn(tasks, bytes 65536u64, LateModelSeed(inbox: take model_in, clock: clock, hold_ms: model_hold), late_model_service)
    let tools = task.spawn(tasks, bytes 65536u64, LateToolSeed(inbox: take tool_in, clock: clock, hold_ms: tool_hold), late_tool_service)
    let services = Services(model: take model, tool: take tool, blobs: None)
    let config = settings_of(code.describe(race_place), harness.entries(result.unwrap(race_wired())), dir, clock, random, tasks, net, copy_services(services), Some(IDLE_MS))
    let (life, _stop, _) = launch(tasks, take config)
    let ended = task.join(take life)
    if let Ok(Ok(Stopped(_))) = ended {} else {
        fail("race: the place did not stop")
    }
    let asked = model_asked(services)
    let ran = tool_ran(services)
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let snap = store.snapshot(db)
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let session = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.session, 0u64)))
    let run = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.runs, 0u64)))
    let ending: Option[harness.Finish] = match run.phase {
        Finished(f) => Some(clone(f)),
        _ => None
    }
    let mut outcome: Option[harness.Outcome] = None
    let mut said = string.new()
    for pos in 0u64 .. session.next_pos {
        match result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.entries, pos)) {
            Some(ToolResult(_, o, _)) => {
                outcome = Some(clone(o))
            },
            Some(Assistant(a)) => {
                said = clone(a.text)
            },
            _ => (),
        }
    }
    let raced = Raced(asked: asked, ran: ran, finish: take ending, spend: clone(run.spend), next_pos: session.next_pos, result: take outcome, said: take said)
    result.unwrap(store.close(take db))
    let Services(model: take m2, tool: take t2, ..) = take services
    let _ = take m2
    let _ = take t2
    let _ = task.join(take models)
    let _ = task.join(take tools)
    result.unwrap(std.dir.remove_all(parent, name))
    take raced
}

fn spent_as(r: Raced, known: u64, unresolved: u64) -> bool {
    r.spend.known == known && r.spend.reserved == 0u64 && r.spend.unresolved == unresolved
}

fn cancelling(mut db: store.Db, h: harness.Handles, who: store.Caller) -> Result[harness.Finish, harness.Refused] waits {
    let w = wired()?
    let ran = store.run(mut db, None, (store.copy_env(h), store.copy_env(who), store.copy_env(w)), fn(mut tx, call_env) -> Result[harness.Finish, harness.Refused] {
        harness.cancel(mut tx, call_env.0, call_env.2, call_env.1, 0u64)
    })
    match take ran {
        Ok(Committed(done)) => {
            result.unwrap(store.durable(mut db, done.ticket))
            Ok(clone(done.value))
        },
        Ok(Aborted(store.Undone(value: take why, ..))) => Error(take why),
        _ => fail("cancel: transaction failed"),
    }
}

fn cancel_approval_race(parent: Dir, clock: Clock, random: Random, tasks: Tasks, decide_first: bool) -> bool waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let mut holds: List[u8] = list.new()
    list.push(mut holds, 1u8)
    let a = gated(take holds)
    let mut db = answered(dir, clock, random, tasks, bump_call("{}"))
    kick(mut db, a)
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let refused = match cancelling(mut db, h, store.Caller(issuer: 2u8, subject: string.into_bytes("alice"))) {
        Error(NotAllowed) => true,
        _ => false
    }
    let d = decision(harness.approval_key("bump", 1u64, Inline(string.into_bytes("{}"))), true)
    let was_approved = decide_first && match deciding(mut db, a, alice(), clone(d)) {
        Ok(Approved) => true,
        _ => false
    }
    let ended = cancelling(mut db, h, alice())
    let repeated = deciding(mut db, a, alice(), take d)
    let got = result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.waits, wait_zero()))
    let race_won = if decide_first {
        was_approved && match (take repeated, take got) {
            (Ok(Approved), Some(Decided(_, true))) => true,
            _ => false
        }
    } else {
        match (take repeated, take got) {
            (Error(Conflict), Some(Revoked)) => true,
            _ => false
        }
    }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    refused && race_won && match ended {
        Ok(Cancelled) => true,
        _ => false
    }
}

type ParkOrder: key = CancelFirst | ResumeFirst | DeadlineFirst

fn cancel_park_race(parent: Dir, clock: Clock, random: Random, tasks: Tasks, ordering: ParkOrder) -> bool waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    let mut a = crash_agent()
    if ordering == DeadlineFirst {
        a.limits.tool_ms = 0u64
    }
    list.push(mut a.tools, harness.inside("park", "waits for a wake", "{}", code.describe(park)))
    let mut db = answered(dir, clock, random, tasks, harness.Call(id: "c1", name: "park", args: Inline(string.into_bytes("{}"))))
    kick(mut db, a)
    kick(mut db, a)
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let was_parked = match member(mut db) {
        Parked(_) => true,
        _ => false
    }
    let first = ordering != CancelFirst || match cancelling(mut db, h, alice()) {
        Ok(Cancelled) => true,
        _ => false
    }
    let filed = resuming(mut db, a, "woke")
    let repeated = cancelling(mut db, h, alice())
    let settled = match (ordering, filed, member(mut db)) {
        (CancelFirst, Ignored, Settled(Tool(Failed(why)))) => why == "run cancelled",
        (ResumeFirst, Recorded, Settled(Tool(Returned(Inline(out))))) => out == string.into_bytes("woke"),
        (DeadlineFirst, Ignored, Settled(Tool(Failed(why)))) => why == "tool deadline",
        _ => false,
    }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    first && was_parked && settled && match repeated {
        Ok(Cancelled) => true,
        _ => false
    }
}

// Start from the committed dispatch marker and deliver the model reply
// through the same runner attempt fence as the real worker.
fn cancel_model_race(parent: Dir, clock: Clock, random: Random, tasks: Tasks, cancel_first: bool) -> bool waits {
    let mut name = string.with_capacity(32u64)
    let dir = result.unwrap(host.mkdtemp(parent, mut name))
    seed_session(dir, clock, random, tasks)
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
    let h = result.unwrap(store.bind_declaration(mut db, Open, harness.declare_tables))
    let who = store.Caller(issuer: 1u8, subject: list.new())
    let id = harness.EffectKey(run: 0u64, round: 0u64, kind: harness.MODEL, ordinal: 0u64)
    let pending = option.unwrap(result.unwrap(runner.triggers.next_pending(result.unwrap(store.reader(db, 0u64)), store.snapshot(db), h.triggers, fn(candidate: runner.triggers.Id) -> bool {
        false
    })))
    let marked = store.run(mut db, None, (store.copy_env(h), store.copy_env(id), store.copy_env(pending)), fn(mut tx, call_env) -> Result[runner.triggers.Attempt, runner.triggers.Error] {
        let Body(attempt) = runner.triggers.start(mut tx, call_env.0 .triggers, call_env.2, list.new())? else {
            fail("cancel race: no granted attempt")
        }
        let mut e = option.unwrap(store.fetch(tx, call_env.0 .effects, call_env.1) ?=> Store)
        e.phase = Dispatched(runner.triggers.number(attempt))
        e.dispatches = 1u64
        store.put(mut tx, call_env.0 .effects, call_env.1, e) ?=> Store
        Ok(attempt)
    })
    let Ok(Committed(dispatched)) = take marked else {
        fail("cancel race: dispatch did not commit")
    }
    result.unwrap(store.durable(mut db, dispatched.ticket))
    let first = !cancel_first || match cancelling(mut db, h, who) {
        Ok(Cancelled) => true,
        _ => false
    }
    let mut reg: runner.Registry[Grants, harness.Handles] = runner.registry()
    result.unwrap(place(mut reg))
    let c: std.codec.Codec[harness.Settle] = std.codec.of()
    let r: std.codec.Codec[harness.Filed] = std.codec.of()
    let key = result.unwrap(runner.attempt_key(code.describe(settle), c, r))
    let mut raw: Bytes = list.new()
    result.unwrap(std.codec.encode(c, harness.Settle(key: id, receipt: Some(Model(scripted_answer(true)))), mut raw))
    let reply = runner.apply_attempt(mut db, reg, h, h.triggers, who, dispatched.value, key, raw)
    let fenced = match take reply {
        Ok(Committed(done)) if !cancel_first => {
            result.unwrap(store.durable(mut db, done.ticket))
            kick(mut db, crash_agent())
            true
        },
        Ok(Aborted(store.Undone(value: Refusal(Cancelled), ..))) if cancel_first => true,
        _ => false,
    }
    let terminal = cancelling(mut db, h, who)
    let snap = store.snapshot(db)
    let stored_run = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.runs, 0u64)))
    let session = option.unwrap(result.unwrap(store.get(result.unwrap(store.reader(db, 0u64)), snap, h.session, 0u64)))
    let phase_won = match stored_run.phase {
        Finished(Cancelled) => cancel_first,
        Finished(Answered) => !cancel_first,
        _ => false,
    }
    let cancel_receipt = match terminal {
        Ok(Cancelled) => cancel_first,
        Ok(Answered) => !cancel_first,
        _ => false,
    }
    let final_rows = if cancel_first {
        stored_run.spend.known == 0u64 && stored_run.spend.unresolved == 4096u64 && session.next_pos == 2u64
    } else {
        stored_run.spend.known == 15u64 && stored_run.spend.unresolved == 0u64 && session.next_pos == 3u64
    }
    result.unwrap(store.close(take db))
    result.unwrap(std.dir.remove_all(parent, name))
    first && fenced && phase_won && cancel_receipt && final_rows && stored_run.spend.reserved == 0u64 && session.active_run == None
}

// Law D1 (astra: deadline races): a deadline and a reply race for one
// effect, and the first to commit wins. The model's deadline is 1 s and the
// tool's 3 s.
// - The first model reply is held 2.5 s. The deadline dooms the call: it is
//   in doubt, the run stops, the held answer is never recorded (its attempt
//   is cancelled, so its settle is refused), and its 4096 reserve stays
//   unresolved.
// - The Once tool's reply is held 4 s. Its result is InDoubt, the run goes
//   on to "done", and the held "1" is never recorded.
// - The tool's reply is held 2 s. The first answer's deadline fires at 1 s,
//   after that answer settled and while the run is still active, and it
//   changes nothing: the tool's "1" is Returned and the run is the plain one.
// Oracle: the services' own counts and the outcomes and spend derived by
// hand from the script (10+5 tokens per answer).
pub fn law_deadline_races(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> u64 waits {
    let a = race_case(parent, clock, random, tasks, net, LateModel)
    let model_late = a.asked == 1u64 && a.ran == 0u64 && a.next_pos == 2u64 && spent_as(a, 0u64, 4096u64) && match a.finish {
        Some(Stopped(why)) => why == "model call in doubt",
        _ => false
    }
    if !model_late {
        return 1u64
    }
    let b = race_case(parent, clock, random, tasks, net, LateTool)
    let tool_late = b.asked == 2u64 && b.ran == 1u64 && b.next_pos == 5u64 && spent_as(b, 30u64, 0u64) && b.said == "done" && match b.result {
        Some(InDoubt) => true,
        _ => false
    } && match b.finish {
        Some(Answered) => true,
        _ => false
    }
    if !tool_late {
        return 2u64
    }
    let c = race_case(parent, clock, random, tasks, net, SlowTool)
    let prompt = c.asked == 2u64 && c.ran == 1u64 && c.next_pos == 5u64 && spent_as(c, 30u64, 0u64) && c.said == "done" && match c.result {
        Some(Returned(Inline(out))) => out == string.into_bytes("1"),
        _ => false
    } && match c.finish {
        Some(Answered) => true,
        _ => false
    }
    if !prompt {
        return 3u64
    }
    if !cancel_approval_race(parent, clock, random, tasks, false) {
        return 4u64
    }
    if !cancel_approval_race(parent, clock, random, tasks, true) {
        return 5u64
    }
    if !cancel_park_race(parent, clock, random, tasks, CancelFirst) {
        return 6u64
    }
    if !cancel_park_race(parent, clock, random, tasks, ResumeFirst) {
        return 7u64
    }
    if !cancel_park_race(parent, clock, random, tasks, DeadlineFirst) {
        return 8u64
    }
    if !cancel_model_race(parent, clock, random, tasks, true) {
        return 9u64
    }
    if !cancel_model_race(parent, clock, random, tasks, false) {
        return 10u64
    }
    0u64
}

@test
fn test_deadline_races(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    // The law answers the first case that broke, or 0.
    let bad = law_deadline_races(parent, clock, random, tasks, net)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

fn unused_peer(g: Grants, id: String) -> Option[mcp_tools.Peer] {
    None
}

fn catalog_agent() -> harness.Agent[Grants, ()] {
    let mut a = sectioned(false)
    a.mcp_peer = Some(code.describe(unused_peer))
    list.push(mut a.gates, harness.Gate(name: "approval", check: code.describe(hold_gate)))
    a
}

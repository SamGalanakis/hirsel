// OWN-11: a mutable scoped parameter retains exactly its original anchors.
// expect: run skip_run() = 303
// expect: run forward_run() = 203
scoped type Cursor {input:View[Bytes],pos:u64}
fn skip(mut c:Cursor) {c=Cursor(input:c.input,pos:c.pos+1)}
fn forward(mut c:Cursor) {skip(mut c)}
fn skip_run()->u64 {
 let buf:Bytes=result.unwrap(b"abc")
 let mut c=Cursor(input:view buf,pos:0u64)
 for _ in 0u64..3 {skip(mut c)}
 c.pos*100+list.len(c.input)
}
fn forward_run()->u64 {
 let buf:Bytes=result.unwrap(b"abc")
 let mut c=Cursor(input:view buf,pos:0u64)
 forward(mut c)
 forward(mut c)
 c.pos*100+list.len(c.input)
}
fn positive()->bool {skip_run()==303u64 && forward_run()==203u64 && regions()==3u64}

// Named regions are part of the caller's already-declared anchor set.
// The generic within body is checked; the local region run exercises its value layout.
// expect: run regions() = 3
scoped type RegionCursor[in r] {input:View[Text in r] in r}
fn within[in r](mut c:RegionCursor[in r],t:Text in r) {c=RegionCursor(input:view t)}
fn regions()->u64 {
 region r {
  let a=result.unwrap(text.copy_in(r,"a"))
  let b=result.unwrap(text.copy_in(r,"abc"))
  let mut c:RegionCursor[in r]=RegionCursor(input:view a)
  c=RegionCursor(input:view b)
  string.byte_len(text.as_string(c.input))
 }
}

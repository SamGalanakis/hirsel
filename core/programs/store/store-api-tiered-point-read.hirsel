fn read_tiered_point_direct[R](d: Dir, owner: StoreId, inventory: pages.TieredReadInventory, opened: u64, branch_id: u32, pin_bytes: u64, tree: pages.PageTree, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    let grant = disk_allocation(scoped fn() -> Result[Arc[pager.TieredReaderGrant], Error] {
        Ok(arc.new(pager.TieredReaderGrant(store: store_key_to_rep(owner), opened: opened, pin_bytes: pin_bytes)))
    })?
    let root = pager.TieredPinRoot(domain: opened, branch: branch_id, generation: inventory.generation, root_stamp: pages.tree_stamp(tree), tails: list.new())
    read_tiered_point_with(PagerDirect(d, store_key_to_rep(owner)), std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, tree, logical, decode_row)
}

fn read_tiered_point[R](source: pager.TieredPageSource, root_grant: Arc[pager.TieredReaderGrant], root: pager.TieredPinRoot, tree: pages.PageTree, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    failure_result_from_rep(read.read_tiered_point(source, root_grant, root, tree, logical, scoped fn(row: Option[View[Bytes]]) -> Result[R, types.Failure] {
        failure_result_to_rep(decode_row(row))
    }))
}

fn read_tiered_point_with[R](take backend: pager.TieredPageBackend, packs: std.omap.OMap[u64, pages.TieredPagerPack], next_stamp: u64, deadline: u64, root_grant: Arc[pager.TieredReaderGrant], root: pager.TieredPinRoot, tree: pages.PageTree, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    failure_result_from_rep(read.read_tiered_point_with(take backend, packs, next_stamp, deadline, root_grant, root, tree, logical, scoped fn(row: Option[View[Bytes]]) -> Result[R, types.Failure] {
        failure_result_to_rep(decode_row(row))
    }))
}

fn retry_tiered_read[R](source: pager.TieredPageSource, root_grant: Arc[pager.TieredReaderGrant], root: pager.TieredPinRoot, key: Bytes, upper: Option[View[Bytes]], direction: pager.TieredDirection, read_row: scoped[view] fn(core.Cell[pager.TieredTouchSet], Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[R, Error]) -> Result[R, Error] waits {
    failure_result_from_rep(read.retry_tiered_read(source, root_grant, root, key, upper, direction, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[R, types.Failure] {
        failure_result_to_rep(read_row(attempt, visible))
    }))
}

fn retry_tiered_read_with[R](take backend: pager.TieredPageBackend, packs: std.omap.OMap[u64, pages.TieredPagerPack], next_stamp: u64, deadline: u64, root_grant: Arc[pager.TieredReaderGrant], root: pager.TieredPinRoot, key: Bytes, upper: Option[View[Bytes]], direction: pager.TieredDirection, read_row: scoped[view] fn(core.Cell[pager.TieredTouchSet], Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[R, Error]) -> Result[R, Error] waits {
    failure_result_from_rep(read.retry_tiered_read_with(take backend, packs, next_stamp, deadline, root_grant, root, key, upper, direction, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[R, types.Failure] {
        failure_result_to_rep(read_row(attempt, visible))
    }))
}

fn empty_place(mut reg: Registry[(), ()]) -> Result[(), RegisterError] {
    Ok(())
}

fn empty_schema(mut d: store.Declare) -> Result[(), store.Error] {
    Ok(())
}

fn budget_config(take disk: Backing, c: Clock, r: Random, tasks: Tasks, n: Net) -> PlaceConfig[(), (), (), ()] {
    let mut session_sizes = wire_defaults(65536u64)
    session_sizes.n_pool = 4194304u64
    PlaceConfig(backing: take disk, sizes: store.derived_sizes(), selection: Reopen, place: code.describe(empty_place), n_place: 262144u64, on_migrate: None, schema: code.describe(empty_schema), session: session_sizes, max_sessions: 1u64, proxies: list.new(), n_publisher: 1048576u64, listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r, stop: Stop(lag_ms: 0u64, grace_ms: 1000u64), wire: None, triggers: None, idle: None)
}

fn refused_budget(take input: (PlaceConfig[(), (), (), ()], u64)) -> Result[Ended, StartError] waits {
    let (take p, root) = take input
    let nested = result.unwrap(bound bytes 0u64 {
        runtime.root_limit()
    })
    if nested != root {
        fail("L60: scoped child read lost the task's root limit")
    }
    let (stopping, stop): (Sender[()], Receiver[()]) = channel.new(1u64)
    let _ = take stopping
    operate(take p, take stop, result.unwrap(status_root()), None)
}

type StopAtReady: send {
    phases: Receiver[Receiver[Phase]],
    stop: Sender[()]
}

fn stop_at_ready(take ready: StopAtReady) -> bool waits {
    let StopAtReady(phases: take handoff, stop: take stop) = take ready
    if let Ok(take phases) = channel.receive(handoff) {
        while let Ok(phase) = channel.receive(phases) {
            if let Ready = phase {
                return match channel.send(stop, ()) {
                    Ok(()) => true,
                    _ => false
                }
            }
        }
    }
    false
}

fn open_sized_place(take config: PlaceConfig[(), (), (), ()]) -> Result[(), String] waits {
    let tasks = config.tasks
    let (stopping, stop): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (watching, phases): (Sender[Receiver[Phase]], Receiver[Receiver[Phase]]) = channel.new(1u64)
    let stopper = task.spawn(tasks, bytes 4096u64, StopAtReady(phases: take phases, stop: take stopping), stop_at_ready)
    let ended = operate(take config, take stop, result.unwrap(status_root()), Some(take watching))
    match take ended {
        Ok(Stopped(_)) => (),
        Error(problem) => return Error(start_text(problem)),
        _ => return Error("L60: place failed to serve and drain"),
    }
    if let Ok(true) = task.join(take stopper) {
        Ok(())
    } else {
        Error("L60: place never reached Ready")
    }
}

fn bucket_budget_config(c: Clock, r: Random, tasks: Tasks, n: Net) -> PlaceConfig[(), (), (), ()] {
    let key = result.unwrap(secret.seal(clone(string.as_bytes("budget fixture")), "mac"))
    capture_budget_config(c, r, tasks, n, "http://127.0.0.1:1", key)
}

fn capture_budget_config(c: Clock, r: Random, tasks: Tasks, n: Net, endpoint: String, key: Secret) -> PlaceConfig[(), (), (), ()] {
    let bucket = BucketBacking(net: n, place: std.object.Bucket(endpoint: string.from(endpoint), aws_region: "us-east-1", bucket: "bucket", prefix: "", style: Path), credentials: std.cred.from_secret("access", secret.share(key), ""), lanes: std.object.LaneConfig(requested_lanes: 1u64, lane_bytes: 1048576u64), level: "bucket", op_ms: 30000u64)
    let mut config = budget_config(Bucket(take bucket), c, r, tasks, n)
    config.sizes = store.Overrides(resident_limit: Some(1048576u64), journal_limit: None, checkpoint_bytes: Some(65536u64), pack_bytes: Some(65536u64), group_bytes: Some(65536u64), group_commits: None, lock_wait_ms: None, cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None)
    take config
}

fn bucket_budget_at_limit(take config: PlaceConfig[(), (), (), ()]) -> Result[(u64, u64), StartError] waits {
    let (_, share, total, _, _) = place_store(config, None)?
    Ok((share, total))
}

// Head: 256 KiB Registry + 1 MiB publisher + 2 MiB own grant.
// Serving: 2 MiB supervisor + one owner at 6,711 + 64 KiB + 256 KiB
// for the Registry + 4 MiB pool. Operate holds 256 KiB and keeps 1 MiB.
const BUDGET_RUNNER_BYTES: u64 = (262144 + 1048576 + 2097152) + (2097152 + 6711 + 65536 + 262144 + 4194304) + 262144 + 1048576

fn keyed_budget_runner_bytes() -> u64 {
    // With no configured keys, the startup allowance adds the periodic task
    // and a single input slot. The declared quota test prices the maps.
    BUDGET_RUNNER_BYTES + 288 + 4096 + bytes[HeadInput]
}

fn bucket_budget_store(config: PlaceConfig[(), (), (), ()]) -> u64 {
    let Bucket(backing) = view config.backing else {
        fail("L60: expected Bucket backing")
    }
    // The fixture fixes resident, pack, checkpoint and group bytes. Its
    // unbounded plan therefore prices the same allocation as its floor plan.
    let plan = result.unwrap(store.planned(Bucket(backing.lanes), 18446744073709551615u64, config.sizes))
    store.planned_bytes(plan)
}

fn exercise_bucket_budget(c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), String] waits {
    let config = bucket_budget_config(c, r, tasks, n)
    let store_bytes = bucket_budget_store(config)
    let root = keyed_budget_runner_bytes() + store_bytes
    let exact = task.spawn(tasks, bytes root, take config, bucket_budget_at_limit)
    if let Ok(Ok((share, total))) = task.join(take exact) {
        if share != store_bytes || total != store_bytes {
            return Error("L60: Bucket store term must include capture")
        }
    } else {
        return Error("L60: exact Bucket root must be admitted")
    }
    let short = task.spawn(tasks, bytes (root - 1), bucket_budget_config(c, r, tasks, n), bucket_budget_at_limit)
    match task.join(take short) {
        Ok(Error(Full(cap))) if cap.requested == root && cap.available == root - 1 => Ok(()),
        _ => Error("L60: Bucket limit refusal must name the root requirement"),
    }
}

fn budget_bucket_server(take input: (Listener, std.sim.s3.Loopback, Clock)) waits {
    let (take listener, take bucket, clock) = take input
    let mut serving = take listener
    let _ = std.sim.s3.serve_loopback(mut serving, take bucket, clock)
}

fn seed_budget_bucket(take config: PlaceConfig[(), (), (), ()]) -> Result[store.StoreId, String] waits {
    let (take options, _, _, _, _) = place_store(config, None) ?=> |problem| start_text(problem)
    let PlaceConfig(backing: take backing, clock: clock, random: random, tasks: tasks, ..) = take config
    let (take opened, _) = open_backing(take backing, options, tasks, clock, random) ?=> |problem| start_text(backing_start_error(take problem))
    let mut db = take opened
    let mut revision: Bytes = list.with_capacity(32u64)
    list.fill(mut revision, 32u64, 1u8)
    let description = Describe(digest: list.new(), target: "", n_place: 262144u64, revision: take revision, exported: list.new(), tables: list.new(), bindings: list.new())
    let raw = result.unwrap(encode_describe(description))
    let binding = result.unwrap(identity_digest(description))
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    let record = ReleaseRecord(release: list.new(), digest: list.new(), binding: clone(binding), n_place: 262144u64, prepared: list.new())
    for activation in 1u64 .. 4u64 {
        let declaration = result.unwrap(store.declare(db, Migrate))
        let mut staged = result.unwrap(store.finish_migration(db, take declaration))
        result.unwrap(store.stage_activation(mut staged, activation, None, raw, codec, record))
        result.unwrap(store.install_bound_activation(mut db, take staged, activation, binding))
    }
    let id = store.identity(db)
    result.unwrap(store.close(take db))
    Ok(id)
}

fn refused_bucket_place(take config: PlaceConfig[(), (), (), ()]) -> Result[Ended, StartError] waits {
    let (closing, stop): (Sender[()], Receiver[()]) = channel.new(1u64)
    let ended = operate(take config, take stop, result.unwrap(status_root()), None)
    let _ = take closing
    take ended
}

fn exercise_bucket_capture(c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), String] waits {
    let key = result.unwrap(secret.seal(clone(string.as_bytes("bucket fixture")), "kdf"))
    let (take listener, address) = result.unwrap(host.listen(n, Addr(ip: V4(0x7f000001u32), port: 0u16), 16u16))
    let mut endpoint = string.from("http://127.0.0.1:")
    string.push_u64(mut endpoint, int.widen(address.port))
    // The fixture only writes small activation records and uses a 64 KiB pack.
    // 512 KiB leaves room beside the exact child root for the loopback peer.
    let server = task.spawn(tasks, bytes 524288u64, (take listener, std.sim.s3.Loopback(bucket: "bucket", access_key: "access", aws_region: "us-east-1", root: secret.share(key), exists_status: 412u16, max_body: 65536u64), c), budget_bucket_server)
    let id = seed_budget_bucket(capture_budget_config(c, r, tasks, n, endpoint, key))?
    let mut stale = capture_budget_config(c, r, tasks, n, endpoint, key)
    stale.selection = Current(2u64)
    let root = keyed_budget_runner_bytes() + bucket_budget_store(stale)
    let refused = task.spawn(tasks, bytes root, take stale, refused_bucket_place)
    let response = task.join(take refused)
    let _ = task.cancel_join(take server)
    let Ok(Error(Open(NotCurrent(Active(3u64, description, capture_wire))))) = response else {
        return Error("L60: Bucket start at the limit must report the current activation")
    }
    let codec: std.codec.Codec[PlaceRead] = std.codec.of()
    let Ok(decoded) = std.codec.decode(codec, capture_wire) else {
        return Error("L60: Bucket refusal omitted its capture")
    }
    let PlaceRead(claim: take claim, store_hi, store_lo, binding: take observed, n_place, ..) = take decoded
    let Some((epoch, _)) = take claim else {
        return Error("L60: Bucket refusal omitted its claim")
    }
    if epoch != 1u64 || store_hi != id.hi || store_lo != id.lo || list.len(observed) != 32u64 || n_place != Some(262144u64) {
        return Error("L60: Bucket refusal did not read activation 3 under the original claim")
    }
    if let None = decode_description(description) {
        return Error("L60: Bucket refusal omitted the description")
    }
    Ok(())
}

fn exercise_local_budgets(take grants: (Dir, Clock, Random, Tasks, Net)) -> Result[(), String] waits {
    let (d, c, r, tasks, n) = take grants
    if runtime.root_limit() != 67108864u64 {
        return Error("L60: executable limit")
    }
    let expected_share = runtime.root_limit() - keyed_budget_runner_bytes()
    let memory = budget_config(Memory, c, r, tasks, n)
    let (_, share, memory_total, _, _) = place_store(memory, None) ?=> |problem| start_text(problem)
    if share != expected_share || memory_total != expected_share {
        return Error("L60: Memory share")
    }
    open_sized_place(take memory)?
    let disk = budget_config(Temp(d), c, r, tasks, n)
    let (disk_sizes, disk_share, disk_total, _, _) = place_store(disk, None) ?=> |problem| start_text(problem)
    let disk_plan = result.unwrap(store.planned(Directory, expected_share, disk.sizes))
    let planned = store.planned_options(disk_plan)
    if disk_share != expected_share || disk_total != store.planned_bytes(disk_plan) || disk_sizes.pack_bytes != planned.pack_bytes || disk_sizes.checkpoint_bytes != planned.checkpoint_bytes || disk_sizes.resident_limit != planned.resident_limit {
        return Error("L60: Directory share")
    }
    open_sized_place(take disk)
}

@test
fn operate_derived_budgets(d: Dir, c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), String] waits {
    // Keep the local executable at 64 MiB. Bucket's exact grant and the
    // loopback peer instead draw on the enclosing test's reservation.
    let local = task.spawn(tasks, bytes 67108864u64, (d, c, r, tasks, n), exercise_local_budgets)
    result.unwrap(task.join(take local))?
    exercise_bucket_budget(c, r, tasks, n)?
    exercise_bucket_capture(c, r, tasks, n)?
    let low = budget_config(Memory, c, r, tasks, n)
    // Memory has a 1 MiB resident minimum and a 1 MiB keep.
    let minimum = store.planned_bytes(result.unwrap(store.planned(Memory, 2 * 1048576u64, low.sizes)))
    let short_root = keyed_budget_runner_bytes() + minimum - 1
    let child = task.spawn(tasks, bytes short_root, (take low, short_root), refused_budget)
    match task.join(take child) {
        Ok(Error(Full(cap))) if cap.requested == minimum && cap.available == minimum - 1 => Ok(()),
        _ => Error("L60: an infeasible share must be returned as Full"),
    }
}

/// `n` empty handshake fragments of type `kind` in one epoch-0 record, message_seq `from`,
/// `from + step`, ...
fn empties(kind: u8, from: u16, n: u16, step: u16) -> Bytes {
    let mut payload: Bytes = list.with_capacity(1200)
    for i in 0u16 .. n {
        list.append(mut payload, hs_fragment(kind, 0, from + i * step, 0, b""))
    }
    plain_record(22, 1000, payload)
}

/// bug: a cookie ClientHello with message_seq 0xFFFF is admitted and numbering flight 4
/// past u16 fails the task (attack 2434 F1). oracle: RFC 6347 section 4.2.2 and OpenSSL
/// ssl/d1_lib.c:1009-1013 by hand: a first ClientHello has message_seq 0 or 1.
@test
fn atk_cookie_seq_overflow() -> Result[(), ()] {
    let c = dtls.cookie_for(cookie_key(), address(20), hello_random())
    let mut cookie: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32 {
        list.push(mut cookie, c[i])
    }
    let mut out: Bytes = list.with_capacity(100)
    if let Discard = dtls.admit(cookie_key(), address(20), whole_hello(7, 2, cookie), mut out) {} else {
        fail("message_seq 2 admitted")
    }
    let hello = whole_hello(7, 0xffff, cookie)
    if let Discard = dtls.admit(cookie_key(), address(20), hello, mut out) {} else {
        fail("message_seq 0xFFFF admitted")
    }
    if list.len(out) != 0 {
        fail("Discard wrote a reply")
    }
    let p = party(711)
    let Party(id: take sid, ..) = take p
    let rs = provide.random(712)
    let mut server = result.unwrap(dtls.server(take sid, dtls.defaults(), address(20), Cookie(cookie_key())))
    let _ = deliver(mut server, rs, 0, single(hello))
    if list.len(drain(mut server, rs, 0)) != 0 {
        fail("Cookie server answered message_seq 0xFFFF")
    }
    match dtls.state(server) {
        Handshaking => (),
        _ => fail("Cookie server left Handshaking on message_seq 0xFFFF"),
    }
    Ok(())
}

type Pair {
    client: dtls.Endpoint,
    server: dtls.Endpoint
}

/// Client connected; the server verified Finished but has no fingerprints yet.
fn unpinned_server_pair(seed: u64, rc: Random, rs: Random) -> Pair {
    let a = party(seed)
    let b = party(seed + 1)
    let Party(id: take client_id, ..) = take a
    let Party(id: take server_id, certificate: server_certificate) = take b
    let mut client = result.unwrap(dtls.client(take client_id, dtls.defaults(), address(1)))
    let mut server = result.unwrap(dtls.server(take server_id, dtls.defaults(), address(2), Verified))
    result.unwrap(dtls.expect(mut client, pin_list(server_certificate)))
    run(mut client, rc, mut server, rs, 0)
    if !is_connected(client) {
        fail("setup: client not connected")
    }
    if let Handshaking = dtls.state(server) {} else {
        fail("setup: server not Handshaking")
    }
    Pair(client: take client, server: take server)
}

/// After the peer's ChangeCipherSpec, `spoof` is one stale_epoch discard: nothing sent and
/// the server still Handshaking.
fn ignored_after_ccs(seed: u64, spoof: Bytes) {
    let rc = provide.random(seed + 10)
    let rs = provide.random(seed + 11)
    let pair = unpinned_server_pair(seed, rc, rs)
    let Pair(client: take client, server: take found) = take pair
    let mut server = take found
    let before = dtls.discards(server).stale_epoch
    let _ = deliver(mut server, rs, SECOND, single(spoof))
    if list.len(drain(mut server, rs, SECOND)) != 0 || dtls.discards(server).stale_epoch != before + 1 {
        fail("epoch-0 handshake record acted after ChangeCipherSpec")
    }
    match dtls.state(server) {
        Handshaking => (),
        _ => fail("spoofed epoch-0 record moved the server out of Handshaking"),
    }
    drop(take client)
}

/// bug: an unauthenticated epoch-0 handshake record still acts after the peer's
/// ChangeCipherSpec: one closes the server with 10 (attack 2434 F2a). oracle: DTLS-4
/// Replay and RFC 6347 section 4.1 by hand: epoch 0 can no longer carry anything genuine.
@test
fn atk_epoch0_message_after_ccs_closes() -> Result[(), ()] {
    ignored_after_ccs(733, empties(11, 5, 1, 1))
    Ok(())
}

/// bug: 90 empty ClientHello fragments in one 1,093-byte datagram make the server seal and
/// queue 90 no_renegotiation alerts (attack 2434 F2b). oracle: as above, by hand.
@test
fn atk_epoch0_hello_after_ccs_seals() -> Result[(), ()] {
    let spoof = empties(1, 5, 90, 1)
    if list.len(spoof) != 13 + 90 * 12 {
        fail("spoof size")
    }
    ignored_after_ccs(723, spoof)
    Ok(())
}

/// Whether receiving `datagram` at 0 was refused for Capacity.
fn refused_capacity(mut e: dtls.Endpoint, r: Random, datagram: Bytes) -> bool {
    let mut data: Bytes = list.new()
    match dtls.receive(mut e, 0, r, datagram, mut data) {
        Error(Capacity(_)) => true,
        _ => false,
    }
}

fn bytes_between(b: Bytes, from: u64, to: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(to - from)
    for i in from .. to {
        list.push(mut out, b[i])
    }
    out
}

/// bug: a Capacity refusal while processing a reassembled message had already advanced past
/// it, so every retransmission was ignored as processed and the handshake ended in Timeout
/// or 10 (attack 2434 F4). oracle: DTLS-8 by hand: a Capacity refusal leaves the endpoint
/// usable, so the retransmitted flight 4 still draws flight 5.
@test
fn capacity_refusal_keeps_message() -> Result[(), ()] {
    let rc = provide.random(781)
    let rs = provide.random(782)
    let mut server = fresh_server(783)
    let mut client = fresh_client(784)
    let _ = deliver(mut server, rs, 0, drain(mut client, rc, 0))
    let flight4 = drain(mut server, rs, 0)
    let parts = records_in(flight4)
    for i in 0u64 .. list.len(parts) {
        if is_plain_message(parts[i], 11) {
            let body = bytes_between(parts[i], 25, list.len(parts[i]))
            let total = list.len(body)
            let half = total / 2
            let seq = seq_of(parts[i])
            let head = plain_record(22, 500, hs_fragment(11, total, seq, 0, bytes_between(body, 0, half)))
            let tail = plain_record(22, 501, hs_fragment(11, total, seq, half, bytes_between(body, half, total)))
            let _ = deliver(mut client, rc, 0, single(head))
            // The last fragment completes Certificate. 768 bytes admit its record and
            // reassembly and refuse processing it (640 to 896 do).
            let outcome = bound bytes 768 {
                refused_capacity(mut client, rc, tail)
            }
            match outcome {
                Ok(true) => (),
                _ => fail("processing Certificate was not refused for Capacity"),
            }
        } else {
            let _ = deliver(mut client, rc, 0, single(parts[i]))
        }
    }
    match dtls.state(client) {
        Handshaking => (),
        _ => fail("a Capacity refusal closed the client"),
    }
    let _ = deliver(mut client, rc, 0, flight4)
    if list.len(drain(mut client, rc, 0)) == 0 {
        fail("the retransmitted flight 4 drew no flight 5")
    }
    Ok(())
}

/// bug: when building flight 6 was refused for Capacity, the next poll connected first and
/// cleared the transcript, so flight 6 carried a Finished over nothing and the client closed
/// with 51 (attack 2434 F5). oracle: RFC 5246 section 7.4.9 by hand: Finished covers every
/// handshake message, so the retried flight 6 must connect the client.
@test
fn capacity_refusal_before_flight_6() -> Result[(), ()] {
    let a = party(791)
    let b = party(792)
    let rc = provide.random(793)
    let rs = provide.random(794)
    let Party(id: take client_id, certificate: client_certificate) = take a
    let Party(id: take server_id, certificate: server_certificate) = take b
    let mut client = result.unwrap(dtls.client(take client_id, dtls.defaults(), address(1)))
    let mut server = result.unwrap(dtls.server(take server_id, dtls.defaults(), address(2), Verified))
    result.unwrap(dtls.expect(mut client, pin_list(server_certificate)))
    result.unwrap(dtls.expect(mut server, pin_list(client_certificate)))
    let _ = deliver(mut server, rs, 0, drain(mut client, rc, 0))
    let _ = deliver(mut client, rc, 0, drain(mut server, rs, 0))
    let parts = records_in(drain(mut client, rc, 0))
    let n = list.len(parts)
    for i in 0u64 .. n - 1 {
        let _ = deliver(mut server, rs, 0, single(parts[i]))
    }
    // 512 bytes let Finished open and verify, and refuse building flight 6.
    let finished = owned(parts[n - 1])
    let outcome = bound bytes 512 {
        refused_capacity(mut server, rs, finished)
    }
    match outcome {
        Ok(true) => (),
        _ => fail("building flight 6 was not refused for Capacity"),
    }
    let _ = deliver(mut client, rc, 0, drain(mut server, rs, 0))
    if !is_connected(client) {
        fail("flight 6 built after a Capacity refusal did not connect the client")
    }
    Ok(())
}

/// bug: at a 0-byte budget, opening an epoch-1 record built its AAD with an infallible
/// allocation, so receive faulted the task instead of answering Capacity (2465). oracle:
/// DTLS-8 by hand: a Capacity refusal leaves the endpoint usable, so the same Finished
/// received again with budget completes the handshake.
@test
fn capacity_refusal_opening_record() -> Result[(), ()] {
    let a = party(811)
    let b = party(812)
    let rc = provide.random(813)
    let rs = provide.random(814)
    let Party(id: take client_id, certificate: client_certificate) = take a
    let Party(id: take server_id, certificate: server_certificate) = take b
    let mut client = result.unwrap(dtls.client(take client_id, dtls.defaults(), address(1)))
    let mut server = result.unwrap(dtls.server(take server_id, dtls.defaults(), address(2), Verified))
    result.unwrap(dtls.expect(mut client, pin_list(server_certificate)))
    result.unwrap(dtls.expect(mut server, pin_list(client_certificate)))
    let _ = deliver(mut server, rs, 0, drain(mut client, rc, 0))
    let _ = deliver(mut client, rc, 0, drain(mut server, rs, 0))
    let parts = records_in(drain(mut client, rc, 0))
    let n = list.len(parts)
    for i in 0u64 .. n - 1 {
        let _ = deliver(mut server, rs, 0, single(parts[i]))
    }
    let finished = owned(parts[n - 1])
    let outcome = bound bytes 0 {
        refused_capacity(mut server, rs, finished)
    }
    match outcome {
        Ok(true) => (),
        _ => fail("opening Finished at budget 0 was not refused for Capacity"),
    }
    let _ = deliver(mut server, rs, 0, single(finished))
    let _ = deliver(mut client, rc, 0, drain(mut server, rs, 0))
    if !is_connected(client) || !is_connected(server) {
        fail("the endpoint refused at budget 0 did not complete the handshake")
    }
    Ok(())
}

/// An epoch-1 application record with `length` bytes of payload.
fn epoch1_record(length: u64) -> Bytes {
    let mut out = unhex("17fefd0001000000000001")
    list.push(mut out, int.narrow(length >> 8))
    list.push(mut out, int.narrow(length & 0xff))
    for _ in 0u64 .. length {
        list.push(mut out, 0)
    }
    out
}

/// bug: before the opener existed, epoch-1 records of any length up to 65,535 bytes were
/// copied and held unauthenticated, about 2 MB of peer-chosen bytes at defaults (attack 2434
/// F6). oracle: RFC 5246 section 6.2.3 by hand: a sealed record is at most 16,384 + 8
/// (explicit nonce) + 16 (tag) = 16,408 bytes, so one byte more is never genuine.
@test
fn oversized_epoch1_never_held() -> Result[(), ()] {
    let rc = provide.random(801)
    let rs = provide.random(802)
    let mut server = fresh_server(803)
    let mut client = fresh_client(804)
    let _ = deliver(mut server, rs, 0, drain(mut client, rc, 0))
    let _ = drain(mut server, rs, 0)
    let _ = deliver(mut server, rs, 0, single(epoch1_record(16408)))
    if dtls.discards(server).tampered != 0 {
        fail("a sealed-size epoch-1 record was refused")
    }
    let _ = deliver(mut server, rs, 0, single(epoch1_record(16409)))
    if dtls.discards(server).tampered != 1 {
        fail("an epoch-1 record past the sealed size was held")
    }
    Ok(())
}

/// One side's end state in a refusal sweep: 0 Handshaking, 1 Connected, 2 Closed.
fn sweep_state(e: dtls.Endpoint) -> u8 {
    match dtls.state(e) {
        Handshaking => 0,
        Connected => 1,
        _ => 2,
    }
}

type SweepEnd: key {
    client: u8,
    server: u8,
    keys: bool
}

fn show_sweep_end(e: SweepEnd, mut out: String) {
    string.push(mut out, "client ")
    string.push_u64(mut out, int.widen(e.client))
    string.push(mut out, " server ")
    string.push_u64(mut out, int.widen(e.server))
    string.push(mut out, if e.keys {
        " keys agree"
    } else {
        " keys differ"
    })
}

/// Numbers the calls of a swept run and bounds the one its budget names.
type SweepCalls {
    budget: Option[std.refuse.Budget],
    calls: u64,
    next: Option[u64],
    now: u64
}

/// The bound for the next call, counting it.
fn sweep_call(mut k: SweepCalls) -> Option[u64] {
    let b = std.refuse.bounded(k.budget, k.calls)
    k.calls += 1
    b
}

/// `datagram` into `e`, bounded when the budget names this call; a call refused for
/// Capacity is repeated unbounded.
fn sweep_receive(mut e: dtls.Endpoint, r: Random, datagram: Bytes, mut k: SweepCalls) {
    let mut data: Bytes = list.with_capacity(2048)
    let Some(b) = sweep_call(mut k) else {
        let _ = dtls.receive(mut e, k.now, r, datagram, mut data)
        return
    }
    let outcome = bound bytes b {
        dtls.receive(mut e, k.now, r, datagram, mut data)
    }
    match outcome {
        Ok(Error(Capacity(c))) => {
            k.next = Some(std.refuse.past(b, c))
            let _ = dtls.receive(mut e, k.now, r, datagram, mut data)
        },
        Ok(_) => (),
        Error(_) => fail("sweep: the bound was refused on entry"),
    }
}

/// Every datagram `e` has queued, each poll bounded when the budget names it; a refused
/// poll is repeated unbounded.
fn sweep_drain(mut e: dtls.Endpoint, r: Random, mut k: SweepCalls) -> List[Bytes] {
    let mut out: List[Bytes] = list.new()
    while true {
        let mut d: Bytes = list.with_capacity(70000)
        let bound_to = sweep_call(mut k)
        let mut polled = match bound_to {
            Some(b) => match (bound bytes b {
                dtls.poll(mut e, k.now, r, mut d)
            }) {
                Ok(take p) => take p,
                Error(_) => fail("sweep: the bound was refused on entry"),
            },
            None => dtls.poll(mut e, k.now, r, mut d),
        }
        if let Error(Capacity(c)) = polled {
            if let Some(b) = bound_to {
                k.next = Some(std.refuse.past(b, c))
            }
            polled = dtls.poll(mut e, k.now, r, mut d)
        }
        match polled {
            Ok(Send(_)) => list.push(mut out, take d),
            _ => break,
        }
    }
    out
}

/// Whether an SRTP packet sealed with the client's exporter keys opens with the server's
/// (RFC 5764 section 4.2: the client's sending keys are the server's receiving keys).
fn exporter_agrees(mut client: dtls.Endpoint, mut server: dtls.Endpoint) -> bool {
    let Ok(take sent_keys) = dtls.take_srtp(mut client) else {
        return false
    }
    let mut sent = take sent_keys
    let Ok(take answered) = dtls.take_srtp(mut server) else {
        return false
    }
    let Ok(take issued) = schedule.sealer(mut sent, Rtp, 0xbeef, 1) else {
        return false
    }
    let mut sealer = take issued
    let Ok(opener) = schedule.opener(answered, Rtp) else {
        return false
    }
    let plain = unhex("80600001000000010000beef7377656570")
    let mut buf: Bytes = list.with_capacity(list.len(plain) + 16)
    list.append(mut buf, plain)
    let Ok(_) = packet.seal(mut sealer, 1, mut buf, 0, 12, b"") else {
        return false
    }
    let Ok(_) = packet.open(opener, 0xbeef, 1, mut buf, 0, 12, b"") else {
        return false
    }
    list.starts_with(buf, plain)
}

type SweepParties {
    client: Party,
    server: Party
}

/// A pinned client and server handshaking with no loss, every call on either endpoint under
/// `budget`.
fn swept_handshake(p: SweepParties, index: u64, budget: Option[std.refuse.Budget]) -> std.refuse.Refusal[SweepEnd] {
    let rc = provide.random(900000 + 2 * index)
    let rs = provide.random(900001 + 2 * index)
    let mut client = result.unwrap(dtls.client(dtls.share_identity(p.client.id), dtls.defaults(), address(1)))
    let mut server = result.unwrap(dtls.server(dtls.share_identity(p.server.id), dtls.defaults(), address(2), Verified))
    result.unwrap(dtls.expect(mut client, pin_list(p.server.certificate)))
    result.unwrap(dtls.expect(mut server, pin_list(p.client.certificate)))
    let mut k = SweepCalls(budget: budget, calls: 0, next: None, now: 0)
    // A round that moves nothing waits one second, as a caller polls at WakeAt: a refusal
    // that only delays a flight to its retransmission still connects (DTLS-5 timers).
    for _ in 0u64 .. 24 {
        let to_server = sweep_drain(mut client, rc, mut k)
        for i in 0u64 .. list.len(to_server) {
            sweep_receive(mut server, rs, to_server[i], mut k)
        }
        let to_client = sweep_drain(mut server, rs, mut k)
        for i in 0u64 .. list.len(to_client) {
            sweep_receive(mut client, rc, to_client[i], mut k)
        }
        if is_connected(client) && is_connected(server) {
            break
        }
        if list.len(to_server) == 0 && list.len(to_client) == 0 {
            k.now += SECOND
        }
    }
    let c = sweep_state(client)
    let s = sweep_state(server)
    let keys = c == 1 && s == 1 && exporter_agrees(mut client, mut server)
    std.refuse.Refusal(end: SweepEnd(client: c, server: s, keys: keys), calls: k.calls, next: k.next)
}

/// bug: a Capacity refusal anywhere in the handshake leaves an endpoint that never connects:
/// a refused message skipped (attack 2434 F4), a refused flight 6 over a cleared transcript
/// (F5), or a refused record open faulting the task (2465).
/// oracle: DTLS-8 and MEM-21: a refusal leaves the endpoint usable, so at every budget where
/// some call first meets a refusal, repeating that call unbounded still connects both sides
/// with agreeing SRTP keys (RFC 5764 section 4.2), as the never-refused run does, and no
/// failure but Capacity is raised.
@test
fn capacity_sweep_handshake() -> Result[(), ()] {
    let parties = SweepParties(client: party(821), server: party(822))
    let swept = std.refuse.sweep(parties, swept_handshake, show_sweep_end)
    match take swept {
        Ok(_) => Ok(()),
        Error(take text) => fail(take text),
    }
}

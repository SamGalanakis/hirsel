fn stream_control(db: Db) -> Result[txn.StreamControl, Error] {
    let Some(raw) = pages.get_page_row(pages.holder_heads(db.holders)[0].roots.streams, b"") else {
        return Ok(txn.StreamControl(max: db.call_streams.streams_max, count: 0u64, expiry_floor: None))
    }
    failure_result_from_rep(txn.decode_stream_control(raw))
}

fn admit_stream(mut db: Db, name: StreamKey, key: Bytes, p: u64, digest: RequestDigest, at: u64, protected: scoped[view] fn(StreamKey) -> bool) -> Result[Admission, Error] waits {
    if name.id.t > at && name.id.t - at > STREAM_FUTURE_SLACK_MS {
        return Ok(StreamFuture(at))
    }
    let mut control = stream_control(db)?
    if txn.stream_at_or_below(name.id.t, control.expiry_floor) {
        return Ok(HistoryUnavailable)
    }
    let aged = txn.age_floor(at, db.call_streams.stream_retention_ms)
    if txn.stream_at_or_below(name.id.t, aged) {
        // Record the established age cutoff even if the row stays until the
        // sweep. A wider retention on reopen cannot recover a refused reply.
        txn.raise_expiry(mut control, option.unwrap(aged))
        let no_reply: Option[fn(Error) -> bool] = None
        let outcome = store_body_at(mut db, 0u64, at, None, no_reply, scoped fn(mut tx: Tx) -> Result[(), Error] {
            failure_result_from_rep(txn.write_stream_control(mut tx.inner, control))
        })?
        return match take outcome {
            Committed(done) => {
                durable(mut db, done.ticket)?;
                Ok(HistoryUnavailable)
            },
            Refused(c) => Error(Full(c)),
            Aborted(Undone(value: take error, ..)) => Error(take error),
            _ => Error(Missing("stream expiry")),
        }
    }
    let existing = match pages.get_page_row(pages.holder_heads(db.holders)[0].roots.streams, key) {
        Some(raw) => Some(failure_result_from_rep(txn.stream_state(raw))?),
        None => None,
    }
    if let Some(state) = existing {
        return admit_existing(mut db, name, key, p, digest, state, at, aged, control, protected)
    }
    if p != 0u64 {
        return Ok(HistoryUnavailable)
    }
    let mut edits = stream_changes(db, name.caller, control)?
    if let Some(floor) = edits.caller.floor {
        if !txn.stream_before(floor.t, floor.n, name.id.t, name.id.n) {
            return Ok(HistoryUnavailable)
        }
    }
    let oldest = reclaim_front(db, mut edits, aged, protected)?
    if edits.caller.count >= db.call_streams.streams_per_caller_max {
        let Some((take victim, id, busy)) = take oldest else {
            return Ok(StreamOverloaded)
        }
        if !txn.stream_before(id.t, id.n, name.id.t, name.id.n) {
            return Ok(HistoryUnavailable)
        }
        if busy {
            return Ok(StreamOverloaded)
        }
        edits.caller.floor = Some(format.StreamIdRep(t: id.t, n: id.n))
        txn.remove_front(mut edits, take victim)
    }
    if edits.control.count >= control.count && edits.control.count >= control.max {
        return Ok(StreamOverloaded)
    }
    edits.caller.count += 1u64
    edits.control.count += 1u64
    admit_commit(mut db, key, 0u64, digest, false, at, Some(take edits))
}

fn stream_changes(db: Db, caller: Caller, control: txn.StreamControl) -> Result[txn.StreamChanges, Error] {
    let mut caller_prefix: Bytes = list.new()
    failure_result_from_rep(types.capacity(caller_key(caller, mut caller_prefix)))?
    let metadata = caller_streams(pages.holder_heads(db.holders)[0].roots.streams, caller_prefix)?
    Ok(txn.StreamChanges(caller_prefix: take caller_prefix, control: control, caller: metadata, deletes: list.new()))
}

// The first two aged idle rows can be reclaimed. The next row is the only
// possible quota victim and can be examined without extending the reclaim.
fn reclaim_front(db: Db, mut edits: txn.StreamChanges, age: Option[u64], protected: scoped[view] fn(StreamKey) -> bool) -> Result[Option[(Bytes, StreamId, bool)], Error] {
    let caller_prefix = failure_result_from_rep(types.copied(edits.caller_prefix))?
    let mut rows = failure_result_from_rep(pages.open_page_range(pages.holder_heads(db.holders)[0].roots.streams, Some(clone(caller_prefix)), false, false, txn.stream_prefix_end(caller_prefix)))?
    for reclaimed in 0u64 .. 3u64 {
        let Some((take key, _)) = failure_result_from_rep(catalog.next_page_range(mut rows))? else {
            break
        }
        let Some(name) = optional_stream_key_from_rep(format.parse_stream_key(key)) else {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        let busy = stream_admit_held(db, key) || protected(name)
        if reclaimed == 2u64 || !txn.stream_at_or_below(name.id.t, age) || busy {
            return Ok(Some((take key, name.id, busy)))
        }
        txn.raise_expiry(mut edits.control, name.id.t)
        txn.remove_front(mut edits, take key)
    }
    Ok(None)
}

pub fn reclaim_streams(mut db: Db, caller: Caller) -> Result[u64, Error] waits {
    if caller.issuer != 1u8 {
        return Error(Foreign)
    }
    journal_poll(mut db)?
    healthy(db)?
    let at = keyed_time(db)
    let mut caller_prefix: Bytes = list.new()
    failure_result_from_rep(types.capacity(caller_key(caller, mut caller_prefix)))?
    let metadata = caller_streams(pages.holder_heads(db.holders)[0].roots.streams, caller_prefix)?
    if metadata.count == 0u64 && metadata.floor == None {
        return Ok(0u64)
    }
    let mut control = stream_control(db)?
    let mut rows = failure_result_from_rep(pages.open_page_range(pages.holder_heads(db.holders)[0].roots.streams, Some(clone(caller_prefix)), false, false, txn.stream_prefix_end(caller_prefix)))?
    let mut deletes: List[Bytes] = list.with_capacity(metadata.count)
    for _ in 0u64 .. metadata.count {
        let Some((take key, _)) = failure_result_from_rep(catalog.next_page_range(mut rows))? else {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        if stream_admit_held(db, key) {
            return Error(Held)
        }
        list.push(mut deletes, take key)
    }
    let _ = take rows
    control.count -= metadata.count
    let no_reply: Option[fn(Error) -> bool] = None
    let settled = store_body_at(mut db, 0u64, at, None, no_reply, scoped fn(mut tx: Tx) -> Result[(), Error] {
        for key in deletes {
            failure_result_from_rep(txn.stream_edit(mut tx.inner, failure_result_from_rep(types.copied(key))?, None, 0u64))?
        }
        failure_result_from_rep(txn.stream_edit(mut tx.inner, failure_result_from_rep(types.copied(caller_prefix))?, None, 0u64))?
        failure_result_from_rep(txn.write_stream_control(mut tx.inner, control))
    })?
    match take settled {
        Committed(_) => Ok(metadata.count),
        Refused(c) => Error(Full(c)),
        Aborted(Undone(value: take e, ..)) => Error(take e),
        _ => Error(Missing("anonymous streams")),
    }
}

pub opaque type AnonymousCursor {
    key: Bytes
}

pub fn anonymous_cursor() -> AnonymousCursor {
    AnonymousCursor(key: clone(b"\x01"))
}

pub fn reclaim_startup_streams(mut db: Db, cursor: AnonymousCursor, current: scoped[view] fn(Caller) -> bool) -> Result[Option[AnonymousCursor], Error] waits {
    let mut next_key = failure_result_from_rep(types.copied(cursor.key))?
    for _ in 0u64 .. 8u64 {
        let caller = {
            let mut rows = failure_result_from_rep(pages.open_page_range(pages.holder_heads(db.holders)[0].roots.streams, Some(clone(next_key)), true, false, Some(clone(b"\x02"))))?
            let Some((take key, _)) = failure_result_from_rep(catalog.next_page_range(mut rows))? else {
                return Ok(None)
            }
            if list.len(key) < 2u64 {
                return Error(failure_from_rep(pages.malformed(0)))
            }
            let end = 2u64 + int.widen(key[1u64])
            if end > list.len(key) {
                return Error(failure_from_rep(pages.malformed(0)))
            }
            let caller_key_bytes = list.slice(key, 0u64, end)
            let Some(take after) = txn.stream_prefix_end(caller_key_bytes) else {
                return Error(failure_from_rep(pages.malformed(0)))
            }
            next_key = take after
            Caller(issuer: 1u8, subject: failure_result_from_rep(types.copied(list.slice(key, 2u64, end)))?)
        }
        if !current(caller) {
            let _ = reclaim_streams(mut db, caller)?
            break
        }
    }
    Ok(Some(AnonymousCursor(key: take next_key)))
}

pub fn sweep_streams(mut db: Db, protected: scoped[view] fn(StreamKey) -> bool) -> Result[(), Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let at = keyed_time(db)
    let age = txn.age_floor(at, db.call_streams.stream_retention_ms)
    let mut control = stream_control(db)?
    let (take start, inclusive): (Option[Bytes], bool) = match db.call_streams.stream_sweep_after {
        Some(cursor) => (Some(clone(cursor.key)), cursor.inclusive),
        None => (None, false),
    }
    let mut rows = failure_result_from_rep(pages.open_page_range(pages.holder_heads(db.holders)[0].roots.streams, start, inclusive, false, None))?
    let mut after: Option[txn.StreamSweepCursor] = None
    let mut edits: List[txn.StreamSweepEdit] = list.new()
    let mut deletes: List[Bytes] = list.new()
    for _ in 0u64 .. 8u64 {
        let Some((take key, _)) = failure_result_from_rep(catalog.next_page_range(mut rows))? else {
            after = None;
            break
        }
        if list.len(key) == 0u64 {
            continue
        }
        if list.len(key) < 2u64 {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        let caller_end = 2u64 + int.widen(key[1u64])
        if caller_end > list.len(key) {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        let caller_prefix = failure_result_from_rep(types.copied(list.slice(key, 0u64, caller_end)))?
        after = Some(txn.StreamSweepCursor(key: clone(key), inclusive: false))
        if key[0u64] == 1u8 {
            let Some(take next_caller) = txn.stream_prefix_end(caller_prefix) else {
                break
            }
            rows = failure_result_from_rep(pages.open_page_range(pages.holder_heads(db.holders)[0].roots.streams, Some(clone(next_caller)), true, false, None))?
            after = Some(txn.StreamSweepCursor(key: take next_caller, inclusive: true))
            continue
        }
        if list.len(key) == caller_end {
            let metadata = caller_streams(pages.holder_heads(db.holders)[0].roots.streams, key)?
            let old_floor = match metadata.floor {
                Some(id) => txn.stream_at_or_below(id.t, age),
                None => true
            }
            if metadata.count == 0u64 && old_floor {
                if let Some(id) = metadata.floor {
                    txn.raise_expiry(mut control, id.t)
                }
                list.push(mut edits, txn.StreamSweepEdit(caller_prefix: take caller_prefix, metadata: None))
            }
            continue
        }
        let Some(name) = optional_stream_key_from_rep(format.parse_stream_key(key)) else {
            return Error(failure_from_rep(pages.malformed(0)))
        }
        if !txn.stream_at_or_below(name.id.t, age) || stream_admit_held(db, key) || protected(name) {
            let Some(take next_caller) = txn.stream_prefix_end(caller_prefix) else {
                break
            }
            rows = failure_result_from_rep(pages.open_page_range(pages.holder_heads(db.holders)[0].roots.streams, Some(clone(next_caller)), true, false, None))?
            after = Some(txn.StreamSweepCursor(key: take next_caller, inclusive: true))
            continue
        }
        control.count -= 1u64
        txn.raise_expiry(mut control, name.id.t)
        list.push(mut deletes, take key)
        let slot = list.len(edits)
        let mut metadata = if slot > 0u64 && edits[slot - 1u64].caller_prefix == caller_prefix {
            let latest_edit = option.unwrap(list.pop(mut edits))
            option.unwrap(latest_edit.metadata)
        } else {
            caller_streams(pages.holder_heads(db.holders)[0].roots.streams, caller_prefix)?
        }
        metadata.count -= 1u64
        list.push(mut edits, txn.StreamSweepEdit(caller_prefix: take caller_prefix, metadata: Some(metadata)))
    }
    let _ = take rows
    if list.len(edits) == 0u64 {
        db.call_streams.stream_sweep_after = take after
        return Ok(())
    }
    let no_reply: Option[fn(Error) -> bool] = None
    let settled = store_body_at(mut db, 0u64, at, None, no_reply, scoped fn(mut tx: Tx) -> Result[(), Error] {
        for key in deletes {
            failure_result_from_rep(txn.stream_edit(mut tx.inner, failure_result_from_rep(types.copied(key))?, None, 0u64))?
        }
        for edit in edits {
            let key = failure_result_from_rep(types.copied(edit.caller_prefix))?
            match edit.metadata {
                Some(metadata) => failure_result_from_rep(txn.write_caller_streams(mut tx.inner, take key, metadata))?,
                None => failure_result_from_rep(txn.stream_edit(mut tx.inner, take key, None, 0u64))?,
            }
        }
        failure_result_from_rep(txn.write_stream_control(mut tx.inner, control))
    })?
    match take settled {
        Committed(_) => {
            db.call_streams.stream_sweep_after = take after;
            Ok(())
        },
        Refused(c) => Error(Full(c)),
        Aborted(Undone(value: take e, ..)) => Error(take e),
        _ => Error(Missing("stream sweep")),
    }
}

pub opaque type Completion {
    admitted: Ticket,
    stream: Bytes,
    p: u64,
    request: RequestDigest,
    keyed: Option[KeyedRun]
}

pub fn ticket(c: Completion) -> Ticket {
    c.admitted
}

pub type Admission = Admitted(Completion) | Duplicate(Stored) | Rejected(u64) | Abandoned(Completion) | RequestMismatch | HistoryUnavailable | StreamFuture(u64) | StreamOverloaded

fn stream_admit_held(db: Db, key: Bytes) -> bool {
    match map.get(db.call_streams.admits, key) {
        Some(active) => active.held,
        None => false
    }
}

pub fn release_stream_admit(mut db: Db, name: StreamKey, p: u64) -> Result[(), Error] {
    let key = failure_result_from_rep(types.capacity(stream_key_bytes(name)))?
    if let Some(take prior) = map.remove(mut db.call_streams.admits, key) {
        let mut active = take prior
        if active.p == p {
            active.held = false
        }
        map.insert(mut db.call_streams.admits, take key, take active)
    }
    Ok(())
}

pub fn admit(mut db: Db, stream: StreamKey, p: u64, d: RequestDigest) -> Result[Admission, Error] waits {
    admit_while(mut db, stream, p, d, fn(_name: StreamKey) -> bool {
        false
    })
}

pub fn admit_while(mut db: Db, stream: StreamKey, p: u64, d: RequestDigest, protected: scoped[view] fn(StreamKey) -> bool) -> Result[Admission, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let at = keyed_time(db)
    let key = failure_result_from_rep(types.capacity(stream_key_bytes(stream)))?
    admit_stream(mut db, stream, key, p, d, at, protected)
}

fn admit_existing(mut db: Db, name: StreamKey, stream: Bytes, p: u64, d: RequestDigest, state: txn.StreamState, at: u64, age: Option[u64], control: txn.StreamControl, protected: scoped[view] fn(StreamKey) -> bool) -> Result[Admission, Error] waits {
    let latest = state.p
    if p < latest {
        // AH2: one state per stream keeps no digest below latest.
        return Ok(HistoryUnavailable)
    }
    if p > latest {
        // S7: latest + 1 only after latest has its reply.
        return if p == latest + 1 && state.state == 2 {
            admit_next(mut db, name.caller, stream, p, d, false, at, age, control, protected)
        } else {
            Ok(Rejected(latest))
        }
    }
    // AH1: at latest the digest is compared before any other answer.
    if RequestDigest(b: state.digest) != d {
        return Ok(RequestMismatch)
    }
    if state.state == 2 {
        let r = match pages.get_page_row(pages.holder_heads(db.holders)[0].roots.streams, stream) {
            Some(raw) => stored_reply(raw)?,
            None => return Error(failure_from_rep(pages.malformed(0)))
        }
        return Ok(Duplicate(take r))
    }
    let mine = match map.get(db.call_streams.admits, stream) {
        Some(a) => if a.p == p {
            a.ticket
        } else {
            None
        },
        None => None
    }
    if let Some(t) = mine {
        let active = txn.OpenAdmit(p: p, ticket: Some(t), held: true)
        map.insert(mut db.call_streams.admits, failure_result_from_rep(types.copied(stream))?, active)
        return Ok(Abandoned(Completion(admitted: t, stream: failure_result_from_rep(types.copied(stream))?, p: p, request: d, keyed: None)))
    }
    // An earlier open's admit: re-commit, keeping the digest bound at p.
    admit_next(mut db, name.caller, stream, p, d, true, at, age, control, protected)
}

fn admit_next(mut db: Db, caller: Caller, key: Bytes, p: u64, digest: RequestDigest, abandoned: bool, at: u64, age: Option[u64], control: txn.StreamControl, protected: scoped[view] fn(StreamKey) -> bool) -> Result[Admission, Error] waits {
    let mut edits = stream_changes(db, caller, control)?
    let _ = reclaim_front(db, mut edits, age, protected)?
    let stream_edits: Option[txn.StreamChanges] = if list.len(edits.deletes) == 0u64 {
        None
    } else {
        Some(take edits)
    }
    admit_commit(mut db, key, p, digest, abandoned, at, take stream_edits)
}

fn admit_commit(mut db: Db, stream: Bytes, p: u64, d: RequestDigest, abandoned: bool, at: u64, take edits: Option[txn.StreamChanges]) -> Result[Admission, Error] waits {
    let held_stream = failure_result_from_rep(types.copied(stream))?
    let key = failure_result_from_rep(types.copied(stream))?
    // §1.8: a later admit of p in this open commits nothing, so the entry that
    // remembers this one is reserved before the commit. Without room the admit
    // is Full and commits nothing; the map is kept as it was.
    if !map.contains(db.call_streams.admits, key) {
        failure_result_from_rep(types.capacity(map.try_reserve(mut db.call_streams.admits, 1)))?
    }
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, main_branch(db))?
    let keep: Option[fn(Error) -> bool] = None
    let outcome = store_body_at(mut db, i, at, None, keep, scoped fn(mut tx: Tx) -> Result[(), Error] {
        if let Some(stream_delta) = edits {
            failure_result_from_rep(txn.write_stream_changes(mut tx.inner, stream_delta))?
        }
        let value = failure_result_from_rep(txn.stream_bytes(p, d.b, false, list.new()))?
        failure_result_from_rep(txn.stream_write(mut tx.inner, failure_result_from_rep(types.copied(stream))?, take value, 0))
    })?
    let admitted = match take outcome {
        Committed(done) => done.ticket,
        // Ruling 3: an admit over resident_limit is Full.
        Refused(c) => return Error(Full(c)),
        Aborted(Undone(value: take e, ticket: _)) => return Error(take e),
        // The body is the store's own, runs unbounded and does not fault.
        Failed(_) => return Error(Missing("admit")),
        Stopped(_) => return Error(Missing("admit"))
    }
    map.insert(mut db.call_streams.admits, take key, txn.OpenAdmit(p: p, ticket: Some(admitted), held: true))
    let completion = Completion(admitted: admitted, stream: take held_stream, p: p, request: d, keyed: None)
    Ok(if abandoned {
        Abandoned(take completion)
    } else {
        Admitted(take completion)
    })
}

fn stored_reply(raw: Bytes) -> Result[Stored, Error] {
    Ok(Stored(reply: failure_result_from_rep(txn.stored_reply(raw))?))
}

fn caller_streams(tree: pages.PageTree, caller_prefix: Bytes) -> Result[txn.CallerStreams, Error] {
    failure_result_from_rep(txn.caller_streams(tree, caller_prefix))
}

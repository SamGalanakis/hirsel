// The drivers that run one call's or one read's attempts (§13.3): each
// attempt runs the body over the pin map the driver holds, and a latched
// miss is delivered into that map before the body runs again.
// Abort and rerun (§13.3): each attempt runs the body at the head with a
// fresh attempt record over the call's pin map. A latched miss is delivered
// into the map and the body reruns; any other latch decides the call.
fn staged_until_decided[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], force_frame: bool, body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Stage[R, A], Error] waits {
    let mut pins = pager.empty_tiered_pins(call_pin_root(db, i), pager.pin_partition(db.pager))
    let mut pending: Option[(format.TieredTarget, types.Failure)] = None
    loop {
        txn.refresh_call_pins(mut pins, mut pending, call_pin_root(db, i))
        let attempt = pager.call_attempt(call_captures_tiered(db, i), pager.pin_partition(db.pager), pager.tiered_window(pins))
        let staged = stage_with(mut db, i, wall, steps, keep_reply, force_frame, attempt, pins.frames, body)
        let Some(state) = pager.call_attempt_finish(take attempt) else {
            return Ok(take staged)
        }
        match state.stopped {
            None => return Ok(take staged),
            Some(AttemptPinLimit(problem)) => return Ok(Over(Refused(Cache(problem)))),
            Some(AttemptAllocation(problem)) => return Ok(Over(Refused(Allocation(problem)))),
            // A write into a replay overlay waits for the fold cut, then reruns
            // at the head it publishes (§13.3). A corrupt fold is the store
            // error path; a refused one refuses the call with its cause.
            Some(AttemptFold(_)) => match cut_install(mut db, NoHolderChange) {
                Ok(_) => (),
                Error(Full(problem)) => return Ok(Over(Refused(problem))),
                Error(take problem) => return Error(take problem),
            },
            Some(AttemptMiss(_)) => {
                // An inline call is held from its first miss (§13.3a "Inline calls").
                revoke_parked(mut db)
                deliver_call_miss(db, pages.holder_heads(db.holders)[i].roots.collections, pages.holder_bases(db.holders), state, mut pins, mut pending)?
            },
        }
    }
}

// §13.3 "The captured read roots": a call at head i reads that head and the
// tail bases its branch's projector pins carry.
fn call_pin_root(db: Db, i: u64) -> pager.TieredPinRoot {
    capture_pin_root(open_number(db), pages.holder_heads(db.holders)[i].id, pages.holder_heads(db.holders)[i].roots.collections, pages.holder_bases(db.holders))
}

fn call_captures_tiered(db: Db, i: u64) -> bool {
    captured_tiered(pages.holder_heads(db.holders)[i].roots.collections, pages.holder_bases(db.holders), pages.holder_heads(db.holders)[i].id)
}

// Whether a capture is retry-capable (§13.3 "Retry-capable calls are
// bounded"): its primary or a tail base of its branch holds a Tiered
// collection. Decided before the body runs, from the capture alone.
fn captured_tiered(primary: pages.PageTree, bases: pages.TailBases, branch_id: u32) -> bool {
    if pages.tiered_collections(primary.root) {
        return true
    }
    let Some(held) = view bases else {
        return false
    }
    for k in 0u64 .. list.len(held) {
        if held[k].branch == branch_id && pages.tiered_collections(held[k].roots.collections.root) {
            return true
        }
    }
    false
}

// A capture's identity (§13.3 "A capture change starts an empty map"): its
// primary and each tail base of its branch, with their generations.
fn capture_pin_root(opened: u64, branch_id: u32, primary: pages.PageTree, bases: pages.TailBases) -> pager.TieredPinRoot {
    let mut root = txn.tiered_pin_root(opened, branch_id, primary)
    if let Some(held) = view bases {
        for k in 0u64 .. list.len(held) {
            if held[k].branch == branch_id {
                let tree = view held[k].roots.collections
                list.push(mut root.tails, pager.TieredTailRoot(version: held[k].version, generation: txn.tree_generation(tree), root_stamp: pages.tree_stamp(tree)))
            }
        }
    }
    root
}

// The inventory a latched miss resolves through (§13.3 "A miss names its
// source tree"): the primary's, or that of the tail base the miss named.
fn capture_page_source(requests: Option[View[Sender[pager.TieredPagerMessage]]], primary: pages.PageTree, bases: pages.TailBases, source: u64) -> Result[pager.TieredPageSource, Error] {
    if source == 0 {
        return failure_result_from_rep(pager.tx_page_source(requests, primary))
    }
    let Some(held) = view bases else {
        fail("store: a miss names a tail base its capture does not carry")
    }
    if source > list.len(held) {
        fail("store: a miss names a tail base its capture does not carry")
    }
    failure_result_from_rep(pager.tx_page_source(requests, held[source - 1].roots.collections))
}

fn deliver_call_miss(db: Db, primary: pages.PageTree, bases: pages.TailBases, state: pager.TieredTouchSet, mut pins: pager.TieredPins, mut pending: Option[(format.TieredTarget, types.Failure)]) -> Result[(), Error] waits {
    let SeekKey(sought) = view state.seek else {
        fail("store: a call's miss has no seek key")
    }
    let requests: Option[View[Sender[pager.TieredPagerMessage]]] = match pager.pager_requests(db.pager) {
        Some(pager) => Some(view pager),
        None => None,
    }
    let source = capture_page_source(requests, primary, bases, state.miss_source)?
    failure_result_from_rep(object_writer.serve_tiered_miss(source, clone(pins.root), state, sought, TieredPoint, None, mut pins, mut pending))
}

// One serve attempt over the pin map `drive_served` holds. A latched
// attempt's stage is discarded by the driver, so it is not read here.
fn draft_call(db: Db, complete: Completion, ci: CallInfo, plan: Plan, rec: Option[CallRecord], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> DraftedCall {
    let caught = isolate(fn() -> Result[Result[CallDraft, Capacity], OutOfTime] {
        let perform = scoped fn() -> Result[CallDraft, Capacity] {
            let keep: Option[fn(ServeReply) -> bool] = None
            let draft = bound bytes plan.n_e {
                let reads: core.Log[Read] = log.new()
                let issued: core.Cell[u64] = cell.new(0)
                let staged = draft_body(db, indexes.index_registry(db.indexes), pages.holder_heads(db.holders)[0].roots, ci, keep, reads, issued, attempt, pins, scoped fn(mut tx: Tx) -> Result[Bytes, ServeReply] {
                    stage_reply(mut tx, complete, rec, plan.reply_max, keyed_completion_credit(db, complete), body)
                })
                let finished = match prepare_writer_pages(db, pages.holder_heads(db.holders)[0].roots, issued, attempt, pins, take staged) {
                    Ok(take ready) => take ready,
                    Error(Full(problem)) => RolledBack(Refused(problem)),
                    Error(take problem) => DraftFault(take problem),
                }
                CallDraft(finished: take finished, reads: take reads, issued: take issued)
            }
            let CallDraft(finished: take result, reads: take reads, issued: take issued) = (take draft)?
            // Encoding spends the call's steps and the head's frame bytes.
            let framed = match frame_draft(db, pages.holder_heads(db.holders)[0].roots.collections, ci, rec, None, false, take result) {
                Ok(take finished) => take finished,
                Error(problem) => RolledBack(Aborted(Undone(value: StoreFailure(Full(Allocation(problem))), ticket: None))),
            }
            Ok(CallDraft(finished: take framed, reads: take reads, issued: take issued))
        }
        bound steps plan.s_e {
            perform()
        }
    })
    let mut next_id = pages.holder_next_node(db.holders)
    let staged: Stage[Bytes, ServeReply] = match take caught {
        Error(problem) => Over(Refused(Allocation(problem))),
        Ok(Error(take causes)) => match manifest.raised_capacity(causes) {
            Some(problem) => Over(Refused(Allocation(problem))),
            None => Over(Failed(Raised(take causes))),
        },
        Ok(Ok(Error(limit))) => Over(Stopped(limit)),
        Ok(Ok(Ok(Error(problem)))) => Over(Refused(Allocation(problem))),
        Ok(Ok(Ok(Ok(take draft)))) => {
            let CallDraft(finished: take result, reads: take reads, issued: take issued) = take draft
            let high = cell.into_inner(take issued)
            if high > next_id {
                next_id = high
            }
            txn.finish_stage(CallInfo(id: ci.id, at: ci.at, seed: ci.seed), take result, log.finish(take reads))
        },
    }
    // A fault or step stop drops the private roots, so none of their IDs escape.
    DraftedCall(stage: take staged, next_id: next_id)
}

type CallDraft {
    finished: Finished[Bytes, ServeReply],
    reads: core.Log[Read],
    issued: core.Cell[u64]
}

type DraftedCall {
    stage: Stage[Bytes, ServeReply],
    next_id: u64
}

type DraftRefusal = AdmissionBytes(Capacity) | DraftStopped(Stop)

fn metered_draft(db: Db, complete: Completion, ci: CallInfo, plan: Plan, grant: CallReserve, rec: Option[CallRecord], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[DraftedCall, DraftRefusal] {
    // These synchronous scopes cannot lose task room between admission and use.
    // Refund the admission before encoding, so frame bytes come from the head.
    let admitted = bound bytes grant.retained {
        ()
    }
    if let Error(problem) = admitted {
        return Error(AdmissionBytes(problem))
    }
    let metered = bound steps grant.steps {
        draft_call(db, complete, ci, plan, rec, attempt, pins, body)
    }
    match take metered {
        Error(limit) => Error(DraftStopped(OutOfSteps(limit.steps))),
        Ok(take drafted) => Ok(take drafted),
    }
}

fn stopped_pending(take pending_run: Pending, take stop: Stop) -> Served {
    let mut pending = take pending_run
    pending.stop = Some(stop_kind(stop))
    Failed(take pending, take stop)
}

pub fn look[E: inert, R](r: Reader, s: Snapshot, steps: Option[u64], env: E, body: fn(Tx, E) -> R) -> Result[Looked[R], Error] waits {
    read_access(r, s)?
    let tiered = captured_tiered(s.roots.collections, s.bases, s.branch)
    if let None = steps {
        if tiered {
            return Error(Missing("steps"))
        }
    }
    let partition = match read.reader_grant(r.inner) {
        Some(grant) => grant.pin_bytes,
        None => 0,
    }
    let root = capture_pin_root(s.open, s.branch, s.roots.collections, s.bases)
    let mut pins = pager.empty_tiered_pins(root, partition)
    let mut pending: Option[(format.TieredTarget, types.Failure)] = None
    loop {
        let attempt = pager.call_attempt(tiered, partition, pager.tiered_window(pins))
        let looked = look_attempt(s, steps, env, body, attempt, pins.frames)
        let Some(state) = pager.call_attempt_finish(take attempt) else {
            return Ok(take looked)
        }
        match state.stopped {
            None => return Ok(take looked),
            Some(AttemptPinLimit(problem)) => return Ok(Refused(Cache(problem), list.new())),
            Some(AttemptAllocation(problem)) => return Ok(Refused(Allocation(problem), list.new())),
            Some(AttemptFold(_)) => fail("store: a read attempt cannot wait for a fold"),
            Some(AttemptMiss(_)) => {
                let SeekKey(sought) = view state.seek else {
                    fail("store: a look's miss has no seek key")
                }
                let Some(grant) = read.reader_grant(r.inner) else {
                    return Error(Io(Closed))
                }
                let pager_link = read.reader_requests(r.inner)
                let source = capture_page_source(pager_link, s.roots.collections, s.bases, state.miss_source)?
                failure_result_from_rep(object_writer.serve_tiered_miss(source, clone(pins.root), state, sought, TieredPoint, Some(arc.share(grant)), mut pins, mut pending))?
            },
        }
    }
}

fn look_attempt[E: inert, R](s: Snapshot, steps: Option[u64], env: E, body: fn(Tx, E) -> R, attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Looked[R] {
    let reads: core.Log[Read] = log.new()
    let issued: core.Cell[u64] = cell.new(0)
    let observed_info: core.Cell[bool] = cell.new(false)
    let caught = isolate(fn() -> Result[R, OutOfTime] {
        let perform = scoped fn() -> R {
            let registry = indexes.empty_index_registry()
            let scope = txn.TxViews(base: view s.roots, indexes: view registry, reads: view reads, issued: view issued, observed_info: view observed_info, attempt: view attempt, pins: view pins)
            let start = txn.TxStart(store: types.StoreKey(hi: s.store.hi, lo: s.store.lo), ids: 0, resident: 0, retain_old: false, journaled: false, limits: types.default_limits())
            let tx = Tx(inner: txn.begin_tx(scope, s.bases, start, false), info: CallInfo(id: CallId(store: s.store, branch: s.branch, version: s.head), at: 0, seed: 0))
            body(tx, env)
        }
        match steps {
            Some(n) => bound steps n {
                perform()
            },
            None => Ok(perform()),
        }
    })
    let _ = cell.into_inner(take observed_info)
    let _ = cell.into_inner(take issued)
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Refused(Allocation(c), take seen),
        Ok(Error(take cs)) => match manifest.raised_capacity(cs) {
            Some(c) => Refused(Allocation(c), take seen),
            None => Failed(take cs, take seen),
        },
        Ok(Ok(Error(e))) => Stopped(e, take seen),
        Ok(Ok(Ok(take value))) => Seen(Seen(value: take value, version: s.head, reads: take seen))
    }
}

fn tx_start(db: Db) -> txn.TxStart {
    txn.TxStart(store: types.StoreKey(hi: db.store.hi, lo: db.store.lo), ids: pages.holder_next_node(db.holders), resident: db.accounting.resident, retain_old: retaining(db), journaled: if let Some(_) = db.disk {
        true
    } else {
        false
    }, limits: types.LimitsRep(frame: db.limits.frame, value: db.limits.value, meta: db.limits.meta))
}

fn draft_body[R, A](db: Db, registry: indexes.IndexRegistry, base: pages.Roots, ci: CallInfo, keep_reply: Option[fn(A) -> bool], reads: core.Log[Read], issued: core.Cell[u64], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Finished[R, A] {
    draft_at(tx_start(db), pages.holder_bases(db.holders), db.accounting.tiered, registry, base, ci, keep_reply, reads, issued, attempt, pins, body)
}

fn draft_at[R, A](start: txn.TxStart, bases: pages.TailBases, tiered_bytes: u64, registry: indexes.IndexRegistry, base: pages.Roots, ci: CallInfo, keep_reply: Option[fn(A) -> bool], reads: core.Log[Read], issued: core.Cell[u64], attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Finished[R, A] {
    let observed_info: core.Cell[bool] = cell.new(false)
    let scope = txn.TxViews(base: view base, indexes: view registry, reads: view reads, issued: view issued, observed_info: view observed_info, attempt: view attempt, pins: view pins)
    let mut tx = Tx(inner: txn.begin_tx(scope, bases, start, true), info: ci)
    let outcome = body(mut tx)
    let Tx(inner: take state, ..) = take tx
    match txn.finish_body(take state, take outcome, keep_reply, base, start.resident, tiered_bytes, if let Some(_) = attempt {
        true
    } else {
        false
    }, observed_info) {
        BodyPrepared(take prepared) => Prepared(take prepared),
        OutOfRoom(problem) => RolledBack(Refused(capacity_from_rep(problem))),
        BodyAborted(take value) => RolledBack(Aborted(Undone(value: take value, ticket: None))),
        DuplicateIndex(take name) => RolledBack(Failed(Conflict(take name))),
        BodyDrifted(take name, take evidence) => Drifted(take name, take evidence),
    }
}

// Protocol codec laws. std_native.py runs this second corpus root in store@1.
fn raw(s: String) -> Bytes {
    let input = string.as_bytes(s)
    let mut out: Bytes = list.new()
    for i in 0u64 .. list.len(input) / 2 {
        result.unwrap(list.push(mut out, digit(input[i * 2]) * 16 + digit(input[i * 2 + 1])))
    }
    take out
}

fn digit(x: u8) -> u8 {
    if x >= 97 {
        x - 87
    } else {
        x - 48
    }
}

fn singleton[T](take x: T) -> List[T] {
    let mut xs: List[T] = list.new()
    result.unwrap(list.push(mut xs, take x))
    take xs
}

fn encoded(f: runner.Frame) -> Bytes {
    let c: std.codec.Codec[runner.Frame] = std.codec.of()
    let mut out: Bytes = list.new()
    result.unwrap(std.codec.encode(c, f, mut out))
    take out
}

pub fn ts_frame_schema(out: Stdout) -> Result[(), Exit] waits {
    let c: std.codec.Codec[runner.Frame] = std.codec.of()
    let schema = result.unwrap(std.codec.schema(c))
    match stdout.write_bytes(out, schema) {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 1))
    }
}

// expect: run ts_frame_vectors() = true
pub fn ts_frame_vectors() -> bool {
    if encoded(Ended(3u32, Abandoned)) != raw("070000000300000003000000") || encoded(Ended(3u32, InDoubt)) != raw("070000000300000004000000") || encoded(Ended(3u32, Refused(RequestMismatch))) != raw("07000000030000000200000006000000") || encoded(Ended(3u32, Refused(HistoryUnavailable))) != raw("07000000030000000200000007000000") {
        return false
    }
    encoded(Hello(None, list.new())) == raw("000000000000000000000000") && encoded(Call(7u32, 9007199254740993u64, 2u32, 3u32, raw("ff"))) == raw("01000000070000000100000000002000020000000300000001000000ff") && encoded(Batch(2u64, list.new(), list.new(), list.new())) == raw("060000000200000000000000000000000000000000000000") && encoded(Batch(2u64, singleton(7u32), list.new(), list.new())) == raw("06000000020000000000000001000000070000000000000000000000") && encoded(Welcome(store.Caller(issuer: 2u8, subject: raw("aa")), 2u32, 3u64, list.new(), "t", 4u64)) == raw("040000000201000000aa0200000003000000000000000000000001000000740400000000000000")
}

fn ts_frame_bytes() -> String {
    ""
}

fn sample(i: u64, state: u64) -> runner.Frame {
    let p = (state << 32) | i
    let id: u32 = int.truncate(i)
    match i % 9 {
        0 => Hello(if i % 2 == 0 {
            None
        } else {
            Some(raw("0102"))
        }, singleton(runner.Want(identity: raw("03"), args_fp: state, result_fp: p))),
        1 => Call(id, p, int.truncate(state % 4), 123u32, singleton(int.truncate(state))),
        2 => Subscribe(id, 2u32, raw("07"), if i % 2 == 0 {
            None
        } else {
            Some(raw("08"))
        }),
        3 => Unsubscribe(id),
        4 => Welcome(store.Caller(issuer: 2u8, subject: raw("0102")), 4u32, state, raw("03"), "t", 16777216u64),
        5 => {
            let entry: runner.Entry = match state % 3 {
                0 => Ready(id),
                1 => Resolve(id, raw("09")),
                _ => Gone
            }
            Placed(take entry)
        }
        6 => {
            let complete: List[u32] = if state % 2 == 0 {
                singleton(id)
            } else {
                list.new()
            }
            let r = runner.Row(sub: 1u32, key: raw("01"), value: Some(raw("03")))
            let d = runner.Done(stream: id, p: p, outcome: Returned(raw("04")))
            Batch(state, take complete, singleton(take r), singleton(take d))
        }
        7 => {
            let outcome: runner.Outcome = if i % 2 == 0 {
                Failed(Raised(int.truncate(state)))
            } else {
                Refused(Deadline)
            }
            Ended(id, take outcome)
        }
        _ => {
            let outcome: runner.Outcome = match state % 4 {
                0 => Abandoned,
                1 => InDoubt,
                2 => Refused(RequestMismatch),
                _ => Refused(HistoryUnavailable)
            }
            Reset(state, singleton(runner.Done(stream: id, p: p, outcome: take outcome)))
        }
    }
}

// expect: run ts_frame_differential() = true
pub fn ts_frame_differential() -> bool {
    let input = raw(ts_frame_bytes())
    let c: std.codec.Codec[runner.Frame] = std.codec.of()
    let mut state = 1066u64
    let mut at = 0u64
    for i in 0u64 .. 10000u64 {
        state = (state * 1664525 + 1013904223) % 4294967296
        let expected = encoded(sample(i, state))
        let start = at
        match std.codec.take_with(input, mut at, c) {
            Ok(take value) => {
                if encoded(value) != expected {
                    return false
                }
            }
            Error(_) => return false
        }
        if at - start != list.len(expected) {
            return false
        }
        for j in 0u64 .. list.len(expected) {
            if input[start + j] != expected[j] {
                return false
            }
        }
    }
    at == list.len(input)
}

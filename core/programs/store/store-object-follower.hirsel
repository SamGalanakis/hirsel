type ObjectAuthorityConfig {
    client: std.object.Client,
    level_name: String,
    op_ms: u64,
    sim: Option[(List[String], LevelSync)],
    // The host stream slot whose writer opens attach (§12.11.1 `streamed`).
    stream: Option[JournalSlot],
    // Read-only stream root from `stream_reader` (§12.11.1, §12.11.9).
    stream_root: Option[String],
    cache: Option[ObjectsCache]
}

pub fn object_authority(take c: std.object.Client, level_name: String, op_ms: u64) -> Authority {
    ObjectAuthority(ObjectAuthorityConfig(client: take c, level_name: string.from(level_name), op_ms, sim: None, stream: None, stream_root: None, cache: None))
}

pub fn sim_authority(take c: std.object.Client, declared: SimLevels, take sync: LevelSync, op_ms: u64) -> Authority {
    SimAuthority(ObjectAuthorityConfig(client: take c, level_name: string.from(declared.strongest), op_ms, sim: Some((clone(declared.weak), take sync)), stream: None, stream_root: None, cache: None))
}

type ObjectFollowHead: shareable + send {
    current: HistoryHead,
    tag: std.object.ETag,
    next_node: u64,
    attach: Option[format.Attach],
    head_bytes: Bytes,
    live_next_seq: u64
}

pub type Claim: codec + key + shareable + cross {
    epoch: u64,
    holder: Bytes
}

pub type ClaimClass: codec + key + shareable + cross = Permit | Continue | Adopt

pub type ClaimAuth: codec + key + shareable + cross {
    expect: Option[Claim],
    attempt: Bytes,
    class: ClaimClass
}

pub type Origin: codec + key + shareable + cross {
    epoch: u64,
    attempt: Bytes,
    class: ClaimClass,
    permit_epoch: u64,
    permit_attempt: Bytes
}

pub type HeadSettlement: codec + key + shareable + cross = HeadOpen | HeadWon(u64) | HeadDead(Claim)

pub type HeadView {
    store: StoreId,
    activation: u64,
    binding: Bytes,
    claim: Claim,
    origin: Option[Origin]
}

fn claim_from_pair(pair: HistoryPair) -> Result[Claim, Error] {
    disk_allocation(scoped fn() -> Result[Claim, Error] {
        let mut owner: Bytes = list.with_capacity(16)
        list.put_word_le(mut owner, pair.holder.hi)
        list.put_word_le(mut owner, pair.holder.lo)
        Ok(Claim(epoch: pair.epoch, holder: take owner))
    })
}

fn claim_class_from_tag(tag: u8) -> ClaimClass {
    match tag {
        0 => Permit,
        1 => Continue,
        _ => Adopt,
    }
}

fn origin_from_history(o: HistoryOrigin) -> Result[Origin, Error] {
    disk_allocation(scoped fn() -> Result[Origin, Error] {
        let mut attempt: Bytes = list.with_capacity(16)
        let _ = bytebuf.append_inline(mut attempt, o.attempt, 0, 16)
        let mut permit_attempt: Bytes = list.with_capacity(16)
        let _ = bytebuf.append_inline(mut permit_attempt, o.permit_attempt, 0, 16)
        Ok(Origin(epoch: o.epoch, attempt: take attempt, class: claim_class_from_tag(o.class), permit_epoch: o.permit_epoch, permit_attempt: take permit_attempt))
    })
}

fn history_head_view(current: HistoryHead) -> Result[HeadView, Error] {
    let claim = claim_from_pair(current.pair)?
    let origin = match current.origin {
        Some(o) => Some(origin_from_history(o)?),
        None => None,
    }
    disk_allocation(scoped fn() -> Result[HeadView, Error] {
        let mut opaque_binding: Bytes = list.with_capacity(32)
        let _ = bytebuf.append_inline(mut opaque_binding, current.binding, 0, 32)
        Ok(HeadView(store: current.store, activation: current.activation, binding: take opaque_binding, claim: clone(claim), origin: clone(origin)))
    })
}

pub fn follower_head(f: Follower) -> Result[HeadView, Error] {
    let Some(record) = f.capture.remote else {
        return Error(Missing("head"))
    }
    history_head_view(record.current)
}

// One-GET read-only head inspection for move/claim settlement (STORE-SPEC
// §12.3): fetches `head` once, verifies namespace and optional expected store,
// and returns its `HeadView` including `ORIGIN`. Performs zero writes and
// never opens a writer or reads tails.
pub fn head_view(mut client: std.object.Client, expect: Option[StoreId], op_ms: u64) -> Result[HeadView, Error] waits {
    let deadline = std.object.deadline_after_ms(client, op_ms)
    let mut scratch = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(HISTORY_HEAD_LIMIT))
    })?
    let outcome = history_fetch(mut client, "head", mut scratch, deadline)
    match take outcome {
        Ok(_) => (),
        Error(Remote(NotFound)) => return Error(NotFound),
        Error(take problem) => return Error(take problem),
    }
    let (take capture, _) = history_decode_head_attach(scratch)?
    check_expected_store(expect, capture.head.store)?
    history_check_namespace(capture, client)?
    history_head_view(capture.head)
}

// Settles an outstanding Fleet `Permit` (STORE-SPEC §12.3 "Settlement")
// from one fresh GET of `store`'s head through the caller's trusted client.
// `predecessor` is the pair the Permit named and `attempt` its unique id.
// Open: the head still names `predecessor`, so the H may yet apply and the
// permit stays outstanding. Won(e): `ORIGIN.permit_attempt` is `attempt` and
// the permit installed exactly `predecessor.epoch + 1`, a receipt that
// survives the winner's later Continue/Adopt claims; it describes a
// historical claim and confers no present writer authority. Dead names the
// current pair. A foreign Store, another namespace, or a head older than or
// beside `predecessor` is an error and closes nothing. Writes nothing.
pub fn settle_permit(mut client: std.object.Client, store: StoreId, predecessor: Claim, attempt: Bytes, op_ms: u64) -> Result[HeadSettlement, Error] waits {
    let observed = head_view(mut client, Some(store), op_ms)?
    history_settle(observed, predecessor, attempt)
}

fn history_settle(head: HeadView, predecessor: Claim, attempt: Bytes) -> Result[HeadSettlement, Error] {
    if head.claim.epoch == predecessor.epoch && head.claim.holder == predecessor.holder {
        return Ok(HeadOpen)
    }
    if head.claim.epoch <= predecessor.epoch {
        return Error(failure_from_rep(format.disk_fault("head", 72, Regressed)))
    }
    if let Some(o) = head.origin {
        if o.permit_epoch == predecessor.epoch + 1 && o.permit_attempt == attempt {
            return Ok(HeadWon(o.permit_epoch))
        }
    }
    Ok(HeadDead(clone(head.claim)))
}

fn copy_follow_state(previous: pages.State) -> Result[pages.State, Error] {
    disk_allocation(scoped fn() -> Result[pages.State, Error] {
        let mut tips: List[pages.Tip] = list.with_capacity(list.len(previous.tips))
        let mut pins: List[pages.Pin] = list.with_capacity(list.len(previous.pins))
        for old_tip in previous.tips {
            list.push(mut tips, pages.Tip(id: old_tip.id, name: string.from(old_tip.name), parent: old_tip.parent, forked_at: old_tip.forked_at, roots: pages.share_roots(old_tip.roots), head: old_tip.head, at: old_tip.at))
        }
        for old_pin in previous.pins {
            list.push(mut pins, failure_result_from_rep(types.capacity(pages.share_pin(old_pin)))?)
        }
        Ok(pages.State(tips: take tips, pins: take pins, next_branch: previous.next_branch, next_table: previous.next_table))
    })
}

fn history_check_follower_path(client: std.object.Client) -> Result[(), Error] {
    disk_allocation(scoped fn() -> Result[(), Error] {
        let place = std.object.bucket_config(client)
        // Even escaped, these fields and a 60-byte Store key fit in the
        // transport's existing 4 KiB request-path buffer.
        let name_width = string.byte_len(place.bucket)
        if name_width < 3 || name_width > 63 || string.byte_len(place.prefix) > 1024 {
            return Error(Limit(Name))
        }
        Ok(())
    })
}

fn object_follow_head(mut source: ObjectPackRead, previous: Option[Arc[FollowCapture]], mut scratch: Bytes) -> Result[Option[(HistoryCapture, std.object.ETag)], Error] waits {
    if let Some(capture) = previous {
        let Some(old) = view capture.remote else {
            fail("object follower missing remote head")
        }
        return history_probe_head(mut source.client, old.tag, mut scratch, source.deadline)
    }
    let outcome = history_fetch(mut source.client, "head", mut scratch, source.deadline)
    let tag = match take outcome {
        Ok(meta) => meta.etag,
        Error(Remote(NotFound)) => return Error(NotFound),
        Error(take problem) => return Error(take problem),
    }
    let latest = history_decode_head(scratch)?
    if latest.head.authority_kind != source.authority_kind {
        return Error(Unsupported(int.widen(latest.head.authority_kind)))
    }
    if source.authority_kind == 1 {
        history_check_endpoint(mut source.client, source.deadline)?
    }
    history_check_namespace(latest, source.client)?
    Ok(Some((take latest, tag)))
}

fn object_follow_replay(mut source: ObjectPackRead, latest: HistoryHead, previous: Option[Arc[FollowCapture]], ceiling: u64) -> Result[JournalReplay, Error] waits {
    if let Some(old_capture) = previous {
        let Some(old) = view old_capture.remote else {
            fail("object follower missing remote head")
        }
        if latest.checkpoint.seq <= old.current.entry.seq {
            let state = copy_follow_state(old_capture.state)?
            let initial = journal_replay(take state, old.next_node, default_limits())?
            failure_result_from_rep(catalog.over_ceiling(journal_account(initial)?, ceiling))?
            return history_rebase_suffix(mut source, latest, old.current.entry, take initial, ceiling)
        }
    }
    history_paged_capture(mut source, latest, ceiling)
}

fn object_follow_capture(mut source: ObjectPackRead, previous: Option[Arc[FollowCapture]], expected: Option[StoreId], ceiling: u64, require_fresh: bool) -> Result[Option[Arc[FollowCapture]], Error] waits {
    if let Some(_) = source.stream_root {
        return stream_follow_capture(mut source, previous, expected, ceiling, require_fresh)
    }
    let mut scratch = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(HISTORY_HEAD_LIMIT))
    })?
    let fetched = object_follow_head(mut source, previous, mut scratch)?
    let Some((take head_capture, tag)) = take fetched else {
        return Ok(None)
    }
    let latest = head_capture.head
    check_expected_store(expected, latest.store)?
    let old_charge = if let Some(old_capture) = previous {
        let Some(old) = view old_capture.remote else {
            fail("object follower missing remote head")
        }
        if latest.floor < old.current.floor || latest.entry.seq < old.current.entry.seq {
            return Error(failure_from_rep(format.disk_fault("head", 72, Order)))
        }
        if history_ref_matches(latest.entry, old.current.entry) {
            return disk_allocation(scoped fn() -> Result[Option[Arc[FollowCapture]], Error] {
                Ok(Some(arc.new(FollowCapture(store: latest.store, state: arc.share(old_capture.state), resident: old_capture.resident, remote: Some(ObjectFollowHead(current: latest, tag, next_node: old.next_node, attach: None, head_bytes: list.new(), live_next_seq: 0)), log_id: 0, watermark: old_capture.watermark))))
            })
        }
        old_capture.resident
    } else {
        0u64
    }
    let recovered = object_follow_replay(mut source, latest, previous, ceiling - old_charge)
    let replay = match take recovered {
        Ok(take ready) => take ready,
        Error(Full(Resident(cap))) => return Error(Full(Resident(Capacity(requested: int.saturating_add(old_charge, cap.requested), available: ceiling)))),
        Error(HistoryMissing(take file, missing_seq)) => {
            let witness = history_witness(mut source.client, latest, None, file, missing_seq, mut scratch, source.deadline)?
            if let HistoryEvicted(newer) = witness {
                return Error(Reclaimed(newer.head.floor))
            }
            if let Some(old_capture) = previous {
                return Error(Behind(Position(store: old_capture.store, branch: 0, version: old_capture.state.tips[0].head)))
            }
            return Error(Remote(Retriable(Deadline)))
        },
        Error(take problem) => return Error(take problem),
    }
    let resident = journal_account(replay)?
    let JournalReplay(state: take built, next_node, ..) = take replay
    let remote = ObjectFollowHead(current: latest, tag, next_node, attach: None, head_bytes: list.new(), live_next_seq: 0)
    Ok(Some(follow_capture(latest.store, take built, resident, Some(remote), 0, failure_result_from_rep(catalog.stamp_after(next_node))?)?))
}

fn object_floor_loaded(mut source: ObjectPackRead, captured: HistoryHead, mark: HistoryMark, raw: Bytes, at_most: u64, ceiling: u64) -> Result[Option[Arc[FollowCapture]], Error] waits {
    let manifest = history_read_manifest(mut source.client, captured.store, mark, captured.checkpoint.seq, source.deadline)?
    if manifest.branches[0u64].version > at_most {
        return Ok(None)
    }
    let (take recovered, _) = history_open_checkpoint(mut source, captured, mark, raw, take manifest, ceiling)?
    let resident = journal_account(recovered)?
    let JournalReplay(state: take state, next_node: stamp, ..) = take recovered
    Ok(Some(follow_capture(captured.store, take state, resident, None, 0, failure_result_from_rep(catalog.stamp_after(stamp))?)?))
}

fn check_floor_missing[T](mut source: ObjectPackRead, captured: HistoryHead, take loaded: Result[T, Error], mut scratch: Bytes) -> Result[T, Error] waits {
    match take loaded {
        Error(HistoryMissing(file, missing)) => {
            let witness = history_witness(mut source.client, captured, None, file, missing, mut scratch, source.deadline)?
            match witness {
                HistoryEvicted(newer) => Error(Reclaimed(newer.head.floor)),
                _ => Error(Remote(Retriable(Deadline))),
            }
        },
        Error(take problem) => Error(take problem),
        Ok(take ready) => Ok(take ready),
    }
}

fn object_follow_floor(mut source: ObjectPackRead, expected: Option[StoreId], ceiling: u64, at_most: u64) -> Result[Option[Arc[FollowCapture]], Error] waits {
    let mut scratch = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(HISTORY_HEAD_LIMIT))
    })?
    let fetched = object_follow_head(mut source, None, mut scratch)?
    let Some((take current, _)) = take fetched else {
        return Error(NotFound)
    }
    let head = current.head
    check_expected_store(expected, head.store)?
    let latest_mark = history_checkpoint(mut source.client, head, source.deadline)
    let (take mark, take raw) = check_floor_missing(mut source, head, take latest_mark, mut scratch)?
    let latest = object_floor_loaded(mut source, head, mark, raw, at_most, ceiling)
    if let Some(take chosen) = check_floor_missing(mut source, head, take latest, mut scratch)? {
        return Ok(Some(take chosen))
    }
    let mut remaining = list.len(mark.retained)
    while remaining > 0 {
        remaining -= 1
        let reference = mark.retained[remaining]
        let mut older = head
        older.checkpoint = reference
        let name = history_read_key("e-", reference)?
        let older_mark = history_read_object(mut source.client, name, reference, source.deadline)
        let earlier_raw = check_floor_missing(mut source, older, take older_mark, mut scratch)?
        let earlier = history_read_mark(name, head.store, reference, earlier_raw)?
        let selected = object_floor_loaded(mut source, older, earlier, earlier_raw, at_most, ceiling)
        if let Some(take chosen) = check_floor_missing(mut source, older, take selected, mut scratch)? {
            return Ok(Some(take chosen))
        }
    }
    Ok(None)
}

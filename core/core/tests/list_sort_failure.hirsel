// Admission of five resource holders is exactly 5*8. Capacity runs no comparator
// and changes no element, length, capacity or source order.
// expect: stdout "okXXXXX"
// expect: run scratch_capacity_atomic(out) = true
fn scratch_capacity_atomic(out: Stdout) -> bool {
    let mut audit = sort_audit(out)
    let mut calls: u64 = 0
    let r = bound bytes 0 {
        list.sort_stable(mut audit.values, fn(a: SortItem, b: SortItem) -> Order {
            calls += 1
            if a.key < b.key {
                Less
            } else if a.key > b.key {
                Greater
            } else {
                Equal
            }
        })
    }
    let refused = match r {
        Ok(Error(c)) => c.requested == 40,
        _ => false
    }
    let mut ids: u64 = 0
    for x in audit.values {
        ids = ids * 10 + x.id
    }
    refused && calls == 0 && ids == 1234
}

// n=7 keys [3,2,1,0,3,2,1], stable ids [3,2,6,1,5,0,4].
// Width1 takes3comparisons, width2 takes3, width4 takes6:12 total.
// Call6 is scratch->xs in the second pair, after the first4elements merged.
resource type SevenAudit {
    out: Stdout,
    values: List[SortItem]
} drop(t) {
    let mut valid = list.len(t.values) == 7 && list.capacity(t.values) == 8
    let mut mask: u64 = 0
    for x in t.values {
        if x.id >= 7 {
            valid = false
        } else {
            let bit = 1u64 << x.id
            if (mask & bit) != 0 {
                valid = false
            }
            mask |= bit
            let key: u64 = if x.id < 4 {
                3 - x.id
            } else {
                7 - x.id
            }
            if x.key != key {
                valid = false
            }
        }
    }
    let _ = stdout.write(t.out, if valid && mask == 127 {
        "ok"
    } else {
        "bad"
    })
}

fn seven_fail_at(out: Stdout, failure: u64) -> u64 {
    let mut xs: List[SortItem] = list.new()
    for i in 0u64 .. 7 {
        let key: u64 = if i < 4 {
            3 - i
        } else {
            7 - i
        }
        result.unwrap(list.push(mut xs, result.unwrap(SortItem(out: out, id: i, key: key))))
    }
    let mut audit = result.unwrap(SevenAudit(out: out, values: take xs))
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut audit.values, fn(a: SortItem, b: SortItem) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a.key < b.key {
            Less
        } else if a.key > b.key {
            Greater
        } else {
            Equal
        }
    }))
    let mut ids: u64 = 0
    for x in audit.values {
        ids = ids * 10 + x.id
    }
    if ids != 3261504 {
        return 99
    }
    calls
}

// Host-free twin of the same seven keys/call sequence. The evaluator checks
// every scratch/source live slot on failure and returns root admission to0.
fn seven_plain_fail_at(failure: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 7 {
        let key: u64 = if i < 4 {
            3 - i
        } else {
            7 - i
        }
        result.unwrap(list.push(mut xs, key))
    }
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a < b {
            Less
        } else if a > b {
            Greater
        } else {
            Equal
        }
    }))
    if xs[0] != 0 || xs[1] != 1 || xs[2] != 1 || xs[3] != 2 || xs[4] != 2 || xs[5] != 3 || xs[6] != 3 {
        return 99
    }
    calls
}

// expect: stdout "okXXXXXXX"
// expect: run seven_complete(out) = 12
fn seven_complete(out: Stdout) -> u64 {
    seven_fail_at(out, 0)
}

// expect: run seven_plain_complete() = 12
fn seven_plain_complete() -> u64 {
    seven_plain_fail_at(0)
}


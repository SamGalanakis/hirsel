// rule: LANG-9
// expect: fail LANG-9 at line 28
// stdout: test log: evaluated=0: no case evaluated the law
// entry: trial
pub fn trial(t: Test) -> Result[(), ()] {
  test.property(
    t,
    fn(mut s: test.Source) -> () {
      ()
    },
    fn(value: ()) -> bool uses {} {
      true
    },
    fn(value: ()) -> String {
      "()"
    }
  )
  test.property(
    t,
    fn(mut s: test.Source) -> String {
      test.ascii_string(mut s, 0)
    },
    fn(value: String) -> bool uses {} {
      value == ""
    },
    test.quoted
  )
  test.property_cases(
    t,
    0,
    fn(mut s: test.Source) -> u64 {
      test.any_u64(mut s)
    },
    fn(value: u64) -> bool uses {} {
      false
    },
    u64.to_string
  )
  Ok(())
}

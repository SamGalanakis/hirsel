type Hits: shareable + send { n: u64 }
type Pair: shareable + send { leaf: Arc[Hits] }
type RcPair: shareable { leaf: Rc[Hits] }
fn captured(mut a: Arc[Hits]) -> Option[u64] {
    arc.with_unique(mut a, scoped fn(mut h: Hits) -> u64 { let b = arc.share(a); h.n })
}
fn reached(mut p: Arc[Pair]) -> Option[()] {
    arc.with_unique(mut p.leaf, scoped fn(mut l: Hits) { l.n = 1 })
}
fn viewed(a: Arc[Hits]) -> Option[()] {
    arc.with_unique(mut a, scoped fn(mut l: Hits) { l.n = 1 })
}
fn stolen(mut a: Arc[Hits]) -> Option[Hits] {
    arc.with_unique(mut a, scoped fn(mut h: Hits) -> Hits { take h })
}
fn escaped(mut a: Arc[Hits]) -> Option[View[Hits]] in a {
    arc.with_unique(mut a, scoped fn(mut h: Hits) -> View[Hits] in h { h })
}
fn rc_captured(mut a: Rc[Hits]) -> Option[u64] {
    rc.with_unique(mut a, scoped fn(mut h: Hits) -> u64 { let b = rc.share(a); h.n })
}
fn rc_reached(mut p: Rc[RcPair]) -> Option[()] {
    rc.with_unique(mut p.leaf, scoped fn(mut l: Hits) { l.n = 1 })
}
fn rc_viewed(a: Rc[Hits]) -> Option[()] {
    rc.with_unique(mut a, scoped fn(mut l: Hits) { l.n = 1 })
}
fn rc_stolen(mut a: Rc[Hits]) -> Option[Hits] {
    rc.with_unique(mut a, scoped fn(mut h: Hits) -> Hits { take h })
}
fn rc_escaped(mut a: Rc[Hits]) -> Option[View[Hits]] in a {
    rc.with_unique(mut a, scoped fn(mut h: Hits) -> View[Hits] in h { h })
}

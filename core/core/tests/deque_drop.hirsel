fn normal_four0(out: Stdout) -> u64 { drop_ring(out, 4, 0, false) }

// expect: stdout "ABCD"
// expect: run failed_four0(out) = fail Unwrap
fn failed_four0(out: Stdout) -> u64 { drop_ring(out, 4, 0, true) }


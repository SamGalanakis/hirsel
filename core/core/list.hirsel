// Module `list` (SEM-4). Bytes is List[u8].
pub fn new[T]() -> List[T]

pub fn with_capacity[T](n: u64) -> List[T]

pub fn len[T](xs: List[T]) -> u64

pub fn capacity[T](xs: List[T]) -> u64

pub fn reserve[T](mut xs: List[T], n: u64)

// Like reserve, returning a refusal as a value instead of raising it (MEM-21).
pub fn try_reserve[T](mut xs: List[T], n: u64) -> Result[(), Capacity]

pub fn get[T](xs: List[T], i: u64) -> Option[View[T]] in xs

pub fn slice[T](xs: List[T], lo: u64, hi: u64) -> View[List[T]] in xs

// Read a little-endian u16, u32 or u64. The expected type fixes the width;
// without one the width is u64. An invalid range, including an overflowing
// end, fails with Bounds. Alloc: nothing.
pub fn word_le[T: integer](b: Bytes, at: u64) -> T

// Like word_le, in big-endian byte order.
pub fn word_be[T: integer](b: Bytes, at: u64) -> T

// The expected type fixes the number of bytes read (SEM-11).
pub fn lanes(b: Bytes, at: u64) -> Simd[u8, 16]

// Appends exactly k lanes. A refusal leaves the buffer unchanged (SEM-11).
pub fn put_lanes(mut b: Bytes, v: Simd[u8, 16], k: u64)

// Overwrites the lanes of v starting at at. Fails with Bounds unless at + len(v) <= len(b).
pub fn set_lanes(mut b: Bytes, at: u64, v: Simd[u8, 16])

// Append the little-endian bytes of a u16, u32 or u64 atomically.
// A refusal leaves the buffer unchanged.
pub fn put_word_le[T: integer](mut b: Bytes, x: T)

// Like put_word_le, in big-endian byte order.
pub fn put_word_be[T: integer](mut b: Bytes, x: T)

// Overwrite the u16, u32 or u64 x at byte offset at, little-endian. A range past
// len (including an overflowing end) fails with Bounds before any write.
pub fn set_word_le[T: integer](mut b: Bytes, at: u64, x: T)

// Like set_word_le, in big-endian byte order.
pub fn set_word_be[T: integer](mut b: Bytes, at: u64, x: T)

// The front expands push in place: a full test, a cold call to grow in its true
// arm (MEM-24 from needed = len + 1), then a store within capacity.
pub fn push[T](mut xs: List[T], take x: T)

// The full arm's growth as a function of its own: reserve is expanded where it
// is called, so only a call keeps it out of the caller.
fn grow[T](mut xs: List[T]) {
    reserve(mut xs, 1)
}

pub fn pop[T](mut xs: List[T]) -> Option[T]

pub fn set[T](mut xs: List[T], i: u64, take x: T) -> T

pub fn swap[T](mut xs: List[T], i: u64, j: u64)

pub fn clear[T](mut xs: List[T])

pub fn fill[T: plain](mut xs: List[T], n: u64, x: T)

// Overwrite count existing elements starting at at with copies of x. A range
// outside dst (including an overflowing end) fails with Bounds before any write.
pub fn fill_slice[T: plain](mut dst: List[T], at: u64, count: u64, x: T)

pub fn append[T: plain](mut xs: List[T], ys: List[T])

// Overwrite src's length of existing elements starting at at. A range outside
// dst (including an overflowing end) fails with Bounds before any write.
pub fn copy_from_slice[T: plain](mut dst: List[T], at: u64, src: List[T])

pub fn sum[T: integer](xs: List[T]) -> T {
    let mut t: T = int.narrow(0u8)
    for x in xs {
        let next: Option[T] = int.checked_add(t, x)
        match next {
            Some(v) => {
                t = v
            },
            None => {
                // Overflow, raised by a conversion that does not fit.
                let wide: u16 = 256
                let _: u8 = int.narrow(wide)
            },
        }
    }
    t
}

// Private uninhabited storage. len is the number of live slots, not a prefix.
// Callers must empty it before free or normalize it before ordinary cleanup.
// Sort aliases keep len0 on scratch; Hole alone tracks and restores its live set.
type Slots[T] {
    raw: List[T]
}

fn slots_empty[T]() -> Slots[T]

fn slots_new[T](n: u64) -> Slots[T]

fn slots_put[T](mut s: Slots[T], i: u64, take x: T)

fn slots_take[T](mut s: Slots[T], i: u64) -> T

fn slots_view[T](s: Slots[T], i: u64) -> View[T] in s

// Distinct mutable carriers. Updates both live counts.
fn slots_move[T](mut src: Slots[T], i: u64, mut dst: Slots[T], j: u64, n: u64)

// Same carrier, including i == j. Keeps its live count.
fn slots_shift[T](mut s: Slots[T], i: u64, j: u64)

fn slots_free[T](take s: Slots[T])

// Discard only a no-drop element ring; preserves evaluator liveness.
fn slots_forget_ring[T](mut s: Slots[T], head: u64)

// Stable sort on the shape of Rust's driftsort (library/core/src/slice/sort/stable/
// drift.rs, quicksort.rs and merge.rs at a7c37f9f): Powersort merge order over logical
// runs. A run shorter than min_good stays unsorted until a stable quicksort with a
// branchless partition sorts it, so random input is one quicksort. Between operations
// every element is in xs. Scratch, indexed like xs, holds elements only inside one
// merge, insertion, small sort or partition, and Hole.active describes which.
pub fn sort_stable[T](mut xs: List[T], before: scoped fn(T, T) -> Order) {
    let n = list.len(xs)
    if n < 2 {
        return
    }
    let scratch: Slots[T] = slots_new(n)
    let mut g = Hole(xs: view xs, scratch: take scratch, active: idle())
    if n <= insertion_len() {
        insertion_sort_hole(mut g, 0, n, before)
    } else {
        drift(mut g, 0, n, n <= 2 * small_len(), before)
    }
    let _ = take g
}

// Whole lists this short are sorted by insertion, as Rust's (stable/mod.rs
// MAX_LEN_ALWAYS_INSERTION_SORT).
fn insertion_len() -> u64 {
    20
}

// Quicksort leaves and eager runs this short go to small_sort. Rust's
// SMALL_SORT_GENERAL_THRESHOLD is 32; 40 was measured faster here (LangArena Sort
// and BWT instructions, 24 to 64 tried).
fn small_len() -> u64 {
    40
}

// Merges logical runs of [lo, hi) in Powersort order (drift.rs `sort`). Eager mode, used
// for short inputs and as quicksort's fallback, sorts each short run at once, which
// bounds the work at O(n log n).
fn drift[T](mut g: Hole[T], lo: u64, hi: u64, eager: bool, before: scoped fn(T, T) -> Order) {
    let size = hi - lo
    // ceil(2^62 / size): scaled run midpoints make a merge node's depth one leading-zero count.
    let scale = ((1u64 << 62) + size - 1) / size
    let min_good = if size <= 4096 {
        let half = size - size / 2
        if half < 64 {
            half
        } else {
            64
        }
    } else {
        sqrt_approx(size)
    }
    // A run is size << 1 | sorted; a stacked run also keeps its merge depth in bits 1..7
    // of the entry (size << 8 | depth << 1 | sorted). Depths strictly increase above the
    // dummy run at 0 and are at most 64, so 66 entries suffice.
    let mut runs: Inline[u64, 66] =[0; 66]
    let mut stack: u64 = 0
    let mut scan = lo
    let mut prev: u64 = 1
    loop {
        let mut next: u64 = 1
        let mut depth: u64 = 0
        if scan < hi {
            next = create_run(mut g, scan, hi, min_good, eager, before)
            let mid = scan - lo
            let x = mid - (prev >> 1) + mid
            let y = mid + mid + (next >> 1)
            depth = int.widen(int.leading_zeros(int.wrapping_mul(scale, x) ^ int.wrapping_mul(scale, y)))
        }
        while stack > 1 && ((runs[stack - 1] >> 1) & 127) >= depth {
            let top = runs[stack - 1]
            let left = ((top >> 8) << 1) | (top & 1)
            let merged = (left >> 1) + (prev >> 1)
            prev = logical_merge(mut g, scan - merged, scan, left, prev, before)
            stack -= 1
        }
        runs[stack] = (prev >> 1) << 8 | depth << 1 | (prev & 1)
        stack += 1
        if scan >= hi {
            break
        }
        scan += next >> 1
        prev = next
    }
    if (prev & 1) == 0 {
        stable_quicksort(mut g, lo, hi, before)
    }
}

// 2^ceil(log2(n) / 2) refined by one Newton step (drift.rs `sqrt_approx`).
fn sqrt_approx(n: u64) -> u64 {
    let log: u64 = int.widen(63 - int.leading_zeros(n | 1))
    let shift = (log + 1) / 2
    ((1u64 << shift) + (n >> shift)) / 2
}

// A natural run of at least min_good is sorted; otherwise eager mode sorts a short
// run now and lazy mode returns an unsorted run of min_good.
fn create_run[T](mut g: Hole[T], lo: u64, hi: u64, min_good: u64, eager: bool, before: scoped fn(T, T) -> Order) -> u64 {
    let size = hi - lo
    if size >= min_good && size >= 2 {
        let (run, descending) = existing_run(g.xs, lo, hi, before)
        if run >= min_good {
            if descending {
                reverse_run(mut g, lo, lo + run)
            }
            return (run << 1) | 1
        }
    }
    if eager {
        let k = if size < small_len() {
            size
        } else {
            small_len()
        }
        small_sort(mut g, lo, lo + k, before)
        return (k << 1) | 1
    }
    let k = if size < min_good {
        size
    } else {
        min_good
    }
    k << 1
}

// Only strictly descending runs are reversed, so equal keys never cross.
fn existing_run[T](xs: View[List[T]], lo: u64, hi: u64, before: scoped fn(T, T) -> Order) -> (u64, bool) {
    let mut end = lo + 2
    let descending = precedes(slots_list_view(xs, lo + 1), slots_list_view(xs, lo), before)
    if descending {
        while end < hi && precedes(slots_list_view(xs, end), slots_list_view(xs, end - 1), before) {
            end += 1
        }
    } else {
        while end < hi && !precedes(slots_list_view(xs, end), slots_list_view(xs, end - 1), before) {
            end += 1
        }
    }
    (end - lo, descending)
}

fn reverse_run[T](mut g: Hole[T], lo: u64, hi: u64) {
    let mut a = lo
    let mut b = hi - 1
    while a < b {
        slots_list_move(g.xs, a, view g.scratch.raw, lo, 1)
        slots_list_move(g.xs, b, g.xs, a, 1)
        slots_list_move(view g.scratch.raw, lo, g.xs, b, 1)
        a += 1
        b -= 1
    }
}

// Two unsorted runs join lazily while they fit in scratch, which here is always.
// Otherwise each unsorted side is quicksorted and the two merge (drift.rs `logical_merge`).
fn logical_merge[T](mut g: Hole[T], lo: u64, hi: u64, left: u64, right: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let size = hi - lo
    if (left & 1) == 0 && (right & 1) == 0 {
        return size << 1
    }
    let mid = lo + (left >> 1)
    if (left & 1) == 0 {
        stable_quicksort(mut g, lo, mid, before)
    }
    if (right & 1) == 0 {
        stable_quicksort(mut g, mid, hi, before)
    }
    merge(mut g, lo, mid, hi, before)
    (size << 1) | 1
}

// The shorter run moves to scratch and merges back into xs from its end (merge.rs).
fn merge[T](mut g: Hole[T], lo0: u64, mid: u64, hi0: u64, before: scoped fn(T, T) -> Order) {
    if mid == lo0 || mid == hi0 {
        return
    }
    // Left keys not after xs[mid] and right keys not before xs[mid - 1] are already in
    // place; only the overlap between them moves. Both searches gallop out from the run
    // boundary, so near-sorted input costs O(log overlap) calls (CPython listsort.txt,
    // "Galloping"). No slot is out of the list while they compare.
    let lo = gallop_left(g.xs, lo0, mid, before)
    if lo == mid {
        return
    }
    let hi = gallop_right(g.xs, mid, hi0, before)
    if mid - lo <= hi - mid {
        slots_list_move(g.xs, lo, view g.scratch.raw, lo, mid - lo)
        g.active = Active(op: 1, a: lo, b: mid, c: mid, d: 0, e: 0)
        merge_up(mut g.active, g.xs, view g.scratch.raw, hi, before)
        let st = g.active
        if st.a < st.b {
            slots_list_move(view g.scratch.raw, st.a, g.xs, st.c - (st.b - st.a), st.b - st.a)
        }
    } else {
        slots_list_move(g.xs, mid, view g.scratch.raw, mid, hi - mid)
        g.active = Active(op: 2, a: mid, b: mid, c: hi, d: 0, e: 0)
        merge_down(mut g.active, g.xs, view g.scratch.raw, lo, before)
        let st = g.active
        if st.b < st.c {
            slots_list_move(view g.scratch.raw, st.b, g.xs, st.a, st.c - st.b)
        }
    }
    g.active = idle()
}

// Left run remaining in scratch [a, b), right in xs [c, hi); output fills xs up to
// a + c - b. The comparison picks the source without a branch.
fn merge_up[T](mut st: Active, xs: View[List[T]], s: View[List[T]], hi: u64, before: scoped fn(T, T) -> Order) {
    while st.a < st.b && st.c < hi {
        let take_left = !precedes(slots_list_view(xs, st.c), slots_list_view(s, st.a), before)
        let from = if take_left {
            s
        } else {
            xs
        }
        let at = if take_left {
            st.a
        } else {
            st.c
        }
        slots_list_move(from, at, xs, int.wrapping_sub(int.wrapping_add(st.a, st.c), st.b), 1)
        let step: u64 = if take_left {
            1
        } else {
            0
        }
        st.a = int.wrapping_add(st.a, step)
        st.c = int.wrapping_add(st.c, int.wrapping_sub(1, step))
    }
}

// Left run remaining in xs [lo, a), right in scratch [b, c); output fills xs down from
// a + c - b. Equal keys take the right element last, so they keep their order.
fn merge_down[T](mut st: Active, xs: View[List[T]], s: View[List[T]], lo: u64, before: scoped fn(T, T) -> Order) {
    while st.a > lo && st.c > st.b {
        let l = int.wrapping_sub(st.a, 1)
        let r = int.wrapping_sub(st.c, 1)
        let take_left = precedes(slots_list_view(s, r), slots_list_view(xs, l), before)
        let from = if take_left {
            xs
        } else {
            s
        }
        let at = if take_left {
            l
        } else {
            r
        }
        slots_list_move(from, at, xs, int.wrapping_add(l, int.wrapping_sub(st.c, st.b)), 1)
        let step: u64 = if take_left {
            1
        } else {
            0
        }
        st.a = int.wrapping_sub(st.a, step)
        st.c = int.wrapping_sub(st.c, int.wrapping_sub(1, step))
    }
}

fn insertion_sort_hole[T](mut g: Hole[T], lo: u64, hi: u64, before: scoped fn(T, T) -> Order) {
    let mut i = lo + 1
    while i < hi {
        insert_tail(mut g.active, g.xs, view g.scratch.raw, lo, i, before)
        i += 1
    }
}

// Inserting xs[i] is merge_down of [lo, i) with the one-element run scratch[i, i + 1).
fn insert_tail[T](mut st: Active, xs: View[List[T]], s: View[List[T]], lo: u64, i: u64, before: scoped fn(T, T) -> Order) {
    let prev = int.wrapping_sub(i, 1)
    if !precedes(slots_list_view(xs, i), slots_list_view(xs, prev), before) {
        return
    }
    slots_list_move(xs, i, s, i, 1)
    slots_list_move(xs, prev, xs, i, 1)
    st.op = 2
    st.a = prev
    st.b = i
    st.c = int.wrapping_add(i, 1)
    while st.a > lo && precedes(slots_list_view(s, i), slots_list_view(xs, int.wrapping_sub(st.a, 1)), before) {
        slots_list_move(xs, int.wrapping_sub(st.a, 1), xs, st.a, 1)
        st.a = int.wrapping_sub(st.a, 1)
    }
    slots_list_move(s, i, xs, st.a, 1)
    st.op = 0
}

// smallsort.rs `small_sort_general`: each half of [lo, hi) starts as one sort4_stable
// network from 8 keys (else one key), grows by insert_tail, and the halves meet in one
// bidirectional merge. Rust builds the halves in scratch; here they are built in xs, so
// only the merge holds two scratch runs at once.
fn small_sort[T](mut g: Hole[T], lo: u64, hi: u64, before: scoped fn(T, T) -> Order) {
    let size = hi - lo
    if size < 2 {
        return
    }
    let mid = lo + size / 2
    let mut presorted: u64 = 1
    if size >= 8 {
        sort4_stable(g.xs, view g.scratch.raw, lo, before)
        sort4_stable(g.xs, view g.scratch.raw, mid, before)
        presorted = 4
    }
    let mut i = int.wrapping_add(lo, presorted)
    while i < mid {
        insert_tail(mut g.active, g.xs, view g.scratch.raw, lo, i, before)
        i = int.wrapping_add(i, 1)
    }
    i = int.wrapping_add(mid, presorted)
    while i < hi {
        insert_tail(mut g.active, g.xs, view g.scratch.raw, mid, i, before)
        i = int.wrapping_add(i, 1)
    }
    bidirectional_merge(mut g, lo, mid, hi, before)
}

// smallsort.rs `sort4_stable`: five comparisons pick the order of xs [v, v + 4), then
// the four keys pass through scratch into place. Every comparison comes before any move,
// so a failing comparator leaves xs as it was and no Hole operation is needed.
fn sort4_stable[T](xs: View[List[T]], s: View[List[T]], v: u64, before: scoped fn(T, T) -> Order) {
    let v1 = int.wrapping_add(v, 1)
    let v2 = int.wrapping_add(v, 2)
    let v3 = int.wrapping_add(v, 3)
    let c1 = precedes(slots_list_view(xs, v1), slots_list_view(xs, v), before)
    let c2 = precedes(slots_list_view(xs, v3), slots_list_view(xs, v2), before)
    let a = if c1 {
        v1
    } else {
        v
    }
    let b = if c1 {
        v
    } else {
        v1
    }
    let c = if c2 {
        v3
    } else {
        v2
    }
    let d = if c2 {
        v2
    } else {
        v3
    }
    let c3 = precedes(slots_list_view(xs, c), slots_list_view(xs, a), before)
    let c4 = precedes(slots_list_view(xs, d), slots_list_view(xs, b), before)
    let least = if c3 {
        c
    } else {
        a
    }
    let most = if c4 {
        b
    } else {
        d
    }
    let inner_c = if c4 {
        c
    } else {
        b
    }
    let unknown_left = if c3 {
        a
    } else {
        inner_c
    }
    let inner_b = if c3 {
        b
    } else {
        c
    }
    let unknown_right = if c4 {
        d
    } else {
        inner_b
    }
    let c5 = precedes(slots_list_view(xs, unknown_right), slots_list_view(xs, unknown_left), before)
    let second = if c5 {
        unknown_right
    } else {
        unknown_left
    }
    let third = if c5 {
        unknown_left
    } else {
        unknown_right
    }
    slots_list_move(xs, least, s, v, 1)
    slots_list_move(xs, second, s, v1, 1)
    slots_list_move(xs, third, s, v2, 1)
    slots_list_move(xs, most, s, v3, 1)
    slots_list_move(s, v, xs, v, 4)
}

// smallsort.rs `bidirectional_merge` of the sorted runs xs [lo, mid) and [mid, hi):
// both move to scratch, then each round places the least remaining key at the front
// and the greatest at the back. Rust reads past an exhausted run and checks the
// cursors at the end; here the rounds stop when either run is empty, and the other
// run's remainder fills the gap, so any comparator leaves a permutation.
fn bidirectional_merge[T](mut g: Hole[T], lo: u64, mid: u64, hi: u64, before: scoped fn(T, T) -> Order) {
    slots_list_move(g.xs, lo, view g.scratch.raw, lo, hi - lo)
    g.active = Active(op: 4, a: lo, b: mid, c: mid, d: hi, e: mid)
    merge_both(mut g.active, g.xs, view g.scratch.raw, mid, before)
    let st = g.active
    let to = int.wrapping_sub(int.wrapping_add(st.a, st.c), mid)
    let left = int.wrapping_sub(st.b, st.a)
    if left != 0 {
        slots_list_move(view g.scratch.raw, st.a, g.xs, to, left)
    }
    let right = int.wrapping_sub(st.d, st.c)
    if right != 0 {
        slots_list_move(view g.scratch.raw, st.c, g.xs, to, right)
    }
    g.active = idle()
}

// Left run scratch [a, b), right run [c, d); the front fills xs from a + c - mid and
// the back down from b + d - mid. Equal keys take the left at the front and the right
// at the back, so they keep their order.
fn merge_both[T](mut st: Active, xs: View[List[T]], s: View[List[T]], mid: u64, before: scoped fn(T, T) -> Order) {
    while st.a < st.b && st.c < st.d {
        let take_left = !precedes(slots_list_view(s, st.c), slots_list_view(s, st.a), before)
        let at = if take_left {
            st.a
        } else {
            st.c
        }
        slots_list_move(s, at, xs, int.wrapping_sub(int.wrapping_add(st.a, st.c), mid), 1)
        let step: u64 = if take_left {
            1
        } else {
            0
        }
        st.a = int.wrapping_add(st.a, step)
        st.c = int.wrapping_add(st.c, int.wrapping_sub(1, step))
        if st.a == st.b || st.c == st.d {
            return
        }
        let l = int.wrapping_sub(st.b, 1)
        let r = int.wrapping_sub(st.d, 1)
        let take_right = !precedes(slots_list_view(s, r), slots_list_view(s, l), before)
        let from = if take_right {
            r
        } else {
            l
        }
        slots_list_move(s, from, xs, int.wrapping_sub(int.wrapping_sub(int.wrapping_add(st.b, st.d), mid), 1), 1)
        let back: u64 = if take_right {
            1
        } else {
            0
        }
        st.d = int.wrapping_sub(st.d, back)
        st.b = int.wrapping_sub(st.b, int.wrapping_sub(1, back))
    }
}

fn stable_quicksort[T](mut g: Hole[T], lo: u64, hi: u64, before: scoped fn(T, T) -> Order) {
    // At most 2 floor(log2(size)) unbalanced partitions before the eager merge fallback.
    let log: u64 = int.widen(63 - int.leading_zeros((hi - lo) | 1))
    quicksort(mut g, lo, hi, 2 * log, before)
}

// quicksort.rs: partition, then sort both sides. Rust recurses on the right side; here
// the larger side waits on an explicit stack and the loop takes the smaller, so pending
// ranges are at most log2(size) deep and task stacks stay small.
//
// Keys equal to the least key of a range all go right, so a range keeps the index of
// the pivot that bounded it from below (its ancestor). A new pivot the ancestor does not
// precede equals the least key, and an equal partition takes every key equal to it and
// skips them. A partition with nothing left of the pivot proves the same without an
// ancestor. A left range has no ancestor here: Rust carries its ancestor by copy, and
// the index of one moves when the range is partitioned.
fn quicksort[T](mut g: Hole[T], lo: u64, hi: u64, limit: u64, before: scoped fn(T, T) -> Order) {
    // A pending range is its start, end, remaining budget and ancestor (none is hi).
    let mut starts: Inline[u64, 64] =[0; 64]
    let mut ends: Inline[u64, 64] =[0; 64]
    let mut budgets: Inline[u64, 64] =[0; 64]
    let mut ancestors: Inline[u64, 64] =[0; 64]
    let mut pending: u64 = 0
    let mut a = lo
    let mut b = hi
    let mut budget = limit
    let mut ancestor = hi
    loop {
        let size = b - a
        if size <= small_len() || budget == 0 {
            if size <= small_len() {
                small_sort(mut g, a, b, before)
            } else {
                drift(mut g, a, b, true, before)
            }
            if pending == 0 {
                return
            }
            pending -= 1
            a = starts[pending]
            b = ends[pending]
            budget = budgets[pending]
            ancestor = ancestors[pending]
            continue
        }
        budget -= 1
        let pivot = choose_pivot(g.xs, a, size, before)
        let least = ancestor != hi && !precedes(slots_list_view(g.xs, ancestor), slots_list_view(g.xs, pivot), before)
        let mut left: u64 = 0
        let mut moved = pivot
        if !least {
            let (l, m) = partition_hole(mut g, a, b, pivot, false, before)
            left = l
            moved = m
        }
        if left == 0 {
            // The permutation so far is the identity, so the pivot is still at its index.
            let (equal, _) = partition_hole(mut g, a, b, pivot, true, before)
            a += equal
            ancestor = hi
        } else {
            let mid = a + left
            if left <= size - left {
                starts[pending] = mid
                ends[pending] = b
                ancestors[pending] = moved
                b = mid
                ancestor = hi
            } else {
                starts[pending] = a
                ends[pending] = mid
                ancestors[pending] = hi
                a = mid
                ancestor = moved
            }
            budgets[pending] = budget
            pending += 1
        }
    }
}

// pivot.rs: median of three, recursively of nine and more from 64 elements.
fn choose_pivot[T](xs: View[List[T]], a: u64, size: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let eighth = size / 8
    if size < 64 {
        median3(xs, a, a + eighth * 4, a + eighth * 7, before)
    } else {
        median3_rec(xs, a, a + eighth * 4, a + eighth * 7, eighth, before)
    }
}

fn median3_rec[T](xs: View[List[T]], a: u64, b: u64, c: u64, n: u64, before: scoped fn(T, T) -> Order) -> u64 {
    if n >= 8 {
        let n8 = n / 8
        let a2 = median3_rec(xs, a, a + n8 * 4, a + n8 * 7, n8, before)
        let b2 = median3_rec(xs, b, b + n8 * 4, b + n8 * 7, n8, before)
        let c2 = median3_rec(xs, c, c + n8 * 4, c + n8 * 7, n8, before)
        return median3(xs, a2, b2, c2, before)
    }
    median3(xs, a, b, c, before)
}

fn median3[T](xs: View[List[T]], a: u64, b: u64, c: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let x = precedes(slots_list_view(xs, b), slots_list_view(xs, a), before)
    let y = precedes(slots_list_view(xs, c), slots_list_view(xs, a), before)
    if x == y {
        let z = precedes(slots_list_view(xs, c), slots_list_view(xs, b), before)
        if z == x {
            b
        } else {
            c
        }
    } else {
        a
    }
}

// Stable partition of xs [lo, hi) around xs[p] (quicksort.rs `stable_partition`).
// Each scanned element moves to scratch: left ones up from lo, right ones down
// from hi - 1; then both blocks return, the right one reversed. Returns the left
// count and the pivot's new index. Normally keys before the pivot go left and the pivot
// goes right; an equal partition sends left every key the pivot does not precede, the
// pivot included.
fn partition_hole[T](mut g: Hole[T], lo: u64, hi: u64, p: u64, equal: bool, before: scoped fn(T, T) -> Order) -> (u64, u64) {
    let size = hi - lo
    // The right element scanned at index i goes to scratch t - i + left.
    let t = lo + hi - 1
    g.active = Active(op: 3, a: lo, b: size, c: lo, d: 0, e: 0)
    partition_scan(mut g.active, g.xs, view g.scratch.raw, false, p, p, t, equal, before)
    // The pivot is never compared with itself.
    let left_before = g.active.d
    let at = if equal {
        lo + g.active.d
    } else {
        t - p + g.active.d
    }
    slots_list_move(g.xs, p, view g.scratch.raw, at, 1)
    if equal {
        g.active.d += 1
    }
    g.active.c = p + 1
    partition_scan(mut g.active, g.xs, view g.scratch.raw, true, at, hi, t, equal, before)
    let left = g.active.d
    g.active = idle()
    if left != 0 {
        slots_list_move(view g.scratch.raw, lo, g.xs, lo, left)
    }
    let mut k: u64 = 0
    let right = size - left
    // k < right <= hi - lo, so neither index wraps; checked steps would keep
    // this copy from vectorizing.
    let back = hi - 1
    let front = lo + left
    while k < right {
        slots_list_move(view g.scratch.raw, int.wrapping_sub(back, k), g.xs, int.wrapping_add(front, k), 1)
        k = int.wrapping_add(k, 1)
    }
    // Equal: the pivot follows the left keys scanned before it. Normal: it follows the
    // left block and the right keys scanned before it.
    let moved = if equal {
        lo + left_before
    } else {
        left + p - left_before
    }
    (left, moved)
}

// quicksort.rs `stable_partition`: each comparison chooses the destination index
// without a branch. The scan is unrolled four times, as Rust does for keys of at most
// 16 bytes; Hirsel cannot ask the size of T, so every T takes the unrolled loop. Each
// step updates st before the next comparison, so a failure restores from any of them.
fn partition_scan[T](mut st: Active, xs: View[List[T]], s: View[List[T]], pivot_in_scratch: bool, at: u64, end: u64, t: u64, equal: bool, before: scoped fn(T, T) -> Order) {
    let pc = if pivot_in_scratch {
        s
    } else {
        xs
    }
    let unroll_end = if end >= 3 {
        int.wrapping_sub(end, 3)
    } else {
        0
    }
    if equal {
        while st.c < unroll_end {
            let l0 = !precedes(slots_list_view(pc, at), slots_list_view(xs, st.c), before)
            partition_one(mut st, xs, s, t, l0)
            let l1 = !precedes(slots_list_view(pc, at), slots_list_view(xs, st.c), before)
            partition_one(mut st, xs, s, t, l1)
            let l2 = !precedes(slots_list_view(pc, at), slots_list_view(xs, st.c), before)
            partition_one(mut st, xs, s, t, l2)
            let l3 = !precedes(slots_list_view(pc, at), slots_list_view(xs, st.c), before)
            partition_one(mut st, xs, s, t, l3)
        }
        while st.c < end {
            let left = !precedes(slots_list_view(pc, at), slots_list_view(xs, st.c), before)
            partition_one(mut st, xs, s, t, left)
        }
    } else {
        while st.c < unroll_end {
            let l0 = precedes(slots_list_view(xs, st.c), slots_list_view(pc, at), before)
            partition_one(mut st, xs, s, t, l0)
            let l1 = precedes(slots_list_view(xs, st.c), slots_list_view(pc, at), before)
            partition_one(mut st, xs, s, t, l1)
            let l2 = precedes(slots_list_view(xs, st.c), slots_list_view(pc, at), before)
            partition_one(mut st, xs, s, t, l2)
            let l3 = precedes(slots_list_view(xs, st.c), slots_list_view(pc, at), before)
            partition_one(mut st, xs, s, t, l3)
        }
        while st.c < end {
            let left = precedes(slots_list_view(xs, st.c), slots_list_view(pc, at), before)
            partition_one(mut st, xs, s, t, left)
        }
    }
}

// Left keys go to scratch up from st.a, right keys down from t - st.c.
fn partition_one[T](mut st: Active, xs: View[List[T]], s: View[List[T]], t: u64, left: bool) {
    let base = if left {
        st.a
    } else {
        int.wrapping_sub(t, st.c)
    }
    slots_list_move(xs, st.c, s, int.wrapping_add(base, st.d), 1)
    let step: u64 = if left {
        1
    } else {
        0
    }
    st.d = int.wrapping_add(st.d, step)
    st.c = int.wrapping_add(st.c, 1)
}

// The first i in [lo, mid] with xs[mid] before every key of xs[i..mid).
fn gallop_left[T](xs: View[List[T]], lo: u64, mid: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let mut found = mid
    let mut low = lo
    let mut step: u64 = 1
    while step <= mid - lo {
        let i = mid - step
        if !precedes(xs[mid], xs[i], before) {
            low = i + 1
            break
        }
        found = i
        step <<= 1
    }
    while low < found {
        let m = low + (found - low) / 2
        if precedes(xs[mid], xs[m], before) {
            found = m
        } else {
            low = m + 1
        }
    }
    found
}

// The first j in [mid, hi] whose key is not before xs[mid - 1].
fn gallop_right[T](xs: View[List[T]], mid: u64, hi: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let mut found = hi
    let mut low = mid
    let mut step: u64 = 1
    while step <= hi - mid {
        let j = mid - 1 + step
        if !precedes(xs[j], xs[mid - 1], before) {
            found = j
            break
        }
        low = j + 1
        step <<= 1
    }
    while low < found {
        let m = low + (found - low) / 2
        if precedes(xs[m], xs[mid - 1], before) {
            low = m + 1
        } else {
            found = m
        }
    }
    found
}

fn precedes[T](a: T, b: T, before: scoped fn(T, T) -> Order) -> bool {
    match before(a, b) {
        Less => true,
        _ => false,
    }
}

// The scratch slots an active operation holds, and the xs holes they return to:
// op 1 (merge_up): scratch [a, b) to xs ending at c.
// op 2 (merge_down and insertion): scratch [b, c) to xs from a.
// op 3 (partition of b elements from a, scanned up to c, d of them left):
// scratch [a, a + d) to xs [a, a + d), and the c - a - d right ones, which end at
// a + b, to xs from a + d.
// op 4 (bidirectional merge split at e): scratch [a, b) then [c, d) to xs from
// a + c - e.
type Active {
    op: u64,
    a: u64,
    b: u64,
    c: u64,
    d: u64,
    e: u64
}

fn idle() -> Active {
    Active(op: 0, a: 0, b: 0, c: 0, d: 0, e: 0)
}

scoped type Hole[T] {
    xs: View[List[T]],
    scratch: Slots[T],
    active: Active
} drop(g) {
    let st = g.active
    if st.op == 1 {
        let count = int.wrapping_sub(st.b, st.a)
        if count != 0 {
            slots_list_move(view g.scratch.raw, st.a, g.xs, int.wrapping_sub(st.c, count), count)
        }
    } else if st.op == 2 {
        let count = int.wrapping_sub(st.c, st.b)
        if count != 0 {
            slots_list_move(view g.scratch.raw, st.b, g.xs, st.a, count)
        }
    } else if st.op == 3 {
        if st.d != 0 {
            slots_list_move(view g.scratch.raw, st.a, g.xs, st.a, st.d)
        }
        let right = int.wrapping_sub(int.wrapping_sub(st.c, st.a), st.d)
        if right != 0 {
            let from = int.wrapping_sub(int.wrapping_add(st.a, st.b), right)
            slots_list_move(view g.scratch.raw, from, g.xs, int.wrapping_add(st.a, st.d), right)
        }
    } else if st.op == 4 {
        let to = int.wrapping_sub(int.wrapping_add(st.a, st.c), st.e)
        let left = int.wrapping_sub(st.b, st.a)
        if left != 0 {
            slots_list_move(view g.scratch.raw, st.a, g.xs, to, left)
        }
        let right = int.wrapping_sub(st.d, st.c)
        if right != 0 {
            slots_list_move(view g.scratch.raw, st.c, g.xs, int.wrapping_add(to, left), right)
        }
    }
    slots_finish_list(g.xs)
}

// These private aliases keep both headers fixed while Hole tracks liveness.
// xs retains its original length and capacity, and the empty scratch header
// frees only the backing allocation after Hole has restored every live slot.
fn slots_list_view[T](xs: View[List[T]], i: u64) -> View[T] in xs

fn slots_list_move[T](src: View[List[T]], i: u64, dst: View[List[T]], j: u64, n: u64)

fn slots_finish_list[T](xs: View[List[T]])

pub type DeclarationBase {
    store: types.StoreKey,
    opened: u64,
    version: u64,
    stamp: u64,
    changes: u64,
    live: u64
}

pub opaque type DeclareState {
    base: DeclarationBase
}

pub fn declaration_state(base: DeclarationBase) -> DeclareState {
    DeclareState(base)
}

pub fn declaration_base_of(state: DeclareState) -> DeclarationBase {
    state.base
}

pub fn follower_base(hi: u64, lo: u64, opened: u64, version: u64, stamp: u64, live: u64) -> DeclarationBase {
    DeclarationBase(store: types.StoreKey(hi: hi, lo: lo), opened, version, stamp, changes: 0, live)
}

pub fn same_declaration_base(state: DeclareState, b: DeclarationBase) -> bool {
    let a = state.base
    types.same(a.store.hi, a.store.lo, b.store.hi, b.store.lo) && a.opened == b.opened && a.version == b.version && a.stamp == b.stamp && a.changes == b.changes && a.live == b.live
}

pub fn declaration_name(name: String) -> Result[(), types.Failure] {
    if std.string.starts_with(name, "hirsel.") {
        return Error(Missing(named(name)?))
    }
    Ok(())
}

pub fn declaration_index_name(key: Bytes) -> Result[String, types.Failure] {
    let raw = types.copied(list.slice(key, 5, list.len(key)))?
    let name = string.from_utf8(take raw) ?=> |_| pages.malformed(0)
    Ok(take name)
}

pub fn declaration_revision[F](versioned: bool, f: StaticFn[F]) -> Result[Bytes, types.Failure] {
    if versioned {
        let Some(hash) = code.revision(f) else {
            return Error(Missing("revision"))
        }
        return types.copied(hash)
    }
    Ok(list.new())
}

pub fn revision_part(i: u64) -> String {
    if i == 0 {
        "extractor code"
    } else if i == 1 {
        "table key codec"
    } else if i == 2 {
        "row codec"
    } else if i == 3 {
        "index key codec"
    } else {
        "payload codec"
    }
}

pub fn note_cause(mut out: String, what: String) {
    if string.byte_len(out) != 0 {
        string.push(mut out, ", ")
    }
    string.push(mut out, what)
}

pub fn append_fingerprint(mut out: Bytes, take fingerprint: Option[Bytes]) -> Result[(), types.Failure] {
    let Some(part) = fingerprint else {
        return Error(Missing("revision"))
    }
    list.append(mut out, part)
    Ok(())
}

pub fn index_payload_number(mut schemas: List[Bytes], description: Bytes) -> Result[u16, types.Failure] {
    for i in 0u64 .. list.len(schemas) {
        if schemas[i] == description {
            return Ok(int.truncate(i))
        }
    }
    let next_number = list.len(schemas)
    if next_number == 65535 {
        return Error(Limit(Value))
    }
    list.push(mut schemas, types.copied(description)?)
    Ok(int.truncate(next_number))
}

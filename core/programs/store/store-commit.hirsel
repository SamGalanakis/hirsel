// The admission bound, then the commit on branch `i` (section 1.11, run step 4).
type AdmittedDraft[R, A] = Ready(Ran[R, A], Publication) | OverLimit(Ran[R, A], StoreCapacity)

fn prepare_edited_roots[R, A](mut db: Db, i: u64, mut ran: Ran[R, A]) -> Result[(), Error] {
    if ran.prepared_roots {
        return Ok(())
    }
    if let None = ran.keyed {
        if pages.data_row_count(ran.edits) == 0 && pages.data_row_count(ran.replies) == 0 {
            return Ok(())
        }
    }
    let (take candidate, after) = disk_allocation(scoped fn() -> Result[(pages.Roots, u64), Error] {
        let Some(base) = view ran.roots else {
            fail("store: draft has no base roots")
        }
        let mut first = ran.first_stamp
        if pages.tree_stamp(base.collections) != pages.tree_stamp(pages.holder_heads(db.holders)[i].roots.collections) {
            let Some(fresh_start) = int.checked_add(pages.holder_next_node(db.holders), 1) else {
                return Error(Limit(Ids))
            }
            first = fresh_start
        }
        let mut roots = pages.share_roots(base)
        let mut stamp_out = first
        materialize_ordered_rows(mut roots.collections, ran.edits, ran.order, false, first, mut stamp_out)?
        materialize_rows(mut roots.streams, ran.replies, false, first, mut stamp_out)?
        if let Some(keyed) = ran.keyed {
            failure_result_from_rep(pages.materialize_keyed_edits(mut roots, keyed.edits, first, mut stamp_out))?
        }
        failure_result_from_rep(pages.canonical_roots(mut roots))?
        Ok((take roots, stamp_out))
    })?
    let next_node = order.max(pages.holder_next_node(db.holders), after - 1)
    pages.set_next_node(mut db.holders, next_node)
    ran.roots = Some(take candidate)
    ran.prepared_roots = true
    Ok(())
}

fn prepare_direct_edit[R, A](mut db: Db, i: u64, mut ran: Ran[R, A]) -> Result[bool, Capacity] {
    if ran.prepared_roots {
        return Ok(false)
    }
    if let Some(_) = ran.keyed {
        return Ok(false)
    }
    if let Some(_) = branch_follower_slot(db.followers, pages.holder_heads(db.holders)[i].id) {
        return Ok(false)
    }
    let data_count = pages.data_row_count(ran.edits)
    let reply_count = pages.data_row_count(ran.replies)
    if data_count + reply_count == 0 || (reply_count != 0 && data_count + reply_count != 1) {
        return Ok(false)
    }
    let Some(take base) = replace(mut ran.roots, None) else {
        fail("store: draft has no base roots")
    }
    if pages.tree_stamp(base.collections) != pages.tree_stamp(pages.holder_heads(db.holders)[i].roots.collections) {
        ran.roots = Some(take base)
        return Ok(false)
    }
    let _ = take base
    let changed_roots = if data_count != 0 {
        direct_data_edits(mut db, i, ran)?
    } else {
        let op = pages.data_row(ran.replies, 0u64)
        match view op.value {
            None => false,
            Some(raw) => {
                let empty_key: Bytes = list.new()
                pages.edit_head_streams(mut db.holders, i, scoped fn(mut tree: pages.PageTree) -> Result[bool, Capacity] {
                    let inline = tree.inline
                    let mut stamps = ran.first_stamp
                    std.page.put_inline_unique(mut tree.root, empty_key, op.key, format.staged_bytes(raw), inline, mut stamps)
                })?
            },
        }
    }
    if !changed_roots {
        ran.roots = Some(pages.share_roots(pages.holder_heads(db.holders)[i].roots))
    }
    Ok(changed_roots)
}

// Writes each row in place when every row is an inline put into a collection
// no other row of the commit touches. All rows are checked, with their leaf
// room reserved, before any is written, so a false or a refusal leaves the
// head's rows as they were. The paths take stamps in turn from first_stamp,
// inside the interval the body reserved for them.
fn direct_data_edits[R, A](mut db: Db, i: u64, ran: Ran[R, A]) -> Result[bool, Capacity] {
    pages.edit_head_collection(mut db.holders, i, scoped fn(mut tree: pages.PageTree) -> Result[bool, Capacity] {
        direct_collection_edits(mut tree, ran.edits, ran.first_stamp)
    })
}

fn direct_collection_edits(mut tree: pages.PageTree, edits: pages.DataRows, first_stamp: u64) -> Result[bool, Capacity] {
    let inline = tree.inline
    // put_inline_unique takes no stamp above this bound; each path is far shorter than 512.
    let rows = pages.data_row_count(edits)
    if first_stamp == 0 || rows > 1024 || first_stamp > 18446744073709551103u64 - 512 * rows {
        return Ok(false)
    }
    for e in 0u64 .. rows {
        let op = pages.data_row(edits, e)
        let Some(raw) = view op.value else {
            return Ok(false)
        }
        let collection = list.slice(op.key, 0, 4)
        if pages.collection_kind(tree, collection) == Some(CellCollection) {
            return Ok(false)
        }
        for prior in 0u64 .. e {
            if list.compare_bytes(list.slice(pages.data_row(edits, prior).key, 0, 4), collection) == Equal {
                return Ok(false)
            }
        }
        if !std.page.inline_unique_ready(mut tree.root, collection, list.slice(op.key, 4, list.len(op.key)), format.staged_bytes(raw), inline)? {
            return Ok(false)
        }
    }
    let mut stamps = first_stamp
    for slot in 0u64 .. pages.data_row_count(edits) {
        let op = pages.data_row(edits, slot)
        let Some(raw) = view op.value else {
            fail("store: a checked direct edit lost its value")
        }
        match std.page.put_inline_unique(mut tree.root, list.slice(op.key, 0, 4), list.slice(op.key, 4, list.len(op.key)), format.staged_bytes(raw), inline, mut stamps) {
            Ok(true) => (),
            _ => fail("store: a checked direct edit did not apply"),
        }
    }
    Ok(true)
}

fn prepare_run_commit[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[AdmittedDraft[R, A], Error] {
    if over_bound(db, ran) {
        let needed = ran.live
        let available = resident_with_credit(db.ceiling, draft_credit(db, ran))
        return Ok(OverLimit(take ran, Resident(Capacity(requested: needed, available: available))))
    }
    let mut draft = take ran
    match prepare_direct_edit(mut db, i, mut draft) {
        Ok(true) => return Ok(Ready(take draft, Publication(followed: None))),
        Ok(false) => (),
        Error(c) => return Ok(OverLimit(take draft, Allocation(c))),
    }
    match prepare_edited_roots(mut db, i, mut draft) {
        Ok(()) => (),
        Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
        Error(take problem) => return Error(take problem),
    }
    if let Some(roots) = draft.roots {
        let extra = int.saturating_sub(keyed_root_record_bytes(roots.keyed), keyed_root_record_bytes(pages.holder_heads(db.holders)[i].roots.keyed))
        check_manifest_addition(db, extra)?
    }
    if let Some(_) = draft.tiered {
        let total = {
            let Some(roots) = view draft.roots else {
                fail("store: Tiered draft has no candidate")
            }
            settled_tiered_bytes(db.tiered, retaining(db), pages.holder_heads(db.holders)[i].roots.collections, roots.collections, draft.edits)
        }
        match total {
            Ok(n) => {
                draft.tiered = Some(n)
            },
            Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
            Error(take problem) => return Error(take problem),
        }
    }
    if let None = branch_follower_slot(db.followers, pages.holder_heads(db.holders)[i].id) {
        return Ok(Ready(take draft, Publication(followed: None)))
    }
    let drafted_publication = disk_allocation(scoped fn() -> Result[Publication, Error] {
        let Some(roots) = view draft.roots else {
            fail("store: prepared draft has no roots")
        }
        failure_result_from_rep(types.capacity(prepare_publication(db, i, pages.holder_heads(db.holders)[i].head + 1, roots, pages.holder_next_node(db.holders))))
    })
    let publication = match take drafted_publication {
        Ok(take plan) => take plan,
        Error(Full(problem)) => return Ok(OverLimit(take draft, problem)),
        Error(take problem) => return Error(take problem),
    }
    Ok(Ready(take draft, take publication))
}

// §13.8's charge for the commit's replaced and dropped rows, checked and
// reserved once the commit is otherwise decided, so applying it cannot fail.
fn reserve_tiered_freed[R, A](mut db: Db, ran: Ran[R, A]) -> Option[StoreCapacity] {
    let Some(freed) = view ran.freed else {
        return None
    }
    if !is_disk(db) || (list.len(freed.replaced) == 0 && list.len(freed.dropped) == 0) {
        return None
    }
    let limit = disk_state(db).options.dirty_bytes
    let reserved = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Result[(), Error] {
        reserve_tiered_commit(mut state.tiered_dirty, freed, limit)
    })
    match reserved {
        Ok(()) => None,
        Error(Full(problem)) => Some(problem),
        Error(_) => fail("store: a list reservation refuses only with Full"),
    }
}

fn commit_prepared[R, A](mut db: Db, i: u64, take ran: Ran[R, A], take publication: Publication) -> Outcome[R, A] {
    db.keyed_credit = draft_credit(db, ran)
    if i == 0u64 {
        for reply_slot in 0u64 .. pages.data_row_count(ran.replies) {
            let drafted_reply = pages.data_row(ran.replies, reply_slot)
            if map.contains(db.admits, drafted_reply.key) {
                let settled = match drafted_reply.value {
                    None => true,
                    Some(raw) => result.unwrap(stream_state(format.staged_bytes(raw))).state == 2u8,
                }
                if settled {
                    let _ = map.remove(mut db.admits, drafted_reply.key)
                }
            }
        }
    }
    let Ran(value: take value, roots: take roots, live: live_bytes, tiered: tiered, freed: take freed, exact: exact, frame: take frame, info: ci, reads: take seen, ..) = take ran
    let branch_id = pages.holder_heads(db.holders)[i].id
    match db.disk {
        Some(mut state) => {
            if let Some(take written) = take freed {
                admit_tiered_commit(mut state.tiered_dirty, branch_id, take written)
            }
            db.file_end += match frame {
                Some(raw) => list.len(raw),
                None => 0u64
            }
            state.pending = take frame
            db.frame_seq += 1
        },
        None => {
            let _ = take frame
        },
    }
    if let Some(take candidate) = take roots {
        let old_bytes = keyed_root_record_bytes(pages.holder_heads(db.holders)[i].roots.keyed)
        let count_bytes = keyed_root_record_bytes(candidate.keyed)
        pages.commit_roots(mut db.holders, i, take candidate, old_bytes, count_bytes)
    }
    db.resident = live_bytes
    if let Some(n) = tiered {
        db.tiered = n
    }
    pages.advance_head(mut db.holders, i, ci.at)
    db.changes += 1
    if exact {
        db.settled = db.changes
    }
    publish(take publication)
    let sent_sequence = if !is_disk(db) {
        db.changes
    } else {
        db.frame_seq
    }
    let commit_ticket = Ticket(store: db.store, open: open_number(db), mark: Journal(sent_sequence, pages.holder_heads(db.holders)[i].id, pages.holder_heads(db.holders)[i].head))
    match take value {
        Ok(take v) => Committed(Done(value: take v, ticket: commit_ticket, info: Some(ci), reads: take seen)),
        Error(take a) => Aborted(Undone(value: take a, ticket: Some(commit_ticket)))
    }
}

fn commit_skipped[R, A](db: Db, i: u64, take ran: Ran[R, A]) -> Outcome[R, A] {
    let Ran(value: take value, reads: take seen, ..) = take ran
    let sent_sequence = if !is_disk(db) {
        db.changes
    } else {
        db.frame_seq
    }
    let commit_ticket = Ticket(store: db.store, open: open_number(db), mark: Journal(sent_sequence, pages.holder_heads(db.holders)[i].id, pages.holder_heads(db.holders)[i].head))
    match take value {
        Ok(take v) => Committed(Done(value: take v, ticket: commit_ticket, info: None, reads: take seen)),
        Error(_) => fail("store: skipped commit must return Ok"),
    }
}

fn keyed_credit_equal(a: format.KeyedCredit, b: format.KeyedCredit) -> bool {
    a.resident == b.resident && a.padding == b.padding && a.journal == b.journal
}

fn keyed_draft_empty(db: Db, keyed: Option[format.KeyedDraft]) -> bool {
    match keyed {
        None => true,
        Some(draft) => list.len(draft.edits) == 0 && keyed_credit_equal(draft.after, db.keyed_credit),
    }
}

fn draft_is_empty[R, A](db: Db, force_frame: bool, rec: Option[CallRecord], settlement: Option[format.Settlement], prepared: Prepared[R, A]) -> bool {
    if force_frame || prepared.observed_info {
        return false
    }
    if let Error(_) = prepared.outcome {
        return false
    }
    if pages.data_row_count(prepared.ops) != 0 || pages.data_row_count(prepared.stream_ops) != 0 {
        return false
    }
    if !keyed_draft_empty(db, prepared.keyed) {
        return false
    }
    if let Some(_) = prepared.call {
        return false
    }
    if let Some(_) = rec {
        return false
    }
    if let Some(_) = settlement {
        return false
    }
    true
}

fn draft_row_account(db: Db, i: u64, proposed: pages.Roots) -> Result[u64, Error] {
    disk_allocation(scoped fn() -> Result[u64, Error] {
        let mut roots: List[pages.Roots] = list.with_capacity(list.len(pages.holder_heads(db.holders)) + list.len(pages.holder_pins(db.holders)))
        for slot in 0u64 .. list.len(pages.holder_heads(db.holders)) {
            let root = if slot == i {
                pages.share_roots(proposed)
            } else {
                pages.share_roots(pages.holder_heads(db.holders)[slot].roots)
            }
            list.push(mut roots, take root)
        }
        for held in pages.holder_pins(db.holders) {
            list.push(mut roots, pages.share_roots(held.roots))
        }
        Ok(pages.page_row_account(roots))
    })
}

// AP15: an over-bound retained-root draft is admitted on its proposed union.
// If settling old charges rotates the journal, rebind the staged frame.
fn settle_draft[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[AdmittedDraft[R, A], Error] waits {
    if ran.skipped {
        return Ok(Ready(take ran, Publication(followed: None)))
    }
    if is_disk(db) {
        let refusal = match ran.frame {
            Some(raw) => journal_refusal(disk_state(db).uncovered, list.len(raw), available_journal(db, draft_credit(db, ran))),
            None => None,
        }
        if let Some(overflow) = refusal {
            return Ok(OverLimit(take ran, Journal(overflow)))
        }
    }
    if !over_bound(db, ran) || !retaining(db) {
        wait_for_frame_room(mut db, ran.frame)?
        return prepare_run_commit(mut db, i, take ran)
    }
    let mut settled = take ran
    match prepare_edited_roots(mut db, i, mut settled) {
        Ok(()) => (),
        Error(Full(problem)) => return Ok(OverLimit(take settled, problem)),
        Error(take problem) => return Error(take problem),
    }
    let counted = {
        let Some(roots) = view settled.roots else {
            fail("store: settled draft has no roots")
        }
        draft_row_account(db, i, roots)
    }
    let live_bytes = match take counted {
        Ok(live_bytes) => live_bytes,
        Error(Full(problem)) => return Ok(OverLimit(take settled, problem)),
        Error(take problem) => return Error(take problem),
    }
    settled.live = live_bytes
    settled.exact = true
    let checked = prepare_run_commit(mut db, i, take settled)?
    let (take admitted, take publication) = match take checked {
        Ready(take ready, take plan) => (take ready, take plan),
        OverLimit(take rejected, problem) => return Ok(OverLimit(take rejected, problem)),
    }
    let mut draft = take admitted
    if db.settled != db.changes && draft.tiered == None {
        match cut_install(mut db, NoHolderChange) {
            Ok(_) => {},
            Error(Full(c)) => return Ok(OverLimit(take draft, c)),
            Error(take e) => return Error(take e)
        }
        if let Some(take frame) = replace(mut draft.frame, None) {
            let mut raw = take frame
            if let Error(c) = format.seal_frame(mut raw, format.DiskContext(store: store_key_to_rep(db.store), role: 2, seq: db.file_seq), db.file_end) {
                return Ok(OverLimit(take draft, Allocation(c)))
            }
            draft.frame = Some(take raw)
        }
    }
    wait_for_frame_room(mut db, draft.frame)?
    Ok(Ready(take draft, take publication))
}

fn settle_admit[R, A](mut db: Db, i: u64, take ran: Ran[R, A]) -> Result[Outcome[R, A], Error] waits {
    let checked = settle_draft(mut db, i, take ran)?
    match take checked {
        Ready(take draft, take publication) => {
            if draft.skipped {
                let _ = take publication
                if object_writer_open(db) {
                    journal_poll(mut db)?
                    if covered(db, Journal(db.frame_seq, 0, 0)) {
                        object_skip_fence(mut db)?
                    }
                }
                return Ok(commit_skipped(db, i, take draft))
            }
            if let Some(problem) = reserve_tiered_freed(mut db, draft) {
                return Ok(Refused(problem))
            }
            Ok(commit_prepared(mut db, i, take draft, take publication))
        },
        OverLimit(_, c) => Ok(Refused(c)),
    }
}

fn frame_draft[R, A](db: Db, base: pages.PageTree, ci: CallInfo, rec: Option[CallRecord], settlement: Option[format.Settlement], force_frame: bool, take finished: Finished[R, A]) -> Result[Finished[R, A], Capacity] {
    match take finished {
        RolledBack(take outcome) => Ok(RolledBack(take outcome)),
        DraftFault(take problem) => Ok(DraftFault(take problem)),
        Drifted(take name, take seen) => Ok(Drifted(take name, take seen)),
        Prepared(take ready) => {
            let mut prepared = take ready
            let skipped = draft_is_empty(db, force_frame, rec, settlement, prepared)
            prepared.skipped = skipped
            if !skipped && is_disk(db) {
                let deltas: Option[View[List[Option[format.TieredDataDelta]]]] = match prepared.plan {
                    Some(plan) => Some(view plan.deltas),
                    None => None,
                }
                prepared.frame = Some(encode_staged(ci, Some(view base), Some(prepared.base_stamp), deltas, mut prepared.ops, prepared.order, prepared.frame_tail, prepared.stream_ops, prepared.call, rec, settlement, prepared.keyed, db.file_seq, db.file_end, db.limits.frame)?)
            }
            Ok(Prepared(take prepared))
        },
    }
}

// Charge page preparation to the existing call scope when the caller
// supplied a byte or step grant. Only application is outside that scope.
// Memory rows apply first; the Tiered plan then stages its collections over
// that tree, and its tree is the commit's collection map. Every stamp drawn
// here is raised into `issued`, so the watermark covers it.
fn prepare_metered_pages[R, A](issued: core.Cell[u64], attempt: Option[core.Cell[TieredTouchSet]], pins: Map[TieredCacheKey, Arc[format.TieredFrame]], take finished: Finished[R, A]) -> Result[Finished[R, A], Error] {
    match take finished {
        RolledBack(take outcome) => Ok(RolledBack(take outcome)),
        DraftFault(take problem) => Ok(DraftFault(take problem)),
        Drifted(take name, take seen) => Ok(Drifted(take name, take seen)),
        Prepared(take staged) => {
            let mut prepared = take staged
            if pages.data_row_count(prepared.ops) == 0 && pages.data_row_count(prepared.stream_ops) == 0 {
                if let None = prepared.keyed {
                    return Ok(Prepared(take prepared))
                }
            }
            let first = prepared.first_stamp
            let mut draw = first
            let memory_only = match attempt {
                Some(_) => true,
                None => false,
            }
            materialize_ordered_rows(mut prepared.roots.collections, prepared.ops, prepared.order, memory_only, first, mut draw)?
            materialize_rows(mut prepared.roots.streams, prepared.stream_ops, false, first, mut draw)?
            if let Some(record) = attempt {
                if let Some(take tiered_plan) = plan_tiered_edits(prepared.roots.collections, record, pins, prepared.ops, prepared.order, draw)? {
                    prepared.roots.collections = pages.share_page_tree(tiered_plan.tree)
                    draw = tiered_plan.next_stamp
                    prepared.plan = Some(take tiered_plan)
                }
            }
            if let Some(keyed) = prepared.keyed {
                failure_result_from_rep(pages.materialize_keyed_edits(mut prepared.roots, keyed.edits, first, mut draw))?
            }
            failure_result_from_rep(pages.canonical_roots(mut prepared.roots))?
            prepared.prepared_roots = true
            let drawn = draw - 1
            let high = cell.replace(issued, drawn)
            if high > drawn {
                let _ = cell.replace(issued, high)
            }
            Ok(Prepared(take prepared))
        },
    }
}

// With `memory_only`, rows of Tiered collections are left to the Tiered
// write plan, which stages them through the attempt's resolver.
fn materialize_rows(mut tree: pages.PageTree, operations: pages.DataRows, memory_only: bool, first: u64, mut draw: u64) -> Result[(), Error] {
    let order = failure_result_from_rep(types.capacity(pages.data_order(operations)))?
    materialize_ordered_rows(mut tree, operations, order, memory_only, first, mut draw)
}

fn materialize_ordered_rows(mut tree: pages.PageTree, operations: pages.DataRows, order: format.DataOrder, memory_only: bool, first: u64, mut draw: u64) -> Result[(), Error] {
    let collection_map = pages.tree_domain(tree) == CollectionMap
    let mut processed = 0u64
    for slot_order in 0u64 .. pages.data_row_count(operations) {
        if slot_order < processed {
            continue
        }
        let op = ordered_row(operations, order, slot_order)
        if collection_map {
            let collection = list.slice(op.key, 0, 4)
            if let Some(descriptor) = pages.collection_by_key(tree, collection) {
                if descriptor.kind == TableCollection || descriptor.kind == IndexCollection {
                    processed = slot_order + 1
                    while processed < pages.data_row_count(operations) {
                        let following = ordered_row(operations, order, processed)
                        if list.slice(following.key, 0, 4) != collection {
                            break
                        }
                        processed += 1
                    }
                    if memory_only && descriptor.residency == ResidentTiered {
                        continue
                    }
                    if processed > slot_order + 1 {
                        materialize_collection_batch(mut tree, operations, order, slot_order, processed, first, mut draw)?
                        continue
                    }
                }
            }
        }
        materialize_row(mut tree, op, memory_only, first, mut draw)?
    }
    Ok(())
}

fn materialize_row(mut tree: pages.PageTree, op: format.DataOp, memory_only: bool, first: u64, mut draw: u64) -> Result[(), Error] {
    if let Some(_) = op.trim {
        return Ok(())
    }
    if memory_only && tiered_data_key(tree, op.key) {
        return Ok(())
    }
    if pages.tree_domain(tree) == CollectionMap {
        let kind = pages.collection_kind(tree, list.slice(op.key, 0, 4))
        if kind == Some(CellCollection) {
            return match op.value {
                Some(PageValue(raw)) => apply_cell(mut tree, op.key, Some(view raw), None, first, mut draw),
                Some(BlobBody(raw)) => apply_cell(mut tree, op.key, Some(view raw), Some(view raw), first, mut draw),
                None => apply_cell(mut tree, op.key, None, None, first, mut draw),
            }
        }
        if kind == Some(LogCollection) {
            return match op.value {
                Some(PageValue(raw)) => apply_log_append(mut tree, op.key, raw, None, first, mut draw),
                Some(BlobBody(raw)) => apply_log_append(mut tree, op.key, raw, Some(view raw), first, mut draw),
                None => fail("store: Log append has no value"),
            }
        }
    }
    match op.value {
        Some(PageValue(raw)) => failure_result_from_rep(pages.put_page_row(mut tree, op.key, raw, first, mut draw)),
        Some(BlobBody(raw)) => failure_result_from_rep(pages.put_shared_page_row(mut tree, op.key, raw, first, mut draw)),
        None => {
            let _ = failure_result_from_rep(pages.remove_page_row(mut tree, op.key, first, mut draw))?
            Ok(())
        },
    }
}

fn materialize_collection_batch(mut tree: pages.PageTree, operations: pages.DataRows, order: format.DataOrder, start: u64, end: u64, first: u64, mut draw: u64) -> Result[(), Error] {
    let collection = list.slice(ordered_row(operations, order, start).key, 0, 4)
    let edit_at = scoped fn(_unused: (), slot: u64, visit: scoped fn(std.page.SourceEdit) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
        visit_materialized_edit(operations, order, slot, visit)
    }
    failure_result_from_rep(pages.page_result(pages.apply_collection_batch(mut tree, collection, (), edit_at, start, end, first, mut draw)))
}

fn visit_materialized_edit(operations: pages.DataRows, order: format.DataOrder, slot: u64, visit: scoped fn(std.page.SourceEdit) -> Result[(), std.page.Error]) -> Result[(), std.page.Error] {
    let op = ordered_row(operations, order, slot)
    let value: Option[(View[Bytes], Option[View[Arc[Bytes]]])] = match view op.value {
        Some(PageValue(raw)) => Some((raw, None)),
        Some(BlobBody(raw)) => Some((view raw, Some(raw))),
        None => None,
    }
    visit(std.page.SourceEdit(key: list.slice(op.key, 4, list.len(op.key)), value: value, prior: None))
}

fn journal_refusal(uncovered: u64, frame: u64, limit: u64) -> Option[Capacity] {
    if uncovered > limit || frame > limit - uncovered {
        Some(Capacity(requested: int.saturating_add(uncovered, frame), available: limit))
    } else {
        None
    }
}

fn over_bound[R, A](db: Db, ran: Ran[R, A]) -> bool {
    ran.admits_rows && ran.live > resident_with_credit(db.ceiling, draft_credit(db, ran))
}

fn store_body_at[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    store_body_at_with(mut db, i, wall, steps, keep_reply, false, body)
}

fn store_body_at_with[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], force_frame: bool, body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let outcome = append_transaction_at_with(mut db, i, wall, steps, keep_reply, force_frame, body)
    if let Ok(Refused(Journal(_))) = outcome {
        return take outcome
    }
    if let Ok(Committed(Done(info: None, ..))) = outcome {
        return take outcome
    }
    maybe_checkpoint(mut db)?
    take outcome
}

fn append_transaction_at[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    append_transaction_at_with(mut db, i, wall, steps, keep_reply, false, body)
}

fn append_transaction_at_with[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], force_frame: bool, body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let outcome: Result[Outcome[R, A], Error] = match staged_until_decided(mut db, i, wall, steps, keep_reply, force_frame, body)? {
        Over(take o) => Ok(take o),
        Ran(take ran) => settle_admit(mut db, i, take ran),
        DraftError(take problem) => Error(take problem),
        Latched => fail("store: a decided stage is latched"),
        DriftStop(take name, take seen) => {
            trip_drift(mut db, i, take seen)?
            Ok(Failed(Drift(take name)))
        },
    }
    handoff(mut db)?
    take outcome
}

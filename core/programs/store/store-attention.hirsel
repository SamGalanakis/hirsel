// What a working store reports to its operator (§II.3).
pub type Accounts {
    logical: u64,
    tiered: u64,
    exact: bool,
    frames: u64,
    journal: u64,
    resident: u64
}

pub fn accounts(db: Db) -> Accounts {
    let (frames, journal) = match db.disk {
        Some(state) => (state.inflight, state.uncovered),
        None => (0u64, 0u64)
    }
    let resident = if is_disk(db) {
        db.page_resident
    } else {
        memory_page_images(db)
    }
    Accounts(logical: int.saturating_add(int.saturating_add(db.resident, db.tiered), db.keyed_credit.padding), tiered: db.tiered, exact: !retaining(db) || db.changes == db.settled, frames: frames, journal: journal, resident: resident)
}

// A Memory store's page images, counted now over every head and pin. A walk
// whose scratch cannot be allocated reports u64 max: the figure is unknown,
// never understated (§13.8).
fn memory_page_images(db: Db) -> u64 {
    let counted = isolate(scoped fn() -> Result[u64, Capacity] {
        let roots = pages.state_roots(current_state(db)?)?
        Ok(manifest.resident_images(roots, None))
    })
    match counted {
        Ok(Ok(Ok(images))) => images,
        _ => 18446744073709551615u64,
    }
}

/// An index whose write found an entry missing that the row's old value
/// implies: the index and its table disagree (§I.3). `count` is the number of
/// writes since this open that found it so. Each such write fails with
/// `Drift(name)`. `demoted` is the number of times since this open that the
/// writer demoted the index for it, to Backfilling(None) until it is rebuilt
/// (§1.2). A drift found while the index was already Backfilling(None), or
/// on a branch, demotes nothing, so `demoted` can be less than `count`.
pub type IndexDrift: codec + shareable + send {
    table: u32,
    id: u32,
    index: String,
    count: u64,
    demoted: u64
}

/// One declared index on main's head and its build state, read from its
/// catalog record.
pub type IndexReport: codec + shareable + send {
    table: u32,
    id: u32,
    index: String,
    state: IndexState
}

/// Conditions a working store reports to its operator (§II.3), unlike
/// `Health`, which signals once when the store stops working.
///
/// `indexes` lists every index on main's head in catalog order (table id,
/// then name), with its state.
///
/// `reclaim_failures` counts Bucket reclaim passes since this open that failed
/// with an error other than a fence. Each failed pass stays pending and runs
/// again on a later journal turn (§II.4); `reclaim_pending` is true from a
/// failure until a pass succeeds. Both are 0 and false off Bucket.
pub type Attention: codec + shareable + send {
    indexes: List[IndexReport],
    drift: List[IndexDrift],
    reclaim_failures: u64,
    reclaim_pending: bool
}

pub fn attention(db: Db) -> Result[Attention, Error] {
    let mut drift: List[IndexDrift] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut drift, list.len(db.drift))))?
    for seen in db.drift {
        list.push(mut drift, IndexDrift(table: seen.table, id: seen.id, index: failure_result_from_rep(catalog.named(seen.index))?, count: seen.count, demoted: seen.demoted))
    }
    let reclaims = reclaim_state(db)
    Ok(Attention(indexes: index_reports(db)?, drift: take drift, reclaim_failures: reclaims.count, reclaim_pending: reclaims.pending))
}

// `Db.attention_seq` moves on every schema commit and every drift or demotion
// counted; the reclaim counters come from the journal task (§II.3).
/// Changes whenever `attention(db)` may answer differently, so a caller can
/// read it often and call `attention` only on a change. Equal marks give
/// equal answers.
pub fn attention_mark(db: Db) -> (u64, u64, bool) {
    let reclaims = reclaim_state(db)
    (db.attention_seq, reclaims.count, reclaims.pending)
}

fn index_reports(db: Db) -> Result[List[IndexReport], Error] {
    let mut first_key: Bytes = list.new()
    list.push(mut first_key, 2u8)
    let mut end_key: Bytes = list.new()
    list.push(mut end_key, 3u8)
    let mut out: List[IndexReport] = list.new()
    let mut records = byte_cursor(pages.holder_heads(db.holders)[0].roots.catalog, Included(take first_key), end_key)?
    while let Some((take key, raw)) = failure_result_from_rep(catalog.next_bytes(mut records))? {
        let record = decode_catalog(raw)?
        let state = copied_state(catalog_index(record)?.state)?
        failure_result_from_rep(types.capacity(list.try_reserve(mut out, 1)))?
        list.push(mut out, IndexReport(table: record.owner, id: record.id, index: failure_result_from_rep(catalog.declaration_index_name(key))?, state: take state))
    }
    Ok(take out)
}

// Counts the drift a staged draft saw, by index, under the names its base
// catalog gives them.
fn count_drift(mut db: Db, catalog: pages.PageTree, seen: List[(u32, u32)]) -> Result[(), Error] {
    db.attention_seq = int.saturating_add(db.attention_seq, 1)
    for (owner, id) in seen {
        let mut found = false
        for at in 0u64 .. list.len(db.drift) {
            if db.drift[at].table == owner && db.drift[at].id == id {
                db.drift[at].count = int.saturating_add(db.drift[at].count, 1)
                found = true
                break
            }
        }
        if !found {
            let name = find_index_name(catalog, owner, id)?
            failure_result_from_rep(types.capacity(list.try_reserve(mut db.drift, 1)))?
            list.push(mut db.drift, IndexDrift(table: owner, id: id, index: take name, count: 1, demoted: 0))
        }
    }
    Ok(())
}

// A call a proven-wrong index failed (§I.3): counts the drift and, on main,
// demotes each index it names in one schema commit.
fn trip_drift(mut db: Db, i: u64, seen: List[(u32, u32)]) -> Result[(), Error] waits {
    let catalog = pages.share_page_tree(pages.holder_heads(db.holders)[i].roots.catalog)
    count_drift(mut db, catalog, seen)?
    if i != 0 {
        return Ok(())
    }
    demote_drifted(mut db, seen)
}

// Counts one demotion for each index a drift demoted; count_drift has
// already made its entry.
fn count_demotions(mut db: Db, demoted: List[(u32, u32)]) -> Result[(), Error] {
    db.attention_seq = int.saturating_add(db.attention_seq, 1)
    for (owner, id) in demoted {
        for at in 0u64 .. list.len(db.drift) {
            if db.drift[at].table == owner && db.drift[at].id == id {
                db.drift[at].demoted = int.saturating_add(db.drift[at].demoted, 1)
                break
            }
        }
    }
    Ok(())
}

// Premultiplied U16x4 inputs, fast_image_resize 6.2.0 convolution, then
// independent sRGB conversion. Every RGBA8 channel must be within 2 codes.
@test
fn resize_and_geometry_reference() -> Result[(), ()] {
    let limits = image.Limits(max_bytes: 4096, max_header_bytes: 4096, max_pixels: 1024, max_frames: 1, max_steps: 10000000)
    let source = image.Raster(width: 17, height: 11, rgba: b"\x00\x00\x00\x64\x0d\x2b\x58\x6d\x1a\x56\xb0\x76\x27\x81\x08\x7f\x34\xac\x60\x88\x41\xd7\xb8\x91\x4e\x02\x10\x9a\x5b\x2d\x68\xa3\x68\x58\xc0\xac\x75\x83\x18\xb5\x82\xae\x70\xbe\x8f\xd9\xc8\xc7\x9c\x04\x20\xd0\xa9\x2f\x78\xd9\xb6\x5a\xd0\xe2\xc3\x85\x28\xeb\xd0\xb0\x80\xf4\x11\x07\x17\x6b\x1e\x32\x6f\x74\x2b\x5d\xc7\x7d\x38\x88\x1f\x86\x45\xb3\x77\x8f\x52\xde\xcf\x98\x5f\x09\x27\xa1\x6c\x34\x7f\xaa\x79\x5f\xd7\xb3\x86\x8a\x2f\xbc\x93\xb5\x87\xc5\xa0\xe0\xdf\xce\xad\x0b\x37\xd7\xba\x36\x8f\xe0\xc7\x61\xe7\xe9\xd4\x8c\x3f\xf2\xe1\xb7\x97\xfb\x22\x0e\x2e\x72\x2f\x39\x86\x7b\x3c\x64\xde\x84\x49\x8f\x36\x8d\x56\xba\x8e\x96\x63\xe5\xe6\x9f\x70\x10\x3e\xa8\x7d\x3b\x96\xb1\x8a\x66\xee\xba\x97\x91\x46\xc3\xa4\xbc\x9e\xcc\xb1\xe7\xf6\xd5\xbe\x12\x4e\xde\xcb\x3d\xa6\xe7\xd8\x68\xfe\xf0\xe5\x93\x56\xf9\xf2\xbe\xae\x66\x33\x15\x45\x79\x40\x40\x9d\x82\x4d\x6b\xf5\x8b\x5a\x96\x4d\x94\x67\xc1\xa5\x9d\x74\xec\xfd\xa6\x81\x17\x55\xaf\x8e\x42\xad\xb8\x9b\x6d\x05\xc1\xa8\x98\x5d\xca\xb5\xc3\xb5\xd3\xc2\xee\x0d\xdc\xcf\x19\x65\xe5\xdc\x44\xbd\xee\xe9\x6f\x15\xf7\xf6\x9a\x6d\x64\x03\xc5\xc5\x6d\x44\x1c\x5c\x80\x51\x47\xb4\x89\x5e\x72\x0c\x92\x6b\x9d\x64\x9b\x78\xc8\xbc\xa4\x85\xf3\x14\xad\x92\x1e\x6c\xb6\x9f\x49\xc4\xbf\xac\x74\x1c\xc8\xb9\x9f\x74\xd1\xc6\xca\xcc\xda\xd3\xf5\x24\xe3\xe0\x20\x7c\xec\xed\x4b\xd4\xf5\xfa\x76\x2c\xfe\x07\xa1\x84\x6b\x14\xcc\xdc\x74\x55\x23\x73\x87\x62\x4e\xcb\x90\x6f\x79\x23\x99\x7c\xa4\x7b\xa2\x89\xcf\xd3\xab\x96\xfa\x2b\xb4\xa3\x25\x83\xbd\xb0\x50\xdb\xc6\xbd\x7b\x33\xcf\xca\xa6\x8b\xd8\xd7\xd1\xe3\xe1\xe4\xfc\x3b\xea\xf1\x27\x93\xf3\xfe\x52\xeb\xfc\x0b\x7d\x43\x69\x18\xa8\x9b\x72\x25\xd3\xf3\x7b\x66\x2a\x8a\x8e\x73\x55\xe2\x97\x80\x80\x3a\xa0\x8d\xab\x92\xa9\x9a\xd6\xea\xb2\xa7\x01\x42\xbb\xb4\x2c\x9a\xc4\xc1\x57\xf2\xcd\xce\x82\x4a\xd6\xdb\xad\xa2\xdf\xe8\xd8\xfa\xe8\xf5\x03\x52\xf1\x02\x2e\xaa\xfa\x0f\x59\x02\x67\x1c\x84\x5a\x70\x29\xaf\xb2\x79\x36\xda\x0a\x82\x77\x31\xa1\x95\x84\x5c\xf9\x9e\x91\x87\x51\xa7\x9e\xb2\xa9\xb0\xab\xdd\x01\xb9\xb8\x08\x59\xc2\xc5\x33\xb1\xcb\xd2\x5e\x09\xd4\xdf\x89\x61\xdd\xec\xb4\xb9\xe6\xf9\xdf\x11\xef\x06\x0a\x69\xf8\x13\x35\xc1\x65\x20\x60\x19\x6e\x2d\x8b\x71\x77\x3a\xb6\xc9\x80\x47\xe1\x21\x89\x88\x38\xb8\x9c\x95\x63\x10\xa5\xa2\x8e\x68\xae\xaf\xb9\xc0\xb7\xbc\xe4\x18\xc0\xc9\x0f\x70\xc9\xd6\x3a\xc8\xd2\xe3\x65\x20\xdb\xf0\x90\x78\xe4\xfd\xbb\xd0\xed\x0a\xe6\x28\xf6\x17\x11\x80\xff\x24\x3c\xd8\x6c\x31\x67\x30\x75\x3e\x92\x88\x7e\x4b\xbd\xe0\x87\x58\xe8\x38\x90\x99\x3f\xcf\xa3\xa6\x6a\x27\xac\xb3\x95\x7f\xb5\xc0\xc0\xd7\xbe\xcd\xeb\x2f\xc7\xda\x16\x87\xd0\xe7\x41\xdf\xd9\xf4\x6c\x37\xe2\x01\x97\x8f\xeb\x0e\xc2\xe7\xf4\x1b\xed\x3f\xfd\x28\x18\x97\x6a\x35\x43\xef\x73\x42\x6e\x47\x7c\x4f\x99\x9f\x85\x5c\xc4\xf7\x8e\x69\xef\x4f\x97\xaa\x46\xe6\xaa\xb7\x71\x3e\xb3\xc4\x9c\x96\xbc\xd1\xc7\xee\xc5\xde\xf2\x46\xce\xeb\x1d\x9e\xd7\xf8\x48\xf6\xe0\x05\x73\x4e\xe9\x12\x9e\xa6\xf2\x1f\xc9\xfe\xfb\x2c\xf4\x56\x68\x39\x1f\xae\x71\x46\x4a\x06\x7a\x53\x75\x5e\x83\x60\xa0\xb6\x8c\x6d\xcb\x0e\x95\x7a\xf6\x66\x9e")
    for i in 0u64 .. 5 {
        let (filter, expected): (image.Filter, Bytes) = match i {
            0 => (Lanczos3, b"\x12\x00\x6e\x6d\x30\x9f\x82\x83\x50\x95\x85\x99\x6f\x4e\x92\xaf\x8f\xba\x96\xc5\xae\x4a\xa2\xdb\xd0\x93\x92\xf5\x30\x02\x95\x7a\x4e\xab\xab\x90\x6e\x9e\xac\xa6\x8e\x5c\x93\xbc\xaa\xc5\x9c\xcf\xd0\x59\xa5\xee\xe1\x95\xa0\xb5\x4f\x15\x87\x87\x6e\xba\x91\x9d\x8f\xaf\x98\xb3\xaa\x65\x88\xc8\xd0\xd5\x8e\xe1\xef\x63\x98\xf1\x94\xa5\xa3\x7b\x6e\x43\xaf\x94\x8d\xb7\x95\xa9\xa9\x73\x9b\xc0\xd4\x8b\xa5\xd4\xe0\xae\xa7\xf3\x98\x3b\x94\xa1\x00\xc4\x97\x71\x8e\x56\xa2\xa1\xab\xbd\x81\xb6\xcf\x4c\x81\xcb\xe7\x9e\x8a\xe8\x8a\xac\x85\xe5\x00\x00\x90\x6f\x58\xcd\x9d\x88\xac\x63\x9c\xae\xcd\xcb\xa2\xc3\xe7\x63\xa8\xd8\x66\xa4\xb5\xf5\x00\xc5\xaf\x9c\x5b\x43\x8d\x78\x69\xd7\x97\x97"),
            1 => (CatmullRom, b"\x12\x22\x72\x6e\x31\x9a\x7f\x83\x50\x94\x85\x99\x70\x5b\x93\xaf\x90\xb6\x97\xc5\xb0\x4f\x9d\xdc\xd0\x93\x8f\xf2\x30\x2f\x96\x7a\x4e\xa6\xa5\x8f\x6e\x9d\xab\xa6\x8e\x67\x97\xbb\xad\xc2\x9e\xd1\xd0\x5b\xa5\xeb\xdf\x95\x9e\xb5\x4f\x3d\x8d\x87\x6e\xb3\x91\x9c\x8e\xab\x96\xb3\xad\x72\x86\xc8\xd1\xd0\x8f\xe1\xec\x65\x9c\xed\x99\xa5\x9e\x80\x6f\x4f\xae\x94\x8d\xb3\x98\xa9\xad\x76\x9b\xc0\xd2\x8b\xa1\xd6\xdc\xad\xa8\xee\x9b\x4d\x95\xa2\x00\xbe\x94\x74\x8f\x5e\x9e\xa1\xad\xbb\x83\xb6\xd0\x5b\x86\xcd\xe2\x9b\x8b\xe6\x8c\xab\x84\xe2\x00\x47\x90\x74\x4c\xc9\xa1\x86\xad\x69\x9a\xae\xcd\xc7\xa4\xc3\xe3\x69\xaa\xd9\x6c\xa3\xb2\xf1\x00\xbf\xab\x9d\x4c\x61\x8f\x7a\x69\xd4\x96\x94"),
            2 => (Mitchell, b"\x19\x34\x75\x70\x35\x98\x83\x84\x54\x92\x89\x9a\x73\x67\x93\xb0\x92\xb0\x98\xc6\xb2\x5e\x9d\xdc\xcf\x91\x91\xee\x34\x3f\x94\x7c\x51\xa3\xa3\x90\x70\x9c\xa7\xa6\x8f\x71\x97\xbc\xaf\xbb\x9d\xd1\xcf\x67\xa3\xe7\xdb\x93\x9e\xb8\x53\x4b\x8f\x89\x70\xb0\x92\x9d\x8f\xa6\x97\xb3\xaf\x7d\x8a\xc9\xd0\xc6\x92\xe0\xe6\x6f\x9b\xe4\xa4\xa0\x9f\x88\x72\x5a\xaa\x96\x8f\xae\x97\xa9\xae\x7d\x9a\xc0\xd1\x8c\x9f\xd6\xd7\xab\xa4\xe8\xa1\x60\x97\xa5\x32\xb8\x96\x78\x92\x67\x9e\xa3\xae\xb4\x87\xb7\xcf\x68\x89\xcd\xda\x9a\x8e\xe4\x93\xa9\x89\xda\x00\x61\x91\x7d\x4b\xc5\x9e\x85\xad\x72\x9c\xae\xcb\xbf\xa2\xc2\xdd\x73\xa8\xd8\x7d\xa2\xb0\xeb\x25\xba\xa8\xa3\x4a\x72\x91\x7d\x67\xd0\x96\x92"),
            3 => (Bilinear, b"\x1c\x3c\x77\x71\x37\x97\x81\x84\x55\x93\x87\x9a\x75\x6a\x97\xb0\x94\xb0\x97\xc6\xb3\x60\x9b\xdc\xce\x91\x8e\xeb\x36\x46\x95\x7c\x52\xa1\x9f\x90\x70\x9c\xa6\xa5\x90\x74\x9b\xbb\xaf\xbb\x9e\xd1\xce\x68\xa5\xe5\xdb\x93\x9c\xb9\x54\x51\x91\x89\x71\xad\x8f\x9d\x8f\xa6\x96\xb2\xaf\x80\x85\xc8\xce\xc7\x91\xde\xe5\x71\x9f\xe4\xa6\xa0\x9b\x8a\x74\x5d\xad\x96\x90\xac\x99\xaa\xaf\x7b\x9d\xc0\xcf\x8c\x9c\xd6\xd5\xaa\xa7\xe7\x9f\x63\x96\xa4\x39\xb7\x95\x7a\x93\x69\x9b\xa3\xb0\xb3\x8b\xb7\xcf\x6b\x8b\xcd\xd7\x99\x8d\xe3\x91\xab\x89\xd9\x32\x69\x90\x80\x4c\xc4\xa2\x86\xae\x73\x99\xae\xca\xbd\xa6\xc2\xdd\x74\xa9\xd8\x7f\xa1\xad\xe9\x39\xb9\xa6\xa4\x4a\x78\x91\x7f\x66\xcf\x97\x91"),
            _ => (Box, b"\x12\x21\x4b\x6c\x32\x8c\x7f\x83\x51\x9e\x8f\x99\x72\x65\x8c\xb0\x92\xc9\xb0\xc6\xb3\x3f\x9c\xdd\xd3\xa0\x6d\xf3\x33\x2e\x73\x7a\x54\x9a\xa8\x91\x73\xa9\xb6\xa7\x94\x72\x91\xbe\xb4\xd7\xaf\xd4\xd5\x4c\xa0\xeb\xd6\xa8\x8a\x8c\x4b\x37\x92\x85\x6c\xa4\x81\x9b\x8c\xb2\x50\xb2\xad\x7c\x87\xc8\xcd\xe1\x96\xdf\xee\x55\x93\xf5\x0f\xb9\xb9\x70\x65\x41\xb4\x8f\x86\xae\xa0\xa6\xa6\x86\x70\xbc\xc7\x86\xa6\xd3\xe7\xc7\xb4\xe9\xb1\x52\xa5\xb2\x29\xc3\xac\x7a\x87\x4e\xb2\x9d\xa8\xbb\x79\xb4\xc8\x28\x9a\xca\xe9\x93\x88\xe1\x84\xa5\x58\xf7\x2c\x6d\x8e\x72\x4a\xd1\x9d\x88\xa9\x5c\xa2\xab\xca\xc9\xa1\xc2\xea\x35\xc6\xd8\x6b\xa1\xb1\xef\x28\xc2\x75\x90\x4d\x7a\x96\x80\x6c\xdf\x8f\x96"),
        }
        let resized = result.unwrap(image.resize(source, 7, 6, filter, limits))
        if resized.width != 7 || resized.height != 6 || list.len(resized.rgba) != list.len(expected) {
            fail("resized dimensions differ from reference")
        }
        for j in 0u64 .. list.len(expected) {
            let got: i16 = int.widen(resized.rgba[j])
            let want: i16 = int.widen(expected[j])
            if int.abs(got - want) > 2 {
                fail("resized component differs from reference by more than two")
            }
        }
    }
    let edge = image.Raster(width: 2, height: 1, rgba: b"\xff\x00\x00\xff\x00\xff\x00\x00")
    if result.unwrap(image.resize(edge, 2, 1, Mitchell, limits)).rgba != edge.rgba {
        fail("identity resampling changed the source")
    }
    let halved = result.unwrap(image.resize(edge, 1, 1, Bilinear, limits))
    if halved.rgba != b"\xff\x00\x00\x80" {
        fail("transparent green leaked into the resampled red")
    }
    let contrast = image.Raster(width: 2, height: 1, rgba: b"\x00\x00\x00\xff\xff\xff\xff\xff")
    if result.unwrap(image.resize(contrast, 1, 1, Box, limits)).rgba != b"\xbc\xbc\xbc\xff" {
        fail("black and white averaged outside linear light")
    }
    let rotated = result.unwrap(image.auto_orient(contrast, 6, limits))
    if rotated.width != 1 || rotated.height != 2 || rotated.rgba != contrast.rgba {
        fail("EXIF 6 mapped coordinates incorrectly")
    }
    let padded = result.unwrap(image.pad(rotated, 3, 3, 1, 0, 0x00000000, limits))
    let cropped = result.unwrap(image.crop(padded, image.Rect(x: 1, y: 0, width: 1, height: 2), limits))
    if cropped.rgba != rotated.rgba {
        fail("padded origin did not crop back to the source")
    }
    let bottom = image.Raster(width: 1, height: 1, rgba: b"\x00\x00\x00\xff")
    let top = image.Raster(width: 1, height: 1, rgba: b"\xff\xff\xff\x80")
    if result.unwrap(image.composite(bottom, top, 0, 0, limits)).rgba != b"\xbc\xbc\xbc\xff" {
        fail("source-over differed from the linear-light Porter-Duff reference")
    }
    Ok(())
}

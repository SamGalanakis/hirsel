    let expected: Inline[Inline[u8, 97], 5] =[[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 22u8, 231u8, 24u8, 90u8, 230u8, 90u8, 179u8, 95u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 231u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 131u8, 62u8, 23u8, 153u8, 102u8, 103u8, 61u8, 55u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 231u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 242u8, 74u8, 7u8, 159u8, 62u8, 162u8, 244u8, 186u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 231u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 195u8, 158u8, 179u8, 130u8, 221u8, 148u8, 76u8, 174u8, 7u8, 0u8, 0u8, 0u8, 2u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 233u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 155u8, 194u8, 195u8, 201u8, 143u8, 74u8, 58u8, 20u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8]]
    let stores: Inline[StoreId, 5] =[StoreId(hi: 1, lo: 2), StoreId(hi: 1, lo: 2), StoreId(hi: 1, lo: 2), StoreId(hi: 3, lo: 4), StoreId(hi: 1, lo: 9)]
    let branches: Inline[u32, 5] =[0, 0, 0, 7, 1]
    let versions: Inline[u64, 5] =[257, 257, 257, 258, 65536]
    let times: Inline[u64, 5] =[999, 999, 999, 1001, 0]
    let segments: Inline[u64, 5] =[9, 9, 9, 10, 256]
    let offsets: Inline[u64, 5] =[72, 73, 1048576, 73, 1048576]
    let mut ids: u64 = 0
    let mut ops: std.omap.OMap[Bytes, Option[Bytes]] = std.omap.new()
    let key = result.unwrap(physical(1, key_word(7)))
    let mut value: Bytes = list.new()
    result.unwrap(list.push(mut value, 0u8))
    result.unwrap(list.push(mut value, 0u8))
    for i in 0u64 .. 32 {
        result.unwrap(list.push(mut value, int.truncate(i)))
    }
    ops = {
        let (take next_map, _) = result.unwrap(std.omap.insert(mut ids, ops, take key, Some(take value)))
        take next_map
    }
    for i in 0u64 .. 5 {
        let ci = CallInfo(id: CallId(store: stores[i], branch: branches[i], version: versions[i]), at: times[i], seed: 0)
        let raw = result.unwrap(encode_commit(ci, ops, segments[i], offsets[i]))
        if list.len(raw) != 97 {
            return false
        }
        for at in 0u64 .. 97 {
            if raw[at] != expected[i][at] {
                return false
            }
        }
    }
    true
}

fn seed_boundary_points() -> bool {
    let versions: Inline[u64, 4] =[1, 256, 257, 258]
    let expected: Inline[u64, 4] =[14418179372084732305u64, 5897679137105858605u64, 15310494363706394912u64, 17163838325734834816u64]
    for i in 0u64 .. 4 {
        let ci = call_info(StoreId(hi: 1, lo: 2), 0, versions[i], 8, 9)
        if ci.seed != expected[i] || ci.id.version != versions[i] || ci.at != 9 {
            return false
        }
    }
    let stores: Inline[StoreId, 3] =[StoreId(hi: 9, lo: 2), StoreId(hi: 1, lo: 9), StoreId(hi: 1, lo: 2)]
    let branches: Inline[u32, 3] =[0, 0, 1]
    let other: Inline[u64, 3] =[15407299455215397367u64, 15770638267073898971u64, 7822107688032465790u64]
    for i in 0u64 .. 3 {
        if call_info(stores[i], branches[i], 1, 8, 9).seed != other[i] {
            return false
        }
    }
    true
}

fn resident_rounding_points() -> bool {
    let sizes: Inline[u64, 8] =[0, 1, 7, 8, 9, 15, 16, 17]
    let rounded: Inline[u64, 8] =[0, 8, 8, 8, 16, 16, 16, 24]
    for i in 0u64 .. 8 {
        let mut key: Bytes = result.unwrap(list.with_capacity(sizes[i]))
        result.unwrap(list.fill(mut key, sizes[i], 0u8))
        for j in 0u64 .. 8 {
            let mut value: Bytes = result.unwrap(list.with_capacity(sizes[j]))
            result.unwrap(list.fill(mut value, sizes[j], 0u8))
            if entry(key, value) != 62 + rounded[i] + rounded[j] {
                return false
            }
        }
    }
    true
}

fn range_boundary_points(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("boundary", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "boundary", std.codec.key_u64(), std.codec.of_u64()))
    let sh = shape(t)
    // The review's one-row witness, before any node split can distract from it.
    let witness = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        put(mut tx, t, 32, 7)?
        let mut rows = range(tx, sh, Included(32), Included(32))?
        Ok(next(mut rows)? == Some((32u64, 7u64)) && next(mut rows)? == None)
    }))
    match take witness {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    for k in 0u64 .. 96 {
        if !typed_put(mut db, t, k, k + 1) {
            return false
        }
    }
    let points: Inline[u64, 10] =[0, 15, 16, 31, 32, 33, 63, 64, 95, 96]
    for i in 0u64 .. 10 {
        let pivot = points[i]
        for a in 0u64 .. 3 {
            for b in 0u64 .. 3 {
                let lo: Bound[u64] = match a {
                    0 => Unbounded,
                    1 => Included(pivot),
                    _ => Excluded(pivot)
                }
                let hi: Bound[u64] = match b {
                    0 => Unbounded,
                    1 => Included(pivot + 1),
                    _ => Excluded(pivot + 1)
                }
                let outcome = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
                    let mut rows = range(tx, sh, lo, hi)?
                    for k in 0u64 .. 96 {
                        let lower = a == 0 || (a == 1 && k >= pivot) || (a == 2 && k > pivot)
                        let upper = b == 0 || (b == 1 && k <= pivot + 1) || (b == 2 && k < pivot + 1)
                        if lower && upper {
                            if next(mut rows)? != Some((k, k + 1)) {
                                return Ok(false)
                            }
                        }
                    }
                    Ok(next(mut rows)? == None)
                }))
                match take outcome {
                    Committed(done) => if !done.value {
                        return false
                    },
                    _ => return false
                }
            }
        }
    }
    result.unwrap(create_table(mut db, spec("other_boundary", std.codec.key_u64(), std.codec.of_u64())))
    let second_table = result.unwrap(table(mut db, "other_boundary", std.codec.key_u64(), std.codec.of_u64()))
    let second_shape = shape(second_table)
    let second_witness = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        put(mut tx, second_table, 32, 17)?
        let mut rows = range(tx, second_shape, Included(32), Included(32))?
        Ok(next(mut rows)? == Some((32u64, 17u64)) && next(mut rows)? == None)
    }))
    match take second_witness {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    true
}

fn catalog_key_handle(take key: Bytes) -> Result[Arc[Bytes], Error] {
    match arc.new(take key) {
        Ok(take shared) => Ok(take shared),
        Error((c, _)) => Error(Full(c))
    }
}

fn readable(roots: Roots, key: Bytes, id: u32) -> Result[(), Error] {
    match std.omap.get(roots.catalog, key) {
        Some(raw) => {
            if list.len(raw) < 5 {
                return Error(malformed(0))
            }
            if read_le(raw, 1, 4) == int.widen(id) {
                Ok(())
            } else {
                Error(Stale(id))
            }
        },
        None => Error(Stale(id))
    }
}

pub scoped type IndexRows[K, V] {
    rows: Rows[K, V],
    reads: View[Log[Read]]
}

pub fn next[K, V](mut r: Rows[K, V]) -> Result[Option[(K, V)], Error] {
    next_row(mut r, fn(key: Bytes) -> Result[(), Error] {
        Ok(())
    })
}

fn next_row[K, V](mut r: Rows[K, V], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[(K, V)], Error] {
    let found = next_bytes(mut r.cursor)?
    match take found {
        Some((take key, take raw)) => {
            let row = advance_rows(r, key, raw, None, seen)?
            match take row {
                Some((take value, _)) => Ok(Some(take value)),
                None => Ok(None)
            }
        },
        None => Ok(None)
    }
}

pub fn next_indexed[K, V](mut r: IndexRows[K, V]) -> Result[Option[(K, V)], Error] {
    indexed_advance(mut r.rows, r.reads)
}

fn indexed_advance[K, V](mut rows: Rows[K, V], reads: View[Log[Read]]) -> Result[Option[(K, V)], Error] {
    next_row(mut rows, fn(key: Bytes) -> Result[(), Error] {
        match log.append(reads, Point(copied(key)?)) {
            Ok(()) => Ok(()),
            Error((c, _)) => Error(Full(c))
        }
    })
}

fn catalog_recharge(live: u64, roots: Roots, key: Bytes, value: Bytes, retained: bool) -> u64 {
    let old_charge = if retained {
        0u64
    } else {
        match std.omap.get(roots.catalog, key) {
            Some(old) => entry(key, old),
            None => 0
        }
    }
    int.saturating_add(int.saturating_sub(live, old_charge), entry(key, value))
}

fn stale_reads(tx: Tx, sh: Shape[u64, u64], ix: Index[u64, u64, u64], table_id: u32, index_id: u32) -> bool {
    let point = match fetch(tx, sh, 1) {
        Error(Stale(id)) => id == table_id,
        _ => false
    }
    let span = match range(tx, sh, Unbounded, Unbounded) {
        Error(Stale(id)) => id == table_id,
        _ => false
    }
    let index_read = match lookup(tx, ix, Unbounded, Unbounded) {
        Error(Stale(id)) => id == index_id,
        _ => false
    }
    point && span && index_read
}

// L16/I3: catalog liveness belongs to the roots read. Epoch changes alone do
// not invalidate readers; drop/recreate replaces the incarnation (ids1 ->4).
pub fn law_read_liveness(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("live", std.codec.key_u64(), std.codec.of_u64())))
    let mut old = result.unwrap(table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    let old_shape = shape(old)
    if !typed_put(mut db, old, 1, 10) {
        return false
    }
    result.unwrap(create_index(mut db, old, "bucket", code.describe(bucket), std.codec.key_u64()))
    let old_index = result.unwrap(index(db, mut old, "bucket", code.describe(bucket), std.codec.key_u64()))
    result.unwrap(create_index(mut db, old, "other", code.describe(quotient), std.codec.key_u64()))
    let before = snapshot(db)
    if result.unwrap(get(before, old_shape, 1)) != Some(10u64) {
        return false
    }
    let mut old_matches = result.unwrap(find(before, old_index, Included(2), Included(2)))
    if result.unwrap(next(mut old_matches)) != Some((1u64, 10u64)) {
        return false
    }
    result.unwrap(drop_table(mut db, take old))
    match get(snapshot(db), old_shape, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    result.unwrap(create_table(mut db, spec("live", std.codec.key_u64(), std.codec.of_u64())))
    let mut fresh = result.unwrap(table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_index(mut db, fresh, "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_index = result.unwrap(index(db, mut fresh, "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_shape = shape(fresh)
    if fresh.id != 4 || fresh_index.id != 5 || !typed_put(mut db, fresh, 1, 20) {
        return false
    }
    let current = snapshot(db)
    match get(current, old_shape, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match scan(current, old_shape, Unbounded, Unbounded) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match find(current, old_index, Unbounded, Unbounded) {
        Error(Stale(2)) => {},
        _ => return false
    }
    let observed = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        Ok(stale_reads(tx, old_shape, old_index, 1, 2))
    }))
    match take observed {
        Committed(done) => if !done.value || list.len(done.reads) != 0 {
            return false
        },
        _ => return false
    }
    let query = result.unwrap(look(current, None, fn(tx: Tx) -> bool {
        stale_reads(tx, old_shape, old_index, 1, 2)
    }))
    match take query {
        Seen(done) => if !done.value || list.len(done.reads) != 0 {
            return false
        },
        _ => return false
    }
    if result.unwrap(get(before, old_shape, 1)) != Some(10u64) {
        return false
    }
    let mut old_rows = result.unwrap(scan(before, old_shape, Unbounded, Unbounded))
    if result.unwrap(next(mut old_rows)) != Some((1u64, 10u64)) || result.unwrap(next(mut old_rows)) != None {
        return false
    }
    match get(before, fresh_shape, 1) {
        Error(Stale(4)) => {},
        _ => return false
    }
    match scan(before, fresh_shape, Unbounded, Unbounded) {
        Error(Stale(4)) => {},
        _ => return false
    }
    match find(before, fresh_index, Unbounded, Unbounded) {
        Error(Stale(5)) => {},
        _ => return false
    }
    let old_query = result.unwrap(look(before, None, fn(tx: Tx) -> bool {
        stale_reads(tx, fresh_shape, fresh_index, 4, 5)
    }))
    match take old_query {
        Seen(done) => done.value && list.len(done.reads) == 0,
        _ => false
    }
}

// L27(a): catalog134 + row94 =228 throughout; ceiling322 is one extra row.
// Wrong implementation: charge every overwrite without subtracting its old row.
pub fn law_overwrite_account(c: Clock) -> bool waits {
    let mut options = defaults()
    options.resident_limit = 322
    let mut db = memory_at(c, StoreId(hi: 1, lo: 2), options)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if db.resident != 134 {
        return false
    }
    for step in 0u64 .. 100000 {
        if !typed_put(mut db, t, 1, step + 1) || db.resident != 228 {
            return false
        }
    }
    result.unwrap(get(snapshot(db), shape(t), 1)) == Some(100000u64)
}

// L30, AA1's trace by hand. Main is at v1 after create_table; b forks there
// (parent 0, forked_at 1). Main's A (k1 = 100) is main v2, b's B (k1 = 200)
// is b v2, and c forks from b at 2, so c's parent is b. adopt(c) is
// Diverged(c) and main still reads A at v2. A fork of main with no main
// commit since adopts as a fast-forward; one more main commit after a fork
// makes it Diverged; adopt(main) is Diverged(0). Branch ids are b 1, c 2,
// d 3, e 4, never reused. Wrong implementation caught: an adopt that
// compares versions only, which gives main B at v2.
pub fn law_branches(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = shape(t)
    if version(snapshot(db)) != 1 { return false }
    let arg1 = snapshot(db)
    let (b, _) = result.unwrap(fork(mut db, "b", arg1))
    let arg2 = snapshot(db)
    match fork(mut db, "b", arg2) { Error(Exists(_)) => {}, _ => return false }
    if !typed_put(mut db, t, 1, 100) { return false }
    let on_b = result.unwrap(run_on(mut db, b, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, t, 1, 200) }))
    match take on_b {
        Committed(done) => if done.info.id.branch != 1 || done.info.id.version != 2 { return false },
        _ => return false
    }
    let at_b = result.unwrap(snapshot_of(db, b))
    if version(at_b) != 2 || result.unwrap(get(at_b, sh, 1)) != Some(200u64) { return false }
    let (cb, _) = result.unwrap(fork(mut db, "c", at_b))
    match adopt(mut db, cb) { Error(Diverged(id)) => if id != 2 { return false }, _ => return false }
    if version(snapshot(db)) != 2 || result.unwrap(get(snapshot(db), sh, 1)) != Some(100u64) { return false }
    let arg3 = main_branch(db)
    match adopt(mut db, arg3) { Error(Diverged(id)) => if id != 0 { return false }, _ => return false }
    // D5 per branch: b's handle sees b's commits and not main's.
    let h = result.unwrap(follow(mut db, b))
    if version(latest.read(h)) != 2 { return false }
    let on_b_again = result.unwrap(run_on(mut db, b, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, t, 4, 500) }))
    match take on_b_again { Committed(_) => {}, _ => return false }
    if version(latest.read(h)) != 3 || result.unwrap(get(latest.read(h), sh, 4)) != Some(500u64) { return false }
    // (b) a fork of main with no main commit since its fork: a fast-forward.
    let arg4 = snapshot(db)
    let (dd, _) = result.unwrap(fork(mut db, "d", arg4))
    let on_d = result.unwrap(run_on(mut db, dd, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, t, 2, 300) }))
    match take on_d { Committed(_) => {}, _ => return false }
    let _ = result.unwrap(adopt(mut db, dd))
    let main_now = snapshot(db)
    if version(main_now) != 3 || result.unwrap(get(main_now, sh, 2)) != Some(300u64) || result.unwrap(get(main_now, sh, 1)) != Some(100u64) { return false }
    if let Some(_) = branch(db, "d") { return false }
    match snapshot_of(db, dd) { Error(Missing(_)) => {}, _ => return false }
    match adopt(mut db, dd) { Error(Diverged(id)) => if id != 3 { return false }, _ => return false }
    // (d) one more main commit after the fork.
    let arg5 = snapshot(db)
    let (e, _) = result.unwrap(fork(mut db, "e", arg5))
    if e.id != 4 || !typed_put(mut db, t, 3, 400) { return false }
    match adopt(mut db, e) { Error(Diverged(id)) => if id != 4 { return false }, _ => return false }
    let _ = result.unwrap(delete_branch(mut db, e))
    match snapshot_of(db, e) { Error(Missing(_)) => {}, _ => return false }
    let arg6 = main_branch(db)
    match delete_branch(mut db, arg6) { Error(Missing(_)) => {}, _ => return false }
    // A pin reads its version after later commits; unpin forgets it.
    let arg7 = snapshot(db)
    let _ = result.unwrap(pin(mut db, "p", arg7))
    let arg8 = snapshot(db)
    match pin(mut db, "p", arg8) { Error(Exists(_)) => {}, _ => return false }
    if !typed_put(mut db, t, 3, 401) { return false }
    match pinned(db, "p") {
        Some(s) => if version(s) != 4 || result.unwrap(get(s, sh, 3)) != Some(400u64) { return false },
        None => return false
    }
    let _ = result.unwrap(unpin(mut db, "p"))
    if let Some(_) = pinned(db, "p") { return false }
    match unpin(mut db, "p") { Error(Missing(_)) => {}, _ => return false }
    // L20: a Snapshot of another store or of another open is Foreign.
    let other = memory_at(c, StoreId(hi: 3, lo: 4), defaults())
    match fork(mut db, "x", snapshot(other)) { Error(Foreign) => {}, _ => return false }
    let mut stale = snapshot(db)
    stale.open = 9
    match pin(mut db, "x", stale) { Error(Foreign) => {}, _ => return false }
    match branch(db, "b") { Some(found) => found.id == 1 && version(snapshot(db)) == 5, None => false }
}

// L27(b), I4 by hand from L27(a)'s figures: catalog 134, row 94. While pin p
// holds k1's first row, an overwrite charges 94 and frees nothing. The exact
// account is 322: the catalog once, the pin's leaf and main's leaf. The limit
// 416 admits one unsettled overwrite (322, then 416); each later one passes
// it conservatively (510), settles to 322 and is admitted at 416. A checkpoint
// gives 322, and unpin 228. Wrong implementations caught: a refusal on
// unsettled charges; an exact count that counts a shared node twice (456).
pub fn law_pin_settle(c: Clock) -> bool waits {
    let mut options = defaults()
    options.resident_limit = 416
    let mut db = memory_at(c, StoreId(hi: 1, lo: 2), options)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, t, 1, 1) || db.resident != 228 { return false }
    let arg9 = snapshot(db)
    let _ = result.unwrap(pin(mut db, "p", arg9))
    if db.resident != 228 { return false }
    for step in 0u64 .. 100 {
        if !typed_put(mut db, t, 1, step + 2) { return false }
        if db.resident != (if step == 0 { 322u64 } else { 416u64 }) { return false }
    }
    let _ = result.unwrap(checkpoint(mut db))
    if db.resident != 322 { return false }
    let _ = result.unwrap(unpin(mut db, "p"))
    if db.resident != 228 || !typed_put(mut db, t, 1, 7) || db.resident != 228 { return false }
    result.unwrap(get(snapshot(db), shape(t), 1)) == Some(7u64)
}

@test
fn test_branches(c: Clock) -> Result[(), ()] waits {
    if law_branches(c) { Ok(()) } else { Error(()) }
}

@test
fn test_pin_settle(c: Clock) -> Result[(), ()] waits {
    if law_pin_settle(c) { Ok(()) } else { Error(()) }
}

// I4: each 12-byte key and 8-byte value charges 62 + 16 + 8 = 86.
// Deleting the main row leaves the pin's 86 bytes live, so another row
// would need 172 of the available 90. Unpin makes the same write fit.
pub fn law_pinned_delete(c: Clock) -> bool waits {
    let mut db = test_db(c, 90)
    if !put_one(mut db, 1, 10) { return false }
    let first = snapshot(db)
    let _ = result.unwrap(pin(mut db, "p", first))
    let removed = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        delete_bytes(mut tx, 1, key_word(1))
    }))
    match take removed { Committed(done) => if !done.value { return false }, _ => return false }
    let after_delete = version(snapshot(db))
    let inserted = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(2), key_word(20))
    }))
    match take inserted {
        Refused(cap) => if cap.requested != 172 || cap.available != 90 { return false },
        _ => return false
    }
    let head = snapshot(db)
    if version(head) != after_delete || value_at(head, 1) != 0 || value_at(head, 2) != 0 { return false }
    match pinned(db, "p") { Some(held) => if value_at(held, 1) != 10 { return false }, None => return false }
    let _ = result.unwrap(unpin(mut db, "p"))
    put_one(mut db, 2, 20) && value_at(snapshot(db), 2) == 20
}

@test
fn test_pinned_delete(c: Clock) -> Result[(), ()] waits {
    if law_pinned_delete(c) { Ok(()) } else { Error(()) }
}

fn mark_is(t: Ticket, n: u64) -> bool {
    match t.mark {
        Journal(m) => m == n,
        Cut(_) => false
    }
}

// (position, state) of a stream on main, or (0, 0) when it has none.
fn stream_now(db: Db, name: Bytes) -> (u64, u64) {
    match std.omap.get(db.heads[0].roots.streams, name) {
        Some(raw) => (read_le(raw, 0, 8), int.widen(raw[40])),
        None => (0, 0)
    }
}

fn stream_reply_is(db: Db, name: Bytes, want: Bytes) -> bool {
    match std.omap.get(db.heads[0].roots.streams, name) {
        Some(raw) => list.len(raw) >= 41 && list.slice(raw, 41, list.len(raw)) == want,
        None => false
    }
}

fn call_for(stream: Bytes, revision: u64) -> CallRecord {
    let mut key: Bytes = list.new()
    result.unwrap(list.fill(mut key, 32, 1u8))
    let mut args: Bytes = list.new()
    result.unwrap(list.fill(mut args, 16, 2u8))
    let mut r: Bytes = list.new()
    result.unwrap(list.fill(mut r, revision, 3u8))
    CallRecord(key: take key, args: take args, stream: result.unwrap(copied(stream)), revision: Some(take r), code: code_vector())
}

// The digest of a request with call_for's entry key and these args.
fn digest_for(args: String) -> RequestDigest {
    let mut key: Bytes = list.new()
    result.unwrap(list.fill(mut key, 32, 1u8))
    request_digest(key, string.as_bytes(args))
}

fn missing_is(r: Result[(), Error], name: String) -> bool {
    match r {
        Error(Missing(n)) => n == name,
        _ => false
    }
}

// L13 by hand on a memory store, whose commit_ticket marks count commits. Wrong
// implementations caught: admitting latest+1 over an unreplied latest
// (no_s7); an aborted body's data writes kept (abort_keeps_data), its reply
// dropped (abort_drops_reply) or kept without a ticket (abort_no_ticket); an
// over-bound abort that keeps its reply; an admit of an unreplied position
// admitted in this open that commits again or answers Admitted; a new
// stream admitting p > 0; a reply at a position not Admitted; a record
// without a reply, twice, or with a 31-byte revision. L29: COMMIT sizes with
// a streams section, with and without a data head, and a CALL section.
pub fn law_streams(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let s = result.unwrap(copied(string.as_bytes("s")))
    let d = digest_for("d")
    let e = digest_for("e")
    match result.unwrap(admit(mut db, s, 1, d)) { Rejected(0) => {}, _ => return false }
    if db.heads[0].head != 0 { return false }
    match result.unwrap(admit(mut db, s, 0, d)) { Admitted(t) => if !mark_is(ticket(t), 1) { return false }, _ => return false }
    if db.heads[0].head != 1 || stream_now(db, s) != (0u64, 1u64) { return false }
    // S7: latest + 1 over an unreplied latest commits nothing.
    match result.unwrap(admit(mut db, s, 1, d)) { Rejected(0) => {}, _ => return false }
    // AH1: another request at latest mismatches before Abandoned, binds
    // nothing, and the bound request is still Abandoned after it.
    match result.unwrap(admit(mut db, s, 0, e)) { RequestMismatch => {}, _ => return false }
    match result.unwrap(admit(mut db, s, 0, d)) { Abandoned(t) => if !mark_is(ticket(t), 1) { return false }, _ => return false }
    if db.heads[0].head != 1 { return false }
    // The effect and its reply in one commit.
    let replied = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if !missing_is(reply(mut tx, s, 1, list.new()), "reply") { return Error(1) }
        if let Error(_) = put_bytes(mut tx, 1, key_word(1), key_word(11)) { return Error(2) }
        if let Error(_) = reply(mut tx, s, 0, result.unwrap(copied(string.as_bytes("r0")))) { return Error(3) }
        // Ruling 2: position 0 is now Replied, so a second reply is refused.
        if !missing_is(reply(mut tx, s, 0, list.new()), "reply") { return Error(4) }
        Ok(())
    }))
    match take replied { Committed(_) => {}, _ => return false }
    if db.heads[0].head != 2 || stream_now(db, s) != (0u64, 2u64) || !stream_reply_is(db, s, string.as_bytes("r0")) { return false }
    match std.omap.get(db.heads[0].roots.data, result.unwrap(physical(1, key_word(1)))) { Some(v) => if decode_word(v) != 11 { return false }, None => return false }
    // The reply keeps d: e still mismatches, before Duplicate, and d's
    // Duplicate follows it.
    match result.unwrap(admit(mut db, s, 0, e)) { RequestMismatch => {}, _ => return false }
    match result.unwrap(admit(mut db, s, 0, d)) { Duplicate(r) => if r.reply != string.as_bytes("r0") { return false }, _ => return false }
    if db.heads[0].head != 2 { return false }
    match result.unwrap(admit(mut db, s, 1, d)) { Admitted(t) => if !mark_is(ticket(t), 3) { return false }, _ => return false }
    // F2: a body that replies and returns Error keeps the reply alone.
    let kept = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if let Error(_) = put_bytes(mut tx, 1, key_word(2), key_word(22)) { return Error(1) }
        if let Error(_) = reply(mut tx, s, 1, result.unwrap(copied(string.as_bytes("r1")))) { return Error(2) }
        // A 95-byte reply frame plus the 5-byte data head and one 29-byte put.
        if tx_frame(tx) != 129 { return Error(3) }
        Error(7)
    }))
    match take kept {
        Aborted(Undone(value: 7, ticket: Some(t))) => if !mark_is(t, 4) { return false },
        _ => return false
    }
    if db.heads[0].head != 4 || stream_now(db, s) != (1u64, 2u64) || !stream_reply_is(db, s, string.as_bytes("r1")) { return false }
    if let Some(_) = std.omap.get(db.heads[0].roots.data, result.unwrap(physical(1, key_word(2)))) { return false }
    match result.unwrap(admit(mut db, s, 2, d)) { Admitted(t) => if !mark_is(ticket(t), 5) { return false }, _ => return false }
    // Aborted without a reply, Failed and Refused keep nothing; each later
    // admit of 2 is Abandoned with the commit_ticket of 5 and commits nothing.
    let dropped = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if let Error(_) = put_bytes(mut tx, 1, key_word(3), key_word(33)) { return Error(1) }
        Error(8)
    }))
    match take dropped { Aborted(Undone(value: 8, ticket: None)) => {}, _ => return false }
    match result.unwrap(admit(mut db, s, 2, d)) { Abandoned(t) => if !mark_is(ticket(t), 5) { return false }, _ => return false }
    let faulted = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if let Error(_) = reply(mut tx, s, 2, list.new()) { return Error(1) }
        fail("L13 injected fault")
    }))
    match take faulted { Failed(_) => {}, _ => return false }
    match result.unwrap(admit(mut db, s, 2, d)) { Abandoned(t) => if !mark_is(ticket(t), 5) { return false }, _ => return false }
    // An 8-byte reply grows the stored row's value from 41 to 49 bytes, past
    // the admitted row's 48. A ceiling below the current resident therefore
    // refuses it on both exits.
    let ceiling = db.ceiling
    db.ceiling = db.resident - 1
    let over = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if let Error(_) = reply(mut tx, s, 2, key_word(9)) { return Error(1) }
        Ok(())
    }))
    match take over { Refused(_) => {}, _ => return false }
    let over_abort = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if let Error(_) = reply(mut tx, s, 2, key_word(9)) { return Error(1) }
        Error(9)
    }))
    match take over_abort { Refused(_) => {}, _ => return false }
    // Ruling 3: an admit over the bound is Full and binds nothing.
    match admit(mut db, string.as_bytes("u"), 0, e) { Error(Full(_)) => {}, _ => return false }
    db.ceiling = ceiling
    match result.unwrap(admit(mut db, s, 2, d)) { Abandoned(t) => if !mark_is(ticket(t), 5) { return false }, _ => return false }
    if db.heads[0].head != 5 || stream_now(db, s) != (2u64, 1u64) { return false }
    // AH2: below latest there is no digest to compare, whatever the bytes.
    for (p, x) in [(1u64, d), (1u64, e), (0u64, d)] {
        match result.unwrap(admit(mut db, s, p, x)) { HistoryUnavailable => {}, _ => return false }
    }
    for p in [3u64, 5u64] {
        match result.unwrap(admit(mut db, s, p, d)) { Rejected(2) => {}, _ => return false }
    }
    if db.heads[0].head != 5 { return false }
    // Recording checks the admission, revision, and one-CALL-per-frame rule.
    let unadmitted = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if !missing_is(reply(mut tx, string.as_bytes("t"), 0, list.new()), "reply") { return Error(1) }
        if !missing_is(reply_recorded(mut tx, 3, list.new(), call_for(s, 32)), "reply") { return Error(2) }
        if !missing_is(reply_recorded(mut tx, 2, list.new(), call_for(s, 31)), "revision") { return Error(3) }
        if let Error(_) = reply_recorded(mut tx, 2, result.unwrap(copied(string.as_bytes("r2"))), call_for(s, 32)) { return Error(4) }
        match reply_recorded(mut tx, 2, list.new(), call_for(s, 32)) { Error(Exists(n)) => if n != "call" { return Error(5) }, _ => return Error(6) }
        Ok(())
    }))
    match take unadmitted { Committed(_) => {}, _ => return false }
    if db.heads[0].head != 6 { return false }
    match result.unwrap(admit(mut db, s, 3, d)) { Admitted(t) => if !mark_is(ticket(t), 7) { return false }, _ => return false }
    // L29 by section 2.4: head 16, call info 21, streams section 5 + op
    // (1 + 4 + 1 + 4 + 43) = 58, so 95 with no data section. The CALL
    // is 151 B (tag, five blobs of sizes 32, 16, 1, 32 and 48, and the
    // settle byte). A 12-byte key and 8-byte value add 34 B for data.
    let sized = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), u64] {
        if let Error(_) = reply_recorded(mut tx, 3, result.unwrap(copied(string.as_bytes("ab"))), call_for(s, 32)) { return Error(1) }
        let ci = info(mut tx)
        let one = list.len(result.unwrap(encode_sections(ci, tx.ops, tx.stream_ops, None, 1, 72)))
        if one != 95 { return Error(2) }
        let two = list.len(result.unwrap(encode_sections(ci, tx.ops, tx.stream_ops, tx.call, 1, 72)))
        if tx_frame(tx) != 246 || two != 246 { return Error(4) }
        if let Error(_) = put_bytes(mut tx, 1, key_word(4), key_word(44)) { return Error(5) }
        let three = list.len(result.unwrap(encode_sections(ci, tx.ops, tx.stream_ops, tx.call, 1, 72)))
        if tx_frame(tx) != 280 || three != 280 { return Error(6) }
        Ok(())
    }))
    match take sized { Committed(_) => {}, _ => return false }
    // The Full admit of e at u bound nothing: d admits there.
    match result.unwrap(admit(mut db, string.as_bytes("u"), 0, d)) { Admitted(_) => true, _ => false }
}

// G1: a refused run leaves the version and rows unchanged. Readmission
// of the same position finds the original admit, with no saved reply.
fn refused_reply(c: Clock, oversized: bool) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let stream = string.as_bytes("s")
    let digest = digest_for("request")
    match result.unwrap(admit(mut db, stream, 0, digest)) {
        Admitted(t) => if !mark_is(ticket(t), 1) { return false },
        _ => return false
    }
    let attempted = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        if oversized {
            // Section 2.4: 26 + 16*21 + 15*1048576 + 1048086
            // leaves 192 bytes for the streams and CALL sections.
            for k in 1u64 .. 17 {
                let size = if k == 16 { 1048086u64 } else { 1048576u64 }
                let mut v: Bytes = capacity(list.with_capacity(size))?
                capacity(list.fill(mut v, size, 0u8))?
                put_bytes(mut tx, 1, key_word(k), v)?
            }
        } else {
            put_bytes(mut tx, 1, key_word(1), key_word(10))?
        }
        let mut call = call_for(stream, if oversized { 32u64 } else { 31u64 })
        if oversized {
            capacity(list.fill(mut call.args, 1024, 0u8))?
        }
        reply_recorded(mut tx, 0, copied(string.as_bytes("success"))?, take call)
    }))
    match take attempted {
        Aborted(Undone(value: Limit(Transaction), ticket: None)) => if !oversized { return false },
        Aborted(Undone(value: Missing(what), ticket: None)) => if oversized || what != "revision" { return false },
        _ => return false
    }
    let head = snapshot(db)
    if version(head) != 1 { return false }
    if let Some(_) = result.unwrap(get_bytes(head, 1, key_word(1))) { return false }
    match result.unwrap(admit(mut db, stream, 0, digest)) {
        Abandoned(t) => if !mark_is(ticket(t), 1) { return false },
        _ => return false
    }
    if oversized { return true }
    // A runner refusal also discards an already staged reply and CALL.
    let rejected = result.unwrap(run_with_reply(mut db, None, fn(_error: Error) -> bool { false }, fn(mut tx: Tx) -> Result[(), Error] {
        reply_recorded(mut tx, 0, copied(string.as_bytes("success"))?, call_for(stream, 32))?
        Error(Limit(Transaction))
    }))
    match take rejected { Aborted(Undone(value: Limit(Transaction), ticket: None)) => {}, _ => return false }
    if version(snapshot(db)) != 1 { return false }
    match result.unwrap(admit(mut db, stream, 0, digest)) {
        Abandoned(t) => mark_is(ticket(t), 1),
        _ => false
    }
}

pub fn law_refused_reply(c: Clock) -> bool waits {
    let frame = refused_reply(c, true)
    let revision = refused_reply(c, false)
    frame && revision
}

@test
fn test_refused_reply(c: Clock) -> Result[(), ()] waits {
    if law_refused_reply(c) { Ok(()) } else { Error(()) }
}

fn digest_hex(d: RequestDigest, hex: String) -> bool {
    let alphabet = string.as_bytes("0123456789abcdef")
    let want = string.as_bytes(hex)
    for i in 0u64 .. 32 {
        if alphabet[int.widen(d.b[i] >> 4)] != want[i * 2] || alphabet[int.widen(d.b[i] & 15)] != want[i * 2 + 1] {
            return false
        }
    }
    true
}

// L35: STORE-SPEC v2.24's vectors, RUN by Python hashlib (l35-digest-
// vectors.py). Wrong implementations caught: no tag or lengths (no_framing:
// both values differ, and a byte moved from key to args hashes the same);
// big-endian lengths; xxh3 as the identity (xxh3_identity).
pub fn law_request_digest() -> bool {
    let mut key: Bytes = result.unwrap(list.with_capacity(32))
    for i in 0u8 .. 32u8 {
        result.unwrap(list.push(mut key, i))
    }
    let args: Bytes = result.unwrap(b"\x01\x02\x03")
    let empty: Bytes = list.new()
    if !digest_hex(request_digest(key, args), "172630b31e7cd5050e8c06447738d3002e79578c1bb18836380fa604eb1c2135") ||
        !digest_hex(request_digest(key, empty), "2b8d69847b046143da891fdb319ab0fb26033ef1b8116ff0e61e544adceb307b") {
        return false
    }
    let mut changed = result.unwrap(copied(key))
    changed[5] = 0xff
    let short = list.slice(key, 0, 31)
    let moved: Bytes = result.unwrap(b"\x1f\x01\x02\x03")
    request_digest(changed, args) != request_digest(key, args) && request_digest(short, moved) != request_digest(key, args)
}

@test
fn test_request_digest() -> Result[(), ()] {
    if law_request_digest() { Ok(()) } else { Error(()) }
}


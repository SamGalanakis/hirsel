// J1: finish collecting the lookup before writing the Tx it borrows.
pub fn rejected(mut db: store.Db, t: store.Table[u64, u64], ix: store.Index[u64, u64, u64]) -> bool waits {
    let answer = store.run(mut db, fn(mut tx: store.Tx) -> Result[(), store.Error] {
        let mut rows = store.lookup(tx, ix, Unbounded, Unbounded)?
        store.put(mut tx, t, 1, 2)?
        let _ = store.next_indexed(mut rows)?
        Ok(())
    })
    false
}

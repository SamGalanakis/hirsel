// XXH3-64, seed zero and the default secret. Recurrence adapted from
// xxhash-rust 0.8.15 const_xxh3.rs and xxh3_common.rs; the streaming state keeps
// the final stripe separately so add never needs to retain its input.
const SECRET: Inline[u8, 192] =[0xb8, 0xfe, 0x6c, 0x39, 0x23, 0xa4, 0x4b, 0xbe, 0x7c, 0x01, 0x81, 0x2c, 0xf7, 0x21, 0xad, 0x1c, 0xde, 0xd4, 0x6d, 0xe9, 0x83, 0x90, 0x97, 0xdb, 0x72, 0x40, 0xa4, 0xa4, 0xb7, 0xb3, 0x67, 0x1f, 0xcb, 0x79, 0xe6, 0x4e, 0xcc, 0xc0, 0xe5, 0x78, 0x82, 0x5a, 0xd0, 0x7d, 0xcc, 0xff, 0x72, 0x21, 0xb8, 0x08, 0x46, 0x74, 0xf7, 0x43, 0x24, 0x8e, 0xe0, 0x35, 0x90, 0xe6, 0x81, 0x3a, 0x26, 0x4c, 0x3c, 0x28, 0x52, 0xbb, 0x91, 0xc3, 0x00, 0xcb, 0x88, 0xd0, 0x65, 0x8b, 0x1b, 0x53, 0x2e, 0xa3, 0x71, 0x64, 0x48, 0x97, 0xa2, 0x0d, 0xf9, 0x4e, 0x38, 0x19, 0xef, 0x46, 0xa9, 0xde, 0xac, 0xd8, 0xa8, 0xfa, 0x76, 0x3f, 0xe3, 0x9c, 0x34, 0x3f, 0xf9, 0xdc, 0xbb, 0xc7, 0xc7, 0x0b, 0x4f, 0x1d, 0x8a, 0x51, 0xe0, 0x4b, 0xcd, 0xb4, 0x59, 0x31, 0xc8, 0x9f, 0x7e, 0xc9, 0xd9, 0x78, 0x73, 0x64, 0xea, 0xc5, 0xac, 0x83, 0x34, 0xd3, 0xeb, 0xc3, 0xc5, 0x81, 0xa0, 0xff, 0xfa, 0x13, 0x63, 0xeb, 0x17, 0x0d, 0xdd, 0x51, 0xb7, 0xf0, 0xda, 0x49, 0xd3, 0x16, 0x55, 0x26, 0x29, 0xd4, 0x68, 0x9e, 0x2b, 0x16, 0xbe, 0x58, 0x7d, 0x47, 0xa1, 0xfc, 0x8f, 0xf8, 0xb8, 0xd1, 0x7a, 0xd0, 0x31, 0xce, 0x45, 0xcb, 0x3a, 0x8f, 0x95, 0x16, 0x04, 0x28, 0xaf, 0xd7, 0xfb, 0xca, 0xbb, 0x4b, 0x40, 0x7e]

pub opaque type Xxh3 {
    total: u64,
    stripes: u64,
    pending_len: u64,
    tail_len: u64,
    short: Inline[u8, 256],
    pending: Inline[u8, 64],
    tail: Inline[u8, 64],
    acc: Inline[u64, 8]
}

pub fn start() -> Xxh3 {
    Xxh3(total: 0, stripes: 0, pending_len: 0, tail_len: 0, short:[0; 256], pending:[0; 64], tail:[0; 64], acc: initial_acc())
}

fn secret(at: u64) -> u64 {
    inline.word_le(SECRET, at)
}

fn advance(mut acc: Inline[u64, 8], stripes: u64, count: u64) -> u64 {
    let complete = stripes + count
    if complete == 16 {
        for i in 0u64 .. 8 {
            let x = acc[i] ^ (acc[i] >> 47) ^ secret(128 + i * 8)
            acc[i] = int.wrapping_mul(x, 0x9E3779B1u64)
        }
        return 0
    }
    complete
}

fn buffered_stripe(mut s: Xxh3) {
    check.xxh3_stripe(mut s.acc, s.pending, SECRET, s.stripes * 8)
    s.stripes = advance(mut s.acc, s.stripes, 1)
    s.pending_len = 0
}

// Leave the final, possibly overlapping stripe for finish.
fn full_stripes(mut acc: Inline[u64, 8], b: Bytes, at: u64, stripes: u64) -> (u64, u64) {
    let n = list.len(b)
    let mut next = at
    let mut stripe = stripes
    while n - next > 64 {
        let remaining = (n - next - 1) / 64
        let room = 16 - stripe
        let count = if remaining < room {
            remaining
        } else {
            room
        }
        let end = next + count * 64
        check.xxh3_stripes(mut acc, list.slice(b, next, end), SECRET, stripe * 8)
        stripe = advance(mut acc, stripe, count)
        next = end
    }
    (next, stripe)
}

/// Append b[lo,hi); bounds have the same checked semantics as list.slice.
/// No allocation; retains no view of b. Empty ranges do nothing.
pub fn add(mut s: Xxh3, b: Bytes, lo: u64, hi: u64) {
    let chunk = list.slice(b, lo, hi)
    let n = list.len(chunk)
    if n == 0 {
        return
    }
    if s.total < 240 {
        let count = if n < 240 - s.total {
            n
        } else {
            240 - s.total
        }
        for i in 0u64 .. count {
            s.short[s.total + i] = chunk[i]
        }
    }
    if n >= 64 {
        for i in 0u64 .. 64 {
            s.tail[i] = chunk[n - 64 + i]
        }
        s.tail_len = 64
    } else {
        let keep = if s.tail_len < 64 - n {
            s.tail_len
        } else {
            64 - n
        }
        inline.copy_within(mut s.tail, s.tail_len - keep, 0, keep)
        for i in 0u64 .. n {
            s.tail[keep + i] = chunk[i]
        }
        s.tail_len = keep + n
    }
    s.total = int.wrapping_add(s.total, n)
    let mut at: u64 = 0
    if s.pending_len > 0 {
        let room = 64 - s.pending_len
        let count = if n < room {
            n
        } else {
            room
        }
        for i in 0u64 .. count {
            s.pending[s.pending_len + i] = chunk[i]
        }
        s.pending_len += count
        at = count
        if at == n {
            return
        }
        buffered_stripe(mut s)
    }
    let (end, stripe) = full_stripes(mut s.acc, chunk, at, s.stripes)
    s.stripes = stripe
    at = end
    s.pending_len = n - at
    for i in 0u64 .. s.pending_len {
        s.pending[i] = chunk[at + i]
    }
}

fn fold(a: u64, b: u64) -> u64 {
    let (hi, lo) = int.mul_wide(a, b)
    hi ^ lo
}

fn avalanche(x: u64) -> u64 {
    let z = int.wrapping_mul(x ^ (x >> 37), 0x165667919E3779F9u64)
    z ^ (z >> 32)
}

fn merge(acc: Inline[u64, 8], n: u64) -> u64 {
    let mut sum = int.wrapping_mul(n, 0x9E3779B185EBCA87u64)
    for i in 0u64 .. 4 {
        sum = int.wrapping_add(sum, fold(acc[i * 2] ^ secret(11 + i * 16), acc[i * 2 + 1] ^ secret(19 + i * 16)))
    }
    avalanche(sum)
}

/// Digest of all ranges added so far. Leaves s usable for further add calls.
/// No allocation and no state change.
pub fn finish(s: Xxh3) -> u64 {
    if s.total <= 240 {
        return check.xxh3_short_inline(s.short, s.total)
    }
    let mut acc = s.acc
    check.xxh3_stripe(mut acc, s.tail, SECRET, 121)
    merge(acc, s.total)
}

fn initial_acc() -> Inline[u64, 8] {
    [0xC2B2AE3Du64, 0x9E3779B185EBCA87u64, 0xC2B2AE3D27D4EB4Fu64, 0x165667B19E3779F9u64, 0x85EBCA77C2B2AE63u64, 0x85EBCA77u64, 0x27D4EB2F165667C5u64, 0x9E3779B1u64]
}

/// XXH3-64 with seed zero and the default secret over b[lo,hi). No allocation.
pub fn xxh3(b: Bytes, lo: u64, hi: u64) -> u64 {
    let chunk = list.slice(b, lo, hi)
    let n = list.len(chunk)
    if n <= 240 {
        return check.xxh3_short(chunk)
    }
    let mut acc = initial_acc()
    let _ = full_stripes(mut acc, chunk, 0, 0)
    check.xxh3_stripes(mut acc, list.slice(chunk, n - 64, n), SECRET, 121)
    merge(acc, n)
}

fn locate_page_cut(mut page_record: manifest.PageManifest, layout: manifest.PagedCutLayout, roots: List[pages.PageRoots], next_stamp: u64, account: u64) {
    for slot in 0u64 .. list.len(page_record.branches) {
        page_record.branches[slot].roots = manifest.published_page_roots(layout.locations, roots[slot])
    }
    let branch_count = list.len(page_record.branches)
    for slot in 0u64 .. list.len(page_record.pins) {
        page_record.pins[slot].roots = manifest.published_page_roots(layout.locations, roots[branch_count + slot])
    }
    page_record.pack_root = manifest.published_tree_pointer(layout.locations, layout.lists.roots.packs)
    page_record.next_pack = layout.lists.run_packs.next_pack
    page_record.next_stamp = next_stamp
    page_record.account_memory = account
}

// L51(l). The two independent pack vectors each contain one frame.
// The hand-laid MANIFEST gives the stream holder and the pack-list root.
fn law_generation_locations(known: manifest.PageLocations) -> bool {
    if manifest.disk_index_len(known.frames) != 2 || manifest.disk_index_len(known.packs) != 2 {
        return false
    }
    for seq in 1u64 .. 3 {
        let raw = if seq == 1 {
            manifest.page_data_pack_vector()
        } else {
            page_list_pack_vector()
        }
        let width = format.read_le(raw, 76, 4)
        let stamp = format.read_le(raw, 96, 8)
        let class = if seq == 1 {
            0u8
        } else {
            2u8
        }
        let owner: manifest.IncomingEdge = if seq == 1 {
            HolderSource(0, 0, 1)
        } else {
            ListSource(0)
        }
        let Some(frame) = manifest.disk_index_get(known.frames, stamp) else {
            return false
        }
        let Some(physical) = manifest.disk_index_get(known.packs, seq) else {
            return false
        }
        let payload_width: u64 = int.widen(frame.place.len)
        if frame.place.pack != seq || frame.place.offset != 72 || payload_width != width || frame.place.checksum != std.check.xxh3(raw, 88, 88 + width) || frame.class != class || list.len(frame.outgoing) != 0 || list.len(frame.incoming) != 1 || frame.incoming[0u64] != owner || physical.class != class || physical.frames != 1 || physical.live != width || physical.payload_bytes != width {
            return false
        }
    }
    true
}

fn check_paged_generation(d: Dir) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let id = StoreId(hi: 1, lo: 2)
    let mut roots = pages.empty_roots()
    let mut key: Bytes = list.with_capacity(1)
    list.push(mut key, 16u8)
    let mut next_stamp = 1u64
    failure_result_from_rep(pages.put_page_row(mut roots.streams, key, string.as_bytes("x"), 1, mut next_stamp))?
    let mut holders: List[manifest.HeldPage] = list.with_capacity(1)
    list.push(mut holders, manifest.HeldPage(source: HolderSource(0, 0, 1), root: arc.share(roots.streams.root)))
    let mut all: List[pages.PageRoots] = list.with_capacity(1)
    list.push(mut all, take roots)
    let base = failure_result_from_rep(manifest.page_retry_base(manifest.new_page_locations(), map.new(), holders, all))?
    let installed = manifest.empty_paged_lists()
    let mut page_record = manifest.page_manifest_empty(limits_to_rep(default_limits()))
    let carried: List[u64] = list.new()
    let cut_plan = plan_page_cut(base, holders, installed, manifest.no_cut_queue(), manifest.empty_lineage(), Some(view carried), 1, 512, map.new(), None, mut next_stamp)?
    let mut buffers = failure_result_from_rep(manifest.cut_output_buffers(cut_plan, manifest.page_manifest_file_size(manifest.page_manifest_size(page_record), page_record.fence), manifest.page_manifest_file_size(manifest.MANIFEST_LIMIT, 1)))?
    let layout = failure_result_from_rep(manifest.write_page_cut(directory, store_key_to_rep(id), take cut_plan, mut buffers))?
    page_record.generation = 2
    locate_page_cut(mut page_record, layout, all, next_stamp, base.account)
    publish_page_manifest(directory, id, page_record, None, mut buffers.out)?
    // Both pack vectors were assembled independently from AP3, AP14 and
    // the frame checksum binding. The persisted account is one 78-byte row.
    if failure_result_from_rep(manifest.disk_read_paged_file(directory, "p-1", 121))? != manifest.page_data_pack_vector() || failure_result_from_rep(manifest.disk_read_paged_file(directory, "p-2", 156))? != page_list_pack_vector() {
        return Error(Foreign)
    }
    if !law_generation_locations(layout.locations) {
        return Error(Foreign)
    }
    let (_, take selected) = read_selected_page_manifest(directory)?
    let loaded = failure_result_from_rep(history.rebuild_page_store(take selected, None))?
    if loaded.manifest.generation != 2 || loaded.manifest.next_pack != 3 || loaded.manifest.account_memory != 78 || list.len(loaded.holders) != 1 || pages.one_page_account(loaded.holders[0u64]) != 78 || !law_generation_locations(loaded.locations) {
        return Error(Foreign)
    }
    Ok(())
}

pub fn disk_law_paged_generation(d: Dir) -> bool waits {
    match check_paged_generation(d) {
        Ok(()) => true,
        Error(_) => false,
    }
}

@test
fn disk_test_paged_generation(d: Dir) -> Result[(), Error] waits {
    check_paged_generation(d)
}

// Read the byte fields of an AP6 PagePtr and follow it without the Store decoder.
fn law_pointed_payload(d: Dir, raw: Bytes, ptr: u64, limit: u64) -> Result[Bytes, Error] waits {
    let seq = format.read_le(raw, ptr, 8)
    let at = format.read_le(raw, ptr + 8, 8)
    let width = format.read_le(raw, ptr + 16, 4)
    let pack = failure_result_from_rep(manifest.disk_read_paged_file(d, failure_result_from_rep(manifest.paged_pack_path(seq))?, limit))?
    if at < 72 || at + 16 + width > list.len(pack) || format.read_le(pack, at + 4, 4) != width {
        return Error(Foreign)
    }
    failure_result_from_rep(types.copied(list.slice(pack, at + 16, at + 16 + width)))
}

fn law_leaf_cell(raw: Bytes, slot: u64) -> u64 {
    let slots = list.len(raw) - 2 * format.read_le(raw, 2, 2)
    let at = format.read_le(raw, slots + 2 * slot, 2)
    at + 2 + format.read_le(raw, at, 2)
}

// L41(vii). Three equal-sized blobs fit in one pack. Deleting two selects
// the pack for relocation, but the mandatory layout keeps the last blob in it.
fn law_pack_stamp(seed: u64, seq: u64, slot: u64) -> u64 {
    slot * 64 + (seq + seed) % 64 + 1
}

fn check_pack_membership_selection() -> Result[(), Error] {
    let seed = splitmix64(1787) % 64
    let mut installed = manifest.new_page_locations()
    for seq in 1u64 .. 65 {
        let class: u8 = int.truncate(seq % 3)
        let (live_bytes, frames) = match seq {
            11 => (2u64, 8u64),
            29 => (2u64, 8u64),
            52 => (2u64, 8u64),
            17 => (4u64, 8u64),
            37 => (1u64, 1u64),
            47 => (0u64, 8u64),
            _ => (8u64, 8u64),
        }
        failure_result_from_rep(types.capacity(manifest.disk_index_put(mut installed.packs, seq, pages.PagePack(class: class, frames: int.truncate(frames), live: 16 * live_bytes, payload_bytes: 16 * frames, index: 0), manifest.pack_edge_charge)))?
        for slot in 0u64 .. live_bytes {
            let stamp = law_pack_stamp(seed, seq, slot)
            let ptr = std.page.PagePtr(pack: seq, offset: 72 + 32 * slot, len: 16, checksum: stamp, stamp: stamp)
            failure_result_from_rep(manifest.add_location(mut installed, ptr, class, 0, list.new()))?
            failure_result_from_rep(manifest.add_page_source(mut installed, stamp, HolderSource(0, stamp, 0)))?
        }
    }
    let data = manifest.law_full_frame_selection(installed, false)
    let lists = manifest.law_full_frame_selection(installed, true)
    if list.len(data) != 2 || list.len(lists) != 4 || manifest.moved_frames(installed, false) != data || manifest.moved_frames(installed, true) != lists {
        return Error(Foreign)
    }
    let mut candidate = manifest.share_page_locations(installed)
    let moved = law_pack_stamp(seed, 52, 0)
    let first = law_pack_stamp(seed, 55, 0)
    let second = law_pack_stamp(seed, 55, 1)
    let mut layout_frames: List[manifest.PackFrame] = list.with_capacity(3)
    for stamp in[moved, first, second] {
        list.push(mut layout_frames, manifest.PackFrame(stamp: stamp, size: 16, body: BlobBody(arc.new(list.new()))))
    }
    let layout = failure_result_from_rep(manifest.layout_packs(take layout_frames, 1, 65, 4096))?
    failure_result_from_rep(manifest.apply_pack_layout(mut candidate, layout))?
    for stamp in[first, second, law_pack_stamp(seed, 11, 0)] {
        failure_result_from_rep(manifest.remove_page_source(mut candidate, stamp, HolderSource(0, stamp, 0)))?
    }
    if manifest.moved_frames(candidate, false) != manifest.law_full_frame_selection(candidate, false) || manifest.moved_frames(candidate, true) != manifest.law_full_frame_selection(candidate, true) || manifest.moved_frames(installed, false) != data || manifest.moved_frames(installed, true) != lists || manifest.disk_index_len(candidate.members) != manifest.disk_index_len(candidate.frames) || manifest.location_storage_charge(candidate) != manifest.scan_location_storage_charge(candidate) {
        return Error(Foreign)
    }
    Ok(())
}

// L41(vii). Three equal-sized blobs fit in one pack. Deleting two selects
// the pack for relocation, but the mandatory layout keeps the last blob in it.
@test
fn disk_test_relocation_late_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    check_pack_membership_selection()?
    let directory = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 4096
    let mut db = open(tasks, directory, c, r, options)?
    let codec = std.codec.of_bytes()
    let _ = law_table(mut db, "values", std.codec.key_u64(), codec)?
    let t = table(mut db, "values", std.codec.key_u64(), codec)?
    let old_blob_pack = manifest.pack_next(disk_state(db).packs)
    let initial = run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        for k in 1u64 .. 4 {
            let mut value: Bytes = list.with_capacity(1024)
            list.fill(mut value, 1024, int.truncate(k))
            put(mut tx, call_env, k, value)?
        }
        Ok(())
    })?
    if let Committed(_) = initial {} else {
        return Error(Foreign)
    }
    let _ = checkpoint(mut db)?
    let (_, take old) = read_page_manifest_file(directory)?
    let old_name = failure_result_from_rep(manifest.paged_pack_path(old_blob_pack))?
    let original = failure_result_from_rep(manifest.disk_read_paged_file(directory, old_name, 4096))?
    let payload = 1038u64 // 8 stamp bytes, 6 codec bytes and 1024 value bytes.
    if list.len(original) != 72 + 3 * (16 + payload) {
        return Error(Foreign)
    }
    let edited = run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        let _ = delete(mut tx, call_env, 2)?
        let _ = delete(mut tx, call_env, 3)?
        Ok(())
    })?
    if let Committed(_) = edited {} else {
        return Error(Foreign)
    }
    let first_path = failure_result_from_rep(manifest.paged_pack_path(old.next_pack))?
    let refused_watermarks: core.Log[u64] = log.new()
    let _ = disk_cut_state(mut db, NoHolderChange, scoped fn(mut raw: Bytes, context: format.DiskContext, fence: u32) -> Result[(), Error] waits {
        let first = failure_result_from_rep(manifest.disk_read_paged_file(directory, first_path, 4096))?
        if format.read_le(first, 72, 2) == 0x0022 {
            // The optional blob has already been renamed. Cap the real
            // MANIFEST checksum allocation for this layout only.
            log.append(refused_watermarks, format.read_le(raw, 112, 8))
            let refused = bound bytes 0 {
                seal_page_manifest_file(mut raw, context, fence)
            }
            match take refused {
                Ok(Error(Full(Allocation(problem)))) => return Error(Full(Allocation(problem))),
                _ => return Error(Foreign),
            }
        }
        seal_page_manifest_file(mut raw, context, fence)
    })?
    let watermarks = log.finish(take refused_watermarks)
    if list.len(watermarks) != 1 {
        return Error(Foreign)
    }
    close(take db)?
    let raw = failure_result_from_rep(manifest.disk_read_paged_file(directory, "MANIFEST", 471))?
    let (id, take published) = read_page_manifest_file(directory)?
    if published.generation != old.generation + 1 || published.first_live != old.first_live + 1 || published.branches[0u64].version != old.branches[0u64].version + 1 || published.pack_root.stamp < watermarks[0u64] || published.next_stamp <= published.pack_root.stamp {
        return Error(Foreign)
    }
    let replacement = failure_result_from_rep(manifest.disk_read_paged_file(directory, first_path, 4096))?
    if format.read_le(replacement, 72, 2) != 0x0021 || failure_result_from_rep(manifest.disk_read_paged_file(directory, old_name, 4096))? != original {
        return Error(Foreign)
    }
    let collection_map = law_pointed_payload(directory, raw, 358, 4096)?
    let values = law_pointed_payload(directory, collection_map, law_leaf_cell(collection_map, 0) + 3, 4096)?
    let cell = law_leaf_cell(values, 0)
    if format.read_le(values, 2, 2) != 1 || values[cell] != 1 || format.read_le(values, cell + 25, 8) != old_blob_pack {
        return Error(Foreign)
    }
    let checked = validate_page_manifest(directory, id, take published)?
    let Some(blob_pack) = map.get(checked.inventory, old_blob_pack) else {
        return Error(Foreign)
    }
    if blob_pack.class != 1 || blob_pack.frames != 3 || blob_pack.live != payload || blob_pack.payload_bytes != 3 * payload {
        return Error(Foreign)
    }
    let reopened = open(tasks, directory, c, r, options)?
    {
        let disk = disk_state(reopened)
        let known = manifest.pack_locations(disk.packs)
        let old_stamp = format.read_le(original, 88, 8)
        if std.omap.get(known.members.values, (old_blob_pack, old_stamp)) == None || manifest.moved_frames(known, false) != manifest.law_full_frame_selection(known, false) || manifest.disk_index_len(known.members) != manifest.disk_index_len(known.frames) {
            return Error(Foreign)
        }
    }
    let held = snapshot(reopened)
    let sh = view t
    let Some(value) = get(result.unwrap(reader(reopened, 0u64)), held, sh, 1)? else {
        return Error(Foreign)
    }
    if list.len(value) != 1024 || value[0u64] != 1 || get(result.unwrap(reader(reopened, 0u64)), held, sh, 2)? != None || get(result.unwrap(reader(reopened, 0u64)), held, sh, 3)? != None {
        return Error(Foreign)
    }
    close(take reopened)
}

fn check_blob_threshold(d: Dir, c: Clock, r: Random, tasks: Tasks, cutoff: u64) -> Result[(), Error] waits {
    let mut options = journal_crash_options()
    let original = open(tasks, d, c, r, options)?
    let id = identity(original)
    close(take original)?
    if cutoff != 1024 {
        // AP14 places inline 16 bytes into the MANIFEST payload. Bind the
        // hand-edited genesis payload to the same frame at byte 72.
        let mut genesis = failure_result_from_rep(manifest.disk_read_paged_file(d, "MANIFEST", 471))?
        let width: u32 = int.truncate(cutoff)
        list.set_word_le(mut genesis, 104, width)
        let digest = failure_result_from_rep(types.capacity(format.disk_check(format.DiskContext(store: store_key_to_rep(id), role: 1, seq: 1), 72, list.slice(genesis, 72, 80), list.slice(genesis, 88, 471))))?
        list.set_word_le(mut genesis, 80, digest)
        failure_result_from_rep(manifest.disk_write_synced(d, "MANIFEST", genesis))?
    }
    options.create = false
    let codec = std.codec.of_bytes()
    let mut db = open(tasks, d, c, r, options)?
    let _ = law_table(mut db, "values", std.codec.key_u64(), codec)?
    let shape_table = table(mut db, "values", std.codec.key_u64(), codec)?
    let mut inline_value: Bytes = list.with_capacity(cutoff - 6)
    list.fill(mut inline_value, cutoff - 6, 13u8)
    let mut blob_value: Bytes = list.with_capacity(cutoff - 5)
    list.fill(mut blob_value, cutoff - 5, 23u8)
    let finished = run(mut db, None, (copy_env(shape_table), copy_env(inline_value), copy_env(blob_value)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.0, 1, call_env.1)?
        put(mut tx, call_env.0, 2, call_env.2)
    })?
    if let Committed(_) = finished {} else {
        return Error(Foreign)
    }
    let _ = checkpoint(mut db)?
    close(take db)?
    let page_record = failure_result_from_rep(manifest.disk_read_paged_file(d, "MANIFEST", 471))?
    if format.read_le(page_record, 104, 4) != cutoff {
        return Error(Foreign)
    }
    // One main branch, named main. Its collections pointer starts at 358.
    let collection_map = law_pointed_payload(d, page_record, 358, 4096)?
    let descriptor = law_leaf_cell(collection_map, 0) + 3
    let values = law_pointed_payload(d, collection_map, descriptor, 4096)?
    let a = law_leaf_cell(values, 0)
    let b = law_leaf_cell(values, 1)
    if values[a] != 0 || format.read_le(values, a + 1, 2) != cutoff || values[b] != 1 || format.read_le(values, b + 9, 8) != cutoff + 1 {
        return Error(Foreign)
    }
    // BlobRef names the value after an eight-byte stamp in a BLOB frame.
    let blob_pack = format.read_le(values, b + 25, 8)
    let offset = format.read_le(values, b + 33, 8)
    let pack = failure_result_from_rep(manifest.disk_read_paged_file(d, failure_result_from_rep(manifest.paged_pack_path(blob_pack))?, 4096))?
    if offset != 72 || format.read_le(pack, offset, 2) != 0x0022 || format.read_le(pack, offset + 4, 4) != cutoff + 9 || format.read_le(pack, offset + 16, 8) != format.read_le(values, b + 1, 8) || list.len(pack) != 72 + 16 + cutoff + 9 {
        return Error(Foreign)
    }
    // The pack-list leaf marks that pack as class 1, with one frame.
    let listed = law_pointed_payload(d, page_record, 280, 4096)?
    let key_prefix = format.read_le(listed, 4, 2)
    let slots = list.len(listed) - 2 * format.read_le(listed, 2, 2)
    let mut found = false
    for slot in 0u64 .. format.read_le(listed, 2, 2) {
        let at = format.read_le(listed, slots + 2 * slot, 2)
        let width = format.read_le(listed, at, 2)
        let mut key: Bytes = list.with_capacity(8)
        list.append(mut key, list.slice(listed, 24, 24 + key_prefix))
        list.append(mut key, list.slice(listed, at + 2, at + 2 + width))
        let seq: u64 = list.word_be(key, 0)
        if seq == blob_pack {
            let cell = at + 2 + width
            found = listed[cell + 3] == 1 && format.read_le(listed, cell + 4, 4) == 1
        }
    }
    if !found {
        return Error(Foreign)
    }
    let again = open(tasks, d, c, r, options)?
    let held = snapshot(again)
    let sh = view shape_table
    let values_match = get(result.unwrap(reader(again, 0u64)), held, sh, 1)? == Some(clone(inline_value)) && get(result.unwrap(reader(again, 0u64)), held, sh, 2)? == Some(clone(blob_value))
    close(take again)?
    if values_match {
        Ok(())
    } else {
        Error(Foreign)
    }
}

@test
fn disk_test_blob_threshold(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    check_blob_threshold(disk_test_directory(d), c, r, tasks, 1024)?
    check_blob_threshold(disk_test_directory(d), c, r, tasks, 512)
}

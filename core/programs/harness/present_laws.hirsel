// Offline laws for recorded tool presentation, on the laws.hirsel fixtures.

fn seven(mut tx: store.Tx, inv: harness.Invoke) -> Result[harness.Reply, harness.Fault] {
    Ok(Now(string.into_bytes("7")))
}

fn present_p(c: harness.Call, o: harness.Outcome) -> harness.Presented {
    let mut text = string.from("P saw ")
    string.push(mut text, c.id)
    harness.Presented(text: take text, error: false)
}

fn present_q(c: harness.Call, o: harness.Outcome) -> harness.Presented {
    harness.Presented(text: "Q", error: true)
}

fn presenting(q: bool) -> harness.Agent[Grants] {
    let mut a = crash_agent()
    list.push(mut a.tools, harness.inside("seven", "answers 7", "{}", code.describe(seven)))
    a.presenter = Some(if q { code.describe(present_q) } else { code.describe(present_p) })
    a
}

// One advance under `a` whose transaction never commits, then the store is
// closed and reopened: a crash at that boundary.
fn crash_kick(take image: store.Db, dir: Dir, clock: Clock, random: Random, tasks: Tasks, a: harness.Agent[Grants]) -> store.Db waits {
    let mut db = take image
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let w = result.unwrap(wired())
    let crashed = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), harness.Refused] {
        harness.advance(mut tx, h, a, w, Kick)?
        Error(Storage)
    })
    match take crashed { Ok(Aborted(_)) => (), _ => fail("present: the crash committed") }
    result.unwrap(store.close(take db))
    result.unwrap(store.open(tasks, dir, clock, random, runner.triggers.law_options()))
}

fn body_at(db: store.Db, round: u64) -> String {
    let m = harness.provider.Model(dialect: Anthropic, name: "m", max_tokens: 64u64, cache_control: Off)
    match harness.provider.body(m, asked_at(db, 0u64, round)) { Ok(take b) => take b, Error(_) => fail("present: no body") }
}

fn recorded_p(db: store.Db) -> bool {
    match entry_at(db, 2u64) {
        Some(ToolResult(id, Returned(Inline(b)), shown)) => id == "c1" && b == string.into_bytes("7") && shown.text == "P saw c1" && !shown.error,
        _ => false,
    }
}

// Law V1 (ADR 0120: presentation is recorded once): a settled Inside result
// is presented by P in the transaction that appends it. A run whose advances
// crash before committing and then resume under P sends the same request
// body as the uncrashed run, and a release that redeploys with presenter Q
// re-prepares a request whose body is still that one, byte for byte: nothing
// words the outcome again at request time. Oracle: the uncrashed run's body.
pub fn law_presentation_recorded(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> u64 waits {
    let call = harness.Call(id: "c1", name: "seven", args: Inline(string.into_bytes("{}")))
    let mut clean_name = string.with_capacity(32u64)
    let clean_dir = result.unwrap(host.mkdtemp(parent, mut clean_name))
    let mut clean = answered(clean_dir, clock, random, tasks, clone(call))
    kick(mut clean, presenting(false))
    kick(mut clean, presenting(false))
    let b = body_at(clean, 1u64)
    let mut bad = 0u64
    if bad == 0u64 && !recorded_p(clean) { bad = 1u64 }
    // The body carries the recorded words, not a fresh wording of "7".
    if bad == 0u64 && string.find(b, 0u64, "P saw c1") == None { bad = 6u64 }
    let mut crash_name = string.with_capacity(32u64)
    let crash_dir = result.unwrap(host.mkdtemp(parent, mut crash_name))
    let first = crash_kick(answered(crash_dir, clock, random, tasks, clone(call)), crash_dir, clock, random, tasks, presenting(false))
    let mut resumed = take first
    kick(mut resumed, presenting(false))
    let mut crashed = crash_kick(take resumed, crash_dir, clock, random, tasks, presenting(false))
    kick(mut crashed, presenting(false))
    if bad == 0u64 && !recorded_p(crashed) { bad = 2u64 }
    if bad == 0u64 && body_at(crashed, 1u64) != b { bad = 3u64 }
    // The redeploy: round 2 prepares under Q from the same log.
    at_round(mut clean, 2u64)
    kick(mut clean, presenting(true))
    if bad == 0u64 && !recorded_p(clean) { bad = 4u64 }
    if bad == 0u64 && body_at(clean, 2u64) != b { bad = 5u64 }
    result.unwrap(store.close(take clean))
    result.unwrap(store.close(take crashed))
    result.unwrap(std.dir.remove_all(parent, clean_name))
    result.unwrap(std.dir.remove_all(parent, crash_name))
    bad
}

@test
fn test_presentation_recorded(parent: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), u64] waits {
    let bad = law_presentation_recorded(parent, clock, random, tasks)
    if bad == 0u64 { Ok(()) } else { Error(bad) }
}

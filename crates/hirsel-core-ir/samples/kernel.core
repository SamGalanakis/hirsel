  v2: u64 = const 8
  v3: u64 = const 16
  v4: u64 = const 24
  address a0
  address a1
  address a2
  address a3
  v5: ptr = read a0
  v6: u64 = read a1
  v7: u64 = read a2
  v8: u64 = read a3
  address a4
  drop a4 t0
  v9: u64 = const 1
  v10: u64 = add v8, v9
  v11: u64 = rem v10, v7
  store a3, v11
  v12: u64 = sub v6, v9
  store a1, v12
  return
}
fn f4 = n4 g3 {
  slot s0 = t2                         ; d
  addr a0 = s0 byte v0 : ptr
  addr a1 = s0 byte v1 : u64
  addr a2 = s0 byte v2 : u64
  addr a3 = s0 byte v3 : u64
  addr a4 = s0 : t2
b0:
  live s0
  v0: u64 = const 0
  v1: u64 = const 8
  v2: u64 = const 16
  v3: u64 = const 24
  v4: u64 = const 32
  v5: u64 = const 4
  address a0
  address a1
  address a2
  address a3
  address a4
  v6: ptr, v7: u64 = alloc own v4 align 8 charge v4
  store a0, v6
  store a1, v0
  store a2, v5
  store a3, v0
  v8: ptr = pointer a4
  v9: u64 = const 1
  v10: ptr = call f0 g0 (v9)
  call f2 g2 (v8, v10)
  v11: u64 = const 2
  v12: ptr = call f0 g0 (v11)
  call f2 g2 (v8, v12)
  v13: u64 = const 3
  v14: ptr = call f0 g0 (v13)
  call f2 g2 (v8, v14)
  call f3 g1 (v8)
  call f3 g1 (v8)
  v15: u64 = const 4
  v16: ptr = call f0 g0 (v15)
  call f2 g2 (v8, v16)
  v17: u64 = const 5
  v18: ptr = call f0 g0 (v17)

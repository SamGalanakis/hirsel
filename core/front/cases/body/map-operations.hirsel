// expect: run two_run_keys() = 1140
// Map contracts: insertion-order storage, linear probing, replacement, removal,
// regrow/index rebuild, String keys, and the Capacity a refused growth raises.
// expect: run get_after_insert() = 70
// expect: run replace() = 1088
// expect: run remove_reinsert() = 7131711
// expect: run growth() = 93680
// expect: run strings() = 911
// expect: run refused_growth() = 25855 used 32
// expect: run unit_entries() = 17
// expect: run unit_charge() = 6463 used 32
fn get_after_insert() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    map.insert(mut m, 7, 70)
    match map.get(m, 7) {
        Some(v) => v,
        None => 0
    }
}

fn replace() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    map.insert(mut m, 7, 70)
    map.insert(mut m, 7, 99)
    map.insert(mut m, 7, 88)
    match map.get(m, 7) {
        Some(v) => map.len(m) * 1000 + v,
        None => 0
    }
}

fn remove_reinsert() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    map.insert(mut m, 7, 70)
    map.insert(mut m, 11, 110)
    map.insert(mut m, 13, 130)
    map.insert(mut m, 17, 170)
    let removed = option.unwrap(map.remove(mut m, 11))
    let kept: u64 = match map.get(m, 17) {
        Some(v) => v,
        None => 0
    }
    map.insert(mut m, 11, 111)
    let again: u64 = match map.get(m, 11) {
        Some(v) => v,
        None => 0
    }
    if removed != 110 || kept != 170 || again != 111 {
        return 0
    }
    let mut order: u64 = 0
    for (k, v) in m {
        order = order * 100 + k
    }
    order
}

fn growth() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    for i in 0u64 .. 9u64 {
        map.insert(mut m, i, i * 10)
    }
    let mut sum: u64 = 0
    for (k, v) in m {
        sum += k
    }
    let last: u64 = match map.get(m, 8) {
        Some(v) => v,
        None => 0
    }
    map.len(m) * 10000 + sum * 100 + last
}

fn strings() -> u64 {
    let mut m: Map[String, u64] = map.new()
    let mut key: String = string.new()
    string.push(mut key, "route")
    map.insert(mut m, take key, 7)
    map.insert(mut m, "other", 11)
    map.insert(mut m, "route", 9)
    let removed = option.unwrap(map.remove(mut m, "route"))
    let other: u64 = match map.get(m, "other") {
        Some(v) => v,
        None => 0
    }
    if map.len(m) == 1 {
        removed * 100 + other
    } else {
        0
    }
}

fn refused_growth() -> u64 {
    let r = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 383 {
            let mut m: Map[u64, u64] = map.new()
            for i in 0u64 .. 4u64 {
                map.insert(mut m, i, i * 10)
            }
            map.insert(mut m, 4, 40)
            0
        }
    })
    match caught(take r) {
        Some(c) => c.requested * 100 + c.available,
        None => 0
    }
}

fn unit_entries() -> u64 {
    let mut m: Map[(), ()] = map.new()
    map.insert(mut m, (), ())
    map.insert(mut m, (), ())
    if map.len(m) != 1 {
        return 0
    }
    let _ = map.remove(mut m, ())
    match map.get(m, ()) {
        Some(_) => 0,
        None => 17 + map.len(m)
    }
}

fn unit_charge() -> u64 {
    let r = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 63 {
            let mut m: Map[(), ()] = map.new()
            map.insert(mut m, (), ())
            0
        }
    })
    match caught(take r) {
        Some(c) => c.requested * 100 + c.available,
        None => 0
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

fn two_run_keys() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    map.insert(mut m, 1, 10)
    map.insert(mut m, 4, 40)
    map.insert(mut m, 1, 11)
    let mut order: u64 = 0
    for (_, v) in m {
        order = order * 100 + v
    }
    order
}

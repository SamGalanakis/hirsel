// Apache Avro 1.12.0, SchemaNormalization.FP64. Start each entry with its
// byte index and apply eight reflected rounds with polynomial 0xc15d213aa4d7a795.
const FINGERPRINT_TABLE: Inline[u64, 256] = fingerprint_table()

fn fingerprint_table() -> Inline[u64, 256] {
    let mut table: Inline[u64, 256] =[0; 256]
    for i in 0u64 .. 256 {
        let mut entry = i
        for _ in 0u64 .. 8 {
            let polynomial = if entry & 1 == 1 {
                0xc15d213aa4d7a795u64
            } else {
                0
            }
            entry = (entry >> 1) ^ polynomial
        }
        table[i] = entry
    }
    table
}

/// CRC-64-AVRO of schema bytes. One lookup per byte in a 256-entry table. No admission.
pub fn fingerprint(b: Bytes) -> u64 {
    let mut fp: u64 = 0xc15d213aa4d7a795
    for x in b {
        let byte: u64 = int.widen(x)
        fp = (fp >> 8) ^ FINGERPRINT_TABLE[(fp ^ byte) & 255]
    }
    fp
}

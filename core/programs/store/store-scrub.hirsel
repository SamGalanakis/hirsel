// §11.17 scrub. A tour rereads the packs listed at one generation from disk,
// apart from any resident page, and checks every frame envelope. It never
// repairs and never writes.

// The packs a tour may still read. The Db keeps one share; the tour keeps the
// other. A cut that finds its share unique drops it: the tour has ended.
type ScrubLease: shareable + send {
    packs: List[u64]
}

type ScrubPack: send {
    seq: u64,
    class: u8,
    frames: u64,
    payload_bytes: u64
}

type ScrubInput {
    input: JournalInput,
    path: String,
    context: DiskContext,
    checked_pack: PackScan
}

pub opaque type Scrub {
    d: Dir,
    store: StoreId,
    generation: u64,
    next_stamp: u64,
    packs: List[ScrubPack],
    position: u64,
    at: u64,
    open: Option[ScrubInput],
    checked: u64,
    // The generation's frame records: the pointer each reachable frame must
    // match. A persistent share, so taking it copies nothing.
    known: PageLocations,
    lease: Arc[ScrubLease]
}

// generation is the cut whose listed packs the tour reads. checked counts
// the bytes read so far. next is the lowest pack not yet finished, or None
// when the tour is done. faults holds what this step found, at most one per
// pack: a fault ends that pack's tour.
pub type ScrubReport: send {
    generation: u64,
    checked: u64,
    next: Option[u64],
    faults: List[Fault]
}

pub fn begin_scrub(mut db: Db) -> Result[Scrub, Error] {
    healthy(db)?
    if !is_disk(db) {
        return Error(NotFound)
    }
    let next_stamp = stamp_after(db.next_node)?
    let (take packs, take seqs) = disk_allocation(scoped fn() -> Result[(List[ScrubPack], List[u64]), Error] {
        let mut packs: List[ScrubPack] = list.new()
        let mut seqs: List[u64] = list.new()
        let mut cursor = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
        while let Some((seq, pack)) = std.omap.next(mut cursor) {
            list.push(mut packs, ScrubPack(seq: seq, class: pack.class, frames: int.widen(pack.frames), payload_bytes: pack.payload_bytes))
            list.push(mut seqs, seq)
        }
        Ok((take packs, take seqs))
    })?
    let lease = arc.new(ScrubLease(packs: take seqs))
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Result[(), Error] {
        capacity(list.try_reserve(mut state.scrubs, 1))?
        list.push(mut state.scrubs, arc.share(lease))
        Ok(())
    })?
    Ok(Scrub(d: log_directory(db)?, store: db.store, generation: db.checkpointed, next_stamp: next_stamp, packs: take packs, position: 0, at: 0, open: None, checked: 0, known: share_page_locations(disk_state(db).pages.locations), lease: take lease))
}

// Reads at least one frame, then stops once budget bytes are read this step.
pub fn scrub_step(mut tour: Scrub, budget: u64) -> Result[ScrubReport, Error] waits {
    let mut faults: List[Fault] = list.new()
    let mut spent = 0u64
    while tour.position < list.len(tour.packs) && (spent == 0 || spent < budget) {
        match scrub_next(mut tour) {
            Ok(width) => {
                spent += width
            },
            Error(Corrupt(take fault)) => {
                capacity(list.try_reserve(mut faults, 1))?
                list.push(mut faults, take fault)
                scrub_finish_pack(mut tour)?
            },
            Error(Unsupported(kind)) => {
                let path = paged_pack_path(tour.packs[tour.position].seq)?
                capacity(list.try_reserve(mut faults, 1))?
                list.push(mut faults, Fault(file: take path, offset: tour.at, why: Kind(kind)))
                scrub_finish_pack(mut tour)?
            },
            Error(take problem) => return Error(take problem),
        }
    }
    tour.checked = int.saturating_add(tour.checked, spent)
    let pending = if tour.position < list.len(tour.packs) {
        Some(tour.packs[tour.position].seq)
    } else {
        None
    }
    Ok(ScrubReport(generation: tour.generation, checked: tour.checked, next: pending, faults: take faults))
}

fn scrub_finish_pack(mut tour: Scrub) -> Result[(), Error] waits {
    if let Some(take reading) = replace(mut tour.open, None) {
        let ScrubInput(input: take input, ..) = take reading
        let JournalInput(file: take handle, ..) = take input
        disk_io(host.close(take handle))?
    }
    tour.position += 1
    tour.at = 0
    Ok(())
}

// Checks one unit of the current pack: its HEADER, one frame, or its end
// against the pack's record. Returns the bytes read.
fn scrub_next(mut tour: Scrub) -> Result[u64, Error] waits {
    let seq = tour.packs[tour.position].seq
    let class = tour.packs[tour.position].class
    let unopened = match tour.open {
        Some(_) => false,
        None => true
    }
    if unopened {
        let path = paged_pack_path(seq)?
        let opened = disk_io(host.open(tour.d, path, Read))?
        let mut input = journal_input(take opened, false)?
        let header = disk_read_header(path, journal_prefix(mut input, path, 0, 72)?, 3, Some(seq), Some(tour.store))?
        tour.open = Some(ScrubInput(input: take input, path: take path, context: header.context, checked_pack: pack_scan(class, tour.next_stamp)))
        tour.at = 72
        return Ok(72)
    }
    let at = tour.at
    let frames = tour.packs[tour.position].frames
    let payload_bytes = tour.packs[tour.position].payload_bytes
    let checked = match tour.open {
        Some(mut reading) => scrub_frame(mut reading, tour.known, seq, frames, payload_bytes, at),
        None => fail("store: scrub has no open pack"),
    }
    match checked? {
        Some(end) => {
            tour.at = end
            Ok(end - at)
        },
        None => {
            scrub_finish_pack(mut tour)?
            Ok(0)
        },
    }
}

// None is the pack's end, after its frame count and payload bytes match the
// record the generation listed.
fn scrub_frame(mut reading: ScrubInput, known: PageLocations, seq: u64, frames: u64, payload_bytes: u64, at: u64) -> Result[Option[u64], Error] waits {
    if at >= reading.input.size {
        if reading.checked_pack.frames != frames || reading.checked_pack.payload_bytes != payload_bytes {
            return Error(disk_fault(reading.path, at, Malformed))
        }
        return Ok(None)
    }
    let frame = read_pack_frame(mut reading.input, reading.path, reading.context, mut reading.checked_pack, at, true)?
    // A frame this generation reaches here must match its pointer.
    if let Some(stamp) = frame.stamp {
        if let Some(record) = disk_index_get(known.frames, stamp) {
            let width: u64 = int.widen(record.place.len)
            if record.place.pack == seq && record.place.offset == at && (width != frame.size || record.place.checksum != frame.checksum) {
                return Error(disk_fault(reading.path, at, Checksum))
            }
        }
    }
    Ok(Some(at + 16 + frame.size))
}

type ScannedPackFrame { stamp: Option[u64], size: u64, checksum: u64 }

fn read_pack_frame(mut input: JournalInput, path: String, context: DiskContext, mut checked_pack: PackScan, at: u64, check_pointer: bool) -> Result[ScannedPackFrame, Error] waits {
    let head = journal_prefix(mut input, path, at, 16)?
    let frame = disk_read_frame_head(path, head, at)?
    let keep = if frame.kind == checked_pack.kind { order.min(checked_pack.stamp_at + 8, frame.size) } else { 0 }
    let (take stamp_bytes, checksum) = if check_pointer && frame.kind == checked_pack.kind {
        let mut captured = disk_allocation(scoped fn() -> Result[Bytes, Error] { Ok(list.with_capacity(keep)) })?
        let plain = scrub_payload(mut input, path, context, at, head, frame, 8 - checked_pack.stamp_at, mut captured)?
        (take captured, plain)
    } else {
        (disk_stream_payload(mut input, path, context, at, head, frame, keep)?, 0u64)
    }
    let stamp = scan_pack_frame(mut checked_pack, path, at, frame.kind, frame.flags, frame.size, stamp_bytes)?
    Ok(ScannedPackFrame(stamp, size: frame.size, checksum))
}

// Streams one payload: its bound check against the head, and the plain xxh3
// that a located pointer carries, over the payload from skip on (a PAGE's
// whole payload, a BLOB's body after its stamp). keep bytes of the payload
// go to captured.
fn scrub_payload(mut input: JournalInput, path: String, context: DiskContext, offset: u64, head: Bytes, frame: DiskFrameHead, skip: u64, mut captured: Bytes) -> Result[u64, Error] waits {
    if frame.size > input.size - offset - 16 {
        return Error(disk_fault(path, offset, Truncated))
    }
    let keep = list.capacity(captured)
    let mut check = disk_allocation(scoped fn() -> Result[std.check.Xxh3, Error] {
        capacity(disk_check_start(context, offset, head))
    })?
    let mut plain = std.check.start()
    let begin = offset + 16
    let end = begin + frame.size
    let mut at = begin
    while at < end {
        let start = journal_chunk(mut input, path, at)?
        let part = order.min(end - at, list.len(input.chunk) - start)
        std.check.add(mut check, input.chunk, start, start + part)
        let from = at - begin
        if from + part > skip {
            let low = if from >= skip {
                start
            } else {
                start + (skip - from)
            }
            std.check.add(mut plain, input.chunk, low, start + part)
        }
        if list.len(captured) < keep {
            let capture = order.min(part, keep - list.len(captured))
            list.append(mut captured, list.slice(input.chunk, start, start + capture))
        }
        at += part
    }
    if std.check.finish(check) != frame.checksum {
        return Error(disk_fault(path, offset, Checksum))
    }
    Ok(std.check.finish(plain))
}

fn scrub_leased(scrubs: List[Arc[ScrubLease]], seq: u64) -> bool {
    for held in scrubs {
        for pack in held.packs {
            if pack == seq {
                return true
            }
        }
    }
    false
}

// A share nobody else holds belongs to a tour that ended.
fn prune_scrubs(mut scrubs: List[Arc[ScrubLease]]) {
    let mut slot = 0u64
    while slot < list.len(scrubs) {
        let ended = match arc.with_unique(mut scrubs[slot], fn(mut _held: ScrubLease) {}) {
            Some(_) => true,
            None => false
        }
        if ended {
            let _ = list.swap_remove(mut scrubs, slot)
        } else {
            slot += 1
        }
    }
}

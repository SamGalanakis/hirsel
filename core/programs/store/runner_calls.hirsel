// The runner's R1 cases (RUNNER-SPEC v2.4 §2, §3 and §8): transact through sessions, the
// head and the publisher, as law_ functions on the evaluator and test_ twins natively.
// Expected values come from
// the specification and the std codec:
// - outcome bytes are std.codec.put_result of the body's Result[u64, u32];
// - versions count commits from STORE-SPEC v2.8, where every commit, schema commits
//   included, advances the branch version by one. Each case's store creates the table
//   "data" (version 1) and place_head creates the streams table (2). A call's admit is one
//   commit and its run, or its reply-only commit, is the next; a refusal, a Duplicate and
//   a Superseded commit nothing.
type Hd: send { t: store.Table[u64, u64] }

type Calls = runner.Registry[(), Hd]

fn handles(mut db: store.Db) -> Result[Hd, store.Error] waits {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let t = store.table(mut db, "data", std.codec.key_u64(), cv)?
    Ok(Hd(t: t))
}

// L14's negative: a `handles` that commits on every call.
fn handles_commits(mut db: store.Db) -> Result[Hd, store.Error] waits {
    let h = handles(mut db)?
    let _ = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, h.t, 0u64, 0u64)
    })?
    Ok(h)
}

// The body writes k and returns its commit's version.
fn write(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    match store.put(mut tx, h.t, k, k) {
        Ok(()) => Ok(store.info(mut tx).id.version),
        Error(_) => Error(1u32),
    }
}

fn refuse(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    let _ = store.put(mut tx, h.t, k, k)
    Error(7u32)
}

// A deterministic fault (Bounds, Raised(2)) after a write.
fn crash(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    let _ = store.put(mut tx, h.t, k, k)
    let xs: List[u64] = list.new()
    Ok(xs[k])
}

// L3's handler: a write, one try_send on a channel of its own, then crash's fault
// (Raised(2)). Nothing else in the runner or the store calls try_send, so the TRY_SEND
// events (kind 7) in the evaluator's event log count this handler's runs, aborted ones
// included.
fn tally(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    let _ = store.put(mut tx, h.t, k, k)
    let made: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(1u64)
    if let Ok((to, _)) = take made {
        let _ = channel.try_send(to, k)
    }
    let xs: List[u64] = list.new()
    Ok(xs[k])
}

// L2's entry: a String argument, decoded under 16,384 bytes.
fn named(mut tx: store.Tx, h: Hd, take s: String) -> Result[u64, u32] {
    Ok(string.byte_len(s))
}

// k rows in one commit: past a small resident_limit, the store refuses the commit.
fn flood(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    for i in 0u64 .. k {
        if let Error(_) = store.put(mut tx, h.t, i, i) {
            return Error(1u32)
        }
    }
    Ok(k)
}

// L7/deadline_hung: s=65536, e=241 pre-loop calls/latches. First send is
// Step242; send k is Step241+2*k-1, so exactly32648 TRY_SEND events.
// Source tally: Tx/snapshots13, runner adapters5, decode7, this prelude3,
// put/checks18, key encoding59, row reads32, write bookkeeping33,
// ordered-map updates69, value encoding2. No core bodies or glue Steps.
// core/tools/runner_tests.py and runner_count.c enforce this independent oracle.
fn hung(mut tx: store.Tx, h: Hd, take k: u64) -> Result[u64, u32] {
    let _ = store.put(mut tx, h.t, k, k)
    let made: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(1u64)
    let (to, _) = result.unwrap(take made)
    loop { let _ = channel.try_send(to, 0u64) }
}
fn answer(take k: u64) -> Result[u64, Capacity] {
    let made: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(1u64)
    let (to, _) = result.unwrap(take made)
    let _ = channel.try_send(to, k)
    Ok(k)
}

// The place's one `place` function (rule 10): the head, the publisher and every session
// run it.
fn place(mut r: Calls) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(write), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(refuse), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(crash), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(tally), 65536u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(named), 16384u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(flood), 1048576u64, runner.DEFAULT_STEPS)?
    runner.transact(mut r, code.describe(hung), 65536u64, 65536u64)?
    runner.compute(mut r, code.describe(answer), 65536u64, runner.DEFAULT_STEPS)
}

const N_PLACE: u64 = 1048576u64

// A key as a client builds it: identity ++ fingerprint(A) ++ fingerprint(R).
fn key_of[A, R](id: View[Bytes], ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Bytes {
    let mut key: Bytes = list.new()
    result.unwrap(list.append(mut key, id))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(ca)), mut key))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(cr)), mut key))
    key
}

fn k_write() -> Bytes {
    key_of(code.identity(code.describe(write)), std.codec.of_u64(), std.codec.of_u64())
}

fn k_refuse() -> Bytes {
    key_of(code.identity(code.describe(refuse)), std.codec.of_u64(), std.codec.of_u64())
}

fn k_flood() -> Bytes {
    key_of(code.identity(code.describe(flood)), std.codec.of_u64(), std.codec.of_u64())
}

fn k_named() -> Bytes {
    key_of(code.identity(code.describe(named)), std.codec.of_string(), std.codec.of_u64())
}

// A String of n bytes, encoded; with `trailing`, one byte more, so its decode reads the
// whole String before it is refused Malformed.
fn string_arg(n: u64, trailing: bool) -> Bytes {
    let mut s: Bytes = list.new()
    for _ in 0u64 .. n {
        result.unwrap(list.push(mut s, 97u8))
    }
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_string(result.unwrap(string.from_utf8(take s)), mut b))
    if trailing {
        result.unwrap(list.push(mut b, 0u8))
    }
    b
}

fn k_tally() -> Bytes {
    key_of(code.identity(code.describe(tally)), std.codec.of_u64(), std.codec.of_u64())
}

fn k_crash() -> Bytes {
    key_of(code.identity(code.describe(crash)), std.codec.of_u64(), std.codec.of_u64())
}

fn u64_arg(x: u64) -> Bytes {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_u64(x, mut b))
    b
}

fn sid(s: u64) -> Bytes {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_u64(s, mut b))
    b
}

fn want(ok: bool, take what: String) {
    if !ok {
        fail(take what)
    }
}

// Outcomes compare by their std codec bytes (C3's byte-equality).
fn is(a: runner.Outcome, b: runner.Outcome) -> bool {
    let co: std.codec.Codec[runner.Outcome] = std.codec.of()
    let mut x: Bytes = list.new()
    let mut y: Bytes = list.new()
    result.unwrap(std.codec.encode(co, a, mut x))
    result.unwrap(std.codec.encode(co, b, mut y))
    x == y
}

fn empty(inbox: Receiver[runner.Req]) -> bool {
    match channel.try_receive(inbox) {
        Ok(_) => false,
        Error(_) => true,
    }
}

// The value of a Returned(Ok(v)), from the std codec.
fn ok_value(o: runner.Outcome) -> Option[u64] {
    match o {
        Returned(b) => {
            let mut at = 0u64
            match std.codec.take_result(b, mut at, std.codec.of_u64(), std.codec.of_u32()) {
                Ok(Ok(v)) => if at == list.len(b) {
                    Some(v)
                } else {
                    None
                },
                _ => None,
            }
        },
        _ => None,
    }
}

fn err_value(o: runner.Outcome) -> Option[u32] {
    match o {
        Returned(b) => {
            let mut at = 0u64
            match std.codec.take_result(b, mut at, std.codec.of_u64(), std.codec.of_u32()) {
                Ok(Error(e)) => if at == list.len(b) {
                    Some(e)
                } else {
                    None
                },
                _ => None,
            }
        },
        _ => None,
    }
}

const NEVER: u64 = 18446744073709551615u64

// A client: its way into a session, the session's frames, and a watchdog that sends a
// frame at version NEVER after 5 s, so a call left unanswered fails its case.
type Conn { to: Sender[runner.Event], from: Receiver[runner.Told], dog: Task[()], session: Task[Result[(), runner.RegisterError]] }

type Dog: send { clock: Clock, at: u64, to: Sender[runner.Told] }

fn bark(take d: Dog) -> () waits {
    host.sleep_until(d.clock, d.at)
    let Dog(clock: _, at: _, to: take to) = take d
    let _ = channel.send(to, runner.Told(version: NEVER, stream: list.new(), p: 0u64, outcome: InDoubt))
}

type Drive: send { head: Sender[runner.Req], clock: Clock, tasks: Tasks }

fn conn(tasks: Tasks, head: Sender[runner.Req], clock: Clock, q: u64) -> Conn {
    conn_in(tasks, head, clock, q, 2097152u64)
}

fn conn_in(tasks: Tasks, head: Sender[runner.Req], clock: Clock, q: u64, n_session: u64) -> Conn {
    let made: Result[(Sender[runner.Told], Receiver[runner.Told]), Capacity] = channel.new(64u64)
    let (tx, rx) = result.unwrap(take made)
    let d = Dog(clock: clock, at: host.mono_ns(clock) + 5000000000u64, to: channel.sender(tx))
    let dog = match task.spawn(tasks, bytes 65536u64, take d, bark) {
        Ok(take t) => take t,
        Error(_) => fail("calls: watchdog spawn"),
    }
    let (to, session) = result.unwrap(runner.connect(tasks, code.describe(place), N_PLACE, head, take tx, clock, q, n_session))
    Conn(to: take to, from: take rx, dog: take dog, session: take session)
}

// A call with its deadline `after` ns from now.
fn ask(cn: Conn, clock: Clock, s: u64, p: u64, take key: Bytes, take arg: Bytes, after: u64) -> () waits {
    let c = runner.Call(stream: sid(s), p: p, key: take key, arg: take arg, deadline: host.mono_ns(clock) + after)
    if let Error(_) = channel.send(cn.to, runner.ask(take c)) {
        fail("calls: session gone")
    }
}

fn frame(cn: Conn) -> runner.Told waits {
    match channel.receive(cn.from) {
        Ok(take f) => {
            want(f.version != NEVER, "calls: a call was not answered within 5 s")
            take f
        },
        Error(_) => fail("calls: client channel closed"),
    }
}

fn hang(take cn: Conn) -> () waits {
    let _ = channel.send(cn.to, runner.hang_up())
    let Conn(to: _, from: _, dog: _, session: take s) = take cn
    let _ = task.join(take s)
}

const LATER: u64 = 10000000000u64

// One place: a fresh memory store with "data", place_head on this task, and the case's
// client driver as a task that ends by dropping its head sender.
fn served(c: Clock, r: Random, tasks: Tasks, f: fn(take Drive) -> () waits) -> bool waits {
    served_in(c, r, tasks, store.defaults(), f)
}

fn served_in(c: Clock, r: Random, tasks: Tasks, o: store.Options, f: fn(take Drive) -> () waits) -> bool waits {
    let mut db = store.memory(c, r, o)
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let made: Result[(Sender[runner.Req], Receiver[runner.Req]), Capacity] = channel.new(64u64)
    let (head, inbox) = result.unwrap(take made)
    let joined: Result[(Sender[runner.Join], Receiver[runner.Join]), Capacity] = channel.new(4u64)
    let (_, joins) = result.unwrap(take joined)
    let d = Drive(head: take head, clock: c, tasks: tasks)
    let driving = match task.spawn(tasks, bytes 33554432u64, take d, f) {
        Ok(take t) => take t,
        Error(_) => return false,
    }
    let opened = runner.place_head(take db, code.describe(place), N_PLACE, code.describe(handles), take inbox, take joins, tasks, 1048576u64)
    let drove = task.join(take driving)
    match opened {
        Ok(()) => (),
        Error(_) => return false,
    }
    match drove {
        Ok(()) => true,
        Error(_) => false,
    }
}

// two_sessions_two_streams, and C5: each outcome arrives in a frame at its commit's
// version or later, and a session's frame versions never go back.
fn drive_two_streams(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 1u64)
    let s1 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(10u64), LATER)
    let a0 = frame(s0)
    want(ok_value(a0.outcome) == Some(4u64) && a0.version == 4u64, "two_streams: A p0 at 4")
    ask(s1, d.clock, 1u64, 0u64, k_write(), u64_arg(20u64), LATER)
    let b0 = frame(s1)
    want(ok_value(b0.outcome) == Some(6u64) && b0.version == 6u64, "two_streams: B p0 at 6")
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(11u64), LATER)
    let a1 = frame(s0)
    want(ok_value(a1.outcome) == Some(8u64) && a1.version == 8u64, "two_streams: A p1 at 8")
    hang(take s0)
    hang(take s1)
}

pub fn law_calls_two_streams(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_two_streams)
}

// V4 (release_at_commit_version): A and B, sent together, commit in one group (A at 4,
// B at 6); both answers arrive in frames at the group's durable version, 6. Then C, sent
// alone, commits at 8. These pins carry L6+L7: an answer held past its first Batch
// at or above its commit moves a version off its pin.
fn drive_group(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(1u64), LATER)
    ask(s0, d.clock, 1u64, 0u64, k_write(), u64_arg(2u64), LATER)
    let x = frame(s0)
    let y = frame(s0)
    let (fa, fb) = if x.stream == sid(0u64) {
        (x, y)
    } else {
        (y, x)
    }
    want(ok_value(fa.outcome) == Some(4u64) && ok_value(fb.outcome) == Some(6u64), "group: commits at 4 and 6")
    want(fa.version == 6u64 && fb.version == 6u64, "group: both frames at the group's durable version")
    ask(s0, d.clock, 2u64, 0u64, k_write(), u64_arg(3u64), LATER)
    let z = frame(s0)
    want(ok_value(z.outcome) == Some(8u64) && z.version == 8u64, "group: C alone at 8")
    hang(take s0)
}

// L2 (v2.5): refused frames leave no charge in the session. n is the smallest n_session
// in which a session answers one hostile frame (a 4,096-byte String plus one byte, so
// its decode reads the whole String) Refused(Malformed) and ends cleanly: its idle peak
// plus one hostile decode. Under n, 10,000 such frames are all Refused(Malformed) at
// version 0, the client channel stays open, and the session ends without a fault. Then
// p0 of the stream commits at 4: the version and the streams row did not move.
fn survives(d: Drive, n: u64, frames: u64) -> bool waits {
    let cn = conn_in(d.tasks, d.head, d.clock, 1u64, n)
    let bad = string_arg(4096u64, true)
    let mut all = true
    let mut i = 0u64
    while all && i < frames {
        let arg: Bytes = result.unwrap(clone(bad))
        ask(cn, d.clock, 0u64, 0u64, k_named(), take arg, LATER)
        all = match channel.receive(cn.from) {
            Ok(f) => f.version == 0u64 && match f.outcome {
                Refused(Malformed(_)) => true,
                _ => false,
            },
            Error(_) => false,
        }
        i += 1u64
    }
    let _ = channel.send(cn.to, runner.hang_up())
    let Conn(to: _, from: _, dog: _, session: take s) = take cn
    match task.join(take s) {
        Ok(Ok(())) => all,
        _ => false,
    }
}

fn drive_session_charge(take d: Drive) -> () waits {
    let mut lo = 0u64
    let mut hi = 4194304u64
    while lo < hi {
        let mid = lo + (hi - lo) / 2u64
        if survives(d, mid, 1u64) {
            hi = mid
        } else {
            lo = mid + 1u64
        }
    }
    want(lo < 4194304u64, "session_charge: no session answers one hostile frame")
    want(survives(d, lo, 10000u64), "session_charge: 10,000 refused frames under one hostile decode")
    let s0 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(1u64), LATER)
    let f = frame(s0)
    want(ok_value(f.outcome) == Some(4u64), "session_charge: nothing committed, p0 at 4")
    hang(take s0)
}

pub fn law_calls_session_charge(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_session_charge)
}

pub fn law_calls_group_version(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_group)
}

// joiners (drop_joiner): two sessions send one position; both are answered with the one
// run's outcome, and the run happened once (the next position commits at 6).
fn drive_joiners(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 1u64)
    let s1 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(5u64), LATER)
    ask(s1, d.clock, 0u64, 0u64, k_write(), u64_arg(5u64), LATER)
    let a = frame(s0)
    let b = frame(s1)
    want(ok_value(a.outcome) == Some(4u64) && a.version == 4u64, "joiners: first session")
    want(ok_value(b.outcome) == Some(4u64) && b.version == 4u64, "joiners: second session")
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(6u64), LATER)
    want(ok_value(frame(s0).outcome) == Some(6u64), "joiners: one run for p0")
    hang(take s0)
    hang(take s1)
}

pub fn law_calls_joiners(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_joiners)
}

// V3 and C3/C5 (direct_commitless): a re-send from another session gets the stored reply,
// byte-equal, in a frame at or above its commit; an older position gets Superseded.
fn drive_duplicate(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(5u64), LATER)
    let first = frame(s0)
    want(ok_value(first.outcome) == Some(4u64) && first.version == 4u64, "duplicate: first answer")
    hang(take s0)
    let s1 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s1, d.clock, 0u64, 0u64, k_write(), u64_arg(5u64), LATER)
    let again = frame(s1)
    want(is(again.outcome, first.outcome), "duplicate: byte-equal reply")
    want(again.version >= 4u64, "duplicate: frame below the commit it reports")
    ask(s1, d.clock, 0u64, 1u64, k_write(), u64_arg(6u64), LATER)
    let next = frame(s1)
    want(ok_value(next.outcome) == Some(6u64) && next.version == 6u64, "duplicate: p1 at 6")
    ask(s1, d.clock, 0u64, 0u64, k_write(), u64_arg(5u64), LATER)
    let old = frame(s1)
    want(is(old.outcome, Superseded) && old.version == 6u64, "duplicate: Superseded at 6")
    hang(take s1)
}

pub fn law_calls_duplicate(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_duplicate)
}

// refusals with L2 and L3, one session with q = 0:
// - V1, C7, L2: 10,000 malformed calls are answered at once at the last version (0) and
//   record nothing, so the first valid call still commits at 4;
// - NoEntry and Deadline likewise;
// - an Error is kept alone in a reply-only commit, and a fault is Failed(Raised(2));
// - L3: the failed position re-sent 3 times returns the stored reply and runs nothing
//   (the next position commits at 10).
fn drive_refusals(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 0u64)
    for _ in 0u64 .. 10000u64 {
        ask(s0, d.clock, 1u64, 0u64, k_write(), list.new(), LATER)
        let f = frame(s0)
        want(is(f.outcome, Refused(Malformed(runner.Bad(kind: 0u32, at: 0u64)))) && f.version == 0u64, "refusals: malformed")
    }
    ask(s0, d.clock, 1u64, 0u64, key_of(code.identity(code.describe(write)), std.codec.of_u32(), std.codec.of_u64()), u64_arg(3u64), LATER)
    want(is(frame(s0).outcome, Refused(NoEntry)), "refusals: NoEntry")
    ask(s0, d.clock, 1u64, 0u64, k_write(), u64_arg(3u64), 0u64)
    want(is(frame(s0).outcome, Refused(Deadline)), "refusals: Deadline")
    ask(s0, d.clock, 1u64, 0u64, k_write(), u64_arg(3u64), LATER)
    let v = frame(s0)
    want(ok_value(v.outcome) == Some(4u64) && v.version == 4u64, "refusals: nothing recorded before the valid call")
    ask(s0, d.clock, 0u64, 0u64, k_refuse(), u64_arg(4u64), LATER)
    let e = frame(s0)
    want(err_value(e.outcome) == Some(7u32) && e.version == 6u64, "refusals: Error kept alone at 6")
    for _ in 0u64 .. 4u64 {
        ask(s0, d.clock, 0u64, 1u64, k_crash(), u64_arg(5u64), LATER)
        let f = frame(s0)
        want(is(f.outcome, Failed(Raised(2u32))) && f.version == 8u64, "refusals: Failed(Raised(2)) at 8")
    }
    ask(s0, d.clock, 0u64, 2u64, k_write(), u64_arg(6u64), LATER)
    want(ok_value(frame(s0).outcome) == Some(10u64), "refusals: the failed position ran once")
    hang(take s0)
}

pub fn law_calls_refusals(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_refusals)
}

// L3 (§8): a Failed position re-sent k times runs its handler exactly once. A Failed
// run's effects are aborted, so no row the body writes survives to count its runs
// (followups to runner-spec-1020). The count is tally's TRY_SEND events, which the
// harness reads from the evaluator's event log: exactly 1 for this case. A head that
// runs the body again for a Duplicate and discards the run gives 4. The data half runs
// on every engine: p0 is admitted at 3 and its reply kept alone at 4, and each of the
// three re-sends returns that stored reply.
fn drive_runs_once(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 0u64)
    for _ in 0u64 .. 4u64 {
        ask(s0, d.clock, 0u64, 0u64, k_tally(), u64_arg(5u64), LATER)
        let f = frame(s0)
        want(is(f.outcome, Failed(Raised(2u32))) && f.version == 4u64, "runs_once: Failed(Raised(2)) at 4")
    }
    hang(take s0)
}

pub fn law_calls_runs_once(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_runs_once)
}

// refusals' store refusal (store_v22_admit, C3): the store refuses p0's effect commit
// (resident_limit), so the session gets Refused(Overloaded) in a frame at the publisher's
// base (V3), the open's version 2, and p0 stays admitted with no reply. p1 is not admitted while p0 is unreplied (STORE-SPEC §1.8, S7):
// it waits in the FIFO and is Abandoned at its deadline. A re-send of p0 runs it again
// and is refused again; it is not Superseded, which C3 allows only for a replied position.
fn drive_store_refusal(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_flood(), u64_arg(FLOOD), LATER)
    let a = frame(s0)
    want(is(a.outcome, Refused(Overloaded)) && a.version == 2u64, "store_refusal: p0 refused by the store")
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(1u64), 2000000u64)
    let b = frame(s0)
    want(b.p == 1u64 && is(b.outcome, Abandoned), "store_refusal: p1 not admitted while p0 is unreplied")
    ask(s0, d.clock, 0u64, 0u64, k_flood(), u64_arg(FLOOD), LATER)
    let c = frame(s0)
    want(c.p == 0u64 && is(c.outcome, Refused(Overloaded)), "store_refusal: re-sent p0 runs again, not Superseded")
    hang(take s0)
}

const FLOOD: u64 = 4000u64

pub fn law_calls_store_refusal(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut o = store.defaults()
    o.resident_limit = 32768u64
    served_in(c, r, tasks, o, drive_store_refusal)
}

// Rule 5: every send ends in exactly one Outcome (review 1042, law_abandoned_no_resend).
// Each position runs once, as an admit and an effect commit, so after the two setup
// commits the n-th run returns 2n + 2:
// - p1 sent alone before p0 is Abandoned at its deadline and not re-sent; p0 then runs (4),
//   and p1 runs behind it (6) with no Outcome, because its one send was answered;
// - meanwhile another stream of the session proceeds (8), and p2 is the next frame (10);
// - a position sent twice before its Outcome gets two, from one run (12); its next
//   position is the next frame (14);
// - p1 Abandoned and then re-sent twice gets two more Outcomes, one per send, after p0
//   (16, 18), and p2 is next (20);
// - p1 Abandoned in a session that then ends: the head runs it for nobody, and another
//   session's p0 and p2 of that stream are answered (22, 26).
fn drive_one_outcome_per_send(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 2u64)
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(1u64), 2000000u64)
    let a = frame(s0)
    want(a.p == 1u64 && is(a.outcome, Abandoned), "one_outcome: p1 Abandoned")
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(0u64), LATER)
    let b = frame(s0)
    want(b.p == 0u64 && ok_value(b.outcome) == Some(4u64), "one_outcome: p0 at 4")
    ask(s0, d.clock, 1u64, 0u64, k_write(), u64_arg(100u64), LATER)
    let other = frame(s0)
    want(other.stream == sid(1u64) && other.p == 0u64 && ok_value(other.outcome) != None, "one_outcome: another stream proceeds, and p1's run has no Outcome")
    ask(s0, d.clock, 0u64, 2u64, k_write(), u64_arg(2u64), LATER)
    let c = frame(s0)
    want(c.stream == sid(0u64) && c.p == 2u64 && ok_value(c.outcome) == Some(10u64), "one_outcome: p2 next, and p1 ran once with no Outcome")
    ask(s0, d.clock, 2u64, 0u64, k_write(), u64_arg(200u64), LATER)
    ask(s0, d.clock, 2u64, 0u64, k_write(), u64_arg(200u64), LATER)
    let d0 = frame(s0)
    let d1 = frame(s0)
    want(d0.p == 0u64 && d1.p == 0u64 && ok_value(d0.outcome) == Some(12u64) && is(d0.outcome, d1.outcome), "one_outcome: two sends before the Outcome get two")
    ask(s0, d.clock, 2u64, 1u64, k_write(), u64_arg(201u64), LATER)
    let d2 = frame(s0)
    want(d2.p == 1u64 && ok_value(d2.outcome) == Some(14u64), "one_outcome: no third Outcome, one run")
    ask(s0, d.clock, 3u64, 1u64, k_write(), u64_arg(301u64), 2000000u64)
    let e = frame(s0)
    want(e.p == 1u64 && is(e.outcome, Abandoned), "one_outcome: stream 3 p1 Abandoned")
    ask(s0, d.clock, 3u64, 1u64, k_write(), u64_arg(301u64), LATER)
    ask(s0, d.clock, 3u64, 1u64, k_write(), u64_arg(301u64), LATER)
    ask(s0, d.clock, 3u64, 0u64, k_write(), u64_arg(300u64), LATER)
    let e0 = frame(s0)
    want(e0.p == 0u64 && ok_value(e0.outcome) == Some(16u64), "one_outcome: stream 3 p0 at 16")
    let e1 = frame(s0)
    let e2 = frame(s0)
    want(e1.p == 1u64 && e2.p == 1u64 && ok_value(e1.outcome) == Some(18u64) && is(e1.outcome, e2.outcome), "one_outcome: two re-sends after Abandoned get two")
    ask(s0, d.clock, 3u64, 2u64, k_write(), u64_arg(302u64), LATER)
    let e3 = frame(s0)
    want(e3.p == 2u64 && ok_value(e3.outcome) == Some(20u64), "one_outcome: stream 3 p2 next")
    let s1 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s1, d.clock, 4u64, 1u64, k_write(), u64_arg(401u64), 2000000u64)
    let f = frame(s1)
    want(f.p == 1u64 && is(f.outcome, Abandoned), "one_outcome: stream 4 p1 Abandoned")
    hang(take s1)
    ask(s0, d.clock, 4u64, 0u64, k_write(), u64_arg(400u64), LATER)
    let f0 = frame(s0)
    want(f0.p == 0u64 && ok_value(f0.outcome) == Some(22u64), "one_outcome: stream 4 p0 at 22")
    ask(s0, d.clock, 4u64, 2u64, k_write(), u64_arg(402u64), LATER)
    let f2 = frame(s0)
    want(f2.p == 2u64 && ok_value(f2.outcome) == Some(26u64), "one_outcome: stream 4 p2 after p1 ran for the ended session")
    hang(take s0)
}

pub fn law_calls_one_outcome_per_send(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_one_outcome_per_send)
}

// L7/deadline_held (v2.4), on the real head. p1 of a fresh stream, sent before p0, waits
// in the head's FIFO (S7: Rejected(0)); the session answers Abandoned at its deadline
// (V1), at its last version 0, and keeps the slot (V2). Then p0 is sent and p1 re-sent:
// p0 commits at 4, and p1, which the re-send joins locally, runs once and commits at 6.
// The next position is the next frame, at 8, so p1 was answered once.
fn drive_deadline_held(take d: Drive) -> () waits {
    let s0 = conn(d.tasks, d.head, d.clock, 1u64)
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(11u64), 2000000u64)
    let a = frame(s0)
    want(is(a.outcome, Abandoned) && a.p == 1u64 && a.version == 0u64, "deadline_held: Abandoned at the deadline")
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(10u64), LATER)
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(11u64), LATER)
    let f0 = frame(s0)
    want(f0.p == 0u64 && ok_value(f0.outcome) == Some(4u64) && f0.version == 4u64, "deadline_held: p0 at 4")
    let f1 = frame(s0)
    want(f1.p == 1u64 && ok_value(f1.outcome) == Some(6u64) && f1.version == 6u64, "deadline_held: p1 once, at 6")
    ask(s0, d.clock, 0u64, 2u64, k_write(), u64_arg(12u64), LATER)
    let f2 = frame(s0)
    want(f2.p == 2u64 && ok_value(f2.outcome) == Some(8u64), "deadline_held: p1 answered once")
    hang(take s0)
}

pub fn law_calls_deadline_held(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    served(c, r, tasks, drive_deadline_held)
}

// The session's V1 and V2 logic against a head that holds every request and answers none
// (a held-head case; not L7/deadline_hung, which waits on D5):
// - q = 0: A p0 is Abandoned at its deadline (V1) and keeps its slot (V2), so B p0 is
//   Overloaded at once, and the head holds one request (C6, queue_outside_account);
//   a re-send of A p0 joins locally and is Abandoned again, still one request;
// - q = 1: p0 and p1 of one stream both forwarded and both Abandoned at their deadlines,
//   though the head answers neither (deadline_rides_release);
// - L15, each send at its own deadline: A (2 ms) then B (50 ms) of one held position, and
//   A's Abandoned arrives before B's deadline, then B's (latest_deadline);
// - L15, a joined send takes a slot: with q = 0 a second send of a held position is
//   Overloaded at once, and the first is Abandoned at its deadline (join_outside_account).
pub fn law_calls_held_head(c: Clock, tasks: Tasks) -> bool waits {
    let made: Result[(Sender[runner.Req], Receiver[runner.Req]), Capacity] = channel.new(64u64)
    let (head, inbox) = result.unwrap(take made)
    let s0 = conn(tasks, head, c, 0u64)
    ask(s0, c, 0u64, 0u64, k_write(), u64_arg(1u64), 2000000u64)
    let a = frame(s0)
    want(is(a.outcome, Abandoned) && a.version == 0u64, "held_head: Abandoned at the deadline")
    ask(s0, c, 1u64, 0u64, k_write(), u64_arg(2u64), LATER)
    want(is(frame(s0).outcome, Refused(Overloaded)), "held_head: the slot stays held")
    let mut held = 0u64
    while !empty(inbox) {
        held += 1u64
    }
    want(held == 1u64, "held_head: the head holds 1 + q")
    ask(s0, c, 0u64, 0u64, k_write(), u64_arg(1u64), 2000000u64)
    want(is(frame(s0).outcome, Abandoned), "held_head: a re-send joins locally")
    want(empty(inbox), "held_head: a re-send is not forwarded")
    hang(take s0)
    let s1 = conn(tasks, head, c, 1u64)
    ask(s1, c, 0u64, 0u64, k_write(), u64_arg(1u64), 2000000u64)
    ask(s1, c, 0u64, 1u64, k_write(), u64_arg(2u64), 2000000u64)
    want(is(frame(s1).outcome, Abandoned) && is(frame(s1).outcome, Abandoned), "held_head: both answered by the session")
    hang(take s1)
    let s3 = conn(tasks, head, c, 1u64)
    ask(s3, c, 0u64, 0u64, k_write(), u64_arg(3u64), 2000000u64)
    let b_at = host.mono_ns(c) + 50000000u64
    ask(s3, c, 0u64, 0u64, k_write(), u64_arg(3u64), 50000000u64)
    let first = frame(s3)
    want(is(first.outcome, Abandoned) && host.mono_ns(c) < b_at, "held_head: the first send is Abandoned at its own deadline")
    want(is(frame(s3).outcome, Abandoned) && host.mono_ns(c) >= b_at, "held_head: the second send at its own")
    hang(take s3)
    let s2 = conn(tasks, head, c, 0u64)
    ask(s2, c, 0u64, 9u64, k_write(), u64_arg(9u64), 2000000u64)
    ask(s2, c, 0u64, 9u64, k_write(), u64_arg(9u64), 2000000u64)
    want(is(frame(s2).outcome, Refused(Overloaded)), "held_head: with q = 0 a join takes the second slot")
    want(is(frame(s2).outcome, Abandoned), "held_head: the first send is still answered")
    hang(take s2)
    true
}

// L14: a `handles` that commits on its second call fails the open; one that resolves opens.
pub fn law_l14_handles(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut ok = true
    for commits in [false, true] {
        let mut db = store.memory(c, r, store.defaults())
        let cv: std.codec.Codec[u64] = std.codec.of()
        let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
        let made: Result[(Sender[runner.Req], Receiver[runner.Req]), Capacity] = channel.new(1u64)
        let (_, inbox) = result.unwrap(take made)
        let joined: Result[(Sender[runner.Join], Receiver[runner.Join]), Capacity] = channel.new(1u64)
        let (_, joins) = result.unwrap(take joined)
        let h = if commits {
            code.describe(handles_commits)
        } else {
            code.describe(handles)
        }
        let opened = runner.place_head(take db, code.describe(place), N_PLACE, h, take inbox, take joins, tasks, 1048576u64)
        ok = ok && match opened {
            Ok(()) => !commits,
            Error(HandlesChanged) => commits,
            Error(_) => false,
        }
    }
    ok
}


// MEM-30: each send is step 2*i+1; each completed latch is step 2*i+2.
// expect: run loop_count(0,0) = 0
// expect: run loop_count(1,0) = 1
// expect: run loop_count(5,0) = 3
// expect: run loop_count(6,0) = 3
// expect: run loop_count(5,1) = 3
// expect: run loop_count(6,1) = 3
// expect: run loop_count(5,2) = 3
// expect: run loop_count(6,2) = 3
// expect: run loop_count(5,3) = 3
// expect: run loop_count(5,4) = 3
// expect: run exact(0) = 0
// expect: run exact(1) = 7
// expect: run nested(4) = 4
// expect: run nested(5) = 7
// expect: run reservation() = 1
// expect: run isolate_stop() = 50
fn loop_count(k: u64, form: u64) -> u64 {
    let (tx, rx): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(16))
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 3u64 { let _ = list.push(mut xs, i) }
    let _ = bound steps k {
        if form == 0 {
            loop { let _ = channel.try_send(tx, 1u64) }
        } else if form == 1 {
            let mut i = 0u64
            while i < 3 { let _ = channel.try_send(tx, 1u64); i += 1 }
        } else if form == 2 {
            for _ in 0u64 .. 3u64 { let _ = channel.try_send(tx, 1u64) }
        } else if form == 3 {
            loop { let _ = channel.try_send(tx, 1u64); continue }
        } else {
            for _ in xs { let _ = channel.try_send(tx, 1u64) }
        }
    }
    let mut count = 0u64
    while let Ok(_) = channel.try_receive(rx) { count += 1 }
    count
}
fn exact(k: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 7u64)
    match (bound steps k { list.get(xs, 0) }) {
        Ok(Some(v)) => v,
        Error(e) => e.steps,
        _ => 99,
    }
}
fn leaf() -> u64 { 7 }
fn nested(n: u64) -> u64 {
    match (bound steps n {
        let _ = bound steps 4 { for _ in 0u64 .. 3u64 { leaf(); } }
        leaf()
    }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn reservation() -> u64 {
    match (bound steps 3 {
        match (bound steps 4 { fail("not entered") }) {
            Error(e) => e.steps,
            _ => 0,
        }
    }) { Ok(4) => 1, _ => 0 }
}
fn spin() { loop {} }
fn isolate_stop() -> u64 {
    match (bound steps 50 { loop { let _ = isolate(fn() { spin() }) } }) {
        Error(e) => e.steps,
        _ => 0,
    }
}
// A callable call is one step; isolate's call and its callback entry are two.
// expect: run callback(0) = 0
// expect: run callback(1) = 7
// expect: run core_callback(1) = 1
// expect: run core_callback(2) = 7
// expect: run finalizer(1) = 1 trace 7
// expect: run finalizer(2) = 7 trace 7
// expect: run glue(0) = 7
// expect: run glue(100) = 7
// The parent spends seven steps, task entry one, and five sends/latches ten.
// The next attempted send fails at step 19. The second child cannot enter.
// expect: run shared(0) = 5
// expect: run mixed(0) = fail Division,OutOfTime trace 0
// Catching a used root primary retains its replacement cell (FAIL-16).
// expect: run isolated_mixed(0) = 12 trace 0 used 32
fn callback(k: u64) -> u64 {
    match (bound steps k { let f = fn() -> u64 { 7 }; f() }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn core_callback(k: u64) -> u64 {
    match (bound steps k { isolate(fn() -> u64 { 7 }) }) {
        Ok(Ok(Ok(v))) => v,
        Error(e) => e.steps,
        _ => 99,
    }
}
resource type Marker { id: u64 } drop(m) {}
fn finalizer(k: u64) -> u64 {
    match (bound steps k { let m = result.unwrap(Marker(id: 7)); 7u64 }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn glue(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. n { let _ = list.push(mut xs, i) }
    match (bound steps 1 { let copied: Result[List[u64], Capacity] = clone(xs); let _ = take copied; 7u64 }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
fn worker(take tx: Sender[u64]) {
    loop { let _ = channel.try_send(tx, 1u64) }
}
fn shared(tasks: Tasks) -> u64 waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(32))
    let _ = bound steps 18 {
        let a = channel.sender(tx)
        let first = result.unwrap(task.spawn(tasks, bytes 4096, take a, worker))
        let b = channel.sender(tx)
        let second = result.unwrap(task.spawn(tasks, bytes 4096, take b, worker))
        let _ = task.join(take first)
        let _ = task.join(take second)
    }
    let mut count = 0u64
    while let Ok(_) = channel.try_receive(rx) { count += 1 }
    count
}
resource type Failing { d: u64 } drop(f) { let _ = 1u64 / f.d }
fn mixed(d: u64) {
    let _ = bound steps 1 {
        let f = result.unwrap(Failing(d: 0))
        let _ = 1u64 / d
    }
}
fn isolated_mixed(d: u64) -> u64 {
    match isolate(fn() { mixed(d) }) {
        Ok(Error(cs)) => {
            let mut kinds = 0u64
            for c in cs {
                kinds = kinds * 10 + match c.kind { Division => 1u64, OutOfTime => 2u64, _ => 9u64 }
            }
            kinds
        },
        _ => 0,
    }
}

// expect: run sort_callback(1) = 1
// expect: run sort_callback(2) = 7
fn sort_callback(k: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 2u64)
    let _ = list.push(mut xs, 1u64)
    match (bound steps k {
        let mut ys = take xs
        let _ = list.sort_stable(mut ys, fn(a: u64, b: u64) -> Order { Equal })
        7u64
    }) {
        Ok(v) => v,
        Error(e) => e.steps,
    }
}
// S1, S2, S6 and S7: five loop forms send 3 each; the shared task bound sends 5.
// hand-derived try-send: 20
pub fn main(tasks: Tasks) -> Result[(), Exit] waits {
    if loop_count(5, 0) == 3 && loop_count(5, 1) == 3 && loop_count(5, 2) == 3 && loop_count(5, 3) == 3 && loop_count(5, 4) == 3 && callback(1) == 7 && core_callback(1) == 1 && core_callback(2) == 7 && finalizer(1) == 1 && finalizer(2) == 7 && glue(0) == 7 && glue(100) == 7 && sort_callback(1) == 1 && sort_callback(2) == 7 && isolate_stop() == 50 && optimized_spin() == 1000 && chunk_range(8, 3) == 3 && chunk_range(8, 8) == 7 && chunk_range(100000, 65536) == 65536 && chunk_list(3) == 3 && merged_calls(1) == 1 && merged_calls(2) == 7 && shared(tasks) == 5 && isolated_mixed(0) == 12 && mixed_chain(tasks) {
        Ok(())
    } else { Error(Exit(status: 1)) }
}

fn caught_child(take d: u64) -> u64 { isolated_mixed(d) }
// The outer isolate catches a Division-primary chain with secondary OutOfTime.
// expect: run mixed_chain(0) = true
fn mixed_chain(tasks: Tasks) -> bool waits {
    let h = result.unwrap(task.spawn(tasks, bytes 4096, 0u64, caught_child))
    match task.join(take h) { Ok(12) => true, _ => false }
}

// S4: release optimization cannot delete or hoist an empty loop's source Steps.
// expect: run optimized_spin() = 1000
fn optimized_spin() -> u64 {
    match (bound steps 1000 { loop {} }) { Error(e) => e.steps, _ => 0 }
}

// Whole chunks cannot stop early. A short window takes the checked copy and
// stops at precisely the next unpaid latch, including a list's final latch.
// expect: run chunk_range(8,3) = 3
// expect: run chunk_range(8,8) = 7
// expect: run chunk_range(100000,65536) = 65536
// expect: run chunk_list(3) = 3
// expect: run chunk_list(8) = 7
// expect: run merged_calls(1) = 1
// expect: run merged_calls(2) = 7
fn chunk_range(n: u64, budget: u64) -> u64 {
    match (bound steps budget {
        let mut sum = 0u64
        for x in 0u64 .. n { sum = sum ^ x }
        7u64
    }) { Error(e) => e.steps, Ok(v) => v }
}
fn chunk_list(budget: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    for x in 0u64 .. 8u64 { let _ = list.push(mut xs, x) }
    match (bound steps budget {
        let mut sum = 0u64
        for x in xs { sum = sum ^ x }
        7u64
    }) { Error(e) => e.steps, Ok(v) => v }
}
fn merged_calls(budget: u64) -> u64 {
    match (bound steps budget { let a = leaf(); let b = leaf(); a ^ b ^ 7u64 }) {
        Error(e) => e.steps, Ok(v) => v,
    }
}

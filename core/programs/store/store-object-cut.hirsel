fn history_write_pack_run(mut client: std.object.Client, id: StoreId, epoch: u64, kind: u8, cache: Option[pager.ObjectsCache], pack_layout: manifest.PackRun, mut known: manifest.PageLocations, mut pack_objects: Map[u64, pages.HistoryRef], mut buffers: manifest.PackBuffers, mut workspace: history.HistoryBuffers, deadline: u64) -> Result[(), Error] waits {
    for pack in pack_layout.packs {
        failure_result_from_rep(manifest.encode_pack(store_key_to_rep(id), pack_layout, pack, mut known, mut buffers.out))?
        failure_result_from_rep(history.history_copy_header(mut buffers.out, format.DiskContext(store: store_key_to_rep(id), role: 3, seq: pack.seq), epoch, kind))?
        let item = history.history_new_ref(pack.seq, epoch, buffers.out)
        pager.history_fill_key(mut workspace.key, "p-", item)
        failure_result_from_rep(history.history_upload_pack(mut client, workspace.key, buffers.out, mut workspace.compare, deadline))?
        if let Some(local) = cache {
            if item.len <= local.capacity_bytes {
                pack_cache_write(local, workspace.key, buffers.out, false)
            }
        }
        map.insert(mut pack_objects, pack.seq, item)
    }
    Ok(())
}

fn history_write_page_cut(mut client: std.object.Client, id: StoreId, epoch: u64, kind: u8, take prepared: manifest.PagedCutLayout, inherited: history.HistoryLocator, cache: Option[pager.ObjectsCache], mut buffers: manifest.PackBuffers, mut workspace: history.HistoryBuffers, deadline: u64) -> Result[(manifest.PagedCutLayout, List[pages.HistoryRef]), Error] waits {
    let (take uploaded, take covered_packs) = disk_allocation(scoped fn() -> Result[(Map[u64, pages.HistoryRef], List[pages.HistoryRef]), Error] {
        let new_packs = list.len(prepared.blobs.packs) + list.len(prepared.data_pages.packs) + list.len(prepared.lists.run_packs.packs)
        let mut refs: Map[u64, pages.HistoryRef] = map.new()
        failure_result_from_rep(types.capacity(map.try_reserve(mut refs, new_packs)))?
        Ok((take refs, list.with_capacity(std.omap.len(prepared.locations.packs.values))))
    })?
    list.clear(mut workspace.compare)
    failure_result_from_rep(types.capacity(list.try_reserve(mut workspace.compare, 65536)))?
    let manifest.PagedCutLayout(locations: take locations, blobs: take blobs, data_pages: take data_pages, lists: take lists) = take prepared
    let mut known = take locations
    let mut packs = take uploaded
    let mut rows = take covered_packs
    history_write_pack_run(mut client, id, epoch, kind, cache, blobs, mut known, mut packs, mut buffers, mut workspace, deadline)?
    history_write_pack_run(mut client, id, epoch, kind, cache, data_pages, mut known, mut packs, mut buffers, mut workspace, deadline)?
    history_write_pack_run(mut client, id, epoch, kind, cache, lists.run_packs, mut known, mut packs, mut buffers, mut workspace, deadline)?
    let mut cursor = std.omap.range(known.packs.values, Unbounded, Unbounded)
    while let Some((seq, record)) = std.omap.next(mut cursor) {
        if record.live == 0 {
            continue
        }
        let item = match map.get(packs, seq) {
            Some(created) => created,
            None => option.unwrap(map.get(history.locator_rows(inherited), seq)),
        }
        list.push(mut rows, item)
    }
    Ok((manifest.PagedCutLayout(locations: take known, blobs: take blobs, data_pages: take data_pages, lists: take lists), take rows))
}

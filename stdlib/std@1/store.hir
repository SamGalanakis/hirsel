// An embedded, transactional, ordered key-value store kept by an authority
// (docs/spec/storage.md STORE-1, STORE-11): the engine holds every key and
// value in memory, runs one transaction at a time, and extends the store's
// history, a chain of commit groups in the history format (`std@1/history`),
// through the authority seam. Nothing else is stored, and nothing else fences.
//
// `open` claims the authority, which appends a claim record naming the next
// writer epoch, then reads the history back: every record's chain, checked by
// the authority, every group's fields and version rules, the newest checkpoint's nodes, and the commits after it, applied in
// order. The first commit after the claims a history begins with is the
// Genesis, which records the limits and the checkpoint node bounds; a history
// holding only claims is a creation that never completed, so it is no store,
// and the open that finds it creates one.
//
// A commit applies to the head's state at once, raising the visible version
// V, and joins the pending group; the group advances the history as one entry
// when an outcome awaits its durability or a group bound is reached, never on
// a timer. For each declared level L the store keeps D(L), the highest version
// durable at L, and the state at it, so a snapshot at a level costs nothing.
//
// A transaction is an entry (STORE-2): `transact`, `query` and `call` run
// it through `runner.apply` on argument bytes decoded afresh, with call
// information minted before the run, and its commit records the call: the
// entry's identity, the call information, the argument bytes and the bytes of
// the outcome. The store holds itself from the run to the commit, so no
// commit lands in between and there is no conflict.

/// The engine's settings (STORE-1). A group advances once it holds
/// `group_commits` commits or `group_bytes` encoded bytes, or when an outcome
/// awaits it. A checkpoint's fresh nodes are put in batches of at most
/// `batch_bytes` bytes and one node more (STORE-11). The limits and the checkpoint node bounds `nodes` are recorded
/// by the store's Genesis commit when it is created; those an opener of an
/// existing store passes are ignored. Each transaction and query body runs
/// under `energy` units (STORE-11 "Energy"), a setting of this engine that
/// nothing records.
pub type StoreConfig {
  group_commits: u64,
  group_bytes: u64,
  batch_bytes: u64,
  limits: StoreLimits,
  nodes: history.Bounds,
  energy: u64,
}

/// The most a commit may write: any key over `key_bytes`, any value over
/// `value_bytes`, or an encoded commit (its call record and outcome included)
/// over `transaction_bytes` refuses the commit with `Limit(..)` and no effect;
/// a range of more than `range_rows` rows is refused too. Each is at most
/// 4294967295, and creating a store whose `transaction_bytes` plus 8 KiB
/// exceeds the authority's `max_entry` is `Unsupported(Size(..))`.
pub type StoreLimits {
  key_bytes: u64,
  value_bytes: u64,
  transaction_bytes: u64,
  range_rows: u64,
}

/// Why a store operation failed (STORE-13). `Storage(e)` is an error from the
/// authority; `Refused(e)` a request it refused before any effect;
/// `Corrupt(name)` a part of the history or an object that failed a check or
/// is missing; `Fenced()` a later writer's claim; `Closed()` a store closed
/// earlier. Each of these closes the store. `Unsupported(..)`, `NoLevel()`,
/// `Foreign()` and `InvalidInput()` are definite, have no effect and leave the
/// store open. `NotRetained()` is a version `at` reads that the store no
/// longer retains, and `PinReleased()` a reader pin `at_pin` reads that the
/// store no longer holds; both are definite and close nothing.
@serializable
pub type StoreError = Storage(AuthorityError) | Refused(AuthorityError) | Corrupt(
  String
) | Fenced | Closed | Unsupported(Unsupported) | NoLevel | Foreign | InvalidInput | NotRetained | PinReleased

/// What a store cannot do: open a record of another history format version
/// (`Format`, carrying the magic found and the record's name), create a store
/// whose groups would exceed the authority's largest entry (`Size`), or use
/// an object store that does not honour conditional writes (`Conditional`).
@serializable
pub type Unsupported = Format(found: Bytes, object: String) | Size(
  needed: u64,
  max_entry: u64
) | Conditional

/// How a transaction ended without its outcome: `Aborted(e)` when the body
/// returned `Error(e)` and its writes were discarded; `Canceled(cause)` before
/// the body started (only the call-stream form is canceled); `Faulted(f)` when
/// the body failed with `f` (FAIL-2), its writes discarded, nothing recorded
/// and the store usable; `Storage(e)` and
/// `Limit(..)` when nothing was committed; `Unknown(e)` when the commit was
/// attempted and the store could not tell whether it became durable, which the
/// next `open` decides.
@serializable
pub type TxFailure[E] = Aborted(E) | Canceled(CancelCause) | Faulted(Failure) | Storage(
  StoreError
) | Limit(TxLimit) | Unknown(StoreError)

/// Which of the configured limits a commit exceeded, or `Energy()` when its
/// body ran out of energy (STORE-11 "Energy").
@serializable
pub type TxLimit = KeyBytes | ValueBytes | TransactionBytes | RangeRows | Energy

/// Why a call returned no outcome of its own: `Tx(f)` as for `transact`;
/// `Denied()` when a later executor epoch holds the stream; `Rejected()` for a
/// position the stream cannot take, a retained position with another digest,
/// or a stream identity or request digest that is not 32 bytes.
@serializable
pub type CallFailure[E] = Tx(TxFailure[E]) | Denied | Rejected

// A stream's row under `hirsel.streams/<stream>`: the caller that owns it,
// its executor epoch, the last position applied, the last one the caller
// acknowledged, and the digest and call end of each position between them.
// The end is kept as the call ended, so a retry is answered without the code
// or the types that produced it.
@serializable
type StreamRow {
  owner: String,
  epoch: u64,
  applied: u64,
  acknowledged: u64,
  retained: List[Retained],
}

@serializable
type Retained {
  position: u64,
  digest: Bytes,
  end: CallEnd,
}

/// The store's visible version in its history, awaited with `durable`. It
/// carries the store identity, so it never names a version of another store.
pub opaque type Ticket: copyable + data + inert uses {} {
  identity: Bytes,
  version: u64,
}

/// One commit version of one store (STORE-8), `Version of a` for the store's
/// authority `a`: versions of one store compare in commit order, and nothing
/// else about them is observable.
// One word, the commit version V: its position in the store's commit order.
pub opaque type Version: copyable + plain + inert + ordered of uses {} {
  version: u64,
}

/// The immutable state of a store at one version: later commits never change
/// it. It holds no authority; queries read it on any task.
pub opaque type Snapshot: copyable uses {} {
  version: u64,
  index: ordered_map.OrderedMap[Bytes, Bytes],
  limits: StoreLimits,
  energy: u64,
}

/// A reader pin (STORE-8): the 16-byte token its acquirer drew, unique in the
/// store. It names no version: `at_pin` finds the one the place's durable
/// readers table holds for it.
// The token's bytes are `hi` then `lo`, each little-endian.
@serializable(check = decoded_pin)
pub opaque type ReaderPin: copyable + plain + sendable + inert + noalloc_drop uses {} {
  hi: u64,
  lo: u64,
}

// Every 16 bytes are a token.
@noalloc
fn decoded_pin(value: ReaderPin) -> bool uses {} {
  true
}

/// A reader pin an acquire holds (STORE-8): the pin's token and the version
/// the acquire pinned. Every acquire is a commit of its own, so a token
/// acquired again after a release holds a later version, and a held pin never
/// reads a later holder's state.
// The token's bytes are `hi` then `lo`, each little-endian.
@serializable(check = decoded_held)
pub opaque type HeldPin: copyable + plain + data + sendable + inert + noalloc_drop uses {} {
  hi: u64,
  lo: u64,
  version: u64,
}

// Every token and version is a held pin's.
@noalloc
fn decoded_held(value: HeldPin) -> bool uses {} {
  true
}

/// Why `acquire_reader_pin` pinned nothing: the store holds its most reader
/// pins, or the pin's token is held already, by any principal.
@serializable
pub type PinError = Limit | Taken

/// One reader pin holder, as the head's operator sees it: the version it
/// holds, the principal that acquired it and its id.
pub opaque type PinHolder: copyable uses {} {
  version: u64,
  principal: String,
  id: Bytes,
}

// A reader pin the store holds: the principal that acquired it, the version
// it holds and the locator of the record holding the commit that recorded
// it, at or after the record holding the version; empty while that commit is
// in the pending group.
type Reading {
  principal: String,
  version: u64,
  at: Bytes,
}

// A checkpoint a pinned version relies on, the locator of the group whose
// last commit is its version, its nodes, and how many reader holders and
// named pins rely on it (exact while the store's `counted` holds).
type Kept {
  desc: history.Descriptor,
  after: Bytes,
  refs: List[ObjectRef],
  count: u64,
}

// What a reader pin entry asks of the commit that records it.
type PinOp = Acquire(token: Bytes, principal: String) | Release(token: Bytes) | Pin(
  name: Bytes,
  version: u64
) | Unpin(name: Bytes)

/// What a store's head states about one transaction (STORE-4), the same for
/// every run of it: the caller's principal (empty for a local call), the
/// commit-order time (0: this head has no clock) and a seed fixed when the
/// transaction is ordered, and the call's id. A query is not ordered: its time
/// and seed are 0 and it has no id. Only the store mints one; `call_info`
/// reads it.
pub opaque type CallInfo: copyable + data + inert uses {} {
  caller: String,
  at: i64,
  seed: u64,
  // `call_id` of the identity in force and the commit version; empty for a
  // query.
  id: Bytes,
}

/// What one run of a body read (STORE-14), over byte keys. `points` holds
/// every key it read, whether or not the key held a value, in the order read
/// and possibly repeated; `spans` every interval a scan consumed. The run's
/// writes are its write set. A commit that writes no key in it cannot change
/// the run's outcome.
pub type AccessSet {
  points: List[Bytes],
  spans: List[Span],
}

/// The interval one scan consumed, from `from` to `to` in key order whatever
/// its `direction`: from the bound the scan started at to the last key it
/// examined, or to the range's far bound when it exhausted the range. A scan
/// cut short by its limit depends on no key past the cut.
pub type Span {
  from: ordered_map.Bound[Bytes],
  to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
}

// One run of a transaction body: the commit it reads at, that state with its
// own writes applied, its writes and its access set.
type Run {
  base: u64,
  state: ordered_map.OrderedMap[Bytes, Bytes],
  writes: ordered_map.OrderedMap[Bytes, Option[Bytes]],
  access: AccessSet,
  // The reader pins the store held at `base`, by token, and what a reader
  // pin entry asked of the run's commit.
  readers: ordered_map.OrderedMap[Bytes, Reading],
  pin: Option[PinOp],
}

/// The scoped capability a transaction entry holds: reads see the commit the
/// transaction began at plus its own writes. It cannot leave the entry, and it
/// reaches only the keys of its scope.
@capability(local)
pub opaque type Tx: () uses {Recorder} {
  txn: Run,
  limits: StoreLimits,
  scope: KeyScope,
  // The run's access set (STORE-14), recorded through borrowed reads: every
  // key read and every interval a scan consumed, as independently owned
  // bytes. A narrowed facet records into its own and hands its events to its
  // parent's when its body returns.
  points: Recorder[Bytes],
  spans: Recorder[Span],
}

/// One end of a key range: no limit, the key itself included, or excluded.
pub type RangeBound[K] = Unbounded | Included(K) | Excluded(K)

/// The order a range is returned in.
pub type ScanOrder = Ascending | Descending

/// What a key scope lets a `Tx` do with a key.
@serializable
pub type Access = Read | ReadWrite

/// Why a table's stored schema refuses the operation's key or value type.
@serializable
pub type SchemaError = KeyMismatch | ValueMismatch | Renamed(String, String)

/// The outcome of one failed operation inside a transaction body. A failed
/// operation changes nothing, and the body continues.
@serializable
pub type TxError = NoTable | TableExists | Schema(SchemaError) | ReadOnly | OutOfScope | InvalidInput | Limit(
  TxLimit
) | Storage(StoreError)

// One run of keys of a scope: the half-open byte interval [lo, hi), with no
// upper end for `None()`, read only or read and write.
type ScopeSpan {
  lo: Bytes,
  hi: Option[Bytes],
  write: bool,
}

/// A set of byte keys, each with an `Access`. Data without authority: it
/// grants nothing until a `Tx` is narrowed to it. Its spans are sorted,
/// disjoint and nonempty, with adjacent spans of equal access merged, so two
/// scopes holding the same keys with the same accesses are equal.
pub opaque type KeyScope: copyable + data + inert uses {} {
  spans: List[ScopeSpan],
  // Every key, read and write: the scope of an unnarrowed Tx.
  whole: bool,
}

// A group the history holds that is not yet known durable at every level:
// its position, its last version and the state at that version.
type Held {
  position: u64,
  version: u64,
  state: ordered_map.OrderedMap[Bytes, Bytes],
}

// A group submitted to the authority and not yet answered: its position, its
// last version and the index of the level it was submitted at.
type Submitted {
  position: u64,
  version: u64,
  level: u64,
}

/// The head of one store: its only writer (STORE-1). It keeps the store's
/// authority and claim; a later claim of the authority fences it.
pub opaque type Store: () uses {Authority} {
  authority: Authority,
  // The claim, unbranded in a field: `claim.narrow` recovers it for the
  // authority at each use. None once the store is closed.
  claim: Option[Claim],
  // The authority's declared level names, weakest first, and the floor's index.
  levels: List[String],
  floor: u64,
  max_entry: u64,
  config: StoreConfig,
  // As the Genesis commit recorded them.
  limits: StoreLimits,
  bounds: history.Bounds,
  identity: Bytes,
  // `seed_key` of the identity: the start of the default seed stream (STORE-4).
  seed_key: u64,
  // The state at V, the visible version.
  index: ordered_map.OrderedMap[Bytes, Bytes],
  visible: u64,
  // An empty access set whose lists keep the capacity an earlier run grew,
  // so a run records its reads without allocating once the store is warm.
  spare: AccessSet,
  // The epoch of the store's claim, the objects the next submitted group
  // inventories and those it retires, the objects the history created and no
  // record retired, by `history.ref_key`, and the newest checkpoint's nodes
  // by digest: the objects a checkpoint may reuse.
  epoch: u64,
  created: List[ObjectRef],
  retired: List[ObjectRef],
  made: ordered_map.OrderedMap[Bytes, ObjectRef],
  live: ordered_map.OrderedMap[Bytes, ObjectRef],
  // The history's end position, and the newest group's position, digest and
  // the version of its last commit, which a checkpoint names.
  end: u64,
  group_at: u64,
  digest: Bytes,
  group_last: u64,
  // The group being filled, the entries its commits ran, and their encoded size.
  pending: Option[history.GroupWriter],
  defs: List[history.Def],
  defs_bytes: u64,
  // D(L) for each declared level, and the groups whose states some D(L) needs.
  durable: List[u64],
  held: List[Held],
  // Groups submitted and not yet answered, oldest first: empty but while a
  // serve holds several groups' ends.
  submitted: List[Submitted],
  // While a serve runs an arrival, the highest version its output gates asked
  // for: the serve releases the arrival's end once that version is durable.
  deferred: Option[u64],
  // The retention state the newest Retain commit records (STORE-8): the
  // floor, the named pins, the reader pins by token and the checkpoints
  // pinned versions rely on, with their nodes; and the newest checkpoint,
  // whose nodes are `live`.
  retain_floor: u64,
  pins: List[history.Pin],
  readers: ordered_map.OrderedMap[Bytes, Reading],
  kept: List[Kept],
  newest: Option[history.Descriptor],
  // The locator of the group whose last commit is the newest checkpoint's
  // version (`no_locator()` before the first); the locator of the newest record holding a Retain or
  // ReaderDelta commit, the ReaderDelta commits since the newest Retain, and
  // whether the pending group holds either kind.
  newest_after: Bytes,
  retain_loc: Bytes,
  deltas: u64,
  retaining: bool,
  // Whether each kept checkpoint's count is exact: false from open, and
  // after a checkpoint changes which one a version relies on, until the next
  // Retain fold counts them again.
  counted: bool,
  closed: bool,
}

// A Retain is written in place of a ReaderDelta once the deltas since the
// newest Retain would reach the holder count or this many (STORE-8), so a
// newest-first lookup reads at most this many records and the newest group.
const FOLD_DELTAS: u64 = 32

// The overhead the format allows a group beyond its largest commit: header,
// definition table and framing (STORE-11 "Bounds").
const GROUP_OVERHEAD: u64 = 8192

// Entries read from the authority per request.
const READ_BATCH: u64 = 1024

/// Groups of up to 64 commits or 4 MiB, checkpoint batches of 64 MiB, limits of 4096-byte keys, 1 MiB
/// values, 16 MiB per transaction and 10000 rows per range, the default
/// checkpoint node bounds, and 10^9 units of energy per body.
pub fn default_config() -> StoreConfig uses {} {
  StoreConfig(
    group_commits: 64,
    group_bytes: 4194304,
    batch_bytes: 67108864,
    limits: StoreLimits(
      key_bytes: 4096,
      value_bytes: 1048576,
      transaction_bytes: 16777216,
      range_rows: 10000
    ),
    nodes: history.default_bounds(),
    energy: 1000000000
  )
}

/// Whether `key` lies in `hirsel.`, the key space the store keeps for its own
/// rows; a transaction body writes no key there.
pub fn reserved(key: Bytes) -> bool uses {} {
  // The first byte settles nearly every key: the namespace begins with `h`.
  let prefix = b"hirsel."
  bytes.len(key) >= bytes.len(prefix) && key[0] == prefix[0] && bytes.slice(
    key,
    0,
    bytes.len(prefix)
  ) == prefix
}

/// Byte-lexicographic order, a proper prefix first: the order of every key.
@noalloc
pub fn compare_keys(a: Bytes, b: Bytes) -> i32 uses {} {
  if a < b {
    -1
  } else if b < a {
    1
  } else {
    0
  }
}

/// The bounds that select exactly the keys starting with `prefix`.
pub fn prefix_bounds(prefix: Bytes) -> (
  ordered_map.Bound[Bytes],
  ordered_map.Bound[Bytes]
) uses {} {
  let low: ordered_map.Bound[Bytes] = Included(unique prefix)
  // The least key above every extension of the prefix: drop trailing 0xff
  // bytes and increment the last remaining one; none left means no bound.
  let mut end: List[u8] = []
  for b in prefix {
    list.push(mut end, b)
  }
  while list.len(end) > 0 {
    let last = list.len(end) - 1
    if end[last] == 255 {
      let _ = list.pop(mut end)
    } else {
      end[last] = end[last] + 1
      let high: ordered_map.Bound[Bytes] = Excluded(bytes.from_list(take end))
      return (take low, take high)
    }
  }
  (take low, Unbounded())
}

/// Opens or creates the store `a` keeps and claims it as its writer (STORE-1):
/// the claim appends a claim record with the next writer epoch, fencing every
/// earlier head; the store then recovers the newest state the history holds.
/// A history holding nothing but claims, the first open's included when a
/// failure cut it before its Genesis, is no store: the open writes the
/// Genesis commit, which records `config.limits` and `config.nodes`; an
/// existing store keeps its own. Limits no group could frame within the
/// authority's entries are refused with `Unsupported(Size(..))`, and limits
/// over 4294967295 or node bounds that do not hold them with `InvalidInput()`,
/// before the claim, whether or not the store exists, so the refusal has no
/// effect.
pub fn open(a: Authority, config: StoreConfig) -> Result[Store, StoreError] {
  creatable(config.limits, config.nodes, authority.max_entry(a))?
  let made = match authority.claim(a) {
    Ok(c) => c,
    Error(e) => return Error(seam(take e)),
  }
  let c: Claim = take made
  let end = claim.end(c)
  let mut names: List[String] = []
  for l in authority.levels(a) {
    list.push(mut names, level.name(l))
  }
  let floor_name = level.name(authority.floor(a))
  let mut floor: u64 = 0
  for i in 0u64..list.len(names) {
    if names[i] == floor_name {
      floor = i
    }
  }
  let mut reached: List[u64] = []
  for _ in names {
    list.push(mut reached, 0)
  }
  let mut s = Store(
    authority: a,
    claim: Some(take c),
    levels: take names,
    floor: floor,
    max_entry: authority.max_entry(a),
    config: config,
    limits: config.limits,
    bounds: config.nodes,
    identity: b"",
    seed_key: 0,
    index: ordered_map.empty(compare_keys),
    visible: 0,
    spare: AccessSet(points: [], spans: []),
    epoch: 0,
    created: [],
    retired: [],
    made: ordered_map.empty(compare_keys),
    live: ordered_map.empty(compare_keys),
    end: 0,
    group_at: 0,
    digest: history.zero_digest(),
    group_last: 0,
    pending: None(),
    defs: [],
    defs_bytes: 0,
    durable: take reached,
    held: [],
    submitted: [],
    deferred: None(),
    retain_floor: 0,
    pins: [],
    readers: ordered_map.empty(compare_keys),
    kept: [],
    newest: None(),
    newest_after: history.no_locator(),
    retain_loc: history.no_locator(),
    deltas: 0,
    retaining: false,
    counted: false,
    closed: false
  )
  let created = recover(a, mut s, end)?
  if created {
    genesis(a, mut s, config.limits, config.nodes)?
  }
  collect(mut s)?
  Ok(take s)
}

// What a pass over the history knows after the records through `here`: the
// tip; the groups after the newest checkpoint, with their digests, the version
// of their first commit and their positions; the group at the base's `first`
// - 1 (digest, last version, position), whose commits are below every
// checkpoint in force; the newest group; the newest checkpoint, the position
// of its group and of its record; the recorded creation tuple; the newest
// Retain's floor, named pins and kept checkpoints, the readers table it and
// the ReaderDelta commits since record, how many those are, and the newest
// record holding either kind; the newest claim's epoch; and the objects the
// records created and none retired.
type Scan {
  tip: history.Tip,
  here: u64,
  since: List[(history.Group, Bytes, u64, u64)],
  boundary: Option[(Bytes, u64, u64)],
  newest: (Bytes, u64, u64),
  checkpoint: Option[history.Descriptor],
  checkpoint_after: u64,
  checkpoint_at: u64,
  recorded: Option[history.Creation],
  retention: Option[(u64, List[history.Pin], List[history.Root])],
  table: ordered_map.OrderedMap[Bytes, Reading],
  deltas: u64,
  retain_loc: Bytes,
  epoch: u64,
  made: ordered_map.OrderedMap[Bytes, ObjectRef],
}

// The selected base's bootstrap and the objects live below its `first`,
// none when no base is selected (STORE-11 **Bases**).
fn read_base(a: Authority) -> Result[
  Option[(history.Boot, List[ObjectRef])],
  StoreError
] {
  let records = match authority.base(a) {
    Ok(x) => x,
    Error(e) => return Error(seam(take e)),
  }
  if list.len(records) == 0 {
    return Ok(None())
  }
  let Appended(boot, live, _) = records[0] else {
    return Error(Corrupt("hirsel.base"))
  }
  match history.decode_boot(boot) {
    Ok(b) => Ok(Some((take b, copy live))),
    Error(Unsupported(found: found)) => Error(
      Unsupported(Format(found: unique found, object: "hirsel.base"))
    ),
    Error(Corrupt()) => Error(Corrupt("hirsel.base")),
  }
}

// The readers table a bootstrap records, by token; `Error(())` for a
// principal that is not text.
fn boot_table(holders: List[history.Holding]) -> Result[
  ordered_map.OrderedMap[Bytes, Reading],
  ()
] uses {} {
  let mut entries: List[(Bytes, Reading)] = []
  for h in holders {
    let Ok(principal) = string.from_bytes(unique h.principal) else {
      return Error(())
    }
    list.push(
      mut entries,
      (
        unique h.token,
        Reading(principal: take principal, version: h.version, at: unique h.at)
      )
    )
  }
  ordered_map.from_sorted(compare_keys, take entries)
}

// A pass at the selected base, or at the history's start when none is
// selected: what a reader that followed the records below `first` knows.
fn based(a: Authority, mut s: Store) -> Result[Scan, StoreError] {
  let mut sc = Scan(
    tip: history.origin_tip(),
    here: 0,
    since: [],
    boundary: None(),
    newest: (history.zero_digest(), 0, 0),
    checkpoint: None(),
    checkpoint_after: 0,
    checkpoint_at: 0,
    recorded: None(),
    retention: None(),
    table: ordered_map.empty(compare_keys),
    deltas: 0,
    retain_loc: history.no_locator(),
    epoch: 0,
    made: ordered_map.empty(compare_keys)
  )
  let read = match read_base(a) {
    Ok(x) => x,
    Error(e) => return Error(stop(mut s, take e)),
  }
  let Some((b, live)) = take read else {
    return Ok(take sc)
  }
  let edge = b.first - 1
  sc.tip = history.Tip(last: b.last, identity: unique b.identity, created: true)
  sc.here = edge
  sc.boundary = Some((unique b.group, b.last, edge))
  sc.newest = (unique b.group, b.last, edge)
  sc.recorded = Some(copy b.creation)
  sc.retain_loc = unique b.retain
  sc.deltas = b.deltas
  if let Some(r) = b.retained {
    let Ok(table) = boot_table(r.holders) else {
      return Error(stop(mut s, Corrupt("hirsel.base")))
    }
    sc.table = take table
    sc.retention = Some((r.floor, copy r.pins, copy r.roots))
  }
  for r in live {
    ordered_map.insert(mut sc.made, history.ref_key(r), copy r)
  }
  Ok(take sc)
}

// Reads the records after `sc.here` through `end` at `level` into `sc`:
// numbers the commits (a claim record is one, an appended record's group its
// commits), checks each group's fields and rules against the records before
// it, and notes what `Scan` holds. The authority has checked the records'
// chain.
fn scan_history(a: Authority, mut s: Store, mut sc: Scan, end: u64, level: Level of a) -> Result[
  (),
  StoreError
] {
  while sc.here < end {
    // No more than the records through `end`: a selection's scan stops
    // short of the head's end, and an objects provider gets each one.
    let want = if end - sc.here < READ_BATCH {
      end - sc.here
    } else {
      READ_BATCH
    }
    let records = match authority.read(a, sc.here, level, want) {
      Ok(x) => x,
      Error(e) => return Error(stop(mut s, seam(take e))),
    }
    if list.len(records) == 0 {
      return Error(stop(mut s, Corrupt(entry_name(sc.here + 1))))
    }
    for item in records {
      if sc.here == end {
        break
      }
      sc.here += 1
      let here = sc.here
      let (e, created, retired) = match item {
        Claimed(n, _, identity) => {
          sc.tip = history.claimed(sc.tip, identity)
          sc.epoch = n
          continue
        },
        Appended(e, created, retired) => (copy e, copy created, copy retired),
      }
      let g = match history.decode_group(e) {
        Ok(x) => x,
        Error(Unsupported(found: found)) => return Error(
          stop(
            mut s,
            Unsupported(Format(found: unique found, object: entry_name(here)))
          )
        ),
        Error(Corrupt()) => return Error(stop(mut s, Corrupt(entry_name(here)))),
      }
      let first = sc.tip.last + 1
      let Ok(next) = history.follow(sc.tip, g) else {
        return Error(stop(mut s, Corrupt(entry_name(here))))
      }
      sc.tip = take next
      // Each group names the newest retention record before it.
      if g.retain != sc.retain_loc {
        return Error(stop(mut s, Corrupt(entry_name(here))))
      }
      let d = history.digest(e)
      sc.newest = (copy d, sc.tip.last, here)
      // A retention commit's zero locators name its own record.
      let mut here_loc = history.no_locator()
      for x in g.commits {
        match x.body {
          Engine(Retain(..)) | Engine(ReaderDelta(_)) => {
            if here_loc == history.no_locator() {
              here_loc = located(a, mut s, here)?
            }
          },
          _ => {},
        }
      }
      let mut objects = false
      for x in g.commits {
        match x.body {
          Engine(Genesis(k)) => {
            sc.recorded = Some(copy k)
          },
          Engine(Checkpoint(desc)) => {
            // Its version is a group's last, and that group is before it: in
            // the groups since the newest checkpoint, or the base's.
            let mut kept: List[(history.Group, Bytes, u64, u64)] = []
            let mut found = false
            if let Some((bd, blast, bat)) = sc.boundary {
              if blast == desc.version {
                found = bd == desc.digest
                sc.checkpoint_after = bat
              }
            }
            let since = replace(mut sc.since, [])
            for (h, hd, hfirst, hat) in since {
              let last = hfirst + list.len(h.commits) - 1
              if last == desc.version {
                found = hd == desc.digest
                sc.checkpoint_after = hat
              }
              if last > desc.version {
                list.push(mut kept, (copy h, copy hd, hfirst, hat))
              }
            }
            if !found {
              return Error(stop(mut s, Corrupt(entry_name(here))))
            }
            sc.since = take kept
            sc.checkpoint = Some(copy desc)
            sc.checkpoint_at = here
            objects = true
          },
          Engine(Objects()) => {
            objects = true
          },
          Engine(Retain(floor: f, creation: c, pins: p, readers: r, checkpoints: k)) => {
            // A fold repeats the creation tuple the Genesis recorded.
            let same = match sc.recorded {
              Some(recorded_creation) => recorded_creation == c,
              None() => false,
            }
            let Ok(folded) = reading_table(r, here_loc) else {
              return Error(stop(mut s, Corrupt(entry_name(here))))
            }
            if !same {
              return Error(stop(mut s, Corrupt(entry_name(here))))
            }
            sc.table = take folded
            sc.retention = Some((f, copy p, copy k))
            sc.deltas = 0
            sc.retain_loc = copy here_loc
          },
          Engine(ReaderDelta(change)) => {
            // A delta changes the table a Retain before it recorded.
            if sc.retention == None() || reading_change(mut sc.table, change, here_loc) != Ok(
              ()
            ) {
              return Error(stop(mut s, Corrupt(entry_name(here))))
            }
            sc.deltas += 1
            sc.retain_loc = copy here_loc
          },
          _ => {},
        }
      }
      // Only a record holding an Objects or a Checkpoint commit inventories
      // or retires objects, and it retires only what an earlier record made.
      if !objects && (list.len(created) > 0 || list.len(retired) > 0) {
        return Error(stop(mut s, Corrupt(entry_name(here))))
      }
      for r in created {
        ordered_map.insert(mut sc.made, history.ref_key(r), copy r)
      }
      for r in retired {
        if let None() = ordered_map.remove(mut sc.made, history.ref_key(r)) {
          return Error(stop(mut s, Corrupt(entry_name(here))))
        }
      }
      list.push(mut sc.since, (take g, take d, first, here))
    }
  }
  Ok(())
}

// Reads the history from the selected base (or its start) to the claim's
// record at `end` (`scan_history`), applies the commits after the newest
// checkpoint onto its state, and adopts the recorded limits. True when the
// history holds nothing but claims, so the store is new: `history.follow`
// admits no other commit before the Genesis. With a base, the newest
// checkpoint is after it.
fn recover(a: Authority, mut s: Store, end: u64) -> Result[bool, StoreError] {
  let mut sc = based(a, mut s)?
  if sc.here > end {
    return Error(stop(mut s, Corrupt("hirsel.base")))
  }
  scan_history(a, mut s, mut sc, end, authority.floor(a))?
  if sc.boundary != None() && sc.checkpoint == None() {
    return Error(stop(mut s, Corrupt("hirsel.base")))
  }
  let tip = replace(mut sc.tip, history.origin_tip())
  let since = replace(mut sc.since, [])
  let checkpoint = replace(mut sc.checkpoint, None())
  let made = replace(mut sc.made, ordered_map.empty(compare_keys))
  let checkpoint_at = sc.checkpoint_at
  let checkpoint_after = sc.checkpoint_after
  let mut state: ordered_map.OrderedMap[Bytes, Bytes] = ordered_map.empty(compare_keys)
  let mut from: u64 = 0
  if let Some(desc) = checkpoint {
    state = load_checkpoint(a, mut s, desc, made, checkpoint_at)?
    from = desc.version
  }
  for (g, _, first, _) in since {
    let mut at_version = first
    for x in g.commits {
      if at_version > from {
        apply(mut state, x.writes)
      }
      at_version += 1
    }
  }
  s.index = take state
  s.made = take made
  s.newest = copy checkpoint
  s.newest_after = if checkpoint_after == 0 {
    history.no_locator()
  } else {
    located(a, mut s, checkpoint_after)?
  }
  s.retain_loc = replace(mut sc.retain_loc, b"")
  s.deltas = sc.deltas
  if let Some((f, pins, kept)) = replace(mut sc.retention, None()) {
    let table = replace(mut sc.table, ordered_map.empty(compare_keys))
    adopt(a, mut s, f, take pins, take table, kept)?
  }
  s.visible = tip.last
  s.identity = unique tip.identity
  s.seed_key = seed_key(s.identity)
  s.epoch = sc.epoch
  s.end = end
  let (newest_digest, newest_last, newest_at) = replace(mut sc.newest, (b"", 0, 0))
  s.digest = take newest_digest
  s.group_last = newest_last
  s.group_at = newest_at
  for i in 0u64..list.len(s.durable) {
    s.durable[i] = tip.last
  }
  s.held = [Held(position: end, version: tip.last, state: current(mut s))]
  match replace(mut sc.recorded, None()) {
    Some(k) => {
      s.limits = store_limits(k.limits)
      s.bounds = copy k.bounds
      Ok(false)
    },
    None() => Ok(true),
  }
}

// Takes the retention state the newest Retain and the ReaderDelta commits
// since record: a takeover inherits every reader pin. A kept checkpoint's
// nodes are the live ones when it is the newest, and are read from its tree
// otherwise.
fn adopt(
  a: Authority,
  mut s: Store,
  floor: u64,
  take pins: List[history.Pin],
  take table: ordered_map.OrderedMap[Bytes, Reading],
  kept: List[history.Root]
) -> Result[(), StoreError] {
  s.retain_floor = floor
  s.pins = take pins
  s.readers = take table
  let mut out: List[Kept] = []
  for k in kept {
    let d = k.desc
    let newest = match s.newest {
      Some(n) => n.version == d.version,
      None() => false,
    }
    let refs = if newest {
      made_refs(s.live)
    } else {
      match read_tree(a, d) {
        Ok((_, refs)) => take refs,
        // A tree is fetched by digest: nothing in it moves.
        Error(Missing()) | Error(Moved()) => return Error(
          stop(mut s, Corrupt("hirsel.checkpoint"))
        ),
        Error(Failed(e)) => return Error(stop(mut s, take e)),
      }
    }
    list.push(
      mut out,
      Kept(desc: unique d, after: unique k.after, refs: take refs, count: 0)
    )
  }
  s.kept = take out
  s.counted = false
  Ok(())
}

// The locator a retention commit in the record at `here` names: its own,
// `here`, for `no_locator()`.
fn resolved(loc: Bytes, here: Bytes) -> Bytes uses {} {
  if loc == history.no_locator() {
    unique here
  } else {
    unique loc
  }
}

// The readers table a Retain in the record at `here` records, by token;
// `Error(())` for a principal that is not text.
fn reading_table(readers: List[history.Reader], here: Bytes) -> Result[
  ordered_map.OrderedMap[Bytes, Reading],
  ()
] uses {} {
  let mut table: ordered_map.OrderedMap[Bytes, Reading] = ordered_map.empty(
    compare_keys
  )
  for r in readers {
    for h in r.holders {
      let Ok(principal) = string.from_bytes(unique h.principal) else {
        return Error(())
      }
      ordered_map.insert(
        mut table,
        unique h.token,
        Reading(principal: take principal, version: r.version, at: resolved(r.at, here))
      )
    }
  }
  Ok(take table)
}

// `table` after the change of a ReaderDelta in the record at `here`:
// `Error(())` for a holder of a token the table holds, a gone token it does
// not hold, a principal that is not text or a table past `MAX_HOLDERS`.
fn reading_change(
  mut table: ordered_map.OrderedMap[Bytes, Reading],
  change: history.ReaderChange,
  here: Bytes
) -> Result[(), ()] uses {} {
  match change {
    Hold(token: token, principal: principal, version: held, at: loc) => {
      let Ok(who) = string.from_bytes(unique principal) else {
        return Error(())
      }
      if ordered_map.contains(table, token) || ordered_map.len(table) >= history.MAX_HOLDERS {
        return Error(())
      }
      ordered_map.insert(
        mut table,
        unique token,
        Reading(principal: take who, version: held, at: resolved(loc, here))
      )
    },
    Free(token: token) => {
      if let None() = ordered_map.remove(mut table, token) {
        return Error(())
      }
    },
  }
  Ok(())
}

// The state a checkpoint records, read level by level from its root, each
// node checked against the digest its parent names; it sets the store's live
// objects to the checkpoint's nodes. The checkpoint's record is at `at`:
// every node is one of `made`, which a record at or before it created, so
// reclamation never removes it.
fn load_checkpoint(
  a: Authority,
  mut s: Store,
  desc: history.Descriptor,
  made: ordered_map.OrderedMap[Bytes, ObjectRef],
  here: u64
) -> Result[ordered_map.OrderedMap[Bytes, Bytes], StoreError] {
  let mut live: ordered_map.OrderedMap[Bytes, ObjectRef] = ordered_map.empty(
    compare_keys
  )
  let mut expects = [history.root_expect(desc)]
  while true {
    let mut blobs: List[Bytes] = []
    for x in expects {
      let r = x.r
      if r.lifetime > here || !ordered_map.contains(made, history.ref_key(r)) {
        return Error(stop(mut s, Corrupt(entry_name(here))))
      }
      match authority.get(a, copy r) {
        Ok(Some(b)) => list.push(mut blobs, take b),
        Ok(None()) => return Error(stop(mut s, Corrupt(entry_name(here)))),
        Error(e) => return Error(stop(mut s, seam(take e))),
      }
      ordered_map.insert(mut live, copy r.digest, copy r)
    }
    match history.check_level(expects, blobs) {
      Ok(Next(more)) => {
        expects = take more
      },
      Ok(Leaves(entries)) => {
        let Ok(state) = ordered_map.from_sorted(compare_keys, take entries) else {
          return Error(stop(mut s, Corrupt(entry_name(here))))
        }
        s.live = take live
        return Ok(take state)
      },
      Error(Unsupported(found: found)) => return Error(
        stop(mut s, Unsupported(Format(found: unique found, object: entry_name(here))))
      ),
      Error(Corrupt()) => return Error(stop(mut s, Corrupt(entry_name(here)))),
    }
  }
  Ok(ordered_map.empty(compare_keys))
}

// Whether a store with these limits and node bounds could be created over an
// authority whose entries hold at most `max_entry` bytes. It is checked before
// the claim, so a refused creation has no effect.
fn creatable(limits: StoreLimits, nodes: history.Bounds, max_entry: u64) -> Result[
  (),
  StoreError
] uses {} {
  let most: u64 = 4294967295
  if limits.key_bytes > most || limits.value_bytes > most || limits.transaction_bytes > most || limits.range_rows > most {
    return Error(InvalidInput())
  }
  if !history.bounds_fit(
    int.narrow(limits.key_bytes),
    int.narrow(limits.value_bytes),
    nodes
  ) {
    return Error(InvalidInput())
  }
  let needed = limits.transaction_bytes + GROUP_OVERHEAD
  if needed > max_entry {
    return Error(Unsupported(Size(needed: needed, max_entry: max_entry)))
  }
  Ok(())
}

// Records a new store's limits and checkpoint bounds as the commit after the
// history's claims, durable at every level before `open` returns.
fn genesis(a: Authority, mut s: Store, limits: StoreLimits, bounds: history.Bounds) -> Result[
  (),
  StoreError
] {
  s.limits = limits
  s.bounds = copy bounds
  let body: history.Body = Engine(
    Genesis(history.Creation(limits: recorded_as(limits), bounds: take bounds))
  )
  let t = serial(mut s)
  let _ = commit(mut s, take t, take body, None()) ? unreleased
  strongest(a, mut s) ? unreleased
  Ok(())
}

// The limits as the creation tuple records them; `creatable` has
// checked that each fits.
fn recorded_as(l: StoreLimits) -> history.Limits uses {} {
  history.Limits(
    key_bytes: int.narrow(l.key_bytes),
    value_bytes: int.narrow(l.value_bytes),
    transaction_bytes: int.narrow(l.transaction_bytes),
    range_rows: int.narrow(l.range_rows)
  )
}

fn store_limits(l: history.Limits) -> StoreLimits uses {} {
  StoreLimits(
    key_bytes: int.widen(l.key_bytes),
    value_bytes: int.widen(l.value_bytes),
    transaction_bytes: int.widen(l.transaction_bytes),
    range_rows: int.widen(l.range_rows)
  )
}

// The locator of the record at `p`, which the store's claim has queued or its
// handle has followed. A store with no live claim closes.
fn located(a: Authority, mut s: Store, p: u64) -> Result[Bytes, StoreError] {
  let Some(held) = replace(mut s.claim, None()) else {
    return Error(stop(mut s, Closed()))
  }
  let Some(narrowed) = claim.narrow(a, take held) else {
    return Error(stop(mut s, Closed()))
  }
  let mut c = take narrowed
  let r = authority.locate(a, mut c, p)
  let back: Claim = take c
  s.claim = Some(take back)
  match take r {
    Ok(l) => Ok(take l),
    Error(e) => Error(stop(mut s, seam(take e))),
  }
}

// A history position as the name a refusal carries.
fn entry_name(position: u64) -> String uses {} {
  f"history/{position}"
}

// The store error a seam error is (STORE-11).
fn seam(take e: SeamError) -> StoreError uses {} {
  match e {
    Storage(x) => Storage(copy x),
    Refused(x) => Refused(copy x),
    Corrupt(name) => Corrupt(copy name),
    Fenced() => Fenced(),
    Format(found, object) => Unsupported(Format(found: copy found, object: copy object)),
  }
}

// Deletions a library has committed to, such as the typed-table library's
// dropped tables and the generations a migration replaces or abandons
// (STORE-5, STORE-9): one key per key prefix to delete, `hirsel.garbage/`
// followed by the prefix, with an empty value. `collect` runs at every open, so a crash leaves no deletion half done.
fn garbage(prefix: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, b"hirsel.garbage/")
  bytes.append(mut out, prefix)
  bytes.from_list(take out)
}

// The step a deletion's commits record as the store's own (STORE-11 Library).
const COLLECT_STEP: Bytes = b"std@1/store.collect"

// Carries out every garbage entry in key order: deletes the keys under its
// prefix in commits within the store's limits, then, in one more commit,
// removes the entry. A crash between these commits leaves the rest to the next call. A failure closes the store, so no
// transaction runs while garbage remains that its deleter left: a generation
// number is reused only once its garbage is gone (STORE-9).
fn collect(mut s: Store) -> Result[(), StoreError] {
  match collect_all(mut s) {
    Ok(()) => Ok(()),
    Error(e) => Error(stop(mut s, take e)),
  }
}

fn collect_all(mut s: Store) -> Result[(), StoreError] {
  let (low, high) = prefix_bounds(b"hirsel.garbage/")
  while true {
    let mut t = serial(mut s)
    let _ = read_span(mut t.access, unique low, unique high, Ascending(), 1, [])
    let found = entries_in(t.state, low, high, Ascending(), 1)
    if list.len(found) == 0 {
      discard(mut s, take t)
      return Ok(())
    }
    let (entry, _) = unique found[0]
    let skip = bytes.len(b"hirsel.garbage/")
    let (from, to) = prefix_bounds(bytes.slice(entry, skip, bytes.len(entry)))
    if delete_within(mut t, s.limits, from, to) && ordered_map.len(t.writes) == 0 {
      run_delete(mut t, unique entry)
    } else if ordered_map.len(t.writes) == 0 {
      // No single delete fits the commit limit.
      discard(mut s, take t)
      return Error(stop(mut s, Corrupt("hirsel.garbage")))
    }
    let body: history.Body = Engine(Library(name: COLLECT_STEP, payload: b""))
    settle(mut s, take t, take body, None()) ? unreleased
  }
  Ok(())
}

// Deletes keys in [low, high) in key order while the commit of `t`, which
// writes nothing else, stays within `limits`; true when none remain. The
// whole span is in `t`'s reads.
fn delete_within(
  mut t: Run,
  limits: StoreLimits,
  low: ordered_map.Bound[Bytes],
  high: ordered_map.Bound[Bytes]
) -> bool uses {} {
  let _ = read_span(mut t.access, unique low, unique high, Ascending(), 1, [])
  // A Library commit's own bytes and the step's name, then per delete an op
  // and a length; every delete costs at least six bytes.
  let mut total: u64 = 64
  for (key, _) in entries_in(
    t.state,
    low,
    high,
    Ascending(),
    limits.transaction_bytes / 6 + 1
  ) {
    total += 5 + bytes.len(key)
    if total > limits.transaction_bytes {
      return false
    }
    run_delete(mut t, unique key)
  }
  list.len(entries_in(t.state, low, high, Ascending(), 1)) == 0
}

/// The store's visible version V: a transaction's own commit when taken right
/// after it (STORE-2).
pub fn ticket(s: Store) -> Ticket uses {} {
  Ticket(identity: copy_to(heap, s.identity), version: s.visible)
}

/// Returns once every commit up to `t` is durable at `at` (STORE-2),
/// advancing the pending group if needed. `NoLevel()` when `s` does not keep
/// `a`, and `Foreign()` for a ticket of another store; neither changes the
/// store. Any other error closes it and never claims the commit is lost.
pub fn durable(a: Authority, mut s: Store, t: Ticket, here: Level of a) -> Result[
  (),
  StoreError
] {
  if s.closed {
    return Error(Closed())
  }
  let Some(i) = level_index(s, here) else {
    return Error(NoLevel())
  }
  if t.identity != s.identity {
    return Error(Foreign())
  }
  if t.version <= s.durable[i] {
    return Ok(())
  }
  wait(a, mut s, here, i) ? unreleased
  Ok(())
}

/// The state at `D(at)` (STORE-8): every commit durable at `at`, no later
/// one. It waits for nothing and costs O(1); reading one's own write takes
/// `durable` on its ticket first. `NoLevel()` when `s` does not keep `a`.
pub fn snapshot(a: Authority, mut s: Store, here: Level of a) -> Result[
  Snapshot of a,
  StoreError
] {
  if s.closed {
    return Error(Closed())
  }
  let Some(i) = level_index(s, here) else {
    return Error(NoLevel())
  }
  let Some((wanted, share)) = durable_state(mut s, i) else {
    return Error(Corrupt("snapshot"))
  }
  Ok(
    Snapshot(
      version: wanted,
      index: take share,
      limits: s.limits,
      energy: s.config.energy
    )
  )
}

// The version durable at the `i`th declared level and a share of its state.
fn durable_state(mut s: Store, i: u64) -> Option[
  (u64, ordered_map.OrderedMap[Bytes, Bytes])
] {
  let wanted = s.durable[i]
  for k in 0u64..list.len(s.held) {
    if s.held[k].version == wanted {
      // Moved out, shared and put back: a share of an owned map is owned.
      let state = replace(mut s.held[k].state, ordered_map.empty(compare_keys))
      let share = copy state
      s.held[k].state = take state
      return Some((wanted, take share))
    }
  }
  None()
}

/// The version a snapshot reflects: every commit up to it, no later one. `a`
/// names the comparison domain and exercises no authority.
pub fn version(a: Authority, snap: Snapshot of a) -> Version of a uses {} {
  Version(version: snap.version)
}

/// The value stored under `key` in the snapshot.
pub fn get(snap: Snapshot, key: Bytes) -> Option[Bytes] in snap uses {} {
  ordered_map.get(snap.index, key)
}

/// At most `limit` entries of the snapshot with keys between `from` and `to`,
/// in `direction` order, as fresh copies. Page by passing `Excluded` of the
/// last key received.
pub fn range(
  snap: Snapshot,
  from: ordered_map.Bound[Bytes],
  to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64
) -> List[(Bytes, Bytes)] uses {} {
  entries_in(snap.index, from, to, direction, limit)
}

// The index of the level `at` among the store's levels, None when `at` is not
// a level of the store's authority.
fn level_index(s: Store, here: Level) -> Option[u64] {
  let Some(_) = level.narrow(s.authority, here) else {
    return None()
  }
  let name = level.name(here)
  for i in 0u64..list.len(s.levels) {
    if s.levels[i] == name {
      return Some(i)
    }
  }
  None()
}

// A run at the latest commit, for a call that holds the store from the run to
// its commit, so no commit lands in between.
fn serial(mut s: Store) -> Run uses {} {
  Run(
    base: s.visible,
    state: current(mut s),
    writes: ordered_map.empty(compare_keys),
    access: replace(mut s.spare, AccessSet(points: [], spans: [])),
    readers: shared_readers(mut s),
    pin: None()
  )
}

// A share of the store's reader pins: moved out, shared and put back.
fn shared_readers(mut s: Store) -> ordered_map.OrderedMap[Bytes, Reading] uses {} {
  let readers = replace(mut s.readers, ordered_map.empty(compare_keys))
  let share = copy readers
  s.readers = take readers
  take share
}

// Keeps `a`'s list capacity for the next run, emptied.
fn reuse(mut s: Store, take a: AccessSet) -> () uses {} {
  let mut kept = take a
  core@1/list.truncate(mut kept.points, 0)
  core@1/list.truncate(mut kept.spans, 0)
  s.spare = take kept
}

// Drops a run's writes, keeping its access set's capacity.
fn discard(mut s: Store, take t: Run) -> () uses {} {
  let Run(access: access, ..) = take t
  reuse(mut s, take access)
}

// Stores `value` under `key` when the run commits.
fn run_put(mut t: Run, take key: Bytes, take value: Bytes) -> () uses {} {
  ordered_map.insert(mut t.state, copy key, copy value)
  ordered_map.insert(mut t.writes, take key, Some(take value))
}

// Removes `key` when the run commits.
fn run_delete(mut t: Run, take key: Bytes) -> () uses {} {
  let _ = ordered_map.remove(mut t.state, key)
  ordered_map.insert(mut t.writes, take key, None())
}

// Records that the run read `key`, whether or not it holds a value.
fn read_point(mut a: AccessSet, take key: Bytes) -> () uses {} {
  list.push(mut a.points, take key)
}

// Records the interval a scan consumed (see `consumed`).
fn read_span(
  mut a: AccessSet,
  take from: ordered_map.Bound[Bytes],
  take to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64,
  take rows: List[(Bytes, Bytes)]
) -> List[(Bytes, Bytes)] uses {} {
  if let Some(span) = consumed(take from, take to, direction, limit, rows) {
    list.push(mut a.spans, take span)
  }
  take rows
}

// The interval a scan from `from` to `to` in `direction`, limited to `limit`
// entries, consumed when it returned `rows`: up to the last row when it
// returned `limit` of them, the whole range otherwise. A scan limited to none
// examined nothing.
fn consumed(
  take from: ordered_map.Bound[Bytes],
  take to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64,
  rows: List[(Bytes, Bytes)]
) -> Option[Span] uses {} {
  if limit == 0 {
    return None()
  }
  let n = list.len(rows)
  if n < limit {
    return Some(Span(from: take from, to: take to, direction: direction))
  }
  let (last, _) = rows[n - 1]
  let cut = copy_to(heap, last)
  Some(
    match direction {
      Ascending() => Span(from: take from, to: Included(take cut), direction: direction),
      Descending() => Span(from: Included(take cut), to: take to, direction: direction),
    }
  )
}

// A share of the index that outlives this call: the index moves out of the
// store, which only holds owned values, so a copy of it is owned too.
fn current(mut s: Store) -> ordered_map.OrderedMap[Bytes, Bytes] uses {} {
  let index = replace(mut s.index, ordered_map.empty(compare_keys))
  let share = copy index
  s.index = take index
  share
}

/// Puts the nodes of a checkpoint of the state at V that the newest
/// checkpoint does not already hold, records its descriptor by a Checkpoint
/// commit, so recovery applies only the commits after it, and removes the
/// objects no record keeps (STORE-11). The fresh nodes go in batches, each
/// put under the claim and then inventoried by its own record before the next
/// is put: an Objects commit for every batch but the last, which the
/// Checkpoint's record inventories. That record and Objects records after it
/// retire every object the history made that the new tree does not hold.
/// Every commit is first made durable at the strongest declared level, and so
/// is each of these; reclamation then runs until it is done.
pub fn compact(mut s: Store) -> Result[(), StoreError] {
  if s.closed {
    return Error(Closed())
  }
  let a = s.authority
  strongest(a, mut s) ? unreleased
  // The state at V is the state after the newest group: a claim since writes
  // nothing, and so do the Objects commits.
  let last = s.group_last
  let group_at = s.group_at
  let last_at = located(a, mut s, group_at)?
  let group = copy s.digest
  let placement = history.Placement(
    // Every failure below closes the store; success sets the new live nodes.
    live: replace(mut s.live, ordered_map.empty(compare_keys)),
    epoch: s.epoch,
    start: s.end + 1,
    refs: batch_refs(s.max_entry),
    bytes: s.config.batch_bytes
  )
  let tree = history.checkpoint_tree(copy s.bounds, take placement, s.index)
  let desc = history.descriptor(tree, last, group)
  // The new tree's nodes and those of the checkpoints pinned versions rely on.
  let mut held: ordered_map.OrderedMap[Bytes, ObjectRef] = ordered_map.empty(
    compare_keys
  )
  for r in tree.refs {
    ordered_map.insert(mut held, history.ref_key(r), copy r)
  }
  for k in s.kept {
    for r in k.refs {
      ordered_map.insert(mut held, history.ref_key(r), unique r)
    }
  }
  let mut retire: List[ObjectRef] = []
  for r in made_refs(s.made) {
    if !ordered_map.contains(held, history.ref_key(r)) {
      list.push(mut retire, copy r)
    }
  }
  let n = list.len(tree.batches)
  let room = retire_room(s.max_entry)
  let mut next: u64 = 0
  let mut i: u64 = 0
  while i < n || next < list.len(retire) {
    let mut created: List[ObjectRef] = []
    if i < n {
      for (r, node) in tree.batches[i] {
        put_node(a, mut s, r, copy node)?
        list.push(mut created, copy r)
      }
    }
    let body: history.Body = if i + 1 == n {
      Engine(Checkpoint(copy desc))
    } else {
      Engine(Objects())
    }
    // Retirements ride the Checkpoint's record and those after it.
    let mut retired: List[ObjectRef] = []
    if i + 1 >= n {
      let mut used: u64 = 32 * list.len(created)
      while next < list.len(retire) && (used + 48 <= room || list.len(retired) == 0 && used == 0) {
        list.push(mut retired, copy retire[next])
        used += 48
        next += 1
      }
    }
    for r in created {
      ordered_map.insert(mut s.made, history.ref_key(r), copy r)
    }
    for r in retired {
      let _ = ordered_map.remove(mut s.made, history.ref_key(r))
    }
    s.created = take created
    s.retired = take retired
    let t = serial(mut s)
    let _ = commit(mut s, take t, take body, None()) ? unreleased
    strongest(a, mut s) ? unreleased
    i += 1
  }
  let mut live: ordered_map.OrderedMap[Bytes, ObjectRef] = ordered_map.empty(
    compare_keys
  )
  for r in tree.refs {
    ordered_map.insert(mut live, copy r.digest, copy r)
  }
  s.live = take live
  s.newest = Some(take desc)
  s.newest_after = take last_at
  s.counted = false
  select_base(a, mut s)?
  reclaim(a, mut s)
}

// Selects the base at `first` (STORE-11 **Bases**): 1 + the least position of
// the group whose last commit is the version of the newest checkpoint or of
// one a reader or named pin's version relies on, so every checkpoint in force
// has its record at or after `first` and recovery from the base finds it. No
// base while a pinned version relies on no checkpoint: it replays from the
// genesis. The bootstrap is the history at `first` - 1, read from the
// selected base with recovery's own pass. A pinned version is retained, so
// it relies on a checkpoint in force when the selected base was: `first`
// never goes below it, and an equal one selects nothing new.
fn select_base(a: Authority, mut s: Store) -> Result[(), StoreError] {
  if s.newest == None() {
    return Ok(())
  }
  let mut least = history.locator_position(s.newest_after)
  let mut versions: List[u64] = []
  for (_, r) in reading_rows(s.readers) {
    list.push(mut versions, r.version)
  }
  for p in s.pins {
    list.push(mut versions, p.version)
  }
  for v in versions {
    match relied_on(s, v) {
      Some(Older(k)) => {
        let p = history.locator_position(k.after)
        if p < least {
          least = p
        }
      },
      Some(Newest(_)) => {},
      None() => return Ok(()),
    }
  }
  let first = least + 1
  let mut sc = based(a, mut s)?
  if first <= sc.here + 1 {
    return Ok(())
  }
  scan_history(a, mut s, mut sc, first - 1, authority.floor(a))?
  let (group, last, edge) = replace(mut sc.newest, (b"", 0, 0))
  let Some(creation) = replace(mut sc.recorded, None()) else {
    return Error(stop(mut s, Corrupt(entry_name(first - 1))))
  }
  // The record at `first` - 1 is the group a checkpoint names.
  if edge != first - 1 || last != sc.tip.last {
    return Error(stop(mut s, Corrupt(entry_name(first - 1))))
  }
  let state: Option[history.Retained] = match replace(mut sc.retention, None()) {
    None() => None(),
    Some((floor, pins, roots)) => {
      let mut holders: List[history.Holding] = []
      for (token, r) in reading_rows(sc.table) {
        list.push(
          mut holders,
          history.Holding(
            token: unique token,
            principal: unique string.as_bytes(r.principal),
            version: r.version,
            at: unique r.at
          )
        )
      }
      Some(
        history.Retained(
          floor: floor,
          pins: take pins,
          holders: take holders,
          roots: take roots
        )
      )
    },
  }
  let boot = history.encode_boot(
    history.Boot(
      first: first,
      last: last,
      identity: unique sc.tip.identity,
      group: take group,
      creation: take creation,
      retain: replace(mut sc.retain_loc, b""),
      deltas: sc.deltas,
      retained: take state
    )
  )
  let Some(held) = replace(mut s.claim, None()) else {
    return Error(stop(mut s, Closed()))
  }
  let Some(narrowed) = claim.narrow(a, take held) else {
    return Error(stop(mut s, Closed()))
  }
  let mut c = take narrowed
  let outcome = authority.select(a, mut c, first, take boot)
  let back: Claim = take c
  s.claim = Some(take back)
  match take outcome {
    Ok(()) => Ok(()),
    Error(e) => Error(stop(mut s, seam(take e))),
  }
}

// Provider requests one reclamation call may make.
const RECLAIM_BUDGET: u64 = 64

// Calls `authority.reclaim` until it is done. Its strongest-durable end is the
// store's end: every record is durable at the strongest level.
fn reclaim(a: Authority, mut s: Store) -> Result[(), StoreError] {
  while true {
    let Some(held) = replace(mut s.claim, None()) else {
      return Error(stop(mut s, Closed()))
    }
    let Some(narrowed) = claim.narrow(a, take held) else {
      return Error(stop(mut s, Closed()))
    }
    let mut c = take narrowed
    let outcome = authority.reclaim(a, mut c, RECLAIM_BUDGET)
    let back: Claim = take c
    s.claim = Some(take back)
    match take outcome {
      Ok(More()) => {},
      Ok(Done()) => return Ok(()),
      Error(e) => return Error(stop(mut s, seam(take e))),
    }
  }
  Ok(())
}

// The objects of `m`, in key order.
fn made_refs(m: ordered_map.OrderedMap[Bytes, ObjectRef]) -> List[ObjectRef] uses {} {
  let start: List[ObjectRef] = []
  let from: ordered_map.Bound[Bytes] = Unbounded()
  let end: ordered_map.Bound[Bytes] = Unbounded()
  ordered_map.fold_range(
    m,
    from,
    end,
    Ascending(),
    take start,
    fn(take acc: List[ObjectRef], _k: Bytes, r: ObjectRef) -> (List[ObjectRef], bool) {
      let mut out = take acc
      list.push(mut out, unique r)
      (take out, true)
    }
  )
}

/// A reader pin with a fresh token from `r`: 16 bytes no other draw is
/// expected to repeat. It pins nothing until `acquire_reader_pin` records it.
pub fn new_reader_pin(r: Random) -> Result[ReaderPin, RandomError] {
  let b = core@1/random.bytes(r, 16)?
  let mut hi: u64 = 0
  let mut lo: u64 = 0
  let mut i: u64 = 8
  while i > 0 {
    i -= 1
    let high: u64 = int.widen(b[i])
    let low: u64 = int.widen(b[i + 8])
    hi = hi << 8 | high
    lo = lo << 8 | low
  }
  Ok(ReaderPin(hi: hi, lo: lo))
}

// A reader pin's token: `hi` then `lo`, little-endian.
fn pin_token(p: ReaderPin) -> Bytes uses {} {
  let mut out: List[u8] = []
  for i in 0u64..8 {
    list.push(mut out, int.truncate(p.hi >> i * 8))
  }
  for i in 0u64..8 {
    list.push(mut out, int.truncate(p.lo >> i * 8))
  }
  bytes.from_list(take out)
}

/// The transaction entry that acquires the reader pin `p` (STORE-8): its
/// commit pins the version the call runs at for the caller, and its reply
/// is released once the Retain commit that records the pin is durable at
/// the strongest declared level. `Taken()` when the store holds `p`'s token
/// already, for any principal; `Limit()` when it holds `MAX_HOLDERS` pins.
/// The held pin names the version pinned, which `at_pin` and
/// `drop_reader_pin` take. Served with `served_transact`, a caller asks it on
/// its own call stream, and asking the same stream position again returns the
/// recorded reply.
pub fn acquire_reader_pin(mut tx: Tx, info: CallInfo, p: ReaderPin) -> Result[
  HeldPin,
  PinError
] {
  let token = pin_token(p)
  if ordered_map.contains(tx.txn.readers, token) {
    return Error(Taken())
  }
  if ordered_map.len(tx.txn.readers) >= history.MAX_HOLDERS {
    return Error(Limit())
  }
  tx.txn.pin = Some(Acquire(token: take token, principal: unique info.caller))
  Ok(HeldPin(hi: p.hi, lo: p.lo, version: tx.txn.base))
}

/// The transaction entry that drops the caller's reader pin `p`. A pin the
/// caller does not hold at `p`'s version changes nothing, and dropping one
/// cannot fail.
pub fn drop_reader_pin(mut tx: Tx, info: CallInfo, p: HeldPin) -> Result[(), ()] {
  let token = pin_token(ReaderPin(hi: p.hi, lo: p.lo))
  let held = match ordered_map.get(tx.txn.readers, token) {
    Some(r) => r.principal == info.caller && r.version == p.version,
    None() => false,
  }
  if held {
    tx.txn.pin = Some(Release(token: take token))
  }
  Ok(())
}

/// The reader pins the store holds, for its operator: each holder's version,
/// principal and id, `H("hirsel.pin.v1", token)`. No call shows a token.
pub fn reader_pins(a: Authority, mut s: Store) -> Result[
  List[PinHolder of a],
  StoreError
] {
  if s.closed {
    return Error(Closed())
  }
  let mut out: List[PinHolder of a] = []
  for (token, r) in reading_rows(s.readers) {
    let h: PinHolder of a = PinHolder(
      version: r.version,
      principal: unique r.principal,
      id: pin_id(token)
    )
    list.push(mut out, take h)
  }
  Ok(take out)
}

// The entries of a reader pin table, in key order.
fn reading_rows(m: ordered_map.OrderedMap[Bytes, Reading]) -> List[(Bytes, Reading)] uses {} {
  let first: List[(Bytes, Reading)] = []
  ordered_map.fold_range(
    m,
    Unbounded(),
    Unbounded(),
    Ascending(),
    take first,
    fn(take acc: List[(Bytes, Reading)], k: Bytes, r: Reading) -> (
      List[(Bytes, Reading)],
      bool
    ) {
      let mut out = take acc
      list.push(mut out, (unique k, unique r))
      (take out, true)
    }
  )
}

/// The version a holder's pin holds.
pub fn pin_version(a: Authority, h: PinHolder of a) -> Version of a uses {} {
  Version(version: h.version)
}

/// The principal that acquired a holder's pin.
pub fn pin_principal(h: PinHolder) -> String uses {} {
  unique h.principal
}

/// A holder's id, which `release_reader_pin` names.
pub fn pin_holder_id(h: PinHolder) -> Bytes uses {} {
  unique h.id
}

// `H("hirsel.pin.v1", token)`.
fn pin_id(token: Bytes) -> Bytes uses {} {
  framed_digest([b"hirsel.pin.v1", copy token])
}

/// Releases the reader pin `h` names, whoever holds it, by a retention
/// commit the engine makes on its own behalf, durable at the strongest
/// declared level before it returns. False when the store holds no pin of
/// `h`'s id at `h`'s version.
pub fn release_reader_pin(mut s: Store, h: PinHolder) -> Result[bool, StoreError] {
  if s.closed {
    return Error(Closed())
  }
  let start: Option[Bytes] = None()
  let found = ordered_map.fold_range(
    s.readers,
    Unbounded(),
    Unbounded(),
    Ascending(),
    take start,
    fn(take acc: Option[Bytes], k: Bytes, r: Reading) -> (Option[Bytes], bool) {
      if r.version == h.version && pin_id(k) == h.id {
        return (Some(unique k), false)
      }
      (take acc, true)
    }
  )
  let Some(token) = take found else {
    return Ok(false)
  }
  retain_by(mut s, Release(token: take token))?
  Ok(true)
}

/// Pins version `v` under `name` (STORE-8), by a Retain commit the engine
/// makes on its own behalf, durable at the strongest declared level before it
/// returns: `store.at` reads a pinned version until it is unpinned. A name the
/// store holds already moves to `v`. A name over 255 bytes, a 1025th name or
/// a version below the floor is `InvalidInput()`, and a version the store no
/// longer retains is `NotRetained()`, as `store.at` answers it.
pub fn pin(a: Authority, mut s: Store, name: String, v: Version of a) -> Result[
  (),
  StoreError
] {
  if s.closed {
    return Error(Closed())
  }
  let key = string.as_bytes(name)
  if bytes.len(key) > history.MAX_PIN_NAME || v.version < s.retain_floor {
    return Error(InvalidInput())
  }
  let mut held = false
  for p in s.pins {
    held = held || p.name == key
  }
  if !held && list.len(s.pins) >= history.MAX_PINS {
    return Error(InvalidInput())
  }
  if !holds(s, v.version) {
    return Error(NotRetained())
  }
  retain_by(mut s, Pin(name: copy key, version: v.version))
}

/// Removes the named pin `name` (STORE-8), by a Retain commit as `pin` makes:
/// false when the store holds no pin of that name, which changes nothing.
pub fn unpin(mut s: Store, name: String) -> Result[bool, StoreError] {
  if s.closed {
    return Error(Closed())
  }
  let key = string.as_bytes(name)
  let mut held = false
  for p in s.pins {
    held = held || p.name == key
  }
  if !held {
    return Ok(false)
  }
  retain_by(mut s, Unpin(name: copy key))?
  Ok(true)
}

// Commits the retention state after `op` as the engine's own Retain, durable
// at the strongest declared level before it returns.
fn retain_by(mut s: Store, op: PinOp) -> Result[(), StoreError] {
  let r = retained(s, op, s.visible)?
  let Retention(body: body, pins: pins, readers: readers, kept: kept, fold: fold) = take r
  let t = serial(mut s)
  let _ = commit(mut s, take t, take body, None()) ? unreleased
  take_retention(mut s, take pins, take readers, take kept)
  retention_written(mut s, fold)
  let a = s.authority
  strongest(a, mut s) ? unreleased
  Ok(())
}

// The retention state after a reader pin entry's `op`, run at `base`, the
// commit that records it and whether that commit is a Retain fold. A fold
// carries the whole state; a ReaderDelta only its one holder and count.
type Retention {
  body: history.Body,
  pins: Option[List[history.Pin]],
  readers: Readers,
  kept: Counts,
  fold: bool,
}

// The readers table after a retention commit: the whole table, or the
// store's with one holder added or removed.
type Readers = Table(ordered_map.OrderedMap[Bytes, Reading]) | Held(
  token: Bytes,
  reading: Reading
) | Freed(token: Bytes)

// The kept checkpoints after a retention commit: the whole list, counted, or
// the store's with the count at `index` one higher or lower, or unchanged.
type Counts = Recounted(List[Kept]) | Up(index: u64) | Down(index: u64) | Same

// Takes a committed retention change into the store.
fn take_retention(
  mut s: Store,
  take pins: Option[List[history.Pin]],
  take readers: Readers,
  take kept: Counts
) -> () {
  if let Some(p) = take pins {
    s.pins = take p
  }
  match take readers {
    Table(t) => {
      s.readers = take t
    },
    Held(token: token, reading: r) => ordered_map.insert(
      mut s.readers,
      take token,
      take r
    ),
    Freed(token: token) => {
      let _ = ordered_map.remove(mut s.readers, token)
    },
  }
  match take kept {
    Recounted(k) => {
      s.kept = take k
      s.counted = true
    },
    Up(index: i) => {
      s.kept[i].count += 1
    },
    Down(index: i) => {
      s.kept[i].count -= 1
    },
    Same => {},
  }
}

// Notes a retention commit the pending group holds: a fold restarts the
// count of deltas since one.
fn retention_written(mut s: Store, fold: bool) -> () uses {} {
  s.deltas = if fold {
    0
  } else {
    s.deltas + 1
  }
  s.retaining = true
}

// The retention state after `op`, run at `base`: the named and reader pins,
// the checkpoints their versions rely on, and the commit that records it
// (STORE-8). An acquire or release that keeps the same checkpoints is a
// ReaderDelta while the deltas since the newest fold stay below
// min(holders, `FOLD_DELTAS`); any other change is a Retain fold of the whole
// state. A lookup thus reads at most `FOLD_DELTAS` + 1 records. A principal
// longer than `MAX_PRINCIPAL` is refused, never cut. While the counts are
// exact a delta is read off them, so it costs nothing per holder.
fn retained(s: Store, op: PinOp, base: u64) -> Result[Retention, StoreError] uses {} {
  if let Acquire(principal: principal, ..) = op {
    let n = bytes.len(string.as_bytes(principal))
    if n > history.MAX_PRINCIPAL {
      return Error(Unsupported(Size(needed: n, max_entry: history.MAX_PRINCIPAL)))
    }
  }
  if s.counted {
    if let Some(d) = counted_delta(s, op, base) {
      return Ok(take d)
    }
  }
  let mut readers = unique s.readers
  let mut pins = unique s.pins
  let mut change: Option[history.ReaderChange] = None()
  match op {
    Acquire(token: token, principal: principal) => {
      // The commit recording the holder is in the pending group; its record
      // is at or after the one holding `base`.
      if !ordered_map.contains(readers, token) {
        change = Some(
          Hold(
            token: unique token,
            principal: unique string.as_bytes(principal),
            version: base,
            at: history.no_locator()
          )
        )
      }
      ordered_map.insert(
        mut readers,
        unique token,
        Reading(principal: unique principal, version: base, at: b"")
      )
    },
    Release(token: token) => {
      if let Some(_) = ordered_map.remove(mut readers, token) {
        change = Some(Free(token: unique token))
      }
    },
    Pin(name: name, version: v) => {
      let mut out: List[history.Pin] = []
      let mut placed = false
      for p in pins {
        if !placed && compare_keys(name, p.name) <= 0 {
          list.push(mut out, history.Pin(name: unique name, version: v))
          placed = true
        }
        if p.name != name {
          list.push(mut out, unique p)
        }
      }
      if !placed {
        list.push(mut out, history.Pin(name: unique name, version: v))
      }
      pins = take out
    },
    Unpin(name: name) => {
      let mut out: List[history.Pin] = []
      for p in pins {
        if p.name != name {
          list.push(mut out, unique p)
        }
      }
      pins = take out
    },
  }
  let (table, kept) = relied(s, readers, pins)
  let mut same = list.len(kept) == list.len(s.kept)
  if same {
    for i in 0u64..list.len(kept) {
      same = same && kept[i].desc.version == s.kept[i].desc.version
    }
  }
  if let Some(c) = take change {
    if same && delta_room(s, ordered_map.len(readers)) {
      return Ok(
        Retention(
          body: Engine(ReaderDelta(take c)),
          pins: Some(take pins),
          readers: Table(take readers),
          kept: Recounted(take kept),
          fold: false
        )
      )
    }
  }
  let mut checkpoints: List[history.Root] = []
  for k in kept {
    list.push(mut checkpoints, history.Root(desc: unique k.desc, after: copy k.after))
  }
  let body: history.Body = Engine(
    (Retain(
      floor: s.retain_floor,
      // The tuple recover took from the Genesis: equal to it by construction.
      creation: history.Creation(limits: recorded_as(s.limits), bounds: copy s.bounds),
      pins: copy pins,
      readers: take table,
      checkpoints: take checkpoints
    ))
  )
  Ok(
    Retention(
      body: take body,
      pins: Some(take pins),
      readers: Table(take readers),
      kept: Recounted(take kept),
      fold: true
    )
  )
}

// Whether a ReaderDelta may record a change that leaves `holders` holders:
// a fold is before it, and the deltas since that fold stay below
// min(holders, `FOLD_DELTAS`).
fn delta_room(s: Store, holders: u64) -> bool uses {} {
  let bound = if holders < FOLD_DELTAS {
    holders
  } else {
    FOLD_DELTAS
  }
  (s.retain_loc != history.no_locator() || s.retaining) && s.deltas + 1 < bound
}

// The ReaderDelta for an acquire of a new token or a release of a held one,
// from the exact counts: none when the change keeps or drops a checkpoint
// (a fold records that) or the deltas reach their bound.
fn counted_delta(s: Store, op: PinOp, base: u64) -> Option[Retention] uses {} {
  match op {
    Acquire(token: token, principal: principal) => {
      if ordered_map.contains(s.readers, token) {
        return None()
      }
      let kept = match relied_index(s, base) {
        At(i) => Up(index: i),
        Unkept => return None(),
        Genesis => Same,
      }
      if !delta_room(s, ordered_map.len(s.readers) + 1) {
        return None()
      }
      Some(
        Retention(
          body: Engine(
            ReaderDelta(
              Hold(
                token: unique token,
                principal: unique string.as_bytes(principal),
                version: base,
                at: history.no_locator()
              )
            )
          ),
          pins: None(),
          readers: Held(
            token: unique token,
            reading: Reading(principal: unique principal, version: base, at: b"")
          ),
          kept: take kept,
          fold: false
        )
      )
    },
    Release(token: token) => {
      let Some(r) = ordered_map.get(s.readers, token) else {
        return None()
      }
      let kept = match relied_index(s, r.version) {
        At(i) => if s.kept[i].count > 1 {
          Down(index: i)
        } else {
          return None()
        },
        Unkept => return None(),
        Genesis => Same,
      }
      if !delta_room(s, ordered_map.len(s.readers) - 1) {
        return None()
      }
      Some(
        Retention(
          body: Engine(ReaderDelta(Free(token: unique token))),
          pins: None(),
          readers: Freed(token: unique token),
          kept: take kept,
          fold: false
        )
      )
    },
    _ => None(),
  }
}

// Where the checkpoint a version relies on is among the kept ones.
type Reliance = At(u64) | Unkept | Genesis

// The kept checkpoint version `v` relies on (`relied_on`, by index): the
// newest of those kept at or below `v`, unless the newest checkpoint is newer
// and still at or below it; `Unkept` for the newest when none keeps it, and
// `Genesis` when no checkpoint is at or below `v`.
fn relied_index(s: Store, v: u64) -> Reliance uses {} {
  let mut best: Option[u64] = None()
  let mut best_version: u64 = 0
  for i in 0u64..list.len(s.kept) {
    let kv = s.kept[i].desc.version
    if kv <= v && (best == None() || kv > best_version) {
      best_version = kv
      best = Some(i)
    }
  }
  if let Some(n) = s.newest {
    if n.version <= v && (best == None() || n.version > best_version) {
      return Unkept
    }
  }
  match best {
    Some(i) => At(i),
    None() => Genesis,
  }
}

// `readers` as a Retain records them, by version and then token, and the
// checkpoints their versions rely on, oldest first: for each version, the
// newest of the newest checkpoint and those already kept at or below it. A
// version below every checkpoint relies on none: it replays from the genesis.
// Each kept checkpoint is counted with the holders and named pins relying on
// it. One sort, so a fold at a full table costs O(n log n), and the newest
// checkpoint's nodes are listed at most once.
fn relied(
  s: Store,
  readers: ordered_map.OrderedMap[Bytes, Reading],
  pins: List[history.Pin]
) -> (List[history.Reader], List[Kept]) uses {} {
  let mut rows: List[PinRow] = []
  for (k, r) in reading_rows(readers) {
    list.push(
      mut rows,
      PinRow(
        version: r.version,
        token: unique k,
        principal: unique r.principal,
        at: unique r.at
      )
    )
  }
  list.sort(mut rows, by_version)
  let mut table: List[history.Reader] = []
  let mut holders: List[history.Holder] = []
  let mut ver: u64 = 0
  let mut loc = b""
  let mut kept: List[Kept] = []
  let mut newest_kept = false
  for h in rows {
    if list.len(holders) > 0 && h.version != ver {
      let (more, has) = keep(s, ver, take kept, newest_kept, list.len(holders))
      kept = take more
      newest_kept = has
      list.push(
        mut table,
        history.Reader(
          version: ver,
          at: written_at(loc),
          holders: replace(mut holders, [])
        )
      )
    }
    if list.len(holders) == 0 {
      ver = h.version
      loc = b""
    }
    // The nearest record after the version's of those its holders name: a
    // pending one is the newest.
    if loc == b"" || h.at != b"" && history.locator_position(h.at) < history.locator_position(
      loc
    ) {
      loc = unique h.at
    }
    list.push(
      mut holders,
      history.Holder(
        principal: unique string.as_bytes(h.principal),
        token: unique h.token
      )
    )
  }
  if list.len(holders) > 0 {
    let (more, has) = keep(s, ver, take kept, newest_kept, list.len(holders))
    kept = take more
    newest_kept = has
    list.push(
      mut table,
      history.Reader(version: ver, at: written_at(loc), holders: take holders)
    )
  }
  // A named pin's version relies on a checkpoint as a reader's does.
  for p in pins {
    let (more, has) = keep(s, p.version, take kept, newest_kept, 1)
    kept = take more
    newest_kept = has
  }
  (take table, take kept)
}

// Whether the store retains `v`: at or above its newest checkpoint, or held
// by a reader or named pin (`retains` over the store's own tables).
fn holds(s: Store, v: u64) -> bool uses {} {
  match s.newest {
    Some(n) if v >= n.version => return true,
    None() => return true,
    _ => {},
  }
  for (k, r) in reading_rows(s.readers) {
    if r.version == v {
      return true
    }
  }
  for p in s.pins {
    if p.version == v {
      return true
    }
  }
  false
}

// `kept`, oldest first, with the checkpoint `n` holders or pins of version
// `v` rely on counted `n` more, once in the list, and whether it now holds
// the newest checkpoint.
fn keep(s: Store, v: u64, take kept: List[Kept], newest_kept: bool, n: u64) -> (
  List[Kept],
  bool
) uses {} {
  let mut out = take kept
  match relied_on(s, v) {
    Some(Older(k)) => {
      if counted_in(mut out, k.desc.version, n) {
        return (take out, newest_kept)
      }
      let Kept(desc: d, after: after, refs: refs, ..) = take k
      (
        by_age(
          take out,
          Kept(desc: take d, after: take after, refs: take refs, count: n)
        ),
        newest_kept
      )
    },
    Some(Newest(d)) => {
      if newest_kept && counted_in(mut out, d.version, n) {
        return (take out, true)
      }
      (
        by_age(
          take out,
          Kept(
            desc: take d,
            after: unique s.newest_after,
            refs: made_refs(s.live),
            count: n
          )
        ),
        true
      )
    },
    None() => (take out, newest_kept),
  }
}

// Adds `n` to the count of the kept checkpoint of version `v`; false when
// none is kept.
fn counted_in(mut kept: List[Kept], v: u64, n: u64) -> bool uses {} {
  for i in 0u64..list.len(kept) {
    if kept[i].desc.version == v {
      kept[i].count += n
      return true
    }
  }
  false
}

// `kept` with `k` placed by its checkpoint's version, oldest first.
fn by_age(take kept: List[Kept], take k: Kept) -> List[Kept] uses {} {
  let mut out: List[Kept] = []
  let mut item = Some(take k)
  for x in kept {
    if let Some(n) = item {
      if n.desc.version < x.desc.version {
        list.push(mut out, unique n)
        item = None()
      }
    }
    list.push(mut out, unique x)
  }
  if let Some(n) = take item {
    list.push(mut out, unique n)
  }
  take out
}

// One holder of a reader pin, as `relied` orders them.
type PinRow {
  version: u64,
  token: Bytes,
  principal: String,
  at: Bytes,
}

// A Reading's locator as a retention commit writes it: the record holding
// the commit, `no_locator()`, while it is pending.
fn written_at(loc: Bytes) -> Bytes uses {} {
  if loc == b"" {
    history.no_locator()
  } else {
    unique loc
  }
}

@noalloc
fn by_version(x: PinRow, y: PinRow) -> i32 uses {} {
  if x.version < y.version {
    -1
  } else if y.version < x.version {
    1
  } else {
    compare_keys(x.token, y.token)
  }
}

// The checkpoint a reader relies on: a kept one, with its nodes, or the
// newest, whose nodes are the store's live ones.
type Relied = Older(Kept) | Newest(history.Descriptor)

// The checkpoint a reader of version `v` relies on: the newest of the newest
// checkpoint and the kept ones at or below `v`.
fn relied_on(s: Store, v: u64) -> Option[Relied] uses {} {
  let mut best: Option[Relied] = None()
  let mut best_version: u64 = 0
  for k in s.kept {
    if k.desc.version <= v && (best == None() || k.desc.version > best_version) {
      best_version = k.desc.version
      best = Some(Older(unique k))
    }
  }
  if let Some(n) = s.newest {
    if n.version <= v && (best == None() || n.version > best_version) {
      best = Some(Newest(unique n))
    }
  }
  take best
}

/// The state at `v` (STORE-8), opened from the store's authority as of the
/// strongest declared level, without claiming it. `v` is retained when it is
/// at or above the newest checkpoint's version or a reader pin holds it;
/// otherwise, or when no commit up to `v` is durable at that level yet, the
/// read is `NotRetained()`. The read is optimistic: it pins nothing, and an
/// object a reclamation removes while it reads answers `NotRetained()` once
/// the history no longer retains `v`. The snapshot is read whole when it
/// opens, so it never fetches again. No engine opens it, so its queries run
/// under the default configuration's energy.
pub fn at(a: Authority, v: Version of a) -> Result[Snapshot of a, StoreError] {
  let want = v.version
  for attempt in 0u64..2 {
    let past = survey(a)?
    if !retains(past, want) {
      return Error(NotRetained())
    }
    match materialize(a, past, want) {
      Ok(snap) => return Ok(take snap),
      // A missing object while the history still retains `v` is corrupt.
      Error(Missing()) if attempt == 1 => return Error(Corrupt("hirsel.checkpoint")),
      Error(Missing()) => {},
      // A forward replay names no locator.
      Error(Moved()) => return Error(Corrupt("hirsel.checkpoint")),
      Error(Failed(e)) => return Error(take e),
    }
  }
  Error(Corrupt("hirsel.checkpoint"))
}

/// The state at the version the reader pin `p` holds (STORE-8), when the
/// readers table durable at the strongest declared level still holds `p`'s
/// token at that version: `PinReleased()` otherwise, at once. The table is
/// read newest first: the newest group, the records its retention locators
/// name and the newest Retain fold, at most `FOLD_DELTAS` + 1 records, each
/// fetched where its locator says. A snapshot that misses an object reads
/// the table again: `PinReleased()` when the holder has gone since, and
/// `Corrupt(..)` when it is still there. A record not where a locator says,
/// because the history moved under the read, starts the read again, at
/// most `MOVES` times before `Refused(Unreachable())`.
pub fn at_pin(a: Authority, p: HeldPin) -> Result[Snapshot of a, StoreError] {
  let token = pin_token(ReaderPin(hi: p.hi, lo: p.lo))
  let top = strongest_level(a)
  let mut missed: u64 = 0
  let mut moved: u64 = 0
  while true {
    let read = match pinned(a, top, token) {
      Ok(Some(h)) if h.version == p.version => {
        let mut base: Option[Base] = None()
        for r in h.roots {
          if r.desc.version <= h.version {
            base = Some(
              Base(desc: unique r.desc, after: history.locator_position(r.after))
            )
          }
        }
        replay(a, h.limits, base, h.version, Some(copy h.at))
      },
      Ok(_) => return Error(PinReleased()),
      Error(e) => Error(take e),
    }
    match take read {
      Ok(snap) => return Ok(take snap),
      Error(Missing()) if missed == 1 => return Error(Corrupt("hirsel.checkpoint")),
      Error(Missing()) => {
        missed += 1
      },
      Error(Moved()) if moved == MOVES => return Error(Refused(Unreachable())),
      Error(Moved()) => {
        moved += 1
      },
      Error(Failed(e)) => return Error(take e),
    }
  }
  // Unreachable, but the source checker requires a final expression.
  Error(Refused(Unreachable()))
}

// How many times a pinned read starts again when a record is not where a
// locator says.
const MOVES: u64 = 4

// What the readers table holds for a token: the version, the locator of a
// record at or after the one holding it, the checkpoints the newest Retain
// fold keeps and the limits it repeats.
type Pinned {
  version: u64,
  at: Bytes,
  roots: List[history.Root],
  limits: StoreLimits,
}

// The readers table durable at `top` for `token`, read newest first: the
// newest group, then each record its `retain` locator names, down to the
// record holding the newest fold; that fold's table, then the ReaderDelta
// commits after it, oldest first. A zero locator in a fold or delta names
// its own record. A record a locator names that holds no retention commit, a
// locator not below its record, and deltas with no fold before them are
// corrupt. `None()` when no fold or delta holds the token.
fn pinned(a: Authority, top: Level of a, token: Bytes) -> Result[Option[Pinned], Unread] {
  let mut l = match authority.last(a, top) {
    Ok(x) => x,
    Error(e) => return Error(Failed(seam(take e))),
  }
  // The deltas after the newest fold, newest record first, each with its
  // record's locator.
  let mut later: List[(List[history.ReaderChange], Bytes)] = []
  let mut first = true
  while history.locator_position(l) > 0 {
    let pos = history.locator_position(l)
    let g = located_group(a, top, l)?
    let mut changes: List[history.ReaderChange] = []
    let mut fold: Option[(List[history.Reader], List[history.Root], history.Limits)] = None()
    for x in g.commits {
      match x.body {
        Engine(Retain(creation: m, readers: r, checkpoints: k, ..)) => {
          fold = Some((copy r, copy k, copy m.limits))
          changes = []
        },
        Engine(ReaderDelta(c)) => list.push(mut changes, copy c),
        _ => {},
      }
    }
    if !first && fold == None() && list.len(changes) == 0 {
      return Error(Failed(Corrupt(entry_name(pos))))
    }
    first = false
    list.push(mut later, (take changes, copy l))
    if let Some((readers, roots, limits)) = take fold {
      let mut held: Option[(u64, Bytes)] = None()
      for r in readers {
        for h in r.holders {
          if h.token == token {
            held = Some((r.version, resolved(r.at, l)))
          }
        }
      }
      let mut i = list.len(later)
      while i > 0 {
        i -= 1
        let (cs, here) = later[i]
        for c in cs {
          match c {
            Hold(token: t, version: v, at: loc, ..) if t == token => {
              held = Some((v, resolved(loc, here)))
            },
            Free(token: t) if t == token => {
              held = None()
            },
            _ => {},
          }
        }
      }
      return Ok(
        match take held {
          Some((v, loc)) => Some(
            Pinned(
              version: v,
              at: take loc,
              roots: take roots,
              limits: store_limits(limits)
            )
          ),
          None() => None(),
        }
      )
    }
    if history.locator_position(g.retain) >= pos {
      return Error(Failed(Corrupt(entry_name(pos))))
    }
    l = copy g.retain
  }
  for (cs, _) in later {
    if list.len(cs) > 0 {
      return Error(Failed(Corrupt("hirsel.retain")))
    }
  }
  Ok(None())
}

// The group `l` locates, durable at `top`; `Moved()` when its record is not
// there.
fn located_group(a: Authority, top: Level of a, l: Bytes) -> Result[
  history.Group,
  Unread
] {
  let pos = history.locator_position(l)
  let records = match authority.at(a, l, pos - 1, top, 1) {
    Ok(x) => x,
    Error(e) => return Error(Failed(seam(take e))),
  }
  if list.len(records) == 0 {
    return Error(Moved())
  }
  let Appended(e, _, _) = records[0] else {
    return Error(Failed(Corrupt(entry_name(pos))))
  }
  match history.decode_group(e) {
    Ok(g) => Ok(take g),
    Error(Unsupported(found: found)) => Error(
      Failed(Unsupported(Format(found: unique found, object: entry_name(pos))))
    ),
    Error(Corrupt()) => Error(Failed(Corrupt(entry_name(pos)))),
  }
}

// What reading a version from the authority needs, from one pass over the
// history durable at the strongest declared level: the checkpoints in order,
// each with the position of the group whose last commit is its version, the
// readers table and named pins, the checkpoints the newest Retain keeps, the
// recorded limits and the last version.
type Past {
  checkpoints: List[Base],
  readers: ordered_map.OrderedMap[Bytes, Reading],
  pins: List[history.Pin],
  roots: List[history.Root],
  limits: Option[StoreLimits],
  last: u64,
}

// Why a version could not be read: an object it needs is missing, a record
// is not where a locator says, or another failure.
type Unread = Missing | Moved | Failed(StoreError)

// The strongest level the authority declares.
fn strongest_level(a: Authority) -> Level of a {
  let mut top = authority.floor(a)
  for l in authority.levels(a) {
    top = l
  }
  top
}

// One pass over the history durable at the strongest declared level.
fn survey(a: Authority) -> Result[Past, StoreError] {
  let top = strongest_level(a)
  let mut past = Past(
    checkpoints: [],
    readers: ordered_map.empty(compare_keys),
    pins: [],
    roots: [],
    limits: None(),
    last: 0
  )
  // Each group's last version and position, newest last.
  let mut ends: List[(u64, u64)] = []
  let mut tip = history.origin_tip()
  let mut here: u64 = 0
  // From the selected base: the group at its `first` - 1 is below every
  // checkpoint in force, and its bootstrap is the retention state then.
  if let Some((b, _)) = read_base(a)? {
    here = b.first - 1
    tip = history.Tip(last: b.last, identity: unique b.identity, created: true)
    list.push(mut ends, (b.last, here))
    past.limits = Some(store_limits(b.creation.limits))
    if let Some(r) = b.retained {
      let Ok(table) = boot_table(r.holders) else {
        return Error(Corrupt("hirsel.base"))
      }
      past.readers = take table
      past.pins = copy r.pins
      past.roots = copy r.roots
    }
  }
  while true {
    let records = match authority.read(a, here, top, READ_BATCH) {
      Ok(x) => x,
      Error(e) => return Error(seam(take e)),
    }
    if list.len(records) == 0 {
      break
    }
    for item in records {
      here += 1
      let e = match item {
        Claimed(_, _, identity) => {
          tip = history.claimed(tip, identity)
          continue
        },
        Appended(e, _, _) => copy e,
      }
      let g = match history.decode_group(e) {
        Ok(x) => x,
        Error(Unsupported(found: found)) => return Error(
          Unsupported(Format(found: unique found, object: entry_name(here)))
        ),
        Error(Corrupt()) => return Error(Corrupt(entry_name(here))),
      }
      let Ok(next) = history.follow(tip, g) else {
        return Error(Corrupt(entry_name(here)))
      }
      tip = take next
      for x in g.commits {
        match x.body {
          Engine(Genesis(k)) => {
            past.limits = Some(store_limits(k.limits))
          },
          Engine(Checkpoint(desc)) => {
            let mut after: u64 = 0
            for (last, end) in ends {
              if last == desc.version {
                after = end
              }
            }
            if after == 0 {
              return Error(Corrupt(entry_name(here)))
            }
            list.push(mut past.checkpoints, Base(desc: copy desc, after: after))
          },
          Engine(Retain(pins: pins, readers: readers, checkpoints: checkpoints, ..)) => {
            // The locators are not read here: a version retained is read
            // from the whole history.
            let Ok(table) = reading_table(readers, history.no_locator()) else {
              return Error(Corrupt(entry_name(here)))
            }
            past.readers = take table
            past.pins = copy pins
            past.roots = copy checkpoints
          },
          Engine(ReaderDelta(change)) => {
            if reading_change(mut past.readers, change, history.no_locator()) != Ok(()) {
              return Error(Corrupt(entry_name(here)))
            }
          },
          _ => {},
        }
      }
      list.push(mut ends, (tip.last, here))
    }
  }
  past.last = tip.last
  Ok(take past)
}

// Whether the history retains `v`: at or above its newest checkpoint, or held
// by a named or reader pin, and durable at the strongest level.
fn retains(past: Past, v: u64) -> bool uses {} {
  if v == 0 || v > past.last {
    return false
  }
  for (_, r) in reading_rows(past.readers) {
    if r.version == v {
      return true
    }
  }
  for p in past.pins {
    if p.version == v {
      return true
    }
  }
  let n = list.len(past.checkpoints)
  n == 0 || v >= past.checkpoints[n - 1].desc.version
}

// The state at `v`: the newest root checkpoint at or below it (the newest
// checkpoint or one the newest Retain keeps), or the genesis when no
// checkpoint is at or below it, and the commits after it up to `v`.
fn materialize(a: Authority, past: Past, v: u64) -> Result[Snapshot of a, Unread] {
  let Some(limits) = past.limits else {
    return Error(Failed(NotRetained()))
  }
  let mut base: Option[Base] = None()
  let mut below = false
  let n = list.len(past.checkpoints)
  for i in 0u64..n {
    let d = past.checkpoints[i]
    if d.desc.version <= v {
      below = true
      let mut root = i + 1 == n
      for r in past.roots {
        root = root || r.desc.version == d.desc.version
      }
      if root {
        base = Some(unique d)
      }
    }
  }
  if below && base == None() {
    return Error(Failed(Corrupt("hirsel.checkpoint")))
  }
  replay(a, limits, base, v, None())
}

// A checkpoint replay starts from and the position of the group whose last
// commit is its version.
type Base {
  desc: history.Descriptor,
  after: u64,
}

// The state at `v`: `base`'s tree, or the empty state when it is `None()`,
// and the commits after it up to `v`, read from the record after `base`'s
// group: up to the record `upto` locates, at or after the one holding `v`,
// or, for `None()`, forward. A claim counts as a version and writes nothing.
fn replay(
  a: Authority,
  limits: StoreLimits,
  base: Option[Base],
  v: u64,
  upto: Option[Bytes]
) -> Result[Snapshot of a, Unread] {
  // No engine opened this snapshot: its queries run under the default energy.
  let energy = default_config().energy
  let mut state: ordered_map.OrderedMap[Bytes, Bytes] = ordered_map.empty(compare_keys)
  let mut ver: u64 = 0
  let mut here: u64 = 0
  if let Some(r) = base {
    let (loaded, _) = read_tree(a, r.desc)?
    state = take loaded
    ver = r.desc.version
    here = r.after
  }
  let top = strongest_level(a)
  while ver < v {
    let read = match upto {
      Some(l) => {
        if here >= history.locator_position(l) {
          return Error(Failed(Corrupt(entry_name(here))))
        }
        authority.at(a, l, here, top, READ_BATCH)
      },
      None() => authority.read(a, here, top, READ_BATCH),
    }
    let records = match take read {
      Ok(x) => x,
      Error(e) => return Error(Failed(seam(take e))),
    }
    if list.len(records) == 0 {
      if upto != None() {
        return Error(Moved())
      }
      return Error(Failed(Corrupt(entry_name(here + 1))))
    }
    for item in records {
      here += 1
      match item {
        Claimed(_, _, _) => {
          ver += 1
        },
        Appended(e, _, _) => {
          let Ok(g) = history.decode_group(e) else {
            return Error(Failed(Corrupt(entry_name(here))))
          }
          for x in g.commits {
            ver += 1
            if ver <= v {
              apply(mut state, x.writes)
            }
          }
        },
      }
      if ver >= v {
        break
      }
    }
  }
  Ok(Snapshot(version: v, index: take state, limits: limits, energy: energy))
}

// The state a checkpoint records and its nodes, read level by level from its
// root, each node checked against the digest its parent names.
fn read_tree(a: Authority, desc: history.Descriptor) -> Result[
  (ordered_map.OrderedMap[Bytes, Bytes], List[ObjectRef]),
  Unread
] {
  let mut refs: List[ObjectRef] = []
  let mut expects = [history.root_expect(desc)]
  while true {
    let mut blobs: List[Bytes] = []
    for x in expects {
      let r = x.r
      match authority.get(a, copy r) {
        Ok(Some(b)) => list.push(mut blobs, take b),
        Ok(None()) => return Error(Missing()),
        Error(e) => return Error(Failed(seam(take e))),
      }
      list.push(mut refs, copy r)
    }
    match history.check_level(expects, blobs) {
      Ok(Next(more)) => {
        expects = take more
      },
      Ok(Leaves(entries)) => {
        let Ok(state) = ordered_map.from_sorted(compare_keys, take entries) else {
          return Error(Failed(Corrupt("hirsel.checkpoint")))
        }
        return Ok((take state, take refs))
      },
      Error(Unsupported(found: found)) => return Error(
        Failed(Unsupported(Format(found: unique found, object: "hirsel.checkpoint")))
      ),
      Error(Corrupt()) => return Error(Failed(Corrupt("hirsel.checkpoint"))),
    }
  }
  Error(Failed(Corrupt("hirsel.checkpoint")))
}

// The bytes one record's object references may take beside a group of an
// engine commit: 32 per inventoried object and 48 per retired one.
fn retire_room(max_entry: u64) -> u64 uses {} {
  if max_entry > GROUP_OVERHEAD {
    max_entry - GROUP_OVERHEAD
  } else {
    0
  }
}

// The objects one record inventories at most: what fits an entry of
// `max_entry` bytes beside a group of an engine commit, 32 bytes each.
fn batch_refs(max_entry: u64) -> u64 uses {} {
  if max_entry > GROUP_OVERHEAD + 32 {
    (max_entry - GROUP_OVERHEAD) / 32
  } else {
    1
  }
}

// Puts a checkpoint node under the store's claim.
fn put_node(a: Authority, mut s: Store, r: ObjectRef, take data: Bytes) -> Result[
  (),
  StoreError
] {
  let Some(held) = replace(mut s.claim, None()) else {
    return Error(stop(mut s, Closed()))
  }
  let Some(narrowed) = claim.narrow(a, take held) else {
    return Error(stop(mut s, Closed()))
  }
  let mut c = take narrowed
  let put = authority.put(a, mut c, r, take data)
  let back: Claim = take c
  s.claim = Some(take back)
  match take put {
    Ok(()) => Ok(()),
    Error(e) => Error(stop(mut s, seam(take e))),
  }
}

/// Waits until every commit is durable at the strongest level the authority
/// declares, then releases the store and its claim (STORE-1).
pub fn close(take store: Store) -> Result[(), StoreError] {
  let mut s = take store
  if s.closed {
    return Error(Closed())
  }
  let a = s.authority
  strongest(a, mut s) ? unreleased
  let _ = stop(mut s, Closed())
  Ok(())
}

/// Runs the transaction entry `f` once, with a fresh `Tx` at the latest
/// commit, call information minted before the run and `a` decoded afresh from
/// its argument bytes (STORE-2), and commits its writes as one commit when it
/// returns `Ok`, recording the call. `Error(e)` discards them and is
/// `Aborted(e)`; a failure in the run discards them and is `Faulted(f)`
/// (FAIL-2), and the store stays usable; writes over the limits are
/// `Limit(..)`. The outcome, of any kind, is returned only once every commit
/// the run could see, and its own, is durable at the authority's floor: the
/// output gate.
pub fn transact[A: serializable, R: serializable, E: serializable](
  mut s: Store,
  f: Entry[fn(mut tx: Tx, info: CallInfo, a: A) -> Result[R, E]],
  a: A
) -> Result[R, TxFailure[E]] {
  if s.closed {
    return Error(Storage(Closed()))
  }
  let args = codec.encode(a)
  let decoded: Result[A, DecodeError] = codec.decode(args)
  let Ok(argument) = take decoded else {
    return Error(Storage(Corrupt("hirsel.argument")))
  }
  let info = ordered(s)
  let mut tx = Tx(
    txn: serial(mut s),
    limits: s.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  let saved = energy.enter(s.config.energy)
  let returned = runner.apply_mut(f, mut tx, info, argument)
  let spent = energy.leave(take saved).exhausted
  // The run `tx` ran; its access set is what the entry's reads recorded.
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut t = take ran
  t.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  if spent {
    drop_spent(take returned)
    let base = t.base
    discard(mut s, take t)
    gate(mut s, base) ? released
    return Error(Limit(Energy()))
  }
  match take returned {
    Ok(Ok(v)) => {
      let outcome: Result[R, TxFailure[E]] = Ok(take v)
      let (body, def) = called(f, info, None(), take args, codec.encode(outcome))
      settle(mut s, take t, take body, Some(take def)) ? released
      take outcome
    },
    Ok(Error(e)) => {
      let base = t.base
      discard(mut s, take t)
      gate(mut s, base) ? released
      Error(Aborted(take e))
    },
    Error(failure) => {
      let base = t.base
      discard(mut s, take t)
      gate(mut s, base) ? released
      Error(Faulted(take failure))
    },
  }
}

// A transaction commit's record (STORE-11 kind 1): the entry's identity as a
// definition, and the call with the index the group assigns it.
fn called[F](
  f: Entry[F],
  info: CallInfo,
  take arrival: Option[history.Arrival],
  take args: Bytes,
  take outcome: Bytes
) -> (history.Body, history.Def) uses {} {
  (
    call_body(info, take arrival, take args, take outcome),
    entry_def(core@1/runner.entry_id(f))
  )
}

// An entry's identity as a group definition.
fn entry_def(id: EntryId) -> history.Def uses {} {
  history.Def(
    path: copy_to(heap, string.as_bytes(id.path)),
    fingerprint: copy_to(heap, id.fingerprint),
    code: copy_to(heap, id.code),
    revision: b""
  )
}

// A call's record; `commit` sets its definition index.
fn call_body(
  info: CallInfo,
  take arrival: Option[history.Arrival],
  take args: Bytes,
  take outcome: Bytes
) -> history.Body uses {} {
  Transaction(
    history.Call(
      def: 0,
      at: info.at,
      seed: info.seed,
      caller: copy_to(heap, string.as_bytes(info.caller)),
      arrival: take arrival,
      args: take args,
      outcome: take outcome
    )
  )
}

// The step std's own transactions record (STORE-11 Library).
const LIBRARY_STEP: Bytes = b"std@1/table"

// One of std's own transactions, run by calling `body` directly: a body
// generic over its caller's types, as each of `table.migrate`'s steps is,
// cannot be an entry. Its commit is a Library commit. Outcomes are
// `transact`'s, but a failure in `body` propagates.
fn transact_body[R: inert, E: inert](
  mut s: Store,
  body: fn(mut tx: Tx) -> Result[R, E] uses {}
) -> Result[R, TxFailure[E]] {
  if s.closed {
    return Error(Storage(Closed()))
  }
  let mut tx = Tx(
    txn: serial(mut s),
    limits: s.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  let returned = body(mut tx)
  // The run `tx` ran; its access set is what the entry's reads recorded.
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut t = take ran
  t.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  match take returned {
    Ok(v) => {
      let step: history.Body = Engine(Library(name: LIBRARY_STEP, payload: b""))
      settle(mut s, take t, take step, None()) ? released
      Ok(take v)
    },
    Error(e) => {
      let base = t.base
      discard(mut s, take t)
      gate(mut s, base) ? released
      Error(Aborted(take e))
    },
  }
}

/// Runs the query entry `f` once on `snap`, with a borrowed `Tx` that reads
/// the snapshot and through which no write can be made, call information
/// with no time or seed (a query is not ordered, STORE-4) and `a` decoded
/// afresh. `Error(e)` is `Aborted(e)` and a failure in the run `Faulted(f)`.
pub fn query[A: serializable, R: serializable, E: serializable](
  take snap: Snapshot,
  f: Entry[fn(tx: Tx, info: CallInfo, a: A) -> Result[R, E]],
  a: A
) -> Result[R, TxFailure[E]] uses {} {
  let Ok(argument) = fresh_argument(a) else {
    return Error(Storage(Corrupt("hirsel.argument")))
  }
  let limits = snap.limits
  let budget = snap.energy
  let tx = Tx(
    txn: reading(take snap),
    limits: limits,
    scope: all(Read()),
    points: recorder.new(),
    spans: recorder.new()
  )
  let info = CallInfo(caller: "", at: 0, seed: 0, id: b"")
  let saved = energy.enter(budget)
  let returned = runner.apply(f, tx, info, argument)
  let spent = energy.leave(take saved).exhausted
  let Tx(txn: _, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let _: List[Bytes] = recorder.finish(take read_points)
  let _: List[Span] = recorder.finish(take read_spans)
  if spent {
    drop_spent(take returned)
    return Error(Limit(Energy()))
  }
  match take returned {
    Ok(Ok(v)) => Ok(take v),
    Ok(Error(e)) => Error(Aborted(take e)),
    Error(failure) => Error(Faulted(take failure)),
  }
}

// A run over `snap`'s state.
fn reading(take snap: Snapshot) -> Run uses {} {
  let Snapshot(version: here, index: index, ..) = take snap
  Run(
    base: here,
    state: take index,
    writes: ordered_map.empty(compare_keys),
    access: AccessSet(points: [], spans: []),
    readers: ordered_map.empty(compare_keys),
    pin: None()
  )
}

// The energy what a body that ran out returned may spend as it drops: the
// size of the cleanup reserve its own cleanup had (STORE-11 "Energy").
const SPENT_ENERGY: u64 = 1000000

// Drops what a body that ran out returned within energy of its own, so a
// finalizer of it is bounded as the body's cleanup was.
fn drop_spent[T](take returned: T) uses {} {
  let saved = energy.enter(SPENT_ENERGY)
  let _ = take returned
  let _ = energy.leave(take saved)
}

// Fresh owned data decoded from the canonical encoding of `a` (STORE-2): a
// round trip canonicalizes NaNs and `Set` order, as a recorded call's
// re-execution sees them. A just-encoded value always decodes.
fn fresh_argument[A: serializable](a: A) -> Result[A, DecodeError] uses {} {
  let bytes = codec.encode(a)
  codec.decode(bytes)
}

// The call information of the next transaction `s` orders (STORE-4): no
// caller for a local call, no clock, and a seed from its place in the order.
fn ordered(s: Store) -> CallInfo uses {} {
  CallInfo(
    caller: "",
    at: 0,
    seed: order_seed(s.seed_key, s.visible + 1),
    id: call_id(s.identity, s.visible + 1)
  )
}

// A transaction's id (STORE-4): `H("hirsel.call.v1", identity, at)`,
// length-framed SHA-256 over the store identity in force at the commit and the
// commit version `at` as a little-endian u64. A fork's commits above its fork point
// carry the fork's identity; those at or below it, the origin's.
fn call_id(identity: Bytes, here: u64) -> Bytes uses {} {
  let mut v: List[u8] = []
  for i in 0u64..8 {
    list.push(mut v, int.truncate(here >> i * 8))
  }
  framed_digest([b"hirsel.call.v1", copy identity, bytes.from_list(take v)])
}

// The history format's length-framed SHA-256 of `parts`.
fn framed_digest(parts: List[Bytes]) -> Bytes uses {} {
  let mut out: List[u8] = []
  for part in parts {
    let n = bytes.len(part)
    for i in 0u64..8 {
      list.push(mut out, int.truncate(n >> i * 8))
    }
    for i in 0u64..n {
      list.push(mut out, part[i])
    }
  }
  history.digest(bytes.from_list(take out))
}

// The first eight bytes, little-endian, of `H("hirsel.seed.v1", identity)`.
fn seed_key(identity: Bytes) -> u64 uses {} {
  let d = framed_digest([b"hirsel.seed.v1", copy identity])
  let mut k = 0u64
  for i in 0u64..8 {
    let byte: u64 = int.widen(d[i])
    k = k | byte << i * 8
  }
  k
}

// The default seed at version `n` (STORE-4): element `n` of the splitmix64
// stream that starts at the store's `seed_key`, so it derives from the store
// identity and the version, and distinct versions of one store differ.
fn order_seed(key: u64, n: u64) -> u64 uses {} {
  let step = core@1/int.wrapping_mul(n, 0x9e3779b97f4a7c15u64)
  let mut z = core@1/int.wrapping_add(key, step)
  z = core@1/int.wrapping_mul(z ^ z >> 30, 0xbf58476d1ce4e5b9u64)
  z = core@1/int.wrapping_mul(z ^ z >> 27, 0x94d049bb133111ebu64)
  z ^ z >> 31
}

/// `transact` as one request on an ordered call stream, exactly once per
/// position. The stream's row decides the request in the transaction that
/// would run it: a stream another caller owns, or an epoch below the row's, is
/// `Denied()`; a position at or
/// below the acknowledged one, above the next one, or retained with another
/// digest is `Rejected()`, as is a stream identity or request digest that is
/// not 32 bytes; a retained position with an equal digest returns
/// its recorded outcome without running `f`; the next position runs `f`, and
/// the same commit records the outcome in the row, so an outcome is recorded
/// exactly when its writes commit. An outcome that writes nothing (an abort, a
/// limit) is recorded by a commit of the row alone. A failure in the run is
/// `Tx(Faulted(f))`, recorded nowhere: the position stays the next one. Each
/// commit records the call with the stream, position and digest it arrived on.
pub fn call[A: serializable, R: serializable, E: serializable](
  mut s: Store,
  req: CallRequest,
  f: Entry[fn(mut tx: Tx, info: CallInfo, a: A) -> Result[R, E]],
  a: A
) -> Result[R, CallFailure[E]] {
  if s.closed {
    return Error(Tx(Storage(Closed())))
  }
  let key = stream_key(req.stream)
  let t = serial(mut s)
  let base = t.base
  let row = match decide(mut s, t, key, req, "") {
    Error(e) => {
      discard(mut s, take t)
      return Error(Tx(Storage(take e)))
    },
    Ok(Deny()) => {
      discard(mut s, take t)
      return refuse(mut s, base, Denied())
    },
    Ok(Reject()) => {
      discard(mut s, take t)
      return refuse(mut s, base, Rejected())
    },
    Ok(Recorded(row, end)) => {
      discard(mut s, take t)
      let recorded: Option[Result[R, TxFailure[E]]] = recorded_outcome(take end)
      let Some(outcome) = take recorded else {
        return Error(Tx(Storage(stop(mut s, Corrupt("hirsel.streams")))))
      }
      replayed(mut s, take row, key, req, base) ? released_call
      return match take outcome {
        Ok(v) => Ok(take v),
        Error(failed) => Error(Tx(take failed)),
      }
    },
    Ok(Next(row)) => take row,
  }
  let args = codec.encode(a)
  let decoded: Result[A, DecodeError] = codec.decode(args)
  let Ok(argument) = take decoded else {
    discard(mut s, take t)
    return Error(Tx(Storage(Corrupt("hirsel.argument"))))
  }
  let info = ordered(s)
  let mut tx = Tx(
    txn: take t,
    limits: s.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  // The row read decides the request, so the run read it.
  recorder.append(tx.points, copy key)
  let saved = energy.enter(s.config.energy)
  let returned = runner.apply_mut(f, mut tx, info, argument)
  let spent = energy.leave(take saved).exhausted
  // The run `tx` ran; its access set is what the entry's reads recorded.
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut done = take ran
  done.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  // A body that ran out ends `Limit(Energy())` whatever it returned, and the
  // stream records that end.
  let outcome: Result[R, TxFailure[E]] = if spent {
    drop_spent(take returned)
    Error(Limit(Energy()))
  } else {
    match take returned {
      Ok(Ok(v)) => Ok(take v),
      Ok(Error(e)) => Error(Aborted(take e)),
      Error(failure) => {
        discard(mut s, take done)
        gate(mut s, base) ? released_call
        return Error(Tx(Faulted(take failure)))
      },
    }
  }
  let ok = match outcome {
    Ok(_) => true,
    Error(_) => false,
  }
  let recorded = codec.encode(outcome)
  let end: CallEnd = match outcome {
    Ok(v) => Returned(codec.encode(v)),
    Error(failed) => Failed(codec.encode(failed)),
  }
  let limited = fn(l: TxLimit) -> (Bytes, CallEnd) {
    let failure: TxFailure[E] = Limit(l)
    let failed: CallEnd = Failed(codec.encode(failure))
    let o: Result[R, TxFailure[E]] = Error(take failure)
    (codec.encode(o), take failed)
  }
  let id = runner.entry_id(f)
  let def = entry_def(id)
  let expected = copy_to(heap, id.code)
  match record(
    mut s,
    take done,
    ok,
    key,
    take row,
    req,
    take expected,
    def,
    info,
    take args,
    take recorded,
    take end,
    limited
  ) {
    AsRun() => match take outcome {
      Ok(v) => Ok(take v),
      Error(failed) => Error(Tx(take failed)),
    },
    Limited(l) => Error(Tx(Limit(l))),
    Unrecorded(u) => Error(released_call(take u)),
  }
}

// The outcome a stream's recorded end stands for, decoded with the caller's
// own types; `None` for an end no recorded position holds.
fn recorded_outcome[R: serializable, E: serializable](take end: CallEnd) -> Option[
  Result[R, TxFailure[E]]
] uses {} {
  match take end {
    Returned(bytes) => {
      let decoded: Result[R, DecodeError] = codec.decode(bytes)
      match take decoded {
        Ok(v) => Some(Ok(take v)),
        Error(_) => None(),
      }
    },
    Failed(bytes) => {
      let decoded: Result[TxFailure[E], DecodeError] = codec.decode(bytes)
      match take decoded {
        Ok(failure) => Some(Error(take failure)),
        Error(_) => None(),
      }
    },
    _ => None(),
  }
}

// How a stream decides a request (STORE-12): refused for its epoch or its
// position; a position whose end the stream records, with that end's bytes; or
// the next position, which runs.
type Decision = Deny | Reject | Recorded(StreamRow, CallEnd) | Next(StreamRow)

// Decides `req` from `caller` on the stream row under `key` as the run `t`
// reads it. A stream belongs to the caller that first used it: another
// caller's request is `Deny()`, before any position is looked at, so no
// recorded end reaches a caller that does not own it. A row that does not
// decode closes the store.
fn decide(mut s: Store, t: Run, key: Bytes, req: CallRequest, caller: String) -> Result[
  Decision,
  StoreError
] uses {} {
  if bytes.len(req.stream) != 32 || bytes.len(req.digest) != 32 {
    return Ok(Reject())
  }
  let row = match ordered_map.get(t.state, key) {
    None() => StreamRow(
      owner: unique caller,
      epoch: 0,
      applied: 0,
      acknowledged: 0,
      retained: []
    ),
    Some(data) => {
      let decoded: Result[StreamRow, DecodeError] = codec.decode(data)
      match take decoded {
        Ok(r) => take r,
        Error(_) => return Error(stop(mut s, Corrupt("hirsel.streams"))),
      }
    },
  }
  if row.owner != caller || req.epoch < row.epoch {
    return Ok(Deny())
  }
  if req.position <= row.acknowledged || req.position > row.applied + 1 || req.acknowledged >= req.position {
    return Ok(Reject())
  }
  if req.position > row.applied {
    return Ok(Next(take row))
  }
  let mut found: Option[CallEnd] = None()
  for r in row.retained {
    if r.position == req.position && r.digest == req.digest {
      found = Some(copy r.end)
    }
  }
  match take found {
    // Another request at a recorded position.
    None() => Ok(Reject()),
    Some(end) => Ok(Recorded(take row, take end)),
  }
}

// Releases a recorded end: a later executor's duplicate fences the earlier
// ones, in a commit of the row alone.
fn replayed(mut s: Store, take row: StreamRow, key: Bytes, req: CallRequest, base: u64) -> Result[
  (),
  Unreleased
] {
  if req.epoch <= row.epoch {
    return gate(mut s, base)
  }
  let mut fenced = take row
  fenced.epoch = req.epoch
  let mut fence = serial(mut s)
  run_put(mut fence, unique key, codec.encode(fenced))
  let body: history.Body = Engine(StreamFence(copy_to(heap, req.stream)))
  settle(mut s, take fence, take body, None())
}

// How the commit recording a run's end went: as the run ended; as the limit
// `l`, when the run's writes and the row recording them exceed it; or not at
// all, the position staying the next one.
type Recording = AsRun | Limited(TxLimit) | Unrecorded(Unreleased)

// Records the run `done`'s end, `recorded`, at `req`'s position and commits
// it as a call of `def` with `info` and `args`: with the run's writes when
// `ok`, else in a commit of the row alone. The row counts against the limits
// like the body's writes: when they exceed them, the end is `limited(l)`,
// recorded by a commit of the row alone; when not even that fits (its caller
// holds too many ends unacknowledged), nothing is recorded.
fn record(
  mut s: Store,
  take done: Run,
  ok: bool,
  key: Bytes,
  take row: StreamRow,
  req: CallRequest,
  take expected: Bytes,
  def: history.Def,
  info: CallInfo,
  take args: Bytes,
  take recorded: Bytes,
  take end: CallEnd,
  limited: fn(l: TxLimit) -> (Bytes, CallEnd) uses {}
) -> Recording {
  let mut next = take row
  next.epoch = req.epoch
  next.applied = req.position
  if req.acknowledged > next.acknowledged {
    next.acknowledged = req.acknowledged
  }
  let mut kept: List[Retained] = []
  for r in next.retained {
    if r.position > next.acknowledged {
      list.push(mut kept, copy r)
    }
  }
  next.retained = take kept
  let mut commit_set = if ok {
    take done
  } else {
    discard(mut s, take done)
    serial(mut s)
  }
  put_row(mut commit_set, unique key, copy next, req, take end)
  let arrival = history.Arrival(
    identity: copy_to(heap, req.stream),
    position: req.position,
    digest: copy_to(heap, req.digest),
    expected: take expected
  )
  let body = call_body(info, Some(copy arrival), copy args, take recorded)
  let l = match settle(mut s, take commit_set, take body, Some(unique def)) {
    Ok(()) => return AsRun(),
    Error(Limit(over)) => over,
    Error(u) => return Unrecorded(take u),
  }
  let (ended, ended_end) = limited(l)
  let mut alone = serial(mut s)
  put_row(mut alone, unique key, take next, req, take ended_end)
  let row_alone = call_body(info, Some(take arrival), take args, take ended)
  // A limit here leaves the position the next one.
  match settle(mut s, take alone, take row_alone, Some(unique def)) {
    Ok(()) => Limited(l),
    Error(u) => Unrecorded(take u),
  }
}

/// One entry a place's head serves (STORE-12), with its form: its identity and
/// its evaluation over argument bytes, specialized to its types when made.
pub opaque type Served: copyable uses {} {
  entry: EntryId,
  body: ServedBody,
  // The bytes of the outcome `Error(Limit(l))` (a `Result[R, TxFailure[E]]`)
  // and of `TxFailure[E]` `Limit(l)`, and of `TxFailure[E]` `Storage(e)`.
  limited: fn(l: TxLimit) -> (Bytes, Bytes) uses {},
  refused: fn(e: StoreError) -> Bytes uses {},
}

type ServedBody = Transacting(
  fn(mut tx: Tx, info: CallInfo, argument: Bytes) -> Evaluated uses {}
) | Querying(fn(tx: Tx, info: CallInfo, argument: Bytes) -> Evaluated uses {})

// One evaluation of a served entry: an argument that does not decode, a
// failure in the run, or the body's outcome as the stream records it (a
// `Result[R, TxFailure[E]]`) and as the call ends.
type Evaluated = Undecoded | Faulting(Failure) | Ended(
  ok: bool,
  recorded: Bytes,
  end: CallEnd
)

/// Serves the transaction entry `f`.
pub fn served_transact[A: serializable, R: serializable, E: serializable](
  f: Entry[fn(mut tx: Tx, info: CallInfo, a: A) -> Result[R, E]]
) -> Served uses {} {
  Served(
    entry: runner.entry_id(f),
    body: Transacting(
      fn(mut tx: Tx, info: CallInfo, argument: Bytes) -> Evaluated {
        let decoded: Result[A, DecodeError] = codec.decode(argument)
        let Ok(a) = take decoded else {
          return Undecoded()
        }
        match runner.apply_mut(f, mut tx, info, take a) {
          Ok(Ok(v)) => {
            let end: CallEnd = Returned(codec.encode(v))
            let outcome: Result[R, TxFailure[E]] = Ok(take v)
            Ended(ok: true, recorded: codec.encode(outcome), end: take end)
          },
          Ok(Error(e)) => {
            let failure: TxFailure[E] = Aborted(take e)
            let end: CallEnd = Failed(codec.encode(failure))
            let outcome: Result[R, TxFailure[E]] = Error(take failure)
            Ended(ok: false, recorded: codec.encode(outcome), end: take end)
          },
          Error(failure) => Faulting(take failure),
        }
      }
    ),
    limited: fn(l: TxLimit) -> (Bytes, Bytes) {
      let failure: TxFailure[E] = Limit(l)
      let end = codec.encode(failure)
      let outcome: Result[R, TxFailure[E]] = Error(take failure)
      (codec.encode(outcome), take end)
    },
    refused: fn(e: StoreError) -> Bytes {
      let failure: TxFailure[E] = Storage(copy e)
      codec.encode(failure)
    }
  )
}

/// Serves the query entry `f`.
pub fn served_query[A: serializable, R: serializable, E: serializable](
  f: Entry[fn(tx: Tx, info: CallInfo, a: A) -> Result[R, E]]
) -> Served uses {} {
  Served(
    entry: runner.entry_id(f),
    body: Querying(
      fn(tx: Tx, info: CallInfo, argument: Bytes) -> Evaluated {
        let decoded: Result[A, DecodeError] = codec.decode(argument)
        let Ok(a) = take decoded else {
          return Undecoded()
        }
        match runner.apply(f, tx, info, take a) {
          Ok(Ok(v)) => Ended(ok: true, recorded: b"", end: Returned(codec.encode(v))),
          Ok(Error(e)) => {
            let failure: TxFailure[E] = Aborted(take e)
            Ended(ok: false, recorded: b"", end: Failed(codec.encode(failure)))
          },
          Error(failure) => Faulting(take failure),
        }
      }
    ),
    limited: fn(l: TxLimit) -> (Bytes, Bytes) {
      let failure: TxFailure[E] = Limit(l)
      let end = codec.encode(failure)
      let outcome: Result[R, TxFailure[E]] = Error(take failure)
      (codec.encode(outcome), take end)
    },
    refused: fn(e: StoreError) -> Bytes {
      let failure: TxFailure[E] = Storage(copy e)
      codec.encode(failure)
    }
  )
}

/// Serves the calls that arrive in `inbox` with `entries` until the inbox
/// closes, which returns `Ok(())`, or the store closes, which returns its
/// error (STORE-12). A transact call is decided on its call stream first, in
/// the transaction that would run it, as `call` decides it: a recorded
/// position ends with its recorded end whatever code the head now runs. A call
/// that runs names its entry by path and fingerprint: a path `entries` does
/// not serve, or serves in the other form, ends `NotRun(Denied())`; another
/// fingerprint ends `NotRun(VersionMismatch())`; the head runs its own code and
/// records the caller's code hash beside it. A query reads the latest commit. An argument
/// that does not decode ends `NotRun(Rejected())`. Each end is given once the
/// output gate releases it. A store that closes, a fenced one included, ends
/// the arrivals it holds `InDoubt(Abandoned())`; the calls still in the inbox
/// never ran. `entries` naming one path twice is `InvalidInput()`.
pub fn serve(mut s: Store, take inbox: Inbox, entries: List[Served]) -> Result[
  (),
  StoreError
] uses {inbox} {
  let mut i: u64 = 0
  while i < list.len(entries) {
    let mut j = i + 1
    while j < list.len(entries) {
      if entries[i].entry.path == entries[j].entry.path {
        return Error(InvalidInput())
      }
      j += 1
    }
    i += 1
  }
  let mut held = take inbox
  // The arrivals run and not yet ended, with each one's end and the version
  // its output gates asked for, over `batches` inbox batches.
  let mut ran: List[Arrival] = []
  let mut ends: List[CallEnd] = []
  let mut needs: List[u64] = []
  let mut batches: u64 = 0
  let mut broken = false
  let mut next = inbox.take(mut held, true)
  while true {
    let Some(arrivals) = take next else {
      return end_held(mut s, take ran, take ends, needs)
    }
    for arrival in take arrivals {
      if s.closed {
        list.push(mut ends, InDoubt(Abandoned()))
        list.push(mut needs, 0)
      } else {
        let request = arrival.request(arrival)
        s.deferred = Some(0)
        let end = serve_one(mut s, entries, take request)
        let need = match replace(mut s.deferred, None()) {
          Some(n) => n,
          None() => 0,
        }
        // A store that closes during an arrival ends it InDoubt; any other end is a bug in std.
        if s.closed && !in_doubt(end) {
          broken = true
          list.push(mut ends, InDoubt(Abandoned()))
        } else {
          list.push(mut ends, take end)
        }
        list.push(mut needs, need)
      }
      list.push(mut ran, take arrival)
    }
    batches += 1
    // Arrivals already waiting run before these ends are released, while
    // fewer than WINDOW batches are held: their commits share the groups and
    // one barrier covers them all.
    next = if s.closed || batches >= WINDOW {
      None()
    } else {
      inbox.take(mut held, false)
    }
    let more = match next {
      Some(got) => list.len(got) > 0,
      None() => false,
    }
    if !more {
      let given = end_held(mut s, take ran, take ends, needs)
      if broken {
        return Error(stop(mut s, Corrupt("hirsel.serve")))
      }
      given?
      ran = []
      ends = []
      needs = []
      batches = 0
      next = inbox.take(mut held, true)
    }
  }
  Ok(())
}

// Whether `end` is in doubt.
fn in_doubt(end: CallEnd) -> bool uses {} {
  match end {
    InDoubt(_) => true,
    _ => false,
  }
}

// Serve holds at most this many inbox batches' ends, and this many groups
// submitted and unanswered.
const WINDOW: u64 = 8

// Ends each of `ran` with its end once every version it saw is durable at the
// floor, after one wait for all of them. An arrival whose version did not
// become durable ends `InDoubt(Abandoned())`, and the store's closing is the
// error.
fn end_held(
  mut s: Store,
  take ran: List[Arrival],
  take ends: List[CallEnd],
  needs: List[u64]
) -> Result[(), StoreError] {
  let mut top: u64 = 0
  for n in needs {
    if n > top {
      top = n
    }
  }
  if !s.closed {
    let _ = release(mut s, top)
  }
  let mut k: u64 = 0
  for arrival in take ran {
    if needs[k] <= s.durable[s.floor] {
      arrival.end(take arrival, copy ends[k])
    } else {
      arrival.end(take arrival, InDoubt(Abandoned()))
    }
    k += 1
  }
  if s.closed {
    return Error(Closed())
  }
  Ok(())
}

// The end of one arrival. A transact call is decided on its stream before its
// entry is resolved, so a recorded position ends as recorded whatever code the
// head now runs; only a call that runs resolves its entry against `entries`.
fn serve_one(mut s: Store, entries: List[Served], take request: Arrived) -> CallEnd {
  let querying = request.form == Query()
  if !querying && request.form != Transact() {
    return NotRun(Denied())
  }
  if !querying {
    return serve_transact(
      mut s,
      entries,
      request.entry,
      request.level,
      request.request,
      request.caller,
      request.argument
    )
  }
  let here = match resolve(entries, request.entry, true, request.level) {
    Ok(here) => here,
    Error(end) => return take end,
  }
  let served = entries[here]
  let Querying(body) = served.body else {
    return NotRun(Denied())
  }
  // The latest commit, read once it is released.
  let head = s.visible
  if let Error(_) = release(mut s, head) {
    return InDoubt(Abandoned())
  }
  if s.closed {
    return InDoubt(Abandoned())
  }
  let Some(i) = level_index(s, authority.floor(s.authority)) else {
    return InDoubt(Abandoned())
  }
  let Some((floor_version, index)) = durable_state(mut s, i) else {
    return InDoubt(Abandoned())
  }
  let tx = Tx(
    txn: reading(
      take Snapshot(
        version: floor_version,
        index: take index,
        limits: s.limits,
        energy: s.config.energy
      )
    ),
    limits: s.limits,
    scope: all(Read()),
    points: recorder.new(),
    spans: recorder.new()
  )
  let saved = energy.enter(s.config.energy)
  let evaluated = body(
    tx,
    CallInfo(caller: copy request.caller, at: 0, seed: 0, id: b""),
    request.argument
  )
  let spent = energy.leave(take saved).exhausted
  let Tx(txn: _, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let _: List[Bytes] = recorder.finish(take read_points)
  let _: List[Span] = recorder.finish(take read_spans)
  if spent {
    let (_, failed) = served.limited(Energy())
    return Failed(take failed)
  }
  match take evaluated {
    Undecoded() => NotRun(Rejected()),
    Faulting(failure) => Faulted(codec.encode(failure)),
    Ended(ok: _, recorded: _, end: end) => take end,
  }
}

// The index in `entries` of the entry a call that runs names (STORE-12): by path, form and
// signature fingerprint. The caller's code hash is recorded, never compared:
// the head runs its own revision. A path it does not serve, or serves in the
// other form, is `Denied()`; another fingerprint is `VersionMismatch()`; a
// level the store does not declare is `Storage(NoLevel())`, definite.
fn resolve(entries: List[Served], entry: EntryId, querying: bool, level: Option[String]) -> Result[
  u64,
  CallEnd
] uses {} {
  let mut found: Option[u64] = None()
  let mut k: u64 = 0
  while k < list.len(entries) {
    if entries[k].entry.path == entry.path {
      found = Some(k)
    }
    k += 1
  }
  let Some(here) = found else {
    return Error(NotRun(Denied()))
  }
  let served = entries[here]
  let serves_query = match served.body {
    Transacting(_) => false,
    Querying(_) => true,
  }
  if serves_query != querying {
    return Error(NotRun(Denied()))
  }
  if served.entry.fingerprint != entry.fingerprint {
    return Error(NotRun(VersionMismatch()))
  }
  if let Some(_) = level {
    return Error(Failed(served.refused(NoLevel())))
  }
  Ok(here)
}

// A served transact call, decided on its stream as `call` decides it: the
// stream answers a recorded position before any entry is resolved.
fn serve_transact(
  mut s: Store,
  entries: List[Served],
  entry: EntryId,
  level: Option[String],
  req: CallRequest,
  caller: String,
  argument: Bytes
) -> CallEnd {
  if bytes.len(req.stream) != 32 {
    return NotRun(Rejected())
  }
  let key = stream_key(req.stream)
  let t = serial(mut s)
  let base = t.base
  let row = match decide(mut s, t, key, req, caller) {
    Error(_) => {
      discard(mut s, take t)
      return InDoubt(Abandoned())
    },
    Ok(Deny()) => {
      discard(mut s, take t)
      return released_end(mut s, base, NotRun(Denied()))
    },
    Ok(Reject()) => {
      discard(mut s, take t)
      return released_end(mut s, base, NotRun(Rejected()))
    },
    Ok(Recorded(row, end)) => {
      discard(mut s, take t)
      return match replayed(mut s, take row, key, req, base) {
        Ok(()) => take end,
        Error(_) => InDoubt(Abandoned()),
      }
    },
    Ok(Next(row)) => take row,
  }
  let here = match resolve(entries, entry, false, level) {
    Ok(here) => here,
    Error(end) => {
      discard(mut s, take t)
      return released_end(mut s, base, take end)
    },
  }
  let served = entries[here]
  let Transacting(body) = served.body else {
    discard(mut s, take t)
    return released_end(mut s, base, NotRun(Denied()))
  }
  let info = CallInfo(
    caller: copy caller,
    at: 0,
    seed: order_seed(s.seed_key, s.visible + 1),
    id: call_id(s.identity, s.visible + 1)
  )
  let mut tx = Tx(
    txn: take t,
    limits: s.limits,
    scope: everything(),
    points: recorder.new(),
    spans: recorder.new()
  )
  // The row read decides the request, so the run read it.
  recorder.append(tx.points, copy key)
  let saved = energy.enter(s.config.energy)
  let evaluated = body(mut tx, info, argument)
  let spent = energy.leave(take saved).exhausted
  let Tx(txn: ran, limits: _, scope: _, points: read_points, spans: read_spans) = take tx
  let mut done = take ran
  done.access = AccessSet(
    points: recorder.finish(take read_points),
    spans: recorder.finish(take read_spans)
  )
  // A body that ran out ends `Limit(Energy())` whatever it returned, and the
  // stream records that end.
  let (ok, recorded, end) = if spent {
    let (outcome, failed) = served.limited(Energy())
    let end: CallEnd = Failed(take failed)
    (false, take outcome, take end)
  } else {
    match take evaluated {
      Undecoded() => {
        discard(mut s, take done)
        return released_end(mut s, base, NotRun(Rejected()))
      },
      Faulting(failure) => {
        discard(mut s, take done)
        return released_end(mut s, base, Faulted(codec.encode(failure)))
      },
      Ended(ok: ok, recorded: recorded, end: end) => (ok, take recorded, take end),
    }
  }
  let limited = fn(l: TxLimit) -> (Bytes, CallEnd) {
    let (outcome, failed) = served.limited(l)
    (outcome, Failed(failed))
  }
  let def = entry_def(served.entry)
  let expected = copy_to(heap, entry.code)
  match record(
    mut s,
    take done,
    ok,
    key,
    take row,
    req,
    take expected,
    def,
    info,
    unique argument,
    take recorded,
    copy end,
    limited
  ) {
    AsRun() => take end,
    Limited(l) => {
      let (_, failed) = served.limited(l)
      Failed(take failed)
    },
    Unrecorded(Limit(l)) => {
      let (_, failed) = served.limited(l)
      Failed(take failed)
    },
    Unrecorded(Storage(e)) => {
      if s.closed {
        return InDoubt(Abandoned())
      }
      Failed(served.refused(take e))
    },
    Unrecorded(Unknown(_)) => InDoubt(Abandoned()),
  }
}

// `end` once every commit the request could see is durable.
fn released_end(mut s: Store, base: u64, take end: CallEnd) -> CallEnd {
  match gate(mut s, base) {
    Ok(()) => take end,
    Error(_) => InDoubt(Abandoned()),
  }
}

// The reserved namespace `hirsel.` is exactly the keys in [RESERVED_LO,
// RESERVED_HI): '/' follows '.'.
const RESERVED_LO: Bytes = b"hirsel."

const RESERVED_HI: Bytes = b"hirsel/"

/// The value under `key` as the transaction sees it, a view into `tx`: it
/// stays valid until `tx` is next written. The read enters the run's access
/// set, whether or not `key` holds a value.
pub fn tx_get(tx: Tx, key: Bytes) -> Result[Option[Bytes] in tx, TxError]
  requires !reserved(key) {
  // Inline, passing no Tx to a callee: unnarrowed, the scope costs one branch.
  if !tx.scope.whole {
    check(key_held(tx.scope.spans, key), false)?
  }
  if bytes.len(key) > tx.limits.key_bytes {
    return Error(Limit(KeyBytes()))
  }
  recorder.append(tx.points, copy_to(heap, key))
  Ok(ordered_map.get(tx.txn.state, key))
}

/// `tx_get` with `within` checked in place of the transaction's scope:
/// `OutOfScope()` without reading unless the transaction's scope holds every
/// key `within` holds, at any access, and `within` holds `key`.
pub fn tx_get_in(tx: Tx, within: KeyScope, key: Bytes) -> Result[
  Option[Bytes] in tx,
  TxError
]
  requires !reserved(key) {
  read_within(tx, within)?
  table_read(tx, within, copy_to(heap, key))
}

/// Stores `value` under `key` when the transaction commits. The commit
/// checks the write limits.
pub fn tx_put(mut tx: Tx, take key: Bytes, take value: Bytes) -> Result[(), TxError]
  requires !reserved(key) {
  admit(tx.scope, key, true)?
  run_put(mut tx.txn, take key, take value)
  Ok(())
}

/// Removes `key` when the transaction commits.
pub fn tx_delete(mut tx: Tx, take key: Bytes) -> Result[(), TxError]
  requires !reserved(key) {
  admit(tx.scope, key, true)?
  run_delete(mut tx.txn, take key)
  Ok(())
}

/// Folds `step` over at most `limit` entries with keys between `from` and
/// `to` as the transaction sees them, in `order`, starting from `initial`.
/// `step` gets each key and value as views of the transaction's state that
/// last for its call, and returns the next accumulator and whether to go on;
/// it copies what it keeps, and cannot write through `tx` while the fold
/// reads it. Keys in the reserved namespace are passed over as if absent, and
/// the scope need not hold them. The interval the fold consumed enters the
/// run's access set: up to the entry where `step` stopped or the `limit`-th
/// entry, the whole range otherwise.
pub fn tx_range[A](
  tx: Tx,
  from: RangeBound[Bytes],
  to: RangeBound[Bytes],
  limit: u64,
  order: ScanOrder,
  take initial: A,
  step: fn(take A, Bytes, Bytes) -> (A, bool)
) -> Result[A, TxError] {
  fold_keys(tx, tx.scope, from, to, limit, order, take initial, step)
}

/// `tx_range` with `within` checked in place of the transaction's scope:
/// `OutOfScope()` without reading unless the transaction's scope holds every
/// key `within` holds, at any access, and `within` holds the range.
pub fn tx_range_in[A](
  tx: Tx,
  within: KeyScope,
  from: RangeBound[Bytes],
  to: RangeBound[Bytes],
  limit: u64,
  order: ScanOrder,
  take initial: A,
  step: fn(take A, Bytes, Bytes) -> (A, bool)
) -> Result[A, TxError] {
  read_within(tx, within)?
  fold_keys(tx, within, from, to, limit, order, take initial, step)
}

// `tx_range` with `scope` checked in place of the transaction's.
fn fold_keys[A](
  tx: Tx,
  scope: KeyScope,
  from: RangeBound[Bytes],
  to: RangeBound[Bytes],
  limit: u64,
  order: ScanOrder,
  take initial: A,
  step: fn(take A, Bytes, Bytes) -> (A, bool)
) -> Result[A, TxError] {
  if limit == 0 {
    return Error(InvalidInput())
  }
  let lo = lower_key(from)
  let hi = upper_key(to)
  // The parts of [lo, hi) below and above the reserved namespace.
  let below: Option[(Bytes, Option[Bytes])] = if lo < RESERVED_LO {
    Some((copy lo, Some(min_end(hi, RESERVED_LO))))
  } else {
    None()
  }
  let above: Option[(Bytes, Option[Bytes])] = if before_end(RESERVED_HI, hi) {
    let start = if lo < RESERVED_HI {
      RESERVED_HI
    } else {
      copy lo
    }
    Some((take start, copy hi))
  } else {
    None()
  }
  if !scope.whole {
    if let Some((a, b)) = below {
      check(spans_hold(scope.spans, a, b, false), false)?
    }
    if let Some((a, b)) = above {
      check(spans_hold(scope.spans, a, b, false), false)?
    }
  }
  if limit > tx.limits.range_rows {
    return Error(Limit(RangeRows()))
  }
  let ascending = match order {
    Ascending() => true,
    Descending() => false,
  }
  let (first, second) = if ascending {
    (take below, take above)
  } else {
    (take above, take below)
  }
  let (folded, left) = scan(tx, take first, ascending, limit, take initial, step)
  if left == 0 {
    return Ok(take folded)
  }
  let (out, _) = scan(tx, take second, ascending, left, take folded, step)
  Ok(take out)
}

// Folds `step` over the part [lo, hi) of a range, at most `limit` entries,
// and records the interval it consumed. Returns the accumulator and how many
// more entries the range may take: 0 once `step` stopped or the limit was
// reached, so a later part is not read.
fn scan[A](
  tx: Tx,
  take part: Option[(Bytes, Option[Bytes])],
  ascending: bool,
  limit: u64,
  take initial: A,
  step: fn(take A, Bytes, Bytes) -> (A, bool)
) -> (A, u64) {
  let Some((lo, hi)) = take part else {
    return (take initial, limit)
  }
  if !before_end(lo, hi) {
    return (take initial, limit)
  }
  let low: ordered_map.Bound[Bytes] = Included(take lo)
  let high: ordered_map.Bound[Bytes] = match take hi {
    Some(h) => Excluded(take h),
    None() => Unbounded(),
  }
  let direction: ordered_map.Direction = if ascending {
    Ascending()
  } else {
    Descending()
  }
  // The accumulator, the entries left, and the key the fold stopped at.
  let start: (A, u64, Option[Bytes]) = (take initial, limit, None())
  let (folded, left, cut) = ordered_map.fold_range(
    tx.txn.state,
    low,
    high,
    direction,
    take start,
    fn(take walk: (A, u64, Option[Bytes]), k: Bytes, v: Bytes) -> (
      (A, u64, Option[Bytes]),
      bool
    ) {
      let (acc, left, _) = take walk
      let (next, more) = step(take acc, k, v)
      if more && left > 1 {
        ((take next, left - 1, None()), true)
      } else {
        ((take next, 0, Some(copy_to(heap, k))), false)
      }
    }
  )
  let span = match take cut {
    Some(c) => match direction {
      Ascending() => Span(from: take low, to: Included(take c), direction: direction),
      Descending() => Span(from: Included(take c), to: take high, direction: direction),
    },
    None() => Span(from: take low, to: take high, direction: direction),
  }
  recorder.append(tx.spans, take span)
  (take folded, left)
}

// The least key a lower bound admits.
fn lower_key(b: RangeBound[Bytes]) -> Bytes uses {} {
  match b {
    Unbounded() => b"",
    Included(k) => unique k,
    Excluded(k) => successor(k),
  }
}

// The least key above every key an upper bound admits, `None()` for none.
fn upper_key(b: RangeBound[Bytes]) -> Option[Bytes] uses {} {
  match b {
    Unbounded() => None(),
    Included(k) => Some(successor(k)),
    Excluded(k) => Some(unique k),
  }
}

// The least key after `k`: `k` followed by a zero byte.
fn successor(k: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  bytes.append(mut out, k)
  list.push(mut out, 0)
  bytes.from_list(take out)
}

// Whether `k` lies before the end `hi` (no end lies after every key).
fn before_end(k: Bytes, hi: Option[Bytes]) -> bool uses {} {
  match hi {
    Some(h) => k < h,
    None() => true,
  }
}

fn min_end(hi: Option[Bytes], k: Bytes) -> Bytes uses {} {
  match hi {
    Some(h) => if h < k {
      unique h
    } else {
      unique k
    },
    None() => unique k,
  }
}

// What `held` found for an access: 0 none, 1 read, 2 read and write.
fn check(held: u8, write: bool) -> Result[(), TxError] uses {} {
  if held == 0 {
    return Error(OutOfScope())
  }
  if write && held == 1 {
    return Error(ReadOnly())
  }
  Ok(())
}

// Checks access to one key. An unnarrowed Tx costs one branch; a narrowed
// one a binary search over its spans, comparing the key in place.
fn admit(scope: KeyScope, key: Bytes, write: bool) -> Result[(), TxError] uses {} {
  if scope.whole {
    return Ok(())
  }
  check(key_held(scope.spans, key), write)
}

// The access `spans` give `key`: 0 none, 1 read, 2 read and write.
fn key_held(spans: List[ScopeSpan], key: Bytes) -> u8 uses {} {
  // The number of spans starting at or before `key`.
  let mut low: u64 = 0
  let mut high = list.len(spans)
  while low < high {
    let mid = low + (high - low) / 2
    if spans[mid].lo <= key {
      low = mid + 1
    } else {
      high = mid
    }
  }
  if low == 0 {
    return 0
  }
  let span = spans[low - 1]
  if !before_end(key, span.hi) {
    return 0
  }
  if span.write {
    2
  } else {
    1
  }
}

// The weakest access `spans` give a key in [lo, hi), 0 when one is outside
// them; an empty interval needs nothing. A merge walk over the spans it
// overlaps.
fn spans_hold(spans: List[ScopeSpan], lo: Bytes, hi: Option[Bytes], write: bool) -> u8 uses {} {
  if !before_end(lo, hi) {
    return 2
  }
  let mut weakest: u8 = 2
  let mut here = copy lo
  for span in spans {
    if !before_end(here, span.hi) {
      continue
    }
    if here < span.lo {
      return 0
    }
    if !span.write {
      weakest = 1
      if write {
        return 1
      }
    }
    match span.hi {
      None() => return weakest,
      Some(end) => {
        let reached = match hi {
          Some(h) => h <= end,
          None() => false,
        }
        if reached {
          return weakest
        }
        here = copy end
      },
    }
  }
  0
}

// Library operations: the byte operations without the reserved-namespace
// requirement, for libraries that keep their own rows under `hirsel.`. They
// check scope as the byte operations do; the engine makes no exception for
// a library's rows.
// The value of `key` in this transaction, after checking read access and
// the key limit. The read enters the run's access set.
fn table_read(tx: Tx, scope: KeyScope, take key: Bytes) -> Result[
  Option[Bytes] in tx,
  TxError
] {
  admit(scope, key, false)?
  if bytes.len(key) > tx.limits.key_bytes {
    return Error(Limit(KeyBytes()))
  }
  let found = ordered_map.get(tx.txn.state, key)
  recorder.append(tx.points, take key)
  Ok(found)
}

// Writes one key after checking write access and the limits, so a refusal
// leaves the transaction unchanged.
fn table_put(mut tx: Tx, take key: Bytes, take value: Bytes) -> Result[(), TxError] {
  admit(tx.scope, key, true)?
  if let Some(limit) = check_put(tx, key, value) {
    return Error(Limit(limit))
  }
  run_put(mut tx.txn, take key, take value)
  Ok(())
}

// Deletes one key after checking write access and the limits.
fn table_delete(mut tx: Tx, take key: Bytes) -> Result[(), TxError] {
  admit(tx.scope, key, true)?
  if let Some(limit) = check_delete(tx, key) {
    return Error(Limit(limit))
  }
  run_delete(mut tx.txn, take key)
  Ok(())
}

// Folds `step` over at most `limit` entries of [lo, hi), as `tx_range` does,
// after checking read access to all of it, reserved keys included, and the
// row limit.
fn table_range[A](
  tx: Tx,
  scope: KeyScope,
  take lo: Bytes,
  take hi: Option[Bytes],
  limit: u64,
  order: ScanOrder,
  take initial: A,
  step: fn(take A, Bytes, Bytes) -> (A, bool)
) -> Result[A, TxError] {
  if !scope.whole {
    check(spans_hold(scope.spans, lo, hi, false), false)?
  }
  if limit > tx.limits.range_rows {
    return Error(Limit(RangeRows()))
  }
  let ascending = match order {
    Ascending() => true,
    Descending() => false,
  }
  let (folded, _) = scan(
    tx,
    Some((take lo, take hi)),
    ascending,
    limit,
    take initial,
    step
  )
  Ok(take folded)
}

// Checks write access to one key without touching it: an operation that
// writes a key checks that before it reads anything about it.
fn admit_write(tx: Tx, key: Bytes) -> Result[(), TxError] {
  admit(tx.scope, key, true)
}

/// The keys between `from` and `to` outside the reserved namespace, each with
/// `access`.
pub fn keys(from: RangeBound[Bytes], to: RangeBound[Bytes], access: Access) -> KeyScope uses {} {
  let lo = lower_key(from)
  let hi = upper_key(to)
  let write = writable(access)
  let mut parts: List[ScopeSpan] = []
  if lo < RESERVED_LO {
    list.push(
      mut parts,
      ScopeSpan(lo: copy lo, hi: Some(min_end(hi, RESERVED_LO)), write: write)
    )
  }
  if before_end(RESERVED_HI, hi) {
    let start = if lo < RESERVED_HI {
      RESERVED_HI
    } else {
      copy lo
    }
    list.push(mut parts, ScopeSpan(lo: take start, hi: copy hi, write: write))
  }
  union(parts, [])
}

/// Every key, the reserved namespace included, with `access`.
pub fn all(access: Access) -> KeyScope uses {} {
  let write = writable(access)
  KeyScope(spans: [ScopeSpan(lo: b"", hi: None(), write: write)], whole: write)
}

// The keys in [lo, hi), the reserved namespace included, with `access`: for
// libraries that build scopes over their own rows.
fn interval(lo: Bytes, hi: Option[Bytes], access: Access) -> KeyScope uses {} {
  union([ScopeSpan(lo: unique lo, hi: unique hi, write: writable(access))], [])
}

/// The keys of `a` and of `b`, each with the stronger of its accesses.
pub fn join(a: KeyScope, b: KeyScope) -> KeyScope uses {} {
  union(a.spans, b.spans)
}

/// Runs `body` once with a `Tx` of the same transaction whose scope is exactly
/// `scope`, and returns its result; `OutOfScope()` without running `body`
/// unless `scope` is within `tx`'s scope. The narrowed `Tx` reads the same
/// state, and its writes are the transaction's writes.
pub fn narrow[R: inert](mut tx: Tx, scope: KeyScope, body: fn(mut sub: Tx) -> R uses {}) -> Result[
  R,
  TxError
] {
  if !scope_within(scope, tx.scope, false) {
    return Error(OutOfScope())
  }
  let outer = replace(mut tx.scope, unique scope)
  let returned = body(mut tx)
  tx.scope = take outer
  Ok(take returned)
}

// The transaction's scope, for a library read that checks it as the byte
// reads do.
fn tx_scope(tx: Tx) -> KeyScope in tx uses {} {
  tx.scope
}

// `OutOfScope()` unless `tx`'s scope holds every key `scope` holds, at any
// access: what a read within `scope` checks before it reads.
fn read_within(tx: Tx, scope: KeyScope) -> Result[(), TxError] uses {} {
  if scope_within(scope, tx.scope, true) {
    Ok(())
  } else {
    Error(OutOfScope())
  }
}

// Whether every key `inner` holds, `outer` holds with an access at least as
// strong, or with any access when `read`: one pass over both sorted span
// lists, never moving back in `outer`.
fn scope_within(inner: KeyScope, outer: KeyScope, read: bool) -> bool uses {} {
  if outer.whole {
    return true
  }
  let n = list.len(outer.spans)
  let mut j: u64 = 0
  for span in inner.spans {
    while j < n && !before_end(span.lo, outer.spans[j].hi) {
      j += 1
    }
    // Walk the outer spans that cover [span.lo, span.hi) without a gap.
    let mut here = copy span.lo
    let mut held = false
    while !held {
      if j == n || here < outer.spans[j].lo || !read && span.write && !outer.spans[j].write {
        return false
      }
      match outer.spans[j].hi {
        None() => {
          held = true
        },
        Some(end) => {
          held = match span.hi {
            Some(h) => h <= end,
            None() => false,
          }
          if !held {
            here = copy end
            j += 1
          }
        },
      }
    }
  }
  true
}

fn writable(access: Access) -> bool uses {} {
  match access {
    Read() => false,
    ReadWrite() => true,
  }
}

// The scope of an unnarrowed Tx.
fn everything() -> KeyScope uses {} {
  all(ReadWrite())
}

// The normal form of the union of `a` and `b`, each sorted and disjoint (empty
// spans allowed): each key with its stronger access, sorted, disjoint,
// nonempty, adjacent spans of equal access merged. One sweep in key order
// over both lists; each step passes a span end or start.
fn union(a: List[ScopeSpan], b: List[ScopeSpan]) -> KeyScope uses {} {
  let mut spans: List[ScopeSpan] = []
  let na = list.len(a)
  let nb = list.len(b)
  let mut i: u64 = 0
  let mut j: u64 = 0
  let mut here: Bytes in {a, b} = b""
  let mut going = true
  while going {
    while i < na && !before_end(here, a[i].hi) {
      i += 1
    }
    while j < nb && !before_end(here, b[j].hi) {
      j += 1
    }
    if i == na && j == nb {
      going = false
      continue
    }
    // Each list's access at `at` and where it next changes; None is past
    // every key.
    let (held_a, next_a) = piece(a, i, here)
    let (held_b, next_b) = piece(b, j, here)
    let end = if ends_before(next_a, next_b) {
      next_a
    } else {
      next_b
    }
    let held = if held_a > held_b {
      held_a
    } else {
      held_b
    }
    if held > 0 {
      let write = held == 2
      let last = list.len(spans)
      if last > 0 && spans[last - 1].write == write && spans[last - 1].hi == Some(
        copy here
      ) {
        spans[last - 1].hi = unique end
      } else {
        list.push(mut spans, ScopeSpan(lo: unique here, hi: unique end, write: write))
      }
    }
    match end {
      None() => {
        going = false
      },
      Some(e) => {
        here = copy e
      },
    }
  }
  let whole = list.len(spans) == 1 && spans[0].write && spans[0].lo == b"" && spans[0].hi == None()
  KeyScope(spans: take spans, whole: whole)
}

// The access the `k`th of `spans` gives `at` (0 none, 1 read, 2 write), all of
// `spans` before it ending at or before `at`, and the next key where that
// changes; None past every key.
fn piece(spans: List[ScopeSpan], k: u64, here: Bytes) -> (u8, Option[Bytes] in spans) uses {} {
  if k == list.len(spans) {
    return (0, None())
  }
  if here < spans[k].lo {
    return (0, Some(copy spans[k].lo))
  }
  let held: u8 = if spans[k].write {
    2
  } else {
    1
  }
  (held, copy spans[k].hi)
}

// Whether end `x` comes before end `y`, None being past every key.
fn ends_before(x: Option[Bytes], y: Option[Bytes]) -> bool uses {} {
  match x {
    None() => false,
    Some(a) => match y {
      None() => true,
      Some(b) => a < b,
    },
  }
}

fn stream_key(stream: Bytes) -> Bytes uses {} {
  let mut out: List[u8] = []
  for b in b"hirsel.streams/" {
    list.push(mut out, b)
  }
  for b in stream {
    list.push(mut out, b)
  }
  bytes.from_list(take out)
}

// Puts into `set` the stream row `row`, its retained ends followed by `end`
// at `req`'s position.
fn put_row(
  mut set: Run,
  take key: Bytes,
  take row: StreamRow,
  req: CallRequest,
  take end: CallEnd
) -> () uses {} {
  let mut recorded = take row
  list.push(
    mut recorded.retained,
    Retained(position: req.position, digest: unique req.digest, end: take end)
  )
  run_put(mut set, take key, codec.encode(recorded))
}

// Releases a refusal once every commit the request could see is durable.
fn refuse[R, E](mut s: Store, base: u64, take f: CallFailure[E]) -> Result[
  R,
  CallFailure[E]
] {
  gate(mut s, base) ? released_call
  Error(f)
}

// The limit a transaction's writes exceed, if any, as a body's operation
// checks it before writing: a key or value over its limit, or writes whose
// encoding alone exceeds the transaction limit. The commit checks the whole
// encoded commit, its call record included.
fn over_limit(limits: StoreLimits, writes: ordered_map.OrderedMap[Bytes, Option[Bytes]]) -> Option[
  TxLimit
] uses {} {
  let start: (u64, Option[TxLimit]) = (WRITES_FRAME, None())
  let (total, found) = ordered_map.fold_range(
    writes,
    Unbounded(),
    Unbounded(),
    Ascending(),
    start,
    fn(take acc: (u64, Option[TxLimit]), k: Bytes, v: Option[Bytes]) -> (
      (u64, Option[TxLimit]),
      bool
    ) {
      let (sum, _) = acc
      if bytes.len(k) > limits.key_bytes {
        return ((sum, Some(KeyBytes())), false)
      }
      let encoded = match v {
        Some(value) => {
          if bytes.len(value) > limits.value_bytes {
            return ((sum, Some(ValueBytes())), false)
          }
          9 + bytes.len(k) + bytes.len(value)
        },
        None() => 5 + bytes.len(k),
      }
      ((sum + encoded, None()), true)
    }
  )
  match found {
    Some(l) => Some(l),
    None() => if total > limits.transaction_bytes {
      Some(TransactionBytes())
    } else {
      None()
    },
  }
}

// A commit's write count and the least body it can have (an engine commit's
// kind, op and empty payload): what any commit costs beyond its writes.
const WRITES_FRAME: u64 = 11

// The output gate at `upto`: advances the pending group at the floor when
// a commit at or below it is not yet durable there. While a serve runs an
// arrival it only notes `upto`, and the serve releases the arrival's end.
fn gate(mut s: Store, upto: u64) -> Result[(), Unreleased] {
  if upto <= s.durable[s.floor] {
    return Ok(())
  }
  if let Some(n) = s.deferred {
    if s.closed {
      return Error(Storage(Closed()))
    }
    if upto > n {
      s.deferred = Some(upto)
    }
    return Ok(())
  }
  release(mut s, upto)
}

// Waits until every commit up to `upto` is durable at the floor. Groups
// already submitted are answered first, which needs no level: only a commit
// still not durable then asks for the floor.
fn release(mut s: Store, upto: u64) -> Result[(), Unreleased] {
  if upto <= s.durable[s.floor] {
    return Ok(())
  }
  let a = s.authority
  let answerable = match s.pending {
    Some(_) => false,
    None() => !s.closed && list.len(s.submitted) > 0,
  }
  if answerable {
    answer(a, mut s)?
    if upto <= s.durable[s.floor] {
      return Ok(())
    }
  }
  let here = authority.floor(a)
  let i = s.floor
  wait(a, mut s, here, i)
}

// Commits `t` with `body`, the call it records, and releases it at the floor.
// A Library step that writes nothing has nothing to record: it only waits for
// the commit it began at.
fn settle(
  mut s: Store,
  take t: Run,
  take body: history.Body,
  take def: Option[history.Def]
) -> Result[(), Unreleased] {
  let base = t.base
  let recorded = match body {
    Transaction(_) => true,
    _ => ordered_map.len(t.writes) > 0,
  }
  if !recorded {
    discard(mut s, take t)
    return gate(mut s, base)
  }
  let pinning = match t.pin {
    Some(_) => true,
    None() => false,
  }
  match commit(mut s, take t, take body, take def) {
    // A reader pin's reply is released only once its Retain is durable at
    // the strongest declared level, where `at_pin` reads it (STORE-8).
    Ok(_) if pinning => {
      let a = s.authority
      strongest(a, mut s)
    },
    Ok(made) => gate(mut s, made),
    Error(Limit(l)) => {
      gate(mut s, base)?
      Error(Limit(l))
    },
    Error(e) => Error(e),
  }
}

// Applies `t` to the head as the next commit, version V + 1, and adds it,
// with `body`, to the pending group; returns its version. Writes or an
// encoded commit over the limits change nothing and are `Limit(..)`. A
// group that would outgrow the authority's largest entry or `group_bytes`
// advances first; one that reaches a bound advances after.
fn commit(
  mut s: Store,
  take t: Run,
  take body: history.Body,
  take def: Option[history.Def]
) -> Result[u64, Unreleased] {
  if s.closed {
    discard(mut s, take t)
    return Error(Storage(Closed()))
  }
  if let Some(l) = over_limit(s.limits, t.writes) {
    discard(mut s, take t)
    return Error(Limit(l))
  }
  // A reader pin entry's Retain commit, which follows the call's in its group.
  let retention = match t.pin {
    Some(op) => match retained(s, op, t.base) {
      Ok(r) => Some(take r),
      Error(e) => {
        discard(mut s, take t)
        return Error(Storage(take e))
      },
    },
    None() => None(),
  }
  let pair: u64 = match retention {
    Some(_) => 1,
    None() => 0,
  }
  // The call's entry, by its index in the group's definitions.
  let mut fresh: Option[history.Def] = None()
  let mut index: u64 = list.len(s.defs)
  if let Some(d) = def {
    let mut found = false
    for i in 0u64..list.len(s.defs) {
      if !found && s.defs[i] == d {
        index = i
        found = true
      }
    }
    if !found {
      fresh = Some(copy d)
    }
  }
  let recorded = match take body {
    Transaction(made) => {
      let mut x = take made
      x.def = int.narrow(index)
      Transaction(take x)
    },
    other => take other,
  }
  let c = history.Commit(body: take recorded, writes: write_set(t.writes))
  let mut size = add(mut s, c)
  if size > s.limits.transaction_bytes {
    unadd(mut s, size)
    discard(mut s, take t)
    return Error(Limit(TransactionBytes()))
  }
  let mut retain_size: u64 = 0
  if let Some(r) = retention {
    retain_size = add(mut s, history.Commit(body: copy r.body, writes: []))
  }
  let def_bytes = match fresh {
    Some(d) => def_size(d),
    None() => 0,
  }
  if group_size(s) + def_bytes > s.max_entry || group_size(s) + def_bytes > s.config.group_bytes && pending_count(
    s
  ) > 1 + pair {
    // The group without this commit advances, and it starts the next.
    if pair > 0 {
      unadd(mut s, retain_size)
    }
    unadd(mut s, size)
    if let Error(e) = flush(mut s) {
      discard(mut s, take t)
      return Error(e)
    }
    // A new group holds no definitions: the call's entry is its first.
    if let Some(d) = def {
      fresh = Some(copy d)
    }
    size = add(mut s, c)
    if let Some(r) = retention {
      retain_size = add(mut s, history.Commit(body: copy r.body, writes: []))
      // A call and its Retain that no group could hold change nothing: the
      // table is never cut to fit.
      let needed = group_size(s) + match fresh {
        Some(d) => def_size(d),
        None() => 0,
      }
      if needed > s.max_entry {
        unadd(mut s, retain_size)
        unadd(mut s, size)
        discard(mut s, take t)
        return Error(Storage(Unsupported(Size(needed: needed, max_entry: s.max_entry))))
      }
    }
  }
  if let Some(d) = take fresh {
    s.defs_bytes += def_size(d)
    list.push(mut s.defs, take d)
  }
  let Run(state: state, access: access, ..) = take t
  s.index = take state
  reuse(mut s, take access)
  s.visible += 1
  let made = s.visible
  if let Some(r) = take retention {
    let Retention(pins: pins, readers: readers, kept: kept, fold: fold, ..) = take r
    take_retention(mut s, take pins, take readers, take kept)
    retention_written(mut s, fold)
    s.visible += 1
  }
  if pending_count(s) >= s.config.group_commits || group_size(s) >= s.config.group_bytes {
    flush(mut s)?
  }
  Ok(made)
}

// Advances the pending group at the floor. While a serve holds ends, the group
// is only submitted, unless WINDOW groups would then be unanswered.
fn flush(mut s: Store) -> Result[(), Unreleased] {
  let a = s.authority
  let here = authority.floor(a)
  let i = s.floor
  let after = list.len(s.submitted) + pending_groups(s)
  match s.deferred {
    Some(_) if after < WINDOW => submit(a, mut s, here, i),
    _ => advance(a, mut s, here, i),
  }
}

// 1 while a group is pending, else 0.
fn pending_groups(s: Store) -> u64 uses {} {
  match s.pending {
    Some(_) => 1,
    None() => 0,
  }
}

// Adds `c` to the pending group, opening one after the history's end when
// none is pending; returns the commit's encoded size.
fn add(mut s: Store, c: history.Commit) -> u64 uses {} {
  let mut w = match replace(mut s.pending, None()) {
    Some(w) => take w,
    None() => history.group_writer(),
  }
  let start = history.writer_bytes(w)
  history.add_commit(mut w, c)
  let size = history.writer_bytes(w) - start
  s.pending = Some(take w)
  size
}

// Removes the commit `add` added last, of `size` bytes.
fn unadd(mut s: Store, size: u64) -> () uses {} {
  let Some(w) = replace(mut s.pending, None()) else {
    return ()
  }
  let mut kept = take w
  history.drop_last(mut kept, history.writer_bytes(kept) - size)
  if history.writer_count(kept) > 0 {
    s.pending = Some(take kept)
  }
}

// The pending group's encoded size, its definition table included.
fn group_size(s: Store) -> u64 uses {} {
  match s.pending {
    Some(w) => history.writer_bytes(w) + 4 + s.defs_bytes,
    None() => 0,
  }
}

fn pending_count(s: Store) -> u64 uses {} {
  match s.pending {
    Some(w) => int.widen(history.writer_count(w)),
    None() => 0,
  }
}

// A definition's encoded size in a group's table.
fn def_size(d: history.Def) -> u64 uses {} {
  12 + bytes.len(d.path) + bytes.len(d.fingerprint) + bytes.len(d.code) + bytes.len(
    d.revision
  )
}

// Extends the history with the pending group, durable at `here`, the level at
// index `i`: every commit up to V is then durable at `here` and each weaker
// level. A refusal or a later claim leaves the group out of the history, and
// an undecided append leaves it unknown; each closes the store.
fn advance(a: Authority, mut s: Store, here: Level of a, i: u64) -> Result[
  (),
  Unreleased
] {
  if pending_groups(s) == 0 {
    return answer(a, mut s)
  }
  // One narrowing serves the submit and the wait.
  let mut c = narrow_claim(a, mut s)?
  submit_claimed(a, mut s, mut c, here, i)?
  answer_claimed(a, mut s, mut c)?
  let back: Claim = take c
  s.claim = Some(take back)
  Ok(())
}

// The store's claim, narrowed to `a` and taken from the store until it is put
// back; a store with no live claim closes.
fn narrow_claim(a: Authority, mut s: Store) -> Result[Claim of a, Unreleased] {
  let Some(held) = replace(mut s.claim, None()) else {
    return Error(Storage(stop(mut s, Closed())))
  }
  let Some(c) = claim.narrow(a, take held) else {
    return Error(Storage(stop(mut s, Closed())))
  }
  Ok(take c)
}

// Submits the pending group at `here`, the level at index `i`, as the history's
// next entry. The head moves past it and its state is held; nothing is
// durable until it is answered. A dead claim or a refused group closes the
// store with nothing appended.
fn submit(a: Authority, mut s: Store, here: Level of a, i: u64) -> Result[
  (),
  Unreleased
] {
  if pending_groups(s) == 0 {
    return Ok(())
  }
  let mut c = narrow_claim(a, mut s)?
  submit_claimed(a, mut s, mut c, here, i)?
  // The annotation forgets the brand: the store holds its claim unbranded.
  let back: Claim = take c
  s.claim = Some(take back)
  Ok(())
}

// `submit` under `c`, the store's claim narrowed and taken from it.
fn submit_claimed(
  a: Authority,
  mut s: Store,
  mut c: Claim of a,
  here: Level of a,
  i: u64
) -> Result[(), Unreleased] {
  let Some(w) = replace(mut s.pending, None()) else {
    return Ok(())
  }
  let defs = replace(mut s.defs, [])
  s.defs_bytes = 0
  // The group names the newest record holding retention commits before it.
  let (entry, d) = history.finish_group(take w, defs, s.retain_loc)
  let created = replace(mut s.created, [])
  let retired = replace(mut s.retired, [])
  let submitted = authority.submit(a, mut c, take entry, created, retired, here)
  let position = match take submitted {
    Ok(p) => p,
    Error(e) => return Error(Storage(stop(mut s, seam(take e)))),
  }
  if position != s.end + 1 {
    return Error(Unknown(stop(mut s, Corrupt(entry_name(position)))))
  }
  s.end = position
  s.digest = take d
  s.group_last = s.visible
  s.group_at = position
  // A group holding retention commits is located once: it is the newest
  // retention record, and the record of each holder it recorded.
  if s.retaining {
    let loc = match authority.locate(a, mut c, position) {
      Ok(l) => l,
      Error(e) => return Error(Unknown(stop(mut s, seam(take e)))),
    }
    let mut readers = replace(mut s.readers, ordered_map.empty(compare_keys))
    for (token, r) in reading_rows(readers) {
      if r.at == b"" {
        let mut placed = unique r
        placed.at = copy loc
        ordered_map.insert(mut readers, unique token, take placed)
      }
    }
    s.readers = take readers
    s.retain_loc = take loc
    s.retaining = false
  }
  let state = current(mut s)
  list.push(mut s.held, Held(position: position, version: s.visible, state: take state))
  list.push(
    mut s.submitted,
    Submitted(position: position, version: s.visible, level: i)
  )
  Ok(())
}

// Waits for every submitted group, oldest first: each answered one makes its
// commits durable at its level and each weaker one. The first other answer
// closes the store: a refused or fenced group is out of the history, an
// undecided one unknown.
fn answer(a: Authority, mut s: Store) -> Result[(), Unreleased] {
  if list.len(s.submitted) == 0 {
    forget(mut s)
    return Ok(())
  }
  // One narrowing serves every group's wait.
  let mut c = narrow_claim(a, mut s)?
  answer_claimed(a, mut s, mut c)?
  let back: Claim = take c
  s.claim = Some(take back)
  Ok(())
}

// `answer` under `c`, the store's claim narrowed and taken from it.
fn answer_claimed(a: Authority, mut s: Store, mut c: Claim of a) -> Result[
  (),
  Unreleased
] {
  let groups = replace(mut s.submitted, [])
  for g in groups {
    let outcome = authority.wait(a, mut c, g.position)
    match outcome {
      Advanced(p) => {
        if p != g.position {
          return Error(Unknown(stop(mut s, Corrupt(entry_name(p)))))
        }
        raise(mut s, g.version, g.level)
      },
      Fenced() => return Error(Storage(stop(mut s, Fenced()))),
      Refused(e) => return Error(Storage(stop(mut s, Refused(copy e)))),
      Undecided(e) => return Error(Unknown(stop(mut s, Storage(copy e)))),
    }
  }
  forget(mut s)
  Ok(())
}

// Waits until every commit is durable at `here`, the level at index `i`:
// advances the pending group there, or asks the authority how far the
// advanced history is durable at `here`. An authority that cannot tell leaves
// the commits' durability unknown and closes the store.
fn wait(a: Authority, mut s: Store, here: Level of a, i: u64) -> Result[(), Unreleased] {
  if s.closed {
    return Error(Storage(Closed()))
  }
  if let Some(_) = s.pending {
    return advance(a, mut s, here, i)
  }
  if list.len(s.submitted) > 0 {
    answer(a, mut s)?
    if s.durable[i] >= s.visible {
      return Ok(())
    }
  }
  let Some(held) = replace(mut s.claim, None()) else {
    return Error(Storage(stop(mut s, Closed())))
  }
  let Some(narrowed) = claim.narrow(a, take held) else {
    return Error(Storage(stop(mut s, Closed())))
  }
  let mut c = take narrowed
  let outcome = authority.durable(a, mut c, here)
  // The annotation forgets the brand: the store holds its claim unbranded.
  let back: Claim = take c
  s.claim = Some(take back)
  let position = match take outcome {
    Ok(p) => p,
    Error(e) => return Error(Unknown(stop(mut s, seam(take e)))),
  }
  let mut upto: u64 = 0
  for h in s.held {
    if h.position <= position {
      upto = h.version
    }
  }
  raise(mut s, upto, i)
  forget(mut s)
  Ok(())
}

// Raises D(L) to `upto` for the level at index `i` and each weaker one.
fn raise(mut s: Store, upto: u64, i: u64) -> () uses {} {
  for j in 0u64..i + 1 {
    if s.durable[j] < upto {
      s.durable[j] = upto
    }
  }
}

// Forgets the held states no D(L) and not V needs. Run once every submitted
// group is answered, so no group's state is dropped before its level reaches it.
fn forget(mut s: Store) -> () uses {} {
  let held = replace(mut s.held, [])
  let mut kept: List[Held] = []
  let n = list.len(held)
  for k in 0u64..n {
    let mut needed = k + 1 == n
    for d in s.durable {
      if d == held[k].version {
        needed = true
      }
    }
    if needed {
      list.push(mut kept, copy held[k])
    }
  }
  s.held = take kept
}

// Makes every commit durable at the strongest level the authority declares.
fn strongest(a: Authority, mut s: Store) -> Result[(), Unreleased] {
  let mut top = authority.floor(a)
  for l in authority.levels(a) {
    top = l
  }
  let i = list.len(s.levels) - 1
  if s.durable[i] >= s.visible && pending_count(s) == 0 {
    return Ok(())
  }
  wait(a, mut s, top, i)
}

// A store error for a lifecycle call: an unreleased outcome's cause.
fn unreleased(take u: Unreleased) -> StoreError uses {} {
  match u {
    Storage(e) => copy e,
    Unknown(e) => copy e,
    Limit(_) => InvalidInput(),
  }
}

// Why an outcome could not be released: nothing was committed, or a commit's
// durability is undecided.
type Unreleased = Storage(StoreError) | Unknown(StoreError) | Limit(TxLimit)

fn released[E](take u: Unreleased) -> TxFailure[E] uses {} {
  match u {
    Storage(e) => Storage(copy e),
    Unknown(e) => Unknown(copy e),
    Limit(l) => Limit(l),
  }
}

fn released_call[E](take u: Unreleased) -> CallFailure[E] uses {} {
  Tx(released(take u))
}

// A commit's write set, in key order.
fn write_set(writes: ordered_map.OrderedMap[Bytes, Option[Bytes]]) -> List[
  history.Write
] uses {} {
  let first: List[history.Write] = []
  ordered_map.fold_range(
    writes,
    Unbounded(),
    Unbounded(),
    Ascending(),
    take first,
    fn(take acc: List[history.Write], k: Bytes, v: Option[Bytes]) -> (
      List[history.Write],
      bool
    ) {
      let mut out = take acc
      match v {
        Some(value) => list.push(mut out, Put(key: unique k, value: unique value)),
        None() => list.push(mut out, Delete(key: unique k)),
      }
      (take out, true)
    }
  )
}

// Effective entries of `m` in a range, copied out.
fn entries_in(
  m: ordered_map.OrderedMap[Bytes, Bytes],
  from: ordered_map.Bound[Bytes],
  to: ordered_map.Bound[Bytes],
  direction: ordered_map.Direction,
  limit: u64
) -> List[(Bytes, Bytes)] uses {} {
  let start: List[(Bytes, Bytes)] = []
  if limit == 0 {
    return start
  }
  ordered_map.fold_range(
    m,
    from,
    to,
    direction,
    take start,
    fn(take acc: List[(Bytes, Bytes)], k: Bytes, v: Bytes) -> (
      List[(Bytes, Bytes)],
      bool
    ) {
      let mut out = take acc
      list.push(mut out, (unique k, unique v))
      let more = list.len(out) < limit
      (take out, more)
    }
  )
}

// Closes the store on an error that ends it, ending its claim.
fn stop(mut s: Store, take e: StoreError) -> StoreError uses {} {
  s.closed = true
  s.claim = None()
  s.pending = None()
  s.submitted = []
  e
}

fn apply(mut index: ordered_map.OrderedMap[Bytes, Bytes], set: List[history.Write]) -> () uses {} {
  for w in set {
    match w {
      Put(key: k, value: v) => ordered_map.insert(mut index, unique k, unique v),
      Delete(key: k) => {
        let _ = ordered_map.remove(mut index, k)
      },
    }
  }
}

// Typed operations preflight the complete prospective write set before mutating
// the live Tx, so a limit refusal changes nothing and the body can continue.
fn check_put(tx: Tx, key: Bytes, value: Bytes) -> Option[TxLimit] uses {} {
  let mut trial = copy tx.txn
  run_put(mut trial, unique key, unique value)
  over_limit(tx.limits, trial.writes)
}

fn check_delete(tx: Tx, key: Bytes) -> Option[TxLimit] uses {} {
  let mut trial = copy tx.txn
  run_delete(mut trial, unique key)
  over_limit(tx.limits, trial.writes)
}

// Preflights deleting every key in `doomed` together, as `check_delete` does one.
fn check_delete_all(tx: Tx, doomed: List[Bytes]) -> Option[TxLimit] uses {} {
  let mut trial = copy tx.txn
  for key in doomed {
    run_delete(mut trial, unique key)
  }
  over_limit(tx.limits, trial.writes)
}

// Folds `step` over every entry in [lo, hi), reserved keys included, as
// `tx_range` does, after checking read (or, with `write`, write) access to all
// of it: for a library operation over a whole namespace of its own, such as
// dropping a table. `range_rows` does not bound it; the commit's limits do.
fn table_all[A](
  tx: Tx,
  scope: KeyScope,
  take lo: Bytes,
  take hi: Option[Bytes],
  write: bool,
  take initial: A,
  step: fn(take A, Bytes, Bytes) -> (A, bool)
) -> Result[A, TxError] {
  if !scope.whole {
    check(spans_hold(scope.spans, lo, hi, write), write)?
  }
  let (folded, _) = scan(
    tx,
    Some((take lo, take hi)),
    true,
    18446744073709551615,
    take initial,
    step
  )
  Ok(take folded)
}

// Deletes the keys starting with `prefix` in key order within the
// transaction's limits, after checking write access to all of them; true when
// none remain. The transaction must write nothing else.
fn table_delete_within(mut tx: Tx, prefix: Bytes) -> Result[bool, TxError] {
  let (low, high) = prefix_bounds(prefix)
  if !tx.scope.whole {
    let hi: Option[Bytes] = match high {
      Excluded(h) => Some(unique h),
      _ => None(),
    }
    check(spans_hold(tx.scope.spans, prefix, hi, true), true)?
  }
  Ok(delete_within(mut tx.txn, tx.limits, low, high))
}

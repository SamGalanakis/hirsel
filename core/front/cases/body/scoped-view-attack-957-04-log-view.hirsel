fn run(mut l: Log[u64]) -> Result[Result[u64, Causes], Capacity] {
    isolate(fn() -> u64 { let _ = log.append(l, 7u64); fail("x") })
}
pub fn main() -> Result[(), ()] { let l: Log[u64] = log.new(); let _ = run(mut l); Ok(()) }


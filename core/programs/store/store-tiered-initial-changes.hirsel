fn tiered_initial_changes(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], data: pages.PageTree, low: Bytes, high: Bytes, limits: Limits) -> Result[ChangePage, Error] {
    let mut out = change_output(Some(limits))
    let beginning = list.slice(low, 0, order.min(4, list.len(low)))
    let mut collections = std.page.cursor_open(data.root, Some(failure_result_from_rep(types.copied(beginning))?), true, false)
    let no_prefix: Bytes = list.new()
    while let Some((take id, _)) = std.page.cursor_next_key(mut collections, no_prefix) {
        if id >= high {
            break
        }
        let (edge, descriptor) = option.unwrap(std.page.collection_slot(data.root, id))
        if pages.collection_descriptor(descriptor).kind == LogCollection && low <= id {
            if !admit_change(mut out, id, 4)? {
                break
            }
            list.push(mut out.bounds, failure_result_from_rep(types.copied(id))?)
        }
        let collection: u32 = list.word_be(id, 0)
        let collection_end = failure_result_from_rep(catalog.prefix(collection + 1))?
        let from = if low <= id {
            view id
        } else {
            view low
        }
        let until = if list.len(high) > 4 && high < collection_end {
            view high
        } else {
            view collection_end
        }
        let mut start = failure_result_from_rep(types.copied(from))?
        while let Some((take key, take value)) = tiered_span_collection(attempt, visible, data, edge, descriptor, collection, start, until)? {
            if !admit_change(mut out, key, list.len(key) + list.len(value))? {
                break
            }
            start = scan_page_after(key)?
            list.push(mut out.rows, Change(tree_key: take key, value: Some(take value)))
        }
        if let Some(_) = out.next {
            break
        }
    }
    let ChangeOutput(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds, next: take resume, ..) = take out
    Ok(ChangePage(changes: take rows, trimmed: take trimmed, bounds: take changed_bounds, next: take resume))
}

fn snapshot_tiered_initial_changes(r: Reader, s: Snapshot, inventory: pages.TieredReadInventory, low: Bytes, high: Bytes, limits: Limits) -> Result[ChangePage, Error] waits {
    let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
    let empty_hint: Bytes = list.new()
    retry_tiered_read(source, grant, root, empty_hint, None, TieredForward, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]]) -> Result[ChangePage, Error] {
        tiered_initial_changes(attempt, visible, s.roots.collections, low, high, limits)
    })
}

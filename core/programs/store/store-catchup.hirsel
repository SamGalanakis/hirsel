// Replays the tail copied into `d`, brings `staged` to the new head, and writes
// ROUND: the entries the shipped ranges changed, for OLD's kept import
// (`apply_round`). Returns the number of rows the tail changed. Drift means this round cannot
// catch up and the deploy needs a fresh full preparation: OLD moved an index
// record the preparation changed but does not ship, the preparation carries
// activation rewrites computed at its base, or it ships a populated table
// (a `migrate_table` copy, whose converter would have to run on every
// caught-up row).
pub fn catch_up_export(d: Dir, mut source: Preparation, mut staged: StagedMigration) -> Result[u64, DeployError] waits {
    let stamp = read_export_stamp(d)?
    let base: ExportStamp = clone(source.stamp)
    if stamp.attempt != base.attempt || stamp.store_hi != base.store_hi || stamp.store_lo != base.store_lo || stamp.opened != base.opened || stamp.activation != base.activation {
        return Error(ExportMismatch)
    }
    if stamp.terminal < base.terminal || (stamp.terminal == base.terminal && stamp.end < base.end) || stamp.head < base.head {
        return Error(ExportMismatch)
    }
    if stamp.next_table != base.next_table || map.len(staged.rewrites) != 0 || list.len(staged.queued_rewrites) != 0 {
        return Error(Drift)
    }
    // Rounds follow the PREPARED file OLD keeps.
    let Some(take kept) = replace(mut source.shipped, None) else {
        return Error(ExportMismatch)
    }
    let transfer.ShippedImport(ranges: take round_ranges, round: last_round, staged_roots: take carried) = take kept
    if let Some((take built_roots, built_next_node)) = take carried {
        staged.plan.schema.roots = take built_roots
        staged.plan.schema.next_node = order.max(staged.plan.schema.next_node, built_next_node)
        staged.plan.pending_indexes = list.new()
    }
    let id = StoreId(hi: stamp.store_hi, lo: stamp.store_lo)
    let before = pages.share_roots(pages.holder_heads(source.db.holders)[0].roots)
    let state = deploy_result(failure_result_from_rep(types.capacity(current_state(source.db))))?
    let mut initial = deploy_result(failure_result_from_rep(pager.journal_replay(take state, pages.holder_next_node(source.db.holders), limits_to_rep(source.db.limits))))?
    initial.tiered.total = source.db.accounting.tiered
    let steps = transfer_result(transfer.read_steps(d, store_key_to_rep(id), stamp.head, stamp.terminal, stamp.end))?
    let replayed = deploy_result(replay_export(d, id, base.terminal, base.end, stamp.terminal, stamp.end, steps, take initial))?
    if replayed.state.tips[0].head != stamp.head {
        return Error(ExportMismatch)
    }
    let moved = deploy_result(failure_result_from_rep(transfer.catalog_changes(before, replayed.state.tips[0].roots)))?
    transfer_result(transfer.follow_moves(mut staged.plan.schema, moved, round_ranges))?
    let shipped = transfer_result(transfer.catch_up_indexes(staged.plan.schema, staged.plan.bindings, round_ranges))?
    let (take tail, take deferred) = deploy_result(catch_up_compare_collections(before.collections, replayed.state.tips[0].roots.collections, replayed.superseded))?
    let mut row_changes: List[transfer.CatchUpChange] = list.with_capacity(list.len(tail.rows))
    for row in tail.rows {
        let after_val: Option[Arc[Bytes]] = match view row.value {
            Some(v) => Some(arc.share(v)),
            None => None,
        }
        list.push(mut row_changes, transfer.CatchUpChange(tree_key: deploy_result(failure_result_from_rep(types.copied(row.tree_key)))?, before: None, after: take after_val))
    }
    if list.len(deferred) != 0 {
        let before_snap = Snapshot(store: id, open: stamp.opened, branch: 0u32, head: base.head, roots: pages.share_roots(before), watermark: pages.holder_next_node(source.db.holders) + 1, bases: pages.no_tail_bases())
        let after_snap = Snapshot(store: id, open: stamp.opened, branch: 0u32, head: stamp.head, roots: pages.share_roots(replayed.state.tips[0].roots), watermark: replayed.next_node + 1, bases: pages.no_tail_bases())
        let tiered_rows = catch_up_tiered_diffs(source.dir, id, pager.pin_partition(source.db.pager), before_snap, after_snap, deferred)?
        for take item in take tiered_rows {
            list.push(mut row_changes, take item)
        }
    }
    let next_node = order.max(staged.plan.schema.next_node, replayed.next_node)
    staged.plan.schema.next_node = next_node
    let mut touched: List[transfer.Touch] = list.new()
    let mut cut_ctx = child_cut_context(source)
    deploy_result(failure_result_from_rep(transfer.patch_index_ranges(mut cut_ctx, stamp.opened, mut staged.plan.schema, staged.plan.bindings, before.collections, shipped, row_changes, mut touched)))?
    save_child_cut_pack(source, cut_ctx.next_pack)
    let ops = deploy_result(failure_result_from_rep(transfer.round_ops_direct(source.dir, store_key_to_rep(id), pager.pin_partition(source.db.pager), stamp.opened, staged.plan.schema.roots.collections, mut touched)))?
    let round_totals = deploy_result(failure_result_from_rep(transfer.range_totals(staged.plan.schema.roots.collections, round_ranges)))?
    let round = last_round + 1
    transfer_result(transfer.write_round(d, store_key_to_rep(id), transfer.RoundMeta(round: round, from: export_stamp_to_rep(clone(source.stamp)), to: export_stamp_to_rep(clone(stamp)), ops: list.len(ops), totals: take round_totals), ops))?
    let live_bytes = deploy_result(failure_result_from_rep(journal.journal_account(replayed)))?
    let pager.JournalReplay(state: take advanced, tiered: tiered_account, deferred_frees: take freed_rows, ..) = take replayed
    deploy_result(open_heads(mut source.db, take advanced))?
    source.db.accounting.resident = live_bytes
    source.db.accounting.tiered = tiered_account.total
    for take freed in take freed_rows {
        list.push(mut source.deferred_frees, take freed)
    }
    pages.set_next_node(mut source.db.holders, staged.plan.schema.next_node)
    source.stamp = take stamp
    source.shipped = Some(transfer.ShippedImport(ranges: take round_ranges, round: round, staged_roots: None))
    staged.inner = catalog.declaration_state(declaration_base(source.db))
    staged.base_rows = pages.share_page_tree(pages.holder_heads(source.db.holders)[0].roots.collections)
    Ok(list.len(row_changes))
}

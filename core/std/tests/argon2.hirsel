// AR2. phc-winner-argon2 src/test.c, f57e61e19229e23c4445b85494dbf7c07de721cb.
fn phc_case(password: Bytes, m: u32, t: u32, p: u32, expected: String) -> bool {
    let cost = Argon2Cost(memory_kib: m, passes: t, lanes: p)
    let Ok(encoded) = argon2.hash(password, b"somesalt", cost) else {
        return false
    }
    let phc = string.as_bytes(expected)
    let n = list.len(phc)
    let mut changed: Bytes = list.with_capacity(n)
    list.append(mut changed, phc)
    // Both replacement characters have zero pad bits for a 32-byte tag.
    changed[n - 1] = if changed[n - 1] == b'A' {
        b'E'
    } else {
        b'A'
    }
    match (argon2.verify(password, phc), argon2.verify(password, changed)) {
        (Ok(true), Ok(false)) => encoded == expected,
        _ => false,
    }
}

// test-native-only: AR2 runs the larger libargon2 costs on native engines.
// test-limit: 68157440
// expect: run ar2_libargon2_1() = true
fn ar2_libargon2_1() -> bool {
    phc_case(b"password", 65536, 2, 1, "$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")
}


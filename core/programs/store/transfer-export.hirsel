pub type ExportStampRep: codec + send {
    attempt: Bytes,
    store_hi: u64,
    store_lo: u64,
    opened: u64,
    branch: u32,
    head: u64,
    next_table: u32,
    activation: u64,
    binding: Bytes,
    terminal: u64,
    end: u64
}

pub type ExportSource: send = ExportLog(Dir, Bytes) | ExportObject(ObjectExportCopy)

// A deploy export makes a fresh subdirectory of its scratch. A backup (§15)
// writes into the empty target its caller named.
pub type ExportInto: send = Scratch(Dir) | Target(Dir)

pub type ObjectExportCopy: send {
    journal: Sender[object_writer.JournalMsg],
    health: Latest[status.Health],
    manifest: pages.HistoryRef,
    packs: List[pages.HistoryRef],
    entries: List[pages.HistoryRef],
}

pub fn copy_export_file(from: Dir, to: Dir, name: String, end: Option[u64]) -> Result[(), types.Failure] waits {
    let mut input = manifest.disk_io(host.open(from, name, Read))?
    capture.copy_export_prefix(mut input, to, name, end, 16384)?;
    manifest.disk_io(host.close(take input))
}

fn object_export_fetch(plan: ObjectExportCopy, lead: String, reference: pages.HistoryRef) -> Result[Bytes, types.Failure] waits {
    let (take key, take buffer) = manifest.disk_allocation(scoped fn() -> Result[(String, Bytes), types.Failure] {
        Ok((history.history_key(lead, reference), list.with_capacity(reference.len)))
    })?
    let (outlet, incoming): (Sender[Result[Bytes, types.Failure]], Receiver[Result[Bytes, types.Failure]]) = channel.new(1)
    let request = journal.ObjectExportFetch(key: take key, reference, buffer: take buffer, reply: take outlet)
    if let Ok(()) = channel.send(plan.journal, ObjectExportRead(take request)) {
        if let Ok(take observed) = channel.receive(incoming) {
            return take observed
        }
    }
    object_writer.health_result(latest.read(plan.health))?
    Error(Io(Closed))
}

pub fn require_empty(d: Dir, take what: String) -> Result[(), DeployFailure] waits {
    let mut listing = scratch_result(manifest.disk_io(std.dir.entries(d, None)))?
    let mut first_entry: Bytes = list.with_capacity(258)
    if scratch_result(manifest.disk_io(std.dir.next_entries(mut listing, mut first_entry)))? != 0 {
        return Error(Scratch(Exists(take what)))
    }
    Ok(())
}

pub fn copy_restore_file(from: Dir, to: Dir, name: String) -> Result[(), DeployFailure] waits {
    scratch_result(copy_export_file(from, to, name, None))
}

fn export_write(mut file: HostFile, raw: Bytes) -> Result[(), DeployFailure] waits {
    match host.write(mut file, raw) {
        Ok(()) => Ok(()),
        Error(problem) => Error(Scratch(Io(problem.error))),
    }
}

// The journal bytes from `end` of segment `terminal` through `final_end` of
// segment `final_seq`. A rotated segment ends where its successor's header says.
pub fn tail_bytes(from: Dir, id: types.StoreKey, terminal: u64, end: u64, final_seq: u64, final_end: u64) -> Result[u64, types.Failure] waits {
    let mut total = 0u64
    let mut seq = terminal
    let mut start = end
    loop {
        let boundary = segment_boundary(from, id, seq, final_seq, final_end)?
        if boundary < start {
            return Error(format.disk_fault(manifest.journal_path(seq, "")?, start, Truncated))
        }
        total += boundary - start
        if seq == final_seq {
            return Ok(total)
        }
        seq += 1
        start = 72
    }
}

fn segment_boundary(from: Dir, id: types.StoreKey, seq: u64, final_seq: u64, final_end: u64) -> Result[u64, types.Failure] waits {
    if seq == final_seq {
        return Ok(final_end)
    }
    match manifest.journal_header(from, id, seq + 1, None)? {
        Some(following) => Ok(following.prev_end),
        None => Error(format.disk_fault(manifest.journal_path(seq + 1, "")?, 0, Header)),
    }
}

// Appends bytes [low, high) of `name` in `from` to the copy of `name` in `to`,
// which holds exactly `low` bytes.
fn append_export_range(from: Dir, to: Dir, name: String, low: u64, high: u64) -> Result[(), types.Failure] waits {
    if low == high {
        return Ok(())
    }
    let mut input = manifest.disk_io(host.open(from, name, Read))?
    let mut output = manifest.disk_io(host.open(to, name, Append))?
    let mut chunk: Bytes = list.with_capacity(65536)
    let mut at = low
    while at < high {
        list.clear(mut chunk)
        let read_size = manifest.disk_io(host.read_at(mut input, at, mut chunk))?
        if read_size == 0 {
            return Error(format.disk_fault(name, at, Truncated))
        }
        let written = order.min(read_size, high - at)
        match host.write(mut output, list.slice(chunk, 0u64, written)) {
            Ok(()) => (),
            Error(e) => return Error(Io(e.error)),
        }
        at += written
    }
    manifest.disk_io(host.close(take input))?
    manifest.disk_io(host.sync(mut output))?
    manifest.disk_io(host.close(take output))
}

pub fn copy_log_export(from: Dir, raw: Bytes, to: Dir, lease: Arc[manifest.ExportLease], id: types.StoreKey, terminal: u64, end: u64) -> Result[(), DeployFailure] waits {
    for pack in lease.packs {
        let path = scratch_result(types.capacity(manifest.disk_path("p-", pack, "")))?
        scratch_result(copy_export_file(from, to, path, None))?
    }
    scratch_result(manifest.disk_write_synced(to, "MANIFEST", raw))?
    for seq in lease.first .. terminal {
        let path = scratch_result(types.capacity(manifest.disk_path("j-", seq, "")))?
        let following = match manifest.journal_header(from, id, seq + 1, None) {
            Ok(header) => header,
            Error(Corrupt(_)) => None,
            Error(take problem) => return Error(Scratch(take problem)),
        }
        let Some(successor) = following else {
            let next_path = scratch_result(manifest.journal_path(seq + 1, ""))?
            return Error(Scratch(format.disk_fault(next_path, 0, Header)))
        }
        scratch_result(copy_export_file(from, to, path, Some(successor.prev_end)))?
    }
    let terminal_path = scratch_result(types.capacity(manifest.disk_path("j-", terminal, "")))?
    scratch_result(copy_export_file(from, to, terminal_path, Some(end)))?
    Ok(())
}

fn object_export_file(plan: ObjectExportCopy, to: Dir, id: types.StoreKey, lead: String, reference: pages.HistoryRef, role: u8, local: String) -> Result[(), DeployFailure] waits {
    let mut raw = deploy_result(object_export_fetch(plan, lead, reference))?
    let key = history.history_key(lead, reference)
    let ctx = deploy_result(history.history_object_context(key, id, role, reference, raw))?
    deploy_result(history.history_object_digest(key, reference, raw))?
    let header = deploy_result(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?
    for i in 0u64 .. 72 {
        raw[i] = header[i]
    }
    scratch_result(manifest.disk_write_synced(to, local, raw))
}

pub fn object_export_copy(plan: ObjectExportCopy, to: Dir, id: types.StoreKey, terminal: u64, end: u64) -> Result[(), DeployFailure] waits {
    for item in plan.packs {
        let local = scratch_result(manifest.paged_pack_path(item.seq))?
        object_export_file(plan, to, id, "p-", item, 3, local)?
    }
    object_export_file(plan, to, id, "m-", plan.manifest, 1, "MANIFEST")?
    let local = scratch_result(types.capacity(manifest.disk_path("j-", terminal, "")))?
    let ctx = format.DiskContext(store: id, role: 2, seq: terminal)
    let mut output = scratch_result(manifest.disk_io(host.open(to, local, Write)))?
    export_write(mut output, deploy_result(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?)?
    let mut offset = 72u64
    for item in plan.entries {
        let key = history.history_key("e-", item)
        let mut raw = deploy_result(object_export_fetch(plan, "e-", item))?
        let (remote, _) = deploy_result(history.history_entry_context(key, id, item, raw))?
        deploy_result(history.history_object_digest(key, item, raw))?
        let first = deploy_result(manifest.disk_frame_bytes(key, remote, raw, 112))?
        if first.kind == 0x0040 {
            deploy_result(history.history_check_claim(key, item, raw, first))?
            continue
        }
        let mut at = 112u64
        while at < item.len {
            let frame = deploy_result(manifest.disk_frame_bytes(key, remote, raw, at))?
            if frame.kind == 0x0090 || frame.kind == 0x00C0 {
                return Error(Store(format.disk_fault(key, at, Malformed)))
            }
            deploy_result(manifest.disk_check_frame_kind(key, remote, frame.kind, frame.flags, at))?
            let check = deploy_result(types.capacity(format.disk_check(ctx, offset, list.slice(raw, at, frame.payload), list.slice(raw, frame.payload, frame.end))))?
            list.set_word_le(mut raw, at + 8, check)
            offset += frame.end - at
            at = frame.end
        }
        export_write(mut output, list.slice(raw, 112, item.len))?
    }
    if offset != end {
        return Error(ExportMismatch)
    }
    scratch_result(manifest.disk_io(host.sync(mut output)))?
    scratch_result(manifest.disk_io(host.close(take output)))
}

pub fn copy_tail(from: Dir, to: Dir, id: types.StoreKey, terminal: u64, end: u64, last_seq: u64, last_end: u64) -> Result[u64, DeployFailure] waits {
    let mut total = 0u64
    let mut seq = terminal
    loop {
        let path = scratch_result(types.capacity(manifest.disk_path("j-", seq, "")))?
        let boundary = scratch_result(segment_boundary(from, id, seq, last_seq, last_end))?
        if seq == terminal {
            scratch_result(append_export_range(from, to, path, end, boundary))?
            total += boundary - end
        } else {
            scratch_result(copy_export_file(from, to, path, Some(boundary)))?
            total += boundary
        }
        if seq == last_seq {
            break
        }
        seq += 1
    }
    Ok(total)
}

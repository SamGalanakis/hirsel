// L31 (a) on disk: law_migrate's trace to v4, made durable, then reopen.
// The catalog lists t as id 3 with only by_b (id 4), by_b gives k3, k1, k2,
// and the old ids hold nothing. Wrong implementation caught: a cut that
// writes the migrated catalog but not the new rows' tree, or the reverse.
pub fn disk_law_migrate(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = defaults()
    options.checkpoint_task_bytes = 1048576
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    let mut declared = spec("t", std.codec.key_u64(), old_codec())
    result.unwrap(with_index(mut declared, "by_a", code.describe(old_balance), std.codec.key_u64()))
    result.unwrap(create_table(mut db, take declared))
    let mut t = result.unwrap(table(mut db, "t", std.codec.key_u64(), old_codec()))
    let _ = result.unwrap(index(db, mut t, "by_a", code.describe(old_balance), std.codec.key_u64()))
    let first = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, OldAccount(balance: 7))?
        put(mut tx, t, 2, OldAccount(balance: 9))
    }))
    match take first { Committed(_) => {}, _ => return false }
    result.unwrap(migrate(mut db, take t, new_spec("t", "by_b"), upgrade))
    let mut nt = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    let _ = result.unwrap(index(db, mut nt, "by_b", code.describe(new_bonus), std.codec.key_u64()))
    let late = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] { put(mut tx, nt, 3, NewAccount(balance: 5, bonus: 50)) }))
    match take late { Committed(done) => result.unwrap(durable(mut db, done.ticket)), _ => return false }
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    let mut back = result.unwrap(table(mut reopened, "t", std.codec.key_u64(), new_codec()))
    let ix = result.unwrap(index(reopened, mut back, "by_b", code.describe(new_bonus), std.codec.key_u64()))
    let listed = result.unwrap(index_catalog(reopened, 3))
    let now = snapshot(reopened)
    let mut leftovers = result.unwrap(scan_bytes(now, 1, Unbounded, Unbounded))
    let mut old_index = result.unwrap(scan_bytes(now, 2, Unbounded, Unbounded))
    let empty_old = match result.unwrap(next_bytes(mut leftovers)) { None => true, Some(_) => false }
    let empty_index = match result.unwrap(next_bytes(mut old_index)) { None => true, Some(_) => false }
    let good = back.id == 3 && ix.id == 4 && list.len(listed) == 1 && version(now) == 4 && empty_old && empty_index && result.unwrap(bonus_order(now, ix)) == 305010702090
    result.unwrap(close(take reopened))
    good
}


// Native oracle (recording_build_native.rs, tape_run_*): prints "taped", then
// the Clock's monotonic reading, "|", and the program's Args. With first arg
// "x" exits with status 1 instead of 0.
pub fn main(c: Clock, out: Stdout, a: Args) -> Result[(), Exit] {
    let m = host.mono_ns(c)
    result.unwrap(stdout.write(out, "taped"))
    let mut s = string.new()
    string.push_u64(mut s, m)
    result.unwrap(stdout.write(out, s))
    result.unwrap(stdout.write(out, "|"))
    let mut i = 0u64
    while i < args.len(a) {
        let v = option.unwrap(args.get(a, i))
        result.unwrap(stdout.write(out, v))
        i = i + 1u64
    }
    match args.get(a, 0) {
        Some(v) => if v == "x" { Error(Exit(status: 1)) } else { Ok(()) },
        None => Ok(()),
    }
}

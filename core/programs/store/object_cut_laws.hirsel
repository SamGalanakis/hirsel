fn bucket_activation_noop(mut _phase: Migration) -> Result[(), Error] {
    Ok(())
}

fn object_binding_law(c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), Error] waits {
    let client = bucket_law_client_lanes(sim, tasks, "s3.test", 1, true, 1)?
    let mut options = result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64))
    options.group_bytes = 65536
    options.head_poll_ms = 10000
    let mut writer = open_authority(tasks, object_authority(take client, "bucket", BUCKET_LAW_OP_MS), c, r, options) ?=> |Refusal(error: take problem, ..)| take problem
    let _ = law_table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    for k in 0u64 .. 9 {
        let committed = run(mut writer, None, (copy_env(rows), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, call_env.1, call_env.1)
        })?
        if let Committed(_) = committed {} else { fail("the fixture write was refused") }
    }
    let description = string.into_bytes(string.from("release 12"))
    let mut schema_binding: Bytes = list.with_capacity(32)
    list.fill(mut schema_binding, 32, 91u8)
    let mut stale = stage_migration(writer, tasks, code.describe(bucket_activation_noop))?
    stage_activation(mut stale, 12, None, description, std.codec.of_u64(), 73u64)?
    let committed = run(mut writer, None, copy_env(rows), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 9, 9)
    })?
    let Committed(take done) = take committed else { fail("the intervening write was refused") }
    let Journal(_, 0, acknowledged) = done.ticket.mark else { fail("the write has no main journal acknowledgment") }
    if acknowledged != 11 { fail("the fixture has the wrong install base") }
    durable(mut writer, done.ticket)?
    let fence = writer.fence
    let refused = install_bound_activation(mut writer, take stale, 12, schema_binding)
    let after = snapshot(writer)
    if get(result.unwrap(reader(writer, 0u64)), after, rows, 9)? != Some(9u64) {
        fail("the stale activation lost the acknowledged write")
    }
    if let Error(Foreign) = refused {} else { fail("the stale activation was admitted") }
    if version(after) != acknowledged || writer.fence != fence {
        fail("the refused activation changed the writer")
    }
    let unpublished = system_table(writer, "hirsel.runner.releases", std.codec.key_u64(), std.codec.of_u64())
    if let Error(Missing(_)) = unpublished {} else { fail("the refused activation published its release table") }
    let mut staged = stage_migration(writer, tasks, code.describe(bucket_activation_noop))?
    stage_activation(mut staged, 12, None, description, std.codec.of_u64(), 73u64)?
    install_bound_activation(mut writer, take staged, 12, schema_binding)?
    let d = bucket_law_client_lanes(sim, tasks, "s3.test", 2, true, 1)?
    let mut process = followers()
    options.expect = Some(identity(writer))
    let plan = follower_law_plan(Bucket(bucket_law_lanes(1)), options)
    let service = follower_law_service(tasks, plan, 1)?
    let installed = follower(mut process, follower_slot(follower_owner(service)?, plan)?, object_authority(take d, "bucket", BUCKET_LAW_OP_MS), sim.time, options.expect)?
    let observed = follower_head(installed)?
    let captured = snapshot_follower(installed, Branch(store: observed.store, id: 0))?
    let mut schema = declare_follower(installed)
    let releases = declare_release_table(mut schema, std.codec.of_u64())?
    if observed.activation != 12 || observed.binding != schema_binding || version(captured) != 12 || get(result.unwrap(follower_reader(installed, 0u64)), captured, releases, 12)? != Some(73u64) {
        fail("activation, binding and the release row were not published by one checkpoint")
    }
    let bad_client = bucket_law_client_lanes(sim, tasks, "s3.test", 3, true, 1)?
    options.activation = Some(12)
    options.binding = Some(list.new())
    let wrong = open_authority(tasks, object_authority(take bad_client, "bucket", BUCKET_LAW_OP_MS), c, r, options)
    if let Error(Refusal(error: NotCurrent(12), ..)) = wrong {} else { fail("a wrong binding was admitted") }
    let deadline = clock.deadline_after_ms(host.mono_ns(sim.time), BUCKET_LAW_OP_MS)
    let clean = fresh_snapshot(mut writer, deadline)?
    if version(clean) != 12 || claim_of(writer)?.epoch != 1 { fail("a refused binding fenced the incumbent") }
    close(take writer)
}

@test
fn bucket_test_m2_binding(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let sim = bucket_law_sim(tasks, c, 77, None, list.new())
    let outcome = object_binding_law(c, r, tasks, sim)
    let _ = bucket_law_finish(take sim)
    outcome
}
fn object_conflict_sim(tasks: Tasks, c: Clock, seed: u64, tape: Inline[std.sim.s3.Fault, 18]) -> BucketSim {
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(18)
    let mut words: List[u64] = list.with_capacity(36)
    // world.pick maps word w to the high word of w * 18, so i * stride picks i.
    let stride = 18446744073709551615u64 / 18 + 1
    for i in 0u64 .. 18 {
        list.push(mut faults, tape[i])
        list.push(mut words, i * stride)
        list.push(mut words, seed)
    }
    let mut streams: List[List[u64]] = list.with_capacity(1)
    list.push(mut streams, take words)
    let plan = std.sim.world.plan_from(std.sim.world.Script(tail_seed: seed, streams: take streams), 0)
    bucket_law_sim_plan(tasks, c, seed, None, take faults, take plan)
}

fn object_conflict_race(tasks: Tasks, sim: BucketSim) -> Result[Bytes, Error] waits {
    let mut first = bucket_law_client_lanes(sim, tasks, "s3.test", 1, true, 1)?
    let mut second = bucket_law_client_lanes(sim, tasks, "s3.test", 2, true, 1)?
    let metadata = history_config_bytes(object_history_config(std.object.bucket_config(first), "bucket"))?
    let mut a_buf = history_buffers(1024)?
    let mut b_buf = history_buffers(1024)?
    let due = std.object.deadline_after_ms(first, BUCKET_LAW_OP_MS)
    let mut a = history_publish_genesis(mut first, StoreId(hi: 9, lo: 10), StoreId(hi: 11, lo: 12), 1, metadata, mut a_buf, due)?
    history_claim_packet(mut a_buf.packet, a.head)?
    let HistoryApplied(_) = history_register_advance(mut first, mut a, metadata, mut a_buf, due)? else {
        fail("the genesis claim did not advance")
    }
    let seen = history_fetch(mut second, "head", mut b_buf.witness, due)?
    let captured = history_decode_head(b_buf.witness)?
    let mut b = HistoryRegister(head: captured.head, tag: seen.etag, terminal: None)
    bucket_m2_law_commit_packet(mut a_buf.packet, a.head, 1)?
    bucket_m2_law_commit_packet(mut b_buf.packet, b.head, 2)?

    // Both candidates use generation 2's tag. A sees 409, then loses the
    // reply to the applied resend. B sees 409, then 412 on its stale resend.
    let HistoryApplied(_) = history_register_advance(mut first, mut a, metadata, mut a_buf, due)? else {
        fail("L54: the writer whose exact bytes landed did not advance")
    }
    if let Error(Fenced(1)) = history_register_advance(mut second, mut b, metadata, mut b_buf, due) {} else {
        fail("L53: the losing writer did not fence after its 409 and 412")
    }
    if a_buf.witness != a_buf.body || b_buf.witness != a_buf.body || b_buf.body == a_buf.body || b.head.entry.seq != 2 {
        fail("L54: the witness did not distinguish the two proposed heads")
    }
    Ok(clone(a_buf.body))
}

fn object_conflict_single_advance(seq: u64, writes: u64) -> bool {
    seq == 3 && writes == 8
}

fn object_conflict_budget(tasks: Tasks, sim: BucketSim) -> Result[Bytes, Error] waits {
    let mut client = bucket_law_client_lanes(sim, tasks, "s3.test", 1, true, 1)?
    let metadata = history_config_bytes(object_history_config(std.object.bucket_config(client), "bucket"))?
    let mut scratch = history_buffers(1024)?
    let due = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    let genesis = history_publish_genesis(mut client, StoreId(hi: 9, lo: 10), StoreId(hi: 11, lo: 12), 1, metadata, mut scratch, due)?
    let original: Bytes = clone(scratch.body)
    let mut candidate = genesis.head
    history_claim_packet(mut scratch.packet, genesis.head)?
    candidate.entry = history_new_ref(2, 1, scratch.packet)
    history_encode_head(mut scratch.body, candidate, metadata)?
    let proposed: Bytes = clone(scratch.body)
    let start = host.mono_ns(sim.time)
    let refused = history_write_head(mut client, Match(genesis.tag), mut scratch.body, mut scratch.witness, due)
    if let HistoryRefused(Retriable(Status(409, code))) = refused {
        if code != string.as_bytes("ConditionalRequestConflict") {
            fail("Q5: 409 carried the wrong S3 error code")
        }
    } else {
        fail("Q5: exhausting the 409 budget did not return a typed retry error")
    }
    if host.mono_ns(sim.time) - start < 150000000 || scratch.body != proposed {
        fail("Q5: 409 retries skipped backoff or changed the submitted body")
    }
    // One ambiguous error must share the budget and survive later 409s.
    if let HistoryUndecided = history_write_head(mut client, Match(genesis.tag), mut scratch.body, mut scratch.witness, due) {} else {
        fail("Q5: the mixed 503 and 409 budget did not preserve uncertainty")
    }
    Ok(take original)
}

fn object_conflict_budget_held(attempts: u64, writes: u64) -> bool {
    attempts == 15 && writes == 3
}

@test
fn bucket_test_m2_head_conflict(c: Clock, tasks: Tasks, seed_grant: Env) -> Result[(), Error] waits {
    let seed = bucket_law_seed(seed_grant, 39)
    let clean: std.sim.s3.Fault = Clean
    let conflict: std.sim.s3.Fault = Conflict
    let lost: std.sim.s3.Fault = ResetAfterBody
    let slow: std.sim.s3.Fault = SlowDown
    let race_tape = [clean, clean, clean, clean, clean, clean, clean, clean, clean, conflict, lost, clean, clean, clean, conflict, clean, clean, clean]
    let race = object_conflict_sim(tasks, c, seed, race_tape)
    let winner = object_conflict_race(tasks, race)
    let raced = bucket_law_finish(take race)
    let expected = winner?
    let stored = option.unwrap(map.get(raced.objects, "head"))
    let captured = history_decode_head(stored.data)?
    if list.len(raced.head_writes) != 3 || raced.head_writes[2].request != 11 || raced.head_writes[2].data != expected {
        fail("VP1: the HEAD history missed the applied write whose reply was lost")
    }
    // L54 negative control: replaying with a fresh tag after the lost reply
    // adds a ninth write even when the final bytes happen to agree.
    if object_conflict_single_advance(3, 9) || !object_conflict_single_advance(captured.head.entry.seq, raced.writes) || stored.data != expected || raced.attempts != 17 {
        fail("L54: the bucket did not record exactly one generation-3 advance")
    }

    // Genesis, five conflicts, then another five attempts with a 503 mixed
    // in. A clean sixth attempt in the mixed run would publish the candidate.
    let budget_tape = [clean, clean, clean, clean, clean, conflict, conflict, conflict, conflict, conflict, conflict, slow, conflict, conflict, conflict, clean, clean, clean]
    let budget = object_conflict_sim(tasks, c, seed, budget_tape)
    let unchanged = object_conflict_budget(tasks, budget)
    let exhausted = bucket_law_finish(take budget)
    let original = unchanged?
    let after = option.unwrap(map.get(exhausted.objects, "head"))
    // Q5 negative control: a separate budget for 503 admits a sixth attempt.
    if object_conflict_budget_held(16, 3) || !object_conflict_budget_held(exhausted.attempts, exhausted.writes) || after.data != original {
        fail("Q5: mixed retries exceeded five attempts or changed the head")
    }
    Ok(())
}

// The head's raw bytes through the uncut address: (pair epoch, entry seq, AUTHORITY tail).
fn bucket_law_head_authority(s: BucketSim, tasks: Tasks) -> Result[(u64, u64, Bytes), Error] waits {
    let mut client = bucket_law_client(s, tasks, "spare.test", 17)?
    let due = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    let mut raw: Bytes = list.with_capacity(HISTORY_HEAD_LIMIT)
    let _ = history_fetch(mut client, "head", mut raw, due)?
    let captured = history_decode_head(raw)?
    Ok((captured.head.pair.epoch, captured.head.entry.seq, copied(list.slice(raw, 240, list.len(raw)))?))
}

// STORE §12.3 claim crash cut. A writer acks every round through the uncut
// address. A claimant opens through the cut address and dies at wire request
// `after`, which is applied without a reply or dropped. Its open makes 11
// requests, so 11 is past the end. Recovery through the uncut address must
// find every acknowledged row, and the head's AUTHORITY must stay the
// genesis bytes. `claimed` marks a cut that landed between the
// claim's head replace and its CLAIM advance.
@test
fn bucket_test_claim_cut(c: Clock, r: Random, tasks: Tasks, e: Env, out: Stdout) -> Result[(), Error] waits {
    let seed = bucket_law_seed(e, 0)
    let after = seed % 12
    let apply = (seed / 12) % 2 == 0
    let s = bucket_law_sim(tasks, c, seed, Some(bucket_law_wire_cut(after, apply)), list.new())
    let writer = bucket_law_authority(s, tasks, "spare.test", 1)?
    let mut db = open_authority(tasks, take writer, s.time, r, bucket_law_options(true)) ?=> |Refusal(error: take problem, ..)| take problem
    for k in 1u64 .. BUCKET_LAW_ROUNDS + 1 {
        bucket_law_round(mut db, k)?
    }
    close(take db)?
    let (genesis_epoch, written_seq, genesis) = bucket_law_head_authority(s, tasks)?
    let claimant = bucket_law_authority(s, tasks, "s3.test", 2)?
    let opened = match open_authority(tasks, take claimant, s.time, r, bucket_law_options(false)) {
        Ok(take claimed) => {
            let _ = close(take claimed)
            true
        },
        Error(_) => false,
    }
    let (cut_epoch, cut_seq, _) = bucket_law_head_authority(s, tasks)?
    let claimed = !opened && cut_epoch > genesis_epoch && cut_seq == written_seq
    let recovered = bucket_law_recover(tasks, r, s, "spare.test", seed + 7)
    let after_recovery = bucket_law_head_authority(s, tasks)
    let _ = bucket_law_finish(take s)
    let mut trace = string.from(if opened {
        "claim beyond "
    } else if claimed {
        "claim claimed "
    } else {
        "claim reached "
    })
    string.push_u64(mut trace, after)
    string.push(mut trace, if apply {
        " apply\n"
    } else {
        " drop\n"
    })
    result.unwrap(stdout.write(out, trace))
    if recovered? != BUCKET_LAW_ROUNDS {
        fail("claim cut: recovery lost an acknowledged row")
    }
    let (_, _, recovered_authority) = after_recovery?
    if recovered_authority != genesis {
        fail("claim cut: AUTHORITY after recovery differs from the genesis bytes")
    }
    Ok(())
}

// STORE §12.2: an endpoint that applies a PUT whose If-None-Match fails is
// refused at genesis, before any head exists.
@test
fn bucket_test_ignored_conditions_refuse_genesis(c: Clock, r: Random, tasks: Tasks, seed_grant: Env) -> Result[(), Error] waits {
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(1)
    list.push(mut faults, IgnoreConditions)
    let sim = bucket_law_sim(tasks, c, bucket_law_seed(seed_grant, 2111), None, take faults)
    let authority = bucket_law_authority(sim, tasks, "s3.test", 1)?
    let refused = match open_authority(tasks, take authority, sim.time, r, bucket_law_options(true)) {
        Error(Refusal(error: Endpoint(IgnoresIfNoneMatch), ..)) => true,
        _ => false,
    }
    let report = bucket_law_finish(take sim)
    if !refused {
        fail("an endpoint that ignores If-None-Match opened a store")
    }
    if map.contains(report.objects, "head") {
        fail("the refused genesis wrote a head")
    }
    Ok(())
}

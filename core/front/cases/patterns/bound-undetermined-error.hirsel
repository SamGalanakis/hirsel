// LANG-18/12: neither a bound nor the function result determines receipt's E.
// The open argument is refused at the operand call.
// expect: accept
// expect: refuse LANG-12 at 7:63
fn receipt[E]() -> Result[u64, E] { loop {} }
fn f() -> Result[u64, u8] {
  let r: Result[u64, Capacity] = bound bytes 0 { let n: u64 = receipt()?; n }
  Ok(match r { Ok(n) => n, Error(c) => c.requested })
}

        Ok(())
    } else {
        Error(())
    }
}

// The law alone gives the running loop zero new bytes after its startup.
// Production reserves its root once and relies on the preallocated buffers.
fn journal_worker_zero(take input: JournalWorker) -> Result[(), Error] waits {
    let reserved = capacity(journal_buffers(int.widen(input.group_bytes)))?
    let _ = channel.send(input.ready, Ok(()))
    let attempt = bound bytes 0 {
        journal_loop(take input, take reserved)
    }
    capacity(take attempt)?
}

// L24's S3 half writes the specified CALL frame directly. record/reply are
// S5's producers; the S3 reader retains no call record in resident trees.
pub fn journal_law_recorded(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let db = result.unwrap(open(tasks, d, c, r, options))
    let id = db.store
    let seq = db.file_seq
    result.unwrap(close(take db))
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, 0, 4))
    result.unwrap(le(mut payload, 1, 8))
    result.unwrap(le(mut payload, 101, 8))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(le(mut payload, 1, 4))
    result.unwrap(le(mut payload, 3, 1))
    result.unwrap(blob(mut payload, string.as_bytes("stream")))
    let mut stream_value: Bytes = list.new()
    result.unwrap(le(mut stream_value, 1, 8))
    list.fill(mut stream_value, 32, 5u8)
    result.unwrap(le(mut stream_value, 2, 1))
    list.append(mut stream_value, string.as_bytes("reply"))
    result.unwrap(blob(mut payload, stream_value))
    result.unwrap(blob(mut payload, string.as_bytes("entry")))
    result.unwrap(blob(mut payload, string.as_bytes("arguments")))
    // AP1a. The 21-byte prefix, 5-byte streams head and 61-byte reply op
    // are followed by the 9-byte entry and 13-byte args blobs.
    let revision_at = 109u64
    result.unwrap(blob(mut payload, revision_vector()))
    result.unwrap(blob(mut payload, code_vector()))
    result.unwrap(le(mut payload, 0, 1))
    // Revision (36), code (52) and settle (1) add 89 bytes.
    if list.len(payload) != 198 {
        return false
    }
    let raw = result.unwrap(disk_seal(DiskContext(store: id, role: 2, seq: seq), 72, 0x0011, 1, payload))
    let path = result.unwrap(disk_path("j-", seq, ""))
    let mut file = result.unwrap(host.open(d, path, Append))
    result.unwrap(host.write(mut file, raw))
    result.unwrap(host.sync(mut file))
    result.unwrap(host.close(take file))
    let end_path = result.unwrap(disk_path("j-", seq, ".end"))
    // HEADER (72) + COMMIT frame overhead (16) + payload (198).
    result.unwrap(disk_write_synced(d, end_path, journal_end_bytes(id, seq, 286)))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    let b = main_branch(reopened)
    match result.unwrap(recorded(reopened, b, 1)) {
        Some(call_record) => if call_record.record.key != string.as_bytes("entry") || call_record.record.args != string.as_bytes("arguments") || call_record.record.stream != string.as_bytes("stream") || !revision_is_vector(call_record.record.revision) {
            return false
        },
        None => return false
    }
    if let Some(_) = result.unwrap(recorded(reopened, b, 0)) {
        return false
    }
    if let Some(_) = result.unwrap(recorded(reopened, b, 2)) {
        return false
    }
    let foreign_branch = Branch(store: StoreId(hi: id.hi ^ 1u64, lo: id.lo), id: 0)
    match recorded(reopened, foreign_branch, 1) {
        Error(Foreign) => {},
        _ => return false
    }
    let cut = result.unwrap(checkpoint(mut reopened))
    result.unwrap(durable(mut reopened, cut))
    if let Some(_) = result.unwrap(recorded(reopened, b, 1)) {
        return false
    }
    if page_row_count(reopened.heads[0].roots.streams) != 1 {
        return false
    }
    result.unwrap(close(take reopened))
    // AD1: a one-byte entry revision is malformed even when the code
    // and settlement fields are present and the checksum matches.
    let bad_dir = disk_test_directory(d)
    let bad = result.unwrap(open(tasks, bad_dir, c, r, options))
    let bad_id = bad.store
    let bad_seq = bad.file_seq
    result.unwrap(close(take bad))
    let mut one: Bytes = list.new()
    list.fill(mut one, 1, 7u8)
    let mut short = result.unwrap(copied(list.slice(payload, 0, revision_at)))
    result.unwrap(blob(mut short, one))
    result.unwrap(blob(mut short, code_vector()))
    result.unwrap(le(mut short, 0, 1))
    // The one-byte revision makes this payload 31 bytes shorter.
    if list.len(short) != 167 {
        return false
    }
    let short_raw = result.unwrap(disk_seal(DiskContext(store: bad_id, role: 2, seq: bad_seq), 72, 0x0011, 1, short))
    let short_path = result.unwrap(disk_path("j-", bad_seq, ""))
    let mut short_file = result.unwrap(host.open(bad_dir, short_path, Append))
    result.unwrap(host.write(mut short_file, short_raw))
    result.unwrap(host.sync(mut short_file))
    result.unwrap(host.close(take short_file))
    let short_end = result.unwrap(disk_path("j-", bad_seq, ".end"))
    result.unwrap(disk_write_synced(bad_dir, short_end, journal_end_bytes(bad_id, bad_seq, 255)))
    match open(tasks, bad_dir, c, r, options) {
        Error(Corrupt(fault)) => match fault.why {
            Malformed => {},
            _ => return false
        },
        _ => return false
    }
    let in_memory = memory(c, r, options)
    let memory_branch = main_branch(in_memory)
    match result.unwrap(recorded(in_memory, memory_branch, 1)) {
        None => true,
        Some(_) => false
    }
}

@test
fn journal_test_recorded(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_recorded(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L24(v), Z1 by hand: 100 main commits made durable leave journaled at frame
// 100. A fork from version 1 commits its v2 with a CALL section as frame 101,
// which the journal task has not taken. recorded(fork, 2) must send the
// barrier and read Some, with AD1's revision. Main's v2 is under the fork's
// cut, so it is None. After reopen the fork's v2 is replayed and read again.
// Wrong implementations caught: a fast path that compares the version with
// journaled (2 <= 100 skips the barrier and reads None); a cover test that
// compares the version with main's head at the last cut (2 <= 101 is None).
pub fn journal_law_recorded_fork(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = journal_crash_options()
    options.resident_limit = 4194304
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let early = snapshot(db)
    for k in 0u64 .. 100 {
        if !typed_put(mut db, t, k, k) {
            return false
        }
    }
    let last = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    result.unwrap(durable(mut db, last))
    if disk_state(db).journaled != 100 || db.heads[0].head != 101 {
        return false
    }
    let (f, _) = result.unwrap(fork(mut db, "f", early))
    let commit_ticket = result.unwrap(journal_fixture_call(mut db, 1, false, Some(revision_vector())))
    match result.unwrap(recorded(db, f, 2)) {
        Some(captured) => if !revision_is_vector(captured.record.revision) || captured.record.stream != string.as_bytes("stream00") {
            return false
        },
        None => return false
    }
    let main = main_branch(db)
    if let Some(_) = result.unwrap(recorded(db, main, 2)) {
        return false
    }
    result.unwrap(durable(mut db, commit_ticket))
    result.unwrap(close(take db))
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    let again = match branch(reopened, "f") {
        Some(x) => x,
        None => return false
    }
    let good = match result.unwrap(recorded(reopened, again, 2)) {
        Some(captured) => revision_is_vector(captured.record.revision),
        None => false
    }
    result.unwrap(close(take reopened))
    good
}

@test
fn journal_test_recorded_fork(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_recorded_fork(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L43's four export images, including a lease copied after a covering cut.
@test
fn journal_test_fork_exports(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let source = disk_test_directory(d)
    let scratch = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 1048576
    let mut db = deploy_result(open(tasks, source, c, r, options))?
    db.fence = 1
    deploy_result(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))?
    let rows = deploy_result(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    if !typed_put(mut db, rows, 1, 11) {
        return Error(ExportMismatch)
    }
    let parent = snapshot(db)
    let wall = db.heads[0].at
    let (beta, _) = deploy_result(fork(mut db, "beta", parent))?
    let mut attempt: Bytes = list.with_capacity(16)
    list.fill(mut attempt, 16, 1u8)
    let fork_only = begin_export_copy(mut db, scratch, result.unwrap(copied(attempt)), 0)?
    let exported = export_copy(take fork_only)?
    let opened = open_export(exported.dir, c, attempt, options)?
    if opened.db.next_branch != 2 || opened.db.heads[1].id != 1 || opened.db.heads[1].parent != 0 || opened.db.heads[1].forked_at != 2 || opened.db.heads[1].head != 2 || opened.db.heads[1].at != wall || tree_stamp(opened.db.heads[1].roots.collections) != tree_stamp(opened.db.heads[0].roots.collections) {
        return Error(ExportMismatch)
    }
    let recovered = deploy_result(snapshot_of(opened.db, beta))?
    if deploy_result(get(recovered, rows, 1))? != Some(11u64) {
        return Error(ExportMismatch)
    }
    release_export(mut db, attempt)
    let _ = deploy_result(journal_fixture_call(mut db, 0, false, None))?
    let _ = deploy_result(journal_fixture_call(mut db, 1, false, Some(revision_vector())))?
    let main = main_branch(db)
    let Some(main_call) = deploy_result(recorded(db, main, 3))? else {
        return Error(ExportMismatch)
    }
    let Some(beta_call) = deploy_result(recorded(db, beta, 3))? else {
        return Error(ExportMismatch)
    }
    if !revision_is_none(main_call.record.revision) || !revision_is_vector(beta_call.record.revision) || main_call.base != 2 || beta_call.base != 2 || main_call.at != wall + 1 || beta_call.at != wall + 1 {
        return Error(ExportMismatch)
    }
    let calls = begin_export_copy(mut db, scratch, result.unwrap(copied(attempt)), 0)?
    let _ = deploy_result(checkpoint(mut db))?
    let saved_calls = export_copy(take calls)?
    // HEADER(72), put(73), FORK(38), then two CALL frames. Without the
    // revision, the CALL frame is 42 + 98 + 113 = 253 bytes.
    let name = deploy_result(capacity(disk_path("j-", saved_calls.stamp.terminal, "")))?
    let wire = deploy_result(disk_read_file(saved_calls.dir, name, 721))?
    if list.len(wire) != 721 || read_le(wire, 145, 2) != 19 || read_le(wire, 183, 2) != 17 || read_le(wire, 199, 4) != 0 || read_le(wire, 436, 2) != 17 || read_le(wire, 452, 4) != 1 || read_le(wire, 203, 8) != 3 || read_le(wire, 456, 8) != 3 {
        return Error(ExportMismatch)
    }
    release_export(mut db, attempt)
    let covering = begin_export_copy(mut db, scratch, result.unwrap(copied(attempt)), 0)?
    let covered_export = export_copy(take covering)?
    if let Some(_) = deploy_result(recorded(db, main, 3))? {
        return Error(ExportMismatch)
    }
    if let Some(_) = deploy_result(recorded(db, beta, 3))? {
        return Error(ExportMismatch)
    }
    for image in[saved_calls.dir, covered_export.dir] {
        let recovered_image = open_export(image, c, attempt, options)?
        if recovered_image.db.next_branch != 2 || recovered_image.db.heads[0].head != 3 || recovered_image.db.heads[1].head != 3 || recovered_image.db.heads[0].at != wall + 1 || recovered_image.db.heads[1].at != wall + 1 {
            return Error(ExportMismatch)
        }
        let recovered_beta = deploy_result(snapshot_of(recovered_image.db, beta))?
        if deploy_result(get(recovered_beta, rows, 1))? != Some(11u64) {
            return Error(ExportMismatch)
        }
    }
    release_export(mut db, attempt)
    deploy_result(close(take db))
}

// L44. The logical charge for 100,000 rows is 260 + 100,000 * 94.
// Under the pin, two overwrites add 188, including the obsolete first write.
@test
fn journal_test_fork_cost(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let child = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 1048576
    let mut db = open(tasks, child, c, r, options)?
    create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64()))?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    reserve_pinned_data(mut db, rows, 100000)
    let held = snapshot(db)
    let _ = pin(mut db, "pin", held)?
    if !typed_put(mut db, rows, 0, 2) || !typed_put(mut db, rows, 0, 3) {
        return Error(Foreign)
    }
    let preceding = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    durable(mut db, preceding)?
    let before = accounts(db)
    let old_generation = db.checkpointed
    let old_segment = db.file_seq
    let old_stamp = db.next_node
    let old_end = db.file_end
    let file = capacity(disk_path("j-", old_segment, ""))?
    let saved = snapshot(db)
    let (beta, receipt) = fork(mut db, "beta", saved)?
    let after = accounts(db)
    let raw = disk_read_file(child, file, old_end + 38)?
    if list.len(raw) != old_end + 38 || read_le(raw, old_end, 2) != 19 || read_le(raw, old_end + 2, 2) != 1 || read_le(raw, old_end + 4, 4) != 22 || before.logical != 9400448 || after.logical != 9400448 || before.exact || after.exact || before.frames != 0 || after.frames != 0 || after.journal != before.journal + 38 || after.resident != before.resident || db.next_node != old_stamp || db.checkpointed != old_generation || db.file_seq != old_segment || journal_mark(receipt) != journal_mark(preceding) + 1 || !covered(db, receipt.mark) {
        return Error(Foreign)
    }
    let on_beta = snapshot_of(db, beta)?
    if get(on_beta, rows, 0)? != Some(3u64) {
        return Error(Foreign)
    }
    let (_, cut) = fork(mut db, "old", held)?
    if let Cut(generation) = cut.mark {
        if generation == old_generation + 1 {
            return close(take db)
        }
    }
    Error(Foreign)
}

// L50 B5. A Bytes value has a four-byte length and two-byte schema tag.
// A 994-byte input therefore contributes 78 + 1000 bytes per stored version.
fn fork_history(mut db: Db) -> Result[Branch, Error] waits {
    create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_bytes()))?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let mut value: Bytes = list.with_capacity(994)
    list.fill(mut value, 994, 0u8)
    let first = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        for slot_order in 0u64 .. 6 {
            put(mut tx, rows, 6 - slot_order, value)?
        }
        Ok(())
    })?
    let Committed(_) = first else {
        return Error(Foreign)
    }
    if accounts(db).logical != 6728 {
        return Error(Foreign)
    }
    let saved = snapshot(db)
    let (beta, _) = fork(mut db, "beta", saved)?
    if accounts(db).logical != 6728 || !accounts(db).exact {
        return Error(Foreign)
    }
    let _ = list.set(mut value, 0, 1u8)
    let updated = run_on(mut db, beta, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, rows, 6, value)
    })?
    let Committed(done) = updated else {
        return Error(Foreign)
    }
    durable(mut db, done.ticket)?
    if accounts(db).logical != 7806 {
        return Error(Foreign)
    }
    Ok(beta)
}

@test
fn journal_test_fork_history(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 1048576
    options.resident_limit = 7806
    let mut mem = memory(c, r, options)
    let _ = deploy_result(fork_history(mut mem))?
    deploy_result(close(take mem))?
    let child = disk_test_directory(d)
    let scratch = disk_test_directory(d)
    let mut db = deploy_result(open(tasks, child, c, r, options))?
    db.fence = 1
    let beta = deploy_result(fork_history(mut db))?
    let mut attempt: Bytes = list.with_capacity(16)
    list.fill(mut attempt, 16, 17u8)
    let captured = begin_export_copy(mut db, scratch, result.unwrap(copied(attempt)), 0)?
    let exported = export_copy(take captured)?
    let from_export = open_export(exported.dir, c, attempt, options)?
    if accounts(from_export.db).logical != 7806 {
        return Error(ExportMismatch)
    }
    release_export(mut db, attempt)
    deploy_result(close(take db))?
    let mut again = deploy_result(open(tasks, child, c, r, options))?
    if accounts(again).logical != 7806 || !accounts(again).exact {
        return Error(ExportMismatch)
    }
    let rows = deploy_result(table(mut again, "rows", std.codec.key_u64(), std.codec.of_bytes()))?
    let sibling = deploy_result(snapshot_of(again, beta))?
    let Some(old) = deploy_result(get(snapshot(again), rows, 6))? else {
        return Error(ExportMismatch)
    }
    let Some(new) = deploy_result(get(sibling, rows, 6))? else {
        return Error(ExportMismatch)
    }
    if list.len(old) != 994 || list.len(new) != 994 || old[0] != 0 || new[0] != 1 {
        return Error(ExportMismatch)
    }
    let _ = deploy_result(checkpoint(mut again))?
    if accounts(again).logical != 7806 || !accounts(again).exact {
        return Error(ExportMismatch)
    }
    deploy_result(close(take again))
}

fn fork_test_payload(id: u64, name: String) -> Bytes {
    let mut raw: Bytes = list.new()
    result.unwrap(le(mut raw, id, 4))
    result.unwrap(le(mut raw, 0, 4))
    result.unwrap(le(mut raw, 0, 8))
    result.unwrap(le(mut raw, string.byte_len(name), 2))
    list.append(mut raw, string.as_bytes(name))
    list.put_word_le(mut raw, 1u64)
    take raw
}

fn fork_test_append(d: Dir, store: StoreId, seq: u64, offset: u64, id: u64, name: String) -> Result[(), Error] waits {
    let path = capacity(disk_path("j-", seq, ""))?
    let ctx = DiskContext(store: store, role: 2, seq: seq)
    let raw = capacity(disk_seal(ctx, offset, 19, 1, fork_test_payload(id, name)))?
    let mut file = disk_io(host.open(d, path, Append))?
    if let Error(failure) = host.write(mut file, raw) {
        return Error(Io(failure.error))
    }
    disk_io(host.sync(mut file))?
    disk_io(host.close(take file))
}

// L51(b) and (c). Exercise the real opener at the exhausted watermark and
// keep the empty UTF-8 name on both the journal and the cut path.
@test
fn journal_test_fork_identity(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let root = disk_test_directory(d)
    let options = journal_crash_options()
    let initial = open(tasks, root, c, r, options)?
    let store = initial.store
    close(take initial)?
    let mut manifest = page_manifest_empty()
    manifest.next_branch = 4294967295
    disk_publish_manifest(root, store, manifest)?
    let mut exhausted = open(tasks, root, c, r, options)?
    let saved = snapshot(exhausted)
    match fork(mut exhausted, "exhausted", saved) {
        Error(Limit(Ids)) => (),
        _ => return Error(Foreign)
    }
    let seq = exhausted.file_seq
    close(take exhausted)?
    fork_test_append(root, store, seq, 72, 4294967295, "bad")?
    match open(tasks, root, c, r, options) {
        Error(Corrupt(Fault(why: Malformed, ..))) => (),
        _ => return Error(Foreign),
    }
    let empty_dir = disk_test_directory(d)
    let mut db = open(tasks, empty_dir, c, r, options)?
    let main = snapshot(db)
    let (empty, receipt) = fork(mut db, "", main)?
    if empty.id != 1 || journal_mark(receipt) != 1 {
        return Error(Foreign)
    }
    close(take db)?
    let mut again = open(tasks, empty_dir, c, r, options)?
    if option.unwrap(branch(again, "")).id != 1 {
        return Error(Foreign)
    }
    let old = snapshot_of(again, empty)?
    let _ = delete_branch(mut again, empty)?
    let (historical, cut) = fork(mut again, "", old)?
    if historical.id != 2 || again.heads[1].parent != 1 || again.heads[1].forked_at != 0 {
        return Error(Foreign)
    }
    if let Journal(_, _, _) = cut.mark {
        return Error(Foreign)
    }
    close(take again)?
    let restored = open(tasks, empty_dir, c, r, options)?
    if option.unwrap(branch(restored, "")).id != 2 || restored.heads[1].parent != 1 {
        return Error(Foreign)
    }
    close(take restored)?
    fork_skipped_id(disk_test_directory(d), c, r, tasks)
}

// The refused cut consumes id 1 in this open. Its successful successor FORK
// names id 2, ahead of the selected MANIFEST's watermark of 1.
fn fork_skipped_id(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut options = journal_crash_options()
    options.resident_limit = 447
    let mut db = open(tasks, d, c, r, options)?
    create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64()))?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !typed_put(mut db, rows, 1, 1) {
        return Error(Foreign)
    }
    let old = snapshot(db)
    if !typed_put(mut db, rows, 1, 2) {
        return Error(Foreign)
    }
    match fork(mut db, "older", old) {
        Error(Full(Resident(short))) if short.requested == 448 && short.available == 447 => (),
        _ => return Error(Foreign),
    }
    let saved = snapshot(db)
    let (beta, _) = fork(mut db, "beta", saved)?
    if beta.id != 2 {
        return Error(Foreign)
    }
    close(take db)?
    let mut reopened = open(tasks, d, c, r, options)?
    if option.unwrap(branch(reopened, "beta")).id != 2 || accounts(reopened).logical != 354 || get(snapshot_of(reopened, beta)?, rows, 1)? != Some(2u64) {
        return Error(Foreign)
    }
    let recovered = snapshot(reopened)
    let (gamma, _) = fork(mut reopened, "gamma", recovered)?
    if gamma.id != 3 {
        return Error(Foreign)
    }
    close(take reopened)
}

// rule: SEM-5
// expect: run
// cuts: 1..=4
// steps: 20000000
// Mixed writes and bounded walks against a plain sorted list. The initial
// tree and opposite deletion orders exercise internal rotations,
// merges and root collapse as well as shifting a leaf's first/last element.
fn check(t: Io, condition: bool) -> () uses {} {
  failure.check(condition, Bounds())
}

fn by_value(a: u64, b: u64) -> i32 uses {} {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

fn edit(mut model: unique List[(u64, u64)], k: u64, v: Option[u64]) -> Option[u64] {
  let mut at: u64 = 0
  while at < list.len(model) {
    let (key, _) = model[at]
    if key >= k {
      break
    }
    at += 1
  }
  let mut old: Option[u64] = None()
  if at < list.len(model) {
    let (key, value) = model[at]
    if key == k {
      old = Some(value)
    }
  }
  match v {
    Some(value) => {
      if old != None() {
        model[at] = (k, value)
      } else {
        list.push(mut model, (k, value))
        let mut i = list.len(model) - 1
        while i > at {
          list.swap(mut model, i, i - 1)
          i -= 1
        }
      }
    },
    None() => if old != None() {
      let _ = list.remove(mut model, at)
    },
  }
  old
}

fn selected(model: List[(u64, u64)], lo: u64, hi: u64, down: bool) -> List[(u64, u64)] {
  let mut out: List[(u64, u64)] = []
  for i in 0u64..list.len(model) {
    let at = if down {
      list.len(model) - 1 - i
    } else {
      i
    }
    let (k, v) = model[at]
    if k >= lo && k < hi {
      list.push(mut out, (k, v))
    }
  }
  out
}

fn collected(m: ordered_map.OrderedMap[u64, u64], lo: u64, hi: u64, down: bool) -> List[
  (u64, u64)
] {
  let start: List[(u64, u64)] = []
  ordered_map.fold_range(
    m,
    Included(lo),
    Excluded(hi),
    if down {
      Descending()
    } else {
      Ascending()
    },
    take start,
    fn(take acc: List[(u64, u64)], k: u64, v: u64) -> (List[(u64, u64)], bool) {
      let mut out = take acc
      list.push(mut out, (k, v))
      (take out, true)
    }
  )
}

fn agrees(
  t: Io,
  m: ordered_map.OrderedMap[u64, u64],
  model: List[(u64, u64)],
  step: u64
) -> () {
  check(t, ordered_map.valid(m) && ordered_map.len(m) == list.len(model))
  let lo = step * 37 % 128
  let hi = lo + 47
  check(t, collected(m, lo, hi, false) == selected(model, lo, hi, false))
  check(t, collected(m, lo, hi, true) == selected(model, lo, hi, true))
  for (k, v) in model {
    check(t, ordered_map.get(m, k) == Some(v))
  }
}

pub fn main(t: Io, args: Args) -> Result[(), ()] {
  let Ok(text) = arg.text(args, 0) else {
    return Error(())
  }
  let Ok(part) = u64.parse(text) else {
    return Error(())
  }
  if part == 4 {
    deep_tree(t)
    return Ok(())
  }
  let mut m: ordered_map.OrderedMap[u64, u64] = ordered_map.empty(by_value)
  let mut model: unique List[(u64, u64)] = []
  // Appending to the model is independent of the tree's insertion order.
  for k in 0u64..128 {
    list.push(mut model, (k, k + 1))
  }
  for i in 0u64..128 {
    let k = i * 37 % 128
    ordered_map.insert(mut m, k, k + 1)
  }
  agrees(t, m, model, 0)
  let snap = copy m
  let prior = selected(model, 0, 128, false)
  for i in (part - 1) * 900..part * 900 {
    let k = (i * 73 + i / 7) % 128
    if i % 3 == 0 {
      let old = edit(mut model, k, None())
      check(t, ordered_map.remove(mut m, k) == old)
    } else {
      ordered_map.insert(mut m, k, i + 5)
      let _ = edit(mut model, k, Some(i + 5))
    }
    if i % 200 == 0 {
      agrees(t, m, model, i)
    }
  }
  agrees(t, snap, prior, 9)
  // Alternate ends: borrow from each side, then merge through every level.
  for i in 0u64..128 {
    let k = if i % 2 == 0 {
      i / 2
    } else {
      127 - i / 2
    }
    let old = edit(mut model, k, None())
    check(t, ordered_map.remove(mut m, k) == old)
    if i % 200 == 0 {
      agrees(t, m, model, i)
    }
  }
  agrees(t, m, model, 0)
  Ok(())
}

fn deep_tree(t: Io) -> () {
  let mut m: ordered_map.OrderedMap[u64, u64] = ordered_map.empty(by_value)
  // A deeper tree also moves whole child lists during split, rotation and merge.
  for i in 0u64..1100 {
    let k = i * 37 % 1100
    ordered_map.insert(mut m, k, k + 1)
  }
  check(t, ordered_map.valid(m))
  for i in 0u64..1100 {
    let k = if i % 2 == 0 {
      i / 2
    } else {
      1099 - i / 2
    }
    check(t, ordered_map.remove(mut m, k) == Some(k + 1))
    if i % 100 == 0 {
      check(t, ordered_map.valid(m))
    }
  }
  check(t, ordered_map.valid(m) && ordered_map.len(m) == 0)
  check(t, ordered_map.first(m) == None() && ordered_map.last(m) == None())
}

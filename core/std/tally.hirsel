// Module `tally`: counting and folding across tasks without shared state (Java LongAdder,
// OTP counters, Linux per-CPU counters), library code over `channel` alone. Design: api/tally.md; study: atomics-moonshot-1009 section 3.1.
//
// An owner `Tally[T]` issues handles. Each handle is a `send` resource moved into a task; it
// holds a local partial, made by the tally's `start` at issue, that the task changes in
// place with `update`, whose function is given at the call site (the `map.update` shape, so
// the engines inline it into the caller's loop): no event, no shared state, not a
// cancellation point. Its cleanup sends `(index, partial)` once over the owner's channel.
// `finish` drops the owner's sender, receives until every handle is cleaned, and folds
// `start()` then the partials in handle order (issue order) with the tally's `combine`. The
// partition of updates among handles and their order within a handle are fixed by each
// task's program, so the result is the same under every schedule, also for a combine that
// is neither associative nor commutative (a float sum, a concatenation).
//
// Representation: the channel holds max(capacity, 1) items, admitted at `new` (CONC-4), so
// each handle's one cleanup message fits and a cleanup never waits unless `flush`es have
// filled the queue. `slots` holds one Option[T] per issued handle (capacity reserved at
// `new`); the owner merges a handle's messages into its slot in that handle's send order.
// The handle's partial is a plain T, never empty, so `update` tests no tag; its cleanup and
// `flush` put a fresh `start()` in its place.
//
// Rules a caller sees:
// - A handle dropped by a failing or cancelled task is cleaned there (FAIL-8): its partial
//   is delivered, as far as an `update` that failed had changed it.
// - `finish` waits for every issued handle: a handle leaked into a long-lived child delays
//   `finish` until that child ends (no task outlives its spawner, so the wait is bounded).
// - `flush` and `read` are events (CONC-10 sends and receives); `update` and `index` are not.
pub opaque type Tally[T: send] {
    tx: Sender[(u64, T)],
    rx: Receiver[(u64, T)],
    slots: List[Option[T]],
    cap: u64,
    start: fn() -> T,
    combine: fn(take T, take T) -> T
}

/// A handle's local partial, its index and its way back to the owner. `send`; its block holds
/// its fields and cause cell (MEM-24). Its finalizer sends `(index, partial)` once,
/// waiting only while flushes fill the owner's queue.
pub opaque resource type Handle[T: send]: send {
    tx: Sender[(u64, T)],
    index: u64,
    local: T,
    start: fn() -> T
} drop(h) {
    let f = h.start
    let p = replace(mut h.local, f())
    let _ = channel.send(h.tx, (h.index, take p))
}

/// Why `handle` refused. Exhausted: `capacity` handles were already issued.
/// Capacity(c): the handle's block was refused. The tally is unchanged either way.
pub type HandleError = Exhausted | Capacity(Capacity)

/// An owner for up to n handles. Each handle's partial starts as start(); finish folds
/// start() and the partials with combine. `channel.new(max(n, 1))` and
/// `list.with_capacity(n)`. Fails: Error(c), nothing kept.
/// Alloc: the channel's charge for max(n, 1) items of (u64, T), and n x size(Option[T]).
/// Ex: `let mut hits = std.tally.new(64, fn() -> u64 { 0 }, fn(take a: u64, take b: u64) -> u64 { a + b })?`
pub fn new[T: send](n: u64, start: fn() -> T, combine: fn(take T, take T) -> T) -> Tally[T] {
    let (tx, rx): (Sender[(u64, T)], Receiver[(u64, T)]) = channel.new(if n == 0 {
        1
    } else {
        n
    })
    let slots: List[Option[T]] = list.with_capacity(n)
    Tally(tx: take tx, rx: take rx, slots: take slots, cap: n, start, combine)
}

/// Issues the next handle, its partial start(); its index is the number issued before it.
/// Fails: Error(Exhausted) after n handles; Error(Capacity(c)) when its block is refused.
/// Alloc: the handle's block, current limit, and what start() allocates. Cost: one
/// start() call, no event. Ex: `task.spawn(tasks, bytes 4096, std.tally.handle(mut hits)?, count)`
pub fn handle[T: send](mut t: Tally[T]) -> Result[Handle[T], HandleError] {
    let next = list.len(t.slots)
    if next == t.cap {
        return Error(Exhausted)
    }
    let f = t.start
    let first = f()
    list.push(mut t.slots, None)
    match Handle(tx: channel.sender(t.tx), index: next, local: take first, start: f) {
        Ok(take h) => Ok(take h),
        Error((c, _)) => {
            let _ = list.pop(mut t.slots)
            Error(Capacity(c))
        }
    }
}

/// The handle's index: unique among the owner's handles and fixed by the owner's program
/// order, so `(std.tally.index(h), local_seq)` is a deterministic id. Cost: O(1).
pub fn index[T: send](h: Handle[T]) -> u64 {
    h.index
}

/// Applies f to the handle's partial in place and returns f's result. Not an event and
/// not a cancellation point. Fails: whatever f fails with; the partial keeps what f had
/// changed and is delivered at the handle's cleanup. Cost: one call of f.
/// Ex: `std.tally.update(mut h, fn(mut n: u64) { n += 1 })`
pub fn update[T: send, R](mut h: Handle[T], f: scoped fn(mut T) -> R) -> R {
    f(mut h.local)
}

/// Sends the partial so far to the owner and starts a fresh one with start(), so a later
/// `read` sees it. An event (`channel.send`); waits while the owner's queue is full, until
/// the owner reads or finishes. A dropped owner discards it. Flushing does not change what
/// `finish` returns for an associative combine with start() its identity; otherwise the
/// handle's slot is combine(slot, flushed part) at each flush, still the same under every
/// schedule.
pub fn flush[T: send](mut h: Handle[T]) waits {
    let f = h.start
    let p = replace(mut h.local, f())
    let _ = channel.send(h.tx, (h.index, take p))
}

/// start() folded with what has arrived so far, in handle order: a live reading of flushed
/// and cleaned partials. Events: one `channel.try_receive` per pending message plus one.
/// The value depends on the schedule. Ex: `let seen = std.tally.read(mut hits)`
pub fn read[T: plain](mut t: Tally[T]) -> T {
    while let Ok((i, p)) = channel.try_receive(t.rx) {
        merge(mut t.slots, i, p, t.combine)
    }
    let f = t.combine
    let first = t.start
    let mut acc = first()
    for s in t.slots {
        if let Some(p) = s {
            acc = f(acc, p)
        }
    }
    acc
}

/// Drops the owner's sender, receives every handle's partial until all are cleaned, and
/// returns start() folded with the partials in handle order. The same value under every
/// schedule. Waits for every issued handle. Events: one receive per message plus one.
/// Ex: `let total = std.tally.finish(take hits)`
pub fn finish[T: send](take t: Tally[T]) -> T waits {
    let Tally(tx: take tx, rx: take rx, slots: take slots0, cap: _, start: first, combine: f) = take t
    {
        let closed = take tx
    }
    let mut slots = take slots0
    while let Ok((i, take p)) = channel.receive(rx) {
        merge(mut slots, i, take p, f)
    }
    let mut acc = first()
    let n = list.len(slots)
    for i in 0 .. n {
        if let Some(take p) = list.set(mut slots, i, None) {
            let next = f(take acc, take p)
            acc = take next
        }
    }
    acc
}

// One handle's messages arrive in its send order, so each slot folds its handle's parts
// in program order.
fn merge[T: send](mut slots: List[Option[T]], i: u64, take p: T, f: fn(take T, take T) -> T) {
    let next = match list.set(mut slots, i, None) {
        None => take p,
        Some(take acc) => f(take acc, take p),
    }
    let _ = list.set(mut slots, i, Some(take next))
}

@test
fn test_directory_follower_after_demotion(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut options = hot_options(0)?
    options.free_budget = 0
    options.probe_budget = 0
    let mut writer = open(tasks, d, c, r, options)?
    let rows = hot_seed(mut writer, 3)?
    set_residency(mut writer, rows.id, Memory)?
    let (_, _, take published) = failure_result_from_rep(capture.read_only_manifest(d))?
    if published.account_tiered != 0 || published.deferred_next == 0 || published.deferred_frees.stamp == 0 || !idle_l100_has_tiered_pack(writer) {
        fail("demotion must leave resident rows, pending frees and a listed Tiered pack")
    }
    let plan = follower_law_plan(Directory, options)
    {
        let service = follower_law_service(tasks, plan, 1)?
        let mut ids = followers()
        {
            let mut mirror = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None)?
            let main_line = follower_main(mirror)
            let old = snapshot_follower(mirror, main_line)?
            let reading = follower_reader(mirror, 0)?
            if get(reading, old, rows, 2)? != Some(2u64) || !typed_put(mut writer, rows, 2, 41) {
                fail("demoted row or writer commit differed")
            }
            let expected = version(snapshot(writer))
            close(take writer)?
            let mut draining = open(tasks, d, c, r, hot_options(0)?)?
            // The first cut drains this single leaf. The next retires its pack.
            let _ = checkpoint(mut draining)?
            let _ = checkpoint(mut draining)?
            let (_, _, take drained) = failure_result_from_rep(capture.read_only_manifest(d))?
            if drained.deferred_next == 0 || drained.deferred_frees.stamp != 0 || idle_l100_has_tiered_pack(draining) {
                fail("drained fixture must retain only the deferred-free frontier")
            }
            let due = clock.deadline_after_ms(host.mono_ns(c), BUCKET_LAW_OP_MS)
            let pos = catch_up(mut mirror, due)?
            let current = at_least(mut mirror, pos, due)?
            let latest = fresh(mut mirror, due)?
            if pos.version != expected || version(current) != expected || version(latest) != expected || get(reading, latest, rows, 2)? != Some(41u64) || get(reading, old, rows, 2)? != Some(2u64) {
                fail("follower lost the demoted row across the writer's cut")
            }
            close(take draining)?
        }
        close_follower_service(take service)?
    }
    let before = follower_law_room()
    {
        let service = follower_law_service(tasks, plan, 1)?
        let mut ids = followers()
        {
            let mirror = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None)?
            let s = snapshot_follower(mirror, follower_main(mirror))?
            if get(follower_reader(mirror, 0)?, s, rows, 2)? != Some(41u64) {
                fail("idle follower missed the post-demotion commit")
            }
        }
        close_follower_service(take service)?
    }
    if follower_law_room() != before {
        fail("closing the follower service retained its grant")
    }
    Ok(())
}

fn directory_cold_follower_options() -> Result[Options, Error] {
    let mut options = l70_open_options(182375272)?
    options.pack_bytes = 65536
    options.group_bytes = 65536
    options.checkpoint_bytes = 65536
    options.journal_limit = FRAME_LIMIT + options.checkpoint_bytes
    Ok(take options)
}

fn follower_cold_fixture(d: Dir, c: Clock, r: Random, tasks: Tasks, options: Options, value: Bytes) -> Result[Table[u64, Bytes], Error] waits {
    let mut db = open(tasks, d, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    l96_put_bytes(mut db, rows, 7, value)?
    set_residency(mut db, rows.id, Tiered)?
    close(take db)?
    Ok(rows)
}

@test
fn test_directory_follower_cold_value(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let options = directory_cold_follower_options()?
    let value = l96_blob_value(23, 2000)
    let rows = follower_cold_fixture(d, c, r, tasks, options, value)?
    let plan = result.unwrap(follower_plan(Directory, options))
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    let f = match follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None) {
        Ok(take opened) => take opened,
        Error(Unsupported(0x0031)) => fail("Directory follower refused the Tiered MANIFEST with Unsupported(0x0031)"),
        Error(take problem) => return Error(take problem),
    }
    {
        let snap = snapshot_follower(f, follower_main(f))?
        let reading = follower_reader(f, VALUE_LIMIT + 1048576)?
        let _ = take f
        if get(reading, snap, rows, 7)? != Some(take value) {
            fail("Directory follower lost the writer's Cold bytes")
        }
    }
    close_follower_service(take service)
}

@test
fn test_directory_follower_cold_grant(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let options = l70_open_options(182375272)?
    let _ = follower_cold_fixture(d, c, r, tasks, options, b"committed")?
    // N = F - Q - 288 = 1 MiB. The child needs C + P + 288 =
    // 52,232,192 + 8,617,984 + 288 = 60,850,464 before its first read.
    let plan = result.unwrap(follower_from_options(Directory, clone(options), follower_control_bytes() + 288 + 1048576))
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    match follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None) {
        Error(Full(Allocation(short))) if short.requested == 60850464 && short.available <= 1048576 => (),
        _ => fail("the short worker grant must refuse the pager task reservation"),
    }
    close_follower_service(take service)
}

@test
fn test_directory_follower_first_cold_cut(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let options = directory_cold_follower_options()?
    let mut db = open(tasks, d, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    set_residency(mut db, rows.id, Tiered)?
    let value = b"from the journal"
    l96_put_bytes(mut db, rows, 7, value)?
    close(take db)?
    let plan = result.unwrap(follower_plan(Directory, options))
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    {
        let mut mirror = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None)?
        let main_line = follower_main(mirror)
        if let Some(_) = mirror.pager {
            fail("the empty checkpoint root started a pager")
        }
        let journaled = snapshot_follower(mirror, main_line)?
        if get(follower_reader(mirror, 0)?, journaled, rows, 7)? != Some(clone(value)) {
            fail("the follower lost the overlay above an empty Tiered root")
        }
        let mut writing = open(tasks, d, c, r, options)?
        let _ = checkpoint(mut writing)?
        close(take writing)?
        let Some(cut) = follower_floor(mut mirror, version(journaled))? else {
            fail("the checkpoint at the captured version must be available")
        }
        let reading = follower_reader(mirror, VALUE_LIMIT + 1048576)?
        if get(reading, cut, rows, 7)? != Some(clone(value)) {
            fail("the first Cold floor must start the pager for its Reader")
        }
        let due = clock.deadline_after_ms(host.mono_ns(c), BUCKET_LAW_OP_MS)
        let current = fresh(mut mirror, due)?
        if get(reading, current, rows, 7)? != Some(take value) {
            fail("a Reader must keep its pager across a re-base")
        }
    }
    close_follower_service(take service)
}

@test
fn test_directory_follower_cold_projector_image(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let options = l70_open_options(300000000)?
    let (image, expected) = mixed_capture(d, c, r, tasks, options, true, false, true)?
    let (take writing, take fixture) = mixed_reopen(d, c, r, tasks, options, image)?
    close(take writing)?
    let plan = result.unwrap(follower_plan(Directory, directory_cold_follower_options()?))
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    {
        let mirror = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None)?
        let snap = snapshot_follower(mirror, follower_main(mirror))?
        let reading = follower_reader(mirror, VALUE_LIMIT + 1048576)?
        let MixedFixture(decl: take decl, source: take rows) = take fixture
        let Seen(Seen(value: Ok((take changes_seen, _)), ..)) = look(reading, snap, Some(PROJECTOR_LAW_STEPS), (take decl, take rows), mixed_pages)? else {
            fail("the follower could not read the Cold projector image")
        }
        if changes_seen != expected {
            fail("the follower's tail differs from the committed rows")
        }
    }
    close_follower_service(take service)
}

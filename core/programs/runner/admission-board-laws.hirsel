// A whole board of sub 1 as a repair's rows: REPAIR_KEYS keys, each holding `mark` bytes of
// REPAIR_VALUE, so one repair is about a fifth of `budget` and fits a frame.
const REPAIR_KEYS: u64 = 10u64

const REPAIR_VALUE: u64 = 20000u64

fn repair_board(mark: u8) -> List[SubRow] {
    let mut rows: List[SubRow] = list.new()
    for k in 0u64 .. REPAIR_KEYS {
        let mut key: Bytes = list.new()
        std.codec.put_u64(k, mut key)
        let mut value: Bytes = list.new()
        for _ in 0u64 .. REPAIR_VALUE {
            list.push(mut value, mark)
        }
        list.push(mut rows, SubRow(sub: 1u32, key: take key, value: Some(take value)))
    }
    take rows
}

// L24 (v2.20, repair_delivered), the owner's half: a reader that is slow but responsive gets
// one repair after another while its writer is still busy. Each `complete` replaces sub 1's
// image from empty (v2.20 item 5), so the client reaches the newest board with no `Reset`
// (item 6 counts only coalesced rows against `budget`). Red when the owner keeps every
// superseded repair queued: the sixth whole board puts it over `budget`, and it resets.
pub fn law_repair_coalesced(tasks: Tasks, c: Clock, r: Random) -> bool {
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, ..) = take service
    let mut owner = take initial
    let mut work = wire_work()
    owner.joined = Some(7u64)
    list.push(mut owner.subs, (1u32, 1u64))
    let repairs = 8u8
    let mut delivered = true
    for mark in 1u8 .. repairs + 1u8 {
        let version: u64 = 10u64 + int.widen(mark)
        let mut generations: List[(u32, u64)] = list.new()
        list.push(mut generations, (1u32, 1u64))
        let mut complete: List[u32] = list.new()
        list.push(mut complete, 1u32)
        let rows = repair_board(mark)
        let mut groups: List[OwedGroup] = list.new()
        list.push(mut groups, fixture_owed_group(1u32, rows))
        let owed = Owe(session: 7u64, version: version, generations: take generations, complete: take complete, rows: take rows, groups: take groups, ended: list.new(), group_bytes: 0u64, frame_limit: 18446744073709551615u64, reset: false, read_failed: false)
        if let Error(_) = wire_update(mut owner, mut work, Update(version: version, content: Some(take owed), outcomes: list.new())) {
            delivered = false
        }
    }
    // The client's image: every `complete` naming sub 1 replaces it from empty.
    let mut image: Map[Bytes, Bytes] = map.new()
    let mut reset = false
    while let Some(take frame) = transport_receive(mut owner, mut work) {
        match take frame {
            Batch(_, take complete, take groups, _) => {
                let rows = publication_rows(take groups)
                if list.len(complete) == 1u64 && complete[0] == 1u32 {
                    image = map.new()
                }
                for take row in rows {
                    let SubRow(sub: _, key: take key, value: take value) = take row
                    if let Some(take v) = take value {
                        map.insert(mut image, take key, take v)
                    }
                }
            },
            _ => {
                reset = true
            },
        }
    }
    let mut exact = map.len(image) == REPAIR_KEYS
    for k in 0u64 .. REPAIR_KEYS {
        let mut key: Bytes = list.new()
        std.codec.put_u64(k, mut key)
        exact = exact && match map.get(image, key) {
            Some(v) => list.len(v) == REPAIR_VALUE && v[0] == repairs && v[REPAIR_VALUE - 1u64] == repairs,
            None => false,
        }
    }
    let _ = take requests
    delivered && !reset && !owner.reset_seen && exact
}

@test
fn test_repair_coalesced(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] {
    if law_repair_coalesced(tasks, clock, random) {
        Ok(())
    } else {
        Error(())
    }
}

fn held_quiet(from: Receiver[PubIn]) -> bool {
    match channel.try_receive(from) {
        Error(_) => true,
        _ => false
    }
}

// L28 (v2.19.2, remove_while_held): an owner removal (an Unsubscribed, a Subscribed that
// replaces a live sub, or the leave a Reset makes) reaches the publisher only while the
// writer holds no content unit. Otherwise the publisher forgets the read set the held unit
// was computed from, a later hit no longer fences it, and the writer releases it stale.
// Red on v2.19.1, which sent each removal at once.
pub fn law_removal_waits_for_writer(tasks: Tasks, c: Clock, r: Random) -> bool waits {
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, ..) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(8u64)
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    owner.publisher = Some(channel.sender(to))
    owner.joined = Some(1u64)
    owner.phase = 3u8
    list.reserve(mut owner.leaving, 1u64)
    owner.join_lease = Some(result.unwrap(WireJoinLease(closing: take closing, publisher: channel.sender(to))))
    wire_subscribed(mut owner, mut work, 8u32, SubscriptionInput(grants: None, room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    wire_subscribed(mut owner, mut work, 9u32, SubscriptionInput(grants: None, room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    let idle_sent = match (channel.try_receive(from), channel.try_receive(from)) {
        (Ok(PubIn(e: WireSubscribed(1u64, 8u32, _, _))), Ok(PubIn(e: WireSubscribed(1u64, 9u32, _, _)))) => true,
        _ => false,
    }
    // The writer holds a content unit. RUNNER-SPEC §3 "Subscription instances"
    // requires a fresh, strictly increasing id for a successor, and "The owner
    // asks for removal" posts deferred successors only after the removals.
    work.check = Some(4u64)
    let unsubscribed = match wire_step(mut owner, mut work, WClient(Unsubscribe(8u32), 0u64)) {
        Ok(_) => true,
        Error(_) => false
    }
    let successor_10: ServicePlan = PlannedSubscribe(10u32, SubscriptionInput(grants: None, room: None, key: query_key(code.describe(qf)), arg: no_arg(), caller: law_caller(1u64)))
    let successor = match wire_step(mut owner, mut work, WPrepared(box.new(take successor_10))) {
        Ok(_) => true,
        Error(_) => false
    }
    let held = successor && unsubscribed && held_quiet(from)
    let sent = match wire_step(mut owner, mut work, WSent) {
        Ok(_) => true,
        Error(_) => false
    }
    wire_flush_subscriptions(mut owner, mut work)
    let flushed = sent && match (channel.try_receive(from), channel.try_receive(from)) {
        (Ok(PubIn(e: Unsubscribed(1u64, 8u32))), Ok(PubIn(e: WireSubscribed(1u64, 10u32, _, _)))) => true,
        _ => false,
    } && held_quiet(from)
    // A Reset made while the writer holds a unit keeps the session joined until it is sent.
    work.check = Some(5u64)
    let reset: ServicePlan = ResumeReset
    let reset_made = match wire_step(mut owner, mut work, WPrepared(box.new(take reset))) {
        Ok(_) => true,
        Error(_) => false
    }
    let lease_kept = reset_made && match channel.try_receive(closed) {
        Error(Empty) => true,
        _ => false
    } && held_quiet(from)
    let _ = wire_step(mut owner, mut work, WSent)
    wire_flush_subscriptions(mut owner, mut work)
    let left = match channel.try_receive(closed) {
        Ok(()) => true,
        _ => false
    }
    let _ = take requests
    idle_sent && held && flushed && lease_kept && left
}

@test
fn test_removal_waits_for_writer(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_removal_waits_for_writer(tasks, clock, random) {
        Ok(())
    } else {
        Error(())
    }
}

fn repair_offer(mut b: Board[(), Qh], mut joined: List[Joiner]) -> u64 waits {
    let mut owes: List[Owe] = list.new()
    repair(mut b, mut joined, mut owes)
    let mut offered = 0u64
    for o in owes {
        offered += list.len(o.complete)
    }
    let mut waiting: List[Replies] = list.new()
    let at = store.version(b.base)
    settle(mut b.subs, mut joined, mut waiting, take owes, at)
    offered
}

fn owner_takes(mut owner: WireSession[()], mut work: WireWork, inbox: Receiver[WireEvent]) -> bool {
    match channel.try_receive(inbox) {
        Ok(WireEvent(e: FromRunner(take notice))) => match wire_step(mut owner, mut work, WRunner(take notice)) {
            Ok(_) => true,
            Error(_) => false
        },
        _ => false,
    }
}

// L24 (v2.22, repair_one_unsent): a repair is sent only when the session holds no other repair
// `complete` the owner has not sent; until then the sub stays due. Session 7's sub 1 is due and
// its owner has drained, so the publisher hands it one repair. The owner takes it, but its
// writer has not sent it when the sub bounces again and the owner drains again: the publisher
// owes nothing, and the sub stays due. Once the writer sends the first repair, the owner wakes
// the publisher, and the next pass owes exactly one `complete` of sub 1. Red when the publisher
// repairs on the drain token alone (v2.20), which queues a second whole repair behind the first.
pub fn law_repair_one_unsent(tasks: Tasks, c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, result.unwrap(store.sized(Memory, 1074790400u64)))
    let h = result.unwrap(install_subs_data(mut db))
    let t: store.Table[u64, u64] = clone(h.t)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    let board_reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut bound_registry = take board_reg
    result.unwrap(bind_query_slots(mut bound_registry, h))
    let mut b = Board(r: take bound_registry, h: arc.new(take h), read_handle: result.unwrap(store.reader(db, 0u64)), reads: publisher_reads(), base: store.snapshot(db), newest: None, subs: subscriptions())
    let _ = at_base_generation(mut b, 7u64, 1u32, 1u64, SubscriptionInput(grants: None, room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, ..) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (to_owner, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let (to_pub, from_pub): (Sender[PubIn], Receiver[PubIn]) = channel.new(8u64)
    owner.me = Some(channel.sender(to_owner))
    owner.publisher = Some(take to_pub)
    owner.phase = 3u8
    owner.joined = Some(7u64)
    list.push(mut owner.subs, (1u32, 1u64))
    list.push(mut owner.pub_subs, 1u32)
    let zero = arc.new(Taken(n: 0u64))
    let root = latest.new(take zero)
    let register = latest.handle(root)
    owner.taken = Some(take root)
    let (token, progress): (Sender[()], Receiver[()]) = channel.new(1u64)
    let mut joined: List[Joiner] = list.new()
    list.push(mut joined, Joiner(grants: None, who: 7u64, to: take to_owner, closed: None, ended: list.new(), reset: false, read_failed: false, mark: None, identity: None, fence: None, due: false, progress: Some(take progress), progressed: false, taken: Some(take register), handed: 0u64, http_credit: None))
    // The first repair: due, and the owner drained.
    let _ = mark_due(mut b.subs, 7u64, 1u32)
    joined[0].due = true
    let _ = channel.try_send(token, ())
    let first = repair_offer(mut b, mut joined)
    let took = owner_takes(mut owner, mut work, inbox)
    // The sub bounces again and the owner drains again, while the first repair is unsent.
    let _ = mark_due(mut b.subs, 7u64, 1u32)
    joined[0].due = true
    let _ = channel.try_send(token, ())
    let held = repair_offer(mut b, mut joined) == 0u64 && joined[0].due
    // The writer sends the first repair; the owner wakes the publisher.
    let sent_complete = match wire_step(mut owner, mut work, WPoll(true)) {
        Ok(Some(Batch(_, complete, _, _))) => list.len(complete) == 1u64 && complete[0] == 1u32,
        _ => false,
    }
    let sent = sent_complete && match wire_step(mut owner, mut work, WSent) {
        Ok(_) => true,
        Error(_) => false
    }
    let woke = match channel.try_receive(from_pub) {
        Ok(PubIn(e: Drained)) => true,
        _ => false
    }
    let second = repair_offer(mut b, mut joined)
    let _ = take requests
    first == 1u64 && took && held && sent && woke && second == 1u64 && !joined[0].due
}

@test
fn test_repair_one_unsent(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_repair_one_unsent(tasks, clock, random) {
        Ok(())
    } else {
        Error(())
    }
}

type BurstDrain: send {
    from: Receiver[PubIn],
    back: Sender[Receiver[PubIn]]
}

// The publisher's side of a full PubIn: it takes the message that filled the inbox, then hands
// the inbox back to the law.
fn burst_drain(take d: BurstDrain) -> Result[(), ()] waits {
    let BurstDrain(from: take from, back: take back) = take d
    let _ = channel.receive(from)
    let _ = channel.send(back, take from)
    Ok(())
}

// L23 (v2.22, join_waits): a Subscribe that makes its owner join is not refused because PubIn
// is full while the place is not overloaded. Its Join waits in PubIn like `connect`'s, and it
// carries that first Subscribe, so a PubIn that fills again before the Admit arrives refuses
// nothing either. The owner answers `Refused(Overloaded)` to neither, and sub 1 is live at the
// generation its Join named. Red when the owner `try_send`s its Join (v2.12 item 3), and when
// it sends the first Subscribe as its own `WireSubscribed` after the Admit.
pub fn law_join_waits(tasks: Tasks, c: Clock, r: Random) -> bool waits {
    let (head, requests): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let service: Service[WireSession[()]] = wire_service_seed(r, no_wire(), head, c, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take initial, ..) = take service
    let mut owner = take initial
    let mut work = wire_work()
    let (to_owner, _inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let (to_pub, from_pub): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    let (back_to, back): (Sender[Receiver[PubIn]], Receiver[Receiver[PubIn]]) = channel.new(1u64)
    owner.me = Some(take to_owner)
    owner.publisher = Some(channel.sender(to_pub))
    owner.phase = 3u8
    // Another session's message fills PubIn.
    result.unwrap(channel.try_send(to_pub, PubIn(e: Drained)))
    let subscribe: ServicePlan = PlannedSubscribe(1u32, SubscriptionInput(grants: None, room: None, key: query_key(code.describe(q1)), arg: no_arg(), caller: law_caller(1u64)))
    let applied = match wire_step(mut owner, mut work, WPrepared(box.new(take subscribe))) {
        Ok(_) => true,
        Error(_) => false
    }
    let not_refused_full = wire_no_end(work.output)
    let draining = task.spawn(tasks, bytes 1048576u64, BurstDrain(from: take from_pub, back: take back_to), burst_drain)
    wire_join_send(mut work, to_pub)
    let inbox = match channel.receive(back) {
        Ok(take i) => take i,
        Error(_) => return false
    }
    let _ = task.join(take draining)
    let first: Option[JoinSubscribe] = None
    let mut carried = take first
    let mut told: Option[Sender[Admit]] = None
    if let Ok(PubIn(e: Joined(take j))) = channel.try_receive(inbox) {
        let Join(to: _, told: take answer, mark: _, closed: _, identity: _, fence: _, progress: _, taken: _, first: take sub, http_credit: _) = take j
        told = Some(take answer)
        carried = take sub
    }
    // PubIn fills again before the owner sees its Admit.
    result.unwrap(channel.try_send(to_pub, PubIn(e: Drained)))
    let round_at = arc.new(std.http.ReleaseRound(at: 0u64))
    let rounds = latest.new(take round_at)
    let mut admit_sent = false
    if let Some(take to) = take told {
        let admit = Admit(who: 7u64, round: latest.handle(rounds))
        admit_sent = match channel.try_send(to, take admit) {
            Ok(_) => true,
            _ => false
        }
    }
    let polled = match wire_step(mut owner, mut work, WPoll(false)) {
        Ok(_) => true,
        Error(_) => false
    }
    let not_refused = wire_no_end(work.output)
    let generation = match take carried {
        Some(take f) => if f.sub == 1u32 {
            f.generation
        } else {
            0u64
        },
        None => 0u64
    }
    let live = generation != 0u64 && match sub_generation(owner.subs, 1u32) {
        Some(g) => g == generation,
        None => false
    }
    let joined_seven = match owner.joined {
        Some(who) => who == 7u64,
        None => false
    }
    let _ = take requests
    applied && not_refused_full && admit_sent && polled && not_refused && live && joined_seven
}

fn wire_no_end(output: List[WireOutput]) -> bool {
    for o in output {
        if let Ended(_, _) = o.frame {
            return false
        }
    }
    true
}

@test
fn test_join_waits(tasks: Tasks, clock: Clock, random: Random) -> Result[(), ()] waits {
    if law_join_waits(tasks, clock, random) {
        Ok(())
    } else {
        Error(())
    }
}

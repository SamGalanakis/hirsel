const FIRST_INTENT: String = "[\"hirsel-intent-v1\",\"https://pkg.hirsel.ai\",\"publish\",\"github.com/acme\",\"0\",\"3fa0b782d93c5e3eb44c73c26e2ba180862253051ca63e3f6c003f121e43dee9\",[\"github.com/acme/pkg@1\",\"1.0.0\",\"fixture\",null,[[\"oidc\",\"https://token.actions.example\",\"owner/42\",\"123/.github/workflows/publish.yml@refs/heads/main\"]]]]"

const FIRST_ROW: String = "[[\"oidc\",\"https://token.actions.example\",\"owner/42\",\"123/.github/workflows/publish.yml@refs/heads/main\"],\"8abfb92d26c61e7fa79dc9c282152d3ec68ca8cfcba32aee8fbdc43957869fda\",\"947382c4ace4d1b181de39c243ae2be38e6e7c50824dafabdf88fb83ba0107ad\",null]"

const FIRST_EVIDENCE: String = "[\"https://token.actions.example\",\"https://api.github.com/orgs/acme\",[\"hirsel-enroll-v1\",\"https://pkg.hirsel.ai\",\"github.com/acme\",[[\"oidc\",\"https://token.actions.example\",\"owner/42\",\"123/.github/workflows/publish.yml@refs/heads/main\"]]]]"

fn one(take s: Subject) -> List[Subject] {
    let mut subjects: List[Subject] = list.new()
    list.push(mut subjects, take s)
    take subjects
}

fn ci_subject() -> Subject {
    Workload(string.from(ISSUER), string.from("owner/42"), string.from("123/.github/workflows/publish.yml@refs/heads/main"))
}

fn moved_subject() -> Subject {
    Workload(string.from(FORGE_TWO), string.from("repo/77"), string.from("77/.github/workflows/publish.yml@refs/heads/main"))
}

fn fixture_profile(issuer: String, document: String) -> Profile {
    let f = Forge(issuer: clone(issuer), jwks_url: cat(issuer, "/keys"), allow: std.jwt.allow(EdDsa), host: "github.com", org_api: "https://api.github.com", org_credential: None)
    result.unwrap(load_keys(f, document))
}

fn release(scope: String, generation: u64, root: String, description: String, take set: Option[List[Subject]]) -> Intent {
    let p = Publication(root: clone(root), identity: cat(scope, "/pkg@1"), version: "1.0.0", description: clone(description), source_commit: None, enrollment: take set)
    Intent(origin: string.from(ORIGIN), scope: clone(scope), generation: generation, action: Publish(take p))
}

fn denied[T](take value: Result[T, Refusal]) -> bool {
    match value {
        Error(_) => true,
        Ok(_) => false,
    }
}

fn require(ok: bool, why: String) {
    if !ok {
        fail(clone(why))
    }
}

fn decode_fixture(s: String) -> Bytes {
    option.unwrap(std.base64.decode(string.as_bytes(s)))
}

fn bind_org(p: Profile) -> Authority {
    let first = release(SCOPE, 0, ROOT_A, "fixture", Some(one(ci_subject())))
    let v = result.unwrap(verify_workload(first, ci_subject(), FIRST, p, 100))
    require(denied(confirm_document(first, v, "{}")), "a job cannot enroll its organization alone")
    let wrong_line = std.string.replace(ORG_DOCUMENT, "hirsel-enroll", "prefix hirsel-enroll")
    require(denied(confirm_document(first, v, wrong_line)), "delegation occupies a whole line")
    let bad_owner = std.string.replace(ORG_DOCUMENT, "42,", "43,")
    require(denied(confirm_document(first, v, bad_owner)), "org API and JWT must agree on the numeric owner")
    let evidence = result.unwrap(confirm_document(first, v, ORG_DOCUMENT))
    let admit = result.unwrap(authorize(ORIGIN, first, Unclaimed, v, Some(take evidence), None, 100))
    // These are the complete bytes for the immutable sidecars and the public auth log field.
    // Compare against independent wire fixtures, including ordinary SHA-256 of the whole compact token.
    require(admit.intent == FIRST_INTENT && admit.auth == FIRST_ROW && admit.enrollment_evidence == Some(string.from(FIRST_EVIDENCE)), "G13: only public evidence and token digest cross admission")
    require(std.string.find(admit.intent, 0, FIRST) == None && std.string.find(admit.auth, 0, FIRST) == None && std.string.find(FIRST_EVIDENCE, 0, FIRST) == None, "G13: a live bearer cannot occur in a durable write")
    option.unwrap(clone(admit.next_authority))
}

fn oidc_authority() {
    let p = fixture_profile(ISSUER, JWKS)
    let current = bind_org(p)
    let intent = release(SCOPE, 1, ROOT_A, "fixture", None)
    let v = result.unwrap(verify_workload(intent, ci_subject(), RENAME, p, 100))
    let state = Committed(clone(current))
    let admitted = result.unwrap(authorize(ORIGIN, intent, state, v, None, None, 100))
    require(admitted.intent == result.unwrap(intent_wire(intent)), "renamed org retains its original scope")
    let other = release(SCOPE, 1, ROOT_B, "fixture", None)
    require(denied(verify_workload(other, ci_subject(), RENAME, p, 100)), "a genuine A token refuses B")
    let changed = release(SCOPE, 1, ROOT_A, "changed", None)
    require(denied(verify_workload(changed, ci_subject(), RENAME, p, 100)), "metadata binds the token")
    let mut elsewhere: Intent = clone(intent)
    elsewhere.origin = string.from("https://registry.other")
    require(denied(verify_workload(elsewhere, ci_subject(), RENAME, p, 100)), "origin binds audience")
    require(denied(authorize("https://registry.other", intent, state, v, None, None, 100)), "receiver checks its configured origin")
    require(denied(verify_workload(intent, ci_subject(), BAD_ISSUER, p, 100)), "pinned issuer")
    require(denied(verify_workload(intent, ci_subject(), OTHER_REPO, p, 100)), "signed repository id binds workflow")
    require(denied(verify_workload(intent, ci_subject(), OTHER_FLOW, p, 100)), "exact workflow ref")
    require(denied(verify_workload(intent, ci_subject(), OTHER_OWNER, p, 100)), "a recycled login cannot replace numeric owner")
    require(denied(verify_workload(intent, ci_subject(), EXTRA_AUD, p, 100)), "single intent audience")
    require(denied(verify_workload(intent, ci_subject(), RENAME, p, 200)), "expiry boundary")
    let mut move_intent: Intent = clone(intent)
    move_intent.action = Rebind(one(moved_subject()))
    let mover = result.unwrap(verify_workload(move_intent, ci_subject(), MOVE, p, 100))
    let moved = result.unwrap(authorize(ORIGIN, move_intent, state, mover, None, None, 100))
    let next: Authority = option.unwrap(clone(moved.next_authority))
    require(next.scope == SCOPE && next.generation == 2 && list.len(next.subjects) == 1 && member(next.subjects, moved_subject()), "rebind replaces only subjects and increments generation")
    let new_state = Committed(take next)
    require(denied(authorize(ORIGIN, move_intent, new_state, mover, None, None, 100)), "replay of previous generation")
    let after = release(SCOPE, 2, ROOT_A, "fixture", None)
    let moved_profile = fixture_profile(FORGE_TWO, OTHER_JWKS)
    let proof = result.unwrap(verify_workload(after, moved_subject(), AFTER_MOVE, moved_profile, 100))
    let _ = result.unwrap(authorize(ORIGIN, after, new_state, proof, None, None, 100))
}

fn key_authority() {
    let key = decode_fixture(PUBLIC_KEY)
    let first = release(DOMAIN, 0, ROOT_A, "fixture", Some(one(SigningKey(clone(key)))))
    let v = result.unwrap(verify_key(first, key, decode_fixture(DOMAIN_SIG)))
    require(denied(authorize(ORIGIN, first, Unclaimed, v, None, None, 100)), "first-use signature still needs domain endorsement")
    require(denied(confirm_document(first, v, cat(DOMAIN_DOCUMENT, "\n"))), "well-known enrollment requires canonical bytes")
    let doc = result.unwrap(confirm_document(first, v, DOMAIN_DOCUMENT))
    let prior = Authority(scope: string.from(DOMAIN), generation: 0, subjects: one(ci_subject()))
    require(denied(authorize(ORIGIN, first, Reserved(take prior), v, None, None, 100)), "a new well-known key cannot replace a reservation")
    let accepted = result.unwrap(authorize(ORIGIN, first, Unclaimed, v, Some(take doc), None, 100))
    let current: Authority = option.unwrap(clone(accepted.next_authority))
    require(denied(authorize(ORIGIN, first, Committed(clone(current)), v, None, None, 100)), "a committed domain cannot be enrolled again")
    let status = Intent(origin: string.from(ORIGIN), scope: string.from(DOMAIN), generation: 1, action: ChangeStatus(string.from(ROOT_A), None, Retire(string.from("security"), string.from("broken"))))
    let proof = result.unwrap(verify_key(status, key, decode_fixture(STATUS_SIG)))
    let mut head = StatusHead(scope: string.from(DOMAIN), root: string.from(ROOT_A), previous_event: None)
    let state = Committed(take current)
    let row = result.unwrap(authorize(ORIGIN, status, state, proof, None, Some(clone(head)), 100))
    require(std.string.ends_with(row.auth, cat(cat(",null,", quoted(STATUS_SIG)), "]")), "direct Ed25519 proof carries only the public signature")
    head.previous_event = Some(string.from(ROOT_B))
    require(denied(authorize(ORIGIN, status, state, proof, None, Some(take head), 100)), "status predecessor replay")
}

@test
fn publisher_authority() -> Result[(), ()] {
    let empty_id = Intent(origin: string.from(ORIGIN), scope: string.from(DOMAIN), generation: 1, action: ChangeStatus(string.from(ROOT_A), None, Advise(string.new(), string.from(ROOT_B))))
    require(denied(intent_wire(empty_id)), "an advisory needs an OSV ID")
    oidc_authority()
    key_authority()
    Ok(())
}

@test
fn advisory_evidence() -> Result[(), ()] {
    let doc = "{\"affected\":[{\"package\":{\"ecosystem\":\"Hirsel\",\"name\":\"acme.dev/pkg\"},\"versions\":[\"1.2.3\"]}],\"id\":\"OSV-1\",\"modified\":\"2024-01-01T00:00:00Z\"}"
    require(result.unwrap(advisory(string.as_bytes(doc), "OSV-1", digest(doc), "acme.dev/pkg@1", "1.2.3")) == false, "listed release is covered")
    require(denied(advisory(string.as_bytes(doc), "OSV-1", digest(doc), "acme.dev/pkg@1", "1.2.4")), "unlisted release is outside the advisory")
    Ok(())
}

@test
fn organization_cache() -> Result[(), ()] {
    let public_headers = request_headers(None)
    require(list.len(public_headers) == 1 && public_headers[0].name == "User-Agent", "no credential on anonymous enrollment")
    let token = result.unwrap(secret.seal(clone(b"fixture-token"), "tls_send(api.github.com)"))
    let headers = request_headers(Some(take token))
    require(list.len(headers) == 2 && headers[1].name == "Authorization", "configured credential supplied to org API")
    if let Protected(prefix, _) = view headers[1].value {
        require(prefix == b"Bearer ", "protected credential uses bearer scheme")
    } else {
        fail("org credential must use protected HTTP serialization")
    }
    let mut rows: List[OrgDocument] = list.new()
    remember_org(mut rows, "forge-a", "acme", "doc-a", 100)
    require(cached_org(rows, "forge-a", "acme", 101) == Some(string.from("doc-a")), "reuse fresh org document")
    require(cached_org(rows, "forge-b", "acme", 101) == None && cached_org(rows, "forge-a", "other", 101) == None, "cache keys separate forges and tenants")
    require(cached_org(rows, "forge-a", "acme", 100 + ORG_TTL_NS) == None, "expired enrollment must be fetched again")
    for i in 0u64 .. ORG_CACHE_SIZE + 2 {
        remember_org(mut rows, "forge-a", decimal(i), "doc", 102)
    }
    require(list.len(rows) == ORG_CACHE_SIZE && cached_org(rows, "forge-a", "acme", 103) == None, "oldest entry evicted")
    require(rate_limited(429, false, false) && rate_limited(403, true, false) && rate_limited(403, false, true) && !rate_limited(403, false, false), "classify rate limits independently of access refusals")
    Ok(())
}

// rule: STORE-11
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"}}
// steps: 20000000
// Each transaction and query body runs under the store's energy budget
// (storage.md STORE-11 "Energy"). A body far under it commits. A body far over it
// ends Limit(Energy()) with nothing committed, and the store stays usable. So does
// a body that catches its own exhaustion with runner.apply and returns Ok: the
// store decides from the meter, not from what the body returned. A query far over
// the budget ends Limit(Energy()) too.
@serializable
type Spun = Short | Db(store.TxError)

// Sums 0..n and writes the low byte under `sum`.
fn spin(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[u64, Spun] {
  let mut sum: u64 = 0
  for i in 0u64..n {
    sum = int.wrapping_add(sum, i)
  }
  let mut v: List[u8] = []
  list.push(mut v, int.truncate(sum))
  store.tx_put(mut tx, b"sum", bytes.from_list(take v)) ? Db
  Ok(sum)
}

fn sums(c: u64, info: u64, n: u64) -> Result[u64, Spun] {
  let mut sum: u64 = 0
  for i in 0u64..n {
    sum = int.wrapping_add(sum, i)
  }
  Ok(sum)
}

// Writes, runs out inside runner.apply, catches it and returns Ok.
fn swallow(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[u64, Spun] {
  store.tx_put(mut tx, b"swallowed", b"yes") ? Db
  match runner.apply(sums, 0u64, 0u64, n) {
    Ok(_) => Ok(1),
    Error(_) => Ok(2),
  }
}

fn reads(tx: store.Tx, info: store.CallInfo, n: u64) -> Result[u64, Spun] {
  let mut sum: u64 = 0
  for i in 0u64..n {
    sum = int.wrapping_add(sum, i)
  }
  Ok(sum)
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let at = authority.floor(a)
  let mut config = store.default_config()
  config.energy = 100000
  let mut s = store.open(a, config) ? Store
  let under: Result[u64, store.TxFailure[Spun]] = store.transact(mut s, spin, 100u64)
  check(under == Ok(4950))?
  let first = store.snapshot(a, mut s, at) ? Store
  let over: Result[u64, store.TxFailure[Spun]] = store.transact(
    mut s,
    spin,
    1000000000000u64
  )
  check(over == Error(Limit(Energy())))?
  let caught: Result[u64, store.TxFailure[Spun]] = store.transact(
    mut s,
    swallow,
    1000000000000u64
  )
  check(caught == Error(Limit(Energy())))?
  // Neither run committed: the version and the rows are the far-under run's.
  let after = store.snapshot(a, mut s, at) ? Store
  check(store.version(a, after) == store.version(a, first))?
  check(store.get(after, b"swallowed") == None())?
  check(store.get(copy after, b"sum") == Some(b"\x56"))?
  // The store is usable after running out.
  let again: Result[u64, store.TxFailure[Spun]] = store.transact(mut s, spin, 10u64)
  check(again == Ok(45))?
  let read: Result[u64, store.TxFailure[Spun]] = store.query(copy after, reads, 10u64)
  check(read == Ok(45))?
  let far: Result[u64, store.TxFailure[Spun]] = store.query(
    take after,
    reads,
    1000000000000u64
  )
  check(far == Error(Limit(Energy())))?
  store.close(take s) ? Store
  Ok(())
}

fn call_record_to_rep(take value: CallRecord) -> format.CallRecordRep {
    let CallRecord(key: take key, args: take args, stream: take stream, revision: take revision, code: take code) = take value
    format.CallRecordRep(key: take key, args: take args, stream: stream_key_to_rep(take stream), revision: take revision, code: take code)
}

fn call_record_from_rep(take value: format.CallRecordRep) -> CallRecord {
    let format.CallRecordRep(key: take key, args: take args, stream: take stream, revision: take revision, code: take code) = take value
    CallRecord(key: take key, args: take args, stream: stream_key_from_rep(take stream), revision: take revision, code: take code)
}


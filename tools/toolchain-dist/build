#!/usr/bin/env python3
"""Build an isolated distribution bundle, optionally from pinned PGO and BOLT profiles.

    tools/toolchain-dist/build --train-profile DIR [--llvm-profdata /path/to/llvm-profdata]
    tools/toolchain-dist/build --output /tmp/dist [--pgo DIR/<sha256>.profdata [--bolt DIR/<sha256>.fdata]]
    tools/toolchain-dist/build --host aarch64-apple-darwin --output /tmp/dist --runtime-archives DIR [--work DIR]

Both bundle builds and profile training require RELEASE_TAG. For an unpublished
build, set RELEASE_TAG=v0.0.0-local.

Training counts differ from run to run, so a release never trains: it takes a
PGO profile and a BOLT profile, each trained once and named by its SHA-256, and
refuses one whose bytes do not match its name. `--train-profile` writes both;
the BOLT profile is trained on the PGO-use compiler built from the PGO profile
beside it, the only binary it is valid for. Uses Buck2's remote pool, except
`--host aarch64-apple-darwin`, which builds on an Apple Silicon Mac with Cargo
and packages runtime archives from a Linux bundle (`product.py export-runtimes`). Training
uses one tools/capped command at a time. Keep output and work outside the
repository; profiles are never committed.
"""
import argparse
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import struct
import subprocess
import sys
import tempfile

import notices
from product import load, prebuilt_runtimes, runtime_flavour, runtime_slots

ROOT = Path(__file__).resolve().parents[2]
BUCK = ROOT / '.buck2/bin/buck2'
PROFILE = Path(__file__).with_name('profile.profdata')
BOLT_COMPILER = Path(__file__).with_name('hirsel.bolt')
COMPILER_TARGET = '//:hirsel-core-driver-bin-hirsel'
RUNTIME_TARGET = '//:hirsel-core-rt-archives'
PRODUCT = load()
LINUX_LLVM = PRODUCT['hosts']['x86_64-unknown-linux-gnu']['llvm_library']


def check_glibc(prefix):
    installer = (ROOT / 'tools/toolchain-dist/install.sh.in').read_text()
    (floor,) = re.findall(r'^glibc_floor=(\d+\.\d+)$', installer, re.M)
    ceiling = (*map(int, floor.split('.')), 0)
    required = {'hirsel', LINUX_LLVM, 'bin/ld.lld'}
    seen = set()
    failures = []
    elfs = []
    for path in sorted(prefix.rglob('*')):
        if not path.is_file():
            continue
        with path.open('rb') as candidate:
            if candidate.read(4) == b'\x7fELF':
                elfs.append((path.relative_to(prefix).as_posix(), path))
    env = dict(os.environ, LC_ALL='C')

    def read_versions(item):
        relative, path = item
        versions = subprocess.check_output(
            ['readelf', '--wide', '--version-info', path], env=env, text=True,
        ).partition('Version needs section')[2]
        return relative, set(re.findall(r'\bName: (GLIBC_\S+)', versions))

    workers = min(8, os.cpu_count() or 1)
    with ThreadPoolExecutor(max_workers=workers) as pool:
        inspected = list(pool.map(read_versions, elfs))
    for relative, names in inspected:
        seen.add(relative)
        highest = (0, 0, 0)
        for name in sorted(names):
            if name == 'GLIBC_ABI_DT_RELR':
                version = (2, 36, 0)
            elif match := re.fullmatch(r'GLIBC_(\d+)\.(\d+)(?:\.(\d+))?', name):
                version = tuple(int(part or 0) for part in match.groups())
            else:
                failures.append(f'{relative} requires unknown version {name}')
                continue
            highest = max(highest, version)
            if version > ceiling:
                failures.append(f'{relative} requires {name}, newer than glibc {floor}')
        if relative in required or highest != (0, 0, 0):
            version = '.'.join(map(str, highest if highest[2] else highest[:2]))
            print(f'dist: {relative} requires glibc {version}' if highest != (0, 0, 0) else
                  f'dist: {relative} has no dynamic glibc requirements', flush=True)
    failures.extend(f'{path} is missing or is not ELF' for path in sorted(required - seen))
    if 'hirsel' in seen:
        # Only .dynsym reaches the loader. BOLT's --emit-relocs keeps a weak reference the
        # link left unresolved in .symtab, with no dynamic symbol or relocation behind it.
        symbols = subprocess.check_output(['readelf', '--wide', '--dyn-syms', prefix / 'hirsel'], text=True)
        for name in ('pidfd_spawnp', 'pidfd_getpid'):
            if re.search(rf'\bUND\s+{name}(?:@|\s|$)', symbols):
                failures.append(f'hirsel has an undefined {name} reference')
    if failures:
        raise SystemExit('\n'.join(failures))
    print(f'dist: glibc {floor} baseline passed', flush=True)


def build_targets(mode, options, *targets, bolt='off'):
    done = subprocess.run([str(BUCK), 'build', '--target-platforms', '//tools/buck2:dist',
                           *options, '-c', 'hirsel.dist_pgo=' + mode, '-c', 'hirsel.dist_bolt=' + bolt,
                           *targets, '--show-json-output'],
                          cwd=ROOT, stdout=subprocess.PIPE, text=True, check=True)
    outputs = json.loads(done.stdout)
    return [ROOT / outputs['root' + target] for target in targets]


def bolt(command, mode, options, work, *arguments):
    """Link the compiler for BOLT, keep that input as `work/bolt/hirsel` and run
    `bolt.py command INPUT RUNTIME *arguments`."""
    compiler, runtimes = build_targets(mode, options, COMPILER_TARGET, RUNTIME_TARGET, bolt='link')
    runtime = runtimes / 'x86_64-unknown-linux-gnu/libhirsel_core_rt.a'
    kept = work / 'bolt'
    if kept.exists():
        raise SystemExit(f'{kept} exists: use a fresh work directory')
    kept.mkdir(parents=True)
    shutil.copyfile(compiler, kept / 'hirsel')
    # A BOLT profile is valid only for this binary: training and every build
    # from that profile print the same digest.
    print(f'dist: BOLT input sha256 {sha256(kept / "hirsel")}', flush=True)
    jobs = min(4, len(os.sched_getaffinity(0)))
    subprocess.run([ROOT / 'tools/capped', sys.executable, ROOT / 'tools/native-toolchain/bolt.py',
                    command, compiler, runtime, *arguments], cwd=ROOT, check=True,
                   env=dict(os.environ, HIRSEL_JOBS=str(jobs), HIRSEL_MEMORY_LIMIT='8G'))


def build(mode, output, options, work, *, fdata=None):
    if fdata is not None:
        try:
            bolt('compiler', mode, options, work, BOLT_COMPILER, '--fdata', fdata)
            shutil.copyfile(BOLT_COMPILER, work / 'bolt/hirsel.bolt')
            (bundle,) = build_targets(mode, options, '//:hirsel-toolchain', bolt='use')
        finally:
            BOLT_COMPILER.unlink(missing_ok=True)
    else:
        (bundle,) = build_targets(mode, options, '//:hirsel-toolchain')
    shutil.copytree(bundle, output, dirs_exist_ok=True)


def sha256(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


RELOCATION_PROGRAM = r'''pub fn main(out: Stdout) -> Result[(), Exit] waits {
    let value = result.unwrap(std.int.parse_uint("2a", 16))
    let mut line = string.new()
    string.push_u64(mut line, value)
    string.push_char(mut line, '\n')
    result.unwrap(stdout.write(out, line))
    Ok(())
}
'''


def relocation_witness(compiler, work, env):
    """Build a program on each backend with `compiler` and run it; return the executables."""
    project = work / 'app'
    subprocess.run([compiler, 'new', project], cwd=work, env=env, check=True)
    (project / 'main.hirsel').write_text(RELOCATION_PROGRAM)
    # Hexadecimal 2a is 2 * 16 + 10 = 42. The program writes it in decimal with a newline.
    expected = b'42\n'
    executables = []
    for backend in ('cranelift', 'llvm'):
        executable = work / backend
        subprocess.run([compiler, 'build', project, '--backend', backend,
                        '--grant', 'Stdout', '-o', executable],
                       cwd=work, env=env, check=True)
        actual = subprocess.check_output([executable], cwd=work, env=env)
        if actual != expected:
            raise ValueError(f'{backend} relocation witness wrote {actual!r}, expected {expected!r}')
        print(f'dist: {backend} relocation witness passed', flush=True)
        executables.append(executable)
    return executables


def witness(output):
    try:
        with (tempfile.TemporaryDirectory(prefix='hirsel-prefix-', dir=output.parent) as prefix,
              tempfile.TemporaryDirectory(prefix='hirsel-witness-', dir=output.parent) as scratch):
            moved, work = Path(prefix), Path(scratch)
            output.rename(moved)
            # Native builds can cache new std objects beside the shipped ones.
            packages = moved / 'core-packages'
            shipped = work / 'core-packages'
            packages.rename(shipped)
            shutil.copytree(shipped, packages)
            env = dict(PATH=os.defpath, HOME=scratch, TMPDIR=scratch, HIRSEL_JOBS='1')
            relocation_witness(moved / 'hirsel', work, env)
            shutil.rmtree(packages)
            shipped.rename(packages)
            moved.rename(output)
    except BaseException:
        if output.exists():
            shutil.rmtree(output)
        raise


def fresh_witness(prefix):
    """Run the installed CLI in an empty root with a read-only prefix."""
    targets = [triple for triple, row in PRODUCT['runtime_targets'].items() if 'platform' in row]

    relocated = '/opt/relocated-hirsel'
    sandbox = ['bwrap', '--unshare-all', '--die-with-parent',
               '--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp',
               '--dir', '/work', '--chdir', '/work',
               '--ro-bind', '/bin/sh', '/bin/sh', '--ro-bind', str(prefix), relocated,
               '--setenv', 'PATH', relocated,
               '--setenv', 'HOME', '/work', '--setenv', 'XDG_CACHE_HOME', '/work/cache']
    # Seed only the shared libraries that let the shell and compiler start.
    # In particular, the first root has no development files or linker scripts.
    libraries = set()
    for executable in (Path('/bin/sh'), prefix / 'hirsel', prefix / LINUX_LLVM):
        dependencies = subprocess.check_output(['ldd', executable], text=True)
        for line in dependencies.splitlines():
            match = re.match(r'\s*(?:\S+ => )?(/\S+) \(', line)
            if match and not Path(match[1]).is_relative_to(prefix):
                libraries.add(match[1])
    loader_files = [arg for path in sorted(libraries) for arg in ('--ro-bind', path, path)]
    cross_main = '''pub fn main() -> Result[(), Exit] {
    if result.unwrap(std.int.parse_uint("2a", 16)) == 42 {
        Ok(())
    } else {
        Error(Exit(status: 1))
    }
}
'''
    with tempfile.TemporaryDirectory(prefix='hirsel-cross-') as output:
        passed = subprocess.run([*sandbox, *loader_files, '--bind', output, '/out', '--', '/bin/sh', '-c',
                                 f'{FRESH_SEQUENCE} && '
                                 f"printf '%s' {shlex.quote(cross_main)} > main.hirsel && "
                                 'hirsel build --target aarch64-apple-darwin -o /out/program-darwin'],
                                capture_output=True, text=True, env={})
        accept_fresh(passed, prefix, targets)
        with (Path(output) / 'program-darwin').open('rb') as image:
            # mach_header_64: MH_MAGIC_64, CPU_TYPE_ARM64, cpusubtype, MH_EXECUTE.
            header = image.read(16)
        if len(header) != 16 or struct.unpack('<II4xI', header) != (0xfeedfacf, 0x0100000c, 2):
            raise ValueError('fresh root Darwin build did not produce an arm64 Mach-O executable')
    print('dist: fresh-root arm64 Mach-O build passed', flush=True)


# The fresh-machine sequence, run in an empty root on each host.
FRESH_SEQUENCE = ('hirsel --version && hirsel inspect --std --interface && '
                  'hirsel new demo && cd demo && hirsel test && hirsel run && hirsel build && '
                  './program && hirsel check')


def accept_fresh(passed, prefix, targets):
    """Check a fresh-machine run of FRESH_SEQUENCE against the bundle's registration,
    which must hold every runtime flavour for exactly `targets`."""
    if passed.returncode or passed.stderr or 'pass executed app@1/tests/test_twice' not in passed.stdout:
        raise ValueError(f'fresh root acceptance failed ({passed.returncode})\n'
                         f'{passed.stdout}{passed.stderr}')
    registration = json.loads((prefix / 'hirsel-core-toolchain.json').read_text())
    observation_labels = {'none': '', 'prof': 'profiling ', 'observed': 'charge observation '}
    slots = {}
    for slot, config in PRODUCT['runtime_slots'].items():
        if 'buck_suffix' not in config:
            continue
        flavour = runtime_flavour(config)
        if other := slots.get(flavour):
            raise ValueError(f'{slot} and {other} declare the same runtime flavour {flavour}')
        slots[flavour] = slot
    rows = registration['runtimes']
    expected = {(target, *runtime_flavour(config))
                for target in targets for config in runtime_slots(PRODUCT, target).values()}
    registered = {(row['target'], row['observation'], row['record'], row['embedded']) for row in rows}
    if registered != expected:
        raise ValueError(f'runtime target/flavour mismatch: missing {sorted(expected - registered)}, '
                         f'extra {sorted(registered - expected)}')
    labels = {
        (observation, record, embedded): ('embed runtime' if embedded else
            f"{observation_labels[observation]}{'recording ' if record else ''}runtime")
        for observation, record, embedded in slots
    }
    for row in rows:
        if not (prefix / row['path']).is_file():
            raise ValueError(f"registered runtime is missing: {row['path']}")
    helpers = registration['exec_helpers']
    desktop = {target for target in targets if PRODUCT['runtime_targets'][target].get('exec_helper')}
    if set(helpers) != desktop:
        raise ValueError(f'Exec helper target mismatch: missing {sorted(desktop - helpers.keys())}, '
                         f'extra {sorted(helpers.keys() - desktop)}')
    for target, relative in helpers.items():
        if (not re.fullmatch(rf'runtime/{re.escape(target)}/[0-9a-f]{{64}}/hirsel-exec-helper', relative)
                or not (prefix / relative).is_file() or not os.access(prefix / relative, os.X_OK)):
            raise ValueError(f'registered Exec helper is missing or invalid: {relative}')
    runtimes = {
        f"{labels[row['observation'], row['record'], row['embedded']]} {row['target']} {Path(row['path']).parent.name}"
        for row in rows
    }
    lines = passed.stdout.splitlines()
    if not any(line.startswith('std@1/sim/fs/serve\t') for line in lines):
        raise ValueError('fresh root std interface omitted the public sim.fs.serve declaration')
    runtime_prefixes = tuple(f'{name} ' for name in labels.values())
    reported = {line for line in lines if line.startswith(runtime_prefixes)}
    if (not re.fullmatch(r'hirsel \d+\.\d+\.\d+\S*', lines[0])
            or not re.fullmatch(r'compiler [0-9a-f]{64}', lines[1])
            or reported != runtimes):
        raise ValueError(f'fresh root reported unexpected version identities\n{passed.stdout}')
    print(passed.stdout + passed.stderr, end='', flush=True)
    print('dist: fresh-root acceptance passed', flush=True)


def pinned_profile(path, suffix):
    """The profile's bytes must hash to its name, `<sha256><suffix>`."""
    stem = path.name.removesuffix(suffix)
    if not re.fullmatch(r'[0-9a-f]{64}', stem) or path.suffix != suffix:
        raise SystemExit(f'{path}: a pinned profile is named <sha256>{suffix}')
    if (actual := sha256(path)) != stem:
        raise SystemExit(f'{path}: bytes hash to {actual}, not the pinned {stem}')
    return path


def pin(path, output, suffix):
    pinned = output / (sha256(path) + suffix)
    shutil.copyfile(path, pinned)
    print(pinned, flush=True)


def build_training_prefix(output, options, work, jobs):
    """Install only the x86_64 host compiler, core, and std needed by tools/toolchain-dist/train."""
    compiler, runtimes, kit = build_targets(
        'generate', options, COMPILER_TARGET, RUNTIME_TARGET, '//tools/buck2/native-toolchain:kit')
    runtime = runtimes / 'x86_64-unknown-linux-gnu/libhirsel_core_rt.a'
    scratch = work / 'train-install'
    if scratch.exists():
        shutil.rmtree(scratch)
    scratch.mkdir(parents=True)
    # Keep profile counters from prefix setup out of the training raw directory and checkout.
    install_env = dict(os.environ, TMPDIR=str(scratch), XDG_CACHE_HOME=str(scratch / 'cache'),
                       HIRSEL_JOBS=str(jobs), HIRSEL_MEMORY_LIMIT='6G',
                       LLVM_PROFILE_FILE=str(scratch / 'install-%m-%p.profraw'))
    output.mkdir(parents=True, exist_ok=True)
    try:
        subprocess.run([compiler, 'core-product', '--install', output],
                       cwd=ROOT, env=install_env, stdout=subprocess.DEVNULL, check=True)
        subprocess.run([compiler, 'std-product', '--install', output,
                        '--link-kit', kit, '--target', 'x86_64-unknown-linux-gnu', '--runtime', runtime],
                       cwd=ROOT, env=install_env, stdout=subprocess.DEVNULL, check=True)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def train(output, work, options, cpu, profdata, jobs):
    """Train both profiles once: write `output/<sha256>.profdata`, then build the
    PGO-use compiler from it, train BOLT on that binary and write
    `output/<sha256>.fdata`."""
    if profdata is None:
        profdata = subprocess.check_output([str(ROOT / 'tools/toolchain-dist/profile-tools')], text=True).strip()
    work.mkdir(parents=True, exist_ok=True)
    instrumented = work / 'instrumented'
    raw = work / 'raw'
    if raw.exists():
        raise SystemExit(f'{raw} exists: use a fresh work directory to avoid stale profiles')
    build_training_prefix(instrumented, options, work, jobs)
    subprocess.run([str(ROOT / 'tools/toolchain-dist/train'), '--toolchain', str(instrumented),
                    '--work', str(work / 'corpus'), '--raw', str(raw), '--cpu', str(cpu)], cwd=ROOT, check=True)
    profiles = sorted(raw.glob('*.profraw'))
    if not profiles or any(p.stat().st_size == 0 for p in profiles):
        raise SystemExit('training left an empty or missing raw profile')
    merged = work / 'merged.profdata'
    subprocess.run([str(ROOT / 'tools/capped'), profdata, 'merge',
                    '-o', str(merged), *map(str, profiles)],
                   env=dict(os.environ, HIRSEL_JOBS='1'), check=True)
    subprocess.run([profdata, 'show', str(merged)], check=True)
    output.mkdir(parents=True, exist_ok=True)
    pin(merged, output, '.profdata')
    shutil.copyfile(merged, PROFILE)
    fdata = work / 'merged.fdata'
    bolt('compiler-profile', 'use', options, work, fdata)
    pin(fdata, output, '.fdata')


def manifest(output, mode, fdata, *, darwin_llvm=None):
    try:
        if darwin_llvm is None:
            notices.collect(output, mode)
        else:
            notices.collect_darwin(output, darwin_llvm)
    except Exception:
        shutil.rmtree(output)
        raise
    def command(*args):
        return subprocess.check_output(args, cwd=ROOT, text=True).strip()
    digest = notices.sha256
    rustc = str(ROOT / 'tools/buck2/toolchains/rust-files/bin/rustc') if darwin_llvm is None else 'rustc'
    record = dict(commit=command('git', 'rev-parse', 'HEAD'),
                  patch_sha256=hashlib.sha256(command('git', 'diff', 'HEAD').encode()).hexdigest(),
                  rustc=command(rustc, '-vV'),
                  profile='dist', pgo=mode, lto='fat', codegen_units=1,
                  training='hirsel new project: check, Cranelift, LLVM' if darwin_llvm is None else None,
                  hirsel_sha256=digest(output / 'hirsel'),
                  core_packages_sha256=hashlib.sha256(json.dumps({str(p.relative_to(output / 'core-packages')): digest(p) for p in sorted((output / 'core-packages').rglob('*')) if p.is_file()}, sort_keys=True, separators=(',', ':')).encode()).hexdigest(),
                  notices_sha256=digest(output / 'notices/manifest.json'))
    if mode == 'use':
        record['profdata_sha256'] = digest(output / 'hirsel.profdata')
    record['fdata_sha256'] = digest(fdata) if fdata else None
    (output / 'hirsel-build.json').write_text(json.dumps(record, indent=2) + '\n')


@contextmanager
def profile_lock():
    # serialize pipeline writers in this checkout; each lane has its own file.
    lock = ROOT / '.buck2/dist-pgo.lock'
    with lock.open('w') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def main():
    import darwin_host
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument('--output', type=Path)
    action.add_argument('--train-profile', type=Path, metavar='DIR',
                        help='train once and write DIR/<sha256>.profdata for --pgo')
    action.add_argument('--check-fresh', type=Path, metavar='PREFIX',
                        help='check the glibc floor and fresh-machine behavior (requires readelf and bwrap)')
    action.add_argument('--check-glibc', type=Path, metavar='PREFIX',
                        help='check the glibc floor on an existing bundle (requires readelf)')
    parser.add_argument('--host', choices=[darwin_host.TARGET],
                        help='build or check natively on this host instead of with Buck2 on Linux')
    parser.add_argument('--runtime-archives', type=Path, metavar='DIR',
                        help='for a Darwin build, use archives exported on Linux with product.py export-runtimes')
    parser.add_argument('--work', type=Path)
    parser.add_argument('--pgo', type=Path, metavar='PROFILE',
                        help='use this pinned profile, named <sha256>.profdata (from --train-profile)')
    parser.add_argument('--bolt', type=Path, metavar='FDATA',
                        help='rewrite the compiler with llvm-bolt from this pinned profile, named <sha256>.fdata '
                             '(from --train-profile, beside the --pgo profile)')
    parser.add_argument('--cpu', type=int, default=8)
    parser.add_argument('--local', action='store_true', help='build locally without the remote action cache')
    parser.add_argument('--num-threads', type=int, help='Buck2 execution threads')
    parser.add_argument('--llvm-profdata', help='llvm-profdata matching the pinned rustc, for --train-profile')
    args = parser.parse_args()
    if (args.bolt or args.pgo) and args.output is None:
        parser.error('--bolt and --pgo require --output')
    if args.bolt and not args.pgo:
        parser.error('--bolt requires --pgo: a BOLT profile is trained on the PGO-use compiler')
    if args.llvm_profdata and args.train_profile is None:
        parser.error('--llvm-profdata requires --train-profile')
    if args.runtime_archives is not None and (args.host is None or args.output is None):
        parser.error('--runtime-archives requires --host and --output')
    if args.output is not None or args.train_profile is not None:
        release_tag = os.environ.get('RELEASE_TAG', '').strip()
        if not release_tag.removeprefix('v').strip():
            parser.error('set RELEASE_TAG to the release tag or an explicit unpublished tag such as v0.0.0-local')
    if args.host is not None:
        if args.pgo or args.bolt or args.local or args.num_threads or args.train_profile or args.check_glibc:
            parser.error('--host takes --output with --runtime-archives, or --check-fresh, and optionally --work')
        def accept(passed, prefix):
            accept_fresh(passed, prefix, {darwin_host.TARGET})
        if args.check_fresh is not None:
            darwin_host.check(args.check_fresh.resolve(), FRESH_SEQUENCE, accept, relocation_witness)
            return
        if args.runtime_archives is None:
            parser.error('--host with --output requires --runtime-archives DIR (see product.py export-runtimes)')
        try:
            archives = prebuilt_runtimes(args.runtime_archives.resolve(), runtime_slots(PRODUCT, darwin_host.TARGET))
        except ValueError as error:
            parser.error(str(error))
        output = args.output.resolve()
        if output.exists() or output.is_relative_to(ROOT):
            parser.error('output must be a fresh directory outside the checkout')
        work = args.work.resolve() if args.work else output.with_name(output.name + '-work')
        llvm = darwin_host.build(output, work, release_tag, archives)
        manifest(output, 'off', None, darwin_llvm=llvm)
        darwin_host.check(output, FRESH_SEQUENCE, accept, relocation_witness)
        return
    if args.check_glibc is not None:
        check_glibc(args.check_glibc.resolve())
        return
    if args.check_fresh is not None:
        check_glibc(args.check_fresh.resolve())
        fresh_witness(args.check_fresh.resolve())
        return
    profile = pinned_profile(args.pgo.resolve(), '.profdata') if args.pgo else None
    fdata = pinned_profile(args.bolt.resolve(), '.fdata') if args.bolt else None
    output = (args.output or args.train_profile).resolve()
    if args.output is not None and output.exists():
        parser.error('output already exists; use a fresh directory')
    if output.is_relative_to(ROOT):
        parser.error('output must be outside the checkout')
    work = args.work.resolve() if args.work else output.with_name(output.name + '-work')
    prepare = ['python3', 'tools/buck2/prepare.py']
    options = ['-c', 'hirsel.release_version=' + release_tag.removeprefix('v')]
    if args.local:
        prepare.append('--local')
        options.append('--no-remote-cache')
    if args.num_threads is not None:
        options.extend(['--num-threads', str(args.num_threads)])
    bundle_jobs = 1
    if args.local and args.num_threads and args.num_threads > 1:
        bundle_jobs = min(args.num_threads, len(os.sched_getaffinity(0)))
        if bundle_jobs > 1:
            options.extend(['-c', f'hirsel.dist_bundle_jobs={bundle_jobs}'])
    subprocess.run(prepare, cwd=ROOT, check=True)
    if args.train_profile is not None:
        with profile_lock():
            train(output, work, options, args.cpu, args.llvm_profdata, bundle_jobs)
        return
    if profile is None:
        build('off', output, options, work)
        manifest(output, 'off', None)
        witness(output)
        return
    with profile_lock():
        shutil.copyfile(profile, PROFILE)
        build('use', output, options, work, fdata=fdata)
        shutil.copyfile(profile, output / 'hirsel.profdata')
        manifest(output, 'use', fdata)
        witness(output)


if __name__ == '__main__':
    main()

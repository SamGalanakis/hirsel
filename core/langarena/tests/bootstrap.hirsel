// Bootstrap task: upstream Base64::Encode, size30,8192 iterations,1638 warmups.
// Own test module; slice F can adopt the encoder into base64.hirsel and add Decode.
fn encode(s:String)->Result[String,helper.Error] {
    let table="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let alphabet=string.as_bytes(table)
    let input_bytes=string.as_bytes(s)
    let n=list.len(input_bytes)
    let mut result=helper.mem(string.with_capacity(((n+2)/3)*4))?
    let mut i:u64=0
    while i<n {
        let a:u32=int.widen(input_bytes[i])
        let b:u32=if i+1<n {int.widen(input_bytes[i+1])} else {0}
        let c:u32=if i+2<n {int.widen(input_bytes[i+2])} else {0}
        let word=(a<<16u32)|(b<<8u32)|c
        for shift in 0u32 .. 4u32 {
            let digit=(word>>(18u32-shift*6u32))&63u32
            let code:u32=if shift==2 && i+1>=n || shift==3 && i+2>=n {61} else {int.widen(alphabet[int.widen(digit)])}
            helper.mem(string.push_char(mut result,option.unwrap(char.from_u32(code))))?
        }
        i+=3
    }
    Ok(take result)
}
pub fn dispatch(config:String,name:String,warmup:u64,iterations:u64)->Result[u32,helper.Error] {
    if name!="Base64::Encode" {return Error(UnknownTask)}
    let size=helper.config_i64(config,name,"size")?
    if size<0 {return Error(Config)}
    let mut data=helper.mem(string.with_capacity(int.narrow(size)))?
    for _ in 0 .. size {helper.mem(string.push(mut data,"a"))?}
    let mut encoded=encode(data)?
    let mut total:u32=0
    for _ in 0 .. warmup+iterations {
        encoded=encode(data)?
        total=int.wrapping_add(total,int.narrow(string.byte_len(encoded)))
    }
    let mut message=helper.mem(string.from("encode "))?
    if string.byte_len(data)>4 {
        helper.mem(string.push(mut message,string.slice(data,0,4)))?
        helper.mem(string.push(mut message,"..."))?
    } else {helper.mem(string.push(mut message,data))?}
    helper.mem(string.push(mut message," to "))?
    if string.byte_len(encoded)>4 {
        helper.mem(string.push(mut message,string.slice(encoded,0,4)))?
        helper.mem(string.push(mut message,"..."))?
    } else {helper.mem(string.push(mut message,encoded))?}
    helper.mem(string.push(mut message,": "))?
    helper.mem(string.push_u64(mut message,int.widen(total)))?
    Ok(helper.checksum_str(message))
}
pub fn main(out:Stdout,d:Dir,argv:Args)->Result[(),Exit] waits {
    harness.main(out,d,argv,fn(c:String,n:String,w:u64,i:u64)->Result[u32,helper.Error] { dispatch(c,n,w,i) })
}
pub fn helper_laws()->bool {
    let mut g=helper.lcg()
    if helper.next_int(mut g,100)!=37 || g.state!=52439 {return false}
    if helper.next_int(mut g,100)!=72 || g.state!=102040 {return false}
    if helper.next_int(mut g,100)!=63 || g.state!=89085 {return false}
    if helper.next_int(mut g,100)!=79 || g.state!=111062 {return false}
    helper.reset(mut g)
    if helper.next_int(mut g,100)!=37 {return false}
    helper.reset(mut g)
    if float.to_bits64(helper.next_float(mut g,139968.0))!=4677439974864322560u64 {return false}
    let cfg="{\"Probe\":{\"count\":-3,\"word\":\"hé\"}}"
    if result.unwrap(helper.config_i64(cfg,"Probe","count"))!=-3i64 {return false}
    if result.unwrap(helper.config_s(cfg,"Probe","word"))!="hé" {return false}
    if helper.checksum_str("")!=5381u32 || helper.checksum_str("a")!=177670u32 || helper.checksum_str("abc")!=193485963u32 {return false}
    // Hand-derived DJB2 of the exact seven-decimal strings, not formatter self-comparison.
    if result.unwrap(helper.checksum_f64(0.0))!=531151507u32 {return false}
    if result.unwrap(helper.checksum_f64(1.0))!=2485463956u32 {return false}
    if result.unwrap(helper.checksum_f64(-1.0))!=2375156481u32 {return false}
    if result.unwrap(helper.checksum_f64(1.25))!=969109563u32 {return false}
    let refused=bound bytes 0 {helper.checksum_f64(1.25)}
    match take refused {Ok(Error(Capacity(c)))=>c.available==0,_=>false}
}

// rule: STORE-11
// expect: reject STORE-11 at line 11
// twin: STORE/STORE-11-energy-run.hir
// A body cannot grant itself energy: only std@1's store opens an energy scope,
// one around each body it applies.
fn unbounded(mut tx: store.Tx, info: store.CallInfo, n: u64) -> Result[
  u64,
  store.TxError
] {
  let mut sum: u64 = 0
  let saved = energy.enter(18446744073709551615u64)
  for i in 0u64..n {
    sum = sum + i
  }
  let _ = energy.leave(take saved)
  Ok(sum)
}

pub fn main() -> () {}

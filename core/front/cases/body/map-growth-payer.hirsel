// MEM-26 charges both the first allocation and growth to the current bound.
// expect: run existing_payer() = true
// expect: run first_payer() = 12800 used 32
fn existing_payer() -> bool {
    let mut m: Map[u64, u64] = map.new()
    for i in 0u64 .. 4u64 {
        map.insert(mut m, i, i)
    }
    // try_reserve shares insert's growth charge and leaves m as it was when refused.
    let r: Result[bool, Capacity] = bound bytes 0 {
        match map.try_reserve(mut m, 1) {
            Error(c) => c.requested == 256 && c.available == 0,
            Ok(()) => false
        }
    }
    if !result.unwrap(r) || map.len(m) != 4 {
        return false
    }
    for i in 0u64 .. 4u64 {
        if option.unwrap(map.get(m, i)) != i {
            return false
        }
    }
    true
}

fn first_payer() -> u64 {
    let r = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 0 {
            let mut m: Map[u64, u64] = map.new()
            map.insert(mut m, 7, 11)
            0
        }
    })
    match caught(take r) {
        Some(c) => c.requested * 100 + c.available,
        None => 0
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

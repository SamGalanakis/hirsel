// expect: refuse MEM-17 at 18:39
@compact(u32) type RowS { name: Text, n: u64 }

type P: shareable { s: String }
fn freeze(r: Region, x: Text) -> Text in r { clone_in(r, x) }
fn inner(b: Box[Rc[P]]) -> P { clone(b) }
fn same(p: P) -> P { clone(p) }
fn wrong(x: u64) -> String { clone(x) }
fn dup(r: Region, b: SpanBuilder[u8, in r]) -> SpanBuilder[u8, in r] { clone(b) }
fn chain(c: Causes) -> Causes { clone(c) }
fn items[T](xs: List[T]) -> List[T] { clone(xs) }

fn convert(r: Region, x: String) -> Text in r { clone_in(r, x) }
fn wrong_region_type(r: Region, x: Text) -> RowS in r { clone_in(r, x) }

// Module platform, the deploy preview and its decision (launch.md "Deploy preview",
// "Self-editing" "Holds and decisions"): the hold of a request whose grant diff or prepare
// report awaits the operator, the Decide that ends it, and the entry and trigger parts of a
// deploy's preview.
fn same_grants(a: launcher.Grants, b: launcher.Grants) -> bool {
    a.added == b.added && a.dropped == b.dropped
}

// The decision a request awaits: its source tree's digest (None for an attested or
// publication input), the H its law gate ran against (None when ungated), and the facts
// computed so far.
fn decision_of(input: operator.Input, gate: Option[launcher.Green], stage: operator.DecisionStage, grants: launcher.Grants, triggers: runner.TriggerReport) -> operator.Decision {
    let root: Option[Bytes] = match gate {
        Some(green) => Some(clone(green.root)),
        None => None,
    }
    let tree: Option[Bytes] = match input {
        SourceInput(b) => Some(digest_of(b)),
        _ => None,
    }
    operator.Decision(tree: tree, root: root, stage: stage, grants: clone(grants), approvals: None, migration: None, triggers: clone(triggers))
}

// Request d waits for the operator's decision on grant diff `diff`, durably and with no
// attempt, so a restart or a lost connection keeps the hold (launch.md "Deploy preview").
fn hold(mut h: Host, d: Bytes, diff: launcher.Grants) waits {
    let made = {
        let t = view h.t
        let shown = view diff
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(t), store.copy_env(shown)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found) = st(store.fetch(tx, call_env.1 .requests, call_env.0))? else {
                return Ok(())
            }
            let mut row = found
            if let Done(_) = row.status {
                return Ok(())
            }
            row.status = Held(decision_of(row.input, row.gate, AdmissionStage, call_env.2, operator.no_triggers()))
            st(store.put(mut tx, call_env.1 .requests, call_env.0, row))?
            Ok(())
        })
    }
    if let Error(e) = decided(mut h, take made) {
        fail_request(mut h, d, class_of(e), refused_text(e))
    }
}

// Request d's deploy ended at prepare on a report that needs the operator (RUNNER-SPEC
// §14.6 "No default"): it holds on the Prepared-stage decision, in the transaction that
// ends the attempt, and stays the group's active request.
fn hold_prepared(mut tx: store.Tx, t: Tables, d: Bytes, preview: operator.Preview) -> Result[(), Refused] {
    let Some(found) = st(store.fetch(tx, t.requests, d))? else {
        return Ok(())
    }
    let mut row = found
    if let Done(_) = row.status {
        return Ok(())
    }
    row.status = Held(decision_of(row.input, row.gate, PreparedStage, preview.grants, preview.triggers))
    st(store.put(mut tx, t.requests, d, row))
}

// Whether a prepare report needs the operator's decision: a held run has no fate, a held
// entry path is unmatched, or the fates came from a Decide and the report holds a group
// that decision did not show (launch.md "Self-editing" F4).
fn needs_decision(h: Host, name: String, report: runner.TriggerReport) -> bool waits {
    if runner.trigger_report_unsettled(report) {
        return true
    }
    let Ok(Some(row)) = store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.deploys, name) else {
        return false
    }
    let Ok(Some(r)) = request_row(h, row.request) else {
        return true
    }
    if is_none(r.fates) {
        return false
    }
    for scanned in report.rows {
        if let Held = scanned.class {
            let mut shown = false
            for s in r.shown {
                if s.path == scanned.path && s.schema == scanned.schema && s.hold == scanned.hold {
                    shown = true
                    break
                }
            }
            if !shown {
                return true
            }
        }
    }
    false
}

// A Decide (launch.md "Self-editing" "Holds and decisions"): request d must await exactly
// `decision`. A refusal fails it Denied. An approval records the decision's grant diff, and
// when the decision shows a held group or an unmatched path its fates replace d's (and
// otherwise they must be `fate.none()`), then repeats d's admission under them, with a
// fresh attempt and deadline and `conn` as its owner; an admission or prepare that then
// needs another decision waits again.
fn decide(mut h: Host, conn: u64, d: Bytes, decision: operator.Decision, verdict: operator.Verdict, now: Now, mut out: List[launcher.Request]) waits {
    let r = match request_row(h, d) {
        Ok(Some(r)) => r,
        Ok(None) => {
            refuse(mut h, conn, UnknownRequestClass, "no request has this ID")
            return
        },
        Error(_) => {
            refuse(mut h, conn, StoreClass, "the catalog could not be read")
            return
        },
    }
    let waiting = match r.status {
        Held(x) => operator.decision_bytes(x) == operator.decision_bytes(decision),
        _ => false,
    }
    if !waiting {
        refuse(mut h, conn, DeniedClass, "the request awaits no decision on exactly these facts")
        return
    }
    let fates: runner.fate.Fates = match verdict {
        Approve(f) => clone(f),
        Refuse => {
            let _ = map.remove(mut h.shown, d)
            map.insert(mut h.owners, clone(d), conn)
            fail_request(mut h, d, DeniedClass, "the operator refused the decision")
            return
        },
    }
    let fated = operator.shows_held(decision)
    if !fated && (!is_none(fates.all) || list.len(fates.entries) > 0u64) {
        refuse(mut h, conn, InvalidClass, "the decision shows no held run, so it takes no fates")
        return
    }
    let _ = map.remove(mut h.shown, d)
    map.insert(mut h.owners, clone(d), conn)
    let name = string.from(r.group.name)
    let g = match group_row(h, name) {
        Ok(Some(g)) if g.incarnation == r.group.incarnation => g,
        _ => {
            fail_request(mut h, d, UnknownGroupClass, "the group was removed")
            return
        },
    }
    let Some((input, gate, foreign, exec)) = admission_ask(r.begin) else {
        fail_request(mut h, d, StoreClass, "the recorded request does not decode")
        return
    }
    if let Some((class, why)) = admission_refusal(h, name, g, d, input, foreign, exec) {
        let _ = map.remove(mut h.owners, d)
        refuse(mut h, conn, class, why)
        return
    }
    let mut shown: List[runner.TriggerScanRow] = list.new()
    for row in decision.triggers.rows {
        if let Held = row.class {
            list.push(mut shown, clone(row))
        }
    }
    let mut given: Option[runner.fate.Fates] = None
    if fated {
        given = Some(clone(fates))
    }
    let diff: launcher.Grants = clone(decision.grants)
    let made = {
        let t = view h.t
        let approved = view diff
        let gave = view given
        let saw = view shown
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(now), store.copy_env(t), store.copy_env(approved), store.copy_env(gave), store.copy_env(saw)), fn(mut tx, call_env) -> Result[launcher.Attempt, Refused] {
            let Some(found) = st(store.fetch(tx, call_env.2 .requests, call_env.0))? else {
                return Error(Missing("request"))
            }
            if let Some(x) = st(store.fetch(tx, call_env.2 .active, found.group.name))? {
                if x != call_env.0 {
                    return Error(Busy(0u64))
                }
            }
            let mut row = found
            let a = fresh_attempt(mut tx, call_env.2)?
            row.attempt = a
            row.deadline_ms = call_env.1 .wall_ms + ADMISSION_MS
            row.status = Open
            row.approved = clone(call_env.3)
            if let Some(f) = call_env.4 {
                row.fates = Some(clone(f))
                row.shown = clone(call_env.5)
            }
            st(store.put(mut tx, call_env.2 .requests, call_env.0, row))?
            Ok(a)
        })
    }
    let a = match decided(mut h, take made) {
        Ok(a) => a,
        Error(e) => {
            let _ = map.remove(mut h.owners, d)
            refuse(mut h, conn, class_of(e), refused_text(e))
            return
        },
    }
    open_input(mut h, name, g, d, a, input, gate, foreign, exec, diff, now, mut out)
}

// The group's unresolved deploy row, if it runs request d.
fn deploy_of(h: Host, name: String, d: Bytes) -> Option[DeployRow] waits {
    match store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.deploys, name) {
        Ok(Some(row)) if row.request == d => match row.outcome {
            Preparing => Some(clone(row)),
            Pending => Some(clone(row)),
            Undecided(_) => Some(clone(row)),
            _ => None,
        },
        _ => None,
    }
}

// Request d's phase as State reports it. An open request's phase comes from its live work.
fn phase_of(h: Host, d: Bytes, r: RequestRow) -> operator.Phase waits {
    match r.status {
        Done(p) => clone(p),
        Held(decision) => AwaitDecision(clone(decision)),
        Open => open_phase(h, r.group.name, d, r.attempt),
    }
}

fn open_phase(h: Host, name: String, d: Bytes, attempt: launcher.Attempt) -> operator.Phase waits {
    if let Some(row) = deploy_of(h, name, d) {
        return match row.outcome {
            Pending => PendingPhase(row.attempt, row.activation),
            Undecided(ProbeNew) => UndecidedPhase(row.attempt, row.activation, "reconciling: probing NEW"),
            Undecided(ProbeOld) => UndecidedPhase(row.attempt, row.activation, "reconciling: probing OLD"),
            _ => PreparingPhase(row.attempt),
        }
    }
    if let Some(adm) = admission_of(h, name, d) {
        return match adm.stage {
            Confirming(_) => AwaitConfirm(adm.attempt),
            Assembling => AssemblingPhase(adm.attempt),
            _ => if adm.ended {
                AdmittingPhase(adm.attempt)
            } else {
                AwaitInput(adm.attempt)
            },
        }
    }
    AwaitInput(attempt)
}

// The entry diff (launch.md "Deploy preview"): every entry OLD or NEW exports, by code
// identity, sorted by identity. An entry both export is changed when its `code.revision`
// differs; the revision covers everything the entry reaches, so a release that swaps one
// function shows as changed exactly the entries that reach it.
fn entry_diff(old: List[runner.Exported], new: List[runner.Exported]) -> List[operator.EntryLine] {
    let mut lines: List[operator.EntryLine] = list.new()
    for o in old {
        let mut change: operator.EntryChange = EntryRemoved
        for n in new {
            if n.described.identity == o.described.identity {
                change = if n.revision == o.revision {
                    EntryUnchanged
                } else {
                    EntryChanged
                }
                break
            }
        }
        list.push(mut lines, operator.EntryLine(identity: clone(o.described.identity), change: change))
    }
    for n in new {
        let mut known = false
        for o in old {
            if n.described.identity == o.described.identity {
                known = true
                break
            }
        }
        if !known {
            list.push(mut lines, operator.EntryLine(identity: clone(n.described.identity), change: EntryAdded))
        }
    }
    list.sort(mut lines, fn(a: operator.EntryLine, b: operator.EntryLine) -> Order {
        order.compare(a.identity, b.identity)
    })
    lines
}

// The prepare child's answer: its whole trigger report (launch.md "Preparing the pending
// trigger report").
fn trigger_report(b: Bytes) -> Option[runner.TriggerReport] {
    let codec: std.codec.Codec[runner.TriggerReport] = std.codec.of()
    match std.codec.decode(codec, b) {
        Ok(take report) => Some(take report),
        Error(_) => None,
    }
}

// The deploy's fates: those an approved decision gave, else the `held` field of its
// recorded Begin.
fn deploy_held(h: Host, d: Bytes) -> Result[runner.fate.Fates, Refused] waits {
    let Some(row) = request_row(h, d)? else {
        return Error(Missing("deploy request"))
    }
    if let Some(f) = row.fates {
        return Ok(clone(f))
    }
    let Some(BeginAsk(_, _, _, _, _, held)) = operator.decode_ask(row.begin) else {
        return Error(Missing("deploy Begin"))
    }
    Ok(clone(held))
}

// Read the contract from the original Begin, including after a grant decision or reconnect.
fn deploy_required_entries(h: Host, d: Bytes) -> Result[List[launcher.RequiredEntry], Refused] waits {
    let Some(row) = request_row(h, d)? else {
        return Error(Missing("deploy request"))
    }
    if let SourceInput(b) = row.input {
        let Some(m) = launcher.manifest_of(b) else {
            return Error(Missing("deploy source manifest"))
        }
        return Ok(clone(m.required_entries))
    }
    Ok(list.new())
}

// Keys include both codec fingerprints. The kind also has to match how the
// publisher calls or subscribes to the entry.
fn keeps_entries(required: List[launcher.RequiredEntry], exported: List[runner.Exported]) -> bool {
    if list.len(required) == 0u64 {
        return true
    }
    let mut keys: Map[Bytes, runner.Kind] = map.new()
    for e in exported {
        let mut key: Bytes = clone(e.described.identity)
        std.codec.put_u64(e.args_fp, mut key)
        std.codec.put_u64(e.result_fp, mut key)
        map.insert(mut keys, take key, e.described.kind)
    }
    for entry in required {
        let Some(kind) = map.get(keys, entry.key) else {
            return false
        }
        let actual: runner.Kind = clone(kind)
        if actual != entry.kind {
            return false
        }
    }
    true
}

// The new image's preview receives the old image's exported list.
fn old_entries(b: Bytes) -> Option[(Bytes, List[runner.Exported], Binding)] {
    let Some(take describe) = runner.decode_description(b) else {
        return None
    }
    let Some(take binding) = binding_of(describe) else {
        return None
    }
    let runner.Describe(exported: take exported, ..) = take describe
    let list_codec: std.codec.Codec[List[runner.Exported]] = std.codec.of_list()
    let mut raw: Bytes = list.new()
    if let Error(_) = std.codec.encode(list_codec, exported, mut raw) {
        return None
    }
    Some((take raw, take exported, take binding))
}

// The canonical Describe encoding is also the prefix of the Preview encoding.
fn previewed(b: Bytes, p: Prep, count: u64) -> Result[(Bytes, Bytes, List[runner.Exported]), String] {
    let codec: std.codec.Codec[runner.Preview] = std.codec.of()
    let Ok(runner.Preview(describe: take description, release: take release, answers: take answers)) = std.codec.decode(codec, b) else {
        return Error("preview: a malformed answer")
    }
    if description.digest != p.image || description.target != p.target || description.n_place != p.n_place {
        return Error("preview does not describe the selected assembly")
    }
    if list.len(description.revision) != 32u64 {
        return Error("preview: entry revision is unavailable")
    }
    if list.len(release) != 32u64 {
        return Error("preview: the release is not 32 bytes")
    }
    if list.len(answers) != count {
        return Error("preview answer count")
    }
    let describe_codec: std.codec.Codec[runner.Describe] = std.codec.of()
    let mut raw: Bytes = list.new()
    let _ = std.codec.encode(describe_codec, description, mut raw) ?=> |_| "preview: a malformed answer"
    let runner.Describe(exported: take exported, ..) = take description
    Ok((take raw, take release, take exported))
}

// The fates OLD's settlement check settles held rows by (RUNNER-SPEC §14.3 "Preparing"). A
// Fates that does not encode is sent empty, which OLD refuses.
fn fates_bytes(f: runner.fate.Fates) -> Bytes {
    match runner.fate.encode(f) {
        Some(take raw) => take raw,
        None => list.new(),
    }
}

// The migration fact OLD reported for the PREPARED it bound, with each changed catalog key
// named: a table key by its name, any other key in hex.
fn migration_of(m: runner.ImportedMigration) -> operator.Migration {
    let mut changes: List[String] = list.new()
    for key in m.changes {
        let mut named: Option[String] = None
        if list.len(key) > 1u64 && key[0] == 1u8 {
            if let Ok(take name) = string.from_utf8(clone(list.slice(key, 1u64, list.len(key)))) {
                named = Some(take name)
            }
        }
        match take named {
            Some(take name) => list.push(mut changes, take name),
            None => list.push(mut changes, std.hex.encode(key)),
        }
    }
    operator.Migration(digest: clone(m.digest), changes: take changes)
}

fn report_of(row: DeployRow, pause: operator.Pause) -> operator.Report {
    operator.Report(fetch_ns: row.fetch_ns, assemble_ns: row.assemble_ns, pause: clone(pause), preview: clone(row.preview))
}

fn same_attempt(a: launcher.Attempt, b: launcher.Attempt) -> bool {
    a.hi == b.hi && a.lo == b.lo
}

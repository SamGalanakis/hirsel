pub fn objects_cache(take a: Authority, d: Dir, capacity_bytes: u64) -> Authority {
    let cache = Some(pager.ObjectsCache(dir: d, capacity_bytes))
    match take a {
        ObjectAuthority(take settings) => {
            let mut config = take settings
            config.cache = cache
            ObjectAuthority(take config)
        },
        SimAuthority(take settings) => {
            let mut config = take settings
            config.cache = cache
            SimAuthority(take config)
        },
        LogAuthority(dir) => LogAuthority(dir),
    }
}

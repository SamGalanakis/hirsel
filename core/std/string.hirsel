// Module `string`, extended (LANG-7): library members of the core module `string` (SEM-3).
// The core members (new, from, from_utf8, into_bytes, as_bytes, slice, next_scalar,
// byte_len, push, push_char, push_u64, make_ascii_upper, make_ascii_lower) are declared in core/core/string.hirsel. Field
// legend, GROWTH and FREEZE: API.md, "Reading a contract".
//
// Representation: String is an opaque own type over a Bytes block: a 24-byte header
// inline, storage capacity x 1 byte rounded up to 8, charged to the limit where it was
// made (MEM-26); GROWTH as for lists. A literal is static, has capacity 0 and is never
// charged; its first growth copies it. Positions are byte offsets. Equality, order and
// hashing are bytewise (`==`, `<`); nothing normalises. A copy is `string.from` (or
// `clone`); there is no `string.copy`.
//
// Cutting: the functions below that return a `View[String] in s` are library code over
// `string.slice`, returning the sub-view the call gave for s (OWN-20); they allocate
// nothing and FREEZE s for the result's extent. Scalars are read with `next_scalar` in a
// `while let` loop; `for` iterates only built-in sources (SEM-6).
/// Whether i is a scalar boundary: i == byte_len, or i < byte_len and byte i is not a
/// continuation byte. Cost: O(1). Ex: `if !string.is_boundary(text, at) { return Error(BadPosition) }`
pub fn is_boundary(s: String, i: u64) -> bool {
    let n = string.byte_len(s)
    if i >= n {
        return i == n
    }
    let b = string.as_bytes(s)
    b[i] & 0xc0 != 0x80
}

/// Appends n in decimal, with '-' when negative. Fails: Error(c); s then holds a prefix
/// of the text (core has no `string.reserve` to make the append atomic).
/// Alloc: GROWTH, at most twice. Ex: `string.push_i64(mut s, -3)`
pub fn push_i64(mut s: String, n: i64) {
    // The magnitude in u64: two's complement negation of the same bits, exact for MIN.
    let bits: u64 = int.truncate(n)
    if n < 0 {
        string.push_char(mut s, '-')
        string.push_u64(mut s, int.wrapping_neg(bits))
    } else {
        string.push_u64(mut s, bits)
    }
}

/// Appends n in `base` (2 to 36, lower-case), left-padded with `pad` to at least `width`
/// scalars (Go strconv.AppendUint plus padding). Fails: Fail when base is outside
/// 2..=36; Error(c) when a growth is refused, s then holding a prefix of the text (no
/// `string.reserve`). Alloc: GROWTH per push_char. Cost: O(digits + width). Ex: `string.push_uint(mut out, 31, 16, 4, '0')` appends "001f"
pub fn push_uint(mut s: String, n: u64, base: u32, width: u64, pad: char) {
    if base < 2 || base > 36 {
        fail("string.push_uint: base outside 2..=36")
    }
    let mut digits: Inline[u8, 64] =[0; 64]
    let start = int.radix_digits(n, base, mut digits)
    let mut padded = 64 - start
    while padded < width {
        string.push_char(mut s, pad)
        padded += 1
    }
    for i in start .. 64 {
        let code: u32 = int.widen(digits[i])
        string.push_char(mut s, option.unwrap(char.from_u32(code)))
    }
}

/// s written n times into a new string of exactly byte_len(s) * n bytes (Rust str::repeat).
/// Fails: Error(c) when that storage or the block is refused; Fail when byte_len(s) * n
/// overflows u64. Alloc: byte_len(s) * n rounded to 8, plus a block of at most 256 bytes
/// while it runs, current limit. Cost: O(byte_len(s) * n).
/// Ex: `let rule = string.repeat("-", 40)`
pub fn repeat(s: String, n: u64) -> String {
    let len = string.byte_len(s)
    let total = match int.checked_mul(len, n) {
        Some(t) => t,
        None => fail("string.repeat: length overflows u64"),
    }
    let mut out = string.with_capacity(total)
    // Rust doubles inside its buffer; a String cannot append from itself, so a short s
    // is first gathered into a block of at most 256 bytes and the block is appended.
    let per: u64 = if len == 0 {
        0
    } else {
        256 / len
    }
    let mut k: u64 = 0
    if per >= 4 && n >= 2 * per {
        let mut block = string.with_capacity(per * len)
        for _ in 0 .. per {
            string.push(mut block, s)
        }
        while n - k >= per {
            string.push(mut out, block)
            k += per
        }
    }
    while k < n {
        string.push(mut out, s)
        k += 1
    }
    take out
}

/// Empties s; keeps an owned s's storage, and a static s (a literal) becomes the empty
/// static string, so clearing admits nothing (core truncate to 0). Alloc: nothing. Cost: O(1).
/// Ex: `string.clear(mut line)`
pub fn clear(mut s: String) {
    string.truncate(mut s, 0)
}

/// The first byte position at or after `start` where pat occurs, or None. An empty pat is
/// found at `start`. Fails: Bounds (failure) when start > byte_len (`list.slice`).
/// Alloc: nothing.
/// Cost: O(byte_len(s) - start + byte_len(pat)) worst case.
/// Ex: `let Some(colon) = string.find(line, 0, ":") else { return Error(Malformed) }`
pub fn find(s: String, start: u64, pat: String) -> Option[u64] {
    let n = string.byte_len(s)
    let hay = list.slice(string.as_bytes(s), start, n)
    let needle = string.as_bytes(pat)
    let m = list.len(needle)
    let rest = list.len(hay)
    if m > rest {
        return None
    }
    if m == 0 {
        return Some(start)
    }
    let first = needle[0]
    let last = m - 1
    let last_byte = needle[last]
    let mut from: u64 = 0
    let mut misses: u64 = 0
    while from <= rest - m {
        let Some(end) = list.find_byte(hay, from + last, rest, last_byte) else {
            return None
        }
        let at = end - last
        from = at + 1
        if hay[at] == first {
            if m <= 2 || list.starts_with_at(hay, at, needle) {
                return Some(start + at)
            }
            // Go's cutover on false hits, scaled by the cost of a full check.
            // Short needles have constant check cost. For longer ones, limit
            // failed checks to two upfront plus one per needle length scanned.
            if m > 8 {
                misses += 1
                if misses > 2 + at / m {
                    let Some(found) = find_two_way(hay, from, needle, m, rest - m) else {
                        return None
                    }
                    return Some(start + found)
                }
            }
        }
        // A sparse last byte is cheap to scan on its own. After two rejected
        // hits, check both endpoints together if there is a long span left.
        if m <= 8 {
            misses += 1
            if misses == 2 && rest - m - at >= 128 {
                return match find_short(hay, from, needle, m, rest - m - 31) {
                    Some(found) => Some(start + found),
                    None => None,
                }
            }
        }
    }
    None
}

// Filter 32 candidate starts at once. The last load in each pair ends at or
// before the end of hay, including when the final group overlaps the one before it.
fn find_short(hay: Bytes, from: u64, needle: Bytes, m: u64, last_group: u64) -> Option[u64] {
    let first: Simd[u8, 32] = simd.splat(needle[0])
    let last: Simd[u8, 32] = simd.splat(needle[m - 1])
    let mut at = from
    loop {
        let heads: Simd[u8, 32] = list.lanes(hay, at)
        let tails: Simd[u8, 32] = list.lanes(hay, at + m - 1)
        let mut matches = simd.bitmask(simd.eq(heads, first) & simd.eq(tails, last))
        while matches != 0 {
            let lane: u64 = int.widen(int.trailing_zeros(matches))
            let candidate = at + lane
            if m == 2 || list.starts_with_at(hay, candidate, needle) {
                return Some(candidate)
            }
            matches = matches & (matches - 1)
        }
        if at == last_group {
            return None
        }
        at += 32
        if at > last_group {
            at = last_group
        }
    }
}

// Crochemore-Perrin Two-Way search, using memchr's critical factorization.
fn find_two_way(hay: Bytes, from: u64, needle: Bytes, m: u64, last: u64) -> Option[u64] {
    let (min_cut, min_period) = extreme_suffix(needle, m, false)
    let (max_cut, max_period) = extreme_suffix(needle, m, true)
    let (cut, period) = if min_cut > max_cut {
        (min_cut, min_period)
    } else {
        (max_cut, max_period)
    }
    // The suffix period applies to the entire needle if it also repeats the
    // shorter left half. Only then can a shift retain a known matching prefix.
    let (shift, overlap) = if cut < m - cut && list.slice(needle, 0, cut) == list.slice(needle, period, period + cut) {
        (period, m - period)
    } else {
        (if cut > m - cut {
            cut
        } else {
            m - cut
        }, 0u64)
    }
    let mut known: u64 = 0
    let mut at = from
    while at <= last {
        let mut right = if cut > known {
            cut
        } else {
            known
        }
        while right < m && hay[at + right] == needle[right] {
            right += 1
        }
        if right < m {
            at += right - cut + 1
            known = 0
        } else {
            let mut left = cut
            while left > known && hay[at + left - 1] == needle[left - 1] {
                left -= 1
            }
            if left <= known {
                return Some(at)
            }
            at += shift
            known = overlap
        }
    }
    None
}

// Start and period of the lexicographically extreme suffix in either byte order.
fn extreme_suffix(needle: Bytes, m: u64, largest: bool) -> (u64, u64) {
    let mut suffix: u64 = 0
    let mut period: u64 = 1
    let mut candidate: u64 = 1
    let mut offset: u64 = 0
    while offset < m - candidate {
        let a = needle[suffix + offset]
        let b = needle[candidate + offset]
        if a == b {
            offset += 1
            if offset == period {
                candidate += period
                offset = 0
            }
        } else if (b > a) == largest {
            suffix = candidate
            period = 1
            candidate += 1
            offset = 0
        } else {
            candidate += offset + 1
            period = candidate - suffix
            offset = 0
        }
    }
    (suffix, period)
}

/// Whether s begins with p. Cost: O(len(p)). Ex: `string.starts_with(line, "GET ")`
pub fn starts_with(s: String, p: String) -> bool {
    list.starts_with(string.as_bytes(s), string.as_bytes(p))
}

/// Whether s ends with p. Cost: O(len(p)). Ex: `string.ends_with(name, ".json")`
pub fn ends_with(s: String, p: String) -> bool {
    let n = string.byte_len(s)
    let m = string.byte_len(p)
    m <= n && list.slice(string.as_bytes(s), n - m, n) == string.as_bytes(p)
}

/// The parts of s before and after the first occurrence of sep, or None when sep does not
/// occur (Rust str::split_once). An empty sep splits at 0. View: both anchored to s;
/// FREEZE s. Alloc: nothing. Cost: as find.
/// Ex: `let Some((key, value)) = string.split_once(line, ": ") else { return Error(NoColon) }`
pub fn split_once(s: String, sep: String) -> Option[(View[String], View[String])] in s {
    // A match of valid UTF-8 in valid UTF-8 starts and ends on scalar boundaries, so
    // neither slice can fail.
    let Some(at) = find(s, 0, sep) else {
        return None
    }
    let n = string.byte_len(s)
    Some((string.slice(s, 0, at), string.slice(s, at + string.byte_len(sep), n)))
}

/// The piece of s from at up to the next sep, and the cursor after that sep: the pieces of
/// Rust str::split(sep), one per call, starting from 0. A piece that runs to the end returns
/// cursor byte_len(s) + 1, after which the result is None, so a trailing sep yields a final
/// empty piece and "" yields one empty piece, as in Rust. Fails: Bounds when at exceeds
/// byte_len(s) + 1 or falls inside a scalar; Fail when sep is empty. View: anchored to s;
/// FREEZE s. Alloc: nothing. Cost: as find from at.
/// Ex: `while let Some((field, next)) = string.next_split(row, at, ",") { ...; at = next }`
pub fn next_split(s: String, at: u64, sep: String) -> Option[(View[String], u64)] in s {
    let n = string.byte_len(s)
    if at == n + 1 {
        return None
    }
    let m = string.byte_len(sep)
    if m == 0 {
        fail("string.next_split: the separator is empty")
    }
    match find(s, at, sep) {
        Some(i) => Some((string.slice(s, at, i), i + m)),
        None => Some((string.slice(s, at, n), n + 1)),
    }
}

/// The line of s from at, without its line ending, and the cursor after that ending: the
/// lines of Rust str::lines, one per call, starting from 0. A line ends at "\n" or "\r\n"; the
/// last line's ending is optional, so a final "\n" yields no empty line, and a lone "\r" stays
/// in its line. None when at is byte_len(s). Fails: Bounds when at exceeds byte_len(s) or
/// falls inside a scalar. View: anchored to s; FREEZE s. Alloc: nothing. Cost: as find from at.
/// Ex: `while let Some((line, next)) = string.next_line(text, at) { ...; at = next }`
pub fn next_line(s: String, at: u64) -> Option[(View[String], u64)] in s {
    let n = string.byte_len(s)
    if at == n {
        return None
    }
    let Some(i) = find(s, at, "\n") else {
        return Some((string.slice(s, at, n), n))
    }
    // A "\r" just before the "\n" belongs to the line ending.
    let b = string.as_bytes(s)
    if i > at && b[i - 1] == 0x0D {
        return Some((string.slice(s, at, i - 1), i + 1))
    }
    Some((string.slice(s, at, i), i + 1))
}

/// s without its leading p, or None when s does not begin with p (Rust strip_prefix).
/// View: anchored to s; FREEZE s. Alloc: nothing. Cost: O(len(p)).
/// Ex: `let Some(route) = string.strip_prefix(line, "GET ") else { return Error(NotGet) }`
pub fn strip_prefix(s: String, p: String) -> Option[View[String]] in s {
    if starts_with(s, p) {
        Some(string.slice(s, string.byte_len(p), string.byte_len(s)))
    } else {
        None
    }
}

/// s without its trailing p, or None when s does not end with p (Rust strip_suffix).
/// View: anchored to s; FREEZE s. Alloc: nothing. Cost: O(len(p)).
/// Ex: `let stem = match string.strip_suffix(name, ".json") { Some(t) => t, None => name }`
pub fn strip_suffix(s: String, p: String) -> Option[View[String]] in s {
    if ends_with(s, p) {
        Some(string.slice(s, 0, string.byte_len(s) - string.byte_len(p)))
    } else {
        None
    }
}

/// s without leading and trailing ASCII whitespace (space, \t, \n, \r, form feed), as
/// Rust trim_ascii; no other scalar is whitespace here. View: anchored to s; FREEZE s.
/// Alloc: nothing. Cost: O(whitespace trimmed). Ex: `let v = string.trim_ascii(value)`
pub fn trim_ascii(s: String) -> View[String] in s {
    let b = string.as_bytes(s)
    let mut lo: u64 = 0
    let mut hi = list.len(b)
    while lo < hi && is_ascii_space(b[lo]) {
        lo += 1
    }
    while hi > lo && is_ascii_space(b[hi - 1]) {
        hi -= 1
    }
    string.slice(s, lo, hi)
}

fn is_ascii_space(x: u8) -> bool {
    x == b' ' || x == b'\t' || x == b'\n' || x == b'\r' || x == 0x0c
}

type CaseMapping = CaseScalar(char) | CaseExpansion(u64, u64)

fn ascii_case(c: char, upper: bool) -> char {
    if upper {
        char.to_ascii_upper(c)
    } else {
        char.to_ascii_lower(c)
    }
}

fn unicode_case(c: char, upper: bool) -> CaseMapping {
    let code = char.to_u32(c)
    if code < 0x80 {
        return CaseScalar(ascii_case(c, upper))
    }
    // Expansion entries take precedence over simple runs.
    let (multi_first, multi_end) = if upper {
        (UPPER_MULTI_LO, UPPER_MULTI_HI)
    } else {
        (LOWER_MULTI_LO, LOWER_MULTI_HI)
    }
    let mut lo = multi_first
    let mut hi = multi_end
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let (key, span) = CASE_MULTI[mid]
        if code < key {
            hi = mid
        } else if code > key {
            lo = mid + 1
        } else {
            return CaseExpansion(int.widen(span >> 4), int.widen(span & 15))
        }
    }
    let (first, end) = if upper {
        (UPPER_RUN_LO, UPPER_RUN_HI)
    } else {
        (LOWER_RUN_LO, LOWER_RUN_HI)
    }
    lo = first
    hi = end
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let (run, _) = CASE_RUNS[mid]
        if code < run >> 11 {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    if lo == first {
        return CaseScalar(c)
    }
    let (run, delta) = CASE_RUNS[lo - 1]
    let offset = code - (run >> 11)
    let length = (run >> 1) & 1023
    let stride = (run & 1) + 1
    if offset % stride == 0 && offset / stride < length {
        let mapped = int.wrapping_add(code, int.truncate(delta))
        return CaseScalar(option.unwrap(char.from_u32(mapped)))
    }
    CaseScalar(c)
}

fn append_case(mut out: String, mapping: CaseMapping) {
    match mapping {
        CaseScalar(c) => string.push_char(mut out, c),
        CaseExpansion(start, width) => string.push(mut out, string.slice(CASE_EXPANSIONS, start, start + width)),
    }
}

/// Appends c's full Unicode uppercase mapping. Fails: Capacity, leaving out unchanged.
/// Alloc: GROWTH for the whole mapping, once. Cost: O(1) steps.
/// Ex: `string.push_upper(mut out, 'ß')` appends "SS".
pub fn push_upper(mut out: String, c: char) {
    append_case(mut out, unicode_case(c, true))
}

/// Appends c's full Unicode lowercase mapping. Fails: Capacity, leaving out unchanged.
/// Alloc: GROWTH for the whole mapping, once. Cost: O(1) steps.
/// Ex: `string.push_lower(mut out, 'İ')` appends "i\u{307}".
pub fn push_lower(mut out: String, c: char) {
    append_case(mut out, unicode_case(c, false))
}

fn convert_case(s: String, upper: bool) -> String {
    let input = string.as_bytes(s)
    let n = list.len(input)
    let mut ascii_end: u64 = 0
    while ascii_end < n && input[ascii_end] < 0x80 {
        ascii_end += 1
    }
    // Size before admitting storage. Each byte of input contributes at most three bytes.
    let mut total = ascii_end
    let mut at = ascii_end
    while let Some((c, next)) = string.next_scalar(s, at) {
        total += match unicode_case(c, upper) {
            CaseScalar(mapped) => char.utf8_len(mapped),
            CaseExpansion(_, width) => width,
        }
        at = next
    }
    let mut out = string.with_capacity(total)
    for i in 0 .. ascii_end {
        let c = option.unwrap(char.from_u32(int.widen(input[i])))
        string.push_char(mut out, ascii_case(c, upper))
    }
    at = ascii_end
    while let Some((c, next)) = string.next_scalar(s, at) {
        append_case(mut out, unicode_case(c, upper))
        at = next
    }
    take out
}

/// A new string with each scalar mapped to full Unicode uppercase. Fails: Capacity.
/// Alloc: exactly the result's byte length rounded to 8, once. Cost: O(byte_len(s) + 1).
/// Ex: `string.to_upper("Straße")` returns "STRASSE".
pub fn to_upper(s: String) -> String {
    convert_case(s, true)
}

/// A new string with each scalar mapped to full Unicode lowercase. Fails: Capacity.
/// Alloc: exactly the result's byte length rounded to 8, once. Cost: O(byte_len(s) + 1).
/// Ex: `string.to_lower("ΣΑΣ")` returns "σασ".
pub fn to_lower(s: String) -> String {
    convert_case(s, false)
}


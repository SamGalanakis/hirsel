    if law_calls_deadline_hung(c, r, tasks, n) { Ok(()) } else { Error(()) }
}

fn receipt_policy(tx: store.Tx, author: runner.Caller) -> Result[store.KeyScope, Capacity] {
    let members = result.unwrap(store.catalog_table(tx, "members", std.codec.key_u64(), std.codec.of_u64()))
    match store.fetch(tx, store.shape(members), int.widen(author.issuer)) {
        Ok(Some(7u64)) => Ok(store.scope(members, ReadWrite)),
        _ => Ok(store.none(tx)),
    }
}

type ReceiptMessage: send { stamp: u64, grant: store.KeyScope }
type ReceiptObserver: send {
    inbox: Receiver[ReceiptMessage],
    reader: store.AuthorityReader,
    expected: store.KeyScope
}

fn receive_receipt(take observer: ReceiptObserver) -> bool waits {
    let message = result.unwrap(channel.receive(observer.inbox))
    store.load(observer.reader) == message.stamp + 1 &&
        store.scope_within(observer.expected, message.grant) &&
        store.scope_within(message.grant, observer.expected)
}

// RA: a real policy reads a member and its body changes that member. The
// receipt crosses a channel with the grant and stamp from before that commit.
pub fn law_authority_receipt(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    result.unwrap(store.create_table(mut db, store.spec("members", std.codec.key_u64(), std.codec.of_u64())))
    let members = result.unwrap(store.table(mut db, "members", std.codec.key_u64(), std.codec.of_u64()))
    let mut names: List[String] = list.new()
    result.unwrap(list.push(mut names, "members"))
    result.unwrap(store.declare_authority(mut db, names))
    let seed = store.run(mut db, None, fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, members, 1, 7)
    })
    if let Ok(Committed(_)) = seed {} else { return false }
    let reader = store.authority_reader(db)
    let stamp = store.load(reader)
    let author = store.Caller(issuer: 1, subject: list.new())
    let stream = result.unwrap(runner.stream_key(author, 23))
    let request = store.request_digest(stream, stream)
    if let Ok(Admitted(_)) = store.admit(mut db, stream, 0, request) {} else { return false }
    let delivery = result.unwrap(store.serve(mut db, stream, 0, author, code.describe(receipt_policy), 65536, 8192, None,
        fn(mut tx: store.Tx) -> Result[Bytes, Bytes] {
            match store.put(mut tx, members, 1, 8) {
                Ok(()) => Ok(u64_arg(8)),
                Error(_) => Error(list.new()),
            }
        }))
    let message = match take delivery {
        Committed(store.Receipt(ticket: _, reply: reply_data, digest: _, scope: take grant, seq: authorized_at)) => {
            if authorized_at != stamp || reply_data != u64_arg(8) { return false }
            ReceiptMessage(stamp: authorized_at, grant: take grant)
        },
        _ => return false,
    }
    let (outbox, inbox): (Sender[ReceiptMessage], Receiver[ReceiptMessage]) = result.unwrap(channel.new(1u64))
    let observer = ReceiptObserver(inbox: take inbox, reader: store.dup(reader), expected: store.scope(members, ReadWrite))
    let receiving = result.unwrap(task.spawn(tasks, bytes 65536u64, take observer, receive_receipt))
    result.unwrap(channel.send(outbox, take message))
    result.unwrap(task.join(take receiving))
}

@test
fn test_authority_receipt(c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_authority_receipt(c, r, tasks) { Ok(()) } else { Error(()) }
}

fn migration_second_refuses(mut phase: store.Migration) -> Result[(), store.Error] {
    store.migration_create_table(mut phase, store.spec("first", std.codec.key_u64(), std.codec.of_u64()))?
    let second = store.spec("second", std.codec.key_u64(), std.codec.of_u64())
    let attempted = bound bytes 0u64 {
        store.migration_create_table(mut phase, take second)
    }
    match take attempted {
        Ok(take outcome) => take outcome,
        Error(c) => Error(Full(c)),
    }
}

fn migration_tables_absent(catalog: store.Schema) -> Result[bool, store.Error] {
    match store.schema_table(catalog, "first", std.codec.key_u64(), std.codec.of_u64()) {
        Error(Missing(_)) => (),
        _ => return Ok(false),
    }
    Ok(match store.schema_table(catalog, "second", std.codec.key_u64(), std.codec.of_u64()) {
        Error(Missing(_)) => true,
        _ => false,
    })
}

// L33. The second operation refuses. Reopen the backing store and look for
// both tables through the same open-only API the runner gives to handles.
pub fn law_atomic_migration(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let options = disk_options()
    let db = result.unwrap(store.open(tasks, d, c, r, options))
    let (_, inbox): (Sender[runner.Req], Receiver[runner.Req]) = result.unwrap(channel.new(1))
    let mail = result.unwrap(runner.mailbox(1))
    let opened = runner.place_head(take db, code.describe(place), N_PLACE,
        code.describe(migration_second_refuses), code.describe(handles), take inbox, take mail, tasks, 1048576)
    if let Error(Migrate(Full(_))) = opened {} else { return false }
    let reopened = result.unwrap(store.open(tasks, d, c, r, options))
    let unchanged = store.version(store.snapshot(reopened)) == 0 &&
        result.unwrap(store.with_schema(reopened, code.describe(migration_tables_absent)))
    result.unwrap(store.close(take reopened))
    unchanged
}

@test
fn test_atomic_migration(parent: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    let mut name = result.unwrap(string.with_capacity(32))
    let directory = result.unwrap(host.mkdtemp(parent, mut name))
    let good = law_atomic_migration(directory, c, r, tasks)
    result.unwrap(std.dir.remove_all(parent, name))
    if good { Ok(()) } else { Error(()) }
}

@test
fn stream_quota_preserves_eviction_floor(c: Clock) -> Result[(), u64] waits {
    let mut db = raw_test_db(c, 1073741824u64)
    db.streams_per_caller_max = 1u64
    db.streams_max = 1u64
    let time = keyed_time(db)
    let caller = Caller(issuer: 2u8, subject: clone(b"same caller"))
    let older = StreamKey(caller: clone(caller), id: StreamId(t: time, n: 1u64))
    let first = StreamKey(caller: clone(caller), id: StreamId(t: time, n: 2u64))
    let second = StreamKey(caller: clone(caller), id: StreamId(t: time, n: 3u64))
    let digest = digest_for("same request")
    if let Admitted(_) = result.unwrap(admit(mut db, first, 0u64, digest)) {} else {
        return Error(1u64)
    }
    if let HistoryUnavailable = result.unwrap(admit(mut db, older, 0u64, digest)) {} else {
        return Error(2u64)
    }
    if let StreamOverloaded = result.unwrap(admit(mut db, second, 0u64, digest)) {} else {
        return Error(3u64)
    }
    let raw = result.unwrap(stream_key_bytes(first))
    let committed = result.unwrap(run(mut db, None, raw, fn(mut tx, key) -> Result[(), Error] {
        reply(mut tx, key, 0u64, clone(b"result"))
    }))
    if let Committed(_) = committed {} else {
        return Error(4u64)
    }
    if let Admitted(_) = result.unwrap(admit(mut db, second, 0u64, digest)) {} else {
        return Error(5u64)
    }
    if let HistoryUnavailable = result.unwrap(admit(mut db, first, 0u64, digest)) {} else {
        return Error(6u64)
    }
    Ok(())
}

// J1: same J rewrites only the primary key; changing J rewrites old+new index
// entries. Three indexes make these counts1 and7, independent of tree shape.
pub fn law_index_writes(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "writes", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "writes", std.codec.key_u64(), std.codec.of_u64()))
    let mut d = result.unwrap(declare(db, Migrate))
    let mut declared = result.unwrap(declare_table(mut d, "writes", std.codec.key_u64(), std.codec.of_u64()))
    for name in["i0", "i1", "i2"] {
        let _ = result.unwrap(index(mut d, mut declared, name, Many, code.describe(bucket), std.codec.key_u64()))
    }
    let _ = result.unwrap(finish(mut d, take declared))
    let _ = result.unwrap(seal(mut db, take d))
    if !typed_put(mut db, t, 1, 17) {
        return false
    }
    let same_j = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[u64, Error] {
        put(mut tx, call_env, 1, 21)?;
        Ok(data_row_count(tx.ops.rows))
    }))
    match take same_j {
        Committed(done) => if done.value != 1 {
            return false
        },
        _ => return false
    }
    let changed_j = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[u64, Error] {
        put(mut tx, call_env, 1, 22)?;
        Ok(data_row_count(tx.ops.rows))
    }))
    match take changed_j {
        Committed(done) => done.value == 7,
        _ => false
    }
}


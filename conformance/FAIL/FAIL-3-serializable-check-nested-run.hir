// rule: FAIL-3
// expect: run
// stdout: SEM-1
// stdout: 23
// stdout: 1000
// stdout: 3
// stdout: SEM-1
// stdout: 23
// stdout: 1000
// stdout: 3
// A check that fails on the first checked occurrence of a nested owned value, inside a
// helper the check calls, fails the decode with the helper's rule and site: the whole
// reconstructed value, its Strings and inner lists included, is released once, and
// task.isolate catches the failure. A check that returns false is no failure: the
// decode is Error(Invalid). Both hold for an envelope and for a bare payload.
@serializable(check = valid)
pub opaque type Month: plain + key + sendable + inert + noalloc_drop uses {} {
  number: u8,
}

@noalloc
fn scaled(n: u8) -> u8 uses {} {
  n * 100
}

// Admits 1; rejects 2; fails in `scaled` on 3 and above (u8 overflow).
@noalloc
fn valid(value: Month) -> bool uses {} {
  if value.number == 2 {
    false
  } else {
    scaled(value.number) > 0
  }
}

@serializable
type Group {
  name: String,
  months: List[Month],
}

@serializable
type Outer {
  tag: String,
  groups: List[Group],
}

fn outer(groups: List[List[u8]]) -> Outer {
  let mut out: List[Group] = []
  for g in groups {
    let mut months: List[Month] = []
    for m in g {
      list.push(mut months, Month(number: m))
    }
    list.push(
      mut out,
      Group(name: "a group whose name the decode allocates", months: take months)
    )
  }
  Outer(tag: "an outer value whose tag the decode allocates", groups: take out)
}

// The number of months decoded, or 1000 when a check rejected one.
fn counted(decoded: Result[Outer, DecodeError]) -> u64 {
  match decoded {
    Ok(o) => {
      let mut n: u64 = 0
      for g in o.groups {
        n = n + list.len(g.months)
      }
      n
    },
    Error(_) => 1000,
  }
}

fn envelope(groups: List[List[u8]]) -> u64 {
  counted(codec.decode(codec.encode(outer(groups))))
}

fn payload(groups: List[List[u8]]) -> u64 {
  let none: Option[Outer] = None()
  counted(codec.decode_payload(none, codec.encode_payload(outer(groups))))
}

fn line(stdout: Stdout, text: String) -> () {
  let _ = out.print(stdout, text)
  let _ = out.print(stdout, "\n")
}

fn report(stdout: Stdout, caught: Result[u64, Failure]) -> () {
  match caught {
    Ok(n) => line(stdout, u64.to_string(n)),
    Error(failed) => {
      line(stdout, failed.rule)
      line(stdout, u64.to_string(failed.site.line))
    },
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let tasks = io.tasks(rt)?
  report(
    stdout,
    task.isolate(
      tasks,
      fn() -> u64 {
        envelope([[3, 1], [1, 1]])
      }
    )
  )
  report(
    stdout,
    task.isolate(
      tasks,
      fn() -> u64 {
        envelope([[1, 1], [1, 2]])
      }
    )
  )
  report(
    stdout,
    task.isolate(
      tasks,
      fn() -> u64 {
        envelope([[1, 1], [1]])
      }
    )
  )
  report(
    stdout,
    task.isolate(
      tasks,
      fn() -> u64 {
        payload([[3, 1], [1, 1]])
      }
    )
  )
  report(
    stdout,
    task.isolate(
      tasks,
      fn() -> u64 {
        payload([[1, 1], [1, 2]])
      }
    )
  )
  report(
    stdout,
    task.isolate(
      tasks,
      fn() -> u64 {
        payload([[1, 1], [1]])
      }
    )
  )
  Ok(())
}

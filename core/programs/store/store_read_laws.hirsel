@test
fn test_staged_index_reads(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "writes", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "writes", std.codec.key_u64(), std.codec.of_u64()))
    let (_, ix) = result.unwrap(law_indexed(mut db, "writes", std.codec.key_u64(), std.codec.of_u64(), "bucket", code.describe(bucket), std.codec.key_u64()))
    if !typed_put(mut db, t, 1, 4) || !typed_put(mut db, t, 2, 9) {
        return Error(Foreign)
    }
    let held = snapshot(db)
    let root = tree_stamp(held.roots.collections)
    let outcome = run(mut db, None, (copy_env(t), copy_env(ix)), fn(mut tx, call_env) -> Result[(), Error] {
        if !delete(mut tx, call_env.0, 1)? || fetch(tx, call_env.0, 1)? != None {
            return Error(Missing("staged delete"))
        }
        put(mut tx, call_env.0, 2, 8)?
        put(mut tx, call_env.0, 3, 12)?
        if fetch(tx, call_env.0, 2)? != Some(8u64) {
            return Error(Missing("staged put"))
        }
        let mut rows = lookup(tx, call_env.1, Included(0u64), Included(0u64))?
        if next_indexed(mut rows)? != Some((2u64, 8u64)) || next_indexed(mut rows)? != Some((3u64, 12u64)) || next_indexed(mut rows)? != None {
            return Error(Missing("staged index rows"))
        }
        Error(Foreign)
    })?
    if let Aborted(Undone(value: Foreign, ticket: None)) = outcome {
        let now = snapshot(db)
        let sh = view t
        if version(now) == version(held) && tree_stamp(now.roots.collections) == root && get(result.unwrap(reader(db, 0u64)), now, sh, 1)? == Some(4u64) && get(result.unwrap(reader(db, 0u64)), now, sh, 2)? == Some(9u64) && get(result.unwrap(reader(db, 0u64)), now, sh, 3)? == None {
            return Ok(())
        }
    }
    Error(Foreign)
}

fn read_set_hit(reads: List[Read], delta: List[Change]) -> bool {
    for change in delta {
        for read in reads {
            if reads_key(read, change.tree_key) {
                return true
            }
        }
    }
    false
}

fn observe_lookup(s: Snapshot, ix: Index[u64, u64, u64, ()], limit: u64) -> (List[u64], List[Read]) waits {
    let observed = result.unwrap(look(law_reader(s), s, None, (copy_env(ix), copy_env(limit)), fn(tx, call_env) -> Result[List[u64], Error] {
        let mut rows = lookup(tx, call_env.0, Included(1), Included(1))?
        let mut out: List[u64] = list.new()
        for _ in 0u64 .. call_env.1 {
            match next_indexed(mut rows)? {
                Some((k, v)) => {
                    list.push(mut out, k)
                    list.push(mut out, v)
                },
                None => break
            }
        }
        Ok(take out)
    }))
    match take observed {
        Seen(take done) => {
            let Seen(value: take result_value, version: _, reads: take reads) = take done
            (result.unwrap(take result_value), take reads)
        },
        _ => fail("L26 lookup observation failed")
    }
}

// J1's sharp witnesses: partial/zero/full iteration and equal J values.
// A value-only change, and delete+reput at that J, hit only the primary Point.
fn lookup_cover_points(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "cover", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "cover", std.codec.key_u64(), std.codec.of_u64()))
    let (_, ix) = result.unwrap(law_indexed(mut db, "cover", std.codec.key_u64(), std.codec.of_u64(), "i", code.describe(bucket), std.codec.key_u64()))
    for k in 1u64 .. 4 {
        if !typed_put(mut db, t, k, 4 * k - 3) {
            return false
        }
    }
    let a = snapshot(db)
    let first = observe_lookup(a, ix, 1)
    let (take values, take reads) = take first
    if list.len(values) != 2 || values[0] != 1 || values[1] != 1 || list.len(reads) != 2 {
        return false
    }
    let mut suffix = key_word(1)
    list.append(mut suffix, key_word(1))
    list.push(mut suffix, 0u8)
    let span = match reads[0] {
        Span(low, high) => low == result.unwrap(logical_key(2, key_word(1))) && high == result.unwrap(logical_key(2, suffix)),
        _ => false
    }
    let point = match reads[1] {
        Point(key) => key == result.unwrap(logical_key(1, key_word(1))),
        _ => false
    }
    if !span || !point {
        return false
    }
    // The unreturned row's value was not observed: no Point for key2.
    if !typed_put(mut db, t, 2, 9) {
        return false
    }
    let b = snapshot(db)
    let unreturned_delta = result.unwrap(changes(result.unwrap(reader(db, 0u64)), a, b)).rows
    let untouched = observe_lookup(b, ix, 1)
    if read_set_hit(reads, unreturned_delta) || untouched.0 != values {
        return false
    }
    if !typed_put(mut db, t, 1, 5) {
        return false
    }
    let d = snapshot(db)
    let changed = result.unwrap(changes(result.unwrap(reader(db, 0u64)), b, d)).rows
    let changed_answer = observe_lookup(d, ix, 1)
    if list.len(changed) != 1 || !read_set_hit(reads, changed) || changed_answer.0 == values {
        return false
    }
    let replaced = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        let _ = delete(mut tx, call_env, 1)?
        put(mut tx, call_env, 1, 13)
    }))
    match take replaced {
        Committed(_) => {},
        _ => return false
    }
    let e = snapshot(db)
    let replaced_delta = result.unwrap(changes(result.unwrap(reader(db, 0u64)), d, e)).rows
    if list.len(replaced_delta) != 1 || !read_set_hit(changed_answer.1, replaced_delta) {
        return false
    }
    let zero = observe_lookup(e, ix, 0)
    if list.len(zero.0) != 0 || list.len(zero.1) != 0 {
        return false
    }
    let all = observe_lookup(e, ix, 8)
    let expected: Inline[u64, 6] =[1, 13, 2, 9, 3, 9]
    if list.len(all.0) != 6 || list.len(all.1) != 7 {
        return false
    }
    for i in 0u64 .. 6 {
        if all.0[i] != expected[i] {
            return false
        }
    }
    true
}

fn cover_push(mut out: List[u64], n: u64) -> Result[(), Error] {
    Ok(list.push(mut out, n))
}

fn cover_observe(tx: Tx, a: Table[u64, u64], b: Table[u64, u64], ia: Index[u64, u64, u64, ()], ib: Index[u64, u64, u64, ()], plan: u64) -> Result[List[u64], Error] {
    let mut out: List[u64] = list.new()
    match fetch(tx, a, plan % 8)? {
        Some(v) => {
            cover_push(mut out, 1)?;
            cover_push(mut out, v)?
        },
        None => cover_push(mut out, 0)?
    }
    match fetch(tx, b, (plan >> 8) % 8)? {
        Some(v) => {
            cover_push(mut out, 1)?;
            cover_push(mut out, v)?
        },
        None => cover_push(mut out, 0)?
    }
    let lower = (plan >> 16) % 3
    let upper = (plan >> 24) % 3
    let lo: Bound[u64] = match lower {
        0 => Unbounded,
        1 => Included(2),
        _ => Excluded(2)
    }
    let hi: Bound[u64] = match upper {
        0 => Unbounded,
        1 => Included(6),
        _ => Excluded(6)
    }
    let mut left = range(tx, a, lo, hi)?
    while let Some((k, v)) = next_in(tx, mut left)? {
        cover_push(mut out, k)?;
        cover_push(mut out, v)?
    }
    cover_push(mut out, 65535)?
    let mut right = range(tx, b, lo, hi)?
    while let Some((k, v)) = next_in(tx, mut right)? {
        cover_push(mut out, k)?;
        cover_push(mut out, v)?
    }
    cover_push(mut out, 65534)?
    let j = (plan >> 32) % 4
    let limit = match (plan >> 40) % 4 {
        0 => 0u64,
        1 => 1u64,
        2 => 2u64,
        _ => 8u64
    }
    let mut left_index = lookup(tx, ia, Included(j), Included(j))?
    for _ in 0u64 .. limit {
        match next_indexed(mut left_index)? {
            Some((k, v)) => {
                cover_push(mut out, k)?;
                cover_push(mut out, v)?
            },
            None => break
        }
    }
    cover_push(mut out, 65533)?
    let mut right_index = lookup(tx, ib, Included(j), Included(j))?
    for _ in 0u64 .. limit {
        match next_indexed(mut right_index)? {
            Some((k, v)) => {
                cover_push(mut out, k)?;
                cover_push(mut out, v)?
            },
            None => break
        }
    }
    Ok(take out)
}

fn observe_cover(s: Snapshot, a: Table[u64, u64], b: Table[u64, u64], ia: Index[u64, u64, u64, ()], ib: Index[u64, u64, u64, ()], plan: u64) -> (List[u64], List[Read]) waits {
    let observed = result.unwrap(look(law_reader(s), s, None, (copy_env(a), copy_env(b), copy_env(ia), copy_env(ib), copy_env(plan)), fn(tx, call_env) -> Result[List[u64], Error] {
        cover_observe(tx, call_env.0, call_env.1, call_env.2, call_env.3, call_env.4)
    }))
    match take observed {
        Seen(take done) => {
            let Seen(value: take result_value, version: _, reads: take reads) = take done
            (result.unwrap(take result_value), take reads)
        },
        _ => fail("L26 observation failed")
    }
}

fn cover_write(mut tx: Tx, t: Table[u64, u64], key: u64, mode: u64, value: u64) -> Result[(), Error] {
    let old = match fetch(tx, t, key)? {
        Some(v) => v,
        None => 100u64 + key
    }
    if mode == 0 {
        put(mut tx, t, key, old + 4)
    } else if mode == 1 {
        let _ = delete(mut tx, t, key)?;
        put(mut tx, t, key, old + 4)
    } else if mode == 2 {
        let _ = delete(mut tx, t, key)?;
        Ok(())
    } else {
        put(mut tx, t, key, value)
    }
}

// L26: re-execution is the oracle, exact vectors rather than a checksum. Two
// tables have equal keys and equal J buckets, but distinct logical-key prefixes.
pub fn law_read_cover(c: Clock) -> bool waits {
    if !lookup_cover_points(c) {
        return false
    }
    let mut db = test_db(c, 1073741824)
    let mut d = result.unwrap(declare(db, Migrate))
    let mut left = result.unwrap(declare_table(mut d, "left", std.codec.key_u64(), std.codec.of_u64()))
    let ia = result.unwrap(index(mut d, mut left, "i", Many, code.describe(bucket), std.codec.key_u64()))
    let a = result.unwrap(finish(mut d, take left))
    let mut right = result.unwrap(declare_table(mut d, "right", std.codec.key_u64(), std.codec.of_u64()))
    let ib = result.unwrap(index(mut d, mut right, "i", Many, code.describe(bucket), std.codec.key_u64()))
    let b = result.unwrap(finish(mut d, take right))
    let _ = result.unwrap(seal(mut db, take d))
    for k in 0u64 .. 8 {
        if !typed_put(mut db, a, k, 100 + k) || !typed_put(mut db, b, k, 200 + k) {
            return false
        }
    }
    let sa = view a
    let sb = view b
    let mut misses: u64 = 0
    let mut hits: u64 = 0
    for operation in 0u64 .. 128 {
        let state = splitmix64(operation + 1031)
        let first = snapshot(db)
        let initial = observe_cover(first, sa, sb, ia, ib, state)
        let (take initial_value, take reads) = take initial
        let mutation = result.unwrap(run(mut db, None, (copy_env(a), copy_env(b), copy_env(state)), fn(mut tx, call_env) -> Result[(), Error] {
            if call_env.2 & 1 == 0 {
                cover_write(mut tx, call_env.0, (call_env.2 >> 8) % 8, (call_env.2 >> 16) % 4, 300 + ((call_env.2 >> 24) % 64))
            } else {
                cover_write(mut tx, call_env.1, (call_env.2 >> 8) % 8, (call_env.2 >> 16) % 4, 300 + ((call_env.2 >> 24) % 64))
            }
        }))
        match take mutation {
            Committed(_) => {},
            _ => return false
        }
        let second = snapshot(db)
        let delta = result.unwrap(changes(result.unwrap(reader(db, 0u64)), first, second)).rows
        let observed = observe_cover(second, sa, sb, ia, ib, state)
        if read_set_hit(reads, delta) {
            hits += 1
        } else {
            misses += 1
            if initial_value != observed.0 {
                return false
            }
        }
    }
    hits > 0 && misses > 0
}

@test
fn test_read_cover(c: Clock) -> Result[(), ()] waits {
    if law_read_cover(c) {
        Ok(())
    } else {
        Error(())
    }
}

// R2's Cover reads (RUNNER-SPEC §4). Keys 1..5 of "data" are put after `before`, so
// changes(before, after) lists their five data-tree rows in key order (d[0] is key 1): that
// list is the oracle for which rows a span holds. A row of table "other" is never in a span
// of "data". Constructing a range cursor alone observes no rows.
fn same_rows(got: List[Change], want: List[Change], from: u64, n: u64) -> bool {
    if list.len(got) != n {
        return false
    }
    for i in 0u64 .. n {
        if got[i].tree_key != want[from + i].tree_key || got[i].value != want[from + i].value {
            return false
        }
    }
    true
}

fn span_rows(s: Snapshot, r: Read) -> List[Change] waits {
    match r {
        Span(lo, hi) => result.unwrap(span_changes(law_reader(s), s, lo, hi)),
        Point(_) => list.new()
    }
}

pub fn law_read_spans(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let (t, o) = result.unwrap(law_pair(mut db, "data", std.codec.key_u64(), std.codec.of_u64(), "other", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, o, 3, 7) {
        return false
    }
    let before = snapshot(db)
    for k in 1u64 .. 6 {
        if !typed_put(mut db, t, k, k * 10) {
            return false
        }
    }
    let after = snapshot(db)
    let d = result.unwrap(changes(result.unwrap(reader(db, 0u64)), before, after)).rows
    if list.len(d) != 5 {
        return false
    }
    let sh = view t
    let mid = result.unwrap(key_span(sh, Included(2), Excluded(4)))
    let shifted = result.unwrap(key_span(sh, Excluded(2), Included(4)))
    let all = result.unwrap(key_span(sh, Unbounded, Unbounded))
    let point = Point(result.unwrap(copied(d[0].tree_key)))
    let no_match = result.unwrap(key_span(sh, Included(3), Excluded(3)))
    if !same_rows(span_rows(after, mid), d, 1, 2) || !same_rows(span_rows(after, shifted), d, 2, 2) || !same_rows(span_rows(after, all), d, 0, 5) || list.len(span_rows(before, all)) != 0 || list.len(span_rows(after, no_match)) != 0 || reads_key(no_match, d[2].tree_key) {
        return false
    }
    if !reads_key(mid, d[1].tree_key) || !reads_key(mid, d[2].tree_key) || reads_key(mid, d[0].tree_key) || reads_key(mid, d[3].tree_key) || !reads_key(point, d[0].tree_key) || reads_key(point, d[1].tree_key) {
        return false
    }
    let observed = result.unwrap(look(result.unwrap(reader(db, 0u64)), after, None, sh, fn(tx, call_env) -> Result[(), Error] {
        let _ = range(tx, call_env, Included(2), Excluded(4))?
        let _ = range(tx, call_env, Excluded(2), Included(4))?
        Ok(())
    }))
    let got = match take observed {
        Seen(take x) => take x,
        _ => return false
    }
    list.len(got.reads) == 0
}

fn prefix_observation(s: Snapshot, sh: Table[u64, u64], reverse: bool, steps: u64) -> List[Read] waits {
    let observed = result.unwrap(look(law_reader(s), s, None, (copy_env(reverse), copy_env(sh), copy_env(steps)), fn(tx, call_env) -> Result[(), Error] {
        let mut rows = if call_env.0 {
            range_reverse(tx, call_env.1, Included(1), Excluded(10))?
        } else {
            range(tx, call_env.1, Included(1), Excluded(10))?
        }
        for _ in 0u64 .. call_env.2 {
            if let None = next_in(tx, mut rows)? {
                break
            }
        }
        Ok(())
    }))
    match take observed {
        Seen(take seen) => {
            let Seen(value: take checked, reads: take read_set, ..) = take seen
            result.unwrap(take checked)
            take read_set
        },
        _ => fail("expected observed range")
    }
}

fn nested_edge_key(a: String, b: u64, c: u64) -> ((String, u64), ((String, u64), u64)) {
    ((string.from(a), b), ((string.from(a), b), c))
}

fn nested_edge_prefix(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let mut schema = declare(db, Migrate)?
    let pair: std.codec.Key[((String, u64), ((String, u64), u64))] = std.codec.key_of()
    let source: std.codec.Key[(String, u64)] = std.codec.key_of()
    let target: std.codec.Key[((String, u64), u64)] = std.codec.key_of()
    let edge = declare_edge(mut schema, "nested_edges", "reverse", pair, source, target)?
    let _ = seal(mut db, take schema)?
    let inserted = run(mut db, None, edge, fn(mut tx, e) -> Result[(), Error] {
        edge_put(mut tx, e, nested_edge_key("abc", 0, 0))?
        edge_put(mut tx, e, nested_edge_key("ab", 2, 0))?
        edge_put(mut tx, e, nested_edge_key("ab", 1, 9))?
        edge_put(mut tx, e, nested_edge_key("aa", 0, 0))?
        edge_put(mut tx, e, nested_edge_key("ab", 1, 3))
    })?
    let Committed(_) = inserted else {
        return Error(MigrationFault)
    }
    let observed = look(reader(db, 0)?, snapshot(db), None, edge, fn(tx, e) -> Result[(), Error] {
        let key = std.codec.key_string()
        let mut rows = edge_out_prefix(tx, e, "ab", key)?
        let mut indexed = lookup_prefix(tx, e.targets, "ab", key)?
        for (b, suffix) in[(1u64, 3u64), (1u64, 9u64), (2u64, 0u64)] {
            let row = Some((nested_edge_key("ab", b, suffix), ()))
            if next_in(tx, mut rows)? != row || next_indexed(mut indexed)? != row {
                return Error(MigrationFault)
            }
        }
        if next_in(tx, mut rows)? != None || next_indexed(mut indexed)? != None {
            return Error(MigrationFault)
        }
        let mut outgoing = edge_out(tx, e, ("ab", 1u64))?
        if next_in(tx, mut outgoing)? != Some((nested_edge_key("ab", 1, 3), ())) || next_in(tx, mut outgoing)? != Some((nested_edge_key("ab", 1, 9), ())) || next_in(tx, mut outgoing)? != None {
            return Error(MigrationFault)
        }
        Ok(())
    })?
    match take observed {
        Seen(Seen(value: Ok(()), ..)) => Ok(()),
        _ => Error(MigrationFault),
    }
}

// With keys 3 and 7, a forward step inspects [1,3] and a reverse step inspects
// [7,10). Inserts in those gaps invalidate the read. A probe returning None
// inspects the terminal gap, so those inserts invalidate an exhausted scan too.
pub fn law_range_prefix(c: Clock) -> bool waits {
    if let Error(_) = nested_edge_prefix(c) {
        return false
    }
    let mut db = test_db(c, 1073741824)
    let dictionary = std.codec.of_u64()
    result.unwrap(law_table(mut db, "prefix", std.codec.key_u64(), dictionary))
    let t = result.unwrap(table(mut db, "prefix", std.codec.key_u64(), dictionary))
    if !typed_put(mut db, t, 3, 30) || !typed_put(mut db, t, 7, 70) {
        return false
    }
    let sh = view t
    let base = snapshot(db)
    let forward = prefix_observation(base, sh, false, 1)
    let two_forward = prefix_observation(base, sh, false, 2)
    let fully_forward = prefix_observation(base, sh, false, 3)
    let reverse = prefix_observation(base, sh, true, 1)
    let fully_reverse = prefix_observation(base, sh, true, 3)
    if !typed_put(mut db, t, 2, 20) {
        return false
    }
    let inserted_left = snapshot(db)
    let left = result.unwrap(changes(result.unwrap(reader(db, 0u64)), base, inserted_left)).rows
    if !read_set_hit(forward, left) || read_set_hit(reverse, left) || !read_set_hit(fully_reverse, left) {
        return false
    }
    if !typed_put(mut db, t, 8, 80) {
        return false
    }
    let right = result.unwrap(changes(result.unwrap(reader(db, 0u64)), inserted_left, snapshot(db))).rows
    if read_set_hit(forward, right) || read_set_hit(two_forward, right) || !read_set_hit(fully_forward, right) || !read_set_hit(reverse, right) {
        return false
    }
    let inserted_right = snapshot(db)
    if !typed_put(mut db, t, 5, 50) {
        return false
    }
    let middle = result.unwrap(changes(result.unwrap(reader(db, 0u64)), inserted_right, snapshot(db))).rows
    if read_set_hit(forward, middle) || !read_set_hit(two_forward, middle) {
        return false
    }
    if result.unwrap(count_at(result.unwrap(reader(db, 0u64)), snapshot(db), sh, Included(2), Excluded(8))) != 4 {
        return false
    }
    let mut rows = result.unwrap(scan_reverse(result.unwrap(reader(db, 0u64)), snapshot(db), sh, Included(2), Excluded(8)))
    result.unwrap(next(law_reader(rows.capture), mut rows)) == Some((7u64, 70u64)) && result.unwrap(next(law_reader(rows.capture), mut rows)) == Some((5u64, 50u64)) && result.unwrap(next(law_reader(rows.capture), mut rows)) == Some((3u64, 30u64)) && result.unwrap(next(law_reader(rows.capture), mut rows)) == Some((2u64, 20u64)) && result.unwrap(next(law_reader(rows.capture), mut rows)) == None
}

fn scan_matches_rows(s: Snapshot, sh: Table[u64, u64], low: u64, high: u64, hi: Bound[u64], reverse: bool) -> bool waits {
    let mut rows = if reverse {
        result.unwrap(scan_reverse(law_reader(s), s, sh, Included(low), hi))
    } else {
        result.unwrap(scan(law_reader(s), s, sh, Included(low), hi))
    }
    for i in 0u64 .. 512 {
        let key = 2 * (if reverse {
            511 - i
        } else {
            i
        })
        if low <= key && key < high && result.unwrap(next(law_reader(rows.capture), mut rows)) != Some((key, key + 1)) {
            return false
        }
    }
    result.unwrap(next(law_reader(rows.capture), mut rows)) == None && result.unwrap(next(law_reader(rows.capture), mut rows)) == None
}

fn law_reader(s: Snapshot) -> Reader {
    result.unwrap(make_reader(s.store, s.open, None))
}

// A journaled transaction over rows 1 and 2 runs a body that deletes both and
// puts row 3 (so the put's frame-tail slot is 2), then returns a typed error.
// The caller handles it, puts row 4 and commits. `bounded` picks
// rollback_writes_on_overrun, else rollback_writes_on_error. Answers rows 1..4
// after commit, or 9s if the transaction did not commit.
fn typed_error_tail_case(d: Dir, c: Clock, r: Random, tasks: Tasks, bounded: bool) -> (u64, u64, u64, u64) waits {
    let dir = disk_test_directory(d)
    let mut db = result.unwrap(open(tasks, dir, c, r, result.unwrap(sized(Directory, 2147483648u64))))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let seeded = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, 10)?
        put(mut tx, t, 2, 20)
    }))
    match take seeded {
        Committed(_) => (),
        _ => return (9, 9, 9, 9),
    }
    let out = run(mut db, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        let typed = if bounded {
            match rollback_writes_on_overrun(mut tx, 1000000, scoped fn(mut w: Tx) -> Result[(), Error] {
                tail_body(mut w, t)
            }) {
                Ok(take inner) => take inner,
                Error(_) => return Error(Missing("overrun")),
            }
        } else {
            rollback_writes_on_error(mut tx, scoped fn(mut w: Tx) -> Result[(), Error] {
                tail_body(mut w, t)
            })
        }
        match typed {
            Error(Missing(_)) => (),
            _ => return Error(Missing("not typed")),
        }
        put(mut tx, t, 4, 40)
    })
    let committed = match take out {
        Ok(Committed(_)) => true,
        _ => false,
    }
    let rows = if committed {
        let s = snapshot(db)
        let sh = view t
        (typed_value(s, sh, 1), typed_value(s, sh, 2), typed_value(s, sh, 3), typed_value(s, sh, 4))
    } else {
        (9, 9, 9, 9)
    }
    result.unwrap(close(take db))
    rows
}

// A typed error discards the body's data ops and with them its frame-tail
// slot, so the caller's later write commits. Oracle, by hand: rows 1 and 2
// stay, 3 is discarded, 4 commits.
pub fn disk_law_typed_error_drops_frame_tail(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let bounded = typed_error_tail_case(d, c, r, tasks, true)
    let unbounded = typed_error_tail_case(d, c, r, tasks, false)
    bounded.0 == 10 && bounded.1 == 20 && bounded.2 == 0 && bounded.3 == 40 && unbounded.0 == 10 && unbounded.1 == 20 && unbounded.2 == 0 && unbounded.3 == 40
}

@test
fn disk_test_typed_error_drops_frame_tail(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_typed_error_drops_frame_tail(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

pub fn law_typed_indexes(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let mut t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    for k in 0u64 .. 24 {
        if !typed_put(mut db, t, k, k + 1) {
            return false
        }
    }
    let frozen = snapshot(db)
    let sh = view t
    result.unwrap(create_index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let stale = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, 99)
    })
    match take stale {
        Ok(Aborted(Undone(value: Stale(_), ticket: None))) => {},
        _ => return false
    }
    let ix = result.unwrap(index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
    result.unwrap(create_index(mut db, t, "quotient", code.describe(quotient), std.codec.key_u64()))
    let _ = result.unwrap(index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let incomplete = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, 99)
    })
    match take incomplete {
        Ok(Aborted(Undone(value: Stale(_), ticket: None))) => {},
        _ => return false
    }
    let _ = result.unwrap(index(mut db, t, "quotient", code.describe(quotient), std.codec.key_u64()))
    if !typed_put(mut db, t, 1, 99) {
        return false
    }
    let removed = run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        delete(mut tx, t, 5)
    })
    match take removed {
        Ok(Committed(done)) => if !done.value {
            return false
        },
        _ => return false
    }
    let mut rows = result.unwrap(find(snapshot(db), ix, Included(2), Included(2)))
    let mut sum: u64 = 0
    while let Some((_, v)) = result.unwrap(next(mut rows)) {
        sum += v
    }
    if sum != 64 || typed_value(frozen, sh, 1) != 2 || typed_value(snapshot(db), sh, 1) != 99 {
        return false
    }
    let reads = run(mut db, None, fn(mut tx: Tx) -> Result[u64, Error] {
        let own = option.unwrap(fetch(tx, t, 1)?)
        let mut cursor = lookup(tx, ix, Included(2), Included(2))?
        let mut total = own
        while let Some((_, v)) = next_indexed(mut cursor)? {
            total += v
        }
        Ok(total)
    })
    match take reads {
        Ok(Committed(done)) => if done.value != 163 || list.len(done.reads) != 6 {
            return false
        },
        _ => return false
    }
    for bucket_id in 0u64 .. 4 {
        let mut bucket_rows = result.unwrap(find(snapshot(db), ix, Included(bucket_id), Included(bucket_id)))
        for k in 0u64 .. 24 {
            let v = if k == 1 {
                99u64
            } else {
                k + 1
            }
            if k != 5 && v % 4 == bucket_id {
                if result.unwrap(next(mut bucket_rows)) != Some((k, v)) {
                    return false
                }
            }
        }
        if result.unwrap(next(mut bucket_rows)) != None {
            return false
        }
    }
    true
}

@test
fn test_typed_indexes(c: Clock) -> Result[(), ()] waits {
    if law_typed_indexes(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn old_put(v: OldAccount, mut b: Bytes) -> Result[(), std.codec.EncodeError] {
    std.codec.put_u64(v.balance, mut b)
    Ok(())
}

fn old_take(b: Bytes, mut at: u64) -> Result[OldAccount, std.codec.DecodeError] {
    Ok(OldAccount(balance: std.codec.take_u64(b, mut at)?))
}

fn old_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[OldAccount]) -> Result[(), std.codec.EncodeError] {
    std.codec.define(mut s, "store.tests.Account", 0)?
    if std.codec.record(mut s, 1)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)
    std.codec.close(mut s)
    Ok(())
}

fn new_put(v: NewAccount, mut b: Bytes) -> Result[(), std.codec.EncodeError] {
    std.codec.put_u64(v.balance, mut b)
    std.codec.put_u64(v.bonus, mut b)
    Ok(())
}

fn new_take(b: Bytes, mut at: u64) -> Result[NewAccount, std.codec.DecodeError] {
    let balance = std.codec.take_u64(b, mut at)?
    let bonus = std.codec.take_u64(b, mut at)?
    Ok(NewAccount(balance: balance, bonus: bonus))
}

fn new_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[NewAccount]) -> Result[(), std.codec.EncodeError] {
    std.codec.define(mut s, "store.tests.Account", 0)?
    if std.codec.record(mut s, 2)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)
    std.codec.field_default(mut s, "bonus", std.codec.of_u64(), 7)?
    std.codec.close(mut s)
    Ok(())
}

fn old_codec() -> std.codec.Codec[OldAccount] {
    std.codec.make(old_put, old_take, old_schema, 8)
}

fn new_codec() -> std.codec.Codec[NewAccount] {
    std.codec.make(new_put, new_take, new_schema, 16)
}

fn schema_zero_bytes(balance: u64) -> Bytes {
    let mut raw: Bytes = list.with_capacity(10)
    list.put_word_le(mut raw, 0u16)
    list.put_word_le(mut raw, balance)
    take raw
}

fn schema_snapshot_bytes[V](s: Snapshot, sh: Table[u64, V], expected: Bytes) -> Result[bool, Error] {
    let point = match get_bytes(s, sh, 1)? {
        Some(raw) => raw == expected,
        None => false,
    }
    let mut rows = scan_bytes(s, sh, Included(1), Included(1))?
    if !point || next_view(mut rows)? == None {
        return Ok(false)
    }
    Ok(value_view(rows) == expected && next_view(mut rows)? == None)
}

// L17 in memory: old rows use a resolved reader and defaults; new rows use the new tag.
// Wrong implementation: overwrite the old schema, or treat a fingerprint match as identity.
pub fn law_schema_numbers(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("accounts", std.codec.key_u64(), old_codec())))
    let old = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), old_codec()))
    let first = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, old, 1, OldAccount(balance: 10))
    })
    match take first {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let held = snapshot(db)
    result.unwrap(pin(mut db, "schema_zero", held))
    // An injected equal fingerprint with unequal bytes must not reuse number 0.
    let mut meta = result.unwrap(catalog_entry(db, old.catalog_key))
    let writer = result.unwrap(std.codec.schema(old_codec()))
    let mut schemas: List[ValueSchema] = list.new()
    list.push(mut schemas, ValueSchema(number: 0, fingerprint: result.unwrap(std.codec.fingerprint(new_codec())), schema: take writer))
    meta.schemas = take schemas
    let raw = result.unwrap(encode_catalog(meta))
    let base = share_roots(db.heads[0].roots)
    let patched = result.unwrap(catalog_put(mut db, base, old.catalog_key, raw))
    db.heads[0].roots = take patched
    let before_append = version(snapshot(db))
    let current = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), new_codec()))
    // K1: adding a schema is one commit, opening it again commits nothing.
    if current.readers.current != 1 || version(snapshot(db)) != before_append + 1 {
        return false
    }
    let sh = view current
    let before = option.unwrap(result.unwrap(get(held, sh, 1)))
    if before.balance != 10 || before.bonus != 7 {
        return false
    }
    // L40: the raw paths retain the original little-endian schema tag and balance.
    let expected = schema_zero_bytes(10)
    let head = snapshot(db)
    let old_shape = view old
    if !result.unwrap(schema_snapshot_bytes(held, old_shape, expected)) || !result.unwrap(schema_snapshot_bytes(held, sh, expected)) || !result.unwrap(schema_snapshot_bytes(head, sh, expected)) || !result.unwrap(schema_snapshot_bytes(head, old_shape, expected)) {
        return false
    }
    for source in[take held, take head] {
        let read = result.unwrap(look(source, None, fn(tx: Tx) -> Result[bool, Error] {
            let new_raw = match fetch_bytes(tx, sh, 1)? {
                Some(stored) => stored == expected,
                None => false
            }
            let old_raw = match fetch_bytes(tx, old_shape, 1)? {
                Some(stored) => stored == expected,
                None => false
            }
            let Some(account) = fetch(tx, sh, 1)? else {
                return Ok(false)
            }
            Ok(new_raw && old_raw && account.balance == 10 && account.bonus == 7)
        }))
        match take read {
            Seen(Seen(value: Ok(true), ..)) => {},
            _ => return false
        }
    }
    let second = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, current, 2, NewAccount(balance: 20, bonus: 9))
    })
    match take second {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let rows = snapshot(db)
    let one = option.unwrap(result.unwrap(get(rows, sh, 1)))
    let two = option.unwrap(result.unwrap(get(rows, sh, 2)))
    if one.balance != 10 || one.bonus != 7 || two.balance != 20 || two.bonus != 9 {
        return false
    }
    let epoch = db.heads[0].head
    let again = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), new_codec()))
    if version(snapshot(db)) != epoch || again.readers.current != 1 {
        return false
    }
    let refused_reader = table(mut db, "accounts", std.codec.key_u64(), old_codec())
    match take refused_reader {
        Error(Schema(_)) => {},
        _ => return false
    }
    db.heads[0].head == epoch
}

// L34 (STORE-SPEC v2.23 AG3): the published value of a row is its value in the table's
// current codec, without the u16 schema prefix. Row 1 is stored under schema 0 (OldAccount),
// row 2 under schema 1 (NewAccount, bonus defaulting to 7). The expected bytes are written out
// by hand from codec.md: a record is its fields in order, each u64 8 bytes little-endian.
// Wrong implementations: strip two bytes (row 1 gives 8 bytes), keep the prefix, or publish a
// row of another table.
fn two_words(a: u8, b: u8) -> Bytes {
    let mut out: Bytes = list.new()
    list.push(mut out, a)
    for _ in 0u64 .. 7 {
        list.push(mut out, 0u8)
    }
    list.push(mut out, b)
    for _ in 0u64 .. 7 {
        list.push(mut out, 0u8)
    }
    out
}

fn with_value(c: Change, number: u8, rest: u64) -> Change {
    let mut v: Bytes = list.new()
    list.push(mut v, number)
    for _ in 0u64 .. rest {
        list.push(mut v, 0u8)
    }
    Change(tree_key: result.unwrap(copied(c.tree_key)), value: Some(arc.new(take v)))
}

pub fn law_published_value(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("accounts", std.codec.key_u64(), old_codec())))
    result.unwrap(create_table(mut db, spec("other", std.codec.key_u64(), std.codec.of_u64())))
    let old = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), old_codec()))
    let other = result.unwrap(table(mut db, "other", std.codec.key_u64(), std.codec.of_u64()))
    let empty = snapshot(db)
    if !typed_put(mut db, other, 1, 5) {
        return false
    }
    let first = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, old, 1, OldAccount(balance: 10))
    })
    match take first {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let current = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), new_codec()))
    let second = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, current, 2, NewAccount(balance: 20, bonus: 9))
    })
    match take second {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let now = snapshot(db)
    let sh = view current
    let acc = result.unwrap(span_changes(now, result.unwrap(prefix(sh.id)), result.unwrap(prefix(sh.id + 1))))
    if list.len(acc) != 2 || result.unwrap(published_value(sh, acc[0])) != Some(two_words(10, 7)) || result.unwrap(published_value(sh, acc[1])) != Some(two_words(20, 9)) {
        return false
    }
    // changes(empty, now) publishes the same values, and the row of "other" is not t's.
    let mut ours = 0u64
    let mut foreign = 0u64
    for ch in result.unwrap(changes(empty, now)) {
        match published_value(sh, ch) {
            Ok(Some(v)) => {
                let i = if ch.tree_key == acc[0].tree_key {
                    0u64
                } else {
                    1u64
                }
                if ch.tree_key != acc[i].tree_key || Some(v) != result.unwrap(published_value(sh, acc[i])) {
                    return false
                }
                ours += 1
            },
            Error(Missing(_)) => {
                foreign += 1
            },
            _ => return false
        }
    }
    if ours != 2 || foreign != 1 {
        return false
    }
    match published_value(sh, with_value(acc[0], 7u8, 9)) {
        Error(Stale(id)) => if id != sh.id {
            return false
        },
        _ => return false
    }
    match published_value(sh, with_value(acc[0], 0u8, 0)) {
        Error(Decode(Truncated(at))) => if at != 0 {
            return false
        },
        _ => return false
    }
    let gone = run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        delete(mut tx, current, 1)
    })
    match take gone {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let removed = result.unwrap(changes(now, snapshot(db)))
    list.len(removed) == 1 && removed[0].tree_key == acc[0].tree_key && match published_value(sh, removed[0]) {
        Ok(None) => true,
        _ => false
    }
}

@test
fn test_published_value(c: Clock) -> Result[(), ()] waits {
    if law_published_value(c) {
        Ok(())
    } else {
        Error(())
    }
}

@test
fn test_schema_numbers(c: Clock) -> Result[(), ()] waits {
    if law_schema_numbers(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn old_balance(v: OldAccount) -> Result[u64, Capacity] {
    Ok(v.balance)
}

fn twice_balance(v: OldAccount) -> Result[u64, Capacity] {
    Ok(v.balance * 2)
}

fn new_bonus(v: NewAccount) -> Result[u64, Capacity] {
    Ok(v.bonus)
}

// L31 (b): Capacity from the extractor on the second row, k2 (balance 9).
fn bonus_refuses(v: NewAccount) -> Result[u64, Capacity] {
    if v.balance == 9 {
        Error(Capacity(requested: 1, available: 0))
    } else {
        Ok(v.bonus)
    }
}

// L31 (b): an index key of 5000 bytes, past the 4096-byte key limit.
fn wide_key(v: NewAccount) -> Result[Bytes, Capacity] {
    let mut raw: Bytes = list.new()
    list.fill(mut raw, 5000, int.truncate(v.balance))
    Ok(take raw)
}

fn keep_new(k: u64, v: NewAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((k, v)))
}

fn collapse(k: u64, v: NewAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((0, v)))
}

// by_b's order as one number: each row is k * 1000 + bonus, four digits
// each, so (70, k1), (90, k2) is 1070 2090.
fn bonus_order(s: Snapshot, ix: Index[u64, u64, NewAccount]) -> Result[u64, Error] {
    let mut rows = find(s, ix, Unbounded, Unbounded)?
    let mut keys = 0u64
    while let Some((k, v)) = next(mut rows)? {
        keys = keys * 10000 + k * 1000 + v.bonus
    }
    Ok(keys)
}

fn new_spec(name: String, index_name: String) -> TableSpec[u64, NewAccount] {
    let mut s = spec(string.from(name), std.codec.key_u64(), new_codec())
    result.unwrap(with_index(mut s, index_name, code.describe(new_bonus), std.codec.key_u64()))
    s
}

// L31 by hand, AB1's trace with Old {balance} for Old {a} and New {balance,
// bonus} for New {b}. Table t (id 1) with by_a (id 2) = Old.balance holds
// k1 = Old 7 and k2 = Old 9 at v2. migrate to `t` with by_b = New.bonus and
// f(k, Old a) = (k, New a, 10a): t gets id 3 and by_b id 4, at v3; the rows
// take schema number 1, the old entry's next, and number 0 retires. by_b
// lists (70, k1), (90, k2); by_a and its entries are gone. Old handles are
// Stale(1) and Stale(2) against v3 and read M at v2, where the new handles
// are Stale(3). A New put k3 = (5, 50) joins by_b first. (b) A migrate whose
// extractor refuses k2 is Full, one whose index key is 5000 bytes is
// Limit(Key), one whose f sends two rows to one key is Exists, and a spec
// repeating an index name is Exists; each leaves v4, the catalog and by_b as
// they were. (c) A table declared with two indexes is one commit, and both
// hold the first put. Wrong implementations caught: a migrate that keeps
// from's indexes (by_a still listed); one that installs rows past a failed
// index build (b is Ok); a reused schema number (the entry lists 0).
pub fn law_migrate(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let mut declared = spec("t", std.codec.key_u64(), old_codec())
    result.unwrap(with_index(mut declared, "by_a", code.describe(old_balance), std.codec.key_u64()))
    match with_index(mut declared, "by_a", code.describe(twice_balance), std.codec.key_u64()) {
        Error(Exists(_)) => {},
        _ => return false
    }
    result.unwrap(create_table(mut db, take declared))
    let mut t = result.unwrap(table(mut db, "t", std.codec.key_u64(), old_codec()))
    let ix_a = result.unwrap(index(mut db, t, "by_a", code.describe(old_balance), std.codec.key_u64()))
    let mut writer = result.unwrap(table(mut db, "t", std.codec.key_u64(), old_codec()))
    let _ = result.unwrap(index(mut db, writer, "by_a", code.describe(old_balance), std.codec.key_u64()))
    let first = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 1, OldAccount(balance: 7))?
        put(mut tx, t, 2, OldAccount(balance: 9))
    }))
    match take first {
        Committed(_) => {},
        _ => return false
    }
    let before = snapshot(db)
    let _ = result.unwrap(pin(mut db, "before", before))
    let old_shape: Table[u64, OldAccount] = clone(t)
    if version(before) != 2 || t.id != 1 || ix_a.id != 2 {
        return false
    }
    result.unwrap(migrate(mut db, take t, new_spec("t", "by_b"), upgrade))
    let now = snapshot(db)
    if version(now) != 3 {
        return false
    }
    let mut nt = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    if version(snapshot(db)) != 3 || nt.id != 3 {
        return false
    }
    let ix_b = result.unwrap(index(mut db, nt, "by_b", code.describe(new_bonus), std.codec.key_u64()))
    let meta = result.unwrap(catalog_entry(db, nt.catalog_key))
    if ix_b.id != 4 || list.len(meta.schemas) != 1 || meta.schemas[0].number != 1 || meta.next != 2 {
        return false
    }
    let listed = result.unwrap(index_catalog(db, 3))
    if list.len(listed) != 1 || listed[0].id != 4 || list.len(result.unwrap(index_catalog(db, 1))) != 0 {
        return false
    }
    let order = result.unwrap(bonus_order(now, ix_b))
    if order != 10702090 {
        return false
    }
    match get(now, old_shape, 1) {
        Error(Stale(id)) => if id != 1 {
            return false
        },
        _ => return false
    }
    match find(now, ix_a, Unbounded, Unbounded) {
        Error(Stale(id)) => if id != 2 {
            return false
        },
        _ => return false
    }
    match result.unwrap(get(before, old_shape, 1)) {
        Some(v) => if v.balance != 7 {
            return false
        },
        None => return false
    }
    let mut old_rows = result.unwrap(find(before, ix_a, Unbounded, Unbounded))
    match result.unwrap(next(mut old_rows)) {
        Some((k, _)) => if k != 1 {
            return false
        },
        None => return false
    }
    match get(before, nt, 1) {
        Error(Stale(id)) => if id != 3 {
            return false
        },
        _ => return false
    }
    let held = match pinned(db, "before") {
        Some(x) => x,
        None => return false
    }
    match get(held, nt, 1) {
        Error(Stale(_)) => {},
        _ => return false
    }
    let late = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, nt, 3, NewAccount(balance: 5, bonus: 50))
    }))
    match take late {
        Committed(_) => {},
        _ => return false
    }
    let stale_put = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, writer, 4, OldAccount(balance: 1))
    }))
    match take stale_put {
        Aborted(undone) => match undone.value {
            Stale(id) => if id != 1 {
                return false
            },
            _ => return false
        },
        _ => return false
    }
    if result.unwrap(bonus_order(snapshot(db), ix_b)) != 305010702090 || version(snapshot(db)) != 4 {
        return false
    }
    // (b) each refusal leaves v4, ids, catalog and by_b as they were.
    let mut refusing = spec("t", std.codec.key_u64(), new_codec())
    result.unwrap(with_index(mut refusing, "by_r", code.describe(bonus_refuses), std.codec.key_u64()))
    match migrate(mut db, take nt, take refusing, keep_new) {
        Error(Full(_)) => {},
        _ => return false
    }
    let mut wide = spec("t", std.codec.key_u64(), new_codec())
    result.unwrap(with_index(mut wide, "by_w", code.describe(wide_key), std.codec.key_bytes()))
    let again = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    match migrate(mut db, take again, take wide, keep_new) {
        Error(Limit(Key)) => {},
        _ => return false
    }
    let third = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    match migrate(mut db, take third, new_spec("t", "by_b"), collapse) {
        Error(Exists(_)) => {},
        _ => return false
    }
    let fourth = result.unwrap(table(mut db, "t", std.codec.key_u64(), new_codec()))
    if version(snapshot(db)) != 4 || db.next_table != 5 || fourth.id != 3 {
        return false
    }
    if list.len(result.unwrap(index_catalog(db, 3))) != 1 || result.unwrap(bonus_order(snapshot(db), ix_b)) != 305010702090 {
        return false
    }
    // (c) two indexes, one commit.
    let mut both = spec("w", std.codec.key_u64(), old_codec())
    result.unwrap(with_index(mut both, "by_a", code.describe(old_balance), std.codec.key_u64()))
    result.unwrap(with_index(mut both, "by_twice", code.describe(twice_balance), std.codec.key_u64()))
    result.unwrap(create_table(mut db, take both))
    if version(snapshot(db)) != 5 {
        return false
    }
    let mut w = result.unwrap(table(mut db, "w", std.codec.key_u64(), old_codec()))
    let wa = result.unwrap(index(mut db, w, "by_a", code.describe(old_balance), std.codec.key_u64()))
    let wt = result.unwrap(index(mut db, w, "by_twice", code.describe(twice_balance), std.codec.key_u64()))
    let put_w = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, w, 1, OldAccount(balance: 3))
    }))
    match take put_w {
        Committed(_) => {},
        _ => return false
    }
    let mut by_a = result.unwrap(find(snapshot(db), wa, Included(3), Included(3)))
    let mut by_t = result.unwrap(find(snapshot(db), wt, Included(6), Included(6)))
    let a_hit = match result.unwrap(next(mut by_a)) {
        Some((k, _)) => k == 1,
        None => false
    }
    let t_hit = match result.unwrap(next(mut by_t)) {
        Some((k, _)) => k == 1,
        None => false
    }
    a_hit && t_hit && w.id == 5 && wa.id == 6 && wt.id == 7
}


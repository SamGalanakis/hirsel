const TIERED_GET_MIN: u64 = 131072

const TIERED_GET_MAX: u64 = 262144

type TieredDirection: key = TieredPoint | TieredForward | TieredBackward

type TieredRange: key {
    lo: u64,
    hi: u64
}

type TieredDemand: send {
    target: format.TieredTarget,
    direction: TieredDirection
}

type TieredBucketWindow: send {
    range: TieredRange,
    demands: List[u64]
}

fn tiered_bucket_range(path: String, target: format.TieredTarget, bytes_total: u64, direction: TieredDirection) -> Result[TieredRange, Error] {
    let expected = format.tiered_frame_id(target)
    let lo = expected.offset
    let Some(width) = int.checked_add(expected.len, 16) else {
        return Error(failure_from_rep(format.disk_fault(path, lo, Malformed)))
    }
    if lo < 72 || lo > bytes_total || width > bytes_total - lo {
        return Error(failure_from_rep(format.disk_fault(path, lo, Dangling(expected.stamp))))
    }
    let hi = lo + width
    if width >= TIERED_GET_MIN {
        return Ok(TieredRange(lo: lo, hi: hi))
    }
    if bytes_total <= TIERED_GET_MIN {
        return Ok(TieredRange(lo: 0, hi: bytes_total))
    }
    match direction {
        TieredBackward => {
            let end = order.max(hi, TIERED_GET_MIN)
            Ok(TieredRange(lo: end - TIERED_GET_MIN, hi: end))
        },
        _ => {
            let begin = order.min(lo, bytes_total - TIERED_GET_MIN)
            Ok(TieredRange(lo: begin, hi: begin + TIERED_GET_MIN))
        },
    }
}

// One pass over one immutable pack's ranges. Output windows retain the
// caller's demand indices even when delivery order differs from byte order.
fn tiered_bucket_windows(path: String, pack_ref: HistoryRef, demands: List[TieredDemand]) -> Result[List[TieredBucketWindow], Error] {
    let demand_count = list.len(demands)
    let mut expanded: List[(TieredRange, u64)] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut expanded, demand_count)))?
    for slot in 0u64 .. demand_count {
        let demand = demands[slot]
        let expected = format.tiered_frame_id(demand.target)
        if expected.pack != pack_ref.seq {
            return Error(failure_from_rep(format.disk_fault(path, expected.offset, Dangling(expected.stamp))))
        }
        let window = tiered_bucket_range(path, demand.target, pack_ref.len, demand.direction)?
        list.push(mut expanded, (window, slot))
    }
    list.sort(mut expanded, fn(a: (TieredRange, u64), b: (TieredRange, u64)) -> Order {
        order.compare((a.0 .lo, a.0 .hi, a.1), (b.0 .lo, b.0 .hi, b.1))
    })
    let mut windows: List[TieredBucketWindow] = list.new()
    for (window, slot) in expanded {
        let n = list.len(windows)
        if n != 0 {
            let previous = windows[n - 1].range
            let end = order.max(previous.hi, window.hi)
            if window == previous || end - previous.lo <= TIERED_GET_MAX {
                failure_result_from_rep(types.capacity(list.try_reserve(mut windows[n - 1].demands, 1)))?
                windows[n - 1].range.hi = end
                list.push(mut windows[n - 1].demands, slot)
                continue
            }
        }
        let mut members: List[u64] = list.new()
        failure_result_from_rep(types.capacity(list.try_reserve(mut members, 1)))?
        failure_result_from_rep(types.capacity(list.try_reserve(mut windows, 1)))?
        list.push(mut members, slot)
        list.push(mut windows, TieredBucketWindow(range: window, demands: take members))
    }
    Ok(take windows)
}

fn read_tiered_bucket_window(mut client: std.object.Client, pack_ref: HistoryRef, window: TieredRange, deadline: u64) -> Result[Bytes, Error] waits {
    let path = history_key("p-", pack_ref)
    let mut raw: Bytes = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut raw, window.hi - window.lo)))?
    history_range(mut client, path, pack_ref, window.lo, window.hi, mut raw, deadline)?
    Ok(take raw)
}

type TieredBucketGet: send {
    pack_ref: HistoryRef,
    window: TieredRange,
    deadline: u64
}

fn read_tiered_bucket_windows(mut client: std.object.Client, gets: List[TieredBucketGet], streams: u64) -> Result[List[Result[Bytes, Error]], Error] waits {
    let width = list.len(gets)
    let prepared = disk_allocation(scoped fn() -> Result[List[std.object.GetRange], Error] {
        let mut requests: List[std.object.GetRange] = list.with_capacity(width)
        for read in gets {
            let window = read.window
            let target_name = history_key("p-", read.pack_ref)
            let out: Bytes = list.with_capacity(window.hi - window.lo)
            list.push(mut requests, std.object.GetRange(key: take target_name, lo: window.lo, hi: window.hi, buffer: take out, deadline: read.deadline))
        }
        Ok(take requests)
    })?
    let responses = std.object.fetch_ranges(mut client, take prepared, streams)
    let mut outcomes: List[Result[Bytes, Error]] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut outcomes, width)))?
    let mut at = 0u64
    for take response in take responses {
        let (take status, take raw) = take response
        let read = gets[at]
        let path = history_key("p-", read.pack_ref)
        let item: Result[Bytes, Error] = match take status {
            Ok(meta) => {
                if meta.size != read.pack_ref.len || list.len(raw) != read.window.hi - read.window.lo {
                    Error(failure_from_rep(format.disk_fault(path, read.window.lo, Truncated)))
                } else {
                    Ok(take raw)
                }
            },
            Error(NotFound) => Error(history_missing_object(path, read.pack_ref)),
            Error(take problem) => Error(Remote(take problem)),
        }
        list.push(mut outcomes, take item)
        at += 1
    }
    Ok(take outcomes)
}

fn tiered_window_cache_key(request: TieredBucketGet) -> Result[(String, Option[u64]), Error] {
    if request.window.lo == 0 && request.window.hi == request.pack_ref.len {
        return Ok((history_read_key("p-", request.pack_ref)?, Some(request.pack_ref.digest)))
    }
    failure_result_from_rep(types.capacity(bound bytes 104 {
        let mut path = string.with_capacity(104)
        history_fill_key(mut path, "p-", request.pack_ref)
        string.push(mut path, "-")
        string.push_u64(mut path, request.window.lo)
        string.push(mut path, "-")
        string.push_u64(mut path, request.window.hi)
        (take path, None)
    }))
}

fn tiered_window_cached(cache: ObjectsCache, request: TieredBucketGet) -> Option[Bytes] waits {
    let width = request.window.hi - request.window.lo
    if width > cache.capacity_bytes {
        return None
    }
    let Ok((take path, expected)) = tiered_window_cache_key(request) else {
        return None
    }
    let trailer = if expected == None {
        8u64
    } else {
        0u64
    }
    let Ok(take buffer) = disk_read_buffer(width + trailer) else {
        return None
    }
    let mut raw = take buffer
    if pack_cache_read(cache, path, width, expected, mut raw) {
        Some(take raw)
    } else {
        None
    }
}

fn tiered_window_cache_store(cache: ObjectsCache, request: TieredBucketGet, raw: Bytes) waits {
    let Ok((take path, expected)) = tiered_window_cache_key(request) else {
        return
    }
    if let Some(digest) = expected {
        if std.check.xxh3(raw, 0, list.len(raw)) != digest {
            return
        }
    }
    pack_cache_write(cache, path, raw, expected == None)
}

fn tiered_window_cache_discard(cache: ObjectsCache, request: TieredBucketGet) waits {
    if let Ok((take path, _)) = tiered_window_cache_key(request) {
        pack_cache_discard(cache, path)
    }
}

fn read_checked_bucket_window[T](mut client: std.object.Client, cache: Option[ObjectsCache], request: TieredBucketGet, check: scoped[view] fn(Bytes) -> Result[T, Error]) -> Result[(Bytes, T), Error] waits {
    if let Some(local) = cache {
        if let Some(take raw) = tiered_window_cached(local, request) {
            if let Ok(take checked_frame) = check(raw) {
                return Ok((take raw, take checked_frame))
            }
            tiered_window_cache_discard(local, request)
        }
    }
    let raw = read_tiered_bucket_window(mut client, request.pack_ref, request.window, request.deadline)?
    let checked_frame = check(raw)?
    if let Some(local) = cache {
        tiered_window_cache_store(local, request, raw)
    }
    Ok((take raw, take checked_frame))
}

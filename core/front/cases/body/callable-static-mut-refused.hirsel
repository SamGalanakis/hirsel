fn alias[T](f: StaticFn[fn(mut T, mut T)], mut x: T) {
    let g = code.callable(f)
    g(mut x, mut x)
}
fn view_later[T](f: StaticFn[fn(mut T, T)], mut x: T) {
    let g = code.callable(f)
    g(mut x, x)
}
fn frozen[T](f: StaticFn[fn(mut T)], mut x: T) {
    let held = view x
    let g = code.callable(f)
    g(mut x)
    let _ = held
}

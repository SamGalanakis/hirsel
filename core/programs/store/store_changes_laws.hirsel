@test
fn test_look_task(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "look_task", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "look_task", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, t, 1, 41) {
        return Error(())
    }
    let payload = TypedReader(read_handle: result.unwrap(reader(db, 0)), held: snapshot(db), sh: clone(t))
    let read_source = task.spawn(tasks, bytes 1048576, take payload, fn(take p: TypedReader) -> bool waits {
        let seen = result.unwrap(look(p.read_handle, p.held, None, p.sh, fn(tx, call_env) -> Result[Option[u64], Error] {
            fetch(tx, call_env, 1)
        }))
        match take seen {
            Seen(x) => match x.value {
                Ok(Some(41)) => list.len(x.reads) == 1 && x.version == version(p.held),
                _ => false
            },
            _ => false
        }
    })
    if !typed_put(mut db, t, 1, 42) {
        return Error(())
    }
    result.unwrap(close(take db))
    if result.unwrap(task.join(take read_source)) {
        Ok(())
    } else {
        Error(())
    }
}

// L23: identity checks precede the equal-empty-root shortcut. Different branches
// of one open are allowed; stores and opens are not interchangeable.
pub fn law_changes_identity(c: Clock) -> bool waits {
    let db = test_db(c, 1073741824)
    let a = snapshot(db)
    let other_open = Snapshot(store: a.store, open: 1, branch: 0, head: 0, roots: pages.empty_roots(), watermark: 1, bases: pages.no_tail_bases())
    let other_store = Snapshot(store: StoreId(hi: 9, lo: 9), open: 0, branch: 0, head: 0, roots: pages.empty_roots(), watermark: 1, bases: pages.no_tail_bases())
    let br = Snapshot(store: a.store, open: a.open, branch: 9, head: 0, roots: pages.empty_roots(), watermark: 1, bases: pages.no_tail_bases())
    if !is_foreign(changes(law_reader(a), a, other_open)) || !is_foreign(changes(law_reader(a), a, other_store)) {
        return false
    }
    list.len(result.unwrap(changes(law_reader(a), a, br)).rows) == 0
}

@test
fn test_changes_identity(c: Clock) -> Result[(), ()] {
    if law_changes_identity(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn info_helper(mut tx: Tx) -> u64 {
    info(mut tx).id.version
}

// G2 positive control: run and a mut-Tx helper both have honest CallInfo.
pub fn law_info_mut(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    for _ in 0u64 .. 2 {
        let expected = pages.holder_heads(db.holders)[0].head + 1
        let outcome = result.unwrap(run(mut db, None, expected, fn(mut tx, call_env) -> Result[bool, ()] {
            let direct = info(mut tx).id.version
            let indirect = info_helper(mut tx)
            Ok(direct == call_env && indirect == call_env)
        }))
        match take outcome {
            Committed(done) => if !done.value {
                return false
            },
            _ => return false
        }
    }
    true
}

@test
fn test_info_mut(c: Clock) -> Result[(), ()] waits {
    if law_info_mut(c) {
        Ok(())
    } else {
        Error(())
    }
}

// L-TAIL (STORE-SPEC §1.14 "The tail"): a Tx's tail of a projection is the
// keys whose rows differ between the projector's published position and the
// Tx's own view, staged writes included, each with its row in that view.
// Oracle: a model map of the source, saved at each publication and folded
// into the expected difference by key; it never reads the store.
type TailRows = List[(u64, Option[u64])]

fn tail_model_write(mut db: Db, mut model: Map[u64, u64], t: Table[u64, u64], k: u64, v: Option[u64]) -> Result[(), Error] waits {
    let input: (Table[u64, u64], u64, Option[u64]) = (clone(t), k, v)
    let ran = run(mut db, Some(PROJECTOR_LAW_STEPS), input, fn(mut tx, env) -> Result[(), Error] {
        match env.2 {
            Some(value) => put(mut tx, env.0, env.1, value),
            None => {
                let _ = delete(mut tx, env.0, env.1)?
                Ok(())
            },
        }
    })?
    let Committed(_) = ran else {
        return Error(MigrationFault)
    }
    match v {
        Some(value) => {
            let _ = map.insert(mut model, k, value)
        },
        None => {
            let _ = map.remove(mut model, k)
        },
    }
    Ok(())
}

fn tail_expected(base: Map[u64, u64], now: Map[u64, u64]) -> TailRows {
    let mut out: TailRows = list.new()
    for k in 0u64 .. 64 {
        let row = option.copied(map.get(now, k))
        if option.copied(map.get(base, k)) != row {
            list.push(mut out, (k, row))
        }
    }
    take out
}

// The whole tail in pages of two rows; None when the Tx has no base.
fn tail_pages(tx: Tx, env: (ProjectionDecl, Table[u64, u64])) -> Result[Option[TailRows], Error] {
    let mut rows: TailRows = list.new()
    let mut resume: Option[Bytes] = None
    loop {
        let Some(take page) = read_tail(tx, env.0, env.1, take resume, Limits(rows: 2, byte_limit: 4096))? else {
            return Ok(None)
        }
        let Tail(rows: take found, next: take after) = take page
        for row in found {
            list.push(mut rows, row)
        }
        let Some(take at) = take after else {
            return Ok(Some(take rows))
        }
        resume = Some(take at)
    }
}

fn tail_image(db: Db, fixture: ProjectorFixture) -> Result[Image, Error] waits {
    let Some(image) = read_projection(db, fixture.decl)?.image else {
        return Error(MigrationFault)
    }
    Ok(image)
}

fn law_tail(mut db: Db, fixture: ProjectorFixture, tiered: bool) -> Result[(), Error] waits {
    let t: Table[u64, u64] = clone(fixture.source_table)
    let steps = Limits(rows: 64, byte_limit: 65536)
    let mut model: Map[u64, u64] = map.new()
    let (pin_bytes, call_steps) = if tiered {
        (VALUE_LIMIT + 1048576, Some(PROJECTOR_LAW_STEPS))
    } else {
        (0u64, None)
    }
    let r = reader(db, pin_bytes)?
    // No image yet: no base.
    if look_tail(r, snapshot(db), fixture, t, call_steps)? != None {
        fail("tail: a projection with no image has a base")
    }
    for k in 0u64 .. 10 {
        tail_model_write(mut db, mut model, t, k, Some(k * 10))?
    }
    project_until_idle(mut db, steps)?
    let first = tail_image(db, fixture)?
    tail_model_write(mut db, mut model, t, 3, Some(33))?
    tail_model_write(mut db, mut model, t, 4, None)?
    tail_model_write(mut db, mut model, t, 12, Some(120))?
    project_until_idle(mut db, steps)?
    let base: Map[u64, u64] = clone(model)
    let image = tail_image(db, fixture)?
    // Two publications fill both pin slots, with different roots.
    if image.slot == first.slot {
        fail("tail: the two publications share a pin slot")
    }
    tail_model_write(mut db, mut model, t, 5, Some(55))?
    tail_model_write(mut db, mut model, t, 6, None)?
    tail_model_write(mut db, mut model, t, 20, Some(200))?
    tail_model_write(mut db, mut model, t, 7, Some(70))?
    if tiered {
        checkpoint_tail_pin(mut db, fixture, image)?
    }
    let committed: Map[u64, u64] = clone(model)
    let held = snapshot(db)
    // A run's tail holds its own writes: a new key, a delete of a base key,
    // and neither a key put back to its base row nor one added and deleted.
    let input: (ProjectionDecl, Table[u64, u64]) = (clone(fixture.decl), clone(t))
    let ran = run(mut db, call_steps, input, fn(mut tx, env) -> Result[Option[TailRows], Error] {
        put(mut tx, env.1, 21, 210)?
        put(mut tx, env.1, 5, 50)?
        let _ = delete(mut tx, env.1, 20)?
        let _ = delete(mut tx, env.1, 8)?
        put(mut tx, env.1, 3, 33)?
        tail_pages(tx, env)
    })?
    let Committed(Done(value: Some(take own), ..)) = take ran else {
        fail("tail: the run read no tail")
    }
    let _ = map.insert(mut model, 21, 210)
    let _ = map.insert(mut model, 5, 50)
    let _ = map.remove(mut model, 20)
    let _ = map.remove(mut model, 8)
    if own != tail_expected(base, model) {
        fail("tail: a run's tail differs from the model difference")
    }
    // A Snapshot the projector has since stepped past keeps its own base.
    project_until_idle(mut db, steps)?
    if look_tail(r, held, fixture, t, call_steps)? != Some(tail_expected(base, committed)) {
        fail("tail: an older Snapshot's tail differs from the model difference")
    }
    // Another table is not the projection's source: no base.
    if look_tail(r, snapshot(db), fixture, fixture.second_table, call_steps)? != None {
        fail("tail: another table has a base")
    }
    Ok(())
}

fn look_tail(r: Reader, s: Snapshot, fixture: ProjectorFixture, t: Table[u64, u64], steps: Option[u64]) -> Result[Option[TailRows], Error] waits {
    let input: (ProjectionDecl, Table[u64, u64]) = (clone(fixture.decl), clone(t))
    let Seen(Seen(value: take found, ..)) = look(r, s, steps, input, tail_pages)? else {
        return Error(MigrationFault)
    }
    take found
}

@test
fn test_tail(c: Clock) -> Result[(), Error] waits {
    let mut db = test_db(c, 1073741824)
    let fixture = projector_fixture(mut db, Migrate, Own, cadence())?
    law_tail(mut db, fixture, false)
}

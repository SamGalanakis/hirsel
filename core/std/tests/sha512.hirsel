// test-vectors
// test-env: HIRSEL_SHA512=portable
fn matches512(digest: Inline[u8, 64], expected: Bytes, at: u64) -> bool {
    for word in 0u64 .. 8u64 {
        let actual: u64 = inline.word_be(digest, word * 8)
        let wanted: u64 = list.word_be(expected, at + word * 8)
        if actual != wanted {
            return false
        }
    }
    true
}

fn matches384(digest: Inline[u8, 48], expected: Bytes, at: u64) -> bool {
    for word in 0u64 .. 6u64 {
        let actual: u64 = inline.word_be(digest, word * 8)
        let wanted: u64 = list.word_be(expected, at + word * 8)
        if actual != wanted {
            return false
        }
    }
    true
}

// H1. Every record of NIST CAVP's four byte-oriented response files.
// expect: run cavp_512_short() = true
fn cavp_512_short() -> bool {
    for row in cavp_512_short_data() {
        let (message, digest) = row
        if !matches512(sha512.hash(message), digest, 0) {
            return false
        }
    }
    true
}

// expect: run cavp_512_long() = true
fn cavp_512_long() -> bool {
    for row in cavp_512_long_data() {
        let (message, digest) = row
        if !matches512(sha512.hash(message), digest, 0) {
            return false
        }
    }
    true
}


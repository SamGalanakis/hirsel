fn history_check_list_pack(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, cache: Option[pager.ObjectsCache], id: types.StoreKey, seq: u64, next_stamp: u64, offsets: List[u64]) -> Result[pages.PagePack, types.Failure] waits {
    let item: pages.HistoryRef = clone(option.unwrap(map.get(history.locator_rows(locator), seq)))
    let path = history.history_read_key("p-", item)?
    let mut stream = history.history_pack_stream(item)?
    if let Some(local) = cache {
        if let Some(take file) = history.pack_cache_open(local, path, item.len) {
            history.pack_stream_cache(mut stream, take file)
            let verified = history.history_scan_list_pack(mut client, deadline, path, mut stream, id, next_stamp, offsets)
            if let Ok(found) = verified {
                return Ok(found)
            }
            history.pack_stream_refetch(mut stream)
            history.pack_cache_discard(local, path)
        }
        if let Some((take locked, take file)) = pack_cache_stage(local, path, item.len) {
            history.pack_stream_stage(mut stream, take file)
            let checked = history.history_scan_list_pack(mut client, deadline, path, mut stream, id, next_stamp, offsets)
            if let Some(take staged) = history.pack_stream_staged(mut stream) {
                if let Ok(_) = checked {
                    history.pack_cache_publish(local.dir, path, take staged)
                }
            }
            let _ = host.remove(local.dir, history.PACK_CACHE_INCOMING)
            drop(take locked)
            return take checked
        }
    }
    history.history_scan_list_pack(mut client, deadline, path, mut stream, id, next_stamp, offsets)
}

pub fn history_load_data_pack(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, cache: Option[pager.ObjectsCache], id: types.StoreKey, seq: u64, pack: pages.PagePack, next_stamp: u64) -> Result[(String, manifest.LoadedPack), types.Failure] waits {
    let item: pages.HistoryRef = clone(option.unwrap(map.get(history.locator_rows(locator), seq)))
    let name = history.history_read_key("p-", item)?
    let frame_room = if pack.class == 0 {
        manifest.PAGE_LIMIT
    } else {
        manifest.BLOB_LIMIT
    }
    let rows: u64 = int.widen(pack.frames)
    if item.len > 72 + rows * (16 + frame_room) + manifest.UNKNOWN_ROOM {
        return Error(Corrupt(types.FaultRep(file: take name, offset: 0, why: Malformed)))
    }
    let (take raw, verified) = match cache {
        Some(local) if item.len <= local.capacity_bytes => {
            let mut bytes_in = manifest.disk_read_buffer(item.len)?
            history_read_pack(mut client, name, item, local, mut bytes_in, deadline)?
            (take bytes_in, true)
        },
        _ => (history.history_read_object(mut client, name, item, deadline)?, false),
    }
    let payloads = manifest.disk_allocation(scoped fn() -> Result[Map[u64, format.DiskFrame], types.Failure] {
        let ctx = history.history_object_context(name, id, 3, item, raw)?
        if !verified {
            history.history_object_digest(name, item, raw)?
        }
        manifest.index_pack_frames(name, ctx, pack, next_stamp, raw)
    })?
    Ok((take name, manifest.LoadedPack(class: pack.class, payloads: take payloads, raw: take raw)))
}

pub fn history_validate_manifest(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, id: types.StoreKey, file: String, take page_record: manifest.PageManifest, cache: Option[pager.ObjectsCache]) -> Result[manifest.ValidatedPageManifest, types.Failure] waits {
    validate_bucket_graph(mut client, locator, deadline, id, file, take page_record, true, cache)
}

pub fn validate_bucket_graph(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, id: types.StoreKey, file: String, take page_record: manifest.PageManifest, allow_tiered: bool, cache: Option[pager.ObjectsCache]) -> Result[manifest.ValidatedPageManifest, types.Failure] waits {
    validate_bucket_preview(mut client, locator, deadline, id, file, take page_record, allow_tiered, cache, None)
}

pub fn validate_bucket_preview(mut client: std.object.Client, locator: history.HistoryLocator, deadline: u64, id: types.StoreKey, file: String, take page_record: manifest.PageManifest, allow_tiered: bool, cache: Option[pager.ObjectsCache], preview: Option[View[pager.PreviewRead]]) -> Result[manifest.ValidatedPageManifest, types.Failure] waits {
    pager.require_preview(preview, id, page_record.origin)?
    let blank = manifest.PageGraph(stamps: map.new(), frames: map.new(), postorder: list.new())
    let mut lists = manifest.empty_listed_pages(allow_tiered, take blank)
    let mut final_item: Option[u64] = None
    manifest.read_page_list(mut client, id, page_record, page_record.pack_root, None, PackList, mut final_item, mut lists, scoped fn(mut reader_client: std.object.Client, store_id: types.StoreKey, ptr: std.page.PagePtr) -> Result[(String, std.page.Image), types.Failure] waits {
        history.history_list_page(mut reader_client, locator, deadline, cache, store_id, ptr)
    })?
    final_item = None
    manifest.read_page_list(mut client, id, page_record, page_record.deferred_frees, None, DeferredList, mut final_item, mut lists, scoped fn(mut reader_client: std.object.Client, store_id: types.StoreKey, ptr: std.page.PagePtr) -> Result[(String, std.page.Image), types.Failure] waits {
        history.history_list_page(mut reader_client, locator, deadline, cache, store_id, ptr)
    })?
    final_item = None
    manifest.read_page_list(mut client, id, page_record, page_record.lineage, None, LineageList, mut final_item, mut lists, scoped fn(mut reader_client: std.object.Client, store_id: types.StoreKey, ptr: std.page.PagePtr) -> Result[(String, std.page.Image), types.Failure] waits {
        history.history_list_page(mut reader_client, locator, deadline, cache, store_id, ptr)
    })?
    manifest.validate_lineage_forks(file, page_record, lists.lineage.forks)?
    for (seq, _) in lists.class_two {
        if map.contains(lists.packs, seq) || !map.contains(history.locator_rows(locator), seq) {
            return Error(format.disk_fault(file, 72, Malformed))
        }
    }
    let mut local_count = map.len(lists.class_two)
    let mut seqs: List[u64] = list.new()
    types.capacity(list.try_reserve(mut seqs, map.len(lists.packs)))?
    for (seq, pack) in lists.packs {
        if let Some(ref) = pack.foreign {
            let Some(source) = preview else {
                return Error(Missing("preview archive"))
            }
            pager.preview_check_pack(source, seq, pack)?
            if map.contains(history.locator_rows(locator), seq) || (pack.class >= 3 && pack.payload_bytes != ref.len) {
                return Error(format.disk_fault(file, 72, Malformed))
            }
            if pack.class < 2 || pack.class == 4 {
                list.push(mut seqs, seq)
            }
            continue
        }
        local_count += 1
        let Some(located) = map.get(history.locator_rows(locator), seq) else {
            return Error(format.disk_fault(file, 72, Malformed))
        }
        if pack.class < 3 || pack.class == 4 {
            list.push(mut seqs, seq)
        }
        if pack.class >= 3 && located.len != pack.payload_bytes {
            return Error(format.disk_fault(file, 72, Malformed))
        }
    }
    if map.len(history.locator_rows(locator)) != local_count {
        return Error(format.disk_fault(file, 72, Malformed))
    }
    for (seq, offsets) in lists.class_two {
        let pack = history_check_list_pack(mut client, locator, deadline, cache, id, seq, page_record.next_stamp, offsets)?
        types.capacity(map.try_reserve(mut lists.packs, 1))?
        map.insert(mut lists.packs, seq, pack)
    }
    for queued in lists.deferred {
        let inventory = manifest.RecoveryInventory(packs: view lists.packs, next_stamp: page_record.next_stamp, allow_tiered: allow_tiered)
        manifest.validate_deferred_target(inventory, queued.target)?
    }
    let mut pending: Map[u64, List[history.LocatedNeed]] = map.new()
    for holder in page_record.branches {
        history.history_want_roots(mut pending, holder.roots)?
    }
    for held in page_record.pins {
        history.history_want_roots(mut pending, held.roots)?
    }
    list.sort(mut seqs, fn(a: u64, b: u64) -> Order {
        order.compare(b, a)
    })
    for seq in seqs {
        let pack = option.unwrap(map.get(lists.packs, seq))
        if pack.class == 4 && !map.contains(pending, seq) {
            continue
        }
        let (take name, take loaded) = if let Some(ref) = pack.foreign {
            let Some(source) = preview else {
                return Error(Missing("preview archive"))
            }
            (pager.preview_pack_key(source, seq, ref)?, pager.preview_memory_pack(source, seq, pack, page_record.next_stamp)?)
        } else {
            history_load_data_pack(mut client, locator, deadline, cache, id, seq, pack, page_record.next_stamp)?
        }
        let inventory = manifest.RecoveryInventory(packs: view lists.packs, next_stamp: page_record.next_stamp, allow_tiered: allow_tiered)
        history.history_resolve_pack(name, loaded, inventory, seq, mut pending, mut lists.live_graph)?
    }
    for (seq, frames) in pending {
        let (offset, stamp) = match frames[0] {
            NeedPage(ptr, _, _) => (ptr.offset, ptr.stamp),
            NeedBlob(reference) => (reference.offset, reference.stamp),
        }
        let name = manifest.paged_pack_path(seq)?
        return Error(format.disk_fault(name, offset, Dangling(stamp)))
    }
    let manifest.ListedPages(packs: take inventory, lineage: take lineage, live_graph: take graph, ..) = take lists
    let mut ordered = take graph
    history.history_graph_order(mut ordered)
    Ok(manifest.ValidatedPageManifest(manifest: take page_record, inventory: take inventory, lineage: take lineage, graph: take ordered, allow_tiered: allow_tiered))
}

pub fn history_open_checkpoint(mut source: history.ObjectPackRead, head: history.HistoryHead, mark: history.HistoryMark, checkpoint_data: Bytes, take page_record: manifest.PageManifest, ceiling: u64) -> Result[(pager.JournalReplay, manifest.LoadedPageStore), types.Failure] waits {
    source.locator = history.history_locator(mut source.client, head, mark, checkpoint_data, source.deadline)?
    let name = history.history_read_key("m-", mark.manifest)?
    let cache = history.pack_cache_directory(source.cache)
    if let Some(local) = cache {
        pack_cache_trim(local)
    }
    if source.archiving {
        manifest.independent_source(page_record.origin)?
    }
    let preview = match view source.preview {
        Some(s) => Some(view s),
        None => None,
    }
    let validated = validate_bucket_preview(mut source.client, source.locator, source.deadline, head.store, name, take page_record, true, cache, preview)?
    let loaded = history.rebuild_page_store(take validated, Some(view source.locator))?
    let initial = manifest.disk_allocation(scoped fn() -> Result[pages.State, types.Failure] {
        types.capacity(manifest.manifest_state(loaded.manifest, loaded.holders))
    })?
    let mut replay = pager.journal_replay_manifest(take initial, loaded.manifest)?
    if source.writer_claim {
        let mut inventory: Option[Arc[pages.TieredReadInventory]] = None
        for held in loaded.holders {
            if let Some(paging) = view held.collections.paging {
                inventory = Some(arc.share(paging))
                break
            }
        }
        replay.claim_packs = Some(pager.ClaimPacks(disk: manifest.claim_pack_disk(loaded.manifest.next_pack), generation: loaded.manifest.generation, checkpoint: take inventory))
    }
    replay.next_node = order.max(replay.next_node, cell.get(source.direct_floor))
    catalog.over_ceiling(journal.journal_account(replay)?, ceiling)?
    Ok((take replay, take loaded))
}

pub fn check_paused_checkpoint(mut lane: ObjectJournalSession) -> Result[(), types.Failure] waits {
    let head = paused_head(lane)
    let deadline = paused_deadline(lane)
    teardown_validate_bucket_checkpoint(mut lane.client, head, deadline)
}

pub fn teardown_validate_bucket_checkpoint(mut client: std.object.Client, head: history.HistoryHead, deadline: u64) -> Result[(), types.Failure] waits {
    if head.checkpoint.seq == 0 {
        return Ok(())
    }
    let (take mark, take checkpoint_data) = history.history_checkpoint(mut client, head, deadline)?
    let manifest = history.history_read_manifest(mut client, head.store, mark, head.checkpoint.seq, deadline)?
    let locator = history.history_locator(mut client, head, mark, checkpoint_data, deadline)?
    let name = history.history_read_key("m-", mark.manifest)?
    let _ = validate_bucket_graph(mut client, locator, deadline, head.store, name, take manifest, true, None)?
    Ok(())
}

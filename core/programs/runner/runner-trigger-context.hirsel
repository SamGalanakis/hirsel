// Module runner: authority for calls from a granted trigger attempt.
pub opaque type TriggerContext: send {
    attempt: triggers.Attempt,
    to: Sender[HeadInput]
}

pub fn share_trigger_context(ctx: TriggerContext) -> TriggerContext {
    TriggerContext(attempt: ctx.attempt, to: channel.sender(ctx.to))
}

pub fn trigger_attempt(ctx: TriggerContext) -> triggers.Attempt {
    ctx.attempt
}

pub fn use_trigger_tables[G: send, H: shareable + inert + send](mut r: Registry[G, H], take select: own[send] fn(H) -> triggers.Tables) {
    r.trigger_tables = Some(take select)
}

fn declared_triggers[G: send, H: shareable + inert + send](r: Registry[G, H], h: H, snap: store.Snapshot) -> Result[Option[triggers.Tables], store.Error] {
    if let Some(select) = view r.trigger_tables {
        return Ok(Some(select(h)))
    }
    if triggers.present(snap)? {
        return Error(Missing("trigger table selector"))
    }
    Ok(None)
}

// The place's one grant source (RUNNER-SPEC v2.67). One grant task owns the
// seed and mints a fresh G for each granted trigger attempt (`attempt`) and
// each wire call to a Granted entry or keyed claim (`call`).
pub type Grants[G: send, H: shareable + inert + send, S: send]: send {
    seed: S,
    attempt: Option[fn(S, H, take TriggerContext) -> Result[G, Capacity] waits],
    call: Option[fn(S, H) -> Result[G, Capacity] waits],
    grant_bytes: u64,
}

type GrantFor: send = ForAttempt(TriggerContext) | ForCall

pub opaque type GrantRequest[G: send]: send {
    why: GrantFor,
    reply: Sender[Result[G, Capacity]]
}

type GrantWorker[G: send, H: shareable + inert + send, S: send]: send {
    grants: S,
    handles: H,
    attempt: Option[fn(S, H, take TriggerContext) -> Result[G, Capacity] waits],
    call: Option[fn(S, H) -> Result[G, Capacity] waits],
    inbox: Receiver[GrantRequest[G]],
}

// The running grant task and the senders it serves: `attempts` only with an
// attempt mint, `calls` only with a call mint.
pub opaque type PlaceGrants[G: send] {
    attempts: Option[Sender[GrantRequest[G]]],
    calls: Option[Sender[GrantRequest[G]]],
    worker: Task[()],
}

fn supply_grants[G: send, H: shareable + inert + send, S: send](take supply: GrantWorker[G, H, S]) -> () waits {
    // A mint may wait. Keep it off the head and the sessions it serves.
    while let Ok(take request) = channel.receive(supply.inbox) {
        let GrantRequest(why: take why, reply: take reply) = take request
        let given = match take why {
            ForAttempt(take ctx) => match supply.attempt {
                Some(mint) => mint(supply.grants, supply.handles, take ctx),
                None => Error(Capacity(requested: 0u64, available: 0u64)),
            },
            ForCall => match supply.call {
                Some(mint) => mint(supply.grants, supply.handles),
                None => Error(Capacity(requested: 0u64, available: 0u64)),
            },
        }
        let _ = channel.send(reply, take given)
    }
}

// The grant channel exists before the head makes H, so the serving task can
// hold a call sender while the head starts the grant task.
type GrantStart[G: send, H: shareable + inert + send, S: send]: send {
    grants: Grants[G, H, S],
    to: Sender[GrantRequest[G]],
    inbox: Receiver[GrantRequest[G]],
}

fn grant_start[G: send, H: shareable + inert + send, S: send](take given: Grants[G, H, S]) -> GrantStart[G, H, S] {
    let (to, inbox): (Sender[GrantRequest[G]], Receiver[GrantRequest[G]]) = channel.new(1u64)
    GrantStart(grants: take given, to: take to, inbox: take inbox)
}

fn grant_calls[G: send, H: shareable + inert + send, S: send](starting: GrantStart[G, H, S]) -> Option[Sender[GrantRequest[G]]] {
    match starting.grants.call {
        Some(_) => Some(channel.sender(starting.to)),
        None => None
    }
}

fn start_grants[G: send, H: shareable + inert + send, S: send](tasks: Tasks, h: H, take starting: GrantStart[G, H, S]) -> PlaceGrants[G] {
    let GrantStart(grants: take given, to: take to, inbox: take inbox) = take starting
    let Grants(seed: take seed, attempt: attempt_mint, call: call_mint, grant_bytes: allowance) = take given
    let attempts = match attempt_mint {
        Some(_) => Some(channel.sender(to)),
        None => None
    }
    let calls = match call_mint {
        Some(_) => Some(channel.sender(to)),
        None => None
    }
    let supply = GrantWorker(grants: take seed, handles: store.copy_env(h), attempt: attempt_mint, call: call_mint, inbox: take inbox)
    let run: fn(take GrantWorker[G, H, S]) -> () waits = supply_grants
    let serving = task.spawn(tasks, bytes allowance, take supply, run)
    PlaceGrants(attempts: take attempts, calls: take calls, worker: take serving)
}

// A grant task outside a place's head, for a session served without one (the
// wire fixtures). `h` is whatever the mints read; a place passes its handles.
pub fn grant_task[G: send, H: shareable + inert + send, S: send](tasks: Tasks, h: H, take given: Grants[G, H, S]) -> PlaceGrants[G] {
    start_grants(tasks, h, grant_start(take given))
}

pub fn grant_calls_of[G: send](running: PlaceGrants[G]) -> Option[Sender[GrantRequest[G]]] {
    match running.calls {
        Some(to) => Some(channel.sender(to)),
        None => None
    }
}

pub fn stop_grants[G: send](take running: Option[PlaceGrants[G]]) -> () waits {
    if let Some(PlaceGrants(worker: take serving, ..)) = take running {
        let _ = task.cancel_join(take serving)
    }
}

fn place_grant[G: send](to: Sender[GrantRequest[G]], take why: GrantFor) -> Result[G, Outcome] waits {
    let (reply, inbox): (Sender[Result[G, Capacity]], Receiver[Result[G, Capacity]]) = channel.new(1u64)
    if let Error(_) = channel.send(to, GrantRequest(why: take why, reply: take reply)) {
        return Error(Failed(Gone))
    }
    match channel.receive(inbox) {
        Ok(Ok(take given)) => Ok(take given),
        Ok(Error(cap)) => Error(Failed(OutOfBytes(capacity_room(cap)))),
        Error(_) => Error(Failed(Gone)),
    }
}

// Module platform, the deploy preview and its decision (launch.md "Deploy preview"): the
// hold of a request whose grant diff awaits a person, the Decide that ends it, and the
// entry and trigger parts of a deploy's preview.
fn same_grants(a: launcher.Grants, b: launcher.Grants) -> bool {
    a.added == b.added && a.dropped == b.dropped
}

// Request d waits for a person's decision on grant diff `diff`, durably and with no attempt,
// so a restart or a lost connection keeps the hold (launch.md "Deploy preview").
fn hold(mut h: Host, d: Bytes, diff: launcher.Grants) waits {
    let made = {
        let t = view h.t
        let shown = view diff
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(t), store.copy_env(shown)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found) = st(store.fetch(tx, call_env.1 .requests, call_env.0))? else {
                return Ok(())
            }
            let mut row = found
            if let Some(_) = row.done {
                return Ok(())
            }
            row.held = Some(clone(call_env.2))
            st(store.put(mut tx, call_env.1 .requests, call_env.0, row))?
            Ok(())
        })
    }
    if let Error(e) = decided(mut h, take made) {
        fail_request(mut h, d, class_of(e), refused_text(e))
    }
}

// A Decide (launch.md "Deploy preview"): request d must await a decision on exactly `diff`.
// A refusal fails it Denied. An approval records the diff and repeats d's admission under it,
// with a fresh attempt and deadline and `conn` as its owner; an admission that then finds
// another diff waits again.
fn decide(mut h: Host, conn: u64, d: Bytes, diff: launcher.Grants, approve: bool, now: Now, mut out: List[launcher.Request]) waits {
    let r = match request_row(h, d) {
        Ok(Some(r)) => r,
        Ok(None) => {
            refuse(mut h, conn, UnknownRequestClass, "no request has this ID")
            return
        },
        Error(_) => {
            refuse(mut h, conn, StoreClass, "the catalog could not be read")
            return
        },
    }
    let waiting = match r.held {
        Some(x) => is_none(r.done) && same_grants(x, diff),
        None => false,
    }
    if !waiting {
        refuse(mut h, conn, DeniedClass, "the request awaits no decision on this grant diff")
        return
    }
    let _ = map.remove(mut h.shown, d)
    map.insert(mut h.owners, clone(d), conn)
    if !approve {
        fail_request(mut h, d, DeniedClass, "a person refused the grant diff")
        return
    }
    let name = string.from(r.group.name)
    let g = match group_row(h, name) {
        Ok(Some(g)) if g.incarnation == r.group.incarnation => g,
        _ => {
            fail_request(mut h, d, UnknownGroupClass, "the group was removed")
            return
        },
    }
    let Some((input, foreign, exec)) = admission_ask(r.begin) else {
        fail_request(mut h, d, StoreClass, "the recorded request does not decode")
        return
    }
    if let Some((class, why)) = admission_refusal(h, name, g, d, input, foreign, exec) {
        let _ = map.remove(mut h.owners, d)
        refuse(mut h, conn, class, why)
        return
    }
    let made = {
        let t = view h.t
        let approved = view diff
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(now), store.copy_env(t), store.copy_env(approved)), fn(mut tx, call_env) -> Result[launcher.Attempt, Refused] {
            let Some(found) = st(store.fetch(tx, call_env.2 .requests, call_env.0))? else {
                return Error(Missing("request"))
            }
            if let Some(x) = st(store.fetch(tx, call_env.2 .active, found.group.name))? {
                if x != call_env.0 {
                    return Error(Busy(0u64))
                }
            }
            let mut row = found
            let a = fresh_attempt(mut tx, call_env.2)?
            row.attempt = a
            row.deadline_ms = call_env.1 .wall_ms + ADMISSION_MS
            row.held = None
            row.approved = clone(call_env.3)
            st(store.put(mut tx, call_env.2 .requests, call_env.0, row))?
            Ok(a)
        })
    }
    let a = match decided(mut h, take made) {
        Ok(a) => a,
        Error(e) => {
            let _ = map.remove(mut h.owners, d)
            refuse(mut h, conn, class_of(e), refused_text(e))
            return
        },
    }
    admit_request(mut h, name, g, d, a, input, foreign, exec, diff, now, mut out)
}

// The entry diff (launch.md "Deploy preview"): every entry OLD or NEW exports, by code
// identity, sorted by identity. An entry both export is changed when its `code.revision`
// differs; the revision covers everything the entry reaches, so a release that swaps one
// function shows as changed exactly the entries that reach it.
fn entry_diff(old: List[runner.Exported], new: List[runner.Exported]) -> List[operator.EntryLine] {
    let mut lines: List[operator.EntryLine] = list.new()
    for o in old {
        let mut change: operator.EntryChange = EntryRemoved
        for n in new {
            if n.described.identity == o.described.identity {
                change = if n.revision == o.revision {
                    EntryUnchanged
                } else {
                    EntryChanged
                }
                break
            }
        }
        list.push(mut lines, operator.EntryLine(identity: clone(o.described.identity), change: change))
    }
    for n in new {
        let mut known = false
        for o in old {
            if n.described.identity == o.described.identity {
                known = true
                break
            }
        }
        if !known {
            list.push(mut lines, operator.EntryLine(identity: clone(n.described.identity), change: EntryAdded))
        }
    }
    list.sort(mut lines, fn(a: operator.EntryLine, b: operator.EntryLine) -> Order {
        order.compare(a.identity, b.identity)
    })
    lines
}

// The prepare child's answer: its whole trigger report (launch.md "Preparing the pending
// trigger report").
fn trigger_report(b: Bytes) -> Option[runner.TriggerReport] {
    let codec: std.codec.Codec[runner.TriggerReport] = std.codec.of()
    match std.codec.decode(codec, b) {
        Ok(take report) => Some(take report),
        Error(_) => None,
    }
}

// The deploy's fates: the `held` field of its recorded Begin.
fn deploy_held(h: Host, d: Bytes) -> Result[runner.fate.Fates, Refused] waits {
    let Some(row) = request_row(h, d)? else {
        return Error(Missing("deploy request"))
    }
    let Some(BeginAsk(_, _, _, _, _, held)) = operator.decode_ask(row.begin) else {
        return Error(Missing("deploy Begin"))
    }
    Ok(clone(held))
}

// Read the contract from the original Begin, including after a grant decision or reconnect.
fn deploy_required_entries(h: Host, d: Bytes) -> Result[List[launcher.RequiredEntry], Refused] waits {
    let Some(row) = request_row(h, d)? else {
        return Error(Missing("deploy request"))
    }
    if let Source(b) = row.input {
        let Some(tree) = launcher.tree_of(b) else {
            return Error(Missing("deploy source tree"))
        }
        return Ok(clone(tree.required_entries))
    }
    Ok(list.new())
}

// Keys include both codec fingerprints. The kind also has to match how the
// publisher calls or subscribes to the entry.
fn keeps_entries(required: List[launcher.RequiredEntry], exported: List[runner.Exported]) -> bool {
    if list.len(required) == 0u64 {
        return true
    }
    let mut keys: Map[Bytes, runner.Kind] = map.new()
    for e in exported {
        let mut key: Bytes = clone(e.described.identity)
        std.codec.put_u64(e.args_fp, mut key)
        std.codec.put_u64(e.result_fp, mut key)
        map.insert(mut keys, take key, e.described.kind)
    }
    for entry in required {
        let Some(kind) = map.get(keys, entry.key) else {
            return false
        }
        let actual: runner.Kind = clone(kind)
        if actual != entry.kind {
            return false
        }
    }
    true
}

// The new image's preview receives the old image's exported list.
fn old_entries(b: Bytes) -> Option[(Bytes, List[runner.Exported], Binding)] {
    let Some(take describe) = runner.decode_description(b) else {
        return None
    }
    let Some(take binding) = binding_of(describe) else {
        return None
    }
    let runner.Describe(exported: take exported, ..) = take describe
    let list_codec: std.codec.Codec[List[runner.Exported]] = std.codec.of_list()
    let mut raw: Bytes = list.new()
    if let Error(_) = std.codec.encode(list_codec, exported, mut raw) {
        return None
    }
    Some((take raw, take exported, take binding))
}

// The canonical Describe encoding is also the prefix of the Preview encoding.
fn previewed(b: Bytes, p: Prep, count: u64) -> Result[(Bytes, Bytes, List[runner.Exported]), String] {
    let codec: std.codec.Codec[runner.Preview] = std.codec.of()
    let Ok(runner.Preview(describe: take description, release: take release, answers: take answers)) = std.codec.decode(codec, b) else {
        return Error("preview: a malformed answer")
    }
    if description.digest != p.image || description.target != p.target || description.n_place != p.n_place {
        return Error("preview does not describe the selected assembly")
    }
    if list.len(description.revision) != 32u64 {
        return Error("preview: entry revision is unavailable")
    }
    if list.len(release) != 32u64 {
        return Error("preview: the release is not 32 bytes")
    }
    if list.len(answers) != count {
        return Error("preview answer count")
    }
    let describe_codec: std.codec.Codec[runner.Describe] = std.codec.of()
    let mut raw: Bytes = list.new()
    let _ = std.codec.encode(describe_codec, description, mut raw) ?=> |_| "preview: a malformed answer"
    let runner.Describe(exported: take exported, ..) = take description
    Ok((take raw, take release, take exported))
}

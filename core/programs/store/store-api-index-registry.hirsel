type DeclaredExtractor[J, K, V, P]: send {
    table: Table[K, V],
    kind: IndexKind,
    id: u32,
    key: std.codec.Key[J],
    by: StaticFn[fn(K, V) -> Result[List[J], Capacity]],
    project: Option[catalog.IndexProjection[K, V, P]],
    cover_row: bool
}

fn extract_declared[J, K, V, P](extractor: DeclaredExtractor[J, K, V, P], raw: Bytes, primary: Bytes) -> Result[indexes.IndexValue, Error] {
    let t = view extractor.table
    let k = failure_result_from_rep(catalog.decoded(std.codec.decode_key(t.key, primary)))?
    let v = row_value(t.readers, t.id, raw)?
    let js = failure_result_from_rep(types.capacity((code.callable(extractor.by))(k, v)))?
    let mut encoded: List[Bytes] = list.new()
    for j in js {
        let mut row = failure_result_from_rep(catalog.prefix(extractor.id))?
        std.codec.encode_key(extractor.key, j, mut row)
        if let Many = extractor.kind {
            list.append(mut row, primary)
        }
        if list.len(row) > 4096 {
            return Error(Limit(Key))
        }
        list.push(mut encoded, take row)
    }
    if list.len(encoded) == 0 {
        return Ok(indexes.IndexValue(keys: take encoded, payload: list.new(), sums: list.new()))
    }
    list.sort_stable(mut encoded, list.compare_bytes)
    let mut keys: List[Bytes] = list.new()
    for take row in take encoded {
        let n = list.len(keys)
        if n == 0 || keys[n - 1] != row {
            list.push(mut keys, take row)
        }
    }
    let mut payload: Bytes = list.new()
    if let Unique = extractor.kind {
        failure_result_from_rep(types.capacity(format.blob(mut payload, primary)))?
    }
    if extractor.cover_row {
        list.append(mut payload, raw)
    } else if let Some(project) = extractor.project {
        let value = failure_result_from_rep(types.capacity((code.callable(project.by))(k, v)))?
        if let Some(number) = project.number {
            list.put_word_le(mut payload, number)
            std.codec.encode(project.codec, value, mut payload) ?=> |_| Limit(Value)
        }
    }
    if list.len(payload) > VALUE_LIMIT {
        return Error(Limit(Value))
    }
    Ok(indexes.IndexValue(keys: take keys, payload: take payload, sums: list.new()))
}

fn declare_binding[J, K, V, P](t: Table[K, V], record: indexes.Catalog, kind: IndexKind, by: StaticFn[fn(K, V) -> Result[List[J], Capacity]], key: std.codec.Key[J], take project: Option[catalog.IndexProjection[K, V, P]], cover_row: bool) -> indexes.IndexRegistration {
    let extractor: DeclaredExtractor[J, K, V, P] = DeclaredExtractor(table: clone(t), kind: kind, id: record.id, key: key, by: by, project: take project, cover_row: cover_row)
    let extract: own[send] fn(Bytes, Bytes) -> Result[indexes.IndexValue, types.Failure] = fn(raw: Bytes, primary: Bytes) -> Result[indexes.IndexValue, types.Failure] {
        failure_result_to_rep(extract_declared(extractor, raw, primary))
    }
    indexes.index_registration(t.id, t.readers.current, record, take extract, indexes.entry_key_end(key))
}

/// An index's build state (STORE-SPEC §1.2). Backfilling's cursor is the
/// last primary key whose entries are complete, None before the first
/// chunk. Failed keeps the two primary keys a chunk found under one Unique
/// key. Only Public serves reads. `attention` reports it per index.
pub type IndexState: codec + shareable + send = Backfilling(Option[Bytes]) | Public | Failed(Bytes, Bytes)

// The state tag is an index record's last byte, so a read checks Public
// without decoding the record.
fn copied_state(state: IndexState) -> Result[IndexState, Error] {
    Ok(match state {
        Public => Public,
        Backfilling(None) => Backfilling(None),
        Backfilling(Some(cursor)) => Backfilling(Some(failure_result_from_rep(types.copied(cursor))?)),
        Failed(first, second) => Failed(failure_result_from_rep(types.copied(first))?, failure_result_from_rep(types.copied(second))?),
    })
}

fn decode_catalog(raw: Bytes) -> Result[indexes.Catalog, Error] {
    failure_result_from_rep(indexes.decode_catalog(raw))
}

fn encode_catalog(record: indexes.Catalog) -> Result[Bytes, Error] {
    failure_result_from_rep(indexes.encode_catalog(record))
}

fn catalog_index(record: indexes.Catalog) -> Result[View[indexes.IndexRecord], Error] in record {
    match indexes.catalog_index(record) {
        Ok(index_record) => Ok(index_record),
        Error(take problem) => Error(failure_from_rep(take problem)),
    }
}

fn catalog_entry_in(tree: pages.PageTree, key: Bytes) -> Result[indexes.Catalog, Error] {
    failure_result_from_rep(indexes.catalog_entry_in(tree, key))
}

fn find_index_name(tree: pages.PageTree, table_id: u32, index_id: u32) -> Result[String, Error] {
    failure_result_from_rep(indexes.find_index_name(tree, table_id, index_id))
}

fn index_catalog_in(tree: pages.PageTree, table_id: u32) -> Result[List[indexes.Catalog], Error] {
    failure_result_from_rep(indexes.index_catalog_in(tree, table_id))
}

fn take_le(raw: Bytes, mut at: u64, width: u64) -> Result[u64, Error] {
    failure_result_from_rep(indexes.take_le(raw, mut at, width))
}

fn edit_frame(ops: pages.DataOps, below: List[Arc[pages.Staged]], extra: u64, key: Bytes, value_size: Option[u64], frame: Option[u64], transaction: u64) -> Result[Option[u64], Error] {
    failure_result_from_rep(indexes.edit_frame(ops, below, extra, key, value_size, frame, transaction))
}

fn entry_kind(shape: indexes.IndexShape) -> Result[IndexKind, Error] {
    Ok(public_index_kind(failure_result_from_rep(indexes.entry_kind(shape))?))
}

fn public_index_kind(kind: indexes.EntryKind) -> IndexKind {
    match kind {
        ManyEntry => Many,
        UniqueEntry => Unique,
    }
}

fn index_shape(kind: IndexKind) -> indexes.IndexShape {
    match kind {
        Many => Entries(ManyEntry),
        Unique => Entries(UniqueEntry),
    }
}

fn public_index_state(state: indexes.BuildState) -> Result[IndexState, Error] {
    Ok(match failure_result_from_rep(indexes.copy_build_state(state))? {
        Public => Public,
        Backfilling(take cursor) => Backfilling(take cursor),
        Failed(take first, take second) => Failed(take first, take second),
    })
}

fn extract_index(extractor: indexes.RegisteredIndex, raw: Bytes, primary: Bytes) -> Result[indexes.IndexValue, Error] {
    failure_result_from_rep(indexes.extract_row(extractor, raw, primary))
}

fn group_totals(raw: Bytes) -> Result[(u64, u64), Error] {
    failure_result_from_rep(indexes.group_totals(raw))
}

fn totals_bytes(members: u64, sum: u64) -> Result[Bytes, Error] {
    failure_result_from_rep(indexes.totals_bytes(members, sum))
}

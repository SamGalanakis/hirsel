// ---- law H1: the front holds a session's stream, not its place ----
fn local(port: u16) -> Addr {
    Addr(ip: V4(0x7f000001u32), port: port)
}

// One request to the front, answered with its status and body; 0 when it failed.
fn http(net: Net, clock: Clock, port: u16, method: String, target: String, take headers: List[std.http_client.Header], take payload: Bytes) -> (u16, Bytes) waits {
    let req = std.http_client.Request(method: string.from(method), target: string.from(target), headers: take headers, body: Fixed(list.len(payload)))
    let Ok(take opened) = std.http_client.dial(net, local(port), "127.0.0.1", clock, req, std.clock.deadline_after_ms(host.mono_ns(clock), WITHIN_MS)) else {
        return (0u16, list.new())
    }
    let mut c = take opened
    if list.len(payload) > 0u64 {
        if let Error(_) = std.http_client.write(mut c, payload) {
            return (0u16, list.new())
        }
    }
    if let Error(_) = std.http_client.finish_request(mut c, 65536u64) {
        return (0u16, list.new())
    }
    let status = std.http_client.status(std.http_client.head(c))
    let mut got: Bytes = list.new()
    loop {
        list.reserve(mut got, 4096u64)
        match std.http_client.read(mut c, mut got) {
            Ok(0u64) => break,
            Ok(_) => (),
            Error(_) => break
        }
    }
    (status, got)
}

// A browser's headers: its credential.
fn person(credential: Bytes) -> List[std.http_client.Header] {
    let mut auth = string.from("Bearer ")
    string.push(mut auth, std.base64.encode_string(credential))
    let mut out: List[std.http_client.Header] = list.new()
    list.push(mut out, std.http_client.Header(name: "Authorization", value: Public(string.into_bytes(take auth))))
    out
}

// A browser's stream, minted as a client mints one: its keyed time is now (SDK §Transport).
fn law_stream(clock: Clock, n: u64) -> store.StreamId {
    store.StreamId(t: host.wall_ms(clock), n: n)
}

// A stored request's headers: the credential, and its stream and position in the runner's
// HTTP `Idempotency-Key` form, `"<32 hex: t ‖ n>.<p>"`.
fn posting(credential: Bytes, s: store.StreamId, p: u64) -> List[std.http_client.Header] {
    let mut key = string.from("\"")
    let mut name: Bytes = list.new()
    std.codec.put_key_u64(s.t, mut name)
    std.codec.put_key_u64(s.n, mut name)
    string.push(mut key, std.hex.encode(name))
    string.push(mut key, ".")
    string.push_u64(mut key, p)
    string.push(mut key, "\"")
    let mut out = person(credential)
    list.push(mut out, std.http_client.Header(name: "Idempotency-Key", value: Public(string.into_bytes(take key))))
    out
}

fn json[V: codec](v: V) -> Bytes {
    let format: std.json.Format[V] = result.unwrap(std.json.interop())
    string.into_bytes(result.unwrap(std.json.to_string(format, v)))
}

// Reads the stream until a row shows status `until`, folding each event into `rows` by
// position; false when the stream ended first.
fn read_until(mut c: std.http_client.Connection, mut decoder: std.sse.Decoder, mut rows: List[(u64, Bytes)], until: String) -> bool waits {
    read_until_row(mut c, mut decoder, mut rows, until, 0u64)
}

fn read_until_row(mut c: std.http_client.Connection, mut decoder: std.sse.Decoder, mut rows: List[(u64, Bytes)], until: String, at: u64) -> bool waits {
    let format: std.json.Format[harness.gateway_http.Shown] = result.unwrap(std.json.interop())
    let mut chunk: Bytes = list.with_capacity(8192u64)
    let mut reached = false
    let mut present = false
    for row in rows {
        if row.0 == at {
            present = true
        }
    }
    loop {
        match std.http_client.read(mut c, mut chunk) {
            Ok(0u64) => return false,
            Ok(_) => (),
            Error(_) => return false
        }
        let fed = std.sse.feed(mut decoder, chunk, fn(name: Bytes, data: Bytes, event_id: Bytes) -> std.sse.FeedControl[()] {
            if name != b"message" {
                return Continue
            }
            let Ok(row) = std.json.decode_typed(format, std.http.copy_bytes(data), 65536u64) else {
                return Fail(())
            }
            if let Status(text) = row.line {
                reached = text == until
            }
            if row.at == at {
                present = true
            }
            let mut kept: List[(u64, Bytes)] = list.new()
            while let Some((p, take old)) = list.pop(mut rows) {
                if p != row.at {
                    list.push(mut kept, (p, take old))
                }
            }
            list.push(mut kept, (row.at, bytes_of(row.line)))
            rows = take kept
            Continue
        })
        if let Error(_) = fed {
            return false
        }
        list.clear(mut chunk)
        if reached && present {
            return true
        }
    }
}

// The rows, hand-derived from the script: the status at position 0, then each entry's
// line one past its position (the system patch at 1 has none).
fn row_of(at: u64, v: harness.View) -> (u64, Bytes) {
    (at, bytes_of(v))
}

fn rows_want(take status: String, finished_run: bool) -> List[(u64, Bytes)] {
    let mut want: List[(u64, Bytes)] = list.new()
    list.push(mut want, row_of(0u64, Status(take status)))
    list.push(mut want, row_of(1u64, Line("user", "bump it")))
    list.push(mut want, row_of(3u64, Line("assistant", "")))
    if finished_run {
        list.push(mut want, row_of(4u64, Line("tool", "c1")))
        list.push(mut want, row_of(5u64, Line("assistant", "done")))
    }
    want
}

fn same_rows(got: List[(u64, Bytes)], want: List[(u64, Bytes)]) -> bool {
    if list.len(got) != list.len(want) {
        return false
    }
    for w in want {
        let mut found = false
        for g in got {
            if g.0 == w.0 && g.1 == w.1 {
                found = true
            }
        }
        if !found {
            return false
        }
    }
    true
}

// Waits up to five seconds for the session's place to be down, as the gateway saw it.
fn down_within(door: harness.gateway.Door, id: u64, clock: Clock) -> Option[platform.local.Marks] waits {
    for i in 0u64 .. 100u64 {
        let m = harness.gateway.marks(door, id)
        if m.downs >= 1u64 && m.ups == m.downs {
            return Some(m)
        }
        std.clock.sleep_ns(clock, 50000000u64)
    }
    None
}

// Law H1 (the front holds the stream, not the place): a browser's event stream on a
// session shows the run up to its approval wait, the place then stops by itself under
// the open stream and stays stopped while nobody acts, and the approval posted through
// the front wakes it and the same stream shows the run's end. Oracle: the hand-derived
// rows, and no start or stop in a quiet second (more than three idle times). The answer
// is the first check that failed, or 0.
pub fn law_front_holds_stream(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> u64 waits {
    tool_stream(parent, clock, random, tasks, net, false, false)
}

fn tool_stream(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, enabled: bool, fork: bool) -> u64 waits {
    let mut name = string.with_capacity(32u64)
    let root = result.unwrap(host.mkdtemp(parent, mut name))
    let (asks, inbox): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let modelling = task.spawn(tasks, bytes 1048576u64, take inbox, model_service)
    let hub = harness.preview.start(tasks, 1048576u64, 4096u64)
    let (tallies, held): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let way: harness.gateway.Doorway = harness.gateway.doorway(harness.declare_tables)
    let door = harness.gateway.door_of(way)
    let worker_port = if enabled {
        Some(harness.preview.door(hub))
    } else {
        None
    }
    let seed = Services(model: take asks, tallies: take tallies, door: harness.gateway.door_of(way), name: "", tasks: tasks, clock: clock, random: random, net: net, preview: take worker_port, chunks: 0u64)
    let config = harness.gateway.GatewayConfig(root: root, options: runner.triggers.law_options(), factory: session_factory(), max_sessions: if fork {
        2u64
    } else {
        1u64
    }, idle_ms: IDLE_MS, place_bytes: 67108864u64, tasks: tasks, clock: clock, random: random, net: net, watch: None, seed: take seed)
    let g = match harness.gateway.gateway(take way, take config) {
        Ok(take made) => take made,
        Error(_) => return 1u64
    }
    let (listener, at) = result.unwrap(host.listen(net, local(0u16), 16u16))
    let front_port = if enabled {
        Some(harness.preview.door(hub))
    } else {
        None
    }
    let front = harness.gateway_http.Front(bind: code.describe(runner.ingress.caller), bind_bytes: 4096u64, bind_steps: 65536u64, authority: string.into_bytes("localhost"), submit: runner.client.transact_entry(code.describe(submit_entry)), decide: runner.client.transact_entry(code.describe(decide_entry)), settle: None, keys: result.unwrap(runner.client.entry_keys(code.describe(place))), socket: wire().socket, agent: "scripted", narrow: All, preview: take front_port, tasks: tasks, clock: clock, random: random, net: net, tail_lines: 64u64, within_ms: WITHIN_MS, beat_ms: 200u64, conn_bytes: EFFECT_GRANT, conns_max: 4u64, head_max: 8192u64, body_max: 65536u64)
    let served = harness.gateway_http.serve(door, take front, take listener)
    let port = at.port
    let me = runner.ingress.credential(random)
    let s = law_stream(clock, 1u64)
    let (created, made) = http(net, clock, port, "POST", "/sessions", person(me), string.into_bytes("first"))
    if created != 201u16 {
        return 1u64
    }
    if made != b"0" {
        return 2u64
    }
    let events = std.http_client.Request(method: "GET", target: "/sessions/0/events", headers: person(me), body: Fixed(0u64))
    let Ok(take opened) = std.http_client.dial(net, local(port), "127.0.0.1", clock, events, std.clock.deadline_after_ms(host.mono_ns(clock), 30000u64)) else {
        return 3u64
    }
    let mut stream = take opened
    if let Error(_) = std.http_client.finish_request(mut stream, 1073741824u64) {
        return 4u64
    }
    if std.http_client.status(std.http_client.head(stream)) != 200u16 {
        return 5u64
    }
    let mut decoder = std.sse.decoder(65536u64)
    let mut rows: List[(u64, Bytes)] = list.new()
    let (posted, _) = http(net, clock, port, "POST", "/sessions/0/messages", posting(me, s, 0u64), json(harness.Submit(client_key: "k1", text: "bump it")))
    if posted != 202u16 {
        return 6u64
    }
    let r1 = read_until(mut stream, mut decoder, mut rows, "waiting")
    if !r1 {
        return 7u64
    }
    if !same_rows(rows, rows_want("waiting", false)) {
        return 8u64
    }
    let Some(asleep) = down_within(door, 0u64, clock) else {
        return 9u64
    }
    std.clock.sleep_ns(clock, 1000000000u64)
    let later = harness.gateway.marks(door, 0u64)
    if later.ups != asleep.ups || later.downs != asleep.downs {
        return 10u64
    }
    let key = harness.approval_key("bump", 1u64, Inline(string.into_bytes("{}")))
    let (ruled, ruling) = http(net, clock, port, "POST", "/sessions/0/decisions", posting(me, s, 1u64), json(harness.Decision(run: 0u64, round: 0u64, ordinal: 0u64, key: take key, allow: true)))
    if ruled != 200u16 {
        return 11u64
    }
    if ruling != json((Approved : harness.Ruling)) {
        return 12u64
    }
    if enabled {
        let Some(tool) = first_draft(mut stream, mut decoder) else {
            return 16u64
        }
        if tool.key.run != 0u64 || tool.key.entry != 3u64 || tool.key.tool != Some(0u64) || tool.text != "running tool" {
            return 17u64
        }
        let Ok(let_go) = channel.receive(held) else {
            return 18u64
        }
        // A read during the run: the open stream holds one of the place's wire sessions,
        // so the page needs another, and it must not wait for the held tool.
        let (mid_run, _) = http(net, clock, port, "GET", "/sessions/0/history?before=4&lines=2", person(me), list.new())
        if mid_run != 200u16 {
            return 19u64
        }
        // A message during the run is answered at once: it is queued in the session's
        // ingress (Queued at seq 1) and becomes the next turn when this one ends.
        let (busy, said) = http(net, clock, port, "POST", "/sessions/0/messages", posting(me, s, 2u64), json(harness.Submit(client_key: "k2", text: "again")))
        if busy != 202u16 || said != json((Queued(1u64) : harness.Disposition)) {
            return 20u64
        }
        let _ = channel.send(let_go, ())
    }
    let r2 = read_until_row(mut stream, mut decoder, mut rows, "answered", if enabled {
        7u64
    } else {
        5u64
    })
    if !r2 {
        return 13u64
    }
    if !same_rows(rows, tool_finished_rows(enabled)) {
        return 14u64
    }
    let paged = tail_and_history(net, clock, port, me, enabled)
    if paged != 0u64 {
        return 40u64 + paged
    }
    if fork {
        let checked = fork_history(door, net, clock, port, me)
        if checked != 0u64 {
            return 60u64 + checked
        }
    }
    harness.gateway_http.halt(take served)
    let mut tail: Bytes = list.with_capacity(4096u64)
    let ended = loop {
        match std.http_client.read(mut stream, mut tail) {
            Ok(0u64) => break true,
            Ok(_) => list.clear(mut tail),
            Error(_) => break true
        }
    }
    if !ended {
        return 15u64
    }
    let _ = harness.gateway.stop(take g)
    let _ = task.join(take modelling)
    harness.preview.stop(take hub)
    result.unwrap(std.dir.remove_all(parent, name))
    0u64
}

// A fresh stream asking for a two-line tail starts there: the status and the rows of the
// last two entries (positions 3 and 4). Paging back from its oldest row with a pinned
// cutoff gives the rest, and the stream and pages together are the whole transcript,
// as the hand-derived rows say. The answer is the first check that failed, or 0.
// The source's five entries come from the scripted tool round. The fork reads
// them through the host, which waits for the source's place, still live after
// its turn, to stop first. A fork owns that pinned prefix even after the
// source is deleted. Only its two new entries precede the first cut; paging
// from the cut yields the source rows.
fn fork_history(door: harness.gateway.Door, net: Net, clock: Clock, port: u16, me: Bytes) -> u64 waits {
    let (forked, fork_id) = http(net, clock, port, "POST", "/sessions/0/forks", person(me), json(harness.gateway_http.ForkAsk(key: "fork", cut: 5u64)))
    if forked != 201u16 || fork_id != b"1" {
        return 2u64
    }
    let (inside, _) = http(net, clock, port, "POST", "/sessions/0/forks", person(me), json(harness.gateway_http.ForkAsk(key: "inside", cut: 3u64)))
    if inside != 422u16 {
        return 16u64
    }
    if let Error(_) = harness.gateway.delete(door, 0u64) {
        return 3u64
    }
    let s = law_stream(clock, 2u64)
    let (posted, _) = http(net, clock, port, "POST", "/sessions/1/messages", posting(me, s, 0u64), json(harness.Submit(client_key: "f1", text: "fork only")))
    if posted != 202u16 {
        return 4u64
    }
    let Some(_) = down_within(door, 1u64, clock) else {
        return 15u64
    }
    let Ok(take c) = browser_at(net, clock, port, me, "/sessions/1/events?tail=1") else {
        return 5u64
    }
    let mut stream = take c
    let mut decoder = std.sse.decoder(65536u64)
    let mut rows: List[(u64, Bytes)] = list.new()
    if !read_until_row(mut stream, mut decoder, mut rows, "answered", 8u64) {
        return 6u64
    }
    let _ = take stream
    let format: std.json.Format[harness.gateway_http.Page] = result.unwrap(std.json.interop())
    let (newer, data) = http(net, clock, port, "GET", "/sessions/1/history?before=8&lines=7", person(me), list.new())
    if newer != 200u16 {
        return 7u64
    }
    let Ok(page) = std.json.decode_typed(format, clone(data), 65536u64) else {
        return 8u64
    }
    if page.from != 6u64 || list.len(page.rows) != 1u64 || page.rows[0].at != 6u64 {
        return 9u64
    }
    list.push(mut rows, (6u64, bytes_of(page.rows[0].line)))
    let (older, prior_data) = http(net, clock, port, "GET", "/sessions/1/history?before=6&lines=7", person(me), list.new())
    if older != 200u16 {
        return 10u64
    }
    let Ok(prior) = std.json.decode_typed(format, clone(prior_data), 65536u64) else {
        return 11u64
    }
    if prior.from != 1u64 {
        return 12u64
    }
    for r in prior.rows {
        list.push(mut rows, (r.at, bytes_of(r.line)))
    }
    let mut expected = rows_want("answered", true)
    list.push(mut expected, row_of(6u64, Line("user", "fork only")))
    list.push(mut expected, row_of(8u64, Line("assistant", "done")))
    if !same_rows(rows, expected) {
        return 13u64
    }
    let mut fresh = result.unwrap(browser_at(net, clock, port, me, "/sessions/1/events"))
    let mut fresh_decoder = std.sse.decoder(65536u64)
    let mut full: List[(u64, Bytes)] = list.new()
    if !read_until_row(mut fresh, mut fresh_decoder, mut full, "answered", 8u64) || !same_rows(full, expected) {
        return 14u64
    }
    0u64
}

@test
fn test_front_fork_history(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = tool_stream(parent, clock, random, tasks, net, false, true)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

@test
fn test_front_holds_stream(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_front_holds_stream(parent, clock, random, tasks, net)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

@test
fn test_front_shows_tool_progress(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = tool_stream(parent, clock, random, tasks, net, true, false)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

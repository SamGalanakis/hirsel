fn bump(mut xs: List[u64]) { list.push(mut xs, 1u64) }
fn run(mut xs: List[u64]) -> Result[Result[u64, Causes], Capacity] {
    isolate(fn() -> u64 { bump(mut xs); 0u64 })
}
pub fn main() -> Result[(), ()] { let mut xs: List[u64] = list.new(); let _ = run(mut xs); Ok(()) }


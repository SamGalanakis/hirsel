// The Tiered stage of the log@1 cut (§13.6a T2, T4, T9, steps 3 and 5).
// It runs once per cut, before AP16 plans the Memory classes, because the
// collection-map leaves that AP16 encodes must already name the class-3
// roots it emits here.
pub type TieredCutPack: send {
    seq: u64,
    wire: Bytes,
    pack: pages.PagePack
}

pub type TieredCutStage: send {
    // Class 4 first, then class 3, in pack order (T4).
    packs: List[TieredCutPack],
    // The participants' roots in `cut_participants` order, each Tiered
    // `CollectionRoot` sealed to its emitted location.
    roots: List[pages.Roots],
    next_pack: u64,
    // The first stamp the fold left unissued.
    stamp_end: u64,
    // The fold released a replay overlay, a residency change loaded a tree,
    // or a promotion re-pointed a root, so the holders take these roots even
    // when the stage emitted nothing.
    folded: bool,
    // The promoted root materialized its Snapshot's overlay (§13.5 step 3).
    materialized: bool,
    // T8 step 3's added rows, live then fold order, and step 4's drain.
    queue: manifest.CutQueue,
    // The probes this cut leaves running and the inventories it leases.
    compaction: TieredCompaction,
    // Stamp -> PagePtr emitted by this cut's Tiered stage (for Pass-2 chunk cuts).
    emitted: Map[u64, std.page.PagePtr]
}

pub fn tiered_cut_stage_empty(cut_stage: TieredCutStage) -> bool {
    list.len(cut_stage.packs) == 0 && !cut_stage.folded && list.len(cut_stage.queue.retiring) == 0
}

pub fn encode_tiered_run(id: types.StoreKey, layout: TieredPackRun, mut emitted: Map[u64, std.page.PagePtr], mut packs: List[TieredCutPack]) -> Result[(), types.Failure] {
    types.capacity(list.try_reserve(mut packs, list.len(layout.packs)))?
    for laid in layout.packs {
        let (take wire, inventory) = encode_tiered_cut_pack(id, layout, laid, mut emitted)?
        list.push(mut packs, TieredCutPack(seq: laid.seq, wire: take wire, pack: inventory))
    }
    Ok(())
}

// The fold cut (§13.7): each participant over a replay overlay applies it
// to its Cold tree through cut pins, so the cut never publishes a root past
// the journal frames that carry the overlay (L68 (e)). A `base` or evidence
// mismatch is `Corrupt(Malformed)` before anything is written, and the
// overlay stays. Each Cold subtree a floor detaches becomes a
// `deferred_frees` row of its participant's branch (T8 step 3), once per
// branch and frame, so holders that share one overlaid tree queue it once.
// Each Cold frame a branch head's fold replaces is filed against that branch
// (§13.7 "Ownership follows the actual replacements"), once per branch and
// frame. A pin records nothing. Nor does a branch a journaled FORK made, whose
// fork row the cut first publishes: its own replacements need the fork-time
// overlay, so they stay counted live until it is built.
// The participants whose fold replacements are filed: branch heads (the
// first `heads` roots) whose fork row the cut does not first publish.
pub fn fold_owners(branches: List[u32], heads: u64, forked: List[manifest.LineageFork]) -> Result[List[bool], types.Failure] {
    let mut owners: List[bool] = list.new()
    types.capacity(list.try_reserve(mut owners, list.len(branches)))?
    for slot in 0u64 .. list.len(branches) {
        let mut owns = slot < heads
        for fork_row in forked {
            if fork_row.child == branches[slot] {
                owns = false
            }
        }
        list.push(mut owners, owns)
    }
    Ok(take owners)
}

pub fn fold_cut_roots(pager: Option[View[Sender[TieredPagerMessage]]], mut roots: List[pages.Roots], branches: List[u32], owners: List[bool], promote: Option[u64], mut next_stamp: u64, mut seen: Map[(u32, u64, u64), ()], mut queued: List[manifest.DeferredFree], mut replaced: List[manifest.TieredDrainKill]) -> Result[bool, types.Failure] waits {
    let mut folded = false
    let mut filed: Map[(u32, u64, u64), ()] = map.new()
    for slot in 0u64 .. list.len(roots) {
        let overlaid = match roots[slot].collections.replay {
            Some(_) => true,
            None => false,
        }
        // The promoted root materializes after its resolution (§13.5 step 3).
        if overlaid && promote != Some(slot) {
            let source = tx_page_source(pager, roots[slot].collections)?
            let effects = fold_page_tree(source, mut roots[slot].collections, mut next_stamp)?
            for effect in effects {
                match effect {
                    FoldDropped(target) => {
                        let frame = format.tiered_frame_id(target)
                        let key = (branches[slot], frame.pack, frame.offset)
                        if !map.contains(seen, key) {
                            types.capacity(map.try_reserve(mut seen, 1))?
                            map.insert(mut seen, key, ())
                            types.capacity(list.try_reserve(mut queued, 1))?
                            list.push(mut queued, manifest.DeferredFree(branch_id: branches[slot], target: clone(target)))
                        }
                    },
                    FoldReplaced(frame) => {
                        let key = (branches[slot], frame.pack, frame.stamp)
                        if owners[slot] && !map.contains(filed, key) {
                            types.capacity(map.try_reserve(mut filed, 1))?
                            map.insert(mut filed, key, ())
                            types.capacity(list.try_reserve(mut replaced, 1))?
                            list.push(mut replaced, manifest.TieredDrainKill(branch_id: branches[slot], frame: frame))
                        }
                    },
                }
            }
            folded = true
        }
    }
    Ok(folded)
}

// T8 step 3's added rows from the live dropped list come first, then the
// fold's. A row is added once per branch and frame.
pub fn queue_live_dropped(dropped: List[manifest.DeferredFree], mut seen: Map[(u32, u64, u64), ()], mut queued: List[manifest.DeferredFree]) -> Result[(), types.Failure] {
    for row in dropped {
        let frame = format.tiered_frame_id(row.target)
        let key = (row.branch_id, frame.pack, frame.offset)
        if !map.contains(seen, key) {
            types.capacity(map.try_reserve(mut seen, 1))?
            map.insert(mut seen, key, ())
            types.capacity(list.try_reserve(mut queued, 1))?
            list.push(mut queued, clone(row))
        }
    }
    Ok(())
}

// `note_held_roots` lists each participant's collection map first.
pub fn sealed_cut_holders(take holders: List[manifest.HeldPage], cut_stage: TieredCutStage) -> Result[List[manifest.HeldPage], types.Failure] {
    if tiered_cut_stage_empty(cut_stage) {
        return Ok(take holders)
    }
    let mut ready: List[manifest.HeldPage] = list.new()
    types.capacity(list.try_reserve(mut ready, list.len(holders)))?
    let mut slot = 0u64
    for held in holders {
        let root = if let HolderSource(_, _, 0) = held.source {
            let chosen = arc.share(cut_stage.roots[slot].collections.root)
            slot += 1
            take chosen
        } else {
            arc.share(held.root)
        }
        list.push(mut ready, manifest.HeldPage(source: held.source, root: take root))
    }
    Ok(take ready)
}

// T4's pack rows: each Tiered pack enters the candidate inventory with
// `live` = its laid-out payload, so AP16 item 7 lists it.
pub fn list_tiered_cut(mut known: manifest.PageLocations, cut_stage: TieredCutStage) -> Result[(), types.Failure] {
    for written in cut_stage.packs {
        types.capacity(manifest.disk_index_put(mut known.packs, written.seq, written.pack, manifest.pack_edge_charge))?
    }
    Ok(())
}

// Step 3 for classes 4 and 3, ahead of AP16's classes 1, 0 and 2.
pub fn write_tiered_cut(d: Dir, cut_stage: TieredCutStage, mut buffers: manifest.PackBuffers) -> Result[(), types.Failure] waits {
    for written in cut_stage.packs {
        string.truncate(mut buffers.destination, 0)
        string.push(mut buffers.destination, "p-")
        string.push_u64(mut buffers.destination, written.seq)
        string.truncate(mut buffers.temporary, 0)
        string.push(mut buffers.temporary, buffers.destination)
        string.push(mut buffers.temporary, ".tmp")
        manifest.disk_write_synced(d, buffers.temporary, written.wire)?
        manifest.disk_io(host.rename(d, buffers.temporary, buffers.destination))?
    }
    Ok(())
}

// AP15's Tiered class figure: each distinct Tiered root's descriptor bytes.
// Holders that share a root by stamp count it once. The figure is exact for
// one holder; across holders whose distinct roots share subtrees it is an
// upper bound, which replay already treats as conservative (§13.1).
fn tiered_map_account(root: Arc[std.page.Page], mut seen: Map[u64, ()], mut total: u64) -> Result[(), types.Failure] {
    let image = std.page.image_of(root)
    for slot in 0u64 .. std.page.count(image) {
        if std.page.level(image) != 0 {
            tiered_map_account(option.unwrap(std.page.child(root, slot)), mut seen, mut total)?
            continue
        }
        let descriptor = pages.unwrap_collection_descriptor(std.page.value_at(root, slot))
        if descriptor.residency != ResidentTiered {
            continue
        }
        let stamp = match option.unwrap(std.page.child_slot(root, slot)) {
            HotPage(page) => std.page.stamp(std.page.image_of(page)),
            ColdPage(place) => place.stamp,
            _ => 0,
        }
        if stamp != 0 {
            if map.contains(seen, stamp) {
                continue
            }
            types.capacity(map.try_reserve(mut seen, 1))?
            map.insert(mut seen, stamp, ())
        }
        let Some(sum) = int.checked_add(total, descriptor.row_bytes) else {
            return Error(Limit(Ids))
        }
        total = sum
    }
    Ok(())
}

// Over the roots the cut publishes, so a fold's fresh roots are counted
// and an overlaid head never hides a pin that shares its Cold root.
pub fn cut_tiered_account(published: List[pages.Roots]) -> Result[u64, types.Failure] {
    let mut seen: Map[u64, ()] = map.new()
    let mut total = 0u64
    for roots in published {
        tiered_map_account(roots.collections.root, mut seen, mut total)?
    }
    Ok(total)
}

pub fn take_sealed(mut sealed: List[pages.Roots], mut at: u64) -> pages.PageTree {
    let tree = pages.share_page_tree(sealed[at].collections)
    at += 1
    take tree
}

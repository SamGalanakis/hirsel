// Go hash/crc32's slicing-by-8 recurrence for the reflected IEEE polynomial.
// Row zero advances each byte by eight bits under 0xedb88320. Each next row
// applies that same recurrence with one more zero byte.
const TABLE: Inline[u32, 2048] = table()

fn table() -> Inline[u32, 2048] {
    let mut t: Inline[u32, 2048] =[0; 2048]
    let mut i: u64 = 0
    let mut n: u32 = 0
    while i < 256 {
        let mut c = n
        let mut bit: u64 = 0
        while bit < 8 {
            if c & 1 == 1 { c = 0xedb88320 ^ (c >> 1) } else { c = c >> 1 }
            bit += 1
        }
        t[i] = c
        i += 1
        n += 1
    }
    while i < 2048 {
        let prev = t[i - 256]
        let low: u64 = int.widen(prev & 255)
        t[i] = t[low] ^ (prev >> 8)
        i += 1
    }
    t
}

/// Continue an IEEE CRC-32 over bytes[lo, hi). Ranges are checked as in list.slice.
/// Alloc: none. Cost: O(hi-lo). Ex: `crc32.update(previous, b, 0, list.len(b))`.
pub fn update(crc: u32, input: Bytes, lo: u64, hi: u64) -> u32 {
    let b = list.slice(input, lo, hi)
    let n = list.len(b)
    let mut value = ~crc
    let mut at: u64 = 0
    while n - at >= 8 {
        let low: u32 = list.word_le(b, at)
        let high: u32 = list.word_le(b, at + 4)
        let word = value ^ low
        let a: u64 = int.widen(high >> 24)
        let b1: u64 = int.widen((high >> 16) & 255)
        let c: u64 = int.widen((high >> 8) & 255)
        let d: u64 = int.widen(high & 255)
        let e: u64 = int.widen(word >> 24)
        let f: u64 = int.widen((word >> 16) & 255)
        let g: u64 = int.widen((word >> 8) & 255)
        let h: u64 = int.widen(word & 255)
        value = TABLE[a] ^ TABLE[256 + b1] ^ TABLE[512 + c] ^ TABLE[768 + d] ^ TABLE[1024 + e] ^ TABLE[1280 + f] ^ TABLE[1536 + g] ^ TABLE[1792 + h]
        at += 8
    }
    while at < n {
        let byte: u32 = int.widen(b[at])
        let index: u64 = int.widen((value ^ byte) & 255)
        value = TABLE[index] ^ (value >> 8)
        at += 1
    }
    ~value
}

/// IEEE CRC-32 over the entire input. Alloc: none. Cost: O(n).
/// Ex: `crc32.hash(string.as_bytes("123456789"))`.
pub fn hash(input: Bytes) -> u32 {
    update(0, input, 0, list.len(input))
}

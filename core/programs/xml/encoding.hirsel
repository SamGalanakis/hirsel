type Encoding = Utf8 | Utf8Bom | Utf16Be | Utf16Le | Bare16Be | Bare16Le | Latin1 | Ascii

const EOF: u32 = 0x110000

const BAD_SCALAR: u32 = 0x110001

fn encoding(input: Bytes) -> (Encoding, u64) {
    let size = list.len(input)
    if size >= 4 {
        match (list.word_be(input, 0) : u32) {
            0x003c003f => return (Bare16Be, 0),
            0x3c003f00 => return (Bare16Le, 0),
            _ => {},
        }
    }
    if size >= 2 {
        match (list.word_be(input, 0) : u16) {
            0xfeff => return (Utf16Be, 2),
            0xfffe => return (Utf16Le, 2),
            _ => {},
        }
    }
    if size >= 3 && list.slice(input, 0, 3) == b"\xef\xbb\xbf" {
        return (Utf8Bom, 3)
    }
    (Utf8, 0)
}

fn unit_width(enc: Encoding) -> u64 {
    match enc {
        Utf16Be => 2,
        Utf16Le => 2,
        Bare16Be => 2,
        Bare16Le => 2,
        _ => 1,
    }
}

fn unit(input: Bytes, enc: Encoding, at: u64) -> u32 {
    let size = list.len(input)
    if at >= size {
        return EOF
    }
    if unit_width(enc) == 1 {
        return int.widen(input[at])
    }
    if size - at < 2 {
        return BAD_SCALAR
    }
    let word: u16 = match enc {
        Utf16Be => list.word_be(input, at),
        Bare16Be => list.word_be(input, at),
        _ => list.word_le(input, at),
    }
    int.widen(word)
}

fn utf8_scalar(input: Bytes, at: u64, x: u32) -> (u32, u64) {
    if x < 0x80 {
        return (x, 1)
    }
    let (width, mask, min): (u64, u32, u32) = if x >= 0xc2 && x < 0xe0 {
        (2, 0x1f, 0x80)
    } else if x >= 0xe0 && x < 0xf0 {
        (3, 0x0f, 0x800)
    } else if x >= 0xf0 && x <= 0xf4 {
        (4, 7, 0x10000)
    } else {
        return (BAD_SCALAR, 0)
    }
    if width > list.len(input) - at {
        return (BAD_SCALAR, 0)
    }
    let mut cp = x & mask
    for offset in 1 .. width {
        let byte = input[at + offset]
        if byte & 0xc0 != 0x80 {
            return (BAD_SCALAR, 0)
        }
        cp = cp << 6 | int.widen(byte & 0x3f)
    }
    if cp < min || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff) {
        return (BAD_SCALAR, 0)
    }
    (cp, width)
}

fn scalar(input: Bytes, enc: Encoding, at: u64) -> (u32, u64) {
    let x = unit(input, enc, at)
    if x >= EOF {
        return (x, 0)
    }
    match enc {
        Utf8 => utf8_scalar(input, at, x),
        Utf8Bom => utf8_scalar(input, at, x),
        Latin1 => (x, 1),
        Ascii => if x < 0x80 {
            (x, 1)
        } else {
            (BAD_SCALAR, 0)
        },
        _ => {
            if x < 0xd800 || x > 0xdfff {
                return (x, 2)
            }
            if x >= 0xdc00 {
                return (BAD_SCALAR, 0)
            }
            let y = unit(input, enc, at + 2)
            if y < 0xdc00 || y > 0xdfff {
                return (BAD_SCALAR, 0)
            }
            (0x10000 + ((x - 0xd800) << 10) + (y - 0xdc00), 4)
        },
    }
}

fn declared_encoding(enc: Encoding, label: String) -> Result[Encoding, Error] {
    let name = string.as_bytes(label)
    if ascii_equal(name, b"utf-8") {
        match enc {
            Utf8 => return Ok(enc),
            Utf8Bom => return Ok(enc),
            _ => {},
        }
    } else if ascii_equal(name, b"utf-16") {
        match enc {
            Utf16Be => return Ok(enc),
            Utf16Le => return Ok(enc),
            _ => {},
        }
    } else if ascii_equal(name, b"utf-16be") {
        if let Bare16Be = enc {
            return Ok(enc)
        }
    } else if ascii_equal(name, b"utf-16le") {
        if let Bare16Le = enc {
            return Ok(enc)
        }
    } else if ascii_equal(name, b"iso-8859-1") {
        if let Utf8 = enc {
            return Ok(Latin1)
        }
    } else if ascii_equal(name, b"us-ascii") {
        if let Utf8 = enc {
            return Ok(Ascii)
        }
    } else {
        return Error(UnsupportedEncoding)
    }
    Error(BadEncoding)
}

fn ascii_equal(value: Bytes, lower: Bytes) -> bool {
    let len = list.len(lower)
    if list.len(value) != len {
        return false
    }
    for i in 0u64 .. len {
        let x = value[i]
        if x != lower[i] && !(x >= b'A' && x <= b'Z' && x + 32 == lower[i]) {
            return false
        }
    }
    true
}

fn xml_char(cp: u32) -> bool {
    cp == 9 || cp == 10 || cp == 13 || (cp >= 0x20 && cp <= 0xd7ff) || (cp >= 0xe000 && cp <= 0xfffd) || (cp >= 0x10000 && cp <= 0x10ffff)
}

fn space(cp: u32) -> bool {
    cp == 32 || cp == 9 || cp == 13 || cp == 10
}

fn ascii_letter(cp: u32) -> bool {
    (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
}

fn digit(cp: u32) -> bool {
    cp >= 48 && cp <= 57
}

fn name_start(cp: u32) -> bool {
    cp == 58 || cp == 95 || ascii_letter(cp) || (cp >= 0xc0 && cp <= 0xd6) || (cp >= 0xd8 && cp <= 0xf6) || (cp >= 0xf8 && cp <= 0x2ff) || (cp >= 0x370 && cp <= 0x37d) || (cp >= 0x37f && cp <= 0x1fff) || (cp >= 0x200c && cp <= 0x200d) || (cp >= 0x2070 && cp <= 0x218f) || (cp >= 0x2c00 && cp <= 0x2fef) || (cp >= 0x3001 && cp <= 0xd7ff) || (cp >= 0xf900 && cp <= 0xfdcf) || (cp >= 0xfdf0 && cp <= 0xfffd) || (cp >= 0x10000 && cp <= 0xeffff)
}

fn name_char(cp: u32) -> bool {
    name_start(cp) || digit(cp) || cp == 45 || cp == 46 || cp == 0xb7 || (cp >= 0x300 && cp <= 0x36f) || (cp >= 0x203f && cp <= 0x2040)
}

fn utf8_width(cp: u32) -> u64 {
    if cp < 0x80 {
        1
    } else if cp < 0x800 {
        2
    } else if cp < 0x10000 {
        3
    } else {
        4
    }
}

fn append_scalar(mut out: Bytes, cp: u32) -> Result[(), Error] {
    let width = utf8_width(cp)
    reserve(mut out, width)?
    if width == 1 {
        list.push(mut out, int.truncate(cp))
        return Ok(())
    }
    if width == 2 {
        list.push(mut out, int.truncate(0xc0 | (cp >> 6)))
    } else if width == 3 {
        list.push(mut out, int.truncate(0xe0 | (cp >> 12)))
    } else {
        list.push(mut out, int.truncate(0xf0 | (cp >> 18)))
        list.push(mut out, int.truncate(0x80 | ((cp >> 12) & 63)))
    }
    if width >= 3 {
        list.push(mut out, int.truncate(0x80 | ((cp >> 6) & 63)))
    }
    list.push(mut out, int.truncate(0x80 | (cp & 63)))
    Ok(())
}

fn text(take data: Bytes) -> Result[String, Error] {
    match string.from_utf8(take data) {
        Ok(take value) => Ok(take value),
        Error(_) => Error(BadEncoding),
    }
}

fn copy_text(value: String) -> Result[String, Error] {
    if string.byte_len(value) == 0 {
        return Ok("")
    }
    let mut data: Bytes = list.new()
    reserve(mut data, string.byte_len(value))?
    list.append(mut data, string.as_bytes(value))
    text(take data)
}

fn reserve[T](mut out: List[T], count: u64) -> Result[(), Error] {
    match list.try_reserve(mut out, count) {
        Ok(()) => Ok(()),
        Error(capacity) => Error(Resources(capacity)),
    }
}

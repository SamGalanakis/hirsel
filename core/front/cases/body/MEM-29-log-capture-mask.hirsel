// MEM-29: a Log's element is `inert` (OWN-4), so LANG-12 refuses an element holding a
// resource, capability, view, scoped value, region reference or opaque owner at any
// depth, with rigid parameters read from their bounds, on type formation and on
// explicit, inferred and forwarded calls. `Causes` is an opaque owner.
// expect: refuse LANG-12 at 27:19
// expect: refuse LANG-12 at 28:16
// expect: refuse LANG-12 at 29:29
// expect: refuse LANG-12 at 30:29
// expect: refuse LANG-12 at 31:45
// expect: refuse LANG-12 at 32:30
// expect: refuse LANG-12 at 32:41
// expect: refuse LANG-12 at 33:43
// expect: refuse LANG-12 at 33:54
// expect: refuse LANG-12 at 34:46
// expect: refuse LANG-12 at 34:57
// expect: compared LANG-12 at 27:19 | core@1/core/Sender[u64] | inert
// expect: compared LANG-12 at 28:16 | core@1/core/List[core@1/core/Dir] | inert
// expect: compared LANG-12 at 29:29 | $0 | inert
// expect: compared LANG-12 at 30:29 | core@1/core/Option[core@1/core/Dir] | inert
// expect: compared LANG-12 at 31:45 | core@1/core/Dir | inert
// expect: compared LANG-12 at 32:30 | core@1/core/Dir | inert
// expect: compared LANG-12 at 32:41 | core@1/core/Dir | inert
// expect: compared LANG-12 at 33:43 | $0 | inert
// expect: compared LANG-12 at 33:54 | $0 | inert
// expect: compared LANG-12 at 34:46 | ($0, core@1/core/Causes) | inert
// expect: compared LANG-12 at 34:57 | ($0, core@1/core/Causes) | inert
fn senders(l: Log[Sender[u64]]) {}
fn dirs(l: Log[List[Dir]]) {}
fn bounded[T: plain](l: Log[T]) {}
fn annotated() { let l: Log[Option[Dir]] = log.new() }
fn explicit() { log.finish((log.new() : Log[Dir])) }
fn inferred() -> List[Dir] { log.finish(log.new()) }
fn forwarded[T: shareable]() -> List[T] { log.finish(log.new()) }
fn causes[T: inert]() -> List[(T, Causes)] { log.finish(log.new()) }

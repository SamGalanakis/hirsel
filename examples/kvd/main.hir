pub type AppError = Files(FileError) | Grant(GrantError) | Net(NetError) | Read(
  bufio.ReadError[NetError]
) | Store(store.StoreError) | Tx(store.TxFailure[store.TxError]) | Signal(SignalError) | Output(
  OutputError
)

@serializable
type Change = Set(Bytes, Bytes) | Del(Bytes)

fn change(mut tx: store.Tx, info: store.CallInfo, c: Change) -> Result[
  (),
  store.TxError
] {
  match c {
    Set(key, value) => store.tx_put(mut tx, unique key, unique value),
    Del(key) => store.tx_delete(mut tx, unique key),
  }
}

// Redis string.tcl:2-10 and keyspace.tcl:2-7 supply SET/GET/DEL vectors.
// A line protocol: SET key value, GET key, DEL key. Values may contain spaces.
fn command(a: Authority, mut db: store.Store, line: String) -> Result[String, AppError] {
  let words = string.split_once(string.trim(line), " ")
  let Some((verb, rest)) = words else {
    return Ok("ERR command\n")
  }
  if verb == "GET" {
    let snap = store.snapshot(a, mut db, authority.floor(a))?
    let value = store.get(snap, string.as_bytes(rest))
    return Ok(
      match value {
        Some(raw) => match string.from_bytes(unique raw) {
          Ok(text) => f"VALUE {text}\n",
          Error(_) => "ERR utf8\n",
        },
        None() => "NOT_FOUND\n",
      }
    )
  }
  let c: Change = if verb == "SET" {
    let Some((key, value)) = string.split_once(rest, " ") else {
      return Ok("ERR value\n")
    }
    if key == "" || store.reserved(string.as_bytes(key)) {
      return Ok("ERR key\n")
    }
    Set(unique string.as_bytes(key), unique string.as_bytes(value))
  } else if verb == "DEL" {
    if rest == "" || store.reserved(string.as_bytes(rest)) {
      return Ok("ERR key\n")
    }
    Del(unique string.as_bytes(rest))
  } else {
    return Ok("ERR command\n")
  }
  store.transact(mut db, change, c) ? Tx
  Ok("OK\n")
}

fn session(
  a: Authority,
  n: Net,
  mut stream: Stream of n,
  mut db: store.Store,
  tasks: Tasks,
  stats: Mutex[u64]
) -> Result[(), AppError] {
  let mut reader = bufio.new(4096)
  while let Some(line) = bufio.stream_read_line(n, mut stream, mut reader, 1048576)? {
    let reply = command(a, mut db, line)?
    mutex.with(
      tasks,
      stats,
      fn(mut count: unique u64) -> () uses {} {
        count += 1
      }
    )
    net.write_all(n, mut stream, string.as_bytes(reply))?
  }
  Ok(())
}

fn accept_loop(
  a: Authority,
  n: Net,
  mut listener: Listener of n,
  mut db: store.Store,
  tasks: Tasks,
  stats: Mutex[u64]
) -> Result[(), AppError] {
  while true {
    let (stream, _) = match net.accept(n, mut listener) {
      Ok(pair) => take pair,
      Error(Canceled(_)) => return Ok(()),
      Error(e) => return Error(Net(e)),
    }
    let mut current = take stream
    match session(a, n, mut current, mut db, tasks, stats) {
      Ok(()) => {},
      Error(Read(Source(Canceled(_)))) | Error(Net(Canceled(_))) => return Ok(()),
      Error(e) => return Error(take e),
    }
  }
  Ok(())
}

fn serve(a: Authority, n: Net, tasks: Tasks, stats: Mutex[u64], output: Stdout) -> Result[
  (),
  AppError
] {
  let mut db = store.open(a, store.default_config())?
  let mut listener = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 18765)
  )?
  out.print(output, "kvd listening 127.0.0.1:18765\n")?
  let outcome = accept_loop(a, n, mut listener, mut db, tasks, stats)
  store.close(take db)?
  take outcome
}

pub fn main(rt: Io) -> Result[(), AppError] {
  let signals = io.signals(rt)?
  let tasks = io.tasks(rt)?
  let a = io.authority(rt, "main")?
  let n = io.net(rt)?
  let output = io.stdout(rt)?
  let stats = mutex.create(tasks, 0u64)
  let outcome = task.scope(
    tasks,
    fn(s: Scope) -> Result[(), AppError] {
      let mut set: TaskSet[unique Result[(), AppError]] of s = task.set(s)
      task.add(
        s,
        mut set,
        task.async(
          s,
          fn() -> unique Result[(), AppError] {
            unique serve(a, n, tasks, stats, output)
          }
        )
      )
      task.add(
        s,
        mut set,
        task.async(
          s,
          fn() -> unique Result[(), AppError] {
            let _ = signal.wait(signals, [Terminate()])?
            Ok(())
          }
        )
      )
      let (_, outcome) = task.select(s, take set)
      take outcome
    }
  )
  let count = mutex.with(
    tasks,
    stats,
    fn(mut served: unique u64) -> u64 uses {} {
      served
    }
  )
  out.print(output, f"kvd stopped after {count} commands\n")?
  take outcome
}

const SERVER_HELLO: u8 = 2

const CERTIFICATE: u8 = 11

const SERVER_KEY_EXCHANGE: u8 = 12

const CERTIFICATE_REQUEST: u8 = 13

const SERVER_HELLO_DONE: u8 = 14

const CERTIFICATE_VERIFY: u8 = 15

const CLIENT_KEY_EXCHANGE: u8 = 16

const FINISHED: u8 = 20

const UNEXPECTED_MESSAGE: u8 = 10

const HANDSHAKE_FAILURE: u8 = 40

const BAD_CERTIFICATE: u8 = 42

const ILLEGAL_PARAMETER: u8 = 47

const DECRYPT_ERROR: u8 = 51

const PROTOCOL_VERSION: u8 = 70

const NO_RENEGOTIATION: u8 = 100

const ECDSA_P256_SHA256: u16 = 0x0403

const ECDSA_P384_SHA384: u16 = 0x0503

const ECDSA_SIGN: u8 = 64

const EXT_GROUPS: u16 = 10

const EXT_POINT_FORMATS: u16 = 11

const EXT_SIGNATURES: u16 = 13

const EXT_SRTP: u16 = 14

const EXT_EMS: u16 = 23

const EXT_RENEGOTIATION: u16 = 0xff01

const RANDOM: u64 = 32

/// What a ClientHello offers, after its framing and per-extension rules are checked.
type Offer {
    version: u16,
    random: Bytes,
    cookie: Bytes,
    suites: List[u16],
    groups: List[u16],
    signs_p256: bool,
    ems: bool,
    has_srtp: bool,
    srtp: List[u16]
}

type Answer {
    random: Bytes,
    suite: u16,
    profile: Option[u16]
}

type KeyExchange {
    group: u16,
    point: Bytes,
    params_end: u64,
    algorithm: u16,
    signature: Bytes
}

type Reader {
    at: u64,
    end: u64
}

fn reader(b: Bytes) -> Reader {
    Reader(at: 0, end: list.len(b))
}

fn read_u8(b: Bytes, mut r: Reader) -> Option[u8] {
    if r.at >= r.end {
        return None
    }
    let x = b[r.at]
    r.at += 1
    Some(x)
}

fn read_u16(b: Bytes, mut r: Reader) -> Option[u16] {
    if r.end - r.at < 2 {
        return None
    }
    let x: u16 = list.word_be(b, r.at)
    r.at += 2
    Some(x)
}

/// A vector with a `width`-byte length prefix; answers a reader over its contents.
fn read_vector(b: Bytes, mut r: Reader, width: u64) -> Option[Reader] {
    if r.end - r.at < width {
        return None
    }
    let n: u64 = if width == 1 {
        int.widen(b[r.at])
    } else if width == 2 {
        let w: u16 = list.word_be(b, r.at)
        int.widen(w)
    } else {
        read_u24(b, r.at)
    }
    r.at += width
    if r.end - r.at < n {
        return None
    }
    let inner = Reader(at: r.at, end: r.at + n)
    r.at += n
    Some(inner)
}

fn copy_of(b: Bytes, r: Reader) -> Bytes {
    let mut out: Bytes = list.with_capacity(r.end - r.at)
    list.append(mut out, list.slice(b, r.at, r.end))
    out
}

fn has_code(xs: List[u16], x: u16) -> bool {
    for i in 0u64 .. list.len(xs) {
        if xs[i] == x {
            return true
        }
    }
    false
}

/// A non-empty vector of 16-bit codes with an even length.
fn read_codes(b: Bytes, mut r: Reader) -> Option[List[u16]] {
    let Some(found_v) = read_vector(b, mut r, 2) else {
        return None
    }
    let mut v = found_v
    if v.at == v.end || (v.end - v.at) % 2 != 0 {
        return None
    }
    let mut codes: List[u16] = list.with_capacity((v.end - v.at) / 2)
    while v.at < v.end {
        let Some(x) = read_u16(b, mut v) else {
            return None
        }
        list.push(mut codes, x)
    }
    Some(take codes)
}

fn suite_code(s: schedule.Suite12) -> u16 {
    match s {
        Aes128GcmSha256 => 0xc02b,
        Aes256GcmSha384 => 0xc02c,
        ChaCha20Poly1305Sha256 => 0xcca9,
    }
}

fn group_code(g: secret.Group) -> u16 {
    match g {
        X25519 => 0x001d,
        P256 => 0x0017,
    }
}

fn profile_code(p: schedule.SrtpProfile) -> u16 {
    match p {
        Aes128CmHmacSha1_80 => 0x0001,
        AeadAes128Gcm => 0x0007,
        AeadAes256Gcm => 0x0008,
    }
}

fn put_vector_u8(mut b: Bytes, v: Bytes) {
    list.push(mut b, int.narrow(list.len(v)))
    list.append(mut b, v)
}

fn put_vector_u16(mut b: Bytes, v: Bytes) {
    let n: u16 = int.narrow(list.len(v))
    list.put_word_be(mut b, n)
    list.append(mut b, v)
}

fn put_extension(mut b: Bytes, kind: u16, data: Bytes) {
    list.put_word_be(mut b, kind)
    put_vector_u16(mut b, data)
}

/// RFC 5246 section 7.4.1.2 with DTLS's cookie (RFC 6347 section 4.2.1) and DTLS-1's extensions.
fn client_hello_body(random: Bytes, cookie: Bytes, c: Config) -> Bytes {
    let mut b: Bytes = list.with_capacity(160)
    list.put_word_be(mut b, 0xfefdu16)
    list.append(mut b, random)
    list.push(mut b, 0)
    put_vector_u8(mut b, cookie)
    let mut suites: Bytes = list.with_capacity(2 * list.len(c.suites))
    for i in 0u64 .. list.len(c.suites) {
        list.put_word_be(mut suites, suite_code(c.suites[i]))
    }
    put_vector_u16(mut b, suites)
    list.push(mut b, 1)
    list.push(mut b, 0)
    let mut ext: Bytes = list.with_capacity(96)
    let mut groups: Bytes = list.with_capacity(2 * list.len(c.groups))
    for i in 0u64 .. list.len(c.groups) {
        list.put_word_be(mut groups, group_code(c.groups[i]))
    }
    let mut groups_data: Bytes = list.with_capacity(2 + list.len(groups))
    put_vector_u16(mut groups_data, groups)
    put_extension(mut ext, EXT_GROUPS, groups_data)
    put_extension(mut ext, EXT_POINT_FORMATS, b"\x01\x00")
    put_extension(mut ext, EXT_SIGNATURES, b"\x00\x04\x04\x03\x05\x03")
    if list.len(c.srtp) != 0 {
        let mut profiles: Bytes = list.with_capacity(2 * list.len(c.srtp))
        for i in 0u64 .. list.len(c.srtp) {
            list.put_word_be(mut profiles, profile_code(c.srtp[i]))
        }
        let mut srtp: Bytes = list.with_capacity(3 + list.len(profiles))
        put_vector_u16(mut srtp, profiles)
        list.push(mut srtp, 0)
        put_extension(mut ext, EXT_SRTP, srtp)
    }
    put_extension(mut ext, EXT_EMS, b"")
    put_extension(mut ext, EXT_RENEGOTIATION, b"\x00")
    put_vector_u16(mut b, ext)
    b
}

fn server_hello_body(random: Bytes, suite: u16, profile: Option[u16]) -> Bytes {
    let mut b: Bytes = list.with_capacity(80)
    list.put_word_be(mut b, 0xfefdu16)
    list.append(mut b, random)
    list.push(mut b, 0)
    list.put_word_be(mut b, suite)
    list.push(mut b, 0)
    let mut ext: Bytes = list.with_capacity(32)
    put_extension(mut ext, EXT_RENEGOTIATION, b"\x00")
    put_extension(mut ext, EXT_EMS, b"")
    put_extension(mut ext, EXT_POINT_FORMATS, b"\x01\x00")
    if let Some(p) = profile {
        let mut srtp: Bytes = list.with_capacity(5)
        list.put_word_be(mut srtp, 2u16)
        list.put_word_be(mut srtp, p)
        list.push(mut srtp, 0)
        put_extension(mut ext, EXT_SRTP, srtp)
    }
    put_vector_u16(mut b, ext)
    b
}

fn certificate_body(certificate: Bytes) -> Bytes {
    let n = list.len(certificate)
    let mut b: Bytes = list.with_capacity(n + 6)
    put_u24(mut b, n + 3)
    put_u24(mut b, n)
    list.append(mut b, certificate)
    b
}

/// ServerECDHParams (RFC 8422 section 5.4): named_curve, the group and the point.
fn key_exchange_params(group: u16, point: Bytes) -> Bytes {
    let mut b: Bytes = list.with_capacity(4 + list.len(point))
    list.push(mut b, 3)
    list.put_word_be(mut b, group)
    put_vector_u8(mut b, point)
    b
}

/// A DigitallySigned (RFC 5246 section 4.7) with 0x0403, after `prefix`.
fn signed_body(prefix: Bytes, der: Bytes) -> Bytes {
    let mut b: Bytes = list.with_capacity(list.len(prefix) + 4 + list.len(der))
    list.append(mut b, prefix)
    list.put_word_be(mut b, ECDSA_P256_SHA256)
    put_vector_u16(mut b, der)
    b
}

fn certificate_request_body() -> Bytes {
    let mut b: Bytes = list.with_capacity(10)
    list.append(mut b, b"\x01\x40\x00\x04\x04\x03\x05\x03\x00\x00")
    b
}

fn client_key_exchange_body(point: Bytes) -> Bytes {
    let mut b: Bytes = list.with_capacity(1 + list.len(point))
    put_vector_u8(mut b, point)
    b
}

fn der_integer(mut out: Bytes, raw: Bytes, lo: u64) {
    let mut i = lo
    while i < lo + 31 && raw[i] == 0 {
        i += 1
    }
    let pad = raw[i] >= 0x80
    let n = lo + 32 - i + if pad {
        1
    } else {
        0
    }
    list.push(mut out, 2)
    list.push(mut out, int.narrow(n))
    if pad {
        list.push(mut out, 0)
    }
    list.append(mut out, list.slice(raw, i, lo + 32))
}

/// ECDSA-Sig-Value (RFC 3279 section 2.2.3) from secret.sign's fixed-width r and s.
fn der_signature(raw: Bytes) -> Bytes {
    let mut body: Bytes = list.with_capacity(70)
    der_integer(mut body, raw, 0)
    der_integer(mut body, raw, 32)
    let mut out: Bytes = list.with_capacity(72)
    list.push(mut out, 0x30)
    put_vector_u8(mut out, body)
    out
}

fn parse_extensions(b: Bytes, mut e: Reader, mut offer: Offer) -> Result[(), u8] {
    let mut seen: List[u16] = list.new()
    while e.at < e.end {
        let Some(kind) = read_u16(b, mut e) else {
            return Error(ILLEGAL_PARAMETER)
        }
        let Some(found_d) = read_vector(b, mut e, 2) else {
            return Error(ILLEGAL_PARAMETER)
        }
        let mut d = found_d
        if has_code(seen, kind) {
            return Error(ILLEGAL_PARAMETER)
        }
        list.push(mut seen, kind)
        if kind == EXT_GROUPS {
            let Some(groups) = read_codes(b, mut d) else {
                return Error(ILLEGAL_PARAMETER)
            }
            offer.groups = groups
        } else if kind == EXT_POINT_FORMATS {
            let Some(formats) = read_vector(b, mut d, 1) else {
                return Error(ILLEGAL_PARAMETER)
            }
            let mut uncompressed = false
            for i in formats.at .. formats.end {
                if b[i] == 0 {
                    uncompressed = true
                }
            }
            if !uncompressed {
                return Error(ILLEGAL_PARAMETER)
            }
        } else if kind == EXT_SIGNATURES {
            let Some(algorithms) = read_codes(b, mut d) else {
                return Error(ILLEGAL_PARAMETER)
            }
            offer.signs_p256 = has_code(algorithms, ECDSA_P256_SHA256)
        } else if kind == EXT_SRTP {
            let Some(profiles) = read_codes(b, mut d) else {
                return Error(ILLEGAL_PARAMETER)
            }
            let Some(mki) = read_vector(b, mut d, 1) else {
                return Error(ILLEGAL_PARAMETER)
            }
            if mki.at != mki.end {
                return Error(ILLEGAL_PARAMETER)
            }
            offer.has_srtp = true
            offer.srtp = profiles
        } else if kind == EXT_EMS {
            offer.ems = true
        } else if kind == EXT_RENEGOTIATION {
            if d.end - d.at != 1 || b[d.at] != 0 {
                return Error(ILLEGAL_PARAMETER)
            }
            d.at = d.end
        } else {
            // supported_versions, key_share and the rest are not DTLS 1.2's: ignored.
            d.at = d.end
        }
        if d.at != d.end {
            return Error(ILLEGAL_PARAMETER)
        }
    }
    Ok(())
}

fn parse_client_hello(b: Bytes) -> Result[Offer, u8] {
    let mut r = reader(b)
    let Some(version) = read_u16(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let major: u8 = int.narrow(version >> 8)
    let minor: u8 = int.narrow(version & 0xff)
    if major != 254 || minor > 253 {
        return Error(PROTOCOL_VERSION)
    }
    if r.end - r.at < RANDOM {
        return Error(ILLEGAL_PARAMETER)
    }
    let random = copy_of(b, Reader(at: r.at, end: r.at + RANDOM))
    r.at += RANDOM
    let Some(session) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(cookie) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(suites) = read_codes(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(compression) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if session.end - session.at > 32 {
        return Error(ILLEGAL_PARAMETER)
    }
    let mut null = false
    for i in compression.at .. compression.end {
        if b[i] == 0 {
            null = true
        }
    }
    if !null {
        return Error(ILLEGAL_PARAMETER)
    }
    let mut offer = Offer(version: version, random: take random, cookie: copy_of(b, cookie), suites: take suites, groups: list.new(), signs_p256: false, ems: false, has_srtp: false, srtp: list.new())
    if r.at < r.end {
        let Some(found_e) = read_vector(b, mut r, 2) else {
            return Error(ILLEGAL_PARAMETER)
        }
        let mut e = found_e
        if r.at != r.end {
            return Error(ILLEGAL_PARAMETER)
        }
        parse_extensions(b, mut e, mut offer)?
    }
    Ok(take offer)
}

/// RFC 5246 section 7.4.1.3 against what the client offered (DTLS-5 Client flight).
fn parse_server_hello(b: Bytes, suites: List[u16], profiles: List[u16]) -> Result[Answer, u8] {
    let mut r = reader(b)
    let Some(version) = read_u16(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if version != 0xfefd {
        return Error(PROTOCOL_VERSION)
    }
    if r.end - r.at < RANDOM {
        return Error(ILLEGAL_PARAMETER)
    }
    let random = copy_of(b, Reader(at: r.at, end: r.at + RANDOM))
    r.at += RANDOM
    let Some(session) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(suite) = read_u16(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(compression) = read_u8(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if session.end - session.at > 32 || !has_code(suites, suite) || compression != 0 {
        return Error(ILLEGAL_PARAMETER)
    }
    let mut ems = false
    let mut profile: Option[u16] = None
    if r.at < r.end {
        let Some(found_e) = read_vector(b, mut r, 2) else {
            return Error(ILLEGAL_PARAMETER)
        }
        let mut e = found_e
        if r.at != r.end {
            return Error(ILLEGAL_PARAMETER)
        }
        let mut seen: List[u16] = list.new()
        while e.at < e.end {
            let Some(kind) = read_u16(b, mut e) else {
                return Error(ILLEGAL_PARAMETER)
            }
            let Some(found_d) = read_vector(b, mut e, 2) else {
                return Error(ILLEGAL_PARAMETER)
            }
            let mut d = found_d
            if has_code(seen, kind) {
                return Error(ILLEGAL_PARAMETER)
            }
            list.push(mut seen, kind)
            if kind == EXT_RENEGOTIATION {
                if d.end - d.at != 1 || b[d.at] != 0 {
                    return Error(ILLEGAL_PARAMETER)
                }
                d.at = d.end
            } else if kind == EXT_EMS {
                ems = true
            } else if kind == EXT_POINT_FORMATS {
                let Some(formats) = read_vector(b, mut d, 1) else {
                    return Error(ILLEGAL_PARAMETER)
                }
                let mut uncompressed = false
                for i in formats.at .. formats.end {
                    if b[i] == 0 {
                        uncompressed = true
                    }
                }
                if !uncompressed {
                    return Error(ILLEGAL_PARAMETER)
                }
            } else if kind == EXT_SRTP && list.len(profiles) != 0 {
                let Some(chosen) = read_codes(b, mut d) else {
                    return Error(ILLEGAL_PARAMETER)
                }
                let Some(mki) = read_vector(b, mut d, 1) else {
                    return Error(ILLEGAL_PARAMETER)
                }
                if list.len(chosen) != 1 || !has_code(profiles, chosen[0]) || mki.at != mki.end {
                    return Error(ILLEGAL_PARAMETER)
                }
                profile = Some(chosen[0])
            } else {
                // RFC 5246 section 7.4.1.4: an extension the client did not offer for answer.
                return Error(ILLEGAL_PARAMETER)
            }
            if d.at != d.end {
                return Error(ILLEGAL_PARAMETER)
            }
        }
    }
    if !ems {
        return Error(HANDSHAKE_FAILURE)
    }
    if list.len(profiles) != 0 {
        if let None = profile {
            return Error(HANDSHAKE_FAILURE)
        }
    }
    Ok(Answer(random: take random, suite: suite, profile: profile))
}

/// The first certificate of a Certificate message (RFC 5246 section 7.4.2); None when empty.
fn parse_certificate(b: Bytes) -> Result[Option[Bytes], u8] {
    let mut r = reader(b)
    let Some(found_chain) = read_vector(b, mut r, 3) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let mut chain = found_chain
    if r.at != r.end {
        return Error(ILLEGAL_PARAMETER)
    }
    let mut first: Option[Bytes] = None
    while chain.at < chain.end {
        let Some(c) = read_vector(b, mut chain, 3) else {
            return Error(ILLEGAL_PARAMETER)
        }
        if c.at == c.end {
            return Error(BAD_CERTIFICATE)
        }
        if let None = first {
            first = Some(copy_of(b, c))
        }
    }
    Ok(take first)
}

fn parse_key_exchange(b: Bytes) -> Result[KeyExchange, u8] {
    let mut r = reader(b)
    let Some(curve_type) = read_u8(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(group) = read_u16(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(point) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let params_end = r.at
    let Some(algorithm) = read_u16(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(signature) = read_vector(b, mut r, 2) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if curve_type != 3 || point.at == point.end || r.at != r.end {
        return Error(ILLEGAL_PARAMETER)
    }
    Ok(KeyExchange(group: group, point: copy_of(b, point), params_end: params_end, algorithm: algorithm, signature: copy_of(b, signature)))
}

/// RFC 5246 section 7.4.4: ecdsa_sign and 0x0403 must be acceptable to the server.
fn parse_certificate_request(b: Bytes) -> Result[(), u8] {
    let mut r = reader(b)
    let Some(types) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(algorithms) = read_codes(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(_) = read_vector(b, mut r, 2) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if r.at != r.end {
        return Error(ILLEGAL_PARAMETER)
    }
    let mut ecdsa = false
    for i in types.at .. types.end {
        if b[i] == ECDSA_SIGN {
            ecdsa = true
        }
    }
    if !ecdsa || !has_code(algorithms, ECDSA_P256_SHA256) {
        return Error(HANDSHAKE_FAILURE)
    }
    Ok(())
}

fn parse_client_key_exchange(b: Bytes) -> Result[Bytes, u8] {
    let mut r = reader(b)
    let Some(point) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if point.at == point.end || r.at != r.end {
        return Error(ILLEGAL_PARAMETER)
    }
    Ok(copy_of(b, point))
}

fn parse_verify(b: Bytes) -> Result[(u16, Bytes), u8] {
    let mut r = reader(b)
    let Some(algorithm) = read_u16(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(signature) = read_vector(b, mut r, 2) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if r.at != r.end {
        return Error(ILLEGAL_PARAMETER)
    }
    Ok((algorithm, copy_of(b, signature)))
}

fn parse_verify_request(b: Bytes) -> Result[(u16, Bytes), u8] {
    let mut r = reader(b)
    let Some(version) = read_u16(b, mut r) else {
        return Error(ILLEGAL_PARAMETER)
    }
    let Some(cookie) = read_vector(b, mut r, 1) else {
        return Error(ILLEGAL_PARAMETER)
    }
    if r.at != r.end {
        return Error(ILLEGAL_PARAMETER)
    }
    Ok((version, copy_of(b, cookie)))
}

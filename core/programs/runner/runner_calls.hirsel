fn migration_second_refuses(mut phase: store.Migration) -> Result[(), store.Error] {
    store.migration_create_table(mut phase, store.spec("first", std.codec.key_u64(), std.codec.of_u64()))?
    let second = store.spec("second", std.codec.key_u64(), std.codec.of_u64())
    let attempted = bound bytes 0u64 {
        store.migration_create_table(mut phase, take second)
    }
    match take attempted {
        Ok(take outcome) => take outcome,
        Error(c) => Error(Full(Allocation(c))),
    }
}

// L33. The second operation refuses. Reopen the backing store and look for
// both table names in the recovered catalog.
pub fn law_atomic_migration(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let options = disk_options()
    let db = result.unwrap(store.open(tasks, d, c, r, options))
    let (_, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(1)
    let mail = result.unwrap(runner.mailbox(1))
    let opened = runner.place_head(take db, code.describe(place), N_PLACE,
        Some(code.describe(migration_second_refuses)), code.describe(schema), take inbox, take mail, tasks, 1048576)
    if let Error(Migrate(Full(_))) = opened {} else { return false }
    let reopened = result.unwrap(store.open(tasks, d, c, r, options))
    let snapshot = store.snapshot(reopened)
    let unchanged = store.version(snapshot) == 0 &&
        !result.unwrap(store.has_table(snapshot, "first")) && !result.unwrap(store.has_table(snapshot, "second"))
    result.unwrap(store.close(take reopened))
    unchanged
}

@test
fn test_atomic_migration(parent: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    let mut name = string.with_capacity(32)
    let directory = result.unwrap(host.mkdtemp(parent, mut name))
    let good = law_atomic_migration(directory, c, r, tasks)
    result.unwrap(std.dir.remove_all(parent, name))
    if good { Ok(()) } else { Error(()) }
}

// L32 (RUNNER-SPEC v2.19.1, `duplicate_own_reply`). note_write refuses a Caller
// with no membership row and otherwise counts that Caller's writes, so a re-run
// or a re-check of a duplicate answers differently from the saved reply.
type NoteHandles: shareable + send { notes: store.Table[u64, u64], members: store.Table[u64, u64] }
type NoteRegistry = runner.Registry[(), NoteHandles]

fn note_schema(mut d: store.Declare) -> Result[NoteHandles, store.Error] {
    let notes = store.declare_table(mut d, "notes", std.codec.key_u64(), std.codec.of_u64())?
    let note_table = store.finish(mut d, take notes)?
    let members = store.declare_table(mut d, "members", std.codec.key_u64(), std.codec.of_u64())?
    let member_table = store.finish(mut d, take members)?
    Ok(NoteHandles(notes: take note_table, members: take member_table))
}

fn note_write(mut tx: store.Tx, hd: NoteHandles, caller: runner.Caller, take unused: u64) -> Result[u64, u32] {
    let owner: u64 = int.widen(caller.subject[0])
    if result.unwrap(store.fetch(tx, hd.members, owner)) != Some(1u64) { return Error(17u32) }
    let count = match result.unwrap(store.fetch(tx, hd.notes, owner)) {
        Some(previous) => previous + 1u64,
        None => 1u64,
    }
    result.unwrap(store.put(mut tx, hd.notes, owner, count))
    Ok(owner * 1000u64 + count)
}

fn note_revoke(mut tx: store.Tx, hd: NoteHandles, caller: runner.Caller, take owner: u64) -> Result[u64, u32] {
    if caller.subject[0] != 0u8 { return Error(18u32) }
    if result.unwrap(store.delete(mut tx, hd.members, owner)) { Ok(owner) } else { Error(19u32) }
}

fn note_place(mut r: NoteRegistry) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(note_write), 65536u64, 8192u64)?
    runner.transact(mut r, code.describe(note_revoke), 65536u64, 8192u64)
}

type NoteDriver: send { head: Sender[runner.HeadInput] }

fn note_send(d: NoteDriver, owner: u8, stream: u32, p: u64, f: StaticFn[fn(mut store.Tx, NoteHandles, runner.Caller, take u64) -> Result[u64, u32]], arg: u64) -> runner.Outcome waits {
    let mut subject: Bytes = list.new()
    list.push(mut subject, owner)
    let caller = store.Caller(issuer: 1u8, subject: take subject)
    let name = store.StreamId(t: 0u64, n: int.widen(stream))
    let key = key_of(code.identity(f), std.codec.of_u64(), reply())
    let (to, from): (Sender[runner.WireEvent], Receiver[runner.WireEvent]) = channel.new(1u64)
    result.unwrap(channel.send(d.head, RunRequest(runner.head_request(take caller, name, p, take key, u64_arg(arg), take to))))
    let delivery = option.unwrap(runner.head_outcome(result.unwrap(channel.receive(from))))
    let runner.KeyedDone(outcome: take outcome, ..) = take delivery
    take outcome
}

// Caller 1 is A, caller 2 is B, caller 0 is the administrator. A and B are members.
fn drive_notes(take d: NoteDriver) -> () waits {
    let entry = code.describe(note_write)
    let first = note_send(d, 1u8, 7u32, 0u64, entry, 0u64)
    want(ok_value(first) == Some(1001u64), "L32: A's first call counts one")
    want(ok_value(note_send(d, 0u8, 0u32, 0u64, code.describe(note_revoke), 1u64)) == Some(1u64), "L32: the administrator removes A")
    want(is(note_send(d, 1u8, 7u32, 0u64, entry, 0u64), first), "L32: A's duplicate is its saved reply, unchanged")
    want(err_value(note_send(d, 1u8, 7u32, 1u64, entry, 0u64)) == Some(17u32), "L32: A's next position runs and refuses")
    want(is(note_send(d, 1u8, 7u32, 0u64, entry, 0u64), Refused(HistoryUnavailable)), "L32: A's older position is unavailable")
    want(ok_value(note_send(d, 2u8, 7u32, 0u64, entry, 0u64)) == Some(2001u64), "L32: B's position runs fresh")
}

pub fn law_duplicate_own_reply(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = store.memory(c, r, result.unwrap(store.sized(Memory, 1074790400u64)))
    let mut declaration = result.unwrap(store.declare(db, Migrate))
    let hd = result.unwrap(note_schema(mut declaration))
    let _ = result.unwrap(store.seal(mut db, take declaration))
    let seeded = result.unwrap(store.run(mut db, None, hd, fn(mut tx, call_env) -> Result[(), store.Error] {
        store.put(mut tx, call_env.members, 1u64, 1u64)?
        store.put(mut tx, call_env.members, 2u64, 1u64)
    }))
    if let Committed(_) = seeded {} else { return false }
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(4u64)
    let mail = result.unwrap(runner.mailbox(4u64))
    let driving = task.spawn(tasks, bytes 1048576u64, NoteDriver(head: take head), drive_notes)
    let ended = runner.place_head(take db, code.describe(note_place), N_PLACE, None, code.describe(note_schema), take inbox, take mail, tasks, 1048576u64)
    let drove = task.join(take driving)
    match (take ended, take drove) { (Ok(()), Ok(())) => true, _ => false }
}


@test
fn test_duplicate_own_reply(c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_duplicate_own_reply(c, r, tasks) { Ok(()) } else { Error(()) }
}

fn reserve_registration() -> bool {
    // The byte reserve is n + A_b with A_b = 32 (L33): 2^64 - 32 is the
    // smallest n whose reserve does not fit in u64, and s + 6 overflows at
    // s = u64::MAX.
    let wrap = 18446744073709551584u64
    let entry = code.describe(write)
    let mut first: Calls = runner.registry()
    if let Error(Bounds) = runner.transact(mut first, entry, wrap, 8192) {} else { return false }
    match runner.transact(mut first, entry, 8, 18446744073709551615u64) {
        Error(Bounds) => true,
        _ => false,
    }
}

pub fn law_serve_bounded_and_settled(c: Clock) -> bool waits {
    reserve_registration() && store.law_call_reserve(c)
}

@test
fn test_serve_bounded_and_settled(c: Clock) -> Result[(), ()] waits {
    if law_serve_bounded_and_settled(c) { Ok(()) } else { Error(()) }
}

# The pinned profile `build --pgo` copies here, uncommitted; Buck2 hashes its bytes into every use action.
# Declare it only for an explicit PGO-use build, so ordinary builds need no file.
[export_file(name = "profile", src = "profile.profdata", visibility = ["PUBLIC"])
 for _ in [0] if read_root_config("hirsel", "dist_pgo", "off") == "use"]

[export_file(name = "hirsel-bolt", src = "hirsel.bolt", mode = "reference", visibility = ["PUBLIC"])
 for _ in [0] if read_root_config("hirsel", "dist_bolt", "off") == "use"]

export_file(name = "notices.py", mode = "reference", visibility = ["PUBLIC"])

export_file(name = "toolchain_programs.py", visibility = ["PUBLIC"])
export_file(name = "link_exec_helper.py", visibility = ["PUBLIC"])

export_file(name = "product.toml", mode = "reference", visibility = ["PUBLIC"])

# The distribution gates read these at their repository paths.
[export_file(name = path, src = path, mode = "reference", visibility = ["PUBLIC"])
 for path in ["build", "check-installer", "darwin_host.py", "install.sh.in", "product.py", "notice-sources.json"] + glob(["licenses/**"])]

fn snapshot_paged(s: Snapshot) -> bool {
    match s.roots.collections.paging {
        Some(_) => true,
        None => false
    }
}

// `changes` between two Snapshots of one open (§1.5).
fn snapshot_changes(r: Reader, a: Snapshot, b: Snapshot) -> Result[Changes, Error] waits {
    if !snapshot_paged(a) && !snapshot_paged(b) {
        return compare_page_collections(a.roots.collections, b.roots.collections)
    }
    if pages.tree_stamp(a.roots.collections) == pages.tree_stamp(b.roots.collections) {
        return Ok(Changes(rows: list.new(), trimmed: list.new(), bounds: list.new()))
    }
    let out = tiered_changes(r, a, b, None, None, None)?
    let ChangeOutput(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds, ..) = take out
    Ok(Changes(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds))
}

// The base diff over stores with a pager. The page walk diffs every Memory
// collection and every Log's bounds and trims by subtree stamps, as without
// a pager, and stops at a collection whose descriptor changed and that is
// Tiered on either side. Those rows are merged here from both Snapshots'
// key-ordered rows, each read through its own pin root, and the walk resumes
// at the next collection. A Tiered collection whose descriptor is unchanged
// is skipped by its stamp, and in one that changed the merge reads only the
// spans `tiered_diff_spans` leaves (§1.5).
fn tiered_changes(r: Reader, a: Snapshot, b: Snapshot, take lo: Option[Bytes], hi: Option[Bytes], limits: Option[Limits]) -> Result[ChangeOutput, Error] waits {
    let mut out = change_output(limits)
    let mut low = take lo
    loop {
        let part = disk_allocation(scoped fn() -> Result[ChangeOutput, Error] {
            let mut part = change_output(out.limits)
            part.remaining = out.remaining
            part.carried = out.carried + list.len(out.rows) + list.len(out.trimmed) + list.len(out.bounds)
            walk_page_changes(mut part, Some(view a.roots.collections), b.roots.collections, clone(low), clone(hi))?
            Ok(take part)
        })?
        let ChangeOutput(rows: take rows, trimmed: take trimmed, bounds: take changed_bounds, remaining, next: take resume, deferred: take deferred, ..) = take part
        failure_result_from_rep(types.capacity(list.try_reserve(mut out.rows, list.len(rows))))?
        for take row in take rows {
            list.push(mut out.rows, take row)
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut out.trimmed, list.len(trimmed))))?
        for take span in take trimmed {
            list.push(mut out.trimmed, take span)
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut out.bounds, list.len(changed_bounds))))?
        for take edge in take changed_bounds {
            list.push(mut out.bounds, take edge)
        }
        out.remaining = remaining
        out.next = take resume
        let Some(take diff) = take deferred else {
            break
        }
        let next_collection = failure_result_from_rep(catalog.prefix(diff.id + 1))?
        if !tiered_row_changes(r, a, b, mut out, take diff)? {
            break
        }
        if let Some(end) = view hi {
            if next_collection >= end {
                break
            }
        }
        low = Some(take next_collection)
    }
    Ok(take out)
}

// Merges one collection's rows from both sides into `out`, over the spans
// `tiered_diff_spans` leaves: a key only the base holds is a deletion, and a
// key the target holds with no equal base row is a put. False when the page
// filled.
fn tiered_row_changes(r: Reader, a: Snapshot, b: Snapshot, mut out: ChangeOutput, take diff: pager.TieredRowDiff) -> Result[bool, Error] waits {
    let collection = failure_result_from_rep(catalog.prefix(diff.id))?
    let low = match diff.start {
        Some(suffix) => failure_result_from_rep(catalog.logical_key(diff.id, suffix))?,
        None => failure_result_from_rep(types.copied(collection))?
    }
    let high = match diff.stop {
        Some(suffix) => failure_result_from_rep(catalog.logical_key(diff.id, suffix))?,
        None => failure_result_from_rep(catalog.prefix(diff.id + 1))?
    }
    let spans = tiered_diff_spans(r, a, b, diff, low, high)?
    for span in spans {
        if !tiered_span_changes(r, a, b, mut out, diff, span.0, span.1)? {
            return Ok(false)
        }
    }
    Ok(true)
}

fn tiered_span_changes(r: Reader, a: Snapshot, b: Snapshot, mut out: ChangeOutput, diff: pager.TieredRowDiff, low: Bytes, high: Bytes) -> Result[bool, Error] waits {
    let mut left = pager.TieredDiffSide(rows: list.new(), at: 0, from: failure_result_from_rep(types.copied(low))?, done: !diff.before)
    let mut right = pager.TieredDiffSide(rows: list.new(), at: 0, from: failure_result_from_rep(types.copied(low))?, done: !diff.after)
    loop {
        tiered_diff_fill(r, a, diff.id, mut left, high)?
        tiered_diff_fill(r, b, diff.id, mut right, high)?
        let old_key: Option[View[Bytes]] = if left.at < list.len(left.rows) {
            Some(view left.rows[left.at].0)
        } else {
            None
        }
        let new_key: Option[View[Bytes]] = if right.at < list.len(right.rows) {
            Some(view right.rows[right.at].0)
        } else {
            None
        }
        let comparison = match (old_key, new_key) {
            (None, None) => return Ok(true),
            (None, Some(_)) => Greater,
            (Some(_), None) => Less,
            (Some(x), Some(y)) => list.compare_bytes(x, y),
        }
        if comparison == Less {
            let key = failure_result_from_rep(types.copied(left.rows[left.at].0))?
            if !admit_change(mut out, key, list.len(key))? {
                return Ok(false)
            }
            list.push(mut out.rows, Change(tree_key: take key, value: None))
        } else if comparison == Greater || left.rows[left.at].1 != right.rows[right.at].1 {
            let key = failure_result_from_rep(types.copied(right.rows[right.at].0))?
            let value = arc.share(right.rows[right.at].1)
            if !admit_change(mut out, key, int.saturating_add(list.len(key), list.len(value)))? {
                return Ok(false)
            }
            list.push(mut out.rows, Change(tree_key: take key, value: Some(take value)))
        }
        if comparison != Greater {
            left.at = left.at + 1
        }
        if comparison != Less {
            right.at = right.at + 1
        }
    }
}

// The spans of [low, high) where the two sides' rows may differ, in key
// order and disjoint. When both sides hold the collection Tiered, the two
// trees are walked top down from their roots, the higher level first, and an
// edge whose stamp is an edge of the other side's frontier is dropped from
// both: a stamp names one subtree, so on the keys both edges cover the two
// sides hold the same rows. A key whose rows differ is never under a dropped
// edge on a side that holds it (that edge's twin would hold the same row), so
// it is under a leaf left on that side. The spans are those leaves, each
// side's replayed keys (an overlay row masks its tree row) and a Log's moved
// window edges. Otherwise the span is the whole range (§1.5).
fn tiered_diff_spans(r: Reader, a: Snapshot, b: Snapshot, diff: pager.TieredRowDiff, low: Bytes, high: Bytes) -> Result[List[(Bytes, Bytes)], Error] waits {
    let mut spans: List[(Bytes, Bytes)] = list.new()
    let key = failure_result_from_rep(catalog.prefix(diff.id))?
    let both = diff.before && diff.after && tiered_diff_paged(a, key) && tiered_diff_paged(b, key)
    if !both {
        list.push(mut spans, (failure_result_from_rep(types.copied(low))?, failure_result_from_rep(types.copied(high))?))
        return Ok(take spans)
    }
    let mut left = pager.tiered_diff_root(a.roots.collections, key)
    let mut right = pager.tiered_diff_root(b.roots.collections, key)
    loop {
        pager.tiered_diff_drop_shared(mut left, mut right)
        let top = pager.tiered_diff_top(left, right)
        if top == 0 {
            break
        }
        let deeper_left = tiered_diff_deepen(r, a, take left, top)?
        left = take deeper_left
        let deeper_right = tiered_diff_deepen(r, b, take right, top)?
        right = take deeper_right
    }
    for edge in left {
        failure_result_from_rep(pager.tiered_diff_add_span(mut spans, diff.id, edge, low, high))?
    }
    for edge in right {
        failure_result_from_rep(pager.tiered_diff_add_span(mut spans, diff.id, edge, low, high))?
    }
    tiered_diff_overlay_spans(mut spans, a.roots.collections, diff.id, low, high)?
    tiered_diff_overlay_spans(mut spans, b.roots.collections, diff.id, low, high)?
    let (_, before_descriptor) = option.unwrap(std.page.collection_slot(a.roots.collections.root, key))
    let (_, after_descriptor) = option.unwrap(std.page.collection_slot(b.roots.collections.root, key))
    if pages.collection_descriptor(before_descriptor).kind == LogCollection && pages.collection_descriptor(after_descriptor).kind == LogCollection {
        let old = pager.descriptor_bounds(before_descriptor)
        let new = pager.descriptor_bounds(after_descriptor)
        failure_result_from_rep(pager.tiered_diff_window_span(mut spans, diff.id, old.first, new.first, low, high))?
        failure_result_from_rep(pager.tiered_diff_window_span(mut spans, diff.id, old.next, new.next, low, high))?
    }
    Ok(pager.tiered_diff_merge(take spans))
}

fn tiered_diff_paged(s: Snapshot, key: Bytes) -> bool {
    let Some(_) = view s.roots.collections.paging else {
        return false
    }
    match std.page.collection_slot(s.roots.collections.root, key) {
        Some((_, descriptor)) => pages.collection_descriptor(descriptor).residency != ResidentMemory,
        None => false,
    }
}

// Replaces each edge at level `top` with its children, through `s`'s own pin
// root; the rest stay.
fn tiered_diff_deepen(r: Reader, s: Snapshot, take edges: List[pager.TieredDiffEdge], top: u8) -> Result[List[pager.TieredDiffEdge], Error] waits {
    let mut kept: List[pager.TieredDiffEdge] = list.new()
    let mut pending: List[pager.TieredDiffEdge] = list.new()
    for take edge in take edges {
        if edge.level != top {
            list.push(mut kept, take edge)
            continue
        }
        list.push(mut pending, take edge)
        if list.len(pending) == pager.TIERED_DIFF_EXPAND {
            let children = tiered_diff_expand(r, s, take pending)?
            for take child in take children {
                list.push(mut kept, take child)
            }
            pending = list.new()
        }
    }
    if list.len(pending) != 0 {
        let children = tiered_diff_expand(r, s, take pending)?
        for take child in take children {
            list.push(mut kept, take child)
        }
    }
    Ok(take kept)
}

// The children of `edges`, read in one pager attempt. A page that turns out
// to be a leaf stays as its own edge at level 0.
fn tiered_diff_expand(r: Reader, s: Snapshot, take edges: List[pager.TieredDiffEdge]) -> Result[List[pager.TieredDiffEdge], Error] waits {
    let Some(inventory) = view s.roots.collections.paging else {
        fail("store: a pruned Tiered diff reads a paged Snapshot")
    }
    let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
    let empty_hint: Bytes = list.new()
    retry_tiered_read(source, grant, root, empty_hint, None, TieredForward, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[List[pager.TieredDiffEdge], Error] {
        let mut out: List[pager.TieredDiffEdge] = list.new()
        for edge in edges {
            let expected: Option[u8] = if edge.level == pager.TIERED_DIFF_UNREAD {
                None
            } else {
                Some(edge.level)
            }
            let page = failure_result_from_rep(pager.tiered_point_page(attempt, visible, edge.slot, expected))?
            failure_result_from_rep(pager.tiered_diff_children(edge, page, mut out))?
        }
        Ok(take out)
    })
}

// Each replayed key of collection `id` at `s`, as the span of that one key.
fn tiered_diff_overlay_spans(mut spans: List[(Bytes, Bytes)], tree: pages.PageTree, id: u32, low: Bytes, high: Bytes) -> Result[(), Error] {
    let Some(replay) = view tree.replay else {
        return Ok(())
    }
    let Some(overlay) = std.omap.get(replay.collections, id) else {
        return Ok(())
    }
    let mut cursor = std.omap.range(overlay.entries, Included(failure_result_from_rep(types.copied(low))?), Excluded(failure_result_from_rep(types.copied(high))?))
    while let Some((take key, _)) = std.omap.next(mut cursor) {
        let mut after = failure_result_from_rep(types.copied(key))?
        list.push(mut after, 0u8)
        failure_result_from_rep(pager.tiered_diff_push(mut spans, take key, take after, low, high))?
    }
    Ok(())
}

fn tiered_diff_fill(r: Reader, s: Snapshot, id: u32, mut side: pager.TieredDiffSide, high: Bytes) -> Result[(), Error] waits {
    if side.done || side.at < list.len(side.rows) {
        return Ok(())
    }
    let batch = snapshot_collection_rows(r, s, id, side.from, high)?
    side.done = list.len(batch) < pager.TIERED_DIFF_BATCH
    if let Some(final_row) = list.last(batch) {
        side.from = failure_result_from_rep(pager.scan_page_after(final_row.0))?
    }
    side.rows = take batch
    side.at = 0
    Ok(())
}

// Up to TIERED_DIFF_BATCH rows of collection `id` in [low, high) at `s`, in
// key order, read through `s`'s own pin root when the collection is Tiered.
fn snapshot_collection_rows(r: Reader, s: Snapshot, id: u32, low: Bytes, high: Bytes) -> Result[List[(Bytes, Arc[Bytes])], Error] waits {
    let tree = view s.roots.collections
    let key = failure_result_from_rep(catalog.prefix(id))?
    let Some((_, descriptor)) = std.page.collection_slot(tree.root, key) else {
        return Ok(list.new())
    }
    if let Some(inventory) = view tree.paging {
        if pages.collection_descriptor(descriptor).residency != ResidentMemory {
            let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
            let empty_hint: Bytes = list.new()
            return retry_tiered_read(source, grant, root, empty_hint, None, TieredForward, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[List[(Bytes, Arc[Bytes])], Error] {
                let (edge, slot_descriptor) = option.unwrap(std.page.collection_slot(tree.root, key))
                let mut rows: List[(Bytes, Arc[Bytes])] = list.new()
                let mut start = failure_result_from_rep(types.copied(low))?
                while list.len(rows) < pager.TIERED_DIFF_BATCH {
                    let Some((take row_key, take value)) = failure_result_from_rep(pager.tiered_span_collection(attempt, visible, s.roots.collections, edge, slot_descriptor, id, start, high))? else {
                        break
                    }
                    start = failure_result_from_rep(pager.scan_page_after(row_key))?
                    list.push(mut rows, (take row_key, take value))
                }
                Ok(take rows)
            })
        }
    }
    disk_allocation(scoped fn() -> Result[List[(Bytes, Arc[Bytes])], Error] {
        let mut rows: List[(Bytes, Arc[Bytes])] = list.new()
        let mut cursor = byte_cursor(s.roots.collections, Included(failure_result_from_rep(types.copied(low))?), high)?
        while list.len(rows) < pager.TIERED_DIFF_BATCH {
            let Some((take row_key, take value)) = failure_result_from_rep(catalog.next_bytes(mut cursor))? else {
                break
            }
            list.push(mut rows, (take row_key, take value))
        }
        Ok(take rows)
    })
}

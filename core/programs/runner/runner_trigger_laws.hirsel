    Ok(value)
}

fn trigger_scan_law_new(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    trigger_law_places(mut reg)?
    transact(mut reg, code.describe(trigger_scan_law_unchanged), 131072u64, DEFAULT_STEPS)
}

fn trigger_scan_law_old(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    trigger_scan_law_new(mut reg)?
    transact(mut reg, code.describe(trigger_scan_law_removed), 131072u64, DEFAULT_STEPS)?
    granted(mut reg, code.describe(trigger_scan_law_removed_run), 131072u64, DEFAULT_STEPS)
}

fn trigger_scan_law_bytes(n: u64, byte: u8) -> Bytes {
    let mut raw: Bytes = list.with_capacity(n)
    list.fill(mut raw, n, byte)
    take raw
}

// L40. Use the real export and prepare writer against a recorded OLD revision.
@test
fn trigger_scan_classes(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    let mut options = triggers.law_options()
    options.pack_bytes = 1048576u64
    trigger_scan_image(d, c, r, tasks, options, false)?
    trigger_scan_image(d, c, r, tasks, options, true)?
    trigger_scan_last_entry(d, c, r, tasks, options, false)?
    trigger_scan_last_entry(d, c, r, tasks, options, true)
}

fn trigger_scan_image(d: Dir, c: Clock, r: Random, tasks: Tasks, options: store.Options, same_image: bool) -> Result[(), ()] waits {
    let dir = triggers.law_directory(d)
    let mut db = result.unwrap(store.open(tasks, dir, c, r, options))
    let n_place = 1048576u64
    let old_digest = trigger_scan_law_bytes(32u64, 1u8)
    let new_digest = trigger_scan_law_bytes(32u64, if same_image {
        1u8
    } else {
        2u8
    })
    let new_place = if same_image {
        code.describe(trigger_scan_law_old)
    } else {
        code.describe(trigger_scan_law_new)
    }
    let new_n_place = n_place
    let mut old_reg = result.unwrap(placed(code.describe(trigger_scan_law_old), n_place))
    // Model an older body at the same path and schema, as recorded by OLD.
    if !same_image {
        old_reg.exported[0u64].revision = trigger_scan_law_bytes(32u64, 3u8)
    }
    let Registry(exported: take exported, ..) = take old_reg
    let release = result.unwrap(release_digest(exported))
    let old_description = Describe(digest: clone(old_digest), target: "", n_place: n_place, revision: launch_bytes(launch_env().revision), exported: take exported, tables: list.new(), bindings: list.new())
    let old_binding = result.unwrap(identity_digest(old_description))
    let old_desc = result.unwrap(encode_describe(old_description))
    let mut declaration = result.unwrap(store.declare(db, Migrate))
    let handles = result.unwrap(trigger_law_schema(mut declaration))
    let mut staged = result.unwrap(store.finish_migration(db, take declaration))
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    result.unwrap(store.stage_activation(mut staged, 1u64, None, old_desc, release_codec, ReleaseRecord(release: take release, digest: clone(old_digest), binding: clone(old_binding), n_place: n_place, prepared: list.new())))
    result.unwrap(store.install_activation(mut db, take staged))
    let tables = view handles.triggers
    let changed = result.unwrap(triggers.transact(code.describe(trigger_law_body)))
    let unchanged = result.unwrap(triggers.transact(code.describe(trigger_scan_law_unchanged)))
    let removed = result.unwrap(triggers.transact(code.describe(trigger_scan_law_removed)))
    let kept_run = result.unwrap(triggers.granted(code.describe(trigger_law_granted_body)))
    let removed_run = result.unwrap(triggers.granted(code.describe(trigger_scan_law_removed_run)))
    let mut new_entries = triggers.empty_entries()
    result.unwrap(triggers.allow(mut new_entries, changed))
    result.unwrap(triggers.allow(mut new_entries, unchanged))
    result.unwrap(triggers.allow(mut new_entries, kept_run))
    let mut old_entries: triggers.Entries = clone(new_entries)
    result.unwrap(triggers.allow(mut old_entries, removed))
    result.unwrap(triggers.allow(mut old_entries, removed_run))
    let written = store.run(mut db, None, (store.copy_env(same_image), store.copy_env(tables), store.copy_env(changed), store.copy_env(unchanged), store.copy_env(removed), store.copy_env(kept_run), store.copy_env(removed_run), store.copy_env(old_entries)), fn(mut tx, call_env) -> Result[(triggers.Id, triggers.Id, triggers.Id, triggers.Id, triggers.Id, Option[triggers.Id]), triggers.Error] {
        let kept = triggers.write(mut tx, call_env.1, call_env.7, call_env.5, 7u64, At(0u64))?
        let lost = triggers.write(mut tx, call_env.1, call_env.7, call_env.6, 0u64, At(1u64))?
        let gone = triggers.write(mut tx, call_env.1, call_env.7, call_env.4, 0u64, At(2u64))?
        let cancel = triggers.write(mut tx, call_env.1, call_env.7, call_env.4, 0u64, At(3u64))?
        let park_cancel = triggers.write(mut tx, call_env.1, call_env.7, call_env.6, 0u64, At(4u64))?
        let _ = triggers.write(mut tx, call_env.1, call_env.7, call_env.2, 1u64, At(5u64))?
        let _ = triggers.write(mut tx, call_env.1, call_env.7, call_env.3, 0u64, At(7u64))?
        let _ = triggers.write(mut tx, call_env.1, call_env.7, call_env.3, 0u64, At(6u64))?
        let staying = if call_env.0 {
            Some(triggers.write(mut tx, call_env.1, call_env.7, call_env.5, 0u64, At(8u64))?)
        } else {
            None
        }
        Ok((kept, lost, gone, cancel, park_cancel, staying))
    })
    let (kept, lost, gone, cancel, park_cancel, staying) = result.unwrap(trigger_commit(take written)).value
    let base = store.snapshot(db)
    let first = option.unwrap(result.unwrap(triggers.next_pending(result.unwrap(store.reader(db, 0u64)), base, tables, fn(id: triggers.Id) -> bool {
        false
    })))
    let second = option.unwrap(result.unwrap(triggers.next_pending(result.unwrap(store.reader(db, 0u64)), base, tables, scoped fn(id: triggers.Id) -> bool {
        id == kept
    })))
    let cancelling_row = option.unwrap(result.unwrap(triggers.next_pending(result.unwrap(store.reader(db, 0u64)), base, tables, scoped fn(id: triggers.Id) -> bool {
        id != park_cancel
    })))
    let parked_row = result.unwrap(triggers.next_pending(result.unwrap(store.reader(db, 0u64)), base, tables, scoped fn(id: triggers.Id) -> bool {
        Some(id) != staying
    }))
    let started = store.run(mut db, None, (store.copy_env(old_binding), store.copy_env(tables), store.copy_env(cancel), store.copy_env(park_cancel), store.copy_env(first), store.copy_env(second), store.copy_env(cancelling_row), store.copy_env(parked_row)), fn(mut tx, call_env) -> Result[(), triggers.Error] {
        let _ = triggers.start(mut tx, call_env.1, call_env.4, call_env.0)?
        let _ = triggers.start(mut tx, call_env.1, call_env.5, call_env.0)?
        let Body(park) = triggers.start(mut tx, call_env.1, call_env.6, call_env.0)? else {
            return Error(StaleAttempt)
        }
        triggers.hold(mut tx, call_env.1, park, 0u64, list.new(), list.new())?
        if let Some(row_to_park) = call_env.7 {
            let Body(hold) = triggers.start(mut tx, call_env.1, row_to_park, call_env.0)? else {
                return Error(StaleAttempt)
            }
            triggers.hold(mut tx, call_env.1, hold, 0u64, list.new(), list.new())?
        }
        triggers.request_cancel(mut tx, call_env.1, call_env.2)?
        triggers.request_cancel(mut tx, call_env.1, call_env.3)
    })
    let _ = result.unwrap(trigger_commit(take started))
    let attempt = trigger_scan_law_bytes(16u64, 4u8)
    let copying = result.unwrap(store.begin_export_copy(mut db, d, clone(attempt), 1u64))
    let exported_store = result.unwrap(store.export_copy(take copying))
    let source = result.unwrap(store.open_export(exported_store.dir, c, attempt, options))
    let setup = PrepareConfig(scratch: exported_store.dir, options: clone(options), attempt: clone(attempt), image_digest: clone(new_digest), clock: c, tasks: tasks, n_place: new_n_place, place: new_place, on_migrate: None, schema: code.describe(trigger_law_schema), triggers: clone(new_entries))
    result.unwrap(prepare_export(setup, source))
    let raw = result.unwrap(std.file.read(exported_store.dir, "TRIGGERS"))
    let codec: std.codec.Codec[List[TriggerScanRow]] = std.codec.of_list()
    let rows = result.unwrap(std.codec.decode(codec, raw))
    if list.len(rows) != (if same_image {
        8u64
    } else {
        7u64
    }) {
        fail("L40: wrong number of report rows")
    }
    let schema = result.unwrap(std.codec.schema(std.codec.of_u64()))
    let mut seen = 0u64
    for row in rows {
        let (path, granted_kind, count, expected_class): (String, bool, u64, TriggerScanClass) = match row.earliest_due {
            0u64 => ("trigger_law_granted_body", true, 1u64, if same_image {
                Unchanged
            } else {
                Held
            }),
            1u64 => ("trigger_scan_law_removed_run", true, 1u64, if same_image {
                Gone
            } else {
                Held
            }),
            2u64 => ("trigger_scan_law_removed", false, 1u64, Gone),
            3u64 => ("trigger_scan_law_removed", false, 1u64, Cancelling),
            4u64 => ("trigger_scan_law_removed_run", true, 1u64, Cancelling),
            5u64 => ("trigger_law_body", false, 1u64, if same_image {
                Unchanged
            } else {
                Changed
            }),
            6u64 => ("trigger_scan_law_unchanged", false, 2u64, Unchanged),
            8u64 => if same_image {
                ("trigger_law_granted_body", true, 1u64, Held)
            } else {
                fail("L40: unexpected parked run")
            },
            _ => fail("L40: wrong earliest due time"),
        }
        let mut qualified: String = clone("runner@1/runner/")
        string.push(mut qualified, path)
        let expected_kind: Kind = if granted_kind {
            Granted
        } else {
            Transact
        }
        let bit = 1u64 << int.narrow(row.earliest_due)
        if row.path != string.as_bytes(qualified) {
            fail("L40: wrong entry path")
        }
        if row.schema != schema || row.kind != expected_kind {
            fail("L40: wrong argument schema or kind")
        }
        if row.count != count || (seen & bit) != 0u64 {
            fail("L40: wrong count or duplicate row")
        }
        if row.class != expected_class {
            fail("L40: wrong trigger class")
        }
        seen |= bit
    }
    store.release_export(mut db, attempt)
    let (to, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let (take running, take published) = trigger_law_initial(take db, c, tasks, take to, take new_entries)
    let mut head = take running
    head.r = result.unwrap(placed(new_place, new_n_place))
    let mut drive = option.unwrap(replace(mut head.trigger_drive, None))
    let new_binding = result.unwrap(trigger_stamp(head.r.exported, head.r.bindings, new_n_place))
    drive.revision = clone(new_binding)
    head.trigger_drive = Some(take drive)
    for i in 0u64 .. 8u64 {
        if !result.unwrap(advance_triggers(mut head)) {
            fail("L40: due trigger did not advance")
        }
    }
    let snapshot = store.snapshot(head.db)
    if let Some(Gone) = trigger_law_outcome(head, gone) {} else {
        fail("L40: removed transact trigger did not end Gone")
    }
    if let Some(Cancelled) = trigger_law_outcome(head, cancel) {} else {
        fail("L40: cancel did not settle")
    }
    if let Some(Cancelled) = trigger_law_outcome(head, park_cancel) {} else {
        fail("L40: parked cancel did not settle")
    }
    if let Some(parked_id) = staying {
        if let Some(Gone) = trigger_law_outcome(head, lost) {} else {
            fail("L40: same-image retry of removed entry did not end Gone")
        }
        if let Some(Request(1u64, 0u64, _, _)) = result.unwrap(triggers.hold_mark(result.unwrap(store.reader(head.db, 0u64)), snapshot, tables, parked_id)) {} else {
            fail("L40: same-image Request hold changed")
        }
        for i in 0u64 .. 2u64 {
            let TriggerMessage(take message) = result.unwrap(channel.receive(inbox)) else {
                fail("L40: retry did not reach its trigger call")
            }
            result.unwrap(trigger_message(mut head, take message, false))
        }
        let TriggerDone(retried, take verdict) = result.unwrap(channel.receive(inbox)) else {
            fail("L40: retry did not finish")
        }
        if triggers.run_id(retried) != kept || triggers.number(retried) != 2u64 {
            fail("L40: wrong retry attempt")
        }
        result.unwrap(trigger_done(mut head, retried, take verdict, false))
        if let Some(Returned(_)) = trigger_law_outcome(head, kept) {} else {
            fail("L40: retry did not return")
        }
    } else {
        for id in[kept, lost] {
            match result.unwrap(triggers.hold_mark(result.unwrap(store.reader(head.db, 0u64)), snapshot, tables, id)) {
                Some(Revision(before, after)) => if before != old_binding || after != new_binding {
                    fail("L40: wrong release identities in hold")
                },
                _ => fail("L40: changed image did not park the run"),
            }
        }
    }
    let Head(db: take done, trigger_drive: take active, ..) = take head
    stop_triggers(option.unwrap(take active))
    result.unwrap(store.close(take done))
    Ok(())
}

fn trigger_scan_law_last(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    use_trigger_tables(mut reg, fn(h: TriggerLawTables) -> triggers.Tables {
        clone(h.triggers)
    })
    transact(mut reg, code.describe(trigger_scan_law_removed), 131072u64, DEFAULT_STEPS)
}

fn trigger_scan_law_empty(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    use_trigger_tables(mut reg, fn(h: TriggerLawTables) -> triggers.Tables {
        clone(h.triggers)
    })
    Ok(())
}

fn trigger_scan_law_install(mut db: store.Db, n_place: u64, place: StaticFn[fn(mut Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError]]) -> u64 waits {
    let reg = result.unwrap(placed(place, n_place))
    let (take description, take record) = result.unwrap(prepare_activation(reg, n_place, list.new()))
    let mut declaration = result.unwrap(store.declare(db, Migrate))
    let _ = result.unwrap(trigger_law_schema(mut declaration))
    let mut pending_install = result.unwrap(store.finish_migration(db, take declaration))
    let version = store.version(store.snapshot(db)) + 1u64
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    result.unwrap(store.stage_activation(mut pending_install, version, result.unwrap(current_description(db)), description, release_codec, record))
    result.unwrap(store.install_activation(mut db, take pending_install))
    version
}

fn trigger_scan_last_entry(d: Dir, c: Clock, r: Random, tasks: Tasks, options: store.Options, explicit_empty: bool) -> Result[(), ()] waits {
    let dir = triggers.law_directory(d)
    let n_place = 1048576u64
    let mut db = result.unwrap(store.open(tasks, dir, c, r, options))
    let _ = trigger_scan_law_install(mut db, n_place, code.describe(trigger_scan_law_last))
    let tables = trigger_law_tables(mut db)
    let target = result.unwrap(triggers.transact(code.describe(trigger_scan_law_removed)))
    let mut listed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut listed, target))
    let due = host.wall_ms(c) + 100u64
    let written = store.run(mut db, None, (store.copy_env(tables), store.copy_env(target), store.copy_env(listed), store.copy_env(due)), fn(mut tx, call_env) -> Result[triggers.Id, triggers.Error] {
        triggers.write(mut tx, call_env.0, call_env.2, call_env.1, 0u64, At(call_env.3))
    })
    let id = result.unwrap(trigger_commit(take written)).value
    let attempt = trigger_scan_law_bytes(16u64, 9u8)
    let digest = trigger_scan_law_bytes(32u64, 2u8)
    let copying = result.unwrap(store.begin_export_copy(mut db, d, clone(attempt), 1u64))
    let exported_store = result.unwrap(store.export_copy(take copying))
    let source = result.unwrap(store.open_export(exported_store.dir, c, attempt, options))
    let setup = PrepareConfig(scratch: exported_store.dir, options: clone(options), attempt: clone(attempt), image_digest: clone(digest), clock: c, tasks: tasks, n_place: n_place, place: code.describe(trigger_scan_law_empty), on_migrate: None, schema: code.describe(trigger_law_schema), triggers: triggers.empty_entries())
    result.unwrap(prepare_export(setup, source))
    let raw = result.unwrap(std.file.read(exported_store.dir, "TRIGGERS"))
    let codec: std.codec.Codec[List[TriggerScanRow]] = std.codec.of_list()
    let rows = result.unwrap(std.codec.decode(codec, raw))
    if list.len(rows) != 1u64 || rows[0u64].class != Gone || rows[0u64].count != 1u64 || rows[0u64].earliest_due != due {
        fail("L40: final entry did not scan as Gone")
    }
    // The import accepts only the preview's exact Describe (launch.md "Hot
    // deploy"), whose tables come from describe mode's Migrate run of `schema`.
    let launch = launch_env()
    let Registry(exported: take shown, bindings: take shown_bindings, ..) = result.unwrap(placed(code.describe(trigger_scan_law_empty), n_place))
    let shown_release = result.unwrap(http_release_digest(shown, shown_bindings))
    let shown_tables = result.unwrap(store.describe_declarations(c, code.describe(trigger_law_schema)))
    if list.len(shown_tables) == 0u64 {
        fail("L40: the law schema declares no table")
    }
    let preview = Describe(digest: launch_bytes(launch.digest), target: owned_launch_target(launch.target), n_place: n_place, revision: launch_bytes(launch.revision), exported: take shown, tables: take shown_tables, bindings: take shown_bindings)
    let prepared = result.unwrap(store.validate_prepared(exported_store.dir))
    if !store.prepared_matches(prepared, result.unwrap(encode_describe(preview)), shown_release, launch_bytes(launch.digest)) {
        fail("L40: PREPARED's Describe is not the preview's")
    }
    store.release_export(mut db, attempt)
    let selection = Current(trigger_scan_law_install(mut db, n_place, code.describe(trigger_scan_law_empty)))
    result.unwrap(store.close(take db))
    let (to, events): (Sender[LifeEvent], Receiver[LifeEvent]) = channel.new(12u64)
    let (head_to, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(8u64)
    let (finish_to, finish_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let initial_window: Option[DrainWindow] = None
    let drain = latest.new(arc.new(initial_window))
    let triggering = if explicit_empty {
        Some(trigger_law_config(triggers.empty_entries()))
    } else {
        None
    }
    let granting: Option[GrantStart[TriggerContext, TriggerLawTables, ()]] = None
    let job = ManagedHead(backing: Disk(dir), options: clone(options), follower_plan: None, selection: selection, tasks: tasks, clock: c, random: r, place: code.describe(trigger_scan_law_empty), on_migrate: None, schema: code.describe(trigger_law_schema), n_place: n_place, n_publisher: 1048576u64, inbox: take inbox, finish_from: take finish_from, to: take to, drain: take drain, head_to: channel.sender(head_to), cut: result.unwrap(cut_activity()), triggering: take triggering, granting: take granting, idle: None, expected_store: None)
    let writer = store.writer_bytes(result.unwrap(store.writer_plan(Directory, options)))
    let allowance = writer + job.n_place + job.n_publisher
    let server = task.spawn(tasks, bytes allowance, take job, head_ended)
    if let Ok(Recovered) = channel.receive(events) {} else {
        fail("L40: serving head did not recover")
    }
    result.unwrap(channel.send(head_to, HeadContinue))
    if let Ok(Activated(_, _, _, _, _)) = channel.receive(events) {} else {
        fail("L40: serving head did not activate")
    }
    result.unwrap(channel.send(head_to, HeadContinue))
    if let Ok(Published(_)) = channel.receive(events) {} else {
        fail("L40: serving head did not publish")
    }
    host.sleep_until_wall(c, due)
    result.unwrap(channel.send(head_to, HeadContinue))
    // The serving loop dispatches due rows before it receives HeadClose.
    result.unwrap(channel.send(head_to, HeadClose))
    if let Ok(Settled) = channel.receive(events) {} else {
        fail("L40: serving head did not settle")
    }
    result.unwrap(channel.send(head_to, HeadFinish))
    if let Ok(HeadEnded(Ok(None))) = channel.receive(events) {} else {
        fail("L40: serving head did not close")
    }
    result.unwrap(task.join(take server))
    let reopened = result.unwrap(store.open(tasks, dir, c, r, options))
    let outcome = result.unwrap(triggers.outcome(result.unwrap(store.reader(reopened, 0u64)), store.snapshot(reopened), tables, id))
    result.unwrap(store.close(take reopened))
    if let Some(Gone) = outcome {
        Ok(())
    } else {
        fail("L40: Gone did not survive reopen")
    }
}

// ENDSTATE steps law 7. A committed request reaches the waiting body at its
// boundary. Its ordinary return cannot replace the Cancelled terminal outcome.
pub fn journal_law_trigger_cancel(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = triggers.law_directory(d)
    let mut db = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    let handles = result.unwrap(store.bind_declaration(mut db, Migrate, trigger_law_schema))
    let tables = view handles.triggers
    let target: triggers.Entry[u64] = result.unwrap(triggers.granted(code.describe(trigger_law_granted_body)))
    let mut allowed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut allowed, target))
    let queued = store.run(mut db, None, (store.copy_env(tables), store.copy_env(target), store.copy_env(allowed)), fn(mut tx, call_env) -> Result[(triggers.Id, triggers.Id), triggers.Error] {
        let live = triggers.write(mut tx, call_env.0, call_env.2, call_env.1, 7u64, AfterCommit)?
        let held = triggers.write(mut tx, call_env.0, call_env.2, call_env.1, 5u64, AfterCommit)?
        Ok((live, held))
    })
    let writing = result.unwrap(trigger_commit(take queued))
    let (live, held) = writing.value
    result.unwrap(store.durable(mut db, writing.ticket))
    let (to, inbox): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(4u64)
    let (take built, take published) = trigger_law_initial(take db, c, tasks, take to, take allowed)
    let mut head = take built
    if !result.unwrap(advance_triggers(mut head)) {
        return false
    }
    let cancellation = store.run(mut head.db, None, (store.copy_env(tables), store.copy_env(live)), fn(mut tx, call_env) -> Result[(), triggers.Error] {
        triggers.request_cancel(mut tx, call_env.0, call_env.1)
    })
    let requested = result.unwrap(trigger_commit(take cancellation))
    result.unwrap(store.durable(mut head.db, requested.ticket))
    let boundary = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take check) = take boundary else {
        return false
    }
    result.unwrap(trigger_message(mut head, take check, false))
    let inbound = result.unwrap(channel.receive(inbox))
    let TriggerDone(a, take response) = take inbound else {
        return false
    }
    result.unwrap(trigger_done(mut head, a, take response, false))
    if let Some(Cancelled) = trigger_law_outcome(head, live) {} else {
        return false
    }
    if trigger_law_value(head) != None || !result.unwrap(advance_triggers(mut head)) {
        return false
    }
    let step_check = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take step_request) = take step_check else {
        return false
    }
    result.unwrap(trigger_message(mut head, take step_request, false))
    let holding = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take hold_request) = take holding else {
        return false
    }
    result.unwrap(trigger_message(mut head, take hold_request, false))
    let held_done = result.unwrap(channel.receive(inbox))
    let TriggerDone(held_attempt, take held_response) = take held_done else {
        return false
    }
    result.unwrap(trigger_done(mut head, held_attempt, take held_response, false))
    if let Some(_) = trigger_law_outcome(head, held) {
        return false
    }
    if result.unwrap(advance_triggers(mut head)) {
        return false
    }
    let cancel_held = store.run(mut head.db, None, (store.copy_env(tables), store.copy_env(held)), fn(mut tx, call_env) -> Result[(), triggers.Error] {
        triggers.request_cancel(mut tx, call_env.0, call_env.1)
    })
    let marked = result.unwrap(trigger_commit(take cancel_held))
    result.unwrap(store.durable(mut head.db, marked.ticket))
    if !result.unwrap(advance_triggers(mut head)) {
        return false
    }
    if let Some(Cancelled) = trigger_law_outcome(head, held) {} else {
        return false
    }
    if result.unwrap(advance_triggers(mut head)) {
        return false
    }
    let Head(db: take kept, ..) = take head
    result.unwrap(store.close(take kept))
    true
}

@test
fn journal_test_trigger_cancel(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_trigger_cancel(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

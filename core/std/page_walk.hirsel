// A sorted walk over a resident page tree (STORE-SPEC AP3) that can take a
// complete remaining subtree at once. It reads pages through std.page only.
type WalkFrame: send {
    page: Arc[page.Page],
    slot: u64,
    whole: bool
}

pub opaque type Walk: send {
    path: List[WalkFrame]
}

pub type Subtree {
    stamp: u64,
    level: u8
}

fn kid(frame: WalkFrame, slot: u64) -> Arc[page.Page] {
    option.unwrap(page.child(frame.page, slot))
}

pub fn begin(root: Arc[page.Page]) -> Walk {
    let mut path: List[WalkFrame] = list.new()
    if page.count(page.image_of(root)) != 0 {
        list.push(mut path, WalkFrame(page: arc.share(root), slot: 0, whole: true))
    }
    Walk(path: take path)
}

/// Seek to the inclusive lower bound, retaining whole subtrees after the seek path.
pub fn seek(root: Arc[page.Page], low: Bytes) -> Walk {
    let mut walk = empty()
    if page.count(page.image_of(root)) == 0 {
        return take walk
    }
    let mut current = arc.share(root)
    let mut whole = 0u64
    while page.level(page.image_of(current)) != 0 {
        let slot = option.unwrap(page.descend(page.image_of(current), low))
        let child = option.unwrap(page.child(current, slot))
        list.push(mut walk.path, WalkFrame(page: take current, slot: slot + 1, whole: false))
        if slot != 0 {
            whole = list.len(walk.path)
        }
        current = take child
    }
    let (slot, exhausted) = {
        let image = page.image_of(current)
        let (at, _) = page.search(image, low)
        (at, at == page.count(image))
    }
    list.push(mut walk.path, WalkFrame(page: take current, slot, whole: slot == 0))
    if exhausted {
        next(mut walk)
    } else if slot == 0 {
        // Every edge below this frame leads to a leftmost child.
        while list.len(walk.path) > whole + 1 {
            let _ = list.pop(mut walk.path)
        }
        walk.path[whole].whole = true
        walk.path[whole].slot = 0
    }
    take walk
}

/// The child named by a collection-map row.
pub fn collection(walk: Walk) -> Arc[page.Page] {
    let top = option.unwrap(list.last(walk.path))
    kid(top, top.slot)
}

pub fn empty() -> Walk {
    Walk(path: list.new())
}

pub fn key(walk: Walk) -> Option[Bytes] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        return Some(page.extreme_key(top.page, false))
    }
    page.key_at(page.image_of(top.page), top.slot)
}

// Separators bound a subtree from below and can precede its actual first key.
fn diff_key(walk: Walk) -> Option[Bytes] {
    let n = list.len(walk.path)
    if n == 0 || !walk.path[n - 1].whole {
        return key(walk)
    }
    let mut at = n - 1
    while at != 0 {
        at -= 1
        let parent = view walk.path[at]
        if parent.slot > 1 {
            return page.key_at(page.image_of(parent.page), parent.slot - 1)
        }
    }
    Some(b"")
}

fn diff_leaf_slot(walk: Walk) -> bool {
    if let Some(top) = list.last(walk.path) {
        return !top.whole && page.key_domain(page.image_of(top.page)) != CollectionMap
    }
    false
}

fn skip_equal_leaf_rows(mut left: Walk, mut right: Walk) -> Option[Order] {
    let a = list.len(left.path) - 1
    let b = list.len(right.path) - 1
    let (i, j, comparison) = page.diff_leaves(left.path[a].page, left.path[a].slot, right.path[b].page, right.path[b].slot)
    left.path[a].slot = i
    right.path[b].slot = j
    if comparison == None {
        if i == page.count(page.image_of(left.path[a].page)) {
            next(mut left)
        }
        if j == page.count(page.image_of(right.path[b].page)) {
            next(mut right)
        }
    }
    comparison
}

/// Position at the next row difference below the exclusive upper bound.
/// Collection-map rows are returned in key order for the caller to compare.
/// Advance the left walk for Less, the right for Greater, or both for Equal.
pub fn diff_position(mut left: Walk, mut right: Walk, high: Option[Bytes]) -> Option[(Bytes, Order)] {
    loop {
        let old_span = subtree(left)
        let new_span = subtree(right)
        if let (Some(a), Some(b)) = (old_span, new_span) {
            if a.level == b.level && a.stamp == b.stamp {
                next(mut left)
                next(mut right)
                continue
            }
        }
        if diff_leaf_slot(left) && diff_leaf_slot(right) {
            let Some(comparison) = skip_equal_leaf_rows(mut left, mut right) else {
                continue
            }
            let changed = if comparison == Greater {
                option.unwrap(key(right))
            } else {
                option.unwrap(key(left))
            }
            if let Some(end) = high {
                if changed >= end {
                    return None
                }
            }
            return Some((take changed, comparison))
        }
        let old_key = diff_key(left)
        let new_key = diff_key(right)
        let comparison = match (view old_key, view new_key) {
            (None, None) => return None,
            (None, Some(_)) => Greater,
            (Some(_), None) => Less,
            (Some(a), Some(b)) => list.compare_bytes(a, b),
        }
        let candidate = if comparison == Greater {
            option.unwrap(take new_key)
        } else {
            option.unwrap(take old_key)
        }
        if let Some(end) = high {
            if candidate >= end {
                return None
            }
        }
        if comparison == Equal {
            if let (Some(a), Some(b)) = (old_span, new_span) {
                if a.level >= b.level {
                    expand(mut left)
                } else {
                    expand(mut right)
                }
                continue
            }
        }
        if comparison != Greater {
            if let Some(_) = old_span {
                expand(mut left)
                continue
            }
        }
        if comparison != Less {
            if let Some(_) = new_span {
                expand(mut right)
                continue
            }
        }
        return Some((take candidate, comparison))
    }
}

pub fn subtree(walk: Walk) -> Option[Subtree] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if !top.whole {
        return None
    }
    let image = page.image_of(top.page)
    Some(Subtree(stamp: page.stamp(image), level: page.level(image)))
}

pub fn subtree_high(walk: Walk) -> Option[Bytes] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        Some(page.extreme_key(top.page, true))
    } else {
        None
    }
}

pub fn subtree_charge(walk: Walk) -> u64 {
    let Some(top) = list.last(walk.path) else {
        return 0
    }
    let (_, charge) = page.totals(top.page)
    charge
}

pub fn value(walk: Walk) -> Option[View[Bytes]] in walk {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        None
    } else {
        page.value_at(top.page, top.slot)
    }
}

pub fn blob_stamp(walk: Walk) -> u64 {
    let Some(top) = list.last(walk.path) else {
        return 0
    }
    if top.whole {
        return 0
    }
    if let Some(BlobEdge(edge)) = page.owning_edge(page.image_of(top.page), top.slot) {
        edge.stamp
    } else {
        0
    }
}

pub fn owned_value(walk: Walk) -> Option[Arc[Bytes]] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        return None
    }
    if let Some(BlobEdge(edge)) = page.owning_edge(page.image_of(top.page), top.slot) {
        return page.body(top.page, edge.body)
    }
    let Some(held) = page.value_at(top.page, top.slot) else {
        return None
    }
    let owned: Bytes = clone(held)
    Some(arc.new(take owned))
}

pub fn expand(mut walk: Walk) {
    let n = list.len(walk.path)
    if n == 0 {
        return
    }
    let top = n - 1
    walk.path[top].whole = false
    if page.level(page.image_of(walk.path[top].page)) != 0 {
        let first = kid(walk.path[top], 0)
        walk.path[top].slot = 1
        list.push(mut walk.path, WalkFrame(page: take first, slot: 0, whole: true))
    }
}

pub fn next(mut walk: Walk) {
    let n = list.len(walk.path)
    if n == 0 {
        return
    }
    let top = n - 1
    if !walk.path[top].whole {
        walk.path[top].slot += 1
        if walk.path[top].slot < page.count(page.image_of(walk.path[top].page)) {
            return
        }
    }
    let _ = list.pop(mut walk.path)
    while list.len(walk.path) != 0 {
        let parent = list.len(walk.path) - 1
        let slot = walk.path[parent].slot
        if slot < page.count(page.image_of(walk.path[parent].page)) {
            let descendant = kid(walk.path[parent], slot)
            walk.path[parent].slot += 1
            list.push(mut walk.path, WalkFrame(page: take descendant, slot: 0, whole: true))
            return ()
        }
        let _ = list.pop(mut walk.path)
    }
}

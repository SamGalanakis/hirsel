// OWN-8/OWN-10, the spec's pair: a let-bound view of `m.items` lasts to the block end, so lending `m.items` mut in that block is refused at the loan; ending the view in an inner block first is accepted.
// expect: refuse OWN-10 at 14:14



type Inbox { items: List[String] }
fn ok(mut m: Inbox) -> u64 {
  let n = { let items = view m.items; list.len(items) }
  list.clear(mut m.items)
  n
}
fn bad(mut m: Inbox) {
  let items = view m.items
  list.clear(mut m.items)
}

type SweepItem {
    id: u64,
    key: u64
}

// A changed permutation adds a failure to the comparator's cause chain.
resource type SweepAudit {
    values: List[SweepItem],
    count: u64
} drop(t) {
    let mut valid = list.len(t.values) == t.count
    let mut low: u64 = 0
    let mut high: u64 = 0
    for x in t.values {
        if x.id >= t.count || x.key != merge_key(t.count, x.id) {
            valid = false
        } else {
            let bit = 1u64 << (x.id % 64)
            let seen = if x.id < 64 {
                low
            } else {
                high
            }
            if (seen & bit) != 0 {
                valid = false
            }
            if x.id < 64 {
                low |= bit
            } else {
                high |= bit
            }
        }
    }
    let want_high = if t.count > 64 {
        (1u64 << (t.count - 64)) - 1
    } else {
        0
    }
    let want_low = if t.count >= 64 {
        int.wrapping_sub(0u64, 1)
    } else {
        (1u64 << t.count) - 1
    }
    if !valid || low != want_low || high != want_high {
        fail("sort changed its input permutation")
    }
}

fn sweep_fail_at(count: u64, failure: u64) -> bool {
    let mut xs: List[SweepItem] = list.new()
    for i in 0u64 .. count {
        result.unwrap(list.push(mut xs, SweepItem(id: i, key: merge_key(count, i))))
    }
    let mut audit = result.unwrap(SweepAudit(values: take xs, count: count))
    let mut calls: u64 = 0
    result.unwrap(list.sort_stable(mut audit.values, fn(a: SweepItem, b: SweepItem) -> Order {
        calls += 1
        if calls == failure {
            let none: Option[u64] = None;
            let _ = option.unwrap(none)
        }
        if a.key < b.key {
            Less
        } else if a.key > b.key {
            Greater
        } else {
            Equal
        }
    }))
    let mut sorted = true
    for i in 1u64 .. count {
        let (ak, ai) = (audit.values[i - 1].key, audit.values[i - 1].id)
        let (bk, bi) = (audit.values[i].key, audit.values[i].id)
        if ak > bk || (ak == bk && ai > bi) {
            sorted = false
        }
    }
    sorted
}

// Fails the comparator at call 1, 2, ... until a sort completes; each failure's
// audit checks the list. A caught chain must contain only the injected Unwrap.
// Returns the completed sort's call count, or 0 on a failed check.
fn sweep(count: u64) -> u64 {
    let mut failed: u64 = 0
    loop {
        if failed == 1000 {
            return 0
        }
        let f = failed + 1
        match result.unwrap(isolate(fn() -> bool {
            sweep_fail_at(count, f)
        })) {
            Ok(sorted) => {
                return if sorted {
                    failed
                } else {
                    0
                }
            }
            Error(take causes) => {
                let mut seen = false
                for cause in causes {
                    if seen {
                        return 0
                    }
                    match cause.kind {
                        Unwrap => {
                            seen = true
                        },
                        _ => return 0,
                    }
                }
                if !seen {
                    return 0
                }
                failed += 1
            }
        }
    }
}

// expect: run sweep_37() = 128
fn sweep_37() -> u64 {
    sweep(37)
}

// expect: run sweep_44() = 251
fn sweep_44() -> u64 {
    sweep(44)
}

// expect: run sweep_88() = 282
fn sweep_88() -> u64 {
    sweep(88)
}

// expect: run sweep_104() = 583
fn sweep_104() -> u64 {
    sweep(104)
}

// Host-free per-call twins: the evaluator checks scratch and source live slots
// on failure, one failure per law. Call ranges from the replay model.
// 37: sort4_stable on calls 22-31.
// expect: run small_plain_37_22() = fail Unwrap
fn small_plain_37_22() -> bool {
    merge_plain_fail_at(37, 22)
}

// expect: run small_plain_37_31() = fail Unwrap
fn small_plain_37_31() -> bool {
    merge_plain_fail_at(37, 31)
}


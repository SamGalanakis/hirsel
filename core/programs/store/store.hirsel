// L2: an aborted body needs no COMMIT allocation. Encoding after Error turns
// this abort into Refused at the 80-byte Log/Log/isolate admission boundary.
pub fn law_abort_budget(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    let values: Inline[u64, 2] =[7, 19]
    for i in 0u64 .. 2 {
        let value = values[i]
        let outcome = result.unwrap(bound bytes 80 {
            execute(mut db, 1, fn(mut tx: Tx) -> Result[(), u64] {
                let _ = info(mut tx)
                Error(value)
            })
        })
        match take outcome {
            Ok(Aborted(Undone(value: actual, ticket: None))) => if actual != value {
                return false
            },
            _ => return false
        }
    }
    db.head == 0 && db.resident == 0
}

@test
fn test_abort_budget(c: Clock) -> Result[(), ()] {
    if law_abort_budget(c) {
        Ok(())
    } else {
        Error(())
    }
}

pub type Looked[R] = Seen(Seen[R]) | Failed(Causes) | Refused(Capacity)

pub type Seen[R] {
    value: R,
    version: u64,
    reads: List[Read]
}

pub fn look[R](s: Snapshot, body: scoped[view] fn(Tx) -> R) -> Result[Looked[R], Error] {
    let read_log: Result[Log[Read], Capacity] = log.new()
    let reads = match take read_log {
        Ok(take x) => take x,
        Error(c) => return Ok(Refused(c))
    }
    let issue_log: Result[Log[u64], Capacity] = log.new()
    let issued = match take issue_log {
        Ok(take x) => take x,
        Error(c) => return Ok(Refused(c))
    }
    let caught = isolate(fn() -> R {
        let tx = Tx(store: s.store, roots: share_roots(s.roots), ids: 0, resident: 0, retain_old: false, reads: view reads, issued: view issued, refusal: None, frame_bytes: 42, wrote: false, ops: std.omap.new(), op_ids: 0, info: CallInfo(id: CallId(store: s.store, branch: s.branch, version: s.head), at: 0, seed: 0))
        body(tx)
    })
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Ok(Refused(c)),
        Ok(Error(take cs)) => Ok(Failed(take cs)),
        Ok(Ok(take value)) => Ok(Seen(Seen(value: take value, version: s.head, reads: take seen)))
    }
}

pub type Change {
    tree_key: Bytes,
    value: Option[Bytes]
}

type DiffPart {
    node: Arc[std.omap.Node[Bytes, Arc[Bytes]]],
    at: u64
}

fn diff_top(parts: List[DiffPart]) -> DiffPart {
    let p = parts[list.len(parts) - 1]
    DiffPart(node: arc.share(p.node), at: p.at)
}

fn diff_expand(mut parts: List[DiffPart], p: DiffPart) -> Result[(), Error] {
    let _ = list.pop(mut parts)
    let mut i = std.omap.node_count(p.node)
    while i > 0 {
        i -= 1
        let child = option.unwrap(std.omap.node_child(p.node, i))
        capacity(result.capacity_only(list.push(mut parts, DiffPart(node: take child, at: 0))))?
    }
    Ok(())
}

fn diff_advance(mut parts: List[DiffPart], p: DiffPart) {
    if p.at + 1 == std.omap.node_count(p.node) {
        let _ = list.pop(mut parts)
    } else {
        let i = list.len(parts) - 1
        parts[i].at += 1
    }
}

fn diff_emit(mut out: List[Change], p: DiffPart, present: bool) -> Result[(), Error] {
    let k = option.unwrap(std.omap.node_key(p.node, p.at))
    let value = if present {
        let source = option.unwrap(std.omap.node_value(p.node, p.at))
        Some(copied(source)?)
    } else {
        None
    }
    capacity(result.capacity_only(list.push(mut out, Change(tree_key: copied(k)?, value: take value))))
}

pub fn changes(a: Snapshot, b: Snapshot) -> Result[List[Change], Error] {
    if !same(a.store, b.store) || a.open != b.open {
        return Error(Foreign)
    }
    let left_root = std.omap.root(a.roots.data)
    let right_root = std.omap.root(b.roots.data)
    if let Some(x) = left_root {
        if let Some(y) = right_root {
            if std.omap.node_id(x) == std.omap.node_id(y) {
                return Ok(list.new())
            }
        }
    } else if let None = right_root {
        return Ok(list.new())
    }
    let mut left: List[DiffPart] = list.new()
    let mut right: List[DiffPart] = list.new()
    if let Some(take n) = take left_root {
        capacity(result.capacity_only(list.push(mut left, DiffPart(node: take n, at: 0))))?
    }
    if let Some(take n) = take right_root {
        capacity(result.capacity_only(list.push(mut right, DiffPart(node: take n, at: 0))))?
    }
    let mut out: List[Change] = list.new()
    while list.len(left) > 0 || list.len(right) > 0 {
        if list.len(left) == 0 {
            let y = diff_top(right)
            if std.omap.node_level(y.node) > 0 {
                diff_expand(mut right, y)?
            } else {
                diff_emit(mut out, y, true)?
                diff_advance(mut right, y)
            }
        } else if list.len(right) == 0 {
            let x = diff_top(left)
            if std.omap.node_level(x.node) > 0 {
                diff_expand(mut left, x)?
            } else {
                diff_emit(mut out, x, false)?
                diff_advance(mut left, x)
            }
        } else {
            let x = diff_top(left)
            let y = diff_top(right)
            if x.at == y.at && std.omap.node_id(x.node) == std.omap.node_id(y.node) {
                let _ = list.pop(mut left)
                let _ = list.pop(mut right)
            } else {
                let kx = option.unwrap(std.omap.node_key(x.node, x.at))
                let ky = option.unwrap(std.omap.node_key(y.node, y.at))
                if std.omap.node_level(x.node) > 0 && kx <= ky {
                    diff_expand(mut left, x)?
                } else if std.omap.node_level(y.node) > 0 && ky <= kx {
                    diff_expand(mut right, y)?
                } else if kx < ky {
                    diff_emit(mut out, x, false)?
                    diff_advance(mut left, x)
                } else if ky < kx {
                    diff_emit(mut out, y, true)?
                    diff_advance(mut right, y)
                } else {
                    let vx = option.unwrap(std.omap.node_value(x.node, x.at))
                    let vy = option.unwrap(std.omap.node_value(y.node, y.at))
                    if vx != vy {
                        diff_emit(mut out, y, true)?
                    }
                    diff_advance(mut left, x)
                    diff_advance(mut right, y)
                }
            }
        }
    }
    Ok(take out)
}

fn look_query(tx: Tx, sh: Shape[u64, u64], ix: Index[u64, u64, u64]) -> Result[u64, Error] {
    let a = option.unwrap(fetch(tx, sh, 1)?)
    let absent = fetch(tx, sh, 9)?
    if let Some(_) = absent {
        return Error(OutOfScope)
    }
    let mut rows = range(tx, sh, Excluded(1), Included(3))?
    let mut sum = a
    while let Some((_, v)) = next(mut rows)? {
        sum += v
    }
    let mut matches = lookup(tx, ix, Included(2), Included(2))?
    while let Some((_, v)) = next_indexed(mut matches)? {
        sum += v
    }
    Ok(sum)
}

fn equal_reads(a: List[Read], b: List[Read]) -> bool {
    if list.len(a) != list.len(b) {
        return false
    }
    for i in 0u64 .. list.len(a) {
        let equal = match (a[i], b[i]) {
            (Point(k), Point(j)) => k == j,
            (Span(l, h), Span(low, high)) => l == low && h == high,
            _ => false
        }
        if !equal {
            return false
        }
    }
    true
}

// L22: 10 + (20+30) + (10+30) = 100; two points and two spans.
// Wrong implementations: look publishes, omits reads or reports another version.
pub fn law_look(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "look", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "look", std.codec.key_u64(), std.codec.of_u64()))
    for k in 1u64 .. 4 {
        if !typed_put(mut db, t, k, k * 10) {
            return false
        }
    }
    result.unwrap(create_index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let ix = result.unwrap(index(db, mut t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let sh = shape(t)
    let s = snapshot(db)
    let head = db.head
    let live = db.resident
    let high_water = db.next_node
    let end = db.file_end
    let observed = result.unwrap(look(s, fn(tx: Tx) -> Result[u64, Error] {
        look_query(tx, sh, ix)
    }))
    let got = match take observed {
        Seen(take x) => take x,
        _ => return false
    }
    match got.value {
        Ok(100) => {},
        _ => return false
    }
    if got.version != head || list.len(got.reads) != 6 || db.head != head || db.resident != live || db.next_node != high_water || db.file_end != end {
        return false
    }
    let p1 = match got.reads[0] {
        Point(k) => k == result.unwrap(physical(t.id, key_word(1))),
        _ => false
    }
    let p2 = match got.reads[1] {
        Point(k) => k == result.unwrap(physical(t.id, key_word(9))),
        _ => false
    }
    // [table1 || key1 || 00, table1 || key3 || 00) includes precisely 2 and 3.
    let mut low = result.unwrap(physical(t.id, key_word(1)))
    result.unwrap(list.push(mut low, 0u8))
    let mut high = result.unwrap(physical(t.id, key_word(3)))
    result.unwrap(list.push(mut high, 0u8))
    let span = match got.reads[2] {
        Span(l, h) => l == low && h == high,
        _ => false
    }
    let ix_low = result.unwrap(physical(ix.id, key_word(2)))
    let ix_high = result.unwrap(physical(ix.id, key_word(3)))
    let index_span = match got.reads[3] {
        Span(l, h) => l == ix_low && h == ix_high,
        _ => false
    }
    if !p1 || !p2 || !span || !index_span {
        return false
    }
    let run_result = run(mut db, fn(mut tx: Tx) -> Result[u64, Error] {
        look_query(tx, sh, ix)
    })
    match take run_result {
        Ok(Committed(done)) => if done.value != 100 || !equal_reads(done.reads, got.reads) {
            return false
        },
        _ => return false
    }
    if !typed_put(mut db, t, 1, 14) {
        return false
    }
    let second = result.unwrap(look(snapshot(db), fn(tx: Tx) -> Result[u64, Error] {
        look_query(tx, sh, ix)
    }))
    match take second {
        Seen(value) => match value.value {
            Ok(108) => value.version == db.head && list.len(value.reads) == 6,
            _ => false
        },
        _ => false
    }
}

fn has_failure(cs: Causes, message: String) -> bool {
    for cause in cs {
        if let Fail(text) = cause.kind {
            if text == message {
                return true
            }
        }
    }
    false
}

// L22: faults and Capacity are contained. info requires mut Tx (v2.4 G2).
pub fn law_look_faults(c: Clock) -> bool {
    let db = test_db(c, 1073741824)
    let s = snapshot(db)
    for i in 0u64 .. 2 {
        let message = if i == 0 {
            "look body fault"
        } else {
            "another query fault"
        }
        let failed = result.unwrap(look(s, fn(tx: Tx) -> u64 {
            fail(result.unwrap(string.from(message)))
        }))
        match take failed {
            Failed(take cs) => if !has_failure(cs, message) {
                return false
            },
            _ => return false
        }
        let expected = if i == 0 {
            7u64
        } else {
            19u64
        }
        let observed = result.unwrap(look(s, fn(tx: Tx) -> u64 {
            expected
        }))
        match take observed {
            Seen(value) => if value.value != expected || value.version != 0 || list.len(value.reads) != 0 {
                return false
            },
            _ => return false
        }
    }
    let refused_query = result.unwrap(bound bytes 0 {
        look(s, fn(tx: Tx) -> u64 {
            7u64
        })
    })
    match take refused_query {
        Ok(Refused(_)) => db.head == 0 && db.resident == 0,
        _ => false
    }
}

fn check_delta(a: Snapshot, b: Snapshot, before: List[u64], after: List[u64]) -> bool {
    let delta = result.unwrap(changes(a, b))
    let mut at: u64 = 0
    for k in 0u64 .. list.len(before) {
        if before[k] != after[k] {
            if at == list.len(delta) {
                return false
            }
            if delta[at].tree_key != result.unwrap(physical(1, key_word(k))) {
                return false
            }
            let good = match delta[at].value {
                None => after[k] == 0,
                Some(raw) => raw == key_word(after[k]) && after[k] != 0
            }
            if !good {
                return false
            }
            at += 1
        }
    }
    at == list.len(delta)
}

// L23: independent 160-slot model, split/merged leaves, added and deleted roots,
// reverse comparison, branch/open boundaries and unchanged roots under bound0.
// Wrong implementations: scan equal roots, omit None, confuse branch with open.
pub fn law_changes(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    let empty = snapshot(db)
    let mut zeros: List[u64] = result.unwrap(list.with_capacity(160))
    result.unwrap(list.fill(mut zeros, 160, 0u64))
    let mut before: List[u64] = result.unwrap(list.with_capacity(160))
    result.unwrap(list.fill(mut before, 160, 0u64))
    for k in 0u64 .. 96 {
        if !put_one(mut db, k, k + 1) {
            return false
        }
        let _ = list.set(mut before, k, k + 1)
    }
    let a = snapshot(db)
    let after_copy: Result[List[u64], Capacity] = clone(before)
    let mut after = result.unwrap(take after_copy)
    for step in 0u64 .. 48 {
        let k = (step * 37) % 160
        let v = if step % 2 == 0 {
            0u64
        } else {
            step + 1000
        }
        let outcome = execute(mut db, step, fn(mut tx: Tx) -> Result[(), Error] {
            if v == 0 {
                let _ = delete_bytes(mut tx, 1, key_word(k))?
            } else {
                put_bytes(mut tx, 1, key_word(k), key_word(v))?
            }
            Ok(())
        })
        match take outcome {
            Ok(Committed(_)) => {},
            _ => return false
        }
        let _ = list.set(mut after, k, v)
    }
    let b = snapshot(db)
    if !check_delta(empty, a, zeros, before) || !check_delta(a, empty, before, zeros) || !check_delta(a, b, before, after) || !check_delta(b, a, after, before) {
        return false
    }
    let same_root = result.unwrap(bound bytes 0 {
        changes(b, b)
    })
    match take same_root {
        Ok(rows) => if list.len(rows) != 0 {
            return false
        },
        _ => return false
    }
    let other_branch = Snapshot(store: b.store, open: b.open, branch: 9, head: b.head, roots: share_roots(b.roots))
    if !check_delta(a, other_branch, before, after) {
        return false
    }
    let other_open = Snapshot(store: b.store, open: 1, branch: 0, head: b.head, roots: share_roots(b.roots))
    if !is_foreign(changes(a, other_open)) {
        return false
    }
    let foreign = test_db(c, 1073741824)
    let other_store = Snapshot(store: StoreId(hi: 9, lo: 9), open: 0, branch: 0, head: foreign.head, roots: share_roots(foreign.roots))
    if !is_foreign(changes(a, other_store)) {
        return false
    }
    let no_room = result.unwrap(bound bytes 0 {
        changes(a, b)
    })
    match take no_room {
        Error(Full(_)) => true,
        _ => false
    }
}


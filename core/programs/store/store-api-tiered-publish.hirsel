// A holder whose collection map holds a Tiered collection without a pack
// inventory (for example an empty table moving Memory -> Tiered, whose
// stamp-0 root emits no frames) still needs Step 5 to attach one.
fn tiered_without_paging(roots: List[pages.Roots]) -> bool {
    for held in roots {
        if let None = view held.collections.paging {
            if pages.tiered_collections(held.collections.root) {
                return true
            }
        }
    }
    false
}

// Each superseded main collection releases its Cold root, or the Cold
// frontier of a dirty Hot root. The old root remains authoritative until
// the cut publishes. Its pages are queued under main without reading them.
fn queue_superseded(db: Db, delta: HolderDelta, mut seen: Map[(u32, u64, u64), ()], mut queued: List[manifest.DeferredFree]) -> Result[(), Error] {
    let ReplaceMain(replacement, _) = view delta else {
        return Ok(())
    }
    let head = pages.holder_heads(db.holders)[0]
    for id in replacement.superseded {
        let Some((root, desc)) = std.page.collection_slot(head.roots.collections.root, failure_result_from_rep(catalog.prefix(id))?) else {
            continue
        }
        if pages.collection_descriptor(desc).residency != ResidentTiered {
            continue
        }
        let mut effects: List[pager.TieredFoldEffect] = list.new()
        failure_result_from_rep(pager.fold_record_lost(root, map.new(), map.new(), true, mut effects))?
        for take effect in take effects {
            if let FoldDropped(take target) = take effect {
                let frame = format.tiered_frame_id(target)
                let key = (head.id, frame.pack, frame.offset)
                if !map.contains(seen, key) {
                    failure_result_from_rep(types.capacity(map.try_reserve(mut seen, 1)))?
                    map.insert(mut seen, key, ())
                    failure_result_from_rep(types.capacity(list.try_reserve(mut queued, 1)))?
                    list.push(mut queued, manifest.DeferredFree(branch_id: head.id, target: take target))
                }
            }
        }
    }
    Ok(())
}

// T2 then T4: every Hot Tiered page and blob that a participant reaches is
// emitted once by stamp, class 4 then class 3, from the installed `next_pack`
// upward.
fn stage_tiered_cut(db: Db, delta: HolderDelta, take participants: List[pages.Roots], branches: List[u32], heads: u64, promote: Option[u64], cap: u64) -> Result[pager.TieredCutStage, Error] waits {
    let id = db.store
    let first_pack = manifest.pack_next(disk_state(db).packs)
    let pager_link: Option[View[Sender[pager.TieredPagerMessage]]] = match pager.pager_requests(db.pager) {
        Some(requests) => Some(view requests),
        None => None,
    }
    let mut next_stamp = failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders)))?
    let mut roots = take participants
    if let ReplaceMain(replacement, _) = delta {
        if let Some(freed) = view replacement.chunk_freed {
            tiered_index_dirty_room(db, roots, freed)?
        }
    }
    let mut seen: Map[(u32, u64, u64), ()] = map.new()
    let mut queued: List[manifest.DeferredFree] = list.new()
    failure_result_from_rep(pager.queue_live_dropped(pager.dirty_cut(disk_state(db).tiered).dropped, mut seen, mut queued))?
    let mut replaced: List[manifest.TieredDrainKill] = list.new()
    let owners = failure_result_from_rep(pager.fold_owners(branches, heads, manifest.pack_forked(disk_state(db).packs)))?
    let overlays = failure_result_from_rep(pager.fold_cut_roots(pager_link, mut roots, branches, owners, promote, mut next_stamp, mut seen, mut queued, mut replaced))?
    if let ReplaceMain(replacement, _) = delta {
        if list.len(replacement.superseded) != 0 {
            queue_superseded(db, delta, mut seen, mut queued)?
        }
        if let Some(freed) = view replacement.chunk_freed {
            queue_index_chunk_frees(freed, pages.holder_heads(db.holders)[0].id, mut seen, mut queued, mut replaced)?
        }
    }
    // A Tiered -> Memory change installs its loaded tree like a fold does.
    let loaded = failure_result_from_rep(pager.load_memory_residency(pager_link, mut roots, branches, pager.unload_collection(disk_state(db).tiered), mut next_stamp, mut queued))? || overlays
    // A promotion that emits nothing still installs its re-pointed
    // collection map. It runs after the queue's added rows have formed, so
    // its materialization adds none (§13.6a mandatory candidate step 4).
    let (promoted, materialized) = match promote {
        Some(slot) => promote_cut_holder(db, pager_link, mut roots, slot, queued, mut next_stamp)?,
        None => (false, false),
    }
    let compacted = compact_cut(db, pager_link, mut roots, queued, mut next_stamp)?
    let leases = failure_result_from_rep(pager.lease_cut_inventories(pager.disk_compaction(disk_state(db).tiered), roots))?
    let pager.TieredCompactStep(probes: take probes, retiring: take retiring, moved: take moved, queue: take moving) = take compacted
    let folded = loaded || promoted || materialized || list.len(retiring) != 0 || tiered_without_paging(roots)
    let compaction = pager.TieredCompaction(probes: take probes, held: take leases)
    let mut queue = drain_cut(db, pager_link, take queued, take replaced, moving, next_stamp)?
    queue.moved = take moved
    queue.retiring = take retiring
    // The moved queue rows' copies follow the roots', so a stamp a root
    // also moved keeps the one location the roots take.
    let mut pending = failure_result_from_rep(pager.tiered_cut_frames_restamped(roots, pager.restamp_collection(disk_state(db).tiered), mut next_stamp))?
    failure_result_from_rep(pager.tiered_emit_queue(mut pending, moving))?
    let pager.TieredCutFrames(pages: take staged_page_frames, blobs: take blobs, ..) = take pending
    if list.len(staged_page_frames) == 0 && list.len(blobs) == 0 && !folded {
        return Ok(pager.TieredCutStage(packs: list.new(), roots: take roots, next_pack: first_pack, stamp_end: next_stamp, folded: false, materialized: materialized, queue: take queue, compaction: take compaction, emitted: map.new()))
    }
    let blob_run = failure_result_from_rep(pager.layout_tiered_packs(take blobs, 4, first_pack, cap))?
    let page_run = failure_result_from_rep(pager.layout_tiered_packs(take staged_page_frames, 3, blob_run.next_pack, cap))?
    let mut emitted: Map[u64, std.page.PagePtr] = map.new()
    let mut packs: List[pager.TieredCutPack] = list.new()
    failure_result_from_rep(pager.encode_tiered_run(store_key_to_rep(id), blob_run, mut emitted, mut packs))?
    failure_result_from_rep(pager.encode_tiered_run(store_key_to_rep(id), page_run, mut emitted, mut packs))?
    failure_result_from_rep(pager.settle_queue_moves(mut queue, moving, emitted, manifest.pack_lists(disk_state(db).packs).deferred_next))?
    let mut sealed: List[pages.Roots] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut sealed, list.len(roots))))?
    for held in roots {
        let collections = failure_result_from_rep(pager.seal_holder_tiered(held.collections, emitted))?
        list.push(mut sealed, pages.PageRoots(collections: take collections, streams: pages.share_page_tree(held.streams), catalog: pages.share_page_tree(held.catalog), keyed: pages.share_keyed_pages(held.keyed)))
    }
    Ok(pager.TieredCutStage(packs: take packs, roots: take sealed, next_pack: page_run.next_pack, stamp_end: next_stamp, folded: folded, materialized: materialized, queue: take queue, compaction: take compaction, emitted: take emitted))
}

// T8 step 4 reads queued pages through the installed inventory. A cut with
// an empty queue, or a zero `free_budget`, reads nothing.
fn drain_cut(db: Db, pager_link: Option[View[Sender[pager.TieredPagerMessage]]], take added: List[manifest.DeferredFree], take folded: List[manifest.TieredDrainKill], moving: Map[u64, pager.TieredQueueMove], next_stamp: u64) -> Result[manifest.CutQueue, Error] waits {
    let mut queue = manifest.CutQueue(added: take added, rewritten: list.new(), drained: list.new(), kills: list.new(), folded: take folded, moved: list.new(), retiring: list.new())
    let installed = disk_state(db).packs
    let budget = disk_state(db).options.free_budget
    if budget == 0 || (std.page.count(std.page.image_of(manifest.pack_lists(installed).deferred)) == 0 && list.len(queue.added) == 0) {
        return Ok(take queue)
    }
    let Some(requests) = pager_link else {
        return Error(Io(Closed))
    }
    let kept = list.len(queue.added)
    let drained = match failure_result_from_rep(history.recovered_tiered_inventory(manifest.pack_locations(installed), None, db.checkpointed, next_stamp)) {
        Ok(paging) => {
            let source = pager.TieredPageSource(pager: channel.sender(requests), packs: std.omap.snapshot(paging.packs), next_stamp: next_stamp, deadline: 0)
            failure_result_from_rep(pager.drain_cut_queue(source, manifest.pack_lists(installed).deferred, manifest.pack_lists(installed).deferred_next, mut queue, moving, budget))
        },
        Error(take problem) => Error(take problem),
    }
    match take drained {
        Ok(()) => Ok(take queue),
        // Step 4 is optional (§13.6a T8): a refused drain leaves the queue as
        // it stands, and the cut publishes the mandatory steps.
        Error(Full(Allocation(_))) => {
            while list.len(queue.added) > kept {
                let _ = list.pop(mut queue.added)
            }
            queue.drained = list.new()
            queue.kills = list.new()
            Ok(take queue)
        },
        Error(take problem) => Error(take problem),
    }
}

// Step 5: each participant's Tiered images replace its Hot ones, in the
// order `visit_cut_heads` and `visit_cut_pins` gave them to the stage.
fn install_tiered_holders(mut db: Db, take holder_delta: HolderDelta, take cut_stage: pager.TieredCutStage) -> HolderDelta {
    let mut delta = take holder_delta
    if pager.tiered_cut_stage_empty(cut_stage) {
        return take delta
    }
    let pager.TieredCutStage(roots: take sealed, ..) = take cut_stage
    let mut sealed_roots = take sealed
    let mut at = 0u64
    let removed: Option[u64] = match delta {
        RemoveHead(slot) => Some(slot),
        ReplaceMain(_, slot) => slot,
        _ => None,
    }
    let head_count = list.len(pages.holder_heads(db.holders))
    for slot in 0u64 .. head_count {
        if removed == Some(slot) {
            continue
        }
        if slot == 0 {
            if let ReplaceMain(mut replacement, _) = delta {
                replacement.roots.collections = pager.take_sealed(mut sealed_roots, mut at)
                continue
            }
        }
        pages.set_head_collection(mut db.holders, slot, pager.take_sealed(mut sealed_roots, mut at))
    }
    if let AddHead(mut added, _) = delta {
        added.roots.collections = pager.take_sealed(mut sealed_roots, mut at)
    }
    let dropped = removed_pins(delta)
    let mut inserted = false
    let pin_count = list.len(pages.holder_pins(db.holders))
    for slot in 0u64 .. pin_count {
        if list.contains(dropped, slot) {
            continue
        }
        if let ReplacePin(pin_slot, mut replacement) = delta {
            if pin_slot == slot {
                replacement.roots.collections = pager.take_sealed(mut sealed_roots, mut at)
                continue
            }
        }
        if !inserted {
            if let AddPin(mut added) = delta {
                if manifest.pin_order(added.name, added.owner, pages.holder_pins(db.holders)[slot].name, pages.holder_pins(db.holders)[slot].owner) == Less {
                    added.roots.collections = pager.take_sealed(mut sealed_roots, mut at)
                    inserted = true
                }
            }
        }
        pages.install_sealed_pin(mut db.holders, slot, pager.take_sealed(mut sealed_roots, mut at))
    }
    if !inserted {
        if let AddPin(mut added) = delta {
            added.roots.collections = pager.take_sealed(mut sealed_roots, mut at)
        }
    }
    take delta
}

fn tiered_index_dirty_room(db: Db, roots: List[pages.Roots], freed: pager.TieredFreed) -> Result[(), Error] {
    let frames = failure_result_from_rep(pager.tiered_cut_frames(roots))?
    let state = disk_state(db)
    let dirty = pager.dirty_cut(state.tiered)
    let replaced = int.saturating_add(dirty.replaced_rows, list.len(freed.replaced))
    let dropped = int.saturating_add(list.len(dirty.dropped), list.len(freed.dropped))
    let mut requested = int.saturating_add(int.saturating_mul(replaced, pager.REPLACED_ROW), int.saturating_mul(dropped, pager.DROPPED_ROW))
    for item in frames.pages {
        requested = int.saturating_add(requested, item.frame.size)
    }
    for item in frames.blobs {
        requested = int.saturating_add(requested, item.frame.size)
    }
    failure_result_from_rep(catalog.over_ceiling(requested, state.options.dirty_bytes))
}

fn queue_index_chunk_frees(freed: pager.TieredFreed, branch_id: u32, mut seen: Map[(u32, u64, u64), ()], mut queued: List[manifest.DeferredFree], mut replaced: List[manifest.TieredDrainKill]) -> Result[(), Error] {
    for frame in freed.replaced {
        failure_result_from_rep(types.capacity(list.try_reserve(mut replaced, 1)))?
        list.push(mut replaced, manifest.TieredDrainKill(branch_id: branch_id, frame: frame))
    }
    for target in freed.dropped {
        let frame = format.tiered_frame_id(target)
        let key = (branch_id, frame.pack, frame.offset)
        if !map.contains(seen, key) {
            failure_result_from_rep(types.capacity(map.try_reserve(mut seen, 1)))?
            map.insert(mut seen, key, ())
            failure_result_from_rep(types.capacity(list.try_reserve(mut queued, 1)))?
            list.push(mut queued, manifest.DeferredFree(branch_id: branch_id, target: clone(target)))
        }
    }
    Ok(())
}

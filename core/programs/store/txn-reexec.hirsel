// The journal and the private draft use the same logical ordering. Frame each
// key and value and distinguish deletes, empty puts, direct chunks and trims.
fn digest_write(mut hash: std.sha256.Sha256, key: Bytes, floor: Option[u64], value: Option[View[Bytes]], direct: Option[View[format.DirectBlob]]) {
    digest_part(mut hash, key)
    if let Some(trim) = floor {
        std.sha256.add_byte(mut hash, 2)
        for i in 0u64 .. 8 {
            std.sha256.add_byte(mut hash, int.truncate(trim >> int.truncate(i * 8)))
        }
    } else if let Some(place) = direct {
        std.sha256.add_byte(mut hash, 3)
        for word in[place.stamp, place.len, place.checksum, place.pack, place.offset, place.epoch, place.pack_len, place.digest] {
            for i in 0u64 .. 8 {
                std.sha256.add_byte(mut hash, int.truncate(word >> int.truncate(i * 8)))
            }
        }
    } else if let Some(raw) = value {
        std.sha256.add_byte(mut hash, 1)
        digest_part(mut hash, raw)
    } else {
        std.sha256.add_byte(mut hash, 0)
    }
}

pub fn journal_writes(committed: List[format.JournalOp]) -> Inline[u8, 32] {
    let mut hash = std.sha256.start()
    for op in committed {
        digest_write(mut hash, op.key, match op.trim {
            Some(trim) => Some(trim.floor),
            None => None,
        }, match op.value {
            Some(raw) => Some(view raw),
            None => None,
        }, match op.direct {
            Some(place) => Some(view place),
            None => None,
        })
    }
    std.sha256.finish(hash)
}

pub fn replayed_writes(rows: pages.DataRows) -> Result[Inline[u8, 32], types.Failure] {
    let order = types.capacity(pages.data_order(rows))?
    let mut hash = std.sha256.start()
    for slot in 0u64 .. pages.data_row_count(rows) {
        let op = pager.ordered_row(rows, order, slot)
        digest_write(mut hash, op.key, match op.trim {
            Some(trim) => Some(trim.floor),
            None => None,
        }, match op.value {
            Some(raw) => Some(format.staged_bytes(raw)),
            None => None,
        }, match op.value {
            Some(SealedChunk(chunk)) => Some(view chunk.place),
            _ => None,
        })
    }
    Ok(std.sha256.finish(hash))
}

pub fn replay_base_state(take validated: manifest.ValidatedPageManifest) -> Result[(manifest.PageManifest, pages.State), types.Failure] {
    let mut has_cold = false
    for (_, pack) in validated.inventory {
        if pack.class >= 3 {
            has_cold = true
            break
        }
    }
    if has_cold {
        let manifest.LoadedPageStore(manifest: take selected, holders: take holders, ..) = history.rebuild_page_store(take validated, None)?
        let state = manifest.disk_allocation(scoped fn() -> Result[pages.State, types.Failure] {
            types.capacity(manifest.manifest_state(selected, holders))
        })?
        return Ok((take selected, take state))
    }
    let manifest.ValidatedPageManifest(manifest: take selected, graph: take resolved, ..) = take validated
    let mut graph = take resolved
    let empty_collection = manifest.disk_allocation(fn() -> Result[Arc[std.page.Page], types.Failure] {
        Ok(std.page.empty(0, 0, Collection))
    })?
    let page_nodes = manifest.attach_page_graph(mut graph, empty_collection)?
    let state = manifest.disk_allocation(scoped fn() -> Result[pages.State, types.Failure] {
        let holders = manifest.attach_manifest_holders(selected, page_nodes, empty_collection)
        types.capacity(manifest.manifest_state(selected, holders))
    })?
    Ok((take selected, take state))
}

// The reply the frame wrote on the record's stream: position 8, digest 32,
// state 2, then the reply (AH3).
pub fn recorded_reply(commit: format.JournalCommit, issuer: u8, subject: Bytes, t: u64, n: u64) -> Option[View[Bytes]] in commit {
    for op in commit.streams {
        if format.stream_record_matches(op.key, issuer, subject, t, n) {
            if let Some(raw) = view op.value {
                if list.len(raw) >= 41 && raw[40u64] == 2u8 {
                    return Some(view raw)
                }
            }
        }
    }
    None
}

pub fn replay_declaration_base(store_key: types.StoreKey, opened: u64, base: u64, catalog_root: pages.PageTree) -> catalog.DeclarationBase {
    catalog.DeclarationBase(store: store_key, opened: opened, version: base, stamp: std.page.stamp(std.page.image_of(catalog_root.root)), changes: 0, live: 0)
}

pub type BaseReplay {
    replay: pager.JournalReplay,
    branch: u32,
    next: u64,
    stopped: bool
}

fn begin_object_export_copy(mut db: Db, take into: transfer.ExportInto, take attempt: Bytes, activation: Option[u64]) -> Result[ExportCopy, DeployError] waits {
    let receipt = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    deploy_result(durable(mut db, receipt))?
    // §12.11.11 M5: export/backup on an attached Place cuts when `sealed` is
    // non-empty (returning its refusal if refused), or settles keeping ATTACH
    // when `sealed` is empty so the holder keeps serving with ATTACH intact.
    let (is_attached, has_sealed) = match disk_state(db).backend {
        ObjectBackend(writer) => object_writer.attachment(writer),
        DirBackend(_) => (false, false),
    }
    if is_attached && has_sealed {
        let cut_ticket = deploy_result(checkpoint(mut db))?
        deploy_result(durable(mut db, cut_ticket))?
    }
    let (take parked, take resume) = deploy_result(take_object_journal_with(mut db, true))?
    let mut lane = take parked
    let mut report: Option[host_stream.DeferredSlotReport] = None
    let settle_err: Option[Error] = if is_attached && !has_sealed {
        let group_bytes: u64 = int.widen(disk_state(db).options.group_bytes)
        let group_commits: u64 = int.widen(disk_state(db).options.group_commits)
        let last_seq = match object_writer.paused_stream(lane) {
            Some(link) => host_stream.slot_last_batch(link),
            None => 0u64,
        }
        let (take settled, take outcome) = object_writer.settle_object_stream(take lane, last_seq, last_seq + 1, false, group_bytes, group_commits)
        lane = take settled
        match take outcome {
            Ok(SettleApplied) => {
                let fseq = match object_writer.paused_attach(lane) {
                    Some(a) => match a.live {
                        Some(r) => r.from_seq,
                        None => 0u64,
                    },
                    None => 0u64,
                }
                object_writer.object_journal_stream_trim_batches(mut lane, fseq)
                if let Some(link) = object_writer.paused_stream(lane) {
                    report = Some(host_stream.defer_slot_head(link, object_writer.paused_head(lane).store, object_writer.paused_attach(lane), last_seq))
                }
                None
            },
            Ok(SettleFenced(moved_epoch, cutoff)) => {
                if let Some(link) = object_writer.paused_stream(lane) {
                    report = Some(host_stream.defer_slot_report(link, ReportFenced(host_stream.slot_number(link), object_writer.paused_head(lane).store, object_writer.paused_head(lane).pair.epoch, moved_epoch, cutoff)))
                }
                Some(Fenced(object_writer.paused_head(lane).pair.epoch))
            },
            Ok(SettleNotApplied) => Some(Undecided),
            Error(take problem) => Some(failure_from_rep(take problem)),
        }
    } else {
        None
    }
    if let Some(take problem) = take settle_err {
        deploy_result(failure_result_from_rep(object_writer.return_object_journal(take lane, resume)))?
        if let Some(take completion) = take report {
            host_stream.deliver_slot_report(take completion)
        }
        return Error(Store(take problem))
    }
    let (lifetime, stop): (Sender[()], Receiver[()]) = channel.new(1)
    let captured: Result[ExportCopy, DeployError] = match object_export_capture(db, mut lane, take into, take attempt, activation, take stop) {
        Error(Store(HistoryMissing(take key, _))) => {
            let due = object_writer.paused_deadline(lane)
            match failure_result_from_rep(object_writer.object_journal_fresh_probe(mut lane, due)) {
                Ok(()) => Error(Store(failure_from_rep(format.disk_fault(key, 0, Absent)))),
                Error(take problem) => Error(Store(take problem)),
            }
        },
        other => take other,
    }
    deploy_result(failure_result_from_rep(object_writer.return_object_journal(take lane, resume)))?
    if let Some(take completion) = take report {
        host_stream.deliver_slot_report(take completion)
    }
    let job = captured?
    let held = arc.share(job.lease)
    write_disk(mut db.disk, (take lifetime, take held), scoped fn(mut state: DiskState, take grant: (Sender[()], Arc[manifest.ExportLease])) {
        let (take sending, take lease) = take grant
        transfer.start_lease(mut state.transfer, take lease)
        if let ObjectBackend(mut writer) = state.backend {
            object_writer.set_export_lifetime(mut writer, Some(take sending))
        }
    })
    Ok(take job)
}

fn object_export_capture(db: Db, mut lane: object_writer.ObjectJournalSession, take into: transfer.ExportInto, take attempt: Bytes, wanted: Option[u64], take stop: Receiver[()]) -> Result[ExportCopy, DeployError] waits {
    let head = object_writer.paused_head(lane)
    // A backup (no activation) takes the activation the head has.
    let activation = match wanted {
        Some(given) => given,
        None => head.activation
    }
    if activation != head.activation {
        return Error(Drift)
    }
    let due = object_writer.paused_deadline(lane)
    deploy_result(failure_result_from_rep(object_writer.object_journal_fresh_probe(mut lane, due)))?
    let (take mark, _) = deploy_result(failure_result_from_rep(object_writer.read_checkpoint(mut lane, head, due)))?
    let suffix = deploy_result(failure_result_from_rep(object_writer.read_export_suffix(mut lane, head, due)))?
    let (take packs, take history_entries, take names) = deploy_result(disk_allocation(scoped fn() -> Result[(List[pages.HistoryRef], List[pages.HistoryRef], Map[String, ()]), Error] {
        let locator = object_writer.object_locator(object_state(db))
        let mut packs: List[pages.HistoryRef] = list.with_capacity(map.len(history.locator_rows(locator)))
        let mut history_entries: List[pages.HistoryRef] = list.with_capacity(list.len(suffix))
        let mut names: Map[String, ()] = map.new()
        failure_result_from_rep(object_writer.live_reclaim_name(mut names, "m-", mark.manifest))?
        failure_result_from_rep(object_writer.live_reclaim_name(mut names, "e-", head.checkpoint))?
        for chunk in history.locator_chunks(locator) {
            failure_result_from_rep(object_writer.live_reclaim_name(mut names, "l-", chunk))?
        }
        for (_, item) in history.locator_rows(locator) {
            list.push(mut packs, item)
            failure_result_from_rep(object_writer.live_reclaim_name(mut names, "p-", item))?
        }
        for suffix_index in 0u64 .. list.len(suffix) {
            let item = history.history_length(suffix[suffix_index], head.checkpoint.seq + 1 + suffix_index)
            list.push(mut history_entries, item)
            failure_result_from_rep(object_writer.live_reclaim_name(mut names, "e-", item))?
        }
        Ok((take packs, take history_entries, take names))
    }))?
    let mut journal_end = 72u64
    for item in history_entries {
        let key = history.history_key("e-", item)
        if item.len < 128 {
            return Error(Store(failure_from_rep(format.disk_fault(key, 112, Truncated))))
        }
        let frame = deploy_result(failure_result_from_rep(object_writer.read_export_frame(mut lane, key, item, due)))?
        if frame.kind != 0x0040 {
            let Some(total) = int.checked_add(journal_end, item.len - 112) else {
                return Error(Store(Limit(Value)))
            }
            journal_end = total
        }
    }
    let source = transfer.ObjectExportCopy(journal: channel.sender(object_sender(disk_state(db))), health: object_writer.health_handle(object_state(db)), manifest: mark.manifest, packs: take packs, entries: take history_entries)
    let retained = deploy_result(failure_result_from_rep(types.copied(attempt)))?
    let stamp = ExportStamp(attempt: take attempt, store_hi: db.store.hi, store_lo: db.store.lo, opened: open_number(db), branch: 0, head: pages.holder_heads(db.holders)[0].head, next_table: catalog.next_table_id(db.schema), activation, binding: export_binding_bytes(head.binding), terminal: head.checkpoint.seq, end: journal_end)
    let lease = arc.new(manifest.ExportLease(attempt: take retained, packs: list.new(), collections: pages.share_page_tree(pages.holder_heads(db.holders)[0].roots.collections), first: stamp.terminal, terminal: stamp.terminal, end: stamp.end, head: stamp.head, next_table: stamp.next_table, activation))
    object_writer.hold_export(mut lane, take names, take stop)
    Ok(ExportCopy(source: ExportObject(take source), into: take into, stamp: take stamp, lease: take lease))
}

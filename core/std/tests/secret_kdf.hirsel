fn seal_kdf(take raw: Bytes, uses: String) -> Secret {
    result.unwrap(secret.seal(take raw, uses))
}

fn refused(take answer: Result[Secret, SecretError]) -> bool {
    match take answer {
        Error(Invalid) => true,
        _ => false
    }
}

fn refuses_all(parent: Secret, uses: String) -> bool {
    let cost = Argon2Cost(memory_kib: 256, passes: 2, lanes: 2)
    refused(secret.derive_hmac_sha256(parent, b"", b"x", uses)) && refused(secret.derive_hkdf_sha256(parent, b"", b"", 32, uses)) && refused(secret.derive_argon2id(parent, b"somesalt", cost, 32, uses))
}

// KD4. A kdf parent grants only symmetric child uses. A sealed parent's
// derived child can be wrapped by a sealed KEK.
// expect: run kd4_child_policy() = true
fn kd4_child_policy() -> bool {
    let root = seal_kdf(b"password", "kdf")
    let permitted = result.unwrap(secret.derive_hmac_sha256(root, b"", b"x", "aead(aes256-gcm)"))
    let kek = seal_kdf(b"0123456789abcdef0123456789abcdef", "wrap")
    let mut out: Bytes = list.with_capacity(256)
    let n = result.unwrap(secret.wrap(kek, permitted, mut out))
    n == list.len(out) && n != 0 && refuses_all(root, "tls_send(alpha.test)") && refuses_all(root, "sign(ed25519)") && refuses_all(root, "wrap") && refuses_all(root, "mtls_client_id") && refuses_all(seal_kdf(b"password", "mac"), "mac")
}

// KD5. The libargon2 src/test.c Argon2_id case at m=256, t=2, p=2.
// The expected MAC is Python hmac.digest with the published tag as key.
// expect: run kd5_argon2_charges() = true
fn kd5_argon2_charges() -> bool {
    let root = seal_kdf(b"password", "kdf")
    let salt = b"somesalt"
    let cost = Argon2Cost(memory_kib: 256, passes: 2, lanes: 2)
    let len: u64 = 32
    let uses = "mac"
    let exhausted = bound bytes 0 {
        bound steps 512 {
            secret.derive_argon2id(root, salt, cost, len, uses)
        }
    }
    let Ok(Error(time)) = take exhausted else {
        return false
    }
    let small = bound bytes 262207 {
        secret.derive_argon2id(root, salt, cost, len, uses)
    }
    let Ok(Error(Capacity(capacity))) = take small else {
        return false
    }
    if time.steps != 512 || capacity.requested != 262208 || capacity.available != 262207 {
        return false
    }
    let exact = bound bytes 262208 {
        let answer = bound steps 513 {
            secret.derive_argon2id(root, salt, cost, len, uses)
        }
        let Ok(Ok(child)) = take answer else {
            return false
        }
        let again = secret.derive_argon2id(root, salt, cost, len, uses)
        let Error(Capacity(held)) = take again else {
            return false
        }
        held.requested == 262208 && held.available == 262144 && result.unwrap(secret.verify_hmac_sha256(child, b"x", b"\xde\xd0\xfe\x8e\x0a\xe5\xd8\x25\xcc\xb4\xf9\x27\x8d\x78\x37\xba\x65\x07\x05\xbd\xd2\xb0\x2d\x12\x9c\x25\x6f\x91\x6b\x53\xb3\x91"))
    }
    match exact {
        Ok(true) => true,
        _ => false
    }
}

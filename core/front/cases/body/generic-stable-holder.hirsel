// A generic body copies the region locator. A region reference counts 16 logical
// bytes independently of the encoded payload size (MEM-24).
// expect: accept
// expect: run kept() = 15
// expect: run widened() = 64
@compact(u32)
type Span2 {
    start: u64,
    end: u64
}

@compact(u32)
type Span3 {
    a: u64,
    b: u64,
    c: u64
}

fn keep[T](take x: T) -> T {
    let y = x
    y
}

fn kept() -> u64 {
    region r {
        match make_span2(r, 5, 10) {
            Ok(s) => {
                let t = keep(s)
                t.start + t.end
            },
            Error(_) => 0
        }
    }
}

// budgets.md: a reference to a stable value counts 16, so reserving 4 requests
// 4 * 16 bytes, not 4 * 24.
fn asked[T](mut xs: List[T]) -> u64 {
    let got = bound bytes 0 {
        list.try_reserve(mut xs, 4)
    }
    match got {
        Ok(Error(e)) => e.requested,
        _ => 0
    }
}

fn widened() -> u64 {
    region r {
        let mut xs: List[Span3 in r] = list.new()
        asked(mut xs)
    }
}

fn make_span2(r: Region, start: u64, end: u64) -> Result[Span2 in r, Capacity] {
    match build_in(r, bytes 16, fn(mut d: Dest[Span2]) -> Result[Child[Span2], BuildError] {
        dest.put(mut d, Span2(start: start, end: end))
    }) {
        Ok(take built) => Ok(finish(take built)),
        Error(Overflow) => fail("fixed document size"),
    }
}

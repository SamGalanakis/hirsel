// rule: STORE-8
// expect: run
// authorities: {"log":{"provider":"authority.sim@1","floor":"cache","seed":3,"represent":"log","levels":["cache","disk"],"faults":{}}}
// stdout: log: agrees
// cuts: 1..=40
// steps: 20000000
// The readers table a store keeps on its history as Retain folds and
// ReaderDelta commits is the table a model keeps of the same changes. A seeded
// sequence of acquires (fresh tokens and tokens dropped before), drops by the
// holder and releases by the operator fills the table to `MOST` holders, with
// compactions and reopens between, on a log. Between compactions the
// ReaderDelta runs reach their bound, min(holders, FOLD_DELTAS), both below
// FOLD_DELTAS holders, where the bound is the holders, and above it, where it
// is FOLD_DELTAS; the model counts the runs that must end in a fold at each.
// Each acquire pins a state whose `x` no other acquire pinned, at a version
// the model notes. After a change, the pin it touched and another the model
// picks read through store.at_pin (newest first, from authority.last) as the
// model says: the state its acquire pinned while the model holds it,
// PinReleased() once it does not, a dropped pin's token acquired again
// included. After each reopen, which recovers the table forward from the
// history, store.reader_pins lists exactly the model's holders at the
// versions it noted, and at the end every pin ever acquired reads as the
// model says.
// Every run makes the whole sequence and one window of its checks, so each
// fits the step cap: the corpus runs the case once per window K of the
// declared ones (the arguments K and the last), the sequence's checks are
// dealt to the windows in turn, and run K makes those dealt to window K. The
// windows together make every check.
pub type Failed = Check(String) | Store(store.StoreError)

fn check(ok: bool, take what: String) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check(what))
  }
}

fn put_x(mut tx: store.Tx, info: store.CallInfo, n: u8) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"x", bytes.from_list([n]))
}

// One acquire: the index of the token it used, the pin it returned, the `x` of
// the state it pinned and whether the model still holds it.
type Issued {
  token: u64,
  held: store.HeldPin,
  x: u8,
  live: bool,
}

// Whether `h` reads as the model says: the state whose `x` is `x` while the
// model holds it, and PinReleased() otherwise.
fn agrees(a: Authority, i: Issued) -> bool {
  match store.at_pin(a, i.held) {
    Ok(snap) => i.live && store.get(snap, b"x") == Some(bytes.from_list([i.x])),
    Error(PinReleased()) => !i.live,
    Error(_) => false,
  }
}

// Whether the store's holders are exactly the model's live ones: as many, and
// each pinning the version the model noted for a live issued pin (an acquire is
// a commit, so no two acquires pin one version).
fn listed(
  a: Authority,
  mut s: store.Store,
  issued: List[Issued],
  versions: List[store.Version of a]
) -> Result[bool, Failed] {
  let holders = store.reader_pins(a, mut s) ? Store
  let mut want: List[store.Version of a] = []
  for k in 0u64..list.len(issued) {
    if issued[k].live {
      list.push(mut want, versions[k])
    }
  }
  if list.len(holders) != list.len(want) {
    return Ok(false)
  }
  for h in holders {
    let mut found = false
    for v in want {
      found = found || v == store.pin_version(a, h)
    }
    if !found {
      return Ok(false)
    }
  }
  Ok(true)
}

fn draw(mut g: prng.Generator, n: u64) -> u64 {
  match prng.below(mut g, n) {
    Ok(x) => x,
    Error(_) => 0,
  }
}

// The index of a random issued pin the model holds (`live`) or not.
fn pick(mut g: prng.Generator, issued: List[Issued], live: bool) -> Option[u64] {
  let mut at: List[u64] = []
  for k in 0u64..list.len(issued) {
    if issued[k].live == live {
      list.push(mut at, k)
    }
  }
  if list.len(at) == 0 {
    return None()
  }
  Some(at[draw(mut g, list.len(at))])
}

// Whether the store holds the token of the dropped pin `k` under a later pin.
fn token_held(issued: List[Issued], k: u64) -> bool {
  let mut held = false
  for i in issued {
    held = held || i.live && i.token == issued[k].token
  }
  held
}

// Steps the sequence runs, and the first steps, in which 7 changes in 8 are
// acquires (4 in 8 after) while fewer than `MOST` are held. A compaction every
// `COMPACT` steps leaves room for a run of more than FOLD_DELTAS deltas
// between the folds it causes, and the store reopens at step `FILL`.
const STEPS: u64 = 76

const FILL: u64 = 44

const MOST: u64 = 40

const COMPACT: u64 = 38

// store.hir's bound on a run of ReaderDelta commits between folds.
const FOLD_DELTAS: u64 = 32

// The ReaderDelta runs the model has seen reach their bound: `low` counts
// changes in a row, with no compaction or reopen, each touching fewer than
// FOLD_DELTAS holders, `most` the largest count among them, and `high` changes
// in a row each leaving and finding more than FOLD_DELTAS. A row at least as
// long as its bound holds a fold the bound forced.
type Runs {
  low: u64,
  most: u64,
  high: u64,
  low_folds: u64,
  high_folds: u64,
}

// Counts a change from `from` holders to `to`.
fn counted(mut r: Runs, from: u64, to: u64) {
  let lo = if from < to {
    from
  } else {
    to
  }
  let hi = if from < to {
    to
  } else {
    from
  }
  if hi < FOLD_DELTAS {
    r.low += 1
    if hi > r.most {
      r.most = hi
    }
    if r.most >= 2 && r.low >= r.most {
      r.low_folds += 1
      r.low = 0
      r.most = 0
    }
  } else {
    r.low = 0
    r.most = 0
  }
  if lo > FOLD_DELTAS {
    r.high += 1
    if r.high >= FOLD_DELTAS {
      r.high_folds += 1
      r.high = 0
    }
  } else {
    r.high = 0
  }
}

// Whether the next check, dealt to the windows in turn, is window `win`'s.
fn dealt(mut slot: u64, win: u64, wins: u64) -> bool {
  slot += 1
  (slot - 1) % wins + 1 == win
}

// A compaction or reopen ends every row.
fn ended(mut r: Runs) {
  r.low = 0
  r.most = 0
  r.high = 0
}

// Argument i of the run: the corpus driver runs the case once per declared
// window K, with the arguments K and the last declared window.
fn window_arg(args: Args, i: u64) -> Result[u64, Failed] {
  match arg.text(args, i) {
    Ok(text) => match u64.parse(text) {
      Ok(k) => Ok(k),
      Error(_) => Error(Check(f"argument {i} is not a window")),
    },
    Error(_) => Error(
      Check(f"argument {i} is missing: the corpus driver runs each window")
    ),
  }
}

fn run(rt: Io, name: String, win: u64, wins: u64) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, name) else {
    return Error(Check(f"{name} not granted"))
  }
  let Ok(r) = io.random(rt) else {
    return Error(Check("random"))
  }
  let mut g = prng.seed(681)
  let mut s = store.open(a, store.default_config()) ? Store
  let mut issued: List[Issued] = []
  // The version each issued pin pins, by the store's snapshot before its
  // acquire.
  let mut versions: List[store.Version of a] = []
  let mut tokens: List[store.ReaderPin] = []
  let mut live: u64 = 0
  let mut most: u64 = 0
  let mut runs = Runs(low: 0, most: 0, high: 0, low_folds: 0, high_folds: 0)
  // The checks the sequence has dealt.
  let mut slot: u64 = 0
  for step in 1u64..STEPS + 1 {
    let n: u8 = int.truncate(step)
    let wrote: Result[(), store.TxFailure[store.TxError]] = store.transact(
      mut s,
      put_x,
      n
    )
    check(wrote == Ok(()), f"{name}: write {step}")?
    let holding = live
    let roll = draw(mut g, 8)
    let mut touched: Option[u64] = None()
    let acquires: u64 = if step <= FILL {
      7
    } else {
      4
    }
    if live < MOST && roll < acquires || live == 0 {
      // An acquire, of a dropped pin's token when one is free.
      let mut token: Option[u64] = None()
      if roll == 0 {
        if let Some(k) = pick(mut g, issued, false) {
          if !token_held(issued, k) {
            token = Some(issued[k].token)
          }
        }
      }
      let t = match token {
        Some(t) => t,
        None() => {
          let Ok(fresh) = store.new_reader_pin(r) else {
            return Error(Check("token"))
          }
          list.push(mut tokens, fresh)
          list.len(tokens) - 1
        },
      }
      let p = tokens[t]
      let now = store.snapshot(a, mut s, authority.floor(a)) ? Store
      let version = store.version(a, now)
      let got: Result[store.HeldPin, store.TxFailure[store.PinError]] = store.transact(
        mut s,
        store.acquire_reader_pin,
        p
      )
      let Ok(held) = got else {
        return Error(Check(f"{name}: acquire {step}"))
      }
      list.push(mut issued, Issued(token: t, held: held, x: n, live: true))
      list.push(mut versions, version)
      live += 1
      touched = Some(list.len(issued) - 1)
    } else if let Some(k) = pick(mut g, issued, true) {
      if roll < 7 {
        // The holder drops it.
        let gone: Result[(), store.TxFailure[()]] = store.transact(
          mut s,
          store.drop_reader_pin,
          issued[k].held
        )
        check(gone == Ok(()), f"{name}: drop {step}")?
      } else {
        // The operator releases its holder.
        let holders = store.reader_pins(a, mut s) ? Store
        let mut released = false
        let pinned = versions[k]
        for h in holders {
          if !released && pinned == store.pin_version(a, h) {
            released = store.release_reader_pin(mut s, h) == Ok(true)
          }
        }
        check(released, f"{name}: release {step}")?
      }
      issued[k].live = false
      live -= 1
      touched = Some(k)
    }
    if let Some(k) = touched {
      counted(mut runs, holding, live)
      if dealt(mut slot, win, wins) {
        check(agrees(a, issued[k]), f"{name}: step {step} pin {k}")?
      }
    }
    let other = draw(mut g, list.len(issued))
    if dealt(mut slot, win, wins) {
      check(agrees(a, issued[other]), f"{name}: step {step} pin {other}")?
    }
    if step % COMPACT == 0 {
      store.compact(mut s) ? Store
      ended(mut runs)
    }
    if live > most {
      most = live
    }
    if step == FILL {
      store.close(take s) ? Store
      s = store.open(a, store.default_config()) ? Store
      ended(mut runs)
      check(
        listed(a, mut s, issued, versions)?,
        f"{name}: holders after the reopen at {step}"
      )?
    }
  }
  check(
    most == MOST && runs.low_folds > 0 && runs.high_folds > 0,
    f"{name}: {most} holders at most, {runs.low_folds} folds below and {runs.high_folds} above FOLD_DELTAS"
  )?
  store.close(take s) ? Store
  let mut again = store.open(a, store.default_config()) ? Store
  check(
    listed(a, mut again, issued, versions)?,
    f"{name}: holders after the last reopen"
  )?
  for k in 0u64..list.len(issued) {
    if dealt(mut slot, win, wins) {
      check(agrees(a, issued[k]), f"{name}: pin {k} at the end")?
    }
  }
  store.close(take again) ? Store
  Ok(())
}

fn windowed(rt: Io, args: Args) -> Result[(), Failed] {
  let win = window_arg(args, 0)?
  let wins = window_arg(args, 1)?
  run(rt, "log", win, wins)
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Check("stdout"))
  }
  let line = match windowed(rt, args) {
    Ok(()) => "log: agrees",
    Error(Check(what)) => what,
    Error(Store(_)) => "log: store error",
  }
  let _ = out.print(stdout, f"{line}\n")
  Ok(())
}

// kostya/LangArena3c9f84d benchmarks/json_{generate,parse_dom,parse_mapping}.rs.
// The DOM and typed mapping use std.json.
type Coordinate {
    x: f64,
    y: f64,
    z: f64
}

type NamedCoordinate {
    point: Coordinate,
    name: String,
    opts: Map[String, (i32, bool)]
}

type Document {
    coordinates: List[NamedCoordinate],
    info: String
}

fn prepare(n: u64) -> Result[Document, helper.Error] {
    let mut coordinates: List[NamedCoordinate] = list.new()
    let mut g = helper.lcg()
    for _ in 0 .. n {
        let x = float.round(helper.next_float(mut g, 1.0) * 100000000.0) / 100000000.0
        let y = float.round(helper.next_float(mut g, 1.0) * 100000000.0) / 100000000.0
        let z = float.round(helper.next_float(mut g, 1.0) * 100000000.0) / 100000000.0
        let mut name = string.new()
        helper.mem(float.push_fixed64(mut name, helper.next_float(mut g, 1.0), 7))?
        helper.mem(string.push(mut name, " "))?
        helper.mem(string.push_i64(mut name, int.widen(helper.next_int(mut g, 10000))))?
        let mut opts: Map[String, (i32, bool)] = map.new()
        let key = helper.mem(string.from("1"))?
        helper.mem(result.capacity_only(map.insert(mut opts, take key, (1i32, true))))?
        helper.mem(result.capacity_only(list.push(mut coordinates, NamedCoordinate(point: Coordinate(x: x, y: y, z: z), name: take name, opts: take opts))))?
    }
    Ok(Document(coordinates: take coordinates, info: "some info"))
}

fn write_options(w: std.json.Writer, depth: u64, opts: Map[String, (i32, bool)]) -> Result[(), Capacity] {
    std.json.object(w, depth, scoped fn(object: std.json.Writer, mut fields: std.json.Items) -> Result[(), Capacity] {
        for (key, opt) in opts {
            let (count, enabled) = opt
            std.json.write_member(object, mut fields, key)?
            std.json.array(object, fields.depth, scoped fn(array: std.json.Writer, mut values: std.json.Items) -> Result[(), Capacity] {
                std.json.element(array, mut values)?
                std.json.write_i64(array, int.widen(count))?
                std.json.element(array, mut values)?
                std.json.write_bool(array, enabled)
            })?
        }
        Ok(())
    })
}

fn write_coordinate(w: std.json.Writer, depth: u64, row: NamedCoordinate) -> Result[(), Capacity] {
    std.json.object(w, depth, scoped fn(object: std.json.Writer, mut fields: std.json.Items) -> Result[(), Capacity] {
        std.json.write_member(object, mut fields, "x")?
        std.json.write_f64(object, row.point.x)?
        std.json.write_member(object, mut fields, "y")?
        std.json.write_f64(object, row.point.y)?
        std.json.write_member(object, mut fields, "z")?
        std.json.write_f64(object, row.point.z)?
        std.json.write_member(object, mut fields, "name")?
        std.json.write_string_value(object, row.name)?
        std.json.write_member(object, mut fields, "opts")?
        write_options(object, fields.depth, row.opts)
    })
}

fn render(data: Document) -> Result[String, helper.Error] {
    let mut out = string.new()
    helper.mem(std.json.write(mut out, false, scoped fn(w: std.json.Writer) -> Result[(), Capacity] {
        std.json.object(w, 0, scoped fn(object: std.json.Writer, mut fields: std.json.Items) -> Result[(), Capacity] {
            std.json.write_member(object, mut fields, "coordinates")?
            std.json.array(object, fields.depth, scoped fn(array: std.json.Writer, mut values: std.json.Items) -> Result[(), Capacity] {
                for c in data.coordinates {
                    std.json.element(array, mut values)?
                    write_coordinate(array, values.depth, c)?
                }
                Ok(())
            })?
            std.json.write_member(object, mut fields, "info")?
            std.json.write_string_value(object, data.info)
        })
    }))?
    Ok(take out)
}

fn generate(n: u64) -> Result[String, helper.Error] {
    let data = prepare(n)?
    render(data)
}

fn coordinate(j: std.json.Json) -> Result[Coordinate, helper.Error] {
    let mut x: f64 = 0.0
    let mut y: f64 = 0.0
    let mut z: f64 = 0.0
    if let Obj(members) = j {
        for member in members {
            let key = text.as_string(member.key)
            if key == "x" || key == "y" || key == "z" {
                let Num(spelling) = member.value else {
                    return Error(Config)
                }
                let value = match float.parse64(text.as_string(spelling)) {
                    Ok(v) => v,
                    Error(_) => return Error(Config)
                }
                if key == "x" {
                    x = value
                } else if key == "y" {
                    y = value
                } else {
                    z = value
                }
            }
        }
        Ok(Coordinate(x: x, y: y, z: z))
    } else {
        Error(Config)
    }
}

fn read_coordinate(s: String, mut cursor: std.json.Cursor) -> Result[Coordinate, std.json.Error] {
    std.json.record_of(s, mut cursor, Coordinate(x: 0.0, y: 0.0, z: 0.0), fn(key: String, input: String, mut value: std.json.Cursor, mut c: Coordinate) -> Result[(), std.json.Error] {
        if key == "x" {
            c.x = std.json.read_f64(input, mut value)?
        } else if key == "y" {
            c.y = std.json.read_f64(input, mut value)?
        } else if key == "z" {
            c.z = std.json.read_f64(input, mut value)?
        } else {
            std.json.skip_value(input, mut value)?
        }
        Ok(())
    })
}

type Coordinates {
    items: List[Coordinate],
    found: bool
}

fn read_coordinates(s: String, mut cursor: std.json.Cursor) -> Result[Coordinates, std.json.Error] {
    std.json.record_of(s, mut cursor, Coordinates(items: list.new(), found: false), fn(key: String, input: String, mut value: std.json.Cursor, mut c: Coordinates) -> Result[(), std.json.Error] {
        if key == "coordinates" && !c.found {
            c.items = std.json.list_of(input, mut value, read_coordinate)?
            c.found = true
        } else {
            std.json.skip_value(input, mut value)?
        }
        Ok(())
    })
}

fn mean(x: f64, y: f64, z: f64, n: u64) -> Coordinate {
    let divisor: f64 = float.from_int(n)
    Coordinate(x: x / divisor, y: y / divisor, z: z / divisor)
}

fn average_mapping(s: String) -> Result[Coordinate, helper.Error] {
    let data = match std.json.decode(s, read_coordinates) {
        Ok(take data) => take data,
        Error(Build(Capacity(e))) => return Error(Capacity(e)),
        Error(_) => return Error(Config),
    }
    if !data.found {
        return Error(Config)
    }
    let mut x: f64 = 0.0
    let mut y: f64 = 0.0
    let mut z: f64 = 0.0
    for c in data.items {
        x += c.x
        y += c.y
        z += c.z
    }
    Ok(mean(x, y, z, list.len(data.items)))
}

fn average_dom(j: std.json.Json) -> Result[Coordinate, helper.Error] {
    if let Obj(members) = j {
        for member in members {
            if text.as_string(member.key) == "coordinates" {
                let Arr(items) = member.value else {
                    return Error(Config)
                }
                let mut x: f64 = 0.0
                let mut y: f64 = 0.0
                let mut z: f64 = 0.0
                for item in items {
                    let c = coordinate(item)?
                    x += c.x
                    y += c.y
                    z += c.z
                }
                return Ok(mean(x, y, z, seq.len(items)))
            }
        }
    }
    Error(Config)
}

pub fn dispatch(config: helper.Settings, name: String, warmup: u64, iterations: u64) -> Result[u32, helper.Error] {
    if name != "Json::Generate" && name != "Json::ParseDom" && name != "Json::ParseMapping" {
        return Error(UnknownTask)
    }
    let n = helper.config_i64(config, "coords")?
    if n < 0 {
        return Error(Config)
    }
    let count: u64 = int.narrow(n)
    let mut checksum: u32 = 0
    if name == "Json::Generate" {
        let data = prepare(count)?
        let mut rendered = string.new()
        for _ in 0 .. warmup + iterations {
            rendered = render(data)?
            if string.starts_with(rendered, "{\"coordinates\":") {
                checksum += 1
            }
        }
    } else {
        let source = generate(count)?
        for _ in 0 .. warmup + iterations {
            let c = if name == "Json::ParseMapping" {
                average_mapping(source)?
            } else {
                region r {
                    let j = match std.json.parse(r, source) {
                        Ok(v) => v,
                        Error(_) => return Error(Config)
                    }
                    average_dom(j)?
                }
            }
            let a = helper.checksum_f64(c.x)?
            let b = helper.checksum_f64(c.y)?
            let d = helper.checksum_f64(c.z)?
            checksum = int.wrapping_add(checksum, int.wrapping_add(int.wrapping_add(a, b), d))
        }
    }
    Ok(checksum)
}

pub fn main(out: Stdout, d: Dir, argv: Args) -> Result[(), Exit] waits {
    harness.main(out, d, argv, fn(c: helper.Settings, n: String, w: u64, i: u64) -> Result[u32, helper.Error] {
        dispatch(c, n, w, i)
    })
}

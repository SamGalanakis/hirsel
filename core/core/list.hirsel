// Module `list` (SEM-4). Bytes is List[u8].
pub fn new[T]() -> List[T]

pub fn with_capacity[T](n: u64) -> Result[List[T], Capacity]

pub fn len[T](xs: List[T]) -> u64

pub fn capacity[T](xs: List[T]) -> u64

pub fn reserve[T](mut xs: List[T], n: u64) -> Result[(), Capacity]

pub fn get[T](xs: List[T], i: u64) -> Option[View[T]] in xs

pub fn slice[T](xs: List[T], lo: u64, hi: u64) -> View[List[T]] in xs

pub fn word_le(b: Bytes, at: u64) -> u64

// Append eight little-endian bytes; Capacity leaves the buffer unchanged.
pub fn put_word_le(mut b: Bytes, x: u64) -> Result[(), Capacity]

// The front expands push in place: a full test, a cold call to grow in its true
// arm (MEM-24 from needed = len + 1), then a store within capacity.
pub fn push[T](mut xs: List[T], take x: T) -> Result[(), (Capacity, T)]

// The full arm's growth as a function of its own: reserve is expanded where it
// is called, so only a call keeps it out of the caller.
fn grow[T](mut xs: List[T]) -> Result[(), Capacity] {
    reserve(mut xs, 1)
}

pub fn pop[T](mut xs: List[T]) -> Option[T]

pub fn set[T](mut xs: List[T], i: u64, take x: T) -> T

pub fn swap[T](mut xs: List[T], i: u64, j: u64)

pub fn clear[T](mut xs: List[T])

pub fn fill[T: plain](mut xs: List[T], n: u64, x: T) -> Result[(), Capacity]

pub fn append[T: plain](mut xs: List[T], ys: List[T]) -> Result[(), Capacity]

pub fn sum[T: integer](xs: List[T]) -> T {
    let mut t: T = int.narrow(0u8)
    for x in xs {
        let next: Option[T] = int.checked_add(t, x)
        match next {
            Some(v) => {
                t = v
            },
            None => {
                // Overflow, raised by a conversion that does not fit.
                let wide: u16 = 256
                let _: u8 = int.narrow(wide)
            },
        }
    }
    t
}

// Private uninhabited storage. len is the number of live slots, not a prefix.
// Callers must empty it before free or normalize it before ordinary cleanup.
// Sort aliases keep len0 on scratch; Hole alone tracks and restores its live set.
type Slots[T] {
    raw: List[T]
}

fn slots_empty[T]() -> Slots[T]

fn slots_new[T](n: u64) -> Result[Slots[T], Capacity]

fn slots_put[T](mut s: Slots[T], i: u64, take x: T)

fn slots_take[T](mut s: Slots[T], i: u64) -> T

fn slots_view[T](s: Slots[T], i: u64) -> View[T] in s

// Distinct mutable carriers. Updates both live counts.
fn slots_move[T](mut src: Slots[T], i: u64, mut dst: Slots[T], j: u64, n: u64)

// Same carrier, including i == j. Keeps its live count.
fn slots_shift[T](mut s: Slots[T], i: u64, j: u64)

fn slots_free[T](take s: Slots[T])

// Discard only a no-drop element ring; preserves evaluator liveness.
fn slots_forget_ring[T](mut s: Slots[T], head: u64)

// Stable natural merges in Powersort order. A run may stay in either buffer
// until the next merge needs it. The last merge writes to xs.
pub fn sort_stable[T](mut xs: List[T], before: scoped fn(T, T) -> Order) -> Result[(), Capacity] {
    let n = list.len(xs)
    if n < 2 {
        return Ok(())
    }
    let scratch: Slots[T] = slots_new(n)?
    let mut g = Hole(xs: view xs, scratch: take scratch, pending:[Run(lo: 0, end: 0, in_scratch: false); 64], depth: 0, run: Run(lo: 0, end: 0, in_scratch: false), active: empty_merge())
    // Powers strictly increase on the stack and occupy only 64 bit positions.
    let mut powers: Inline[u32, 64] =[0; 64]
    let mut mid = sorted_run_end(mut g, 0, n, before)
    g.run.end = mid
    while mid < n {
        let end = sorted_run_end(mut g, mid, n, before)
        let left = g.run.lo + (mid - g.run.lo) / 2
        let right = mid + (end - mid) / 2
        let power = int.leading_zeros(left ^ right)
        while g.depth > 0 && powers[g.depth - 1] >= power {
            merge_top(mut g, false, before)
        }
        g.pending[g.depth] = g.run
        powers[g.depth] = power
        g.depth += 1
        g.run = Run(lo: mid, end: end, in_scratch: false)
        mid = end
    }
    while g.depth > 0 {
        let last = g.depth == 1
        merge_top(mut g, last, before)
    }
    let _ = take g
    Ok(())
}

fn merge_top[T](mut g: Hole[T], last: bool, before: scoped fn(T, T) -> Order) {
    let top = g.depth - 1
    let lo = g.pending[top].lo
    let mid = g.run.lo
    let end = g.run.end
    let left = g.pending[top].in_scratch
    let right = g.run.in_scratch
    let needs_merge = {
        let l = if left {
            view g.scratch.raw
        } else {
            g.xs
        }
        let r = if right {
            view g.scratch.raw
        } else {
            g.xs
        }
        precedes(slots_list_view(r, mid), slots_list_view(l, mid - 1), before)
    }
    g.depth = top
    // If the two inputs are in different buffers, stage the smaller one beside
    // the larger. The last join always targets xs, even when no merge is needed.
    let larger_in_scratch = if mid - lo < end - mid {
        right
    } else {
        left
    }
    let output_in_scratch = !last && larger_in_scratch != needs_merge
    let source_in_scratch = output_in_scratch != needs_merge
    if left != source_in_scratch {
        move_run(mut g, left, lo, mid)
    }
    if right != source_in_scratch {
        move_run(mut g, right, mid, end)
    }
    if needs_merge {
        g.active = MergeState(lo: lo, left: lo, mid: mid, right: mid, end: end, from_scratch: source_in_scratch)
        if source_in_scratch {
            merge_runs(mut g.active, view g.scratch.raw, g.xs, mid, end, before)
        } else {
            merge_runs(mut g.active, g.xs, view g.scratch.raw, mid, end, before)
        }
        g.active = empty_merge()
    }
    g.run = Run(lo: lo, end: end, in_scratch: output_in_scratch)
}

fn move_run[T](mut g: Hole[T], from_scratch: bool, lo: u64, end: u64) {
    let count = int.wrapping_sub(end, lo)
    if from_scratch {
        slots_list_move(view g.scratch.raw, lo, g.xs, lo, count)
    } else {
        slots_list_move(g.xs, lo, view g.scratch.raw, lo, count)
    }
}

fn precedes[T](a: T, b: T, before: scoped fn(T, T) -> Order) -> bool {
    match before(a, b) {
        Less => true,
        _ => false,
    }
}

fn sorted_run_end[T](mut g: Hole[T], lo: u64, n: u64, before: scoped fn(T, T) -> Order) -> u64 {
    let mut end = lo + 1
    if end == n {
        return end
    }
    let descending = precedes(slots_list_view(g.xs, end), slots_list_view(g.xs, lo), before)
    end += 1
    while end < n && precedes(slots_list_view(g.xs, end), slots_list_view(g.xs, end - 1), before) == descending {
        end += 1
    }
    // Only strictly descending runs are reversed, so equal keys never cross.
    if descending {
        let mut a = lo
        let mut b = end - 1
        while a < b {
            slots_list_move(g.xs, a, view g.scratch.raw, lo, 1)
            slots_list_move(g.xs, b, g.xs, a, 1)
            slots_list_move(view g.scratch.raw, lo, g.xs, b, 1)
            a += 1
            b -= 1
        }
    }
    // A run shorter than 16 is extended to 16 by insertion, as in Goose's stable_sort and
    // Timsort's minrun: random input otherwise merges runs of two, a full pass per doubling.
    // Adjacent swaps keep xs whole at every comparator call. Moves only past strictly
    // preceding elements keep it stable.
    let stop = if n - lo <= 16 {
        n
    } else {
        lo + 16
    }
    while end < stop {
        let mut j = end
        while j > lo && precedes(slots_list_view(g.xs, j), slots_list_view(g.xs, j - 1), before) {
            slots_list_move(g.xs, j - 1, view g.scratch.raw, lo, 1)
            slots_list_move(g.xs, j, g.xs, j - 1, 1)
            slots_list_move(view g.scratch.raw, lo, g.xs, j, 1)
            j -= 1
        }
        end += 1
    }
    end
}

fn merge_runs[T](mut state: MergeState, src: View[List[T]], dst: View[List[T]], mid: u64, end: u64, before: scoped fn(T, T) -> Order) {
    let mut at = state.left
    while state.left < mid && state.right < end {
        if precedes(slots_list_view(src, state.right), slots_list_view(src, state.left), before) {
            slots_list_move(src, state.right, dst, at, 1)
            state.right = int.wrapping_add(state.right, 1)
        } else {
            slots_list_move(src, state.left, dst, at, 1)
            state.left = int.wrapping_add(state.left, 1)
        }
        at = int.wrapping_add(at, 1)
    }
    if state.left < mid {
        slots_list_move(src, state.left, dst, at, int.wrapping_sub(mid, state.left))
    } else if state.right < end {
        slots_list_move(src, state.right, dst, at, int.wrapping_sub(end, state.right))
    }
}

type Run {
    lo: u64,
    end: u64,
    in_scratch: bool
}

// In an active merge the destination owns the prefix up to
// left + (right - mid). The source owns [left, mid) and [right, end).
type MergeState {
    lo: u64,
    left: u64,
    mid: u64,
    right: u64,
    end: u64,
    from_scratch: bool
}

fn empty_merge() -> MergeState {
    MergeState(lo: 0, left: 0, mid: 0, right: 0, end: 0, from_scratch: false)
}

// Pending runs and the current run retain their original index ranges.
// Between comparator calls a merge may split its two inputs across buffers;
// only the active cursors then describe which slots need restoration.
scoped type Hole[T] {
    xs: View[List[T]],
    scratch: Slots[T],
    pending: Inline[Run, 64],
    depth: u64,
    run: Run,
    active: MergeState
} drop(g) {
    let state = g.active
    if state.end != 0 {
        let left = state.left
        let mid = state.mid
        let right = state.right
        if state.from_scratch {
            let left_count = int.wrapping_sub(mid, left)
            if left_count != 0 {
                let at = int.wrapping_add(left, int.wrapping_sub(right, mid))
                slots_list_move(view g.scratch.raw, left, g.xs, at, left_count)
            }
            if right < state.end {
                slots_list_move(view g.scratch.raw, right, g.xs, right, int.wrapping_sub(state.end, right))
            }
        } else {
            if state.lo < left {
                slots_list_move(view g.scratch.raw, state.lo, g.xs, state.lo, int.wrapping_sub(left, state.lo))
            }
            if mid < right {
                slots_list_move(view g.scratch.raw, left, g.xs, mid, int.wrapping_sub(right, mid))
            }
        }
    } else if g.run.in_scratch {
        slots_list_move(view g.scratch.raw, g.run.lo, g.xs, g.run.lo, int.wrapping_sub(g.run.end, g.run.lo))
    }
    let mut remaining = g.depth
    for run in g.pending {
        if remaining == 0 {
            break
        }
        if run.in_scratch {
            slots_list_move(view g.scratch.raw, run.lo, g.xs, run.lo, int.wrapping_sub(run.end, run.lo))
        }
        remaining = int.wrapping_sub(remaining, 1)
    }
    slots_finish_list(g.xs)
}

// These private aliases keep both headers fixed while Hole tracks liveness.
// xs retains its original length and capacity, and the empty scratch header
// frees only the backing allocation after Hole has restored every live slot.
fn slots_list_view[T](xs: View[List[T]], i: u64) -> View[T] in xs

fn slots_list_move[T](src: View[List[T]], i: u64, dst: View[List[T]], j: u64, n: u64)

fn slots_finish_list[T](xs: View[List[T]])

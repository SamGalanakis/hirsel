// Python cryptography (OpenSSL) and hashlib/HMAC with RFC 8446 §4.4 and §7.1.
// The Ed25519 key is RFC 8032 §7.1 TEST 1. The P-256 signature uses RFC 6979.
fn cert_old() -> Bytes {
    option.unwrap(std.hex.decode(b""))
}


fn l62_point_path_fixture() -> Result[(std.page.Slot, Arc[TieredFrame], Arc[TieredFrame]), Error] {
    let mut value: Bytes = list.with_capacity(1025)
    list.fill(mut value, 1025, 106u8)
    let stored_ref = std.page.BlobRef(stamp: 39, len: 1025, checksum: 0x8234157262b2bd3d, pack: 7, offset: 72, body: 0)
    let mut rows: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut rows, std.page.Entry(key: key_word(42), cell: BlobValue(stored_ref)))
    let leaf_image = page_result(std.page.encode(rows, 0, 40, Collection))?
    let digest = std.check.xxh3(std.page.payload(leaf_image), 0, 79)
    let ptr = std.page.PagePtr(pack: 8, offset: 72, len: 79, checksum: digest, stamp: 40)
    let leaf = page_result(std.page.attach_cold(take leaf_image))?
    let mut branches: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut branches, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: ptr, rows: 1, charge: 1110))))
    let parent = page_result(std.page.encode(branches, 1, 41, Collection))?
    let root = page_result(std.page.attach_cold(take parent))?
    let page_frame = TieredFrame(identity: tiered_frame_id(TieredPage(ptr)), payload: TieredImage(take leaf))
    let blob_frame = TieredFrame(identity: tiered_frame_id(TieredBlob(stored_ref)), payload: TieredValue(arc.new(take value)))
    Ok((HotPage(take root), arc.new(take page_frame), arc.new(take blob_frame)))
}

@test
fn test_l62_tiered_point_path() -> Result[(), Error] {
    // Hot parent: 80 + 16. Cold leaf: 79 + 16. BLOB: 1025 + 8 + 16.
    let (take root, take leaf, take cached_blob) = l62_point_path_fixture()?
    let key = key_word(42)
    let mut visible: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    let mut first = capacity(tiered_touch_set(1240, 1))?
    let Error(Missed) = tiered_point_path(mut first, visible, root, None, key) else {
        fail("L62: an unpinned leaf did not miss")
    }
    let Some(AttemptMiss(TieredPage(ptr))) = first.stopped else {
        fail("L62: the first miss did not name a PAGE")
    }
    if ptr.stamp != 40 || first.touched_bytes != 191 {
        fail("L62: point lookup did not count the Hot parent before the Cold leaf")
    }
    map.insert(mut visible, tiered_cache_key(leaf.identity), take leaf)
    let mut second = capacity(tiered_touch_set(1240, 1))?
    let Error(Missed) = tiered_point_path(mut second, visible, root, None, key) else {
        fail("L62: an unpinned body did not miss")
    }
    let Some(AttemptMiss(TieredBlob(reference))) = second.stopped else {
        fail("L62: the second miss did not name a BLOB")
    }
    if reference.stamp != 39 || second.touched_bytes != 1240 {
        fail("L62: point lookup did not count the full BLOB frame")
    }
    map.insert(mut visible, tiered_cache_key(cached_blob.identity), take cached_blob)
    let mut admitted = capacity(tiered_touch_set(1240, 1))?
    let Some(value) = tiered_point_path(mut admitted, visible, root, None, key)? else {
        fail("L62: an admitted pinned row was not read")
    }
    if list.len(value) != 1025 || value[1024u64] != 106 || admitted.touched_bytes != 1240 || list.len(admitted.frames) != 2 {
        fail("L62: pin-only lookup did not return the selected BLOB")
    }
    let mut refused = capacity(tiered_touch_set(1239, 1))?
    let Error(Missed) = tiered_point_path(mut refused, visible, root, None, key) else {
        fail("L62: a warm pin bypassed the physical limit")
    }
    let Some(AttemptPinLimit(problem)) = refused.stopped else {
        fail("L62: the limit did not take precedence over the pin hit")
    }
    if problem.requested != 1240 || problem.available != 1239 {
        fail("L62: invalid capacity for the selected path")
    }
    Ok(())
}

fn l62_deliver_branch(requests: Sender[TieredPagerMessage], target: std.page.PagePtr, leaf: std.page.PagePtr) -> Result[(), Error] waits {
    let mut packs: std.omap.OMap[u64, TieredPagerPack] = std.omap.new()
    let mut ids = 0u64
    for ptr in[target, leaf] {
        let width: u64 = int.widen(ptr.len)
        let inventory = PagePack(class: 3, frames: 1, live: width, payload_bytes: 116 + width, index: 88 + width)
        let (take next_packs, _) = std.omap.insert(mut ids, packs, ptr.pack, TieredPagerPack(inventory: inventory, object: None))
        packs = take next_packs
    }
    let demand = TieredPointDemand(target: TieredPage(target), key: key_word(42), packs: take packs, next_stamp: 51, deadline: 0)
    let path = tiered_point_delivery(requests, take demand)?
    if list.len(path) != 2 || path[0u64].identity.stamp != 50 || path[1u64].identity.stamp != 49 {
        fail("L62: point batch must deliver the parent and selected leaf in order")
    }
    let TieredImage(selected) = view path[1u64].payload else {
        fail("L62: point batch returned a BLOB for its leaf")
    }
    let Some(raw) = std.page.lookup(selected, key_word(42)) else {
        fail("L62: point batch delivered a leaf for the wrong key")
    }
    if list.len(raw) != 1 || raw[0u64] != 106 {
        fail("L62: point batch did not carry the selected leaf's value")
    }
    Ok(())
}

@test
fn test_l62_pager_point_batch(d: Dir, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let owner = StoreId(hi: 3, lo: 4)
    let mut rows: List[std.page.Entry] = list.with_capacity(1)
    let mut value: Bytes = list.with_capacity(1)
    list.push(mut value, 106u8)
    list.push(mut rows, std.page.Entry(key: key_word(42), cell: InlineValue(take value)))
    let leaf_image = page_result(std.page.encode(rows, 0, 49, Collection))?
    let leaf = l68_write_page_pack(fixtures, owner, 8, 49, std.page.payload(leaf_image))?
    // The left child is deliberately not in the inventory. The key path
    // only reaches the right child, so it must never request the left.
    let left = std.page.PagePtr(pack: 7, offset: 72, len: 40, checksum: 11, stamp: 48)
    let mut branches: List[std.page.Entry] = list.with_capacity(2)
    list.push(mut branches, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: left, rows: 1, charge: 86))))
    list.push(mut branches, std.page.Entry(key: key_word(42), cell: Child(std.page.Branch(child: leaf, rows: 1, charge: 86))))
    let branch_image = page_result(std.page.encode(branches, 1, 50, Collection))?
    let root = l68_write_page_pack(fixtures, owner, 9, 50, std.page.payload(branch_image))?
    let (requests, take worker) = start_tiered_pager(tasks, owner, 0, PagerDirectory(fixtures), 4096, 1048576, 4)
    let delivered = l62_deliver_branch(requests, root, leaf)
    let _ = take requests
    let _ = result.unwrap(task.join(take worker))
    delivered
}

fn l62_grant_cache_frames(owner: StoreId, retain_all: bool) -> Result[(), Error] {
    let mut cache_state = new_tiered_cache(96 * 1048576)
    let original = tiered_cache_reserve_reader(mut cache_state, TieredReaderGrant(store: owner, opened: 1, pin_bytes: 32 * 1048576))?
    let mut held: List[Arc[TieredFrame]] = list.with_capacity(7)
    for slot in 0u64 .. 7 {
        let value_len = 8 * 1048576u64 - 24
        let mut stored: Bytes = list.with_capacity(value_len)
        list.fill(mut stored, value_len, 106u8)
        let reference = std.page.BlobRef(stamp: slot + 1, len: value_len, checksum: 0, pack: slot + 1, offset: 72, body: 0)
        let frame = arc.new(TieredFrame(identity: tiered_frame_id(TieredBlob(reference)), payload: TieredValue(arc.new(take stored))))
        if slot == 0 || retain_all {
            list.push(mut held, arc.share(frame))
        }
        tiered_cache_admit(mut cache_state, frame)
    }
    if !capacity(tiered_cache_evict(mut cache_state))? || cache_state.cached_bytes != 48 * 1048576 || cache_state.overlap_bytes != 8 * 1048576 {
        fail("L62: expected 48 MiB cached and 8 MiB of overlap")
    }
    let admission = tiered_cache_reserve_reader(mut cache_state, TieredReaderGrant(store: owner, opened: 1, pin_bytes: 24 * 1048576))
    if retain_all {
        let Error(Full(Cache(problem))) = take admission else {
            fail("L62: overlap must leave the grant too little room")
        }
        if problem.requested != 24 * 1048576 || problem.available != 8 * 1048576 || cache_state.reader_reserved != 32 * 1048576 {
            fail("L62: refusal did not report the reclaimable shared room")
        }
    } else {
        let added = admission?
        if added.pin_bytes != 24 * 1048576 || cache_state.cached_bytes != 32 * 1048576 || cache_state.reader_reserved != 56 * 1048576 || cache_state.overlap_bytes != 8 * 1048576 {
            fail("L62: a 24 MiB grant must evict exactly 16 MiB")
        }
    }
    let _ = take original
    let _ = take held
    Ok(())
}

fn l62_reader_grants(db: Db) -> Result[(), Error] waits {
    let Error(Missing(field)) = reader(db, 0) else {
        fail("L62: Tiered Readers must request at least a blob and a path")
    }
    if field != "pin_bytes" {
        fail("L62: wrong field for a short Reader reservation")
    }
    {
        let held = reader(db, 32 * 1048576)?
        let Some(grant) = view held.grant else {
            fail("L62: Reader must own its reservation")
        }
        if !same(grant.store, db.store) || grant.opened != open_number(db) || grant.pin_bytes != 32 * 1048576 {
            fail("L62: grant does not belong to this open")
        }
        let Error(Full(Cache(problem))) = reader(db, 24 * 1048576) else {
            fail("L62: another Reader charged the writer's partition")
        }
        if problem.requested != 24 * 1048576 || problem.available != 0 {
            fail("L62: a live reservation did not consume all shared room")
        }
    }
    // The marker for an abandoned reply must also be reclaimable.
    let (answer, abandoned): (Sender[Result[Arc[TieredReaderGrant], Error]], Receiver[Result[Arc[TieredReaderGrant], Error]]) = channel.new(1)
    let _ = take abandoned
    let Some(requests) = view db.pager else {
        fail("L62: fixture pager is missing")
    }
    channel.send(requests, PagerReserve(32 * 1048576, take answer)) ?=> |_| Io(Closed)
    let _ = reader(db, 32 * 1048576)?
    Ok(())
}

@test
fn test_l62_reader_reservation(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = test_db(c, 2147483648)
    {
        let memory_reader = reader(db, 0)?
        if let Some(_) = view memory_reader.grant {
            fail("L62: a Memory open reserved shared bytes")
        }
    }
    l62_grant_cache_frames(db.store, false)?
    l62_grant_cache_frames(db.store, true)?
    let (take requests, take worker) = start_tiered_pager(tasks, db.store, open_number(db), PagerDirectory(d), 32 * 1048576, 1048576, 4)
    db.pager = Some(take requests)
    let admitted = l62_reader_grants(db)
    let _ = take db
    let _ = result.unwrap(task.join(take worker))
    admitted
}

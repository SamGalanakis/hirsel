// test-vectors
// SV11. Each oracle is the pinned Wycheproof result or the NIST SigVer result.
// A nonzero return identifies the first mismatched case or record.
// expect: run sv11_p1363() = 0
fn sv11_p1363() -> u64 {
    check_p384(wycheproof_fixed(), false)
}

// expect: run sv11_der() = 0
fn sv11_der() -> u64 {
    check_p384(wycheproof_der(), true)
}

// expect: run sv11_nist() = 0
fn sv11_nist() -> u64 {
    check_p384(nist_sigver(), false)
}

fn check_p384(records: Bytes, der: bool) -> u64 {
    let len = list.len(records)
    let mut at = 0u64
    while at < len {
        let id: u64 = list.word_le(records, at)
        let verdict: u64 = list.word_le(records, at + 8)
        let key_at = at + 40
        let msg_at = key_at + list.word_le(records, at + 16)
        let sig_at = msg_at + list.word_le(records, at + 24)
        let end = sig_at + list.word_le(records, at + 32)
        let key = list.slice(records, key_at, msg_at)
        let msg = list.slice(records, msg_at, sig_at)
        let sig = list.slice(records, sig_at, end)
        let observed = if der {
            p384.verify_der(key, msg, sig)
        } else {
            p384.verify(key, msg, sig)
        }
        if observed != (verdict == 1) {
            return id
        }
        at = end
    }
    0
}

// SV12. The full SV11 walks cover the named high-S, range and DER cases.
// These mutations exercise the SEC 1 key form and P1363 length rules.
// expect: run sv12_fixed_forms() = true
fn sv12_fixed_forms() -> bool {
    let (key, msg, sig) = fixed_tc1()
    let (compressed, bare, short_sig) = fixed_tc1_short_forms()
    p384.verify(key, msg, sig) && !p384.verify(compressed, msg, sig) && !p384.verify(bare, msg, sig) && !p384.verify(key, msg, short_sig)
}

// SV17. One step and zero bytes suffice for Wycheproof P1363 tcId 1.
// expect: reference run sv17_fixed_charge() = true
fn sv17_fixed_charge() -> bool {
    let (key, msg, sig) = fixed_tc1()
    let work = bound bytes 0 {
        bound steps 1 {
            p384.verify(key, msg, sig)
        }
    }
    match work {
        Ok(Ok(true)) => true,
        _ => false,
    }
}

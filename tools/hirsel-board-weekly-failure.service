[Unit]
Description=Publish a weekly Hirsel board qualification alert

[Service]
Type=oneshot
# The board can fail before it switches its checkout.
ExecStart=/bin/bash -o pipefail -c '/usr/bin/git -C "$$1" show refs/remotes/origin/main:tools/board-freshness.py | /usr/bin/python3 - "$${@:2}"' _ %h/.local/share/hirsel-board/main --base %h/.local/share/hirsel-board --service-failure-tier weekly

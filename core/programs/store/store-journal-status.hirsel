type JournalAck: send = Journaled(u64, u64) | Broken(IoError) | ObjectAck(object_writer.ObjectAck)

type Backend = DirBackend(journal.DirJournalState) | ObjectBackend(object_writer.ObjectWriterState)

fn dir_state(state: DiskState) -> View[journal.DirJournalState] in state {
    match state.backend {
        DirBackend(directory) => view directory,
        ObjectBackend(_) => fail("store: a Directory journal is required"),
    }
}

fn object_sender(state: DiskState) -> View[Sender[object_writer.JournalMsg]] in state {
    match state.backend {
        ObjectBackend(queue) => object_writer.sender(queue),
        DirBackend(_) => fail("store: an Object journal is required"),
    }
}

fn disk_directory(state: DiskState) -> Option[Dir] {
    match state.backend {
        DirBackend(directory) => Some(journal.directory(directory)),
        ObjectBackend(_) => None,
    }
}

fn file_seq(db: Db) -> u64 {
    match db.disk {
        Some(state) => match state.backend {
            DirBackend(directory) => journal.segment_seq(directory),
            ObjectBackend(queue) => object_writer.segment_seq(queue),
        },
        None => 1,
    }
}

fn file_end(db: Db) -> u64 {
    match db.disk {
        Some(state) => match state.backend {
            DirBackend(directory) => journal.segment_end(directory),
            ObjectBackend(queue) => object_writer.segment_end(queue),
        },
        None => 72,
    }
}

fn advance_frame_offset(mut state: DiskState, size: u64) {
    match state.backend {
        DirBackend(mut directory) => journal.advance_offset(mut directory, size),
        ObjectBackend(mut queue) => object_writer.advance_offset(mut queue, size),
    }
}

fn queue_accounting(state: DiskState) -> View[journal.QueueAccounting] in state {
    match state.backend {
        DirBackend(directory) => journal.dir_accounting(directory),
        ObjectBackend(queue) => object_writer.queue_accounting(queue),
    }
}

fn edit_accounting[R](mut state: DiskState, edit: scoped fn(mut journal.QueueAccounting) -> R) -> R {
    match state.backend {
        DirBackend(mut directory) => journal.edit_accounting(mut directory, edit),
        ObjectBackend(mut queue) => object_writer.edit_accounting(mut queue, edit),
    }
}

fn journal_barrier(state: DiskState) waits {
    match state.backend {
        DirBackend(directory) => {
            let _ = journal.submit_group(directory, true)
            let _ = channel.send(journal.dir_sender(directory), Barrier)
        },
        ObjectBackend(writer) => {
            let _ = channel.send(object_writer.sender(writer), Barrier)
        },
    }
}

fn journal_written(state: DiskState) -> View[Receiver[journal.WriteNotice]] in state {
    match state.backend {
        DirBackend(directory) => journal.dir_written(directory),
        ObjectBackend(queue) => object_writer.write_notices(queue),
    }
}

fn journal_written_send(state: DiskState) -> View[Sender[journal.WriteNotice]] in state {
    match state.backend {
        DirBackend(directory) => journal.dir_written_send(directory),
        ObjectBackend(queue) => object_writer.write_notice_sender(queue),
    }
}

fn dir_ack(ack: journal.DirAck) -> JournalAck {
    match ack {
        DirJournaled(seq, written) => Journaled(seq, written),
        DirBroken(e) => Broken(e),
    }
}

fn try_journal_receive(state: DiskState) -> Result[JournalAck, ReceiveError] {
    match state.backend {
        DirBackend(directory) => match channel.try_receive(journal.dir_acks(directory)) {
            Ok(ack) => Ok(dir_ack(ack)),
            Error(e) => Error(e),
        },
        ObjectBackend(queue) => match channel.try_receive(object_writer.ack_receiver(queue)) {
            Ok(take ack) => Ok(ObjectAck(take ack)),
            Error(e) => Error(e),
        },
    }
}

// Under §12.11.10 ("Tickets at the latch"), every outstanding ticket of an
// attached Db ends `Undecided` when its stream latches (even under Superseded).
fn durable_latch_error(take e: Error) -> Error {
    match take e {
        Latched(_) => Undecided,
        other => other,
    }
}

// A writer that ended without its ack (cancelled before it could send
// Broken) is a terminal failure: the place stops, unacked sequences unanswered.
fn journal_receive(db: Db) -> JournalAck waits {
    match disk_state(db).backend {
        DirBackend(directory) => match channel.receive(journal.dir_acks(directory)) {
            Ok(ack) => dir_ack(ack),
            Error(_) => Broken(Closed),
        },
        ObjectBackend(queue) => match channel.receive(object_writer.ack_receiver(queue)) {
            Ok(take ack) => ObjectAck(take ack),
            Error(_) => Broken(Closed),
        },
    }
}

pub fn manage_journal_groups(mut db: Db) -> Option[u64] {
    if let Some(mut state) = db.disk {
        if let DirBackend(mut directory) = state.backend {
            journal.manage_groups(mut directory)
            return Some(int.widen(state.options.group_commits))
        }
    }
    None
}

fn failed_handoff(mut db: Db) -> Result[(), Error] {
    // A Directory worker publishes its first I/O failure before dropping
    // either the command receiver or the buffer return sender.
    journal_poll(mut db)?
    journal_ack(mut db, Broken(Closed))
}

pub fn submit_journal_group(mut db: Db, wait: bool) -> Result[(), Error] waits {
    let closed = match db.disk {
        Some(state) => match state.backend {
            DirBackend(directory) => match journal.submit_group(directory, wait) {
                Ok(()) => false,
                Error(_) => true
            },
            ObjectBackend(_) => false,
        },
        None => false,
    }
    if closed {
        return failed_handoff(mut db)
    }
    Ok(())
}

fn wait_for_frame_room(mut db: Db, frame: Option[format.DraftFrame]) -> Result[(), Error] waits {
    if let Some(raw) = frame {
        let size = format.frame_length(raw)
        while queue_accounting(disk_state(db)).inflight > db.limits.frame - size {
            let closed = match disk_state(db).backend {
                DirBackend(directory) => {
                    let keep = match raw {
                        InGroup(n) => n,
                        Detached(_) => 0u64
                    }
                    match journal.seal_group_keep(journal.draft_group(directory), journal.dir_sender(directory), true, keep) {
                        Ok(()) => false,
                        Error(_) => true,
                    }
                },
                ObjectBackend(_) => false,
            }
            if closed {
                return failed_handoff(mut db)
            }
            let acknowledged = journal_receive(db)
            journal_ack(mut db, take acknowledged)?
        }
    }
    Ok(())
}

// The worker sends one Journaled ack after each successful group sync.
fn durable_groups(mut db: Db, t: Ticket) -> Result[u64, Error] waits {
    if !types.same(db.store.hi, db.store.lo, t.store.hi, t.store.lo) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(0)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(0)
        }
    }
    let drained = poll_ticket(mut db, t.mark)
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(match drained {
            Ok(groups) => groups,
            Error(_) => 0u64
        })
    }
    let mut groups = drained ?=> durable_latch_error
    if is_disk(db) {
        while !covered(db, t.mark) {
            submit_journal_group(mut db, true)?
            let ack = journal_receive(db)
            journal_ack(mut db, take ack) ?=> durable_latch_error
            groups += 1
        }
    }
    Ok(groups)
}

fn journal_ack(mut db: Db, take ack: JournalAck) -> Result[(), Error] {
    write_disk(mut db.disk, take ack, scoped fn(mut state: DiskState, take incoming: JournalAck) -> Result[(), Error] {
        match take incoming {
            Journaled(n, bytes_out) => {
                edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) {
                    queue.journaled = n
                    queue.inflight -= bytes_out - queue.acked_bytes
                    queue.acked_bytes = bytes_out
                })
                Ok(())
            },
            ObjectAck(ObjectJournaled(n, bytes_out, journal_entries)) => {
                if let ObjectBackend(mut writer) = state.backend {
                    object_writer.note_ack(mut writer, n, bytes_out, journal_entries)
                }
                Ok(())
            },
            ObjectAck(ObjectBroken(take reported)) => {
                if let ObjectBackend(mut writer) = state.backend {
                    object_writer.latch_failure(mut writer, clone(reported))
                }
                Error(failure_from_rep(take reported))
            },
            Broken(e) => {
                edit_accounting(mut state, scoped fn(mut queue: journal.QueueAccounting) -> Result[(), Error] {
                    if let None = queue.poison {
                        queue.poison = Some(e)
                    }
                    Error(Poisoned(option.unwrap(queue.poison)))
                })
            },
        }
    })
}

fn poll_ticket(mut db: Db, mark: Mark) -> Result[u64, Error] {
    if object_writer_open(db) {
        return journal_poll_groups(mut db)
    }
    let mut groups = 0u64
    while !covered(db, mark) {
        let Some(take ack) = close_ack(db) else {
            break
        }
        journal_ack(mut db, take ack)?
        groups += 1
    }
    Ok(groups)
}

fn journal_poll(mut db: Db) -> Result[(), Error] {
    let _ = journal_poll_groups(mut db)?
    Ok(())
}

fn journal_poll_groups(mut db: Db) -> Result[u64, Error] {
    let mut groups = 0u64
    while let Some(take ack) = close_ack(db) {
        journal_ack(mut db, take ack)?
        groups += 1
    }
    healthy(db)?
    Ok(groups)
}

fn open_directory(tasks: Tasks, d: Dir, c: Clock, r: Random, options: Options, cadence_spec: journal.JournalCadence) -> Result[Db, Error] waits {
    if let Bucket(_) = options.authority {
        return Error(Unsupported(1))
    }
    failure_result_from_rep(object_writer.open_checks(options.group_commits, options.group_bytes, optional_limits_to_rep(options.limits), options.checkpoint_bytes, options.journal_limit))?
    let session = disk_session(d, c, r, options)?
    open_started(tasks, d, c, options, cadence_spec, take session)
}

fn journal_poison(db: Db) -> Option[IoError] {
    match db.disk {
        Some(state) => queue_accounting(state).poison,
        None => None,
    }
}

fn drain_close_journal(mut db: Db) -> Result[(), Error] waits {
    if let Some(_) = journal_poison(db) {
        return Ok(())
    }
    let last_frame = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    durable(mut db, last_frame)
}

pub fn close(take db: Db) -> Result[(), Error] waits {
    let mut owned = take db
    if !is_disk(owned) {
        return Ok(())
    }
    stop_archiver(mut owned)
    let mut failure: Option[Error] = None
    if let Error(take e) = drain_close_journal(mut owned) {
        failure = Some(take e)
    }
    if let None = failure {
        let (attached, has_sealed) = match owned.disk {
            Some(state) => match state.backend {
                ObjectBackend(writer) => object_writer.attachment(writer),
                DirBackend(_) => (false, false),
            },
            None => (false, false),
        }
        if attached {
            let settled = if has_sealed {
                object_cut_close(mut owned)
            } else {
                object_stream_close(mut owned)
            }
            if let Error(take e) = settled {
                failure = Some(take e)
            }
        }
    }
    teardown_hook(owned)
    let connection = replace(mut owned.disk, None)
    pages.release_heads(mut owned.holders)
    list.clear(mut owned.followers)
    let DiskState(backend: take backend, tiered: take tiered, ..) = option.unwrap(take connection)
    // A Reader may still hold the pager's requests, so the pager is cancelled
    // rather than waited for once the store's sender is dropped.
    clear_parked(mut owned)
    pager.close_requests(mut owned.pager)
    let mut closing_tiered = take tiered
    let pager_task = pager.take_worker(mut closing_tiered)
    if let Some(take running) = take pager_task {
        let mut pager_link = take running
        task.cancel(mut pager_link)
        let _ = task.join(take pager_link)
    }
    let prior: Option[types.Failure] = match take failure {
        Some(take e) => Some(failure_to_rep(take e)),
        None => None,
    }
    match take backend {
        ObjectBackend(take writer) => failure_result_from_rep(object_writer.close_worker(take writer, take prior)),
        DirBackend(take directory) => failure_result_from_rep(journal.close_directory(take directory, take prior)),
    }
}

fn close_ack(db: Db) -> Option[JournalAck] {
    let Some(state) = view db.disk else {
        return None
    }
    match try_journal_receive(state) {
        Ok(ack) => Some(ack),
        Error(_) => None,
    }
}

/// `durable` without waiting: whether t's commit is synced now. A journal that ended
/// without an ack is terminal, as in journal_receive.
pub fn durable_now(mut db: Db, t: Ticket) -> Result[bool, Error] {
    if !types.same(db.store.hi, db.store.lo, t.store.hi, t.store.lo) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(true)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(true)
        }
    }
    let drained = poll_ticket(mut db, t.mark)
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(true)
    }
    let _ = drained ?=> durable_latch_error
    if covered(db, t.mark) {
        return Ok(true)
    }
    let pending = match db.disk {
        Some(state) => try_journal_receive(state),
        None => return Ok(true)
    }
    match take pending {
        Ok(take ack) => journal_ack(mut db, take ack) ?=> durable_latch_error,
        Error(Empty) => {},
        Error(Closed) => journal_ack(mut db, Broken(Closed))?,
    }
    Ok(covered(db, t.mark))
}

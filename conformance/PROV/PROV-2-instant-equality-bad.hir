// rule: PROV-2
// expect: reject PROV-2 at line 9
// twin: PROV/PROV-2-instant-same-clock-ok.hir
// Instants are equal only within one clock's domain (SEM-5); two clocks'
// instants have no `==`.
fn example(c: MonotonicClock, d: MonotonicClock) -> Result[bool, ClockError] {
  let start = clock.monotonic(c)?
  let other = clock.monotonic(d)?
  Ok(start == other)
}

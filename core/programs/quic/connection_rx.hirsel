type FrameEffect = Quiet | ElicitsAck | PeerClose(CloseReason) | Lost(DropReason)

fn received_number(c: Connection, level: packet.Space, n: u64) -> bool {
    match level {
        Initial => n < c.initial.discard_before || covers(c.initial.received, n, n),
        Handshake => n < c.encrypted.discard_before || covers(c.encrypted.received, n, n),
        _ => n < c.application.discard_before || covers(c.application.received, n, n),
    }
}

fn note_receive(mut c: Connection, now: u64, level: packet.Space, number: u64, ack: bool, ecn: u8) {
    match level {
        Initial => note_in_space(mut c.initial, now, number, ack, ecn),
        Handshake => note_in_space(mut c.encrypted, now, number, ack, ecn),
        _ => note_in_space(mut c.application, now, number, ack, ecn),
    }
}

fn note_in_space(mut s: Space, now: u64, number: u64, ack: bool, ecn: u8) {
    if let None = s.receive {
        return
    }
    let newest = match s.largest {
        None => true,
        Some(previous) => number > previous,
    }
    if newest {
        s.largest = Some(number)
        s.largest_at = now
    }
    // RFC 9000 §13.4.1: count each packet's IP ECN codepoint for ACK_ECN.
    match ecn & 3 {
        1 => {
            s.ecn_in.ect1 += 1
        },
        2 => {
            s.ecn_in.ect0 += 1
        },
        3 => {
            s.ecn_in.ce += 1
        },
        _ => (),
    }
    record_received(mut s, number)
    s.ack_pending = s.ack_pending || ack
}

fn crypto_frame(mut c: Connection, level: packet.Space, offset: u64, data: Bytes) -> bool {
    match level {
        Initial => receive_crypto(mut c.initial.crypto_in, offset, data),
        Handshake => receive_crypto(mut c.encrypted.crypto_in, offset, data),
        _ => receive_crypto(mut c.application.crypto_in, offset, data),
    }
}

fn check_ack(c: Connection, level: packet.Space, ranges: List[codec.AckRange]) -> bool {
    match level {
        Initial => valid_ack(c.initial, ranges),
        Handshake => valid_ack(c.encrypted, ranges),
        _ => valid_ack(c.application, ranges),
    }
}

/// RFC 9000 §19.3: ACK Delay in units of 2^ack_delay_exponent microseconds, the
/// exponent the ACK's sender advertised (3 until its parameters arrive).
fn ack_delay_ns(c: Connection, field: u64) -> u64 {
    let exponent = match c.params {
        Some(p) => p.ack_delay_exponent,
        None => 3,
    }
    if exponent >= 64 || field > (0xffffffffffffffffu64 >> exponent) {
        return 0xffffffffffffffff
    }
    int.saturating_mul(field << exponent, 1000)
}

fn apply_frame(mut c: Connection, now: u64, kind: codec.PacketKind, f: codec.Frame, input: Bytes, ack_ranges: List[codec.AckRange], mut acked: List[u64], mut lost: List[u64], mut events: List[Event]) -> Result[FrameEffect, ConnectionFailure] {
    let level = packet_level(kind)
    match f {
        Padding(_) => Ok(Quiet),
        Ack(a) => {
            if !check_ack(c, level, ack_ranges) {
                let frame = if a.ecn == None {
                    0x02u64
                } else {
                    0x03u64
                }
                return Error(Wire(0x0a, frame))
            }
            let index = space_index(level)
            if let Application = level {
                note_phase_ack(mut c.keys, ack_ranges)
            }
            recovery.on_ack_into(mut c.recovery, now, index, ack_ranges, ack_delay_ns(c, a.delay), a.ecn, mut acked, mut lost)
            settle(mut c, now, index, acked, lost, mut events)
            if let Application = level {
                if let Client = c.side {
                    // RFC 9001 §4.1.2: a client also confirms the handshake when any
                    // 1-RTT packet it sent is acknowledged.
                    if !recovery.confirmed(c.recovery) {
                        confirm(mut c, now)
                    }
                }
            }
            Ok(Quiet)
        },
        Crypto(offset: offset, data: data) => {
            if !crypto_frame(mut c, level, offset, list.slice(input, data.at, data.at + data.len)) {
                return Error(Wire(0x0d, 0x06))
            }
            Ok(ElicitsAck)
        },
        TransportClose(code: code, frame_type: frame, ..) => Ok(PeerClose(Transport(code: code, frame: frame))),
        ApplicationClose(code: code, ..) => Ok(PeerClose(Application(code: code))),
        NewToken(_) => {
            // RFC 9000 §19.7: only a server sends NEW_TOKEN. A client has no way yet to
            // present a kept token on a later connection, so it acknowledges and drops it.
            if let Server = c.side {
                return Error(Wire(0x0a, 0x07))
            }
            Ok(ElicitsAck)
        },
        PathChallenge(data) => {
            path_challenge(mut c, list.slice(input, data.at, data.at + data.len))
            Ok(ElicitsAck)
        },
        PathResponse(data) => {
            path_response(mut c, list.slice(input, data.at, data.at + data.len))
            Ok(ElicitsAck)
        },
        NewConnectionId(sequence: seq, retire_prior_to: prior, id: id, reset_token: token) => {
            new_connection_id(mut c, seq, prior, list.slice(input, id.at, id.at + id.len), list.slice(input, token.at, token.at + token.len))?
            Ok(ElicitsAck)
        },
        RetireConnectionId(seq) => {
            retire_connection_id(mut c.streams.cids, seq)?
            Ok(ElicitsAck)
        },
        HandshakeDone => {
            if let Server = c.side {
                return Error(Wire(0x0a, 0x1e))
            }
            confirm(mut c, now)
            Ok(ElicitsAck)
        },
        _ => match stream_frame(mut c.streams, c.handle, f, input, mut events)? {
            Some(reason) => Ok(Lost(reason)),
            None => Ok(ElicitsAck),
        },
    }
}

fn codec_failure(e: codec.CodecError) -> ConnectionFailure {
    match e {
        FrameEncodingError(t) => Wire(0x07, t),
        ProtocolViolation(t) => Wire(0x0a, t),
        _ => Wire(0x01, 0),
    }
}

fn apply_packet(mut c: Connection, now: u64, kind: codec.PacketKind, input: Bytes, opened: OpenedPacket, random: Random, mtu: u16, ecn: u8, mut events: List[Event]) -> Result[(), ConnectionFailure] {
    let mut ack_ranges = replace(mut c.rx_ack_ranges, list.new())
    let mut acked = replace(mut c.ack_acked, list.new())
    let mut lost = replace(mut c.ack_lost, list.new())
    let outcome = apply_packet_with(mut c, now, kind, input, opened, random, mtu, ecn, mut ack_ranges, mut acked, mut lost, mut events)
    c.rx_ack_ranges = take ack_ranges
    c.ack_acked = take acked
    c.ack_lost = take lost
    outcome
}

fn apply_packet_with(mut c: Connection, now: u64, kind: codec.PacketKind, input: Bytes, opened: OpenedPacket, random: Random, mtu: u16, ecn: u8, mut ack_ranges: List[codec.AckRange], mut acked: List[u64], mut lost: List[u64], mut events: List[Event]) -> Result[(), ConnectionFailure] {
    if let Error(_) = codec.check_reserved_bits(kind, opened.first) {
        return Error(Wire(0x0a, 0))
    }
    let Ok(frame_reader) = codec.frames(input, codec.Span(at: 0, len: list.len(input)), kind, int.widen(c.transport.max_datagram_frame)) else {
        return Error(Wire(0x0a, 0))
    }
    let mut r = take frame_reader
    let mut ack = false
    c.probing_only = true
    while true {
        let f = match codec.next_frame_into(input, mut r, mut ack_ranges) {
            Ok(Some(f)) => f,
            Ok(None) => break,
            Error(e) => return Error(codec_failure(e)),
        }
        c.probing_only = c.probing_only && probing_frame(f)
        match apply_frame(mut c, now, kind, f, input, ack_ranges, mut acked, mut lost, mut events)? {
            Quiet => (),
            ElicitsAck => {
                ack = true
            },
            PeerClose(reason) => {
                start_draining(mut c, now)
                list.push(mut events, Closed(c.handle, reason))
                return Ok(())
            },
            Lost(reason) => return Error(Lost(reason)),
        }
    }
    let level = packet_level(kind)
    drain_tls(mut c, now, random, mtu, level, mut events)?
    note_receive(mut c, now, level, opened.number, ack, ecn)
    if let Some(_) = c.encrypted.send {
        recovery.set_handshake_keys(mut c.recovery, now)
    }
    if kind == Handshake {
        if let Server = c.side {
            // RFC 9001 §4.9.1: a server discards Initial keys when it first
            // processes a Handshake packet. RFC 9000 §8.1: the packet also shows the
            // client received our Initial, so its address is validated.
            drop_space(mut c, recovery.INITIAL, now)
            c.validated = true
        }
    }
    refresh_idle(mut c, now)
    c.idle_rearmed = false
    Ok(())
}

fn open_for_connection(c: Connection, h: codec.Header, mut wire: Bytes, mut plain: Bytes) -> Result[OpenedPacket, DropReason] {
    match h.kind {
        Initial => open_packet(c.initial, c.keys, h, mut wire, mut plain),
        Handshake => open_packet(c.encrypted, c.keys, h, mut wire, mut plain),
        OneRtt => open_packet(c.application, c.keys, h, mut wire, mut plain),
        _ => Error(KeysUnavailable),
    }
}

fn accept_packet(mut c: Connection, now: u64, h: codec.Header, opened: OpenedPacket, wire: Bytes, plain: Bytes, random: Random, mtu: u16, ecn: u8, mut events: List[Event]) -> Result[(), DropReason] {
    if let Closing(mut reply) = c.life {
        reply.pending = true
        reply.max_bytes = h.packet.len
        return Ok(())
    }
    let level = packet_level(h.kind)
    if received_number(c, level, opened.number) {
        return Error(Duplicate)
    }
    if !c.authenticated {
        if h.kind == Initial {
            if let Client = c.side {
                c.peer_id = clone(list.slice(wire, h.source.at, h.source.at + h.source.len))
            }
        }
        c.authenticated = true
    }
    match apply_packet(mut c, now, h.kind, plain, opened, random, mtu, ecn, mut events) {
        Ok(()) => (),
        Error(Wire(code, frame)) => refuse(mut c, now, code, frame, Transport(code: code, frame: frame), mut events),
        Error(Tls(e)) => refuse(mut c, now, handshake.error_code(e), 0, tls_reason(e), mut events),
        Error(Lost(reason)) => return Error(reason),
    }
    Ok(())
}

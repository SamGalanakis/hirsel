// Tx reads of Tiered tables and indexes (§13.3, v2.59 #13: Tx cursors step
// through the attempt; §13.10a D7: each side by its own descriptor). A body's
// range, reverse range, count and index lookup read the rows the Tx sees: its
// own staged puts and deletes over the replay overlay over the Cold tree, for
// every (index, primary) residency pair. A body that writes a Tiered row and
// then ranges a Memory table reads the Memory rows. The expected rows come
// from the fixture's generator and the body's own edits.
fn tx_read_bucket(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, v % 4)
    Ok(take keys)
}

const TX_READ_ROWS: u64 = 600

type TxReadHandles: shareable + send {
    rows: Table[u64, u64],
    ix: Index[u64, u64, u64, ()],
    plain: Table[u64, u64]
}

fn tx_read_handles(mut db: Db, mode: Mode) -> Result[TxReadHandles, Error] waits {
    let mut d = declare(db, mode)?
    let mut declared = declare_table(mut d, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let ix = index(mut d, mut declared, "i", Many, code.describe(tx_read_bucket), std.codec.key_u64())?
    let rows = finish(mut d, take declared)?
    let declared_plain = declare_table(mut d, "plain", std.codec.key_u64(), std.codec.of_u64())?
    let plain = finish(mut d, take declared_plain)?
    let _ = seal(mut db, take d)?
    Ok(TxReadHandles(rows: take rows, ix: take ix, plain: take plain))
}

// A 600-row table with a bucket index. `set_residency` moves the table and
// the index each to its own residency, and the cut emits every Tiered one
// Cold into class-3 packs. The "plain" table stays Memory.
fn tx_read_fixture(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64, rows_tiered: bool, ix_tiered: bool) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let handles = tx_read_handles(mut db, Migrate)?
    let Committed(_) = run(mut db, None, copy_env(handles), fn(mut tx: Tx, env: TxReadHandles) -> Result[(), Error] {
        for key in 0u64 .. TX_READ_ROWS {
            put(mut tx, env.rows, key, key)?
        }
        for key in 0u64 .. 3 {
            put(mut tx, env.plain, key, key + 100)?
        }
        Ok(())
    })? else {
        fail("Tx reads: fixture puts commit")
    }
    for id in[handles.rows.id, handles.ix.id] {
        let Some((root, _)) = std.page.collection_entry(db.heads[0u64].roots.collections.root, prefix(id)?) else {
            fail("Tx reads: the fixture has its table and index")
        }
        if std.page.level(std.page.image_of(root)) == 0 {
            fail("Tx reads: the fixture table and index each span more than one leaf")
        }
    }
    if rows_tiered {
        set_residency(mut db, handles.rows.id, Tiered)?
    }
    if ix_tiered {
        set_residency(mut db, handles.ix.id, Tiered)?
    }
    tx_read_modes(db, handles, rows_tiered, ix_tiered)?
    let _ = checkpoint(mut db)?
    close(take db)
}

fn tx_read_mode(tiered: bool) -> std.page_descriptor.Residency {
    if tiered {
        ResidentTiered
    } else {
        ResidentMemory
    }
}

// Each side keeps the residency the fixture gave it; nothing reclassifies
// it at open (L98 (c)).
fn tx_read_modes(db: Db, handles: TxReadHandles, rows_tiered: bool, ix_tiered: bool) -> Result[(), Error] {
    if residency_mode(db, handles.rows.id)? != (TableCollection, tx_read_mode(rows_tiered)) || residency_mode(db, handles.ix.id)? != (IndexCollection, tx_read_mode(ix_tiered)) || residency_mode(db, handles.plain.id)? != (TableCollection, ResidentMemory) {
        fail("L98 (c): a collection's residency changed without set_residency")
    }
    Ok(())
}

// The value the store holds for `key`. After the edit commit key 7 is
// rewritten to 1007, key 9 deleted and key 2000 added.
fn tx_read_value(key: u64, edited: bool) -> Option[u64] {
    if edited {
        if key == 7 {
            return Some(1007)
        }
        if key == 9 {
            return None
        }
        if key == 2000 {
            return Some(2000)
        }
    }
    if key < TX_READ_ROWS {
        Some(key)
    } else {
        None
    }
}

// Every check returns its number on a mismatch, 0 when all hold.
fn tx_read_check(tx: Tx, env: TxReadHandles, edited: bool) -> Result[u64, Error] {
    let mut forward: List[(u64, u64)] = list.new()
    {
        let mut rows = range(tx, env.rows, Included(5u64), Excluded(12u64))?
        while let Some(row) = next_in(tx, mut rows)? {
            list.push(mut forward, row)
        }
    }
    let mut wanted: List[(u64, u64)] = list.new()
    for key in 5u64 .. 12 {
        if let Some(value) = tx_read_value(key, edited) {
            list.push(mut wanted, (key, value))
        }
    }
    if forward != wanted {
        return Ok(1)
    }
    let mut backward: List[(u64, u64)] = list.new()
    {
        let mut rows = range_reverse(tx, env.rows, Included(5u64), Excluded(12u64))?
        while let Some(row) = next_in(tx, mut rows)? {
            list.push(mut backward, row)
        }
    }
    list.reverse(mut backward)
    if backward != wanted {
        return Ok(2)
    }
    // The whole table, across every leaf, ends with the newest key.
    let mut seen = 0u64
    let mut newest: Option[u64] = None
    {
        let mut rows = range(tx, env.rows, Unbounded, Unbounded)?
        while let Some((key, value)) = next_in(tx, mut rows)? {
            if tx_read_value(key, edited) != Some(value) {
                return Ok(3)
            }
            if let Some(before) = newest {
                if before >= key {
                    return Ok(4)
                }
            }
            newest = Some(key)
            seen += 1
        }
    }
    let final_value = if edited {
        2000u64
    } else {
        TX_READ_ROWS - 1
    }
    if seen != TX_READ_ROWS || newest != Some(final_value) {
        return Ok(5)
    }
    if count(tx, env.rows, Included(5u64), Excluded(12u64))? != list.len(wanted) {
        return Ok(6)
    }
    if count(tx, env.rows, Unbounded, Unbounded)? != TX_READ_ROWS {
        return Ok(7)
    }
    // Bucket 3 holds every key ≡ 3 (mod 4) below 600; key 7's new value
    // 1007 stays in bucket 3. Each primary is read through the attempt.
    let mut in_bucket: List[(u64, u64)] = list.new()
    {
        let mut rows = lookup(tx, env.ix, Included(3u64), Included(3u64))?
        while let Some(row) = next_indexed(mut rows)? {
            list.push(mut in_bucket, row)
        }
    }
    let mut expected_bucket: List[(u64, u64)] = list.new()
    for key in 0u64 .. TX_READ_ROWS {
        if key % 4 == 3 {
            list.push(mut expected_bucket, (key, option.unwrap(tx_read_value(key, edited))))
        }
    }
    if in_bucket != expected_bucket {
        return Ok(8)
    }
    // A Memory table beside the Tiered one.
    let mut plain: List[(u64, u64)] = list.new()
    {
        let mut rows = range(tx, env.plain, Unbounded, Unbounded)?
        while let Some(row) = next_in(tx, mut rows)? {
            list.push(mut plain, row)
        }
    }
    let mut plain_wanted: List[(u64, u64)] = list.new()
    for key in 0u64 .. 3 {
        list.push(mut plain_wanted, (key, key + 100))
    }
    if plain != plain_wanted {
        return Ok(9)
    }
    // Partial iteration: bucket 1 (keys ≡ 1 mod 4; key 9 deleted by the
    // edit) stops after three rows, then the raw entries of bucket 1 stop
    // after two; neither cursor is drained.
    let mut bucket_one: List[(u64, u64)] = list.new()
    for key in 0u64 .. TX_READ_ROWS {
        if key % 4 == 1 {
            if let Some(value) = tx_read_value(key, edited) {
                list.push(mut bucket_one, (key, value))
            }
        }
    }
    {
        let mut rows = lookup(tx, env.ix, Included(1u64), Included(1u64))?
        for i in 0u64 .. 3 {
            if next_indexed(mut rows)? != Some(bucket_one[i]) {
                return Ok(10)
            }
        }
    }
    {
        let mut raw = entries(tx, env.ix, Included(1u64), Included(1u64))?
        for i in 0u64 .. 2 {
            if next_entry(mut raw)? != Some((1u64, bucket_one[i].0, ())) {
                return Ok(11)
            }
        }
    }
    Ok(0)
}

fn tx_read_run(mut db: Db, handles: TxReadHandles) -> Result[(), Error] waits {
    let Committed(done) = run(mut db, Some(10000000), copy_env(handles), fn(mut tx: Tx, env: TxReadHandles) -> Result[u64, Error] {
        tx_read_check(tx, env, true)
    })? else {
        fail("Tx reads: the read call commits")
    }
    if done.value != 0 {
        fail("Tx reads: a committed call reads the rows the store holds")
    }
    Ok(())
}

fn tx_read_look(db: Db, s: Snapshot, handles: TxReadHandles, edited: bool) -> Result[(), Error] waits {
    let read_handle = reader(db, READER_PIN_MIN)?
    let Seen(seen) = look(read_handle, s, Some(10000000), (copy_env(handles), edited), fn(tx: Tx, env: (TxReadHandles, bool)) -> Result[u64, Error] {
        tx_read_check(tx, env.0, env.1)
    })? else {
        fail("Tx reads: the look runs")
    }
    let Ok(0) = view seen.value else {
        fail("Tx reads: a look reads the rows the Snapshot holds")
    }
    drop(take read_handle)
    Ok(())
}

fn tx_read_look_head(db: Db, handles: TxReadHandles) -> Result[(), Error] waits {
    let s = snapshot(db)
    tx_read_look(db, s, handles, true)?
    drop(take s)
    Ok(())
}

// One (index, primary) residency pair through edits staged in the reading
// body, committed edits before a cut, an old Snapshot held over the edit
// commit and over the cut that relocates its pages, a replayed journal over
// the Cold trees, and the folded Cold trees. Every read equals the model, and
// `verify` finds no drift at each root.
fn tx_read_pair(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64, rows_tiered: bool, ix_tiered: bool) -> Result[(), Error] waits {
    tx_read_fixture(d, c, r, tasks, floor, rows_tiered, ix_tiered)?
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let handles = tx_read_handles(mut db, Open)?
    tx_read_modes(db, handles, rows_tiered, ix_tiered)?
    let held = snapshot(db)
    tx_read_look(db, held, handles, false)?
    // The edits are staged in the same body that reads them.
    let edited = match run(mut db, Some(10000000), copy_env(handles), fn(mut tx: Tx, env: TxReadHandles) -> Result[u64, Error] {
        put(mut tx, env.rows, 7u64, 1007u64)?
        let _ = delete(mut tx, env.rows, 9u64)?
        put(mut tx, env.rows, 2000u64, 2000u64)?
        tx_read_check(tx, env, true)
    })? {
        Committed(done) => done,
        Aborted(_) => fail("Tx reads: the edit call commits (aborted)"),
        Failed(Raised(cs)) => {
            for cause in cs {
                if let Fail(text) = cause.kind {
                    fail(clone(text))
                }
            }
            fail("Tx reads: the edit call commits (raised)")
        },
        Failed(_) => fail("Tx reads: the edit call commits (failed)"),
        Refused(_) => fail("Tx reads: the edit call commits (refused)"),
        Stopped(_) => fail("Tx reads: the edit call commits (stopped)"),
    }
    if edited.value != 0 {
        fail("Tx reads: a body reads its own staged edits")
    }
    // The committed edits, before any cut; the old Snapshot is unchanged.
    tx_read_run(mut db, handles)?
    tx_read_look_head(db, handles)?
    tx_read_look(db, held, handles, false)?
    trust_indexes(mut db)?
    close(take db)?
    // The journaled edits reopen as a replay overlay over the Cold trees.
    let mut replayed = open(tasks, d, c, r, l70_open_options(floor)?)?
    let again = tx_read_handles(mut replayed, Open)?
    tx_read_modes(replayed, again, rows_tiered, ix_tiered)?
    tx_read_look_head(replayed, again)?
    trust_indexes(mut replayed)?
    let old = snapshot(replayed)
    let _ = checkpoint(mut replayed)?
    tx_read_run(mut replayed, again)?
    // A Snapshot taken before the fold cut still reads its rows after it.
    tx_read_look(replayed, old, again, true)?
    drop(take old)
    close(take replayed)?
    // After the fold cut, every Tiered row and entry is Cold.
    let mut cold = open(tasks, d, c, r, l70_open_options(floor)?)?
    let folded = tx_read_handles(mut cold, Open)?
    tx_read_modes(cold, folded, rows_tiered, ix_tiered)?
    tx_read_run(mut cold, folded)?
    tx_read_look_head(cold, folded)?
    trust_indexes(mut cold)?
    close(take cold)
}

// L98 (a) and (e): all four (index, primary) residency pairs read the same
// model rows and entries. The oracle is the fixture's generator and the
// body's own edits, independent of either residency.
@test
fn test_l98_index_residency_pairs_read_the_model(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    for pair in 0u64 .. 4 {
        tx_read_pair(disk_test_directory(d), c, r, tasks, floor, pair % 2 == 1, pair >= 2)?
    }
    Ok(())
}

// L98(d) exercises each Memory index cursor at a real step and byte boundary.
fn l98_memory_case(tx: Tx, input: (TxReadHandles, u64, Option[u64])) -> Result[bool, Error] {
    if let Some(grant_bytes) = input.2 {
        return capacity(bound bytes grant_bytes {
            l98_memory_read(tx, input.0, input.1)
        })?
    }
    l98_memory_read(tx, input.0, input.1)
}

fn l98_memory_read(tx: Tx, handles: TxReadHandles, which: u64) -> Result[bool, Error] {
    if which >= 4 {
        let mut rows = entries(tx, handles.ix, Unbounded, Unbounded)?
        if next_entry(mut rows)? != Some((1u64, 1u64, ())) {
            return Ok(false)
        }
        return Ok(which == 4 || (next_entry(mut rows)? == Some((1u64, 5u64, ())) && next_entry(mut rows)? == None))
    }
    let mut rows = match which {
        0 => lookup(tx, handles.ix, Included(2u64), Included(1u64))?,
        1 => lookup(tx, handles.ix, Included(1u64), Included(1u64))?,
        2 => lookup(tx, handles.ix, Included(2u64), Included(2u64))?,
        _ => lookup_prefix(tx, handles.ix, 1u64, std.codec.key_u64())?,
    }
    let first = next_indexed(mut rows)?
    Ok(if which == 0 || which == 2 {
        first == None
    } else {
        first == Some((1u64, 1u64))
    })
}

fn l98_threshold(r: Reader, s: Snapshot, handles: TxReadHandles, which: u64, grant_bytes: bool) -> Result[u64, Error] waits {
    let mut lo = 0u64
    let mut hi = if grant_bytes {
        65536u64
    } else {
        10000u64
    }
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let steps = if grant_bytes {
            10000u64
        } else {
            mid
        }
        let grant = if grant_bytes {
            Some(mid)
        } else {
            None
        }
        match look(r, s, Some(steps), (copy_env(handles), which, grant), l98_memory_case)? {
            Seen(Seen(value: Ok(true), ..)) => {
                hi = mid
            },
            Stopped(_, _) => {
                lo = mid + 1
            },
            Refused(_, _) => {
                lo = mid + 1
            },
            Seen(Seen(value: Error(Full(Allocation(_))), ..)) => {
                lo = mid + 1
            },
            _ => fail("L98(d): Memory index returned a row or error outside the model"),
        }
    }
    Ok(lo)
}

@test
fn test_l98_memory_index_cost(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(182375272)?)?
    let handles = tx_read_handles(mut db, Migrate)?
    let Committed(_) = run(mut db, None, copy_env(handles.rows), fn(mut tx: Tx, t: Table[u64, u64]) -> Result[(), Error] {
        put(mut tx, t, 1u64, 1u64)?
        put(mut tx, t, 5u64, 5u64)
    })? else {
        fail("L98(d): fixture writes must commit")
    }
    // Parent thresholds, in order: empty, hit, miss, prefix, partial, exhausted.
    let before_memory: Inline[u64, 6] =[187, 506, 283, 566, 294, 382]
    let before_mixed: Inline[u64, 6] =[191, 580, 287, 640, 294, 382]
    let before_bytes: Inline[u64, 6] =[64, 568, 432, 568, 424, 472]
    for mixed in[false, true] {
        if mixed {
            set_residency(mut db, handles.plain.id, Tiered)?
        }
        let snap = snapshot(db)
        let reading = reader(db, READER_PIN_MIN)?
        let before = if mixed {
            before_mixed
        } else {
            before_memory
        }
        for which in 0u64 .. 6 {
            // End-state bound (D7-S4): no more steps or bytes than the parent.
            if l98_threshold(reading, snap, handles, which, false)? > before[which] || l98_threshold(reading, snap, handles, which, true)? > before_bytes[which] {
                fail("L98(d): Memory index exceeded the parent's step or byte boundary")
            }
        }
    }
    close(take db)
}

// One lookup of bucket 3 through the index, with the writer partition set to
// `pin_bytes`, returns the call's refusal fields.
fn l98_refusal(mut db: Db, handles: TxReadHandles, pin_bytes: u64) -> Result[(u64, u64), Error] waits {
    let partition = replace(mut db.writer_pin_bytes, pin_bytes)
    let outcome = run(mut db, Some(10000000), copy_env(handles), fn(mut tx: Tx, env: TxReadHandles) -> Result[u64, Error] {
        let mut seen = 0u64
        let mut rows = lookup(tx, env.ix, Included(3u64), Included(3u64))?
        while let Some(_) = next_indexed(mut rows)? {
            seen += 1
        }
        Ok(seen)
    })
    db.writer_pin_bytes = partition
    let Refused(Cache(problem)) = outcome? else {
        fail("L98 (a'): a Tiered index read past the writer partition is Refused(Cache)")
    }
    Ok((problem.requested, problem.available))
}

// L98 (a') and (b) on one Tiered index root. Memory -> Tiered moves the
// index's charge from the Memory account to the Tiered account whole, and
// Tiered -> Memory restores both accounts exactly (the oracle is the
// manifest before the round trip). A read past the writer partition refuses
// with the same `Capacity` from a cold cache, a warm cache and a reopened
// (evicted) cache, since a touch is charged by its bytes, not by its miss.
@test
fn test_l98_tiered_index_round_trip_keeps_account_and_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    tx_read_fixture(d, c, r, tasks, floor, false, false)?
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let handles = tx_read_handles(mut db, Open)?
    let (_, _, take before) = read_only_manifest(d)?
    set_residency(mut db, handles.ix.id, Tiered)?
    let (_, _, take tiered) = read_only_manifest(d)?
    if tiered.account_tiered <= before.account_tiered || tiered.account_memory + tiered.account_tiered != before.account_memory + before.account_tiered {
        fail("L98 (b): Memory -> Tiered moves the index's charge between the accounts whole")
    }
    let cold = l98_refusal(mut db, handles, 4096)?
    let warm = l98_refusal(mut db, handles, 4096)?
    if cold != warm || cold.1 != 4096 || cold.0 <= 4096 {
        fail("L98 (a'): the refusal is exact and equal from a cold and a warm cache")
    }
    close(take db)?
    let mut reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    let again = tx_read_handles(mut reopened, Open)?
    if l98_refusal(mut reopened, again, 4096)? != cold {
        fail("L98 (a'): the refusal is equal after the cache is evicted")
    }
    set_residency(mut reopened, again.ix.id, Memory)?
    let (_, _, take after) = read_only_manifest(d)?
    if after.account_memory != before.account_memory || after.account_tiered != before.account_tiered {
        fail("L98 (b): Memory -> Tiered -> Memory keeps the exact account")
    }
    tx_read_modes(reopened, again, false, false)?
    close(take reopened)
}

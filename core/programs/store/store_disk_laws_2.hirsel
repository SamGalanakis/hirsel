// L31 (a) on disk: law_migrate's trace to v4, made durable, then reopen.
// The catalog lists t as id 3 with only by_b (id 4), by_b gives k3, k1, k2,
// and the old ids hold nothing. Wrong implementation caught: a cut that
// writes the migrated catalog but not the new rows' tree, or the reverse.
pub fn disk_law_migrate(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    let (t, _) = result.unwrap(law_indexed(mut db, "t", std.codec.key_u64(), old_codec(), "by_a", code.describe(old_balance), std.codec.key_u64()))
    let first = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 1, OldAccount(balance: 7))?
        put(mut tx, call_env, 2, OldAccount(balance: 9))
    }))
    match take first {
        Committed(_) => {},
        _ => return false
    }
    let (nt, _) = result.unwrap(try_migrate(mut db, tasks, code.describe(migrate_upgrade), "by_b", code.describe(new_bonus), std.codec.key_u64()))
    let late = result.unwrap(run(mut db, None, nt, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 3, NewAccount(balance: 5, bonus: 50))
    }))
    match take late {
        Committed(done) => result.unwrap(durable(mut db, done.ticket)),
        _ => return false
    }
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    let mut decl = result.unwrap(declare(reopened, Open))
    let mut declared = result.unwrap(declare_table(mut decl, "t", std.codec.key_u64(), new_codec()))
    let ix = result.unwrap(index(mut decl, mut declared, "by_b", Many, code.describe(new_bonus), std.codec.key_u64()))
    let back = result.unwrap(finish(mut decl, take declared))
    let _ = result.unwrap(seal(mut reopened, take decl))
    let listed = result.unwrap(index_catalog(reopened, 3))
    let now = snapshot(reopened)
    let mut leftovers = result.unwrap(scan_raw(now, 1, Unbounded, Unbounded))
    let mut old_index = result.unwrap(scan_raw(now, 2, Unbounded, Unbounded))
    let empty_old = match result.unwrap(failure_result_from_rep(catalog.next_bytes(mut leftovers))) {
        None => true,
        Some(_) => false
    }
    let empty_index = match result.unwrap(failure_result_from_rep(catalog.next_bytes(mut old_index))) {
        None => true,
        Some(_) => false
    }
    let good = back.id == 3 && ix.id == 4 && list.len(listed) == 1 && version(now) == 4 && empty_old && empty_index && result.unwrap(bonus_order(now, ix)) == 305010702090
    result.unwrap(close(take reopened))
    good
}


// rule: RUN-3
// expect: run
// An entry reference crosses as bytes and resolves, among the entries the
// program gives it, to the entry with its path and fingerprint. A reference
// whose path names no entry of `among` (a moved entry) and one whose
// fingerprint differs from the entry at its path (a retyped entry) resolve to
// None, even when an entry of `among` matches the other half.
pub type Failed = Check | Decode(DecodeError)

fn add_one(n: u64) -> Result[u64, String] {
  Ok(n + 1u64)
}

fn add_two(n: u64) -> Result[u64, String] {
  Ok(n + 2u64)
}

// Not in `among`: its path names no entry there.
fn add_three(n: u64) -> Result[u64, String] {
  Ok(n + 3u64)
}

// Another signature, so another fingerprint.
fn label(s: String) -> Result[u64, String] {
  Ok(0u64)
}

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

// An entry is not data, so an `Option` of one is matched, not compared.
fn found(o: Option[Entry[fn(n: u64) -> Result[u64, String]]]) -> bool {
  match o {
    Some(_) => true,
    None() => false,
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let one: Entry[fn(n: u64) -> Result[u64, String]] = add_one
  let two: Entry[fn(n: u64) -> Result[u64, String]] = add_two
  let three: Entry[fn(n: u64) -> Result[u64, String]] = add_three
  let other: Entry[fn(s: String) -> Result[u64, String]] = label
  let among = [one, two]
  let stored = codec.encode(entry_ref.reference(two))
  let read: entry_ref.EntryRef = codec.decode(stored) ? Decode
  let Some(f) = entry_ref.resolve(read, among) else {
    return Error(Check())
  }
  check(runner.entry_id(f) == runner.entry_id(two))?
  check(found(entry_ref.resolve(entry_ref.reference(one), among)))?
  // Moved: add_one's fingerprint under another path.
  let moved = entry_ref.EntryRef(
    path: entry_ref.reference(three).path,
    fingerprint: entry_ref.reference(one).fingerprint
  )
  check(!found(entry_ref.resolve(moved, among)))?
  // Retyped: add_one's path with another signature's fingerprint.
  let retyped = entry_ref.EntryRef(
    path: entry_ref.reference(one).path,
    fingerprint: entry_ref.reference(other).fingerprint
  )
  check(!found(entry_ref.resolve(retyped, among)))?
  Ok(())
}

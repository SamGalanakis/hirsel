type TieredScanLeaf {
    key: Bytes,
    page: Arc[std.page.Page],
    slot: u64
}

fn tiered_scan_edge(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], edge: std.page.Slot, expected: Option[u8],
    low: Bytes, high: Option[View[Bytes]], reverse: bool) -> Result[Option[TieredScanLeaf], Error] {
    let page = tiered_point_page(mut attempt, visible, edge, expected)?
    let image = std.page.image_of(page)
    let n = std.page.count(image)
    if n == 0 {
        return Ok(None)
    }
    let height = std.page.level(image)
    let stop = if let Some(upper) = high {
        let (slot, _) = std.page.search(image, upper)
        slot
    } else {
        n
    }
    if height == 0 {
        let (start, _) = std.page.search(image, low)
        if stop <= start {
            return Ok(None)
        }
        let selected = if reverse { stop - 1 } else { start }
        let key = option.unwrap(std.page.key_at(image, selected))
        return Ok(Some(TieredScanLeaf(key: take key, page: arc.share(page), slot: selected)))
    }
    let start = option.unwrap(std.page.descend(image, low))
    for offset in 0u64 .. int.saturating_sub(stop, start) {
        let selected = if reverse { stop - 1 - offset } else { start + offset }
        let child = option.unwrap(std.page.child_slot(page, selected))
        if let Some(take row) = tiered_scan_edge(mut attempt, visible, child, Some(height - 1), low, high, reverse)? {
            return Ok(Some(take row))
        }
    }
    Ok(None)
}

fn tiered_scan_overlay(edits: Arc[ReplayOverlay], low: Bytes, high: Bytes, reverse: bool) -> Option[(Bytes, Arc[Bytes])] {
    let mut cursor = if reverse {
        std.omap.range_reverse(edits.entries, Included(clone(low)), Excluded(clone(high)))
    } else {
        std.omap.range(edits.entries, Included(clone(low)), Excluded(clone(high)))
    }
    while let Some((key, row)) = std.omap.next(mut cursor) {
        if let ReplayPut(stored) = view row.now {
            return Some((clone(key), arc.share(stored)))
        }
    }
    None
}

// The closest overlay put caps the Cold search. A Cold key present in the
// overlay is masked before its value is touched.
fn tiered_scan_row(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]], edge: std.page.Slot, collection: u32,
    overlay: Option[View[Arc[ReplayOverlay]]], low: Bytes, high: Bytes, reverse: bool) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    let staged = if let Some(edits) = overlay {
        tiered_scan_overlay(edits, low, high, reverse)
    } else {
        None
    }
    let (take capped_low, take capped_high) = match staged {
        Some((key, _)) => if reverse {
            let mut after = copied(key)?
            list.push(mut after, 0u8)
            (take after, copied(high)?)
        } else {
            (copied(low)?, copied(key)?)
        },
        None => (copied(low)?, copied(high)?),
    }
    let mut start = take capped_low
    let mut stop = take capped_high
    while start < stop {
        let found = {
            let cold_low = list.slice(start, 4, list.len(start))
            let stop_collection: u32 = list.word_be(stop, 0)
            let cold_high = if stop_collection == collection {
                Some(list.slice(stop, 4, list.len(stop)))
            } else {
                None
            }
            tiered_scan_edge(mut attempt, visible, edge, None, cold_low, cold_high, reverse)?
        }
        let Some(take row) = take found else {
            break
        }
        let mut logical = logical_key(collection, row.key)?
        if let Some(edits) = overlay {
            if let Some(_) = replay_overlay_at(edits, logical) {
                if reverse {
                    stop = take logical
                } else {
                    list.push(mut logical, 0u8)
                    start = take logical
                }
                continue
            }
        }
        let value = tiered_point_value(mut attempt, visible, row.page, row.slot)?
        return Ok(Some((take logical, take value)))
    }
    Ok(take staged)
}

fn read_tiered_scan(source: TieredPageSource, grant: Arc[TieredReaderGrant], root: TieredPinRoot, tree: PageTree, edge: std.page.Slot,
    descriptor: Bytes, collection: u32, take low: Bytes, take high: Bytes, reverse: bool, touch_slots: u64) -> Result[Option[(Bytes, Arc[Bytes])], Error] waits {
    let mut start = take low
    let mut stop = take high
    if descriptor[52u64] == 4 {
        let window = descriptor_bounds(descriptor)
        let first_key = log_key(collection, window.first)?
        let next_key = log_key(collection, window.next)?
        if start < first_key { start = take first_key }
        if stop > next_key { stop = take next_key }
    }
    if start >= stop {
        return Ok(None)
    }
    let overlay = match tree.replay {
        Some(replay) => std.omap.get(replay.collections, collection),
        None => None,
    }
    let hint = if reverse { view stop } else { view start }
    retry_tiered_read(source, grant, root, list.slice(hint, 4, list.len(hint)), None, touch_slots,
        scoped fn(mut attempt: TieredTouchSet, visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
            tiered_scan_row(mut attempt, visible, edge, collection, overlay, start, stop, reverse)
        })
}

// Capturing depth deliberately exceeds the 1M corpus execution budget.
pub fn main() -> Result[(), ()] {
  let mut pattern: List[u8] = []
  for i in 0u64..512 {
    text.append(mut pattern, "(")
  }
  text.append(mut pattern, "a")
  for i in 0u64..512 {
    text.append(mut pattern, ")")
  }
  let Ok(re) = regex.compile(text.finish_valid(take pattern), 1026) else {
    return Error(())
  }
  failure.check(regex.num_subexp(re) == 512, TextInvariant())
  failure.check(
    regex.find_captures(re, "a", 100) == Error(WorkLimit()),
    TextInvariant()
  )
  let Ok(Some(caps)) = regex.find_captures(re, "a", 10000000) else {
    return Error(())
  }
  failure.check(list.len(caps.spans) == 513, TextInvariant())
  for span in caps.spans {
    failure.check(span == Some(regex.Span(start: 0, end: 1)), TextInvariant())
  }
  // Class-only prefilters have no literal list. They must still reach the
  // ordered matcher after false candidates and across ASCII/UTF-8 boundaries.
  let Ok(classes) = regex.compile("[A-Z]suffix|[a-z]suffix|~suffix", 1000) else {
    return Error(())
  }
  failure.check(
    regex.find_all(classes, "\0!@\u{7f}Awrong?asuffix", 8, 18446744073709551615) == Ok(
      [regex.Span(start: 11, end: 18)]
    ),
    TextInvariant()
  )
  let Ok(folded) = regex.compile("(?i)kzebra|szebra", 1000) else {
    return Error(())
  }
  failure.check(
    regex.find_all(folded, "\0_Kzebra", 8, 18446744073709551615) == Ok(
      [regex.Span(start: 2, end: 10)]
    ),
    TextInvariant()
  )
  // A long skipped prefix, adjacent matches, and an unmatched suffix exercise
  // replacement cursor advancement. UTF-8 keeps the scalar-boundary path.
  let Ok(replace) = regex.compile("(abc|xyz)", 1000) else {
    return Error(())
  }
  let prefix = "________________________________________________________________"
  for budget in [1000000u64, 18446744073709551615u64] {
    failure.check(
      regex.replace_all_literal(replace, string.concat(prefix, "abcabc?xyz!"), "X", budget) == Ok(
        string.concat(prefix, "XX?X!")
      ),
      TextInvariant()
    )
    failure.check(
      regex.replace_all_literal(replace, string.concat(prefix, "éabcabc?xyz!"), "X", budget) == Ok(
        string.concat(prefix, "éXX?X!")
      ),
      TextInvariant()
    )
  }
  Ok(())
}

{
  "name": "hirsel",
  "displayName": "Hirsel",
  "description": "Syntax highlighting and language server support for Hirsel",
  "version": "0.1.0",
  "publisher": "hirsel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamGalanakis/hirsel.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hirsel.restartServer",
        "title": "Hirsel: Restart Language Server"
      }
    ],
    "languages": [
      {
        "id": "hirsel",
        "aliases": [
          "Hirsel"
        ],
        "extensions": [
          ".hirsel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Hirsel",
      "properties": {
        "hirsel.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the Hirsel executable. Leave empty to search PATH, ~/.local/bin, and ~/.cargo/bin in that order."
        }
      }
    },
    "configurationDefaults": {
      "[hirsel]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "hirselCharacter",
        "superType": "string",
        "description": "Character or byte literal"
      },
      {
        "id": "hirselBracket",
        "description": "Bracket"
      },
      {
        "id": "hirselDelimiter",
        "description": "Delimiter"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "hirsel",
        "scopes": {
          "decorator": [
            "storage.type.annotation"
          ],
          "hirselCharacter": [
            "constant.character"
          ],
          "hirselBracket": [
            "punctuation.bracket"
          ],
          "hirselDelimiter": [
            "punctuation.separator"
          ],
          "label": [
            "entity.name.label"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "package": "vsce package --no-dependencies",
    "test": "npm run build && tsc && node --test .test-build/test/extension.test.js",
    "test:editor": "tsc && node test/run-editor.mjs",
    "test:bundle": "tsc && node test/run-editor.mjs --real",
    "vscode:prepublish": "npm run build"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@types/emscripten": "1.41.5",
    "@types/node": "20.19.30",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "tree-sitter-cli": "0.25.10",
    "typescript": "5.9.3",
    "vscode-languageclient": "9.0.1",
    "web-tree-sitter": "0.25.10"
  }
}

// Laws for the gateway. Each session's place runs in the gateway's directory on a
// Disk backing, against scripted, test-owned services. See README.md.
const BYTES: u64 = 131072u64

const PLACE_BYTES: u64 = 1048576u64

const IDLE_MS: u64 = 300u64

const WITHIN_MS: u64 = 5000u64

// An effect may run the subagent, whose wire client spawns a 1 MiB reader and writer.
const EFFECT_BYTES: u64 = 6291456u64

const EFFECT_GRANT: u64 = 8388608u64

// ---- scripted services ----
// What every session's place shares: the scripted model, the test's hold on `tally`, and
// the gateway's door for the subagent tool. Each place adds its own name and services.
type Services: send {
    model: Sender[Sender[()]],
    tallies: Sender[Sender[()]],
    door: harness.gateway.Door,
    name: String,
    tasks: Tasks,
    clock: Clock,
    random: Random,
    net: Net,
    preview: Option[harness.preview.Door],
    chunks: u64,
}

type Grants: send {
    context: store.runner.TriggerContext,
    s: Services
}

fn usage() -> harness.Usage {
    harness.Usage(input: 10u64, output: 5u64)
}

fn call_of(take name: String) -> harness.Call {
    harness.Call(id: "c1", name: take name, args: Inline(string.into_bytes("{}")))
}

fn asking(take name: String) -> harness.Answer {
    let mut calls: List[harness.Call] = list.new()
    list.push(mut calls, call_of(take name))
    harness.Answer(text: "", calls: take calls, stop: "end", usage: usage())
}

fn finished() -> harness.Answer {
    harness.Answer(text: "done", calls: list.new(), stop: "end", usage: usage())
}

// The model must wait (LANG-8), so it asks a service that answers every ask at once.
fn model_service(take inbox: Receiver[Sender[()]]) -> () waits {
    while let Ok(reply) = channel.receive(inbox) {
        let _ = channel.send(reply, ())
    }
}

fn ask_service(to: Sender[Sender[()]]) -> Result[(), harness.Fault] waits {
    let (reply, replied): (Sender[()], Receiver[()]) = channel.new(1u64)
    if let Error(_) = channel.send(to, take reply) {
        return Error(Unavailable)
    }
    match channel.receive(replied) {
        Ok(()) => Ok(()),
        Error(_) => Error(Unavailable)
    }
}

// The script: once a tool has answered, end with "done"; before that, call the tool the
// user's message names ("bump it", "tally it", "delegate it").
fn scripted_model(g: Grants, take r: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.Fault] waits {
    if g.s.chunks > 0u64 {
        return streaming_model(g, take r, mut sink)
    }
    let mut tool = "bump"
    for e in r.messages {
        match e {
            ToolResult(_, _) => return Ok(finished()),
            User(text) => if text == "tally it" {
                tool = "tally"
            } else if text == "delegate it" {
                tool = "delegate"
            },
            _ => (),
        }
    }
    ask_service(g.s.model)?
    Ok(asking(string.from(tool)))
}

fn preview_answer() -> harness.Answer {
    let mut text = string.with_capacity(10000u64)
    for i in 0u64 .. 10000u64 {
        string.push(mut text, "x")
    }
    harness.Answer(text: take text, calls: list.new(), stop: "end", usage: usage())
}

fn streaming_model(g: Grants, take r: harness.Request, mut sink: Option[harness.preview.Source]) -> Result[harness.Answer, harness.Fault] waits {
    let answer = preview_answer()
    let width = 10000u64 / g.s.chunks
    ask_service(g.s.model)?
    for i in 0u64 .. g.s.chunks {
        if let Some(mut p) = sink {
            harness.preview.delta(mut p, string.slice(answer.text, i * width, (i + 1u64) * width))
        }
        if i == 0u64 {
            ask_service(g.s.model)?
        }
    }
    Ok(take answer)
}

fn bump(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    if let Some(_) = view g.s.preview {
        ask_service(g.s.tallies)?
    } else {
        ask_service(g.s.model)?
    }
    Ok(string.into_bytes("1"))
}

// Answers when the test lets it; the test counts each run.
fn tally(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    ask_service(g.s.tallies)?
    Ok(string.into_bytes("1"))
}

fn child_of(s: Services) -> harness.gateway.Child {
    let views: std.codec.Codec[harness.View] = std.codec.of()
    harness.gateway.Child(submit: store.client.transact_entry(code.describe(submit_entry)), shown: store.client.query_as_entry(code.describe(harness.window), std.codec.key_u64(), views), keys: result.unwrap(store.client.entry_keys(code.describe(place))), socket: wire().socket, authority: string.into_bytes("localhost"), tasks: s.tasks, clock: s.clock, random: s.random, net: s.net, within_ms: WITHIN_MS)
}

// The subagent: a child session, keyed by this place and this effect's trigger run,
// asked to tally.
fn delegate(g: Grants, take args: Bytes) -> Result[Bytes, harness.Fault] waits {
    let key = harness.gateway.child_key(g.s.name, g.context)
    harness.gateway.ask(g.s.door, take key, Fresh("scripted", All), child_of(g.s), "tally it")
}

fn hold_bump(tx: store.Tx, ask: harness.Ask) -> harness.Verdict {
    if ask.call.name == "bump" {
        Hold("bump needs approval")
    } else {
        Pass
    }
}

// ---- the session place: the agent, its trigger entries and its wire entries ----
fn gated_agent() -> harness.Agent[Grants] {
    let mut a = harness.agent("gated", "scripted", code.describe(scripted_model))
    list.push(mut a.tools, harness.outside("bump", "adds one", "{}", Once, code.describe(bump)))
    list.push(mut a.tools, harness.outside("tally", "counts one", "{}", Once, code.describe(tally)))
    list.push(mut a.tools, harness.outside("delegate", "asks a subagent", "{}", Once, code.describe(delegate)))
    list.push(mut a.gates, harness.Gate(name: "hold", check: code.describe(hold_bump)))
    a
}

fn wired() -> Result[harness.Wiring, harness.Refused] {
    harness.wiring(code.describe(advance), code.describe(effect))
}

fn advance(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take wake: harness.Wake) -> Result[(), harness.Refused] {
    let w = wired()?
    harness.advance(mut tx, h, gated_agent(), w, take wake)
}

fn effect(g: Grants, caller: store.Caller, take key: harness.EffectKey) -> Result[harness.Worked, Capacity] waits {
    let target = match g.s.preview {
        Some(p) => Some(harness.preview.target(p, g.s.name, g.s.clock)),
        None => None,
    }
    harness.effect(g.context, g, take key, gated_agent(), code.describe(settle), take target)
}

fn settle(mut tx: store.Tx, a: store.triggers.Attempt, take m: harness.Settle) -> Result[harness.Filed, store.Error] {
    let Ok(w) = wired() else {
        return Error(Missing("harness: wiring"))
    }
    harness.settle(mut tx, gated_agent(), w, a, take m)
}

fn submit_entry(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take m: harness.Submit) -> Result[harness.Disposition, harness.Refused] {
    let w = wired()?
    harness.submit(mut tx, h, gated_agent(), w, caller, take m)
}

fn decide_entry(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take d: harness.Decision) -> Result[harness.Ruling, harness.Refused] {
    let w = wired()?
    harness.decide(mut tx, h, gated_agent(), w, caller, take d)
}

fn revoke_reader(mut tx: store.Tx, h: harness.Handles, caller: store.Caller, take unused: ()) -> Result[(), harness.Refused] {
    harness.set_reader(mut tx, h, caller, false)
}

fn place(mut r: store.runner.Registry[Grants, harness.Handles]) -> Result[(), store.runner.RegisterError] {
    harness.register_standard(mut r, code.describe(advance), code.describe(effect), code.describe(settle), BYTES, EFFECT_BYTES)?
    store.runner.transact(mut r, code.describe(submit_entry), BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.transact(mut r, code.describe(decide_entry), BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.transact(mut r, code.describe(revoke_reader), BYTES, store.runner.DEFAULT_STEPS)?
    harness.pending_waits_entry(mut r, BYTES, store.runner.DEFAULT_STEPS)?
    let windows: std.codec.Codec[harness.View] = std.codec.of()
    store.runner.query_as(mut r, code.describe(harness.window), std.codec.key_u64(), windows, BYTES, store.runner.DEFAULT_STEPS)?
    store.runner.query_as(mut r, code.describe(harness.history_cuts), std.codec.key_u64(), std.codec.of_u64(), BYTES, store.runner.DEFAULT_STEPS)
}

fn services_of(s: Services, take name: String) -> Services {
    Services(model: channel.sender(s.model), tallies: channel.sender(s.tallies), door: harness.gateway.copy_door(s.door), name: take name, tasks: s.tasks, clock: s.clock, random: s.random, net: s.net, preview: match s.preview {
        Some(p) => Some(harness.preview.copy_door(p)),
        None => None
    }, chunks: s.chunks)
}

fn make_grants(s: Services, take ctx: store.runner.TriggerContext) -> Result[Grants, Capacity] {
    Ok(Grants(context: take ctx, s: services_of(s, string.from(s.name))))
}

fn wire() -> store.runner.WireConfig {
    let mut w = store.runner.wire_defaults(65536u64, PLACE_BYTES)
    w.n_pool = 4194304u64
    w
}

// The host replaces the backing, selection, idle time and wire session count with its own (§14.9). The binding maps
// one credential to one Caller across connections, as a browser's login would.
fn session_place(take supplied: store.local.Supplied, s: Services) -> Result[store.runner.PlaceConfig[Grants, harness.Handles, Services, ()], Capacity] {
    let w = result.unwrap(wired())
    let config = store.runner.TriggerConfig(entries: harness.entries(w), author: store.Caller(issuer: 0u8, subject: list.new()), grants: services_of(s, string.from(supplied.name)), grant: make_grants, grant_bytes: EFFECT_GRANT)
    Ok(store.runner.PlaceConfig(backing: Memory, selection: Reopen, place: code.describe(place), n_place: PLACE_BYTES, migrate: code.describe(harness.migrate), handles: code.describe(harness.handles), session: wire(), max_sessions: 1u64, proxies: list.new(), n_publisher: PLACE_BYTES, listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: supplied.net, tasks: supplied.tasks, clock: supplied.clock, random: supplied.random, stop: store.runner.Stop(lag_ms: 0u64, grace_ms: 200u64), wire: Some(store.runner.wire_bind((), code.describe(store.ingress.caller), 4096u64, 65536u64)), triggers: Some(take config), idle: Some(IDLE_MS)))
}

fn session_factory() -> store.local.Factory[Services] {
    store.local.seeded_factory(session_place)
}

// ---- driving a session through the gateway ----
fn bytes_of[A: codec](a: A) -> Bytes {
    let codec: std.codec.Codec[A] = std.codec.of()
    let mut raw: Bytes = list.new()
    result.unwrap(std.codec.encode(codec, a, mut raw))
    take raw
}

// Routes to a session (waking it), makes one wire call and lets go of the session.
fn call_routed[A: codec, R: codec](door: harness.gateway.Door, id: u64, credential: Bytes, first_p: u64, e: store.fixture.Callee[A, R], take a: A, tasks: Tasks, clock: Clock, random: Random, net: Net) -> Result[R, u64] waits {
    let lease = match harness.gateway.route(door, id) {
        Ok(take l) => take l,
        Error(Place(_)) => return Error(101u64),
        Error(_) => return Error(100u64)
    }
    let Some(address) = latest.read(store.local.status(lease)).addr else {
        return Error(102u64)
    }
    let Ok(keys) = store.fixture.entry_keys(code.describe(place)) else {
        return Error(103u64)
    }
    let Ok(take c) = store.fixture.client_at(tasks, net, clock, random, keys, wire().socket, address, Some(clone(credential)), first_p, WITHIN_MS) else {
        return Error(104u64)
    }
    let mut client = take c
    let replied = store.fixture.call(mut client, e, take a, 5000u32)
    store.fixture.close(take client)
    let _ = take lease
    match take replied {
        Ok(store.fixture.Replied(answer: Returned(take r), ..)) => Ok(take r),
        Ok(store.fixture.Replied(answer: Failed(_), ..)) => Error(105u64),
        Ok(store.fixture.Replied(answer: Refused(_), ..)) => Error(106u64),
        Ok(_) => Error(107u64),
        Error(_) => Error(108u64),
    }
}

// Waits for the session's place to stop by itself.
fn stopped(changes: Receiver[store.local.Change]) -> bool waits {
    while let Ok(c) = channel.receive(changes) {
        if let Down(u) = c {
            return match u.ended {
                Ok(Stopped(_)) => true,
                _ => false
            }
        }
    }
    false
}

fn transcript_of(dir: Dir, clock: Clock, random: Random, tasks: Tasks) -> List[Bytes] waits {
    let db = result.unwrap(store.open(tasks, dir, clock, random, store.triggers.law_options()))
    let h = result.unwrap(store.with_schema(db, code.describe(harness.handles)))
    let snap = store.snapshot(db)
    let mut out: List[Bytes] = list.new()
    if let Ok(Some(s)) = store.get(snap, store.shape(h.session), 0u64) {
        for p in 0u64 .. s.next_pos {
            if let Ok(Some(e)) = store.get(snap, store.shape(h.entries), p) {
                list.push(mut out, bytes_of(e))
            }
        }
    }
    result.unwrap(store.close(take db))
    out
}

// The session's log, derived by hand from the script: the user's message, the first
// request's baseline offering `bump`, the answer that calls it, its result and the end.
fn expected_log() -> List[Bytes] {
    log_of("bump", Returned(Inline(string.into_bytes("1"))))
}

fn log_of(take tool: String, take outcome: harness.Outcome) -> List[Bytes] {
    let mut defs: List[harness.ToolDef] = list.new()
    list.push(mut defs, harness.ToolDef(name: "bump", about: "adds one", input: "{}", rev: 1u64, catalog: None))
    list.push(mut defs, harness.ToolDef(name: "tally", about: "counts one", input: "{}", rev: 1u64, catalog: None))
    list.push(mut defs, harness.ToolDef(name: "delegate", about: "asks a subagent", input: "{}", rev: 1u64, catalog: None))
    let mut said = string.from(tool)
    string.push(mut said, " it")
    let mut entries_want: List[harness.Entry] = list.new()
    list.push(mut entries_want, User(take said))
    list.push(mut entries_want, System(harness.Patch(baseline: true, changes: list.new(), tools: Some(take defs))))
    list.push(mut entries_want, Assistant(asking(take tool)))
    list.push(mut entries_want, ToolResult("c1", take outcome))
    list.push(mut entries_want, Assistant(finished()))
    let mut log: List[Bytes] = list.new()
    for e in entries_want {
        list.push(mut log, bytes_of(e))
    }
    log
}

// Law W1 (wake on demand): a session whose place stopped by itself while a call waits
// for approval is woken by the route that carries the approval, and resumes: the log
// read while it was unloaded is unchanged, and the run finishes it exactly as the script
// says. Oracle: the hand-derived log; the first three entries are the log at unload.
// The answer is the first check that failed, or 0.
pub fn law_wake_resumes_transcript(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> u64 waits {
    let mut name = string.with_capacity(32u64)
    let root = result.unwrap(host.mkdtemp(parent, mut name))
    let (asks, inbox): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let modelling = task.spawn(tasks, bytes 1048576u64, take inbox, model_service)
    let (tallies, _held): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let (watch, changes): (Sender[store.local.Change], Receiver[store.local.Change]) = channel.new(64u64)
    let way: harness.gateway.Doorway = harness.gateway.doorway()
    let door = harness.gateway.door_of(way)
    let seed = Services(model: take asks, tallies: take tallies, door: harness.gateway.door_of(way), name: "", tasks: tasks, clock: clock, random: random, net: net, preview: None, chunks: 0u64)
    let config = harness.gateway.GatewayConfig(root: root, options: store.triggers.law_options(), migrate: code.describe(harness.migrate), factory: session_factory(), max_sessions: 1u64, idle_ms: IDLE_MS, place_bytes: 67108864u64, tasks: tasks, clock: clock, random: random, net: net, watch: Some(take watch), seed: take seed)
    let g = match harness.gateway.gateway(take way, take config) {
        Ok(take made) => take made,
        Error(_) => return 1u64
    }
    let id = match harness.gateway.create(door, string.into_bytes("first"), Fresh("scripted", All)) {
        Ok(n) => n,
        Error(_) => return 2u64
    }
    let submit = store.fixture.transact_entry(code.describe(submit_entry))
    let credential = store.ingress.credential(random)
    let placed = match call_routed(door, id, credential, 0u64, submit, harness.Submit(client_key: "k1", text: "bump it"), tasks, clock, random, net) {
        Ok(Ok(Placed(_))) => true,
        Error(n) => return n,
        _ => false,
    }
    if !placed {
        return 3u64
    }
    if !stopped(changes) {
        return 4u64
    }
    let session_dir = result.unwrap(std.dir.narrow(root, "s0"))
    let at_unload = transcript_of(session_dir, clock, random, tasks)
    let want = expected_log()
    if list.len(at_unload) != 3u64 {
        return 5u64
    }
    for i in 0u64 .. 3u64 {
        if at_unload[i] != want[i] {
            return 6u64
        }
    }
    let key = harness.approval_key("bump", 1u64, Inline(string.into_bytes("{}")))
    let decide = store.fixture.transact_entry(code.describe(decide_entry))
    let d = harness.Decision(run: 0u64, round: 0u64, ordinal: 0u64, key: take key, allow: true)
    match call_routed(door, id, credential, 1u64, decide, take d, tasks, clock, random, net) {
        Ok(Ok(Approved)) => (),
        Ok(_) => return 7u64,
        Error(n) => return n + 100u64,
    }
    if !stopped(changes) {
        return 8u64
    }
    let _ = harness.gateway.stop(take g)
    let resumed = transcript_of(session_dir, clock, random, tasks)
    let _ = task.join(take modelling)
    result.unwrap(std.dir.remove_all(parent, name))
    if list.len(resumed) != list.len(want) {
        return 9u64
    }
    for i in 0u64 .. list.len(want) {
        if resumed[i] != want[i] {
            return 10u64
        }
    }
    0u64
}

@test
fn test_wake_resumes_transcript(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_wake_resumes_transcript(parent, clock, random, tasks, net)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

// ---- law S1: the subagent's Once tool across a crash ----
fn same(got: List[Bytes], want: List[Bytes]) -> bool {
    if list.len(got) != list.len(want) {
        return false
    }
    for i in 0u64 .. list.len(want) {
        if got[i] != want[i] {
            return false
        }
    }
    true
}

// Waits until both sessions' places have stopped by themselves.
fn both_stopped(changes: Receiver[store.local.Change]) -> bool waits {
    let mut parent_done = false
    let mut child_done = false
    while let Ok(c) = channel.receive(changes) {
        if let Down(u) = c {
            if let Ok(Stopped(_)) = u.ended {
                if u.name == "s0" {
                    parent_done = true
                } else if u.name == "s1" {
                    child_done = true
                }
            }
        }
        if parent_done && child_done {
            return true
        }
    }
    false
}

fn unload_task(take job: (harness.gateway.Door, u64, Sender[Result[store.local.Unloaded, harness.gateway.Refused]])) -> () waits {
    let (door, id, reply) = take job
    let _ = channel.send(reply, harness.gateway.unload(door, id))
}

// Law S1 (a subagent's Once tool runs at most once across a crash of either place): the
// parent's `delegate` starts a child session that calls `tally`, which the test holds.
// With `crash_child` the test cuts the child's place while tally runs; otherwise it cuts
// the parent's while delegate waits, then lets tally answer. Either way the gateway wakes
// the cut place, the cut call settles InDoubt, tally ran exactly once, there are exactly
// two sessions, and both logs are as the script says. Oracle: the hand-derived logs and
// the test's own count of tally runs. The answer is the first check that failed, or 0.
pub fn law_subagent_once(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, crash_child: bool) -> u64 waits {
    let mut name = string.with_capacity(32u64)
    let root = result.unwrap(host.mkdtemp(parent, mut name))
    let (asks, inbox): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let modelling = task.spawn(tasks, bytes 1048576u64, take inbox, model_service)
    let (tallies, held): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let (watch, changes): (Sender[store.local.Change], Receiver[store.local.Change]) = channel.new(256u64)
    let way: harness.gateway.Doorway = harness.gateway.doorway()
    let door = harness.gateway.door_of(way)
    let seed = Services(model: take asks, tallies: take tallies, door: harness.gateway.door_of(way), name: "", tasks: tasks, clock: clock, random: random, net: net, preview: None, chunks: 0u64)
    let config = harness.gateway.GatewayConfig(root: root, options: store.triggers.law_options(), migrate: code.describe(harness.migrate), factory: session_factory(), max_sessions: 2u64, idle_ms: IDLE_MS, place_bytes: 134217728u64, tasks: tasks, clock: clock, random: random, net: net, watch: Some(take watch), seed: take seed)
    let g = match harness.gateway.gateway(take way, take config) {
        Ok(take made) => take made,
        Error(_) => return 1u64
    }
    let id = match harness.gateway.create(door, string.into_bytes("parent"), Fresh("scripted", All)) {
        Ok(n) => n,
        Error(_) => return 2u64
    }
    let submit = store.fixture.transact_entry(code.describe(submit_entry))
    let credential = store.ingress.credential(random)
    match call_routed(door, id, credential, 0u64, submit, harness.Submit(client_key: "k1", text: "delegate it"), tasks, clock, random, net) {
        Ok(Ok(Placed(_))) => (),
        Error(n) => return n,
        _ => return 3u64,
    }
    // Tally's first run: the child exists and its call is in flight.
    let Ok(first) = channel.receive(held) else {
        return 4u64
    }
    let sessions = harness.gateway.listing(door)
    if list.len(sessions) != 2u64 {
        return 5u64
    }
    let child = if sessions[0] == id {
        sessions[1]
    } else {
        sessions[0]
    }
    let cut = if crash_child {
        child
    } else {
        id
    }
    // The cut: a client left open on the place makes its stop end Forced at the grace
    // deadline, with the held call still in flight; the stop must end while it is held.
    let lease = match harness.gateway.route(door, cut) {
        Ok(take l) => take l,
        Error(_) => return 14u64
    }
    let Some(address) = latest.read(store.local.status(lease)).addr else {
        return 15u64
    }
    let Ok(keys) = store.fixture.entry_keys(code.describe(place)) else {
        return 16u64
    }
    let Ok(take lingering) = store.fixture.client_at(tasks, net, clock, random, keys, wire().socket, address, Some(store.ingress.credential(random)), 0u64, WITHIN_MS) else {
        return 17u64
    }
    let _ = take lease
    let (unloaded, unload_answer): (Sender[Result[store.local.Unloaded, harness.gateway.Refused]], Receiver[Result[store.local.Unloaded, harness.gateway.Refused]]) = channel.new(1u64)
    let unloading = task.spawn(tasks, bytes 1048576u64, (harness.gateway.copy_door(door), cut, take unloaded), unload_task)
    let mut ended: Option[Result[store.local.Unloaded, harness.gateway.Refused]] = None
    for i in 0u64 .. 50u64 {
        if let Ok(take got) = channel.try_receive(unload_answer) {
            ended = Some(take got);
            break
        }
        std.clock.sleep_ns(clock, 100000000u64)
    }
    if crash_child {
        let _ = take first
    } else {
        let _ = channel.send(first, ())
    }
    store.fixture.close(take lingering)
    let _ = task.join(take unloading)
    match take ended {
        Some(Ok(u)) => match u.ended {
            Ok(Forced(_)) => (),
            Ok(Stopped(_)) => return 60u64,
            Ok(Unstarted) => return 61u64,
            Error(_) => return 62u64
        },
        Some(Error(_)) => return 7u64,
        None => return 63u64,
    }
    if !both_stopped(changes) {
        return 8u64
    }
    let _ = harness.gateway.stop(take g)
    let _ = task.join(take modelling)
    let mut runs = 1u64
    while let Ok(_) = channel.try_receive(held) {
        runs += 1u64
    }
    if runs != 1u64 {
        return 11u64
    }
    let parent_log = transcript_of(result.unwrap(std.dir.narrow(root, "s0")), clock, random, tasks)
    let child_log = transcript_of(result.unwrap(std.dir.narrow(root, "s1")), clock, random, tasks)
    let parent_want = log_of("delegate", if crash_child {
        Returned(Inline(string.into_bytes("done")))
    } else {
        InDoubt
    })
    let child_want = log_of("tally", if crash_child {
        InDoubt
    } else {
        Returned(Inline(string.into_bytes("1")))
    })
    result.unwrap(std.dir.remove_all(parent, name))
    if !same(parent_log, parent_want) {
        return 12u64
    }
    if !same(child_log, child_want) {
        return 13u64
    }
    0u64
}

@test
fn test_subagent_once_child_crash(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_subagent_once(parent, clock, random, tasks, net, true)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

@test
fn test_subagent_once_parent_crash(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_subagent_once(parent, clock, random, tasks, net, false)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

// ---- law H1: the front holds a session's stream, not its place ----
fn local(port: u16) -> Addr {
    Addr(ip: V4(0x7f000001u32), port: port)
}

// One request to the front, answered with its status and body; 0 when it failed.
fn http(net: Net, clock: Clock, port: u16, method: String, target: String, take headers: List[std.http_client.Header], take payload: Bytes) -> (u16, Bytes) waits {
    let req = std.http_client.Request(method: string.from(method), target: string.from(target), headers: take headers, body: Fixed(list.len(payload)))
    let Ok(take opened) = std.http_client.dial(net, local(port), "127.0.0.1", clock, req, std.clock.deadline_after_ms(host.mono_ns(clock), WITHIN_MS)) else {
        return (0u16, list.new())
    }
    let mut c = take opened
    if list.len(payload) > 0u64 {
        if let Error(_) = std.http_client.write(mut c, payload) {
            return (0u16, list.new())
        }
    }
    if let Error(_) = std.http_client.finish_request(mut c, 65536u64) {
        return (0u16, list.new())
    }
    let status = std.http_client.status(std.http_client.head(c))
    let mut got: Bytes = list.new()
    loop {
        list.reserve(mut got, 4096u64)
        match std.http_client.read(mut c, mut got) {
            Ok(0u64) => break,
            Ok(_) => (),
            Error(_) => break
        }
    }
    (status, got)
}

// A browser's headers: its credential and the position of this request.
fn person(credential: Bytes, p: u64) -> List[std.http_client.Header] {
    let mut auth = string.from("Bearer ")
    string.push(mut auth, std.base64.encode_string(credential))
    let mut at = string.new()
    string.push_u64(mut at, p)
    let mut out: List[std.http_client.Header] = list.new()
    list.push(mut out, std.http_client.Header(name: "Authorization", value: Public(string.into_bytes(take auth))))
    list.push(mut out, std.http_client.Header(name: "Hirsel-Position", value: Public(string.into_bytes(take at))))
    out
}

fn json[V: codec](v: V) -> Bytes {
    let format: std.json.Format[V] = result.unwrap(std.json.interop())
    string.into_bytes(result.unwrap(std.json.to_string(format, v)))
}

// Reads the stream until a row shows status `until`, folding each event into `rows` by
// position; false when the stream ended first.
fn read_until(mut c: std.http_client.Connection, mut decoder: std.sse.Decoder, mut rows: List[(u64, Bytes)], until: String) -> bool waits {
    read_until_row(mut c, mut decoder, mut rows, until, 0u64)
}

fn read_until_row(mut c: std.http_client.Connection, mut decoder: std.sse.Decoder, mut rows: List[(u64, Bytes)], until: String, at: u64) -> bool waits {
    let format: std.json.Format[harness.gateway_http.Shown] = result.unwrap(std.json.interop())
    let mut chunk: Bytes = list.with_capacity(8192u64)
    let mut reached = false
    let mut present = false
    for row in rows {
        if row.0 == at {
            present = true
        }
    }
    loop {
        match std.http_client.read(mut c, mut chunk) {
            Ok(0u64) => return false,
            Ok(_) => (),
            Error(_) => return false
        }
        let fed = std.sse.feed(mut decoder, chunk, fn(name: Bytes, data: Bytes, event_id: Bytes) -> std.sse.FeedControl[()] {
            if name != b"message" {
                return Continue
            }
            let Ok(row) = std.json.decode_typed(format, std.http.copy_bytes(data), 65536u64) else {
                return Fail(())
            }
            if let Status(text) = row.line {
                reached = text == until
            }
            if row.at == at {
                present = true
            }
            let mut kept: List[(u64, Bytes)] = list.new()
            while let Some((p, take old)) = list.pop(mut rows) {
                if p != row.at {
                    list.push(mut kept, (p, take old))
                }
            }
            list.push(mut kept, (row.at, bytes_of(row.line)))
            rows = take kept
            Continue
        })
        if let Error(_) = fed {
            return false
        }
        list.clear(mut chunk)
        if reached && present {
            return true
        }
    }
}

// The rows, hand-derived from the script: the status at position 0, then each entry's
// line one past its position (the system patch at 1 has none).
fn row_of(at: u64, v: harness.View) -> (u64, Bytes) {
    (at, bytes_of(v))
}

fn rows_want(take status: String, finished_run: bool) -> List[(u64, Bytes)] {
    let mut want: List[(u64, Bytes)] = list.new()
    list.push(mut want, row_of(0u64, Status(take status)))
    list.push(mut want, row_of(1u64, Line("user", "bump it")))
    list.push(mut want, row_of(3u64, Line("assistant", "")))
    if finished_run {
        list.push(mut want, row_of(4u64, Line("tool", "c1")))
        list.push(mut want, row_of(5u64, Line("assistant", "done")))
    }
    want
}

fn same_rows(got: List[(u64, Bytes)], want: List[(u64, Bytes)]) -> bool {
    if list.len(got) != list.len(want) {
        return false
    }
    for w in want {
        let mut found = false
        for g in got {
            if g.0 == w.0 && g.1 == w.1 {
                found = true
            }
        }
        if !found {
            return false
        }
    }
    true
}

// Waits up to five seconds for the session's place to be down, as the gateway saw it.
fn down_within(door: harness.gateway.Door, id: u64, clock: Clock) -> Option[store.local.Marks] waits {
    for i in 0u64 .. 100u64 {
        let m = harness.gateway.marks(door, id)
        if m.downs >= 1u64 && m.ups == m.downs {
            return Some(m)
        }
        std.clock.sleep_ns(clock, 50000000u64)
    }
    None
}

// Law H1 (the front holds the stream, not the place): a browser's event stream on a
// session shows the run up to its approval wait, the place then stops by itself under
// the open stream and stays stopped while nobody acts, and the approval posted through
// the front wakes it and the same stream shows the run's end. Oracle: the hand-derived
// rows, and no start or stop in a quiet second (more than three idle times). The answer
// is the first check that failed, or 0.
pub fn law_front_holds_stream(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> u64 waits {
    tool_stream(parent, clock, random, tasks, net, false, false)
}

fn tool_stream(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, enabled: bool, fork: bool) -> u64 waits {
    let mut name = string.with_capacity(32u64)
    let root = result.unwrap(host.mkdtemp(parent, mut name))
    let (asks, inbox): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let modelling = task.spawn(tasks, bytes 1048576u64, take inbox, model_service)
    let hub = harness.preview.start(tasks, 1048576u64, 4096u64)
    let (tallies, held): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let way: harness.gateway.Doorway = harness.gateway.doorway()
    let door = harness.gateway.door_of(way)
    let worker_port = if enabled {
        Some(harness.preview.door(hub))
    } else {
        None
    }
    let seed = Services(model: take asks, tallies: take tallies, door: harness.gateway.door_of(way), name: "", tasks: tasks, clock: clock, random: random, net: net, preview: take worker_port, chunks: 0u64)
    let config = harness.gateway.GatewayConfig(root: root, options: store.triggers.law_options(), migrate: code.describe(harness.migrate), factory: session_factory(), max_sessions: if fork { 2u64 } else { 1u64 }, idle_ms: IDLE_MS, place_bytes: 67108864u64, tasks: tasks, clock: clock, random: random, net: net, watch: None, seed: take seed)
    let g = match harness.gateway.gateway(take way, take config) {
        Ok(take made) => take made,
        Error(_) => return 1u64
    }
    let (listener, at) = result.unwrap(host.listen(net, local(0u16), 16u16))
    let front_port = if enabled {
        Some(harness.preview.door(hub))
    } else {
        None
    }
    let front = harness.gateway_http.Front(bind: code.describe(store.ingress.caller), bind_bytes: 4096u64, bind_steps: 65536u64, authority: string.into_bytes("localhost"), submit: store.client.transact_entry(code.describe(submit_entry)), decide: store.client.transact_entry(code.describe(decide_entry)), keys: result.unwrap(store.client.entry_keys(code.describe(place))), socket: wire().socket, agent: "scripted", narrow: All, preview: take front_port, tasks: tasks, clock: clock, random: random, net: net, tail_lines: 64u64, within_ms: WITHIN_MS, beat_ms: 200u64, conn_bytes: EFFECT_GRANT, conns_max: 4u64, head_max: 8192u64, body_max: 65536u64)
    let served = harness.gateway_http.serve(door, take front, take listener)
    let port = at.port
    let me = store.ingress.credential(random)
    let (created, made) = http(net, clock, port, "POST", "/sessions", person(me, 0u64), string.into_bytes("first"))
    if created != 201u16 {
        return 1u64
    }
    if made != b"0" {
        return 2u64
    }
    let events = std.http_client.Request(method: "GET", target: "/sessions/0/events", headers: person(me, 0u64), body: Fixed(0u64))
    let Ok(take opened) = std.http_client.dial(net, local(port), "127.0.0.1", clock, events, std.clock.deadline_after_ms(host.mono_ns(clock), 30000u64)) else {
        return 3u64
    }
    let mut stream = take opened
    if let Error(_) = std.http_client.finish_request(mut stream, 1073741824u64) {
        return 4u64
    }
    if std.http_client.status(std.http_client.head(stream)) != 200u16 {
        return 5u64
    }
    let mut decoder = std.sse.decoder(65536u64)
    let mut rows: List[(u64, Bytes)] = list.new()
    let (posted, _) = http(net, clock, port, "POST", "/sessions/0/messages", person(me, 0u64), json(harness.Submit(client_key: "k1", text: "bump it")))
    if posted != 202u16 {
        return 6u64
    }
    let r1 = read_until(mut stream, mut decoder, mut rows, "waiting")
    if !r1 {
        return 7u64
    }
    if !same_rows(rows, rows_want("waiting", false)) {
        return 8u64
    }
    let Some(asleep) = down_within(door, 0u64, clock) else {
        return 9u64
    }
    std.clock.sleep_ns(clock, 1000000000u64)
    let later = harness.gateway.marks(door, 0u64)
    if later.ups != asleep.ups || later.downs != asleep.downs {
        return 10u64
    }
    let key = harness.approval_key("bump", 1u64, Inline(string.into_bytes("{}")))
    let (ruled, ruling) = http(net, clock, port, "POST", "/sessions/0/decisions", person(me, 1u64), json(harness.Decision(run: 0u64, round: 0u64, ordinal: 0u64, key: take key, allow: true)))
    if ruled != 200u16 {
        return 11u64
    }
    if ruling != json((Approved : harness.Ruling)) {
        return 12u64
    }
    if enabled {
        let Some(tool) = first_draft(mut stream, mut decoder) else {
            return 16u64
        }
        if tool.key.run != 0u64 || tool.key.entry != 3u64 || tool.key.tool != Some(0u64) || tool.text != "running tool" {
            return 17u64
        }
        let Ok(let_go) = channel.receive(held) else {
            return 18u64
        }
        // A read during the run: the open stream holds one of the place's wire sessions,
        // so the page needs another, and it must not wait for the held tool.
        let (mid_run, _) = http(net, clock, port, "GET", "/sessions/0/history?before=4&lines=2", person(me, 0u64), list.new())
        if mid_run != 200u16 {
            return 19u64
        }
        // A message during the run is answered at once: the session has one active run,
        // so the place says Busy rather than holding the request until the turn ends.
        let (busy, said) = http(net, clock, port, "POST", "/sessions/0/messages", person(me, 2u64), json(harness.Submit(client_key: "k2", text: "again")))
        if busy != 202u16 || said != json((Busy : harness.Disposition)) {
            return 20u64
        }
        let _ = channel.send(let_go, ())
    }
    let r2 = read_until(mut stream, mut decoder, mut rows, "answered")
    if !r2 {
        return 13u64
    }
    if !same_rows(rows, rows_want("answered", true)) {
        return 14u64
    }
    let paged = tail_and_history(net, clock, port, me)
    if paged != 0u64 {
        return 40u64 + paged
    }
    if fork {
        let checked = fork_history(door, net, clock, port, me)
        if checked != 0u64 { return 60u64 + checked }
    }
    harness.gateway_http.halt(take served)
    let mut tail: Bytes = list.with_capacity(4096u64)
    let ended = loop {
        match std.http_client.read(mut stream, mut tail) {
            Ok(0u64) => break true,
            Ok(_) => list.clear(mut tail),
            Error(_) => break true
        }
    }
    if !ended {
        return 15u64
    }
    let _ = harness.gateway.stop(take g)
    let _ = task.join(take modelling)
    harness.preview.stop(take hub)
    result.unwrap(std.dir.remove_all(parent, name))
    0u64
}

// A fresh stream asking for a two-line tail starts there: the status and the rows of the
// last two entries (positions 3 and 4). Paging back from its oldest row with a pinned
// cutoff gives the rest, and the stream and pages together are the whole transcript,
// as the hand-derived rows say. The answer is the first check that failed, or 0.
fn tail_and_history(net: Net, clock: Clock, port: u16, me: Bytes) -> u64 waits {
    let Ok(take opened) = browser_at(net, clock, port, me, "/sessions/0/events?tail=2") else {
        return 1u64
    }
    let mut fresh = take opened
    let mut decoder = std.sse.decoder(65536u64)
    let mut rows: List[(u64, Bytes)] = list.new()
    if !read_until_row(mut fresh, mut decoder, mut rows, "answered", 5u64) {
        return 2u64
    }
    let _ = take fresh
    let mut tail: List[(u64, Bytes)] = list.new()
    list.push(mut tail, row_of(0u64, Status("answered")))
    list.push(mut tail, row_of(4u64, Line("tool", "c1")))
    list.push(mut tail, row_of(5u64, Line("assistant", "done")))
    if !same_rows(rows, tail) {
        return 3u64
    }
    let format: std.json.Format[harness.gateway_http.Page] = result.unwrap(std.json.interop())
    let mut before = 4u64
    let mut pages = 0u64
    while before > 1u64 {
        let mut target = string.from("/sessions/0/history?before=")
        string.push_u64(mut target, before)
        string.push(mut target, "&lines=2")
        let (status, body) = http(net, clock, port, "GET", target, person(me, 0u64), list.new())
        if status != 200u16 {
            return 4u64
        }
        let Ok(page) = std.json.decode_typed(format, clone(body), 65536u64) else {
            return 5u64
        }
        if page.from >= before {
            return 6u64
        }
        for r in page.rows {
            if r.at < page.from || r.at >= before {
                return 7u64
            }
            list.push(mut rows, (r.at, bytes_of(r.line)))
        }
        before = page.from
        pages += 1u64
    }
    if pages != 2u64 {
        return 8u64
    }
    if !same_rows(rows, rows_want("answered", true)) {
        return 9u64
    }
    let (refused, _) = http(net, clock, port, "GET", "/sessions/0/history?before=4&lines=0", person(me, 0u64), list.new())
    if refused != 400u16 {
        return 10u64
    }
    0u64
}

// The source's five entries come from the scripted tool round. The fork reads
// them through the host, which waits for the source's place, still live after
// its turn, to stop first. A fork owns that pinned prefix even after the
// source is deleted. Only its two new entries precede the first cut; paging
// from the cut yields the source rows.
fn fork_history(door: harness.gateway.Door, net: Net, clock: Clock, port: u16, me: Bytes) -> u64 waits {
    let owner = result.unwrap(store.ingress.caller((), me))
    let Ok(1u64) = harness.gateway.fork(door, 0u64, 5u64, b"fork", take owner) else {
        return 2u64
    }
    if let Error(_) = harness.gateway.delete(door, 0u64) {
        return 3u64
    }
    let (posted, _) = http(net, clock, port, "POST", "/sessions/1/messages", person(me, 0u64), json(harness.Submit(client_key: "f1", text: "fork only")))
    if posted != 202u16 { return 4u64 }
    let Some(_) = down_within(door, 1u64, clock) else { return 15u64 }

    let Ok(take c) = browser_at(net, clock, port, me, "/sessions/1/events?tail=1") else { return 5u64 }
    let mut stream = take c
    let mut decoder = std.sse.decoder(65536u64)
    let mut rows: List[(u64, Bytes)] = list.new()
    if !read_until_row(mut stream, mut decoder, mut rows, "answered", 8u64) { return 6u64 }
    let _ = take stream
    let format: std.json.Format[harness.gateway_http.Page] = result.unwrap(std.json.interop())
    let (newer, data) = http(net, clock, port, "GET", "/sessions/1/history?before=8&lines=7", person(me, 0u64), list.new())
    if newer != 200u16 { return 7u64 }
    let Ok(page) = std.json.decode_typed(format, clone(data), 65536u64) else { return 8u64 }
    if page.from != 6u64 || list.len(page.rows) != 1u64 || page.rows[0].at != 6u64 { return 9u64 }
    list.push(mut rows, (6u64, bytes_of(page.rows[0].line)))

    let (older, prior_data) = http(net, clock, port, "GET", "/sessions/1/history?before=6&lines=7", person(me, 0u64), list.new())
    if older != 200u16 { return 10u64 }
    let Ok(prior) = std.json.decode_typed(format, clone(prior_data), 65536u64) else { return 11u64 }
    if prior.from != 1u64 { return 12u64 }
    for r in prior.rows { list.push(mut rows, (r.at, bytes_of(r.line))) }
    let mut expected = rows_want("answered", true)
    list.push(mut expected, row_of(6u64, Line("user", "fork only")))
    list.push(mut expected, row_of(8u64, Line("assistant", "done")))
    if !same_rows(rows, expected) { return 13u64 }
    let mut fresh = result.unwrap(browser_at(net, clock, port, me, "/sessions/1/events"))
    let mut fresh_decoder = std.sse.decoder(65536u64)
    let mut full: List[(u64, Bytes)] = list.new()
    if !read_until_row(mut fresh, mut fresh_decoder, mut full, "answered", 8u64) || !same_rows(full, expected) { return 14u64 }
    0u64
}

@test
fn test_front_fork_history(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = tool_stream(parent, clock, random, tasks, net, false, true)
    if bad == 0u64 { Ok(()) } else { Error(bad) }
}

@test
fn test_front_holds_stream(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = law_front_holds_stream(parent, clock, random, tasks, net)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

@test
fn test_front_shows_tool_progress(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let bad = tool_stream(parent, clock, random, tasks, net, true, false)
    if bad == 0u64 {
        Ok(())
    } else {
        Error(bad)
    }
}

// A browser opens a new stream with no cursor. A preview-enabled front uses
// its bearer credential to bind the same Caller as the message POST.
fn browser(net: Net, clock: Clock, port: u16, credential: Bytes) -> Result[std.http_client.Connection, u64] waits {
    browser_at(net, clock, port, credential, "/sessions/0/events")
}

fn browser_at(net: Net, clock: Clock, port: u16, credential: Bytes, target: String) -> Result[std.http_client.Connection, u64] waits {
    let request = std.http_client.Request(method: "GET", target: string.from(target), headers: person(credential, 0u64), body: Fixed(0u64))
    let until = std.clock.deadline_after_ms(host.mono_ns(clock), WITHIN_MS)
    let Ok(take c) = std.http_client.dial(net, local(port), "127.0.0.1", clock, request, until) else {
        return Error(1u64)
    }
    let mut stream = take c
    if let Error(_) = std.http_client.finish_request(mut stream, 1073741824u64) {
        return Error(2u64)
    }
    if std.http_client.status(std.http_client.head(stream)) != 200u16 {
        return Error(3u64)
    }
    Ok(take stream)
}

fn first_draft(mut c: std.http_client.Connection, mut dec: std.sse.Decoder) -> Option[harness.preview.Draft] waits {
    let format: std.json.Format[harness.preview.Draft] = result.unwrap(std.json.interop())
    let mut chunk: Bytes = list.with_capacity(8192u64)
    loop {
        match std.http_client.read(mut c, mut chunk) {
            Ok(0u64) => return None,
            Ok(_) => (),
            Error(_) => return None
        }
        let mut seen: Option[harness.preview.Draft] = None
        let fed = std.sse.feed(mut dec, chunk, fn(name: Bytes, data: Bytes, event_id: Bytes) -> std.sse.FeedControl[()] {
            if name == b"preview" {
                let Ok(take p) = std.json.decode_typed(format, std.http.copy_bytes(data), 65536u64) else {
                    return Fail(())
                }
                seen = Some(take p)
            }
            Continue
        })
        if let Error(_) = fed {
            return None
        }
        if let Some(take p) = take seen {
            return Some(take p)
        }
        list.clear(mut chunk)
    }
}

// Folds the draft stream from `first` until the row at `at` shows the run answered. Each
// delta must begin at the end of the draft held so far, and every draft must be the
// answer's text at its offset. The answer is the first check that failed, or 0.
fn fold_drafts(mut c: std.http_client.Connection, mut dec: std.sse.Decoder, take first: harness.preview.Draft, mut rows: List[(u64, Bytes)], at: u64) -> u64 waits {
    let snapshot: std.json.Format[harness.preview.Draft] = result.unwrap(std.json.interop())
    let delta: std.json.Format[harness.gateway_http.PreviewDelta] = result.unwrap(std.json.interop())
    let row_format: std.json.Format[harness.gateway_http.Shown] = result.unwrap(std.json.interop())
    let answer = preview_answer().text
    let mut offset = first.offset
    let mut text: String = clone(first.text)
    let mut bad = 0u64
    let mut answered = false
    let mut present = false
    let mut chunk: Bytes = list.with_capacity(8192u64)
    while !(answered && present) {
        match std.http_client.read(mut c, mut chunk) {
            Ok(0u64) => return 1u64,
            Ok(_) => (),
            Error(_) => return 1u64
        }
        let fed = std.sse.feed(mut dec, chunk, fn(name: Bytes, data: Bytes, event_id: Bytes) -> std.sse.FeedControl[()] {
            if name == b"preview" {
                let Ok(take p) = std.json.decode_typed(snapshot, std.http.copy_bytes(data), 65536u64) else {
                    return Fail(())
                }
                let harness.preview.Draft(offset: o, text: take t, ..) = take p
                offset = o
                text = take t
            } else if name == b"preview-delta" {
                let Ok(take d) = std.json.decode_typed(delta, std.http.copy_bytes(data), 65536u64) else {
                    return Fail(())
                }
                if d.at != offset + string.byte_len(text) {
                    bad = 2u64;
                    return Fail(())
                }
                string.push(mut text, d.text)
            } else if name == b"message" {
                let Ok(row) = std.json.decode_typed(row_format, std.http.copy_bytes(data), 65536u64) else {
                    return Fail(())
                }
                if let Status(s) = row.line {
                    answered = s == "answered"
                }
                if row.at == at {
                    present = true
                }
                list.push(mut rows, (row.at, bytes_of(row.line)))
            }
            if offset + string.byte_len(text) > string.byte_len(answer) || text != string.slice(answer, offset, offset + string.byte_len(text)) {
                bad = 3u64;
                return Fail(())
            }
            Continue
        })
        if let Error(_) = fed {
            return if bad == 0u64 {
                4u64
            } else {
                bad
            }
        }
        list.clear(mut chunk)
    }
    0u64
}

fn answer_rows() -> List[(u64, Bytes)] {
    let mut expected: List[(u64, Bytes)] = list.new()
    list.push(mut expected, row_of(0u64, Status("answered")))
    list.push(mut expected, row_of(1u64, Line("user", "preview it")))
    list.push(mut expected, row_of(3u64, Line("assistant", string.from(preview_answer().text))))
    expected
}

fn committed_version(dir: Dir) -> u64 waits {
    let reader = result.unwrap(store.open_read_only(dir, store.triggers.law_options()))
    store.version(store.read_only_snapshot(reader))
}

fn preview_run(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net, chunks: u64, enabled: bool, revoke: bool) -> Result[u64, u64] waits {
    let mut name = string.with_capacity(32u64)
    let root = result.unwrap(host.mkdtemp(parent, mut name))
    let hub = harness.preview.start(tasks, 1048576u64, 4096u64)
    let (asks, inbox): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let (tallies, _held): (Sender[Sender[()]], Receiver[Sender[()]]) = channel.new(4u64)
    let way: harness.gateway.Doorway = harness.gateway.doorway()
    let door = harness.gateway.door_of(way)
    let worker_port = if enabled {
        Some(harness.preview.door(hub))
    } else {
        None
    }
    let seed = Services(model: take asks, tallies: take tallies, door: harness.gateway.door_of(way), name: "", tasks: tasks, clock: clock, random: random, net: net, preview: take worker_port, chunks: chunks)
    let config = harness.gateway.GatewayConfig(root: root, options: store.triggers.law_options(), migrate: code.describe(harness.migrate), factory: session_factory(), max_sessions: 1u64, idle_ms: IDLE_MS, place_bytes: 67108864u64, tasks: tasks, clock: clock, random: random, net: net, watch: None, seed: take seed)
    let Ok(take g) = harness.gateway.gateway(take way, take config) else {
        return Error(10u64)
    }
    let (listener, at) = result.unwrap(host.listen(net, local(0u16), 16u16))
    let (take traced, reads, take tracing) = harness.preview.trace_reads(tasks, harness.preview.door(hub))
    let front_port = if enabled {
        Some(take traced)
    } else {
        None
    }
    let front = harness.gateway_http.Front(bind: code.describe(store.ingress.caller), bind_bytes: 4096u64, bind_steps: 65536u64, authority: string.into_bytes("localhost"), submit: store.client.transact_entry(code.describe(submit_entry)), decide: store.client.transact_entry(code.describe(decide_entry)), keys: result.unwrap(store.client.entry_keys(code.describe(place))), socket: wire().socket, agent: "scripted", narrow: All, preview: take front_port, tasks: tasks, clock: clock, random: random, net: net, tail_lines: 64u64, within_ms: WITHIN_MS, beat_ms: 50u64, conn_bytes: EFFECT_GRANT, conns_max: 4u64, head_max: 8192u64, body_max: 65536u64)
    let served = harness.gateway_http.serve(door, take front, take listener)
    let port = at.port
    let me = store.ingress.credential(random)
    let (created, _) = http(net, clock, port, "POST", "/sessions", person(me, 0u64), string.into_bytes("preview"))
    if created != 201u16 {
        return Error(11u64)
    }
    let dir = result.unwrap(std.dir.narrow(root, "s0"))
    let before = committed_version(dir)
    let (posted, _) = http(net, clock, port, "POST", "/sessions/0/messages", person(me, 0u64), json(harness.Submit(client_key: "p1", text: "preview it")))
    if posted != 202u16 {
        return Error(12u64)
    }
    let Ok(first) = channel.receive(inbox) else {
        return Error(14u64)
    }
    let mut tab = browser(net, clock, port, me)?
    let mut decoder = std.sse.decoder(65536u64)
    let mut rows: List[(u64, Bytes)] = list.new()
    if !read_until(mut tab, mut decoder, mut rows, "thinking") {
        return Error(13u64)
    }
    let _ = channel.send(first, ())
    let mut shown_key: Option[harness.preview.Key] = None
    if enabled {
        let Some(p) = first_draft(mut tab, mut decoder) else {
            return Error(15u64)
        }
        if p.key.run != 0u64 || p.key.entry != 2u64 || p.key.tool != None || p.seq != 1u64 || p.offset != 0u64 || p.text != string.slice(preview_answer().text, 0u64, 10000u64 / chunks) {
            return Error(16u64)
        }
        shown_key = Some(p.key)
    }
    if revoke {
        let outsider = store.ingress.credential(random)
        let (stranger, _) = http(net, clock, port, "GET", "/sessions/0/events", person(outsider, 0u64), list.new())
        if stranger != 403u16 || !denied_history(net, clock, port, outsider) {
            return Error(40u64)
        }
        let (status, take body) = http(net, clock, port, "GET", "/sessions/0/history?before=2&lines=1", person(me, 0u64), list.new())
        let page_format: std.json.Format[harness.gateway_http.Page] = result.unwrap(std.json.interop())
        let Ok(page) = std.json.decode_typed(page_format, take body, 65536u64) else { return Error(41u64) }
        if status != 200u16 || page.from != 1u64 || list.len(page.rows) != 1u64 ||
            page.rows[0u64].at != 1u64 || bytes_of(page.rows[0u64].line) != bytes_of((Line("user", "preview it") : harness.View)) {
            return Error(41u64)
        }

        let mut other = idle_preview_tab(net, clock, port, me, reads)?
        let change = store.fixture.transact_entry(code.describe(revoke_reader))
        let Ok(Ok(())) = call_routed(door, 0u64, me, 1u64, change, (), tasks, clock, random, net) else {
            return Error(42u64)
        }
        let revoked_at = host.mono_ns(clock)
        if !ended_without_rows(mut tab) || host.mono_ns(clock) - revoked_at > 50000000u64 {
            return Error(43u64)
        }
        if !ended_without_rows(mut other) { return Error(43u64) }
        let Ok(rest) = channel.receive(inbox) else { return Error(45u64) }
        let _ = channel.send(rest, ())
        if !denied_history(net, clock, port, me) { return Error(47u64) }
        let (returned, _) = http(net, clock, port, "GET", "/sessions/0/events", person(me, 0u64), list.new())
        if returned != 403u16 {
            return Error(44u64)
        }

        let Some(_) = down_within(door, 0u64, clock) else { return Error(46u64) }
        harness.gateway_http.halt(take served)
        let _ = task.cancel_join(take tracing)
        let _ = harness.gateway.stop(take g)
        harness.preview.stop(take hub)
        result.unwrap(std.dir.remove_all(parent, name))
        return Ok(0u64)
    }
    // Close the original connection while the worker still waits. Reopen only
    // after all work and the trigger's terminal journal commit are durable.
    let _ = take tab
    let Ok(rest) = channel.receive(inbox) else {
        return Error(17u64)
    }
    let _ = channel.send(rest, ())
    let Some(_) = down_within(door, 0u64, clock) else {
        return Error(18u64)
    }
    let committed = committed_version(dir) - before
    if committed != 8u64 {
        return Error(100u64 + committed)
    }
    let mut returned = browser(net, clock, port, me)?
    let mut again_decoder = std.sse.decoder(65536u64)
    let mut fresh_decoder = std.sse.decoder(65536u64)
    let mut again: List[(u64, Bytes)] = list.new()
    let mut fresh: List[(u64, Bytes)] = list.new()
    if !read_until_row(mut returned, mut again_decoder, mut again, "answered", 3u64) {
        return Error(1900u64 + list.len(again))
    }
    let mut other = browser(net, clock, port, me)?
    if !read_until_row(mut other, mut fresh_decoder, mut fresh, "answered", 3u64) {
        return Error(20u64)
    }
    if !same_rows(again, answer_rows()) || !same_rows(fresh, answer_rows()) {
        return Error(21u64)
    }
    let _ = take other
    if chunks == 10u64 {
        if let Some(committed_key) = shown_key {
            let Some(_) = down_within(door, 0u64, clock) else {
                return Error(30u64)
            }
            let d = harness.preview.door(hub)
            let owner = result.unwrap(store.ingress.caller((), me))
            let (posted_next, _) = http(net, clock, port, "POST", "/sessions/0/messages", person(me, 1u64), json(harness.Submit(client_key: "p2", text: "preview it")))
            if posted_next != 202u16 {
                return Error(2200u64 + int.widen(posted_next))
            }
            if !read_until_row(mut returned, mut again_decoder, mut again, "thinking", 4u64) {
                return Error(23u64)
            }
            // The next answer keeps the same stream active. A synthetic late
            // source for the committed entry reaches the hub before the real
            // next worker has permission from the fixture to send any text.
            let witness = option.unwrap(harness.preview.observe(d, "s0", owner))
            let tgt = harness.preview.target(d, "s0", clock)
            let mut late = option.unwrap(harness.preview.source(tgt, owner, committed_key))
            harness.preview.delta(mut late, "late after commit")
            let Some(in_hub) = harness.preview.read(witness) else {
                return Error(24u64)
            }
            if in_hub.text != "late after commit" {
                return Error(25u64)
            }
            std.clock.sleep_ns(clock, 60000000u64)
            let Ok(next_delta) = channel.receive(inbox) else {
                return Error(26u64)
            }
            let _ = channel.send(next_delta, ())
            let Some(next_draft) = first_draft(mut returned, mut again_decoder) else {
                return Error(27u64)
            }
            if next_draft.key.run != 1u64 || next_draft.key.entry != 4u64 {
                return Error(28u64)
            }
            let Ok(next_rest) = channel.receive(inbox) else {
                return Error(29u64)
            }
            let _ = channel.send(next_rest, ())
            let folded = fold_drafts(mut returned, mut again_decoder, clone(next_draft), mut again, 5u64)
            if folded != 0u64 {
                return Error(3000u64 + folded)
            }
            harness.preview.unobserve(take witness)
            let _ = take late
        }
    }
    let _ = take returned
    harness.gateway_http.halt(take served)
    let _ = task.cancel_join(take tracing)
    let _ = harness.gateway.stop(take g)
    harness.preview.stop(take hub)
    result.unwrap(std.dir.remove_all(parent, name))
    Ok(committed)
}

// No status, transcript or preview bytes reach a denied Caller. The live run
// is held after its first draft so the ACL commit alone must end its stream.
fn ended_without_rows(mut c: std.http_client.Connection) -> bool waits {
    let mut chunk: Bytes = list.with_capacity(8192u64)
    let mut dec = std.sse.decoder(65536u64)
    loop {
        match std.http_client.read(mut c, mut chunk) {
            Ok(0u64) => return true,
            Ok(_) => (),
            Error(_) => return false,
        }
        if let Error(_) = std.sse.feed(mut dec, chunk, fn(name: Bytes, data: Bytes, event_id: Bytes) -> std.sse.FeedControl[()] { Fail(()) }) {
            return false
        }
        list.clear(mut chunk)
    }
}

fn denied_history(net: Net, clock: Clock, port: u16, who: Bytes) -> bool waits {
    let (status, page) = http(net, clock, port, "GET", "/sessions/0/history?before=2&lines=1", person(who, 0u64), list.new())
    status == 403u16 && list.len(page) == 0u64
}

// The cold no-tool turn commits place activation, keyed admission, submit,
// granted start, begin, settle, advance on the receipt, and the granted
// trigger's terminal record. Its deadline stays in the future.
@test
fn test_preview_journal_and_reconnect(parent: Dir, clock: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let disabled = preview_run(parent, clock, random, tasks, net, 10u64, false, false)?
    let short = preview_run(parent, clock, random, tasks, net, 10u64, true, false)?
    let long = preview_run(parent, clock, random, tasks, net, 10000u64, true, false)?
    if disabled != 8u64 {
        return Error(100u64 + disabled)
    }
    if short != 8u64 {
        return Error(200u64 + short)
    }
    if long != 8u64 {
        return Error(300u64 + long)
    }
    Ok(())
}

// A paused subscriber never polls while the fast one makes progress. The
// 16-byte cap holds two eight-byte deltas, so from the second delta on the
// draft is the last 16 bytes, at offset 8(i + 1) - 16. A retry replaces the
// old key before its first delta.
@test
fn test_preview_slow_observer_and_retry(tasks: Tasks, clock: Clock) -> Result[(), u64] waits {
    let hub = harness.preview.start(tasks, 1048576u64, 16u64)
    let d = harness.preview.door(hub)
    let owner = store.Caller(issuer: 2u8, subject: string.into_bytes("run owner"))
    let stranger = store.Caller(issuer: 2u8, subject: string.into_bytes("different caller"))
    let slow = option.unwrap(harness.preview.observe(d, "s0", owner))
    let fast = option.unwrap(harness.preview.observe(d, "s0", owner))
    let other = option.unwrap(harness.preview.observe(d, "s0", stranger))
    let target = harness.preview.target(d, "s0", clock)
    let dispatch = store.triggers.Id(store_hi: 1u64, store_lo: 2u64, branch: 0u32, version: 3u64, index: 0u64)
    let key = harness.preview.Key(dispatch: dispatch, run: 5u64, entry: 9u64, tool: None, attempt: 1u64)
    let mut old = option.unwrap(harness.preview.source(target, owner, key))
    for i in 0u64 .. 1024u64 {
        harness.preview.delta(mut old, "abcdefgh")
        let Some(p) = harness.preview.read(fast) else {
            return Error(1u64)
        }
        let expected = if i == 0u64 {
            "abcdefgh"
        } else {
            "abcdefghabcdefgh"
        }
        let offset = if i == 0u64 {
            0u64
        } else {
            8u64 * (i + 1u64) - 16u64
        }
        if p.seq != i + 1u64 || p.text != expected || p.offset != offset {
            return Error(2u64)
        }
    }
    let Some(only) = harness.preview.read(slow) else {
        return Error(3u64)
    }
    if only.seq != 1024u64 || only.text != "abcdefghabcdefgh" || only.offset != 8176u64 {
        return Error(4u64)
    }
    if let Some(_) = harness.preview.read(other) {
        return Error(5u64)
    }
    let retry = harness.preview.Key(dispatch: dispatch, run: 5u64, entry: 9u64, tool: None, attempt: 2u64)
    let mut new = option.unwrap(harness.preview.source(target, owner, retry))
    harness.preview.delta(mut old, "stale")
    if let Some(_) = harness.preview.read(fast) {
        return Error(6u64)
    }
    harness.preview.delta(mut new, "fresh")
    let Some(replacement) = harness.preview.read(fast) else {
        return Error(7u64)
    }
    if replacement.key != retry || replacement.seq != 1u64 || replacement.text != "fresh" || replacement.offset != 0u64 {
        return Error(8u64)
    }
    let recent = option.unwrap(harness.preview.observe(d, "s0", owner))
    let Some(latest_draft) = harness.preview.read(recent) else {
        return Error(9u64)
    }
    if latest_draft.text != "fresh" {
        return Error(10u64)
    }
    harness.preview.unobserve(take slow)
    harness.preview.unobserve(take fast)
    harness.preview.unobserve(take recent)
    let rejoined = option.unwrap(harness.preview.observe(d, "s0", owner))
    if let Some(_) = harness.preview.read(rejoined) {
        return Error(11u64)
    }
    harness.preview.delta(mut new, "after detach")
    let Some(after_detach) = harness.preview.read(rejoined) else {
        return Error(12u64)
    }
    if after_detach.text != "after detach" || after_detach.offset != 5u64 {
        return Error(13u64)
    }
    harness.preview.revoke(d, "s0", owner)
    harness.preview.delta(mut new, "after revoke")
    if let Some(_) = harness.preview.read(rejoined) {
        return Error(14u64)
    }
    harness.preview.unobserve(take rejoined)
    harness.preview.unobserve(take other)
    harness.preview.stop(take hub)
    Ok(())
}

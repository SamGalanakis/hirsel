// LANG-13 / OWN-11: typed StaticFn calls retain the ordinary argument loans.
pub type Tx {
    writes: u64,
    text: String
}

pub fn adapt_mtv[A: codec, R: codec, E: codec](f: StaticFn[fn(mut Tx, take A, u64) -> Result[R, E]], mut tx: Tx, take a: A, n: u64) -> Result[R, E] {
    let _ = code.identity(f)
    let invoke = code.callable(f)
    invoke(mut tx, take a, n)
}

fn number_mtv(mut tx: Tx, take a: u64, n: u64) -> Result[u64, u64] {
    tx.writes += n;
    Ok(a + 1u64)
}

pub fn number_mtv_run() -> u64 {
    let mut tx = Tx(writes: 1u64, text: string.from("held"))
    let a = 7u64
    let r = result.unwrap(adapt_mtv(code.describe(number_mtv), mut tx, take a, 2u64))
    tx.writes * 10u64 + r
}

// expect: run number_mtv_run() = 38
fn text_mtv(mut tx: Tx, take a: String, n: u64) -> Result[String, u64] {
    tx.writes += n;
    Ok(take a)
}

pub fn text_mtv_run() -> u64 {
    let mut tx = Tx(writes: 1u64, text: string.from("held"))
    let a = string.from("ok")
    let r = result.unwrap(adapt_mtv(code.describe(text_mtv), mut tx, take a, 2u64))
    tx.writes * 10u64 + list.len(string.as_bytes(r))
}

// expect: run text_mtv_run() = 32

// Durable wake triggers carry only a ParkId. The application action lives in
// the typed state table and may evolve independently of the trigger entry.
fn arm_wake(mut tx: store.Tx, h: Handles, w: Wiring, wake: Wake, at: u64) -> Result[runner.park.ParkId, Refused] {
    Ok(runner.park.until(mut tx, h.wakes, w.entries, w.advance, wake, at) ?=> |_| Storage)
}

fn arm_kick(mut tx: store.Tx, h: Handles, w: Wiring) -> Result[runner.park.ParkId, Refused] {
    let at = now(mut tx)
    arm_wake(mut tx, h, w, Kick, at)
}

fn cancel_wake(mut tx: store.Tx, h: Handles, id: runner.park.ParkId) -> Result[(), Refused] {
    let _ = runner.park.cancel(mut tx, h.wakes, id) ?=> |_| Storage
    Ok(())
}

fn parked_id(phase: EffectPhase) -> Option[runner.park.ParkId] {
    match phase { Parked(id) => Some(id), _ => None }
}

pub fn advance_park[G: send, App: inert + send](mut tx: store.Tx, h: Handles, a: Agent[G, App], w: Wiring, id: runner.park.ParkId) -> Result[(), Refused] {
    let Some(Due(take wake)) = kept(runner.park.take_wake(mut tx, h.wakes, id))? else { return Ok(()) }
    advance(mut tx, h, a, w, take wake)
}

}

fn v6_reply() -> Bytes {
    b"\x01\x01\x00\x48\x21\x12\xa4\x42\xb7\xe7\xa7\x01\xbc\x34\xd6\x86\xfa\x87\xdf\xae\x80\x22\x00\x0b\x74\x65\x73\x74\x20\x76\x65\x63\x74\x6f\x72\x20\x00\x20\x00\x14\x00\x02\xa1\x47\x01\x13\xa9\xfa\xa5\xd3\xf1\x79\xbc\x25\xf4\xb5\xbe\xd2\xb9\xd9\x00\x08\x00\x14\xa3\x82\x95\x4e\x4b\xe6\x7b\xf1\x17\x84\xc9\x7c\x82\x92\xc2\x75\xbf\xe3\xed\x41\x80\x28\x00\x04\xc8\xfb\x0b\x4c"
}

fn long_sha1() -> Bytes {
    b"\x00\x01\x00\x60\x21\x12\xa4\x42\x78\xad\x34\x33\xc6\xad\x72\xc0\x29\xda\x41\x2e\x00\x06\x00\x12\xe3\x83\x9e\xe3\x83\x88\xe3\x83\xaa\xe3\x83\x83\xe3\x82\xaf\xe3\x82\xb9\x00\x00\x00\x15\x00\x1c\x66\x2f\x2f\x34\x39\x39\x6b\x39\x35\x34\x64\x36\x4f\x4c\x33\x34\x6f\x4c\x39\x46\x53\x54\x76\x79\x36\x34\x73\x41\x00\x14\x00\x0b\x65\x78\x61\x6d\x70\x6c\x65\x2e\x6f\x72\x67\x00\x00\x08\x00\x14\xf6\x70\x24\x65\x6d\xd6\x4a\x3e\x02\xb8\xe0\x71\x2e\x85\xc9\xa2\x8c\xa8\x96\x66"
}

fn long_sha256() -> Bytes {
    b"\x00\x01\x00\x90\x21\x12\xa4\x42\x78\xad\x34\x33\xc6\xad\x72\xc0\x29\xda\x41\x2e\x00\x1e\x00\x20\x4a\x3c\xf3\x8f\xef\x69\x92\xbd\xa9\x52\xc6\x78\x04\x17\xda\x0f\x24\x81\x94\x15\x56\x9e\x60\xb2\x05\xc4\x6e\x41\x40\x7f\x17\x04\x00\x15\x00\x29\x6f\x62\x4d\x61\x74\x4a\x6f\x73\x32\x41\x41\x41\x43\x66\x2f\x2f\x34\x39\x39\x6b\x39\x35\x34\x64\x36\x4f\x4c\x33\x34\x6f\x4c\x39\x46\x53\x54\x76\x79\x36\x34\x73\x41\x00\x00\x00\x00\x14\x00\x0b\x65\x78\x61\x6d\x70\x6c\x65\x2e\x6f\x72\x67\x00\x00\x1d\x00\x04\x00\x02\x00\x00\x00\x1c\x00\x20\xb5\xc7\xbf\x00\x5b\x6c\x52\xa2\x1c\x51\xc5\xe8\x92\xf8\x19\x24\x13\x62\x96\xcb\x92\x7c\x43\x14\x93\x09\x27\x8c\xc6\x51\x8e\x65"
}

fn md5_key() -> Bytes {
    b"\xe8\xca\x7a\xd5\x9d\x5e\xb0\x51\x8e\x31\x29\x11\xd2\xda\xb2\xa9"
}

fn sha256_key() -> Bytes {
    b"\xdd\x29\x5a\x61\x3b\x90\x58\xc3\xc2\x3d\x6d\xc7\x16\x5b\xda\x07\x23\x04\xd9\x89\xc9\xd0\xaf\x3a\x8c\x7e\x18\x4b\x4f\x9b\xb4\xa1"
}

fn bare_v6_reply() -> Bytes {
    b"\x01\x01\x00\x38\x21\x12\xa4\x42\xb7\xe7\xa7\x01\xbc\x34\xd6\x86\xfa\x87\xdf\xae\x00\x20\x00\x14\x00\x02\xa1\x47\x01\x13\xa9\xfa\xa5\xd3\xf1\x79\xbc\x25\xf4\xb5\xbe\xd2\xb9\xd9\x00\x08\x00\x14\xee\x33\xa0\x55\x53\x19\xee\xc1\x0a\xd5\xfb\xfd\xf8\x73\x3d\x19\x6e\x55\x2b\x3c\x80\x28\x00\x04\x5d\xed\x71\x86"
}

fn short_key() -> Bytes {
    b"VOkJxbRl1RmTxUk/WvJxBt"
}

const TX: stun_ice.Transaction = stun_ice.Transaction(high: 0xb7e7a701, low: 0xbc34d686fa87dfae)

const IP4: Addr = Addr(ip: V4(0xc0000201), port: 32853)

const IP6: Addr = Addr(ip: V6(0x20010db812345678, 0x0011223344556677), port: 32853)

/// bug: include the whole datagram length in HMAC or omit it from CRC.
/// oracle: RFC 5769 sections 2.1–2.4, RFC 8489 Appendix B.1 with erratum 6268.
@test
fn binding_vectors() -> Result[(), stun_ice.Error] {
    let mut scratch: Bytes = list.with_capacity(192)
    list.fill(mut scratch, 192, 0)
    let req = stun_ice.verify(request(), short_key(), mut scratch)?
    let Some(username) = req.username else {
        fail("RFC 5769 request username missing")
    }
    let Some(role) = req.role else {
        fail("RFC 5769 request role missing")
    }
    if req.transaction != TX || !req.fingerprint || req.nominate || role.role != Controlled || role.tie != 0x932ff9b151263b36 || list.compare_bytes(list.slice(request(), username.lo, username.hi), b"evtj:h6vY") != Equal {
        fail("RFC 5769 request attributes")
    }
    if let Some(0x6e0001ff) = req.priority {} else {
        fail("RFC 5769 request priority")
    }
    let v4 = stun_ice.verify(v4_reply(), short_key(), mut scratch)?
    let v6 = stun_ice.verify(v6_reply(), short_key(), mut scratch)?
    let Some(a4) = v4.mapped else {
        fail("RFC 5769 IPv4 address missing")
    }
    let Some(a6) = v6.mapped else {
        fail("RFC 5769 IPv6 address missing")
    }
    if a4.port != IP4.port || a6.port != IP6.port || v4.transaction != TX || v6.transaction != TX || !v4.fingerprint || !v6.fingerprint {
        fail("RFC 5769 Binding response addresses")
    }
    if let V4(0xc0000201) = a4.ip {} else {
        fail("RFC 5769 IPv4 bytes")
    }
    if let V6(0x20010db812345678, 0x0011223344556677) = a6.ip {} else {
        fail("RFC 5769 IPv6 bytes")
    }
    let _ = stun_ice.verify(long_sha1(), md5_key(), mut scratch)?
    let sha256 = stun_ice.verify(long_sha256(), sha256_key(), mut scratch)?
    if let Sha256 = sha256.integrity {} else {
        fail("RFC 8489 SHA-256 integrity absent")
    }
    if let Error(BadIntegrity) = stun_ice.verify(long_sha256(), md5_key(), mut scratch) {} else {
        fail("wrong long-term key accepted")
    }
    let mut out: Bytes = list.with_capacity(128)
    list.fill(mut out, 128, 0)
    let key = short_key()
    let attempt = bound bytes 0 {
        stun_ice.binding_success(TX, IP6, Sha1, true, key, mut out, mut scratch)
    }
    let count = match attempt {
        Ok(verdict) => verdict?,
        Error(_) => fail("Binding response allocated with caller buffers"),
    }
    if list.compare_bytes(list.slice(out, 0, count), bare_v6_reply()) != Equal {
        fail("IPv6 response differs from independent wire bytes")
    }
    if let Error(BadHeader) = stun_ice.decode(list.slice(request(), 0, 107)) {} else {
        fail("truncated RFC 5769 request accepted")
    }
    Ok(())
}

// RFC 8445 sections 7.3 and 7.3.2 give the transitions and address oracle.
// Python struct, hmac and zlib produced the wire vectors.
fn lite_probe() -> Bytes {
    b"\x00\x01\x00\x44\x21\x12\xa4\x42\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x06\x00\x09\x6c\x69\x74\x65\x3a\x66\x75\x6c\x6c\x00\x00\x00\x00\x24\x00\x04\x6e\x00\x01\xff\x80\x2a\x00\x08\x00\x00\x00\x00\x00\x00\x00\x37\x00\x08\x00\x14\xee\x86\xb5\x30\x48\x3c\x53\xa5\x36\x1b\x99\x58\x86\x19\xe7\x8c\x65\xb6\x06\x02\x80\x28\x00\x04\x19\x88\x5e\xc6"
}

fn lite_nominate() -> Bytes {
    b"\x00\x01\x00\x48\x21\x12\xa4\x42\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0b\x00\x06\x00\x09\x6c\x69\x74\x65\x3a\x66\x75\x6c\x6c\x00\x00\x00\x00\x24\x00\x04\x6e\x00\x01\xff\x80\x2a\x00\x08\x00\x00\x00\x00\x00\x00\x00\x37\x00\x25\x00\x00\x00\x08\x00\x14\x95\x55\x1d\xe2\x75\x94\x32\xa1\x0b\x3c\x93\xb4\xf3\x3c\x15\x83\x38\xf8\x0e\x4e\x80\x28\x00\x04\x76\xbb\x3e\x75"
}

fn lite_reply() -> Bytes {
    b"\x01\x01\x00\x2c\x21\x12\xa4\x42\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0b\x00\x20\x00\x08\x00\x01\x95\x06\xe7\x21\xc0\x4e\x00\x08\x00\x14\x31\xb3\x33\x66\x30\xd1\xd9\x97\xce\x0d\xd6\xa4\x55\x97\x0a\xc0\x2c\x6f\x6e\xa4\x80\x28\x00\x04\x70\x07\x19\xbf"
}

/// bug: nominate the peer's original NAT port instead of the source of USE-CANDIDATE.
/// oracle: RFC 8445 sections 7.3.1.2 and 7.3.2, with independent Binding bytes.
@test
fn lite_nat_rebinding() -> Result[(), stun_ice.IceError] {
    let local = stun_ice.credentials(b"lite", b"LocalPassword1234567890")?
    let base = Addr(ip: V4(0xc0000201), port: 40000)
    let peer_ip = V4(0xc633640c)
    let mut bases: List[stun_ice.Local] = list.new()
    list.push(mut bases, stun_ice.Local(component: 1, base: base))
    let mut agent = stun_ice.lite(take local, take bases)?
    let mut scratch: Bytes = list.with_capacity(160)
    list.fill(mut scratch, 160, 0)
    let mut output: Bytes = list.with_capacity(128)
    list.fill(mut output, 128, 0)
    let original = Addr(ip: peer_ip, port: 46000)
    let rebound = Addr(ip: peer_ip, port: 46100)
    let probe = lite_probe()
    let nominate = lite_nominate()
    let _ = stun_ice.lite_receive(mut agent, base, original, probe, mut output, mut scratch)?
    if let Some(_) = stun_ice.lite_selected(agent, 1) {
        fail("an ordinary connectivity check nominated a path")
    }
    let attempt = bound bytes 0 {
        stun_ice.lite_receive(mut agent, base, rebound, nominate, mut output, mut scratch)
    }
    let count = match attempt {
        Ok(verdict) => verdict?,
        Error(_) => fail("an ICE-Lite Binding response allocated"),
    }
    if list.compare_bytes(list.slice(output, 0, count), lite_reply()) != Equal {
        fail("Binding response did not encode the rebound source")
    }
    let _ = stun_ice.lite_receive(mut agent, base, original, probe, mut output, mut scratch)?
    let Some(path) = stun_ice.lite_selected(agent, 1) else {
        fail("authenticated USE-CANDIDATE did not nominate a path")
    }
    if path.peer.port != 46100 || path.base.port != 40000 {
        fail("ICE-Lite selected the old NAT mapping")
    }
    Ok(())
}

#!/usr/bin/env bash
# Install the LLVM pin in llvm-23.lock.
#
#   install                 print the install command and pinned asset URLs
#   install --unpack DIR    install the verified toolchain below DIR without root
#   install --source        print the pinned source build commands
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lock="$here/llvm-23.lock"

fail() { echo "native-toolchain install: $*" >&2; exit 1; }
usage() { echo "usage: install [--unpack DIR | --source]" >&2; exit 2; }

lock_value() {
  local value
  value="$(awk -v k="$1" '$1 == k { sub(/^[^ ]+ /, ""); print; found = 1 } END { exit !found }' "$lock")" \
    || fail "llvm-23.lock has no '$1' record"
  printf '%s\n' "$value"
}

case "${1:-}" in
  "")
    (( $# == 0 )) || usage
    printf '%q --unpack DIR\n' "$here/install"
    for key in bootstrap_llvm static_lld engine_llvm; do
      read -r _ _ asset <<< "$(lock_value "$key")"
      echo "# $(lock_value asset_pool)/$asset"
    done
    ;;
  --unpack)
    (( $# == 2 )) || usage
    mkdir -p "$2"
    root="$(cd "$2" && pwd)"
    llvm_prefix="$root$(lock_value prefix)"
    python3 "$here/../buck2/bootstrap_llvm.py" --output "$llvm_prefix"
    "$here/check" --prefix "$llvm_prefix"
    printf 'export LLVM_SYS_231_PREFIX=%q\n' "$llvm_prefix"
    printf "export LD_LIBRARY_PATH=%q\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\n" "$llvm_prefix/lib"
    ;;
  --source)
    (( $# == 1 )) || usage
    printf '%q DIR ARTIFACTS bootstrap\n' "$here/build-libllvm"
    printf '%q DIR\n' "$here/build-static-lld"
    for stage in instr train opt guard; do
      printf '%q DIR ARTIFACTS %s\n' "$here/build-libllvm" "$stage"
    done
    ;;
  *) usage ;;
esac

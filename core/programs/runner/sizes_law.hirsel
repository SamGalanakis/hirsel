fn expect_size_part(parts: List[(String, u64)], name: String, amount: u64) -> () {
    for i in 0u64 .. list.len(parts) {
        let item = view parts[i]
        if item.0 == name && item.1 == amount { return () }
    }
    fail("L60: missing shortage part")
}

@test
fn derived_budgets() -> Result[(), String] {
    let memory = result.unwrap(store.sized(Memory, 134217728u64))
    if memory.resident_limit != 133169152u64 || memory.pack_bytes != 0u64 ||
        memory.checkpoint_bytes != 0u64 || memory.journal_limit != 0u64 {
        fail("L60: Memory size formula")
    }
    let _ = result.unwrap(store.sized(Memory, 2097152u64))
    match store.sized(Memory, 2097151u64) {
        Error(short) => {
            if short.need != 2097152u64 || short.have != 2097151u64 { fail("L60: Memory floor") }
            expect_size_part(short.parts, "resident_limit", 1048576u64)
            expect_size_part(short.parts, "memory_keep", 1048576u64)
        },
        _ => fail("L60: below Memory floor"),
    }
    // STORE §1.1 v2.75: lifetime 4,291,840 (worker 4,194,304 + 65,536 + 352,
    // timer 4,384, channels 27,264); the cut phase binds: 16,777,640 + 65,536
    // + 2 x 8,698,670 with r = 95,685,370 totals 134,217,726.
    let directory = result.unwrap(store.sized(Directory, 134217728u64))
    if directory.pack_bytes != 8388608u64 || directory.checkpoint_bytes != 8388608u64 ||
        directory.journal_limit != 25165904u64 || directory.group_bytes != 4194304u32 ||
        directory.resident_limit != 95685370u64 {
        fail("L60: Directory size formula")
    }
    let config = std.object.LaneConfig(requested_lanes: 3, lane_bytes: 1048576)
    let one_lane = std.object.LaneConfig(requested_lanes: 1, lane_bytes: 1048576)
    let oversized_group = store.Overrides(resident_limit: Some(1048576u64), journal_limit: None,
        checkpoint_bytes: None, pack_bytes: Some(1048576u64), group_bytes: Some(33554432u64), group_commits: None, lock_wait_ms: None,
        cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None)
    // The journal worker's grant exceeds the share by itself.
    match store.sized_with(Bucket(one_lane), 134217728u64, oversized_group) {
        Error(short) => {
            if short.need != 242153196u64 { fail("L60: oversized Bucket group reservation") }
            expect_size_part(short.parts, "journal_worker", 134742368u64)
        },
        _ => fail("L60: Bucket sizing admitted a journal worker larger than the share"),
    }
    let bucket = result.unwrap(store.sized(Bucket(config), 134217728u64))
    if bucket.resident_limit != 38370774u64 { fail("L60: Bucket fixed reservations") }
    let default_lanes = std.object.LaneConfig(requested_lanes: 0, lane_bytes: 1048576)
    let default_bucket = result.unwrap(store.sized(Bucket(default_lanes), 134217728u64))
    if default_bucket.resident_limit != 33934492u64 { fail("L60: Bucket default lanes") }

    let mut opts = store.Overrides(resident_limit: None, journal_limit: None,
        checkpoint_bytes: None, pack_bytes: None, group_bytes: Some(2097152u64), group_commits: None, lock_wait_ms: None,
        cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None)
    let adjusted = result.unwrap(store.sized_with(Bucket(config), 134217728u64, opts))
    if adjusted.resident_limit != 49017854u64 || adjusted.group_bytes != 2097152u32 {
        fail("L60: Bucket group override changes entry buffers and the journal grant")
    }
    opts.resident_limit = Some(1048576u64)
    opts.pack_bytes = Some(8388608u64)
    opts.checkpoint_bytes = Some(8388608u64)
    opts.journal_limit = Some(25165904u64)
    // 50,397,344 directory fixed bytes + 25,890,192 Bucket fixed bytes
    // + 1,048,576 resident bytes + 190,652 bytes of variable checkpoint work.
    let _ = result.unwrap(store.sized_with(Bucket(config), 77526764u64, opts))
    match store.sized_with(Bucket(config), 77526763u64, opts) {
        Error(short) => {
            if short.need != 77526764u64 || short.have != 77526763u64 { fail("L60: Bucket floor") }
            expect_size_part(short.parts, "client_lanes", 3145728u64)
            expect_size_part(short.parts, "entry_buffers", 4194608u64)
            expect_size_part(short.parts, "head_buffers", 131552u64)
            expect_size_part(short.parts, "history_key", 64u64)
            expect_size_part(short.parts, "journal_timer", 4384u64)
            expect_size_part(short.parts, "journal_worker", 8913248u64)
            expect_size_part(short.parts, "reclaim_page", 1112000u64)
            expect_size_part(short.parts, "put_buffer", 8388608u64)
        },
        _ => fail("L60: below Bucket floor"),
    }
    opts.checkpoint_bytes = Some(18446744073709551615u64)
    if let Ok(_) = store.sized_with(Directory, 18446744073709551615u64, opts) {
        fail("L60: checkpoint floor overflow")
    }
    let overflow = std.object.LaneConfig(requested_lanes: 2, lane_bytes: 18446744073709551615u64)
    if let Ok(_) = store.sized(Bucket(overflow), 18446744073709551615u64) {
        fail("L60: lane reservation overflow")
    }
    Ok(())
}

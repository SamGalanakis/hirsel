pub fn law_typed_resident(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    // Scalar schemas are 1 + 4 + 1 = 6 bytes each. Catalog size is
    // 17 + (4 + 6) + 2 + (2 + 8 + 4 + 6) + 2 + 4 + 4 = 59 bytes.
    // Key 1||"rows" is 5 bytes. The charge is r8(59) + r8(5) + 62 = 134.
    if db.resident != 134 {
        return false
    }
    db.ceiling = 228
    if !typed_put(mut db, t, 1, 10) || db.resident != 228 {
        return false
    }
    let out = run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 2, 20)
    })
    match take out {
        Ok(Refused(f)) => if f.requested != 322 || f.available != 228 {
            return false
        },
        _ => return false
    }
    let removed = run(mut db, None, fn(mut tx: Tx) -> Result[bool, Error] {
        delete(mut tx, t, 1)
    })
    match take removed {
        Ok(Committed(done)) => if !done.value {
            return false
        },
        _ => return false
    }
    db.resident == 134
}


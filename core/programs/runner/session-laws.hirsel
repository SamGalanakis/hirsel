// A Reset encodes its 16-byte payload in place in one 30-byte wire capacity,
// charged as 32. Two connections hold one wire block each, so a third job's
// 32 bytes do not fit a 64-byte pool until one of the two blocks drops.
pub fn law_pool_holds_writer_bytes(tasks: Tasks, clock: Clock) -> bool waits {
    let config = wire_defaults(0u64)
    let allocated: Result[(Sender[WireAllocation[()]], Task[()]), Capacity] = start_wire_pool(tasks, config, clock, 64u64, 2u64, fn(mut context: (), take plan: ServiceAllocation) -> Result[ServicePlan, u16] { Error(1013u16) })
    let (pool, take pooled_task) = result.unwrap(take allocated)
    let (one_to, one_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = channel.new(1u64)
    let (two_to, two_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) = channel.new(1u64)
    let (write, pending): (Sender[Bytes], Receiver[Bytes]) = channel.new(1u64)
    let first = result.unwrap(wire_pack(pool, one_to, one_from, Reset(17u64, list.new()), list.new()))
    let second = result.unwrap(wire_pack(pool, two_to, two_from, Reset(19u64, list.new()), list.new()))
    result.unwrap(channel.try_send(write, take first))
    let before_write = match wire_pack(pool, one_to, one_from, Reset(23u64, list.new()), list.new()) { Error(Protocol(1013u16)) => true, _ => false }
    let writing = result.unwrap(channel.try_receive(pending))
    let during_write = match wire_pack(pool, two_to, two_from, Reset(29u64, list.new()), list.new()) { Error(Protocol(1013u16)) => true, _ => false }
    let bytes_sent = list.len(writing)
    let _ = take writing
    let third = result.unwrap(wire_pack(pool, one_to, one_from, Reset(31u64, list.new()), list.new()))
    let other_bytes = list.len(second)
    let _ = take pooled_task
    before_write && during_write && bytes_sent == 18u64 && other_bytes == 18u64 && list.len(third) == 18u64
}

type PoolCallPeer: send {
    stream: Socket, clock: Clock, random: Random, socket: std.wsock.Config, payload: Bytes,
}

fn pool_call_peer(take peer: PoolCallPeer) -> () waits {
    let PoolCallPeer(stream: take socket, clock: clock, random: random, socket: config, payload: take payload) = take peer
    let end: Until = At(clock, int.saturating_add(host.mono_ns(clock), 5000000000u64))
    let mut name: Bytes = list.new()
    list.append(mut name, string.as_bytes("127.0.0.1"))
    let std.wsock.Connected(reader: take reader, writer: take initial, outgoing: take outgoing, timers: _) =
        result.unwrap(std.wsock.client(take socket, take name, config, clock, random))
    let mut writer = take initial
    let mut out = take outgoing
    let frame = result.unwrap(std.wsock.encode(mut out, true, 2u8, payload))
    result.unwrap(std.wsock.stage(mut writer, take frame))
    while !std.wsock.drained(writer) { let _ = result.unwrap(std.wsock.flush(mut writer, mut out, end)) }
    let _ = take reader
}

fn pool_slot_unavailable(pending: std.wsock.PendingPool) -> bool {
    match std.wsock.acquire(pending) { Ok(None) => true, _ => false }
}

type PoolCallOwner: send {
    tasks: Tasks, clock: Clock, config: std.wsock.Config, pool: Sender[WireAllocation[()]],
    upgraded: std.wsock.Upgraded, ready: Sender[bool], proceed: Receiver[()],
}

fn pool_call_owner(take owner: PoolCallOwner) -> () waits {
    let PoolCallOwner(tasks: tasks, clock: clock, config: config, pool: take pool,
        upgraded: take upgraded, ready: take ready, proceed: take proceed) = take owner
    let std.wsock.Upgraded(reader: take input, writer: take writer, source: _, timers: _, pending: take lease, ..) = take upgraded
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let (credit, credits): (Sender[()], Receiver[()]) = channel.new(1u64)
    result.unwrap(channel.try_send(credit, ()))
    let reading = WireRead(reader: box.new(take input), to: take to, credits: take credits, clock: clock, config: config, pool: take pool)
    let mut reader = task.spawn(tasks, bytes reader_bytes(), take reading, wire_read)

    // Park the reader's handoff at the head of the owner's deferred queue.
    let WireEvent(e: take event) = result.unwrap(channel.receive(inbox))
    let Input(take f, at) = take event else { fail("expected a decoded Call") }
    let mut deferred: List[(Frame, u64)] = list.new()
    list.push(mut deferred, (take f, at))
    result.unwrap(channel.send(ready, true))
    result.unwrap(channel.receive(proceed))

    task.cancel(mut reader)
    let stopped = match task.join(take reader) { Error(Cancelled(_)) => true, _ => false }
    let queued = match deferred[0u64].0 {
        Call(0u32, 0u64, 0u32, 10000u32, arg) => list.len(arg) == 4u64 && arg[0u64] == 7u8,
        _ => false,
    }
    result.unwrap(channel.send(ready, stopped && queued))
    let _ = channel.receive(proceed)
    let _ = take deferred
    let _ = take writer
    let _ = take lease
}

fn pool_call_queued(tasks: Tasks, clock: Clock, random: Random, network: Net, config: WireConfig,
    pool: Sender[WireAllocation[()]], pending: std.wsock.PendingPool, take payload: Bytes,
    probe: scoped fn() -> bool waits) -> bool waits {
    let wire_slot = option.unwrap(result.unwrap(std.wsock.acquire(pending)))
    let (take listening, address) = result.unwrap(host.listen(network, Addr(ip: V4(0x7f000001u32), port: 0u16), 1u16))
    let mut listener = take listening
    let deadline: Until = At(clock, int.saturating_add(host.mono_ns(clock), 5000000000u64))
    let stream = result.unwrap(host.connect(network, address, deadline))
    let addr = result.unwrap(net.local_addr(stream))
    let peer = PoolCallPeer(stream: take stream, clock: clock, random: random, socket: config.socket, payload: take payload)
    let sending = task.spawn(tasks, bytes 65536u64, take peer, pool_call_peer)
    let socket = result.unwrap(std.net.accept_from(mut listener, addr, deadline))
    let upgraded = result.unwrap(std.wsock.server(take socket, take wire_slot, addr.ip, list.new(), config.socket, clock, host.mono_ns(clock)))
    let (ready, heard): (Sender[bool], Receiver[bool]) = channel.new(1u64)
    let (go, proceed): (Sender[()], Receiver[()]) = channel.new(1u64)
    let state = PoolCallOwner(tasks: tasks, clock: clock, config: config.socket, pool: channel.sender(pool),
        upgraded: take upgraded, ready: take ready, proceed: take proceed)
    let mut owner = task.spawn(tasks, bytes 65536u64, take state, pool_call_owner)

    let _ = result.unwrap(channel.receive(heard))
    let before = probe() && pool_slot_unavailable(pending)
    result.unwrap(channel.send(go, ()))
    let reader_stopped = result.unwrap(channel.receive(heard))
    let after = probe() && pool_slot_unavailable(pending)
    task.cancel(mut owner)
    let owner_stopped = match task.join(take owner) { Error(Cancelled(_)) => true, _ => false }
    let _ = result.unwrap(task.join(take sending))
    before && reader_stopped && after && owner_stopped
}

fn pool_durable_add(mut tx: store.Tx, table: store.Table[u64, u32], author: Caller, take value: u32) -> Result[u32, u32] {
    let old = match store.fetch(tx, table, 0u64) {
        Ok(Some(count)) => count,
        Ok(None) => 0u32,
        Error(_) => return Error(1u32),
    }
    let total = old + value
    if let Error(_) = store.put(mut tx, table, 0u64, total) { return Error(1u32) }
    Ok(total)
}

fn pool_retry(mut head: Head[(), store.Table[u64, u32]], inbox: Receiver[PubIn],
    take key: Bytes, take arg: Bytes, version: u64) -> bool waits {
    let (to, heard): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let mut stream: Bytes = list.new()
    std.codec.put_u32(0u32, mut stream)
    let request = head_request(store.Caller(issuer: 1, subject: list.new()), take stream, 0u64, take key, take arg, take to)
    result.unwrap(head_arrival(mut head, take request, false, false))
    if list.len(head.group) != 0u64 { result.unwrap(gate(mut head)) }
    let PubIn(e: take event) = result.unwrap(channel.receive(inbox))
    let Released(Release(version: _, snapshot: _, answers: take rows)) = take event else { return false }
    if list.len(rows) != 1u64 { return false }
    let row_ok = match rows[0u64] { CallAnswer(_, row) => row.p == 0u64, _ => false }
    if !row_ok { return false }
    let codec: std.codec.Codec[Result[u32, u32]] = std.codec.of()
    let reply = match rows[0u64] {
        CallAnswer(_, row) => match row.outcome {
            Returned(body) => match std.codec.decode(codec, body) { Ok(Ok(7u32)) => true, _ => false },
            _ => false,
        },
        _ => false,
    }
    reply && store.version(store.snapshot(head.db)) == version
}

fn pool_full_frame() -> Frame {
    let mut body: Bytes = list.new()
    for i in 0u8 .. 14u8 { list.push(mut body, i) }
    Ended(0u32, Returned(take body))
}

pub fn law_pool_releases_cancelled_reader(tasks: Tasks, clock: Clock, random: Random, net: Net) -> bool waits {
    let mut config = wire_defaults(0u64)
    config.socket.pending_max = 2u64
    let pending = result.unwrap(std.wsock.pending(config.socket))
    // A second live lease leaves room for a duplicate refund to add a token.
    let other_slot = option.unwrap(result.unwrap(std.wsock.acquire(pending)))
    let allocated: Result[(Sender[WireAllocation[()]], Task[()]), Capacity] = start_wire_pool(tasks, config, clock, 80u64, 2u64, fn(mut context: (), take plan: ServiceAllocation) -> Result[ServicePlan, u16] { Error(1013u16) })
    let (pool, take pooled_task) = result.unwrap(take allocated)
    let (reply, result_from): (Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]) =
        channel.new(1u64)
    let writing = result.unwrap(wire_pack(pool, reply, result_from, Reset(41u64, list.new()), list.new()))
    let mut arg: Bytes = list.new()
    std.codec.put_u32(7u32, mut arg)
    let call_frame = Call(0u32, 0u64, 0u32, 10000u32, take arg)
    let frames: std.codec.Codec[Frame] = std.codec.of()
    let mut payload: Bytes = list.with_capacity(wire_output_size(call_frame))
    result.unwrap(std.codec.encode(frames, call_frame, mut payload))

    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), std.codec.of_u32())))
    let table = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), std.codec.of_u32()))
    let mut entries: Registry[(), store.Table[u64, u32]] = registry()
    let add = code.describe(pool_durable_add)
    result.unwrap(transact(mut entries, add, 65536u64, DEFAULT_STEPS))
    let (release_to, releases): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    let mut head = Head(db: take db, r: take entries, replay_identity: list.new(),
        h: arc.new(take table), out: take release_to, busy: map.new(), waiting: list.new(),
        group: list.new(), last: None, held: list.new(), wakes: false, minted: 0u64, cut: false, trigger_drive: None, parked: list.new())

    // The retained writer block costs 32 bytes. An Ended frame with a 30-byte
    // payload encodes in place in capacity 44, charged 48: the remaining 48,
    // so even one retained decoder charge refuses it until the refund.
    let held = pool_call_queued(tasks, clock, random, net, config, pool, pending, clone(payload),
        scoped fn() -> bool waits {
            match wire_pack(pool, reply, result_from, pool_full_frame(), list.new()) { Error(Protocol(1013u16)) => true, _ => false }
        })
    let bytes_refunded = match wire_pack(pool, reply, result_from, pool_full_frame(), list.new()) {
        Ok(body) => list.len(body) == 32u64,
        _ => false,
    }
    let slot_returned_once = match std.wsock.acquire(pending) {
        Ok(Some(take returned)) => {
            let unavailable = pool_slot_unavailable(pending)
            let _ = take returned
            unavailable
        },
        _ => false,
    }
    let _ = take other_slot
    let _ = take writing
    let _ = take pooled_task

    let before = store.snapshot(head.db)
    let untouched = store.version(before) == 1u64 && result.unwrap(store.get(result.unwrap(store.reader(head.db, 0u64)), before, head.h, 0u64)) == None
    let _ = take before
    let reply_codec: std.codec.Codec[Result[u32, u32]] = std.codec.of()
    let (take key, _) = result.unwrap(described(code.identity(add), code.revision(add), Transact, std.codec.of_u32(), reply_codec))
    let Call(_, _, _, _, take retry_arg) = result.unwrap(wire_decode(payload)) else { return false }
    let committed = pool_retry(mut head, releases, clone(key), clone(retry_arg), 3u64)
    let replayed = pool_retry(mut head, releases, take key, take retry_arg, 3u64)
    let one_effect = result.unwrap(store.get(result.unwrap(store.reader(head.db, 0u64)), store.snapshot(head.db), head.h, 0u64)) == Some(7u32)
    held && bytes_refunded && slot_returned_once && untouched && committed && replayed && one_effect
}

@test
fn test_pool_releases_cancelled_reader(tasks: Tasks, clock: Clock, random: Random, net: Net) -> Result[(), ()] waits {
    if law_pool_releases_cancelled_reader(tasks, clock, random, net) { Ok(()) } else { Error(()) }
}

pub fn law_serving_budget() -> bool {
    let config = wire_defaults(65536u64)
    let total = match serving_bytes(config, 10000u64, 1048576u64) { Ok(n) => n, Error(_) => return false }
    if total != 1126170624u64 { return false }
    if let Ok(_) = serving_bytes(config, 10001u64, 1048576u64) { return false }
    let mut excessive = config
    excessive.n_pool = 0xffffffffffffffffu64
    if let Error(_) = serving_bytes(excessive, 10000u64, 1048576u64) { true } else { false }
}

pub fn law_subscription_room_refunded() -> bool {
    let mut quota = result.unwrap(subscription_room(400u64, 2u64, 400u64, 262144u64))
    let (to, from): (Sender[SubscriptionInput], Receiver[SubscriptionInput]) = channel.new(1u64)
    let arg: Bytes = list.with_capacity(128u64)
    let first = result.unwrap(subscription_hold(mut quota, store.Caller(issuer: 1u8, subject: list.new()), list.new(), take arg))
    result.unwrap(channel.try_send(to, take first))
    let same_size: Bytes = list.with_capacity(128u64)
    let refused = match subscription_hold(mut quota, store.Caller(issuer: 1u8, subject: list.new()), list.new(), take same_size) {
        Error(Capacity(requested: 192u64, available: 120u64)) => true,
        _ => false,
    }
    let _ = result.unwrap(channel.try_receive(from))
    let after_drop: Bytes = list.with_capacity(128u64)
    let readmitted = match subscription_hold(mut quota, store.Caller(issuer: 1u8, subject: list.new()), list.new(), take after_drop) { Ok(_) => true, _ => false }
    refused && readmitted
}

@test
fn test_wire_session(tasks: Tasks, clock: Clock) -> Result[(), ()] waits {
    if law_serving_budget() && law_subscription_room_refunded() && law_session_records(tasks) && law_pool_holds_writer_bytes(tasks, clock) && law_children_joined_on_close(tasks) { Ok(()) } else { Error(()) }
}

fn wire_park(take rx: Receiver[()]) -> () waits { let _ = channel.receive(rx) }

pub fn law_children_joined_on_close(tasks: Tasks) -> bool waits {
    let (a, ar): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (b, br): (Sender[()], Receiver[()]) = channel.new(1u64)
    let reader = task.spawn(tasks, bytes 4096u64, take ar, wire_park)
    let writer = task.spawn(tasks, bytes 4096u64, take br, wire_park)
    wire_join(take reader, Some(take writer))
    let read_closed = match channel.try_send(a, ()) { Error(Closed(_)) => true, _ => false }
    let write_closed = match channel.try_send(b, ()) { Error(Closed(_)) => true, _ => false }
    read_closed && write_closed
}

fn wire_owner_park(take rx: Receiver[()]) -> Result[(), std.wsock.Error] waits {
    let _ = channel.receive(rx)
    Ok(())
}

pub fn law_session_records(tasks: Tasks) -> bool waits {
    // MEM-24: Owe holds five 24-byte lists, four u64s and two bools (154 bytes).
    // Updated holds version (8), Option[Owe] (162) and outcomes (24).
    // PublisherEvent and WireInput each add an 8-byte tag: 210 bytes per WireEvent.
    // Five events plus their channel header, four unit channels, two child task
    // records of 288 and a 328-byte owner (288 + 40 for Result[(), std.wsock.Error]).
    let record_bytes = 5u64 * 210u64 + 64u64 + 4u64 * 64u64 + 2u64 * 288u64 + 328u64
    let exact = bound bytes record_bytes { wire_session_records(tasks) }
    let short = bound bytes (record_bytes - 1u64) { wire_session_records(tasks) }
    match (take exact, take short) {
        (Ok(Ok(true)), Ok(Error(Capacity(requested: 288u64, available: 287u64)))) => true,
        _ => false,
    }
}

fn wire_session_records(tasks: Tasks) -> Result[bool, Capacity] waits {
    let (events, hear): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    let (credit, read_credit): (Sender[()], Receiver[()]) = channel.new(5u64)
    let (a, ar): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (b, br): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (end, er): (Sender[()], Receiver[()]) = channel.new(1u64)
    let mut owner = task.spawn(tasks, bytes 0u64, take er, wire_owner_park)
    let reader = task.spawn(tasks, bytes 0u64, take ar, wire_park)
    let writer = task.try_spawn(tasks, bytes 0u64, take br, wire_park) ?=> |(cap, _)| cap
    let mut probe: Bytes = list.new()
    let exact = match list.try_reserve(mut probe, 1u64) { Error(_) => true, _ => false }
    task.cancel(mut owner)
    wire_join(take reader, Some(take writer))
    let _ = task.join(take owner)
    let owner_closed = match channel.try_send(end, ()) { Error(Closed(_)) => true, _ => false }
    let _ = channel.try_send(events, wire_event(Dropped))
    let _ = channel.try_send(credit, ())
    let live = match (channel.try_receive(hear), channel.try_receive(read_credit)) {
        (Ok(WireEvent(e: Dropped)), Ok(())) => true,
        _ => false,
    }
    let closed = match (channel.try_send(a, ()), channel.try_send(b, ())) {
        (Error(Closed(_)), Error(Closed(_))) => true,
        _ => false,
    }
    Ok(exact && live && closed && owner_closed)
}

// v2.44 (§3 Session): the owner writes without waiting and starts a writer child only when a
// send would block. The rig is a loopback session whose client reads nothing until told.
type WritePeer: send { stream: Socket, clock: Clock, random: Random, socket: std.wsock.Config, go: Receiver[u64], heard: Sender[u64] }

fn write_peer(take peer: WritePeer) -> () waits {
    let WritePeer(stream: take socket, clock: clock, random: random, socket: config, go: take go, heard: take heard) = take peer
    let mut name: Bytes = list.new()
    list.append(mut name, string.as_bytes("127.0.0.1"))
    let std.wsock.Connected(reader: take input, writer: take writer, outgoing: _, timers: _) =
        result.unwrap(std.wsock.client(take socket, take name, config, clock, random))
    let mut reader = take input
    let wanted = match channel.receive(go) { Ok(n) => n, Error(_) => return }
    let until: Until = At(clock, int.saturating_add(host.mono_ns(clock), 30000000000u64))
    let mut read = 0u64
    while read < wanted {
        match std.wsock.read(mut reader, until) { Ok(Message(_)) => { read += 1u64 }, Ok(_) => {}, Error(_) => break }
    }
    let _ = channel.send(heard, read)
    let _ = take writer
}

type WriteRig { writer: Box[std.wsock.Writer], reader: std.wsock.Reader, peer: Task[()], go: Sender[u64], heard: Receiver[u64] }

fn write_rig(tasks: Tasks, clock: Clock, random: Random, network: Net, config: std.wsock.Config) -> WriteRig waits {
    let pending = result.unwrap(std.wsock.pending(config))
    let wire_slot = option.unwrap(result.unwrap(std.wsock.acquire(pending)))
    let (take listening, address) = result.unwrap(host.listen(network, Addr(ip: V4(0x7f000001u32), port: 0u16), 1u16))
    let mut listener = take listening
    let (go, go_from): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    let (heard_to, heard): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    let deadline: Until = At(clock, int.saturating_add(host.mono_ns(clock), 5000000000u64))
    let stream = result.unwrap(host.connect(network, address, deadline))
    let addr = result.unwrap(net.local_addr(stream))
    let peer = WritePeer(stream: take stream, clock: clock, random: random, socket: config, go: take go_from, heard: take heard_to)
    let running = task.spawn(tasks, bytes 2097152u64, take peer, write_peer)
    let socket = result.unwrap(std.net.accept_from(mut listener, addr, deadline))
    let std.wsock.Upgraded(reader: take reader, writer: take writer, source: _, timers: _, pending: _, ..) =
        result.unwrap(std.wsock.server(take socket, take wire_slot, addr.ip, list.new(), config, clock, host.mono_ns(clock)))
    WriteRig(writer: box.new(take writer), reader: take reader, peer: take running, go: take go, heard: take heard)
}

fn write_stage(mut w: Box[std.wsock.Writer], config: std.wsock.Config, size: u64) {
    let mut out = result.unwrap(std.wsock.outbound(Server, config, None))
    let payload: Bytes = list.with_capacity(size)
    let mut body = take payload
    for _ in 0u64 .. size { list.push(mut body, 7u8) }
    result.unwrap(std.wsock.stage(mut w, result.unwrap(std.wsock.encode(mut out, true, 2u8, body))))
}

fn write_staged(tasks: Tasks, take w: Box[std.wsock.Writer], to: Sender[WireEvent], clock: Clock, config: std.wsock.Config) -> Result[Task[()], WireInput] waits {
    let out = result.unwrap(std.wsock.outbound(Server, config, None))
    wire_start(tasks, WireWrite(writer: take w, to: channel.sender(to), out: out, clock: clock, config: config,
        end: int.saturating_add(host.mono_ns(clock), std.wsock.MESSAGE_NS), can_close: true, close: false, report: None))
}

// Bug caught: a writer that blocks the owner, or a spawned writer that never hands the Writer
// back. A small frame is written inline with no child; frames of 200,000 B fill the unread
// socket until one would block, which starts the child; once the client reads, the child
// drains that frame, returns the Writer with Sent and exits, and the next frame is inline again.
pub fn law_write_spawned_on_block(tasks: Tasks, clock: Clock, random: Random, net: Net) -> bool waits {
    let config = std.wsock.defaults()
    let WriteRig(writer: take initial, reader: take reader, peer: take peer, go: take go, heard: take heard) = write_rig(tasks, clock, random, net, config)
    let (to, events): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(2u64)
    let mut w = take initial
    write_stage(mut w, config, 16u64)
    let mut sent = 1u64
    let mut writing: Option[Task[()]] = None
    match write_staged(tasks, take w, to, clock, config) { Error(Sent(take back)) => { w = take back }, _ => return false }
    while sent < 512u64 {
        write_stage(mut w, config, 200000u64)
        sent += 1u64
        match write_staged(tasks, take w, to, clock, config) {
            Error(Sent(take back)) => { w = take back },
            Ok(take h) => { writing = Some(take h); break },
            _ => return false,
        }
    }
    let Some(take child) = take writing else { return false }
    result.unwrap(channel.send(go, sent + 1u64))
    let returned = match channel.receive(events) { Ok(WireEvent(e: Sent(take back))) => take back, _ => return false }
    let exited = match task.join(take child) { Ok(()) => true, _ => false }
    let mut again = take returned
    write_stage(mut again, config, 16u64)
    let inline = match write_staged(tasks, take again, to, clock, config) { Error(Sent(_)) => true, _ => false }
    let all_read = match channel.receive(heard) { Ok(n) => n == sent + 1u64, _ => false }
    let _ = task.join(take peer)
    let _ = take reader
    exited && inline && all_read
}

// Bug caught: a refused writer spawn that hangs the session or loses its end. Each frame is
// staged outside a bound one byte short of writer_bytes(), and only the write runs inside it,
// so the inline writes fit and the spawn at the first blocked send is refused: the session
// ends with 1001 (§3 Session, v2.44).
pub fn law_write_capacity_ends(tasks: Tasks, clock: Clock, random: Random, net: Net) -> bool waits {
    let config = std.wsock.defaults()
    let WriteRig(writer: take initial, reader: take reader, peer: take running, go: take go, heard: _) = write_rig(tasks, clock, random, net, config)
    let (to, _events): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(2u64)
    let mut held: Option[Box[std.wsock.Writer]] = Some(take initial)
    let mut ended = false
    for _ in 0u64 .. 512u64 {
        let Some(take staged) = replace(mut held, None) else { break }
        let mut w = take staged
        write_stage(mut w, config, 200000u64)
        let started = bound bytes (writer_bytes() - 1u64) { write_staged(tasks, take w, to, clock, config) }
        match take started {
            Ok(Error(Sent(take back))) => { held = Some(take back) },
            Ok(Error(Ended(1001u16))) => { ended = true },
            _ => {},
        }
    }
    let _ = take go
    let mut peer = take running
    task.cancel(mut peer)
    let _ = task.join(take peer)
    let _ = take reader
    ended
}

@test
fn test_wire_write(tasks: Tasks, clock: Clock, random: Random, net: Net) -> Result[(), ()] waits {
    if law_write_spawned_on_block(tasks, clock, random, net) && law_write_capacity_ends(tasks, clock, random, net) { Ok(()) } else { Error(()) }
}

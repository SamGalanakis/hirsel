// Module `trace`: caller-owned spans and leveled logs. Contract: api/trace.md.
/// A span's place in a trace: the 128-bit trace id (hi then lo, network order) and the
/// 64-bit span id. Neither is all zeros: OTLP calls such an id invalid.
pub opaque type Context: key {
    trace_hi: u64,
    trace_lo: u64,
    span: u64
}

/// ZeroTrace and ZeroSpan: an all-zero id. OtherTrace: the parent is in another trace.
/// SelfParent: the parent is the span itself.
pub type Error: key = ZeroTrace | ZeroSpan | OtherTrace | SelfParent

/// Minimum severity and severity of a structured log line, in increasing order.
pub type Level: key = Debug | Info | Warn | Error

/// OTLP Span.SpanKind 1 to 5.
pub type SpanKind: key = Internal | Server | Client | Producer | Consumer

/// OTLP Status.StatusCode 0 (UNSET), 1 (OK) and 2 (ERROR).
pub type Status: key = Unset | Succeeded | Failed

/// OTLP AnyValue: stringValue, boolValue, intValue, doubleValue, bytesValue.
pub type Value = Str(String) | Bool(bool) | Int(i64) | Double(f64) | Blob(Bytes)

/// One OTLP KeyValue.
pub type Attribute {
    key: String,
    value: Value
}

/// A log level, Clock anchor, and reusable JSON line buffer.
pub opaque type Logger {
    unix_ns: u64,
    mono_ns: u64,
    min: Level,
    line: Bytes
}

/// The spans ended so far, and the anchor that turns Clock readings into Unix time.
pub opaque type Recorder {
    unix_ns: u64,
    mono_ns: u64,
    spans: Log[Ended]
}

/// A started span. Dropping it records nothing.
pub opaque type Span {
    own: Context,
    parent: Option[u64],
    name: String,
    kind: SpanKind,
    start_ns: u64,
    attributes: List[Attribute],
    links: List[Context],
    status: Status
}

/// An ended span, as `finish` returns it.
pub opaque type Ended {
    span: Span,
    end_ns: u64
}

/// The context with these ids.
/// Fails: Error(ZeroTrace) when both trace words are 0, else Error(ZeroSpan) when span is 0.
/// Alloc: nothing. Ex: `let parent = trace.context(hi, lo, span)?`
pub fn context(trace_hi: u64, trace_lo: u64, span: u64) -> Result[Context, Error] {
    if trace_hi == 0 && trace_lo == 0 {
        return Error(ZeroTrace)
    }
    if span == 0 {
        return Error(ZeroSpan)
    }
    Ok(Context(trace_hi, trace_lo, span))
}

/// The trace id as (hi, lo). Alloc: nothing.
pub fn trace_id(x: Context) -> (u64, u64) {
    (x.trace_hi, x.trace_lo)
}

/// The span id. Alloc: nothing.
pub fn span_id(x: Context) -> u64 {
    x.span
}

/// A recorder anchored at c's current readings: a later reading m of `host.mono_ns(c)` is
/// the Unix time `host.wall_ms(c) * 1_000_000 + (m - host.mono_ns(c))` of this call.
/// Fails: Overflow (failure) when the wall time in nanoseconds exceeds 2^64 - 1.
/// Alloc: the log's node (MEM-29). Ex: `let r = trace.recorder(c)`
pub fn recorder(c: Clock) -> Recorder {
    let unix_ns = host.wall_ms(c) * 1000000
    Recorder(unix_ns, mono_ns: host.mono_ns(c), spans: log.new())
}

/// Fails: Overflow when c reads below the anchor (another Clock), or past 2^64 - 1 ns.
fn now(r: Recorder, c: Clock) -> u64 {
    anchored_time(r.unix_ns, r.mono_ns, c)
}

fn anchored_time(unix_ns: u64, mono_ns: u64, c: Clock) -> u64 {
    unix_ns + (host.mono_ns(c) - mono_ns)
}

fn nonzero(mut g: rand.Pcg) -> u64 {
    let mut n = rand.next(mut g)
    while n == 0 {
        n = rand.next(mut g)
    }
    n
}

fn opened(r: Recorder, c: Clock, own: Context, parent: Option[u64], take name: String, kind: SpanKind) -> Span {
    Span(own, parent, name, kind, start_ns: now(r, c), attributes: list.new(), links: list.new(), status: Unset)
}

/// Starts a span at now on c, under parent, or as a trace root when parent is None.
/// Ids come from g: a root draws trace hi, then trace lo, then its span id; a child draws its
/// span id and keeps the parent's trace id. A draw of zero (both trace words zero) is drawn
/// again. Fails: as `recorder` for c. Alloc: nothing until attributes or links are added.
/// Ex: `let s = trace.start(r, c, Some(trace.ids(parent)), mut g, "fetch", Client)`
pub fn start(r: Recorder, c: Clock, parent: Option[Context], mut g: rand.Pcg, take name: String, kind: SpanKind) -> Span {
    match parent {
        Some(p) => {
            let own = Context(trace_hi: p.trace_hi, trace_lo: p.trace_lo, span: nonzero(mut g))
            opened(r, c, own, Some(p.span), take name, kind)
        },
        None => {
            let mut hi = rand.next(mut g)
            let mut lo = rand.next(mut g)
            while hi == 0 && lo == 0 {
                hi = rand.next(mut g)
                lo = rand.next(mut g)
            }
            opened(r, c, Context(trace_hi: hi, trace_lo: lo, span: nonzero(mut g)), None, take name, kind)
        },
    }
}

/// Starts a span with caller-supplied ids own, as `start` does otherwise.
/// Fails: Error(OtherTrace) when parent's trace id is not own's, Error(SelfParent) when
/// parent's span id is own's; nothing is started. Ex: `trace.start_with(r, c, None, own, "job", Consumer)?`
pub fn start_with(r: Recorder, c: Clock, parent: Option[Context], own: Context, take name: String, kind: SpanKind) -> Result[Span, Error] {
    match parent {
        Some(p) => {
            if p.trace_hi != own.trace_hi || p.trace_lo != own.trace_lo {
                return Error(OtherTrace)
            }
            if p.span == own.span {
                return Error(SelfParent)
            }
            Ok(opened(r, c, own, Some(p.span), take name, kind))
        },
        None => Ok(opened(r, c, own, None, take name, kind)),
    }
}

/// The span's own context: the parent to give its children. Alloc: nothing.
pub fn ids(s: Span) -> Context {
    s.own
}

/// Sets attribute key to v. Attributes stay sorted by key bytes with one value per key, as
/// OTLP requires; setting a key again replaces its value.
/// Alloc: GROWTH of the attribute list for a new key. Cost: O(attributes).
/// Ex: `trace.set(mut s, "http.response.status_code", Int(200))`
pub fn set(mut s: Span, take key: String, take v: Value) {
    let n = list.len(s.attributes)
    let mut i: u64 = 0
    while i < n && s.attributes[i].key < key {
        i += 1
    }
    if i < n && s.attributes[i].key == key {
        let _ = list.set(mut s.attributes, i, Attribute(key, value: v))
    } else {
        list.insert(mut s.attributes, i, Attribute(key, value: v))
    }
}

/// Adds a link to another span's context, after the links added before.
/// Alloc: GROWTH of the link list.
pub fn link(mut s: Span, to: Context) {
    list.push(mut s.links, to)
}

/// Sets the status, replacing the previous one. Alloc: nothing.
pub fn set_status(mut s: Span, st: Status) {
    s.status = st
}

/// Ends s at now on c and appends it to r. An append stays (MEM-29).
/// Fails: as `recorder` for c; Overflow when c reads below the anchor. Alloc: GROWTH of r.
pub fn end(r: Recorder, c: Clock, take s: Span) {
    let end_ns = now(r, c)
    log.append(r.spans, Ended(span: s, end_ns))
}

/// The ended spans in the order they ended. Alloc: nothing (MEM-29).
pub fn finish(take r: Recorder) -> List[Ended] {
    let Recorder(spans: take spans, ..) = take r
    log.finish(take spans)
}

fn quoted(mut out: String, s: String) {
    json.write(mut out, false, scoped fn(w: json.Writer) {
        json.write_string_value(w, s)
    })
}

fn push_value(mut out: String, v: Value) {
    match v {
        Str(s) => {
            string.push(mut out, "{\"stringValue\":")
            quoted(mut out, s)
        },
        Bool(b) => {
            string.push(mut out, if b {
                "{\"boolValue\":true"
            } else {
                "{\"boolValue\":false"
            })
        },
        Int(n) => {
            string.push(mut out, "{\"intValue\":\"")
            string.push_i64(mut out, n)
            string.push(mut out, "\"")
        },
        Double(x) => {
            string.push(mut out, "{\"doubleValue\":")
            if float.is_finite(x) {
                float.push_json_f64(mut out, x)
            } else if float.gt(x, 0.0) {
                string.push(mut out, "\"Infinity\"")
            } else if float.lt(x, 0.0) {
                string.push(mut out, "\"-Infinity\"")
            } else {
                string.push(mut out, "\"NaN\"")
            }
        },
        Blob(b) => {
            string.push(mut out, "{\"bytesValue\":\"")
            string.push(mut out, base64.encode_string(b))
            string.push(mut out, "\"")
        },
    }
    string.push(mut out, "}")
}

fn push_attributes(mut out: String, xs: List[Attribute]) {
    string.push(mut out, "[")
    for i in 0 .. list.len(xs) {
        if i > 0 {
            string.push(mut out, ",")
        }
        string.push(mut out, "{\"key\":")
        quoted(mut out, xs[i].key)
        string.push(mut out, ",\"value\":")
        push_value(mut out, xs[i].value)
        string.push(mut out, "}")
    }
    string.push(mut out, "]")
}

fn push_nanos(mut out: String, key: String, ns: u64) {
    string.push(mut out, key)
    string.push(mut out, "\"")
    string.push_u64(mut out, ns)
    string.push(mut out, "\"")
}

fn push_trace_id(mut out: String, x: Context) {
    string.push(mut out, "\"traceId\":\"")
    hex.push_u64(mut out, x.trace_hi)
    hex.push_u64(mut out, x.trace_lo)
    string.push(mut out, "\"")
}

fn push_span_id(mut out: String, key: String, n: u64) {
    string.push(mut out, key)
    string.push(mut out, "\"")
    hex.push_u64(mut out, n)
    string.push(mut out, "\"")
}

fn kind_code(k: SpanKind) -> u64 {
    match k {
        Internal => 1,
        Server => 2,
        Client => 3,
        Producer => 4,
        Consumer => 5,
    }
}

fn status_code(s: Status) -> u64 {
    match s {
        Unset => 0,
        Succeeded => 1,
        Failed => 2,
    }
}

fn push_span(mut out: String, s: Span, end_ns: u64) {
    string.push(mut out, "{\"attributes\":")
    push_attributes(mut out, s.attributes)
    push_nanos(mut out, ",\"endTimeUnixNano\":", end_ns)
    string.push(mut out, ",\"kind\":")
    string.push_u64(mut out, kind_code(s.kind))
    string.push(mut out, ",\"links\":[")
    for i in 0 .. list.len(s.links) {
        if i > 0 {
            string.push(mut out, ",")
        }
        push_span_id(mut out, "{\"spanId\":", s.links[i].span)
        string.push(mut out, ",")
        push_trace_id(mut out, s.links[i])
        string.push(mut out, "}")
    }
    string.push(mut out, "],\"name\":")
    quoted(mut out, s.name)
    if let Some(p) = s.parent {
        push_span_id(mut out, ",\"parentSpanId\":", p)
    }
    push_span_id(mut out, ",\"spanId\":", s.own.span)
    push_nanos(mut out, ",\"startTimeUnixNano\":", s.start_ns)
    string.push(mut out, ",\"status\":{\"code\":")
    string.push_u64(mut out, status_code(s.status))
    string.push(mut out, "},")
    push_trace_id(mut out, s.own)
    string.push(mut out, "}")
}

/// Appends one OTLP/JSON ExportTraceServiceRequest: one resource with the resource
/// attributes in their list order, one scope named scope at version, and spans in list
/// order. Object members are in key order and nothing is spaced, so the text equals
/// Python's `json.dumps(sort_keys=True, separators=(",", ":"))` of the same document for
/// ASCII strings. Ids are lowercase hex; times and intValue are decimal strings; a
/// finite double has std.json's spelling, a nonfinite one "NaN", "Infinity" or
/// "-Infinity"; bytes are padded base64. Pure: no capability.
/// Fails: Capacity, leaving a prefix of the document in out. Alloc: GROWTH of out.
/// Cost: O(output bytes). Ex: `trace.otlp_json(mut body, about, "shop", "1", spans)`
pub fn otlp_json(mut out: String, about: List[Attribute], scope: String, version: String, spans: List[Ended]) {
    string.push(mut out, "{\"resourceSpans\":[{\"resource\":{\"attributes\":")
    push_attributes(mut out, about)
    string.push(mut out, "},\"scopeSpans\":[{\"scope\":{\"name\":")
    quoted(mut out, scope)
    string.push(mut out, ",\"version\":")
    quoted(mut out, version)
    string.push(mut out, "},\"spans\":[")
    for i in 0 .. list.len(spans) {
        if i > 0 {
            string.push(mut out, ",")
        }
        push_span(mut out, spans[i].span, spans[i].end_ns)
    }
    string.push(mut out, "]}]}]}")
}

/// Anchors c as recorder does and sets the minimum log level. Alloc: nothing.
/// Fails: Overflow if the wall time in nanoseconds exceeds 2^64 - 1.
pub fn logger(c: Clock, min: Level) -> Logger {
    let unix_ns = host.wall_ms(c) * 1000000
    Logger(unix_ns, mono_ns: host.mono_ns(c), min: min, line: list.new())
}

/// Whether level meets the logger's minimum. Alloc: nothing. Cost: O(1).
pub fn enabled(l: Logger, level: Level) -> bool {
    level_rank(level) >= level_rank(l.min)
}

fn level_rank(level: Level) -> u8 {
    match level {
        Debug => 0,
        Info => 1,
        Warn => 2,
        Error => 3,
    }
}

fn push_digits(mut out: Bytes, n: u64, radix: u32, width: u64) {
    let mut digits: Inline[u8, 64] =[b'0'; 64]
    let unpadded = int.radix_digits(n, radix, mut digits)
    let first = order.min(unpadded, 64 - width)
    list.reserve(mut out, 64 - first)
    let _ = bytebuf.append_inline(mut out, digits, first, 64)
}

fn push_log_time(mut out: Bytes, unix_ns: u64) {
    let stamp = option.unwrap(time.from_unix(int.narrow(unix_ns / 1000000000), int.narrow(unix_ns % 1000000000)))
    let civil = option.unwrap(time.civil(stamp, 0))
    let date = time.date_of(civil)
    push_digits(mut out, int.widen(time.year(date)), 10, 4)
    list.push(mut out, b'-')
    push_digits(mut out, int.widen(time.month(date)), 10, 2)
    list.push(mut out, b'-')
    push_digits(mut out, int.widen(time.day(date)), 10, 2)
    list.push(mut out, b'T')
    push_digits(mut out, int.widen(time.hour(civil)), 10, 2)
    list.push(mut out, b':')
    push_digits(mut out, int.widen(time.minute(civil)), 10, 2)
    list.push(mut out, b':')
    push_digits(mut out, int.widen(time.second(civil)), 10, 2)
    list.push(mut out, b'.')
    push_digits(mut out, int.widen(time.nanos(civil)), 10, 9)
    list.push(mut out, b'Z')
}

fn push_level(mut out: Bytes, level: Level) {
    list.append(mut out, match level {
        Debug => b"DEBUG",
        Info => b"INFO",
        Warn => b"WARN",
        Error => b"ERROR",
    })
}

fn push_log_int(mut out: Bytes, n: i64) {
    if n < 0 {
        list.push(mut out, b'-')
        let magnitude: u64 = int.narrow(-(n + 1))
        push_digits(mut out, magnitude + 1, 10, 1)
    } else {
        push_digits(mut out, int.narrow(n), 10, 1)
    }
}

fn push_log_value(mut out: Bytes, value: Value) {
    match value {
        Str(s) => json.append_quoted(mut out, s),
        Bool(b) => list.append(mut out, if b {
            b"true"
        } else {
            b"false"
        }),
        Int(n) => push_log_int(mut out, n),
        Double(x) => {
            if float.is_finite(x) {
                float.write_json_f64(mut out, x, fn(mut b: Bytes, s: String) {
                    list.append(mut b, string.as_bytes(s))
                }, fn(mut b: Bytes, n: u64) {
                    push_digits(mut b, n, 10, 1)
                })
            } else if float.gt(x, 0.0) {
                list.append(mut out, b"\"Infinity\"")
            } else if float.lt(x, 0.0) {
                list.append(mut out, b"\"-Infinity\"")
            } else {
                list.append(mut out, b"\"NaN\"")
            }
        },
        Blob(b) => {
            list.push(mut out, b'"')
            base64.encode(b, mut out)
            list.push(mut out, b'"')
        },
    }
}

fn push_log_fields(mut out: Bytes, mut fields: List[Attribute]) {
    list.sort_stable(mut fields, fn(a: Attribute, b: Attribute) -> Order {
        order.compare(a.key, b.key)
    })
    list.append(mut out, b",\"attributes\":{")
    let n = list.len(fields)
    let mut first = true
    for i in 0u64 .. n {
        let field = fields[i]
        if i + 1 < n && field.key == fields[i + 1].key {
            continue
        }
        if !first {
            list.push(mut out, b',')
        }
        first = false
        json.append_quoted(mut out, field.key)
        list.push(mut out, b':')
        push_log_value(mut out, field.value)
    }
    list.push(mut out, b'}')
}

/// Appends one JSON log line, including its final newline. Takes fields to sort them
/// by key, keeping the last value for each key. Pure.
/// Fails: Capacity. Alloc: GROWTH of out and the stable sort's temporary storage.
pub fn encode_line(mut out: Bytes, unix_ns: u64, level: Level, ctx: Option[Context], msg: String, take fields: List[Attribute]) {
    list.append(mut out, b"{\"time\":\"")
    push_log_time(mut out, unix_ns)
    list.append(mut out, b"\",\"level\":\"")
    push_level(mut out, level)
    list.append(mut out, b"\",\"msg\":")
    json.append_quoted(mut out, msg)
    if let Some(x) = ctx {
        list.append(mut out, b",\"trace_id\":\"")
        push_digits(mut out, x.trace_hi, 16, 16)
        push_digits(mut out, x.trace_lo, 16, 16)
        list.append(mut out, b"\",\"span_id\":\"")
        push_digits(mut out, x.span, 16, 16)
        list.push(mut out, b'"')
    }
    if list.len(fields) != 0 {
        let mut sorted = take fields
        push_log_fields(mut out, mut sorted)
    }
    list.append(mut out, b"}\n")
}

/// Writes one encoded line to err. Below the minimum, neither c nor err is used.
/// Fails: Capacity or Overflow as in encode_line and recorder, or err's WriteError.
/// Alloc: GROWTH of the reusable line buffer and the stable sort's temporary storage.
pub fn log(mut l: Logger, c: Clock, err: Stderr, level: Level, ctx: Option[Context], msg: String, take fields: List[Attribute]) -> Result[(), WriteError] waits {
    if !enabled(l, level) {
        return Ok(())
    }
    let unix_ns = anchored_time(l.unix_ns, l.mono_ns, c)
    list.clear(mut l.line)
    encode_line(mut l.line, unix_ns, level, ctx, msg, take fields)
    stderr.write_bytes(err, l.line)
}

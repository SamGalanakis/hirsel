// Module harness: the prompt. Sections and tools offered to the model, and the request
// built from a sealed cutoff's entries.
type Shown = Text(String) | Absent | Kept

fn render(tx: store.Tx, sec: Section, l: Limits) -> Shown {
    let go = code.callable(sec.render)
    let ran = bound bytes l.section_bytes {
        bound steps l.section_steps {
            go(tx)
        }
    }
    match take ran {
        Ok(Ok(Ok(Some(take text)))) => if string.byte_len(text) > INLINE_LIMIT {
            Kept
        } else {
            Text(take text)
        },
        Ok(Ok(Ok(None))) => Absent,
        _ => Kept,
    }
}

fn hash_of(list: List[SectionHash], key: String) -> Option[Bytes] {
    for e in list {
        if e.key == key {
            return Some(clone(e.hash))
        }
    }
    None
}

const TOOL_SEARCH: String = "tool_search"

fn search_tool[G: send]() -> Tool[G] {
    inside(TOOL_SEARCH, "Search the MCP tool catalog and offer matching tools in the next request.", "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}", code.describe(tool_search))
}

fn tool_search(mut tx: store.Tx, inv: Invoke) -> Result[Reply, Fault] {
    let Ok(args) = string.from_utf8(clone(inv.args)) else {
        return Error(BadArgs("tool_search expects a query string"))
    }
    let Ok(fields) = mcp.rpc.object(args) else {
        return Error(BadArgs("tool_search expects a query string"))
    }
    let Some(query) = mcp.rpc.field_text(fields, "query") else {
        return Error(BadArgs("tool_search expects a query string"))
    }
    let h = handles(store.tx_schema(tx)) ?=> |_| Unavailable
    let mut s = session_of(tx, h) ?=> |_| Unavailable
    let mut names: List[String] = list.new()
    let mut texts: List[String] = list.new()
    {
        let mut rows = store.range(tx, h.mcp_catalog, Unbounded, Unbounded) ?=> |_| Unavailable
        while let Some((take name, r)) = store.next_range(mut rows) ?=> |_| Unavailable {
            if narrowed(s, name) {
                list.push(mut names, take name)
                list.push(mut texts, string.from(mcp_tools.about(r)))
            }
        }
    }
    let mut matches: List[String] = list.new()
    let old_end = list.len(s.admitted)
    let mut admitted: std.set.Set[String] = std.set.new()
    for name in s.admitted {
        let _ = std.set.insert(mut admitted, clone(name))
    }
    for hit in search.rank(texts, query) {
        let name = view names[hit.id]
        if std.set.insert(mut admitted, clone(name)) {
            list.push(mut s.admitted, clone(name))
        }
        list.push(mut matches, clone(name))
    }
    let output = string.into_bytes(mcp.rpc.typed_json(matches))
    if list.len(output) > INLINE_LIMIT {
        return Error(TooLarge)
    }
    if list.len(s.admitted) != old_end {
        store.put(mut tx, h.session, 0u64, s) ?=> |_| Unavailable
    }
    Ok(Now(take output))
}

fn local_definition[G: send](t: Tool[G]) -> ToolDef {
    ToolDef(name: clone(t.name), about: clone(t.about), input: clone(t.input), rev: t.rev, catalog: None)
}

fn remote_definition(take name: String, r: mcp_tools.Remote) -> ToolDef {
    ToolDef(name: take name, about: string.from(mcp_tools.about(r)), input: string.from(mcp_tools.input(r)), rev: 0u64, catalog: Some(clone(mcp_tools.fingerprint(r))))
}

fn offered[G: send](tx: store.Tx, h: Handles, a: Agent[G], s: Session) -> Result[List[ToolDef], Refused] {
    let mut defs: List[ToolDef] = list.new()
    let has_catalog = tool_search_enabled(a)
    for t in a.tools {
        if mcp_tools.reserved(t.name) || (has_catalog && t.name == TOOL_SEARCH) {
            return Error(Malformed("reserved MCP tool name"))
        }
        if narrowed(s, t.name) {
            list.push(mut defs, local_definition(t))
        }
    }
    if has_catalog {
        if narrowed(s, TOOL_SEARCH) {
            let tool: Tool[G] = search_tool()
            list.push(mut defs, local_definition(tool))
        }
        let Ok(take cursor) = store.range(tx, h.mcp_catalog, Unbounded, Unbounded) else {
            return Error(Storage)
        }
        let mut rows = take cursor
        while let Some((take name, r)) = kept(store.next_range(mut rows))? {
            if !mcp_tools.deferred(r) && narrowed(s, name) {
                list.push(mut defs, remote_definition(take name, r))
            }
        }
        for name in s.admitted {
            if narrowed(s, name) {
                if let Some(r) = kept(store.fetch(tx, h.mcp_catalog, name))? {
                    if mcp_tools.deferred(r) {
                        list.push(mut defs, remote_definition(clone(name), r))
                    }
                }
            }
        }
    }
    Ok(take defs)
}

// Renders every section and appends the smallest System patch that brings the
// fold of earlier patches to the rendered list, or nothing if it already
// matches. The session row caches each shown section's hash and the offered
// tools' hash, so no earlier entry is read. Kept sections stay where they are.
// A patch whose order differs from the shown order is a baseline; a baseline
// that would need a kept section's text, which only the log holds, is put off
// to the next request and every section keeps its shown text.
fn plan[G: send](mut tx: store.Tx, h: Handles, a: Agent[G], mut s: Session) -> Result[(), Refused] {
    let first = list.len(s.active_tools_hash) == 0u64
    let mut shown: List[SectionHash] = list.new()
    let mut changes: List[Change] = list.new()
    let mut texts: List[Change] = list.new()
    let mut kept_any = false
    for sec in a.sections {
        let old = hash_of(s.active_sections_hashes, sec.key)
        match render(tx, sec, a.limits) {
            Text(take text) => {
                let hash = digest(string.as_bytes(text))
                list.push(mut shown, SectionHash(key: clone(sec.key), hash: clone(hash)))
                if old != Some(clone(hash)) {
                    list.push(mut changes, Change(key: clone(sec.key), text: Some(clone(text))))
                }
                list.push(mut texts, Change(key: clone(sec.key), text: Some(take text)))
            },
            Absent => if let Some(_) = old {
                list.push(mut changes, Change(key: clone(sec.key), text: None))
            },
            Kept => if let Some(take hash) = old {
                kept_any = true
                list.push(mut shown, SectionHash(key: clone(sec.key), hash: take hash))
            },
        }
    }
    // Incremental patches keep shown keys in place and add new ones at the
    // end, so the new order must be the old order without removed keys,
    // followed by the added keys.
    let mut expected: List[String] = list.new()
    for e in s.active_sections_hashes {
        if let Some(_) = hash_of(shown, e.key) {
            list.push(mut expected, clone(e.key))
        }
    }
    for e in shown {
        if let None = hash_of(s.active_sections_hashes, e.key) {
            list.push(mut expected, clone(e.key))
        }
    }
    let mut in_place = list.len(expected) == list.len(shown)
    if in_place {
        for i in 0u64 .. list.len(shown) {
            if expected[i] != shown[i].key {
                in_place = false
            }
        }
    }
    let baseline = (first || !in_place) && !kept_any
    if !in_place && kept_any {
        shown = clone(s.active_sections_hashes)
        changes = list.new()
    }
    let defs = offered(tx, h, a, s)?
    let Some(raw_defs) = encoded(defs) else {
        return Error(Malformed("tool definitions"))
    }
    let tools_hash = digest(raw_defs)
    let tools_changed = first || tools_hash != s.active_tools_hash
    if !baseline && list.len(changes) == 0u64 && !tools_changed {
        return Ok(())
    }
    let tools: Option[List[ToolDef]] = if tools_changed {
        Some(clone(defs))
    } else {
        None
    }
    let patch = if baseline {
        Patch(baseline: true, changes: take texts, tools: Some(take defs))
    } else {
        Patch(baseline: false, changes: take changes, tools: take tools)
    }
    let pos = append(mut tx, h, a, mut s, System(take patch))?
    if baseline || tools_changed {
        s.active_tools_pos = Some(pos)
    }
    s.active_sections_hashes = take shown
    s.active_tools_hash = take tools_hash
    Ok(())
}

// The request for a model effect, built from immutable entries read through
// the attempt's snapshot, so the advance transaction never carries the body.
// System entries fold into `system` and `tools`; Notes are not sent. A frame's
// seed is the first message, and the sealed omit ranges leave messages out.
pub fn request(snap: store.Snapshot, h: Handles, key: EffectKey, e: Effect) -> Result[Request, store.Error] {
    let cutoff = view e.cutoff
    let mut messages: List[Entry] = list.new()
    let mut system: List[Change] = list.new()
    let mut tools: List[ToolDef] = list.new()
    if cutoff.frame > 0u64 {
        let Some(f) = store.get(snap, h.frames, cutoff.frame)? else {
            return Error(Missing("frame"))
        }
        list.push(mut messages, Inform(clone(f.seed)))
    }
    let mut p = cutoff.frame
    while p <= cutoff.tail_pos {
        match store.get(snap, h.entries, p)? {
            Some(System(take patch)) => fold(mut system, mut tools, take patch),
            Some(Note(_, _)) => (),
            Some(take entry) => if !omitted(cutoff.omit, p) {
                list.push(mut messages, take entry)
            },
            None => return Error(Missing("entry")),
        }
        p += 1u64
    }
    let mut texts: List[String] = list.new()
    for c in system {
        if let Some(t) = view c.text {
            list.push(mut texts, clone(t))
        }
    }
    let mut stable: Bytes = list.new()
    std.codec.put_u64(key.run, mut stable)
    std.codec.put_u64(key.round, mut stable)
    if key.kind == WARM {
        list.push(mut stable, WARM)
        std.codec.put_u64(key.ordinal, mut stable)
    }
    Ok(Request(route: clone(cutoff.route), system: take texts, tools: take tools, messages: take messages, key: take stable, stream: e.stream, warm: key.kind == WARM))
}

fn fold(mut system: List[Change], mut tools: List[ToolDef], take p: Patch) {
    let Patch(baseline: baseline, changes: take changes, tools: take defs) = take p
    if baseline {
        system = list.new()
    }
    for c in changes {
        let mut found = false
        let mut next: List[Change] = list.new()
        for old in system {
            if old.key == c.key {
                found = true
                if let Some(_) = c.text {
                    list.push(mut next, clone(c))
                }
            } else {
                list.push(mut next, clone(old))
            }
        }
        if !found {
            if let Some(_) = c.text {
                list.push(mut next, clone(c))
            }
        }
        system = take next
    }
    if let Some(take d) = take defs {
        tools = take d
    }
}

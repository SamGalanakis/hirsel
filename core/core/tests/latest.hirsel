// Latest[T] (CONC-13). Arc[u64] admits 16 bytes (counted(8)) and a root admits
// 32, the figure CONC-13 states; every bound below is derived from that 32, so
// a change to either the spec or the runtime's charge turns a law red. Each law repeats under a bound with no room for a leaked
// root or share, so a missing refund or release fails a later iteration, and a
// refusal checks that a bound is still exactly full.
fn number(x: u64) -> u64 {
    x
}

// A read after publish sees the new root. A reader holding the old root keeps
// its share after the publish; dropping it releases the old Arc exactly once.
// Peak: root 32 + old 16 + new 16.
// expect: run read_after_publish() = true
fn read_after_publish() -> bool {
    let r = bound bytes 64 {
        let mut ok = true
        for i in 0u64 .. 40 {
            let h = result.unwrap(latest.new(result.unwrap(arc.new(i))))
            let old = latest.read(h)
            latest.publish(h, result.unwrap(arc.new(i + 1000)))
            let new = latest.read(h)
            let second = latest.read(h)
            ok = ok && number(old) == i && number(new) == i + 1000 && number(second) == i + 1000
        }
        ok
    }
    match r {
        Ok(v) => v,
        _ => false
    }
}

// The old root's share is gone at publish when no reader holds it: the bound
// has room for exactly one replacement Arc after each publish.
// expect: run publish_releases_old_root() = true
fn publish_releases_old_root() -> bool {
    let r = bound bytes 64 {
        let h = result.unwrap(latest.new(result.unwrap(arc.new(0u64))))
        for i in 1u64 .. 50 {
            latest.publish(h, result.unwrap(arc.new(i)))
        }
        let spare = result.unwrap(arc.new(7u64))
        let refused = match arc.new(8u64) {
            Error(_) => true,
            Ok(_) => false
        }
        refused && number(spare) == 7 && number(latest.read(h)) == 49
    }
    match r {
        Ok(v) => v,
        _ => false
    }
}

// `new` under 47 bytes: the Arc takes 16, the root asks CONC-13's 32 of the 31 left and
// the error hands the same Arc back. The last cleanup refunds everything.
// expect: run new_refused_hands_back() = true
fn new_refused_hands_back() -> bool {
    let r = bound bytes 47 {
        let mut ok = true
        for i in 0u64 .. 20 {
            match latest.new(result.unwrap(arc.new(i))) {
                Error((c, take a)) => {
                    ok = ok && c.requested == 32 && c.available == 31 && number(a) == i
                },
                Ok(_) => {
                    ok = false
                }
            }
        }
        ok
    }
    match r {
        Ok(v) => v,
        _ => false
    }
}

// A second handle keeps the root and its Arc charged until the last one drops.
// expect: run last_handle_refunds() = true
fn last_handle_refunds() -> bool {
    let r = bound bytes 48 {
        let mut ok = true
        for i in 0u64 .. 20 {
            let h = result.unwrap(latest.new(result.unwrap(arc.new(i))))
            {
                let k = latest.handle(h)
                ok = ok && number(latest.read(k)) == i
            }
            let full = match arc.new(0u64) {
                Error(_) => true,
                Ok(_) => false
            }
            ok = ok && full
        }
        ok
    }
    match r {
        Ok(v) => v,
        _ => false
    }
}

type Reader: send {
    handles: Receiver[Latest[u64]],
    done: Sender[u64]
}

// The handle is dropped when this returns, before the child reports.
fn read_and_drop(take h: Latest[u64]) -> u64 {
    number(latest.read(h))
}

fn child_loop(take input: Reader) -> u64 waits {
    let Reader(handles, done) = take input
    let mut n: u64 = 0
    while let Ok(h) = channel.receive(handles) {
        result.unwrap(channel.send(done, read_and_drop(take h)))
        n += 1
    }
    n
}

// Peak: root 32 + Arc 16 + published Arc 16. After the child's handle is gone
// the root and its Arc stay charged: one more Arc fits, a second is refused.
fn drive(take handles: Sender[Latest[u64]], done: Receiver[u64]) -> bool waits {
    let r = bound bytes 64 {
        let mut ok = true
        for i in 0u64 .. 8 {
            let h = result.unwrap(latest.new(result.unwrap(arc.new(i))))
            latest.publish(h, result.unwrap(arc.new(i + 100)))
            result.unwrap(channel.send(handles, latest.handle(h)))
            let seen = result.unwrap(channel.receive(done))
            let spare = result.unwrap(arc.new(1u64))
            let full = match arc.new(2u64) {
                Error(_) => true,
                Ok(_) => false
            }
            ok = ok && seen == i + 100 && full && number(spare) == 1
        }
        ok
    }
    match r {
        Ok(v) => v,
        _ => false
    }
}

// Publish on one task, read on another; the reader's handle is dropped there.
// expect: run handle_crosses_tasks(tasks) = true
fn handle_crosses_tasks(tasks: Tasks) -> bool waits {
    let (htx, hrx): (Sender[Latest[u64]], Receiver[Latest[u64]]) = result.unwrap(channel.new(1))
    let (dtx, drx): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(1))
    let input = Reader(handles: take hrx, done: take dtx)
    let child = result.unwrap(task.spawn(tasks, bytes 65536, take input, child_loop))
    let ok = drive(take htx, drx)
    ok && result.unwrap(task.join(take child)) == 8
}

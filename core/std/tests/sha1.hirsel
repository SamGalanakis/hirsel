// test-vectors
fn digest(b: Bytes, hex: Bytes) -> bool {
    let d = result.unwrap(sha1.hash(b))
    let alphabet = result.unwrap(b"0123456789abcdef")
    for i in 0u64 .. 20u64 {
        if alphabet[int.widen(d[i] >> 4)] != hex[i * 2] || alphabet[int.widen(d[i] & 15)] != hex[i * 2 + 1] {
            return false
        }
    }
    true
}

// RFC 3174 section 7.3 TEST1/TEST2/TEST3/TEST4. Mutant: rotl_wrong.
// expect: run rfc3174_short() = true
fn rfc3174_short() -> bool {
    digest(result.unwrap(b"abc"), result.unwrap(b"a9993e364706816aba3e25717850c26c9cd0d89d")) && digest(result.unwrap(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), result.unwrap(b"84983e441c3bd26ebaae4aa1f95129e5e54670f1"))
}

// expect: run rfc3174_million() = true
fn rfc3174_million() -> bool {
    let mut b: Bytes = list.new()
    result.unwrap(list.fill(mut b, 1000000, b'a'))
    digest(b, result.unwrap(b"34aa973cd4c4daa4f61eeb2bdbad27316534016f"))
}

// expect: run rfc3174_repeat() = true
fn rfc3174_repeat() -> bool {
    let mut b: Bytes = list.new()
    for i in 0u64 .. 10u64 {
        result.unwrap(list.append(mut b, result.unwrap(b"0123456701234567012345670123456701234567012345670123456701234567")))
    }
    digest(b, result.unwrap(b"dea356a2cddd90c7a7ecedc5ebb563934f460452"))
}

// Source: NIST CAVP SHA1ShortMsg.rsp and SHA1LongMsg.rsp, CAVS 11.0, public domain.
// expect: run cavp_sha1() = true
fn cavp_sha1() -> bool {
    for row in sha1_cavp_data() {
        let (input, hex) = row
        if !digest(input, string.as_bytes(hex)) {
            return false
        }
    }
    true
}

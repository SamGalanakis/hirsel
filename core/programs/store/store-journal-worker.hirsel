type JournalMsg: send = Frame(Bytes, u64) | Rotate(HostFile, HostFile, Bytes) | Barrier | IdleCheck | ObjectPause(Sender[ObjectJournalStart], Receiver[ObjectJournalStart]) | ObjectFresh(Sender[Result[(), Error]], u64) | ObjectSkipFence(Sender[Result[(), Error]]) | ObjectExportRead(ObjectExportFetch) | StreamAnswer(SlotAck) | ObjectClose(Sender[Result[(), Error]])

type WriteNotice: send = Written | WriteFailed(IoError)

type JournalIdleTimer: send {
    clock: Clock,
    requests: Receiver[()],
    journal: Sender[JournalMsg],
    interval_ns: u64
}

fn journal_idle_timer(take timer: JournalIdleTimer) waits {
    while let Ok(()) = channel.receive(timer.requests) {
        std.clock.sleep_ns(timer.clock, timer.interval_ns)
        if let Error(_) = channel.send(timer.journal, IdleCheck) {
            return
        }
    }
}

type JournalWorker: send {
    store: StoreId,
    seq: u64,
    segment: HostFile,
    end_file: HostFile,
    header: Bytes,
    group_commits: u32,
    group_bytes: u32,
    zero_extension: bool,
    receive: Receiver[JournalMsg],
    send: Sender[Ack],
    ready: Sender[Result[(), Capacity]],
    written: Sender[WriteNotice],
    synced: Sender[()]
}

type JournalBuffers {
    group: Bytes,
    end_bytes: Bytes,
    binding: Bytes
}

fn journal_set(mut raw: Bytes, at: u64, value: u64, width: u64) {
    for i in 0u64 .. width {
        raw[at + i] = int.truncate(value >> (i * 8))
    }
}

fn journal_fixed_check(schema_binding: Bytes, raw: Bytes, at: u64, length: u64) -> u64 {
    let mut state = std.check.start()
    std.check.add(mut state, schema_binding, 0, 33)
    std.check.add(mut state, raw, at, at + 8)
    std.check.add(mut state, raw, at + 16, at + 16 + length)
    std.check.finish(state)
}

fn journal_buffers(reserve: u64) -> Result[JournalBuffers, Capacity] {
    let group: Bytes = list.with_capacity_aligned(journal_group_room(reserve), 4096)
    let mut end_bytes: Bytes = list.with_capacity(96)
    list.fill(mut end_bytes, 96, 0u8)
    let mut schema_binding: Bytes = list.with_capacity(33)
    list.fill(mut schema_binding, 33, 0u8)
    Ok(JournalBuffers(group: take group, end_bytes: take end_bytes, binding: take schema_binding))
}

// END's bytes and checksum binding reuse storage admitted at spawn. The END
// file is a fixed 96 bytes, rewritten in place through the handle opened when
// its segment was created; a torn rewrite fails its checksum like a torn
// truncate-and-write would, and only loses detection (§3.4 step 5).
fn journal_write_end(id: StoreId, seq: u64, end: u64, mut end_file: HostFile, mut raw: Bytes, mut schema_binding: Bytes) -> Result[(), Error] waits {
    journal_set(mut schema_binding, 0, id.hi, 8)
    journal_set(mut schema_binding, 8, id.lo, 8)
    journal_set(mut schema_binding, 16, 4, 1)
    journal_set(mut schema_binding, 17, seq, 8)
    journal_set(mut schema_binding, 25, 0, 8)
    journal_set(mut raw, 0, 1, 2)
    journal_set(mut raw, 2, 1, 2)
    journal_set(mut raw, 4, 56, 4)
    let magic = string.as_bytes("HIRSTORE")
    for i in 0u64 .. 8 {
        raw[16 + i] = magic[i]
    }
    journal_set(mut raw, 24, DISK_FORMAT, 4)
    journal_set(mut raw, 28, 4, 1)
    journal_set(mut raw, 32, id.hi, 8)
    journal_set(mut raw, 40, id.lo, 8)
    journal_set(mut raw, 56, seq, 8)
    let header_check = journal_fixed_check(schema_binding, raw, 0, 56)
    journal_set(mut raw, 8, header_check, 8)
    journal_set(mut raw, 72, 0x0012, 2)
    journal_set(mut raw, 74, 1, 2)
    journal_set(mut raw, 76, 8, 4)
    journal_set(mut raw, 88, end, 8)
    journal_set(mut schema_binding, 25, 72, 8)
    let end_check = journal_fixed_check(schema_binding, raw, 72, 8)
    journal_set(mut raw, 80, end_check, 8)
    match host.write_at(mut end_file, 0, raw) {
        Ok(()) => {},
        Error(e) => return Error(Io(e.error))
    }
    Ok(())
}

fn journal_window_target(end: u64, limit: u64) -> u64 {
    order.min(limit, (end - 72) / 4096 * 4096)
}

fn journal_align_up(n: u64) -> u64 {
    (n + 4095) / 4096 * 4096
}

fn journal_group_room(limit: u64) -> u64 {
    journal_align_up(limit) + 4096
}

fn journal_window_step(mut segment: HostFile, at: u64, width: u64) -> Result[(), Error] waits {
    disk_io(host.zero_at(mut segment, at, width))
}

fn journal_write_aligned(mut segment: HostFile, at: u64, mut buffer: Bytes) -> Result[(), Error] waits {
    let len = list.len(buffer)
    list.fill(mut buffer, journal_align_up(len) - len, 0u8)
    match host.write_at(mut segment, at, buffer) {
        Ok(()) => Ok(()),
        Error(e) => Error(Io(e.error)),
    }
}

fn journal_write_oversized(mut segment: HostFile, block_at: u64, frame: Bytes, mut buffer: Bytes) -> Result[(), Error] waits {
    let room = list.capacity(buffer)
    let mut at = block_at
    let mut consumed = 0u64
    while consumed < list.len(frame) {
        let width = order.min(room - list.len(buffer), list.len(frame) - consumed)
        list.append(mut buffer, list.slice(frame, consumed, consumed + width))
        journal_write_aligned(mut segment, at, mut buffer)?
        consumed += width
        if consumed < list.len(frame) {
            at += room
            list.clear(mut buffer)
        }
    }
    Ok(())
}

fn journal_loop(take input: JournalWorker, take scratch: JournalBuffers) -> Result[(), Error] waits {
    let JournalWorker(store: id, seq: initial_seq, segment: take segment, end_file: take end_file, header: take first_header, group_commits: max_frames, group_bytes: max_bytes, zero_extension: zero_extension, receive: take receive, send: take send, ready: _, written: take notices, synced: take synced) = take input
    let mut segment_file = take segment
    let mut end_handle = take end_file
    let mut seq = initial_seq
    let mut end = 72u64
    let mut window = 4096u64
    // The d the END file holds: 72 from segment creation.
    let mut end_named = 72u64
    let mut written = 0u64
    let mut groups = 0u64
    let JournalBuffers(group: take reserved, end_bytes: take initial_end, binding: take initial_binding) = take scratch
    let mut buffer = take reserved
    list.append(mut buffer, first_header)
    drop(take first_header)
    let mut end_bytes = take initial_end
    let mut schema_binding = take initial_binding
    let group_limit: u64 = int.widen(max_bytes)
    let window_limit = if zero_extension {
        order.max(JOURNAL_WINDOW_STEP, (group_limit + JOURNAL_WINDOW_STEP - 1) / JOURNAL_WINDOW_STEP * JOURNAL_WINDOW_STEP)
    } else {
        0u64
    }
    // Groups since the last one of JOURNAL_BULK_GROUP bytes or more. A
    // group that large amortizes its own extension, so zero steps wait until
    // 64 smaller groups in a row (§3.3a Bulk).
    let mut small_groups = 64u64
    let mut deferred: Option[JournalMsg] = None
    loop {
        let mut next_message = replace(mut deferred, None)
        if let None = next_message {
            if groups != 0 {
                // A cap or Barrier can end a group without probing the queue.
                match channel.try_receive(receive) {
                    Ok(take msg) => {
                        next_message = Some(take msg)
                    },
                    Error(Empty) => {
                        if end != end_named {
                            journal_write_end(id, seq, end, mut end_handle, mut end_bytes, mut schema_binding)?
                            end_named = end
                        }
                        groups = 0
                    },
                    Error(Closed) => {}
                }
            }
            if let None = next_message {
                let target = if small_groups >= 64 {
                    journal_window_target(end, window_limit)
                } else {
                    0u64
                }
                while window - end < target / 2 {
                    match channel.try_receive(receive) {
                        Ok(take msg) => {
                            next_message = Some(take msg)
                            break
                        },
                        Error(Empty) => {
                            let width = order.min(JOURNAL_WINDOW_STEP, journal_align_up(end + target) - window)
                            journal_window_step(mut segment_file, window, width)?
                            window += width
                        },
                        Error(Closed) => break,
                    }
                }
            }
            if let None = next_message {
                if end != end_named {
                    journal_write_end(id, seq, end, mut end_handle, mut end_bytes, mut schema_binding)?
                    end_named = end
                    groups = 0
                }
                next_message = match channel.receive(receive) {
                    Ok(take msg) => Some(take msg),
                    Error(_) => None
                }
            }
        }
        list.truncate(mut buffer, end % 4096)
        let mut oversized: Option[Bytes] = None
        let mut frames = 0u64
        let mut group_bytes = 0u64
        let mut last_frame = 0u64
        let mut idle = false
        let mut closing = false
        let mut rotating: Option[(HostFile, HostFile, Bytes)] = None
        let mut answering = false
        loop {
            let selected = replace(mut next_message, None)
            match take selected {
                None => {
                    closing = true;
                    break
                },
                Some(Frame(take raw, number)) => {
                    let length = list.len(raw)
                    if frames != 0 && group_bytes + length > group_limit {
                        deferred = Some(Frame(take raw, number))
                        break
                    }
                    if length > group_limit {
                        oversized = Some(take raw)
                    } else {
                        list.append(mut buffer, raw)
                    }
                    group_bytes += length
                    last_frame = number
                    frames += 1
                    if frames >= int.widen(max_frames) || group_bytes >= group_limit {
                        break
                    }
                },
                Some(Rotate(take file, take rotated_end, take header)) => {
                    rotating = Some((take file, take rotated_end, take header));
                    break
                },
                Some(Barrier) => {
                    answering = true;
                    break
                },
                Some(ObjectPause(..)) => fail("log journal received an object cut"),
                Some(ObjectFresh(..)) => fail("log journal received an object head probe"),
                Some(ObjectSkipFence(..)) => fail("log journal received an object head probe"),
                Some(ObjectExportRead(..)) => fail("log journal received an object export read"),
                Some(IdleCheck) => fail("log journal received an idle-buffer timer"),
                Some(StreamAnswer(..)) => fail("log journal received a stream answer"),
                Some(ObjectClose(..)) => fail("log journal received an object close"),
            }
            match channel.try_receive(receive) {
                Ok(take msg) => {
                    next_message = Some(take msg)
                },
                Error(Empty) => {
                    idle = true;
                    break
                },
                Error(Closed) => {
                    closing = true;
                    break
                }
            }
        }
        if frames != 0 {
            let block_at = end - (end % 4096)
            match take oversized {
                Some(take frame) => journal_write_oversized(mut segment_file, block_at, frame, mut buffer)?,
                None => journal_write_aligned(mut segment_file, block_at, mut buffer)?,
            }
            end += group_bytes
            window = order.max(window, journal_align_up(end))
            let tail = end % 4096
            if tail != 0 {
                let tail_at = list.len(buffer) - 4096
                list.copy_within(mut buffer, tail_at, 0, tail)
            }
            list.truncate(mut buffer, tail)
        }
        if answering {
            let _ = channel.try_send(notices, Written)
        }
        if frames != 0 {
            written += group_bytes
            if let Error(_) = channel.send(send, Journaled(last_frame, written)) {
                return Ok(())
            }
            // After the ack, so a writer woken by this notice finds it.
            let _ = channel.try_send(synced, ())
            groups += 1
            small_groups = if group_bytes >= JOURNAL_BULK_GROUP {
                0u64
            } else {
                order.min(64u64, small_groups + 1)
            }
        }
        let rotate_now = match rotating {
            Some(_) => true,
            None => false
        }
        // An END that would repeat the d already named writes nothing.
        let load_end = groups == 64
        if (idle || closing || rotate_now || load_end) && end != end_named {
            journal_write_end(id, seq, end, mut end_handle, mut end_bytes, mut schema_binding)?
            end_named = end
            groups = 0
            let target = journal_window_target(end, window_limit)
            if load_end && small_groups >= 64 && window - end < target / 2 {
                let width = order.min(JOURNAL_WINDOW_STEP, journal_align_up(end + target) - window)
                journal_window_step(mut segment_file, window, width)?
                window += width
            }
        }
        if let Some((take new_file, take new_end, take next_header)) = take rotating {
            disk_io(host.close(take segment_file))?
            disk_io(host.close(replace(mut end_handle, take new_end)))?
            segment_file = take new_file
            seq += 1
            end = 72
            window = 4096
            end_named = 72
            list.clear(mut buffer)
            list.append(mut buffer, next_header)
        }
        if closing {
            disk_io(host.close(take segment_file))?
            disk_io(host.close(take end_handle))?
            return Ok(())
        }
    }
}

fn journal_worker(take input: JournalWorker) -> Result[(), Error] waits {
    let allocation = journal_buffers(int.widen(input.group_bytes))
    let reserved = match take allocation {
        Ok(take buffer) => take buffer,
        Error(c) => {
            let _ = channel.send(input.ready, Error(c));
            return Ok(())
        }
    }
    if let Error(_) = channel.send(input.ready, Ok(())) {
        return Ok(())
    }
    let send = channel.sender(input.send)
    let written = channel.sender(input.written)
    let synced = channel.sender(input.synced)
    let result = journal_loop(take input, take reserved)
    if let Error(Io(e)) = result {
        let _ = channel.try_send(written, WriteFailed(e))
        let _ = channel.send(send, Broken(e))
        let _ = channel.try_send(synced, ())
    }
    take result
}

// A new segment: its Direct creation block (header and zeros to 4096) and
// its Durable END, then the directory sync (§3.3b).
fn disk_creation_block() -> Result[Bytes, Error] {
    disk_allocation(scoped fn() -> Result[Bytes, Error] {
        let mut raw: Bytes = list.with_capacity_aligned(4096, 4096)
        list.fill(mut raw, 4096, 0u8)
        Ok(take raw)
    })
}

fn disk_new_segment(d: Dir, c: Clock, id: StoreId, seq: u64, prev_end: u64, mut creation: Bytes) -> Result[(HostFile, HostFile, Bytes), Error] waits {
    let (take path, take end_path, take journal, take end_bytes) = disk_allocation(scoped fn() -> Result[(String, String, Bytes, Bytes), Error] {
        let path = capacity(disk_path("j-", seq, ""))?
        let end_path = capacity(disk_path("j-", seq, ".end"))?
        let header = capacity(disk_header_bytes(DiskContext(store: id, role: 2, seq: seq), prev_end, 0))?
        let ctx = DiskContext(store: id, role: 4, seq: seq)
        let mut end_bytes = capacity(disk_header_bytes(ctx, 0, 0))?
        let mut payload: Bytes = list.with_capacity(8)
        capacity(le(mut payload, 72, 8))?
        let frame = capacity(disk_seal(ctx, 72, 0x0012, 1, payload))?
        list.append(mut end_bytes, frame)
        Ok((take path, take end_path, take header, take end_bytes))
    })?
    let mut file = disk_io(host.open(d, path, Direct))?
    while !disk_io(host.try_lock(mut file))? {
        std.clock.sleep_ns(c, 1000000)
    }
    list.copy_from_slice(mut creation, 0, journal)
    match host.write_at(mut file, 0, creation) {
        Ok(()) => (),
        Error(e) => return Error(Io(e.error)),
    }
    let mut end_file = disk_io(host.open(d, end_path, Durable))?
    match host.write_at(mut end_file, 0, end_bytes) {
        Ok(()) => (),
        Error(e) => return Error(Io(e.error)),
    }
    disk_io(host.sync_dir(d))?
    Ok((take file, take end_file, take journal))
}

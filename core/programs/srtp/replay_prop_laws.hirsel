// RTP-2 indices end at 2^48 - 1.
const RTP_LIMIT: u64 = 1 << 48

type EstimateDraw {
    highest: u64,
    seq: u16
}

type ReplayOp {
    kind: u64,
    a: u64,
    b: u64
}

type ReplayCase {
    estimates: List[EstimateDraw],
    start: Option[u64],
    ops: List[ReplayOp]
}

fn interesting_low(mut src: std.prop.Source) -> u64 {
    let center = std.prop.below(mut src, 6)
    let delta = std.prop.below(mut src, 5)
    if center == 0 {
        delta
    } else if center == 1 {
        32767 - delta
    } else if center == 2 {
        32768 + delta
    } else if center == 3 {
        65535 - delta
    } else if center == 4 {
        32768 - delta
    } else {
        std.prop.below(mut src, 65536)
    }
}

fn highest_draw(mut src: std.prop.Source) -> u64 {
    let kind = std.prop.below(mut src, 7)
    if kind == 0 {
        interesting_low(mut src)
    } else if kind == 1 {
        ((1 + std.prop.below(mut src, 255)) << 16) | interesting_low(mut src)
    } else if kind == 2 {
        (std.prop.below(mut src, 0xfffffffe) << 16) | interesting_low(mut src)
    } else if kind == 3 {
        (0xfffffffe << 16) | interesting_low(mut src)
    } else if kind == 4 {
        (0xffffffff << 16) | interesting_low(mut src)
    } else if kind == 5 {
        RTP_LIMIT - 1 - std.prop.below(mut src, 2048)
    } else {
        std.prop.below(mut src, RTP_LIMIT)
    }
}

fn absolute_index(mode: u64, raw: u64) -> u64 {
    let pick = mode % 6
    if pick == 0 {
        raw % 1024
    } else if pick == 1 {
        32764 + raw % 1032
    } else if pick == 2 {
        65528 + raw % 1032
    } else if pick == 3 {
        196096 + raw % 1032
    } else if pick == 4 {
        RTP_LIMIT - 1 - raw % 2048
    } else {
        raw % RTP_LIMIT
    }
}

fn replay_op(mut src: std.prop.Source) -> ReplayOp {
    ReplayOp(kind: std.prop.below(mut src, 12), a: std.prop.word(mut src), b: std.prop.word(mut src))
}

fn show_replay_case(c: ReplayCase, mut out: String) {
    string.push(mut out, "ReplayCase(estimates: ")
    string.push_u64(mut out, list.len(c.estimates))
    string.push(mut out, ", ops: ")
    string.push_u64(mut out, list.len(c.ops))
    string.push(mut out, ")")
}

fn replay_case_gen() -> std.prop.Gen[ReplayCase] {
    std.prop.make(fn(mut src: std.prop.Source) -> ReplayCase {
        let mut estimates: List[EstimateDraw] = list.new()
        for _ in 0u64 .. 8 {
            let highest = highest_draw(mut src)
            let seq: u16 = int.narrow(interesting_low(mut src))
            list.push(mut estimates, EstimateDraw(highest, seq))
        }
        let start = if std.prop.weighted(mut src, 1, 3) {
            Some(absolute_index(std.prop.below(mut src, 6), std.prop.word(mut src)))
        } else {
            None
        }
        let mut ops: List[ReplayOp] = list.new()
        for i in 0u64 ..= 64 {
            let drawn = std.prop.span(mut src, 11, fn(mut choice: std.prop.Source) -> Option[ReplayOp] {
                let more = std.prop.weighted(mut choice, if i < 64 {
                    7
                } else {
                    0
                }, 8)
                if more && i < 64 {
                    Some(replay_op(mut choice))
                } else {
                    None
                }
            })
            let Some(op) = drawn else {
                break
            }
            list.push(mut ops, op)
        }
        ReplayCase(estimates: take estimates, start, ops: take ops)
    }, show_replay_case)
}

// RFC 3711 Appendix A, written as a circular-distance choice. The strict
// comparisons in Appendix A keep the current ROC when the distance is exactly
// half a sequence cycle. The candidate is unreduced, matching replay.hirsel's
// internal contract: its callers turn a candidate past the 48-bit space into
// exhaustion rather than a negative-cycle refusal.
fn appendix_a_estimate(highest: u64, seq: u16) -> Option[u64] {
    let low = highest & 65535
    let roc = highest >> 16
    let wire: u64 = int.widen(seq)
    let ahead = (wire + 65536 - low) % 65536
    let v = if wire > low && ahead > 32768 {
        if roc == 0 {
            return None
        }
        roc - 1
    } else if wire < low && ahead < 32768 {
        roc + 1
    } else {
        roc
    }
    Some((v << 16) | wire)
}

fn push_option_u64(mut out: String, value: Option[u64]) {
    match value {
        Some(n) => string.push_u64(mut out, n),
        None => string.push(mut out, "None"),
    }
}

fn estimate_miss(d: EstimateDraw, actual: Option[u64], wanted: Option[u64]) -> String {
    let mut out = string.from("T1: estimate differs at highest ")
    string.push_u64(mut out, d.highest)
    string.push(mut out, ", seq ")
    string.push_u64(mut out, int.widen(d.seq))
    string.push(mut out, ": got ")
    push_option_u64(mut out, actual)
    string.push(mut out, ", RFC 3711 Appendix A gives ")
    push_option_u64(mut out, wanted)
    out
}

fn check_estimate(d: EstimateDraw) -> Result[(), String] {
    let wanted = appendix_a_estimate(d.highest, d.seq)
    // RTP-2 reports an index past 2^48 - 1 as Beyond; Appendix A leaves it unreduced.
    let actual = match rtp.seq.estimate(d.highest, d.seq) {
        Index(index) => Some(index),
        Before => None,
        Beyond => match wanted {
            Some(index) => if index >= RTP_LIMIT {
                wanted
            } else {
                None
            },
            None => Some(RTP_LIMIT),
        },
    }
    if actual != wanted {
        return Error(estimate_miss(d, actual, wanted))
    }
    if let Some(index) = actual {
        let wire: u64 = int.widen(d.seq)
        if index % 65536 != wire {
            return Error(estimate_miss(d, actual, wanted))
        }
        let distance = if index >= d.highest {
            index - d.highest
        } else {
            d.highest - index
        }
        if distance > 32768 {
            return Error(estimate_miss(d, actual, wanted))
        }
    }
    Ok(())
}

fn advance_index(high: Option[u64], op: ReplayOp) -> u64 {
    let base = match high {
        Some(h) => h,
        None => absolute_index(op.a % 6, op.b),
    }
    if base >= RTP_LIMIT - 1 {
        return base
    }
    let span = RTP_LIMIT - base - 1
    let reach = if op.a % 8 == 0 {
        span
    } else {
        order.min(span, 160)
    }
    base + 1 + op.b % reach
}

fn backward_index(high: Option[u64], op: ReplayOp) -> u64 {
    match high {
        Some(h) => {
            let depth = 1 + op.b % 140
            if depth > h {
                0
            } else {
                h - depth
            }
        },
        None => absolute_index(op.a % 6, op.b),
    }
}

fn op_index(offered: List[u64], high: Option[u64], op: ReplayOp) -> u64 {
    let kind = op.kind % 10
    if kind <= 4 {
        advance_index(high, op)
    } else if kind == 5 {
        backward_index(high, op)
    } else if kind <= 7 {
        if list.len(offered) == 0 {
            advance_index(high, op)
        } else {
            offered[op.b % list.len(offered)]
        }
    } else {
        absolute_index(op.a % 6, op.b)
    }
}

fn replay_miss(rule: String, index: u64, at: u64) -> String {
    let mut out = string.from(rule)
    string.push(mut out, " at operation ")
    string.push_u64(mut out, at)
    string.push(mut out, ", index ")
    string.push_u64(mut out, index)
    out
}

fn floor_miss(before: u64, after: u64, at: u64) -> String {
    let mut out = string.from("T4: kept_floor fell at operation ")
    string.push_u64(mut out, at)
    string.push(mut out, ": ")
    string.push_u64(mut out, before)
    string.push(mut out, " -> ")
    string.push_u64(mut out, after)
    out
}

fn max_index(old: Option[u64], index: u64) -> Option[u64] {
    match old {
        Some(h) if index <= h => old,
        _ => Some(index),
    }
}

fn replay_reference_law(c: ReplayCase) -> Result[(), String] {
    for d in c.estimates {
        check_estimate(d)?
    }
    let mut w = window(start_floor(c.start))
    let mut accepted: std.set.Set[u64] = std.set.new()
    let mut offered: List[u64] = list.new()
    let mut highest = c.start
    for at in 0u64 .. list.len(c.ops) {
        let op = c.ops[at]
        if op.kind % 12 >= 10 {
            let before = w.floor.minimum
            let kept = kept_floor(w)
            if kept.minimum < before {
                return Error(floor_miss(before, kept.minimum, at))
            }
            w = window(kept)
            continue
        }
        let index = op_index(offered, highest, op)
        list.push(mut offered, index)
        let ok = match check_window(w, index) {
            Ok(()) => true,
            Error(_) => false,
        }
        let fresh_high = match highest {
            Some(h) => index > h,
            None => true,
        }
        if fresh_high && index < RTP_LIMIT && !ok {
            return Error(replay_miss(string.from("T3: a new highest index was refused"), index, at))
        }
        if ok {
            if std.set.contains(accepted, index) {
                return Error(replay_miss(string.from("T2: an index was accepted twice"), index, at))
            }
            let _ = std.set.insert(mut accepted, index)
            mark(mut w, index)
            highest = max_index(highest, index)
        }
    }
    Ok(())
}

/// bug: choose the wrong ROC at a sequence wrap or the 48-bit limit, accept an index twice, refuse a new highest index, or lower a kept floor across resume.
/// oracle: RFC 3711 Appendix A and section 3.3.2, with an independent Set of accepted indices as the replay-list model.
@test
fn replay_reference_model(seed_grant: Env) -> Result[(), ()] {
    let seed = match std.sim.world.test_seed(seed_grant) {
        Some(n) => n,
        None => 0,
    }
    let mut config = std.prop.config()
    config.seed = seed
    std.prop.check(config, replay_case_gen(), replay_reference_law)
}

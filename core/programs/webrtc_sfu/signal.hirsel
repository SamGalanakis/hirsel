// RTC-8: signaling through runner.room (webrtc spec, slice S7). The adapter is sans-IO.
// `room_in` takes the room client's `RoomIn` entries in order and answers with `RoomOut`;
// `step` drives the control order on the control unit, unit 0, one call in flight, and
// turns its answers and `Event.Fenced` into signals. A session is built from an offer on
// its home unit: the adapter asks for it with a `Build` and is told the outcome by
// `built`, which the driver calls once the home unit has opened and parked the session.
pub type Signal: codec + send = Offer(u64, Bytes) | Answer(u64, Bytes) | Candidate(Bytes) | EndOfCandidates | Glare(u64) | Subscribe(u64, router.Target) | Target(u64, router.Target) | Unsubscribe(u64) | Published(u64, u64, u8, u8) | Unpublished(u64) | Layers(u64, u8) | Speakers(List[u64], u8) | Fenced(u64, u64) | Refused(u32) | Servers(Bytes, Bytes)

/// The application's message type `M` and the signal inside it (RTC-8). `publish`
/// answers whether a peer may publish.
pub type Embed[M]: send {
    wrap: own[send] fn(take Signal) -> M,
    unwrap: own[send] fn(take M) -> Option[Signal],
    publish: own[send] fn(u32) -> bool
}

/// A session the adapter asks the home unit `home` to build from a peer's offer
/// (version `version`, SDP `offer`), for router participant `who`. `publish` is the
/// application's answer for the peer: without it, every section the peer sends on is
/// answered `inactive` (RTC-2, receive-only participants).
pub type Build: cross {
    who: peer.Participant,
    home: u16,
    peer: u32,
    version: u64,
    offer: Bytes,
    publish: bool,
    // The ICE credentials minted with the peer's TURN ones at admission (TURN-5), which
    // the answer carries; empty when the service has no relay, and the unit draws them.
    ice_ufrag: Bytes,
    ice_pwd: Bytes
}

/// What the home unit made of a `Build`: the answer's SDP text, the sections the peer
/// sends on (publications) and the sections the server may send on, with their kind.
pub type Built: cross {
    answer: Bytes,
    recvs: List[u8],
    sends: List[(u8, sdp.Media)]
}

/// Codes of `Refused` (RTC-8 Refusals): the `RouterError` tag, from 1, 0 for a
/// signal the adapter does not take from a client, and 11 for an offer longer than
/// `OFFER_MAX`.
pub const REFUSED_NOT_TAKEN: u32 = 0

pub const REFUSED_OFFER_TOO_LARGE: u32 = 11

/// The longest offer SDP the adapter builds a session from: RTC-1's text bound, inside
/// one `runner.MESSAGE_MAX` room message (RTC-8 Offer size).
pub const OFFER_MAX: u64 = sdp.TEXT_LIMIT

// An admission's place in its life: no offer yet, a build asked of its home unit, its
// `Admit` in the control order, admitted.
type Stage: key = Waiting | Building | Admitting | Live

// One admission identity (incarnation, peer) and the router participant it maps to.
type Seat {
    peer: u32,
    id: u64,
    epoch: u64,
    stage: Stage,
    home: u16,
    version: u64,
    // Sections the server may send on and those it sends on now (publication id).
    sends: List[(u8, sdp.Media)],
    subs: List[(u64, u8)],
    // The version of the server's re-offer the peer has not answered (RTC-4).
    offered: Option[u64],
    // The ICE ufrag and password minted at admission with the TURN credentials.
    ice: Option[(Bytes, Bytes)]
}

// A publication: its id, its owner's peer number and generation, its kind and its
// encodings, as `Published` names them.
type Pub {
    id: u64,
    owner: peer.Gen,
    peer: u32,
    media: sdp.Media,
    encodings: u8
}

// What to do with a control call's answer.
type After = Quiet | Admitted(peer.Gen, u64, Bytes, List[u8]) | Discard | Opening | Ended | Fence(u32, peer.Gen) | Announced(peer.Gen, u8) | Subscribed(peer.Gen, u64, u8) | Unsubscribed(peer.Gen, u64) | Changed(peer.Gen)

type Job {
    change: router.Change,
    after: After
}

/// The TURN side of signaling (TURN-5, TURN-9; turn.md's U8 decisions): the master that
/// mints each admission's credentials (it needs `mac`), the plan the relay place shares,
/// and the randomness of the ICE credentials minted beside them.
pub type Relaying {
    master: Secret,
    plan: RelayPlan,
    random: Random
}

// What the adapter rebuilds after `Lost`, until it resumes: the scratch roster, its
// incarnation and revision, whether a Part head has come since the last `Lost`, whether
// an entry came without one, and the open Part's `snapshot` flag.
type Recovery {
    scratch: List[u32],
    incarnation: Option[runner.room_client.Incarnation],
    revision: u64,
    headed: bool,
    headless: bool,
    snapshot: bool
}

// The room's signaling (RTC-8): live, or lost and recovering its roster.
type Signaling = Live | Lost(Recovery)

// An adapter serves one room, `room`: every `peer.Gen` it keeps (seats, publications,
// jobs, `fencing`, `gone`, `answers`) names a participant of that room (RTC-10, Every
// key carries its room).
pub opaque type Adapter[M] {
    room: peer.RoomId,
    limits: router.RoomLimits,
    embed: Embed[M],
    // The service's own peer number, and its numbers from before a rejoin whose
    // `Left` has not come yet: none of them is ever admitted.
    you: Option[u32],
    former: List[u32],
    // The roster the adapter applied: its incarnation and last revision, and the
    // admissions. `epoch` is the room's one rising counter.
    incarnation: Option[runner.room_client.Incarnation],
    applied: u64,
    seats: List[Seat],
    epoch: u64,
    pubs: List[Pub],
    signaling: Signaling,
    // The control order: the call in flight and what waits, in order.
    calling: Option[After],
    jobs: List[Job],
    // Revokes whose `Fenced` waits on the fence: the participant and its peer.
    fencing: List[(peer.Gen, u32)],
    // Sessions being built, and their home units, for admissions that ended before
    // the build came back.
    gone: List[(peer.Gen, u16)],
    builds: List[Build],
    // Answers to re-offers, for the control unit's router at the next `step`.
    answers: List[(peer.Gen, u64, Bytes)],
    // The relay this room's admissions get TURN credentials for, the wall clock in
    // Unix seconds the driver last gave, and revokes for the relay place.
    relaying: Option[Relaying],
    unix_s: u64,
    revokes: List[RelayRevoke],
    // The room's life on the units: open, its `Close` asked, or closed on every unit.
    life: Life,
    // The answer to the room's `Open`, until the pool takes it, and whether it was refused.
    opening: Option[Result[(), router.RouterError]],
    refused: bool
}

type Life: key = Serving | Closing | Gone

/// The adapter of `room`. Its first control call opens the room; the pool's ledger
/// homes its sessions (`home_builds`).
pub fn adapter[M: codec](room: peer.RoomId, limits: router.RoomLimits, take embed: Embed[M]) -> Adapter[M] {
    let mut jobs: List[Job] = list.new()
    list.push(mut jobs, Job(change: Open(room: room, limits: limits), after: Opening))
    Adapter(room: room, limits: limits, embed: take embed, you: None, former: list.new(), incarnation: None, applied: 0, seats: list.new(), epoch: 0, pubs: list.new(), signaling: Live, calling: None, jobs: take jobs, fencing: list.new(), gone: list.new(), builds: list.new(), answers: list.new(), relaying: None, unix_s: 0, revokes: list.new(), life: Serving, opening: None, refused: false)
}

/// Give the adapter a relay: from now on each admission is minted TURN credentials and
/// ICE ones together (TURN-5), sent `Servers(username, password)` before any offer, and
/// answered with those ICE credentials; each admission that ends is revoked at the relay.
pub fn relay[M](mut a: Adapter[M], take r: Relaying) {
    a.relaying = Some(take r)
}

/// The wall clock, in Unix seconds, that credentials and relay revokes are dated by.
pub fn wall[M](mut a: Adapter[M], unix_s: u64) {
    a.unix_s = unix_s
}

/// Take the relay revokes (TURN-9) for admissions that ended since the last call.
pub fn take_revokes[M](mut a: Adapter[M]) -> List[RelayRevoke] {
    replace(mut a.revokes, list.new())
}

// The admission's TURN subject (incarnation, peer), once the roster's incarnation is known.
fn subject_of[M](a: Adapter[M], peer: u32) -> Option[Bytes] {
    let Some(Incarnation(inc)) = a.incarnation else {
        return None
    }
    Some(admission_subject(inc, int.widen(peer)))
}

/// The service's own peer number in the room, which the room client knows
/// (`runner.room_client.member(room).you`); the adapter never admits it. After a
/// rejoin the old number may still be in the roster image until its `Left`, so it is
/// kept and not admitted either.
pub fn you[M](mut a: Adapter[M], peer: Option[u32]) {
    if let Some(old) = a.you {
        if peer != a.you && !listed(a.former, old) {
            list.push(mut a.former, old)
        }
    }
    if peer != None {
        a.you = peer
    }
}

fn is_self[M](a: Adapter[M], p: u32) -> bool {
    a.you == Some(p) || listed(a.former, p)
}

/// No control call is in flight or waiting.
pub fn idle[M](a: Adapter[M]) -> bool {
    !busy(a) && list.len(a.jobs) == 0
}

/// Close the room (RTC-10): `Close` goes ahead of every waiting call, which it would
/// refuse, and is applied at each unit's fence point after the call in flight.
pub fn close[M](mut a: Adapter[M]) {
    if a.life != Serving {
        return
    }
    a.life = Closing
    list.clear(mut a.jobs)
    list.clear(mut a.builds)
    list.push(mut a.jobs, Job(change: Close(room: a.room), after: Ended))
}

/// The adapter's room.
pub fn room_of[M](a: Adapter[M]) -> peer.RoomId {
    a.room
}

/// The answer to the room's `Open`, once, when it has come.
pub fn opened[M](mut a: Adapter[M]) -> Option[Result[(), router.RouterError]] {
    replace(mut a.opening, None)
}

/// Whether the units refused to open the room.
pub fn was_refused[M](a: Adapter[M]) -> bool {
    a.refused
}

/// Whether the room's `Close` has completed on every unit.
pub fn closed[M](a: Adapter[M]) -> bool {
    a.life == Gone
}

/// Whether the adapter holds the room suspended for signaling loss.
pub fn lost[M](a: Adapter[M]) -> bool {
    match a.signaling {
        Lost(_) => true,
        Live => false,
    }
}

// An entry while the room is lost: the recovery is headless if no Part head came first.
fn unheaded[M](mut a: Adapter[M]) -> bool {
    if let Lost(mut r) = a.signaling {
        if !r.headed {
            r.headless = true
        }
        return true
    }
    false
}

/// The router participant the admission of peer `number` maps to.
pub fn participant[M](a: Adapter[M], number: u32) -> Option[peer.Gen] {
    match seat_at(a, number) {
        Some(i) => Some(Gen(id: a.seats[i].id, epoch: a.seats[i].epoch)),
        None => None,
    }
}

fn busy[M](a: Adapter[M]) -> bool {
    match a.calling {
        Some(_) => true,
        None => false,
    }
}

/// Take the builds the room asked for since the last call, each homed and reserved
/// on `l` (RTC-10 Home units). A join no unit has room for is `Limit(sessions)`: it is
/// answered `Refused` as any refused join is, and nothing is reserved.
pub fn home_builds[M](mut a: Adapter[M], mut l: Ledger, mut out: List[runner.room_client.RoomOut[M]]) -> List[Build] {
    let mut homed: List[Build] = list.new()
    for take b in replace(mut a.builds, list.new()) {
        let who = b.who
        let Some(home) = reserve_session(mut l, who) else {
            built(mut a, who, Error(Limit(l.sessions)), mut out)
            continue
        }
        if let Some(i) = seat_of(a, who.gen) {
            a.seats[i].home = home
        }
        for k in 0u64 .. list.len(a.gone) {
            if a.gone[k].0 == who.gen {
                a.gone[k] = (who.gen, home)
            }
        }
        let mut sent = take b
        sent.home = home
        list.push(mut homed, take sent)
    }
    homed
}

fn seat_at[M](a: Adapter[M], peer: u32) -> Option[u64] {
    for i in 0u64 .. list.len(a.seats) {
        if a.seats[i].peer == peer {
            return Some(i)
        }
    }
    None
}

fn seat_of[M](a: Adapter[M], g: peer.Gen) -> Option[u64] {
    let Gen(id: id, epoch: epoch) = g
    for i in 0u64 .. list.len(a.seats) {
        if a.seats[i].id == id && a.seats[i].epoch == epoch {
            return Some(i)
        }
    }
    None
}

fn listed(xs: List[u32], v: u32) -> bool {
    for x in xs {
        if x == v {
            return true
        }
    }
    false
}

fn unlist(mut xs: List[u32], v: u32) {
    list.retain(mut xs, scoped fn(x: u32) -> bool {
        x != v
    })
}

fn say[M](a: Adapter[M], take s: Signal) -> M {
    (a.embed.wrap)(take s)
}

fn to_peer[M](a: Adapter[M], peer: u32, take s: Signal, mut out: List[runner.room_client.RoomOut[M]]) {
    list.push(mut out, ToPeer(peer, say(a, take s)))
}

fn to_room[M](a: Adapter[M], take s: Signal, mut out: List[runner.room_client.RoomOut[M]]) {
    list.push(mut out, ToRoom(say(a, take s)))
}

/// The `Refused` code of a router error: its tag, from 1.
pub fn code(e: router.RouterError) -> u32 {
    match e {
        NoRoom => 1,
        NoParticipant => 2,
        NoPublication => 3,
        Fenced => 4,
        Suspended => 5,
        Exists => 6,
        Limit(_) => 7,
        Unrepresentable => 8,
        Peer(_) => 9,
        Capacity(_) => 10,
    }
}

// ---- Identity (RTC-8): dense ids, one rising epoch ----
// The lowest id with no live admission. An admission being revoked is not live: its
// revoke is ahead of any admission of the reused id in the control order, and the
// reused id comes back at a higher epoch, above its fence.
fn free_id[M](a: Adapter[M]) -> Option[u64] {
    let ids: u64 = int.widen(a.limits.ids)
    for id in 0u64 .. ids {
        let mut used = false
        for s in a.seats {
            if s.id == id {
                used = true
            }
        }
        if !used {
            return Some(id)
        }
    }
    None
}

// A new admission identity for `peer`. A room whose ids are all live refuses it.
fn admit_new[M](mut a: Adapter[M], peer: u32, mut out: List[runner.room_client.RoomOut[M]]) {
    if is_self(a, peer) || seat_at(a, peer) != None {
        return
    }
    let Some(id) = free_id(a) else {
        to_peer(a, peer, Refused(code(Limit(int.widen(a.limits.ids)))), mut out)
        return
    }
    a.epoch += 1
    let mut ice: Option[(Bytes, Bytes)] = None
    if let Some(subject) = subject_of(a, peer) {
        if let Some(r) = a.relaying {
            match mint_session(r.master, r.random, subject, a.unix_s, r.plan) {
                Ok(take c) => {
                    let SessionCredentials(ice_ufrag: take ufrag, ice_pwd: take pwd, turn_username: take username, turn_password: take password, expiry_unix_s: _) = take c
                    ice = Some((take ufrag, take pwd))
                    to_peer(a, peer, Servers(take username, take password), mut out)
                },
                Error(_) => (),
            }
        }
    }
    list.push(mut a.seats, Seat(peer: peer, id: id, epoch: a.epoch, stage: Waiting, home: 0, version: 0, sends: list.new(), subs: list.new(), offered: None, ice: take ice))
    // A joining peer learns the publications made before it joined (RTC-8 Joining).
    for p in a.pubs {
        to_peer(a, peer, Published(int.widen(p.peer), p.id, kind_of(p.media), p.encodings), mut out)
    }
}

fn kind_of(media: sdp.Media) -> u8 {
    if media == Audio {
        0
    } else {
        1
    }
}

// The publications of `g` end with its admission (RTC-8 Departures): each
// subscriber's section for one is free again, since the revoke that ends its
// down-tracks on every unit is ahead of any later call in the control order, and the
// room is told `Unpublished`.
fn drop_pubs[M](mut a: Adapter[M], g: peer.Gen, mut out: List[runner.room_client.RoomOut[M]]) {
    let mut gone: List[u64] = list.new()
    for p in a.pubs {
        if p.owner == g {
            list.push(mut gone, p.id)
        }
    }
    list.retain(mut a.pubs, scoped fn(p: Pub) -> bool {
        p.owner != g
    })
    for id in gone {
        for i in 0u64 .. list.len(a.seats) {
            list.retain(mut a.seats[i].subs, scoped fn(x: (u64, u8)) -> bool {
                x.0 != id
            })
        }
        to_room(a, Unpublished(id), mut out)
    }
}

// End the admission at seat `i`: its session is revoked, and `Fenced` is sent once the
// fence holds. An admission with no session anywhere is fenced at once.
fn end_seat[M](mut a: Adapter[M], i: u64, mut out: List[runner.room_client.RoomOut[M]]) {
    let s = list.remove(mut a.seats, i)
    if let Some(subject) = subject_of(a, s.peer) {
        if let Some(r) = a.relaying {
            list.push(mut a.revokes, relay_revoke(subject, a.unix_s, r.plan))
        }
    }
    let g: peer.Gen = Gen(id: s.id, epoch: s.epoch)
    drop_pubs(mut a, g, mut out)
    match s.stage {
        Waiting => to_room(a, Fenced(int.widen(s.peer), s.epoch), mut out),
        Building => list.push(mut a.gone, (g, s.home)),
        _ => {
            list.push(mut a.fencing, (g, s.peer))
            list.push(mut a.jobs, Job(change: Revoke(room: a.room, id: s.id, epoch: s.epoch), after: Fence(s.peer, g)))
        },
    }
}

// RTC-4's refused re-offer: the session closes and the participant renegotiates by
// rejoining. Its admission at the old epoch is revoked as `end_seat` revokes it, and
// the seat waits at the next epoch for the peer's fresh offer.
fn rejoin_seat[M](mut a: Adapter[M], i: u64, mut out: List[runner.room_client.RoomOut[M]]) {
    let number = a.seats[i].peer
    let id = a.seats[i].id
    let epoch = a.seats[i].epoch
    let g: peer.Gen = Gen(id: id, epoch: epoch)
    drop_pubs(mut a, g, mut out)
    list.push(mut a.fencing, (g, number))
    list.push(mut a.jobs, Job(change: Revoke(room: a.room, id: id, epoch: epoch), after: Fence(number, g)))
    a.epoch += 1
    a.seats[i].epoch = a.epoch
    a.seats[i].stage = Waiting
    a.seats[i].offered = None
    list.clear(mut a.seats[i].sends)
    list.clear(mut a.seats[i].subs)
}

fn leave_peer[M](mut a: Adapter[M], peer: u32, mut out: List[runner.room_client.RoomOut[M]]) {
    if let Some(i) = seat_at(a, peer) {
        end_seat(mut a, i, mut out)
    }
}

// ---- Signals from a peer ----
fn pub_at[M](a: Adapter[M], id: u64) -> Option[u64] {
    for i in 0u64 .. list.len(a.pubs) {
        if a.pubs[i].id == id {
            return Some(i)
        }
    }
    None
}

fn signal[M](mut a: Adapter[M], p: u32, take s: Signal, mut out: List[runner.room_client.RoomOut[M]]) {
    let Some(i) = seat_at(a, p) else {
        to_peer(a, p, Refused(code(NoParticipant)), mut out)
        return
    }
    let g: peer.Gen = Gen(id: a.seats[i].id, epoch: a.seats[i].epoch)
    match take s {
        Offer(version, take sdp_text) => {
            if a.seats[i].stage != Waiting {
                to_peer(a, p, Refused(code(Exists)), mut out)
                return
            }
            if list.len(sdp_text) > OFFER_MAX {
                to_peer(a, p, Refused(REFUSED_OFFER_TOO_LARGE), mut out)
                return
            }
            // The pool homes the session when it takes the build (`home_builds`).
            let home = 0u16
            a.seats[i].stage = Building
            a.seats[i].home = home
            a.seats[i].version = version
            let publish = (a.embed.publish)(p)
            let (ufrag, pwd) = match a.seats[i].ice {
                Some((u, w)) => (copied(u), copied(w)),
                None => (list.new(), list.new()),
            }
            list.push(mut a.builds, Build(who: peer.Participant(gen: g, room: a.room), home: home, peer: p, version: version, offer: take sdp_text, publish: publish, ice_ufrag: take ufrag, ice_pwd: take pwd))
        },
        // ICE-Lite (RTC-3): the server learns the browser's path from its checks, so a
        // remote candidate changes nothing.
        Candidate(_) => (),
        EndOfCandidates => (),
        Subscribe(id, target) => {
            if a.seats[i].stage != Live {
                to_peer(a, p, Refused(code(NoParticipant)), mut out)
                return
            }
            let Some(pi) = pub_at(a, id) else {
                to_peer(a, p, Refused(code(NoPublication)), mut out)
                return
            }
            let media = a.pubs[pi].media
            let mut section: Option[u8] = None
            for (k, m) in a.seats[i].sends {
                if m != media || section != None {
                    continue
                }
                let mut taken = false
                for (_, used) in a.seats[i].subs {
                    if used == k {
                        taken = true
                    }
                }
                if !taken {
                    section = Some(k)
                }
            }
            let Some(k) = section else {
                to_peer(a, p, Refused(code(Limit(int.narrow(list.len(a.seats[i].sends))))), mut out)
                return
            }
            list.push(mut a.seats[i].subs, (id, k))
            list.push(mut a.jobs, Job(change: Subscribe(room: a.room, who: g, p: PublicationId(id), section: k, target: target), after: Subscribed(g, id, k)))
        },
        Target(id, target) => {
            list.push(mut a.jobs, Job(change: Retarget(room: a.room, who: g, p: PublicationId(id), target: target), after: Changed(g)))
        },
        // A publication the peer no longer holds, because it was never subscribed or
        // its owner departed, is already unsubscribed.
        Unsubscribe(id) => {
            let mut held = false
            for (x, _) in a.seats[i].subs {
                if x == id {
                    held = true
                }
            }
            if !held {
                return
            }
            list.push(mut a.jobs, Job(change: Unsubscribe(room: a.room, who: g, p: PublicationId(id)), after: Unsubscribed(g, id)))
        },
        // The answer to the server's re-offer goes to the session's home unit, which
        // installs it or, refused, closes the session (`Shut`).
        Answer(version, take sdp_text) if a.seats[i].offered != None => {
            a.seats[i].offered = None
            list.push(mut a.answers, (g, version, take sdp_text))
        },
        // A peer that refuses the re-offer rejoins (RTC-4).
        Refused(_) if a.seats[i].offered != None => rejoin_seat(mut a, i, mut out),
        _ => to_peer(a, p, Refused(REFUSED_NOT_TAKEN), mut out),
    }
}

/// The home unit's outcome for a `Build`: the session is parked there under `who`, or
/// the build failed and nothing is parked.
pub fn built[M](mut a: Adapter[M], who: peer.Participant, take result: Result[Built, router.RouterError], mut out: List[runner.room_client.RoomOut[M]]) {
    if who.room != a.room || a.life != Serving {
        return
    }
    let g = who.gen
    let Gen(id: gid, epoch: gepoch) = g
    let mut was_gone = false
    let mut gone_home = 0u16
    list.retain(mut a.gone, scoped fn(x: (peer.Gen, u16)) -> bool {
        if x.0 == g {
            was_gone = true
            gone_home = x.1
            false
        } else {
            true
        }
    })
    let Some(i) = seat_of(a, g) else {
        // The admission ended while its session was built: admit and revoke it, so
        // nothing stays parked, and send `Fenced` once the fence holds.
        if was_gone {
            if let Ok(_) = result {
                list.push(mut a.jobs, Job(change: Admit(who: who, home: gone_home), after: Discard))
            }
            list.push(mut a.fencing, (g, 0))
            list.push(mut a.jobs, Job(change: Revoke(room: a.room, id: gid, epoch: gepoch), after: Fence(0, g)))
        }
        return
    }
    let p = a.seats[i].peer
    match take result {
        Ok(take b) => {
            let Built(answer: take answer, recvs: take recvs, sends: take sends) = take b
            a.seats[i].sends = take sends
            a.seats[i].stage = Admitting
            let home = a.seats[i].home
            let version = a.seats[i].version
            list.push(mut a.jobs, Job(change: Admit(who: who, home: home), after: Admitted(g, version, take answer, take recvs)))
        },
        Error(e) => {
            a.seats[i].stage = Waiting
            to_peer(a, p, Refused(code(e)), mut out)
        },
    }
}

// ---- The control order, on the control unit ----
/// Drive the control order on the control unit: answer the call in flight once every
/// unit has acknowledged it, send `Fenced` for each revoke that returned, and begin the
/// next call.
pub fn step[M: codec](mut a: Adapter[M], mut l: Ledger, mut u: units.Unit, now: u64, mut out: List[runner.room_client.RoomOut[M]]) -> Result[(), router.RouterError] {
    if busy(a) {
        if let Some(take answer) = units.finished(mut u, a.room) {
            let after = option.unwrap(replace(mut a.calling, None))
            answered(mut a, mut l, take after, take answer, mut out)
        }
    }
    let mut faulted: Option[router.RouterError] = None
    for take e in units.take_room_events(mut u, a.room) {
        match take e {
            Fenced(who) => fenced(mut a, mut l, who.gen, mut out),
            // A unit raised the room's fault: the room is closed (RTC-10 Isolation item 2).
            Fault(room: _, error: take x) => {
                faulted = Some(take x)
            },
            // A published mask goes to the publication's owner only (Unicast). While the
            // room is lost the roster is not proven, so neither Layers nor Speakers goes out.
            Layers(room: _, publication: PublicationId(id), mask: mask) => {
                if lost(a) {
                    continue
                }
                if let Some(i) = pub_at(a, id) {
                    let p = a.pubs[i].peer
                    to_peer(a, p, Layers(id, mask), mut out)
                }
            },
            // The router names each speaker by its local id; the room hears peer numbers.
            Speakers(room: _, top: top, count: count) => {
                if lost(a) {
                    continue
                }
                let mut peers: List[u64] = list.new()
                for k in 0u64 .. int.widen(count) {
                    for s in a.seats {
                        if s.id == top[k] {
                            list.push(mut peers, int.widen(s.peer))
                        }
                    }
                }
                let n: u8 = int.narrow(list.len(peers))
                to_room(a, Speakers(peers, n), mut out)
            },
            // A re-offer after a collision goes to its peer. While the room is lost it
            // cannot, so the session is treated as refused and rejoins.
            Offer(who: who, version: version, text: take text) => {
                let Some(i) = seat_of(a, who.gen) else {
                    continue
                }
                if lost(a) {
                    rejoin_seat(mut a, i, mut out)
                    continue
                }
                a.seats[i].offered = Some(version)
                let p = a.seats[i].peer
                to_peer(a, p, Offer(version, take text), mut out)
            },
            Shut(who: who) => {
                if let Some(i) = seat_of(a, who.gen) {
                    rejoin_seat(mut a, i, mut out)
                }
            },
        }
    }
    if let Some(take x) = faulted {
        return Error(take x)
    }
    // An answer whose participant is fenced or gone goes nowhere.
    for take (g, version, take text) in replace(mut a.answers, list.new()) {
        let _ = units.answer_reoffer(mut u, a.room, g, version, take text)
    }
    while !busy(a) && list.len(a.jobs) != 0 {
        let Job(change: c, after: after) = list.remove(mut a.jobs, 0)
        if !remote_reserved(mut a, mut l, c, mut out) {
            continue
        }
        units.begin(mut u, now, c)?
        a.calling = Some(after)
    }
    Ok(())
}

// A subscription whose subscriber is homed on another unit than the publication's
// owner adds a remote down-track there, reserved before the change is posted. One the
// ledger has no room for is refused to the peer and never posted.
fn remote_reserved[M](mut a: Adapter[M], mut l: Ledger, c: router.Change, mut out: List[runner.room_client.RoomOut[M]]) -> bool {
    let Subscribe(room: _, who: g, p: PublicationId(id), section: _, target: _) = c else {
        return true
    }
    let Some(si) = seat_of(a, g) else {
        return true
    }
    let Some(pi) = pub_at(a, id) else {
        return true
    }
    let owner = a.pubs[pi].owner
    let Some(oi) = seat_of(a, owner) else {
        return true
    }
    let home = a.seats[si].home
    if home == a.seats[oi].home {
        return true
    }
    let Error(e) = reserve_remote(mut l, a.room, home, g, owner, id) else {
        return true
    }
    list.retain(mut a.seats[si].subs, scoped fn(x: (u64, u8)) -> bool {
        x.0 != id
    })
    let p = a.seats[si].peer
    to_peer(a, p, Refused(code(Capacity(e))), mut out)
    false
}

fn fenced[M](mut a: Adapter[M], mut l: Ledger, g: peer.Gen, mut out: List[runner.room_client.RoomOut[M]]) {
    release_session(mut l, a.room, g)
    for i in 0u64 .. list.len(a.fencing) {
        let (x, p) = a.fencing[i]
        if x == g {
            let _ = list.remove(mut a.fencing, i)
            let Gen(id: _, epoch: epoch) = g
            if p != 0 {
                to_room(a, Fenced(int.widen(p), epoch), mut out)
            }
            return
        }
    }
}

fn answered[M](mut a: Adapter[M], mut l: Ledger, take after: After, take answer: Result[router.Answer, router.RouterError], mut out: List[runner.room_client.RoomOut[M]]) {
    match take after {
        Quiet => (),
        Discard => (),
        Ended => {
            a.life = Gone
        },
        // A room the units refused to open is gone on every unit.
        Opening => match answer {
            Ok(_) => {
                a.opening = Some(Ok(()))
            },
            Error(e) => {
                a.opening = Some(Error(e))
                a.life = Gone
                a.refused = true
            },
        },
        // A revoke the router refused had nothing to fence (no admission reserved the
        // id): the fence holds already.
        Fence(_, g) => {
            if let Error(_) = answer {
                fenced(mut a, mut l, g, mut out)
            }
        },
        Admitted(g, version, sdp_text, recvs) => {
            let Some(i) = seat_of(a, g) else {
                return
            }
            let p = a.seats[i].peer
            match answer {
                Ok(_) => {
                    a.seats[i].stage = Live
                    to_peer(a, p, Answer(version, sdp_text), mut out)
                    if (a.embed.publish)(p) {
                        for k in recvs {
                            list.push(mut a.jobs, Job(change: Publish(room: a.room, who: g, section: k, id: PublicationId(0), shape: None), after: Announced(g, k)))
                        }
                    }
                },
                Error(e) => {
                    // A refused admission's session was unparked on its home unit.
                    release_session(mut l, a.room, g)
                    a.seats[i].stage = Waiting
                    to_peer(a, p, Refused(code(e)), mut out)
                },
            }
        },
        Announced(g, _) => {
            let Some(i) = seat_of(a, g) else {
                return
            }
            let p = a.seats[i].peer
            match answer {
                Ok(Shaped(id: PublicationId(id), shape: shape)) => {
                    let media: sdp.Media = if shape.codec == Opus {
                        Audio
                    } else {
                        Video
                    }
                    list.push(mut a.pubs, Pub(id: id, owner: g, peer: p, media: media, encodings: shape.encodings))
                    to_room(a, Published(int.widen(p), id, kind_of(media), shape.encodings), mut out)
                },
                Ok(Done) => (),
                Error(e) => to_peer(a, p, Refused(code(e)), mut out),
            }
        },
        Subscribed(g, id, _) => {
            if let Error(e) = answer {
                release_remote(mut l, a.room, g, id)
                if let Some(i) = seat_of(a, g) {
                    list.retain(mut a.seats[i].subs, scoped fn(x: (u64, u8)) -> bool {
                        x.0 != id
                    })
                    let p = a.seats[i].peer
                    to_peer(a, p, Refused(code(e)), mut out)
                }
            }
        },
        Unsubscribed(g, id) => match answer {
            Ok(_) => {
                release_remote(mut l, a.room, g, id)
                if let Some(i) = seat_of(a, g) {
                    list.retain(mut a.seats[i].subs, scoped fn(x: (u64, u8)) -> bool {
                        x.0 != id
                    })
                }
            },
            Error(e) => {
                if let Some(i) = seat_of(a, g) {
                    let p = a.seats[i].peer
                    to_peer(a, p, Refused(code(e)), mut out)
                }
            },
        },
        Changed(g) => {
            if let Error(e) = answer {
                if let Some(i) = seat_of(a, g) {
                    let p = a.seats[i].peer
                    to_peer(a, p, Refused(code(e)), mut out)
                }
            }
        },
    }
}

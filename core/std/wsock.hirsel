// Socket driver for websocket. Ingress policy is independent of Net authority.
pub type Prefix: shareable + send {
    ip: Ip,
    bits: u8
}

fn normalize(ip: Ip) -> Ip {
    match ip {
        V6(0, lo) => if lo >> 32 == 65535 {
            V4(int.truncate(lo))
        } else {
            ip
        },
        _ => ip
    }
}

pub fn parse_ip(s: String) -> Option[Ip] {
    literal(string.as_bytes(s))
}

pub fn parse_prefix(s: String) -> Option[Prefix] {
    let Some((address, length)) = string.split_once(s, "/") else {
        return None
    }
    let Ok(bits) = (int.parse(length) : Result[u8, ParseError]) else {
        return None
    }
    let Some(ip) = parse_ip(address) else {
        return None
    }
    let maximum: u8 = match ip {
        V4(_) => 32,
        V6(_, _) => 128
    }
    if bits > maximum {
        return None
    }
    Some(Prefix(ip, bits))
}

fn contains(prefix: Prefix, ip: Ip) -> bool {
    match (prefix.ip, ip) {
        (V4(a), V4(b)) => prefix.bits <= 32 && (prefix.bits == 0 || a >> int.widen(32 - prefix.bits) == b >> int.widen(32 - prefix.bits)),
        (V6(ah, al), V6(bh, bl)) => prefix.bits <= 128 && if prefix.bits == 0 {
            true
        } else if prefix.bits <= 64 {
            ah >> int.widen(64 - prefix.bits) == bh >> int.widen(64 - prefix.bits)
        } else {
            ah == bh && al >> int.widen(128 - prefix.bits) == bl >> int.widen(128 - prefix.bits)
        },
        _ => false
    }
}

// RFC 5952 canonical spelling. RFC 4291 mapped addresses normalize to V4.
fn literal(b: Bytes) -> Option[Ip] {
    let n = list.len(b)
    if n > 256 {
        return None
    }
    let (hi, lo) = match net.parse_ip(b) {
        Ok(V4(addr)) => return Some(V4(addr)),
        Ok(V6(hi, lo)) => (hi, lo),
        Error(_) => return None,
    }
    let mut explicit: u64 = 0
    let mut gap: Option[u64] = None
    let mut dotted = false
    for i in 0u64 .. n {
        let c = b[i]
        if c >= b'A' && c <= b'F' {
            return None
        }
        if c == b'0' && (i == 0 || b[i - 1] == b':') && i + 1 < n && b[i + 1] != b':' && b[i + 1] != b'.' {
            return None
        }
        if c == b':' {
            if i != 0 && b[i - 1] != b':' {
                explicit += 1
            }
            if i + 1 < n && b[i + 1] == b':' {
                gap = Some(explicit)
            }
        } else if c == b'.' {
            dotted = true
        }
    }
    if dotted && !(hi == 0 && lo >> 32 == 65535) {
        return None
    }
    if b[n - 1] != b':' {
        explicit += 1
    }
    if dotted {
        explicit += 1
    }
    let mut words: Inline[u16, 8] =[0; 8]
    for i in 0u64 .. 4u64 {
        let shift = (3 - i) * 16
        words[i] = int.truncate(hi >> shift)
        words[i + 4] = int.truncate(lo >> shift)
    }
    // Compress the longest zero run, taking the first on ties and requiring
    // at least two groups. The numeric parser already checked the placement.
    let mut best: u64 = 8
    let mut length: u64 = 1
    let mut i: u64 = 0
    while i < 8 {
        let start = i
        while i < 8 && words[i] == 0 {
            i += 1
        }
        if i - start > length {
            best = start
            length = i - start
        }
        if i == start {
            i += 1
        }
    }
    if best == 8 {
        if gap != None {
            return None
        }
    } else if gap != Some(best) || 8 - explicit != length {
        return None
    }
    Some(normalize(V6(hi, lo)))
}

fn trusted(peer: Ip, ingress: List[Prefix]) -> bool {
    for p in ingress {
        if contains(p, peer) || contains(p, normalize(peer)) {
            return true
        }
    }
    false
}

fn forwarded_source(b: Bytes, h: http1.Head) -> Result[Ip, u16] {
    let mut value: Option[http1.Span] = None
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        if http1.equal_ascii(list.slice(b, f.name.start, f.name.end), string.as_bytes("x-forwarded-for")) {
            if value != None {
                return Error(400)
            }
            value = Some(f.value)
        }
    }
    let span = match value {
        Some(s) => s,
        None => return Error(400)
    }
    match literal(list.slice(b, span.start, span.end)) {
        Some(ip) => Ok(ip),
        None => Error(400)
    }
}

/// Source key from a head the caller has already parsed. Error is HTTP 400.
pub fn source_for_head(b: Bytes, h: http1.Head, peer: Ip, ingress: List[Prefix]) -> Result[Ip, u16] {
    if trusted(peer, ingress) {
        forwarded_source(b, h)
    } else {
        Ok(normalize(peer))
    }
}

/// Source key for a complete HTTP request. Trusted ingress must supply one
/// canonical XFF literal; other peers' XFF is ignored. Error is HTTP 400.
/// O(head + ingress prefixes), no allocation. Ex: `wsock.source(b, peer, ingress)`.
pub fn source(b: Bytes, peer: Ip, ingress: List[Prefix]) -> Result[Ip, u16] {
    if !trusted(peer, ingress) {
        return Ok(normalize(peer))
    }
    let mut h = http1.head()
    if http1.request(b, mut h) != Complete {
        return Error(400)
    }
    forwarded_source(b, h)
}

pub type Config: send {
    max_frame: u64,
    upgrade_ms: u64,
    hello_ms: u64,
    pending_max: u64,
    close_ms: u64,
    idle_ms: u64
}

/// WIRE 2.3 defaults. Limits are validated before any connection allocation.
pub fn defaults() -> Config {
    Config(max_frame: 262144, upgrade_ms: 5000, hello_ms: 10000, pending_max: 1024, close_ms: 5000, idle_ms: 30000)
}

pub type Error: send = Allocation(Capacity) | Network(NetError) | Http(u16) | Protocol(u16) | Eof | Configuration | Busy

fn valid(config: Config) -> bool {
    config.max_frame != 0 && config.max_frame & (config.max_frame - 1) == 0 && config.max_frame <= 0xfffffffffffffff1 && config.pending_max != 0 && config.upgrade_ms <= 18446744073709 && config.hello_ms <= 18446744073709 && config.close_ms <= 18446744073709 && config.idle_ms != 0 && config.idle_ms <= 18446744073709
}

fn after(now: u64, ms: u64) -> u64 {
    now + ms * 1000000
}

pub opaque type PendingPool {
    free: Receiver[()],
    returned: Sender[()]
}

pub opaque resource type Pending: send {
    returned: Sender[()]
} drop(slot) {
    let _ = channel.try_send(slot.returned, ())
}

/// Bounded pending allowance. Tokens return on every exit, including cancellation
/// and deadline, through Pending's finalizer. O(pending_max) initial channel storage.
pub fn pending(config: Config) -> Result[PendingPool, Error] {
    if !valid(config) {
        return Error(Configuration)
    }
    let (tx, rx): (Sender[()], Receiver[()]) = channel.new(config.pending_max)
    for i in 0u64 .. config.pending_max {
        let _ = channel.try_send(tx, ())
    }
    Ok(PendingPool(free: take rx, returned: take tx))
}

/// None means HTTP 503 before creating session state. Allocation refusal also
/// returns the token. A successful Hello consumes the returned Pending lease.
pub fn acquire(pool: PendingPool) -> Result[Option[Pending], Error] {
    match channel.try_receive(pool.free) {
        Ok(_) => {},
        Error(_) => return Ok(None)
    }
    match Pending(returned: channel.sender(pool.returned)) {
        Ok(take slot) => Ok(Some(take slot)),
        Error((c, take tx)) => {
            let _ = channel.try_send(tx, ())
            Error(Allocation(c))
        }
    }
}

/// Releases the pending slot after the application has decoded and accepted Hello.
pub fn hello_accepted(take slot: Pending) {}

pub opaque type Timers: send {
    config: Config,
    hello: Option[u64],
    idle: u64,
    probing: bool,
    close: Option[u64],
    peer_closed: bool,
    close_sent: bool
}

pub type Due: key + send = Wait | SendPing | SendClose | Expired

/// Absolute Hello and idle deadlines begin at completion of the 101 response.
pub fn timers(config: Config, now: u64) -> Timers {
    Timers(config, hello: Some(after(now, config.hello_ms)), idle: after(now, config.idle_ms), probing: false, close: None, peer_closed: false, close_sent: false)
}

/// Called only after Hello is accepted; unrelated frames never extend Hello.
pub fn welcomed(mut t: Timers) {
    t.hello = None
}

/// Every received frame, including Pong, restarts idle observation.
pub fn activity(mut t: Timers, now: u64) {
    t.idle = after(now, t.config.idle_ms)
    t.probing = false
}

/// Starts one absolute deadline for either direction. Repeated close events
/// never extend it. The owner passes this same state to both child operations.
pub fn closing(mut t: Timers, now: u64, peer: bool) {
    if t.close == None {
        t.close = Some(after(now, t.config.close_ms))
    }
    t.peer_closed = t.peer_closed || peer
}

/// Marks the Close flushed by the sole writer, independently of peer receipt.
pub fn close_sent(mut t: Timers) {
    t.close_sent = true
}

/// A complete handshake may release immediately; otherwise expiry cancels and
/// joins both children. Pure time decision, also exercised under virtual time.
pub fn due(mut t: Timers, now: u64) -> Due {
    if let Some(end) = t.close {
        if now >= end || t.peer_closed && t.close_sent {
            return Expired
        }
        return Wait
    }
    if let Some(end) = t.hello {
        if now >= end {
            closing(mut t, now, false)
            return SendClose
        }
    }
    if now >= t.idle {
        if t.probing {
            closing(mut t, now, false)
            return SendClose
        }
        t.probing = true
        t.idle = after(now, t.config.idle_ms)
        return SendPing
    }
    Wait
}

/// Minimum of the caller's operation deadline and every applicable protocol
/// deadline. Try-first host I/O may still commit immediately at this instant.
pub fn until(t: Timers, c: Clock, outer: Until) -> Until {
    let mut end = match t.close {
        Some(deadline) => deadline,
        None => {
            let mut deadline = t.idle
            if let Some(hello) = t.hello {
                if hello < deadline {
                    deadline = hello
                }
            }
            deadline
        }
    }
    match outer {
        At(_, deadline) => if deadline < end {
            end = deadline
        },
        Never => {}
    }
    At(c, end)
}

fn expired(deadline: Until) -> bool {
    match deadline {
        At(c, end) => host.mono_ns(c) >= end,
        Never => false
    }
}

pub opaque type Reader: send {
    half: ReadHalf,
    input: Bytes,
    cursor: u64,
    decoder: websocket.Decoder,
    clock: Clock,
    message_end: Option[u64]
}

pub opaque type Writer: send {
    half: WriteHalf,
    buffer: WriteBuffer
}

pub opaque type WriteBuffer: send {
    pending: Bytes,
    cursor: u64,
    pong: Option[Box[websocket.Control]]
}

pub opaque type Outbound: send {
    encoder: websocket.Encoder,
    role: websocket.Role,
    max: u64,
    random: Option[Random]
}

/// Owner-side encoder. Client role needs a granted Random, consumed fresh on
/// every frame, including control frames. Encoded buffers stay owner-funded.
pub fn outbound(role: websocket.Role, config: Config, random: Option[Random]) -> Result[Outbound, Error] {
    if !valid(config) {
        return Error(Configuration)
    }
    if role == Client {
        match random {
            None => return Error(Configuration),
            Some(_) => {}
        }
    }
    Ok(Outbound(encoder: websocket.encoder(role, config.max_frame), role, max: config.max_frame, random))
}

/// Encodes exactly one frame into capacity payload+14, avoiding geometric
/// growth beyond WIRE's round8(max_frame+14) writer-buffer bound.
pub fn encode(mut out: Outbound, fin: bool, opcode: u8, payload: Bytes) -> Result[Bytes, Error] {
    if list.len(payload) > out.max {
        return Error(Protocol(1009))
    }
    let mut mask: Inline[u8, 4] =[0; 4]
    if let Some(random) = out.random {
        if out.role == Client {
            let mut entropy = buffer(4)?
            host.random(random, mut entropy)
            for i in 0u64 .. 4u64 {
                mask[i] = entropy[i]
            }
        }
    }
    let mut b = buffer(list.len(payload) + 14)?
    websocket.encode(mut out.encoder, fin, opcode, payload, mask, mut b) ?=> Protocol
    Ok(take b)
}

/// Encodes x as one whole binary frame, writing its codec bytes straight
/// behind the header so the payload is built once. n is x's exact encoded
/// length. A length mismatch returns Protocol(1011). Server role only.
/// Reserves n+14 bytes. Refusal of that reservation returns Allocation.
/// Ex: `wsock.try_encode_with(out, codec, frame, size)?`.
pub fn try_encode_with[T](out: Outbound, coding: codec.Codec[T], x: T, n: u64) -> Result[Bytes, Error] {
    try_encode_parts(out, n, scoped fn(mut bytes_out: Bytes) -> Result[(), u16] {
        codec.encode(coding, x, mut bytes_out) ?=> |_| 1011u16
        Ok(())
    })
}

/// Writes a binary payload after the header. n is its exact encoded length.
pub fn try_encode_parts(out: Outbound, n: u64, append: scoped fn(mut Bytes) -> Result[(), u16]) -> Result[Bytes, Error] {
    if n > out.max {
        return Error(Protocol(1009))
    }
    if out.role == Client {
        return Error(Configuration)
    }
    let mut b: Bytes = list.new()
    list.try_reserve(mut b, n + 14) ?=> Allocation
    websocket.binary_head(out.encoder, n, mut b) ?=> Protocol
    let start = list.len(b)
    append(mut b) ?=> Protocol
    if list.len(b) - start != n {
        return Error(Protocol(1011))
    }
    Ok(take b)
}

/// One pending frame, moved from its allocating owner. A busy writer returns
/// the offered buffer unchanged; controls wait behind a part-written frame.
pub fn offer(mut w: WriteBuffer, take frame: Bytes) -> Result[(), Bytes] {
    if !idle(w) {
        return Error(take frame)
    }
    let old = replace(mut w.pending, take frame)
    w.cursor = 0
    Ok(())
}

/// One send attempt with an operation-local composite deadline. Prefix sends
/// advance the retained cursor. TimedOut preserves it for the owner's timer
/// transition; terminal release drops the buffer and the socket half together.
pub fn flush(mut w: Writer, mut out: Outbound, deadline: Until) -> Result[bool, Error] waits {
    if prepare(mut w.buffer, mut out)? {
        return Ok(true)
    }
    let sent = host.send_pair(mut w.half, remaining(w.buffer), string.as_bytes(""), deadline)
    match sent {
        Ok(n) => {
            wrote(mut w.buffer, n)
        },
        Error(e) => return Error(Network(e))
    }
    Ok(idle(w.buffer))
}

/// Empty one-frame buffer and inline control debt, independent of its socket.
pub fn write_buffer() -> WriteBuffer {
    WriteBuffer(pending: list.new(), cursor: 0, pong: None)
}

/// Queue a frame for the sole socket writer; busy returns it unchanged.
pub fn stage(mut w: Writer, take frame: Bytes) -> Result[(), Bytes] {
    offer(mut w.buffer, take frame)
}

/// Record control debt at the writer while preserving the part-written frame.
pub fn pong(mut w: Writer, control: websocket.Control) {
    owe_pong(mut w.buffer, control)
}

/// Current unsent prefix, borrowed until host.send_pair completes.
pub fn remaining(b: WriteBuffer) -> View[Bytes] in b {
    list.slice(b.pending, b.cursor, list.len(b.pending))
}

/// Commit the prefix count returned by host.send_pair, without copying the frame.
pub fn wrote(mut b: WriteBuffer, count: u64) {
    b.cursor += count
    if b.cursor == list.len(b.pending) {
        {
            let old = replace(mut b.pending, list.new())
        }
        b.cursor = 0
    }
}

/// Whether both the pending frame and control debt have drained.
pub fn idle(b: WriteBuffer) -> bool {
    b.cursor == list.len(b.pending) && match b.pong {
        None => true,
        Some(_) => false
    }
}

/// Retire a completed frame, then encode the owed Pong. Never interrupt a
/// partial frame. True means there is no output remaining.
pub fn prepare(mut w: WriteBuffer, mut out: Outbound) -> Result[bool, Error] {
    if w.cursor != list.len(w.pending) {
        return Ok(false)
    }
    {
        let old = replace(mut w.pending, list.new())
    }
    w.cursor = 0
    match replace(mut w.pong, None) {
        Some(control) => {
            let mut payload = buffer(control.len)?
            websocket.control(control, mut payload)
            w.pending = encode(mut out, true, 10, payload)?
            Ok(false)
        },
        None => Ok(true)
    }
}

/// Records a Pong even while a data frame is part-written. As RFC 6455 5.5.2
/// permits, repeated pending Pings coalesce to the most recently received one.
pub fn owe_pong(mut w: WriteBuffer, control: websocket.Control) {
    w.pong = Some(box.new(control))
}

pub const MESSAGE_NS: u64 = 30000000000

fn message_expired(r: Reader, now: u64) -> bool {
    match r.message_end {
        Some(end) => now >= end,
        None => false
    }
}

/// Decodes bytes already received into scratch. None means the caller must
/// refill the scratch before polling again. This step never waits on I/O.
pub fn decode_buffered(mut r: Reader) -> Result[Option[websocket.Event], Error] {
    let now = host.mono_ns(r.clock)
    if message_expired(r, now) {
        return Error(Protocol(1001u16))
    }
    let before = websocket.frame_count(r.decoder)
    let event = websocket.next(mut r.decoder, r.input, mut r.cursor)
    if websocket.incomplete(r.decoder) {
        if let None = r.message_end {
            r.message_end = Some(int.saturating_add(now, MESSAGE_NS))
        }
    } else {
        r.message_end = None
    }
    match take event {
        Need => if websocket.frame_count(r.decoder) != before {
            Ok(Some(Need))
        } else {
            Ok(None)
        },
        take other => Ok(Some(take other))
    }
}

/// Bytes lent per receive. A reader holds a loan only between readiness and
/// the point where its decoded bytes are used up or settled.
pub const RECEIVE_LOAN_BYTES: u64 = 8192

/// The unread bytes of input from at, in storage of exactly their length.
fn unread(input: Bytes, at: u64) -> Result[Bytes, Error] {
    let mut kept: Bytes = list.new()
    if at < list.len(input) {
        if let Error(c) = list.try_reserve(mut kept, list.len(input) - at) {
            return Error(Allocation(c))
        }
        list.append(mut kept, list.slice(input, at, list.len(input)))
    }
    Ok(take kept)
}

/// Trades a receive loan holding read-ahead for connection-owned storage of
/// only the unread tail, so a reader parked by its owner holds no loan. With
/// nothing unread it releases the input. Call it before a wait the owner
/// controls; refill returns the loan itself before waiting for readiness.
pub fn settle(mut r: Reader) -> Result[(), Error] {
    if list.capacity(r.input) == list.len(r.input) - r.cursor {
        return Ok(())
    }
    let kept = unread(r.input, r.cursor)?
    r.input = take kept
    r.cursor = 0
    Ok(())
}

/// Called after decode_buffered returns None, which leaves no unread input.
/// Returns the reader's input before waiting for readiness with no buffer,
/// then checks out an 8192-byte loan for one bounded receive. A receive that
/// times out before the deadline is stale readiness: its loan returns and the
/// reader waits again.
pub fn refill(mut r: Reader, deadline: Until) -> Result[(), Error] waits {
    let read_until = match r.message_end {
        Some(end) => match deadline {
            At(_, earlier) => if earlier < end {
                deadline
            } else {
                At(r.clock, end)
            },
            Never => At(r.clock, end)
        },
        None => deadline
    }
    loop {
        r.input = list.new()
        r.cursor = 0
        let ready = match host.recv_ready(mut r.half, read_until) {
            Ok(()) => true,
            Error(TimedOut) => false,
            Error(e) => return Error(Network(e))
        }
        if ready {
            // The loan is the reader's own input, released by assignment, so
            // nothing here is promoted to frame storage and the reader's task
            // gives its stack back while it waits (ir returnable.rs).
            if let Error(c) = list.try_reserve(mut r.input, RECEIVE_LOAN_BYTES) {
                return Error(Allocation(c))
            }
            match host.recv_bounded(mut r.half, mut r.input, RECEIVE_LOAN_BYTES, read_until) {
                Ok(0) => return Error(Eof),
                Ok(_) => return Ok(()),
                Error(TimedOut) => if !expired(read_until) {
                    continue
                },
                Error(e) => return Error(Network(e))
            }
        }
        r.input = list.new()
        return if message_expired(r, host.mono_ns(r.clock)) {
            Error(Protocol(1001u16))
        } else {
            Error(Network(TimedOut))
        }
    }
}

/// Reads one protocol event, lending 8192-byte scratch only after readiness. An incomplete
/// message has one absolute deadline across reads and intervening controls.
pub fn read(mut r: Reader, deadline: Until) -> Result[websocket.Event, Error] waits {
    loop {
        if let Some(take event) = decode_buffered(mut r)? {
            return Ok(take event)
        }
        refill(mut r, deadline)?
        if expired(deadline) {
            if message_expired(r, host.mono_ns(r.clock)) {
                return Error(Protocol(1001u16))
            }
            return Error(Network(TimedOut))
        }
    }
}

/// Releases decoder storage before returning the read half for TCP drain.
pub fn finish_read(mut r: Reader) {
    websocket.discard(mut r.decoder)
    let old = replace(mut r.input, list.new())
}

pub type Upgraded: send {
    protocol: websocket.Protocol,
    read_ahead: u64,
    reader: Reader,
    writer: Writer,
    source: Ip,
    timers: Timers,
    pending: Pending
}

fn buffer(n: u64) -> Result[Bytes, Error] {
    let allocation: Bytes = list.with_capacity(n)
    Ok(take allocation)
}

/// Bounded HTTP refusal. It is sent before releasing the socket halves.
pub fn refuse(mut w: WriteHalf, code: u16, deadline: Until) -> Result[(), Error] waits {
    let b = if code == 503 {
        string.as_bytes("HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
    } else if code == 431 {
        string.as_bytes("HTTP/1.1 431 Request Header Fields Too Large\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
    } else if code == 426 {
        string.as_bytes("HTTP/1.1 426 Upgrade Required\r\nSec-WebSocket-Version: 13\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
    } else if code == 404 {
        string.as_bytes("HTTP/1.1 404 Not Found\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
    } else if code == 500 {
        string.as_bytes("HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
    } else {
        string.as_bytes("HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
    }
    wsock_site.send_response(mut w, b, string.as_bytes(""), deadline)
}

/// Refuses an accepted socket without exposing its halves to a transport caller.
pub fn refuse_socket(take socket: Socket, code: u16, deadline: Until) -> Result[(), Error] waits {
    let (input, write) = net.split(take socket)
    let mut output = take write
    refuse(mut output, code, deadline)
}

/// Accept-to-head absolute deadline, sanitized ingress and preserved read-ahead.
/// The lease is consumed on every error path and returned with success until
/// Hello acceptance. The accept loop acquires it before spawning session state.
pub fn server(take socket: Socket, take slot: Pending, peer: Ip, ingress: List[Prefix], config: Config, clock: Clock, accepted_ns: u64) -> Result[Upgraded, Error] waits {
    server_with(take socket, take slot, peer, ingress, config, clock, accepted_ns, scoped fn(ip: Ip) -> bool {
        true
    })
}

/// Runs the source admission policy after sanitization and before writing 101.
pub fn server_with(take socket: Socket, take slot: Pending, peer: Ip, ingress: List[Prefix], config: Config, clock: Clock, accepted_ns: u64, admit: scoped fn(Ip) -> bool waits) -> Result[Upgraded, Error] waits {
    let request = receive_request(take socket, config, clock, accepted_ns)?
    upgrade_request(take request, take slot, peer, ingress, config, clock, admit)
}

pub type Asset {
    name: String,
    content_type: String
}

/// The route selects a filename from a fixed list. The request supplies no path
/// to the filesystem.
pub type Site: send {
    dir: Dir,
    find: fn(Bytes) -> Option[Asset]
}

type Request {
    reader: ReadHalf,
    writer: WriteHalf,
    input: Bytes,
    head: http1.Head,
    path_end: u64,
    deadline: Until,
}

fn route_end(input: Bytes, target: http1.Span) -> u64 {
    for i in target.start .. target.end {
        if input[i] == b'?' || input[i] == b'#' {
            return i
        }
    }
    target.end
}

fn receive_request(take socket: Socket, config: Config, clock: Clock, accepted_ns: u64) -> Result[Request, Error] waits {
    if !valid(config) {
        return Error(Configuration)
    }
    let (r, w) = net.split(take socket)
    let mut reader = take r
    let mut writer = take w
    let deadline = At(clock, after(accepted_ns, config.upgrade_ms))
    let mut input = buffer(8192)?
    let mut head = http1.head()
    let mut cursor = http1.cursor()
    loop {
        if expired(deadline) {
            return Error(Network(TimedOut))
        }
        let status: u16 = match http1.resume(input, mut head, mut cursor) {
            Complete => {
                let path_end = route_end(input, head.target)
                return Ok(Request(reader: take reader, writer: take writer, input: take input, head: take head, path_end, deadline))
            },
            Partial => 0,
            Bad => 400,
            TooLarge => 431,
        }
        if status != 0 {
            let _ = refuse(mut writer, status, deadline)
            return Error(Http(status))
        }
        let max = list.capacity(input)
        match host.recv_bounded(mut reader, mut input, max, deadline) {
            Ok(0) => return Error(Eof),
            Ok(_) => {},
            Error(e) => return Error(Network(e)),
        }
    }
}

/// Serve one request. The raw GET and HEAD handler runs before the upgrade's source policy.
/// Raw and static responses close the connection.
pub fn server_with_site(take socket: Socket, take slot: Pending, peer: Ip, ingress: List[Prefix], config: Config, clock: Clock, accepted_ns: u64, site: Option[Site], raw: scoped fn(Bytes) -> Result[Option[(bool, String)], Capacity], admit: scoped fn(Ip) -> bool waits) -> Result[Option[Upgraded], Error] waits {
    server_with_site_report(take socket, take slot, peer, ingress, config, clock, accepted_ns, site, raw, admit, None)
}

/// As server_with_site, with optional stderr authority for static response failures.
pub fn server_with_site_report(take socket: Socket, take slot: Pending, peer: Ip, ingress: List[Prefix], config: Config, clock: Clock, accepted_ns: u64, site: Option[Site], raw: scoped fn(Bytes) -> Result[Option[(bool, String)], Capacity], admit: scoped fn(Ip) -> bool waits, report: Option[Stderr]) -> Result[Option[Upgraded], Error] waits {
    let request = receive_request(take socket, config, clock, accepted_ns)?
    let (head_only, fetch) = {
        let method = list.slice(request.input, request.head.method.start, request.head.method.end)
        let head_only = method == string.as_bytes("HEAD")
        (head_only, head_only || method == string.as_bytes("GET"))
    }
    if fetch {
        let response = match raw(list.slice(request.input, request.head.target.start, request.head.target.end)) {
            Ok(take value) => take value,
            Error(c) => return Error(Allocation(c)),
        }
        if let Some((ready, take body)) = take response {
            let header = wsock_site.static_head(ready, "application/json", list.len(string.as_bytes(body)))
            let Request(writer: take output, deadline, ..) = take request
            let mut writer = take output
            wsock_site.send_response(mut writer, string.as_bytes(header), if head_only {
                string.as_bytes("")
            } else {
                string.as_bytes(body)
            }, deadline)?
            return Ok(None)
        }
    }
    let use_upgrade = match site {
        None => true,
        Some(_) => list.slice(request.input, request.head.target.start, request.path_end) == string.as_bytes("/hirsel"),
    }
    if use_upgrade {
        let upgraded = upgrade_request(take request, take slot, peer, ingress, config, clock, admit)?
        return Ok(Some(take upgraded))
    }
    let Request(writer: take output, input: take input, head: take head, path_end, deadline, ..) = take request
    let mut writer = take output
    wsock_site.serve(mut writer, deadline, option.unwrap(site), list.slice(input, head.target.start, path_end), fetch, head_only, order.min(RECEIVE_LOAN_BYTES, config.max_frame), report)?
    Ok(None)
}

fn upgrade_request(take request: Request, take slot: Pending, peer: Ip, ingress: List[Prefix], config: Config, clock: Clock, admit: scoped fn(Ip) -> bool waits) -> Result[Upgraded, Error] waits {
    let Request(reader: take reader, writer: take output, input: take input, head: take parsed, path_end, deadline) = take request
    let mut writer = take output
    let mut head = take parsed
    head.target.end = path_end
    let upgraded = websocket.server_head(input, head)
    match take upgraded {
        Upgraded(end, selected, take response) => {
            let ip = match source_for_head(input, head, peer, ingress) {
                Ok(ip) => ip,
                Error(code) => {
                    let _ = refuse(mut writer, code, deadline)
                    return Error(Http(code))
                },
            }
            if !admit(ip) {
                let _ = refuse(mut writer, 503, deadline)
                return Error(Http(503))
            }
            wsock_site.send_response(mut writer, response, string.as_bytes(""), deadline)?
            let kept = unread(input, end)?
            Ok(Upgraded(protocol: selected, read_ahead: list.len(kept), reader: Reader(half: take reader, input: take kept, cursor: 0, decoder: websocket.decoder(Server, config.max_frame), clock, message_end: None), writer: Writer(half: take writer, buffer: write_buffer()), source: ip, timers: timers(config, host.mono_ns(clock)), pending: take slot))
        },
        Refused(code) => {
            let _ = refuse(mut writer, code, deadline)
            Error(Http(code))
        },
        Waiting => Error(Configuration),
    }
}

pub type Connected: send {
    reader: Reader,
    writer: Writer,
    outgoing: Outbound,
    timers: Timers
}

/// Client handshake with a host.random challenge and the exact hirsel.3
/// selection. A bounded response's tail becomes the first frame input.
pub fn client(take socket: Socket, host_name: Bytes, config: Config, clock: Clock, random: Random) -> Result[Connected, Error] waits {
    if !valid(config) {
        return Error(Configuration)
    }
    let (r, w) = net.split(take socket)
    let mut input_half = r
    let mut output_half = w
    let deadline = At(clock, after(host.mono_ns(clock), config.upgrade_ms))
    let mut nonce = buffer(16)?
    host.random(random, mut nonce)
    let request = websocket.request(host_name, nonce, true) ?=> Http
    let mut key: Bytes = list.new()
    base64.encode(nonce, mut key)
    wsock_site.send_response(mut output_half, request, string.as_bytes(""), deadline)?
    let mut input = buffer(8192)?
    let mut attempted = false
    loop {
        if attempted && expired(deadline) {
            return Error(Network(TimedOut))
        }
        match websocket.client(input, key, true) {
            Ready(end, true) => {
                let kept = unread(input, end)?
                return Ok(Connected(reader: Reader(half: take input_half, input: take kept, cursor: 0, decoder: websocket.decoder(Client, config.max_frame), clock, message_end: None), writer: Writer(half: take output_half, buffer: write_buffer()), outgoing: outbound(Client, config, Some(random))?, timers: timers(config, host.mono_ns(clock))))
            },
            Ready(_, false) => return Error(Http(400)),
            Failed(code) => return Error(Http(code)),
            Pending => {}
        }
        let max = list.capacity(input)
        match host.recv_bounded(mut input_half, mut input, max, deadline) {
            Ok(0) => return Error(Eof),
            Ok(_) => {},
            Error(e) => return Error(Network(e))
        }
        attempted = true
    }
}

/// Whether the socket writer has no pending frame or Pong debt.
pub fn drained(w: Writer) -> bool {
    idle(w.buffer)
}

fn read_half(take reader: Reader) -> ReadHalf {
    let Reader(half: input, ..) = take reader
    take input
}

fn write_half(take writer: Writer) -> WriteHalf {
    let Writer(half: output, ..) = take writer
    take output
}

/// After Close is flushed and the reader has returned ownership, drain raw TCP
/// under the same absolute close deadline. Reader assembly and scratch are
/// released before net.finish allocates its bounded scratch.
pub fn finish(take writer: Writer, take reader: Reader, clock: Clock, deadline_ns: u64) -> Result[(), Error] waits {
    let input = read_half(take reader)
    let output = write_half(take writer)
    match net.finish(take output, take input, clock, deadline_ns) {
        Ok(_) => Ok(()),
        Error(Network(e)) => Error(Network(e))
    }
}

/// The Hello deadline fixed at completion of the 101 response.
pub fn hello_deadline(t: Timers) -> Option[u64] {
    t.hello
}

pub type Grant: codec + key + send = Denied | Watch | Join

pub type RoomBounds: send {
    peers: u32,
    state: u32,
    message: u32,
}

pub const STATE_MAX: u32 = 8192u32

pub const MESSAGE_MAX: u32 = 32768u32

pub const LIVE_MAX: u32 = 65536u32

const ROOMS_PER_SESSION: u64 = 8u64

pub const ROOM_ARGS_MAX: u64 = 1024u64

type RoomCodecCheck = ValidRoomValue | MalformedRoomValue | RoomDecodeCapacity

type RoomCodecs: send {
    state: own[send] fn(Bytes) -> RoomCodecCheck,
    message: own[send] fn(Bytes) -> RoomCodecCheck,
}

type RoomEntry: send {
    bounds: RoomBounds,
    arg_limit: u64,
    state_schema: Bytes,
    message_schema: Bytes,
    codecs: own[send] fn() -> RoomCodecs,
    hooks: fn() -> RoomHooks,
    index: u32,
}

// Everything a place does for rooms goes through this table. Only `room`
// names `room_hooks`, and code is retained only through the calls and
// function values it makes (PROG-6), so a place that declares no room links
// none of the room plan, relay, owner or grant code. The wire session, the
// publisher and the serving place reach the table through the room values
// they hold (RoomPlan, RoomLink, RoomOwner, RoomGrants, RoomGrantPublisher),
// which exist only once a room was declared.
type RoomHooks {
    fold: fn(mut RoomPlan, RoomEntry),
    close: fn(mut RoomPlan, WireConfig),
    schema: fn(Bytes, List[SlotSchema], RoomEntry) -> Result[Bytes, RegisterError],
    start: fn(RoomPlan, WireConfig, u64, Sender[PubIn], Tasks, Random) -> Result[Option[(RoomLink, Task[()])], StartError] waits,
    open: fn(take RoomLink, RoomSession, Sender[WireEvent]) -> Result[RoomOwner, Capacity],
    join: fn(mut RoomOwner, u32, u64, take RoomRequest, take Caller) -> Result[(), Refusal],
    sync: fn(mut RoomOwner, Option[u32], List[(u32, u64)]),
    set: fn(mut RoomOwner, u32, Option[Bytes]) -> Result[(), u16],
    send: fn(mut RoomOwner, u32, Option[u32], Bytes) -> Result[(), u16],
    drain: fn(mut RoomOwner),
    ring: fn(RoomOwner, RoomBell),
    live: fn(mut RoomOwner) -> Option[Box[RoomLiveBuffer]],
    finish: fn(take RoomOwner) waits,
    reserve: fn(take RoomGrants) -> Result[RoomGrantPublisher, Capacity],
    stage: fn(Subscriptions, mut Joiner, u64),
    revoke: fn(mut Joiner),
}

fn room_hooks() -> RoomHooks {
    RoomHooks(fold: fold_room_plan, close: close_room_plan, schema: encode_room_schema, start: spawn_room_relay, open: room_owner, join: room_owner_join, sync: room_owner_sync, set: room_owner_set_input, send: room_owner_send_input, drain: room_owner_pass, ring: room_owner_ring, live: room_owner_frame, finish: room_owner_finish, reserve: reserve_room_grants, stage: stage_joiner_room_grants, revoke: revoke_joiner_room_grants)
}

pub fn room[G: send, H: shareable + inert + send, A: codec, S: codec, M: codec](mut r: Registry[G, H], admit: StaticFn[fn(store.Tx, H, Caller, take A) -> Result[Answer[Grant], Capacity]], take declarations: Slots[H], state: std.codec.Codec[S], message: std.codec.Codec[M], bounds: RoomBounds, n: u64, arg_limit: u64, steps: u64) -> Result[(), RegisterError] {
    if bounds.peers == 0u32 || bounds.state > STATE_MAX || bounds.message > MESSAGE_MAX || arg_limit > ROOM_ARGS_MAX || room_live_minimum(bounds.state, bounds.message) > int.widen(LIVE_MAX) {
        return Error(RoomBounds)
    }
    let state_schema = std.codec.schema(state) ?=> |_| Bounds
    let message_schema = std.codec.schema(message) ?=> |_| Bounds
    let index: u32 = int.narrow(exported_count(r))
    let make = fn() -> RoomCodecs {
        let check_s = fn(raw: Bytes) -> RoomCodecCheck {
            decode_room_value(state, raw)
        }
        let check_m = fn(raw: Bytes) -> RoomCodecCheck {
            decode_room_value(message, raw)
        }
        RoomCodecs(state: take check_s, message: take check_m)
    }
    let definition = RoomEntry(bounds, arg_limit, state_schema: take state_schema, message_schema: take message_schema, codecs: take make, hooks: room_hooks, index)
    register_query(mut r, As(admit), take declarations, store.copy_env, n, steps, Some(take definition))
}

fn room_live_minimum(state: u32, message: u32) -> u64 {
    let s: u64 = int.widen(state)
    let m: u64 = int.widen(message)
    // Frame prefix, fixed Part, you 4, left 4, joined 9 + 64,
    // state tags and length 12, message peer, flag and length 9.
    ROOM_LIVE_PREFIX + ROOM_PART_FIXED + 102u64 + s + m
}

fn decode_room_value[V: codec](format: std.codec.Codec[V], raw: Bytes) -> RoomCodecCheck {
    let result = bound bytes room_decode_bytes(list.len(raw)) {
        isolate(scoped fn() -> bool {
            match std.codec.decode(format, raw) {
                Ok(_) => true,
                Error(_) => false
            }
        })
    }
    match take result {
        Ok(Ok(Ok(true))) => ValidRoomValue,
        Ok(Ok(Ok(false))) => MalformedRoomValue,
        Ok(Ok(Error(causes))) => {
            let mut capacity = false
            for cause in causes {
                if let Capacity(_) = cause.kind {
                    capacity = true
                }
            }
            if capacity {
                RoomDecodeCapacity
            } else {
                MalformedRoomValue
            }
        },
        Ok(Error(_)) => RoomDecodeCapacity,
        Error(_) => RoomDecodeCapacity,
    }
}

fn encode_room_schema(value: Bytes, declarations: List[SlotSchema], definition: RoomEntry) -> Result[Bytes, RegisterError] {
    let slot_codec: std.codec.Codec[List[SlotSchema]] = std.codec.of()
    let mut encoded_slots: Bytes = list.new()
    std.codec.encode(slot_codec, declarations, mut encoded_slots) ?=> |_| Bounds
    let codec: std.codec.Codec[(Bytes, Bytes, Bytes, Bytes, u32, u32, u32)] = std.codec.of()
    let mut result: Bytes = list.new()
    let fields: (Bytes, Bytes, Bytes, Bytes, u32, u32, u32) = (clone(value), take encoded_slots, clone(definition.state_schema), clone(definition.message_schema), definition.bounds.peers, definition.bounds.state, definition.bounds.message)
    std.codec.encode(codec, fields, mut result) ?=> |_| Bounds
    Ok(take result)
}

type RoomPlan: send {
    owner_bytes: u64,
    relay_bytes: u64,
    live_limit: u64,
    min_frame: u64,
    message: u64,
    roster: u64,
    per_sub: u64,
    decode: u64,
    hooks: Option[fn() -> RoomHooks],
    // The largest n of a transact or fenced entry: the head runs those bodies, and
    // retains n for a call's reserve, within its own bytes (head_own_bytes).
    head_entry: u64,
}

fn no_rooms() -> RoomPlan {
    RoomPlan(owner_bytes: 0u64, relay_bytes: 0u64, live_limit: 0u64, min_frame: 0u64, message: 0u64, roster: 0u64, per_sub: 0u64, decode: 0u64, hooks: None, head_entry: 0u64)
}

// The room sizes a registry's entries fold to; `close_rooms` finishes them for a WireConfig.
fn fold_rooms[G: send, H: shareable + inert + send](r: Registry[G, H]) -> RoomPlan {
    let mut plan = no_rooms()
    for (_, entry) in r.slots {
        match entry {
            Transact(n, _, _, _, _) => {
                plan.head_entry = order.max(plan.head_entry, n)
            },
            Fenced(n, _, _) => {
                plan.head_entry = order.max(plan.head_entry, n)
            },
            _ => (),
        }
        if let Query(_, _, query_entry) = entry {
            if let Some(registered) = query_entry.ephemeral {
                let hooks = (registered.hooks)()
                (hooks.fold)(mut plan, registered)
                plan.hooks = Some(registered.hooks)
            }
        }
    }
    plan
}

fn close_rooms(folded: RoomPlan, c: WireConfig) -> RoomPlan {
    let mut plan = folded
    let hooks = match plan.hooks {
        Some(make) => make(),
        None => return plan
    }
    (hooks.close)(mut plan, c)
    plan
}

fn plan_rooms[G: send, H: shareable + inert + send](r: Registry[G, H], c: WireConfig) -> RoomPlan {
    close_rooms(fold_rooms(r), c)
}

fn fold_room_plan(mut plan: RoomPlan, registered: RoomEntry) {
    let bounds = registered.bounds
    plan.per_sub = order.max(plan.per_sub, room_membership_charge(bounds, registered.arg_limit))
    plan.decode = order.max(plan.decode, int.widen(order.max(bounds.state, bounds.message)))
    plan.message = order.max(plan.message, int.widen(bounds.message))
    plan.min_frame = order.max(plan.min_frame, room_live_minimum(bounds.state, bounds.message))
    plan.roster = order.max(plan.roster, room_roster_bytes(registered.arg_limit, int.widen(bounds.peers)))
}

fn close_room_plan(mut plan: RoomPlan, c: WireConfig) {
    if plan.roster != 0u64 {
        plan.live_limit = order.min(int.widen(LIVE_MAX), c.socket.max_frame)
        plan.owner_bytes = room_session_charge(plan.per_sub, plan.message, plan.decode, plan.live_limit)
        plan.relay_bytes = c.n_relay
    }
}

fn room_relay_charge(limit: u64) -> u64 {
    64u64 + option.unwrap(charge.seq(bytes[RoomRelayIn], ROOM_RELAY_TOKENS * limit))
}

// A decode of an n-byte value runs under 2n + 4 KiB (decode_room_value).
fn room_decode_bytes(len: u64) -> u64 {
    2u64 * len + 4096u64
}

// The owner allocates every block below under the session's limit, and the
// blocks keep that record when they move to the relay (MEM-20).
fn room_session_charge(per_sub: u64, message: u64, decode: u64, frame_limit: u64) -> u64 {
    let live = option.unwrap(charge.boxed(bytes[RoomLiveBuffer])) + option.unwrap(charge.seq(1u64, frame_limit + 10u64)) + option.unwrap(charge.seq(bytes[RoomPartRange], ROOMS_PER_SESSION))
    let desk = option.unwrap(charge.boxed(bytes[RoomDesk])) + 2u64 * live + option.unwrap(charge.seq(1u64, ROOM_RING_BYTES)) + 2u64 * option.unwrap(charge.seq(bytes[Box[RoomLiveBuffer]], 2u64)) + option.unwrap(charge.seq(bytes[Option[Box[RoomSeat]]], ROOMS_PER_SESSION)) + option.unwrap(charge.channel(bytes[RoomOut], ROOM_OWNER_TOKENS)) + option.unwrap(charge.latest()) + option.unwrap(charge.counted(bytes[RoomGrantSet])) + option.unwrap(charge.block(bytes[(Sender[RoomRelayIn], RoomSession, Option[RoomGoneToken])], 0u64))
    let block = option.unwrap(charge.boxed(bytes[RoomMsgBlock])) + option.unwrap(charge.seq(1u64, message))
    let owner = option.unwrap(charge.seq(bytes[Option[Box[RoomPen]]], ROOMS_PER_SESSION)) + option.unwrap(charge.seq(bytes[Box[RoomMsgBlock]], ROOM_MSG_BLOCKS)) + ROOM_MSG_BLOCKS * block + room_decode_bytes(decode)
    desk + owner + ROOMS_PER_SESSION * per_sub
}

fn room_membership_charge(bounds: RoomBounds, arg_limit: u64) -> u64 {
    let state: u64 = int.widen(bounds.state)
    let peers: u64 = int.widen(bounds.peers)
    // Pen, Carrier and Seat each hold one state; the Seat also holds the
    // room key, the Caller and the per-peer told and changed slots. The two
    // codec checks each capture one Codec, whose size does not depend on V.
    2u64 * option.unwrap(charge.round(bytes[std.codec.Codec[Bytes]])) + option.unwrap(charge.boxed(bytes[RoomPen])) + option.unwrap(charge.boxed(bytes[RoomCarrier])) + option.unwrap(charge.boxed(bytes[RoomSeat])) + 3u64 * option.unwrap(charge.seq(1u64, state)) + option.unwrap(charge.seq(1u64, arg_limit)) + option.unwrap(charge.seq(1u64, SUBJECT_MAX)) + option.unwrap(charge.seq(bytes[u32], peers)) + option.unwrap(charge.seq(bytes[u8], peers))
}

fn start_room_relay(plan: RoomPlan, c: WireConfig, limit: u64, pub_to: Sender[PubIn], tasks: Tasks, random: Random) -> Result[Option[(RoomLink, Task[()])], StartError] waits {
    let hooks = match plan.hooks {
        Some(make) => make(),
        None => return Ok(None)
    }
    (hooks.start)(plan, c, limit, pub_to, tasks, random)
}

fn spawn_room_relay(plan: RoomPlan, c: WireConfig, limit: u64, pub_to: Sender[PubIn], tasks: Tasks, random: Random) -> Result[Option[(RoomLink, Task[()])], StartError] waits {
    if plan.roster == 0u64 {
        return Ok(None)
    }
    if plan.min_frame > plan.live_limit {
        return Error(Exceeds(Bound(name: "socket.max_frame", value: plan.min_frame, limit: plan.live_limit)))
    }
    let peak = int.saturating_add(wire_variable_peak(c), int.saturating_add(c.n_granted, plan.owner_bytes))
    if peak > WIRE_SESSION_CEILING {
        return Error(Exceeds(Bound(name: "session peak", value: peak, limit: WIRE_SESSION_CEILING)))
    }
    let channel_bytes = room_relay_charge(limit)
    let relay_fixed = channel_bytes + option.unwrap(charge.seq(bytes[RoomSession], limit)) + option.unwrap(charge.map(bytes[RoomSession], bytes[Box[RoomDesk]], limit)) + 4096u64
    let relay_min = relay_fixed + plan.roster
    if plan.relay_bytes < relay_min {
        return Error(Exceeds(Bound(name: "n_relay", value: relay_min, limit: plan.relay_bytes)))
    }
    let (answer, reply): (Sender[Latest[RoundAt]], Receiver[Latest[RoundAt]]) = channel.new(1u64)
    if let Error(_) = channel.send(pub_to, PubIn(e: RoomRounds(take answer))) {
        return Error(Open(PublisherStopped))
    }
    let Ok(take rounds) = channel.receive(reply) else {
        return Error(Open(PublisherStopped))
    }
    let (to, inbox): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(ROOM_RELAY_TOKENS * limit)
    let link = RoomLink(relay: take to, round_read: latest.handle(rounds), max_message: plan.message, live_limit: plan.live_limit, hooks: room_hooks)
    let seed = RoomRelaySeed(inbox: take inbox, rounds: take rounds, random, room_bytes: plan.relay_bytes - relay_fixed, max_sessions: limit)
    let task_bytes = plan.relay_bytes - channel_bytes
    let spawned = task.try_spawn(tasks, bytes task_bytes, take seed, room_relay_run) ?=> |(cap, _)| Full(cap)
    Ok(Some((take link, take spawned)))
}

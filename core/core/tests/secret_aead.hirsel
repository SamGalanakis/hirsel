// TLS-5, RFC 8439 section 2.8.2 and Appendix A.5.
fn rfc_seal() -> (Bytes, Bytes, Bytes, Bytes, Bytes) {
    (b"\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f", b"\x07\x00\x00\x00\x40\x41\x42\x43\x44\x45\x46\x47", b"\x50\x51\x52\x53\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7", b"\x4c\x61\x64\x69\x65\x73\x20\x61\x6e\x64\x20\x47\x65\x6e\x74\x6c\x65\x6d\x65\x6e\x20\x6f\x66\x20\x74\x68\x65\x20\x63\x6c\x61\x73\x73\x20\x6f\x66\x20\x27\x39\x39\x3a\x20\x49\x66\x20\x49\x20\x63\x6f\x75\x6c\x64\x20\x6f\x66\x66\x65\x72\x20\x79\x6f\x75\x20\x6f\x6e\x6c\x79\x20\x6f\x6e\x65\x20\x74\x69\x70\x20\x66\x6f\x72\x20\x74\x68\x65\x20\x66\x75\x74\x75\x72\x65\x2c\x20\x73\x75\x6e\x73\x63\x72\x65\x65\x6e\x20\x77\x6f\x75\x6c\x64\x20\x62\x65\x20\x69\x74\x2e", b"\xd3\x1a\x8d\x34\x64\x8e\x60\xdb\x7b\x86\xaf\xbc\x53\xef\x7e\xc2\xa4\xad\xed\x51\x29\x6e\x08\xfe\xa9\xe2\xb5\xa7\x36\xee\x62\xd6\x3d\xbe\xa4\x5e\x8c\xa9\x67\x12\x82\xfa\xfb\x69\xda\x92\x72\x8b\x1a\x71\xde\x0a\x9e\x06\x0b\x29\x05\xd6\xa5\xb6\x7e\xcd\x3b\x36\x92\xdd\xbd\x7f\x2d\x77\x8b\x8c\x98\x03\xae\xe3\x28\x09\x1b\x58\xfa\xb3\x24\xe4\xfa\xd6\x75\x94\x55\x85\x80\x8b\x48\x31\xd7\xbc\x3f\xf4\xde\xf0\x8e\x4b\x7a\x9d\xe5\x76\xd2\x65\x86\xce\xc6\x4b\x61\x16\x1a\xe1\x0b\x59\x4f\x09\xe2\x6a\x7e\x90\x2e\xcb\xd0\x60\x06\x91")
}

fn rfc_open() -> (Bytes, Bytes, Bytes, Bytes, Bytes) {
    (b"\x1c\x92\x40\xa5\xeb\x55\xd3\x8a\xf3\x33\x88\x86\x04\xf6\xb5\xf0\x47\x39\x17\xc1\x40\x2b\x80\x09\x9d\xca\x5c\xbc\x20\x70\x75\xc0", b"\x00\x00\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08", b"\xf3\x33\x88\x86\x00\x00\x00\x00\x00\x00\x4e\x91", b"\x49\x6e\x74\x65\x72\x6e\x65\x74\x2d\x44\x72\x61\x66\x74\x73\x20\x61\x72\x65\x20\x64\x72\x61\x66\x74\x20\x64\x6f\x63\x75\x6d\x65\x6e\x74\x73\x20\x76\x61\x6c\x69\x64\x20\x66\x6f\x72\x20\x61\x20\x6d\x61\x78\x69\x6d\x75\x6d\x20\x6f\x66\x20\x73\x69\x78\x20\x6d\x6f\x6e\x74\x68\x73\x20\x61\x6e\x64\x20\x6d\x61\x79\x20\x62\x65\x20\x75\x70\x64\x61\x74\x65\x64\x2c\x20\x72\x65\x70\x6c\x61\x63\x65\x64\x2c\x20\x6f\x72\x20\x6f\x62\x73\x6f\x6c\x65\x74\x65\x64\x20\x62\x79\x20\x6f\x74\x68\x65\x72\x20\x64\x6f\x63\x75\x6d\x65\x6e\x74\x73\x20\x61\x74\x20\x61\x6e\x79\x20\x74\x69\x6d\x65\x2e\x20\x49\x74\x20\x69\x73\x20\x69\x6e\x61\x70\x70\x72\x6f\x70\x72\x69\x61\x74\x65\x20\x74\x6f\x20\x75\x73\x65\x20\x49\x6e\x74\x65\x72\x6e\x65\x74\x2d\x44\x72\x61\x66\x74\x73\x20\x61\x73\x20\x72\x65\x66\x65\x72\x65\x6e\x63\x65\x20\x6d\x61\x74\x65\x72\x69\x61\x6c\x20\x6f\x72\x20\x74\x6f\x20\x63\x69\x74\x65\x20\x74\x68\x65\x6d\x20\x6f\x74\x68\x65\x72\x20\x74\x68\x61\x6e\x20\x61\x73\x20\x2f\xe2\x80\x9c\x77\x6f\x72\x6b\x20\x69\x6e\x20\x70\x72\x6f\x67\x72\x65\x73\x73\x2e\x2f\xe2\x80\x9d", b"\x64\xa0\x86\x15\x75\x86\x1a\xf4\x60\xf0\x62\xc7\x9b\xe6\x43\xbd\x5e\x80\x5c\xfd\x34\x5c\xf3\x89\xf1\x08\x67\x0a\xc7\x6c\x8c\xb2\x4c\x6c\xfc\x18\x75\x5d\x43\xee\xa0\x9e\xe9\x4e\x38\x2d\x26\xb0\xbd\xb7\xb7\x3c\x32\x1b\x01\x00\xd4\xf0\x3b\x7f\x35\x58\x94\xcf\x33\x2f\x83\x0e\x71\x0b\x97\xce\x98\xc8\xa8\x4a\xbd\x0b\x94\x81\x14\xad\x17\x6e\x00\x8d\x33\xbd\x60\xf9\x82\xb1\xff\x37\xc8\x55\x97\x97\xa0\x6e\xf4\xf0\xef\x61\xc1\x86\x32\x4e\x2b\x35\x06\x38\x36\x06\x90\x7b\x6a\x7c\x02\xb0\xf9\xf6\x15\x7b\x53\xc8\x67\xe4\xb9\x16\x6c\x76\x7b\x80\x4d\x46\xa5\x9b\x52\x16\xcd\xe7\xa4\xe9\x90\x40\xc5\xa4\x04\x33\x22\x5e\xe2\x82\xa1\xb0\xa0\x6c\x52\x3e\xaf\x45\x34\xd7\xf8\x3f\xa1\x15\x5b\x00\x47\x71\x8c\xbc\x54\x6a\x0d\x07\x2b\x04\xb3\x56\x4e\xea\x1b\x42\x22\x73\xf5\x48\x27\x1a\x0b\xb2\x31\x60\x53\xfa\x76\x99\x19\x55\xeb\xd6\x31\x59\x43\x4e\xce\xbb\x4e\x46\x6d\xae\x5a\x10\x73\xa6\x72\x76\x27\x09\x7a\x10\x49\xe6\x17\xd9\x1d\x36\x10\x94\xfa\x68\xf0\xff\x77\x98\x71\x30\x30\x5b\xea\xba\x2e\xda\x04\xdf\x99\x7b\x71\x4d\x6c\x6f\x2c\x29\xa6\xad\x5c\xb4\x02\x2b\x02\x70\x9b\xee\xad\x9d\x67\x89\x0c\xbb\x22\x39\x23\x36\xfe\xa1\x85\x1f\x38")
}

fn seal_key(raw: Bytes, policy: String) -> Secret {
    let mut key: Bytes = list.with_capacity(list.len(raw))
    list.append(mut key, raw)
    result.unwrap(secret.seal(take key, policy))
}

// AE1: RFC 8439 ciphertext, tag order, and appended plaintext.
// expect: run ae1_rfc8439() = true
fn ae1_rfc8439() -> bool {
    let (key, nonce, aad, plain, sealed) = rfc_seal()
    let sealer = seal_key(key, "aead(chacha20-poly1305)")
    let mut out: Bytes = list.with_capacity(131)
    list.push(mut out, b'!')
    let n = result.unwrap(secret.aead_seal(sealer, ChaCha20Poly1305, nonce, aad, plain, mut out))
    if n != 130 || out[0] != b'!' || list.slice(out, 1, 131) != sealed {
        return false
    }
    let (key2, nonce2, aad2, plain2, sealed2) = rfc_open()
    let opener = seal_key(key2, "open(chacha20-poly1305)")
    let mut opened: Bytes = list.with_capacity(266)
    list.push(mut opened, b'?')
    let m = result.unwrap(secret.aead_open(opener, ChaCha20Poly1305, nonce2, aad2, sealed2, mut opened))
    m == 265 && opened[0] == b'?' && list.slice(opened, 1, 266) == plain2
}

fn tampered(key: Secret, nonce: Bytes, aad: Bytes, sealed: Bytes) -> bool {
    let mut out: Bytes = list.with_capacity(266)
    list.push(mut out, b'!')
    match secret.aead_open(key, ChaCha20Poly1305, nonce, aad, sealed, mut out) {
        Error(Tampered) => list.len(out) == 1 && out[0] == b'!',
        _ => false
    }
}

fn changed(src: Bytes) -> Bytes {
    let mut modified: Bytes = list.with_capacity(list.len(src))
    list.append(mut modified, src)
    let _ = list.set(mut modified, 0, src[0] ^ 1u8)
    modified
}

// AE4: corrupted ciphertext, AAD and a different key share one refusal.
// expect: run ae4_mismatches() = true
fn ae4_mismatches() -> bool {
    let (key, nonce, aad, _, sealed) = rfc_open()
    let right = seal_key(key, "aead(chacha20-poly1305)")
    let wrong = seal_key(changed(key), "aead(chacha20-poly1305)")
    tampered(right, nonce, aad, changed(sealed)) && tampered(right, nonce, changed(aad), sealed) && tampered(wrong, nonce, aad, sealed) && tampered(right, nonce, aad, list.slice(sealed, 0, 15))
}

fn denied_seal(key: Secret, nonce: Bytes, mut out: Bytes) -> bool {
    match secret.aead_seal(key, Aes256Gcm, nonce, b"", b"", mut out) {
        Error(Denied) => list.len(out) == 0,
        _ => false
    }
}

fn denied_open(key: Secret, nonce: Bytes, sealed: Bytes, mut out: Bytes) -> bool {
    match secret.aead_open(key, Aes256Gcm, nonce, b"", sealed, mut out) {
        Error(Denied) => list.len(out) == 0,
        _ => false
    }
}

// AE5: the first 96-bit-IV CAVP gcmDecrypt256 record has empty plaintext.
// expect: run ae5_policy() = true
fn ae5_policy() -> bool {
    let key = b"\xf5\xa2\xb2\x7c\x74\x35\x58\x72\xeb\x3e\xf6\xc5\xfe\xaf\xaa\x74\x0e\x6a\xe9\x90\xd9\xd4\x8c\x3b\xd9\xbb\x82\x35\xe5\x89\xf0\x10"
    let nonce = b"\x58\xd2\x24\x0f\x58\x0a\x31\xc1\xd2\x49\x48\xe9"
    let sealed = b"\x15\xe0\x51\xa5\xe4\xa5\xf5\xda\x6c\xea\x92\xe2\xeb\xee\x5b\xac"
    let opener = seal_key(key, "open(aes256-gcm)")
    let mac = seal_key(key, "mac")
    let other = seal_key(key, "aead(chacha20-poly1305)")
    let both = seal_key(key, "aead(aes256-gcm)")
    let narrowed = result.unwrap(secret.narrow(both, "open(aes256-gcm)"))
    let mut out: Bytes = list.with_capacity(16)
    let denied = denied_seal(opener, nonce, mut out) && denied_seal(narrowed, nonce, mut out) && denied_seal(mac, nonce, mut out) && denied_open(mac, nonce, sealed, mut out) && denied_open(other, nonce, sealed, mut out)
    let mut empty: Bytes = list.new()
    let opened = result.unwrap(secret.aead_open(opener, Aes256Gcm, nonce, b"", sealed, mut empty))
    denied && opened == 0 && list.len(empty) == 0
}

fn invalid_key(raw: Bytes, alg: AeadAlg, policy: String) -> bool {
    let key = seal_key(raw, policy)
    let mut out: Bytes = list.with_capacity(16)
    match secret.aead_seal(key, alg, b"nonce-length", b"", b"", mut out) {
        Error(Invalid) => list.len(out) == 0,
        _ => false
    }
}

// AE6: key widths are checked independently of policy and capacity.
// expect: run ae6_key_lengths() = true
fn ae6_key_lengths() -> bool {
    let (key, _, _, _, _) = rfc_seal()
    let half = list.slice(key, 0, 16)
    invalid_key(half, Aes256Gcm, "aead(aes256-gcm)") && invalid_key(key, Aes128Gcm, "aead(aes128-gcm)") && invalid_key(half, ChaCha20Poly1305, "aead(chacha20-poly1305)")
}

// AE8: exactly one reference step and no byte admission for a 1 MiB seal.
// expect: reference run ae8_charge() = true
fn ae8_charge() -> bool {
    let (key, nonce, aad, _, _) = rfc_seal()
    let sealer = seal_key(key, "aead(chacha20-poly1305)")
    let mut plain: Bytes = list.with_capacity(1048576)
    list.fill(mut plain, 1048576, 0u8)
    let out: Bytes = list.with_capacity(1048592)
    let work = bound bytes 0 {
        bound steps 1 {
            let mut dst = take out
            secret.aead_seal(sealer, ChaCha20Poly1305, nonce, aad, plain, mut dst)
        }
    }
    match work {
        Ok(Ok(Ok(1048592))) => true,
        _ => false
    }
}

// S2's live read scenarios: init as `checkpoint`, a write phase that stages
// the writer's COMMIT around a capture, and a locked reopen.
fn disk_crash_live_read_main(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, out: Stdout, scenario: View[String]) -> Result[(), Exit] waits {
    let phase = option.unwrap(args.get(argv, 0))
    if phase == "init" {
        disk_crash_init(d, c, r, tasks, "checkpoint") ?=> |_| Exit(status: 31)
        return Ok(())
    }
    if phase == "write" {
        let published = if scenario == "follower-polls" {
            disk_crash_follower_polls(d, c, r, tasks, out) ?=> |_| Exit(status: 32)
        } else if scenario == "follower-poison" {
            disk_crash_follower_poison(d, c, r, tasks, out) ?=> |_| Exit(status: 32)
        } else if scenario == "follower-restart" {
            disk_crash_restart_write(d, c, r, tasks, out) ?=> |_| Exit(status: 32)
        } else if scenario == "follower-cut" {
            disk_crash_follower_cut(d, c, r, tasks, out) ?=> |_| Exit(status: 32)
        } else {
            disk_crash_live_read_write(d, c, tasks, out, scenario) ?=> |_| Exit(status: 32)
        }
        let mut ack = string.from("ACK ")
        string.push_u64(mut ack, published)
        let _ = stdout.write(out, ack)
        let _ = stdout.write(out, "DONE")
        return Ok(())
    }
    if scenario == "follower-restart" {
        disk_crash_restart_read(d, c, r, tasks, out) ?=> |_| Exit(status: 33)
        return Ok(())
    }
    let raw_floor = option.unwrap(args.get(argv, 3))
    let floor: u64 = result.unwrap(int.parse(raw_floor))
    let mut db = open(tasks, d, c, r, disk_crash_options("checkpoint")) ?=> |_| Exit(status: 33)
    trust_store(mut db) ?=> |_| Exit(status: 33)
    let head = version(snapshot(db))
    close(take db) ?=> |_| Exit(status: 33)
    if head < floor {
        fail("a live read published a head the store did not keep")
    }
    return Ok(())
}

// The adapter applies the staged COMMIT for head + 1 when recovery stats
// the terminal segment. The durability cases write it unsynced before the
// stat returns. The boundary case writes and syncs it with a new END after
// the stat took its size. The live read must publish head + 1, which the
// locked reopen must still find after restart discards unsynced bytes.
fn disk_crash_live_read_write(d: Dir, c: Clock, tasks: Tasks, out: Stdout, scenario: View[String]) -> Result[u64, Error] waits {
    let boundary = scenario == "follower-boundary"
    let read_only = scenario == "read-only-durable"
    let (_, store, take page_record) = failure_result_from_rep(capture.read_only_manifest(d))?
    let id = store_key_from_rep(store)
    let first = page_record.first_live
    let initial = read_only_checkpoint(d, id, take page_record)?
    let journal.JournalRecovered(replay: take known, seq: seq, end: end, ..) = journal_recover(d, id, first, c, take initial)?
    let wanted = known.state.tips[0u64].head + 1
    if scenario == "read-only-creation" {
        return disk_crash_creation_read(d, c, out, id, seq, end, wanted - 1)
    }
    let segment = failure_result_from_rep(manifest.journal_path(seq, ""))?
    let frame = journal_empty_commit(format.DiskContext(store: store_key_to_rep(id), role: 2, seq: seq), end, wanted)
    let mut message: Bytes = list.new()
    list.append(mut message, string.into_bytes(string.from("STAGE")))
    list.push(mut message, if read_only {
        2u8
    } else if boundary {
        1u8
    } else {
        0u8
    })
    failure_result_from_rep(types.capacity(format.le(mut message, end, 8)))?
    failure_result_from_rep(types.capacity(format.le(mut message, string.byte_len(segment), 1)))?
    list.append(mut message, string.into_bytes(take segment))
    failure_result_from_rep(types.capacity(format.le(mut message, list.len(frame), 4)))?
    list.append(mut message, frame)
    if boundary {
        let ctx = format.DiskContext(store: store_key_to_rep(id), role: 4, seq: seq)
        let mut end_image = failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?
        let mut payload: Bytes = list.new()
        failure_result_from_rep(types.capacity(format.le(mut payload, end + list.len(frame), 8)))?
        list.append(mut end_image, failure_result_from_rep(types.capacity(format.disk_seal(ctx, 72, 0x0012, 1, payload)))?)
        list.append(mut message, end_image)
    }
    let _ = stdout.write_bytes(out, message)
    if read_only {
        let captured = open_read_only(d, c, disk_crash_options("checkpoint"))?
        let published = version(captured.snapshot)
        if published != wanted {
            fail("the staged writer COMMIT did not reach the read-only open")
        }
        return Ok(published)
    }
    let plan = follower_law_plan(Directory, disk_crash_options("checkpoint"))
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    let replica = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, Some(id))?
    let published = applied(replica, follower_main(replica))?.version
    if published != wanted {
        fail("the staged writer COMMIT did not reach the follower")
    }
    close_follower_service(take service)?
    Ok(published)
}

// BL10 (2249 M2): ten polls over a live store whose capture key is
// unchanged issue no sync. An END rewritten past a new durable commit then
// costs one sync_dir and no segment sync: the END bound needs no flush.
// The bridge checks its reader sync counts at each "SYNCS a b".
fn disk_crash_follower_polls(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout) -> Result[u64, Error] waits {
    let options = disk_crash_options("checkpoint")
    let mut writer = open(tasks, d, c, r, options)?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let plan = follower_law_plan(Directory, options)
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    let mut replica = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None)?
    let trunk = follower_main(replica)
    let seen = applied(replica, trunk)?.version
    let forever = 18446744073709551615u64
    let _ = stdout.write(out, "SYNCS")
    for _ in 0u64 .. 10 {
        if catch_up(mut replica, forever)?.version != seen {
            fail("BL10: an unchanged store moved the follower")
        }
    }
    let _ = stdout.write(out, "SYNCS 0 0")
    let outcome = run(mut writer, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 500, 1)
    })?
    let Committed(done) = outcome else {
        fail("BL10: the new row was not committed")
    }
    durable(mut writer, done.ticket)?
    let head = version(snapshot(writer))
    let end = journal_end_bytes(writer.store, file_seq(writer), file_end(writer))
    failure_result_from_rep(manifest.disk_write_synced(d, failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(writer), ".end")))?, end))?
    let _ = stdout.write(out, "SYNCS")
    if catch_up(mut replica, forever)?.version != head {
        fail("BL10: the changed END did not move the follower")
    }
    let _ = stdout.write(out, "SYNCS 0 1")
    close_follower_service(take service)?
    close(take writer)?
    Ok(head)
}

// BL5 part 2 and BL6 (2249 M3): a poisoned owner. With one commit per group
// and each Direct write parked across a scheduler turn, the writer keeps the
// journal queue non-empty, so no END is written before the 64th group
// (§3.2: END at the 64th group or at the next empty queue). The bridge fails
// that 64th group write with ENOSPC: 63 groups are acked past END(72), and
// the Db stays open, poisoned, holding LOCK. The journal task closed its
// segment handle as it ended, so the terminal fence is free and a follower
// reads to the torn tail: catch_up and at_least reach the 63rd ack. If the
// failed task kept its handle, the capture would be END-bounded at 72.
// Oracle: the acked tickets; the read phase's reopen keeps the 63rd.
fn disk_crash_follower_poison(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout) -> Result[u64, Error] waits {
    let mut options = disk_crash_options("checkpoint")
    options.group_commits = 1
    let mut writer = open(tasks, d, c, r, options)?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let plan = follower_law_plan(Directory, options)
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    let mut replica = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None)?
    let trunk = follower_main(replica)
    let base = version(snapshot(writer))
    if applied(replica, trunk)?.version != base {
        fail("BL5: the first capture missed the opened head")
    }
    let _ = stdout.write(out, "ARM")
    let mut tickets: List[Ticket] = list.new()
    for k in 0u64 .. 64 {
        match run(mut writer, None, (copy_env(rows), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, 1000 + call_env.1, call_env.1)
        }) {
            Ok(Committed(done)) => list.push(mut tickets, done.ticket),
            Error(Poisoned(_)) => break,
            _ => fail("BL5: a pipelined commit was refused"),
        }
    }
    if list.len(tickets) != 64 {
        fail("BL5: the journal failed before the 64th group was queued")
    }
    match durable(mut writer, tickets[63u64]) {
        Error(Poisoned(Other(28))) => (),
        _ => fail("BL5: the 64th group did not poison the store"),
    }
    let mut acked = 0u64
    for t in tickets {
        if covered(writer, t.mark) {
            acked += 1
        }
    }
    let Journal(_, acked_branch, top) = tickets[62u64].mark else {
        fail("BL5: a journal commit without a journal mark")
    }
    if acked != 63 || top != base + 63 {
        fail("BL5: the poisoned store did not ack exactly 63 groups")
    }
    let creation_end = journal_end_bytes(writer.store, file_seq(writer), 72)
    let ending = failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(writer), ".end")))?
    if failure_result_from_rep(manifest.disk_read_file(d, ending, list.len(creation_end)))? != creation_end {
        fail("BL5: an END covered the acked groups; the poison case is vacuous")
    }
    let forever = 18446744073709551615u64
    if catch_up(mut replica, forever)?.version != top {
        fail("BL5: a capture beside the poisoned owner was END-bounded")
    }
    let wanted = Position(store: writer.store, branch: acked_branch, version: top)
    if version(at_least(mut replica, wanted, forever)?) != top {
        fail("BL5: at_least missed the last acked commit")
    }
    close_follower_service(take service)?
    match close(take writer) {
        Error(Poisoned(Other(28))) => (),
        _ => fail("BL5: the poisoned writer closed cleanly"),
    }
    Ok(top)
}

// BL9 (iii) (2249 B1, row 33): the restart trace. The write phase forks
// "side" from main's head; the fork waits for its own ticket, so the journal
// writes END at the fork's end before the next frame. After ARM it alternates
// 64 pipelined commits between main and side, BL5's setup: 63 are acked past
// that END before the 64th group fails and the writer exits. The tips of
// both branches come from the acked tickets and go to a synced file for the
// read phase.
fn disk_crash_restart_write(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout) -> Result[u64, Error] waits {
    let mut options = disk_crash_options("checkpoint")
    options.group_commits = 1
    let mut writer = open(tasks, d, c, r, options)?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let base = version(snapshot(writer))
    let trunk = main_branch(writer)
    let at = snapshot(writer)
    let (side, _) = fork(mut writer, "side", at)?
    let fork_end = file_end(writer)
    let _ = stdout.write(out, "ARM")
    let mut tickets: List[Ticket] = list.new()
    for k in 0u64 .. 64 {
        let onto = if k % 2 == 0 {
            trunk
        } else {
            side
        }
        match run_on(mut writer, onto, None, (copy_env(rows), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, 2000 + call_env.1, call_env.1)
        }) {
            Ok(Committed(done)) => list.push(mut tickets, done.ticket),
            Error(Poisoned(_)) => break,
            _ => fail("BL9: a pipelined commit was refused"),
        }
    }
    if list.len(tickets) != 64 {
        fail("BL9: the journal failed before the 64th group was queued")
    }
    match durable(mut writer, tickets[63u64]) {
        Error(Poisoned(Other(28))) => (),
        _ => fail("BL9: the 64th group did not poison the store"),
    }
    let mut acked = 0u64
    for t in tickets {
        if covered(writer, t.mark) {
            acked += 1
        }
    }
    // Commits k = 0 .. 62 are acked: 32 on main (k even) and 31 on side,
    // which the fork started at main's head.
    let Journal(_, _, main_top) = tickets[62u64].mark else {
        fail("BL9: a journal commit without a journal mark")
    }
    let Journal(_, _, side_top) = tickets[61u64].mark else {
        fail("BL9: a journal commit without a journal mark")
    }
    if acked != 63 || main_top != base + 32 || side_top != base + 31 {
        fail("BL9: the writer did not ack 63 commits over both branches")
    }
    let fork_ending = journal_end_bytes(writer.store, file_seq(writer), fork_end)
    let ending = failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(writer), ".end")))?
    if failure_result_from_rep(manifest.disk_read_file(d, ending, list.len(fork_ending)))? != fork_ending {
        fail("BL9: the END is not the fork's; the acks are not past d")
    }
    let mut tips: Bytes = list.new()
    failure_result_from_rep(types.capacity(format.le(mut tips, main_top, 8)))?
    failure_result_from_rep(types.capacity(format.le(mut tips, side_top, 8)))?
    failure_result_from_rep(manifest.disk_write_synced(d, string.from("bl9-tips"), tips))?
    failure_result_from_rep(manifest.disk_io(host.sync_dir(d)))?
    match close(take writer) {
        Error(Poisoned(Other(28))) => (),
        _ => fail("BL9: the poisoned writer closed cleanly"),
    }
    Ok(main_top)
}

type RestartOwner: send {
    tasks: Tasks,
    d: Dir,
    c: Clock,
    r: Random,
    opened: Sender[u64],
    stop: Receiver[()]
}

fn disk_crash_restart_owner(take job: RestartOwner) -> Result[(), Error] waits {
    let mut db = open(job.tasks, job.d, job.c, job.r, disk_crash_options("checkpoint"))?
    trust_store(mut db)?
    result.unwrap(channel.send(job.opened, version(snapshot(db))))
    let _ = channel.receive(job.stop)
    close(take db)
}

fn restart_tips(f: Follower, main_top: u64, side_top: u64) -> bool {
    let Some(side) = follower_branch(f, string.from("side")) else {
        return false
    }
    result.unwrap(applied(f, follower_main(f))).version == main_top && result.unwrap(applied(f, side)).version == side_top
}

fn restart_follower(tasks: Tasks, d: Dir, c: Clock, plan: FollowerPlan, main_top: u64, side_top: u64) -> Result[(FollowerService, Follower), Error] waits {
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    let f = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(d), c, None)?
    if !restart_tips(f, main_top, side_top) {
        fail("BL9: a first capture missed the acked tips")
    }
    Ok((service, f))
}

// The read phase, after the power cut. Followers run one at a time (two
// slots exceed the crash binary's limit). `early` attaches to the dead
// writer's store and reads to the torn tail. A new owner then opens; the
// adapter holds it at step 8's create (after step 5 released its fences)
// until "RELEASE". While it holds LOCK, early's key is unchanged, so its
// catch_up reuses the capture with no sync. `held` starts beside the held
// owner and still reads to the torn tail, because the terminal fence is free.
// After step 8, `held` keeps both tips and `rotated`, started then, finds
// them through the new HEADER's prev_end.
fn disk_crash_restart_read(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout) -> Result[(), Error] waits {
    let raw = failure_result_from_rep(manifest.disk_read_file(d, string.from("bl9-tips"), 16))?
    let main_top = format.read_le(raw, 0, 8)
    let side_top = format.read_le(raw, 8, 8)
    let forever = 18446744073709551615u64
    let plan = follower_law_plan(Directory, disk_crash_options("checkpoint"))
    let (take first, take early_start) = restart_follower(tasks, d, c, plan, main_top, side_top)?
    let mut early = take early_start
    let (opened_by, opened): (Sender[u64], Receiver[u64]) = channel.new(1)
    let (stop, stopped): (Sender[()], Receiver[()]) = channel.new(1)
    let job = RestartOwner(tasks, d, c, r, opened: take opened_by, stop: take stopped)
    let owner = task.spawn(tasks, bytes 25165824, take job, disk_crash_restart_owner)
    let _ = stdout.write(out, "WAIT")
    let _ = stdout.write(out, "SYNCS")
    let _ = catch_up(mut early, forever)?
    let _ = stdout.write(out, "SYNCS 0 0")
    if !restart_tips(early, main_top, side_top) {
        fail("BL9: a branch moved while the new owner held LOCK")
    }
    close_follower_service(take first)?
    let (take second, take held_start) = restart_follower(tasks, d, c, plan, main_top, side_top)?
    let mut held = take held_start
    let _ = stdout.write(out, "RELEASE")
    if result.unwrap(channel.receive(opened)) != main_top {
        fail("BL9: the new owner did not recover exactly the acked commits")
    }
    for _ in 0u64 .. 2 {
        let _ = catch_up(mut held, forever)?
    }
    if !restart_tips(held, main_top, side_top) {
        fail("BL9: a branch moved after the new owner's rotation")
    }
    close_follower_service(take second)?
    let (take third, _) = restart_follower(tasks, d, c, plan, main_top, side_top)?
    close_follower_service(take third)?
    result.unwrap(channel.send(stop, ()))
    result.unwrap(task.join(take owner))?
    Ok(())
}

// BL7 part 2 (2284 N1): a cut has created j-(seq + 1) but its creation
// block has not landed, so the reader reads that HEADER short. The adapter
// then lands the block and a second cut's j-(seq + 2) before the reader
// checks for a successor. No damage is injected, so the open must restart
// its walk and publish the recovered head, never answer Corrupt(Header).
fn disk_crash_creation_read(d: Dir, c: Clock, out: Stdout, id: StoreId, seq: u64, end: u64, head: u64) -> Result[u64, Error] waits {
    failure_result_from_rep(manifest.disk_write_synced(d, failure_result_from_rep(manifest.journal_path(seq + 1, ""))?, list.new()))?
    let mut message: Bytes = list.new()
    list.append(mut message, string.into_bytes(string.from("STAGE")))
    list.push(mut message, 3u8)
    for ahead in 1u64 .. 3 {
        let name = failure_result_from_rep(manifest.journal_path(seq + ahead, ""))?
        failure_result_from_rep(types.capacity(format.le(mut message, string.byte_len(name), 1)))?
        list.append(mut message, string.into_bytes(take name))
        let prev_end = if ahead == 1 {
            end
        } else {
            72u64
        }
        list.append(mut message, failure_result_from_rep(types.capacity(format.disk_header_bytes(format.DiskContext(store: store_key_to_rep(id), role: 2, seq: seq + ahead), prev_end, 0)))?)
    }
    let _ = stdout.write_bytes(out, message)
    let captured = open_read_only(d, c, disk_crash_options("checkpoint"))?
    if version(captured.snapshot) != head {
        fail("a read across a creation and a cut missed the recovered head")
    }
    Ok(head)
}

// BL7 part 1 (2249 M1, row 35): a reader walks between the cut's Direct open
// of j-(n + 1) and its try_lock, then stays suspended right after its fence
// take while the cut and the commits queued behind it complete. The adapter
// holds the reader's first open ("BL7") until the creator's open, holds the
// creator's try_lock until the reader's first shared fence take, and holds
// that take until RELEASE. A reader that fenced the empty j-(n + 1) would
// refuse the creator's try_lock, which the adapter fails. The walk ends
// before j-(n + 1) (no END, no HEADER). The cut's MANIFEST lands while the
// reader is suspended, so after its fence take the reader finds MANIFEST
// changed and walks again: j-(n + 1) is then terminal under the live writer,
// whose idle END covers every commit, so the capture is END-bounded at top.
type CutReader: send {
    d: Dir,
    c: Clock
}

fn disk_crash_cut_reader(take job: CutReader) -> Result[u64, Error] waits {
    match host.open(job.d, "BL7", Read) {
        Error(NotFound) => (),
        _ => fail("BL7: the reader's start marker opened"),
    }
    let mut progress = object_writer.LogCaptureProgress(next_id: 1, last: None)
    let forever = 18446744073709551615u64
    let Some(captured) = log_follow_capture(job.d, job.c, forever, mut progress, None, forever, None)? else {
        fail("BL7: the suspended reader captured nothing")
    }
    Ok(captured.state.tips[0u64].head)
}

fn disk_crash_follower_cut(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout) -> Result[u64, Error] waits {
    let mut writer = open(tasks, d, c, r, disk_crash_options("checkpoint"))?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let base = version(snapshot(writer))
    let walker = task.spawn(tasks, bytes 8388608, CutReader(d: d, c: c), disk_crash_cut_reader)
    let _ = stdout.write(out, "WAIT")
    let _ = checkpoint(mut writer)?
    let mut newest: Option[Ticket] = None
    for k in 0u64 .. 4 {
        match run(mut writer, None, (copy_env(rows), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, 3000 + call_env.1, call_env.1)
        })? {
            Committed(done) => {
                newest = Some(done.ticket)
            },
            _ => fail("BL7: a commit behind the cut was refused"),
        }
    }
    let Some(final_ticket) = newest else {
        fail("BL7: no commit followed the cut")
    }
    durable(mut writer, final_ticket)?
    let top = version(snapshot(writer))
    if top != base + 4 {
        fail("BL7: the commits behind the cut did not all land")
    }
    let _ = stdout.write(out, "RELEASE")
    if result.unwrap(task.join(take walker))? != top {
        fail("BL7: the resumed reader's capture missed the commits behind the cut")
    }
    close(take writer)?
    Ok(top)
}

// BL10 (2284 G2): a candidate the caller dropped at its deadline leaves the
// published capture P in place. The next attempt sees the same key, but it
// names P, not the dropped candidate, so it must capture the writer's acked
// head again rather than answer "nothing new" until the dead writer writes.
@test
fn log_follower_dropped_candidate(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut writer = open(tasks, directory, c, r, options)?
    let _ = law_table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !typed_put(mut writer, rows, 1, 10) {
        fail("G2: the first row was refused")
    }
    close(take writer)?
    let mut progress = object_writer.LogCaptureProgress(next_id: 1, last: None)
    let forever = 18446744073709551615u64
    let Some(published) = log_follow_capture(directory, c, forever, mut progress, None, forever, None)? else {
        fail("G2: the first capture published nothing")
    }
    let mut later = open(tasks, directory, c, r, options)?
    let again = table(mut later, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !typed_put(mut later, again, 1, 20) {
        fail("G2: the second row was refused")
    }
    let acked = version(snapshot(later))
    close(take later)?
    for _ in 0u64 .. 2 {
        let Some(candidate) = log_follow_capture(directory, c, forever, mut progress, Some(store_key_from_rep(published.store)), forever, Some(arc.share(published)))? else {
            fail("G2: a capture behind the acked head answered nothing new")
        }
        if candidate.state.tips[0u64].head != acked {
            fail("G2: the capture missed the acked head")
        }
        // The caller's deadline passes before the swap; the candidate drops.
        let _ = take candidate
    }
    Ok(())
}

// BL9 (i) (2284 G3): MANIFEST holds main at m and side at v; the terminal
// segment holds only side's commit v + 1. A live writer keeps LOCK, so an
// unreadable END bounds the capture at the segment header: main stays at m
// and only side moves back to v. The monotone rule keeps the published
// capture, so no call returns Diverged and neither branch's applied position
// moves. A main-only comparison publishes side at v.
@test
fn log_follower_unreadable_end(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut writer = open_directory(tasks, directory, c, r, options, JOURNAL_LAW_NAMED_END_CADENCE)?
    let _ = law_table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !typed_put(mut writer, rows, 1, 10) {
        fail("G3: the main row was refused")
    }
    let base = snapshot(writer)
    let (side, _) = fork(mut writer, "side", base)?
    let _ = checkpoint(mut writer)?
    let main_tip = version(snapshot(writer))
    let held = version(snapshot_of(writer, side)?)
    let outcome = run_on(mut writer, side, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 2, 20)
    })?
    let Committed(done) = outcome else {
        fail("G3: the side write was not committed")
    }
    durable(mut writer, done.ticket)?
    journal_law_await_end(writer)?;
    let side_tip = version(snapshot_of(writer, side)?)
    if side_tip != held + 1 || version(snapshot(writer)) != main_tip {
        fail("G3: the side write did not move side alone")
    }
    let plan = follower_law_plan(Directory, options)
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    let mut replica = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(directory), c, None)?
    let Some(mirror) = follower_branch(replica, "side") else {
        fail("G3: the follower did not see side")
    }
    let trunk = follower_main(replica)
    if applied(replica, trunk)?.version != main_tip || applied(replica, mirror)?.version != side_tip {
        fail("G3: the first capture missed a branch tip")
    }
    let mut garbage: Bytes = list.new()
    for _ in 0u64 .. 96 {
        list.push(mut garbage, 255u8)
    }
    failure_result_from_rep(manifest.disk_write_synced(directory, failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(writer), ".end")))?, garbage))?
    let forever = 18446744073709551615u64
    let wanted = applied(replica, mirror)?
    for call in 0u64 .. 3 {
        let answer = if call == 0 {
            catch_up(mut replica, forever)?.version
        } else if call == 1 {
            version(at_least(mut replica, wanted, forever)?)
        } else {
            version(fresh(mut replica, forever)?)
        }
        let expected = if call == 1 {
            side_tip
        } else {
            main_tip
        }
        if answer != expected || applied(replica, trunk)?.version != main_tip || applied(replica, mirror)?.version != side_tip {
            fail("G3: an unreadable END moved a published branch back")
        }
    }
    close_follower_service(take service)?
    close(take writer)
}

// BL9 (ii): the writer has closed. MANIFEST holds main and sides a < b; the
// terminal segment holds a commit on each side, which the follower applied.
// Truncating the segment below both commits and removing its END leaves a
// torn tail behind the published stop: catch_up answers Diverged with the
// lower id, a, and both applied positions stay. Oracle: the hand-derived tips.
@test
fn log_follower_behind_torn_tail(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut writer = open(tasks, directory, c, r, options)?
    let _ = law_table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let base = snapshot(writer)
    let (lower, _) = fork(mut writer, "a", base)?
    let again = snapshot(writer)
    let (upper, _) = fork(mut writer, "b", again)?
    let _ = checkpoint(mut writer)?
    let segment = failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(writer), "")))?
    let ending = failure_result_from_rep(types.capacity(manifest.disk_path("j-", file_seq(writer), ".end")))?
    let stop = file_end(writer)
    let durable_prefix = read_journal_prefix(directory, segment, stop)?
    let mut tips: List[u64] = list.new()
    for side in[lower, upper] {
        let outcome = run_on(mut writer, side, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
            put(mut tx, t, 2, 20)
        })?
        let Committed(done) = outcome else {
            fail("BL9 ii: a side write was not committed")
        }
        durable(mut writer, done.ticket)?
        list.push(mut tips, version(snapshot_of(writer, side)?))
    }
    close(take writer)?
    let plan = follower_law_plan(Directory, options)
    let service = follower_law_service(tasks, plan, 1)?
    let mut ids = followers()
    let mut replica = follower(mut ids, follower_slot(follower_owner(service)?, plan)?, log_authority(directory), c, None)?
    let (Some(a), Some(b)) = (follower_branch(replica, "a"), follower_branch(replica, "b")) else {
        fail("BL9 ii: the follower did not see both sides")
    }
    if applied(replica, a)?.version != tips[0u64] || applied(replica, b)?.version != tips[1u64] {
        fail("BL9 ii: the first capture missed a side tip")
    }
    failure_result_from_rep(manifest.disk_write_synced(directory, segment, durable_prefix))?
    if !failure_result_from_rep(manifest.disk_remove_optional(directory, ending))? {
        fail("BL9 ii: the closed writer left no END")
    }
    match catch_up(mut replica, 18446744073709551615u64) {
        Error(Diverged(id)) => if id != a.id {
            fail("BL9 ii: Diverged named a branch other than the lowest behind")
        },
        _ => fail("BL9 ii: a torn tail behind the published stop was not Diverged"),
    }
    if applied(replica, a)?.version != tips[0u64] || applied(replica, b)?.version != tips[1u64] {
        fail("BL9 ii: a Diverged capture changed a published branch")
    }
    close_follower_service(take service)
}

// BL4 and BL5 part 1: the terminal segment holds well-formed commits for v1
// and v2, and a hand-written END bounds it at v1's end d. With LOCK and the
// segment's fence held by the live writer, a capture applies only frames
// below d (v1). A free fence gives the torn tail (v2) whatever LOCK's state:
// with LOCK held by another handle, and with both free. Oracle: the
// hand-written END and the two acked versions.
@test
fn log_follower_end_bound(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut writer = open(tasks, directory, c, r, options)?
    let _ = law_table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut writer, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let mut acked: List[(u64, u64)] = list.new()
    for k in 1u64 .. 3 {
        let outcome = run(mut writer, None, (copy_env(rows), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, call_env.1, call_env.1 * 10)
        })?
        let Committed(done) = outcome else {
            fail("BL4: a row was not committed")
        }
        durable(mut writer, done.ticket)?
        list.push(mut acked, (version(snapshot(writer)), file_end(writer)))
    }
    let (bounded, limit_at) = acked[0u64]
    let (torn, _) = acked[1u64]
    let id = writer.store
    let seq = file_seq(writer)
    let ending = failure_result_from_rep(types.capacity(manifest.disk_path("j-", seq, ".end")))?
    failure_result_from_rep(manifest.disk_write_synced(directory, ending, journal_end_bytes(id, seq, limit_at)))?
    if log_end_bound_head(directory, c)? != bounded {
        fail("BL4: a capture under a held fence did not stop at END")
    }
    close(take writer)?
    failure_result_from_rep(manifest.disk_write_synced(directory, ending, journal_end_bytes(id, seq, limit_at)))?
    let mut lock = failure_result_from_rep(manifest.disk_io(host.open(directory, "LOCK", Read)))?
    if !failure_result_from_rep(manifest.disk_io(host.try_lock(mut lock)))? {
        fail("BL5: the closed writer kept LOCK")
    }
    if log_end_bound_head(directory, c)? != torn {
        fail("BL5: a free fence under a held LOCK did not read to the torn tail")
    }
    failure_result_from_rep(manifest.disk_io(host.unlock(mut lock)))?
    failure_result_from_rep(manifest.disk_io(host.close(take lock)))?
    if log_end_bound_head(directory, c)? != torn {
        fail("BL4: a free directory did not read to the torn tail")
    }
    Ok(())
}

fn log_end_bound_head(d: Dir, c: Clock) -> Result[u64, Error] waits {
    let mut progress = object_writer.LogCaptureProgress(next_id: 1, last: None)
    let forever = 18446744073709551615u64
    let Some(captured) = log_follow_capture(d, c, forever, mut progress, None, forever, None)? else {
        fail("BL4: a first capture published nothing")
    }
    Ok(captured.state.tips[0u64].head)
}

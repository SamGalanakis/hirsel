// Wycheproof ecdsa_secp256r1_sha256_test.json at 65ca494727a52944c204441c860b039e6786b99b, tcId 5.
fn wycheproof_der_tc5() -> (Bytes, Bytes, Bytes) {
    (b"\x04\x29\x27\xb1\x05\x12\xba\xe3\xed\xdc\xfe\x46\x78\x28\x12\x8b\xad\x29\x03\x26\x99\x19\xf7\x08\x60\x69\xc8\xc4\xdf\x6c\x73\x28\x38\xc7\x78\x79\x64\xea\xac\x00\xe5\x92\x1f\xb1\x49\x8a\x60\xf4\x60\x67\x66\xb3\xd9\x68\x50\x01\x55\x8d\x1a\x97\x4e\x73\x41\x51\x3e", b"\x31\x32\x33\x34\x30\x30", b"\x30\x44\x02\x20\x2b\xa3\xa8\xbe\x6b\x94\xd5\xec\x80\xa6\xd9\xd1\x19\x0a\x43\x6e\xff\xe5\x0d\x85\xa1\xee\xe8\x59\xb8\xcc\x6a\xf9\xbd\x5c\x2e\x18\x02\x20\x4c\xd6\x0b\x85\x5d\x44\x2f\x5b\x3c\x7b\x11\xeb\x6c\x4e\x0a\xe7\x52\x5f\xe7\x10\xfa\xb9\xaa\x7c\x77\xa6\x7f\x79\xe6\xfa\xdd\x76")
}

// SV6. NIST record 4 passes and record 1 fails with S changed.
// expect: run sv6_nist_sigver() = true
fn sv6_nist_sigver() -> bool {
    let (valid_key, valid_msg, valid_sig) = nist_record_4()
    let (bad_key, bad_msg, bad_sig) = nist_record_1()
    p256.verify(valid_key, valid_msg, valid_sig) && !p256.verify(bad_key, bad_msg, bad_sig)
}

// SV7. Wycheproof ecdsa_secp256r1_sha256_p1363_test.json tcId 64 has S above n/2.
// expect: run sv7_fixed_high_s() = true
fn sv7_fixed_high_s() -> bool {
    let key = b"\x04\x29\x27\xb1\x05\x12\xba\xe3\xed\xdc\xfe\x46\x78\x28\x12\x8b\xad\x29\x03\x26\x99\x19\xf7\x08\x60\x69\xc8\xc4\xdf\x6c\x73\x28\x38\xc7\x78\x79\x64\xea\xac\x00\xe5\x92\x1f\xb1\x49\x8a\x60\xf4\x60\x67\x66\xb3\xd9\x68\x50\x01\x55\x8d\x1a\x97\x4e\x73\x41\x51\x3e"
    let msg = b"\x33\x39\x34\x39\x34\x30\x31\x32\x31\x35"
    let sig = b"\xbf\xab\x30\x98\x25\x28\x47\xb3\x28\xfa\xdf\x2f\x89\xb9\x5c\x85\x1a\x7f\x0e\xb3\x90\x76\x33\x78\xf3\x7e\x90\x11\x9d\x5b\xa3\xdd\xbd\xd6\x4e\x23\x4e\x83\x2b\x10\x67\xc2\xd0\x58\xcc\xb4\x4d\x97\x81\x95\xcc\xeb\xb6\x5c\x2a\xaf\x1e\x2d\xa9\xb8\xb4\x98\x7e\x3b"
    p256.verify(key, msg, sig)
}

// SV7. DER tcId 7 is the high-S twin of tcId 5.
// expect: run sv7_der_high_s() = true
fn sv7_der_high_s() -> bool {
    let (key, msg, _) = wycheproof_der_tc5()
    p256.verify_der(key, msg, b"\x30\x45\x02\x20\x2b\xa3\xa8\xbe\x6b\x94\xd5\xec\x80\xa6\xd9\xd1\x19\x0a\x43\x6e\xff\xe5\x0d\x85\xa1\xee\xe8\x59\xb8\xcc\x6a\xf9\xbd\x5c\x2e\x18\x02\x21\x00\xb3\x29\xf4\x79\xa2\xbb\xd0\xa5\xc3\x84\xee\x14\x93\xb1\xf5\x18\x6a\x87\x13\x9c\xac\x5d\xf4\x08\x7c\x13\x4b\x49\x15\x68\x47\xdb")
}

// SV8. DER tcId 5 is valid. tcId 8 uses a long-form length and tcId 6 has a negative S.
// expect: run sv8_strict_der() = true
fn sv8_strict_der() -> bool {
    let (key, msg, sig) = wycheproof_der_tc5()
    p256.verify_der(key, msg, sig) && !p256.verify_der(key, msg, b"\x30\x81\x45\x02\x20\x2b\xa3\xa8\xbe\x6b\x94\xd5\xec\x80\xa6\xd9\xd1\x19\x0a\x43\x6e\xff\xe5\x0d\x85\xa1\xee\xe8\x59\xb8\xcc\x6a\xf9\xbd\x5c\x2e\x18\x02\x21\x00\xb3\x29\xf4\x79\xa2\xbb\xd0\xa5\xc3\x84\xee\x14\x93\xb1\xf5\x18\x6a\x87\x13\x9c\xac\x5d\xf4\x08\x7c\x13\x4b\x49\x15\x68\x47\xdb") && !p256.verify_der(key, msg, b"\x30\x44\x02\x20\x2b\xa3\xa8\xbe\x6b\x94\xd5\xec\x80\xa6\xd9\xd1\x19\x0a\x43\x6e\xff\xe5\x0d\x85\xa1\xee\xe8\x59\xb8\xcc\x6a\xf9\xbd\x5c\x2e\x18\x02\x20\xb3\x29\xf4\x79\xa2\xbb\xd0\xa5\xc3\x84\xee\x14\x93\xb1\xf5\x18\x6a\x87\x13\x9c\xac\x5d\xf4\x08\x7c\x13\x4b\x49\x15\x68\x47\xdb")
}

// SV9. NIST record 4 with compressed or bare keys, or a truncated signature.
// expect: run sv9_nist_forms() = true
fn sv9_nist_forms() -> bool {
    let (key, msg, sig) = nist_record_4()
    let compressed = b"\x03\xe4\x24\xdc\x61\xd4\xbb\x3c\xb7\xef\x43\x44\xa7\xf8\x95\x7a\x0c\x51\x34\xe1\x6f\x7a\x67\xc0\x74\xf8\x2e\x6e\x12\xf4\x9a\xbf\x3c"
    !p256.verify(compressed, msg, sig) && !p256.verify(list.slice(key, 1, 65), msg, sig) && !p256.verify(key, msg, list.slice(sig, 0, 63))
}

// SV9. Wycheproof P1363 tcId 121 encodes the signature in two bytes.
// expect: run sv9_wycheproof_short_signature() = false
fn sv9_wycheproof_short_signature() -> bool {
    let key = b"\x04\xa7\x1a\xf6\x4d\xe5\x12\x6a\x4a\x4e\x02\xb7\x92\x2d\x66\xce\x94\x15\xce\x88\xa4\xc9\xd2\x55\x14\xd9\x10\x82\xc8\x72\x5a\xc9\x57\x5d\x47\x72\x3c\x8f\xbe\x58\x0b\xb3\x69\xfe\xc9\xc2\x66\x5d\x8e\x30\xa4\x35\xb9\x93\x26\x45\x48\x2e\x7c\x9f\x11\xe8\x72\x29\x6b"
    let msg = b"\x31\x32\x33\x34\x30\x30"
    p256.verify(key, msg, b"\x05\x01")
}

// SV10. One step and zero bytes suffice for NIST record 4's 128-byte message.
// expect: run sv10_fixed_charge() = true
fn sv10_fixed_charge() -> bool {
    let (key, msg, sig) = nist_record_4()
    let work = bound bytes 0 {
        bound steps 1 {
            p256.verify(key, msg, sig)
        }
    }
    match work {
        Ok(Ok(true)) => true,
        _ => false,
    }
}

// SV10. The same bound suffices for DER tcId 5.
// expect: run sv10_der_charge() = true
fn sv10_der_charge() -> bool {
    let (key, msg, sig) = wycheproof_der_tc5()
    let work = bound bytes 0 {
        bound steps 1 {
            p256.verify_der(key, msg, sig)
        }
    }
    match work {
        Ok(Ok(true)) => true,
        _ => false,
    }
}

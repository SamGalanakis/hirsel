// Module store: a store's own limits (§11.1 AP4a): admission at and one
// byte over the small Place limits, genesis recording, and replay.
// AP4a: one commit of two rows, 262,144 B and n B, under table 1. Its
// payload is 16 + 26 + 2 × 25 + 262,144 + n = 262,236 + n bytes, as in L29.
// Returns 1 for committed and durable, 0 for Limit(Transaction), 2 otherwise.
fn journal_small_commit(mut db: Db, n: u64) -> u8 waits {
    let done = result.unwrap(run(mut db, None, n, fn(mut tx, call_env) -> Result[u64, Error] {
        for k in 0u64 .. 2 {
            let size = if k == 1 {
                call_env
            } else {
                262144u64
            }
            let mut value: Bytes = list.with_capacity(size)
            list.fill(mut value, size, 0u8)
            put_bytes(mut tx, 1, types.key_word(k), value)?
        }
        Ok(0u64)
    }))
    match take done {
        Committed(x) => {
            result.unwrap(durable(mut db, x.ticket))
            1u8
        },
        Aborted(Undone(value: Limit(Transaction), ticket: None)) => 0u8,
        _ => 2u8,
    }
}

// AP4a: a store made with the small Place limits (frame 327,760, so
// T = 327,744) admits a payload of 262,236 + n while 262,220 + n <= T:
// n = 65,524 is at the limit and 65,525 one byte over. The ceilings would
// admit both. The same holds after a reopen that names no limits, because
// the store reads its limits from the MANIFEST; a reopen naming the
// ceilings is LimitsDiffer with the recorded limits.
pub fn journal_law_small_limits(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = disk_test_directory(d)
    let small = small_place_limits()
    let mut options = journal_crash_options()
    options.resident_limit = 4194304
    options.limits = Some(small)
    let mut db = result.unwrap(open(tasks, dir, c, r, options))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if journal_small_commit(mut db, 65525) != 0u8 || journal_small_commit(mut db, 65524) != 1u8 {
        return false
    }
    result.unwrap(close(take db))
    options.limits = None
    let mut reopened = result.unwrap(open(tasks, dir, c, r, options))
    if !types.same_limits(limits_to_rep(store_limits(reopened)), limits_to_rep(small)) || page_row_count(pages.holder_heads(reopened.holders)[0].roots.collections) != 2 {
        return false
    }
    if journal_small_commit(mut reopened, 65525) != 0u8 || journal_small_commit(mut reopened, 65524) != 1u8 {
        return false
    }
    result.unwrap(close(take reopened))
    options.limits = Some(default_limits())
    match open(tasks, dir, c, r, options) {
        Error(LimitsDiffer(found)) => types.same_limits(limits_to_rep(found), limits_to_rep(small)),
        _ => false,
    }
}

@test
fn journal_test_small_limits(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_small_limits(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// AP4a: genesis publishes the limits in the MANIFEST before any frame. A
// writer that dies after genesis, before its first commit, reopens with the
// recorded limits when its Config names none.
pub fn journal_law_genesis_limits(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = disk_test_directory(d)
    let small = small_place_limits()
    let mut options = journal_crash_options()
    options.limits = Some(small)
    let first = result.unwrap(disk_session(dir, c, r, options))
    if !types.same_limits(first.startup.limits, limits_to_rep(small)) {
        return false
    }
    let journal.DiskSession(lock: take lock, startup: _) = take first
    result.unwrap(failure_result_from_rep(manifest.disk_io(host.close(take lock))))
    options.limits = None
    let db = result.unwrap(open(tasks, dir, c, r, options))
    let kept = types.same_limits(limits_to_rep(store_limits(db)), limits_to_rep(small)) && pages.holder_heads(db.holders)[0].head == 0
    result.unwrap(close(take db))
    kept
}

@test
fn journal_test_genesis_limits(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_genesis_limits(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// AP4a: replay checks each frame against the recorded limits, not the
// ceilings. A default store journals one commit of two 200,000 B rows
// (payload 16 + 26 + 2 × 25 + 400,000 = 400,092, each value under the small
// value limit). With its MANIFEST republished to record the small limits
// (T = 327,744), the reopen's replay finds the frame over T: Corrupt.
pub fn journal_law_replay_over_limit(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = disk_test_directory(d)
    let mut options = journal_crash_options()
    options.resident_limit = 4194304
    let mut db = result.unwrap(open(tasks, dir, c, r, options))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let done = result.unwrap(run(mut db, None, 200000u64, fn(mut tx, call_env) -> Result[u64, Error] {
        for k in 0u64 .. 2 {
            let mut value: Bytes = list.with_capacity(call_env)
            list.fill(mut value, call_env, 0u8)
            put_bytes(mut tx, 1, types.key_word(k), value)?
        }
        Ok(option.unwrap(txn.tx_frame_bytes(tx.inner)))
    }))
    let Committed(x) = take done else {
        return false
    }
    if x.value != 400092 {
        return false
    }
    result.unwrap(durable(mut db, x.ticket))
    result.unwrap(close(take db))
    let (id, take page_record) = result.unwrap(read_page_manifest_file(dir))
    let mut lowered = take page_record
    lowered.limits = limits_to_rep(small_place_limits())
    result.unwrap(failure_result_from_rep(manifest.disk_publish_manifest(dir, store_key_to_rep(id), lowered)))
    match open(tasks, dir, c, r, options) {
        Error(Corrupt(_)) => true,
        _ => false,
    }
}

@test
fn journal_test_replay_over_limit(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_replay_over_limit(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L91 (E2): every zero-mutation shape (pure read, rejected guard Ok, absent
// delete, empty pop_first/pop_last, byte-equal cell_set, empty cell_clear,
// cell_set reverted to base, no-op trim_before, rolled-back error/overrun
// callbacks) writes 0 frames and 0 bytes, leaves version/follow unchanged,
// returns Done.info = None and exact Done.reads, while same-value put still
// writes a frame and W2 replays contiguously on reopen.
@test
fn journal_test_empty_commit_skip(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let dir = disk_test_directory(d)
    let mut options = journal_crash_options()
    let mut db = open(tasks, dir, c, r, options)?
    let mut decl = declare(db, Migrate)?
    let td = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = finish(mut decl, take td)?
    let etd = declare_table(mut decl, "empty_rows", std.codec.key_u64(), std.codec.of_u64())?
    let empty_rows = finish(mut decl, take etd)?
    let cell_h = declare_cell(mut decl, "flag", std.codec.of_u64())?
    let empty_cell = declare_cell(mut decl, "unset", std.codec.of_u64())?
    let log_h = declare_log(mut decl, "events", std.codec.of_u64(), Forever)?
    let schema_ticket = seal(mut db, take decl)?
    durable(mut db, schema_ticket)?
    let trunk = main_branch(db)
    let followed = follow(mut db, trunk)?
    let Committed(w1) = run(mut db, None, (copy_env(rows), copy_env(cell_h), copy_env(log_h)), fn(mut tx, e) -> Result[(), Error] {
        put(mut tx, e.0, 1u64, 100u64)?
        cell_set(mut tx, e.1, 42u64)?
        let _ = append(mut tx, e.2, 7u64)?
        Ok(())
    })? else {
        fail("L91 E2: W1 did not commit")
    }
    durable(mut db, w1.ticket)?
    let v1 = version(snapshot(db))
    let seq1 = db.frame_seq
    let end1 = file_end(db)
    let acct1 = accounts(db).journal
    let check_unchanged = scoped fn(take label: String, cur_db: Db, got_info: Option[CallInfo], got_ticket: Ticket) {
        if cur_db.frame_seq != seq1 || file_end(cur_db) != end1 || accounts(cur_db).journal != acct1 || version(snapshot(cur_db)) != v1 || version(latest.read(followed)) != v1 {
            fail(take label)
        }
        if let Some(_) = got_info {
            fail(take label)
        }
        let Journal(s, b, h) = got_ticket.mark else {
            fail(take label)
        }
        if s != seq1 || b != 0u32 || h != v1 {
            fail(take label)
        }
    }
    // 1. Pure read + exact Done.reads check.
    let Committed(r_pure) = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[Option[u64], Error] {
        fetch(tx, t, 1u64)
    })? else {
        fail("L91 E2: pure read failed")
    }
    if r_pure.value != Some(100u64) || list.len(r_pure.reads) != 1u64 {
        fail("L91 E2: pure read value or reads wrong")
    }
    let expected_key = failure_result_from_rep(catalog.logical_key(rows.id, types.key_word(1u64)))?
    match r_pure.reads[0u64] {
        Point(k) if k == expected_key => (),
        _ => fail("L91 E2: pure read Point mismatch"),
    }
    check_unchanged("L91 E2: pure read wrote a frame", db, r_pure.info, r_pure.ticket)
    durable(mut db, r_pure.ticket)?
    let pos = position(mut db, r_pure.ticket)?
    if pos.branch != 0u32 || pos.version != v1 {
        fail("L91 E2: skipped position mismatch")
    }
    // 2. Rejected guard returning Ok(false).
    let Committed(r_guard) = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[bool, Error] {
        if fetch(tx, t, 1u64)? == Some(100u64) {
            return Ok(false)
        }
        put(mut tx, t, 1u64, 999u64)?;
        Ok(true)
    })? else {
        fail("L91 E2: rejected guard failed")
    }
    if r_guard.value {
        fail("L91 E2: guard did not reject")
    }
    check_unchanged("L91 E2: rejected guard wrote a frame", db, r_guard.info, r_guard.ticket)
    // 3. Delete of absent key.
    let Committed(r_del) = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[bool, Error] {
        delete(mut tx, t, 999u64)
    })? else {
        fail("L91 E2: absent delete failed")
    }
    if r_del.value {
        fail("L91 E2: absent delete returned true")
    }
    check_unchanged("L91 E2: absent delete wrote a frame", db, r_del.info, r_del.ticket)
    // 4. pop_first and pop_last on empty table.
    let Committed(r_pop) = run(mut db, None, copy_env(empty_rows), fn(mut tx, t) -> Result[bool, Error] {
        let a = pop_first(mut tx, t)?
        let b = pop_last(mut tx, t)?
        Ok(a == None && b == None)
    })? else {
        fail("L91 E2: empty pop failed")
    }
    if !r_pop.value {
        fail("L91 E2: empty pop returned Some")
    }
    check_unchanged("L91 E2: empty pop wrote a frame", db, r_pop.info, r_pop.ticket)
    // 5. No-op cell_set, empty cell_clear, and reverted cell_set.
    let Committed(r_cell) = run(mut db, None, (copy_env(cell_h), copy_env(empty_cell)), fn(mut tx, e) -> Result[(), Error] {
        cell_set(mut tx, e.0, 42u64)?
        cell_clear(mut tx, e.1)?
        cell_set(mut tx, e.0, 99u64)?
        cell_set(mut tx, e.0, 42u64)
    })? else {
        fail("L91 E2: no-op cell failed")
    }
    check_unchanged("L91 E2: no-op/reverted cell wrote a frame", db, r_cell.info, r_cell.ticket)
    // 6. No-op trim_before at floor 0.
    let Committed(r_trim) = run(mut db, None, copy_env(log_h), fn(mut tx, l) -> Result[(), Error] {
        trim_before(mut tx, l, 0u64)
    })? else {
        fail("L91 E2: no-op trim failed")
    }
    check_unchanged("L91 E2: no-op trim wrote a frame", db, r_trim.info, r_trim.ticket)
    // 7. Rolled-back rollback_writes_on_error.
    let Committed(r_rb_err) = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        let _: Result[(), u64] = rollback_writes_on_error(mut tx, scoped fn(mut inner: Tx) -> Result[(), u64] {
            result.unwrap(put(mut inner, t, 50u64, 500u64))
            Error(1u64)
        })
        Ok(())
    })? else {
        fail("L91 E2: rolled-back error callback failed")
    }
    check_unchanged("L91 E2: rolled-back error callback wrote a frame", db, r_rb_err.info, r_rb_err.ticket)
    // 8. Rolled-back rollback_writes_on_overrun.
    let Committed(r_rb_over) = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        let _ = rollback_writes_on_overrun(mut tx, 50u64, scoped fn(mut inner: Tx) -> Result[(), ()] {
            result.unwrap(put(mut inner, t, 51u64, 501u64))
            let mut spin = 0u64
            while spin < 100000u64 {
                spin += 1u64
            }
            Ok(())
        })
        Ok(())
    })? else {
        fail("L91 E2: rolled-back overrun callback failed")
    }
    check_unchanged("L91 E2: rolled-back overrun callback wrote a frame", db, r_rb_over.info, r_rb_over.ticket)
    // Same-value put STILL writes a frame (§1.4).
    let Committed(r_same_put) = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 1u64, 100u64)
    })? else {
        fail("L91 E2: same-value put failed")
    }
    if db.frame_seq != seq1 + 1 || version(snapshot(db)) != v1 + 1 {
        fail("L91 E2: same-value put was skipped")
    }
    if let None = r_same_put.info {
        fail("L91 E2: same-value put returned None info")
    }
    // W2 commits contiguously at v1 + 2 and survives close + reopen.
    let Committed(w2) = run(mut db, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 2u64, 200u64)
    })? else {
        fail("L91 E2: W2 failed")
    }
    durable(mut db, w2.ticket)?
    close(take db)?
    options.create = false
    let mut reopened = open(tasks, dir, c, r, options)?
    let r_rows = table(mut reopened, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rd = reader(reopened, 0u64)?
    let snap = snapshot(reopened)
    if version(snap) != v1 + 2 || get(rd, snap, r_rows, 1u64)? != Some(100u64) || get(rd, snap, r_rows, 2u64)? != Some(200u64) || get(rd, snap, r_rows, 50u64)? != None {
        fail("L91 E2: reopen after skipped runs and W2 lost continuity")
    }
    close(take reopened)
}

// L91 (E3): calling info(mut tx) inside an Ok-returning run (including inside a
// rolled-back error or overrun callback) forces a 0-op COMMIT frame, advances
// head, keeps CallId/seed unique, and persists monotonic at across backward
// clock steps and reopen.
@test
fn journal_test_info_commits_and_clock_monotonic(d: Dir, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let dir = disk_test_directory(d)
    let (time, take hand) = provide.clock(0, 1000)
    let mut wall = take hand
    let mut options = journal_crash_options()
    let mut db = open(tasks, dir, time, r, options)?
    let Committed(first) = run(mut db, None, (), fn(mut tx, _env) -> Result[CallInfo, Error] {
        Ok(info(mut tx))
    })? else {
        fail("L91 E3: first info run failed")
    }
    let Some(ci1) = first.info else {
        fail("L91 E3: first info run returned None info")
    }
    if ci1.id.version != first.value.id.version || ci1.at != 1000 || ci1.seed != first.value.seed {
        fail("L91 E3: first info mismatch")
    }
    // Step clock backward to 900: second info run must advance head, distinct seed, at == 1000.
    clock.set_wall(mut wall, 900)
    let Committed(second) = run(mut db, None, (), fn(mut tx, _env) -> Result[CallInfo, Error] {
        Ok(info(mut tx))
    })? else {
        fail("L91 E3: second info run failed")
    }
    let Some(ci2) = second.info else {
        fail("L91 E3: second info run returned None info")
    }
    if ci2.id.version != ci1.id.version + 1 || ci2.seed == ci1.seed || ci2.at != 1000 {
        fail("L91 E3: second info did not preserve uniqueness or monotonic at")
    }
    // info(mut tx) called inside a rolled-back error callback still commits.
    let seq_before = db.frame_seq
    let Committed(third) = run(mut db, None, (), fn(mut tx, _env) -> Result[(), Error] {
        let _: Result[(), u64] = rollback_writes_on_error(mut tx, scoped fn(mut inner: Tx) -> Result[(), u64] {
            let _ = info(mut inner)
            Error(1u64)
        })
        Ok(())
    })? else {
        fail("L91 E3: inner-error info run failed")
    }
    let Some(ci3) = third.info else {
        fail("L91 E3: inner-error info run was skipped")
    }
    if db.frame_seq != seq_before + 1 || ci3.id.version != ci2.id.version + 1 {
        fail("L91 E3: inner-error info run did not write a frame")
    }
    // info(mut tx) called inside an overrunning callback still commits.
    let seq_before_over = db.frame_seq
    let Committed(fourth) = run(mut db, None, (), fn(mut tx, _env) -> Result[(), Error] {
        let _ = rollback_writes_on_overrun(mut tx, 50u64, scoped fn(mut inner: Tx) -> Result[(), ()] {
            let _ = info(mut inner)
            let mut spin = 0u64
            while spin < 100000u64 {
                spin += 1u64
            }
            Ok(())
        })
        Ok(())
    })? else {
        fail("L91 E3: inner-overrun info run failed")
    }
    let Some(ci4) = fourth.info else {
        fail("L91 E3: inner-overrun info run was skipped")
    }
    if db.frame_seq != seq_before_over + 1 || ci4.id.version != ci3.id.version + 1 {
        fail("L91 E3: inner-overrun info run did not write a frame")
    }
    durable(mut db, fourth.ticket)?
    close(take db)?
    // Reopen at clock 800: monotonic at == 1000 and version == ci4.id.version must survive.
    clock.set_wall(mut wall, 800)
    options.create = false
    let mut reopened = open(tasks, dir, time, r, options)?
    if version(snapshot(reopened)) != ci4.id.version || pages.holder_heads(reopened.holders)[0].at != 1000 {
        fail("L91 E3: reopen lost version or monotonic at")
    }
    close(take reopened)
}

fn cadence_frame(group: journal.GroupHead, send: Sender[journal.DirJournalMsg], ctx: format.DiskContext, number: u64) waits {
    let raw = journal_empty_commit(ctx, 72 + (number - 1) * 42, number)
    result.unwrap(journal.append_frame(group, send, take raw, number))
}

fn cadence_ack(acks: Receiver[journal.DirAck], synced: Receiver[()], number: u64) waits {
    result.unwrap(channel.receive(synced))
    match channel.try_receive(acks) {
        Ok(DirJournaled(last_number, written)) if last_number == number && written == number * 42 => (),
        _ => fail("L94: the notice did not follow the cumulative group ack"),
    }
    if let Error(Empty) = channel.try_receive(acks) {
        return
    }
    fail("L94: extra group ack")
}

fn cadence_stats(send: Sender[journal.DirJournalMsg]) -> journal.JournalStats waits {
    let (to, from): (Sender[journal.JournalStats], Receiver[journal.JournalStats]) = channel.new(1)
    result.unwrap(channel.send(send, ReadStats(take to)))
    result.unwrap(channel.receive(from))
}

fn cadence_wait(mut hand: ClockHand, due: Option[u64]) waits {
    if clock.idle(mut hand) != due {
        fail("L94: wrong pending deadline")
    }
}

@test
fn journal_coalesce_and_end_cadence(tasks: Tasks) -> Result[(), Error] waits {
    let (c, hand0) = provide.clock(0, 0)
    let mut hand = take hand0
    // A distant deadline keeps the simulated filesystem open when the worker
    // has no deadline. Otherwise quiescence ends the server's provide.next.
    let sentinel_at = 1000000000u64
    let mut sentinel = task.spawn(tasks, bytes 0, (c, sentinel_at), fn(take wait_for: (Clock, u64)) waits {
        host.sleep_until(wait_for.0, wait_for.1)
    })
    let (d, mount) = sim_disk_mount(tasks, c, std.sim.fs.new(), std.sim.world.plan(1), 1048576)
    let id = StoreId(hi: 1, lo: 2)
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 2, seq: 7)
    let mut creation = failure_result_from_rep(journal.disk_creation_block())?
    let (take segment, take end_file, take header) = failure_result_from_rep(journal.disk_new_segment(d, c, store_key_to_rep(id), 7, 0, mut creation))?
    let journal.DirJournalChannels(frames: take send, queued: take receive, acks: take acks, received: take received, ready: take ready, waiting: take waiting, written_send: take notices, written_receive: take written, synced_send: take synced_send, synced_receive: take synced) = journal.dir_journal_channels()
    let (returned, recycled): (Sender[Bytes], Receiver[Bytes]) = channel.new(1)
    let group = journal.group_head(4, 65536, header, c, take recycled)
    cadence_frame(group, send, ctx, 1)
    cadence_frame(group, send, ctx, 2)
    result.unwrap(journal.seal_group(group, send, true, EarlySync))
    let cadence_spec = journal.JournalCadence(end_groups: 3, end_interval_ms: 10)
    let input = journal.JournalWorker(store: store_key_to_rep(id), seq: 7, segment: take segment, end_file: take end_file, returned: take returned, group_bytes: 65536, clock: c, cadence: cadence_spec, zero_extension: true, receive: take receive, send: take acks, ready: take ready, written: take notices, synced: take synced_send)
    let worker = task.spawn(tasks, bytes journal.JOURNAL_WORKER_SLACK, take input, journal.journal_worker)
    failure_result_from_rep(types.capacity(result.unwrap(channel.receive(waiting))))?
    cadence_ack(received, synced, 2)
    cadence_wait(mut hand, Some(10000000u64))
    cadence_frame(group, send, ctx, 3)
    result.unwrap(journal.seal_group(group, send, true, EarlySync))
    cadence_ack(received, synced, 3)
    cadence_wait(mut hand, Some(10000000u64))
    if let Ok(_) = channel.try_receive(written) {
        fail("L94: a group answered a Barrier")
    }
    if failure_result_from_rep(journal.disk_end(d, store_key_to_rep(id), 7))? != Some(72u64) {
        fail("L94: END advanced before the time or count threshold")
    }
    let pending = cadence_stats(send)
    if pending.end_writes != 0 || pending.segment_writes != 2 || pending.frames != 3 {
        fail("L94: reading metrics must not force an END or count its pending write")
    }
    clock.advance_to(mut hand, 10000000)
    cadence_wait(mut hand, Some(sentinel_at))
    if failure_result_from_rep(journal.disk_end(d, store_key_to_rep(id), 7))? != Some(198u64) {
        fail("L94: END did not use the first group's deadline")
    }
    for number in 4u64 .. 7 {
        cadence_frame(group, send, ctx, number)
        result.unwrap(journal.seal_group(group, send, true, EarlySync))
        cadence_ack(received, synced, number)
    }
    cadence_wait(mut hand, Some(sentinel_at))
    if failure_result_from_rep(journal.disk_end(d, store_key_to_rep(id), 7))? != Some(324u64) {
        fail("L94: END did not advance on the group count")
    }
    let stats = cadence_stats(send)
    if stats.segment_writes != 5 || stats.window_writes != 0 || stats.frames != 6 || stats.frames_per_group[0] != 4 || stats.frames_per_group[1] != 1 || stats.group_early_sync != 5 || stats.end_writes != 2 || stats.end_deadline != 1 || stats.end_cap != 1 {
        fail("L94: metrics differ from the five durable groups and two END writes")
    }
    cadence_frame(group, send, ctx, 7)
    result.unwrap(journal.seal_group(group, send, true, EarlySync))
    cadence_ack(received, synced, 7)
    drop(take send)
    failure_result_from_rep(result.unwrap(task.join(take worker)))?
    cadence_wait(mut hand, Some(sentinel_at))
    if failure_result_from_rep(journal.disk_end(d, store_key_to_rep(id), 7))? != Some(366u64) {
        fail("L94: close did not write the final END with the clock held")
    }
    let reopened = journal_recover(d, id, 7, c, journal_initial())?
    if reopened.end != 366 || reopened.replay.state.tips[0].head != 7 {
        fail("L94: recovered journal lost or reordered a frame")
    }
    task.cancel(mut sentinel)
    let _ = task.join(take sentinel)
    let _ = sim_disk_unmount(take d, take mount)
    Ok(())
}

fn cadence_failed_write(tasks: Tasks, c: Clock, fail_end: bool) -> Result[(), Error] waits {
    let mut plan = std.sim.world.plan(1)
    // Segment creation consumes six calls before the first COMMIT and END.
    let fail_site = if fail_end {
        7u64
    } else {
        6u64
    }
    std.sim.world.script(mut plan, fail_site, Eio)
    let (d, mount) = sim_disk_mount(tasks, c, std.sim.fs.new(), take plan, 1048576)
    let id = StoreId(hi: 1, lo: 2)
    let mut creation = failure_result_from_rep(journal.disk_creation_block())?
    let (take segment, take end_file, take header) = failure_result_from_rep(journal.disk_new_segment(d, c, store_key_to_rep(id), 7, 0, mut creation))?
    let journal.DirJournalChannels(frames: take send, queued: take receive, acks: take acks, received: take received, ready: take ready, waiting: take waiting, written_send: take notices, written_receive: take written, synced_send: take synced_send, synced_receive: take synced) = journal.dir_journal_channels()
    let cadence_spec = journal.JournalCadence(end_groups: 1, end_interval_ms: 10)
    let (returned, recycled): (Sender[Bytes], Receiver[Bytes]) = channel.new(1)
    let group = journal.group_head(1, 65536, header, c, take recycled)
    let input = journal.JournalWorker(store: store_key_to_rep(id), seq: 7, segment: take segment, end_file: take end_file, returned: take returned, group_bytes: 65536, clock: c, cadence: cadence_spec, zero_extension: true, receive: take receive, send: take acks, ready: take ready, written: take notices, synced: take synced_send)
    cadence_frame(group, send, format.DiskContext(store: store_key_to_rep(id), role: 2, seq: 7), 1)
    let worker = task.spawn(tasks, bytes journal.JOURNAL_WORKER_SLACK, take input, journal.journal_worker)
    failure_result_from_rep(types.capacity(result.unwrap(channel.receive(waiting))))?
    if fail_end {
        match result.unwrap(channel.receive(received)) {
            DirJournaled(1, 42) => (),
            _ => fail("L94: END failure lost the durable COMMIT ack"),
        }
    }
    match result.unwrap(channel.receive(received)) {
        DirBroken(Other(5)) => (),
        _ => fail("L94: the failed write did not report Broken"),
    }
    match channel.try_receive(written) {
        Ok(WriteFailed(Other(5))) => (),
        _ => fail("L94: Broken preceded the write failure notice"),
    }
    result.unwrap(channel.receive(synced))
    match result.unwrap(task.join(take worker)) {
        Error(Io(Other(5))) => (),
        _ => fail("L94: the worker did not return its write failure"),
    }
    drop(take send)
    let mut segment_check = failure_result_from_rep(manifest.disk_io(host.open(d, failure_result_from_rep(manifest.journal_path(7, ""))?, Read)))?
    if !failure_result_from_rep(manifest.disk_io(host.try_lock_shared(mut segment_check)))? {
        fail("L94: a failed write kept the segment fence")
    }
    failure_result_from_rep(manifest.disk_io(host.close(take segment_check)))?
    // The sim fs leaves every sector of a refused Durable or Direct write
    // readable (STORE-SPEC §3.3b: a failed complete leaves the readable
    // subset visible). With no power cut, a refused END write therefore
    // reads back, naming the COMMIT that was acknowledged before it, and
    // recovery reads the COMMIT whole even when its own write failed. A
    // refused COMMIT write is never followed by an END write.
    let end = if fail_end {
        114u64
    } else {
        72u64
    }
    if failure_result_from_rep(journal.disk_end(d, store_key_to_rep(id), 7))? != Some(end) {
        fail("L94: END after a failed write is not the one the failure left readable")
    }
    let recovered = journal_recover(d, id, 7, c, journal_initial())?
    if recovered.end != 114 || recovered.replay.state.tips[0].head != 1 {
        fail("L94: recovery disagreed with the readable COMMIT after a failed write")
    }
    let _ = sim_disk_unmount(take d, take mount)
    Ok(())
}

fn journal_crash_cadence(scenario: View[String]) -> (String, journal.JournalCadence) {
    if scenario == "journal-group-cadence" {
        ("journal-group", journal.DIRECTORY_JOURNAL_CADENCE)
    } else if scenario == "journal-rotate-cadence" {
        ("journal-rotate", journal.DIRECTORY_JOURNAL_CADENCE)
    } else {
        (clone(scenario), JOURNAL_IMMEDIATE_CADENCE)
    }
}

@test
fn journal_cadence_failed_writes(tasks: Tasks) -> Result[(), Error] waits {
    let (c, hand) = provide.clock(0, 0)
    cadence_failed_write(tasks, c, false)?
    cadence_failed_write(tasks, c, true)?
    if host.mono_ns(c) != 0 {
        fail("L94: failure cleanup advanced the clock")
    }
    drop(take hand)
    Ok(())
}

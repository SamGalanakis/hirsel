// L88 (h), Cold half (§13.6 compaction, §13.6a T8 step 7): a Tiered pack
// whose live bytes fall below the ratio is probed one PACK_INDEX row per
// cut, every match moves to a fresh pack, and the pack retires when the
// probe ends. The oracle walks the published tree frame by frame from the
// pack files, independently of the store's location records.

type CompactWalk {
    // pack -> payload bytes of the reachable frames it holds.
    live: Map[u64, u64],
    // stamp -> (pack, offset): one location per stamp.
    places: Map[u64, (u64, u64)]
}

fn compact_walk_frame(d: Dir, db: Db, ptr: std.page.PagePtr, mut walk: CompactWalk) -> Result[(), Error] waits {
    if let Some(seen) = map.get(walk.places, ptr.stamp) {
        if seen != (ptr.pack, ptr.offset) {
            fail("L88 (h): one stamp is reached at two locations")
        }
        return Ok(())
    }
    map.insert(mut walk.places, ptr.stamp, (ptr.pack, ptr.offset))
    let width: u64 = int.widen(ptr.len)
    map.update_or_insert(mut walk.live, ptr.pack, 0, fn(mut total: u64) {
        total += width
    })
    let path = paged_pack_path(ptr.pack)?
    let wire = disk_read_file(d, path, 4194304)?
    let frame = read_tiered_frame(path, db.store, TieredPage(ptr), wire, 0, stamp_after(db.next_node)?)?
    let page = fold_page(frame)
    let image = std.page.image_of(page)
    for slot in 0u64 .. std.page.count(image) {
        if let Some(ColdPage(child)) = std.page.child_slot(page, slot) {
            compact_walk_frame(d, db, child, mut walk)?
        } else if let Some(BlobEdge(body)) = std.page.owning_edge(image, slot) {
            compact_walk_blob(d, db, body, mut walk)?
        }
    }
    Ok(())
}

// A BLOB frame's payload is its 8-byte length word and the value (§13.8).
fn compact_walk_blob(d: Dir, db: Db, body: std.page.BlobRef, mut walk: CompactWalk) -> Result[(), Error] waits {
    if let Some(seen) = map.get(walk.places, body.stamp) {
        if seen != (body.pack, body.offset) {
            fail("L88 (h): one BLOB stamp is reached at two locations")
        }
        return Ok(())
    }
    map.insert(mut walk.places, body.stamp, (body.pack, body.offset))
    let width = 8 + body.len
    map.update_or_insert(mut walk.live, body.pack, 0, fn(mut total: u64) {
        total += width
    })
    let path = paged_pack_path(body.pack)?
    let wire = disk_read_file(d, path, 4194304)?
    let _ = read_tiered_frame(path, db.store, TieredBlob(body), wire, 0, stamp_after(db.next_node)?)?
    Ok(())
}

fn compact_walk(d: Dir, db: Db, collection: u32) -> Result[CompactWalk, Error] waits {
    let id = prefix(collection)?
    let Some((ColdPage(root), _)) = std.page.collection_slot(db.heads[0u64].roots.collections.root, id) else {
        fail("L88 (h): each cut leaves the Log root Cold")
    }
    compact_walk_from(d, db, root)
}

fn compact_walk_from(d: Dir, db: Db, root: std.page.PagePtr) -> Result[CompactWalk, Error] waits {
    let mut walk = CompactWalk(live: map.new(), places: map.new())
    compact_walk_frame(d, db, root, mut walk)?
    Ok(take walk)
}

fn compact_entry(seq: u64) -> Bytes {
    let mut body: Bytes = list.with_capacity(48)
    list.fill(mut body, 48, int.truncate(seq))
    take body
}

fn compact_check_rows(r: Reader, s: Snapshot, events: Log[Bytes], floor_seq: u64) -> Result[(), Error] waits {
    for seq in 0u64 .. 120 {
        let wanted: Option[Bytes] = if seq < floor_seq { None } else { Some(compact_entry(seq)) }
        if log_get(r, s, events, seq)? != wanted {
            fail("L88 (h): every acknowledged entry reads back, and none below the floor")
        }
    }
    Ok(())
}

fn compact_listed(db: Db, seq: u64) -> bool {
    match disk_index_get(disk_state(db).pages.locations.packs, seq) {
        Some(_) => true,
        None => false,
    }
}

fn compact_dead_pack(db: Db) -> bool {
    let mut inventory = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    while let Some((_, listed)) = std.omap.next(mut inventory) {
        if listed.class >= 3 && listed.live == 0 {
            return true
        }
    }
    false
}

@test
fn test_l88_compaction_retires_a_cold_pack(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let events = l87_cold_log(d, c, r, tasks, floor, 120, 48)?
    let mut options = l70_open_options(floor)?
    options.probe_budget = 1
    options.compact_permille = 900
    let mut db = open(tasks, d, c, r, options)?
    let (leaf, floor_seq) = l87_first_leaf(d, db, events.binding.id)?
    let probed = leaf.pack
    // The trim detaches the first leaf; its cut drains the queue row and
    // kills the leaf and the replaced root in the probed pack.
    let trimmed: Log[Bytes] = clone(events)
    let Committed(_) = run(mut db, Some(100000), copy_env((trimmed, floor_seq)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L88 (h): the trim commits")
    }
    let _ = checkpoint(mut db)?
    let frames: u64 = match disk_index_get(disk_state(db).pages.locations.packs, probed) {
        Some(pack) => int.widen(pack.frames),
        None => fail("L88 (h): the probed pack is still listed after the trim"),
    }
    let before = snapshot(db)
    let mut cuts = 0u64
    while compact_listed(db, probed) {
        if cuts == 64 {
            fail("L88 (h): the probe ends")
        }
        let _ = checkpoint(mut db)?
        cuts += 1
        // Every cut, the published tree reaches each frame once, never in a
        // pack the inventory no longer lists.
        let walk = compact_walk(d, db, events.binding.id)?
        for (seq, _) in walk.live {
            if !compact_listed(db, seq) || !disk_exists(d, paged_pack_path(seq)?)? {
                fail("L88 (h): a reachable frame lives in a listed pack on disk")
            }
        }
    }
    // A budget of one row per cut walks the pack's index one frame a cut.
    if cuts < frames {
        fail("L88 (h): the probe walks at most probe_budget rows per cut")
    }
    let walk = compact_walk(d, db, events.binding.id)?
    if map.contains(walk.live, probed) {
        fail("L88 (h): the retired pack holds no reachable frame")
    }
    // Each listed Tiered pack's live bytes are exactly the frames the tree
    // reaches in it: a move kills each old ancestor once.
    let mut inventory = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    while let Some((seq, listed)) = std.omap.next(mut inventory) {
        if listed.class == 3 && listed.live != map.get_or(walk.live, seq, 0) {
            fail("L88 (h): a Tiered pack's live bytes are its reachable frames")
        }
    }
    // A Snapshot taken before the probe still reads through the retired pack,
    // and further cuts keep its file while the Snapshot lives. They also
    // retire, with no match to move, each pack the first moves left dead.
    let mut idle = 0u64
    while idle < 3 || compact_dead_pack(db) {
        if idle == 16 {
            fail("L88 (h): a dead Tiered pack retires")
        }
        let _ = checkpoint(mut db)?
        idle += 1
        if !disk_exists(d, paged_pack_path(probed)?)? {
            fail("L88 (h): a Snapshot that lists the retired pack keeps its file")
        }
    }
    let settled = compact_walk(d, db, events.binding.id)?
    let mut packs_after = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    while let Some((seq, listed)) = std.omap.next(mut packs_after) {
        if listed.class == 3 && listed.live != map.get_or(settled.live, seq, 0) {
            fail("L88 (h): live bytes stay the reachable frames after the dead packs retire")
        }
    }
    {
        let read_handle = reader(db, VALUE_LIMIT + 1048576)?
        compact_check_rows(read_handle, before, events, floor_seq)?
        compact_check_rows(read_handle, snapshot(db), events, floor_seq)?
        drop(take read_handle)
    }
    drop(take before)
    let _ = checkpoint(mut db)?
    if disk_exists(d, paged_pack_path(probed)?)? {
        fail("L88 (h): the cut after the last reader removes the retired file")
    }
    close(take db)?
    let mut reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    let again = reader(reopened, VALUE_LIMIT + 1048576)?
    compact_check_rows(again, snapshot(reopened), events, floor_seq)?
    drop(take again)
    close(take reopened)
}

fn compact_value(key: u64, edit: u8) -> Bytes {
    compact_value_of(key, edit, 48)
}

fn compact_value_of(key: u64, edit: u8, width: u64) -> Bytes {
    let mut body: Bytes = list.with_capacity(width)
    let low: u8 = int.truncate(key)
    list.fill(mut body, width, low ^ edit)
    take body
}

// `row_count` rows of 48 bytes in a Tiered table whose multi-leaf tree the cut
// emits Cold into one class-3 pack.
fn compact_cold_table(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64, row_count: u64) -> Result[Table[u64, Bytes], Error] waits {
    compact_cold_table_of(d, c, r, tasks, floor, row_count, 48)
}

fn compact_cold_table_of(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64, row_count: u64, width: u64) -> Result[Table[u64, Bytes], Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let _ = create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_bytes()))?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let fixture: Table[u64, Bytes] = clone(rows)
    let Committed(_) = run(mut db, None, copy_env((fixture, row_count, width)), fn(mut tx: Tx, env: (Table[u64, Bytes], u64, u64)) -> Result[(), Error] {
        for key in 0u64 .. env.1 {
            put(mut tx, env.0, key, compact_value_of(key, 0, env.2))?
        }
        Ok(())
    })? else {
        fail("L87 (b): fixture puts did not commit")
    }
    let id = prefix(rows.id)?
    let mut tree = share_page_tree(db.heads[0u64].roots.collections)
    let (take root, take descriptor) = {
        let Some((here, before)) = std.page.collection_entry(tree.root, id) else {
            fail("L87 (b): the fixture has no table")
        }
        (arc.share(here), rooted_collection_record(here, before[52u64], 1)?)
    }
    if std.page.level(std.page.image_of(root)) == 0 {
        fail("L87 (b): the fixture table must span more than one leaf")
    }
    let mut draw = stamp_after(db.next_node)?
    let first = draw
    page_result(std.page.insert(mut tree.root, id, descriptor, Some(arc.share(root)), tree.inline, first, mut draw))?
    page_result(std.page.install_tiered_root(mut tree.root, id, HotPage(take root), mut draw))?
    db.heads[0u64].roots.collections = take tree
    db.next_node = draw - 1
    let _ = checkpoint(mut db)?
    close(take db)?
    Ok(rows)
}

fn compact_branch_rows(db: Db, b: Branch, rows: Table[u64, Bytes], row_count: u64, edited: u64, edit: u8) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot_of(db, b)?
    for key in 0u64 .. row_count {
        let wanted = compact_value(key, if key == edited { edit } else { 0u8 })
        if get(read_handle, s, rows, key)? != Some(wanted) {
            fail("L87 (b): each branch reads its own rows through the moved paths")
        }
    }
    drop(take s)
    drop(take read_handle)
    Ok(())
}

fn compact_branch_root(db: Db, slot: u64, collection: u32) -> Result[std.page.PagePtr, Error] {
    match std.page.collection_slot(db.heads[slot].roots.collections.root, prefix(collection)?) {
        Some((ColdPage(located), _)) => Ok(located),
        _ => fail("L87 (b): each cut leaves every branch's root Cold"),
    }
}

// L87 (b), probe across a fork: cut 1 moves the first frames of pack P, a
// live-head fork `beta` follows, main edits a row, and later cuts finish
// the probe and retire P. Every move is installed in every root at its own
// cut, so `beta` never reaches P after it retires (seeded bug
// `probe_carries_paths`: cut 1's matches rewritten later on main only, so
// `beta` reads `Corrupt(Absent)`).
@test
fn test_l87_probe_across_a_fork(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let row_count = 160u64
    let rows = compact_cold_table(d, c, r, tasks, floor, row_count)?
    let mut options = l70_open_options(floor)?
    options.probe_budget = 2
    // Above 1000 every Tiered pack is selected, with no logical edit.
    options.compact_permille = 1001
    let mut db = open(tasks, d, c, r, options)?
    let probed = compact_branch_root(db, 0, rows.id)?.pack
    let _ = checkpoint(mut db)?
    if !compact_listed(db, probed) {
        fail("L87 (b): two rows do not finish the probe")
    }
    let mut at_fork = snapshot(db)
    let (beta, _) = fork(mut db, "beta", at_fork)?
    drop(take at_fork)
    let edited = 0u64
    let edit_handle: Table[u64, Bytes] = clone(rows)
    let Committed(_) = run(mut db, Some(100000), copy_env((edit_handle, edited)), fn(mut tx: Tx, env: (Table[u64, Bytes], u64)) -> Result[(), Error] {
        put(mut tx, env.0, env.1, compact_value(env.1, 7))
    })? else {
        fail("L87 (b): main's edit commits")
    }
    let mut cuts = 0u64
    while compact_listed(db, probed) {
        if cuts == 128 {
            fail("L87 (b): the probe ends")
        }
        let _ = checkpoint(mut db)?
        cuts += 1
    }
    // Two more cuts let the retired file go once no inventory lists it.
    let _ = checkpoint(mut db)?
    let _ = checkpoint(mut db)?
    if disk_exists(d, paged_pack_path(probed)?)? {
        fail("L87 (b): the retired pack's file is removed")
    }
    for slot in 0u64 .. list.len(db.heads) {
        let walk = compact_walk_from(d, db, compact_branch_root(db, slot, rows.id)?)?
        if map.contains(walk.live, probed) {
            fail("L87 (b): no branch reaches the retired pack")
        }
    }
    compact_branch_rows(db, main_branch(db), rows, row_count, edited, 7)?
    compact_branch_rows(db, beta, rows, row_count, edited, 0)?
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    let Some(beta_again) = branch(reopened, "beta") else {
        fail("L87 (b): beta survives reopen")
    }
    compact_branch_rows(reopened, main_branch(reopened), rows, row_count, edited, 7)?
    compact_branch_rows(reopened, beta_again, rows, row_count, edited, 0)?
    close(take reopened)
}

fn compact_blob_rows(db: Db, rows: Table[u64, Bytes], row_count: u64, width: u64) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    for key in 0u64 .. row_count {
        let wanted: Option[Bytes] = if key % 2 == 0 { None } else { Some(compact_value_of(key, 0, width)) }
        if get(read_handle, s, rows, key)? != wanted {
            fail("L88 (h): every kept row reads its BLOB back through the moved path")
        }
    }
    drop(take s)
    drop(take read_handle)
    Ok(())
}

fn compact_blob_pack(db: Db) -> Result[u64, Error] {
    let mut inventory = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    let mut found: Option[u64] = None
    while let Some((seq, listed)) = std.omap.next(mut inventory) {
        if listed.class == 4 {
            if found != None {
                fail("L88 (h): the fixture's cut lays its blobs out in one class-4 pack")
            }
            found = Some(seq)
        }
    }
    let Some(seq) = found else {
        fail("L88 (h): the fixture emits a class-4 pack")
    }
    Ok(seq)
}

// The published tree reaches each frame once, only in listed packs on disk.
// A pack's live bytes never fall below the frames the tree reaches in it; a
// probed pack still counts the old copies of moved targets until it retires,
// so the two are equal once no probe is running.
fn compact_check_published(d: Dir, db: Db, collection: u32) -> Result[(), Error] waits {
    let walk = compact_walk_from(d, db, compact_branch_root(db, 0, collection)?)?
    for (seq, _) in walk.live {
        if !compact_listed(db, seq) || !disk_exists(d, paged_pack_path(seq)?)? {
            fail("L88 (h): a reachable frame lives in a listed pack on disk")
        }
    }
    let idle = map.len(disk_state(db).pages.compaction.probes) == 0
    let mut inventory = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    while let Some((seq, listed)) = std.omap.next(mut inventory) {
        if listed.class < 3 {
            continue
        }
        let reached = map.get_or(walk.live, seq, 0)
        if listed.live < reached || (idle && listed.live != reached) {
            fail("L88 (h): a Tiered pack's live bytes are its reachable frames")
        }
    }
    Ok(())
}

// L88 (h), Cold half, class 4 (§13.6, §13.6a T8 step 7): every value is a
// 1,100-byte BLOB, so the cut lays them out in one class-4 pack B. Deleting
// every even row drains half of B dead, so B falls below the ratio. Its probe
// moves each matched BLOB with its stamp, and the leaf that names it is
// rewritten to the new location. When the probe ends, B retires: the
// independent walk of the published tree reaches no frame in B, each stamp at
// one location, and once no probe runs every listed Tiered pack's live bytes
// are exactly the frames the tree reaches in it.
@test
fn test_l88_compaction_relocates_blobs(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let row_count = 160u64
    let width = 1100u64
    let rows = compact_cold_table_of(d, c, r, tasks, floor, row_count, width)?
    let mut options = l70_open_options(floor)?
    options.probe_budget = 8
    options.compact_permille = 900
    let mut db = open(tasks, d, c, r, options)?
    let probed = compact_blob_pack(db)?
    let edit_handle: Table[u64, Bytes] = clone(rows)
    let Committed(_) = run(mut db, Some(10000000), copy_env((edit_handle, row_count)), fn(mut tx: Tx, env: (Table[u64, Bytes], u64)) -> Result[(), Error] {
        for key in 0u64 .. env.1 {
            if key % 2 == 0 {
                let _ = delete(mut tx, env.0, key)?
            }
        }
        Ok(())
    })? else {
        fail("L88 (h): the deletes commit")
    }
    let _ = checkpoint(mut db)?
    if !compact_listed(db, probed) {
        fail("L88 (h): the delete cut does not finish B's probe")
    }
    let before = snapshot(db)
    let mut cuts = 0u64
    while compact_listed(db, probed) || map.len(disk_state(db).pages.compaction.probes) != 0 {
        if cuts == 256 {
            fail("L88 (h): the class-4 probe ends")
        }
        let _ = checkpoint(mut db)?
        cuts += 1
        compact_check_published(d, db, rows.id)?
    }
    let walk = compact_walk_from(d, db, compact_branch_root(db, 0, rows.id)?)?
    if map.contains(walk.live, probed) {
        fail("L88 (h): the retired class-4 pack holds no reachable BLOB")
    }
    let mut moved_blobs = false
    for (seq, _) in walk.live {
        if let Some(listed) = disk_index_get(disk_state(db).pages.locations.packs, seq) {
            moved_blobs = moved_blobs || listed.class == 4
        }
    }
    if !moved_blobs {
        fail("L88 (h): the kept BLOBs move to a fresh class-4 pack")
    }
    compact_blob_rows(db, rows, row_count, width)?
    // The Snapshot taken before the probe still reads through B.
    {
        let read_handle = reader(db, VALUE_LIMIT + 1048576)?
        for key in 0u64 .. row_count {
            let wanted: Option[Bytes] = if key % 2 == 0 { None } else { Some(compact_value_of(key, 0, width)) }
            if get(read_handle, before, rows, key)? != wanted {
                fail("L88 (h): a Snapshot that lists the retired pack reads its BLOBs")
            }
        }
        drop(take read_handle)
    }
    if !disk_exists(d, paged_pack_path(probed)?)? {
        fail("L88 (h): a Snapshot that lists the retired pack keeps its file")
    }
    drop(take before)
    let _ = checkpoint(mut db)?
    let _ = checkpoint(mut db)?
    if disk_exists(d, paged_pack_path(probed)?)? {
        fail("L88 (h): the cut after the last reader removes the retired class-4 file")
    }
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    compact_blob_rows(reopened, rows, row_count, width)?
    close(take reopened)
}

fn compact_head_roots(db: Db) -> List[Roots] {
    let mut shares: List[Roots] = list.new()
    for head in db.heads {
        let held = head.roots
        list.push(mut shares, PageRoots(collections: share_page_tree(held.collections), streams: share_page_tree(held.streams), catalog: share_page_tree(held.catalog), keyed: share_keyed_pages(held.keyed)))
    }
    take shares
}

// §13.6a T3 is optional (AP16 item 3): a refused allocation in the
// compaction probes drops this cut's probe progress. Every root is the one
// the cut staged before the probes ran, the installed cursors stand and
// nothing retires, so the cut publishes its mandatory steps. The probes run
// under a rising allocation bound. Some bound refuses after a move was
// installed in a root (the stamp counter advanced), and there the roots
// still reach the original Cold root. A larger bound runs the probes to
// completion of the budget, and the next real cut publishes them.
@test
fn test_l88_refused_probe_publishes_mandatory_steps(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let row_count = 160u64
    let rows = compact_cold_table(d, c, r, tasks, floor, row_count)?
    let mut options = l70_open_options(floor)?
    options.probe_budget = 64
    options.compact_permille = 1001
    let mut db = open(tasks, d, c, r, options)?
    let original = compact_branch_root(db, 0, rows.id)?
    let id = prefix(rows.id)?
    let start = stamp_after(db.next_node)?
    let mut restored = 0u64
    let mut limit = 0u64
    loop {
        if limit > 67108864 {
            fail("L88 (h): the probes run under a large enough bound")
        }
        let mut roots = compact_head_roots(db)
        let mut stamp = start
        let pager: Option[View[Sender[TieredPagerMessage]]] = match db.pager {
            Some(requests) => Some(view requests),
            None => None,
        }
        let ran = bound bytes limit {
            compact_cut(db, pager, mut roots, list.new(), mut stamp)
        }
        let Ok(returned) = take ran else {
            fail("L88 (h): a refused probe returns its refusal rather than raising it")
        }
        // Before any probe runs, a refusal may also refuse the whole cut.
        let probed = match take returned {
            Ok(take ready) => take ready,
            Error(Full(Allocation(_))) => {
                if stamp != start {
                    fail("L88 (h): a refusal after a move skips the probes instead of failing the cut")
                }
                limit += 64
                continue
            },
            Error(take problem) => return Error(take problem),
        }
        let progressed = list.len(probed.retiring) != 0 || map.len(probed.probes) != 0
        if progressed {
            break
        }
        // The probes were refused. Each root is the one staged before them.
        let Some((ColdPage(kept), _)) = std.page.collection_slot(roots[0u64].collections.root, id) else {
            fail("L88 (h): a refused probe leaves no moved path in a root")
        }
        if kept != original || list.len(probed.moved) != 0 {
            fail("L88 (h): a refused probe restores the staged roots and charges no move")
        }
        if stamp > start {
            restored += 1
        }
        limit += 64
    }
    if restored == 0 {
        fail("L88 (h): some bound refuses the probes after a move was installed")
    }
    let _ = checkpoint(mut db)?
    if map.len(disk_state(db).pages.compaction.probes) == 0 && compact_listed(db, original.pack) {
        fail("L88 (h): an unbounded cut publishes the probes' progress")
    }
    compact_branch_rows(db, main_branch(db), rows, row_count, row_count, 0)?
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    compact_branch_rows(reopened, main_branch(reopened), rows, row_count, row_count, 0)?
    close(take reopened)
}

; Constructor refusals are explicitly unwrapped; callers clean their live prefixes.
; CoreIR sample, family: task custody (rt.spawn, rt.join, rt.check_cancel,
; rt.channel_new, rt.send, rt.try_send, abandoned handles). FORM v1a, CONC-3..9.
;
; Source (package samples@0, module custody):
;   i0  resource Tok { id: u64 }
;       type In { tok: Tok }
;       type Out { v: u64 }
;       fn work(take x: In) -> Out { check_cancel(); if x.tok.id == 0 { unwrap_failed() }; Out { v: x.tok.id + 1 } }
;       fn run(k: u64, n: u64) -> (u8, u64, u64)   ; spawn work with limit n, join it
;       fn abandon(k: u64) { let h = spawn(64, In { tok: mk(k) }, work) }
;       fn queue(a: u64, b: u64) { let (s, r) = channel(1); s.send(mk(a)); s.try_send(mk(b)) }
;       fn zero(c: u64) { let (s, r) = channel(c) }
;
; The task is charged at spawn: record 256, cause cell 32, result Out 8 and its limit n
; (CONC-3). A refused spawn returns null and the room left (0 on success); `x` is still
; the caller's. A spawned child takes `x` and cleans it on every exit. Join writes the
; result, or yields `Causes`: the child's chain, which owns the child's used cells until
; it is dropped (here inside a JoinError, Failed 0 | Cancelled 1). Dropping an unjoined
; handle cleans the result or the chain (CONC-8). A channel's queue is admitted whole at
; creation: channel(1, 8) = 72; capacity 0 is the failure Bounds. `try_send` that does
; not publish (1 Full, 2 Closed) leaves the item with the caller; dropping the receiver
; cleans what is still queued, last published first (CONC-9). Tok is charged 40.
; The test evaluator runs a child to its end at the spawn, so join and cancel never wait.
;
; Behaviour, derived by hand (trace: Tok ids in the order their cleanup started):
; run limit 1000: f2(7, 100) -> 0, 8, 0 | used 0 | trace 7       ; joined Ok
; run limit 1000: f2(0, 100) -> 1, 0, 0 | used 0 | trace 0       ; Failed; Causes dropped
; run limit 1000: f2(7, 700) -> 9, 0, 960 | used 0 | trace 7     ; 996 refused; x kept
; run: f3(0) -> | used 0 | trace 0                               ; abandoned, failed
; run: f3(5) -> | used 0 | trace 5                               ; abandoned, Ok
; run: f4(1, 2) -> | used 0 | trace 2, 1                         ; Full returns item 2
; run: f5(2) -> | used 0
; run: f5(0) -> fail Bounds | used 0
core v1
item i0 = samples@0/custody/run
type t0 = resource "Tok" { id: u64 }
type t1 = own "In" { tok: t0 }
type t2 = own "Out" { v: u64 }
type t3 = own "JoinError" | Failed { c: causes } | Cancelled { c: causes }
type t4 = own "Handle" { t: task }
type t5 = own "Ends" { s: sender, r: receiver }
sig g0 = (u64) -> (ptr)
sig g1 = (&t1) -> () dest t2
sig g2 = (u64, &t1, ptr) -> (ptr, u64)
sig g3 = (ptr, &t2) -> (u8, ptr)
sig g4 = () -> ()
sig g5 = (u64, u64) -> (u8, u64, u64)
sig g6 = (u64) -> ()
sig g7 = (u64) -> (ptr, ptr, u64)
sig g8 = (ptr, &t0) -> (bool)
sig g9 = (ptr, &t0) -> (u8)
sig g10 = (u64, u64) -> ()
inst n0 = samples@0/custody/mk [] []
inst n1 = samples@0/custody/work [] []
inst n2 = samples@0/custody/run [] []
inst n3 = samples@0/custody/abandon [] []
inst n4 = samples@0/custody/queue [] []
inst n5 = samples@0/custody/zero [] []
fn f0 = n0 g0 {
  addr a0 = v2 : t0
  addr a1 = a0 field 0 : u64
b0(v0: u64):
  v1: u64 = const 40
  v4: u64 = const 8
  v2: ptr, v3: u64 = alloc resource grant 0 v4 align 8 charge v1
  v5: ptr = const 0x0
  v6: bool = ne v2, v5
  branch v6, b1, b2
b1:
  address a0
  address a1
  store a1, v0
  return v2
b2:
  raise unwrap
}
fn f1 = n1 g1 {
  addr a0 = v1 : t1                    ; x, taken
  addr a1 = a0 field 0 deref field 0 : u64
  addr a2 = v0 : t2                    ; the destination
  addr a3 = a2 field 0 : u64
b0(v0: ptr, v1: ptr):
  address a0
  address a1
  address a2
  address a3
  call rt.check_cancel g4 () fail b3
  v2: u64 = read a1
  v3: u64 = const 0
  v4: bool = eq v2, v3
  branch v4, b1, b2
b1:
  raise unwrap cleanup b3
b2:
  v5: u64 = const 1
  v6: u64 = add v2, v5 fail b3
  store a3, v6
  drop a0 t1
  return
b3:
  drop a0 t1
  propagate
}
fn f2 = n2 g5 {
  slot s0 = t1                         ; x
  slot s1 = t2                         ; the joined result
  slot s2 = t3                         ; the JoinError
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 : t1
  addr a2 = s1 : t2
  addr a3 = s1 field 0 : u64
  addr a4 = s2 case 0 0 : ptr          ; Failed.c, where Cancelled.c also is
  addr a5 = s2 : t3
b0(v0: u64, v1: u64):
  live s0
  live s1
  live s2
  address a0
  address a1
  address a2
  address a3
  address a4
  address a5
  v2: ptr = call f0 g0 (v0)
  store a0, v2
  v3: ptr = fnref f1
  v4: ptr, v5: u64 = call rt.spawn[t1, t2] g2 (v1, &a1, v3)   ; spawn cannot fail
  v6: ptr = const 0x0
  v7: bool = eq v4, v6
  branch v7, b1, b2
b1:
  drop a1 t1                           ; refused: x is still the caller's
  v8: u8 = const 9
  v9: u64 = const 0
  return v8, v9, v5
b2:
  v10: u8, v11: ptr = call rt.join[t2] g3 (v4, &a2)
  switch v10 [0 -> b3, 1 -> b4] else b5
b3:
  v12: u64 = read a3
  return v10, v12, v5
b4:
  set_case a5, 0                       ; Failed
  jump b6
b5:
  set_case a5, 1                       ; Cancelled
  jump b6
b6:
  store a4, v11
  drop a5 t3                           ; the Causes refunds the child's used cells
  v13: u64 = const 0
  return v10, v13, v5
}
fn f3 = n3 g6 {
  slot s0 = t1                         ; x
  slot s1 = t4                         ; h
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 : t1
  addr a2 = s1 field 0 : ptr
  addr a3 = s1 : t4
b0(v0: u64):
  live s0
  live s1
  address a0
  address a1
  address a2
  address a3
  v1: ptr = call f0 g0 (v0)
  store a0, v1
  v2: ptr = fnref f1
  v3: u64 = const 64
  v4: ptr, v5: u64 = call rt.spawn[t1, t2] g2 (v3, &a1, v2)
  v6: ptr = const 0x0
  v7: bool = eq v4, v6
  branch v7, b1, b2
b1:
  drop a1 t1
  return
b2:
  store a2, v4
  drop a3 t4                           ; abandoned: clean the result or the chain
  dead s1
  dead s0
  return
}
fn f4 = n4 g10 {
  slot s0 = t0                         ; item a
  slot s1 = t0                         ; item b
  slot s2 = t5                         ; the two ends
  addr a0 = s0 : ptr
  addr a1 = s0 : t0
  addr a2 = s1 : ptr
  addr a3 = s1 : t0
  addr a4 = s2 field 0 : ptr
  addr a5 = s2 field 1 : ptr
  addr a6 = s2 : t5
b0(v0: u64, v1: u64):
  live s0
  live s1
  live s2
  address a0
  address a1
  address a2
  address a3
  address a4
  address a5
  address a6
  v2: u64 = const 1
  v3: ptr, v4: ptr, v5: u64 = call rt.channel_new[t0] g7 (v2)
  v6: ptr = const 0x0
  v7: bool = eq v3, v6
  branch v7, b8, b1
b1:
  store a4, v3
  store a5, v4
  v8: ptr = call f0 g0 (v0) fail b6
  store a0, v8
  v9: bool = call rt.send[t0] g8 (v3, &a1) fail b7
  branch v9, b3, b2
b2:
  drop a1 t0                           ; closed: a is still the caller's
  jump b3
b3:
  v10: ptr = call f0 g0 (v1) fail b6
  store a2, v10
  v11: u8 = call rt.try_send[t0] g9 (v3, &a3)   ; try_send cannot fail
  v12: u8 = const 0
  v13: bool = eq v11, v12
  branch v13, b5, b4
b4:
  drop a3 t0                           ; Full or Closed: b is still the caller's
  drop a6 t5
  return
b5:
  drop a6 t5                           ; the receiver cleans what is queued
  return
b6:
  drop a6 t5
  propagate
b7:
  drop a1 t0
  drop a6 t5
  propagate
b8:
  return                               ; refused: nothing was made
}
fn f5 = n5 g6 {
  slot s0 = t5
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 1 : ptr
  addr a2 = s0 : t5
b0(v0: u64):
  live s0
  address a0
  address a1
  address a2
  v1: ptr, v2: ptr, v3: u64 = call rt.channel_new[t0] g7 (v0)
  v4: ptr = const 0x0
  v5: bool = eq v1, v4
  branch v5, b1, b2
b1:

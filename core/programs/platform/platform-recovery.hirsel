pub type Binding: codec + send {
    identity: Bytes,
    n_place: u64
}

pub type Recovery: codec + send = Unmatched(launcher.Attempt, u64, Bytes, Option[u64]) | Adopted(launcher.Attempt, u64, Bytes)

fn put_activation(k: (u64, u64), mut out: Bytes) {
    std.codec.put_key_u64(k.0, mut out)
    std.codec.put_key_u64(k.1, mut out)
}

fn take_activation(raw: Bytes, mut at: u64) -> Result[(u64, u64), std.codec.DecodeError] {
    let incarnation = std.codec.take_key_u64(raw, mut at)?
    let activation = std.codec.take_key_u64(raw, mut at)?
    Ok((incarnation, activation))
}

fn activation_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 2u64)?
    std.codec.schema_u64(mut s)
    std.codec.schema_u64(mut s)
    Ok(())
}

fn activation_key() -> std.codec.Key[(u64, u64)] {
    std.codec.key_make(code.describe(put_activation), code.describe(take_activation), code.describe(activation_schema))
}

fn status_text(s: launcher.Status) -> String {
    let mut out = string.new()
    match s {
        Code(c) => {
            string.push(mut out, "exit status ");
            string.push_i64(mut out, int.widen(c))
        },
        Signal(n) => {
            string.push(mut out, "killed by signal ");
            string.push_i64(mut out, int.widen(n))
        },
    }
    out
}

fn not_current(found: u64, selected: u64) -> String {
    let mut out = string.from("NotCurrent: the store is at activation ")
    string.push_uint(mut out, found, 10u32, 1u64, '0')
    string.push(mut out, "; this start requested ")
    string.push_uint(mut out, selected, 10u32, 1u64, '0')
    out
}

fn start_current(found: u64, selected: launcher.Selection) -> String {
    if found != selected.activation {
        return not_current(found, selected.activation)
    }
    let mut out = string.from("NotCurrent: the store's release identity at activation ")
    string.push_uint(mut out, found, 10u32, 1u64, '0')
    string.push(mut out, " is not that of assembly ")
    string.push(mut out, std.hex.encode(selected.assembly))
    string.push(mut out, ", which this start ran")
    take out
}

// Record the first accepted PlaceOpened before any decision that depends on the store.
fn record_store(mut h: Host, name: String, incarnation: u64, ready: runner.PlaceReady, authoritative: bool, gen: u64, claim: Option[(u64, Bytes)], accepting_restore: bool) -> Result[(), Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(authoritative), store.copy_env(incarnation), store.copy_env(name), store.copy_env(ready), store.copy_env(t), store.copy_env(gen), store.copy_env(claim), store.copy_env(accepting_restore)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found) = st(store.fetch(tx, call_env.4 .groups, call_env.2))? else {
                return Error(Unknown)
            }
            if found.incarnation != call_env.1 {
                return Error(Unknown)
            }
            if call_env.7 {
                let Some(saved) = st(store.fetch(tx, call_env.4 .restored_groups, found.incarnation))? else {
                    return Error(Unknown)
                }
                let mut intent = saved
                intent.accepted = true
                intent.activation = call_env.3 .version
                st(store.put(mut tx, call_env.4 .restored_groups, found.incarnation, intent))?
            }
            let mut g = found
            g.store_id = Some((call_env.3 .store_hi, call_env.3 .store_lo))
            if let Some(pair) = call_env.6 {
                let newest = match g.store_claim {
                    Some((stored_gen, _)) => stored_gen <= call_env.5,
                    None => true
                }
                if newest {
                    g.store_claim = Some((call_env.5, clone(pair)))
                }
            }
            if call_env.0 && g.activation == 0u64 {
                g.activation = call_env.3 .version
            }
            if call_env.0 && g.activation == call_env.3 .version {
                g.recovery = None
                if g.activation != 0u64 && list.len(g.assembly) != 0u64 {
                    index_release(mut tx, call_env.4, g, g.activation, g.assembly)?
                }
            }
            st(store.put(mut tx, call_env.4 .groups, call_env.2, g))
        })
    }
    decided(mut h, take made)
}

fn binding_of(description: runner.Describe) -> Option[Binding] {
    match runner.identity_digest(description) {
        Ok(take identity) => Some(Binding(identity: take identity, n_place: description.n_place)),
        Error(_) => None,
    }
}

fn read_place(raw: Bytes) -> Option[runner.PlaceRead] {
    let codec: std.codec.Codec[runner.PlaceRead] = std.codec.of()
    match std.codec.decode(codec, raw) {
        Ok(take read) => Some(take read),
        Error(_) => None,
    }
}

fn opened_claim(ready: runner.PlaceReady) -> Option[(u64, Bytes)] {
    let Some(take read) = read_place(ready.read) else {
        return None
    }
    let runner.PlaceRead(claim: take claim, ..) = take read
    match take claim {
        Some(runner.PlaceClaim(epoch, holder: take holder, ..)) => Some((epoch, take holder)),
        None => None,
    }
}

fn deposed_text(epoch: u64, holder: Bytes) -> String {
    let mut out = string.from("Deposed at epoch ")
    string.push_uint(mut out, epoch, 10u32, 1u64, '0')
    if list.len(holder) != 0u64 {
        string.push(mut out, " holder ")
        string.push(mut out, std.hex.encode(holder))
    }
    take out
}

// RUNNER-SPEC §14.6: a Deposed run parks its assignment. Its end starts no
// §14.5 retry, arrivals and ticks start nothing while the row is failing, and
// only an operator wake launches it again.
fn park_deposed(mut h: Host, name: String, epoch: u64, holder: Bytes) {
    let mut v = vol_read(h, name)
    let why = deposed_text(epoch, holder)
    v.deposed = Some((epoch, clone(holder)))
    v.cause = Some(clone(why))
    v.last = take why
    v.failing = true
    v.retry_at = None
    vol_put(mut h, name, take v)
}

// The end of a parked Deposed run (park_deposed): no §14.5 retry, no reprobe.
fn end_deposed(mut h: Host, name: String, take v: Vol) {
    let mut w = take v
    w.retry_at = None
    w.reprobe = false
    w.failing = true
    vol_put(mut h, name, take w)
}

// A cutover OLD answered Drift (its store moved past the export), or a deposed
// runner's end: both conflict with the store's state. Any other refusal is OLD's
// diagnostic of an invalid import.
fn abort_class(why: String) -> operator.Class {
    if why == "drift" || string.starts_with(why, "Deposed ") {
        ConflictClass
    } else {
        InvalidClass
    }
}

fn has_new_claim(g: GroupRow, gen: u64, incoming: Option[(u64, Bytes)]) -> bool {
    match incoming {
        Some(pair) => match g.store_claim {
            Some((old_gen, old)) => gen > old_gen || (gen == old_gen && old != pair),
            None => true,
        },
        None => false,
    }
}

fn claim_for_generation(g: GroupRow, gen: u64) -> Option[(u64, Bytes)] {
    match g.store_claim {
        Some((stored_gen, pair)) if stored_gen == gen => Some(clone(pair)),
        _ => None,
    }
}

fn absence_is_final(opened: bool, read: runner.PlaceRead, old_claim: Option[(u64, Bytes)]) -> bool {
    if opened || read.witness_present {
        return true
    }
    match read.claim {
        None => true,
        Some(runner.PlaceClaim(epoch, holder, ..)) => match old_claim {
            Some(old) => old.0 != epoch || old.1 != holder,
            None => false,
        },
    }
}

fn opens_cutover(h: Host, name: String, ready: runner.PlaceReady) -> bool waits {
    let Some(read) = read_place(ready.read) else {
        return false
    }
    match store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.deploys, name) {
        Ok(Some(d)) => list.len(d.digest) == 32u64 && read.prepared == d.digest,
        _ => false,
    }
}

fn retains(g: GroupRow, assembly: Bytes) -> bool {
    for root in g.retained {
        if root == assembly {
            return true
        }
    }
    false
}

fn roots_release(g: GroupRow, assembly: Bytes) -> bool {
    g.assembly == assembly || retains(g, assembly)
}

fn retain_release(mut g: GroupRow, assembly: Bytes) {
    if !roots_release(g, assembly) {
        list.push(mut g.retained, clone(assembly))
    }
}

fn drop_retained(mut g: GroupRow, assembly: Bytes) {
    for i in 0u64 .. list.len(g.retained) {
        if g.retained[i] == assembly {
            let _ = list.remove(mut g.retained, i)
            return
        }
    }
}

fn index_release(mut tx: store.Tx, t: Tables, g: GroupRow, activation: u64, assembly: Bytes) -> Result[(), Refused] {
    st(store.put(mut tx, t.activations, (g.incarnation, activation), assembly))
}

// Apply the Roots rule to the two records from this attempt. Any unrelated
// retained release keeps its existing root, including NEW if it predated this attempt.
fn select_release(mut tx: store.Tx, t: Tables, mut g: GroupRow, d: DeployRow, activation: u64, new: bool, installed: bool) -> Result[(), Refused] {
    g.assembly = if new {
        clone(d.assembly)
    } else {
        clone(d.old_assembly)
    }
    g.activation = activation
    // NEW's source becomes the installed manifest, which roots its blobs.
    if new {
        g.source = installed_source(tx, t, d.request)?
    }
    let active: Bytes = clone(g.assembly)
    drop_retained(mut g, active)
    if new {
        retain_release(mut g, d.old_assembly)
    } else if installed {
        retain_release(mut g, d.assembly)
    } else if !d.new_retained {
        drop_retained(mut g, d.assembly)
    }
    index_release(mut tx, t, g, activation, g.assembly)
}

fn matches_binding(candidate: Option[Binding], identity: Bytes) -> bool {
    match candidate {
        Some(binding) => binding.identity == identity,
        None => false
    }
}

fn pick_release(g: GroupRow, d: DeployRow, read: runner.PlaceRead, installed: bool, adopting: bool) -> Option[bool] {
    let old = (!adopting || roots_release(g, d.old_assembly)) && matches_binding(d.old_binding, read.binding)
    let new = (!adopting || roots_release(g, d.assembly)) && matches_binding(d.binding, read.binding)
    if old && new {
        Some(installed)
    } else if new {
        Some(true)
    } else if old {
        Some(false)
    } else {
        None
    }
}

fn recovery_attempt(mark: Recovery) -> launcher.Attempt {
    match mark {
        Unmatched(attempt, _, _, _) => attempt,
        Adopted(attempt, _, _) => attempt
    }
}

fn report_recovery(mut h: Host, name: String, gen: u64, version: u64, selected: launcher.Selection, raw: Bytes, opened: bool) waits {
    if opened {
        let mut v = vol_read(h, name)
        v.failing = false
        vol_put(mut h, name, take v)
    }
    let Some(read) = read_place(raw) else {
        return
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(gen), store.copy_env(name), store.copy_env(opened), store.copy_env(selected), store.copy_env(version), store.copy_env(read), store.copy_env(t)), fn(mut tx, call_env) -> Result[bool, Refused] {
            let Some(w) = st(store.fetch(tx, call_env.6 .wake, call_env.1))? else {
                return Ok(false)
            }
            let Dirty(active) = w.wake else {
                return Ok(false)
            }
            if call_env.0 != active {
                return Ok(false)
            }
            let Some(found) = st(store.fetch(tx, call_env.6 .groups, call_env.1))? else {
                return Ok(false)
            }
            let Some(deploy) = st(store.fetch(tx, call_env.6 .deploys, call_env.1))? else {
                return Ok(false)
            }
            let mut g = found
            let mut d = deploy
            if let Some(_) = g.retiring {
                return Ok(false)
            }
            if g.store_id != Some((call_env.5 .store_hi, call_env.5 .store_lo)) {
                return Ok(false)
            }
            let mark = Unmatched(d.attempt, call_env.4, clone(call_env.5 .binding), call_env.5 .n_place)
            match d.outcome {
                Undecided(probe) => {
                    if !absence_is_final(call_env.2, call_env.5, d.old_claim) {
                        if let ProbeNew = probe {
                            d.outcome = Undecided(ProbeOld)
                            put_deploy(mut tx, call_env.6, call_env.1, d, StoreClass)?
                            return Ok(true)
                        }
                        return Ok(false)
                    }
                    let installed = call_env.5 .prepared == d.digest && list.len(d.digest) == 32u64
                    if installed {
                        index_release(mut tx, call_env.6, g, d.activation, d.assembly)?
                    }
                    let picked = if call_env.2 {
                        Some(call_env.3 .assembly == d.assembly)
                    } else {
                        pick_release(g, d, call_env.5, installed, false)
                    }
                    if let Some(new) = picked {
                        select_release(mut tx, call_env.6, mut g, d, call_env.4, new, installed)?
                        g.recovery = None
                    } else {
                        retain_release(mut g, d.assembly)
                        g.recovery = Some(take mark)
                    }
                    st(store.put(mut tx, call_env.6 .groups, call_env.1, g))?
                    if installed {
                        d.outcome = Installed
                        put_deploy(mut tx, call_env.6, call_env.1, d, StoreClass)?
                    } else {
                        d.outcome = Failed("not installed after recovery")
                        put_deploy(mut tx, call_env.6, call_env.1, d, NotInstalledClass)?
                    }
                    Ok(!call_env.2 && !is_none(picked))
                },
                _ => {
                    if call_env.2 {
                        return Ok(false)
                    }
                    let installed = match d.outcome {
                        Installed => true,
                        Failed(_) => false,
                        _ => return Ok(false),
                    }
                    let recovery: Option[Recovery] = clone(g.recovery)
                    let Some(prior) = take recovery else {
                        return Ok(false)
                    }
                    if !same_attempt(recovery_attempt(prior), d.attempt) {
                        return Ok(false)
                    }
                    if let Some(new) = pick_release(g, d, call_env.5, installed, true) {
                        let assembly = if new {
                            view d.assembly
                        } else {
                            view d.old_assembly
                        }
                        if g.activation == call_env.4 && g.assembly == assembly {
                            // A replay before the end's acknowledgement still finishes the
                            // adoption that this start already committed.
                            return Ok(match prior {
                                Adopted(_, _, _) => call_env.3 .activation != call_env.4 || call_env.3 .assembly != assembly,
                                Unmatched(_, _, _, _) => false,
                            })
                        }
                        select_release(mut tx, call_env.6, mut g, d, call_env.4, new, installed)?
                        g.recovery = Some(Adopted(d.attempt, call_env.4, clone(g.assembly)))
                        st(store.put(mut tx, call_env.6 .groups, call_env.1, g))?
                        Ok(true)
                    } else {
                        if let Unmatched(_, at, identity, n_place) = prior {
                            if at == call_env.4 && identity == call_env.5 .binding && n_place == call_env.5 .n_place {
                                return Ok(false)
                            }
                        }
                        g.recovery = Some(take mark)
                        st(store.put(mut tx, call_env.6 .groups, call_env.1, g))?
                        Ok(false)
                    }
                },
            }
        })
    }
    match decided(mut h, take made) {
        Ok(true) => {
            let mut v = vol_read(h, name)
            v.reprobe = true
            v.failing = false
            v.count = 0u64
            vol_put(mut h, name, take v)
        },
        Ok(false) => (),
        Error(_) => {
            h.failed = true
        },
    }
}

fn push_candidate(mut out: String, assembly: Bytes, binding: Option[Binding]) {
    string.push(mut out, std.hex.encode(assembly))
    if let Some(b) = binding {
        string.push(mut out, " with identity ")
        string.push(mut out, std.hex.encode(b.identity))
        string.push(mut out, " at n_place ")
        string.push_u64(mut out, b.n_place)
    }
}

fn failing_last(h: Host, name: String, outcome: String) -> String waits {
    let Ok(Some(g)) = group_row(h, name) else {
        return string.from(outcome)
    }
    let recovery: Option[Recovery] = clone(g.recovery)
    let Some(Unmatched(attempt, version, identity, n_place)) = take recovery else {
        return string.from(outcome)
    }
    let Ok(Some(d)) = store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.deploys, name) else {
        return string.from(outcome)
    }
    if !same_attempt(d.attempt, attempt) {
        return string.from(outcome)
    }
    let mut message = string.from("No recovery candidate matches the store at activation ")
    string.push_u64(mut message, version)
    string.push(mut message, ": its release identity ")
    if let Some(allowance) = n_place {
        string.push(mut message, "is ")
        string.push(mut message, std.hex.encode(identity))
        string.push(mut message, " at n_place ")
        string.push_u64(mut message, allowance)
    } else {
        string.push(mut message, "does not decode")
    }
    string.push(mut message, "; candidates: ")
    let old = roots_release(g, d.old_assembly)
    if old {
        push_candidate(mut message, d.old_assembly, d.old_binding)
    }
    if d.old_assembly != d.assembly && roots_release(g, d.assembly) {
        if old {
            string.push(mut message, ", ")
        }
        push_candidate(mut message, d.assembly, d.binding)
    }
    string.push(mut message, "; last start: ")
    string.push(mut message, outcome)
    take message
}

fn check_restored_launch(h: Host, g: GroupRow, ready: runner.PlaceReady, current_gen: bool) -> Result[bool, Refused] waits {
    let Some(intent) = st(store.get(st(store.reader(h.db, 0u64))?, store.snapshot(h.db), h.t.restored_groups, g.incarnation))? else {
        return Ok(false)
    }
    if intent.accepted && (!current_gen || g.activation != intent.activation || g.assembly != intent.assembly) {
        return Ok(false)
    }
    let Some(read) = read_place(ready.read) else {
        return Error(Denied("missing restored release evidence"))
    }
    if !current_gen || g.assembly != intent.assembly || ready.version == 0 || (intent.activation != 0 && ready.version != intent.activation) || (g.activation != 0 && g.activation != ready.version) || ready.release != intent.release || read.binding != intent.binding.identity || read.n_place != Some(intent.binding.n_place) || read.store_hi != ready.store_hi || read.store_lo != ready.store_lo {
        return Error(Denied("restored release mismatch"))
    }
    Ok(!intent.accepted)
}

fn placed(mut h: Host, c: launcher.Child, reply: runner.HostReply, now: Now, mut out: List[launcher.Request]) waits {
    let Some(g) = current(h, c) else {
        return
    }
    let Serving(gen) = c.role else {
        return
    }
    let name = string.from(c.group.name)
    if let PlaceOpened(ready) = reply {
        let is_current = run_gen(h, name) == Some(gen)
        let candidate = cut_of(h, name)
        let is_candidate = match candidate {
            Some(cut) => cut.candidate == gen && cut.activation == ready.version && cut.release == ready.release,
            None => false,
        }
        if !is_current {
            if !is_candidate {
                return
            }
            if !opens_cutover(h, name, ready) {
                list.push(mut out, Kill(clone(c)))
                return
            }
        }
        let actual = (ready.store_hi, ready.store_lo)
        if let Some(expected) = g.store_id {
            if expected != actual {
                if is_current {
                    unsuccessful(mut h, name, runner.store_mismatch(expected, actual), false, now, mut out)
                }
                list.push(mut out, Kill(clone(c)))
                return
            }
        }
        let accepting_restore = match check_restored_launch(h, g, ready, is_current) {
            Ok(first) => first,
            Error(_) => {
                if is_current {
                    unsuccessful(mut h, name, "restored release mismatch", false, now, mut out)
                }
                list.push(mut out, Kill(clone(c)))
                return
            },
        }
        let claim = opened_claim(ready)
        if accepting_restore || is_none(g.store_id) || (is_current && (g.activation == 0u64 || !is_none(g.recovery))) || has_new_claim(g, gen, claim) {
            if let Error(_) = record_store(mut h, name, g.incarnation, ready, is_current, gen, claim, accepting_restore) {
                list.push(mut out, Kill(clone(c)))
                return
            }
        }
        list.push(mut out, Command(clone(c), HostStoreAccepted))
    }
    if backup_placed(mut h, name, c.group.incarnation, gen, reply) {
        return
    }
    let preparing = prep_of(h, name)
    if let Some(take p) = take preparing {
        if p.old == gen {
            prep_placed(mut h, name, take p, reply, mut out);
            return
        }
    }
    let found = cut_of(h, name)
    match take found {
        Some(take outstanding) => {
            let mut cut = take outstanding
            if gen == cut.candidate {
                match reply {
                    PlaceOpened(ready) => {
                        if ready.version == cut.activation && ready.release == cut.release {
                            cut.opened = true
                            finish_ended_cut(mut h, name, take cut, now, mut out)
                        }
                    },
                    // RUNNER-SPEC §14.6: another writer owns the store. The cutover
                    // fails, never counts as opened, and the assignment parks.
                    PlaceDeposed(epoch, holder) => {
                        park_deposed(mut h, name, epoch, holder)
                        abort_cut(mut h, name, g, take cut, deposed_text(epoch, holder), now, mut out)
                    },
                    _ => (),
                }
            } else if gen == cut.old {
                match reply {
                    // The launcher can refuse to forward a cutover to a missing endpoint.
                    PlaceRefused(why) if !cut.held => abort_cut(mut h, name, g, take cut, why, now, mut out),
                    // OLD lost the store, held or not: OLD's end then parks.
                    PlaceDeposed(epoch, holder) => {
                        park_deposed(mut h, name, epoch, holder)
                        abort_cut(mut h, name, g, take cut, deposed_text(epoch, holder), now, mut out)
                    },
                    _ => (),
                }
            }
        },
        None => {
            let Vol(run: take running, ..) = vol_read(h, name)
            if let Some(run) = take running {
                if run.gen != gen {
                    return
                }
                match reply {
                    PlaceOpened(ready) => {
                        report_recovery(mut h, name, gen, ready.version, run.selected, ready.read, true)
                        set_run(mut h, name, Some(Run(gen: gen, phase: Ready(now.mono_ns), selected: clone(run.selected))))
                        if let Ready(_) = run.phase {
                            ()
                        } else {
                            record_event(mut h, c.group.incarnation, Some(gen), Some(ready.version), None, ReadyLifecycle)
                        }
                    },
                    PlaceStoreMismatch(ehi, elo, ahi, alo) => unsuccessful(mut h, name, runner.store_mismatch((ehi, elo), (ahi, alo)), false, now, mut out),
                    PlaceCurrent(version, read) => {
                        if adopt_genesis(mut h, name, g.incarnation, version) {
                            let mut v = vol_read(h, name)
                            v.reprobe = true
                            vol_put(mut h, name, take v)
                        } else {
                            report_recovery(mut h, name, gen, version, run.selected, read, false)
                            let mut v = vol_read(h, name)
                            if !v.reprobe {
                                v.cause = Some(start_current(version, run.selected))
                                vol_put(mut h, name, take v)
                            }
                        }
                    },
                    PlaceRefused(why) => {
                        let mut v = vol_read(h, name)
                        v.cause = Some(string.from(why))
                        vol_put(mut h, name, take v)
                    },
                    PlaceDeposed(epoch, holder) => park_deposed(mut h, name, epoch, holder),
                    _ => (),
                }
            }
        },
    }
}

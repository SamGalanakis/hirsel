// Ships the whole preparation; later catch-up rounds ship ROUND deltas onto it.
pub fn write_prepared(mut source: Preparation, staged: StagedMigration, d: Dir, take target: PreparedTarget) -> Result[(), DeployError] waits {
    let mut built_roots = pages.share_roots(staged.plan.schema.roots)
    let mut built_next_node = staged.plan.schema.next_node
    let mut extra_rewrites: List[transfer.ActivationRewrite] = list.new()
    let has_pending_indexes = list.len(staged.plan.pending_indexes) != 0
    if has_pending_indexes {
        let mut ctx = child_cut_context(source)
        deploy_result(run_deferred_index_builds_roots(mut ctx, source.stamp.opened, staged.plan.pending_indexes, staged.plan.bindings, mut built_roots, mut built_next_node, staged.plan.schema.live, staged.plan.schema.ceiling, staged.plan.schema.retained))?
        save_child_cut_pack(source, ctx.next_pack)
    }
    if list.len(staged.queued_rewrites) != 0 {
        let backend: pager.TieredPageBackend = PagerDirect(source.dir, store_key_to_rep(source.db.store))
        deploy_result(check_queued_rewrites(transfer.clone_pager_backend(backend), pager.pin_partition(source.db.pager), source.stamp.opened, source.db.store, staged, built_roots.collections))?
        let mut cut_opt: Option[transfer.ChildCutContext] = Some(child_cut_context(source))
        extra_rewrites = deploy_result(failure_result_from_rep(transfer.apply_queued_rewrites(take backend, pager.pin_partition(source.db.pager), source.stamp.opened, store_key_to_rep(source.db.store), mut built_roots.collections, mut built_next_node, staged.queued_rewrites, mut cut_opt)))?
        if let Some(ctx) = cut_opt {
            save_child_cut_pack(source, ctx.next_pack)
        }
    }
    let delta = deploy_result(failure_result_from_rep(transfer.catalog_changes(pages.holder_heads(source.db.holders)[0].roots, built_roots)))?
    let ranges = deploy_result(failure_result_from_rep(transfer.changed_ranges(delta, source.stamp.next_table, staged.plan.schema.next_table)))?
    let has_tiered = pages.tiered_collections(pages.holder_heads(source.db.holders)[0].roots.collections.root) || pages.tiered_collections(built_roots.collections.root)
    let snap = snapshot_from(source.db, 0u64, source.stamp.head, built_roots, int.saturating_add(built_next_node, 1))
    let mut inventory: List[transfer.Inventory] = list.with_capacity(list.len(ranges))
    for desc in ranges {
        if deploy_result(failure_result_from_rep(transfer.table_is_tiered(built_roots.collections, desc.id)))? {
            let (row_total, digest) = deploy_result(tiered_range_inventory_direct(source.dir, source.db.store, pager.pin_partition(source.db.pager), snap, desc.id))?
            list.push(mut inventory, transfer.Inventory(id: desc.id, count: row_total, digest: digest))
        } else {
            let mut cursor = deploy_result(failure_result_from_rep(transfer.entries_of(built_roots.collections, desc.id)))?
            let mut row_total = 0u64
            let mut checksum = std.check.start()
            while let Some((key, value)) = deploy_result(failure_result_from_rep(catalog.next_bytes(mut cursor)))? {
                deploy_result(failure_result_from_rep(transfer.checksum_row(mut checksum, key, value)))?
                row_total += 1
            }
            list.push(mut inventory, transfer.Inventory(id: desc.id, count: row_total, digest: std.check.finish(checksum)))
        }
    }
    let base = export_stamp_to_rep(clone(source.stamp))
    let ctx = format.DiskContext(store: store_key_to_rep(source.db.store), role: 6, seq: source.stamp.opened)
    let meta = transfer.PreparedMeta(base: take base, target: prepared_target_to_rep(take target), next_table: staged.plan.schema.next_table, changes: list.len(delta), ranges: list.len(inventory))
    let metadata_codec: std.codec.Codec[transfer.PreparedMeta] = std.codec.of()
    let mut encoded_meta: Bytes = list.new()
    std.codec.encode(metadata_codec, meta, mut encoded_meta) ?=> |_| Scratch(Limit(Value))
    if list.len(encoded_meta) > 1048832 {
        return Error(Scratch(Limit(Value)))
    }
    let source_map = if has_tiered {
        deploy_result(failure_result_from_rep(transfer.export_source_map(delta, source.stamp.next_table, staged.plan.migrate_sources)))?
    } else {
        list.new()
    }
    let rewrites = transfer_result(transfer.encode_rewrite_frame(staged.rewrites, staged.plan.schema.roots.collections, take extra_rewrites))?
    let mut file = scratch_result(failure_result_from_rep(transfer.open_frames(d, "PREPARED", ctx)))?
    let delta_codec: std.codec.Codec[transfer.CatalogChange] = std.codec.of()
    let inventory_codec: std.codec.Codec[transfer.Inventory] = std.codec.of()
    let row_codec: std.codec.Codec[transfer.PreparedRow] = std.codec.of()
    scratch_result(failure_result_from_rep(transfer.write_prepared_payload(mut file, 0x0081, encoded_meta)))?
    for change in delta {
        scratch_result(failure_result_from_rep(transfer.write_prepared_frame(mut file, 0x0082, delta_codec, change)))?
    }
    for desc in inventory {
        scratch_result(failure_result_from_rep(transfer.write_prepared_frame(mut file, 0x0083, inventory_codec, desc)))?
    }
    if list.len(source_map) != 0 {
        let source_map_codec: std.codec.Codec[List[transfer.MigrateSource]] = std.codec.of()
        scratch_result(failure_result_from_rep(transfer.write_prepared_frame(mut file, 0x008B, source_map_codec, source_map)))?
    }
    for desc in inventory {
        if deploy_result(failure_result_from_rep(transfer.table_is_tiered(built_roots.collections, desc.id)))? {
            write_tiered_prepared_rows_direct(mut file, source.dir, source.db.store, pager.pin_partition(source.db.pager), snap, desc.id, row_codec)?
        } else {
            let mut rows = deploy_result(failure_result_from_rep(transfer.entries_of(built_roots.collections, desc.id)))?
            while let Some((take key, value)) = deploy_result(failure_result_from_rep(catalog.next_bytes(mut rows)))? {
                let row = transfer.PreparedRow(key: take key, value: deploy_result(failure_result_from_rep(types.copied(value)))?)
                scratch_result(failure_result_from_rep(transfer.write_prepared_frame(mut file, 0x0084, row_codec, row)))?
            }
        }
    }
    if let Some(raw) = rewrites {
        scratch_result(failure_result_from_rep(transfer.write_prepared_payload(mut file, 0x0085, raw)))?
    }
    scratch_result(failure_result_from_rep(transfer.finish_frames(take file)))?
    let carried: Option[(pages.Roots, u64)] = if has_pending_indexes {
        Some((pages.share_roots(built_roots), built_next_node))
    } else {
        None
    }
    source.shipped = Some(transfer.ShippedImport(ranges: deploy_result(failure_result_from_rep(transfer.shipped_ranges(built_roots.collections, ranges)))?, round: 0, staged_roots: take carried))
    Ok(())
}

pub opaque type ValidatedImport: send {
    meta: transfer.PreparedMeta,
    delta: List[transfer.CatalogChange],
    ranges: List[transfer.ValidatedRange],
    rewrites: List[transfer.ActivationRewrite],
    digest: Inline[u8, 32],
    charge: u64,
    source_map: List[transfer.MigrateSource],
    dir: Option[Dir],
    rewrites_checked: bool
}

// M1 may run in a task while OLD serves. It checks all scratch input before
// the head can reserve ids or attach the result to an attempt.
pub fn validate_prepared(d: Dir) -> Result[ValidatedImport, DeployError] waits {
    validate_prepared_inner(None, d)
}

fn validate_prepared_on(db: Db, d: Dir) -> Result[ValidatedImport, DeployError] waits {
    validate_prepared_inner(Some(view db), d)
}

fn validate_prepared_inner(owner: Option[View[Db]], d: Dir) -> Result[ValidatedImport, DeployError] waits {
    let mut file = scratch_result(failure_result_from_rep(manifest.disk_io(host.open(d, "PREPARED", Read))))?
    let header = scratch_result(failure_result_from_rep(transfer.prepared_read(mut file, 72u64)))?
    let head = deploy_result(failure_result_from_rep(manifest.disk_read_header("PREPARED", header, 6, None, optional_store_key_to_rep(None))))?
    let mut digest = std.sha256.start()
    std.sha256.add(mut digest, header, 0u64, 72u64)
    let mut input = transfer.PreparedInput(file: take file, ctx: head.context, offset: 72u64, digest: take digest, peek: None)
    let metadata_codec: std.codec.Codec[transfer.PreparedMeta] = std.codec.of()
    let delta_codec: std.codec.Codec[transfer.CatalogChange] = std.codec.of()
    let inventory_codec: std.codec.Codec[transfer.Inventory] = std.codec.of()
    let row_codec: std.codec.Codec[transfer.PreparedRow] = std.codec.of()
    let meta = transfer_result(transfer.prepared_frame(mut input, 0x0081, metadata_codec))?
    if list.len(meta.base.attempt) != 16 || meta.base.store_hi != head.context.store.hi || meta.base.store_lo != head.context.store.lo || meta.base.opened != head.context.seq || meta.base.branch != 0 || meta.base.next_table == 0 || meta.next_table < meta.base.next_table || list.len(meta.target.digest) != 32 || list.len(meta.target.release) != 32 || list.len(meta.target.describe) == 0 {
        return Error(ImportMalformed)
    }
    let mut delta: List[transfer.CatalogChange] = list.new()
    for i in 0u64 .. meta.changes {
        let changed = transfer_result(transfer.prepared_frame(mut input, 0x0082, delta_codec))?
        if i != 0 && !(delta[i - 1u64].key < changed.key) {
            return Error(ImportMalformed)
        }
        transfer_result(transfer.validate_delta(changed, meta.base.next_table))?
        list.push(mut delta, take changed)
    }
    let needed = deploy_result(failure_result_from_rep(transfer.changed_ranges(delta, meta.base.next_table, meta.next_table)))?
    if list.len(needed) != meta.ranges {
        return Error(ImportMalformed)
    }
    let mut inventory: List[transfer.Inventory] = list.new()
    for _ in 0u64 .. meta.ranges {
        list.push(mut inventory, transfer_result(transfer.prepared_frame(mut input, 0x0083, inventory_codec))?)
    }
    let source_map = if meta.changes != 0 {
        transfer_result(transfer.read_optional_source_map(mut input))?
    } else {
        list.new()
    }
    transfer_result(transfer.validate_source_map(source_map, delta, meta.base.next_table))?
    let residencies: List[std.page_descriptor.Residency] = if meta.ranges == 0 {
        list.new()
    } else {
        let base_descs = match owner {
            Some(db) => match transfer.active_lease(disk_state(db).transfer) {
                Some(lease) => deploy_result(failure_result_from_rep(transfer.base_descriptors_from_tree(lease.collections)))?,
                None => deploy_result(failure_result_from_rep(transfer.base_descriptors_from_tree(pages.holder_heads(db.holders)[0u64].roots.collections)))?,
            },
            None => deploy_result(failure_result_from_rep(transfer.read_export_base_descriptors(d, head.context.store)))?,
        }
        transfer_result(transfer.derive_range_residencies(base_descs, needed, source_map, meta.base.next_table, false))?
    }
    let inline_threshold = match owner {
        Some(db) => pages.holder_heads(db.holders)[0u64].roots.collections.inline,
        None => 256u64,
    }
    let mut ranges: List[transfer.ValidatedRange] = list.new()
    let mut charge = 0u64
    for i in 0u64 .. meta.ranges {
        let desc = inventory[i]
        let checked_range = transfer_result(transfer.read_valid_range(mut input, needed[i], desc, residencies[i], inline_threshold, row_codec, mut charge))?
        list.push(mut ranges, take checked_range)
    }
    let rewrites = transfer_result(transfer.read_rewrite_frame(mut input))?
    let transfer.PreparedInput(file: take done, digest: take hashed, ..) = take input
    scratch_result(failure_result_from_rep(manifest.disk_io(host.close(take done))))?
    let mut rewrites_checked = false
    if let Some(db) = owner {
        if list.len(rewrites) != 0 {
            validate_rewrite_base_tiered(db, rewrites, meta.base.next_table, ranges)?
            rewrites_checked = true
        }
    }
    Ok(ValidatedImport(meta: take meta, delta: take delta, ranges: take ranges, rewrites: take rewrites, digest: std.sha256.finish(hashed), charge: charge, source_map: take source_map, dir: Some(d), rewrites_checked: rewrites_checked))
}

pub opaque type Imported: send {
    meta: transfer.PreparedMeta,
    delta: List[transfer.CatalogChange],
    ranges: List[transfer.ImportedRange],
    rewrites: List[transfer.ActivationRewrite],
    digest: Inline[u8, 32],
    dir: Option[Dir],
    pass2_low: u64,
    pass2_high: u64,
    pass2_inline: u64,
    has_tiered: bool,
    rewrites_checked: bool
}

pub opaque type ImportWork: send {
    payload: ValidatedImport,
    low: u64,
    high: u64,
    inline: u64
}

pub fn reserve_import(mut db: Db, take validated: ValidatedImport) -> Result[ImportWork, DeployError] {
    deploy_result(healthy(db))?
    if !is_disk(db) || validated.meta.base.opened != open_number(db) || validated.meta.base.store_hi != db.store.hi || validated.meta.base.store_lo != db.store.lo || !matches_export(db, validated.meta.base) {
        return Error(ExportMismatch)
    }
    let mut payload = take validated
    let lease: Arc[manifest.ExportLease] = match transfer.active_lease(disk_state(db).transfer) {
        Some(held) => arc.share(held),
        None => return Error(ExportMismatch),
    }
    // Authoritative residency derivation from OLD's leased base + 0x008B (§13.10a).
    let needed = deploy_result(failure_result_from_rep(transfer.changed_ranges(payload.delta, payload.meta.base.next_table, payload.meta.next_table)))?
    let base_descs = deploy_result(failure_result_from_rep(transfer.base_descriptors_from_tree(lease.collections)))?
    let residencies = transfer_result(transfer.derive_range_residencies(base_descs, needed, payload.source_map, payload.meta.base.next_table, true))?
    let mut has_tiered = false
    let mut memory_charge = 0u64
    for i in 0u64 .. list.len(payload.ranges) {
        payload.ranges[i].residency = residencies[i]
        if payload.ranges[i].kind != 0 {
            memory_charge = int.saturating_add(memory_charge, 126)
            if residencies[i] == ResidentTiered {
                has_tiered = true
            } else {
                memory_charge = int.saturating_add(memory_charge, payload.ranges[i].row_bytes)
            }
        }
    }
    payload.charge = memory_charge
    if has_tiered && !store_has_tiered(db) {
        deploy_result(admit_tiered_plan(db))?
    }
    // Check Memory rewrites synchronously; never read Cold pages inside reserve_import.
    if !payload.rewrites_checked && list.len(payload.rewrites) != 0 {
        let mut has_cold_rewrite = false
        for row in payload.rewrites {
            let id_key = deploy_result(failure_result_from_rep(catalog.prefix(row.id)))?
            if let Some((_, desc)) = std.page.collection_slot(lease.collections.root, id_key) {
                if pages.collection_descriptor(desc).residency != ResidentMemory {
                    has_cold_rewrite = true
                }
            }
        }
        if !has_cold_rewrite {
            validate_rewrite_base(db, payload)?
            payload.rewrites_checked = true
        }
    }
    let current = disk_state(db).options.resident_limit
    // An import pin still held is stale: this import's keep replaces it.
    let exact = install_account(db, pages.share_roots(pages.holder_heads(db.holders)[0u64].roots), import_pin_slot(db))?
    let reserve_delta = if has_tiered && !store_has_tiered(db) {
        tiered_plan_reserve(disk_state(db).options)
    } else {
        0u64
    }
    let requested = int.saturating_add(int.saturating_add(exact, payload.charge), reserve_delta)
    if requested > current {
        return Error(Store(Full(Resident(Capacity(requested: requested, available: current)))))
    }
    let low = pages.holder_next_node(db.holders)
    let inline = pages.holder_heads(db.holders)[0u64].roots.collections.inline
    let mut high = low
    for checked_range in payload.ranges {
        if checked_range.kind == 0 {
            continue
        }
        let n = checked_range.count
        let bodies = if checked_range.residency == ResidentMemory {
            let mut b = 0u64
            for row in checked_range.rows {
                if list.len(row.value) > inline {
                    b += 1
                }
            }
            b
        } else {
            checked_range.over_inline
        }
        let Some(pages) = int.checked_mul(n, 2) else {
            return Error(IdBound)
        }
        let Some(with_pages) = int.checked_add(high, pages) else {
            return Error(IdBound)
        }
        let Some(end) = int.checked_add(with_pages, bodies + 1) else {
            return Error(IdBound)
        }
        high = end
    }
    if high == 18446744073709551615u64 {
        return Error(IdBound)
    }
    pages.set_next_node(mut db.holders, high)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        transfer.reserve(mut state.transfer, payload.digest)
    })
    db.accounting.ceiling = int.saturating_sub(current, payload.charge)
    Ok(ImportWork(payload: take payload, low: low, high: high, inline: inline))
}

fn matches_export(db: Db, base: transfer.ExportStampRep) -> bool {
    match transfer.active_lease(disk_state(db).transfer) {
        Some(kept) => kept.attempt == base.attempt && kept.terminal == base.terminal && kept.end == base.end && kept.head == base.head && kept.next_table == base.next_table && kept.activation == base.activation,
        None => false,
    }
}

pub fn import_trees(take work: ImportWork) -> Result[Imported, DeployError] {
    let ImportWork(payload: take payload, low: low, high: high, inline: inline) = take work
    let ValidatedImport(meta: take meta, delta: take delta, ranges: take ranges, rewrites: take rewrites, digest: digest, dir: import_dir, rewrites_checked: rewrites_checked, ..) = take payload
    let mut ids = low + 1
    let mut imported: List[transfer.ImportedRange] = list.with_capacity(list.len(ranges))
    let mut has_tiered = false
    for checked_range in ranges {
        if checked_range.kind == 0 {
            list.push(mut imported, transfer.ImportedRange(id: checked_range.id, kind: 0, tree: None, slot: None, rows: 0, charge: 0, count: 0, digest: checked_range.digest, residency: ResidentMemory))
            continue
        }
        if checked_range.residency == ResidentTiered {
            has_tiered = true
            list.push(mut imported, transfer.ImportedRange(id: checked_range.id, kind: checked_range.kind, tree: None, slot: None, rows: checked_range.count, charge: checked_range.row_bytes, count: checked_range.count, digest: checked_range.digest, residency: ResidentTiered))
            continue
        }
        let built = deploy_result(failure_result_from_rep(pages.page_result(std.page.bulk(checked_range.rows, Collection, inline, mut ids))))?
        if ids - 1 > high {
            return Error(IdBound)
        }
        list.push(mut imported, transfer.ImportedRange(id: checked_range.id, kind: checked_range.kind, tree: take built, slot: None, rows: checked_range.count, charge: checked_range.row_bytes, count: checked_range.count, digest: checked_range.digest, residency: ResidentMemory))
    }
    let pass2_low = ids - 1
    Ok(Imported(meta: take meta, delta: take delta, ranges: take imported, rewrites: take rewrites, digest: digest, dir: import_dir, pass2_low: pass2_low, pass2_high: high, pass2_inline: inline, has_tiered: has_tiered, rewrites_checked: rewrites_checked))
}

pub fn imported_digest(value: Imported) -> Inline[u8, 32] {
    value.digest
}

pub fn prepared_matches(value: ValidatedImport, describe: Bytes, release: Bytes, digest: Bytes) -> bool {
    let target = view value.meta.target
    target.describe == describe && target.release == release && target.digest == digest
}

pub fn identity_words(db: Db) -> (u64, u64) {
    (db.store.hi, db.store.lo)
}

pub type Cutover: send {
    attempt: Bytes,
    digest: Inline[u8, 32],
    deadline: u64
}

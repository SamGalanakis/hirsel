pub type HeaderValue: send = Public(Bytes) | Protected(Bytes, Secret)

pub type Header: send {
    name: String,
    value: HeaderValue
}

/// How the runtime writes a protected body segment's bytes (HTTP-17).
pub type Coding: key + send = Raw | Form

pub type Segment: send = Plain(Bytes) | Sealed(Secret, Coding)

pub type RequestBody: send = Fixed(u64) | Chunked | Segments(List[Segment])

pub type Request: send {
    method: String,
    target: String,
    headers: List[Header],
    body: RequestBody
}

pub type Error: send = InvalidRequest | State | NoSpace | Connect(NetError) | Write(NetError) | Receive(NetError) | MalformedHead | UnsupportedSwitch | BodyFraming | TooLarge | Deadline | Cancelled

/// Adds an explicit Idempotency-Key as a quoted lower-case hexadecimal string.
/// Refuses an empty key or a second Idempotency-Key field.
pub fn idempotency_key(mut headers: List[Header], key: Bytes) -> Result[(), Error] {
    if list.len(key) == 0 {
        return Error(InvalidRequest)
    }
    for header in headers {
        if http1.equal_ascii(string.as_bytes(header.name), b"idempotency-key") {
            return Error(InvalidRequest)
        }
    }
    let mut value: Bytes = list.with_capacity(2 * list.len(key) + 2)
    list.push(mut value, b'"')
    for byte in key {
        let (hi, lo) = hex.encode_byte(byte, false)
        list.push(mut value, hi)
        list.push(mut value, lo)
    }
    list.push(mut value, b'"')
    list.push(mut headers, Header(name: "Idempotency-Key", value: Public(take value)))
    Ok(())
}

/// Writes an HTTP/1.1 request head into caller-owned fixed storage.
/// Returns whether Connection asks the peer to close. Protected fields need a TLS stream.
pub fn encode_request(mut out: Bytes, authority: String, req: Request) -> Result[bool, Error] {
    let mut marks: List[u64] = list.new()
    let encoded = http_request.encode_head(mut out, mut marks, authority, req.method, req.target, req.headers, request_upload(req), request_segments(req), false)?
    if encoded.secrets != 0 {
        list.clear(mut out)
        return Error(Write(Denied))
    }
    Ok(encoded.close)
}

fn render_request_into(mut out: Bytes, req: Request) -> Result[(), Error] {
    http_request.text(mut out, req.method)?
    http_request.text(mut out, " ")?
    http_request.text(mut out, req.target)?
    http_request.text(mut out, "\n")?
    for f in req.headers {
        http_request.text(mut out, f.name)?
        http_request.text(mut out, ": ")?
        match f.value {
            Public(value) => http_request.append(mut out, value)?,
            Protected(prefix, credential) => {
                http_request.append(mut out, prefix)?
                http_request.text(mut out, secret.render(credential))?
            },
        }
        http_request.text(mut out, "\n")?
    }
    Ok(())
}

/// Renders a request's method, target and fields into bounded caller-owned storage.
pub fn render_request(mut out: Bytes, req: Request) -> Result[(), Error] {
    list.clear(mut out)
    render_request_into(mut out, req)
}

/// Renders the HTTP error category and the redacted request that caused it.
pub fn render_error(mut out: Bytes, error: Error, req: Request) -> Result[(), Error] {
    list.clear(mut out)
    let label = match error {
        InvalidRequest => "InvalidRequest",
        State => "State",
        NoSpace => "NoSpace",
        Connect(_) => "Connect",
        Write(_) => "Write",
        Receive(_) => "Receive",
        MalformedHead => "MalformedHead",
        UnsupportedSwitch => "UnsupportedSwitch",
        BodyFraming => "BodyFraming",
        TooLarge => "TooLarge",
        Deadline => "Deadline",
        Cancelled => "Cancelled",
    }
    http_request.text(mut out, label)?
    http_request.text(mut out, "\n")?
    render_request_into(mut out, req)
}

/// Writes the size line for one nonempty chunk into fixed storage.
pub fn encode_chunk_prefix(mut out: Bytes, size: u64) -> Result[(), Error] {
    list.clear(mut out)
    if size == 0 {
        return Error(InvalidRequest)
    }
    http_request.number(mut out, size, 16)?
    http_request.text(mut out, "\r\n")
}

pub opaque type ResponseHead: send {
    raw: Bytes,
    parsed: http1.Head,
    persistent: bool
}

pub fn status(h: ResponseHead) -> u16 {
    h.parsed.status
}

pub fn version(h: ResponseHead) -> u8 {
    h.parsed.version
}

pub fn reason(h: ResponseHead) -> View[Bytes] in h {
    list.slice(h.raw, h.parsed.reason.start, h.parsed.reason.end)
}

pub fn field_count(h: ResponseHead) -> u64 {
    h.parsed.count
}

pub fn field_at(h: ResponseHead, index: u64) -> Option[(View[Bytes], View[Bytes])] in h {
    if index >= h.parsed.count {
        return None
    }
    let f = h.parsed.fields[index]
    Some((list.slice(h.raw, f.name.start, f.name.end), list.slice(h.raw, f.value.start, f.value.end)))
}

pub opaque type Reader: send {
    input: Bytes,
    at: u64,
    eof: bool,
    head: ResponseHead,
    body: Option[http.Decoder]
}

pub type BodyRead: key = NeedInput | Data(u64) | End

/// Allocates the bounded wire buffer and final-head storage.
pub fn reader() -> Result[Reader, Error] {
    let input: Bytes = list.with_capacity(8192)
    let raw: Bytes = list.with_capacity(8192)
    Ok(Reader(input: take input, at: 0, eof: false, head: ResponseHead(raw: take raw, parsed: http1.head(), persistent: false), body: None))
}

fn compact(mut r: Reader) {
    list.drop_prefix(mut r.input, r.at)
    r.at = 0
}

/// Appends the prefix that fits. Pass an unaccepted suffix again after parsing.
pub fn feed(mut r: Reader, input: Bytes) -> u64 {
    if r.eof {
        return 0
    }
    compact(mut r)
    let n = order.min(8192 - list.len(r.input), list.len(input))
    let _ = list.append(mut r.input, list.slice(input, 0, n))
    n
}

pub fn end_input(mut r: Reader) {
    r.eof = true
}

pub fn response_head(r: Reader) -> View[ResponseHead] in r {
    view r.head
}

fn framing_error(e: http.BodyError) -> Error {
    if e.status == 413 || e.status == 431 {
        TooLarge
    } else {
        BodyFraming
    }
}

fn persistent(wire: Bytes, h: View[http1.Head]) -> bool {
    let mut keep = h.version == 1
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        if http1.equal_ascii(list.slice(wire, f.name.start, f.name.end), string.as_bytes("connection")) {
            let value = list.slice(wire, f.value.start, f.value.end)
            if http1.contains(value, string.as_bytes("close")) {
                return false
            }
            keep = keep || http1.contains(value, string.as_bytes("keep-alive"))
        }
    }
    keep
}

/// Parses past interim heads. True prepares a body read and exposes a final head.
pub fn parse_head(mut r: Reader, head_request: bool, body_max: u64) -> Result[bool, Error] {
    if let Some(_) = r.body {
        return Error(State)
    }
    loop {
        let wire = list.slice(r.input, r.at, list.len(r.input))
        let mut h = http1.head()
        match http1.response(wire, mut h) {
            Partial => return if r.eof {
                Error(MalformedHead)
            } else {
                Ok(false)
            },
            Bad => return Error(MalformedHead),
            TooLarge => return Error(TooLarge),
            Complete => {},
        }
        if h.status < 100 || h.status > 599 {
            return Error(MalformedHead)
        }
        if h.status == 101 {
            return Error(UnsupportedSwitch)
        }
        if h.status < 200 {
            r.at += h.end
            continue
        }
        let frame = match http.response_framing(wire, view h, head_request, body_max) {
            Ok(value) => value,
            Error(e) => return Error(framing_error(e)),
        }
        r.head.persistent = frame != CloseDelimited && persistent(wire, view h)
        list.clear(mut r.head.raw)
        let _ = list.append(mut r.head.raw, list.slice(wire, 0, h.end))
        r.at += h.end
        r.body = Some(http.decoder(frame, h, body_max))
        r.head.parsed = h
        return Ok(true)
    }
}

fn read_staged(mut r: Reader, mut decoder: http.Decoder, mut into: Bytes, room: u64) -> Result[BodyRead, Error] {
    loop {
        let stop = r.at + order.min(room, list.len(r.input) - r.at)
        let input = list.slice(r.input, r.at, stop)
        let progress = http.decode(mut decoder, input)
        r.at += decoder.used
        match progress {
            Data(span) => {
                let _ = list.append(mut into, list.slice(input, span.start, span.end))
                return Ok(Data(span.end - span.start))
            },
            Done => return Ok(End),
            Failed(e) => return Error(framing_error(e)),
            More => {
                if r.at != list.len(r.input) {
                    continue
                }
                if r.eof {
                    return match http.body_eof(mut decoder) {
                        Ok(()) => Ok(End),
                        Error(e) => Error(framing_error(e)),
                    }
                }
                return Ok(NeedInput)
            },
        }
    }
}

/// Appends one decoded span or reports the next input requirement.
pub fn read_buffered(mut r: Reader, mut into: Bytes) -> Result[BodyRead, Error] {
    let room = list.capacity(into) - list.len(into)
    if room == 0 {
        return Error(NoSpace)
    }
    let current = replace(mut r.body, None)
    let Some(take d) = take current else {
        return if r.head.parsed.end == 0 {
            Error(State)
        } else {
            Ok(End)
        }
    }
    let mut decoder = take d
    let progress = read_staged(mut r, mut decoder, mut into, room)
    match progress {
        Ok(End) => {},
        _ => {
            r.body = Some(take decoder)
        },
    }
    progress
}

type Phase: key = Idle | Upload | Download | Closed

/// What the request's body still takes: plain bytes, chunks, or nothing
/// because `start` sent it whole.
fn request_upload(req: Request) -> http_request.Upload {
    match req.body {
        Fixed(n) => Remaining(n),
        Chunked => Chunks,
        Segments(_) => Whole,
    }
}

fn request_segments(req: Request) -> Option[View[List[Segment]]] in req {
    if let Segments(segments) = req.body {
        return Some(segments)
    }
    None
}

pub opaque type Connection: send {
    input: ReadHalf,
    output: WriteHalf,
    wire: Reader,
    encoding: Bytes,
    authority: String,
    clock: Clock,
    deadline: u64,
    phase: Phase,
    head_committed: bool,
    response_committed: bool,
    response_fresh: bool,
    upload: http_request.Upload,
    head_request: bool,
    close_after: bool
}

fn connect_error(e: NetError) -> Error {
    match e {
        TimedOut => Deadline,
        Aborted => Cancelled,
        _ => Connect(e),
    }
}

fn write_result(result: Result[(), NetError]) -> Result[(), Error] {
    match result {
        Ok(()) => Ok(()),
        Error(TimedOut) => Error(Deadline),
        Error(Aborted) => Error(Cancelled),
        Error(e) => Error(Write(e)),
    }
}

fn send(mut output: WriteHalf, prefix: Bytes, body: Bytes, clock: Clock, deadline: u64) -> Result[(), Error] waits {
    write_result(http.write_wire(mut output, prefix, body, clock, deadline))
}

fn send_head(mut c: Connection, headers: List[Header], body: Option[View[List[Segment]]], encoded: http_request.EncodedHead, marks: List[u64]) -> Result[(), Error] waits {
    let empty = string.as_bytes("")
    if encoded.secrets != 0 {
        // One message: the head, any body, and every secret (TLS-5).
        let secrets = http_request.secret_list(headers, body, encoded.secrets)
        // send_secret does not return a committed count on failure.
        c.head_committed = true
        return write_result(tls.send_secret(mut c.output, c.encoding, secrets, marks, At(c.clock, c.deadline)))
    }
    let end = list.len(c.encoding)
    let mut at = 0u64
    while at < end {
        check_deadline(mut c)?
        match host.send_pair(mut c.output, list.slice(c.encoding, at, end), empty, At(c.clock, c.deadline)) {
            Ok(0) => return Error(Write(Reset)),
            Ok(n) => {
                c.head_committed = true
                at += n
            },
            Error(e) => return write_result(Error(e)),
        }
    }
    if encoded.plain_body {
        if let Some(segments) = body {
            for segment in segments {
                if let Plain(data) = segment {
                    send(mut c.output, empty, data, c.clock, c.deadline)?
                }
            }
        }
    }
    Ok(())
}

fn check_deadline(mut c: Connection) -> Result[(), Error] {
    if host.mono_ns(c.clock) >= c.deadline {
        c.phase = Closed
        Error(Deadline)
    } else {
        Ok(())
    }
}

fn connect_socket(n: Net, address: Addr, clock: Clock, deadline_ns: u64) -> Result[Socket, Error] waits {
    if host.mono_ns(clock) >= deadline_ns {
        return Error(Deadline)
    }
    match host.connect(n, address, At(clock, deadline_ns)) {
        Ok(take s) => Ok(take s),
        Error(e) => Error(connect_error(e)),
    }
}

/// Dials a numeric address and writes the first request head under this deadline.
pub fn dial(n: Net, address: Addr, authority: String, clock: Clock, req: Request, deadline_ns: u64) -> Result[Connection, Error] waits {
    let mut c = open(n, address, authority, clock, deadline_ns)?
    start(mut c, req, deadline_ns)?
    Ok(take c)
}

/// Performs a verified TLS handshake offering HTTP/1.1 and writes the first request head.
pub fn https(n: Net, address: Addr, authority: String, name: String, trust: Trust, clock: Clock, req: Request, deadline_ns: u64) -> Result[Connection, Error] waits {
    let mut c = open_tls(n, address, authority, name, trust, clock, deadline_ns)?
    start(mut c, req, deadline_ns)?
    Ok(take c)
}

/// Opens a numeric address without writing an HTTP request.
pub fn open(n: Net, address: Addr, authority: String, clock: Clock, deadline_ns: u64) -> Result[Connection, Error] waits {
    let socket = connect_socket(n, address, clock, deadline_ns)?
    let (take input, take output) = net.split(take socket)
    idle_connection(take input, take output, authority, clock, deadline_ns)
}

/// Opens and verifies a TLS stream without writing an HTTP request.
pub fn open_tls(n: Net, address: Addr, authority: String, name: String, trust: Trust, clock: Clock, deadline_ns: u64) -> Result[Connection, Error] waits {
    let socket = connect_socket(n, address, clock, deadline_ns)?
    let mut alpn: List[String] = list.new()
    let protocol = string.from("http/1.1")
    list.push(mut alpn, take protocol)
    let (take input, take output, _) = match tls.connect(n, take socket, name, trust, alpn, At(clock, deadline_ns)) {
        Ok(take stream) => take stream,
        Error(e) => return Error(connect_error(e)),
    }
    idle_connection(take input, take output, authority, clock, deadline_ns)
}

/// Takes ownership of a connected stream and writes the first request head.
pub fn attach(take socket: Socket, authority: String, clock: Clock, req: Request, deadline_ns: u64) -> Result[Connection, Error] waits {
    let (take input, take output) = net.split(take socket)
    let mut c = idle_connection(take input, take output, authority, clock, deadline_ns)?
    start(mut c, req, deadline_ns)?
    Ok(take c)
}

fn idle_connection(take input: ReadHalf, take output: WriteHalf, authority: String, clock: Clock, deadline_ns: u64) -> Result[Connection, Error] {
    if string.byte_len(authority) > 8192 {
        return Error(TooLarge)
    }
    let stored = string.from(authority)
    let wire = reader()?
    let encoding: Bytes = list.with_capacity(8192)
    Ok(Connection(input: take input, output: take output, wire: take wire, encoding: take encoding, authority: take stored, clock, deadline: deadline_ns, phase: Idle, head_committed: false, response_committed: false, response_fresh: false, upload: Remaining(0), head_request: false, close_after: false))
}

/// Begins another request after the previous body has reached EOF.
pub fn start(mut c: Connection, req: Request, deadline_ns: u64) -> Result[(), Error] waits {
    start_parts(mut c, None, req.method, req.target, req.headers, request_upload(req), request_segments(req), false, deadline_ns)
}

/// Writes a fetch hop, borrowing the segments so it can resend them.
pub fn start_fetch(mut c: Connection, authority: String, method: String, target: String, headers: List[Header], segments: List[Segment], deadline_ns: u64) -> Result[(), Error] waits {
    let unframed = list.len(segments) == 0 && (method == "GET" || method == "HEAD" || method == "DELETE" || method == "OPTIONS" || method == "TRACE")
    start_parts(mut c, Some(view authority), method, target, headers, Whole, Some(view segments), unframed, deadline_ns)
}

fn start_parts(mut c: Connection, authority: Option[View[String]], method: String, target: String, headers: List[Header], upload: http_request.Upload, body: Option[View[List[Segment]]], unframed: bool, deadline_ns: u64) -> Result[(), Error] waits {
    if c.phase != Idle {
        return Error(State)
    }
    c.head_committed = false
    c.response_committed = c.wire.at != list.len(c.wire.input)
    c.deadline = deadline_ns
    check_deadline(mut c)?
    let mut marks: List[u64] = list.new()
    let encoded = {
        let host_name = match authority {
            Some(name) => name,
            None => view c.authority,
        }
        http_request.encode_head(mut c.encoding, mut marks, host_name, method, target, headers, upload, body, unframed)?
    }
    c.close_after = encoded.close
    c.phase = Closed
    send_head(mut c, headers, body, encoded, marks)?
    check_deadline(mut c)?
    c.upload = upload
    c.head_request = method == "HEAD"
    c.phase = Upload
    Ok(())
}

/// Whether the last start committed request bytes, or may have when a
/// send carrying a Secret, in a header or the body, failed.
pub fn request_started(c: Connection) -> bool {
    c.head_committed
}

/// Sends a body fragment. A local size error leaves the upload unchanged.
pub fn write(mut c: Connection, data: Bytes) -> Result[(), Error] waits {
    if c.phase != Upload {
        return Error(State)
    }
    check_deadline(mut c)?
    let n = list.len(data)
    if n == 0 {
        return Ok(())
    }
    match c.upload {
        Whole => return Error(State),
        Remaining(remaining) => {
            if n > remaining {
                return Error(InvalidRequest)
            }
            c.phase = Closed
            send(mut c.output, string.as_bytes(""), data, c.clock, c.deadline)?
            c.upload = Remaining(remaining - n)
        },
        Chunks => {
            encode_chunk_prefix(mut c.wire.head.raw, n)?
            c.phase = Closed
            send(mut c.output, c.wire.head.raw, data, c.clock, c.deadline)?
            send(mut c.output, string.as_bytes("\r\n"), string.as_bytes(""), c.clock, c.deadline)?
        },
    }
    check_deadline(mut c)?
    c.phase = Upload
    Ok(())
}

/// Sends one chunk of a `Chunked` upload made of plain and protected segments.
/// The runtime writes the chunk size when a segment is protected (HTTP-17).
pub fn write_segments(mut c: Connection, segments: List[Segment]) -> Result[(), Error] waits {
    if c.phase != Upload {
        return Error(State)
    }
    match c.upload {
        Remaining(_) => return Error(InvalidRequest),
        Whole => return Error(State),
        Chunks => {},
    }
    check_deadline(mut c)?
    list.clear(mut c.wire.head.raw)
    let mut marks: List[u64] = list.new()
    let protected = http_request.sealed(segments)
    if protected {
        // The size goes before the line end, over the chunk's data.
        http_request.text(mut c.wire.head.raw, "\r\n")?
        http_request.mark(mut marks, 0, 3, 2, 0)
    } else {
        let mut n = 0u64
        for segment in segments {
            if let Plain(data) = segment {
                n += list.len(data)
            }
        }
        http_request.number(mut c.wire.head.raw, n, 16)?
        http_request.text(mut c.wire.head.raw, "\r\n")?
    }
    let data_at = list.len(c.wire.head.raw)
    let count = http_request.body_segments(mut c.wire.head.raw, mut marks, segments, 0)?
    // Only plain bytes keep the size from being zero, which ends the body.
    if list.len(c.wire.head.raw) == data_at {
        return Error(InvalidRequest)
    }
    if protected {
        let _ = list.set(mut marks, 3, list.len(c.wire.head.raw))
    }
    http_request.text(mut c.wire.head.raw, "\r\n")?
    c.phase = Closed
    if protected {
        let mut secrets: List[Secret] = list.with_capacity(count)
        for segment in segments {
            if let Sealed(credential, _) = segment {
                list.push(mut secrets, secret.share(credential))
            }
        }
        write_result(tls.send_secret(mut c.output, c.encoding, secrets, marks, At(c.clock, c.deadline)))?
    } else {
        send(mut c.output, c.wire.head.raw, string.as_bytes(""), c.clock, c.deadline)?
    }
    check_deadline(mut c)?
    c.phase = Upload
    Ok(())
}

fn receive_into(mut input: ReadHalf, mut into: Bytes, max: u64, clock: Clock, deadline: u64) -> Result[u64, Error] waits {
    match host.recv_bounded(mut input, mut into, max, At(clock, deadline)) {
        Ok(n) => Ok(n),
        Error(TimedOut) => Error(Deadline),
        Error(Aborted) => Error(Cancelled),
        Error(e) => Error(Receive(e)),
    }
}

fn receive_staged(mut c: Connection, allowance: u64) -> Result[(), Error] waits {
    check_deadline(mut c)?
    compact(mut c.wire)
    let max = order.min(allowance, 8192 - list.len(c.wire.input))
    if receive_into(mut c.input, mut c.wire.input, max, c.clock, c.deadline)? == 0 {
        end_input(mut c.wire)
    } else {
        c.response_committed = true
    }
    check_deadline(mut c)
}

/// Finishes the upload and reads through the final response head.
pub fn finish_request(mut c: Connection, body_max: u64) -> Result[(), Error] waits {
    if c.phase != Upload {
        return Error(State)
    }
    check_deadline(mut c)?
    if let Remaining(n) = c.upload {
        if n != 0 {
            return Error(InvalidRequest)
        }
    }
    c.phase = Closed
    if c.upload == Chunks {
        send(mut c.output, string.as_bytes("0\r\n\r\n"), string.as_bytes(""), c.clock, c.deadline)?
    }
    loop {
        check_deadline(mut c)?
        if parse_head(mut c.wire, c.head_request, body_max)? {
            check_deadline(mut c)?
            c.phase = Download
            c.response_fresh = true
            return Ok(())
        }
        receive_staged(mut c, 8192)?
    }
}

/// Borrows the response head through the connection's next mutation.
pub fn head(c: Connection) -> View[ResponseHead] in c {
    response_head(c.wire)
}

/// Appends decoded bytes to caller-owned spare capacity. Zero is body EOF.
pub fn read(mut c: Connection, mut into: Bytes) -> Result[u64, Error] waits {
    if c.phase != Download {
        return Error(State)
    }
    let original_len = list.len(into)
    let room = list.capacity(into) - original_len
    if room == 0 {
        return Error(NoSpace)
    }
    c.response_fresh = false
    c.phase = Closed
    let current = replace(mut c.wire.body, None)
    let Some(take d) = take current else {
        return Error(State)
    }
    let mut decoder = take d
    loop {
        check_deadline(mut c)?
        match read_staged(mut c.wire, mut decoder, mut into, room)? {
            Data(n) => {
                c.wire.body = Some(take decoder)
                c.phase = Download
                return Ok(n)
            },
            End => {
                if c.wire.head.persistent && !c.close_after {
                    c.phase = Idle
                }
                return Ok(0)
            },
            NeedInput => {},
        }
        if let Some(window) = http.body_payload(decoder) {
            if window != 0 {
                let received = receive_into(mut c.input, mut into, order.min(window, room), c.clock, c.deadline)
                let n = match received {
                    Ok(n) => n,
                    Error(e) => {
                        list.truncate(mut into, original_len)
                        return Error(e)
                    },
                }
                if let Error(e) = check_deadline(mut c) {
                    list.truncate(mut into, original_len)
                    return Error(e)
                }
                if n == 0 {
                    end_input(mut c.wire)
                    continue
                }
                http.advance_body_payload(mut decoder, n)
                c.wire.body = Some(take decoder)
                c.phase = Download
                return Ok(n)
            }
        }
        // A framing byte can open a payload window. Read it alone so no
        // payload lands in staging. At the EOF limit it can only be overflow.
        receive_staged(mut c, 1)?
    }
}

pub fn reusable(c: Connection) -> bool {
    c.phase == Idle
}

/// Whether the connection is reusable and holds no received byte past its last
/// response: the boundary at which a pool may park it (HTTP-18).
pub fn drained(c: Connection) -> bool {
    c.phase == Idle && c.wire.at == list.len(c.wire.input)
}

/// Whether a receive on the connection would wait: no byte, end or error is pending.
/// It polls once at the current time on the connection's clock and consumes nothing
/// (HTTP-18). A served Net answers a deadline already past without asking its server.
pub fn quiet(mut c: Connection) -> bool waits {
    match host.recv_ready(mut c.input, At(c.clock, host.mono_ns(c.clock) + 1)) {
        Error(TimedOut) => true,
        _ => false,
    }
}

/// Ends a response whose body has no byte left to receive, as a read of its end
/// would, and returns true. A body with bytes to come is left as it was.
pub fn end_empty(mut c: Connection) -> bool {
    if c.phase != Download {
        return false
    }
    let current = replace(mut c.wire.body, None)
    let Some(take d) = take current else {
        return false
    }
    let mut decoder = take d
    let none: Bytes = list.new()
    if let Done = http.decode(mut decoder, none) {
        c.response_fresh = false
        c.phase = if c.wire.head.persistent && !c.close_after {
            Idle
        } else {
            Closed
        }
        return true
    }
    c.wire.body = Some(take decoder)
    false
}

/// A copy of the response head, charged where it is made, that outlives the connection.
pub fn copy_head(c: Connection) -> ResponseHead {
    ResponseHead(raw: clone(c.wire.head.raw), parsed: c.wire.head.parsed, persistent: c.wire.head.persistent)
}

pub fn close(take c: Connection) {}

pub fn response_started(c: Connection) -> bool {
    c.response_committed
}

/// Narrow the response body bound before its first read.
pub fn limit_response(mut c: Connection, max: u64) -> Result[http.Framing, Error] {
    if c.phase != Download || !c.response_fresh {
        return Error(State)
    }
    let h = c.wire.head.parsed
    let frame = match http.response_framing(c.wire.head.raw, view h, c.head_request, max) {
        Ok(value) => value,
        Error(e) => return Error(framing_error(e)),
    }
    c.wire.body = Some(http.decoder(frame, h, max))
    Ok(frame)
}

/// Closes the socket, retaining its response head.
pub fn close_response(take c: Connection) -> ResponseHead {
    let mut owned = take c
    replace(mut owned.wire.head, ResponseHead(raw: list.new(), parsed: http1.head(), persistent: false))
}

/// Whether the connection holds a final response head and none of its body
/// has been read: what `stream.spec_relay` takes.
pub fn fresh_response(c: Connection) -> bool {
    c.phase == Download && c.response_fresh
}

/// The status a gateway answers when upstream fails before its head (HTTP-10):
/// 504 for the deadline, otherwise 502 (RFC 9110 §15.6.3, §15.6.5).
pub fn gateway_status(e: Error) -> u16 {
    match e {
        Deadline => 504,
        _ => 502,
    }
}

/// Copies the response head's end-to-end fields, in order, for a relayed
/// response. It drops hop-by-hop fields (RFC 9110 §7.6.1) and those that
/// Connection names, the framing and Date fields the server's writer owns,
/// and any field the writer would refuse (HTTP-4 rule 11).
pub fn relay_fields(c: Connection) -> List[(Bytes, Bytes)] {
    let h = response_head(c.wire)
    let mut fields: List[(Bytes, Bytes)] = list.with_capacity(field_count(h))
    for i in 0u64 .. field_count(h) {
        let (name, value) = option.unwrap(field_at(h, i))
        if hop_by_hop(name) || connection_names(h, name) {
            continue
        }
        if let Ok(()) = http.check_response_field(name, value) {
            list.push(mut fields, (http.copy_bytes(name), http.copy_bytes(value)))
        }
    }
    take fields
}

fn hop_by_hop(name: Bytes) -> bool {
    let hop = http1.equal_ascii(name, b"connection") || http1.equal_ascii(name, b"keep-alive") || http1.equal_ascii(name, b"proxy-connection") || http1.equal_ascii(name, b"te") || http1.equal_ascii(name, b"trailer") || http1.equal_ascii(name, b"transfer-encoding") || http1.equal_ascii(name, b"upgrade")
    hop || http1.equal_ascii(name, b"content-length") || http1.equal_ascii(name, b"date")
}

fn connection_names(h: ResponseHead, name: Bytes) -> bool {
    for i in 0u64 .. field_count(h) {
        let (field, value) = option.unwrap(field_at(h, i))
        if !http1.equal_ascii(field, b"connection") {
            continue
        }
        let mut lo = 0u64
        while lo <= list.len(value) {
            let mut hi = lo
            while hi < list.len(value) && value[hi] != b',' {
                hi += 1
            }
            let mut from = lo
            let mut to = hi
            while from < to && (value[from] == b' ' || value[from] == b'\t') {
                from += 1
            }
            while to > from && (value[to - 1] == b' ' || value[to - 1] == b'\t') {
                to -= 1
            }
            if to > from && http1.equal_ascii(list.slice(value, from, to), name) {
                return true
            }
            lo = hi + 1
        }
    }
    false
}

/// A relayed body's producer (§2): the stream's seed, the upstream connection
/// it now owns, the idle deadline of each read and the read size.
pub type BodyRelay: send {
    seed: stream.Seed,
    upstream: Connection,
    idle_ms: u64,
    size: u64
}

type Relaying: send {
    upstream: Connection,
    idle_ms: u64,
    size: u64
}

/// Runs in the stream's producer task. Each credit buys one read of at most
/// `size` decoded bytes, under a deadline set idle_ms after a fresh clock read.
/// Upstream EOF ends the stream; any error, the deadline included, fails it.
pub fn relay_body(take job: BodyRelay) waits {
    let BodyRelay(seed: take seed, upstream: take upstream, idle_ms, size) = take job
    stream.produce_owned(take seed, Relaying(upstream: take upstream, idle_ms, size), relay_next)
}

fn relay_next(mut r: Relaying) -> Result[Option[Bytes], Error] waits {
    r.upstream.deadline = clock.deadline_after_ms(host.mono_ns(r.upstream.clock), r.idle_ms)
    let mut chunk: Bytes = list.with_capacity(r.size)
    if read(mut r.upstream, mut chunk)? == 0 {
        return Ok(None)
    }
    Ok(Some(take chunk))
}

pub type Redirects: key + send = Follow(u8) | Return

pub type Limits: send {
    redirects: Redirects,
    body_max: u64,
    max_window: u64,
    conns_max: u16,
    waiters_max: u16,
    idle_ns: u64,
    decode: bool
}

pub fn limits(body_max: u64) -> Limits {
    Limits(redirects: Follow(10), body_max, max_window: 8388608, conns_max: 100, waiters_max: 256, idle_ns: 90000000000, decode: true)
}

pub type Pool = http_fetch.Pool

pub fn pool(n: Net, c: Clock, tasks: Tasks, take trust: Trust, cfg: Limits) -> Result[Pool, Capacity] {
    http_fetch.pool(n, c, tasks, take trust, cfg)
}

pub type Client = http_fetch.Client

pub fn handle(p: Pool) -> Client {
    http_fetch.handle(p)
}

pub type Endpoint = http_fetch.Endpoint

pub fn endpoint(cl: Client, base_url: String) -> Result[Endpoint, FetchError] {
    http_fetch.endpoint(cl, base_url)
}

pub type Fetch: send {
    method: String,
    url: String,
    headers: List[Header],
    body: List[Segment]
}

pub type Call: send {
    method: String,
    target: String,
    headers: List[Header],
    body: List[Segment]
}

pub type ContentCoding: key + send = Gzip | Deflate | Zstd

pub type CodingError: send = Unsupported | Flate(flate.FlateError) | Zstd(zstd.ZstdError)

pub type FetchError: send = Http(Error) | Url(uri.Error) | Scheme | UserInfo | Resolve(NetError) | NoAddress | Location | TooManyRedirects | CrossOriginSecret | CrossOrigin | Coding(CodingError) | Busy | Gone

pub type Response = http_fetch.Response

pub fn fetch(cl: Client, req: Fetch, deadline_ns: u64) -> Result[Response, FetchError] waits {
    http_fetch.fetch(cl, req, deadline_ns)
}

pub fn call(e: Endpoint, req: Call, deadline_ns: u64) -> Result[Response, FetchError] waits {
    http_fetch.call(e, req, deadline_ns)
}

pub fn fetch_all(cl: Client, req: Fetch, mut into: Bytes, deadline_ns: u64) -> Result[ResponseHead, FetchError] waits {
    http_fetch.fetch_all(cl, req, mut into, deadline_ns)
}

pub fn get(cl: Client, url: String, mut into: Bytes, deadline_ns: u64) -> Result[u16, FetchError] waits {
    http_fetch.get(cl, url, mut into, deadline_ns)
}

pub fn fetch_head(r: Response) -> View[ResponseHead] in r {
    http_fetch.head(r)
}

pub fn fetch_url(r: Response) -> View[String] in r {
    http_fetch.response_url(r)
}

pub fn fetch_coding(r: Response) -> Option[ContentCoding] {
    http_fetch.response_coding(r)
}

pub fn fetch_read(mut r: Response, mut into: Bytes) -> Result[u64, FetchError] waits {
    http_fetch.read(mut r, mut into)
}

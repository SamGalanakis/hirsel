type Leaf {
    n: u64
}
type Tree {
    root: u32,
    items: List[u64],
    leaf: Leaf
}
fn grow(mut t: Tree, items: List[u64]) {}
fn reset(mut t: Tree, leaf: Leaf) {}
fn by_list(mut t: Tree) { grow(mut t, t.items) }
fn by_record(mut t: Tree) { reset(mut t, t.leaf) }

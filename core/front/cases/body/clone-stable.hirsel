// FORM #117, MEM-17: a clone keeps the regions of its region parts, so a region reference,
// as the root or as an element, field or entry of what is cloned, is copied as its
// locator and its blob is shared. Through the core clone bodies (Deque, Map, Heap) it is
// the same reference at a region T. Every block a clone makes is charged as its own growth
// charges it, logical sizes rounded up to 8 (MEM-24, budgets.md), never native strides.
// Hand-derived: S {u8, u64, u8} is 24 bytes natively and 10 logical, held as 8 and counted
// 16; O has S's fields as an own record. A List of 2 references asks round8(2 * 16) = 32,
// of 3 Os round8(3 * 10) = 32, a Box[O] round8(10) = 16, a Box[S in r] round8(16) = 16, a
// Deque of 1 reference its 1 slot, 16. `used 0` on every run: each refund equals its charge.
// `native: run` lines are engine-only: Deque and Heap clone bodies are not in the
// evaluator's harness.
// expect: run bare() = 20
// expect: run listed() = 40
// expect: run optioned() = 20
// expect: run paired() = 25
// expect: run valued() = 20
// expect: run keyed() = 20
// expect: run boxed() = 20
// expect: run nested() = 40
// expect: run own_list() = 60
// expect: run own_box() = 20
// expect: run asked() = 1
// native: run dequed() = 20
// native: run heaped() = 20
// native: run deque_asked() = 16
@compact(u32)
type S: key + ordered {
    a: u8,
    b: u64,
    c: u8
}

type O {
    a: u8,
    b: u64,
    c: u8
}

type H[in r] {
    s: S in r,
    xs: List[u64]
}

fn bare() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let cloned: Result[S in r, Capacity] = clone(s)
        result.unwrap(take cloned).b
    }
}

fn listed() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let mut xs: List[S in r] = list.new()
        let _ = list.push(mut xs, s)
        let _ = list.push(mut xs, s)
        let cloned: Result[List[S in r], Capacity] = clone(xs)
        let mut e = result.unwrap(take cloned)
        option.unwrap(list.pop(mut e)).b + option.unwrap(list.pop(mut e)).b
    }
}

fn optioned() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let o: Option[S in r] = Some(s)
        let cloned: Result[Option[S in r], Capacity] = clone(o)
        option.unwrap(result.unwrap(take cloned)).b
    }
}

fn paired() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let o: (S in r, u64) = (s, 5)
        let cloned: Result[(S in r, u64), Capacity] = clone(o)
        let (t, k) = result.unwrap(take cloned)
        t.b + k
    }
}

fn valued() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let mut m: Map[u64, S in r] = map.new()
        let _ = map.insert(mut m, 1, s)
        let cloned: Result[Map[u64, S in r], Capacity] = clone(m)
        let mut e = result.unwrap(take cloned)
        option.unwrap(map.remove(mut e, 1)).b
    }
}

// The key is found by an equal reference in another block: the clone's keys hash by fields.
fn keyed() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let t = result.unwrap(make_s(r, 1, 20, 3))
        let mut m: Map[S in r, u64] = map.new()
        let _ = map.insert(mut m, s, 20)
        let cloned: Result[Map[S in r, u64], Capacity] = clone(m)
        let mut e = result.unwrap(take cloned)
        option.unwrap(map.remove(mut e, t))
    }
}

fn boxed() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let b: Box[S in r] = result.unwrap(box.new(s))
        let cloned: Result[Box[S in r], Capacity] = clone(b)
        let e = result.unwrap(take cloned)
        e.b
    }
}

fn nested() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let mut xs: List[H[in r]] = list.new()
        let _ = list.push(mut xs, H(s: s, xs: list.new()))
        let _ = list.push(mut xs, H(s: s, xs: list.new()))
        let cloned: Result[List[H[in r]], Capacity] = clone(xs)
        let mut e = result.unwrap(take cloned)
        option.unwrap(list.pop(mut e)).s.b + option.unwrap(list.pop(mut e)).s.b
    }
}

fn own_list() -> u64 {
    let mut xs: List[O] = list.new()
    let _ = list.push(mut xs, O(a: 1, b: 20, c: 3))
    let _ = list.push(mut xs, O(a: 1, b: 20, c: 3))
    let _ = list.push(mut xs, O(a: 1, b: 20, c: 3))
    let cloned: Result[List[O], Capacity] = clone(xs)
    let mut e = result.unwrap(take cloned)
    let x = option.unwrap(list.pop(mut e)).b
    let y = option.unwrap(list.pop(mut e)).b
    x + y + option.unwrap(list.pop(mut e)).b
}

fn own_box() -> u64 {
    let b: Box[O] = result.unwrap(box.new(O(a: 1, b: 20, c: 3)))
    let cloned: Result[Box[O], Capacity] = clone(b)
    let e = result.unwrap(take cloned)
    e.b
}

fn ask_refs[in r](xs: List[S in r]) -> u64 {
    match (bound bytes 0 {
        let c: Result[List[S in r], Capacity] = clone(xs)
        c
    }) {
        Ok(Error(e)) => e.requested,
        _ => 0
    }
}

fn ask_owns(xs: List[O]) -> u64 {
    match (bound bytes 0 {
        let c: Result[List[O], Capacity] = clone(xs)
        c
    }) {
        Ok(Error(e)) => e.requested,
        _ => 0
    }
}

// Each clone's first block, asked under a zero bound.
fn asked() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let mut xs: List[S in r] = list.new()
        let _ = list.push(mut xs, s)
        let _ = list.push(mut xs, s)
        let mut os: List[O] = list.new()
        let _ = list.push(mut os, O(a: 1, b: 20, c: 3))
        let _ = list.push(mut os, O(a: 1, b: 20, c: 3))
        let _ = list.push(mut os, O(a: 1, b: 20, c: 3))
        let b: Box[O] = result.unwrap(box.new(O(a: 1, b: 20, c: 3)))
        let q: Box[S in r] = result.unwrap(box.new(s))
        let x = match (bound bytes 0 {
            let c: Result[Box[O], Capacity] = clone(b)
            c
        }) {
            Ok(Error(e)) => e.requested,
            _ => 0
        }
        let y = match (bound bytes 0 {
            let c: Result[Box[S in r], Capacity] = clone(q)
            c
        }) {
            Ok(Error(e)) => e.requested,
            _ => 0
        }
        if ask_refs(xs) == 32 && ask_owns(os) == 32 && x == 16 && y == 16 {
            1
        } else {
            0
        }
    }
}

fn dequed() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let mut d: Deque[S in r] = deque.new()
        let _ = deque.push_back(mut d, s)
        let cloned: Result[Deque[S in r], Capacity] = clone(d)
        let mut e = result.unwrap(take cloned)
        option.unwrap(deque.pop_front(mut e)).b
    }
}

fn heaped() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let mut h: Heap[S in r] = heap.new()
        let _ = heap.push(mut h, s)
        let cloned: Result[Heap[S in r], Capacity] = clone(h)
        let mut e = result.unwrap(take cloned)
        option.unwrap(heap.pop(mut e)).b
    }
}

fn deque_asked() -> u64 {
    region r {
        let s = result.unwrap(make_s(r, 1, 20, 3))
        let mut d: Deque[S in r] = deque.new()
        let _ = deque.push_back(mut d, s)
        match (bound bytes 0 {
            let c: Result[Deque[S in r], Capacity] = clone(d)
            c
        }) {
            Ok(Error(e)) => e.requested,
            _ => 0
        }
    }
}

fn make_s(r: Region, a: u8, b: u64, c: u8) -> Result[S in r, Capacity] {
    match build_in(r, bytes 10, fn(mut d: Dest[S]) -> Result[Child[S], BuildError] {
        dest.put(mut d, S(a: a, b: b, c: c))
    }) {
        Ok(take built) => Ok(finish(take built)),
        Error(Capacity(capacity)) => Error(capacity),
        Error(Overflow) => fail("fixed document size"),
    }
}

// AP3 in memory: every page a commit or a cut left loose takes its canonical
// image, the one a load of that state builds.
pub fn canonical_roots(mut roots: Roots) -> Result[(), types.Failure] {
    page_result(std.page.canonicalize(mut roots.collections.root))?
    page_result(std.page.canonicalize(mut roots.streams.root))?
    page_result(std.page.canonicalize(mut roots.catalog.root))?
    for slot in 0u64 .. list.len(roots.keyed) {
        page_result(std.page.canonicalize(mut roots.keyed[slot].root))?
    }
    Ok(())
}

pub fn canonical_tree(mut tree: PageTree) -> Result[(), types.Failure] {
    page_result(std.page.canonicalize(mut tree.root))
}

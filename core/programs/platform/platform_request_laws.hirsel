// L49 `operator_request_identity` (launch.md "The operator socket"): a deploy is named by
// its client's 16-byte request ID D, durably. A Begin retried with the same D after the host
// is lost gets the recorded outcome and admits nothing; the same D with other content is a
// Conflict; an upload whose connection closes before its end releases its attempt, and the
// same Begin admits again under a fresh attempt; Status(D) still reports an installed
// request after a later deploy of the group.
@test
fn operator_request_identity(c: Clock, rnd: Random) -> Result[(), ()] waits {
    let mut r = rig(c, rnd, 4u64)
    add(mut r, "g", "t")
    op_wake(mut r, "g")
    let old = last(r, "g")
    let go = prepared(mut r, old)
    pump(mut r, take go)
    answer(mut r, old, PlaceInstalled(2u64, true))
    let first: Bytes = clone(r.req)
    expect(is_installed(phase_on(r, r.conn)), "L49: the owner was not sent Installed")
    let mut b = restart(take r, 4u64)
    let retry = begin_with(mut b, first, AttestedInput(image_two()))
    expect(is_installed(phase_on(b, retry)) && admits(b) == 0u64, "L49: a Begin retried after host loss admitted again or lost its outcome")
    let other = begin_with(mut b, first, AttestedInput(image()))
    expect(errored(b, other, ConflictClass) && admits(b) == 0u64, "L49: the same request ID with other content was not a Conflict")
    // (v2.71) The fates are part of Begin's canonical bytes.
    let mut release_all = runner.fate.none()
    release_all.all = Some(Release)
    let refated = begin_held(mut b, first, AttestedBegin(image_two()), take release_all)
    expect(errored(b, refated, ConflictClass) && admits(b) == 0u64, "L49: the same request ID and content with another held value was not a Conflict")
    // Entries out of path order are Invalid before any row is written.
    let mut unsorted = runner.fate.none()
    list.push(mut unsorted.entries, runner.fate.EntryFate(path: bytes_of(1u64, 98u8), fate: Release))
    list.push(mut unsorted.entries, runner.fate.EntryFate(path: bytes_of(1u64, 97u8), fate: Cancel))
    let disordered = begin_held(mut b, request_id(90u64), AttestedBegin(image_two()), take unsorted)
    expect(errored(b, disordered, InvalidClass) && admits(b) == 0u64, "L49: unsorted held entries were not Invalid")
    let cut = begin_new(mut b)
    let a1 = b.a
    expect(admits(b) == 1u64, "L49: a new request ID did not admit")
    hang_up(mut b, cut)
    expect(released(b, a1), "L49: an upload cut off before its end kept its attempt")
    let second: Bytes = clone(b.req)
    let _ = begin_with(mut b, second, AttestedInput(image_two()))
    expect(admits(b) == 2u64 && !same_attempt(a1, b.a), "L49: the repeated Begin did not admit again under a fresh attempt")
    // The second request reaches its own deploy row; the first's Status is unchanged.
    let mut ev: List[launcher.Event] = list.new()
    list.push(mut ev, Admitted(b.a, image_two(), summary_of(1u64, 1u64, launcher.no_grants()), ""))
    feed(mut b, take ev)
    assembled_new(mut b)
    expect(still_preparing(b), "L49: the second request did not reach its deploy row")
    expect(is_installed(status_of(mut b, first)), "L49: Status lost the installed request after a later deploy")
    unplug(mut b)
    Ok(())
}

// The Begin input that deploys `input` without the law gate.
fn ungated(input: operator.Input) -> operator.BeginInput {
    match input {
        AttestedInput(b) => AttestedBegin(clone(b)),
        PublicationInput(b) => PublicationBegin(clone(b)),
        SourceInput(b) => SourceBegin(clone(b), false),
    }
}

// The same private state path can acquire a new catalog while old receipts survive.
// Check the guard at host dispatch, including a Begin that could otherwise reserve D.
@test
fn replaced_catalog(d: Dir, c: Clock, rnd: Random, tasks: Tasks) -> Result[(), ()] waits {
    let mut prefix = string.with_capacity(64u64)
    string.push(mut prefix, "catalog-pin-")
    let root = result.unwrap(host.mkdtemp(d, mut prefix))
    result.unwrap(host.mkdir(root, "catalog"))
    let options = result.unwrap(store.sized(Directory, 2147483648u64))
    let first = result.unwrap(host.open_dir(root, "catalog"))
    let db = result.unwrap(store.open(tasks, first, c, rnd, options))
    let original = store.identity(db)
    let now = Now(wall_ms: T0, mono_ns: SECOND_NS)
    let mut a = rig_on(take db, launcher.fake(), 4u64, now)
    add(mut a, "g", "t")
    let Rig(h: take first_host, ..) = take a
    let _ = result.unwrap(store.close(close(take first_host)))
    let reopened = result.unwrap(store.open(tasks, first, c, rnd, options))
    expect(store.identity(reopened) == original, "reopen changed the authority")
    let _ = result.unwrap(store.close(take reopened))
    result.unwrap(host.remove_tree(root, "catalog"))
    result.unwrap(host.mkdir(root, "catalog"))
    let second = result.unwrap(host.open_dir(root, "catalog"))
    let other = result.unwrap(store.open(tasks, second, c, rnd, options))
    let replacement_id = store.identity(other)
    expect(replacement_id != original, "catalog replacement reused the authority")
    let mut b = rig_on(take other, launcher.fake(), 4u64, now)
    add(mut b, "g", "t")
    let g = option.unwrap(must(group_row(b.h, "g"), "group"))
    let id = request_id(77u64)
    let candidate: operator.Ask = BeginAsk(clone(id), group_of("g", g.incarnation), AttestedBegin(image_two()), list.new(), list.new(), runner.fate.none())
    send(mut b, 1u64, PinnedAsk(original.hi, original.lo, operator.ask_bytes(candidate)))
    expect(errored(b, 1u64, ConflictClass) && admits(b) == 0u64, "a pinned write reached the replacement catalog")
    let query = operator.ask_bytes(StatusAsk(clone(id)))
    send(mut b, 2u64, PinnedAsk(original.hi, original.lo, clone(query)))
    expect(errored(b, 2u64, ConflictClass), "a pinned read reached the replacement catalog")
    send(mut b, 3u64, PinnedAsk(replacement_id.hi, replacement_id.lo, take query))
    expect(errored(b, 3u64, UnknownRequestClass), "the refused write left a request row")
    let Rig(h: take second_host, ..) = take b
    let _ = result.unwrap(store.close(close(take second_host)))
    result.unwrap(host.remove_tree(d, prefix))
    Ok(())
}

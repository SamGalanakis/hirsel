pub fn law_typed_resident(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    // Catalog: 67 bytes, key 1||"rows" (5); r8 totals 72+8+62=142.
    if db.resident != 142 {
        return false
    }
    db.ceiling = 236
    if !typed_put(mut db, t, 1, 10) || db.resident != 236 {
        return false
    }
    let out = run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 2, 20)
    })
    match take out {
        Ok(Refused(f)) => if f.requested != 330 || f.available != 236 {
            return false
        },
        _ => return false
    }
    let removed = run(mut db, fn(mut tx: Tx) -> Result[bool, Error] {
        delete(mut tx, t, 1)
    })
    match take removed {
        Ok(Committed(done)) => if !done.value {
            return false
        },
        _ => return false
    }
    db.resident == 142
}


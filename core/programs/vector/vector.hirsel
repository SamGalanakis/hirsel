// Form A of a vector index (OPTIMAL-STORE-ENDSTATE §III.3): a covering
// entry index on the source table whose payload is each row's i8 code. It
// is written in the row's own transaction, so a query reads exactly the
// rows its transaction sees, and the store's builder backfills it.
pub type Metric = Dot | L2

// Shape is a form B shape that cannot be built: no dimensions, more than
// 4096 once padded to a power of two, or no clusters.
pub type Error = Store(store.Error) | Dimensions(u64, u64) | Shape(Shape) | IvfLayoutMismatch(u64)

pub type Hit[K] {
    key: K,
    score: i64
}

// A prefilter (Store 3.3): Every row, or Only the rows whose ordinal is a
// set bit. A row's ordinal is the index's declared `ordinal(key)`; an
// ordinal at or past the bitset's length is not in the filter.
pub type Filter = Every | Only(std.bitset.BitSet)

pub opaque type Vectors[K, V]: shareable + send {
    index: store.Index[(), K, V, List[i8]],
    metric: Metric,
    ordinal: StaticFn[fn(K) -> u64]
}

// Whether the row at `key` is in the filter. Every query applies it before
// it checks or scores the row's code.
fn allows[K](filter: Filter, ordinal: StaticFn[fn(K) -> u64], key: K) -> bool {
    match filter {
        Every => true,
        Only(bits) => {
            let at = (code.callable(ordinal))(key)
            at < std.bitset.len(bits) && std.bitset.get(bits, at)
        },
    }
}

// Every row has one entry under the same index key, so the entries scan
// in the table's primary key order.
fn every_row[K, V](_key: K, _value: V) -> Result[List[()], Capacity] {
    let mut keys: List[()] = list.new()
    list.push(mut keys, ())
    Ok(take keys)
}

pub fn declare[K, V](mut d: store.Declare, mut t: store.TableDecl[K, V], name: String, metric: Metric, extract: StaticFn[fn(K, V) -> Result[List[i8], Capacity]], ordinal: StaticFn[fn(K) -> u64]) -> Result[Vectors[K, V], store.Error] {
    let keys: StaticFn[fn(K, V) -> Result[List[()], Capacity]] = code.describe(every_row)
    let codes: std.codec.Codec[List[i8]] = std.codec.of_list()
    let index = store.covering(mut d, mut t, name, Many, keys, std.codec.key_of(), extract, codes)?
    Ok(Vectors(index: take index, metric: metric, ordinal: ordinal))
}

// The store's handle on the entry index, for the store's own index
// operations such as rebuild_index.
pub fn entry_index[K, V](v: Vectors[K, V]) -> store.Index[(), K, V, List[i8]] {
    clone(v.index)
}

// The exact score of one code against the query; a larger score is nearer.
// Dot is the inner product and L2 the negated squared Euclidean distance.
// Both vectors have the same length, which the caller checks.
pub fn score(metric: Metric, q: List[i8], code: List[i8]) -> i64 {
    let mut total = 0i64
    for i in 0u64 .. list.len(q) {
        let a: i64 = int.widen(q[i])
        let c: i64 = int.widen(code[i])
        match metric {
            Dot => {
                total += a * c
            },
            L2 => {
                total -= (a - c) * (a - c)
            },
        }
    }
    total
}

// `score` over a code lent as its stored bytes, each a signed byte.
fn score_lent(metric: Metric, q: List[i8], code: Bytes) -> i64 {
    let mut total = 0i64
    for i in 0u64 .. list.len(q) {
        let a: i64 = int.widen(q[i])
        let signed: i8 = int.truncate(code[i])
        let c: i64 = int.widen(signed)
        match metric {
            Dot => {
                total += a * c
            },
            L2 => {
                total -= (a - c) * (a - c)
            },
        }
    }
    total
}

// Keeps the k best hits in rank order: score descending, then scan order.
// A later entry ranks after an earlier one with the same score, so a full
// list admits only a strictly better hit.
fn keep[K](mut best: List[Hit[K]], k: u64, take hit: Hit[K]) {
    let count = list.len(best)
    if count == k && best[count - 1].score >= hit.score {
        return
    }
    let mut at = count
    while at > 0 && best[at - 1].score < hit.score {
        at -= 1
    }
    std.list.insert(mut best, at, take hit)
    if list.len(best) > k {
        list.truncate(mut best, k)
    }
}

// The k nearest rows to `q` among the rows `tx` sees that `filter`
// allows, nearest first. Equal scores rank in increasing primary key
// order. Every allowed row's code must have the query's length; one that
// does not refuses the query with Dimensions(query length, code length). A
// row outside the filter is skipped before its code is checked or scored.
pub fn query[K, V](tx: store.Tx, v: Vectors[K, V], q: List[i8], k: u64, filter: Filter) -> Result[List[Hit[K]], Error] {
    let mut best: List[Hit[K]] = list.new()
    let mut entries = store.entries(tx, v.index, Unbounded, Unbounded) ?=> |e| Store(e)
    if k == 0 {
        return Ok(take best)
    }
    let width = list.len(q)
    // Store lends each current-schema code from the page; a hit is copied out only when
    // it would enter the top k.
    while let Some(step) = (store.next_i8_entry(mut entries, scoped fn(take key: K, code: store.I8Code) -> Result[Option[Hit[K]], Error] {
        if let Only(_) = filter {
            if !allows(filter, v.ordinal, key) {
                return Ok(None)
            }
        }
        let total = match code {
            Lent(raw) => {
                let actual = list.len(raw)
                if actual != width {
                    return Error(Dimensions(width, actual))
                }
                score_lent(v.metric, q, raw)
            },
            Owned(owned) => {
                let actual = list.len(owned)
                if actual != width {
                    return Error(Dimensions(width, actual))
                }
                score(v.metric, q, owned)
            },
        }
        let count = list.len(best)
        if count == k && best[count - 1].score >= total {
            return Ok(None)
        }
        Ok(Some(Hit(key: take key, score: total)))
    }) ?=> |e| Store(e)) {
        if let Some(take hit) = step? {
            keep(mut best, k, take hit)
        }
    }
    Ok(take best)
}

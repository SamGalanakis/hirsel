type ObjectJournalStart: send {
    requests: std.object.Requests,
    register: history.HistoryRegister,
    authority: Bytes,
    buffers: history.HistoryBuffers,
    op_ms: u64,
    failed_polls: u32,
    sweep: manifest.SweepCursor,
    archive_on: u64,
    issued_generation: u64,
    next_pack: u64,
    export_lease: Option[ObjectExportLease],
    reclaim: Option[ObjectReclaimCapture],
    weak: Option[WeakPublisher],
    // An attached Place's slot: its frames go to the host stream (§12.11.4).
    stream: Option[host_stream.SlotLink]
}

type ObjectJournalTask: send {
    ready: Receiver[ObjectJournalStart],
    receive: Receiver[JournalMsg],
    acks: Sender[journal.Ack],
    notices: Sender[journal.WriteNotice],
    synced: Sender[()],
    group_bytes: u64,
    group_commits: u64,
    idle: Option[Sender[()]],
    health_signal: Option[ObjectHealthSignal],
    reclaims: Option[Latest[ReclaimFailures]]
}

fn history_probe_writer(mut client: std.object.Client, mut register: history.HistoryRegister, mut workspace: history.HistoryBuffers, deadline: u64) -> Result[(), Error] waits {
    let result = failure_result_from_rep(history.history_probe_head(mut client, history.register_tag(register), mut workspace.witness, deadline))?
    if let Some((capture, _)) = result {
        failure_result_from_rep(manifest.check_expected_store(Some(history.register_head(register).store), capture.head.store))?
        if !history.history_pair_matches(capture.head.pair, history.register_head(register).pair) {
            let fenced: Error = Fenced(history.register_head(register).pair.epoch)
            history.fence_register(mut register, failure_to_rep(clone(fenced)))
            return Error(fenced)
        }
    }
    Ok(())
}

fn history_probe_writer_attach(mut client: std.object.Client, mut register: history.HistoryRegister, mut workspace: history.HistoryBuffers, deadline: u64) -> Result[(), Error] waits {
    let result = failure_result_from_rep(history.history_probe_head_attach(mut client, history.register_tag(register), mut workspace.witness, deadline))?
    if let Some((capture, _)) = result {
        failure_result_from_rep(manifest.check_expected_store(Some(history.register_head(register).store), capture.head.store))?
        if !history.history_pair_matches(capture.head.pair, history.register_head(register).pair) {
            let fenced: Error = Fenced(history.register_head(register).pair.epoch)
            history.fence_register(mut register, failure_to_rep(clone(fenced)))
            return Error(fenced)
        }
    }
    Ok(())
}

type ObjectJournalSession {
    client: std.object.Client,
    register: history.HistoryRegister,
    authority: Bytes,
    buffers: history.HistoryBuffers,
    op_ms: u64,
    failed_polls: u32,
    sweep: manifest.SweepCursor,
    archive_on: u64,
    issued_generation: u64,
    next_pack: u64,
    export_lease: Option[ObjectExportLease],
    reclaim: Option[ObjectReclaimCapture],
    weak: Option[WeakPublisher],
    // An attached Place's slot: its frames go to the host stream (§12.11.4).
    stream: Option[host_stream.SlotLink]
}

fn object_journal_begin(take input: ObjectJournalStart) -> ObjectJournalSession {
    let ObjectJournalStart(requests: take requests, register: take register, authority: take authority, buffers: take buffers, op_ms, failed_polls, sweep, archive_on, issued_generation, next_pack, export_lease: take export_lease, reclaim, weak: take weak, stream: take stream) = take input
    ObjectJournalSession(client: std.object.attach(take requests, None), register: take register, authority: take authority, buffers: take buffers, op_ms, failed_polls, sweep, archive_on, issued_generation, next_pack, export_lease: take export_lease, reclaim, weak: take weak, stream: take stream)
}

fn object_journal_pause(take active: ObjectJournalSession) -> ObjectJournalStart {
    let ObjectJournalSession(client: take client, register: take register, authority: take authority, buffers: take buffers, op_ms, failed_polls, sweep, archive_on, issued_generation, next_pack, export_lease: take export_lease, reclaim, weak: take weak, stream: take stream) = take active
    let (take requests, _) = std.object.split(take client)
    ObjectJournalStart(requests: take requests, register: take register, authority: take authority, buffers: take buffers, op_ms, failed_polls, sweep, archive_on, issued_generation, next_pack, export_lease: take export_lease, reclaim, weak: take weak, stream: take stream)
}

fn object_journal_advance(mut lane: ObjectJournalSession, sequence: u64) -> Result[(), Error] waits {
    let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
    let mut candidate = history.register_head(lane.register)
    let next_position = failure_result_from_rep(history.history_next_id(candidate.entry.seq))?
    candidate.entry = history.history_new_ref(next_position, candidate.pair.epoch, lane.buffers.packet)
    let weak_barrier = view lane.weak
    let advanced = failure_result_from_rep(history.history_register_publish(mut lane.client, mut lane.register, candidate, lane.authority, mut lane.buffers, due, scoped fn(created: u64) {
        if let Some(publisher) = weak_barrier {
            weak_publish(publisher, candidate, created, sequence)
        }
    }))
    match take advanced {
        Ok(HistoryApplied(_)) => Ok(()),
        Error(take e) => Error(take e),
        _ => Error(Undecided),
    }
}

fn object_journal_add(mut lane: ObjectJournalSession, ctx: format.DiskContext, frame: Bytes) -> Result[(), Error] {
    let bytes_wanted = list.len(frame)
    failure_result_from_rep(types.capacity(list.try_reserve(mut lane.buffers.packet, bytes_wanted + format.BINDING_BYTES)))?
    failure_result_from_rep(host_stream.history_group_append(mut lane.buffers.packet, ctx, frame))
}

// Sends one streamed group to the slot without waiting on the reply connection;
// the relay task delivers `SlotAck` back into `object_journal_loop`.
fn object_journal_stream_send(link: host_stream.SlotLink, input: ObjectJournalTask, take raw: Bytes, sequence: u64, mut queued: List[(Bytes, u64)], mut deferred: Option[JournalMsg]) -> Result[(u64, u64), Error] waits {
    failure_result_from_rep(host_stream.slot_send(link, raw, sequence))?
    let mut group_size = list.len(raw)
    let mut last_sequence = sequence
    let mut taken = 1u64
    while taken < input.group_commits && list.len(queued) != 0 {
        let width = list.len(queued[0u64].0)
        if group_size + width > input.group_bytes {
            break
        }
        let (take next_raw, next_seq) = list.remove(mut queued, 0u64)
        failure_result_from_rep(host_stream.slot_send(link, next_raw, next_seq))?
        group_size += width
        last_sequence = next_seq
        taken += 1
    }
    while taken < input.group_commits {
        match channel.try_receive(input.receive) {
            Ok(Frame(take follower_frame, following)) => {
                let width = list.len(follower_frame)
                if group_size + width > input.group_bytes {
                    deferred = Some(Frame(take follower_frame, following))
                    break
                }
                failure_result_from_rep(host_stream.slot_send(link, follower_frame, following))?
                group_size += width
                last_sequence = following
                taken += 1
            },
            Ok(take control) => {
                deferred = Some(take control)
                break
            },
            Error(_) => break,
        }
    }
    host_stream.slot_ring(link)
    Ok((last_sequence, group_size))
}

fn object_journal_stream_advance_batch(mut lane: ObjectJournalSession, batch_seq: u64, record_commit: bool) {
    if let Some(mut link) = lane.stream {
        host_stream.slot_advance_batch(mut link, batch_seq, record_commit)
    }
}

fn object_journal_stream_trim_batches(mut lane: ObjectJournalSession, from_seq: u64) {
    if let Some(mut link) = lane.stream {
        host_stream.slot_trim_batches(mut link, from_seq)
    }
}

fn object_journal_loop(take input: ObjectJournalTask, take initial: ObjectJournalStart) -> Result[(), Error] waits {
    let mut lane = object_journal_begin(take initial)
    let mut written = 0u64
    let mut deferred: Option[JournalMsg] = None
    let mut idle_position: Option[u64] = None
    // A failed reclaim stays pending and runs again only after the loop has
    // taken a message (a write, the idle check, a pause), never back to back.
    let mut reclaim_due = true
    let mut failed_reclaims = 0u64
    // The pending reclaim failed and waits for a retry (`attention`).
    let mut reclaim_failed = false
    // Attached Place streaming state (§12.11.4, §12.11.6, §12.11.12).
    let mut stream_in_flight: Option[(u64, u64)] = None
    let mut is_stalled = false
    let mut stream_awaiting_fence = false
    let mut stream_queued: List[(Bytes, u64)] = list.new()
    if let Some(link) = lane.stream {
        host_stream.slot_report_head(link, store_key_to_rep(store_key_from_rep(history.register_head(lane.register).store)), history.register_attach(lane.register), host_stream.slot_last_batch(link))
    }
    loop {
        if let Some(terminal) = history.register_terminal(lane.register) {
            return match terminal {
                HistoryFault(problem) => Error(failure_from_rep(clone(problem))),
                HistoryUnknown => Error(Undecided),
            }
        }
        let selected = match replace(mut deferred, None) {
            Some(take pending) => take pending,
            None => match channel.try_receive(input.receive) {
                Ok(take queued) => take queued,
                Error(Empty) => {
                    if reclaim_due {
                        if let Some(take pending_reclaim) = replace(mut lane.reclaim, None) {
                            match history_execute_reclaim(mut lane, pending_reclaim) {
                                Ok(()) => if reclaim_failed {
                                    reclaim_failed = false
                                    if let Some(shared) = input.reclaims {
                                        latest.publish(shared, arc.new(ReclaimFailures(count: failed_reclaims, pending: false)))
                                    }
                                },
                                Error(Fenced(e)) => return Error(Fenced(e)),
                                Error(_) => {
                                    lane.reclaim = Some(take pending_reclaim)
                                    reclaim_due = false
                                    failed_reclaims = int.saturating_add(failed_reclaims, 1)
                                    reclaim_failed = true
                                    if let Some(shared) = input.reclaims {
                                        latest.publish(shared, arc.new(ReclaimFailures(count: failed_reclaims, pending: true)))
                                    }
                                },
                            }
                            continue
                        }
                    }
                    if idle_position == None {
                        if let Some(timer) = input.idle {
                            if let Ok(()) = channel.try_send(timer, ()) {
                                idle_position = Some(written)
                            }
                        }
                    }
                    match channel.receive(input.receive) {
                        Ok(take received) => take received,
                        Error(_) => return Ok(()),
                    }
                },
                Error(Closed) => return Ok(()),
            },
        }
        reclaim_due = true
        match take selected {
            Frame(take raw, sequence) => {
                let use_stream = match history.register_attach(lane.register) {
                    Some(a) => match a.live {
                        Some(_) => true,
                        None => false,
                    },
                    None => false,
                }
                if use_stream {
                    if let Some(link) = lane.stream {
                        if stream_in_flight != None || is_stalled || stream_awaiting_fence {
                            failure_result_from_rep(types.capacity(list.try_reserve(mut stream_queued, 1)))?
                            list.push(mut stream_queued, (take raw, sequence))
                            continue
                        }
                        let (last_sequence, group_size) = object_journal_stream_send(link, input, take raw, sequence, mut stream_queued, mut deferred)?
                        stream_in_flight = Some((last_sequence, group_size))
                        continue
                    }
                }
                // Under archival (§12.11.11 M6), a direct-service entry rewrites
                // any remaining sealed tails in order before writing above them.
                if lane.archive_on != 0 {
                    let has_sealed = match history.register_attach(lane.register) {
                        Some(a) => list.len(a.sealed) != 0,
                        None => false,
                    }
                    if has_sealed {
                        let (take settled, take outcome) = settle_worker_sealed(take lane, input.group_bytes, input.group_commits)
                        lane = take settled
                        match outcome? {
                            SettleApplied => (),
                            SettleFenced(_, _) => return Error(Fenced(history.register_head(lane.register).pair.epoch)),
                            SettleNotApplied => return Error(Undecided),
                        }
                    }
                }
                let ctx = failure_result_from_rep(host_stream.history_group_context(history.register_head(lane.register)))?
                failure_result_from_rep(history.history_packet_header(mut lane.buffers.packet, ctx, history.register_head(lane.register).pair.epoch, history.register_head(lane.register).authority_kind, history.register_head(lane.register).entry))?
                object_journal_add(mut lane, ctx, raw)?
                let mut group_size = list.len(raw)
                let mut last_sequence = sequence
                for _ in 1u64 .. input.group_commits {
                    match channel.try_receive(input.receive) {
                        Ok(Frame(take follower_frame, following)) => {
                            let width = list.len(follower_frame)
                            if group_size + width > input.group_bytes {
                                deferred = Some(Frame(take follower_frame, following))
                                break
                            }
                            object_journal_add(mut lane, ctx, follower_frame)?
                            group_size += width
                            last_sequence = following
                        },
                        Ok(take control) => {
                            deferred = Some(take control)
                            break
                        },
                        Error(_) => break,
                    }
                }
                list.clear(mut lane.buffers.compare)
                failure_result_from_rep(types.capacity(list.try_reserve(mut lane.buffers.compare, list.len(lane.buffers.packet))))?
                object_journal_advance(mut lane, last_sequence)?
                written += group_size
                if let Error(_) = channel.send(input.acks, ObjectJournaled(last_sequence, written, history.register_head(lane.register).entry.seq - history.register_head(lane.register).checkpoint.seq)) {
                    return Ok(())
                }
                if let Some(publisher) = lane.weak {
                    weak_notify_strong(publisher.notices)
                }
                let _ = channel.try_send(input.synced, ())
                if lane.failed_polls != 0 {
                    lane.failed_polls = 0
                    if let Some(signal) = input.health_signal {
                        emit_health(signal, Ok(0))
                    }
                }
            },
            StreamAnswer(take ack) => {
                match take ack {
                    SlotAcked(through, batch_seq) => {
                        object_journal_stream_advance_batch(mut lane, batch_seq, through > 0)
                        is_stalled = false
                        if let Some((in_seq, in_bytes)) = stream_in_flight {
                            if through >= in_seq {
                                stream_in_flight = None
                                written += in_bytes
                                if let Error(_) = channel.send(input.acks, ObjectJournaled(in_seq, written, history.register_head(lane.register).entry.seq - history.register_head(lane.register).checkpoint.seq)) {
                                    return Ok(())
                                }
                                let _ = channel.try_send(input.synced, ())
                            }
                        }
                        if !stream_awaiting_fence && stream_in_flight == None && list.len(stream_queued) != 0 {
                            if let Some(link) = lane.stream {
                                let (take next_raw, next_seq) = list.remove(mut stream_queued, 0u64)
                                let (last_sequence, group_size) = object_journal_stream_send(link, input, take next_raw, next_seq, mut stream_queued, mut deferred)?
                                stream_in_flight = Some((last_sequence, group_size))
                            }
                        }
                    },
                    SlotPollHead => {
                        is_stalled = true
                        if !stream_awaiting_fence {
                            let (take polled, take outcome) = with_object_settle(take lane, host_stream.stream_poll_head)
                            lane = take polled
                            if let Ok(Some((moved_epoch, cutoff))) = outcome {
                                stream_awaiting_fence = true
                                if let Some(link) = lane.stream {
                                    host_stream.slot_report(link, ReportFenced(host_stream.slot_number(link), history.register_head(lane.register).store, history.register_head(lane.register).pair.epoch, moved_epoch, cutoff))
                                }
                            }
                        }
                    },
                    SlotSettle(settle_id, through_seq, next_seq) => {
                        is_stalled = true
                        if !stream_awaiting_fence {
                            let (take settled, take outcome) = stream_settle(take lane, through_seq, next_seq, false, input.group_bytes, input.group_commits)
                            lane = take settled
                            match take outcome {
                                Ok(SettleApplied) => {
                                    object_journal_stream_advance_batch(mut lane, through_seq, false)
                                    let (fseq, fframe) = match history.register_attach(lane.register) {
                                        Some(a) => match a.live {
                                            Some(r) => (r.from_seq, r.from_frame),
                                            None => (0u64, 0u32),
                                        },
                                        None => (0u64, 0u32),
                                    }
                                    object_journal_stream_trim_batches(mut lane, fseq)
                                    if let Some(link) = lane.stream {
                                        host_stream.slot_report_head(link, store_key_to_rep(store_key_from_rep(history.register_head(lane.register).store)), history.register_attach(lane.register), through_seq)
                                        host_stream.slot_report(link, ReportSettled(host_stream.slot_number(link), history.register_head(lane.register).store, history.register_head(lane.register).pair.epoch, settle_id, true, history.register_head(lane.register).entry.seq, fseq, fframe))
                                    }
                                },
                                Ok(SettleFenced(moved_epoch, cutoff)) => {
                                    stream_awaiting_fence = true
                                    if let Some(link) = lane.stream {
                                        host_stream.slot_report(link, ReportFenced(host_stream.slot_number(link), history.register_head(lane.register).store, history.register_head(lane.register).pair.epoch, moved_epoch, cutoff))
                                    }
                                },
                                _ => {
                                    if let Some(link) = lane.stream {
                                        host_stream.slot_report(link, ReportSettled(host_stream.slot_number(link), history.register_head(lane.register).store, history.register_head(lane.register).pair.epoch, settle_id, false, 0, 0, 0))
                                    }
                                },
                            }
                        }
                    },
                    SlotFenced(epoch, ok_through, missing) => {
                        if !missing && ok_through > 0 {
                            if let Some((_, in_bytes)) = stream_in_flight {
                                written += in_bytes
                            }
                            let _ = channel.send(input.acks, ObjectJournaled(ok_through, written, history.register_head(lane.register).entry.seq - history.register_head(lane.register).checkpoint.seq))
                            let _ = channel.try_send(input.synced, ())
                        }
                        if missing {
                            return Error(Undecided)
                        }
                        return Error(Fenced(epoch))
                    },
                    SlotLatched(cause) => return Error(Latched(cause)),
                    SlotGranted(_, _) => (),
                }
            },
            ObjectClose(take close_reply) => {
                let close_info: Option[u64] = match lane.stream {
                    Some(link) => match history.register_attach(lane.register) {
                        Some(_) => Some(host_stream.slot_last_batch(link)),
                        None => None,
                    },
                    None => None,
                }
                if let Some(last_seq) = close_info {
                    let (take settled, take outcome) = stream_settle(take lane, last_seq, last_seq + 1, true, input.group_bytes, input.group_commits)
                    lane = take settled
                    match take outcome {
                        Ok(SettleApplied) => {
                            if let Some(link) = lane.stream {
                                let no_attach: Option[format.Attach] = None
                                host_stream.slot_report_head(link, store_key_to_rep(store_key_from_rep(history.register_head(lane.register).store)), no_attach, last_seq)
                                host_stream.slot_report(link, ReportDetached(host_stream.slot_number(link), history.register_head(lane.register).store, history.register_head(lane.register).pair.epoch))
                            }
                            let done_ok: Result[(), Error] = Ok(())
                            let _ = channel.send(close_reply, take done_ok)
                            return Ok(())
                        },
                        Ok(SettleFenced(moved_epoch, cutoff)) => {
                            if let Some(link) = lane.stream {
                                host_stream.slot_report(link, ReportFenced(host_stream.slot_number(link), history.register_head(lane.register).store, history.register_head(lane.register).pair.epoch, moved_epoch, cutoff))
                            }
                            let problem: Error = Fenced(history.register_head(lane.register).pair.epoch)
                            let _ = channel.send(close_reply, Error(clone(problem)))
                            return Error(take problem)
                        },
                        Ok(SettleNotApplied) => {
                            let _ = channel.send(close_reply, Error(Undecided))
                            return Error(Undecided)
                        },
                        Error(take problem) => {
                            let _ = channel.send(close_reply, Error(clone(problem)))
                            return Error(take problem)
                        },
                    }
                }
                let done_ok: Result[(), Error] = Ok(())
                let _ = channel.send(close_reply, take done_ok)
                return Ok(())
            },
            Barrier => {
                let _ = channel.try_send(input.notices, Written)
            },
            IdleCheck => {
                let armed_at = replace(mut idle_position, None)
                if armed_at != None && armed_at != Some(written) {
                    continue
                }
                let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
                let observed = history_probe_writer(mut lane.client, mut lane.register, mut lane.buffers, due)
                let previous = lane.failed_polls
                match take observed {
                    Ok(()) => {
                        lane.failed_polls = 0
                    },
                    Error(Fenced(e)) => return Error(Fenced(e)),
                    Error(_) => {
                        lane.failed_polls = int.saturating_add(lane.failed_polls, 1)
                    },
                }
                if previous != lane.failed_polls {
                    if let Some(signal) = input.health_signal {
                        emit_health(signal, Ok(lane.failed_polls))
                    }
                }
            },
            ObjectFresh(take destination, deadline) => {
                let due = order.min(deadline, std.object.deadline_after_ms(lane.client, lane.op_ms))
                let observed = object_journal_fresh_probe(mut lane, due)
                let terminal = match observed {
                    Error(Fenced(e)) => Some(e),
                    _ => None
                }
                let _ = channel.send(destination, take observed)
                if let Some(e) = terminal {
                    return Error(Fenced(e))
                }
            },
            ObjectSkipFence(take destination) => {
                let observed: Result[(), Error] = if stream_awaiting_fence {
                    let fenced: Error = Fenced(history.register_head(lane.register).pair.epoch)
                    history.fence_register(mut lane.register, failure_to_rep(clone(fenced)))
                    Error(fenced)
                } else {
                    let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
                    history_probe_writer_attach(mut lane.client, mut lane.register, mut lane.buffers, due)
                }
                let terminal = match observed {
                    Error(Fenced(e)) => Some(e),
                    _ => None
                }
                if let Some(e) = terminal {
                    if let Some(signal) = input.health_signal {
                        emit_health(signal, health_failure(Fenced(e)))
                    }
                }
                let _ = channel.send(destination, take observed)
                if let Some(e) = terminal {
                    return Error(Fenced(e))
                }
            },
            ObjectExportRead(take request) => {
                let journal.ObjectExportFetch(key: take key, reference, buffer: take buffer, reply: take outlet) = take request
                let read = object_export_read(mut lane, key, reference, take buffer)
                let _ = channel.send(outlet, failure_result_to_rep(take read))
            },
            ObjectPause(take pause_response, take resuming) => {
                let owner = object_journal_pause(take lane)
                if let Error(_) = channel.send(pause_response, take owner) {
                    return Ok(())
                }
                match channel.receive(resuming) {
                    Ok(take restored) => {
                        lane = object_journal_begin(take restored)
                    },
                    _ => return Ok(()),
                }
            },
            Rotate(..) => fail("object journal received a segment rotation"),
            Flush => fail("object journal received a Directory flush"),
        }
    }
}

fn object_journal_fresh_probe(mut lane: ObjectJournalSession, due: u64) -> Result[(), Error] waits {
    let is_attached = match history.register_attach(lane.register) {
        Some(_) => true,
        None => false,
    }
    if !is_attached {
        return history_probe_writer(mut lane.client, mut lane.register, mut lane.buffers, due)
    }
    let live_opt: Option[format.StreamRef] = match history.register_attach(lane.register) {
        Some(a) => a.live,
        None => None,
    }
    let head = history.register_head(lane.register)
    let store = head.store
    let epoch = head.pair.epoch
    if let Some(tail) = live_opt {
        if let Some(link) = lane.stream {
            let dir = host_stream.stream_key(host_stream.slot_root(link), host_stream.stream_dir(host_stream_id_to_rep(host_stream_id_from_rep(tail.sid))))
            let reg = host_stream.stream_at_root(mut lane.client, scoped fn(mut c: std.object.Client) -> Result[format.StreamRegister, Error] waits {
                failure_result_from_rep(host_stream.stream_reg_fetch_once(mut c, dir, host_stream_id_to_rep(host_stream_id_from_rep(tail.sid)), host_stream.slot_max_rows(link), due))
            })?
            if reg.inc != tail.inc || reg.collecting {
                return Error(Latched(Superseded))
            }
            if host_stream.stream_follow_reg_has_row(reg, store_key_to_rep(store_key_from_rep(store)), epoch) {
                return Error(Behind(Position(store: store_key_from_rep(store), branch: 0, version: 0)))
            }
        }
    }
    let _ = failure_result_from_rep(history.history_fetch(mut lane.client, "head", mut lane.buffers.witness, due))?
    let (take capture, _) = failure_result_from_rep(history.history_decode_head_attach(lane.buffers.witness))?
    failure_result_from_rep(manifest.check_expected_store(Some(store), capture.head.store))?
    if !history.history_pair_matches(capture.head.pair, head.pair) {
        let fenced: Error = Fenced(epoch)
        history.fence_register(mut lane.register, failure_to_rep(clone(fenced)))
        return Error(fenced)
    }
    Ok(())
}

fn object_journal_worker(take input: ObjectJournalTask) -> Result[(), Error] waits {
    let initial = match channel.receive(input.ready) {
        Ok(take ready) => take ready,
        Error(_) => return Ok(()),
    }
    let signals = match input.health_signal {
        Some(signal) => Some(ObjectHealthSignal(value: latest.handle(signal.value), terminal: channel.sender(signal.terminal))),
        None => None,
    }
    let acks = channel.sender(input.acks)
    let synced = channel.sender(input.synced)
    let weak_wakes = weak_notice_senders(initial.weak)
    let failure = object_journal_loop(take input, take initial)
    if let Error(problem) = failure {
        if let Some(signal) = signals {
            emit_health(signal, health_failure(problem))
        }
        let _ = channel.send(acks, ObjectBroken(failure_to_rep(clone(problem))))
        weak_notify_strong(weak_wakes)
        let _ = channel.try_send(synced, ())
    }
    take failure
}

// Forwards service answers on a Place's reply connection into the Place's
// journal worker channel so an idle or stalled Place reacts without blocking.
type SlotRelayInput: send {
    answers: Inbox[journal.SlotAck],
    journal: Sender[JournalMsg]
}

fn slot_relay(take input: SlotRelayInput) waits {
    let SlotRelayInput(answers: take answers, journal: take journal) = take input
    loop {
        match conn.receive(answers) {
            Ok(take ack) => {
                if let Error(_) = channel.send(journal, StreamAnswer(take ack)) {
                    return
                }
            },
            Error(_) => return,
        }
    }
}

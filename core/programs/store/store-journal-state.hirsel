pub const JOURNAL_WORKER_SLACK: u64 = 32768

pub type GroupClose: cross = Size | EarlySync | Immediate | Boundary

pub type DirJournalMsg: send = Group(Bytes, u64, u64, u32, GroupClose, u64) | Oversized(Bytes, Bytes, u64, u64) | Rotate(HostFile, HostFile) | Barrier | ReadStats(Sender[JournalStats])

/// Successful Directory journal I/O since open. Segment writes include creation
/// and window extension. END writes include creation and the five cadence reasons.
/// The frame histogram has exact bins from 1 through 64 and a final 65+ bin.
pub type JournalStats: send {
    segment_writes: u64,
    window_writes: u64,
    creations: u64,
    end_writes: u64,
    frames: u64,
    frames_per_group: Inline[u64, 65],
    group_size: u64,
    group_early_sync: u64,
    group_immediate: u64,
    group_boundary: u64,
    end_deadline: u64,
    end_cap: u64,
    end_idle: u64,
    end_rotate: u64,
    end_close: u64,
    group_durable_ns: u64,
    ticket_waits: u64,
    ticket_wait_ns: u64
}

fn empty_journal_stats() -> JournalStats {
    JournalStats(segment_writes: 0, window_writes: 0, creations: 0, end_writes: 0, frames: 0, frames_per_group: [0; 65], group_size: 0, group_early_sync: 0, group_immediate: 0, group_boundary: 0, end_deadline: 0, end_cap: 0, end_idle: 0, end_rotate: 0, end_close: 0, group_durable_ns: 0, ticket_waits: 0, ticket_wait_ns: 0)
}

pub type DirAck: send = DirJournaled(u64, u64) | DirBroken(IoError)

pub type QueueAccounting {
    journaled: u64,
    inflight: u64,
    uncovered: u64,
    since_cut: u64,
    acked_bytes: u64,
    poison: Option[IoError]
}

pub fn queue_accounting(uncovered: u64) -> QueueAccounting {
    QueueAccounting(journaled: 0, inflight: 0, uncovered: uncovered, since_cut: 0, acked_bytes: 0, poison: None)
}

pub opaque type RecordRetention {
    first: u64,
    main_after: u64
}

pub fn record_retention(first: u64, main_after: u64) -> RecordRetention {
    RecordRetention(first: first, main_after: main_after)
}

pub fn first_live(retention: RecordRetention) -> u64 {
    retention.first
}

pub fn retained_after(retention: RecordRetention) -> u64 {
    retention.main_after
}

pub opaque type DirJournalState {
    lock: HostFile,
    d: Dir,
    creation: Bytes,
    file_seq: u64,
    file_end: u64,
    group: GroupHead,
    head_managed: bool,
    creations: u64,
    ticket_waits: u64,
    ticket_wait_ns: u64,
    journal: Sender[DirJournalMsg],
    acks: Receiver[DirAck],
    accounting: QueueAccounting,
    written: Receiver[WriteNotice],
    written_send: Sender[WriteNotice],
    synced: Option[Receiver[()]],
    writer: Task[Result[(), types.Failure]]
}

pub type DirJournalChannels {
    frames: Sender[DirJournalMsg],
    queued: Receiver[DirJournalMsg],
    acks: Sender[DirAck],
    received: Receiver[DirAck],
    ready: Sender[Result[(), Capacity]],
    waiting: Receiver[Result[(), Capacity]],
    written_send: Sender[WriteNotice],
    written_receive: Receiver[WriteNotice],
    synced_send: Sender[()],
    synced_receive: Receiver[()]
}

pub fn dir_journal_channels() -> DirJournalChannels {
    let (frames, queued): (Sender[DirJournalMsg], Receiver[DirJournalMsg]) = channel.new(1)
    // At most one group in the worker, one capped group and one oversized
    // frame from this call, followed by a failure. The head polls before admission.
    let (acks, received): (Sender[DirAck], Receiver[DirAck]) = channel.new(4)
    let (ready, waiting): (Sender[Result[(), Capacity]], Receiver[Result[(), Capacity]]) = channel.new(1)
    let (written_send, written_receive): (Sender[WriteNotice], Receiver[WriteNotice]) = channel.new(2)
    let (synced_send, synced_receive): (Sender[()], Receiver[()]) = channel.new(1)
    DirJournalChannels(frames: take frames, queued: take queued, acks: take acks, received: take received, ready: take ready, waiting: take waiting, written_send: take written_send, written_receive: take written_receive, synced_send: take synced_send, synced_receive: take synced_receive)
}

pub type DirJournalStart {
    lock: HostFile,
    seq: u64,
    uncovered: u64,
    creation: Bytes,
    segment: HostFile,
    end_file: HostFile,
    header: Bytes
}

pub fn start_directory(tasks: Tasks, d: Dir, c: Clock, id: types.StoreKey, group_commits: u32, group_bytes: u32, cadence: JournalCadence, zero_extension: bool, take start: DirJournalStart) -> Result[DirJournalState, types.Failure] waits {
    let DirJournalStart(lock: take lock, seq, uncovered, creation: take creation, segment: take segment, end_file: take end_file, header: take header) = take start
    let channels = manifest.disk_allocation(scoped fn() -> Result[DirJournalChannels, types.Failure] {
        Ok(dir_journal_channels())
    })?
    let DirJournalChannels(frames: take frames, queued: take queued, acks: take journal_acks, received: take journal_received, ready: take ready, waiting: take waiting, written_send: take written_send, written_receive: take written_receive, synced_send: take synced_send, synced_receive: take synced_receive) = take channels
    let (returned, group) = manifest.disk_allocation(scoped fn() -> Result[(Sender[Bytes], GroupHead), types.Failure] {
        let (released, recycled): (Sender[Bytes], Receiver[Bytes]) = channel.new(1)
        Ok((take released, group_head(group_commits, group_bytes, header, c, take recycled)))
    })?
    let input = JournalWorker(store: id, seq: seq, segment: take segment, end_file: take end_file, returned: take returned, group_bytes: group_bytes, clock: c, cadence: cadence, zero_extension: zero_extension, receive: take queued, send: take journal_acks, ready: take ready, written: channel.sender(written_send), synced: take synced_send)
    let writer = match task.try_spawn(tasks, bytes JOURNAL_WORKER_SLACK, take input, journal_worker) {
        Ok(take running) => take running,
        Error((problem, _)) => return Error(Full(Allocation(problem))),
    }
    types.capacity(result.unwrap(channel.receive(waiting)))?
    Ok(DirJournalState(lock: take lock, d: d, creation: take creation, file_seq: seq, file_end: 72, group: take group, head_managed: false, creations: 1, ticket_waits: 0, ticket_wait_ns: 0, journal: take frames, acks: take journal_received, accounting: queue_accounting(uncovered), written: take written_receive, written_send: take written_send, synced: Some(take synced_receive), writer: take writer))
}

pub fn directory(state: DirJournalState) -> Dir {
    state.d
}

pub fn segment_seq(state: DirJournalState) -> u64 {
    state.file_seq
}

pub fn segment_end(state: DirJournalState) -> u64 {
    state.file_end
}

pub fn set_segment(mut state: DirJournalState, seq: u64) {
    state.file_seq = seq
    state.file_end = 72
}

pub fn advance_offset(mut state: DirJournalState, size: u64) {
    state.file_end += size
}

pub fn dir_accounting(state: DirJournalState) -> View[QueueAccounting] in state {
    view state.accounting
}

pub fn edit_accounting[R](mut state: DirJournalState, edit: scoped fn(mut QueueAccounting) -> R) -> R {
    edit(mut state.accounting)
}

pub fn manage_groups(mut state: DirJournalState) {
    state.head_managed = true
}

pub fn submit_group(state: DirJournalState, wait: bool, reason: GroupClose) -> Result[(), types.Failure] waits {
    seal_group(state.group, state.journal, wait, reason)
}

pub fn read_stats(state: DirJournalState) -> Result[JournalStats, types.Failure] waits {
    let (reply, answer) = manifest.disk_allocation(scoped fn() -> Result[(Sender[JournalStats], Receiver[JournalStats]), types.Failure] {
        Ok(channel.new(1))
    })?
    if let Error(_) = channel.send(state.journal, ReadStats(take reply)) {
        return Error(Poisoned(Closed))
    }
    match channel.receive(answer) {
        Ok(take received) => {
            let mut stats = take received
            stats.segment_writes += state.creations
            stats.end_writes += state.creations
            stats.creations = state.creations
            stats.ticket_waits = state.ticket_waits
            stats.ticket_wait_ns = state.ticket_wait_ns
            Ok(take stats)
        },
        Error(_) => Error(Poisoned(Closed)),
    }
}

pub fn note_ticket_wait(mut state: DirJournalState, elapsed: u64) {
    state.ticket_waits += 1u64
    state.ticket_wait_ns = int.saturating_add(state.ticket_wait_ns, elapsed)
}

pub fn draft_group(state: DirJournalState) -> View[GroupHead] in state {
    view state.group
}

pub fn queue_frame(state: DirJournalState, take frame: format.DraftFrame, number: u64) -> Result[(), types.Failure] waits {
    let size = format.frame_length(frame)
    match take frame {
        InGroup(n) => publish_frame(state.group, state.journal, n, number)?,
        Detached(take raw) => append_frame(state.group, state.journal, take raw, number)?,
    }
    let window = state.group.max_bytes
    if !state.head_managed {
        submit_group(state, true, Immediate)?
    } else if (state.file_end - size) / window != state.file_end / window {
        submit_group(state, true, Size)?
    }
    Ok(())
}

pub fn dir_sender(state: DirJournalState) -> View[Sender[DirJournalMsg]] in state {
    view state.journal
}

pub fn replace_sender(mut state: DirJournalState, take sender: Sender[DirJournalMsg]) -> Sender[DirJournalMsg] {
    replace(mut state.journal, take sender)
}

pub fn dir_acks(state: DirJournalState) -> View[Receiver[DirAck]] in state {
    view state.acks
}

pub fn dir_written(state: DirJournalState) -> View[Receiver[WriteNotice]] in state {
    view state.written
}

pub fn dir_written_send(state: DirJournalState) -> View[Sender[WriteNotice]] in state {
    view state.written_send
}

pub fn dir_sync_notices(mut state: DirJournalState) -> Option[Receiver[()]] {
    replace(mut state.synced, None)
}

pub fn rotate(mut state: DirJournalState, c: Clock, id: types.StoreKey, seq: u64, previous: u64) -> Result[bool, types.Failure] waits {
    let (take segment, take end_file, take header) = disk_new_segment(state.d, c, id, seq, previous, mut state.creation)?
    state.creations += 1u64
    submit_group(state, true, Boundary)?
    reset_header(state.group, take header)
    Ok(match channel.send(state.journal, Rotate(take segment, take end_file)) {
        Ok(()) => false,
        Error(_) => true,
    })
}

pub fn close_directory(take state: DirJournalState, take prior: Option[types.Failure]) -> Result[(), types.Failure] waits {
    let DirJournalState(lock: take lock, journal: take frames, acks: take acknowledgements, accounting: take accounting, writer: take writer, written: take notices, written_send: take notice_to, ..) = take state
    let _ = take frames
    let mut failure = take prior
    let mut poison = accounting.poison
    let remaining: Option[Receiver[DirAck]] = if let Some(_) = poison {
        let _ = take acknowledgements
        None
    } else {
        Some(take acknowledgements)
    }
    match task.join(take writer) {
        Ok(Error(Io(e))) => if let None = poison {
            poison = Some(e)
        },
        Ok(Error(take e)) => if let None = failure {
            failure = Some(take e)
        },
        Ok(Ok(())) => (),
        Error(_) => if let None = poison {
            poison = Some(Closed)
        },
    }
    if let Some(receiver) = remaining {
        while let Ok(ack) = channel.try_receive(receiver) {
            if let DirBroken(e) = ack {
                if let None = poison {
                    poison = Some(e)
                }
            }
        }
    }
    let _ = take notices
    let _ = take notice_to
    if let Error(e) = host.close(take lock) {
        if let None = poison {
            poison = Some(e)
        }
    }
    match poison {
        Some(e) => Error(Poisoned(e)),
        None => match take failure {
            Some(take e) => Error(take e),
            None => Ok(()),
        },
    }
}

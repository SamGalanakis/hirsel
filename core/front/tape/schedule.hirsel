type Work: send {
    clock: Clock,
    sender: Sender[u64],
    n: u64
}

fn sleeper(take work: Work) -> u64 waits {
    host.sleep_until(work.clock, 9000u64)
    result.unwrap(channel.send(work.sender, work.n))
    work.n
}

fn number(x: u64) -> u64 { x }

pub fn main(c: Clock, tasks: Tasks) -> Result[(), Exit] waits {
    let (tx, rx): (Sender[u64], Receiver[u64]) = result.unwrap(channel.new(2))
    let one = result.unwrap(task.spawn(tasks, bytes 4096, Work(clock: c, sender: channel.sender(tx), n: 1), sleeper))
    let two = result.unwrap(task.spawn(tasks, bytes 4096, Work(clock: c, sender: channel.sender(tx), n: 2), sleeper))
    let _ = result.unwrap(channel.receive(rx))
    let _ = result.unwrap(channel.receive(rx))
    let _ = task.join(take one)
    let _ = task.join(take two)
    {
        let root = result.unwrap(latest.new(result.unwrap(arc.new(3u64))))
        let old = latest.read(root)
        {
            let shared = arc.share(old)
            if number(shared) != 3u64 { return Error(Exit(status: 5)) }
        }
        latest.publish(root, result.unwrap(arc.new(4u64)))
        if result.unwrap(arc.try_unwrap(take old)) != 3u64 { return Error(Exit(status: 6)) }
        if number(latest.read(root)) != 4u64 { return Error(Exit(status: 7)) }
    }
    Ok(())
}

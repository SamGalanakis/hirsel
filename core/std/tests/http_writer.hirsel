// test-of: std.http
// test-reason: The fixed wire head builder belongs to the connection, so it has no public entry.
// HTTP-4(11): a field with framing authority or invalid wire syntax is a typed error.
// expect: run http_response_fields() = true
fn http_response_fields() -> bool {
    if let Ok(_) = response(101, list.new(), false) {
        return false
    }
    let mut r = result.unwrap(response(200, list.new(), false))
    if let Error(HeaderReserved) = header(mut r, b"TrAnSfEr-EnCoDiNg", b"chunked") {
        if let Error(HeaderInvalid) = header(mut r, b"X-Value", b"ok\r\nInjected: value") {
            return list.len(r.fields) == 0
        }
    }
    false
}

// RFC 9110 5.6.7 IMF-fixdate. 951782400 seconds is 2000-02-29 00:00 UTC.
// HTTP-4(11): 204 omits the length even when the response owns a body.
// expect: run http_response_wire_head() = true
fn http_response_wire_head() -> bool {
    let mut out: Bytes = list.with_capacity(128)
    let mut r = result.unwrap(response(204, b"unexpected", false))
    result.unwrap(content_type(mut r, ApplicationJson))
    let mut cache = date_cache()
    let first = "HTTP/1.0 204 No Content\r\nContent-Type: application/json\r\nConnection: keep-alive\r\nDate: Tue, 29 Feb 2000 00:00:00 GMT\r\n\r\n"
    let next = "HTTP/1.0 204 No Content\r\nContent-Type: application/json\r\nConnection: keep-alive\r\nDate: Tue, 29 Feb 2000 00:00:01 GMT\r\n\r\n"
    let walls =[951782400000u64, 951782400999u64, 951782401000u64, 951782400000u64]
    for i in 0u64 .. 4u64 {
        result.unwrap(response_head(mut out, r, 0, false, walls[i], mut cache))
        let matches = if i == 2 {
            out == string.as_bytes(next)
        } else {
            out == string.as_bytes(first)
        }
        if !matches {
            return false
        }
    }
    // The 8,030 years from 1970 through 9999 contain 2,007 - 80 + 20 leap
    // days, so year 10000 starts after 2,932,897 days. Its first millisecond
    // is 2,932,897 * 86,400 * 1,000. The previous day is Friday because
    // 2,932,896 mod 7 is 1 and the epoch was Thursday.
    let last = "HTTP/1.0 204 No Content\r\nContent-Type: application/json\r\nConnection: keep-alive\r\nDate: Fri, 31 Dec 9999 23:59:59 GMT\r\n\r\n"
    result.unwrap(response_head(mut out, r, 0, false, 253402300799999, mut cache))
    if out != string.as_bytes(last) {
        return false
    }
    let prefix = "HTTP/1.0 204 No Content\r\nContent-Type: application/json\r\nConnection: keep-alive\r\n"
    if let Error(DateInvalid) = response_head(mut out, r, 0, false, 253402300800000, mut cache) {
        return out == string.as_bytes(prefix) && cache.second == Some(253402300799)
    }
    false
}

// HTTP-4(8): validate both authorities and use the one in an absolute-form target.
// expect: run http_absolute_authority() = true
fn http_absolute_authority() -> bool {
    let raw = b"GET http://[2001:0DB8::7]:65535/a?raw=%ff HTTP/1.1\r\nHost: origin.example\r\n\r\n"
    let mut h = http1.head()
    if http1.request(raw, mut h) != Complete {
        return false
    }
    let (meta, _) = result.unwrap(request_policy(raw, view h))
    let auth = match meta.authority {
        Some(s) => s,
        None => return false,
    }
    let spans_match = part(raw, auth) == string.as_bytes("[2001:0DB8::7]:65535") && part(raw, meta.path) == string.as_bytes("/a") && part(raw, meta.query) == string.as_bytes("raw=%ff")
    let names_valid = valid_authority(string.as_bytes("LocalHost:80")) && valid_authority(string.as_bytes("abcdefgh%20.example"))
    let bad_names_refused = !valid_authority(b"abcdefg\xc1.example") && !valid_authority(string.as_bytes("abcdefgh%2G.example"))
    spans_match && names_valid && bad_names_refused
}

fn request_refused(raw: Bytes, status: u16) -> bool {
    let mut h = http1.head()
    if http1.request(raw, mut h) != Complete {
        return false
    }
    match request_policy(raw, view h) {
        Error(s) => s == status,
        Ok(_) => false,
    }
}

// HTTP-4(8,10): missing or duplicate Host and bad authorities are 400.
// CONNECT and authority-form are 501. Unsupported expectations are 417.
// expect: run http_request_policy_refusals() = true
fn http_request_policy_refusals() -> bool {
    let mixed = b"POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\nExpect: later\r\nTransfer-Encoding: chunked\r\n\r\n"
    if !request_refused(mixed, 417) {
        return false
    }
    request_refused(b"GET / HTTP/1.1\r\n\r\n", 400) && request_refused(b"GET / HTTP/1.1\r\nHost: a\r\nhost: a\r\n\r\n", 400) && request_refused(b"GET http://other/ HTTP/1.1\r\nHost: a:65536\r\n\r\n", 400) && request_refused(b"GET http://[1::2::3]/ HTTP/1.1\r\nHost: a\r\n\r\n", 400) && request_refused(b"CONNECT a:80 HTTP/1.1\r\nHost: a\r\n\r\n", 501) && request_refused(b"GET a:80 HTTP/1.1\r\nHost: a\r\n\r\n", 501) && request_refused(b"GET * HTTP/1.1\r\nHost: a\r\n\r\n", 400) && request_refused(b"POST / HTTP/1.1\r\nHost: a\r\nExpect: later\r\n\r\n", 417)
}

fn bad_path(s: String) -> bool {
    match segments_of(string.as_bytes(s)) {
        Error(BadTarget) => true,
        _ => false,
    }
}

// HTTP-4(9): a trailing empty segment is legal, embedded empty/dot segments
// and invalid UTF-8 are not. A decoded slash does not create another segment.
// expect: run http_segment_boundaries() = true
fn http_segment_boundaries() -> bool {
    let decoded = result.unwrap(segments_of(string.as_bytes("/a%2fb/%C3%A9/")))
    list.len(decoded) == 3 && decoded[0] == "a/b" && decoded[1] == "é" && decoded[2] == "" && bad_path("//") && bad_path("/./") && bad_path("/.%2e/") && bad_path("/%c0%80") && bad_path("/%2")
}

// A 200 head with an empty body has a 17-byte status line and a 19-byte
// Content-Length line. The cached Date needs 37 bytes before the final CRLF.
// A 72-byte buffer refuses before copying Date. A 75-byte buffer fits exactly.
// expect: run http_cached_date_capacity() = true
fn http_cached_date_capacity() -> bool {
    let mut exact: Bytes = list.with_capacity(75)
    let mut short: Bytes = list.with_capacity(72)
    let r = result.unwrap(response(200, list.new(), false))
    let mut cache = date_cache()
    let wall = 951782400000u64
    let wire = "HTTP/1.1 200 OK\r\nContent-Length: 0\r\nDate: Tue, 29 Feb 2000 00:00:00 GMT\r\n\r\n"
    result.unwrap(response_head(mut exact, r, 1, false, wall, mut cache))
    if exact != string.as_bytes(wire) {
        return false
    }
    if let Error(HeadTooLarge) = response_head(mut short, r, 1, false, wall + 999, mut cache) {
        if short != string.as_bytes("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n") {
            return false
        }
    } else {
        return false
    }
    if let Error(HeadTooLarge) = response_head(mut short, r, 1, false, wall + 1000, mut cache) {
        result.unwrap(response_head(mut exact, r, 1, false, wall, mut cache))
        return exact == string.as_bytes(wire)
    }
    false
}

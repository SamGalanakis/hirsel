// Module `map`, extended (LANG-7): library members of the core module `map` (SEM-5). The
// core members (new, len, get, insert, set, remove) are declared in core/core/map.hirsel.
// Field legend: API.md, "Reading a contract"; layout, tombstones and compaction: API.md,
// "Map and Set".
//
// Representation: 24-byte header inline; one storage block of capacity x (size(K) +
// size(V) + 16), rounded up to 8, charged to the limit where the map was made (MEM-26).
// The 16 bytes per entry pay for its 8-byte hash and two 4-byte index slots (the index has
// twice the entry capacity). GROWTH doubles capacity from 4 entries. The hash is fixed per
// key type and keyed by a per-run seed (SEM-5); no operation reveals it. `for (k, v) in m`
// binds `(View[K], View[V])` for each live entry in insertion order (SEM-6) and FREEZES m.
//
// Core map.update lends a present value to a scoped callback after one lookup;
// a tally uses update, then inserts only on None. map.set replaces a whole value
// without allocating. Neither operation moves a present key or changes its order.
/// Whether k is present: `map.get(m, k) != None`. Cost: as get. Ex: `map.contains(seen, k)`
pub fn contains[K: key, V](m: Map[K, V], k: K) -> bool {
    match map.get(m, k) {
        Some(_) => true,
        None => false,
    }
}

/// k's value copied out, or x when absent. Cost: as get.
/// Ex: `let n = map.get_or(counts, w, 0); let _ = map.set(mut counts, w, n + 1)`
pub fn get_or[K: key, V: plain](m: Map[K, V], k: K, x: V) -> V {
    match map.get(m, k) {
        Some(v) => v,
        None => x,
    }
}

/// Copies the stored plain value, or inserts (k, x) and returns x when absent.
/// Existing keys keep their place and value; unused k and x are cleaned.
/// Fails: Error((c, (k, x))) on growth, m unchanged. Alloc: map GROWTH.
/// Cost: expected amortised O(1). Like get_or, this helper copies plain values;
/// OWN-20 permits scoped results to anchor only view parameters, not mut m.
pub fn get_or_insert[K: key, V: plain](mut m: Map[K, V], take k: K, x: V) -> Result[V, (Capacity, (K, V))] {
    let found: Option[V] = match map.get(m, k) { Some(v) => Some(v), None => None }
    if let Some(v) = found { return Ok(v) }
    map.insert(mut m, take k, x)?
    Ok(x)
}

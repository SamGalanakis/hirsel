// The store's crash harnesses: programs the crash drivers (core/tools/store_crash_tests.py,
// store_journal_tests.py, runner_tests.py) build and kill at chosen points.
pkg_v1.Package(
    name: "hirsel.ai/store_crash",
    version: "1.0.0",
    charge: ChargeV1,
    sources: [
        ("platform_crash.hirsel", "platform_crash"),
        ("runner_crash.hirsel", "runner_crash"),
        ("runner_crash-bucket.hirsel", "runner_crash"),
        ("runner_crash-cold.hirsel", "runner_crash"),
        ("runner_crash-jwt.hirsel", "runner_crash"),
    ],
    dependencies: [
        ("std", Toolchain(package: "std", major: 1, authority: [])),
        ("store", Path(package: "store", major: 1, path: "../store", authority: [Dir, Clock, Random, Tasks])),
        ("runner", Path(
            package: "runner",
            major: 1,
            path: "../runner",
            authority: [Dir, Net, Clock, Random, Stderr, Process, Tasks, Args, Secret, Cred],
        )),
        ("platform", Path(
            package: "platform",
            major: 1,
            path: "../platform",
            authority: [Dir, Net, Clock, Random, Stdout, Stderr, Tasks, Args, Secret, Cred],
        )),
        ("jwtbind", Path(
            package: "hirsel.ai/jwtbind",
            major: 1,
            path: "../jwtbind",
            authority: [Net, Clock, Random, Tasks, Secret],
        )),
    ],
)

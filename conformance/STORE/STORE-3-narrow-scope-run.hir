// rule: STORE-3
// expect: run
// steps: 12000000
// sixty random scope pairs, each probing every key and range between their boundaries
// A narrowed Tx reaches exactly its key scope. Named cases: a key outside the
// scope is OutOfScope, a write to a Read key is ReadOnly and changes nothing,
// containment is exact (equal scopes in other spellings narrow, one more key
// or a stronger access does not), a narrowing of a narrowing cannot widen
// back, and store.keys never holds a reserved key. Then random scopes: a
// narrowing succeeds exactly when every key's access in the child is at most
// its access in the parent, and each get, put and range in a narrowed Tx is
// refused exactly when a key it touches is not held strongly enough, as
// read naively from the scope's parts at every boundary of either scope.
type Part {
  lo: Bytes,
  hi: Option[Bytes],
  write: bool,
}

fn reserved_band(k: Bytes) -> bool uses {} {
  b"hirsel." <= k && k < b"hirsel/"
}

// The access `parts` built by store.keys give `k`: 0 none, 1 read, 2 write.
fn access(parts: List[Part], k: Bytes) -> u8 uses {} {
  if reserved_band(k) {
    return 0
  }
  let mut best: u8 = 0
  for p in parts {
    let below = match p.hi {
      Some(h) => k < h,
      None() => true,
    }
    if p.lo <= k && below {
      let a: u8 = if p.write {
        2
      } else {
        1
      }
      if a > best {
        best = a
      }
    }
  }
  best
}

fn scope_of(parts: List[Part]) -> store.KeyScope uses {} {
  let mut s = store.keys(Included(b"a"), Excluded(b"a"), Read())
  for p in parts {
    let to = match p.hi {
      Some(h) => Excluded(unique h),
      None() => Unbounded(),
    }
    let a = if p.write {
      ReadWrite()
    } else {
      Read()
    }
    s = store.join(s, store.keys(Included(unique p.lo), to, a))
  }
  s
}

fn next(mut seed: u64) -> u64 uses {} {
  seed = int.wrapping_add(
    int.wrapping_mul(seed, 6364136223846793005),
    1442695040888963407
  )
  seed >> 33
}

fn random_key(mut seed: u64) -> unique Bytes uses {} {
  let pool = [
    b"",
    b"a",
    b"ab",
    b"b",
    b"hirsel",
    b"hirsel.",
    b"hirsel.rows/",
    b"hirsel/",
    b"z",
    b"\xff"
  ]
  let tails: List[u8] = [0, 1, 46, 47, 97, 255]
  let mut out: List[u8] = []
  for b in pool[next(mut seed) % 10] {
    list.push(mut out, b)
  }
  let extra = next(mut seed) % 3
  for _ in 0u64..extra {
    list.push(mut out, tails[next(mut seed) % 6])
  }
  bytes.from_list(take out)
}

fn random_parts(mut seed: u64) -> List[Part] uses {} {
  let mut parts: List[Part] = []
  let n = next(mut seed) % 4
  for _ in 0u64..n {
    let x = random_key(mut seed)
    let y = random_key(mut seed)
    let endless = next(mut seed) % 7 == 0
    let write = next(mut seed) % 2 == 0
    let swap = y < x
    let lo = if swap {
      copy y
    } else {
      copy x
    }
    let end = if swap {
      x
    } else {
      y
    }
    let hi: Option[Bytes] = if endless {
      None()
    } else {
      Some(end)
    }
    list.push(mut parts, Part(lo: lo, hi: hi, write: write))
  }
  parts
}

// Every boundary of either scope, the reserved band's and the first key: each
// scope's access is constant from one boundary to the next.
fn boundaries(a: List[Part], b: List[Part]) -> List[Bytes] uses {} {
  let mut out: List[Bytes] = [b"", b"hirsel.", b"hirsel/"]
  for p in a {
    list.push(mut out, unique p.lo)
    if let Some(h) = p.hi {
      list.push(mut out, unique h)
    }
  }
  for p in b {
    list.push(mut out, unique p.lo)
    if let Some(h) = p.hi {
      list.push(mut out, unique h)
    }
  }
  out
}

fn contained(child: List[Part], parent: List[Part], at: List[Bytes]) -> bool uses {} {
  for k in at {
    if access(child, k) > access(parent, k) {
      return false
    }
  }
  true
}

// Every byte operation in `sub`, narrowed to `parts`, against the oracle.
fn probe(mut sub: store.Tx, parts: List[Part], at: List[Bytes]) -> bool {
  for k in at {
    if reserved_band(k) {
      continue
    }
    let held = access(parts, k)
    let read_ok = store.tx_get(sub, unique k) != Error(OutOfScope())
    if read_ok != (held > 0) {
      return false
    }
    let wrote = store.tx_put(mut sub, unique k, b"v")
    let want: Result[(), store.TxError] = if held == 2 {
      Ok(())
    } else if held == 1 {
      Error(ReadOnly())
    } else {
      Error(OutOfScope())
    }
    if wrote != want {
      return false
    }
    for h in at {
      if k < h {
        let mut readable = true
        for m in at {
          if k <= m && m < h && !reserved_band(m) && access(parts, m) == 0 {
            readable = false
          }
        }
        let scanned = store.tx_range(
          sub,
          Included(unique k),
          Excluded(unique h),
          8,
          Ascending()
        )
        let refused = match scanned {
          Error(OutOfScope()) => true,
          _ => false,
        }
        if refused == readable {
          return false
        }
      }
    }
  }
  true
}

fn named_cases(mut tx: store.Tx) -> bool {
  let ab = store.keys(Included(b"a"), Included(b"b"), ReadWrite())
  // OutOfScope, and a key inside reads normally.
  let reads = store.narrow(
    mut tx,
    ab,
    fn(mut sub: store.Tx) -> bool {
      store.tx_get(sub, b"c") == Error(OutOfScope()) && store.tx_get(sub, b"a") == Ok(
        None()
      )
    }
  )
  if reads != Ok(true) {
    return false
  }
  // ReadOnly, and the refused write changed nothing.
  let read_only = store.narrow(
    mut tx,
    store.keys(Included(b"a"), Included(b"b"), Read()),
    fn(mut sub: store.Tx) -> bool {
      store.tx_put(mut sub, b"a", b"x") == Error(ReadOnly())
    }
  )
  if read_only != Ok(true) || store.tx_get(tx, b"a") != Ok(None()) {
    return false
  }
  // Exact containment: the same keys spelled differently narrow; one more key,
  // or ReadWrite over Read, does not.
  let exact = store.narrow(
    mut tx,
    ab,
    fn(mut sub: store.Tx) -> bool {
      let same = store.narrow(
        mut sub,
        store.keys(Included(b"a"), Excluded(b"b\x00"), ReadWrite()),
        fn(mut inner: store.Tx) -> bool {
          true
        }
      )
      let wider = store.narrow(
        mut sub,
        store.keys(Included(b"a"), Included(b"b\x00"), Read()),
        fn(mut inner: store.Tx) -> bool {
          true
        }
      )
      same == Ok(true) && wider == Error(OutOfScope())
    }
  )
  let stronger = store.narrow(
    mut tx,
    store.keys(Included(b"a"), Included(b"b"), Read()),
    fn(mut sub: store.Tx) -> bool {
      store.narrow(
        mut sub,
        store.keys(Included(b"a"), Included(b"a"), ReadWrite()),
        fn(mut inner: store.Tx) -> bool {
          true
        }
      ) == Error(OutOfScope())
    }
  )
  if exact != Ok(true) || stronger != Ok(true) {
    return false
  }
  // A narrowing of a narrowing cannot widen back to its parent's scope.
  let repeated = store.narrow(
    mut tx,
    ab,
    fn(mut sub: store.Tx) -> bool {
      let inner = store.narrow(
        mut sub,
        store.keys(Included(b"a"), Included(b"a"), ReadWrite()),
        fn(mut a_only: store.Tx) -> bool {
          let back = store.narrow(
            mut a_only,
            store.keys(Included(b"a"), Included(b"b"), ReadWrite()),
            fn(mut x: store.Tx) -> bool {
              true
            }
          )
          back == Error(OutOfScope()) && store.tx_get(a_only, b"b") == Error(
            OutOfScope()
          )
        }
      )
      inner == Ok(true)
    }
  )
  if repeated != Ok(true) {
    return false
  }
  // store.keys over every key holds no reserved key, so it does not contain
  // store.all, yet its ranges pass over the reserved keys.
  let clipped = store.narrow(
    mut tx,
    store.keys(Unbounded(), Unbounded(), ReadWrite()),
    fn(mut sub: store.Tx) -> bool {
      let all = store.narrow(
        mut sub,
        store.all(Read()),
        fn(mut x: store.Tx) -> bool {
          true
        }
      )
      let scanned = store.tx_range(sub, Unbounded(), Unbounded(), 8, Ascending())
      all == Error(OutOfScope()) && scanned == Ok([])
    }
  )
  clipped == Ok(true)
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  let d = test.dir(t, [])
  let mut s = store.open(d, store.default_config())?
  let named: Result[bool, store.TxFailure[()]] = store.transact(
    mut s,
    fn(mut tx: store.Tx) -> Result[bool, ()] {
      Ok(named_cases(mut tx))
    }
  )
  test.check(t, named == Ok(true))
  let mut seed: u64 = 683
  for round in 0u64..60u64 {
    let parent = random_parts(mut seed)
    let child = random_parts(mut seed)
    let at = boundaries(parent, child)
    let expected = contained(child, parent, at)
    let checked: Result[bool, store.TxFailure[()]] = store.transact(
      mut s,
      fn(mut tx: store.Tx) -> Result[bool, ()] {
        let outcome = store.narrow(
          mut tx,
          scope_of(parent),
          fn(mut sub: store.Tx) -> bool {
            let nested = store.narrow(
              mut sub,
              scope_of(child),
              fn(mut x: store.Tx) -> bool {
                true
              }
            )
            (nested == Ok(true)) == expected && probe(mut sub, parent, at)
          }
        )
        if outcome != Ok(true) {
          return Ok(false)
        }
        // Abort, so each round starts from an empty store.
        Error(())
      }
    )
    test.check(t, checked == Error(Aborted(())))
  }
  Ok(())
}

// Store regression laws appended by the store and runner test drivers.
// Store identity/catalog rules: write, read, drop and recreate twice. Each
// iteration must find exactly its newly written (1, i), so the result is true.
fn assembly_bucket(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, v % 4)
    Ok(take keys)
}

pub fn law_assembly_indexed_recreate(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = store.memory(c, r, result.unwrap(store.sized(Memory, 1074790400u64)))
    let (first, first_ix) = result.unwrap(law_indexed(mut db, "t", std.codec.key_u64(), std.codec.of_u64(), "i", code.describe(assembly_bucket), std.codec.key_u64()))
    let mut t = first
    let mut ix = first_ix
    for i in 0u64 .. 2 {
        let done = store.run(mut db, None, (copy_env(t), copy_env(i)), fn(mut tx, call_env) -> Result[(), store.Error] {
            store.put(mut tx, call_env.0, 1, call_env.1)
        })
        match take done {
            Ok(Committed(_)) => {},
            _ => return false
        }
        if result.unwrap(store.get(result.unwrap(reader(db, 0u64)), store.snapshot(db), t, 1)) != Some(i) {
            return false
        }
        let mut rows = result.unwrap(store.find(result.unwrap(reader(db, 0u64)), store.snapshot(db), ix, Unbounded, Unbounded))
        if result.unwrap(store.next(law_reader(rows.capture), mut rows)) != Some((1u64, i)) {
            return false
        }
        result.unwrap(law_drop(mut db, tasks))
        let (again, again_ix) = result.unwrap(law_indexed(mut db, "t", std.codec.key_u64(), std.codec.of_u64(), "i", code.describe(assembly_bucket), std.codec.key_u64()))
        t = again
        ix = again_ix
    }
    true
}

@test
fn test_assembly_indexed_recreate(c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_assembly_indexed_recreate(c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn shared_store_bytes(i: u64) -> Bytes {
    let mut out: Bytes = list.with_capacity(1024)
    for _ in 0u64 .. 1024 {
        list.push(mut out, int.narrow(i))
    }
    take out
}

// One overwritten row needs its log copies and a copied path, not 64 KiB of
// unchanged leaf payload. The old snapshot must still contain all 32 rows.
pub fn law_shared_payload_copy(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    for i in 0u64 .. 32 {
        let key = shared_store_bytes(i)
        let value = shared_store_bytes(i)
        let _ = result.unwrap(execute(mut db, 0, i, None, fn(mut tx: Tx) -> Result[(), Error] {
            put_bytes(mut tx, 1, key, value)
        }))
    }
    let held = snapshot(db)
    let key = shared_store_bytes(16)
    let value = shared_store_bytes(99)
    let attempted = result.unwrap(bound bytes 32768 {
        execute(mut db, 0, 32, None, fn(mut tx: Tx) -> Result[(), Error] {
            put_bytes(mut tx, 1, key, value)
        })
    })
    match take attempted {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let now = snapshot(db)
    for i in 0u64 .. 32 {
        let old = option.unwrap(result.unwrap(get_raw(held, 1, shared_store_bytes(i))))
        let current = option.unwrap(result.unwrap(get_raw(now, 1, shared_store_bytes(i))))
        let expected = if i == 16 {
            99u64
        } else {
            i
        }
        if list.len(old) != 1024 || old[0] != int.narrow(i) || old[1023] != int.narrow(i) || list.len(current) != 1024 || current[0] != int.narrow(expected) || current[1023] != int.narrow(expected) {
            return false
        }
    }
    version(held) == 32 && version(now) == 33
}

@test
fn test_shared_payload_copy(c: Clock) -> Result[(), ()] {
    if law_shared_payload_copy(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn pages_match(s: Snapshot, sh: Table[u64, u64], ix: Index[u64, u64, u64, ()], indexed: bool, limits: Limits) -> bool waits {
    let table_model: Inline[(u64, u64), 5] =[(2, 5), (3, 9), (4, 2), (5, 13), (6, 6)]
    let index_model: Inline[(u64, u64), 5] =[(2, 5), (3, 9), (5, 13), (4, 2), (6, 6)]
    let expected = if indexed {
        index_model
    } else {
        table_model
    }
    let mut page = if indexed {
        result.unwrap(find_page(law_reader(s), s, ix, Included(1), Excluded(3), limits))
    } else {
        result.unwrap(scan_page(law_reader(s), s, sh, Excluded(1), Included(6), limits))
    }
    let mut offset = 0u64
    for _ in 0u64 .. 5 {
        let mut page_rows = 0u64
        while offset + page_rows < 5 && page_rows < limits.rows {
            if page_rows > 0 && (page_rows + 1) * 22 > limits.byte_limit {
                break
            }
            page_rows += 1
        }
        if list.len(page.rows) != page_rows || page.byte_count != page_rows * 22 {
            return false
        }
        for slot_order in 0u64 .. page_rows {
            if page.rows[slot_order] != expected[offset + slot_order] {
                return false
            }
        }
        offset += page_rows
        let Page(rows: _, byte_count: _, next: take resume) = take page
        match take resume {
            None => return offset == 5,
            Some(take token) => {
                if offset == 5 {
                    return false
                }
                let resumed = if indexed {
                    find_next(law_reader(s), s, ix, take token, limits)
                } else {
                    scan_next(law_reader(s), s, sh, take token, limits)
                }
                match take resumed {
                    Ok(Paged(take following)) => {
                        page = take following
                    },
                    _ => return false
                }
            }
        }
    }
    false
}

fn page_token(take page: Page[u64, u64]) -> Resume {
    let Page(rows: _, byte_count: _, next: take resume) = take page
    option.unwrap(take resume)
}

fn page_missing[T](take actual: Result[T, Error], name: String) -> bool {
    match take actual {
        Error(Missing(field)) => field == name,
        _ => false
    }
}

fn page_empty(take page: Page[u64, u64]) -> bool {
    match page.next {
        None => list.len(page.rows) == 0 && page.byte_count == 0,
        Some(_) => false
    }
}

pub fn law_keyset_pages(c: Clock, tasks: Tasks) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(law_table(mut db, "pages", std.codec.key_u64(), std.codec.of_u64()))
    let (original, ix) = result.unwrap(law_indexed(mut db, "pages", std.codec.key_u64(), std.codec.of_u64(), "bucket", code.describe(bucket), std.codec.key_u64()))
    let sh: Table[u64, u64] = clone(original)
    let written = run(mut db, None, original, fn(mut tx, call_env) -> Result[(), Error] {
        let inserted: Inline[(u64, u64), 7] =[(5, 13), (3, 9), (7, 3), (1, 8), (6, 6), (2, 5), (4, 2)]
        for (key, value) in inserted {
            put(mut tx, call_env, key, value)?
        }
        Ok(())
    })
    match take written {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let held = snapshot(db)
    let byte_limits: Inline[u64, 3] =[21, 22, 66]
    for row_limit in 1u64 .. 4 {
        for byte_limit in byte_limits {
            let limits = Limits(rows: row_limit, byte_limit: byte_limit)
            if !pages_match(held, sh, ix, false, limits) || !pages_match(held, sh, ix, true, limits) {
                return false
            }
        }
    }
    let one = Limits(rows: 1, byte_limit: 22)
    if !page_empty(result.unwrap(scan_page(result.unwrap(reader(db, 0u64)), held, sh, Excluded(5), Included(5), one))) || !page_empty(result.unwrap(find_page(result.unwrap(reader(db, 0u64)), held, ix, Included(1), Excluded(1), one))) {
        return false
    }
    let zero_rows = Limits(rows: 0, byte_limit: 22)
    let zero_bytes = Limits(rows: 1, byte_limit: 0)
    if !page_missing(scan_page(result.unwrap(reader(db, 0u64)), held, sh, Unbounded, Unbounded, zero_rows), "rows") || !page_missing(find_page(result.unwrap(reader(db, 0u64)), held, ix, Unbounded, Unbounded, zero_bytes), "bytes") || !page_missing(scan_next(result.unwrap(reader(db, 0u64)), held, sh, page_token(result.unwrap(scan_page(result.unwrap(reader(db, 0u64)), held, sh, Unbounded, Unbounded, one))), zero_bytes), "bytes") || !page_missing(find_next(result.unwrap(reader(db, 0u64)), held, ix, page_token(result.unwrap(find_page(result.unwrap(reader(db, 0u64)), held, ix, Unbounded, Unbounded, one))), zero_rows), "rows") {
        return false
    }
    result.unwrap(law_drop(mut db, tasks))
    result.unwrap(law_table(mut db, "pages", std.codec.key_u64(), std.codec.of_u64()))
    let (newer, fresh_ix) = result.unwrap(law_indexed(mut db, "pages", std.codec.key_u64(), std.codec.of_u64(), "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_shape = view newer
    let current = snapshot(db)
    match scan_next(result.unwrap(reader(db, 0u64)), current, fresh_shape, page_token(result.unwrap(scan_page(result.unwrap(reader(db, 0u64)), held, sh, Unbounded, Unbounded, one))), one) {
        Ok(Moved(head)) => if head != version(current) {
            return false
        },
        _ => return false
    }
    match find_next(result.unwrap(reader(db, 0u64)), current, fresh_ix, page_token(result.unwrap(find_page(result.unwrap(reader(db, 0u64)), held, ix, Unbounded, Unbounded, one))), one) {
        Ok(Moved(head)) => if head != version(current) {
            return false
        },
        _ => return false
    }
    match scan_next(result.unwrap(reader(db, 0u64)), held, fresh_shape, page_token(result.unwrap(scan_page(result.unwrap(reader(db, 0u64)), held, sh, Unbounded, Unbounded, one))), one) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match find_next(result.unwrap(reader(db, 0u64)), held, fresh_ix, page_token(result.unwrap(find_page(result.unwrap(reader(db, 0u64)), held, ix, Unbounded, Unbounded, one))), one) {
        Error(Stale(2)) => true,
        _ => false
    }
}

@test
fn test_keyset_pages(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    if law_keyset_pages(c, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn settle_fault_at(mut tx: Tx, attempted_at: u64) -> Result[Bytes, Bytes] {
    if info(mut tx).at == attempted_at {
        let no_values: List[u64] = list.new()
        let _ = no_values[0]
    }
    Ok(types.key_word(19))
}

// L33/AM6. Two intervening commits put the attempted base three versions
// behind the settle frame. Set the previous times to known wall-clock floors,
// one minute ahead of the open's keyed time: far enough to dominate the wall
// clock, and well inside stream retention, so the stream born at the open
// does not age (§1.8: it ages when t ≤ at − retention_ms).
pub fn law_settled_callinfo(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    settled_callinfo_case(d, c, r, tasks, false) && settled_callinfo_case(d, c, r, tasks, true)
}

@test
fn test_settled_callinfo(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_settled_callinfo(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn settled_callinfo_case(d: Dir, c: Clock, r: Random, tasks: Tasks, room_refusal: bool) -> bool waits {
    let dir = disk_test_directory(d)
    let options = journal_crash_options()
    let mut db = result.unwrap(open(tasks, dir, c, r, options))
    let stream = law_stream_bytes(types.key_word(55), keyed_time(db))
    let rec = call_for(stream, 32)
    let request = request_digest(rec.key, rec.args)
    let admission = result.unwrap(admit_law_stream(mut db, stream, 0, request))
    let Admitted(take complete) = take admission else {
        return false
    }
    result.unwrap(durable(mut db, ticket(complete)))
    let original_at = keyed_time(db) + 60000u64
    pages.set_head_at(mut db.holders, 0, original_at)
    let plan = Plan(n_e: 8192, s_e: 8192, reply_max: 4096)
    if room_refusal {
        db.accounting.ceiling = db.accounting.resident
    }
    let fault_at = if room_refusal {
        original_at + 1u64
    } else {
        original_at
    }
    let tried = serve(mut db, take complete, plan, Some(take rec), fault_at, fn(mut tx, call_env) -> Result[Bytes, Bytes] {
        settle_fault_at(mut tx, call_env)
    })
    let (take stopped, way) = match take tried {
        Ok(Failed(take pending_run, Raised(2u32))) if !room_refusal => (take pending_run, 1u8),
        // entry(k, v) = 62 + r8(k) + r8(v) (§1.11). The 26-byte stream row
        // costs 142 admitted (value 41) and 150 replied (value 41 + 8). The
        // admit also wrote the 10-byte caller row (value 9), 94, and the
        // Place control row (empty key, value 17), 86 (§1.8). The streams
        // hold 142 + 94 + 86 = 322 and the reply needs 150 + 94 + 86 = 330.
        // Its frame uses journal credit, so the resident refusal requests 330.
        Ok(NoRoom(take pending_run, Resident(reason))) if room_refusal && reason.requested == 330 && reason.available == 322 => (take pending_run, 2u8),
        _ => return false,
    }
    if version(snapshot(db)) != 1 || stream_now(db, stream) != (0u64, 1u64) {
        return false
    }
    if let Some(_) = result.unwrap(recorded(db, main_branch(db), 2)) {
        return false
    }
    db.accounting.ceiling = options.resident_limit
    pages.set_head_at(mut db.holders, 0, original_at + 1u64)
    for _ in 0u64 .. 2 {
        let advanced = result.unwrap(run(mut db, None, (), fn(mut tx, unused_env) -> Result[(), ()] {
            let _ = info(mut tx)
            Ok(())
        }))
        if let Committed(_) = advanced {} else {
            return false
        }
    }
    let settled = conclude(mut db, take stopped, types.key_word(2), Resident)
    let Ok(Committed(receipt)) = take settled else {
        return false
    }
    if receipt.reply != types.key_word(2) {
        return false
    }
    result.unwrap(durable(mut db, receipt.ticket))
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, dir, c, r, options))
    let line = main_branch(reopened)
    let Some(found) = result.unwrap(recorded(reopened, line, 4)) else {
        return false
    }
    let ctx = call_info(reopened.store, 0, 2, original_at, original_at)
    if found.settle != way || found.base != 1 || found.at != original_at || found.seed != ctx.seed || pages.holder_heads(reopened.holders)[0].at != original_at + 1u64 {
        return false
    }
    let duplicate = result.unwrap(admit_law_stream(mut reopened, stream, 0, request))
    let good = match duplicate {
        Duplicate(stored) => stored.reply == types.key_word(2),
        _ => false,
    }
    result.unwrap(close(take reopened))
    good
}

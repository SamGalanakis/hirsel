// Module `string` (SEM-3).

pub fn new() -> String

pub fn from(s: String) -> Result[String, Capacity] {
    let src = string.as_bytes(s)
    // Exact capacity: the copy's length.
    let mut b: Bytes = list.with_capacity(list.len(src))?
    let _ = list.append(mut b, src)
    Ok(of_bytes(take b))
}

pub fn from_utf8(take b: Bytes) -> Result[String, Bytes] {
    let n = list.len(b)
    let mut i: u64 = 0
    while i < n {
        let x = b[i]
        if x < 0x80 {
            // ASCII. From a word boundary, two words at a time while neither has a high bit.
            if i & 7 == 0 {
                while i + 16 <= n && (list.word_le(b, i) | list.word_le(b, i + 8)) & 0x8080808080808080 == 0 {
                    i += 16
                }
                // The block that stopped the loop (or the short tail) goes one byte at a time.
                if i < n && b[i] < 0x80 {
                    i += 1
                }
            } else {
                i += 1
            }
            continue
        }
        // x >= 0x80: the scalar's width and the range of its second byte (RFC 3629, section 4).
        let mut w: u64 = 1
        let mut lo: u8 = 0x80
        let mut hi: u8 = 0xBF
        if x >= 0xC2 && x <= 0xDF {
            w = 2
        } else if x == 0xE0 {
            w = 3
            lo = 0xA0
        } else if x == 0xED {
            w = 3
            hi = 0x9F
        } else if x >= 0xE1 && x <= 0xEF {
            w = 3
        } else if x == 0xF0 {
            w = 4
            lo = 0x90
        } else if x == 0xF4 {
            w = 4
            hi = 0x8F
        } else if x >= 0xF1 && x <= 0xF3 {
            w = 4
        } else {
            return Error(take b)
        }
        if n - i < w {
            return Error(take b)
        }
        for k in 1 .. w {
            let y = b[i + k]
            if y < lo || y > hi {
                return Error(take b)
            }
            lo = 0x80
            hi = 0xBF
        }
        i += w
    }
    Ok(of_bytes(take b))
}

pub fn into_bytes(take s: String) -> Result[Bytes, (Capacity, String)] {
    if list.capacity(string.as_bytes(s)) != 0 {
        return Ok(to_bytes(take s))
    }
    // Static storage: copied into exact capacity.
    let copied: Result[Bytes, Capacity] = list.with_capacity(string.byte_len(s))
    match copied {
        Ok(take b) => {
            let mut out = b
            let _ = list.append(mut out, string.as_bytes(s))
            Ok(take out)
        },
        Error(c) => Error((c, take s)),
    }
}

pub fn as_bytes(s: String) -> View[Bytes] in s
pub fn slice(s: String, lo: u64, hi: u64) -> View[String] in s {
    let b = string.as_bytes(s)
    // Bounds when lo > hi or hi is past the length.
    let v = list.slice(b, lo, hi)
    let n = list.len(b)
    if (lo < n && (b[lo] & 0xC0) == 0x80) || (hi < n && (b[hi] & 0xC0) == 0x80) {
        // Inside a scalar: Bounds, raised by the index n, which is past the end.
        let _ = b[n]
    }
    view_string(v)
}

pub fn next_scalar(s: String, at: u64) -> Option[(char, u64)] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if at == n {
        return None
    }
    // Past the end, b[at] fails with Bounds.
    let x = b[at]
    if (x & 0xC0) == 0x80 {
        // Inside a scalar: Bounds, raised by the index n, which is past the end.
        let _ = b[n]
    }
    let w: u64 = if x < 0x80 {
        1
    } else if x < 0xE0 {
        2
    } else if x < 0xF0 {
        3
    } else {
        4
    }
    let lead: u8 = if w == 1 {
        x
    } else if w == 2 {
        x & 0x1F
    } else if w == 3 {
        x & 0x0F
    } else {
        x & 0x07
    }
    let mut v: u32 = int.widen(lead)
    for k in 1 .. w {
        let y: u32 = int.widen(b[at + k] & 0x3F)
        v = (v << 6) | y
    }
    // s is valid UTF-8, so v is a scalar.
    Some((option.unwrap(char.from_u32(v)), at + w))
}

pub fn byte_len(s: String) -> u64
pub fn push(mut s: String, t: String) -> Result[(), Capacity]

pub fn push_char(mut s: String, c: char) -> Result[(), Capacity] {
    let v = char.to_u32(c)
    // ASCII into room the String owns: one byte, no growth. A static String has capacity 0.
    if v < 0x80 && string.byte_len(s) < list.capacity(string.as_bytes(s)) {
        let owned = replace(mut s, string.new())
        let mut b = to_bytes(take owned)
        // There is room, so this admits nothing.
        let _ = list.push(mut b, int.truncate(v))
        s = of_bytes(take b)
        return Ok(())
    }
    push_scalar(mut s, v)
}

// Any scalar value v, growing (or copying out of static storage) first. One branch per UTF-8
// width with constant shifts: no shift loop and no shift-amount check.
fn push_scalar(mut s: String, v: u32) -> Result[(), Capacity] {
    let w: u64 = if v < 0x80 {
        1
    } else if v < 0x800 {
        2
    } else if v < 0x10000 {
        3
    } else {
        4
    }
    string.reserve(mut s, w)?
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    // Room for w bytes is reserved, so no push below admits anything.
    if w == 1 {
        let _ = list.push(mut b, int.truncate(v))
    } else if w == 2 {
        let _ = list.push(mut b, int.truncate(0xC0 | (v >> 6)))
        let _ = list.push(mut b, int.truncate(0x80 | (v & 0x3F)))
    } else if w == 3 {
        let _ = list.push(mut b, int.truncate(0xE0 | (v >> 12)))
        let _ = list.push(mut b, int.truncate(0x80 | ((v >> 6) & 0x3F)))
        let _ = list.push(mut b, int.truncate(0x80 | (v & 0x3F)))
    } else {
        let _ = list.push(mut b, int.truncate(0xF0 | (v >> 18)))
        let _ = list.push(mut b, int.truncate(0x80 | ((v >> 12) & 0x3F)))
        let _ = list.push(mut b, int.truncate(0x80 | ((v >> 6) & 0x3F)))
        let _ = list.push(mut b, int.truncate(0x80 | (v & 0x3F)))
    }
    s = of_bytes(take b)
    Ok(())
}

pub fn push_u64(mut s: String, n: u64) -> Result[(), Capacity] {
    // The digit count w: low = floor(bits x log10(2)) is w or w - 1, and n reaches 10^low exactly when
    // it is w (low = 0 only below 8, where w is 1: its threshold is 0).
    let lz: u64 = int.widen(int.leading_zeros(n))
    let low = (64 - lz) * 1233 >> 12
    let reach: u64 = match low {
        0 => 0,
        1 => 10,
        2 => 100,
        3 => 1000,
        4 => 10000,
        5 => 100000,
        6 => 1000000,
        7 => 10000000,
        8 => 100000000,
        9 => 1000000000,
        10 => 10000000000,
        11 => 100000000000,
        12 => 1000000000000,
        13 => 10000000000000,
        14 => 100000000000000,
        15 => 1000000000000000,
        16 => 10000000000000000,
        17 => 100000000000000000,
        18 => 1000000000000000000,
        _ => 10000000000000000000,
    }
    let w = if n >= reach {
        low + 1
    } else {
        low
    }
    // w zeros in one copy from a static literal, then the digits over them from the last.
    string.push(mut s, match w {
        1 => "0",
        2 => "00",
        3 => "000",
        4 => "0000",
        5 => "00000",
        6 => "000000",
        7 => "0000000",
        8 => "00000000",
        9 => "000000000",
        10 => "0000000000",
        11 => "00000000000",
        12 => "000000000000",
        13 => "0000000000000",
        14 => "00000000000000",
        15 => "000000000000000",
        16 => "0000000000000000",
        17 => "00000000000000000",
        18 => "000000000000000000",
        19 => "0000000000000000000",
        _ => "00000000000000000000",
    })?
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    let base = list.len(b) - w
    let mut i = list.len(b)
    let mut m = n
    // Eight digits a step, at most twice: one division by 10^8, then all eight digits at once in a
    // word, a lane per digit (most significant in the low byte): split into two halves of four
    // digits, each half into two pairs (x 10486 >> 20 is / 100 below 10^4), each pair into two
    // digits (x 103 >> 10 is / 10 below 100). No lane carries into the next.
    while m >= 100000000 {
        let v = m % 100000000
        m = m / 100000000
        i -= 8
        // Every lane stays below 2^16 and every product below 2^63, so the wrapping forms never wrap.
        let x = v / 10000 | (v % 10000) << 32
        let y = (int.wrapping_mul(x, 10486) >> 20) & 0x0000007F0000007F
        let z = y | int.wrapping_sub(x, int.wrapping_mul(y, 100)) << 16
        let t = (int.wrapping_mul(z, 103) >> 10) & 0x000F000F000F000F
        let digits = (t | int.wrapping_sub(z, int.wrapping_mul(t, 10)) << 8) | 0x3030303030303030
        // The highest index first: a Bounds failure raises before any byte of the block changes.
        b[i + 7] = int.truncate(digits >> 56)
        b[i] = int.truncate(digits & 0xFF)
        b[i + 1] = int.truncate(digits >> 8 & 0xFF)
        b[i + 2] = int.truncate(digits >> 16 & 0xFF)
        b[i + 3] = int.truncate(digits >> 24 & 0xFF)
        b[i + 4] = int.truncate(digits >> 32 & 0xFF)
        b[i + 5] = int.truncate(digits >> 40 & 0xFF)
        b[i + 6] = int.truncate(digits >> 48 & 0xFF)
    }
    // m < 10^8: four digits at once (the same lanes in 32 bits), then at base the last 1 to 4.
    if m >= 10000 {
        let r = m % 10000
        m = m / 10000
        i -= 4
        let x = r / 100 | (r % 100) << 16
        let t = (int.wrapping_mul(x, 103) >> 10) & 0x000F000F
        let digits = (t | int.wrapping_sub(x, int.wrapping_mul(t, 10)) << 8) | 0x30303030
        b[i + 3] = int.truncate(digits >> 24)
        b[i] = int.truncate(digits & 0xFF)
        b[i + 1] = int.truncate(digits >> 8 & 0xFF)
        b[i + 2] = int.truncate(digits >> 16 & 0xFF)
    }
    if m >= 1000 {
        let x = m / 100 | (m % 100) << 16
        let t = (int.wrapping_mul(x, 103) >> 10) & 0x000F000F
        let digits = (t | int.wrapping_sub(x, int.wrapping_mul(t, 10)) << 8) | 0x30303030
        b[base + 3] = int.truncate(digits >> 24)
        b[base] = int.truncate(digits & 0xFF)
        b[base + 1] = int.truncate(digits >> 8 & 0xFF)
        b[base + 2] = int.truncate(digits >> 16 & 0xFF)
    } else {
        if m >= 100 {
            let hundreds: u8 = int.truncate(m / 100)
            b[base] = b'0' + hundreds
            m = m % 100
            i = base + 1
        } else {
            i = base
        }
        if m >= 10 || i > base {
            let tens: u8 = int.truncate(m / 10)
            let ones: u8 = int.truncate(m % 10)
            b[i] = b'0' + tens
            b[i + 1] = b'0' + ones
        } else {
            let d: u8 = int.truncate(m)
            b[i] = b'0' + d
        }
    }
    s = of_bytes(take b)
    Ok(())
}

pub fn reserve(mut s: String, n: u64) -> Result[(), Capacity]

pub fn truncate(mut s: String, n: u64) {
    {
        let b = string.as_bytes(s)
        let len = list.len(b)
        if n > len || (n < len && (b[n] & 0xC0) == 0x80) {
            // Past the length or inside a scalar: Bounds, raised by the index len.
            let _ = b[len]
        }
    }
    // The same bytes, shorter: a static String stays static, an owned one keeps its capacity.
    shorten(mut s, n)
}

pub fn make_ascii_upper(mut s: String) -> Result[(), Capacity] {
    if list.capacity(string.as_bytes(s)) == 0 && string.byte_len(s) != 0 {
        // Static storage with bytes: copied first, as into_bytes copies it.
        let lit = replace(mut s, string.new())
        match into_bytes(take lit) {
            Ok(take bs) => {
                s = of_bytes(take bs)
            },
            Error((c, take back)) => {
                s = back
                return Error(c)
            },
        }
    }
    // s owns its storage or is empty: the carrier moves to Bytes with no call and no Result.
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    for i in 0 .. list.len(b) {
        let x = b[i]
        // One comparison: below b'a' wraps past 25. Every byte is stored, changed or not, so
        // the loop has no branch and vectorizes. Only a-z change, so b stays UTF-8.
        b[i] = if int.wrapping_sub(x, b'a') < 26 { int.wrapping_sub(x, 32) } else { x }
    }
    s = of_bytes(take b)
    Ok(())
}

pub fn make_ascii_lower(mut s: String) -> Result[(), Capacity] {
    if list.capacity(string.as_bytes(s)) == 0 && string.byte_len(s) != 0 {
        // Static storage with bytes: copied first, as into_bytes copies it.
        let lit = replace(mut s, string.new())
        match into_bytes(take lit) {
            Ok(take bs) => {
                s = of_bytes(take bs)
            },
            Error((c, take back)) => {
                s = back
                return Error(c)
            },
        }
    }
    // s owns its storage or is empty: the carrier moves to Bytes with no call and no Result.
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    for i in 0 .. list.len(b) {
        let x = b[i]
        // As make_ascii_upper: only A-Z change, so b stays UTF-8.
        b[i] = if int.wrapping_sub(x, b'A') < 26 { int.wrapping_add(x, 32) } else { x }
    }
    s = of_bytes(take b)
    Ok(())
}

// The kernel, the only unchecked code in core. The String and Bytes carriers are one layout,
// {data, length, capacity}; these rewrite or reinterpret a carrier and check nothing, so each
// caller establishes the precondition stated on it.

// b is UTF-8. (As a List, b already owns its storage or is empty.)
fn of_bytes(take b: Bytes) -> String
// s owns its storage or is empty: capacity(as_bytes(s)) > 0 or byte_len(s) == 0. A static String
// with bytes never becomes a List, which would write in place; copy it or reserve first.
fn to_bytes(take s: String) -> Bytes
// b is UTF-8 cut at scalar boundaries at both ends.
fn view_string(b: Bytes) -> View[String] in b
// n <= byte_len(s), at a scalar boundary. Only the length changes: data and capacity stay.
fn shorten(mut s: String, n: u64)

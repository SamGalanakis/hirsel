// LANG-8's exact spurious waits example, followed by waiting calls that need the mark.
// expect: refuse LANG-8 at 12:25
// expect: refuse LANG-8 at 13:44
// expect: refuse LANG-8 at 14:38
// expect: refuse LANG-8 at 15:35
// expect: refuse LANG-8 at 16:40
// expect: compared LANG-8 at 15:35 | not waits | waits
// expect: compared LANG-8 at 16:40 | not waits | waits
// expect: compared LANG-8 at 12:25 | waits | not waits
// expect: compared LANG-8 at 13:44 | not waits | waits
// expect: compared LANG-8 at 14:38 | not waits | waits
fn twice(x: u64) -> u64 waits { x * 2 }
fn send(tx:Sender[u64],take x:u64) { let _=channel.send(tx,x) }
fn receive(rx:Receiver[u64]) { let _=channel.receive(rx) }
fn join(take h:Task[u64]) { let _=task.join(take h) }
fn indirect(f:fn()->u64 waits) { let _=f() }

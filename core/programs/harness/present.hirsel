// Module harness: recorded tool presentation (ADR 0120). The settled outcome
// stays canonical on the effect row; the model-facing text is decided once,
// in the transaction that appends the result entry, and recorded with it.

// The standard wording of an outcome for the model, with whether the provider
// should mark it as an error.
pub fn worded(o: Outcome) -> Presented {
    match o {
        Returned(Inline(b)) => match string.from_utf8(clone(b)) {
            Ok(take s) => Presented(text: take s, error: false),
            Error(_) => Presented(text: "the tool returned bytes that are not text", error: true),
        },
        Returned(Blob(r)) => match r.excerpt {
            Some(text) => Presented(text: string.from(text), error: false),
            None => Presented(text: joined("the tool returned a stored object of type ", r.mime), error: false),
        },
        Failed(why) => Presented(text: joined("the tool failed: ", why), error: true),
        Denied(why) => Presented(text: joined("the call was not allowed: ", why), error: true),
        InDoubt => Presented(text: "the call was interrupted and may or may not have taken effect; check before repeating it", error: true),
        Gone => Presented(text: "this tool is no longer available", error: true),
    }
}

fn joined(a: String, b: String) -> String {
    let mut out = string.from(a)
    string.push(mut out, b)
    take out
}

// The agent's presenter, bounded like a gate, or the standard wording when it
// is absent, fails, overruns or answers more than INLINE_LIMIT bytes.
fn presented[G: send, App: inert + send](a: Agent[G, App], c: Call, o: Outcome) -> Presented {
    let Some(hook) = a.presenter else {
        return worded(o)
    }
    let go = code.callable(hook)
    let ran = bound bytes a.limits.gate_bytes {
        bound steps a.limits.gate_steps {
            go(c, o)
        }
    }
    match take ran {
        Ok(Ok(take p)) => if string.byte_len(p.text) <= INLINE_LIMIT { take p } else { worded(o) },
        _ => worded(o),
    }
}

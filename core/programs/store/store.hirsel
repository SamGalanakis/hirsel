fn disk_test_schema_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_schema_refusal(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }

#!/usr/bin/env python3
"""Build and measure the fixed goal-11 native runtime corpus against safe Rust."""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import math
import os
from pathlib import Path
import re
import shutil
import statistics
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT / 'bench/native'), str(ROOT / 'bench/micro')]
from suite import buck2_build, native_environment  # noqa: E402
from measure import busy_share, cpu_snapshot, siblings  # noqa: E402

# Version changes when a workload, input, algorithm or process boundary changes.
VERSION = 2
CASES = (
    ('json', 'bench/micro/programs/extended/json.hir', 'json-reference', [], ['2000', '2']),
    ('log_parser', 'bench/runtime-corpus/log_main.hir', 'log-reference', [], ['10000', '10']),
    ('gzip', 'bench/micro/programs/extended/gzip_read.hir', 'gzip-reference', [], ['4096']),
    ('float_math', 'bench/micro/programs/float_math.hir', 'micro-reference', ['float_math'], ['100000', '2']),
    ('priority_queue', 'bench/priority-queue-combined/topk.hir', 'queue-reference', [], ['0', '1024', '131072', '42']),
    ('map_u64', 'bench/micro/programs/map_u64.hir', 'micro-reference', ['map_u64'], ['200000', '2']),
    ('strbuild', 'bench/micro/programs/strbuild.hir', 'micro-reference', ['strbuild'], ['200000', '2']),
    ('channel', 'bench/micro/programs/channel.hir', 'micro-reference', ['channel'], ['10000']),
)


def perf_result(text):
    instructions = re.search(r'^\s*([\d.]+)\s+instructions:u\b(.*)$', text, re.M)
    elapsed = re.search(r'^\s*([\d.]+)\s+seconds time elapsed\s*$', text, re.M)
    if not instructions or not elapsed:
        raise ValueError('perf instructions or elapsed summary missing/unsupported')
    count, seconds = float(instructions[1]), float(elapsed[1])
    if not all(math.isfinite(value) and value > 0 for value in (count, seconds)):
        raise ValueError('invalid perf instructions or elapsed summary')
    percent = re.search(r'\(\s*([\d.]+)%\)', instructions[2])
    return dict(instructions=count, seconds=seconds,
                running_percent=float(percent[1]) if percent else 100.0)


def build(output, env):
    subprocess.run(['python3', str(ROOT / 'tools/buck2/prepare.py')], cwd=ROOT, check=True)
    subprocess.run(['python3', str(ROOT / 'tools/buck2/sync.py'), '--if-stale'], cwd=ROOT, check=True)
    targets = ['//:hirsel-toolchain', '//bench/micro-json-reference:json-reference',
               '//bench/runtime-corpus:log-reference', '//bench/runtime-corpus:gzip-reference',
               '//bench/micro/rust:micro-reference', '//bench/priority-queue-combined:queue-reference']
    built = buck2_build('--target-platforms', '//tools/buck2:release', *targets)
    native = native_environment(env)
    # This bundle contains the compiler's matching std products.
    bundle = Path(built['hirsel-toolchain'])
    native['HIRSEL_PRECHECK'] = str(bundle / 'hirsel-std.precheck')
    for target in {case[2] for case in CASES}:
        shutil.copy2(built[target], output / target)
    for name, source, *_ in CASES:
        package = output / (name + '.json')
        sources = [dict(path=str(ROOT / source), module=[])]
        if name == 'log_parser':
            sources += [dict(path=str(ROOT / 'bench/langarena' / (module + '.hir')), module=[module])
                        for module in ('harness', 'log_parser')]
        package.write_text(json.dumps(dict(
            schema=1, package=dict(name='runtime_corpus_' + name, version='1'),
            entry=dict(module=[], name='main'), sources=sources,
            dependencies=[dict(manifest=str(ROOT / 'stdlib/std@1/hirsel.json'),
                               package=dict(name='std', version='1'), expose=[])])) + '\n')
        print('Building ' + name, flush=True)
        subprocess.run([str(ROOT / 'tools/capped'), str(bundle / 'hirsel'), 'build', '--release',
                        str(package), '-o', str(output / name)], cwd=ROOT, env=native, check=True)
    (output / 'grants.json').write_text(json.dumps(dict(io=dict(
        stdout='stdout.bytes@1', tasks='tasks.cooperative@1',
        monotonic_clock='clock.monotonic.ns@1', dirs=[]))) + '\n')
    (output / 'build-revision').write_text(subprocess.check_output(
        ['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True))


def commands(output, case):
    name, _, reference, prefix, args = case
    return dict(hirsel=[str(output / name), '--hirsel-grants', str(output / 'grants.json'), *args],
                rust=[str(output / reference), *prefix, *args])


def sample(command, directory, cpu, env):
    directory.mkdir()
    counters, before, after = [directory / p for p in ('perf.txt', 'before.stat', 'after.stat')]
    # Linux v6.8 tools/perf/builtin-stat.c:872-884 starts the child BEFORE t0.
    # Keep perf on another CPU so a short child cannot run to completion before
    # its observer starts the elapsed clock. The counted taskset places only
    # the workload and all of its child threads on the benchmark CPU.
    observer = next(c for c in sorted(os.sched_getaffinity(0))
                    if c != cpu and c not in siblings(cpu))
    # perf inherits every task/thread, including the Rust channel's worker.
    # Both hooks execute inside capped, excluding slot wait from observations.
    import shlex
    perf = ['taskset', '-c', str(observer), 'perf', 'stat', '--no-big-num',
            '-e', 'instructions:u', '-o', str(counters),
            '--pre', 'cat /proc/stat > ' + shlex.quote(str(before)),
            '--post', 'cat /proc/stat > ' + shlex.quote(str(after)),
            '--', 'taskset', '-c', str(cpu), *command]
    with (directory / 'stdout').open('wb') as out, (directory / 'stderr').open('wb') as err:
        process = subprocess.run([str(ROOT / 'tools/capped'), *perf], cwd=ROOT, env=env,
                                 stdin=subprocess.DEVNULL, stdout=out, stderr=err)
    if process.returncode:
        raise ValueError(f'exit {process.returncode}; see {directory / "stderr"}')
    measured = perf_result(counters.read_text())
    sibling_cpus = siblings(cpu)
    return dict(measured, command=command, observer_cpu=observer,
                sibling_busy_share=busy_share(cpu_snapshot(sibling_cpus, before),
                                              cpu_snapshot(sibling_cpus, after)))


def summarize(rows, repeats):
    complete = ([row['name'] for row in rows] == [case[0] for case in CASES]
                and all(row['status'] == 'OK' for row in rows))
    for row in rows:
        if row['status'] != 'OK':
            continue
        for metric in ('instructions', 'seconds'):
            values = {side: [s[metric] for s in row[side]] for side in ('hirsel', 'rust')}
            if any(len(v) != repeats for v in values.values()):
                raise ValueError('incomplete samples')
            row[metric + '_ratio'] = statistics.median(values['hirsel']) / statistics.median(values['rust'])
            row[metric + '_spread_pct'] = {
                side: 100 * (max(v) - min(v)) / statistics.median(v) if repeats > 1 else None
                for side, v in values.items()}
    result = dict(complete=complete)
    for metric in ('instructions', 'seconds'):
        ratios = [row[metric + '_ratio'] for row in rows if row['status'] == 'OK']
        # A failed/missing workload never disappears from the fixed denominator.
        result[metric] = (dict(geomean=math.exp(statistics.mean(map(math.log, ratios))),
                               max=max(ratios)) if complete else None)
    result['within_budget'] = complete and result['instructions']['geomean'] <= 1.5 and result['instructions']['max'] <= 3
    return result


def table(record):
    lines = ['| Workload | Hirsel instructions:u | Rust instructions:u | H/R instructions | H/R wall | Spread H/R |',
             '|---|---:|---:|---:|---:|---:|']
    for row in record['rows']:
        if row['status'] != 'OK':
            lines.append(f'| {row["name"]} | {row["status"]} | | | | |')
            continue
        h, r = [statistics.median(s['instructions'] for s in row[side]) for side in ('hirsel', 'rust')]
        spread = row['instructions_spread_pct']
        shown = ('unmeasured, n=1' if record['repeats'] == 1 else
                 f'{spread["hirsel"]:.2f}% / {spread["rust"]:.2f}%')
        lines.append(f'| {row["name"]} | {h:,.0f} | {r:,.0f} | {row["instructions_ratio"]:.3f}x | {row["seconds_ratio"]:.3f}x | {shown} |')
    for label in ('geomean', 'max'):
        metrics = record['summary']
        if metrics['complete']:
            lines.append(f'| {label} | | | {metrics["instructions"][label]:.3f}x | {metrics["seconds"][label]:.3f}x | |')
        else:
            lines.append(f'| {label} | incomplete | | | | |')
    verdict = ('INCOMPLETE' if not record['summary']['complete'] else
               'PASS' if record['summary']['within_budget'] else 'MISS')
    lines.append('Instruction budget: ' + verdict)
    return '\n'.join(lines) + '\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--cpu', type=int, default=2)
    parser.add_argument('--repeats', type=int, default=1,
                        help='one on this host; repeated runs elsewhere report median and min-max spread')
    parser.add_argument('--output', type=Path, required=True, help='build and raw sample directory outside the repository')
    parser.add_argument('--history', type=Path, default=Path.home() / '.local/state/hirsel/runtime-corpus.jsonl')
    parser.add_argument('--build-only', action='store_true')
    parser.add_argument('--skip-build', action='store_true', help='use executables in --output from --build-only')
    args = parser.parse_args()
    if args.cpu in (*range(12, 16), *range(28, 32)) or args.cpu not in os.sched_getaffinity(0):
        parser.error('CPU is prohibited or outside inherited affinity')
    if args.repeats < 1:
        parser.error('repeats must be positive')
    observers = os.sched_getaffinity(0) - {args.cpu, *siblings(args.cpu),
                                        *range(12, 16), *range(28, 32)}
    if not observers:
        parser.error('allow a separate CPU for perf, outside the workload CPU and its SMT siblings')
    output = args.output.resolve()
    if output == ROOT or ROOT in output.parents:
        parser.error('keep builds and measurement evidence outside the repository')
    if (output / 'result.json').exists():
        parser.error('output already has results; choose a fresh directory')
    output.mkdir(parents=True, exist_ok=True)
    # Keep all local setup/build processes off prohibited CPUs too.
    os.sched_setaffinity(0, os.sched_getaffinity(0) - {*range(12, 16), *range(28, 32)})
    env = dict(os.environ, HIRSEL_MEMORY_LIMIT='2G', HIRSEL_JOBS='1',
               HIRSEL_DAEMON='off', LC_ALL='C')
    if not args.skip_build:
        build(output, env)
    if args.build_only:
        return 0
    record = dict(corpus_version=VERSION, revision=(output / 'build-revision').read_text().strip(),
        date=datetime.now(timezone.utc).isoformat(), cpu=args.cpu, repeats=args.repeats,
        memory_limit='2G', profile='release', rows=[])
    # Same advisory lock used by bench/micro/run on ordinary CPUs.
    with open(f'/tmp/hirsel-micro-cpu{args.cpu}.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for index, case in enumerate(CASES):
            row = dict(name=case[0], status='OK', hirsel=[], rust=[])
            pair = commands(output, case)
            expected = None
            try:
                for repeat in range(args.repeats):
                    for side in (('rust', 'hirsel') if (index + repeat) % 2 == 0 else ('hirsel', 'rust')):
                        directory = output / f'{case[0]}-{repeat}-{side}'
                        measured = sample(pair[side], directory, args.cpu, env)
                        stdout = (directory / 'stdout').read_bytes()
                        if expected is None:
                            expected = stdout
                        if stdout != expected:
                            raise ValueError(f'{case[0]}: unequal stdout; see {directory}')
                        if not stdout.strip():
                            raise ValueError('empty stdout cannot prove equivalent work')
                        row[side].append(measured)
                row['stdout'] = expected.decode('utf-8')
                print(case[0] + ': identical stdout', flush=True)
            except (ValueError, OSError) as error:
                row.update(status='FAILED', error=str(error))
                print(case[0] + ': ' + str(error), file=sys.stderr, flush=True)
            record['rows'].append(row)
    record['summary'] = summarize(record['rows'], args.repeats)
    (output / 'result.json').write_text(json.dumps(record, indent=2) + '\n')
    report = table(record)
    (output / 'table.md').write_text(report)
    print(report)
    args.history.parent.mkdir(parents=True, exist_ok=True)
    with args.history.open('a') as history:
        fcntl.flock(history, fcntl.LOCK_EX)
        history.write(json.dumps(record) + '\n')
    return 0 if record['summary']['complete'] else 1


if __name__ == '__main__':
    sys.exit(main())

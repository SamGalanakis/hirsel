// Heap exposes no key or ordered bound, so structural comparison is refused.
// expect: refuse LANG-21 at 8:48
// expect: refuse LANG-21 at 9:48
// expect: refuse LANG-12 at 10:18
// expect: compared LANG-12 at 10:18 | core@1/heap/Heap[u64] | key
// expect: compared LANG-21 at 8:48 | core@1/heap/Heap[u64] | key
// expect: compared LANG-21 at 9:48 | core@1/heap/Heap[u64] | ordered
fn equal(a: Heap[u64], b: Heap[u64]) -> bool { a == b }
fn order(a: Heap[u64], b: Heap[u64]) -> bool { a < b }
fn as_key(m: Map[Heap[u64], u64]) {}

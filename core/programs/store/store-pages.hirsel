type PageTree: shareable + send {
    root: Arc[std.page.Page],
    inline: u64,
    // The collection map keeps its empty child shared even while every collection has rows.
    empty_collection: Option[Arc[std.page.Page]]
}

type PageRoots: shareable + send {
    collections: PageTree,
    streams: PageTree,
    catalog: PageTree
}

fn attach_page_tree(pages: Map[u64, Arc[std.page.Page]], ptr: std.page.PagePtr, domain: std.page.Domain, inline: u64, take empty_collection: Option[Arc[std.page.Page]]) -> PageTree {
    let root = if ptr.stamp == 0 {
        std.page.empty(0, 0, domain)
    } else {
        let Some(found) = map.get(pages, ptr.stamp) else {
            fail("store: missing validated root")
        }
        arc.share(found)
    }
    PageTree(root: take root, inline: inline, empty_collection: take empty_collection)
}

fn attach_page_roots(pages: Map[u64, Arc[std.page.Page]], roots: LocatedRoots, inline: u64, empty_collection: Arc[std.page.Page]) -> PageRoots {
    PageRoots(collections: attach_page_tree(pages, roots.collections, CollectionMap, inline, Some(arc.share(empty_collection))), streams: attach_page_tree(pages, roots.streams, Unprefixed, inline, None), catalog: attach_page_tree(pages, roots.catalog, Unprefixed, inline, None))
}

fn new_page_tree(domain: std.page.Domain, inline: u64) -> PageTree {
    let empty_collection = if domain == CollectionMap {
        Some(std.page.empty(0, 0, Collection))
    } else {
        None
    }
    PageTree(root: std.page.empty(0, 0, domain), inline: inline, empty_collection: take empty_collection)
}

fn share_page_tree(tree: PageTree) -> PageTree {
    let empty_collection = match tree.empty_collection {
        Some(empty) => Some(arc.share(empty)),
        None => None
    }
    PageTree(root: arc.share(tree.root), inline: tree.inline, empty_collection: take empty_collection)
}

fn tree_domain(tree: PageTree) -> std.page.Domain {
    std.page.key_domain(std.page.image_of(tree.root))
}

fn tree_stamp(tree: PageTree) -> u64 {
    std.page.stamp(std.page.image_of(tree.root))
}

fn install_page_tree(mut tree: PageTree, take replacement: PageTree) {
    let PageTree(root: take ready, inline: width, ..) = take replacement
    std.page.install_planned(mut tree.root, take ready)
    tree.inline = width
}

fn page_error(problem: std.page.Error) -> Error {
    match problem {
        StampLimit => Limit(Ids),
        PageLimit => Limit(Value),
        UnsupportedPage => Unsupported(0x0021),
        _ => malformed(0),
    }
}

fn page_result[T](take value: Result[T, std.page.Error]) -> Result[T, Error] {
    match take value {
        Ok(take ready) => Ok(take ready),
        Error(problem) => Error(page_error(problem)),
    }
}

fn collection_header(stamp: u64, rows: u64, charge: u64, kind: u8, residency: u8) -> Result[Bytes, Error] {
    let mut record = std.page.encode_ptr(std.page.unlocated(stamp))
    capacity(le(mut record, rows, 8))?
    capacity(le(mut record, charge, 8))?
    list.push(mut record, kind)
    list.push(mut record, residency)
    list.fill(mut record, 2, 0u8)
    Ok(take record)
}

fn rooted_collection_record(root: Arc[std.page.Page], kind: u8, residency: u8) -> Result[Bytes, Error] {
    let (rows, charge) = std.page.totals(root)
    let stamp = if rows == 0 { 0u64 } else { std.page.stamp(std.page.image_of(root)) }
    collection_header(stamp, rows, charge, kind, residency)
}

fn cell_record(root: Arc[std.page.Page], inline: Option[View[Bytes]]) -> Result[Bytes, Error] {
    if let Some(value) = inline {
        let mut record = collection_header(0, 1, 70 + round8(list.len(value)), 3, 0)?
        capacity(le(mut record, list.len(value), 2))?
        list.append(mut record, value)
        return Ok(take record)
    }
    let mut record = rooted_collection_record(root, 3, 0)?
    list.fill(mut record, 2, 0u8)
    Ok(take record)
}

fn log_record(root: Arc[std.page.Page], first_seq: u64, next_seq: u64, residency: u8) -> Result[Bytes, Error] {
    let mut record = rooted_collection_record(root, 4, residency)?
    list.put_word_le(mut record, next_seq)
    list.put_word_le(mut record, first_seq)
    Ok(take record)
}

fn put_collection(mut tree: PageTree, key: Bytes, built: Option[Arc[std.page.Page]], kind: u8, private_from: u64, mut ids: u64) -> Result[(), Error] {
    let root = match built {
        Some(ready) => arc.share(ready),
        None => {
            let Some(shared) = view tree.empty_collection else {
                fail("store: missing empty collection page")
            }
            arc.share(shared)
        },
    }
    let record = match kind {
        3 => cell_record(root, None)?,
        _ => rooted_collection_record(root, kind, 0)?,
    }
    page_result(std.page.insert(mut tree.root, key, record, Some(take root), tree.inline, private_from, mut ids))
}

fn define_collection(mut tree: PageTree, id: u32, kind: u8, private_from: u64, mut ids: u64) -> Result[(), Error] {
    put_collection(mut tree, prefix(id)?, None, kind, private_from, mut ids)
}

fn bulk_collection(mut tree: PageTree, id: u32, kind: u8, rows: List[std.page.Row], private_from: u64, mut ids: u64) -> Result[(), Error] {
    let bulk = page_result(std.page.bulk(rows, Collection, tree.inline, mut ids))?
    put_collection(mut tree, prefix(id)?, bulk, kind, private_from, mut ids)
}

fn count_page_rows(tree: PageTree, id: u32, low: Bytes, high: Bytes) -> Result[u64, Error] {
    let collection_key = prefix(id)?
    let Some((root, descriptor)) = std.page.collection_entry(tree.root, collection_key) else {
        return Ok(0u64)
    }
    let total: u64 = list.word_le(descriptor, 36)
    let from = collection_rank(root, collection_key, low, total)
    let until = collection_rank(root, collection_key, high, total)
    Ok(int.saturating_sub(until, from))
}

fn collection_rank(root: Arc[std.page.Page], id_key: Bytes, boundary: Bytes, total: u64) -> u64 {
    let n = list.len(boundary)
    if n < 4 || list.slice(boundary, 0, 4) < id_key {
        return 0
    }
    if list.slice(boundary, 0, 4) > id_key {
        return total
    }
    if n == 4 {
        return 0
    }
    std.page.rank(root, list.slice(boundary, 4, n), false)
}

fn one_page_account(roots: PageRoots) -> u64 {
    let (_, streams) = std.page.totals(roots.streams.root)
    let (_, catalog) = std.page.totals(roots.catalog.root)
    let mut charge = int.saturating_add(streams, catalog)
    let mut collections = std.page.cursor_open(roots.collections.root, None, true, false)
    while let Some(item) = std.page.cursor_next(mut collections) {
        let bytes_charge: u64 = list.word_le(item.value, 44)
        charge = int.saturating_add(charge, int.saturating_add(126, bytes_charge))
    }
    charge
}

fn page_image_charge(node: Arc[std.page.Page], mut seen: Map[u64, ()]) -> u64 {
    let image = std.page.image_of(node)
    let stamp = std.page.stamp(image)
    if stamp == 0 || map.contains(seen, stamp) {
        return 0
    }
    map.insert(mut seen, stamp, ())
    let mut total = list.capacity(std.page.payload(image))
    for slot in 0u64 .. std.page.count(image) {
        match std.page.owning_edge(image, slot) {
            Some(PageEdge(_)) => {
                let child = option.unwrap(std.page.child(node, slot))
                total = int.saturating_add(total, page_image_charge(child, mut seen))
            },
            Some(BlobEdge(body_ref)) => if !map.contains(seen, body_ref.stamp) {
                map.insert(mut seen, body_ref.stamp, ())
                total = int.saturating_add(total, body_ref.len)
            },
            None => (),
        }
    }
    total
}

fn resident_images(roots: List[PageRoots], lists: Option[View[PagedLists]]) -> u64 {
    let mut seen: Map[u64, ()] = map.new()
    let mut total = 0u64
    for held in roots {
        total = int.saturating_add(total, page_image_charge(held.collections.root, mut seen))
        total = int.saturating_add(total, page_image_charge(held.streams.root, mut seen))
        total = int.saturating_add(total, page_image_charge(held.catalog.root, mut seen))
    }
    if let Some(published) = lists {
        total = int.saturating_add(total, page_image_charge(published.packs, mut seen))
        total = int.saturating_add(total, page_image_charge(published.retired, mut seen))
    }
    total
}

fn account_frontier(mut ready: Heap[(Bytes, u64)], walks: List[std.page.Walk], slot: u64) {
    if let Some(take key) = std.page.walk_key(walks[slot]) {
        heap.push(mut ready, (take key, slot))
    }
}

fn compare_row_versions(first: std.page.Walk, second: std.page.Walk) -> Order {
    let stamp = std.page.walk_blob_stamp(first)
    if stamp != 0 && stamp == std.page.walk_blob_stamp(second) {
        return Equal
    }
    let Some(a) = std.page.walk_value(first) else {
        fail("store: missing row version")
    }
    let Some(b) = std.page.walk_value(second) else {
        fail("store: missing row version")
    }
    list.compare_bytes(a, b)
}

fn count_row_versions(walks: List[std.page.Walk], mut group: List[u64], key_width: u64) -> u64 {
    list.sort(mut group, scoped fn(a: u64, b: u64) -> Order {
        compare_row_versions(walks[a], walks[b])
    })
    let mut charge = 0u64
    for slot in 0u64 .. list.len(group) {
        let current = group[slot]
        if slot != 0 && compare_row_versions(walks[current], walks[group[slot - 1]]) == Equal {
            continue
        }
        let Some(raw) = std.page.walk_value(walks[current]) else {
            fail("store: missing row version")
        }
        charge = int.saturating_add(charge, 62 + round8(key_width) + round8(list.len(raw)))
    }
    charge
}

fn row_version_union(roots: List[Arc[std.page.Page]], prefix_width: u64) -> u64 {
    let mut walks: List[std.page.Walk] = list.with_capacity(list.len(roots))
    let mut ready: Heap[(Bytes, u64)] = heap.new()
    let mut seen: Map[u64, ()] = map.new()
    for root in roots {
        let stamp = std.page.stamp(std.page.image_of(root))
        if stamp == 0 || map.contains(seen, stamp) {
            continue
        }
        map.insert(mut seen, stamp, ())
        let slot = list.len(walks)
        list.push(mut walks, std.page.walk_begin(root))
        account_frontier(mut ready, walks, slot)
    }
    let mut group: List[u64] = list.new()
    let mut charge = 0u64
    while let Some((take key, first)) = heap.pop(mut ready) {
        list.clear(mut group)
        list.push(mut group, first)
        loop {
            let same_key = match heap.peek(ready) {
                Some((following, _)) => following == key,
                None => false
            }
            if !same_key {
                break
            }
            let (_, slot) = option.unwrap(heap.pop(mut ready))
            list.push(mut group, slot)
        }
        let mut shared = std.page.walk_subtree(walks[first])
        let mut highest: Option[u8] = None
        for slot in group {
            if let Some(span) = std.page.walk_subtree(walks[slot]) {
                if let Some(common) = shared {
                    if common.stamp != span.stamp {
                        shared = None
                    }
                }
                let lvl = match highest {
                    Some(prior) => order.max(prior, span.level),
                    None => span.level
                }
                highest = Some(lvl)
            } else {
                shared = None
            }
        }
        if let Some(_) = shared {
            let high = option.unwrap(std.page.walk_subtree_high(walks[first]))
            let overlaps = match heap.peek(ready) {
                Some((following, _)) => following <= high,
                None => false
            }
            if !overlaps {
                charge = int.saturating_add(charge, std.page.walk_subtree_charge(walks[first]))
                for slot in group {
                    std.page.walk_next(mut walks[slot])
                    account_frontier(mut ready, walks, slot)
                }
                continue
            }
        }
        if let Some(top_level) = highest {
            for slot in group {
                if let Some(span) = std.page.walk_subtree(walks[slot]) {
                    if span.level == top_level {
                        std.page.walk_expand(mut walks[slot])
                    }
                }
                account_frontier(mut ready, walks, slot)
            }
        } else {
            charge = int.saturating_add(charge, count_row_versions(walks, mut group, prefix_width + list.len(key)))
            for slot in group {
                std.page.walk_next(mut walks[slot])
                account_frontier(mut ready, walks, slot)
            }
        }
    }
    charge
}

fn page_row_account(roots: List[PageRoots]) -> u64 {
    if list.len(roots) == 1 {
        return one_page_account(roots[0u64])
    }
    let mut streams: List[Arc[std.page.Page]] = list.with_capacity(list.len(roots))
    let mut catalog: List[Arc[std.page.Page]] = list.with_capacity(list.len(roots))
    let mut collections: Map[u32, List[Arc[std.page.Page]]] = map.new()
    let mut cells: Map[u32, List[Arc[Bytes]]] = map.new()
    for participating in roots {
        list.push(mut streams, arc.share(participating.streams.root))
        list.push(mut catalog, arc.share(participating.catalog.root))
        let mut listed = std.page.cursor_open(participating.collections.root, None, true, false)
        while let Some(take item) = std.page.cursor_next(mut listed) {
            let std.page.CursorRow(key: take key, value: take descriptor, collection: take collection_root) = take item
            let id: u32 = list.word_be(key, 0)
            let Some(take child) = take collection_root else {
                fail("store: missing collection root")
            }
            if descriptor[52] == 3 {
                let value = owned_cell(child, descriptor)
                map.update_or_insert(mut cells, id, list.new(), fn(mut group: List[Arc[Bytes]]) {
                    if let Some(raw) = value {
                        list.push(mut group, arc.share(raw))
                    }
                })
                continue
            }
            map.update_or_insert(mut collections, id, list.new(), fn(mut group: List[Arc[std.page.Page]]) {
                list.push(mut group, arc.share(child))
            })
        }
    }
    let mut charge = int.saturating_add(row_version_union(streams, 0), row_version_union(catalog, 0))
    for (_, group) in collections {
        charge = int.saturating_add(charge, int.saturating_add(126, row_version_union(group, 4)))
    }
    for (_, group) in cells {
        let mut versions: List[Arc[Bytes]] = clone(group)
        list.sort(mut versions, fn(a: Arc[Bytes], b: Arc[Bytes]) -> Order { list.compare_bytes(a, b) })
        charge = int.saturating_add(charge, 126)
        for i in 0u64 .. list.len(versions) {
            if i == 0 || versions[i - 1] != versions[i] {
                charge = int.saturating_add(charge, 70 + round8(list.len(versions[i])))
            }
        }
    }
    charge
}

fn get_page_row(tree: PageTree, key: Bytes) -> Option[View[Bytes]] in tree {
    if tree_domain(tree) != CollectionMap {
        return std.page.lookup(tree.root, key)
    }
    if list.len(key) < 4 {
        return None
    }
    let Some((root, descriptor)) = std.page.collection_entry(tree.root, list.slice(key, 0, 4)) else {
        return None
    }
    if descriptor[52] == 3 {
        if list.len(key) != 4 {
            return None
        }
        if let Some(raw) = inline_cell(descriptor) {
            return Some(raw)
        }
    }
    std.page.lookup(root, list.slice(key, 4, list.len(key)))
}

fn collection_kind(tree: PageTree, key: Bytes) -> Option[u8] {
    match std.page.lookup(tree.root, key) {
        Some(descriptor) => Some(descriptor[52]),
        None => None,
    }
}

fn put_page_row(mut tree: PageTree, key: Bytes, value: Bytes, private_from: u64, mut ids: u64) -> Result[(), Error] {
    if tree_domain(tree) != CollectionMap {
        return page_result(std.page.insert(mut tree.root, key, value, None, tree.inline, private_from, mut ids))
    }
    if list.len(key) < 4 {
        return Error(Limit(Key))
    }
    let collection_key = list.slice(key, 0, 4)
    if let None = std.page.collection_child(tree.root, collection_key) {
        return Error(Stale(list.word_be(key, 0)))
    }
    let inline = tree.inline
    let suffix = list.slice(key, 4, list.len(key))
    page_result(std.page.edit_collection(mut tree.root, collection_key, private_from, mut ids, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        std.page.insert(mut root, suffix, value, None, inline, private_from, mut stamps)
    }))
}

fn put_shared_page_row(mut tree: PageTree, key: Bytes, value: Arc[Bytes], private_from: u64, mut ids: u64) -> Result[(), Error] {
    if tree_domain(tree) != CollectionMap {
        return page_result(std.page.insert_shared(mut tree.root, key, value, tree.inline, private_from, mut ids))
    }
    if list.len(key) < 4 {
        return Error(Limit(Key))
    }
    let collection_key = list.slice(key, 0, 4)
    let inline = tree.inline
    let suffix = list.slice(key, 4, list.len(key))
    page_result(std.page.edit_collection(mut tree.root, collection_key, private_from, mut ids, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        std.page.insert_shared(mut root, suffix, value, inline, private_from, mut stamps)
    }))
}

fn remove_page_row(mut tree: PageTree, key: Bytes, private_from: u64, mut ids: u64) -> Result[bool, Error] {
    if tree_domain(tree) != CollectionMap {
        return page_result(std.page.remove(mut tree.root, key, private_from, mut ids))
    }
    let present = match get_page_row(tree, key) {
        Some(_) => true,
        None => false
    }
    if !present {
        return Ok(false)
    }
    let collection_key = list.slice(key, 0, 4)
    let suffix = list.slice(key, 4, list.len(key))
    let Some(empty_root) = view tree.empty_collection else {
        fail("store: missing empty collection page")
    }
    page_result(std.page.edit_collection(mut tree.root, collection_key, private_from, mut ids, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        let _ = std.page.remove_with_empty(mut root, suffix, empty_root, private_from, mut stamps)?
        Ok(())
    }))?
    Ok(true)
}

fn drop_collection(mut tree: PageTree, id: u32, private_from: u64, mut ids: u64) -> Result[bool, Error] {
    page_result(std.page.remove(mut tree.root, prefix(id)?, private_from, mut ids))
}

type PageRange: send {
    listed: std.page.Cursor,
    nested: bool,
    active: List[std.page.Cursor],
    collection: u32,
    start: Option[Bytes],
    stop: Option[Bytes],
    inclusive: bool,
    reverse: bool
}

fn open_page_range(tree: PageTree, start: Option[Bytes], inclusive: bool, reverse: bool, take stop: Option[Bytes]) -> Result[PageRange, Error] {
    let nested = tree_domain(tree) == CollectionMap
    let initial: Option[Bytes] = match start {
        None => None,
        Some(key) => Some(copied(list.slice(key, 0, if nested {
            order.min(4, list.len(key))
        } else {
            list.len(key)
        }))?),
    }
    let outer_stop: Option[Bytes] = match view stop {
        None => None,
        Some(key) => {
            // Collection keys are four bytes. A longer upper bound includes
            // its collection; a lower bound always includes its collection.
            let width = if !nested {
                list.len(key)
            } else {
                order.min(if reverse {
                    4
                } else {
                    5
                }, list.len(key))
            }
            Some(copied(list.slice(key, 0, width))?)
        },
    }
    // In reverse, an exclusive four-byte key precedes every row of its
    // collection. The outer cursor can skip that collection at the seek.
    let within_collection = match start {
        Some(key) => list.len(key) > 4,
        None => false,
    }
    let outer_inclusive = inclusive || (nested && (!reverse || within_collection))
    let listed = std.page.cursor_open_bounded(tree.root, initial, outer_inclusive, reverse, take outer_stop)
    Ok(PageRange(listed: take listed, nested: nested, active: list.new(), collection: 0, start: clone(start), stop: take stop, inclusive: inclusive, reverse: reverse))
}

fn next_page_range(mut rows: PageRange) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    if !rows.nested {
        if let Some(take item) = std.page.cursor_next(mut rows.listed) {
            let std.page.CursorRow(key: take key, value: take value, ..) = take item
            return Ok(Some((take key, take value)))
        }
        return Ok(None)
    }
    loop {
        if list.len(rows.active) != 0 {
            if let Some(take item) = std.page.cursor_next(mut rows.active[0u64]) {
                let std.page.CursorRow(key: take key, value: take value, ..) = take item
                return Ok(Some((logical_key(rows.collection, key)?, take value)))
            }
            let _ = list.pop(mut rows.active)
        }
        if !next_page_collection(mut rows)? {
            return Ok(None)
        }
    }
}

fn next_page_collection(mut rows: PageRange) -> Result[bool, Error] {
    let Some(take found) = std.page.cursor_next(mut rows.listed) else {
        return Ok(false)
    }
    let std.page.CursorRow(key: take key, collection: take subtree, ..) = take found
    let Some(take root) = take subtree else {
        return Error(malformed(0))
    }
    rows.collection = list.word_be(key, 0)
    let start: Option[Bytes] = match rows.start {
        Some(boundary) => if list.len(boundary) >= 4 && list.slice(boundary, 0, 4) == key {
            Some(copied(list.slice(boundary, 4, list.len(boundary)))?)
        } else {
            None
        },
        None => None,
    }
    let stop: Option[Bytes] = match rows.stop {
        Some(boundary) => if list.len(boundary) > 4 && list.slice(boundary, 0, 4) == key {
            Some(copied(list.slice(boundary, 4, list.len(boundary)))?)
        } else {
            None
        },
        None => None,
    }
    list.push(mut rows.active, std.page.cursor_open_bounded(root, start, rows.inclusive, rows.reverse, take stop))
    Ok(true)
}

// Locate the next leaf pair in range, skipping matching subtrees before descent.
fn diff_position(mut left: std.page.Walk, mut right: std.page.Walk, high: Option[Bytes]) -> Option[(Bytes, Order)] {
    loop {
        let old_key = std.page.walk_key(left)
        let new_key = std.page.walk_key(right)
        let comparison = match (view old_key, view new_key) {
            (None, None) => return None,
            (None, Some(_)) => Greater,
            (Some(_), None) => Less,
            (Some(a), Some(b)) => list.compare_bytes(a, b),
        }
        let key = if comparison == Greater {
            option.unwrap(take new_key)
        } else {
            option.unwrap(take old_key)
        }
        if let Some(end) = high {
            if key >= end {
                return None
            }
        }
        let old_span = std.page.walk_subtree(left)
        let new_span = std.page.walk_subtree(right)
        if comparison == Equal {
            if let (Some(a), Some(b)) = (old_span, new_span) {
                if a.stamp == b.stamp {
                    std.page.walk_next(mut left)
                    std.page.walk_next(mut right)
                } else if a.level >= b.level {
                    std.page.walk_expand(mut left)
                } else {
                    std.page.walk_expand(mut right)
                }
                continue
            }
        }
        if comparison != Greater {
            if let Some(_) = old_span {
                std.page.walk_expand(mut left)
                continue
            }
        }
        if comparison != Less {
            if let Some(_) = new_span {
                std.page.walk_expand(mut right)
                continue
            }
        }
        return Some((take key, comparison))
    }
}

fn diff_advance(mut left: std.page.Walk, mut right: std.page.Walk, comparison: Order) {
    if comparison != Greater {
        std.page.walk_next(mut left)
    }
    if comparison != Less {
        std.page.walk_next(mut right)
    }
}

type ChangeOutput {
    rows: List[Change],
    remaining: u64,
    limits: Option[Limits],
    next: Option[Bytes]
}

fn page_change_rows(mut out: ChangeOutput, id: u32, mut left: std.page.Walk, mut right: std.page.Walk, high: Option[Bytes]) -> Result[bool, Error] {
    while let Some((take key, comparison)) = diff_position(mut left, mut right, high) {
        if comparison != Equal || compare_row_versions(left, right) != Equal {
            let logical = logical_key(id, key)?
            if let Some(limits) = out.limits {
                let value_width = if comparison == Less {
                    0u64
                } else {
                    let raw = option.unwrap(std.page.walk_value(right))
                    list.len(raw)
                }
                let width = int.saturating_add(list.len(logical), value_width)
                let included = list.len(out.rows)
                if included == limits.rows || (included != 0 && width > out.remaining) {
                    out.next = Some(take logical)
                    return Ok(false)
                }
                out.remaining = int.saturating_sub(out.remaining, width)
            }
            let replacement: Option[Arc[Bytes]] = if comparison == Less {
                None
            } else {
                std.page.walk_owned_value(right)
            }
            list.push(mut out.rows, Change(tree_key: take logical, value: take replacement))
        }
        diff_advance(mut left, mut right, comparison)
    }
    Ok(true)
}

fn page_change_cell(mut out: ChangeOutput, key: Bytes, left: std.page.Walk, right: std.page.Walk, comparison: Order, low: Option[Bytes]) -> Result[bool, Error] {
    if let Some(lower) = low {
        if key < lower { return Ok(true) }
    }
    let before: Option[Arc[Bytes]] = if comparison == Greater { None } else { cell_walk_value(left) }
    let after: Option[Arc[Bytes]] = if comparison == Less { None } else { cell_walk_value(right) }
    if before == after {
        return Ok(true)
    }
    if let Some(limits) = out.limits {
        let width = match after { Some(raw) => list.len(raw), None => 0u64 }
        let filled = list.len(out.rows)
        if filled == limits.rows || (filled != 0 && 4 + width > out.remaining) {
            out.next = Some(copied(key)?)
            return Ok(false)
        }
        out.remaining = int.saturating_sub(out.remaining, 4 + width)
    }
    list.push(mut out.rows, Change(tree_key: copied(key)?, value: take after))
    Ok(true)
}

fn start_diff(root: Option[View[Arc[std.page.Page]]], low: Option[Bytes]) -> std.page.Walk {
    let Some(page) = root else {
        return std.page.walk_empty()
    }
    match low {
        None => std.page.walk_begin(page),
        Some(key) => std.page.walk_from(page, key),
    }
}

fn diff_bound(boundary: Option[Bytes], collection: Bytes) -> Option[Bytes] {
    if let Some(key) = boundary {
        if list.len(key) > 4 && list.slice(key, 0, 4) == collection {
            return Some(clone(list.slice(key, 4, list.len(key))))
        }
    }
    None
}

fn walk_page_changes(mut out: ChangeOutput, before: Option[View[PageTree]], after: PageTree, low: Option[Bytes], high: Option[Bytes]) -> Result[(), Error] {
    let low_id: Option[Bytes] = match low {
        None => None,
        Some(key) => Some(clone(list.slice(key, 0, order.min(4, list.len(key))))),
    }
    let mut left = match before {
        None => std.page.walk_empty(),
        Some(tree) => start_diff(Some(view tree.root), low_id)
    }
    let mut right = start_diff(Some(view after.root), low_id)
    while let Some((take key, comparison)) = diff_position(mut left, mut right, high) {
        let is_cell = {
            let descriptor = if comparison == Less { std.page.walk_value(left) } else { std.page.walk_value(right) }
            option.unwrap(descriptor)[52] == 3
        }
        if is_cell {
            if !page_change_cell(mut out, key, left, right, comparison, low)? { break }
            diff_advance(mut left, mut right, comparison)
            continue
        }
        if comparison != Equal || compare_row_versions(left, right) != Equal {
            let start = diff_bound(low, key)
            let stop = diff_bound(high, key)
            let mut from = if comparison == Greater {
                std.page.walk_empty()
            } else {
                let root = std.page.walk_collection(left)
                start_diff(Some(view root), start)
            }
            let mut until = if comparison == Less {
                std.page.walk_empty()
            } else {
                let root = std.page.walk_collection(right)
                start_diff(Some(view root), start)
            }
            let id: u32 = list.word_be(key, 0)
            if !page_change_rows(mut out, id, mut from, mut until, stop)? {
                break
            }
        }
        diff_advance(mut left, mut right, comparison)
    }
    Ok(())
}

fn compare_page_collections(before: PageTree, after: PageTree) -> Result[List[Change], Error] {
    let mut out = ChangeOutput(rows: list.new(), remaining: 0, limits: None, next: None)
    walk_page_changes(mut out, Some(view before), after, None, None)?
    let ChangeOutput(rows: take rows, ..) = take out
    Ok(take rows)
}

pub type Trimmed {
    lo: Bytes,
    hi: Bytes
}

pub type ChangePage {
    changes: List[Change],
    trimmed: List[Trimmed],
    next: Option[Bytes]
}

pub fn changes_page(r: Reader, a: Option[Snapshot], b: Snapshot, lo: Bytes, hi: Bytes, l: Limits) -> Result[ChangePage, Error] waits {
    read_access(r, b)?
    if let Some(before) = a { read_access(r, before)? }
    page_limits(l)?
    if let Some(base) = a {
        if !same(base.store, b.store) || base.open != b.open {
            return Error(Foreign)
        }
    }
    let mut out = ChangeOutput(rows: list.new(), remaining: l.byte_limit, limits: Some(l), next: None)
    if lo < hi {
        let low: Option[Bytes] = Some(clone(lo))
        let high: Option[Bytes] = Some(clone(hi))
        match a {
            None => walk_page_changes(mut out, None, b.roots.collections, low, high)?,
            Some(base) => walk_page_changes(mut out, Some(view base.roots.collections), b.roots.collections, low, high)?,
        }
    }
    let ChangeOutput(rows: take rows, next: take resume, ..) = take out
    Ok(ChangePage(changes: take rows, trimmed: list.new(), next: take resume))
}

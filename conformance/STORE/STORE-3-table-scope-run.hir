// rule: STORE-3
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"}}
// steps: 8000000
// three tables of ten rows and a dozen narrowed table operations, each decoding the catalog
// table.scope_keys holds exactly the rows between its bounds and the table's
// catalog entry as Read, and no other table's: a Tx narrowed to it reads and
// writes those rows, cannot create or replace its table, and cannot tell
// whether a table outside its scope exists. table.scope holds a whole table,
// one the body creates included.
fn rows() -> table.Table[u64, u64] uses {} {
  table.named("a")
}

fn neighbour() -> table.Table[u64, u64] uses {} {
  table.named("ab")
}

fn absent() -> table.Table[u64, u64] uses {} {
  table.named("a\x01")
}

fn fill(mut tx: store.Tx, t: table.Table[u64, u64]) -> Result[(), store.TxError] {
  table.create(mut tx, t)?
  for k in 0u64..10u64 {
    table.put(mut tx, t, k, k * 10)?
  }
  Ok(())
}

fn ranged(mut sub: store.Tx) -> bool {
  let a = rows()
  // The rows in [3, 7) read and write; the ones beside them do not.
  let inside = table.get(sub, a, 3) == Ok(Some(30)) && table.get(sub, a, 6) == Ok(
    Some(60)
  )
  let outside = table.get(sub, a, 2) == Error(OutOfScope()) && table.get(sub, a, 7) == Error(
    OutOfScope()
  )
  let wrote = table.put(mut sub, a, 5, 1) == Ok(()) && table.put(mut sub, a, 7, 1) == Error(
    OutOfScope()
  )
  let scanned = table.range(sub, a, Included(3), Excluded(7), 8, Ascending())
  let all_rows = table.range(sub, a, Unbounded(), Unbounded(), 8, Ascending())
  let ranges = scanned == Ok([(3, 30), (4, 40), (5, 1), (6, 60)]) && all_rows == Error(
    OutOfScope()
  )
  // The catalog entry is Read: the table cannot be created over or renamed.
  let catalog = table.create(mut sub, a) == Error(ReadOnly()) && table.rename(
    mut sub,
    "a",
    "x",
    "y"
  ) == Error(ReadOnly())
  // An existing table and a missing one outside the scope look the same.
  let leak = table.get(sub, neighbour(), 1) == Error(OutOfScope()) && table.get(
    sub,
    absent(),
    1
  ) == Error(OutOfScope()) && table.create(mut sub, absent()) == Error(OutOfScope())
  inside && outside && wrote && ranges && catalog && leak
}

fn created_whole(mut sub: store.Tx) -> bool {
  let created = fill(mut sub, absent()) == Ok(())
  let read = table.get(sub, absent(), 4) == Ok(Some(40))
  let other = table.get(sub, rows(), 4) == Error(OutOfScope())
  created && read && other
}

fn fill_rows(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), store.TxError] {
  fill(mut tx, rows())?
  fill(mut tx, neighbour())
}

fn check_rows(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[
  bool,
  store.TxError
] {
  let keys = table.scope_keys(mut tx, rows(), Included(3), Excluded(7), ReadWrite())?
  let narrowed = store.narrow(
    mut tx,
    keys,
    fn(mut sub: store.Tx) -> bool {
      ranged(mut sub)
    }
  )?
  // A key range is within its whole table, and not the reverse.
  let nested = store.narrow(
    mut tx,
    table.scope(rows(), ReadWrite()),
    fn(mut sub: store.Tx) -> bool {
      let inner = store.narrow(
        mut sub,
        keys,
        fn(mut x: store.Tx) -> bool {
          true
        }
      )
      let outer = store.narrow(
        mut sub,
        keys,
        fn(mut x: store.Tx) -> bool {
          store.narrow(
            mut x,
            table.scope(rows(), Read()),
            fn(mut y: store.Tx) -> bool {
              true
            }
          ) == Error(OutOfScope())
        }
      )
      inner == Ok(true) && outer == Ok(true)
    }
  )?
  let created = store.narrow(
    mut tx,
    table.scope(absent(), ReadWrite()),
    fn(mut sub: store.Tx) -> bool {
      created_whole(mut sub)
    }
  )?
  Ok(narrowed && nested && created)
}

pub type Failed = Check | Store(store.StoreError)

fn check(ok: bool) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check())
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  let setup: Result[(), store.TxFailure[store.TxError]] = store.transact(
    mut s,
    fill_rows,
    ()
  )
  check(setup == Ok(()))?
  let checked: Result[bool, store.TxFailure[store.TxError]] = store.transact(
    mut s,
    check_rows,
    ()
  )
  check(checked == Ok(true))?
  Ok(())
}

// Authorized reads for the HTTP front.

fn allowed(d: harness.gateway.Door, f: Front, id: u64, identity: Identity) -> Result[(), u16] waits {
    if let Some(take client) = reach(d, f, id, identity, 0u64, false)? {
        store.client.close(take client)
    }
    Ok(())
}

fn checked_status(mut client: store.client.Client, f: Front) -> Result[String, u16] waits {
    let head = read_cover(mut client, f, window_entry(), Status)?
    match visible_status(head) {
        Some(take status) => Ok(take status),
        None => Error(403u16),
    }
}

fn read_cover[A: codec](mut client: store.client.Client, f: Front, entry: store.client.Callee[A, ()], take arg: A) -> Result[store.client.Seen, u16] waits {
    let Ok(sub) = store.client.subscribe(mut client, entry, take arg, f.within_ms) else { return Error(503u16) }
    let seen = store.client.seen_at(mut client, sub, 0u64, f.within_ms)
    store.client.unsubscribe(mut client, sub)
    Ok(seen ?=> |_| 503u16)
}

fn history_page(mut client: store.client.Client, f: Front, before: u64, lines: u64) -> Result[Page, u16] waits {
    let mut from = harness.page_from(before, lines)
    let cuts = store.client.query_as_entry(code.describe(harness.history_cuts), std.codec.key_u64(), std.codec.of_u64())
    let cut_image = read_cover(mut client, f, cuts, (from, before))?
    for r in cut_image.rows {
        if let Some(raw) = view r.value {
            if let Ok(cut) = std.codec.decode(std.codec.of_u64(), raw) {
                if cut > from { from = cut }
            }
        }
    }
    let image = read_cover(mut client, f, window_entry(), Page(before, before - from))?
    let _ = checked_status(mut client, f)?
    let codec: std.codec.Codec[harness.View] = std.codec.of()
    let mut rows: List[Shown] = list.new()
    for r in image.rows {
        let Some(raw) = view r.value else {
            continue
        }
        let Some(at) = position(r) else {
            continue
        }
        let Ok(take v) = std.codec.decode(codec, raw) else {
            continue
        }
        list.push(mut rows, Shown(at: at, line: take v))
    }
    Ok(Page(from: from, rows: take rows))
}

fn waits_page(mut client: store.client.Client, f: Front) -> Result[List[harness.PendingWait], u16] waits {
    let codec: std.codec.Codec[harness.Wait] = std.codec.of()
    let entry = store.client.query_as_entry(code.describe(harness.pending_waits), harness.wait_key(), codec)
    let image = read_cover(mut client, f, entry, ())?
    let _ = checked_status(mut client, f)?
    let mut waits: List[harness.PendingWait] = list.new()
    for row in image.rows {
        let Some(raw) = view row.value else { continue }
        let Ok(take wait) = std.codec.decode(codec, raw) else { return Error(503u16) }
        // The store's table prefix precedes the fixed 25-byte WaitKey.
        let width = list.len(row.key)
        if width < 25u64 { return Error(503u16) }
        let mut at = width - 25u64
        let Ok(key) = harness.take_wait_key(row.key, mut at) else { return Error(503u16) }
        if let Some(take open) = harness.open_wait(key, take wait) {
            list.push(mut waits, take open)
        }
    }
    Ok(take waits)
}

fn visible_sessions(d: harness.gateway.Door, f: Front, identity: Identity) -> Result[List[u64], u16] waits {
    let mut visible: List[u64] = list.new()
    for id in harness.gateway.listing(d) {
        match allowed(d, f, id, identity) {
            Ok(()) => list.push(mut visible, id),
            Error(code) => if code != 403u16 && code != 404u16 { return Error(code) },
        }
    }
    Ok(take visible)
}

fn releases_page(mut client: store.client.Client, f: Front) -> Result[List[release.FiledProposal], u16] waits {
    let codec: std.codec.Codec[release.Proposal] = std.codec.of()
    let entry = store.client.query_as_entry(code.describe(release.dev_proposals), std.codec.key_bytes(), codec)
    let image = read_cover(mut client, f, entry, ())?
    let _ = checked_status(mut client, f)?
    let mut filed: List[release.FiledProposal] = list.new()
    for row in image.rows {
        let Some(raw) = view row.value else { continue }
        let p = std.codec.decode(codec, raw) ?=> |_| 503u16
        if let Filed = p.state {
            let mut at = 4u64 // WIRE keys start with the table prefix
            let id = std.codec.take_key_bytes(row.key, mut at) ?=> |_| 503u16
            list.push(mut filed, release.FiledProposal(id: take id, proposal: take p))
        }
    }
    Ok(take filed)
}

fn release_route(d: harness.gateway.Door, f: Front, id: u64, identity: Identity, method: Bytes, req: Request, mut write: WriteHalf) -> () waits {
    let Some(entry) = view f.settle else { return reply(mut write, f, 404u16, list.new()) }
    if method == b"GET" {
        let mut client = match reach(d, f, id, identity, 0u64, true) {
            Ok(take opened) => option.unwrap(take opened),
            Error(code) => return reply(mut write, f, code, list.new()),
        }
        let proposals = releases_page(mut client, f)
        store.client.close(take client)
        return match take proposals {
            Ok(take filed) => json_reply(mut write, f, 200u16, filed),
            Error(code) => reply(mut write, f, code, list.new()),
        }
    }
    if method == b"POST" {
        let p = match request_position(req) {
            Ok(n) => n,
            Error(code) => return reply(mut write, f, code, list.new()),
        }
        let Some(take ask) = (json_body(req, f) : Option[release.DevSettlement]) else {
            return reply(mut write, f, 400u16, list.new())
        }
        return match call_place(d, f, id, identity, p, entry, take ask) {
            Ok(ruling) => {
                harness.gateway.nudge(d, id);
                json_reply(mut write, f, 200u16, ruling)
            },
            Error(code) => reply(mut write, f, code, list.new()),
        }
    }
    reply(mut write, f, 405u16, list.new())
}


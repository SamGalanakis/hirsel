// Contract tests for `set` (core/std/set.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names.
fn added(r: Result[bool, (Capacity, u64)]) -> u64 {
    match r {
        Ok(true) => 1,
        Ok(false) => 0,
        Error(_) => 9,
    }
}

// The first insert adds 5 (1), the second finds it (0); then len 1.
// expect: run insert_twice() = 101
fn insert_twice() -> u64 {
    let mut s: set.Set[u64] = set.new()
    let first = added(set.insert(mut s, 5))
    let second = added(set.insert(mut s, 5))
    first * 100 + second * 10 + set.len(s)
}

// expect: run contains_after_insert() = true
fn contains_after_insert() -> bool {
    let mut s: set.Set[u64] = set.new()
    let _ = added(set.insert(mut s, 5))
    set.contains(s, 5) && !set.contains(s, 6)
}

// The first remove finds 5, the second does not; then len 0.
// expect: run remove_twice() = true
fn remove_twice() -> bool {
    let mut s: set.Set[u64] = set.new()
    let _ = added(set.insert(mut s, 5))
    set.remove(mut s, 5) && !set.remove(mut s, 5) && set.len(s) == 0
}

// expect: run new_is_empty() = 0
fn new_is_empty() -> u64 {
    let s: set.Set[u64] = set.new()
    set.len(s)
}

// [5,2,9] minus 2, then reinsert 2 -> [5,9,2]. A sorted or slot-reuse view fails.
// expect: run insertion_order() = 592
fn insertion_order() -> u64 {
    let mut s: set.Set[u64] = set.new()
    let _ = added(set.insert(mut s, 5))
    let _ = added(set.insert(mut s, 2))
    let _ = added(set.insert(mut s, 9))
    let _ = set.remove(mut s, 2)
    let _ = added(set.insert(mut s, 2))
    let mut n: u64 = 0
    for (k, _) in set.entries(s) { n = n * 10 + k }
    n
}

// expect: run empty_iteration() = 0
fn empty_iteration() -> u64 {
    let s: set.Set[u64] = set.new()
    let mut n: u64 = 0
    for (_, _) in set.entries(s) { n += 1 }
    n
}

// expect: run capacity_returns_key() = 3
fn capacity_returns_key() -> u64 {
    let mut s: set.Set[String] = set.new()
    let k = result.unwrap(string.from("abc"))
    let r = bound bytes 0 { set.insert(mut s, take k) }
    match r { Ok(Error((_, take original))) => list.len(string.as_bytes(original)) + set.len(s), _ => 99 }
}

pub type SimLevels: send {
    weak: List[String],
    strongest: String
}

pub opaque type LevelWorld {
    commands: Sender[object_writer.LevelCommand],
    worker: Task[List[LevelEvent]]
}

pub opaque type LevelSync: send {
    commands: Sender[object_writer.LevelCommand]
}

pub type LevelUntil: send = Never | At(u64) | AfterSynced(String, u64)

pub type LevelHold: send {
    level: String,
    until: LevelUntil
}

pub type LevelKind: send = Requested(u64) | Synced(u64) | Mark(u64)

pub type LevelEvent: send {
    level: String,
    epoch: u64,
    kind: LevelKind,
    at_ns: u64
}

type LevelStart: send {
    clock: Clock,
    tasks: Tasks,
    holds: List[LevelHold],
    commands: Receiver[object_writer.LevelCommand],
    outlet: Sender[object_writer.LevelCommand],
    ready: Sender[()]
}

pub fn level_world(tasks: Tasks, clock: Clock, take holds: List[LevelHold], world_bytes: u64) -> Result[LevelWorld, Error] waits {
    let (outlet, inbound): (Sender[object_writer.LevelCommand], Receiver[object_writer.LevelCommand]) = disk_allocation(fn() -> Result[(Sender[object_writer.LevelCommand], Receiver[object_writer.LevelCommand]), Error] {
        Ok(channel.new(1))
    })?
    let (ready, started): (Sender[()], Receiver[()]) = failure_result_from_rep(types.capacity(bound bytes 64 {
        channel.new(1)
    }))?
    let start = LevelStart(clock, tasks, holds: take holds, commands: take inbound, outlet: channel.sender(outlet), ready: take ready)
    let worker = task.try_spawn(tasks, bytes world_bytes, take start, level_world_loop) ?=> |(room, _)| Full(Allocation(room))
    channel.receive(started) ?=> |_| Io(Closed)
    Ok(LevelWorld(commands: take outlet, worker: take worker))
}

pub fn level_sync(mut w: LevelWorld) -> Result[LevelSync, Error] {
    Ok(LevelSync(commands: channel.sender(w.commands)))
}

pub fn level_mark(mut s: LevelSync, label: u64) -> Result[(), Error] waits {
    let (response, await_mark): (Sender[()], Receiver[()]) = failure_result_from_rep(types.capacity(bound bytes 64 {
        channel.new(1)
    }))?
    channel.send(s.commands, MarkLevel(label, take response)) ?=> |_| Io(Closed)
    channel.receive(await_mark) ?=> |_| Io(Closed)
    Ok(())
}

pub fn level_log(take w: LevelWorld) -> Result[List[LevelEvent], Error] waits {
    let LevelWorld(commands: take commands, worker: take worker) = take w
    let _ = channel.send(commands, EndLevels)
    Ok(task.join(take worker) ?=> |_| Io(Closed))
}

fn level_event(mut events: List[LevelEvent], name: String, epoch: u64, kind: LevelKind, clock: Clock) {
    list.push(mut events, LevelEvent(level: string.from(name), epoch, kind, at_ns: host.mono_ns(clock)))
}

fn level_released(name: String, holds: List[LevelHold], events: List[LevelEvent], clock: Clock) -> bool {
    for hold in holds {
        if hold.level != name {
            continue
        }
        match hold.until {
            Never => return false,
            At(at) => if host.mono_ns(clock) < at {
                return false
            },
            AfterSynced(other, target) => {
                let mut reached = false
                for event in events {
                    if let Synced(at) = event.kind {
                        if event.level == other && at >= target {
                            reached = true;
                            break
                        }
                    }
                }
                if !reached {
                    return false
                }
            },
        }
    }
    true
}

fn level_sample(mut opens: List[object_writer.LevelOpen], holds: List[LevelHold], mut events: List[LevelEvent], clock: Clock) {
    let mut i = 0u64
    while i < list.len(opens) {
        if let Error(Closed) = channel.try_receive(opens[i].lifetime) {
            let _ = list.swap_remove(mut opens, i)
        } else {
            i += 1
        }
    }
    // A barrier may release a held level on an earlier open in this pass.
    let mut changed = true
    while changed {
        changed = false
        let n = list.len(opens)
        for slot_index in 0u64 .. n {
            if level_sample_open(mut opens[slot_index], holds, mut events, clock) {
                changed = true
            }
        }
    }
}

fn level_sample_open(mut active: object_writer.LevelOpen, holds: List[LevelHold], mut events: List[LevelEvent], clock: Clock) -> bool {
    let progress = latest.read(active.progress)
    if progress.position > active.requested {
        active.requested = progress.position
        for name in active.names {
            level_event(mut events, name, progress.epoch, Requested(progress.position), clock)
        }
    }
    let mut changed = false
    for slot_index in 0u64 .. list.len(active.names) {
        let name = view active.names[slot_index]
        if progress.position > active.synced[slot_index] && level_released(name, holds, events, clock) {
            active.synced[slot_index] = progress.position
            level_event(mut events, name, progress.epoch, Synced(progress.position), clock)
            let old = latest.read(active.frontiers)
            let mut seqs = old.seqs
            seqs[slot_index] = progress.seq
            latest.publish(active.frontiers, arc.new(object_writer.WeakFrontiers(seqs)))
            for weaker in 0u64 .. slot_index + 1 {
                let _ = channel.try_send(active.notices[weaker], WeakSynced(slot_index, progress.seq))
            }
            changed = true
        }
    }
    changed
}

fn level_world_loop(take input: LevelStart) -> List[LevelEvent] waits {
    let mut timers: List[Task[()]] = list.new()
    for hold in input.holds {
        if let At(at) = hold.until {
            if at > host.mono_ns(input.clock) {
                let timer = object_writer.LevelTimer(at, clock: input.clock, outlet: channel.sender(input.outlet))
                list.push(mut timers, task.spawn(input.tasks, bytes 0, take timer, object_writer.wake_level_at))
            }
        }
    }
    let _ = channel.try_send(input.ready, ())
    let mut opens: List[object_writer.LevelOpen] = list.new()
    let mut events: List[LevelEvent] = list.new()
    while let Ok(take command) = channel.receive(input.commands) {
        level_sample(mut opens, input.holds, mut events, input.clock)
        match take command {
            WakeLevels => (),
            RegisterLevels(take opening) => {
                list.push(mut opens, take opening)
                level_sample(mut opens, input.holds, mut events, input.clock)
            },
            MarkLevel(label, take response) => {
                level_event(mut events, "", 0, Mark(label), input.clock)
                let _ = channel.try_send(response, ())
            },
            EndLevels => break,
        }
    }
    let _ = take timers
    take events
}

// rule: SER-2
// expect: run
// A count is satisfiable only if count times its element's fewest wire bytes fits in the
// bytes left. Otherwise the input is Truncated, decided when the count is read: before
// any element is visited, allocated or budgeted, so no oversized count ends the run, and
// an element's own malformation behind an unsatisfiable count is not reached. The same
// holds inside an envelope. Fewest bytes: u8 1, u16 2, bool 1, a record the sum of its
// fields, a List 8 (its count), a variant 4 plus its smallest arm.
@serializable
type Pair {
  a: u16,
  b: bool,
}

@serializable
type Chain = End | Link(u8, box Chain)

fn truncated[T: serializable](t: Test, none: Option[T], payload: Bytes) {
  let decoded: Result[T, DecodeError] = codec.decode_payload(none, payload)
  match take decoded {
    Error(Truncated()) => test.check(t, true),
    _ => test.check(t, false),
  }
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  let bytes_none: Option[List[u8]] = None()
  // 2^40 elements of one byte, ten bytes left.
  truncated(
    t,
    bytes_none,
    b"\x00\x00\x00\x00\x00\x01\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a"
  )
  // The largest count, nothing left.
  truncated(t, bytes_none, b"\xff\xff\xff\xff\xff\xff\xff\xff")
  let set_none: Option[Set[u16]] = None()
  truncated(t, set_none, b"\x00\x00\x00\x00\x00\x01\x00\x00\x01\x00\x02\x00")
  // Three entries of at least two bytes, five left; the second value is not a bool.
  let map_none: Option[Map[u8, bool]] = None()
  truncated(t, map_none, b"\x03\x00\x00\x00\x00\x00\x00\x00\x01\x02\x02\x01\x03")
  // Two Pairs of at least three bytes, five left; the first Pair's bool is 7.
  let pairs_none: Option[List[Pair]] = None()
  truncated(t, pairs_none, b"\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\x01\x00")
  // Exactly enough bytes decodes.
  let pairs: Result[List[Pair], DecodeError] = codec.decode_payload(
    pairs_none,
    b"\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01\x02\x00\x00"
  )
  match take pairs {
    Ok(p) => test.check(
      t,
      codec.encode_payload(p) == b"\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01\x02\x00\x00"
    ),
    Error(_) => test.check(t, false),
  }
  // Two lists of at least eight bytes, fifteen left.
  let nested_none: Option[List[List[u8]]] = None()
  truncated(
    t,
    nested_none,
    b"\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  )
  // A recursive variant's fewest bytes are its End tag: three Chains need twelve, eleven left.
  let chain_none: Option[List[Chain]] = None()
  truncated(
    t,
    chain_none,
    b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  )
  // Inside an envelope: the envelope of an empty List[u8] with its payload replaced.
  let empty: List[u8] = []
  let e = codec.encode(empty)
  let n = bytes.len(e)
  let mut out: List[u8] = []
  bytes.append(mut out, bytes.slice(e, 0, n - 16))
  bytes.append(mut out, b"\x12\x00\x00\x00\x00\x00\x00\x00")
  bytes.append(
    mut out,
    b"\x00\x00\x00\x00\x00\x01\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a"
  )
  let enveloped: Result[List[u8], DecodeError] = codec.decode(bytes.from_list(take out))
  match enveloped {
    Error(Truncated()) => test.check(t, true),
    _ => test.check(t, false),
  }
  Ok(())
}

// A fixed listing buffer keeps RAM independent of the directory's capacity.
fn pack_cache_scan(d: Dir, requested: u64, evict: bool) -> Result[u64, types.Failure] waits {
    let mut listing = manifest.disk_io(host.entries(d, None))?
    let mut buf = manifest.disk_read_buffer(1024)?
    let mut remaining = requested
    let mut total = 0u64
    loop {
        list.clear(mut buf)
        if manifest.disk_io(host.next_entries(mut listing, mut buf))? == 0 {
            return Ok(if evict {
                remaining
            } else {
                total
            })
        }
        let mut offset = 0u64
        while offset < list.len(buf) {
            let kind = buf[offset]
            let size: u16 = list.word_le(buf, offset + 1)
            let from = offset + 3
            offset = from + int.widen(size)
            if kind == 1u8 || kind == 2u8 || size < 60u16 || size > 104u16 || buf[from] != b'p' || (size > 60u16 && buf[from + 60] != b'-') {
                continue
            }
            let path = types.capacity(bound bytes 104 {
                string.from_utf8(clone(list.slice(buf, from, offset)))
            })?
            let Ok(take name) = take path else {
                continue
            }
            if let None = history_parse_name(string.slice(name, 0, 60)) {
                continue
            }
            let status = manifest.disk_io(host.stat(d, name))?
            let File = status.kind else {
                continue
            }
            if evict {
                manifest.disk_io(host.remove(d, name))?
                remaining = remaining - order.min(remaining, status.size)
                if remaining == 0 {
                    return Ok(0)
                }
            } else {
                total = int.saturating_add(total, status.size)
            }
        }
    }
}

fn pack_cache_room(cache: pager.ObjectsCache, incoming: u64) -> Result[(), types.Failure] waits {
    // A cancelled or crashed writer can leave only this one staging file.
    match host.remove(cache.dir, history.PACK_CACHE_INCOMING) {
        Ok(()) => (),
        Error(NotFound) => (),
        Error(problem) => return Error(Io(problem)),
    }
    let available = cache.capacity_bytes - incoming
    let used = pack_cache_scan(cache.dir, 0, false)?
    if used > available {
        if pack_cache_scan(cache.dir, used - available, true)? != 0 {
            return Error(Io(NotFound))
        }
    }
    Ok(())
}

fn pack_cache_trim(cache: pager.ObjectsCache) waits {
    if let Some(take locked) = history.pack_cache_lock(cache.dir) {
        let _ = pack_cache_room(cache, 0)
        drop(take locked)
    }
}

fn pack_cache_write(cache: pager.ObjectsCache, path: String, raw: Bytes, with_trailer: bool) waits {
    let trailer = if with_trailer {
        8u64
    } else {
        0u64
    }
    let Some(width) = int.checked_add(list.len(raw), trailer) else {
        return
    }
    let Some((take locked, take staging)) = pack_cache_stage(cache, path, width) else {
        return
    }
    let mut file = take staging
    if history.pack_cache_write_payload(mut file, raw, with_trailer) {
        history.pack_cache_publish(cache.dir, path, take file)
    }
    let _ = host.remove(cache.dir, history.PACK_CACHE_INCOMING)
    drop(take locked)
}

fn pack_cache_stage(cache: pager.ObjectsCache, path: String, width: u64) -> Option[(std.file.Lock, HostFile)] waits {
    if width > cache.capacity_bytes {
        return None
    }
    let Some(take locked) = history.pack_cache_lock(cache.dir) else {
        return None
    }
    if let Ok(status) = host.stat(cache.dir, path) {
        if let File = status.kind {
            // A cooperating opener may have filled it since the miss.
            if let Error(_) = host.remove(cache.dir, path) {
                return None
            }
        }
    }
    if let Error(_) = pack_cache_room(cache, width) {
        return None
    }
    let Ok(take file) = host.open(cache.dir, history.PACK_CACHE_INCOMING, CreateNew) else {
        return None
    }
    Some((take locked, take file))
}

fn history_read_pack(mut client: std.object.Client, path: String, reference: pages.HistoryRef, cache: pager.ObjectsCache, mut raw: Bytes, deadline: u64) -> Result[(), types.Failure] waits {
    if history.pack_cache_read(cache, path, reference.len, Some(reference.digest), mut raw) {
        return Ok(())
    }
    list.clear(mut raw)
    match history.history_fetch(mut client, path, mut raw, deadline) {
        Ok(_) => (),
        Error(Remote(NotFound)) => return Error(pager.history_missing_object(path, reference)),
        Error(take problem) => return Error(take problem),
    }
    history.history_object_digest(path, reference, raw)?
    pack_cache_write(cache, path, raw, false)
    Ok(())
}

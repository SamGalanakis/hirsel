// ---- RTC-3 ingress authentication law ----
// A browser RTP packet with MID on extension 1 first, then its transport-wide
// number on extension 3, as session_offer's section a binds them.
fn media_numbered(mut cs: srtp.Session, ssrc: u32, seq: u16, mid: Bytes, pt: u8, number: u16) -> Bytes {
    let mut m = rtp.ext.map(OneOnly)
    result.unwrap(rtp.ext.bind(mut m, 1, Mid))
    result.unwrap(rtp.ext.bind(mut m, 3, TransportSeq))
    let mut w = rtp.ext.writer()
    result.unwrap(rtp.ext.put(mut w, m, Mid, mid, 0, list.len(mid)))
    let mut word: Bytes = list.new()
    list.put_word_be(mut word, number)
    result.unwrap(rtp.ext.put(mut w, m, TransportSeq, word, 0, 2))
    let wide: u32 = int.widen(seq)
    let f = rtp.header.Fields(marker: true, pt: pt, seq: seq, ts: 3000 * wide, ssrc: ssrc)
    let mut b: Bytes = list.with_capacity(1500)
    let _ = result.unwrap(rtp.header.write(f, view w, mut b))
    list.append(mut b, b"\x10\x00\x9d\x01\x2a\x00\x00\x00")
    let _ = result.unwrap(srtp.protect_rtp(mut cs, mut b))
    b
}

// The base number and status count of the first transport-cc feedback the browser
// opens from `out` (draft-holmer-rmcat-transport-wide-cc-extensions-01 section 3.1:
// the FCI starts with both after the two SSRCs).
fn feedback_span(mut cs: srtp.Session, out: peer.Outbox) -> Option[(u16, u16)] {
    for tx in out.pkts {
        let UdpTx(to: _, at, len, ecn: _) = tx
        let mut b = copy_of(list.slice(out.data, at, at + len))
        if b[1] < 192 || b[1] > 223 {
            continue
        }
        let Ok(n) = srtp.unprotect_rtcp(mut cs, mut b) else {
            continue
        }
        list.truncate(mut b, n)
        let mut walk = 0u64
        while let Ok(Some(pk)) = rtp.rtcp.next(b, mut walk) {
            if let Twcc(_, _) = pk.item {
                let base: u16 = list.word_be(b, pk.body + 8)
                let count: u16 = list.word_be(b, pk.body + 10)
                return Some((base, count))
            }
        }
    }
    None
}

/// bug: let an unauthenticated datagram move statistics, the loss window, the egress history, TWCC, BWE, bindings, the path or the ROC before SRTP or ICE has authenticated it; or keep the old path after an authenticated rebinding nomination.
/// oracle: RTC-3 by hand: a twin session fed the same valid traffic, compared on everything it sends and reports, and its TWCC feedback covering exactly the six accepted transport numbers 0 to 5 (base 0, count 6); the ROC by the next packet's hand-derived index 65538; after the rebinding, index 65539 on the new source, the old source off-path and every send to the new one.
@test
fn unauthenticated_changes_nothing() -> Result[(), peer.PeerError] {
    let mut a = established(51)
    let mut b = established(51)
    let payload: Bytes = b"\x10\x00\x9d\x01\x2a\x00\x00\x00\x00\x00"
    egress(mut a, payload)
    egress(mut b, payload)
    // Five packets that cross the 16-bit wrap: indices 65533 to 65537, ROC 1.
    let mut now = 20 * MS
    let mut replayed: Bytes = list.new()
    let mut number = 0u16
    for seq in[65533u16, 65534u16, 65535u16, 0u16, 1u16] {
        let pkt = media_numbered(mut a.cs, MEDIA_SSRC, seq, b"a", 96, number)
        number += 1
        replayed = copy_of(pkt)
        let x = media_at(mut a, now, pkt)
        let y = media_at(mut b, now, pkt)
        if x.index != y.index || x.section != 0 {
            fail("twins differ on valid traffic")
        }
        now += MS
    }
    let next = media_numbered(mut a.cs, MEDIA_SSRC, 2, b"a", 96, 5)
    let Some((track_ssrc, _)) = peer.track_ssrcs(a.p, 0) else {
        fail("down-track has no SSRC")
    }
    // Non-vacuity: a valid NACK hits the history and yields a repair ask.
    let first_nack = nack(mut a.cs, track_ssrc, 101)
    let x = control_at(mut a, now, first_nack)
    let y = control_at(mut b, now, first_nack)
    if list.len(x.repairs) != 1 || x.repairs[0].index != 101 || x.repairs[0].handle != 1 || list.len(y.repairs) != 1 {
        fail("a valid NACK did not reach the egress history")
    }
    let tail = list.len(next) - 1
    // Every bad input goes to twin a only.
    dropped(mut a, now, client_addr(), flip(next, tail), BAD_SRTP, "flipped tag bit")
    dropped(mut a, now, client_addr(), replayed, BAD_SRTP, "replay")
    let mut jump = flip(next, tail)
    jump[2] = 0x80
    jump[3] = 0x01
    dropped(mut a, now, client_addr(), jump, BAD_SRTP, "index 2^15 ahead under a bad tag")
    let mut moved = flip(next, tail)
    if moved[17] != b'a' {
        fail("fixture MID element moved")
    }
    moved[17] = b'b'
    dropped(mut a, now, client_addr(), moved, BAD_SRTP, "new MID under a bad tag")
    let bad_nack = nack(mut a.cs, track_ssrc, 102)
    dropped(mut a, now, client_addr(), flip(bad_nack, list.len(bad_nack) - 5), BAD_SRTP, "NACK under a bad tag")
    let bad_twcc = twcc(mut a.cs, track_ssrc, 5, now)
    dropped(mut a, now, client_addr(), flip(bad_twcc, list.len(bad_twcc) - 5), BAD_SRTP, "TWCC under a bad tag")
    dropped(mut a, now, stranger(), next, OFF_PATH, "valid packet off the 5-tuple table")
    let mut pkt: Bytes = list.with_capacity(576)
    list.fill(mut pkt, 576, 0)
    let mut scratch: Bytes = list.with_capacity(576)
    list.fill(mut scratch, 576, 0)
    let check = stun_ice.Check(role: stun_ice.IceRole(role: Controlling, tie: 7), priority: 0x6e0001ff, nominate: true)
    let k = result.unwrap(stun_ice.binding_request(stun_ice.Transaction(high: 3, low: 4), b"server:remote", Some(check), Sha1, true, b"not-the-server-password-00", mut pkt, mut scratch))
    dropped(mut a, now, stranger(), list.slice(pkt, 0, k), BAD_STUN, "STUN with bad MESSAGE-INTEGRITY")
    if peer.selected(a.p) != Some(client_addr()) {
        fail("bad STUN moved the selected path")
    }
    // The valid continuation: the next index is accepted at ROC 1, and both twins agree.
    let xn = media_at(mut a, now, next)
    let yn = media_at(mut b, now, next)
    if xn.index != 65538 || yn.index != 65538 || xn.section != yn.section || xn.payload_len != yn.payload_len {
        fail("the next valid packet was not taken at index 65538")
    }
    let good_nack = nack(mut a.cs, track_ssrc, 102)
    let xr = control_at(mut a, now, good_nack)
    let yr = control_at(mut b, now, good_nack)
    if list.len(xr.repairs) != 1 || list.len(yr.repairs) != 1 || xr.repairs[0].index != yr.repairs[0].index || xr.repairs[0].handle != yr.repairs[0].handle {
        fail("NACK answers differ after bad input")
    }
    // Non-vacuity: the five sent packets carry transport numbers 0 to 4, so the good
    // feedback acknowledges all five on both twins.
    let good_twcc = twcc(mut a.cs, track_ssrc, 5, now)
    let xt = control_at(mut a, now, good_twcc)
    let yt = control_at(mut b, now, good_twcc)
    if xt.acked != 5 || yt.acked != 5 || peer.target_bps(a.p) != peer.target_bps(b.p) {
        fail("TWCC or BWE differs after bad input")
    }
    if peer.bindings(a.p) != peer.bindings(b.p) || peer.selected(a.p) != peer.selected(b.p) {
        fail("bindings or path differ after bad input")
    }
    peer.clear_outbox(mut a.out)
    peer.clear_outbox(mut b.out)
    let _ = peer.poll(mut a.p, 3000 * MS, mut a.out)
    let _ = peer.poll(mut b.p, 3000 * MS, mut b.out)
    if list.len(a.out.pkts) == 0 || !same_out(a.out, b.out) {
        fail("reports, NACKs or TWCC feedback differ after bad input")
    }
    // Non-vacuity: the six accepted packets carried transport numbers 0 to 5, so the
    // feedback covers base 0 and six statuses; the rejected copies added none.
    if feedback_span(mut a.cs, a.out) != Some((0, 6)) {
        fail("ingress transport numbers did not reach the TWCC feedback")
    }
    let da = counts(peer.drops(a.p))
    let db = counts(peer.drops(b.p))
    if da[BAD_SRTP] != db[BAD_SRTP] + 6 || da[OFF_PATH] != db[OFF_PATH] + 1 || da[BAD_STUN] != db[BAD_STUN] + 1 {
        fail("drop counters")
    }
    // RTC-3 path move (NAT rebinding): an authenticated nomination from a new source
    // moves the path, and the DTLS association and SRTP state carry over. Media from
    // the old source is then off-path, and egress goes to the new source only.
    peer.clear_outbox(mut a.out)
    let check2 = stun_ice.Check(role: stun_ice.IceRole(role: Controlling, tie: 7), priority: 0x6e0001ff, nominate: true)
    let k2 = result.unwrap(stun_ice.binding_request(stun_ice.Transaction(high: 5, low: 6), b"server:remote", Some(check2), Sha1, true, server_pwd(), mut pkt, mut scratch))
    let mut nominated = copy_of(list.slice(pkt, 0, k2))
    if let Ok(Replied) = peer.receive(mut a.p, now, stranger(), mut nominated, mut a.out) {} else {
        fail("the rebinding nomination was not answered")
    }
    if peer.selected(a.p) != Some(stranger()) || !peer.connected(a.p) {
        fail("an authenticated nomination from a new source did not move the path, or dropped DTLS")
    }
    peer.clear_outbox(mut a.out)
    let after = media(mut a.cs, MEDIA_SSRC, 3, b"a", 96)
    let stale = media(mut a.cs, MEDIA_SSRC, 4, b"a", 96)
    let mut moved_slot = copy_of(after)
    match peer.receive(mut a.p, now, stranger(), mut moved_slot, mut a.out) {
        Ok(Media(m)) if m.index == 65539 => (),
        _ => fail("media on the moved path was not taken at index 65539"),
    }
    dropped(mut a, now, client_addr(), stale, OFF_PATH, "media from the old source after the move")
    let _ = peer.poll(mut a.p, 6000 * MS, mut a.out)
    if list.len(a.out.pkts) == 0 {
        fail("nothing sent after the move")
    }
    for tx in a.out.pkts {
        let UdpTx(to: sent_to, at: _, len: _, ecn: _) = tx
        if sent_to != stranger() {
            fail("egress after the move went to the old source")
        }
    }
    // Negative control: statistics run on the header before open count the replay as
    // received (RFC 3550 appendix A.3), so the twin comparison would see it.
    let mut early = rtp.stats.received(90000, 65533, 0, 0)
    let mut late = rtp.stats.received(90000, 65533, 0, 0)
    for i in 65534u64 .. 65538 {
        let _ = rtp.stats.on_packet(mut early, i, 0, 0)
        let _ = rtp.stats.on_packet(mut late, i, 0, 0)
    }
    let h = result.unwrap(rtp.header.parse(replayed))
    if let Index(i) = rtp.seq.estimate(65537, h.seq) {
        let _ = rtp.stats.on_packet(mut early, i, 0, 0)
    }
    let _ = rtp.stats.on_packet(mut early, 65538, 0, 0)
    let _ = rtp.stats.on_packet(mut late, 65538, 0, 0)
    if rtp.stats.report(mut early, MEDIA_SSRC, 0) == rtp.stats.report(mut late, MEDIA_SSRC, 0) {
        fail("negative control: statistics before open went unseen")
    }
    Ok(())
}

// ---- RTC-3 reduced-size feedback law ----
const MALFORMED: u64 = 9

// session_offer with every media section offering rtcp-rsize, as Chromium and Firefox
// offer it (vectors/browser.hirsel; libwebrtc pc/media_session.cc sets
// rtcp_reduced_size on every offer it makes).
fn rsize_offer() -> Bytes {
    let mut b = minimal_head(b" a b c")
    list.append(mut b, minimal_video(b"96 97", b"a", true))
    list.append(mut b, b"a=rtcp-rsize\na=sendonly\na=rtpmap:96 VP8/90000\na=rtpmap:97 rtx/90000\na=fmtp:97 apt=96\na=rtcp-fb:96 nack\na=extmap:3 http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01\n")
    list.append(mut b, minimal_video(b"96", b"b", true))
    list.append(mut b, b"a=rtcp-rsize\na=sendonly\na=rtpmap:96 VP8/90000\na=rtcp-fb:96 nack\n")
    list.append(mut b, minimal_video(b"96 97", b"c", true))
    list.append(mut b, b"a=rtcp-rsize\na=recvonly\na=rtpmap:96 VP8/90000\na=rtpmap:97 rtx/90000\na=fmtp:97 apt=96\na=rtcp-fb:96 nack\na=extmap:3 http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01\n")
    take b
}

// Firefox's first transport-cc feedback of an N1 call, as captured at the SFU
// (2639, firefox-b): V=2 with P set, FMT 15, PT 205, length 5; sender 0xaca72756,
// media 0x1db6dd62; base 0, one status, reference time 0x0010b3, feedback count 0;
// one run-length chunk (one received packet, small delta) with delta 0x3b; one
// padding octet of count 1. It is alone in its datagram, as libwebrtc's
// RTCPSender::SendCombinedRtcpPacket (modules/rtp_rtcp/source/rtcp_sender.cc) sends
// transport feedback in compound and reduced-size mode alike.
fn firefox_twcc(mut cs: srtp.Session) -> Bytes {
    let plain: Bytes = b"\xaf\xcd\x00\x05\xac\xa7\x27\x56\x1d\xb6\xdd\x62\x00\x00\x00\x01\x00\x10\xb3\x00\x20\x01\x3b\x01"
    sealed_rtcp(mut cs, copy_of(plain))
}

/// bug: answer a browser offer without rtcp-rsize, so the session reads RTCP as compound only and drops the browser's standalone transport-cc feedback, and the send-side estimate never leaves its start (N1 layer_switch with a Firefox subscriber, 2639).
/// oracle: Firefox's own first transport-cc feedback captured in N1, read by hand as one received status for transport number 0; libwebrtc's answer rule (pc/media_session.cc: the answer's rtcp_reduced_size is the offer's) and its feedback shape (rtcp_sender.cc SendCombinedRtcpPacket: transport feedback alone in its datagram); RFC 5506 section 5: reduced-size RTCP only once negotiated, so the same datagram on a session whose offer had no rtcp-rsize is one malformed drop.
@test
fn browser_feedback_reaches_bwe() -> Result[(), peer.PeerError] {
    let who = peer.Participant(gen: Gen(id: 1, epoch: 1), room: RoomId(7))
    let mut a = established_on(61, rsize_offer(), who, client_addr())
    let mut b = established(61)
    let payload: Bytes = b"\x10\x00\x9d\x01\x2a\x00\x00\x00\x00\x00"
    egress(mut a, payload)
    egress(mut b, payload)
    let now = 20 * MS
    let feedback = firefox_twcc(mut a.cs)
    let fed = control_at(mut a, now, feedback)
    if fed.acked != 1 {
        fail("standalone transport-cc feedback on an rtcp-rsize session did not reach the estimate")
    }
    // RFC 5506 section 5: without rtcp-rsize in the offer, the same datagram is not
    // compound and is dropped as malformed.
    let compound_only = firefox_twcc(mut b.cs)
    dropped(mut b, now, client_addr(), compound_only, MALFORMED, "standalone feedback taken without rtcp-rsize")
    Ok(())
}

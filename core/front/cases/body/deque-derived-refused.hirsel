// Deque exposes no key or ordered bound, so no structural comparison is admitted.
// expect: refuse LANG-21 at 5:50
// expect: refuse LANG-21 at 6:50
// expect: refuse LANG-12 at 7:18
fn equal(a: Deque[u64], b: Deque[u64]) -> bool { a == b }
fn order(a: Deque[u64], b: Deque[u64]) -> bool { a < b }
fn as_key(m: Map[Deque[u64], u64]) {}

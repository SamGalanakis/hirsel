// rule: PROV-1
// expect: reject PROV-1 at line 8
// twin: PROV/PROV-1-branded-list-call-result-literal-ok.hir
// A list inferred from a level of `a` is a `List[Level of a]`; pushing a level
// of `b` into it is refused like any other element of the wrong owner.
fn grow(a: Authority, b: Authority) -> u64 {
  let mut levels = [authority.floor(a)]
  list.push(mut levels, authority.floor(b))
  list.len(levels)
}

/// DecodeError's codec, as the derive writes a sum's: a store can keep a refusal.
pub fn of_decode_error() -> Codec[DecodeError] {
    storage_make(code.describe(decode_error_encode), code.describe(decode_error_decode), code.describe(decode_error_schema), 12, false)
}

fn decode_error_encode(x: DecodeError, mut out: Bytes) -> Result[(), EncodeError] {
    match x {
        Truncated(i) => {
            put_tag(0, mut out)
            put_u64(i, mut out)
        }
        Invalid(i) => {
            put_tag(1, mut out)
            put_u64(i, mut out)
        }
        Utf8(i) => {
            put_tag(2, mut out)
            put_u64(i, mut out)
        }
        Duplicate(i) => {
            put_tag(3, mut out)
            put_u64(i, mut out)
        }
        Trailing(i) => {
            put_tag(4, mut out)
            put_u64(i, mut out)
        }
        Schema(i) => {
            put_tag(5, mut out)
            put_u64(i, mut out)
        }
        Value(i) => {
            put_tag(6, mut out)
            put_u64(i, mut out)
        }
    }
    Ok(())
}

fn decode_error_decode(b: Bytes, mut at: u64) -> Result[DecodeError, DecodeError] {
    let tag = take_tag(b, mut at, 7)?
    let i = take_u64(b, mut at)?
    if tag == 0 {
        Ok(Truncated(i))
    } else if tag == 1 {
        Ok(Invalid(i))
    } else if tag == 2 {
        Ok(Utf8(i))
    } else if tag == 3 {
        Ok(Duplicate(i))
    } else if tag == 4 {
        Ok(Trailing(i))
    } else if tag == 5 {
        Ok(Schema(i))
    } else {
        Ok(Value(i))
    }
}

fn decode_error_schema(mut s: Schema, _c: Codec[DecodeError]) -> Result[(), EncodeError] {
    define(mut s, "std.codec.DecodeError", 0)?
    if sum(mut s, 7)? {
        return Ok(())
    }
    variant(mut s, "Truncated", 1)?
    schema_of(mut s, of_u64())?
    variant(mut s, "Invalid", 1)?
    schema_of(mut s, of_u64())?
    variant(mut s, "Utf8", 1)?
    schema_of(mut s, of_u64())?
    variant(mut s, "Duplicate", 1)?
    schema_of(mut s, of_u64())?
    variant(mut s, "Trailing", 1)?
    schema_of(mut s, of_u64())?
    variant(mut s, "Schema", 1)?
    schema_of(mut s, of_u64())?
    variant(mut s, "Value", 1)?
    schema_of(mut s, of_u64())?
    close(mut s)
    Ok(())
}

// Schemas. A schema is bytes: a version byte (3), the definitions (a u32 count, then
// each), then the root type. A type is an opcode byte: 0 (), 1 bool, 2 char, 3-6 u8-u64,
// 7-10 i8-i64, 11 f32, 12 f64, 13 String, 14 List and its element, 15 Map, its key and
// value, 16 Option and its type, 17 Result, its ok and error types, 18 a tuple (a u32
// arity, then the components), 19 a definition (its u32 index). A definition is its
// nominal path, its type arguments (a u32 count, then each), a kind byte and a body:
// 0 record (a u32 entry count, then per entry 0 for a field or 1 for a removed one, its
// name and type), 1 sum (a u32 variant count, then per variant 0, or 1 for a removed one,
// its name, a u32 field count and the field types), 2 via (the type it is written as).
// A name is a u32 byte count and UTF-8. Definitions are numbered in the order a
// depth-first walk from the root first meets them, so a type has one schema; defaults
// are the reader's, never in the bytes.
/// A schema being built: what a codec's schema function writes into.
pub opaque type Schema: shareable + send {
    cur: Bytes,
    saved: List[Bytes],
    open: List[u64],
    keys: List[Bytes],
    defs: List[Bytes],
    defaults: List[SchemaDefault],
    storage: Option[codec_storage.Graph]
}

pub type SchemaDefault: shareable + send {
    def: u64,
    field: String,
    value: Bytes
}

fn opcode(mut s: Schema, x: u8) {
    put_byte(mut s.cur, x)
}

fn name(mut s: Schema, n: String) -> Result[(), EncodeError] {
    put_string(n, mut s.cur)
}

fn storage_builder(key: bool) -> Schema {
    let mut s = builder()
    s.storage = Some(codec_storage.new(key))
    take s
}

fn storage_mode(s: Schema) -> bool {
    match s.storage {
        Some(_) => true,
        None => false
    }
}

fn storage_finish(s: Schema) -> Option[Bytes] {
    if let Some(g) = s.storage {
        codec_storage.finish(g)
    } else {
        None
    }
}

fn storage_type[T](_x: T) {}

fn storage_enter[T](mut s: Schema, marker: StaticFn[fn(T)]) -> Option[(u64, Option[u64])] {
    let offset = list.len(s.cur)
    if let Some(mut g) = s.storage {
        codec_storage.enter(mut g, marker, offset)
    } else {
        None
    }
}

fn storage_leave(mut s: Schema, i: u64, parent: Option[u64], take saved: Bytes) {
    let descriptor = replace(mut s.cur, take saved)
    if let Some(mut g) = s.storage {
        codec_storage.leave(mut g, i, parent, take descriptor)
    }
}

fn storage_external(mut s: Schema, take digest: Option[Bytes]) {
    match take digest {
        Some(b) => {
            put_byte(mut s.cur, 0)
            list.append(mut s.cur, b)
        }
        None => {
            if let Some(mut g) = s.storage {
                codec_storage.unavailable(mut g)
            }
        }
    }
}

fn storage_family(mut data: Bytes, family: String, version: u32) {
    result.unwrap(put_string(family, mut data))
    put_u32(version, mut data)
}

fn schema_atom(mut s: Schema, tag: u8, family: String, version: u32, key_family: String, key_version: u32) {
    if let Some(g) = s.storage {
        if codec_storage.is_key(g) {
            storage_family(mut s.cur, key_family, key_version)
        } else {
            storage_family(mut s.cur, family, version)
        }
    } else {
        opcode(mut s, tag)
    }
}

fn storage_nominal(mut s: Schema, family: String, version: u32) {
    storage_family(mut s.cur, family, version)
    if let Some(mut g) = s.storage {
        codec_storage.nominal(mut g)
    }
    if let Some(g) = s.storage {
        let path = codec_storage.path(g)
        result.unwrap(put_count(list.len(path), mut s.cur))
        list.append(mut s.cur, path)
    }
}

fn storage_field_end(mut s: Schema) {
    if storage_mode(s) {
        put_byte(mut s.cur, 0)
    }
}

// The checker emits a revision carrier for a via codec's named `to` function.
fn storage_to[T](_owner: Codec[T], _to: fn(T)) -> StaticFn[fn(T)] {
    fail("storage_to is emitted by the checker")
}

const VIA_RULE: u32 = 1

fn storage_via[T, R, E](mut s: Schema, c: Codec[R], _owner: Codec[T], to: StaticFn[fn(T)], from: StaticFn[fn(take R) -> Result[T, E]]) -> Result[(), EncodeError] {
    storage_nominal(mut s, "via", VIA_RULE)
    schema_of(mut s, c)?
    let (Some(a), Some(b)) = (code.revision(to), code.revision(from)) else {
        if let Some(mut g) = s.storage {
            codec_storage.unavailable(mut g)
        }
        return Ok(())
    }
    list.append(mut s.cur, a)
    list.append(mut s.cur, b)
    Ok(())
}

const DESC_RULE: u32 = 1

fn storage_desc[T](mut s: Schema, c: Codec[T]) -> Result[(), EncodeError] {
    storage_family(mut s.cur, "desc", DESC_RULE)
    schema_of(mut s, c)
}

const UNIT_RULE: u32 = 1

const KEY_UNIT_RULE: u32 = 1

pub fn schema_unit(mut s: Schema) {
    schema_atom(mut s, 0, "unit", UNIT_RULE, "key.unit", KEY_UNIT_RULE)
}

const BOOL_RULE: u32 = 1

const KEY_BOOL_RULE: u32 = 1

pub fn schema_bool(mut s: Schema) {
    schema_atom(mut s, 1, "bool", BOOL_RULE, "key.bool", KEY_BOOL_RULE)
}

const CHAR_RULE: u32 = 1

pub fn schema_char(mut s: Schema) {

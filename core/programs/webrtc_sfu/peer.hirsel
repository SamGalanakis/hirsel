// RTC-3 PeerSession and RTC-4 outbound SSRCs (webrtc spec, slice S3).
pub type Class: key = Stun | Dtls | Rtp | Rtcp | Drop

pub type RoomId: key = RoomId(u64)

pub type Gen: key = Gen(id: u64, epoch: u64)

pub type Tag {
    src: Option[Gen],
    dst: Gen,
    room: RoomId
}

pub type Participant {
    gen: Gen,
    room: RoomId
}

pub type Outbox {
    data: Bytes,
    pkts: List[UdpTx],
    tags: List[Tag]
}

pub type PeerLimits {
    sections: u8,
    down_tracks: u16,
    rtx_bytes: u64,
    pacer_packets: u32,
    // RTC-6: the estimate a session starts from before any feedback, in bit/s
    // (libwebrtc's and LiveKit's default is 300,000).
    start_bps: u64,
    dtls_transport: dtls.Transport,
    repair_profile: RepairProfile
}

pub const DTLS_DEFAULT: dtls.Transport = dtls.DEFAULT_TRANSPORT

pub type PeerError = Sdp(sdp.SdpError) | Fenced | Closed | Ice(stun_ice.IceError) | Dtls(dtls.DtlsError) | Srtp(srtp.SrtpError) | Rtp(rtp.header.WriteError) | Capacity(Capacity) | RepairConfig | IngressFailure

/// One drop counter per reason. Every dropped datagram raises exactly one.
pub type Drops: key {
    classified: u64,
    short_stun: u64,
    short_dtls: u64,
    short_rtp: u64,
    short_rtcp: u64,
    off_path: u64,
    stun: u64,
    early: u64,
    srtp: u64,
    malformed: u64,
    unbound: u64,
    format: u64,
    repair: u64,
    late: u64,
    nack: u64,
    capacity: u64,
    // A packet the session's full pacer refused (`pacer_packets`).
    paced: u64,
    // A packet whose pure RTP decode raised a caught failure inside `isolate`.
    ingress_failure: u64
}

/// An authenticated media packet, with views into the receive slot.
pub type MediaIn {
    section: u8,
    encoding: u8,
    ssrc: u32,
    index: u64,
    pt: u8,
    ts: u32,
    // The timestamp extended by RTP-2, and whether the loss window reset at this packet.
    wide: i64,
    reset: bool,
    marker: bool,
    payload_at: u64,
    payload_len: u64,
    audio_level: Option[u8],
    voice: Option[bool],
    layer: Option[media_bits.unit.Unit],
    // The AV1 dependency descriptor's value in the packet, as offset and length (0
    // when absent). Every unit parses it from the plaintext with its own structure.
    dd_at: u64,
    dd_len: u64,
    // RTC-5's header extensions the router carries on: the CVO byte (never on a
    // repair, which is not the publisher's current orientation), abs-capture-time,
    // and RTC-6's summary of a video layers allocation (never on a repair).
    orientation: Option[u8],
    capture: Option[Capture],
    plan: Option[Plan]
}

/// An abs-capture-time value as it arrived: the UQ32.32 NTP capture time and the
/// Q32.32 capture clock offset when the sender included one.
pub type Capture {
    ts: u64,
    offset: Option[i64]
}

/// A video layers allocation as RTC-6 reads it: the index of the stream that
/// carried it, bit `e` of `active` set when stream `e` has an active layer, and
/// stream `e`'s planned rate in kbps (its top layer at its top temporal layer).
pub type Plan {
    stream: u8,
    active: u8,
    kbps: Inline[u32, 4]
}

/// A static playout delay (RTC-5) in 10 ms units, each at most 4095, `min` at most `max`.
pub type Delay {
    min: u16,
    max: u16
}

/// A NACK hit on a down-track's egress history. The home unit resolves the
/// plaintext handle and answers with `resend`.
pub type RepairAsk {
    track: u16,
    index: u64,
    src: Gen,
    handle: u64,
    from: u64,
    len: u64
}

/// A keyframe request a subscriber sent for one of its down-tracks.
pub type KeyframeAsk {
    track: u16,
    fir: bool
}

pub type ControlIn {
    repairs: List[RepairAsk],
    keyframes: List[KeyframeAsk],
    // Sender reports of inbound streams, for the switch timeline (RTP-11 `on_sr`).
    senders: List[rtp.rtcp.SenderInfo],
    reports: u32,
    // Sent packets the TWCC feedback in this input acknowledged.
    acked: u64
}

pub type Input = Nothing | Replied | Media(MediaIn) | Repair(MediaIn) | Control(ControlIn)

pub type Poll = Transmit | WakeAt(u64) | Idle

/// One source packet presented to one down-track (RTC-5 fan-out step 2): the
/// publisher's generation, the ingress plaintext handle and payload range, the
/// router's source key for the encoding, the extended index and timestamp, the
/// codec configuration that picks the subscriber's payload type, and RTP-11's facts.
pub type Leg {
    src: Gen,
    handle: u64,
    source: u32,
    index: u64,
    ts: i64,
    marker: bool,
    codec: sdp.Codec,
    padding_only: bool,
    unit: rtp.rewrite.Unit,
    level: Option[u8],
    voice: bool,
    from: u64,
    len: u64,
    // The targets whose picture this packet closes (RTC-6 marker): bit `i` is set when
    // it is the last packet of a layer frame of target `i`'s highest spatial layer.
    closes: u32,
    // The AV1 dependency descriptor's value in the packet, `dd_len` 0 when it has none.
    dd_at: u64,
    dd_len: u64,
    // The publication's current CVO byte, written on the leg's last packet of each
    // frame, and the packet's abs-capture-time, passed on unchanged (RTC-5).
    orientation: Option[u8],
    capture: Option[Capture]
}

pub type Sent: key = OnMedia | AsRepair | Dropped | Held

/// The ingress bindings and path of a session, as RTC-3 states them.
pub type Binding: key {
    ssrc: u32,
    section: u8,
    encoding: u8,
    repair: bool
}

type Record {
    src: Gen,
    handle: u64,
    from: u64,
    len: u64,
    ts: u32,
    marker: bool,
    pt: u8,
    picture: Option[u16],
    tl0: Option[u8],
    dd: Option[Dd],
    cvo: Option[u8],
    capture: Option[Capture]
}

// The leg's dependency descriptor: the source's value at `at` for `len` bytes, sent
// with the leg's own frame number (RTP-11 Translate counter).
type Dd {
    at: u64,
    len: u64,
    frame: u16
}

// One packet waiting in the session's pacer (RTP-10's `Q`): its slab slot holds the
// payload as the leg sends it (an RTX repair's begins with its OSN), followed by its
// `dd` bytes of dependency descriptor, and the header is written at send, when the
// transport number is taken (RTP-8).
type PacedStream = Media(guard: u8) | Rtx | Fec | Padding

type Paced {
    slot: u32,
    track: u16,
    stream: PacedStream,
    fields: rtp.header.Fields,
    level: Option[u8],
    voice: bool,
    src: Gen,
    dd: u64,
    cvo: Option[u8],
    capture: Option[Capture]
}

type Inbound {
    ssrc: u32,
    section: u8,
    encoding: u8,
    repair: bool,
    // The extended index of the packet that made the current MID binding.
    bound_at: u64,
    highest: u64,
    ts: i64,
    stats: rtp.stats.Received,
    nack: bool,
    losses: rtp.loss.Losses,
    // Slot index mod RECEIVED holds the last index received there.
    received: List[u64]
}

// A down-track's RFC 4588 repair stream: its SSRC and next sequence number.
type RtxState {
    ssrc: u32,
    seq: u16
}

// A down-track's FlexFEC repair stream: its SSRC and next sequence number, whether
// the frame being sent is a keyframe, the group being filled and the protection level
// from the last report.
type FecState {
    ssrc: u32,
    seq: u16,
    key: bool,
    group: rtp.fec.Group,
    policy: rtp.fec.Policy
}

type Track {
    id: u16,
    section: u8,
    video: bool,
    opus_fmtp: Option[Bytes],
    ssrc: u32,
    rtx: Option[RtxState],
    highest: u64,
    sent: rtp.stats.Sent,
    history: rtp.history.History[Record],
    src: Option[Gen],
    rewrite: rtp.rewrite.Rewrite,
    // The switch index the history is gated at.
    gated: Option[u64],
    // VP8 picture ID and TL0PICIDX, keyed by the source frame's extended timestamp.
    pictures: rtp.counter.Counter,
    tl0s: rtp.counter.Counter,
    tl0: u8,
    // AV1 frame numbers, keyed by the source frame (timestamp and frame number), and
    // the source they are translated from.
    frames: rtp.counter.Counter,
    frames_source: Option[u32],
    // RTP-13: how many past primaries an audio track carries, the first source index
    // it may carry, and the NACKed and sent packets since its last report block.
    red: rtp.red.Policy,
    red_from: u64,
    nacked: u64,
    forwarded: u64,
    // The timestamp and payload type its padding carries (RTC-6 probing).
    last_ts: u32,
    last_pt: u8,
    // The subscription's static playout delay, written on every media packet (RTC-5).
    playout: Option[Delay],
    // RTP-14: the FlexFEC-03 repair stream, when the section agreed one.
    fec: Option[FecState]
}

type Section {
    agreed: sdp.Agreed,
    map: rtp.ext.ExtMap,
    // The MID value, the TWCC extension's presence and the extensions kept, ready for every packet.
    mid: Bytes,
    twcc: bool
}

pub opaque type PeerSession {
    who: Participant,
    limits: PeerLimits,
    repair_window: RepairWindow,
    random: Random,
    base: Addr,
    agreed: sdp.Negotiated,
    sections: List[Section],
    ice: stun_ice.Lite,
    path: Option[Addr],
    identity: Option[dtls.Identity],
    dtls: Option[dtls.Endpoint],
    srtp: Option[srtp.Session],
    closed: bool,
    ingress_failure: Option[Causes],
    drops: Drops,
    inbound: List[Inbound],
    tracks: List[Track],
    // Stable IDs held by the router and pacer map to positions in the live track list.
    track_slots: List[u16],
    used: List[u32],
    control: u32,
    cname: Bytes,
    recv_log: rtp.twcc.RecvLog,
    send_log: rtp.twcc.SendLog,
    bwe: rtp.bwe.Bwe,
    rtt: Option[u64],
    // RTC-6 probing: the transport numbers assigned so far (the next one's extended
    // index), the target when the last cluster started, and when the first and the last
    // cluster started.
    numbered: u64,
    probe_from: u64,
    probe_first: Option[u64],
    probe_last: u64,
    next_report: u64,
    next_feedback: u64,
    // Down-tracks a collision found on the RTP path, for the next `Control`.
    collided: List[u16],
    // Egress scratch, reused for every packet: the packet, the descriptor, a TWCC
    // value and a dependency descriptor, and the extension writer `ext.reset` empties
    // per packet.
    pkt: Bytes,
    word: Bytes,
    dd: Bytes,
    // An RTP-13 RED payload a down-track sends, rebuilt for each packet, and an RTP-14
    // FlexFEC repair payload.
    red: Bytes,
    repair: Bytes,
    ext: rtp.ext.ExtWriter,
    // The pacer, its `pacer_packets` payload slots reserved at `open`, the free ones,
    // and the entries `unpace` takes out.
    pacer: rtp.pacer.Pacer[Paced],
    slab: List[Bytes],
    free: List[u32],
    unpaced: List[Paced],
    // Publishers fenced in the room (RTC-7), each at its highest revoked epoch: a
    // paced entry from one is dropped when the pacer lets it out.
    barred: List[Gen],
    // The re-offer in flight after a collision (RTC-4): its version and the description
    // sent, which the answer is checked against.
    offered: Option[(u64, sdp.Description)],
    // A re-offer was asked for while `offered` was in flight (RTC-4).
    reoffer_due: bool
}

const EMPTY: u64 = 0xffffffffffffffff

const RECEIVED: u64 = 1024

const MIN_RESEND_NS: u64 = 10000000

const REPORT_NS: u64 = 1000000000

const REWRITE_RANGES: u32 = 64

const REWRITE_FRAMES: u32 = 64

const MAX_NACK_PAIRS: u32 = 16

pub const SLOT: u64 = 1500

// A two-byte header element's longest value (RFC 8285 section 4.3).
const DD_LIMIT: u64 = 255

// RTP-10: the pacing rate is 2.5 times the estimate, and the rate rises so a queue
// drains within 2 s (libwebrtc's kDefaultPaceMultiplier and kMaxExpectedQueueLength).
const PACE_FACTOR: f64 = 2.5

const QUEUE_LIMIT_NS: u64 = 2000000000

// RTC-6 probing: a cluster that did not raise the target is retried after 5 s, as
// libwebrtc's ProbeController repeats its periodic probe (kAlrPeriodicProbingInterval);
// within 5 s of the session's first cluster, after 1 s: the window and spacing of its
// opt-in repeated initial probing (initial_probing, kMaxWaitingTimeForProbingResult).
const PROBE_RETRY_NS: u64 = 5000000000

const PROBE_INITIAL_NS: u64 = 5000000000

const PROBE_INITIAL_RETRY_NS: u64 = 1000000000

const RTP_HEADER: u32 = 12

const STUN_BUFFER: u64 = 576

// Each session's transport-wide congestion control logs (RTP-12), in packets.
const CNAME_BYTES: u64 = 16

/// RFC 9443 section 3 (updating RFC 7983 section 7) and RFC 5761 section 4, from
/// at most the first two bytes.
pub fn classify(prefix: Bytes) -> Class {
    let n = list.len(prefix)
    if n == 0 {
        return Drop
    }
    let b = prefix[0]
    if b <= 3 {
        Stun
    } else if b >= 20 && b <= 63 {
        Dtls
    } else if b >= 128 && b <= 191 {
        if n < 2 {
            Drop
        } else if prefix[1] >= 192 && prefix[1] <= 223 {
            Rtcp
        } else {
            Rtp
        }
    } else {
        Drop
    }
}

pub fn outbox(size: u64, packets: u64) -> Result[Outbox, PeerError] {
    let mut data: Bytes = list.new()
    let mut pkts: List[UdpTx] = list.new()
    let mut tags: List[Tag] = list.new()
    list.try_reserve(mut data, size) ?=> |c| Capacity(c)
    list.try_reserve(mut pkts, packets) ?=> |c| Capacity(c)
    list.try_reserve(mut tags, packets) ?=> |c| Capacity(c)
    Ok(Outbox(data: take data, pkts: take pkts, tags: take tags))
}

pub fn clear_outbox(mut out: Outbox) {
    list.clear(mut out.data)
    list.clear(mut out.pkts)
    list.clear(mut out.tags)
}

fn no_drops() -> Drops {
    Drops(classified: 0, short_stun: 0, short_dtls: 0, short_rtp: 0, short_rtcp: 0, off_path: 0, stun: 0, early: 0, srtp: 0, malformed: 0, unbound: 0, format: 0, repair: 0, late: 0, nack: 0, capacity: 0, paced: 0, ingress_failure: 0)
}

fn ext_kind(e: sdp.Ext) -> Option[rtp.ext.Kind] {
    match e {
        Mid => Some(Mid),
        RidExtension => Some(Rid),
        RepairedRid => Some(RepairedRid),
        AudioLevel => Some(AudioLevel),
        AbsSendTime => Some(AbsSendTime),
        TransportCc => Some(TransportSeq),
        DependencyDescriptor => Some(DependencyDescriptor),
        VideoLayersAllocation => Some(VideoLayersAllocation),
        PlayoutDelay => Some(PlayoutDelay),
        VideoOrientation => Some(VideoOrientation),
        AbsCaptureTime => Some(AbsCaptureTime),
    }
}

fn section_map(a: sdp.Agreed) -> Result[rtp.ext.ExtMap, PeerError] {
    let form: rtp.ext.Form = match a.ext_form {
        OneOnly => OneOnly,
        TwoOnly => TwoOnly,
        Mixed => Mixed,
    }
    let mut m = rtp.ext.map(form)
    for x in a.extmaps {
        if let Some(k) = ext_kind(x.ext) {
            if let Error(_) = rtp.ext.bind(mut m, x.id, k) {
                return Error(Sdp(ExtmapConflict(a.index)))
            }
            if k == AudioLevel {
                rtp.ext.vad(mut m, x.vad == Some(VadOn))
            }
        }
    }
    Ok(m)
}

fn build_sections(n: sdp.Negotiated, limits: PeerLimits) -> Result[List[Section], PeerError] {
    if list.len(n.sections) > int.widen(limits.sections) {
        return Error(Sdp(TooManySections))
    }
    let mut out: List[Section] = list.new()
    list.try_reserve(mut out, list.len(n.sections)) ?=> |c| Capacity(c)
    for a in n.sections {
        let m = section_map(a)?
        let size: u64 = int.widen(a.mid_len)
        let mut mid: Bytes = list.new()
        list.try_reserve(mut mid, size) ?=> |c| Capacity(c)
        for i in 0u64 .. size {
            list.push(mut mid, a.mid[i])
        }
        let mut twcc = false
        for x in a.extmaps {
            if x.ext == TransportCc {
                twcc = true
            }
        }
        list.push(mut out, Section(agreed: clone(a), map: m, mid: take mid, twcc: twcc))
    }
    Ok(out)
}

fn copied(b: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(list.len(b))
    list.append(mut out, b)
    out
}

/// The heap bytes one session at `limits` reserves beyond its `PeerSession` value
/// (RTC-10 `room_cost`), from the bounds `open` and `add_track` allocate with: its
/// sections, ICE responder, congestion logs and bandwidth estimator, pacer and payload
/// slab, egress scratch, and a full set of down-tracks. Not included, because their size is the peer's input and not a bound:
/// the agreed SDP and section mids, ICE credentials, and DTLS and SRTP state.
pub fn session_heap(limits: PeerLimits) -> u64 {
    let Some(window) = repair_window(limits.repair_profile) else {
        return 0xffffffffffffffff
    }
    let n: u64 = int.widen(limits.pacer_packets)
    let tracks: u64 = int.widen(limits.down_tracks)
    let paced: Option[Paced] = None
    let mut sum = seq_of(bytes[Section], int.widen(limits.sections))
    sum += rtp.twcc.recv_log_heap(window.packets) + rtp.twcc.send_log_heap(window.packets) + seq_of(1, CNAME_BYTES) + rtp.bwe.bwe_heap() + stun_ice.lite_heap(1)
    sum += rtp.pacer.pacer_heap(limits.pacer_packets, paced)
    sum += seq_of(bytes[Bytes], n) + n * seq_of(1, SLOT) + seq_of(bytes[u32], n) + seq_of(bytes[Paced], n)
    sum += seq_of(1, SLOT + 128) + 2 * seq_of(1, SLOT) + seq_of(1, 2) + seq_of(1, DD_LIMIT)
    sum += seq_of(bytes[u32], ssrcs(limits))
    sum + seq_of(bytes[Track], tracks) + seq_of(bytes[u16], tracks) + tracks * track_heap(window)
}

/// The receive-side share of one session's DTLS handshake.
pub fn dtls_heap(limits: PeerLimits) -> u64 {
    dtls.receive_heap(limits.dtls_transport, SLOT)
}

/// Whether the DTLS profile fits the SFU's datagram envelope.
pub fn dtls_transport_fits(transport: dtls.Transport) -> bool {
    let mtu: u64 = int.widen(transport.mtu)
    mtu >= 256 && mtu <= SLOT && transport.start_rto_ns != 0 && transport.start_rto_ns <= transport.max_rto_ns && transport.handshake_ns != 0 && transport.max_message >= 2048 && transport.max_message <= 0x00ffffff
}

// The SSRCs a session draws while it holds a full set of down-tracks: its control SSRC,
// and each down-track's own, RTX and FlexFEC SSRCs.
fn ssrcs(limits: PeerLimits) -> u64 {
    let tracks: u64 = int.widen(limits.down_tracks)
    1 + 3 * tracks
}

// What one down-track's `Track` reserves beyond its value: its history, rewrite,
// codec counters and FlexFEC group.
fn track_heap(window: RepairWindow) -> u64 {
    let record: Option[Record] = None
    rtp.history.history_heap(window.packets, record) + rtp.rewrite.rewrite_heap(REWRITE_RANGES, REWRITE_FRAMES) + 3 * rtp.counter.counter_heap(window.counters) + rtp.fec.group_heap()
}

fn seq_of(element: u64, capacity: u64) -> u64 {
    option.unwrap(charge.seq(element, capacity))
}

/// Open the session for one participant on its home unit's socket `base`.
/// `cert` is the unit's DTLS identity (`dtls.share_identity`), `r` its randomness.
pub fn open(take local: sdp.LocalEnd, take cert: dtls.Identity, r: Random, base: Addr, limits: PeerLimits, agreed: sdp.Negotiated, participant: Participant) -> Result[PeerSession, PeerError] {
    if !dtls_transport_fits(limits.dtls_transport) {
        return Error(Dtls(Config))
    }
    let Some(window) = repair_window(limits.repair_profile) else {
        return Error(RepairConfig)
    }
    let sections = build_sections(agreed, limits)?
    let credentials = stun_ice.credentials(copied(local.ice_ufrag), copied(local.ice_pwd)) ?=> |take e| Ice(e)
    let mut bases: List[stun_ice.Local] = list.with_capacity(1)
    list.push(mut bases, stun_ice.Local(component: 1, base: base))
    let ice = stun_ice.lite(take credentials, take bases) ?=> |take e| Ice(e)
    let recv_log = rtp.twcc.recv_log(window.packets) ?=> |c| Capacity(c)
    let send_log = rtp.twcc.send_log(window.packets) ?=> |c| Capacity(c)
    let mut cname: Bytes = list.with_capacity(CNAME_BYTES)
    list.append(mut cname, b"hirsel-sfu")
    let pacer: rtp.pacer.Pacer[Paced] = rtp.pacer.pacer(limits.pacer_packets, PACE_FACTOR, QUEUE_LIMIT_NS, RTP_HEADER) ?=> |c| Capacity(c)
    let n: u64 = int.widen(limits.pacer_packets)
    let mut slab: List[Bytes] = list.new()
    let mut free: List[u32] = list.new()
    let mut unpaced: List[Paced] = list.new()
    list.try_reserve(mut slab, n) ?=> |c| Capacity(c)
    list.try_reserve(mut free, n) ?=> |c| Capacity(c)
    list.try_reserve(mut unpaced, n) ?=> |c| Capacity(c)
    for i in 0u64 .. n {
        let mut b: Bytes = list.new()
        list.try_reserve(mut b, SLOT) ?=> |c| Capacity(c)
        list.push(mut slab, take b)
        list.push(mut free, int.narrow(n - 1 - i))
    }
    let mut slots: List[u16] = list.with_capacity(int.widen(limits.down_tracks))
    list.fill(mut slots, int.widen(limits.down_tracks), NO_TRACK)
    let mut p = PeerSession(who: participant, limits: limits, repair_window: window, random: r, base: base, agreed: clone(agreed), sections: take sections, ice: take ice, path: None, identity: Some(take cert), dtls: None, srtp: None, closed: false, ingress_failure: None, drops: no_drops(), inbound: list.new(), tracks: list.with_capacity(int.widen(limits.down_tracks)), track_slots: take slots, used: list.with_capacity(ssrcs(limits)), control: 0, cname: take cname, recv_log: take recv_log, send_log: take send_log, bwe: rtp.bwe.bwe(rtp.bwe.Config(start_bps: limits.start_bps, min_bps: 30000, max_bps: 20000000)), rtt: None, numbered: 0, probe_from: 0, probe_first: None, probe_last: 0, next_report: 0, next_feedback: 0, collided: list.new(), pkt: list.new(), word: list.new(), dd: list.new(), red: list.new(), repair: list.new(), ext: rtp.ext.writer(), pacer: take pacer, slab: take slab, free: take free, unpaced: take unpaced, barred: list.new(), offered: None, reoffer_due: false)
    list.try_reserve(mut p.pkt, SLOT + 128) ?=> |c| Capacity(c)
    list.try_reserve(mut p.red, SLOT) ?=> |c| Capacity(c)
    list.try_reserve(mut p.repair, SLOT) ?=> |c| Capacity(c)
    list.try_reserve(mut p.word, 2) ?=> |c| Capacity(c)
    list.try_reserve(mut p.dd, DD_LIMIT) ?=> |c| Capacity(c)
    let fresh = draw(mut p)
    p.control = fresh
    Ok(take p)
}

// ---- RTC-4's SSRC generator ----
fn listed(xs: List[u32], v: u32) -> bool {
    for x in xs {
        if x == v {
            return true
        }
    }
    false
}

fn remote_used(p: PeerSession, v: u32) -> bool {
    for s in p.agreed.sections {
        if listed(s.remote_ssrcs, v) {
            return true
        }
    }
    for i in p.inbound {
        if i.ssrc == v {
            return true
        }
    }
    false
}

/// Never repeats a value in the session and never returns an SSRC the remote
/// end has used so far.
fn draw(mut p: PeerSession) -> u32 {
    loop {
        let mut b: Bytes = list.with_capacity(4)
        host.random(p.random, mut b)
        let v: u32 = list.word_be(b, 0)
        if v != 0 && !listed(p.used, v) && !remote_used(p, v) {
            list.push(mut p.used, v)
            return v
        }
    }
}

// ---- Outbox ----
fn queue(mut out: Outbox, to: Addr, packet: Bytes, tag: Tag) -> Result[(), PeerError] {
    let at = list.len(out.data)
    if list.capacity(out.data) - at < list.len(packet) {
        return Error(Capacity(Capacity(requested: list.len(packet), available: list.capacity(out.data) - at)))
    }
    list.try_reserve(mut out.pkts, 1) ?=> |c| Capacity(c)
    list.try_reserve(mut out.tags, 1) ?=> |c| Capacity(c)
    list.append(mut out.data, packet)
    list.push(mut out.pkts, UdpTx(to: to, at: at, len: list.len(packet), ecn: 0))
    list.push(mut out.tags, tag)
    Ok(())
}

fn own_tag(p: PeerSession) -> Tag {
    Tag(src: None, dst: p.who.gen, room: p.who.room)
}

// ---- Readers ----
pub fn drops(p: PeerSession) -> Drops {
    p.drops
}

/// Transfer a failed RTP ingress decoder's cause chain to its local owner.
pub fn take_ingress_failure(mut p: PeerSession) -> Option[Causes] {
    replace(mut p.ingress_failure, None)
}

pub fn selected(p: PeerSession) -> Option[Addr] {
    p.path
}

pub fn connected(p: PeerSession) -> bool {
    match p.srtp {
        Some(_) => true,
        None => false,
    }
}

pub fn bindings(p: PeerSession) -> List[Binding] {
    let mut out: List[Binding] = list.new()
    for i in p.inbound {
        list.push(mut out, Binding(ssrc: i.ssrc, section: i.section, encoding: i.encoding, repair: i.repair))
    }
    out
}

/// The agreement of section `i`.
pub fn agreement(p: PeerSession, i: u8) -> Option[sdp.Agreed] {
    let n: u64 = int.widen(i)
    if n >= list.len(p.sections) {
        return None
    }
    Some(clone(p.sections[n].agreed))
}

pub fn session_limits(p: PeerSession) -> PeerLimits {
    p.limits
}

pub fn who(p: PeerSession) -> Participant {
    p.who
}

/// Whether `ufrag` is the session's own ICE username fragment, the part of a
/// Binding request's USERNAME before its colon (RFC 8445 section 7.2.2).
pub fn named(p: PeerSession, ufrag: Bytes) -> bool {
    !p.closed && list.compare_bytes(p.agreed.local.ice_ufrag, ufrag) == Equal
}

/// Fence publisher `id` at `epoch` and below in this session (RTC-7 step 2): every
/// entry of its media the pacer still holds is dropped when it is let out.
pub fn bar(mut p: PeerSession, g: Gen) {
    let Gen(id: id, epoch: epoch) = g
    for i in 0u64 .. list.len(p.barred) {
        let Gen(id: b, epoch: e) = p.barred[i]
        if b == id {
            if epoch > e {
                p.barred[i] = g
            }
            return
        }
    }
    list.push(mut p.barred, g)
}

fn barred(p: PeerSession, src: Gen) -> bool {
    let Gen(id: id, epoch: epoch) = src
    for g in p.barred {
        let Gen(id: b, epoch: e) = g
        if b == id && epoch <= e {
            return true
        }
    }
    false
}

pub fn control_ssrc(p: PeerSession) -> u32 {
    p.control
}

const NO_TRACK: u16 = 0xffff

fn track_index(p: PeerSession, track: u16) -> Option[u64] {
    let id: u64 = int.widen(track)
    if id >= list.len(p.track_slots) || p.track_slots[id] == NO_TRACK {
        return None
    }
    Some(int.widen(p.track_slots[id]))
}

/// A down-track's media and RTX SSRCs, for `a=ssrc` and `a=ssrc-group:FID`.
pub fn track_ssrcs(p: PeerSession, track: u16) -> Option[(u32, Option[u32])] {
    let i = track_index(p, track)?
    let rtx = match p.tracks[i].rtx {
        Some(r) => Some(r.ssrc),
        None => None,
    }
    Some((p.tracks[i].ssrc, rtx))
}

pub fn target_bps(p: PeerSession) -> u64 {
    rtp.bwe.target(p.bwe)
}

// ---- Ingress ----
pub fn receive(mut p: PeerSession, now: u64, from: Addr, mut slot: Bytes, mut out: Outbox) -> Result[Input, PeerError] {
    if p.closed {
        return Error(Closed)
    }
    let class = classify(list.slice(slot, 0, if list.len(slot) < 2 {
        list.len(slot)
    } else {
        2
    }))
    if class == Drop {
        p.drops.classified += 1
        return Ok(Nothing)
    }
    if class == Stun {
        return stun_in(mut p, from, slot, mut out)
    }
    // Only the selected path reaches DTLS, RTP and RTCP.
    let on_path = match p.path {
        Some(a) => a == from,
        None => false,
    }
    if !on_path {
        p.drops.off_path += 1
        return Ok(Nothing)
    }
    match class {
        Dtls => dtls_in(mut p, now, slot, mut out),
        Rtp => rtp_in(mut p, now, mut slot, mut out),
        _ => rtcp_in(mut p, now, mut slot, mut out),
    }
}

fn stun_in(mut p: PeerSession, from: Addr, slot: Bytes, mut out: Outbox) -> Result[Input, PeerError] {
    if list.len(slot) < 20 {
        p.drops.short_stun += 1
        return Ok(Nothing)
    }
    let mut reply: Bytes = list.with_capacity(STUN_BUFFER)
    list.fill(mut reply, STUN_BUFFER, 0)
    let mut scratch: Bytes = list.with_capacity(STUN_BUFFER)
    list.fill(mut scratch, STUN_BUFFER, 0)
    let n = match stun_ice.lite_receive(mut p.ice, p.base, from, slot, mut reply, mut scratch) {
        Ok(n) => n,
        Error(_) => {
            p.drops.stun += 1
            return Ok(Nothing)
        },
    }
    queue(mut out, from, list.slice(reply, 0, n), own_tag(p))?
    // An authenticated USE-CANDIDATE selects the path, and a later one from a new
    // source moves it (NAT rebinding). The DTLS endpoint keeps its association: its
    // peer address serves only cookie admission, which a Verified server skips.
    if let Some(path) = stun_ice.lite_selected(p.ice, 1) {
        match p.path {
            None => select(mut p, path.peer)?,
            Some(a) if a != path.peer => {
                p.path = Some(path.peer)
            },
            _ => (),
        }
    }
    Ok(Replied)
}

fn select(mut p: PeerSession, peer: Addr) -> Result[(), PeerError] {
    let Some(take id) = replace(mut p.identity, None) else {
        return Ok(())
    }
    let mut e = dtls.server(take id, dtls.config_for(p.limits.dtls_transport), peer, Verified) ?=> |take x| Dtls(x)
    let mut digest: Bytes = list.with_capacity(32)
    for b in p.agreed.remote_fingerprint {
        list.push(mut digest, b)
    }
    let mut pins: List[dtls.Fingerprint] = list.new()
    list.push(mut pins, dtls.Fingerprint(hash: Sha256, digest: take digest))
    dtls.expect(mut e, take pins) ?=> |take x| Dtls(x)
    p.dtls = Some(take e)
    p.path = Some(peer)
    Ok(())
}

fn dtls_in(mut p: PeerSession, now: u64, slot: Bytes, mut out: Outbox) -> Result[Input, PeerError] {
    if list.len(slot) < 13 {
        p.drops.short_dtls += 1
        return Ok(Nothing)
    }
    if list.len(slot) > SLOT {
        p.drops.malformed += 1
        return Ok(Nothing)
    }
    let before = list.len(out.pkts)
    let r = p.random
    if let Some(take held) = replace(mut p.dtls, None) {
        let mut e = take held
        let mut data: Bytes = list.new()
        let got = dtls.receive(mut e, now, r, slot, mut data)
        p.dtls = Some(take e)
        let _ = got ?=> |take x| Dtls(x)
    }
    flush_dtls(mut p, now, mut out)?
    start_srtp(mut p)?
    if list.len(out.pkts) > before {
        Ok(Replied)
    } else {
        Ok(Nothing)
    }
}

fn flush_dtls(mut p: PeerSession, now: u64, mut out: Outbox) -> Result[Option[u64], PeerError] {
    let Some(to) = p.path else {
        return Ok(None)
    }
    let tag = own_tag(p)
    let r = p.random
    let Some(take held) = replace(mut p.dtls, None) else {
        return Ok(None)
    }
    let mut e = take held
    let mut wake: Result[Option[u64], PeerError] = Ok(None)
    loop {
        let mut d: Bytes = list.with_capacity(SLOT)
        match dtls.poll(mut e, now, r, mut d) {
            Ok(Send(_)) => if let Error(take x) = queue(mut out, to, d, tag) {
                wake = Error(take x)
                break
            },
            Ok(WakeAt(t)) => {
                wake = Ok(Some(t))
                break
            },
            Ok(Idle) => break,
            Error(Closed(_)) => break,
            Error(take x) => {
                wake = Error(Dtls(take x))
                break
            },
        }
    }
    p.dtls = Some(take e)
    wake
}

fn start_srtp(mut p: PeerSession) -> Result[(), PeerError] {
    if let Some(_) = p.srtp {
        return Ok(())
    }
    let mut ready: Option[schedule.SrtpProfile] = None
    if let Some(e) = p.dtls {
        if let Connected = dtls.state(e) {
            ready = dtls.srtp_profile(e)
        }
    }
    let Some(profile) = ready else {
        return Ok(())
    }
    let Some(take held) = replace(mut p.dtls, None) else {
        return Ok(())
    }
    let mut e = take held
    let keys = dtls.take_srtp(mut e)
    p.dtls = Some(take e)
    let k = keys ?=> |take x| Dtls(x)
    let tracks: u32 = int.widen(p.limits.down_tracks)
    let sections: u32 = int.widen(p.limits.sections)
    // Media, RTX and FlexFEC for each down-track, the control SSRC and one spare.
    let streams: u32 = 3 * tracks + 2
    let inbound: u32 = 8 * sections
    let l = srtp.Limits(send_streams: streams, receive_streams: inbound, ended_streams: streams)
    let s = srtp.session(take k, profile, l) ?=> |take x| Srtp(x)
    p.srtp = Some(take s)
    Ok(())
}

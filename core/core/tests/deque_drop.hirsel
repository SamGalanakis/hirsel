// Pending core deque cutover: front-to-back cleanup at every head position,
// including finalizer failure. Exact stdout makes missing/duplicate drops fail.
resource type DropLog { out: Stdout, id: u64, broken: bool, armed: bool }
  drop(t) {
    let letter = if t.id == 0 { "A" } else if t.id == 1 { "B" } else if t.id == 2 { "C" } else { "D" }
    if t.armed { let _ = stdout.write(t.out, letter) }
    if t.broken {
        let none: Option[u64] = None
        let _ = option.unwrap(none)
    }
  }

fn drop_ring(out: Stdout, n: u64, head: u64, broken: bool) -> u64 {
    let mut d: Deque[DropLog] = deque.new()
    for i in 0u64 .. n {
        result.unwrap(deque.push_back(mut d, result.unwrap(DropLog(out: out, id: i, broken: broken, armed: true))))
    }
    for _ in 0u64 .. head {
        let x = option.unwrap(deque.pop_front(mut d))
        result.unwrap(deque.push_back(mut d, take x))
    }
    n
}

// expect: stdout "A"
// expect: run normal_one0(out) = 1
fn normal_one0(out: Stdout) -> u64 { drop_ring(out, 1, 0, false) }

// expect: stdout "A"
// expect: run failed_one0(out) = fail Unwrap
fn failed_one0(out: Stdout) -> u64 { drop_ring(out, 1, 0, true) }

// expect: stdout "AB"
// expect: run normal_two0(out) = 2
fn normal_two0(out: Stdout) -> u64 { drop_ring(out, 2, 0, false) }

// expect: stdout "AB"
// expect: run failed_two0(out) = fail Unwrap
fn failed_two0(out: Stdout) -> u64 { drop_ring(out, 2, 0, true) }

// expect: stdout "BA"
// expect: run normal_two1(out) = 2
fn normal_two1(out: Stdout) -> u64 { drop_ring(out, 2, 1, false) }

// expect: stdout "BA"
// expect: run failed_two1(out) = fail Unwrap
fn failed_two1(out: Stdout) -> u64 { drop_ring(out, 2, 1, true) }


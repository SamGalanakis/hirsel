// The runner's R0 laws and cases (RUNNER-SPEC v2.4 §9). Each law_ returns whether its
// expectations, taken from the specification, the std codec and code.identity, hold;
// core/tools/runner_tests.py runs them on the evaluator and their test_ twins natively.
type Reg = runner.Registry[Clock, ()]

fn toggle(take i: u32) -> Result[bool, Capacity] {
    Ok(i % 2u32 == 0u32)
}

fn boom(take i: u32) -> Result[u32, Capacity] {
    let xs: List[u32] = list.new()
    Ok(xs[int.widen(i)])
}

fn size(take s: String) -> Result[u64, Capacity] {
    Ok(string.byte_len(s))
}

fn stamp(c: Clock, take n: u32) -> Result[u64, Capacity] waits {
    std.clock.sleep_ns(c, 1000u64)
    let m: u64 = int.widen(n)
    Ok(m + 1u64)
}

// v2.3's L4 case: an R of k bytes, whose encoding is 8 + k bytes more.
fn grow(take k: u64) -> Result[String, Capacity] {
    let mut b: Bytes = list.with_capacity(k)?
    for _ in 0u64 .. k {
        match list.push(mut b, 97u8) {
            Ok(()) => (),
            Error((c, _)) => return Error(c),
        }
    }
    match string.from_utf8(take b) {
        Ok(take s) => Ok(take s),
        Error(_) => fail("grow: ASCII is UTF-8"),
    }
}

fn e0(take x: u64) -> Result[u64, Capacity] {
    Ok(x)
}

fn e1(take x: u64) -> Result[u64, Capacity] {
    Ok(x + 1u64)
}

// A key as a client builds it: identity ++ fingerprint(A) ++ fingerprint(R), from
// code.identity and the std codec, not from the runner.
fn key_of[A, R](id: View[Bytes], ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Bytes {
    let mut key: Bytes = list.new()
    result.unwrap(list.append(mut key, id))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(ca)), mut key))
    result.unwrap(std.codec.put_u64(result.unwrap(std.codec.fingerprint(cr)), mut key))
    key
}

fn u32_arg(x: u32) -> Bytes {
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_u32(x, mut b))
    b
}

fn string_arg(n: u64, trailing: bool) -> Bytes {
    let mut s: Bytes = list.new()
    for _ in 0u64 .. n {
        result.unwrap(list.push(mut s, 97u8))
    }
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.put_string(result.unwrap(string.from_utf8(take s)), mut b))
    if trailing {
        result.unwrap(list.push(mut b, 0u8))
    }
    b
}

fn three() -> Reg {
    let mut r: Reg = runner.registry()
    result.unwrap(runner.compute(mut r, code.describe(toggle), 65536u64, runner.DEFAULT_STEPS))
    result.unwrap(runner.compute(mut r, code.describe(boom), 65536u64, runner.DEFAULT_STEPS))
    result.unwrap(runner.granted(mut r, code.describe(stamp), 65536u64, runner.DEFAULT_STEPS))
    r
}

fn described(r: Reg) -> Bytes {
    let mut b: Bytes = list.new()
    result.unwrap(runner.describe(r, mut b))
    b
}

// p01: a compute call answers Returned with R's bytes, Failed(Raised) for a fault,
// Refused(NoEntry) for an unknown key or a key of another kind, Refused(Malformed) for
// bytes that do not decode, and Refused(Budget) for an entry's bound the caller cannot grant.
pub fn law_p01_call() -> bool {
    let r = three()
    let four = u32_arg(4u32)
    let tk = key_of(code.identity(code.describe(toggle)), std.codec.of_u32(), std.codec.of_bool())
    let ok = match runner.call(r, tk, four) {
        Returned(b) => list.len(b) == 1u64 && b[0u64] == 1u8,
        _ => false,
    }
    let odd = match runner.call(r, tk, u32_arg(3u32)) {
        Returned(b) => list.len(b) == 1u64 && b[0u64] == 0u8,
        _ => false,
    }
    let fault = match runner.call(r, key_of(code.identity(code.describe(boom)), std.codec.of_u32(), std.codec.of_u32()), four) {
        Failed(Raised(2u32)) => true,
        _ => false,
    }
    let missing = match runner.call(r, string.as_bytes("missing"), four) {
        Refused(NoEntry) => true,
        _ => false,
    }
    let other_kind = match runner.call(r, key_of(code.identity(code.describe(stamp)), std.codec.of_u32(), std.codec.of_u64()), four) {
        Refused(NoEntry) => true,
        _ => false,
    }
    let empty: Bytes = list.new()
    let short = match runner.call(r, tk, empty) {
        Refused(Malformed(m)) => m.kind == 0u32 && m.at == 0u64,
        _ => false,
    }
    let mut five = u32_arg(4u32)
    result.unwrap(list.push(mut five, 9u8))
    let trailing = match runner.call(r, tk, five) {
        Refused(Malformed(m)) => m.kind == 4u32 && m.at == 4u64,
        _ => false,
    }
    // Inside a 64 KiB bound, an entry registered with 1 MiB cannot be granted.
    let mut big: Reg = runner.registry()
    result.unwrap(runner.compute(mut big, code.describe(toggle), 1048576u64, runner.DEFAULT_STEPS))
    let inside = bound bytes 65536u64 {
        match runner.call(big, tk, four) {
            Refused(Budget(_)) => true,
            _ => false,
        }
    }
    let budget = match inside {
        Ok(true) => true,
        _ => false,
    }
    ok && odd && fault && missing && other_kind && short && trailing && budget
}

// p09: describe is the codec of List[Described], in registration order, with each
// entry's kind, identity and argument and result schemas.
pub fn law_p09_describe() -> bool {
    let b = described(three())
    let c: std.codec.Codec[runner.Described] = std.codec.of()
    let mut at = 0u64
    let ds = match std.codec.take_list(b, mut at, c) {
        Ok(take ds) => take ds,
        Error(_) => return false,
    }
    if at != list.len(b) || list.len(ds) != 3u64 {
        return false
    }
    let u32s = result.unwrap(std.codec.schema(std.codec.of_u32()))
    let bools = result.unwrap(std.codec.schema(std.codec.of_bool()))
    let u64s = result.unwrap(std.codec.schema(std.codec.of_u64()))
    let d0 = ds[0u64]
    let d1 = ds[1u64]
    let d2 = ds[2u64]
    let kinds = match (d0.kind, d1.kind, d2.kind) {
        (Compute, Compute, Granted) => true,
        _ => false,
    }
    kinds && d0.identity == code.identity(code.describe(toggle)) && d1.identity == code.identity(code.describe(boom)) &&
        d2.identity == code.identity(code.describe(stamp)) && d0.args == u32s && d0.result == bools &&
        d1.args == u32s && d1.result == u32s && d2.args == u32s && d2.result == u64s
}

// p13: registering a key already present is refused with that key, and the registry
// (its description and its calls) is unchanged.
pub fn law_p13_duplicate_refused() -> bool {
    let mut r = three()
    let before = described(r)
    let tk = key_of(code.identity(code.describe(toggle)), std.codec.of_u32(), std.codec.of_bool())
    let refused = match runner.compute(mut r, code.describe(toggle), 65536u64, runner.DEFAULT_STEPS) {
        Error(AlreadyRegistered(k)) => k == tk,
        _ => false,
    }
    let again = match runner.granted(mut r, code.describe(stamp), 65536u64, runner.DEFAULT_STEPS) {
        Error(AlreadyRegistered(_)) => true,
        _ => false,
    }
    let still = match runner.call(r, tk, u32_arg(4u32)) {
        Returned(b) => list.len(b) == 1u64 && b[0u64] == 1u8,
        _ => false,
    }
    refused && again && still && described(r) == before
}

fn same_room(a: runner.Room, b: runner.Room) -> bool {
    a.requested == b.requested && a.available == b.available
}

fn same_fault(a: runner.Fault, b: runner.Fault) -> bool {
    match a {
        Raised(x) => match b { Raised(y) => x == y, _ => false },
        OutOfBytes(x) => match b { OutOfBytes(y) => same_room(x, y), _ => false },
        OutOfTime(x) => match b { OutOfTime(y) => x == y, _ => false },
        Gone => match b { Gone => true, _ => false },
    }
}

fn same_refusal(a: runner.Refusal, b: runner.Refusal) -> bool {
    match a {
        NoEntry => match b { NoEntry => true, _ => false },
        Malformed(x) => match b { Malformed(y) => x.kind == y.kind && x.at == y.at, _ => false },
        Overloaded => match b { Overloaded => true, _ => false },
        Deadline => match b { Deadline => true, _ => false },
        Budget(x) => match b { Budget(y) => same_room(x, y), _ => false },
        NotAllowed => match b { NotAllowed => true, _ => false },
        RequestMismatch => match b { RequestMismatch => true, _ => false },
        HistoryUnavailable => match b { HistoryUnavailable => true, _ => false },
    }
}

fn same(a: runner.Outcome, b: runner.Outcome) -> bool {
    match a {
        Returned(x) => match b { Returned(y) => x == y, _ => false },
        Failed(x) => match b { Failed(y) => same_fault(x, y), _ => false },
        Refused(x) => match b { Refused(y) => same_refusal(x, y), _ => false },
        Abandoned => match b { Abandoned => true, _ => false },
        InDoubt => match b { InDoubt => true, _ => false },
    }
}

fn trip(c: std.codec.Codec[runner.Outcome], take o: runner.Outcome) -> bool {
    let mut out: Bytes = list.new()
    result.unwrap(std.codec.encode(c, o, mut out))
    match std.codec.decode(c, out) {
        Ok(Ok(back)) => same(back, o),
        _ => false,
    }
}

// p15: every Outcome case, and a Described, round-trips through std.codec.of.
pub fn law_p15_types_roundtrip() -> bool {
    let c: std.codec.Codec[runner.Outcome] = std.codec.of()
    let mut b: Bytes = list.new()
    result.unwrap(list.push(mut b, 5u8))
    result.unwrap(list.push(mut b, 7u8))
    let mut ok = trip(c, Returned(take b)) && trip(c, Failed(Raised(9u32)))
    ok = ok && trip(c, Failed(OutOfBytes(runner.Room(requested: 2u64, available: 1u64)))) && trip(c, Failed(OutOfTime(77u64)))
    ok = ok && trip(c, Failed(Gone)) && trip(c, Refused(NoEntry)) && trip(c, Refused(Malformed(runner.Bad(kind: 3u32, at: 11u64))))
    ok = ok && trip(c, Refused(Overloaded)) && trip(c, Refused(Deadline)) && trip(c, Refused(Budget(runner.Room(requested: 5u64, available: 4u64))))
    ok = ok && trip(c, Refused(NotAllowed)) && trip(c, Refused(RequestMismatch)) && trip(c, Refused(HistoryUnavailable)) && trip(c, Abandoned) && trip(c, InDoubt)
    let dc: std.codec.Codec[runner.Described] = std.codec.of()
    let mut id: Bytes = list.new()
    result.unwrap(list.push(mut id, 1u8))
    let mut out: Bytes = list.new()
    let d = runner.Described(kind: Transact, identity: take id, args: u32_arg(1u32), result: u32_arg(2u32))
    result.unwrap(std.codec.encode(dc, d, mut out))
    let back = match std.codec.decode(dc, out) {
        Ok(Ok(take x)) => take x,
        _ => return false,
    }
    let kind = match back.kind {
        Transact => true,
        _ => false,
    }
    ok && kind && back.identity == d.identity && back.args == d.args && back.result == d.result
}

fn place_branching(mut r: Reg) -> Result[(), runner.RegisterError] {
    runner.compute(mut r, code.describe(e0), 65536u64, runner.DEFAULT_STEPS)?
    let scratch: Result[List[u64], Capacity] = list.with_capacity(8192u64)
    match scratch {
        Ok(_) => runner.compute(mut r, code.describe(e1), 65536u64, runner.DEFAULT_STEPS),
        Error(_) => Ok(()),
    }
}

fn branching_under(n: u64) -> Bytes {
    let made = bound bytes n {
        let mut r: Reg = runner.registry()
        let mut b: Bytes = list.new()
        match place_branching(mut r) {
            Ok(()) => result.unwrap(runner.describe(r, mut b)),
            Error(_) => (),
        }
        b
    }
    match take made {
        Ok(take b) => take b,
        Error(_) => list.new(),
    }
}

// p19_place_bound: a place that branches on Capacity gives one list under one bound
// (and, so the case can fail, different lists under 4,096 B and 32 MiB).
pub fn law_p19_place_bound() -> bool {
    let small = branching_under(4096u64)
    let large = branching_under(33554432u64)
    let again = branching_under(4096u64)
    list.len(small) > 8u64 && small == again && small != large && large == branching_under(33554432u64)
}

fn size_call(r: Reg, key: Bytes, arg: Bytes) -> runner.Outcome {
    runner.call(r, key, arg)
}

fn sized(n: u64) -> Reg {
    let mut r: Reg = runner.registry()
    result.unwrap(runner.compute(mut r, code.describe(size), n, runner.DEFAULT_STEPS))
    r
}

// The smallest outer bound in which one valid call answers Returned.
fn valid_peak(r: Reg, key: Bytes, arg: Bytes, n: u64) -> u64 {
    let mut lo = 0u64
    let mut hi = 4u64 * n + 1048576u64
    while lo < hi {
        let mid = lo + (hi - lo) / 2u64
        let fits = bound bytes mid {
            match size_call(r, key, arg) {
                Returned(_) => true,
                _ => false,
            }
        }
        match fits {
            Ok(true) => {
                hi = mid
            },
            _ => {
                lo = mid + 1u64
            },
        }
    }
    lo
}

// L4: the argument is decoded, and the result encoded, inside the entry's bound, so a
// call's charge is its bound and nothing outside it. (a) A 4,096-byte String is
// Failed(OutOfBytes) for an entry registered with 1,024 bytes, and Returned(4,096) for
// one registered with 16,384. (b) 10,000 malformed calls (the same String plus one
// trailing byte, so each decodes the whole String before it is refused) all answer
// Refused(Malformed) inside the smallest bound that holds one valid call: the flood's
// peak charge is at most one valid call's. (c) v2.3: an entry registered with 4,096
// bytes whose body returns 3,000 bytes. Its 3,004-byte encoding charges 3,008 more
// bytes (6,008 together). It is Failed(OutOfBytes), and the caller goes on to
// a call that fits (100 bytes, encoded as 4 + 100 = 104).
pub fn law_l4_malformed_flood() -> bool {
    let r = sized(16384u64)
    let key = key_of(code.identity(code.describe(size)), std.codec.of_string(), std.codec.of_u64())
    let valid = string_arg(4096u64, false)
    let small = match runner.call(sized(1024u64), key, valid) {
        Failed(OutOfBytes(_)) => true,
        _ => false,
    }
    let n = 16384u64
    let large = match runner.call(r, key, valid) {
        Returned(b) => b == {
            let mut e: Bytes = list.new()
            result.unwrap(std.codec.put_u64(4096u64, mut e))
            e
        },
        _ => false,
    }
    let peak = valid_peak(r, key, valid, n)
    let bad = string_arg(4096u64, true)
    let flood = bound bytes peak {
        let mut all = true
        for _ in 0u64 .. 10000u64 {
            match size_call(r, key, bad) {
                Refused(Malformed(m)) => {
                    if m.kind != 4u32 {
                        all = false
                    }
                },
                _ => {
                    all = false
                },
            }
        }
        all
    }
    let held = match flood {
        Ok(true) => true,
        _ => false,
    }
    let mut g: Reg = runner.registry()
    result.unwrap(runner.compute(mut g, code.describe(grow), 4096u64, runner.DEFAULT_STEPS))
    let gk = key_of(code.identity(code.describe(grow)), std.codec.of_u64(), std.codec.of_string())
    let over = match runner.call(g, gk, {
        let mut a: Bytes = list.new()
        result.unwrap(std.codec.put_u64(3000u64, mut a))
        a
    }) {
        Failed(OutOfBytes(_)) => true,
        _ => false,
    }
    let fits = match runner.call(g, gk, {
        let mut a: Bytes = list.new()
        result.unwrap(std.codec.put_u64(100u64, mut a))
        a
    }) {
        Returned(b) => list.len(b) == 104u64,
        _ => false,
    }
    small && large && held && over && fits
}

@test
fn test_p01_call() -> Result[(), ()] {
    if law_p01_call() { Ok(()) } else { Error(()) }
}

@test
fn test_p09_describe() -> Result[(), ()] {
    if law_p09_describe() { Ok(()) } else { Error(()) }
}

@test
fn test_p13_duplicate_refused() -> Result[(), ()] {
    if law_p13_duplicate_refused() { Ok(()) } else { Error(()) }
}

@test
fn test_p15_types_roundtrip() -> Result[(), ()] {
    if law_p15_types_roundtrip() { Ok(()) } else { Error(()) }
}

@test
fn test_p19_place_bound() -> Result[(), ()] {
    if law_p19_place_bound() { Ok(()) } else { Error(()) }
}

@test
fn test_l4_malformed_flood() -> Result[(), ()] {
    if law_l4_malformed_flood() { Ok(()) } else { Error(()) }
}

// p02: a granted entry runs as a task under `bytes n` holding its grant (the Clock),
// and waits; start refuses a key of another kind.
pub fn law_p02_start_finish(c: Clock, tasks: Tasks) -> bool waits {
    let r = three()
    let sk = key_of(code.identity(code.describe(stamp)), std.codec.of_u32(), std.codec.of_u64())
    let t = match runner.start(r, tasks, c, sk, u32_arg(41u32)) {
        Ok(take t) => take t,
        Error(_) => return false,
    }
    let ok = match runner.finish(take t) {
        Returned(b) => b == {
            let mut e: Bytes = list.new()
            result.unwrap(std.codec.put_u64(42u64, mut e))
            e
        },
        _ => false,
    }
    let tk = key_of(code.identity(code.describe(toggle)), std.codec.of_u32(), std.codec.of_bool())
    let other = match runner.start(r, tasks, c, tk, u32_arg(41u32)) {
        Error(NoEntry) => true,
        _ => false,
    }
    let empty: Bytes = list.new()
    let m = match runner.start(r, tasks, c, sk, take empty) {
        Ok(take t2) => match runner.finish(take t2) {
            Refused(Malformed(b)) => b.kind == 0u32,
            _ => false,
        },
        Error(_) => false,
    }
    ok && other && m
}

@test
fn test_p02_start_finish(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    if law_p02_start_finish(c, tasks) { Ok(()) } else { Error(()) }
}

fn return_child(take n: u64) -> u64 { n }
fn granted_spawn(tasks: Tasks, take n: u64) -> Result[u64, Capacity] waits {
    let h = match task.spawn(tasks, bytes 0u64, n, return_child) {
        Ok(take h) => take h,
        Error((c, _)) => return Error(c),
    }
    match task.join(take h) { Ok(v) => Ok(v), _ => fail("granted child failed") }
}

pub fn law_granted_tasks_copy_steps(tasks: Tasks) -> bool waits {
    let mut r: runner.Registry[Tasks, ()] = runner.registry()
    result.unwrap(runner.granted(mut r, code.describe(granted_spawn), 65536u64, 1000u64))
    let codec = std.codec.of_u64()
    let key = key_of(code.identity(code.describe(granted_spawn)), codec, codec)
    let mut arg: Bytes = list.new()
    result.unwrap(std.codec.put_u64(7u64, mut arg))
    let ran = bound steps 1000000u64 {
        match runner.start(r, tasks, tasks, key, take arg) {
            Ok(take h) => match runner.finish(take h) {
                Returned(b) => list.len(b) == 8u64 && b[0u64] == 7u8 &&
                    b[1u64] == 0u8 && b[2u64] == 0u8 && b[3u64] == 0u8 &&
                    b[4u64] == 0u8 && b[5u64] == 0u8 && b[6u64] == 0u8 && b[7u64] == 0u8,
                _ => false,
            },
            Error(_) => false,
        }
    }
    match ran { Ok(v) => v, Error(_) => false }
}

@test
fn test_granted_tasks_copy_steps(tasks: Tasks) -> Result[(), ()] waits {
    if law_granted_tasks_copy_steps(tasks) { Ok(()) } else { Error(()) }
}

resource type BusyGrant: send { clock: Clock } drop(g) { loop {} }
fn grant_returns(g: BusyGrant, take x: u32) -> Result[u32, Capacity] waits {
    std.clock.sleep_ns(g.clock, 0u64)
    Ok(x)
}
fn forever(take x: u32) -> Result[u32, Capacity] { loop {} }
fn granted_forever(c: Clock, take x: u32) -> Result[u32, Capacity] waits { std.clock.sleep_ns(c, 0u64); loop {} }

// Both forms return the registered allowance, including a stop in decode.
pub fn law_step_bounds(c: Clock, tasks: Tasks) -> bool waits {
    let mut r: Reg = runner.registry()
    result.unwrap(runner.compute(mut r, code.describe(forever), 65536u64, 65536u64))
    result.unwrap(runner.granted(mut r, code.describe(granted_forever), 65536u64, 65536u64))
    let ca: std.codec.Codec[u32] = std.codec.of()
    let cr: std.codec.Codec[u32] = std.codec.of()
    let k = key_of(code.identity(code.describe(forever)), ca, cr)
    match runner.call(r, k, u32_arg(7u32)) {
        Failed(OutOfTime(65536)) => {}, _ => return false,
    }
    let kg = key_of(code.identity(code.describe(granted_forever)), ca, cr)
    let h = match runner.start(r, tasks, c, kg, u32_arg(7u32)) {
        Ok(take t) => take t, _ => return false,
    }
    match runner.finish(take h) {
        Failed(OutOfTime(65536)) => {}, _ => return false,
    }
    let mut zero: Reg = runner.registry()
    result.unwrap(runner.compute(mut zero, code.describe(toggle), 65536u64, 0u64))
    let kz = key_of(code.identity(code.describe(toggle)), ca, std.codec.of_bool())
    match runner.call(zero, kz, u32_arg(2u32)) {
        Failed(OutOfTime(0)) => {}, _ => return false,
    }
    // The granted task owns its grant. Its finalizer gets no unmetered tail.
    let mut owned: runner.Registry[BusyGrant, ()] = runner.registry()
    result.unwrap(runner.granted(mut owned, code.describe(grant_returns), 65536u64, 32u64))
    let ko = key_of(code.identity(code.describe(grant_returns)), ca, cr)
    let g = result.unwrap(BusyGrant(clock: c))
    let finalizing = match runner.start(owned, tasks, take g, ko, u32_arg(2u32)) {
        Ok(take t) => take t, _ => return false,
    }
    match runner.finish(take finalizing) { Failed(OutOfTime(32)) => true, _ => false }
}

@test
fn test_step_bounds(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    if law_step_bounds(c, tasks) { Ok(()) } else { Error(()) }
}

fn secret_mac_authority() -> u64 {
    let data = string.as_bytes("what do ya want for nothing?")
    let key = string.into_bytes("Jefe")
    let mac = result.unwrap(secret.seal(take key, "mac"))
    let tag = result.unwrap(secret.hmac_sha256(mac, data))
    let mut tag_data: Bytes = list.with_capacity(32)
    if !bytebuf.append_inline(mut tag_data, tag, 0, 32) {
        return 1
    }
    let verify = result.unwrap(secret.narrow(mac, "verify"))
    let narrowed = result.unwrap(secret.narrow(verify, "mac"))
    match secret.hmac_sha256(narrowed, data) {
        Error(Denied) => {},
        _ => return 2,
    }
    if !result.unwrap(secret.verify_hmac_sha256(narrowed, data, tag_data)) {
        return 3
    }
    if result.unwrap(secret.verify_hmac_sha256(narrowed, data, list.slice(tag_data, 0, 31))) {
        return 4
    }
    let other_key = string.into_bytes("Jefe")
    let no_use = result.unwrap(secret.seal(take other_key, "tls_send(alpha.test)"))
    match secret.narrow(no_use, "mac") {
        Error(Invalid) => {},
        _ => return 5,
    }
    match secret.hmac_sha256(no_use, data) {
        Error(Denied) => 0,
        _ => 6,
    }
}

fn repeated_key(byte: u8, len: u64) -> Secret {
    let mut key: Bytes = list.with_capacity(len)
    for _ in 0u64 .. len {
        list.push(mut key, byte)
    }
    result.unwrap(secret.seal(take key, "mac"))
}

fn matches_hmac_sha2(key: Secret, msg: Bytes, want384: Bytes, want512: Bytes) -> bool {
    let mac384 = result.unwrap(secret.hmac_sha384(key, msg))
    let mac512 = result.unwrap(secret.hmac_sha512(key, msg))
    let mut out384: Bytes = list.with_capacity(48)
    let mut out512: Bytes = list.with_capacity(64)
    if !bytebuf.append_inline(mut out384, mac384, 0, 48) || !bytebuf.append_inline(mut out512, mac512, 0, 64) {
        return false
    }
    let verifier = result.unwrap(secret.narrow(key, "verify"))
    let Error(Denied) = secret.hmac_sha384(verifier, msg) else {
        return false
    }
    let Error(Denied) = secret.hmac_sha512(verifier, msg) else {
        return false
    }
    out384 == want384 && out512 == want512 && result.unwrap(secret.verify_hmac_sha384(verifier, msg, want384)) && result.unwrap(secret.verify_hmac_sha512(verifier, msg, want512)) && !result.unwrap(secret.verify_hmac_sha384(verifier, msg, list.slice(want384, 0, 47))) && !result.unwrap(secret.verify_hmac_sha512(verifier, msg, list.slice(want512, 0, 63)))
}

fn matches_hmac_sha1(key: Secret, msg: Bytes, expected: Bytes) -> bool {
    let tag = result.unwrap(secret.hmac_sha1(key, msg))
    let mut actual: Bytes = list.with_capacity(20)
    if !bytebuf.append_inline(mut actual, tag, 0, 20) || actual != expected {
        return false
    }
    let verifier = result.unwrap(secret.narrow(key, "verify"))
    let Error(Denied) = secret.hmac_sha1(verifier, msg) else {
        return false
    }
    if !result.unwrap(secret.verify_hmac_sha1(verifier, msg, expected)) || result.unwrap(secret.verify_hmac_sha1(verifier, msg, list.slice(expected, 0, 19))) {
        return false
    }
    actual[19] ^= 1
    !result.unwrap(secret.verify_hmac_sha1(verifier, msg, actual))
}

// RFC 2202 section 3, cases 1 and 6.
fn secret_hmac_sha1_vectors() -> bool {
    let key = repeated_key(0x0b, 20)
    let expected = b"\xb6\x17\x31\x86\x55\x05\x72\x64\xe2\x8b\xc0\xb6\xfb\x37\x8c\x8e\xf1\x46\xbe\x00"
    let long_key = repeated_key(0xaa, 80)
    let expected_long = b"\xaa\x4a\xe5\xe1\x52\x72\xd0\x0e\x95\x70\x56\x37\xce\x8a\x3b\x55\xed\x40\x21\x12"
    matches_hmac_sha1(key, b"Hi There", expected) && matches_hmac_sha1(long_key, b"Test Using Larger Than Block-Size Key - Hash Key First", expected_long)
}

// RFC 4231 sections 4.2 and 4.7, including a key longer than the hash block.
fn secret_hmac_vectors() -> bool {
    let key0 = repeated_key(0x0b, 20)
    let want384_0 = b"\xaf\xd0\x39\x44\xd8\x48\x95\x62\x6b\x08\x25\xf4\xab\x46\x90\x7f\x15\xf9\xda\xdb\xe4\x10\x1e\xc6\x82\xaa\x03\x4c\x7c\xeb\xc5\x9c\xfa\xea\x9e\xa9\x07\x6e\xde\x7f\x4a\xf1\x52\xe8\xb2\xfa\x9c\xb6"
    let want512_0 = b"\x87\xaa\x7c\xde\xa5\xef\x61\x9d\x4f\xf0\xb4\x24\x1a\x1d\x6c\xb0\x23\x79\xf4\xe2\xce\x4e\xc2\x78\x7a\xd0\xb3\x05\x45\xe1\x7c\xde\xda\xa8\x33\xb7\xd6\xb8\xa7\x02\x03\x8b\x27\x4e\xae\xa3\xf4\xe4\xbe\x9d\x91\x4e\xeb\x61\xf1\x70\x2e\x69\x6c\x20\x3a\x12\x68\x54"
    if !matches_hmac_sha2(key0, b"Hi There", want384_0, want512_0) {
        return false
    }
    let key1 = repeated_key(0xaa, 131)
    let want384_1 = b"\x4e\xce\x08\x44\x85\x81\x3e\x90\x88\xd2\xc6\x3a\x04\x1b\xc5\xb4\x4f\x9e\xf1\x01\x2a\x2b\x58\x8f\x3c\xd1\x1f\x05\x03\x3a\xc4\xc6\x0c\x2e\xf6\xab\x40\x30\xfe\x82\x96\x24\x8d\xf1\x63\xf4\x49\x52"
    let want512_1 = b"\x80\xb2\x42\x63\xc7\xc1\xa3\xeb\xb7\x14\x93\xc1\xdd\x7b\xe8\xb4\x9b\x46\xd1\xf4\x1b\x4a\xee\xc1\x12\x1b\x01\x37\x83\xf8\xf3\x52\x6b\x56\xd0\x37\xe0\x5f\x25\x98\xbd\x0f\xd2\x21\x5d\x6a\x1e\x52\x95\xe6\x4f\x73\xf6\x3f\x0a\xec\x8b\x91\x5a\x98\x5d\x78\x65\x98"
    if !matches_hmac_sha2(key1, b"Test Using Larger Than Block-Size Key - Hash Key First", want384_1, want512_1) {
        return false
    }
    true
}

// The core test body measures only the work charge: the weight 1 and one step per
// started 256 bytes, so one and eight bytes each take two steps.
fn secret_hmac_sha256_steps() -> bool {
    let key = repeated_key(0x0b, 20)
    let short = b"x"
    let long = b"Hi There"
    let expected = b"\xb0\x34\x4c\x61\xd8\xdb\x38\x53\x5c\xa8\xaf\xce\xaf\x0b\xf1\x2b\x88\x1d\xc2\x00\xc9\x83\x3d\xa7\x26\xe9\x37\x6c\x2e\x32\xcf\xf7"
    let short_fits = bound steps 2 {
        secret.hmac_sha256(key, short)
    }
    let long_refused = bound steps 1 {
        secret.hmac_sha256(key, long)
    }
    let long_fits = bound steps 2 {
        secret.hmac_sha256(key, long)
    }
    let verify_refused = bound steps 1 {
        secret.verify_hmac_sha256(key, long, expected)
    }
    let verify_fits = bound steps 2 {
        secret.verify_hmac_sha256(key, long, expected)
    }
    match (short_fits, long_refused, long_fits, verify_refused, verify_fits) {
        (Ok(Ok(_)), Error(time), Ok(Ok(_)), Error(verify_time), Ok(Ok(true))) => time.steps == 1 && verify_time.steps == 1,
        _ => false,
    }
}

// expect: run secret_hmac_law() = 0
fn secret_hmac_law() -> u64 {
    let authority = secret_mac_authority()
    if authority != 0 {
        return authority
    }
    if !secret_hmac_vectors() {
        return 7
    }
    if !secret_hmac_sha256_steps() {
        return 8
    }
    if !secret_hmac_sha1_vectors() {
        return 9
    }
    0
}

// `appended` appends of 48 bytes in a Tiered Log whose tree the cut emits Cold.
fn l87_cold_log(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64, appended: u64, width: u64) -> Result[Log[Bytes], Error] waits {
    l87_cold_log_padded(d, c, r, tasks, floor, appended, width, false)
}

// With `padded`, the schema also declares the Memory table "padding": a store
// holding a Tiered collection refuses any later Migrate (§13.10).
fn l87_cold_log_padded(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64, appended: u64, width: u64, padded: bool) -> Result[Log[Bytes], Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let mut declaring = declare(db, Migrate)?
    let events = declare_log(mut declaring, "events", std.codec.of_bytes())?
    if padded {
        let padding = declare_table(mut declaring, "padding", std.codec.key_u64(), std.codec.of_bytes())?
        let _ = finish(mut declaring, take padding)?
    }
    let _ = seal(mut db, take declaring)?
    let fixture: Log[Bytes] = clone(events)
    let Committed(_) = run(mut db, None, copy_env((fixture, appended, width)), fn(mut tx: Tx, env: (Log[Bytes], u64, u64)) -> Result[(), Error] {
        for seq in 0u64 .. env.1 {
            let mut body: Bytes = list.with_capacity(env.2)
            list.fill(mut body, env.2, int.truncate(seq))
            let _ = append(mut tx, env.0, body)?
        }
        Ok(())
    })? else {
        fail("L87: fixture appends did not commit")
    }
    let id = prefix(events.binding.id)?
    let mut tree = share_page_tree(db.heads[0u64].roots.collections)
    let (take root, take descriptor) = {
        let Some((here, before)) = std.page.collection_entry(tree.root, id) else {
            fail("L87: the fixture has no Log")
        }
        let limits = descriptor_bounds(before)
        (arc.share(here), log_record(here, limits.first, limits.next, 1)?)
    }
    if std.page.level(std.page.image_of(root)) == 0 {
        fail("L87: the fixture Log must span more than one leaf")
    }
    let mut draw = stamp_after(db.next_node)?
    let first = draw
    page_result(std.page.insert(mut tree.root, id, descriptor, Some(arc.share(root)), tree.inline, first, mut draw))?
    page_result(std.page.install_tiered_root(mut tree.root, id, HotPage(take root), mut draw))?
    db.heads[0u64].roots.collections = take tree
    db.next_node = draw - 1
    let _ = checkpoint(mut db)?
    close(take db)?
    Ok(events)
}

// The Cold root's first child, read from its class-3 pack: the leaf a floor
// past that child's last row detaches, and the floor that does it.
fn l87_first_leaf(d: Dir, db: Db, collection: u32) -> Result[(std.page.PagePtr, u64), Error] waits {
    let id = prefix(collection)?
    let Some((ColdPage(root), _)) = std.page.collection_slot(db.heads[0u64].roots.collections.root, id) else {
        fail("L87: the cut must leave the Log root Cold")
    }
    let path = paged_pack_path(root.pack)?
    let wire = disk_read_file(d, path, 1048576)?
    let frame = read_tiered_frame(path, db.store, TieredPage(root), wire, 0, stamp_after(db.next_node)?)?
    let page = fold_page(frame)
    let Some(ColdPage(leaf)) = std.page.child_slot(page, 0) else {
        fail("L87: the root's first child is a Cold leaf")
    }
    let Some(separator) = std.page.key_at(std.page.image_of(page), 1) else {
        fail("L87: the root has a second child")
    }
    let following: u64 = list.word_be(separator, 0)
    Ok((leaf, following + 1))
}

fn l87_queue(db: Db) -> Result[List[(u64, DeferredFree)], Error] {
    let lists = disk_state(db).pages.lists
    let mut rows: List[(u64, DeferredFree)] = list.new()
    let mut cursor = std.page.cursor_open(arc.share(lists.deferred), None, true, false)
    while let Some(row) = std.page.cursor_next(mut cursor) {
        let seq: u64 = list.word_be(row.key, 0)
        let owner: u32 = list.word_le(row.value, 1)
        let target = if row.value[0u64] == 0 {
            TieredPage(std.page.decode_ptr(list.slice(row.value, 5, 41)) ?=> |_| Missing("L87 queued Page row"))
        } else {
            TieredBlob(std.page.decode_ref(list.slice(row.value, 5, 47)) ?=> |_| Missing("L87 queued Blob row"))
        }
        list.push(mut rows, (seq, DeferredFree(branch_id: owner, target: take target)))
    }
    Ok(take rows)
}

fn l87_options(floor: u64, budget: u64) -> Result[Options, Error] {
    let mut options = l70_open_options(floor)?
    options.free_budget = budget
    // These laws count each pack's live bytes across cuts; compaction,
    // proved by L88 (h), would retire the packs they watch.
    options.probe_budget = 0
    Ok(take options)
}

// L87 (a) through the cut (§13.6a T8 step 3): a journaled floor reopens as
// a replay overlay; the fold cut detaches the whole first Cold leaf without
// reading it and queues exactly that location for main. A second, idle cut
// carries the queue unchanged, and a reopen reads it back from the MANIFEST.
@test
fn test_l87_fold_cut_queues_detached_leaf(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let events = l87_cold_log(d, c, r, tasks, floor, 120, 48)?
    let mut cold = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let (leaf, trim) = l87_first_leaf(d, cold, events.binding.id)?
    let Committed(_) = run(mut cold, Some(100000), copy_env((events, trim)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87: the served trim of a Cold Tiered Log commits")
    }
    close(take cold)?

    let mut replayed = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let _ = checkpoint(mut replayed)?
    let _ = checkpoint(mut replayed)?
    close(take replayed)?

    let reopened = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let queued = l87_queue(reopened)?
    if list.len(queued) != 1 || disk_state(reopened).pages.lists.deferred_next != 1 {
        fail("L87: the fold queues one detached subtree")
    }
    let (seq, row) = queued[0u64]
    let TieredPage(queued_leaf) = row.target else {
        fail("L87: a detached leaf is queued as a Page row")
    }
    if seq != 0 || row.branch_id != 0 || queued_leaf != leaf {
        fail("L87: the queue names main's detached Cold leaf at its exact location")
    }
    close(take reopened)
}

// §13.5 steps 2 then 3 inside §13.6a's mandatory candidate: the queue's
// added rows (candidate step 3) form before any promotion (step 4), so a
// pin's materialization adds no row. The fold cut queues main's detached
// leaf once. Pinning a Snapshot captured before that cut, whose overlay
// detaches the same leaf, leaves exactly that row, before and after reopen,
// and the pin reads only the rows at or above the floor.
@test
fn test_l87_pin_materialization_adds_no_queue_row(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let appended = 120u64
    let events = l87_cold_log(d, c, r, tasks, floor, appended, 48)?
    let mut cold = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let (leaf, trim) = l87_first_leaf(d, cold, events.binding.id)?
    let trimmed: Log[Bytes] = clone(events)
    let Committed(_) = run(mut cold, Some(100000), copy_env((trimmed, trim)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87: the served trim of a Cold Tiered Log commits")
    }
    close(take cold)?
    let mut db = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let s = snapshot(db)
    let _ = checkpoint(mut db)?
    pin(mut db, "history", s)?
    for round in 0u64 .. 2 {
        let queued = l87_queue(db)?
        if list.len(queued) != 1 || disk_state(db).pages.lists.deferred_next != 1 {
            fail("L87: a pin's materialization adds no queue row")
        }
        let (seq, row) = queued[0u64]
        let TieredPage(queued_leaf) = row.target else {
            fail("L87: a detached leaf is queued as a Page row")
        }
        if seq != 0 || row.branch_id != 0 || queued_leaf != leaf {
            fail("L87: the queue names main's detached Cold leaf once")
        }
        let Some(held) = pinned(db, "history") else {
            fail("L87: the pin is published")
        }
        let read_handle = reader(db, VALUE_LIMIT + 1048576)?
        for at in 0u64 .. appended {
            let expected: Option[Bytes] = if at < trim {
                None
            } else {
                let mut body: Bytes = list.with_capacity(48)
                list.fill(mut body, 48, int.truncate(at))
                Some(take body)
            }
            let got = log_get(read_handle, held, events, at)?
            if got != expected {
                fail("L87: the pin reads its Snapshot's overlay")
            }
        }
        drop(take read_handle)
        drop(take held)
        if round == 0 {
            close(take db)?
            db = open(tasks, d, c, r, l87_options(floor, 0)?)?
        }
    }
    close(take db)
}

// L87 (a) on the live path (§13.6a T8 step 3, §13.8 dropped list): a
// served trim past the first Cold leaf queues that leaf at the next cut.
// A whole-Log trim after a fresh open loses the Cold root and every leaf;
// each lost frame lands in exactly one of the replaced and dropped lists,
// and the leaves no read reached are queued in order (2207 #1).
@test
fn test_l87_live_trims_queue_detached_subtrees(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let appended = 400u64
    let events = l87_cold_log(d, c, r, tasks, floor, appended, 48)?
    let mut db = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let collection = events.binding.id
    let (leaf, trim) = l87_first_leaf(d, db, collection)?
    let first_events: Log[Bytes] = clone(events)
    let Committed(_) = run(mut db, Some(100000), copy_env((first_events, trim)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87: the served trim of a Cold Tiered Log commits")
    }
    let _ = checkpoint(mut db)?
    let id = prefix(collection)?
    let root = match std.page.collection_slot(db.heads[0u64].roots.collections.root, id) {
        Some((ColdPage(located), _)) => located,
        _ => fail("L87: the cut leaves the trimmed Log root Cold"),
    }
    let mut detached: List[std.page.PagePtr] = list.new()
    list.push(mut detached, root)
    {
        let path = paged_pack_path(root.pack)?
        let wire = disk_read_file(d, path, 1048576)?
        let frame = read_tiered_frame(path, db.store, TieredPage(root), wire, 0, stamp_after(db.next_node)?)?
        let page = fold_page(frame)
        let image = std.page.image_of(page)
        if std.page.level(image) != 1 || std.page.count(image) < 3 {
            fail("L87: the trimmed root keeps at least three Cold leaves")
        }
        for slot in 0u64 .. std.page.count(image) {
            let Some(ColdPage(child)) = std.page.child_slot(page, slot) else {
                fail("L87: the cut leaves every leaf Cold")
            }
            list.push(mut detached, child)
        }
    }
    close(take db)?
    db = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let Committed(_) = run(mut db, Some(100000), copy_env((events, appended)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87: the whole-Log trim commits")
    }
    let mut dropped: List[std.page.PagePtr] = list.new()
    let mut lost = 0u64
    for frames in disk_state(db).tiered_dirty.replaced {
        for frame in frames.frames {
            lost += 1
            let mut hits = 0u64
            for ptr in detached {
                if ptr.pack == frame.pack && ptr.stamp == frame.stamp && ptr.len == frame.len {
                    hits += 1
                }
            }
            if hits != 1 {
                fail("L87: each replaced frame is one detached page")
            }
        }
    }
    for row in disk_state(db).tiered_dirty.dropped {
        let TieredPage(ptr) = row.target else {
            fail("L87: a Log trim drops pages only")
        }
        if row.branch_id != 0 {
            fail("L87: the dropped row names main")
        }
        lost += 1
        list.push(mut dropped, ptr)
    }
    if lost != list.len(detached) || list.len(dropped) == 0 {
        fail("L87: every detached page is replaced or dropped once, and an unread leaf is dropped")
    }
    for ptr in detached {
        let mut hits = 0u64
        for frames in disk_state(db).tiered_dirty.replaced {
            for frame in frames.frames {
                if ptr.pack == frame.pack && ptr.stamp == frame.stamp && ptr.len == frame.len {
                    hits += 1
                }
            }
        }
        for other in dropped {
            if other == ptr {
                hits += 1
            }
        }
        if hits != 1 {
            fail("L87: each detached page lands in exactly one list")
        }
    }
    let _ = checkpoint(mut db)?
    close(take db)?

    let reopened = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let queued = l87_queue(reopened)?
    let expected = 1 + list.len(dropped)
    if list.len(queued) != expected || disk_state(reopened).pages.lists.deferred_next != expected {
        fail("L87: the queue holds the first leaf and every dropped page")
    }
    for at in 0u64 .. expected {
        let (seq, row) = queued[at]
        let TieredPage(target) = row.target else {
            fail("L87: detached subtrees are queued as Page rows")
        }
        let wanted = if at == 0 { leaf } else { dropped[at - 1] }
        if seq != at || row.branch_id != 0 || target != wanted {
            fail("L87: the queue names each detached Cold page in order at its exact location")
        }
    }
    close(take reopened)
}

// L87 drain (§13.6 "Deferred frees", §13.6a T8 step 4). Each 1,100-byte body
// is a class-4 BLOB. A whole-Log trim after a reopen loses the Cold root, every
// leaf and every blob. With `free_budget` 1, each cut drains exactly one
// queued page, oldest first, and files it dead on main; a drained leaf queues
// its blobs at the end, and a blob row reads no frame. After every cut, each
// pack's `live` is its laid-out payload less each lost frame that no queue row
// still names. After the last drain the queue reopens empty.
@test
fn test_l87_cuts_drain_queued_pages(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let appended = 400u64
    let events = l87_cold_log(d, c, r, tasks, floor, appended, 1100)?
    let mut db = open(tasks, d, c, r, l87_options(floor, 1)?)?
    let root = l69_cold_root(db, events.binding.id)?
    let mut pages: List[std.page.PagePtr] = list.new()
    let mut blobs: List[(std.page.PagePtr, std.page.BlobRef)] = list.new()
    list.push(mut pages, root)
    let mut walk = 0u64
    while walk < list.len(pages) {
        let ptr = pages[walk]
        walk += 1
        let path = paged_pack_path(ptr.pack)?
        let wire = disk_read_file(d, path, 4194304)?
        let frame = read_tiered_frame(path, db.store, TieredPage(ptr), wire, 0, stamp_after(db.next_node)?)?
        let page = fold_page(frame)
        let image = std.page.image_of(page)
        for slot in 0u64 .. std.page.count(image) {
            match std.page.owning_edge(image, slot) {
                Some(PageEdge(child)) => list.push(mut pages, child),
                Some(BlobEdge(body)) => list.push(mut blobs, (ptr, body)),
                None => fail("L87: every fixture row is a blob"),
            }
        }
    }
    if list.len(blobs) != appended {
        fail("L87: each body is a Cold blob")
    }
    let mut page_total = 0u64
    for ptr in pages {
        if ptr.pack != root.pack {
            fail("L87: one cut lays the Log's pages out in one class-3 pack")
        }
        page_total += int.widen(ptr.len)
    }
    let blob_pack = blobs[0u64].1.pack
    let mut blob_total = 0u64
    for (_, body) in blobs {
        if body.pack != blob_pack {
            fail("L87: one cut lays the Log's blobs out in one class-4 pack")
        }
        blob_total += 8 + body.len
    }
    let page_laid = l69_pack_live(db, root.pack)
    let blob_laid = l69_pack_live(db, blob_pack)
    let Committed(_) = run(mut db, Some(100000), copy_env((events, appended)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87: the whole-Log trim commits")
    }
    let dropped_rows = list.len(disk_state(db).tiered_dirty.dropped)
    let mut dropped_pages = 0u64
    for row in disk_state(db).tiered_dirty.dropped {
        if let TieredPage(_) = row.target {
            dropped_pages += 1
        }
    }
    let mut cuts = 0u64
    loop {
        let _ = checkpoint(mut db)?
        cuts += 1
        if cuts == 1 {
            close(take db)?
            db = open(tasks, d, c, r, l87_options(floor, 1)?)?
        }
        let queued = l87_queue(db)?
        let mut page_rows = 0u64
        let mut page_kept = 0u64
        let mut blob_kept = 0u64
        for (_, row) in queued {
            let mut hits = 0u64
            match row.target {
                TieredPage(target) => {
                    page_rows += 1
                    page_kept += int.widen(target.len)
                    for ptr in pages {
                        if ptr == target {
                            hits += 1
                        }
                    }
                },
                TieredBlob(target) => {
                    for (_, body) in blobs {
                        if body == target {
                            hits += 1
                        }
                    }
                },
            }
            if hits != 1 || row.branch_id != 0 {
                fail("L87: each queue row names one lost frame of main")
            }
        }
        for (leaf, body) in blobs {
            let mut held = false
            for (_, row) in queued {
                let hit = match row.target {
                    TieredPage(target) => target == leaf,
                    TieredBlob(target) => target == body,
                }
                held = held || hit
            }
            if held {
                blob_kept += 8 + body.len
            }
        }
        if page_rows != int.saturating_sub(dropped_pages, cuts) {
            fail("L87: each cut drains exactly one queued page")
        }
        if l69_pack_live(db, root.pack) != page_laid - (page_total - page_kept) || l69_pack_live(db, blob_pack) != blob_laid - (blob_total - blob_kept) {
            fail("L87: a frame leaves live once, when it is filed or drained")
        }
        if list.len(queued) == 0 {
            break
        }
        if cuts > 2 * list.len(pages) {
            fail("L87: the drain finishes")
        }
    }
    close(take db)?
    let reopened = open(tasks, d, c, r, l87_options(floor, 1)?)?
    if disk_state(reopened).pages.lists.deferred_next <= dropped_rows {
        fail("L87: a drained leaf queues its blobs")
    }
    if list.len(l87_queue(reopened)?) != 0 || l69_pack_live(reopened, root.pack) != page_laid - page_total || l69_pack_live(reopened, blob_pack) != blob_laid - blob_total {
        fail("L87: the drained queue and both packs' live reopen")
    }
    close(take reopened)
}

// §13.8's list charges: 24 bytes per replaced row and one 48-byte slot per
// dropped row, against `dirty_bytes`. A refused commit changes neither list.
@test
fn test_l70_dirty_admission() -> Result[(), ()] {
    let mut dirty = clean_tiered_cut()
    let one = std.page.PagePtr(pack: 12, offset: 72, len: 72, checksum: 102, stamp: 2)
    let two = std.page.BlobRef(stamp: 1, len: 1025, checksum: 101, pack: 11, offset: 72, body: 0)
    let three = std.page.PagePtr(pack: 12, offset: 160, len: 80, checksum: 103, stamp: 3)
    let mut edited: List[ReplacedFrame] = list.new()
    list.push(mut edited, replaced_page(one))
    list.push(mut edited, replaced_blob(two))
    let mut detached: List[TieredTarget] = list.new()
    list.push(mut detached, TieredPage(three))
    // 2 × 24 + 1 × 48 = 96.
    let first = TieredFreed(replaced: take edited, dropped: take detached)
    if let Error(_) = reserve_tiered_commit(mut dirty, first, 200) {
        return Error(())
    }
    admit_tiered_commit(mut dirty, 7, take first)
    // 2 × 24 + 3 × 48 = 192.
    let mut blobs: List[TieredTarget] = list.new()
    list.push(mut blobs, TieredBlob(two))
    list.push(mut blobs, TieredBlob(std.page.BlobRef(stamp: 4, len: 900, checksum: 104, pack: 11, offset: 1120, body: 0)))
    let second = TieredFreed(replaced: list.new(), dropped: take blobs)
    if let Error(_) = reserve_tiered_commit(mut dirty, second, 200) {
        return Error(())
    }
    admit_tiered_commit(mut dirty, 8, take second)
    // 3 × 24 + 3 × 48 = 216 > 200.
    let mut more: List[ReplacedFrame] = list.new()
    list.push(mut more, replaced_page(three))
    let third = TieredFreed(replaced: take more, dropped: list.new())
    let Error(Full(Resident(refused))) = reserve_tiered_commit(mut dirty, third, 200) else {
        return Error(())
    }
    if refused.requested != 216 || refused.available != 200 {
        return Error(())
    }
    if list.len(dirty.replaced) != 1 || dirty.replaced_rows != 2 || list.len(dirty.dropped) != 3 {
        return Error(())
    }
    let published = view dirty.replaced[0u64]
    if published.branch != 7 || list.len(published.frames) != 2 || published.frames[0u64] != ReplacedFrame(pack: 12, len: 72, stamp: 2) || published.frames[1u64] != ReplacedFrame(pack: 11, len: 1033, stamp: 1) {
        return Error(())
    }
    if dirty.dropped[0u64].branch_id != 7 || dirty.dropped[1u64].branch_id != 8 || dirty.dropped[2u64].branch_id != 8 {
        return Error(())
    }
    Ok(())
}

fn l87_snapshot_root(s: Snapshot, collection: u32) -> Result[std.page.PagePtr, Error] {
    match std.page.collection_slot(s.roots.collections.root, prefix(collection)?) {
        Some((ColdPage(located), _)) => Ok(located),
        _ => fail("L87 (e2): a cut leaves every published root Cold"),
    }
}

// The class-3 frames a root reaches outside pack `old`, and their payload.
fn l87_fresh_frames(d: Dir, db: Db, root: std.page.PagePtr, old: u64) -> Result[(u64, u64), Error] waits {
    let walk = compact_walk_from(d, db, root)?
    let mut fresh_pack = 0u64
    let mut payload_total = 0u64
    for (seq, payload) in walk.live {
        if seq == old {
            continue
        }
        if fresh_pack != 0 {
            fail("L87 (e2): one cut emits a materialization into one pack")
        }
        fresh_pack = seq
        payload_total = payload
    }
    if fresh_pack == 0 {
        fail("L87 (e2): a materialization writes fresh pages")
    }
    Ok((fresh_pack, payload_total))
}

fn l87_edit_on(mut db: Db, rows: Table[u64, Bytes], id: u32, edit: u8) -> Result[(), Error] waits {
    let fixture: Table[u64, Bytes] = clone(rows)
    let target = Branch(store: db.store, id)
    let Committed(_) = run_on(mut db, target, Some(100000000), copy_env((fixture, edit)), fn(mut tx: Tx, env: (Table[u64, Bytes], u8)) -> Result[(), Error] {
        put(mut tx, env.0, 0, compact_value_of(0, env.1, 48))
    })? else {
        fail("L87 (e2): the edit of row 0 commits")
    }
    Ok(())
}

fn l87_reads_row(db: Db, s: Snapshot, rows: Table[u64, Bytes], edit: u8) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    for key in 0u64 .. 160 {
        let wanted = compact_value_of(key, if key == 0 {
            edit
        } else {
            0u8
        }, 48)
        if get(read_handle, s, rows, key)? != Some(wanted) {
            fail("L87 (e2): each holder reads its own row 0 and the shared rows")
        }
    }
    drop(take read_handle)
    Ok(())
}

// L87 (e2), one materialization per promoted holder (§13.5 step 3, v2.93).
// Row 0's edit 1 reopens as a replay overlay over the Cold table in pack 7,
// and S is captured before the fold cut. pin(S), then the cut-path fork
// `beta` of S, each materialize S's overlay into fresh pages of their own
// pack: q1 for the pin and q2 for `beta`, with `live` = the pages laid out.
// Neither files anything in pack 7, whose replaced path main's fold already
// filed. `beta` then edits row 0 again, and the next cut files `beta`'s kill
// of its own pages dead: `live[q2]` = 0, while `live[q1]` and `live[7]` stay
// unchanged and the pin still reads edit 1, before and after reopen. Seeded
// bug `reuse_materialization`: `beta` shares the pin's pages, so its kill
// lowers `live[q1]`. Last, `gamma` forks the pin's own Snapshot and edits
// row 0: its kill of the pin's pages leaves `live[q1]` (§13.6 "Holders",
// v2.105). Seeded bug `pin_keeps_capture_watermark`: the pin's pages sit at
// or above `gamma`'s origin, so they count as its own and `live[q1]` drops.
@test
fn test_l87_each_promoted_holder_materializes_once(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let rows = compact_cold_table_of(d, c, r, tasks, floor, 160, 48)?
    let mut cold = open(tasks, d, c, r, l69_options(floor)?)?
    let original = l69_cold_root(cold, rows.id)?.pack
    l87_edit_on(mut cold, rows, 0, 1)?
    close(take cold)?
    let mut db = open(tasks, d, c, r, l69_options(floor)?)?
    let s = snapshot(db)
    let _ = checkpoint(mut db)?
    let old_live = l69_pack_live(db, original)
    let _ = pin(mut db, "history", s)?
    let Some(held) = pinned(db, "history") else {
        fail("L87 (e2): the pin is published")
    }
    let (pin_pack, pin_bytes) = l87_fresh_frames(d, db, l87_snapshot_root(held, rows.id)?, original)?
    drop(take held)
    if l69_pack_live(db, pin_pack) != pin_bytes || l69_pack_live(db, original) != old_live {
        fail("L87 (e2): the pin's materialization is its own pack's live, and files nothing in pack 7")
    }
    let (beta, _) = fork(mut db, "beta", s)?
    drop(take s)
    let forked = snapshot_of(db, beta)?
    let (beta_pack, beta_bytes) = l87_fresh_frames(d, db, l87_snapshot_root(forked, rows.id)?, original)?
    drop(take forked)
    if beta_pack == pin_pack || l69_pack_live(db, beta_pack) != beta_bytes || l69_pack_live(db, pin_pack) != pin_bytes || l69_pack_live(db, original) != old_live {
        fail("L87 (e2): the fork materializes again into its own pack")
    }
    l87_edit_on(mut db, rows, beta.id, 2)?
    let _ = checkpoint(mut db)?
    for round in 0u64 .. 2 {
        if l69_pack_live(db, beta_pack) != 0 || l69_pack_live(db, pin_pack) != pin_bytes || l69_pack_live(db, original) != old_live {
            fail("L87 (e2): the fork's kill lowers only its own pack's live")
        }
        let Some(history) = pinned(db, "history") else {
            fail("L87 (e2): the pin is published")
        }
        l87_reads_row(db, history, rows, 1)?
        drop(take history)
        let edited = snapshot_of(db, beta)?
        l87_reads_row(db, edited, rows, 2)?
        drop(take edited)
        let main = snapshot(db)
        l87_reads_row(db, main, rows, 1)?
        drop(take main)
        if round == 0 {
            close(take db)?
            db = open(tasks, d, c, r, l69_options(floor)?)?
        }
    }
    // A fork of the pin's own Snapshot reaches pages of stamp ≥ the pin's
    // watermark that the pin alone owns (§13.6 "Holders"). `gamma`'s kill of
    // them must not leave `live[q1]` while the pin still reads them.
    let Some(history) = pinned(db, "history") else {
        fail("L87 (e2): the pin is published")
    }
    let (gamma, _) = fork(mut db, "gamma", history)?
    l87_edit_on(mut db, rows, gamma.id, 3)?
    let _ = checkpoint(mut db)?
    if l69_pack_live(db, pin_pack) != pin_bytes {
        fail("L87 (e2): a fork of the pin never kills the pin's own pages")
    }
    let Some(kept) = pinned(db, "history") else {
        fail("L87 (e2): the pin is published")
    }
    l87_reads_row(db, kept, rows, 1)?
    drop(take kept)
    let edited = snapshot_of(db, gamma)?
    l87_reads_row(db, edited, rows, 3)?
    drop(take edited)
    close(take db)
}

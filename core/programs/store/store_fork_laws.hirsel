// I4: each 12-byte key and 8-byte value charges 62 + 16 + 8 = 86.
// The 126-byte collection descriptor stays live. After deletion the pin
// keeps its 86-byte row, so another row needs 298 of the available 216.
pub fn law_pinned_delete(c: Clock) -> bool waits {
    let mut db = raw_test_db(c, 216)
    if !put_one(mut db, 1, 10) {
        return false
    }
    let first = snapshot(db)
    let _ = result.unwrap(pin(mut db, "p", first))
    let removed = result.unwrap(run(mut db, None, (), fn(mut tx, unused_env) -> Result[bool, Error] {
        delete_bytes(mut tx, 1, key_word(1))
    }))
    match take removed {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    let after_delete = version(snapshot(db))
    let inserted = result.unwrap(run(mut db, None, (), fn(mut tx, unused_env) -> Result[(), Error] {
        put_bytes(mut tx, 1, key_word(2), key_word(20))
    }))
    match take inserted {
        Refused(Resident(cap)) => if cap.requested != 298 || cap.available != 216 {
            return false
        },
        _ => return false
    }
    let head = snapshot(db)
    if version(head) != after_delete || value_at(head, 1) != 0 || value_at(head, 2) != 0 {
        return false
    }
    match pinned(db, "p") {
        Some(held) => if value_at(held, 1) != 10 {
            return false
        },
        None => return false
    }
    let _ = result.unwrap(unpin(mut db, "p"))
    put_one(mut db, 2, 20) && value_at(snapshot(db), 2) == 20
}

@test
fn test_pinned_delete(c: Clock) -> Result[(), ()] waits {
    if law_pinned_delete(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn mark_is(t: Ticket, n: u64) -> bool {
    match t.mark {
        Journal(m, _, _) => m == n,
        Cut(_) => false
    }
}

// (position, state) of a stream on main, or (0, 0) when it has none.
fn stream_now(db: Db, name: Bytes) -> (u64, u64) {
    match get_page_row(db.heads[0].roots.streams, name) {
        Some(raw) => (read_le(raw, 0, 8), int.widen(raw[40])),
        None => (0, 0)
    }
}

fn stream_reply_is(db: Db, name: Bytes, want: Bytes) -> bool {
    match get_page_row(db.heads[0].roots.streams, name) {
        Some(raw) => list.len(raw) >= 41 && list.slice(raw, 41, list.len(raw)) == want,
        None => false
    }
}

fn call_for(stream: Bytes, revision: u64) -> CallRecord {
    let mut key: Bytes = list.new()
    list.fill(mut key, 32, 1u8)
    let mut args: Bytes = list.new()
    list.fill(mut args, 16, 2u8)
    let mut r: Bytes = list.new()
    list.fill(mut r, revision, 3u8)
    CallRecord(key: take key, args: take args, stream: option.unwrap(parse_stream_key(stream)), revision: Some(take r), code: code_vector())
}

// The digest of a request with call_for's entry key and these args.
fn digest_for(args: String) -> RequestDigest {
    let mut key: Bytes = list.new()
    list.fill(mut key, 32, 1u8)
    request_digest(key, string.as_bytes(args))
}

fn missing_is(r: Result[(), Error], name: String) -> bool {
    match r {
        Error(Missing(n)) => n == name,
        _ => false
    }
}

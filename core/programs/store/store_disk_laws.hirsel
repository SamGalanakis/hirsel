fn disk_session_close(take session: DiskSession) -> Result[(), Error] waits {
    let DiskSession(lock: take lock, startup: _) = take session
    disk_io(host.close(take lock))
}

type WaitedLock: send {
    d: Dir,
    clock: Clock
}

fn wait_lock(take waiting: WaitedLock) -> bool waits {
    match disk_lock(waiting.d, waiting.clock, 1000u64) {
        Ok(take held) => {
            let _ = take held;
            true
        },
        Error(_) => false,
    }
}

// L19/L21 bootstrap: create=false is NotFound and releases LOCK; a live
// opener excludes another, close and drop release it, identity survives and
// every successful reopen has a distinct segment/open number.
pub fn disk_law_opening(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 1048576
    options.pack_bytes = 512
    options.create = false
    match disk_session(d, c, r, options) {
        Error(NotFound) => {},
        _ => return false
    }
    options.create = true
    let first = result.unwrap(disk_session(d, c, r, options))
    let id = first.startup.store
    if first.startup.seq != 1 || first.startup.state.tips[0].head != 0 || first.startup.next_node != 0 || first.startup.next_table != 1 {
        return false
    }
    match disk_session(d, c, r, options) {
        Error(Held) => {},
        _ => return false
    }
    result.unwrap(disk_session_close(take first))
    let second = result.unwrap(disk_session(d, c, r, options))
    if second.startup.seq != 2 || !same(second.startup.store, id) {
        return false
    }
    result.unwrap(disk_session_close(take second))
    {
        let third = result.unwrap(disk_session(d, c, r, options))
        if third.startup.seq != 3 || !same(third.startup.store, id) {
            return false
        }
    }
    let fourth = result.unwrap(disk_session(d, c, r, options))
    let good = fourth.startup.seq == 4 && same(fourth.startup.store, id)
    result.unwrap(disk_session_close(take fourth))
    if !good {
        return false
    }
    {
        let held = result.unwrap(disk_lock(d, c, 0u64))
        let waiting = task.spawn(tasks, bytes 16384, WaitedLock(d: d, clock: c), wait_lock)
        host.sleep_until(c, std.clock.deadline_after_ms(host.mono_ns(c), 20u64))
        let _ = take held
        if !result.unwrap(task.join(take waiting)) {
            return false
        }
    }
    let mut too_new = page_manifest_empty()
    too_new.fence = 2
    result.unwrap(disk_publish_manifest(d, id, too_new))
    let left: Bytes = list.new()
    result.unwrap(disk_write_synced(d, "MANIFEST.tmp", left))
    match open(tasks, d, c, r, options) {
        Error(Unsupported(0x0070)) => {},
        _ => return false
    }
    if !result.unwrap(disk_exists(d, "MANIFEST.tmp")) {
        return false
    }
    // AP21 rejects the corrupt list before removing any file.
    let mut damaged = page_manifest_empty()
    damaged.next_pack = 2
    damaged.next_stamp = 2
    damaged.pack_root = std.page.PagePtr(pack: 1, offset: 72, len: 60, checksum: 0, stamp: 1)
    result.unwrap(disk_publish_manifest(d, id, damaged))
    let empty: Bytes = list.new()
    result.unwrap(disk_write_synced(d, "p-1", empty))
    result.unwrap(disk_write_synced(d, "p-2", empty))
    result.unwrap(disk_write_synced(d, "MANIFEST.tmp", empty))
    match disk_session(d, c, r, options) {
        Error(Corrupt(_)) => {},
        _ => return false
    }
    result.unwrap(disk_exists(d, "p-2")) && result.unwrap(disk_exists(d, "MANIFEST.tmp"))
}

@test
fn disk_test_opening(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_opening(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

@test
fn journal_test_floor() -> Result[(), ()] {
    let Some(short) = journal_floor(67108864, 83886159) else {
        return Error(())
    }
    if short.requested != 83886160 || short.available != 83886159 {
        return Error(())
    }
    if let Some(_) = journal_floor(67108864, 83886160) {
        return Error(())
    }
    if let Some(_) = journal_floor(18446744073692774319, 18446744073709551615) {
        return Error(())
    }
    let Some(overflow) = journal_floor(18446744073692774320, 18446744073709551615) else {
        return Error(())
    }
    if overflow.requested != 18446744073709551615 || overflow.available != 18446744073709551615 {
        return Error(())
    }
    Ok(())
}

@test
fn journal_test_cap_arithmetic() -> Result[(), ()] {
    if let Some(_) = journal_refusal(4096, FRAME_LIMIT, 16781392) {
        return Error(())
    }
    let Some(full) = journal_refusal(16781392, 59, 16781392) else {
        return Error(())
    }
    if full.requested != 16781451 || full.available != 16781392 {
        return Error(())
    }
    let Some(lowered) = journal_refusal(16781392, 59, 16781391) else {
        return Error(())
    }
    if lowered.requested != 16781451 || lowered.available != 16781391 {
        return Error(())
    }
    let Some(overflow) = journal_refusal(18446744073709551605, 59, 18446744073709551615) else {
        return Error(())
    }
    if overflow.requested != 18446744073709551615 || overflow.available != 18446744073709551615 {
        return Error(())
    }
    Ok(())
}

// L30(a) on disk: AA1's trace, then b's v3 (k5 = 555) as a journal frame
// after the last cut. Reopen gives main v2 with A and no k5, b v3, c with
// parent b at 2, and adopt(c) still Diverged. Wrong implementations caught: a
// COMMIT that names main (replay puts k5 on main); a cut that writes only
// main (b and c are lost, and b's frame is a Gap).
// I4 on disk: law_pin_settle's 448 and 542 byte figures also alternate at a
// 544 byte limit. Each settle is a cut that rotates the segment, so the
// staged frame needs the new binding. Reopen recovers the last value and an
// exact account of 448. With the old binding, reopen drops the frame as a
// torn tail.
pub fn disk_law_branches(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = view t
    let at_one = snapshot(db)
    let (b, _) = result.unwrap(fork(mut db, "b", at_one))
    if !typed_put(mut db, t, 1, 100) {
        return false
    }
    let on_b = result.unwrap(run_on(mut db, b, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 1, 200)
    }))
    match take on_b {
        Committed(_) => {},
        _ => return false
    }
    let at_b_two = result.unwrap(snapshot_of(db, b))
    let (cb, _) = result.unwrap(fork(mut db, "c", at_b_two))
    match adopt(mut db, cb) {
        Error(Diverged(_)) => {},
        _ => return false
    }
    let late = result.unwrap(run_on(mut db, b, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 5, 555)
    }))
    match take late {
        Committed(done) => result.unwrap(durable(mut db, done.ticket)),
        _ => return false
    }
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    let main_now = snapshot(reopened)
    if version(main_now) != 2 || result.unwrap(get(result.unwrap(reader(reopened, 0u64)), main_now, sh, 1)) != Some(100u64) || result.unwrap(get(result.unwrap(reader(reopened, 0u64)), main_now, sh, 5)) != None {
        return false
    }
    let again_b = match branch(reopened, "b") {
        Some(x) => x,
        None => return false
    }
    let at_b = result.unwrap(snapshot_of(reopened, again_b))
    if again_b.id != 1 || version(at_b) != 3 || result.unwrap(get(result.unwrap(reader(reopened, 0u64)), at_b, sh, 1)) != Some(200u64) || result.unwrap(get(result.unwrap(reader(reopened, 0u64)), at_b, sh, 5)) != Some(555u64) {
        return false
    }
    let again_c = match branch(reopened, "c") {
        Some(x) => x,
        None => return false
    }
    let at_c = result.unwrap(snapshot_of(reopened, again_c))
    if again_c.id != 2 || version(at_c) != 2 || reopened.heads[2].parent != 1 || reopened.heads[2].forked_at != 2 {
        return false
    }
    match adopt(mut reopened, again_c) {
        Error(Diverged(_)) => {},
        _ => return false
    }
    result.unwrap(close(take reopened))
    let settle_dir = disk_test_directory(d)
    options.resident_limit = 544
    let mut sdb = result.unwrap(open(tasks, settle_dir, c, r, options))
    result.unwrap(law_table(mut sdb, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let st = result.unwrap(table(mut sdb, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut sdb, st, 1, 1) {
        return false
    }
    let first = Ticket(store: sdb.store, open: open_number(sdb), mark: Journal(sdb.frame_seq, 0, 0))
    result.unwrap(durable(mut sdb, first))
    let first_snap = snapshot(sdb)
    let _ = result.unwrap(pin(mut sdb, "p", first_snap))
    if sdb.resident != 354 {
        return false
    }
    for operation in 0u64 .. 20 {
        let committed = result.unwrap(run(mut sdb, None, (copy_env(st), copy_env(operation)), fn(mut tx, call_env) -> Result[(), Error] {
            put(mut tx, call_env.0, 1, call_env.1 + 2)
        }))
        match take committed {
            Committed(done) => result.unwrap(durable(mut sdb, done.ticket)),
            _ => return false
        }
        if sdb.resident != (if operation % 2 == 0 {
            448u64
        } else {
            542u64
        }) {
            return false
        }
    }
    result.unwrap(close(take sdb))
    let settled_open = result.unwrap(open(tasks, settle_dir, c, r, options))
    let held = match pinned(settled_open, "p") {
        Some(s) => s,
        None => return false
    }
    let good = settled_open.resident == 448 && result.unwrap(get(result.unwrap(reader(settled_open, 0u64)), snapshot(settled_open), st, 1)) == Some(21u64) && result.unwrap(get(result.unwrap(reader(settled_open, 0u64)), held, st, 1)) == Some(1u64)
    result.unwrap(close(take settled_open))
    if !good {
        return false
    }
    match journaled_branch_drop(disk_test_directory(d), c, r, tasks) {
        Ok(()) => true,
        Error(_) => false
    }
}

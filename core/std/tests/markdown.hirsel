// The CommonMark oracle compares the AST's rendering with upstream example HTML.
// This renderer emits raw HTML and is only for the trusted spec fixtures.
fn escape(mut out: String, s: String) {
    let mut at = 0u64
    while let Some((c, next)) = string.next_scalar(s, at) {
        at = next
        match c {
            '&' => string.push(mut out, "&amp;"),
            '<' => string.push(mut out, "&lt;"),
            '>' => string.push(mut out, "&gt;"),
            '"' => string.push(mut out, "&quot;"),
            _ => string.push_char(mut out, c),
        }
    }
}

fn line_ended(out: String) -> bool {
    let b = string.as_bytes(out)
    let n = list.len(b)
    n == 0 || b[n - 1] == 10
}

fn line(mut out: String) {
    if !line_ended(out) {
        string.push_char(mut out, '\n')
    }
}

fn render_children(nodes: List[markdown.Node], first: u64, tight: bool, mut out: String) {
    let mut id = first
    while id != 0 {
        render_node(nodes, id, tight, mut out)
        id = nodes[id].next
    }
}

fn image_alt(nodes: List[markdown.Node], first: u64, mut out: String) {
    let mut child = first
    while child != 0 {
        match nodes[child].kind {
            Text(s) => escape(mut out, s),
            Code(s) => escape(mut out, s),
            SoftBreak => string.push_char(mut out, '\n'),
            HardBreak => string.push_char(mut out, '\n'),
            _ => image_alt(nodes, nodes[child].first, mut out),
        }
        child = nodes[child].next
    }
}

fn title_attr(mut out: String, title: String) {
    if title != "" {
        string.push(mut out, " title=\"")
        escape(mut out, title)
        string.push_char(mut out, '"')
    }
}

fn render_node(nodes: List[markdown.Node], id: u64, tight: bool, mut out: String) {
    let node = nodes[id]
    match node.kind {
        Document => render_children(nodes, node.first, false, mut out),
        Text(s) => escape(mut out, s),
        HtmlInline(s) => string.push(mut out, s),
        HtmlBlock(s) => {
            line(mut out)
            string.push(mut out, s)
            line(mut out)
        },
        Code(s) => {
            string.push(mut out, "<code>")
            escape(mut out, s)
            string.push(mut out, "</code>")
        },
        SoftBreak => string.push_char(mut out, '\n'),
        HardBreak => string.push(mut out, "<br />\n"),
        ThematicBreak => {
            line(mut out)
            string.push(mut out, "<hr />\n")
        },
        Paragraph => {
            if !tight {
                line(mut out)
                string.push(mut out, "<p>")
            }
            render_children(nodes, node.first, false, mut out)
            if !tight {
                string.push(mut out, "</p>\n")
            }
        },
        Heading(level) => {
            line(mut out)
            string.push(mut out, "<h")
            string.push_u64(mut out, level)
            string.push_char(mut out, '>')
            render_children(nodes, node.first, false, mut out)
            string.push(mut out, "</h")
            string.push_u64(mut out, level)
            string.push(mut out, ">\n")
        },
        BlockQuote => {
            line(mut out)
            string.push(mut out, "<blockquote>\n")
            render_children(nodes, node.first, false, mut out)
            line(mut out)
            string.push(mut out, "</blockquote>\n")
        },
        ListBlock(ordered, start, list_tight) => {
            line(mut out)
            if ordered {
                string.push(mut out, "<ol")
                if start != 1 {
                    string.push(mut out, " start=\"")
                    string.push_u64(mut out, start)
                    string.push_char(mut out, '"')
                }
                string.push(mut out, ">\n")
            } else {
                string.push(mut out, "<ul>\n")
            }
            render_children(nodes, node.first, list_tight, mut out)
            line(mut out)
            string.push(mut out, if ordered {
                "</ol>\n"
            } else {
                "</ul>\n"
            })
        },
        Item => {
            string.push(mut out, "<li>")
            render_children(nodes, node.first, tight, mut out)
            string.push(mut out, "</li>\n")
        },
        CodeBlock(s, info) => {
            line(mut out)
            string.push(mut out, "<pre><code")
            let b = string.as_bytes(info)
            let mut end = 0u64
            while end < list.len(b) && b[end] != 9 && b[end] != 10 && b[end] != 12 && b[end] != 13 && b[end] != 32 {
                end += 1
            }
            if end != 0 {
                string.push(mut out, " class=\"language-")
                escape(mut out, string.slice(info, 0, end))
                string.push_char(mut out, '"')
            }
            string.push_char(mut out, '>')
            escape(mut out, s)
            string.push(mut out, "</code></pre>\n")
        },
        Link(dest, title) => {
            string.push(mut out, "<a href=\"")
            escape(mut out, dest)
            string.push_char(mut out, '"')
            title_attr(mut out, title)
            string.push_char(mut out, '>')
            render_children(nodes, node.first, false, mut out)
            string.push(mut out, "</a>")
        },
        Image(dest, title) => {
            string.push(mut out, "<img src=\"")
            escape(mut out, dest)
            string.push(mut out, "\" alt=\"")
            image_alt(nodes, node.first, mut out)
            string.push_char(mut out, '"')
            title_attr(mut out, title)
            string.push(mut out, " />")
        },
        Emphasis => {
            string.push(mut out, "<em>")
            render_children(nodes, node.first, false, mut out)
            string.push(mut out, "</em>")
        },
        Strong => {
            string.push(mut out, "<strong>")
            render_children(nodes, node.first, false, mut out)
            string.push(mut out, "</strong>")
        },
        Wikilink(_, label) => escape(mut out, label),
    }
}

fn test_budget() -> markdown.ParseBudget {
    markdown.ParseBudget(source_bytes: 65536, work_items: 1048576, nesting: 128)
}

fn renders(source: String, html: String) -> bool {
    let Ok(nodes) = markdown.parse(source, CommonMark, test_budget()) else {
        return false
    }
    if !spans_valid(source, nodes) {
        return false
    }
    let mut out = string.new()
    render_node(nodes, 0, false, mut out)
    out == html
}

fn slice_is(source: String, span: markdown.Span, expected: String) -> bool {
    string.slice(source, span.start, span.end) == expected
}

fn wiki_spans() -> bool {
    let source = "# Hé\r\n\r\n[[Té|💡]] and [[Next]]\r\n\r\n## Sub\r\n\r\n# End\r\n"
    let Ok(nodes) = markdown.parse(source, Wiki, test_budget()) else {
        return false
    }
    let heading = nodes[nodes[0].first]
    let paragraph = nodes[heading.next]
    let sub = nodes[paragraph.next]
    let last = nodes[sub.next]
    let wiki = nodes[paragraph.first]
    let other = nodes[nodes[wiki.next].next]
    if let Wikilink(target, label) = wiki.kind {
        if target != "Té" || label != "💡" {
            return false
        }
    } else {
        return false
    }
    if let Wikilink(target, label) = other.kind {
        if target != "Next" || label != "Next" {
            return false
        }
    } else {
        return false
    }
    heading.span == markdown.Span(start: 0, end: 5) && heading.section == Some(markdown.Span(start: 0, end: last.span.start)) && sub.section == Some(markdown.Span(start: sub.span.start, end: last.span.start)) && last.section == Some(markdown.Span(start: last.span.start, end: string.byte_len(source))) && wiki.span == markdown.Span(start: 9, end: 21) && wiki.target == Some(markdown.Span(start: 11, end: 14)) && wiki.label == Some(markdown.Span(start: 15, end: 19)) && slice_is(source, other.span, "[[Next]]") && other.target == Some(markdown.Span(start: 28, end: 32)) && other.label == None
}

fn refuses_nesting(source: String, depth: u64) -> bool {
    let limit = markdown.ParseBudget(source_bytes: 65536, work_items: 1048576, nesting: depth)
    match markdown.parse(source, CommonMark, limit) {
        Error(Nesting) => true,
        _ => false,
    }
}

fn refuses_limits() -> bool {
    let source_limit = markdown.ParseBudget(source_bytes: 1, work_items: 0, nesting: 0)
    let work_limit = markdown.ParseBudget(source_bytes: 65536, work_items: 0, nesting: 128)
    let source_ok = match markdown.parse("hi", CommonMark, source_limit) {
        Error(SourceBytes) => true,
        _ => false,
    }
    let work_ok = match markdown.parse("hi", CommonMark, work_limit) {
        Error(WorkItems) => true,
        _ => false,
    }
    let run = string.repeat("*", 512)
    let mut deeply_nested = string.from(run)
    string.push(mut deeply_nested, "text")
    string.push(mut deeply_nested, run)
    source_ok && work_ok && refuses_nesting("> > > > > hi", 4) && refuses_nesting(deeply_nested, 4096)
}

fn commonmark_examples() -> bool {
    let mut position = 0u64
    let mut count = 0u64
    while let Some((row, next)) = string.next_line(COMMONMARK_EXAMPLES, position) {
        position = next
        let pair = result.unwrap(json.decode(row, scoped fn(s: String, mut c: json.Cursor) -> Result[List[String], json.Error] {
            json.list_of(s, mut c, json.read_string)
        }))
        if list.len(pair) != 2 || !renders(pair[0], pair[1]) {
            return false
        }
        count += 1
    }
    count == 652
}

// expect: run markdown_contract() = true
fn markdown_contract() -> bool {
    wiki_spans() && reference_span() && refuses_limits() && commonmark_examples() && renders("> # title\n>\n> [one][url] and ***two***.\n\n[url]: /somewhere\n", "<blockquote>\n<h1>title</h1>\n<p><a href=\"/somewhere\">one</a> and <em><strong>two</strong></em>.</p>\n</blockquote>\n")
}

fn span_valid(source: String, extent: markdown.Span) -> bool {
    extent.start <= extent.end && string.is_boundary(source, extent.start) && string.is_boundary(source, extent.end)
}

fn spans_valid(source: String, nodes: List[markdown.Node]) -> bool {
    let n = list.len(nodes)
    if n == 0 || nodes[0].span != markdown.Span(start: 0, end: string.byte_len(source)) {
        return false
    }
    for id in 0u64 .. n {
        let parent = nodes[id]
        if !span_valid(source, parent.span) {
            return false
        }
        let mut child = parent.first
        let mut previous = id
        while child != 0 {
            if child <= previous || child >= n {
                return false
            }
            let extent = nodes[child].span
            if extent.start < parent.span.start || extent.end > parent.span.end {
                return false
            }
            previous = child
            child = nodes[child].next
        }
    }
    true
}

fn reference_span() -> bool {
    // The definition is outside the link's span. Supply it when parsing the slice.
    let source = "[x]\n\n[x]: /url\n"
    let Ok(nodes) = markdown.parse(source, CommonMark, test_budget()) else {
        return false
    }
    let link = nodes[nodes[nodes[0].first].first]
    if let Link(destination, _) = link.kind {
        if destination != "/url" || link.span != markdown.Span(start: 0, end: 3) {
            return false
        }
    } else {
        return false
    }
    let mut extracted = string.from(string.slice(source, link.span.start, link.span.end))
    string.push(mut extracted, "\n\n[x]: /url\n")
    renders(extracted, "<p><a href=\"/url\">x</a></p>\n")
}


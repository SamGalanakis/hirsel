// The caller has already recovered and admitted the head in witness, a
// head with no ATTACH. `attach` is the ATTACH the replace writes when the
// Place is opened streamed (§12.11.5, "No ATTACH").
fn history_replace_claim(mut client: std.object.Client, admitted: history.HistoryHead, holder: StoreId, auth: ClaimAuth, mut buffers: history.HistoryBuffers, deadline: u64, attach: Option[format.Attach]) -> Result[history.HistoryClaimResult, Error] waits {
    let candidate = history_claim_head(admitted, holder, auth)?
    failure_result_from_rep(history.replace_admitted_claim(mut client, admitted, candidate, mut buffers, deadline, attach))
}

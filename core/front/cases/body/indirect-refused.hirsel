// LANG-11/13: parameter modes and result types must match; waits is directional.
// expect: refuse LANG-13 at 8:34
// expect: refuse LANG-13 at 9:44
// expect: refuse LANG-8 at 10:31
fn value(x: u64) -> u64 { x }
fn change(mut x: u64) { x += 1 }
fn waiting(f: fn() waits) waits { f() }
fn bad_mode() { let f: fn(u64) = change }
fn bad_result() { let f: fn(u64) -> bool = value }
fn bad_waits(f: fn() waits) { f() }

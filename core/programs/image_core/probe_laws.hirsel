@test
fn probe_headers_and_bombs() -> Result[(), ()] {
    let limits = image.Limits(max_bytes: 4096, max_header_bytes: 4096, max_pixels: 96, max_frames: 2, max_steps: 100000)
    for i in 0u64 .. 6 {
        let f = fixture(i)
        let header = result.unwrap(result.unwrap(bound bytes 0 {
            image.probe(f, limits)
        }))
        let orientation: u8 = if i == 0 || i == 2 {
            6
        } else {
            1
        }
        let frames: u32 = if i == 4 {
            2
        } else {
            1
        }
        let actual: u64 = match header.format {
            Jpeg => 0,
            Png => 1,
            Webp => 2,
            Avif => 3,
            Gif => 4,
            Qoi => 5,
        }
        if actual != i || header.width != 8 || header.height != 6 || header.frame_count != frames || header.orientation != orientation {
            fail("fixture metadata differs from source canvas, frames or EXIF")
        }
        for n in 0u64 .. list.len(f) {
            // The QOI header ends before its entropy stream.
            if i != 5 || n < 14 {
                if let Ok(_) = image.probe(list.slice(f, 0, n), limits) {
                    fail("accepted a truncated container")
                }
            }
        }
        let mut rng = 4319u32
        let size = list.len(f)
        for _ in 0u64 .. 96 {
            rng = int.wrapping_add(int.wrapping_mul(rng, 1664525), 1013904223)
            let at: u64 = int.widen(rng)
            let mut changed: Bytes = list.with_capacity(size)
            list.append(mut changed, f)
            changed[at % size] = int.narrow(rng >> 24)
            if let Ok(meta) = image.probe(changed, limits) {
                let w: u64 = int.widen(meta.width)
                let h: u64 = int.widen(meta.height)
                let total: u64 = int.widen(meta.frame_count)
                if w == 0 || h == 0 || total == 0 || total > 2 || w * h > 96 / total {
                    fail("accepted dimensions or frame count past the cap")
                }
            }
        }
    }
    let mut small = limits
    small.max_frames = 1
    if let Error(FrameLimit) = image.probe(fixture(4), small) {} else {
        fail("accepted an excess GIF frame")
    }
    small = limits
    small.max_pixels = 95
    if let Error(PixelLimit) = image.probe(fixture(4), small) {} else {
        fail("accepted excess aggregate canvas pixels")
    }
    small = limits
    small.max_steps = 0
    if let Error(WorkLimit) = image.probe(fixture(4), small) {} else {
        fail("ignored the step allowance")
    }
    small = limits
    small.max_bytes = 13
    if let Error(ByteLimit) = image.probe(fixture(5), small) {} else {
        fail("ignored the encoded-byte allowance")
    }
    let bomb_png = b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\xc3\x50\x00\x00\xc3\x50\x08\x06\x00\x00\x00\x4b\xaf\x3d\xca"
    if let Error(PixelLimit) = result.unwrap(bound bytes 0 {
        image.probe(bomb_png, limits)
    }) {} else {
        fail("accepted a 50000 by 50000 PNG header")
    }
    let bomb_qoi = b"\x71\x6f\x69\x66\x00\x00\xc3\x50\x00\x00\xc3\x50\x04\x00"
    if let Error(PixelLimit) = result.unwrap(bound bytes 0 {
        image.probe(bomb_qoi, limits)
    }) {} else {
        fail("accepted a 50000 by 50000 QOI header")
    }
    let bomb_gif = b"\x47\x49\x46\x38\x39\x61\x50\xc3\x50\xc3\x00\x00\x00"
    if let Error(PixelLimit) = result.unwrap(bound bytes 0 {
        image.probe(bomb_gif, limits)
    }) {} else {
        fail("accepted a 50000 by 50000 GIF header")
    }
    Ok(())
}

// HTTP-4: pure request framing over http1's parsed offsets. I/O belongs to
// the connection. ADAPTED Go net/http/transfer.go and internal/chunked.go;
// strict duplicate refusal and extension grammar follow docs/spec/http.md.
pub type Framing: key = Empty | ContentLength(u64) | Chunked

pub type BodyError: key {
    status: u16,
    close: bool
}

fn failure(status: u16) -> BodyError {
    BodyError(status: status, close: true)
}

type ResponseField: send {
    name: Bytes,
    value: Bytes
}

pub opaque type Response: send {
    status: u16,
    fields: List[ResponseField],
    body: Bytes,
    close: bool,
    invalid: bool
}

pub type ResponseError: send = StatusInvalid | HeaderReserved | HeaderInvalid | HeadTooLarge | Allocation(Capacity)

/// Builds a final response. Only the connection may send informational statuses.
pub fn response(status: u16, take body: Bytes, close: bool) -> Result[Response, ResponseError] {
    if status < 200 || status > 599 {
        return Error(StatusInvalid)
    }
    Ok(Response(status: status, fields: list.new(), body: take body, close: close, invalid: false))
}

fn reserved_field(name: Bytes) -> bool {
    http1.equal_ascii(name, string.as_bytes("content-length")) || http1.equal_ascii(name, string.as_bytes("transfer-encoding")) || http1.equal_ascii(name, string.as_bytes("connection"))
}

fn valid_field(name: Bytes, value: Bytes) -> bool {
    if list.len(name) == 0 {
        return false
    }
    for c in name {
        if !http1.token(c) {
            return false
        }
    }
    for c in value {
        if c != 9 && c < 32 || c == 127 {
            return false
        }
    }
    let n = list.len(value)
    n == 0 || value[0] > 32 && value[n - 1] > 32
}

/// Appends a handler-owned field. Framing fields belong to the connection.
pub fn header(mut r: Response, take name: Bytes, take value: Bytes) -> Result[(), ResponseError] {
    if reserved_field(name) {
        r.invalid = true
        return Error(HeaderReserved)
    }
    if !valid_field(name, value) {
        r.invalid = true
        return Error(HeaderInvalid)
    }
    match list.push(mut r.fields, ResponseField(name: take name, value: take value)) {
        Ok(()) => Ok(()),
        Error((c, _)) => Error(Allocation(c)),
    }
}

fn append_head(mut out: Bytes, b: Bytes) -> Result[(), ResponseError] {
    if list.len(b) > list.capacity(out) - list.len(out) {
        return Error(HeadTooLarge)
    }
    match list.append(mut out, b) {
        Ok(()) => Ok(()),
        Error(c) => Error(Allocation(c)),
    }
}

fn head_text(mut out: Bytes, s: String) -> Result[(), ResponseError] {
    append_head(mut out, string.as_bytes(s))
}

fn decimal(mut out: Bytes, n: u64, width: u64) -> Result[(), ResponseError] {
    let mut digits: Inline[u8, 20] =[0; 20]
    let mut start: u64 = 20
    let mut rest = n
    loop {
        start -= 1
        digits[start] = b'0' + int.narrow(rest % 10)
        rest /= 10
        if rest == 0 && 20 - start >= width {
            break
        }
    }
    if 20 - start > list.capacity(out) - list.len(out) {
        return Error(HeadTooLarge)
    }
    for i in start .. 20 {
        if let Error((c, _)) = list.push(mut out, digits[i]) {
            return Error(Allocation(c))
        }
    }
    Ok(())
}

// Days since the Unix epoch to a Gregorian civil date, using a March-based
// 400-year era (Howard Hinnant, civil_from_days). IMF-fixdate uses UTC.
fn date_field(mut out: Bytes, wall_ms: u64) -> Result[(), ResponseError] {
    let seconds = wall_ms / 1000
    let days = seconds / 86400
    let weekdays =["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"]
    let months =["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    let z = days + 719468
    let doe = z % 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < 10 {
        mp + 3
    } else {
        mp - 9
    }
    let year = z / 146097 * 400 + yoe + if month <= 2 {
        1
    } else {
        0
    }
    head_text(mut out, "Date: ")?
    head_text(mut out, weekdays[days % 7])?
    head_text(mut out, ", ")?
    decimal(mut out, day, 2)?
    head_text(mut out, " ")?
    head_text(mut out, months[month - 1])?
    head_text(mut out, " ")?
    decimal(mut out, year, 4)?
    head_text(mut out, " ")?
    decimal(mut out, seconds / 3600 % 24, 2)?
    head_text(mut out, ":")?
    decimal(mut out, seconds / 60 % 60, 2)?
    head_text(mut out, ":")?
    decimal(mut out, seconds % 60, 2)?
    head_text(mut out, " GMT\r\n")
}

type DateCache {
    second: Option[u64],
    length: u64,
    words: Inline[u64, 6]
}

fn date_cache() -> DateCache {
    DateCache(second: None, length: 0, words:[0; 6])
}

fn append_date(mut out: Bytes, wall_ms: u64, mut cache: DateCache) -> Result[(), ResponseError] {
    let second = wall_ms / 1000
    if cache.second == Some(second) {
        if cache.length > list.capacity(out) - list.len(out) {
            return Error(HeadTooLarge)
        }
        let whole = cache.length / 8
        for i in 0u64 .. whole {
            if let Error(c) = list.put_word_le(mut out, cache.words[i]) {
                return Error(Allocation(c))
            }
        }
        let mut tail = cache.words[whole]
        for _ in whole * 8 .. cache.length {
            if let Error((c, _)) = list.push(mut out, int.narrow(tail & 255)) {
                return Error(Allocation(c))
            }
            tail /= 256
        }
        return Ok(())
    }
    let start = list.len(out)
    date_field(mut out, wall_ms)?
    let n = list.len(out) - start
    let whole = n / 8
    for i in 0u64 .. whole {
        cache.words[i] = list.word_le(out, start + i * 8)
    }
    // A u64 millisecond timestamp has at most a nine-digit year.
    let mut tail = 0u64
    for i in whole * 8 .. n {
        let byte: u64 = int.widen(out[start + i])
        tail |= int.wrapping_shl(byte, int.narrow((i % 8) * 8))
    }
    cache.words[whole] = tail
    cache.length = n
    cache.second = Some(second)
    Ok(())
}

fn reason(status: u16) -> String {
    if status == 200 {
        return "OK"
    }
    if status == 204 {
        return "No Content"
    }
    if status == 304 {
        return "Not Modified"
    }
    ""
}

fn has_body(status: u16) -> bool {
    status != 204 && status != 304
}

// Construct the whole head before the first send. A full head leaves the
// connection free to send a bounded error, with no partial header to undo.
fn response_head(mut out: Bytes, r: Response, version: u8, close: bool, wall_ms: u64, mut cache: DateCache) -> Result[(), ResponseError] {
    if r.invalid {
        return Error(HeaderInvalid)
    }
    list.clear(mut out)
    head_text(mut out, if version == 0 {
        "HTTP/1.0 "
    } else {
        "HTTP/1.1 "
    })?
    decimal(mut out, int.widen(r.status), 3)?
    head_text(mut out, " ")?
    head_text(mut out, reason(r.status))?
    head_text(mut out, "\r\n")?
    for f in r.fields {
        if !http1.equal_ascii(f.name, string.as_bytes("date")) {
            append_head(mut out, f.name)?
            head_text(mut out, ": ")?
            append_head(mut out, f.value)?
            head_text(mut out, "\r\n")?
        }
    }
    if has_body(r.status) {
        head_text(mut out, "Content-Length: ")?
        decimal(mut out, list.len(r.body), 1)?
        head_text(mut out, "\r\n")?
    }
    if close {
        head_text(mut out, "Connection: close\r\n")?
    } else if version == 0 {
        head_text(mut out, "Connection: keep-alive\r\n")?
    }
    append_date(mut out, wall_ms, mut cache)?
    head_text(mut out, "\r\n")
}

fn part(b: Bytes, span: http1.Span) -> View[Bytes] in b {
    list.slice(b, span.start, span.end)
}

fn hex_digit(x: u8) -> Option[u8] {
    let c = int.to_ascii_lower(x)
    if int.is_ascii_digit(c) {
        Some(c - b'0')
    } else if c >= b'a' && c <= b'f' {
        Some(c - b'a' + 10)
    } else {
        None
    }
}

fn unreserved(x: u8) -> bool {
    int.is_ascii_alpha(x) || int.is_ascii_digit(x) || x == b'-' || x == b'.' || x == b'_' || x == b'~'
}

fn sub_delim(x: u8) -> bool {
    x == b'!' || x == b'$' || x == b'&' || x == 39 || x == b'(' || x == b')' || x == b'*' || x == b'+' || x == b',' || x == b';' || x == b'='
}

fn ipv4(b: Bytes) -> bool {
    let n = list.len(b)
    let mut at: u64 = 0
    for word in 0u64 .. 4 {
        let start = at
        let mut value: u16 = 0
        while at < n && int.is_ascii_digit(b[at]) {
            if at - start == 3 {
                return false
            }
            value = value * 10 + int.widen(b[at] - b'0')
            at += 1
        }
        if at == start || at - start > 1 && b[start] == b'0' || value > 255 {
            return false
        }
        if word != 3 {
            if at == n || b[at] != b'.' {
                return false
            }
            at += 1
        }
    }
    at == n
}

// RFC 3986 IP-literal accepts every IPv6 spelling (including an embedded
// IPv4 tail) and the IPvFuture grammar. It has no scope ID or DNS step.
fn ip_literal(b: Bytes) -> bool {
    let n = list.len(b)
    if n == 0 {
        return false
    }
    if int.to_ascii_lower(b[0]) == b'v' {
        let mut at: u64 = 1
        while at < n && hex_digit(b[at]) != None {
            at += 1
        }
        if at == 1 || at + 1 >= n || b[at] != b'.' {
            return false
        }
        for i in at + 1 .. n {
            if !(unreserved(b[i]) || sub_delim(b[i]) || b[i] == b':') {
                return false
            }
        }
        return true
    }
    let mut at: u64 = 0
    let mut words: u64 = 0
    let mut compressed = false
    if b[0] == b':' {
        if n < 2 || b[1] != b':' {
            return false
        }
        at = 2
        compressed = true
    }
    while at < n {
        let start = at
        while at < n && hex_digit(b[at]) != None {
            at += 1
        }
        if at < n && b[at] == b'.' {
            if !ipv4(list.slice(b, start, n)) {
                return false
            }
            words += 2
            break
        }
        if at == start || at - start > 4 {
            return false
        }
        words += 1
        if at == n {
            break
        }
        if b[at] != b':' {
            return false
        }
        at += 1
        if at < n && b[at] == b':' {
            if compressed {
                return false
            }
            compressed = true
            at += 1
        } else if at == n {
            return false
        }
    }
    if compressed {
        words < 8
    } else {
        words == 8
    }
}

fn authority(b: Bytes) -> bool {
    let n = list.len(b)
    if n == 0 {
        return false
    }
    let mut at: u64 = 0
    if b[0] == b'[' {
        at = 1
        while at < n && b[at] != b']' {
            at += 1
        }
        if at == n || !ip_literal(list.slice(b, 1, at)) {
            return false
        }
        at += 1
    } else {
        while at < n && b[at] != b':' {
            let c = b[at]
            if c == b'%' {
                if n - at < 3 || hex_digit(b[at + 1]) == None || hex_digit(b[at + 2]) == None {
                    return false
                }
                at += 3
            } else {
                if !(unreserved(c) || sub_delim(c)) {
                    return false
                }
                at += 1
            }
        }
        if at == 0 {
            return false
        }
    }
    if at == n {
        return true
    }
    if b[at] != b':' || n - at < 2 || n - at > 6 {
        return false
    }
    let mut port: u32 = 0
    for i in at + 1 .. n {
        if !int.is_ascii_digit(b[i]) {
            return false
        }
        port = port * 10 + int.widen(b[i] - b'0')
    }
    port <= 65535
}

type RequestHead {
    authority: Option[http1.Span],
    path: http1.Span,
    query: http1.Span,
    expect_continue: bool,
    close: bool
}

fn request_policy(b: Bytes, h: http1.Head) -> Result[RequestHead, u16] {
    let verb = part(b, h.method)
    let mut host: Option[http1.Span] = None
    let mut expect = false
    let mut close = false
    let mut keep_alive = false
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        let name = part(b, f.name)
        let value = part(b, f.value)
        if http1.equal_ascii(name, string.as_bytes("host")) {
            if host != None || !authority(value) {
                return Error(400)
            }
            host = Some(f.value)
        } else if http1.equal_ascii(name, string.as_bytes("expect")) {
            if expect || h.version == 0 || !http1.equal_ascii(value, string.as_bytes("100-continue")) {
                return Error(417)
            }
            expect = true
        } else if http1.equal_ascii(name, string.as_bytes("connection")) {
            close = close || http1.contains(value, string.as_bytes("close"))
            keep_alive = keep_alive || http1.contains(value, string.as_bytes("keep-alive"))
        }
    }
    if h.version == 1 && host == None {
        return Error(400)
    }
    if verb == string.as_bytes("CONNECT") {
        return Error(501)
    }
    let mut start = h.target.start
    let end = h.target.end
    if part(b, h.target) == string.as_bytes("*") {
        if verb != string.as_bytes("OPTIONS") {
            return Error(400)
        }
    } else if b[start] != b'/' {
        let mut colon = start
        while colon < end && b[colon] != b':' && b[colon] != b'/' && b[colon] != b'?' {
            colon += 1
        }
        if end - colon < 3 || b[colon + 1] != b'/' || b[colon + 2] != b'/' {
            return Error(501)
        }
        if !int.is_ascii_alpha(b[start]) {
            return Error(400)
        }
        for i in start + 1 .. colon {
            let x = b[i]
            if !(int.is_ascii_alpha(x) || int.is_ascii_digit(x) || x == b'+' || x == b'-' || x == b'.') {
                return Error(400)
            }
        }
        let host_start = colon + 3
        start = host_start
        while start < end && b[start] != b'/' && b[start] != b'?' {
            start += 1
        }
        let absolute = http1.Span(start: host_start, end: start)
        if host == None || !authority(part(b, absolute)) {
            return Error(400)
        }
        host = Some(absolute)
    }
    let mut path_end = start
    while path_end < end && b[path_end] != b'?' {
        if b[path_end] == b'#' {
            return Error(400)
        }
        path_end += 1
    }
    let query_at = if path_end == end {
        end
    } else {
        path_end + 1
    }
    Ok(RequestHead(authority: host, path: http1.Span(start: start, end: path_end), query: http1.Span(start: query_at, end: end), expect_continue: expect, close: close || h.version == 0 && !keep_alive))
}

type TargetError: key = BadTarget | TargetCapacity

fn segment(b: Bytes) -> Result[String, TargetError] {
    let end = list.len(b)
    let allocated: Result[Bytes, Capacity] = list.with_capacity(end)
    let mut decoded = match take allocated {
        Ok(take x) => take x,
        Error(_) => return Error(TargetCapacity),
    }
    let mut at: u64 = 0
    while at < end {
        let c = b[at]
        if c == b'%' {
            if end - at < 3 {
                return Error(BadTarget)
            }
            let hi = match hex_digit(b[at + 1]) {
                Some(x) => x,
                None => return Error(BadTarget),
            }
            let lo = match hex_digit(b[at + 2]) {
                Some(x) => x,
                None => return Error(BadTarget),
            }
            let byte: u8 = hi * 16 + lo
            let _ = list.push(mut decoded, byte)
            at += 3
        } else {
            let _ = list.push(mut decoded, c)
            at += 1
        }
    }
    if decoded == string.as_bytes(".") || decoded == string.as_bytes("..") {
        return Error(BadTarget)
    }
    match string.from_utf8(take decoded) {
        Ok(take s) => Ok(take s),
        Error(_) => Error(BadTarget),
    }
}

// Split before decoding; a decoded slash is data in a single segment.
// Root and an empty absolute-form path both have zero segments.
fn segments_of(raw_path: Bytes) -> Result[List[String], TargetError] {
    let mut decoded_segments: List[String] = list.new()
    let n = list.len(raw_path)
    if n <= 1 {
        return Ok(take decoded_segments)
    }
    let mut start: u64 = 1
    while start <= n {
        let mut end = start
        while end < n && raw_path[end] != b'/' {
            end += 1
        }
        if end == start && end < n {
            return Error(BadTarget)
        }
        let s = segment(list.slice(raw_path, start, end))?
        if let Error(_) = list.push(mut decoded_segments, take s) {
            return Error(TargetCapacity)
        }
        if end == n {
            return Ok(take decoded_segments)
        }
        start = end + 1
    }
    Ok(take decoded_segments)
}

pub type Config: shareable + send {
    ingress: List[wsock.Prefix],
    sockets_max: u64,
    http_max: u64,
    upgrades_max: u64,
    conns_max: u64,
    ip_sockets_max: u64,
    refuse_max: u64,
    refuse_ms: u64,
    inbox_cap: u64,
    head_max: u64,
    fields_max: u64,
    pipeline_max: u64,
    body_inline: u64,
    body_max: u64,
    out_cap: u64,
    handler_bytes: u64,
    first_head_ms: u64,
    idle_ms: u64,
    head_ms: u64,
    body_ms: u64,
    handler_ms: u64,
    write_ms: u64,
    drain_ms: u64,
    linger_ms: u64,
    drain_max: u64,
    streams_max: u64,
    state_max: u64,
    reads_max: u64,
    heartbeat_ms: u64,
    lease_ms: u64
}

pub opaque scoped type Request {
    input: View[Bytes],
    head: View[http1.Head],
    meta: RequestHead,
    segments: List[String],
    inline_body: Option[View[Bytes]],
    deadline: u64
}

pub fn method(r: Request) -> View[Bytes] in r {
    part(r.input, r.head.method)
}

pub fn target(r: Request) -> View[Bytes] in r {
    part(r.input, r.head.target)
}

pub fn path(r: Request) -> View[Bytes] in r {
    part(r.input, r.meta.path)
}

pub fn segments(r: Request) -> View[List[String]] in r {
    view r.segments
}

pub fn query(r: Request) -> View[Bytes] in r {
    part(r.input, r.meta.query)
}

pub fn field(r: Request, name: Bytes) -> Option[View[Bytes]] in r {
    if http1.equal_ascii(name, string.as_bytes("host")) {
        return match r.meta.authority {
            Some(s) => Some(part(r.input, s)),
            None => None,
        }
    }
    for i in 0u64 .. r.head.count {
        let f = r.head.fields[i]
        if http1.equal_ascii(part(r.input, f.name), name) {
            return Some(part(r.input, f.value))
        }
    }
    None
}

pub fn handler_deadline(r: Request) -> u64 {
    r.deadline
}

pub fn inline_body(r: Request) -> Option[View[Bytes]] in r {
    r.inline_body
}

/// Copies a borrowed field or body into the current handler's allowance.
pub fn copy_bytes(b: Bytes) -> Result[Bytes, Capacity] {
    let mut copied: Bytes = list.with_capacity(list.len(b))?
    let _ = list.append(mut copied, b)
    Ok(take copied)
}

type HeadResult: key = Ready | PeerClosed | Rejected(u16)

fn after_ms(at: u64, ms: u64) -> u64 {
    int.saturating_add(at, int.saturating_mul(ms, 1000000u64))
}

// recv appends into spare capacity. Reserve the leading space in the
// existing scratch when a phase may read fewer than 8192 bytes.
fn receive(mut r: ReadHalf, mut scratch: Bytes, n: u64, c: Clock, deadline: u64) -> Result[u64, NetError] waits {
    list.clear(mut scratch)
    let _ = list.fill(mut scratch, 8192 - n, 0u8)
    host.recv(mut r, mut scratch, At(c, deadline))
}

fn receive_head(mut r: ReadHalf, mut b: Bytes, mut scratch: Bytes, c: Clock, deadline: u64, cfg: Config) -> Result[u64, NetError] waits {
    let allowance = order.min(8192, order.min(cfg.pipeline_max + 1, list.capacity(b) - list.len(b)))
    let n = receive(mut r, mut scratch, allowance, c, deadline)?
    let _ = list.append(mut b, list.slice(scratch, 8192 - allowance, 8192 - allowance + n))
    Ok(n)
}

fn read_head(mut r: ReadHalf, mut b: Bytes, mut scratch: Bytes, mut h: http1.Head, c: Clock, first: bool, start: u64, cfg: Config) -> HeadResult waits {
    let mut deadline = after_ms(start, cfg.first_head_ms)
    if !first {
        if list.len(b) == 0 {
            let idle = after_ms(start, cfg.idle_ms)
            if host.mono_ns(c) >= idle {
                return Rejected(408)
            }
            match receive_head(mut r, mut b, mut scratch, c, idle, cfg) {
                Ok(0) => return PeerClosed,
                Ok(_) => {},
                Error(TimedOut) => return Rejected(408),
                Error(_) => return PeerClosed,
            }
        }
        deadline = after_ms(host.mono_ns(c), cfg.head_ms)
    }
    let mut cur = http1.cursor()
    loop {
        if host.mono_ns(c) >= deadline {
            return Rejected(408)
        }
        let view_end = order.min(cfg.head_max, list.len(b))
        let outcome = http1.resume(list.slice(b, 0, view_end), mut h, mut cur)
        if h.count > cfg.fields_max {
            return Rejected(431)
        }
        match outcome {
            Complete => return Ready,
            Bad => return Rejected(400),
            _ => {},
        }
        if outcome == TooLarge || view_end == cfg.head_max {
            return Rejected(if cur.line_end == 0 && cur.offset - cur.line_start == cfg.head_max {
                414
            } else {
                431
            })
        }
        match receive_head(mut r, mut b, mut scratch, c, deadline, cfg) {
            Ok(0) => return if list.len(b) == 0 {
                PeerClosed
            } else {
                Rejected(400)
            },
            Ok(_) => {},
            Error(TimedOut) => return Rejected(408),
            Error(_) => return PeerClosed,
        }
    }
}

// A single deadline and committed byte count cover both carriers.
fn write_unit(mut w: WriteHalf, prefix: Bytes, body: Bytes, c: Clock, deadline: u64) -> Result[(), NetError] waits {
    let boundary = list.len(prefix)
    let end = boundary + list.len(body)
    let mut committed: u64 = 0
    while committed < end {
        if host.mono_ns(c) >= deadline {
            return Error(TimedOut)
        }
        let sent = if committed < boundary {
            host.send(mut w, list.slice(prefix, committed, boundary), At(c, deadline))
        } else {
            host.send(mut w, list.slice(body, committed - boundary, list.len(body)), At(c, deadline))
        }
        match sent {
            Ok(0) => return Error(Reset),
            Ok(n) => {
                committed += n
            },
            Error(e) => return Error(e),
        }
    }
    Ok(())
}

fn refusal_head(status: u16) -> String {
    match status {
        400 => "HTTP/1.1 400 Bad Request\r\n",
        408 => "HTTP/1.1 408 Request Timeout\r\n",
        413 => "HTTP/1.1 413 Content Too Large\r\n",
        414 => "HTTP/1.1 414 URI Too Long\r\n",
        417 => "HTTP/1.1 417 Expectation Failed\r\n",
        431 => "HTTP/1.1 431 Request Header Fields Too Large\r\n",
        501 => "HTTP/1.1 501 Not Implemented\r\n",
        503 => "HTTP/1.1 503 Service Unavailable\r\nRetry-After: 1\r\n",
        _ => "HTTP/1.1 500 Internal Server Error\r\n",
    }
}

fn reply_error(mut w: WriteHalf, status: u16, c: Clock, deadline: u64) -> Result[(), NetError] waits {
    write_unit(mut w, string.as_bytes(refusal_head(status)), string.as_bytes("Connection: close\r\nContent-Length: 0\r\n\r\n"), c, deadline)
}

pub opaque scoped type Body {
    input: View[Bytes],
    input_at: u64,
    reader: ReadHalf,
    writer: WriteHalf,
    scratch: Bytes,
    scratch_at: u64,
    decoder: Decoder,
    head_max: u64,
    fields_max: u64,
    clock: Clock,
    body_deadline: u64,
    handler_deadline: u64,
    write_ms: u64,
    pipeline_max: u64,
    expect_continue: bool,
    fault: Option[BodyError],
    output_failed: bool
}

fn body_fault(mut b: Body, status: u16) -> BodyError {
    let error = failure(status)
    b.fault = Some(error)
    error
}

type BodyPiece = Buffered(http1.Span) | Received(http1.Span) | NeedBytes | BodyDone | BodyFailed(BodyError)

fn body_piece(mut b: Body, max: u64) -> BodyPiece {
    if let Some(e) = b.fault {
        return BodyFailed(e)
    }
    let in_input = b.input_at < list.len(b.input)
    let start = if in_input {
        b.input_at
    } else {
        b.scratch_at
    }
    let result = if in_input {
        let limit = start + order.min(max, list.len(b.input) - start)
        decode(mut b.decoder, list.slice(b.input, start, limit))
    } else {
        let limit = start + order.min(max, list.len(b.scratch) - start)
        decode(mut b.decoder, list.slice(b.scratch, start, limit))
    }
    if in_input {
        b.input_at += b.decoder.used
    } else {
        b.scratch_at += b.decoder.used
    }
    if b.decoder.trailer_bytes > b.head_max || b.decoder.trailer_fields > b.fields_max {
        return BodyFailed(body_fault(mut b, 431))
    }
    match result {
        Data(s) => {
            let span = http1.Span(start: start + s.start, end: start + s.end)
            if in_input {
                Buffered(span)
            } else {
                Received(span)
            }
        },
        Done => BodyDone,
        Failed(e) => {
            b.fault = Some(e)
            BodyFailed(e)
        },
        More => NeedBytes,
    }
}

fn refill_body(mut b: Body, max: u64, deadline: u64, timeout_status: u16) -> Result[(), BodyError] waits {
    if host.mono_ns(b.clock) >= deadline {
        return Error(body_fault(mut b, timeout_status))
    }
    b.scratch_at = 8192 - max
    match receive(mut b.reader, mut b.scratch, max, b.clock, deadline) {
        Ok(0) => match body_eof(mut b.decoder) {
            Ok(()) => Ok(()),
            Error(e) => {
                b.fault = Some(e)
                Error(e)
            },
        },
        Ok(_) => Ok(()),
        Error(TimedOut) => Error(body_fault(mut b, timeout_status)),
        Error(_) => Error(body_fault(mut b, 400)),
    }
}

/// Appends decoded bytes within the caller-provided spare capacity. Returns
/// zero at body EOF. Use a nonempty spare buffer for a read.
pub fn read(mut b: Body, mut into: Bytes) -> Result[u64, BodyError] waits {
    if let Some(e) = b.fault {
        return Error(e)
    }
    let room = list.capacity(into) - list.len(into)
    if room == 0 {
        return Error(BodyError(status: 503, close: false))
    }
    let until = order.min(b.body_deadline, b.handler_deadline)
    let timeout_status: u16 = if b.handler_deadline < b.body_deadline {
        503
    } else {
        408
    }
    if host.mono_ns(b.clock) >= until {
        return Error(body_fault(mut b, timeout_status))
    }
    if b.expect_continue {
        let write_end = order.min(until, after_ms(host.mono_ns(b.clock), b.write_ms))
        let result = write_unit(mut b.writer, string.as_bytes("HTTP/1.1 100 Continue\r\n\r\n"), string.as_bytes(""), b.clock, write_end)
        b.expect_continue = false
        if let Error(_) = result {
            b.output_failed = true
            return Error(body_fault(mut b, 408))
        }
    }
    loop {
        match body_piece(mut b, room) {
            Buffered(s) => {
                let _ = list.append(mut into, part(b.input, s))
                return Ok(s.end - s.start)
            },
            Received(s) => {
                let _ = list.append(mut into, part(b.scratch, s))
                return Ok(s.end - s.start)
            },
            BodyDone => return Ok(0),
            BodyFailed(e) => return Error(e),
            NeedBytes => {
                if b.input_at == list.len(b.input) && b.scratch_at == list.len(b.scratch) {
                    let max = order.min(8192, b.pipeline_max + 1)
                    refill_body(mut b, max, until, timeout_status)?
                }
            },
        }
    }
}

fn drain(mut b: Body, remaining: u64, deadline: u64) -> bool waits {
    if b.fault != None {
        return false
    }
    if b.decoder.state == Finished {
        return true
    }
    if b.expect_continue || b.decoder.state == Fixed && b.decoder.remaining > remaining || host.mono_ns(b.clock) >= deadline {
        return false
    }
    let mut budget = remaining
    let mut reads = remaining / 8192 + if remaining % 8192 == 0 {
        1
    } else {
        2
    }
    loop {
        let input_at = b.input_at
        let scratch_at = b.scratch_at
        let result = body_piece(mut b, budget)
        budget -= (b.input_at - input_at) + (b.scratch_at - scratch_at)
        match result {
            BodyDone => return true,
            BodyFailed(_) => return false,
            NeedBytes => {
                if budget == 0 || reads == 0 {
                    return false
                }
                if b.input_at == list.len(b.input) && b.scratch_at == list.len(b.scratch) {
                    let max = order.min(budget, order.min(8192, b.pipeline_max + 1))
                    if let Error(_) = refill_body(mut b, max, deadline, 408) {
                        return false
                    }
                    reads -= 1
                }
            },
            _ => {},
        }
    }
}

pub type Outcome: send = Reply(Response)

type Step = Keep(u64, u64) | RepliedAndClose | CloseConnection

fn discard(take bytes_to_drop: Bytes) {}

fn compact(mut b: Bytes, at: u64) {
    let used = list.len(b)
    if at == used {
        list.clear(mut b)
    } else if at > 0 {
        for i in at .. used {
            let c = b[i]
            let _ = list.set(mut b, i - at, c)
        }
        for _ in 0u64 .. at {
            let _ = list.pop(mut b)
        }
    }
}

fn write_succeeded(r: Result[(), NetError]) -> bool {
    match r {
        Ok(()) => true,
        Error(_) => false
    }
}

type OutputResult = FinalReply(bool) | ClosingReply(bool)

fn error_step(mut w: WriteHalf, status: u16, clock: Clock, end: u64) -> Step waits {
    if write_succeeded(reply_error(mut w, status, clock, end)) {
        RepliedAndClose
    } else {
        CloseConnection
    }
}

fn send_response(mut b: Body, mut out: Bytes, r: Response, version: u8, suppress: bool, close: bool, cfg: Config, mut cache: DateCache) -> OutputResult waits {
    if let Error(_) = response_head(mut out, r, version, close, host.wall_ms(b.clock), mut cache) {
        return ClosingReply(write_succeeded(reply_error(mut b.writer, 500, b.clock, after_ms(host.mono_ns(b.clock), cfg.write_ms))))
    }
    let write_end = after_ms(host.mono_ns(b.clock), cfg.write_ms)
    if suppress || !has_body(r.status) {
        return FinalReply(write_succeeded(write_unit(mut b.writer, out, string.as_bytes(""), b.clock, write_end)))
    }
    if list.len(r.body) <= list.capacity(out) - list.len(out) {
        let _ = list.append(mut out, r.body)
        return FinalReply(write_succeeded(write_unit(mut b.writer, out, string.as_bytes(""), b.clock, write_end)))
    }
    FinalReply(write_succeeded(write_unit(mut b.writer, out, r.body, b.clock, write_end)))
}

fn handle[S: shareable + send](input: Bytes, h: http1.Head, meta: RequestHead, frame: Framing, mut b: Body, mut out: Bytes, cfg: Config, handler: fn(Request, Region, mut Body, S) -> Result[Outcome, ResponseError] waits, state: S, mut cache: DateCache) -> Step waits {
    let outcome = bound bytes cfg.handler_bytes {
        let normalized = match segments_of(part(input, meta.path)) {
            Ok(take x) => take x,
            Error(BadTarget) => {
                return error_step(mut b.writer, 400, b.clock, after_ms(host.mono_ns(b.clock), cfg.write_ms))
            },
            Error(TargetCapacity) => {
                return error_step(mut b.writer, 503, b.clock, after_ms(host.mono_ns(b.clock), cfg.write_ms))
            },
        }
        let inline = match frame {
            ContentLength(n) => if n <= cfg.body_inline && n <= list.len(input) - h.end && !meta.expect_continue {
                Some(list.slice(input, h.end, h.end + n))
            } else {
                None
            },
            _ => None,
        }
        if let Some(v) = inline {
            b.input_at += list.len(v)
            b.decoder.state = Finished
            b.decoder.remaining = 0
        }
        let req = Request(input: view input, head: view h, meta: meta, segments: take normalized, inline_body: inline, deadline: b.handler_deadline)
        let result = region scratch {
            handler(req, scratch, mut b, state)
        }
        let returned = host.mono_ns(b.clock)
        if b.output_failed {
            return CloseConnection
        }
        if let Some(e) = b.fault {
            if e.status == 408 || e.status == 503 {
                return error_step(mut b.writer, e.status, b.clock, after_ms(returned, cfg.write_ms))
            }
        }
        if returned >= b.handler_deadline {
            return error_step(mut b.writer, 503, b.clock, after_ms(returned, cfg.write_ms))
        }
        // Stream and upgrade outcomes take the halves here, before any
        // response is committed. The caller owns ordinary close and drain.
        let reply = match take result {
            Ok(Reply(take r)) => take r,
            Error(e) => {
                let status: u16 = match e {
                    Allocation(_) => 503,
                    _ => 500
                }
                return error_step(mut b.writer, status, b.clock, after_ms(returned, cfg.write_ms))
            },
        }
        let abandon_expect = b.expect_continue && b.decoder.state != Finished
        let close = meta.close || reply.close || b.fault != None || abandon_expect
        let suppress = part(input, h.method) == string.as_bytes("HEAD")
        match send_response(mut b, mut out, reply, h.version, suppress, close, cfg, mut cache) {
            FinalReply(true) => if close {
                RepliedAndClose
            } else {
                Keep(host.mono_ns(b.clock), order.min(b.body_deadline, after_ms(returned, cfg.drain_ms)))
            },
            ClosingReply(true) => RepliedAndClose,
            _ => CloseConnection,
        }
    }
    match outcome {
        Ok(step) => step,
        Error(_) => {
            error_step(mut b.writer, 503, b.clock, after_ms(host.mono_ns(b.clock), cfg.write_ms))
        },
    }
}

type ConnectionSignal: send = FirstResponse(u64) | Source(u64, Ip, Sender[bool]) | EndNotice | Refused(u64) | Accepted(Socket, Ip, u64) | ListenerFailed(NetError)

resource type Completion: send {
    done: Sender[u64],
    wake: Sender[ConnectionSignal],
    slot: u64,
    armed: bool
} drop(completion) {
    if completion.armed {
        let _ = channel.try_send(completion.done, completion.slot)
        // If the inbox is full, its queued event will wake the supervisor.
        let _ = channel.try_send(completion.wake, EndNotice)
    }
}

type ConnectionJob[S: shareable + send]: send {
    socket: Socket,
    c: Clock,
    cfg: Arc[Config],
    peer: Ip,
    at: u64,
    handler: fn(Request, Region, mut Body, S) -> Result[Outcome, ResponseError] waits,
    state: Arc[S],
    inbox: Sender[ConnectionSignal],
    slot: u64,
    completion: Completion
}

fn change_source(inbox: Sender[ConnectionSignal], slot: u64, ip: Ip) -> bool waits {
    let allocated: Result[(Sender[bool], Receiver[bool]), Capacity] = channel.new(1)
    let (tx, rx) = match take allocated {
        Ok(take pair) => take pair,
        Error(_) => return false,
    }
    if let Error(_) = channel.send(inbox, Source(slot, ip, take tx)) {
        return false
    }
    match channel.receive(rx) {
        Ok(allowed) => allowed,
        Error(_) => false,
    }
}

fn connection[S: shareable + send](take job: ConnectionJob[S]) waits {
    let ConnectionJob(socket: take socket, c: c, cfg: take cfg, peer: peer, at: accepted, handler: handler, state: take state, inbox: take inbox, slot: slot, completion: take notice) = take job
    let mut completion = take notice
    completion.armed = true
    let _ = run_connection(take socket, c, cfg, peer, accepted, handler, state, inbox, slot)
}

fn run_connection[S: shareable + send](take socket: Socket, c: Clock, cfg: Config, peer: Ip, accepted: u64, handler: fn(Request, Region, mut Body, S) -> Result[Outcome, ResponseError] waits, state: S, inbox: Sender[ConnectionSignal], slot: u64) -> u64 waits {
    let (r, w) = net.split(take socket)
    let mut reader = take r
    let mut writer = take w
    let read_alloc: Result[Bytes, Capacity] = list.with_capacity(cfg.head_max + cfg.pipeline_max + cfg.body_inline)
    let mut input = match take read_alloc {
        Ok(take b) => take b,
        Error(_) => return 0
    }
    let out_alloc: Result[Bytes, Capacity] = list.with_capacity(cfg.out_cap)
    let mut out = match take out_alloc {
        Ok(take b) => take b,
        Error(_) => return 0
    }
    let scratch_alloc: Result[Bytes, Capacity] = list.with_capacity(8192)
    let mut scratch = match take scratch_alloc {
        Ok(take b) => take b,
        Error(_) => return 0
    }
    let mut first = true
    let mut start = accepted
    let mut batch: u64 = 0
    let mut completed_replies: u64 = 0
    let mut date = date_cache()
    loop {
        let mut head = http1.head()
        match read_head(mut reader, mut input, mut scratch, mut head, c, first, start, cfg) {
            PeerClosed => break,
            Rejected(status) => {
                if write_succeeded(reply_error(mut writer, status, c, after_ms(host.mono_ns(c), cfg.write_ms))) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            },
            Ready => {},
        }
        let completed = host.mono_ns(c)
        if first && list.len(cfg.ingress) != 0 {
            let source = match wsock.source_for_head(input, head, peer, cfg.ingress) {
                Ok(ip) => ip,
                Error(status) => {
                    if write_succeeded(reply_error(mut writer, status, c, after_ms(host.mono_ns(c), cfg.write_ms))) && first {
                        let _ = channel.send(inbox, FirstResponse(slot))
                    }
                    break
                },
            }
            if source_key(source) != source_key(peer) && !change_source(inbox, slot, source) {
                if write_succeeded(reply_error(mut writer, 503, c, after_ms(host.mono_ns(c), cfg.write_ms))) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            }
        }
        let frame = match framing(input, head, cfg.body_max) {
            Ok(f) => f,
            Error(e) => {
                if write_succeeded(reply_error(mut writer, e.status, c, after_ms(host.mono_ns(c), cfg.write_ms))) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            },
        }
        let policy = match request_policy(input, head) {
            Ok(p) => p,
            Error(status) => {
                if write_succeeded(reply_error(mut writer, status, c, after_ms(host.mono_ns(c), cfg.write_ms))) && first {
                    let _ = channel.send(inbox, FirstResponse(slot))
                }
                break
            },
        }
        list.clear(mut scratch)
        let (reuse, input_at, scratch_at) = {
            let mut body = Body(input: view input, input_at: head.end, reader: take reader, writer: take writer, scratch: take scratch, scratch_at: 0, decoder: decoder(frame, head, cfg.body_max), head_max: cfg.head_max, fields_max: cfg.fields_max, clock: c, body_deadline: after_ms(completed, cfg.body_ms), handler_deadline: after_ms(completed, cfg.handler_ms), write_ms: cfg.write_ms, pipeline_max: cfg.pipeline_max, expect_continue: policy.expect_continue, fault: None, output_failed: false)
            let step = handle(input, head, policy, frame, mut body, mut out, cfg, handler, state, mut date)
            let reuse = match step {
                Keep(at, end) => {
                    completed_replies += 1
                    start = at
                    if first {
                        let _ = channel.send(inbox, FirstResponse(slot))
                    }
                    drain(mut body, cfg.drain_max, end)
                },
                RepliedAndClose => {
                    completed_replies += 1
                    if first {
                        let _ = channel.send(inbox, FirstResponse(slot))
                    }
                    false
                },
                CloseConnection => false,
            }
            let Body(reader: take next_reader, writer: take next_writer, scratch: take s, input_at: input_at, scratch_at: scratch_at, input: _, decoder: _, head_max: _, fields_max: _, clock: _, body_deadline: _, handler_deadline: _, write_ms: _, pipeline_max: _, expect_continue: _, fault: _, output_failed: _) = take body
            reader = take next_reader
            writer = take next_writer
            scratch = take s
            (reuse, input_at, scratch_at)
        }
        if !reuse {
            break
        }
        compact(mut input, input_at)
        let _ = list.append(mut input, list.slice(scratch, scratch_at, list.len(scratch)))
        first = false
        batch += 1
        if batch == 16 {
            task.check_cancel()
            batch = 0
        }
    }
    discard(take scratch)
    let _ = net.finish(take writer, take reader, c, after_ms(host.mono_ns(c), cfg.linger_ms))
    completed_replies
}

pub type ServeError: send = Configuration | Capacity(Capacity) | Network(NetError)

type AcceptorJob: send {
    listener: Listener,
    c: Clock,
    inbox: Sender[ConnectionSignal]
}

fn acceptor(take job: AcceptorJob) waits {
    let AcceptorJob(listener: take listener, c: c, inbox: take inbox) = take job
    let mut l = take listener
    loop {
        match host.accept(mut l, Never) {
            Ok((take socket, peer)) => {
                let at = host.mono_ns(c)
                if let Error(_) = channel.send(inbox, Accepted(take socket, peer.ip, at)) {
                    return
                }
            },
            Error(e) => {
                let _ = channel.send(inbox, ListenerFailed(e))
                return
            },
        }
    }
}

type RefusalJob: send {
    socket: Socket,
    at: u64
}

type RefusalWorker: send {
    inbox: Sender[ConnectionSignal],
    jobs: Receiver[RefusalJob],
    slot: u64,
    c: Clock,
    ms: u64
}

fn refusal_worker(take worker: RefusalWorker) waits {
    let RefusalWorker(inbox: take inbox, jobs: take jobs, slot: slot, c: c, ms: ms) = take worker
    while let Ok(take job) = channel.receive(jobs) {
        let RefusalJob(socket: take socket, at: at) = take job
        let until = after_ms(at, ms)
        let (input, output) = net.split(take socket)
        let mut w = take output
        let _ = reply_error(mut w, 503, c, until)
        let _ = net.finish(take w, take input, c, until)
        if let Error(_) = channel.send(inbox, Refused(slot)) {
            return
        }
    }
}

type RefusalSlot {
    child: Task[()],
    tx: Sender[RefusalJob],
    busy: bool
}

type HttpSlot {
    child: Task[()],
    first: bool,
    ip: (u64, u64, u64)
}

resource type ServerTasks {
    connections: List[Option[HttpSlot]],
    refusals: List[RefusalSlot],
    acceptors: List[Task[()]]
} drop(group) {
    for i in 0u64 .. list.len(group.acceptors) {
        task.cancel(mut group.acceptors[i])
    }
    for i in 0u64 .. list.len(group.refusals) {
        task.cancel(mut group.refusals[i].child)
    }
    for i in 0u64 .. list.len(group.connections) {
        let slot = replace(mut group.connections[i], None)
        if let Some(take held) = take slot {
            let mut active = take held
            task.cancel(mut active.child)
            group.connections[i] = Some(take active)
        }
    }
}

fn refuse(mut slots: List[RefusalSlot], take socket: Socket, at: u64) {
    for i in 0u64 .. list.len(slots) {
        if !slots[i].busy {
            let job = RefusalJob(socket: take socket, at: at)
            if let Ok(()) = channel.try_send(slots[i].tx, take job) {
                slots[i].busy = true
            }
            return
        }
    }
}

fn bytes_for_connection(cfg: Config) -> u64 {
    let input = cfg.head_max + cfg.pipeline_max + cfg.body_inline
    // List carriers are inline. MEM-24 rounds their allocations to 8.
    let read_bytes = (input + 7) / 8 * 8
    let write_bytes = (cfg.out_cap + 7) / 8 * 8
    // Head, decoder and cursors are inline. Reserve J and the one-slot
    // hand-over reply alongside the handler's allowance.
    read_bytes + write_bytes + 8192 + 1024 + 128 + cfg.handler_bytes
}

fn valid_config(cfg: Config) -> bool {
    if cfg.head_max == 0 || cfg.head_max > 8192 || cfg.fields_max > 64 || cfg.inbox_cap == 0 {
        return false
    }
    // Reserve only arithmetic room here. Actual population storage and
    // task allocations still use checked Capacity.
    let input_size = int.saturating_add(cfg.pipeline_max, cfg.body_inline)
    let with_output = int.saturating_add(input_size, cfg.out_cap)
    let total = int.saturating_add(with_output, cfg.handler_bytes)
    total <= 18446744073709551615 - 32768
}

fn source_key(ip: Ip) -> (u64, u64, u64) {
    match ip {
        V4(lo) => (4u64, 0u64, int.widen(lo)),
        V6(hi, lo) => if hi == 0 && lo >> 32 == 65535 {
            let v4: u32 = int.truncate(lo)
            (4u64, 0u64, int.widen(v4))
        } else {
            (6u64, hi, lo)
        },
    }
}

fn serve_alloc[T](take r: Result[T, Capacity]) -> Result[T, ServeError] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(e) => Error(Capacity(e)),
    }
}

/// Serves a group of listeners with one handler per connection. The raw
/// handler entry is also the seam for the router's later route selection.
pub fn serve[S: shareable + send](take listeners: List[Listener], c: Clock, tasks: Tasks, take cfg: Config, handler: fn(Request, Region, mut Body, S) -> Result[Outcome, ResponseError] waits, take state: S) -> Result[(), ServeError] waits {
    if !valid_config(cfg) {
        return Error(Configuration)
    }
    if list.len(listeners) == 0 {
        return Ok(())
    }
    let shared = serve_alloc(result.capacity_only(arc.new(take state)))?
    let settings = serve_alloc(result.capacity_only(arc.new(take cfg)))?
    let made: Result[(Sender[ConnectionSignal], Receiver[ConnectionSignal]), Capacity] = channel.new(settings.inbox_cap)
    let (tx, rx) = serve_alloc(take made)?
    let http_slots = order.min(settings.http_max, settings.sockets_max)
    let reserved: Result[List[Option[HttpSlot]], Capacity] = list.with_capacity(http_slots)
    let mut slots = serve_alloc(take reserved)?
    let returns: Result[(Sender[u64], Receiver[u64]), Capacity] = channel.new(order.max(http_slots, 1))
    let (done_tx, done_rx) = serve_alloc(take returns)?
    for _ in 0u64 .. http_slots {
        let _ = list.push(mut slots, None)
    }
    let refusal_slots: Result[List[RefusalSlot], Capacity] = list.with_capacity(settings.refuse_max)
    let refusals = serve_alloc(take refusal_slots)?
    let acceptor_slots: Result[List[Task[()]], Capacity] = list.with_capacity(list.len(listeners))
    let acceptors = serve_alloc(take acceptor_slots)?
    let allocated_group = ServerTasks(connections: take slots, refusals: take refusals, acceptors: take acceptors)
    let mut group = serve_alloc(result.capacity_only(take allocated_group))?
    for i in 0u64 .. settings.refuse_max {
        let allocated: Result[(Sender[RefusalJob], Receiver[RefusalJob]), Capacity] = channel.new(1)
        let (job_tx, jobs) = serve_alloc(take allocated)?
        let job = RefusalWorker(inbox: channel.sender(tx), jobs: take jobs, slot: i, c: c, ms: settings.refuse_ms)
        match task.spawn(tasks, bytes 8256, take job, refusal_worker) {
            Ok(take child) => {
                let _ = list.push(mut group.refusals, RefusalSlot(child: take child, tx: take job_tx, busy: false))
            },
            Error((e, _)) => return Error(Capacity(e)),
        }
    }
    let mut pending = take listeners
    while let Some(take listener) = list.pop(mut pending) {
        let job = AcceptorJob(listener: take listener, c: c, inbox: channel.sender(tx))
        match task.spawn(tasks, bytes 64, take job, acceptor) {
            Ok(take child) => {
                let _ = list.push(mut group.acceptors, take child)
            },
            Error((e, _)) => return Error(Capacity(e)),
        }
    }
    let child_bytes = bytes_for_connection(settings)
    let mut in_first_phase: u64 = 0
    while let Ok(take event) = channel.receive(rx) {
        match take event {
            Accepted(take socket, peer, at) => {
                let ip = source_key(peer)
                let mut from_ip: u64 = 0
                let mut vacant = http_slots
                for i in 0u64 .. http_slots {
                    match group.connections[i] {
                        Some(s) => {
                            if s.ip == ip {
                                from_ip += 1
                            }
                        },
                        None => {
                            if vacant == http_slots {
                                vacant = i
                            }
                        },
                    }
                }
                if vacant == http_slots || from_ip >= settings.ip_sockets_max || in_first_phase >= settings.conns_max {
                    refuse(mut group.refusals, take socket, at)
                } else {
                    let completion = match Completion(done: channel.sender(done_tx), wake: channel.sender(tx), slot: vacant, armed: false) {
                        Ok(take x) => take x,
                        Error(_) => {
                            refuse(mut group.refusals, take socket, at)
                            continue
                        },
                    }
                    let job = ConnectionJob(socket: take socket, c: c, cfg: arc.share(settings), peer: peer, at: at, handler: handler, state: arc.share(shared), inbox: channel.sender(tx), slot: vacant, completion: take completion)
                    match task.spawn(tasks, bytes child_bytes, take job, connection) {
                        Ok(take child) => {
                            group.connections[vacant] = Some(HttpSlot(child: take child, first: true, ip: ip))
                            in_first_phase += 1
                        },
                        Error((_, take refused)) => {
                            let ConnectionJob(socket: take declined, c: _, cfg: _, peer: _, at: _, handler: _, state: _, inbox: _, slot: _, completion: _) = take refused
                            refuse(mut group.refusals, take declined, at)
                        },
                    }
                }
            },
            Source(slot, next_ip, take reply) => {
                let ip = source_key(next_ip)
                let mut from_ip: u64 = 0
                for i in 0u64 .. http_slots {
                    if let Some(s) = group.connections[i] {
                        if s.ip == ip {
                            from_ip += 1
                        }
                    }
                }
                let allowed = from_ip < settings.ip_sockets_max
                if allowed {
                    let current = replace(mut group.connections[slot], None)
                    if let Some(take session) = take current {
                        let mut s = take session
                        s.ip = ip
                        group.connections[slot] = Some(take s)
                    }
                }
                let _ = channel.try_send(reply, allowed)
            },
            FirstResponse(slot) => {
                let current = replace(mut group.connections[slot], None)
                match take current {
                    Some(take session) => {
                        let mut s = take session
                        s.first = false
                        group.connections[slot] = Some(take s)
                        in_first_phase -= 1
                    },
                    None => {},
                }
            },
            EndNotice => {},
            Refused(slot) => {
                group.refusals[slot].busy = false
            },
            ListenerFailed(e) => return Error(Network(e)),
        }
        while let Ok(slot) = channel.try_receive(done_rx) {
            let ended = replace(mut group.connections[slot], None)
            if let Some(take s) = take ended {
                let HttpSlot(child: take child, first: first, ip: _) = take s
                let _ = task.join(take child)
                if first {
                    in_first_phase -= 1
                }
            }
        }
    }
    Ok(())
}

/// Selects a request body boundary from the already parsed Head. No allocation.
/// HTTP-4 refuses ambiguous framing before interpreting any body bytes.
/// Ex: `http.framing(bytes, h, 1048576)`.
pub fn framing(b: Bytes, h: http1.Head, body_max: u64) -> Result[Framing, BodyError] {
    let mut lengths: u64 = 0
    let mut encodings: u64 = 0
    let mut length = http1.Span(start: 0, end: 0)
    let mut encoding = length
    for i in 0u64 .. h.count {
        let f = h.fields[i]
        let name = list.slice(b, f.name.start, f.name.end)
        if http1.equal_ascii(name, string.as_bytes("content-length")) {
            lengths += 1
            length = f.value
        }
        if http1.equal_ascii(name, string.as_bytes("transfer-encoding")) {
            encodings += 1
            encoding = f.value
        }
    }
    if lengths > 0 && encodings > 0 || lengths > 1 {
        return Error(failure(400))
    }
    if encodings > 0 {
        if h.version == 0 {
            return Error(failure(400))
        }
        if encodings != 1 || !http1.equal_ascii(list.slice(b, encoding.start, encoding.end), string.as_bytes("chunked")) {
            return Error(failure(501))
        }
        return Ok(Chunked)
    }
    if lengths == 0 {
        return Ok(Empty)
    }
    let n = length.end - length.start
    if n == 0 || n > 19 {
        return Error(failure(400))
    }
    let mut size: u64 = 0
    for i in length.start .. length.end {
        let c = b[i]
        if !int.is_ascii_digit(c) {
            return Error(failure(400))
        }
        let digit: u64 = int.widen(c - b'0')
        size = size * 10 + digit
    }
    if size > body_max {
        return Error(failure(413))
    }
    Ok(ContentLength(size))
}

type BodyState: key = Fixed | Size | SizeWs | ExtStart | ExtName | ExtNameWs | ExtValueStart | ExtToken | ExtQuote | ExtEscape | ExtAfter | ExtWs | ChunkLf | ChunkData | DataCr | DataLf | TrailerStart | TrailerName | TrailerValue | TrailerLf | TrailerEndLf | Finished | Broken

pub type Decoder {
    state: BodyState,
    used: u64,
    decoded: u64,
    remaining: u64,
    body_max: u64,
    size: u64,
    digits: u8,
    line_bytes: u64,
    trailer_bytes: u64,
    trailer_fields: u64,
    error: BodyError
}

pub type BodyProgress: key = More | Data(http1.Span) | Done | Failed(BodyError)

/// Starts a fixed-storage body decoder after framing succeeds. Head is read
/// only here; trailers can never change it. All errors permanently latch close.
/// Ex: `let mut d = http.decoder(frame, h, body_max)`.
pub fn decoder(frame: Framing, h: http1.Head, body_max: u64) -> Decoder {
    let mut d = Decoder(state: Finished, used: 0, decoded: 0, remaining: 0, body_max: body_max, size: 0, digits: 0, line_bytes: 0, trailer_bytes: h.end, trailer_fields: h.count, error: failure(400))
    match frame {
        Empty => {},
        ContentLength(n) => {
            d.remaining = n
            if n > 0 {
                d.state = Fixed
            }
        },
        Chunked => {
            d.state = Size
        }
    }
    d
}

fn fail(mut d: Decoder, status: u16) {
    d.error = failure(status)
    d.state = Broken
}

fn token(c: u8) -> bool {
    int.is_ascii_alpha(c) || int.is_ascii_digit(c) || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

fn whitespace(c: u8) -> bool {
    c == b' ' || c == 9
}

fn field_value(c: u8) -> bool {
    c == 9 || c >= 32 && c != 127
}

fn hex(c: u8) -> Option[u64] {
    if c >= b'0' && c <= b'9' {
        let digit: u64 = int.widen(c - b'0')
        return Some(digit)
    }
    let lower = int.to_ascii_lower(c)
    if lower >= b'a' && lower <= b'f' {
        let digit: u64 = int.widen(lower - b'a')
        return Some(digit + 10)
    }
    None
}

fn extension_end(c: u8, mut d: Decoder) {
    if c == b';' {
        d.state = ExtStart
    } else if c == 13 {
        d.state = ChunkLf
    } else if whitespace(c) {
        d.state = ExtWs
    } else {
        fail(mut d, 400)
    }
}

fn extension_name_end(c: u8, mut d: Decoder) {
    if c == b'=' {
        d.state = ExtValueStart
    } else if whitespace(c) {
        d.state = ExtNameWs
    } else {
        extension_end(c, mut d)
    }
}

fn chunk_line(c: u8, mut d: Decoder) {
    match d.state {
        Size => {
            match hex(c) {
                Some(digit) => {
                    if d.digits == 16 || d.size > (18446744073709551615u64 - digit) / 16 {
                        fail(mut d, 400)
                    } else {
                        d.size = d.size * 16 + digit
                        d.digits += 1
                    }
                },
                None => {
                    if d.digits == 0 {
                        fail(mut d, 400)
                    } else if whitespace(c) {
                        d.state = SizeWs
                    } else {
                        extension_end(c, mut d)
                    }
                }
            }
        },
        SizeWs => {
            if c == b';' {
                d.state = ExtStart
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtStart => {
            if token(c) {
                d.state = ExtName
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtName => {
            if !token(c) {
                extension_name_end(c, mut d)
            }
        },
        ExtNameWs => {
            if c == b'=' {
                d.state = ExtValueStart
            } else if c == b';' {
                d.state = ExtStart
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtValueStart => {
            if c == b'"' {
                d.state = ExtQuote
            } else if token(c) {
                d.state = ExtToken
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ExtToken => {
            if !token(c) {
                extension_end(c, mut d)
            }
        },
        ExtQuote => {
            if c == b'"' {
                d.state = ExtAfter
            } else if c == b'\\' {
                d.state = ExtEscape
            } else if !field_value(c) {
                fail(mut d, 400)
            }
        },
        ExtEscape => {
            if field_value(c) {
                d.state = ExtQuote
            } else {
                fail(mut d, 400)
            }
        },
        ExtAfter => extension_end(c, mut d),
        ExtWs => {
            if c == b';' {
                d.state = ExtStart
            } else if !whitespace(c) {
                fail(mut d, 400)
            }
        },
        ChunkLf => {
            if c != 10 {
                fail(mut d, 400)
            } else if d.size > d.body_max - d.decoded {
                fail(mut d, 413)
            } else {
                d.remaining = d.size
                if d.size == 0 {
                    d.state = TrailerStart
                } else {
                    d.state = ChunkData
                }
                d.size = 0
                d.digits = 0
                d.line_bytes = 0
            }
        },
        _ => {}
    }
}

fn in_trailers(state: BodyState) -> bool {
    state == TrailerStart || state == TrailerName || state == TrailerValue || state == TrailerLf || state == TrailerEndLf
}

fn trailer(c: u8, mut d: Decoder) {
    match d.state {
        TrailerStart => {
            if c == 13 {
                d.state = TrailerEndLf
            } else if !token(c) {
                fail(mut d, 400)
            } else if d.trailer_fields == 64 {
                fail(mut d, 431)
            } else {
                d.trailer_fields += 1
                d.state = TrailerName
            }
        },
        TrailerName => {
            if c == b':' {
                d.state = TrailerValue
            } else if !token(c) {
                fail(mut d, 400)
            }
        },
        TrailerValue => {
            if c == 13 {
                d.state = TrailerLf
            } else if !field_value(c) {
                fail(mut d, 400)
            }
        },
        TrailerLf => {
            if c == 10 {
                d.state = TrailerStart
            } else {
                fail(mut d, 400)
            }
        },
        TrailerEndLf => {
            if c == 10 {
                d.state = Finished
            } else {
                fail(mut d, 400)
            }
        },
        _ => {}
    }
}

/// Consumes a fresh input fragment, returning one body span at a time. used
/// counts bytes consumed from THIS call's input, including framing bytes.
/// Pass its unconsumed suffix to the next call. More needs more network bytes;
/// Done leaves the pipelined tail untouched. Data is a view into this input.
/// Ex: `http.decode(mut d, input)`.
pub fn decode(mut d: Decoder, b: Bytes) -> BodyProgress {
    d.used = 0
    loop {
        if d.state == Finished {
            return Done
        }
        if d.state == Broken {
            return Failed(d.error)
        }
        if d.used == list.len(b) {
            if in_trailers(d.state) && d.trailer_bytes == 8192 {
                fail(mut d, 431)
                continue
            }
            if d.line_bytes == 1024 {
                fail(mut d, 400)
                continue
            }
            return More
        }
        if d.state == Fixed || d.state == ChunkData {
            let start = d.used
            let n = order.min(d.remaining, list.len(b) - start)
            d.used += n
            d.remaining -= n
            d.decoded += n
            if d.remaining == 0 {
                if d.state == Fixed {
                    d.state = Finished
                } else {
                    d.state = DataCr
                }
            }
            return Data(http1.Span(start: start, end: d.used))
        }
        let c = b[d.used]
        d.used += 1
        if in_trailers(d.state) {
            if d.trailer_bytes == 8192 {
                fail(mut d, 431)
            } else {
                d.trailer_bytes += 1
                trailer(c, mut d)
            }
        } else if d.state == DataCr {
            if c == 13 {
                d.state = DataLf
            } else {
                fail(mut d, 400)
            }
        } else if d.state == DataLf {
            if c == 10 {
                d.state = Size
            } else {
                fail(mut d, 400)
            }
        } else {
            if d.line_bytes == 1024 {
                fail(mut d, 400)
            } else {
                d.line_bytes += 1
                chunk_line(c, mut d)
            }
        }
    }
}

/// End of input is successful only after Done. Truncation permanently closes
/// the connection, including a short Content-Length body or unfinished CRLF.
/// Ex: `http.body_eof(mut d)`.
pub fn body_eof(mut d: Decoder) -> Result[(), BodyError] {
    if d.state == Finished {
        return Ok(())
    }
    if d.state != Broken {
        fail(mut d, 400)
    }
    Error(d.error)
}

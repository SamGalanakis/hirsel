// rule: MODE-1
// expect: reject MODE-1 at line 10
// twin: MODE/MODE-6-recorder-run.hir
// "finish consumes the recorder once no borrow of it remains."
fn example() -> () {
  let r: Recorder[u64] = recorder.new()
  let note = fn() {
    recorder.append(r, 1u64)
  }
  let xs: List[u64] = recorder.finish(take r)
  note()
}

// Captured List custody moves into the closure; a refused admission raises and drops it.
// The empty list's own charge is zero, its carrier capture costs 24.
// expect: run refused() = 24 used 32
// expect: run success() = 0
fn refused() -> u64 {
    let outer = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 0 {
            let xs: List[u64] = list.new()
            let cb: own[send] fn() -> u64 = fn() -> u64 {
                list.len(xs)
            }
            cb()
        }
    })
    match caught(take outer) {
        Some(c) => c.requested,
        None => 0
    }
}

fn success() -> u64 {
    let xs: List[u64] = list.new()
    let cb: own[send] fn() -> u64 = fn() -> u64 {
        list.len(xs)
    }
    cb()
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

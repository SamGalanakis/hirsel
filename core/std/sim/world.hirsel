/// The clock controller and the initial stream for a simulation.
pub opaque type World: send {
    seed: u64,
    // None once `clocks` has taken the hand: the world's clock is then driven.
    hand: Option[ClockHand],
    // The clock's reading after the world's last advance.
    now: u64,
    plan: Plan
}

/// An owned stream and one-shot faults. Give each server its own plan at setup
/// so scheduling between servers cannot change which server consumes a draw.
pub opaque type Plan: send {
    state: u64,
    faults: Map[u64, Fault],
    writes: WriteFaults,
    scripted: Option[Draws]
}

type Draws: send {
    words: List[u64],
    next: u64
}

/// Prefixes indexed by provider, followed by independent SplitMix64 tails.
pub type Script: send {
    tail_seed: u64,
    streams: List[List[u64]]
}

/// SyncUnknown may commit a barrier before reporting EIO. The three storage
/// faults acknowledge the write while changing the bytes the disk presents.
pub type Fault = Eio | SyncUnknown | Corrupt | Misdirect | LostWrite

/// What a tapped std.sim.fs server did at one fault or one damaged read, for
/// test oracles; nothing in the provider reads it back. `mount` counts the
/// image's serves and `site` is the request's fault site in that serve. `node`
/// is the stable inode and `path` its name when served (`/s/j-1`), `[at, at +
/// len)` the requested range and `landed` where a write's bytes went.
/// `sequence` (the image's operation count) and `crashes` order it against
/// barriers and power cuts.
pub type Receipt: send {
    mount: u64,
    site: u64,
    op: String,
    node: u64,
    path: String,
    at: u64,
    len: u64,
    landed: u64,
    fault: Option[Fault],
    outcome: Outcome,
    sequence: u64,
    crashes: u64
}

/// `Refused`: the reply was EIO. `Barrier`: a failed sync, true if it took
/// effect. `Acknowledged`: a write reported Done but changed other bytes.
/// `DamagedRead`: a read or stat answered differently from the written bytes.
/// `Undelivered`: the reply for that site never reached the caller.
pub type Outcome = Refused | Barrier(bool) | Acknowledged | DamagedRead | Undelivered

/// Mutually exclusive chances per 10,000 nonempty filesystem writes.
pub type WriteFaults: send {
    corrupt: u64,
    misdirect: u64,
    lost_write: u64
}

fn no_write_faults() -> WriteFaults {
    WriteFaults(corrupt: 0, misdirect: 0, lost_write: 0)
}

/// Starts a virtual clock and seeds the decision stream.
pub fn new(seed: u64, start_mono_ns: u64, start_wall_ms: u64) -> (World, Clock) {
    let (c, h) = provide.clock(start_mono_ns, start_wall_ms)
    (World(seed: seed, hand: Some(take h), now: start_mono_ns, plan: plan(seed)), c)
}

pub fn initial_seed(w: World) -> u64 {
    w.seed
}

/// An independent decision stream beginning at seed.
pub fn plan(seed: u64) -> Plan {
    Plan(state: seed, faults: map.new(), writes: no_write_faults(), scripted: None)
}

fn mix(state: u64) -> u64 {
    let a = int.wrapping_mul(state ^ (state >> 30), 0xbf58476d1ce4e5b9)
    let b = int.wrapping_mul(a ^ (a >> 27), 0x94d049bb133111eb)
    b ^ (b >> 31)
}

fn draw(mut state: u64) -> u64 {
    state = int.wrapping_add(state, 0x9e3779b97f4a7c15)
    mix(state)
}

/// Gives a provider its own prefix and tail. A provider without a prefix
/// starts directly at its tail. Use stable provider IDs at setup.
pub fn plan_from(s: Script, provider: u64) -> Plan {
    let words: List[u64] = if provider < list.len(s.streams) {
        clone(s.streams[provider])
    } else {
        list.new()
    }
    Plan(state: mix(s.tail_seed ^ provider), faults: map.new(), writes: no_write_faults(), scripted: Some(Draws(words: take words, next: 0)))
}

fn show_word(word: u64, mut out: String) {
    string.push_u64(mut out, word)
}

pub fn show_script(s: Script, mut out: String) {
    string.push(mut out, "Script(")
    show_word(s.tail_seed, mut out)
    string.push(mut out, ", [")
    for i in 0u64 .. list.len(s.streams) {
        if i != 0 {
            string.push(mut out, ", ")
        }
        string.push(mut out, "[")
        let words = s.streams[i]
        for j in 0u64 .. list.len(words) {
            if j != 0 {
                string.push(mut out, ", ")
            }
            show_word(words[j], mut out)
        }
        string.push(mut out, "]")
    }
    string.push(mut out, "])")
}

/// Generates a tail seed and one shrinkable prefix per provider.
pub fn script_gen(providers: u64, max_draws: u64) -> prop.Gen[Script] {
    prop.make(fn(mut s: prop.Source) -> Script {
        let tail_seed = prop.word(mut s)
        let words = prop.list_of(prop.make(prop.word, show_word), 0, max_draws)
        let streams = prop.list_of(take words, providers, providers)
        Script(tail_seed, streams: prop.draw(mut s, streams))
    }, show_script)
}

fn scripted_word(mut scripted: Draws, mut state: u64) -> u64 {
    if scripted.next >= list.len(scripted.words) {
        return draw(mut state)
    }
    let word = scripted.words[scripted.next]
    scripted.next += 1
    word
}

/// Chooses an index in [0, n) from the plan. n must be positive.
pub fn pick(mut p: Plan, n: u64) -> u64 {
    let threshold = int.wrapping_neg(n) % n
    if let Some(mut scripted) = p.scripted {
        let (high, _) = int.mul_wide(scripted_word(mut scripted, mut p.state), n)
        return high
    }
    loop {
        let (high, low) = int.mul_wide(draw(mut p.state), n)
        if low >= threshold {
            return high
        }
    }
}

pub fn choose(mut w: World, n: u64) -> u64 {
    pick(mut w.plan, n)
}

/// Sets a one-shot fault at a site. A later setting for that site replaces it.
pub fn script(mut p: Plan, site: u64, f: Fault) {
    map.insert(mut p.faults, site, f)
}

pub fn fault(mut w: World, site: u64, f: Fault) {
    script(mut w.plan, site, f)
}

pub fn take_fault(mut p: Plan, site: u64) -> Option[Fault] {
    map.remove(mut p.faults, site)
}

pub fn set_write_faults(mut p: Plan, rates: WriteFaults) {
    if rates.corrupt > 10000 || rates.misdirect > 10000 - rates.corrupt || rates.lost_write > 10000 - rates.corrupt - rates.misdirect {
        fail("sim.world: write fault chances must sum to at most 10000")
    }
    p.writes = rates
}

/// Draws the next filesystem write fault. A disabled distribution consumes no
/// draws, preserving scripts and crash cuts that predate write faults.
pub fn write_fault(mut p: Plan) -> Option[Fault] {
    let misdirect = p.writes.corrupt + p.writes.misdirect
    let lost = misdirect + p.writes.lost_write
    if lost == 0 {
        return None
    }
    let roll = pick(mut p, 10000)
    if roll < p.writes.corrupt {
        Some(Corrupt)
    } else if roll < misdirect {
        Some(Misdirect)
    } else if roll < lost {
        Some(LostWrite)
    } else {
        None
    }
}

/// Moves the decision stream and its faults to a server. Future world draws
/// start from a new stream derived from the current one.
pub fn detach(mut w: World) -> Plan {
    let next = draw(mut w.plan.state)
    replace(mut w.plan, plan(next))
}

/// Drives virtual timers at quiescence. Returns when no timer remains.
pub fn run(mut w: World) waits {
    while step(mut w) {}
}

/// Waits for quiescence and advances the clock to the earliest pending
/// timer. False when there was none.
pub fn step(mut w: World) -> bool waits {
    if let Some(mut hand) = w.hand {
        return match clock.idle(mut hand) {
            Some(at) => {
                clock.advance_to(mut hand, at)
                w.now = order.max(w.now, at)
                true
            },
            None => false
        }
    }
    fail("sim.world: this world's clock is driven by sim.world.drive")
}

/// True once `clocks` has taken the world's hand.
pub fn driven(w: World) -> bool {
    match w.hand {
        Some(_) => false,
        None => true
    }
}

const ppm: u64 = 1000000

/// Several clocks advanced by one owner along the world clock's timeline.
pub opaque type Clocks: send {
    seed: u64,
    hands: List[Hand],
    steps: List[Jump],
    // Nanoseconds of the world clock since `clocks` took it.
    base: u64
}

type Hand: send {
    hand: Option[ClockHand],
    start: u64,
    rate_ppm: i64,
    pauses: List[Pause]
}

type Pause: send {
    start: u64,
    end: u64
}

type Jump: send {
    index: u64,
    at: u64,
    by_ns: u64
}

/// Takes the world's hand as clock 0, whose rate is exact. The world keeps
/// its seed and plan, and `run` and `step` refuse it from now on.
pub fn clocks(mut w: World) -> Clocks {
    let Some(take hand) = replace(mut w.hand, None) else {
        fail("sim.world: this world's clock is already driven")
    }
    let mut hands: List[Hand] = list.with_capacity(1)
    list.push(mut hands, Hand(hand: Some(take hand), start: w.now, rate_ppm: 0, pauses: list.new()))
    Clocks(seed: w.seed, hands: take hands, steps: list.new(), base: 0)
}

/// Adds a clock that reads `start_mono_ns` at the start of the timeline and
/// gains `rate_ppm` parts per million of elapsed time (loses, when negative).
/// Its index is the number of clocks added before it plus one.
pub fn drifting(mut c: Clocks, start_mono_ns: u64, start_wall_ms: u64, rate_ppm: i64) -> (u64, Clock) {
    if rate_ppm <= -1000000 || rate_ppm >= 1000000 {
        fail("sim.world: a clock rate must lie strictly between -1000000 and 1000000 ppm")
    }
    let (clock, take hand) = provide.clock(start_mono_ns, start_wall_ms)
    list.push(mut c.hands, Hand(hand: Some(take hand), start: start_mono_ns, rate_ppm, pauses: list.new()))
    (list.len(c.hands) - 1, clock)
}

/// Steps clock `index` forward by `by_ns` once `at_ns` nanoseconds of the
/// timeline have passed.
pub fn step_at(mut c: Clocks, index: u64, at_ns: u64, by_ns: u64) {
    if index >= list.len(c.hands) {
        fail("sim.world: no clock has that index")
    }
    list.push(mut c.steps, Jump(index, at: at_ns, by_ns))
}

/// Freezes clock `index` over the base timeline interval [start_ns, end_ns).
/// Pauses on the same clock must be nonempty and disjoint. Clock 0 can pause
/// too: the driver's timeline continues independently of its reading.
pub fn pause_at(mut c: Clocks, index: u64, start_ns: u64, end_ns: u64) {
    if index >= list.len(c.hands) || start_ns >= end_ns {
        fail("sim.world: a pause needs a clock index and a nonempty interval")
    }
    let mut i: u64 = 0
    for p in c.hands[index].pauses {
        if p.start >= end_ns {
            break
        }
        if p.end > start_ns {
            fail("sim.world: pauses on a clock must be disjoint")
        }
        i += 1
    }
    list.insert(mut c.hands[index].pauses, i, Pause(start: start_ns, end: end_ns))
}

/// Describes the run seed and the clock pauses in timeline order per clock.
pub fn repro(c: Clocks) -> String {
    let mut out: String = "sim seed "
    string.push_u64(mut out, c.seed)
    for index in 0u64 .. list.len(c.hands) {
        for p in c.hands[index].pauses {
            string.push(mut out, "; pause clock ")
            string.push_u64(mut out, index)
            string.push(mut out, " [")
            string.push_u64(mut out, p.start)
            string.push(mut out, ", ")
            string.push_u64(mut out, p.end)
            string.push(mut out, ")")
        }
    }
    take out
}

// A jump due while paused happens at the first instant outside the pause.
fn jump_time(h: Hand, when: u64) -> u64 {
    let mut at = when
    for p in h.pauses {
        if at < p.start {
            break
        }
        at = order.max(at, p.end)
    }
    at
}

fn awake(h: Hand, t: u64) -> u64 {
    let mut elapsed = t
    for p in h.pauses {
        if t <= p.start {
            break
        }
        elapsed -= order.min(t, p.end) - p.start
    }
    elapsed
}

// Monotonic drift uses awake time. Boot drift uses the whole timeline.
fn reading(c: Clocks, index: u64, t: u64, elapsed: u64) -> u64 {
    let h = c.hands[index]
    let rate: u64 = int.truncate(int.abs(h.rate_ppm))
    let drift = int.saturating_add(int.saturating_mul(elapsed / ppm, rate), (elapsed % ppm) * rate / ppm)
    let mut at = if h.rate_ppm >= 0 {
        int.saturating_add(h.start, int.saturating_add(elapsed, drift))
    } else {
        int.saturating_add(h.start, elapsed - drift)
    }
    for j in c.steps {
        if j.index == index && jump_time(h, j.at) <= t {
            at = int.saturating_add(at, j.by_ns)
        }
    }
    at
}

// The first timeline instant, not before the current one, at which clock
// `index` reads at least `deadline`.
fn reach(c: Clocks, index: u64, deadline: u64) -> Option[u64] {
    let h = c.hands[index]
    if reading(c, index, c.base, awake(h, c.base)) >= deadline {
        return Some(c.base)
    }
    let mut hi = 0xffffffffffffffffu64
    if reading(c, index, hi, awake(h, hi)) < deadline {
        return None
    }
    let mut lo = c.base
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if reading(c, index, mid, awake(h, mid)) >= deadline {
            hi = mid
        } else {
            lo = mid
        }
    }
    Some(hi)
}

fn earlier(a: Option[u64], b: u64) -> Option[u64] {
    match a {
        Some(x) if x <= b => Some(x),
        _ => Some(b)
    }
}

type Idle: send {
    index: u64,
    hand: ClockHand,
    deadline: Option[u64]
}

type Idler: send {
    index: u64,
    hands: Receiver[ClockHand],
    reports: Sender[Idle]
}

fn idler(take i: Idler) waits {
    let Idler(index, hands: take hands, reports: take reports) = take i
    while let Ok(take given) = channel.receive(hands) {
        let mut hand = take given
        let deadline = clock.idle(mut hand)
        if let Error(_) = channel.send(reports, Idle(index, hand: take hand, deadline)) {
            return
        }
    }
}

/// Advances every clock at quiescence. Each round waits until every task
/// waits, finds the first timeline instant at which some clock reaches its
/// earliest pending timer or a step falls due, and advances each clock in
/// index order to its reading at that instant. Returns after two rounds in a
/// row find nothing to advance to.
pub fn drive(take c: Clocks, tasks: Tasks) waits {
    let mut owned = take c
    let n = list.len(owned.hands)
    let (report, reports): (Sender[Idle], Receiver[Idle]) = channel.new(n)
    let mut feeds: List[Sender[ClockHand]] = list.with_capacity(n)
    let mut idlers: List[Task[()]] = list.with_capacity(n)
    for index in 0u64 .. n {
        let (feed, hands): (Sender[ClockHand], Receiver[ClockHand]) = channel.new(1)
        list.push(mut idlers, task.spawn(tasks, bytes 0, Idler(index, hands: take hands, reports: channel.sender(report)), idler))
        list.push(mut feeds, take feed)
    }
    let _ = take report
    let mut quiet = false
    let mut deadlines: List[Option[u64]] = list.with_capacity(n)
    list.fill(mut deadlines, n, None)
    loop {
        for index in 0u64 .. n {
            let Some(take hand) = replace(mut owned.hands[index].hand, None) else {
                fail("sim.world: a clock hand is missing")
            }
            if let Error(_) = channel.send(feeds[index], take hand) {
                fail("sim.world: a clock idler stopped")
            }
        }
        for _ in 0u64 .. n {
            let Ok(take idle) = channel.receive(reports) else {
                fail("sim.world: a clock idler stopped")
            }
            let Idle(index, hand: take hand, deadline) = take idle
            owned.hands[index].hand = Some(take hand)
            deadlines[index] = deadline
        }
        let mut next: Option[u64] = None
        for index in 0u64 .. n {
            if let Some(deadline) = deadlines[index] {
                if let Some(t) = reach(owned, index, deadline) {
                    next = earlier(next, t)
                }
            }
        }
        for j in owned.steps {
            let at = jump_time(owned.hands[j.index], j.at)
            if at > owned.base {
                next = earlier(next, at)
            }
        }
        let Some(t) = next else {
            if quiet {
                break
            }
            quiet = true
            continue
        }
        quiet = false
        owned.base = t
        for index in 0u64 .. n {
            let mono = reading(owned, index, t, awake(owned.hands[index], t))
            let boot = reading(owned, index, t, t)
            if let Some(mut hand) = owned.hands[index].hand {
                clock.advance_to_with_boot(mut hand, mono, boot)
            }
        }
    }
    list.clear(mut feeds)
    for take idler_task in take idlers {
        let _ = task.join(take idler_task)
    }
}

/// Reads the seed that `hirsel test --sim` provides to an Env parameter.
pub fn test_seed(e: Env) -> Option[u64] {
    match env.get(e, "HIRSEL_TEST_SIM_SEED") {
        Ok(Some(text)) => {
            let parsed: Result[u64, ParseError] = int.parse(text)
            match parsed {
                Ok(n) => Some(n),
                Error(_) => None
            }
        },
        _ => None
    }
}

pub type CampaignConfig {
    seed: u64,
    cases: u64,
    providers: u64,
    max_draws: u64,
    max_features: u64,
    case_steps: u64,
    case_bytes: u64
}

pub type ScriptCase: send {
    script: Script,
    index: u64,
    world_seed: u64
}

pub type CampaignResult {
    cases: u64,
    features: u64,
    failure: Option[ScriptCase]
}

type DrawPoint: key + send {
    provider: u64,
    site: u64,
    slot: u64,
    arity: u64
}

type Observation: send {
    point: DrawPoint,
    word: u64,
    outcome: u64
}

pub opaque type Feedback: send {
    draws: List[Observation],
    max_draws: u64
}

pub type ScriptRun: send {
    trial: ScriptCase,
    tasks: Tasks,
    feedback: Feedback
}

/// Records the consumed word and modeled outcome of a observation from a scripted plan.
pub fn pick_observed(mut p: Plan, mut feedback: Feedback, provider: u64, site: u64, arity: u64) -> u64 {
    if arity == 0 {
        fail("sim.world: a observation must have positive arity")
    }
    let word = if let Some(mut scripted) = p.scripted {
        scripted_word(mut scripted, mut p.state)
    } else {
        fail("sim.world: observed draws require a scripted plan")
    }
    let (outcome, _) = int.mul_wide(word, arity)
    if list.len(feedback.draws) < feedback.max_draws {
        let mut slot: u64 = 0
        for prior in feedback.draws {
            if prior.point.provider == provider {
                slot += 1
            }
        }
        list.push(mut feedback.draws, Observation(point: DrawPoint(provider, site, slot, arity), word, outcome))
    }
    outcome
}

/// The first word whose multiply-high observation chooses index at the given arity.
fn word_for(index: u64, arity: u64) -> u64 {
    let mut lo: u64 = 0
    let mut hi: u64 = 0xffffffffffffffff
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let (bucket, _) = int.mul_wide(mid, arity)
        if bucket < index {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

type Mutation {
    script: Script,
    point: DrawPoint,
    next: u64
}

/// Save the exercised prefix so appending a word sees the same earlier draws.
fn witness(s: Script, trace: Feedback, point: DrawPoint) -> Script {
    let mut candidate: Script = clone(s)
    let mut prefix: List[u64] = list.new()
    for observation in trace.draws {
        if observation.point.provider == point.provider && observation.point.slot <= point.slot {
            list.push(mut prefix, observation.word)
        }
    }
    for i in list.len(prefix) .. list.len(candidate.streams[point.provider]) {
        list.push(mut prefix, candidate.streams[point.provider][i])
    }
    candidate.streams[point.provider] = take prefix
    take candidate
}

fn feature(observation: Observation) -> (u64, u64, u64) {
    let (bucket, _) = int.mul_wide(word_for(observation.outcome, observation.point.arity), 16)
    (observation.point.provider, observation.point.site, bucket)
}

fn next_mutation(mut pending: List[Mutation]) -> Option[Script] {
    let Some(take pending_edit) = list.pop(mut pending) else {
        return None
    }
    let mut edit = take pending_edit
    let point = edit.point
    let count = order.min(point.arity, 16u64)
    let index = (point.arity / count) * edit.next + (point.arity % count) * edit.next / count
    let mut s: Script = clone(edit.script)
    s.streams[point.provider][point.slot] = word_for(index, point.arity)
    edit.next += 1
    if edit.next < count {
        list.push(mut pending, take edit)
    }
    Some(take s)
}

/// Runs one candidate per case, mutating observed draws from successful cases.
/// The callback records draws in provider order and supplies the law's verdict.
pub fn campaign(tasks: Tasks, cfg: CampaignConfig, make: scoped fn(u64) -> Script, law: fn(take ScriptRun) -> (bool, Feedback) waits) -> CampaignResult waits {
    let mut coverage: set.Set[(u64, u64, u64)] = set.new()
    let mut locations: set.Set[DrawPoint] = set.new()
    let mut pending: List[Mutation] = list.new()
    let max_draws = cfg.providers * cfg.max_draws
    for index in 0u64 .. cfg.cases {
        let choice = next_mutation(mut pending)
        let s = match take choice {
            Some(take candidate) => take candidate,
            None => make(int.wrapping_add(cfg.seed, index)),
        }
        let sample = ScriptCase(script: take s, index, world_seed: prop.world_seed(cfg.seed, index))
        let saved: ScriptCase = clone(sample)
        let input = ScriptRun(trial: take sample, tasks, feedback: Feedback(draws: list.new(), max_draws))
        let admitted = bound steps cfg.case_steps {
            task.try_spawn(tasks, bytes cfg.case_bytes, take input, law)
        }
        let Ok(Ok(take started)) = take admitted else {
            fail("sim.world: campaign case could not start within its resource limits")
        }
        let Ok((passed, take trace)) = task.join(take started) else {
            fail("sim.world: campaign case failed outside its law verdict")
        }
        let trial = take saved
        if !passed {
            return CampaignResult(cases: index + 1, features: set.len(coverage), failure: Some(take trial))
        }
        for observation in trace.draws {
            let key = feature(observation)
            if set.len(coverage) >= cfg.max_features || set.contains(coverage, key) {
                continue
            }
            set.insert(mut coverage, key)
            if observation.point.provider < cfg.providers && observation.point.provider < list.len(trial.script.streams) && observation.point.slot < cfg.max_draws && !set.contains(locations, observation.point) {
                set.insert(mut locations, observation.point)
                list.push(mut pending, Mutation(script: witness(trial.script, trace, observation.point), point: observation.point, next: 0))
            }
        }
    }
    CampaignResult(cases: cfg.cases, features: set.len(coverage), failure: None)
}

/// Encodes the words and list continuations consumed by script_gen.
pub fn script_tape(s: Script, providers: u64, max_draws: u64) -> List[u64] {
    if list.len(s.streams) != providers {
        fail("sim.world: script does not match the provider count")
    }
    let mut tape: List[u64] = list.new()
    list.push(mut tape, s.tail_seed)
    for stream in s.streams {
        if list.len(stream) > max_draws {
            fail("sim.world: script exceeds the generator's prefix limit")
        }
        for word in stream {
            list.push(mut tape, 1)
            list.push(mut tape, word)
        }
        if list.len(stream) < max_draws {
            list.push(mut tape, 0)
        }
    }
    take tape
}

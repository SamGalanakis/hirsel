; A standalone fixed span uses an 8-byte count, then n u64s. A pointer formed
; from its payload address is passed to a scalar reader. Region close refunds it.
core v1
sig g0 = (u64) -> (u64)
sig g1 = (ptr, u64) -> (u64)
inst n0 = test@0/spans/run [] []
inst n1 = test@0/spans/sum [] []
fn f0 = n0 g0 {
  addr a0 = v5 : u64
  addr a1 = v5 byte v2 : u64
  addr a2 = v7 index v8 : u64
b0(v0: u64):
  v1: ptr = region_open
  v2: u64 = const 8
  v3: u64 = wrapping_mul v0, v2
  v4: u64 = wrapping_add v3, v2
  v5: ptr, v6: u64 = alloc stable v4 align 8 charge v4 in v1
  address a0
  store a0, v0
  address a1
  v7: ptr = pointer a1
  v10: u64 = const 0
  jump b1(v10)
b1(v8: u64):
  v9: bool = lt v8, v0
  branch v9, b2, b3
b2:
  address a2
  store a2, v8
  v11: u64 = const 1
  v12: u64 = wrapping_add v8, v11
  jump b1(v12)
b3:
  v13: u64 = call f1 g1 (v7, v0)
  region_close v1
  return v13
}
fn f1 = n1 g1 {
  addr a0 = v0 index v3 : u64
b0(v0: ptr, v1: u64):
  v2: u64 = const 0
  jump b1(v2, v2)
b1(v3: u64, v4: u64):
  v5: bool = lt v3, v1
  branch v5, b2, b3
b2:
  address a0
  v6: u64 = read a0
  v7: u64 = wrapping_add v4, v6
  v8: u64 = const 1
  v9: u64 = wrapping_add v3, v8
  jump b1(v9, v7)
b3:
  return v4
}

pub opaque type StagedMigration {
    inner: catalog.DeclareState,
    plan: SchemaPlan,
    declared: bool,
    // The projectors the staged declaration registered, which activation
    // hands to the Db with its indexes.
    projectors: List[DeclaredProjector],
    first_table: u32,
    base_rows: pages.PageTree,
    rewrites: Map[(u32, Bytes), ()],
    // Queued Cold rewrites checked in the consuming `waits` call (§3.5).
    queued_rewrites: List[QueuedRewrite]
}

type ActivationRewrite: codec + send {
    id: u32,
    key: Bytes,
    value: Bytes
}

fn staged_migration(db: Db, take plan: SchemaPlan, declared: bool, take registered: List[DeclaredProjector]) -> StagedMigration {
    StagedMigration(inner: catalog.declaration_state(declaration_base(db)), plan: take plan, declared, projectors: take registered, first_table: catalog.next_table_id(db.schema), base_rows: pages.share_page_tree(pages.holder_heads(db.holders)[0].roots.collections), rewrites: map.new(), queued_rewrites: list.new())
}

/// The staged catalog and rows of a standalone install, read with `reader(db, _)`:
/// the install's counterpart of `staged_snapshot` on the export side.
pub fn staged_install_snapshot(db: Db, staged: StagedMigration) -> Snapshot {
    snapshot_from(db, 0u64, pages.holder_heads(db.holders)[0].head, staged.plan.schema.roots, int.saturating_add(staged.plan.schema.next_node, 1))
}

fn compare_rewrite(a: ActivationRewrite, id: u32, key: Bytes) -> Order {
    match order.compare(a.id, id) {
        Equal => list.compare_bytes(a.key, key),
        different => different,
    }
}

fn check_rewrite_indexes(plan: SchemaPlan, id: u32, schema: u16, key: Bytes, old: Bytes, raw: Bytes) -> Result[(), Error] {
    let mut records = byte_cursor(plan.schema.roots.catalog, Included(failure_result_from_rep(catalog.index_prefix(id))?), failure_result_from_rep(catalog.index_prefix(id + 1))?)?
    while let Some((name_key, encoded)) = failure_result_from_rep(catalog.next_bytes(mut records))? {
        let record = decode_catalog(encoded)?
        let Some(ix) = indexes.binding_for_schema(plan.bindings, id, schema, record) else {
            return Error(Stale(id))
        }
        let before = extract_index(ix, old, key)?
        let after = extract_index(ix, raw, key)?
        if before.keys != after.keys || before.payload != after.payload || before.sums != after.sums {
            return Error(Changed(failure_result_from_rep(catalog.declaration_index_name(name_key))?))
        }
    }
    Ok(())
}

pub fn stage_rewrite[K, V](mut staged: StagedMigration, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    let (take key, take logical, take raw, staged_range, schema_number, is_tiered) = {
        let plan = view staged.plan
        if !types.same(plan.store.hi, plan.store.lo, t.store.hi, t.store.lo) {
            return Error(Foreign)
        }
        let record = catalog_entry_in(plan.schema.roots.catalog, t.catalog_key)?
        if indexes.catalog_kind(record.record) != TableCollection || record.id != t.id {
            return Error(Stale(t.id))
        }
        let current = record.schemas[list.len(record.schemas) - 1]
        if t.readers.current != current.number || t.readers.schemas.value != current.schema || t.readers.schemas.key != record.key {
            return Error(Schema(int.widen(current.number)))
        }
        let key = failure_result_from_rep(catalog.encode_key(t.key, k))?
        let logical = failure_result_from_rep(catalog.logical_key(t.id, key))?
        // A table the staging replaced has its rows only in the staged range (v2.103).
        let staged_range = t.id >= staged.first_table
        let mut raw: Bytes = list.new()
        failure_result_from_rep(types.capacity(format.le(mut raw, int.widen(current.number), 2)))?
        std.codec.encode(t.readers.codec, v, mut raw) ?=> |_| Limit(Value)
        if list.len(raw) > staged.plan.schema.value_limit {
            return Error(Limit(Value))
        }
        let _ = row_value(t.readers, t.id, raw)?
        let tiered = if staged_range {
            table_is_tiered(plan.schema.roots.collections, t.id)?
        } else {
            table_is_tiered(staged.base_rows, t.id)?
        }
        (take key, take logical, take raw, staged_range, current.number, tiered)
    }
    if is_tiered {
        if !staged_range {
            for qr in staged.queued_rewrites {
                if !qr.staged_range && qr.id == t.id && qr.key == key {
                    return Error(Exists("rewrite"))
                }
            }
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut staged.queued_rewrites, 1)))?
        list.push(mut staged.queued_rewrites, QueuedRewrite(id: t.id, schema: schema_number, key: take key, logical: take logical, raw: take raw, staged_range: staged_range))
        return Ok(())
    }
    let live_bytes = {
        let plan = view staged.plan
        let found = if staged_range {
            pages.get_page_row(plan.schema.roots.collections, logical)
        } else {
            pages.get_page_row(staged.base_rows, logical)
        }
        let Some(old) = found else {
            return Error(Missing("row"))
        }
        check_rewrite_indexes(plan, t.id, schema_number, key, old, raw)?
        let mut kept = plan.schema.live
        if staged_range || !plan.schema.retained {
            if let Some(previous) = pages.get_page_row(plan.schema.roots.collections, logical) {
                kept -= entry(logical, previous)
            }
        }
        let live_bytes = int.saturating_add(kept, entry(logical, raw))
        failure_result_from_rep(catalog.over_ceiling(live_bytes, plan.schema.ceiling))?
        live_bytes
    }
    let address = (t.id, take key)
    if !staged_range && map.contains(staged.rewrites, address) {
        return Error(Exists("rewrite"))
    }
    let mut roots = pages.share_roots(staged.plan.schema.roots)
    let mut ids = staged.plan.schema.next_node
    let _ = failure_result_from_rep(catalog.insert_row(mut ids, mut roots, take logical, take raw))?
    // The staged range carries the edit, so the frame gets no row for it.
    if !staged_range {
        failure_result_from_rep(types.capacity(map.try_reserve(mut staged.rewrites, 1)))?
        map.insert(mut staged.rewrites, take address, ())
    }
    staged.plan.schema.roots = take roots
    staged.plan.schema.next_node = ids
    staged.plan.schema.live = live_bytes
    staged.plan.schema.changed = true
    Ok(())
}

fn stage_system_table[K, V](mut plan: SchemaPlan, name: String, key: std.codec.Key[K], value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let exists = match pages.get_page_row(plan.schema.roots.catalog, failure_result_from_rep(catalog.table_key(name))?) {
        Some(_) => true,
        None => false
    }
    if !exists {
        stage_create_table(mut plan, name, key, value)?
    }
    stage_table(mut plan, name, key, value)
}

fn stage_system_put[K, V](mut plan: SchemaPlan, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    let p = failure_result_from_rep(catalog.logical_key(t.id, failure_result_from_rep(catalog.encode_key(t.key, k))?))?
    let mut raw: Bytes = list.new()
    failure_result_from_rep(types.capacity(format.le(mut raw, int.widen(t.readers.current), 2)))?
    std.codec.encode(t.readers.codec, v, mut raw) ?=> |_| Limit(Value)
    if list.len(raw) > plan.schema.value_limit {
        return Error(Limit(Value))
    }
    let mut live_bytes = plan.schema.live
    if !plan.schema.retained {
        if let Some(old) = pages.get_page_row(plan.schema.roots.collections, p) {
            live_bytes -= entry(p, old)
        }
    }
    live_bytes = int.saturating_add(live_bytes, entry(p, raw))
    failure_result_from_rep(catalog.over_ceiling(live_bytes, plan.schema.ceiling))?
    let _ = failure_result_from_rep(catalog.insert_row(mut plan.schema.next_node, mut plan.schema.roots, take p, take raw))?
    plan.schema.live = live_bytes
    plan.schema.changed = true
    plan.step_drift = true
    Ok(())
}

pub fn stage_activation[V](mut staged: StagedMigration, release_at: u64, previous: Option[Bytes], current: Bytes, codec: std.codec.Codec[V], release: V) -> Result[(), Error] {
    let activation = stage_system_table(mut staged.plan, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes())?
    let releases = stage_system_table(mut staged.plan, "hirsel.runner.releases", std.codec.key_u64(), codec)?
    if let Some(old) = previous {
        stage_system_put(mut staged.plan, activation, 1u8, old)?
    }
    stage_system_put(mut staged.plan, activation, 0u8, current)?
    stage_system_put(mut staged.plan, releases, release_at, release)
}

pub fn install_activation(mut db: Db, take staged: StagedMigration) -> Result[(), Error] waits {
    if object_writer_open(db) {
        return Error(Missing("binding"))
    }
    install_activation_layout(mut db, take staged, None)
}

pub fn install_bound_activation(mut db: Db, take staged: StagedMigration, activation: u64, schema_binding: Bytes) -> Result[(), Error] waits {
    let update = if object_writer_open(db) {
        if list.len(schema_binding) != 32 {
            return Error(Missing("binding"))
        }
        let Some(expected) = int.checked_add(pages.holder_heads(db.holders)[0].head, 1) else {
            return Error(Limit(Ids))
        }
        if activation != expected {
            return Error(NotCurrent(pages.holder_heads(db.holders)[0].head))
        }
        let mut digest: Inline[u8, 32] =[0; 32]
        for i in 0u64 .. 32 {
            digest[i] = schema_binding[i]
        }
        Some(history.HistoryActivation(number: activation, binding: digest))
    } else {
        None
    }
    install_activation_layout(mut db, take staged, update)
}

fn install_activation_layout(mut db: Db, take staged: StagedMigration, activation: Option[history.HistoryActivation]) -> Result[(), Error] waits {
    if !catalog.same_declaration_base(staged.inner, declaration_base(db)) {
        return Error(Foreign)
    }
    let mut working_staged = take staged
    if list.len(working_staged.queued_rewrites) != 0 {
        let backend: pager.TieredPageBackend = match pager.pager_requests(db.pager) {
            Some(sender) => PagerTask(channel.sender(sender)),
            None => PagerDirect(log_directory(db)?, store_key_to_rep(db.store)),
        }
        let mut no_cut: Option[ChildCutContext] = None
        let _ = resolve_queued_rewrites(take backend, pager.pin_partition(db.pager), open_number(db), db.store, mut working_staged, mut no_cut)?
    }
    let StagedMigration(plan: take staged_plan, declared: declared, projectors: take registered, ..) = take working_staged
    let mut plan = take staged_plan
    // A declaration's publish registers its bindings into an empty registry
    // after any hot Tiered index build has read its extractor (§13.10a).
    let registration = if declared {
        Some((indexes.take_registry(mut db.indexes), replace(mut plan.schema.retention, list.new())))
    } else {
        None
    }
    let old_fence = if is_disk(db) {
        catalog.propose_fence(mut db.schema, 1)
    } else {
        catalog.current_fence(db.schema)
    }
    match publish_schema_plan_binding(mut db, take plan, activation, None) {
        Ok(_) => {
            if let Some((_, take retained)) = take registration {
                db.projectors = take registered
                bind_retention(mut db, take retained)
            }
            Ok(())
        },
        Error(take problem) => {
            if let Some((take former, _)) = take registration {
                indexes.restore_registry(mut db.indexes, take former)
            }
            catalog.restore_fence(mut db.schema, old_fence);
            Error(take problem)
        }
    }
}

fn publish_schema_plan(mut db: Db, take prepared: SchemaPlan) -> Result[Ticket, Error] waits {
    publish_schema_plan_binding(mut db, take prepared, None, None)
}

// `drop_pin` is the import pin an install removes in the same cut (§3.5a).
// A plan with hot Tiered builds runs them first, and the cut drops the build
// pin instead (§13.10a); an install's plan never queues one.
fn publish_schema_plan_binding(mut db: Db, take staged: SchemaPlan, activation: Option[history.HistoryActivation], drop_pin: Option[u64]) -> Result[Ticket, Error] waits {
    let mut prepared = take staged
    let mut dropped = drop_pin
    if list.len(prepared.pending_migrates) != 0 || list.len(prepared.pending_indexes) != 0 {
        dropped = run_hot_builds(mut db, mut prepared)?
    }
    let SchemaPlan(schema: catalog.SchemaPlan(roots: take roots, next_node: ids, next_table: tables, live: live_bytes, superseded: take superseded, ..), bindings: take bindings, chunk_freed: take chunk_freed, step_rows: take step_rows, step_drift: step_drift, ..) = take prepared
    failure_result_from_rep(catalog.over_ceiling(live_bytes, available_resident(db)))?
    // Schema commits are main's (section 1.2). Installed only after the cut.
    let replacement = ProposedMain(roots: take roots, head: pages.holder_heads(db.holders)[0u64].head + 1, at: pages.holder_heads(db.holders)[0u64].at, tables: tables, activation, drop_pin: dropped, superseded: take superseded, chunk_freed: take chunk_freed, step_rows: take step_rows, step_drift: step_drift)
    let publication = failure_result_from_rep(types.capacity(prepare_publication(db, 0, replacement.head, replacement.roots, ids)))?
    // Stamps stay consumed on refusal. Table ids publish with the roots.
    pages.set_next_node(mut db.holders, ids)
    indexes.install_bindings(mut db.indexes, take bindings)
    let commit_ticket = cut_install(mut db, ReplaceMain(take replacement, None))?
    publish(take publication)
    db.attention_seq = int.saturating_add(db.attention_seq, 1)
    Ok(commit_ticket)
}

fn encode_rewrite_frame(staged: StagedMigration, take extra: List[ActivationRewrite]) -> Result[Option[Bytes], DeployError] {
    if map.len(staged.rewrites) == 0 && list.len(extra) == 0 {
        return Ok(None)
    }
    let mut rows: List[ActivationRewrite] = list.new()
    let mut size = 4u64
    let limit = option.unwrap(manifest.disk_kind_limit(0x0085))
    for ((id, key), _) in staged.rewrites {
        let logical = deploy_result(failure_result_from_rep(catalog.logical_key(id, key)))?
        let Some(raw) = pages.get_page_row(staged.plan.schema.roots.collections, logical) else {
            return Error(Store(Missing("row")))
        }
        size = int.saturating_add(size, 12 + list.len(key) + list.len(raw))
        if size > limit {
            return Error(Scratch(Limit(Triggers)))
        }
        list.push(mut rows, ActivationRewrite(id, key: deploy_result(failure_result_from_rep(types.copied(key)))?, value: deploy_result(failure_result_from_rep(types.copied(raw)))?))
    }
    for take row in take extra {
        size = int.saturating_add(size, 12 + list.len(row.key) + list.len(row.value))
        if size > limit {
            return Error(Scratch(Limit(Triggers)))
        }
        list.push(mut rows, take row)
    }
    list.sort(mut rows, fn(a: ActivationRewrite, b: ActivationRewrite) -> Order {
        compare_rewrite(a, b.id, b.key)
    })
    let codec: std.codec.Codec[List[ActivationRewrite]] = std.codec.of()
    let mut raw: Bytes = list.with_capacity(size)
    std.codec.encode(codec, rows, mut raw) ?=> |_| Scratch(Limit(Triggers))
    Ok(Some(take raw))
}

type PreparedInput {
    file: HostFile,
    ctx: format.DiskContext,
    offset: u64,
    digest: std.sha256.Sha256,
    peek: Option[u8]
}

fn prepared_read_input(mut input: PreparedInput, n: u64) -> Result[Bytes, Error] waits {
    if n == 0 {
        return Ok(list.new())
    }
    if let Some(first_byte) = replace(mut input.peek, None) {
        let mut out: Bytes = list.with_capacity(n)
        list.push(mut out, first_byte)
        if n > 1 {
            let rest = prepared_read(mut input.file, n - 1)?
            list.append(mut out, rest)
        }
        return Ok(take out)
    }
    prepared_read(mut input.file, n)
}

fn prepared_read(mut file: HostFile, n: u64) -> Result[Bytes, Error] waits {
    let mut out: Bytes = list.with_capacity(n)
    while list.len(out) < n {
        let room = n - list.len(out)
        // Keep the old temporary's admission before issuing the read.
        let charge = ((room + 7u64) / 8u64) * 8u64
        failure_result_from_rep(types.capacity(bound bytes charge {}))?
        if failure_result_from_rep(manifest.disk_io(host.read(mut file, mut out)))? == 0 {
            // The old temporary was still charged when the eight-byte name
            // was cloned. Check both charges before cloning in the caller.
            if let Error(c) = bound bytes (charge + 8u64) {} {
                return Error(Full(Allocation(Capacity(requested: 8, available: c.available - charge))))
            }
            return Error(failure_from_rep(format.disk_fault("PREPARED", list.len(out), Truncated)))
        }
    }
    Ok(take out)
}

fn prepared_frame[T](mut input: PreparedInput, kind: u16, codec: std.codec.Codec[T]) -> Result[T, DeployError] waits {
    let raw = scratch_result(prepared_read_input(mut input, 16u64))?
    let encoded = prepared_payload(mut input, kind, raw)?
    match std.codec.decode(codec, encoded) {
        Error(_) => Error(ImportMalformed),
        Ok(take value) => Ok(take value),
    }
}

fn prepared_payload(mut input: PreparedInput, kind: u16, raw: Bytes) -> Result[Bytes, DeployError] waits {
    let n = format.read_le(raw, 4u64, 4u64)
    if format.read_le(raw, 0u64, 2u64) != int.widen(kind) || format.read_le(raw, 2u64, 2u64) != 1u64 || n > option.unwrap(manifest.disk_kind_limit(kind)) {
        return Error(ImportMalformed)
    }
    let encoded = scratch_result(prepared_read(mut input.file, n))?
    let check = deploy_result(failure_result_from_rep(types.capacity(format.disk_check(input.ctx, input.offset, list.slice(raw, 0u64, 8u64), encoded))))?
    if check != format.read_le(raw, 8u64, 8u64) {
        return Error(ImportMalformed)
    }
    std.sha256.add(mut input.digest, raw, 0u64, 16u64)
    std.sha256.add(mut input.digest, encoded, 0u64, n)
    input.offset += 16u64 + n
    Ok(take encoded)
}

fn read_rewrite_frame(mut input: PreparedInput) -> Result[List[ActivationRewrite], DeployError] waits {
    let mut first: Bytes = list.with_capacity(1)
    if let Some(peeked) = replace(mut input.peek, None) {
        list.push(mut first, peeked)
    } else if scratch_result(failure_result_from_rep(manifest.disk_io(host.read(mut input.file, mut first))))? == 0 {
        return Ok(list.new())
    }
    if first[0] != 0x85 {
        return Error(ImportMalformed)
    }
    let rest = scratch_result(prepared_read(mut input.file, 15))?
    list.append(mut first, rest)
    let offset = input.offset
    let payload = prepared_payload(mut input, 0x0085, first)?
    let codec: std.codec.Codec[List[ActivationRewrite]] = std.codec.of()
    let rewrites = std.codec.decode(codec, payload) ?=> |_| Scratch(failure_from_rep(format.disk_fault("PREPARED", offset, Malformed)))
    if list.len(rewrites) == 0 {
        return Error(ImportMalformed)
    }
    for i in 0u64 .. list.len(rewrites) {
        let row = rewrites[i]
        if list.len(row.value) > VALUE_LIMIT || (i != 0 && compare_rewrite(rewrites[i - 1], row.id, row.key) != Less) {
            return Error(ImportMalformed)
        }
    }
    list.clear(mut first)
    if scratch_result(failure_result_from_rep(manifest.disk_io(host.read(mut input.file, mut first))))? != 0 {
        return Error(ImportMalformed)
    }
    Ok(take rewrites)
}

fn validate_rewrite_base(db: Db, imported: ValidatedImport) -> Result[(), DeployError] {
    if list.len(imported.rewrites) == 0 {
        return Ok(())
    }
    let Some(lease) = disk_state(db).lease else {
        return Error(ExportMismatch)
    }
    let tree = view lease.collections
    for row in imported.rewrites {
        if row.id == 0 || row.id >= imported.meta.base.next_table {
            return Error(ImportMalformed)
        }
        if let Ok(_) = list.binary_search_by(imported.ranges, scoped fn(checked_range: ValidatedRange) -> Order {
            order.compare(checked_range.id, row.id)
        }) {
            return Error(ImportMalformed)
        }
        if pages.collection_kind(tree, deploy_result(failure_result_from_rep(catalog.prefix(row.id)))?) != Some(TableCollection) {
            return Error(ImportMalformed)
        }
        let logical = failure_result_from_rep(catalog.logical_key(row.id, row.key)) ?=> |_| ImportMalformed
        let Some(_) = pages.get_page_row(tree, logical) else {
            return Error(ImportMalformed)
        }
    }
    Ok(())
}

fn apply_import_rewrites(mut plan: SchemaPlan, rewrites: List[ActivationRewrite]) -> Result[(), DeployError] {
    for row in rewrites {
        let key = deploy_result(failure_result_from_rep(catalog.logical_key(row.id, row.key)))?
        let raw = deploy_result(failure_result_from_rep(types.copied(row.value)))?
        let _ = deploy_result(failure_result_from_rep(catalog.insert_row(mut plan.schema.next_node, mut plan.schema.roots, take key, take raw)))?
    }
    Ok(())
}

/// The number of activation rewrites (frame 0x0085 rows) the import carries.
pub fn prepared_rewrites(value: ValidatedImport) -> u64 {
    list.len(value.rewrites)
}

/// The settlement PREPARED applies to the table that `name` names, the runner's pending
/// table (RUNNER-SPEC §14.3 "Preparing"). `base` holds OLD's rows of that table at the
/// exported base, `rewrites` PREPARED's 0x0085 rows, and `shipped` the rows of the range
/// PREPARED ships in its place (none when the table is dropped), each as (key after the
/// table id, stored value) in key order.
pub type ImportSettlement: send {
    base: List[(Bytes, Bytes)],
    rewrites: List[(Bytes, Bytes)],
    shipped: Option[List[(Bytes, Bytes)]]
}

/// `ImportSettlement` for `imported` over OLD's export lease. A rewrite of any other table
/// is `Unsettled`.
// The leased base's rows of collection `id`, each as (row key, stored
// value), read by the collection's own descriptor in `lease.collections`
// (§13.10a, L110): a Memory table from its resident pages, a Tiered one
// through the pager from the lease's own inventory, one row per attempt on
// OLD's writer partition.
fn leased_table_rows(db: Db, tree: pages.PageTree, id: u32) -> Result[List[(Bytes, Bytes)], DeployError] waits {
    let low = deploy_result(failure_result_from_rep(catalog.prefix(id)))?
    let high = deploy_result(failure_result_from_rep(catalog.prefix(id + 1)))?
    let mut base: List[(Bytes, Bytes)] = list.new()
    let Some((_, desc)) = std.page.collection_slot(tree.root, low) else {
        return Ok(take base)
    }
    if pages.collection_descriptor(desc).residency == ResidentMemory {
        let mut rows = deploy_result(byte_cursor(tree, Included(low), high))?
        while let Some((take logical, raw)) = deploy_result(failure_result_from_rep(catalog.next_bytes(mut rows)))? {
            list.push(mut base, (clone(list.slice(logical, 4, list.len(logical))), deploy_result(failure_result_from_rep(types.copied(raw)))?))
        }
        return Ok(take base)
    }
    let Some(inventory) = view tree.paging else {
        return Error(ImportMalformed)
    }
    let grant = deploy_result(disk_allocation(scoped fn() -> Result[Arc[pager.TieredReaderGrant], Error] {
        Ok(arc.new(pager.TieredReaderGrant(store: store_key_to_rep(db.store), opened: open_number(db), pin_bytes: pager.pin_partition(db.pager))))
    }))?
    let root = tiered_pin_root(open_number(db), 0u32, tree)
    let mut from = low
    loop {
        let backend: pager.TieredPageBackend = match pager.pager_requests(db.pager) {
            Some(sender) => PagerTask(channel.sender(sender)),
            None => PagerDirect(deploy_result(log_directory(db))?, store_key_to_rep(db.store)),
        }
        let empty_hint: Bytes = list.new()
        let step = deploy_result(retry_tiered_read_with(take backend, std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, empty_hint, None, TieredForward, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
            failure_result_from_rep(pager.tiered_span_row(attempt, visible, tree, from, high))
        }))?
        let Some((take logical, take raw)) = take step else {
            return Ok(take base)
        }
        from = deploy_result(failure_result_from_rep(pager.scan_page_after(logical)))?
        list.push(mut base, (clone(list.slice(logical, 4, list.len(logical))), deploy_result(failure_result_from_rep(types.copied(raw)))?))
    }
}

pub fn import_settlement(db: Db, imported: ValidatedImport, name: String) -> Result[ImportSettlement, DeployError] waits {
    let Some(lease) = disk_state(db).lease else {
        return Error(ExportMismatch)
    }
    let key = deploy_result(failure_result_from_rep(catalog.table_key(name)))?
    let mut old = 0u32
    if let Some(raw) = pages.get_page_row(pages.holder_heads(db.holders)[0].roots.catalog, key) {
        let record = deploy_result(decode_catalog(raw))?
        if indexes.catalog_kind(record.record) == TableCollection {
            old = record.id
        }
    }
    let base = if old != 0 {
        leased_table_rows(db, lease.collections, old)?
    } else {
        list.new()
    }
    let mut rewrites: List[(Bytes, Bytes)] = list.new()
    for row in imported.rewrites {
        if old == 0 || row.id != old {
            return Error(Unsettled)
        }
        list.push(mut rewrites, (clone(row.key), clone(row.value)))
    }
    let mut shipped: Option[List[(Bytes, Bytes)]] = None
    for change in imported.delta {
        if change.key != key {
            continue
        }
        let Some(after) = change.after else {
            shipped = Some(list.new())
            continue
        }
        let record = deploy_result(decode_catalog(after))?
        for checked_range in imported.ranges {
            if checked_range.id == record.id {
                let mut rows: List[(Bytes, Bytes)] = list.new()
                for row in checked_range.rows {
                    list.push(mut rows, (clone(row.key), clone(row.value)))
                }
                shipped = Some(take rows)
            }
        }
    }
    Ok(ImportSettlement(base: take base, rewrites: take rewrites, shipped: take shipped))
}

/// The migration fact of `imported` (launch.md "The settler"): the SHA-256 of its 0x0082
/// payloads in order, then each 0x0083 (id, kind) as 4 bytes little endian and 1 byte, and
/// the catalog key of each change.
pub fn import_migration(imported: ValidatedImport) -> Result[(Bytes, List[Bytes]), DeployError] {
    let codec: std.codec.Codec[CatalogChange] = std.codec.of()
    let mut hashed = std.sha256.start()
    let mut keys: List[Bytes] = list.new()
    for change in imported.delta {
        let mut raw: Bytes = list.new()
        std.codec.encode(codec, change, mut raw) ?=> |_| ImportMalformed
        std.sha256.add(mut hashed, raw, 0u64, list.len(raw))
        list.push(mut keys, clone(change.key))
    }
    for checked_range in imported.ranges {
        let id = checked_range.id
        let mut raw: Bytes = list.with_capacity(5u64)
        for shift in[0u32, 8u32, 16u32, 24u32] {
            list.push(mut raw, int.truncate(id >> shift))
        }
        list.push(mut raw, checked_range.kind)
        std.sha256.add(mut hashed, raw, 0u64, 5u64)
    }
    let mut digest: Bytes = list.with_capacity(32u64)
    for byte in std.sha256.finish(hashed) {
        list.push(mut digest, byte)
    }
    Ok((take digest, take keys))
}

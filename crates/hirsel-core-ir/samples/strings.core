; A refused growth explicitly unwraps Capacity; the literal it was growing is dropped first.
; CoreIR sample, family: string literals and text order (core.md "Literals", SEM-3, SEM-7,
; MEM-24, MEM-26), lowered as the crate docs' "Strings and literals" says: a literal is a
; carrier {static data, length, capacity 0}; storage exists exactly when the capacity is
; not 0, so cleanup frees nothing for it; growth from capacity 0 admits from the current
; limit and copies out of the static bytes; order is `rt.compare_bytes`.
;
; Source (package samples@0, module strings):
;   f0: fn push(grow: bool) {
;         let mut s = "hello";
;         if grow { string.push(mut s, "X") }    ; this producer grows to exactly len + 1
;         (byte_len(s), capacity, s <=> "hello", room left)
;       }
;   f1: fn order() { ("ab" <=> "abc", "abd" <=> "abc", "abc" <=> "abc", "ab" <=> "",
;                     "\x80" <=> "\x7f") }
; `a <=> b` is the order SEM-7 defines (-1, 0, 1), as the `==` and `<` lowerings read it.
; The room left is read by a probe allocation the root limit refuses (MEM-22).
;
; Behaviour, derived by hand. "hello" is 5 static bytes: carrier {d0, 5, 0}, nothing
; admitted, and its drop frees nothing (capacity 0). Pushing one byte needs 6 > 0: new
; storage of capacity 6, charged round8(6) = 8 against the current limit (MEM-24,
; MEM-26), the 5 bytes copied out of d0, nothing freed; the drop frees 8. "helloX" orders
; after "hello": equal for 5 bytes, then the longer one.
; run limit 1000: f0(false) -> 5, 0, 0, 1000 | used 0
; run limit 1000: f0(true) -> 6, 6, 1, 992 | used 0
; run limit 4: f0(true) -> fail Unwrap | used 0        ; 8 is refused; the literal frees nothing
; Bytes are unsigned and a proper prefix orders first (SEM-7); "" is a null pointer of
; length 0, never read:
; run: f1() -> -1, 1, 0, 1, 1 | used 0
core v1
type t0 = own "String" { bytes: seq u8 }
static d0 = align 1 hex 68656c6c6f
static d1 = align 1 hex 6162
static d2 = align 1 hex 616263
static d3 = align 1 hex 616264
static d4 = align 1 hex 80
static d5 = align 1 hex 7f
sig g0 = (bool) -> (u64, u64, i8, u64)
sig g1 = (ptr, u64, ptr, u64) -> (i8)
sig g2 = () -> (i8, i8, i8, i8, i8)
inst n0 = samples@0/strings/push [] []
inst n1 = samples@0/strings/order [] []
fn f0 = n0 g0 {
  slot s0 = t0                         ; s
  addr a0 = s0 field 0 byte v1 : ptr   ; the carrier's data pointer
  addr a1 = s0 field 0 byte v2 : u64   ; its length
  addr a2 = s0 field 0 byte v3 : u64   ; its capacity
  addr a3 = s0 : t0
  addr a4 = v7 : u8                    ; the new storage
  addr a5 = v4 : u8                    ; the literal's static bytes
  addr a6 = v7 byte v5 : u8            ; the pushed byte, after the old length
b0(v0: bool):
  live s0
  v1: u64 = const 0
  v2: u64 = const 8
  v3: u64 = const 16
  address a0
  address a1
  address a2
  v4: ptr = static d0
  v5: u64 = const 5
  store a0, v4
  store a1, v5
  store a2, v1                         ; capacity 0: static, owned by no one
  branch v0, b1, b3
b1:                                    ; 5 + 1 > 0: grow, from the current limit
  v6: u64 = const 6
  v7: ptr, v8: u64 = alloc own v6 align 1 charge v2
  v9: ptr = const 0x0
  v10: bool = ne v7, v9
  branch v10, b2, b4
b2:
  address a4
  address a5
  copy a4, a5, v5                      ; out of static data; nothing is freed
  address a6
  v11: u8 = const 88
  store a6, v11
  store a0, v7
  store a1, v6
  store a2, v6
  jump b3
b3:
  v12: ptr = read a0
  v13: u64 = read a1
  v14: u64 = read a2
  v15: i8 = call rt.compare_bytes g1 (v12, v13, v4, v5)
  v16: u64 = const 18446744073709551615
  v17: ptr, v18: u64 = alloc own v2 align 8 charge v16   ; refused: v18 is the room
  address a3
  drop a3 t0
  dead s0
  return v13, v14, v15, v18
b4:
  address a3
  drop a3 t0                           ; the literal: capacity 0, nothing freed
  dead s0
  raise unwrap
}
fn f1 = n1 g2 {
b0:
  v0: ptr = static d1
  v1: u64 = const 2
  v2: ptr = static d2
  v3: u64 = const 3
  v4: ptr = static d3
  v5: ptr = const 0x0
  v6: u64 = const 0
  v7: ptr = static d4
  v8: ptr = static d5
  v9: u64 = const 1
  v10: i8 = call rt.compare_bytes g1 (v0, v1, v2, v3)
  v11: i8 = call rt.compare_bytes g1 (v4, v3, v2, v3)
  v12: i8 = call rt.compare_bytes g1 (v2, v3, v2, v3)
  v13: i8 = call rt.compare_bytes g1 (v0, v1, v5, v6)
  v14: i8 = call rt.compare_bytes g1 (v7, v9, v8, v9)
  return v10, v11, v12, v13, v14
}

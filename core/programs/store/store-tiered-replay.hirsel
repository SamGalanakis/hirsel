pub type ReplayTieredAccount: shareable + send {
    total: u64,
    exact: bool
}

type TieredManifestRestore {
    next_node: u64,
    limits: types.LimitsRep,
    total: u64
}

fn tiered_manifest_restore(page_record: manifest.PageManifest) -> TieredManifestRestore {
    TieredManifestRestore(next_node: page_record.next_stamp - 1, limits: page_record.limits, total: page_record.account_tiered)
}

pub fn journal_replay_manifest(take state: pages.State, page_record: manifest.PageManifest) -> Result[JournalReplay, types.Failure] {
    let restore = tiered_manifest_restore(page_record)
    let mut replay = journal_replay(take state, restore.next_node, restore.limits)?
    replay.tiered.total = restore.total
    Ok(take replay)
}

pub type ReplayDescriptor {
    rows: u64,
    row_bytes: u64,
    seq_bounds: Option[pages.LogBoundsRep]
}

pub fn journal_collection_descriptor(raw: Bytes) -> (std.page_descriptor.CollectionKind, Option[ReplayDescriptor], u64) {
    let descriptor = pages.collection_descriptor(raw)
    let counts = if descriptor.residency == ResidentTiered {
        Some(tiered_replay_descriptor(raw, descriptor))
    } else {
        None
    }
    (descriptor.kind, counts, descriptor.rows)
}

fn tiered_replay_descriptor(raw: Bytes, fields: pages.CollectionDescriptor) -> ReplayDescriptor {
    let seq_bounds: Option[pages.LogBoundsRep] = if fields.kind == LogCollection {
        Some(descriptor_bounds(raw))
    } else {
        None
    }
    ReplayDescriptor(rows: fields.rows, row_bytes: fields.row_bytes, seq_bounds: seq_bounds)
}

pub fn prior_row_charge(key: Bytes, prior: u32) -> u64 {
    if prior == 0 {
        return 0
    }
    let width: u64 = int.widen(prior - 1)
    62 + format.round8(list.len(key)) + format.round8(width)
}

pub fn replay_charge(file: String, before: u64, removed: u64, added: u64) -> Result[u64, types.Failure] {
    let Some(remaining) = int.checked_sub(before, removed) else {
        return Error(format.disk_fault(file, 0, Malformed))
    }
    let Some(total) = int.checked_add(remaining, added) else {
        return Error(format.disk_fault(file, 0, Malformed))
    }
    Ok(total)
}

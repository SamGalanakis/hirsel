// Private S2 opener, final cut/handle rules. Journal durability and close's
// last-frame promise are exercised in S3 (T1); this law explicitly cuts first.
pub fn disk_law_db(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    let id = identity(db)
    let open_id = open_number(db)
    if open_id != 1 {
        return false
    }
    match open(tasks, d, c, r, options) {
        Error(Held) => {},
        _ => return false
    }
    let schema_ticket = result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if version(snapshot(db)) != 1 || schema_ticket.open != open_id {
        return false
    }
    match schema_ticket.mark {
        Cut(2) => {},
        _ => return false
    }
    result.unwrap(durable(mut db, schema_ticket))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = view t
    if version(snapshot(db)) != 1 || !typed_put(mut db, t, 1, 10) {
        return false
    }
    let held = snapshot(db)
    let reader_before_close = result.unwrap(reader(db, 0u64))
    let high = pages.holder_next_node(db.holders)
    let commit_ticket = result.unwrap(checkpoint(mut db))
    match commit_ticket.mark {
        Cut(3) => {},
        _ => return false
    }
    if version(snapshot(db)) != 2 {
        return false
    }
    result.unwrap(durable(mut db, commit_ticket))
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    if identity(reopened) != id || open_number(reopened) != 4 || version(snapshot(reopened)) != 2 || pages.holder_next_node(reopened.holders) < high {
        return false
    }
    if result.unwrap(get(result.unwrap(reader(reopened, 0u64)), snapshot(reopened), sh, 1)) != Some(10u64) || result.unwrap(get(reader_before_close, held, sh, 1)) != Some(10u64) {
        return false
    }
    match durable(mut reopened, commit_ticket) {
        Error(Foreign) => {},
        _ => return false
    }
    match changes(result.unwrap(reader(reopened, 0u64)), held, snapshot(reopened)) {
        Error(Foreign) => {},
        _ => return false
    }
    let (_, second) = result.unwrap(law_pair(mut reopened, "rows", std.codec.key_u64(), std.codec.of_u64(), "second", std.codec.key_u64(), std.codec.of_u64()))
    if second.id != 2 {
        return false
    }
    // Replay edits a path already named by the selected MANIFEST. The next
    // cut must write the new stamps before it removes the journal suffix.
    if !typed_put(mut reopened, t, 1, 40) {
        return false
    }
    result.unwrap(close(take reopened))
    let mut replayed = result.unwrap(open(tasks, d, c, r, options))
    if result.unwrap(get(result.unwrap(reader(replayed, 0u64)), snapshot(replayed), sh, 1)) != Some(40u64) {
        return false
    }
    result.unwrap(checkpoint(mut replayed))
    result.unwrap(close(take replayed))
    let final_open = result.unwrap(open(tasks, d, c, r, options))
    let row = result.unwrap(get(result.unwrap(reader(final_open, 0u64)), snapshot(final_open), sh, 1))
    result.unwrap(close(take final_open))
    row == Some(40u64)
}

@test
fn disk_test_db(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_db(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }

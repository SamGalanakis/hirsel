// The bounded seeded client driver. The target lands after S5b and uses the
// runner's wire client; it adds no observer hooks to the runner or store.
pub type Mix: codec + send = Correct | ReuseWhileLive | RecoverNewBytes | NoDirectory | AdvanceOnRefusal
type Reg = runner.Registry[(), observe_fixture.Handles]
type Drive: send { head: Sender[runner.HeadInput], post: Sender[runner.PubIn], clock: Clock, tasks: Tasks, net: Net, random: Random, token: Bytes, out: Stdout, err: Stderr, seed: u64, mix: Mix }
type Conn { id: u64, clock: Clock, out: Stdout, wire: wire_client.Conn, task: Task[Result[(), std.wsock.Error]] }
const NEVER: u64 = 18446744073709551615u64
const LATER: u64 = 10000000000u64
const N_PLACE: u64 = 1048576u64

fn place(mut r: Reg) -> Result[(), runner.RegisterError] {
    runner.transact(mut r, code.describe(observe_fixture.record), 65536u64, runner.DEFAULT_STEPS)
}

fn entry() -> Bytes { observe_fixture.entry() }

fn stream(id: u64) -> Bytes {
    let mut b: Bytes = list.new()
    std.codec.put_u64(id, mut b)
    b
}

fn args(seed: u64, s: u64, p: u64, request: u64) -> observe_fixture.Request {
    let mut b: Bytes = list.new()
    std.codec.put_u64(seed, mut b)
    std.codec.put_u64(request, mut b)
    observe_fixture.Request(stream: stream(s), p: p, arg: take b)
}

fn delay(seed: u64, salt: u64) -> u64 {
    // Goose test/stdlib/stdlib_slice_pool_equivalence.goose:3,16, and
    // core/std/tests/omap.hirsel:137. Explicit wrapping; sample the high word.
    let state = int.wrapping_add(seed, salt)
    let x = int.wrapping_add(int.wrapping_mul(state, 6364136223846793005u64), 1442695040888963407u64)
    2000000u64 + ((x >> 32) % 4000000u64)
}

fn emit(out: Stdout, trace: Log[observe.Obs], take e: observe.Obs) -> () waits {
    let co: std.codec.Codec[observe.Obs] = std.codec.of()
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.encode(co, e, mut b))
    result.unwrap(stdout.write_bytes(out, b))
    log.append(trace, take e)
}

fn drive_input(take head: Sender[runner.HeadInput], take post: Sender[runner.PubIn], clock: Clock, random: Random, tasks: Tasks, net: Net, out: Stdout, err: Stderr, seed: u64, mix: Mix) -> Drive {
    let d = Drive(head: take head, post: take post, clock: clock, tasks: tasks, net: net, random: random,
        token: ingress.credential(random),
        out: out, err: err, seed: seed, mix: mix)
    take d
}

fn keys() -> List[Bytes] {
    let mut wanted: List[Bytes] = list.new()
    list.push(mut wanted, entry())
    wanted
}

fn connect(d: Drive, id: u64) -> Conn waits {
    // These histories have at most two live sends per connection. q=1 keeps
    // that bound inside the original 2 MiB seed with the wire reader included.
    connect_in(d, id, 1u64)
}

fn connect_in(d: Drive, id: u64, q: u64) -> Conn waits {
    let (take wire, take session) = result.unwrap(wire_client.pair(d.tasks, d.net, d.clock, d.random,
        Some(ingress.binding()), d.head, d.post, code.describe(place), keys(), Some(clone(d.token)), q, 2097152u64))
    Conn(id: id, clock: d.clock, out: d.out, wire: take wire, task: take session)
}

fn ask(c: Conn, trace: Log[observe.Obs], a: observe_fixture.Request, key: Bytes, after: u64) -> () waits {
    let raw = observe_fixture.encoded(a)
    let at = host.mono_ns(c.clock)
    let ms: u32 = int.narrow((after + 999999u64) / 1000000u64)
    let duration: u64 = int.widen(ms)
    let deadline = at + duration * 1000000u64
    emit(c.out, trace, Sent(observe.Send(conn: c.id, stream: observe.own(a.stream), p: a.p,
        digest: observe_fixture.digest(key, raw), deadline: deadline, at: at)))
    let mut offset = 0u64
    let stream_number: u32 = int.narrow(result.unwrap(std.codec.take_u64(a.stream, mut offset)))
    wire_client.send_frame(c.wire, Call(stream_number, a.p, wire_client.slot(keys(), key), ms, take raw))
}

type Got { version: u64, stream: Bytes, p: u64, outcome: runner.Outcome }

// Decode the same runner.Frame as the calls fixture; the request's stream
// number remains the observer's logical key across its shared-principal sockets.
fn received(take incoming: runner.Frame) -> Got {
    match take incoming {
        Batch(v, _, take rows, take outcomes) => {
            if list.len(rows) != 0u64 || list.len(outcomes) != 1u64 { fail("observe drive: one outcome per Batch") }
            for take outcome in take outcomes {
                let runner.Done(stream: id, p: p, outcome: take o) = take outcome
                return Got(version: v, stream: stream(int.widen(id)), p: p, outcome: take o)
            }
            fail("observe drive: empty Batch")
        },
        _ => fail("observe drive: expected Batch"),
    }
}

fn receive(c: Conn) -> Got waits {
    match wire_client.next(c.wire) {
        Ok(take f) => received(take f),
        Error(_) => fail("observe drive: client channel closed"),
    }
}

fn frame(c: Conn, trace: Log[observe.Obs]) -> Got waits {
    record_reply(c, trace, receive(c))
}

fn record_reply(c: Conn, trace: Log[observe.Obs], take f: Got) -> Got waits {
    // A Recorded reply is the fixture's committed ran-table row. Duplicate
    // carries the original row too, so changed-byte clients cannot rewrite it.
    if let Returned(b) = f.outcome {
        let cr: std.codec.Codec[observe_fixture.Recorded] = std.codec.of()
        let mut at = 0u64
        if let Ok(Ok(r)) = std.codec.take_result(b, mut at, cr, std.codec.of_u32()) {
            let raw = observe_fixture.encoded(r.request)
            emit(c.out, trace, Ran(observe.Run(stream: observe.own(r.request.stream), p: r.request.p,
                digest: observe_fixture.digest(entry(), raw), version: r.version)))
        }
    }
    emit(c.out, trace, Got(observe.Reply(conn: c.id, stream: observe.own(f.stream), p: f.p,
        version: f.version, outcome: observe.from_runner(f.outcome), at: host.mono_ns(c.clock))))
    f
}

fn close(take c: Conn, trace: Log[observe.Obs]) -> () waits {
    let Conn(id: id, clock: clock, out: out, wire: take wire, task: take session) = take c
    let _ = wire_client.close(take wire)
    let _ = task.join(take session)
    emit(out, trace, Closed(observe.Close(conn: id, code: 1000u64, at: host.mono_ns(clock))))
}

fn publish(err: Stderr, take events: List[observe.Obs]) -> () waits {
    let mut p = positions.state()
    let mut j = observe.state()
    let mut w = session.state()
    for e in events {
        positions.step(mut p, e)
        observe.step(mut j, e)
        session.step(mut w, e)
    }
    let h = observe.Header(has_clock: true, has_digest: true, has_ran: true, complete: true)
    let cp: std.codec.Codec[List[observe.Verdict]] = std.codec.of()
    let pv = positions.finish(p, h)
    let jv = observe.finish(j, h)
    let wv = session.finish(w, h)
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.encode(cp, pv, mut b))
    result.unwrap(std.codec.encode(cp, jv, mut b))
    result.unwrap(std.codec.encode(cp, wv, mut b))
    result.unwrap(stderr.write_bytes(err, b))
}

fn drive(take d: Drive) -> () waits {
    let trace: Log[observe.Obs] = log.new()
    let a = connect(d, 0u64)
    let b = connect(d, 1u64)
    let c = connect(d, 2u64)
    let key = entry()
    let gap = delay(d.seed, 0u64)
    // The host delays starting the real head for 20 ms. The original p0 stays
    // in its inbox after this connection is Abandoned and closes.
    let held = args(d.seed, 0u64, 0u64, 0u64)
    ask(a, trace, held, key, gap)
    let _ = frame(a, trace)
    close(take a, trace)
    let retry = match d.mix {
        ReuseWhileLive => args(d.seed, 0u64, 0u64, 99u64),
        RecoverNewBytes => args(d.seed, 0u64, 0u64, 99u64),
        _ => observe.own(held),
    }
    ask(c, trace, retry, key, LATER)
    let _ = frame(c, trace)
    // Recover the original reply before advancing this stream.
    ask(b, trace, held, key, LATER)
    let _ = frame(b, trace)
    ask(b, trace, args(d.seed, 0u64, 1u64, 1u64), key, LATER)
    let _ = frame(b, trace)
    ask(b, trace, args(d.seed, 0u64, 2u64, 2u64), key, LATER)
    let _ = frame(b, trace)
    if let NoDirectory = d.mix {
        ask(c, trace, args(d.seed, 0u64, 0u64, 98u64), key, LATER)
        let _ = frame(c, trace)
    }
    // A pre-admission refusal leaves p unconsumed. Only the deliberate
    // advance_on_refusal client skips it; H must fail for that control.
    if let AdvanceOnRefusal = d.mix {
        ask(c, trace, args(d.seed, 1u64, 0u64, 0u64), string.as_bytes("missing"), LATER)
        let _ = frame(c, trace)
        ask(c, trace, args(d.seed, 1u64, 1u64, 1u64), key, gap)
        let _ = frame(c, trace)
    } else {
        for p in 0u64 .. 3u64 {
            ask(b, trace, args(d.seed, 1u64, p, p), key, 50000000u64 + delay(d.seed, p + 10u64))
            let _ = frame(b, trace)
        }
    }
    close(take b, trace)
    close(take c, trace)
    publish(d.err, log.finish(take trace))
}

pub fn run(out: Stdout, err: Stderr, clock: Clock, random: Random, tasks: Tasks, net: Net, seed: u64, mix: Mix) -> bool waits {
    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let ca: std.codec.Codec[observe_fixture.Request] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("ran", std.codec.key_bytes(), ca)))
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mail = result.unwrap(runner.mailbox(4u64))
    let input = drive_input(take head, runner.post(mail), clock, random, tasks, net, out, err, seed, mix)
    let body = task.spawn(tasks, bytes 33554432u64, take input, drive)
    host.sleep_until(clock, host.mono_ns(clock) + 20000000u64)
    let opened = runner.place_head(take db, code.describe(place), N_PLACE, None, code.describe(observe_fixture.schema), take inbox, take mail, tasks, 1048576u64)
    let driven = task.join(take body)
    match opened { Ok(()) => (), Error(_) => return false }
    match driven { Ok(()) => true, Error(_) => false }
}


pub type JoinCase: codec + send = CrossSession | AfterAbandoned | AfterAbandonedSame
type JoinDrive: send { drive: Drive, scenario: JoinCase }

// The original early-then-late observer case retains its 1000 ns timing oracle
// on the evaluator's virtual Clock. Wire ordering is checked separately.
pub fn deadline_join(out: Stdout, err: Stderr, clock: Clock, random: Random, tasks: Tasks, net: Net) -> bool waits {
    let db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mail = result.unwrap(runner.mailbox(64u64))
    let d = drive_input(take head, runner.post(mail), clock, random, tasks, net, out, err, 0u64, Correct)
    let trace: Log[observe.Obs] = log.new()
    let cn = connect_in(d, 99u64, 1u64)
    let a = args(0u64, 0u64, 0u64, 0u64)
    ask(cn, trace, a, entry(), 2000000u64)
    ask(cn, trace, a, entry(), 50000000u64)
    let _ = frame(cn, trace)
    close(take cn, trace)
    join_verdicts(err, log.finish(take trace))
    true
}

fn join_verdicts(err: Stderr, take events: List[observe.Obs]) -> () waits {
    let mut state = observe.state()
    for e in events { observe.step(mut state, e) }
    let h = observe.Header(has_clock: true, has_digest: true, has_ran: true, complete: true)
    let c: std.codec.Codec[List[observe.Verdict]] = std.codec.of()
    let mut b: Bytes = list.new()
    result.unwrap(std.codec.encode(c, observe.finish(state, h), mut b))
    result.unwrap(stderr.write_bytes(err, b))
}

// A correct session ends after y. A mutant may answer it; record that reply so
// J1, rather than a driver assertion, diagnoses the identity violation.
fn mismatch_result(take c: Conn, trace: Log[observe.Obs]) -> () waits {
    match wire_client.next(c.wire) {
        Ok(take f) => {
            let _ = record_reply(c, trace, received(take f))
            close(take c, trace)
        },
        Error(_) => {
            let Conn(id: id, clock: clock, out: out, wire: take wire, task: take session) = take c
            let _ = wire_client.close(take wire)
            match task.join(take session) { Ok(Ok(())) => (), _ => fail("observe join: session did not end cleanly") }
            emit(out, trace, Closed(observe.Close(conn: id, code: 1008u64, at: host.mono_ns(clock))))
        },
    }
}

fn drive_join(take input: JoinDrive) -> () waits {
    let JoinDrive(drive: take d, scenario: scenario) = take input
    let trace: Log[observe.Obs] = log.new()
    let a = connect(d, 0u64)
    let original = args(0u64, 0u64, 0u64, 1u64)
    let other = args(0u64, 0u64, 0u64, 2u64)
    let key = entry()
    match scenario {
        CrossSession => {
            let b = connect(d, 1u64)
            ask(a, trace, original, key, LATER)
            ask(b, trace, other, key, LATER)
            let _ = frame(a, trace)
            let _ = frame(b, trace)
            close(take a, trace)
            close(take b, trace)
        },
        _ => {
            ask(a, trace, original, key, 2000000u64)
            let _ = frame(a, trace)
            if let AfterAbandonedSame = scenario {
                ask(a, trace, original, key, LATER)
                let _ = frame(a, trace)
                close(take a, trace)
            } else {
                ask(a, trace, other, key, LATER)
                mismatch_result(take a, trace)
            }
            // Recover the actual original fixture row even after a Close 1008.
            let b = connect(d, 1u64)
            ask(b, trace, original, key, LATER)
            let _ = frame(b, trace)
            close(take b, trace)
        },
    }
    join_verdicts(d.err, log.finish(take trace))
}

pub fn run_join(out: Stdout, err: Stderr, clock: Clock, random: Random, tasks: Tasks, net: Net, scenario: JoinCase) -> bool waits {
    let mut db = store.memory(clock, random, result.unwrap(store.sized(Memory, 1074790400u64)))
    let ca: std.codec.Codec[observe_fixture.Request] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("ran", std.codec.key_bytes(), ca)))
    let (head, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mail = result.unwrap(runner.mailbox(4u64))
    let d = drive_input(take head, runner.post(mail), clock, random, tasks, net, out, err, 0u64, Correct)
    let input = JoinDrive(drive: take d, scenario: scenario)
    let body = task.spawn(tasks, bytes 33554432u64, take input, drive_join)
    host.sleep_until(clock, host.mono_ns(clock) + 20000000u64)
    let opened = runner.place_head(take db, code.describe(place), N_PLACE, None, code.describe(observe_fixture.schema), take inbox, take mail, tasks, 1048576u64)
    let driven = task.join(take body)
    match opened { Ok(()) => (), Error(_) => return false }
    match driven { Ok(()) => true, Error(_) => false }
}

    compiler_flags = COMPOSE_FLAGS,
    deps = ["toolchains//:libllvm", "//crates/hirsel-llvm/bridge:checked-copy-static"],
    visibility = ["PUBLIC"],
)

# Embed the actual shared artifact, with no link edge from the Rust compiler
# binary to it or libLLVM. include! resolves the adjacent image at compile time.
genrule(
    name = "image",
    out = "OUT_DIR",
    cmd = """mkdir -p "$OUT"
cp "$(location :engine[shared])" "$OUT/engine.so"
id=`readelf -n "$(location toolchains//:engine-llvm)" | awk '/Build ID:/ {print $3}'`
test -n "$id" || exit 1
printf '%s\\n' 'static COMPONENT: &[u8] = include_bytes!("engine.so");' \
    'const CARGO_ENGINE: Option<(&str, &str)> = None;' \
    "const LLVM_BUILD_ID: &str = \\"$id\\";" > "$OUT/component.rs"
""",
    visibility = ["PUBLIC"],
)

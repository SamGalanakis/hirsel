// MEM-32 binds only physical layout and MEM-24 charges are logical: a List that never
// leaves its function may keep its storage in the frame, and every charge, refund and
// refusal stays where the heap puts it. Hand-derived (budgets.md, `charge-v1`): a
// List[u64] grows to capacities 4, 8, 16, 32, charging 32, 64, 128 and 256 bytes, each
// growth admitting the new charge before refunding the old.
//
// `local` keeps its list and drops it, on the loop's end or an early return:
// - 20 pushes under 1000 bytes: sum 190; the drop refunds everything, so a probe then
//   sees 1000 bytes of room: 190 * 10000 + 1000.
// - 20 pushes under 300 bytes: growing 16 -> 32 needs 128 + 256 > 300 and is refused
//   asking 256 with 300 - 128 = 172 left, the list still holding 16 elements; the early
//   return drops them and the probe sees 300: (1000000 + 256000 + 172) * 10000 + 300.
// - 3 pushes under 31 bytes: the first push asks 32 with 31 left; the probe sees 31.
// The frame bytes hold 16 u64s, so 16 -> 32 moves the storage to the heap, and
// 32 -> 64 grows heap storage:
// - 40 pushes under 1000 bytes: 256 + 512 = 768 fits; sum 780, and the drop frees the
//   heap storage and refunds all of it: 780 * 10000 + 1000.
// - 40 pushes under 700 bytes: growing 32 -> 64 is refused asking 512 with
//   700 - 256 = 444 left; the probe sees 700: (1000000 + 512000 + 444) * 10000 + 700.
// expect: run frame_local(20,1000) = 1901000
// expect: run frame_local(20,300) = 12561720300
// expect: run frame_local(3,31) = 10320310031
// expect: run frame_local(40,1000) = 7801000
// expect: run frame_local(40,700) = 15124440700
//
// Each list below leaves its function by one route, so its storage must outlive the
// frame that made it; `local(5)` then reuses that frame's stack before the sum is
// read. Six pushes: sum 15, capacity 8 (64 bytes, a channel 1 * 24 + 64 more), all
// refunded before the probe: 15 * 10000 + 1000. The lent list first takes 100 in its
// own function, so the callee grows storage its owner made: (100 + 15) * 10000 + 1000.
// expect: run escape_return(6) = 151000
// expect: run escape_field(6) = 151000
// expect: run escape_capture(6) = 151000
// expect: run escape_send(6) = 151000
// expect: run escape_kept(6) = 151000
// expect: run escape_lent(6) = 1151000

type Holder { xs: List[u64] }

fn sum(xs: List[u64]) -> u64 {
    let mut s = 0u64
    for v in xs {
        s += v
    }
    s
}

fn push_all(mut xs: List[u64], n: u64) -> u64 {
    let mut i = 0u64
    while i < n {
        match list.push(mut xs, i) {
            Ok(()) => {},
            Error((e, _)) => return 1000000 + e.requested * 1000 + e.available
        }
        i += 1
    }
    0
}

fn local(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        match list.push(mut xs, i) {
            Ok(()) => {},
            Error((e, _)) => return 1000000 + e.requested * 1000 + e.available
        }
        i += 1
    }
    let mut s = 0u64
    for v in xs {
        s += v
    }
    s
}

fn room() -> u64 {
    let mut probe: List[u64] = list.new()
    match list.reserve(mut probe, 1000000) {
        Ok(()) => 0,
        Error(e) => e.available
    }
}

fn frame_local(n: u64, b: u64) -> u64 {
    let r = bound bytes b {
        let s = local(n)
        s * 10000 + room()
    }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn returned(n: u64) -> Option[List[u64]] {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    Some(take xs)
}

fn by_return(n: u64) -> u64 {
    match returned(n) {
        Some(take xs) => {
            let _ = local(5)
            sum(xs)
        },
        None => 0
    }
}

fn held(n: u64) -> Holder {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    Holder(xs: take xs)
}

fn by_field(n: u64) -> u64 {
    let h = held(n)
    let _ = local(5)
    sum(h.xs)
}

fn by_capture(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    let made = fn() -> u64 {
        sum(xs)
    }
    let _ = local(5)
    match take made {
        Ok(f) => f(),
        Error(_) => 0
    }
}

fn by_send(n: u64) -> u64 {
    let (tx, rx): (Sender[List[u64]], Receiver[List[u64]]) = result.unwrap(channel.new(1))
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    match channel.try_send(tx, take xs) {
        Ok(()) => {},
        Error(_) => return 0
    }
    let _ = local(5)
    match channel.try_receive(rx) {
        Ok(take ys) => sum(ys),
        Error(_) => 0
    }
}

fn keep(take xs: List[u64]) -> List[u64] {
    let _ = local(5)
    xs
}

fn kept(n: u64) -> List[u64] {
    let mut xs: List[u64] = list.new()
    let mut i = 0u64
    while i < n {
        let _ = list.push(mut xs, i)
        i += 1
    }
    keep(take xs)
}

fn by_kept(n: u64) -> u64 {
    let ys = kept(n)
    let _ = local(5)
    sum(ys)
}

fn by_lent(n: u64) -> u64 {
    let mut xs: List[u64] = list.new()
    let _ = list.push(mut xs, 100)
    let _ = push_all(mut xs, n)
    let _ = local(5)
    sum(xs)
}

fn escape_return(n: u64) -> u64 {
    let r = bound bytes 1000 { by_return(n) * 10000 + room() }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_field(n: u64) -> u64 {
    let r = bound bytes 1000 { by_field(n) * 10000 + room() }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_capture(n: u64) -> u64 {
    let r = bound bytes 1000 { by_capture(n) * 10000 + room() }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_send(n: u64) -> u64 {
    let r = bound bytes 1000 { by_send(n) * 10000 + room() }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_kept(n: u64) -> u64 {
    let r = bound bytes 1000 { by_kept(n) * 10000 + room() }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

fn escape_lent(n: u64) -> u64 {
    let r = bound bytes 1000 { by_lent(n) * 10000 + room() }
    match r {
        Ok(v) => v,
        Error(_) => 1
    }
}

// The caller holds LOCK. The export opener uses the reader and validator
// directly, so it never selects or removes files in the captured directory.
fn read_selected_page_manifest(d: Dir) -> Result[(StoreId, manifest.ValidatedPageManifest), Error] waits {
    let (id, take page_record) = read_page_manifest_file(d)?
    Ok((id, select_page_manifest(d, id, take page_record)?))
}

fn publish_page_manifest(d: Dir, id: StoreId, m: manifest.PageManifest, target: Option[manifest.TargetLimits], mut scratch: Bytes) -> Result[(), Error] waits {
    failure_result_from_rep(manifest.fill_page_manifest_file(mut scratch, store_key_to_rep(id), m))?
    if let Some(wanted) = target {
        let none = manifest.new_page_locations()
        validate_new_page_manifest(d, id, scratch, wanted, manifest.SettledPacks(below: 0, locations: view none))?
    }
    failure_result_from_rep(manifest.publish_page_manifest_bytes(d, scratch))
}

// Independently encoded from AP3, AP14 (Format 14), AP20 and §13.1
// using libxxhash.
// The 29-byte pack row has a zero index offset. Both live PAGEs start at byte 72.
fn page_manifest_vector() -> Bytes {
    let words: Inline[u64, 59] =[
        0x0000003800010001,
        0x327c4caf22dd8b88,
        0x45524f5453524948,
        0x000000010000000e,
        0x0000000000000001,
        0x0000000000000002,
        0x0000000000000000,
        0x0000000000000001,
        0x0000000000000000,
        0x0000017f00010031,
        0xb01017707c6c2840,
        0x0000000000000001,
        0x0100000000ff0000,
        0x0100004000000400,
        0x0000000000000003,
        0x0000000100000001,
        0x0000000000000003,
        0x0000000000000001,
        0x0000000000000001,
        0x000000000000004e,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000002,
        0x0000000000000048,
        0x3fa736a500000044,
        0x00000002c222e972,
        0x0000000100000000,
        0x616d000400000000,
        0x0000000000006e69,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000010000,
        0x0000000000480000,
        0x33c6000000210000,
        0x0001222e8df641cc,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
        0x0000000000000000,
    ]
    let mut raw: Bytes = list.with_capacity(472)
    for word in words {
        list.put_word_le(mut raw, word)
    }
    list.truncate(mut raw, 471)
    take raw
}


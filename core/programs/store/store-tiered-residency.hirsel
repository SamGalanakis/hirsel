fn issue_residency_stamp(mut next_stamp: u64) -> Result[u64, types.Failure] {
    let stamp = next_stamp
    next_stamp = catalog.stamp_after(stamp)?
    Ok(stamp)
}

fn resident_blob_from_tiered(source: TieredPageSource, body: std.page.BlobSlot) -> Result[Arc[Bytes], types.Failure] waits {
    match body {
        HotBlob(contents) => manifest.disk_allocation(scoped fn() -> Result[Arc[Bytes], types.Failure] {
            Ok(arc.new(types.copied(contents)?))
        }),
        ColdBlob(ptr) => {
            let frame = fold_frame_at(source, TieredBlob(ptr))?
            let TieredValue(contents) = view frame.payload else {
                fail("store: a BLOB reference resolved to a PAGE")
            }
            manifest.disk_allocation(scoped fn() -> Result[Arc[Bytes], types.Failure] {
                Ok(arc.new(types.copied(contents)?))
            })
        },
    }
}

pub fn resident_page_from_tiered(source: TieredPageSource, root: std.page.Slot, mut next_stamp: u64) -> Result[Arc[std.page.Page], types.Failure] waits {
    let page = match root {
        HotPage(working) => arc.share(working),
        ColdPage(ptr) => {
            let frame = fold_frame_at(source, TieredPage(ptr))?
            manifest.disk_allocation(scoped fn() -> Result[Arc[std.page.Page], types.Failure] {
                Ok(std.page.copy_with_stamp(manifest.fold_page(frame), ptr.stamp))
            })?
        },
    }
    if std.page.stamp(std.page.image_of(page)) == 0 {
        return Ok(take page)
    }
    let image = std.page.image_of(page)
    let height = std.page.level(image)
    let mut children: List[std.page.Slot] = list.new()
    let mut bodies: List[std.page.BlobSlot] = list.new()
    let mut rows: List[std.page.Entry] = list.new()
    for slot in 0u64 .. std.page.count(image) {
        let mut row = manifest.disk_allocation(scoped fn() -> Result[std.page.Entry, types.Failure] {
            Ok(option.unwrap(std.page.entry(image, slot)))
        })?
        match row.cell {
            Child(mut previous) => {
                let edge = option.unwrap(std.page.child_slot(page, slot))
                let child = resident_page_from_tiered(source, edge, mut next_stamp)?
                previous.child = std.page.unlocated(std.page.stamp(std.page.image_of(child)))
                types.capacity(list.try_reserve(mut children, 1))?
                list.push(mut children, HotPage(take child))
            },
            BlobValue(mut previous) => {
                let original = option.unwrap(std.page.blob_slot(page, previous.body))
                let body = resident_blob_from_tiered(source, original)?
                previous.stamp = issue_residency_stamp(mut next_stamp)?
                previous.pack = 0
                previous.offset = 0
                previous.body = int.truncate(list.len(bodies))
                types.capacity(list.try_reserve(mut bodies, 1))?
                list.push(mut bodies, HotBlob(take body))
            },
            InlineValue(_) => (),
        }
        types.capacity(list.try_reserve(mut rows, 1))?
        list.push(mut rows, take row)
    }
    let stamp = issue_residency_stamp(mut next_stamp)?
    manifest.disk_allocation(scoped fn() -> Result[Arc[std.page.Page], types.Failure] {
        let ready = pages.page_result(std.page.encode(rows, height, stamp, Collection))?
        pages.page_result(std.page.attach(take ready, clone(children), clone(bodies)))
    })
}

// Releasing residency does not read the old tree. A Cold root is a single
// queue row. A Hot root releases the Cold edges under its Hot pages.
pub fn residency_release(root: std.page.Slot, branch_id: u32, mut queued: List[manifest.DeferredFree]) -> Result[(), types.Failure] {
    match root {
        ColdPage(place) => {
            types.capacity(list.try_reserve(mut queued, 1))?
            list.push(mut queued, manifest.DeferredFree(branch_id: branch_id, target: TieredPage(place)))
        },
        HotPage(page) => {
            let image = std.page.image_of(page)
            for slot in 0u64 .. std.page.count(image) {
                if let Some(edge) = std.page.child_slot(page, slot) {
                    residency_release(edge, branch_id, mut queued)?
                } else if let Some(BlobEdge(reference)) = std.page.owning_edge(image, slot) {
                    if let Some(ColdBlob(ptr)) = std.page.blob_slot(page, reference.body) {
                        types.capacity(list.try_reserve(mut queued, 1))?
                        list.push(mut queued, manifest.DeferredFree(branch_id: branch_id, target: TieredBlob(ptr)))
                    }
                }
            }
        },
    }
    Ok(())
}

fn restamp_tiered_frames(mut frames: List[TieredEmitFrame], mut next_stamp: u64) -> Result[(), types.Failure] {
    for slot in 0u64 .. list.len(frames) {
        frames[slot].frame.stamp = issue_residency_stamp(mut next_stamp)?
    }
    Ok(())
}

// This plan belongs to one residency-changing holder. Its location map is
// keyed by the stamps in that holder's untouched Memory images.
pub fn restamp_tiered_emission(root: std.page.Slot, collection: u32, mut next_stamp: u64) -> Result[TieredCutFrames, types.Failure] {
    let mut frames = TieredCutFrames(pages: list.new(), blobs: list.new(), seen: map.new())
    tiered_emit_tree(mut frames, collection, root)?
    restamp_tiered_frames(mut frames.blobs, mut next_stamp)?
    restamp_tiered_frames(mut frames.pages, mut next_stamp)?
    Ok(take frames)
}

// §13.8 "Who pays for the load" (v2.74.2): after the fold, before the
// candidate queue's added rows. Each Cold slot of main's tree is one load
// step through the pager (`fold_frame_at` pins it on K), and every Hot page
// and blob is copied, so the whole tree takes fresh stamps (v2.96). The old
// tree is released as a dropped collection's is, so this cut's probe sees it.
pub fn load_memory_residency(pager: Option[View[Sender[TieredPagerMessage]]], mut roots: List[pages.Roots], branches: List[u32], unload: Option[u32], mut next_stamp: u64, mut queued: List[manifest.DeferredFree]) -> Result[bool, types.Failure] waits {
    let Some(id) = unload else {
        return Ok(false)
    }
    let key = catalog.prefix(id)?
    let source = tx_page_source(pager, roots[0u64].collections)?
    let (take old, take record) = {
        let Some((edge, before)) = std.page.collection_slot(roots[0u64].collections.root, key) else {
            return Error(Stale(id))
        }
        let slot: std.page.Slot = clone(edge)
        (take slot, types.copied(before)?)
    }
    let loaded = resident_page_from_tiered(source, old, mut next_stamp)?
    residency_release(old, branches[0u64], mut queued)?
    let mut descriptor = take record
    let root = std.page.encode_ptr(std.page.unlocated(std.page.stamp(std.page.image_of(loaded))))
    for at in 0u64 .. list.len(root) {
        descriptor[at] = root[at]
    }
    std.page_descriptor.set_collection_residency(mut descriptor, ResidentMemory)
    let private_from = next_stamp
    let inline = roots[0u64].collections.inline
    pages.page_result(std.page.insert(mut roots[0u64].collections.root, take key, take descriptor, Some(take loaded), inline, private_from, mut next_stamp))?
    Ok(true)
}

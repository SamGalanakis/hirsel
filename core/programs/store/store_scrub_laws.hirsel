fn scrub_fill(mut db: Db, t: Table[u64, u64], rows: u64, add: u64) -> Result[(), Error] waits {
    let out = run(mut db, None, (copy_env(add), copy_env(rows), copy_env(t)), fn(mut tx, call_env) -> Result[(), Error] {
        for k in 0u64 .. call_env.1 {
            put(mut tx, call_env.2, k, k + call_env.0)?
        }
        Ok(())
    })?
    match out {
        Committed(_) => Ok(()),
        _ => Error(MigrationFault)
    }
}

fn scrub_to_end(mut tour: Scrub, budget: u64, mut faults: List[Fault]) -> Result[u64, Error] waits {
    loop {
        let report = scrub_step(mut tour, budget)?
        for found in report.faults {
            list.push(mut faults, clone(found))
        }
        if let None = report.next {
            return Ok(report.checked)
        }
    }
}

fn scrub_fault_is(fault: Fault, seq: u64, offset: u64, why: Why) -> Result[bool, Error] {
    let path = paged_pack_path(seq)?
    let matched = match fault.why {
        Checksum => match why {
            Checksum => true,
            _ => false
        },
        Kind(found) => match why {
            Kind(wanted) => found == wanted,
            _ => false
        },
        Truncated => match why {
            Truncated => true,
            _ => false
        },
        _ => false
    }
    Ok(fault.file == path && fault.offset == offset && matched)
}

// A misdirected write (TigerBeetle's storage fault model, §11.17): pack A's
// first frame, meant for A at 72, lands at 72 in pack B. A's slot keeps its
// old sector, zeros for a new file, and B's slot holds A's sealed bytes. The
// oracle is the injected place: A at 72 reads kind 0, and B at 72 holds a
// well-formed head whose check binds A's sequence, not B's.
@test
fn disk_test_scrub_misdirected(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 2000, 0)?
    let _ = checkpoint(mut db)?
    // Control: the undamaged generation reads clean, and the tour reads every
    // byte of every listed pack, by the files' own sizes.
    let mut listed: List[u64] = list.new()
    let mut data: List[u64] = list.new()
    let mut cursor = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut cursor) {
        list.push(mut listed, seq)
        if pack.class == 0 {
            list.push(mut data, seq)
        }
    }
    let mut total = 0u64
    for seq in listed {
        total += list.len(disk_read_paged_file(path, paged_pack_path(seq)?, 67108864)?)
    }
    let mut clean: List[Fault] = list.new()
    let control = begin_scrub(mut db)?
    let mut tour = take control
    if scrub_to_end(mut tour, 4096, mut clean)? != total || list.len(clean) != 0 || list.len(data) < 4 {
        return Error(MigrationFault)
    }
    // A is the first data pack whose first frame fits inside B, the second.
    let a = data[0u64]
    let b = data[1u64]
    let a_name = paged_pack_path(a)?
    let b_name = paged_pack_path(b)?
    let mut a_raw = disk_read_paged_file(path, a_name, 67108864)?
    let mut b_raw = disk_read_paged_file(path, b_name, 67108864)?
    let old_stamp = read_le(a_raw, 96, 8)
    let width = 16 + read_le(a_raw, 76, 4)
    if 72 + width > list.len(b_raw) {
        return Error(MigrationFault)
    }
    for at in 72u64 .. 72 + width {
        b_raw[at] = a_raw[at]
        a_raw[at] = 0u8
    }
    disk_write_synced(path, a_name, a_raw)?
    disk_write_synced(path, b_name, b_raw)?
    // A lost write over a leftover of the same pack number: C at 72 holds a
    // frame sealed for C at 72 whose last payload byte differs. The envelope
    // passes; only the generation's pointer to C at 72 tells the bytes apart.
    let c_seq = data[2u64]
    let c_name = paged_pack_path(c_seq)?
    let mut c_raw = disk_read_paged_file(path, c_name, 67108864)?
    let c_width = read_le(c_raw, 76, 4)
    c_raw[87 + c_width] = c_raw[87 + c_width] ^ 1u8
    let sealed = capacity(disk_check(DiskContext(store: db.store, role: 3, seq: c_seq), 72, list.slice(c_raw, 72, 80), list.slice(c_raw, 88, 88 + c_width)))?
    list.set_word_le(mut c_raw, 80, sealed)
    disk_write_synced(path, c_name, c_raw)?
    // D's live frame is replaced by a same-width frame sealed for D at
    // this offset, but carrying the stamp of a different live frame.
    let d_seq = data[3u64]
    let d_name = paged_pack_path(d_seq)?
    let mut d_raw = disk_read_paged_file(path, d_name, 67108864)?
    let d_width = read_le(d_raw, 76, 4)
    if old_stamp == read_le(d_raw, 96, 8) { fail("the stale frame needs a different stamp") }
    list.set_word_le(mut d_raw, 96, old_stamp)
    let d_seal = capacity(disk_check(DiskContext(store: db.store, role: 3, seq: d_seq), 72, list.slice(d_raw, 72, 80), list.slice(d_raw, 88, 88 + d_width)))?
    list.set_word_le(mut d_raw, 80, d_seal)
    disk_write_synced(path, d_name, d_raw)?
    let mut faults: List[Fault] = list.new()
    let damaged = begin_scrub(mut db)?
    let mut second = take damaged
    let _ = scrub_to_end(mut second, 1, mut faults)?
    if list.len(faults) < 3 || !scrub_fault_is(faults[0u64], a, 72, Kind(0))? || !scrub_fault_is(faults[1u64], b, 72, Checksum)? || !scrub_fault_is(faults[2u64], c_seq, 72, Checksum)? {
        return Error(MigrationFault)
    }
    if list.len(faults) != 4 || !scrub_fault_is(faults[3u64], d_seq, 72, Checksum)? {
        fail("scrub missed the sealed stale stamp at the live offset")
    }
    // Detection only: resident pages still answer.
    if get(result.unwrap(reader(db, 0u64)), snapshot(db), t, 1999)? != Some(1999u64) {
        return Error(MigrationFault)
    }
    close(take db)
}

@test
fn disk_test_scrub_damage_budget(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 2000, 0)?
    let _ = checkpoint(mut db)?
    let mut listed = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    let Some((first, _)) = std.omap.next(mut listed) else { return Error(MigrationFault) }
    let Some((second, _)) = std.omap.next(mut listed) else { return Error(MigrationFault) }
    let Some((third, _)) = std.omap.next(mut listed) else { return Error(MigrationFault) }
    let first_name = paged_pack_path(first)?
    let mut raw = disk_read_paged_file(path, first_name, 67108864)?
    // The 72-byte HEADER and the first frame's 16-byte envelope and payload.
    let budget = 72 + 16 + read_le(raw, 76, 4)
    raw[budget - 1] = raw[budget - 1] ^ 1u8
    disk_write_synced(path, first_name, raw)?
    let second_name = paged_pack_path(second)?
    let header = disk_read_paged_file(path, second_name, 67108864)?
    disk_write_synced(path, second_name, list.slice(header, 0, 7))?
    let mut tour = begin_scrub(mut db)?
    let damaged = scrub_step(mut tour, budget)?
    if damaged.checked != budget || damaged.next != Some(second) || list.len(damaged.faults) != 1 || !scrub_fault_is(damaged.faults[0], first, 72, Checksum)? {
        fail("the damaged frame must spend the budget before the next pack")
    }
    let partial = scrub_step(mut tour, 7)?
    if partial.checked != budget + 7 || partial.next != Some(third) || list.len(partial.faults) != 1 || !scrub_fault_is(partial.faults[0], second, 0, Truncated)? {
        fail("the partial header must spend its seven bytes before the next pack")
    }
    drop(take tour)
    close(take db)
}

// §11.17's lease: a cut that retires every data pack while a tour holds them
// keeps the files; the tour reads them clean; after the tour ends, the next
// cut unlinks exactly the packs no longer listed.
@test
fn disk_test_scrub_lease(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 2000, 0)?
    let _ = checkpoint(mut db)?
    let started = begin_scrub(mut db)?
    let mut tour = take started
    let first = scrub_step(mut tour, 1)?
    if first.checked != 72 || list.len(first.faults) != 0 {
        return Error(MigrationFault)
    }
    // Every row changes, so every data page is rewritten and its old pack's
    // live bytes reach zero.
    scrub_fill(mut db, t, 2000, 1)?
    let _ = checkpoint(mut db)?
    let mut retired = 0u64
    for seq in tour.lease.packs {
        if !disk_exists(path, paged_pack_path(seq)?)? {
            return Error(MigrationFault)
        }
    }
    // The cut carries each retirement the lease holds back.
    for seq in disk_state(db).pages.carried {
        if scrub_leased(disk_state(db).scrubs, seq) {
            retired += 1
        }
    }
    let mut faults: List[Fault] = list.new()
    let _ = scrub_to_end(mut tour, 4096, mut faults)?
    if retired == 0 || list.len(faults) != 0 {
        return Error(MigrationFault)
    }
    let leased: List[u64] = clone(tour.lease.packs)
    drop(take tour)
    let _ = checkpoint(mut db)?
    let mut gone = 0u64
    for seq in leased {
        let present = disk_exists(path, paged_pack_path(seq)?)?
        let listed = match disk_index_get(disk_state(db).pages.locations.packs, seq) {
            Some(_) => true,
            None => false
        }
        if present != listed {
            return Error(MigrationFault)
        }
        if !present {
            gone += 1
        }
    }
    if gone == 0 {
        return Error(MigrationFault)
    }
    close(take db)
}

// The head's driver (RUNNER-SPEC §12.5) runs a tour one slice at a time
// between commits and cuts. Nothing here damages a byte, so the oracle is no
// fault at all: frames appended to a listed pack after the tour began, and
// packs a cut retires under the lease, read clean to the tour's end.
@test
fn disk_test_scrub_interleaved(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.pack_bytes = 512
    let mut db = open(tasks, path, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    scrub_fill(mut db, t, 500, 0)?
    let _ = checkpoint(mut db)?
    let mut tour = begin_scrub(mut db)?
    let mut steps = 0u64
    loop {
        let report = scrub_step(mut tour, 256)?
        if list.len(report.faults) != 0 { fail("§11.17: a tour between commits and cuts found a fault") }
        if let None = report.next { break }
        steps += 1
        if steps > 100000 { fail("§11.17: the tour never ended") }
        scrub_fill(mut db, t, 50 + steps % 450, steps)?
        if steps % 4 == 0 { let _ = checkpoint(mut db)? }
    }
    if steps == 0 { fail("the fixture's tour fit one slice") }
    drop(take tour)
    let _ = checkpoint(mut db)?
    let mut again = begin_scrub(mut db)?
    let mut faults: List[Fault] = list.new()
    let _ = scrub_to_end(mut again, 4096, mut faults)?
    if list.len(faults) != 0 { fail("§11.17: the store after the tour has a fault") }
    drop(take again)
    close(take db)
}

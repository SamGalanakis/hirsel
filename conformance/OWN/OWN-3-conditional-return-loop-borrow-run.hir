// rule: OWN-3
// expect: run
// MODE-1: the returning branch's read loan does not reach the insertion backedge.
fn get_or_insert(mut m: Map[u64, List[u64]], key: u64) -> List[u64] in m {
  let mut attempts = 0u64
  while attempts < 2u64 {
    match map.get(m, key) {
      Some(value) => return value,
      None() => {
        map.insert(mut m, key, [key])
      },
    }
    attempts += 1u64
  }
  []
}

pub fn main() -> Result[(), ()] {
  let mut m: Map[u64, List[u64]] = map.empty()
  failure.check(get_or_insert(mut m, 7u64) == [7u64], Bounds())
  failure.check(map.len(m) == 1u64, Bounds())
  map.insert(mut m, 9u64, [90u64])
  failure.check(get_or_insert(mut m, 9u64) == [90u64], Bounds())
  failure.check(map.len(m) == 2u64, Bounds())
  Ok(())
}

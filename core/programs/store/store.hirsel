    let a = memory(c, r, defaults())
    let b = memory(c, r, defaults())
    let first_id = identity(a)
    if same(first_id, identity(a)) && !same(first_id, identity(b)) && version(snapshot(a)) == 0 {
        Ok(())
    } else {
        Error(())
    }
}

// L2 following: publish only admitted roots; handles survive the writer.
// Wrong implementation caught: publish before admission or miss a successful swap.
pub fn law_follow(c: Clock) -> bool {
    let mut db = test_db(c, 86)
    let h = result.unwrap(follow(mut db, Branch(store: StoreId(hi: 1, lo: 2), id: 0)))
    let initial = latest.read(h)
    if version(initial) != 0 || !put_one(mut db, 1, 10) {
        return false
    }
    let first = latest.read(h)
    if version(first) != 1 || value_at(first, 1) != 10 || version(initial) != 0 {
        return false
    }
    if put_one(mut db, 2, 20) {
        return false
    }
    let after_refusal = latest.read(h)
    if version(after_refusal) != 1 || value_at(after_refusal, 2) != 0 {
        return false
    }
    let second = result.unwrap(follow(mut db, Branch(store: StoreId(hi: 1, lo: 2), id: 0)))
    let removed = execute(mut db, 2, fn(mut tx: Tx) -> Result[bool, Error] {
        delete_bytes(mut tx, 1, key_word(1))
    })
    match take removed {
        Ok(Committed(_)) => {},
        _ => return false
    }
    let final_root = latest.read(second)
    version(final_root) == 2 && value_at(final_root, 1) == 0 && value_at(first, 1) == 10
}


/// Whether the leading codec encodes a sequence of complete leading key components.
/// Tuple and record grouping adds no bytes. A Desc component must match in full.
pub fn matches[K, Q](full: codec.Key[K], leading: codec.Key[Q]) -> Result[bool, codec.EncodeError] {
    let whole = codec.key_schema(full)?
    let part = codec.key_schema(leading)?
    Ok(key_schema_prefix(whole, part))
}

fn key_schema_prefix(whole: Bytes, part: Bytes) -> bool {
    if whole == part {
        return true
    }
    if codec.schema_word(part, 1) != 0 || key_component_end(part, 5) != Some(list.len(part)) {
        return false
    }
    if part[5] == 0 || next_key_component(part, 5) == list.len(part) {
        return true
    }
    if codec.schema_word(whole, 1) != 0 || key_component_end(whole, 5) != Some(list.len(whole)) {
        return false
    }
    let mut q = next_key_component(part, 5)
    let mut k = next_key_component(whole, 5)
    while q < list.len(part) {
        let Some(q_end) = key_component_end(part, q) else {
            return false
        }
        let Some(k_end) = key_component_end(whole, k) else {
            return false
        }
        if list.slice(part, q, q_end) != list.slice(whole, k, k_end) {
            return false
        }
        q = next_key_component(part, q_end)
        k = next_key_component(whole, k_end)
    }
    true
}

// In a checked schema, skip tuple headers to compare the concatenated components.
fn next_key_component(raw: Bytes, start: u64) -> u64 {
    let mut at = start
    while at < list.len(raw) && raw[at] == 18 {
        at += 5
    }
    at
}

fn key_component_end(raw: Bytes, start: u64) -> Option[u64] {
    let mut at = start
    let mut remaining = 1u64
    while remaining > 0 {
        if at >= list.len(raw) {
            return None
        }
        let op = raw[at]
        at += 1
        remaining -= 1
        if op == 14 || op == 16 || op == 21 {
            remaining += 1
        } else if op == 15 || op == 17 {
            remaining += 2
        } else if op == 18 {
            if list.len(raw) - at < 4 {
                return None
            }
            remaining += codec.schema_word(raw, at)
            at += 4
        } else if op > 13 {
            return None
        }
    }
    Some(at)
}

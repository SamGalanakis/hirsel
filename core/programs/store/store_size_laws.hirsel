type GrantedOpen: send {
    tasks: Tasks,
    d: Dir,
    c: Clock,
    r: Random,
    options: Options
}

fn writer_law_room() -> u64 {
    let Error(refused) = (bound bytes 18446744073709551615u64 {}) else {
        fail("expected a finite writer grant")
    }
    refused.available
}

// Six empty pages cost 6 × (round8(98 + 8) + 24) = 816 B. The inline
// Page is 24 + 8 for its image, 2 × 24 for list descriptors, 2 × 8
// for counters, and 2 for flags. The genesis branch keeps four Head
// slots at 288 B each: 4 + 24 + 4 + 8 + 3 × 64 + 24 (the keyed tree list)
// + 8 + 8 + 16. Db is inline and HostFile opens have no separate charge.
// Total: 816 + 4 × 288 = 1,968 B.
const GENESIS_WRITER_STATE: u64 = 1968

fn granted_open_commit(take input: GrantedOpen) -> Result[(), Error] waits {
    let before = writer_law_room()
    let mut db = open(input.tasks, input.d, input.c, input.r, input.options)?
    // Wait until the worker is in its loop and has released the ready sender.
    {
        let journal = disk_state(db)
        result.unwrap(channel.send(journal.journal, Barrier))
        if let WriteFailed(e) = result.unwrap(channel.receive(journal.written)) {
            return Error(Io(e))
        }
    }
    let open_charge = before - writer_law_room()
    // The ready channel is refunded. The creator keeps one aligned block.
    let group: u64 = int.widen(input.options.group_bytes)
    let commits: u64 = int.widen(input.options.group_commits)
    let worker = option.unwrap(charge.task(bytes[Result[(), Error]], journal_group_room(group) + JOURNAL_WORKER_SLACK))
    let creation = option.unwrap(charge.seq(bytes[u8], 4096))
    let fixed = open_charge - worker - creation - (journal_channel_bytes(commits) - journal_ready_bytes())
    if fixed != GENESIS_WRITER_STATE || fixed != writer_state_bytes() {
        fail("§1.1: fixed writer state at genesis")
    }
    let codec = std.codec.of_bytes()
    let _ = law_table(mut db, "values", std.codec.key_u64(), codec)?
    let t = table(mut db, "values", std.codec.key_u64(), codec)?
    let saved = run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        let mut value: Bytes = list.with_capacity(64)
        list.fill(mut value, 64, 7u8)
        put(mut tx, call_env, 1, value)
    })?
    let Committed(done) = saved else {
        return Error(Foreign)
    }
    durable(mut db, done.ticket)?
    close(take db)
}

fn group_override(group: u64) -> Overrides {
    let mut o = derived_sizes()
    o.group_bytes = Some(group)
    o
}

@test
fn directory_writer_need_is_sizing_boundary() -> Result[(), ()] {
    let mut o = derived_sizes()
    check_directory_sizing_boundary(o)
    o.resident_limit = Some(64 * MIB)
    check_directory_sizing_boundary(o)
    o.resident_limit = Some(512 * MIB)
    o.limits = Some(small_place_limits())
    check_directory_sizing_boundary(o)
    o.resident_limit = Some(4 * 1024 * MIB)
    o.limits = None
    check_directory_sizing_boundary(o)
    o.resident_limit = Some(12 * 1024 * MIB)
    o.group_commits = Some(4u32)
    check_directory_sizing_boundary(o)
    o.pack_bytes = Some(64 * MIB)
    o.checkpoint_bytes = Some(2 * MIB)
    o.journal_limit = Some(32 * MIB)
    check_directory_sizing_boundary(o)
    Ok(())
}

fn check_directory_sizing_boundary(o: Overrides) {
    let need = directory_writer_need(o)
    if let Error(_) = sized_with(Directory, need, o) {
        fail("§1.1: Directory refuses the reported writer need")
    }
    if let Ok(_) = sized_with(Directory, need - 1, o) {
        fail("§1.1: Directory accepts less than the reported writer need")
    }
}

// §1.1: a Directory grant covers the journal worker's own grant. A 64 MiB
// group used to size inside a 39,839,262 B share. At the resident floor:
//   journal worker: (67,108,864 + 4,096) + 32,768 + 288 + 64 = 67,146,080
//   segment creation block: 4,096
//   journal channels for 64 commits: 416 × 64 + 576 = 27,200
//   writer state: 1,968
//   resident: 1,048,576
//   cut phase: 16,777,640 + 65,536 + 2 × 95,326 + (4,096 + 16,711,680)
//            = 33,749,604, above the write peak of 2 × 16,777,296
//   total: 101,977,524
@test
fn directory_grant_covers_journal_worker(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let o = group_override(67108864)
    let need = 101977524u64
    match (bound bytes 0u64 {
        directory_writer_need(o)
    }) {
        Ok(total) if total == need => (),
        _ => fail("§1.1: Directory need must report the writer peak without allocating"),
    }
    match planned(Directory, 39839262, o) {
        Error(short) if short.need == need && short.have == 39839262 => (),
        _ => fail("§1.1: a 64 MiB group sized inside a share its journal worker exceeds"),
    }
    match planned(Directory, need - 1, o) {
        Error(short) if short.need == need && short.have == need - 1 => (),
        _ => fail("§1.1: one byte below the Directory peak was admitted"),
    }
    let place = planned(Directory, need, o) ?=> |_| Missing("directory sizing")
    let options = planned_options(place)
    let total = planned_bytes(place)
    let plan = writer_plan(Directory, options) ?=> |_| Missing("writer plan")
    if total != need || writer_bytes(plan) != need || options.group_bytes != 67108864u32 || options.resident_limit != 1048576 {
        fail("§1.1: the Directory peak at its exact share")
    }
    let input = GrantedOpen(tasks, d: disk_test_directory(d), c, r, options: take options)
    let running = task.spawn(tasks, bytes total, take input, granted_open_commit)
    result.unwrap(task.join(take running))
}

// §1.1 and §11.1 AP4a: a small Directory Place records the small limits
// (frame 327,760, value 262,144, meta 65,536) and reserves under 2 MiB.
// With a 64 KiB group, 64 commits and the 1 MiB resident floor:
//   journal worker: (65,536 + 4,096) + 32,768 + 288 + 64 = 102,752
//   segment creation block: 4,096
//   journal channels for 64 commits: 416 × 64 + 576 = 27,200
//   writer state: 1,968
//   resident: 1,048,576
//   write peak: 2 × 327,760 = 655,520, above the cut phase
//     max(65,536, 72 + 16 + 316 + 65,536 + 20) + 65,536 + 2 × 95,326
//     + (4,096 + 262,144) = 588,388 and recovery 65,536 + 327,760 = 393,296
//   total: 1,840,112 <= 2,097,152
// The same sizes with the ceilings need 34,934,196 (the cut phase,
// 33,749,604, wins there; directory_grant_covers_journal_worker keeps the
// default figure).
@test
fn small_directory_place_need(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut o = group_override(65536)
    o.pack_bytes = Some(65536)
    o.resident_limit = Some(MIB)
    o.limits = Some(small_place_limits())
    let need = 1840112u64
    if directory_writer_need(o) != need || need > 2 * MIB {
        fail("§11.1 AP4a: the small Directory Place need")
    }
    o.limits = None
    if directory_writer_need(o) != 34934196u64 {
        fail("§1.1: the same sizes at the ceilings")
    }
    o.limits = Some(small_place_limits())
    match planned(Directory, need - 1, o) {
        Error(short) if short.need == need => (),
        _ => fail("§11.1 AP4a: one byte below the small Directory need was admitted"),
    }
    let place = planned(Directory, need, o) ?=> |_| Missing("small directory sizing")
    let options = planned_options(place)
    let kept = match options.limits {
        Some(l) => same_limits(l, small_place_limits()),
        None => false,
    }
    if planned_bytes(place) != need || !kept {
        fail("§11.1 AP4a: the small Directory Place at its exact share")
    }
    let input = GrantedOpen(tasks, d: disk_test_directory(d), c, r, options: take options)
    let running = task.spawn(tasks, bytes need, take input, granted_open_commit)
    result.unwrap(task.join(take running))
}

type GrantedBucketOpen: send {
    endpoint: std.sim.s3.Endpoint,
    network: Net,
    c: Clock,
    r: Random,
    tasks: Tasks,
    options: Options
}

fn granted_bucket_cut(take input: GrantedBucketOpen) -> Result[(), Error] waits {
    let client = bucket_endpoint_client(input.endpoint, input.network, input.c, input.tasks, "s3.test", 2151, true, 1)?
    let authority = object_authority(take client, "bucket", BUCKET_LAW_OP_MS)
    let mut db = open_authority(input.tasks, take authority, input.c, input.r, input.options) ?=> |Refusal(error: take problem, ..)| take problem
    bucket_law_commit(mut db, 7)?
    bucket_law_checkpoint(mut db)?
    close(take db)
}

// §1.1 and §12.9, one 1 MiB lane with 64 KiB pack and group limits.
// Lifetime before resident:
//   lane: 1,048,576
//   history: 2 × round8(65,536 + 112 + 33) + 2 × 65,776 + round8(60) = 262,992
//   worker: 4 × 65,536 + 524,288 + 1,000 × (1,032 + 8 + 72) + 288 + 64 = 1,898,784
//   timer: 4,096 + 288 = 4,384. Channels: 416 × 64 + 640 = 27,264. State: 1,968.
//   lifetime before resident = 3,243,968. Resident adds 1,048,576.
// Journal holds two 16,777,296 B frames. Recovery holds an entry and
// decoded frame (33,554,744 B), or one checkpoint entry and one pack.
// The cut wins at 68,493,460 B:
//   output: 16,777,640 (MANIFEST file bound)
//   workspace: round8(189 + 33 + 32 × (32,768 + 255)) for the packet,
//     16,777,640 for the comparison buffer, 2 × 65,776 for heads and 64 for the key
//   PUT: max(8 MiB + 24 for one multipart part, 16,777,640 for the encoded MANIFEST)
//   cut work: 65,536 + 2 × ceil(1,048,576 / 11) + (4,096 + 16,711,680)
// T_floor = 72,786,004. The place needs T_floor + 80 + 1,258 = 72,787,342
// (the follower starter's 1,258 is L85's; Options carries its 32-byte limits).
@test
fn bucket_place_plan_at_floor(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let lanes = bucket_law_lanes(1)
    let kind: Kind = Bucket(lanes)
    let mut o = group_override(65536)
    o.pack_bytes = Some(65536)
    let writer_need = 72786004u64
    let need = 72787342u64
    let place = result.unwrap(planned(kind, need, o))
    if planned_bytes(place) != need || planned_options(place).resident_limit != MIB {
        fail("§1.1: the Bucket place plan at its exact share")
    }
    let capture = option.unwrap(planned_capture(place))
    let writer = result.unwrap(writer_plan(kind, planned_options(place)))
    if plan_bytes(capture) != writer_bytes(writer) - lanes.lane_bytes {
        fail("§1.1: the capture envelope must use the sized writer grant")
    }
    let Error(refused) = planned(kind, need - 1, o) else {
        fail("§1.1: one byte below the Bucket floor was admitted")
    }
    if refused.need != need || refused.have != need - 1 {
        fail("§1.1: the Bucket shortage must name the whole place grant")
    }
    let n = list.len(refused.parts)
    if n < 2 {
        fail("§1.1: the Bucket shortage must itemize capture")
    }
    let service = view refused.parts[n - 2]
    let starter = view refused.parts[n - 1]
    if service.0 != "follower_service" || service.1 != follower_service_bytes() || starter.0 != "follower_starter" || starter.1 != follower_starter_bytes() {
        fail("§1.1: the Bucket shortage must itemize both capture terms")
    }
    if writer_bytes(writer) != writer_need {
        fail("§1.1: the Bucket writer plan at its exact grant")
    }
    let sim = bucket_law_sim(tasks, c, 2151, None, list.new())
    let input = GrantedBucketOpen(endpoint: clone(sim.endpoint), network: sim.network, c: sim.time, r, tasks, options: planned_options(place))
    let running = task.spawn(tasks, bytes writer_need, take input, granted_bucket_cut)
    let opened = task.join(take running)
    let _ = bucket_law_finish(take sim)
    result.unwrap(take opened)
}

// §1.1 and §11.1 AP4a: the same Bucket place with the small limits. The
// lifetime terms (3,243,968 before resident) do not depend on the limits.
// The cut still wins, at 1,908,908 B:
//   output: 72 + 16 + 316 + 65,536 + 20 = 65,960 (MANIFEST file bound)
//   workspace: 1,056,960 for the packet, 65,960 for the comparison
//     buffer, 2 × 65,776 for heads and 64 for the key = 1,254,536
//   PUT: max(65,960 + 24 for the one multipart part, 65,960) = 65,984
//   cut work: 65,536 + 2 × 95,326 + (4,096 + 262,144) = 522,428
// above the write peak 2 × 327,760 = 655,520 and recovery
// max(327,912 + 327,760, 1,056,960 + 65,960) = 1,122,920.
// T_floor = 3,243,968 + 1,048,576 + 1,908,908 = 6,201,452; the place needs
// 6,201,452 + 80 + 1,258 = 6,202,790 (72,787,342 at the ceilings).
@test
fn small_bucket_place_plan_at_floor(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let lanes = bucket_law_lanes(1)
    let kind: Kind = Bucket(lanes)
    let mut o = group_override(65536)
    o.pack_bytes = Some(65536)
    o.limits = Some(small_place_limits())
    let writer_need = 6201452u64
    let need = 6202790u64
    let place = result.unwrap(planned(kind, need, o))
    if planned_bytes(place) != need || planned_options(place).resident_limit != MIB {
        fail("§11.1 AP4a: the small Bucket place plan at its exact share")
    }
    let writer = result.unwrap(writer_plan(kind, planned_options(place)))
    if writer_bytes(writer) != writer_need {
        fail("§11.1 AP4a: the small Bucket writer plan at its exact grant")
    }
    let Error(refused) = planned(kind, need - 1, o) else {
        fail("§11.1 AP4a: one byte below the small Bucket floor was admitted")
    }
    if refused.need != need {
        fail("§11.1 AP4a: the small Bucket shortage must name the whole place grant")
    }
    let sim = bucket_law_sim(tasks, c, 2151, None, list.new())
    let input = GrantedBucketOpen(endpoint: clone(sim.endpoint), network: sim.network, c: sim.time, r, tasks, options: planned_options(place))
    let running = task.spawn(tasks, bytes writer_need, take input, granted_bucket_cut)
    let opened = task.join(take running)
    let _ = bucket_law_finish(take sim)
    result.unwrap(take opened)
}

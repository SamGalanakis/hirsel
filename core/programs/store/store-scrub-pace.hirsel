// §11.17 continuous paced Directory scrub (CLOUD #5) and persisted
// scrub-round history (T13).
//
// History lives in a dedicated context-bound atomic sidecar `SCRUB` in the
// Directory store so `hirsel store stats DIR` can report the last complete
// round without a release binary or a MANIFEST format bump.
pub const SCRUB_HISTORY_ROLE: u8 = 11

pub const SCRUB_HISTORY_KIND: u16 = 0x008A

pub const SCRUB_HISTORY_MAX_ROUNDS: u64 = 64

pub const SCRUB_HISTORY_FILE_LIMIT: u64 = 16384

// Overflow-safe ceil(num * 1000 / den).
pub fn ceil_millis_ratio(num: u64, den: u64) -> u64 {
    if num == 0u64 || den == 0u64 {
        return 0u64
    }
    let q = num / den
    let r = num % den
    let q_part = match int.checked_mul(q, 1000u64) {
        Some(v) => v,
        None => return 18446744073709551615u64,
    }
    let r_part = match int.checked_mul(r, 1000u64) {
        Some(scaled) => {
            let extra = scaled / den
            if scaled % den != 0u64 {
                int.saturating_add(extra, 1u64)
            } else {
                extra
            }
        },
        None => {
            // r < den and r * 1000 overflowed, so den > u64::MAX / 1000.
            // Split r into (r / 1000) * 1000 + (r % 1000) to stay bounded.
            let step = den / 1000u64
            if step == 0u64 {
                1000u64
            } else {
                let approx = r / step
                if approx * step < r {
                    int.saturating_add(approx, 1u64)
                } else {
                    approx
                }
            }
        },
    }
    int.saturating_add(q_part, r_part)
}

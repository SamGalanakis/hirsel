// Module `int`: integer operations (SEM-1). CORE operations are listed in core.md and
// not repeated here except where this module defines a type they name. `T` ranges over
// the integer types. Parsing reads a String view, so with G1 it parses part of a line
// without a copy. Nothing here allocates.

/// Error of int.parse and float.parse (core.md names it without a shape).
/// Empty: no digits. Invalid(i): byte i is not part of a number. OutOfRange: the value
/// does not fit the target type (a float parse never returns it; see float.parse).
pub type ParseError = Empty | Invalid(u64) | OutOfRange

/// Three-way order; the result of float.total_order and of every sort callback.
pub type Order = Less | Equal | Greater

/// CORE. Restated for its error shape. Parses the whole of s in decimal: an optional
/// '-' for signed T, then ASCII digits; no '+', spaces or '_'.
/// Fails: Error(Empty | Invalid(i) | OutOfRange). Cost: O(len).
/// Ex: `let n: u64 = int.parse(field)?`
pub fn parse[T](s: String) -> Result[T, ParseError]

/// Parses the whole of s in `base` (2 to 36), digits as char.digit reads them.
/// Fails: Bounds (failure) when base is outside 2..=36; otherwise as parse.
/// Cost: O(len). Ex: `let cp: u32 = int.parse_radix(hex4, 16)?`
pub fn parse_radix[T](s: String, base: u32) -> Result[T, ParseError]

/// Three-way numeric order. Cost: O(1). Ex: `int.compare(a, b)`
pub fn compare[T](a: T, b: T) -> Order

// Module harness: the session ingress (ADR 0101). Submissions and commands
// lodge in one ordered table and drain at prepare (Early input) or at the
// turn boundary (commands, then the next input).

// Admits a submission into the session's ingress. A repeated key with
// identical bytes (and the same `when`) answers its current disposition;
// different bytes conflict. Nothing is refused for being busy: the item waits
// at its enqueue_seq. An idle session takes it in this same transaction.
pub fn submit[G: send, App: inert + send](mut tx: store.Tx, h: Handles, a: Agent[G, App], w: Wiring, caller: store.Caller, when: When, take m: Submit) -> Result[Disposition, Refused] {
    if string.byte_len(m.text) > INLINE_LIMIT {
        return Error(TooLarge)
    }
    let Submit(client_key: take client_key, text: take text) = take m
    lodge(mut tx, h, a, w, InboxKey(caller: clone(caller), client_key: take client_key), Input(when, take text))
}

// Admits a session command. It applies at the next turn boundary, ahead of
// every input queued with it.
pub fn command[G: send, App: inert + send](mut tx: store.Tx, h: Handles, a: Agent[G, App], w: Wiring, caller: store.Caller, take client_key: String, take c: Command) -> Result[Disposition, Refused] {
    lodge(mut tx, h, a, w, InboxKey(caller: clone(caller), client_key: take client_key), Command(take c))
}

fn lodge[G: send, App: inert + send](mut tx: store.Tx, h: Handles, a: Agent[G, App], w: Wiring, take key: InboxKey, take item: Item) -> Result[Disposition, Refused] {
    let Some(raw) = encoded(item) else {
        return Error(Malformed("item"))
    }
    let d = digest(raw)
    if let Some(seen) = kept(store.fetch(tx, h.inbox, key))? {
        if seen.digest != d {
            return Error(Conflict)
        }
        return Ok(clone(seen.disposition))
    }
    let mut s = session_of(tx, h)?
    cancel_warm(mut tx, h, mut s)?
    let seq = s.next_seq
    s.next_seq = seq + 1u64
    kept(store.put(mut tx, h.session, 0u64, s))?
    kept(store.put(mut tx, h.inbox, clone(key), Received(digest: take d, disposition: Queued(seq))))?
    kept(store.put(mut tx, h.ingress, seq, Lodged(key: clone(key), item: take item)))?
    advance(mut tx, h, a, w, Kick)?
    match kept(store.fetch(tx, h.inbox, key))? {
        Some(r) => Ok(clone(r.disposition)),
        None => Error(Malformed("inbox")),
    }
}

fn queue_empty(tx: store.Tx, h: Handles) -> Result[bool, Refused] {
    let Ok(take cursor) = store.range(tx, h.ingress, Unbounded, Unbounded) else {
        return Error(Storage)
    }
    let mut rows = take cursor
    match kept(store.next_in(tx, mut rows))? {
        Some(_) => Ok(false),
        None => Ok(true),
    }
}

fn disposed(mut tx: store.Tx, h: Handles, key: InboxKey, d: Disposition) -> Result[(), Refused] {
    let Some(take found) = kept(store.fetch(tx, h.inbox, key))? else {
        return Error(Malformed("inbox"))
    }
    let mut r = take found
    r.disposition = d
    kept(store.put(mut tx, h.inbox, key, r))
}

// The first `limits.ingress` ingress rows, in enqueue order.
fn queue_window(tx: store.Tx, h: Handles, l: Limits) -> Result[List[(u64, Lodged)], Refused] {
    let mut out: List[(u64, Lodged)] = list.new()
    let Ok(take cursor) = store.range(tx, h.ingress, Unbounded, Unbounded) else {
        return Error(Storage)
    }
    let mut rows = take cursor
    while list.len(out) < l.ingress {
        let Some((seq, take row)) = kept(store.next_in(tx, mut rows))? else {
            break
        }
        list.push(mut out, (seq, take row))
    }
    Ok(take out)
}

// A turn boundary: no run is active. Every command in the window applies in
// enqueue order, each alone, then the earliest input starts the next run.
fn boundary[G: send, App: inert + send](mut tx: store.Tx, h: Handles, a: Agent[G, App], w: Wiring, mut s: Session) -> Result[(), Refused] {
    let rows = queue_window(tx, h, a.limits)?
    if list.len(rows) == a.limits.ingress {
        let _ = arm_kick(mut tx, h, w)?
    }
    for (seq, row) in rows {
        if let Command(c) = view row.item {
            apply(mut tx, h, mut s, c)?
            let _ = kept(store.delete(mut tx, h.ingress, seq))?
            disposed(mut tx, h, row.key, Applied)?
        }
    }
    for (seq, row) in rows {
        if let Input(_, text) = view row.item {
            let _ = kept(store.delete(mut tx, h.ingress, seq))?
            let _ = append(mut tx, h, a, mut s, User(clone(text)))?
            let id = s.next_run
            s.next_run = id + 1u64
            s.active_run = Some(id)
            disposed(mut tx, h, row.key, Placed(id))?
            let run = Run(caller: clone(row.key.caller), phase: Preparing, round: 0u64, rounds_left: a.limits.rounds, stalled: 0u64, spend: Spend(known: 0u64, reserved: 0u64, unresolved: 0u64))
            kept(store.put(mut tx, h.runs, id, clone(run)))?
            kept(store.put(mut tx, h.session, 0u64, clone(s)))?
            return prepare(mut tx, h, a, w, mut s, id, clone(run))
        }
    }
    kept(store.put(mut tx, h.session, 0u64, s))
}

fn apply(mut tx: store.Tx, h: Handles, mut s: Session, c: Command) -> Result[(), Refused] {
    match c {
        Narrow(n) => {
            s.tools_narrow = clone(n)
        },
        Compact(seed) => {
            let base = s.next_pos
            let _ = open_frame(mut tx, h, mut s, FrameOpen(base: base, reason: "compact", seed: clone(seed)))?
        },
    }
    Ok(())
}

// Early input from the run's caller joins the run at its prepare, in enqueue
// order. Everything else in the window waits for a boundary.
fn steer[G: send, App: inert + send](mut tx: store.Tx, h: Handles, a: Agent[G, App], mut s: Session, id: u64, caller: store.Caller) -> Result[(), Refused] {
    let rows = queue_window(tx, h, a.limits)?
    for (seq, row) in rows {
        if let Input(Early, text) = view row.item {
            if row.key.caller.issuer == caller.issuer && row.key.caller.subject == caller.subject {
                let _ = kept(store.delete(mut tx, h.ingress, seq))?
                let _ = append(mut tx, h, a, mut s, User(clone(text)))?
                disposed(mut tx, h, row.key, Joined(id))?
            }
        }
    }
    Ok(())
}

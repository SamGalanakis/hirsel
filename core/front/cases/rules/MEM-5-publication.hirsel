// MEM-5 (memory.md): a published stable value is never written, so a `mut` parameter of
// a stable type is refused at that parameter (the spec's `f`). A plain view of it is
// accepted.
// expect: refuse MEM-5 at 5:17
fn f(r: Region, mut t: Text in r) {}
fn g(r: Region, t: Text in r) -> u64 { text.len(t) }

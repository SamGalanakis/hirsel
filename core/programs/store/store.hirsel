pub type Looked[R] = Seen(Seen[R]) | Failed(Causes) | Refused(StoreCapacity) | Stopped(OutOfTime)

pub type Seen[R] {
    value: R,
    version: u64,
    reads: List[Read]
}

pub fn look[R](s: Snapshot, steps: Option[u64], body: scoped[view] fn(Tx) -> R) -> Result[Looked[R], Error] {
    let reads: Log[Read] = log.new()
    let issued: Log[u64] = log.new()
    let caught = isolate(fn() -> Result[R, OutOfTime] {
        let perform = scoped fn() -> R {
            let tx = Tx(store: s.store, roots: share_roots(s.roots), ids: 0, private_from: 1, resident: 0, retain_old: false, reads: view reads, issued: view issued, refusal: None, frame_bytes: 42, wrote: false, ops: empty_ops(), info: CallInfo(id: CallId(store: s.store, branch: s.branch, version: s.head), at: 0, seed: 0), stream_ops: empty_ops(), extra_bytes: 0, call: None)
            body(tx)
        }
        match steps {
            Some(n) => bound steps n { perform() },
            None => Ok(perform()),
        }
    })
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Ok(Refused(Allocation(c))),
        Ok(Error(take cs)) => match raised_capacity(cs) {
            Some(c) => Ok(Refused(Allocation(c))),
            None => Ok(Failed(take cs)),
        },
        Ok(Ok(Error(e))) => Ok(Stopped(e)),
        Ok(Ok(Ok(take value))) => Ok(Seen(Seen(value: take value, version: s.head, reads: take seen)))
    }
}

pub type Change {
    tree_key: Bytes,
    value: Option[Arc[Bytes]]
}

pub fn changes(a: Snapshot, b: Snapshot) -> Result[List[Change], Error] {
    if !same(a.store, b.store) || a.open != b.open { return Error(Foreign) }
    compare_page_collections(a.roots.collections, b.roots.collections)
}

fn look_query(tx: Tx, sh: Shape[u64, u64], ix: Index[u64, u64, u64]) -> Result[u64, Error] {
    let a = option.unwrap(fetch(tx, sh, 1)?)
    let absent = fetch(tx, sh, 9)?
    if let Some(_) = absent {
        return Error(Missing("law"))
    }
    let mut rows = range(tx, sh, Excluded(1), Included(3))?
    let mut sum = a
    while let Some((_, v)) = next_range(mut rows)? {
        sum += v
    }
    let mut matches = lookup(tx, ix, Included(2), Included(2))?
    while let Some((_, v)) = next_indexed(mut matches)? {
        sum += v
    }
    Ok(sum)
}

fn equal_reads(a: List[Read], b: List[Read]) -> bool {
    if list.len(a) != list.len(b) {
        return false
    }
    for i in 0u64 .. list.len(a) {
        let equal = match (a[i], b[i]) {
            (Point(k), Point(j)) => k == j,
            (Span(l, h), Span(low, high)) => l == low && h == high,
            _ => false
        }
        if !equal {
            return false
        }
    }
    true
}

// L22: 10 + (20+30) + (10+30) = 100; two points and two spans.
// Wrong implementations: look publishes, omits reads or reports another version.
pub fn law_look(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("look", std.codec.key_u64(), std.codec.of_u64())))
    let mut t = result.unwrap(table(mut db, "look", std.codec.key_u64(), std.codec.of_u64()))
    for k in 1u64 .. 4 {
        if !typed_put(mut db, t, k, k * 10) {
            return false
        }
    }
    result.unwrap(create_index(mut db, t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let ix = result.unwrap(index(db, mut t, "bucket", code.describe(bucket), std.codec.key_u64()))
    let sh = shape(t)
    let s = snapshot(db)
    let head = db.heads[0].head
    let live = db.resident
    let high_water = db.next_node
    let end = db.file_end
    let observed = result.unwrap(look(s, None, fn(tx: Tx) -> Result[u64, Error] {
        look_query(tx, sh, ix)
    }))
    let got = match take observed {
        Seen(take x) => take x,
        _ => return false
    }
    match got.value {
        Ok(100) => {},
        _ => return false
    }
    if got.version != head || list.len(got.reads) != 7 || db.heads[0].head != head || db.resident != live || db.next_node != high_water || db.file_end != end {
        return false
    }
    let p1 = match got.reads[0] {
        Point(k) => k == result.unwrap(logical_key(t.id, key_word(1))),
        _ => false
    }
    let p2 = match got.reads[1] {
        Point(k) => k == result.unwrap(logical_key(t.id, key_word(9))),
        _ => false
    }
    // [table1 || key1 || 00, table1 || key3 || 00) includes precisely 2 and 3.
    let mut low = result.unwrap(logical_key(t.id, key_word(1)))
    list.push(mut low, 0u8)
    let mut high = result.unwrap(logical_key(t.id, key_word(3)))
    list.push(mut high, 0u8)
    let mut middle = result.unwrap(logical_key(t.id, key_word(2)))
    list.push(mut middle, 0u8)
    let span = match (got.reads[2], got.reads[3]) {
        (Span(l, m), Span(n, h)) => l == low && m == middle && n == middle && h == high,
        _ => false
    }
    let ix_low = result.unwrap(logical_key(ix.id, key_word(2)))
    let ix_high = result.unwrap(logical_key(ix.id, key_word(3)))
    let index_span = match got.reads[4] {
        Span(l, h) => l == ix_low && h == ix_high,
        _ => false
    }
    if !p1 || !p2 || !span || !index_span {
        return false
    }
    let run_result = run(mut db, None, fn(mut tx: Tx) -> Result[u64, Error] {
        look_query(tx, sh, ix)
    })
    match take run_result {
        Ok(Committed(done)) => if done.value != 100 || !equal_reads(done.reads, got.reads) {
            return false
        },
        _ => return false
    }
    if !typed_put(mut db, t, 1, 14) {
        return false
    }
    let second = result.unwrap(look(snapshot(db), None, fn(tx: Tx) -> Result[u64, Error] {
        look_query(tx, sh, ix)
    }))
    match take second {
        Seen(value) => match value.value {
            Ok(108) => value.version == db.heads[0].head && list.len(value.reads) == 7,
            _ => false
        },
        _ => false
    }
}

fn has_failure(cs: Causes, message: String) -> bool {
    for cause in cs {
        if let Fail(text) = cause.kind {
            if text == message {
                return true
            }
        }
    }
    false
}

// L22: faults and Capacity are contained. info requires mut Tx (v2.4 G2).
pub fn law_look_faults(c: Clock) -> bool {
    let db = test_db(c, 1073741824)
    let s = snapshot(db)
    for i in 0u64 .. 2 {
        let message = if i == 0 {
            "look body fault"
        } else {
            "another query fault"
        }
        let failed = result.unwrap(look(s, None, fn(tx: Tx) -> u64 {
            fail(string.from(message))
        }))
        match take failed {
            Failed(take cs) => if !has_failure(cs, message) {
                return false
            },
            _ => return false
        }
        let expected = if i == 0 {
            7u64
        } else {
            19u64
        }
        let observed = result.unwrap(result.unwrap(bound bytes 80 {
            look(s, None, fn(tx: Tx) -> u64 { expected })
        }))
        match take observed {
            Seen(value) => if value.value != expected || value.version != 0 || list.len(value.reads) != 0 {
                return false
            },
            _ => return false
        }
    }
    let refused_query = result.unwrap(bound bytes 79 {
        look(s, None, fn(tx: Tx) -> u64 {
            7u64
        })
    })
    match take refused_query {
        Ok(Refused(Allocation(cap))) => cap.requested == 32 && cap.available == 31 &&
            db.heads[0].head == 0 && db.resident == 0,
        _ => false
    }
}

fn check_delta(a: Snapshot, b: Snapshot, before: List[u64], after: List[u64]) -> bool {
    let delta = result.unwrap(changes(a, b))
    let mut at: u64 = 0
    for k in 0u64 .. list.len(before) {
        if before[k] != after[k] {
            if at == list.len(delta) {
                return false
            }
            if delta[at].tree_key != result.unwrap(logical_key(1, key_word(k))) {
                return false
            }
            let good = match delta[at].value {
                None => after[k] == 0,
                Some(raw) => list.slice(raw, 0, list.len(raw)) == key_word(after[k]) && after[k] != 0
            }
            if !good {
                return false
            }
            at += 1
        }
    }
    at == list.len(delta)
}

// L23: independent 160-slot model, split/merged leaves, added and deleted roots,
// reverse comparison, branch/open boundaries and unchanged roots under bound0.
// Wrong implementations: scan equal roots, omit None, confuse branch with open.
pub fn law_changes(c: Clock) -> bool {
    let mut db = raw_test_db(c, 1073741824)
    let empty = snapshot(db)
    let mut zeros: List[u64] = list.with_capacity(160)
    list.fill(mut zeros, 160, 0u64)
    let mut before: List[u64] = list.with_capacity(160)
    list.fill(mut before, 160, 0u64)
    for k in 0u64 .. 96 {
        if !put_one(mut db, k, k + 1) {
            return false
        }
        let _ = list.set(mut before, k, k + 1)
    }
    let a = snapshot(db)
    let after_copy: List[u64] = clone(before)
    let mut after = take after_copy
    for step in 0u64 .. 48 {
        let k = (step * 37) % 160
        let v = if step % 2 == 0 {
            0u64
        } else {
            step + 1000
        }
        let outcome = execute(mut db, 0, step, None, fn(mut tx: Tx) -> Result[(), Error] {
            if v == 0 {
                let _ = delete_bytes(mut tx, 1, key_word(k))?
            } else {
                put_bytes(mut tx, 1, key_word(k), key_word(v))?
            }
            Ok(())
        })
        match take outcome {
            Ok(Committed(_)) => {},
            _ => return false
        }
        let _ = list.set(mut after, k, v)
    }
    let b = snapshot(db)
    if !check_delta(empty, a, zeros, before) || !check_delta(a, empty, before, zeros) || !check_delta(a, b, before, after) || !check_delta(b, a, after, before) {
        return false
    }
    let same_root = result.unwrap(bound bytes 0 {
        changes(b, b)
    })
    match take same_root {
        Ok(rows) => if list.len(rows) != 0 {
            return false
        },
        _ => return false
    }
    let other_branch = Snapshot(store: b.store, open: b.open, branch: 9, head: b.head, roots: share_roots(b.roots))
    if !check_delta(a, other_branch, before, after) {
        return false
    }
    let other_open = Snapshot(store: b.store, open: 1, branch: 0, head: b.head, roots: share_roots(b.roots))
    if !is_foreign(changes(a, other_open)) {
        return false
    }
    let foreign = raw_test_db(c, 1073741824)
    let other_store = Snapshot(store: StoreId(hi: 9, lo: 9), open: 0, branch: 0, head: foreign.heads[0].head, roots: share_roots(foreign.heads[0].roots))
    if !is_foreign(changes(a, other_store)) {
        return false
    }
    // R1: the diff's own allocation is refused under a zero bound and raises
    // Capacity; changes has no refusal value of its own.
    let no_room = isolate(fn() -> Result[Result[List[Change], Error], Capacity] {
        bound bytes 0 {
            changes(a, b)
        }
    })
    match take no_room {
        Ok(Error(causes)) => match raised_capacity(causes) {
            Some(_) => true,
            None => false
        },
        _ => false
    }
}

// A change can keep a large value within a budget that cannot copy it.
pub fn law_shared_changes(c: Clock) -> bool {
    let mut db = raw_test_db(c, 1073741824)
    let before = snapshot(db)
    let outcome = execute(mut db, 0, 1, None, fn(mut tx: Tx) -> Result[(), Error] {
        let mut payload: Bytes = list.with_capacity(8192)
        list.fill(mut payload, 8192, 51u8)
        put_bytes(mut tx, 1, key_word(7), payload)
    })
    if let Ok(Committed(_)) = outcome {} else { return false }
    let after = snapshot(db)
    let low = result.unwrap(prefix(1))
    let high = result.unwrap(prefix(2))
    let delta = result.unwrap(result.unwrap(bound bytes 4096 { changes(before, after) }))
    let rows = result.unwrap(result.unwrap(bound bytes 4096 { span_changes(after, low, high) }))
    if !same_rows(rows, delta, 0, 1) || list.len(delta) != 1 { return false }
    match delta[0].value {
        Some(payload) => list.len(payload) == 8192 && payload[0] == 51 && payload[8191] == 51,
        None => false
    }
}

@test
fn test_shared_changes(c: Clock) -> Result[(), ()] {
    if law_shared_changes(c) { Ok(()) } else { Error(()) }
}


// LANG-6: the selected arm's String lives through the call or binding, then is freed.
// expect: run call_view(1) = 99
// expect: run call_view(0) = 101
// expect: run bind_view(1) = 198
// expect: run bind_view(0) = 202
fn made(s: String) -> String {
    string.from(s)
}

fn last_byte(b: Bytes) -> u64 {
    int.widen(b[list.len(b) - 1u64])
}

fn call_view(c: u64) -> u64 {
    last_byte(if c == 1 {
        string.as_bytes(made("abc"))
    } else {
        string.as_bytes(made("abcde"))
    })
}

fn bind_view(c: u64) -> u64 {
    let v = if c == 1 {
        string.as_bytes(made("abc"))
    } else {
        string.as_bytes(made("abcde"))
    }
    last_byte(v) + last_byte(v)
}

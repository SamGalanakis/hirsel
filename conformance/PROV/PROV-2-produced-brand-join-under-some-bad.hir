// rule: PROV-2
// expect: reject PROV-2 at line 8
// twin: PROV/PROV-2-produced-brand-run.hir
// `Some` transports its payload's own brand; a join of two owners' tokens has
// no single brand, and the declared result cannot supply one.
pub opaque type V: copyable + plain + inert + ordered of uses {} { n: u64 }
fn bad(a: Authority, b: Authority, x: V of a, y: V of b, choose: bool) -> Option[V of a] {
  Some(if choose { x } else { y })
}

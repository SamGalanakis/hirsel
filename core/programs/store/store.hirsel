// The writer owns the persistent page trees; readers hold Arc roots.
pub type StoreId: codec + key {
    hi: u64,
    lo: u64
}

pub type StorageKind: send = Directory() | Bucket(std.object.Bucket)

pub type Caller: codec + key + shareable + cross {
    issuer: u8,
    subject: Bytes
}

pub type Limit: shareable + cross = Key | Value | Transaction | Name | Ids | Manifest | Triggers

pub type Why: shareable + cross = Checksum | Truncated | Flags | Kind(u64) | Header | Gap(u64) | Order | Dangling(u64) | Absent | Malformed | Regressed

pub type Fault: shareable + cross {
    file: String,
    offset: u64,
    why: Why
}

pub type StoreCapacity: shareable + cross = Journal(Capacity) | Resident(Capacity) | Allocation(Capacity) | Cache(Capacity) | Slots(Capacity) | Pins(Capacity) | Register(Capacity)

pub type Error: shareable + cross = Held | NotFound | Corrupt(Fault) | Unsupported(u64) | Io(IoError) | Poisoned(IoError) | Full(StoreCapacity) | Limit(Limit) | Schema(u64) | Stale(u32) | Decode(std.codec.DecodeError) | Exists(String) | Missing(String) | Changed(String) | Conflict(String) | Undeclared(String) | NoLevel(String) | Behind(Position) | Gone(u32) | Unseen(u32) | Diverged(u32) | Foreign | MigrationFault | ExportDirectory | Fenced(u64) | Lost | Undecided | Declared(String) | NotCurrent(u64) | Endpoint(EndpointRefusal) | HistoryMissing(String, Option[u64]) | Reclaimed(u64) | Retired | Remote(std.object.Error) | Missed | Tiered(TieredRefusal) | NotReady(String) | Drift(String) | LimitsDiffer(StoreLimits) | Attached(Option[HostStreamId]) | Stream(StreamRefusal) | Latched(StreamLatch)

type Roots = PageRoots

fn empty_roots() -> Roots {
    PageRoots(collections: new_page_tree(CollectionMap, 1024), streams: new_page_tree(Unprefixed, 1024), catalog: new_page_tree(Unprefixed, 1024), keyed: list.new())
}

fn share_roots(r: Roots) -> Roots {
    PageRoots(collections: share_page_tree(r.collections), streams: share_page_tree(r.streams), catalog: share_page_tree(r.catalog), keyed: share_keyed_pages(r.keyed))
}

type Ack: send = Journaled(u64, u64) | Broken(IoError) | ObjectJournaled(u64, u64, u64) | ObjectBroken(Error)

pub opaque type Db {
    store: StoreId,
    pager: Option[Sender[TieredPagerMessage]],
    // The pager's one-slot writer channel, its park notices until the
    // caller takes them, and the parked calls (§13.3a).
    pager_writer: Option[Sender[TieredPagerMessage]],
    park_notices: Option[Receiver[()]],
    parked: ParkQueue,
    // The writer partition every call's attempt is counted against (§13.2).
    writer_pin_bytes: u64,
    indexes: IndexRegistry,
    fence: u32,
    disk: Option[DiskState],
    clock: Clock,
    // Every live branch, main first, the rest ascending by id. A version is
    // compared only with the head of the branch it belongs to (AA1, Z1).
    heads: List[Head],
    branch_names: Map[String, u32],
    pins: List[Pin],
    record_bytes: u64,
    limits: StoreLimits,
    next_pin: u64,
    next_branch: u32,
    next_node: u64,
    next_table: u32,
    file_seq: u64,
    file_end: u64,
    frame_seq: u64,
    resident: u64,
    tiered: u64,
    page_resident: u64,
    // Commits and cut-made operations on any branch.
    changes: u64,
    // The `changes` count at which `resident` was last exact (I4).
    settled: u64,
    ceiling: u64,
    keyed_credit: KeyedCredit,
    checkpointed: u64,
    // Stream name to the unreplied Admitted(p) this open committed (§1.8).
    admits: Map[Bytes, OpenAdmit],
    stream_retention_ms: u64,
    streams_per_caller_max: u64,
    streams_max: u64,
    stream_sweep_after: Option[StreamSweepCursor],
    // Index drift seen since this open (§I.3 step one), one entry per index.
    drift: List[IndexDrift],
    // `attention_mark`'s own part (store-attention.hirsel).
    attention_seq: u64,
    // The projector pins' roots, rebuilt on each pin change; every Snapshot and
    // Tx shares them as `read_tail`'s bases. Then the registered projectors (§1.14).
    bases: TailBases,
    projectors: List[DeclaredProjector],
}

pub type Branch {
    store: StoreId,
    id: u32
}

type Head {
    id: u32,
    name: String,
    parent: u32,
    forked_at: u64,
    roots: Roots,
    head: u64,
    at: u64,
    following: Option[Latest[Snapshot]]
}

fn main_head(take roots: Roots, head: u64, at: u64) -> Head {
    Head(id: 0, name: "main", parent: 0, forked_at: 0, roots: take roots, head: head, at: at, following: None)
}

// I4: while a pin or another branch exists, an old row may stay reachable, so
// commits charge conservatively until the next cut settles the account.
// An import pin's pages are its own (§3.5a "The kept import"), so it retains nothing.
fn retaining(db: Db) -> bool {
    list.len(db.heads) > 1 || std.list.any(db.pins, fn(held: Pin) -> bool {
        held.owner != ImportPin
    })
}

// A branch as a cut, open and replay carry it: a Head without the readers'
// handle (section 3.5 step 3).
type Tip: shareable + send {
    id: u32,
    name: String,
    parent: u32,
    forked_at: u64,
    roots: Roots,
    head: u64,
    at: u64
}

// Every branch's head and every pin: what one cut makes durable.
type State: shareable + send {
    tips: List[Tip],
    pins: List[Pin],
    next_branch: u32,
    next_table: u32
}

type ProposedMain {
    roots: Roots,
    head: u64,
    at: u64,
    tables: u32,
    activation: Option[HistoryActivation],
    // The import pin slot an installing cut removes with the replacement
    // (§3.5a "The kept import").
    drop_pin: Option[u64]
}

type HolderDelta = NoHolderChange | AddHead(Head, String) | RemoveHead(u64) | AddPin(Pin) | RemovePin(u64) | ReplacePin(u64, Pin) | ReplaceMain(ProposedMain, Option[u64])

fn main_state(take roots: Roots, head: u64, at: u64) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.new()
    list.push(mut tips, Tip(id: 0, name: "main", parent: 0, forked_at: 0, roots: take roots, head: head, at: at))
    Ok(State(tips: take tips, pins: list.new(), next_branch: 1, next_table: 1))
}

fn tip_of(h: Head) -> Tip {
    Tip(id: h.id, name: string.from(h.name), parent: h.parent, forked_at: h.forked_at, roots: share_roots(h.roots), head: h.head, at: h.at)
}

// Project the proposed holders into the checkpoint's input. The live holder
// slots and the table-id counter still describe the installed generation.
fn state_with_delta(db: Db, delta: HolderDelta) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.with_capacity(list.len(db.heads))
    let mut kept: List[Pin] = list.with_capacity(list.len(db.pins))
    let mut tables = db.next_table
    for slot in 0u64 .. list.len(db.heads) {
        if let RemoveHead(gone) = delta {
            if slot == gone {
                continue
            }
        }
        if let ReplaceMain(proposed, gone) = delta {
            if let Some(away) = gone {
                if slot == away {
                    continue
                }
            }
            if slot == 0 {
                let h = db.heads[0u64]
                list.push(mut tips, Tip(id: 0, name: string.from(h.name), parent: h.parent, forked_at: h.forked_at, roots: share_roots(proposed.roots), head: proposed.head, at: proposed.at))
                tables = proposed.tables
                continue
            }
        }
        list.push(mut tips, tip_of(db.heads[slot]))
    }
    if let AddHead(added, _) = delta {
        list.push(mut tips, tip_of(added))
    }
    let dropped = removed_pin(delta)
    for slot in 0u64 .. list.len(db.pins) {
        if dropped == Some(slot) {
            continue
        }
        let held = if let ReplacePin(at, replacement) = delta {
            if at == slot {
                replacement
            } else {
                view db.pins[slot]
            }
        } else {
            view db.pins[slot]
        }
        list.push(mut kept, share_pin(held)?)
    }
    if let AddPin(added) = delta {
        list.push(mut kept, share_pin(added)?)
        list.sort(mut kept, fn(a: Pin, b: Pin) -> Order {
            pin_order(a.name, a.owner, b.name, b.owner)
        })
    }
    Ok(State(tips: take tips, pins: take kept, next_branch: db.next_branch, next_table: tables))
}

fn current_state(db: Db) -> Result[State, Capacity] {
    state_with_delta(db, NoHolderChange)
}

fn prepare_holder_slot(mut db: Db, delta: HolderDelta) -> Result[(), Error] {
    match delta {
        AddHead(_, _) => {
            capacity(map.try_reserve(mut db.branch_names, 1))?
            capacity(list.try_reserve(mut db.heads, 1))
        },
        AddPin(_) => capacity(list.try_reserve(mut db.pins, 1)),
        _ => Ok(()),
    }
}

fn install_head(mut db: Db, take added: Head, take indexed_name: String) {
    db.record_bytes += branch_root_bytes(added.name, added.roots)
    map.insert(mut db.branch_names, take indexed_name, added.id)
    list.push(mut db.heads, take added)
}

fn remove_head(mut db: Db, slot: u64) {
    let removed = list.remove(mut db.heads, slot)
    db.record_bytes -= branch_root_bytes(removed.name, removed.roots)
    let _ = map.remove(mut db.branch_names, removed.name)
}

fn install_holder_delta(mut db: Db, take delta: HolderDelta) {
    match take delta {
        NoHolderChange => return (),
        AddHead(take added, take name) => install_head(mut db, take added, take name),
        RemoveHead(slot) => remove_head(mut db, slot),
        AddPin(take added) => {
            db.record_bytes += pin_root_bytes(added.name, added.roots)
            let mut slot = 0u64
            while slot < list.len(db.pins) && pin_order(db.pins[slot].name, db.pins[slot].owner, added.name, added.owner) == Less {
                slot += 1
            }
            list.insert(mut db.pins, slot, take added)
            db.bases = tail_bases(db.pins)
        },
        RemovePin(slot) => {
            let removed = list.remove(mut db.pins, slot)
            db.record_bytes -= pin_root_bytes(removed.name, removed.roots)
            db.bases = tail_bases(db.pins)
        },
        ReplacePin(slot, take replacement) => {
            db.record_bytes -= pin_root_bytes(db.pins[slot].name, db.pins[slot].roots)
            db.record_bytes += pin_root_bytes(replacement.name, replacement.roots)
            let _ = list.set(mut db.pins, slot, take replacement)
            db.bases = tail_bases(db.pins)
        },
        ReplaceMain(take proposed, gone) => {
            let ProposedMain(roots: take roots, head: head, at: at, tables: tables, drop_pin: drop_pin, ..) = take proposed
            if let Some(pin_slot) = drop_pin {
                let removed = list.remove(mut db.pins, pin_slot)
                db.record_bytes -= pin_root_bytes(removed.name, removed.roots)
            }
            db.record_bytes -= keyed_root_record_bytes(db.heads[0u64].roots.keyed)
            db.record_bytes += keyed_root_record_bytes(roots.keyed)
            db.heads[0u64].roots = take roots
            db.heads[0u64].head = head
            db.heads[0u64].at = at
            db.next_table = tables
            if let Some(slot) = gone {
                remove_head(mut db, slot)
            }
        },
    }
    db.changes += 1
    db.settled = db.changes
}

fn state_roots(s: State) -> Result[List[Roots], Capacity] {
    let mut all: List[Roots] = list.with_capacity(list.len(s.tips) + list.len(s.pins))
    for t in s.tips {
        list.push(mut all, share_roots(t.roots))
    }
    for held in s.pins {
        list.push(mut all, share_roots(held.roots))
    }
    Ok(take all)
}

fn state_account(s: State) -> Result[u64, Capacity] {
    Ok(page_row_account(state_roots(s)?))
}

// A Memory cut counts row versions only. The page-image figure walks every
// page, so `accounts` computes it when asked (§13.8).
fn memory_cut_account(state: State) -> Result[u64, Error] {
    disk_allocation(scoped fn() -> Result[u64, Error] {
        Ok(page_row_account(capacity(state_roots(state))?))
    })
}

fn record_memory_cut(mut db: Db, live_bytes: u64) -> Ticket {
    db.checkpointed += 1
    db.resident = live_bytes
    db.settled = db.changes
    Ticket(store: db.store, open: 0, mark: Cut(db.checkpointed))
}

fn branch_slot(db: Db, id: u32) -> Result[u64, u64] {
    if id == 0 {
        return Ok(0)
    }
    list.binary_search_by(db.heads, scoped fn(h: Head) -> Order {
        order.compare(h.id, id)
    })
}

fn branch_index(db: Db, b: Branch) -> Result[u64, Error] {
    if !same(b.store, db.store) {
        return Error(Foreign)
    }
    Ok(branch_slot(db, b.id) ?=> |_| Missing("branch"))
}

fn head_snapshot(db: Db, i: u64) -> Snapshot {
    snapshot_from(db, i, db.heads[i].head, db.heads[i].roots, int.saturating_add(db.next_node, 1))
}

fn snapshot_from(db: Db, i: u64, head: u64, roots: Roots, watermark: u64) -> Snapshot {
    Snapshot(store: db.store, open: open_number(db), branch: db.heads[i].id, head: head, roots: share_roots(roots), watermark: watermark, bases: share_tail_bases(db.bases))
}

pub type CallId {
    store: StoreId,
    branch: u32,
    version: u64
}

pub type CallInfo {
    id: CallId,
    at: u64,
    seed: u64
}

pub type Mark = Journal(u64, u32, u64) | Cut(u64)

pub type Ticket {
    store: StoreId,
    open: u64,
    mark: Mark
}

pub type Read: shareable + send = Point(Bytes) | Span(Bytes, Bytes)

pub type StoreFailure = Raised(Causes) | Conflict(String) | Drift(String)

pub type Outcome[R, A] = Committed(Done[R]) | Aborted(Undone[A]) | Failed(StoreFailure) | Refused(StoreCapacity) | Stopped(OutOfTime)

pub type Undone[A] {
    value: A,
    ticket: Option[Ticket]
}

pub type Done[R] {
    value: R,
    ticket: Ticket,
    info: CallInfo,
    reads: List[Read]
}

pub type Bound[K] = Unbounded | Included(K) | Excluded(K)

pub type Limits: shareable + send {
    rows: u64,
    byte_limit: u64
}

pub opaque type Resume: send {
    store: StoreId,
    open: u64,
    branch: u32,
    version: u64,
    source: u32,
    high: Bytes,
    last: Bytes
}

pub type Page[K, V]: send {
    rows: List[(K, V)],
    byte_count: u64,
    next: Option[Resume]
}

pub type Resumed[K, V]: send = Paged(Page[K, V]) | Moved(u64)

type DataOp: shareable + send {
    key: Bytes,
    value: Option[StagedValue],
    trim: Option[JournalTrim]
}

// Inline pages copy the bytes into the page image. Overflow pages share the
// body with the staged operation.
type StagedValue: shareable + send = PageValue(Bytes) | BlobBody(Arc[Bytes])

fn stage_value(take raw: Bytes, inline: u64) -> StagedValue {
    if list.len(raw) <= inline {
        PageValue(take raw)
    } else {
        BlobBody(arc.new(take raw))
    }
}

fn staged_bytes(value: StagedValue) -> View[Bytes] in value {
    match value {
        PageValue(raw) => view raw,
        BlobBody(raw) => view raw,
    }
}

// Keep up to two operations in the draft. Larger drafts spill subsequent
// operations in insertion order.
type DataRows: shareable + send {
    count: u64,
    first: Inline[DataOp, 2],
    rest: List[DataOp]
}

fn new_data_rows() -> DataRows {
    let first: Inline[DataOp, 2] =[
        DataOp(key: list.new(), value: None, trim: None),
        DataOp(key: list.new(), value: None, trim: None),
    ]
    DataRows(count: 0, first: take first, rest: list.new())
}

fn data_row(rows: DataRows, slot: u64) -> View[DataOp] in rows {
    if slot < 2 {
        view rows.first[slot]
    } else {
        view rows.rest[slot - 2]
    }
}

fn push_data_row(mut rows: DataRows, take row: DataOp) {
    if rows.count < 2 {
        rows.first[rows.count] = take row
    } else {
        list.push(mut rows.rest, take row)
    }
    rows.count += 1
}

// A commit's rows by key. Up to SCANNED_OPS rows are found by scanning; the
// slot map is built only when a commit stages more.
type DataOps: shareable + send {
    rows: DataRows,
    slots: Map[Bytes, u64],
    cells: Map[u32, CellEdit],
    logs: Map[u32, LogState]
}

const SCANNED_OPS: u64 = 8

// A journaled draft starts open. The first inserted typed key supplies its row slot.
// The two sentinels are outside the range of slots in a bounded COMMIT frame.
const NO_FRAME_TAIL: u64 = 18446744073709551615

const OPEN_FRAME_TAIL: u64 = NO_FRAME_TAIL - 1

fn empty_ops() -> DataOps {
    DataOps(rows: new_data_rows(), slots: map.new(), cells: map.new(), logs: map.new())
}

// What enclosing transactions staged before a callback began, frozen so the
// callback shares it instead of copying it (MEM-30's copy idiom without the
// copy). Lookups check a transaction's own ops, then its layers newest first.
type Staged: shareable + send {
    ops: DataOps,
    stream_ops: DataOps,
    call: Option[CallSection]
}

fn op_slot(ops: DataOps, key: Bytes) -> Option[u64] {
    let n = ops.rows.count
    if n > SCANNED_OPS {
        return option.copied(map.get(ops.slots, key))
    }
    for slot in 0u64 .. n {
        if data_row(ops.rows, slot).key == key {
            return Some(slot)
        }
    }
    None
}

pub opaque scoped type Tx {
    store: StoreId,
    indexes: View[IndexRegistry],
    roots: Roots,
    bases: TailBases,
    ids: u64,
    private_from: u64,
    resident: u64,
    retain_old: bool,
    frame_tail: u64,
    reads: View[core.Log[Read]],
    issued: View[core.Cell[u64]],
    // The attempt record and the pin map it reads (§13.3, v2.81). The call's
    // driver owns both, outside the body's isolation and step bound.
    attempt: View[Option[core.Cell[TieredTouchSet]]],
    pins: View[Map[TieredCacheKey, Arc[TieredFrame]]],
    refusal: Option[Capacity],
    // The index error that makes this transaction abort-only.
    index_conflict: Option[IndexStop],
    // (table, index) of each remove whose absent target proved an index
    // wrong (§I.3). The transaction fails, and the index is demoted.
    drift: Option[List[(u32, u32)]],
    frame_bytes: Option[u64],
    // The recorded limits (§11.1 AP4a) every check in the body reads.
    limits: StoreLimits,
    wrote: bool,
    ops: DataOps,
    info: CallInfo,
    // The streams section's ops (§1.8). `extra_bytes` is that section with
    // its 5-byte head, when it has ops, plus the CALL section's bytes.
    stream_ops: DataOps,
    keyed: Option[KeyedDraft],
    extra_bytes: u64,
    call: Option[CallSection],
    // Layers beneath `ops`, oldest first. The last `own` are this Tx's own
    // staged writes, frozen when it entered a callback; the rest are shared
    // with the transactions it runs inside. `rows` and `streams` count the
    // distinct keys staged across `ops` and every layer: a key's slot is the
    // one it took when first staged, and a new key takes the next.
    below: List[Arc[Staged]],
    own: u64,
    rows: u64,
    cell_rows: u64,
    trim_rows: u64,
    streams: u64
}

pub opaque type Snapshot: shareable + send {
    store: StoreId,
    open: u64,
    branch: u32,
    head: u64,
    roots: Roots,
    watermark: u64,
    bases: TailBases
}

/// Mix a SplitMix64 seed after adding the generator stride with wrapping arithmetic.
pub fn splitmix64(x: u64) -> u64 {
    let mut z = int.wrapping_add(x, 0x9E3779B97F4A7C15u64)
    z = int.wrapping_mul(z ^ (z >> 30), 0xBF58476D1CE4E5B9u64)
    z = int.wrapping_mul(z ^ (z >> 27), 0x94D049BB133111EBu64)
    z ^ (z >> 31)
}

fn call_info(id: StoreId, b: u32, v: u64, wall: u64, previous: u64) -> CallInfo {
    CallInfo(id: CallId(store: id, branch: b, version: v), at: if wall < previous {
        previous
    } else {
        wall
    }, seed: splitmix64(splitmix64(splitmix64(splitmix64(id.hi) ^ id.lo) ^ int.widen(b)) ^ v))
}

fn same(a: StoreId, b: StoreId) -> bool {
    a.hi == b.hi && a.lo == b.lo
}

fn make_id(r: Random) -> StoreId {
    let mut raw: Bytes = list.with_capacity(16)
    host.random(r, mut raw)
    StoreId(hi: list.word_le(raw, 0), lo: list.word_le(raw, 8))
}

pub fn memory(c: Clock, r: Random, o: Options) -> Db {
    memory_at(c, make_id(r), o)
}

fn memory_at(c: Clock, id: StoreId, o: Options) -> Db {
    let mut db = empty_db(c, id, o)
    list.push(mut db.heads, main_head(empty_roots(), 0, 0))
    take db
}

fn empty_db(c: Clock, id: StoreId, o: Options) -> Db {
    Db(store: id, pager: None, pager_writer: None, park_notices: None, parked: empty_park_queue(), writer_pin_bytes: o.writer_pin_bytes, indexes: empty_index_registry(), fence: 0, disk: None, clock: c, heads: list.new(), branch_names: map.new(), pins: list.new(), record_bytes: branch_record_bytes("main"), limits: named_limits(o.limits), next_pin: 0, next_branch: 1, next_node: 0, next_table: 1, file_seq: 1, file_end: 72, frame_seq: 0, resident: 0, tiered: 0, page_resident: 0, changes: 0, settled: 0, ceiling: o.resident_limit, keyed_credit: no_keyed_credit(), checkpointed: 0, admits: map.new(), stream_retention_ms: o.stream_retention_ms, streams_per_caller_max: o.streams_per_caller_max, streams_max: o.streams_max, stream_sweep_after: None, drift: list.new(), attention_seq: 0, bases: no_tail_bases(), projectors: list.new())
}

pub fn fence_level(db: Db) -> u32 {
    db.fence
}

pub fn is_disk(db: Db) -> bool {
    match db.disk {
        Some(_) => true,
        None => false
    }
}

fn disk_state(db: Db) -> View[DiskState] in db {
    match db.disk {
        Some(state) => view state,
        None => fail("store: a disk store is required"),
    }
}

fn edit_disk[R](mut connection: Option[DiskState], edit: scoped fn(mut DiskState) -> R) -> R {
    match connection {
        Some(mut state) => edit(mut state),
        None => fail("store: a disk store is required"),
    }
}

fn write_disk[R, T](mut connection: Option[DiskState], take value: T, edit: scoped fn(mut DiskState, take T) -> R) -> R {
    match connection {
        Some(mut state) => edit(mut state, take value),
        None => fail("store: a disk store is required"),
    }
}

fn journal_poison(db: Db) -> Option[IoError] {
    match db.disk {
        Some(state) => state.poison,
        None => None
    }
}

pub fn identity(db: Db) -> StoreId {
    db.store
}

pub fn main_branch(db: Db) -> Branch {
    Branch(store: db.store, id: 0)
}

pub fn snapshot(db: Db) -> Snapshot {
    head_snapshot(db, 0)
}

pub fn snapshot_of(db: Db, b: Branch) -> Result[Snapshot, Error] {
    let i = branch_index(db, b)?
    Ok(head_snapshot(db, i))
}

fn same_name(a: String, b: String) -> bool {
    string.as_bytes(a) == string.as_bytes(b)
}

fn checked_name(name: String) -> Result[String, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    named(name)
}

pub fn branch(db: Db, name: String) -> Option[Branch] {
    if same_name(db.heads[0u64].name, name) {
        return Some(main_branch(db))
    }
    match map.get(db.branch_names, name) {
        Some(id) => Some(Branch(store: db.store, id: id)),
        None => None,
    }
}

// Section 1.9 and 1.12: fork and pin take only a Snapshot of this open, whose
// node ids this open issued.
fn this_open(db: Db, s: Snapshot) -> Result[(), Error] {
    if !same(s.store, db.store) || s.open != open_number(db) {
        return Error(Foreign)
    }
    Ok(())
}

// A cut-made operation reserves its holder storage before the cut and
// changes the installed holder records only after publication.
fn cut_install(mut db: Db, take delta: HolderDelta) -> Result[Ticket, Error] waits {
    if is_disk(db) {
        return disk_cut_state(mut db, take delta, seal_page_manifest_file)
    }
    prepare_holder_slot(mut db, delta)?
    let proposed = disk_allocation(scoped fn() -> Result[State, Error] {
        capacity(state_with_delta(db, delta))
    })?
    let admission = match delta {
        AddHead(_, _) => true,
        AddPin(_) => true,
        ReplacePin(_, _) => true,
        _ => false
    }
    let live_bytes = memory_cut_account(proposed)?
    if admission {
        over_ceiling(live_bytes, available_resident(db))?
    }
    let commit_ticket = record_memory_cut(mut db, live_bytes)
    install_holder_delta(mut db, take delta)
    Ok(commit_ticket)
}

fn branch_root_bytes(name: String, roots: Roots) -> u64 {
    branch_record_bytes(name) + keyed_root_record_bytes(roots.keyed)
}

fn pin_root_bytes(name: String, roots: Roots) -> u64 {
    pin_record_bytes(name) + keyed_root_record_bytes(roots.keyed)
}

fn check_manifest_addition(db: Db, extra: u64) -> Result[(), Error] {
    if extra > db.limits.meta - db.record_bytes {
        Error(Limit(Manifest))
    } else {
        Ok(())
    }
}

// AA1: a fast-forward of main to b, exactly when b forked from main at main's
// current version; b is then deleted. Any other case is Diverged(b).
pub fn adopt(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    // AA1: a branch that is not live (deleted, or adopted and so deleted) is
    // no fork of main at main's version, so it is Diverged like any other.
    let i = match branch_index(db, b) {
        Ok(found) => found,
        Error(Missing(_)) => return Error(Diverged(b.id)),
        Error(take e) => return Error(take e)
    }
    if i == 0 || db.heads[i].parent != 0 || db.heads[0].head != db.heads[i].forked_at {
        return Error(Diverged(b.id))
    }
    let merged = ProposedMain(roots: share_roots(db.heads[i].roots), head: db.heads[i].head, at: db.heads[i].at, tables: db.next_table, activation: None, drop_pin: None)
    let publication = capacity(prepare_publication(db, 0, merged.head, merged.roots, db.next_node))?
    let commit_ticket = cut_install(mut db, ReplaceMain(take merged, Some(i)))?
    publish(take publication)
    Ok(commit_ticket)
}

// Main is not deletable: it is Missing("branch") like an id that is not live.
pub fn delete_branch(mut db: Db, b: Branch) -> Result[Ticket, Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    if i == 0 {
        return Error(Missing("branch"))
    }
    cut_install(mut db, RemoveHead(i))
}

pub fn version(s: Snapshot) -> u64 {
    s.head
}

pub fn follow(mut db: Db, b: Branch) -> Result[Latest[Snapshot], Error] {
    healthy(db)?
    let i = branch_index(db, b)?
    if let Some(h) = db.heads[i].following {
        return Ok(latest.handle(h))
    }
    let root = arc.new(head_snapshot(db, i))
    let h = latest.new(take root)
    db.heads[i].following = Some(latest.handle(h))
    Ok(take h)
}

type Publication {
    followed: Option[(Latest[Snapshot], Arc[Snapshot])]
}

// The followed snapshot is allocated before the commit, so publishing it
// after the commit cannot fail.
fn prepare_publication(db: Db, i: u64, head: u64, roots: Roots, last_stamp: u64) -> Result[Publication, Capacity] {
    let followed = match db.heads[i].following {
        Some(handle) => Some((latest.handle(handle), arc.new(snapshot_from(db, i, head, roots, int.saturating_add(last_stamp, 1))))),
        None => None
    }
    Ok(Publication(followed: take followed))
}

fn publish(take publication: Publication) {
    let Publication(followed: take followed) = take publication
    if let Some((take handle, take root)) = take followed {
        latest.publish(handle, take root)
    }
}

pub type Receipt {
    ticket: Ticket,
    reply: Bytes
}

pub type Stop = Raised(u32) | OutOfSteps(u64) | OutOfBytes(Capacity) | Conflict(String)

fn append_be(mut raw: Bytes, value: u64, width: u64) -> Result[(), Capacity] {
    for i in 0u64 .. width {
        list.push(mut raw, int.truncate(value >> int.truncate(8 * (width - 1 - i))))
    }
    Ok(())
}

pub type Plan {
    n_e: u64,
    s_e: u64,
    reply_max: u64
}

pub type CallReserve {
    retained: u64,
    steps: u64
}

// Outside s_e, each metered draft pays for draft_call (1), isolate and its
// callback (2), issued-cell into_inner (1), log.finish (1), and finish_stage
// (1). Calls inside core's log.finish take no steps. A prepared reply has a
// stream edit, so finish_stage skips the data-row scan.
const CALL_FIXED_STEPS: u64 = 6

pub fn call_reserves(plan: Plan) -> Option[CallReserve] {
    // The isolate needs only the cause cell that a block charge includes.
    let cause = charge.block(bytes[()], 0)?
    let Some(retained) = int.checked_add(plan.n_e, cause) else {
        return None
    }
    let Some(steps) = int.checked_add(plan.s_e, CALL_FIXED_STEPS) else {
        return None
    }
    Some(CallReserve(retained: retained, steps: steps))
}

pub type ServeError = Before(Error, Option[Pending]) | After(Error)

pub type Reserve = Resident | Claim

pub opaque type Pending {
    completion: Completion,
    record: Option[CallRecord],
    attempted: CallInfo,
    stop: Option[StopKind],
}

pub type Served = Committed(Receipt) | Kept(Receipt) | Failed(Pending, Stop) | NoRoom(Pending, StoreCapacity) | Parked(Parked)

type ServeReply = KeptReply(Bytes) | StoreFailure(Error) | BodyStop(Stop)

pub fn next_call_info(db: Db) -> CallInfo {
    call_info(db.store, 0, db.heads[0].head + 1, host.wall_ms(db.clock), db.heads[0].at)
}

pub fn stream_retention_ms(db: Db) -> u64 {
    db.stream_retention_ms
}

pub fn untried(take complete: Completion, take rec: Option[CallRecord], attempted: CallInfo) -> Pending {
    Pending(completion: take complete, record: take rec, attempted: attempted, stop: None)
}

fn registered_completion(db: Db, complete: Completion) -> Result[(), ServeError] {
    if !same(db.store, complete.admitted.store) || open_number(db) != complete.admitted.open {
        return Error(Before(Foreign, None))
    }
    if let Some(keyed) = complete.keyed {
        return serve_before(check_keyed_completion(db, complete, keyed))
    }
    if let Some(raw) = get_page_row(db.heads[0].roots.streams, complete.stream) {
        let state = serve_before(stream_state(raw))?
        if state.p == complete.p && state.state == 1 && state.digest == complete.request {
            return Ok(())
        }
    }
    Error(Before(Missing("reply"), None))
}

fn serve_before[R](take result: Result[R, Error]) -> Result[R, ServeError] {
    match take result {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Before(take problem, None)),
    }
}

fn serve_after(take result: Result[(), Error]) -> Result[(), ServeError] {
    match take result {
        Ok(()) => Ok(()),
        Error(take problem) => Error(After(take problem)),
    }
}

fn cause_number(causes: Causes) -> u32 {
    for cause in causes {
        return match cause.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity(_) => 7u32,
            OutOfTime => 8u32
        }
    }
    0u32
}

fn save_reply(mut tx: Tx, complete: Completion, output: Bytes, rec: Option[CallRecord], settlement: Option[Settlement], credit: Option[KeyedCredit]) -> Result[(), Error] {
    if let Some(keyed) = complete.keyed {
        let Some(remaining) = credit else {
            fail("store: keyed completion must apply its terminal credit")
        }
        let call = KeyedCallSection(record: clone(keyed.record), settlement: settlement)
        return stage_claim_reply(mut tx, complete.stream, complete.request, keyed.policy.retention_ms, output, remaining, Some(take call))
    }
    let size = if let Some(_) = tx.frame_bytes {
        match rec {
            Some(value) => call_section_bytes(value, settlement),
            None => 0u64,
        }
    } else {
        0u64
    }
    let (take key, take value) = reply_row(tx, complete.stream, complete.p, output)?
    stream_write(mut tx, take key, take value, size)
}

fn stage_reply(mut tx: Tx, complete: Completion, rec: Option[CallRecord], reply_max: u64, credit: Option[KeyedCredit], body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[Bytes, ServeReply] {
    let returned = body(mut tx)
    if let Some(problem) = tx.refusal {
        tx.refusal = None
        return Error(BodyStop(OutOfBytes(problem)))
    }
    let (success, take output) = match take returned {
        Ok(take payload) => {
            match tx.index_conflict {
                Some(Duplicate(name)) => return Error(BodyStop(Conflict(clone(name)))),
                Some(Drifted(name)) => return Error(StoreFailure(Drift(clone(name)))),
                None => (),
            }
            (true, take payload)
        },
        Error(take payload) => (false, take payload),
    }
    if list.len(output) > reply_max {
        return Error(BodyStop(OutOfBytes(Capacity(requested: list.len(output), available: reply_max))))
    }
    match save_reply(mut tx, complete, output, rec, None, credit) {
        Ok(()) => (),
        Error(Full(Allocation(problem))) => return Error(BodyStop(OutOfBytes(problem))),
        Error(take problem) => return Error(StoreFailure(take problem)),
    }
    if success {
        Ok(take output)
    } else {
        Error(KeptReply(take output))
    }
}

pub fn serve[E: inert](mut db: Db, take complete: Completion, plan: Plan, take rec: Option[CallRecord], env: E, body: fn(mut Tx, E) -> Result[Bytes, Bytes]) -> Result[Served, ServeError] waits {
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, complete)?
    serve_before(check_completion_record(complete, rec))?
    let wall = host.wall_ms(db.clock)
    let Some(grant) = call_reserves(plan) else {
        return Error(Before(Limit(Transaction), None))
    }
    let first = CallRun(id: None, attempts: 0, pins: empty_tiered_pins(call_pin_root(db, 0), db.writer_pin_bytes), pending: None, crowded: false)
    drive_served(mut db, take complete, plan, grant, take rec, wall, take first, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        body(mut tx, env)
    })
}

fn finish_served(mut db: Db, take pending_run: Pending, take staged: Ran[Bytes, ServeReply], retry: bool) -> Result[Served, ServeError] waits {
    let ready = serve_before(settle_draft(mut db, 0, take staged))?
    match take ready {
        OverLimit(_, Journal(problem)) => {
            if let Some(_) = pending_run.completion.keyed {
                return Ok(NoRoom(take pending_run, Journal(problem)))
            }
            let pending = if retry {
                Some(take pending_run)
            } else {
                None
            }
            Error(Before(Full(Journal(problem)), take pending))
        },
        OverLimit(_, problem) => Ok(NoRoom(take pending_run, problem)),
        Ready(take accepted, take publication) => {
            if let Some(problem) = reserve_tiered_freed(mut db, accepted) {
                return Ok(NoRoom(take pending_run, problem))
            }
            let committed = commit_prepared(mut db, 0, take accepted, take publication)
            serve_after(handoff(mut db))?
            serve_after(maybe_checkpoint(mut db))?
            match take committed {
                Committed(Done(value: take output, ticket: committed_at, ..)) => Ok(Committed(Receipt(ticket: committed_at, reply: take output))),
                Aborted(Undone(value: KeptReply(take output), ticket: Some(committed_at))) => Ok(Kept(Receipt(ticket: committed_at, reply: take output))),
                _ => fail("store: staged reply was lost"),
            }
        },
    }
}

pub fn conclude(mut db: Db, take pending_run: Pending, take output: Bytes, reserve: Reserve) -> Result[Served, ServeError] waits {
    let has_credit = match pending_run.completion.keyed {
        Some(_) => true,
        None => false
    }
    match reserve {
        Claim if !has_credit => return Error(Before(Missing("claim"), None)),
        Resident if has_credit => return Error(Before(Missing("terminal credit"), None)),
        _ => (),
    }
    serve_before(journal_poll(mut db))?
    serve_before(healthy(db))?
    registered_completion(db, pending_run.completion)?
    serve_before(check_completion_record(pending_run.completion, pending_run.record))?
    let now = host.wall_ms(db.clock)
    let attempted = pending_run.attempted
    let way = match pending_run.stop {
        Some(_) => 1u8,
        None => 2u8
    }
    let settlement: Option[Settlement] = if attempted.id.version == 0 {
        None
    } else {
        Some(Settlement(way: way, base: attempted.id.version - 1, at: attempted.at, seed: attempted.seed, stop: pending_run.stop))
    }
    let keep: Option[fn(ServeReply) -> bool] = None
    // Saving a reply reads no Tiered row, so it carries no attempt record.
    let attempt: Option[core.Cell[TieredTouchSet]] = None
    let no_pins: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    let credit = keyed_completion_credit(db, pending_run.completion)
    let draft = stage_call(mut db, 0, now, None, keep, pending_run.record, settlement, attempt, no_pins, scoped fn(mut tx: Tx) -> Result[Bytes, ServeReply] {
        let held: Bytes = clone(output)
        let moved = take held
        match save_reply(mut tx, pending_run.completion, output, pending_run.record, settlement, credit) {
            Ok(()) => Ok(take moved),
            Error(Full(Allocation(problem))) => Error(BodyStop(OutOfBytes(problem))),
            Error(take problem) => Error(StoreFailure(take problem)),
        }
    })
    match take draft {
        Ran(take staged) => finish_served(mut db, take pending_run, take staged, true),
        Over(Refused(problem)) => Ok(NoRoom(take pending_run, problem)),
        Over(Aborted(Undone(value: BodyStop(OutOfBytes(problem)), ..))) => Ok(NoRoom(take pending_run, Allocation(problem))),
        Over(Aborted(Undone(value: StoreFailure(take problem), ..))) => Error(Before(take problem, None)),
        _ => fail("store: invalid conclude draft"),
    }
}

pub fn info(mut tx: Tx) -> CallInfo {
    tx.info
}

pub fn run[E: inert, R, A](mut db: Db, steps: Option[u64], env: E, body: fn(mut Tx, E) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on(mut db, b, steps, env, body)
}

pub fn run_on[E: inert, R, A](mut db: Db, b: Branch, steps: Option[u64], env: E, body: fn(mut Tx, E) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    run_on_with_reply(mut db, b, steps, None, scoped fn(mut tx: Tx) -> Result[R, A] {
        body(mut tx, env)
    })
}

// A runner abort may keep its reply. A runner refusal rolls back the whole Tx.
pub fn run_with_reply[E: inert, R, A](mut db: Db, steps: Option[u64], keep_reply: fn(A) -> bool, env: E, body: fn(mut Tx, E) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let b = main_branch(db)
    run_on_with_reply(mut db, b, steps, Some(keep_reply), scoped fn(mut tx: Tx) -> Result[R, A] {
        body(mut tx, env)
    })
}

fn run_on_with_reply[R, A](mut db: Db, b: Branch, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    journal_poll(mut db)?
    healthy(db)?
    let i = branch_index(db, b)?
    // A retry-capable call is bounded, so a body that loops on a caught
    // Missed ends at its bound and the driver reruns it (§13.3).
    if let None = steps {
        if tiered_collections(db.heads[i].roots.collections.root) {
            return Error(Missing("steps"))
        }
    }
    store_body_on(mut db, i, steps, keep_reply, body)
}

// The store's own bodies, which read no Tiered row, run here unbounded.
fn store_body_on[R, A](mut db: Db, i: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let wall = host.wall_ms(db.clock)
    store_body_at(mut db, i, wall, steps, keep_reply, body)
}

fn store_body_at[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let outcome = append_transaction_at(mut db, i, wall, steps, keep_reply, body)
    if let Ok(Refused(Journal(_))) = outcome {
        return take outcome
    }
    maybe_checkpoint(mut db)?
    take outcome
}

fn append_transaction_at[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Result[Outcome[R, A], Error] waits {
    let outcome: Result[Outcome[R, A], Error] = match staged_until_decided(mut db, i, wall, steps, keep_reply, body)? {
        Over(take o) => Ok(take o),
        Ran(take ran) => settle_admit(mut db, i, take ran),
        DraftError(take problem) => Error(take problem),
        Latched => fail("store: a decided stage is latched"),
        DriftStop(take name, take seen) => {
            trip_drift(mut db, i, take seen)?
            Ok(Failed(Drift(take name)))
        },
    }
    handoff(mut db)?
    take outcome
}

fn handoff(mut db: Db) -> Result[(), Error] waits {
    match db.disk {
        Some(mut state) => if let Some(take raw) = replace(mut state.pending, None) {
            let sent = list.len(raw)
            if let Error(_) = channel.send(state.journal, Frame(take raw, db.frame_seq)) {
                state.poison = Some(Closed)
                return Error(Poisoned(Closed))
            }
            state.inflight += sent
            state.uncovered += sent
            state.since_cut += sent
        },
        None => (),
    }
    Ok(())
}

fn maybe_checkpoint(mut db: Db) -> Result[(), Error] waits {
    if is_disk(db) && (disk_state(db).since_cut > disk_state(db).options.checkpoint_bytes || object_cut_due(db)) {
        match cut_install(mut db, NoHolderChange) {
            Error(Full(_)) => (),
            Error(take problem) => return Error(take problem),
            Ok(_) => (),
        }
    }
    Ok(())
}

// A body whose commit the admission bound decides (section 1.11): one that
// returned Ok, or one that returned Error after a reply, whose commit keeps
// only its streams writes and its CALL section (F2).
type Ran[R, A] {
    value: Result[R, A],
    roots: Option[Roots],
    edits: DataRows,
    replies: DataRows,
    keyed: Option[KeyedDraft],
    first_stamp: u64,
    prepared_roots: bool,
    tiered: Option[u64],
    freed: Option[TieredFreed],
    live: u64,
    exact: bool,
    admits_rows: bool,
    frame: Option[Bytes],
    info: CallInfo,
    reads: List[Read]
}

// Latched: the attempt's latch was set, so its result, writes, reads and
// issued ids are discarded and the driver serves or refuses the stop.
type Stage[R, A] = Over(Outcome[R, A]) | Ran(Ran[R, A]) | DraftError(Error) | Latched | DriftStop(String, List[(u32, u32)])

// Drifted: a remove proved an index wrong; the call fails with `Drift`
// and its driver counts and demotes the indexes (§I.3).
type Finished[R, A] = RolledBack(Outcome[R, A]) | Prepared(Prepared[R, A]) | DraftFault(Error) | Drifted(String, List[(u32, u32)])

// A successful body or an application error with a reply to commit.
type Prepared[R, A] {
    outcome: Result[R, A],
    roots: Roots,
    tiered: Option[u64],
    plan: Option[TieredWritePlan],
    live: u64,
    frame: Option[Bytes],
    ops: DataRows,
    frame_tail: u64,
    stream_ops: DataRows,
    keyed: Option[KeyedDraft],
    first_stamp: u64,
    prepared_roots: bool,
    call: Option[CallSection]
}

// Runs the body on branch `i` inside isolate. Everything but a body that
// returned Ok, or Error after a reply, is final here.
fn stage[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], attempt: Option[core.Cell[TieredTouchSet]], pins: Map[TieredCacheKey, Arc[TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let no_record: Option[CallRecord] = None
    stage_call(mut db, i, wall, steps, keep_reply, no_record, None, attempt, pins, body)
}

// The caller keeps owning the record so a refused publication can return it.
fn stage_call[R, A](mut db: Db, i: u64, wall: u64, steps: Option[u64], keep_reply: Option[fn(A) -> bool], rec: Option[CallRecord], settlement: Option[Settlement], attempt: Option[core.Cell[TieredTouchSet]], pins: Map[TieredCacheKey, Arc[TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Stage[R, A] {
    let reads: core.Log[Read] = log.new()
    let issued: core.Cell[u64] = cell.new(0)
    let ci = call_info(db.store, db.heads[i].id, db.heads[i].head + 1, wall, db.heads[i].at)
    let caught = isolate(fn() -> Result[Finished[R, A], OutOfTime] {
        let perform = scoped fn() -> Finished[R, A] {
            let staged = draft_body(db, db.indexes, db.heads[i].roots, ci, keep_reply, reads, issued, attempt, pins, body)
            let prepared = if let Some(_) = steps {
                match prepare_metered_pages(issued, attempt, pins, take staged) {
                    Ok(take ready) => take ready,
                    Error(Full(problem)) => RolledBack(Refused(problem)),
                    Error(take problem) => DraftFault(take problem),
                }
            } else {
                take staged
            }
            match frame_draft(db, db.heads[i].roots.collections, ci, rec, settlement, take prepared) {
                Ok(take framed) => take framed,
                Error(problem) => RolledBack(Refused(Allocation(problem))),
            }
        }
        match steps {
            Some(s) => bound steps s {
                perform()
            },
            None => Ok(perform()),
        }
    })
    // The latch is read before anything else: a latched attempt's ids and
    // reads are discarded with it, so the watermark never depends on reruns.
    if call_attempt_latched(attempt) {
        let _ = cell.into_inner(take issued)
        let _ = log.finish(take reads)
        return Latched
    }
    let high = cell.into_inner(take issued)
    if high > db.next_node {
        db.next_node = high
    }
    let seen = log.finish(take reads)
    match take caught {
        Error(c) => Over(Refused(Allocation(c))),
        Ok(Error(take cs)) => match raised_capacity(cs) {
            Some(c) => Over(Refused(Allocation(c))),
            None => Over(Failed(Raised(take cs))),
        },
        Ok(Ok(Error(e))) => Over(Stopped(e)),
        Ok(Ok(Ok(take f))) => finish_stage(ci, take f, take seen),
    }
}

fn draft_body[R, A](db: Db, registry: IndexRegistry, base: Roots, ci: CallInfo, keep_reply: Option[fn(A) -> bool], reads: core.Log[Read], issued: core.Cell[u64], attempt: Option[core.Cell[TieredTouchSet]], pins: Map[TieredCacheKey, Arc[TieredFrame]], body: scoped[view] fn(mut Tx) -> Result[R, A]) -> Finished[R, A] {
    let (frame_bytes, initial_tail) = match db.disk {
        Some(_) => (Some(42u64), OPEN_FRAME_TAIL),
        None => (None, NO_FRAME_TAIL),
    }
    let mut tx = Tx(store: db.store, indexes: view registry, roots: share_roots(base), bases: share_tail_bases(db.bases), ids: db.next_node, private_from: int.saturating_add(db.next_node, 1), resident: db.resident, retain_old: retaining(db), frame_tail: initial_tail, reads: view reads, issued: view issued, attempt: view attempt, pins: view pins, refusal: None, index_conflict: None, drift: None, frame_bytes: frame_bytes, limits: db.limits, wrote: false, ops: empty_ops(), info: ci, stream_ops: empty_ops(), keyed: None, extra_bytes: 0, call: None, below: list.new(), own: 0, rows: 0, cell_rows: 0, trim_rows: 0, streams: 0)
    let outcome = body(mut tx)
    if tx.own != 0 {
        fold_own(mut tx)
    }
    if let Some(c) = tx.refusal {
        return RolledBack(Refused(Allocation(c)))
    }
    // A proven-wrong index fails the call however the body ended (§I.3).
    if let Some((take name, take evidence)) = take_drift(mut tx) {
        return Drifted(take name, take evidence)
    }
    let value: Result[R, A] = match take outcome {
        Ok(take v) => {
            if let Some(Duplicate(take name)) = replace(mut tx.index_conflict, None) {
                return RolledBack(Failed(Conflict(take name)))
            }
            Ok(take v)
        },
        Error(take a) => {
            let keep = match keep_reply {
                Some(decide) => decide(a),
                None => true
            }
            let keyed_reply = match tx.keyed {
                Some(_) => true,
                None => false
            }
            if !keep || (tx.stream_ops.rows.count == 0 && !keyed_reply) {
                return RolledBack(Aborted(Undone(value: take a, ticket: None)))
            }
            // F2 keeps the streams and CALL writes with the old data roots.
            let live_bytes = match stream_live(db, base.streams, tx.stream_ops) {
                Ok(n) => n,
                Error(c) => return RolledBack(Refused(Allocation(c)))
            }
            tx.resident = live_bytes
            tx.roots.collections = share_page_tree(base.collections)
            tx.roots.catalog = share_page_tree(base.catalog)
            tx.ops = empty_ops()
            tx.rows = 0
            tx.frame_tail = NO_FRAME_TAIL
            Error(take a)
        }
    }
    let mut first_stamp = tx.private_from
    let mut rows = match seal_log_trims(mut tx, mut first_stamp) {
        Ok(take operations) => take operations,
        Error(Full(problem)) => return RolledBack(Refused(problem)),
        Error(_) => fail("store: invalid staged Log trim"),
    }
    if let Some(keyed) = tx.keyed {
        tx.resident = keyed_draft_live(base, keyed.edits, tx.retain_old, tx.resident)
    }
    let Tx(roots: take roots, resident: live_bytes, frame_tail: frame_tail, ops: take ops, stream_ops: take stream_ops, keyed: take keyed, call: take call, ..) = take tx
    let DataOps(cells: take cells, ..) = take ops
    seal_cell_edits(mut rows, cells)
    let DataOps(rows: take stream_rows, ..) = take stream_ops
    let tiered = match attempt {
        Some(_) => Some(db.tiered),
        None => None,
    }
    Prepared(Prepared(outcome: take value, roots: take roots, tiered: tiered, plan: None, live: live_bytes, frame: None, ops: take rows, frame_tail: frame_tail, stream_ops: take stream_rows, keyed: take keyed, first_stamp: first_stamp, prepared_roots: false, call: take call))
}

fn finish_stage[R, A](ci: CallInfo, take finished: Finished[R, A], take seen: List[Read]) -> Stage[R, A] {
    let prepared = match take finished {
        RolledBack(take o) => return Over(take o),
        DraftFault(take problem) => return DraftError(take problem),
        Drifted(take name, take evidence) => return DriftStop(take name, take evidence),
        Prepared(take tx) => take tx,
    }
    let Prepared(outcome: take outcome, roots: take roots, tiered: tiered, plan: take plan, live: live_bytes, frame: take frame, ops: take operations, frame_tail: _, stream_ops: take stream_edits, keyed: take keyed, first_stamp: first_stamp, prepared_roots: prepared_roots, ..) = take prepared
    // A draft without a Tiered plan makes no call here: the draft's step
    // overhead is fixed (§13.3 call reserves).
    let freed = match take plan {
        Some(take written) => {
            let TieredWritePlan(freed: take plan_freed, ..) = take written
            Some(take plan_freed)
        },
        None => None,
    }
    let keyed_writes = match keyed {
        Some(_) => true,
        None => false
    }
    let mut admits_rows = stream_edits.count != 0 || keyed_writes
    if !admits_rows {
        for slot in 0u64 .. operations.count {
            let edit = data_row(operations, slot)
            if let Some(_) = edit.value {
                if tiered != None && tiered_data_key(roots.collections, edit.key) {
                    continue
                }
                admits_rows = true;
                break
            }
        }
    }
    Ran(Ran(value: take outcome, roots: Some(take roots), edits: take operations, replies: take stream_edits, keyed: take keyed, first_stamp: first_stamp, prepared_roots: prepared_roots, tiered: tiered, freed: take freed, live: live_bytes, exact: false, admits_rows: admits_rows, frame: take frame, info: ci, reads: take seen))
}

fn wait_for_frame_room(mut db: Db, frame: Option[Bytes]) -> Result[(), Error] waits {
    if let Some(raw) = frame {
        let size = list.len(raw)
        while disk_state(db).inflight > db.limits.frame - size {
            let acknowledged = journal_receive(db)
            journal_ack(mut db, take acknowledged)?
        }
    }
    Ok(())
}

pub fn durable(mut db: Db, t: Ticket) -> Result[(), Error] waits {
    let _ = durable_groups(mut db, t)?
    Ok(())
}

/// The journal's sync notices, taken once: one coalesced () after each group sync or
/// failure, and the channel closes when the journal worker ends. A store without a
/// journal returns None; its tickets are durable when committed.
pub fn sync_notices(mut db: Db) -> Option[Receiver[()]] {
    match db.disk {
        Some(mut state) => replace(mut state.synced, None),
        None => None
    }
}

/// `durable` without waiting: whether t's commit is synced now. A journal that ended
/// without an ack is terminal, as in journal_receive.
pub fn durable_now(mut db: Db, t: Ticket) -> Result[bool, Error] {
    if !same(db.store, t.store) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(true)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(true)
        }
    }
    let drained = journal_poll_groups(mut db)
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(true)
    }
    let _ = drained?
    if covered(db, t.mark) {
        return Ok(true)
    }
    let pending = match db.disk {
        Some(state) => channel.try_receive(state.acks),
        None => return Ok(true)
    }
    match take pending {
        Ok(take ack) => journal_ack(mut db, take ack)?,
        Error(Empty) => {},
        Error(Closed) => journal_ack(mut db, Broken(Closed))?,
    }
    Ok(covered(db, t.mark))
}

// The worker sends one Journaled ack after each successful group sync.
fn durable_groups(mut db: Db, t: Ticket) -> Result[u64, Error] waits {
    if !same(db.store, t.store) || t.open != open_number(db) {
        return Error(Foreign)
    }
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(0)
    }
    if let Some(e) = journal_poison(db) {
        return Error(Poisoned(e))
    }
    if let Cut(generation) = t.mark {
        if is_disk(db) {
            disk_wait_cut(db, generation)?
            return Ok(0)
        }
    }
    let drained = journal_poll_groups(mut db)
    if object_writer_open(db) && covered(db, t.mark) {
        return Ok(match drained {
            Ok(groups) => groups,
            Error(_) => 0u64
        })
    }
    let mut groups = drained?
    if is_disk(db) {
        while !covered(db, t.mark) {
            let ack = journal_receive(db)
            journal_ack(mut db, take ack)?
            groups += 1
        }
    }
    Ok(groups)
}

fn covered(db: Db, mark: Mark) -> bool {
    match mark {
        Journal(n, _, _) => match db.disk {
            Some(state) => state.journaled >= n,
            None => n == 0
        },
        Cut(n) => db.checkpointed >= n
    }
}

fn capacity[T](take r: Result[T, Capacity]) -> Result[T, Error] {
    match take r {
        Ok(take value) => Ok(take value),
        Error(c) => Error(Full(Allocation(c)))
    }
}

fn copied(raw: Bytes) -> Result[Bytes, Error] {
    Ok(clone(raw))
}

fn prefix(id: u32) -> Result[Bytes, Error] {
    prefixed(id, 0, false)
}

// The 4-byte big-endian id, in a buffer with room for `rest` more bytes.
fn prefixed(id: u32, rest: u64, tail: bool) -> Result[Bytes, Error] {
    let mut p: Bytes = if tail {
        bytebuf.with_tail(4 + rest)
    } else {
        list.with_capacity(4 + rest)
    }
    list.put_word_be(mut p, id)
    Ok(take p)
}

// One allocation: the key is appended into the prefix's spare capacity.
fn logical_key(id: u32, key: Bytes) -> Result[Bytes, Error] {
    let mut p = prefixed(id, list.len(key), false)?
    list.append(mut p, key)
    Ok(take p)
}

pub fn body_capacity(mut tx: Tx, problem: Capacity) {
    tx.refusal = Some(problem)
}

// Reserve the stamp interval before a page edit can allocate. The cell keeps
// the high watermark even if the body exits under a capacity failure; after an
// overrun's rollback a later reservation may end lower and puts the higher back.
fn reserve_ids(mut tx: Tx, height: u64) -> Result[u64, Error] {
    let Some(end) = int.checked_add(tx.ids, 6 * height + 2) else {
        return Error(Limit(Ids))
    }
    let high = cell.replace(tx.issued, end)
    if high > end {
        let _ = cell.replace(tx.issued, high)
    }
    let first = tx.ids + 1
    tx.ids = end
    Ok(first)
}

fn note_read(tx: Tx, take read: Read) -> Result[(), Error] {
    log.append(tx.reads, take read)
    Ok(())
}

// A Tiered row is resolved before its Point is logged, so the first touch's
// count precedes the logical append on every path (§13.3).
fn fetch_logical(tx: Tx, take key: Bytes) -> Result[Option[View[Bytes]], Error] in tx {
    let found = match staged_row(tx, key) {
        Some(staged) => staged,
        None => tx_page_row(tx, key)?,
    }
    log.append(tx.reads, Point(take key))
    Ok(found)
}

// Stream value (section 1.8): position u64 LE, state u8 (1 Admitted,
// 2 Replied), then the reply when Replied.
// A request's identity at a stream position (STORE-SPEC v2.24 §1.8, AH1).
// Made only by request_digest or read from a streams value.
pub opaque type RequestDigest: key + shareable + send {
    b: Inline[u8, 32]
}

/// SHA-256 of u8 17 ‖ "hirsel.request.v1" ‖ u32 LE len(key) ‖ key ‖ u32 LE
/// len(args) ‖ args (§1.8): versioned, domain-separated, length-delimited.
/// Alloc: none. Cost: O(key + args).
pub fn request_digest(key: Bytes, args: Bytes) -> RequestDigest {
    let mut h = std.sha256.start()
    let tag = string.as_bytes("hirsel.request.v1")
    std.sha256.add_byte(mut h, int.truncate(list.len(tag)))
    std.sha256.add(mut h, tag, 0, list.len(tag))
    digest_part(mut h, key)
    digest_part(mut h, args)
    RequestDigest(b: std.sha256.finish(h))
}

fn digest_part(mut h: std.sha256.Sha256, part: Bytes) {
    let n = list.len(part)
    for i in 0u64 .. 4 {
        std.sha256.add_byte(mut h, int.truncate(n >> int.truncate(i * 8)))
    }
    std.sha256.add(mut h, part, 0, n)
}

// STORE AL2/AN2. An admit is 41 B, and a reply is followed by the exact
// reply bytes.
pub type Stored {
    reply: Bytes
}

fn key_word(n: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(8)
    for i in 0u64 .. 8 {
        list.push(mut b, int.truncate(n >> int.truncate((7 - i) * 8)))
    }
    b
}

fn test_db(c: Clock, cap: u64) -> Db {
    let mut opts = result.unwrap(sized(Memory, 1074790400u64))
    opts.resident_limit = cap
    memory_at(c, StoreId(hi: 1, lo: 2), opts)
}

// Stages one row in `ops` and returns its slot: `next_slot`, the next one, for a
// key new to the transaction, else OPEN_FRAME_TAIL. A key a layer beneath
// staged keeps its slot there, so `ops` holds the replacement uncounted.
fn save_data_op(mut ops: DataOps, below: List[Arc[Staged]], streams: bool, mut next_slot: u64, take key: Bytes, take value: Option[StagedValue]) -> u64 {
    if let Some(slot) = op_slot(ops, key) {
        if slot < 2 {
            ops.rows.first[slot].value = take value
        } else {
            ops.rows.rest[slot - 2].value = take value
        }
        return OPEN_FRAME_TAIL
    }
    let mut beneath = false
    for layer in below {
        let found = if streams {
            op_slot(layer.stream_ops, key)
        } else {
            op_slot(layer.ops, key)
        }
        if let Some(_) = found {
            beneath = true
        }
    }
    let at = next_slot
    if !beneath {
        next_slot += 1
    }
    let slot_order = ops.rows.count
    if slot_order == SCANNED_OPS {
        for earlier in 0u64 .. slot_order {
            map.insert(mut ops.slots, clone(data_row(ops.rows, earlier).key), earlier)
        }
    }
    if slot_order >= SCANNED_OPS {
        map.insert(mut ops.slots, clone(key), slot_order)
    }
    push_data_row(mut ops.rows, DataOp(key: take key, value: take value, trim: None))
    if beneath {
        OPEN_FRAME_TAIL
    } else {
        at
    }
}

fn transaction_stream(tx: Tx, key: Bytes) -> Option[View[Bytes]] in tx {
    if let Some(slot) = op_slot(tx.stream_ops, key) {
        return match data_row(tx.stream_ops.rows, slot).value {
            Some(raw) => Some(staged_bytes(raw)),
            None => None,
        }
    }
    if let Some(at) = newest_layer(tx.below, true, key) {
        let layer = view tx.below[at]
        if let Some(slot) = op_slot(layer.stream_ops, key) {
            return match data_row(layer.stream_ops.rows, slot).value {
                Some(raw) => Some(staged_bytes(raw)),
                None => None,
            }
        }
    }
    get_page_row(tx.roots.streams, key)
}

// The newest layer that staged `key`, a deletion included.
fn newest_layer(below: List[Arc[Staged]], streams: bool, key: Bytes) -> Option[u64] {
    let mut newest: Option[u64] = None
    let mut at = 0u64
    for layer in below {
        let found = if streams {
            op_slot(layer.stream_ops, key)
        } else {
            op_slot(layer.ops, key)
        }
        if let Some(_) = found {
            newest = Some(at)
        }
        at += 1
    }
    newest
}

// The frame bytes of the op staged for `key`, in `ops` or the newest layer.
fn old_data_op_size(ops: DataOps, below: List[Arc[Staged]], streams: bool, key: Bytes) -> u64 {
    if let Some(slot) = op_slot(ops, key) {
        return data_op_size(data_row(ops.rows, slot), streams)
    }
    let mut size = 0u64
    for layer in below {
        let staged = if streams {
            view layer.stream_ops
        } else {
            view layer.ops
        }
        if let Some(slot) = op_slot(staged, key) {
            size = data_op_size(data_row(staged.rows, slot), streams)
        }
    }
    size
}

fn data_op_size(operation: DataOp, stream: bool) -> u64 {
    if let Some(_) = operation.trim {
        return 21
    }
    let size = (if stream {
        5u64
    } else {
        9u64
    }) + list.len(operation.key)
    match operation.value {
        None => size,
        Some(raw) => size + 4 + list.len(staged_bytes(raw)),
    }
}

fn le(mut out: Bytes, x: u64, width: u64) -> Result[(), Capacity] {
    match width {
        1 => {
            list.reserve(mut out, 1)
            Ok(list.push(mut out, int.truncate(x)))
        },
        2 => {
            let word: u16 = int.truncate(x)
            Ok(list.put_word_le(mut out, word))
        },
        4 => {
            let word: u32 = int.truncate(x)
            Ok(list.put_word_le(mut out, word))
        },
        8 => Ok(list.put_word_le(mut out, x)),
        _ => fail("store: invalid frame word width"),
    }
}

fn blob(mut out: Bytes, b: Bytes) -> Result[(), Capacity] {
    le(mut out, list.len(b), 4)?
    Ok(list.append(mut out, b))
}

type DataOrder = InOrder | ReversePair | SortedSlots(List[u64])

fn data_order(ops: DataRows) -> Result[DataOrder, Capacity] {
    let n = ops.count
    if n < 2 {
        return Ok(InOrder)
    }
    if n == 2 {
        return Ok(if list.compare_bytes(data_row(ops, 0).key, data_row(ops, 1).key) == Greater {
            ReversePair
        } else {
            InOrder
        })
    }
    let mut slots: List[u64] = list.new()
    list.try_reserve(mut slots, n)?
    for slot_order in 0u64 .. n {
        list.push(mut slots, slot_order)
    }
    list.sort(mut slots, scoped fn(a: u64, b: u64) -> Order {
        list.compare_bytes(data_row(ops, a).key, data_row(ops, b).key)
    })
    Ok(SortedSlots(take slots))
}

fn ordered_row(ops: DataRows, order: DataOrder, slot_order: u64) -> View[DataOp] in ops {
    let slot = match order {
        InOrder => slot_order,
        ReversePair => 1 - slot_order,
        SortedSlots(slots) => slots[slot_order],
    }
    data_row(ops, slot)
}

fn stored_prior(raw: Option[View[Bytes]]) -> u32 {
    match raw {
        Some(value) => int.truncate(1 + list.len(value)),
        None => 0,
    }
}

fn encode_data_ops(mut payload: Bytes, base: Option[View[PageTree]], tiered: Option[View[List[Option[TieredDataDelta]]]], ops: DataRows, order: DataOrder) -> Result[(), Capacity] {
    le(mut payload, 0, 1)?
    le(mut payload, ops.count, 4)?
    for slot_order in 0u64 .. ops.count {
        let op = ordered_row(ops, order, slot_order)
        let delta = match tiered {
            Some(slots) => slots[slot_order],
            None => None,
        }
        if let Some(trim) = op.trim {
            let dropped = match delta {
                Some(TieredDropped(bytes_dropped)) => bytes_dropped,
                _ => trim.dropped,
            }
            encode_log_trim(mut payload, op.key, trim.floor, dropped)
            continue
        }
        let prior = match (delta, base) {
            (Some(TieredPrior(prior)), _) => prior,
            (_, Some(head)) => {
                if collection_kind(head, list.slice(op.key, 0, 4)) == Some(LogCollection) {
                    0u32
                } else {
                    stored_prior(get_page_row(head, op.key))
                }
            },
            (_, None) => 0,
        }
        encode_data_op(mut payload, op.key, op.value, Some(prior))?
    }
    Ok(())
}

fn encode_data_op(mut payload: Bytes, key: Bytes, value: Option[StagedValue], prior: Option[u32]) -> Result[(), Capacity] {
    let tag: u64 = match value {
        Some(_) => 1,
        None => 2
    }
    le(mut payload, tag, 1)?
    blob(mut payload, key)?
    if let Some(width) = prior {
        list.put_word_le(mut payload, width)
    }
    if let Some(raw) = value {
        blob(mut payload, staged_bytes(raw))?
    }
    Ok(())
}

fn encode_log_trim(mut payload: Bytes, key: Bytes, floor: u64, dropped: u64) {
    list.push(mut payload, 3u8)
    list.append(mut payload, key)
    list.put_word_be(mut payload, floor)
    list.put_word_be(mut payload, dropped)
}

fn encode_stream_op(mut payload: Bytes, operation: DataOp, call: Option[View[CallRecord]], settlement: Option[Settlement]) -> Result[(), Capacity] {
    if let (Some(raw), Some(record)) = (view operation.value, view call) {
        if stream_record_matches(operation.key, record.stream) {
            le(mut payload, 3, 1)?
            blob(mut payload, operation.key)?
            blob(mut payload, staged_bytes(raw))?
            return encode_call(mut payload, record, settlement)
        }
    }
    encode_data_op(mut payload, operation.key, operation.value, None)
}

fn stream_control_slot(ops: DataRows) -> Option[u64] {
    for slot in 0u64 .. ops.count {
        if list.len(data_row(ops, slot).key) == 0u64 {
            return Some(slot)
        }
    }
    None
}

fn encode_stream_ops(mut payload: Bytes, ops: DataRows, stream_count: u64, call: Option[View[CallRecord]], settlement: Option[Settlement]) -> Result[(), Capacity] {
    le(mut payload, 1, 1)?
    le(mut payload, stream_count, 4)?
    let order = data_order(ops)?
    for slot_order in 0u64 .. ops.count {
        let operation = ordered_row(ops, order, slot_order)
        if list.len(operation.key) != 0u64 {
            encode_stream_op(mut payload, operation, call, settlement)?
        }
    }
    Ok(())
}

pub type RowSchemas: codec + shareable + send {
    key: Bytes,
    value: Bytes
}

pub opaque type Readers[V]: shareable + send {
    codec: std.codec.Codec[V],
    current: u16,
    older: List[Option[std.codec.Reader[V]]],
    schemas: Arc[RowSchemas]
}

pub opaque type Table[K, V]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    key: std.codec.Key[K],
    readers: Arc[Readers[V]]
}

pub type IndexKind: key + shareable + send = Many | Unique

pub opaque type Index[J, K, V, P]: shareable + send {
    store: StoreId,
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    table: u32,
    key: std.codec.Key[J],
    primary: std.codec.Key[K],
    readers: Arc[Readers[V]],
    kind: IndexKind,
    payload: Option[Arc[Readers[P]]],
    payload_codec: std.codec.Codec[P],
    // The record was Public in the catalog root page `catalog_page` names.
    public: bool
}

type PageRows[K, V]: send {
    cursor: PageRange,
    data: PageTree,
    decoder: RowDecoder[K, V]
}

type RowDecoder[K, V]: send {
    table: u32,
    key: std.codec.Key[K],
    readers: Arc[Readers[V]],
    unique: bool,
    skip: Option[own[send] fn(Bytes, mut u64) -> Result[(), std.codec.DecodeError]]
}

pub fn row_schemas[K, V](t: Table[K, V]) -> Arc[RowSchemas] {
    arc.share(t.readers.schemas)
}

fn decoded[T](take r: Result[T, std.codec.DecodeError]) -> Result[T, Error] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(e) => Error(Decode(e))
    }
}

fn read_le(raw: Bytes, at: u64, width: u64) -> u64 {
    match width {
        1 => int.widen(raw[at]),
        2 => {
            let word: u16 = list.word_le(raw, at)
            int.widen(word)
        },
        4 => {
            let word: u32 = list.word_le(raw, at)
            int.widen(word)
        },
        8 => list.word_le(raw, at),
        _ => fail("store: invalid frame word width"),
    }
}

fn row_value[V](r: Readers[V], id: u32, raw: Bytes) -> Result[V, Error] {
    if list.len(raw) < 2 {
        return Error(Decode(Truncated(0)))
    }
    let number: u16 = int.truncate(read_le(raw, 0, 2))
    if number == r.current {
        return decoded(std.codec.decode_at(r.codec, raw, 2))
    }
    let n: u64 = int.widen(number)
    if n >= list.len(r.older) {
        return Error(Stale(id))
    }
    match r.older[n] {
        Some(old) => decoded(std.codec.read_at(old, raw, 2)),
        None => Error(Stale(id))
    }
}

fn encode_key[K](k: std.codec.Key[K], value: K) -> Result[Bytes, Error] {
    let mut raw: Bytes = list.new()
    std.codec.encode_key(k, value, mut raw)
    Ok(take raw)
}

fn typed_bound[K](k: std.codec.Key[K], limit: Bound[K]) -> Result[Bound[Bytes], Error] {
    match limit {
        Unbounded => Ok(Unbounded),
        Included(x) => Ok(Included(encode_key(k, x)?)),
        Excluded(x) => Ok(Excluded(encode_key(k, x)?))
    }
}

fn writable[K, V](tx: Tx, t: Table[K, V]) -> Result[List[(u64, Catalog)], Error] {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    readable(tx.roots, t.catalog_key, t.catalog_page, t.id)?
    bound_indexes(tx, t.id, t.readers.current)
}

/// Borrow the stored schema tag and codec bytes, including any staged write.
pub fn fetch_bytes[K, V](tx: Tx, t: Table[K, V], k: K) -> Result[Option[View[Bytes]], Error] in tx {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    readable(tx.roots, t.catalog_key, t.catalog_page, t.id)?
    let mut p: Bytes = list.with_capacity(12)
    list.put_word_be(mut p, t.id)
    std.codec.encode_key(t.key, k, mut p)
    fetch_logical(tx, take p)
}

pub fn fetch[K, V](tx: Tx, t: Table[K, V], k: K) -> Result[Option[V], Error] {
    match fetch_bytes(tx, t, k)? {
        Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
        None => Ok(None)
    }
}

pub fn key_span[K, V](t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Read, Error] {
    Ok(Span(lower_bytes(t.id, typed_bound(t.key, lo)?, false)?, lower_bytes(t.id, typed_bound(t.key, hi)?, true)?))
}

// AG3: the value a publisher sends for a Change of t, in t's current codec without the u16
// schema prefix. An older number is read with its Reader and encoded again, because the old
// encoding may differ in length and layout. A key of another table (an index row's key
// included) is Missing("table").
pub fn published_value[K, V](t: Table[K, V], c: Change) -> Result[Option[Bytes], Error] {
    let mine = prefix(t.id)?
    if list.len(c.tree_key) < 4 || list.slice(c.tree_key, 0, 4) != list.slice(mine, 0, 4) {
        return Error(Missing("table"))
    }
    publish_row(t.id, t.readers, c)
}

fn publish_row[V](id: u32, registered: Readers[V], c: Change) -> Result[Option[Bytes], Error] {
    let raw = match c.value {
        Some(v) => v,
        None => return Ok(None)
    }
    if list.len(raw) < 2 {
        return Error(Decode(Truncated(0)))
    }
    let number: u16 = int.truncate(read_le(raw, 0, 2))
    let mut out: Bytes = list.with_capacity(list.len(raw) - 2)
    if number == registered.current {
        list.append(mut out, list.slice(raw, 2, list.len(raw)))
        return Ok(Some(take out))
    }
    let v = row_value(registered, id, raw)?
    std.codec.encode(registered.codec, v, mut out) ?=> |_| Limit(Value)
    Ok(Some(take out))
}

// Whether a changed data-tree key falls in a read: equal to a Point, or in a Span's [low, high).
pub fn reads_key(r: Read, key: Bytes) -> bool {
    match r {
        Point(p) => p == key,
        Span(low, high) => low <= key && key < high
    }
}

fn index_decoder[J, K, V, P](ix: Index[J, K, V, P]) -> RowDecoder[K, V] {
    let k = ix.key
    let start = 4u64
    let skip: own[send] fn(Bytes, mut u64) -> Result[(), std.codec.DecodeError] = fn(raw: Bytes, mut at: u64) -> Result[(), std.codec.DecodeError] {
        at = start
        let _ = std.codec.take_key_with(raw, mut at, k)?
        Ok(())
    }
    RowDecoder(table: ix.table, key: ix.primary, readers: arc.share(ix.readers), unique: (ix.kind == Unique), skip: Some(take skip))
}

fn indexed_rows[J, K, V, P](data: PageTree, ix: Index[J, K, V, P], take cursor: PageRange) -> Result[PageRows[K, V], Error] {
    Ok(PageRows(cursor: take cursor, data: share_page_tree(data), decoder: index_decoder(ix)))
}

fn prefix_after(raw: Bytes) -> Result[Bytes, Error] {
    let mut out = copied(raw)?
    let mut i = list.len(out)
    while i > 0 {
        i -= 1
        if out[i] != 255 {
            let byte = out[i] + 1
            let _ = list.set(mut out, i, byte)
            while list.len(out) > i + 1 {
                let _ = list.pop(mut out)
            }
            return Ok(take out)
        }
    }
    Ok(take out)
}

fn index_bound[J](ix: u32, key: std.codec.Key[J], limit: Bound[J], high: bool) -> Result[Bytes, Error] {
    match limit {
        Unbounded => prefix(if high {
            ix + 1
        } else {
            ix
        }),
        Included(x) => {
            let p = logical_key(ix, encode_key(key, x)?)?;
            if high {
                prefix_after(p)
            } else {
                Ok(take p)
            }
        },
        Excluded(x) => {
            let p = logical_key(ix, encode_key(key, x)?)?;
            if high {
                Ok(take p)
            } else {
                prefix_after(p)
            }
        }
    }
}

fn table_key(name: String) -> Result[Bytes, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k: Bytes = list.new()
    list.push(mut k, 1u8)
    list.append(mut k, string.as_bytes(name))
    Ok(take k)
}

fn index_prefix(id: u32) -> Result[Bytes, Error] {
    let mut k: Bytes = list.new()
    list.push(mut k, 2u8)
    list.append(mut k, prefix(id)?)
    Ok(take k)
}

fn catalog_index_key(id: u32, name: String) -> Result[Bytes, Error] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k = index_prefix(id)?
    list.append(mut k, string.as_bytes(name))
    Ok(take k)
}

fn catalog_entry_in(catalog: PageTree, k: Bytes) -> Result[Catalog, Error] {
    match get_page_row(catalog, k) {
        Some(raw) => decode_catalog(raw),
        None => Error(Stale(0))
    }
}

fn stamp_after(final_item: u64) -> Result[u64, Error] {
    let Some(next_stamp) = int.checked_add(final_item, 1) else {
        return Error(Limit(Ids))
    }
    Ok(next_stamp)
}

fn define_store_collection(mut tree: PageTree, id: u32, kind: u8, mut final_item: u64) -> Result[(), Error] {
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    define_collection(mut tree, id, kind, first, mut next_stamp)?
    canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(())
}

fn bulk_store_collection(mut tree: PageTree, id: u32, kind: u8, rows: List[std.page.Row], mut final_item: u64) -> Result[(), Error] {
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    bulk_collection(mut tree, id, kind, rows, first, mut next_stamp)?
    canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(())
}

fn remove_store_row(mut tree: PageTree, key: Bytes, mut final_item: u64) -> Result[(), Error] {
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    let _ = remove_page_row(mut tree, key, first, mut next_stamp)?
    canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(())
}

fn remove_store_collection(mut tree: PageTree, id: u32, mut final_item: u64) -> Result[u64, Error] {
    let key = prefix(id)?
    let charge = match std.page.lookup(tree.root, key) {
        Some(descriptor) => int.saturating_add(126, collection_descriptor(descriptor).row_bytes),
        None => 0u64,
    }
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    let _ = drop_collection(mut tree, id, first, mut next_stamp)?
    canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(charge)
}

pub fn system_table[K, V](db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    healthy(db)?
    catalog_handle(db.store, db.heads[0].roots.catalog, named(name)?, take key, take value)
}

fn stage_create_table[K, V](mut plan: SchemaPlan, name: String, key: std.codec.Key[K], value: std.codec.Codec[V]) -> Result[(), Error] {
    let k = table_key(name)?
    if let Some(_) = get_page_row(plan.roots.catalog, k) {
        return Error(Exists(named(name)?))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let mut schemas: List[ValueSchema] = list.new()
    let fp = std.codec.fingerprint_of(schema)
    list.push(mut schemas, ValueSchema(number: 0, fingerprint: fp, schema: take schema))
    let id = plan.next_table
    let c = Catalog(record: CatalogTable, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(key) ?=> |_| Schema(0)), schemas: take schemas, next: 1, by: list.new(), revision: list.new())
    let raw = encode_catalog(c)?
    let live_bytes = catalog_recharge(plan.live, plan.roots, k, raw, plan.retained)
    let base = share_roots(plan.roots)
    let mut roots = catalog_insert(mut plan.next_node, base, k, raw)?
    define_store_collection(mut roots.collections, id, 1, mut plan.next_node)?
    keep_schema(mut plan, take roots, int.saturating_add(live_bytes, 126), id + 1)
}

fn readers[V](value: std.codec.Codec[V], c: Catalog, current: u16, schema: Bytes) -> Result[Arc[Readers[V]], Error] {
    let mut older: List[Option[std.codec.Reader[V]]] = list.with_capacity(int.widen(c.next))
    for _ in 0u64 .. int.widen(c.next) {
        list.push(mut older, None)
    }
    for old in c.schemas {
        if old.number != current {
            let resolution = std.codec.resolve(value, old.schema)
            let resolved = match take resolution {
                Error(Schema(i)) => return Error(Schema(i)),
                Error(e) => return Error(Decode(e)),
                Ok(take read_source) => take read_source
            }
            let _ = list.set(mut older, int.widen(old.number), Some(take resolved))
        }
    }
    let schemas = arc.new(RowSchemas(key: copied(c.key)?, value: copied(schema)?))
    Ok(arc.new(Readers(codec: value, current: current, older: take older, schemas: take schemas)))
}

pub fn table[K, V](mut db: Db, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] waits {
    healthy(db)?
    let mut plan = schema_plan(db)
    let target = stage_table(mut plan, name, take key, take value)?
    if plan.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    Ok(take target)
}

fn stage_table[K, V](mut plan: SchemaPlan, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let k = table_key(name)?
    let mut c = match get_page_row(plan.roots.catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(named(name)?))
    }
    if catalog_kind(c.record) != TableCollection {
        return Error(Missing(named(name)?))
    }
    let key_schema = std.codec.key_schema(key) ?=> |_| Schema(0)
    if key_schema != c.key {
        return Error(Schema(0))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    let mut number = c.next
    let mut found = false
    for old in c.schemas {
        if old.fingerprint == fp && old.schema == schema {
            number = old.number;
            found = true
        }
    }
    // Resolve before publishing a schema addition: Schema is always without effect.
    let resolved = readers(value, c, number, schema)?
    let key_handle = catalog_key_handle(take k)?
    let seen = catalog_page(plan.roots.catalog)?
    if !found {
        list.push(mut c.schemas, ValueSchema(number: number, fingerprint: fp, schema: take schema))
        c.next += 1
        let raw = encode_catalog(c)?
        let live_bytes = catalog_recharge(plan.live, plan.roots, key_handle, raw, plan.retained)
        let base = share_roots(plan.roots)
        let roots = catalog_insert(mut plan.next_node, base, key_handle, raw)?
        let next_id = plan.next_table
        keep_schema(mut plan, take roots, live_bytes, next_id)?
    }
    Ok(Table(store: plan.store, id: c.id, catalog_key: take key_handle, catalog_page: take seen, key: key, readers: take resolved))
}

fn catalog_handle[K, V](store_id: StoreId, catalog: PageTree, take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let k = table_key(name)?
    let c = match get_page_row(catalog, k) {
        Some(raw) => decode_catalog(raw)?,
        None => return Error(Missing(take name))
    }
    if catalog_kind(c.record) != TableCollection {
        return Error(Missing(take name))
    }
    let key_schema = std.codec.key_schema(key) ?=> |_| Schema(0)
    if key_schema != c.key {
        return Error(Schema(0))
    }
    let schema = std.codec.schema(value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    for prior in c.schemas {
        if prior.fingerprint == fp && prior.schema == schema {
            let number = prior.number
            let resolved = readers(value, c, number, schema)?
            return Ok(Table(store: store_id, id: c.id, catalog_key: catalog_key_handle(take k)?, catalog_page: catalog_page(catalog)?, key: key, readers: take resolved))
        }
    }
    Error(Schema(int.widen(c.next)))
}

fn catalog_index_handle[J, K, V, P](catalog: PageTree, t: Table[K, V], c: Catalog, take k: Bytes, take key: std.codec.Key[J], take payload: Option[Arc[Readers[P]]], payload_codec: std.codec.Codec[P]) -> Result[Index[J, K, V, P], Error] {
    let public = match get_page_row(catalog, k) {
        Some(raw) => record_public(raw),
        None => false,
    }
    Ok(Index(store: t.store, id: c.id, catalog_key: catalog_key_handle(take k)?, catalog_page: catalog_page(catalog)?, table: t.id, key: key, primary: t.key, readers: arc.share(t.readers), kind: entry_kind(catalog_index(c)?.shape)?, payload: take payload, payload_codec: payload_codec, public: public))
}

fn stage_drop_table_key(mut plan: SchemaPlan, catalog_key: Bytes, table_id: u32) -> Result[(), Error] {
    let indexes = index_catalog_in(plan.roots.catalog, table_id)?
    let mut ids: List[u32] = list.new()
    list.push(mut ids, table_id)
    for ix in indexes {
        list.push(mut ids, ix.id)
    }
    let mut roots = share_roots(plan.roots)
    let mut live_bytes = plan.live
    for id in ids {
        let charge = remove_store_collection(mut roots.collections, id, mut plan.next_node)?
        if !plan.retained {
            live_bytes = int.saturating_sub(live_bytes, charge)
        }
    }
    let low = index_prefix(table_id)?
    let high = index_prefix(table_id + 1)?
    let mut cursor = byte_cursor(roots.catalog, Included(take low), high)?
    while let Some((k, v)) = next_bytes(mut cursor)? {
        if !plan.retained {
            live_bytes = int.saturating_sub(live_bytes, entry(k, v))
        }
        remove_store_row(mut roots.catalog, k, mut plan.next_node)?
    }
    if let Some(raw) = get_page_row(plan.roots.catalog, catalog_key) {
        if !plan.retained {
            live_bytes = int.saturating_sub(live_bytes, entry(catalog_key, raw))
        }
    }
    remove_store_row(mut roots.catalog, catalog_key, mut plan.next_node)?
    let next_id = plan.next_table
    keep_schema(mut plan, take roots, live_bytes, next_id)
}

// What a migrate builds before its cut: the new roots and the account.
type Built {
    roots: Roots,
    live: u64,
    read: u64,
    written: u64
}

fn over_ceiling(live_bytes: u64, ceiling: u64) -> Result[(), Error] {
    if live_bytes > ceiling {
        return Error(Full(Resident(Capacity(requested: live_bytes, available: ceiling))))
    }
    Ok(())
}

fn insert_row(mut ids: u64, mut roots: Roots, take p: Bytes, take raw: Bytes) -> Result[bool, Error] {
    let replaced = match get_page_row(roots.collections, p) {
        Some(_) => true,
        None => false
    }
    let first = stamp_after(ids)?
    let mut next_stamp = first
    let collection_key = list.slice(p, 0, 4)
    let exists = match std.page.collection_child(roots.collections.root, collection_key) {
        Some(_) => true,
        None => false,
    }
    if !exists {
        define_collection(mut roots.collections, list.word_be(p, 0), 1, first, mut next_stamp)?
    }
    put_page_row(mut roots.collections, p, raw, first, mut next_stamp)?
    canonical_tree(mut roots.collections)?
    ids = next_stamp - 1
    Ok(replaced)
}

// AP13. Collect and admit the encoded workspace, sort the destination
// records, then build the table and each index bottom up.
fn migrate_build[K, V, K2, V2](source: PageTree, take base: Roots, mut ids: u64, start: u64, ceiling: u64, retained: bool, from: Table[K, V], olds: List[Catalog], to_name: String, to_key: std.codec.Key[K2], to_value: std.codec.Codec[V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity], id: u32, number: u16, target: Bytes, value_limit: u64) -> Result[Built, Error] {
    let mut roots = take base
    let schema = std.codec.schema(to_value) ?=> |_| Schema(0)
    let fp = std.codec.fingerprint_of(schema)
    let mut schemas: List[ValueSchema] = list.new()
    list.push(mut schemas, ValueSchema(number: number, fingerprint: fp, schema: take schema))
    let table_raw = encode_catalog(Catalog(record: CatalogTable, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(to_key) ?=> |_| Schema(0)), schemas: take schemas, next: number + 1, by: list.new(), revision: list.new()))?
    let mut live_bytes = int.saturating_add(start, 126 + entry(target, table_raw))
    let mut workspace = live_bytes
    over_ceiling(workspace, ceiling)?
    let Some(source_root) = std.page.collection_child(source.root, prefix(from.id)?) else {
        return Error(Stale(from.id))
    }
    let (source_rows, _) = std.page.totals(source_root)
    let mut original = std.page.cursor_open(source_root, None, true, false)
    let mut new_rows: List[std.page.Row] = list.new()
    loop {
        // Decode each source row from the page in place, with no owned copy.
        let read = std.page.cursor_read(mut original, scoped fn(key: Bytes, raw: Bytes) -> Result[(K, V, u64), Error] {
            let decoded_key = decoded(std.codec.decode_key(from.key, key))?
            Ok((take decoded_key, row_value(from.readers, from.id, raw)?, list.len(raw)))
        })
        let Some(take found) = take read else {
            break
        }
        let (take k, take v, source_width) = found?
        if let Some((k2, v2)) = capacity(f(k, v))? {
            let encoded = encode_key(to_key, k2)?
            if list.len(encoded) > 4092 {
                return Error(Limit(Key))
            }
            // The source row's width sizes the buffer, so an upgrade that keeps
            // the row's size encodes it with no regrowth.
            let width = order.max(source_width, 2 + std.codec.least(to_value))
            let mut raw: Bytes = list.with_capacity(order.min(width, value_limit))
            capacity(le(mut raw, int.widen(number), 2))?
            std.codec.encode(to_value, v2, mut raw) ?=> |_| Limit(Value)
            if list.len(raw) > value_limit {
                return Error(Limit(Value))
            }
            let charge = 62 + round8(4 + list.len(encoded)) + round8(list.len(raw))
            workspace = int.saturating_add(workspace, charge + 8)
            over_ceiling(workspace, ceiling)?
            live_bytes = int.saturating_add(live_bytes, charge)
            list.push(mut new_rows, std.page.Row(key: take encoded, value: take raw, charge: charge))
        }
    }
    sort_bulk_rows(mut new_rows)?
    for slot in 1u64 .. list.len(new_rows) {
        if new_rows[slot - 1].key == new_rows[slot].key {
            return Error(Exists(named(to_name)?))
        }
    }
    let written = list.len(new_rows)
    bulk_store_collection(mut roots.collections, id, 1, new_rows, mut ids)?
    let former = remove_store_collection(mut roots.collections, from.id, mut ids)?
    if !retained {
        live_bytes = int.saturating_sub(live_bytes, former)
    }
    for old in olds {
        let charge = remove_store_collection(mut roots.collections, old.id, mut ids)?
        if !retained {
            live_bytes = int.saturating_sub(live_bytes, charge)
        }
    }
    let low = index_prefix(from.id)?
    let high = index_prefix(from.id + 1)?
    let mut catalog_rows = byte_cursor(roots.catalog, Included(take low), high)?
    while let Some((k, v)) = next_bytes(mut catalog_rows)? {
        if !retained {
            live_bytes = int.saturating_sub(live_bytes, entry(k, v))
        }
        remove_store_row(mut roots.catalog, k, mut ids)?
    }
    if let Some(raw) = get_page_row(roots.catalog, from.catalog_key) {
        if !retained {
            live_bytes = int.saturating_sub(live_bytes, entry(from.catalog_key, raw))
        }
    }
    remove_store_row(mut roots.catalog, from.catalog_key, mut ids)?
    roots = catalog_insert(mut ids, roots, target, table_raw)?
    if !retained {
        live_bytes = one_page_account(roots)
    }
    over_ceiling(live_bytes, ceiling)?
    Ok(Built(roots: take roots, live: live_bytes, read: source_rows, written: written))
}

fn same_bytes(a: Bytes, b: Bytes) -> bool {
    a == b
}

fn catalog_insert(mut ids: u64, roots: Roots, k: Bytes, v: Bytes) -> Result[Roots, Error] {
    let mut edited = share_roots(roots)
    let first = stamp_after(ids)?
    let mut next_stamp = first
    put_page_row(mut edited.catalog, k, v, first, mut next_stamp)?
    canonical_tree(mut edited.catalog)?
    ids = next_stamp - 1
    Ok(take edited)
}

fn stage_migrate[K, V, K2, V2](mut plan: SchemaPlan, take from: Table[K, V], to_name: String, to_key: std.codec.Key[K2], to_value: std.codec.Codec[V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity]) -> Result[(), Error] {
    if !same(plan.store, from.store) {
        return Error(Foreign)
    }
    let meta = catalog_entry_in(plan.roots.catalog, from.catalog_key)?
    if meta.id != from.id {
        return Error(Stale(from.id))
    }
    let target = table_key(to_name)?
    if !same_bytes(target, from.catalog_key) {
        if let Some(_) = get_page_row(plan.roots.catalog, target) {
            return Error(Exists(named(to_name)?))
        }
    }
    if meta.next == 65535 {
        return Error(Limit(Value))
    }
    let olds = index_catalog_in(plan.roots.catalog, from.id)?
    let id = plan.next_table
    let base = share_roots(plan.roots)
    let mut ids = plan.next_node
    let built = migrate_build(plan.roots.collections, take base, mut ids, plan.live, plan.ceiling, plan.retained, from, olds, to_name, to_key, to_value, f, id, meta.next, target, plan.value_limit)
    plan.next_node = ids
    let Built(roots: take roots, live: live_bytes, read, written) = built?
    keep_schema(mut plan, take roots, live_bytes, id + 1)?
    if let Some(mut backfills) = plan.preview {
        list.push(mut backfills, MigrationBackfill(table: named(to_name)?, index: None, cause: None, read: read, written: written, outcome: Filled))
    }
    Ok(())
}

fn bucket(_k: u64, v: u64) -> Result[List[u64], Capacity] {
    let mut keys: List[u64] = list.new()
    list.push(mut keys, v % 4)
    Ok(take keys)
}

fn typed_put(mut db: Db, t: Table[u64, u64], k: u64, v: u64) -> bool waits {
    let out = run(mut db, None, (copy_env(k), copy_env(t), copy_env(v)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.1, call_env.0, call_env.2)
    })
    match take out {
        Ok(Committed(_)) => true,
        _ => false
    }
}

pub fn put[K, V](mut tx: Tx, t: Table[K, V], k: K, v: V) -> Result[(), Error] {
    check_write_attempt(tx)?
    if let Some(stop) = tx.index_conflict {
        return Error(index_stop_error(stop)?)
    }
    let indexes = writable(tx, t)?
    let tail = tx.frame_tail == OPEN_FRAME_TAIL
    let mut p = prefixed(t.id, 8, tail)?
    std.codec.encode_key(t.key, k, mut p)
    put_impl(mut tx, t, indexes, take p, v, tail)
}

pub fn delete[K, V](mut tx: Tx, t: Table[K, V], k: K) -> Result[bool, Error] {
    check_write_attempt(tx)?
    if let Some(stop) = tx.index_conflict {
        return Error(index_stop_error(stop)?)
    }
    let indexes = writable(tx, t)?
    let key = encode_key(t.key, k)?
    delete_impl(mut tx, t.id, t.readers.current, indexes, key)
}

type OldAccount {
    balance: u64
}

type NewAccount {
    balance: u64,
    bonus: u64
}

fn upgrade(k: u64, v: OldAccount) -> Result[Option[(u64, NewAccount)], Capacity] {
    Ok(Some((k, NewAccount(balance: v.balance, bonus: v.balance * 10))))
}

pub type Looked[R] = Seen(Seen[R]) | Failed(Causes, List[Read]) | Refused(StoreCapacity, List[Read]) | Stopped(OutOfTime, List[Read])

pub type Seen[R] {
    value: R,
    version: u64,
    reads: List[Read]
}

pub type Change {
    tree_key: Bytes,
    value: Option[Arc[Bytes]]
}

pub fn changes(r: Reader, a: Snapshot, b: Snapshot) -> Result[Changes, Error] waits {
    read_access(r, a)?
    read_access(r, b)?
    if !same(a.store, b.store) || a.open != b.open {
        return Error(Foreign)
    }
    snapshot_changes(r, a, b)
}

pub opaque scoped type TxRows[K, V] {
    rows: PageRows[K, V],
    owner: CallId,
    depth: u64,
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    reverse: bool,
    log_tail: Option[LogRangeTail],
    tiered: Option[TxTieredRows]
}

// Before decoding an attempted row, record it and the gap traversed to find it.
// Exhaustion records the remainder once. An unused cursor observes no keys.
pub fn next_in[K, V](tx: Tx, mut r: TxRows[K, V]) -> Result[Option[(K, V)], Error] {
    if !same(tx.store, r.owner.store) || tx.info.id.branch != r.owner.branch || tx.info.id.version != r.owner.version || tx.own != r.depth {
        return Error(Foreign)
    }
    let mut found = match r.tiered {
        Some(mut tiered) => next_tiered_in(tx, mut tiered, r.reverse)?,
        None => next_bytes(mut r.rows.cursor)?,
    }
    if let None = found {
        if let Some(mut tail) = r.log_tail {
            found = next_log_range_tail(tx, mut tail)?
        }
    }
    match take found {
        Some((take key, take raw)) => {
            if r.reverse {
                let new_high = copied(key)?
                let high = replace(mut r.high, take new_high)
                log.append(r.reads, Span(copied(key)?, take high))
            } else {
                let mut end = copied(key)?
                list.push(mut end, 0u8)
                let low = replace(mut r.low, copied(end)?)
                log.append(r.reads, Span(take low, take end))
            }
            let row = advance_rows(r.rows.decoder, r.rows.data, key, raw, None, fn(observed: Bytes) -> Result[(), Error] {
                Ok(())
            })?
            match take row {
                Some((take value, _)) => Ok(Some(take value)),
                None => Ok(None)
            }
        },
        None => {
            if r.low < r.high {
                let low = replace(mut r.low, list.new())
                let high = replace(mut r.high, list.new())
                log.append(r.reads, Span(take low, take high))
            }
            Ok(None)
        },
    }
}

fn catalog_recharge(live_bytes: u64, roots: Roots, key: Bytes, value: Bytes, retained: bool) -> u64 {
    let old_charge = if retained {
        0u64
    } else {
        match get_page_row(roots.catalog, key) {
            Some(old) => entry(key, old),
            None => 0
        }
    }
    int.saturating_add(int.saturating_sub(live_bytes, old_charge), entry(key, value))
}

// Store disk format. STORE-SPEC §2.3 and §11.10.
const DISK_FORMAT: u64 = 10

type DiskContext {
    store: StoreId,
    role: u8,
    seq: u64
}

type DiskFrame {
    kind: u16,
    flags: u16,
    payload: u64,
    end: u64
}

type DiskHeader {
    context: DiskContext,
    prev_end: u64
}

// Every check starts with the store, file role, file sequence and offset.
const BINDING_BYTES: u64 = 33

fn put_binding(mut out: Bytes, ctx: DiskContext, offset: u64) -> Result[(), Capacity] {
    le(mut out, ctx.store.hi, 8)?
    le(mut out, ctx.store.lo, 8)?
    le(mut out, int.widen(ctx.role), 1)?
    le(mut out, ctx.seq, 8)?
    le(mut out, offset, 8)
}

fn disk_check_start(ctx: DiskContext, offset: u64, head: Bytes) -> Result[std.check.Xxh3, Capacity] {
    let mut schema_binding: Bytes = (bound bytes round8(BINDING_BYTES) {
        list.with_capacity(BINDING_BYTES)
    })?
    put_binding(mut schema_binding, ctx, offset)?
    let mut state = std.check.start()
    std.check.add(mut state, schema_binding, 0, BINDING_BYTES)
    std.check.add(mut state, head, 0, 8)
    Ok(take state)
}

// Writes the check of a frame laid out as head[0..8], check[8..16] and
// payload[16..]. The binding goes past the payload, into capacity the caller
// reserved, and is hashed from there, so sealing allocates nothing and needs no
// allocation isolation when a commit seals its frame at the file end.
fn seal_frame(mut out: Bytes, ctx: DiskContext, offset: u64) -> Result[(), Capacity] {
    let end = list.len(out)
    if list.capacity(out) - end < BINDING_BYTES {
        fail("store: frame has no room for its check binding")
    }
    put_binding(mut out, ctx, offset)?
    let mut state = std.check.start()
    std.check.add(mut state, out, end, end + BINDING_BYTES)
    std.check.add(mut state, out, 0, 8)
    std.check.add(mut state, out, 16, end)
    list.truncate(mut out, end)
    list.set_word_le(mut out, 8, std.check.finish(state))
    Ok(())
}

fn disk_check(ctx: DiskContext, offset: u64, head: Bytes, payload: Bytes) -> Result[u64, Capacity] {
    let mut state = disk_check_start(ctx, offset, head)?
    std.check.add(mut state, payload, 0, list.len(payload))
    Ok(std.check.finish(state))
}

fn disk_seal(ctx: DiskContext, offset: u64, kind: u16, flags: u16, payload: Bytes) -> Result[Bytes, Capacity] {
    let mut out: Bytes = list.with_capacity(16 + list.len(payload) + BINDING_BYTES)
    le(mut out, int.widen(kind), 2)?
    le(mut out, int.widen(flags), 2)?
    le(mut out, list.len(payload), 4)?
    le(mut out, 0, 8)?
    list.append(mut out, payload)
    seal_frame(mut out, ctx, offset)?
    Ok(take out)
}

fn disk_kind_limit(kind: u16) -> Option[u64] {
    match kind {
        0x0001 => Some(56),
        0x0011 => Some(16777280),
        0x0012 => Some(8),
        0x0013 => Some(281),
        0x0021 => Some(8384),
        0x0022 => Some(16711688),
        0x0023 => Some(PACK_INDEX_LIMIT),
        0x0031 => Some(MANIFEST_LIMIT),
        0x0040 => Some(CLAIM_BYTES),
        0x0070 => Some(4),
        0x0080 => Some(128),
        0x0081 => Some(1048832),
        0x0082 => Some(2097480),
        0x0083 => Some(20),
        0x0084 => Some(16715784),
        0x0085 => Some(16715784),
        0x0086 => Some(1048832),
        0x0087 => Some(16715784),
        0x0088 => Some(1048832),
        0x0089 => Some(16715784),
        _ => stream_kind_limit(kind)
    }
}

type DiskFrameHead {
    kind: u16,
    flags: u16,
    size: u64,
    checksum: u64
}

fn disk_read_frame_head(file: String, raw: Bytes, at: u64) -> Result[DiskFrameHead, Error] {
    let kind: u16 = list.word_le(raw, 0)
    let flags: u16 = list.word_le(raw, 2)
    let size = read_le(raw, 4, 4)
    if kind == 0 {
        return Error(disk_fault(file, at, Kind(0)))
    }
    if flags & 65534 != 0 {
        return Error(disk_fault(file, at, Flags))
    }
    match disk_kind_limit(kind) {
        Some(limit) => if size > limit {
            return Error(disk_fault(file, at, Malformed))
        },
        None => if flags & 1 == 0 && size > 65536 {
            return Error(disk_fault(file, at, Malformed))
        }
    }
    Ok(DiskFrameHead(kind: kind, flags: flags, size: size, checksum: list.word_le(raw, 8)))
}

fn disk_check_frame_kind(file: String, ctx: DiskContext, kind: u16, flags: u16, at: u64) -> Result[(), Error] {
    if ((kind == 0x0040 || kind == 0x0070) && ctx.role != 1) || (kind == 0x0080 && ctx.role != 5) || (kind >= 0x0081 && kind <= 0x0085 && ctx.role != 6) {
        return Error(disk_fault(file, at, Malformed))
    }
    if let None = disk_kind_limit(kind) {
        if flags & 1 != 0 {
            return Error(Unsupported(int.widen(kind)))
        }
    }
    if kind == 0x0001 && at != 0 {
        return Error(disk_fault(file, at, Header))
    }
    if (kind >= 0x0100 && kind <= 0x0105) || ((kind == 0x0011 || kind == 0x0013) && ctx.role != 2) || (kind == 0x0012 && ctx.role != 4) || ((kind >= 0x0021 && kind <= 0x0023) && ctx.role != 3) || (kind == 0x0031 && ctx.role != 1) {
        return Error(disk_fault(file, at, Kind(int.widen(kind))))
    }
    if (kind == 0x0013 || kind == 0x0023) && flags != 1 {
        return Error(disk_fault(file, at, Flags))
    }
    Ok(())
}

fn disk_read_frame(file: String, ctx: DiskContext, raw: Bytes, at: u64) -> Result[DiskFrame, Error] {
    let frame = disk_frame_bytes(file, ctx, raw, at)?
    disk_check_frame_kind(file, ctx, frame.kind, frame.flags, at)?
    Ok(frame)
}

fn disk_frame_bytes(file: String, ctx: DiskContext, raw: Bytes, at: u64) -> Result[DiskFrame, Error] {
    if at > list.len(raw) || list.len(raw) - at < 16 {
        return Error(disk_fault(file, at, Truncated))
    }
    let head = list.slice(raw, at, at + 16)
    let frame = disk_read_frame_head(file, head, at)?
    if frame.size > list.len(raw) - at - 16 {
        return Error(disk_fault(file, at, Truncated))
    }
    let end = at + 16 + frame.size
    let payload = list.slice(raw, at + 16, end)
    let check = capacity(disk_check(ctx, at, head, payload))?
    if check != frame.checksum {
        return Error(disk_fault(file, at, Checksum))
    }
    Ok(DiskFrame(kind: frame.kind, flags: frame.flags, payload: at + 16, end: end))
}

fn disk_header_bytes(ctx: DiskContext, prev_end: u64, authority: u8) -> Result[Bytes, Capacity] {
    let mut payload: Bytes = list.with_capacity(56)
    list.append(mut payload, string.as_bytes("HIRSTORE"))
    le(mut payload, DISK_FORMAT, 4)?
    list.push(mut payload, ctx.role)
    list.push(mut payload, authority)
    list.put_word_le(mut payload, 0u16)
    le(mut payload, ctx.store.hi, 8)?
    le(mut payload, ctx.store.lo, 8)?
    le(mut payload, 0, 8)?
    le(mut payload, ctx.seq, 8)?
    le(mut payload, prev_end, 8)?
    disk_seal(ctx, 0, 0x0001, 1, payload)
}

fn disk_read_header(file: String, raw: Bytes, role: u8, seq: Option[u64], expected_id: Option[StoreId]) -> Result[DiskHeader, Error] {
    if list.len(raw) < 72 {
        return Error(disk_fault(file, 0, Truncated))
    }
    let ctx = DiskContext(store: StoreId(hi: read_le(raw, 32, 8), lo: read_le(raw, 40, 8)), role: role, seq: read_le(raw, 56, 8))
    let frame = disk_read_frame(file, ctx, raw, 0)?
    if frame.kind != 1 || frame.end != 72 {
        return Error(disk_fault(file, 0, Header))
    }
    let magic = list.slice(raw, 16, 24)
    if magic != string.as_bytes("HIRSTORE") || raw[28] != role || read_le(raw, 30, 2) != 0 {
        return Error(disk_fault(file, 0, Header))
    }
    let format = read_le(raw, 24, 4)
    if format != DISK_FORMAT {
        return Error(Unsupported(format))
    }
    if raw[29] != 0 {
        return Error(Unsupported(int.widen(raw[29])))
    }
    let epoch = read_le(raw, 48, 8)
    if epoch != 0 {
        return Error(Unsupported(epoch))
    }
    if let Some(expected) = seq {
        if expected != ctx.seq {
            return Error(disk_fault(file, 0, Header))
        }
    }
    if let Some(expected) = expected_id {
        if !same(expected, ctx.store) {
            return Error(disk_fault(file, 0, Header))
        }
    }
    let previous = read_le(raw, 64, 8)
    if role != 2 && previous != 0 {
        return Error(disk_fault(file, 0, Header))
    }
    Ok(DiskHeader(context: ctx, prev_end: previous))
}

fn disk_number(file: String, raw: Bytes, mut at: u64, width: u64) -> Result[u64, Error] {
    if at > list.len(raw) || width > list.len(raw) - at {
        return Error(disk_fault(file, at, Truncated))
    }
    let value = read_le(raw, at, width)
    at += width
    Ok(value)
}

fn disk_count(file: String, raw: Bytes, mut at: u64, least: u64) -> Result[u64, Error] {
    let n = disk_number(file, raw, mut at, 4)?
    if n > (list.len(raw) - at) / least {
        return Error(disk_fault(file, at, Malformed))
    }
    Ok(n)
}

fn disk_name(file: String, raw: Bytes, mut at: u64) -> Result[String, Error] {
    let size = disk_number(file, raw, mut at, 2)?
    disk_name_bytes(file, raw, mut at, size)
}

fn disk_name_bytes(file: String, raw: Bytes, mut at: u64, size: u64) -> Result[String, Error] {
    if size > 255 || size > list.len(raw) - at {
        return Error(disk_fault(file, at, Malformed))
    }
    let chars = list.slice(raw, at, at + size)
    let owned = copied(chars)?
    at += size
    match string.from_utf8(take owned) {
        Ok(take text) => Ok(take text),
        Error(_) => Error(disk_fault(file, at - size, Malformed))
    }
}

fn disk_put_name(mut out: Bytes, name: String) -> Result[(), Capacity] {
    le(mut out, string.byte_len(name), 2)?
    Ok(list.append(mut out, string.as_bytes(name)))
}

fn encode_fork(context: DiskContext, offset: u64, head: Head, watermark: u64) -> Result[Bytes, Capacity] {
    let size = 26 + string.byte_len(head.name)
    let mut out: Bytes = list.with_capacity(16 + size + BINDING_BYTES)
    le(mut out, 0x0013, 2)?
    le(mut out, 1, 2)?
    le(mut out, size, 4)?
    le(mut out, 0, 8)?
    le(mut out, int.widen(head.id), 4)?
    le(mut out, int.widen(head.parent), 4)?
    le(mut out, head.forked_at, 8)?
    disk_put_name(mut out, head.name)?
    le(mut out, watermark, 8)?
    seal_frame(mut out, context, offset)?
    Ok(take out)
}

fn disk_blob(file: String, raw: Bytes, mut at: u64, limit: u64) -> Result[Bytes, Error] {
    let size = disk_number(file, raw, mut at, 4)?
    if size > limit || size > list.len(raw) - at {
        return Error(disk_fault(file, at, Malformed))
    }
    let value = list.slice(raw, at, at + size)
    let out = copied(value)?
    at += size
    Ok(take out)
}

fn disk_io[T](take r: Result[T, IoError]) -> Result[T, Error] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(e) => Error(Io(e))
    }
}

fn disk_path(lead: String, seq: u64, suffix: String) -> Result[String, Capacity] {
    let mut path = string.from(lead)
    string.push_u64(mut path, seq)
    string.push(mut path, suffix)
    Ok(take path)
}

fn disk_write_synced(d: Dir, path: String, raw: Bytes) -> Result[(), Error] waits {
    let mut file = disk_io(host.open(d, path, Write))?
    match host.write(mut file, raw) {
        Ok(()) => {},
        Error(e) => return Error(Io(e.error))
    }
    disk_io(host.sync(mut file))?
    disk_io(host.close(take file))
}

fn disk_remove_optional(d: Dir, path: String) -> Result[bool, Error] waits {
    match host.remove(d, path) {
        Ok(()) => Ok(true),
        Error(NotFound) => Ok(false),
        Error(e) => Error(Io(e))
    }
}

// Checkpoint graph: new nodes contribute their child edges once; root edges
// change at the cut. Removing a last edge cascades without walking live subtrees.
type DiskLoaded: send {
    store: StoreId,
    manifest: PageManifest,
    all: List[Roots],
    lists: PagedLists,
    locations: PageLocations
}

fn disk_loaded(id: StoreId, take validated: ValidatedPageManifest) -> Result[DiskLoaded, Error] {
    let LoadedPageStore(manifest: take manifest, holders: take all, lists: take lists, locations: take locations) = rebuild_page_store(take validated, None)?
    Ok(DiskLoaded(store: id, manifest: take manifest, all: take all, lists: take lists, locations: take locations))
}

fn disk_publish_manifest(d: Dir, id: StoreId, m: PageManifest) -> Result[(), Error] waits {
    let raw = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        disk_page_manifest_bytes(id, m)
    })?
    disk_write_synced(d, "MANIFEST.tmp", raw)?
    disk_io(host.rename(d, "MANIFEST.tmp", "MANIFEST"))?
    disk_io(host.sync_dir(d))
}

pub fn stage_export_migration(source: Preparation, tasks: Tasks, configure: StaticFn[fn(mut Migration) -> Result[(), Error] waits]) -> Result[StagedMigration, Error] waits {
    stage_migration(source.db, tasks, configure)
}

pub fn export_system_get[K, V](source: Preparation, name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V], at: K) -> Result[Option[V], Error] waits {
    let selected = system_table(source.db, name, take key, take value)?
    get(staged_reader(source, 0)?, snapshot(source.db), selected, at)
}

pub fn staged_snapshot(source: Preparation, staged: StagedMigration) -> Snapshot {
    snapshot_from(source.db, 0u64, source.stamp.head, staged.plan.roots, int.saturating_add(staged.plan.next_node, 1))
}

pub type PreparedTarget: codec + send {
    describe: Bytes,
    release: Bytes,
    digest: Bytes,
    resident_limit: u64,
    pack_bytes: u64,
    checkpoint_bytes: u64,
    journal_limit: u64,
    // NEW's limits (§11.1 AP4a); None keeps the store's, others must match.
    limits: Option[StoreLimits]
}

type PreparedMeta: codec + send {
    base: ExportStamp,
    target: PreparedTarget,
    next_table: u32,
    changes: u64,
    ranges: u64
}

type CatalogChange: codec + send {
    key: Bytes,
    before: Option[Bytes],
    after: Option[Bytes]
}

type Inventory: codec + send {
    id: u32,
    count: u64,
    digest: u64
}

type PreparedRow: codec + send {
    key: Bytes,
    value: Bytes
}

fn catalog_changes(base: Roots, target: Roots) -> Result[List[CatalogChange], Error] {
    let mut edits: List[CatalogChange] = list.new()
    let mut before = open_page_range(base.catalog, None, true, false, None)?
    while let Some((take key, old_arc)) = next_page_range(mut before)? {
        match get_page_row(target.catalog, key) {
            Some(new) => if list.compare_bytes(new, old_arc) != Equal {
                list.push(mut edits, CatalogChange(key: take key, before: Some(copied(old_arc)?), after: Some(copied(new)?)))
            },
            None => list.push(mut edits, CatalogChange(key: take key, before: Some(copied(old_arc)?), after: None)),
        }
    }
    let mut after = open_page_range(target.catalog, None, true, false, None)?
    while let Some((take key, new)) = next_page_range(mut after)? {
        let exists = match get_page_row(base.catalog, key) {
            Some(_) => true,
            None => false
        }
        if !exists {
            list.push(mut edits, CatalogChange(key: take key, before: None, after: Some(copied(new)?)))
        }
    }
    list.sort(mut edits, fn(a: CatalogChange, b: CatalogChange) -> Order {
        std.order.compare(a.key, b.key)
    })
    Ok(take edits)
}

type RangeChange: send {
    id: u32,
    catalog: Option[Bytes]
}

fn changed_ranges(edits: List[CatalogChange], initial: u32, advanced: u32) -> Result[List[RangeChange], Error] {
    let mut changes_by_id: List[RangeChange] = list.new()
    for change in edits {
        let old = match change.before {
            Some(raw) => decode_catalog(raw)?.id,
            None => 0u32
        }
        let new = match change.after {
            Some(raw) => decode_catalog(raw)?.id,
            None => 0u32
        }
        if old == new {
            // An index OLD left Backfilling or Failed that the preparation
            // finished under the same id: its entries ship as a replaced range.
            if let (Some(before), Some(after)) = (change.before, change.after) {
                if catalog_kind(decode_catalog(after)?.record) == IndexCollection && !record_public(before) {
                    list.push(mut changes_by_id, RangeChange(id: new, catalog: Some(copied(after)?)))
                }
            }
            continue
        }
        if old != 0u32 {
            list.push(mut changes_by_id, RangeChange(id: old, catalog: None))
        }
        if let Some(raw) = change.after {
            list.push(mut changes_by_id, RangeChange(id: new, catalog: Some(copied(raw)?)))
        }
    }
    list.sort(mut changes_by_id, fn(a: RangeChange, b: RangeChange) -> Order {
        std.order.compare(a.id, b.id)
    })
    let mut previous = 0u32
    let mut expected = initial
    for change in changes_by_id {
        if previous >= change.id {
            return Error(malformed(0u64))
        }
        previous = change.id
        if change.id >= initial {
            if change.id != expected || expected == 4294967295u32 {
                return Error(malformed(0u64))
            }
            expected += 1
        }
    }
    if expected != advanced {
        return Error(malformed(0u64))
    }
    Ok(take changes_by_id)
}

fn entries_of(data: PageTree, id: u32) -> Result[PageRange, Error] {
    if id == 4294967295u32 {
        return Error(malformed(0u64))
    }
    byte_cursor(data, Included(prefix(id)?), prefix(id + 1u32)?)
}

fn checksum_row(mut checksum: std.check.Xxh3, key: Bytes, encoded: Bytes) -> Result[(), Error] {
    let mut lengths: Bytes = list.with_capacity(8u64)
    capacity(le(mut lengths, list.len(key), 4u64))?
    capacity(le(mut lengths, list.len(encoded), 4u64))?
    std.check.add(mut checksum, lengths, 0u64, 8u64)
    std.check.add(mut checksum, key, 0u64, list.len(key))
    std.check.add(mut checksum, encoded, 0u64, list.len(encoded))
    Ok(())
}

fn range_inventory(data: PageTree, ranges: List[RangeChange]) -> Result[List[Inventory], Error] {
    let mut inventory: List[Inventory] = list.with_capacity(list.len(ranges))
    for desc in ranges {
        let mut cursor = entries_of(data, desc.id)?
        let mut row_total = 0u64
        let mut checksum = std.check.start()
        while let Some((key, value)) = next_bytes(mut cursor)? {
            checksum_row(mut checksum, key, value)?
            row_total += 1
        }
        list.push(mut inventory, Inventory(id: desc.id, count: row_total, digest: std.check.finish(checksum)))
    }
    Ok(take inventory)
}

pub fn validate_preparation(source: Preparation, staged: StagedMigration) -> Result[(), Error] {
    let mut state = capacity(current_state(source.db))?
    state.tips[0].roots = share_roots(staged.plan.roots)
    over_ceiling(capacity(state_account(state))?, available_resident(source.db))
}

// Ships the whole preparation; later catch-up rounds ship ROUND deltas onto it.
pub fn write_prepared(mut source: Preparation, staged: StagedMigration, d: Dir, take target: PreparedTarget) -> Result[(), DeployError] waits {
    let delta = deploy_result(catalog_changes(source.db.heads[0].roots, staged.plan.roots))?
    let ranges = deploy_result(changed_ranges(delta, source.stamp.next_table, staged.plan.next_table))?
    let inventory = deploy_result(range_inventory(staged.plan.roots.collections, ranges))?
    let base: ExportStamp = clone(source.stamp)
    let ctx = DiskContext(store: source.db.store, role: 6, seq: source.stamp.opened)
    let meta = PreparedMeta(base: take base, target: take target, next_table: staged.plan.next_table, changes: list.len(delta), ranges: list.len(inventory))
    let metadata_codec: std.codec.Codec[PreparedMeta] = std.codec.of()
    let mut encoded_meta: Bytes = list.new()
    std.codec.encode(metadata_codec, meta, mut encoded_meta) ?=> |_| Scratch(Limit(Value))
    if list.len(encoded_meta) > 1048832 {
        return Error(Scratch(Limit(Value)))
    }
    let rewrites = encode_rewrite_frame(staged)?
    let mut file = scratch_result(open_frames(d, "PREPARED", ctx))?
    let delta_codec: std.codec.Codec[CatalogChange] = std.codec.of()
    let inventory_codec: std.codec.Codec[Inventory] = std.codec.of()
    let row_codec: std.codec.Codec[PreparedRow] = std.codec.of()
    scratch_result(write_prepared_payload(mut file, 0x0081, encoded_meta))?
    for change in delta {
        scratch_result(write_prepared_frame(mut file, 0x0082, delta_codec, change))?
    }
    for desc in inventory {
        scratch_result(write_prepared_frame(mut file, 0x0083, inventory_codec, desc))?
    }
    for desc in inventory {
        let mut rows = deploy_result(entries_of(staged.plan.roots.collections, desc.id))?
        while let Some((take key, value)) = deploy_result(next_bytes(mut rows))? {
            let row = PreparedRow(key: take key, value: deploy_result(copied(value))?)
            scratch_result(write_prepared_frame(mut file, 0x0084, row_codec, row))?
        }
    }
    if let Some(raw) = rewrites {
        scratch_result(write_prepared_payload(mut file, 0x0085, raw))?
    }
    scratch_result(finish_frames(take file))?
    source.shipped = Some(ShippedImport(ranges: deploy_result(shipped_ranges(ranges))?, round: 0))
    Ok(())
}

type ValidatedRange: send {
    id: u32,
    kind: u8,
    rows: List[std.page.Row]
}

pub opaque type ValidatedImport: send {
    meta: PreparedMeta,
    delta: List[CatalogChange],
    ranges: List[ValidatedRange],
    rewrites: List[ActivationRewrite],
    digest: Inline[u8, 32],
    charge: u64
}

fn read_valid_range(mut input: PreparedInput, expected: RangeChange, desc: Inventory, codec: std.codec.Codec[PreparedRow], mut charge: u64) -> Result[ValidatedRange, DeployError] waits {
    if desc.id != expected.id {
        return Error(ImportMalformed)
    }
    let (kind, schema_number, unique) = match expected.catalog {
        Some(raw) => {
            let meta = deploy_result(decode_catalog(raw))?
            let unique = match meta.record {
                CatalogIndex(IndexRecord(shape: Entries(Unique), ..)) => true,
                _ => false,
            }
            (descriptor_kind_byte(catalog_kind(meta.record)), meta.next, unique)
        },
        None => {
            if desc.count != 0u64 {
                return Error(ImportMalformed)
            }
            (0u8, 0u16, false)
        },
    }
    if (kind == 3 || kind == 4) && desc.count != 0 {
        return Error(ImportMalformed)
    }
    let mut rows: List[std.page.Row] = list.new()
    let mut digest = std.check.start()
    for i in 0u64 .. desc.count {
        let PreparedRow(key: take key, value: take encoded) = prepared_frame(mut input, 0x0084, codec)?
        if list.len(key) < 4 || list.len(key) > 4096 || list.len(encoded) > VALUE_LIMIT {
            return Error(ImportMalformed)
        }
        let seen: u32 = list.word_be(key, 0)
        let suffix = list.slice(key, 4, list.len(key))
        if seen != desc.id || (i > 0 && !(rows[i - 1].key < suffix)) {
            return Error(ImportMalformed)
        }
        if kind == 1 {
            if list.len(encoded) < 2 || read_le(encoded, 0, 2) + 1 != int.widen(schema_number) {
                return Error(ImportMalformed)
            }
        } else if kind == 2 {
            // An index entry carries its payload: a Unique entry starts with
            // its owner's primary, and either kind may carry a projection.
            if unique {
                let owner_end = unique_owner_end(encoded) ?=> |_| ImportMalformed
                if owner_end == 4 {
                    return Error(ImportMalformed)
                }
            }
        } else if list.len(encoded) != 0 {
            return Error(ImportMalformed)
        }
        deploy_result(checksum_row(mut digest, key, encoded))?
        let row_charge = entry(key, encoded)
        charge = int.saturating_add(charge, row_charge)
        list.push(mut rows, std.page.Row(key: deploy_result(copied(suffix))?, value: take encoded, charge: row_charge))
    }
    if std.check.finish(digest) != desc.digest {
        return Error(ImportMalformed)
    }
    if kind != 0 {
        charge = int.saturating_add(charge, 126)
    }
    Ok(ValidatedRange(id: desc.id, kind: kind, rows: take rows))
}

// M1 may run in a task while OLD serves. It checks all scratch input before
// the head can reserve ids or attach the result to an attempt.
pub fn validate_prepared(d: Dir) -> Result[ValidatedImport, DeployError] waits {
    let mut file = scratch_result(disk_io(host.open(d, "PREPARED", Read)))?
    let header = scratch_result(prepared_read(mut file, 72u64))?
    let head = deploy_result(disk_read_header("PREPARED", header, 6, None, None))?
    let mut digest = std.sha256.start()
    std.sha256.add(mut digest, header, 0u64, 72u64)
    let mut input = PreparedInput(file: take file, ctx: head.context, offset: 72u64, digest: take digest)
    let metadata_codec: std.codec.Codec[PreparedMeta] = std.codec.of()
    let delta_codec: std.codec.Codec[CatalogChange] = std.codec.of()
    let inventory_codec: std.codec.Codec[Inventory] = std.codec.of()
    let row_codec: std.codec.Codec[PreparedRow] = std.codec.of()
    let meta = prepared_frame(mut input, 0x0081, metadata_codec)?
    if list.len(meta.base.attempt) != 16 || meta.base.store_hi != head.context.store.hi || meta.base.store_lo != head.context.store.lo || meta.base.opened != head.context.seq || meta.base.branch != 0 || meta.base.next_table == 0 || meta.next_table < meta.base.next_table || list.len(meta.target.digest) != 32 || list.len(meta.target.release) != 32 || list.len(meta.target.describe) == 0 {
        return Error(ImportMalformed)
    }
    let mut delta: List[CatalogChange] = list.new()
    for i in 0u64 .. meta.changes {
        let changed = prepared_frame(mut input, 0x0082, delta_codec)?
        if i != 0 && !(delta[i - 1u64].key < changed.key) {
            return Error(ImportMalformed)
        }
        validate_delta(changed, meta.base.next_table)?
        list.push(mut delta, take changed)
    }
    let needed = deploy_result(changed_ranges(delta, meta.base.next_table, meta.next_table))?
    if list.len(needed) != meta.ranges {
        return Error(ImportMalformed)
    }
    let mut inventory: List[Inventory] = list.new()
    for _ in 0u64 .. meta.ranges {
        list.push(mut inventory, prepared_frame(mut input, 0x0083, inventory_codec)?)
    }
    let mut ranges: List[ValidatedRange] = list.new()
    let mut charge = 0u64
    for i in 0u64 .. meta.ranges {
        let desc = inventory[i]
        let checked_range = read_valid_range(mut input, needed[i], desc, row_codec, mut charge)?
        list.push(mut ranges, take checked_range)
    }
    let rewrites = read_rewrite_frame(mut input)?
    let PreparedInput(file: take done, digest: take hashed, ..) = take input
    scratch_result(disk_io(host.close(take done)))?
    Ok(ValidatedImport(meta: take meta, delta: take delta, ranges: take ranges, rewrites: take rewrites, digest: std.sha256.finish(hashed), charge: charge))
}

type ImportedRange: send {
    id: u32,
    kind: u8,
    tree: Option[Arc[std.page.Page]]
}

pub opaque type Imported: send {
    meta: PreparedMeta,
    delta: List[CatalogChange],
    ranges: List[ImportedRange],
    rewrites: List[ActivationRewrite],
    digest: Inline[u8, 32]
}

pub opaque type ImportWork: send {
    payload: ValidatedImport,
    low: u64,
    high: u64,
    inline: u64
}

pub fn reserve_import(mut db: Db, take validated: ValidatedImport) -> Result[ImportWork, DeployError] {
    deploy_result(activation_install_allowed(db))?
    deploy_result(healthy(db))?
    if !is_disk(db) || validated.meta.base.opened != open_number(db) || validated.meta.base.store_hi != db.store.hi || validated.meta.base.store_lo != db.store.lo || !matches_export(db, validated.meta.base) {
        return Error(ExportMismatch)
    }
    validate_rewrite_base(db, validated)?
    let current = disk_state(db).options.resident_limit
    // An import pin still held is stale: this import's keep replaces it.
    let exact = install_account(db, share_roots(db.heads[0u64].roots))?
    let requested = int.saturating_add(exact, validated.charge)
    if requested > current {
        return Error(Store(Full(Resident(Capacity(requested: requested, available: current)))))
    }
    let low = db.next_node
    let inline = db.heads[0u64].roots.collections.inline
    let mut high = low
    for checked_range in validated.ranges {
        if checked_range.kind == 0 {
            continue
        }
        let n = list.len(checked_range.rows)
        let mut bodies = 0u64
        for row in checked_range.rows {
            if list.len(row.value) > inline {
                bodies += 1
            }
        }
        let Some(pages) = int.checked_mul(n, 2) else {
            return Error(IdBound)
        }
        let Some(with_pages) = int.checked_add(high, pages) else {
            return Error(IdBound)
        }
        let Some(end) = int.checked_add(with_pages, bodies + 1) else {
            return Error(IdBound)
        }
        high = end
    }
    if high == 18446744073709551615u64 {
        return Error(IdBound)
    }
    db.next_node = high
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        state.imported = None
        state.reserving = Some(validated.digest)
    })
    db.ceiling = current - validated.charge
    Ok(ImportWork(payload: take validated, low: low, high: high, inline: inline))
}

fn matches_export(db: Db, base: ExportStamp) -> bool {
    match disk_state(db).lease {
        Some(kept) => kept.attempt == base.attempt && kept.terminal == base.terminal && kept.end == base.end && kept.head == base.head && kept.next_table == base.next_table && kept.activation == base.activation,
        None => false,
    }
}

pub fn import_trees(take work: ImportWork) -> Result[Imported, DeployError] {
    let ImportWork(payload: take payload, low: low, high: high, inline: inline) = take work
    let ValidatedImport(meta: take meta, delta: take delta, ranges: take ranges, rewrites: take rewrites, digest: digest, ..) = take payload
    let mut ids = low + 1
    let mut imported: List[ImportedRange] = list.with_capacity(list.len(ranges))
    for checked_range in ranges {
        let built: Option[Arc[std.page.Page]] = if checked_range.kind == 0 {
            None
        } else {
            deploy_result(page_result(std.page.bulk(checked_range.rows, Collection, inline, mut ids)))?
        }
        if ids - 1 > high {
            return Error(IdBound)
        }
        list.push(mut imported, ImportedRange(id: checked_range.id, kind: checked_range.kind, tree: take built))
    }
    Ok(Imported(meta: take meta, delta: take delta, ranges: take imported, rewrites: take rewrites, digest: digest))
}

pub fn imported_digest(value: Imported) -> Inline[u8, 32] {
    value.digest
}

pub fn prepared_matches(value: ValidatedImport, describe: Bytes, release: Bytes, digest: Bytes) -> bool {
    let target = view value.meta.target
    target.describe == describe && target.release == release && target.digest == digest
}

pub fn identity_words(db: Db) -> (u64, u64) {
    (db.store.hi, db.store.lo)
}

pub type Cutover: send {
    attempt: Bytes,
    digest: Inline[u8, 32],
    deadline: u64
}

type TargetLimits {
    resident: u64,
    pack: u64,
    checkpoint: u64,
    journal: u64,
    frame: u64
}

fn catalog_bytes_equal(a: Bytes, b: Bytes) -> bool {
    a == b
}

fn planned_catalog(mut plan: SchemaPlan, delta: List[CatalogChange]) -> Result[(), DeployError] {
    for changed in delta {
        let agrees = {
            let current = get_page_row(plan.roots.catalog, changed.key)
            match changed.before {
                Some(expected) => match current {
                    Some(raw) => catalog_bytes_equal(raw, expected),
                    None => false
                },
                None => match current {
                    None => true,
                    Some(_) => false
                },
            }
        }
        if !agrees {
            return Error(ImportMalformed)
        }
        if let Some(raw) = changed.after {
            let roots = deploy_result(catalog_insert(mut plan.next_node, plan.roots, changed.key, raw))?
            plan.roots = take roots
        } else {
            deploy_result(remove_store_row(mut plan.roots.catalog, changed.key, mut plan.next_node))?
        }
    }
    Ok(())
}

fn planned_ranges(mut plan: SchemaPlan, imported: List[ImportedRange]) -> Result[(), DeployError] {
    let private_from = deploy_result(stamp_after(plan.next_node))?
    let mut next_stamp = private_from
    for replaced in imported {
        if replaced.kind == 0 {
            let _ = deploy_result(drop_collection(mut plan.roots.collections, replaced.id, private_from, mut next_stamp))?
        } else {
            let key = deploy_result(prefix(replaced.id))?
            deploy_result(put_collection(mut plan.roots.collections, key, replaced.tree, replaced.kind, private_from, mut next_stamp))?
        }
    }
    deploy_result(canonical_tree(mut plan.roots.collections))?
    plan.next_node = next_stamp - 1
    Ok(())
}

fn db_target(db: Db) -> Option[TargetLimits] {
    if is_disk(db) {
        disk_state(db).target
    } else {
        None
    }
}

fn pack_leased(lease: Option[Arc[ExportLease]], seq: u64) -> bool {
    if let Some(kept) = lease {
        for pack in kept.packs {
            if pack == seq {
                return true
            }
        }
    }
    false
}

type SegmentSpan: send {
    first: u64,
    end: u64
}

type DiskRemovals: send {
    packs: List[u64],
    before: SegmentSpan,
    after: SegmentSpan,
    name: String
}

fn removal_spans(first: u64, end: u64, lease: Option[(u64, u64)]) -> (SegmentSpan, SegmentSpan) {
    if let Some((from, through)) = lease {
        if from < end && through >= first {
            return (SegmentSpan(first: first, end: order.max(first, from)), SegmentSpan(first: order.min(end, int.saturating_add(through, 1)), end: end))
        }
    }
    (SegmentSpan(first: first, end: end), SegmentSpan(first: end, end: end))
}

fn remove_numbered(d: Dir, prefix_name: String, seq: u64, both: bool, mut name: String) -> Result[(), Error] waits {
    string.truncate(mut name, 0)
    string.push(mut name, prefix_name)
    string.push_u64(mut name, seq)
    let _ = disk_remove_optional(d, name)?
    if both {
        string.push(mut name, ".end")
        let _ = disk_remove_optional(d, name)?
    }
    Ok(())
}

fn remove_cut_files(d: Dir, take plan: DiskRemovals) -> Result[(), Error] waits {
    let DiskRemovals(packs: take packs, before: before, after: after, name: take scratch) = take plan
    let mut name = take scratch
    for seq in packs {
        remove_numbered(d, "p-", seq, false, mut name)?
    }
    for seq in before.first .. before.end {
        remove_numbered(d, "j-", seq, true, mut name)?
    }
    for seq in after.first .. after.end {
        remove_numbered(d, "j-", seq, true, mut name)?
    }
    Ok(())
}

fn disk_identity(r: Random) -> Result[StoreId, Capacity] {
    let mut raw: Bytes = list.with_capacity(16)
    host.random(r, mut raw)
    Ok(StoreId(hi: list.word_le(raw, 0), lo: list.word_le(raw, 8)))
}

// END damage loses the detection boundary, never the journal's valid prefix.
// A valid unknown MUST kind is a newer format and still refuses the open.
fn disk_read_end(file: String, id: StoreId, seq: u64, raw: Bytes) -> Result[u64, Error] {
    let header = disk_read_header(file, raw, 4, Some(seq), Some(id))?
    let mut at = 72u64
    let mut room = 0u64
    let mut found: Option[u64] = None
    while at < list.len(raw) {
        let frame = disk_read_frame(file, header.context, raw, at)?
        if frame.kind == 0x0012 {
            if let Some(_) = found {
                return Error(disk_fault(file, at, Malformed))
            }
            if frame.end - frame.payload != 8 {
                return Error(disk_fault(file, at, Malformed))
            }
            found = Some(read_le(raw, frame.payload, 8))
        } else {
            room += frame.end - at
            if room > 1048576 {
                return Error(disk_fault(file, at, Malformed))
            }
        }
        at = frame.end
    }
    match found {
        Some(value) => Ok(value),
        None => Error(disk_fault(file, 72, Malformed))
    }
}

fn disk_end(d: Dir, id: StoreId, seq: u64) -> Result[Option[u64], Error] waits {
    let path = journal_path(seq, ".end")?
    let raw = match disk_read_file(d, path, 96 + 1048576) {
        Ok(take raw) => take raw,
        Error(Io(NotFound)) => return Ok(None),
        Error(Corrupt(_)) => return Ok(None),
        Error(take e) => return Error(take e)
    }
    match disk_read_end(path, id, seq, raw) {
        Ok(value) => Ok(Some(value)),
        Error(Corrupt(_)) => Ok(None),
        Error(take e) => Error(take e)
    }
}

fn disk_exists(d: Dir, path: String) -> Result[bool, Error] waits {
    match host.open(d, path, Read) {
        Ok(take file) => {
            disk_io(host.close(take file))?;
            Ok(true)
        },
        Error(NotFound) => Ok(false),
        Error(e) => Error(Io(e))
    }
}

type PageDisk: send {
    next_pack: u64,
    locations: PageLocations,
    lists: PagedLists,
    owners: Map[IncomingEdge, u64],
    carried: List[u64],
    deferred: Option[u64],
    forked: List[LineageFork],
    compaction: TieredCompaction
}

type DiskStartup: send {
    store: StoreId,
    fence: u32,
    state: State,
    live: u64,
    tiered: u64,
    resident_pages: u64,
    uncovered: u64,
    next_node: u64,
    next_table: u32,
    generation: u64,
    cut_first: u64,
    recorded_after: u64,
    seq: u64,
    segment: HostFile,
    end_file: HostFile,
    header: Bytes,
    creation: Bytes,
    pages: PageDisk,
    limits: StoreLimits
}

fn remember_roots(mut owners: Map[IncomingEdge, u64], kind: u8, owner: u64, roots: LocatedRoots) {
    if roots.collections.stamp != 0 {
        map.insert(mut owners, HolderSource(kind, owner, 0), roots.collections.stamp)
    }
    if roots.streams.stamp != 0 {
        map.insert(mut owners, HolderSource(kind, owner, 1), roots.streams.stamp)
    }
    if roots.catalog.stamp != 0 {
        map.insert(mut owners, HolderSource(kind, owner, 2), roots.catalog.stamp)
    }
    for slot in 0u64 .. list.len(roots.keyed) {
        let stamp = roots.keyed[slot].stamp
        if stamp != 0 {
            map.insert(mut owners, HolderSource(kind, owner, int.narrow(3 + slot)), stamp)
        }
    }
}

fn located_owners(manifest: PageManifest) -> Map[IncomingEdge, u64] {
    let mut owners: Map[IncomingEdge, u64] = map.new()
    for tip in manifest.branches {
        remember_roots(mut owners, 0, int.widen(tip.id), tip.roots)
    }
    for serial in 0u64 .. list.len(manifest.pins) {
        remember_roots(mut owners, 1, serial, manifest.pins[serial].roots)
    }
    take owners
}

// The branches and then the pins, in the manifest's order, which is `all`'s.
fn manifest_state(m: PageManifest, all: List[Roots]) -> Result[State, Capacity] {
    let mut tips: List[Tip] = list.with_capacity(list.len(m.branches))
    let mut k = 0u64
    for b in m.branches {
        list.push(mut tips, Tip(id: b.id, name: string.from(b.name), parent: b.parent, forked_at: b.forked_at, roots: share_roots(all[k]), head: b.version, at: b.at))
        k += 1
    }
    let mut pins: List[Pin] = list.with_capacity(list.len(m.pins))
    for held in m.pins {
        let serial = list.len(pins)
        list.push(mut pins, Pin(owner: held.owner, name: string.from(held.name), branch: held.branch, version: held.version, serial: serial, roots: share_roots(all[k]), watermark: held.watermark))
        k += 1
    }
    Ok(State(tips: take tips, pins: take pins, next_branch: m.next_branch, next_table: m.next_table))
}

fn check_expected_store(expected: Option[StoreId], found: StoreId) -> Result[(), Error] {
    if let Some(wanted) = expected {
        if !same(wanted, found) {
            return Error(Foreign)
        }
    }
    Ok(())
}

fn disk_start(d: Dir, c: Clock, r: Random, options: Options) -> Result[DiskStartup, Error] waits {
    let selected = read_page_manifest_file(d)
    let mut loaded = match take selected {
        Ok((id, take manifest)) => {
            check_expected_store(options.expect, id)?
            check_limits(options.limits, manifest.limits)?
            let validated = select_page_manifest(d, id, take manifest)?
            let loaded = disk_loaded(id, take validated)?
            // §13.8: a catalog with a Tiered collection opens only on a funded
            // plan, refused before the journal is read or a task is started.
            if !tiered_open_funded(options) && holders_tiered(loaded.all) {
                return Error(Missing("cache_bytes"))
            }
            take loaded
        },
        Error(Io(NotFound)) => {
            if let Some(_) = options.expect {
                return Error(NotFound)
            }
            if !options.create {
                return Error(NotFound)
            }
            let id = capacity(disk_identity(r))?
            let manifest = page_manifest_empty(named_limits(options.limits))
            let mut creation = disk_creation_block()?
            let (take segment, take end_file, take header) = disk_new_segment(d, c, id, 1, 0, mut creation)?
            disk_publish_manifest(d, id, manifest)?
            let genesis = capacity(main_state(empty_roots(), 0, 0))?
            let pages = PageDisk(next_pack: 1, locations: new_page_locations(), lists: empty_paged_lists(), owners: map.new(), carried: list.new(), deferred: None, forked: list.new(), compaction: no_tiered_compaction())
            return Ok(DiskStartup(store: id, fence: 0, state: take genesis, live: 0, tiered: 0, resident_pages: 0, uncovered: 0, next_node: 0, next_table: 1, generation: 1, cut_first: 1, recorded_after: 0, seq: 1, segment: take segment, end_file: take end_file, header: take header, creation: take creation, pages: take pages, limits: named_limits(options.limits)))
        },
        Error(take problem) => return Error(take problem),
    }
    let manifested = disk_allocation(scoped fn() -> Result[State, Error] {
        capacity(manifest_state(loaded.manifest, loaded.all))
    })?
    list.clear(mut loaded.all)
    let owners = disk_allocation(scoped fn() -> Result[Map[IncomingEdge, u64], Error] {
        Ok(located_owners(loaded.manifest))
    })?
    let recorded_after = manifested.tips[0u64].head
    let initial = journal_replay_manifest(take manifested, loaded.manifest)?
    let recovered = journal_recover(d, loaded.store, loaded.manifest.first_live, c, take initial)?
    let JournalRecovered(replay: take replay, seq: last_seq, end: last_end, uncovered: uncovered) = take recovered
    let live_bytes = journal_account(replay)?
    let JournalReplay(state: take state, next_node: next_node, tiered: tiered, forked: take forked, ..) = take replay
    over_ceiling(live_bytes, options.resident_limit)?
    let resident_pages = disk_allocation(scoped fn() -> Result[u64, Error] {
        let roots = capacity(state_roots(state))?
        Ok(int.saturating_add(resident_images(roots, Some(view loaded.lists)), location_storage_charge(loaded.locations)))
    })?
    let Some(seq) = int.checked_add(last_seq, 1) else {
        return Error(Limit(Ids))
    }
    // Fence the removal of an orphan END before making its successor HEADER.
    let orphan_end = capacity(disk_path("j-", seq, ".end"))?
    let _ = disk_remove_optional(d, orphan_end)?
    disk_io(host.sync_dir(d))?
    let mut creation = disk_creation_block()?
    let (take segment, take end_file, take header) = disk_new_segment(d, c, loaded.store, seq, last_end, mut creation)?
    let DiskLoaded(store: id, manifest: take manifest, lists: take lists, locations: take locations, ..) = take loaded
    let pages = PageDisk(next_pack: manifest.next_pack, locations: take locations, lists: take lists, owners: take owners, carried: list.new(), deferred: None, forked: take forked, compaction: no_tiered_compaction())
    Ok(DiskStartup(store: id, fence: manifest.fence, state: take state, live: live_bytes, tiered: tiered.total, resident_pages: resident_pages, uncovered: uncovered, next_node: next_node, next_table: manifest.next_table, generation: manifest.generation, cut_first: manifest.first_live, recorded_after: recorded_after, seq: seq, segment: take segment, end_file: take end_file, header: take header, creation: take creation, pages: take pages, limits: manifest.limits))
}

type DiskSession {
    lock: HostFile,
    startup: DiskStartup
}

fn disk_lock(d: Dir, c: Clock, wait_ms: u64) -> Result[HostFile, Error] waits {
    let mut lock = disk_io(host.open(d, "LOCK", Write))?
    if disk_io(host.try_lock(mut lock))? {
        return Ok(take lock)
    }
    if wait_ms == 0 {
        return Error(Held)
    }
    let deadline = std.clock.deadline_after_ms(host.mono_ns(c), wait_ms)
    loop {
        let now = host.mono_ns(c)
        if now >= deadline {
            return Error(Held)
        }
        let poll = int.saturating_add(now, 1000000)
        host.sleep_until(c, if poll < deadline {
            poll
        } else {
            deadline
        })
        if disk_io(host.try_lock(mut lock))? {
            return Ok(take lock)
        }
    }
}

fn disk_session(d: Dir, clock: Clock, r: Random, options: Options) -> Result[DiskSession, Error] waits {
    if disk_exists(d, "MANIFEST")? {
        let mut manifest_file = disk_io(host.open(d, "MANIFEST", Read))?
        check_page_manifest_header(mut manifest_file)?
        disk_io(host.close(take manifest_file))?
    }
    let lock = disk_lock(d, clock, options.lock_wait_ms)?
    if disk_exists(d, "EXPORT")? {
        return Error(ExportDirectory)
    }
    let startup = disk_start(d, clock, r, options)?
    Ok(DiskSession(lock: take lock, startup: take startup))
}

type DiskState {
    lock: Option[HostFile],
    d: Option[Dir],
    open: u64,
    options: Options,
    lease: Option[Arc[ExportLease]],
    // The schema commits main published since the lease last moved
    // (§3.5a "Catch-up"): they reach the child as the round's STEPS.
    steps: List[LeaseStep],
    scrubs: List[Arc[ScrubLease]],
    imported: Option[KeptImport],
    reserving: Option[Inline[u8, 32]],
    target: Option[TargetLimits],
    record_cut: u64,
    recorded_after: u64,
    pages: PageDisk,
    object: Option[ObjectWriterState],
    acks: Receiver[Ack],
    journaled: u64,
    inflight: u64,
    uncovered: u64,
    since_cut: u64,
    tiered_dirty: TieredDirty,
    acked_bytes: u64,
    written: Receiver[WriteNotice],
    written_send: Sender[WriteNotice],
    // One coalesced notice after each journal group sync or failure, for a
    // writer that releases replies while later commits run (sync_notices).
    synced: Option[Receiver[()]],
    poison: Option[IoError],
    journal: Sender[JournalMsg],
    pending: Option[Bytes],
    journal_task: Task[Result[(), Error]],
    journal_idle_task: Option[Task[()]],
    creation: Bytes,
    // The pager of a store with a Tiered collection (§13.8), started from `tasks`; `restamp` and
    // `unload` name the collection a `set_residency` cut moves to Tiered or to Memory on main.
    pager_task: Option[Task[()]],
    tasks: Tasks,
    restamp: Option[u32],
    unload: Option[u32]
}

fn open_number(db: Db) -> u64 {
    if is_disk(db) {
        disk_state(db).open
    } else {
        0u64
    }
}

// A main-branch record at or before this version is below the live journal.
pub fn retained_main_after(db: Db) -> u64 {
    if is_disk(db) {
        disk_state(db).recorded_after
    } else {
        0u64
    }
}

fn healthy(db: Db) -> Result[(), Error] {
    match journal_poison(db) {
        Some(e) => Error(Poisoned(e)),
        None => object_writer_healthy(db),
    }
}

fn open_heads(mut db: Db, take state: State) -> Result[(), Error] {
    let State(tips: take tips, pins: take pins, next_branch: next_branch, next_table: _) = take state
    let mut heads: List[Head] = list.new()
    let mut names: Map[String, u32] = map.new()
    capacity(list.try_reserve(mut heads, list.len(tips)))?
    capacity(map.try_reserve(mut names, list.len(tips) - 1))?
    let mut total = 0u64
    for take t in take tips {
        let Tip(id: br, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: head, at: at) = take t
        total += branch_root_bytes(name, roots)
        if br != 0 {
            let key = disk_allocation(scoped fn() -> Result[String, Error] {
                named(name)
            })?
            map.insert(mut names, take key, br)
        }
        list.push(mut heads, Head(id: br, name: take name, parent: parent, forked_at: forked_at, roots: take roots, head: head, at: at, following: None))
    }
    db.heads = take heads
    db.branch_names = take names
    for stored in pins {
        total += pin_root_bytes(stored.name, stored.roots)
    }
    db.record_bytes = total
    db.next_pin = list.len(pins)
    db.pins = take pins
    db.bases = tail_bases(db.pins)
    db.next_branch = next_branch
    Ok(())
}

type JournalChannels {
    frames: Sender[JournalMsg],
    queued: Receiver[JournalMsg],
    acks: Sender[Ack],
    received: Receiver[Ack],
    ready: Sender[Result[(), Capacity]],
    waiting: Receiver[Result[(), Capacity]],
    written_send: Sender[WriteNotice],
    written_receive: Receiver[WriteNotice],
    synced_send: Sender[()],
    synced_receive: Receiver[()]
}

fn journal_channels(group_count: u64) -> JournalChannels {
    let (frames, queued): (Sender[JournalMsg], Receiver[JournalMsg]) = channel.new(group_count * 2)
    // One ack per frame, for the queued and grouped frames, the handoff
    // and byte-split frames, and a final failure (Y1).
    let (acks, received): (Sender[Ack], Receiver[Ack]) = channel.new(group_count * 3 + 3)
    let (ready, waiting): (Sender[Result[(), Capacity]], Receiver[Result[(), Capacity]]) = channel.new(1)
    let (written_send, written_receive): (Sender[WriteNotice], Receiver[WriteNotice]) = channel.new(2)
    let (synced_send, synced_receive): (Sender[()], Receiver[()]) = channel.new(1)
    JournalChannels(frames: take frames, queued: take queued, acks: take acks, received: take received, ready: take ready, waiting: take waiting, written_send: take written_send, written_receive: take written_receive, synced_send: take synced_send, synced_receive: take synced_receive)
}

// S3 makes the disk opener public with its journal and final durability path.
/// Opens a Directory store. An object store opens with `open_authority`.
pub fn open(tasks: Tasks, d: Dir, c: Clock, r: Random, options: Options) -> Result[Db, Error] waits {
    if let Bucket(_) = options.authority {
        return Error(Unsupported(1))
    }
    open_checks(options)?
    let session = disk_session(d, c, r, options)?
    open_started(tasks, d, c, options, take session)
}

/// Captures an existing Directory store. The clock drives the terminal
/// segment fence wait if a dead writer still has a write in flight.
pub fn open_read_only(d: Dir, c: Clock, options: Options) -> Result[ReadOnly, Error] waits {
    if let Bucket(_) = options.authority {
        return Error(Unsupported(1))
    }
    open_checks(options)?
    let mut restarted = false
    loop {
        let (take raw, id, take manifest) = read_only_manifest(d)?
        check_expected_store(options.expect, id)?
        check_limits(options.limits, manifest.limits)?
        let candidate = capture_walk(d, id, manifest.first_live, restarted)?
        let Some(take selected) = take candidate else {
            restarted = true
            continue
        }
        let mut walk = take selected
        capture_fence(d, c, 18446744073709551615u64, mut walk)?
        disk_io(host.sync_dir(d))?
        if read_page_manifest_bytes(d)? != raw {
            restarted = false
            continue
        }
        let initial = read_only_checkpoint(d, id, take manifest)?
        let replay = capture_scan(id, take walk, take initial)?
        over_ceiling(journal_account(replay)?, options.resident_limit)?
        let main = view replay.state.tips[0u64]
        return Ok(ReadOnly(snapshot: Snapshot(store: id, open: 0, branch: 0, head: main.head, roots: share_roots(main.roots), watermark: stamp_after(replay.next_node)?, bases: no_tail_bases())))
    }
}

fn read_only_manifest(d: Dir) -> Result[(Bytes, StoreId, PageManifest), Error] waits {
    if disk_exists(d, "EXPORT")? {
        return Error(ExportDirectory)
    }
    let raw = match read_page_manifest_bytes(d) {
        Ok(take found) => take found,
        Error(Io(NotFound)) => return Error(NotFound),
        Error(take problem) => return Error(take problem),
    }
    let (id, take manifest) = disk_allocation(scoped fn() -> Result[(StoreId, PageManifest), Error] {
        disk_read_page_manifest("MANIFEST", raw)
    })?
    Ok((take raw, id, take manifest))
}

fn check_read_only_manifest(d: Dir, raw: Bytes) -> Result[(), Error] waits {
    if read_page_manifest_bytes(d)? != raw {
        return Error(Held)
    }
    Ok(())
}

fn open_checks(options: Options) -> Result[(), Error] {
    if options.group_commits == 0 {
        return Error(Missing("group_commits"))
    }
    if options.group_bytes == 0 {
        return Error(Missing("group_bytes"))
    }
    check_named_limits(options.limits)?
    // Before the MANIFEST is read, the floor uses the named limits or the ceilings.
    if let Some(problem) = journal_floor(options.checkpoint_bytes, options.journal_limit, named_limits(options.limits).frame) {
        return Error(Full(Journal(problem)))
    }
    Ok(())
}

fn open_started(tasks: Tasks, d: Dir, c: Clock, options: Options, take session: DiskSession) -> Result[Db, Error] waits {
    let DiskSession(lock: take lock, startup: take startup) = take session
    let zero_extension = disk_io(host.zero_extension(d))?
    let DiskStartup(store: id, fence: fence, state: take state, live: live_bytes, tiered: tiered, resident_pages: resident_pages, uncovered: uncovered, next_node: next_node, next_table: next_table, generation: generation, cut_first: cut_first, recorded_after: recorded_after, seq: seq, segment: take segment, end_file: take end_file, header: take header, creation: take creation, pages: take pages, limits: limits) = take startup
    let mut db = disk_allocation(scoped fn() -> Result[Db, Error] {
        Ok(empty_db(c, id, options))
    })?
    open_heads(mut db, take state)?
    db.resident = live_bytes
    rebuild_keyed_credit(mut db, uncovered, options.journal_limit)?
    // The pager starts before the journal tasks, so a refusal leaves none. It
    // reserves C + K + P (§1.1); a queued Cold frame needs it to drain (§13.6).
    let pager_task: Option[Task[()]] = if store_has_tiered(db) || std.page.count(std.page.image_of(pages.lists.deferred)) != 0 {
        let funding = TieredPagerFunding(cache_bytes: options.cache_bytes, writer_pin_bytes: options.writer_pin_bytes, pager_task_bytes: options.pager_task_bytes, cut_pins: true)
        let link = start_tiered_pager_link(tasks, id, seq, PagerDirectory(d), funding, TIERED_PAGER_QUEUE)?
        Some(attach_tiered_pager(mut db, take link))
    } else {
        None
    }
    db.fence = fence
    db.limits = limits
    db.next_node = next_node
    db.next_table = next_table
    db.file_seq = seq
    db.tiered = tiered
    db.page_resident = resident_pages
    db.checkpointed = generation
    let channels = disk_allocation(scoped fn() -> Result[JournalChannels, Error] {
        Ok(journal_channels(int.widen(options.group_commits)))
    })?
    let JournalChannels(frames: take frames, queued: take queued, acks: take journal_acks, received: take journal_received, ready: take ready, waiting: take waiting, written_send: take written_send, written_receive: take written_receive, synced_send: take synced_send, synced_receive: take synced_receive) = take channels
    let reserve = journal_group_room(int.widen(options.group_bytes))
    let input = JournalWorker(store: id, seq: seq, segment: take segment, end_file: take end_file, header: take header, group_commits: options.group_commits, group_bytes: options.group_bytes, zero_extension: zero_extension, receive: take queued, send: take journal_acks, ready: take ready, written: channel.sender(written_send), synced: take synced_send)
    let writer = match task.try_spawn(tasks, bytes reserve + JOURNAL_WORKER_SLACK, take input, journal_worker) {
        Ok(take running) => take running,
        Error((problem, _)) => return Error(Full(Allocation(problem))),
    }
    capacity(result.unwrap(channel.receive(waiting)))?
    db.disk = Some(DiskState(lock: Some(take lock), d: Some(d), open: seq, options: clone(options), lease: None, steps: list.new(), scrubs: list.new(), imported: None, reserving: None, target: None, record_cut: cut_first, recorded_after: recorded_after, pages: take pages, object: None, acks: take journal_received, journaled: 0, inflight: 0, uncovered: uncovered, since_cut: 0, tiered_dirty: clean_tiered_cut(), acked_bytes: 0, written: take written_receive, written_send: take written_send, synced: Some(take synced_receive), poison: None, journal: take frames, pending: None, journal_task: take writer, journal_idle_task: None, creation: take creation, pager_task: take pager_task, tasks, restamp: None, unload: None))
    Ok(take db)
}

fn disk_wait_cut(db: Db, generation: u64) -> Result[(), Error] {
    healthy(db)?
    if db.checkpointed < generation {
        return Error(Foreign)
    }
    Ok(())
}

fn disk_rotate(mut db: Db, id: StoreId, seq: u64, previous: u64) -> Result[(), Error] waits {
    let d = log_directory(db)?
    let c = db.clock
    let (take segment, take end_file, take header) = if let Some(mut storage) = db.disk {
        disk_new_segment(d, c, id, seq, previous, mut storage.creation)?
    } else {
        return Error(Foreign)
    }
    let closed = match channel.send(disk_state(db).journal, Rotate(take segment, take end_file, take header)) {
        Ok(()) => false,
        Error(_) => true,
    }
    if closed {
        // The task sends Broken before ending. Preserve that first error.
        loop {
            let ack = journal_receive(db);
            journal_ack(mut db, take ack)?
        }
    }
    journal_poll(mut db)
}

fn cut_io_error(mut db: Db, take problem: Error) -> Error {
    match take problem {
        Io(e) => {
            edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Error {
                if let None = state.poison {
                    state.poison = Some(e)
                }
                Poisoned(option.unwrap(state.poison))
            })
        },
        other => take other,
    }
}

type PreparedDiskCut {
    pages: PageDisk,
    removals: DiskRemovals,
    manifest: Bytes
}

type CutTiming {
    pause_ns: u64,
    removal_ns: u64,
    removal_attempts: u64,
    drain_groups: u64
}

fn disk_cut_timed(mut db: Db, take delta: HolderDelta, write_seal: scoped fn(mut Bytes, DiskContext, u32) -> Result[(), Error] waits, mut timing: Option[CutTiming]) -> Result[Ticket, Error] waits {
    let target = db_target(db)
    let pack_bytes = match target {
        Some(wanted) => wanted.pack,
        None => disk_state(db).options.pack_bytes,
    }
    let limit = cut_output_bytes(pack_bytes, db.limits)
    disk_cut_with_limit(mut db, take delta, write_seal, target, pack_bytes, limit, mut timing)
}

fn disk_cut_with_limit(mut db: Db, take requested: HolderDelta, write_seal: scoped fn(mut Bytes, DiskContext, u32) -> Result[(), Error] waits, target: Option[TargetLimits], pack_bytes: u64, limit: u64, mut timing: Option[CutTiming]) -> Result[Ticket, Error] waits {
    let mut delta = take requested
    if let NoHolderChange = delta {
        if let Some(slot) = orphan_import_pin(db) {
            delta = RemovePin(slot)
        }
    }
    healthy(db)?
    if object_writer_open(db) {
        return object_cut_state(mut db, take delta, write_seal, target, pack_bytes, limit)
    }
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        state.since_cut = 0
    })
    let final_item = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    let observe = match timing {
        Some(_) => true,
        None => false,
    }
    let started = if observe {
        host.mono_ns(db.clock)
    } else {
        0
    }
    let drain_groups = durable_groups(mut db, final_item)?
    let Some(generation) = int.checked_add(db.checkpointed, 1) else {
        return Error(Limit(Ids))
    }
    let Some(seq) = int.checked_add(db.file_seq, 1) else {
        return Error(Limit(Ids))
    }
    let id = db.store
    prepare_holder_slot(mut db, delta)?
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        prune_scrubs(mut state.scrubs)
        prune_tiered_leases(mut state.pages.compaction.held)
    })
    let participants = disk_allocation(scoped fn() -> Result[CutParticipants, Error] {
        cut_participants(db, delta)
    })?
    let CutParticipants(holders: take participants_held, roots: take roots, branches: take branches, heads: heads, promote: promote) = take participants
    let mut staged = stage_tiered_cut(db, take roots, branches, heads, promote, pack_bytes)?
    db.next_node = staged.stamp_end - 1
    raise_materialized_pin(mut delta, staged)
    let holders = sealed_cut_holders(take participants_held, staged)?
    let mut base = page_retry_base(disk_state(db).pages.locations, disk_state(db).pages.owners, holders, staged.roots)?
    list_tiered_cut(mut base.locations, staged)?
    let lineage_rows = settle_lineage_kills(cut_lineage_rows(db, delta, branches, staged.queue.added)?, db, delta, staged.queue, mut base.locations.packs)?
    over_ceiling(base.account, available_resident(db))?
    let manifest_bytes = cut_manifest_size(db, delta)
    let d = log_directory(db)?
    let mut next_stamp = stamp_after(db.next_node)?
    let prev_first = match disk_state(db).pages.deferred {
        Some(low) => low,
        None => disk_state(db).record_cut,
    }
    let attempt = prepare_page_cut(base.locations, mut next_stamp, scoped fn(marks: Map[u64, ()], relocated: Option[View[core.Log[bool]]], mut stamp: u64) -> Result[PreparedDiskCut, Error] waits {
        let cut_plan = {
            let installed = disk_state(db).pages
            plan_page_cut(base, holders, installed.lists, staged.queue, lineage_rows, Some(view installed.carried), staged.next_pack, pack_bytes, marks, relocated, mut stamp)?
        }
        let mut buffers = cut_output_buffers(cut_plan, manifest_bytes, limit)?
        // A retry after emission reuses the segment created by the first attempt.
        if db.file_seq != seq {
            let previous = db.file_end
            disk_rotate(mut db, id, seq, previous)?
            db.file_seq = seq
            db.file_end = 72
        }
        write_tiered_cut(d, staged, mut buffers)?
        let layout = write_page_cut(d, id, take cut_plan, mut buffers)?
        let PackBuffers(out: take out, ..) = take buffers
        let mut manifest = take out
        let (take pages, take removals) = disk_allocation(scoped fn() -> Result[(PageDisk, DiskRemovals), Error] {
            cut_retirement(layout, holders, disk_state(db).lease, disk_state(db).scrubs, staged.compaction, prev_first, seq)
        })?
        fill_cut_manifest(mut manifest, db, delta, staged.roots, generation, seq, prev_first, layout, stamp, base.account, write_seal)?
        Ok(PreparedDiskCut(pages: take pages, removals: take removals, manifest: take manifest))
    })
    db.next_node = next_stamp - 1
    let prepared = match take attempt {
        Ok(take cut) => take cut,
        Error(take problem) => return Error(cut_io_error(mut db, take problem)),
    }
    let PreparedDiskCut(pages: take pages, removals: take removals, manifest: take manifest) = take prepared
    let settled_tiered = prepare_tiered_install(mut staged, pages.locations, generation, next_stamp)?
    // The records name exactly the frames reachable from the participants
    // and the two list roots, so their running charge is the AP15 report.
    let resident_pages = resident_location_charge(pages.locations)
    validate_cut_pages(d, id, manifest, target, disk_state(db).lease, disk_state(db).pages)?
    if let Error(take problem) = publish_page_manifest_bytes(d, manifest) {
        return Error(cut_io_error(mut db, take problem))
    }
    let recorded_after = match delta {
        ReplaceMain(main, _) => main.head,
        _ => db.heads[0u64].head
    }
    write_disk(mut db.disk, take pages, scoped fn(mut state: DiskState, take installed: PageDisk) {
        state.pages = take installed
        state.record_cut = seq
        state.recorded_after = recorded_after
        state.uncovered = 0
        // Step 5: the lists' rows are now queue rows of the published generation.
        state.tiered_dirty = clean_tiered_cut()
    })
    db.checkpointed = generation
    db.resident = base.account
    db.tiered = settled_tiered
    db.page_resident = resident_pages
    db.settled = db.changes
    let step_before = leased_step_base(db, delta)
    let held_delta = install_tiered_holders(mut db, take delta, take staged)
    install_holder_delta(mut db, take held_delta)
    record_leased_step(mut db, take step_before)
    let installed = if observe {
        host.mono_ns(db.clock)
    } else {
        0
    }
    let removals_count = if observe {
        list.len(removals.packs) + 2 * (removals.before.end - removals.before.first + removals.after.end - removals.after.first)
    } else {
        0
    }
    if let Error(take problem) = remove_cut_files(d, take removals) {
        return Error(cut_io_error(mut db, take problem))
    }
    if observe {
        timing = Some(CutTiming(pause_ns: installed - started, removal_ns: host.mono_ns(db.clock) - installed, removal_attempts: removals_count, drain_groups: drain_groups))
    }
    Ok(Ticket(store: id, open: open_number(db), mark: Cut(generation)))
}

pub fn checkpoint(mut db: Db) -> Result[Ticket, Error] waits {
    healthy(db)?
    cut_install(mut db, NoHolderChange)
}

// S3 journal payloads are decoded exactly before their effects are applied.
pub type CallRecord: codec + shareable + send {
    key: Bytes,
    args: Bytes,
    stream: StreamKey,
    // AD1: code.revision of the entry that ran, exactly 32 bytes; None only
    // when the program was assembled without revisions. Never 32 zero bytes.
    revision: Option[Bytes],
    // The code that ran: u64 n ‖ u64 s, big-endian, then the replay identity
    // (32 bytes, or none when the launch has no identity), RUNNER-SPEC §7.
    code: Bytes
}

pub type StopKind: key = Raised | OutOfSteps(u64) | OutOfBytes | Conflict

// The CALL carries the original execution context only when a later frame
// settles the call. An inline reply uses the context of its own frame.
type Settlement: shareable + send {
    way: u8,
    base: u64,
    at: u64,
    seed: u64,
    stop: Option[StopKind]
}

type CallSection: shareable + send {
    record: CallRecord,
    settlement: Option[Settlement]
}

pub type Recorded {
    record: CallRecord,
    settle: u8,
    branch: Branch,
    base: u64,
    at: u64,
    seed: u64,
    stop: Option[StopKind]
}

// AD1: the CALL revision check. A Some that is not code.revision's 32 bytes is refused
// before anything is committed.
fn call_checked(c: CallRecord) -> Result[(), Error] {
    if let Some(r) = c.revision {
        if list.len(r) != 32 {
            return Error(Missing("revision"))
        }
    }
    if !call_code_size(list.len(c.code)) {
        return Error(Missing("code"))
    }
    Ok(())
}

fn check_completion_record(complete: Completion, rec: Option[CallRecord]) -> Result[(), Error] {
    if let Some(c) = rec {
        if let Some(_) = complete.keyed {
            return Error(Foreign)
        }
        if !stream_record_matches(complete.stream, c.stream) {
            return Error(Foreign)
        }
        call_checked(c)?
    }
    Ok(())
}

fn call_code_size(size: u64) -> bool {
    size == 16 || size == 48
}

type JournalTrim: shareable + send {
    floor: u64,
    dropped: u64
}

type JournalOp: shareable + send {
    key: Bytes,
    value: Option[Bytes],
    prior: u32,
    trim: Option[JournalTrim]
}

type JournalCommit {
    branch: u32,
    version: u64,
    at: u64,
    data: List[JournalOp],
    streams: List[JournalOp],
    keyed: List[KeyedEdit],
    call: Option[CallSection],
    // The COMMIT payload's length, checked against the recorded limits.
    payload: u64
}

type JournalFork {
    id: u32,
    parent: u32,
    forked_at: u64,
    name: String,
    watermark: u64
}

type JournalEvent = Commit(JournalCommit) | Fork(JournalFork)

fn journal_event_kind(kind: u16) -> bool {
    kind == 0x0011 || kind == 0x0013
}

fn journal_ops(file: String, raw: Bytes, stream: bool, mut at: u64, mut call: Option[CallSection]) -> Result[List[JournalOp], Error] {
    let operation_count = disk_count(file, raw, mut at, if stream {
        5u64
    } else {
        9u64
    })?
    let mut ops: List[JournalOp] = list.new()
    let value_limit = if stream {
        1048576u64
    } else {
        FORMAT_VALUE_MAX
    }
    for i in 0u64 .. operation_count {
        let op_at = at
        let kind = disk_number(file, raw, mut at, 1)?
        if kind == 3 && !stream {
            if list.len(raw) - at < 20 {
                return Error(disk_fault(file, op_at, Malformed))
            }
            let key = copied(list.slice(raw, at, at + 4))?
            let floor = word_be(raw, at + 4)
            let dropped = word_be(raw, at + 12)
            at += 20
            list.push(mut ops, JournalOp(key: take key, value: None, prior: 0, trim: Some(JournalTrim(floor: floor, dropped: dropped))))
            continue
        }
        if kind < 1 || kind > 3 {
            return Error(disk_fault(file, op_at, Malformed))
        }
        let key = disk_blob(file, raw, mut at, 4096)?
        let prior = if stream {
            0u64
        } else {
            disk_number(file, raw, mut at, 4)?
        }
        if prior > FORMAT_VALUE_MAX + 1 {
            return Error(disk_fault(file, op_at, Malformed))
        }
        let value: Option[Bytes] = if kind == 2 {
            None
        } else {
            let stored = disk_blob(file, raw, mut at, value_limit)?
            if kind == 3 {
                if let Some(_) = call {
                    return Error(disk_fault(file, op_at, Malformed))
                }
                if list.len(stored) < 41 || stored[40] != 2 {
                    return Error(disk_fault(file, op_at, Malformed))
                }
                call = Some(decode_call(file, raw, mut at, copied(key)?)?)
            }
            Some(take stored)
        }
        list.push(mut ops, JournalOp(key: take key, value: take value, prior: int.truncate(prior), trim: None))
    }
    Ok(take ops)
}

fn decode_settlement(file: String, raw: Bytes, mut at: u64, way: u8) -> Result[Settlement, Error] {
    if list.len(raw) - at < 24 {
        return Error(disk_fault(file, at, Malformed))
    }
    let base = word_be(raw, at)
    let wall = word_be(raw, at + 8)
    let seed = word_be(raw, at + 16)
    at += 24
    let stop: Option[StopKind] = if way == 1 {
        if at == list.len(raw) {
            return Error(disk_fault(file, at, Malformed))
        }
        let tag = raw[at]
        at += 1
        match tag {
            1 => Some(Raised),
            2 => {
                if list.len(raw) - at < 8 {
                    return Error(disk_fault(file, at, Malformed))
                }
                let steps = word_be(raw, at)
                at += 8
                Some(OutOfSteps(steps))
            },
            3 => Some(OutOfBytes),
            4 => Some(Conflict),
            _ => return Error(disk_fault(file, at - 1, Malformed)),
        }
    } else {
        None
    }
    Ok(Settlement(way: way, base: base, at: wall, seed: seed, stop: stop))
}

fn journal_decode_commit(file: String, raw: Bytes) -> Result[JournalCommit, Error] {
    let mut at = 0u64
    let br: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let head = disk_number(file, raw, mut at, 8)?
    let wall = disk_number(file, raw, mut at, 8)?
    let sections = disk_number(file, raw, mut at, 1)?
    if sections == 0 || sections > 4 {
        return Error(disk_fault(file, at - 1, Malformed))
    }
    let mut data: List[JournalOp] = list.new()
    let mut streams: List[JournalOp] = list.new()
    let mut keyed: List[KeyedEdit] = list.new()
    let mut call: Option[CallSection] = None
    let mut previous_tag: Option[u64] = None
    for _ in 0u64 .. sections {
        let tag = disk_number(file, raw, mut at, 1)?
        if tag > 3u64 || (if let Some(prior_tag) = previous_tag {
            tag <= prior_tag
        } else {
            false
        }) {
            return Error(disk_fault(file, at - 1, Malformed))
        }
        previous_tag = Some(tag)
        match tag {
            0 => {
                data = journal_ops(file, raw, false, mut at, mut call)?
            },
            1 => {
                streams = journal_ops(file, raw, true, mut at, mut call)?
                for operation in streams {
                    if list.len(operation.key) == 0u64 {
                        return Error(disk_fault(file, at, Malformed))
                    }
                }
            },
            2 => {
                let mut no_call: Option[CallSection] = None
                let mut control_rows = journal_ops(file, raw, true, mut at, mut no_call)?
                if list.len(control_rows) != 1u64 || list.len(control_rows[0u64].key) != 0u64 {
                    return Error(disk_fault(file, at, Malformed))
                }
                if let Some(_) = no_call {
                    return Error(disk_fault(file, at, Malformed))
                }
                let row = option.unwrap(list.pop(mut control_rows))
                {
                    let Some(control) = view row.value else {
                        return Error(disk_fault(file, at, Malformed))
                    }
                    let _ = decode_stream_control(control) ?=> |_| disk_fault(file, at, Malformed)
                }
                list.insert(mut streams, 0u64, take row)
            },
            _ => {
                if br != 0 {
                    return Error(disk_fault(file, at, Malformed))
                }
                keyed = decode_keyed_edits(file, raw, mut at)?
            },
        }
    }
    if at != list.len(raw) {
        return Error(disk_fault(file, at, Malformed))
    }
    if let Some(c) = call {
        let mut matching = 0u64
        for op in streams {
            if stream_record_matches(op.key, c.record.stream) {
                matching += 1
            }
        }
        if matching != 1 {
            return Error(disk_fault(file, at, Malformed))
        }
    }
    Ok(JournalCommit(branch: br, version: head, at: wall, data: take data, streams: take streams, keyed: take keyed, call: take call, payload: list.len(raw)))
}

fn journal_decode(file: String, kind: u16, raw: Bytes) -> Result[JournalEvent, Error] {
    if kind == 0x0011 {
        return Ok(Commit(journal_decode_commit(file, raw)?))
    }
    let mut at = 0u64
    let id: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let parent: u32 = int.truncate(disk_number(file, raw, mut at, 4)?)
    let forked_at = disk_number(file, raw, mut at, 8)?
    let name = disk_name(file, raw, mut at)?
    let watermark = disk_number(file, raw, mut at, 8)?
    if at != list.len(raw) || watermark == 0 {
        return Error(disk_fault(file, at, Malformed))
    }
    Ok(Fork(JournalFork(id: id, parent: parent, forked_at: forked_at, name: take name, watermark: watermark)))
}

fn journal_torn(why: Why) -> bool {
    match why {
        Truncated => true,
        Flags => true,
        Checksum => true,
        Malformed => true,
        Kind(0) => true,
        _ => false,
    }
}

type JournalInput {
    file: HostFile,
    size: u64,
    base: u64,
    chunk: Bytes
}

fn journal_input(take file: HostFile, flush: bool) -> Result[JournalInput, Error] waits {
    let mut opened = take file
    if flush {
        disk_io(host.sync(mut opened))?
    }
    let file_stat = disk_io(host.stat_file(mut opened))?
    let chunk = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(JOURNAL_CHUNK_BYTES))
    })?
    Ok(JournalInput(file: take opened, size: file_stat.size, base: 0, chunk: take chunk))
}

fn journal_chunk(mut input: JournalInput, path: String, offset: u64) -> Result[u64, Error] waits {
    if offset >= input.base && offset - input.base < list.len(input.chunk) {
        return Ok(offset - input.base)
    }
    list.clear(mut input.chunk)
    if disk_io(host.read_at(mut input.file, offset, mut input.chunk))? == 0 {
        return Error(disk_fault(path, offset, Truncated))
    }
    input.base = offset
    Ok(0u64)
}

fn journal_prefix(mut input: JournalInput, path: String, offset: u64, width: u64) -> Result[Bytes, Error] waits {
    if offset > input.size || width > input.size - offset {
        return Error(disk_fault(path, offset, Truncated))
    }
    let mut spent = 0u64
    journal_read_prefix(mut input, path, offset, width, mut spent)
}

fn journal_read_prefix(mut input: JournalInput, path: String, offset: u64, width: u64, mut spent: u64) -> Result[Bytes, Error] waits {
    let mut raw = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(width))
    })?
    while list.len(raw) < width {
        let start = journal_chunk(mut input, path, offset + list.len(raw))?
        let part = order.min(width - list.len(raw), list.len(input.chunk) - start)
        list.append(mut raw, list.slice(input.chunk, start, start + part))
        spent = int.saturating_add(spent, part)
    }
    Ok(take raw)
}

type JournalFrame {
    end: u64,
    kind: u16,
    payload: Option[Bytes]
}

fn journal_read_frame(mut input: JournalInput, path: String, context: DiskContext, offset: u64) -> Result[JournalFrame, Error] waits {
    let head = journal_prefix(mut input, path, offset, 16)?
    let frame = disk_read_frame_head(path, head, offset)?
    let keep = journal_event_kind(frame.kind)
    let payload = disk_stream_payload(mut input, path, context, offset, head, frame, if keep {
        frame.size
    } else {
        0
    })?
    disk_check_frame_kind(path, context, frame.kind, frame.flags, offset)?
    let event_payload: Option[Bytes] = if keep {
        Some(take payload)
    } else {
        None
    }
    Ok(JournalFrame(end: offset + 16 + frame.size, kind: frame.kind, payload: take event_payload))
}

fn disk_stream_payload(mut input: JournalInput, path: String, context: DiskContext, offset: u64, head: Bytes, frame: DiskFrameHead, keep: u64) -> Result[Bytes, Error] waits {
    let mut spent = 0u64
    disk_stream_payload_counted(mut input, path, context, offset, head, frame, keep, mut spent)
}

fn disk_stream_payload_counted(mut input: JournalInput, path: String, context: DiskContext, offset: u64, head: Bytes, frame: DiskFrameHead, keep: u64, mut spent: u64) -> Result[Bytes, Error] waits {
    if frame.size > input.size - offset - 16 {
        return Error(disk_fault(path, offset, Truncated))
    }
    let mut check = disk_allocation(scoped fn() -> Result[std.check.Xxh3, Error] {
        capacity(disk_check_start(context, offset, head))
    })?
    let mut payload = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(keep))
    })?
    let end = offset + 16 + frame.size
    let mut at = offset + 16
    while at < end {
        let start = journal_chunk(mut input, path, at)?
        let part = order.min(end - at, list.len(input.chunk) - start)
        std.check.add(mut check, input.chunk, start, start + part)
        if list.len(payload) < keep {
            let capture = order.min(part, keep - list.len(payload))
            list.append(mut payload, list.slice(input.chunk, start, start + capture))
        }
        at += part
        spent = int.saturating_add(spent, part)
    }
    if std.check.finish(check) != frame.checksum {
        return Error(disk_fault(path, offset, Checksum))
    }
    Ok(take payload)
}

// Middle segments stop at the next HEADER's prev_end. Only the last segment
// reads beyond its durable boundary, stopping at the first physically bad frame.
fn journal_scan[S](mut input: JournalInput, path: String, id: StoreId, seq: u64, start: u64, boundary: Option[u64], final_item: bool, mut destination: S, consume: scoped fn(mut S, take JournalEvent) -> Result[(), Error]) -> Result[(u64, u64), Error] waits {
    let header = disk_read_header(path, journal_prefix(mut input, path, 0, 72)?, 2, Some(seq), Some(id))?
    let durable_end = match boundary {
        Some(d) => d,
        None => 72u64
    }
    if durable_end < 72 || durable_end > input.size {
        return Error(disk_fault(path, input.size, Truncated))
    }
    let stop = if final_item {
        input.size
    } else {
        durable_end
    }
    // A catch-up resumes a segment at the end the previous round replayed.
    if start < 72 || start > durable_end {
        return Error(disk_fault(path, start, Truncated))
    }
    let mut at = start
    let mut accepted = 0u64
    while at < stop {
        let received = journal_read_frame(mut input, path, header.context, at)
        let frame = match take received {
            Ok(take valid) => take valid,
            Error(Corrupt(take fault)) => {
                if !final_item || at < durable_end || !journal_torn(fault.why) {
                    return Error(Corrupt(take fault))
                }
                break
            },
            Error(take problem) => return Error(take problem),
        }
        if at < durable_end && frame.end > durable_end {
            return Error(disk_fault(path, at, Truncated))
        }
        if let Some(payload) = frame.payload {
            let event = disk_allocation(scoped fn() -> Result[JournalEvent, Error] {
                journal_decode(path, frame.kind, payload)
            })?
            consume(mut destination, take event)?
            accepted += frame.end - at
        }
        at = frame.end
    }
    Ok((at, accepted))
}

type JournalReplay {
    state: State,
    names: Map[String, u32],
    record_bytes: u64,
    next_node: u64,
    tiered: ReplayTieredAccount,
    forked: List[LineageFork],
    // The recorded limits every replayed frame is checked against (§11.1 AP4a).
    limits: StoreLimits
}

fn journal_replay(take state: State, next_node: u64, limits: StoreLimits) -> Result[JournalReplay, Error] {
    let (take names, total) = disk_allocation(scoped fn() -> Result[(Map[String, u32], u64), Error] {
        let mut names: Map[String, u32] = map.new()
        capacity(map.try_reserve(mut names, list.len(state.tips)))?
        let mut total = 0u64
        for held in state.pins {
            total += pin_root_bytes(held.name, held.roots)
        }
        for head in state.tips {
            total += branch_root_bytes(head.name, head.roots)
            map.insert(mut names, string.from(head.name), head.id)
        }
        Ok((take names, total))
    })?
    let tiered = ReplayTieredAccount(total: 0, exact: list.len(state.tips) == 1 && list.len(state.pins) == 0)
    Ok(JournalReplay(state: take state, names: take names, record_bytes: total, next_node: next_node, tiered: tiered, forked: list.new(), limits: limits))
}

fn journal_apply_ops(file: String, mut ids: u64, mut tree: PageTree, ops: List[JournalOp], mut account: ReplayTieredAccount) -> Result[(), Error] {
    if list.len(ops) == 0 {
        return Ok(())
    }
    let mut next_stamp = stamp_after(ids)?
    let domain = tree_domain(tree)
    for op in ops {
        if domain == CollectionMap {
            if list.len(op.key) < 4 {
                return Error(disk_fault(file, 0, Malformed))
            }
            let (kind, tiered_descriptor) = {
                let Some(descriptor) = std.page.lookup(tree.root, list.slice(op.key, 0, 4)) else {
                    return Error(disk_fault(file, 0, Malformed))
                }
                journal_collection_descriptor(descriptor)
            }
            if let Some(before) = tiered_descriptor {
                replay_tiered_op(file, mut tree, mut next_stamp, mut account, before, op)?
                continue
            }
            if let Some(trim) = op.trim {
                match trim_log_page(mut tree, op.key, trim.floor, Some(trim.dropped), 0, mut next_stamp) {
                    Ok(_) => (),
                    Error(Corrupt(_)) => return Error(disk_fault(file, 0, Malformed)),
                    Error(take problem) => return Error(take problem),
                }
                continue
            }
            if kind == LogCollection {
                let Some(value) = view op.value else {
                    return Error(disk_fault(file, 0, Malformed))
                }
                if list.len(op.key) != 12 || op.prior != 0 || list.len(value) < 2 {
                    return Error(disk_fault(file, 0, Malformed))
                }
                let seq: u64 = list.word_be(op.key, 4)
                let id: u32 = list.word_be(op.key, 0)
                let limits = committed_log_bounds(tree, id)?
                if seq != limits.next || seq == 18446744073709551615u64 {
                    return Error(disk_fault(file, 0, Malformed))
                }
                apply_log_append(mut tree, op.key, value, None, 0, mut next_stamp)?
                continue
            }
            if op.prior != stored_prior(get_page_row(tree, op.key)) {
                return Error(disk_fault(file, 0, Malformed))
            }
            if kind == CellCollection {
                if list.len(op.key) != 4 {
                    return Error(disk_fault(file, 0, Malformed))
                }
                let raw = match op.value {
                    Some(stored) => Some(view stored),
                    None => None
                }
                if let Some(stored) = raw {
                    if list.len(stored) < 2 {
                        return Error(disk_fault(file, 0, Malformed))
                    }
                }
                apply_cell(mut tree, op.key, raw, None, 0, mut next_stamp)?
                continue
            }
        } else if let Some(_) = op.trim {
            return Error(disk_fault(file, 0, Malformed))
        }
        match op.value {
            Some(value) => put_page_row(mut tree, op.key, value, 0, mut next_stamp)?,
            None => {
                let _ = remove_page_row(mut tree, op.key, 0, mut next_stamp)?
            },
        }
    }
    canonical_tree(mut tree)?
    ids = next_stamp - 1
    Ok(())
}

fn journal_apply_commit(file: String, mut replay: JournalReplay, commit: JournalCommit) -> Result[(), Error] {
    // Section 3.4 step 6: the branch must exist, and the version is its head + 1.
    let total_count = list.len(replay.state.tips)
    let mut i = total_count
    for k in 0u64 .. total_count {
        if replay.state.tips[k].id == commit.branch {
            i = k
        }
    }
    if i == total_count || int.checked_add(replay.state.tips[i].head, 1) != Some(commit.version) {
        return Error(disk_fault(file, 0, Gap(commit.version)))
    }
    replay_within_limits(file, replay.limits, commit)?
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.collections, commit.data, mut replay.tiered)?
    journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[i].roots.streams, commit.streams, mut replay.tiered)?
    if list.len(commit.keyed) != 0 {
        let before = keyed_root_record_bytes(replay.state.tips[i].roots.keyed)
        let mut draw = stamp_after(replay.next_node)?
        materialize_keyed_edits(mut replay.state.tips[i].roots, commit.keyed, 0, mut draw)?
        canonical_roots(mut replay.state.tips[i].roots)?
        replay.next_node = draw - 1
        replay.record_bytes = replay.record_bytes - before + keyed_root_record_bytes(replay.state.tips[i].roots.keyed)
        if replay.record_bytes > replay.limits.meta {
            return Error(disk_fault(file, 0, Malformed))
        }
    }
    replay.state.tips[i].head = commit.version
    replay.state.tips[i].at = commit.at
    Ok(())
}

fn journal_apply(file: String, mut replay: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
    match take event {
        Commit(take commit) => journal_apply_commit(file, mut replay, commit),
        Fork(take encoded) => journal_apply_fork(file, mut replay, take encoded),
    }
}

// Replay settles the Memory union from the final roots. A put can make
// the head and a pin share a row version again, lowering that union.
fn journal_account(replay: JournalReplay) -> Result[u64, Error] {
    disk_allocation(scoped fn() -> Result[u64, Error] {
        capacity(state_account(replay.state))
    })
}

fn journal_following(d: Dir, id: StoreId, seq: u64, flush: Option[Clock]) -> Result[Option[DiskHeader], Error] waits {
    let Some(next_seq) = int.checked_add(seq, 1) else {
        return Ok(None)
    }
    let next_header = journal_header(d, id, next_seq, flush)
    match take next_header {
        Ok(h) => Ok(h),
        Error(Corrupt(_)) => {
            let beyond = if let Some(following_seq) = int.checked_add(next_seq, 1) {
                disk_exists(d, journal_path(following_seq, "")?)?
            } else {
                false
            }
            if beyond || disk_end(d, id, next_seq)? != None {
                let next_path = journal_path(next_seq, "")?
                return Error(disk_fault(next_path, 0, Header))
            }
            Ok(None)
        },
        Error(take e) => return Error(take e)
    }
}

pub fn recorded(db: Db, b: Branch, wanted: u64) -> Result[Option[Recorded], Error] waits {
    match recorded_commit(db, b, wanted)? {
        Some(commit) => Ok(recorded_call(db.store, b, commit)),
        None => Ok(None),
    }
}

fn reserve_tx(mut tx: Tx, fault: bool) -> Result[Bytes, Bytes] {
    if fault {
        let no_values: List[u64] = list.new()
        let _ = no_values[0]
    }
    Ok(key_word(7))
}

// L33: AM5 and MEM-24 give 4096 + 32 bytes. MEM-30 gives 8192 + 6 steps.
pub fn law_call_reserve(c: Clock) -> bool waits {
    let byte_total = 4128u64
    let step_total = 8198u64
    let plan = Plan(n_e: 4096, s_e: 8192, reply_max: 4096)
    let Some(grant) = call_reserves(plan) else {
        return false
    }
    if grant.retained != byte_total || grant.steps != step_total {
        return false
    }
    let mut db = test_db(c, 1073741824)
    let key = key_word(23)
    let request = request_digest(key, key)
    let stream_name = StreamKey(caller: Caller(issuer: 2u8, subject: take key), id: StreamId(t: keyed_time(db), n: 0u64))
    let no_record: Option[CallRecord] = None
    let no_pins: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    for fault in[false, true] {
        let p = if fault {
            1u64
        } else {
            0u64
        }
        let admission = result.unwrap(admit(mut db, stream_name, p, request))
        let Admitted(take complete) = take admission else {
            return false
        }
        let ci = next_call_info(db)
        // One step is the call of metered_draft outside its own reserve.
        let rejected = bound steps step_total {
            metered_draft(db, complete, ci, plan, grant, no_record, None, no_pins, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take rejected {
            Ok(Error(DraftStopped(OutOfSteps(used)))) => if used != step_total {
                return false
            },
            _ => return false,
        }
        let admitted = bound steps step_total + 1u64 {
            metered_draft(db, complete, ci, plan, grant, no_record, None, no_pins, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, fault)
            })
        }
        match take admitted {
            Ok(Ok(draft)) => match draft.stage {
                Ran(_) if !fault => (),
                Over(Failed(_)) if fault => (),
                _ => return false,
            },
            _ => return false,
        }
        let short = bound bytes byte_total - 1u64 {
            serve(mut db, take complete, plan, None, fault, fn(mut tx, should_fail) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, should_fail)
            })
        }
        match take short {
            Ok(Error(Before(Full(Allocation(problem)), None))) => if problem.requested != byte_total || problem.available != byte_total - 1u64 {
                return false
            },
            _ => return false,
        }
        let retry = result.unwrap(admit(mut db, stream_name, p, request))
        let Abandoned(take completion) = take retry else {
            return false
        }
        let exact = bound bytes byte_total {
            serve(mut db, take completion, plan, None, fault, fn(mut tx, should_fail) -> Result[Bytes, Bytes] {
                reserve_tx(mut tx, should_fail)
            })
        }
        match take exact {
            Ok(Ok(Committed(receipt))) if !fault => if receipt.reply != key_word(7) {
                return false
            },
            Ok(Ok(Failed(take pending_run, Raised(2u32)))) if fault => match conclude(mut db, take pending_run, key_word(2), Resident) {
                Ok(Committed(receipt)) => if receipt.reply != key_word(2) {
                    return false
                },
                _ => return false,
            },
            _ => return false,
        }
    }
    let admission = result.unwrap(admit(mut db, stream_name, 2, request))
    let Admitted(take complete) = take admission else {
        return false
    }
    let small = Plan(n_e: 1024, s_e: plan.s_e, reply_max: plan.reply_max)
    // The read log's node (24 bytes), the issued cell's node (8, MEM-29) and
    // a 944-byte reply fit in 1024. The reply row's stored copy, 41 + 944 =
    // 985 bytes rounded up to 992, does not fit in the 48 left.
    let kept_inside = match serve(mut db, take complete, small, None, (), fn(mut tx, unused_env) -> Result[Bytes, Bytes] {
        let mut output: Bytes = list.with_capacity(944)
        list.fill(mut output, 944, 7u8)
        Ok(take output)
    }) {
        Ok(Failed(_, OutOfBytes(problem))) => problem.requested == 992 && problem.available == 48,
        _ => false,
    }
    kept_inside && reserve_settles_pin(c, 10, plan) && reserve_settles_pin(c, 100000, plan)
}

// Build the pinned tree directly so its size does not make the setup a call.
fn reserve_pinned_data(mut db: Db, t: Table[u64, u64], rows: u64) -> () {
    let mut input: List[std.page.Row] = list.with_capacity(rows)
    let mut raw: Bytes = list.with_capacity(10)
    result.unwrap(le(mut raw, 0, 2))
    result.unwrap(le(mut raw, 1, 8))
    for i in 0u64 .. rows {
        list.push(mut input, std.page.Row(key: key_word(i), value: result.unwrap(copied(raw)), charge: 94))
    }
    result.unwrap(bulk_store_collection(mut db.heads[0].roots.collections, t.id, 1, input, mut db.next_node))
    db.resident = one_page_account(db.heads[0].roots)
}

fn reserve_settles_pin(c: Clock, rows: u64, plan: Plan) -> bool waits {
    let mut db = test_db(c, 1073741824)
    let mut d = result.unwrap(declare(db, Migrate))
    let declared = result.unwrap(declare_table(mut d, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let source = result.unwrap(finish(mut d, take declared))
    let _ = result.unwrap(seal(mut db, take d))
    reserve_pinned_data(mut db, source, rows)
    let base = snapshot(db)
    result.unwrap(pin(mut db, "reserve", base))
    // One replaced leaf has at most 32 rows. Sixty-four overwrites of its
    // first key leave more obsolete charges than the extra leaf and reply.
    for i in 0u64 .. 64 {
        if !typed_put(mut db, source, 0, 2u64 + i) {
            return false
        }
    }
    let label = key_word(47)
    let request = request_digest(label, label)
    let stream = StreamKey(caller: Caller(issuer: 2u8, subject: take label), id: StreamId(t: keyed_time(db), n: 0u64))
    let admission = result.unwrap(admit(mut db, stream, 0, request))
    let Admitted(take complete) = take admission else {
        return false
    }
    db.ceiling = db.resident
    let unsettled = db.changes
    if db.settled == unsettled {
        return false
    }
    let cut = db.checkpointed
    let Some(grant) = call_reserves(plan) else {
        return false
    }
    let ci = next_call_info(db)
    let no_record: Option[CallRecord] = None
    let no_pins: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    let short = bound steps grant.steps {
        metered_draft(db, complete, ci, plan, grant, no_record, None, no_pins, fn(mut tx: Tx) -> Result[Bytes, Bytes] {
            Ok(key_word(7))
        })
    }
    match take short {
        Ok(Error(DraftStopped(OutOfSteps(used)))) => if used != grant.steps {
            return false
        },
        _ => return false,
    }
    match serve(mut db, take complete, plan, None, (), fn(mut tx, unused_env) -> Result[Bytes, Bytes] {
        Ok(key_word(7))
    }) {
        Ok(Committed(receipt)) => receipt.reply == key_word(7) && accounts(db).exact && db.checkpointed == cut + 1,
        _ => false,
    }
}

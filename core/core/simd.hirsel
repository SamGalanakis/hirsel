// Module `simd` (SEM-11). The checker types each operation at its call.
// The signatures below name a representative shape.
pub fn wrapping_add(a: Simd[u8, 16], b: Simd[u8, 16]) -> Simd[u8, 16]

pub fn wrapping_sub(a: Simd[u8, 16], b: Simd[u8, 16]) -> Simd[u8, 16]

pub fn saturating_add(a: Simd[u8, 16], b: Simd[u8, 16]) -> Simd[u8, 16]

pub fn saturating_sub(a: Simd[u8, 16], b: Simd[u8, 16]) -> Simd[u8, 16]

pub fn eq(a: Simd[u8, 16], b: Simd[u8, 16]) -> Simd[u8, 16]

pub fn lt(a: Simd[u8, 16], b: Simd[u8, 16]) -> Simd[u8, 16]

pub fn splat(x: u8) -> Simd[u8, 16]

pub fn from(a: Inline[u8, 16]) -> Simd[u8, 16]

pub fn swizzle(t: Simd[u8, 16], i: Simd[u8, 16]) -> Simd[u8, 16]

pub fn cast(v: Simd[u8, 16]) -> Simd[u8, 16]

pub fn any(v: Simd[u8, 16]) -> bool

pub fn bitmask(v: Simd[u8, 16]) -> u64

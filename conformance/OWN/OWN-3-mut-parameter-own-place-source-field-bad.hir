// rule: OWN-3
// expect: reject OWN-3 at line 16
// twin: MODE/MODE-1-mut-parameter-own-place-ok.hir
// Dropping the access loan on a `mut` argument's own place keeps the overlap check:
// storage inside the relation's source is still lent while the source is read.
type Node {
  keys: List[Bytes],
  cache: List[Bytes],
}

fn collect(n: Node, mut out: List[Bytes] in n) -> () uses {} {
  list.push(mut out, b"x")
}

fn bad(mut n: Node) -> () uses {} {
  collect(n, mut n.cache)
}

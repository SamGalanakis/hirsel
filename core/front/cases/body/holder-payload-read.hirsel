// core.md: a Box/Rc/Arc is read as its payload where a view is expected.
// No clone, unbox or transfer occurs; every holder is read repeatedly.
// expect: accept
// expect: run calculator() = 10
// expect: run go() = 3
// expect: run counted() = 24
// expect: run nested() = 9
// expect: run fields() = 456
// expect: run explicit() = 3
// expect: run borrowed() = 8
// expect: run temporary() = 6
// expect: run matched() = 123
// expect: run tupled() = 42
type N:shareable+send = Lit(i64) | Add(Box[N],Box[N])
fn ev(n:N)->i64 { match n { Lit(x)=>x, Add(l,r)=>ev(l)+ev(r) } }
fn calculator()->i64 {
 let a=result.unwrap(box.new(Lit(3i64)))
 let b=result.unwrap(box.new(Lit(7i64)))
 let tree=result.unwrap(box.new(Add(take a,take b)))
 ev(tree)
}
fn counted()->i64 {
 let a=result.unwrap(rc.new(Lit(5i64)))
 let b=result.unwrap(arc.new(Lit(7i64)))
 ev(a)+ev(b)+ev(a)+ev(b)
}
fn nested()->i64 {
 let a=result.unwrap(box.new(result.unwrap(box.new(Lit(9i64)))))
 ev(a)
}
type P:shareable+send { n:u64 }
fn fields()->u64 {
 let a=result.unwrap(box.new(P(n:4u64)))
 let b=result.unwrap(rc.new(P(n:5u64)))
 let c=result.unwrap(arc.new(P(n:6u64)))
 a.n*100u64+b.n*10u64+c.n
}
fn len(x:View[String])->u64 { string.byte_len(x) }
fn explicit()->u64 { let b=result.unwrap(box.new("abc")); len(b) }

fn borrow(b:Box[P])->View[P] in b { b }
fn borrowed()->u64 {
 let b=result.unwrap(box.new(P(n:4u64)))
 let p:View[P]=b
 let q=borrow(b)
 p.n+q.n
}
fn make()->Box[N] { result.unwrap(box.new(Lit(6i64))) }
fn temporary()->i64 { ev(make()) }

fn matched()->u64 {
 let a=result.unwrap(box.new(Some(1u64)))
 let b=result.unwrap(rc.new(Some(2u64)))
 let c=result.unwrap(arc.new(Some(3u64)))
 let xa=match a { Some(ax)=>ax,None=>0u64 }
 let yb=match b { Some(by)=>by,None=>0u64 }
 let zc=match c { Some(cz)=>cz,None=>0u64 }
 xa*100u64+yb*10u64+zc
}
fn tupled()->u64 { let b=result.unwrap(box.new((4u64,2u64)));match b { (a,c)=>a*10u64+c } }
// A payload read leaves its resource finalizer owned by the Box, exactly once.
// expect: run resource_read() = 18 trace 9
resource type Mark { n:u64 } drop(m) { let _=m.n }
fn mark(m:Mark)->u64 { m.n }
fn resource_read()->u64 {
 let m=result.unwrap(Mark(n:9u64))
 let b=result.unwrap(box.new(take m))
 mark(b)+mark(b)
}
fn positive()->bool {
 go()==3i64 && calculator()==10i64 && counted()==24i64 && nested()==9i64 && fields()==456u64 && explicit()==3u64 && borrowed()==8u64 && temporary()==6i64 && matched()==123u64 && tupled()==42u64 && resource_read()==18u64
}

fn go()->i64 { let b=result.unwrap(box.new(Lit(3i64))); ev(b) }

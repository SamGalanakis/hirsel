// OWN-20 / OWN-11 (ruling 7): the attacks of mut-anchor-attack-919 that the text
// refuses, numbered as there, each refused where the text says.
fn lend(mut s: String) -> View[String] in s {
    string.slice(s, 0, string.byte_len(s))
}

fn step(mut s: String) -> Result[Option[View[String]], Capacity] in s {
    string.push(mut s, "x")?
    Ok(Some(lend(mut s)))
}

// 2: replace the parameter after forming the returned view.
fn replace_after(mut s: String) -> View[String] in s {
    let v = string.slice(s, 0, string.byte_len(s))
    s = string.new()
    v
}

// 3: the freeze opens at the call's return, before a later field is checked.
scoped type Mark {
    line: View[String],
    n: u64,
}

fn aggregate(mut s: String) -> Mark in s {
    Mark(line: lend(mut s), n: {
        s = string.new()
        0
    })
}

// 4: lending again after a nested anchored call returned.
fn nested(mut s: String) -> View[String] in s {
    let v = lend(mut s)
    let w = lend(mut s)
    v
}

// 5: a callback activation crosses the freeze installed after it was built.
fn callback(mut s: String) -> View[String] in s {
    let cb = scoped fn() {
        s = string.new()
    }
    let v = lend(mut s)
    cb()
    v
}

// 8: the same actual for a `mut` anchor and a view anchor.
scoped type Duo8[in a, in b] {
    x: View[String] in a,
    y: View[String] in b,
}

fn both8(mut a: String, b: String) -> Duo8[in a, in b] {
    Duo8(x: view a, y: view b)
}

fn same_actual(mut s: String) {
    let d = both8(mut s, s)
}

// 9: a write to a sibling field crosses the freeze of the whole actual.
type Buffer {
    text: String,
    generation: u64,
}

fn field(mut b: Buffer) -> View[String] in b {
    lend(mut b.text)
}

fn prefix(mut b: Buffer) {
    let v = field(mut b)
    b.generation += 1
}

// 10: indexes are not proved distinct.
fn index(mut xs: List[String], i: u64, j: u64) {
    let v = lend(mut xs[i])
    xs[j] = string.new()
}

// 11: a result stored in a scoped record keeps its anchor.
scoped type Line11 {
    text: View[String],
}

fn record(mut s: String) -> Result[(), Capacity] {
    let line = Line11(text: match step(mut s)? {
        Some(v) => v,
        None => return Ok(()),
    })
    s = string.new()
    Ok(())
}

// 16: a line kept across a loop back edge.
fn back_edge(mut s: String) {
    let mut last: Option[View[String]] = None
    loop {
        last = Some(lend(mut s))
    }
}

// 18: a write in a `while let` body while its line lives.
fn while_body(mut s: String) -> Result[(), Capacity] {
    while let Some(line) = step(mut s)? {
        s = string.new()
        let _ = string.byte_len(line)
    }
    Ok(())
}

// 20: every variant is frozen, an empty arm included.
fn empty_arm(mut s: String) -> Result[(), Capacity] {
    match step(mut s)? {
        Some(line) => {
            let _ = string.byte_len(line)
        },
        None => {
            s = string.new()
        },
    }
    Ok(())
}

// 33: the inner owner cannot be cleaned while the outer view needs it.
fn inner_owner() -> u64 {
    let v = {
        let mut s = string.new()
        lend(mut s)
    }
    string.byte_len(v)
}

// 34: a braced tail still reaches its binding.
fn braced(mut s: String) {
    lend(mut s)
    s = string.new()
    let v = { lend(mut s) }
    s = string.new()
}

// 35: a scoped parameter keeps its carried anchors when it is lent.
scoped type Cursor {
    input: View[String],
    pos: u64,
}

fn advance(mut c: Cursor) -> View[String] in c {
    c.pos += 1
    string.slice(c.input, 0, 0)
}

fn carried(mut s: String) {
    let mut c = Cursor(input: view s, pos: 0)
    let v = advance(mut c)
    s = string.new()
}


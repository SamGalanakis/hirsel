  v8: u64 = read a2
  v9: u64 = read a3
  v10: u64 = add v9, v7
  v11: u64 = rem v10, v8
  address a4
  address a5
  store a4, v1
  mark a5, live : t0
  v12: u64 = const 1
  v13: u64 = add v7, v12
  store a1, v13
  return
}
fn f3 = n3 g1 {
  addr a0 = v0 byte v1 : ptr           ; data
  addr a1 = v0 byte v2 : u64           ; len
  addr a2 = v0 byte v3 : u64           ; capacity
  addr a3 = v0 byte v4 : u64           ; head
  addr a4 = v5 index v8 : t0           ; slot head
b0(v0: ptr):

// Format 5 bounds the pins of one cut step (§13.8, v2.74).
const CUT_HEIGHT_MAX: u64 = 65

const CUT_PIN_BYTES: u64 = 4 * CUT_HEIGHT_MAX * (PAGE_LIMIT + 16) + (1048576 + 16) + (BLOB_LIMIT + 16)

fn fold_frame(source: TieredPageSource, target: TieredTarget) -> Result[Arc[TieredFrame], Error] waits {
    let fetched = fold_frame_at(source, target)
    match take fetched {
        Error(Corrupt(take fault)) => {
            let mut malformed_fault = take fault
            malformed_fault.why = Malformed
            Error(Corrupt(take malformed_fault))
        },
        Ok(take frame) => {
            if let TieredImage(page) = view frame.payload {
                let height: u64 = int.widen(std.page.level(std.page.image_of(page)))
                if height >= CUT_HEIGHT_MAX {
                    return Error(disk_fault(paged_pack_path(frame.identity.pack)?, frame.identity.offset, Malformed))
                }
            }
            Ok(take frame)
        },
        Error(take problem) => Error(take problem),
    }
}

fn fold_frame_at(source: TieredPageSource, target: TieredTarget) -> Result[Arc[TieredFrame], Error] waits {
    let request = tiered_pager_target(source.packs, source.next_stamp, source.deadline, TieredPoint, target)?
    let (answer, delivered) = disk_allocation(fn() -> Result[(Sender[Result[Arc[TieredFrame], Error]], Receiver[Result[Arc[TieredFrame], Error]]), Error] {
        Ok(channel.new(1))
    })?
    channel.send(source.pager, PagerRead(take request, take answer)) ?=> |_| Io(Closed)
    channel.receive(delivered) ?=> |_| Io(Closed)
}

fn fold_cold_path(cut: TieredPageSource, base: std.page.PagePtr, key: Bytes) -> Result[List[Arc[TieredFrame]], Error] waits {
    let mut path: List[Arc[TieredFrame]] = list.new()
    if base.stamp == 0 { return Ok(take path) }
    let mut target = TieredPage(base)
    let mut expected_level: Option[u8] = None
    let mut charged = 0u64
    loop {
        let wanted = tiered_frame_id(target)
        charged += 16 + wanted.len
        if wanted.len > PAGE_LIMIT || charged > CUT_PIN_BYTES {
            return Error(disk_fault(paged_pack_path(wanted.pack)?, wanted.offset, Malformed))
        }
        capacity(list.try_reserve(mut path, 1))?
        let frame = fold_frame(cut, target)?
        let child = tiered_point_continuation(frame, key, TieredPoint, expected_level)?
        list.push(mut path, take frame)
        let Some((take following, height)) = take child else { return Ok(take path) }
        target = take following
        expected_level = Some(height)
    }
}

fn fold_page(frame: TieredFrame) -> View[Arc[std.page.Page]] in frame {
    let TieredImage(page) = view frame.payload else {
        fail("store: expected a PAGE on the fold's path")
    }
    page
}

fn fold_base_prior(cut: TieredPageSource, base: std.page.PagePtr, logical: Bytes) -> Result[u32, Error] waits {
    let sought = list.slice(logical, 4, list.len(logical))
    let path = fold_cold_path(cut, base, sought)?
    if list.len(path) == 0 {
        return Ok(0u32)
    }
    let leaf = fold_page(path[list.len(path) - 1])
    Ok(tiered_leaf_prior(leaf, sought))
}

// Sum the strict prefixes encountered while descending one boundary path.
// Interior entries carry the charges for every subtree the path passes.
fn fold_prefix_charge(cut: TieredPageSource, base: std.page.PagePtr, sequence_limit: u64) -> Result[u64, Error] waits {
    let key = key_word(sequence_limit)
    let path = fold_cold_path(cut, base, key)?
    let mut total = 0u64
    for frame in path {
        let image = std.page.image_of(fold_page(frame))
        let end = match std.page.descend(image, key) {
            Some(slot) => slot,
            None => {
                let (slot, _) = std.page.search(image, key)
                slot
            },
        }
        let path_name = paged_pack_path(frame.identity.pack)?
        total = disk_allocation(scoped fn() -> Result[u64, Error] {
            let mut charge = total
            for slot in 0u64 .. end {
                let row = option.unwrap(std.page.entry(image, slot))
                if std.page.level(image) == 0 && list.len(row.key) != 8 {
                    return Error(disk_fault(path_name, frame.identity.offset, Malformed))
                }
                let width = match row.cell {
                    Child(child_entry) => child_entry.charge,
                    InlineValue(value) => 62 + 16 + round8(list.len(value)),
                    BlobValue(reference) => 62 + 16 + round8(reference.len),
                }
                let Some(following) = int.checked_add(charge, width) else {
                    return Error(disk_fault(path_name, frame.identity.offset, Malformed))
                }
                charge = following
            }
            Ok(charge)
        })?
    }
    Ok(total)
}

// Borrow the evidence directly from the immutable overlay. No cursor
// allocation or key copy is needed between pager calls.
fn visit_fold_records[K: ordered + shareable + send, V: shareable + send](node: Arc[std.omap.Node[K, V]],
    visit: scoped[view] fn(K, V) -> Result[(), Error] waits) -> Result[(), Error] waits {
    for slot in 0u64 .. std.omap.node_count(node) {
        if let Some(child) = std.omap.node_child(node, slot) {
            visit_fold_records(child, visit)?
        } else {
            let key = option.unwrap(std.omap.node_key(node, slot))
            let row = option.unwrap(std.omap.node_value(node, slot))
            visit(key, row)?
        }
    }
    Ok(())
}

fn verify_tiered_fold(cut: TieredPageSource, base: std.page.PagePtr, overlay: Arc[ReplayOverlay]) -> Result[(), Error] waits {
    let pack_file = paged_pack_path(base.pack)?
    if let Some(root) = std.omap.root(overlay.trims) {
        visit_fold_records(root, scoped fn(ordinal: u64, evidence: ReplayTrimEvidence) -> Result[(), Error] waits {
            if evidence.lo < evidence.hi {
                let low = fold_prefix_charge(cut, base, evidence.lo)?
                let high = fold_prefix_charge(cut, base, evidence.hi)?
                if int.checked_sub(high, low) != Some(evidence.cold_charge) {
                    return Error(disk_fault(pack_file, base.offset, Malformed))
                }
            }
            Ok(())
        })?
    }
    if let Some(root) = std.omap.root(overlay.entries) {
        visit_fold_records(root, scoped fn(key: Bytes, row: ReplayRow) -> Result[(), Error] waits {
            if fold_base_prior(cut, base, key)? != row.base {
                return Error(disk_fault(pack_file, base.offset, Malformed))
            }
            Ok(())
        })?
    }
    Ok(())
}

// The paused writer runs one verified edit at a time. These pins are
// released before it hands the changed path to the pack writer.
fn retry_fold_edit[R](cut: TieredPageSource, edit: scoped[view] fn(core.Cell[TieredTouchSet], Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[R, Error]) -> Result[R, Error] waits {
    let mut pins: Map[TieredCacheKey, Arc[TieredFrame]] = map.new()
    loop {
        let attempt = tiered_attempt(CUT_PIN_BYTES, 0)
        let isolated = disk_allocation(scoped fn() -> Result[Result[R, Error], Error] {
            Ok(edit(attempt, pins))
        })
        let TieredTouchSet(stopped: take stop, ..) = tiered_finish(take attempt)
        match take stop {
            Some(AttemptMiss(take target)) => {
                capacity(map.try_reserve(mut pins, 1))?
                let frame = fold_frame(cut, target)?
                map.insert(mut pins, tiered_cache_key(frame.identity), take frame)
            },
            Some(AttemptPinLimit(_)) => return Error(malformed(0)),
            Some(AttemptAllocation(problem)) => return Error(Full(Allocation(problem))),
            Some(AttemptFold(_)) => fail("store: a cut cannot wait for itself"),
            None => {
                let result = (take isolated)?
                return take result
            },
        }
    }
}

fn restore_fold_slots(take root: Arc[std.page.Page], first_stamp: u64, visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> std.page.Slot {
    std.page.restore_cold_slots(take root, first_stamp, scoped fn(stamp: u64) -> Option[std.page.PagePtr] {
        for (_, frame) in visible {
            let facts = frame.identity
            if facts.stamp == stamp && facts.kind == 0x0021 {
                return Some(std.page.PagePtr(pack: facts.pack, offset: facts.offset, len: int.truncate(facts.len), checksum: facts.checksum, stamp: stamp))
            }
        }
        None
    })
}

fn fold_materialize_row(cut: TieredPageSource, current: std.page.Slot, empty_root: Arc[std.page.Page], logical: Bytes, row: ReplayRow,
    inline: u64, log_rows: bool, private_from: u64, mut next_stamp: u64) -> Result[std.page.Slot, Error] waits {
    let (take ready, following_stamp) = retry_fold_edit(cut, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[(std.page.Slot, u64), Error] {
        let mut draw = next_stamp
        let key = list.slice(logical, 4, list.len(logical))
        let page = stage_tiered_row(attempt, visible, current, empty_root, key, row.now, inline, log_rows, private_from, mut draw)?
        Ok((restore_fold_slots(take page, next_stamp, visible), draw))
    })?
    next_stamp = following_stamp
    Ok(take ready)
}

fn fold_materialize_trim(cut: TieredPageSource, current: std.page.Slot, empty_root: Arc[std.page.Page], limits: LogBounds, before: u64,
    floor: u64, mut next_stamp: u64) -> Result[std.page.Slot, Error] waits {
    let (take ready, following_stamp) = retry_fold_edit(cut, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[(std.page.Slot, u64), Error] {
        let mut draw = next_stamp
        let (take page, _) = stage_tiered_trim(attempt, visible, current, empty_root, limits, before, floor, mut draw)?
        Ok((restore_fold_slots(take page, next_stamp, visible), draw))
    })?
    next_stamp = following_stamp
    Ok(take ready)
}

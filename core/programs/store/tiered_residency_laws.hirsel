// §13.8 "Residency changes" and §13.6a T2 "Re-stamping". A Memory table
// moves to Tiered through its schema commit's cut. The oracle walks the
// published tree frame by frame from the pack files (compact_walk), and the
// pinned pre-change holder's Memory images give the stamps classes 0 and 1
// still place. No stamp may be reached in both families (L88 (g)).
fn residency_value(key: u64) -> Bytes {
    // Even rows are BLOBs (class 4), odd rows inline in their leaf.
    let width = if key % 2 == 0 {
        1100u64
    } else {
        48u64
    }
    let mut body: Bytes = list.with_capacity(width)
    list.fill(mut body, width, int.truncate(key))
    take body
}

fn residency_rows(mut db: Db, row_count: u64) -> Result[Table[u64, Bytes], Error] waits {
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let fixture: Table[u64, Bytes] = clone(rows)
    let Committed(_) = run(mut db, None, copy_env((fixture, row_count)), fn(mut tx: Tx, env: (Table[u64, Bytes], u64)) -> Result[(), Error] {
        for key in 0u64 .. env.1 {
            put(mut tx, env.0, key, residency_value(key))?
        }
        Ok(())
    })? else {
        fail("residency: fixture puts did not commit")
    }
    Ok(rows)
}

fn residency_check_rows(db: Db, s: Snapshot, rows: Table[u64, Bytes], row_count: u64) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    for key in 0u64 .. row_count {
        if get(read_handle, s, rows, key)? != Some(residency_value(key)) {
            fail("residency: every row reads back unchanged")
        }
    }
    Ok(())
}

fn residency_memory_stamps(page: Arc[std.page.Page], mut stamps: List[u64]) {
    let image = std.page.image_of(page)
    list.push(mut stamps, std.page.stamp(image))
    for slot in 0u64 .. std.page.count(image) {
        if let Some(HotPage(child)) = std.page.child_slot(page, slot) {
            residency_memory_stamps(child, mut stamps)
        } else if let Some(ColdPage(_)) = std.page.child_slot(page, slot) {
            fail("residency: a Memory holder's tree is resident")
        } else if let Some(BlobEdge(body)) = std.page.owning_edge(image, slot) {
            list.push(mut stamps, body.stamp)
        }
    }
}

fn residency_mode(db: Db, id: u32) -> Result[(std.page_descriptor.CollectionKind, std.page_descriptor.Residency), Error] {
    let Some(mode) = pages.collection_by_key(pages.holder_heads(db.holders)[0u64].roots.collections, prefix(id)?) else {
        fail("residency: the table is in main's collection map")
    }
    Ok((mode.kind, mode.residency))
}

fn residency_check_published(d: Dir, db: Db, id: u32, held_stamps: List[u64]) -> Result[(), Error] waits {
    let walk = compact_walk(d, db, id)?
    for stamp in held_stamps {
        if map.contains(walk.places, stamp) {
            fail("residency: a Tiered frame keeps a stamp the Memory holder still places")
        }
    }
    // Every pack the walk reached is listed, and Tiered (class 3 or 4).
    let mut reached = 0u64
    let mut pages = false
    let mut blobs = false
    let mut inventory = std.omap.range(disk_state(db).pages.locations.packs.values, Unbounded, Unbounded)
    while let Some((seq, listed)) = std.omap.next(mut inventory) {
        if let Some(_) = map.get(walk.live, seq) {
            if listed.class < 3 {
                fail("residency: a Tiered frame sits in a Memory pack")
            }
            pages = pages || listed.class == 3
            blobs = blobs || listed.class == 4
            reached += 1
        }
    }
    if reached != map.len(walk.live) {
        fail("residency: a reached frame sits in an unlisted pack")
    }
    if !pages || !blobs {
        fail("residency: the table's pages and BLOBs are both emitted")
    }
    Ok(())
}

@test
fn test_set_residency_moves_a_table_to_tiered(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let row_count = 200u64
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let rows = residency_rows(mut db, row_count)?
    if let Some(_) = db.pager {
        fail("residency: a store with no Tiered collection starts no pager")
    }
    let before = snapshot(db)
    let _ = pin(mut db, "before", before)?
    let mut held_stamps: List[u64] = list.new()
    {
        let Some((page, _)) = std.page.collection_entry(before.roots.collections.root, prefix(rows.id)?) else {
            fail("residency: the pinned holder has the table")
        }
        residency_memory_stamps(arc.share(page), mut held_stamps)
    }
    set_residency(mut db, rows.id, Tiered)?
    if residency_mode(db, rows.id)? != (TableCollection, ResidentTiered) {
        fail("residency: main's descriptor names the table Tiered")
    }
    if let None = db.pager {
        fail("residency: the first Tiered collection starts the pager")
    }
    residency_check_published(d, db, rows.id, held_stamps)?
    residency_check_rows(db, snapshot(db), rows, row_count)?
    residency_check_rows(db, before, rows, row_count)?
    // A second change to the same residency is no commit.
    let generation = db.checkpointed
    set_residency(mut db, rows.id, Tiered)?
    if db.checkpointed != generation {
        fail("residency: an unchanged residency makes no cut")
    }
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    if residency_mode(reopened, rows.id)? != (TableCollection, ResidentTiered) {
        fail("residency: the change survives a reopen")
    }
    residency_check_published(d, reopened, rows.id, held_stamps)?
    residency_check_rows(reopened, snapshot(reopened), rows, row_count)?
    close(take reopened)
}

// §1.1 "Which plan": the first change is admitted against the Tiered plan.
// On a store sized below its floor it is `Full(Resident(..))` and changes
// nothing: no pager, no cut, no pack, and the table stays Memory.
@test
fn test_set_residency_refused_admission_changes_nothing(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(182375271u64)?)?
    let rows = residency_rows(mut db, 20)?
    let generation = db.checkpointed
    let next_pack = disk_state(db).pages.next_pack
    let Error(Full(Resident(_))) = set_residency(mut db, rows.id, Tiered) else {
        fail("residency: a store below the Tiered floor refuses the first change")
    }
    if let Some(_) = db.pager {
        fail("residency: a refused change leaves no pager")
    }
    if db.checkpointed != generation || disk_state(db).pages.next_pack != next_pack {
        fail("residency: a refused change publishes nothing")
    }
    if residency_mode(db, rows.id)? != (TableCollection, ResidentMemory) {
        fail("residency: a refused change leaves the table Memory")
    }
    residency_check_rows(db, snapshot(db), rows, 20)?
    close(take db)
}

// §13.8 Tiered -> Memory. The load re-stamps every page and blob (v2.96), so
// no stamp of the head's Memory tree is one the Tiered tree's frames carry;
// the frame walker taken before the change is the oracle. A pin of the old
// descriptor still reads its Tiered tree, and the change survives a reopen.
@test
fn test_set_residency_moves_a_table_back_to_memory(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let row_count = 200u64
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let rows = residency_rows(mut db, row_count)?
    set_residency(mut db, rows.id, Tiered)?
    let _ = checkpoint(mut db)?
    let tiered_walk = compact_walk(d, db, rows.id)?
    let before = snapshot(db)
    let _ = pin(mut db, "tiered", before)?
    set_residency(mut db, rows.id, Memory)?
    if residency_mode(db, rows.id)? != (TableCollection, ResidentMemory) {
        fail("residency: main's descriptor names the table Memory")
    }
    let mut loaded: List[u64] = list.new()
    {
        let Some((page, _)) = std.page.collection_entry(pages.holder_heads(db.holders)[0u64].roots.collections.root, prefix(rows.id)?) else {
            fail("residency: main has the table")
        }
        residency_memory_stamps(arc.share(page), mut loaded)
    }
    for stamp in loaded {
        if map.contains(tiered_walk.places, stamp) {
            fail("residency: a loaded Memory page keeps a stamp of a Tiered frame")
        }
    }
    residency_check_rows(db, snapshot(db), rows, row_count)?
    residency_check_rows(db, before, rows, row_count)?
    let generation = db.checkpointed
    set_residency(mut db, rows.id, Memory)?
    if db.checkpointed != generation {
        fail("residency: an unchanged residency makes no cut")
    }
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    if residency_mode(reopened, rows.id)? != (TableCollection, ResidentMemory) {
        fail("residency: the change survives a reopen")
    }
    residency_check_rows(reopened, snapshot(reopened), rows, row_count)?
    let Some(held) = pinned(reopened, "tiered") else {
        fail("residency: the pin of the Tiered descriptor survives a reopen")
    }
    residency_check_rows(reopened, held, rows, row_count)?
    close(take reopened)
}

// §13.8 on an empty table: Memory -> Tiered emits zero Tiered frames because
// the empty root carries stamp 0, yet the head still holds a Tiered collection
// and must receive a pack inventory at Step 5. A subsequent Tiered -> Memory,
// point read and reopen then succeed (store-cold-edge-panic-3181, R1).
@test
fn test_set_residency_empty_table_tiered_to_memory(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let rows = residency_rows(mut db, 0)?
    set_residency(mut db, rows.id, Tiered)?
    if residency_mode(db, rows.id)? != (TableCollection, ResidentTiered) {
        fail("residency: main's descriptor names the empty table Tiered")
    }
    set_residency(mut db, rows.id, Memory)?
    if residency_mode(db, rows.id)? != (TableCollection, ResidentMemory) {
        fail("residency: main's descriptor names the empty table Memory")
    }
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    if get(read_handle, snapshot(db), rows, 0u64)? != None {
        fail("residency: point read on empty table after Tiered -> Memory is None")
    }
    drop(take read_handle)
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    if residency_mode(reopened, rows.id)? != (TableCollection, ResidentMemory) {
        fail("residency: empty table Memory residency survives reopen")
    }
    let reopened_reader = reader(reopened, VALUE_LIMIT + 1048576)?
    if get(reopened_reader, snapshot(reopened), rows, 0u64)? != None {
        fail("residency: point read after reopen is None")
    }
    drop(take reopened_reader)
    close(take reopened)
}

// L88 (g), Hot half (§13.8 "Tiered -> Memory", §13.6a T2): a row written
// after the last cut leaves Hot pages in the Tiered tree. A Snapshot taken
// then keeps that Hot tree, and a pin of it after the change has T2 seal its
// Hot pages in class 3, while main's loaded tree goes to class 0. The load
// re-stamps the Hot pages too, so no stamp the pin seals is one main's
// Memory tree places (seeded bug: a Hot page is shared into the Memory tree
// with its stamp).
@test
fn test_set_residency_restamps_hot_pages_back_to_memory(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let row_count = 200u64
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let rows = residency_rows(mut db, row_count)?
    set_residency(mut db, rows.id, Tiered)?
    let _ = checkpoint(mut db)?
    let fixture: Table[u64, Bytes] = clone(rows)
    let Committed(_) = run(mut db, Some(100000000), copy_env(fixture), fn(mut tx: Tx, t: Table[u64, Bytes]) -> Result[(), Error] {
        put(mut tx, t, 7, residency_value(7))
    })? else {
        fail("residency: the unsealed write commits")
    }
    let before = snapshot(db)
    {
        let Some((HotPage(_), _)) = std.page.collection_slot(before.roots.collections.root, prefix(rows.id)?) else {
            fail("residency: the Snapshot holds a Hot Tiered root")
        }
    }
    set_residency(mut db, rows.id, Memory)?
    let mut loaded: List[u64] = list.new()
    {
        let Some((page, _)) = std.page.collection_entry(pages.holder_heads(db.holders)[0u64].roots.collections.root, prefix(rows.id)?) else {
            fail("residency: main has the table")
        }
        residency_memory_stamps(arc.share(page), mut loaded)
    }
    let _ = pin(mut db, "hot", before)?
    let _ = checkpoint(mut db)?
    let Some(held) = pinned(db, "hot") else {
        fail("residency: the pin publishes")
    }
    let Some((ColdPage(sealed), _)) = std.page.collection_slot(held.roots.collections.root, prefix(rows.id)?) else {
        fail("residency: the pin's cut seals the Snapshot's Hot Tiered tree")
    }
    let walk = compact_walk_from(d, db, sealed)?
    for stamp in loaded {
        if map.contains(walk.places, stamp) {
            fail("L88 (g): a stamp lives in class 0 and in class 3")
        }
    }
    residency_check_rows(db, held, rows, row_count)?
    residency_check_rows(db, snapshot(db), rows, row_count)?
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    let Some(again) = pinned(reopened, "hot") else {
        fail("residency: the pin survives a reopen")
    }
    residency_check_rows(reopened, again, rows, row_count)?
    residency_check_rows(reopened, snapshot(reopened), rows, row_count)?
    close(take reopened)
}

// §13.8: Tiered -> Memory is admitted against `resident_limit` from the
// collection's Tiered charge. Five 16 MB rows do not fit the 64 MiB a store
// at the Tiered floor leaves Memory rows, so the change is
// `Full(Resident(..))` and nothing changes.
@test
fn test_set_residency_refused_load_changes_nothing(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(182375272u64)?)?
    let rows = residency_rows(mut db, 0)?
    set_residency(mut db, rows.id, Tiered)?
    for key in 0u64 .. 5 {
        let fixture: Table[u64, Bytes] = clone(rows)
        let mut body: Bytes = list.with_capacity(16000000)
        list.fill(mut body, 16000000, int.truncate(key))
        // A Tiered body is step-bounded (§13.3); this one reads no row.
        let Committed(_) = run(mut db, Some(1099511627776u64), copy_env((fixture, key, take body)), fn(mut tx: Tx, env: (Table[u64, Bytes], u64, Bytes)) -> Result[(), Error] {
            put(mut tx, env.0, env.1, clone(env.2))
        })? else {
            fail("residency: a large Tiered row commits")
        }
        let _ = checkpoint(mut db)?
    }
    let generation = db.checkpointed
    let next_pack = disk_state(db).pages.next_pack
    let Error(Full(Resident(_))) = set_residency(mut db, rows.id, Memory) else {
        fail("residency: a collection larger than the Memory room refuses the load")
    }
    if db.checkpointed != generation || disk_state(db).pages.next_pack != next_pack {
        fail("residency: a refused load publishes nothing")
    }
    if residency_mode(db, rows.id)? != (TableCollection, ResidentTiered) {
        fail("residency: a refused load leaves the table Tiered")
    }
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    for key in 0u64 .. 5 {
        let Some(value) = get(read_handle, snapshot(db), rows, key)? else {
            fail("residency: a refused load keeps every row")
        }
        if list.len(value) != 16000000 || value[0u64] != int.truncate(key) {
            fail("residency: a refused load keeps every row's value")
        }
    }
    close(take db)
}

fn log_entry(seq: u64) -> Bytes {
    let mut body: Bytes = list.with_capacity(48)
    list.fill(mut body, 48, int.truncate(seq))
    take body
}

// The rows `log_range(lo, hi)` must yield: every seq of [first, next) inside
// the bounds, ascending, each with the value appended at it.
fn log_range_matches(tx: Tx, events: Log[Bytes], lo: Bound[u64], hi: Bound[u64], first: u64, end: u64) -> Result[u64, Error] {
    let low = match lo {
        Unbounded => first,
        Included(n) => order.max(n, first),
        Excluded(n) => order.max(n + 1, first),
    }
    let high = match hi {
        Unbounded => end,
        Included(n) => order.min(n + 1, end),
        Excluded(n) => order.min(n, end),
    }
    let mut rows = log_range(tx, events, lo, hi)?
    let mut seq = low
    while let Some((observed, value)) = next_in(tx, mut rows)? {
        if seq >= high || observed != seq || value != log_entry(seq) {
            return Ok(1)
        }
        seq += 1
    }
    if seq < high && low < high {
        return Ok(1)
    }
    Ok(0)
}

fn log_ranges_check(tx: Tx, events: Log[Bytes], first: u64, end: u64) -> Result[u64, Error] {
    let mut misses = 0u64
    misses += log_range_matches(tx, events, Unbounded, Unbounded, first, end)?
    misses += log_range_matches(tx, events, Included(17), Excluded(203), first, end)?
    misses += log_range_matches(tx, events, Excluded(99), Included(100), first, end)?
    misses += log_range_matches(tx, events, Included(end - 1), Unbounded, first, end)?
    misses += log_range_matches(tx, events, Included(end + 5), Unbounded, first, end)?
    misses += log_range_matches(tx, events, Unbounded, Excluded(first + 3), first, end)?
    Ok(misses)
}

fn log_ranges_look(db: Db, events: Log[Bytes], first: u64, end: u64) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    let fixture: Log[Bytes] = clone(events)
    let Seen(seen) = look(read_handle, s, Some(10000000), copy_env((fixture, first, end)), fn(tx: Tx, env: (Log[Bytes], u64, u64)) -> Result[u64, Error] {
        log_ranges_check(tx, env.0, env.1, env.2)
    })? else {
        fail("Tiered Log: the look runs")
    }
    let Ok(0) = view seen.value else {
        fail("Tiered Log: log_range yields each appended entry inside its bounds, in order")
    }
    drop(take s)
    drop(take read_handle)
    Ok(())
}

fn log_append_entries(mut db: Db, events: Log[Bytes], from: u64, to: u64) -> Result[(), Error] waits {
    let fixture: Log[Bytes] = clone(events)
    let Committed(_) = run(mut db, Some(100000000), copy_env((fixture, from, to)), fn(mut tx: Tx, env: (Log[Bytes], u64, u64)) -> Result[(), Error] {
        for seq in env.1 .. env.2 {
            if append(mut tx, env.0, log_entry(seq))? != seq {
                fail("Tiered Log: appends take dense sequence numbers")
            }
        }
        Ok(())
    })? else {
        fail("Tiered Log: the appends commit")
    }
    Ok(())
}

// §14.10 on a Tiered Log: a Log moved to Tiered by `set_residency` reads its
// ranges through the Cold tree, across leaf boundaries, with bounds clipped
// to [first, next). A write Tx's range reads committed Cold rows and then its
// own staged appends. A trim raises `first`. After reopen the ranges read
// the Cold tree plus replay's overlay of the appends after the last cut.
@test
fn test_tiered_log_range_reads_cold_leaves_and_staged_tail(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let mut declaring = declare(db, Migrate)?
    let events = declare_log(mut declaring, "events", std.codec.of_bytes(), Forever)?
    let _ = seal(mut db, take declaring)?
    log_append_entries(mut db, events, 0, 300)?
    {
        let Some((root, _)) = std.page.collection_entry(pages.holder_heads(db.holders)[0u64].roots.collections.root, prefix(events.binding.id)?) else {
            fail("Tiered Log: main has the Log")
        }
        if std.page.level(std.page.image_of(root)) == 0 {
            fail("Tiered Log: the fixture Log spans more than one leaf")
        }
    }
    set_residency(mut db, events.binding.id, Tiered)?
    if residency_mode(db, events.binding.id)? != (LogCollection, ResidentTiered) {
        fail("Tiered Log: main's descriptor names the Log Tiered")
    }
    {
        let Some((ColdPage(_), _)) = std.page.collection_slot(pages.holder_heads(db.holders)[0u64].roots.collections.root, prefix(events.binding.id)?) else {
            fail("Tiered Log: the residency cut leaves the Log's root Cold")
        }
    }
    log_ranges_look(db, events, 0, 300)?
    // A write Tx reads its committed Cold rows, then its staged tail.
    let fixture: Log[Bytes] = clone(events)
    let Committed(_) = run(mut db, Some(100000000), copy_env(fixture), fn(mut tx: Tx, l: Log[Bytes]) -> Result[(), Error] {
        for seq in 300u64 .. 303 {
            let _ = append(mut tx, l, log_entry(seq))?
        }
        if log_range_matches(tx, l, Included(290), Unbounded, 0, 303)? != 0 {
            fail("Tiered Log: a write Tx's range reads Cold rows and then its staged appends")
        }
        trim_before(mut tx, l, 150)
    })? else {
        fail("Tiered Log: the append and trim commit")
    }
    let _ = checkpoint(mut db)?
    log_ranges_look(db, events, 150, 303)?
    // These appends are journaled after the last cut, so reopen replays them.
    log_append_entries(mut db, events, 303, 320)?
    close(take db)?
    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    log_ranges_look(reopened, events, 150, 320)?
    close(take reopened)
}

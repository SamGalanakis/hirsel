// RUNNER-SPEC v2.70 F6's measurement: the same bind child with and without the
// bind mint's serial send/receive. The binding verifies one ES256 JWT. The
// direct arm reproduces v2.60's Latest read; the minted arm uses the landed fold.
type CostSeed: shareable + send {
    keys: std.jwt.PublicKeys,
    clock: Clock
}

const BINDS: u64 = 2000u64

// jwtbind's published child bounds (jwtbind.hirsel J4): the same in both arms.
const COST_BIND_BYTES: u64 = 262144u64

const COST_BIND_STEPS: u64 = 1048576u64

const COST_MINT_BYTES: u64 = 4096u64

const ISSUER: String = "https://issuer.example"

const AUDIENCE: String = "api://bench"

// ES256/P-256, exp 2000000000 (2033-05-18), signed once by Python cryptography
// for this measurement. Its public key is the sole key in COST_JWKS.
const COST_TOKEN: String = "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImJlbmNoIn0.eyJpc3MiOiJodHRwczovL2lzc3Vlci5leGFtcGxlIiwiYXVkIjoiYXBpOi8vYmVuY2giLCJzdWIiOiJiZW5jaC11c2VyIiwiZXhwIjoyMDAwMDAwMDAwLCJpYXQiOjE3NjAwMDAwMDB9.3mnW6BhO4UzzJJagd-ZDK7Q6NScuKRz9Y7WB6x0zPzE0msohvqzqbWFyrwEsW3Y0cahz_r3T2fXGqC7ckcAeww"

const COST_JWKS: String = "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"kid\":\"bench\",\"x\":\"LePZ2ETQyDlbsYQ-7nBPhUxEdj9Byi_MOrGinxqMb0E\",\"y\":\"h3_M7WcRsudnhLIFfnGsZzJarhAAwgdxO25tXspwQYM\",\"use\":\"sig\",\"alg\":\"ES256\"}]}"

fn cost_credential() -> Bytes {
    clone(string.as_bytes(COST_TOKEN))
}

// The jwtbind bind path's costly core: ASCII/token decoding, claim rules and one
// ES256 verification over the Latest snapshot, then the caller map.
fn verify_snapshot(snapshot: Arc[CostSeed], supplied: Bytes) -> Result[BoundCaller, BindRefusal] {
    for b in supplied {
        if b >= 0x80u8 {
            return Error(Rejected)
        }
    }
    let Ok(token) = string.from_utf8(clone(supplied)) else {
        return Error(Rejected)
    }
    let wall_ms = host.wall_ms(snapshot.clock)
    let now_secs = wall_ms / 1000u64
    let rules = std.jwt.Rules(allow: std.jwt.allow(Es256), now_secs: now_secs, leeway_secs: 60u64, iss: Some(string.from(ISSUER)), aud: Some(string.from(AUDIENCE)), require_exp: true)
    let jwt = match std.jwt.verify_jwt_public(token, rules, snapshot.keys) {
        Ok(take j) => take j,
        Error(_) => return Error(Rejected),
    }
    let exp = match jwt.claims.exp {
        Some(e) => e,
        None => return Error(Rejected),
    }
    let Some(sub) = view jwt.claims.sub else {
        return Error(Rejected)
    }
    let size = string.byte_len(sub)
    if size == 0u64 || size > SUBJECT_MAX {
        return Error(Rejected)
    }
    let Some(end_s) = int.checked_add(exp, 60u64) else {
        return Error(Rejected)
    }
    let Some(expires_at_ms) = int.checked_mul(end_s, 1000u64) else {
        return Error(Rejected)
    }
    let subject: Bytes = clone(string.as_bytes(sub))
    Ok(BoundCaller(caller: store.Caller(issuer: 9u8, subject: take subject), expires_at_ms: Some(expires_at_ms)))
}

fn cost_binding(seed: Latest[CostSeed], supplied: Bytes) -> Result[BoundCaller, BindRefusal] {
    verify_snapshot(latest.read(seed), supplied)
}

// v2.60's direct arm: the requester reads the Latest and the child receives
// the snapshot, with no mint queue. The minted arm reads the mint-copied handle
// inside its bind child.
fn cost_direct_binding(snapshot: Arc[CostSeed], supplied: Bytes) -> Result[BoundCaller, BindRefusal] {
    verify_snapshot(snapshot, supplied)
}

fn cost_mint(seed: Latest[CostSeed], unused_handles: (), _input: ()) -> Result[Latest[CostSeed], Capacity] {
    Ok(latest.handle(seed))
}

fn one_direct(tasks: Tasks, clock: Clock, root: Latest[CostSeed], credential: Bytes) -> bool waits {
    let job = BindingJob(grant: latest.read(root), bind: code.describe(cost_direct_binding), credential: clone(credential), steps: COST_BIND_STEPS)
    match unexpired(clock, bound_caller(tasks, take job, COST_BIND_BYTES)) {
        Ok(_) => true,
        Error(_) => false,
    }
}

fn one_minted(tasks: Tasks, clock: Clock, supplied: Option[BindGrant[Latest[CostSeed]]], credential: Bytes) -> bool waits {
    let Some(take ask) = bind_ask(supplied, Some(clone(credential))) else {
        return false
    }
    let (take job, allowance) = match minted_binding(take ask) {
        Ok(take made) => take made,
        Error(_) => return false,
    }
    match unexpired(clock, bound_caller(tasks, take job, allowance)) {
        Ok(_) => true,
        Error(_) => false,
    }
}

fn print_line(out: Stdout, mut line: String) -> () waits {
    string.push(mut line, "\n")
    result.unwrap(stdout.write(out, line))
}

pub fn mint_cost_main(clock: Clock, tasks: Tasks, argv: Args, input: Stdin, out: Stdout) -> Result[(), Exit] waits {
    let Some(mode) = args.get(argv, 0) else {
        return Error(Exit(status: 2))
    }
    let minted = mode == "minted"
    if !minted && mode != "direct" {
        return Error(Exit(status: 2))
    }
    let keys = result.unwrap(std.jwt.jwks_public(string.from(COST_JWKS)))
    let root = latest.new(arc.new(CostSeed(keys: take keys, clock: clock)))
    let credential = cost_credential()
    let mut running: Option[PlaceGrants[Latest[CostSeed]]] = None
    let mut supplied: Option[BindGrant[Latest[CostSeed]]] = None
    if minted {
        let mint: fn(Latest[CostSeed], (), ()) -> Result[Latest[CostSeed], Capacity] = cost_mint
        let grants: Grants[Latest[CostSeed], (), Latest[CostSeed]] = Grants(attempt: None, call: None, claim: None, bind: Some(Mint(seed: latest.handle(root), mint: mint, mint_bytes: COST_MINT_BYTES, mint_steps: DEFAULT_STEPS)))
        let started = grant_task(tasks, (), take grants)
        supplied = grant_binds_of(started, wire(code.describe(cost_binding), COST_BIND_BYTES, COST_BIND_STEPS))
        running = Some(take started)
    }
    let mut ready = string.from("READY")
    print_line(out, mut ready)
    let mut start_bytes: Bytes = list.with_capacity(1u64)
    let _ = stdin.read(input, mut start_bytes, Never)
    let mut good = 0u64
    for _ in 0u64 .. BINDS {
        let ok = if minted {
            one_minted(tasks, clock, supplied, credential)
        } else {
            one_direct(tasks, clock, root, credential)
        }
        if ok {
            good += 1u64
        }
    }
    if let Some(take started) = take running {
        stop_grants(Some(take started))
    }
    let mut done = string.from("DONE ")
    string.push_u64(mut done, good)
    print_line(out, mut done)
    let mut sum = string.from("SUM ")
    string.push_u64(mut sum, good)
    print_line(out, mut sum)
    if good == BINDS {
        Ok(())
    } else {
        Error(Exit(status: 1))
    }
}

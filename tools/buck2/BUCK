declare_platforms(
    name = "platforms",
    constraints = ["prelude//os:linux", "prelude//cpu:x86_64"],
)

constraint_setting(name = "profile")

constraint_value(name = "profile_dev", constraint_setting = ":profile", visibility = ["PUBLIC"])

constraint_value(name = "profile_release", constraint_setting = ":profile", visibility = ["PUBLIC"])

# Native runtime: LTO with cold launch/configuration crates built for size.
constraint_value(name = "profile_runtime", constraint_setting = ":profile", visibility = ["PUBLIC"])

constraint_value(name = "profile_checked", constraint_setting = ":profile", visibility = ["PUBLIC"])

constraint_value(name = "profile_profiling", constraint_setting = ":profile", visibility = ["PUBLIC"])

# Distribution builds trade build time for compiler throughput. Dev/release stay unchanged.
constraint_value(name = "profile_dist", constraint_setting = ":profile", visibility = ["PUBLIC"])

platform(
    name = "dist",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_dist",
    ],
    visibility = ["PUBLIC"],
)

# Release code with line information and walkable stacks for perf.
platform(
    name = "profiling",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_profiling",
    ],
    visibility = ["PUBLIC"],
)

# The default target platform: every first-party target, its tests and the
# tools they launch share one optimized, checked configuration.
platform(
    name = "checked",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_checked",
    ],
    visibility = ["PUBLIC"],
)

host_transition(
    name = "test_tool_transition",
    configuration_name = "root//tools/buck2:checked",
    budget = ":budget",
    panic = ":panic",
    profile = ":profile_checked",
    cpu = "prelude//cpu/constraints:x86_64",
    visibility = ["PUBLIC"],
)

# Explicit ARM libtest compilation; the ordinary test transition always stays x86.
host_transition(
    name = "aarch64_test_tool_transition",
    configuration_name = "hirsel-rust-test-aarch64",
    budget = ":budget",
    panic = ":panic",
    profile = ":profile_checked",
    cpu = "prelude//cpu/constraints:arm64",
    visibility = ["PUBLIC"],
)

# Performance budgets measure the production compiler, without test assertions.
host_transition(
    name = "release_tool_transition",
    configuration_name = "root//tools/buck2:release",
    budget = ":budget",
    panic = ":panic",
    profile = ":profile_release",
    cpu = "prelude//cpu/constraints:x86_64",
    visibility = ["PUBLIC"],
)

# Diagnostic published-table scopes are compiled out of the production compiler.
constraint_setting(name = "front_observer", visibility = ["PUBLIC"])
constraint_value(name = "front_observer_enabled", constraint_setting = ":front_observer", visibility = ["PUBLIC"])
platform(name = "front_observer_release", constraint_values = [
    "prelude//os/constraints:linux", "prelude//cpu/constraints:x86_64",
    ":profile_release", ":front_observer_enabled"], visibility = ["PUBLIC"])
host_transition(name = "front_observer_tool_transition", configuration_name = "root//tools/buck2:front_observer_release",
    budget = ":budget", panic = ":panic", profile = ":profile_release", cpu = "prelude//cpu/constraints:x86_64",
    extra_constraints = [":front_observer_enabled"], visibility = ["PUBLIC"])

constraint_setting(name = "panic")

constraint_value(name = "panic_abort", constraint_setting = ":panic", visibility = ["PUBLIC"])


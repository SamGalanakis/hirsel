// ---- The pool service (RTC-8, RTC-10) ----
// The process entry. Unit 0 runs in the caller's task with every room's adapter; each
// other unit runs in its own unit task (CONC-15), and each open room's room client runs
// in its own task. Each unit binds its own socket and makes its own inboxes, since
// neither may move between units, and reports its doors to the entry. The entry hands
// every unit all units' doors in unit order, then each runs `units.turn` and builds the
// sessions the adapters home on it.
/// The pool's settings (RTC-10 Shape). `binds` names one address per unit (port 0 takes
/// any free port; the bound address is the one sessions advertise); `until` is the
/// monotonic time every unit stops at (`u64` max in a service that runs until killed).
/// `relay` is the sibling TURN relay place, if the deployment runs one (TURN-8): every
/// room mints its admissions' credentials from it. The application sends `orders` and
/// reads `reports`.
pub type Pool[M] {
    tasks: Tasks,
    net: Net,
    clock: Clock,
    random: Random,
    binds: List[Addr],
    policy: sdp.Policy,
    session: peer.PeerLimits,
    limits: PoolLimits,
    orders: Receiver[PoolOrder[M]],
    reports: Sender[PoolReport],
    until: u64,
    relay: Option[RelayLink]
}

/// What signaling shares with the relay place (TURN-11): the master it mints with (it
/// needs `mac`), the plan both places were configured from, and where revokes go.
pub type RelayLink {
    master: Secret,
    plan: RelayPlan,
    revokes: Sender[RelayRevoke]
}

pub type ServeError = Router(router.RouterError) | Bind(NetError) | Identity | Spawn | Units

/// A unit's turn when nothing is due sooner: the bound on how long a build or a room
/// entry waits for its unit.
pub const SERVE_TICK_NS: u64 = 5000000

/// After a failed join or rejoin, the room client tries again this much later.
pub const REJOIN_NS: u64 = 1000000000

const OUT_BYTES: u64 = 1048576

const OUT_PACKETS: u64 = 1024

const SOCKET: UdpOptions = UdpOptions(slots: 256, slot_bytes: 1536)

// What the entry moves into unit `index`'s task.
type Start: cross {
    index: u16,
    units: u16,
    bind: Addr,
    net: Net,
    clock: Clock,
    random: Random,
    hello: Client[Hello],
    policy: sdp.Policy,
    session: peer.PeerLimits,
    plane: units.Plane,
    rates: router.Rates,
    pool: router.PoolBounds,
    until: u64
}

// A unit, once bound: its doors, where it takes the other units' doors, and where it
// takes builds.
type Hello: cross {
    index: u16,
    doors: units.Doors,
    roster: Client[Sibling],
    builds: Client[Build]
}

// One unit's doors, and where a build's outcome goes (unit 0).
type Sibling: cross {
    index: u16,
    doors: units.Doors,
    done: Client[Finished]
}

// A build's outcome from another unit: the built session, or the error's `Refused`
// code (`code`), since a `RouterError` may not cross units.
type Finished: cross {
    who: peer.Participant,
    built: Result[Built, u32]
}

// The error a code stands for, for the adapter, which only reads its code. A peer or
// capacity error is answered as a peer error.
fn uncode(c: u32) -> router.RouterError {
    match c {
        1 => NoRoom,
        2 => NoParticipant,
        3 => NoPublication,
        4 => Fenced,
        5 => Suspended,
        6 => Exists,
        7 => Limit(0),
        8 => Unrepresentable,
        _ => Peer(Closed),
    }
}

fn dup(d: units.Doors) -> units.Doors {
    units.Doors(control: conn.client(d.control), media: conn.client(d.media), addr: d.addr)
}

// A unit's self-signed certificate (RFC 8827 section 6.5: WebRTC pins it by its
// fingerprint in the answer, so it names no host).
fn unit_identity(r: Random, clock: Clock) -> Result[dtls.Identity, ServeError] {
    let (take key, take der) = unit_certificate(r, clock)?
    Ok(dtls.identity(take key, take der, r) ?=> |_| Identity)
}

/// A unit's key and self-signed certificate. Every unit, of this service and of any
/// other, names the same issuer, so the serial is drawn at random (63 bits, never 0):
/// RFC 5280 section 4.1.2.2 makes issuer and serial unique, and a browser that has
/// seen one certificate under a pair refuses a second one under it (Firefox's
/// `SEC_ERROR_REUSED_ISSUER_AND_SERIAL` on its second call to another unit).
pub fn unit_certificate(r: Random, clock: Clock) -> Result[(Secret, Bytes), ServeError] {
    let mut point: Bytes = list.with_capacity(65)
    let key = secret.p256_key(r, "sign(p256)", mut point) ?=> |_| Identity
    let now: i64 = int.narrow(host.wall_ms(clock) / 1000)
    let Some(start) = std.time.from_unix(now - 86400, 0) else {
        return Error(Identity)
    }
    let Some(end) = std.time.from_unix(now + 30 * 86400, 0) else {
        return Error(Identity)
    }
    let der = std.x509_build.self_signed_p256(key, r, point, serial(r), "hirsel-sfu", start, end) ?=> |_| Identity
    Ok((take key, take der))
}

fn serial(r: Random) -> u64 {
    loop {
        let mut b: Bytes = list.with_capacity(8)
        host.random(r, mut b)
        let v: u64 = list.word_be(b, 0)
        let s = v >> 1
        if s != 0 {
            return s
        }
    }
}

// Build `b` on unit `u` and park its session there.
fn build_on(mut u: units.Unit, h: Home, r: Random, b: Build) -> Result[Built, router.RouterError] {
    let (take session, take made) = build(h, r, b)?
    units.park(mut u, take session)?
    Ok(take made)
}

fn wait_until(wake: Option[u64], now: u64) -> u64 {
    let cap = now + SERVE_TICK_NS
    match wake {
        Some(t) if t < cap => t,
        _ => cap,
    }
}

// Unit `s.index` (not 0): bind, report, take the roster, then turn and build until
// `s.until`.
fn unit_task(take s: Start) -> Result[(), ServeError] waits {
    let Start(index: index, units: n, bind: bind, net: net, clock: clock, random: random, hello: take hello, policy: take policy, session: session, plane: plane, rates: rates, pool: bounds, until: until) = take s
    let (take socket, at) = host.udp_bind(net, bind, SOCKET) ?=> |e| Bind(e)
    let (doors, take control, take media) = units.inboxes(at, index, n, plane) ?=> |take e| Router(e)
    let rc: Result[(Client[Sibling], Inbox[Sibling]), Capacity] = conn.new(64, bytes ROSTER_BYTES)
    let (roster, take siblings) = rc ?=> |c| Router(Capacity(c))
    let bc: Result[(Client[Build], Inbox[Build]), Capacity] = conn.new(64, bytes BUILDS_BYTES)
    let (builds, take wanted) = bc ?=> |c| Router(Capacity(c))
    if let Error(_) = conn.send(hello, Hello(index: index, doors: take doors, roster: take roster, builds: take builds)) {
        return Error(Units)
    }
    let mut all: List[units.Doors] = list.new()
    let mut done: Option[Client[Finished]] = None
    for _ in 0u16 .. n {
        let Ok(sib) = conn.receive(siblings) else {
            return Error(Units)
        }
        let Sibling(index: _, doors: take d, done: take c) = take sib
        list.push(mut all, take d)
        done = Some(take c)
    }
    let Some(take report) = done else {
        return Error(Units)
    }
    let mut u = units.unit(random, index, all, take control, take media, OUT_BYTES, OUT_PACKETS, plane) ?=> |take e| Router(e)
    units.reserve_pool(mut u, bounds)
    units.set_rates(mut u, rates)
    let home = Home(id: unit_identity(random, clock)?, at: at, policy: take policy, limits: session)
    let mut sock = take socket
    let mut wake: Option[u64] = None
    while true {
        let now = host.mono_ns(clock)
        if now >= until {
            break
        }
        wake = units.turn(mut u, clock, mut sock, wait_until(wake, now)) ?=> |take e| Router(e)
        while let Ok(b) = conn.try_receive(wanted) {
            if !units.take_build(mut u, b.who.room) {
                continue
            }
            let who: peer.Participant = b.who
            let outcome: Result[Built, u32] = match build_on(mut u, home, random, b) {
                Ok(take made) => Ok(take made),
                Error(e) => Error(code(e)),
            }
            let _ = conn.try_send(report, Finished(who: who, built: take outcome))
        }
    }
    Ok(())
}

// ---- Room clients (RTC-10 The control plane) ----
// What a room client's task posts to unit 0, in its order: the service's own peer number
// when it changes, then the room's entries.
type Entry[M: send]: send = In(runner.room_client.RoomIn[M]) | You(Option[u32])

// What unit 0 hands a room client: a message for the room, or the end of the room.
type Outgoing[M: send]: send = Say(runner.room_client.RoomOut[M]) | Quit

type ClientStart[M: send]: send {
    room: peer.RoomId,
    dial: runner.room_client.Dial,
    entries: Sender[Entry[M]],
    ready: Sender[peer.RoomId],
    outs: Receiver[Outgoing[M]],
    clock: Clock,
    until: u64
}

// What unit 0 keeps of one room client's task.
type RoomClient[M: send] {
    room: peer.RoomId,
    entries: Receiver[Entry[M]],
    outs: Sender[Outgoing[M]],
    quitting: bool,
    task: Option[Task[()]]
}

/// A room client task's memory: its WebSocket session (`runner.wire_defaults(262144)`)
/// and the room's entries in flight.
pub const ROOM_CLIENT_BYTES: u64 = 8388608

fn room_client_task[M: codec + send](tasks: Tasks, room: peer.RoomId, take dial: runner.room_client.Dial, take ready: Sender[peer.RoomId], clock: Clock, until: u64) -> Option[RoomClient[M]] {
    let (entries_to, entries): (Sender[Entry[M]], Receiver[Entry[M]]) = channel.new(ROOM_OUT)
    let (outs, outs_from): (Sender[Outgoing[M]], Receiver[Outgoing[M]]) = channel.new(ROOM_OUT)
    let start = ClientStart(room: room, dial: take dial, entries: take entries_to, ready: take ready, outs: take outs_from, clock: clock, until: until)
    match task.try_spawn(tasks, bytes ROOM_CLIENT_BYTES, take start, run_room_client) {
        Ok(take t) => Some(RoomClient(room: room, entries: take entries, outs: take outs, quitting: false, task: Some(take t))),
        Error(_) => None,
    }
}

// One room's client: it joins, rejoins after `Lost` every `REJOIN_NS` until it gets a
// session, posts what it receives to unit 0 and marks the room ready, and sends what
// unit 0 hands it. Every blocking call is here, so a slow relay or a rejoin backoff
// delays only this room.
fn run_room_client[M: codec + send](take s: ClientStart[M]) waits {
    let ClientStart(room: room, dial: take dial, entries: take entries, ready: take ready, outs: take outs, clock: clock, until: until) = take s
    let mut joined: Option[runner.room_client.Room[M]] = None
    let mut down = true
    let mut retry_at = 0u64
    let mut was: Option[u32] = None
    while host.mono_ns(clock) < until {
        let now = host.mono_ns(clock)
        let mut moved = false
        if down && now >= retry_at {
            if let Some(take r) = replace(mut joined, None) {
                let mut c = take r
                match runner.room_client.rejoin(mut c) {
                    Ok(_) => {
                        down = false
                    },
                    Error(_) => {
                        retry_at = now + REJOIN_NS
                    },
                }
                joined = Some(take c)
            } else {
                let first: runner.room_client.Dial = clone(dial)
                let entry: Result[runner.room_client.Room[M], runner.room_client.RoomError] = runner.room_client.join(take first)
                match take entry {
                    Ok(take r) => {
                        joined = Some(take r)
                        down = false
                    },
                    Error(_) => {
                        retry_at = now + REJOIN_NS
                    },
                }
            }
        }
        if let Some(take r) = replace(mut joined, None) {
            let mut c = take r
            let mut into: List[runner.room_client.RoomIn[M]] = list.new()
            if !down {
                match runner.room_client.try_next(mut c, mut into) {
                    Ok(true) => (),
                    _ => {
                        down = true
                        retry_at = now + REJOIN_NS
                    },
                }
            }
            let me = runner.room_client.member(c).you
            if me != was {
                was = me
                if let Error(_) = channel.send(entries, You(me)) {
                    return
                }
                moved = true
            }
            for take e in into {
                if let Error(_) = channel.send(entries, In(take e)) {
                    return
                }
                moved = true
            }
            joined = Some(take c)
        }
        if moved {
            if let Error(_) = channel.send(ready, room) {
                return
            }
        }
        while let Ok(o) = channel.try_receive(outs) {
            moved = true
            match take o {
                Say(take m) => {
                    if let Some(take r) = replace(mut joined, None) {
                        let mut c = take r
                        let _ = runner.room_client.send(mut c, take m)
                        joined = Some(take c)
                    }
                },
                Quit => {
                    if let Some(take r) = replace(mut joined, None) {
                        let _ = runner.room_client.leave(take r)
                    }
                    return
                },
            }
        }
        if !moved {
            host.sleep_until(clock, now + SERVE_TICK_NS)
        }
    }
    if let Some(take r) = replace(mut joined, None) {
        let _ = runner.room_client.leave(take r)
    }
}

/// Run the pool until `p.until` (RTC-10): units 1 and up in unit tasks; unit 0, every
/// room's adapter and the application's orders here; each open room's room client in a
/// task of its own. Unit 0 never waits on a room client and never polls an idle one:
/// each turn it takes the entries of the rooms marked ready, steps every room's control
/// order and hands each room client its messages without waiting. A one-room service is
/// a pool with one `Open` queued.
pub fn serve_pool[M: codec + send](take p: Pool[M]) -> Result[(), ServeError] waits {
    let Pool(tasks: tasks, net: net, clock: clock, random: random, binds: binds, policy: policy, session: session, limits: limits, orders: take orders, reports: take reports, until: until, relay: take linked) = take p
    let n: u16 = int.narrow(list.len(binds))
    if n == 0 || n > 64 || n != limits.units {
        return Error(Units)
    }
    let plane = units.Plane(inflight: limits.inflight, rooms: limits.rooms, media_take: limits.media_take)
    let rates = router.Rates(room_pps: limits.room_pps, open_pps: limits.open_pps)
    let bounds = router.pool_bounds(int.widen(n), int.widen(limits.rooms), int.widen(limits.sessions), session)
    for k in 0u16 .. n {
        let fixed = units.fixed_bytes(k, n, plane, OUT_BYTES, OUT_PACKETS, SOCKET, bounds) + serve_bytes(k, limits.rooms)
        if fixed > limits.unit_bytes {
            return Error(Router(Capacity(Capacity(requested: fixed, available: limits.unit_bytes))))
        }
    }
    let (take socket, at) = host.udp_bind(net, binds[0], SOCKET) ?=> |e| Bind(e)
    let (doors0, take control, take media) = units.inboxes(at, 0, n, plane) ?=> |take e| Router(e)
    let hc: Result[(Client[Hello], Inbox[Hello]), Capacity] = conn.new(64, bytes HELLO_BYTES)
    let (hello, take hellos) = hc ?=> |c| Router(Capacity(c))
    let dc: Result[(Client[Finished], Inbox[Finished]), Capacity] = conn.new(1024, bytes FINISHED_BYTES)
    let (done, take finished) = dc ?=> |c| Router(Capacity(c))
    let mut running: List[Task[Result[(), ServeError]]] = list.new()
    for k in 1u16 .. n {
        let terms: sdp.Policy = clone(policy)
        let start = Start(index: k, units: n, bind: binds[int.widen(k)], net: net, clock: clock, random: random, hello: conn.client(hello), policy: take terms, session: session, plane: plane, rates: rates, pool: bounds, until: until)
        match task.spawn_unit(tasks, bytes limits.unit_bytes, take start, unit_task) {
            Ok(take t) => list.push(mut running, take t),
            Error(_) => return Error(Spawn),
        }
    }
    // Every unit's doors in unit order, then the roster to each other unit.
    let mut met: List[Option[Hello]] = list.new()
    for _ in 0u16 .. n {
        list.push(mut met, None)
    }
    for _ in 1u16 .. n {
        let Ok(h) = conn.receive(hellos) else {
            return Error(Units)
        }
        let slot: u64 = int.widen(h.index)
        if slot == 0 || slot >= list.len(met) {
            return Error(Units)
        }
        met[slot] = Some(take h)
    }
    let mut all: List[units.Doors] = list.new()
    list.push(mut all, take doors0)
    let mut rosters: List[Client[Sibling]] = list.new()
    let mut builders: List[Client[Build]] = list.new()
    for k in 1u64 .. list.len(met) {
        let Some(take h) = replace(mut met[k], None) else {
            return Error(Units)
        }
        let Hello(index: _, doors: take d, roster: take r, builds: take b) = take h
        list.push(mut all, take d)
        list.push(mut rosters, take r)
        list.push(mut builders, take b)
    }
    for r in rosters {
        for k in 0u64 .. list.len(all) {
            if let Error(_) = conn.send(r, Sibling(index: int.narrow(k), doors: dup(all[k]), done: conn.client(done))) {
                return Error(Units)
            }
        }
    }
    let mut u = units.unit(random, 0, all, take control, take media, OUT_BYTES, OUT_PACKETS, plane) ?=> |take e| Router(e)
    units.reserve_pool(mut u, bounds)
    units.set_rates(mut u, rates)
    let home = Home(id: unit_identity(random, clock)?, at: at, policy: policy, limits: session)
    let mut free: List[u64] = list.new()
    for k in 0u16 .. n {
        list.push(mut free, limits.unit_bytes - units.fixed_bytes(k, n, plane, OUT_BYTES, OUT_PACKETS, SOCKET, bounds) - serve_bytes(k, limits.rooms))
    }
    let mut pool: Rooms[M] = rooms(limits.rooms, ledger(take free, limits.sessions, session))
    let mut revokes_to: Option[Sender[RelayRevoke]] = None
    if let Some(take link) = take linked {
        let RelayLink(master: take master, plan: take plan, revokes: take to) = take link
        relay_rooms(mut pool, Relaying(master: take master, plan: take plan, random: random))
        revokes_to = Some(take to)
    }
    let ready_slots: u64 = int.widen(limits.rooms)
    let (ready_to, ready): (Sender[peer.RoomId], Receiver[peer.RoomId]) = channel.new(ready_slots + 1)
    let mut clients: List[RoomClient[M]] = list.new()
    let mut quit: List[Task[()]] = list.new()
    let mut sock = take socket
    let mut wake: Option[u64] = None
    while true {
        let now = host.mono_ns(clock)
        if now >= until {
            break
        }
        wake = units.turn(mut u, clock, mut sock, wait_until(wake, now)) ?=> |take e| Router(e)
        let after = host.mono_ns(clock)
        wall_rooms(mut pool, host.wall_ms(clock) / 1000)
        // The application's orders.
        while let Ok(o) = channel.try_receive(orders) {
            match take o {
                Open(name: name, dial: take dial, limits: room_limits, embed: take embed) => {
                    let Some(room) = open_room(mut pool, mut u, name, room_limits, take embed) else {
                        continue
                    }
                    let started: Option[RoomClient[M]] = room_client_task(tasks, room, take dial, channel.sender(ready_to), clock, until)
                    let Some(take c) = take started else {
                        return Error(Spawn)
                    }
                    list.push(mut clients, take c)
                },
                Close(name: name) => close_room(mut pool, name),
            }
        }
        // The rooms marked ready, and only those.
        while let Ok(room) = channel.try_receive(ready) {
            for i in 0u64 .. list.len(clients) {
                if clients[i].room != room {
                    continue
                }
                while let Ok(e) = channel.try_receive(clients[i].entries) {
                    match take e {
                        In(take x) => enter(mut pool, room, take x),
                        You(me) => you_in(mut pool, room, me),
                    }
                }
            }
        }
        while let Ok(f) = conn.try_receive(finished) {
            let Finished(who: who, built: take outcome) = take f
            let result: Result[Built, router.RouterError] = match take outcome {
                Ok(take b) => Ok(take b),
                Error(c) => Error(uncode(c)),
            }
            built_in(mut pool, who, take result)
        }
        step_rooms(mut pool, mut u, after)
        for take b in take_room_builds(mut pool) {
            let who = b.who
            if b.home == 0 {
                if !units.take_build(mut u, who.room) {
                    continue
                }
                let made = build_on(mut u, home, random, b)
                built_in(mut pool, who, take made)
            } else {
                let k: u64 = int.widen(b.home)
                if k > list.len(builders) {
                    built_in(mut pool, who, Error(Limit(int.widen(n))))
                } else if let Error(_) = conn.try_send(builders[k - 1], take b) {
                    built_in(mut pool, who, Error(Limit(64)))
                }
            }
        }
        units.send(mut u, clock, mut sock, after)
        // A revoke reaches the relay outside RTC-7's acknowledgement (TURN-9): the fence
        // already drops the epoch's packets, so a full queue only delays reclaiming.
        for take r in take_room_revokes(mut pool) {
            if let Some(to) = revokes_to {
                let _ = channel.try_send(to, take r)
            }
        }
        // Each room client's messages, without waiting: a client that cannot take them
        // loses them, counted against its room.
        for i in 0u64 .. list.len(clients) {
            let room = clients[i].room
            for take o in take_out(mut pool, room) {
                if let Error(_) = channel.try_send(clients[i].outs, Say(take o)) {
                    drop_out(mut pool, room)
                }
            }
        }
        for room in take_ended(mut pool) {
            for i in 0u64 .. list.len(clients) {
                if clients[i].room == room {
                    clients[i].quitting = true
                }
            }
        }
        let mut i = 0u64
        while i < list.len(clients) {
            if clients[i].quitting {
                if let Ok(()) = channel.try_send(clients[i].outs, Quit) {
                    let c = list.remove(mut clients, i)
                    let RoomClient(task: take t, ..) = take c
                    if let Some(take h) = take t {
                        list.push(mut quit, take h)
                    }
                    continue
                }
            }
            i += 1
        }
        for take r in take_reports(mut pool) {
            let _ = channel.try_send(reports, take r)
        }
    }
    for take c in clients {
        let RoomClient(outs: take to, task: take t, ..) = take c
        let _ = channel.send(to, Quit)
        if let Some(take h) = take t {
            list.push(mut quit, take h)
        }
    }
    for take h in quit {
        let _ = task.join(take h)
    }
    for take t in running {
        let _ = task.join(take t)
    }
    Ok(())
}

// ---- RTC-10 Sizing ----
/// The memory terms of one room (RTC-10): what every unit replicates, what one homed
/// participant and one remote down-track add, and what the room holds on the control
/// unit. `bridge` and `cascade` are 0: a room's MoQ bridge (MOQ-8) and cascade links
/// (CAS-6) are attached after it opens, and their sizes are not functions of these
/// limits.
pub type RoomCost {
    replicated: u64,
    per_session: u64,
    per_remote: u64,
    control: u64,
    bridge: u64,
    cascade: u64
}

/// Price a room from the bounds the router, the sessions and the adapter allocate
/// with (RTC-10 Sizing). `control` is the adapter and its tables at the room's bounds,
/// and the room client task's grant (`ROOM_CLIENT_BYTES`). It leaves out what the
/// caller owns or the peers size: the room client's membership, its Dial and Embed,
/// the room's entry and message channels (sized by the application's message type),
/// and SDP and ICE text (`peer.session_heap`).
pub fn room_cost(limits: router.RoomLimits, session: peer.PeerLimits) -> RoomCost {
    let per_session = int.saturating_add(router.member_bytes(limits, session), peer.session_heap(session))
    RoomCost(replicated: router.room_replicated(limits), per_session: per_session, per_remote: router.remote_bytes(session), control: control_bytes(limits), bridge: 0, cascade: 0)
}

// The adapter and its tables at the room's bounds: a seat and a fence entry per id,
// a build and a gone entry per participant, a publication per participant and slot;
// and the room client task with its grant.
fn control_bytes(limits: router.RoomLimits) -> u64 {
    let ids: u64 = int.widen(limits.ids)
    let participants: u64 = int.widen(limits.participants)
    let pubs = participants * int.widen(limits.publications)
    let client = option.unwrap(charge.task(0, ROOM_CLIENT_BYTES))
    bytes[Adapter[u8]] + priced(bytes[Seat], ids) + priced(bytes[(peer.Gen, u32)], ids) + priced(bytes[Build], participants) + priced(bytes[(peer.Gen, u16)], participants) + priced(bytes[Pub], pubs) + client
}

/// What unit `index` holds for the pool besides its own unit state (`units.fixed_bytes`):
/// a worker its roster and build inboxes; the control unit the hello and finished
/// inboxes and the ready channel of `most` rooms.
pub fn serve_bytes(index: u16, most: u32) -> u64 {
    if index != 0 {
        return ROSTER_BYTES + BUILDS_BYTES
    }
    let ready: u64 = int.widen(most)
    HELLO_BYTES + FINISHED_BYTES + option.unwrap(charge.channel(bytes[peer.RoomId], ready + 1))
}

const ROSTER_BYTES: u64 = 65536

const BUILDS_BYTES: u64 = 4194304

const HELLO_BYTES: u64 = 65536

const FINISHED_BYTES: u64 = 4194304

fn priced(element: u64, capacity: u64) -> u64 {
    option.unwrap(charge.seq(element, capacity))
}

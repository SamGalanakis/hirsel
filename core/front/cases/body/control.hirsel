// LANG-6, LANG-15 by hand: if/else values, while and loop with break values, labels,
// continue to an outer loop, short-circuit, early return.
// expect: accept
// expect: run max(3,9) = 9
// expect: run max(9,3) = 9
// expect: run sum_to(4) = 10
// expect: run first_over(10) = 16
// expect: run both(0) = false
// expect: run both(4) = true
// expect: run either(0) = true
// expect: run classify(0) = 0
// expect: run classify(5) = 1
// expect: run classify(50) = 2
// expect: run triangle(3) = 6
// expect: run early(9) = 5
// expect: run early(2) = 2

fn max(a: u32, b: u32) -> u32 { if a < b { b } else { a } }

fn sum_to(n: u32) -> u32 {
  let mut s: u32 = 0
  let mut i: u32 = 1
  while i <= n {
    s += i
    i += 1
  }
  s
}

fn first_over(n: u32) -> u32 {
  let mut x: u32 = 1
  loop {
    if x > n { break x }
    x *= 2
  }
}

// `10 / x` would fail with Division at 0; the right side is skipped there.
fn both(x: u32) -> bool { x != 0 && 10 / x > 1 }
fn either(x: u32) -> bool { x == 0 || 10 / x > 1 }

fn classify(x: u32) -> u32 {
  'done: {
    if x == 0 { break 'done 0 }
    if x < 10 { break 'done 1 }
    2
  }
}

// Pairs j <= i for i, j in 1..=n: n(n+1)/2.
fn triangle(n: u32) -> u32 {
  let mut c: u32 = 0
  let mut i: u32 = 0
  'outer: while i < n {
    i += 1
    let mut j: u32 = 0
    while j < n {
      j += 1
      if j > i { continue 'outer }
      c += 1
    }
  }
  c
}

fn early(x: u32) -> u32 {
  if x > 5 { return 5 }
  x
}

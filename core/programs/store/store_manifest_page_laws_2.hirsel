fn check_paged_inventory(d: Dir) -> Result[(), Error] waits {
    let path = disk_test_directory(d)
    let (id, take page_record) = disk_read_page_manifest("MANIFEST", page_manifest_vector())?
    failure_result_from_rep(manifest.disk_write_synced(path, "p-1", manifest.page_data_pack_vector()))?
    failure_result_from_rep(manifest.disk_write_synced(path, "p-2", page_list_pack_vector()))?
    let validated = validate_page_manifest(path, id, take page_record)?
    {
        let Some(data_pack) = map.get(validated.inventory, 1u64) else {
            return Error(Foreign)
        }
        let Some(list_pack) = map.get(validated.inventory, 2u64) else {
            return Error(Foreign)
        }
        if data_pack.class != 0 || data_pack.payload_bytes != 33 || list_pack.class != 2 || list_pack.live != 69 || list_pack.payload_bytes != 69 {
            return Error(Foreign)
        }
    }
    let locations = failure_result_from_rep(manifest.rebuild_page_locations(validated))?
    let Some(data) = manifest.disk_index_get(locations.frames, 1) else {
        return Error(Foreign)
    }
    let Some(listed) = manifest.disk_index_get(locations.frames, 2) else {
        return Error(Foreign)
    }
    if data.place.pack != 1 || data.place.offset != 72 || list.len(data.incoming) != 1 || data.incoming[0u64] != HolderSource(0, 0, 1) || listed.place.pack != 2 || listed.place.offset != 72 || list.len(listed.incoming) != 1 || listed.incoming[0u64] != ListSource(0) {
        return Error(Foreign)
    }
    let root_ptrs: pages.LocatedRoots = clone(validated.manifest.branches[0u64].roots)
    let inline = validated.manifest.inline
    let manifest.ValidatedPageManifest(graph: take resolved, ..) = take validated
    let mut graph = take resolved
    let empty_collection = std.page.empty(0, 0, Collection)
    let page_nodes = failure_result_from_rep(manifest.attach_page_graph(mut graph, empty_collection))?
    let roots = pages.attach_page_roots(page_nodes, root_ptrs, inline, empty_collection)
    let mut key: Bytes = list.with_capacity(1)
    list.push(mut key, 16u8)
    let Some(value) = pages.get_page_row(roots.streams, key) else {
        return Error(Foreign)
    }
    if value != string.as_bytes("x") || pages.one_page_account(roots) != 78 {
        return Error(Foreign)
    }
    // The checked pointer reads the inner PAGE. The file's only frame after
    // HEADER is the extension containing it, so the offset cannot be live.
    failure_result_from_rep(manifest.disk_write_synced(path, "p-2", page_planted_pack_vector()))?
    failure_result_from_rep(manifest.disk_write_synced(path, "MANIFEST", page_planted_manifest_vector()))?
    failure_result_from_rep(manifest.disk_write_synced(path, "MANIFEST.tmp", string.as_bytes("tmp")))?
    failure_result_from_rep(manifest.disk_write_synced(path, "p-3", string.as_bytes("leftover")))?
    match read_selected_page_manifest(path) {
        Error(Corrupt(Fault(why: Malformed, offset: 88, ..))) => (),
        _ => return Error(Foreign),
    }
    if !failure_result_from_rep(journal.disk_exists(path, "MANIFEST.tmp"))? || !failure_result_from_rep(journal.disk_exists(path, "p-3"))? {
        return Error(Foreign)
    }
    failure_result_from_rep(manifest.disk_write_synced(path, "MANIFEST", page_manifest_vector()))?
    failure_result_from_rep(manifest.disk_write_synced(path, "p-2", page_list_pack_vector()))?
    let _ = read_selected_page_manifest(path)?
    if failure_result_from_rep(journal.disk_exists(path, "MANIFEST.tmp"))? || failure_result_from_rep(journal.disk_exists(path, "p-3"))? {
        return Error(Foreign)
    }
    Ok(())
}

pub fn disk_law_paged_inventory(d: Dir) -> bool waits {
    match check_paged_inventory(d) {
        Ok(()) => true,
        Error(_) => false,
    }
}

@test
fn disk_test_paged_inventory(d: Dir) -> Result[(), Error] waits {
    check_paged_inventory(d)
}

// The HEADER of `raw` resealed with another format word.
fn format_header(ctx: format.DiskContext, raw: Bytes, word: u32) -> Result[Bytes, Error] {
    let mut payload = failure_result_from_rep(types.copied(list.slice(raw, 16, 72)))?
    list.set_word_le(mut payload, 8, word)
    failure_result_from_rep(types.capacity(format.disk_seal(ctx, 0, 0x0001, 1, payload)))
}

// L99 (§11.1 rule 6): a directory whose MANIFEST names another format word is
// `Unsupported(word)` at the HEADER read and is left byte-unchanged.
fn refuse_directory_format(d: Dir, c: Clock, r: Random, tasks: Tasks, id: StoreId, word: u32) -> Result[(), Error] waits {
    let directory = disk_test_directory(d)
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 1, seq: 1)
    let current = failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), manifest.page_manifest_empty(limits_to_rep(default_limits()))))?
    let mut page_record = format_header(ctx, current, word)?
    list.append(mut page_record, list.slice(current, 72, list.len(current)))
    let scratch = string.as_bytes("unselected")
    failure_result_from_rep(manifest.disk_write_synced(directory, "MANIFEST", page_record))?
    failure_result_from_rep(manifest.disk_write_synced(directory, "MANIFEST.tmp", scratch))?
    let lock = failure_result_from_rep(journal.disk_lock(directory, c, 0))?
    let observed: u64 = int.widen(word)
    match open(tasks, directory, c, r, journal_crash_options()) {
        Error(Unsupported(found)) if found == observed => (),
        _ => return Error(Missing("directory format refusal")),
    }
    failure_result_from_rep(manifest.disk_io(host.close(take lock)))?
    if failure_result_from_rep(manifest.disk_read_paged_file(directory, "MANIFEST", list.len(page_record)))? != page_record || failure_result_from_rep(manifest.disk_read_paged_file(directory, "MANIFEST.tmp", list.len(scratch)))? != scratch || failure_result_from_rep(journal.disk_exists(directory, "j-1"))? {
        return Error(Missing("directory changed after format refusal"))
    }
    let retired = failure_result_from_rep(types.capacity(format.disk_seal(ctx, 72, 0x0030, 1, list.new())))?
    let mut unknown = failure_result_from_rep(types.copied(list.slice(current, 0, 72)))?
    list.append(mut unknown, retired)
    match disk_read_page_manifest("MANIFEST", unknown) {
        Error(Unsupported(0x0030)) => Ok(()),
        _ => Error(Missing("manifest unknown mandatory kind refusal")),
    }
}

fn refuse_frozen_bucket(id: StoreId) -> Result[(), Error] {
    let mut raw: Bytes = list.with_capacity(72 + format.BINDING_BYTES)
    let head = format.DiskContext(store: store_key_to_rep(id), role: 7, seq: 1)
    failure_result_from_rep(types.capacity(format.history_append_header(mut raw, head, 2, 1)))?
    match failure_result_from_rep(history.history_head_frame(format_header(head, raw, 9u32)?)) {
        Error(Unsupported(9)) => (),
        _ => return Error(Missing("bucket head format refusal")),
    }
    list.clear(mut raw)
    let manifest = format.DiskContext(store: store_key_to_rep(id), role: 1, seq: 1)
    failure_result_from_rep(types.capacity(format.history_append_header(mut raw, manifest, 2, 1)))?
    let old = format_header(manifest, raw, 9u32)?
    let reference = pages.HistoryRef(seq: 1, epoch: 2, len: list.len(old), digest: std.check.xxh3(old, 0, list.len(old)))
    match failure_result_from_rep(history.history_object_context("m-1", store_key_to_rep(id), 1, reference, old)) {
        Error(Unsupported(9)) => Ok(()),
        _ => Error(Missing("bucket object format refusal")),
    }
}

fn refuse_stream_format() -> Result[(), Error] {
    let sid = HostStreamId(hi: 3, lo: 4)
    let mut raw: Bytes = list.with_capacity(72 + format.BINDING_BYTES)
    let ctx = failure_result_from_rep(format.stream_header(mut raw, host_stream_id_to_rep(sid), 11, 1, 2, 1))?
    match failure_result_from_rep(manifest.stream_read_header("reg", format_header(ctx, raw, 9u32)?, host_stream_id_to_rep(sid), 11)) {
        Error(Unsupported(9)) => Ok(()),
        _ => Error(Missing("stream format refusal")),
    }
}

@test
fn disk_test_format_cutover(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let id = StoreId(hi: 1, lo: 2)
    // Retired formats and the next format word all refuse before modifying files.
    for word in[9u32, 11u32, 12u32, 13u32, 14u32, 16u32] {
        refuse_directory_format(d, c, r, tasks, id, word)?
    }
    refuse_frozen_bucket(id)?
    refuse_stream_format()
}

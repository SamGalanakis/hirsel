def say(message):
    print(f'main-runs: {message}', flush=True)


def git(*arguments, cwd=None):
    return subprocess.run(['git', *arguments], cwd=cwd or TREE, check=True, capture_output=True, text=True).stdout.strip()


class TableError(ValueError):
    """Exception configuration is unusable; no stages may run."""


class SelectionError(ValueError):
    """A requested manual selection matches no work."""


def table(path, columns=4):
    """Strict exception rows, following conformance's reasoned, unique pending entries.

    See crates/hirsel-conformance/src/lib.rs (pending/gate). Unlike pending,
    these tables retain authored order and accept target and case identities.
    """
    found = {}
    for number, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip() or line.startswith('#'):
            continue
        fields = line.split('\t')
        problem = None
        if len(fields) != columns:
            problem = f'expected {columns} tab-separated columns, got {len(fields)}'
        elif any(not value.strip() for value in fields):
            problem = f'empty required field {next(i + 1 for i, value in enumerate(fields) if not value.strip())}'
        elif fields[0] in found:
            problem = f'duplicate identity {fields[0]!r}'
        elif not re.fullmatch(r'\d{4}-\d{2}-\d{2}', fields[3]):
            problem = 'date must be YYYY-MM-DD'
        else:
            try:
                date.fromisoformat(fields[3])
            except ValueError:
                problem = f'invalid date {fields[3]!r}'
        if problem:
            raise TableError(f'{path}:{number}: {problem}')
        found[fields[0]] = fields
    return found


def stage_plan(tier):
    planned = {}
    stages(lambda name, command, **_: planned.update({name: command}), tier, planning=True)
    return planned


def selection_plan(tier, selections=()):
    if not selections:
        return stage_plan(tier), tier, None
    selections = sorted(set(value.rstrip('/') for value in selections))
    if any(not value for value in selections):
        raise SelectionError('an empty selection is not allowed')
    paths = [value for value in selections if value == 'conformance' or value.startswith('conformance/')]
    preparation = 'Buck2 toolchains and pool configuration'
    if paths:
        if len(paths) != len(selections):
            raise SelectionError('choose corpus paths or stage names in one invocation')
        all_cases = [path.relative_to(TREE).as_posix() for path in (TREE / 'conformance').rglob('*.hir')
                     if 'reports' not in path.relative_to(TREE / 'conformance').parts]
        prefixes = [value + '/' if (TREE / value).is_dir() else value for value in paths]
        if missing := [value for value in prefixes if not any(case.startswith(value) for case in all_cases)]:
            raise SelectionError('no corpus cases match: ' + ', '.join(missing))
        name = 'interpreter selection: ' + ', '.join(paths)
        command = ['tools/corpus', '--slices', '32', '--report-json', '{report}', *paths]
        inventory = sorted(case for case in all_cases if any(case.startswith(value) for value in prefixes))
        plan = {preparation: [PY, 'tools/buck2/prepare.py'], name: command}
        return plan, 'conformance', (name, command, inventory)
    catalog = stage_plan(tier)
    selected = set()
    for value in selections:
        matches = {name for name in catalog if name == value or name.startswith(value)}
        if not matches:
            raise SelectionError(f'no stages match {value!r} in tier {tier}')
        selected.update(matches)
    selected.add(preparation)
    return {name: command for name, command in catalog.items() if name in selected}, tier, None


def exception_tables():
    tables, revisions = {}, {}
    for name in ('main-runs-skip.tsv', 'known-failures.tsv'):
        path = TREE / 'tools' / name
        try:
            tables[name] = table(path)
            revisions[name] = dict(path=f'tools/{name}', sha256=hashlib.sha256(path.read_bytes()).hexdigest())
        except OSError as error:
            raise TableError(f'{path}: {error.strerror}') from error
    allowed = stage_plan('full')
    path = TREE / 'tools/main-runs-skip.tsv'
    for number, line in enumerate(path.read_text().splitlines(), 1):
        if line.strip() and not line.startswith('#') and line.split('\t')[0] not in allowed:
            raise TableError(f'{path}:{number}: unknown skip stage {line.split(chr(9))[0]!r}')
    return tables['main-runs-skip.tsv'], tables['known-failures.tsv'], revisions


def rows():
    # Observation status is archival evidence, not an attribution input. Keep
    # only the fields tick/attribute use, releasing each decoded row in turn.
    history = []
    if ROWS.exists():
        with ROWS.open() as source:
            while True:
                offset = source.tell()
                line = source.readline()
                if not line:
                    break
                if line.strip():
                    row = json.loads(line)
                    history.append(dict({key: row[key] for key in
                                    ('sha', 'tier', 'stages', 'reds', 'configuration_error', 'start', 'report', 'results_path') if key in row},
                                        history_offset=offset))
                    del row
    return sorted(history, key=lambda row: row.get('start', 0))


def checkout(tree, sha):
    if not (tree / '.git').exists():
        tree.parent.mkdir(parents=True, exist_ok=True)
        git('worktree', 'add', '-f', '--detach', str(tree), sha)
    git('checkout', '-q', '-f', '--detach', sha, cwd=tree)
    git('clean', '-fdq', cwd=tree)


def covers(row, tier):
    return row.get('configuration_error') is None and (tier == 'fast' or row.get('tier', 'full') == 'full')


def tick(tier, selections=(), *, force=False):
    RUNS.mkdir(parents=True, exist_ok=True)
    handle = open(RUNS / 'main-runs.lock', 'a+')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | (fcntl.LOCK_NB if force or tier == 'fast' else 0))
    except BlockingIOError:
        return say('busy: a run is still going') or (1 if force else 0)
    git('fetch', '-q', 'origin', 'main')
    sha = git('rev-parse', 'refs/remotes/origin/main')
    if not force and (covered := [r for r in rows() if covers(r, tier)]) and covered[-1]['sha'] == sha:
        return say(f'skip: the last {tier} run checked origin/main {sha[:12]}') or 0
    checkout(RUN_TREE, sha)
    os.set_inheritable(handle.fileno(), True)  # the lock stays held through the run
    os.execv(PY, [PY, str(RUN_TREE / 'tools/main-runs'), '--run', sha, '--tier', tier,
                 *[arg for selection in selections for arg in ('--select', selection)]])


def manual_stages(stage, tier, config):
    """Explicit corpus and tracing profiles, also available in the full tier."""
    buck2 = [PY, 'tools/buck2/event_logs.py']
    if tier in ('conformance', 'full'):
        corpus_root = TREE / 'conformance'
        corpus_paths = [path.relative_to(TREE).as_posix() for path in corpus_root.rglob('*.hir')
                        if 'reports' not in path.relative_to(corpus_root).parts]
        for directory in sorted({path.split('/')[1] for path in corpus_paths}):
            prefix = f'conformance/{directory}'
            stage(f'interpreter conformance: {prefix}',
                  ['tools/corpus', '--slices', '32', '--report-json', '{report}', prefix], corpus=True,
                  corpus_inventory=sorted(path for path in corpus_paths if path.split('/')[1] == directory))
    if tier in ('native-smoke', 'full'):
        smoke_file = TREE / 'native-tests/regressions/smoke.txt'
        smoke = [line.strip() for line in (smoke_file.read_text().splitlines() if smoke_file.exists() else [])
                 if line.strip() and not line.startswith('#') and line.startswith('conformance/')]
        if smoke:
            stage('native conformance smoke', ['tools/corpus', '--native', '--slices', '48', '--parts', '1', '--report-json', '{report}', *smoke], corpus=True)
    if tier in ('ownership-trace', 'full'):
        # These exact registry entries require the diagnostic runtime. Positive
        # libtest filters select them on shard 1, independent of measured sharding.
        registry = json.loads((TREE / 'tools/ignored-tests.json').read_text()) if (TREE / 'tools/ignored-tests.json').exists() else {}
        traced = {}
        for identity, home in registry.items():
            if 'hirsel.ownership_trace=true' in home.get('config', []) and not home['inputs']:
                key = home.get('target', '//:hirsel-cli-test-cli-shard-1'), identity.split('::')[0]
                traced.setdefault(key, []).append(identity)
        for (target, module), identities in sorted(traced.items()):
            stage(f'ownership trace: {target.split(":")[-1]}/{module}',
                  [*buck2, 'test', *config, '-c', 'hirsel.tests=focus', '-c', 'hirsel.ownership_trace=true', target,
                   '--', '--test-arg=--ignored', '--test-arg=--exact', *[f'--test-arg={identity}' for identity in identities]])


def stages(stage, tier, *, planning=False):
    """Run the tier's stages, one `stage(name, command)` each: fast is a prefix of full."""
    seed = str(int.from_bytes(os.urandom(4), 'little'))  # a new seed: no cached pass of the seeded tests
    config = ['-c', 'hirsel.full=true', '-c', f'hirsel.test_seed={seed}', '-c', 'hirsel.priority=40']
    if not planning:
        os.environ.update(HIRSEL_BUCK2_CONFIG=' '.join(config), HIRSEL_PRIORITY='40')
    buck2 = [PY, 'tools/buck2/event_logs.py']
    release = ['--target-platforms', '//tools/buck2:release']
    stage('Buck2 toolchains and pool configuration', [PY, 'tools/buck2/prepare.py'])
    if tier not in ('fast', 'full'):
        manual_stages(stage, tier, config)
        return
    stage('Buck2 build files and test-cost coverage', [PY, 'tools/buck2/sync.py', '--check'])
    for test in sorted((TREE / 'tools/tests').glob('*.py')):
        stage(f'tool tests: tools/tests/{test.name}', [PY, str(test)], isolated=True)
    stage('tool tests: conformance.py --self-test', [PY, 'tools/buck2/conformance.py', '--self-test'], isolated=True)
    stage('tool tests: bench/native/tests', [PY, '-m', 'unittest', 'discover', '-s', 'bench/native/tests'], isolated=True)

    def query(expression):
        if planning:
            return []
        return subprocess.run([*buck2, 'uquery', *config, expression], cwd=TREE, capture_output=True,
                              text=True, check=True).stdout.split()
    tests = query('(kind("_rust_test", //...) + attrfilter(labels, doctest, //...)) - attrfilter(labels, gate, //...) - attrfilter(labels, fixture, //...)')
    libtests = query('kind("_rust_test", //...) - attrfilter(labels, gate, //...) - attrfilter(labels, fixture, //...)')
    # hirsel-cli-test-free reserves 8 CPUs per shard, uses about 1, and found no new red in 12 fast runs
    # (kiln-usage-355: 376 of 1,280 reserved CPU-h a day). It runs in the full tier and in lanes' impact gates.
    free = [target for target in tests if target.endswith(':hirsel-cli-test-free')]
    tests = [target for target in tests if target not in free]

    def full_crate_tests(*arguments):
        return [PY, 'tools/buck2/full_gate_counts.py', '--run', *buck2, 'test', *config, *arguments,
                '--', '--test-arg=full_gate_', '--test-arg=--ignored']

    def test(*targets):
        return [*buck2, 'test', *config, *targets]
    from sync import NATIVE_FULL_SHARDS
    build_set = ('root//: - kind("_rust_test", root//:) - attrregexfilter(name, "-clippy$", root//:)'
                 ' - attrfilter(labels, gate, root//:) - kind("_link_hosts_local", root//:)'
                 ' - rdeps(root//:, kind("_hirsel_precheck", root//:))')
    stage('workspace build', [*buck2, 'build', *config, *query(build_set), '--materializations', 'none'])
    stage('workspace clippy', [PY, 'tools/buck2/clippy.py'])
    stage('formatting', [PY, 'tools/buck2/fmt.py', '--check'])
    stage('workspace tests', test(*tests), target_inventory=tests)
    # The Loom models are workspace crates (proofs/free/loom, proofs/heaps/loom), so in the stage above.
    stage('free-mode GenMC models', test('//:gate-free-genmc'))
    stage('fresh std instruction budget', [PY, 'tools/perf-counts', '--fresh-std'])
    if tier == 'fast':
        return
    manual_stages(stage, tier, config)
    stage('free-mode CLI tests', test(*free), target_inventory=free)
    stage('full gate crate tests', full_crate_tests(*libtests))
    stage('conformance validation and ratchet', [PY, 'tools/buck2/conformance.py'])
    stage('source and IR checker agreement (unrestricted)', [PY, 'tools/buck2/agree.py', '--full'])
    stage('instruction count budgets', test('//:gate-perf-counts'))
    stage('native smoke: heap, x86-64 and real Io replay', test('//:gate-native-smoke'))
    from sync import NATIVE_CORPUS_SHARDS, STD_NATIVE_SHARDS
    stage('std native compile: every public std function on both backends',
          test(*[f'//:gate-std-native-shard-{i}' for i in range(1, STD_NATIVE_SHARDS + 1)]))
    # Cranelift on every runnable case, LLVM O0 on a slice that rotates with the seed.
    stage('native corpus agreement and the GAP-seeded generator',
          test(*[f'//:gate-native-corpus-shard-{i}' for i in range(1, NATIVE_CORPUS_SHARDS + 1)], '//:gate-native-bugs'))
    stage('checker scaling: six families at N=10, 40 and 160',
          test(*[f'//:gate-checker-scaling-shard-{i}' for i in range(1, 7)]))
    stage('release tests', test(*release, *tests), target_inventory=tests)
    stage('full gate crate tests in release', full_crate_tests(*release, *libtests))
    stage('native and Lean checks', ['tools/check-native.sh'])
    stage('native matrix: both targets and named exclusions',
          test('-c', 'hirsel.native_selection=true', *[f'//:gate-native-full-shard-{i}' for i in range(1, NATIVE_FULL_SHARDS + 1)]))
    stage('agreement campaign on heap and native code (unrestricted)', [PY, 'tools/buck2/agree.py', '--native-full'])
    stage('native passing corpus with independent second hash seed', test('//:gate-native-hash-sweep'))


def failing_ids(target, details):
    """What failed in a test: libtest cases as `binary::case`, corpus cases by path."""
    binary = re.sub(r'-shard-\d+$', '', target)
    cases = re.findall(r'^test (.+?)(?: - should panic)? \.\.\. FAILED(?: <[0-9.]+s>)?$', details, re.M)
    cases += re.findall(r'^---- (.+?) stdout ----$', details, re.M)
    started = set(re.findall(r'^HIRSEL_TEST_STARTED (.+)$', details, re.M))
    cases = [case for case in cases if not started or case in started]
    ids = [f'{binary}::{case}' for case in cases] + re.findall(r'^(conformance/\S+\.hir): ', details, re.M)
    return list(dict.fromkeys(ids + re.findall(r'"path"\s*:\s*"(conformance/[^"]+\.hir)"', details)))


def first_error(details, identity=None):
    """Prefer the named libtest failure's diagnostic over its parent summary."""
    case = identity.split('::', 1)[-1] if identity else None
    if case:
        section = re.search(r'^---- ' + re.escape(case) + r' stdout ----\n(.*?)(?=^---- |^failures:|\Z)', details, re.M | re.S)
        if section:
            details = section[1]
        else:
            section = re.search(r'^test ' + re.escape(case) + r' .*?FAILED[^\n]*\n(.*?)(?=^(?:test |HIRSEL_TEST_STARTED |test result:)|\Z)', details, re.M | re.S)
            if section and section[1].strip():
                details = section[1]
    lines = [line.strip() for line in details.splitlines() if line.strip()]
    diagnostic = next((line for line in lines if re.search(r'panicked at|^error\b|Error:|assertion .*failed|expected .*got|ACCEPTED|FAILED:', line)), None)
    return diagnostic or next((line for line in lines if not line.startswith(('HIRSEL_', '----', 'running ', 'test ', 'failures:'))),
                              'no diagnostic reported')


def corpus_observations(stage, artifact, targets=None):
    """Exact interpreter verdicts, including cases excluded by the ratchet."""
    found = []
    for report in artifact['reports']:
        shard = (report.get('shard') if artifact.get('native') else report.get('selection', {}).get('shard'))
        label = f'gate-{"native" if artifact.get("native") else "conformance"}-selected-shard-{str(shard).split("/")[0]}'
        source = (targets or {}).get(label, {})
        provenance = source.get('provenance', dict(execution='unknown'))
        if artifact.get('native'):
            # Native's summary does not prove individual green cases.
            for error in report['baseline_minus_native_unlisted'] + report['stale_exclusions']:
                found.append(dict(stage=stage, target=None, identity=error.split(': ', 1)[0],
                                  known_identity=error.split(' under ', 1)[0], scope='case', state='failure',
                                  first_error=error.split(': ', 1)[-1].splitlines()[0], complete=True, ignored=False,
                                  provenance=provenance))
            continue
        complete = (report['selection']['executed'] == report['selection']['selected'] == len(report['tests'])
                    and len(artifact['reports']) == artifact.get('expected_slices', len(artifact['reports'])))
        for case in report['tests']:
            error = case.get('reason') or ''
            found.append(dict(stage=stage, target=source.get('target'), identity=case['path'], scope='case',
                              state={'pass': 'pass', 'fail': 'failure', 'not_implemented': 'unusable'}[case['status']],
                              first_error=first_error_line(error) if error else None,
                              wrongly_accepted=bool(re.search(r'-bad\.hir$', case['path']) and
                                                    re.fullmatch(r'accept(?:ed)?(?: entry)?', case.get('actual') or '', re.I)),
                              complete=complete and source.get('state') not in ('infrastructure', 'unusable'), ignored=False,
                              status=source.get('status', event_logs.FAIL if error else event_logs.PASS), provenance=provenance))
        observed = {o['identity']: o for o in found}
        for error in report.get('errors', []):
            if match := re.match(r'(conformance/\S+\.hir): (.*)', error):
                if match[1] in observed:
                    if not match[2].startswith('an in-gate file must pass, got '):
                        observed[match[1]].update(state='failure', first_error=first_error_line(match[2]))
                else:
                    found.append(dict(stage=stage, target=None, identity=match[1], scope='case', state='failure',
                                      first_error=first_error_line(match[2]), complete=False, ignored=False,
                                      wrongly_accepted=False, provenance=dict(execution='unknown')))
                    observed[match[1]] = found[-1]
    observed = {o['identity'] for o in found}
    for identity in artifact.get('selected_cases', []):
        if identity not in observed:
            found.append(dict(stage=stage, target=None, identity=identity, scope='case', state='unobserved',
                              first_error=None, complete=False, ignored=False, wrongly_accepted=False,
                              provenance=dict(execution='unknown')))
    return found


def case_observations(target, result):
    """Explicit libtest identities only; never infer a passing corpus case from a parent."""
    binary = re.sub(r'-shard-\d+$', '', target)
    details = result['details']
    started = set(re.findall(r'^HIRSEL_TEST_STARTED (.+)$', details, re.M))
    cases = [(f'{binary}::{case}', {'ok': 'pass', 'FAILED': 'failure', 'ignored': 'skipped'}[status])
             for case, status in re.findall(r'^test (.+?)(?: - should panic)? \.\.\. (ok|FAILED|ignored)\b', details, re.M)
             if not started or case in started]
    failures = {identity for identity, status in cases if status == 'failure'}
    cases += [(identity, 'failure') for identity in failing_ids(target, details) if identity not in failures]
    return cases


def complete_cases(result):
    """Libtest's declared population, terminal summary and unique result rows agree.

    This is execution scope, not a universal inventory. Whole-target recovery
    also requires all explicitly selected shards and no child selection flags.
    """
    details = result['details']
    starts = re.findall(r'^running (\d+) tests?$', details, re.M)
    summaries = re.findall(r'^test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored;', details, re.M)
    cases = re.findall(r'^test (.+?)(?: - should panic)? \.\.\. (ok|FAILED|ignored)\b', details, re.M)
    if len(starts) != 1 or len(summaries) != 1:
        return False
    counts = tuple(map(int, summaries[0]))
    return (int(starts[0]) > 0 and sum(counts) == int(starts[0]) == len(cases)
            and len({case for case, _ in cases}) == len(cases)
            and counts == tuple(sum(status == expected for _, status in cases)
                                for expected in ('ok', 'FAILED', 'ignored')))


def filtered_population(result):
    counts = re.findall(r'^test result: (?:ok|FAILED)\..*; (\d+) filtered out;', result['details'], re.M)
    return int(counts[0]) if len(counts) == 1 else None


def lifecycle(known, observations, selections, revisions):
    """Every exception's observations survive suppression; absence stays unknown."""
    entries, by_identity, by_binary = [], {}, {}
    for observation in observations:
        by_identity.setdefault(observation['identity'], []).append(observation)
        if observation['scope'] == 'target':
            binary = re.sub(r'-shard-\d+$', '', observation['target'])
            by_binary.setdefault(binary, []).append(observation)
    for identity, row in known.items():
        exact = by_identity.get(identity, [])
        # A binary-wide exception covers its shards as it does for red suppression.
        target_scope = '::' not in identity and not identity.startswith(('conformance/', 'stage: '))
        matched = ([o for o in by_binary.get(re.sub(r'-shard-\d+$', '', identity), [])
                    if o['target'] == identity or re.sub(r'-shard-\d+$', '', o['target']) == identity]
                   if target_scope else exact)
        recoveries = []
        if target_scope:
            for selection in selections:
                expected = {arg.split(':')[-1] for arg in selection['command'] if arg.startswith(('//:', 'root//:'))
                            and (arg.split(':')[-1] == identity or
                                 re.sub(r'-shard-\d+$', '', arg.split(':')[-1]) == identity)}
                selected = [o for o in matched if o['stage'] == selection['stage']]
                # Arbitrary wrappers, filters and empty/partial shard sets prove no whole target.
                inventory = {label.split(':')[-1] for label in selection.get('target_inventory') or []
                             if re.sub(r'-shard-\d+$', '', label.split(':')[-1]) == identity}
                all_shards = identity in expected or bool(inventory and expected == inventory)
                filtered = any(arg.startswith('--test-arg') or arg.startswith('hirsel.conformance_')
                               for arg in selection['command'])
                if (expected and all_shards and not filtered and len(selected) == len(expected)
                        and {o['target'] for o in selected} == expected
                        and all(o['state'] == 'pass' and o['provenance']['execution'] == 'fresh'
                                and o['provenance'].get('command_succeeded') is True
                                and o['complete'] and not o['ignored'] and o['filtered_out'] == 0 for o in selected)):
                    recoveries.append(selection['stage'])
        else:
            recoveries = [o['stage'] for o in exact if o['state'] == 'pass' and o['complete']
                          and o['provenance']['execution'] == 'fresh'
                          and (o['provenance'].get('command_succeeded') is True or o['status'] == event_logs.FAIL)
                          and sum(other['stage'] == o['stage'] for other in exact) == 1]
        context = [] if target_scope else by_binary.get(identity.split('::')[0], []) if '::' in identity else []
        states = sorted({o['state'] for o in matched}) or ['unobserved']
        entries.append(dict(identity=identity, reason=row[1], owner=row[2], date=row[3],
                            states=states, context=context, recovery_stages=sorted(set(recoveries)), observations=matched))
    return dict(version=1, tables=revisions, selections=selections, observations=observations, known=entries)


class RunningReport:
    """Publish finished commands while unrelated targets still occupy the run."""

    def __init__(self, sha, tier, directory, start):
        self.sha, self.tier, self.directory, self.start = sha, tier, directory, start
        self.path = RUNS / 'RUNNING.md'
        self.records, self.completed, self.errors = {}, {}, {}
        self.stop = threading.Event()
        self.thread = threading.Thread(target=self.watch, name='main-run-report')

    def __enter__(self):
        self.refresh()
        self.thread.start()
        return self

    def __exit__(self, kind, value, traceback):
        self.stop.set()
        self.thread.join()
        self.refresh(state='interrupted' if kind else 'finished')
        if kind is None:
            self.path.unlink(missing_ok=True)

    def watch(self):
        while not self.stop.wait(0.5):
            self.refresh()

    def refresh(self, state='active'):
        for path in self.directory.glob('logs/**/*.progress.json'):
            if path in self.completed:
                continue
            try:
                record = json.loads(path.read_text())
                self.records[path] = record
                if 'end' not in record:
                    continue
                rows = []
                event_log = record.get('event_log')
                if event_log and record['command'][0] == 'test':
                    results = event_logs.test_results(event_log, history=event_logs.NoTestHistory(), all_results=True)
                    end = record['command'].index('--') if '--' in record['command'] else len(record['command'])
                    expected = record['command'][1:end]
                    expected = [arg for arg in expected if arg.startswith(('//:', 'root//:'))]
                    counts = {target: sum(target == name for name, _ in results) for target, _ in results}
                    observed = set()
                    for target, result in results:
                        label = next((arg for arg in expected if arg.split(':')[-1] == target), target)
                        observed.add(label)
                        provenance = result.get('provenance', {})
                        verdict = {event_logs.PASS: 'pass', event_logs.FAIL: 'failure', event_logs.SKIP: 'skipped',
                                   event_logs.OMITTED: 'omitted', event_logs.TIMED_OUT: 'timeout',
                                   event_logs.FATAL: 'fatal', event_logs.INFRA_FAILURE: 'infrastructure'}.get(result['status'], 'unknown')
                        filtered = any(arg.startswith(('--test-arg', 'hirsel.conformance_')) for arg in record['command'])
                        empty = bool(re.search(r'^running 0 tests?$|^test result: .* 0 passed; 0 failed;', result['details'], re.M))
                        complete = (counts[target] == 1 and label in expected and not result.get('missing_result')
                                    and result['status'] in (event_logs.PASS, event_logs.FAIL)
                                    and not filtered and not empty and filtered_population(result) in (None, 0))
                        rows.append(dict(target=label, result=verdict, complete=complete, **provenance))
                    rows += [dict(target=target, result='unknown', complete=False) for target in expected if target not in observed]
                else:
                    rows.append(dict(target='stage: ' + record['stage'],
                                     result='pass' if record['exit_status'] == 0 else f'exit {record["exit_status"]}', complete=True))
                self.completed[path] = rows
                self.errors.pop(path, None)
            except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
                self.errors[path] = str(error)
        now = time.time()
        lines = [f'# RUNNING {self.tier} main run {self.sha}', '',
                 f'State: {state}; updated {time.strftime("%Y-%m-%d %H:%M:%SZ", time.gmtime(now))}; '
                 f'elapsed {(now - self.start) / 60:.1f} min; log {self.directory / "run.log"}', '',
                 'Reuse only a completed target with the exact SHA, target and command inputs below. '
                 'An unknown, skipped, omitted or partial result proves no completed obligation. '
                 'Cached execution is labeled; its timings describe the cached execution, and it is not fresh recovery proof.', '',
                 '## Completed results', '',
                 '| SHA | Stage | Target | Result | Target complete | Action / input identity | Queue seconds | Execution seconds | Worker | Execution | Command record |',
                 '| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |']
        def cell(value):
            return str(value if value is not None else 'unknown').replace('|', r'\|').replace('\n', ' ')
        count = 0
        for path, results in self.completed.items():
            record = self.records[path]
            for result in results:
                count += not result['target'].startswith('stage: ')
                digest = result.get('digest')
                identity = f'RE action {digest} (binds command and input root)' if digest else 'unknown'
                values = (self.sha, record['stage'], result['target'], result['result'], 'yes' if result['complete'] else 'no',
                          identity, result.get('queue_seconds'), result.get('execution_seconds'), result.get('worker'),
                          result.get('execution'), str(path.relative_to(self.directory)))
                lines.append('| ' + ' | '.join(cell(value) for value in values) + ' |')
        lines += ['', f'{count} target results published; {len(self.completed)} completed commands.', '', '## Active actions', '']
        for path, record in self.records.items():
            if 'end' not in record:
                elapsed = now - record['start']
                lines.append(f'- {"SLOW" if elapsed > 1800 else "running"}: {record["stage"]}; '
                             f'{elapsed / 60:.1f} min; command {json.dumps(record["command"])}; '
                             'action/input identity, queue/execution seconds and worker unknown until completion.')
        lines += ['', '## Command inputs', '']
        for path, record in self.records.items():
            lines.append(f'- {path.relative_to(self.directory)}: {record["stage"]}; {json.dumps(record["command"])}; '
                         f'event log {record.get("event_log") or "unknown"}')
        lines += ['', '## Unusable progress evidence', '']
        lines += [f'- {path}: {error}' for path, error in self.errors.items()]
        temporary = self.path.with_suffix('.md.tmp')
        temporary.write_text('\n'.join(lines) + '\n')
        temporary.replace(self.path)


def run_stages(directory, log, tier, running=None, selectors=()):
    """Stage verdicts, skips, perf measurement and versioned exception observations."""
    skip, known, revisions = exception_tables()
    reds, ran, skipped, perf = {}, [], [], []
    observations, selections = [], []
    planned, execution_tier, extra = selection_plan(tier, selectors)

    def stage(name, command, isolated=False, target_inventory=None, corpus=False, corpus_inventory=None):
        if selectors and name not in planned:
            return
        if name in skip:
            return skipped.append(skip[name])
        ran.append(name)
        selections.append(dict(stage=name, command=command, target_inventory=target_inventory,
                               inventory_source='workspace test query' if target_inventory is not None else None,
                               corpus_inventory=corpus_inventory))
        logs = directory / 'logs' / re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')
        logs.mkdir(parents=True, exist_ok=True)
        corpus_report = logs / 'corpus.json'
        command = [str(corpus_report) if arg == '{report}' else arg for arg in command]
        selections[-1]['command'] = command
        env = ({k: v for k, v in os.environ.items() if k not in RUN_VARIABLES} if isolated
               else os.environ | {'HIRSEL_BUCK2_LOG_DIR': str(logs), 'HIRSEL_TEST_BATCH_SIZE': '32',
                                  # One target per command releases its prepared-request slot
                                  # as soon as it finishes, even while another target is slow.
                                  'HIRSEL_TEST_BATCH_CONCURRENCY': '32'})
        log.write(f'\n== {name}\n')
        log.flush()
        started = time.monotonic()
        stage_progress = dict(stage=name, command=command, start=time.time())
        if running:
            event_logs.progress(logs / 'stage.progress.json', stage_progress)
            if not isolated:
                env = env | {'HIRSEL_MAIN_RUN_PROGRESS': name}
        attempts = []
        for attempt in range(2):
            attempt_logs = logs if attempt == 0 else logs / 'retry'
            if attempt:
                attempt_logs.mkdir(exist_ok=True)
                env = env | {'HIRSEL_BUCK2_LOG_DIR': str(attempt_logs)}
            offset = log.tell()
            status = subprocess.run(command, cwd=TREE, env=env, stdout=log, stderr=subprocess.STDOUT).returncode
            reason, expired = None, False
            if status:
                with open(log.name, errors='replace') as output:
                    output.seek(offset)
                    for line in output:
                        expired |= 'artifact that has expired in the RE CAS' in line
                        reason = reason or infra_reason(details=line)
                reason = ('expired RE CAS artifact' if expired else infra_reason(status) or reason)
            attempts.append(dict(exit_status=status, infrastructure_reason=reason))
            if not expired or attempt or isolated:
                break
            # `kill` addresses only this checkout/isolation's daemon. `killall`
            # would kill sibling lanes' daemons on the shared host.
            restarted = subprocess.run([str(TREE / '.buck2/bin/buck2'), 'kill'], cwd=TREE, env=env,
                                       stdout=log, stderr=subprocess.STDOUT).returncode
            if restarted:
                attempts[-1]['restart_exit_status'] = restarted
                break
        if running:
            event_logs.progress(logs / 'stage.progress.json', stage_progress | dict(end=time.time(), exit_status=status))
        selections[-1].update(exit_status=status, seconds=round(time.monotonic() - started, 3),
                              infrastructure_reason=reason, attempts=attempts)
        say(f'{"pass" if status == 0 else "FAIL"}  {name} ({time.monotonic() - started:.0f} s)')
        # A retried invocation supersedes its expired infrastructure attempt;
        # keep both logs and attempt verdicts, but judge only the final attempt.
        logs = attempt_logs
        failed, infra = False, False
        for events in sorted(logs.glob('*.pb.zst')):
            try:
                results = event_logs.test_results(events, all_results=True)
            except (subprocess.CalledProcessError, OSError, ValueError, KeyError) as error:
                reds[f'evidence: {name}: {events.name}'] = dict(
                    stage=name, target=None, ids=[], kind='infra', reason=f'unusable event log: {error}')
                observations.append(dict(stage=name, target=None, identity=None, scope='evidence',
                                         state='unusable', provenance=dict(event_log=str(events), execution='unknown'),
                                         complete=False, ignored=False))
                continue
            for target, result in results:
                test_reason = None
                if result['status'] not in PASSED:
                    test_reason = ('missing TestResult' if result.get('missing_result') else
                                   'Buck2 Infra Failure' if result['status'] == event_logs.INFRA_FAILURE else
                                   infra_reason(result.get('provenance', {}).get('signed_exit_code') or 0,
                                                details=result['details'], timed_out=result['status'] == event_logs.TIMED_OUT))
                    test_reason = test_reason or (reason if not result['details'].strip() else None)
                state = ('infrastructure' if test_reason else
                         {event_logs.PASS: 'pass', event_logs.FAIL: 'failure', event_logs.SKIP: 'skipped',
                          event_logs.OMITTED: 'omitted'}.get(result['status'], 'unusable'))
                observation = dict(stage=name, target=target, identity=target, scope='target', state=state,
                                   corpus=corpus,
                                   status=result['status'], provenance=dict(result.get('provenance', {}), event_log=str(events)),
                                   filtered_out=filtered_population(result), complete=bool(complete_cases(result) and not reason),
                                   ignored=bool(re.search(r'\.\.\. ignored\b', result['details'])))
                observation['provenance'].setdefault('execution', 'unknown')
                observations.append(observation)
                for identity, case_state in ([] if corpus else case_observations(target, result)):
                    observations.append(observation | dict(identity=identity, scope='case',
                                        state=state if state in ('infrastructure', 'unusable', 'skipped', 'omitted') else case_state,
                                        first_error=first_error(result['details'], identity) if case_state == 'failure' else None))
                if state in ('failure', 'infrastructure') and not corpus:
                    observation['first_error'] = first_error(result['details'])
                if corpus and state == 'infrastructure':
                    observation['first_error'] = first_error(result['details'])
                    for line in result['details'].splitlines():
                        if line.startswith('HIRSEL_TEST_PHASE_RUNNING '):
                            try:
                                phase = json.loads(line.removeprefix('HIRSEL_TEST_PHASE_RUNNING '))
                            except ValueError:
                                continue
                            if phase.get('phase') == 'corpus-case' and str(phase.get('detail', '')).startswith('conformance/'):
                                observations.append(observation | dict(identity=phase['detail'], scope='case',
                                                                        wrongly_accepted=False))
                if target == 'gate-perf-counts' and result['status'] == event_logs.PASS:
                    perf.extend(json.loads(line.removeprefix(PERF_MARKER)) for line in
                                result['details'].splitlines() if line.startswith(PERF_MARKER))
                if result['status'] in PASSED:
                    continue
                failed = True
                ids = failing_ids(target, result['details'])
                infra |= test_reason is not None
                if test_reason or not corpus and not ({target, re.sub(r'-shard-\d+$', '', target)} & known.keys()
                        or ids and all(i in known for i in ids)):
                    reds[f'{name}: {target}'] = dict(stage=name, target=target, ids=ids[:20],
                                                    kind='infra' if test_reason else 'code', reason=test_reason,
                                                    **(dict(first_error=observation.get('first_error')) if test_reason else {}))
            del results
        expected = {arg.split(':')[-1] for arg in command if arg.startswith(('//:', 'root//:'))} if 'test' in command else set()
        observed = {o['target'] for o in observations if o['stage'] == name and o['scope'] == 'target'}
        for target in sorted(expected - observed):
            observations.append(dict(stage=name, target=target, identity=target, scope='target', state='unusable',
                                     provenance=dict(execution='unknown'), complete=False, ignored=False, filtered_out=None))
            reds[f'evidence: {name}: {target}'] = dict(stage=name, target=target, ids=[], kind='infra',
                                                      reason='selected target has no TestResult')
        stage_id = f'stage: {name}'
        stage_verdict = dict(stage=name, target=None, identity=stage_id, scope='stage',
                                 state='infrastructure' if reason else 'failure' if status else 'pass',
                                 provenance=dict(execution='fresh', command_succeeded=status == 0),
                                 status=status, complete=True, ignored=False, filtered_out=None)
        observations.append(stage_verdict)
        if status and (not corpus or not corpus_report.exists()):
            log.flush()
            with open(log.name, errors='replace') as output:
                output.seek(offset)
                observations[-1]['first_error'] = first_error(output.read())
        if corpus:
            try:
                artifact = json.loads(corpus_report.read_text())
                if status and not artifact['reports']:
                    log.flush()
                    with open(log.name, errors='replace') as output:
                        output.seek(offset)
                        observations[-1]['first_error'] = first_error(output.read())
                cases = corpus_observations(name, artifact, {o['target']: o for o in observations
                                                            if o['stage'] == name and o['scope'] == 'target'})
                active = {o['identity'] for o in observations if o['stage'] == name and o['scope'] == 'case'}
                cases = [case for case in cases if case['identity'] not in active]
                observations.extend(cases)
                if any(case['state'] == 'failure' for case in cases):
                    stage_verdict['state'] = 'failure'
                for case in cases:
                    if case['state'] == 'failure' and case['identity'] not in known and case.get('known_identity') not in known:
                        reds[f'{name}: {case["identity"]}'] = dict(stage=name, target=None,
                            ids=[case['identity']], kind='code', reason=case['first_error'])
                errors = [error.splitlines()[0] for report in artifact['reports'] for error in report.get('errors', [])
                          if not re.match(r'conformance/\S+\.hir: ', error)
                          and not error.startswith('--path requires every selected test')]
                if errors:
                    stage_verdict.update(state='failure', first_error=errors[0], independent_failure=True)
                    if stage_id not in known:
                        reds[stage_id] = dict(stage=name, target=None, ids=[], kind='code', reason=errors[0])
                if len(artifact['reports']) != artifact.get('expected_slices', len(artifact['reports'])):
                    raise ValueError('incomplete corpus slices')
            except (OSError, ValueError, KeyError, TypeError) as error:
                stage_verdict.update(state='infrastructure', complete=False)
                reds[f'evidence: {name}: corpus'] = dict(stage=name, target=None, ids=[], kind='infra',
                                                        reason=f'unusable structured corpus report: {error}')
            seen = {o['identity'] for o in observations if o['stage'] == name and o['scope'] == 'case'}
            observations.extend(corpus_observations(name, dict(reports=[], selected_cases=sorted(set(corpus_inventory or []) - seen))))
        if status and (not failed or reason and not infra) and (reason or stage_id not in known):
            reds[stage_id] = dict(stage=name, target=None, ids=[], kind='infra' if reason else 'code', reason=reason)
    stages(stage, execution_tier)
    if extra:
        name, command, inventory = extra
        stage(name, command, corpus=True, corpus_inventory=inventory)
    status = lifecycle(known, observations, selections, revisions)
    status.update(skipped=skipped, planned_stages=list(planned), unselected_stages=sorted(set(stage_plan('full')) - set(planned)))
    return reds, ran, skipped, perf[0] if len(perf) == 1 else None, status


def lanes(commits):
    """Each commit's lane: that of the first landing at or after it (a landing row names its tip)."""
    path = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir')) / 'hirsel-landings.jsonl'
    tips = {}
    for line in path.read_text().splitlines() if path.exists() else []:
        row = json.loads(line)
        tips[row.get('landed')] = row.get('branch')
    found, pending = {}, []
    for commit in commits:
        pending.append(commit)
        if commit in tips:
            found.update(dict.fromkeys(pending, tips[commit]))
            pending = []
    return found


def culprit(red, commits, changed):
    """The commit that changed the most files under the red's crate or among its corpus cases, or None."""
    names = {red['target'] or ''} | {i.split('::')[0] for i in red['ids']}
    crates = {f'crates/{c.name}/' for c in (TREE / 'crates').iterdir()
              if any(n == c.name or n.startswith(c.name + '-') for n in names)}
    paths = {i for i in red['ids'] if i.startswith('conformance/')}
    score = {c: sum(p in paths or p.startswith(tuple(crates)) for p in changed[c]) for c in commits}
    best = max(reversed(commits), key=score.get, default=None)
    return best if best and score[best] else (commits[-1] if len(commits) == 1 else None)


def describe(key, red):
    if red.get('kind') in ('infra', 'configuration'):
        label = 'infrastructure' if red['kind'] == 'infra' else 'configuration'
        return f'- {key}: {label} ({red["reason"]})' + (f'; {red["first_error"]}' if red.get('first_error') else '')
    if red.get('new_range'):
        return f'- NEW {key}: commits {red["new_range"]}; bisect this range; failing {", ".join(red["ids"])}'
    return (f'- {key}: culprit {(red["culprit"] or "unknown")[:12]}' + (f' ({red["lane"]})' if red['lane'] else '')
            + f', red since {red["since"][:12]}' + (f'; failing {", ".join(red["ids"][:5])}' if red['ids'] else ''))


def attribute(sha, reds, history):
    """Attribute reds and return report lines naming each new code red's owner.

    A red is compared with the last run that ran its stage (a row without a
    stage list ran them all): a code red it had keeps its culprit, a new one's
    culprit is among the commits since it. Infra never carries lane blame."""
    owners, changes = [], {}
    for key, red in sorted(reds.items()):
        previous = next((r for r in reversed(history) if red['stage'] in r.get('stages', [red['stage']])), None)
        kind = red.get('kind', 'code')
        if kind in ('infra', 'configuration'):
            red.update(culprit=None, lane=None, since=sha)
            continue
        if red.get('new_range'):
            red.update(culprit=None, lane=None, since=sha)
            owners.append(f'- NEW {key} -> unowned; commits {red["new_range"]}; bisect this range')
            continue
        if red.get('first_observation'):
            red.update(culprit=None, lane=None, since=sha)
            owners.append(f'- {key} -> unowned; first observation without a previous green')
            continue
        if old := (previous or {}).get('reds', {}).get(key):
            red.update(culprit=old.get('culprit'), lane=old.get('lane'), since=old.get('since', previous['sha']))
            continue
        base = previous['sha'] if previous else sha + '~10'
        if base not in changes:
            commits = git('rev-list', '--reverse', f'{base}..{sha}').split()
            changed = {c: git('diff-tree', '--no-commit-id', '--name-only', '-r', c).split() for c in commits}
            changes[base] = commits, changed, lanes(commits)
        commits, changed, owners_by_commit = changes[base]
        found = culprit(red, commits, changed)
        red.update(culprit=found, lane=owners_by_commit.get(found), since=sha)
        owners.append(f'- {key} -> {red["lane"] or "unowned"}' + (f' ({found})' if found else ''))
    return owners


def result_index(observations):
    """Keep exact states, collapsing duplicate observations conservatively."""
    index = {}
    for observation in observations:
        if identity := observation.get('identity'):
            entry = index.setdefault(observation['stage'], {})
            state = observation['state'] if observation.get('complete') else 'incomplete'
            entry[identity] = state if identity not in entry or entry[identity] == state else 'ambiguous'
    return index


def previous_results(stage, history, cache=None):
    previous = next((row for row in reversed(history) if not row.get('configuration_error')
                     and stage in row.get('stages', [])), None)
    if previous is None:
        return None, {}
    cache = {} if cache is None else cache
    key = previous['sha'], previous.get('start')
    if key in cache:
        return previous, cache[key].get(stage, {})
    if previous.get('results_path') and Path(previous['results_path']).exists():
        cache[key] = json.loads(Path(previous['results_path']).read_text())
        return previous, cache[key].get(stage, {})
    # Old completed runs already archive explicit observations. Read only the
    # chosen run rather than retaining every historical population in memory.
    if ROWS.exists():
        with ROWS.open() as source:
            if 'history_offset' in previous:
                source.seek(previous['history_offset'])
            for line in source:
                if not line.strip():
                    continue
                row = json.loads(line)
                if row.get('sha') == previous['sha'] and row.get('start') == previous.get('start'):
                    cache[key] = result_index(row.get('exception_status', {}).get('observations', []))
                    return previous, cache[key].get(stage, {})
                if 'history_offset' in previous:
                    break
    cache[key] = {}
    return previous, {}


def red_sections(sha, status, history, reds):
    """Unknown exact failures precede owner counts; NEW requires a recorded green."""
    known = {entry['identity']: entry for entry in status['known']}
    observations = status['observations']
    previous_cache = {}
    wrongly = sorted({(o['stage'], o['identity'], o.get('first_error') or 'ACCEPTED')
                      for o in observations if o.get('wrongly_accepted')})
    lines = ['## WRONGLY ACCEPTED', '']
    lines += [f'- {stage}: {identity}: {error}' for stage, identity, error in wrongly] or ['None observed.']
    lines += ['', '## Reds by stage', '']
    for stage in status.get('planned_stages', dict.fromkeys(o['stage'] for o in observations)):
        selected = [o for o in observations if o['stage'] == stage]
        failures = {o['identity']: o for o in selected if o['state'] in ('failure', 'infrastructure') and o.get('identity')}
        # Case failures explain their parent target and stage. Keep failures
        # without an identified child as targets or stages, never discard them.
        cases = {identity: o for identity, o in failures.items() if o['scope'] == 'case'}
        targets = {o.get('target') for o in cases.values()}
        failures = cases | {identity: o for identity, o in failures.items() if o['scope'] == 'target'
                           and o['target'] not in targets and not (cases and o.get('corpus'))}
        failures.update({o['identity']: o for o in selected if o.get('independent_failure')})
        if not failures:
            failures = {o['identity']: o for o in selected if o['scope'] == 'stage' and o['state'] in ('failure', 'infrastructure')}
        previous, green = previous_results(stage, history, previous_cache) if failures else (None, {})
        counts, unknown, known_new = Counter(), [], []
        for identity, observation in sorted(failures.items()):
            target = observation.get('target') or ''
            match = next((known[key] for key in (identity, observation.get('known_identity'), target,
                                               re.sub(r'-shard-\d+$', '', target)) if key in known), None)
            if observation['state'] == 'infrastructure':
                match = None
            commit_range = f'{previous["sha"]}..{sha}' if previous and green.get(identity) == 'pass' else None
            if match:
                counts[match['owner']] += 1
            if not match or commit_range:
                marker = f'NEW {identity}; commits {commit_range}; bisect this range' if commit_range else identity
                error = observation.get('first_error') or 'no diagnostic reported'
                (known_new if match else unknown).append(f'- {marker}: {error}' + (f' [known: {match["owner"]}]' if match else ''))
            if commit_range or not match and green.get(identity) != 'failure':
                for red in reds.values():
                    if red['stage'] == stage and (identity in red['ids'] or target and target == red['target']
                                                   or identity == f'stage: {stage}' and red['target'] is None):
                        if commit_range:
                            red['new_range'] = commit_range
                        else:
                            red['first_observation'] = True
        lines += [f'### {stage}', ''] + (unknown or ['No unlisted reds.']) + known_new + ['']
        lines += [f'Known reds by owner: {", ".join(f"{owner}: {count}" for owner, count in sorted(counts.items())) or "none"}.', '']
    corpus = [o for o in observations if o['scope'] == 'case' and o['identity'].startswith('conformance/')
              and 'wrongly_accepted' in o]
    if corpus:
        lines += ['## Conformance totals per directory', '']
        for directory in sorted({str(Path(o['identity']).parent) for o in corpus}):
            counts = Counter(o['state'] for o in corpus if str(Path(o['identity']).parent) == directory)
            lines.append(f'- {directory}: {sum(counts.values())} total / {counts["pass"]} passing / {counts["failure"]} failing / {counts["unusable"]} not implemented / {counts["infrastructure"]} infrastructure / {counts["unobserved"]} unobserved')
        lines += ['']
    return lines


def push_to_main(message, update):
    """Commit what `update(tree)` changes on a fresh origin/main and push it."""
    for _ in range(5):
        git('fetch', '-q', 'origin', 'main')
        checkout(PUSH_TREE, git('rev-parse', 'refs/remotes/origin/main'))
        update(PUSH_TREE)
        if not git('status', '--porcelain', cwd=PUSH_TREE):
            return None
        git('commit', '-qam', message, cwd=PUSH_TREE)
        if subprocess.run(['git', 'push', '-q', 'origin', 'HEAD:main'], cwd=PUSH_TREE).returncode == 0:
            return git('rev-parse', 'HEAD', cwd=PUSH_TREE)
    return None


def api_index(tree):
    cli = 'root//:hirsel-cli-bin-hirsel'
    config = os.environ.get('HIRSEL_BUCK2_CONFIG', '').split()
    built = subprocess.run([str(TREE / '.buck2/bin/buck2'), 'build', *config, '--show-json-output', cli], cwd=TREE,
                           capture_output=True, text=True, check=True)
    page = subprocess.run([str(TREE / json.loads(built.stdout)[cli]), 'doc', 'stdlib/std@1/hirsel.json'],
                          cwd=TREE, capture_output=True, check=True).stdout
    (tree / 'docs/api.md').write_bytes(page)


def ratchet(measured, perf_checks):
    def update(tree):
        counts = runpy.run_path(str(tree / 'tools/perf-counts'))
        rows, improvements = counts['ratchet'](counts['read_table'](tree / 'tools/perf-counts.tsv'), [measured])
        # push_to_main can retry against a newer baseline. Only report the
        # changes in the successful push, never a superseded attempt.
        perf_checks[:] = [item for item in improvements
                          if (item['old'] - item['new']) * 100 > item['old'] * 15]
        if improvements:
            (tree / 'tools/perf-counts.tsv').write_text(counts['table'](rows))
    return update


def run(sha, tier, selections=()):
    if selections:
        selection_plan(tier, selections)  # Reject typos before creating a run or launching work.
    start = time.time()
    directory = RUNS / 'runs' / f'{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(start))}-{sha[:12]}'
    try:
        directory.mkdir(parents=True)
    except FileExistsError:
        directory = directory.with_name(directory.name + f'-{time.time_ns()}')
        directory.mkdir()
    with RunningReport(sha, tier, directory, start) as running:
        with open(directory / 'run.log', 'w') as log:
            configuration_error = None
            try:
                if selections:
                    reds, ran, skipped, perf, status = run_stages(directory, log, tier, running, selections)
                else:
                    reds, ran, skipped, perf, status = run_stages(directory, log, tier, running)
            except TableError as error:
                configuration_error = str(error)
                log.write(configuration_error + '\n')
                reds = {'configuration: exception tables': dict(stage='configuration', target=None, ids=[],
                        kind='configuration', reason=configuration_error)}
                ran, skipped, perf = [], [], None
                status = dict(version=1, configuration_error=configuration_error, known=[], observations=[], selections=[], tables={})
        return publish(sha, tier, directory, start, reds, ran, skipped, perf, status, configuration_error)


def publish(sha, tier, directory, start, reds, ran, skipped, perf, status,
            configuration_error=None, *, update_main=True, finished=None):
    """Publish completed observations, including offline recovery of an old run."""
    report = RUNS / 'reports' / f'{directory.name}.md'
    history = [row for row in rows() if row.get('start', 0) < start]
    details = red_sections(sha, status, history, reds)
    owners = attribute(sha, reds, history)
    pushed, perf_checks = [], []
    ratchet_checks = []
    for name, update in (('Regenerate the API index.', api_index),
                         ('Ratchet the instruction budgets main measured.', ratchet(perf, ratchet_checks) if perf else None)):
        try:
            if update_main and not configuration_error and update and (commit := push_to_main(name, update)):
                pushed.append(f'{commit[:12]} {name}')
                if name == 'Ratchet the instruction budgets main measured.':
                    for item in ratchet_checks:
                        say(f'PERF-CHECK {item["count"]} {item["old"]} -> {item["new"]} (run: {sha[:12]})')
                        perf_checks.append(dict(item, measured_sha=sha, pushed=commit))
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError, KeyError, ValueError) as error:
            pushed.append(f'{name} failed: {error}')
    minutes = ((time.time() if finished is None else finished) - start) / 60
    infra = sum(red.get('kind') == 'infra' for red in reds.values())
    configurations = sum(red.get('kind') == 'configuration' for red in reds.values())
    lines = [f'# {tier} main run {sha[:12]}: {len(reds) - infra - configurations} code reds, {infra} infra reds, {configurations} configuration errors', '',
             f'{time.strftime("%Y-%m-%d %H:%M", time.gmtime(start))}Z, {minutes:.0f} min; log {directory / "run.log"}', '']
    lines += [f'Configuration: {configuration_error or "valid"}; exception status v1; SHA {sha}; tier {tier}', '']
    previous = next((row for row in reversed(history) if not row.get('configuration_error')), None)
    lines += [f'Commits since last completed run: {previous["sha"]}..{sha}' if previous
              else 'Commits since last completed run: no previous completed run.', '']
    lines += details
    lines += ['## Owners', ''] + owners + ['']
    for kind, title in (('code', 'Code reds'), ('infra', 'Infrastructure reds'), ('configuration', 'Configuration errors')):
        lines += [f'## {title}', ''] + [describe(key, red) for key, red in sorted(reds.items())
                                         if red.get('kind', 'code') == kind] + ['']
    lines += [f'Stages executed: {", ".join(ran) or "none"}',
              f'Stages outside tier: {", ".join(status.get("unselected_stages", [])) or "none"}', '']
    lines += ['## Known exception observations', '',
              f'{len(status["known"])} configured identities; {len(status["observations"])} observations. '
              'Unobserved identities have unknown selection/absence; cached passes are not fresh recovery.', '']
    census = {state: sum(state in entry['states'] for entry in status['known'])
              for state in ('failure', 'pass', 'skipped', 'omitted', 'infrastructure', 'unusable', 'unobserved')}
    lines += [', '.join(f'{count} {state}' for state, count in census.items()) + '; '
              + f'{sum(bool(entry["recovery_stages"]) for entry in status["known"])} recovery candidates '
              '(states may overlap across stages).', '']
    for name, revision in status['tables'].items():
        lines.append(f'- table {name}: sha256 {revision["sha256"]}')
    for entry in status['known']:
        scopes = ', '.join(f'{o["stage"]}/{o["target"]}: {o["state"]} ({o["provenance"]["execution"]})'
                           + (' [incomplete evidence]' if not o['complete'] else '')
                           for o in entry['observations']) or 'unobserved (selection/absence unknown)'
        if not entry['observations'] and entry['context']:
            scopes += '; parent context: ' + ', '.join(f'{o["stage"]}/{o["target"]}: {o["state"]}'
                                                     for o in entry['context'])
        recovery = ', '.join(entry['recovery_stages']) or 'none'
        lines.append(f'- {entry["identity"]}: {scopes}; recovery candidate stages: {recovery}; '
                     f'owner {entry["owner"]}; reason: {entry["reason"]}')
    lines += ['']
    lines += [f'- skipped: {row[0]}: {row[1]} (owner {row[2]}, since {row[3]})' for row in skipped]
    lines += [f'- pushed: {line}' for line in pushed]
    lines += [f'- PERF-CHECK {item["count"]} {item["old"]} -> {item["new"]} '
              f'(pushed {item["pushed"][:12]})' for item in perf_checks]
    lines += ['', '## Stage wall times', ''] + [f'- {selection["stage"]}: {selection["seconds"]:.3f} s'
                                              for selection in status['selections'] if 'seconds' in selection]
    report.parent.mkdir(exist_ok=True)
    report.write_text('\n'.join(lines) + '\n')
    directory.mkdir(parents=True, exist_ok=True)
    results_path = directory / 'results.json'
    with results_path.open('w') as out:
        json.dump(result_index(status['observations']), out)
    # Recovery may append an older run after a newer publication. Serialize
    # publishers and compare run timestamps before replacing latest.md.
    with (RUNS / 'publish.lock').open('a+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not any(row.get('start', 0) > start for row in rows()):
            latest = RUNS / 'latest.md.tmp'
            latest.write_text(report.read_text())
            latest.replace(RUNS / 'latest.md')
        append_row(sha, tier, ran, start, minutes, reds, report, perf_checks, status, configuration_error, results_path)
    say(f'{tier} {sha[:12]}: {len(reds)} reds in {minutes:.0f} min; report {report}')
    return 1 if configuration_error else 0


def append_row(sha, tier, ran, start, minutes, reds, report, perf_checks, status, configuration_error, results_path=None):
    # Keep lane-blame history unchanged; versioned observation status is additive.
    code_reds = {key: {k: v for k, v in red.items() if k not in ('kind', 'reason')}
                 for key, red in reds.items() if red.get('kind', 'code') == 'code'}
    with open(ROWS, 'a') as out:
        json.dump(dict(sha=sha, tier=tier, stages=ran, start=start, minutes=round(minutes), reds=code_reds,
                       report=str(report), perf_checks=perf_checks, exception_status=status,
                       configuration_error=configuration_error, results_path=str(results_path) if results_path else None), out)
        out.write('\n')


def main(arguments=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument('--now', action='store_true', help='fetch current origin/main and run it, even if already tested')
    action.add_argument('--tick', action='store_true', help=argparse.SUPPRESS)
    action.add_argument('--run', metavar='SHA', help=argparse.SUPPRESS)
    tiers = ('fast', 'full', 'conformance', 'ownership-trace', 'native-smoke')
    parser.add_argument('--tier', choices=tiers)
    parser.add_argument('--select', action='append', default=[], metavar='STAGE_OR_CORPUS_PATH',
                        help='repeat for stage-name prefixes, or corpus directories, cases and prefixes')
    parser.add_argument('--dry-run', action='store_true', help='list the local plan without fetching or running it')
    parser.add_argument('legacy_tier', nargs='?', choices=tiers, help=argparse.SUPPRESS)
    args = parser.parse_args(arguments)
    corpus = args.select and all(value == 'conformance' or value.startswith('conformance/') for value in args.select)
    tier = args.tier or args.legacy_tier or ('conformance' if corpus else 'fast')
    if corpus and tier not in ('conformance', 'full'):
        parser.error('corpus path selections require the conformance tier')
    try:
        if args.dry_run:
            for name in selection_plan(tier, args.select)[0]:
                print(name)
            return 0
        if args.run:
            return run(args.run, tier, args.select)
        return tick(tier, args.select, force=args.now)
    except SelectionError as error:
        print(f'main-runs: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())

}

fn stream_refusal_from_rep(take value: types.StreamRefusalRep) -> StreamRefusal {
    match take value {
        WeakLevels => WeakLevels,
        Overlap => Overlap,
        Bound(item) => Bound(stream_field_from_rep(item)),

// test-of: std.regex
// test-reason: The Unicode agreement law reads the private regex class ranges.
// Contract tests for `char` (core/std/char.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names. Lists are read back as numbers, one decimal digit per element.
fn digit_or_sentinel(o: Option[u32]) -> u32 {
    match o {
        Some(v) => v,
        None => 99,
    }
}

// expect: run utf8_len_ascii() = 1
fn utf8_len_ascii() -> u64 {
    char.utf8_len('a')
}

// U+00E9.
// expect: run utf8_len_two() = 2
fn utf8_len_two() -> u64 {
    char.utf8_len('é')
}

// U+20AC.
// expect: run utf8_len_three() = 3
fn utf8_len_three() -> u64 {
    char.utf8_len('€')
}

// U+1F600.
// expect: run utf8_len_four() = 4
fn utf8_len_four() -> u64 {
    char.utf8_len('😀')
}

// 'Q' is 81.
// expect: run upper_letter() = 81
fn upper_letter() -> u32 {
    char.to_u32(char.to_ascii_upper('q'))
}

// '`' (96) and '{' (123) border a-z and stay; é (233) is not ASCII and stays.
// expect: run upper_borders() = true
fn upper_borders() -> bool {
    char.to_u32(char.to_ascii_upper('`')) == 96 && char.to_u32(char.to_ascii_upper('{')) == 123 && char.to_u32(char.to_ascii_upper('é')) == 233
}

// 'a' is 97.
// expect: run lower_letter() = 97
fn lower_letter() -> u32 {
    char.to_u32(char.to_ascii_lower('A'))
}

// '@' (64) and '[' (91) border A-Z and stay; É (201) is not ASCII and stays.
// expect: run lower_borders() = true
fn lower_borders() -> bool {
    char.to_u32(char.to_ascii_lower('@')) == 64 && char.to_u32(char.to_ascii_lower('[')) == 91 && char.to_u32(char.to_ascii_lower('É')) == 201
}

// The 22 probes, in order: tab, LF, VT, FF, CR, space, / 0 9 : @ A Z [ ` a z {, U+0085,
// U+00A0, U+FF10 (fullwidth zero), é. Each predicate test writes 1 or 0 per probe.
fn probes() -> String {
    "\t\n\u{B}\u{C}\r /09:@AZ[`az{\u{85}\u{A0}\u{FF10}é"
}

fn mark(mut out: String, yes: bool) {
    string.push(mut out, if yes {
        "1"
    } else {
        "0"
    })
}

// Only '0' and '9' (probes 8 and 9).
// expect: run digit_probes() = true
fn digit_probes() -> bool {
    let p = probes()
    let mut out = string.new()
    let mut at: u64 = 0
    while let Some((c, next_at)) = string.next_scalar(p, at) {
        mark(mut out, char.is_ascii_digit(c))
        at = next_at
    }
    out == "0000000110000000000000"
}

// Only A, Z, a, z (probes 12, 13, 16, 17).
// expect: run alpha_probes() = true
fn alpha_probes() -> bool {
    let p = probes()
    let mut out = string.new()
    let mut at: u64 = 0
    while let Some((c, next_at)) = string.next_scalar(p, at) {
        mark(mut out, char.is_ascii_alpha(c))
        at = next_at
    }
    out == "0000000000011001100000"
}

// Tab, LF, FF, CR, space (probes 1, 2, 4, 5, 6); not VT, U+0085 or U+00A0.
// expect: run whitespace_probes() = true
fn whitespace_probes() -> bool {
    let p = probes()
    let mut out = string.new()
    let mut at: u64 = 0
    while let Some((c, next_at)) = string.next_scalar(p, at) {
        mark(mut out, char.is_ascii_whitespace(c))
        at = next_at
    }
    out == "1101110000000000000000"
}

// expect: run digit_hex_lower() = 15
fn digit_hex_lower() -> u32 {
    digit_or_sentinel(char.digit('f', 16))
}

// expect: run digit_hex_upper() = 15
fn digit_hex_upper() -> u32 {
    digit_or_sentinel(char.digit('F', 16))
}

// expect: run digit_past_base() = 99
fn digit_past_base() -> u32 {
    digit_or_sentinel(char.digit('g', 16))
}

// expect: run digit_decimal() = 9
fn digit_decimal() -> u32 {
    digit_or_sentinel(char.digit('9', 10))
}

// expect: run digit_base_36() = 35
fn digit_base_36() -> u32 {
    digit_or_sentinel(char.digit('z', 36))
}

// expect: run digit_at_base() = 99
fn digit_at_base() -> u32 {
    digit_or_sentinel(char.digit('7', 7))
}

// expect: run digit_base_37() = fail Fail
fn digit_base_37() -> u32 {
    digit_or_sentinel(char.digit('0', 37))
}

// expect: run digit_base_1() = fail Fail
fn digit_base_1() -> u32 {
    digit_or_sentinel(char.digit('0', 1))
}

// UNI-7. The general category and derived properties differ for letter numbers,
// combining marks, titlecase letters and the feminine ordinal.
// expect: run unicode_classification_examples() = true
fn unicode_classification_examples() -> bool {
    let half: char.Category = char.category('½')
    char.UNICODE_VERSION == (18, 0, 0) && char.category('ß') == Ll && char.is_lowercase('ß') && char.category('ᾈ') == Lt && !char.is_uppercase('ǅ') && !char.is_lowercase('ǅ') && char.category('Ⅷ') == Nl && char.is_alphabetic('Ⅷ') && !char.is_letter('Ⅷ') && char.is_numeric('Ⅷ') && char.is_uppercase('Ⅷ') && char.category('\u{345}') == Mn && char.is_alphabetic('\u{345}') && !char.is_letter('\u{345}') && char.is_lowercase('\u{345}') && char.category('ª') == Lo && char.is_lowercase('ª') && char.is_decimal('٠') && !char.is_alphabetic('٠') && char.is_alphanumeric('٠') && half == No && char.is_numeric('½') && !char.is_decimal('½') && char.is_whitespace('\u{b}') && !char.is_ascii_whitespace('\u{b}') && char.category('\u{b}') == Cc && char.is_whitespace('\u{85}') && char.category('一') == Lo && char.category('\u{f0000}') == Co && char.category('\u{ffff}') == Cn && char.category('ʕ') == Lo && !char.is_lowercase('ʕ') && char.category('\u{a7dd}') == Lu
}

// UNI-5. ASCII whitespace differs only at vertical tab.
// expect: run unicode_ascii_classification() = true
fn unicode_ascii_classification() -> bool {
    for code in 0u64 .. 128 {
        let c = option.unwrap(char.from_u32(int.narrow(code)))
        let letter = char.is_ascii_alpha(c)
        let digit = char.is_ascii_digit(c)
        let space = char.is_ascii_whitespace(c) || code == 11
        if char.is_letter(c) != letter || char.is_alphabetic(c) != letter || char.is_numeric(c) != digit || char.is_decimal(c) != digit || char.is_alphanumeric(c) != (letter || digit) || char.is_whitespace(c) != space {
            return false
        }
    }
    true
}

fn unicode_char_word(c: char) -> bool {
    if char.is_alphabetic(c) || c == '\u{200c}' || c == '\u{200d}' {
        return true
    }
    match char.category(c) {
        Mn => true,
        Mc => true,
        Me => true,
        Nd => true,
        Pc => true,
        _ => false,
    }
}

// UNI-2. The Unicode Perl classes compile from these independent regex ranges.
// Check each scalar against the ranges used by perl_ranges.
// test-native-only: The exhaustive regex sweep exceeds the evaluator instruction budget.
// expect: run unicode_regex_agreement() = 1114112
fn unicode_regex_agreement() -> u64 {
    for code in 0u64 .. 0x110000 {
        let Some(c) = char.from_u32(int.narrow(code)) else {
            continue
        }
        if table_contains(WORD_LO, WORD_HI, code) != unicode_char_word(c) || table_contains(DECIMAL_LO, DECIMAL_HI, code) != char.is_decimal(c) || table_contains(SPACE_LO, SPACE_HI, code) != char.is_whitespace(c) {
            return code
        }
    }
    0x110000
}

pub fn tiered_pin_root(opened: u64, branch_id: u32, tree: pages.PageTree) -> pager.TieredPinRoot {
    pager.TieredPinRoot(domain: opened, branch: branch_id, generation: tree_generation(tree), root_stamp: pages.tree_stamp(tree), tails: list.new())
}

pub fn refresh_call_pins(mut pins: pager.TieredPins, mut pending: Option[(format.TieredTarget, types.Failure)], root: pager.TieredPinRoot) {
    if pins.root != root {
        pager.tiered_reset_pins(mut pins, root)
        pending = None
    }
}

pub fn tree_generation(tree: pages.PageTree) -> u64 {
    match tree.paging {
        Some(inventory) => inventory.generation,
        None => 0,
    }
}

pub fn digest_part(mut h: std.sha256.Sha256, part: Bytes) {
    let n = list.len(part)
    for i in 0u64 .. 4 {
        std.sha256.add_byte(mut h, int.truncate(n >> int.truncate(i * 8)))
    }
    std.sha256.add(mut h, part, 0, n)
}

// What a call's attempts carry from one attempt to the next.
pub type CallRun {
    // The queue id the call keeps once it has parked (§13.3a "Wake sources").
    id: Option[u64],
    attempts: u64,
    pins: pager.TieredPins,
    pending: Option[(format.TieredTarget, types.Failure)],
    crowded: bool
}

pub fn cause_number(causes: Causes) -> u32 {
    for cause in causes {
        return match cause.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity(_) => 7u32,
            OutOfTime => 8u32,
            Stack => 10u32
        }
    }
    0u32
}

// AD1: the CALL revision check. A Some that is not code.revision's 32 bytes is refused
// before anything is committed.
pub fn call_checked(revision: Option[Bytes], code_bytes: Bytes) -> Result[(), types.Failure] {
    if let Some(r) = revision {
        if list.len(r) != 32 {
            return Error(Missing("revision"))
        }
    }
    if !format.call_code_size(list.len(code_bytes)) {
        return Error(Missing("code"))
    }
    Ok(())
}

pub fn check_completion_record(keyed: bool, raw: Bytes, issuer: u8, subject: Bytes, t: u64, n: u64, revision: Option[Bytes], code_bytes: Bytes) -> Result[(), types.Failure] {
    if keyed || !format.stream_record_matches(raw, issuer, subject, t, n) {
        return Error(Foreign)
    }
    call_checked(revision, code_bytes)
}

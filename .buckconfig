# Buck2 build of the Cargo workspace (tools/buck2/README.md). Cargo manifests and
# Cargo.lock stay the source of truth; tools/buck2/sync.py derives the root and
# third-party BUCK files, which are gitignored. Where one is missing, Buck2 reads
# the committed BUCK.unsynced beside it, which fails saying to run sync.py.
# Remote execution settings live in the ignored, generated .buckconfig.local.
[cells]
root = .
# The bundled prelude with tools/buck2/prelude_overlay.py applied (bootstrap.py).
prelude = .buck2/prelude
toolchains = tools/buck2/toolchains
none = none
[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none
[external_cells]
prelude = disabled
[buildfile]
name = BUCK,BUCK.unsynced
[parser]
target_platform_detector_spec = target:root//...->root//tools/buck2:dev target:toolchains//...->prelude//platforms:default
[build]
execution_platforms = root//tools/buck2:platforms
# Many lanes share one host: cap each daemon's local parallelism.
threads = 4
# The daemon otherwise starts one async worker per CPU (24–32 seen per lane).
num_tokio_workers = 4
[buck2]
digest_algorithms = SHA256
# Prune inactive outputs hourly after 6 h; below 10% free, adapt down to 1 h.
# Keep active artifacts and the adaptive minimum TTL protected.
sqlite_materializer_state = true
defer_write_actions = true
clean_stale_enabled = true
clean_stale_artifact_ttl_hours = 6
clean_stale_period_hours = 1
clean_stale_start_offset_hours = 0.1
clean_stale_low_disk_threshold = 10
clean_stale_low_disk_adaptive_enabled = true
clean_stale_low_disk_adaptive_min_ttl_hours = 1
clean_stale_low_disk_adaptive_delete_intermediate_within_min_ttl = false
clean_stale_low_disk_adaptive_unmaterialize_active = false
[project]
ignore = .git, buck-out, .buck2, target, tools/buck2/bin
[buck2_re_client]
# Remote actions one daemon keeps in flight: each lane's share of the pool.
# The pool (144 CPUs on 2026-11-10, shared with lash and others at a higher
# priority) ran 141-144 CPUs reserved with 28-33 actions queued while about
# five Hirsel lanes were active; single lanes peaked at 55-80 CPUs, and
# actions of 4+ CPUs or 4+ GiB (links, std precompute) waited 356 s at p90,
# up to 20 min. At 32 actions (about 2 CPUs each) five lanes fit the pool.
# tools/land raises its own checkout to 128 ($HIRSEL_BUCK2_RE_CONCURRENCY,
# tools/buck2/prepare.py): the daemon reads this only from config files.
execution_concurrency_limit = 32
max_concurrent_uploads_per_action = 1
[test]
# The pinned OSS runner has no unbounded mode. One outer bound covers all tests.
timeout_default_s = 86400
v2_test_executor = tools/buck2/test_executor.py

// LANG-20: a computed constant whose run fails, reaches the closed list, needs its
// own value or exceeds its budget is refused at the constant, with the cause and
// the calls from the initialiser innermost first, and the target that failed when its
// value depends on the target; a Bytes constant is refused at its type, since no
// List is static.
// expect: refuse LANG-20 at 26:1
// expect: refuse LANG-20 at 28:1
// expect: refuse LANG-20 at 30:1
// expect: refuse LANG-20 at 32:1
// expect: refuse LANG-20 at 34:1
// expect: refuse LANG-20 at 36:12
// expect: refuse LANG-20 at 41:1
// expect: refuse LANG-20 at 44:1
// expect: message LANG-20 at 44:1 | it exceeds its budget (Activations, MEM-34), in app@1/main/deep (4095 calls) from app@1/main/DEEP
// expect: message LANG-20 at 41:1 | it fails with Division, in app@1/main/per_os from app@1/main/PER_OS, for target aarch64-apple-darwin
// expect: message LANG-20 at 26:1 | constant app@1/main/BIG is refused: it fails with Overflow, in app@1/main/grow from app@1/main/BIG
// expect: message LANG-20 at 28:1 | it reaches unique.new, on the closed list, in app@1/main/fresh from app@1/main/ID
// expect: message LANG-20 at 30:1 | it exceeds its budget (OutOfTime, MEM-34), in app@1/main/spin from app@1/main/SLOW
// expect: message LANG-20 at 32:1 | its value depends on itself: app@1/main/LOOP reads app@1/main/LOOP, in app@1/main/other
// expect: message LANG-20 at 34:1 | it fails with Fail, in app@1/main/_$0
// expect: message LANG-20 at 36:12 | a Bytes or other List is never static: static bytes are FrozenBytes
fn grow(n: u8) -> u8 { n + 200 }
fn fresh() -> u64 { let _ = unique.new(); 1 }
fn spin() -> u64 { let mut i: u64 = 0; while i < 100000000 { i += 1 }; i }
fn other() -> u64 { LOOP + 1 }
const BIG: u8 = grow(100)

const ID: u64 = fresh()

const SLOW: u64 = spin()

const LOOP: u64 = other()

const _: () = core.fail("never")

const RAW: Bytes = raw()
fn raw() -> Bytes { list.new() }

fn zero() -> u8 { 0 }
fn per_os() -> u8 { match target.os { Linux => 1u8, Macos => 1u8 / zero(), Ios => 1u8 } }
const PER_OS: u8 = per_os()

fn deep(n: u64) -> u64 { if n == 0 { 0 } else { deep(n - 1) + 1 } }
const DEEP: u64 = deep(100000)

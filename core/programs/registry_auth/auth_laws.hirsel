const STATUS_SIG: String = "zZo+1/ugXNNMKJm5bQdNqw0qmEKsGEUYSu5G9kqjeA7qRKM3adQKsDW6OvILSl1ujED3yaJf0aCScBx9+PAeBA=="

const ORG_DOCUMENT: String = "{\"login\":\"acme\",\"id\":42,\"description\":\"Builds\\nhirsel-enroll-v1=5cac60070e70d573c9af42bf7702048d2e105201ce5c46acabd198aa471d8019\"}"


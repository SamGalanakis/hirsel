// Module `codec` (SEM-10): Codec[T], the protocol a generated codec calls, the byte format,
// the built-in codecs of core.md's codec rows, schemas, writer/reader resolution and the
// fingerprint. Field legend: API.md.
//
// Format. Integers at their width, a float as its IEEE bits, a `char` as its scalar in a
// u32, all little-endian; `bool` one byte, 0 or 1; `()` nothing. String, List and Map: a
// u32 count, then the UTF-8 bytes, the elements, or key and value per entry in insertion
// order. Option, Result and every sum: the declared variant index, removed variants
// counted, as a u32, then the variant's fields. A record or tuple: its fields in
// declaration order; a removed field is not written. Nothing frames a value but its
// type, so a value is decoded against the schema that wrote it. The version byte of a
// schema fixes these widths: a decoder written from a version-3 schema alone, in any
// language, reads u32 counts and lengths and u32 tags. Counts above u32::MAX return
// CountOverflow(count) before the count is written.
/// SEM-10's decode errors; each u64 is a byte offset, into the writer's schema for
/// `Schema` and into the decoded bytes otherwise. `Value(i)`: the `from` of a `via` codec
/// refused the value that starts at i.
pub type DecodeError = Truncated(u64) | Invalid(u64) | Utf8(u64) | Duplicate(u64) | Trailing(u64) | Schema(u64) | Value(u64)

/// An encoder could not represent a count in the format's u32 field.
pub type EncodeError = CountOverflow(u64)

/// The codec of T: plain, so a store's shape holds it. Generated codecs and the built-in
/// codecs below provide `of`. `least` is a lower bound on encoded length. Its parts are
/// described functions (PROG-9), so `revision` names the code they run.
pub opaque type Codec[T]: shareable + send {
    encoder: StaticFn[fn(T, mut Bytes) -> Result[(), EncodeError]],
    decoder: StaticFn[fn(Bytes, mut u64) -> Result[T, DecodeError]],
    describer: StaticFn[fn(mut Schema, Codec[T]) -> Result[(), EncodeError]],
    smallest: u64,
    empty: bool,
    structural: bool,
}

/// An opaque codec from its parts.
/// Ex: `codec.make(code.describe(row_encode), code.describe(row_decode), code.describe(row_schema), 9)`
pub fn make[T](e: StaticFn[fn(T, mut Bytes) -> Result[(), EncodeError]], d: StaticFn[fn(Bytes, mut u64) -> Result[T, DecodeError]], w: StaticFn[fn(mut Schema, Codec[T]) -> Result[(), EncodeError]], n: u64) -> Codec[T] {
    make_derived(e, d, w, n, false)
}

/// An opaque codec from its parts, with an explicit empty flag.
pub fn make_derived[T](e: StaticFn[fn(T, mut Bytes) -> Result[(), EncodeError]], d: StaticFn[fn(Bytes, mut u64) -> Result[T, DecodeError]], w: StaticFn[fn(mut Schema, Codec[T]) -> Result[(), EncodeError]], n: u64, empty: bool) -> Codec[T] {
    Codec(encoder: e, decoder: d, describer: w, smallest: n, empty: empty, structural: false)
}

fn storage_make[T](e: StaticFn[fn(T, mut Bytes) -> Result[(), EncodeError]], d: StaticFn[fn(Bytes, mut u64) -> Result[T, DecodeError]], w: StaticFn[fn(mut Schema, Codec[T]) -> Result[(), EncodeError]], n: u64, empty: bool) -> Codec[T] {
    Codec(encoder: e, decoder: d, describer: w, smallest: n, empty: empty, structural: true)
}

/// The codec's revision: the code revisions (PROG-9) of its encoder, decoder and
/// describer, 96 bytes. It changes whenever c could encode a value to other bytes or
/// decode bytes to another value: a default literal, a `via` `to` or `from` body, or any
/// codec they reach (SEM-10). None when the program was assembled without revisions.
pub fn revision[T](c: Codec[T]) -> Option[Bytes] {
    revisions(code.revision(c.encoder), code.revision(c.decoder), code.revision(c.describer))
}

/// A key codec's revision, as `revision` gives a codec's.
pub fn key_revision[T](k: Key[T]) -> Option[Bytes] {
    revisions(code.revision(k.encoder), code.revision(k.decoder), code.revision(k.describer))
}

/// SHA-256 storage identity under SEM-10. Opaque and via parts need code revisions.
pub fn fingerprint[T](c: Codec[T]) -> Option[Bytes] {
    if !c.structural {
        return opaque_fingerprint(c)
    }
    let mut s = storage_builder(false)
    result.unwrap(schema_of(mut s, c))
    storage_finish(s)
}

/// SHA-256 storage identity of a key codec, including its ordering rule.
pub fn key_fingerprint[T](k: Key[T]) -> Option[Bytes] {
    if !k.structural {
        return opaque_key_fingerprint(k)
    }
    let mut s = storage_builder(true)
    result.unwrap(schema_key(mut s, k))
    storage_finish(s)
}

fn opaque_fingerprint[T](c: Codec[T]) -> Option[Bytes] {
    let Some(take raw) = revision(c) else {
        return None
    }
    let mut data = take raw
    put_u64(c.smallest, mut data)
    put_bool(c.empty, mut data)
    Some(codec_storage.hash("hirsel.codec-opaque.v1", data))
}

fn opaque_key_fingerprint[T](k: Key[T]) -> Option[Bytes] {
    let Some(data) = key_revision(k) else {
        return None
    }
    Some(codec_storage.hash("hirsel.key-opaque.v1", data))
}

fn revisions(encoder: Option[View[Bytes]], decoder: Option[View[Bytes]], describer: Option[View[Bytes]]) -> Option[Bytes] {
    let (Some(e), Some(d), Some(w)) = (encoder, decoder, describer) else {
        return None
    }
    let mut out: Bytes = list.new()
    list.append(mut out, e)
    list.append(mut out, d)
    list.append(mut out, w)
    Some(take out)
}

/// Whether a and b decode with the same function (PROG-9 identity); allocates nothing, with or without revisions.
pub fn same_decoder[T, U](a: Codec[T], b: Codec[U]) -> bool {
    code.identity(a.decoder) == code.identity(b.decoder)
}

/// Whether the derived codec has no encodings.
pub fn is_empty[T](c: Codec[T]) -> bool {
    c.empty
}

/// A lower bound on the encoded length of any value of this type. Cost: O(1).
pub fn least[T](c: Codec[T]) -> u64 {
    c.smallest
}

// The whole-value entry points.
/// Appends x's bytes to out. Fails: Capacity; out then holds a prefix of x's bytes.
/// Error(CountOverflow(n)) reports an unrepresentable count before it is written.
/// Ex: `codec.encode(rows, row, mut out)?`
pub fn encode[T](c: Codec[T], x: T, mut out: Bytes) -> Result[(), EncodeError] {
    (code.callable(c.encoder))(x, mut out)
}

/// Decodes all of b against c's own schema: exactly the bytes encode produces.
/// Returns DecodeError for bytes no value encodes to. Refused admission raises
/// Capacity. Either way nothing it admitted remains. Ex: `codec.decode(rows, b)?`
pub fn decode[T](c: Codec[T], b: Bytes) -> Result[T, DecodeError] {
    decode_at(c, b, 0)
}

/// Decodes b from `start` to its end, as decode does; offsets are into b. A stored
/// value behind a header is read in place. Ex: `codec.decode_at(rows, row, 2)?`
pub fn decode_at[T](c: Codec[T], b: Bytes, start: u64) -> Result[T, DecodeError] {
    if start > list.len(b) {
        return Error(Truncated(list.len(b)))
    }
    let mut at = start
    match take_with(b, mut at, c) {
        Ok(x) => {
            if at != list.len(b) {
                return Error(Trailing(at))
            }
            Ok(take x)
        }
        Error(e) => Error(e),
    }
}

// The protocol: one put and one take per format row. A generated encode calls the puts
// in declaration order and a generated decode the takes; `at` is the read offset.
/// Truncated at `at` unless n more bytes follow it.
pub fn need(b: Bytes, at: u64, n: u64) -> Result[(), DecodeError] {
    if list.len(b) - at < n {
        return Error(Truncated(at))
    }
    Ok(())
}

fn put_byte(mut out: Bytes, x: u8) {
    list.push(mut out, x)
}

pub fn put_unit(x: (), mut out: Bytes) {}

pub fn take_unit(b: Bytes, mut at: u64) -> Result[(), DecodeError] {
    Ok(())
}

pub fn put_bool(x: bool, mut out: Bytes) {
    put_byte(mut out, if x {
        1
    } else {
        0
    })
}

pub fn take_bool(b: Bytes, mut at: u64) -> Result[bool, DecodeError] {
    need(b, at, 1)?
    let x = b[at]
    if x > 1 {
        return Error(Invalid(at))
    }
    at += 1
    Ok(x == 1)
}

pub fn put_u8(x: u8, mut out: Bytes) {
    put_byte(mut out, x)
}

pub fn take_u8(b: Bytes, mut at: u64) -> Result[u8, DecodeError] {
    need(b, at, 1)?
    let x = b[at]
    at += 1
    Ok(x)
}

pub fn put_u16(x: u16, mut out: Bytes) {
    list.put_word_le(mut out, x)
}

pub fn take_u16(b: Bytes, mut at: u64) -> Result[u16, DecodeError] {
    need(b, at, 2)?
    let x: u16 = list.word_le(b, at)
    at += 2
    Ok(x)
}

pub fn put_u32(x: u32, mut out: Bytes) {
    list.put_word_le(mut out, x)
}

pub fn take_u32(b: Bytes, mut at: u64) -> Result[u32, DecodeError] {
    need(b, at, 4)?
    let x: u32 = list.word_le(b, at)
    at += 4
    Ok(x)
}

pub fn put_u64(x: u64, mut out: Bytes) {
    list.put_word_le(mut out, x)
}

pub fn take_u64(b: Bytes, mut at: u64) -> Result[u64, DecodeError] {
    need(b, at, 8)?
    let x = list.word_le(b, at)
    at += 8
    Ok(x)
}

pub fn put_i8(x: i8, mut out: Bytes) {
    put_byte(mut out, int.truncate(x))
}

pub fn take_i8(b: Bytes, mut at: u64) -> Result[i8, DecodeError] {
    let x = take_u8(b, mut at)?
    Ok(int.truncate(x))
}

pub fn put_i16(x: i16, mut out: Bytes) {
    let bits: u16 = int.truncate(x)
    put_u16(bits, mut out)
}

pub fn take_i16(b: Bytes, mut at: u64) -> Result[i16, DecodeError] {
    let x = take_u16(b, mut at)?
    Ok(int.truncate(x))
}

pub fn put_i32(x: i32, mut out: Bytes) {
    let bits: u32 = int.truncate(x)
    put_u32(bits, mut out)
}

pub fn take_i32(b: Bytes, mut at: u64) -> Result[i32, DecodeError] {
    let x = take_u32(b, mut at)?
    Ok(int.truncate(x))
}

pub fn put_i64(x: i64, mut out: Bytes) {
    let bits: u64 = int.truncate(x)
    list.put_word_le(mut out, bits)
}

pub fn take_i64(b: Bytes, mut at: u64) -> Result[i64, DecodeError] {
    let x = take_u64(b, mut at)?
    Ok(int.truncate(x))
}

/// SEM-2's one NaN is 0x7fc00000; any other NaN pattern is no f32's bytes.
pub fn put_f32(x: f32, mut out: Bytes) {
    put_u32(float.to_bits32(x), mut out)
}

pub fn take_f32(b: Bytes, mut at: u64) -> Result[f32, DecodeError] {
    let start = at
    let x = take_u32(b, mut at)?
    if x & 0x7f800000 == 0x7f800000 && x & 0x7fffff != 0 && x != 0x7fc00000 {
        return Error(Invalid(start))
    }
    Ok(float.from_bits32(x))
}

/// SEM-2's one NaN is 0x7ff8000000000000; any other NaN pattern is no f64's bytes.
pub fn put_f64(x: f64, mut out: Bytes) {
    list.put_word_le(mut out, float.to_bits64(x))
}

pub fn take_f64(b: Bytes, mut at: u64) -> Result[f64, DecodeError] {
    need(b, at, 8)?
    let x = list.word_le(b, at)
    if x & 0x7ff0000000000000 == 0x7ff0000000000000 && x & 0xfffffffffffff != 0 && x != 0x7ff8000000000000 {
        return Error(Invalid(at))
    }
    at += 8
    Ok(float.from_bits64(x))
}

pub fn put_char(x: char, mut out: Bytes) {
    put_u32(char.to_u32(x), mut out)
}

pub fn take_char(b: Bytes, mut at: u64) -> Result[char, DecodeError] {
    let start = at
    let x = take_u32(b, mut at)?
    match char.from_u32(x) {
        Some(c) => Ok(c),
        None => Error(Invalid(start))
    }
}

// Check the wire width before any narrowing or output admission.
fn checked_count(n: u64) -> Result[u32, EncodeError] {
    if n > 0xffffffff {
        return Error(CountOverflow(n))
    }
    Ok(int.truncate(n))
}

fn put_count(n: u64, mut out: Bytes) -> Result[(), EncodeError] {
    let mut bits = checked_count(n)?
    list.fill(mut out, 4, 0u8)
    let end = list.len(out)
    for i in end - 4 .. end {
        out[i] = int.truncate(bits)
        bits = bits >> 8
    }
    Ok(())
}

pub fn put_string(x: String, mut out: Bytes) -> Result[(), EncodeError] {
    let raw = string.as_bytes(x)
    let mut bits = checked_count(list.len(raw))?
    // Keep prefix and payload in one encoder; put_count's growth body prevents inlining.
    list.fill(mut out, 4, 0u8)
    let end = list.len(out)
    for i in end - 4 .. end {
        out[i] = int.truncate(bits)
        bits = bits >> 8
    }
    list.append(mut out, raw)
    Ok(())
}

/// The count, then exactly that many bytes, copied into exact capacity and checked UTF-8.
pub fn take_string(b: Bytes, mut at: u64) -> Result[String, DecodeError] {
    let start = at
    let n: u64 = int.widen(take_u32(b, mut at)?)
    if list.len(b) - at < n {
        return Error(Truncated(start))
    }
    let mut buf: Bytes = list.with_capacity(n)
    let _ = list.append(mut buf, list.slice(b, at, at + n))
    match string.from_utf8(take buf) {
        Ok(s) => {
            at += n
            Ok(take s)
        }
        Error(_) => {
            let stop = match utf8.validate(list.slice(b, at, at + n)) {
                Ok(()) => n,
                Error(e) => e.valid_up_to,
            }
            Error(Utf8(at + stop))
        },
    }
}

/// A variant tag: the declared index of the variant, below `count`, else Invalid at it.
/// Written as a u32 whatever the number of variants (SEM-10).
pub fn put_tag(x: u32, mut out: Bytes) {
    put_u32(x, mut out)
}

pub fn take_tag(b: Bytes, mut at: u64, count: u32) -> Result[u32, DecodeError] {
    let start = at
    let x = take_u32(b, mut at)?
    if x >= count {
        return Error(Invalid(start))
    }
    Ok(x)
}

/// x with its codec: what a generated codec calls for a field of a non-scalar type.
pub fn put_with[T](x: T, c: Codec[T], mut out: Bytes) -> Result[(), EncodeError] {
    (code.callable(c.encoder))(x, mut out)
}

pub fn take_with[T](b: Bytes, mut at: u64, c: Codec[T]) -> Result[T, DecodeError] {
    let start = at
    take_payload(b, mut at, c, start)
}

fn take_payload[T](b: Bytes, mut at: u64, c: Codec[T], start: u64) -> Result[T, DecodeError] {
    if c.empty {
        return Error(Invalid(start))
    }
    (code.callable(c.decoder))(b, mut at)
}

pub fn put_list[T](xs: List[T], c: Codec[T], mut out: Bytes) -> Result[(), EncodeError] {
    put_count(list.len(xs), mut out)?
    for x in xs {
        (code.callable(c.encoder))(x, mut out)?
    }
    Ok(())
}

/// A List's or Map's count, Truncated at the count when n items of at least `least`
/// bytes each cannot fit in what remains. A frame loop calls it for a recursive field.
pub fn take_count(b: Bytes, mut at: u64, size: u64) -> Result[u64, DecodeError] {
    let start = at
    let n: u64 = int.widen(take_u32(b, mut at)?)
    if size != 0 && n > (list.len(b) - at) / size {
        return Error(Truncated(start))
    }
    Ok(n)
}

/// An empty list with room for exactly n elements.
pub fn room[T](n: u64) -> List[T] {
    list.with_capacity(n)
}

/// The count, then the elements. A count no remaining bytes could hold is Truncated at
/// the list before anything is admitted, so the list's storage is admitted once, exactly.
pub fn take_list[T](b: Bytes, mut at: u64, c: Codec[T]) -> Result[List[T], DecodeError] {
    let n = take_count(b, mut at, c.smallest)?
    let mut xs: List[T] = room(n)
    let mut i: u64 = 0
    while i < n {
        let x = take_with(b, mut at, c)?
        list.push(mut xs, take x)
        i += 1
    }
    Ok(take xs)
}

pub fn put_map[K: key, V](m: Map[K, V], ck: Codec[K], cv: Codec[V], mut out: Bytes) -> Result[(), EncodeError] {
    put_count(map.len(m), mut out)?
    for (k, v) in m {
        (code.callable(ck.encoder))(k, mut out)?
        (code.callable(cv.encoder))(v, mut out)?
    }
    Ok(())
}

/// The count, then key and value per entry in insertion order; a key equal to an earlier
/// one is Duplicate at the key.
pub fn take_map[K: key, V](b: Bytes, mut at: u64, ck: Codec[K], cv: Codec[V]) -> Result[Map[K, V], DecodeError] {
    let n = take_count(b, mut at, ck.smallest + cv.smallest)?
    let mut m: Map[K, V] = map.new()
    map.reserve(mut m, n)
    let mut i: u64 = 0
    while i < n {
        let key_at = at
        let k = take_with(b, mut at, ck)?
        if map.contains(m, k) {
            return Error(Duplicate(key_at))
        }
        let v = take_with(b, mut at, cv)?
        map.insert(mut m, take k, take v)
        i += 1
    }
    Ok(take m)
}

pub fn put_option[T](x: Option[T], c: Codec[T], mut out: Bytes) -> Result[(), EncodeError] {
    match x {
        None => {
            put_tag(0, mut out)
            Ok(())
        },
        Some(v) => {
            put_tag(1, mut out)
            (code.callable(c.encoder))(v, mut out)
        }
    }
}

pub fn take_option[T](b: Bytes, mut at: u64, c: Codec[T]) -> Result[Option[T], DecodeError] {
    let start = at
    if take_tag(b, mut at, 2)? == 0 {
        return Ok(None)
    }
    let v = take_payload(b, mut at, c, start)?
    Ok(Some(take v))
}

pub fn put_result[T, E](x: Result[T, E], ct: Codec[T], ce: Codec[E], mut out: Bytes) -> Result[(), EncodeError] {
    match x {
        Ok(v) => {
            put_tag(0, mut out)
            (code.callable(ct.encoder))(v, mut out)
        }
        Error(e) => {
            put_tag(1, mut out)
            (code.callable(ce.encoder))(e, mut out)
        }
    }
}

pub fn take_result[T, E](b: Bytes, mut at: u64, ct: Codec[T], ce: Codec[E]) -> Result[Result[T, E], DecodeError] {
    let start = at
    if take_tag(b, mut at, 2)? == 0 {
        let v = take_payload(b, mut at, ct, start)?
        return Ok(Ok(take v))
    }
    let e = take_payload(b, mut at, ce, start)?
    Ok(Error(take e))
}

/// A `codec via R (to, from)` type decodes an R under R's codec, then calls from once; an
/// Error from it is dropped and the result is Value where the R began (SEM-10). Encoding
/// needs no step of its own: `to` returns a view anchored to its argument, which no
/// callable type holds (LANG-13), so a generated encode is `put_with(to(x), c, mut out)`.
pub fn take_via[T, R, E](b: Bytes, mut at: u64, c: Codec[R], from: fn(take R) -> Result[T, E]) -> Result[T, DecodeError] {
    let start = at
    let r = take_with(b, mut at, c)?
    match from(take r) {
        Ok(x) => Ok(take x),
        Error(_) => Error(Value(start))
    }
}

// A built-in codec's describer: its scalar's schema.
fn describe_unit(mut s: Schema, _c: Codec[()]) -> Result[(), EncodeError] {
    schema_unit(mut s)
    Ok(())
}

fn describe_bool(mut s: Schema, _c: Codec[bool]) -> Result[(), EncodeError] {
    schema_bool(mut s)
    Ok(())
}

fn describe_char(mut s: Schema, _c: Codec[char]) -> Result[(), EncodeError] {
    schema_char(mut s)
    Ok(())
}

fn describe_u8(mut s: Schema, _c: Codec[u8]) -> Result[(), EncodeError] {
    schema_u8(mut s)
    Ok(())
}

fn describe_u16(mut s: Schema, _c: Codec[u16]) -> Result[(), EncodeError] {
    schema_u16(mut s)
    Ok(())
}

fn describe_u32(mut s: Schema, _c: Codec[u32]) -> Result[(), EncodeError] {
    schema_u32(mut s)
    Ok(())
}

fn describe_u64(mut s: Schema, _c: Codec[u64]) -> Result[(), EncodeError] {
    schema_u64(mut s)
    Ok(())
}

fn describe_i8(mut s: Schema, _c: Codec[i8]) -> Result[(), EncodeError] {
    schema_i8(mut s)
    Ok(())
}

fn describe_i16(mut s: Schema, _c: Codec[i16]) -> Result[(), EncodeError] {
    schema_i16(mut s)
    Ok(())
}

fn describe_i32(mut s: Schema, _c: Codec[i32]) -> Result[(), EncodeError] {
    schema_i32(mut s)
    Ok(())
}

fn describe_i64(mut s: Schema, _c: Codec[i64]) -> Result[(), EncodeError] {
    schema_i64(mut s)
    Ok(())
}

fn describe_f32(mut s: Schema, _c: Codec[f32]) -> Result[(), EncodeError] {
    schema_f32(mut s)
    Ok(())
}

fn describe_f64(mut s: Schema, _c: Codec[f64]) -> Result[(), EncodeError] {
    schema_f64(mut s)
    Ok(())
}

fn describe_string(mut s: Schema, _c: Codec[String]) -> Result[(), EncodeError] {
    schema_string(mut s)
    Ok(())
}

/// T's codec. The checker resolves each call by the instance's T (SEM-10): to the built-in
/// codec below for a scalar, `()`, Never and String, to the structural codec for List,
/// Option, Map and Result, to a componentwise codec for a tuple, and to the codec
/// generated from T's declaration for a nominal type. No instance
/// of `of` is ever built, so this body, which only states the signature in checked Hirsel,
/// never runs.
pub fn of[T: codec]() -> Codec[T] {
    of()
}

// The structural codecs: `of` resolves to these at List, Option, Map and Result (Bytes is
// List[u8]). Each is the field path itself, put_list and the rest with `of()` for the
// elements, so a value encodes as the same type does as a field.
/// The codec of List[E]: the u32 count, then each element. Ex: `let c: Codec[List[u64]] = codec.of()`
pub fn of_list[E: codec]() -> Codec[List[E]] {
    storage_make(code.describe(list_encode), code.describe(list_decode), code.describe(describe_list), 4, false)
}

/// The codec of Bytes (List[u8]), which `of` resolves to at List[u8]: the u32 count, then
/// the bytes, moved in bulk. Its bytes, charges, failures and schema are of_list's at u8.
pub fn of_bytes() -> Codec[Bytes] {
    storage_make(code.describe(put_bytes), code.describe(take_bytes), code.describe(describe_bytes), 4, false)
}

/// The count, then the bytes. out grows as pushing them one by one grows it, by one
/// growth at a time, so a Capacity leaves the same prefix and the same capacity.
fn put_bytes(xs: Bytes, mut out: Bytes) -> Result[(), EncodeError] {
    put_count(list.len(xs), mut out)?
    let n = list.len(xs)
    let mut i: u64 = 0
    while i < n {
        let space = list.capacity(out) - list.len(out)
        if space == 0 {
            // Growth only where put_byte's push would grow out, by MEM-24 as it does.
            put_byte(mut out, xs[i])
            i += 1
        } else {
            let k = if space < n - i {
                space
            } else {
                n - i
            }
            list.append(mut out, list.slice(xs, i, i + k))
            i += k
        }
    }
    Ok(())
}

/// The count, Truncated at the count when fewer bytes remain, then exactly that many.
fn take_bytes(b: Bytes, mut at: u64) -> Result[Bytes, DecodeError] {
    let n = take_count(b, mut at, 1)?
    let mut xs: Bytes = room(n)
    // Within the exact capacity room admitted, so the append never grows.
    let _ = list.append(mut xs, list.slice(b, at, at + n))
    at += n
    Ok(take xs)
}

fn describe_bytes(mut s: Schema, _c: Codec[Bytes]) -> Result[(), EncodeError] {
    schema_list(mut s, of_u8())
}

/// The codec of Option[E]: tag 0 for None, or tag 1 then the value.
pub fn of_option[E: codec]() -> Codec[Option[E]] {
    storage_make(code.describe(option_encode), code.describe(option_decode), code.describe(describe_option), 4, false)
}

/// The codec of Map[K, V]: the u32 count, then key and value per entry in insertion order.
pub fn of_map[K: key + codec, V: codec]() -> Codec[Map[K, V]] {
    storage_make(code.describe(map_encode), code.describe(map_decode), code.describe(describe_map), 4, false)
}

/// The codec of Result[T, E]: tag 0 then the Ok value, or tag 1 then the Error value.
pub fn of_result[T: codec, E: codec]() -> Codec[Result[T, E]] {
    let ct: Codec[T] = of()
    let ce: Codec[E] = of()
    storage_make(code.describe(result_encode), code.describe(result_decode), code.describe(describe_result), 4, ct.empty && ce.empty)
}

fn list_encode[E: codec](xs: List[E], mut out: Bytes) -> Result[(), EncodeError] {
    put_list(xs, of(), mut out)
}

fn list_decode[E: codec](b: Bytes, mut at: u64) -> Result[List[E], DecodeError] {

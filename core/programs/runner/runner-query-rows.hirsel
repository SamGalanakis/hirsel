// Allocate the log in the publisher's budget before a query enters its bindings.
fn row_log() -> Result[Log[Row], Capacity] {
    let output: Log[Row] = log.new()
    log.append(output, Row(slot: 0u16, key: list.new(), value: None))
    Ok(take output)
}

fn slot_rows(take output: Log[Row]) -> List[Row] {
    let mut rows = log.finish(take output)
    let _ = list.remove(mut rows, 0u64)
    take rows
}

fn read_rows(take output: Log[Row], sub: u32) -> List[SubRow] {
    wire_rows(slot_rows(take output), sub)
}

fn wire_rows(take projected: List[Row], sub: u32) -> List[SubRow] {
    let mut rows: List[SubRow] = list.with_capacity(list.len(projected))
    for take item in take projected {
        let Row(key: take key, value: take value, ..) = take item
        list.push(mut rows, SubRow(sub: sub, key: take key, value: take value))
    }
    take rows
}

type CoverRow { slot: u16, change: store.Change }
type CoverCursor { next_span: u64, first: bool, active: Option[store.SpanRows] }
type ProjectionIssue = ProjectionStopped(Outcome) | ProjectionRead(store.Error)

fn projection_cause(cs: Causes) -> Outcome {
    for cause in cs {
        if let Capacity(problem) = cause.kind { return Failed(OutOfBytes(capacity_room(problem))) }
        break
    }
    Failed(Raised(raised(cs)))
}

fn projection_result[R](take projected: Result[Result[Result[R, store.Error], Causes], Capacity]) -> Result[R, ProjectionIssue] {
    match take projected {
        Ok(Ok(Ok(take answer))) => Ok(take answer),
        Ok(Ok(Error(take problem))) => Error(ProjectionRead(take problem)),
        Ok(Error(cs)) => Error(ProjectionStopped(projection_cause(cs))),
        Error(problem) => Error(ProjectionStopped(Failed(OutOfBytes(capacity_room(problem))))),
    }
}

fn finish_projection(take problem: ProjectionIssue, take reads: List[store.Read]) -> Queried {
    match take problem {
        ProjectionStopped(take why) => Faulted(take why, take reads),
        ProjectionRead(take why) => projection_error(take why, take reads),
    }
}

fn stop_projection(take problem: ProjectionIssue) -> Queried {
    match take problem {
        ProjectionStopped(take why) => Stopped(take why),
        ProjectionRead(take why) => projection_error(take why, list.new()),
    }
}

fn has_tail(spans: List[Cover]) -> bool {
    for span in spans {
        if let Some(_) = span.tail { return true }
    }
    false
}

fn image_spans(reader: store.Reader, at: store.Snapshot, spans: List[Cover], bindings: List[BoundSlot]) -> Result[List[Cover], ProjectionIssue] waits {
    let mut resolved = projection_result(isolate(scoped fn() -> Result[List[Cover], store.Error] {
        Ok(list.with_capacity(list.len(spans)))
    }))?
    for span in spans {
        if let Some(length) = span.tail {
            let binding = view bindings[int.widen(span.slot)]
            let Some(resolve) = view binding.tail_window else { fail("runner: a tail cover needs a Log binding") }
            let window = resolve(reader, at, length) ?=> |problem| ProjectionRead(take problem)
            let id = binding.collection.1
            if window.first < window.next {
                let bounds = projection_result(isolate(scoped fn() -> Result[Cover, store.Error] {
                    Ok(Cover(slot: span.slot, low: cover_log_key(id, window.first),
                        high: cover_log_key(id, window.next), tail: None))
                }))?
                list.push(mut resolved, take bounds)
            }
        } else {
            let copied = projection_result(isolate(scoped fn() -> Result[Cover, store.Error] { Ok(clone(span)) }))?
            list.push(mut resolved, take copied)
        }
    }
    projection_result(isolate(scoped fn() -> Result[List[Cover], store.Error] { Ok(merge_covers(clone(resolved))) }))
}

fn cover_cursor() -> CoverCursor {
    CoverCursor(next_span: 0u64, first: false, active: None)
}

fn next_cover_row(access: PublisherReads, read_handle: store.Reader, at: store.Snapshot,
    spans: List[Cover], mut cursor: CoverCursor) -> Result[Option[CoverRow], store.Error] waits {
    loop {
        if let Some(mut active) = cursor.active {
            let changed = (access.span)(read_handle, mut active, cursor.first)?
            if let Some(take row) = take changed {
                cursor.first = false
                return Ok(Some(CoverRow(slot: spans[cursor.next_span - 1u64].slot, change: take row)))
            }
        }
        if cursor.next_span == list.len(spans) { return Ok(None) }
        let span = view spans[cursor.next_span]
        cursor.active = Some(store.open_span_changes(read_handle, at, span.low, span.high)?)
        cursor.next_span += 1u64
        cursor.first = true
    }
}

fn published_slot(row: CoverRow, bindings: List[BoundSlot]) -> Result[Option[Bytes], store.Error] {
    (bindings[int.widen(row.slot)].publish_value)(row.change)
}

fn convert_cover_row(out: Log[Row], bindings: List[BoundSlot], row: CoverRow, include_value: bool) -> Result[(), ProjectionIssue] {
    projection_result(isolate(scoped fn() -> Result[(), store.Error] {
        let value = if include_value { published_slot(row, bindings)? } else { None }
        log.append(out, Row(slot: row.slot, key: clone(row.change.tree_key), value: take value))
        Ok(())
    }))
}

fn cover_rows(access: PublisherReads, read_handle: store.Reader, at: store.Snapshot,
    spans: List[Cover], bindings: List[BoundSlot], out: Log[Row]) -> Result[(), ProjectionIssue] waits {
    if has_tail(spans) {
        let image = image_spans(read_handle, at, spans, bindings)?
        return complete_rows(access, read_handle, at, image, bindings, out)
    }
    complete_rows(access, read_handle, at, spans, bindings, out)
}

fn complete_rows(access: PublisherReads, read_handle: store.Reader, at: store.Snapshot,
    spans: List[Cover], bindings: List[BoundSlot], out: Log[Row]) -> Result[(), ProjectionIssue] waits {
    let mut cursor = cover_cursor()
    while let Some(take changed) = next_cover_row(access, read_handle, at, spans, mut cursor) ?=> |problem| ProjectionRead(take problem) {
        convert_cover_row(out, bindings, changed, true)?
    }
    Ok(())
}

fn compare_projected(a: CoverRow, b: CoverRow) -> Order {
    if a.slot < b.slot { return Less }
    if a.slot > b.slot { return Greater }
    list.compare_bytes(a.change.tree_key, b.change.tree_key)
}

fn rerun_rows(access: PublisherReads, read_handle: store.Reader, a: store.Snapshot, old: List[Cover],
    b: store.Snapshot, new: List[Cover], bindings: List[BoundSlot], out: Log[Row]) -> Result[(), ProjectionIssue] waits {
    if has_tail(old) || has_tail(new) {
        let old_image = image_spans(read_handle, a, old, bindings)?
        let new_image = image_spans(read_handle, b, new, bindings)?
        return diff_image_rows(access, read_handle, a, old_image, b, new_image, bindings, out)
    }
    diff_image_rows(access, read_handle, a, old, b, new, bindings, out)
}

fn diff_image_rows(access: PublisherReads, read_handle: store.Reader, a: store.Snapshot, old: List[Cover],
    b: store.Snapshot, new: List[Cover], bindings: List[BoundSlot], out: Log[Row]) -> Result[(), ProjectionIssue] waits {
    let mut before = cover_cursor()
    let mut after = cover_cursor()
    let mut previous = next_cover_row(access, read_handle, a, old, mut before) ?=> |problem| ProjectionRead(take problem)
    let mut next = next_cover_row(access, read_handle, b, new, mut after) ?=> |problem| ProjectionRead(take problem)
    loop {
        let order = match (view previous, view next) {
            (Some(x), Some(y)) => compare_projected(x, y),
            (Some(_), None) => Less,
            (None, Some(_)) => Greater,
            (None, None) => return Ok(()),
        }
        if let Less = order {
            let removed = option.unwrap(replace(mut previous, None))
            convert_cover_row(out, bindings, removed, false)?
            previous = next_cover_row(access, read_handle, a, old, mut before) ?=> |problem| ProjectionRead(take problem)
            continue
        }
        let row = option.unwrap(replace(mut next, None))
        let changed = if let Equal = order {
            let previous_row = option.unwrap(replace(mut previous, None))
            previous = next_cover_row(access, read_handle, a, old, mut before) ?=> |problem| ProjectionRead(take problem)
            previous_row.change.value != row.change.value
        } else {
            true
        }
        if changed {
            convert_cover_row(out, bindings, row, true)?
        }
        next = next_cover_row(access, read_handle, b, new, mut after) ?=> |problem| ProjectionRead(take problem)
    }
}

fn covered_rows(changes: List[store.Change], span: Cover, bindings: BoundSlot, out: Log[Row]) -> Result[(), store.Error] {
    for changed in changes {
        let value = (bindings.publish_value)(changed)?
        let key: Bytes = clone(changed.tree_key)
        log.append(out, Row(slot: span.slot, key: take key, value: take value))
    }
    Ok(())
}

fn cover_projection(take projected: Result[Result[Result[(), store.Error], Causes], Capacity]) -> Result[(), Queried] {
    Ok(projection_result(take projected) ?=> stop_projection)
}

fn cover_delta_span(access: PublisherReads, reader: store.Reader, at: store.Snapshot, position: u16,
    lo: Bytes, hi: Bytes, inserting: bool, binding: BoundSlot, out: Log[Row]) -> Result[(), Queried] waits {
    let mut source = store.open_span_changes(reader, at, lo, hi) ?=> |e| projection_error(take e, list.new())
    let mut first = true
    while let Some(take item) = (access.span)(reader, mut source, first) ?=> |e| projection_error(take e, list.new()) {
        let projected = isolate(scoped fn() -> Result[(), store.Error] {
            let value = if inserting { (binding.publish_value)(item)? } else { None }
            log.append(out, Row(slot: position, key: clone(item.tree_key), value: take value))
            Ok(())
        })
        cover_projection(take projected)?
        first = false
    }
    Ok(())
}

fn covered_pages(access: PublisherReads, read_handle: store.Reader, a: store.Snapshot, b: store.Snapshot,
    span: Cover, bindings: BoundSlot, rows: Log[Row]) -> Result[(), Queried] waits {
    let base: Option[store.Snapshot] = Some(clone(a))
    let mut low = projection_result(isolate(scoped fn() -> Result[Bytes, store.Error] { Ok(clone(span.low)) })) ?=> stop_projection
    loop {
        let page = (access.changes)(read_handle, base, b, low, span.high, publication_page_limits()) ?=> |e| projection_error(take e, list.new())
        for trim in page.trimmed {
            cover_delta_span(access, read_handle, a, span.slot, trim.lo, trim.hi, false, bindings, rows)?
        }
        let projected = isolate(scoped fn() -> Result[(), store.Error] { covered_rows(page.changes, span, bindings, rows) })
        cover_projection(take projected)?
        let store.ChangePage(next: take resume, ..) = take page
        match take resume {
            Some(take continuation) => { low = take continuation },
            None => return Ok(()),
        }
    }
}

type CoverEdge { slot: u16, key: Bytes, before: bool }

fn add_cover_edges(mut edges: List[CoverEdge], spans: List[Cover], before: bool) {
    for span in spans {
        list.push(mut edges, CoverEdge(slot: span.slot, key: clone(span.low), before: before))
        list.push(mut edges, CoverEdge(slot: span.slot, key: clone(span.high), before: before))
    }
}

fn covered_window_pages(access: PublisherReads, reader: store.Reader, a: store.Snapshot, b: store.Snapshot,
    spans: List[Cover], bindings: List[BoundSlot], rows: Log[Row]) -> Result[(), Queried] waits {
    let before = image_spans(reader, a, spans, bindings) ?=> stop_projection
    let after = image_spans(reader, b, spans, bindings) ?=> stop_projection
    let edges = projection_result(isolate(scoped fn() -> Result[List[CoverEdge], store.Error] {
        let mut ordered: List[CoverEdge] = list.with_capacity(2u64 * (list.len(before) + list.len(after)))
        add_cover_edges(mut ordered, before, true)
        add_cover_edges(mut ordered, after, false)
        list.sort(mut ordered, scoped fn(x: CoverEdge, y: CoverEdge) -> Order {
            if x.slot < y.slot { Less } else if x.slot > y.slot { Greater } else { list.compare_bytes(x.key, y.key) }
        })
        Ok(take ordered)
    })) ?=> stop_projection

    // Only window edges can change membership. Shared ranges page through changes and trims.
    let mut was = false
    let mut now = false
    for i in 0u64 .. int.saturating_sub(list.len(edges), 1u64) {
        let edge = view edges[i]
        if edge.before { was = !was } else { now = !now }
        let next = view edges[i + 1u64]
        if edge.slot != next.slot || edge.key == next.key || !(was || now) { continue }
        let binding = view bindings[int.widen(edge.slot)]
        if was && now {
            let span = projection_result(isolate(scoped fn() -> Result[Cover, store.Error] {
                Ok(Cover(slot: edge.slot, low: clone(edge.key), high: clone(next.key), tail: None))
            })) ?=> stop_projection
            covered_pages(access, reader, a, b, span, binding, rows)?
        } else {
            let at: store.Snapshot = if now { clone(b) } else { clone(a) }
            cover_delta_span(access, reader, at, edge.slot, edge.key, next.key, now, binding, rows)?
        }
    }
    Ok(())
}

fn covered_all_pages(access: PublisherReads, read_handle: store.Reader, a: store.Snapshot, b: store.Snapshot,
    spans: List[Cover], bindings: List[BoundSlot], rows: Log[Row]) -> Result[(), Queried] waits {
    if has_tail(spans) {
        return covered_window_pages(access, read_handle, a, b, spans, bindings, rows)
    }
    for span in spans {
        covered_pages(access, read_handle, a, b, span, bindings[int.widen(span.slot)], rows)?
    }
    Ok(())
}

pub fn tiered_source(roots: pages.Roots, id: u32) -> Result[bool, types.Failure] {
    let Some(descriptor) = std.page.lookup(roots.collections.root, prefix(id)?) else {
        return Ok(false)
    }
    Ok(pages.collection_descriptor(descriptor).residency == ResidentTiered)
}

pub fn define_collection(mut tree: pages.PageTree, id: u32, kind: u8, private_from: u64, mut ids: u64) -> Result[(), types.Failure] {
    pages.put_collection(mut tree, prefix(id)?, None, kind, private_from, mut ids)
}

pub fn remove_store_collection(mut tree: pages.PageTree, id: u32, mut final_item: u64) -> Result[u64, types.Failure] {
    let key = prefix(id)?
    let charge = match std.page.lookup(tree.root, key) {
        Some(descriptor) => {
            let fields = pages.collection_descriptor(descriptor)
            if fields.residency == ResidentTiered {
                126u64
            } else {
                int.saturating_add(126, fields.row_bytes)
            }
        },
        None => 0u64,
    }
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    let _ = drop_collection(mut tree, id, first, mut next_stamp)?
    pages.canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(charge)
}

pub fn bulk_collection(mut tree: pages.PageTree, id: u32, kind: u8, rows: List[std.page.Row], private_from: u64, mut ids: u64) -> Result[(), types.Failure] {
    let bulk = pages.page_result(std.page.bulk(rows, Collection, tree.inline, mut ids))?
    pages.put_collection(mut tree, prefix(id)?, bulk, kind, private_from, mut ids)
}

pub fn count_page_rows(tree: pages.PageTree, id: u32, low: Bytes, high: Bytes) -> Result[u64, types.Failure] {
    let collection_key = prefix(id)?
    let Some((root, descriptor)) = std.page.collection_entry(tree.root, collection_key) else {
        return Ok(0u64)
    }
    let total: u64 = pages.collection_descriptor(descriptor).rows
    let from = pages.collection_rank(root, collection_key, low, total)
    let until = pages.collection_rank(root, collection_key, high, total)
    Ok(int.saturating_sub(until, from))
}

pub fn drop_collection(mut tree: pages.PageTree, id: u32, private_from: u64, mut ids: u64) -> Result[bool, types.Failure] {
    pages.page_result(std.page.remove(mut tree.root, prefix(id)?, private_from, mut ids))
}

pub fn collection_cursor(tree: pages.PageTree, id: u32, low: Bytes, high: Bytes, reverse: bool) -> Result[Option[pages.CollectionCursor], types.Failure] {
    let leading = prefix(id)?
    let low_prefix = list.slice(low, 0, order.min(4, list.len(low)))
    let high_prefix = list.slice(high, 0, order.min(4, list.len(high)))
    if high <= low || high_prefix < leading || low_prefix > leading {
        return Ok(None)
    }
    let Some(root) = std.page.collection_child(tree.root, leading) else {
        return Ok(None)
    }
    let start = if low_prefix == leading {
        Some(types.copied(list.slice(low, 4, list.len(low)))?)
    } else {
        None
    }
    let stop = if high_prefix == leading {
        Some(types.copied(list.slice(high, 4, list.len(high)))?)
    } else {
        None
    }
    let walk = if reverse {
        std.page.cursor_open_bounded(root, stop, false, true, take start)
    } else {
        std.page.cursor_open_bounded(root, start, true, false, take stop)
    }
    Ok(Some(pages.CollectionCursor(walk: take walk, leading: take leading)))
}

pub fn next_page_range(mut rows: pages.PageRange) -> Result[Option[(Bytes, Arc[Bytes])], types.Failure] {
    if !rows.nested {
        if let Some(take item) = std.page.cursor_next(mut rows.listed) {
            let std.page.CursorRow(key: take key, value: take value, ..) = take item
            return Ok(Some((take key, take value)))
        }
        return Ok(None)
    }
    loop {
        if list.len(rows.active) != 0 {
            if let Some(take item) = std.page.cursor_next(mut rows.active[0u64]) {
                let std.page.CursorRow(key: take key, value: take value, ..) = take item
                return Ok(Some((logical_key(rows.collection, key)?, take value)))
            }
            let _ = list.pop(mut rows.active)
        }
        let Some(take found) = std.page.cursor_next(mut rows.listed) else {
            return Ok(None)
        }
        let std.page.CursorRow(key: take key, value: take descriptor, collection: take subtree) = take found
        let Some(take root) = take subtree else {
            return Error(pages.malformed(0))
        }
        if pages.collection_descriptor(descriptor).kind == CellCollection {
            if pages.range_has_cell(rows, key) {
                if let Some(take value) = pages.owned_cell(root, descriptor) {
                    return Ok(Some((take key, take value)))
                }
            }
        } else {
            pages.open_page_collection(mut rows, key, root)?
        }
    }
}

pub fn prefix(id: u32) -> Result[Bytes, types.Failure] {
    prefixed(id, 0, false)
}

// The 4-byte big-endian id, in a buffer with room for `rest` more bytes.
pub fn prefixed(id: u32, rest: u64, tail: bool) -> Result[Bytes, types.Failure] {
    let mut p: Bytes = if tail {
        bytebuf.with_tail(4 + rest)
    } else {
        list.with_capacity(4 + rest)
    }
    list.put_word_be(mut p, id)
    Ok(take p)
}

// One allocation: the key is appended into the prefix's spare capacity.
pub fn logical_key(id: u32, key: Bytes) -> Result[Bytes, types.Failure] {
    let mut p = prefixed(id, list.len(key), false)?
    list.append(mut p, key)
    Ok(take p)
}

pub fn decoded[T](take r: Result[T, std.codec.DecodeError]) -> Result[T, types.Failure] {
    match take r {
        Ok(take x) => Ok(take x),
        Error(e) => Error(Decode(e))
    }
}

pub fn encode_key[K](k: std.codec.Key[K], value: K) -> Result[Bytes, types.Failure] {
    let mut raw: Bytes = list.new()
    std.codec.encode_key(k, value, mut raw)
    Ok(take raw)
}

pub fn prefix_after(raw: Bytes) -> Result[Bytes, types.Failure] {
    let mut out = types.copied(raw)?
    let mut i = list.len(out)
    while i > 0 {
        i -= 1
        if out[i] != 255 {
            let byte = out[i] + 1
            let _ = list.set(mut out, i, byte)
            while list.len(out) > i + 1 {
                let _ = list.pop(mut out)
            }
            return Ok(take out)
        }
    }
    Ok(take out)
}

pub fn table_key(name: String) -> Result[Bytes, types.Failure] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k: Bytes = list.new()
    list.push(mut k, 1u8)
    list.append(mut k, string.as_bytes(name))
    Ok(take k)
}

pub fn index_prefix(id: u32) -> Result[Bytes, types.Failure] {
    let mut k: Bytes = list.new()
    list.push(mut k, 2u8)
    list.append(mut k, prefix(id)?)
    Ok(take k)
}

pub fn catalog_index_key(id: u32, name: String) -> Result[Bytes, types.Failure] {
    if string.byte_len(name) > 255 {
        return Error(Limit(Name))
    }
    let mut k = index_prefix(id)?
    list.append(mut k, string.as_bytes(name))
    Ok(take k)
}

pub fn stamp_after(final_item: u64) -> Result[u64, types.Failure] {
    let Some(next_stamp) = int.checked_add(final_item, 1) else {
        return Error(Limit(Ids))
    }
    Ok(next_stamp)
}

pub fn define_store_collection(mut tree: pages.PageTree, id: u32, kind: u8, mut final_item: u64) -> Result[(), types.Failure] {
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    define_collection(mut tree, id, kind, first, mut next_stamp)?
    pages.canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(())
}

pub fn bulk_store_collection(mut tree: pages.PageTree, id: u32, kind: u8, rows: List[std.page.Row], mut final_item: u64) -> Result[(), types.Failure] {
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    bulk_collection(mut tree, id, kind, rows, first, mut next_stamp)?
    pages.canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(())
}

pub fn remove_store_row(mut tree: pages.PageTree, key: Bytes, mut final_item: u64) -> Result[(), types.Failure] {
    let first = stamp_after(final_item)?
    let mut next_stamp = first
    let _ = pages.remove_page_row(mut tree, key, first, mut next_stamp)?
    pages.canonical_tree(mut tree)?
    final_item = next_stamp - 1
    Ok(())
}

// What a migrate builds before its cut: the new roots and the account.
pub type Built {
    roots: pages.Roots,
    live: u64,
    read: u64,
    written: u64
}

pub fn over_ceiling(live_bytes: u64, ceiling: u64) -> Result[(), types.Failure] {
    if live_bytes > ceiling {
        return Error(Full(Resident(Capacity(requested: live_bytes, available: ceiling))))
    }
    Ok(())
}

pub fn insert_row(mut ids: u64, mut roots: pages.Roots, take p: Bytes, take raw: Bytes) -> Result[bool, types.Failure] {
    let replaced = match pages.get_page_row(roots.collections, p) {
        Some(_) => true,
        None => false
    }
    let first = stamp_after(ids)?
    let mut next_stamp = first
    let collection_key = list.slice(p, 0, 4)
    let exists = match std.page.collection_child(roots.collections.root, collection_key) {
        Some(_) => true,
        None => false,
    }
    if !exists {
        define_collection(mut roots.collections, list.word_be(p, 0), 1, first, mut next_stamp)?
    }
    pages.put_page_row(mut roots.collections, p, raw, first, mut next_stamp)?
    pages.canonical_tree(mut roots.collections)?
    ids = next_stamp - 1
    Ok(replaced)
}

pub fn same_bytes(a: Bytes, b: Bytes) -> bool {
    a == b
}

pub fn catalog_insert(mut ids: u64, roots: pages.Roots, k: Bytes, v: Bytes) -> Result[pages.Roots, types.Failure] {
    let mut edited = pages.share_roots(roots)
    let first = stamp_after(ids)?
    let mut next_stamp = first
    pages.put_page_row(mut edited.catalog, k, v, first, mut next_stamp)?
    pages.canonical_tree(mut edited.catalog)?
    ids = next_stamp - 1
    Ok(take edited)
}

pub fn next_bytes(mut rows: pages.PageRange) -> Result[Option[(Bytes, Arc[Bytes])], types.Failure] {
    next_page_range(mut rows)
}

pub fn named(s: String) -> Result[String, types.Failure] {
    Ok(string.from(s))
}

pub type IndexProjection[K, V, P]: send {
    by: StaticFn[fn(K, V) -> Result[P, Capacity]],
    codec: std.codec.Codec[P],
    number: Option[u16]
}

pub type ValueSchema: shareable + send {
    number: u16,
    fingerprint: u64,
    schema: Bytes
}

pub fn record_public(raw: Bytes) -> bool {
    list.len(raw) > 0 && raw[list.len(raw) - 1] == 0u8
}

// A declared `Keep(n)`, untyped, for the sweep. It is part of the release's
// declaration, like an index's extractor, so the catalog does not hold it.
pub type LogRetention: shareable + send {
    id: u32,
    catalog_key: Arc[Bytes],
    catalog_page: Arc[Bytes],
    // None: the declaration says Forever.
    keep: Option[u64]
}

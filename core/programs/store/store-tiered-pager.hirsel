type TieredPagerSource: send = PagerDirectory(Dir) | PagerBucket(std.object.Requests, u64)

type TieredPagerInput = PagerLocal(Dir) | PagerObjects(std.object.Client, u64)

type TieredPagerTarget: send {
    edge: TieredTarget,
    direction: TieredDirection,
    inventory: PagePack,
    object: Option[HistoryRef],
    next_stamp: u64,
    deadline: u64
}

type TieredPagerPack: shareable + send {
    inventory: PagePack,
    object: Option[HistoryRef]
}

type TieredReadInventory: shareable + send {
    packs: std.omap.OMap[u64, TieredPagerPack],
    generation: u64,
    // The generation's MANIFEST `next_stamp`: every frame its packs hold is
    // below it (M6), including a promoted holder's materialized pages.
    next_stamp: u64
}

type TieredPageSource {
    pager: Sender[TieredPagerMessage],
    packs: std.omap.OMap[u64, TieredPagerPack],
    next_stamp: u64,
    deadline: u64
}

// A latched miss's batch: the target and its key, the values the read at the
// key goes on to read, `paths` more key paths gathered by `fetch_many`, and a
// scan's sibling window. `room` bounds the bytes of the scan's later values
// the pager adds: the attempt's partition less what it touched.
type TieredPointDemand: send {
    target: TieredTarget,
    key: Bytes,
    values: TieredValues,
    room: u64,
    direction: TieredDirection,
    paths: List[TieredPath],
    siblings: List[TieredTarget],
    packs: std.omap.OMap[u64, TieredPagerPack],
    next_stamp: u64,
    deadline: u64,
    grant: Option[Arc[TieredReaderGrant]]
}

type TieredPointDelivery: send {
    frames: List[Arc[TieredFrame]],
    // The path frames that lead `frames`, values read at their keys
    // included; installing a later frame of the delivery never evicts one of
    // these. 0 for a lone path's frames with nothing after them.
    held: u64,
    failure: Option[(TieredTarget, Error)],
    grant: Option[Arc[TieredReaderGrant]]
}

// PagerKick only wakes a pager blocked on its inbox so that it looks at the
// writer slot (§13.3a); it carries nothing.
type TieredPagerMessage: send = PagerRead(TieredPagerTarget, Sender[Result[Arc[TieredFrame], Error]]) | PagerPoint(TieredPointDemand, Sender[Result[TieredPointDelivery, Error]]) | PagerReserve(u64, Sender[Result[Arc[TieredReaderGrant], Error]]) | PagerIndex(TieredIndexRequest, Sender[Result[Arc[Bytes], Error]]) | PagerKick

type TieredPagerStart: send {
    store: StoreId,
    opened: u64,
    authority: TieredPagerSource,
    inbox: Receiver[TieredPagerMessage],
    // The one-slot writer channel and the coalescing park notice (§13.3a).
    writer: Receiver[TieredPagerMessage],
    notices: Sender[()],
    shared_bytes: u64
}

// What the Db task keeps of a started pager: the shared inbox, the writer
// slot, the park notices and the task (§13.3a).
type TieredPagerLink {
    requests: Sender[TieredPagerMessage],
    writer: Sender[TieredPagerMessage],
    notices: Receiver[()],
    worker: Task[()]
}

type TieredPagerFunding {
    cache_bytes: u64,
    writer_pin_bytes: u64,
    pager_task_bytes: u64,
    cut_pins: bool
}

// Demands a store's open pager queues before a sender waits (§13.2).
const TIERED_PAGER_QUEUE: u64 = 4

fn start_tiered_pager(tasks: Tasks, owner: StoreId, opened: u64, take authority: TieredPagerSource, funding: TieredPagerFunding, queue_slots: u64) -> Result[(Sender[TieredPagerMessage], Task[()]), Error] {
    let TieredPagerLink(requests: take requests, worker: take worker, ..) = start_tiered_pager_link(tasks, owner, opened, take authority, funding, queue_slots)?
    Ok((take requests, take worker))
}

fn start_tiered_pager_link(tasks: Tasks, owner: StoreId, opened: u64, take authority: TieredPagerSource, funding: TieredPagerFunding, queue_slots: u64) -> Result[TieredPagerLink, Error] {
    let Some(shared) = int.checked_sub(funding.cache_bytes, funding.writer_pin_bytes) else {
        return Error(Missing("cache_bytes"))
    }
    let cut_room = if funding.cut_pins { CUT_PIN_BYTES } else { 0u64 }
    let Some(cache_and_task) = int.checked_add(funding.cache_bytes, funding.pager_task_bytes) else {
        return Error(Missing("cache_bytes"))
    }
    let Some(task_limit) = int.checked_add(cache_and_task, cut_room) else {
        return Error(Missing("cache_bytes"))
    }
    let (take requests, take incoming) = disk_allocation(scoped fn() -> Result[(Sender[TieredPagerMessage], Receiver[TieredPagerMessage]), Error] {
        Ok(channel.new(queue_slots))
    })?
    let (take writer, take writer_slot) = disk_allocation(scoped fn() -> Result[(Sender[TieredPagerMessage], Receiver[TieredPagerMessage]), Error] {
        Ok(channel.new(1))
    })?
    let (take notify, take notices) = disk_allocation(scoped fn() -> Result[(Sender[()], Receiver[()]), Error] {
        Ok(channel.new(1))
    })?
    let launch = TieredPagerStart(store: owner, opened: opened, authority: take authority, inbox: take incoming, writer: take writer_slot, notices: take notify, shared_bytes: shared)
    // Frame ownership can leave the pager on delivery. Its allocations
    // still draw on this task's reservation, including the writer's
    // share of the cache and the separate room for cuts.
    match task.try_spawn(tasks, bytes task_limit, take launch, run_tiered_pager) {
        Ok(take worker) => Ok(TieredPagerLink(requests: take requests, writer: take writer, notices: take notices, worker: take worker)),
        Error((problem, _)) => Error(Full(Allocation(problem))),
    }
}

fn run_tiered_pager(take launch: TieredPagerStart) waits {
    let TieredPagerStart(store: owner, opened: opened, authority: take authority, inbox: take incoming, writer: take writer, notices: take notify, shared_bytes: shared) = take launch
    let mut input = match take authority {
        PagerDirectory(d) => PagerLocal(d),
        PagerBucket(take requests, op_ms) => PagerObjects(std.object.attach(take requests, None), op_ms),
    }
    let mut private_cache = new_tiered_cache(shared)
    loop {
        // The writer slot is looked at before every blocking receive, so a
        // dropped kick loses no demand (§13.3a).
        if let Ok(take command) = channel.try_receive(writer) {
            tiered_pager_handle(mut input, mut private_cache, owner, opened, take command)
            let _ = channel.try_send(notify, ())
            continue
        }
        match channel.receive(incoming) {
            Ok(take command) => tiered_pager_handle(mut input, mut private_cache, owner, opened, take command),
            Error(_) => break,
        }
    }
}

fn tiered_pager_handle(mut input: TieredPagerInput, mut private_cache: TieredCache, owner: StoreId, opened: u64, take command: TieredPagerMessage) waits {
    match take command {
        PagerRead(demand, answer) => {
            let delivered = tiered_pager_frame(mut input, mut private_cache, owner, demand)
            let _ = channel.send(answer, take delivered)
        },
        PagerPoint(demand, answer) => {
            let delivered = tiered_pager_point(mut input, mut private_cache, owner, demand)
            let _ = channel.try_send(answer, take delivered)
        },
        PagerReserve(amount, answer) => {
            let reserved = tiered_cache_reserve_reader(mut private_cache, TieredReaderGrant(store: owner, opened: opened, pin_bytes: amount))
            let _ = channel.try_send(answer, take reserved)
        },
        PagerIndex(request, answer) => {
            let delivered = read_tiered_index_frame(mut input, owner, request)
            let _ = channel.send(answer, take delivered)
        },
        PagerKick => (),
    }
}

fn pager_reader_grant(requests: Sender[TieredPagerMessage], pin_bytes: u64) -> Result[Arc[TieredReaderGrant], Error] waits {
    check_reader_pin_bytes(pin_bytes)?
    let (answer, granted) = disk_allocation(fn() -> Result[(Sender[Result[Arc[TieredReaderGrant], Error]], Receiver[Result[Arc[TieredReaderGrant], Error]]), Error] {
        Ok(channel.new(1))
    })?
    channel.send(requests, PagerReserve(pin_bytes, take answer)) ?=> |_| Io(Closed)
    channel.receive(granted) ?=> |_| Io(Closed)
}

fn tiered_point_delivery(requests: Sender[TieredPagerMessage], take demand: TieredPointDemand) -> Result[TieredPointDelivery, Error] waits {
    let (answer, delivered) = disk_allocation(fn() -> Result[(Sender[Result[TieredPointDelivery, Error]], Receiver[Result[TieredPointDelivery, Error]]), Error] {
        Ok(channel.new(1))
    })?
    channel.send(requests, PagerPoint(take demand, take answer)) ?=> |_| Io(Closed)
    channel.receive(delivered) ?=> |_| Io(Closed)
}

fn tiered_point_continuation(frame: TieredFrame, key: Bytes, direction: TieredDirection, expected_level: Option[u8]) -> Result[Option[(TieredTarget, u8)], Error] {
    let TieredImage(page) = view frame.payload else {
        return Ok(None)
    }
    let image = std.page.image_of(page)
    let height = std.page.level(image)
    if let Some(expected) = expected_level {
        if height != expected {
            return Error(disk_fault(paged_pack_path(frame.identity.pack)?, frame.identity.offset, Malformed))
        }
    }
    let Some(sought) = std.page.descend(image, key) else {
        return Ok(None)
    }
    let slot = if direction == TieredBackward {
        if list.len(key) == 0 {
            std.page.count(image) - 1
        } else {
            let (_, equal) = std.page.search(image, key)
            if equal { sought - 1 } else { sought }
        }
    } else {
        sought
    }
    let Some(ColdPage(child)) = std.page.child_slot(page, slot) else {
        fail("store: verified PAGE path has no Cold child")
    }
    Ok(Some((TieredPage(child), height - 1)))
}

// One live key path of a demand: the path's index (0 is the target's), the
// edge it reads next and the level that edge must have.
type TieredDescent {
    path: u64,
    edge: TieredTarget,
    level: Option[u8]
}

fn tiered_demand_key(demand: TieredPointDemand, path: u64) -> View[Bytes] in demand {
    if path == 0 { view demand.key } else { view demand.paths[path - 1].key }
}

fn tiered_demand_values(demand: TieredPointDemand, path: u64) -> View[TieredValues] in demand {
    if path == 0 { view demand.values } else { view demand.paths[path - 1].values }
}

// The Cold BLOB holding a leaf row's value, if the value is a Cold BLOB.
fn tiered_cold_value(page: Arc[std.page.Page], slot: u64) -> Option[TieredTarget] {
    let Some(BlobEdge(reference)) = std.page.owning_edge(std.page.image_of(page), slot) else {
        return None
    }
    match std.page.blob_slot(page, reference.body) {
        Some(ColdBlob(ptr)) => Some(TieredBlob(clone(ptr))),
        _ => None,
    }
}

// A delivered leaf: its page when the frame is a level-0 PAGE.
fn tiered_delivered_leaf(frame: TieredFrame) -> Option[View[Arc[std.page.Page]] in frame] {
    let TieredImage(page) = view frame.payload else {
        return None
    }
    if std.page.level(std.page.image_of(page)) != 0 {
        return None
    }
    Some(view page)
}

// Adds a forward scan's later values, rows `from` on of a delivered leaf, to
// `later` while their charges fit in `room`; false once one does not.
fn tiered_later_values(page: Arc[std.page.Page], from: u64, mut room: u64, mut later: List[TieredTarget]) -> Result[bool, Error] {
    for slot in from .. std.page.count(std.page.image_of(page)) {
        let Some(take value) = tiered_cold_value(page, slot) else {
            continue
        }
        let charge = 16 + tiered_frame_id(value).len
        if charge > room {
            return Ok(false)
        }
        room -= charge
        capacity(list.try_reserve(mut later, 1))?
        list.push(mut later, take value)
    }
    Ok(true)
}

// Descends every key path of the demand together, one frame of each path per
// round, so the frames a round needs are read as one batch (one GET window
// per pack on a Bucket) and a frame several paths share is read once. The
// delivery names each path's frames in path order, then the siblings. Its
// failure is the first failed path's, so the attempt that demands that edge
// again is the one that meets the failure.
fn tiered_pager_point(mut input: TieredPagerInput, mut private_cache: TieredCache, owner: StoreId, demand: TieredPointDemand) -> Result[TieredPointDelivery, Error] waits {
    let width = 1 + list.len(demand.paths)
    let mut found: List[List[Arc[TieredFrame]]] = list.new()
    let mut failed: List[Option[(TieredTarget, Error)]] = list.new()
    let mut walking: List[TieredDescent] = list.new()
    capacity(list.try_reserve(mut found, width))?
    capacity(list.try_reserve(mut failed, width))?
    capacity(list.try_reserve(mut walking, width))?
    for path in 0u64 .. width {
        list.push(mut found, list.new())
        list.push(mut failed, None)
        let edge: TieredTarget = if path == 0 { clone(demand.target) } else { clone(demand.paths[path - 1].target) }
        list.push(mut walking, TieredDescent(path: path, edge: take edge, level: None))
    }
    let mut siblings: List[Result[Arc[TieredFrame], Error]] = list.new()
    let mut round = 0u64
    while list.len(walking) != 0 {
        // This round's distinct edges; the first round adds the siblings.
        let mut edges: List[TieredTarget] = list.new()
        let mut slot_of: Map[TieredCacheKey, u64] = map.new()
        let mut slots: List[u64] = list.new()
        capacity(list.try_reserve(mut slots, list.len(walking)))?
        for descent in walking {
            let id = tiered_cache_key(tiered_frame_id(descent.edge))
            let known: Option[u64] = match map.get(slot_of, id) {
                Some(slot) => Some(slot),
                None => None,
            }
            let slot = list.len(edges)
            match known {
                Some(seen) => list.push(mut slots, seen),
                None => {
                    capacity(list.try_reserve(mut edges, 1))?
                    capacity(map.try_reserve(mut slot_of, 1))?
                    list.push(mut edges, clone(descent.edge))
                    map.insert(mut slot_of, id, slot)
                    list.push(mut slots, slot)
                },
            }
        }
        let distinct = list.len(edges)
        if round == 0 {
            capacity(list.try_reserve(mut edges, list.len(demand.siblings)))?
            for sibling in demand.siblings {
                list.push(mut edges, clone(sibling))
            }
        }
        let mut read: List[Result[Arc[TieredFrame], Error]] = list.new()
        capacity(list.try_reserve(mut read, distinct))?
        for take item in tiered_pager_read_edges(mut input, mut private_cache, owner, demand, edges)? {
            if list.len(read) < distinct {
                list.push(mut read, take item)
            } else {
                capacity(list.try_reserve(mut siblings, 1))?
                list.push(mut siblings, take item)
            }
        }
        let mut deeper: List[TieredDescent] = list.new()
        let mut at = 0u64
        for take descent in take walking {
            let TieredDescent(path: path, edge: take edge, level: depth) = take descent
            let slot = slots[at]
            at += 1
            let frame = match view read[slot] {
                Ok(frame) => arc.share(frame),
                Error(problem) => {
                    failed[path] = Some((take edge, clone(problem)))
                    continue
                },
            }
            let following = tiered_point_continuation(frame, tiered_demand_key(demand, path), demand.direction, depth)
            capacity(list.try_reserve(mut found[path], 1))?
            list.push(mut found[path], take frame)
            match take following {
                Ok(Some((take child, height))) => {
                    capacity(list.try_reserve(mut deeper, 1))?
                    list.push(mut deeper, TieredDescent(path: path, edge: take child, level: Some(height)))
                },
                Ok(None) => (),
                Error(take problem) => {
                    failed[path] = Some((take edge, take problem))
                },
            }
        }
        walking = take deeper
        round += 1
    }
    // The values round (§13.3 "Values"). The BLOB a path's read goes on to
    // read joins that path's frames. A forward scan's later values, from its
    // key on in its leaf and then in the sibling leaves, follow the siblings
    // in scan order while they fit in the demand's room. One batch reads both.
    let mut wanted: List[TieredTarget] = list.new()
    let mut wanted_path: List[u64] = list.new()
    let mut later: List[TieredTarget] = list.new()
    let mut room = demand.room
    let mut fitting = true
    for path in 0u64 .. width {
        if let Some(_) = failed[path] {
            continue
        }
        let values = tiered_demand_values(demand, path)
        if let ValuesNone = values {
            continue
        }
        let depth = list.len(found[path])
        if depth == 0 {
            continue
        }
        let Some(page) = tiered_delivered_leaf(found[path][depth - 1]) else {
            continue
        }
        let (slot, hit) = std.page.search(std.page.image_of(page), tiered_demand_key(demand, path))
        let read_now = match values {
            ValuesAt => hit,
            _ => slot < std.page.count(std.page.image_of(page)),
        }
        if read_now {
            if let Some(take value) = tiered_cold_value(page, slot) {
                capacity(list.try_reserve(mut wanted, 1))?
                capacity(list.try_reserve(mut wanted_path, 1))?
                list.push(mut wanted, take value)
                list.push(mut wanted_path, path)
            }
        }
        if let ValuesFrom = values {
            if fitting {
                fitting = tiered_later_values(page, slot + 1, mut room, mut later)?
            }
            for sibling in siblings {
                if !fitting {
                    break
                }
                let Ok(frame) = view sibling else {
                    break
                }
                let Some(leaf) = tiered_delivered_leaf(frame) else {
                    break
                }
                fitting = tiered_later_values(leaf, 0, mut room, mut later)?
            }
        }
    }
    let mut later_read: List[Result[Arc[TieredFrame], Error]] = list.new()
    if list.len(wanted) != 0 || list.len(later) != 0 {
        let lead = list.len(wanted)
        let mut edges: List[TieredTarget] = clone(wanted)
        capacity(list.try_reserve(mut edges, list.len(later)))?
        for value in later {
            list.push(mut edges, clone(value))
        }
        // The later values are a prefetch: a batch they make fail is read
        // again without them.
        let read = match tiered_pager_read_edges(mut input, mut private_cache, owner, demand, edges) {
            Ok(take read) => take read,
            Error(take problem) => {
                if list.len(later) == 0 {
                    return Error(take problem)
                }
                later = list.new()
                tiered_pager_read_edges(mut input, mut private_cache, owner, demand, wanted)?
            },
        }
        let mut at = 0u64
        for take item in take read {
            if at < lead {
                let path = wanted_path[at]
                match take item {
                    Ok(take frame) => {
                        capacity(list.try_reserve(mut found[path], 1))?
                        list.push(mut found[path], take frame)
                    },
                    Error(take problem) => {
                        failed[path] = Some((clone(wanted[at]), take problem))
                    },
                }
            } else {
                capacity(list.try_reserve(mut later_read, 1))?
                list.push(mut later_read, take item)
            }
            at += 1
        }
    }
    let mut frames: List[Arc[TieredFrame]] = list.new()
    let mut failure: Option[(TieredTarget, Error)] = None
    for path in 0u64 .. width {
        capacity(list.try_reserve(mut frames, list.len(found[path])))?
        for frame in found[path] {
            list.push(mut frames, arc.share(frame))
        }
        if let None = failure {
            failure = replace(mut failed[path], None)
        }
    }
    let lead = list.len(frames)
    if let None = failure {
        let mut slot = 0u64
        for take sibling in take siblings {
            match take sibling {
                Ok(take frame) => {
                    capacity(list.try_reserve(mut frames, 1))?
                    list.push(mut frames, take frame)
                },
                Error(take problem) => {
                    failure = Some((clone(demand.siblings[slot]), take problem))
                    break
                },
            }
            slot += 1
        }
    }
    if let None = failure {
        let mut slot = 0u64
        for take value in take later_read {
            match take value {
                Ok(take frame) => {
                    capacity(list.try_reserve(mut frames, 1))?
                    list.push(mut frames, take frame)
                },
                Error(take problem) => {
                    failure = Some((clone(later[slot]), take problem))
                    break
                },
            }
            slot += 1
        }
    }
    // A delivery with more than one path's frames leads with its path frames
    // (`held`); a lone path's frames are installed in order, as they always were.
    let held = if list.len(demand.paths) != 0 || list.len(frames) > lead { lead } else { 0u64 }
    Ok(TieredPointDelivery(frames: take frames, held: held, failure: take failure, grant: clone(demand.grant)))
}

fn tiered_pager_demand_target(demand: TieredPointDemand, edge: TieredTarget) -> Result[TieredPagerTarget, Error] {
    tiered_pager_target(demand.packs, demand.next_stamp, demand.deadline, demand.direction, edge)
}

fn tiered_pager_target(packs: std.omap.OMap[u64, TieredPagerPack], next_stamp: u64, deadline: u64, direction: TieredDirection, edge: TieredTarget) -> Result[TieredPagerTarget, Error] {
    let facts = tiered_frame_id(edge)
    let Some(pack) = std.omap.get(packs, facts.pack) else {
        return Error(disk_fault(paged_pack_path(facts.pack)?, facts.offset, Dangling(facts.stamp)))
    }
    Ok(TieredPagerTarget(edge: clone(edge), direction: direction, inventory: pack.inventory, object: pack.object, next_stamp: next_stamp, deadline: deadline))
}

fn tiered_pager_point_frame(mut input: TieredPagerInput, mut private_cache: TieredCache, owner: StoreId, demand: TieredPointDemand, edge: TieredTarget) -> Result[Arc[TieredFrame], Error] waits {
    let target = tiered_pager_demand_target(demand, edge)?
    tiered_pager_frame(mut input, mut private_cache, owner, target)
}

fn checked_tiered_pager_target(input: TieredPagerInput, demand: TieredPagerTarget) -> Result[(String, TieredFrameId), Error] {
    let expected = tiered_frame_id(demand.edge)
    let path = match input {
        PagerLocal(_) => paged_pack_path(expected.pack)?,
        PagerObjects(_, _) => {
            let file = paged_pack_path(expected.pack)?
            let Some(item) = demand.object else {
                return Error(disk_fault(file, expected.offset, Dangling(expected.stamp)))
            }
            if item.seq != expected.pack || item.len != demand.inventory.payload_bytes {
                return Error(disk_fault(file, expected.offset, Malformed))
            }
            history_key("p-", item)
        },
    }
    let expected_class = if expected.kind == 0x0021 {
        3u8
    } else {
        4u8
    }
    if demand.inventory.class != expected_class || expected.stamp == 0 || expected.stamp >= demand.next_stamp {
        return Error(disk_fault(path, expected.offset, Malformed))
    }
    let Some(maximum) = disk_kind_limit(expected.kind) else {
        fail("store: unknown Tiered frame kind")
    }
    if expected.len > maximum {
        return Error(disk_fault(path, expected.offset, Checksum))
    }
    let data_end = demand.inventory.index
    let width = 16 + expected.len
    if expected.offset < 72 || expected.offset >= data_end {
        return Error(disk_fault(path, expected.offset, Dangling(expected.stamp)))
    }
    if width > data_end - expected.offset {
        return Error(disk_fault(path, expected.offset, Checksum))
    }
    Ok((take path, expected))
}

fn tiered_pager_frame(mut input: TieredPagerInput, mut private_cache: TieredCache, owner: StoreId, demand: TieredPagerTarget) -> Result[Arc[TieredFrame], Error] waits {
    let (take path, expected) = checked_tiered_pager_target(input, demand)?
    if let Some(take found) = tiered_cache_lookup(mut private_cache, path, demand.edge)? {
        return Ok(take found)
    }
    let width = 16 + expected.len
    let (take raw, start) = match input {
        PagerLocal(d) => {
            let mut opened = match host.open(d, path, Read) {
                Ok(take fd) => take fd,
                Error(NotFound) => return Error(disk_fault(path, expected.offset, Dangling(expected.stamp))),
                Error(problem) => return Error(Io(problem)),
            }
            let obtained = read_disk_bytes(mut opened, path, expected.offset, width)
            disk_io(host.close(take opened))?
            (obtained?, expected.offset)
        },
        PagerObjects(mut client, op_ms) => {
            let item = option.unwrap(demand.object)
            let window = tiered_bucket_range(path, demand.edge, item.len, demand.direction)?
            let deadline = if demand.deadline == 0 {
                std.object.deadline_after_ms(client, op_ms)
            } else {
                demand.deadline
            }
            (read_tiered_bucket_window(mut client, item, window, deadline)?, window.lo)
        },
    }
    let page = disk_allocation(scoped fn() -> Result[Arc[TieredFrame], Error] {
        read_tiered_frame(path, owner, demand.edge, raw, start, demand.next_stamp)
    })?
    tiered_cache_admit(mut private_cache, page)
    Ok(take page)
}

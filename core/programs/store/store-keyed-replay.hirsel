fn decode_keyed_edits(file: String, raw: Bytes, mut at: u64) -> Result[List[format.KeyedEdit], Error] {
    let edit_count = failure_result_from_rep(format.disk_count(file, raw, mut at, 7))?
    if edit_count == 0 {
        return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
    }
    let mut edits: List[format.KeyedEdit] = list.new()
    let mut saw_keyed_call = false
    for _ in 0u64 .. edit_count {
        let tree: u8 = int.truncate(failure_result_from_rep(format.disk_number(file, raw, mut at, 1))?)
        let width = match tree {
            0 => 65u64,
            4 => 65u64,
            1 => 387u64,
            6 => 387u64,
            2 => 460u64,
            3 => 526u64,
            5 => 131u64,
            _ => return Error(failure_from_rep(format.disk_fault(file, at - 1, Malformed))),
        }
        let kind = failure_result_from_rep(format.disk_number(file, raw, mut at, 1))?
        let key = failure_result_from_rep(format.disk_blob(file, raw, mut at, width))?
        if list.len(key) == 0 {
            return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
        }
        let value: Option[Bytes] = match kind {
            1 => {
                let maximum = match tree {
                    0 => 16384u64,
                    1 => types.FORMAT_VALUE_MAX,
                    4 => 8u64,
                    5 => 8u64,
                    _ => 0u64,
                }
                Some(failure_result_from_rep(format.disk_blob(file, raw, mut at, maximum))?)
            },
            2 => None,
            3 if tree == format.CLAIMS && !saw_keyed_call => Some(failure_result_from_rep(format.disk_blob(file, raw, mut at, 41 + CLAIM_DONE_MAX))?),
            _ => return Error(failure_from_rep(format.disk_fault(file, at - 1, Malformed))),
        }
        let call: Option[format.KeyedCallSection] = if kind == 3 {
            let Some(reply_bytes) = view value else {
                return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
            }
            let state = claim_parse(reply_bytes) ?=> |_| failure_from_rep(format.disk_fault(file, at, Malformed))
            if !state.replied {
                return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
            }
            let (take record, settlement) = failure_result_from_rep(format.decode_call_fields(file, raw, mut at))?
            if request_digest(record.entry, record.args) != state.digest {
                return Error(failure_from_rep(format.disk_fault(file, at, Malformed)))
            }
            saw_keyed_call = true
            Some(format.KeyedCallSection(record: take record, settlement: settlement))
        } else {
            None
        }
        list.push(mut edits, format.KeyedEdit(tree: tree, key: take key, value: take value, call: take call))
    }
    Ok(take edits)
}

fn keyed_drafted_charge(roots: pages.Roots, edits: List[format.KeyedEdit], tree: u8, key: Bytes) -> u64 {
    let mut edit_index = list.len(edits)
    while edit_index != 0 {
        edit_index -= 1
        let edit = view edits[edit_index]
        if edit.tree == tree && edit.key == key {
            return match edit.value {
                Some(raw) => entry(key, raw),
                None => 0u64,
            }
        }
    }
    match pages.keyed_lookup(roots.keyed, tree, key) {
        Some(raw) => entry(key, raw),
        None => 0u64,
    }
}

fn keyed_draft_live(base: pages.Roots, edits: List[format.KeyedEdit], retained: bool, current: u64) -> u64 {
    let mut total = current
    for slot in 0u64 .. list.len(edits) {
        let edit = view edits[slot]
        if !retained {
            total = int.saturating_sub(total, keyed_drafted_charge(base, list.slice(edits, 0, slot), edit.tree, edit.key))
        }
        if let Some(raw) = edit.value {
            total = int.saturating_add(total, entry(edit.key, raw))
        }
    }
    total
}

// Min-heap over an owned list. Rust BinaryHeap's sift-up/down shape, adapted to
// checked list access and swaps instead of unsafe holes; no stored comparator.
pub opaque type Heap[T: ordered] {
    items: List[T]
}

/// Empty heap without allocation. Ex: `let mut h: std.heap.Heap[u64] = std.heap.new()`
pub fn new[T: ordered]() -> Heap[T] {
    Heap(items: list.new())
}

/// Number of elements. Alloc: nothing. Cost: O(1).
pub fn len[T: ordered](h: Heap[T]) -> u64 {
    list.len(h.items)
}

/// Adds x, maintaining minimum-first order. Error returns x with h unchanged.
/// Alloc: list GROWTH. Cost: O(log len), amortised over growth.
pub fn push[T: ordered](mut h: Heap[T], take x: T) -> Result[(), (Capacity, T)] {
    list.push(mut h.items, take x)?
    let mut i = list.len(h.items) - 1
    while i > 0 {
        let p = (i - 1) / 2
        if !(h.items[i] < h.items[p]) { break }
        list.swap(mut h.items, i, p)
        i = p
    }
    Ok(())
}

/// Minimum view, or None. View: anchored to h; FREEZE h. Cost: O(1).
pub fn peek[T: ordered](h: Heap[T]) -> Option[View[T]] in h {
    list.first(h.items)
}

/// Removes the minimum, or None when empty. Alloc: nothing. Cost: O(log len).
pub fn pop[T: ordered](mut h: Heap[T]) -> Option[T] {
    let n = list.len(h.items)
    if n == 0 { return None }
    let x = list.swap_remove(mut h.items, 0)
    let end = n - 1
    let mut i: u64 = 0
    while i < end / 2 {
        let mut child = i * 2 + 1
        if child + 1 < end && h.items[child + 1] < h.items[child] {
            child += 1
        }
        if !(h.items[child] < h.items[i]) { break }
        list.swap(mut h.items, child, i)
        i = child
    }
    Some(take x)
}

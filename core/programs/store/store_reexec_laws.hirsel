// R5's entry: it replies with row 9 as its base holds it and with its
// CallInfo, and writes the CallInfo. `forced` replaces info(mut tx);
// `extra` adds one more write.
fn info_entry(mut tx: Tx, t: Table[u64, u64], forced: Option[CallInfo], extra: bool) -> Result[Bytes, Bytes] {
    let ci = match forced {
        Some(given) => given,
        None => info(mut tx),
    }
    let before = match result.unwrap(fetch(tx, t, 9)) {
        Some(n) => n,
        None => 0u64,
    }
    result.unwrap(put(mut tx, t, 1, ci.at))
    result.unwrap(put(mut tx, t, 2, ci.seed))
    result.unwrap(put(mut tx, t, 3, ci.id.version))
    if extra {
        result.unwrap(put(mut tx, t, 4, 1))
    }
    let mut output: Bytes = list.new()
    for word in[before, ci.at, ci.seed, ci.id.version] {
        result.unwrap(le(mut output, word, 8))
    }
    Ok(take output)
}

fn set_row(mut db: Db, t: Table[u64, u64], k: u64, v: u64) -> bool waits {
    match result.unwrap(run(mut db, None, (copy_env(k), copy_env(t), copy_env(v)), fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env.1, call_env.0, call_env.2)
    })) {
        Committed(_) => true,
        _ => false,
    }
}

fn verdict_is(got: Verdict, want: Verdict) -> bool {
    verdict_code(got) == verdict_code(want)
}

fn verdict_code(v: Verdict) -> u8 {
    match v {
        Same => 0u8,
        Different(Reply) => 1u8,
        Different(Writes) => 2u8,
        Unknown(StateGone) => 3u8,
        _ => 9u8,
    }
}

fn reexecute_admit(mut db: Db, stream: u64) -> (Completion, CallRecord) waits {
    let key = law_stream_bytes(key_word(stream), keyed_time(db))
    let record = call_for(key, 32)
    let admitted = result.unwrap(admit(mut db, record.stream, 0, request_digest(record.key, record.args)))
    let Admitted(take complete) = take admitted else {
        fail("re-execution law: expected an admitted call")
    }
    result.unwrap(durable(mut db, ticket(complete)))
    (take complete, take record)
}

fn reexecute_error_entry(mut tx: Tx, t: Table[u64, u64]) -> Result[Bytes, Bytes] {
    result.unwrap(put(mut tx, t, 9, 99))
    Error(key_word(17))
}

// §7 Kept: the error reply survives with its CALL, and the staged row does not.
fn reexecute_kept(mut db: Db, t: Table[u64, u64], plan: Plan) -> bool waits {
    let (take complete, take record) = reexecute_admit(mut db, 56)
    let served = serve(mut db, take complete, plan, Some(take record), t, fn(mut tx, call_env) -> Result[Bytes, Bytes] {
        reexecute_error_entry(mut tx, call_env)
    })
    let Ok(Kept(receipt)) = take served else {
        return false
    }
    result.unwrap(durable(mut db, receipt.ticket))
    if result.unwrap(get(result.unwrap(reader(db, 0u64)), snapshot(db), t, 9)) != Some(8u64) {
        return false
    }
    let v = version(snapshot(db))
    let line = main_branch(db)
    let failed = fn(_stop: Stop) -> Bytes {
        key_word(0)
    }
    let kept = result.unwrap(reexecute(db, line, v, plan, failed, t, fn(_call, mut tx, call_env) -> Result[Bytes, Bytes] {
        reexecute_error_entry(mut tx, call_env)
    }))
    let same_without_writes = result.unwrap(reexecute(db, line, v, plan, failed, (), fn(_call, mut tx, unused_env) -> Result[Bytes, Bytes] {
        Ok(key_word(17))
    }))
    let changed = result.unwrap(reexecute(db, line, v, plan, failed, (), fn(_call, mut tx, unused_env) -> Result[Bytes, Bytes] {
        Error(key_word(18))
    }))
    verdict_is(kept, Same) && verdict_is(same_without_writes, Same) && verdict_is(changed, Different(Reply))
}

fn reexecute_fault_bytes(stop: Stop) -> Bytes {
    match stop {
        Raised(kind) => key_word(int.widen(kind)),
        _ => key_word(0),
    }
}

fn reexecute_fault_entry(mut tx: Tx, t: Table[u64, u64]) -> Result[Bytes, Bytes] {
    if result.unwrap(fetch(tx, t, 9)) == Some(8u64) {
        result.unwrap(put(mut tx, t, 10, 1))
        fail("re-execution law: raised from the attempted base")
    }
    Ok(key_word(5))
}

// §7 Failed: two commits intervene between the attempt's base and conclude.
// The re-run must use that base and CallInfo, and must raise the same fault.
fn reexecute_failed(mut db: Db, t: Table[u64, u64], plan: Plan) -> bool waits {
    let (take complete, take record) = reexecute_admit(mut db, 57)
    let served = serve(mut db, take complete, plan, Some(take record), t, fn(mut tx, call_env) -> Result[Bytes, Bytes] {
        reexecute_fault_entry(mut tx, call_env)
    })
    // RUNNER-SPEC §1.1 assigns 5 to Fail.
    let Ok(Failed(take pending_run, Raised(5))) = take served else {
        return false
    }
    let attempted = pending_run.attempted
    if result.unwrap(get(result.unwrap(reader(db, 0u64)), snapshot(db), t, 10)) != None {
        return false
    }
    if !set_row(mut db, t, 9, 10) || !set_row(mut db, t, 9, 11) {
        return false
    }
    let concluded = conclude(mut db, take pending_run, key_word(5), Resident)
    let Ok(Committed(receipt)) = take concluded else {
        return false
    }
    result.unwrap(durable(mut db, receipt.ticket))
    let v = version(snapshot(db))
    let line = main_branch(db)
    let fault = result.unwrap(reexecute(db, line, v, plan, reexecute_fault_bytes, (copy_env(t), copy_env(attempted)), fn(_call, mut tx, call_env) -> Result[Bytes, Bytes] {
        let ci = info(mut tx)
        let same_id = same(ci.id.store, call_env.1 .id.store) && ci.id.branch == call_env.1 .id.branch && ci.id.version == call_env.1 .id.version
        if !same_id || ci.at != call_env.1 .at || ci.seed != call_env.1 .seed {
            return Error(key_word(1))
        }
        reexecute_fault_entry(mut tx, call_env.0)
    }))
    let different_fault = result.unwrap(reexecute(db, line, v, plan, reexecute_fault_bytes, (), fn(_call, mut tx, unused_env) -> Result[Bytes, Bytes] {
        let absent: Option[Bytes] = None
        Ok(option.unwrap(take absent))
    }))
    let returned = result.unwrap(reexecute(db, line, v, plan, reexecute_fault_bytes, (), fn(_call, mut tx, unused_env) -> Result[Bytes, Bytes] {
        Ok(key_word(5))
    }))
    verdict_is(fault, Same) && verdict_is(different_fault, Different(Reply)) && verdict_is(returned, Different(Reply))
}

// R5: an entry whose reply and writes are its info(mut tx) fields, re-executed
// after later commits changed its input row, compares Same live and after a
// journal-replay reopen; under the fork's CallInfo it compares Different(Reply),
// and with one more write Different(Writes). Once a cut covers it, StateGone.
// Oracle: the recorded run's own reply and frame.
pub fn disk_law_reexecute_info(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = disk_test_directory(d)
    let mut db = result.unwrap(open(tasks, dir, c, r, result.unwrap(sized(Directory, 2147483648u64))))
    result.unwrap(law_table(mut db, "info", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "info", std.codec.key_u64(), std.codec.of_u64()))
    if !set_row(mut db, t, 9, 7) {
        return false
    }
    let (take complete, take rec) = reexecute_admit(mut db, 55)
    let plan = Plan(n_e: 65536, s_e: 65536, reply_max: 4096)
    let served = serve(mut db, take complete, plan, Some(take rec), t, fn(mut tx, call_env) -> Result[Bytes, Bytes] {
        info_entry(mut tx, call_env, None, false)
    })
    let Ok(Committed(receipt)) = take served else {
        return false
    }
    result.unwrap(durable(mut db, receipt.ticket))
    let v = version(snapshot(db))
    if !set_row(mut db, t, 9, 8) || !set_row(mut db, t, 1, 0) {
        return false
    }
    let head = snapshot(db)
    let (probe, _) = result.unwrap(fork(mut db, "probe", head))
    let forked = call_info(db.store, probe.id, version(snapshot(db)) + 1, 0, 0)
    let failed = fn(_stop: Stop) -> Bytes {
        key_word(0)
    }
    let line = main_branch(db)
    let honest = result.unwrap(reexecute(db, line, v, plan, failed, t, fn(call, mut tx, call_env) -> Result[Bytes, Bytes] {
        info_entry(mut tx, call_env, None, false)
    }))
    let moved = result.unwrap(reexecute(db, line, v, plan, failed, (copy_env(t), copy_env(forked)), fn(call, mut tx, call_env) -> Result[Bytes, Bytes] {
        info_entry(mut tx, call_env.0, Some(call_env.1), false)
    }))
    let wider = result.unwrap(reexecute(db, line, v, plan, failed, t, fn(call, mut tx, call_env) -> Result[Bytes, Bytes] {
        info_entry(mut tx, call_env, None, true)
    }))
    if !verdict_is(honest, Same) || !verdict_is(moved, Different(Reply)) || !verdict_is(wider, Different(Writes)) {
        return false
    }
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, dir, c, r, result.unwrap(sized(Directory, 2147483648u64))))
    let again = result.unwrap(reexecute(reopened, main_branch(reopened), v, plan, failed, t, fn(call, mut tx, call_env) -> Result[Bytes, Bytes] {
        info_entry(mut tx, call_env, None, false)
    }))
    let _ = result.unwrap(checkpoint(mut reopened))
    let gone = result.unwrap(reexecute(reopened, main_branch(reopened), v, plan, failed, t, fn(call, mut tx, call_env) -> Result[Bytes, Bytes] {
        info_entry(mut tx, call_env, None, false)
    }))
    let replayed = verdict_is(again, Same) && verdict_is(gone, Unknown(StateGone))
    let cases = replayed && reexecute_kept(mut reopened, t, plan) && reexecute_failed(mut reopened, t, plan)
    result.unwrap(close(take reopened))
    cases
}

@test
fn disk_test_reexecute_info(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if disk_law_reexecute_info(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L62(d): all settlements and reruns encode the same reply bytes.
@test
fn test_l62_replay_stop_precedence(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let dir = disk_test_directory(d)
    let mut db = result.unwrap(open(tasks, dir, c, r, result.unwrap(sized(Directory, 2147483648u64))))
    let ample = Plan(n_e: 65536, s_e: 65536, reply_max: 4096)
    let short = Plan(n_e: 65536, s_e: 1, reply_max: 4096)
    let return_reply = fn(mut tx: Tx, env: ()) -> Result[Bytes, Bytes] {
        Ok(key_word(17))
    }
    let replay_reply = fn(call: Recorded, mut tx: Tx, env: ()) -> Result[Bytes, Bytes] {
        Ok(key_word(17))
    }
    let failed = fn(stop: Stop) -> Bytes {
        key_word(17)
    }
    let line = main_branch(db)
    {
        let (take complete, take record) = reexecute_admit(mut db, 71)
        let Ok(Failed(take pending_steps, OutOfSteps(_))) = serve(mut db, take complete, short, Some(take record), (), return_reply) else {
            fail("L62(d): expected a recorded step stop")
        }
        let Committed(steps_receipt) = result.unwrap(conclude(mut db, take pending_steps, key_word(17), Resident)) else {
            fail("L62(d): step stop did not settle")
        }
        result.unwrap(durable(mut db, steps_receipt.ticket))
        let steps_version = version(snapshot(db))
        let Unknown(Residency) = result.unwrap(reexecute(db, line, steps_version, ample, failed, (), replay_reply)) else {
            fail("L62(d): a recorded step stop reran to success")
        }
    }
    {
        let (take complete, take record) = reexecute_admit(mut db, 72)
        let Committed(receipt) = result.unwrap(serve(mut db, take complete, ample, Some(take record), (), return_reply)) else {
            fail("L62(d): expected a recorded success")
        }
        result.unwrap(durable(mut db, receipt.ticket))
        let Unknown(Residency) = result.unwrap(reexecute(db, line, version(snapshot(db)), short, failed, (), replay_reply)) else {
            fail("L62(d): a recorded success reran to a step stop")
        }
    }
    {
        let (take complete, take record) = reexecute_admit(mut db, 73)
        let raised = serve(mut db, take complete, ample, Some(take record), (), fn(mut tx, env) -> Result[Bytes, Bytes] {
            fail("L62(d): body fault")
        })
        let Ok(Failed(take pending_raise, Raised(_))) = take raised else {
            fail("L62(d): expected a recorded raise")
        }
        let Committed(raised_receipt) = result.unwrap(conclude(mut db, take pending_raise, key_word(17), Resident)) else {
            fail("L62(d): raise did not settle")
        }
        result.unwrap(durable(mut db, raised_receipt.ticket))
        let Different(Reply) = result.unwrap(reexecute(db, line, version(snapshot(db)), ample, failed, (), replay_reply)) else {
            fail("L62(d): a raise reran to success with the same reply")
        }
    }
    close(take db)
}

// L91 (E6): a zero-data-write serve still writes its streams-only COMMIT frame
// and CallRecord (including 32-byte code.revision), preserving recorded, R5 Same,
// and Duplicate after reopen.
@test
fn reexecute_zero_data_write_serve(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let dir = disk_test_directory(d)
    let options = result.unwrap(sized(Directory, 2147483648u64))
    let mut db = open(tasks, dir, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if !set_row(mut db, t, 9u64, 42u64) {
        fail("L91 E6: seed write failed")
    }
    let key = law_stream_bytes(key_word(91u64), keyed_time(db))
    let mut record = call_for(clone(key), 32u64)
    let mut rev: Bytes = list.with_capacity(32u64)
    for b in 0u64 .. 32u64 {
        let octet: u8 = int.truncate(b + 100u64)
        list.push(mut rev, octet)
    }
    let expected_rev: Bytes = clone(rev)
    record.revision = Some(take rev)
    let digest = request_digest(record.key, record.args)
    let Admitted(take complete) = admit_law_stream(mut db, key, 0u64, digest)? else {
        fail("L91 E6: admit failed")
    }
    durable(mut db, ticket(complete))?
    let v_before = version(snapshot(db))
    let seq_before = db.frame_seq
    let plan = Plan(n_e: 65536u64, s_e: 65536u64, reply_max: 4096u64)
    let served = result.unwrap(serve(mut db, take complete, plan, Some(take record), copy_env(t), fn(mut tx, rows) -> Result[Bytes, Bytes] {
        let got = match result.unwrap(fetch(tx, rows, 9u64)) {
            Some(n) => n,
            None => 0u64,
        }
        Ok(key_word(got))
    }))
    let Committed(receipt) = take served else {
        fail("L91 E6: zero-data-write serve did not commit")
    }
    durable(mut db, receipt.ticket)?
    let v_after = version(snapshot(db))
    if v_after != v_before + 1 || db.frame_seq != seq_before + 1 || receipt.reply != key_word(42u64) {
        fail("L91 E6: zero-data-write serve was skipped or lost its reply")
    }
    let Some(saved_call) = recorded(db, main_branch(db), v_after)? else {
        fail("L91 E6: recorded lost CallRecord")
    }
    if saved_call.record.revision != Some(expected_rev) {
        fail("L91 E6: recorded lost code.revision")
    }
    let failed = fn(_stop: Stop) -> Bytes {
        key_word(0u64)
    }
    let verdict = reexecute(db, main_branch(db), v_after, plan, failed, copy_env(t), fn(_call, mut tx, rows) -> Result[Bytes, Bytes] {
        let got = match result.unwrap(fetch(tx, rows, 9u64)) {
            Some(n) => n,
            None => 0u64,
        }
        Ok(key_word(got))
    })?
    if !verdict_is(verdict, Same) {
        fail("L91 E6: reexecute did not return Same")
    }
    close(take db)?
    let mut reopened = open(tasks, dir, c, r, options)?
    match admit_law_stream(mut reopened, key, 0u64, digest)? {
        Duplicate(stored) if stored.reply == key_word(42u64) => (),
        _ => fail("L91 E6: retry admit after reopen did not return Duplicate"),
    }
    close(take reopened)
}

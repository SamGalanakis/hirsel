/// One fault per connection, selected before any request octets arrive.
/// Conflict interrupts an If-Match write. DeleteConflict interposes a delete on If-None-Match.
/// IgnoreConditions applies every write as if it carried no If-Match or If-None-Match.
/// CompleteExpired reports an embedded error and ends the upload without publishing it.
pub type Fault: send = Clean | ResetBeforeBody | ResetAfterBody | Stall(u64) | InternalError | SlowDown | CompleteError | CompleteExpired | MalformedComplete | CutResponse(u64) | RequireResume(u64) | Conflict | DeleteConflict | IgnoreConditions

/// Kills the writer's connections at a wire cut. Requests to `address` are
/// numbered from 1. The first `after` are served. Request `after + 1` is
/// applied without a reply when `apply` is true and dropped otherwise, and
/// every later one is dropped. Connections to `spare` are never cut and
/// draw no fault.
pub type Cut: send {
    after: u64,
    apply: bool,
    spare: Addr
}

/// Requests are counted from one for each method and decoded object key.
pub type Hold: send {
    method: String,
    key: String,
    from: u64,
    count: u64,
    until: Until,
    then: Then
}

pub type Until: send = Requested(String, String, u64) | Applied(String, String, u64) | At(u64) | Never

pub type Then: send = Apply | Drop | ApplyLoseReply

/// A decision in application order. Status zero denotes a pre-dispatch reset.
pub type Request: send {
    request: u64,
    method: String,
    key: String,
    status: u16,
    applied: bool,
    at_ns: u64
}

pub type Config: send {
    address: Addr,
    cut: Option[Cut],
    network: sim.net.Network,
    after_resolve: Option[sim.net.Network],
    credential: String,
    signing_key: Secret,
    faults: List[Fault],
    holds: List[Hold],
    exists_status: u16,
    fragment_bytes: u64,
    max_body: u64
}

pub type Object: send {
    data: Bytes,
    etag: String,
    metadata: Map[String, String]
}

pub type Report: send {
    head_writes: List[sim.s3_history.HeadWrite],
    requests: List[Request],
    /// Served Net connect attempts with their virtual timestamps.
    connects: List[(Addr, u64)],
    objects: Map[String, Object],
    // The keys of multipart uploads neither completed nor aborted.
    pending: List[String],
    multipart_uploads: u64,
    writes: u64,
    attempts: u64,
    withdrawn: u64,
    fragment_trace: u64
}

pub opaque type Endpoint: send {
    network: Net
}

/// The request rules both serving modes share.
type Rules: send {
    exists_status: u16,
    max_body: u64
}

/// How a served bucket checks SigV4. `Scoped` takes one fixed credential
/// scope and its day key. `Rooted` derives the day key from the credential
/// root for the date each request names, and proves each answer.
type Signing: send = Scoped(String, Secret) | Rooted(Loopback)

type Gate: send {
    rules: Rules,
    cut: Option[Cut],
    signing: Signing
}

/// A bucket that other processes reach over real loopback sockets (STORE
/// §12.2). It holds the credential root, checks each request's SigV4 for the
/// date the request names, and answers each authenticated request with a
/// proof that only a holder of that root can compute. Its clients are path
/// style, so every target starts with `/<bucket>`.
pub type Loopback: send {
    bucket: String,
    access_key: String,
    aws_region: String,
    root: Secret,
    exists_status: u16,
    max_body: u64
}

/// The response field that carries a loopback simulator's proof.
pub const PROOF_FIELD: String = "x-hirsel-sim-proof"

const PROOF_DOMAIN: String = "hirsel.sim.s3.proof"

const PROOF_CONTEXT: String = "hirsel.sim.s3.v1\n"

/// The key that proves answers for requests signed with `root`. Sealed for
/// MAC use only; it reveals nothing about the signing keys.
pub fn proof_key(root: Secret) -> Result[Secret, SecretError] {
    secret.derive_hmac_sha256(root, string.as_bytes(PROOF_DOMAIN), string.as_bytes(""), "mac")
}

/// The message a proof authenticates: the context and the request's exact
/// Authorization value.
pub fn proof_message(authorization: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(string.byte_len(PROOF_CONTEXT) + list.len(authorization))
    list.append(mut out, string.as_bytes(PROOF_CONTEXT))
    list.append(mut out, authorization)
    take out
}

fn rooted(service: Loopback, req: sim.s3_wire.WireRequest, raw_target: String, body: Bytes) -> Option[String] {
    let Some(date) = map.get(req.fields, "x-amz-date") else {
        return None
    }
    let Some(auth) = map.get(req.fields, "authorization") else {
        return None
    }
    if string.byte_len(date) != 16 {
        return None
    }
    let day = string.slice(date, 0, 8)
    let Ok(take key) = sigv4.scope_signing_key(service.root, string.from(day), clone(service.aws_region), "s3") else {
        return None
    }
    let mut scope = string.from(service.access_key)
    string.push_char(mut scope, '/')
    string.push(mut scope, day)
    string.push_char(mut scope, '/')
    string.push(mut scope, service.aws_region)
    string.push(mut scope, "/s3/aws4_request")
    if !sim.s3_wire.authenticated(scope, key, req, raw_target, body) {
        return None
    }
    let Ok(take prover) = proof_key(service.root) else {
        return None
    }
    let Ok(tag) = secret.hmac_sha256(prover, proof_message(string.as_bytes(auth))) else {
        return None
    }
    Some(sim.s3_wire.hex(tag))
}

type Service: send {
    tasks: Tasks,
    network: Net,
    config: Config,
    plan: sim.world.Plan,
    clock: Clock,
    port: Served[NetOp]
}

fn endpoint_service(take service: Service) -> Report waits {
    let Service(tasks, network, config: take config, plan: take initial, clock, port: take port) = take service
    let mut plan = take initial
    serve(tasks, network, config, mut plan, clock, take port)
}

/// Starts the simulator with exclusive ownership of its provider port.
pub fn start_service(tasks: Tasks, take config: Config, take plan: sim.world.Plan, clock: Clock, queue_bytes: u64, service_bytes: u64) -> (Endpoint, Task[Report]) {
    let (network, take port) = provide.net(bytes queue_bytes)
    let service = Service(tasks, network, config: take config, plan: take plan, clock, port: take port)
    let running = task.spawn(tasks, bytes service_bytes, take service, endpoint_service)
    (Endpoint(network), take running)
}

pub fn endpoint_network(endpoint: Endpoint) -> Net {
    endpoint.network
}

const REQUESTED_PATH: String = "sim-s3-requested"

const CLOCK_PATH: String = "sim-s3-clock"

/// Waits until the service receives the nth request for this method and key.
pub fn requested(e: Endpoint, method: String, key: String, nth: u64) -> Result[(), NetError] waits {
    let mut name = text_number(nth)
    string.push(mut name, "\n")
    string.push(mut name, method)
    string.push(mut name, "\n")
    string.push(mut name, key)
    match host.connect_unix(e.network, name, REQUESTED_PATH, Never) {
        Error(Refused) => Ok(()),
        Error(problem) => Error(problem),
        Ok(_) => Error(Denied),
    }
}

type Upload {
    key: String,
    metadata: Map[String, String],
    parts: Map[u64, Object]
}

type Bucket {
    head_writes: List[sim.s3_history.HeadWrite],
    requests: List[Request],
    objects: Map[String, Object],
    uploads: Map[String, Upload],
    next_upload: u64,
    writes: u64,
    served: u64,
    fragment_trace: u64
}

type Response {
    status: u16,
    fields: Map[String, String],
    body: Bytes
}

fn reply(status: u16, body: String) -> Response {
    Response(status: status, fields: map.new(), body: string.into_bytes(clone(body)))
}

fn error(status: u16, code: String) -> Response {
    let mut xml = string.from("<Error><Code>")
    string.push(mut xml, code)
    string.push(mut xml, "</Code></Error>")
    reply(status, xml)
}

fn conditional_failure(rules: Rules, req: sim.s3_wire.WireRequest, mut objects: Map[String, Object], fault: Fault, writing: bool) -> Option[Response] {
    match (fault, writing) {
        (Conflict, true) if map.contains(req.fields, "if-match") => return Some(error(409, "ConditionalRequestConflict")),
        (DeleteConflict, true) if map.contains(req.fields, "if-none-match") && map.contains(objects, req.target.key) => {
            let _ = map.remove(mut objects, req.target.key)
            return Some(error(409, "ConditionalRequestConflict"))
        },
        (IgnoreConditions, true) => return None,
        _ => (),
    }
    let old = map.get(objects, req.target.key)
    if let Some(tag) = map.get(req.fields, "if-match") {
        match old {
            Some(present) if tag == "*" || tag == present.etag => (),
            _ => return Some(error(412, "PreconditionFailed")),
        }
    }
    if let (Some(tag), Some(present)) = (map.get(req.fields, "if-none-match"), old) {
        if tag == "*" || tag == present.etag {
            return Some(error(if req.method == "GET" || req.method == "HEAD" {
                304u16
            } else {
                rules.exists_status
            }, "PreconditionFailed"))
        }
    }
    None
}

fn text_number(n: u64) -> String {
    let mut out = string.from("")
    string.push_u64(mut out, n)
    take out
}

fn list_objects(objects: Map[String, Object], query: Map[String, String]) -> Response {
    let mut prefix = string.from("")
    if let Some(raw) = map.get(query, "prefix") {
        let Some(take value) = sim.s3_wire.decode(raw) else {
            return error(400, "InvalidArgument")
        }
        prefix = take value
    }
    let mut after = string.from("")
    let start = if map.get(query, "continuation-token") != None {
        map.get(query, "continuation-token")
    } else {
        map.get(query, "start-after")
    }
    if let Some(raw) = start {
        let Some(take value) = sim.s3_wire.decode(raw) else {
            return error(400, "InvalidArgument")
        }
        after = take value
    }
    let limit = if let Some(raw) = map.get(query, "max-keys") {
        let Some(n) = sim.s3_wire.u64_field(raw) else {
            return error(400, "InvalidArgument")
        }
        order.min(n, 1000u64)
    } else {
        1000
    }
    let mut xml = string.from("<ListBucketResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">")
    sim.s3_wire.element(mut xml, "Prefix", prefix)
    sim.s3_wire.element(mut xml, "MaxKeys", text_number(limit))
    let mut count = 0u64
    let mut truncated = false
    let mut last = string.from("")
    for key in sim.s3_wire.sorted_keys(objects) {
        if string.starts_with(key, prefix) && order.compare(key, after) == Greater {
            if count == limit {
                truncated = limit != 0
                break
            }
            let object = option.unwrap(map.get(objects, key))
            string.push(mut xml, "<Contents>")
            sim.s3_wire.element(mut xml, "Key", key)
            sim.s3_wire.element(mut xml, "ETag", object.etag)
            sim.s3_wire.element(mut xml, "Size", text_number(list.len(object.data)))
            string.push(mut xml, "</Contents>")
            last = clone(key)
            count += 1
        }
    }
    sim.s3_wire.element(mut xml, "KeyCount", text_number(count))
    sim.s3_wire.element(mut xml, "IsTruncated", if truncated {
        "true"
    } else {
        "false"
    })
    if truncated {
        sim.s3_wire.element(mut xml, "NextContinuationToken", last)
    }
    string.push(mut xml, "</ListBucketResult>")
    reply(200, xml)
}

fn list_uploads(uploads: Map[String, Upload], query: Map[String, String]) -> Response {
    let mut prefix = string.from("")
    if let Some(raw) = map.get(query, "prefix") {
        let Some(take value) = sim.s3_wire.decode(raw) else {
            return error(400, "InvalidArgument")
        }
        prefix = take value
    }
    let limit = if let Some(raw) = map.get(query, "max-uploads") {
        let Some(n) = sim.s3_wire.u64_field(raw) else {
            return error(400, "InvalidArgument")
        }
        order.min(n, 1000u64)
    } else {
        1000
    }
    let marker = match map.get(query, "key-marker") {
        Some(raw) => {
            let Some(take decoded) = sim.s3_wire.decode(raw) else {
                return error(400, "InvalidArgument")
            }
            take decoded
        },
        None => string.new(),
    }
    let upload_marker = match map.get(query, "upload-id-marker") {
        Some(raw) => {
            let Some(take decoded) = sim.s3_wire.decode(raw) else {
                return error(400, "InvalidArgument")
            }
            take decoded
        },
        None => string.new(),
    }
    let mut all = sim.s3_wire.sorted_keys(uploads)
    list.sort(mut all, scoped fn(a: String, b: String) -> Order {
        let first = option.unwrap(map.get(uploads, a))
        let second = option.unwrap(map.get(uploads, b))
        let by_key = order.compare(first.key, second.key)
        if by_key == Equal {
            order.compare(a, b)
        } else {
            by_key
        }
    })
    let mut xml = string.from("<ListMultipartUploadsResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">")
    sim.s3_wire.element(mut xml, "Prefix", prefix)
    let mut body = string.from("")
    let mut count = 0u64
    let mut truncated = false
    let mut last_key = string.new()
    let mut last_id = string.new()
    for id in all {
        let upload = option.unwrap(map.get(uploads, id))
        let by_key = order.compare(upload.key, marker)
        let beyond = by_key == Greater || (by_key == Equal && order.compare(id, upload_marker) == Greater)
        if string.starts_with(upload.key, prefix) && beyond {
            if count == limit {
                truncated = true
                break
            }
            string.push(mut body, "<Upload>")
            sim.s3_wire.element(mut body, "Key", upload.key)
            sim.s3_wire.element(mut body, "UploadId", id)
            string.push(mut body, "</Upload>")
            last_key = clone(upload.key)
            last_id = clone(id)
            count += 1
        }
    }
    sim.s3_wire.element(mut xml, "IsTruncated", if truncated {
        "true"
    } else {
        "false"
    })
    if truncated {
        sim.s3_wire.element(mut xml, "NextKeyMarker", last_key)
        sim.s3_wire.element(mut xml, "NextUploadIdMarker", last_id)
    }
    string.push(mut xml, body)
    string.push(mut xml, "</ListMultipartUploadsResult>")
    reply(200, xml)
}

fn put(mut bucket: Bucket, req: sim.s3_wire.WireRequest, request: u64, take data: Bytes, take meta: Map[String, String]) -> String {
    let tag = sim.s3_wire.etag(data)
    let key = view req.target.key
    sim.s3_history.record(mut bucket.head_writes, request, key, req.fields, tag, data)
    map.insert(mut bucket.objects, string.from(key), Object(data: take data, etag: clone(tag), metadata: take meta))
    bucket.writes += 1
    take tag
}

fn begin(mut bucket: Bucket, req: sim.s3_wire.WireRequest) -> Response {
    let id = text_number(bucket.next_upload)
    bucket.next_upload += 1
    map.insert(mut bucket.uploads, clone(id), Upload(key: clone(req.target.key), metadata: sim.s3_wire.metadata(req.fields), parts: map.new()))
    let mut xml = string.from("<InitiateMultipartUploadResult>")
    sim.s3_wire.element(mut xml, "Key", req.target.key)
    sim.s3_wire.element(mut xml, "UploadId", id)
    string.push(mut xml, "</InitiateMultipartUploadResult>")
    reply(200, xml)
}

fn put_part(mut upload: Upload, n: u64, take body: Bytes) -> Response {
    let tag = sim.s3_wire.etag(body)
    map.insert(mut upload.parts, n, Object(data: take body, etag: clone(tag), metadata: map.new()))
    let mut response = reply(200, "")
    map.insert(mut response.fields, string.from("ETag"), take tag)
    take response
}

fn consume(s: String, mut at: u64, wanted: String) -> bool {
    while at < string.byte_len(s) && list.contains(string.as_bytes(" \t\r\n"), string.as_bytes(s)[at]) {
        at += 1
    }
    if string.find(s, at, wanted) != Some(at) {
        return false
    }
    at += string.byte_len(wanted)
    true
}

fn tag_value(s: String, mut at: u64, open: String, close: String) -> Option[View[String]] in s {
    if !consume(s, mut at, open) {
        return None
    }
    let end = string.find(s, at, close)?
    let value = string.slice(s, at, end)
    at = end + string.byte_len(close)
    Some(value)
}

fn gather(upload: Upload, raw: Bytes, max_body: u64) -> Result[Bytes, String] {
    let Ok(take s) = string.from_utf8(clone(raw)) else {
        return Error(string.from("MalformedXML"))
    }
    let mut at = 0u64
    if !consume(s, mut at, "<CompleteMultipartUpload>") {
        return Error(string.from("MalformedXML"))
    }
    let mut previous = 0u64
    let mut data: Bytes = list.new()
    while consume(s, mut at, "<Part>") {
        let Some(number) = tag_value(s, mut at, "<PartNumber>", "</PartNumber>") else {
            return Error(string.from("MalformedXML"))
        }
        let Some(n) = sim.s3_wire.u64_field(number) else {
            return Error(string.from("InvalidPart"))
        }
        let Some(expected) = tag_value(s, mut at, "<ETag>", "</ETag>") else {
            return Error(string.from("MalformedXML"))
        }
        if !consume(s, mut at, "</Part>") {
            return Error(string.from("MalformedXML"))
        }
        if n <= previous {
            return Error(string.from("InvalidPartOrder"))
        }
        let Some(saved) = map.get(upload.parts, n) else {
            return Error(string.from("InvalidPart"))
        }
        if expected != saved.etag {
            return Error(string.from("InvalidPart"))
        }
        if list.len(saved.data) > max_body - list.len(data) {
            return Error(string.from("EntityTooLarge"))
        }
        list.append(mut data, saved.data)
        previous = n
    }
    if previous == 0 || !consume(s, mut at, "</CompleteMultipartUpload>") || at != string.byte_len(s) {
        return Error(string.from("MalformedXML"))
    }
    Ok(take data)
}

fn multipart(rules: Rules, mut bucket: Bucket, req: sim.s3_wire.WireRequest, request: u64, id: String, take body: Bytes, fault: Fault) -> Response {
    let Some(take upload) = map.remove(mut bucket.uploads, id) else {
        return error(404, "NoSuchUpload")
    }
    let mut current = take upload
    let response = if current.key != req.target.key {
        error(404, "NoSuchUpload")
    } else if req.method == "DELETE" {
        return reply(204, "")
    } else if req.method == "PUT" {
        let n = match map.get(req.target.query, "partNumber") {
            Some(number) => sim.s3_wire.or_else(sim.s3_wire.u64_field(number), 0),
            None => 0
        }
        if n == 0 || n > 10000 {
            error(400, "InvalidArgument")
        } else {
            put_part(mut current, n, take body)
        }
    } else if req.method == "POST" {
        if let CompleteExpired = fault {
            return error(200, "InternalError")
        } else if let CompleteError = fault {
            error(200, "InternalError")
        } else if let MalformedComplete = fault {
            reply(200, "<Error/>")
        } else if let Some(take failed) = conditional_failure(rules, req, mut bucket.objects, fault, true) {
            take failed
        } else {
            match gather(current, body, rules.max_body) {
                Error(code) => error(400, code),
                Ok(take data) => {
                    let Upload(metadata: take meta, ..) = take current
                    let tag = put(mut bucket, req, request, take data, take meta)
                    let mut xml = string.from("<CompleteMultipartUploadResult>")
                    sim.s3_wire.element(mut xml, "Key", req.target.key)
                    sim.s3_wire.element(mut xml, "ETag", tag)
                    string.push(mut xml, "</CompleteMultipartUploadResult>")
                    return reply(200, xml)
                }
            }
        }
    } else {
        error(405, "MethodNotAllowed")
    }
    map.insert(mut bucket.uploads, clone(id), take current)
    take response
}

fn ranged(object: Object, value: String) -> Response {
    if !string.starts_with(value, "bytes=") {
        return error(416, "InvalidRange")
    }
    let range = string.slice(value, 6, string.byte_len(value))
    let Some((raw_lo, raw_hi)) = string.split_once(range, "-") else {
        return error(416, "InvalidRange")
    }
    let size = list.len(object.data)
    // A suffix, bytes=-n, is the last n bytes (RFC 9110 §14.1.2).
    let suffix = if raw_lo == "" {
        sim.s3_wire.u64_field(raw_hi)
    } else {
        None
    }
    let lo = match suffix {
        Some(n) if n != 0 && size != 0 => size - order.min(n, size),
        Some(_) => return error(416, "InvalidRange"),
        None => match sim.s3_wire.u64_field(raw_lo) {
            Some(first) => first,
            None => return error(416, "InvalidRange"),
        },
    }
    if lo >= size {
        return error(416, "InvalidRange")
    }
    let last = if raw_hi == "" || suffix != None {
        size - 1
    } else {
        let Some(parsed) = sim.s3_wire.u64_field(raw_hi) else {
            return error(416, "InvalidRange")
        }
        order.min(parsed, size - 1)
    }
    if last < lo {
        return error(416, "InvalidRange")
    }
    let mut content = string.from("bytes ")
    string.push_u64(mut content, lo)
    string.push_char(mut content, '-')
    string.push_u64(mut content, last)
    string.push_char(mut content, '/')
    string.push_u64(mut content, size)
    let data: Bytes = clone(list.slice(object.data, lo, last + 1))
    let mut response = Response(status: 206, fields: clone(object.metadata), body: take data)
    map.insert(mut response.fields, string.from("Content-Range"), take content)
    map.insert(mut response.fields, string.from("ETag"), clone(object.etag))
    take response
}

fn dispatch(rules: Rules, mut bucket: Bucket, req: sim.s3_wire.WireRequest, take body: Bytes, fault: Fault, request: u64) -> Response {
    match fault {
        InternalError => return error(500, "InternalError"),
        SlowDown => return error(503, "SlowDown"),
        _ => ()
    }
    if let Some(id) = map.get(req.target.query, "uploadId") {
        return multipart(rules, mut bucket, req, request, id, take body, fault)
    }
    if req.method == "POST" && map.get(req.target.query, "uploads") != None {
        return begin(mut bucket, req)
    }
    if req.method == "GET" && req.target.key == "" {
        if map.contains(req.target.query, "location") {
            return reply(200, "<LocationConstraint xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">global</LocationConstraint>")
        }
        if map.get(req.target.query, "uploads") != None {
            return list_uploads(bucket.uploads, req.target.query)
        }
        if let Some(v) = map.get(req.target.query, "list-type") {
            if v == "2" {
                return list_objects(bucket.objects, req.target.query)
            }
        }
    }
    if req.target.key == "" {
        return error(400, "InvalidArgument")
    }
    if let Some(take failed) = conditional_failure(rules, req, mut bucket.objects, fault, req.method == "PUT") {
        return take failed
    }
    if req.method == "PUT" {
        let tag = put(mut bucket, req, request, take body, sim.s3_wire.metadata(req.fields))
        let mut out = reply(200, "")
        map.insert(mut out.fields, string.from("ETag"), take tag)
        return take out
    }
    if req.method == "DELETE" {
        let _ = map.remove(mut bucket.objects, req.target.key)
        return reply(204, "")
    }
    if req.method == "HEAD" || req.method == "GET" {
        let Some(object) = map.get(bucket.objects, req.target.key) else {
            return error(404, "NoSuchKey")
        }
        if req.method == "GET" {
            let byte_range = map.get(req.fields, "range")
            if let RequireResume(expected) = fault {
                let mut range = string.from("bytes=")
                string.push_u64(mut range, expected)
                string.push_char(mut range, '-')
                let expected_tag = map.get(req.fields, "if-match")
                if let (Some(value), Some(tag)) = (byte_range, expected_tag) {
                    if value != range || tag != object.etag {
                        return error(400, "InvalidResume")
                    }
                } else {
                    return error(400, "InvalidResume")
                }
            }
            if let Some(value) = byte_range {
                return ranged(object, value)
            }
        }
        let mut out = Response(status: 200, fields: clone(object.metadata), body: clone(object.data))
        map.insert(mut out.fields, string.from("ETag"), clone(object.etag))
        return take out
    }
    error(405, "MethodNotAllowed")
}

type ReadState = Reading | Body(u64) | Parked | Sending | ResetPeer

type RequestKey: key {
    method: String,
    key: String
}

type Progress {
    received: u64,
    applied: List[u64]
}

type Incoming {
    target: RequestKey,
    req: sim.s3_wire.WireRequest,
    body: Bytes,
    proof: Option[String],
    rejection: Option[Response]
}

type Pending {
    peer: u64,
    nth: u64,
    spare: bool,
    fault: Fault,
    incoming: Incoming,
    until: Until,
    then: Then
}

type Watch {
    target: RequestKey,
    nth: u64,
    call: Call[NetOp]
}

type Schedule {
    counts: Map[RequestKey, Progress],
    pending: List[Pending],
    watches: List[Watch],
    timers: Map[u64, Task[()]]
}

type Peer {
    request: u64,
    fault: Fault,
    plan: sim.world.Plan,
    state: ReadState,
    head: http1.Head,
    cursor: http1.Cursor,
    incoming: Bytes,
    outgoing: Bytes,
    waiting: Option[(NetOp, Call[NetOp])],
    sent: u64,
    read_closed: bool,
    write_closed: bool,
    spare: bool
}

fn new_peer(request: u64, fault: Fault, take plan: sim.world.Plan, spare: bool) -> Peer {
    Peer(request, fault: fault, plan: take plan, state: Reading, head: http1.head(), cursor: http1.cursor(), incoming: list.new(), outgoing: list.new(), waiting: None, sent: 0, read_closed: false, write_closed: false, spare: spare)
}

fn respond(mut peer: Peer, response: Response, head: bool) {
    let mut line = string.from("HTTP/1.1 ")
    string.push_u64(mut line, int.widen(response.status))
    string.push(mut line, " \r\nConnection: close\r\nContent-Length: ")
    string.push_u64(mut line, if response.status == 304 || (head && response.status != 200) {
        0
    } else {
        list.len(response.body)
    })
    string.push(mut line, "\r\n")
    for name in sim.s3_wire.sorted_keys(response.fields) {
        string.push(mut line, name)
        string.push(mut line, ": ")
        if let Some(value) = map.get(response.fields, name) {
            string.push(mut line, value)
        }
        string.push(mut line, "\r\n")
    }
    string.push(mut line, "\r\n")
    let mut wire = string.into_bytes(take line)
    if !head && response.status != 304 {
        if let CutResponse(n) = peer.fault {
            list.append(mut wire, list.slice(response.body, 0, order.min(n, list.len(response.body))))
        } else {
            list.append(mut wire, response.body)
        }
    }
    peer.outgoing = take wire
    peer.state = Sending
    list.clear(mut peer.incoming)
}

// A path-style target without its `/<bucket>` segment, as the virtual-hosted
// target the dispatcher routes.
fn path_target(raw: String, name: String) -> Option[String] {
    let octets = string.as_bytes(raw)
    let n = string.byte_len(name) + 1
    if list.len(octets) <= n || octets[0] != b'/' || string.slice(raw, 1, n) != name {
        return None
    }
    let rest = string.slice(raw, n, list.len(octets))
    if octets[n] == b'/' {
        return Some(string.from(rest))
    }
    if octets[n] != b'?' {
        return None
    }
    let mut target = string.from("/")
    string.push(mut target, rest)
    Some(take target)
}

fn request_key(method: String, target: sim.s3_wire.Target) -> RequestKey {
    let listing = method == "GET" && target.key == "" && (map.contains(target.query, "list-type") || map.contains(target.query, "uploads"))
    RequestKey(method: if listing {
        string.from("LIST")
    } else {
        string.from(method)
    }, key: clone(target.key))
}

fn routed_target(gate: Gate, raw: String) -> Option[String] {
    match gate.signing {
        Scoped(_, _) => Some(string.from(raw)),
        Rooted(service) => path_target(raw, service.bucket),
    }
}

fn received(gate: Gate, mut bucket: Bucket, mut peer: Peer, clock: Clock) -> Option[Incoming] {
    if let Reading = peer.state {
        match http1.resume(peer.incoming, mut peer.head, mut peer.cursor) {
            Partial => return None,
            Complete => (),
            _ => {
                respond(mut peer, error(400, "MalformedRequest"), false)
                return None
            }
        }
        if let ResetBeforeBody = peer.fault {
            let raw = sim.s3_wire.piece(peer.incoming, peer.head.target.start, peer.head.target.end)
            if let Some(path) = routed_target(gate, raw) {
                if let Some(uri) = sim.s3_wire.parse_target(path) {
                    let method = sim.s3_wire.piece(peer.incoming, peer.head.method.start, peer.head.method.end)
                    let target = request_key(method, uri)
                    record(mut bucket, peer.request, target, 0, false, clock)
                }
            }
            peer.state = ResetPeer
            return None
        }
        let Some(take fields) = sim.s3_wire.parse_headers(peer.incoming, peer.head) else {
            respond(mut peer, error(400, "MalformedRequest"), false)
            return None
        }
        let Some(size) = sim.s3_wire.body_length(fields) else {
            respond(mut peer, error(400, "InvalidRequest"), false)
            return None
        }
        if size > gate.rules.max_body {
            respond(mut peer, error(413, "EntityTooLarge"), false)
            return None
        }
        peer.state = Body(size)
    }
    let Body(size) = peer.state else {
        return None
    }
    if list.len(peer.incoming) - peer.head.end < size {
        return None
    }
    let method = sim.s3_wire.piece(peer.incoming, peer.head.method.start, peer.head.method.end)
    let head = method == "HEAD"
    if list.len(peer.incoming) - peer.head.end != size {
        respond(mut peer, error(400, "InvalidRequest"), head)
        return None
    }
    let raw_target = sim.s3_wire.piece(peer.incoming, peer.head.target.start, peer.head.target.end)
    let Some(take path) = routed_target(gate, raw_target) else {
        respond(mut peer, error(404, "NoSuchBucket"), head)
        return None
    }
    let Some(take uri) = sim.s3_wire.parse_target(path) else {
        respond(mut peer, error(400, "InvalidURI"), head)
        return None
    }
    let target = request_key(method, uri)
    let fields = option.unwrap(sim.s3_wire.parse_headers(peer.incoming, peer.head))
    let body: Bytes = clone(list.slice(peer.incoming, peer.head.end, list.len(peer.incoming)))
    let req = sim.s3_wire.WireRequest(method: take method, target: take uri, fields: take fields)
    let (proof, accepted): (Option[String], bool) = match gate.signing {
        Scoped(credential_scope, key) => (None, sim.s3_wire.authenticated(credential_scope, key, req, raw_target, body)),
        Rooted(service) => match rooted(service, req, raw_target, body) {
            Some(take text) => (Some(take text), true),
            None => (None, false),
        },
    }
    let rejection: Option[Response] = if accepted {
        None
    } else {
        Some(error(403, "SignatureDoesNotMatch"))
    }
    peer.state = Parked
    list.clear(mut peer.incoming)
    Some(Incoming(target: take target, req: take req, body: take body, proof: take proof, rejection: take rejection))
}

fn record(mut bucket: Bucket, request: u64, target: RequestKey, status: u16, applied: bool, clock: Clock) {
    list.push(mut bucket.requests, Request(request, method: clone(target.method), key: clone(target.key), status, applied, at_ns: host.mono_ns(clock)))
}

type Decision {
    response: Option[Response],
    reset: bool,
    applied: bool,
    head: bool
}

fn decide(gate: Gate, mut bucket: Bucket, take input: Incoming, fault: Fault, request: u64, spare: bool, clock: Clock, lose_reply: bool) -> Decision {
    let Incoming(target: take target, req: take req, body: take body, proof: take proof, rejection: take rejection) = take input
    let head = req.method == "HEAD"
    if let Some(take response) = take rejection {
        record(mut bucket, request, target, response.status, false, clock)
        return Decision(response: Some(take response), reset: lose_reply, applied: false, head)
    }
    let mut reset = lose_reply
    if let ResetAfterBody = fault {
        reset = true
    }
    if let Some(cut) = gate.cut {
        if !spare {
            bucket.served += 1
            if bucket.served > cut.after {
                if !cut.apply || bucket.served - cut.after > 1 {
                    record(mut bucket, request, target, 0, false, clock)
                    return Decision(response: None, reset: true, applied: false, head)
                }
                reset = true
            }
        }
    }
    let mut response = dispatch(gate.rules, mut bucket, req, take body, fault, request)
    if let Some(take text) = take proof {
        map.insert(mut response.fields, string.from(PROOF_FIELD), take text)
    }
    let status = response.status
    let embedded_error = req.method == "POST" && map.contains(req.target.query, "uploadId") && bytes_prefix(response.body, string.as_bytes("<Error"))
    let applied = status >= 200 && status < 300 && !embedded_error
    record(mut bucket, request, target, status, applied, clock)
    Decision(response: Some(take response), reset, applied, head)
}

fn bytes_prefix(value: Bytes, prefix: Bytes) -> bool {
    let n = list.len(prefix)
    list.len(value) >= n && list.slice(value, 0, n) == prefix
}

fn complete(mut peer: Peer, decision: Decision) {
    if decision.reset {
        peer.state = ResetPeer
    } else if let Some(response) = view decision.response {
        respond(mut peer, response, decision.head)
    }
}

fn answer(mut served: Served[NetOp], take call: Call[NetOp], response: NetReply) -> bool {
    if let Ok(()) = provide.reply(mut served, take call, provide.net_reply(response)) {
        return true
    }
    false
}

fn matches_closed(state: ReadState) -> bool {
    match state {
        Sending => true,
        ResetPeer => true,
        _ => false
    }
}

fn send(config: Config, mut peer: Peer, prefix: u64, tail: u64, mut served: Served[NetOp], take call: Call[NetOp]) {
    if matches_closed(peer.state) {
        let _ = answer(mut served, take call, Failed(Reset))
        return
    }
    if prefix + tail == 0 {
        let _ = answer(mut served, take call, Count(0))
        return
    }
    let mut data: Bytes = list.with_capacity(prefix + tail)
    let prefix_omitted = provide.payload_prefix(call, 1, config.fragment_bytes, mut data)
    let tail_omitted = provide.payload_prefix(call, 2, config.fragment_bytes, mut data)
    if list.len(data) + prefix_omitted + tail_omitted != prefix + tail {
        let _ = answer(mut served, take call, Failed(Aborted))
        return
    }
    let limit = order.min(config.fragment_bytes, list.len(data))
    let count = 1 + sim.world.pick(mut peer.plan, limit)
    if answer(mut served, take call, Count(count)) {
        list.append(mut peer.incoming, list.slice(data, 0, count))
    }
}

fn recv(config: Config, mut peer: Peer, clock: Clock, room: u64, mut trace: u64, mut served: Served[NetOp], take call: Call[NetOp]) -> bool waits {
    let mut c = take call
    match peer.state {
        Sending => (),
        _ => return answer(mut served, take c, Failed(Reset))
    }
    if let Stall(until) = peer.fault {
        if host.mono_ns(clock) < until {
            host.sleep_until(clock, until)
        }
    }
    if let CutResponse(_) = peer.fault {
        if peer.sent == list.len(peer.outgoing) {
            return answer(mut served, take c, Failed(Reset))
        }
    }
    let limit = order.min(config.fragment_bytes, order.min(room, list.len(peer.outgoing) - peer.sent))
    let count: u64 = match limit {
        0 => 0,
        _ => 1 + sim.world.pick(mut peer.plan, limit)
    }
    let staged = provide.fill(mut served, mut c, list.slice(peer.outgoing, peer.sent, peer.sent + count))
    let accepted = answer(mut served, take c, Count(staged))
    if accepted {
        peer.sent += staged
        trace = int.wrapping_mul(trace ^ staged, 0x100000001b3)
    }
    accepted
}

fn operate(config: Config, mut bucket: Bucket, mut peer: Peer, clock: Clock, op: NetOp, mut served: Served[NetOp], take call: Call[NetOp]) -> bool waits {
    if is_parked(peer.state) && is_read(op) {
        peer.waiting = Some((op, take call))
        return true
    }
    match op {
        Send(prefix: prefix, tail: tail, ..) => {
            send(config, mut peer, prefix, tail, mut served, take call)
            true
        },
        Recv(room: room, max: max, ..) => recv(config, mut peer, clock, order.min(room, max), mut bucket.fragment_trace, mut served, take call),
        Ready(..) => {
            if let ResetPeer = peer.state {
                return answer(mut served, take call, Failed(Reset))
            }
            if let Stall(until) = peer.fault {
                if host.mono_ns(clock) < until {
                    host.sleep_until(clock, until)
                }
            }
            answer(mut served, take call, Done)
        },
        Released(part: part, ..) => {
            match part {
                Whole => {
                    peer.read_closed = true
                    peer.write_closed = true
                },
                Read => {
                    peer.read_closed = true
                },
                Write => {
                    peer.write_closed = true
                }
            }
            true
        },
        _ => answer(mut served, take call, Failed(Denied))
    }
}

fn is_read(op: NetOp) -> bool {
    match op {
        Recv(..) => true,
        Ready(..) => true,
        _ => false,
    }
}

fn is_parked(state: ReadState) -> bool {
    match state {
        Parked => true,
        _ => false
    }
}

fn name_operation(op: NetOp) -> bool {
    match op {
        Resolve(..) => true,
        Handshake(..) => true,
        _ => false
    }
}

fn socket(op: NetOp) -> Option[u64] {
    match op {
        Send(socket: id, ..) => Some(id),
        Recv(socket: id, ..) => Some(id),
        Ready(socket: id) => Some(id),
        Released(id: id, ..) => Some(id),
        _ => None
    }
}

fn note_request(mut counts: Map[RequestKey, Progress], target: RequestKey) -> u64 {
    map.update_or_insert(mut counts, clone(target), Progress(received: 0, applied: list.new()), fn(mut progress: Progress) -> u64 {
        progress.received += 1
        progress.received
    })
}

fn ready_at(until: Until, counts: Map[RequestKey, Progress], clock: Clock) -> bool {
    match until {
        Never => false,
        At(at) => host.mono_ns(clock) >= at,
        Requested(method, key, n) => seen(counts, method, key, n, false),
        Applied(method, key, n) => seen(counts, method, key, n, true),
    }
}

fn seen(counts: Map[RequestKey, Progress], method: String, key: String, n: u64, applied: bool) -> bool {
    let target = RequestKey(method: string.from(method), key: string.from(key))
    reached(counts, target, n, applied)
}

fn reached(counts: Map[RequestKey, Progress], target: RequestKey, n: u64, applied: bool) -> bool {
    if let Some(progress) = map.get(counts, target) {
        return if applied {
            list.contains(progress.applied, n)
        } else {
            progress.received >= n
        }
    }
    false
}

type Timer: send {
    network: Net,
    clock: Clock,
    at: u64
}

fn wake_at(take t: Timer) waits {
    host.sleep_until(t.clock, t.at)
    let _ = host.connect_unix(t.network, "clock", CLOCK_PATH, Never)
}

fn enqueue(holds: List[Hold], mut schedule: Schedule, peer: Peer, take input: Incoming, tasks: Tasks, network: Net, clock: Clock) {
    let n = note_request(mut schedule.counts, input.target)
    let mut until: Until = At(0)
    let mut then: Then = Apply
    for hold in holds {
        if hold.method == input.target.method && hold.key == input.target.key && n >= hold.from && n - hold.from < hold.count {
            until = clone(hold.until)
            then = hold.then
            break
        }
    }
    if let At(at) = until {
        if at > host.mono_ns(clock) && !map.contains(schedule.timers, at) {
            let timer = task.spawn(tasks, bytes 0, Timer(network, clock, at), wake_at)
            map.insert(mut schedule.timers, at, take timer)
        }
    }
    list.push(mut schedule.pending, Pending(peer: peer.request, nth: n, spare: peer.spare, fault: peer.fault, incoming: take input, until: take until, then))
}

fn read_control(c: Call[NetOp], field: u64, size: u64) -> Option[String] {
    let mut raw: Bytes = list.with_capacity(size)
    provide.payload(c, field, mut raw)
    match string.from_utf8(take raw) {
        Ok(take text) => Some(take text),
        Error(_) => None,
    }
}

fn watch(call: Call[NetOp], size: u64) -> Option[(RequestKey, u64)] {
    let text = read_control(call, 0, size)?
    let (number, rest) = string.split_once(text, "\n")?
    let (method, key) = string.split_once(rest, "\n")?
    let nth = sim.s3_wire.u64_field(number)?
    Some((RequestKey(method: string.from(method), key: string.from(key)), nth))
}

fn control(mut schedule: Schedule, mut port: Served[NetOp], take call: Call[NetOp], root: u64, path: u64) {
    match read_control(call, 1, path) {
        Some(value) if value == CLOCK_PATH => {
            let _ = answer(mut port, take call, Failed(Refused))
        },
        Some(value) if value == REQUESTED_PATH => {
            if let Some((take target, nth)) = watch(call, root) {
                list.push(mut schedule.watches, Watch(target: take target, nth, call: take call))
            } else {
                let _ = answer(mut port, take call, Failed(Denied))
            }
        },
        _ => {
            let _ = answer(mut port, take call, Failed(Denied))
        },
    }
}

fn notify(mut schedule: Schedule, mut port: Served[NetOp]) {
    let mut i = 0u64
    while i < list.len(schedule.watches) {
        let done = {
            let w = schedule.watches[i]
            reached(schedule.counts, w.target, w.nth, false)
        }
        if done {
            let saved: Watch = list.remove(mut schedule.watches, i)
            let Watch(call: take call, ..) = take saved
            let _ = answer(mut port, take call, Failed(Refused))
        } else {
            i += 1
        }
    }
}

fn ready_pending(s: Schedule, clock: Clock) -> Option[u64] {
    for i in 0u64 .. list.len(s.pending) {
        if ready_at(s.pending[i].until, s.counts, clock) {
            return Some(i)
        }
    }
    None
}

fn flush(config: Config, gate: Gate, mut schedule: Schedule, mut bucket: Bucket, mut peers: Map[u64, Peer], mut port: Served[NetOp], clock: Clock, mut withdrawn: u64) waits {
    while let Some(i) = ready_pending(schedule, clock) {
        let saved: Pending = list.remove(mut schedule.pending, i)
        let Pending(peer: id, nth, fault, spare, incoming: take input, then, ..) = take saved
        let decision = match then {
            Drop => Decision(response: None, reset: true, applied: false, head: false),
            _ => {
                let target = RequestKey(method: clone(input.target.method), key: clone(input.target.key))
                let lose = match then {
                    ApplyLoseReply => true,
                    _ => false
                }
                let resolved = decide(gate, mut bucket, take input, fault, id, spare, clock, lose)
                if resolved.applied {
                    let _ = map.update(mut schedule.counts, target, scoped fn(mut progress: Progress) {
                        list.push(mut progress.applied, nth)
                    })
                }
                take resolved
            },
        }
        if let Some(take socket_peer) = map.remove(mut peers, id) {
            let mut peer = take socket_peer
            complete(mut peer, decision)
            if let Some((op, take call)) = replace(mut peer.waiting, None) {
                if !operate(config, mut bucket, mut peer, clock, op, mut port, take call) {
                    withdrawn += 1
                }
            }
            map.insert(mut peers, id, take peer)
        }
    }
}

/// Runs a single bucket over a served Net. A clock controller drives stalls.
pub fn serve(tasks: Tasks, network: Net, n: Config, mut plan: sim.world.Plan, clock: Clock, take served: Served[NetOp]) -> Report waits {
    if n.fragment_bytes == 0 || (n.exists_status != 412 && n.exists_status != 304) {
        fail("sim.s3 needs a positive fragment size and a 412 or 304 dialect")
    }
    let mut port = take served
    let gate = Gate(rules: Rules(exists_status: n.exists_status, max_body: n.max_body), cut: clone(n.cut), signing: Scoped(clone(n.credential), secret.share(n.signing_key)))
    let mut bucket = new_bucket()
    let mut peers: Map[u64, Peer] = map.new()
    let mut connects: List[(Addr, u64)] = list.new()
    let mut next = 1u64
    let mut schedule = Schedule(counts: map.new(), pending: list.new(), watches: list.new(), timers: map.new())
    let mut dns_changed = false
    let mut withdrawn = 0u64
    while let Some(take call) = provide.next(mut port) {
        let op = provide.net_op(call)
        match op {
            ConnectUnix(root, path) => control(mut schedule, mut port, take call, root, path),
            Connect(addr: addr, ..) => {
                list.push(mut connects, (addr, host.mono_ns(clock)))
                let spare = match n.cut {
                    Some(cut) => addr == cut.spare,
                    None => false,
                }
                if !spare && addr != n.address {
                    let refusal: NetError = match (addr.ip, n.address.ip) {
                        (V4(_), V6(_, _)) => Unreachable,
                        (V6(_, _), V4(_)) => Unreachable,
                        _ => Refused,
                    }
                    let _ = answer(mut port, take call, Failed(refusal))
                } else if answer(mut port, take call, Socket(next, addr)) {
                    let fault = if spare || list.len(n.faults) == 0 {
                        Clean
                    } else {
                        n.faults[sim.world.pick(mut plan, list.len(n.faults))]
                    }
                    let stream = sim.world.plan(sim.world.pick(mut plan, 0xffffffffffffffff))
                    map.insert(mut peers, next, new_peer(next, fault, take stream, spare))
                    next += 1
                }
            },
            _ if name_operation(op) => {
                if dns_changed {
                    match n.after_resolve {
                        Some(model) => sim.net.answer_name(model, mut port, take call),
                        None => sim.net.answer_name(n.network, mut port, take call)
                    }
                } else {
                    sim.net.answer_name(n.network, mut port, take call)
                }
                if let Resolve(..) = op {
                    dns_changed = true
                }
            },
            _ => {
                if let Some(id) = socket(op) {
                    if let Some(take found) = map.remove(mut peers, id) {
                        let mut entry = take found
                        if !operate(n, mut bucket, mut entry, clock, op, mut port, take call) {
                            withdrawn += 1
                        }
                        if let Send(..) = op {
                            let before = list.len(bucket.requests)
                            if let Some(take input) = received(gate, mut bucket, mut entry, clock) {
                                enqueue(n.holds, mut schedule, entry, take input, tasks, network, clock)
                            } else if list.len(bucket.requests) != before {
                                let done = bucket.requests[before]
                                let target = RequestKey(method: clone(done.method), key: clone(done.key))
                                let _ = note_request(mut schedule.counts, target)
                            }
                        }
                        if !entry.read_closed || !entry.write_closed {
                            map.insert(mut peers, id, take entry)
                        }
                    } else {
                        let _ = answer(mut port, take call, Failed(Reset))
                    }
                } else {
                    let _ = answer(mut port, take call, Failed(Denied))
                }
            }
        }
        notify(mut schedule, mut port)
        flush(n, gate, mut schedule, mut bucket, mut peers, mut port, clock, mut withdrawn)
    }
    report(take bucket, next - 1, withdrawn, take connects)
}

fn new_bucket() -> Bucket {
    Bucket(head_writes: list.new(), requests: list.new(), objects: map.new(), uploads: map.new(), next_upload: 1, writes: 0, served: 0, fragment_trace: 0xcbf29ce484222325)
}

fn report(take bucket: Bucket, attempts: u64, withdrawn: u64, take connects: List[(Addr, u64)]) -> Report {
    let Bucket(head_writes: take head_writes, requests: take requests, objects: take objects, uploads: take uploads, next_upload, writes, fragment_trace, ..) = take bucket
    let mut pending: List[String] = list.with_capacity(map.len(uploads))
    for id in sim.s3_wire.sorted_keys(uploads) {
        list.push(mut pending, clone(option.unwrap(map.get(uploads, id)).key))
    }
    Report(head_writes: take head_writes, requests: take requests, connects: take connects, objects: take objects, pending: take pending, multipart_uploads: next_upload - 1, writes: writes, attempts: attempts, withdrawn: withdrawn, fragment_trace)
}

const LOOPBACK_IO_NS: u64 = 30000000000

fn serve_connection(request: u64, gate: Gate, mut bucket: Bucket, take conn: Socket, clock: Clock) waits {
    let (take input, take output) = net.split(take conn)
    let mut reader = take input
    let mut writer = take output
    let mut peer = new_peer(request, Clean, sim.world.plan(0), false)
    let until: core.Until = At(clock, int.saturating_add(host.mono_ns(clock), LOOPBACK_IO_NS))
    let limit = int.saturating_add(gate.rules.max_body, 65536u64)
    while !matches_closed(peer.state) {
        if list.len(peer.incoming) >= limit {
            return
        }
        let room = order.min(65536u64, limit - list.len(peer.incoming))
        // A receive appends into spare capacity only.
        list.reserve(mut peer.incoming, room)
        match host.recv_bounded(mut reader, mut peer.incoming, room, until) {
            Ok(0) => return,
            Ok(_) => {
                if let Some(take prepared) = received(gate, mut bucket, mut peer, clock) {
                    let decision = decide(gate, mut bucket, take prepared, peer.fault, peer.request, false, clock, false)
                    complete(mut peer, decision)
                }
            },
            Error(_) => return,
        }
    }
    if let ResetPeer = peer.state {
        return
    }
    let empty: Bytes = list.new()
    while peer.sent < list.len(peer.outgoing) {
        match host.send_pair(mut writer, list.slice(peer.outgoing, peer.sent, list.len(peer.outgoing)), empty, until) {
            Ok(0) => return,
            Ok(n) => {
                peer.sent += n
            },
            Error(_) => return,
        }
    }
}

/// Serves one bucket to other processes over a loopback listener until the
/// listener fails. Each connection carries one request; the answer closes it.
/// Every answer to an authenticated request carries `PROOF_FIELD`.
pub fn serve_loopback(mut listener: Listener, take service: Loopback, clock: Clock) -> Report waits {
    if service.exists_status != 412 && service.exists_status != 304 {
        fail("sim.s3 needs a 412 or 304 dialect")
    }
    let gate = Gate(rules: Rules(exists_status: service.exists_status, max_body: service.max_body), cut: None, signing: Rooted(take service))
    let mut bucket = new_bucket()
    let mut accepted = 0u64
    while let Ok((take conn, _)) = host.accept(mut listener, Never) {
        accepted += 1
        serve_connection(accepted, gate, mut bucket, take conn, clock)
    }
    report(take bucket, accepted, 0, list.new())
}

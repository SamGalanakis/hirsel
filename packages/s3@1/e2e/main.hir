pub type E2EError = Object(s3.S3Error) | Grant(GrantError) | Clock(ClockError) | Output(
  OutputError
) | Mismatch

// One conditional create, read back and deleted against the granted bucket.
pub fn main(io: Io, env: Env) -> Result[(), E2EError] {
  let out = io.stdout(io)?
  let clock = io.wall_clock(io)?
  let mut c = s3.from_grants(io, env, "data")?
  let start = clock.wall(clock)?
  s3.put(mut c, "e2e/key", b"value", Create())?
  let finished = clock.wall(clock)?
  let elapsed = finished - start
  let message = string.concat(
    string.concat("one conditional create: ", i64.to_string(elapsed)),
    " ns\n"
  )
  out.print(out, message)?
  if s3.get(mut c, "e2e/key")? != b"value" {
    return Error(Mismatch())
  }
  match s3.put(mut c, "e2e/key", b"other", Create()) {
    Error(Exists()) => {},
    _ => return Error(Mismatch()),
  }
  s3.delete(mut c, "e2e/key")?
  Ok(())
}

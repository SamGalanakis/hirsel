// OWN-4: each forbidden category is named at its field; representation at the bound.
resource type Resource: codec { n: u64 }
@compact(u32) type Stable: codec { n: u64 }
scoped type Scoped: codec { n: u64 }
resource type R { n: u64 }
@compact(u32) type S { n: u64 }
type HasResource: codec { payload: R }
type HasStable[in r]: codec { payload: S in r }
type HasScoped: codec { payload: View[u64] }
type HasCounted: codec { payload: Rc[u64] }
type HasArc: codec { payload: Arc[u64] }
type HasCallable: codec { payload: fn() -> u64 }
type HasOwnCallable: codec { payload: own fn() -> u64 }
type HasScopedCallable: codec { payload: scoped fn() -> u64 }
type HasCapability: codec { payload: Stdout }
type HasBox: codec { payload: Box[u64] }
type HasArray: codec { payload: Inline[u64, 2] }
type FloatKey: key { payload: f64 }
type FloatOrdered: ordered { payload: f32 }
type Plain { n: u64 }
fn require[T: codec](x: T) -> u64 { 1 }
fn plain_missing(x: Plain) -> u64 { require(x) }
fn conditional_missing(x: Wrapper[HostFile]) -> u64 { require(x) }
type Wrapper[T]: codec { x: T }


// Search form A (OPTIMAL-STORE-ENDSTATE §III.3, Store 2.2): BM25 over a
// store table. The postings are a Many entry index on the table and the
// corpus and term statistics are one aggregate on it, both written in the
// row's own transaction and built by the store's builder. A query is a
// plain function of a store.Tx, so entry and query bodies can call it.
/// One part of a row's analysis. `Corpus` puts the row in the corpus with
/// its token count; `Posting` is one distinct term with its frequency in
/// the row and the row's token count.
pub type Term: shareable + send = Corpus | Posting(String, u64, u64)

/// A row's analysis: one `(Corpus, length)` part, then one
/// `(Posting(term, tf, length), 1)` part per distinct term.
pub type Terms = List[(Term, u64)]

pub opaque type Text[K, V]: shareable + send {
    postings: store.Index[(Term, u64), K, V, ()],
    stats: store.Aggregate[Term],
    primary: std.codec.Key[K],
    stop_words: List[String]
}

pub opaque type Bm25 {
    k1: f64,
    b: f64
}

pub type Hit[K] {
    key: K,
    score: f64
}

const CORPUS_TAG: u8 = 0u8

const POSTING_TAG: u8 = 1u8

const MAX: u64 = 18446744073709551615u64

/// The analysis of `text` under `analyzer`, in the form `declare`'s
/// extractor returns. Terms are in first-appearance order.
pub fn analyze(analyzer: Tokenizer, text: String) -> Terms {
    let tokens = tokenize(analyzer, text)
    let length = list.len(tokens)
    let mut order: List[String] = list.new()
    let mut counts: Map[String, u64] = map.new()
    for take token in take tokens {
        if !map.contains(counts, token) {
            list.push(mut order, clone(token))
        }
        map.update_or_insert(mut counts, take token, 0u64, scoped fn(mut tf: u64) {
            tf += 1
        })
    }
    let mut parts: Terms = list.with_capacity(list.len(order) + 1)
    list.push(mut parts, (Corpus, length))
    for take term in take order {
        let tf = option.unwrap(map.get(counts, term))
        list.push(mut parts, (Posting(take term, tf, length), 1u64))
    }
    take parts
}

// A posting entry's key: tag 1, the term, its frequency and the row's
// length, so one term's entries are one contiguous range. A corpus part
// is the one-byte key 0, which no term range reaches. The part's count is
// not encoded: a posting's is always 1.
fn encode_posting(part: (Term, u64), mut out: Bytes) {
    match part.0 {
        Corpus => std.codec.put_key_u8(CORPUS_TAG, mut out),
        Posting(term, tf, length) => {
            std.codec.put_key_u8(POSTING_TAG, mut out)
            std.codec.put_key_string(term, mut out)
            std.codec.put_key_u64(tf, mut out)
            std.codec.put_key_u64(length, mut out)
        },
    }
}

fn decode_posting(raw: Bytes, mut at: u64) -> Result[(Term, u64), std.codec.DecodeError] {
    let start = at
    match std.codec.take_key_u8(raw, mut at)? {
        0u8 => Ok((Corpus, 1u64)),
        1u8 => {
            let term = std.codec.take_key_string(raw, mut at)?
            let tf = std.codec.take_key_u64(raw, mut at)?
            let length = std.codec.take_key_u64(raw, mut at)?
            Ok((Posting(take term, tf, length), 1u64))
        },
        _ => Error(Invalid(start)),
    }
}

fn posting_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 4)?
    std.codec.schema_u8(mut s)
    std.codec.schema_string(mut s)
    std.codec.schema_u64(mut s)
    std.codec.schema_u64(mut s)
    Ok(())
}

fn posting_key() -> std.codec.Key[(Term, u64)] {
    std.codec.key_make(code.describe(encode_posting), code.describe(decode_posting), code.describe(posting_schema))
}

// A statistics group's key: tag 0 for the corpus, tag 1 and the term for
// a term. The corpus group's totals are the row count and the token sum;
// a term group's count is its document frequency.
fn encode_group(t: Term, mut out: Bytes) {
    match t {
        Corpus => std.codec.put_key_u8(CORPUS_TAG, mut out),
        Posting(term, _, _) => {
            std.codec.put_key_u8(POSTING_TAG, mut out)
            std.codec.put_key_string(term, mut out)
        },
    }
}

fn decode_group(raw: Bytes, mut at: u64) -> Result[Term, std.codec.DecodeError] {
    let start = at
    match std.codec.take_key_u8(raw, mut at)? {
        0u8 => Ok(Corpus),
        1u8 => Ok(Posting(std.codec.take_key_string(raw, mut at)?, 0, 0)),
        _ => Error(Invalid(start)),
    }
}

fn group_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 2)?
    std.codec.schema_u8(mut s)
    std.codec.schema_string(mut s)
    Ok(())
}

fn group_key() -> std.codec.Key[Term] {
    std.codec.key_make(code.describe(encode_group), code.describe(decode_group), code.describe(group_schema))
}

fn stats_name(name: String) -> String {
    let mut full = string.from(name)
    string.push(mut full, ".stats")
    take full
}

/// Declares search on `t`: a Many index `name` of its postings and an
/// aggregate `name.stats` of its corpus and term statistics. `terms` gives
/// a row's analysis, normally `Ok(search.analyze(analyzer, text))`. Its
/// analyzer must use `stop_words`, which `query` applies to query text.
pub fn declare[K, V](mut d: store.Declare, mut t: store.TableDecl[K, V], name: String, take stop_words: List[String], terms: StaticFn[fn(K, V) -> Result[Terms, Capacity]]) -> Result[Text[K, V], store.Error] {
    let postings = store.index(mut d, mut t, name, Many, terms, posting_key())?
    let stats = store.aggregate(mut d, mut t, stats_name(name), terms, group_key())?
    let primary = store.primary_key(postings)
    Ok(Text(postings: take postings, stats: take stats, primary: primary, stop_words: take stop_words))
}

/// The store's handle on the postings index.
pub fn posting_index[K, V](s: Text[K, V]) -> store.Index[(Term, u64), K, V, ()] {
    clone(s.postings)
}

/// The store's handle on the statistics aggregate.
pub fn statistics[K, V](s: Text[K, V]) -> store.Aggregate[Term] {
    clone(s.stats)
}

/// Rebuilds both records from the table's first row; queries answer
/// NotReady until `store.index_build_step` finishes them.
pub fn rebuild[K, V](mut db: store.Db, s: Text[K, V]) -> Result[(), store.Error] waits {
    store.rebuild_index(mut db, s.postings)?
    store.rebuild_aggregate(mut db, s.stats)
}

pub fn defaults() -> Bm25 {
    Bm25(k1: 1.2, b: 0.75)
}

pub fn bm25(k1: f64, b: f64) -> Option[Bm25] {
    if std.float.is_finite(k1) && float.ge(k1, 0.0) && float.ge(b, 0.0) && float.le(b, 1.0) {
        Some(Bm25(k1: k1, b: b))
    } else {
        None
    }
}

// Reduce ln(1 + x) to e*ln(2) + 2*atanh(z), with z <= 1/3.
// The omitted tail after 18 terms is less than 2e-19.
fn log_one_plus(x: f64) -> f64 {
    let (exponent, z) = if float.le(x, 1.0) {
        (0u64, x / (2.0 + x))
    } else {
        let bits = float.to_bits64(1.0 + x)
        let exponent = (bits >> 52) - 1023
        let mantissa = float.from_bits64((bits & 0x000fffffffffffff) | 0x3ff0000000000000)
        (exponent, (mantissa - 1.0) / (mantissa + 1.0))
    }
    let ratio = z * z
    let mut sum = z
    let mut power = z
    for i in 1u64 .. 18 {
        power *= ratio
        let denominator: f64 = float.from_int(2 * i + 1)
        sum += power / denominator
    }
    let e: f64 = float.from_int(exponent)
    e * 0.6931471805599453 + 2.0 * sum
}

fn inverse_frequency(documents: u64, df: u64) -> f64 {
    let found: f64 = float.from_int(df)
    let absent: f64 = float.from_int(documents - df)
    log_one_plus((absent + 0.5) / (found + 0.5))
}

fn contribution(params: Bm25, norm: f64, weight: f64, tf: u64) -> f64 {
    let frequency: f64 = float.from_int(tf)
    let scale = params.k1 + 1.0
    weight * (frequency / (frequency / scale + (params.k1 / scale) * norm))
}

// Rank a small corpus without materializing an index. A hit's key is its input position.
pub fn rank(texts: List[String], text: String) -> List[Hit[u64]] {
    let analyzer = tokenizer(list.new())
    let mut slots: Map[String, u64] = map.new()
    for take term in tokenize(analyzer, text) {
        if !map.contains(slots, term) {
            let slot = map.len(slots)
            map.insert(mut slots, take term, slot)
        }
    }
    let terms = map.len(slots)
    let mut hits: List[Hit[u64]] = list.new()
    if terms == 0u64 || list.len(texts) == 0u64 {
        return take hits
    }
    let mut docs: List[(u64, List[u64])] = list.new()
    let mut frequencies: List[u64] = list.new()
    list.fill(mut frequencies, terms, 0u64)
    let mut total = 0u64
    for body in texts {
        let tokens = tokenize(analyzer, body)
        let length = list.len(tokens)
        let mut counts: List[u64] = list.new()
        list.fill(mut counts, terms, 0u64)
        for token in tokens {
            if let Some(slot) = map.get(slots, token) {
                if counts[slot] == 0u64 {
                    frequencies[slot] += 1u64
                }
                counts[slot] += 1u64
            }
        }
        list.push(mut docs, (length, take counts))
        total += length
    }
    if total == 0u64 {
        return take hits
    }
    let params = defaults()
    let n: f64 = float.from_int(list.len(docs))
    let sum: f64 = float.from_int(total)
    let mean = sum / n
    let mut weights: List[f64] = list.with_capacity(terms)
    for df in frequencies {
        list.push(mut weights, inverse_frequency(list.len(docs), df))
    }
    for id in 0u64 .. list.len(docs) {
        let (length, counts) = view docs[id]
        let size: f64 = float.from_int(length)
        let norm = 1.0 - params.b + params.b * (size / mean)
        let mut score: f64 = 0.0
        for slot in 0u64 .. terms {
            if counts[slot] != 0u64 {
                score += contribution(params, norm, weights[slot], counts[slot])
            }
        }
        if float.gt(score, 0.0f64) {
            list.push(mut hits, Hit(key: id, score: score))
        }
    }
    std.list.sort(mut hits, position_order)
    take hits
}

type Candidate = Rejected | Eligible(f64, f64)

// Ranked first is the greater score, then the smaller key bytes.
fn ranked[K](left: (Bytes, Hit[K]), right: (Bytes, Hit[K])) -> Order {
    if float.gt(left.1 .score, right.1 .score) {
        Less
    } else if float.lt(left.1 .score, right.1 .score) {
        Greater
    } else {
        list.compare_bytes(left.0, right.0)
    }
}

fn position_order(left: Hit[u64], right: Hit[u64]) -> Order {
    if float.gt(left.score, right.score) || (float.eq(left.score, right.score) && left.key < right.key) {
        Less
    } else if float.lt(left.score, right.score) || left.key > right.key {
        Greater
    } else {
        Equal
    }
}

// The root of this heap is the worst retained hit.
fn keep_hit[K](mut hits: List[(Bytes, Hit[K])], k: u64, take hit: (Bytes, Hit[K])) {
    let n = list.len(hits)
    if n < k {
        list.push(mut hits, take hit)
        let mut child = n
        while child != 0 {
            let parent = (child - 1) / 2
            if ranked(hits[child], hits[parent]) != Greater {
                break
            }
            list.swap(mut hits, child, parent)
            child = parent
        }
    } else if ranked(hit, hits[0]) == Less {
        let _ = list.set(mut hits, 0, take hit)
        let mut parent: u64 = 0
        while parent < n / 2 {
            let mut child = 2 * parent + 1
            if child + 1 < n && ranked(hits[child + 1], hits[child]) == Greater {
                child += 1
            }
            if ranked(hits[child], hits[parent]) != Greater {
                break
            }
            list.swap(mut hits, parent, child)
            parent = child
        }
    }
}

/// The `k` best rows for `text` among the rows `tx` sees, best first, by
/// BM25 with whole-corpus statistics. `allows` is asked once per candidate
/// row and only allowed rows rank. Equal scores rank in increasing primary
/// key order, the table's key codec order. A build in progress answers
/// `NotReady` with the name of the record still building.
pub fn query[K, V](tx: store.Tx, s: Text[K, V], text: String, k: u64, params: Bm25, allows: scoped fn(K) -> bool) -> Result[List[Hit[K]], store.Error] {
    let corpus = store.totals(tx, s.stats, Corpus)?
    let mut hits: List[Hit[K]] = list.new()
    if k == 0 || corpus.sum == 0 {
        return Ok(take hits)
    }
    let n: f64 = float.from_int(corpus.count)
    let tokens: f64 = float.from_int(corpus.sum)
    let mean = tokens / n
    let mut seen: std.set.Set[String] = std.set.new()
    let mut candidates: Map[Bytes, Candidate] = map.new()
    let mut keys: Map[Bytes, K] = map.new()
    for take term in tokenize(tokenizer(clone(s.stop_words)), text) {
        if !std.set.insert(mut seen, clone(term)) {
            continue
        }
        let df = store.totals(tx, s.stats, Posting(clone(term), 0, 0))?.count
        if df == 0 {
            continue
        }
        let weight = inverse_frequency(corpus.count, df)
        let low = (Posting(clone(term), 0, 0), 1u64)
        let high = (Posting(take term, MAX, MAX), 1u64)
        let mut rows = store.entries(tx, s.postings, Included(take low), Included(take high))?
        while let Some((part, take key, _)) = store.next_entry(mut rows)? {
            let (tf, length) = match part.0 {
                Posting(_, tf, length) => (tf, length),
                Corpus => continue,
            }
            let mut encoded: Bytes = list.new()
            std.codec.encode_key(s.primary, key, mut encoded)
            if !map.contains(candidates, encoded) {
                let candidate = if allows(key) {
                    let size: f64 = float.from_int(length)
                    map.insert(mut keys, clone(encoded), take key)
                    Eligible(1.0 - params.b + params.b * (size / mean), 0.0)
                } else {
                    Rejected
                }
                map.insert(mut candidates, clone(encoded), take candidate)
            }
            let _ = map.update(mut candidates, encoded, scoped fn(mut candidate: Candidate) {
                if let Eligible(norm, score) = candidate {
                    candidate = Eligible(norm, score + contribution(params, norm, weight, tf))
                }
            })
        }
    }
    let mut best: List[(Bytes, Hit[K])] = list.new()
    for take (take encoded, take key) in take keys {
        if let Some(Eligible(_, score)) = map.get(candidates, encoded) {
            keep_hit(mut best, k, (take encoded, Hit(key: take key, score: score)))
        }
    }
    std.list.sort(mut best, ranked)
    for take (_, take hit) in take best {
        list.push(mut hits, take hit)
    }
    Ok(take hits)
}

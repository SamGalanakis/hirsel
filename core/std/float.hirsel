/// e^x within 0.511 ulp, after Arm's optimized-routines exp (musl and glibc carry the
/// same code): x = k ln2/128 + r with |r| <= ln2/256, 2^(k/128) from a 128-entry table,
/// a degree-5 polynomial for e^r, no division. Overflows to inf above 709.782712893384,
/// underflows to 0 below -745.1332191019411; exp(NaN) is NaN, exp(-inf) is 0.
/// Alloc: nothing. Cost: O(1).
/// Ex: `let decay = float.exp(-t / tau)`
pub fn exp(x: f64) -> f64 {
    let bits = float.to_bits64(x)
    // Top 12 bits of |x|: 0x3c9 is 2^-54's, 0x408 is 512's and 0x409 is 1024's.
    let abstop = (bits >> 52) & 0x7ff
    let large = abstop >= 0x408
    if abstop < 0x3c9 {
        // |x| < 2^-54: e^x rounds to 1 + x.
        return 1.0 + x
    }
    if abstop >= 0x409 {
        if bits == 0xfff0000000000000 {
            return 0.0
        }
        if abstop == 0x7ff {
            return 1.0 + x
        }
        return if bits >> 63 != 0 {
            0.0
        } else {
            float.from_bits64(0x7ff0000000000000)
        }
    }
    let shifted = EXP_INVLN2N * x + EXP_SHIFT
    let ki = float.to_bits64(shifted)
    let kd = shifted - EXP_SHIFT
    let r = x + kd * EXP_NEGLN2HIN + kd * EXP_NEGLN2LON
    let idx = 2 * (ki % 128)
    let tail = float.from_bits64(EXP_TAB[idx])
    // The bits of 2^(k/N): a valid double while -1023 N < k < 1024 N.
    let sbits = int.wrapping_add(EXP_TAB[idx + 1], int.wrapping_shl(ki, 45))
    let r2 = r * r
    // e^x = 2^(k/N) e^r ~= scale + scale x (tail + e^r - 1).
    let tmp = tail + r + r2 * (EXP_C2 + r * EXP_C3) + r2 * r2 * (EXP_C4 + r * EXP_C5)
    if large {
        return exp_near_range_end(tmp, sbits, ki)
    }
    let scale = float.from_bits64(sbits)
    scale + scale * tmp
}

// 512 <= |x| < 1024: scale's exponent may be out of range, so it is formed 2^1009 lower
// (k > 0) or 2^1022 higher (k < 0) and multiplied back last. Below 1, the sum is rounded
// once at 1's precision first, so the subnormal result is not rounded twice.
fn exp_near_range_end(tmp: f64, sbits: u64, ki: u64) -> f64 {
    if ki & 0x80000000 == 0 {
        let scale = float.from_bits64(int.wrapping_sub(sbits, 0x3f10000000000000))
        return float.from_bits64(0x7f00000000000000) * (scale + scale * tmp)
    }
    let scale = float.from_bits64(int.wrapping_add(sbits, 0x3fe0000000000000))
    let mut y = scale + scale * tmp
    if float.lt(y, 1.0) {
        let mut lo = scale - y + scale * tmp
        let hi = 1.0 + y
        lo = 1.0 - hi + y + lo
        y = hi + lo - 1.0
    }
    float.from_bits64(0x0010000000000000) * y
}


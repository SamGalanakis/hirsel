// Module `int`, extended (LANG-7): library members of the core module `int` (SEM-1). The
// core members (wrapping_, checked_, saturating_, widen, narrow, try_narrow, truncate,
// parse) are declared in core/core/int.hirsel, generic over the integer types.
//
// A library function cannot be generic over the integer types: no bound names them
// (OWN-4), so a library `[T]` admits every type and its body cannot do arithmetic on T.
// Radix parsing is therefore written once at u64 and once at i64, as Go's ParseUint and
// ParseInt; a narrower result is `int.try_narrow` of it. Nothing here allocates.
/// Parses the whole of s as an unsigned number in `base` (2 to 36), digits as char.digit
/// reads them; no sign, prefix, spaces or '_'.
/// Fails: Fail when base is outside 2..=36; Error(Empty) for "", Error(Invalid(i)) at
/// the first byte i that is not a digit in base, Error(OutOfRange) at the first digit
/// that overflows u64 (Go ParseUint). Cost: O(len).
/// Ex: `let cp: Option[u32] = int.try_narrow(int.parse_uint(hex4, 16)?)`
pub fn parse_uint(s: String, base: u32) -> Result[u64, ParseError] {
    if base < 2 || base > 36 {
        fail("int.parse_uint: base outside 2..=36")
    }
    let b = string.as_bytes(s)
    if list.len(b) == 0 {
        return Error(Empty)
    }
    digits(b, 0, base)
}

/// As parse_uint, with an optional leading '-'; "-" alone is Error(Invalid(1)), and the
/// range is i64's, so "-9223372036854775808" parses. Ex: `let d = int.parse_int(field, 10)?`
pub fn parse_int(s: String, base: u32) -> Result[i64, ParseError] {
    if base < 2 || base > 36 {
        fail("int.parse_int: base outside 2..=36")
    }
    let b = string.as_bytes(s)
    let n = list.len(b)
    if n == 0 {
        return Error(Empty)
    }
    let negative = b[0] == b'-'
    let start: u64 = if negative {
        1
    } else {
        0
    }
    if start == n {
        return Error(Invalid(start))
    }
    let m = digits(b, start, base)?
    if !negative {
        let narrowed: Option[i64] = int.try_narrow(m)
        return match narrowed {
            Some(x) => Ok(x),
            None => Error(OutOfRange),
        }
    }
    if m == 9223372036854775808 {
        Ok(-9223372036854775808)
    } else if m < 9223372036854775808 {
        let x: i64 = int.narrow(m)
        Ok(-x)
    } else {
        Error(OutOfRange)
    }
}

/// The digits b[start..] in base as a u64; b[start..] is not empty.
fn digits(b: Bytes, start: u64, base: u32) -> Result[u64, ParseError] {
    let radix: u64 = int.widen(base)
    let mut v: u64 = 0
    for i in start .. list.len(b) {
        let x = b[i]
        let d: u64 = if x >= b'0' && x <= b'9' {
            int.widen(x - b'0')
        } else if x >= b'a' && x <= b'z' {
            int.widen(x - b'a' + 10)
        } else if x >= b'A' && x <= b'Z' {
            int.widen(x - b'A' + 10)
        } else {
            return Error(Invalid(i))
        }
        if d >= radix {
            return Error(Invalid(i))
        }
        v = match int.checked_mul(v, radix) {
            Some(r) => r,
            None => return Error(OutOfRange),
        }
        v = match int.checked_add(v, d) {
            Some(r) => r,
            None => return Error(OutOfRange),
        }
    }
    Ok(v)
}

/// Whether the byte b is b'0'..=b'9' (Rust u8::is_ascii_digit); char.is_ascii_digit is the
/// same test on a scalar. Cost: O(1). Ex: `while i < n && int.is_ascii_digit(b[i]) { i += 1 }`
pub fn is_ascii_digit(b: u8) -> bool {
    b >= b'0' && b <= b'9'
}

/// Whether the byte b is b'A'..=b'Z' or b'a'..=b'z' (Rust u8::is_ascii_alphabetic).
/// Cost: O(1). Ex: `if int.is_ascii_alpha(b[i]) { .. }`
pub fn is_ascii_alpha(b: u8) -> bool {
    let l = b | 0x20
    l >= b'a' && l <= b'z'
}

/// b'A'..=b'Z' mapped to b'a'..=b'z'; every other byte unchanged (Rust
/// u8::to_ascii_lowercase). Cost: O(1). Ex: `if int.to_ascii_lower(b[i]) != p[k] { return false }`
pub fn to_ascii_lower(b: u8) -> u8 {
    if b >= b'A' && b <= b'Z' {
        b | 0x20
    } else {
        b
    }
}

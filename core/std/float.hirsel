    (0x170ef54646d49689, 0x2137dfd73f5a90f9), // q = 17
    (0x12725dd1d243aba0, 0xe75fe645cc4873fa), // q = 18
    (0x1d83c94fb6d2ac34, 0xa5663d3c7a0d865d), // q = 19
    (0x179ca10c9242235d, 0x511e976394d79eb1), // q = 20
    (0x12e3b40a0e9b4f7d, 0xda7edf82dd794bc1), // q = 21
    (0x1e392010175ee596, 0x2a6498d1625bac68), // q = 22

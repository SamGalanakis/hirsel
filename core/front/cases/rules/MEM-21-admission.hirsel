// MEM-21: an allocating operation admits its charge before any write; a refusal raises
// the failure Capacity having allocated nothing (budgets.md's `grow`). Hand-derived: a
// first push grows an empty List[u64] to capacity 4, a charge of 4 * 8 = 32 bytes
// (budgets.md), so under `bound bytes 0` it raises requesting 32 with 0 available:
// 32 * 100 + 0, with the caught cause cell still admitted (FAIL-16). Unbounded, one push gives length 1.
// expect: run refused() = 3200 used 32
// expect: run grown() = 1
fn grow(mut xs: List[u64]) {
    list.push(mut xs, 1)
}

fn refused() -> u64 {
    let got = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 0 {
            let mut xs: List[u64] = list.new()
            grow(mut xs)
            list.len(xs)
        }
    })
    match caught(take got) {
        Some(e) => e.requested * 100 + e.available,
        None => 0
    }
}

fn grown() -> u64 {
    let mut xs: List[u64] = list.new()
    grow(mut xs)
    list.len(xs)
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

// Two peak eight-byte allocations fit in 16 bytes beyond main startup.
pub fn main()->Result[(),Exit] {
    let mut s=string.new()
    string.reserve(mut s,3)
    string.push(mut s,"abc")
    string.push(mut s,"")
    string.push(mut s,"é")
    if s!="abcé" || string.byte_len(s)!=5u64 { return Error(Exit(status:1)) }
    {
        let b=string.as_bytes(s)
        if list.capacity(b)<5u64 || b[3]!=0xC3u8 || b[4]!=0xA9u8 { return Error(Exit(status:2)) }
    }
    // MEM-26: growth charges the active bound, which has zero bytes left.
    // The limit funding the existing storage still has eight bytes available.
    let refused=bound bytes 0 { string.reserve(mut s,100) }
    match refused { Ok(Error(c)) => if c.available!=0u64 || c.requested!=112u64 { return Error(Exit(status:3)) }, _ => return Error(Exit(status:4)) }
    if s!="abcé" { return Error(Exit(status:5)) }
    Ok(())
}

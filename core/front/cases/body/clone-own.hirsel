// MEM-17, T1.5, FAIL-5, budgets.md: clone copies every own part into new blocks at capacity equal
// to its length; a refusal at block k drops the blocks already copied, refunds them, and
// leaves x untouched. Hand-derived charges: a List[String] of two is 2 x 24 = 48, "ab"
// and "cde" 8 each; a Box[Cell] node is 24 + 8 = 32. So under 60 bytes the list copy
// takes 48 + 8 and raises at "cde" (requested 8, available 4); Two under 12 raises at b
// with 4 left; Box[Cell] under 36 raises at "hello" with 4 left. Each refund shows as
// nothing but the caught 32-byte cause cell still admitted. generic() is apart()
// through a generic instance, derived once T is closed.
// expect: run apart() = 2005
// expect: run tree() = 10
// expect: run boxed() = 7
// expect: run selected() = 5
// expect: run refused() = 804 used 32
// expect: run two_refused() = 804 used 32
// expect: run box_refused() = 804 used 32
// expect: run generic() = 2005
type Cell {
    s: String,
    n: u64
}

type Two {
    a: String,
    b: String
}

type Tree {
    v: u64,
    kids: List[Tree]
}

fn own(x: String) -> String {
    let mut s = string.new()
    let _ = string.push(mut s, x)
    s
}

fn strings() -> List[String] {
    let mut xs: List[String] = list.new()
    let _ = list.push(mut xs, own("ab"))
    let _ = list.push(mut xs, own("cde"))
    xs
}

fn apart() -> u64 {
    let mut xs = strings()
    let c: List[String] = clone(xs)
    let ys = take c
    list.clear(mut xs)
    let mut n = list.len(ys) * 1000
    for y in ys {
        n = n + string.byte_len(y)
    }
    n
}

fn sum(t: Tree) -> u64 {
    let mut s = t.v
    for k in t.kids {
        s = s + sum(k)
    }
    s
}

fn leaf(v: u64) -> Tree {
    Tree(v: v, kids: list.new())
}

fn tree() -> u64 {
    let mut deep: List[Tree] = list.new()
    let _ = list.push(mut deep, leaf(4))
    let mut kids: List[Tree] = list.new()
    let _ = list.push(mut kids, leaf(2))
    let _ = list.push(mut kids, Tree(v: 3, kids: take deep))
    let mut t = Tree(v: 1, kids: take kids)
    let c: Tree = clone(t)
    let u = take c
    list.clear(mut t.kids)
    sum(u)
}

fn boxed() -> u64 {
    let b = box.new(Cell(s: own("hello"), n: 2))
    let c: Box[Cell] = clone(b)
    let d = take c
    let _ = box.unbox(take b)
    string.byte_len(d.s) + d.n
}

fn selected() -> u64 {
    let b = box.new(Cell(s: own("hello"), n: 2))
    let c: Cell = clone(b)
    let d = take c
    let _ = box.unbox(take b)
    string.byte_len(d.s)
}

fn refused() -> u64 {
    let x = strings()
    let outer = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 60 {
            let c: List[String] = clone(x)
            0
        }
    })
    match caught(take outer) {
        Some(e) => e.requested * 100 + e.available + list.len(x) - 2,
        None => 1
    }
}

fn two_refused() -> u64 {
    let x = Two(a: own("ab"), b: own("cde"))
    let outer = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 12 {
            let c: Two = clone(x)
            0
        }
    })
    match caught(take outer) {
        Some(e) => e.requested * 100 + e.available,
        None => 1
    }
}

fn box_refused() -> u64 {
    let x = box.new(Cell(s: own("hello"), n: 2))
    let outer = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 36 {
            let c: Box[Cell] = clone(x)
            0
        }
    })
    match caught(take outer) {
        Some(e) => e.requested * 100 + e.available,
        None => 1
    }
}

fn dup[T: shareable](x: T) -> T {
    clone(x)
}

fn generic() -> u64 {
    let mut xs = strings()
    let ys = dup(xs)
    list.clear(mut xs)
    let mut n = list.len(ys) * 1000
    for y in ys {
        n = n + string.byte_len(y)
    }
    n
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

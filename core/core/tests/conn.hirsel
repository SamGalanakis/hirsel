// Units and connections (CONC-15, CONC-17). Charges come from the spec: a
// connection admits 64 + cap × size(T) + b; an item is charged to b at its
// content, round8(len × size(elem)) per buffer; a unit admits 256 + size(R) + 32 + n
// from its spawner, then x's content against n. Loops repeat a law under a bound
// with no slack, so a refund that never comes fails a later iteration.
// test-env: HIRSEL_UNTIED=4
fn owned(s: String) -> String {
    string.from(s)
}

type Ask: cross {
    n: u64,
    back: Client[u64]
}

// An item's buffer crosses by content, and a client inside an item still reaches
// its connection: the receiver answers through the client it was sent.
// expect: run items_cross_with_their_clients() = true
fn items_cross_with_their_clients() -> bool waits {
    let (words, words_in): (Client[String], Inbox[String]) = result.unwrap(conn.new(2, bytes 64))
    let (asks, asks_in): (Client[Ask], Inbox[Ask]) = result.unwrap(conn.new(1, bytes 0))
    let (answers, answers_in): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    result.unwrap(conn.send(words, owned("hello")))
    result.unwrap(conn.send(words, owned("units")))
    result.unwrap(conn.send(asks, Ask(n: 41, back: conn.client(answers))))
    let a = result.unwrap(conn.receive(words_in))
    let b = result.unwrap(conn.receive(words_in))
    let Ask(n: n, back: back) = result.unwrap(conn.receive(asks_in))
    result.unwrap(conn.send(back, n + 1))
    a == "hello" && b == "units" && result.unwrap(conn.receive(answers_in)) == 42
}

// conn.new[u64](2, bytes 8) asks 64 + 16 + 8 = 88: refused at 87 with exactly
// that, and made at 88 with nothing left.
// expect: run new_charges_header_slots_and_room() = true
fn new_charges_header_slots_and_room() -> bool {
    let refused = bound bytes 87 {
        let r: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(2, bytes 8)
        match r {
            Error(c) => c.requested == 88 && c.available == 87,
            Ok(_) => false,
        }
    }
    let made = bound bytes 88 {
        let pair: (Client[u64], Inbox[u64]) = result.unwrap(conn.new(2, bytes 8))
        let probe: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 0)
        match probe {
            Error(c) => c.requested == 72 && c.available == 0,
            Ok(_) => false,
        }
    }
    match (refused, made) {
        (Ok(a), Ok(b)) => a && b,
        _ => false,
    }
}

fn refused_connection(cap: u64, room: u64) -> Capacity {
    let opened: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(cap, bytes room)
    match opened {
        Error(c) => c,
        Ok(_) => fail("connection unexpectedly admitted"),
    }
}

// A request at either maximum is limited by the current 72 bytes. The next
// value is refused with zero available. For u64 the request is 64 + 8 × cap + room.
// expect: run connection_capacity_limits() = true
fn connection_capacity_limits() -> bool {
    let checked = bound bytes 72 {
        let slots = refused_connection(4194303, 0)
        let too_many = refused_connection(4194304, 0)
        let room = refused_connection(1, 1099511627775)
        let too_much = refused_connection(1, 1099511627776)
        let slot_limits = slots.requested == 33554488 && slots.available == 72 && too_many.requested == 33554496 && too_many.available == 0
        let room_limits = room.requested == 1099511627847 && room.available == 72 && too_much.requested == 1099511627848 && too_much.available == 0
        let probe: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 0)
        match probe {
            Ok(_) => slot_limits && room_limits,
            Error(_) => false,
        }
    }
    result.unwrap(checked)
}

// A connection with no slots is a program error.
// expect: run zero_slots() = fail Bounds
fn zero_slots() -> bool {
    let r: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(0, bytes 64)
    true
}

// "abcdefghi" is charged round8(9) = 16 against a room of 8: no send can ever
// take it, so the send fails with Bounds.
// expect: run item_beyond_room() = fail Bounds
fn item_beyond_room() -> bool waits {
    let (c, i): (Client[String], Inbox[String]) = result.unwrap(conn.new(1, bytes 8))
    let _ = conn.send(c, owned("abcdefghi"))
    true
}

// One slot: the second try_send is Full and hands its item back; after a
// receive frees the slot the next one is accepted, in order.
// expect: run try_send_full_hands_back() = true
fn try_send_full_hands_back() -> bool {
    let (c, i): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    let first = match conn.try_send(c, 1) {
        Ok(()) => true,
        _ => false,
    }
    let full = match conn.try_send(c, 2) {
        Error(Full(x)) => x == 2,
        _ => false,
    }
    let one = result.unwrap(conn.try_receive(i))
    let third = match conn.try_send(c, 3) {
        Ok(()) => true,
        _ => false,
    }
    let empty_after = match conn.try_receive(i) {
        Ok(x) => x == 3,
        _ => false,
    }
    let empty = match conn.try_receive(i) {
        Error(Empty) => true,
        _ => false,
    }
    first && full && one == 1 && third && empty_after && empty
}

// A dropped inbox closes the connection: a send hands its item back. A
// receive drains what was accepted, then sees Closed once no client is left.
// expect: run closed_both_ways() = true
fn closed_both_ways() -> bool waits {
    let (c, i): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    {
        let gone = take i
    }
    let sealed = match conn.send(c, 7) {
        Error(Closed(x)) => x == 7,
        _ => false,
    }
    let (d, j): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    result.unwrap(conn.send(d, 5))
    {
        let gone = take d
    }
    let last = result.unwrap(conn.receive(j))
    let ended = match conn.receive(j) {
        Error(Closed) => true,
        _ => false,
    }
    sealed && last == 5 && ended
}

// A receive whose limit cannot admit the front item's 16 bytes answers
// Capacity with the figures and leaves the item queued for the next receive.
// expect: run receive_refused_keeps_item() = true
fn receive_refused_keeps_item() -> bool waits {
    let (c, i): (Client[String], Inbox[String]) = result.unwrap(conn.new(1, bytes 64))
    result.unwrap(conn.send(c, owned("abcdefghijkl")))
    let refused = bound bytes 8 {
        match conn.receive(i) {
            Error(Capacity(k)) => k.requested == 16 && k.available == 8,
            _ => false,
        }
    }
    let kept = result.unwrap(conn.receive(i))
    match refused {
        Ok(r) => r && kept == "abcdefghijkl",
        _ => false,
    }
}

type Blocked: send {
    c: Client[u64],
    ready: Sender[()]
}

// Tells the owner it runs, then waits on a full connection: the tasks of a unit
// run one at a time, so the owner's next turn finds it parked in the send.
fn blocked_send(take b: Blocked) waits {
    let Blocked(c: c, ready: ready) = take b
    result.unwrap(channel.send(ready, ()))
    let _ = conn.send(c, 2)
}

// A send waiting on a full connection is a cancellation point: the cancelled
// task ends Cancelled and its item never arrives.
// expect: run cancel_waiting_send(tasks) = true
fn cancel_waiting_send(tasks: Tasks) -> bool waits {
    let (c, i): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    let (ready, started): (Sender[()], Receiver[()]) = channel.new(1)
    result.unwrap(conn.send(c, 1))
    let b = Blocked(c: conn.client(c), ready: take ready)
    let mut t = task.spawn(tasks, bytes 65536, take b, blocked_send)
    result.unwrap(channel.receive(started))
    task.cancel(mut t)
    let cancelled = match task.join(take t) {
        Error(Cancelled(_)) => true,
        _ => false,
    }
    let one = result.unwrap(conn.receive(i))
    let none = match conn.try_receive(i) {
        Error(Empty) => true,
        _ => false,
    }
    cancelled && one == 1 && none
}

type Waiting: send {
    i: Inbox[u64],
    ready: Sender[()]
}

fn blocked_receive(take w: Waiting) waits {
    let Waiting(i: i, ready: ready) = take w
    result.unwrap(channel.send(ready, ()))
    let _ = conn.receive(i)
}

// A receive waiting on an empty inbox is a cancellation point; the cancelled
// task's cleanup drops the inbox, so the connection is closed after the join.
// expect: run cancel_waiting_receive(tasks) = true
fn cancel_waiting_receive(tasks: Tasks) -> bool waits {
    let (c, i): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    let (ready, started): (Sender[()], Receiver[()]) = channel.new(1)
    let w = Waiting(i: take i, ready: take ready)
    let mut t = task.spawn(tasks, bytes 65536, take w, blocked_receive)
    result.unwrap(channel.receive(started))
    task.cancel(mut t)
    let cancelled = match task.join(take t) {
        Error(Cancelled(_)) => true,
        _ => false,
    }
    let closed = match conn.send(c, 9) {
        Error(Closed(x)) => x == 9,
        _ => false,
    }
    cancelled && closed
}

type Job: cross {
    word: String,
    back: Client[String]
}

fn echo(take j: Job) -> u64 waits {
    let Job(word: word, back: back) = take j
    let n = string.byte_len(word)
    result.unwrap(conn.send(back, take word))
    n
}

// A helper unit gets its entry by content, answers through the client it was
// given, and its result comes back at the join.
// expect: run helper_echoes(tasks) = true
fn helper_echoes(tasks: Tasks) -> bool waits {
    let (back, answers): (Client[String], Inbox[String]) = result.unwrap(conn.new(1, bytes 64))
    let mut ok = true
    for _ in 0u64 .. 8 {
        let j = Job(word: owned("ping"), back: conn.client(back))
        let t = result.unwrap(task.spawn_unit(tasks, bytes 4096, take j, echo))
        let word = result.unwrap(conn.receive(answers))
        ok = ok && word == "ping" && result.unwrap(task.join(take t)) == 4
    }
    ok
}

fn length(take s: String) -> u64 {
    string.byte_len(s)
}

// The task charge is admitted first: 256 + size(u64) + 32 + 16 = 312 against 311.
// Then x's content, round8(17) = 24, against n = 16. Each refusal hands x back.
// expect: run helper_refusals(tasks) = true
fn helper_refusals(tasks: Tasks) -> bool {
    // A literal's bytes are not the bound's, so all 311 are available.
    let first = bound bytes 311 {
        match task.spawn_unit(tasks, bytes 16, "abcdefghijklmnopq", length) {
            Error((c, take x)) => c.requested == 312 && c.available == 311 && x == "abcdefghijklmnopq",
            Ok(_) => false,
        }
    }
    let second = match task.spawn_unit(tasks, bytes 16, owned("abcdefghijklmnopq"), length) {
        Error((c, take x)) => c.requested == 24 && c.available == 16 && x == "abcdefghijklmnopq",
        Ok(_) => false,
    }
    match first {
        Ok(a) => a && second,
        _ => false,
    }
}

// The current bound has zero steps while its enclosing bound has 17. Entry
// into the helper's callable costs one step, so the helper fails OutOfTime.
// expect: run helper_entry_charges_inherited_bound(tasks) = true
fn helper_entry_charges_inherited_bound(tasks: Tasks) -> bool waits {
    let spawned = bound steps 17 {
        let inner = bound steps 0 {
            task.spawn_unit(tasks, bytes 0, 7u64, idle)
        }
        result.unwrap(take inner)
    }
    let helper = result.unwrap(result.unwrap(take spawned))
    match task.join(take helper) {
        Error(Failed(causes)) => {
            for c in causes {
                return match c.kind {
                    OutOfTime => true,
                    _ => false,
                }
            }
            false
        },
        _ => false,
    }
}

fn fail_owned(take unit: ()) {
    fail(owned("unit fail"))
}

// Spawn costs 256 + 32 + 16 = 304. After join, the cause cell and the
// nine-byte message still cost 32 + round8(9) = 48. Dropping them returns all 304.
// expect: run helper_join_keeps_failure_message(tasks) = true
fn helper_join_keeps_failure_message(tasks: Tasks) -> bool waits {
    let checked = bound bytes 304 {
        let helper = result.unwrap(task.spawn_unit(tasks, bytes 16, (), fail_owned))
        let message = match task.join(take helper) {
            Error(Failed(causes)) => {
                let room = refused_connection(1, 201)
                let mut count = 0u64
                let mut exact = false
                for c in causes {
                    count += 1
                    exact = match c.kind {
                        Fail(message) => message == "unit fail",
                        _ => false,
                    }
                }
                count == 1 && exact && room.requested == 273 && room.available == 256
            },
            _ => false,
        }
        let whole: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 232)
        match whole {
            Ok(_) => message,
            Error(_) => false,
        }
    }
    result.unwrap(checked)
}

fn discard_listener(take l: Listener) {
    let _ = take l
}

fn cross_served_listener(take args: (Net, Tasks)) waits {
    let (n, tasks) = args
    let address = Addr(ip: V4(2130706433), port: 8080)
    let (l, _) = result.unwrap(host.listen(n, address, 4))
    let _ = task.spawn_unit(tasks, bytes 0, take l, discard_listener)
}

// A virtual Net owns the listener it returned. Transferring it to a helper
// stops the whole run with exit 102 and the UnitSocket name (FAIL-15).
// expect: run served_listener_stops_unit_transfer(tasks) = stop UnitSocket
fn served_listener_stops_unit_transfer(tasks: Tasks) waits {
    let (n, s) = provide.net(bytes 32)
    let mut served = take s
    let child = task.spawn(tasks, bytes 4096, (n, tasks), cross_served_listener)
    let Some(take call) = provide.next(mut served) else {
        fail("expected a listen call")
    }
    let address = match provide.net_op(call) {
        Listen(addr: address, backlog: _) => address,
        _ => fail("expected a listen call"),
    }
    result.unwrap(provide.reply(mut served, take call, provide.net_reply(Listener(1, address))))
    let _ = task.join(take child)
}

// Both release orders return the whole charge within the owner's operation.
// expect: run owner_releases_and_remakes() = true
fn owner_releases_and_remakes() -> bool {
    let repeated = bound bytes 88 {
        for n in 0u64 .. 8 {
            let (client, inbox): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(2, bytes 8))
            if n % 2 == 0 {
                let _ = take inbox
                let _ = take client
            } else {
                let _ = take client
                let _ = take inbox
            }
        }
        true
    }
    result.unwrap(repeated)
}

type ReleaseJob: cross {
    last: Client[u64],
    ready: Client[Client[()]],
    done: Client[()]
}

fn release_from_peer(take job: ReleaseJob) waits {
    let ReleaseJob(last: last, ready: ready, done: done) = take job
    let (go, wait_go): (Client[()], Inbox[()]) = result.unwrap(conn.new(1, bytes 0))
    result.unwrap(conn.send(ready, take go))
    result.unwrap(conn.receive(wait_go))
    let _ = take last
    result.unwrap(conn.send(done, ()))
}

// The helper cannot release until the successful send of go. Only the next
// receive can take its notice, which precedes the helper's done message.
// expect: run peer_refunds_at_owner_take(tasks) = true
fn peer_refunds_at_owner_take(tasks: Tasks) -> bool waits {
    let (ready, ready_in): (Client[Client[()]], Inbox[Client[()]]) = result.unwrap(conn.new(1, bytes 0))
    let (done, done_in): (Client[()], Inbox[()]) = result.unwrap(conn.new(1, bytes 0))
    let checked = bound bytes 4456 {
        let (last, inbox): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
        let job = ReleaseJob(last: take last, ready: take ready, done: take done)
        let helper = result.unwrap(task.spawn_unit(tasks, bytes 4096, take job, release_from_peer))
        let go = result.unwrap(conn.receive(ready_in))
        let _ = take inbox
        result.unwrap(conn.try_send(go, ()))
        let probe: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 0)
        let before = match probe {
            Error(c) => c.requested == 72 && c.available == 0,
            Ok(_) => false,
        }
        result.unwrap(conn.receive(done_in))
        let remade: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 0)
        let after = match remade {
            Ok(_) => true,
            Error(_) => false,
        }
        result.unwrap(task.join(take helper))
        before && after
    }
    result.unwrap(checked)
}

type Hand: cross {
    hand: Client[Client[u64]],
    go: Client[()]
}

type HoldJob: cross {
    ready: Client[Hand],
    done: Client[()]
}

// The third unit: it is handed the last client of a connection that another
// helper made and cleaned, holds it until told, then drops it and answers.
fn hold_then_release(take job: HoldJob) waits {
    let HoldJob(ready: ready, done: done) = take job
    let (hand, hand_in): (Client[Client[u64]], Inbox[Client[u64]]) = result.unwrap(conn.new(1, bytes 0))
    let (go, go_in): (Client[()], Inbox[()]) = result.unwrap(conn.new(1, bytes 0))
    result.unwrap(conn.send(ready, Hand(hand: take hand, go: take go)))
    let last = result.unwrap(conn.receive(hand_in))
    result.unwrap(conn.receive(go_in))
    let _ = take last
    result.unwrap(conn.send(done, ()))
}

// A helper that makes a connection from its own n (64 + 1 x 8 + 0 = 72),
// hands the only client to the third unit and cleans its inbox before it
// ends, so the connection survives the helper with its charge.
fn leave_survivor(take hand: Client[Client[u64]]) -> u64 waits {
    let (last, inbox): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 0))
    result.unwrap(conn.send(hand, take last))
    let _ = take inbox
    7
}

// A helper's charge is 256 + size(u64) + 32 + 4096 = 4392, all of a bound
// of 4392. Before the join nothing is left: conn.new(1, bytes 0) asks 72
// against 0. The end take and the join return all of it except the
// connection the helper left behind with its last client in a third unit:
// 72 stay held, so asking the whole 4392 is refused with 4320 available.
// Once the third unit drops that client, the owner's take of its answer
// (after the release in the third unit's order) returns the 72, and the
// whole bound can be spent again.
// expect: run survivor_outlives_helper(tasks) = true
fn survivor_outlives_helper(tasks: Tasks) -> bool waits {
    let (ready, ready_in): (Client[Hand], Inbox[Hand]) = result.unwrap(conn.new(1, bytes 0))
    let (done, done_in): (Client[()], Inbox[()]) = result.unwrap(conn.new(1, bytes 0))
    let peer = result.unwrap(task.spawn_unit(tasks, bytes 4096, HoldJob(ready: take ready, done: take done), hold_then_release))
    let Hand(hand: hand, go: go) = result.unwrap(conn.receive(ready_in))
    let checked = bound bytes 4392 {
        let helper = result.unwrap(task.spawn_unit(tasks, bytes 4096, take hand, leave_survivor))
        let before: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 0)
        let empty = match before {
            Error(c) => c.requested == 72 && c.available == 0,
            Ok(_) => false,
        }
        let seven = result.unwrap(task.join(take helper)) == 7
        let joined: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 4320)
        let held = match joined {
            Error(c) => c.requested == 4392 && c.available == 4320,
            Ok(_) => false,
        }
        result.unwrap(conn.send(go, ()))
        result.unwrap(conn.receive(done_in))
        let released: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 4320)
        let whole = match released {
            Ok(_) => true,
            Error(_) => false,
        }
        empty && seven && held && whole
    }
    result.unwrap(task.join(take peer))
    result.unwrap(checked)
}

fn idle(take n: u64) -> u64 {
    n
}

// Abandoning a helper returns its whole charge with its end: 256 + 8 + 32 +
// 64 = 360 of a bound of 360. Before the handle is dropped nothing is left;
// after, asking all 360 succeeds.
// expect: run abandoned_helper_returns_its_charge(tasks) = true
fn abandoned_helper_returns_its_charge(tasks: Tasks) -> bool {
    let checked = bound bytes 360 {
        let helper = result.unwrap(task.spawn_unit(tasks, bytes 64, 5u64, idle))
        let before: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 0)
        let empty = match before {
            Error(c) => c.requested == 72 && c.available == 0,
            Ok(_) => false,
        }
        let _ = take helper
        let after: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 288)
        let whole = match after {
            Ok(_) => true,
            Error(_) => false,
        }
        empty && whole
    }
    result.unwrap(checked)
}

// Local tasks and unit helpers draw on one account. A local task's charge
// is 256 + 8 + 32 + 40 = 336 and a helper's 256 + 8 + 32 + 64 = 360, all of
// a bound of 696. Before either join nothing is left; the helper's join
// returns its 360, so a connection of 360 is made and released (the owner's
// own release returns it within the drop); the local join returns the rest.
// expect: run local_tasks_and_helpers_share_one_account(tasks) = true
fn local_tasks_and_helpers_share_one_account(tasks: Tasks) -> bool waits {
    let checked = bound bytes 696 {
        let local = task.spawn(tasks, bytes 40, 3u64, idle)
        let helper = result.unwrap(task.spawn_unit(tasks, bytes 64, 5u64, idle))
        let before: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 0)
        let empty = match before {
            Error(c) => c.requested == 72 && c.available == 0,
            Ok(_) => false,
        }
        let five = result.unwrap(task.join(take helper)) == 5
        let (c, i): (Client[u64], Inbox[u64]) = result.unwrap(conn.new(1, bytes 288))
        let _ = take i
        let _ = take c
        let three = result.unwrap(task.join(take local)) == 3
        let after: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 624)
        let whole = match after {
            Ok(_) => true,
            Error(_) => false,
        }
        empty && five && three && whole
    }
    result.unwrap(checked)
}

// 64 bytes whose i-th byte is i × 31 + seed (mod 256).
fn filled(seed: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(64)
    for i in 0u64 .. 64 {
        list.push(mut b, int.truncate(i * 31 + seed))
    }
    b
}

fn holds(b: Bytes, seed: u64) -> bool {
    let mut ok = list.len(b) == 64
    for i in 0u64 .. 64 {
        let want: u8 = int.truncate(i * 31 + seed)
        ok = ok && b[i] == want
    }
    ok
}

// True when the running bound cannot admit one more word.
fn bound_full() -> bool {
    let mut probe: Bytes = list.new()
    match list.try_reserve(mut probe, 8) {
        Error(_) => true,
        Ok(()) => false,
    }
}

fn bound_has(n: u64) -> bool {
    let mut probe: Bytes = list.new()
    match list.try_reserve(mut probe, n) {
        Error(_) => false,
        Ok(()) => true,
    }
}

// Takes two items from its own connection (bytes 64, one slot, so the
// second send goes into the room the first take left), sees Closed once the
// owner drops its client, and drops its inbox: the connection is gone. Each
// item is charged at the take to the receiver's bound of 128, round8(64) = 64,
// so the bound is full; both keep their bytes, and dropping one returns 64.
fn keeper(take hello: Client[Client[Bytes]]) -> u64 waits {
    let (c, i): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(1, bytes 64))
    result.unwrap(conn.send(hello, take c))
    let kept = bound bytes 128 {
        let a = result.unwrap(conn.receive(i))
        let b = result.unwrap(conn.receive(i))
        let closed = match conn.receive(i) {
            Error(Closed) => true,
            _ => false,
        }
        {
            let gone = take i
        }
        let full = bound_full()
        let same = holds(a, 1) && holds(b, 101)
        {
            let gone = take a
        }
        closed && full && same && bound_has(64) && holds(b, 101)
    }
    match kept {
        Ok(true) => 1,
        _ => 0,
    }
}

// A received item is the receiver's own: it keeps its content after the
// connection's room is reused by the next send and after the connection is gone.
// expect: run received_bytes_outlive_their_connection(tasks) = true
fn received_bytes_outlive_their_connection(tasks: Tasks) -> bool waits {
    let (hello, hello_in): (Client[Client[Bytes]], Inbox[Client[Bytes]]) = result.unwrap(conn.new(1, bytes 0))
    let t = result.unwrap(task.spawn_unit(tasks, bytes 4096, take hello, keeper))
    let c = result.unwrap(conn.receive(hello_in))
    result.unwrap(conn.send(c, filled(1)))
    result.unwrap(conn.send(c, filled(101)))
    {
        let gone = take c
    }
    result.unwrap(task.join(take t)) == 1
}

type Relay: cross {
    hello: Client[Client[Bytes]],
    next: Client[Bytes]
}

// Takes one item under a bound of 64 (full at the take), waits for its
// connection to close and drops it, then sends the item on: the send's
// acceptance returns the 64.
fn relay(take r: Relay) -> u64 waits {
    let Relay(hello: hello, next: next) = take r
    let (c, i): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(1, bytes 64))
    result.unwrap(conn.send(hello, take c))
    let passed = bound bytes 64 {
        let b = result.unwrap(conn.receive(i))
        let closed = match conn.receive(i) {
            Error(Closed) => true,
            _ => false,
        }
        {
            let gone = take i
        }
        let full = bound_full()
        result.unwrap(conn.send(next, take b))
        closed && full && bound_has(64)
    }
    match passed {
        Ok(true) => 1,
        _ => 0,
    }
}

// The third unit takes the forwarded item under a bound of 64, after the
// first connection is gone, and finds the sender's bytes.
fn sink(take hello: Client[Client[Bytes]]) -> u64 waits {
    let (c, i): (Client[Bytes], Inbox[Bytes]) = result.unwrap(conn.new(1, bytes 64))
    result.unwrap(conn.send(hello, take c))
    let got = bound bytes 64 {
        let b = result.unwrap(conn.receive(i))
        bound_full() && holds(b, 7)
    }
    match got {
        Ok(true) => 1,
        _ => 0,
    }
}

// A received item sent on to a third unit moves with its content: each
// unit is charged 64 at its take, and the relay's send returns its 64.
// expect: run received_bytes_cross_to_a_third_unit(tasks) = true
fn received_bytes_cross_to_a_third_unit(tasks: Tasks) -> bool waits {
    let (sink_hello, sink_in): (Client[Client[Bytes]], Inbox[Client[Bytes]]) = result.unwrap(conn.new(1, bytes 0))
    let s = result.unwrap(task.spawn_unit(tasks, bytes 4096, take sink_hello, sink))
    let next = result.unwrap(conn.receive(sink_in))
    let (relay_hello, relay_in): (Client[Client[Bytes]], Inbox[Client[Bytes]]) = result.unwrap(conn.new(1, bytes 0))
    let r = result.unwrap(task.spawn_unit(tasks, bytes 4096, Relay(hello: take relay_hello, next: take next), relay))
    let c = result.unwrap(conn.receive(relay_in))
    result.unwrap(conn.send(c, filled(7)))
    {
        let gone = take c
    }
    let relayed = result.unwrap(task.join(take r)) == 1
    relayed && result.unwrap(task.join(take s)) == 1
}

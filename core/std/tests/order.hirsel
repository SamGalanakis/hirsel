// Contract tests for `order` (core/std/order.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names.
/// Less 0, Equal 1, Greater 2.
fn rank(o: Order) -> u64 {
    match o {
        Less => 0,
        Equal => 1,
        Greater => 2,
    }
}

// expect: run compare_less() = 0
fn compare_less() -> u64 {
    let one: u64 = 1
    rank(order.compare(one, 2))
}

// expect: run compare_greater() = 2
fn compare_greater() -> u64 {
    let two: u64 = 2
    rank(order.compare(two, 1))
}

// expect: run compare_equal() = 1
fn compare_equal() -> u64 {
    let five: u64 = 5
    rank(order.compare(five, 5))
}

// expect: run compare_signed() = 0
fn compare_signed() -> u64 {
    let a: i64 = -1
    rank(order.compare(a, 1))
}

// expect: run min_of_two() = 3
fn min_of_two() -> u64 {
    order.min(9, 3)
}

// expect: run max_of_two() = 9
fn max_of_two() -> u64 {
    order.max(3, 9)
}

// expect: run min_equal() = -4
fn min_equal() -> i64 {
    let a: i64 = -4
    order.min(a, -4)
}

// All three reverse cases; identity or an Equal flip changes 210.
// expect: run reverse_cases() = 210
fn reverse_cases() -> u64 {
    rank(order.reverse(Less)) * 100 + rank(order.reverse(Equal)) * 10 + rank(order.reverse(Greater))
}

// Covers all nine pairs. Taking b unconditionally changes the result.
// expect: run then_cases() = 12222
fn then_cases() -> u64 {
    rank(order.then(Less, Less)) * 100000000 +
    rank(order.then(Less, Equal)) * 10000000 +
    rank(order.then(Less, Greater)) * 1000000 +
    rank(order.then(Equal, Less)) * 100000 +
    rank(order.then(Equal, Equal)) * 10000 +
    rank(order.then(Equal, Greater)) * 1000 +
    rank(order.then(Greater, Less)) * 100 +
    rank(order.then(Greater, Equal)) * 10 + rank(order.then(Greater, Greater))
}

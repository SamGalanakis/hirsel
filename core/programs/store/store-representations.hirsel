    match take value {
        Raised => Raised,
        OutOfSteps(item) => OutOfSteps(item),
        OutOfBytes => OutOfBytes,
        Conflict => Conflict,
    }
}

fn stop_kind_from_rep(take value: format.StopKindRep) -> StopKind {
    match take value {
        Raised => Raised,
        OutOfSteps(item) => OutOfSteps(item),
        OutOfBytes => OutOfBytes,
        Conflict => Conflict,
    }
}

fn optional_host_stream_id_to_rep(take value: Option[HostStreamId]) -> Option[types.HostStreamIdRep] {
    match take value {
        Some(take item) => Some(host_stream_id_to_rep(take item)),
        None => None,
    }
}

fn optional_host_stream_id_from_rep(take value: Option[types.HostStreamIdRep]) -> Option[HostStreamId] {
    match take value {
        Some(take item) => Some(host_stream_id_from_rep(take item)),
        None => None,
    }
}

fn optional_limits_to_rep(take value: Option[StoreLimits]) -> Option[types.LimitsRep] {
    match take value {
        Some(take item) => Some(limits_to_rep(take item)),
        None => None,
    }
}

fn optional_stream_key_from_rep(take value: Option[format.StreamKeyRep]) -> Option[StreamKey] {
    match take value {
        Some(take item) => Some(stream_key_from_rep(take item)),
        None => None,
    }
}

fn failure_result_from_rep[T](take value: Result[T, types.Failure]) -> Result[T, Error] {
    match take value {
        Ok(take output) => Ok(take output),
        Error(take failure) => Error(failure_from_rep(take failure)),
    }
}

fn failure_result_to_rep[T](take value: Result[T, Error]) -> Result[T, types.Failure] {
    match take value {
        Ok(take output) => Ok(take output),
        Error(take failure) => Error(failure_to_rep(take failure)),
    }
}

fn optional_stop_kind_to_rep(take value: Option[StopKind]) -> Option[format.StopKindRep] {
    match take value {
        Some(item) => Some(stop_kind_to_rep(item)),
        None => None,
    }
}

fn optional_stop_kind_from_rep(take value: Option[format.StopKindRep]) -> Option[StopKind] {
    match take value {
        Some(item) => Some(stop_kind_from_rep(item)),
        None => None,
    }
}

fn optional_store_key_to_rep(take id: Option[StoreId]) -> Option[types.StoreKey] {
    match id {
        Some(value) => Some(store_key_to_rep(value)),
        None => None,
    }
}

fn transfer_result[T](take result: Result[T, transfer.DeployFailure]) -> Result[T, DeployError] {
    match take result {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(match take problem {
            Store(take item) => Store(failure_from_rep(take item)),
            Scratch(take item) => Scratch(failure_from_rep(take item)),
            ExportMismatch => ExportMismatch,
            ImportMalformed => ImportMalformed,
            Drift => Drift,
        }),
    }
}

fn export_stamp_to_rep(take stamp: ExportStamp) -> transfer.ExportStampRep {
    let ExportStamp(attempt: take attempt, store_hi, store_lo, opened, branch: branch_id, head, next_table, activation, binding: take schema_binding, terminal, end) = take stamp
    transfer.ExportStampRep(attempt: take attempt, store_hi, store_lo, opened, branch: branch_id, head, next_table, activation, binding: take schema_binding, terminal, end)
}

fn prepared_target_to_rep(take target: PreparedTarget) -> transfer.PreparedTargetRep {
    let PreparedTarget(describe: take describe, release: take release, digest: take digest, resident_limit, pack_bytes, checkpoint_bytes, journal_limit, limits) = take target
    transfer.PreparedTargetRep(describe: take describe, release: take release, digest: take digest, resident_limit, pack_bytes, checkpoint_bytes, journal_limit, limits: match limits {
        Some(value) => Some(limits_to_rep(value)),
        None => None,
    })
}

fn prepared_target_from_rep(take target: transfer.PreparedTargetRep) -> PreparedTarget {
    let transfer.PreparedTargetRep(describe: take describe, release: take release, digest: take digest, resident_limit, pack_bytes, checkpoint_bytes, journal_limit, limits) = take target
    PreparedTarget(describe: take describe, release: take release, digest: take digest, resident_limit, pack_bytes, checkpoint_bytes, journal_limit, limits: match limits {
        Some(value) => Some(limits_from_rep(value)),
        None => None,
    })
}

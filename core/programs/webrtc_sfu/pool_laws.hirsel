// ---- RTC-10 pooled rooms (W35) ----
// A browser of `room` on a unit, parked there until a control call admits it.
fn pool_browser(mut u: units.Unit, seed: u64, id: u64, room: peer.RoomId) -> Client {
    let at = addr_of(int.narrow(id))
    let who = peer.Participant(gen: gen_of(id), room: room)
    let Rig(p: take p, c: _, cs: take cs, out: _) = established_with(seed, session_offer(), who, at, 64)
    result.unwrap(units.park(mut u, take p))
    Client(who: gen_of(id), at: at, cs: take cs)
}

/// Run a control call to its end while unit 1 takes only control: its media inbox
/// holds whatever was posted to it.
fn settle_holding(mut w: Units, now: u64, take c: router.Change, mut log: List[Wire]) -> router.Answer {
    let room = router.change_room(c)
    result.unwrap(units.begin(mut w.u0, now, take c))
    let mut held: List[Wire] = list.new()
    for _ in 0u64 .. 8 {
        units.take_control(mut w.u1, now)
        drain(mut w.u2, now)
        drain(mut w.u0, now)
        write(mut w.u1, now, 0, false, mut log, mut held, false)
        write(mut w.u2, now, 0, false, mut log, mut held, false)
        write(mut w.u0, now, 0, false, mut log, mut held, false)
        if let Some(a) = units.finished(mut w.u0, room) {
            return result.unwrap(a)
        }
    }
    fail("a control call did not finish")
}

fn wires_to(log: List[Wire], at: Addr) -> u64 {
    let mut n = 0u64
    for wire in log {
        if wire.to == at {
            n += 1
        }
    }
    n
}

// Whether any datagram to `c` opens as RTP under its SRTP end.
fn got_rtp(mut c: Client, log: List[Wire]) -> bool {
    for wire in log {
        if wire.to != c.at || rtcp_like(wire.data) {
            continue
        }
        let mut b = copy_of(wire.data)
        if let Ok(_) = srtp.unprotect_rtp(mut c.cs, mut b) {
            return true
        }
    }
    false
}

/// bug: a closed room's uncommitted datagram is sent after the close, or a message
/// posted before the close is routed into the room reopened under the same name.
/// oracle: docs/spec/webrtc.md RTC-10 W35 and Close (a closed room's parked datagrams and
/// in-flight messages are discarded), with the wire and stale counts derived by hand.
@test
fn pool_reopened_room_takes_no_stale_message() -> Result[(), router.RouterError] {
    let mut log: List[Wire] = list.new()
    let mut held: List[Wire] = list.new()
    let mut w = three_units(2930)
    let a = option.unwrap(units.next_room(mut w.u0))
    let _ = settle(mut w, 0, Open(room: a, limits: room_limits()), mut log)
    // Room `a`: publisher P and subscriber Q on unit 0, subscriber S on unit 1.
    let mut p = pool_browser(mut w.u0, 2931, 1, a)
    let q = pool_browser(mut w.u0, 2932, 2, a)
    let s = pool_browser(mut w.u1, 2933, 3, a)
    let _ = settle(mut w, 0, Admit(who: peer.Participant(gen: p.who, room: a), home: 0), mut log)
    let _ = settle(mut w, 0, Admit(who: peer.Participant(gen: q.who, room: a), home: 0), mut log)
    let _ = settle(mut w, 0, Admit(who: peer.Participant(gen: s.who, room: a), home: 1), mut log)
    let pa = published(settle(mut w, 0, Publish(room: a, who: p.who, section: 0, id: PublicationId(0), shape: None), mut log))
    let base: router.Target = Layer(encoding: 0, spatial: 0, temporal: 0)
    let _ = settle(mut w, 0, Subscribe(room: a, who: q.who, p: pa, section: 2, target: base), mut log)
    let _ = settle(mut w, 0, Subscribe(room: a, who: s.who, p: pa, section: 2, target: base), mut log)
    let mut now = 10 * MS
    let warm = marked(mut p.cs, 10, MARK_P, false)
    result.unwrap(units.take_datagram(mut w.u0, now, p.at, warm))
    quiesce(mut w, now, 2, false, mut log)
    // Two packets of P: unit 0 queues both for Q and posts two `Media` to unit 1 for
    // S, where they wait in the inbox. Unit 0's `udp_send` commits one of Q's datagrams.
    now += 20 * MS
    for seq in 11u16 .. 13u16 {
        let pkt = marked(mut p.cs, seq, MARK_P, false)
        result.unwrap(units.take_datagram(mut w.u0, now, p.at, pkt))
    }
    // The pacer lets both out.
    now += 10 * MS
    let _ = units.take_timers(mut w.u0, now)
    list.clear(mut log)
    write(mut w.u0, now, 1, false, mut log, mut held, false)
    let suffix = {
        let queued = units.queued(w.u0)
        let mut n = 0u64
        for x in queued.pkts {
            let UdpTx(to, at: _, len: _, ecn: _) = x
            if to == q.at {
                n += 1
            }
        }
        n
    }
    if suffix == 0 {
        fail("no datagram of the room was left uncommitted before the close")
    }
    // Close `a`: its uncommitted suffix on unit 0 is purged, not sent.
    list.clear(mut log)
    now += MS
    let _ = settle_holding(mut w, now, Close(room: a), mut log)
    if wires_to(log, q.at) != 0 {
        fail("a closed room's uncommitted datagram survived the send fence")
    }
    // Reopen under the same name: a new id, and two peers with P's and S's ids and
    // epochs, homed as they were.
    let b = option.unwrap(units.next_room(mut w.u0))
    if b == a {
        fail("a reopened room reused its room id")
    }
    let _ = settle_holding(mut w, now, Open(room: b, limits: room_limits()), mut log)
    let p2 = pool_browser(mut w.u0, 2934, 1, b)
    let mut s2 = pool_browser(mut w.u1, 2935, 3, b)
    let _ = settle_holding(mut w, now, Admit(who: peer.Participant(gen: p2.who, room: b), home: 0), mut log)
    let _ = settle_holding(mut w, now, Admit(who: peer.Participant(gen: s2.who, room: b), home: 1), mut log)
    let pb = published(settle_holding(mut w, now, Publish(room: b, who: p2.who, section: 0, id: PublicationId(0), shape: None), mut log))
    let _ = settle_holding(mut w, now, Subscribe(room: b, who: s2.who, p: pb, section: 2, target: base), mut log)
    // Unit 1 now takes the held messages.
    list.clear(mut log)
    let taken = units.counts(w.u1).media
    let stale = router.counts(units.router_of(w.u1)).stale
    units.take_media(mut w.u1, now)
    write(mut w.u1, now, 0, false, mut log, mut held, false)
    if units.counts(w.u1).media != taken + 2 {
        fail("unit 1 did not hold P's two messages until after the reopen")
    }
    if router.counts(units.router_of(w.u1)).stale != stale + 2 {
        fail("the closed room's messages were not counted stale")
    }
    if router.room_stale(units.router_of(w.u1), b) != Some(0) {
        fail("the closed room's messages were counted against the reopened room")
    }
    if got_rtp(mut s2, log) {
        fail("the reopened room's subscriber received the closed room's packet")
    }
    Ok(())
}

// ---- RTC-10 per-room control (W37) ----
// The answers `room` has finished since the last call: each `NoParticipant` when
// `refused`, else each `Ok`.
fn answers_of(mut u: units.Unit, room: peer.RoomId, refused: bool) -> u64 {
    let mut n = 0u64
    while let Some(a) = units.finished(mut u, room) {
        let as_derived = match a {
            Error(NoParticipant) => refused,
            Error(_) => false,
            Ok(_) => !refused,
        }
        if !as_derived {
            fail("a call answered other than derived")
        }
        n += 1
    }
    n
}

/// bug: one room's revoke waits for another room's control backlog (one call in
/// flight pool-wide), or a control post that finds a full inbox is lost or faults
/// the pool, so its call never returns.
/// oracle: docs/spec/webrtc.md RTC-10 W37 and The control plane, by hand: one call
/// per room, `inflight` ordinary calls across the pool, fences outside the window,
/// and a refused post made again at the next fence point.
@test
fn pool_revoke_waits_for_no_other_room() -> Result[(), router.RouterError] {
    // Three ordinary calls in flight at once. Unit 1's control inbox holds
    // inflight + rooms = 4 orders.
    let plane = units.Plane(inflight: 3, rooms: 1, media_take: 1024)
    let mut w = three_units_planned(2956, U0, U1, U2, plane)
    let mut log: List[Wire] = list.new()
    let mut rooms: List[peer.RoomId] = list.new()
    for _ in 0u64 .. 6 {
        let room = option.unwrap(units.next_room(mut w.u0))
        let _ = settle(mut w, 0, Open(room: room, limits: room_limits()), mut log)
        list.push(mut rooms, room)
    }
    let a = rooms[0]
    let b = rooms[1]
    let c = rooms[2]
    let d = rooms[3]
    let e = rooms[4]
    let f = rooms[5]
    let p = pool_browser(mut w.u0, 2957, 1, a)
    let _ = settle(mut w, 0, Admit(who: peer.Participant(gen: p.who, room: a), home: 0), mut log)
    // Rooms b, c and d each hold one join in flight, homed on unit 1, which has no
    // session parked for any of them: unit 1 refuses each `NoParticipant`. Room b
    // has 100 joins in all.
    let now = 0u64
    for k in 0u64 .. 100 {
        result.unwrap(units.begin(mut w.u0, now, Admit(who: peer.Participant(gen: gen_of(2 + k % 8), room: b), home: 1)))
    }
    result.unwrap(units.begin(mut w.u0, now, Admit(who: peer.Participant(gen: gen_of(2), room: c), home: 1)))
    result.unwrap(units.begin(mut w.u0, now, Admit(who: peer.Participant(gen: gen_of(2), room: d), home: 1)))
    // Room a revokes P with every slot taken: a fence is admitted in the turn it is
    // asked, and unit 0, the first to apply it, has fenced P before any other unit turns.
    result.unwrap(units.begin(mut w.u0, now, Revoke(room: a, id: 1, epoch: 1)))
    if !router.fenced(units.router_of(w.u0), a, p.who) {
        fail("the revoke was not admitted in the turn it was asked")
    }
    // Two more fences fill unit 1's inbox past its bound: four orders are waiting
    // there, so both posts find it full.
    result.unwrap(units.begin(mut w.u0, now, Suspend(room: e, cause: Signaling, on: true)))
    result.unwrap(units.begin(mut w.u0, now, Suspend(room: f, cause: Signaling, on: true)))
    // Unit 1 takes its control inbox every fifth turn; units 2 and 0 every turn.
    let mut revoked: Option[u64] = None
    let mut got_b = 0u64
    let mut got_c = 0u64
    let mut got_d = 0u64
    let mut got_e = 0u64
    let mut got_f = 0u64
    for t in 1u64 .. 601u64 {
        if t % 5 == 0 {
            units.take_control(mut w.u1, now)
        }
        units.take_control(mut w.u2, now)
        units.take_control(mut w.u0, now)
        if revoked == None {
            if let Some(answer) = units.finished(mut w.u0, a) {
                if let Error(_) = answer {
                    fail("the revoke was refused")
                }
                revoked = Some(t)
                if got_b > 1 {
                    fail("the revoke returned after more than room b's join in flight")
                }
            }
        }
        got_b += answers_of(mut w.u0, b, true)
        got_c += answers_of(mut w.u0, c, true)
        got_d += answers_of(mut w.u0, d, true)
        got_e += answers_of(mut w.u0, e, false)
        got_f += answers_of(mut w.u0, f, false)
    }
    // Unit 1's next acknowledgement is at turn 5.
    if revoked != Some(5) {
        fail("the revoke did not return at unit 1's next acknowledgement")
    }
    let mut fenced = false
    for x in units.take_events(mut w.u0) {
        if let Fenced(who) = x {
            if who.room == a && who.gen == p.who {
                fenced = true
            }
        }
    }
    if !fenced {
        fail("the revoke raised no Fenced")
    }
    // No post was lost: every call returned, each answered as derived, and the fences
    // that found the inbox full hold on unit 1.
    if got_b != 100 || got_c != 1 || got_d != 1 || got_e != 1 || got_f != 1 {
        fail("a control call never returned")
    }
    if !router.suspended(units.router_of(w.u1), e) || !router.suspended(units.router_of(w.u1), f) {
        fail("a fence refused by a full inbox never reached unit 1")
    }
    if !router.fenced(units.router_of(w.u1), a, p.who) {
        fail("unit 1 did not apply the revoke")
    }
    Ok(())
}

// ---- MOQ-8 SFU bridge revocation fence over sim.udp with 20% loss (M12) ----
const M12_U0: Addr = Addr(ip: V4(0xc0000201), port: 6100)

const M12_U1: Addr = Addr(ip: V4(0xc0000201), port: 6101)

const M12_U2: Addr = Addr(ip: V4(0xc0000201), port: 6102)

const M12_BRIDGE_ADDR: Addr = Addr(ip: V4(0xc0000201), port: 6103)

const M12_SUB_ADDR: Addr = Addr(ip: V4(0xc0000201), port: 6104)

fn m12_cert() -> Bytes {
    option.unwrap(std.hex.decode(b""))
}

fn m12_digest() -> Inline[u8, 32] {
    [22, 152, 95, 217, 108, 32, 99, 25, 28, 177, 201, 36, 198, 124, 23, 187, 129, 43, 78, 68, 81, 35, 158, 172, 159, 56, 49, 60, 242, 53, 214, 166]
}

fn m12_pins() -> List[quic.handshake.Pin] {
    let mut ps: List[quic.handshake.Pin] = list.with_capacity(1)
    list.push(mut ps, Cert(m12_digest()))
    take ps
}

fn m12_identity() -> quic.handshake.Identity {
    let mut scalar: Bytes = list.with_capacity(32)
    for _ in 0u64 .. 31 {
        list.push(mut scalar, 0)
    }
    list.push(mut scalar, 3)
    let mut point: Bytes = list.with_capacity(65)
    let key = result.unwrap(secret.p256_key(provide.random_tape(take scalar), "sign(p256)", mut point))
    let mut chain: List[Bytes] = list.with_capacity(1)
    list.push(mut chain, m12_cert())
    Identity(chain: take chain, key: take key, alg: P256)
}

fn m12_ep_cfg() -> quic.EndpointConfig {
    let reset = result.unwrap(secret.seal(b"M12 bridge reset", "mac"))
    let token = result.unwrap(secret.seal(b"M12 bridge token", "kdf"))
    quic.EndpointConfig(member: 0, members: 1, cid_len: 8, max_mtu: 1200, retry: Never, reset_key: take reset, token_key: take token, limits: quic.EndpointLimits(connections: 8, unvalidated: 8, datagram_bytes: 262144))
}

fn m12_web_limits() -> webtransport.Limits {
    let mut hosts: List[String] = list.new()
    list.push(mut hosts, "sfu.bridge")
    webtransport.Limits(authorities: take hosts, origins: list.new(), require_origin: false, sessions: 4, sessions_per_connection: 4, pending_connects: 4, streams_bidi: 32, streams_uni: 32, data: 262144, buffered: 16, buffered_datagrams: 16, header_bytes: 4096)
}

fn m12_moq_limits() -> moq.Limits {
    moq.Limits(requests: 32, tracks: 16, control_bytes: 65536, object_bytes: 262144, filter_ranges: 8, max_early_streams: 16, max_timeout_ms: 0, max_buffered: 8388608)
}

fn m12_vp8_frame(mark: u8, seq: u16, key: bool, body_len: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(body_len + 16)
    if key {
        list.append(mut b, vp8_key())
    } else {
        // VP8 descriptor S=1 partition 0, P=1 (interframe) tag.
        list.append(mut b, b"\x10\x11\x02\x00")
    }
    for k in 0u64 .. body_len {
        let v: u8 = int.truncate((k + int.widen(seq)) & 0xff)
        list.push(mut b, v ^ mark)
    }
    list.push(mut b, mark)
    list.push(mut b, int.truncate(seq >> 8))
    list.push(mut b, int.truncate(seq))
    list.push(mut b, mark)
    take b
}

type M12Rig {
    u0: units.Unit,
    u1: units.Unit,
    u2: units.Unit,
    s0: UdpSocket,
    s1: UdpSocket,
    s2: UdpSocket,
    b: bridge.Bridge,
    b_ctrl: Inbox[units.ControlMessage],
    b_media: Inbox[router.Carried],
    doors: List[units.Doors],
    s_bridge: UdpSocket,
    sub_io: moq.LinkIo[moq.MixedDriver],
    sub_sess: moq.Session,
    sub_events: List[moq.Event],
    s_sub: UdpSocket,
    clock: Clock,
    net: Net,
    px: Peer,
    py: Peer,
    bridge_sent_pre: u64,
    bridge_sent_post: u64,
    sub_recv_pre: u64,
    sub_recv_post: u64,
    post_revoke: bool
}

fn m12_send_udp(mut sock: UdpSocket, clock: Clock, to: Addr, data: Bytes) waits {
    let mut tx: List[UdpTx] = list.with_capacity(1)
    list.push(mut tx, UdpTx(to: to, at: 0, len: list.len(data), ecn: 0))
    let now = host.mono_ns(clock)
    let _ = host.udp_send(mut sock, data, tx, At(clock, now + 50 * MS))
}

fn m12_step_units(mut r: M12Rig) waits {
    let now = host.mono_ns(r.clock) + 1
    let _ = result.unwrap(units.turn(mut r.u1, r.clock, mut r.s1, now))
    let _ = result.unwrap(units.turn(mut r.u2, r.clock, mut r.s2, now))
    let _ = result.unwrap(units.turn(mut r.u0, r.clock, mut r.s0, now))
}

fn m12_step_bridge(mut r: M12Rig, hold_staged: bool) waits {
    let now = host.mono_ns(r.clock)
    // 1. Drain control inbox and post Acks back to unit 0 (MOQ-8 fence runs before Ack).
    while let Ok(take cm) = conn.try_receive(r.b_ctrl) {
        let units.ControlMessage(step: take step, opus_fmtp: _) = take cm
        if let Some(take ack) = bridge.control(mut r.b, now, take step) {
            let _ = conn.try_send(r.doors[0].control, units.ControlMessage(step: take ack, opus_fmtp: None))
        }
    }
    // 2. Drain media inbox from publisher home units.
    while let Ok(take msg) = conn.try_receive(r.b_media) {
        bridge.carried(mut r.b, now, take msg)
    }
    for take post in bridge.take_posts(mut r.b) {
        let router.Post(to: to, carried: take c) = take post
        let idx: u64 = int.widen(to)
        if idx < list.len(r.doors) {
            let _ = conn.try_send(r.doors[idx].media, take c)
        }
    }
    // 3. Receive UDP datagrams on bridge's QUIC socket.
    let mut rx: Bytes = list.with_capacity(65536)
    let mut batch: List[UdpPacket] = list.with_capacity(64)
    if let Ok(got) = host.udp_recv(mut r.s_bridge, mut rx, mut batch, At(r.clock, now + 1)) {
        for i in 0u64 .. got {
            let UdpPacket(peer: from, at: at, len: len, truncated: tr, ecn: ecn) = batch[i]
            if tr {
                continue
            }
            bridge.receive(mut r.b, now, from, ecn, mut rx, at, len)
        }
    }
    bridge.poll_jitter(mut r.b, now)
    let _ = bridge.stage(mut r.b, now)
    if !hold_staged {
        let sent = bridge.send(mut r.b, r.clock, mut r.s_bridge, now + 50 * MS, 0xffffffffffffffff)
        if r.post_revoke {
            r.bridge_sent_post += sent
        } else {
            r.bridge_sent_pre += sent
        }
    }
}

fn m12_step_sub(mut r: M12Rig) waits {
    let now = host.mono_ns(r.clock)
    let mut rx: Bytes = list.with_capacity(65536)
    let mut batch: List[UdpPacket] = list.with_capacity(64)
    if let Ok(got) = host.udp_recv(mut r.s_sub, mut rx, mut batch, At(r.clock, now + 1)) {
        for i in 0u64 .. got {
            let UdpPacket(peer: from, at: at, len: len, truncated: tr, ecn: ecn) = batch[i]
            if tr {
                continue
            }
            if r.post_revoke {
                r.sub_recv_post += 1
            } else {
                r.sub_recv_pre += 1
            }
            let mut pkt: Bytes = list.with_capacity(len)
            list.append(mut pkt, list.slice(rx, at, at + len))
            let mut qev: List[quic.Event] = list.new()
            quic.receive_datagram(mut r.sub_io.driver.q, now, from, ecn, mut pkt, 0, len, mut qev)
            m12_sub_events(mut r, now, qev)
        }
    }
    let mut timers: List[quic.Event] = list.new()
    quic.timeout(mut r.sub_io.driver.q, now, mut timers)
    m12_sub_events(mut r, now, timers)
    let _ = moq.poll(mut r.sub_sess, mut r.sub_io, now)
    let mut wire: Bytes = list.with_capacity(64 * 1200)
    let mut out: List[quic.Output] = list.with_capacity(65)
    let _ = quic.poll(mut r.sub_io.driver.q, now, mut wire, mut out)
    let mut sent = 0u64
    for o in out {
        if let Transmit(to: to, at: at, len: len, ..) = o {
            let mut dg: Bytes = list.with_capacity(len)
            list.append(mut dg, list.slice(wire, at, at + len))
            m12_send_udp(mut r.s_sub, r.clock, to, take dg)
            sent += 1
        }
    }
    if sent > 0 {
        quic.committed(mut r.sub_io.driver.q, now, sent)
    }
}

fn m12_sub_events(mut r: M12Rig, now: u64, qev: List[quic.Event]) {
    let mut tevs: List[moq.AddressedEvent] = list.new()
    if let None = r.sub_io.driver.w {
        moq.native_events(mut r.sub_io.driver, qev, mut tevs)
    } else {
        let mut only_h3: List[quic.Event] = list.new()
        for event in qev {
            if let Connected(c: _, alpn: name) = event {
                if name != "h3" {
                    continue
                }
            }
            list.push(mut only_h3, clone(event))
        }
        let mut events: List[webtransport.Event] = list.new()
        if let Some(mut web) = r.sub_io.driver.w {
            webtransport.receive(mut web, mut r.sub_io.driver.q, now, only_h3, mut events)
        }
        moq.web_events(mut r.sub_io.driver, events, mut tevs)
    }
    moq.receive(mut r.sub_sess, mut r.sub_io, now, tevs, mut r.sub_events)
}

fn m12_tick(mut r: M12Rig, hold_staged: bool) waits {
    m12_step_units(mut r)
    m12_step_bridge(mut r, hold_staged)
    m12_step_sub(mut r)
    let now = host.mono_ns(r.clock)
    host.sleep_until(r.clock, now + 5 * MS)
}

fn m12_call(mut r: M12Rig, take c: router.Change, hold_staged: bool) -> router.Answer waits {
    let now = host.mono_ns(r.clock)
    let room = router.change_room(c)
    result.unwrap(units.begin(mut r.u0, now, take c))
    for _ in 0u64 .. 32 {
        m12_tick(mut r, hold_staged)
        if let Some(a) = units.finished(mut r.u0, room) {
            return result.unwrap(a)
        }
    }
    fail("M12: SFU control call did not settle across 4 units (including bridge)")
}

fn m12_speak_x(mut r: M12Rig, key: bool, body_len: u64) waits {
    let seq = r.px.seq
    r.px.seq = int.wrapping_add(seq, 1u16)
    let body = m12_vp8_frame(r.px.mark, seq, key, body_len)
    let wide: u32 = int.widen(seq)
    let pkt = media_carrying(mut r.px.c.cs, r.px.ssrc, seq, 3000 * wide, b"a", 96, body)
    m12_send_udp(mut r.px.sock, r.clock, r.px.home, pkt)
}

fn m12_speak_y(mut r: M12Rig, key: bool, body_len: u64) waits {
    let seq = r.py.seq
    r.py.seq = int.wrapping_add(seq, 1u16)
    let body = m12_vp8_frame(MARK_Y, seq, key, body_len)
    let wide: u32 = int.widen(seq)
    let pkt = media_carrying(mut r.py.c.cs, r.py.ssrc, seq, 3000 * wide, b"a", 96, body)
    m12_send_udp(mut r.py.sock, r.clock, r.py.home, pkt)
}

fn m12_carried(mut r: M12Rig, owner: peer.Gen, p: router.PublicationId, index: u64, ts: u32, marker: bool, take data: Bytes) {
    let now = host.mono_ns(r.clock)
    let room = room_id()
    let m = peer.MediaIn(section: 0, encoding: 0, ssrc: 1, index: index, pt: 0, ts: ts, wide: int.widen(ts), reset: false, marker: marker, payload_at: 0, payload_len: list.len(data), audio_level: None, voice: None, layer: None, dd_at: 0, dd_len: 0, orientation: None, capture: None, plan: None)
    bridge.carried(mut r.b, now, router.Carried(carry: Media(room: room, publication: p, src: owner, m: m, handle: 0, speaking: false, rate: 0, dropped: 0), packet: shared.new(take data)))
}

fn m12_done(events: List[moq.Event], id: moq.RequestId, reason: u64) -> bool {
    list.any(events, scoped fn(e: moq.Event) -> bool {
        match e {
            Done(id: got, code: code) => got == id && code == reason,
            _ => false,
        }
    })
}

fn m12_fetch(mut r: M12Rig, track: moq.codec.TrackName) -> moq.RequestId {
    let loc = moq.codec.Location(group: 0, object: 0)
    result.unwrap(moq.fetch(mut r.sub_sess, mut r.sub_io, host.mono_ns(r.clock), track, loc, moq.codec.Location(group: 1, object: 0), 10, Ascending, None))
}

/// bug: on RTC-7 revoke, the MOQ-8 SFU bridge leaves a revoked participant's MoQ track open,
/// retransmits lost subgroup stream bytes or sends queued datagrams or a polled-but-uncommitted
/// batch past a stream header after the revoke acknowledges, keeps reassembly buffers allocated,
/// or disrupts unrelated participants' bridged MoQ tracks.
/// oracle: MOQ-8 and M12 (docs/spec/moq.md) over sim.udp with 20% packet loss and a polled
/// uncommitted batch at revocation: PUBLISH_DONE ends X's track before the fence acks, zero bytes
/// of X's objects past a stream header leave the bridge's socket after the fence acks (neither
/// first send, nor retransmission, nor queued datagram), X's reassembly buffers are freed, and Y
/// continues streaming cleanly to the MoQ subscriber.
@test
fn bridge_ends_on_revoke(tasks: Tasks) -> Result[(), router.RouterError] waits {
    m12_transport(tasks, false)?
    m12_transport(tasks, true)
}

fn m12_transport(tasks: Tasks, web: bool) -> Result[(), router.RouterError] waits {
    // 0. Verify MOQ-8 budgeted reassembly pricing & ledger reservation in RoomCost.bridge.
    let lim_room = revoke_limits()
    let sess_lim = peer.PeerLimits(sections: 4, down_tracks: 8, rtx_bytes: 65536, pacer_packets: 64, start_bps: 300000, dtls_transport: peer.DTLS_DEFAULT, repair_profile: peer.DEFAULT_REPAIR)
    let cost_b = signal.room_cost_bridge(lim_room, sess_lim, 128, 4096)
    if cost_b.bridge == 0 {
        fail("M12: room_cost_bridge returned zero bridge reassembly cost")
    }
    let mut free_units: List[u64] = list.new()
    list.push(mut free_units, 16777216)
    let mut ledger = signal.ledger(take free_units, 16, sess_lim)
    result.unwrap(signal.ledger_bridge(mut ledger, option.unwrap(units.virtual_unit(1)), router.observer_room_bytes(lim_room) + cost_b.bridge))
    result.unwrap(signal.reserve_room(mut ledger, room_id(), lim_room))
    let before_free = signal.ledger_free(ledger, 1)
    result.unwrap(signal.reserve_bridge(mut ledger, room_id(), cost_b.bridge))
    if signal.ledger_free(ledger, 1) != before_free - cost_b.bridge {
        fail("M12: reserve_bridge did not debit RoomCost.bridge")
    }
    signal.release_bridge(mut ledger, room_id())
    if signal.ledger_free(ledger, 1) != before_free {
        fail("M12: release_bridge did not refund RoomCost.bridge")
    }
    // 1. Stand up sim.udp with 20% loss (200,000 ppm) and 1 ms delay.
    let (net, clock, take served) = sim_net_with(tasks, 8812, 200000, MS)
    let (take s0, b0) = result.unwrap(host.udp_bind(net, M12_U0, SOCK))
    let (take s1, b1) = result.unwrap(host.udp_bind(net, M12_U1, SOCK))
    let (take s2, b2) = result.unwrap(host.udp_bind(net, M12_U2, SOCK))
    let (take s_bridge, b_addr) = result.unwrap(host.udp_bind(net, M12_BRIDGE_ADDR, SOCK))
    let (take s_sub, _) = result.unwrap(host.udp_bind(net, M12_SUB_ADDR, SOCK))
    // 4-unit pool: u0 control, u1 X's home, u2 Y's home, u3 virtual subscriber unit (MoQ bridge).
    let (d0, take c0, take m0) = result.unwrap(units.inboxes(b0, 0, 4, TEST_PLANE))
    let (d1, take c1, take m1) = result.unwrap(units.inboxes(b1, 1, 4, TEST_PLANE))
    let (d2, take c2, take m2) = result.unwrap(units.inboxes(b2, 2, 4, TEST_PLANE))
    let (d3, take c3, take m3) = result.unwrap(units.inboxes(b_addr, 3, 4, TEST_PLANE))
    let mut doors: List[units.Doors] = list.new()
    list.push(mut doors, take d0)
    list.push(mut doors, take d1)
    list.push(mut doors, take d2)
    list.push(mut doors, take d3)
    let mut u0 = result.unwrap(units.unit(provide.random(8800), 0, doors, take c0, take m0, 65536, 64, TEST_PLANE))
    result.unwrap(units.set_virtual(mut u0, option.unwrap(units.virtual_unit(3))))
    let mut u1 = result.unwrap(units.unit(provide.random(8801), 1, doors, take c1, take m1, 65536, 64, TEST_PLANE))
    let mut u2 = result.unwrap(units.unit(provide.random(8802), 2, doors, take c2, take m2, 65536, 64, TEST_PLANE))
    let mlim = m12_moq_limits()
    let b_cfg = bridge.BridgeConfig(unit: 3, window: 128, max_wait_us: 15000, max_frame_bytes: 750, mode: StreamsAndDatagrams)
    let (transport, take server_w, take client_w) = if web {
        let wl = m12_web_limits()
        let mut wire = webtransport.transport(wl)
        list.push(mut wire.alpn, moq.ALPN)
        (take wire, Some(webtransport.endpoint(take wl)), Some(webtransport.endpoint(m12_web_limits())))
    } else {
        (moq.transport_config(mlim), None, None)
    }
    let b_quic = result.unwrap(quic.endpoint(provide.random(8803), m12_ep_cfg(), Some((m12_identity(), take transport))))
    let br = bridge.bridge(b_cfg, take b_quic, take server_w, 1200, mlim, 4, "sfu.bridge", "/room")
    let sub_q = result.unwrap(quic.endpoint(provide.random(8805), m12_ep_cfg(), None))
    let mut sub_io = moq.mixed_driver(take sub_q, take client_w, 1)
    let web_session = if let Some(mut endpoint) = sub_io.driver.w {
        let mut protocols: List[String] = list.new()
        list.push(mut protocols, moq.ALPN)
        Some(result.unwrap(webtransport.connect(mut endpoint, mut sub_io.driver.q, host.mono_ns(clock), b_addr, "https://sfu.bridge/room", m12_pins(), take protocols)))
    } else {
        None
    }
    let sub_link = if let Some(wt) = web_session {
        option.unwrap(moq.web_link(mut sub_io.driver, wt))
    } else {
        let conn_id = result.unwrap(quic.connect(mut sub_io.driver.q, host.mono_ns(clock), b_addr, "server", m12_pins(), None, moq.transport_config(mlim)))
        option.unwrap(moq.native_link(mut sub_io.driver, conn_id))
    }
    let sub_sess = option.unwrap(moq.link_session(sub_io, sub_link, Client, Subscriber, mlim))
    // Two WebRTC publishers: X on unit 1, Y on unit 2.
    let room = room_id()
    let x = gen_of(1)
    let y = gen_of(2)
    let seat_bridge = gen_of(3)
    let one_pub = unit_offer(1, b"96", b"97", b"1", b"3")
    let (take sx, ax) = result.unwrap(host.udp_bind(net, addr_of(1), SOCK))
    let Rig(p: take px_s, c: _, cs: take csx, out: _) = established_as(8810, one_pub, peer.Participant(gen: x, room: room), ax, 64, b"ufragbx")
    result.unwrap(units.park(mut u1, take px_s))
    let (take sy, ay) = result.unwrap(host.udp_bind(net, addr_of(2), SOCK))
    let mut y_offer = minimal_head(b" a c m")
    let video_start = list.len(minimal_head(b" a c"))
    list.append(mut y_offer, list.slice(one_pub, video_start, list.len(one_pub)))
    opus_section(mut y_offer, b"m", b"111", b"sendonly", b"useinbandfec=1")
    let Rig(p: take py_s, c: _, cs: take csy, out: _) = established_as(8820, y_offer, peer.Participant(gen: y, room: room), ay, 64, b"ufragby")
    result.unwrap(units.park(mut u2, take py_s))
    let mut r = M12Rig(
        u0: take u0,
        u1: take u1,
        u2: take u2,
        s0: take s0,
        s1: take s1,
        s2: take s2,
        b: take br,
        b_ctrl: take c3,
        b_media: take m3,
        doors: take doors,
        s_bridge: take s_bridge,
        sub_io: take sub_io,
        sub_sess: take sub_sess,
        sub_events: list.new(),
        s_sub: take s_sub,
        clock: clock,
        net: net,
        px: Peer(c: Client(who: x, at: ax, cs: take csx), sock: take sx, home: b1, ssrc: 0x51000001, seq: 1000, mark: MARK_X),
        py: Peer(c: Client(who: y, at: ay, cs: take csy), sock: take sy, home: b2, ssrc: 0x51000002, seq: 2000, mark: MARK_Y),
        bridge_sent_pre: 0,
        bridge_sent_post: 0,
        sub_recv_pre: 0,
        sub_recv_post: 0,
        post_revoke: false,
    )
    // 2. Open room, admit X (u1), Y (u2), and the virtual bridge seat (u3); publish X & Y and subscribe bridge.
    let _ = m12_call(mut r, Open(room: room, limits: lim_room), false)
    let _ = m12_call(mut r, Admit(who: peer.Participant(gen: x, room: room), home: 1), false)
    let _ = m12_call(mut r, Admit(who: peer.Participant(gen: y, room: room), home: 2), false)
    let _ = m12_call(mut r, Admit(who: peer.Participant(gen: seat_bridge, room: room), home: 3), false)
    let px_pub = published(m12_call(mut r, Publish(room: room, who: x, section: 0, id: PublicationId(0), shape: None), false))
    let py_pub = published(m12_call(mut r, Publish(room: room, who: y, section: 0, id: PublicationId(0), shape: None), false))
    let py_audio = published(m12_call(mut r, Publish(room: room, who: y, section: 2, id: PublicationId(0), shape: None), false))
    let base: router.Target = Layer(encoding: 0, spatial: 0, temporal: 0)
    let _ = m12_call(mut r, Subscribe(room: room, who: seat_bridge, p: px_pub, section: 0, target: base), false)
    let _ = m12_call(mut r, Subscribe(room: room, who: seat_bridge, p: py_pub, section: 1, target: base), false)
    let _ = m12_call(mut r, Subscribe(room: room, who: seat_bridge, p: py_audio, section: 2, target: base), false)
    if !result.unwrap(units.post_bridge(mut r.u0, room, 1, Some(750))) {
        fail("M12: virtual bridge control inbox was full during install")
    }
    m12_tick(mut r, false)
    m12_tick(mut r, false)
    result.unwrap(option.unwrap(units.bridge_answer(mut r.u0, room, 1)))
    // Wait for MoQ QUIC handshake + SETUP to establish over 20%-loss sim.udp.
    let mut moq_up = false
    for _ in 0u64 .. 240 {
        m12_tick(mut r, false)
        if moq.is_established(r.sub_sess) {
            moq_up = true
            break
        }
    }
    if !moq_up {
        fail("M12: MoQ subscriber did not establish session with bridge under 20% loss")
    }
    // Subscribe to X's and Y's MOQ-8 tracks: ((room, participant_id), video/0).
    let tr_x = bridge.track_name(room, x, Vp8, 0, 0)
    let tr_y = bridge.track_name(room, y, Vp8, 0, 0)
    let sub_x_id = result.unwrap(moq.subscribe(mut r.sub_sess, mut r.sub_io, host.mono_ns(r.clock), clone(tr_x), NoFilter, 10, None))
    let _ = result.unwrap(moq.subscribe(mut r.sub_sess, mut r.sub_io, host.mono_ns(r.clock), clone(tr_y), NoFilter, 10, None))
    let tr_audio = bridge.track_name(room, y, Opus, 2, 0)
    let _ = result.unwrap(moq.subscribe(mut r.sub_sess, mut r.sub_io, host.mono_ns(r.clock), clone(tr_audio), NoFilter, 10, None))
    for _ in 0u64 .. 24 {
        m12_tick(mut r, false)
    }
    // RFC 9605 Appendix C.3 ciphertext as one marker-clear Opus RTP payload.
    // The bridge has no key and the subscriber must get the exact payload.
    let cipher = option.unwrap(std.hex.decode(b"9901234567b7412c2513a1b66dbb48841bbaf17f598751176ad847681a69c6d0b091c07018ce4adb34eb"))
    m12_carried(mut r, y, py_audio, 1, 960, false, clone(cipher))
    for _ in 0u64 .. 24 {
        m12_tick(mut r, false)
    }
    if !list.any(r.sub_events, scoped fn(e: moq.Event) -> bool {
        if let Received(o) = e {
            return o.track == tr_audio && quic.payload_bytes(o.payload) == cipher
        }
        false
    }) {
        fail("M12: marker-clear encrypted Opus did not reach its subscriber unchanged")
    }
    list.clear(mut r.sub_events)
    // A video marker arrives ahead of the missing middle of its key frame.
    let start = vp8_key()
    let before = bridge.counts(r.b).published
    m12_carried(mut r, y, py_pub, 1900, 90000, false, take start)
    m12_carried(mut r, y, py_pub, 1902, 90000, true, b"\x00last")
    if bridge.counts(r.b).published != before {
        fail("M12: a video marker published despite a preceding hole")
    }
    m12_carried(mut r, y, py_pub, 1901, 90000, false, b"\x00middle")
    for _ in 0u64 .. 24 {
        m12_tick(mut r, false)
    }
    if bridge.counts(r.b).published != before + 1 {
        fail("M12: jitter did not publish once after the missing video packet arrived")
    }
    list.clear(mut r.sub_events)
    // Verify reassembly buffers are live for X and Y before revoke.
    if bridge.track_count(r.b, x) == 0 || bridge.track_count(r.b, y) == 0 {
        fail("M12: bridge did not allocate reassembly buffers for X and Y")
    }
    // 3. Stream keyframes & interframes from X and Y (including one oversized frame for X).
    m12_speak_x(mut r, true, 600)
    m12_speak_y(mut r, true, 600)
    for k in 0u64 .. 16 {
        m12_tick(mut r, false)
        if k % 2 == 0 {
            m12_speak_x(mut r, k == 8, 600)
            m12_speak_y(mut r, k == 8, 600)
        }
    }
    // Send oversized VP8 frames (> max_frame_bytes = 750) for X until one reaches the bridge
    // under 20% loss and verify it is dropped & counted, then follow with a valid keyframe.
    for _ in 0u64 .. 20 {
        if bridge.counts(r.b).oversized > 0 {
            break
        }
        m12_speak_x(mut r, true, 850)
        for _ in 0u64 .. 5 {
            m12_tick(mut r, false)
        }
    }
    if bridge.counts(r.b).oversized == 0 {
        fail("M12: bridge did not drop and count oversized frame past max_frame_bytes")
    }
    m12_speak_x(mut r, true, 600)
    for _ in 0u64 .. 6 {
        m12_tick(mut r, false)
    }
    // Verify subscriber received objects of both X and Y before revocation.
    let mut pre_x = 0u64
    let mut pre_y = 0u64
    for ev in r.sub_events {
        if let Received(o) = ev {
            if o.track == tr_x {
                pre_x += 1
            } else if o.track == tr_y {
                pre_y += 1
            }
        }
    }
    if pre_x == 0 || pre_y == 0 {
        fail("M12: subscriber did not receive pre-revoke media from both X and Y")
    }
    list.clear(mut r.sub_events)
    // Attempt FETCH over an established, live track before revocation.
    let fetch = m12_fetch(mut r, tr_x)
    for _ in 0u64 .. 24 {
        m12_tick(mut r, false)
    }
    if !m12_done(r.sub_events, fetch, moq.REQ_NOT_SUPPORTED) {
        fail("M12: a live bridge accepted FETCH")
    }
    list.clear(mut r.sub_events)
    // An isolated handshake makes another connection ready in the same
    // socket batch without depending on one media connection's pacer.
    let handshake_at = host.mono_ns(r.clock)
    let _ = result.unwrap(quic.connect(mut r.sub_io.driver.q, handshake_at, b_addr, "server", m12_pins(), None, moq.transport_config(mlim)))
    let mut partial = false
    let mut staged_ok = false
    for attempt in 0u64 .. 24 {
        m12_speak_x(mut r, attempt % 4 == 0, 500)
        m12_speak_x(mut r, false, 500)
        m12_tick(mut r, true)
        let n = bridge.staged_count(r.b)
        if n == 0 {
            continue
        }
        if partial {
            staged_ok = true
            break
        }
        let now = host.mono_ns(r.clock)
        let sent = bridge.send(mut r.b, r.clock, mut r.s_bridge, now + 50 * MS, 1)
        r.bridge_sent_pre += sent
        partial = n > 1 && sent == 1
    }
    if !partial {
        fail("M12: no partial send of a multi-packet batch")
    }
    if !staged_ok {
        fail("M12: no uncommitted retry after a partial send")
    }
    // With the retry held, keep a second SUBSCRIBE pending at the fence.
    let pending = result.unwrap(moq.subscribe(mut r.sub_sess, mut r.sub_io, host.mono_ns(r.clock), clone(tr_x), NoFilter, 10, None))
    for _ in 0u64 .. 48 {
        m12_tick(mut r, true)
        if bridge.pending_subscriptions(r.b) == 1 {
            break
        }
    }
    if bridge.pending_subscriptions(r.b) != 1 {
        fail("M12: no subscription was pending when the fence arrived")
    }
    if r.bridge_sent_pre <= r.sub_recv_pre {
        fail("M12: 20% loss did not drop any pre-revoke bridge packet (no retransmissions pending)")
    }
    // 5. Execute RTC-7 Revoke(room, id: 1, epoch: 1) across all 4 units (including bridge u3).
    // Keep hold_staged = true during Revoke so nothing drains until after the fence acknowledges!
    let _ = m12_call(mut r, Revoke(room: room, id: 1, epoch: 1), true)
    // Immediately at fence acknowledgement: X's reassembly buffers freed, uncommitted batch purged,
    // streams reset, and queued datagrams dropped!
    if bridge.track_count(r.b, x) != 0 {
        fail("M12: revoked participant X's reassembly buffer was not freed at revoke ack")
    }
    if bridge.pending_subscriptions(r.b) != 0 {
        fail("M12: a subscription grant was still pending at revoke ack")
    }
    let fc = bridge.counts(r.b)
    if fc.discarded_staged == 0 {
        fail("M12: polled-but-uncommitted batch was not discarded by the bridge revocation fence")
    }
    if fc.fenced_tracks == 0 || fc.fenced_streams == 0 || fc.dropped_datagrams == 0 {
        fail("M12: bridge fence did not reset open subgroup streams and drop queued datagrams")
    }
    // Let any pre-revoke in-flight sim.udp packets (1 ms delay) arrive and be consumed BEFORE
    // starting the post-revoke socket boundary audit.
    host.sleep_until(r.clock, host.mono_ns(r.clock) + 5 * MS)
    m12_step_sub(mut r)
    list.clear(mut r.sub_events)
    let x_bytes_at_fence = moq.track_rx_bytes_past_header(r.sub_sess, clone(tr_x))
    r.post_revoke = true
    let after_fetch = m12_fetch(mut r, tr_x)
    // 6. Post-revoke phase: run 60 ticks (300 ms) under 20% loss so QUIC retransmissions/PTO
    // fire, PUBLISH_DONE arrives, X keeps sending (must be dropped), and Y keeps streaming!
    for t in 0u64 .. 60 {
        if t % 3 == 0 {
            m12_speak_x(mut r, t % 9 == 0, 500)
            m12_speak_y(mut r, t % 9 == 0, 500)
        }
        m12_tick(mut r, false)
    }
    // Verify ZERO bytes of X's objects past a stream header (neither first send, retransmission,
    // nor datagram) arrived from ANY datagram leaving the bridge's socket after the fence!
    let x_bytes_after = moq.track_rx_bytes_past_header(r.sub_sess, clone(tr_x))
    if x_bytes_after != x_bytes_at_fence {
        fail("M12: a post-revoke datagram from the bridge carried revoked participant X's object bytes past a stream header")
    }
    let mut got_publish_done = false
    let mut post_x_objs = 0u64
    let mut post_y_objs = 0u64
    for ev in r.sub_events {
        match ev {
            Done(id: id, code: code) => {
                if id == sub_x_id && code == moq.DONE_TRACK_ENDED {
                    got_publish_done = true
                }
            },
            Received(o) => {
                if o.track == tr_x {
                    post_x_objs += 1
                } else if o.track == tr_y {
                    post_y_objs += 1
                }
            },
            _ => (),
        }
    }
    if post_x_objs != 0 {
        fail("M12: subscriber received an object of revoked participant X after the fence")
    }
    if !got_publish_done {
        fail("M12: subscriber did not receive PUBLISH_DONE for revoked participant X's track")
    }
    if post_y_objs == 0 {
        fail("M12: unrelated participant Y stopped delivering frames over MoQ after X's revoke")
    }
    if r.bridge_sent_post == 0 || r.sub_recv_post == 0 {
        fail("M12: post-revoke phase carried no bridge datagrams")
    }
    // Give the new request-error cases their own loss recovery window.
    for _ in 0u64 .. 180 {
        if m12_done(r.sub_events, pending, moq.REQ_DOES_NOT_EXIST) && m12_done(r.sub_events, after_fetch, moq.REQ_NOT_SUPPORTED) {
            break
        }
        m12_tick(mut r, false)
    }
    if !m12_done(r.sub_events, pending, moq.REQ_DOES_NOT_EXIST) {
        fail("M12: the subscription pending at revoke did not receive DOES_NOT_EXIST")
    }
    if !m12_done(r.sub_events, after_fetch, moq.REQ_NOT_SUPPORTED) {
        fail("M12: FETCH after revoke did not receive NOT_SUPPORTED")
    }
    if moq.track_rx_bytes_past_header(r.sub_sess, clone(tr_x)) != x_bytes_at_fence {
        fail("M12: later recovery sent bytes of the revoked generation")
    }
    // Reuse the participant number at a higher epoch and subscribe to the
    // same external track name. The old grant must never be reused.
    let fresh: peer.Gen = Gen(id: 1, epoch: 2)
    let Rig(p: take fresh_peer, c: _, cs: take fresh_crypto, out: _) = established_as(8830, one_pub, peer.Participant(gen: fresh, room: room), ax, 64, b"ufragfresh")
    result.unwrap(units.park(mut r.u1, take fresh_peer))
    r.px.c = Client(who: fresh, at: ax, cs: take fresh_crypto)
    r.px.mark = 0x93
    let _ = m12_call(mut r, Admit(who: peer.Participant(gen: fresh, room: room), home: 1), false)
    let newest = published(m12_call(mut r, Publish(room: room, who: fresh, section: 0, id: PublicationId(0), shape: None), false))
    let _ = m12_call(mut r, Subscribe(room: room, who: seat_bridge, p: newest, section: 0, target: base), false)
    if bridge.track_name(room, fresh, Vp8, 0, 0) != tr_x {
        fail("M12: the higher generation did not reuse the track name")
    }
    list.clear(mut r.sub_events)
    let _ = result.unwrap(moq.subscribe(mut r.sub_sess, mut r.sub_io, host.mono_ns(r.clock), clone(tr_x), NoFilter, 10, None))
    for k in 0u64 .. 32 {
        if k >= 8 && k % 4 == 0 {
            m12_speak_x(mut r, true, 500)
        }
        m12_tick(mut r, false)
    }
    if !list.any(r.sub_events, scoped fn(e: moq.Event) -> bool {
        if let Received(o) = e {
            let data = quic.payload_bytes(o.payload)
            let n = list.len(data)
            return o.track == tr_x && n >= 4 && data[n - 4] == 0x93 && data[n - 1] == 0x93
        }
        false
    }) {
        fail("M12: the fresh generation was unable to publish on the reused name")
    }
    // Clean up sockets so sim.udp server finishes cleanly.
    let M12Rig(s0: take ds0, s1: take ds1, s2: take ds2, s_bridge: take dsb, s_sub: take dss, px: take dpx, py: take dpy, ..) = take r
    drop(take ds0)
    drop(take ds1)
    drop(take ds2)
    drop(take dsb)
    drop(take dss)
    drop(take dpx)
    drop(take dpy)
    result.unwrap(task.join(take served))
    Ok(())
}

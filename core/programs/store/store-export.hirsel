pub type ExportStamp: codec + send {
    attempt: Bytes,
    store_hi: u64,
    store_lo: u64,
    opened: u64,
    branch: u32,
    head: u64,
    next_table: u32,
    activation: u64,
    terminal: u64,
    end: u64
}

type ExportLease: shareable + send {
    attempt: Bytes,
    packs: List[u64],
    // M2 needs the exported rows even when OLD has advanced.
    collections: PageTree,
    first: u64,
    terminal: u64,
    end: u64,
    head: u64,
    next_table: u32,
    activation: u64
}

// A schema commit main published under the lease (§3.5a "Catch-up"): an
// index build chunk or a verify demotion. A schema commit writes no journal
// frame, so the round ships it as a step the child replays between the
// tail's commits.
type LeaseStep {
    version: u64,
    before: Roots,
    after: Roots
}

// A step as the round ships it: the catalog records and collection rows the
// commit changed, each with the prior its journal op would carry.
type ExportStep: codec + send {
    version: u64,
    catalog: List[StepOp],
    rows: List[StepOp]
}

type StepOp: codec + send {
    key: Bytes,
    value: Option[Bytes],
    prior: u32
}

// STEPS's first frame: the round it belongs to and how many steps follow.
type StepsMeta: codec + send {
    head: u64,
    terminal: u64,
    end: u64,
    steps: u64
}

// A step as the child's replay applies it.
type ReplayStep {
    version: u64,
    catalog: List[JournalOp],
    rows: List[JournalOp]
}

const STEPS_ROLE: u8 = 10

// Main's roots before a cut that moves main's head under the lease.
fn leased_step_base(db: Db, delta: HolderDelta) -> Option[Roots] {
    if !export_leased(db) {
        return None
    }
    if let ReplaceMain(main, _) = delta {
        if main.head != db.heads[0u64].head {
            return Some(share_roots(db.heads[0u64].roots))
        }
    }
    None
}

fn record_leased_step(mut db: Db, take base: Option[Roots]) {
    let Some(take before) = take base else {
        return ()
    }
    let step = LeaseStep(version: db.heads[0u64].head, before: take before, after: share_roots(db.heads[0u64].roots))
    write_disk(mut db.disk, take step, scoped fn(mut state: DiskState, take published: LeaseStep) {
        list.push(mut state.steps, take published)
    })
}

// A step the child can replay changes only the build state of index records
// and the entries of those indexes. Anything else (a merge into main, a
// stream or keyed change) is Drift: the deploy needs a fresh preparation.
fn export_step(step: LeaseStep) -> Result[ExportStep, DeployError] {
    if tree_stamp(step.before.streams) != tree_stamp(step.after.streams) || list.len(step.before.keyed) != list.len(step.after.keyed) {
        return Error(Drift)
    }
    for slot in 0u64 .. list.len(step.before.keyed) {
        if tree_stamp(step.before.keyed[slot]) != tree_stamp(step.after.keyed[slot]) {
            return Error(Drift)
        }
    }
    let moved = deploy_result(catalog_changes(step.before, step.after))?
    let mut ids: List[u32] = list.new()
    let mut catalog: List[StepOp] = list.with_capacity(list.len(moved))
    for take change in take moved {
        let CatalogChange(key: take key, before: take was, after: take now) = take change
        let (Some(take prior_raw), Some(take raw)) = (take was, take now) else {
            return Error(Drift)
        }
        let moved_id = deploy_result(state_move(prior_raw, raw))?
        let Some(id) = moved_id else {
            return Error(Drift)
        }
        list.push(mut ids, id)
        list.push(mut catalog, StepOp(key: take key, value: Some(take raw), prior: stored_prior(Some(view prior_raw))))
    }
    let changed = deploy_result(compare_page_collections(step.before.collections, step.after.collections))?
    if list.len(changed.trimmed) != 0 || list.len(changed.bounds) != 0 {
        return Error(Drift)
    }
    let mut rows: List[StepOp] = list.with_capacity(list.len(changed.rows))
    for row in changed.rows {
        if list.len(row.tree_key) < 4 {
            return Error(Drift)
        }
        let owner: u32 = list.word_be(row.tree_key, 0)
        let mut moved_owner = false
        for id in ids {
            if id == owner {
                moved_owner = true
            }
        }
        if !moved_owner {
            return Error(Drift)
        }
        let value: Option[Bytes] = match row.value {
            Some(raw) => Some(deploy_result(copied(raw))?),
            None => None,
        }
        let prior = stored_prior(get_page_row(step.before.collections, row.tree_key))
        list.push(mut rows, StepOp(key: deploy_result(copied(row.tree_key))?, value: take value, prior: prior))
    }
    Ok(ExportStep(version: step.version, catalog: take catalog, rows: take rows))
}

// The index id when `before` and `after` are the same index record in
// different build states, else None.
fn state_move(before: Bytes, after: Bytes) -> Result[Option[u32], Error] {
    let mut was = decode_catalog(before)?
    let mut now = decode_catalog(after)?
    if was.kind != 2u8 || now.kind != 2u8 {
        return Ok(None)
    }
    let id = now.id
    was.state = Public
    now.state = Public
    if encode_catalog(was)? != encode_catalog(now)? {
        return Ok(None)
    }
    Ok(Some(id))
}

fn step_bytes(steps: List[ExportStep]) -> u64 {
    let mut total = 0u64
    for step in steps {
        for op in step.catalog {
            total = int.saturating_add(total, op_bytes(op))
        }
        for op in step.rows {
            total = int.saturating_add(total, op_bytes(op))
        }
    }
    total
}

fn op_bytes(op: StepOp) -> u64 {
    let value = match op.value {
        Some(raw) => list.len(raw),
        None => 0u64,
    }
    16u64 + list.len(op.key) + value
}

// Writes STEPS: the meta frame, then one frame per step.
fn write_steps(to: Dir, id: StoreId, stamp: ExportStamp, steps: List[ExportStep]) -> Result[(), Error] waits {
    let ctx = DiskContext(store: id, role: STEPS_ROLE, seq: stamp.head)
    let mut file = open_frames(to, "STEPS", ctx)?
    let meta_codec: std.codec.Codec[StepsMeta] = std.codec.of()
    write_prepared_frame(mut file, 0x0088, meta_codec, StepsMeta(head: stamp.head, terminal: stamp.terminal, end: stamp.end, steps: list.len(steps)))?
    let step_codec: std.codec.Codec[ExportStep] = std.codec.of()
    for step in steps {
        write_prepared_frame(mut file, 0x0089, step_codec, step)?
    }
    finish_frames(take file)
}

// Reads the round's STEPS, which OLD wrote for `stamp` before EXPORT.
fn read_steps(d: Dir, stamp: ExportStamp) -> Result[List[ReplayStep], DeployError] waits {
    let mut file = scratch_result(disk_io(host.open(d, "STEPS", Read)))?
    let header = scratch_result(prepared_read(mut file, 72u64))?
    let head = deploy_result(disk_read_header("STEPS", header, STEPS_ROLE, None, None))?
    if head.context.store.hi != stamp.store_hi || head.context.store.lo != stamp.store_lo || head.context.seq != stamp.head {
        return Error(ExportMismatch)
    }
    let mut input = PreparedInput(file: take file, ctx: head.context, offset: 72u64, digest: std.sha256.start())
    let meta_codec: std.codec.Codec[StepsMeta] = std.codec.of()
    let meta = prepared_frame(mut input, 0x0088, meta_codec)?
    if meta.head != stamp.head || meta.terminal != stamp.terminal || meta.end != stamp.end {
        return Error(ExportMismatch)
    }
    let step_codec: std.codec.Codec[ExportStep] = std.codec.of()
    let mut steps: List[ReplayStep] = list.with_capacity(order.min(meta.steps, 65536u64))
    for _ in 0u64 .. meta.steps {
        let ExportStep(version: at, catalog: take catalog, rows: take rows) = prepared_frame(mut input, 0x0089, step_codec)?
        list.push(mut steps, ReplayStep(version: at, catalog: replay_ops(take catalog), rows: replay_ops(take rows)))
    }
    let PreparedInput(file: take done, ..) = take input
    scratch_result(disk_io(host.close(take done)))?
    Ok(take steps)
}

fn replay_ops(take ops: List[StepOp]) -> List[JournalOp] {
    let mut out: List[JournalOp] = list.with_capacity(list.len(ops))
    for take op in take ops {
        let StepOp(key: take key, value: take value, prior: prior) = take op
        list.push(mut out, JournalOp(key: take key, value: take value, prior: prior, trim: None))
    }
    take out
}

pub type Exported: send {
    dir: Dir,
    name: String,
    stamp: ExportStamp
}

type ExportSource: send = ExportLog(Dir, Bytes) | ExportObject(ObjectExportCopy)

// A deploy export makes a fresh subdirectory of its scratch. A backup (§15)
// writes into the empty target its caller named.
type ExportInto: send = Scratch(Dir) | Target(Dir)

pub opaque type ExportCopy: send {
    source: ExportSource,
    into: ExportInto,
    stamp: ExportStamp,
    lease: Arc[ExportLease]
}

pub type DeployError: send = Store(Error) | Scratch(Error) | ExportMismatch | AttemptBusy | ImportMalformed | Unsettled | IdBound | Drift | Expired | FullNew(StoreCapacity)

fn scratch_result[T](take answer: Result[T, Error]) -> Result[T, DeployError] {
    match take answer {
        Ok(take result_value) => Ok(take result_value),
        Error(take problem) => Error(Scratch(take problem))
    }
}

fn deploy_result[T](take answer: Result[T, Error]) -> Result[T, DeployError] {
    match take answer {
        Ok(take result_value) => Ok(take result_value),
        Error(take problem) => Error(Store(take problem))
    }
}

fn copy_export_file(from: Dir, to: Dir, name: String, end: Option[u64]) -> Result[(), Error] waits {
    let mut input = disk_io(host.open(from, name, Read))?
    let mut output = disk_io(host.open(to, name, Write))?
    let mut offset = 0u64
    let mut chunk: Bytes = list.with_capacity(16384)
    loop {
        list.clear(mut chunk)
        if let Some(total) = end {
            if offset == total {
                break
            }
            if total - offset < list.capacity(chunk) {
                chunk = list.with_capacity(total - offset)
            }
        }
        let read_size = disk_io(host.read(mut input, mut chunk))?
        if read_size == 0 {
            if let Some(_) = end {
                return Error(disk_fault(name, offset, Truncated))
            }
            break
        }
        // A provider may round a buffer's capacity up. Keep only the captured
        // prefix of the terminal segment.
        let written = if let Some(total) = end {
            if read_size > total - offset {
                total - offset
            } else {
                read_size
            }
        } else {
            read_size
        }
        match host.write(mut output, list.slice(chunk, 0u64, written)) {
            Ok(()) => (),
            Error(e) => return Error(Io(e.error)),
        }
        offset += written
    }
    disk_io(host.close(take input))?
    disk_io(host.sync(mut output))?
    disk_io(host.close(take output))
}

fn export_bytes(stamp: ExportStamp) -> Result[Bytes, Error] {
    let codec: std.codec.Codec[ExportStamp] = std.codec.of()
    let ctx = DiskContext(store: StoreId(hi: stamp.store_hi, lo: stamp.store_lo), role: 5, seq: stamp.opened)
    let mut raw = capacity(disk_header_bytes(ctx, 0, 0))?
    let mut body: Bytes = list.new()
    std.codec.encode(codec, stamp, mut body) ?=> |_| Limit(Value)
    list.append(mut raw, capacity(disk_seal(ctx, 72, 0x0080, 1, body))?)
    Ok(take raw)
}

pub fn export_copy(take job: ExportCopy) -> Result[Exported, DeployError] waits {
    let mut name = string.with_capacity(32)
    let to = match job.into {
        Scratch(scratch) => scratch_result(disk_io(host.mkdtemp(scratch, mut name)))?,
        Target(target) => target,
    }
    let raw_stamp = scratch_result(export_bytes(job.stamp))?
    match job.source {
        ExportLog(from, raw) => copy_log_export(from, raw, to, job.lease, job.stamp)?,
        ExportObject(plan) => object_export_copy(plan, to, job.stamp)?,
    }
    scratch_result(disk_write_synced(to, "EXPORT", raw_stamp))?
    scratch_result(disk_io(host.sync_dir(to)))?
    let ExportCopy(stamp: take stamp, ..) = take job
    Ok(Exported(dir: to, name: take name, stamp: take stamp))
}

fn copy_log_export(from: Dir, raw: Bytes, to: Dir, lease: Arc[ExportLease], stamp: ExportStamp) -> Result[(), DeployError] waits {
    for pack in lease.packs {
        let path = scratch_result(capacity(disk_path("p-", pack, "")))?
        scratch_result(copy_export_file(from, to, path, None))?
    }
    scratch_result(disk_write_synced(to, "MANIFEST", raw))?
    let id = StoreId(hi: stamp.store_hi, lo: stamp.store_lo)
    for seq in lease.first .. stamp.terminal {
        let path = scratch_result(capacity(disk_path("j-", seq, "")))?
        let following = match journal_header(from, id, seq + 1, None) {
            Ok(header) => header,
            Error(Corrupt(_)) => None,
            Error(take problem) => return Error(Scratch(take problem)),
        }
        let Some(successor) = following else {
            let next_path = scratch_result(journal_path(seq + 1, ""))?
            return Error(Scratch(disk_fault(next_path, 0, Header)))
        }
        scratch_result(copy_export_file(from, to, path, Some(successor.prev_end)))?
    }
    let terminal = scratch_result(capacity(disk_path("j-", stamp.terminal, "")))?
    scratch_result(copy_export_file(from, to, terminal, Some(stamp.end)))?
    Ok(())
}

// E1 takes the manifest and the acknowledged extent under the writer's LOCK.
// An export task copies those immutable names while the head continues.
pub fn begin_export(mut db: Db, tasks: Tasks, scratch: Dir, take attempt: Bytes, activation: u64, allowance: u64) -> Result[Task[Result[Exported, DeployError]], DeployError] waits {
    let job = begin_export_copy(mut db, scratch, take attempt, activation)?
    match task.try_spawn(tasks, bytes allowance, take job, export_copy) {
        Ok(take copying) => Ok(take copying),
        Error((cap, take returned)) => {
            release_export(mut db, returned.stamp.attempt)
            Error(Store(Full(Allocation(cap))))
        },
    }
}

pub fn begin_export_copy(mut db: Db, scratch: Dir, take attempt: Bytes, activation: u64) -> Result[ExportCopy, DeployError] waits {
    begin_copy(mut db, Scratch(scratch), take attempt, Some(activation))
}

// §15.3: a backup is the export lease and copy, into an empty target, with no
// activation. The caller runs export_copy, then release_export.
pub fn begin_backup(mut db: Db, target: Dir, take attempt: Bytes) -> Result[ExportCopy, DeployError] waits {
    begin_copy(mut db, Target(target), take attempt, None)
}

fn begin_copy(mut db: Db, take into: ExportInto, take attempt: Bytes, activation: Option[u64]) -> Result[ExportCopy, DeployError] waits {
    deploy_result(require_memory_collections(store_has_tiered(db), Export))?
    deploy_result(healthy(db))?
    if !is_disk(db) || list.len(attempt) != 16 {
        return Error(ExportMismatch)
    }
    if let Some(_) = disk_state(db).lease {
        return Error(AttemptBusy)
    }
    if let Target(target) = into {
        require_empty(target, "backup target")?
    }
    if object_writer_open(db) {
        return begin_object_export_copy(mut db, take into, take attempt, activation)
    }
    // An import pin here is an orphan (a kept import needs a lease): cut it
    // away so the copied MANIFEST never carries it (§3.5a "The kept import").
    if let Some(_) = orphan_import_pin(db) {
        let _ = deploy_result(checkpoint(mut db))?
    }
    let final_item = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    deploy_result(durable(mut db, final_item))?
    let from = deploy_result(log_directory(db))?
    let raw = deploy_result(disk_read_paged_file(from, "MANIFEST", 72 + 16 + MANIFEST_LIMIT + 20 + UNKNOWN_ROOM))?
    let lease_attempt = deploy_result(copied(attempt))?
    let stamp = ExportStamp(attempt: take attempt, store_hi: db.store.hi, store_lo: db.store.lo, opened: open_number(db), branch: 0, head: db.heads[0].head, next_table: db.next_table, activation: match activation {
        Some(given) => given,
        None => 0u64
    }, terminal: db.file_seq, end: db.file_end)
    let first_live = disk_state(db).record_cut
    let packs = deploy_result(disk_allocation(scoped fn() -> Result[List[u64], Error] {
        Ok(live_pack_sequences(disk_state(db).pages.locations))
    }))?
    let kept = ExportLease(attempt: take lease_attempt, packs: take packs, collections: share_page_tree(db.heads[0].roots.collections), first: first_live, terminal: stamp.terminal, end: stamp.end, head: stamp.head, next_table: stamp.next_table, activation: stamp.activation)
    let lease = arc.new(take kept)
    let job = ExportCopy(source: ExportLog(from, take raw), into: take into, stamp: take stamp, lease: arc.share(lease))
    write_disk(mut db.disk, take lease, scoped fn(mut state: DiskState, take held: Arc[ExportLease]) {
        state.lease = Some(take held)
        state.steps = list.new()
    })
    Ok(take job)
}

pub fn export_leased(db: Db) -> bool {
    is_disk(db) && (match disk_state(db).lease {
        Some(_) => true,
        None => false
    })
}

// The owner joins or cancels the copy before it releases the attempt.
pub fn release_export(mut db: Db, attempt: Bytes) {
    if is_disk(db) {
        let releasing = match disk_state(db).lease {
            Some(lease) => lease.attempt == attempt,
            None => false
        }
        if releasing {
            forget_import(mut db)
        }
    }
}

// A catch-up round's journal tail (STORE-SPEC §3.5a "Catch-up"): OLD's bytes after the
// previous round's end, through the head this round's barrier made durable.
pub opaque type ExportTail: send {
    from: Dir,
    stamp: ExportStamp,
    terminal: u64,
    end: u64,
    steps: List[ExportStep]
}

pub type ExportRound: send = Tail(ExportTail) | Full(ExportCopy)

// One catch-up round on the leased attempt. The writer is held for one
// durable barrier; the lease moves to the new head under the same attempt.
// A tail over a hundredth of the resident bytes would touch more than about
// N/100 leaves, where a fresh full export is cheaper than the replay (M5),
// so the round releases the lease and begins a full copy instead. The schema
// commits main published since the lease last moved count with the tail.
pub fn advance_export(mut db: Db, scratch: Dir, attempt: Bytes) -> Result[ExportRound, DeployError] waits {
    deploy_result(healthy(db))?
    if !is_disk(db) || object_writer_open(db) {
        return Error(ExportMismatch)
    }
    let lease: Arc[ExportLease] = match disk_state(db).lease {
        Some(held) => arc.share(held),
        None => return Error(ExportMismatch),
    }
    if lease.attempt != attempt {
        return Error(ExportMismatch)
    }
    let final_item = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    deploy_result(durable(mut db, final_item))?
    if db.next_table != lease.next_table {
        return Error(Drift)
    }
    let from = deploy_result(log_directory(db))?
    let leased_steps = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> List[LeaseStep] {
        replace(mut state.steps, list.new())
    })
    let mut steps: List[ExportStep] = list.with_capacity(list.len(leased_steps))
    for step in leased_steps {
        list.push(mut steps, export_step(step)?)
    }
    let journaled = deploy_result(tail_bytes(from, db.store, lease.terminal, lease.end, db.file_seq, db.file_end))?
    let tail = int.saturating_add(journaled, step_bytes(steps))
    if tail > db.resident / 100 {
        release_export(mut db, attempt)
        let renewed = begin_copy(mut db, Scratch(scratch), deploy_result(copied(attempt))?, Some(lease.activation))?
        return Ok(Full(take renewed))
    }
    let stamp = ExportStamp(attempt: deploy_result(copied(attempt))?, store_hi: db.store.hi, store_lo: db.store.lo, opened: open_number(db), branch: 0, head: db.heads[0].head, next_table: db.next_table, activation: lease.activation, terminal: db.file_seq, end: db.file_end)
    let packs: List[u64] = clone(lease.packs)
    let kept = ExportLease(attempt: deploy_result(copied(attempt))?, packs: take packs, collections: share_page_tree(db.heads[0].roots.collections), first: lease.first, terminal: stamp.terminal, end: stamp.end, head: stamp.head, next_table: stamp.next_table, activation: stamp.activation)
    write_disk(mut db.disk, arc.new(take kept), scoped fn(mut state: DiskState, take advanced: Arc[ExportLease]) {
        state.lease = Some(take advanced)
        if let Some(mut kept_import) = state.imported {
            rebase_kept_delta(mut kept_import, steps)
        }
    })
    Ok(Tail(ExportTail(from: from, stamp: take stamp, terminal: lease.terminal, end: lease.end, steps: take steps)))
}

// The journal bytes from `end` of segment `terminal` through `final_end` of
// segment `final_seq`. A rotated segment ends where its successor's header says.
fn tail_bytes(from: Dir, id: StoreId, terminal: u64, end: u64, final_seq: u64, final_end: u64) -> Result[u64, Error] waits {
    let mut total = 0u64
    let mut seq = terminal
    let mut start = end
    loop {
        let boundary = segment_boundary(from, id, seq, final_seq, final_end)?
        if boundary < start {
            return Error(disk_fault(journal_path(seq, "")?, start, Truncated))
        }
        total += boundary - start
        if seq == final_seq {
            return Ok(total)
        }
        seq += 1
        start = 72
    }
}

fn segment_boundary(from: Dir, id: StoreId, seq: u64, final_seq: u64, final_end: u64) -> Result[u64, Error] waits {
    if seq == final_seq {
        return Ok(final_end)
    }
    match journal_header(from, id, seq + 1, None)? {
        Some(following) => Ok(following.prev_end),
        None => Error(disk_fault(journal_path(seq + 1, "")?, 0, Header)),
    }
}

// Appends the tail to the export directory, writes the round's STEPS, then
// rewrites EXPORT with the round's stamp: the rest of the previous terminal
// segment, every segment a rotation started, and the new terminal segment
// through its end.
pub fn copy_export_tail(take tail: ExportTail, to: Dir) -> Result[u64, DeployError] waits {
    let ExportTail(from: from, stamp: take stamp, terminal: terminal, end: end, steps: take steps) = take tail
    let id = StoreId(hi: stamp.store_hi, lo: stamp.store_lo)
    let mut total = 0u64
    let mut seq = terminal
    loop {
        let path = scratch_result(capacity(disk_path("j-", seq, "")))?
        let boundary = scratch_result(segment_boundary(from, id, seq, stamp.terminal, stamp.end))?
        if seq == terminal {
            scratch_result(append_export_range(from, to, path, end, boundary))?
            total += boundary - end
        } else {
            scratch_result(copy_export_file(from, to, path, Some(boundary)))?
            total += boundary
        }
        if seq == stamp.terminal {
            break
        }
        seq += 1
    }
    scratch_result(write_steps(to, id, stamp, steps))?
    let raw_stamp = scratch_result(export_bytes(stamp))?
    scratch_result(disk_write_synced(to, "EXPORT", raw_stamp))?
    scratch_result(disk_io(host.sync_dir(to)))?
    Ok(total)
}

// Appends bytes [low, high) of `name` in `from` to the copy of `name` in `to`,
// which holds exactly `low` bytes.
fn append_export_range(from: Dir, to: Dir, name: String, low: u64, high: u64) -> Result[(), Error] waits {
    if low == high {
        return Ok(())
    }
    let mut input = disk_io(host.open(from, name, Read))?
    let mut output = disk_io(host.open(to, name, Append))?
    let mut chunk: Bytes = list.with_capacity(65536)
    let mut at = low
    while at < high {
        list.clear(mut chunk)
        let read_size = disk_io(host.read_at(mut input, at, mut chunk))?
        if read_size == 0 {
            return Error(disk_fault(name, at, Truncated))
        }
        let written = order.min(read_size, high - at)
        match host.write(mut output, list.slice(chunk, 0u64, written)) {
            Ok(()) => (),
            Error(e) => return Error(Io(e.error)),
        }
        at += written
    }
    disk_io(host.close(take input))?
    disk_io(host.sync(mut output))?
    disk_io(host.close(take output))
}

// R1 has no LOCK, cleanup, rotation or worker. Only this module has a Db
// for the recovered export; callers can stage schema operations on it.
pub opaque type Preparation {
    db: Db,
    stamp: ExportStamp,
    // Set once PREPARED is written: every later round ships a ROUND delta.
    shipped: Option[ShippedImport]
}

pub fn open_export(d: Dir, c: Clock, attempt: Bytes, options: Options) -> Result[Preparation, DeployError] waits {
    open_copied(d, c, attempt, options, true)
}

// A deploy export comes from a runner store, so its FENCE level is 1. A backup
// (§15.3 R4) keeps whatever supported level its source had.
fn open_copied(d: Dir, c: Clock, attempt: Bytes, options: Options, deploy: bool) -> Result[Preparation, DeployError] waits {
    if let Bucket(_) = options.authority {
        return Error(Store(Unsupported(1)))
    }
    let stamp = read_export_stamp(d)?
    if stamp.attempt != attempt {
        return Error(ExportMismatch)
    }
    let (id, take manifest) = deploy_result(read_page_manifest_file(d))?
    if id.hi != stamp.store_hi || id.lo != stamp.store_lo || (deploy && manifest.fence != 1) || manifest.first_live > stamp.terminal || manifest.next_table > stamp.next_table {
        return Error(ExportMismatch)
    }
    let validated = deploy_result(validate_page_manifest(d, id, take manifest))?
    let mut decoded_packs = deploy_result(disk_loaded(id, take validated))?
    let initial = deploy_result(capacity(manifest_state(decoded_packs.manifest, decoded_packs.all)))?
    list.clear(mut decoded_packs.all)
    let replay = deploy_result(journal_replay(take initial, decoded_packs.manifest.next_stamp - 1))?
    let replayed = deploy_result(replay_export(d, id, decoded_packs.manifest.first_live, 72, stamp.terminal, stamp.end, list.new(), take replay))?
    if replayed.state.tips[0].head != stamp.head {
        return Error(ExportMismatch)
    }
    let live_bytes = deploy_result(journal_account(replayed))?
    let JournalReplay(state: take state, next_node: ids, ..) = take replayed
    deploy_result(over_ceiling(live_bytes, options.resident_limit))?
    let mut db = empty_db(c, id, options)
    deploy_result(open_heads(mut db, take state))?
    db.resident = live_bytes
    db.next_node = ids
    db.next_table = stamp.next_table
    Ok(Preparation(db: take db, stamp: take stamp, shipped: None))
}

fn read_export_stamp(d: Dir) -> Result[ExportStamp, DeployError] waits {
    let raw = scratch_result(disk_read_file(d, "EXPORT", 216))?
    let head = deploy_result(disk_read_header("EXPORT", raw, 5, None, None))?
    let frame = deploy_result(disk_read_frame("EXPORT", head.context, raw, 72))?
    if frame.kind != 0x0080 || frame.flags != 1 || frame.end != list.len(raw) {
        return Error(ExportMismatch)
    }
    let codec: std.codec.Codec[ExportStamp] = std.codec.of()
    let stamp = deploy_result(decoded(std.codec.decode(codec, list.slice(raw, frame.payload, frame.end))))?
    if list.len(stamp.attempt) != 16 || stamp.store_hi != head.context.store.hi || stamp.store_lo != head.context.store.lo || stamp.opened != head.context.seq || stamp.branch != 0 || stamp.terminal == 0 || stamp.end < 72 || stamp.activation > stamp.head {
        return Error(ExportMismatch)
    }
    Ok(take stamp)
}

fn backup_listing(d: Dir) -> Result[List[std.dir.Entry], DeployError] waits {
    match std.dir.list(d, None) {
        Ok(take names) => Ok(take names),
        Error(Io(problem)) => Error(Scratch(Io(problem))),
        Error(_) => Error(ExportMismatch),
    }
}

fn require_empty(d: Dir, take what: String) -> Result[(), DeployError] waits {
    if list.len(backup_listing(d)?) != 0 {
        return Error(Scratch(Exists(take what)))
    }
    Ok(())
}

fn copy_restore_file(from: Dir, to: Dir, name: String) -> Result[(), DeployError] waits {
    scratch_result(copy_export_file(from, to, name, None))
}

// §15.3 R1-R5. EXPORT is copied first and removed last, so an ordinary open
// refuses `to` (ExportDirectory) until the copy has been validated by the
// prepare opener. The restored store keeps the source's identity.
pub fn restore(from: Dir, to: Dir, c: Clock, options: Options) -> Result[ExportStamp, DeployError] waits {
    require_empty(to, "restore target")?
    let stamp = read_export_stamp(from)?
    copy_restore_file(from, to, "EXPORT")?
    scratch_result(disk_io(host.sync_dir(to)))?
    copy_restore_file(from, to, "MANIFEST")?
    let (_, take manifest) = deploy_result(read_page_manifest_file(to))?
    for listed in backup_listing(from)? {
        if string.starts_with(listed.name, "p-") {
            copy_restore_file(from, to, listed.name)?
        }
    }
    for seq in manifest.first_live .. stamp.terminal + 1 {
        copy_restore_file(from, to, scratch_result(capacity(disk_path("j-", seq, "")))?)?
    }
    scratch_result(disk_io(host.sync_dir(to)))?
    let _validated = open_copied(to, c, stamp.attempt, options, false)?
    scratch_result(disk_io(host.remove(to, "EXPORT")))?
    scratch_result(disk_io(host.sync_dir(to)))?
    Ok(take stamp)
}

// Replays the copied journal from offset `from` of segment `first` through
// `limit` of `terminal`. A full open starts at 72; a catch-up round starts
// where the previous round ended (STORE-SPEC §3.5a "Catch-up"), and applies
// the round's STEPS where main's versions fall: each before the first main
// commit or fork of main that follows it, the rest at the end.
fn replay_export(d: Dir, id: StoreId, first: u64, from: u64, terminal: u64, limit: u64, steps: List[ReplayStep], take initial: JournalReplay) -> Result[JournalReplay, Error] waits {
    let mut replay = take initial
    let mut seq = first
    let mut start = from
    let mut stepped = 0u64
    loop {
        let path = capacity(disk_path("j-", seq, ""))?
        let boundary = if seq == terminal {
            limit
        } else {
            let following = journal_header(d, id, seq + 1u64, None)?
            match following {
                Some(head) => head.prev_end,
                None => return Error(disk_fault(path, 0u64, Header))
            }
        }
        let mut source = journal_input(disk_io(host.open(d, path, Read))?, false)?
        if seq == terminal && source.size > boundary {
            return Error(disk_fault(path, boundary, Malformed))
        }
        let _ = journal_scan(mut source, path, id, seq, start, Some(boundary), false, mut replay, scoped fn(mut recovered_state: JournalReplay, take event: JournalEvent) -> Result[(), Error] {
            let through = match event {
                Commit(commit) => if commit.branch == 0u32 {
                    int.saturating_sub(commit.version, 1u64)
                } else {
                    0u64
                },
                Fork(started) => if started.parent == 0u32 {
                    started.forked_at
                } else {
                    0u64
                },
            }
            apply_steps(path, mut recovered_state, steps, mut stepped, through)?
            journal_apply(path, mut recovered_state, take event)
        })?
        let JournalInput(file: take file, ..) = take source
        disk_io(host.close(take file))?
        if seq == terminal {
            apply_steps(path, mut replay, steps, mut stepped, 18446744073709551615u64)?
            return Ok(take replay)
        }
        seq += 1
        start = 72
    }
}

// Applies the steps through version `through` to main, each at main's head + 1.
fn apply_steps(file: String, mut replay: JournalReplay, steps: List[ReplayStep], mut stepped: u64, through: u64) -> Result[(), Error] {
    while stepped < list.len(steps) && steps[stepped].version <= through {
        let step = view steps[stepped]
        if replay.state.tips[0u64].id != 0u32 || int.checked_add(replay.state.tips[0u64].head, 1) != Some(step.version) {
            return Error(disk_fault(file, 0, Gap(step.version)))
        }
        journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[0u64].roots.catalog, step.catalog, mut replay.tiered)?
        journal_apply_ops(file, mut replay.next_node, mut replay.state.tips[0u64].roots.collections, step.rows, mut replay.tiered)?
        replay.state.tips[0u64].head = step.version
        stepped += 1
    }
    Ok(())
}

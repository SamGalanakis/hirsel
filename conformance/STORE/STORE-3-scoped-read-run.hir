// rule: STORE-3
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"}}
// Each scoped read reads within the scope it is given, which attenuates the
// transaction's own: it refuses with OutOfScope() a key or range the
// transaction may read but the scope does not hold, and any read at all, even
// of a key both hold, when the scope holds a key the transaction may not read.
// A scope holding keys ReadWrite() that the transaction holds Read() is within
// it for a read.
fn rows() -> table.Table[u64, u64] uses {} {
  table.named("a")
}

fn fill(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"k1", b"1")?
  store.tx_put(mut tx, b"k2", b"2")?
  table.create(mut tx, rows())?
  table.put(mut tx, rows(), 1, 10)?
  table.put(mut tx, rows(), 2, 20)
}

fn count(take n: u64, key: Bytes, value: Bytes) -> (u64, bool) {
  (n + 1, true)
}

// `sub` reads k1 and k2, and rows 1 and 2 of `rows()` with its catalog and
// history; `k1` holds k1 and `t1` row 1 with the catalog and history, both
// ReadWrite(); `wide` and `twide` each hold a key `sub` does not.
fn scoped(
  sub: store.Tx,
  k1: store.KeyScope,
  t1: store.KeyScope,
  wide: store.KeyScope,
  twide: store.KeyScope
) -> bool {
  let gets = store.tx_get_in(sub, k1, b"k1") == Ok(Some(b"1")) && store.tx_get_in(
    sub,
    k1,
    b"k2"
  ) == Error(OutOfScope()) && store.tx_get_in(sub, wide, b"k1") == Error(OutOfScope())
  let ranges = store.tx_range_in(
    sub,
    k1,
    Included(b"k1"),
    Included(b"k1"),
    8,
    Ascending(),
    0u64,
    count
  ) == Ok(1u64) && store.tx_range_in(
    sub,
    k1,
    Included(b"k1"),
    Included(b"k2"),
    8,
    Ascending(),
    0u64,
    count
  ) == Error(OutOfScope()) && store.tx_range_in(
    sub,
    wide,
    Included(b"k1"),
    Included(b"k1"),
    8,
    Ascending(),
    0u64,
    count
  ) == Error(OutOfScope())
  let rows_got = table.get_in(sub, t1, rows(), 1) == Ok(Some(10u64)) && table.get_in(
    sub,
    t1,
    rows(),
    2
  ) == Error(OutOfScope()) && table.get_in(sub, twide, rows(), 1) == Error(OutOfScope())
  let one: List[(u64, u64)] = [(1, 10)]
  let rows_ranged = table.range_in(
    sub,
    t1,
    rows(),
    Included(1),
    Included(1),
    8,
    Ascending()
  ) == Ok(one) && table.range_in(
    sub,
    t1,
    rows(),
    Included(1),
    Included(2),
    8,
    Ascending()
  ) == Error(OutOfScope()) && table.range_in(
    sub,
    twide,
    rows(),
    Included(1),
    Included(1),
    8,
    Ascending()
  ) == Error(OutOfScope())
  let histories = match table.history_in(sub, t1, "a") {
    Ok(h) => list.len(h) == 1,
    Error(_) => false,
  } && table.history_in(sub, k1, "a") == Error(OutOfScope()) && table.history_in(
    sub,
    twide,
    "a"
  ) == Error(OutOfScope())
  gets && ranges && rows_got && rows_ranged && histories
}

fn check_reads(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[
  bool,
  store.TxError
] {
  let keys = store.keys(Included(b"k1"), Included(b"k2"), Read())
  let parent = store.join(
    keys,
    table.scope_keys(tx, rows(), Included(1), Included(2), Read())?
  )
  let k1 = store.keys(Included(b"k1"), Included(b"k1"), ReadWrite())
  let t1 = table.scope_keys(tx, rows(), Included(1), Included(1), ReadWrite())?
  let wide = store.keys(Included(b"k1"), Included(b"k3"), Read())
  let twide = table.scope(rows(), Read())
  store.narrow(
    mut tx,
    parent,
    fn(mut sub: store.Tx) -> bool {
      scoped(sub, k1, t1, wide, twide)
    }
  )
}

pub type Failed = Check | Store(store.StoreError)

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Check())
  }
  let mut s = store.open(a, store.default_config()) ? Store
  let filled: Result[(), store.TxFailure[store.TxError]] = store.transact(
    mut s,
    fill,
    ()
  )
  if filled != Ok(()) {
    return Error(Check())
  }
  let checked: Result[bool, store.TxFailure[store.TxError]] = store.transact(
    mut s,
    check_reads,
    ()
  )
  if checked != Ok(true) {
    return Error(Check())
  }
  Ok(())
}

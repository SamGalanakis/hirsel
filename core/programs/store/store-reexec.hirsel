// RUNNER-SPEC §7 (R5): a recorded call re-executed on its base, under its
// recorded CallInfo, compared with what it committed.
pub type Recorded {
    record: CallRecord,
    claim: Option[Bytes],
    settle: u8,
    branch: Branch,
    base: u64,
    at: u64,
    seed: u64,
    stop: Option[StopKind]
}

pub type Difference = Reply | Writes

pub type UnknownReason = NoEntry | ArgsUnresolved | StateGone | RevisionUnknown | NotRecorded | Effects | AdmissionRefused | Residency

pub type Verdict = Same | Different(Difference) | Unknown(UnknownReason)

// The settle context of a frame's call section (ATTACK-4 M3): an inline reply
// ran on the frame's own base, `at` and seed; a settled one carries its own.
fn recorded_call(id: StoreId, b: Branch, commit: format.JournalCommit) -> Option[Recorded] {
    let Some(section) = view commit.call else {
        return None
    }
    let context = match section.settlement {
        Some(current) => current,
        None => format.Settlement(way: 0, base: commit.version - 1, at: commit.at, seed: call_info(id, b.id, commit.version, commit.at, commit.at).seed, stop: None)
    }
    Some(Recorded(record: call_record_from_rep(clone(section.record)), claim: None, settle: context.way, branch: b, base: context.base, at: context.at, seed: context.seed, stop: optional_stop_kind_from_rep(context.stop)))
}

// The committed frame of `wanted` on `b`, read from the live journal. A
// version the last cut covers, and every version of a memory store, is None.
fn recorded_commit(db: Db, b: Branch, wanted: u64) -> Result[Option[format.JournalCommit], Error] waits {
    healthy(db)?
    let i = branch_index(db, b)?
    let Some(state) = view db.disk else {
        return Ok(None)
    }
    // A version the last cut covers has its frame below record_cut, so the
    // scan from there does not find it.
    if wanted > pages.holder_heads(db.holders)[i].head {
        return Ok(None)
    }
    // Z1: skip the barrier exactly when every frame this Db has sent is acked,
    // so it is written (X1 step 0's condition); never compare a version with
    // `journaled`, which counts frames.
    if !covered(db, Journal(db.frame_seq, 0, 0)) {
        journal_barrier(state)
        match result.unwrap(channel.receive(journal_written(state))) {
            Written => (),
            WriteFailed(e) => {
                let _ = channel.try_send(journal_written_send(state), WriteFailed(e))
                return Error(Poisoned(e))
            }
        }
    }
    let d = log_directory(db)?
    let mut seq = journal.first_live(disk_state(db).retention)
    loop {
        let path = failure_result_from_rep(types.capacity(manifest.disk_path("j-", seq, "")))?
        let file = match host.open(d, path, Read) {
            Ok(take handle) => take handle,
            Error(NotFound) => return Ok(None),
            Error(e) => return Error(Io(e))
        }
        let mut source = failure_result_from_rep(journal.journal_input(take file, false))?
        let following = failure_result_from_rep(journal.journal_following(d, store_key_to_rep(db.store), seq, None))?
        let boundary = match following {
            Some(h) => Some(h.prev_end),
            None => failure_result_from_rep(journal.disk_end(d, store_key_to_rep(db.store), seq))?
        }
        let final_item = match following {
            Some(_) => false,
            None => true
        }
        let mut search: Option[format.JournalCommit] = None
        let _ = journal_scan(mut source, path, db.store, seq, 72, boundary, final_item, mut search, scoped fn(mut found: Option[format.JournalCommit], take event: format.JournalEvent) -> Result[(), Error] {
            let Commit(take commit) = take event else {
                return Ok(())
            }
            if let None = found {
                if commit.branch == b.id && commit.version == wanted {
                    found = Some(take commit)
                }
            }
            Ok(())
        })?
        let consumed_file = format.take_journal_file(take source)
        failure_result_from_rep(manifest.disk_io(host.close(take consumed_file)))?
        if let Some(take commit) = take search {
            return Ok(Some(take commit))
        }
        if final_item {
            return Ok(None)
        }
        seq += 1
    }
}

// The roots of version `base` on `b`: the MANIFEST's state with the live
// journal replayed up to, not including, the commit after `base`. This is the
// open path, so the pages are the ones every load path builds (MEM-30). None
// when the MANIFEST is already past `base`.
fn base_roots(db: Db, b: Branch, base: u64) -> Result[Option[pages.Roots], Error] waits {
    let d = log_directory(db)?
    let (_, store, take page_record) = failure_result_from_rep(capture.read_only_manifest(d))?
    let id = store_key_from_rep(store)
    let disk = disk_state(db)
    let preview = match view disk.preview {
        Some(grant) => Some(view grant),
        None => None
    }
    let none = manifest.new_page_locations()
    let validated = walk_directory_preview(d, id, take page_record, true, false, manifest.SettledPacks(below: 0, locations: view none), preview)?
    let (take selected, take state) = failure_result_from_rep(txn.replay_base_state(take validated))?
    let mut replay = failure_result_from_rep(pager.journal_replay_manifest(take state, selected))?
    let direct = manifest.direct_packs(disk.packs)
    if std.omap.len(direct.stamps.values) != 0 {
        let mut stamps = std.omap.range(direct.stamps.values, Unbounded, Unbounded)
        while let Some((stamp, _)) = std.omap.next(mut stamps) {
            replay.next_node = order.max(replay.next_node, stamp)
        }
        let inventory = failure_result_from_rep(history.recovered_tiered_inventory(manifest.pack_locations(disk.packs), None, selected.generation, selected.next_stamp))?
        let mut private = pager.disk_pager_state(None)
        seed_direct_snapshots(disk.packs, Some(take inventory), selected.generation, replay.next_node, mut replay.state, mut private)?
    }
    for tip in replay.state.tips {
        if tip.id == b.id && tip.head > base {
            return Ok(None)
        }
    }
    let mut held = txn.BaseReplay(replay: take replay, branch: b.id, next: base + 1, stopped: false)
    let mut seq = selected.first_live
    loop {
        let path = failure_result_from_rep(types.capacity(manifest.disk_path("j-", seq, "")))?
        let file = match host.open(d, path, Read) {
            Ok(take handle) => take handle,
            Error(e) => return Error(Io(e))
        }
        let mut source = failure_result_from_rep(journal.journal_input(take file, false))?
        let following = failure_result_from_rep(journal.journal_following(d, store_key_to_rep(id), seq, None))?
        let boundary = match following {
            Some(h) => Some(h.prev_end),
            None => failure_result_from_rep(journal.disk_end(d, store_key_to_rep(id), seq))?
        }
        let final_item = match following {
            Some(_) => false,
            None => true
        }
        let scanned = journal_scan(mut source, path, id, seq, 72, boundary, final_item, mut held, scoped fn(mut at: txn.BaseReplay, take event: format.JournalEvent) -> Result[(), Error] waits {
            if at.stopped {
                return Ok(())
            }
            match take event {
                Commit(take commit) => {
                    if commit.branch == at.branch && commit.version == at.next {
                        at.stopped = true
                        return Ok(())
                    }
                    let ready = directory_replay_event(d, id, at.replay, preview, Commit(take commit))?
                    journal_apply(path, mut at.replay, take ready)
                },
                Fork(take encoded) => failure_result_from_rep(journal.journal_apply_fork(path, mut at.replay, take encoded)),
            }
        })
        let consumed_file = format.take_journal_file(take source)
        failure_result_from_rep(manifest.disk_io(host.close(take consumed_file)))?
        let _ = scanned?
        if held.stopped || final_item {
            break
        }
        seq += 1
    }
    for tip in held.replay.state.tips {
        if tip.id == b.id && tip.head == base {
            return Ok(Some(pages.share_roots(tip.roots)))
        }
    }
    Ok(None)
}

fn stop_kind(stop: Stop) -> StopKind {
    match stop {
        Raised(_) => Raised,
        OutOfSteps(steps) => OutOfSteps(steps),
        OutOfBytes(_) => OutOfBytes,
        Conflict(_) => Conflict,
    }
}

type Rerun[R] = RanTo(R, pages.DataRows) | Halted(Stop) | RoomRefused

// What a witness capture keeps of one attempt (store-witness.hirsel): the
// logical reads, and whether the body stopped on a page outside the slice.
type RerunTrace {
    reads: List[Read],
    outside: bool
}

// Section 7 step 3: the body on `base` under the recorded CallInfo, bounded as
// `serve` bounds it. Nothing is committed; an application error keeps no
// data writes (F2).
fn rerun_attempt[R](start: txn.TxStart, bases: pages.TailBases, tiered_bytes: u64, registry: indexes.IndexRegistry, base: pages.Roots, ci: CallInfo, plan: Plan, call: Recorded, attempt: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], mut trace: Option[RerunTrace], body: scoped[view] fn(Recorded, mut Tx) -> Result[R, R]) -> Rerun[R] {
    let reads: core.Log[Read] = log.new()
    let issued: core.Cell[u64] = cell.new(0)
    let caught = isolate(fn() -> Result[Result[Finished[R, R], Capacity], OutOfTime] {
        bound steps plan.s_e {
            let drafted = bound bytes plan.n_e {
                let keep: Option[fn(R) -> bool] = None
                let staged = draft_at(start, bases, tiered_bytes, registry, base, ci, keep, reads, issued, attempt, pins, scoped fn(mut tx: Tx) -> Result[R, R] {
                    body(call, mut tx)
                })
                match prepare_metered_pages(base, issued, attempt, pins, take staged) {
                    Ok(take ready) => take ready,
                    Error(Full(problem)) => RolledBack(Refused(problem)),
                    Error(_) => fail("store: invalid re-run pages"),
                }
            }
            take drafted
        }
    })
    let logged = log.finish(take reads)
    if let Some(mut kept) = trace {
        kept.reads = take logged
    }
    let _ = cell.into_inner(take issued)
    if pager.call_attempt_latched(attempt) {
        return RoomRefused
    }
    let finished = match take caught {
        Error(problem) => return Halted(OutOfBytes(problem)),
        Ok(Error(take causes)) => {
            if let Some(mut kept) = trace {
                kept.outside = witness_outside(causes)
            }
            return match manifest.raised_capacity(causes) {
                Some(problem) => Halted(OutOfBytes(problem)),
                None => Halted(Raised(txn.cause_number(causes))),
            }
        },
        Ok(Ok(Error(limit))) => return Halted(OutOfSteps(limit.steps)),
        Ok(Ok(Ok(Error(problem)))) => return Halted(OutOfBytes(problem)),
        Ok(Ok(Ok(Ok(take done)))) => take done,
    }
    let (take output, take writes) = match take finished {
        RolledBack(Aborted(Undone(value: take answer, ..))) => (take answer, pages.new_data_rows()),
        RolledBack(Refused(Allocation(problem))) => return Halted(OutOfBytes(problem)),
        RolledBack(Refused(_)) => return RoomRefused,
        RolledBack(Failed(Raised(causes))) => return Halted(Raised(txn.cause_number(causes))),
        RolledBack(Failed(Conflict(take name))) => return Halted(Conflict(take name)),
        // A re-run that finds an index wrong cannot reproduce the call here.
        RolledBack(Failed(Drift(_))) => return RoomRefused,
        Drifted(_, _) => return RoomRefused,
        RolledBack(Stopped(limit)) => return Halted(OutOfSteps(limit.steps)),
        RolledBack(Committed(_)) => fail("store: re-run committed"),
        DraftFault(_) => return RoomRefused,
        Prepared(take ready) => {
            let txn.Prepared(outcome: take outcome, ops: take ops, ..) = take ready
            match take outcome {
                Ok(take answer) => (take answer, take ops),
                Error(take answer) => (take answer, pages.new_data_rows()),
            }
        },
    }
    RanTo(take output, take writes)
}

fn rerun[R](db: Db, registry: indexes.IndexRegistry, base: pages.Roots, ci: CallInfo, plan: Plan, call: Recorded, body: scoped[view] fn(Recorded, mut Tx) -> Result[R, R]) -> Result[Rerun[R], Error] waits {
    let root = capture_pin_root(open_number(db), ci.id.branch, base.collections, pages.holder_bases(db.holders))
    let mut pins = pager.empty_tiered_pins(root, pager.pin_partition(db.pager))
    let mut pending: Option[(format.TieredTarget, types.Failure)] = None
    loop {
        let attempt = pager.call_attempt(captured_tiered(base.collections, pages.holder_bases(db.holders), ci.id.branch), pager.pin_partition(db.pager), pager.tiered_window(pins))
        let mut untraced: Option[RerunTrace] = None
        let reran = rerun_attempt(tx_start(db), pages.holder_bases(db.holders), db.accounting.tiered, registry, base, ci, plan, call, attempt, pins.frames, mut untraced, body)
        let Some(state) = pager.call_attempt_finish(take attempt) else {
            return Ok(take reran)
        }
        match state.stopped {
            None => return Ok(take reran),
            Some(AttemptMiss(_)) => {
                match deliver_call_miss(db, base.collections, pages.holder_bases(db.holders), state, mut pins, mut pending) {
                    Ok(()) => (),
                    Error(Full(_)) => return Ok(RoomRefused),
                    Error(Io(_)) => return Ok(RoomRefused),
                    Error(Remote(_)) => return Ok(RoomRefused),
                    Error(Reclaimed(_)) => return Ok(RoomRefused),
                    Error(Corrupt(Fault(why: Absent, ..))) => return Ok(RoomRefused),
                    Error(take problem) => return Error(take problem),
                }
            },
            Some(_) => return Ok(RoomRefused),
        }
    }
}

pub opaque type ReplaySource {
    store: StoreId,
    open: u64,
    commit: format.JournalCommit,
    call: Recorded,
    base: pages.Roots
}

fn replay_source(db: Db, b: Branch, v: u64) -> Result[Result[ReplaySource, UnknownReason], Error] waits {
    let Some(commit) = recorded_commit(db, b, v)? else {
        return Ok(Error(StateGone))
    }
    let Some(call) = recorded_call(db.store, b, commit) else {
        return claim_source_from_commit(db, b, take commit)
    }
    if call.settle == 2 {
        return Ok(Error(AdmissionRefused))
    }
    if let None = recorded_reply(commit, call.record.stream) {
        return Ok(Error(NotRecorded))
    }
    let Some(take base) = base_roots(db, b, call.base)? else {
        return Ok(Error(StateGone))
    }
    Ok(Ok(ReplaySource(store: db.store, open: open_number(db), commit: take commit, call: take call, base: take base)))
}

// A claim key is `len8 ‖ op ‖ issuer ‖ len8 ‖ subject ‖ len8 ‖ key` (http.md K-4).
pub fn claim_key_parts(claim: Bytes) -> Result[ClaimKey, Error] {
    let op_end = failure_result_from_rep(txn.claim_op_end(claim))?
    let principal_end = failure_result_from_rep(txn.claim_principal_end(claim, op_end))?
    let op = failure_result_from_rep(types.copied(list.slice(claim, 1, op_end)))?
    let subject = failure_result_from_rep(types.copied(list.slice(claim, op_end + 2, principal_end)))?
    let key = failure_result_from_rep(types.copied(list.slice(claim, principal_end + 1, list.len(claim))))?
    Ok(ClaimKey(op: take op, caller: Caller(issuer: claim[op_end], subject: take subject), key: take key))
}

// The keyed call that `v` on main recorded. Its claim key is the key of the
// claims edit that carries the CALL fields, so it is never the entry key.
// The record names the claim's Caller, which the re-run receives as recorded.
fn claim_replay_source(db: Db, v: u64) -> Result[Result[ReplaySource, UnknownReason], Error] waits {
    let b = main_branch(db)
    let Some(take commit) = recorded_commit(db, b, v)? else {
        return Ok(Error(StateGone))
    }
    claim_source_from_commit(db, b, take commit)
}

fn claim_source_from_commit(db: Db, b: Branch, take commit: format.JournalCommit) -> Result[Result[ReplaySource, UnknownReason], Error] waits {
    let mut found: Option[Recorded] = None
    for edit in commit.keyed {
        if let Some(section) = edit.call {
            let context = match section.settlement {
                Some(current) => current,
                None => format.Settlement(way: 0, base: commit.version - 1, at: commit.at, seed: call_info(db.store, b.id, commit.version, commit.at, commit.at).seed, stop: None),
            }
            let parts = claim_key_parts(edit.key)?
            let keyed = keyed_call_record_from_rep(clone(section.record))
            let KeyedCallRecord(entry: take entry_key, args: take args, revision: take revision, code: take code) = take keyed
            let record = CallRecord(key: take entry_key, args: take args, stream: StreamKey(caller: clone(parts.caller), id: StreamId(t: 0, n: 0)), revision: take revision, code: take code)
            found = Some(Recorded(record: take record, claim: Some(failure_result_from_rep(types.copied(edit.key))?), settle: context.way, branch: b, base: context.base, at: context.at, seed: context.seed, stop: optional_stop_kind_from_rep(context.stop)))
            break
        }
    }
    let Some(take call) = take found else {
        return Ok(Error(NotRecorded))
    }
    if call.settle == 2 {
        return Ok(Error(AdmissionRefused))
    }
    let Some(take base) = base_roots(db, b, call.base)? else {
        return Ok(Error(StateGone))
    }
    Ok(Ok(ReplaySource(store: db.store, open: open_number(db), commit: take commit, call: take call, base: take base)))
}

// The reply the recorded run committed: a stream's Replied value, or the
// claim's. Both start with a 41-byte header.
fn replay_source_reply(source: ReplaySource) -> Option[View[Bytes]] in source {
    if let Some(_) = source.call.claim {
        for edit in source.commit.keyed {
            if let Some(_) = edit.call {
                if let Some(raw) = view edit.value {
                    return Some(view raw)
                }
            }
        }
        return None
    }
    recorded_reply(source.commit, source.call.record.stream)
}

// RUNNER-SPEC §7: run on a private copy of the attempted base, under the
// original CallInfo, and compare the committed reply and writes.
fn replay_run(db: Db, registry: indexes.IndexRegistry, source: ReplaySource, plan: Plan, failed: scoped fn(Stop) -> Result[Bytes, Error], body: scoped[view] fn(Recorded, mut Tx) -> Result[Bytes, Bytes]) -> Result[Verdict, Error] waits {
    let call = view source.call
    let ci = CallInfo(id: CallId(store: db.store, branch: call.branch.id, version: call.base + 1), at: call.at, seed: call.seed)
    let reran = rerun(db, registry, source.base, ci, plan, call, body)?
    replay_verdict(source, plan, take reran, failed)
}

fn replay_verdict(source: ReplaySource, plan: Plan, take reran: Rerun[Bytes], failed: scoped fn(Stop) -> Result[Bytes, Error]) -> Result[Verdict, Error] {
    let call = view source.call
    let metered: Rerun[Bytes] = match take reran {
        RanTo(output, _) if list.len(output) > plan.reply_max => Halted(OutOfBytes(Capacity(requested: list.len(output), available: plan.reply_max))),
        take within => take within,
    }
    let rerun_stop: Option[StopKind] = match metered {
        RanTo(_, _) => None,
        Halted(stop) => Some(stop_kind(stop)),
        RoomRefused => return Ok(Unknown(StateGone)),
    }
    if call.stop != rerun_stop {
        return Ok(match (call.stop, rerun_stop) {
            (Some(OutOfSteps(_)), _) => Unknown(Residency),
            (_, Some(OutOfSteps(_))) => Unknown(Residency),
            _ => Different(Reply),
        })
    }
    let (take output, take writes) = match take metered {
        RanTo(take output, take writes) => (take output, take writes),
        Halted(stop) => (failed(stop)?, pages.new_data_rows()),
        RoomRefused => return Ok(Unknown(StateGone)),
    }
    let stored = option.unwrap(replay_source_reply(source))
    if list.len(stored) != 41 + list.len(output) || !list.starts_with_at(stored, 41, output) {
        return Ok(Different(Reply))
    }
    if !failure_result_from_rep(txn.same_writes(writes, source.commit.data))? {
        return Ok(Different(Writes))
    }
    Ok(Same)
}

pub fn reexecute[E: inert](db: Db, b: Branch, v: u64, plan: Plan, failed: fn(Stop) -> Bytes, env: E, body: fn(Recorded, mut Tx, E) -> Result[Bytes, Bytes]) -> Result[Verdict, Error] waits {
    let selected = replay_source(db, b, v)?
    match take selected {
        Ok(take source) => replay_run(db, indexes.index_registry(db.indexes), source, plan, scoped fn(stop: Stop) -> Result[Bytes, Error] {
            Ok(failed(stop))
        }, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
            body(call, mut tx, env)
        }),
        Error(reason) => Ok(Unknown(reason)),
    }
}

// As `reexecute`, for the keyed call main's `v` recorded.
pub fn reexecute_claim[E: inert](db: Db, v: u64, plan: Plan, failed: fn(Stop) -> Bytes, env: E, body: fn(Recorded, mut Tx, E) -> Result[Bytes, Bytes]) -> Result[Verdict, Error] waits {
    let selected = claim_replay_source(db, v)?
    match take selected {
        Ok(take source) => replay_run(db, indexes.index_registry(db.indexes), source, plan, scoped fn(stop: Stop) -> Result[Bytes, Error] {
            Ok(failed(stop))
        }, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
            body(call, mut tx, env)
        }),
        Error(reason) => Ok(Unknown(reason)),
    }
}

// Prepare handles on the same historical catalog the attempt will read.
pub fn prepare_reexecute(db: Db, b: Branch, v: u64) -> Result[Result[ReplaySource, UnknownReason], Error] waits {
    replay_source(db, b, v)
}

// As `prepare_reexecute`, for the keyed call main's `v` recorded.
// `reexecute_with` then runs it; `replay_claim` gives its claim key.
pub fn prepare_reexecute_claim(db: Db, v: u64) -> Result[Result[ReplaySource, UnknownReason], Error] waits {
    claim_replay_source(db, v)
}

pub fn replay_claim(source: ReplaySource) -> Option[Bytes] {
    clone(source.call.claim)
}

fn replay_source_matches(db: Db, source: ReplaySource) -> bool {
    source.store == db.store && source.open == open_number(db)
}

pub fn declare_replay(db: Db, source: ReplaySource) -> Result[Declare, Error] {
    if !replay_source_matches(db, source) {
        return Error(Foreign)
    }
    replay_schema(source, pages.holder_next_node(db.holders), catalog.next_table_id(db.schema), db.accounting.ceiling, db.limits.value, is_disk(db))
}

fn replay_schema(source: ReplaySource, next_node: u64, next_table: u32, ceiling: u64, value: u64, disk: bool) -> Result[Declare, Error] {
    let plan = SchemaPlan(schema: catalog.schema_plan(pages.share_roots(source.base), next_node, next_table, 0, ceiling, true, value), store: source.store, bindings: indexes.empty_bindings(), chunk_freed: None, step_rows: list.new(), step_drift: false, migrate_sources: list.new(), pending_migrates: list.new(), pending_indexes: list.new(), preview: None, staged_map: pages.share_page_tree(source.base.collections))
    Ok(new_declaration(Open, replay_declaration_base(source), take plan, disk))
}

pub fn replay_record(source: ReplaySource) -> Recorded {
    clone(source.call)
}

pub fn reexecute_with[Env: inert](db: Db, source: ReplaySource, take selected: Declare, plan: Plan, failed: fn(Stop) -> Result[Bytes, Error], env: Env, body: fn(Recorded, mut Tx, Env) -> Result[Bytes, Bytes]) -> Result[Verdict, Error] waits {
    let Open = selected.mode else {
        return Error(Foreign)
    }
    if !replay_source_matches(db, source) || !catalog.same_declaration_base(selected.inner, replay_declaration_base(source)) {
        return Error(Foreign)
    }
    complete_declaration(selected)?
    let Declare(plan: SchemaPlan(bindings: take bindings, ..), ..) = take selected
    let registry = indexes.declared_index_registry(take bindings)
    replay_run(db, registry, source, plan, failed, scoped fn(call: Recorded, mut tx: Tx) -> Result[Bytes, Bytes] {
        body(call, mut tx, env)
    })
}

// Run a read-only projection at the recorded base with the same entry bounds.
pub type ReplayProjection[R] = Projected(R) | ProjectionUnavailable(UnknownReason) | ProjectionStopped

pub fn project_recorded[E: inert, R](db: Db, b: Branch, v: u64, plan: Plan, env: E, body: fn(Tx, E) -> R) -> Result[ReplayProjection[R], Error] waits {
    let loaded = replay_source(db, b, v)?
    let source = match take loaded {
        Ok(take retained) => take retained,
        Error(reason) => return Ok(ProjectionUnavailable(reason)),
    }
    let call = view source.call
    let ci = CallInfo(id: CallId(store: db.store, branch: call.branch.id, version: call.base + 1), at: call.at, seed: call.seed)
    let projected = rerun(db, indexes.index_registry(db.indexes), source.base, ci, plan, call, scoped fn(call_record: Recorded, mut tx: Tx) -> Result[R, R] {
        Ok(body(tx, env))
    })?
    match take projected {
        RanTo(take answer, _) => Ok(Projected(take answer)),
        Halted(_) => Ok(ProjectionStopped),
        RoomRefused => Ok(ProjectionUnavailable(AdmissionRefused)),
    }
}

pub type RecordedClaim {
    claim: Bytes,
    call: KeyedCallRecord,
    settle: u8,
    base: u64,
    at: u64,
    seed: u64,
    stop: Option[StopKind]
}

pub fn recorded_claim(db: Db, wanted: u64) -> Result[Option[RecordedClaim], Error] waits {
    let Some(take commit) = recorded_commit(db, main_branch(db), wanted)? else {
        return Ok(None)
    }
    for edit in commit.keyed {
        if let Some(section) = edit.call {
            let context = match section.settlement {
                Some(current) => current,
                None => format.Settlement(way: 0, base: commit.version - 1, at: commit.at, seed: call_info(db.store, 0, commit.version, commit.at, commit.at).seed, stop: None),
            }
            return Ok(Some(RecordedClaim(claim: failure_result_from_rep(types.copied(edit.key))?, call: keyed_call_record_from_rep(clone(section.record)), settle: context.way, base: context.base, at: context.at, seed: context.seed, stop: optional_stop_kind_from_rep(context.stop))))
        }
    }
    Ok(None)
}

fn recorded_reply(commit: format.JournalCommit, stream: StreamKey) -> Option[View[Bytes]] in commit {
    txn.recorded_reply(commit, stream.caller.issuer, stream.caller.subject, stream.id.t, stream.id.n)
}

fn replay_declaration_base(source: ReplaySource) -> catalog.DeclarationBase {
    txn.replay_declaration_base(types.StoreKey(hi: source.store.hi, lo: source.store.lo), source.open, source.call.base, source.base.catalog)
}

pub fn recorded(db: Db, b: Branch, wanted: u64) -> Result[Option[Recorded], Error] waits {
    match recorded_commit(db, b, wanted)? {
        Some(commit) => Ok(recorded_call(db.store, b, commit)),
        None => Ok(None),
    }
}

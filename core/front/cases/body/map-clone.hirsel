// Clones retain live insertion order, own independent buffers, and admit live capacity.
// expect: run empty() = true
// expect: run compacted() = 678
// expect: run strings() = true
// expect: run admission_indices() = true used 32
fn empty() -> bool {
    let m: Map[u64, u64] = map.new()
    let attempt: Result[bool, Capacity] = bound bytes 0 {
        let duplicated: Map[u64, u64] = clone(m)
        map.len(duplicated) == 0
    }
    result.unwrap(attempt)
}

fn compacted() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    for i in 0u64 .. 8u64 {
        map.insert(mut m, i, i + 10)
    }
    for i in 0u64 .. 6u64 {
        let _ = map.remove(mut m, i)
    }
    map.insert(mut m, 8, 18)
    let duplicated: Map[u64, u64] = clone(m)
    let mut order: u64 = 0
    for (k, _) in duplicated {
        order = order * 10 + k
    }
    order
}

// A tombstone is skipped even when no compaction has run; a full removal clones empty.
// expect: run removed() = true
fn removed() -> bool {
    let mut m: Map[u64, u64] = map.new()
    for i in 1u64 .. 5u64 {
        map.insert(mut m, i, i)
    }
    let _ = map.remove(mut m, 2)
    let checked: Result[u64, Capacity] = bound bytes 96 {
        let duplicated: Map[u64, u64] = clone(m)
        let mut order: u64 = 0
        for (k, _) in duplicated {
            order = order * 10 + k
        }
        order
    }
    for i in 1u64 .. 5u64 {
        let _ = map.remove(mut m, i)
    }
    let empty_copy: Result[bool, Capacity] = bound bytes 0 {
        let duplicated: Map[u64, u64] = clone(m)
        map.len(duplicated) == 0
    }
    result.unwrap(checked) == 134 && result.unwrap(empty_copy)
}

fn seed() -> Map[String, String] {
    let mut m: Map[String, String] = map.new()
    map.insert(mut m, string.from("a"), string.from("one"))
    map.insert(mut m, string.from("b"), string.from("two"))
    take m
}

fn strings() -> bool {
    let m = seed()
    let mut duplicated: Map[String, String] = clone(m)
    map.insert(mut duplicated, "a", string.from("new"))
    let _ = map.remove(mut duplicated, "b")
    option.unwrap(map.get(m, "a")) == "one" && option.unwrap(map.get(m, "b")) == "two" && option.unwrap(map.get(duplicated, "a")) == "new" && map.len(duplicated) == 1
}

// A refused clone raises; `used 32` on the run shows every failed prefix, the carrier
// included, refunded its charge, leaving only the caught cause cell.
fn refused(m: Map[String, String], budget: u64, request: u64) -> bool {
    let outer = isolate(fn() -> Result[bool, Capacity] {
        bound bytes budget {
            let attempt: Map[String, String] = clone(m)
            map.len(attempt) == 0
        }
    })
    match caught(take outer) {
        Some(c) => c.requested == request && c.available == 0 && option.unwrap(map.get(m, "b")) == "two",
        None => false
    }
}

fn seed_four() -> Map[String, String] {
    let mut m = seed()
    map.insert(mut m, string.from("c"), string.from("three"))
    map.insert(mut m, string.from("d"), string.from("four"))
    take m
}

fn full_charge(m: Map[String, String], fresh: bool) -> bool {
    let checked: Result[bool, Capacity] = bound bytes 320 {
        let duplicated: Map[String, String] = if fresh {
            seed_four()
        } else {
            clone(m)
        }
        let mut probe: Bytes = list.new()
        let full = match list.try_reserve(mut probe, 1) {
            Ok(()) => false,
            Error(c) => c.requested == 8 && c.available == 0
        }
        full && map.len(duplicated) == 4
    }
    result.unwrap(checked)
}

fn exact_charge(m: Map[String, String]) -> bool {
    let checked: Result[bool, Capacity] = bound bytes 160 {
        let duplicated: Map[String, String] = clone(m)
        let mut probe: Bytes = list.new()
        match list.try_reserve(mut probe, 1) {
            Ok(()) => false,
            Error(c) => c.requested == 8 && c.available == 0 && map.len(duplicated) == 2
        }
    }
    result.unwrap(checked)
}

fn admission_indices() -> bool {
    let m = seed()
    let four = seed_four()
    refused(m, 0, 128) && refused(m, 128, 8) && refused(m, 136, 8) && refused(m, 144, 8) && refused(m, 152, 8) && exact_charge(m) && full_charge(four, false) && full_charge(four, true)
}

type Wrapped {
    m: Map[String, String]
}

// expect: run nested() = true
fn nested() -> bool {
    let original = Wrapped(m: seed())
    let duplicated: Wrapped = clone(original)
    let mut outer: Map[u64, Map[String, String]] = map.new()
    let Wrapped(m: inner) = take duplicated
    map.insert(mut outer, 7, take inner)
    let outer_copy: Map[u64, Map[String, String]] = clone(outer)
    option.unwrap(map.get(option.unwrap(map.get(outer_copy, 7)), "a")) == "one"
}

fn nine() -> u64 {
    9
}

// Holding a noncloneable element must not demand the Map clone body.
// expect: run noncloneable_value() = 9
fn noncloneable_value() -> u64 {
    let mut m: Map[u64, own fn() -> u64] = map.new()
    let f: own fn() -> u64 = nine
    map.insert(mut m, 1, take f)
    let g = option.unwrap(map.get(m, 1))
    g()
}

pub fn main() -> Result[(), Exit] {
    if empty() && removed() && compacted() == 678 && strings() && admission_indices() && nested() && noncloneable_value() == 9 {
        Ok(())
    } else {
        Error(Exit(status: 1))
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

fn span(start: u64, end: u64) -> http1.Span {
    http1.Span(start: start, end: end)
}

fn full(text: String) -> http1.Span {
    span(0, string.byte_len(text))
}

fn recomposes(text: String) -> bool {
    let u = result.unwrap(uri.parse(text))
    let mut out = string.new()
    result.unwrap(uri.push(mut out, text, u))
    out == text
}

fn shift(s: http1.Span, by: u64) -> http1.Span {
    span(s.start + by, s.end + by)
}

fn shift_optional(s: Option[http1.Span], by: u64) -> Option[http1.Span] {
    match s {
        Some(p) => Some(shift(p, by)),
        None => None
    }
}

fn shifted(u: uri.Uri, by: u64) -> uri.Uri {
    let host = match u.host {
        Some(Name(p)) => Some(Name(shift(p, by))),
        Some(Ip6(p)) => Some(Ip6(shift(p, by))),
        None => None
    }
    uri.Uri(scheme: shift_optional(u.scheme, by), userinfo: shift_optional(u.userinfo, by), host: host, port: shift_optional(u.port, by), path: shift(u.path, by), query: shift_optional(u.query, by), fragment: shift_optional(u.fragment, by))
}

fn resolved(base_text: String, reference: String, expected: String, prefix: String) -> bool {
    let base = result.unwrap(uri.parse(base_text))
    let r = result.unwrap(uri.parse(reference))
    let want = result.unwrap(uri.parse(expected))
    let mut out = result.unwrap(string.from(prefix))
    let target = result.unwrap(uri.resolve(base_text, base, reference, r, mut out))
    let at = string.byte_len(prefix)
    recomposes(reference) && recomposes(expected) && target == shifted(want, at) && string.slice(out, 0, at) == prefix && string.slice(out, at, string.byte_len(out)) == expected
}

fn rfc_row(reference: String, expected: String, prefix: String) -> bool {
    resolved("http://a/b/c/d;p?q", reference, expected, prefix)
}

// RFC Editor, rfc3986.txt (January 2005), RFC text, §5.4.1.
fn rfc_normal_rows(prefix: String) -> bool {
    for (reference, expected) in[
    // Absolute references, path replacement, and new authority.
    ("g:h", "g:h"), ("g", "http://a/b/c/g"), ("./g", "http://a/b/c/g"), ("g/", "http://a/b/c/g/"), ("/g", "http://a/g"), ("//g", "http://g"),
    // Query and fragment inheritance.
    ("?y", "http://a/b/c/d;p?y"), ("g?y", "http://a/b/c/g?y"), ("#s", "http://a/b/c/d;p?q#s"), ("g#s", "http://a/b/c/g#s"), ("g?y#s", "http://a/b/c/g?y#s"),
    // Path parameters and the empty reference.
    (";x", "http://a/b/c/;x"), ("g;x", "http://a/b/c/g;x"), ("g;x?y#s", "http://a/b/c/g;x?y#s"), ("", "http://a/b/c/d;p?q"),
    // Whole dot segments.
    (".", "http://a/b/c/"), ("./", "http://a/b/c/"), ("..", "http://a/b/"), ("../", "http://a/b/"), ("../g", "http://a/b/g"), ("../..", "http://a/"), ("../../", "http://a/"), ("../../g", "http://a/g"),] {
        if !rfc_row(reference, expected, prefix) {
            return false
        }
    }
    true
}

// RFC Editor, rfc3986.txt (January 2005), RFC text, §5.4.2 (strict http:g result).
fn rfc_abnormal_rows(prefix: String) -> bool {
    for (reference, expected) in[
    // Parents above the root.
    ("../../../g", "http://a/g"), ("../../../../g", "http://a/g"),
    // Complete dot segments and ordinary names containing dots.
    ("/./g", "http://a/g"), ("/../g", "http://a/g"), ("g.", "http://a/b/c/g."), (".g", "http://a/b/c/.g"), ("g..", "http://a/b/c/g.."), ("..g", "http://a/b/c/..g"),
    // Dot segments around names and path parameters.
    ("./../g", "http://a/b/g"), ("./g/.", "http://a/b/c/g/"), ("g/./h", "http://a/b/c/g/h"), ("g/../h", "http://a/b/c/h"), ("g;x=1/./y", "http://a/b/c/g;x=1/y"), ("g;x=1/../y", "http://a/b/c/y"),
    // Query and fragment bytes remain literal.
    ("g?y/./x", "http://a/b/c/g?y/./x"), ("g?y/../x", "http://a/b/c/g?y/../x"), ("g#s/./x", "http://a/b/c/g#s/./x"), ("g#s/../x", "http://a/b/c/g#s/../x"),
    // Strict scheme interpretation.
    ("http:g", "http:g"),] {
        if !rfc_row(reference, expected, prefix) {
            return false
        }
    }
    true
}

fn scheme_rows(prefix: String) -> bool {
    rfc_row("http://a/b/../c", "http://a/c", prefix) && rfc_row("HTTP:./g", "HTTP:g", prefix)
}

// U1. RFC 3986 §5.4.1, rfc3986.txt:1967-1991.
// Mutant: append the reference after the entire base path.
// expect: run rfc_normal() = true
fn rfc_normal() -> bool {
    rfc_normal_rows("")
}

// U1. RFC 3986 §5.4.2, rfc3986.txt:1993-2063.
// Mutant: run dot removal over the query or fragment, or split on ';'.
// expect: run rfc_abnormal() = true
fn rfc_abnormal() -> bool {
    rfc_abnormal_rows("")
}

// U1. RFC 3986 §5.2.2, rfc3986.txt:1745-1796, and Zig Uri.zig:466-471.
// Mutants: copy a reference with a scheme verbatim, omit '/' on an empty
// authoritative base path, or collapse ordinary empty path segments.
// expect: run resolution_branch_edges() = true
fn resolution_branch_edges() -> bool {
    scheme_rows("") && resolved("x://h", "g", "x://h/g", "") && resolved("x:a", "g", "x:g", "") && resolved("x:/a/b/c/d", "./../../g", "x:/a/g", "") && resolved("x://h/a//b", "../%2e/x", "x://h/a/%2e/x", "") && resolved("x://h/a//b", "g", "x://h/a//g", "") && resolved("x://h/a?b#c", "?", "x://h/a?", "") && resolved("x://h/a?q", "//u:@[::1]:080/p?#", "x://u:@[::1]:080/p?#", "pre")
}

// U2. RFC 3986 §4.1, rfc3986.txt:1452-1461. Mutant: collapse empty components.
// expect: run presence() = true
fn presence() -> bool {
    let bare = result.unwrap(uri.parse("http://h"))
    let empty_query = result.unwrap(uri.parse("http://h?"))
    let empty_fragment = result.unwrap(uri.parse("http://h#"))
    let empty_port = result.unwrap(uri.parse("http://h:"))
    let no_authority = result.unwrap(uri.parse("http:"))
    let no_scheme = result.unwrap(uri.parse("//h"))
    bare.host == Some(Name(span(7, 8))) && bare.port == None && bare.query == None && bare.fragment == None && empty_query.query == Some(span(9, 9)) && empty_fragment.fragment == Some(span(9, 9)) && empty_port.port == Some(span(9, 9)) && uri.port_number("http://h:", empty_port) == None && no_authority.host == None && no_authority.path == span(5, 5) && no_scheme.scheme == None && no_scheme.host == Some(Name(span(2, 3))) && recomposes("http://h") && recomposes("http://h?") && recomposes("http://h#") && recomposes("http://h:") && recomposes("http:") && recomposes("//h")
}

// Go src/net/url/url_test.go, 46b62495e1bf4d56e0313320772ae588d9119aed.
// Copyright 2009 The Go Authors. BSD-3-Clause, see vectors/go-LICENSE.
// These RFC 3986 inputs retain their original bytes through parse and push.
// expect: run go_round_trips() = true
fn go_round_trips() -> bool {
    for input in[
    // Ordinary paths, escaped components, and user information.
    "http://www.google.com", "http://www.google.com/", "http://www.google.com/file%20one%26two", "http://www.google.com/#file%20one%26two", "ftp://webmaster@www.google.com/", "ftp://john%20doe@www.google.com/",
    // Empty queries, literal plus, and opaque paths.
    "http://www.google.com/?", "http://www.google.com/?foo=bar?", "http://www.google.com/?q=go+language", "http://www.google.com/?q=go%20language", "http://www.google.com/a%20b?q=c+d", "http:www.google.com/?q=go+language", "http:%2f%2fwww.google.com/?q=go+language",
    // References with and without an authority.
    "mailto:/webmaster@golang.org", "mailto:webmaster@golang.org", "/foo?query=http://bad", "//foo", "//user@foo/path?a=b", "///threeslashes",
    // User information and fragments.
    "http://user:password@google.com", "http://www.google.com/?q=go+language#foo", "http://www.google.com/?q=go+language#foo&bar", "http://www.google.com/?q=go+language#foo%26bar",
    // Empty hosts, raw scheme spelling, and IPv4 reg-names.
    "file:///home/adg/rabbits", "file:///C:/FooBar/Baz.txt", "MaIlTo:webmaster@golang.org", "a/b/c", "http://%3Fam:pa%3Fsword@google.com", "http://192.168.0.1/", "http://192.168.0.1:8080/",
    // Bracketed IPv6 and raw escaped paths.
    "http://[fe80::1]/", "http://[fe80::1]:8080/", "https://[2001:db8::1]:8443/test/path", "http://rest.rsc.io/foo%2fbar/baz%2Fquux?alt=media", "mysql://a,b,c/bar", "scheme://!$&'()*+,;=hello!:1/path",
    // Present, empty, and absent ports and escaped reg-names.
    "http://192.168.0.2:8080/foo", "http://192.168.0.2:/foo", "http://[2b01:e34:ef40:7730:8e70:5aff:fefe:edac]:8080/foo", "http://[2b01:e34:ef40:7730:8e70:5aff:fefe:edac]:/foo", "http://hello.%e4%b8%96%e7%95%8c.com/foo", "http://hello.%E4%B8%96%E7%95%8C.com/foo",
    // Repeated separators and opaque URIs.
    "http://example.com//foo", "magnet:?xt=urn:btih:c12fe1c06bba254a9dc9f519b335aa7c1367a88a&dn", "mailto:?subject=hi",] {
        if !recomposes(input) {
            return false
        }
    }
    true
}

// Go src/net/url/url_test.go, 46b62495e1bf4d56e0313320772ae588d9119aed.
// Copyright 2009 The Go Authors. BSD-3-Clause, see vectors/go-LICENSE.
// TestInvalidParse, excluding the bare colon already covered by rejects_strictly.
// expect: run go_rejects_invalid_references() = true
fn go_rejects_invalid_references() -> bool {
    for input in["http://example.com/\0", "http://example.com/\t", "http://example.com/%zz", "http://example.com:port", "http://[::1/",] {
        if let Ok(_) = uri.parse(input) {
            return false
        }
    }
    true
}

// Go src/net/url/url_test.go, 46b62495e1bf4d56e0313320772ae588d9119aed.
// Copyright 2009 The Go Authors. BSD-3-Clause, see vectors/go-LICENSE.
// resolveReferenceTests rows for escaped slashes and consecutive separators.
// expect: run go_resolves_escaped_paths() = true
fn go_resolves_escaped_paths() -> bool {
    for (base, reference, expected) in[
    // Preserve repeated raw slashes in an absolute reference.
    ("http://foo.com/bar", "http://foo.com///baz/quux", "http://foo.com///baz/quux"),
    // Split directory components only at literal slashes.
    ("http://foo.com/foo%2fbar/", "../baz", "http://foo.com/baz"), ("http://foo.com/1/2%2f/3%2f4/5", "../../a/b/c", "http://foo.com/1/a/b/c"), ("http://foo.com/1/2/3", "./a%2f../../b/..%2fc", "http://foo.com/1/2/b/..%2fc"), ("http://foo.com/1/2%2f/3%2f4/5", "./a%2f../b/../c", "http://foo.com/1/2%2f/3%2f4/a%2f../c"),
    // Preserve escaped byte spelling through a merge.
    ("http://foo.com/foo%20bar/", "../baz", "http://foo.com/baz"), ("http://foo.com/foo", "../bar%2fbaz", "http://foo.com/bar%2fbaz"), ("http://foo.com/foo%2dbar/", "./baz-quux", "http://foo.com/foo%2dbar/baz-quux"),] {
        if !resolved(base, reference, expected, "") {
            return false
        }
    }
    true
}

fn host_is(text: String, expected: String) -> bool {
    let u = result.unwrap(uri.parse(text))
    match u.host {
        Some(Name(s)) => string.slice(text, s.start, s.end) == expected && recomposes(text),
        _ => false
    }
}

// U2. Zig Uri.zig:541-701, 710-791. Mutants: split userinfo on ':', reject
// empty authority, or apply a DNS length limit to an RFC 3986 reg-name.
// expect: run zig_components() = true
fn zig_components() -> bool {
    let text = "foo://example.com:8042/over/there?name=ferret#nose"
    let u = result.unwrap(uri.parse(text))
    let user = result.unwrap(uri.parse("scheme://username::@a"))
    let long_host = result.unwrap(string.repeat("Z", 256))
    let mut long_uri = result.unwrap(string.from("http://"))
    result.unwrap(string.push(mut long_uri, long_host))
    u.scheme == Some(span(0, 3)) && u.host == Some(Name(span(6, 17))) && u.port == Some(span(18, 22)) && uri.port_number(text, u) == Some(8042u16) && u.path == span(22, 33) && u.query == Some(span(34, 45)) && u.fragment == Some(span(46, 50)) && user.userinfo == Some(span(9, 19)) && host_is("scheme://username::@a", "a") &&
    // Userinfo stays one component and a present empty host retains its span.
    host_is("scheme://userinfo@", "") && host_is("foobar://", "") && host_is("file:///", "") && host_is("file:///an/absolute/path/to/something", "") && host_is("file://localhost/an/absolute/path/to/another/thing/", "localhost") &&
    // RFC 3986 puts no DNS name-length cap on the reg-name grammar.
    host_is(long_uri, long_host) &&
    // DNS and ambiguous numeric hosts are classified by the transport.
    host_is("http://0x7f.0.0.1", "0x7f.0.0.1") && host_is("scheme://127.0.0.1", "127.0.0.1") && recomposes("https://ziglang.org/download") && recomposes("http://example:1337/") && recomposes("a.b.c:_") && recomposes("http:_") && recomposes("scheme-mee:_") && recomposes("ab+:_") && recomposes("X+++:_") && recomposes("Y+-.:_") && recomposes("scheme://userinfo@hostname:1234") && recomposes("scheme://user:password@hostname:1234") && recomposes("scheme://hostname") && recomposes("scheme://userinfo@hostname") && recomposes("scheme://user:password@hostname") && recomposes("scheme://hostname:1234") && recomposes("scheme://username@a") && recomposes("scheme://username:@a") && recomposes("scheme://username:password@a") && recomposes("scheme://hostname:0") && recomposes("file:/an/absolute/path") && recomposes("file:/foo/bar/baz") && recomposes("urn:example:animal:ferret:nose") && recomposes("https://john.doe@www.example.com:123/forum/questions/?tag=networking&order=newest#top") && recomposes("ldap://[2001:db8::7]/c=GB?objectClass?one") && recomposes("mailto:John.Doe@example.com") && recomposes("news:comp.infosystems.www.servers.unix") && recomposes("tel:+1-816-555-1212") && recomposes("telnet://192.0.2.16:80/") && recomposes("urn:oasis:names:specification:docbook:dtd:xml:4.1.2") && recomposes("https://www.youtube.com/watch?v=dQw4w9WgXcQ&feature=youtu.be&t=0") && recomposes("https://objects.githubusercontent.com/?response-content-type=application%2Foctet-stream")
}


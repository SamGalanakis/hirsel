// rule: STORE-11
// expect: run
// authorities: {"c1":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"crash_at":1}},"c2":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"crash_at":2}},"c3":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"crash_at":3}},"c4":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"crash_at":4}},"c5":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"crash_at":5}},"c6":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"crash_at":6}}}
// steps: 20000000
// Checkpoints of several nodes (bounds 64 to 1024 bytes) over a simulated log
// whose history is cut at an authority request; authority `cN` fails the power right after request N's answer.
// The one level is disk and the floor, so an Ok commit is durable.
// The history is fixed: open a store; commit 1 puts 40 values of 16 bytes;
// compact; commit 3 rewrites one value, so the next checkpoint shares every
// leaf away from that value with this one; commit 4 inserts five keys and deletes one
// mid-range; compact; commit 6 deletes five keys and rewrites one; close.
// After each cut the store reopens holding exactly the model's rows after some
// step j, j at least the last step that returned Ok and at most the last that
// may have happened. The history then finishes from the step after j, its
// compactions putting nodes the cut one may already have put, and a reopen
// holds the model's end state. A cut between two node puts leaves nodes no
// record names, and recovery uses the checkpoint before them.
// Every `cN` up to the history's last request stops the history there, and
// the first one past it lets the history finish, which ends the sweep; that
// history's last checkpoint has height 2 or more.
// This case makes the cuts at requests 1 to 6.
// stdout: checkpoints: 0

// The cut this case makes at each request.
const KIND: String = "c"

// The first request this case cuts, and the last (0: to the history's end).
const FIRST: u64 = 1

const LAST: u64 = 6

// Whether the cuts fall on a reopen after the history rather than in it.
const LOAD: bool = false

// A value of `len` bytes, each `fill`, built by doubling.
fn value(fill: u8, len: u64) -> Bytes {
  let mut out: List[u8] = [fill]
  while list.len(out) * 2 <= len {
    let half = bytes.from_list(copy out)
    bytes.append(mut out, half)
  }
  let have = list.len(out)
  if have < len {
    let head = bytes.from_list(copy out)
    bytes.append(mut out, bytes.slice(head, 0, len - have))
  }
  bytes.from_list(take out)
}

// Keys of 4 bytes, `m/NN`.
fn key(i: u8) -> Bytes {
  bytes.from_list([109u8, 47u8, 48u8 + i / 10, 48u8 + i % 10])
}

// One write of a step: the key, and the fill and length of its value, or a
// deletion when the length is 0.
type Write {
  key: Bytes,
  fill: u8,
  len: u64,
}

// The writes of step j; compactions (2 and 5) write nothing. Step 3 rewrites
// one value, so every leaf but one is the same node again; step 4 inserts and
// deletes keys mid-range, so some leaf boundaries move; step 6 deletes a run.
fn writes(j: u8) -> List[Write] {
  let mut w: List[Write] = []
  if j == 1 {
    for i in 0u8..80u8 {
      if i % 2 == 0 {
        list.push(mut w, Write(key: key(i), fill: i, len: 16))
      }
    }
  } else if j == 3 {
    list.push(mut w, Write(key: key(40), fill: 200, len: 16))
  } else if j == 4 {
    for i in 21u8..30u8 {
      if i % 2 == 1 {
        list.push(mut w, Write(key: key(i), fill: 100 + i, len: 11))
      }
    }
    list.push(mut w, Write(key: key(62), fill: 0, len: 0))
  } else if j == 6 {
    for i in 50u8..60u8 {
      list.push(mut w, Write(key: key(i), fill: 0, len: 0))
    }
    list.push(mut w, Write(key: key(0), fill: 7, len: 3))
  }
  w
}

fn compaction(j: u8) -> bool {
  j == 2 || j == 5
}

const STEPS: u8 = 6

fn step(mut tx: store.Tx, info: store.CallInfo, j: u8) -> Result[u8, store.TxError] {
  for w in writes(j) {
    if w.len == 0 {
      store.tx_delete(mut tx, copy w.key)?
    } else {
      store.tx_put(mut tx, copy w.key, value(w.fill, w.len))?
    }
  }
  Ok(j)
}

// The model: the keys after step j, ascending, each with its value's fill and
// length.
fn want(j: u8) -> List[Write] {
  let mut m: List[Write] = []
  for i in 1u8..j + 1 {
    for w in writes(i) {
      let mut next: List[Write] = []
      let mut placed = false
      for old in m {
        if !placed && w.key <= old.key {
          if w.len > 0 {
            list.push(mut next, copy w)
          }
          placed = true
          if w.key != old.key {
            list.push(mut next, copy old)
          }
        } else {
          list.push(mut next, copy old)
        }
      }
      if !placed && w.len > 0 {
        list.push(mut next, copy w)
      }
      m = take next
    }
  }
  m
}

// Limits under the defaults, so checkpoint nodes of 64 to 1024 bytes fit
// them: 40 entries of 4-byte keys and 16-byte values make a tree of height 2
// or more, where the default bounds hold them in one leaf.
fn config() -> store.StoreConfig {
  let mut c = store.default_config()
  c.limits.key_bytes = 8
  c.limits.value_bytes = 16
  c.limits.transaction_bytes = 4096
  c.nodes = history.Bounds(node_min: 64, node_mean: 128, node_max: 1024)
  c
}

// The height of the newest checkpoint `a`'s history records, 0 if none. The
// run's one cut may fall on the first read, so a refused read is tried again.
fn height(a: Authority) -> u8 {
  let records = match authority.read(a, 1, authority.floor(a), 4096) {
    Ok(r) => r,
    Error(_) => {
      let Ok(r) = authority.read(a, 1, authority.floor(a), 4096) else {
        return 0
      }
      r
    },
  }
  let mut h: u8 = 0
  for r in records {
    if let Appended(entry) = r {
      if let Ok(g) = history.decode_group(entry) {
        for c in g.commits {
          if let Engine(Checkpoint(d)) = c.body {
            h = d.height
          }
        }
      }
    }
  }
  h
}

pub type Failed = Check(String) | Store(store.StoreError)

fn check(ok: bool, take what: String) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check(what))
  }
}

// Every user row of the store's state at its floor.
fn rows(a: Authority, mut s: store.Store) -> Result[List[(Bytes, Bytes)], Failed] {
  let snap = store.snapshot(a, mut s, authority.floor(a)) ? Store
  let mut user: List[(Bytes, Bytes)] = []
  for (k, v) in store.range(snap, Unbounded(), Unbounded(), Ascending(), 100) {
    if !store.reserved(k) {
      list.push(mut user, (copy k, copy v))
    }
  }
  Ok(user)
}

// The model's rows after every step, 0 to STEPS, worked out once.
type Models = List[List[(Bytes, Bytes)]]

fn models() -> Models {
  let mut all: Models = []
  for j in 0u8..STEPS + 1 {
    let mut r: List[(Bytes, Bytes)] = []
    for w in want(j) {
      list.push(mut r, (copy w.key, value(w.fill, w.len)))
    }
    list.push(mut all, take r)
  }
  all
}

// Whether the rows are the model's after step j.
fn holds(m: Models, r: List[(Bytes, Bytes)], j: u8) -> bool {
  let at: u64 = int.widen(j)
  r == m[at]
}

// The step whose model the rows are, the commit when a compaction after it
// shares its model, so finishing from there compacts again over the nodes
// already put; 255 when they are no step's.
fn which(m: Models, r: List[(Bytes, Bytes)]) -> u8 {
  for j in 0u8..STEPS + 1 {
    if holds(m, r, j) {
      return j
    }
  }
  255
}

// What the history learned: `low`, the last step an Ok covered (the floor is
// the one level, so an Ok commit is durable), and `high`, the last step that
// may have happened.
type Known {
  low: u8,
  high: u8,
  finished: bool,
}

// Runs steps from `first` on, stopping at the first failure.
fn steps_from(mut s: store.Store, mut k: Known, first: u8) -> bool {
  for j in first..STEPS + 1 {
    if compaction(j) {
      if store.compact(mut s) != Ok(()) {
        return false
      }
      k.low = j
      k.high = j
    } else {
      let r: Result[u8, store.TxFailure[store.TxError]] = store.transact(mut s, step, j)
      match r {
        Ok(_) => {
          k.low = j
          k.high = j
        },
        Error(Unknown(_)) => {
          k.high = j
          return false
        },
        _ => return false,
      }
    }
  }
  true
}

// The fixed history.
fn history(a: Authority, mut k: Known) -> () {
  let Ok(opened) = store.open(a, config()) else {
    return ()
  }
  let mut s = take opened
  if !steps_from(mut s, mut k, 1) {
    return ()
  }
  if store.close(take s) == Ok(()) {
    k.finished = true
  }
}

fn reopen(a: Authority, name: String, what: String) -> Result[store.Store, Failed] {
  match store.open(a, config()) {
    Ok(s) => Ok(s),
    Error(_) => Error(Check(f"{name}: {what} refused")),
  }
}

// Recovers the store a cut history left and checks it against `k`, then
// finishes the history from the recovered step and checks the end state.
fn recover(m: Models, a: Authority, name: String, k: Known) -> Result[(), Failed] {
  let mut s = reopen(a, name, "reopen")?
  let seen = rows(a, mut s)?
  let j = which(m, seen)
  check(
    j != 255,
    f"{name}: {list.len(seen)} rows, no step's state, history {k.low}..{k.high}"
  )?
  // Rows that are a compaction's state are also its commit's.
  let low = if compaction(k.low) {
    k.low - 1
  } else {
    k.low
  }
  check(
    low <= j && j <= k.high,
    f"{name}: recovered step {j} outside {k.low}..{k.high}"
  )?
  let mut rest = Known(low: j, high: j, finished: false)
  check(steps_from(mut s, mut rest, j + 1), f"{name}: finishing from step {j} failed")?
  store.close(take s) ? Store
  let mut last = reopen(a, name, "last reopen")?
  let end = rows(a, mut last)?
  check(
    holds(m, end, STEPS),
    f"{name}: finished from step {j}, {list.len(end)} rows, not the end state"
  )?
  Ok(())
}

// Reopens a finished history whose cut falls on the reopen: the open is
// refused or holds the end state, and the next open holds it.
fn load(m: Models, a: Authority, name: String) -> Result[(), Failed] {
  if let Ok(opened) = store.open(a, config()) {
    let mut s = take opened
    if let Ok(seen) = rows(a, mut s) {
      check(
        holds(m, seen, STEPS),
        f"{name}: the cut reopen holds {list.len(seen)} rows, not the end state"
      )?
    }
    let _ = store.close(take s)
  }
  let mut last = reopen(a, name, "reopen after the cut")?
  let end = rows(a, mut last)?
  check(
    holds(m, end, STEPS),
    f"{name}: reopen after the cut, {list.len(end)} rows, not the end state"
  )?
  Ok(())
}

pub fn main(rt: Io) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Check("stdout"))
  }
  let r = sweep(rt, stdout)
  if let Error(Check(what)) = r {
    let _ = out.print(stdout, f"{what}\n")
  }
  r
}

fn sweep(rt: Io, stdout: Stdout) -> Result[(), Failed] {
  let m = models()
  let mut failures: u64 = 0
  let mut n: u64 = FIRST
  let mut last = false
  while !last && (LAST == 0 || n <= LAST) {
    let name = f"{KIND}{n}"
    let Ok(a) = io.authority(rt, name) else {
      return Error(Check(f"{name} not granted: the history is longer than the grants"))
    }
    let mut cut = Known(low: 0, high: 0, finished: false)
    history(a, mut cut)
    if cut.finished && LOAD {
      // The cut falls on the reopen's reads, level by level down the tree.
      if let Error(e) = load(m, a, name) {
        failures += 1
        let line = match e {
          Check(what) => what,
          Store(_) => f"{name}: store error",
        }
        let _ = out.print(stdout, f"{line}\n")
      }
    } else if cut.finished {
      // Every cut stops the history at its request, so a history that
      // finished had none: request n is past its end.
      last = true
      check(n > FIRST, f"request {FIRST} was not cut")?
      let h = height(a)
      check(h >= 2, f"the last checkpoint has height {h}, not a tree of nodes")?
    } else if LOAD {
      return Error(Check(f"{name} cut the history: the load cuts start too early"))
    } else if let Error(e) = recover(m, a, name, cut) {
      failures += 1
      let line = match e {
        Check(what) => what,
        Store(_) => f"{name}: store error",
      }
      let _ = out.print(stdout, f"{line}\n")
    }
    n += 1
  }
  let _ = out.print(stdout, f"checkpoints: {failures}\n")
  Ok(())
}

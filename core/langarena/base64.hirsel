// kostya/LangArena 3c9f84d benchmarks/base64_{encode,decode}.rs.
// Scalar RFC 4648 codec; the matched Rust twin uses the same byte loops.
fn encode(s:String)->Result[String,helper.Error] {
    let table="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let alphabet=string.as_bytes(table)
    let input_bytes=string.as_bytes(s)
    let n=list.len(input_bytes)
    let mut result=helper.mem(string.with_capacity(((n+2)/3)*4))?
    let mut i:u64=0
    while i<n {
        let a:u32=int.widen(input_bytes[i])
        let b:u32=if i+1<n {int.widen(input_bytes[i+1])} else {0}
        let c:u32=if i+2<n {int.widen(input_bytes[i+2])} else {0}
        let word=(a<<16u32)|(b<<8u32)|c
        for shift in 0u32 .. 4u32 {
            let digit=(word>>(18u32-shift*6u32))&63u32
            let code:u32=if shift==2 && i+1>=n || shift==3 && i+2>=n {61} else {int.widen(alphabet[int.widen(digit)])}
            helper.mem(string.push_char(mut result,option.unwrap(char.from_u32(code))))?
        }
        i+=3
    }
    Ok(take result)
}
fn decode_digit(b:u8)->Result[u32,helper.Error] {
    if b>=b'A' && b<=b'Z' {return Ok(int.widen(b-b'A'))}
    if b>=b'a' && b<=b'z' {let d:u32=int.widen(b-b'a');return Ok(d+26)}
    if b>=b'0' && b<=b'9' {let d:u32=int.widen(b-b'0');return Ok(d+52)}
    if b==b'+' {return Ok(62)}
    if b==b'/' {return Ok(63)}
    Error(Config)
}
fn decode(s:String)->Result[Bytes,helper.Error] {
    let b=string.as_bytes(s)
    let n=list.len(b)
    if n%4!=0 {return Error(Config)}
    let mut out:Bytes=helper.mem(list.with_capacity(n/4*3))?
    let mut at:u64=0
    while at<n {
        let a=decode_digit(b[at])?
        let c=decode_digit(b[at+1])?
        let d=if b[at+2]==b'=' {0u32} else {decode_digit(b[at+2])?}
        let e=if b[at+3]==b'=' {0u32} else {decode_digit(b[at+3])?}
        if b[at+2]==b'=' && (b[at+3]!=b'=' || at+4!=n || c&15!=0) {return Error(Config)}
        if b[at+3]==b'=' && (at+4!=n || d&3!=0) {return Error(Config)}
        let word=(a<<18u32)|(c<<12u32)|(d<<6u32)|e
        let _=list.push(mut out,int.truncate(word>>16u32))
        if b[at+2]!=b'=' {let _=list.push(mut out,int.truncate(word>>8u32))}
        if b[at+3]!=b'=' {let _=list.push(mut out,int.truncate(word))}
        at+=4
    }
    Ok(take out)
}
fn prefix(mut message:String,s:String)->Result[(),helper.Error] {
    if string.byte_len(s)>4 {
        helper.mem(string.push(mut message,string.slice(s,0,4)))?
        helper.mem(string.push(mut message,"..."))?
    } else {helper.mem(string.push(mut message,s))?}
    Ok(())
}
pub fn dispatch(config:String,name:String,warmup:u64,iterations:u64)->Result[u32,helper.Error] {
    let decoding=name=="Base64::Decode"
    if !decoding && name!="Base64::Encode" {return Error(UnknownTask)}
    let size=helper.config_i64(config,name,"size")?
    if size<0 {return Error(Config)}
    let mut data=helper.mem(string.with_capacity(int.narrow(size)))?
    for _ in 0 .. size {helper.mem(string.push(mut data,"a"))?}
    let mut encoded=encode(data)?
    let mut decoded=if decoding {decode(encoded)?} else {list.new()}
    let mut total:u32=0
    for _ in 0 .. warmup+iterations {
        if decoding {
            decoded=decode(encoded)?
            total=int.wrapping_add(total,int.truncate(list.len(decoded)))
        } else {
            encoded=encode(data)?
            total=int.wrapping_add(total,int.truncate(string.byte_len(encoded)))
        }
    }
    let mut message=helper.mem(string.from(if decoding {"decode "} else {"encode "}))?
    if decoding {prefix(mut message,encoded)?} else {prefix(mut message,data)?}
    helper.mem(string.push(mut message," to "))?
    if decoding {
        if list.len(decoded)<4 {return Error(Config)}
        for at in 0u64 .. 4u64 {
            helper.mem(string.push_char(mut message,option.unwrap(char.from_u32(int.widen(decoded[at])))))?
        }
        helper.mem(string.push(mut message,"..."))?
    } else {prefix(mut message,encoded)?}
    helper.mem(string.push(mut message,": "))?
    helper.mem(string.push_u64(mut message,int.widen(total)))?
    Ok(helper.checksum_str(message))
}
pub fn main(out:Stdout,d:Dir,argv:Args)->Result[(),Exit] waits {
    harness.main(out,d,argv,fn(c:String,n:String,w:u64,i:u64)->Result[u32,helper.Error] {dispatch(c,n,w,i)})
}

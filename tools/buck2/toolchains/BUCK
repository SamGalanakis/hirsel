load("@prelude//toolchains:cxx.bzl", "cxx_tools_info_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load(":llvm.bzl", "llvm_cxx_tools", "llvm_tree", "source_files")
load(":rust.bzl", "rust_toolchain", "trace_std")

# Both trees are ignored local state that tools/buck2/bootstrap.py installs.
RUST_FILES = {p.removeprefix("rust-files/"): p for p in glob(["rust-files/**"], exclude = [
    "rust-files/lib/rustlib/src/**",
    "rust-files/lib/rustlib/aarch64-apple-darwin/**",
])}
RUST_TARGET = select({
    "prelude//os:macos": "aarch64-apple-darwin",
    "DEFAULT": select({
        "prelude//cpu:arm64": "aarch64-unknown-linux-gnu",
        "DEFAULT": "x86_64-unknown-linux-gnu",
    }),
})

# aarch64-apple-darwin is cross-built for the runtime archives only
# (root//tools/buck2:runtime-darwin). Its floor is the link kit's DARWIN_FLOOR
# (tools/buck2/native-toolchain/link_kit.py): rustc stamps it into every object
# through MACOSX_DEPLOYMENT_TARGET, clang through its --target.
DARWIN_FLOOR = "26.0"

# The Darwin target's std (toolchain-lock.json rust-std-darwin) joins only the
# Darwin sysroot. Every Darwin build is a runtime build, whose std is
# :trace-std, so the prebuilt libstd is left out and only its dependencies remain.
DARWIN_STD = {p.removeprefix("rust-files/"): p for p in glob(
    ["rust-files/lib/rustlib/aarch64-apple-darwin/lib/*"],
    exclude = ["rust-files/lib/rustlib/aarch64-apple-darwin/lib/libstd-*"],
)}

TARGET_STD = select({
    "prelude//os:macos": DARWIN_STD,
    "DEFAULT": {},
})

trace_std(
    name = "trace-std",
    srcs = RUST_FILES,
    std_sources = "rust-files/lib/rustlib/src/rust/library",
    target_triple = RUST_TARGET,
    target_std = TARGET_STD,
    script = "raw_backtrace_std.py",
    panic_image = select({
        "prelude//os:macos": "panic_image_darwin.rs",
        "DEFAULT": "panic_image.rs",
    }),
    exec_compatible_with = ["root//tools/buck2:pool_1_1048576"],
)

rust_toolchain(
    name = "rust",
    srcs = RUST_FILES,
    target_triple = RUST_TARGET,
    target_std = TARGET_STD,
    deployment_target = select({
        "prelude//os:macos": DARWIN_FLOOR,
        "DEFAULT": None,
    }),
    runtime_std = select({
        "root//tools/buck2:profile_runtime": ":trace-std",
        "DEFAULT": None,
    }),
    visibility = ["PUBLIC"],
)

# Everything clang and lld need to run: the C toolchain and every link.
llvm_tree(
    name = "clang",
    srcs = {p.removeprefix("llvm-files/"): p for p in glob([
        "llvm-files/bin/clang",
        "llvm-files/bin/clang++",
        "llvm-files/bin/hirsel-clang",
        "llvm-files/bin/hirsel-clang++",
        "llvm-files/bin/hirsel-llvm-ar",
        "llvm-files/bin/clang-23",
        "llvm-files/bin/ld.lld",
        "llvm-files/bin/lld",
        "llvm-files/bin/llvm-ar",
        "llvm-files/bin/llvm-objcopy",
        "llvm-files/lib/*.so.*",
        "llvm-files/lib/clang/**",
    ])},
    visibility = ["PUBLIC"],
)

# The whole pinned tree, as tools and tests that name LLVM_SYS_231_PREFIX see it.
llvm_tree(
    name = "llvm",
    srcs = {p.removeprefix("llvm-files/"): p for p in glob(["llvm-files/**"], exclude = ["llvm-files/.hirsel-llvm.json"])},
    visibility = ["PUBLIC"],
)

# The shared libraries first-party binaries load (the engine libLLVM and the
# libraries bundled for the tree), for tests on the pool to carry at their
# source paths.
source_files(
    name = "llvm-libraries",
    srcs = glob(["llvm-files/engine/*.so*", "llvm-files/lib/*.so*"]),
    visibility = ["PUBLIC"],
)

export_file(
    name = "engine-llvm",
    src = "llvm-files/engine/libLLVM.so.23.1",
    visibility = ["PUBLIC"],
)

llvm_cxx_tools(name = "cxx_tools", tree = ":clang", fixed_build_date = "fixed-build-date")
llvm_cxx_tools(
    name = "cxx_tools_arm",
    tree = ":clang",
    fixed_build_date = "fixed-build-date",
    arm = "root//tools/buck2/native-toolchain:arm",
)

# Darwin C: the pinned clang for the floor, with no SDK. Its only system header
# is darwin-include's TargetConditionals.h; libSystem's names come from the link
# kit's stubs at link time.
llvm_cxx_tools(
    name = "cxx_tools_darwin",
    tree = ":clang",
    fixed_build_date = "fixed-build-date",
    darwin_target = "arm64-apple-macos" + DARWIN_FLOOR,
    darwin_include = "darwin-include",
)

cxx_tools_info_toolchain(
    name = "cxx",
    # Choose before the tools' execution transition discards the target OS and CPU.
    cxx_tools_info = select({
        "prelude//os:macos": ":cxx_tools_darwin",
        "DEFAULT": select({
            "prelude//cpu:arm64": ":cxx_tools_arm",
            "DEFAULT": ":cxx_tools",
        }),
    }),
    visibility = ["PUBLIC"],
)

# The prelude's Rust rules name this toolchain too.
alias(name = "cxx_no_default_deps", actual = ":cxx", visibility = ["PUBLIC"])

system_python_bootstrap_toolchain(name = "python_bootstrap", interpreter = "/usr/bin/python3", visibility = ["PUBLIC"])
remote_test_execution_toolchain(name = "remote_test_execution", visibility = ["PUBLIC"])
noop_test_toolchain(name = "test", visibility = ["PUBLIC"])

cxx_library(
    name = "libm",
    exported_linker_flags = ["-lm"],
    visibility = ["PUBLIC"],
)

# libLLVM and its C headers, for llvm-sys (tools/buck2/fixups/llvm-sys).
prebuilt_cxx_library(
    name = "libllvm",
    shared_lib = "llvm-files/lib/libLLVM.so.23.1",
    soname = "libLLVM.so.23.1",
    header_dirs = ["llvm-files/include", "llvm-files/sysroot"],
    preferred_linkage = "shared",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

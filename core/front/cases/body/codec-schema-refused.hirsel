type NoCodec { removed old: String }
type BadDefault: codec { removed old: String = "x" }
type BadPayload: codec = Live | removed Old(HostFile)
type Duplicate: codec { removed note: String, note: u64 }
type DuplicateVariant: codec = First | removed Old | Old
type DuplicateDead: codec { removed n: u64, removed n: u64 }
type LiveFirst: codec { n: u64, removed n: u64 }
type Gone: codec { id: u64, removed note: String }
type Choice: codec = Yes | removed No(u64)
fn construct() -> Gone { Gone(id: 1u64, note: "x") }
fn access(x: Gone) -> u64 { list.len(x.note) }
fn variant() -> Choice { No(0u64) }
fn pattern(x: Choice) -> u64 { match x { Yes => 1u64, No(_) => 0u64 } }

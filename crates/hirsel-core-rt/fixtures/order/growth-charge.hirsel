// The root funds four u64s. The child's push admits 64 from its own limit,
// installs eight slots and posts exactly one 32-byte refund to the root.
// hand-derived refund: 1,0,32
// hand-derived stdout: cr
type Work:send { xs: List[u64], out: Stdout }
fn child(take x: Work) -> u64 waits {
    let Work(xs: ys, out: out) = take x
    let mut xs = take ys
    list.push(mut xs, 4u64)
    result.unwrap(stdout.write(out, "c"))
    list.len(xs)
}
pub fn main(tasks: Tasks, out: Stdout) -> Result[(), Exit] waits {
    let mut xs: List[u64] = list.with_capacity(4u64)
    for i in 0u64 .. 4u64 { list.push(mut xs, i) }
    let h = task.spawn(tasks, bytes 64, Work(xs: take xs, out: out), child)
    match task.join(take h) {
        Ok(5u64) => { result.unwrap(stdout.write(out, "r")); Ok(()) },
        _ => Error(Exit(status: 1)),
    }
}

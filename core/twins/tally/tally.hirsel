// The Hirsel side of the tally twin (tally.rs): four tasks each add 1 N times to their
// own std.tally handle's partial with `update`; finish folds the four partials and main
// prints the total. The measurement substitutes N.
const N: u64 = 250000

type AppError = Io(WriteError) | Mem(Capacity) | Issue(std.tally.HandleError) | Join(JoinError)

fn zero() -> u64 {
    0
}

fn sum(take a: u64, take b: u64) -> u64 {
    a + b
}

fn worker(take h0: std.tally.Handle[u64]) {
    let mut h = take h0
    let mut i: u64 = 0
    while i < N {
        std.tally.update(mut h, fn(mut n: u64) {
            n += 1
        })
        i += 1
    }
}

fn start(tasks: Tasks, mut t: std.tally.Tally[u64]) -> Result[Task[()], AppError] {
    let h = match std.tally.handle(mut t) {
        Ok(take h) => take h,
        Error(e) => return Error(Issue(e)),
    }
    Ok(task.spawn(tasks, bytes 4096, take h, worker))
}

fn joined(take t: Task[()]) -> Result[(), AppError] waits {
    match task.join(take t) {
        Ok(()) => Ok(()),
        Error(e) => Error(Join(e)),
    }
}

pub fn main(out: Stdout, tasks: Tasks) -> Result[(), AppError] waits {
    let mut t: std.tally.Tally[u64] = std.tally.new(4, zero, sum)
    let a = start(tasks, mut t)?
    let b = start(tasks, mut t)?
    let c = start(tasks, mut t)?
    let d = start(tasks, mut t)?
    joined(take a)?
    joined(take b)?
    joined(take c)?
    joined(take d)?
    let mut line = string.new()
    string.push_u64(mut line, std.tally.finish(take t))
    string.push(mut line, "\n")
    match stdout.write(out, line) {
        Ok(()) => Ok(()),
        Error(e) => Error(Io(e)),
    }
}

pub type Config {
    suites: List[schedule.Suite12],
    groups: List[secret.Group],
    srtp: List[schedule.SrtpProfile],
    mtu: u16,
    start_rto_ns: u64,
    max_rto_ns: u64,
    retries: u8,
    handshake_ns: u64,
    max_message: u32,
    max_ahead: u16
}

/// Transport parameters independent of the cipher, group and SRTP choices.
pub type Transport: key {
    mtu: u16,
    start_rto_ns: u64,
    max_rto_ns: u64,
    retries: u8,
    handshake_ns: u64,
    max_message: u32,
    max_ahead: u16
}

pub const DEFAULT_TRANSPORT: Transport = Transport(mtu: 1200, start_rto_ns: 1000000000, max_rto_ns: 60000000000, retries: 7, handshake_ns: 60000000000, max_message: 16384, max_ahead: 32)

pub type State = Handshaking | Connected | Closed(Close)

pub type Poll = Send(u64) | WakeAt(u64) | Idle

/// Which peer message the order of DTLS-5 Message order admits next.
type Want = ServerHello | ServerCertificate | ServerKeyExchange | Request | HelloDone | ClientHello | ClientCertificate | ClientKeyExchange | Verify | CipherSpec | PeerFinished | Done

/// Work that draws randomness or keys and is retried whole after a Capacity refusal.
type Build = Nothing | FirstHello | ClientFinal | ServerFirst | ServerKeys | ServerFinal

type Outgoing {
    cipher_spec: bool,
    kind: u8,
    sequence: u16,
    protected: bool,
    body: Bytes
}

type Timer {
    armed: bool,
    at: u64,
    rto: u64,
    resent: u8,
    triggered: bool,
    /// The flight is built but a refusal kept it from the queue: the next poll sends it
    /// (DTLS-8), not the retransmission timer.
    unsent: bool
}

/// A fatal failure carries its alert; a retry leaves the endpoint as it was.
type Failure = Retry(Capacity) | Alert(u8, DtlsError)

pub opaque type Endpoint {
    side: schedule.Side,
    id: Identity,
    c: Config,
    peer: Addr,
    admission: Admission,
    proven: bool,
    closed: Option[Close],
    connected: bool,
    layer: Records,
    early: Ahead,
    rx: Reassembly,
    log: Transcript,
    want: Want,
    build: Build,
    next_seq: u16,
    verify_seen: bool,
    client_random: Bytes,
    server_random: Bytes,
    cookie: Bytes,
    suite: schedule.Suite12,
    group: secret.Group,
    profile: Option[schedule.SrtpProfile],
    share: Option[secret.KeyShare],
    peer_point: Bytes,
    peer_certificate: Option[Bytes],
    peer_key: Bytes,
    peer_p384: bool,
    session_hash: Bytes,
    keys: Option[schedule.Schedule],
    pins: Option[List[Fingerprint]],
    pinned: bool,
    finished: bool,
    flight: List[Outgoing],
    out: RecordQueue,
    timer: Timer,
    deadline: Option[u64],
    last: u64
}

pub fn defaults() -> Config {
    config_for(DEFAULT_TRANSPORT)
}

/// Default algorithms, with the transport parameters supplied by the caller.
pub fn config_for(transport: Transport) -> Config {
    let mut suites: List[schedule.Suite12] = list.with_capacity(3)
    list.push(mut suites, Aes128GcmSha256)
    list.push(mut suites, Aes256GcmSha384)
    list.push(mut suites, ChaCha20Poly1305Sha256)
    let mut groups: List[secret.Group] = list.with_capacity(2)
    list.push(mut groups, X25519)
    list.push(mut groups, P256)
    let mut srtp: List[schedule.SrtpProfile] = list.with_capacity(3)
    list.push(mut srtp, AeadAes128Gcm)
    list.push(mut srtp, AeadAes256Gcm)
    list.push(mut srtp, Aes128CmHmacSha1_80)
    Config(suites: take suites, groups: take groups, srtp: take srtp, mtu: transport.mtu, start_rto_ns: transport.start_rto_ns, max_rto_ns: transport.max_rto_ns, retries: transport.retries, handshake_ns: transport.handshake_ns, max_message: transport.max_message, max_ahead: transport.max_ahead)
}

/// The receive-side handshake budget for a bounded datagram envelope. Two messages
/// can be current and next, and each admitted ahead fragment can start another
/// message. A partial holds both body and bitmap. The transcript can hold three
/// messages. Its growth and a message being processed can coexist with reassembly.
pub fn receive_heap(transport: Transport, datagram: u64) -> u64 {
    let ahead_count: u64 = int.widen(transport.max_ahead)
    let pending = ahead_count + 2u64
    let message: u64 = int.widen(transport.max_message)
    let body = option.unwrap(charge.seq(1, message))
    let partials = option.unwrap(charge.seq(bytes[PartialMessage], 3u64 * pending))
    let log_bytes = option.unwrap(charge.seq(1, 9u64 * message))
    let record_bytes = int.saturating_add(datagram, bytes[Bytes])
    let queued_bytes = int.saturating_mul(3u64 * ahead_count, record_bytes)
    int.saturating_add((2u64 * pending + 2u64) * body + partials + log_bytes, queued_bytes)
}

fn distinct(codes: List[u16]) -> bool {
    for i in 0u64 .. list.len(codes) {
        for j in i + 1 .. list.len(codes) {
            if codes[i] == codes[j] {
                return false
            }
        }
    }
    true
}

fn suite_codes(c: Config) -> List[u16] {
    let mut codes: List[u16] = list.with_capacity(list.len(c.suites))
    for i in 0u64 .. list.len(c.suites) {
        list.push(mut codes, suite_code(c.suites[i]))
    }
    codes
}

fn group_codes(c: Config) -> List[u16] {
    let mut codes: List[u16] = list.with_capacity(list.len(c.groups))
    for i in 0u64 .. list.len(c.groups) {
        list.push(mut codes, group_code(c.groups[i]))
    }
    codes
}

fn profile_codes(c: Config) -> List[u16] {
    let mut codes: List[u16] = list.with_capacity(list.len(c.srtp))
    for i in 0u64 .. list.len(c.srtp) {
        list.push(mut codes, profile_code(c.srtp[i]))
    }
    codes
}

/// DTLS-2: no field is silently clamped.
fn valid(c: Config) -> bool {
    let mtu: u64 = int.widen(c.mtu)
    let max_message: u64 = int.widen(c.max_message)
    list.len(c.suites) != 0 && list.len(c.groups) != 0 && distinct(suite_codes(c)) && distinct(group_codes(c)) && distinct(profile_codes(c)) && mtu >= 256 && mtu <= 65507 && c.start_rto_ns != 0 && c.start_rto_ns <= c.max_rto_ns && c.handshake_ns != 0 && max_message >= 2048
}

fn copied(b: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(list.len(b))
    list.append(mut out, b)
    out
}

fn config_copy(c: Config) -> Config {
    let mut suites: List[schedule.Suite12] = list.with_capacity(list.len(c.suites))
    for i in 0u64 .. list.len(c.suites) {
        list.push(mut suites, c.suites[i])
    }
    let mut groups: List[secret.Group] = list.with_capacity(list.len(c.groups))
    for i in 0u64 .. list.len(c.groups) {
        list.push(mut groups, c.groups[i])
    }
    let mut srtp: List[schedule.SrtpProfile] = list.with_capacity(list.len(c.srtp))
    for i in 0u64 .. list.len(c.srtp) {
        list.push(mut srtp, c.srtp[i])
    }
    Config(suites: take suites, groups: take groups, srtp: take srtp, mtu: c.mtu, start_rto_ns: c.start_rto_ns, max_rto_ns: c.max_rto_ns, retries: c.retries, handshake_ns: c.handshake_ns, max_message: c.max_message, max_ahead: c.max_ahead)
}

fn endpoint(side: schedule.Side, take id: Identity, c: Config, peer: Addr, a: Admission, build: Build, want: Want) -> Endpoint {
    let start = c.start_rto_ns
    Endpoint(side: side, id: take id, c: config_copy(c), peer: peer, admission: a, proven: false, closed: None, connected: false, layer: records(0), early: ahead(c.max_ahead), rx: reassembly(0, c.max_message), log: transcript(c.max_message), want: want, build: build, next_seq: 0, verify_seen: false, client_random: list.new(), server_random: list.new(), cookie: list.new(), suite: Aes128GcmSha256, group: X25519, profile: None, share: None, peer_point: list.new(), peer_certificate: None, peer_key: list.new(), peer_p384: false, session_hash: list.new(), keys: None, pins: None, pinned: false, finished: false, flight: list.new(), out: queue(), timer: Timer(armed: false, at: 0, rto: start, resent: 0, triggered: false, unsent: false), deadline: None, last: 0)
}

pub fn client(take id: Identity, c: Config, peer: Addr) -> Result[Endpoint, DtlsError] {
    if !valid(c) {
        return Error(Config)
    }
    Ok(endpoint(Client, take id, c, peer, Verified, FirstHello, ServerHello))
}

pub fn server(take id: Identity, c: Config, peer: Addr, a: Admission) -> Result[Endpoint, DtlsError] {
    if !valid(c) {
        return Error(Config)
    }
    Ok(endpoint(Server, take id, c, peer, a, Nothing, ClientHello))
}

pub fn expect(mut e: Endpoint, take fingerprints: List[Fingerprint]) -> Result[(), DtlsError] {
    if let Some(_) = e.pins {
        return Error(Fingerprint)
    }
    e.pins = Some(take fingerprints)
    Ok(())
}

pub fn state(e: Endpoint) -> State {
    if let Some(c) = e.closed {
        return Closed(c)
    }
    if e.connected {
        Connected
    } else {
        Handshaking
    }
}

pub fn peer_certificate(e: Endpoint) -> Option[Bytes] {
    if !e.connected {
        return None
    }
    match e.peer_certificate {
        Some(b) => Some(copied(b)),
        None => None,
    }
}

pub fn srtp_profile(e: Endpoint) -> Option[schedule.SrtpProfile] {
    e.profile
}

pub fn discards(e: Endpoint) -> Discards {
    record_discards(e.layer)
}

pub fn take_srtp(mut e: Endpoint) -> Result[schedule.Schedule, DtlsError] {
    if let Some(c) = e.closed {
        return Error(Closed(c))
    }
    if !e.connected {
        return Error(NotConnected)
    }
    let Some(p) = e.profile else {
        return Error(NoSrtp)
    }
    if let Some(mut k) = e.keys {
        return match schedule.srtp(mut k, p) {
            Ok(take s) => Ok(take s),
            Error(Issued) => Error(Taken),
            Error(Capacity(c)) => Error(Capacity(c)),
            Error(x) => Error(Schedule(x)),
        }
    }
    Error(NotConnected)
}

fn record_failure(e: RecordError) -> Failure {
    match e {
        Capacity(c) => Retry(c),
        Packet(p) => Alert(HANDSHAKE_FAILURE, Packet(p)),
        Schedule(s) => Alert(HANDSHAKE_FAILURE, Schedule(s)),
        SequenceExhausted => Alert(HANDSHAKE_FAILURE, Packet(Range)),
        Closed(c) => Alert(HANDSHAKE_FAILURE, Closed(c)),
        _ => Alert(HANDSHAKE_FAILURE, Packet(TooLong)),
    }
}

fn handshake_failure(e: HandshakeError) -> Failure {
    match e {
        IllegalParameter => refuse(ILLEGAL_PARAMETER),
        HandshakeFailure => refuse(HANDSHAKE_FAILURE),
        Capacity(c) => Retry(c),
        Record(r) => record_failure(r),
    }
}

fn refuse(code: u8) -> Failure {
    Alert(code, Closed(SentAlert(code)))
}

fn record_error(e: RecordError) -> DtlsError {
    match e {
        Capacity(c) => Capacity(c),
        Packet(p) => Packet(p),
        Schedule(s) => Schedule(s),
        Closed(c) => Closed(c),
        SequenceExhausted => Packet(Range),
        _ => Packet(TooLong),
    }
}

fn stop(mut e: Endpoint) {
    e.flight = list.new()
    e.out = queue()
    e.timer.armed = false
    e.build = Nothing
}

/// DTLS-5 Failures: one fatal alert, protected once epoch 1 is active, then Closed.
fn fail(mut e: Endpoint, f: Failure) -> DtlsError {
    match f {
        Retry(c) => Capacity(c),
        Alert(code, err) => {
            stop(mut e)
            let mut d: Bytes = list.with_capacity(int.widen(e.c.mtu))
            if let Ok(_) = write_fatal_alert(mut e.layer, e.c.mtu, code, mut d) {
                let _ = enqueue(mut e.out, take d)
            }
            e.closed = Some(SentAlert(code))
            err
        },
    }
}

fn suite_hash(suite: schedule.Suite12, data: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(48)
    match suite {
        Aes256GcmSha384 => {
            let d = std.sha384.hash(data)
            for i in 0u64 .. 48 {
                list.push(mut out, d[i])
            }
        },
        _ => {
            let d = std.sha256.hash(data)
            for i in 0u64 .. 32 {
                list.push(mut out, d[i])
            }
        },
    }
    out
}

fn record(mut e: Endpoint, kind: u8, sequence: u16, body: Bytes) -> Result[(), Failure] {
    match append_transcript(mut e.log, kind, sequence, body) {
        Ok(()) => Ok(()),
        Error(x) => Error(handshake_failure(x)),
    }
}

fn transcript_mark(e: Endpoint) -> u64 {
    list.len(e.log.data)
}

fn transcript_back(mut e: Endpoint, mark: u64) {
    list.truncate(mut e.log.data, mark)
}

fn outgoing(kind: u8, sequence: u16, protected: bool, take body: Bytes) -> Outgoing {
    Outgoing(cipher_spec: false, kind: kind, sequence: sequence, protected: protected, body: take body)
}

fn cipher_spec() -> Outgoing {
    Outgoing(cipher_spec: true, kind: CCS, sequence: 0, protected: false, body: list.new())
}

fn flush(mut e: Endpoint, mut d: Bytes) -> Result[(), Failure] {
    let full = replace(mut d, list.with_capacity(int.widen(e.c.mtu)))
    match enqueue(mut e.out, take full) {
        Ok(()) => Ok(()),
        Error(x) => Error(record_failure(x)),
    }
}

/// Serialize the whole flight with fresh record numbers (RFC 6347 section 4.2.4), packing
/// whole records into datagrams of at most `mtu`. A refusal queues none of it and leaves the
/// flight to the next poll (DTLS-8).
fn send_flight(mut e: Endpoint) -> Result[(), Failure] {
    e.out = queue()
    e.timer.unsent = true
    if let Error(f) = queue_flight(mut e) {
        e.out = queue()
        return Error(f)
    }
    e.timer.unsent = false
    Ok(())
}

fn queue_flight(mut e: Endpoint) -> Result[(), Failure] {
    let mtu = e.c.mtu
    let mut d: Bytes = list.with_capacity(int.widen(mtu))
    for i in 0u64 .. list.len(e.flight) {
        if e.flight[i].cipher_spec {
            while true {
                match write_record_in(mut e.layer, mtu, false, CCS, b"\x01", mut d) {
                    Ok(_) => break,
                    Error(DatagramFull) if list.len(d) != 0 => flush(mut e, mut d)?,
                    Error(x) => {
                        return Error(record_failure(x))
                    },
                }
            }
        } else {
            let mut offset = 0u64
            let protected = e.flight[i].protected
            let kind = e.flight[i].kind
            let sequence = e.flight[i].sequence
            while true {
                match write_handshake_record_in(mut e.layer, mtu, protected, kind, sequence, e.flight[i].body, mut offset, mut d) {
                    Ok(true) => break,
                    Ok(false) => flush(mut e, mut d)?,
                    Error(Record(DatagramFull)) if list.len(d) != 0 => flush(mut e, mut d)?,
                    Error(x) => {
                        return Error(handshake_failure(x))
                    },
                }
            }
        }
    }
    if list.len(d) != 0 {
        flush(mut e, mut d)?
    }
    Ok(())
}

/// The first transmission arms the timer; a flight after one that needed a retransmission
/// keeps the doubled value (RFC 6347 section 4.2.4.1).
fn start_flight(mut e: Endpoint, now: u64, timed: bool) -> Result[(), Failure] {
    if e.timer.resent == 0 {
        e.timer.rto = e.c.start_rto_ns
    }
    e.timer.resent = 0
    e.timer.triggered = false
    e.timer.armed = timed
    e.timer.at = now + e.timer.rto
    send_flight(mut e)
}

fn expire(mut e: Endpoint, now: u64) -> Result[(), Failure] {
    if e.timer.resent == e.c.retries {
        stop(mut e)
        e.closed = Some(Timeout)
        return Ok(())
    }
    e.timer.resent += 1
    e.timer.rto = if e.timer.rto > e.c.max_rto_ns / 2 {
        e.c.max_rto_ns
    } else {
        2 * e.timer.rto
    }
    e.timer.at = now + e.timer.rto
    e.timer.triggered = false
    send_flight(mut e)
}

fn check_pin(mut e: Endpoint) -> Result[(), Failure] {
    if e.pinned {
        return Ok(())
    }
    let verdict = match e.peer_certificate {
        Some(cert) => match e.pins {
            Some(pins) => Some(matches_peer_fingerprint(cert, pins)),
            None => None,
        },
        None => None,
    }
    match verdict {
        Some(true) => {
            e.pinned = true
            Ok(())
        },
        Some(false) => Error(refuse(BAD_CERTIFICATE)),
        None => Ok(()),
    }
}

/// DTLS-3: Connected needs the peer's Finished, its signature and the pin, once.
/// Connect once Finished verified and the pin matched, but not while a flight is still to
/// be built: server_final hashes the transcript this clears.
fn try_connect(mut e: Endpoint) {
    if e.connected || !e.finished || !e.pinned {
        return
    }
    if let Nothing = e.build {} else {
        return
    }
    records_connected(mut e.layer)
    clear_transcript(mut e.log)
    e.connected = true
    e.timer.armed = false
}

fn hand_out(mut e: Endpoint, mut out: Bytes) -> Result[Poll, DtlsError] {
    let n = list.len(e.out.entries[e.out.head])
    let available = list.capacity(out) - list.len(out)
    if available < n {
        return Error(Capacity(Capacity(requested: n, available: available)))
    }
    let d = dequeue(mut e.out)
    list.append(mut out, d)
    Ok(Send(n))
}

fn wake(e: Endpoint) -> Poll {
    let mut at: Option[u64] = None
    if e.timer.armed {
        at = Some(e.timer.at)
    }
    if !e.connected {
        if let Some(d) = e.deadline {
            at = match at {
                Some(t) if t < d => Some(t),
                _ => Some(d),
            }
        }
    }
    match at {
        Some(t) => WakeAt(t),
        None => Idle,
    }
}

fn poll_step(mut e: Endpoint, now: u64, r: Random) -> Result[(), Failure] {
    check_pin(mut e)?
    try_connect(mut e)
    if !e.connected {
        if let Some(d) = e.deadline {
            if now >= d {
                stop(mut e)
                e.closed = Some(Timeout)
                return Ok(())
            }
        }
    }
    if e.timer.unsent {
        send_flight(mut e)?
    }
    advance(mut e, now, r)?
    if e.timer.armed && now >= e.timer.at {
        expire(mut e, now)?
    }
    Ok(())
}

pub fn poll(mut e: Endpoint, now: u64, r: Random, mut out: Bytes) -> Result[Poll, DtlsError] {
    if now < e.last {
        return Error(Config)
    }
    e.last = now
    if queued(e.out) != 0 {
        return hand_out(mut e, mut out)
    }
    if let Some(c) = e.closed {
        return Error(Closed(c))
    }
    if let Error(f) = poll_step(mut e, now, r) {
        return Error(fail(mut e, f))
    }
    if queued(e.out) != 0 {
        return hand_out(mut e, mut out)
    }
    if let Some(c) = e.closed {
        return Error(Closed(c))
    }
    Ok(wake(e))
}

pub fn send(mut e: Endpoint, data: Bytes, mut out: Bytes) -> Result[u64, DtlsError] {
    if let Some(c) = e.closed {
        return Error(Closed(c))
    }
    if !e.connected {
        return Error(NotConnected)
    }
    let mtu = e.c.mtu
    let room: u64 = int.widen(mtu)
    let chunk = room - record_overhead(e.layer, true)
    let mut total = 0u64
    let mut at = 0u64
    while at < list.len(data) {
        let end = if list.len(data) - at > chunk {
            at + chunk
        } else {
            list.len(data)
        }
        let mut d: Bytes = list.with_capacity(room)
        match write_record(mut e.layer, mtu, APPLICATION, list.slice(data, at, end), mut d) {
            Ok(_) => (),
            Error(Packet(Range)) => {
                stop(mut e)
                let mut notify: Bytes = list.with_capacity(room)
                let _ = write_close_notify(mut e.layer, mtu, mut notify)
                e.closed = Some(Local)
                return Error(Packet(Range))
            },
            Error(x) => {
                return Error(record_error(x))
            },
        }
        let available = list.capacity(out) - list.len(out)
        if available < list.len(d) {
            return Error(Capacity(Capacity(requested: list.len(d), available: available)))
        }
        list.append(mut out, d)
        total += list.len(d)
        at = end
    }
    Ok(total)
}

pub fn close(mut e: Endpoint, mut out: Bytes) -> Result[u64, DtlsError] {
    if let Some(c) = e.closed {
        return Error(Closed(c))
    }
    stop(mut e)
    let mut d: Bytes = list.with_capacity(int.widen(e.c.mtu))
    let result = write_close_notify(mut e.layer, e.c.mtu, mut d)
    e.closed = Some(Local)
    match result {
        Ok(n) => {
            let available = list.capacity(out) - list.len(out)
            if available < n {
                return Error(Capacity(Capacity(requested: n, available: available)))
            }
            list.append(mut out, d)
            Ok(n)
        },
        Error(x) => Error(record_error(x)),
    }
}

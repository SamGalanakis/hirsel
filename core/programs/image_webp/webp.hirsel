pub opaque type Webp {}

pub type Encoding = Lossless | Lossy(u32)

pub type Error = Header(image_core.image.Error) | WrongFormat | WrongImageKind | InvalidOptions | BufferTooSmall | OutOfMemory | CodecFailure

const STILL_STACK_PIXELS: u64 = 16

const ANIMATION_STACK_PIXELS: u64 = 4

const STACK_INPUT_BYTES: u64 = 256

// A frame's end timestamp is accumulated by libwebp in a signed 32-bit int.
// Each frame duration is 24 bits, so at most 128 frames fit for every input.
fn bounded_limits(limits: image_core.image.Limits) -> image_core.image.Limits {
    image_core.image.Limits(max_bytes: if limits.max_bytes < 16777216 {
        limits.max_bytes
    } else {
        16777216
    }, max_pixels: if limits.max_pixels < 16777216 {
        limits.max_pixels
    } else {
        16777216
    }, max_frames: if limits.max_frames < 128 {
        limits.max_frames
    } else {
        128
    }, max_steps: limits.max_steps)
}

fn header(input: Bytes, limits: image_core.image.Limits) -> Result[image_core.image.ImageInfo, Error] {
    match image_core.image.probe(input, bounded_limits(limits)) {
        Error(e) => Error(Header(e)),
        Ok(info) => match info.format {
            Webp => Ok(info),
            _ => Error(WrongFormat),
        },
    }
}

fn pixels(size: image_core.image.Size) -> u64 {
    let width: u64 = int.widen(size.width)
    let height: u64 = int.widen(size.height)
    width * height
}

fn count(status: i32) -> Result[u32, Error] {
    match status {
        - 1 => Error(WrongImageKind),
        - 2 => Error(BufferTooSmall),
        - 3 => Error(OutOfMemory),
        - 4 => Error(CodecFailure),
        _ => Ok(int.narrow(status)),
    }
}

/// Decodes a still image to tightly packed RGBA in an initialized output buffer.
/// Crop origins must be even because libwebp rounds odd origins down. Cropping
/// precedes scaling. Both use libwebp's decoder options. Input is capped at
/// 16 MiB and source and output are each capped at 16,777,216 pixels.
pub fn decode(f: Foreign[Webp], input: Bytes, limits: image_core.image.Limits, crop: Option[image_core.image.Rect], scale: Option[image_core.image.Size], mut rgba: Bytes) -> Result[image_core.image.Size, Error] waits {
    let info = header(input, limits)?
    if info.frame_count != 1 {
        return Error(WrongImageKind)
    }
    let source = image_core.image.Size(width: info.width, height: info.height)
    let window = match crop {
        None => image_core.image.Rect(x: 0, y: 0, width: source.width, height: source.height),
        Some(c) => c,
    }
    if window.x % 2 != 0 || window.y % 2 != 0 || window.x >= source.width || window.y >= source.height || window.width == 0 || window.height == 0 || window.width > source.width - window.x || window.height > source.height - window.y {
        return Error(InvalidOptions)
    }
    let size = match scale {
        None => image_core.image.Size(width: window.width, height: window.height),
        Some(s) => s,
    }
    let area = pixels(size)
    if area == 0 || size.width > 16384 || size.height > 16384 {
        return Error(InvalidOptions)
    }
    if area > limits.max_pixels || area > 16777216 {
        return Error(Header(PixelLimit))
    }
    if list.len(rgba) < 4 * area {
        return Error(BufferTooSmall)
    }
    let status = if pixels(source) <= STILL_STACK_PIXELS && area <= STILL_STACK_PIXELS && list.len(input) <= STACK_INPUT_BYTES {
        native.decode(f, input, source.width, source.height, window.x, window.y, window.width, window.height, size.width, size.height, mut rgba)
    } else {
        native.decode_on_helper(f, input, source.width, source.height, window.x, window.y, window.width, window.height, size.width, size.height, mut rgba)
    }
    count(status)?
    Ok(size)
}

/// Decodes one full animation into consecutive tightly packed RGBA canvases.
/// The second buffer receives one little-endian u32 end timestamp in milliseconds
/// per frame. The whole file must pass the frame cap before either buffer changes.
/// Input is capped at 16 MiB, 128 frames and 16,777,216 pixels across all canvases.
pub fn decode_animation(f: Foreign[Webp], input: Bytes, limits: image_core.image.Limits, mut rgba: Bytes, mut timestamps: Bytes) -> Result[image_core.image.ImageInfo, Error] waits {
    let info = header(input, limits)?
    let frames: u64 = int.widen(info.frame_count)
    let size = image_core.image.Size(width: info.width, height: info.height)
    let area = pixels(size) * frames
    if list.len(rgba) < area * 4 || list.len(timestamps) < frames * 4 {
        return Error(BufferTooSmall)
    }
    let status = if area <= ANIMATION_STACK_PIXELS && list.len(input) <= STACK_INPUT_BYTES {
        native.decode_animation(f, input, size.width, size.height, info.frame_count, mut rgba, mut timestamps)
    } else {
        native.decode_animation_on_helper(f, input, size.width, size.height, info.frame_count, mut rgba, mut timestamps)
    }
    count(status)?
    Ok(info)
}

/// Encodes tightly packed RGBA into an initialized buffer and returns the byte
/// count written. Lossless encoding preserves RGB even at zero alpha. The input
/// is capped at 4,194,304 pixels.
pub fn encode(f: Foreign[Webp], rgba: Bytes, size: image_core.image.Size, encoding: Encoding, mut output: Bytes) -> Result[u32, Error] waits {
    let area = pixels(size)
    if area == 0 || size.width > 16383 || size.height > 16383 || list.len(rgba) != 4 * area {
        return Error(InvalidOptions)
    }
    if area > 4194304 {
        return Error(Header(PixelLimit))
    }
    let quality = match encoding {
        Lossless => -1i32,
        Lossy(q) => {
            if q > 100 {
                return Error(InvalidOptions)
            }
            int.narrow(q)
        },
    }
    count(native.encode(f, rgba, size.width, size.height, quality, mut output))
}

fn object_cut_law(tasks: Tasks, r: Random, sim: BucketSim) -> Result[(), Error] waits {
    let client = bucket_law_client_with(sim, tasks, "s3.test", 1, true)?
    let mut source = history_reader(take client, 0)
    let mut workspace = history_buffers(1057000)?
    let (take opened, _) = history_open_register(mut source, sim.time, r, result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64)), "bucket", mut workspace, BUCKET_LAW_OP_MS)?
    let mut held = take opened
    let id = held.head.store
    let metadata = history_config_bytes(HistoryConfig(place: std.object.bucket_config(source.client), level: "bucket"))?
    bucket_m2_law_commit_packet(mut workspace.packet, held.head, 1)?
    let HistoryApplied(_) = history_register_advance(mut source.client, mut held, metadata, mut workspace, source.deadline)? else {
        fail("checkpoint law's group was refused")
    }
    let old_checkpoint = history_key("e-", held.head.checkpoint)
    let (take previous, _) = history_checkpoint(mut source.client, held.head, source.deadline)?
    let retained = history_retain(previous, held.head.checkpoint, 4, 1)?
    let mut page_manifest = page_manifest_empty()
    page_manifest.generation = 2
    page_manifest.first_live = 4
    page_manifest.prev_first = 4
    page_manifest.branches[0].version = 1
    let manifest = history_create_manifest(mut source.client, id, held.head.pair.epoch, page_manifest, mut workspace, source.deadline)?
    let location = history_make_locator(mut source.client, id, 4, 1, list.new(), mut workspace, source.deadline)?
    let activation = HistoryActivation(number: 1, binding:[42; 32])
    let HistoryApplied(_) = history_publish_checkpoint(mut source.client, mut held, metadata, manifest, retained, location, Some(activation), mut workspace, source.deadline)? else {
        fail("checkpoint did not advance the register")
    }
    let mut new_reader = bucket_law_client_with(sim, tasks, "s3.test", 2, true)?
    let _ = history_fetch(mut new_reader, "head", mut workspace.witness, source.deadline)?
    let capture = history_decode_head(workspace.witness)?
    if capture.head.entry.seq != 4 || capture.head.checkpoint.seq != 4 || capture.head.floor != 4 || capture.head.activation != 1 || capture.head.binding[31] != 42 {
        fail("checkpoint did not atomically publish the floor, activation and binding")
    }
    // Older checkpoints and groups are not needed by the new capture.
    match std.object.erase(mut source.client, old_checkpoint, source.deadline) {
        Ok(()) => (),
        Error(take problem) => return Error(Remote(take problem)),
    }
    let recovered = history_paged_capture(mut source, capture.head, 1048576)?
    if recovered.state.tips[0].head != 1 { fail("cold recovery lost the checkpoint's main tip") }
    object_locator_boundary(mut source, held.head, manifest, mut workspace)
}

// A root at the row limit fits directly. One more row needs two child
// objects whose combined leaf rows are exactly the sorted input.
fn object_locator_boundary(mut source: ObjectPackRead, head: HistoryHead, manifest: HistoryRef, mut workspace: HistoryBuffers) -> Result[(), Error] waits {
    let mut input: List[HistoryRef] = list.with_capacity(32769)
    for ordinal in 1u64 .. 32770 {
        list.push(mut input, HistoryRef(seq: ordinal, epoch: 1, len: 96, digest: ordinal * 2))
    }
    let flat = history_make_locator(mut source.client, head.store, 5, 1, clone(list.slice(input, 0, 32768)), mut workspace, source.deadline)?
    if flat.depth != 0 || list.len(flat.rows) != 32768 {
        fail("a full LOCATE root grew an extra level")
    }
    let split = history_make_locator(mut source.client, head.store, 5, 1, take input, mut workspace, source.deadline)?
    if split.depth != 1 || list.len(split.rows) != 2 {
        fail("one row above the limit did not make two child chunks")
    }
    let ctx = DiskContext(store: head.store, role: 2, seq: 5)
    let retained = HistoryRetention(floor: 5, earlier: list.new())
    let mark_entry = history_checkpoint_packet(mut workspace.packet, ctx, 1, head.entry, manifest, retained, split)?
    let mark = history_read_mark("test checkpoint", head.store, mark_entry, workspace.packet)?
    let mut observed = head
    observed.checkpoint = mark_entry
    let loaded = history_locator(mut source.client, observed, mark, workspace.packet, source.deadline)?
    if map.len(loaded.rows) != 32769 || option.unwrap(map.get(loaded.rows, 32768)).digest != 65536 ||
        option.unwrap(map.get(loaded.rows, 32769)).digest != 65538 {
        fail("the split locator changed the leaf rows at the boundary")
    }
    Ok(())
}

@test
fn bucket_test_m2_checkpoint_advance(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let sim = bucket_law_sim(tasks, c, 992, None, list.new())
    let outcome = object_cut_law(tasks, r, sim)
    let _ = bucket_law_finish(take sim)
    outcome
}

fn object_pack_law(tasks: Tasks, r: Random, sim: BucketSim) -> Result[(), Error] waits {
    let client = bucket_law_client_with(sim, tasks, "s3.test", 1, true)?
    let mut source = history_reader(take client, 0)
    let mut workspace = history_buffers(65536)?
    let (take opened, _) = history_open_register(mut source, sim.time, r, result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64)), "bucket", mut workspace, BUCKET_LAW_OP_MS)?
    let mut held = take opened
    let id = held.head.store
    let mut draft = memory_at(sim.time, id, result.unwrap(sized(Memory, 1074790400u64)))
    let _ = create_table(mut draft, spec("rows", std.codec.key_u64(), std.codec.of_bytes()))?
    let rows = table(mut draft, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let value = bucket_m2_pack_value()
    let wrote = run(mut draft, None, scoped fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, rows, 7, value)
    })?
    if let Committed(_) = wrote {} else { fail("fixture did not write a blob") }
    let participants = cut_participants(draft, NoHolderChange)?
    let base = page_retry_base(new_page_locations(), map.new(), participants.holders, participants.roots)?
    let mut next_stamp = stamp_after(draft.next_node)?
    let planned = plan_page_cut(base, participants.holders, empty_paged_lists(), None, 1, 65536, map.new(), None, mut next_stamp)?
    let mut buffers = cut_output_buffers(planned, cut_manifest_size(draft, NoHolderChange), 65536)?
    let (take layout, take packed) = history_write_page_cut(mut source.client, held.head, take planned, source.locator, mut buffers, mut workspace, source.deadline)?
    if list.len(packed) != 3 || std.page.stamp(std.page.image_of(layout.lists.roots.retired)) != 0 {
        fail("object cut did not emit exactly the three live pack classes")
    }
    fill_cut_manifest(mut buffers.out, draft, NoHolderChange, 2, 3, 3, layout, next_stamp, base.account, seal_page_manifest_file)?
    let (_, take page_manifest) = disk_read_page_manifest("test manifest", buffers.out)?
    let manifest_ref = history_create_manifest(mut source.client, id, 1, page_manifest, mut workspace, source.deadline)?
    let loc = history_make_locator(mut source.client, id, 3, 1, take packed, mut workspace, source.deadline)?
    let (take mark, _) = history_checkpoint(mut source.client, held.head, source.deadline)?
    let kept = history_retain(mark, held.head.checkpoint, 3, 2)?
    let metadata = history_config_bytes(HistoryConfig(place: std.object.bucket_config(source.client), level: "bucket"))?
    let HistoryApplied(_) = history_publish_checkpoint(mut source.client, mut held, metadata, manifest_ref, kept, loc, None, mut workspace, source.deadline)? else {
        fail("checkpoint did not advance after creating packs")
    }
    let recovered = history_paged_capture(mut source, held.head, 1048576)?
    let tip = view recovered.state.tips[0]
    let snap = Snapshot(store: id, open: 0, branch: 0, head: tip.head, roots: share_roots(tip.roots), watermark: stamp_after(recovered.next_node)?)
    if get(snap, rows, 7)? != Some(value) {
        fail("pack objects created by the cut lost the imported row")
    }
    close(take draft)
}

@test
fn bucket_test_m2_pack_emission(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let sim = bucket_law_sim(tasks, c, 992, None, list.new())
    let outcome = object_pack_law(tasks, r, sim)
    let _ = bucket_law_finish(take sim)
    outcome

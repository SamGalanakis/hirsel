// Module platform (package store): the platform host (docs/spec/launch.md "The platform
// host", RUNNER-SPEC §14). The catalog is tables of the host's own store. Every decision
// commits and is durable before the host sends the launcher a request for it (§14.1), so
// the host's step functions return the requests that the commit allows, in order.
//
// The host keeps in memory only what it can rebuild after a restart: the outstanding
// serving launch of each live group, a cutover in progress, backoff, and the queue of wakes
// that found no slot (§14.3 "Queued wakes", §14.5).
pub type Wake: codec + send = Dirty(u64) | Clean(Option[u64])

pub type WakeRow: codec + send {
    wake: Wake,
    gen: u64
}

pub type Author: codec + send = Trusted | Untrusted

pub type Disposition: codec + send = Keep | Delete

pub type GroupRow: codec + send {
    tenant: String,
    workdir: String,
    author: Author,
    listen: String,
    front: Option[operator.Front],
    store: String,
    memory: Option[u64],
    assembly: Bytes,
    activation: u64,
    retained: List[Bytes],
    recovery: Option[Recovery],
    store_id: Option[(u64, u64)],
    store_claim: Option[(u64, (u64, Bytes))],
    incarnation: u64,
    retiring: Option[Disposition],
    // The program's arguments, passed to every serving start of the group.
    args: List[String],
    // Whether its serving starts are recorded, and where.
    record: Option[operator.Record],
    // The package roots its source may link, set by Register (launch.md "Package roots per
    // group").
    packages: List[Bytes],
    // The manifest of the installed release's source; none when it was installed from an
    // attested or publication input. It roots the group's blobs (launch.md "Source by
    // content").
    source: Option[Bytes],
}

// Which of an Undecided deploy's two recorded pairs the group's next probe opens: NEW's
// assembly at the deploy's activation first, OLD's after NEW was answered `PlaceCurrent`
// naming OLD's activation (launch.md "When the host starts").
pub type Probe: codec + send = ProbeNew | ProbeOld

pub type DeployOutcome: codec + send = Preparing | Pending | Installed | Failed(String) | Undecided(Probe)

// A deploy attempt's record (launch.md "Hot deploy"). `Preparing` is durable before any
// helper child or export command: it names NEW's assembly and image digest and OLD's gen,
// and proves no cutover was sent. `Pending` replaces it in one transaction once OLD kept
// the import, before the candidate's Start and the cutover command: it adds the activation
// `activation` (the export's head + 1), the prepared digest `digest` the cutover names, the
// release and Describe the preview reported, and the candidate's gen. A new session re-sends
// exactly that command (§14.5). OLD's first verified drift returns the row to `Preparing`
// at a fresh attempt with `retry_of` set, keeping the assembly, image, Describe and release
// (launch.md "Hot deploy"); a drift of a retried attempt fails the deploy.
pub type DeployRow: codec + send {
    // The operator request D this deploy runs for.
    request: Bytes,
    attempt: launcher.Attempt,
    assembly: Bytes,
    image: Bytes,
    old_assembly: Bytes,
    old_binding: Option[Binding],
    old_claim: Option[(u64, Bytes)],
    binding: Option[Binding],
    new_retained: bool,
    digest: Bytes,
    release: Bytes,
    activation: u64,
    old: u64,
    candidate: u64,
    outcome: DeployOutcome,
    // NEW's exact Describe bytes from the preview, which a retry's import names again.
    describe: Bytes,
    // A drift retry keeps the ID that OLD initially paused under until OLD takes the
    // retry export. Recovery must be able to abort either ID.
    retry_of: Option[launcher.Attempt],
    // The launcher's fetch and assembly times for NEW.
    fetch_ns: Option[u64],
    assemble_ns: Option[u64],
    // What the deploy changes (launch.md "Deploy preview"): the grant diff from admission,
    // the entry diff from the preview child and the trigger report from the prepare child,
    // each as far as the deploy got.
    preview: operator.Preview,
}

pub type RequestStatus: codec + send = Open | Held(operator.Decision) | Done(operator.Phase)

// An operator request's durable record (launch.md "The operator socket"), keyed by its
// 16-byte request ID D and committed before any positive State or launcher request for it.
// `begin` is the canonical bytes of its Begin: a Begin with the same D and other bytes is a
// Conflict. `attempt` is the admission attempt last assigned to it, and `deadline_ms` the
// wall time after which missing input fails admission. The terminal phase outlives later
// deploys, removal and name reuse. Admissions use the `approved` grant diff. Its `fates`
// replace the Begin's, and `shown` lists the held groups the decision covered. An admission
// whose report holds another group holds again. `gate` records the tree digest, H and
// toolchain of the latest green admission (launch.md "The law gate" step 5).
pub type RequestRow: codec + send {
    begin: Bytes,
    group: launcher.Group,
    input: operator.Input,
    attempt: launcher.Attempt,
    deadline_ms: u64,
    status: RequestStatus,
    approved: launcher.Grants,
    fates: Option[runner.fate.Fates],
    shown: List[runner.TriggerScanRow],
    gate: Option[launcher.Green]
}

// One answer for an operator connection; `close` ends that connection's exchange after it.
pub type Sent: send {
    conn: u64,
    answer: operator.Answer,
    close: bool
}

// A recording pin (launch.md "Host assembly"): the assembly record a recorded serving
// process ran, kept as a root until `expires`, in Unix seconds. Keyed by the 16-byte
// recording ID that the tape's Run routing block names.
pub type Pin: codec + send {
    assembly: Bytes,
    expires: u64
}

pub type Quota: codec + send {
    groups: u64,
    live: u64
}

type Usage: codec + send {
    groups: u64,
    live: u64
}

pub type Config: codec + send {
    max_places: u64,
    idle_ms: u64
}

type Meta: codec + send {
    dirty: u64,
    next_incarnation: u64,
    next_attempt: u64
}

type DueKey {
    at: u64,
    name: String
}

// What a retirement left behind (§14.5 step 3).
pub type Retired: codec + send {
    workdir: String,
    disposition: Disposition
}

// Wall time for the due index, monotonic time for backoff and the Ready reset.
pub type Now: send {
    wall_ms: u64,
    mono_ns: u64
}

pub type Timers: send {
    wall_ms: Option[u64],
    mono_ns: Option[u64]
}

pub type Queued: send {
    name: String,
    since: u64
}

pub type Failing: send {
    name: String,
    count: u64,
    retry_at: Option[u64],
    last: String
}

pub type Status: send {
    dirty: u64,
    max_places: u64,
    probes: u64,
    due_wakes: u64,
    arrival_wakes: u64,
    queued: List[Queued],
    failing: List[Failing],
}

type Phase = Requested | Started | Ready(u64)

type Run {
    gen: u64,
    phase: Phase,
    selected: launcher.Selection
}

type Cut {
    attempt: launcher.Attempt,
    incarnation: u64,
    old: u64,
    candidate: u64,
    activation: u64,
    old_end: Option[launcher.End],
    old_ended: bool,
    opened: bool,
    candidate_end: Option[launcher.End],
    // The launcher holds OLD's answer to this attempt's cutover (§14.5): until it returns
    // it, ends are recorded and not acknowledged, and they decide nothing.
    held: bool,
    // The release the preview reported for NEW: the candidate's open must report it.
    release: Bytes,
}

// What a Preparing deploy waits on (launch.md "Hot deploy"): OLD's describe child, NEW's
// preview child over OLD's exported list (with that list's length), OLD's export, NEW's
// prepare child on export `head`, OLD's import of it, the end of a drift retry's discarded
// candidate after OLD kept the import (its head and prepared digest); or, after a failure,
// OLD's abort and the helper's end, before `Failed(why)` is committed.
type Stage = Describing | Previewing(u64) | Exporting | PrepareRunning(u64) | Importing(u64) | Imported(u64, Bytes) | Aborting(String, operator.Class)

type Prep {
    attempt: launcher.Attempt,
    retry_of: Option[launcher.Attempt],
    incarnation: u64,
    old: u64,
    assembly: Bytes,
    image: Bytes,
    target: String,
    n_place: u64,
    stage: Stage,
    // NEW's exact Describe bytes and release, from the preview's answer.
    describe: Bytes,
    release: Bytes,
    // The helper child of this attempt that has not ended.
    helper: Option[launcher.Child],
    // OLD was sent HostAbort and has neither answered PlaceAborted nor ended.
    aborting: bool,
    // A drift retry's discarded candidate gen, still live: the launcher refuses a second
    // candidate beside it (RUNNER-SPEC §14.3), so the retry's candidate starts after its end.
    discarded: Option[u64],
    // OLD's exported list from its describe answer, which the entry diff compares NEW's to.
    old_exported: List[runner.Exported],
    // The deploy's preview so far.
    preview: operator.Preview,
    // The running prepare child has answered its trigger report.
    scanned: bool,
    required_entries: List[launcher.RequiredEntry],
    old_binding: Option[Binding],
    // The Begin's `held`, or the fates an approved decision gave, which the prepare child
    // settles held runs by.
    held: runner.fate.Fates,
    // The deploy ends in a hold for the operator's decision, not a failure: OLD's export is
    // aborted once and the request awaits a Decide on the report.
    holding: bool
}

// Where a deploy's admission stands (launch.md "The launcher", "Publish and assemble"):
// the verifier's Need parts so far and whether the last came, the approval text the
// operator must confirm, the image being assembled, the launcher's failure with its
// payload, or the host's own policy refusal.
// Uploading counts the keys the verifier has asked for and whether its last Need came:
// the relay of each chunk reads this stage, so it holds no list that grows with the closure.
// Receiving is a source's blobs on their way to the host, before the launcher has the input.
pub type AdmitStage: codec + send = Uploading(u64, bool) | Confirming(String) | Assembling | Unadmitted(launcher.Failure) | Rejected(String) | Receiving

type Admitting {
    // The operator request this admission runs for.
    request: Bytes,
    attempt: launcher.Attempt,
    incarnation: u64,
    // The grant diff against OLD's recipe that the operator approved.
    approved: launcher.Grants,
    stage: AdmitStage,
    // The verified recipe's summary, from `Admitted`.
    summary: Option[launcher.Summary],
    // The input is complete: a publication from the start, an attested input at EndInput.
    ended: bool,
    // The admission is a registering group's first release, with no OLD.
    genesis: bool,
    // A source's blobs still being received, while the stage is Receiving.
    receive: Option[Receive],
}

type Vol {
    run: Option[Run],
    cut: Option[Cut],
    count: u64,
    retry_at: Option[u64],
    failing: bool,
    last: String,
    // The probe was answered with the other pair's activation: its end starts the next
    // probe at once, outside backoff.
    reprobe: bool,
    // The running start's own refusal (§14.5 "Genesis"), kept for its end, which names
    // only an exit status.
    cause: Option[String],
    deposed: Option[(u64, Bytes)],
    prep: Option[Prep],
    admit: Option[Admitting],
    backup: Option[BackupWait]
}

// A collection the host runs (launch.md "Collect"): none, or asked for and not yet
// answered `Collected`.
type Collecting = Unfenced | Fencing

pub opaque type Host {
    db: store.Db,
    t: Tables,
    vol: Map[String, Vol],
    queue: List[Queued],
    probes: u64,
    due_wakes: u64,
    arrival_wakes: u64,
    binds_sent: bool,
    // The wall clock of the input being handled, in Unix seconds: a recording pin's start.
    clock_s: u64,
    collecting: Collecting,
    // The operator connection that owns each attached request, the phase last sent to it,
    // and the answers not yet written.
    owners: Map[Bytes, u64],
    shown: Map[Bytes, Bytes],
    outbox: List[Sent],
    // Requests decided where no request list is at hand (a failed registration's Close and
    // Release), sent after the input that decided them.
    later: List[launcher.Request],
    // The last decision of this turn, durable before anything the turn decided leaves;
    // and whether a sync failed, after which nothing leaves.
    unsynced: Option[store.Ticket],
    failed: bool,
    next_backup: u64,
    // This open's node row: its incarnation is fixed for the life of the process.
    node: NodeRow,
}

const READY_RESET_NS: u64 = 300000000000u64

const BACKOFF_FIRST_NS: u64 = 1000000000u64

const BACKOFF_MAX_NS: u64 = 300000000000u64

const CUTOVER_PAUSE_MS: u64 = 2000u64

fn put_due(k: DueKey, mut out: Bytes) {
    std.codec.put_key_u64(k.at, mut out)
    std.codec.put_key_string(k.name, mut out)
}

fn take_due(raw: Bytes, mut at: u64) -> Result[DueKey, std.codec.DecodeError] {
    let t = std.codec.take_key_u64(raw, mut at)?
    let name = std.codec.take_key_string(raw, mut at)?
    Ok(DueKey(at: t, name: take name))
}

fn due_schema(mut s: std.codec.Schema) -> Result[(), std.codec.EncodeError] {
    std.codec.schema_tuple(mut s, 2u64)?
    std.codec.schema_u64(mut s)
    std.codec.schema_string(mut s)
    Ok(())
}

fn due_key() -> std.codec.Key[DueKey] {
    std.codec.key_make(code.describe(put_due), code.describe(take_due), code.describe(due_schema))
}

// The host's tables, declared into the caller's declaration: one store may hold the host
// beside the caller's own tables, and the caller seals once before `open`.
// A store holding only the host: declares its tables, seals, and opens.
pub fn open(take opened: store.Db, first: Config) -> Result[(Host, List[launcher.Request]), Refused] waits {
    let mut db = take opened
    let mut d = st(store.declare(db, Migrate))?
    let t = st(declare_tables(mut d))?
    let _ = st(store.seal(mut db, take d))?
    open_declared(take db, take t, first)
}

// Ends a host turn: one sync covers every decision of the turn, since the journal is a
// FIFO prefix. A failed sync fails the host: nothing that turn or any later one decided
// leaves, and the restart recovers the durable catalog.
fn synced(mut h: Host) -> Result[(), Refused] waits {
    if h.failed {
        return Error(Missing("a durable catalog"))
    }
    let Some(ticket) = replace(mut h.unsynced, None) else {
        return Ok(())
    }
    match store.durable(mut h.db, ticket) {
        Ok(()) => Ok(()),
        Error(take e) => {
            h.failed = true
            list.clear(mut h.outbox)
            list.clear(mut h.later)
            Error(Store(take e))
        },
    }
}

fn turned(mut h: Host, take out: List[launcher.Request]) -> List[launcher.Request] waits {
    match synced(mut h) {
        Ok(()) => take out,
        Error(_) => list.new(),
    }
}

fn turned_result[T](mut h: Host, take r: Result[T, Refused]) -> Result[T, Refused] waits {
    synced(mut h)?
    take r
}

// A sync failed: the host must end without sending anything more.
pub fn sync_failed(h: Host) -> bool {
    h.failed
}

// Opens the host on its store: creates the catalog on first use, and returns the host
// with the `Hello` that starts its control session.
pub fn open_declared(take opened: store.Db, take t: Tables, first: Config) -> Result[(Host, List[launcher.Request]), Refused] waits {
    if first.max_places == 0u64 {
        return Error(Missing("max_places"))
    }
    if first.idle_ms == 0u64 {
        return Error(Missing("idle_ms"))
    }
    let mut db = take opened
    let made = store.run(mut db, None, (store.copy_env(first), store.copy_env(t)), fn(mut tx, call_env) -> Result[NodeRow, Refused] {
        if let None = st(store.fetch(tx, call_env.1 .config, 0u64))? {
            st(store.put(mut tx, call_env.1 .config, 0u64, call_env.0))?
        }
        if let None = st(store.fetch(tx, call_env.1 .meta, 0u64))? {
            st(store.put(mut tx, call_env.1 .meta, 0u64, Meta(dirty: 0u64, next_incarnation: 1u64, next_attempt: 1u64)))?
        }
        Ok(next_node(mut tx, call_env.1)?)
    })
    let mut h = Host(db: take db, t: take t, vol: map.new(), queue: list.new(), probes: 0u64, due_wakes: 0u64, arrival_wakes: 0u64, binds_sent: false, clock_s: 0u64, collecting: Unfenced, owners: map.new(), shown: map.new(), outbox: list.new(), later: list.new(), unsynced: None, failed: false, next_backup: 1u64, node: NodeRow(enrolled: None, incarnation: 0u64))
    let node = decided(mut h, take made)?
    h.node = node
    synced(mut h)?
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Hello)
    Ok((take h, take out))
}

// The host's store, for a restart: the process ends and only the store survives.
pub fn close(take h: Host) -> store.Db {
    let Host(db: take db, ..) = take h
    take db
}

// A new control session in the same process: the launcher discards the old session's
// unacted requests, so every launch not in the inventory will never run (§14.5).
pub fn reconnect(h: Host) -> List[launcher.Request] {
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Hello)
    out
}

fn group_of(name: String, incarnation: u64) -> launcher.Group {
    launcher.Group(name: string.from(name), incarnation: incarnation)
}

// The one place a Bind is built.
fn bind_request(name: String, g: GroupRow) -> launcher.Request {
    Bind(group_of(name, g.incarnation), string.from(g.listen))
}

fn serving_launch(name: String, g: GroupRow, gen: u64, activation: u64, assembly: Bytes, idle: u64, candidate: Option[u64], witness: Option[u64]) -> launcher.Request {
    let mode: launcher.Mode = ServingMode(gen, launcher.Serve(activation: activation, idle: idle, candidate: candidate, store_id: g.store_id, witness: witness, move_envelope: list.new()))
    let recording: Option[launcher.Recording] = match g.record {
        Some(r) => {
            let id = recording_id(g.incarnation, gen)
            let destination = joined(joined(joined(r.dir, "/"), std.hex.encode(id)), ".tape")
            Some(launcher.Recording(id: take id, destination: take destination))
        },
        None => None,
    }
    Start(launcher.Launch(group: group_of(name, g.incarnation), assembly: clone(assembly), workdir: string.from(g.workdir), args: clone(g.args), mode: mode, recording: take recording))
}

// A serving start's recording ID (launch.md "Recording a group"): its group's incarnation
// and its generation, each little-endian u64. Incarnations are never reused and a group's
// generations only grow, so no two starts share one, and a start sent again after a host
// restart names the pin its first sending committed.
fn recording_id(incarnation: u64, gen: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(16u64)
    for i in 0u64 .. 8u64 {
        list.push(mut b, int.narrow((incarnation >> (8u64 * i)) & 255u64))
    }
    for i in 0u64 .. 8u64 {
        list.push(mut b, int.narrow((gen >> (8u64 * i)) & 255u64))
    }
    b
}

// A recorded group's serving start at `gen` is pinned in the transaction that allocates
// `gen`, so no recording runs before the pin that names its assembly is durable.
fn pin_start(mut tx: store.Tx, t: Tables, g: GroupRow, gen: u64, assembly: Bytes, now_s: u64) -> Result[(), Refused] {
    let retention = match g.record {
        Some(r) => r.retention_s,
        None => return Ok(()),
    }
    st(store.put(mut tx, t.pins, recording_id(g.incarnation, gen), Pin(assembly: clone(assembly), expires: now_s + retention)))
}

fn child_of(name: String, incarnation: u64, gen: u64) -> launcher.Child {
    launcher.Child(group: group_of(name, incarnation), role: Serving(gen))
}

// The one cutover command an attempt sends to OLD, first and on every re-send. A retry's
// cutover keeps the deadline of OLD's original write pause.
fn cutover_command(name: String, incarnation: u64, old: u64, attempt: launcher.Attempt, digest: Bytes, retry: bool) -> launcher.Request {
    Command(child_of(name, incarnation, old), HostCutover(attempt_bytes(attempt), clone(digest), CUTOVER_PAUSE_MS, retry))
}

// The decision on the attempt is durable: the launcher forgets OLD's saved answer.
fn cutover_ack(name: String, cut: Cut) -> launcher.Request {
    CutoverAck(child_of(name, cut.incarnation, cut.old), cut.attempt)
}

fn attempt_bytes(a: launcher.Attempt) -> Bytes {
    let mut b: Bytes = list.with_capacity(16u64)
    list.put_word_le(mut b, a.hi)
    list.put_word_le(mut b, a.lo)
    b
}

fn group_row(h: Host, name: String) -> Result[Option[GroupRow], Refused] waits {
    st(store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.groups, name))
}

fn host_config(h: Host) -> Result[Config, Refused] waits {
    match st(store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.config, 0u64))? {
        Some(c) => Ok(c),
        None => Error(Missing("config"))
    }
}

pub fn wake_row(h: Host, name: String) -> Option[WakeRow] waits {
    match store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.wake, name) {
        Ok(Some(w)) => Some(w),
        _ => None
    }
}

fn run_gen(h: Host, name: String) -> Option[u64] {
    match vol_read(h, name).run {
        Some(r) => Some(r.gen),
        None => None
    }
}

fn cut_of(h: Host, name: String) -> Option[Cut] {
    clone(vol_read(h, name).cut)
}

fn set_cut(mut h: Host, name: String, take c: Option[Cut]) {
    let mut v = vol_read(h, name)
    v.cut = take c
    vol_put(mut h, name, take v)
}

fn set_run(mut h: Host, name: String, take r: Option[Run]) {
    let mut v = vol_read(h, name)
    v.run = take r
    vol_put(mut h, name, take v)
}

fn queued_at(h: Host, name: String) -> Option[u64] {
    for i in 0u64 .. list.len(h.queue) {
        if h.queue[i].name == name {
            return Some(i)
        }
    }
    None
}

fn dequeue(mut h: Host, name: String) {
    let mut kept: List[Queued] = list.new()
    for q in h.queue {
        if q.name != name {
            list.push(mut kept, clone(q))
        }
    }
    h.queue = take kept
}

// One queue entry per group, with its earliest cause, in (cause time, name) order.
fn enqueue(mut h: Host, name: String, since: u64) {
    let mut at = since
    if let Some(i) = queued_at(h, name) {
        if h.queue[i].since <= at {
            return
        }
    }
    dequeue(mut h, name)
    list.push(mut h.queue, Queued(name: string.from(name), since: at))
    list.sort_stable(mut h.queue, scoped fn(a: Queued, b: Queued) -> Order {
        match order.compare(a.since, b.since) {
            Equal => order.compare(a.name, b.name),
            other => other
        }
    })
}

fn usage_of(tx: store.Tx, t: Tables, tenant: String) -> Result[Usage, Refused] {
    match st(store.fetch(tx, t.usage, tenant))? {
        Some(u) => Ok(u),
        None => Ok(Usage(groups: 0u64, live: 0u64))
    }
}

fn quota_of(tx: store.Tx, t: Tables, tenant: String) -> Result[Option[Quota], Refused] {
    st(store.fetch(tx, t.quotas, tenant))
}

fn meta_of(tx: store.Tx, t: Tables) -> Result[Meta, Refused] {
    match st(store.fetch(tx, t.meta, 0u64))? {
        Some(m) => Ok(m),
        None => Error(Missing("meta"))
    }
}

fn config_of(tx: store.Tx, t: Tables) -> Result[Config, Refused] {
    match st(store.fetch(tx, t.config, 0u64))? {
        Some(c) => Ok(c),
        None => Error(Missing("config"))
    }
}

// §14.2: the capacity and tenant checks come before `Dirty`, in the transaction that writes it.
fn mark_dirty(mut tx: store.Tx, t: Tables, name: String) -> Result[(GroupRow, u64), Refused] {
    let Some(g) = st(store.fetch(tx, t.groups, name))? else {
        return Error(Unknown)
    }
    let Some(w) = st(store.fetch(tx, t.wake, name))? else {
        return Error(Unknown)
    }
    let Clean(due) = w.wake else {
        return Error(Busy(w.gen))
    }
    let mut meta = meta_of(tx, t)?
    let c = config_of(tx, t)?
    if meta.dirty + reserved_except(tx, t, name)? >= c.max_places {
        return Error(Full(Count(c.max_places)))
    }
    let mut u = usage_of(tx, t, g.tenant)?
    if let Some(q) = quota_of(tx, t, g.tenant)? {
        if u.live >= q.live {
            return Error(Full(Live(string.from(g.tenant), q.live)))
        }
    }
    let next = w.gen + 1u64
    st(store.put(mut tx, t.wake, name, WakeRow(wake: Dirty(next), gen: next)))?
    st(store.put(mut tx, t.dirty, name, next))?
    if let Some(at) = due {
        let _ = st(store.delete(mut tx, t.due, DueKey(at: at, name: string.from(name))))?
    }
    meta.dirty += 1u64
    st(store.put(mut tx, t.meta, 0u64, meta))?
    u.live += 1u64
    st(store.put(mut tx, t.usage, g.tenant, u))?
    Ok((g, next))
}

// A new serving launch for a row that is already Dirty (a probe, a relaunch after a
// readable end, a backoff retry): no check, because `dirty` does not change.
// The pair a serving launch of an already Dirty row opens: the group's recorded assembly
// and activation, or while its deploy is Undecided, the pair that deploy's probe selects.
fn probe_pair(tx: store.Tx, t: Tables, name: String, g: GroupRow) -> Result[(Bytes, u64, Option[u64]), Refused] {
    if let Some(d) = st(store.fetch(tx, t.deploys, name))? {
        match d.outcome {
            Undecided(ProbeNew) => return Ok((clone(d.assembly), d.activation, Some(d.activation))),
            Undecided(ProbeOld) => return Ok((clone(g.assembly), g.activation, Some(d.activation))),
            _ => (),
        }
    }
    Ok((clone(g.assembly), g.activation, None))
}

fn remark(mut tx: store.Tx, t: Tables, name: String) -> Result[(GroupRow, u64), Refused] {
    let Some(g) = st(store.fetch(tx, t.groups, name))? else {
        return Error(Unknown)
    }
    let Some(w) = st(store.fetch(tx, t.wake, name))? else {
        return Error(Unknown)
    }
    let Dirty(_) = w.wake else {
        return Error(Missing("dirty"))
    }
    if let Some(_) = g.retiring {
        return Error(Retiring)
    }
    let next = w.gen + 1u64
    st(store.put(mut tx, t.wake, name, WakeRow(wake: Dirty(next), gen: next)))?
    st(store.put(mut tx, t.dirty, name, next))?
    Ok((g, next))
}

// §14.4 "Only a clean Stopped writes Clean": the row must be Dirty(g) with the report's g.
fn mark_clean(mut tx: store.Tx, t: Tables, name: String, g: u64, next_due: Option[u64]) -> Result[bool, Refused] {
    let Some(grp) = st(store.fetch(tx, t.groups, name))? else {
        return Ok(false)
    }
    let Some(w) = st(store.fetch(tx, t.wake, name))? else {
        return Ok(false)
    }
    let Dirty(a) = w.wake else {
        return Ok(false)
    }
    if a != g {
        return Ok(false)
    }
    st(store.put(mut tx, t.wake, name, WakeRow(wake: Clean(next_due), gen: w.gen)))?
    let _ = st(store.delete(mut tx, t.dirty, name))?
    if let Some(at) = next_due {
        st(store.put(mut tx, t.due, DueKey(at: at, name: string.from(name)), 0u8))?
    }
    let mut meta = meta_of(tx, t)?
    meta.dirty -= 1u64
    st(store.put(mut tx, t.meta, 0u64, meta))?
    let mut u = usage_of(tx, t, grp.tenant)?
    u.live -= 1u64
    st(store.put(mut tx, t.usage, grp.tenant, u))?
    Ok(true)
}

fn launch_dirty(mut h: Host, name: String, probe: bool, mut out: List[launcher.Request]) -> Result[(), Refused] waits {
    let now_s = h.clock_s
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(name), store.copy_env(now_s), store.copy_env(t)), fn(mut tx, call_env) -> Result[(GroupRow, u64, Bytes, u64, Option[u64]), Refused] {
            let (g, gen) = remark(mut tx, call_env.2, call_env.0)?
            let (assembly, activation, witness) = probe_pair(tx, call_env.2, call_env.0, g)?
            pin_start(mut tx, call_env.2, g, gen, assembly, call_env.1)?
            Ok((g, gen, assembly, activation, witness))
        })
    }
    let (g, gen, assembly, activation, witness) = decided(mut h, take made)?
    let c = host_config(h)?
    list.push(mut out, serving_launch(name, g, gen, activation, assembly, c.idle_ms, None, witness))
    let mut v = vol_read(h, name)
    v.run = Some(Run(gen: gen, phase: Requested, selected: launcher.Selection(activation: activation, assembly: clone(assembly))))
    v.retry_at = None
    v.failing = v.failing && !is_none(g.recovery)
    v.reprobe = false
    v.cause = None
    v.deposed = None
    vol_put(mut h, name, take v)
    if probe {
        h.probes += 1u64
    }
    Ok(())
}

// A cold group's wake (§14.3, the Cold row): the check, `Dirty(gen + 1)`, a launch.
fn activate(mut h: Host, name: String, mut out: List[launcher.Request]) -> Result[(), Refused] waits {
    let now_s = h.clock_s
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(name), store.copy_env(now_s), store.copy_env(t)), fn(mut tx, call_env) -> Result[(GroupRow, u64), Refused] {
            let (g, gen) = mark_dirty(mut tx, call_env.2, call_env.0)?
            pin_start(mut tx, call_env.2, g, gen, g.assembly, call_env.1)?
            Ok((g, gen))
        })
    }
    let (g, gen) = decided(mut h, take made)?
    let c = host_config(h)?
    list.push(mut out, serving_launch(name, g, gen, g.activation, g.assembly, c.idle_ms, None, None))
    set_run(mut h, name, Some(Run(gen: gen, phase: Requested, selected: launcher.Selection(activation: g.activation, assembly: clone(g.assembly)))))
    dequeue(mut h, name)
    Ok(())
}

type Cause = Arrival | Due(u64) | Operator

// What a wake does by the group's state (§14.3, the table).
fn wake_cause(mut h: Host, name: String, cause: Cause, now: Now, mut out: List[launcher.Request]) -> Result[(), Refused] waits {
    let Some(g) = group_row(h, name)? else {
        return Error(Unknown)
    }
    let operator = match cause {
        Operator => true,
        _ => false
    }
    if let Some(_) = g.retiring {
        return if operator {
            Error(Retiring)
        } else {
            Ok(())
        }
    }
    let v = vol_read(h, name)
    if let Some(_) = v.cut {
        return if operator {
            Error(Busy(0u64))
        } else {
            Ok(())
        }
    }
    if let Some(_) = v.run {
        return Ok(())
    }
    if v.failing {
        if operator {
            return launch_dirty(mut h, name, false, mut out)
        }
        return Ok(())
    }
    let Some(w) = wake_row(h, name) else {
        return Error(Unknown)
    }
    if let Dirty(_) = w.wake {
        return launch_dirty(mut h, name, true, mut out)
    }
    match activate(mut h, name, mut out) {
        Ok(()) => {
            match cause {
                Due(_) => {
                    h.due_wakes += 1u64
                },
                Arrival => {
                    h.arrival_wakes += 1u64
                },
                Operator => (),
            }
            Ok(())
        },
        Error(Full(take limit)) => {
            match cause {
                Operator => Error(Full(take limit)),
                Due(at) => {
                    enqueue(mut h, name, at);
                    Ok(())
                },
                Arrival => {
                    enqueue(mut h, name, now.wall_ms);
                    Ok(())
                },
            }
        },
        Error(take e) => Error(take e),
    }
}

// Tries every queued wake in order, each independently (§14.3 "Queued wakes").
fn retry_queue(mut h: Host, now: Now, mut out: List[launcher.Request]) waits {
    let entries: List[Queued] = clone(h.queue)
    for q in entries {
        if let None = queued_at(h, q.name) {
            continue
        }
        dequeue(mut h, q.name)
        let _ = wake_cause(mut h, q.name, Due(q.since), now, mut out)
    }
}

fn backoff_ns(count: u64) -> u64 {
    if count <= 1u64 {
        return 0u64
    }
    let mut d = BACKOFF_FIRST_NS
    for _ in 2u64 .. count {
        d = int.saturating_mul(d, 2u64)
        if d >= BACKOFF_MAX_NS {
            return BACKOFF_MAX_NS
        }
    }
    d
}

// An unsuccessful start (§14.5 "Failing and backoff"): retried at once the first time,
// then after a doubling delay from 1 s up to 5 min. The row stays Dirty and keeps its slot.
fn unsuccessful(mut h: Host, name: String, why: String, retry: bool, now: Now, mut out: List[launcher.Request]) waits {
    let mut v = vol_read(h, name)
    v.run = None
    v.count += 1u64
    v.last = string.from(why)
    v.failing = true
    v.retry_at = None
    let count = v.count
    let delay = backoff_ns(count)
    if retry && delay > 0u64 {
        v.retry_at = Some(int.saturating_add(now.mono_ns, delay))
    }
    vol_put(mut h, name, take v)
    if retry && delay == 0u64 {
        let _ = launch_dirty(mut h, name, false, mut out)
    }
}

fn clean_report(e: launcher.End) -> Option[Option[u64]] {
    match e.status {
        Code(0i32) => e.report,
        _ => None
    }
}

// The authoritative child ended (§14.3 table, the last two columns; §14.4, §14.5).
fn apply_end(mut h: Host, name: String, g: GroupRow, gen: u64, e: launcher.End, now: Now, mut out: List[launcher.Request]) waits {
    let mut v = vol_read(h, name)
    let cause = replace(mut v.cause, None)
    let ready_ns: Option[u64] = match v.run {
        Some(r) => match r.phase {
            Ready(at) => Some(at),
            _ => None
        },
        None => None
    }
    v.run = None
    if let Some(_) = g.retiring {
        vol_put(mut h, name, take v);
        return
    }
    if let Some(_) = v.deposed {
        end_deposed(mut h, name, take v)
        return
    }
    if v.reprobe {
        vol_put(mut h, name, take v)
        let _ = launch_dirty(mut h, name, true, mut out)
        return
    }
    match clean_report(e) {
        Some(next_due) => {
            v.count = 0u64
            v.failing = false
            vol_put(mut h, name, take v)
            if e.readable {
                let _ = launch_dirty(mut h, name, false, mut out)
                return
            }
            let made = {
                let t = view h.t
                store.run(mut h.db, None, (gen, store.copy_env(name), store.copy_env(t), next_due), fn(mut tx, call_env) -> Result[bool, Refused] {
                    mark_clean(mut tx, call_env.2, call_env.1, call_env.0, call_env.3)
                })
            }
            if let Ok(true) = decided(mut h, take made) {
                retry_queue(mut h, now, mut out)
            }
        },
        None => {
            let long = match ready_ns {
                Some(at) => now.mono_ns >= at && now.mono_ns - at >= READY_RESET_NS,
                None => false
            }
            if long {
                v.count = 0u64
            }
            vol_put(mut h, name, take v)
            let why = match take cause {
                Some(take said) => take said,
                None => status_text(e.status),
            }
            unsuccessful(mut h, name, why, true, now, mut out)
        },
    }
}

fn current(h: Host, c: launcher.Child) -> Option[GroupRow] waits {
    match group_row(h, c.group.name) {
        Ok(Some(g)) => if g.incarnation == c.group.incarnation {
            Some(g)
        } else {
            None
        },
        _ => None,
    }
}

fn ended(mut h: Host, c: launcher.Child, e: launcher.End, now: Now, mut out: List[launcher.Request]) waits {
    let Some(g) = current(h, c) else {
        list.push(mut out, Acknowledge(clone(c)));
        return
    }
    let Serving(gen) = c.role else {
        let ok = match e.status {
            Code(x) => x == 0i32,
            Signal(_) => false
        }
        helper_done(mut h, c, ok, status_text(e.status), mut out)
        list.push(mut out, Acknowledge(clone(c)));
        return
    }
    let name = string.from(c.group.name)
    backup_ended(mut h, name, c.group.incarnation, gen)
    // OLD's end ends its export and any kept import: a Preparing deploy fails with it.
    let preparing = prep_of(h, name)
    if let Some(take p) = take preparing {
        if p.old == gen {
            prep_fail(mut h, name, take p, "OLD ended before the cutover", false, mut out)
        } else if p.discarded == Some(gen) {
            let mut q = take p
            q.discarded = None
            let imported: Option[(u64, Bytes)] = match q.stage {
                Imported(head, digest) => Some((head, clone(digest))),
                _ => None
            }
            match take imported {
                Some((head, digest)) => prep_pending(mut h, name, take q, head, digest, mut out),
                None => set_prep(mut h, name, Some(take q)),
            }
        }
    }
    let found = cut_of(h, name)
    match take found {
        Some(take outstanding) => {
            let mut cut = take outstanding
            if gen == cut.candidate {
                cut.candidate_end = Some(e)
            } else if gen == cut.old {
                cut.old_end = Some(e)
                cut.old_ended = true
            } else {
                list.push(mut out, Acknowledge(clone(c)))
                return
            }
            let held = cut.held
            finish_ended_cut(mut h, name, take cut, now, mut out)
            if held {
                return
            }
        },
        None => {
            if run_gen(h, name) == Some(gen) {
                apply_end(mut h, name, g, gen, e, now, mut out)
            }
        },
    }
    list.push(mut out, Acknowledge(clone(c)))
}

fn finish_ended_cut(mut h: Host, name: String, take cut: Cut, now: Now, mut out: List[launcher.Request]) waits {
    if !cut.held && cut.old_ended && cut.opened {
        commit_cut(mut h, name, take cut, now, mut out)
    } else if !cut.held && cut.old_ended && !is_none(cut.candidate_end) {
        undecided(mut h, name, take cut, mut out)
    } else {
        set_cut(mut h, name, Some(take cut))
    }
}

// The store installed the deploy's activation: NEW's assembly becomes the group's root,
// OLD's is retained, and the deploy is Installed.
fn install_new(mut tx: store.Tx, t: Tables, name: String, take g: GroupRow, take d: DeployRow) -> Result[(), Refused] {
    let mut grp = take g
    let mut row = take d
    select_release(mut tx, t, mut grp, row, row.activation, true, true)?
    grp.recovery = None
    st(store.put(mut tx, t.groups, name, grp))?
    row.outcome = Installed
    put_deploy(mut tx, t, name, row, StoreClass)
}

// §14.3 "Commit": OLD answered Installed(v), or the candidate opened the store at v and OLD
// has ended. The row moves to `Dirty(c)` with the deploy outcome in one transaction.
fn commit_cut(mut h: Host, name: String, take cut: Cut, now: Now, mut out: List[launcher.Request]) waits {
    let candidate = cut.candidate
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(name), store.copy_env(candidate), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found_w) = st(store.fetch(tx, call_env.2 .wake, call_env.0))? else {
                return Error(Unknown)
            }
            let mut w = found_w
            let Some(grp) = st(store.fetch(tx, call_env.2 .groups, call_env.0))? else {
                return Error(Unknown)
            }
            let Some(d) = st(store.fetch(tx, call_env.2 .deploys, call_env.0))? else {
                return Error(Missing("deploy"))
            }
            w.wake = Dirty(call_env.1)
            st(store.put(mut tx, call_env.2 .wake, call_env.0, w))?
            st(store.put(mut tx, call_env.2 .dirty, call_env.0, call_env.1))?
            install_new(mut tx, call_env.2, call_env.0, take grp, take d)
        })
    }
    if let Error(_) = decided(mut h, take made) {
        return
    }
    list.push(mut out, cutover_ack(name, cut))
    let phase = if cut.opened {
        Ready(now.mono_ns)
    } else {
        Started
    }
    let mut v = vol_read(h, name)
    v.cut = None
    let Ok(Some(installed)) = group_row(h, name) else {
        return
    }
    v.run = Some(Run(gen: candidate, phase: phase, selected: launcher.Selection(activation: installed.activation, assembly: clone(installed.assembly))))
    vol_put(mut h, name, take v)
    if let Some(e) = cut.candidate_end {
        let Some(fresh) = current(h, child_of(name, cut.incarnation, candidate)) else {
            return
        }
        apply_end(mut h, name, fresh, candidate, e, now, mut out)
    }
}

// §14.3 "Abort": OLD answered Refused, or Drift. The candidate is discarded and the row
// stays `Dirty(g)`.
fn abort_cut(mut h: Host, name: String, g: GroupRow, take cut: Cut, why: String, now: Now, mut out: List[launcher.Request]) waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(name), store.copy_env(why), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found_d) = st(store.fetch(tx, call_env.2 .deploys, call_env.0))? else {
                return Error(Missing("deploy"))
            }
            let mut d = found_d
            d.outcome = Failed(string.from(call_env.1))
            put_deploy(mut tx, call_env.2, call_env.0, d, abort_class(call_env.1))
        })
    }
    if let Error(_) = decided(mut h, take made) {
        return
    }
    discard_cut(mut h, name, g, take cut, now, mut out)
}

// The failure is durable: OLD drops the attempt, and the candidate is stopped.
fn discard_cut(mut h: Host, name: String, g: GroupRow, take cut: Cut, now: Now, mut out: List[launcher.Request]) waits {
    list.push(mut out, cutover_ack(name, cut))
    list.push(mut out, Command(child_of(name, g.incarnation, cut.old), abort_command(cut.attempt, None)))
    if let None = cut.candidate_end {
        list.push(mut out, Stop(child_of(name, g.incarnation, cut.candidate)))
    }
    set_cut(mut h, name, None)
    if let Some(e) = cut.old_end {
        apply_end(mut h, name, g, cut.old, e, now, mut out)
    }
}

// §14.3 "Abort", with the retry left (ADVICE step 5): OLD verified drift and keeps its
// write pause. The deploy's first drift returns its row to `Preparing` at a fresh attempt
// A' in one transaction, then OLD exports again under that pause (`HostExport(A', true)`)
// with the same assembly, image, Describe and release, and the next import gets a new
// candidate generation. The discarded candidate is stopped as in an abort. A drift of a
// retried attempt aborts, and so does a drift OLD answered before it ended, since no export
// can follow. OLD's answer re-delivered to a new session is the same answer
// and spends nothing: only the row's `retry_of` decides.
fn drift(mut h: Host, name: String, g: GroupRow, take cut: Cut, now: Now, mut out: List[launcher.Request]) waits {
    let made = {
        let t = view h.t
        let k = view cut
        store.run(mut h.db, None, (store.copy_env(name), store.copy_env(t), store.copy_env(k)), fn(mut tx, call_env) -> Result[Option[DeployRow], Refused] {
            let Some(found_d) = st(store.fetch(tx, call_env.1 .deploys, call_env.0))? else {
                return Error(Missing("deploy"))
            }
            let mut d = found_d
            let ours = match d.outcome {
                Pending => d.attempt.hi == call_env.2 .attempt.hi && d.attempt.lo == call_env.2 .attempt.lo,
                _ => false
            }
            if !ours {
                return Error(Missing("deploy"))
            }
            if !is_none(d.retry_of) || call_env.2 .old_ended {
                d.outcome = Failed("drift")
                put_deploy(mut tx, call_env.1, call_env.0, d, abort_class("drift"))?
                return Ok(None)
            }
            d.retry_of = Some(d.attempt)
            d.attempt = fresh_attempt(mut tx, call_env.1)?
            d.outcome = Preparing
            put_deploy(mut tx, call_env.1, call_env.0, clone(d), StoreClass)?
            Ok(Some(d))
        })
    }
    let retry = match decided(mut h, take made) {
        Ok(Some(take d)) => take d,
        Ok(None) => {
            discard_cut(mut h, name, g, take cut, now, mut out);
            return
        },
        Error(_) => return,
    }
    list.push(mut out, cutover_ack(name, cut))
    let discarded = match cut.candidate_end {
        None => Some(cut.candidate),
        Some(_) => None
    }
    if let Some(c) = discarded {
        list.push(mut out, Stop(child_of(name, g.incarnation, c)))
    }
    list.push(mut out, Command(child_of(name, g.incarnation, cut.old), HostExport(attempt_bytes(retry.attempt), true)))
    // A request row that cannot be read gives no fates, which can only hold the retry for
    // the operator, never settle a held run another way.
    let retry_held = match deploy_held(h, retry.request) {
        Ok(take f) => take f,
        Error(_) => runner.fate.none(),
    }
    let p = Prep(attempt: retry.attempt, retry_of: retry.retry_of, incarnation: g.incarnation, old: cut.old, assembly: clone(retry.assembly), image: clone(retry.image), target: string.new(), n_place: 0u64, stage: Exporting, describe: clone(retry.describe), release: clone(retry.release), helper: None, aborting: false, discarded: discarded, old_exported: list.new(), preview: clone(retry.preview), scanned: false, required_entries: list.new(), old_binding: clone(retry.old_binding), held: retry_held, holding: false)
    let mut v = vol_read(h, name)
    v.cut = None
    v.prep = Some(p)
    vol_put(mut h, name, take v)
}

// §14.3 "Undecided": neither OLD's answer nor the candidate's open proves the install.
// Both ends are discarded and the group is probed at a new generation, first with NEW's
// assembly at the deploy's activation (`probe_pair`).
fn undecided(mut h: Host, name: String, take cut: Cut, mut out: List[launcher.Request]) waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(name), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found_d) = st(store.fetch(tx, call_env.1 .deploys, call_env.0))? else {
                return Error(Missing("deploy"))
            }
            let mut d = found_d
            d.outcome = Undecided(ProbeNew)
            put_deploy(mut tx, call_env.1, call_env.0, d, StoreClass)
        })
    }
    if let Error(_) = decided(mut h, take made) {
        return
    }
    list.push(mut out, cutover_ack(name, cut))
    let mut v = vol_read(h, name)
    v.cut = None
    v.run = None
    vol_put(mut h, name, take v)
    let _ = launch_dirty(mut h, name, true, mut out)
}

fn cutover_result(mut h: Host, c: launcher.Child, attempt: launcher.Attempt, reply: runner.HostReply, now: Now, mut out: List[launcher.Request]) waits {
    let Some(g) = current(h, c) else {
        return
    }
    let Serving(gen) = c.role else {
        return
    }
    let name = string.from(c.group.name)
    let Some(take pending) = cut_of(h, name) else {
        return
    }
    let mut cut = take pending
    if gen != cut.old || attempt.hi != cut.attempt.hi || attempt.lo != cut.attempt.lo {
        return
    }
    let ack_old = cut.held && !is_none(cut.old_end)
    let ack_new = cut.held && !is_none(cut.candidate_end)
    let candidate = child_of(name, cut.incarnation, cut.candidate)
    cut.held = false
    match reply {
        PlaceInstalled(v, _) => {
            if v != cut.activation {
                return
            }
            commit_cut(mut h, name, take cut, now, mut out)
        },
        PlaceDrift => drift(mut h, name, g, take cut, now, mut out),
        PlaceRefused(why) => abort_cut(mut h, name, g, take cut, why, now, mut out),
        PlaceUncertain => {
            cut.old_ended = true
            finish_ended_cut(mut h, name, take cut, now, mut out)
        },
        _ => return,
    }
    if let Some(remaining) = cut_of(h, name) {
        if remaining.held {
            return
        }
    }
    if ack_old {
        list.push(mut out, Acknowledge(clone(c)))
    }
    if ack_new {
        list.push(mut out, Acknowledge(take candidate))
    }
}

// §14.5 "Genesis": the group's genesis start installs the store's first activation under
// LOCK before the host records it on that start's PlaceOpened, so a crash between them
// leaves the store activated and the group at 0, and every start at 0 is refused
// NotCurrent(Active(v)). The refusal names v: the group records it once, and the start's
// end relaunches at v outside backoff. The open at v still proves it: that start compares
// the store's Describe with its own and only its PlaceOpened records the store. A group
// with a recorded activation never adopts, so a store another image activated keeps the
// group failing with the refusal as its cause.
fn adopt_genesis(mut h: Host, name: String, incarnation: u64, version: u64) -> bool waits {
    if version == 0u64 {
        return false
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(incarnation), store.copy_env(name), store.copy_env(version), store.copy_env(t)), fn(mut tx, call_env) -> Result[bool, Refused] {
            let Some(found) = st(store.fetch(tx, call_env.3 .groups, call_env.1))? else {
                return Ok(false)
            }
            if found.incarnation != call_env.0 || found.activation != 0u64 {
                return Ok(false)
            }
            if let Some(_) = found.retiring {
                return Ok(false)
            }
            let mut g = found
            g.activation = call_env.2
            st(store.put(mut tx, call_env.3 .groups, call_env.1, g))?
            Ok(true)
        })
    }
    match decided(mut h, take made) {
        Ok(true) => true,
        _ => false,
    }
}

fn refused(mut h: Host, c: launcher.Child, why: launcher.Refusal, now: Now, mut out: List[launcher.Request]) waits {
    let Some(_) = current(h, c) else {
        return
    }
    let Serving(gen) = c.role else {
        helper_done(mut h, c, false, refusal_text(why), mut out);
        return
    }
    let name = string.from(c.group.name)
    if run_gen(h, name) != Some(gen) {
        return
    }
    match why {
        Retiring => set_run(mut h, name, None),
        Held => unsuccessful(mut h, name, "held", true, now, mut out),
        Image(e) => unsuccessful(mut h, name, e, true, now, mut out),
        Spawn(e) => unsuccessful(mut h, name, e, true, now, mut out),
        // These do not change with a retry: the group is failing until an operator acts.
        UnknownGroup => unsuccessful(mut h, name, "unknown group", false, now, mut out),
        Mismatch => unsuccessful(mut h, name, "mismatch", false, now, mut out),
        Unbuilt(e) => unsuccessful(mut h, name, e, false, now, mut out),
    }
}

fn stop_or_ack(c: launcher.Child, p: launcher.Phase, mut out: List[launcher.Request]) {
    match p {
        Started => list.push(mut out, Stop(clone(c))),
        Exited(_) => list.push(mut out, Acknowledge(clone(c))),
    }
}

fn dirty_names(h: Host) -> List[String] waits {
    let read_handle = result.unwrap(store.reader(h.db, 0u64))
    let mut names: List[String] = list.new()
    let Ok(take scanned) = store.scan(read_handle, store.snapshot(h.db), h.t.dirty, Unbounded, Unbounded) else {
        return names
    }
    let mut rows = take scanned
    while let Ok(Some((name, _))) = store.next(read_handle, mut rows) {
        list.push(mut names, take name)
    }
    names
}

fn binds(h: Host, mut out: List[launcher.Request]) waits {
    let read_handle = result.unwrap(store.reader(h.db, 0u64))
    let Ok(take scanned) = store.scan(read_handle, store.snapshot(h.db), h.t.groups, Unbounded, Unbounded) else {
        return
    }
    let mut rows = take scanned
    while let Ok(Some((name, g))) = store.next(read_handle, mut rows) {
        list.push(mut out, bind_request(name, g))
    }
}

// Restart and reconnect (§14.5): adopt the authoritative children and pending-deploy
// candidates the inventory names, stop the rest, probe each Dirty row left without a child,
// and wake each readable listener and each passed due time.
fn reconcile(mut h: Host, children: List[launcher.ChildState], readable: List[launcher.Group], held: List[launcher.CutoverKey], now: Now, mut out: List[launcher.Request]) waits {
    if !h.binds_sent {
        binds(h, mut out)
        h.binds_sent = true
    }
    h.collecting = Unfenced
    let mut names: List[String] = list.new()
    for (name, _) in h.vol {
        list.push(mut names, string.from(name))
    }
    for name in names {
        interrupted(mut h, name)
        let mut v = vol_read(h, name)
        v.run = None
        v.cut = None
        v.prep = None
        v.reprobe = false
        v.cause = None
        v.deposed = None
        vol_put(mut h, name, take v)
    }
    let mut answers: List[(launcher.Child, runner.HostReply)] = list.new()
    let mut ends: List[(launcher.Child, launcher.End, bool)] = list.new()
    for s in children {
        let c = s.child
        let Some(_) = current(h, c) else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        let Serving(gen) = c.role else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        let name = string.from(c.group.name)
        let Some(w) = wake_row(h, name) else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        let authoritative = match w.wake {
            Dirty(a) => a == gen,
            Clean(_) => false
        }
        let pending: Option[DeployRow] = match store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.deploys, name) {
            Ok(Some(d)) => Some(d),
            _ => None
        }
        let candidate = match pending {
            Some(d) => match d.outcome {
                Pending => d.candidate == gen,
                _ => false
            },
            None => false,
        }
        if authoritative {
            let Some(selected) = s.selection else {
                stop_or_ack(c, s.phase, mut out);
                continue
            }
            set_run(mut h, name, Some(Run(gen: gen, phase: Started, selected: clone(selected))))
        } else if candidate {
            let Some(d) = pending else {
                continue
            }
            let old_child = child_of(name, c.group.incarnation, d.old)
            let mut kept = false
            for k in held {
                if launcher.same_child(k.old, old_child) && k.attempt.hi == d.attempt.hi && k.attempt.lo == d.attempt.lo {
                    kept = true
                }
            }
            let cut = Cut(attempt: d.attempt, incarnation: c.group.incarnation, old: d.old, candidate: gen, activation: d.activation, old_end: None, old_ended: false, opened: false, candidate_end: None, held: kept, release: clone(d.release))
            set_cut(mut h, name, Some(cut))
        } else {
            stop_or_ack(c, s.phase, mut out);
            continue
        }
        if let Some(reply) = s.answer {
            list.push(mut answers, (clone(c), clone(reply)))
        }
        if let Exited(e) = s.phase {
            list.push(mut ends, (clone(c), e, authoritative))
        }
    }
    for (c, reply) in answers {
        placed(mut h, c, reply, now, mut out)
    }
    for (c, e, authoritative) in ends {
        let unclean = authoritative && is_none(clean_report(e))
        let name = string.from(c.group.name)
        let gen = match c.role {
            Serving(g) => g,
            _ => 0u64,
        }
        ended(mut h, c, e, now, mut out)
        // An authoritative child that ended without a clean report while no host watched
        // left its row Dirty with no child: the start its end applied is the restart's
        // probe of that row (§14.5).
        if unclean {
            if let Some(next) = run_gen(h, name) {
                if next > gen {
                    h.probes += 1u64
                }
            }
        }
    }
    resume_cuts(mut h, held, mut out)
    for name in dirty_names(h) {
        let Ok(Some(g)) = group_row(h, name) else {
            continue
        }
        if let Some(_) = g.retiring {
            list.push(mut out, Retire(group_of(name, g.incarnation)));
            continue
        }
        let v = vol_read(h, name)
        let idle = is_none(v.run) && is_none(v.cut) && is_none(v.retry_at) && is_none(v.deposed)
        if idle {
            let _ = launch_dirty(mut h, name, true, mut out)
        }
    }
    for g in readable {
        let _ = wake_cause(mut h, g.name, Arrival, now, mut out)
    }
    due_wakes(mut h, now, mut out)
}

// A new session resumes each Pending deploy row (§14.5). With the candidate known, the
// identical cutover command is sent again: the launcher forwards it if it never did, stays
// silent while OLD holds it, and otherwise returns OLD's saved answer or Uncertain. With
// OLD running and no candidate, the candidate's Start goes out again first. With neither,
// nothing proves the install: the row is Undecided and the group is probed. A cutover the
// launcher holds for no Pending row is acknowledged.
fn resume_cuts(mut h: Host, held: List[launcher.CutoverKey], mut out: List[launcher.Request]) waits {
    let read_handle = result.unwrap(store.reader(h.db, 0u64))
    let mut rows: List[(String, DeployRow)] = list.new()
    let mut preps: List[(String, DeployRow)] = list.new()
    {
        let Ok(take scanned) = store.scan(read_handle, store.snapshot(h.db), h.t.deploys, Unbounded, Unbounded) else {
            return
        }
        let mut found = take scanned
        while let Ok(Some((name, d))) = store.next(read_handle, mut found) {
            match d.outcome {
                Pending => list.push(mut rows, (string.from(name), clone(d))),
                Preparing => list.push(mut preps, (string.from(name), clone(d))),
                _ => (),
            }
        }
    }
    // A Preparing row proves no cutover was sent (ADVICE step 6). OLD, if it still runs, may
    // hold the export or a kept import: it is sent HostAbort, and the row records the
    // failure once OLD answers or ends. With OLD gone, nothing holds either.
    for (name, d) in preps {
        let Ok(Some(g)) = group_row(h, name) else {
            continue
        }
        let p = Prep(attempt: d.attempt, retry_of: d.retry_of, incarnation: g.incarnation, old: d.old, assembly: clone(d.assembly), image: clone(d.image), target: string.new(), n_place: 0u64, stage: Aborting("interrupted before the cutover", InvalidClass), describe: list.new(), release: list.new(), helper: None, aborting: run_gen(h, name) == Some(d.old), discarded: None, old_exported: list.new(), preview: clone(d.preview), scanned: false, required_entries: list.new(), old_binding: clone(d.old_binding), held: runner.fate.none(), holding: false)
        if p.aborting {
            list.push(mut out, Command(child_of(name, g.incarnation, d.old), abort_command(d.attempt, d.retry_of)))
        }
        prep_finish(mut h, name, take p)
    }
    let mut resumed: List[launcher.CutoverKey] = list.new()
    for (name, d) in rows {
        let Ok(Some(g)) = group_row(h, name) else {
            continue
        }
        if let Some(_) = cut_of(h, name) {
            list.push(mut out, cutover_command(name, g.incarnation, d.old, d.attempt, d.digest, !is_none(d.retry_of)))
        } else if run_gen(h, name) == Some(d.old) {
            let Ok(cfg) = host_config(h) else {
                continue
            }
            let cut = Cut(attempt: d.attempt, incarnation: g.incarnation, old: d.old, candidate: d.candidate, activation: d.activation, old_end: None, old_ended: false, opened: false, candidate_end: None, held: false, release: clone(d.release))
            set_cut(mut h, name, Some(cut))
            list.push(mut out, serving_launch(name, g, d.candidate, d.activation, d.assembly, cfg.idle_ms, Some(d.old), Some(d.activation)))
            list.push(mut out, cutover_command(name, g.incarnation, d.old, d.attempt, d.digest, !is_none(d.retry_of)))
        } else {
            let made = {
                let t = view h.t
                store.run(mut h.db, None, (store.copy_env(name), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
                    let Some(found_d) = st(store.fetch(tx, call_env.1 .deploys, call_env.0))? else {
                        return Error(Missing("deploy"))
                    }
                    let mut row = found_d
                    row.outcome = Undecided(ProbeNew)
                    put_deploy(mut tx, call_env.1, call_env.0, row, StoreClass)
                })
            }
            let _ = decided(mut h, take made)
            continue
        }
        list.push(mut resumed, launcher.CutoverKey(old: child_of(name, g.incarnation, d.old), attempt: d.attempt))
    }
    for k in held {
        let mut live = false
        for r in resumed {
            if launcher.same_child(r.old, k.old) && r.attempt.hi == k.attempt.hi && r.attempt.lo == k.attempt.lo {
                live = true
            }
        }
        if !live {
            list.push(mut out, CutoverAck(clone(k.old), k.attempt))
        }
    }
}

// Wakes every Clean row whose due time has passed, in due order.
fn due_wakes(mut h: Host, now: Now, mut out: List[launcher.Request]) waits {
    let read_handle = result.unwrap(store.reader(h.db, 0u64))
    let mut due: List[DueKey] = list.new()
    {
        let Ok(take scanned) = store.scan(read_handle, store.snapshot(h.db), h.t.due, Unbounded, Unbounded) else {
            return
        }
        let mut rows = take scanned
        while let Ok(Some((k, _))) = store.next(read_handle, mut rows) {
            if k.at > now.wall_ms {
                break
            }
            if let None = queued_at(h, k.name) {
                list.push(mut due, clone(k))
            }
        }
    }
    for k in due {
        let _ = wake_cause(mut h, k.name, Due(k.at), now, mut out)
    }
}

fn launched(mut h: Host, c: launcher.Child) {
    let Serving(gen) = c.role else {
        return
    }
    let name = string.from(c.group.name)
    let v = vol_read(h, name)
    let Vol(run: take running, ..) = take v
    let Some(r) = take running else {
        return
    }
    if r.gen != gen {
        return
    }
    if let Requested = r.phase {
        set_run(mut h, name, Some(Run(gen: gen, phase: Started, selected: clone(r.selected))))
    }
}

fn bind_failed(mut h: Host, g: launcher.Group, why: String) waits {
    let mut v = vol_read(h, g.name)
    v.failing = true
    v.last = string.from(why)
    // A registering group's listener is its registration's: without it the request fails.
    let genesis = match replace(mut v.admit, None) {
        Some(adm) if adm.genesis => Some(adm),
        other => {
            v.admit = other
            None
        },
    }
    vol_put(mut h, g.name, take v)
    if let Some(adm) = genesis {
        list.push(mut h.later, Release(adm.attempt))
        fail_request(mut h, adm.request, InvalidClass, joined("the listener could not be bound: ", why))
    }
}

// Applies one launcher event in stream order, and returns the requests it decided.
pub fn event(mut h: Host, take e: launcher.Event, now: Now) -> List[launcher.Request] waits {
    h.clock_s = now.wall_ms / 1000u64
    let mut out: List[launcher.Request] = list.new()
    match take e {
        Inventory(children, readable, held) => reconcile(mut h, children, readable, held, now, mut out),
        Launched(c, Started) => launched(mut h, c),
        Launched(c, Exited(fin)) => ended(mut h, c, fin, now, mut out),
        Refused(c, why) => refused(mut h, c, why, now, mut out),
        Ended(c, fin) => ended(mut h, c, fin, now, mut out),
        Arrived(g) => {
            if let Ok(Some(r)) = group_row(h, g.name) {
                if r.incarnation == g.incarnation {
                    let _ = wake_cause(mut h, g.name, Arrival, now, mut out)
                }
            }
        },
        Bound(_) => (),
        BindFailed(g, why) => bind_failed(mut h, g, why),
        Closed(_) => (),
        Retired(g) => finish_retire(mut h, g, now, mut out),
        Placed(c, reply) => placed(mut h, c, reply, now, mut out),
        CutoverResult(c, attempt, reply) => cutover_result(mut h, c, attempt, reply, now, mut out),
        Answered(c, said) => answered(mut h, c, said, mut out),
        Need(a, keys, done) => needed(mut h, a, keys, done),
        Admitted(a, root, summary, display) => admitted(mut h, a, root, summary, display, mut out),
        Assembled(a, key, digest, fetch, asm) => assembled(mut h, a, key, digest, fetch, asm, now, mut out),
        AdmissionFailed(a, why) => unadmitted(mut h, a, why),
        Fenced => fenced(mut h, now, mut out),
        Collected(_) => {
            if let Fencing = h.collecting {
                h.collecting = Unfenced
            }
        },
    }
    notify(mut h)
    drain_later(mut h, mut out)
    turned(mut h, take out)
}

fn drain_later(mut h: Host, mut out: List[launcher.Request]) {
    for take q in replace(mut h.later, list.new()) {
        list.push(mut out, take q)
    }
}

// Due times and backoff retries that have come.
pub fn tick(mut h: Host, now: Now) -> List[launcher.Request] waits {
    h.clock_s = now.wall_ms / 1000u64
    let mut out: List[launcher.Request] = list.new()
    let mut retry: List[String] = list.new()
    for (name, v) in h.vol {
        if let Some(at) = v.retry_at {
            if at <= now.mono_ns {
                list.push(mut retry, string.from(name))
            }
        }
    }
    for name in retry {
        let _ = launch_dirty(mut h, name, false, mut out)
    }
    expire_source_uploads(mut h, now.wall_ms)
    due_wakes(mut h, now, mut out)
    drain_later(mut h, mut out)
    turned(mut h, take out)
}

// The due-time wait follows the minimum of the due index without the queued rows; the
// backoff timer follows the earliest retry (§14.3, §14.5).
pub fn timers(h: Host) -> Timers waits {
    let read_handle = result.unwrap(store.reader(h.db, 0u64))
    let mut wall: Option[u64] = None
    if let Ok(take scanned) = store.scan(read_handle, store.snapshot(h.db), h.t.due, Unbounded, Unbounded) {
        let mut rows = take scanned
        while let Ok(Some((k, _))) = store.next(read_handle, mut rows) {
            if let None = queued_at(h, k.name) {
                wall = Some(k.at);
                break
            }
        }
    }
    let mut mono: Option[u64] = None
    for (_, v) in h.vol {
        if let Some(adm) = v.admit {
            if let Some(receive) = adm.receive {
                wall = Some(match wall {
                    Some(at) => order.min(at, receive.deadline_ms),
                    None => receive.deadline_ms,
                })
            }
        }
        if let Some(at) = v.retry_at {
            let earlier = match mono {
                Some(m) => at < m,
                None => true
            }
            if earlier {
                mono = Some(at)
            }
        }
    }
    Timers(wall_ms: wall, mono_ns: mono)
}

// An operator request to a group: wake it first (§14.3); a full host answers `Full`.
pub fn wake(mut h: Host, name: String, now: Now) -> Result[List[launcher.Request], Refused] waits {
    let r = wake_turn(mut h, name, now)
    turned_result(mut h, take r)
}

fn wake_turn(mut h: Host, name: String, now: Now) -> Result[List[launcher.Request], Refused] waits {
    let mut out: List[launcher.Request] = list.new()
    wake_cause(mut h, name, Operator, now, mut out)?
    Ok(take out)
}

// §14.2 "Lowering the bound": below the current `dirty` is refused `Busy(dirty)`. A raise
// retries the queue.
pub fn set_max_places(mut h: Host, n: u64, now: Now) -> Result[List[launcher.Request], Refused] waits {
    let r = set_max_places_turn(mut h, n, now)
    turned_result(mut h, take r)
}

fn set_max_places_turn(mut h: Host, n: u64, now: Now) -> Result[List[launcher.Request], Refused] waits {
    if n == 0u64 {
        return Error(Missing("max_places"))
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(n), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let held = meta_of(tx, call_env.1)?.dirty + reserved_except(tx, call_env.1, "")?
            if call_env.0 < held {
                return Error(Busy(held))
            }
            let mut c = config_of(tx, call_env.1)?
            c.max_places = call_env.0
            st(store.put(mut tx, call_env.1 .config, 0u64, c))
        })
    }
    decided(mut h, take made)?
    let mut out: List[launcher.Request] = list.new()
    retry_queue(mut h, now, mut out)
    Ok(take out)
}

pub fn set_quota(mut h: Host, tenant: String, q: Quota, now: Now) -> Result[List[launcher.Request], Refused] waits {
    let r = set_quota_turn(mut h, tenant, q, now)
    turned_result(mut h, take r)
}

fn set_quota_turn(mut h: Host, tenant: String, q: Quota, now: Now) -> Result[List[launcher.Request], Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(q), store.copy_env(tenant), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let u = usage_of(tx, call_env.2, call_env.1)?
            if call_env.0 .live < u.live {
                return Error(Busy(u.live))
            }
            if call_env.0 .groups < u.groups {
                return Error(Busy(u.groups))
            }
            st(store.put(mut tx, call_env.2 .quotas, call_env.1, call_env.0))
        })
    }
    decided(mut h, take made)?
    let mut out: List[launcher.Request] = list.new()
    retry_queue(mut h, now, mut out)
    Ok(take out)
}

// A deploy whose NEW assembly is published and synced (launch.md "Hot deploy"): its
// admission was answered `Assembled`. The Preparing row is
// durable before the attempt's reservation is released and before any helper runs; it
// keeps the row `Dirty(g)` naming OLD. The host then runs OLD's describe child, NEW's preview
// child over OLD's exported list, OLD's export, NEW's prepare child on it and OLD's import,
// checking each answer before the next step. `image` is NEW's image digest and `target`
// and `n_place` the verified recipe's, which the preview must report.
fn prepare(mut h: Host, name: String, request: Bytes, attempt: launcher.Attempt, assembly: Bytes, image_digest: Bytes, target: String, n_place: u64, grants: launcher.Grants, fetch_ns: u64, assemble_ns: u64) -> Result[List[launcher.Request], Refused] waits {
    let required = deploy_required_entries(h, request)?
    let held = deploy_held(h, request)?
    let shown = operator.Preview(grants: clone(grants), entries: list.new(), triggers: operator.no_triggers(), migration: None)
    let Some(g) = group_row(h, name)? else {
        return Error(Unknown)
    }
    if let Some(_) = g.retiring {
        return Error(Retiring)
    }
    let Some(old) = run_gen(h, name) else {
        return Error(Busy(0u64))
    }
    let v = vol_read(h, name)
    if !is_none(v.cut) || !is_none(v.prep) || !is_none(v.backup) {
        return Error(Busy(old))
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(assemble_ns), store.copy_env(assembly), store.copy_env(attempt), store.copy_env(fetch_ns), store.copy_env(image_digest), store.copy_env(name), store.copy_env(request), store.copy_env(shown), store.copy_env(g), store.copy_env(old), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(w) = st(store.fetch(tx, call_env.10 .wake, call_env.5))? else {
                return Error(Unknown)
            }
            let Dirty(a) = w.wake else {
                return Error(Busy(w.gen))
            }
            if a != call_env.9 {
                return Error(Busy(a))
            }
            // An unresolved deploy's row is the only record of its NEW root.
            if let Some(prior) = st(store.fetch(tx, call_env.10 .deploys, call_env.5))? {
                match prior.outcome {
                    Installed => (),
                    Failed(_) => (),
                    _ => return Error(Busy(a)),
                }
            }
            let row = DeployRow(request: clone(call_env.6), attempt: call_env.2, assembly: clone(call_env.1), image: clone(call_env.4), old_assembly: clone(call_env.8 .assembly), old_binding: None, old_claim: claim_for_generation(call_env.8, a), binding: None, new_retained: retains(call_env.8, call_env.1), digest: list.new(), release: list.new(), activation: 0u64, old: call_env.9, candidate: 0u64, outcome: Preparing, describe: list.new(), retry_of: None, fetch_ns: Some(call_env.3), assemble_ns: Some(call_env.0), preview: clone(call_env.7))
            put_deploy(mut tx, call_env.10, call_env.5, row, StoreClass)
        })
    }
    let _ = decided(mut h, take made)?
    let mode: launcher.Mode = DescribeMode(attempt)
    let describer = launcher.Child(group: group_of(name, g.incarnation), role: launcher.role_of(mode))
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Release(attempt))
    list.push(mut out, helper_launch(name, g, g.assembly, take mode))
    let p = Prep(attempt: attempt, retry_of: None, incarnation: g.incarnation, old: old, assembly: clone(assembly), image: clone(image_digest), target: string.from(target), n_place: n_place, stage: Describing, describe: list.new(), release: list.new(), helper: Some(take describer), aborting: false, discarded: None, old_exported: list.new(), preview: take shown, scanned: false, required_entries: take required, old_binding: None, held: take held, holding: false)
    set_prep(mut h, name, Some(take p))
    Ok(take out)
}

// The admission deadline starts at Begin and survives reattachment
// (launch.md "The operator socket").
const ADMISSION_MS: u64 = 600000u64

fn sorted_unique(xs: List[String]) -> bool {
    let mut i = 1u64
    while i < list.len(xs) {
        match order.compare(xs[i - 1u64], xs[i]) {
            Less => (),
            _ => return false,
        }
        i += 1u64
    }
    true
}

// Why request d's admission cannot start now for group `name`, if it cannot.
fn admission_refusal(h: Host, name: String, g: GroupRow, d: Bytes, input: operator.Input, foreign: List[String], exec: List[String]) -> Option[(operator.Class, String)] waits {
    if let Some(_) = g.retiring {
        return Some((UnknownGroupClass, "the group is retiring"))
    }
    if !sorted_unique(foreign) || !sorted_unique(exec) {
        return Some((InvalidClass, "Foreign and Exec lines are sorted and without duplicates"))
    }
    // Submitted source is checked here, before the launcher compiles it: its grants are
    // part of the recipe it publishes (launch.md "What an untrusted author submits").
    let manifest: Option[launcher.Manifest] = match input {
        SourceInput(b) => {
            let Some(m) = launcher.manifest_of(b) else {
                return Some((InvalidClass, "the source is not a manifest within its limits"))
            }
            Some(take m)
        },
        _ => None,
    }
    if let Untrusted = g.author {
        let Some(t) = manifest else {
            return Some((DeniedClass, "an untrusted author publishes source only, without Foreign or Exec grants"))
        }
        if list.len(foreign) > 0u64 || list.len(exec) > 0u64 {
            return Some((DeniedClass, "an untrusted author publishes source only, without Foreign or Exec grants"))
        }
        for grant in t.grants {
            if launcher.foreign_or_exec(grant) {
                return Some((DeniedClass, "an untrusted author's source binds no Foreign or Exec grant"))
            }
        }
        if let Some(_) = g.record {
            return Some((DeniedClass, "an untrusted author's group has no recording build"))
        }
    }
    let v = vol_read(h, name)
    if !is_none(v.cut) || !is_none(v.prep) {
        return Some((BusyClass, "another deploy of the group is running"))
    }
    if let Some(adm) = v.admit {
        if adm.request != d && !is_none(running_admission(v)) {
            return Some((BusyClass, "another deploy of the group is admitting"))
        }
    }
    match deploy_outcome(h, name) {
        Some(Preparing) => Some((BusyClass, "another deploy of the group is preparing")),
        Some(Pending) => Some((BusyClass, "another deploy of the group is pending")),
        Some(Undecided(_)) => Some((BusyClass, "another deploy of the group is undecided")),
        _ => None,
    }
}

fn say(mut h: Host, conn: u64, take a: operator.Answer, is_last: bool) {
    list.push(mut h.outbox, Sent(conn: conn, answer: take a, close: is_last))
}

fn refuse(mut h: Host, conn: u64, class: operator.Class, why: String) {
    say(mut h, conn, ErrorAnswer(class, string.from(why)), true)
}

fn request_row(h: Host, d: Bytes) -> Result[Option[RequestRow], Refused] waits {
    st(store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.requests, d))
}

// The admission of request d, if the host runs one.
fn admission_of(h: Host, name: String, d: Bytes) -> Option[Admitting] {
    match vol_read(h, name).admit {
        Some(adm) if adm.request == d => match adm.stage {
            Uploading(_, _) => Some(clone(adm)),
            Confirming(_) => Some(clone(adm)),
            Assembling => Some(clone(adm)),
            Receiving => Some(clone(adm)),
            _ => None,
        },
        _ => None,
    }
}

fn phase_bytes(p: operator.Phase) -> Bytes {
    let codec: std.codec.Codec[operator.Phase] = std.codec.of()
    let mut out: Bytes = list.new()
    let _ = std.codec.encode(codec, p, mut out)
    out
}

fn state_answer(d: Bytes, r: RequestRow, p: operator.Phase) -> operator.Answer {
    StateAnswer(clone(d), clone(r.group), clone(r.input), clone(p))
}

// Sends each attached request's phase to its owner when it changed, and ends the exchange
// at a terminal phase.
fn notify(mut h: Host) waits {
    let mut owned: List[(Bytes, u64)] = list.new()
    for (d, conn) in h.owners {
        list.push(mut owned, (clone(d), conn))
    }
    for (d, conn) in owned {
        let Ok(Some(r)) = request_row(h, d) else {
            continue
        }
        let p = phase_of(h, d, r)
        let b = phase_bytes(p)
        let same = match map.get(h.shown, d) {
            Some(x) => x == b,
            None => false
        }
        if same {
            continue
        }
        let done = operator.terminal(p)
        say(mut h, conn, state_answer(d, r, p), done)
        let _ = map.remove(mut h.shown, d)
        if done {
            let _ = map.remove(mut h.owners, d)
        } else {
            map.insert(mut h.shown, clone(d), take b)
        }
    }
}

// The owner of request d, if one is attached.
fn owner_of(h: Host, d: Bytes) -> Option[u64] {
    match map.get(h.owners, d) {
        Some(c) => Some(c),
        None => None
    }
}

fn fresh_attempt(mut tx: store.Tx, t: Tables) -> Result[launcher.Attempt, Refused] {
    let mut meta = meta_of(tx, t)?
    let a = launcher.Attempt(hi: 0u64, lo: meta.next_attempt)
    meta.next_attempt += 1u64
    st(store.put(mut tx, t.meta, 0u64, meta))?
    Ok(a)
}

// Records request d's terminal phase and ends it as the group's active request.
// The same transaction deletes every blob of the request's group that neither the installed
// manifest nor an unfinished request names (launch.md "Source by content").
fn finish_request(mut tx: store.Tx, t: Tables, name: String, d: Bytes, p: operator.Phase) -> Result[(), Refused] {
    let mut incarnation: Option[u64] = None
    if let Some(found) = st(store.fetch(tx, t.requests, d))? {
        let mut r = found
        incarnation = Some(r.group.incarnation)
        r.status = Done(clone(p))
        st(store.put(mut tx, t.requests, d, r))?
    }
    if let Some(x) = st(store.fetch(tx, t.active, name))? {
        if x == d {
            let _ = st(store.delete(mut tx, t.active, name))?
        }
    }
    if let Some(i) = incarnation {
        sweep_group_blobs(mut tx, t, name, i)?
    }
    Ok(())
}

// Writes the group's deploy row; an Installed or Failed outcome is also its request's
// terminal phase, in the same transaction.
fn put_deploy(mut tx: store.Tx, t: Tables, name: String, row: DeployRow, class: operator.Class) -> Result[(), Refused] {
    let done: Option[operator.Phase] = match row.outcome {
        Installed => Some(InstalledPhase(row.activation, clone(row.assembly), report_of(row, MeasurementLost))),
        Failed(why) => Some(FailedPhase(class, string.from(why), report_of(row, NotStarted))),
        _ => None,
    }
    if let Some(p) = done {
        finish_request(mut tx, t, name, row.request, p)?
    }
    st(store.put(mut tx, t.deploys, name, row))
}

// Fails request d durably before it reached a deploy row.
// A failed registration also removes its group, which never had a wake row, in the same
// transaction, and the group's listener is closed.
fn fail_request(mut h: Host, d: Bytes, class: operator.Class, why: String) waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(class), store.copy_env(d), store.copy_env(why), store.copy_env(t)), fn(mut tx, call_env) -> Result[Option[launcher.Group], Refused] {
            let Some(r) = st(store.fetch(tx, call_env.3 .requests, call_env.1))? else {
                return Ok(None)
            }
            if let Done(_) = r.status {
                return Ok(None)
            }
            finish_request(mut tx, call_env.3, r.group.name, call_env.1, FailedPhase(call_env.0, string.from(call_env.2), operator.no_report()))?
            let Some(RegisterAsk(_, _, _, _, _)) = operator.decode_ask(r.begin) else {
                return Ok(None)
            }
            if let Some(_) = st(store.fetch(tx, call_env.3 .wake, r.group.name))? {
                return Ok(None)
            }
            let Some(g) = st(store.fetch(tx, call_env.3 .groups, r.group.name))? else {
                return Ok(None)
            }
            if g.incarnation != r.group.incarnation {
                return Ok(None)
            }
            let _ = st(store.delete(mut tx, call_env.3 .groups, r.group.name))?
            let mut u = usage_of(tx, call_env.3, g.tenant)?
            u.groups -= 1u64
            st(store.put(mut tx, call_env.3 .usage, g.tenant, u))?
            Ok(Some(clone(r.group)))
        })
    }
    if let Ok(Some(grp)) = decided(mut h, take made) {
        let mut v = vol_read(h, grp.name)
        v.admit = None
        vol_put(mut h, grp.name, take v)
        list.push(mut h.later, Close(grp))
    }
}

// Whether the group's active request, other than d, still holds the group: running, or
// attached, or awaiting input before its deadline. One that lost its input past its
// deadline fails here.
fn active_holds(mut h: Host, name: String, d: Bytes, now: Now) -> bool waits {
    let Ok(Some(other)) = store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.active, name) else {
        return false
    }
    if other == d {
        return false
    }
    let Ok(Some(r)) = request_row(h, other) else {
        return false
    }
    match r.status {
        Done(_) => return false,
        Held(_) => {
            fail_request(mut h, other, DeniedClass, "a later deploy superseded it while it awaited a decision")
            return false
        },
        Open => (),
    }
    if !is_none(admission_of(h, name, other)) || !is_none(deploy_of(h, name, other)) || !is_none(owner_of(h, other)) {
        return true
    }
    if now.wall_ms < r.deadline_ms {
        return true
    }
    fail_request(mut h, other, InvalidClass, "the admission deadline passed before its input arrived")
    false
}

// A Begin (launch.md "The operator socket"): a known D with the same bytes attaches to its
// request, with other bytes is a Conflict; a new D is recorded durably, then the group is
// woken if cold and its admission opened.
fn begin(mut h: Host, conn: u64, ask: operator.Ask, d: Bytes, g: launcher.Group, input: operator.BeginInput, foreign: List[String], exec: List[String], held: runner.fate.Fates, now: Now, mut out: List[launcher.Request]) waits {
    if list.len(d) != 16u64 {
        refuse(mut h, conn, ProtocolClass, "a request ID is 16 bytes")
        return
    }
    let (requested, gate) = operator.begin_parts(input)
    if !runner.fate.well_formed(held) {
        refuse(mut h, conn, InvalidClass, "held entries are not sorted by path or repeat a path")
        return
    }
    let canonical = operator.ask_bytes(ask)
    let found = match request_row(h, d) {
        Ok(f) => f,
        Error(_) => {
            refuse(mut h, conn, StoreClass, "the catalog could not be read")
            return
        },
    }
    if let Some(r) = found {
        if r.begin != canonical {
            refuse(mut h, conn, ConflictClass, "this request ID names another deploy")
            return
        }
        reattach(mut h, conn, d, r, now, mut out)
        return
    }
    let row = match group_row(h, g.name) {
        Ok(Some(row)) if row.incarnation == g.incarnation => row,
        _ => {
            refuse(mut h, conn, UnknownGroupClass, "no group has this name and incarnation")
            return
        },
    }
    if registering(h, g.name) {
        refuse(mut h, conn, UnknownGroupClass, "the group is still registering")
        return
    }
    if let Some((class, why)) = admission_refusal(h, g.name, row, d, requested, foreign, exec) {
        refuse(mut h, conn, class, why)
        return
    }
    if active_holds(mut h, g.name, d, now) {
        refuse(mut h, conn, BusyClass, "another deploy of the group is running")
        return
    }
    let made = {
        let t = view h.t
        let name = view g.name
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(g), store.copy_env(requested), store.copy_env(now), store.copy_env(canonical), store.copy_env(t), store.copy_env(name)), fn(mut tx, call_env) -> Result[launcher.Attempt, Refused] {
            if let Some(x) = st(store.fetch(tx, call_env.5 .active, call_env.6))? {
                if x != call_env.0 {
                    return Error(Busy(0u64))
                }
            }
            let a = fresh_attempt(mut tx, call_env.5)?
            st(store.put(mut tx, call_env.5 .requests, call_env.0, RequestRow(begin: clone(call_env.4), group: clone(call_env.1), input: clone(call_env.2), attempt: a, deadline_ms: call_env.3 .wall_ms + ADMISSION_MS, status: Open, approved: launcher.no_grants(), fates: None, shown: list.new(), gate: None)))?
            st(store.put(mut tx, call_env.5 .active, call_env.6, call_env.0))?
            Ok(a)
        })
    }
    let a = match decided(mut h, take made) {
        Ok(a) => a,
        Error(e) => {
            refuse(mut h, conn, class_of(e), refused_text(e))
            return
        },
    }
    map.insert(mut h.owners, clone(d), conn)
    open_input(mut h, g.name, row, d, a, requested, gate, foreign, exec, launcher.no_grants(), now.wall_ms + ADMISSION_MS, now, mut out)
}

// Wakes a cold group, then opens request d's admission; a wake that cannot start fails d.
fn admit_request(mut h: Host, name: String, g: GroupRow, d: Bytes, a: launcher.Attempt, input: launcher.Input, foreign: List[String], exec: List[String], added: launcher.Grants, deadline_ms: u64, now: Now, mut out: List[launcher.Request]) waits {
    // A registering group has no place to wake: its admission has no OLD.
    let genesis = registering(h, name)
    if !genesis && is_none(run_gen(h, name)) {
        if let Error(e) = wake_cause(mut h, name, Operator, now, mut out) {
            fail_request(mut h, d, class_of(e), refused_text(e))
            return
        }
    }
    start_admission(mut h, name, g, d, a, input, foreign, exec, added, genesis, deadline_ms, mut out)
}

// A group registers until its first release is assembled: its catalog row exists and its
// listener is bound, but it has no wake row, so nothing wakes it (launch.md "Registering a
// group").
fn registering(h: Host, name: String) -> bool waits {
    is_none(wake_row(h, name))
}

// An identical Begin for a known D. While another connection owns it, this one gets the
// snapshot and closes. A request still running is observed; one that lost its input gets a
// fresh attempt and repeats admission from byte zero, under its original deadline.
fn reattach(mut h: Host, conn: u64, d: Bytes, r: RequestRow, now: Now, mut out: List[launcher.Request]) waits {
    let p = phase_of(h, d, r)
    if let Some(other) = owner_of(h, d) {
        if other != conn {
            say(mut h, conn, state_answer(d, r, p), true)
            return
        }
    }
    if let Done(_) = r.status {
        say(mut h, conn, state_answer(d, r, p), true)
        return
    }
    let name = string.from(r.group.name)
    let _ = map.remove(mut h.shown, d)
    map.insert(mut h.owners, clone(d), conn)
    // A request awaiting a decision is shown its phase and waits for a Decide.
    if let Held(_) = r.status {
        return
    }
    if !is_none(admission_of(h, name, d)) || !is_none(deploy_of(h, name, d)) {
        return
    }
    if now.wall_ms >= r.deadline_ms {
        fail_request(mut h, d, InvalidClass, "the admission deadline passed before its input arrived")
        return
    }
    let g = match group_row(h, name) {
        Ok(Some(g)) if g.incarnation == r.group.incarnation => g,
        _ => {
            fail_request(mut h, d, UnknownGroupClass, "the group was removed")
            return
        },
    }
    let Some((input, gate, foreign, exec)) = admission_ask(r.begin) else {
        fail_request(mut h, d, StoreClass, "the recorded request does not decode")
        return
    }
    if let Some((class, why)) = admission_refusal(h, name, g, d, input, foreign, exec) {
        let _ = map.remove(mut h.owners, d)
        refuse(mut h, conn, class, why)
        return
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(t)), fn(mut tx, call_env) -> Result[launcher.Attempt, Refused] {
            let Some(found) = st(store.fetch(tx, call_env.1 .requests, call_env.0))? else {
                return Error(Missing("request"))
            }
            let mut row = found
            let a = fresh_attempt(mut tx, call_env.1)?
            row.attempt = a
            st(store.put(mut tx, call_env.1 .requests, call_env.0, row))?
            Ok(a)
        })
    }
    let a = match decided(mut h, take made) {
        Ok(a) => a,
        Error(e) => {
            let _ = map.remove(mut h.owners, d)
            refuse(mut h, conn, class_of(e), refused_text(e))
            return
        },
    }
    open_input(mut h, name, g, d, a, input, gate, foreign, exec, clone(r.approved), r.deadline_ms, now, mut out)
}

// The group of request d's upload under attempt `a`, when connection `conn` owns it and
// its input is still open.
fn upload_of(h: Host, conn: u64, d: Bytes, a: launcher.Attempt) -> Option[String] waits {
    if owner_of(h, d) != Some(conn) {
        return None
    }
    let Ok(Some(r)) = request_row(h, d) else {
        return None
    }
    let name = string.from(r.group.name)
    let Some(adm) = admission_of(h, name, d) else {
        return None
    }
    let uploading = match adm.stage {
        Uploading(_, _) => !adm.ended,
        Receiving => true,
        _ => false,
    }
    if uploading && same_attempt(adm.attempt, a) {
        Some(name)
    } else {
        None
    }
}

fn digest_bytes(text: String) -> Bytes {
    let digest = sha256.hash(string.as_bytes(text))
    let mut out: Bytes = list.with_capacity(32u64)
    for i in 0u64 .. 32u64 {
        list.push(mut out, digest[i])
    }
    out
}

// Confirm(D, A, hash): the owner confirms the display whose UTF-8 SHA-256 is `hash`.
fn confirm(mut h: Host, conn: u64, d: Bytes, a: launcher.Attempt, hash: Bytes, mut out: List[launcher.Request]) waits {
    if owner_of(h, d) != Some(conn) {
        refuse(mut h, conn, ProtocolClass, "this connection does not own the request")
        return
    }
    let Ok(Some(r)) = request_row(h, d) else {
        refuse(mut h, conn, UnknownRequestClass, "no request has this ID")
        return
    }
    let name = string.from(r.group.name)
    let Some(adm) = admission_of(h, name, d) else {
        refuse(mut h, conn, ProtocolClass, "the request awaits no confirmation")
        return
    }
    let shown = match adm.stage {
        Confirming(text) => Some(string.from(text)),
        _ => None,
    }
    let Some(text) = shown else {
        refuse(mut h, conn, ProtocolClass, "the request awaits no confirmation")
        return
    }
    if !same_attempt(adm.attempt, a) {
        refuse(mut h, conn, ProtocolClass, "a stale attempt")
        return
    }
    if digest_bytes(text) != hash {
        refuse(mut h, conn, DeniedClass, "the confirmation is not of the display shown")
        return
    }
    set_stage(mut h, name, Assembling)
    list.push(mut out, Assemble(a))
}

// The operator connection `conn` closed. A request it owned whose input or confirmation was
// still missing loses its admission: the launcher releases the attempt, and an identical
// Begin repeats it under a fresh one. A complete input goes on without its observer.
pub fn detach(mut h: Host, conn: u64) -> List[launcher.Request] waits {
    backup_detach(mut h, conn)
    let mut out: List[launcher.Request] = list.new()
    let mut mine: List[Bytes] = list.new()
    for (d, c) in h.owners {
        if c == conn {
            list.push(mut mine, clone(d))
        }
    }
    for d in mine {
        let _ = map.remove(mut h.owners, d)
        let _ = map.remove(mut h.shown, d)
        let Ok(Some(r)) = request_row(h, d) else {
            continue
        }
        let name = string.from(r.group.name)
        let Some(adm) = admission_of(h, name, d) else {
            continue
        }
        // A source still receiving its blobs has no launcher attempt to release; the blobs
        // that arrived stay rooted by the unfinished request.
        let missing = match adm.stage {
            Uploading(_, _) => !adm.ended,
            Confirming(_) => true,
            Receiving => true,
            _ => false,
        }
        if missing {
            if is_none(adm.receive) {
                list.push(mut out, Release(adm.attempt))
            }
            let mut v = vol_read(h, name)
            v.admit = None
            vol_put(mut h, name, take v)
        }
    }
    out
}

// The answers decided since the last call, in order.
pub fn outgoing(mut h: Host) -> List[Sent] {
    let sent = replace(mut h.outbox, list.new())
    if h.failed {
        return list.new()
    }
    sent
}

// Where the group's latest admission stands, if it has had one since the host started.
pub fn deploy_admission(h: Host, name: String) -> Option[AdmitStage] {
    match vol_read(h, name).admit {
        Some(d) => Some(clone(d.stage)),
        None => None,
    }
}

// The attempt of an admission the launcher still runs.
fn running_admission(v: Vol) -> Option[launcher.Attempt] {
    match v.admit {
        Some(d) => match d.stage {
            Uploading(_, _) => Some(d.attempt),
            Confirming(_) => Some(d.attempt),
            Assembling => Some(d.attempt),
            _ => None,
        },
        None => None,
    }
}

// A new launcher session cancelled every running admission. Its request keeps waiting for
// input; an attached owner is told to send the same Begin again, which repeats admission
// under a fresh attempt.
fn interrupted(mut h: Host, name: String) {
    let mut v = vol_read(h, name)
    if is_none(running_admission(v)) {
        return
    }
    let Some(adm) = replace(mut v.admit, None) else {
        return
    }
    vol_put(mut h, name, take v)
    if let Some(conn) = owner_of(h, adm.request) {
        let _ = map.remove(mut h.owners, adm.request)
        let _ = map.remove(mut h.shown, adm.request)
        refuse(mut h, conn, BusyClass, "the launcher session ended during admission: send the same Begin again")
    }
}

// The group whose running admission is attempt `a`.
fn admitting_group(h: Host, a: launcher.Attempt) -> Option[String] {
    for (name, v) in h.vol {
        if let Some(x) = running_admission(v) {
            if same_attempt(x, a) {
                return Some(string.from(name))
            }
        }
    }
    None
}

fn set_stage(mut h: Host, name: String, take stage: AdmitStage) {
    let mut v = vol_read(h, name)
    let Some(take adm) = replace(mut v.admit, None) else {
        return
    }
    let mut d = take adm
    d.stage = take stage
    v.admit = Some(take d)
    vol_put(mut h, name, take v)
}

fn needed(mut h: Host, a: launcher.Attempt, keys: List[launcher.Wanted], done: bool) {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    let Some(d) = vol_read(h, name).admit else {
        return
    }
    let requested = match d.stage {
        Uploading(sofar, _) => sofar + list.len(keys),
        _ => return,
    }
    set_stage(mut h, name, Uploading(requested, done))
    if let Some(conn) = owner_of(h, d.request) {
        say(mut h, conn, NeedAnswer(clone(d.request), a, clone(keys), done), false)
    }
}

// NEW is assembled and its reservation held: the deploy goes on to Preparing.
fn assembled(mut h: Host, a: launcher.Attempt, key: Bytes, digest: Bytes, fetch_ns: u64, assemble_ns: u64, now: Now, mut out: List[launcher.Request]) waits {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    let Some(d) = vol_read(h, name).admit else {
        return
    }
    let assembling = match d.stage {
        Assembling => true,
        _ => false,
    }
    let Some(summary) = d.summary else {
        return
    }
    if !assembling {
        return
    }
    let mut v = vol_read(h, name)
    v.admit = None
    vol_put(mut h, name, take v)
    if d.genesis {
        install_first(mut h, name, d, key, fetch_ns, assemble_ns, now, mut out)
        return
    }
    match prepare(mut h, name, d.request, a, key, digest, summary.target, summary.n_place, summary.grants, fetch_ns, assemble_ns) {
        Ok(more) => {
            for q in more {
                list.push(mut out, clone(q))
            }
        },
        Error(e) => {
            let mut w = vol_read(h, name)
            w.admit = Some(Admitting(request: clone(d.request), attempt: a, incarnation: d.incarnation, approved: clone(d.approved), stage: Rejected(refused_text(e)), summary: Some(clone(summary)), ended: true, genesis: false, receive: None))
            vol_put(mut h, name, take w)
            list.push(mut out, Release(a))
            fail_request(mut h, d.request, class_of(e), refused_text(e))
        },
    }
}

// A registering group's first release is assembled. One transaction makes it the group's
// current assembly at activation 0, gives the group its wake row and records the request
// Installed; then the attempt's reservation ends and the group is woken, which starts its
// genesis on the empty store (RUNNER-SPEC §14.1). A host too full to start it leaves the
// group cold, for its first connection to wake.
fn install_first(mut h: Host, name: String, d: Admitting, key: Bytes, fetch_ns: u64, assemble_ns: u64, now: Now, mut out: List[launcher.Request]) waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(assemble_ns), store.copy_env(d), store.copy_env(fetch_ns), store.copy_env(key), store.copy_env(name), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found) = st(store.fetch(tx, call_env.5 .groups, call_env.4))? else {
                return Error(Unknown)
            }
            if found.incarnation != call_env.1 .incarnation {
                return Error(Unknown)
            }
            if let Some(_) = st(store.fetch(tx, call_env.5 .wake, call_env.4))? {
                return Error(Exists)
            }
            let mut g = found
            g.assembly = clone(call_env.3)
            g.activation = 0u64
            g.source = installed_source(tx, call_env.5, call_env.1 .request)?
            st(store.put(mut tx, call_env.5 .groups, call_env.4, g))?
            st(store.put(mut tx, call_env.5 .wake, call_env.4, WakeRow(wake: Clean(None), gen: 0u64)))?
            let report = operator.Report(fetch_ns: Some(call_env.2), assemble_ns: Some(call_env.0), pause: NotStarted, preview: operator.no_preview())
            finish_request(mut tx, call_env.5, call_env.4, call_env.1 .request, InstalledPhase(0u64, clone(call_env.3), report))
        })
    }
    list.push(mut out, Release(d.attempt))
    match decided(mut h, take made) {
        Ok(()) => {
            let _ = wake_cause(mut h, name, Operator, now, mut out)
        },
        Error(e) => fail_request(mut h, d.request, class_of(e), refused_text(e)),
    }
}

// A Register (launch.md "Registering a group"). A known D attaches as a Begin's does. A new
// D records, in one transaction, the group under a new incarnation with no wake row, its
// usage, the request and its attempt; the host then binds the group's listener and opens the
// admission of its first release, with no OLD. Nothing wakes the group until that release
// is assembled. No two groups share a store.
fn register(mut h: Host, conn: u64, ask: operator.Ask, d: Bytes, spec: operator.Registration, requested: operator.Input, foreign: List[String], exec: List[String], now: Now, mut out: List[launcher.Request]) waits {
    if list.len(d) != 16u64 {
        refuse(mut h, conn, ProtocolClass, "a request ID is 16 bytes")
        return
    }
    let canonical = operator.ask_bytes(ask)
    let found = match request_row(h, d) {
        Ok(f) => f,
        Error(_) => {
            refuse(mut h, conn, StoreClass, "the catalog could not be read")
            return
        },
    }
    if let Some(r) = found {
        if r.begin != canonical {
            refuse(mut h, conn, ConflictClass, "this request ID names another request")
            return
        }
        reattach(mut h, conn, d, r, now, mut out)
        return
    }
    if spec.name == "" || spec.tenant == "" || spec.listen == "" || spec.store == "" {
        refuse(mut h, conn, InvalidClass, "a registration names its group, tenant, listener and store")
        return
    }
    if let Some((class, why)) = admission_refusal(h, spec.name, registered_row(spec, 0u64), d, requested, foreign, exec) {
        refuse(mut h, conn, class, why)
        return
    }
    // An earlier registration of this name that lost its input past its deadline fails
    // here and removes its group; one still running holds the name.
    if let Ok(Some(_)) = group_row(h, spec.name) {
        if registering(h, spec.name) && active_holds(mut h, spec.name, d, now) {
            refuse(mut h, conn, BusyClass, "the group is still registering")
            return
        }
    }
    if store_owned(h, spec.store) {
        refuse(mut h, conn, ConflictClass, "another group owns this store")
        return
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(requested), store.copy_env(now), store.copy_env(spec), store.copy_env(canonical), store.copy_env(t)), fn(mut tx, call_env) -> Result[(GroupRow, launcher.Attempt), Refused] {
            if let Some(_) = st(store.fetch(tx, call_env.5 .groups, call_env.3 .name))? {
                return Error(Exists)
            }
            check_front_registration(tx, call_env.5, call_env.3 .listen, call_env.3 .front)?
            let mut u = usage_of(tx, call_env.5, call_env.3 .tenant)?
            if let Some(q) = quota_of(tx, call_env.5, call_env.3 .tenant)? {
                if u.groups >= q.groups {
                    return Error(Full(Groups(string.from(call_env.3 .tenant), q.groups)))
                }
            }
            let mut meta = meta_of(tx, call_env.5)?
            let g = registered_row(call_env.3, meta.next_incarnation)
            meta.next_incarnation += 1u64
            st(store.put(mut tx, call_env.5 .meta, 0u64, meta))?
            st(store.put(mut tx, call_env.5 .groups, call_env.3 .name, g))?
            u.groups += 1u64
            st(store.put(mut tx, call_env.5 .usage, call_env.3 .tenant, u))?
            let a = fresh_attempt(mut tx, call_env.5)?
            st(store.put(mut tx, call_env.5 .requests, call_env.0, RequestRow(begin: clone(call_env.4), group: group_of(call_env.3 .name, g.incarnation), input: clone(call_env.1), attempt: a, deadline_ms: call_env.2 .wall_ms + ADMISSION_MS, status: Open, approved: launcher.no_grants(), fates: None, shown: list.new(), gate: None)))?
            st(store.put(mut tx, call_env.5 .active, call_env.3 .name, call_env.0))?
            Ok((g, a))
        })
    }
    let (g, a) = match decided(mut h, take made) {
        Ok(pair) => pair,
        Error(e) => {
            refuse(mut h, conn, class_of(e), refused_text(e))
            return
        },
    }
    map.insert(mut h.owners, clone(d), conn)
    list.push(mut out, bind_request(spec.name, g))
    open_input(mut h, spec.name, g, d, a, requested, false, foreign, exec, launcher.no_grants(), now.wall_ms + ADMISSION_MS, now, mut out)
}

// A registering group's catalog row: no assembly yet, activation 0.
fn registered_row(spec: operator.Registration, incarnation: u64) -> GroupRow {
    let author: Author = if spec.trusted {
        Trusted
    } else {
        Untrusted
    }
    GroupRow(tenant: string.from(spec.tenant), workdir: string.from(spec.workdir), author: author, listen: string.from(spec.listen), front: clone(spec.front), store: string.from(spec.store), memory: spec.memory, assembly: list.new(), activation: 0u64, retained: list.new(), recovery: None, store_id: None, store_claim: None, incarnation: incarnation, retiring: None, args: clone(spec.args), record: clone(spec.record), packages: clone(spec.packages), source: None)
}

// Whether a catalog group already holds store directory `path`.
fn store_owned(h: Host, path: String) -> bool waits {
    let read_handle = result.unwrap(store.reader(h.db, 0u64))
    let Ok(take scanned) = store.scan(read_handle, store.snapshot(h.db), h.t.groups, Unbounded, Unbounded) else {
        return true
    }
    let mut rows = take scanned
    loop {
        match store.next(read_handle, mut rows) {
            Ok(Some((_, g))) => if g.store == path {
                return true
            },
            Ok(None) => return false,
            Error(_) => return true,
        }
    }
}

// Starts a collection (launch.md "Collect"). The launcher takes its fence and answers
// `Fenced`; the host then reads every root from one catalog snapshot taken after that
// answer and sends them in `Collect`. One runs at a time, and only after the session's
// inventory is reconciled.
pub fn collect(mut h: Host) -> Result[List[launcher.Request], Refused] {
    if !h.binds_sent {
        return Error(Busy(0u64))
    }
    match h.collecting {
        Unfenced => (),
        _ => return Error(Busy(0u64)),
    }
    h.collecting = Fencing
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, CollectBegin)
    Ok(take out)
}

fn fenced(mut h: Host, now: Now, mut out: List[launcher.Request]) waits {
    match h.collecting {
        Fencing => (),
        _ => return,
    }
    // Roots it cannot read remove nothing: the fence ends now, not with the session, so
    // the launcher's deferred releases apply and a later collection can run.
    match catalog_roots(h, now.wall_ms / 1000u64) {
        Ok(roots) => list.push(mut out, Collect(clone(roots))),
        Error(_) => list.push(mut out, CollectAbort),
    }
}

fn helper_launch(name: String, g: GroupRow, assembly: Bytes, take mode: launcher.Mode) -> launcher.Request {
    Start(launcher.Launch(group: group_of(name, g.incarnation), assembly: clone(assembly), workdir: string.from(g.workdir), args: list.new(), mode: take mode, recording: None))
}

fn prep_of(h: Host, name: String) -> Option[Prep] {
    match map.get(h.vol, name) {
        Some(v) => clone(v.prep),
        None => None,
    }
}

fn set_prep(mut h: Host, name: String, take p: Option[Prep]) {
    let mut v = match map.remove(mut h.vol, name) {
        Some(take v) => take v,
        None => empty_vol(),
    }
    v.prep = take p
    map.insert(mut h.vol, string.from(name), take v)
}

fn is_helper(p: Prep, c: launcher.Child) -> bool {
    match p.helper {
        Some(k) => launcher.same_child(k, c),
        None => false
    }
}

// An export directory name: nonempty ASCII letters, digits, `-` and `_`.
fn export_name(name: String) -> bool {
    let b = string.as_bytes(name)
    if list.len(b) == 0u64 {
        return false
    }
    for c in b {
        let ok = (c >= 48u8 && c <= 57u8) || (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 45u8 || c == 95u8
        if !ok {
            return false
        }
    }
    true
}

fn refusal_text(why: launcher.Refusal) -> String {
    match why {
        Held => "held",
        Retiring => "retiring",
        UnknownGroup => "unknown group",
        Mismatch => "mismatch",
        Image(e) => string.from(e),
        Spawn(e) => string.from(e),
        Unbuilt(e) => string.from(e),
    }
}

fn is_none[T](o: Option[T]) -> bool {
    match o {
        None => true,
        Some(_) => false
    }
}

fn joined(head: String, tail: String) -> String {
    let mut out = string.from(head)
    string.push(mut out, tail)
    out
}

fn abort_command(attempt: launcher.Attempt, retry_of: Option[launcher.Attempt]) -> runner.HostCommand {
    let previous = match retry_of {
        Some(a) => Some(attempt_bytes(a)),
        None => None,
    }
    HostAbort(attempt_bytes(attempt), take previous)
}

// A Preparing deploy fails. Once OLD was sent its export, OLD is sent HostAbort for the
// attempt, and a live helper is stopped; the row stays Preparing until OLD answered
// PlaceAborted or ended and the helper ended, so a host lost before then aborts again.
// `old_live` is false when OLD's end is what failed it: its export ended with it.
fn prep_fail(mut h: Host, name: String, take p: Prep, why: String, old_live: bool, mut out: List[launcher.Request]) waits {
    prep_fail_as(mut h, name, take p, why, InvalidClass, old_live, mut out)
}

fn prep_fail_as(mut h: Host, name: String, take p: Prep, why: String, class: operator.Class, old_live: bool, mut out: List[launcher.Request]) waits {
    let mut q = take p
    let exported = match q.stage {
        Describing => false,
        Previewing(_) => false,
        Aborting(_, _) => q.aborting,
        _ => true
    }
    let keep_why = match q.stage {
        Aborting(_, _) => true,
        _ => false
    }
    q.aborting = exported && old_live
    if q.aborting && !keep_why {
        list.push(mut out, Command(child_of(name, q.incarnation, q.old), abort_command(q.attempt, q.retry_of)))
    }
    if !keep_why {
        if let Some(c) = q.helper {
            list.push(mut out, Stop(clone(c)))
        }
        q.stage = Aborting(string.from(why), clone(class))
    }
    prep_finish(mut h, name, take q)
}

// The abort is complete: the row records `Failed(why)` and the group may deploy again.
fn prep_finish(mut h: Host, name: String, take p: Prep) waits {
    let waiting = match p.helper {
        Some(_) => true,
        None => p.aborting
    }
    let failed: Option[(String, operator.Class)] = match p.stage {
        Aborting(w, class) => Some((string.from(w), clone(class))),
        _ => None
    }
    let Some((why, class)) = failed else {
        set_prep(mut h, name, Some(take p));
        return
    }
    if waiting {
        set_prep(mut h, name, Some(take p));
        return
    }
    let attempt = p.attempt
    let made = {
        let t = view h.t
        let shown = view p.preview
        let holding = p.holding
        store.run(mut h.db, None, (store.copy_env(name), store.copy_env(class), store.copy_env(why), store.copy_env(attempt), store.copy_env(t), store.copy_env(shown), store.copy_env(holding)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found_d) = st(store.fetch(tx, call_env.4 .deploys, call_env.0))? else {
                return Ok(())
            }
            let mut d = found_d
            let ours = match d.outcome {
                Preparing => d.attempt.hi == call_env.3 .hi && d.attempt.lo == call_env.3 .lo,
                _ => false
            }
            if !ours {
                return Ok(())
            }
            d.outcome = Failed(string.from(call_env.2))
            d.preview = clone(call_env.5)
            if call_env.6 {
                // The attempt ends, and in the same transaction its request holds for the
                // operator's decision on the report: it stays open and keeps the group.
                hold_prepared(mut tx, call_env.4, d.request, d.preview)?
                return st(store.put(mut tx, call_env.4 .deploys, call_env.0, d))
            }
            put_deploy(mut tx, call_env.4, call_env.0, d, call_env.1)
        })
    }
    if let Error(_) = decided(mut h, take made) {
        set_prep(mut h, name, Some(take p));
        return
    }
    set_prep(mut h, name, None)
}

// A helper child of a Preparing deploy answered on its standard output.
fn answered(mut h: Host, c: launcher.Child, said: Bytes, mut out: List[launcher.Request]) waits {
    let Some(g) = current(h, c) else {
        return
    }
    let name = string.from(c.group.name)
    let Some(found) = prep_of(h, name) else {
        return
    }
    let mut p = found
    if !is_helper(p, c) {
        return
    }
    match p.stage {
        Describing => match old_entries(said) {
            Some((entries, exported, old_binding)) => {
                let mode: launcher.Mode = PreviewMode(p.attempt, take entries)
                p.helper = Some(launcher.Child(group: clone(c.group), role: launcher.role_of(mode)))
                p.stage = Previewing(list.len(exported))
                p.old_exported = take exported
                p.old_binding = Some(take old_binding)
                list.push(mut out, helper_launch(name, g, p.assembly, take mode))
                set_prep(mut h, name, Some(take p))
            },
            None => prep_fail(mut h, name, take p, "describe: OLD's answer is not a Describe", true, mut out),
        },
        Previewing(count) => match previewed(said, p, count) {
            Ok((describe, release, exported)) => {
                p.describe = describe
                p.release = release
                p.preview.entries = entry_diff(p.old_exported, exported)
                if !keeps_entries(p.required_entries, exported) {
                    prep_fail_as(mut h, name, take p, "candidate removes or changes a required release entry", UncompiledClass, true, mut out)
                    return
                }
                p.helper = None
                p.stage = Exporting
                list.push(mut out, Command(child_of(name, p.incarnation, p.old), HostExport(attempt_bytes(p.attempt), false)))
                set_prep(mut h, name, Some(take p))
            },
            Error(why) => prep_fail(mut h, name, take p, why, true, mut out),
        },
        // The prepare child answers with its trigger report just before it ends.
        PrepareRunning(_) => match trigger_report(said) {
            Some(report) => {
                p.preview.triggers = report
                p.scanned = true
                set_prep(mut h, name, Some(take p))
            },
            None => prep_fail(mut h, name, take p, "prepare: the trigger report is malformed", true, mut out),
        },
        _ => set_prep(mut h, name, Some(take p)),
    }
}

// A helper child of a Preparing deploy ended (`why` its status) or was refused.
fn helper_done(mut h: Host, c: launcher.Child, succeeded: bool, why: String, mut out: List[launcher.Request]) waits {
    let name = string.from(c.group.name)
    let Some(found) = prep_of(h, name) else {
        return
    }
    let mut p = found
    if !is_helper(p, c) {
        return
    }
    p.helper = None
    match p.stage {
        PrepareRunning(head) => if succeeded && !p.scanned {
            prep_fail(mut h, name, take p, "prepare ended without its trigger report", true, mut out)
        } else if succeeded && needs_decision(h, name, p.preview.triggers) {
            // RUNNER-SPEC §14.6 "No default": OLD's export is aborted once, nothing is
            // imported, and the request holds for the operator's decision on the report.
            p.holding = true
            prep_fail(mut h, name, take p, "held for the operator's decision", true, mut out)
        } else if succeeded {
            p.stage = Importing(head)
            list.push(mut out, Command(child_of(name, p.incarnation, p.old), HostImport(clone(p.describe), clone(p.release), clone(p.image), fates_bytes(p.held))))
            set_prep(mut h, name, Some(take p))
        } else {
            prep_fail(mut h, name, take p, joined("prepare: ", why), true, mut out)
        },
        Describing => prep_fail(mut h, name, take p, joined("describe ended without an answer: ", why), true, mut out),
        Previewing(_) => prep_fail(mut h, name, take p, joined("preview ended without an answer: ", why), true, mut out),
        Aborting(_, _) => prep_finish(mut h, name, take p),
        _ => set_prep(mut h, name, Some(take p)),
    }
}

// OLD answered a command of a Preparing deploy. A notice, or an answer for another stage,
// changes nothing.
fn prep_placed(mut h: Host, name: String, take p: Prep, reply: runner.HostReply, mut out: List[launcher.Request]) waits {
    let mut q = take p
    match q.stage {
        Exporting => match reply {
            PlaceExported(head, export) => if export_name(export) {
                let Ok(Some(g)) = group_row(h, name) else {
                    prep_fail(mut h, name, take q, "the group changed before the cutover", true, mut out);
                    return
                }
                let Some(held) = runner.fate.encode(q.held) else {
                    prep_fail(mut h, name, take q, "prepare: the fates do not encode", true, mut out);
                    return
                }
                let mode: launcher.Mode = PrepareMode(q.attempt, string.from(export), take held)
                q.helper = Some(launcher.Child(group: group_of(name, q.incarnation), role: launcher.role_of(mode)))
                q.stage = PrepareRunning(head)
                q.scanned = false
                list.push(mut out, helper_launch(name, g, q.assembly, take mode))
                set_prep(mut h, name, Some(take q))
            } else {
                prep_fail(mut h, name, take q, "export: an invalid export name", true, mut out)
            },
            PlaceRefused(why) => prep_fail(mut h, name, take q, joined("export: ", why), true, mut out),
            _ => set_prep(mut h, name, Some(take q)),
        },
        Importing(head) => match reply {
            PlaceImported(digest, migration) => if list.len(digest) != 32u64 {
                prep_fail(mut h, name, take q, "import: a malformed prepared digest", true, mut out)
            } else if let Some(_) = q.discarded {
                q.preview.migration = Some(migration_of(migration))
                q.stage = Imported(head, clone(digest))
                set_prep(mut h, name, Some(take q))
            } else {
                q.preview.migration = Some(migration_of(migration))
                prep_pending(mut h, name, take q, head, digest, mut out)
            },
            PlaceRefused(why) => prep_fail(mut h, name, take q, joined("import: ", why), true, mut out),
            _ => set_prep(mut h, name, Some(take q)),
        },
        Aborting(_, _) => match reply {
            PlaceAborted => {
                q.aborting = false
                prep_finish(mut h, name, take q)
            },
            _ => set_prep(mut h, name, Some(take q)),
        },
        _ => set_prep(mut h, name, Some(take q)),
    }
}

// OLD kept the import (ADVICE step 5): Pending replaces Preparing in one transaction that
// re-checks the attempt and `Dirty(g)`, allocates the candidate's gen c and records
// v = head + 1. Only then does the candidate start and OLD get the cutover.
fn prep_pending(mut h: Host, name: String, take p: Prep, head: u64, digest: Bytes, mut out: List[launcher.Request]) waits {
    let activation = head + 1u64
    let now_s = h.clock_s
    let made = {
        let t = view h.t
        let q = view p
        store.run(mut h.db, None, (store.copy_env(digest), store.copy_env(name), store.copy_env(activation), store.copy_env(now_s), store.copy_env(t), store.copy_env(q)), fn(mut tx, call_env) -> Result[(GroupRow, u64, bool), Refused] {
            let Some(g) = st(store.fetch(tx, call_env.4 .groups, call_env.1))? else {
                return Error(Unknown)
            }
            if let Some(_) = g.retiring {
                return Error(Retiring)
            }
            if g.incarnation != call_env.5 .incarnation {
                return Error(Unknown)
            }
            let Some(w) = st(store.fetch(tx, call_env.4 .wake, call_env.1))? else {
                return Error(Unknown)
            }
            let Dirty(a) = w.wake else {
                return Error(Busy(w.gen))
            }
            if a != call_env.5 .old {
                return Error(Busy(a))
            }
            let Some(found_d) = st(store.fetch(tx, call_env.4 .deploys, call_env.1))? else {
                return Error(Missing("deploy"))
            }
            let mut d = found_d
            let ours = match d.outcome {
                Preparing => d.attempt.hi == call_env.5 .attempt.hi && d.attempt.lo == call_env.5 .attempt.lo,
                _ => false
            }
            if !ours {
                return Error(Missing("deploy"))
            }
            let c = w.gen + 1u64
            st(store.put(mut tx, call_env.4 .wake, call_env.1, WakeRow(wake: Dirty(a), gen: c)))?
            d.digest = clone(call_env.0)
            d.release = clone(call_env.5 .release)
            d.describe = clone(call_env.5 .describe)
            d.old_binding = clone(call_env.5 .old_binding)
            let Some(description) = runner.decode_description(call_env.5 .describe) else {
                return Error(Missing("preview description"))
            }
            let Some(take binding) = binding_of(description) else {
                return Error(Missing("release identity"))
            }
            d.binding = Some(take binding)
            d.activation = call_env.2
            d.candidate = c
            d.outcome = Pending
            d.preview = clone(call_env.5 .preview)
            pin_start(mut tx, call_env.4, g, c, d.assembly, call_env.3)?
            let retried = !is_none(d.retry_of)
            put_deploy(mut tx, call_env.4, call_env.1, d, StoreClass)?
            Ok((g, c, retried))
        })
    }
    let (g, c, retried) = match decided(mut h, take made) {
        Ok(found) => found,
        Error(_) => {
            prep_fail(mut h, name, take p, "the group changed before the cutover", true, mut out);
            return
        }
    }
    let Ok(cfg) = host_config(h) else {
        return
    }
    let cut = Cut(attempt: p.attempt, incarnation: g.incarnation, old: p.old, candidate: c, activation: activation, old_end: None, old_ended: false, opened: false, candidate_end: None, held: false, release: clone(p.release))
    let mut v = vol_read(h, name)
    v.cut = Some(cut)
    v.prep = None
    vol_put(mut h, name, take v)
    list.push(mut out, serving_launch(name, g, c, activation, p.assembly, cfg.idle_ms, Some(p.old), Some(activation)))
    list.push(mut out, cutover_command(name, g.incarnation, p.old, p.attempt, digest, retried))
}

pub fn deploy_outcome(h: Host, name: String) -> Option[DeployOutcome] waits {
    match store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.deploys, name) {
        Ok(Some(take d)) => {
            let DeployRow(outcome: take o, ..) = take d;
            Some(take o)
        },
        _ => None
    }
}

fn finish_retire(mut h: Host, grp: launcher.Group, now: Now, mut out: List[launcher.Request]) waits {
    let Ok(Some(g)) = group_row(h, grp.name) else {
        return
    }
    if g.incarnation != grp.incarnation {
        return
    }
    let Some(disposition) = g.retiring else {
        return
    }
    let name = string.from(grp.name)
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(g), store.copy_env(disposition), store.copy_env(name), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            drop_rows(mut tx, call_env.3, call_env.2, call_env.0, None, true, call_env.1)
        })
    }
    if let Error(_) = decided(mut h, take made) {
        return
    }
    let _ = map.remove(mut h.vol, name)
    list.push(mut out, Close(clone(grp)))
    retry_queue(mut h, now, mut out)
}

// Makes a recording pin durable. The host calls this before it starts the recorded
// serving process, so a recording never runs without the pin that names its assembly.
pub fn keep_pin(mut h: Host, id: Bytes, assembly: Bytes, expires: u64) -> Result[(), Refused] waits {
    let r = keep_pin_turn(mut h, id, assembly, expires)
    turned_result(mut h, take r)
}

fn keep_pin_turn(mut h: Host, id: Bytes, assembly: Bytes, expires: u64) -> Result[(), Refused] waits {
    if list.len(id) != 16u64 {
        return Error(Missing("recording id"))
    }
    if list.len(assembly) != 32u64 {
        return Error(Missing("assembly"))
    }
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(assembly), store.copy_env(expires), store.copy_env(id), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            st(store.put(mut tx, call_env.3 .pins, call_env.2, Pin(assembly: clone(call_env.0), expires: call_env.1)))
        })
    }
    decided(mut h, take made)
}

// An operator removes a recording pin. Replay of that recording then finds it `Gone`, even
// while another root keeps its image.
pub fn forget_pin(mut h: Host, id: Bytes) -> Result[(), Refused] waits {
    let r = forget_pin_turn(mut h, id)
    turned_result(mut h, take r)
}

fn forget_pin_turn(mut h: Host, id: Bytes) -> Result[(), Refused] waits {
    let made = {
        let t = view h.t
        store.run(mut h.db, None, (store.copy_env(id), store.copy_env(t)), fn(mut tx, call_env) -> Result[(), Refused] {
            let _ = st(store.delete(mut tx, call_env.1 .pins, call_env.0))?
            Ok(())
        })
    }
    decided(mut h, take made)
}

// The pin lookup replay makes first (launch.md "Host assembly"): `Found(assembly)` while
// `now` is before the expiry, in Unix seconds, and `Gone` from the expiry on or when no
// pin exists. A store error is an error, never `Gone`.
pub fn resolve_pin(h: Host, id: Bytes, now: u64) -> Result[operator.Resolved, Refused] waits {
    Ok(pin_answer(st(store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.pins, id))?, now))
}

// The one pin rule both owners apply: the live host and the offline reader.
fn pin_answer(p: Option[Pin], now: u64) -> operator.Resolved {
    match p {
        Some(found) if now < found.expires => Found(clone(found.assembly)),
        _ => Gone,
    }
}

// The offline reader (launch.md "Replaying a recording"): while no host runs, and with the
// caller holding the launcher's lifetime lock and the catalog's LOCK, it recovers the
// catalog in `d` read-only (STORE §11.19: no genesis, repair, cleanup or write) and gives
// the live host's lookup at `now`, in Unix seconds. A store error is an error, never Gone.
pub fn resolve_offline(d: Dir, c: Clock, id: Bytes, now: u64) -> Result[operator.Resolved, store.Error] waits {
    let reader = store.open_read_only(d, c, result.unwrap(store.sized(Directory, 2147483648u64)))?
    let pins: store.Table[Bytes, Pin] = store.read_only_table(reader, "platform.pins", std.codec.key_bytes(), std.codec.of())?
    Ok(pin_answer(store.read_only_get(reader, pins, id)?, now))
}

// Every group the host lists, retiring ones included.
pub fn group_names(h: Host) -> List[String] waits {
    let read_handle = result.unwrap(store.reader(h.db, 0u64))
    let mut names: List[String] = list.new()
    let Ok(take scanned) = store.scan(read_handle, store.snapshot(h.db), h.t.groups, Unbounded, Unbounded) else {
        return names
    }
    let mut rows = take scanned
    while let Ok(Some((name, _))) = store.next(read_handle, mut rows) {
        list.push(mut names, take name)
    }
    names
}

// The serving child the host has accepted as Ready for this group, if any: its gen.
pub fn serving_ready(h: Host, name: String) -> Option[u64] {
    match vol_read(h, name).run {
        Some(r) => match r.phase {
            Ready(_) => Some(r.gen),
            _ => None
        },
        None => None
    }
}

// An operator unload (§14.4 "Unload"): a drain of the group's live serving child. The end
// it reports is applied as any other end, so a cut run (no clean report) is retried at
// once and a clean stop writes Clean. A group with no live child is answered `Missing`.
pub fn unload(mut h: Host, name: String) -> Result[List[launcher.Request], Refused] waits {
    let Some(g) = group_row(h, name)? else {
        return Error(Unknown)
    }
    if let Some(_) = g.retiring {
        return Error(Retiring)
    }
    let v = vol_read(h, name)
    if let Some(_) = v.cut {
        return Error(Busy(0u64))
    }
    let Vol(run: take running, ..) = take v
    let Some(r) = take running else {
        return Error(Missing("live"))
    }
    let mut out: List[launcher.Request] = list.new()
    list.push(mut out, Stop(child_of(name, g.incarnation, r.gen)))
    Ok(take out)
}

pub fn retirement(h: Host, name: String) -> Option[Retired] waits {
    match store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.retired, name) {
        Ok(Some(r)) => Some(r),
        _ => None
    }
}

pub fn status(h: Host) -> Status waits {
    let mut dirty = 0u64
    let mut max_places = 0u64
    if let Ok(Some(m)) = store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.meta, 0u64) {
        dirty = m.dirty
    }
    if let Ok(Some(c)) = store.get(result.unwrap(store.reader(h.db, 0u64)), store.snapshot(h.db), h.t.config, 0u64) {
        max_places = c.max_places
    }
    let mut failing: List[Failing] = list.new()
    for (name, v) in h.vol {
        if v.failing {
            list.push(mut failing, Failing(name: string.from(name), count: v.count, retry_at: v.retry_at, last: failing_last(h, name, v.last)))
        }
    }
    let queued: List[Queued] = clone(h.queue)
    Status(dirty: dirty, max_places: max_places, probes: h.probes, due_wakes: h.due_wakes, arrival_wakes: h.arrival_wakes, queued: take queued, failing: take failing)
}

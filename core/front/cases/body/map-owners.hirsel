// Regrow relocates owners; duplicate insertion drops the old value first;
// removal returns its owner and a failed insert hands it back exactly once.
// expect: run replaced() = 11 trace 7,11
// expect: run removed() = 7 trace 7,11
// expect: run grown() = 5 trace 1,2,3,4,5
// A refused insert raises and drops the taken value once while unwinding.
// expect: run refused_insert() = 12800 trace 11 used 32
resource type Mark {
    id: u64
} drop(m) {
    let _ = m.id
}

fn replaced() -> u64 {
    let mut m: Map[u64, Mark] = map.new()
    map.insert(mut m, 1, result.unwrap(Mark(id: 7)))
    map.insert(mut m, 1, result.unwrap(Mark(id: 11)))
    match map.get(m, 1) {
        Some(v) => v.id,
        None => 0
    }
}

fn removed() -> u64 {
    let mut m: Map[u64, Mark] = map.new()
    map.insert(mut m, 1, result.unwrap(Mark(id: 7)))
    map.insert(mut m, 2, result.unwrap(Mark(id: 11)))
    let old = option.unwrap(map.remove(mut m, 1))
    old.id
}

fn grown() -> u64 {
    let mut m: Map[u64, Mark] = map.new()
    for i in 1u64 .. 6u64 {
        map.insert(mut m, i, result.unwrap(Mark(id: i)))
    }
    map.len(m)
}

fn refused_insert() -> u64 {
    let r = isolate(fn() -> Result[u64, Capacity] {
        bound bytes 40 {
            let mut m: Map[u64, Mark] = map.new()
            let value = result.unwrap(Mark(id: 11))
            map.insert(mut m, 7, take value)
            0
        }
    })
    match caught(take r) {
        Some(c) => c.requested * 100 + c.available,
        None => 0
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

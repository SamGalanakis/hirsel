// Contract tests for `codec` (core/std/codec.hirsel). Expected bytes are written out by
// hand from the format in the module header (little-endian, u32 counts and tags), never
// taken from an encode. A decode error reads as kind * 1000 + offset: 1 Truncated,
// 2 Invalid, 3 Utf8, 4 Duplicate, 5 Trailing, 6 Schema, 7 Value; 0 is success.
fn nibble(x: u8) -> u8 {
    if x >= 97 {
        x - 87
    } else {
        x - 48
    }
}

// Shared with codec.mjs through std_native.py's default TypeScript partner.
// The default law still tests the Hirsel encoder against hand-derived bytes.
// expect: run ts_codec_vectors() = true
pub fn ts_codec_vectors() -> bool {
    let nested: codec.Codec[Option[Option[u32]]] = codec.of()
    let unit: codec.Codec[Option[()]] = codec.of()
    let keyed: codec.Codec[Map[TsKey, u8]] = codec.of()
    let mut keys: Map[TsKey, u8] = map.new()
    map.insert(mut keys, TsKey(id: 1), 7u8)
    map.insert(mut keys, TsKey(id: 2), 8u8)
    enc(codec.of_u64(), 9007199254740993u64) == unhex("0100000000002000") && enc(codec.of_u64(), 18446744073709551615u64) == unhex("ffffffffffffffff") && enc(codec.of_i64(), -9223372036854775808i64) == unhex("0000000000000080") && enc(nested, None) == unhex("00000000") && enc(nested, Some(None)) == unhex("0100000000000000") && enc(nested, Some(Some(7u32))) == unhex("010000000100000007000000") && enc(unit, Some(())) == unhex("01000000") && enc(keyed, keys) == unhex("0200000001000000070200000008") && outcome(keyed, unhex("0200000001000000070100000008")) == 4009
}

type TsKey: codec + key {
    id: u32
}

type TsRow: codec {
    n: u64,
    label: String,
    nested: Option[Option[u32]]
}

const TS_DIFFERENTIAL_BYTES: String = ""

// expect: run ts_hirsel_differential() = true
pub fn ts_hirsel_differential() -> bool {
    let ts_input = TS_DIFFERENTIAL_BYTES
    if ts_input == "" {
        return false
    }
    let supplied = unhex(ts_input)
    let c: codec.Codec[TsRow] = codec.of()
    let mut at = 0u64
    let mut state = 1066u64
    let mut i = 0u64
    while i < 10000 {
        state = (state * 1664525 + 1013904223) % 4294967296
        let nested: Option[Option[u32]] = if i % 3 == 0 {
            None
        } else {
            if i % 3 == 1 {
                Some(None)
            } else {
                Some(Some(int.truncate(state)))
            }
        }
        let label = if i % 2 == 0 {
            "hé"
        } else {
            "x"
        }
        let ts_sample = TsRow(n: (state << 32) | i, label: string.from(label), nested)
        let encoded = enc(c, ts_sample)
        let start = at
        match codec.take_with(supplied, mut at, c) {
            Ok(take decoded) => {
                if enc(c, decoded) != encoded {
                    return false
                }
            }
            Error(_) => return false
        }
        if at - start != list.len(encoded) {
            return false
        }
        for j in 0u64 .. list.len(encoded) {
            if supplied[start + j] != encoded[j] {
                return false
            }
        }
        i += 1
    }
    at == list.len(supplied)
}

// Bytes from hex digits; spaces are ignored.
fn unhex(s: String) -> Bytes {
    let raw = string.as_bytes(s)
    let mut b: Bytes = list.new()
    let mut i: u64 = 0
    while i < list.len(raw) {
        if raw[i] == 32 {
            i += 1
        } else {
            list.push(mut b, nibble(raw[i]) * 16 + nibble(raw[i + 1]))
            i += 2
        }
    }
    take b
}

fn enc[T](c: codec.Codec[T], x: T) -> Bytes {
    let mut out: Bytes = list.new()
    result.unwrap(codec.encode(c, x, mut out))
    take out
}

fn code(e: codec.DecodeError) -> u64 {
    match e {
        Truncated(i) => 1000 + i,
        Invalid(i) => 2000 + i,
        Utf8(i) => 3000 + i,
        Duplicate(i) => 4000 + i,
        Trailing(i) => 5000 + i,
        Schema(i) => 6000 + i,
        Value(i) => 7000 + i
    }
}

fn outcome[T](c: codec.Codec[T], b: Bytes) -> u64 {
    decode_outcome(codec.decode(c, b))
}

fn decode_outcome[T](r: Result[Result[T, codec.DecodeError], Capacity]) -> u64 {
    match r {
        Ok(Ok(_)) => 0,
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// The same value back, by re-encoding it: equal bytes or not.
fn again[T](c: codec.Codec[T], b: Bytes) -> bool {
    match codec.decode(c, b) {
        Ok(Ok(x)) => enc(c, x) == b,
        _ => false
    }
}

// Every proper prefix of b is Truncated at an offset inside the prefix, and b itself
// decodes to bytes that encode back to b. Catches a take that reads past the end, or
// reports truncation at a place the prefix does not reach.
fn prefixes[T](c: codec.Codec[T], b: Bytes) -> bool {
    let mut k: u64 = 0
    while k < list.len(b) {
        let mut cut: Bytes = list.new()
        list.append(mut cut, list.slice(b, 0, k))
        let o = outcome(c, cut)
        if o < 1000 || o > 1000 + k {
            return false
        }
        k += 1
    }
    again(c, b)
}

// The format: widths, little-endian, two's complement, IEEE bits, the scalar of a char,
// bool's two bytes, () as nothing, String's u32 byte count. A wrong width or byte order
// in any put, or a char written as UTF-8, fails it.
// expect: run format_scalars() = true
fn format_scalars() -> bool {
    let u: u16 = 0x1234
    let i: i64 = -2
    let f: f32 = 1.0
    let g: f64 = -0.5
    let small: i8 = -1
    let w: u32 = 7
    enc(codec.of_u16(), u) == unhex("3412") && enc(codec.of_i64(), i) == unhex("feffffffffffffff") && enc(codec.of_f32(), f) == unhex("0000803f") && enc(codec.of_f64(), g) == unhex("000000000000e0bf") && enc(codec.of_char(), 'é') == unhex("e9000000") && enc(codec.of_bool(), true) == unhex("01") && enc(codec.of_unit(), ()) == unhex("") && enc(codec.of_string(), "hé") == unhex("03000000 68c3a9") && enc(codec.of_i8(), small) == unhex("ff") && enc(codec.of_u32(), w) == unhex("07000000")
}

// The hand-picked codec a and b agree: the same bytes for x, the same schema and the same
// least.
fn same_codec[T](a: codec.Codec[T], b: codec.Codec[T], x: T) -> bool {
    enc(a, x) == enc(b, x) && result.unwrap(codec.schema(a)) == result.unwrap(codec.schema(b)) && codec.least(a) == codec.least(b)
}

// `of` from inside a generic body, where only the instance knows T.
fn generic_of[T: codec]() -> codec.Codec[T] {
    codec.of()
}

// `of` picks std's maker of each built-in type, whether the call's expected type closes T
// or T is a generic body's parameter: a scalar of another width or signedness, or String's
// maker at another type, writes other bytes or another schema.
// expect: run of_builtins() = true
fn of_builtins() -> bool {
    let (a, b, c, d): (u8, u16, u32, u64) = (0x81, 0x8182, 0x81828384, 0x8182838485868788)
    let (e, f, g, h): (i8, i16, i32, i64) = (-2, -3, -4, -5)
    let (x, y): (f32, f64) = (1.5, -0.25)
    let direct = same_codec(codec.of_u8(), codec.of(), a) && same_codec(codec.of_u16(), codec.of(), b) && same_codec(codec.of_u32(), codec.of(), c) && same_codec(codec.of_u64(), codec.of(), d) && same_codec(codec.of_i8(), codec.of(), e) && same_codec(codec.of_i16(), codec.of(), f) && same_codec(codec.of_i32(), codec.of(), g) && same_codec(codec.of_i64(), codec.of(), h) && same_codec(codec.of_f32(), codec.of(), x) && same_codec(codec.of_f64(), codec.of(), y) && same_codec(codec.of_bool(), codec.of(), true) && same_codec(codec.of_char(), codec.of(), 'é') && same_codec(codec.of_unit(), codec.of(), ()) && same_codec(codec.of_string(), codec.of(), "hé")
    let generic = same_codec(codec.of_u8(), generic_of(), a) && same_codec(codec.of_u16(), generic_of(), b) && same_codec(codec.of_u32(), generic_of(), c) && same_codec(codec.of_u64(), generic_of(), d) && same_codec(codec.of_i8(), generic_of(), e) && same_codec(codec.of_i16(), generic_of(), f) && same_codec(codec.of_i32(), generic_of(), g) && same_codec(codec.of_i64(), generic_of(), h) && same_codec(codec.of_f32(), generic_of(), x) && same_codec(codec.of_f64(), generic_of(), y) && same_codec(codec.of_bool(), generic_of(), true) && same_codec(codec.of_char(), generic_of(), 'é') && same_codec(codec.of_unit(), generic_of(), ()) && same_codec(codec.of_string(), generic_of(), "hé")
    direct && generic
}

// Bytes through `of` (the bulk of_bytes) against of_list at u8, pushing byte by byte:
// into an out already holding `pre` bytes, under a bound of `limit`, both succeed or both
// fail, and on success leave the same bytes and the same capacity, so the same charges.
// Both decode what either wrote to the same value, and every prefix is Truncated. A bulk
// put that grows out other than by MEM-24 at the bytes a push grows at, or a take that
// reads past the count, fails it.
// expect: run bytes_as_list() = 0
fn bytes_as_list() -> u64 {
    let mut bad: u64 = 0
    for a in 0u64 .. 7 {
        let n = match a {
            0 => 0u64,
            1 => 1,
            2 => 2,
            3 => 5,
            4 => 9,
            5 => 23,
            _ => 64
        }
        let mut xs: Bytes = list.new()
        let mut i: u64 = 0
        while i < n {
            list.push(mut xs, int.truncate((i * 37 + 1) & 255))
            i += 1
        }
        let slow: codec.Codec[Bytes] = codec.of_list()
        let bulk: codec.Codec[Bytes] = codec.of()
        let both = enc(slow, xs)
        if enc(bulk, xs) != both || !prefixes(bulk, both) {
            bad += 1
        }
        let back = match (codec.decode(bulk, both), codec.decode(slow, both)) {
            (Ok(Ok(x)), Ok(Ok(y))) => x == xs && y == xs,
            _ => false
        }
        if !back {
            bad += 1
        }
        for b in 0u64 .. 4 {
            let pre = b * b - b / 2
            for d in 0u64 .. 7 {
                let limit = if d == 6 {
                    100000u64
                } else {
                    8u64 << d
                }
                let (fa, la, ca, oa) = put_under(bulk, xs, pre, limit)
                let (fb, lb, cb, ob) = put_under(slow, xs, pre, limit)
                if fa != fb || la != lb || ca != cb || oa != ob {
                    bad += 1
                }
            }
        }
    }
    bad
}

// Encodes xs with c into an out holding pre bytes, under a bound of limit: whether it
// failed, then on success out's length, capacity and bytes.
fn put_under(c: codec.Codec[Bytes], xs: Bytes, pre: u64, limit: u64) -> (bool, u64, u64, Bytes) {
    let r = isolate(fn() -> Result[Result[(u64, u64, Bytes), Capacity], Capacity] {
        let mut out: Bytes = list.new()
        let mut i: u64 = 0
        while i < pre {
            list.push(mut out, 0xee)
            i += 1
        }
        bound bytes limit {
            match codec.encode(c, xs, mut out) {
                Ok(()) => Ok((list.len(out), list.capacity(out), take out)),
                Error(e) => Error(e),
            }
        }
    })
    match take r {
        Ok(Ok(Ok(Ok((len, cap, take written))))) => (false, len, cap, take written),
        _ => (true, 0, 0, list.new()),
    }
}

// The extremes of each width come back, and every prefix of them is Truncated.
// expect: run scalars_round_trip() = true
fn scalars_round_trip() -> bool {
    prefixes(codec.of_u8(), unhex("ff")) && prefixes(codec.of_u16(), unhex("ffff")) && prefixes(codec.of_u32(), unhex("ffffffff")) && prefixes(codec.of_u64(), unhex("ffffffffffffffff")) && prefixes(codec.of_i8(), unhex("80")) && prefixes(codec.of_i16(), unhex("0080")) && prefixes(codec.of_i32(), unhex("00000080")) && prefixes(codec.of_i64(), unhex("0000000000000080")) && prefixes(codec.of_f32(), unhex("0000c07f")) && prefixes(codec.of_f64(), unhex("0000000000000080")) && prefixes(codec.of_f64(), unhex("000000000000f07f")) && prefixes(codec.of_f64(), unhex("000000000000f87f")) && prefixes(codec.of_char(), unhex("ffff1000")) && prefixes(codec.of_bool(), unhex("00")) && prefixes(codec.of_string(), unhex("00000000")) && prefixes(codec.of_string(), unhex("04000000 f09f9880"))
}

// Bytes no value encodes to are Invalid at the value: bool 2, a NaN other than SEM-2's
// one, a surrogate and a scalar past U+10FFFF. A take that masks or canonicalises
// instead of refusing fails it, which would break decode-accepts-exactly-encode's-image.
// expect: run refuses_non_values() = 14000
fn refuses_non_values() -> u64 {
    let mut digits: u64 = 0
    digits = digits + outcome(codec.of_bool(), unhex("02"))
    digits = digits + outcome(codec.of_f32(), unhex("0100c07f"))
    digits = digits + outcome(codec.of_f32(), unhex("0000c0ff"))
    digits = digits + outcome(codec.of_f64(), unhex("010000000000f87f"))
    digits = digits + outcome(codec.of_f64(), unhex("000000000000f8ff"))
    digits = digits + outcome(codec.of_char(), unhex("00d80000"))
    digits = digits + outcome(codec.of_char(), unhex("00001100"))
    digits
}

// UTF-8 is checked at the byte that stops being UTF-8 (RFC 3629): a lone 0xff, an
// overlong NUL, a surrogate, a cut four-byte scalar. A take that accepts any bytes, or
// reports the string's start, fails it.
// expect: run refuses_bad_utf8() = (3005, 3004, 3004, 3005)
fn refuses_bad_utf8() -> (u64, u64, u64, u64) {
    (outcome(codec.of_string(), unhex("03000000 61ff62")), outcome(codec.of_string(), unhex("02000000 c080")), outcome(codec.of_string(), unhex("03000000 eda080")), outcome(codec.of_string(), unhex("04000000 61f09f98")))
}

// A composite record: what a generated codec is for a record whose fields are an
// Option, a Result, a Map, a List and a tuple (the tuple inline, field by field).
type Mix {
    tag: Option[String],
    res: Result[u16, String],
    m: Map[String, u8],
    xs: List[i32],
    pair: (u8, bool)
}

fn mix_encode(x: Mix, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_option(x.tag, codec.of_string(), mut out)?
    codec.put_result(x.res, codec.of_u16(), codec.of_string(), mut out)?
    codec.put_map(x.m, codec.of_string(), codec.of_u8(), mut out)?
    codec.put_list(x.xs, codec.of_i32(), mut out)?
    let (p0, p1) = x.pair
    codec.put_u8(p0, mut out)?
    codec.put_bool(p1, mut out)
}

fn mix_decode(b: Bytes, mut at: u64) -> Result[Mix, codec.Stop] {
    let tag = codec.take_option(b, mut at, codec.of_string())?
    let res = codec.take_result(b, mut at, codec.of_u16(), codec.of_string())?
    let m = codec.take_map(b, mut at, codec.of_string(), codec.of_u8())?
    let xs = codec.take_list(b, mut at, codec.of_i32())?
    let p0 = codec.take_u8(b, mut at)?
    let p1 = codec.take_bool(b, mut at)?
    Ok(Mix(tag: take tag, res: take res, m: take m, xs: take xs, pair: (p0, p1)))
}

fn mix_schema(mut s: codec.Schema, c: codec.Codec[Mix]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Mix", 0)?
    if codec.record(mut s, 5)? {
        return Ok(())
    }
    codec.field(mut s, "tag")?
    codec.schema_option(mut s, codec.of_string())?
    codec.field(mut s, "res")?
    codec.schema_result(mut s, codec.of_u16(), codec.of_string())?
    codec.field(mut s, "m")?
    codec.schema_map(mut s, codec.of_string(), codec.of_u8())?
    codec.field(mut s, "xs")?
    codec.schema_list(mut s, codec.of_i32())?
    codec.field(mut s, "pair")?
    codec.schema_tuple(mut s, 2)?
    codec.schema_u8(mut s)?
    codec.schema_bool(mut s)?
    codec.close(mut s)
    Ok(())
}

fn mixes() -> codec.Codec[Mix] {
    codec.make(mix_encode, mix_decode, mix_schema, 20)
}

// tag Some("a"), res Error("b"), m {"k": 5}, xs [-1], pair (9, true), by hand.
fn mix_bytes() -> Bytes {
    unhex("01000000 01000000 61 01000000 01000000 62 01000000 01000000 6b 05 01000000 ffffffff 09 01")
}

// The composite format by hand, then every prefix Truncated inside it. A put that drops
// a count or tag, or a take that reads past a cut, fails it.
// expect: run mix_format() = true
fn mix_format() -> bool {
    let mut m: Map[String, u8] = map.new()
    map.insert(mut m, string.from("k"), 5)
    let mut xs: List[i32] = list.new()
    list.push(mut xs, -1)
    let x = Mix(tag: Some(string.from("a")), res: Error(string.from("b")), m: take m, xs: take xs, pair: (9, true))
    enc(mixes(), x) == mix_bytes() && prefixes(mixes(), mix_bytes())
}

// Decode accepts exactly encode's image: after any byte of a valid encoding is flipped
// (three masks), either decode refuses it or the value encodes back to the flipped
// bytes. A take that accepts a non-canonical byte (bool 2, tag 2, a duplicate key) or
// admits a flipped count before checking it (Capacity) fails it.
// expect: run flips_are_refused_or_exact() = true
fn flips_are_refused_or_exact() -> bool {
    let b = mix_bytes()
    let mut i: u64 = 0
    while i < list.len(b) {
        let mut j: u64 = 0
        while j < 3 {
            let mask: u8 = if j == 0 {
                1
            } else if j == 1 {
                128
            } else {
                255
            }
            let mut bad: Bytes = list.new()
            list.append(mut bad, b)
            let _ = list.set(mut bad, i, b[i] ^ mask)
            match codec.decode(mixes(), bad) {
                Ok(Ok(x)) => {
                    if enc(mixes(), x) != bad {
                        return false
                    }
                }
                Ok(Error(_)) => {}
                Error(_) => return false
            }
            j += 1
        }
        i += 1
    }
    true
}

// Hand-made near misses of mix_bytes (tag at 0, res at 9, m at 18 with its key at 22,
// xs at 28, the pair at 36): Option tag 2 at 0; Result tag 2 at 9; the key "k" again
// in a two-entry map, at the second key (28); the bool 2 at 37; one byte past the end,
// Trailing at 38; a list count no remaining bytes hold, Truncated at the count (28)
// before anything is admitted.
// expect: run mix_near_misses() = (2000, 2009, 4028, 2037, 5038, 1028)
fn mix_near_misses() -> (u64, u64, u64, u64, u64, u64) {
    let a = outcome(mixes(), unhex("02000000 01000000 61 01000000 01000000 62 01000000 01000000 6b 05 01000000 ffffffff 09 01"))
    let b = outcome(mixes(), unhex("01000000 01000000 61 02000000 01000000 62 01000000 01000000 6b 05 01000000 ffffffff 09 01"))
    let c = outcome(mixes(), unhex("01000000 01000000 61 01000000 01000000 62 02000000 01000000 6b 05 01000000 6b 06 01000000 ffffffff 09 01"))
    let d = outcome(mixes(), unhex("01000000 01000000 61 01000000 01000000 62 01000000 01000000 6b 05 01000000 ffffffff 09 02"))
    let e = outcome(mixes(), unhex("01000000 01000000 61 01000000 01000000 62 01000000 01000000 6b 05 01000000 ffffffff 09 01 00"))
    let f = outcome(mixes(), unhex("01000000 01000000 61 01000000 01000000 62 01000000 01000000 6b 05 ffffffff ffffffff 09 01"))
    (a, b, c, d, e, f)
}

// The expansions (EXPANSION.md): each block is the text the derive generates for its type.
// (a) A record with a defaulted field: `type Row codec { id: u64, name: String,
// score: i64 = 7 }`. The other row codecs below are earlier or later versions of the
// same type, as writers: one Row type, several schemas.
type Row {
    id: u64,
    name: String,
    score: i64
}

fn row_encode(x: Row, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_u64(x.id, mut out)?
    codec.put_string(x.name, mut out)?
    codec.put_i64(x.score, mut out)
}

fn row_decode(b: Bytes, mut at: u64) -> Result[Row, codec.Stop] {
    let id = codec.take_u64(b, mut at)?
    let name = codec.take_string(b, mut at)?
    let score = codec.take_i64(b, mut at)?
    Ok(Row(id, name: take name, score))
}

fn row_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 3)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.field_default(mut s, "score", codec.of_i64(), 7)?
    codec.close(mut s)
    Ok(())
}

fn rows() -> codec.Codec[Row] {
    codec.make(row_encode, row_decode, row_schema, 20)
}

// Version 1: `{ id: u64, name: String }`.
fn v1_encode(x: Row, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_u64(x.id, mut out)?
    codec.put_string(x.name, mut out)
}

fn v1_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.close(mut s)
    Ok(())
}

fn rows_v1() -> codec.Codec[Row] {
    codec.make(v1_encode, row_decode, v1_schema, 12)
}

// `{ name: String, id: u64 }`: the same fields, reordered.
fn swapped_encode(x: Row, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_string(x.name, mut out)?
    codec.put_u64(x.id, mut out)
}

fn swapped_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn rows_swapped() -> codec.Codec[Row] {
    codec.make(swapped_encode, row_decode, swapped_schema, 12)
}

// `{ id: u64, note: String, name: String }`: note is "n" in every value written.
fn noted_encode(x: Row, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_u64(x.id, mut out)?
    codec.put_string("n", mut out)?
    codec.put_string(x.name, mut out)
}

fn noted_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 3)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "note")?
    codec.schema_string(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.close(mut s)
    Ok(())
}

fn rows_noted() -> codec.Codec[Row] {
    codec.make(noted_encode, row_decode, noted_schema, 16)
}

// A type with a tombstone: `type Row codec { id: u64, removed note: String,
// name: String, score: i64 = 7 }`. The encode and decode are row's; only the schema
// keeps the removed name.
fn tomb_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 4)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.removed_field(mut s, "note")?
    codec.schema_string(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.field_default(mut s, "score", codec.of_i64(), 7)?
    codec.close(mut s)
    Ok(())
}

// The tombstone with another type: `removed note: u64`.
fn tomb_u64_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 4)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.removed_field(mut s, "note")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.field_default(mut s, "score", codec.of_i64(), 7)?
    codec.close(mut s)
    Ok(())
}

// The name freed and the field back: `{ id: u64, note: String, name: String, score: i64
// = 7 }`, note with no default.
fn renoted_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 4)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "note")?
    codec.schema_string(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.field_default(mut s, "score", codec.of_i64(), 7)?
    codec.close(mut s)
    Ok(())
}

fn rows_tomb() -> codec.Codec[Row] {
    codec.make(row_encode, row_decode, tomb_schema, 20)
}

// Writers no evolution admits: id retyped to i64; a field `extra: bool` the reader
// lacks; name missing with no default.
fn retyped_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_i64(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.close(mut s)
    Ok(())
}

fn extra_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 3)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "name")?
    codec.schema_string(mut s)?
    codec.field(mut s, "extra")?
    codec.schema_bool(mut s)?
    codec.close(mut s)
    Ok(())
}

fn short_schema(mut s: codec.Schema, c: codec.Codec[Row]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Row", 0)?
    if codec.record(mut s, 1)? {
        return Ok(())
    }
    codec.field(mut s, "id")?
    codec.schema_u64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn schema_bytes(w: fn(mut codec.Schema, codec.Codec[Row]) -> Result[(), Capacity]) -> Bytes {
    result.unwrap(codec.schema(codec.make(row_encode, row_decode, w, 20)))
}

fn row(id: u64, name: String) -> Row {
    Row(id, name: string.from(name), score: 3)
}

// Reads b, written under the schema `writer`, as c's type; the value or the error code.
fn through[T](c: codec.Codec[T], writer: Bytes, b: Bytes) -> Result[T, u64] {
    match codec.resolve(c, writer) {
        Ok(Ok(r)) => match codec.read(r, b) {
            Ok(Ok(x)) => Ok(take x),
            Ok(Error(e)) => Error(code(e)),
            Error(_) => Error(9999)
        },
        Ok(Error(e)) => Error(code(e)),
        Error(_) => Error(9999)
    }
}

fn row_through(c: codec.Codec[Row], writer: Bytes, b: Bytes) -> (u64, u64, i64) {
    match through(c, writer, b) {
        Ok(x) => (x.id, string.byte_len(x.name), x.score),
        Error(k) => (k, 0, 0)
    }
}

fn refusal[T](c: codec.Codec[T], writer: Bytes, b: Bytes) -> u64 {
    match through(c, writer, b) {
        Ok(_) => 0,
        Error(k) => k
    }
}

// Version 1's schema by hand: version 3, one definition (the path "t.Row", no arguments,
// a record of two fields: 0 "id" u64 (6), 0 "name" String (13)), the root a reference
// to definition 0. A schema writer that drops a count, misnumbers an opcode or writes
// the definition inline fails it.
// expect: run schema_by_hand() = true
fn schema_by_hand() -> bool {
    schema_bytes(v1_schema) == unhex("03 01000000 05000000 742e526f77 00000000 00 02000000 00 02000000 6964 06 00 04000000 6e616d65 0d 13 00000000")
}

// A tombstone is in the schema (1, the name, its type) where its field was; so it is in
// the fingerprint, a schema that forgot it would let the name be reused, and its type
// is there to resolve a writer's field against.
// expect: run tombstone_in_schema() = true
fn tombstone_in_schema() -> bool {
    schema_bytes(tomb_schema) == unhex("03 01000000 05000000 742e526f77 00000000 00 04000000 00 02000000 6964 06 01 04000000 6e6f7465 0d 00 04000000 6e616d65 0d 00 05000000 73636f7265 0a 13 00000000")
}

// CRC-64-AVRO (the Avro specification's Rabin fingerprint; reference values from its
// algorithm in Python over the same bytes): the u64 schema 03 00000000 06 is
// 0x8dbfb7fd6918702c, and no bytes are the empty value 0xc15d213aa4d7a795. A different
// polynomial, seed or bit order fails it.
// expect: run fingerprint_reference() = (0x8dbfb7fd6918702c, 0xc15d213aa4d7a795, true)
fn fingerprint_reference() -> (u64, u64, bool) {
    let a = result.unwrap(codec.fingerprint(codec.of_u64()))
    let e = codec.fingerprint_of(list.new())
    let d = result.unwrap(codec.fingerprint(rows_tomb())) != result.unwrap(codec.fingerprint(rows()))
    (a, e, d)
}

// Apache Avro 1.12.0, share/test/data/schema-tests.txt. Hash the published
// canonical JSON bytes, which Avro uses as input to fingerprint64.
// expect: run fingerprint_avro_vectors() = true
fn fingerprint_avro_vectors() -> bool {
    let vectors: Inline[(String, u64), 7] =[("\"null\"", 0x63dd24e7cc258f8a), ("\"boolean\"", 0x9f42fc78a4d4f764), ("\"int\"", 0x7275d51a3f395c8f), ("\"long\"", 0xd054e14493f41db7), ("[\"int\",\"boolean\"]", 0x4ad63578080c1602), ("{\"type\":\"array\",\"items\":\"null\"}", 0xf7d13f2f68170a6d), ("{\"type\":\"map\",\"values\":\"string\"}", 0x86ce965d92864572)]
    for (form, expected) in vectors {
        if codec.fingerprint_of(string.as_bytes(form)) != expected {
            return false
        }
    }
    true
}

// TestSchemaNormalization.altFingerprint, Apache Avro 1.12.0, on prefixes
// of byte i = (17*i+3) mod 256.
// expect: run fingerprint_span_boundaries() = true
fn fingerprint_span_boundaries() -> bool {
    let mut b: Bytes = list.with_capacity(4097)
    for i in 0u64 .. 4097 {
        list.push(mut b, int.truncate(i * 17 + 3))
    }
    let vectors: Inline[(u64, u64), 14] =[(0, 0xc15d213aa4d7a795), (1, 0x636ab938825c5af3), (7, 0x2332dd08478ed62a), (8, 0xe902ff8e513f3454), (9, 0x0b7483a78473573e), (63, 0xb40e1cdba1c0c77f), (64, 0xdb4545c7b4366271), (65, 0x804e5715595fc6f1), (255, 0x94522820065f273f), (256, 0x1a3838c9eb465a04), (257, 0xc6cf4a49cd53f3bc), (4095, 0x92849bde69880f9c), (4096, 0x3fd56a423782450d), (4097, 0x0f2f73fd02e9a6a2)]
    for (size, expected) in vectors {
        if codec.fingerprint_of(list.slice(b, 0, size)) != expected {
            return false
        }
    }
    true
}

// Each byte is the next desired table index XOR the previous fingerprint's
// low byte. The independent Avro altFingerprint above gives the bytes and digest.
// expect: run fingerprint_table_walk() = true
fn fingerprint_table_walk() -> bool {
    codec.fingerprint_of(unhex("95 a6 2f 02 c0 2f 33 de 44 cf 99 24 42 72 fb 47 2f 79 e1 98 51 95 60 0e 3e b5 e3 5e 38 08 81 3d 75 99 9c 6c fa d7 db 11 b0 3b 6d d0 b6 86 0f b3 db 8d 15 6c a5 61 94 fa ca 41 17 aa cc fc 75 c9 c1 72 03 4f 2f a5 18 21 21 aa fc 41 27 17 9e 22 4a 1c 84 fd 34 f0 05 6b 5b d0 86 3b 5d 6d e4 58 10 fc f9 09 9f b2 be 74 d5 5e 08 b5 d3 e3 6a d6 be e8 70 09 c0 04 f1 9f af 24 72 cf a9 99 10 ac 24 02 d4 4f 8b 3b a7 c3 02 89 df 62 04 34 bd 01 69 3f a7 de 17 d3 26 48 78 f3 a5 18 7e 4e c7 7b 33 df da 2a bc 91 9d 57 f6 7d 2b 96 f0 c0 49 f5 9d cb 53 2a e3 27 d2 bc 8c 07 51 ec 8a ba 33 8f 87 34 45 09 69 e3 5e 67 67 ec ba 07 61 51 d8 64 0c 5a c2 bb 72 b6 43 2d 1d 96 c0 7d 1b 2b a2 1e 56 ba bf 4f d9 f4 f8 32 93 18 4e f3 95 a5 2c 90 f8 ae 36 4f 86 42 b7 d9 e9 62 34 89 ef df 56 ea")) == 0x9a8f7337af6a4562
}

// MEM-30 gives one call step for fingerprint_of and two per byte, from
// int.widen and the back edge. The two-byte published Avro vector takes five.
// expect: run fingerprint_step_bound() = true
fn fingerprint_step_bound() -> bool {
    let b = string.as_bytes("[]")
    let enough = bound steps 5 {
        codec.fingerprint_of(b)
    }
    let short = bound steps 4 {
        codec.fingerprint_of(b)
    }
    match (enough, short) {
        (Ok(value), Error(out)) => value == 0xeec6e173d23fb9d1 && out.steps == 4,
        _ => false,
    }
}

// Evolution that survives old data. A field added with a default: version 1's bytes read
// as Row with score 7. Reordered fields: the writer's order is undone. A field the reader
// removed by tombstone: skipped (the writer's note), the rest kept, score defaulted.
// Equal schemas: read is decode. A resolver that ignores defaults, keeps the writer's
// order or keeps the dropped field's bytes fails it.
// expect: run evolution_reads_old_rows() = ((5, 2, 7), (6, 3, 7), (8, 1, 7), (9, 2, 3))
fn evolution_reads_old_rows() -> ((u64, u64, i64), (u64, u64, i64), (u64, u64, i64), (u64, u64, i64)) {
    let a = row_through(rows(), schema_bytes(v1_schema), enc(rows_v1(), row(5, "ab")))
    let b = row_through(rows(), schema_bytes(swapped_schema), enc(rows_swapped(), row(6, "abc")))
    let c = row_through(rows_tomb(), schema_bytes(noted_schema), enc(rows_noted(), row(8, "x")))
    let d = row_through(rows(), schema_bytes(row_schema), enc(rows(), row(9, "yz")))
    (a, b, c, d)
}

// Evolution no rule admits is Schema at the writer's schema: id retyped, at its type
// (offset 30); a writer field the reader lacks, at its entry (41); a reader field with
// no default the writer lacks, at the writer's definition (5), also when the writer's
// tombstone is all it has of the field (a writer's tombstone is a field it lacks); bytes
// that are no schema, at the definition count (1); a writer's note against the reader's
// tombstone `removed note: u64`, at the writer's note type (40). Offsets by hand from
// schema_by_hand's layout. A resolver that refused a re-added name outright, or skipped a
// removed field without resolving its type against the tombstone's, fails it.
// expect: run evolution_refused() = (6030, 6041, 6005, 6005, 6001, 6040)
fn evolution_refused() -> (u64, u64, u64, u64, u64, u64) {
    let none = unhex("")
    let a = refusal(rows(), schema_bytes(retyped_schema), none)
    let b = refusal(rows(), schema_bytes(extra_schema), none)
    let c = refusal(rows(), schema_bytes(short_schema), none)
    let d = refusal(codec.make(row_encode, row_decode, renoted_schema, 20), schema_bytes(tomb_schema), none)
    let e = refusal(rows(), unhex("03 05"), none)
    let f = refusal(codec.make(row_encode, row_decode, tomb_u64_schema, 20), schema_bytes(noted_schema), none)
    (a, b, c, d, e, f)
}

// Through resolution, the writer's bytes are checked as decode checks them, at offsets
// in the writer's bytes: version 1's name cut short, Truncated at the name (8); a
// trailing byte, Trailing at 14; the note's bad UTF-8 is still refused though the field
// is dropped, at its byte (12).
// expect: run resolution_checks_writer_bytes() = (1008, 5014, 3012)
fn resolution_checks_writer_bytes() -> (u64, u64, u64) {
    let a = refusal(rows(), schema_bytes(v1_schema), unhex("0500000000000000 02000000 61"))
    let b = refusal(rows(), schema_bytes(v1_schema), unhex("0500000000000000 02000000 6162 00"))
    let c = refusal(rows_tomb(), schema_bytes(noted_schema), unhex("0500000000000000 01000000 ff 01000000 61"))
    (a, b, c)
}

// (b) A sum: `type Shape codec = Dot | Circle(f64) | Rect(u64, u64)`. Its earlier
// version had Dot and Circle; a later one removed Rect by tombstone.
type Shape = Dot | Circle(f64) | Rect(u64, u64)

fn shape_encode(x: Shape, mut out: Bytes) -> Result[(), Capacity] {
    match x {
        Dot => codec.put_tag(0, mut out),
        Circle(r) => {
            codec.put_tag(1, mut out)?
            codec.put_f64(r, mut out)
        }
        Rect(w, h) => {
            codec.put_tag(2, mut out)?
            codec.put_u64(w, mut out)?
            codec.put_u64(h, mut out)
        }
    }
}

fn shape_decode(b: Bytes, mut at: u64) -> Result[Shape, codec.Stop] {
    let tag = codec.take_tag(b, mut at, 3)?
    if tag == 0 {
        Ok(Dot)
    } else if tag == 1 {
        let r = codec.take_f64(b, mut at)?
        Ok(Circle(r))
    } else {
        let w = codec.take_u64(b, mut at)?
        let h = codec.take_u64(b, mut at)?
        Ok(Rect(w, h))
    }
}

fn shape_schema(mut s: codec.Schema, c: codec.Codec[Shape]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Shape", 0)?
    if codec.sum(mut s, 3)? {
        return Ok(())
    }
    codec.variant(mut s, "Dot", 0)?
    codec.variant(mut s, "Circle", 1)?
    codec.schema_f64(mut s)?
    codec.variant(mut s, "Rect", 2)?
    codec.schema_u64(mut s)?
    codec.schema_u64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn shapes() -> codec.Codec[Shape] {
    codec.make(shape_encode, shape_decode, shape_schema, 4)
}

fn old_shape_schema(mut s: codec.Schema, c: codec.Codec[Shape]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Shape", 0)?
    if codec.sum(mut s, 2)? {
        return Ok(())
    }
    codec.variant(mut s, "Dot", 0)?
    codec.variant(mut s, "Circle", 1)?
    codec.schema_f64(mut s)?
    codec.close(mut s)
    Ok(())
}

// A removed variant's tag is no value of the reader's: its decode refuses it as it
// refuses a tag past the end.
fn cut_shape_decode(b: Bytes, mut at: u64) -> Result[Shape, codec.Stop] {
    let start = at
    let tag = codec.take_tag(b, mut at, 3)?
    if tag == 0 {
        Ok(Dot)
    } else if tag == 1 {
        let r = codec.take_f64(b, mut at)?
        Ok(Circle(r))
    } else {
        Error(Bad(Invalid(start)))
    }
}

fn cut_shape_schema(mut s: codec.Schema, c: codec.Codec[Shape]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Shape", 0)?
    if codec.sum(mut s, 3)? {
        return Ok(())
    }
    codec.variant(mut s, "Dot", 0)?
    codec.variant(mut s, "Circle", 1)?
    codec.schema_f64(mut s)?
    codec.removed_variant(mut s, "Rect", 2)?
    codec.schema_u64(mut s)?
    codec.schema_u64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn cut_i64_shape_schema(mut s: codec.Schema, c: codec.Codec[Shape]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Shape", 0)?
    if codec.sum(mut s, 3)? {
        return Ok(())
    }
    codec.variant(mut s, "Dot", 0)?
    codec.variant(mut s, "Circle", 1)?
    codec.schema_f64(mut s)?
    codec.removed_variant(mut s, "Rect", 2)?
    codec.schema_u64(mut s)?
    codec.schema_i64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn renamed_shape_schema(mut s: codec.Schema, c: codec.Codec[Shape]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Shape", 0)?
    if codec.sum(mut s, 2)? {
        return Ok(())
    }
    codec.variant(mut s, "Dot", 0)?
    codec.variant(mut s, "Ring", 1)?
    codec.schema_f64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn shape_schema_bytes(w: fn(mut codec.Schema, codec.Codec[Shape]) -> Result[(), Capacity]) -> Bytes {
    result.unwrap(codec.schema(codec.make(shape_encode, shape_decode, w, 4)))
}

fn shape_code(x: Shape) -> u64 {
    match x {
        Dot => 1,
        Circle(_) => 2,
        Rect(w, h) => 30 + w + h
    }
}

fn shape_through(reader: codec.Codec[Shape], w: fn(mut codec.Schema, codec.Codec[Shape]) -> Result[(), Capacity], b: Bytes) -> u64 {
    match through(reader, shape_schema_bytes(w), b) {
        Ok(x) => shape_code(x),
        Error(k) => k
    }
}

// Variant evolution. Appended at the end: the old writer's Circle reads unchanged (2).
// Removed by the reader's tombstone: the writer's Circle reads (2); a value holding its
// Rect is Schema at the writer's entry for Rect (53, SEM-10). Removed by the writer's
// tombstone, read by a reader that still has Rect: Circle reads (2), and Rect, which no
// such writer holds, is Invalid at its tag. Refused, as Schema: a writer with more
// variants than the reader declares, at the writer's kind byte (20); a renamed variant,
// at the writer's entry for it (37). A resolver that matched variants by position only,
// let a removed tag through, called a held removed variant malformed bytes, or refused a
// writer's tombstone against a live variant, fails it.
// A reader tombstone `removed Rect(u64, i64)` against the writer's Rect is Schema at the
// writer's second payload type (67): a tombstone's types resolve.
// expect: run variant_evolution() = (2, 2, 6053, 2, 2000, 6020, 6037, 6067)
fn variant_evolution() -> (u64, u64, u64, u64, u64, u64, u64, u64) {
    let circle = unhex("01000000 000000000000f03f")
    let rect = unhex("02000000 0100000000000000 0200000000000000")
    let a = shape_through(shapes(), old_shape_schema, circle)
    let cut = codec.make(shape_encode, cut_shape_decode, cut_shape_schema, 4)
    let b = shape_through(cut, shape_schema, circle)
    let c = shape_through(cut, shape_schema, rect)
    let d = shape_through(shapes(), cut_shape_schema, circle)
    let e = shape_through(shapes(), cut_shape_schema, rect)
    let reader_old = codec.make(shape_encode, shape_decode, old_shape_schema, 4)
    let f = shape_through(reader_old, shape_schema, circle)
    let g = shape_through(shapes(), renamed_shape_schema, circle)
    let h = shape_through(codec.make(shape_encode, cut_shape_decode, cut_i64_shape_schema, 4), shape_schema, circle)
    (a, b, c, d, e, f, g, h)
}

// A tag is the variant's position as four little-endian bytes (SEM-10): Rect(1, 2) by
// hand; tag 3 and a tag with only its high byte set, Invalid at the tag; a tag written
// as a u64 reads as Dot and leaves four bytes, Trailing at 4; every prefix of Rect
// Truncated. A u64 or one-byte tag, or a take that reads its low byte only, fails it.
// expect: run tags_are_u32() = (true, 2000, 2000, 5004, true)
fn tags_are_u32() -> (bool, u64, u64, u64, bool) {
    let rect = unhex("02000000 0100000000000000 0200000000000000")
    (enc(shapes(), Rect(1, 2)) == rect, outcome(shapes(), unhex("03000000")), outcome(shapes(), unhex("00000001")), outcome(shapes(), unhex("0000000000000000")), prefixes(shapes(), rect))
}

// (c) A generic type, a codec type when its parameter is: `type Pair[T] codec { left: T,
// right: T }`. The body takes T's codec as an argument; with hook C the derive's
// pair_encode[T: codec] passes `codec.of[T]()`. Here the u64 instance passes of_u64.
type Pair[T] {
    left: T,
    right: T
}

fn pair_encode_with[T](x: Pair[T], c: codec.Codec[T], mut out: Bytes) -> Result[(), Capacity] {
    codec.put_with(x.left, c, mut out)?
    codec.put_with(x.right, c, mut out)
}

fn pair_decode_with[T](b: Bytes, mut at: u64, c: codec.Codec[T]) -> Result[Pair[T], codec.Stop] {
    let left = codec.take_with(b, mut at, c)?
    let right = codec.take_with(b, mut at, c)?
    Ok(Pair(left: take left, right: take right))
}

fn pair_schema_with[T](mut s: codec.Schema, c: codec.Codec[T]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Pair", 1)?
    codec.argument(mut s, c)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "left")?
    codec.schema_of(mut s, c)?
    codec.field(mut s, "right")?
    codec.schema_of(mut s, c)?
    codec.close(mut s)
    Ok(())
}

fn pair_u64_encode(x: Pair[u64], mut out: Bytes) -> Result[(), Capacity] {
    pair_encode_with(x, codec.of_u64(), mut out)
}

fn pair_u64_decode(b: Bytes, mut at: u64) -> Result[Pair[u64], codec.Stop] {
    pair_decode_with(b, mut at, codec.of_u64())
}

fn pair_u64_schema(mut s: codec.Schema, c: codec.Codec[Pair[u64]]) -> Result[(), Capacity] {
    pair_schema_with(mut s, codec.of_u64())
}

fn pairs_u64() -> codec.Codec[Pair[u64]] {
    codec.make(pair_u64_encode, pair_u64_decode, pair_u64_schema, 16)
}

fn pair_string_encode(x: Pair[String], mut out: Bytes) -> Result[(), Capacity] {
    pair_encode_with(x, codec.of_string(), mut out)
}

fn pair_string_decode(b: Bytes, mut at: u64) -> Result[Pair[String], codec.Stop] {
    pair_decode_with(b, mut at, codec.of_string())
}

fn pair_string_schema(mut s: codec.Schema, c: codec.Codec[Pair[String]]) -> Result[(), Capacity] {
    pair_schema_with(mut s, codec.of_string())
}

fn pairs_string() -> codec.Codec[Pair[String]] {
    codec.make(pair_string_encode, pair_string_decode, pair_string_schema, 8)
}

// Pair[u64]'s schema by hand: one definition "t.Pair" with one argument (u64), two u64
// fields. Pair[String] is another definition (its argument differs); resolution goes by
// the fields, so reading Pair[String] bytes as Pair[u64] is refused at the writer's
// first field type (offset 54). The u64 pair round-trips.
// expect: run generic_pair() = (true, true, 6034)
fn generic_pair() -> (bool, bool, u64) {
    let a = result.unwrap(codec.schema(pairs_u64())) == unhex("03 01000000 06000000 742e50616972 01000000 06 00 02000000 00 04000000 6c656674 06 00 05000000 7269676874 06 13 00000000")
    let b = again(pairs_u64(), unhex("0100000000000000 0200000000000000"))
    let c = refusal(pairs_u64(), result.unwrap(codec.schema(pairs_string())), unhex(""))
    (a, b, c)
}

// (d) A recursive type: `type Tree codec { label: u64, kids: List[Tree] }`. Encode
// recurses (OWN-19: no List[View[Tree]] to walk with); decode is a frame loop, so any
// depth the bytes hold decodes without growing the call stack.
type Tree {
    label: u64,
    kids: List[Tree]
}

type TreeFrame {
    label: u64,
    kids: List[Tree],
    left: u64
}

fn tree_encode(x: Tree, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_u64(x.label, mut out)?
    codec.put_list(x.kids, trees(), mut out)
}

fn tree_decode(b: Bytes, mut at: u64) -> Result[Tree, codec.Stop] {
    let mut stack: List[TreeFrame] = list.new()
    loop {
        let label = codec.take_u64(b, mut at)?
        let n = codec.take_count(b, mut at, 12)?
        if n > 0 {
            let kids: List[Tree] = codec.room(n)?
            list.push(mut stack, TreeFrame(label, kids: take kids, left: n))
            continue
        }
        let mut done = Tree(label, kids: list.new())
        loop {
            let mut f = match list.pop(mut stack) {
                Some(top) => take top,
                None => return Ok(take done)
            }
            list.push(mut f.kids, take done)
            f.left -= 1
            if f.left > 0 {
                list.push(mut stack, take f)
                break
            }
            done = Tree(label: f.label, kids: replace(mut f.kids, list.new()))
        }
    }
}

fn tree_schema(mut s: codec.Schema, c: codec.Codec[Tree]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Tree", 0)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "label")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "kids")?
    codec.schema_list(mut s, trees())?
    codec.close(mut s)
    Ok(())
}

fn trees() -> codec.Codec[Tree] {
    codec.make(tree_encode, tree_decode, tree_schema, 12)
}

// An earlier Tree with its fields the other way round, as a writer.
fn swapped_tree_encode(x: Tree, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_list(x.kids, swapped_trees(), mut out)?
    codec.put_u64(x.label, mut out)
}

fn swapped_tree_schema(mut s: codec.Schema, c: codec.Codec[Tree]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Tree", 0)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "kids")?
    codec.schema_list(mut s, swapped_trees())?
    codec.field(mut s, "label")?
    codec.schema_u64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn swapped_trees() -> codec.Codec[Tree] {
    codec.make(swapped_tree_encode, tree_decode, swapped_tree_schema, 12)
}

// Labels in preorder as digits, iteratively, taking the tree apart as it goes.
fn preorder(take t: Tree) -> u64 {
    let mut digits: u64 = 0
    let mut todo: List[Tree] = list.new()
    list.push(mut todo, take t)
    while let Some(top) = list.pop(mut todo) {
        let mut x = take top
        digits = digits * 10 + x.label
        while let Some(k) = list.pop(mut x.kids) {
            list.push(mut todo, take k)
        }
    }
    digits
}

fn tree_bytes() -> Bytes {
    unhex("0100000000000000 02000000 0200000000000000 00000000 0300000000000000 01000000 0400000000000000 00000000")
}

// Tree 1 [2 [], 3 [4 []]] by hand: label, count, kids; its schema refers to itself (the
// kids' element is reference 0, not the definition again). Every prefix is Truncated.
// Written by the swapped version and read through resolution, the one record node
// serves every level: preorder 1, 2, 3, 4 again. A schema writer that re-expands the
// definition never terminates; a plan that compiled per level would too.
// expect: run recursive_tree() = (true, true, 1234, 1234)
fn recursive_tree() -> (bool, bool, u64, u64) {
    let a = result.unwrap(codec.schema(trees())) == unhex("03 01000000 06000000 742e54726565 00000000 00 02000000 00 05000000 6c6162656c 06 00 04000000 6b696473 0e 13 00000000 13 00000000")
    let b = prefixes(trees(), tree_bytes())
    let c = match codec.decode(trees(), tree_bytes()) {
        Ok(Ok(t)) => preorder(take t),
        _ => 0
    }
    let swapped = match codec.decode(trees(), tree_bytes()) {
        Ok(Ok(t)) => enc(swapped_trees(), t),
        _ => list.new()
    }
    let d = match through(trees(), result.unwrap(codec.schema(swapped_trees())), swapped) {
        Ok(t) => preorder(take t),
        Error(k) => k
    }
    (a, b, c, d)
}

// A chain of depth d, label i and one kid down to a leaf, decoded directly and, written
// by the swapped version, through resolution; each the depth counted iteratively (the
// chain taken apart the same way) or a decode error's code, 9999 for Capacity.
fn deep(depth: u64) -> (u64, u64) {
    let a = deep_decode(depth)
    let mut w: Bytes = list.with_capacity(12 * depth + 12)
    let mut i: u64 = 0
    while i < depth {
        result.unwrap(codec.put_u32(1, mut w))
        i += 1
    }
    result.unwrap(codec.put_u32(0, mut w))
    list.put_word_le(mut w, depth)
    while i > 0 {
        i -= 1
        list.put_word_le(mut w, i)
    }
    let c = match through(trees(), result.unwrap(codec.schema(swapped_trees())), w) {
        Ok(t) => chain(take t),
        Error(k) => k
    }
    (a, c)
}

fn deep_decode(depth: u64) -> u64 {
    let mut b: Bytes = list.with_capacity(12 * depth + 12)
    let mut i: u64 = 0
    while i < depth {
        list.put_word_le(mut b, i)
        result.unwrap(codec.put_u32(1, mut b))
        i += 1
    }
    list.put_word_le(mut b, depth)
    result.unwrap(codec.put_u32(0, mut b))
    match codec.decode(trees(), b) {
        Ok(Ok(t)) => chain(take t),
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// Depth 10^4 decodes exactly, both ways: the frame loops keep each level's place, and a
// reordered record at every level relinks its own fields only (a rebuild that copied the
// record's whole subtree was quadratic here).
// expect: run deep_chain() = (10000, 10000)
fn deep_chain() -> (u64, u64) {
    deep(10000)
}

// Depth 10^6: SEM-10 sets no nesting limit, so each path decodes the whole chain or stops
// at Capacity (under the engines' 64 MiB test limit it is Capacity), never a stack
// overflow, which a decoder that recursed per level hits long before. It takes `out` so
// it runs on the engines only: the evaluator holds about 30 KB a level (4 GB at 10^5).
// expect: run deep_tree(out) = true
fn deep_tree(out: Stdout) -> bool {
    let (a, c) = deep(1000000)
    (a == 1000000 || a == 9999) && (c == 1000000 || c == 9999)
}

fn chain(take t: Tree) -> u64 {
    let mut x = take t
    let mut d: u64 = 0
    while let Some(k) = list.pop(mut x.kids) {
        x = take k
        d += 1
    }
    d
}

// (e) A field whose type is another package's codec type: the generated code calls that
// package's codec (std's DecodeError here, std.codec.of_decode_error). `type Failure
// codec { at: u64, why: codec.DecodeError }`.
type Failure {
    at: u64,
    why: codec.DecodeError
}

fn failure_encode(x: Failure, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_u64(x.at, mut out)?
    codec.put_with(x.why, codec.of_decode_error(), mut out)
}

fn failure_decode(b: Bytes, mut at: u64) -> Result[Failure, codec.Stop] {
    let offset = codec.take_u64(b, mut at)?
    let why = codec.take_with(b, mut at, codec.of_decode_error())?
    Ok(Failure(at: offset, why: take why))
}

fn failure_schema(mut s: codec.Schema, c: codec.Codec[Failure]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Failure", 0)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "at")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "why")?
    codec.schema_of(mut s, codec.of_decode_error())?
    codec.close(mut s)
    Ok(())
}

fn failures() -> codec.Codec[Failure] {
    codec.make(failure_encode, failure_decode, failure_schema, 20)
}

// Failure(at: 3, why: Utf8(9)) is 3, tag 2, 9; the schema holds both definitions, the
// foreign one second (met second), its seven variants in declared order.
// expect: run foreign_codec_type() = (true, true, true)
fn foreign_codec_type() -> (bool, bool, bool) {
    let x = Failure(at: 3, why: Utf8(9))
    let a = enc(failures(), x) == unhex("0300000000000000 02000000 0900000000000000")
    let b = prefixes(failures(), unhex("0300000000000000 06000000 0900000000000000"))
    let c = result.unwrap(codec.schema(failures())) == unhex("03 02000000 09000000 742e4661696c757265 00000000 00 02000000 00 02000000 6174 06 00 03000000 776879 13 01000000 15000000 7374642e636f6465632e4465636f64654572726f72 00000000 01 07000000 00 09000000 5472756e6361746564 01000000 06 00 07000000 496e76616c6964 01000000 06 00 04000000 55746638 01000000 06 00 09000000 4475706c6963617465 01000000 06 00 08000000 547261696c696e67 01000000 06 00 06000000 536368656d61 01000000 06 00 05000000 56616c7565 01000000 06 13 00000000")
    (a, b, c)
}

// (g) `via R (to, from)`, SEM-10's Range: `type RangeWire: codec { lo: u64, hi: u64 }`,
// `type Range: codec via RangeWire (to: wire, from: check) { w: RangeWire }`. The encode
// calls `to` in place, since its anchored view fits no callable type (LANG-13); the
// decode hands `from` to take_via; the schema is Range's path over RangeWire's.
type RangeWire {
    lo: u64,
    hi: u64
}

type Range {
    w: RangeWire
}

fn wire(r: Range) -> View[RangeWire] in r {
    view r.w
}

fn check(take w: RangeWire) -> Result[Range, ()] {
    if w.lo <= w.hi {
        Ok(Range(w))
    } else {
        Error(())
    }
}

fn range_wire_encode(x: RangeWire, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_u64(x.lo, mut out)?
    codec.put_u64(x.hi, mut out)
}

fn range_wire_decode(b: Bytes, mut at: u64) -> Result[RangeWire, codec.Stop] {
    let lo = codec.take_u64(b, mut at)?
    let hi = codec.take_u64(b, mut at)?
    Ok(RangeWire(lo, hi))
}

fn range_wire_schema(mut s: codec.Schema, c: codec.Codec[RangeWire]) -> Result[(), Capacity] {
    codec.define(mut s, "t.RangeWire", 0)?
    if codec.record(mut s, 2)? {
        return Ok(())
    }
    codec.field(mut s, "lo")?
    codec.schema_u64(mut s)?
    codec.field(mut s, "hi")?
    codec.schema_u64(mut s)?
    codec.close(mut s)
    Ok(())
}

fn range_wires() -> codec.Codec[RangeWire] {
    codec.make(range_wire_encode, range_wire_decode, range_wire_schema, 16)
}

fn range_encode(x: Range, mut out: Bytes) -> Result[(), Capacity] {
    codec.put_with(wire(x), range_wires(), mut out)
}

fn range_decode(b: Bytes, mut at: u64) -> Result[Range, codec.Stop] {
    codec.take_via(b, mut at, range_wires(), check)
}

fn range_schema(mut s: codec.Schema, c: codec.Codec[Range]) -> Result[(), Capacity] {
    codec.define(mut s, "t.Range", 0)?
    if codec.via(mut s)? {
        return Ok(())
    }
    codec.schema_of(mut s, range_wires())?
    codec.close(mut s)
    Ok(())
}

fn ranges() -> codec.Codec[Range] {
    codec.make(range_encode, range_decode, range_schema, 16)
}

fn range_at(b: Bytes, start: u64) -> u64 {
    match codec.decode_at(ranges(), b, start) {
        Ok(Ok(x)) => x.w.hi - x.w.lo,
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// Range(2, 5) is RangeWire's bytes; hi below lo is Value where the RangeWire began, at 0
// and at 4 behind "abcd"; through the resolver from Range's own schema it reads (3), and
// a writer whose path is RangeWire's is Schema. A via that wrote its own frame, checked
// before decoding R, reported the offset after R, or resolved R without the path, fails it.
// expect: run via_range() = (true, 7000, 7004, 3, true)
fn via_range() -> (bool, u64, u64, u64, bool) {
    let ok = unhex("0200000000000000 0500000000000000")
    let bad = unhex("0500000000000000 0200000000000000")
    let mut late = unhex("61626364")
    list.append(mut late, bad)
    let mine = result.unwrap(codec.schema(ranges()))
    let theirs = result.unwrap(codec.schema(range_wires()))
    let read = match through(ranges(), mine, ok) {
        Ok(x) => x.w.hi - x.w.lo,
        Error(k) => k
    }
    let other = match through(ranges(), theirs, ok) {
        Ok(_) => false,
        Error(k) => k / 1000 == 6
    }
    (prefixes(ranges(), ok) && enc(ranges(), result.unwrap(check(RangeWire(lo: 2, hi: 5)))) == ok, range_at(bad, 0), range_at(late, 4), read, other)
}

// Keys. Big-endian, sign flipped, 0x00 escaped as 00 ff and 00 00 ending a run, by hand.
// A little-endian or unflipped put, or an unescaped NUL, fails it.
// expect: run key_format() = true
fn key_format() -> bool {
    let u: u16 = 0x1234
    let small: i8 = -1
    let big: i64 = -2
    let zero: i32 = 0
    let mut nul: Bytes = list.new()
    list.push(mut nul, 0x61)
    list.push(mut nul, 0)
    list.push(mut nul, 0x62)
    key_enc(codec.key_u16(), u) == unhex("1234") && key_enc(codec.key_i8(), small) == unhex("7f") && key_enc(codec.key_i64(), big) == unhex("7ffffffffffffffe") && key_enc(codec.key_i32(), zero) == unhex("80000000") && key_enc(codec.key_bytes(), nul) == unhex("61 00ff 62 0000") && key_enc(codec.key_string(), "") == unhex("0000") && result.unwrap(codec.key_schema(codec.key_u64())) == unhex("04 00000000 06")
}

fn key_enc[T](k: codec.Key[T], x: T) -> Bytes {
    let mut out: Bytes = list.new()
    result.unwrap(codec.encode_key(k, x, mut out))
    take out
}

fn key_outcome[T](k: codec.Key[T], b: Bytes) -> u64 {
    match codec.decode_key(k, b) {
        Ok(Ok(_)) => 0,
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// -1, 0, 1 as a bytewise comparison: the hand-written order of byte strings, shortest
// first among equal prefixes.
fn compare(x: Bytes, y: Bytes) -> i64 {
    let mut i: u64 = 0
    while i < list.len(x) && i < list.len(y) {
        if x[i] != y[i] {
            return if x[i] < y[i] {
                -1
            } else {
                1
            }
        }
        i += 1
    }
    if list.len(x) == list.len(y) {
        0
    } else if list.len(x) < list.len(y) {
        -1
    } else {
        1
    }
}

fn sign(x: i64, y: i64) -> i64 {
    if x < y {
        -1
    } else if x == y {
        0
    } else {
        1
    }
}

// xorshift64: the pairs are random but the same on every engine.
fn next_random(mut seed: u64) -> u64 {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    seed
}

// Up to four bytes from {00, 01, fe, ff}: the bytes an escape scheme gets wrong.
fn random_bytes(mut seed: u64) -> Bytes {
    let mut b: Bytes = list.new()
    let n = next_random(mut seed) % 5
    let mut i: u64 = 0
    while i < n {
        let r = next_random(mut seed) % 4
        let byte: u8 = if r == 0 {
            0
        } else if r == 1 {
            1
        } else if r == 2 {
            0xfe
        } else {
            0xff
        }
        list.push(mut b, byte)
        i += 1
    }
    take b
}

// A tuple key (Bytes, i32), as the derive generates one: the parts concatenated.
fn tk_put(x: (Bytes, i32), mut out: Bytes) -> Result[(), Capacity] {
    codec.put_key_with(x.0, codec.key_bytes(), mut out)?
    codec.put_key_with(x.1, codec.key_i32(), mut out)
}

fn tk_take(b: Bytes, mut at: u64) -> Result[(Bytes, i32), codec.Stop] {
    let a = codec.take_key_with(b, mut at, codec.key_bytes())?
    let n = codec.take_key_with(b, mut at, codec.key_i32())?
    Ok((take a, n))
}

fn tk_schema(mut s: codec.Schema) -> Result[(), Capacity] {
    codec.schema_tuple(mut s, 2)?
    codec.schema_key(mut s, codec.key_bytes())?
    codec.schema_key(mut s, codec.key_i32())
}

fn tuple_keys() -> codec.Key[(Bytes, i32)] {
    codec.key_make(tk_put, tk_take, tk_schema)
}

// Key order is value order: on 3000 random pairs each of i64, u16, Bytes and the tuple
// (Bytes, i32), the bytewise comparison of the keys equals the hand comparison of the
// values (lexicographic for Bytes, by part for the tuple); each key decodes back. A
// key that is little-endian, keeps the sign bit, or lets "a" 00 sort against "a" by its
// terminator fails it.
// expect: run key_order_is_value_order() = 0
fn key_order_is_value_order() -> u64 {
    let mut seed: u64 = 0x9e3779b97f4a7c15
    let mut wrong: u64 = 0
    let mut k: u64 = 0
    while k < 3000 {
        let x: i64 = int.truncate(next_random(mut seed))
        let y: i64 = int.truncate(next_random(mut seed) >> (next_random(mut seed) % 64))
        if compare(key_enc(codec.key_i64(), x), key_enc(codec.key_i64(), y)) != sign(x, y) {
            wrong += 1
        }
        let u: u16 = int.truncate(next_random(mut seed))
        let v: u16 = int.truncate(next_random(mut seed))
        if compare(key_enc(codec.key_u16(), u), key_enc(codec.key_u16(), v)) != sign(int.widen(u), int.widen(v)) {
            wrong += 1
        }
        let a = random_bytes(mut seed)
        let b = random_bytes(mut seed)
        let ka = key_enc(codec.key_bytes(), a)
        if compare(ka, key_enc(codec.key_bytes(), b)) != compare(a, b) {
            wrong += 1
        }
        match codec.decode_key(codec.key_bytes(), ka) {
            Ok(Ok(back)) => {
                if back != a {
                    wrong += 1
                }
            }
            _ => {
                wrong += 1
            }
        }
        let n: i32 = int.truncate(int.wrapping_sub(next_random(mut seed) % 5, 2))
        let m: i32 = int.truncate(int.wrapping_sub(next_random(mut seed) % 5, 2))
        let by_parts = if compare(a, b) != 0 {
            compare(a, b)
        } else {
            sign(int.widen(n), int.widen(m))
        }
        let mut ta: Bytes = list.new()
        list.append(mut ta, a)
        let mut tb: Bytes = list.new()
        list.append(mut tb, b)
        if compare(key_enc(tuple_keys(), (take ta, n)), key_enc(tuple_keys(), (take tb, m))) != by_parts {
            wrong += 1
        }
        k += 1
    }
    wrong
}

// Key near misses: every prefix of a tuple key Truncated; an escape byte other than ff
// or 00 Invalid at it (2); a trailing byte (5); bool 2 Invalid (0); bad UTF-8 after an
// escaped NUL, Utf8 at its encoded offset (2, not the unescaped 1).
// expect: run key_near_misses() = (true, 2002, 5002, 2000, 3002)
fn key_near_misses() -> (bool, u64, u64, u64, u64) {
    let whole = unhex("61 00ff 0000 80000005")
    let mut ok = again_key(tuple_keys(), whole)
    let mut i: u64 = 0
    while i < list.len(whole) {
        let mut cut: Bytes = list.new()
        list.append(mut cut, list.slice(whole, 0, i))
        let o = key_outcome(tuple_keys(), cut)
        if o < 1000 || o > 1000 + i {
            ok = false
        }
        i += 1
    }
    (ok, key_outcome(codec.key_bytes(), unhex("61 0001 0000")), key_outcome(codec.key_bytes(), unhex("0000 00")), key_outcome(codec.key_bool(), unhex("02")), key_outcome(codec.key_string(), unhex("00ff c0 0000")))
}

fn again_key[T](k: codec.Key[T], b: Bytes) -> bool {
    match codec.decode_key(k, b) {
        Ok(Ok(x)) => key_enc(k, x) == b,
        _ => false
    }
}

// Nothing is left behind on an error: under a 16 KiB bound, 1000 decodes of a depth-20
// chain cut one byte short (each fails Truncated after building 20 levels), directly
// and through resolution, each the same refusal as unbounded (Truncated at the last
// count, 236; through resolution, Truncated at the last label, 244, as the swapped
// writer puts all 21 counts before the labels), then the whole chain both ways. Each
// failure must give its levels back; a decoder that kept one 16-byte frame per failed
// decode runs out after a few hundred and returns Capacity (9999) here.
// expect: run errors_return_their_bytes() = (1000, 1000, 20, 20)
fn errors_return_their_bytes() -> (u64, u64, u64, u64) {
    let whole = chain_bytes(20)
    let mut cut: Bytes = list.new()
    list.append(mut cut, list.slice(whole, 0, list.len(whole) - 1))
    let swapped = result.unwrap(codec.schema(swapped_trees()))
    let mut written: Bytes = list.new()
    match codec.decode(trees(), whole) {
        Ok(Ok(t)) => {
            written = enc(swapped_trees(), t)
        }
        _ => {}
    }
    let mut short: Bytes = list.new()
    list.append(mut short, list.slice(written, 0, list.len(written) - 1))
    let direct_refusal = outcome(trees(), cut)
    let resolved_refusal = refusal(trees(), swapped, short)
    if direct_refusal != 1000 + 236 || resolved_refusal != 1000 + 244 {
        return (0, 0, 0, 0)
    }
    result.unwrap(bound bytes 16384 {
        let mut direct: u64 = 0
        let mut resolved: u64 = 0
        let mut k: u64 = 0
        while k < 1000 {
            if outcome(trees(), cut) == direct_refusal {
                direct += 1
            }
            if refusal(trees(), swapped, short) == resolved_refusal {
                resolved += 1
            }
            k += 1
        }
        let a = match codec.decode(trees(), whole) {
            Ok(Ok(t)) => chain(take t),
            _ => 0
        }
        let b = match through(trees(), swapped, written) {
            Ok(t) => chain(take t),
            Error(c) => c
        }
        (direct, resolved, a, b)
    })
}

fn chain_bytes(depth: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(12 * depth + 12)
    let mut i: u64 = 0
    while i < depth {
        list.put_word_le(mut b, i)
        result.unwrap(codec.put_u32(1, mut b))
        i += 1
    }
    list.put_word_le(mut b, depth)
    result.unwrap(codec.put_u32(0, mut b))
    take b
}

// A reader held as the store holds it: shareable and send, in one Arc that two holders
// read through, each read starting after a 2-byte header in place. The values are
// evolution_reads_old_rows' (resolved and identity); the refusals are
// resolution_checks_writer_bytes' moved by the header (offsets are into the row); the
// identity reader's cut name is Truncated at 8 + 2; a start past the end is Truncated
// at the end. A Reader field that is not shareable is refused at arc.new; a read_at
// that ignores start, or reports offsets from it, fails.
// expect: run shared_reader_reads_in_place() = ((5, 2, 7), (9, 2, 3), (1010, 5016, 3014), (1010, 1001))
fn shared_reader_reads_in_place() -> ((u64, u64, i64), (u64, u64, i64), (u64, u64, u64), (u64, u64)) {
    let old = arc.new(sendable(resolved_rows(rows(), schema_bytes(v1_schema))))
    let held = arc.share(old)
    let same = arc.new(sendable(resolved_rows(rows(), schema_bytes(row_schema))))
    let tomb = resolved_rows(rows_tomb(), schema_bytes(noted_schema))
    let a = row_at(old, behind(enc(rows_v1(), row(5, "ab"))))
    let b = row_at(same, behind(enc(rows(), row(9, "yz"))))
    let c = row_at(held, behind(unhex("0500000000000000 02000000 61")))
    let d = row_at(held, behind(unhex("0500000000000000 02000000 6162 00")))
    let e = row_at(tomb, behind(unhex("0500000000000000 01000000 ff 01000000 61")))
    let f = row_at(same, behind(unhex("0900000000000000 02000000 79")))
    let g = match codec.read_at(same, unhex("ab"), 5) {
        Ok(Error(x)) => code(x),
        _ => 0
    }
    (a, b, (c.0, d.0, e.0), (f.0, g))
}

fn sendable[T: shareable + send](take x: T) -> T {
    take x
}

fn resolved_rows(c: codec.Codec[Row], writer: Bytes) -> codec.Reader[Row] {
    result.unwrap(result.unwrap(codec.resolve(c, writer)))
}

fn behind(b: Bytes) -> Bytes {
    let mut stored = unhex("abcd")
    list.append(mut stored, b)
    take stored
}

fn row_at(r: codec.Reader[Row], b: Bytes) -> (u64, u64, i64) {
    match codec.read_at(r, b, 2) {
        Ok(Ok(x)) => (x.id, string.byte_len(x.name), x.score),
        Ok(Error(e)) => (code(e), 0, 0),
        Error(_) => (9999, 0, 0)
    }
}

// The derive (EXPANSION section 0) against its twins. Each declaration below is a twin's,
// and the codec the checker generates for it must write the twin's bytes, schema and
// fingerprint, read what the twin reads and refuse what it refuses at the same offset.
// A schema's path is its definition's (std.tests.codec.DRow) where a twin writes t.Row,
// so a twin's schema is compared at the derived path (`at_path`).
type DRow: codec {
    id: u64,
    name: String,
    score: i64 = 7
}

type DTomb: codec {
    id: u64,
    removed note: String,
    name: String,
    score: i64 = 7
}

type DShape: codec = Dot | Circle(f64) | Rect(u64, u64)

type DCut: codec = Dot | Circle(f64) | removed Rect(u64, u64)

type DGap: codec = Dot | removed Circle(f64) | Rect(u64, u64)

// The schema b with its first definition's path replaced by `path`. Its path is at byte
// 5, after the version byte and the definition count (schema_by_hand).
fn at_path(b: Bytes, path: String) -> Bytes {
    let mut at: u64 = 5
    let n: u64 = int.widen(match codec.take_u32(b, mut at) {
        Ok(n) => n,
        Error(_) => 0
    })
    let mut out: Bytes = list.new()
    list.append(mut out, list.slice(b, 0, 5))
    result.unwrap(codec.put_string(path, mut out))
    list.append(mut out, list.slice(b, 9 + n, list.len(b)))
    take out
}

// The derived codec's schema is the twin's at the derived path, and so is its fingerprint.
fn same_schema[T](c: codec.Codec[T], twin: Bytes, path: String) -> bool {
    let want = at_path(twin, path)
    result.unwrap(codec.schema(c)) == want && result.unwrap(codec.fingerprint(c)) == codec.fingerprint_of(want)
}

fn drow_through(writer: Bytes, b: Bytes) -> (u64, u64, i64) {
    let c: codec.Codec[DRow] = codec.of()
    match through(c, at_path(writer, "std.tests.codec.DRow"), b) {
        Ok(x) => (x.id, string.byte_len(x.name), x.score),
        Error(k) => (k, 0, 0)
    }
}

fn dtomb_through(writer: Bytes, b: Bytes) -> (u64, u64, i64) {
    let c: codec.Codec[DTomb] = codec.of()
    match through(c, at_path(writer, "std.tests.codec.DTomb"), b) {
        Ok(x) => (x.id, string.byte_len(x.name), x.score),
        Error(k) => (k, 0, 0)
    }
}

// A record with a defaulted field (EXPANSION 1) and a tombstone (2). Row(5, "ab", 3)'s
// bytes and the twin's schema; least 20; version 1's bytes read with score defaulted
// (5, 2, 7) and reordered fields undone (6, 3, 7), as evolution_reads_old_rows; the
// writer's note dropped by the tombstone (8, 1, 7); and the offsets of
// resolution_checks_writer_bytes (1008, 5014, 3012). A derive that reorders fields, drops
// the default from the schema or numbers past the tombstone fails it.
// expect: run derived_record() = (true, true, 20, (5, 2, 7), (6, 3, 7), (8, 1, 7), (1008, 5014, 3012))
fn derived_record() -> (bool, bool, u64, (u64, u64, i64), (u64, u64, i64), (u64, u64, i64), (u64, u64, u64)) {
    let c: codec.Codec[DRow] = codec.of()
    let t: codec.Codec[DTomb] = codec.of()
    let written = enc(c, DRow(id: 5, name: "ab", score: 3)) == enc(rows(), row(5, "ab"))
    let schemas = same_schema(c, schema_bytes(row_schema), "std.tests.codec.DRow") && same_schema(t, schema_bytes(tomb_schema), "std.tests.codec.DTomb")
    let a = drow_through(schema_bytes(v1_schema), enc(rows_v1(), row(5, "ab")))
    let b = drow_through(schema_bytes(swapped_schema), enc(rows_swapped(), row(6, "abc")))
    let d = dtomb_through(schema_bytes(noted_schema), enc(rows_noted(), row(8, "x")))
    let v1 = at_path(schema_bytes(v1_schema), "std.tests.codec.DRow")
    let e = refusal(c, v1, unhex("0500000000000000 02000000 61"))
    let f = refusal(c, v1, unhex("0500000000000000 02000000 6162 00"))
    let g = refusal(t, at_path(schema_bytes(noted_schema), "std.tests.codec.DTomb"), unhex("0500000000000000 01000000 ff 01000000 61"))
    (written, schemas, codec.least(c), a, b, d, (e, f, g))
}

fn dshape_code(x: DShape) -> u64 {
    match x {
        Dot => 1,
        Circle(_) => 2,
        Rect(w, h) => 30 + w + h
    }
}

fn dcut_code(x: DCut) -> u64 {
    match x {
        Dot => 1,
        Circle(_) => 2
    }
}

// A sum (EXPANSION 3) and a removed variant (2). Rect(1, 2) by hand and the twin's
// schema; least 4; tags_are_u32's refusals (2000, 2000, 5004) and prefixes; the old
// writer's Circle (2). With Rect removed: the twin's schema, Circle read (2), a held Rect
// Schema at the writer's entry (variant_evolution's 6053, 13 bytes on: the path
// std.tests.codec.DCut is 13 bytes longer than t.Shape), and Rect's own tag refused on
// decode, Invalid at the tag (2000). With Circle removed before it, Rect keeps tag 2: the
// same bytes by hand, read back (0), and Circle's tag Invalid at the tag (2000). A derive
// that puts the tag after the payload, numbers live variants only, or decodes the removed
// tag as a value fails it.
// expect: run derived_sum() = (true, true, 4, (2000, 2000, 5004, true), 2, true, (2, 6066, 2000), (true, 0, 2000))
fn derived_sum() -> (bool, bool, u64, (u64, u64, u64, bool), u64, bool, (u64, u64, u64), (bool, u64, u64)) {
    let c: codec.Codec[DShape] = codec.of()
    let cut: codec.Codec[DCut] = codec.of()
    let circle = unhex("01000000 000000000000f03f")
    let rect = unhex("02000000 0100000000000000 0200000000000000")
    let r: DShape = Rect(1, 2)
    let written = enc(c, r) == rect
    let schema = same_schema(c, shape_schema_bytes(shape_schema), "std.tests.codec.DShape")
    let tags = (outcome(c, unhex("03000000")), outcome(c, unhex("00000001")), outcome(c, unhex("0000000000000000")), prefixes(c, rect))
    let old = match through(c, at_path(shape_schema_bytes(old_shape_schema), "std.tests.codec.DShape"), circle) {
        Ok(x) => dshape_code(x),
        Error(k) => k
    }
    let cut_schema = same_schema(cut, shape_schema_bytes(cut_shape_schema), "std.tests.codec.DCut")
    let writer = at_path(shape_schema_bytes(shape_schema), "std.tests.codec.DCut")
    let a = match through(cut, writer, circle) {
        Ok(x) => dcut_code(x),
        Error(k) => k
    }
    let b = refusal(cut, writer, rect)
    let gap: codec.Codec[DGap] = codec.of()
    let g: DGap = Rect(1, 2)
    let gaps = (enc(gap, g) == rect, outcome(gap, rect), outcome(gap, circle))
    (written, schema, codec.least(c), tags, old, cut_schema, (a, b, outcome(cut, rect)), gaps)
}

// A generic type (EXPANSION 4): DPair[T] is a codec type when T is, and its derived items
// take `T: codec`, so `codec.of[T]()` in them is T's own maker at each instance.
type DPair[T]: codec {
    left: T,
    right: T
}

// of[DPair[T]] inside a generic body: the instance's row carries DPair[T]'s maker at its T.
// `t` only fixes T.
fn dpair_again[T: codec](b: Bytes, t: codec.Codec[T]) -> bool {
    let c: codec.Codec[DPair[T]] = codec.of()
    again(c, b)
}

fn dpair_schema[T: codec](t: codec.Codec[T]) -> Bytes {
    let c: codec.Codec[DPair[T]] = codec.of()
    result.unwrap(codec.schema(c))
}

// DPair[u64] against the twin pairs_u64: the same bytes, its schema at the derived path,
// least 16, and Pair[String]'s writer refused at the first field type (generic_pair's
// 6034, 15 bytes on: std.tests.codec.DPair is 15 bytes longer than t.Pair). Nested,
// DPair[DPair[u64]] holds four u64s (least 32) and round-trips, and the same maker reached
// through a generic body at T = DPair[u64] reads the same bytes and writes the same
// schema, while at T = u64 it refuses them (trailing bytes). DPair[DPair[String]], made
// after DPair[u64], writes its four strings by hand (count, then bytes) and reads them
// back. An `of` that resolves a nested instance at the wrong level, or takes another
// instance of the same declaration, fails it.
// expect: run derived_generic() = (true, true, 16, 6049, (32, true, true, true, false), (true, true))
fn derived_generic() -> (bool, bool, u64, u64, (u64, bool, bool, bool, bool), (bool, bool)) {
    let c: codec.Codec[DPair[u64]] = codec.of()
    let p: DPair[u64] = DPair(left: 1, right: 2)
    let written = enc(c, p) == enc(pairs_u64(), Pair(left: 1, right: 2))
    let schema = same_schema(c, result.unwrap(codec.schema(pairs_u64())), "std.tests.codec.DPair")
    let s: codec.Codec[DPair[String]] = codec.of()
    let held = refusal(c, result.unwrap(codec.schema(s)), unhex(""))
    let n: codec.Codec[DPair[DPair[u64]]] = codec.of()
    let four = unhex("0100000000000000 0200000000000000 0300000000000000 0400000000000000")
    let nested = (codec.least(n), again(n, four), dpair_again(four, c), dpair_schema(c) == result.unwrap(codec.schema(n)), dpair_again(four, codec.of_u64()))
    let ns: codec.Codec[DPair[DPair[String]]] = codec.of()
    let v: DPair[DPair[String]] = DPair(left: DPair(left: "a", right: "b"), right: DPair(left: "c", right: "d"))
    let strings = unhex("01000000 61 01000000 62 01000000 63 01000000 64")
    let strung = (enc(ns, v) == strings, again(ns, strings))
    (written, schema, codec.least(c), held, nested, strung)
}

type DBox[T]: codec {
    v: T
}

// A generic whose field nests two generics at its parameter: DNest[u64]'s instance reaches
// DPair[DBox[u64]], whose DBox[u64] row is built by substitution there, so DPair's derived
// `of[T]` finds DBox[u64]'s maker only on that row. Two u64s by hand, least 16, and back.
type DNest[T]: codec {
    inner: DPair[DBox[T]]
}

// expect: run derived_nested_generic() = (true, true, 16)
fn derived_nested_generic() -> (bool, bool, u64) {
    let c: codec.Codec[DNest[u64]] = codec.of()
    let x: DNest[u64] = DNest(inner: DPair(left: DBox(v: 1), right: DBox(v: 2)))
    let two = unhex("0100000000000000 0200000000000000")
    (enc(c, x) == two, again(c, two), codec.least(c))
}

// A recursive type (EXPANSION 5), derived: its decode is the frame loop.
type DTree: codec {
    label: u64,
    kids: List[DTree]
}

fn dpreorder(take t: DTree) -> u64 {
    let mut digits: u64 = 0
    let mut todo: List[DTree] = list.new()
    list.push(mut todo, take t)
    while let Some(top) = list.pop(mut todo) {
        let mut x = take top
        digits = digits * 10 + x.label
        while let Some(k) = list.pop(mut x.kids) {
            list.push(mut todo, take k)
        }
    }
    digits
}

// A DTree chain of depth d (label i, one kid) decoded: its depth counted iteratively, a
// decode error's code, or 9999 for Capacity.
fn dchain(depth: u64) -> u64 {
    let mut b: Bytes = list.with_capacity(12 * depth + 12)
    let mut i: u64 = 0
    while i < depth {
        list.put_word_le(mut b, i)
        result.unwrap(codec.put_u32(1, mut b))
        i += 1
    }
    list.put_word_le(mut b, depth)
    result.unwrap(codec.put_u32(0, mut b))
    let c: codec.Codec[DTree] = codec.of()
    match codec.decode(c, b) {
        Ok(Ok(t)) => {
            let mut x = take t
            let mut d: u64 = 0
            while let Some(k) = list.pop(mut x.kids) {
                x = take k
                d += 1
            }
            d
        }
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// DTree against the twin trees(): the twin's schema at the derived path (the kids'
// element a reference to the open definition), least 12, every prefix of Tree 1 [2 [], 3
// [4 []]] Truncated and the whole read back in preorder; the swapped writer's bytes read
// through resolution; a count no remaining bytes could hold Truncated at the count
// (1008); a chain 10^4 deep; and encoding a schema count of u32::MAX + 1
// returns Capacity(requested: 4294967296, available: 4294967295).
// expect: run derived_tree() = (true, 12, true, 1234, 1234, 1008, 10000, true)
fn derived_tree() -> (bool, u64, bool, u64, u64, u64, u64, bool) {
    let c: codec.Codec[DTree] = codec.of()
    let schema = same_schema(c, result.unwrap(codec.schema(trees())), "std.tests.codec.DTree")
    let read = match codec.decode(c, tree_bytes()) {
        Ok(Ok(t)) => dpreorder(take t),
        _ => 0
    }
    let swapped = match codec.decode(trees(), tree_bytes()) {
        Ok(Ok(t)) => enc(swapped_trees(), t),
        _ => list.new()
    }
    let old = match through(c, at_path(result.unwrap(codec.schema(swapped_trees())), "std.tests.codec.DTree"), swapped) {
        Ok(t) => dpreorder(take t),
        Error(k) => k
    }
    let lying = outcome(c, unhex("0100000000000000 ffffffff"))
    let oversized = codec.make(tree_encode, tree_decode, oversized_schema, 12)
    let refused = match codec.schema(oversized) {
        Error(f) => f.requested == 0x100000000 && f.available == 0xffffffff,
        Ok(_) => false
    }
    (schema, codec.least(c), prefixes(c, tree_bytes()), read, old, lying, dchain(10000), refused)
}

// Exercise the same count writer without allocating a list larger than four GiB.
fn oversized_schema(mut s: codec.Schema, c: codec.Codec[Tree]) -> Result[(), Capacity] {
    codec.schema_tuple(mut s, 0x100000000)
}

// A chain 10^6 deep decodes whole or stops at Capacity, never overflowing the stack as a
// decoder that recursed per level would; engines only, as deep_tree.
// expect: run derived_deep_tree(out) = true
fn derived_deep_tree(out: Stdout) -> bool {
    let d = dchain(1000000)
    d == 1000000 || d == 9999
}

// A recursive group of two (EXPANSION 5's general rule): DExpr reaches DArg through a
// List, DArg reaches DExpr directly and through an Option, and DExpr reaches itself
// through a Map's values; a removed variant keeps its tag.
type DExpr: codec = Num(u64) | Call(String, List[DArg]) | removed Old(u64) | Env(Map[u64, DExpr])

type DArg: codec {
    name: u8,
    value: DExpr,
    default: Option[DExpr]
}

// Numbers, plus 100 per call name's byte, 1000 per argument name, 10000 per map key.
fn dsum(e: DExpr) -> u64 {
    match e {
        Num(n) => n,
        Call(f, args) => {
            let mut s = 100 * string.byte_len(f)
            for a in args {
                let n: u64 = int.widen(a.name)
                s += 1000 * n + dsum(a.value)
                if let Some(d) = a.default {
                    s += dsum(d)
                }
            }
            s
        }
        Env(m) => {
            let mut s: u64 = 0
            for (k, v) in m {
                s += 10000 * k + dsum(v)
            }
            s
        }
    }
}

fn dexpr_sum(b: Bytes) -> u64 {
    let c: codec.Codec[DExpr] = codec.of()
    match codec.decode(c, b) {
        Ok(Ok(e)) => dsum(e),
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// A generic member reached at its own parameter.
type DGTree[T]: codec {
    label: T,
    kids: List[DGTree[T]]
}

// Call("f", [DArg(1, Num(7), Some(Env({5: Num(6)}))), DArg(2, Call("g", []), None)]),
// written by hand (tags u32: Num 0, Call 1, Old 2, Env 3; Option 0/1), reads back to its
// sum 53213 and every prefix is Truncated; the second argument alone reads through DArg's
// own decode. Least by hand: DExpr 4 + min(8, 8, 4) = 8, DArg 1 + 8 + 4 = 13. Refused
// at their offsets: the removed Old's tag (2000), an Option tag 2 (2026), a map key
// repeated (4028), a call's count no bytes could hold (1008). DGTree[String] "a" ["b"]
// round-trips, its count checked against least(of[String]) + 4 = 8.
// expect: run derived_group() = (53213, true, true, (8, 13), (2000, 2026, 4028, 1008), (true, 8))
fn derived_group() -> (u64, bool, bool, (u64, u64), (u64, u64, u64, u64), (bool, u64)) {
    let c: codec.Codec[DExpr] = codec.of()
    let a: codec.Codec[DArg] = codec.of()
    let call = unhex("01000000 01000000 66 02000000 01 00000000 0700000000000000 01000000 03000000 01000000 0500000000000000 00000000 0600000000000000 02 01000000 01000000 67 00000000 00000000")
    let arg = unhex("02 01000000 01000000 67 00000000 00000000")
    let refused = (outcome(c, unhex("02000000 0700000000000000")), outcome(c, unhex("01000000 01000000 66 01000000 01 00000000 0700000000000000 02000000")), outcome(c, unhex("03000000 02000000 0500000000000000 00000000 0600000000000000 0500000000000000 00000000 0700000000000000")), outcome(c, unhex("01000000 00000000 ffffffff")))
    let g: codec.Codec[DGTree[String]] = codec.of()
    let generic = (again(g, unhex("01000000 61 01000000 01000000 62 00000000")), codec.least(g))
    (dexpr_sum(call), prefixes(c, call), again(a, arg), (codec.least(c), codec.least(a)), refused, generic)
}

// The schema b with every definition path `from` replaced by `to`, matched as the
// length-prefixed string the schema holds.
fn repath(b: Bytes, from: String, to: String) -> Bytes {
    let mut needle: Bytes = list.new()
    result.unwrap(codec.put_string(from, mut needle))
    let mut with: Bytes = list.new()
    result.unwrap(codec.put_string(to, mut with))
    let n = list.len(needle)
    let mut out: Bytes = list.new()
    let mut i: u64 = 0
    while i < list.len(b) {
        let mut k: u64 = 0
        while k < n && i + k < list.len(b) && b[i + k] == needle[k] {
            k += 1
        }
        if k == n {
            list.append(mut out, with)
            i += n
        } else {
            list.push(mut out, b[i])
            i += 1
        }
    }
    take out
}

// SEM-10's Range derived (EXPANSION 7), its wire derived too.
type DRangeWire: codec {
    lo: u64,
    hi: u64
}

type DRange: codec via DRangeWire(to: dwire, from: dcheck) {
    w: DRangeWire
}

fn dwire(r: DRange) -> View[DRangeWire] in r {
    view r.w
}

fn dcheck(take w: DRangeWire) -> Result[DRange, ()] {
    if w.lo <= w.hi {
        Ok(DRange(w))
    } else {
        Error(())
    }
}

// A generic via: `to` and `from` at the declaration's parameter, over a nominal generic R.
type DOrdered[T: ordered]: codec via DPair[T] (to: dord_pair, from: dordered) {
    p: DPair[T]
}

fn dord_pair[T: ordered](o: DOrdered[T]) -> View[DPair[T]] in o {
    view o.p
}

fn dordered[T: ordered](take p: DPair[T]) -> Result[DOrdered[T], ()] {
    if p.left <= p.right {
        Ok(DOrdered(p))
    } else {
        Error(())
    }
}

// A via over a List: R's codec is std's of_list at T (structural_of).
type DNonEmpty[T]: codec via List[T] (to: dnon_items, from: dnonempty) {
    items: List[T]
}

fn dnon_items[T](n: DNonEmpty[T]) -> View[List[T]] in n {
    view n.items
}

fn dnonempty[T](take xs: List[T]) -> Result[DNonEmpty[T], ()] {
    if list.len(xs) > 0 {
        Ok(DNonEmpty(items: xs))
    } else {
        Error(())
    }
}

fn drange_at(b: Bytes, start: u64) -> u64 {
    let c: codec.Codec[DRange] = codec.of()
    match codec.decode_at(c, b, start) {
        Ok(Ok(x)) => x.w.hi - x.w.lo,
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// DRange against the twin ranges(): Range(2, 5)'s bytes and every prefix; the twin's
// schema with both paths derived, and its fingerprint; least 16 (RangeWire's); hi below lo
// is Value where the wire began, at 0 and at 4 behind "abcd"; through its own schema it
// reads 3, and through the wire's schema it is Schema. DOrdered[u64] (2, 5) round-trips,
// (5, 2) is Value at 0, least 16 (DPair[u64]'s); DOrdered[String] ("a", "b") round-trips
// and ("b", "a") is Value at 0.
// expect: run derived_via() = (true, true, 16, (7000, 7004), 3, true, (true, 7000, 16, true, 7000))
fn derived_via() -> (bool, bool, u64, (u64, u64), u64, bool, (bool, u64, u64, bool, u64)) {
    let c: codec.Codec[DRange] = codec.of()
    let ok = unhex("0200000000000000 0500000000000000")
    let bad = unhex("0500000000000000 0200000000000000")
    let mut late = unhex("61626364")
    list.append(mut late, bad)
    let written = enc(c, result.unwrap(dcheck(DRangeWire(lo: 2, hi: 5)))) == ok && prefixes(c, ok)
    let twin = result.unwrap(codec.schema(ranges()))
    let want = repath(repath(twin, "t.Range", "std.tests.codec.DRange"), "t.RangeWire", "std.tests.codec.DRangeWire")
    let schema = result.unwrap(codec.schema(c)) == want && result.unwrap(codec.fingerprint(c)) == codec.fingerprint_of(want)
    let read = match through(c, result.unwrap(codec.schema(c)), ok) {
        Ok(x) => x.w.hi - x.w.lo,
        Error(k) => k
    }
    let w: codec.Codec[DRangeWire] = codec.of()
    let other = match through(c, result.unwrap(codec.schema(w)), ok) {
        Ok(_) => false,
        Error(k) => k / 1000 == 6
    }
    let g: codec.Codec[DOrdered[u64]] = codec.of()
    let s: codec.Codec[DOrdered[String]] = codec.of()
    let generic = (again(g, ok), outcome(g, bad), codec.least(g), again(s, unhex("01000000 61 01000000 62")), outcome(s, unhex("01000000 62 01000000 61")))
    (written, schema, codec.least(c), (drange_at(bad, 0), drange_at(late, 4)), read, other, generic)
}

// The structural codecs (EXPANSION 7, 9.1): `of` at a List, Option, Map, Result or Bytes,
// or a nest of them, is std's of_list and the rest, which write what the derive writes for
// the same type as a field. SHold holds one of each.
type SHold: codec {
    xs: List[u64],
    o: Option[String],
    m: Map[String, u64],
    r: Result[u64, String],
    b: Bytes,
    n: List[Option[String]]
}

// c is the codec of a type whose schema is `root` alone (no definitions): x's bytes
// are `hex`, every prefix of them is Truncated, the schema and fingerprint are that
// root's, least is `least`, and `of` through a generic body (generic_of) agrees.
fn structural[T: codec](c: codec.Codec[T], x: T, hex: String, root: String, least: u64) -> bool {
    let mut want = unhex("03 00000000")
    list.append(mut want, unhex(root))
    enc(c, x) == unhex(hex) && prefixes(c, unhex(hex)) && result.unwrap(codec.schema(c)) == want && result.unwrap(codec.fingerprint(c)) == codec.fingerprint_of(want) && codec.least(c) == least && same_codec(c, generic_of(), x)
}

fn sample() -> SHold {
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 1)
    list.push(mut xs, 2)
    let mut m: Map[String, u64] = map.new()
    map.insert(mut m, string.from("a"), 1)
    map.insert(mut m, string.from("b"), 2)
    let mut b: Bytes = list.new()
    list.push(mut b, 0xab)
    list.push(mut b, 0xcd)
    let mut n: List[Option[String]] = list.new()
    list.push(mut n, Some(string.from("a")))
    list.push(mut n, None)
    SHold(xs, o: Some(string.from("hé")), m, r: Error(string.from("x")), b, n)
}

// Each field of sample() through `of` at its type, by hand: List[u64] [1, 2]; Option[String]
// Some("hé") (tag 1, then the string); Map[String, u64] {"a": 1, "b": 2} in insertion
// order; Result[u64, String] Error("x") (tag 1) and Ok(7) (tag 0); Bytes [ab, cd] as
// List[u8]; List[Option[String]] [Some("a"), None]. Schema opcodes: 14 List, 15 Map,
// 16 Option, 17 Result, 3 u8, 6 u64, 13 String. Least: 4 for List and Map, 4 for Option
// and Result. Then SHold's derived bytes are the six fields' in order, its schema the one
// definition whose six field types are those roots, and its least their sum, 24. Refused
// through the makers: a map key repeated (Duplicate at the second key, 17), an Option or
// Result tag 2 (Invalid at 0). A maker with another element codec, tag order, opcode or
// least, or an `of` that misses a maker at a closed type or through a generic, fails it.
// expect: run structural_of() = ((true, true, true, true, true, true, true), (true, true, true), (4017, 2000, 2000))
fn structural_of() -> ((bool, bool, bool, bool, bool, bool, bool), (bool, bool, bool), (u64, u64, u64)) {
    let h = sample()
    let xs: codec.Codec[List[u64]] = codec.of()
    let o: codec.Codec[Option[String]] = codec.of()
    let m: codec.Codec[Map[String, u64]] = codec.of()
    let r: codec.Codec[Result[u64, String]] = codec.of()
    let b: codec.Codec[Bytes] = codec.of()
    let n: codec.Codec[List[Option[String]]] = codec.of()
    let ok: Result[u64, String] = Ok(7)
    let fields = (structural(xs, h.xs, "02000000 0100000000000000 0200000000000000", "0e06", 4), structural(o, h.o, "01000000 03000000 68c3a9", "100d", 4), structural(m, h.m, "02000000 01000000 61 0100000000000000 01000000 62 0200000000000000", "0f0d06", 4), structural(r, h.r, "01000000 01000000 78", "11060d", 4), structural(r, ok, "00000000 0700000000000000", "11060d", 4), structural(b, h.b, "02000000 abcd", "0e03", 4), structural(n, h.n, "02000000 01000000 01000000 61 00000000", "0e100d", 4))
    let c: codec.Codec[SHold] = codec.of()
    let mut whole: Bytes = list.new()
    list.append(mut whole, enc(xs, h.xs))
    list.append(mut whole, enc(o, h.o))
    list.append(mut whole, enc(m, h.m))
    list.append(mut whole, enc(r, h.r))
    list.append(mut whole, enc(b, h.b))
    list.append(mut whole, enc(n, h.n))
    let schema = unhex("03 01000000 15000000 7374642e74657374732e636f6465632e53486f6c64 00000000 00 06000000 00 02000000 7873 0e06 00 01000000 6f 100d 00 01000000 6d 0f0d06 00 01000000 72 11060d 00 01000000 62 0e03 00 01000000 6e 0e100d 13 00000000")
    let held = (enc(c, h) == whole, result.unwrap(codec.schema(c)) == schema, codec.least(c) == 24)
    let refused = (outcome(m, unhex("02000000 01000000 61 0100000000000000 01000000 61 0200000000000000")), outcome(o, unhex("02000000")), outcome(r, unhex("02000000 0700000000000000")))
    (fields, held, refused)
}

fn dnonempty_at(b: Bytes) -> u64 {
    let c: codec.Codec[DNonEmpty[u64]] = codec.of()
    match codec.decode(c, b) {
        Ok(Ok(x)) => list.len(x.items),
        Ok(Error(e)) => code(e),
        Error(_) => 9999
    }
}

// A via over a List derives (EXPANSION 7): DNonEmpty[u64] [3] is List[u64]'s bytes, every
// prefix Truncated; its schema is the via frame by hand: one definition, its path, one
// type argument (u64, 06), kind 2 and the wire List[u64] (0e06), then the root (13, 0);
// least 4 (List's). An empty list is Value at 0, and two elements read back as two.
// expect: run structural_via() = (true, true, 4, 7000, 2)
fn structural_via() -> (bool, bool, u64, u64, u64) {
    let c: codec.Codec[DNonEmpty[u64]] = codec.of()
    let mut xs: List[u64] = list.new()
    list.push(mut xs, 3)
    let one = unhex("01000000 0300000000000000")
    let written = enc(c, result.unwrap(dnonempty(take xs))) == one && prefixes(c, one)
    let schema = unhex("03 01000000 19000000 7374642e74657374732e636f6465632e444e6f6e456d707479 01000000 06 02 0e06 13 00000000")
    (written, result.unwrap(codec.schema(c)) == schema, codec.least(c), dnonempty_at(unhex("00000000")), dnonempty_at(unhex("02000000 0300000000000000 0400000000000000")))
}

// `of` two generic bodies deep: the row List[T] or DPair[T] is made where `two_deep`'s T
// is substituted, so its maker is the generic row's hook at that T.
fn two_deep[T: codec](take x: T, take y: T, take z: T, list_hex: String, pair_hex: String) -> bool {
    let l: codec.Codec[List[T]] = generic_of()
    let p: codec.Codec[DPair[T]] = generic_of()
    let mut xs: List[T] = list.new()
    list.push(mut xs, take z)
    enc(l, xs) == unhex(list_hex) && enc(p, DPair(left: take x, right: take y)) == unhex(pair_hex)
}

// expect: run structural_through() = (true, true)
fn structural_through() -> (bool, bool) {
    let a = two_deep(5u64, 6u64, 7u64, "01000000 0700000000000000", "0500000000000000 0600000000000000")
    let b = two_deep(owned("a"), owned("b"), owned("c"), "01000000 01000000 63", "01000000 61 01000000 62")
    (a, b)
}

fn owned(x: String) -> String {
    string.from(x)
}

// Tuples (the front derives a tuple's codec per tuple row). (5, "a") is the u64, then the
// String; every prefix is Truncated within it; the schema is the tuple opcode 18, arity 2,
// then u64 (6) and String (13), with no definitions; least 12. ("a", 5) round-trips and
// its prefixes drop the decoded String; ((1, true), "b") nests, least 13.
// expect: run tuple_codec() = (true, true, true, 12, true, true, 13)
fn tuple_codec() -> (bool, bool, bool, u64, bool, bool, u64) {
    let c: codec.Codec[(u64, String)] = codec.of()
    let b = unhex("0500000000000000 01000000 61")
    let r: codec.Codec[(String, u64)] = codec.of()
    let rb = unhex("01000000 61 0500000000000000")
    let n: codec.Codec[((u64, bool), String)] = codec.of()
    let nb = unhex("0100000000000000 01 01000000 62")
    let schema = result.unwrap(codec.schema(c)) == unhex("03 00000000 12 02000000 06 0d")
    (enc(c, (5u64, "a")) == b && again(c, b), prefixes(c, b), schema, codec.least(c), again(r, rb) && prefixes(r, rb), enc(n, ((1u64, true), "b")) == nb && again(n, nb), codec.least(n))
}

// A tuple field in a derived record is its components in order: least 13.
type DTup: codec {
    p: (u64, String),
    on: bool
}

// expect: run derived_tuple_field() = (true, true, 13)
fn derived_tuple_field() -> (bool, bool, u64) {
    let c: codec.Codec[DTup] = codec.of()
    let b = unhex("0500000000000000 01000000 61 01")
    (enc(c, DTup(p: (5, "a"), on: true)) == b, again(c, b), codec.least(c))
}

// A tuple over a parameter: its codec is built at each instance.
fn tuple_generic[T: codec](take x: T, b: Bytes) -> bool {
    let c: codec.Codec[(T, u64)] = codec.of()
    enc(c, (take x, 7u64)) == b && again(c, b)
}

type DTupG[T]: codec {
    p: (T, u64)
}

// expect: run tuple_generic_laws() = (true, true, true)
fn tuple_generic_laws() -> (bool, bool, bool) {
    let g: codec.Codec[DTupG[String]] = codec.of()
    let gb = unhex("01000000 61 0700000000000000")
    (tuple_generic("a", unhex("01000000 61 0700000000000000")), tuple_generic((1u64, true), unhex("0100000000000000 01 0700000000000000")), enc(g, DTupG(p: ("a", 7))) == gb && again(g, gb))
}

// A via over a tuple: the tuple's bytes; the schema defines DPt as a via (kind 2) written
// as the tuple, and its root is that definition.
type DPt: codec via(u64, String) (to: dpt_wire, from: dpt) {
    w: (u64, String)
}

fn dpt_wire(o: DPt) -> View[(u64, String)] in o {
    view o.w
}

fn dpt(take w: (u64, String)) -> Result[DPt, ()] {
    Ok(DPt(w))
}

// expect: run derived_via_tuple() = (true, true, true)
fn derived_via_tuple() -> (bool, bool, bool) {
    let c: codec.Codec[DPt] = codec.of()
    let b = unhex("0500000000000000 01000000 61")
    let want = unhex("03 01000000 13000000 7374642e74657374732e636f6465632e445074 00000000 02 12 02000000 06 0d 13 00000000")
    (enc(c, DPt(w: (5, "a"))) == b, again(c, b), result.unwrap(codec.schema(c)) == want)
}

// A group of generic members at one parameter: a node holds a forest of nodes.
type DGNode[T]: codec {
    v: T,
    kids: DGForest[T]
}

type DGForest[T]: codec {
    trees: List[DGNode[T]]
}

// "a" over ["b"]: the String, the forest's count, the child, its empty forest; every
// prefix is Truncated; least 8 (String 4 + forest 4), the forest's 4. At u64, 1 over [2];
// its schema by hand: DGNode[u64] is definition 0 (one argument, u64), its kids field
// definition 1 (DGForest[u64]), whose List element is definition 0 again.
// expect: run derived_generic_group() = (true, true, true, (8, 4), true, true)
fn derived_generic_group() -> (bool, bool, bool, (u64, u64), bool, bool) {
    let c: codec.Codec[DGNode[String]] = codec.of()
    let f: codec.Codec[DGForest[String]] = codec.of()
    let b = unhex("01000000 61 01000000 01000000 62 00000000")
    let mut ks: List[DGNode[String]] = list.new()
    list.push(mut ks, DGNode(v: "b", kids: DGForest(trees: list.new())))
    let x = DGNode(v: "a", kids: DGForest(trees: take ks))
    let u: codec.Codec[DGNode[u64]] = codec.of()
    let ub = unhex("0100000000000000 01000000 0200000000000000 00000000")
    let node = "16000000 7374642e74657374732e636f6465632e 44474e6f6465 01000000 06 00 02000000 00 01000000 76 06 00 04000000 6b696473 13 01000000"
    let forest = "18000000 7374642e74657374732e636f6465632e 4447466f72657374 01000000 06 00 01000000 00 05000000 7472656573 0e 13 00000000"
    let mut want = unhex("03 02000000")
    list.append(mut want, unhex(node))
    list.append(mut want, unhex(forest))
    list.append(mut want, unhex("13 00000000"))
    (enc(c, x) == b, again(c, b), prefixes(c, b), (codec.least(c), codec.least(f)), again(u, ub) && prefixes(u, ub), result.unwrap(codec.schema(u)) == want)
}

// A group reached through a Result's Ok and through its Error.
type DRNode: codec {
    v: u64,
    next: List[DRLink]
}

type DRLink: codec = Fwd(Result[DRNode, String]) | Back(Result[u8, DRNode])

// 1 over [Fwd(Ok(2 over [])), Fwd(Error("e")), Back(Ok(7)), Back(Error(3 over []))], by
// hand (tags u32); every prefix is Truncated; least 12 and 8 (a tag and a Result's tag);
// a Result tag 2 after Fwd's is Invalid at 16.
// expect: run derived_result_group() = (true, true, true, (12, 8), 2016)
fn derived_result_group() -> (bool, bool, bool, (u64, u64), u64) {
    let c: codec.Codec[DRNode] = codec.of()
    let l: codec.Codec[DRLink] = codec.of()
    let b = unhex("0100000000000000 04000000 00000000 00000000 0200000000000000 00000000 00000000 01000000 01000000 65 01000000 00000000 07 01000000 01000000 0300000000000000 00000000")
    let mut ls: List[DRLink] = list.new()
    list.push(mut ls, Fwd(Ok(DRNode(v: 2, next: list.new()))))
    list.push(mut ls, Fwd(Error("e")))
    list.push(mut ls, Back(Ok(7)))
    list.push(mut ls, Back(Error(DRNode(v: 3, next: list.new()))))
    let x = DRNode(v: 1, next: take ls)
    let bad = unhex("0100000000000000 01000000 00000000 02000000")
    (enc(c, x) == b, again(c, b), prefixes(c, b), (codec.least(c), codec.least(l)), outcome(c, bad))
}

fn tuple_option[T: codec](take x: T, b: Bytes) -> bool {
    let c: codec.Codec[Option[(T, u64)]] = codec.of()
    let none: Option[(T, u64)] = None
    enc(c, Some((take x, 7u64))) == b && again(c, b) && enc(c, none) == unhex("00000000")
}

// A structural type holding a tuple: List[(u64, String)] [(5, "a")] is the count, then the
// tuple; every prefix is Truncated; its schema is List (14) of the tuple (18, arity 2, u64,
// String); least 4. Option[(T, u64)] through a generic body at String: tag 1, "a", 7.
// expect: run structural_tuple() = (true, true, true, 4, true)
fn structural_tuple() -> (bool, bool, bool, u64, bool) {
    let c: codec.Codec[List[(u64, String)]] = codec.of()
    let b = unhex("01000000 0500000000000000 01000000 61")
    let mut xs: List[(u64, String)] = list.new()
    list.push(mut xs, (5u64, "a"))
    let schema = result.unwrap(codec.schema(c)) == unhex("03 00000000 0e 12 02000000 06 0d")
    (enc(c, xs) == b && again(c, b), prefixes(c, b), schema, codec.least(c), tuple_option("a", unhex("01000000 01000000 61 0700000000000000")))
}

type JsonWireRow: codec {
    range: DRange,
    score: i64 = 7
}

fn json_bytes(s: String) -> Bytes {
    string.into_bytes(string.from(s))
}

// HTTP B-4 and SEM-10. Missing members use declared defaults, and a codec's
// via validator and Map key equality still decide whether the assembly is valid.
// expect: run typed_json_codec_admission() = true
fn typed_json_codec_admission() -> bool {
    let f: json.Format[JsonWireRow] = result.unwrap(json.typed())
    let decoded_row = result.unwrap(json.decode_typed(f, json_bytes("{\"range\":{\"hi\":\"9\",\"lo\":\"2\"}}"), 65536))
    let c: codec.Codec[JsonWireRow] = codec.of()
    let mut wire_value: Bytes = list.new()
    result.unwrap(codec.encode(c, decoded_row, mut wire_value))
    let mut json_output: Bytes = list.new()
    let measured = result.unwrap(json.typed_length(f, wire_value))
    let written = result.unwrap(json.write_typed(f, wire_value, scoped fn(byte: u8) {
        list.push(mut json_output, byte)
    }))
    let canonical = json_bytes("{\"range\":{\"lo\":\"2\",\"hi\":\"9\"},\"score\":\"7\"}")
    let correct = json_output == canonical && list.len(canonical) == measured && measured == written
    let reversed = match json.decode_typed(f, json_bytes("{\"score\":\"6\",\"range\":{\"hi\":\"2\",\"lo\":\"9\"}}"), 65536) {
        Error(Input(21, path, CodecValue(Value(0)))) => path == "/range",
        _ => false,
    }
    let pairs: json.Format[Map[u64, bool]] = result.unwrap(json.typed())
    let duplicate = match json.decode_typed(pairs, json_bytes("[[\"7\",false],[\"\\u0037\",true]]"), 65536) {
        Error(Input(14, path, CodecValue(Duplicate(13)))) => path == "/1/0",
        _ => false,
    }
    let nullable: Result[json.Format[Option[Option[u32]]], json.TypedError] = json.typed()
    let zero: Result[json.Format[List[()]], json.TypedError] = json.typed()
    let refused_option = match take nullable {
        Error(Schema(16, NullableOption)) => true,
        _ => false,
    }
    let refused_list = match take zero {
        Error(Schema(14, EmptyListElement)) => true,
        _ => false,
    }
    let starved = isolate(fn() -> Result[bool, Capacity] {
        Ok(match json.decode_typed(f, json_bytes("{\"range\":{\"hi\":\"9\",\"lo\":\"2\"}}"), 0) {
            _ => false,
        })
    })
    let exhausted = match caught(take starved) {
        Some(_) => true,
        None => false,
    }
    correct && decoded_row.range.w.lo == 2 && decoded_row.range.w.hi == 9 && decoded_row.score == 7 && reversed && duplicate && refused_option && refused_list && exhausted
}

// SEM-10: tuple components concatenate in order. The String has a little-endian
// u32 byte count. A Result's u32 tag 0 precedes the Ok, and tag 1 cannot carry Never.
type NeverPayload[T]: codec = Live | Dead(String, (u8, T))

// expect: run tuple_never_codec() = ((true, true, true), (true, true, true), (2002, 2002, 2000, 2002, 2002))
fn tuple_never_codec() -> ((bool, bool, bool), (bool, bool, bool), (u64, u64, u64, u64, u64)) {
    let left: codec.Codec[(u8, String)] = codec.of()
    let right: codec.Codec[(String, u8)] = codec.of()
    let lb = unhex("07 01000000 61")
    let rb = unhex("01000000 61 07")
    let ls = result.unwrap(codec.schema(left))
    let rs = result.unwrap(codec.schema(right))
    let ordered = enc(left, (7u8, "a")) == lb && again(left, lb) && enc(right, ("a", 7u8)) == rb && again(right, rb)
    let tuple_schemas = codec.fingerprint_of(ls) != codec.fingerprint_of(rs)
    let cross = outcome(left, rb) != 0 && outcome(right, lb) != 0 && wrong_writer(left, rs) && wrong_writer(right, ls)
    let n: codec.Codec[Result[u8, Never]] = codec.of()
    let u: codec.Codec[Result[u8, ()]] = codec.of()
    let v: codec.Codec[Result[u8, u8]] = codec.of()
    let b = unhex("00000000 07")
    let ok = enc(n, Ok(7)) == b && again(n, b) && enc(u, Ok(7)) == b && enc(v, Ok(7)) == b
    let ns = result.unwrap(codec.schema(n))
    let us = result.unwrap(codec.schema(u))
    let vs = result.unwrap(codec.schema(v))
    let schema = codec.fingerprint_of(ns) != codec.fingerprint_of(us) && codec.fingerprint_of(ns) != codec.fingerprint_of(vs)
    let incompatible = wrong_writer(n, us) && wrong_writer(n, vs) && wrong_writer(u, ns) && wrong_writer(v, ns)
    let never: codec.Codec[Never] = codec.of()
    let sum: codec.Codec[NeverPayload[Never]] = codec.of()
    let bad = unhex("ffff 01000000")
    let nbad = decode_outcome(codec.decode_at(n, bad, 2))
    let sbad = decode_outcome(codec.decode_at(sum, bad, 2))
    let r = result.unwrap(result.unwrap(codec.resolve(n, ns)))
    let via_reader = decode_outcome(codec.read_at(r, bad, 2))
    // Add an unused empty record definition to force the schema resolution plan.
    let current = result.unwrap(codec.schema(sum))
    let end = list.len(current) - 5
    let mut writer = unhex("03 02000000")
    list.append(mut writer, list.slice(current, 5, end))
    list.append(mut writer, unhex("01000000 58 00000000 00 00000000"))
    list.append(mut writer, list.slice(current, end, list.len(current)))
    let evolved = result.unwrap(result.unwrap(codec.resolve(sum, writer)))
    let via_plan = decode_outcome(codec.read_at(evolved, bad, 2))
    ((ordered, tuple_schemas, cross), (ok, schema, incompatible), (nbad, sbad, outcome(never, unhex("")), via_reader, via_plan))
}

fn wrong_writer[T](c: codec.Codec[T], writer: Bytes) -> bool {
    match result.unwrap(codec.resolve(c, writer)) {
        Error(Schema(_)) => true,
        _ => false,
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

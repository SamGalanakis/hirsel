fn open_reader(id: StoreId, opened: u64, pager_sender: Option[Sender[pager.TieredPagerMessage]], pin_bytes: u64) -> Result[Reader, Error] waits {
    let input = read.ReaderInput(store: types.StoreKey(hi: id.hi, lo: id.lo), opened: opened, pin_bytes: pin_bytes)
    wrap_reader(failure_result_from_rep(read.open_reader(input, pager_sender))?)
}

fn plain_reader(id: StoreId, opened: u64) -> Result[Reader, Error] {
    wrap_reader(read.plain_reader(types.StoreKey(hi: id.hi, lo: id.lo), opened))
}

fn wrap_reader(take inner: read.ReaderState) -> Result[Reader, Error] {
    match Reader(inner: take inner) {
        Ok(take opened_reader) => Ok(take opened_reader),
        Error((problem, _)) => Error(Full(Allocation(problem))),
    }
}

fn snapshot_pager(r: Reader, s: Snapshot, inventory: pages.TieredReadInventory) -> Result[(pager.TieredPageSource, Arc[pager.TieredReaderGrant], pager.TieredPinRoot), Error] {
    failure_result_from_rep(read.snapshot_pager(r.inner, inventory, s.open, s.branch, pages.tree_stamp(s.roots.collections)))
}

fn read_byte_bound(take limit: Bound[Bytes]) -> std.omap.Bound[Bytes] {
    match take limit {
        Unbounded => Unbounded,
        Included(take key) => Included(take key),
        Excluded(take key) => Excluded(take key),
    }
}

fn lower_bytes(id: u32, limit: Bound[Bytes], high: bool) -> Result[Bytes, Error] {
    let lowered: read.ByteLimit = match limit {
        Unbounded => NoLimit,
        Included(key) => IncludeKey(view key),
        Excluded(key) => ExcludeKey(view key),
    }
    failure_result_from_rep(read.lower_bytes(id, lowered, high))
}

fn byte_cursor(data: pages.PageTree, take low: Bound[Bytes], high: Bytes) -> Result[pages.PageRange, Error] {
    failure_result_from_rep(read.byte_cursor(data, read_byte_bound(take low), high))
}

fn memory_span_step(mut cursor: Option[pages.PageRange], tree: pages.PageTree, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] {
    failure_result_from_rep(read.memory_span_step(mut cursor, tree, low, high, previous))
}

fn resume_data(data: pages.PageTree, low: Bytes, high: Bytes, final_item: Option[Bytes], reverse: bool) -> Result[pages.PageRange, Error] {
    failure_result_from_rep(read.resume_data(data, low, high, final_item, reverse))
}

fn open_index_cursor(tree: pages.PageTree, id: u32, low: Bytes, high: Bytes) -> Result[(Option[pages.CollectionCursor], bool), Error] {
    failure_result_from_rep(read.open_index_cursor(tree, id, low, high))
}

fn prefix_limits[K, Q](id: u32, full: std.codec.Key[K], leading: std.codec.Key[Q], q: Q) -> Result[(Bytes, Bytes), Error] {
    failure_result_from_rep(read.prefix_limits(id, full, leading, q))
}

fn tx_tiered_staged(tree: pages.PageTree, below: List[Arc[pages.Staged]], ops: pages.DataOps, only: Option[u32]) -> Result[std.omap.OMap[Bytes, Option[Arc[Bytes]]], Error] {
    failure_result_from_rep(read.tx_tiered_staged(tree, below, ops, only))
}

fn tx_tiered_stopped(attempt: core.Cell[pager.TieredTouchSet]) -> Result[(), Error] {
    failure_result_from_rep(read.tx_tiered_stopped(attempt))
}

fn next_tiered_in(tree: pages.PageTree, attempt_record: Option[core.Cell[pager.TieredTouchSet]], pins: Map[pager.TieredCacheKey, Arc[format.TieredFrame]], collection: u32, staged: std.omap.OMap[Bytes, Option[Arc[Bytes]]], mut from: Bytes, mut to: Bytes, reverse: bool) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    failure_result_from_rep(read.next_tiered_in(tree, attempt_record, pins, collection, staged, mut from, mut to, reverse))
}

pub fn table_identity[K, V](t: Table[K, V]) -> (StoreId, u32) {
    (t.store, t.id)
}

pub opaque resource type Reader: send {
    inner: read.ReaderState
} drop(owned_reader) {}

pub fn reader(db: Db, pin_bytes: u64) -> Result[Reader, Error] waits {
    open_reader(db.store, open_number(db), pager.pager_requests(db.pager), pin_bytes)
}

pub fn follower_reader(f: Follower, pin_bytes: u64) -> Result[Reader, Error] waits {
    open_reader(store_key_from_rep(f.capture.store), f.open, f.pager, pin_bytes)
}

pub fn read_only_reader(source: ReadOnly, pin_bytes: u64) -> Result[Reader, Error] waits {
    let (id, _, _) = read.read_only_identity(source.inner)
    open_reader(store_key_from_rep(id), 0, None, pin_bytes)
}

pub fn staged_reader(source: Preparation, pin_bytes: u64) -> Result[Reader, Error] waits {
    reader(source.db, pin_bytes)
}

fn read_access(r: Reader, s: Snapshot) -> Result[(), Error] waits {
    failure_result_from_rep(read.read_access(r.inner, types.StoreKey(hi: s.store.hi, lo: s.store.lo), s.open))
}

pub fn copy_env[E: inert](env: E) -> E {
    clone(env)
}

pub opaque type SpanRows: send {
    capture: Snapshot,
    low: Bytes,
    high: Bytes,
    cursor: Option[pages.PageRange],
    last: Option[Bytes],
    done: bool
}

pub fn open_span_changes(r: Reader, s: Snapshot, lo: Bytes, hi: Bytes) -> Result[SpanRows, Error] waits {
    read_access(r, s)?
    disk_allocation(scoped fn() -> Result[SpanRows, Error] {
        let captured: Snapshot = clone(s)
        Ok(SpanRows(capture: take captured, low: failure_result_from_rep(types.copied(lo))?, high: failure_result_from_rep(types.copied(hi))?, cursor: None, last: None, done: hi <= lo))
    })
}

pub fn next_span_change(r: Reader, mut rows: SpanRows) -> Result[Option[Change], Error] waits {
    read_access(r, rows.capture)?
    if rows.done {
        return Ok(None)
    }
    let selected = if let Some(inventory) = view rows.capture.roots.collections.paging {
        snapshot_tiered_span_step(r, rows.capture, inventory, rows.low, rows.high, rows.last)?
    } else {
        memory_span_step(mut rows.cursor, rows.capture.roots.collections, rows.low, rows.high, rows.last)?
    }
    match take selected {
        Some((take key, take value, take resume)) => {
            rows.last = Some(take resume)
            Ok(Some(Change(tree_key: take key, value: Some(take value))))
        },
        None => {
            rows.done = true
            Ok(None)
        },
    }
}

pub fn span_changes(r: Reader, s: Snapshot, lo: Bytes, hi: Bytes) -> Result[List[Change], Error] waits {
    read_access(r, s)?
    let mut out: List[Change] = list.new()
    if hi <= lo {
        return Ok(take out)
    }
    if let Some(inventory) = view s.roots.collections.paging {
        return snapshot_tiered_span(r, s, inventory, lo, hi)
    }
    let mut cursor = byte_cursor(s.roots.collections, Included(failure_result_from_rep(types.copied(lo))?), hi)?
    while let Some((take key, take value)) = failure_result_from_rep(catalog.next_bytes(mut cursor))? {
        list.push(mut out, Change(tree_key: take key, value: Some(take value)))
    }
    Ok(take out)
}

pub opaque type Rows[K, V]: send {
    capture: Snapshot,
    source: u32,
    cursor: Option[pages.CollectionCursor],
    fault: Option[Error],
    low: Bytes,
    high: Bytes,
    last: Option[Bytes],
    reverse: bool,
    done: bool,
    decoder: RowDecoder[K, V]
}

fn table_decoder[K, V](t: Table[K, V]) -> RowDecoder[K, V] {
    read.RowDecoder(table: t.id, key: t.key, readers: arc.share(t.readers), unique: false, skip: None)
}

pub fn get[K, V](r: Reader, s: Snapshot, t: Table[K, V], k: K) -> Result[Option[V], Error] waits {
    read_access(r, s)?
    if !types.same(s.store.hi, s.store.lo, t.store.hi, t.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.readable(s.roots, t.catalog_key, t.catalog_page, t.id))?
    let mut key = failure_result_from_rep(catalog.prefixed(t.id, 8, false))?
    std.codec.encode_key(t.key, k, mut key)
    snapshot_point(r, s, key, scoped fn(stored: Option[View[Bytes]]) -> Result[Option[V], Error] {
        match stored {
            Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
            None => Ok(None),
        }
    })
}

pub fn count_at[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[u64, Error] waits {
    read_access(r, s)?
    if !types.same(s.store.hi, s.store.lo, t.store.hi, t.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.readable(s.roots, t.catalog_key, t.catalog_page, t.id))?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let tree = view s.roots.collections
    if let Some(inventory) = view tree.paging {
        let id = failure_result_from_rep(catalog.prefix(t.id))?
        if let Some((edge, descriptor)) = std.page.collection_slot(tree.root, id) {
            let fields = pages.collection_descriptor(descriptor)
            if fields.residency == ResidentTiered {
                if high <= low {
                    return Ok(0u64)
                }
                if low == id && list.slice(high, 0, 4) != id {
                    return Ok(fields.rows)
                }
                let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
                return read_tiered_count(source, grant, root, tree, edge, descriptor, id, low, high)
            }
        }
    }
    failure_result_from_rep(catalog.count_page_rows(s.roots.collections, t.id, low, high))
}

fn open_scan[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K], reverse: bool) -> Result[Rows[K, V], Error] waits {
    read_access(r, s)?
    if !types.same(s.store.hi, s.store.lo, t.store.hi, t.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.readable(s.roots, t.catalog_key, t.catalog_page, t.id))?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    open_snapshot_rows(s, t.id, take low, take high, reverse, table_decoder(t))
}

pub fn scan[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] waits {
    open_scan(r, s, t, lo, hi, false)
}

pub fn scan_reverse[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] waits {
    open_scan(r, s, t, lo, hi, true)
}

pub fn find[J, K, V, P](r: Reader, s: Snapshot, ix: Index[J, K, V, P], lo: Bound[J], hi: Bound[J]) -> Result[Rows[K, V], Error] waits {
    read_access(r, s)?
    if !types.same(s.store.hi, s.store.lo, ix.store.hi, ix.store.lo) {
        return Error(Foreign)
    }
    failure_result_from_rep(catalog.index_readable(s.roots, ix.catalog_key, ix.catalog_page, ix.id, ix.public))?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    open_snapshot_rows(s, ix.id, take low, take high, false, index_decoder(ix))
}

fn snapshot_scan_step[K, V](r: Reader, rows: Rows[K, V], tree: pages.PageTree, inventory: pages.TieredReadInventory, edge: std.page.Slot, descriptor: Bytes) -> Result[Option[(Bytes, (K, V))], Error] waits {
    failure_result_from_rep(read.snapshot_scan_step(r.inner, tree, inventory, rows.capture.open, rows.capture.branch, edge, descriptor, rows.source, rows.low, rows.high, rows.last, rows.reverse, rows.decoder, read_row_value))
}

fn decode_snapshot_next[K, V](r: Reader, s: Snapshot, decoder: RowDecoder[K, V], key: Bytes, raw: Bytes) -> Result[(K, V), Error] waits {
    failure_result_from_rep(read.decode_snapshot_next(r.inner, s.roots.collections, s.open, s.branch, decoder, key, raw, read_row_value))
}

pub fn next[K, V](r: Reader, mut rows: Rows[K, V]) -> Result[Option[(K, V)], Error] waits {
    read_access(r, rows.capture)?
    if rows.done {
        return Ok(None)
    }
    if let Some(problem) = rows.fault {
        return Error(clone(problem))
    }
    if let Some(mut cursor) = rows.cursor {
        let found = next_memory_snapshot(mut cursor.walk, cursor.leading, rows.decoder, rows.capture.roots.collections)
        match take found {
            Some(Ok(take row)) => return Ok(Some(take row)),
            Some(Error(take problem)) => {
                // An immutable snapshot would decode the same row again.
                rows.fault = Some(clone(problem))
                return Error(take problem)
            },
            None => {
                rows.done = true
                return Ok(None)
            },
        }
    }
    let selected = {
        let data = view rows.capture.roots.collections
        if let Some(inventory) = view data.paging {
            if let Some((edge, descriptor)) = std.page.collection_slot(data.root, failure_result_from_rep(catalog.prefix(rows.source))?) {
                if pages.collection_descriptor(descriptor).residency == ResidentTiered {
                    let Some((take key, take result)) = snapshot_scan_step(r, rows, data, inventory, edge, descriptor)? else {
                        rows.done = true
                        return Ok(None)
                    }
                    rows.last = Some(take key)
                    return Ok(Some(take result))
                }
            }
        }
        let mut cursor = resume_data(data, rows.low, rows.high, rows.last, rows.reverse)?
        let Some((take key, raw)) = failure_result_from_rep(catalog.next_bytes(mut cursor))? else {
            rows.done = true
            return Ok(None)
        }
        let result = decode_snapshot_next(r, rows.capture, rows.decoder, key, raw)?
        (take key, take result)
    }
    let (take key, take result) = take selected
    rows.last = Some(take key)
    Ok(Some(take result))
}

fn scan_raw(s: Snapshot, id: u32, lo: Bound[Bytes], hi: Bound[Bytes]) -> Result[pages.PageRange, Error] {
    byte_cursor(s.roots.collections, Included(lower_bytes(id, lo, false)?), lower_bytes(id, hi, true)?)
}

pub fn range[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[TxRows[K, V], Error] in tx {
    open_range(tx, t, lo, hi, false)
}

pub fn range_reverse[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[TxRows[K, V], Error] in tx {
    open_range(tx, t, lo, hi, true)
}

fn check_table_read[K, V](tx: Tx, t: Table[K, V]) -> Result[(), Error] {
    failure_result_from_rep(txn.check_table_read(tx.inner, types.StoreKey(hi: t.store.hi, lo: t.store.lo), t.catalog_key, t.catalog_page, t.id))
}

fn open_range[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K], reverse: bool) -> Result[TxRows[K, V], Error] in tx {
    check_table_read(tx, t)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    open_range_bounds(tx, t, take low, take high, reverse)
}

pub fn range_prefix[K, V, Q](tx: Tx, t: Table[K, V], q: Q, take key: std.codec.Key[Q]) -> Result[TxRows[K, V], Error] in tx {
    check_table_read(tx, t)?
    let (take low, take high) = prefix_limits(t.id, t.key, key, q)?
    open_range_bounds(tx, t, take low, take high, false)
}

pub fn count[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[u64, Error] {
    check_table_read(tx, t)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let n = if failure_result_from_rep(txn.tx_tiered_descriptor(tx.inner, t.id))? {
        failure_result_from_rep(txn.tx_tiered_count(tx.inner, t.id, low, high))?
    } else {
        let data = failure_result_from_rep(txn.transaction_collection_pages(tx.inner))?
        failure_result_from_rep(catalog.count_page_rows(data, t.id, low, high))?
    }
    failure_result_from_rep(txn.note_read(tx.inner, Span(take low, take high)))?
    Ok(n)
}

fn open_range_bounds[K, V](tx: Tx, t: Table[K, V], take low: Bytes, take high: Bytes, reverse: bool) -> Result[TxRows[K, V], Error] in tx {
    let (take cursor, take tiered) = failure_result_from_rep(txn.open_range_bounds(tx.inner, t.id, low, high, reverse))?
    Ok(TxRows(cursor: take cursor, decoder: table_decoder(t), owner: tx.info.id, depth: txn.tx_own(tx.inner), reads: txn.tx_reads(tx.inner), low: take low, high: take high, reverse: reverse, log_tail: None, tiered: take tiered))
}

pub opaque scoped type TxRows[K, V] {
    cursor: Option[pages.CollectionCursor],
    decoder: RowDecoder[K, V],
    owner: CallId,
    depth: u64,
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    reverse: bool,
    log_tail: Option[txn.LogRangeTail],
    tiered: Option[txn.TxTieredRows]
}

// Before decoding an attempted row, record it and the gap traversed to find it.
// Exhaustion records the remainder once. An unused cursor observes no keys.
pub fn next_in[K, V](tx: Tx, mut r: TxRows[K, V]) -> Result[Option[(K, V)], Error] {
    if !types.same(tx.info.id.store.hi, tx.info.id.store.lo, r.owner.store.hi, r.owner.store.lo) || tx.info.id.branch != r.owner.branch || tx.info.id.version != r.owner.version || txn.tx_own(tx.inner) != r.depth {
        return Error(Foreign)
    }
    if let Some(mut cursor) = r.cursor {
        let found = next_tx_page(mut cursor.walk, cursor.leading, r.decoder, r.reads, r.low, r.high, r.reverse)
        if let Some(take row) = take found {
            let (take boundary, take decoded_row) = take row
            if r.reverse {
                r.high = take boundary
            } else {
                r.low = take boundary
            }
            return Ok(Some(decoded_row?))
        }
    }
    let mut found = match r.tiered {
        Some(mut tiered) => next_tiered_in(txn.tx_roots(tx.inner).collections, txn.tx_attempt(tx.inner), txn.tx_pins(tx.inner), tiered.collection, tiered.staged, mut tiered.from, mut tiered.to, r.reverse)?,
        None => None,
    }
    if let None = found {
        if let Some(mut tail) = r.log_tail {
            found = failure_result_from_rep(txn.next_log_range_tail(tx.inner, mut tail))?
        }
    }
    match take found {
        Some((key, raw)) => {
            note_tx_row(r.reads, mut r.low, mut r.high, r.reverse, key)?
            Ok(Some(decode_table_row(r.decoder, list.slice(key, 4, list.len(key)), raw)?))
        },
        None => {
            if r.low < r.high {
                let low = replace(mut r.low, list.new())
                let high = replace(mut r.high, list.new())
                log.append(r.reads, Span(take low, take high))
            }
            Ok(None)
        },
    }
}

fn next_tx_page[K, V](mut walk: std.page.Cursor, leading: Bytes, decoder: RowDecoder[K, V], reads: View[core.Log[Read]], low: Bytes, high: Bytes, reverse: bool) -> Option[(Bytes, Result[(K, V), Error])] {
    std.page.cursor_read(mut walk, scoped fn(suffix: Bytes, raw: Bytes) -> (Bytes, Result[(K, V), Error]) {
        let mut key = pages.collection_row_key(leading, suffix)
        if reverse {
            log.append(reads, Span(clone(key), clone(high)))
        } else {
            list.push(mut key, 0u8)
            log.append(reads, Span(clone(low), clone(key)))
        }
        (take key, decode_table_row(decoder, suffix, raw))
    })
}

fn note_tx_row(reads: View[core.Log[Read]], mut low: Bytes, mut high: Bytes, reverse: bool, key: Bytes) -> Result[(), Error] {
    if reverse {
        let new_high = failure_result_from_rep(types.copied(key))?
        let end = replace(mut high, take new_high)
        log.append(reads, Span(failure_result_from_rep(types.copied(key))?, take end))
    } else {
        let mut end = failure_result_from_rep(pager.scan_page_after(key))?
        let start = replace(mut low, failure_result_from_rep(types.copied(end))?)
        log.append(reads, Span(take start, take end))
    }
    Ok(())
}

pub scoped type IndexRows[K, V] {
    rows: PageRows[K, V],
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    tiered: Option[TxIndexTiered],
    tiered_index: Option[u32]
}

/// The key codec of the index's table. Rows rank in the order of the bytes
/// it writes, which is the order a package breaks ties in.
pub fn primary_key[J, K, V, P](ix: Index[J, K, V, P]) -> std.codec.Key[K] {
    ix.primary
}

fn check_index_read[J, K, V, P](tx: Tx, ix: Index[J, K, V, P]) -> Result[(), Error] {
    failure_result_from_rep(txn.check_index_read(tx.inner, types.StoreKey(hi: ix.store.hi, lo: ix.store.lo), ix.catalog_key, ix.catalog_page, ix.id, ix.public))
}

pub fn lookup[J, K, V, P](tx: Tx, ix: Index[J, K, V, P], lo: Bound[J], hi: Bound[J]) -> Result[IndexRows[K, V], Error] in tx {
    check_index_read(tx, ix)?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    open_lookup(tx, ix, take low, take high)
}

pub fn lookup_prefix[J, K, V, P, Q](tx: Tx, ix: Index[J, K, V, P], q: Q, take key: std.codec.Key[Q]) -> Result[IndexRows[K, V], Error] in tx {
    check_index_read(tx, ix)?
    let (take low, take high) = prefix_limits(ix.id, ix.key, key, q)?
    open_lookup(tx, ix, take low, take high)
}

fn open_lookup[J, K, V, P](tx: Tx, ix: Index[J, K, V, P], take low: Bytes, take high: Bytes) -> Result[IndexRows[K, V], Error] in tx {
    let txn.IndexRange(tree: take tree, cursor: take cursor, tiered: take tiered, cold: cold) = txn.open_lookup(tx.inner, ix.id, low, high) ?=> failure_from_rep
    let rows = PageRows(cursor: take cursor, data: take tree, decoder: index_decoder(ix))
    let context = match take tiered {
        Some(take state) => Some(TxIndexTiered(inner: take state)),
        None => None,
    }
    Ok(IndexRows(rows: take rows, reads: txn.tx_reads(tx.inner), low: take low, high: take high, tiered: take context, tiered_index: if cold {
        Some(ix.id)
    } else {
        None
    }))
}

pub opaque scoped type IndexEntries[J, K, P] {
    cursor: read.EntryCursor,
    read: read.TieredReadInput,
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    id: u32,
    kind: IndexKind,
    key: std.codec.Key[J],
    primary: std.codec.Key[K],
    payload: Option[Arc[Readers[P]]],
    payload_codec: std.codec.Codec[P],
    lendable: bool
}

/// A signed-byte code a `next_i8_entry` step passes on: lent from the page when the row
/// holds the current schema's built-in `List[i8]` encoding, decoded otherwise.
pub scoped type I8Code = Lent(View[Bytes]) | Owned(List[i8])

pub fn entries[J, K, V, P](tx: Tx, ix: Index[J, K, V, P], lo: Bound[J], hi: Bound[J]) -> Result[IndexEntries[J, K, P], Error] in tx {
    check_index_read(tx, ix)?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    let tree = failure_result_from_rep(txn.transaction_collection_pages(tx.inner))?
    let input = read.TieredReadInput(attempt: txn.tx_attempt(tx.inner), pins: txn.tx_pins(tx.inner), below: txn.tx_below(tx.inner), ops: txn.tx_ops(tx.inner))
    Ok(IndexEntries(cursor: read.entry_cursor(take tree), read: take input, reads: txn.tx_reads(tx.inner), low: take low, high: take high, id: ix.id, kind: ix.kind, key: ix.key, primary: ix.primary, payload: clone(ix.payload), payload_codec: ix.payload_codec, lendable: ix.lendable))
}

pub fn next_entry[J, K, P](mut r: IndexEntries[J, K, P]) -> Result[Option[(J, K, P)], Error] {
    let (id, kind, index_key, primary, payload_codec) = (r.id, r.kind, r.key, r.primary, r.payload_codec)
    step_entry(mut r.cursor, r.read, r.reads, mut r.low, r.high, id, r.payload, scoped fn(key: Bytes, raw: Bytes, row_readers: Option[Arc[Readers[P]]]) -> Result[(J, K, P), Error] {
        let (take j, take k, start) = failure_result_from_rep(read.entry_parts(kind == Unique, index_key, primary, key, raw))?
        let payload = list.slice(raw, start, list.len(raw))
        let value = match row_readers {
            Some(registered) => row_value(registered, id, payload)?,
            None => failure_result_from_rep(catalog.decoded(std.codec.decode(payload_codec, payload)))?,
        }
        Ok((take j, take k, take value))
    })
}

/// The next entry of an index whose payload is `List[i8]`, passed to `visit` with its
/// primary key. Records, refuses and orders exactly as `next_entry`; a current-schema row
/// of the built-in `List[i8]` codec is lent from the page instead of copied.
pub fn next_i8_entry[K, T](mut r: IndexEntries[(), K, List[i8]], visit: scoped[view] fn(take K, I8Code) -> T) -> Result[Option[T], Error] {
    let (id, kind, index_key, primary, payload_codec, lendable) = (r.id, r.kind, r.key, r.primary, r.payload_codec, r.lendable)
    step_entry(mut r.cursor, r.read, r.reads, mut r.low, r.high, id, r.payload, scoped fn(key: Bytes, raw: Bytes, row_readers: Option[Arc[Readers[List[i8]]]]) -> Result[T, Error] {
        let (_, take k, start) = failure_result_from_rep(read.entry_parts(kind == Unique, index_key, primary, key, raw))?
        let payload = list.slice(raw, start, list.len(raw))
        match row_readers {
            Some(registered) => {
                if lendable && read.lends_codes(registered.current, payload) {
                    return Ok(visit(take k, Lent(list.slice(payload, 6, list.len(payload)))))
                }
                Ok(visit(take k, Owned(row_value(registered, id, payload)?)))
            },
            None => Ok(visit(take k, Owned(failure_result_from_rep(catalog.decoded(std.codec.decode(payload_codec, payload)))?))),
        }
    })
}

pub fn next_indexed[K, V](mut r: IndexRows[K, V]) -> Result[Option[(K, V)], Error] {
    if let Some(mut cursor) = r.rows.cursor {
        let stepped = next_index_page(mut cursor.walk, cursor.leading, r.rows.decoder, r.rows.data, r.tiered, r.reads, r.low, r.high)
        if let Some(take step) = take stepped {
            let (take boundary, take value) = step?
            r.low = take boundary
            return take value
        }
    }
    if let Some(index_id) = r.tiered_index {
        let stepped = {
            let Some(context) = view r.tiered else {
                fail("store: a Tiered index read without an attempt")
            }
            if let Some((key, raw)) = failure_result_from_rep(txn.next_index_tiered_row(r.rows.data, context.inner, index_id, r.low, r.high))? {
                let mut boundary = failure_result_from_rep(types.copied(r.low))?
                note_index_step(r.reads, mut boundary, r.high, Some(view key))?
                let seen: scoped[view] fn(Bytes) -> Result[(), types.Failure] = scoped fn(observed: Bytes) -> Result[(), types.Failure] {
                    log.append(r.reads, Point(types.copied(observed)?))
                    Ok(())
                }
                let row = failure_result_from_rep(txn.tx_tiered_index_row(txn.index_tiered_view(context.inner), r.rows.decoder, r.rows.data, key, raw, read_row_value, seen))
                Some((take boundary, take row))
            } else {
                None
            }
        }
        if let Some((take boundary, take row)) = take stepped {
            r.low = take boundary
            return Ok(match row? {
                Some((take value, _)) => Some(take value),
                None => None,
            })
        }
        r.tiered_index = None
    }
    note_index_step(r.reads, mut r.low, r.high, None)?
    Ok(None)
}

fn next_index_page[K, V](mut walk: std.page.Cursor, leading: Bytes, decoder: RowDecoder[K, V], data: pages.PageTree, tiered: Option[TxIndexTiered], reads: View[core.Log[Read]], low: Bytes, high: Bytes) -> Option[Result[(Bytes, Result[Option[(K, V)], Error]), Error]] {
    let context = match tiered {
        Some(held) => Some(txn.index_tiered_view(held.inner)),
        None => None,
    }
    let record_span: scoped[view] fn(take Bytes, take Bytes) = scoped fn(take start: Bytes, take end: Bytes) {
        log.append(reads, Span(take start, take end))
    }
    let record_point: scoped[view] fn(take Bytes) = scoped fn(take key: Bytes) {
        log.append(reads, Point(take key))
    }
    let stepped = txn.next_index_page(mut walk, leading, decoder, data, context, low, high, read_row_value, record_span, record_point)
    match take stepped {
        Some(Ok((take boundary, take value))) => Some(Ok((take boundary, failure_result_from_rep(take value)))),
        Some(Error(take problem)) => Some(Error(failure_from_rep(take problem))),
        None => None,
    }
}

/// The main-branch snapshot recovered by a read-only open.
pub opaque type ReadOnly: shareable + send {
    inner: read.ReadOnlyState
}

pub fn read_only_table[K, V](read_source: ReadOnly, take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let (id, _, _) = read.read_only_identity(read_source.inner)
    let roots = read.read_only_roots(read_source.inner)
    let handle = catalog_handle(store_key_from_rep(id), roots.catalog, take name, take key, take value)?
    Ok(clone(handle))
}

pub fn read_only_get[K, V](read_source: ReadOnly, t: Table[K, V], key: K) -> Result[Option[V], Error] waits {
    get(read_only_reader(read_source, 0)?, read_only_snapshot(read_source), t, key)
}

pub fn read_only_snapshot(read_source: ReadOnly) -> Snapshot {
    let (id, head, watermark) = read.read_only_identity(read_source.inner)
    Snapshot(store: store_key_from_rep(id), open: 0, branch: 0, head: head, roots: pages.share_roots(read.read_only_roots(read_source.inner)), watermark: watermark, bases: pages.share_tail_bases(read.read_only_bases(read_source.inner)))
}

fn step_entry[P, T](mut cursor: read.EntryCursor, input: read.TieredReadInput, reads: View[core.Log[Read]], mut low: Bytes, high: Bytes, id: u32, payload: Option[Arc[Readers[P]]], visit: scoped[view] fn(Bytes, Bytes, Option[Arc[Readers[P]]]) -> Result[T, Error]) -> Result[Option[T], Error] {
    let row = failure_result_from_rep(read.step_entry(mut cursor, input, scoped fn(take start: Bytes, take end: Bytes) {
        log.append(reads, Span(take start, take end))
    }, mut low, high, id, scoped fn(key: Bytes, raw: Bytes) -> Result[T, Error] {
        visit(key, raw, payload)
    }))?
    match take row {
        Some(take result) => Ok(Some((take result)?)),
        None => Ok(None),
    }
}

fn note_index_step(reads: View[core.Log[Read]], mut low: Bytes, high: Bytes, last_key: Option[View[Bytes]]) -> Result[(), Error] {
    failure_result_from_rep(read.note_index_step(scoped fn(take start: Bytes, take end: Bytes) {
        log.append(reads, Span(take start, take end))
    }, mut low, high, last_key))
}

fn lends_i8_rows[P](payload: Option[Arc[Readers[P]]]) -> bool {
    let codec: Option[std.codec.Codec[P]] = match payload {
        Some(registered) => Some(registered.codec),
        None => None,
    }
    read.lends_i8_rows(codec)
}

type RowDecoder[K, V] = read.RowDecoder[K, Readers[V]]

fn read_row_value[V](r: Readers[V], id: u32, raw: Bytes) -> Result[V, types.Failure] {
    read.decode_value(r.codec, r.current, r.older, id, raw)
}

fn row_value[V](r: Readers[V], id: u32, raw: Bytes) -> Result[V, Error] {
    failure_result_from_rep(read_row_value(r, id, raw))
}

fn decode_row_key[K, V](r: RowDecoder[K, V], row_key: Bytes, raw: Bytes) -> Result[(K, Option[Bytes]), Error] {
    failure_result_from_rep(read.decode_row_key(r, row_key, raw))
}

fn advance_rows[K, V](r: RowDecoder[K, V], data: pages.PageTree, row_key: Bytes, raw: Bytes, remaining: Option[u64], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[((K, V), u64)], Error] {
    failure_result_from_rep(read.advance_rows(r, data, row_key, raw, remaining, read_row_value, scoped fn(observed: Bytes) -> Result[(), types.Failure] {
        failure_result_to_rep(seen(observed))
    }))
}

fn finish_row[K, V](r: RowDecoder[K, V], take key: K, row_key: Bytes, raw: Bytes, remaining: Option[u64], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[((K, V), u64)], Error] {
    failure_result_from_rep(read.finish_row(r, take key, row_key, raw, remaining, read_row_value, scoped fn(observed: Bytes) -> Result[(), types.Failure] {
        failure_result_to_rep(seen(observed))
    }))
}

fn next_memory_snapshot[K, V](mut walk: std.page.Cursor, leading: Bytes, decoder: RowDecoder[K, V], data: pages.PageTree) -> Option[Result[(K, V), Error]] {
    let selected = read.next_memory_snapshot(mut walk, leading, decoder, data, read_row_value)
    match take selected {
        Some(take row) => Some(failure_result_from_rep(take row)),
        None => None,
    }
}

fn decode_table_row[K, V](decoder: RowDecoder[K, V], suffix: Bytes, raw: Bytes) -> Result[(K, V), Error] {
    failure_result_from_rep(read.decode_table_row(decoder, suffix, raw, read_row_value))
}

fn snapshot_point[R](r: Reader, s: Snapshot, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    failure_result_from_rep(read.snapshot_point(r.inner, s.roots.collections, s.open, s.branch, logical, scoped fn(row: Option[View[Bytes]]) -> Result[R, types.Failure] {
        failure_result_to_rep(decode_row(row))
    }))
}

fn open_snapshot_rows[K, V](s: Snapshot, source: u32, take low: Bytes, take high: Bytes, reverse: bool, take decoder: RowDecoder[K, V]) -> Result[Rows[K, V], Error] {
    let captured: Snapshot = clone(s)
    let (take cursor, done) = failure_result_from_rep(read.open_snapshot_rows(s.roots.collections, source, decoder.table, low, high, reverse))?
    Ok(Rows(capture: take captured, source: source, cursor: take cursor, fault: None, low: take low, high: take high, last: None, reverse: reverse, done: done, decoder: take decoder))
}

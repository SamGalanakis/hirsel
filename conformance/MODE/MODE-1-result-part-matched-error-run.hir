// rule: MODE-1
// expect: run
// A result whose Ok part selects `h` keeps its Error part global, so `match`
// and `if let` on the bound result read the error out as `?` would.
type Failed = Failed(Bytes)

fn get(h: Bytes, k: u64) -> Result[Option[Bytes] in h, Failed] {
  if k == 0 {
    return Error(Failed(b"zero"))
  }
  Ok(Some(copy h))
}

fn matched(h: Bytes) -> Result[u64, Failed] {
  let r = get(h, 0)
  match r {
    Ok(_) => Ok(1),
    Error(e) => Error(copy e),
  }
}

fn kept(h: Bytes) -> Failed {
  let r = get(h, 0)
  let mut out = Failed(b"none")
  if let Error(e) = r {
    out = copy e
  }
  take out
}

pub fn main() -> Result[(), ()] {
  failure.check(matched(b"h") == Error(Failed(b"zero")), Arithmetic())
  failure.check(kept(b"h") == Failed(b"zero"), Arithmetic())
  Ok(())
}

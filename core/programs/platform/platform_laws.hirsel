// Laws of the platform host (RUNNER-SPEC §14.7: L39, L41, L42, L43, L45, L48, L49, L51, L52; L54 in platform_preview_laws.hirsel) over the faked
// launcher. Each law drives the host through the session's requests and events. Its oracle
// is the outcome the cited rule states: which serving launches the launcher is asked for,
// at which generation, and what each wake row then holds. A started serving launch stands
// for the place that runs the due trigger; the place itself is the runner's (L44's harness).
const T0: u64 = 1700000000000u64

const SECOND_NS: u64 = 1000000000u64

fn expect(ok: bool, take what: String) {
    if !ok {
        fail(take what)
    }
}

fn must[T](take r: Result[T, Refused], take what: String) -> T {
    match take r {
        Ok(take v) => take v,
        Error(_) => fail(take what)
    }
}

type Rig {
    h: Host,
    f: launcher.Fake,
    now: Now,
    starts: List[launcher.Child],
    // Every Start the host sent, as sent.
    sent: List[launcher.Launch],
    // Every request the host sent, in order.
    asked: List[launcher.Request],
    d: Option[Driver],
    // The attempt the host gave the latest Begin, its request ID and its connection.
    a: launcher.Attempt,
    req: Bytes,
    conn: u64,
    // Operator connections opened, and every answer the host sent on them.
    conns: u64,
    got: List[Sent]
}

fn uncontained() -> launcher.Bindings {
    launcher.Bindings(store: string.new(), dirs: list.new(), net: list.new())
}

fn unlimited() -> launcher.Limits {
    launcher.Limits(memory: None, cpu: None, pids: None)
}

fn image() -> Bytes {
    let mut b: Bytes = list.with_capacity(32u64)
    for _ in 0u64 .. 32u64 {
        list.push(mut b, 7u8)
    }
    b
}

fn image_two() -> Bytes {
    let mut b: Bytes = list.with_capacity(32u64)
    for _ in 0u64 .. 32u64 {
        list.push(mut b, 9u8)
    }
    b
}

// Hands each request to the fake launcher in order and applies each event it answers in
// stream order; the host's answering requests join the end of the queue.
fn pump(mut r: Rig, take reqs: List[launcher.Request]) waits {
    let mut queue = take reqs
    let mut i = 0u64
    while i < list.len(queue) {
        let req: launcher.Request = clone(queue[i])
        i += 1u64
        list.push(mut r.asked, clone(req))
        if let Start(l) = req {
            list.push(mut r.starts, launcher.Child(group: clone(l.group), role: launcher.role_of(l.mode)))
            list.push(mut r.sent, clone(l))
        }
        let events = launcher.handle(mut r.f, take req)
        for e in events {
            let more = apply(mut r, Got(clone(e)))
            for m in more {
                list.push(mut queue, clone(m))
            }
        }
    }
}

// One input: through the rig's driver when it has one, as the host's main loop does.
fn apply(mut r: Rig, take input: Input) -> List[launcher.Request] waits {
    let held = replace(mut r.d, None)
    match take held {
        Some(take driven) => {
            let mut d = take driven
            let mut out = step(mut r.h, mut d, take input, r.now)
            r.d = Some(take d)
            hang_ups(mut r, mut out)
            take out
        },
        None => {
            let mut out = match take input {
                Got(take e) => event(mut r.h, take e, r.now),
                _ => tick(mut r.h, r.now),
            }
            hang_ups(mut r, mut out)
            take out
        },
    }
}

// Collects the host's operator answers; each connection an answer closed is closed, as the
// transport does, and the host's detach requests join `out`.
fn hang_ups(mut r: Rig, mut out: List[launcher.Request]) {
    for s in outgoing(mut r.h) {
        list.push(mut r.got, clone(s))
        if s.close {
            for q in detach(mut r.h, s.conn) {
                list.push(mut out, clone(q))
            }
        }
    }
}

// A 16-byte request ID numbered n.
fn request_id(n: u64) -> Bytes {
    let mut b: Bytes = list.with_capacity(16u64)
    for i in 0u64 .. 16u64 {
        let x: u64 = if i < 8u64 {
            (n >> (8u64 * i)) & 255u64
        } else {
            0u64
        }
        list.push(mut b, int.narrow(x))
    }
    b
}

// Sends one operator frame on connection `conn` and runs what the host decided.
fn send(mut r: Rig, conn: u64, a: operator.Ask) waits {
    let mut reqs = asked(mut r.h, conn, operator.ask_bytes(a), r.now)
    hang_ups(mut r, mut reqs)
    pump(mut r, take reqs)
}

// The operator closes connection `conn` early.
fn hang_up(mut r: Rig, conn: u64) waits {
    let reqs = detach(mut r.h, conn)
    pump(mut r, take reqs)
}

// The answers connection `conn` received, in order.
fn got_on(r: Rig, conn: u64) -> List[operator.Answer] {
    let mut out: List[operator.Answer] = list.new()
    for s in r.got {
        if s.conn == conn {
            list.push(mut out, clone(s.answer))
        }
    }
    out
}

fn attempt_of(p: operator.Phase) -> Option[launcher.Attempt] {
    match p {
        AwaitInput(a) => Some(a),
        AdmittingPhase(a) => Some(a),
        AwaitConfirm(a) => Some(a),
        AssemblingPhase(a) => Some(a),
        PreparingPhase(a) => Some(a),
        PendingPhase(a, _) => Some(a),
        UndecidedPhase(a, _, _) => Some(a),
        _ => None,
    }
}

// The last phase connection `conn` was sent.
fn phase_on(r: Rig, conn: u64) -> Option[operator.Phase] {
    let mut out: Option[operator.Phase] = None
    for x in got_on(r, conn) {
        if let StateAnswer(_, _, _, p) = x {
            out = Some(clone(p))
        }
    }
    out
}

// The error connection `conn` was sent, if any.
fn error_on(r: Rig, conn: u64) -> Option[operator.Class] {
    let mut out: Option[operator.Class] = None
    for x in got_on(r, conn) {
        if let ErrorAnswer(c, _) = x {
            out = Some(c)
        }
    }
    out
}

// Begins request `d` deploying `input` to group g on a new connection; the rig's attempt
// becomes the one the host assigned. Gives the connection.
fn begin_with(mut r: Rig, d: Bytes, input: launcher.Input) -> u64 waits {
    r.conns += 1u64
    let conn = r.conns
    let incarnation = match group_row(r.h, "g") {
        Ok(Some(g)) => g.incarnation,
        _ => 0u64,
    }
    send(mut r, conn, BeginAsk(clone(d), group_of("g", incarnation), clone(input), list.new(), list.new()))
    if let Some(p) = phase_on(r, conn) {
        if let Some(a) = attempt_of(p) {
            r.a = a
        }
    }
    r.req = clone(d)
    r.conn = conn
    conn
}

// A new request deploying NEW, attested.
fn begin_new(mut r: Rig) -> u64 waits {
    let d = request_id(r.conns + 1u64)
    begin_with(mut r, d, Attested(image_two()))
}

// Status(d) on a new connection.
fn status_of(mut r: Rig, d: Bytes) -> Option[operator.Phase] waits {
    r.conns += 1u64
    let conn = r.conns
    send(mut r, conn, StatusAsk(clone(d)))
    phase_on(r, conn)
}

fn class_bytes(c: operator.Class) -> Bytes {
    let codec: std.codec.Codec[operator.Class] = std.codec.of()
    let mut out: Bytes = list.new()
    let _ = std.codec.encode(codec, c, mut out)
    out
}

fn is_failed(p: Option[operator.Phase], class: operator.Class) -> bool {
    match p {
        Some(FailedPhase(c, _, _)) => class_bytes(c) == class_bytes(class),
        _ => false
    }
}

fn errored(r: Rig, conn: u64, class: operator.Class) -> bool {
    match error_on(r, conn) {
        Some(c) => class_bytes(c) == class_bytes(class),
        None => false
    }
}

fn is_installed(p: Option[operator.Phase]) -> bool {
    match p {
        Some(InstalledPhase(_, _, _)) => true,
        _ => false
    }
}

// How many Admit requests the rig's launcher was sent.
fn admits(r: Rig) -> u64 {
    let mut n = 0u64
    for q in r.asked {
        if let Admit(_, _, _, _) = q {
            n += 1u64
        }
    }
    n
}

// What the rig's driver has armed.
fn waits_on(r: Rig) -> Timers {
    match r.d {
        Some(d) => armed(d),
        None => fail("the rig has no driver")
    }
}

fn unplug(mut r: Rig) waits {
    let held = replace(mut r.d, None)
    if let Some(take d) = take held {
        stop(take d)
    }
}

fn feed(mut r: Rig, take events: List[launcher.Event]) waits {
    let mut reqs: List[launcher.Request] = list.new()
    for e in events {
        let more = apply(mut r, Got(clone(e)))
        for m in more {
            list.push(mut reqs, clone(m))
        }
    }
    pump(mut r, take reqs)
}

fn rig_on(take db: store.Db, f: launcher.Fake, max_places: u64, now: Now) -> Rig waits {
    let (h, hello) = must(open(take db, Config(max_places: max_places, idle_ms: 1000u64)), "open")
    let mut r = Rig(h: take h, f: clone(f), now: now, starts: list.new(), sent: list.new(), asked: list.new(), d: None, a: launcher.Attempt(hi: 0u64, lo: 0u64), req: list.new(), conn: 0u64, conns: 0u64, got: list.new())
    pump(mut r, take hello)
    r
}

fn rig(c: Clock, rnd: Random, max_places: u64) -> Rig waits {
    rig_on(store.memory(c, rnd, result.unwrap(store.sized(Memory, 1074790400u64))), launcher.fake(), max_places, Now(wall_ms: T0, mono_ns: SECOND_NS))
}

// Ends the host process: only its store and the launcher survive.
fn restart(take r: Rig, max_places: u64) -> Rig waits {
    let Rig(h: take h, f: take f, now: now, starts: _, sent: _, asked: _, d: _, a: a, req: take req, conn: _, conns: conns, got: _) = take r
    let mut n = rig_on(close(take h), f, max_places, now)
    n.a = a
    n.req = take req
    n.conns = conns
    n
}

fn add(mut r: Rig, name: String, tenant: String) waits {
    let spec = NewGroup(name: string.from(name), tenant: string.from(tenant), workdir: string.from(name), author: Trusted, label: Uncontained, listen: "127.0.0.1:0", bindings: uncontained(), limits: unlimited(), assembly: image(), activation: 1u64, args: list.new(), record: None)
    let reqs = must(add_group(mut r.h, spec), "add_group")
    pump(mut r, take reqs)
}

fn op_wake(mut r: Rig, name: String) waits {
    let reqs = must(wake(mut r.h, name, r.now), "operator wake")
    pump(mut r, take reqs)
}

fn at_wall(mut r: Rig, wall_ms: u64) waits {
    r.now = Now(wall_ms: wall_ms, mono_ns: r.now.mono_ns)
    let reqs = apply(mut r, DueAt(wall_ms))
    pump(mut r, take reqs)
}

fn at_mono(mut r: Rig, mono_ns: u64) waits {
    r.now = Now(wall_ms: r.now.wall_ms, mono_ns: mono_ns)
    let reqs = apply(mut r, RetryAt(mono_ns))
    pump(mut r, take reqs)
}

// The serving gens started for a group, in launch order.
fn gens(r: Rig, name: String) -> List[u64] {
    let mut out: List[u64] = list.new()
    for c in r.starts {
        if c.group.name == name {
            if let Serving(g) = c.role {
                list.push(mut out, g)
            }
        }
    }
    out
}

fn last(r: Rig, name: String) -> launcher.Child {
    let mut found: Option[launcher.Child] = None
    for c in r.starts {
        if c.group.name == name {
            if let Serving(_) = c.role {
                found = Some(clone(c))
            }
        }
    }
    match take found {
        Some(take c) => take c,
        None => fail("no launch for the group")
    }
}

fn finish(mut r: Rig, c: launcher.Child, exit: launcher.Status, report: Option[Option[u64]]) waits {
    let events = launcher.end(mut r.f, c, exit, report)
    feed(mut r, take events)
}

// The group's current child stops cleanly with its next due time.
fn idle_stop(mut r: Rig, name: String, due: Option[u64]) waits {
    let c = last(r, name)
    finish(mut r, c, Code(0i32), Some(due))
}

fn is_dirty(r: Rig, name: String, g: u64) -> bool {
    match wake_row(r.h, name) {
        Some(w) => match w.wake {
            Dirty(a) => a == g,
            _ => false
        },
        None => false
    }
}

fn is_clean(r: Rig, name: String) -> bool {
    match wake_row(r.h, name) {
        Some(w) => match w.wake {
            Clean(_) => true,
            _ => false
        },
        None => false
    }
}

fn one(a: u64) -> List[u64] {
    let mut out: List[u64] = list.new()
    list.push(mut out, a)
    out
}

fn two(a: u64, b: u64) -> List[u64] {
    let mut out = one(a)
    list.push(mut out, b)
    out
}

fn gone_row(h: Host, name: String) -> bool {
    match wake_row(h, name) {
        Some(_) => false,
        None => true
    }
}

fn launches(r: Rig, name: String) -> u64 {
    list.len(gens(r, name))
}

// A group whose place is cold with a trigger due at `due`.
fn cold_due(mut r: Rig, name: String, tenant: String, due: u64) waits {
    add(mut r, name, tenant)
    op_wake(mut r, name)
    idle_stop(mut r, name, Some(due))
}

// L39 `wake_due_after_unload` (§14.3, §14.4): the due-time wait is one absolute wall-time
// alarm on the due index's minimum, which the host's driver re-arms after every input, so
// nothing polls. A place that stops with `Stopped(Some(t + 2000))` is started after t + 2 s
// with no arrival; a second place's earlier deadline is not held behind a wait armed at
// t + 60 s, nor lost while the index is empty.
@test
fn wake_due_after_unload(c: Clock, rnd: Random, tasks: Tasks) -> Result[(), ()] waits {
    let (vc, hand) = provide.clock(SECOND_NS, T0)
    let mut ticks = take hand
    let (to, from): (Sender[Input], Receiver[Input]) = channel.new(4u64)
    let mut r = rig(c, rnd, 4u64)
    r.d = Some(driver(tasks, vc, channel.sender(to)))
    // The first place: its trigger is due at t + 2 s.
    cold_due(mut r, "a", "t", T0 + 2000u64)
    expect(waits_on(r).wall_ms == Some(T0 + 2000u64), "L39: the wait is not armed on the due time")
    let _ = clock.idle(mut ticks)
    clock.set_wall(mut ticks, T0 + 1999u64)
    let _ = clock.idle(mut ticks)
    if let Ok(_) = channel.try_receive(from) {
        fail("L39: the wait woke before the due time")
    }
    clock.set_wall(mut ticks, T0 + 2000u64)
    let _ = clock.idle(mut ticks)
    let Ok(DueAt(fired)) = channel.try_receive(from) else {
        fail("L39: no wake at the due time")
    }
    at_wall(mut r, fired)
    expect(gens(r, "a") == two(1u64, 2u64), "L39: the due place was not started")
    expect(is_dirty(r, "a", 2u64), "L39: the due place is not Dirty")
    // An armed wait at t + 60 s does not hold back a deadline at t + 2 s.
    clock.set_wall(mut ticks, T0 + 3000u64)
    r.now = Now(wall_ms: T0 + 3000u64, mono_ns: r.now.mono_ns)
    idle_stop(mut r, "a", Some(T0 + 60000u64))
    expect(waits_on(r).wall_ms == Some(T0 + 60000u64), "L39: the wait is not on the later deadline")
    cold_due(mut r, "b", "t", T0 + 5000u64)
    expect(waits_on(r).wall_ms == Some(T0 + 5000u64), "L39: the earlier deadline waits for the old one")
    clock.set_wall(mut ticks, T0 + 5000u64)
    let _ = clock.idle(mut ticks)
    let Ok(DueAt(second)) = channel.try_receive(from) else {
        fail("L39: no wake at the second due time")
    }
    expect(second == T0 + 5000u64, "L39: the second place woke at the wrong time")
    at_wall(mut r, second)
    expect(gens(r, "b") == two(1u64, 2u64) && launches(r, "a") == 2u64, "L39: the wrong place was started")
    unplug(mut r)
    // With the index empty, no wait is armed; a place that then stops with a due time arms it.
    let mut r2 = rig(c, rnd, 4u64)
    r2.d = Some(driver(tasks, vc, channel.sender(to)))
    add(mut r2, "c", "t")
    op_wake(mut r2, "c")
    expect(waits_on(r2).wall_ms == None, "L39: a wait is armed with no due row")
    r2.now = Now(wall_ms: T0 + 6000u64, mono_ns: r2.now.mono_ns)
    idle_stop(mut r2, "c", Some(T0 + 8000u64))
    expect(waits_on(r2).wall_ms == Some(T0 + 8000u64), "L39: the wait was armed only at start")
    clock.set_wall(mut ticks, T0 + 8000u64)
    let _ = clock.idle(mut ticks)
    let Ok(DueAt(third)) = channel.try_receive(from) else {
        fail("L39: no wake after an empty index")
    }
    at_wall(mut r2, third)
    expect(gens(r2, "c") == two(1u64, 2u64), "L39: the place due after an empty index was not started")
    unplug(mut r2)
    Ok(())
}

fn capacity_case(c: Clock, rnd: Random) -> Rig waits {
    let mut r = rig(c, rnd, 2u64)
    cold_due(mut r, "c", "t", T0 + 1000u64)
    add(mut r, "a", "t")
    add(mut r, "b", "t")
    op_wake(mut r, "a")
    op_wake(mut r, "b")
    at_wall(mut r, T0 + 1000u64)
    expect(launches(r, "c") == 1u64, "L41: a third place started past max_places")
    expect(is_clean(r, "c"), "L41: the refused place's row left Clean")
    r
}

// L41 `wake_dirty_capacity` (§14.2, §14.3): the check comes before Dirty; a due wake that
// finds no slot is queued and retried on every change that can make room; a restart rebuilds
// it from the due index; one tenant's full quota holds back no other tenant; and an operator
// request with no slot is answered Full.
@test
fn wake_dirty_capacity(c: Clock, rnd: Random) -> Result[(), ()] waits {
    // A row leaving Dirty makes room.
    let mut r = capacity_case(c, rnd)
    idle_stop(mut r, "a", None)
    expect(gens(r, "c") == two(1u64, 2u64) && is_dirty(r, "c", 2u64), "L41: the queued place did not start when a slot freed")
    // Raising max_places makes room.
    let mut raised = capacity_case(c, rnd)
    let more = must(set_max_places(mut raised.h, 3u64, raised.now), "raise max_places")
    pump(mut raised, take more)
    expect(gens(raised, "c") == two(1u64, 2u64), "L41: raising max_places did not start the queued place")
    // Raising a full tenant's quota makes room.
    let mut quota = rig(c, rnd, 10u64)
    let set = must(set_quota(mut quota.h, "t", Quota(groups: 10u64, live: 2u64), quota.now), "quota")
    pump(mut quota, take set)
    cold_due(mut quota, "c", "t", T0 + 1000u64)
    add(mut quota, "a", "t")
    add(mut quota, "b", "t")
    op_wake(mut quota, "a")
    op_wake(mut quota, "b")
    at_wall(mut quota, T0 + 1000u64)
    expect(launches(quota, "c") == 1u64, "L41: a place started past its tenant's live quota")
    let lifted = must(set_quota(mut quota.h, "t", Quota(groups: 10u64, live: 3u64), quota.now), "raise quota")
    pump(mut quota, take lifted)
    expect(gens(quota, "c") == two(1u64, 2u64), "L41: raising the quota did not start the queued place")
    // A host restart rebuilds the queued wake from the due index.
    let queued = capacity_case(c, rnd)
    let mut back = restart(take queued, 2u64)
    expect(launches(back, "a") == 0u64 && launches(back, "b") == 0u64 && launches(back, "c") == 0u64, "L41: the restart probed a live or queued place")
    idle_stop_child(mut back, "a", 1u64)
    expect(gens(back, "c") == one(2u64), "L41: the restart lost the queued wake")
    // A queued place of a full tenant does not hold back another tenant's due place.
    let mut mixed = rig(c, rnd, 10u64)
    let cap = must(set_quota(mut mixed.h, "full", Quota(groups: 10u64, live: 1u64), mixed.now), "quota")
    pump(mut mixed, take cap)
    cold_due(mut mixed, "c", "full", T0 + 1000u64)
    cold_due(mut mixed, "d", "other", T0 + 1000u64)
    add(mut mixed, "a", "full")
    op_wake(mut mixed, "a")
    at_wall(mut mixed, T0 + 1000u64)
    expect(launches(mixed, "c") == 1u64, "L41: the full tenant's place started")
    expect(gens(mixed, "d") == two(1u64, 2u64), "L41: the full tenant's queued place held back another tenant")
    // An operator request that finds no slot is answered Full.
    let mut full = capacity_case(c, rnd)
    match wake(mut full.h, "c", full.now) {
        Error(Full(Count(2u64))) => (),
        _ => fail("L41: an operator request with no slot was not answered Full"),
    }
    Ok(())
}

// After a restart the rig records no launch of the adopted child; this ends it by gen.
fn idle_stop_child(mut r: Rig, name: String, gen: u64) waits {
    let row = must(group_row(r.h, name), "group row")
    let Some(grp) = row else {
        fail("no group")
    }
    finish(mut r, child_of(name, grp.incarnation, gen), Code(0i32), Some(None))
}

fn crash(mut r: Rig, name: String) waits {
    let c = last(r, name)
    finish(mut r, c, Signal(9i32), None)
}

// L42 `wake_only_clean_stop` (§14.4, §14.5): only a clean Stopped writes Clean. A kill, a
// Forced end and an exit 0 without a report leave the row Dirty and start a probe, also
// across a host restart; a place that crashes after every start is restarted at once, then
// after 1 s, 2 s and 4 s, arrivals start nothing extra meanwhile, and a clean report resets
// the delay.
@test
fn wake_only_clean_stop(c: Clock, rnd: Random, tasks: Tasks) -> Result[(), ()] waits {
    let mut r = rig(c, rnd, 4u64)
    add(mut r, "killed", "t")
    add(mut r, "forced", "t")
    add(mut r, "silent", "t")
    op_wake(mut r, "killed")
    op_wake(mut r, "forced")
    op_wake(mut r, "silent")
    let ch_killed = last(r, "killed")
    finish(mut r, ch_killed, Signal(9i32), None)
    let ch_forced = last(r, "forced")
    finish(mut r, ch_forced, Code(70i32), None)
    let ch_silent = last(r, "silent")
    finish(mut r, ch_silent, Code(0i32), None)
    expect(is_dirty(r, "killed", 2u64) && gens(r, "killed") == two(1u64, 2u64), "L42: a killed child's row was not probed Dirty")
    expect(is_dirty(r, "forced", 2u64) && gens(r, "forced") == two(1u64, 2u64), "L42: a Forced child's row was not probed Dirty")
    expect(is_dirty(r, "silent", 2u64) && gens(r, "silent") == two(1u64, 2u64), "L42: an exit 0 with no report wrote Clean")
    // Each one left Dirty with no child across a host restart is probed, and its due trigger runs.
    let ch_killed_again = last(r, "killed")
    let _ = launcher.end(mut r.f, ch_killed_again, Signal(9i32), None)
    let mut back = restart(take r, 4u64)
    expect(back.h.probes == 1u64 && gens(back, "killed") == one(3u64), "L42: a row left Dirty across a restart was not probed")
    idle_stop(mut back, "killed", Some(T0 + 500u64))
    at_wall(mut back, T0 + 500u64)
    expect(gens(back, "killed") == two(3u64, 4u64), "L42: the probed place's due trigger did not run")
    // Backoff: at once, then 1 s, 2 s, 4 s.
    let (vc, _hand) = provide.clock(SECOND_NS, T0)
    let (to, _from): (Sender[Input], Receiver[Input]) = channel.new(4u64)
    let mut b = rig(c, rnd, 4u64)
    b.d = Some(driver(tasks, vc, take to))
    add(mut b, "crashy", "t")
    op_wake(mut b, "crashy")
    crash(mut b, "crashy")
    expect(launches(b, "crashy") == 2u64, "L42: the first crash was not restarted at once")
    let start = b.now.mono_ns
    let mut base = start
    let mut d = SECOND_NS
    for _ in 0u64 .. 3u64 {
        crash(mut b, "crashy")
        let n = launches(b, "crashy")
        expect(waits_on(b).mono_ns == Some(base + d), "L42: the backoff wait is not armed on 1 s, 2 s, 4 s")
        let target = last(b, "crashy").group
        let events = launcher.connect(mut b.f, target)
        feed(mut b, take events)
        at_mono(mut b, base + d - 1u64)
        expect(launches(b, "crashy") == n, "L42: an arrival or an early tick started a failing place")
        at_mono(mut b, base + d)
        expect(launches(b, "crashy") == n + 1u64, "L42: the backoff retry did not start")
        base = base + d
        d = d * 2u64
    }
    // A clean report resets the delay.
    let served = last(b, "crashy").group
    launcher.accept(mut b.f, served)
    idle_stop(mut b, "crashy", None)
    expect(is_clean(b, "crashy"), "L42: the clean report did not write Clean")
    op_wake(mut b, "crashy")
    let n = launches(b, "crashy")
    crash(mut b, "crashy")
    expect(launches(b, "crashy") == n + 1u64, "L42: a clean report did not reset the backoff")
    unplug(mut b)
    Ok(())
}

// A group added for its genesis at activation 0, as `store.local` adds every group.
fn add_genesis(mut r: Rig, name: String) waits {
    let spec = NewGroup(name: string.from(name), tenant: "t", workdir: string.from(name), author: Trusted, label: Uncontained, listen: "127.0.0.1:0", bindings: uncontained(), limits: unlimited(), assembly: image(), activation: 0u64, args: list.new(), record: None)
    let reqs = must(add_group(mut r.h, spec), "add_group")
    pump(mut r, take reqs)
}

fn activation_of(r: Rig, name: String) -> u64 {
    match group_row(r.h, name) {
        Ok(Some(g)) => g.activation,
        _ => fail("no group row")
    }
}

// The group's last serving start answers under STORE's LOCK, as `head_prepare` does: the
// store is at `store_at` and the start selected another activation, or (same version) the
// store was activated by another image.
fn answer_current(mut r: Rig, name: String, store_at: u64) waits {
    let ch = last(r, name)
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Placed(take ch, PlaceCurrent(store_at, list.new())))
    feed(mut r, take events)
}

// The group's last serving start opened the store at `version` and reached Ready.
fn answer_opened(mut r: Rig, name: String, version: u64) waits {
    let ch = last(r, name)
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Placed(take ch, PlaceOpened(runner.PlaceReady(version: version, store_hi: 1u64, store_lo: 2u64, release: release_at(version), retain_from: 0u64, ready_ns: 0u64, read: list.new()))))
    feed(mut r, take events)
}

fn with_pair(take l: List[Pair], gen: u64, activation: u64) -> List[Pair] {
    let mut out = take l
    list.push(mut out, Pair(gen: gen, activation: activation, assembly: image()))
    out
}

fn last_activation(r: Rig) -> Option[u64] {
    let mut found: Option[u64] = None
    for l in r.sent {
        if let ServingMode(_, serve) = l.mode {
            found = Some(serve.activation)
        }
    }
    found
}

fn failing_cause(r: Rig, name: String) -> Option[String] {
    for f in status(r.h).failing {
        if f.name == name {
            return Some(string.from(f.last))
        }
    }
    None
}

// The rest of the window after the probe at 0 was answered PlaceCurrent(1): its end
// relaunches at once at the recorded activation, outside backoff, and that start's open
// records the store, serves, and its clean report writes Clean.
fn serves_after_adoption(mut r: Rig, name: String, what: String) waits {
    let probe = last(r, name)
    let n = launches(r, name)
    finish(mut r, probe, Code(1i32), None)
    let mut why = string.from(what)
    string.push(mut why, ": the probe's end did not relaunch at once at the store's activation")
    expect(activation_of(r, name) == 1u64 && launches(r, name) == n + 1u64 && last_activation(r) == Some(1u64), take why)
    expect(list.len(status(r.h).failing) == 0u64, "activation window: an adopted activation was counted as a failing start")
    answer_opened(mut r, name, 1u64)
    let stored = match group_row(r.h, name) {
        Ok(Some(g)) => g.store_id == Some((1u64, 2u64)),
        _ => false
    }
    expect(stored, "activation window: the open at the adopted activation did not record the store")
    idle_stop(mut r, name, None)
    expect(is_clean(r, name), "activation window: the recovered place's clean report did not write Clean")
}

// `activation_window_recovers` (§14.5 "Genesis"): a group's genesis start installs the
// store's first activation (version 0 + 1 = 1, `head_prepare`) before the host records it on
// the start's PlaceOpened, so a crash in between leaves the store at 1 and the group at 0,
// and every later start at 0 is refused NotCurrent(Active(1)). After each crash point the
// group serves again with no operator or deploy input: the start at 0 answered
// PlaceCurrent(1) records 1 once, its end relaunches at 1 at once, and that open records the
// store. A store at 1 that refuses the start at 1 too (another image activated it) keeps the
// group failing on backoff with the refusal as its cause, never readopted.
@test
fn activation_window_recovers(c: Clock, rnd: Random) -> Result[(), ()] waits {
    // The host lives through the crash.
    let mut r = rig(c, rnd, 4u64)
    add_genesis(mut r, "g")
    op_wake(mut r, "g")
    crash(mut r, "g")
    expect(starts_are(r, with_pair(with_pair(list.new(), 1u64, 0u64), 2u64, 0u64)), "activation window: the crash was not probed at 0")
    answer_current(mut r, "g", 1u64)
    expect(activation_of(r, "g") == 1u64, "activation window: PlaceCurrent(1) at 0 did not record activation 1")
    serves_after_adoption(mut r, "g", "host lives")
    expect(starts_are(r, with_pair(with_pair(with_pair(list.new(), 1u64, 0u64), 2u64, 0u64), 3u64, 1u64)), "activation window: the starts were not (1, 0), (2, 0), (3, 1)")
    // The host restarts before it sees the crash.
    let mut b = rig(c, rnd, 4u64)
    add_genesis(mut b, "g")
    op_wake(mut b, "g")
    let first = last(b, "g")
    let _ = launcher.end(mut b.f, first, Signal(9i32), None)
    let mut back = restart(take b, 4u64)
    expect(starts_are(back, with_pair(list.new(), 2u64, 0u64)), "activation window, host restart: the restart did not probe at 0")
    answer_current(mut back, "g", 1u64)
    serves_after_adoption(mut back, "g", "host restart")
    expect(starts_are(back, with_pair(with_pair(list.new(), 2u64, 0u64), 3u64, 1u64)), "activation window, host restart: the starts were not (2, 0), (3, 1)")
    // The host restarts after the adoption committed and before it saw the probe's end.
    let mut a = rig(c, rnd, 4u64)
    add_genesis(mut a, "g")
    op_wake(mut a, "g")
    crash(mut a, "g")
    answer_current(mut a, "g", 1u64)
    let probe = last(a, "g")
    let _ = launcher.end(mut a.f, probe, Code(1i32), None)
    let mut later = restart(take a, 4u64)
    expect(starts_are(later, with_pair(list.new(), 3u64, 1u64)), "activation window, restart after adoption: the next start was not (3, 1)")
    answer_opened(mut later, "g", 1u64)
    idle_stop(mut later, "g", None)
    expect(is_clean(later, "g"), "activation window, restart after adoption: the clean report did not write Clean")
    // Another image's store: the start at 1 is refused too, and nothing readopts.
    let mut o = rig(c, rnd, 4u64)
    add_genesis(mut o, "g")
    op_wake(mut o, "g")
    crash(mut o, "g")
    answer_current(mut o, "g", 1u64)
    let adopted = last(o, "g")
    finish(mut o, adopted, Code(1i32), None)
    answer_current(mut o, "g", 1u64)
    let second = last(o, "g")
    finish(mut o, second, Code(1i32), None)
    expect(activation_of(o, "g") == 1u64, "activation window, other image: the activation changed again")
    // The crash at gen 1 counted once, so this second unsuccessful start waits 1 s.
    expect(gens(o, "g") == with_gen(two(1u64, 2u64), 3u64), "activation window, other image: the refused start was not held on backoff")
    let cause = match failing_cause(o, "g") {
        Some(why) => why,
        None => fail("activation window, other image: the group is not failing")
    }
    expect(string.starts_with(cause, "NotCurrent"), "activation window, other image: the failing cause is not the store's refusal")
    Ok(())
}

fn with_gen(take l: List[u64], g: u64) -> List[u64] {
    let mut out = take l
    list.push(mut out, g)
    out
}

// OLD answers the cutover the launcher forwarded to it.
fn answer(mut r: Rig, ch: launcher.Child, take said: runner.HostReply) waits {
    let events = launcher.cutover_reply(mut r.f, ch, take said)
    feed(mut r, take events)
}

// Ends the host process and the launcher: only the catalog survives.
fn restart_bare(take r: Rig, max_places: u64) -> Rig waits {
    let Rig(h: take h, f: _, now: now, starts: _, sent: _, asked: _, d: _, a: a, req: take req, conn: _, conns: conns, got: _) = take r
    let mut n = rig_on(close(take h), launcher.fake(), max_places, now)
    n.a = a
    n.req = take req
    n.conns = conns
    n
}

// NEW's release, as its preview reports it and as a store at NEW's activation 2 reports it.
fn release_two() -> Bytes {
    bytes_of(32u64, 5u8)
}

// The release a store reports at `version`: NEW's at 2, OLD's (unrecorded) otherwise.
fn release_at(version: u64) -> Bytes {
    if version == 2u64 {
        release_two()
    } else {
        bytes_of(32u64, 3u8)
    }
}

fn describe_of(digest: Bytes) -> runner.Describe {
    runner.Describe(digest: clone(digest), target: "t", n_place: 1u64, revision: clone(digest), exported: list.new())
}

// OLD's describe child's answer.
fn describe_answer() -> Bytes {
    let c: std.codec.Codec[runner.Describe] = std.codec.of()
    let mut out: Bytes = list.new()
    let _ = std.codec.encode(c, describe_of(image()), mut out)
    out
}

// A preview child's answer naming image `digest` with `release`, for OLD's empty list.
fn preview_answer(digest: Bytes, release: Bytes) -> Bytes {
    let c: std.codec.Codec[runner.Preview] = std.codec.of()
    let mut out: Bytes = list.new()
    let _ = std.codec.encode(c, runner.Preview(describe: describe_of(digest), release: clone(release), answers: list.new()), mut out)
    out
}

fn helper_child(old: launcher.Child, take m: launcher.Mode) -> launcher.Child {
    launcher.Child(group: clone(old.group), role: launcher.role_of(m))
}

// A helper child answers on its standard output and exits 0.
fn helper_answers(mut r: Rig, c: launcher.Child, take said: Bytes) waits {
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Answered(clone(c), take said))
    feed(mut r, take events)
    finish(mut r, c, Code(0i32), None)
}

fn old_says(mut r: Rig, old: launcher.Child, take said: runner.HostReply) waits {
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Placed(clone(old), take said))
    feed(mut r, take events)
}

// The verifier's summary of NEW (target "t", one place) beside OLD's recipe.
fn summary_of(root_limit: u64, old_root_limit: u64, take grants: launcher.Grants) -> launcher.Summary {
    launcher.Summary(root_limit: root_limit, old_root_limit: old_root_limit, grants: take grants, target: "t", n_place: 1u64)
}

// The host opens group g's admission of NEW, attested, and the verifier admits it with
// `summary` and the approval text `display`.
fn admit_new(mut r: Rig, take summary: launcher.Summary, display: String) waits {
    let _ = begin_new(mut r)
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Admitted(r.a, image_two(), take summary, string.from(display)))
    feed(mut r, take events)
}

// The launcher assembled NEW (assembly and image both image_two) and holds its reservation.
fn assembled_new(mut r: Rig) waits {
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Assembled(r.a, image_two(), image_two(), 5u64, 6u64))
    feed(mut r, take events)
}

// A deploy of NEW (image_two, target "t", one place) admitted and assembled, through OLD's
// describe and the preview's answer `preview`, which the host checks before it asks OLD to
// export.
fn to_export(mut r: Rig, old: launcher.Child, take preview: Bytes) waits {
    admit_new(mut r, summary_of(1u64, 1u64, launcher.no_grants()), "")
    assembled_new(mut r)
    let a = r.a
    helper_answers(mut r, helper_child(old, DescribeMode(a)), describe_answer())
    helper_answers(mut r, helper_child(old, PreviewMode(a, list.new())), take preview)
}

// The deploy prepared: OLD exports head 1, NEW's prepare child exits 0, and OLD keeps the
// import. Gives what OLD's import answer asks for (the candidate's Start and the cutover),
// not yet sent.
fn prepared(mut r: Rig, old: launcher.Child) -> List[launcher.Request] waits {
    to_export(mut r, old, preview_answer(image_two(), release_two()))
    old_says(mut r, old, PlaceExported(1u64, "export-1"))
    let a = r.a
    helper_answers(mut r, helper_child(old, PrepareMode(a, "export-1")), trigger_answer())
    apply(mut r, Got(Placed(clone(old), PlaceImported(image_two()))))
}

// What the launcher was asked: OLD 1 an export, 2 a cutover, 3 an abort; 4 an Assemble,
// 5 a Release; 0 anything else.
fn command_kind(q: launcher.Request) -> u64 {
    match q {
        Command(_, HostExport(_, _)) => 1u64,
        Command(_, HostCutover(_, _, _, _)) => 2u64,
        Command(_, HostAbort(_, _)) => 3u64,
        Assemble(_) => 4u64,
        Release(_) => 5u64,
        _ => 0u64,
    }
}

// How many of the rig's requests were of `kind`.
fn asked_of(r: Rig, kind: u64) -> u64 {
    let mut n = 0u64
    for q in r.asked {
        if command_kind(q) == kind {
            n += 1u64
        }
    }
    n
}

fn failed_with(r: Rig, why: String) -> bool {
    match deploy_outcome(r.h, "g") {
        Some(Failed(w)) => w == why,
        _ => false
    }
}

fn still_preparing(r: Rig) -> bool {
    match deploy_outcome(r.h, "g") {
        Some(Preparing) => true,
        _ => false
    }
}

// Runs one collection through the host and gives the roots it named in `Collect`.
fn collected_roots(mut r: Rig) -> List[Bytes] waits {
    let go = must(collect(mut r.h), "collect")
    pump(mut r, take go)
    let mut roots: Option[List[Bytes]] = None
    for q in r.asked {
        if let Collect(named) = q {
            roots = Some(clone(named))
        }
    }
    match roots {
        Some(named) => clone(named),
        None => fail("the collection named no roots")
    }
}

fn names_root(roots: List[Bytes], assembly: Bytes) -> bool {
    for x in roots {
        if x == assembly {
            return true
        }
    }
    false
}

// A collection now keeps NEW's assembly when `new` and OLD's when `old`, and no other.
fn collection_keeps(mut r: Rig, new: bool, old: bool) -> bool waits {
    let roots = collected_roots(mut r)
    names_root(roots, image_two()) == new && names_root(roots, image()) == old
}

// The deploy committed once: OLD got one cutover, the row is Dirty(2) with NEW's assembly
// as the group's root and OLD's kept, the outcome is Installed and nothing is held.
fn committed_once(r: Rig) -> bool {
    let installed = match deploy_outcome(r.h, "g") {
        Some(Installed) => true,
        _ => false
    }
    let rooted = match group_row(r.h, "g") {
        Ok(Some(g)) => g.assembly == image_two() && list.len(g.retained) == 1u64 && g.retained[0u64] == image(),
        _ => false
    }
    launcher.forwards(r.f) == 1u64 && installed && rooted && launcher.held(r.f) == 0u64
}

// L43 `wake_generation_fence` (§14.3, §14.5): a report carries its child's identity, so a
// stale or discarded child's end never clears the row, and a launch lost with its session
// never runs after recovery started its successor.
@test
fn wake_generation_fence(c: Clock, rnd: Random) -> Result[(), ()] waits {
    // Committed cutover: OLD's late clean report changes nothing; NEW's idle stop writes Clean.
    let mut r = rig(c, rnd, 4u64)
    add(mut r, "g", "t")
    op_wake(mut r, "g")
    let old = last(r, "g")
    let go = prepared(mut r, old)
    pump(mut r, take go)
    let candidate = last(r, "g")
    expect(gens(r, "g") == two(1u64, 2u64) && is_dirty(r, "g", 1u64), "L43: the candidate did not start at gen + 1 under Dirty(g)")
    answer(mut r, old, PlaceInstalled(2u64, true))
    expect(is_dirty(r, "g", 2u64), "L43: the commit did not write Dirty(c)")
    finish(mut r, old, Code(0i32), Some(None))
    expect(is_dirty(r, "g", 2u64) && launches(r, "g") == 2u64, "L43: OLD's late clean report cleared the row")
    finish(mut r, candidate, Code(0i32), Some(None))
    expect(is_clean(r, "g"), "L43: NEW's idle stop did not write Clean")
    // Refused cutover: NEW's end changes nothing; OLD's later clean report writes Clean.
    let mut d = rig(c, rnd, 4u64)
    add(mut d, "g", "t")
    op_wake(mut d, "g")
    let serving = last(d, "g")
    let tried = prepared(mut d, serving)
    pump(mut d, take tried)
    let discarded = last(d, "g")
    answer(mut d, serving, PlaceRefused("ExportMismatch"))
    expect(is_dirty(d, "g", 1u64), "L43: a refused cutover moved the row")
    match deploy_outcome(d.h, "g") {
        Some(Failed(why)) => expect(why == "ExportMismatch", "L43: the refused deploy's reason"),
        _ => fail("L43: the refused deploy's outcome is not recorded")
    }
    finish(mut d, discarded, Code(0i32), Some(None))
    expect(is_dirty(d, "g", 1u64) && launches(d, "g") == 2u64, "L43: the discarded candidate's end changed the row or started a probe")
    finish(mut d, serving, Code(0i32), Some(None))
    expect(is_clean(d, "g"), "L43: OLD's clean report after the refusal did not write Clean")
    // Lost acknowledgement, the launcher read the launch: after Hello the host adopts it.
    let mut read = rig(c, rnd, 4u64)
    add(mut read, "g", "t")
    let sent = must(wake(mut read.h, "g", read.now), "wake")
    for q in sent {
        if let Start(l) = q {
            list.push(mut read.starts, launcher.Child(group: clone(l.group), role: launcher.role_of(l.mode)))
        }
        let _ = launcher.handle(mut read.f, clone(q))
    }
    let hello = reconnect(read.h)
    pump(mut read, take hello)
    expect(gens(read, "g") == one(1u64) && is_dirty(read, "g", 1u64), "L43: an adopted launch was probed again")
    // Lost acknowledgement, the launcher never read it: the host probes at gen + 1, and the
    // lost launch's report cannot clear the row.
    let mut lost = rig(c, rnd, 4u64)
    add(mut lost, "g", "t")
    let dropped = must(wake(mut lost.h, "g", lost.now), "wake")
    let _ = take dropped
    let again = reconnect(lost.h)
    pump(mut lost, take again)
    expect(gens(lost, "g") == one(2u64) && is_dirty(lost, "g", 2u64), "L43: the lost launch was not probed at gen + 1")
    let Some(grp) = must(group_row(lost.h, "g"), "group row") else {
        fail("no group")
    }
    let mut stale: List[launcher.Event] = list.new()
    list.push(mut stale, Ended(child_of("g", grp.incarnation, 1u64), launcher.End(status: Code(0i32), report: Some(None), readable: false)))
    feed(mut lost, take stale)
    expect(is_dirty(lost, "g", 2u64) && gens(lost, "g") == one(2u64), "L43: the lost launch's report cleared the row")
    // Re-added group: the old incarnation's late report is ignored.
    let mut re = rig(c, rnd, 4u64)
    add(mut re, "g", "t")
    op_wake(mut re, "g")
    let first = last(re, "g")
    let gone = must(remove(mut re.h, "g", Keep), "remove")
    pump(mut re, take gone)
    finish(mut re, first, Code(0i32), Some(None))
    expect(gone_row(re.h, "g"), "L43: the retired group's rows remain")
    add(mut re, "g", "t")
    op_wake(mut re, "g")
    let second = last(re, "g")
    expect(second.group.incarnation != first.group.incarnation, "L43: a re-added group reused its incarnation")
    let mut late: List[launcher.Event] = list.new()
    list.push(mut late, Ended(clone(first), launcher.End(status: Code(0i32), report: Some(None), readable: false)))
    feed(mut re, take late)
    expect(is_dirty(re, "g", 1u64), "L43: the old incarnation's late report cleared the re-added group")
    Ok(())
}

// The deploy row's current attempt.
fn deploy_attempt(r: Rig) -> launcher.Attempt {
    match store.get(store.snapshot(r.h.db), store.shape(r.h.t.deploys), "g") {
        Ok(Some(d)) => d.attempt,
        _ => fail("no deploy row")
    }
}

// The last export command OLD was sent: its attempt and whether it is a retry.
fn last_export(r: Rig) -> Option[(Bytes, bool)] {
    let mut found: Option[(Bytes, bool)] = None
    for q in r.asked {
        if let Command(_, HostExport(a, retry)) = q {
            found = Some((clone(a), retry))
        }
    }
    found
}

// The last cutover command OLD was sent: its attempt and whether it is a retry.
fn last_cutover(r: Rig) -> Option[(Bytes, bool)] {
    let mut found: Option[(Bytes, bool)] = None
    for q in r.asked {
        if let Command(_, HostCutover(a, _, _, retry)) = q {
            found = Some((clone(a), retry))
        }
    }
    found
}

// L52 `deploy_drift_retry` (launch.md "Hot deploy", RUNNER-SPEC §14.3 "Abort"): OLD's first
// drift spends the deploy's one retry. OLD is not aborted; it exports again at a fresh
// attempt as a retry under its original pause, the import starts a candidate at a new
// generation once the discarded candidate has ended (the launcher refuses a second
// candidate beside it), and that cutover is a retry. The discarded end moves no row.
// A second drift aborts the retried attempt and records `Failed("drift")` with the row at
// `Dirty(g)`.
@test
fn deploy_drift_retry(c: Clock, rnd: Random) -> Result[(), ()] waits {
    let (r0, old, go) = cut_case(c, rnd)
    let mut r = take r0
    pump(mut r, take go)
    let first = deploy_attempt(r)
    let discarded = last(r, "g")
    answer(mut r, old, PlaceDrift)
    let retry = deploy_attempt(r)
    expect(still_preparing(r) && asked_of(r, 3u64) == 0u64, "L52: the first drift aborted OLD or failed the deploy")
    expect(retry.lo != first.lo || retry.hi != first.hi, "L52: the retry reused the drifted attempt")
    match last_export(r) {
        Some((a, true)) => expect(a == attempt_bytes(retry), "L52: the retry export does not name the fresh attempt"),
        _ => fail("L52: OLD was not asked to export again as a retry")
    }
    old_says(mut r, old, PlaceExported(1u64, "export-2"))
    helper_answers(mut r, helper_child(old, PrepareMode(retry, "export-2")), trigger_answer())
    old_says(mut r, old, PlaceImported(image_two()))
    expect(still_preparing(r) && gens(r, "g") == two(1u64, 2u64), "L52: the retry's candidate started while the discarded one was live")
    finish(mut r, discarded, Code(0i32), Some(None))
    expect(is_dirty(r, "g", 1u64), "L52: the discarded candidate's end moved the row")
    let mut three = two(1u64, 2u64)
    list.push(mut three, 3u64)
    expect(gens(r, "g") == three, "L52: the retry's candidate did not start at a new generation")
    match last_cutover(r) {
        Some((a, true)) => expect(a == attempt_bytes(retry), "L52: the retry cutover does not name the fresh attempt"),
        _ => fail("L52: the retry's cutover is not a retry under the original pause")
    }
    answer(mut r, old, PlaceDrift)
    expect(failed_with(r, "drift") && is_dirty(r, "g", 1u64), "L52: the second drift did not fail the deploy at Dirty(g)")
    expect(asked_of(r, 3u64) == 1u64 && launcher.held(r.f) == 0u64, "L52: the second drift did not abort OLD once and release the held answer")

    // Lose the host after the fresh Preparing commit, before delivering its retry export.
    // OLD still knows the attempt from the first cutover. The reconnect abort must work
    // whether OLD kept that ID or already changed it while accepting the retry export.
    let (lost0, paused, pending) = cut_case(c, rnd)
    let mut lost = take lost0
    pump(mut lost, take pending)
    let original = deploy_attempt(lost)
    let replies = launcher.cutover_reply(mut lost.f, paused, PlaceDrift)
    for result in replies {
        let _ = apply(mut lost, Got(clone(result)))
    }
    let new_attempt = deploy_attempt(lost)
    expect(still_preparing(lost) && (new_attempt.hi != original.hi || new_attempt.lo != original.lo), "L52 restart: no durable retry to recover")
    let mut recovered = restart(take lost, 4u64)
    let mut abort_named_both = false
    for request in recovered.asked {
        if let Command(child, HostAbort(a, Some(prior))) = request {
            abort_named_both = launcher.same_child(child, paused) && a == attempt_bytes(new_attempt) && prior == attempt_bytes(original)
        }
    }
    expect(abort_named_both && asked_of(recovered, 1u64) == 0u64 && still_preparing(recovered), "L52 restart: recovery did not abort both possible pause owners and wait for OLD")
    old_says(mut recovered, paused, PlaceAborted)
    expect(failed_with(recovered, "interrupted before the cutover") && is_dirty(recovered, "g", 1u64), "L52 restart: abort did not preserve OLD")
    Ok(())
}

// L44 `cutover_survives_host_loss` (§14.5): the Pending row is durable before the
// candidate's Start and the cutover, so a host lost at any point resumes the attempt with
// the identical command and OLD installs once: lost before Start, before forwarding, during
// the install, and after OLD's answer but before the commit. A launcher lost after OLD
// installed leaves nothing that proves the install: the row is Undecided and probed. A
// host lost while the deploy is Preparing sends no cutover and aborts OLD's export first.
@test
fn cutover_survives_host_loss(c: Clock, rnd: Random) -> Result[(), ()] waits {
    // Before Start: nothing reached the launcher.
    let (r0, old, go) = cut_case(c, rnd)
    let _ = take go
    let mut a = restart(take r0, 4u64)
    expect(gens(a, "g") == one(2u64) && launcher.forwards(a.f) == 1u64, "L44: before Start, the candidate or the cutover was not sent again")
    answer(mut a, old, PlaceInstalled(2u64, true))
    expect(is_dirty(a, "g", 2u64) && committed_once(a), "L44 before Start: not one install committed to NEW's root with OLD retained and the hold released")
    expect(collection_keeps(mut a, true, true), "L44 before Start: a collection did not keep NEW's root and the retained OLD")
    // Before forwarding: the Start reached the launcher, the cutover did not.
    let (r1, old1, go1) = cut_case(c, rnd)
    let mut b = take r1
    let mut first: List[launcher.Request] = list.new()
    list.push(mut first, clone(go1[0u64]))
    pump(mut b, take first)
    let mut b2 = restart(take b, 4u64)
    expect(list.len(gens(b2, "g")) == 0u64 && launcher.forwards(b2.f) == 1u64, "L44: before forwarding, the candidate started again or the cutover was not sent once")
    answer(mut b2, old1, PlaceInstalled(2u64, true))
    expect(is_dirty(b2, "g", 2u64) && committed_once(b2), "L44 before forwarding: not one install committed to NEW's root with OLD retained and the hold released")
    expect(collection_keeps(mut b2, true, true), "L44 before forwarding: a collection did not keep NEW's root and the retained OLD")
    // During the install: OLD holds the command when the host is lost.
    let (r2, old2, go2) = cut_case(c, rnd)
    let mut d = take r2
    pump(mut d, take go2)
    let mut d2 = restart(take d, 4u64)
    expect(launcher.forwards(d2.f) == 1u64 && is_dirty(d2, "g", 1u64), "L44: during the install, the re-send reached OLD again or the row moved")
    answer(mut d2, old2, PlaceInstalled(2u64, true))
    expect(is_dirty(d2, "g", 2u64) && committed_once(d2), "L44 during the install: not one install committed to NEW's root with OLD retained and the hold released")
    expect(collection_keeps(mut d2, true, true), "L44 during the install: a collection did not keep NEW's root and the retained OLD")
    // After OLD's answer, before the commit: the launcher returns the kept answer.
    let (r3, old3, go3) = cut_case(c, rnd)
    let mut e = take r3
    pump(mut e, take go3)
    let _ = launcher.cutover_reply(mut e.f, old3, PlaceInstalled(2u64, true))
    expect(is_dirty(e, "g", 1u64), "L44: the host saw an answer it was not sent")
    let mut e2 = restart(take e, 4u64)
    expect(is_dirty(e2, "g", 2u64) && committed_once(e2), "L44 after the answer: not one install committed to NEW's root with OLD retained and the hold released")
    expect(collection_keeps(mut e2, true, true), "L44 after the answer: a collection did not keep NEW's root and the retained OLD")
    // Both children ended while no host watched, after OLD's answer: their ends wait for
    // the kept answer, which commits, and NEW's clean stop then writes Clean.
    let (r5, old5, go5) = cut_case(c, rnd)
    let mut q = take r5
    pump(mut q, take go5)
    let new5 = last(q, "g")
    let _ = launcher.cutover_reply(mut q.f, old5, PlaceInstalled(2u64, true))
    let _ = launcher.end(mut q.f, old5, Code(0i32), Some(None))
    let _ = launcher.end(mut q.f, new5, Code(0i32), Some(None))
    let q2 = restart(take q, 4u64)
    expect(is_clean(q2, "g") && committed_once(q2), "L44 ends before the answer: the kept Installed did not commit before the ends applied")
    // OLD ended unanswered while no host watched: the kept Uncertain is OLD's end, and the
    // candidate's open at v commits.
    let (r6, old6, go6) = cut_case(c, rnd)
    let mut u = take r6
    pump(mut u, take go6)
    let new6 = last(u, "g")
    let _ = launcher.end(mut u.f, old6, Code(1i32), None)
    let mut u2 = restart(take u, 4u64)
    expect(is_dirty(u2, "g", 1u64) && launcher.held(u2.f) == 1u64, "L44 Uncertain: decided before the candidate opened")
    let mut opened: List[launcher.Event] = list.new()
    list.push(mut opened, Placed(clone(new6), PlaceOpened(runner.PlaceReady(version: 2u64, store_hi: 1u64, store_lo: 2u64, release: release_two(), retain_from: 0u64, ready_ns: 0u64, read: cutover_read(2u64)))))
    feed(mut u2, take opened)
    expect(is_dirty(u2, "g", 2u64) && committed_once(u2), "L44 Uncertain: the candidate's open at v did not commit")
    expect(collection_keeps(mut u2, true, true), "L44 Uncertain: a collection did not keep NEW's root and the retained OLD")
    // Launcher lost after OLD installed: no child and no held answer survive.
    let (r4, old4, go4) = cut_case(c, rnd)
    let mut l = take r4
    pump(mut l, take go4)
    let _ = launcher.cutover_reply(mut l.f, old4, PlaceInstalled(2u64, true))
    let l2 = restart_bare(take l, 4u64)
    match deploy_outcome(l2.h, "g") {
        Some(Undecided(_)) => (),
        _ => fail("L44: after launcher loss the outcome is not Undecided")
    }
    expect(launcher.forwards(l2.f) == 0u64 && gens(l2, "g") == one(3u64) && is_dirty(l2, "g", 3u64), "L44: after launcher loss the group was not probed once at a new gen without a cutover")
    // The store installed v = 2: the probe opens NEW's pair, and that open installs NEW.
    let mut at_new = take l2
    expect(collection_keeps(mut at_new, true, true), "L44 launcher loss: an Undecided deploy's collection did not keep both roots")
    expect(starts_are(at_new, one_pair(3u64, 2u64, image_two())), "L44 launcher loss, store at NEW: the probe did not start NEW's assembly at v")
    expect(rooted_at(at_new, image(), 1u64) && launcher.forwards(at_new.f) == 0u64, "L44 launcher loss, store at NEW: the root moved before the probe opened")
    place_answers(mut at_new, 2u64)
    expect(installed_new(at_new, 2u64) && is_dirty(at_new, "g", 3u64) && starts_are(at_new, one_pair(3u64, 2u64, image_two())) && launcher.forwards(at_new.f) == 0u64, "L44 launcher loss, store at NEW: the probe's open did not install NEW once at Dirty(3)")
    expect(collection_keeps(mut at_new, true, true), "L44 launcher loss, store at NEW: a collection did not keep NEW's root and the retained OLD")
    // The launcher was lost with the cutover forwarded and not yet installed: the store is at
    // OLD's 1. NEW's probe is told so, OLD's pair is probed next, and its open abandons v.
    let (r7, _, go7) = cut_case(c, rnd)
    let mut n = take r7
    pump(mut n, take go7)
    let mut at_old = restart_bare(take n, 4u64)
    place_answers(mut at_old, 1u64)
    expect(rooted_at(at_old, image(), 1u64) && is_dirty(at_old, "g", 3u64), "L44 launcher loss, store at OLD: NEW's refused probe moved the root or the row")
    let probe = last(at_old, "g")
    finish(mut at_old, probe, Code(1i32), None)
    expect(starts_are(at_old, two_pairs(3u64, 2u64, image_two(), 4u64, 1u64, image())), "L44 launcher loss, store at OLD: OLD's pair was not probed next")
    place_answers(mut at_old, 1u64)
    let abandoned = match deploy_outcome(at_old.h, "g") {
        Some(Failed(why)) => why == "not installed after recovery",
        _ => false
    }
    expect(abandoned && rooted_at(at_old, image(), 1u64) && is_dirty(at_old, "g", 4u64) && list.len(status(at_old.h).failing) == 0u64, "L44 launcher loss, store at OLD: OLD's open did not abandon the deploy with OLD's root kept")
    expect(collection_keeps(mut at_old, false, true), "L44 launcher loss, store at OLD: a collection did not keep OLD's root alone after the abandon")
    // Lost while preparing: OLD exported and NEW's prepare child runs. The Preparing row
    // proves no cutover was sent, so the new session starts no candidate and sends no
    // cutover; it aborts OLD's export, and records the failure only on OLD's answer.
    let mut pr = rig(c, rnd, 4u64)
    add(mut pr, "g", "t")
    op_wake(mut pr, "g")
    let old8 = last(pr, "g")
    to_export(mut pr, old8, preview_answer(image_two(), release_two()))
    old_says(mut pr, old8, PlaceExported(1u64, "export-1"))
    let mut pr2 = restart(take pr, 4u64)
    expect(collection_keeps(mut pr2, true, true), "L44 while preparing: a collection did not keep the Preparing deploy's NEW and OLD")
    expect(list.len(gens(pr2, "g")) == 0u64 && asked_of(pr2, 2u64) == 0u64 && asked_of(pr2, 3u64) == 1u64 && still_preparing(pr2) && is_dirty(pr2, "g", 1u64), "L44 while preparing: the new session started a candidate, sent a cutover, did not abort OLD's export, or decided before OLD answered")
    old_says(mut pr2, old8, PlaceAborted)
    expect(failed_with(pr2, "interrupted before the cutover") && rooted_at(pr2, image(), 1u64) && is_dirty(pr2, "g", 1u64), "L44 while preparing: OLD's abort answer did not fail the deploy with OLD's root kept")
    expect(collection_keeps(mut pr2, false, true), "L44 while preparing: the failed deploy's NEW was still a root")
    let mut pv = rig(c, rnd, 4u64)
    add(mut pv, "g", "t")
    op_wake(mut pv, "g")
    let old9 = last(pv, "g")
    to_export(mut pv, old9, preview_answer(image(), release_two()))
    expect(asked_of(pv, 1u64) == 0u64 && failed_with(pv, "preview does not describe the selected assembly") && gens(pv, "g") == one(1u64), "L44 preview mismatch: OLD was asked to export, or the deploy did not fail")
    release_recovery_traces(c, rnd)
    Ok(())
}

type Pair {
    gen: u64,
    activation: u64,
    assembly: Bytes
}

fn one_pair(gen: u64, activation: u64, assembly: Bytes) -> List[Pair] {
    let mut out: List[Pair] = list.new()
    list.push(mut out, Pair(gen: gen, activation: activation, assembly: clone(assembly)))
    out
}

fn two_pairs(g1: u64, a1: u64, s1: Bytes, g2: u64, a2: u64, s2: Bytes) -> List[Pair] {
    let mut out = one_pair(g1, a1, s1)
    list.push(mut out, Pair(gen: g2, activation: a2, assembly: clone(s2)))
    out
}

// The serving Starts sent since the rig began, as (gen, activation, assembly).
fn starts_are(r: Rig, want: List[Pair]) -> bool {
    let mut got: List[Pair] = list.new()
    for l in r.sent {
        if let ServingMode(gen, serve) = l.mode {
            list.push(mut got, Pair(gen: gen, activation: serve.activation, assembly: clone(l.assembly)))
        }
    }
    if list.len(got) != list.len(want) {
        return false
    }
    for i in 0u64 .. list.len(got) {
        if got[i].gen != want[i].gen || got[i].activation != want[i].activation || got[i].assembly != want[i].assembly {
            return false
        }
    }
    true
}

fn rooted_at(r: Rig, assembly: Bytes, activation: u64) -> bool {
    match group_row(r.h, "g") {
        Ok(Some(g)) => g.assembly == assembly && g.activation == activation,
        _ => false
    }
}

fn installed_new(r: Rig, activation: u64) -> bool {
    let done = match deploy_outcome(r.h, "g") {
        Some(Installed) => true,
        _ => false
    }
    let rooted = match group_row(r.h, "g") {
        Ok(Some(g)) => g.assembly == image_two() && g.activation == activation && list.len(g.retained) == 1u64 && g.retained[0u64] == image(),
        _ => false
    }
    done && rooted
}

// The place's answer to its last serving Start under STORE's LOCK, with the store at
// `store_at` (RUNNER-SPEC §6, runner `head_prepare`): it opens when the selection names that
// version, and otherwise answers PlaceCurrent with the store's version.
fn place_answers(mut r: Rig, store_at: u64) waits {
    let mut chosen: Option[(launcher.Child, u64)] = None
    for l in r.sent {
        if let ServingMode(gen, serve) = l.mode {
            chosen = Some((launcher.Child(group: clone(l.group), role: Serving(gen)), serve.activation))
        }
    }
    let Some((ch, selected)) = chosen else {
        fail("no serving start to answer")
    }
    let reply: runner.HostReply = if selected == store_at {
        PlaceOpened(runner.PlaceReady(version: store_at, store_hi: 1u64, store_lo: 2u64, release: release_at(store_at), retain_from: 0u64, ready_ns: 0u64, read: cutover_read(store_at)))
    } else {
        PlaceCurrent(store_at, cutover_read(store_at))
    }
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Placed(take ch, take reply))
    feed(mut r, take events)
}

// Writes `n` Clean groups straight into the catalog, `due` of them overdue.
fn seed_clean(mut r: Rig, n: u64, due: u64) waits {
    let mut done = 0u64
    while done < n {
        let upto = if n - done > 1000u64 {
            done + 1000u64
        } else {
            n
        }
        let lo = done
        let made = {
            let t = view r.h.t
            store.run(mut r.h.db, None, scoped fn(mut tx: store.Tx) -> Result[(), Refused] {
                for i in lo .. upto {
                    let mut name = string.from("bulk-")
                    string.push_uint(mut name, i, 10u32, 6u64, '0')
                    let g = GroupRow(tenant: "bulk", workdir: string.from(name), author: Trusted, label: Uncontained, listen: "127.0.0.1:0", bindings: uncontained(), limits: unlimited(), assembly: image(), activation: 1u64, retained: list.new(), recovery: None, store_id: None, incarnation: 1000000u64 + i, retiring: None, args: list.new(), record: None)
                    st(store.put(mut tx, t.groups, name, g))?
                    let at: Option[u64] = if i < due {
                        Some(T0 + 10u64)
                    } else {
                        Some(T0 + 86400000u64)
                    }
                    st(store.put(mut tx, t.wake, name, WakeRow(wake: Clean(at), gen: 1u64)))?
                    if let Some(when) = at {
                        st(store.put(mut tx, t.due, DueKey(at: when, name: string.from(name)), 0u8))?
                    }
                }
                Ok(())
            })
        }
        let _ = must(decided(mut r.h, take made), "seed")
        must(synced(mut r.h), "seed sync")
        done = upto
    }
}

// L45 `wake_probe_bound` (§14.2, §14.5): a restart probes exactly the Dirty rows with no
// child, counted apart from its due wakes, never scans the Clean rows for probes, refuses a
// bound below `dirty`, adopts a child that outlived only the host, and a retired failing
// group gives up its slot.
@test
fn wake_probe_bound(c: Clock, rnd: Random) -> Result[(), ()] waits {
    let mut r = rig(c, rnd, 5u64)
    add(mut r, "k1", "t")
    add(mut r, "k2", "t")
    add(mut r, "k3", "t")
    op_wake(mut r, "k1")
    op_wake(mut r, "k2")
    op_wake(mut r, "k3")
    seed_clean(mut r, 10000u64, 2u64)
    // The three are killed while no host watches.
    let ch_k1 = last(r, "k1")
    let _ = launcher.end(mut r.f, ch_k1, Signal(9i32), None)
    let ch_k2 = last(r, "k2")
    let _ = launcher.end(mut r.f, ch_k2, Signal(9i32), None)
    let ch_k3 = last(r, "k3")
    let _ = launcher.end(mut r.f, ch_k3, Signal(9i32), None)
    r.now = Now(wall_ms: T0 + 20u64, mono_ns: r.now.mono_ns)
    let mut back = restart(take r, 5u64)
    expect(back.h.probes == 3u64, "L45: the restart did not probe exactly the Dirty rows")
    expect(gens(back, "k1") == one(2u64) && gens(back, "k2") == one(2u64) && gens(back, "k3") == one(2u64), "L45: a Dirty row was not probed")
    expect(back.h.due_wakes == 2u64, "L45: the overdue Clean rows were not woken as due wakes")
    expect(list.len(back.starts) == 5u64, "L45: the restart started a row that was neither Dirty nor due")
    match set_max_places(mut back.h, 4u64, back.now) {
        Error(Busy(5u64)) => (),
        _ => fail("L45: a bound below dirty was not refused Busy"),
    }
    // Host-only restart: G keeps serving, is adopted, no probe starts, its report writes Clean.
    let mut s = rig(c, rnd, 4u64)
    add(mut s, "g", "t")
    for _ in 0u64 .. 6u64 {
        op_wake(mut s, "g")
        idle_stop(mut s, "g", None)
    }
    op_wake(mut s, "g")
    expect(is_dirty(s, "g", 7u64), "L45: setup did not reach the serving generation")
    let serving = last(s, "g")
    let mut kept = restart(take s, 4u64)
    expect(kept.h.probes == 0u64 && list.len(kept.starts) == 0u64, "L45: a live child was probed after a host restart")
    finish(mut kept, serving, Code(0i32), Some(None))
    expect(is_clean(kept, "g"), "L45: the adopted child's clean report did not write Clean")
    // Retirement: A fails every start and holds the one slot; B's due wake is queued; retiring
    // A answers Retired, frees the slot, and B starts.
    let mut t = rig(c, rnd, 1u64)
    cold_due(mut t, "b", "t", T0 + 1000u64)
    add(mut t, "a", "t")
    op_wake(mut t, "a")
    crash(mut t, "a")
    crash(mut t, "a")
    at_wall(mut t, T0 + 1000u64)
    expect(launches(t, "b") == 1u64, "L45: B started while A held the slot")
    let out = must(remove(mut t.h, "a", Delete), "retire")
    pump(mut t, take out)
    expect(gone_row(t.h, "a"), "L45: the retired group's rows remain")
    expect(gens(t, "b") == two(1u64, 2u64), "L45: retiring the failing group did not free its slot")
    match retirement(t.h, "a") {
        Some(Retired(disposition: Delete, ..)) => (),
        _ => fail("L45: the retirement's disposition was not recorded"),
    }
    Ok(())
}

fn bytes_of(n: u64, b: u8) -> Bytes {
    let mut out: Bytes = list.with_capacity(n)
    for _ in 0u64 .. n {
        list.push(mut out, b)
    }
    out
}

fn finds(h: Host, id: Bytes, now: u64, want: Bytes) -> bool {
    match resolve_pin(h, id, now) {
        Ok(Found(got)) => got == want,
        _ => false,
    }
}

fn pin_gone(h: Host, id: Bytes, now: u64) -> bool {
    match resolve_pin(h, id, now) {
        Ok(Gone) => true,
        _ => false,
    }
}

// `pin_expiry` (launch.md "Host assembly", docs/recording.md): a recording pin is durable
// before its recorded process starts, survives a host restart, resolves to its assembly
// strictly before its expiry, and is `Gone` from the expiry second on, when absent, and
// after an operator removes it.
@test
fn pin_expiry(c: Clock, rnd: Random) -> Result[(), ()] waits {
    let mut r = rig(c, rnd, 4u64)
    let id = bytes_of(16u64, 3u8)
    let other = bytes_of(16u64, 4u8)
    let expires = 1700000000u64 + 30u64 * 86400u64
    expect(pin_gone(r.h, id, 0u64), "pin: an absent pin resolved")
    must(keep_pin(mut r.h, id, image(), expires), "keep_pin")
    let mut kept = restart(take r, 4u64)
    expect(finds(kept.h, id, expires - 1u64, image()), "pin: the pin did not resolve one second before its expiry")
    expect(pin_gone(kept.h, id, expires), "pin: the pin resolved at its expiry")
    expect(pin_gone(kept.h, other, 0u64), "pin: another recording ID resolved")
    must(forget_pin(mut kept.h, id), "forget_pin")
    expect(pin_gone(kept.h, id, 0u64), "pin: a removed pin resolved")
    Ok(())
}

fn offline_is(d: Dir, id: Bytes, now: u64, want: Option[Bytes]) -> bool waits {
    match resolve_offline(d, id, now) {
        Ok(Found(a)) => match want {
            Some(w) => a == w,
            None => false
        },
        Ok(Gone) => is_none(want),
        Error(_) => false
    }
}

// `pin_offline_reader` (launch.md "Replaying a recording"): with the catalog on disk, the
// offline reader gives the live host's answer for the same ID and second: the pin's assembly
// strictly before its expiry, `Gone` at the expiry, for a removed pin and for an unknown ID,
// from the journal before any checkpoint. A directory with no catalog is an error, never
// `Gone`.
@test
fn pin_offline_reader(d: Dir, c: Clock, rnd: Random, tasks: Tasks) -> Result[(), ()] waits {
    let mut name = string.with_capacity(64u64)
    string.push(mut name, "platform-pins-")
    let Ok(at) = host.mkdtemp(d, mut name) else {
        fail("mkdtemp")
    }
    let mut empty = string.with_capacity(64u64)
    string.push(mut empty, "platform-empty-")
    let Ok(none) = host.mkdtemp(d, mut empty) else {
        fail("mkdtemp")
    }
    let db = match store.open(tasks, at, c, rnd, result.unwrap(store.sized(Directory, 2147483648u64))) {
        Ok(take db) => take db,
        Error(_) => fail("open the catalog")
    }
    let (h0, _) = must(open(take db, Config(max_places: 4u64, idle_ms: 1000u64)), "open")
    let mut h = take h0
    let id = bytes_of(16u64, 3u8)
    let gone = bytes_of(16u64, 4u8)
    let unknown = bytes_of(16u64, 5u8)
    let expires = 1700000000u64 + 60u64
    must(keep_pin(mut h, id, image(), expires), "keep_pin")
    must(keep_pin(mut h, gone, image_two(), expires), "keep_pin")
    must(forget_pin(mut h, gone), "forget_pin")
    let live_found = match resolve_pin(h, id, expires - 1u64) {
        Ok(Found(a)) => a == image(),
        _ => false
    }
    expect(live_found && offline_is(at, id, expires - 1u64, Some(image())), "offline: the reader missed a pin the live host resolves")
    expect(offline_is(at, id, expires, None), "offline: the reader resolved a pin at its expiry")
    expect(offline_is(at, gone, 0u64, None) && offline_is(at, unknown, 0u64, None), "offline: the reader resolved a removed or unknown pin")
    expect(!offline_is(none, id, 0u64, None), "offline: a directory with no catalog was Gone")
    let _ = store.close(close(take h))
    Ok(())
}

fn rejected_with(r: Rig, why: String) -> bool {
    match deploy_admission(r.h, "g") {
        Some(Rejected(w)) => w == why,
        _ => false
    }
}

fn helpers_started(r: Rig) -> u64 {
    let mut n = 0u64
    for c in r.starts {
        if let Describe(_) = c.role {
            n += 1u64
        }
    }
    n
}

// A group g serving at gen 1 whose cgroup memory is `memory`, by `author`.
fn admission_case(c: Clock, rnd: Random, memory: Option[u64], author: Author) -> Rig waits {
    let mut r = rig(c, rnd, 4u64)
    let spec = NewGroup(name: "g", tenant: "t", workdir: "g", author: author, label: Uncontained, listen: "127.0.0.1:0", bindings: uncontained(), limits: launcher.Limits(memory: memory, cpu: None, pids: None), assembly: image(), activation: 1u64, args: list.new(), record: None)
    let reqs = must(add_group(mut r.h, spec), "add_group")
    pump(mut r, take reqs)
    op_wake(mut r, "g")
    r
}

// L48 `deploy_admission_policy` (launch.md "Publish and assemble"): the host relays a
// deploy's admission and decides its approvals from the verified summary before the image
// is assembled. OLD and NEW serve side by side through the cutover, so their root limits
// together must fit the group's memory; a nonempty grant diff holds the request until a
// person decides on exactly that diff; nonempty approval text needs the operator's confirmation of exactly that text;
// an untrusted author publishes source only. A refused admission is released and leaves no
// Preparing row, no helper child and no Assemble. A slow upload waits while another group's
// child end and a collection go through the host.
@test
fn deploy_admission_policy(c: Clock, rnd: Random) -> Result[(), ()] waits {
    // Overlap memory: 60 + 50 > 100 is refused; 50 + 50 fits.
    let mut r = admission_case(c, rnd, Some(100u64), Trusted)
    admit_new(mut r, summary_of(60u64, 50u64, launcher.no_grants()), "")
    expect(rejected_with(r, "Refused(Memory)"), "memory: OLD and NEW together exceed the group's memory")
    expect(asked_of(r, 4u64) == 0u64 && asked_of(r, 5u64) == 1u64, "memory: the refused admission is released, not assembled")
    expect(is_none(deploy_outcome(r.h, "g")) && helpers_started(r) == 0u64, "memory: a refused admission prepares nothing")
    let refused_id: Bytes = clone(r.req)
    let seen = is_failed(phase_on(r, r.conn), DeniedClass)
    expect(seen && is_failed(status_of(mut r, refused_id), DeniedClass), "memory: the refusal is not the request's durable Failed(Denied)")
    admit_new(mut r, summary_of(50u64, 50u64, launcher.no_grants()), "")
    expect(asked_of(r, 4u64) == 1u64, "memory: an admission that fits is assembled")
    // A grant diff against OLD's recipe (one Net rule gained): the request releases its
    // attempt and waits for a person's decision on exactly that diff, naming the authority,
    // and nothing is assembled until then. The owner may leave; a decision on another diff
    // is refused; the exact approval, on any connection, repeats the admission, which the
    // same diff then passes.
    let mut r2 = admission_case(c, rnd, None, Trusted)
    let net = grants_of("Net=tcp:example.org:443", "")
    let owner = begin_new(mut r2)
    let held_d: Bytes = clone(r2.req)
    let held_a = r2.a
    let mut first2: List[launcher.Event] = list.new()
    list.push(mut first2, Admitted(held_a, image_two(), summary_of(1u64, 1u64, clone(net)), ""))
    feed(mut r2, take first2)
    expect(asked_of(r2, 4u64) == 0u64 && released(r2, held_a), "grant: an undecided grant diff was assembled or kept its attempt")
    expect(awaits(phase_on(r2, owner), "Net=tcp:example.org:443", ""), "grant: the owner was not shown the diff it awaits a decision on")
    hang_up(mut r2, owner)
    expect(awaits(status_of(mut r2, held_d), "Net=tcp:example.org:443", ""), "grant: the hold did not outlive its owner")
    let wrong = decide_on(mut r2, held_d, grants_of("Net=tcp:example.org:443", "Dir=a"), true)
    expect(errored(r2, wrong, DeniedClass) && admits(r2) == 1u64, "grant: a decision on another diff was taken")
    let _ = decide_on(mut r2, held_d, clone(net), true)
    expect(admits(r2) == 2u64 && !same_attempt(held_a, r2.a), "grant: the approval did not repeat the admission under a fresh attempt")
    let mut second2: List[launcher.Event] = list.new()
    list.push(mut second2, Admitted(r2.a, image_two(), summary_of(1u64, 1u64, clone(net)), ""))
    feed(mut r2, take second2)
    expect(asked_of(r2, 4u64) == 1u64, "grant: the approved diff was not assembled")
    // A refusal fails the request; a later Begin supersedes one still waiting.
    let mut r7 = admission_case(c, rnd, None, Trusted)
    let _ = begin_new(mut r7)
    let no_d: Bytes = clone(r7.req)
    let mut lost: List[launcher.Event] = list.new()
    list.push(mut lost, Admitted(r7.a, image_two(), summary_of(1u64, 1u64, grants_of("", "Dir=a")), ""))
    feed(mut r7, take lost)
    let _ = decide_on(mut r7, no_d, grants_of("", "Dir=a"), false)
    expect(is_failed(status_of(mut r7, no_d), DeniedClass) && asked_of(r7, 4u64) == 0u64, "grant: a refused diff did not fail the request")
    let _ = begin_new(mut r7)
    let sup_d: Bytes = clone(r7.req)
    let mut lost2: List[launcher.Event] = list.new()
    list.push(mut lost2, Admitted(r7.a, image_two(), summary_of(1u64, 1u64, grants_of("", "Dir=a")), ""))
    feed(mut r7, take lost2)
    let _ = begin_new(mut r7)
    expect(is_failed(status_of(mut r7, sup_d), DeniedClass) && admits(r7) == 3u64, "grant: a later Begin did not supersede the request awaiting a decision")
    // Approval text: no Assemble until the operator confirms exactly that text; then the
    // assembled deploy is Preparing, its reservation released and OLD's describe started.
    let mut r3 = admission_case(c, rnd, None, Trusted)
    admit_new(mut r3, summary_of(1u64, 1u64, launcher.no_grants()), "foreign: lib")
    expect(asked_of(r3, 4u64) == 0u64, "confirm: assembled before the confirmation")
    let mut shown = false
    for x in got_on(r3, r3.conn) {
        if let DisplayAnswer(_, _, root, text) = x {
            shown = root == image_two() && text == "foreign: lib"
        }
    }
    expect(shown, "confirm: the operator was not sent the display for verified R")
    // A hash of other text is refused and ends the exchange, which releases the attempt.
    let first = r3.conn
    let d3: Bytes = clone(r3.req)
    let a3 = r3.a
    send(mut r3, first, ConfirmAsk(d3, a3, digest_bytes("foreign: other")))
    expect(asked_of(r3, 4u64) == 0u64 && errored(r3, first, DeniedClass) && asked_of(r3, 5u64) == 1u64, "confirm: a different text confirmed, or its closed exchange kept the attempt")
    // The same Begin again repeats the admission under a fresh attempt.
    let before = r3.a
    let again: Bytes = clone(r3.req)
    let _ = begin_with(mut r3, again, Attested(image_two()))
    expect(!same_attempt(before, r3.a) && admits(r3) == 2u64, "confirm: the repeated Begin did not admit again under a fresh attempt")
    let mut events: List[launcher.Event] = list.new()
    list.push(mut events, Admitted(r3.a, image_two(), summary_of(1u64, 1u64, launcher.no_grants()), "foreign: lib"))
    feed(mut r3, take events)
    let c3 = r3.conn
    let d4: Bytes = clone(r3.req)
    let a4 = r3.a
    send(mut r3, c3, ConfirmAsk(d4, a4, digest_bytes("foreign: lib")))
    expect(asked_of(r3, 4u64) == 1u64, "confirm: the hash of the exact text assembles")
    // A complete input whose owner left before the display: nobody can confirm it, so the
    // attempt is released, and the same Begin is shown the display under a fresh attempt.
    let mut r6 = admission_case(c, rnd, None, Trusted)
    let gone = begin_new(mut r6)
    let d6: Bytes = clone(r6.req)
    let a6 = r6.a
    send(mut r6, gone, EndAsk(clone(d6), a6))
    hang_up(mut r6, gone)
    let mut late: List[launcher.Event] = list.new()
    list.push(mut late, Admitted(a6, image_two(), summary_of(1u64, 1u64, launcher.no_grants()), "foreign: lib"))
    feed(mut r6, take late)
    expect(released(r6, a6), "confirm: an unowned confirmation kept its attempt")
    let back = begin_with(mut r6, d6, Attested(image_two()))
    let a7 = r6.a
    let mut again6: List[launcher.Event] = list.new()
    list.push(mut again6, Admitted(a7, image_two(), summary_of(1u64, 1u64, launcher.no_grants()), "foreign: lib"))
    feed(mut r6, take again6)
    let mut shown6 = false
    for x in got_on(r6, back) {
        if let DisplayAnswer(_, _, _, text) = x {
            shown6 = text == "foreign: lib"
        }
    }
    expect(!same_attempt(a6, a7) && shown6, "confirm: the reattached Begin was not shown the display")
    unplug(mut r6)
    assembled_new(mut r3)
    expect(still_preparing(r3) && asked_of(r3, 5u64) == 2u64 && helpers_started(r3) == 1u64, "confirm: the assembled deploy prepares after its row is durable")
    // A slow upload: the verifier asked for objects in two parts and half are sent; another
    // group's child ends and a collection runs while the attempt waits for the rest. The
    // admission keeps its Need parts and still relays the remaining bytes.
    let mut r5 = admission_case(c, rnd, None, Trusted)
    add(mut r5, "k", "t")
    op_wake(mut r5, "k")
    let other = last(r5, "k")
    let up = begin_new(mut r5)
    let mut parts: List[launcher.Event] = list.new()
    let mut first_part: List[launcher.Wanted] = list.new()
    list.push(mut first_part, BodyKey(bytes_of(32u64, 1u8)))
    let mut second_part: List[launcher.Wanted] = list.new()
    list.push(mut second_part, AnnexKey(bytes_of(32u64, 2u8)))
    list.push(mut parts, Need(r5.a, take first_part, false))
    list.push(mut parts, Need(r5.a, take second_part, true))
    feed(mut r5, take parts)
    let d5: Bytes = clone(r5.req)
    let a5 = r5.a
    send(mut r5, up, DataAsk(clone(d5), a5, bytes_of(8u64, 1u8)))
    finish(mut r5, other, Code(0i32), Some(None))
    expect(is_clean(r5, "k"), "slow upload: the other group's clean end was not applied while the upload waits")
    expect(collection_keeps(mut r5, false, true), "slow upload: a collection during the upload did not run or rooted the unassembled NEW")
    send(mut r5, up, DataAsk(clone(d5), a5, bytes_of(8u64, 2u8)))
    send(mut r5, up, EndAsk(clone(d5), a5))
    let mut needs = 0u64
    for x in got_on(r5, up) {
        if let NeedAnswer(_, _, _, _) = x {
            needs += 1u64
        }
    }
    expect(needs == 2u64 && is_none(error_on(r5, up)), "slow upload: the operator was not relayed both Need parts")
    let waiting = match deploy_admission(r5.h, "g") {
        Some(Uploading(keys, done)) => done && list.len(keys) == 2u64,
        _ => false
    }
    expect(waiting, "slow upload: the admission lost its Need parts across the end and the collection")
    let mut sent = 0u64
    for q in r5.asked {
        match q {
            AdmitData(_, _) => {
                sent += 1u64
            },
            AdmitEnd(_) => {
                sent += 10u64
            },
            _ => (),
        }
    }
    expect(sent == 12u64, "slow upload: the host did not relay both chunks and the end")
    unplug(mut r5)
    // An untrusted author attests nothing.
    let mut r4 = admission_case(c, rnd, None, Untrusted)
    let denied = begin_new(mut r4)
    expect(errored(r4, denied, DeniedClass) && admits(r4) == 0u64 && is_none(deploy_admission(r4.h, "g")), "untrusted: an attested recipe is refused")
    unplug(mut r)
    unplug(mut r2)
    unplug(mut r3)
    unplug(mut r4)
    Ok(())
}

fn released(r: Rig, a: launcher.Attempt) -> bool {
    for q in r.asked {
        if let Release(x) = q {
            if same_attempt(x, a) {
                return true
            }
        }
    }
    false
}

// L49 `operator_request_identity` (launch.md "The operator socket"): a deploy is named by
// its client's 16-byte request ID D, durably. A Begin retried with the same D after the host
// is lost gets the recorded outcome and admits nothing; the same D with other content is a
// Conflict; an upload whose connection closes before its end releases its attempt, and the
// same Begin admits again under a fresh attempt; Status(D) still reports an installed
// request after a later deploy of the group.
@test
fn operator_request_identity(c: Clock, rnd: Random) -> Result[(), ()] waits {
    let mut r = rig(c, rnd, 4u64)
    add(mut r, "g", "t")
    op_wake(mut r, "g")
    let old = last(r, "g")
    let go = prepared(mut r, old)
    pump(mut r, take go)
    answer(mut r, old, PlaceInstalled(2u64, true))
    let first: Bytes = clone(r.req)
    expect(is_installed(phase_on(r, r.conn)), "L49: the owner was not sent Installed")
    let mut b = restart(take r, 4u64)
    let retry = begin_with(mut b, first, Attested(image_two()))
    expect(is_installed(phase_on(b, retry)) && admits(b) == 0u64, "L49: a Begin retried after host loss admitted again or lost its outcome")
    let other = begin_with(mut b, first, Attested(image()))
    expect(errored(b, other, ConflictClass) && admits(b) == 0u64, "L49: the same request ID with other content was not a Conflict")
    let cut = begin_new(mut b)
    let a1 = b.a
    expect(admits(b) == 1u64, "L49: a new request ID did not admit")
    hang_up(mut b, cut)
    expect(released(b, a1), "L49: an upload cut off before its end kept its attempt")
    let second: Bytes = clone(b.req)
    let _ = begin_with(mut b, second, Attested(image_two()))
    expect(admits(b) == 2u64 && !same_attempt(a1, b.a), "L49: the repeated Begin did not admit again under a fresh attempt")
    // The second request reaches its own deploy row; the first's Status is unchanged.
    let mut ev: List[launcher.Event] = list.new()
    list.push(mut ev, Admitted(b.a, image_two(), summary_of(1u64, 1u64, launcher.no_grants()), ""))
    feed(mut b, take ev)
    assembled_new(mut b)
    expect(still_preparing(b), "L49: the second request did not reach its deploy row")
    expect(is_installed(status_of(mut b, first)), "L49: Status lost the installed request after a later deploy")
    unplug(mut b)
    Ok(())
}

fn registration(name: String, label: launcher.Label, store_dir: String) -> operator.Registration {
    operator.Registration(name: string.from(name), tenant: "t", workdir: string.from(name), trusted: true, label: label, listen: "127.0.0.1:0", bindings: launcher.Bindings(store: string.from(store_dir), dirs: list.new(), net: list.new()), limits: unlimited(), args: list.new(), record: None)
}

// Registers `spec` under request `d` with NEW attested, on a new connection; the rig's
// attempt becomes the one the host assigned. Gives the connection.
fn register_as(mut r: Rig, d: Bytes, take spec: operator.Registration) -> u64 waits {
    r.conns += 1u64
    let conn = r.conns
    send(mut r, conn, RegisterAsk(clone(d), take spec, Attested(image_two()), list.new(), list.new()))
    if let Some(p) = phase_on(r, conn) {
        if let Some(a) = attempt_of(p) {
            r.a = a
        }
    }
    r.req = clone(d)
    r.conn = conn
    conn
}

// Where in the rig's requests group `name` was first bound and first admitted, and whether
// that admission had no OLD.
fn bind_then_admit(r: Rig, name: String) -> bool {
    let mut bind: Option[u64] = None
    let mut admit: Option[(u64, bool)] = None
    for i in 0u64 .. list.len(r.asked) {
        match r.asked[i] {
            Bind(g, _, _, _, _) if g.name == name && is_none(bind) => {
                bind = Some(i)
            },
            Admit(g, _, _, ap) if g.name == name && is_none(admit) => {
                admit = Some((i, is_none(ap.old)))
            },
            _ => (),
        }
    }
    match (bind, admit) {
        (Some(b), Some((x, no_old))) => b < x && no_old,
        _ => false
    }
}

fn closed(r: Rig, name: String) -> bool {
    for q in r.asked {
        if let Close(g) = q {
            if g.name == name {
                return true
            }
        }
    }
    false
}

// A serving Start of group `name` at activation `activation` running `assembly`.
fn serving_at(r: Rig, name: String, activation: u64, assembly: Bytes) -> bool {
    for l in r.sent {
        if let ServingMode(_, serve) = l.mode {
            if l.group.name == name && serve.activation == activation && serve.candidate == None && l.assembly == assembly {
                return true
            }
        }
    }
    false
}

// Whether group `name`'s first serving start carried its arguments and a recording whose
// pin, committed before the start, names the start's assembly until its 60 s retention ends.
fn recorded_start(r: Rig, name: String) -> bool {
    for l in r.sent {
        if let ServingMode(gen, _) = l.mode {
            if l.group.name != name {
                continue
            }
            let Some(rec) = l.recording else {
                return false
            }
            let mut want_id: Bytes = list.new()
            for i in 0u64 .. 8u64 {
                list.push(mut want_id, int.narrow((l.group.incarnation >> (8u64 * i)) & 255u64))
            }
            for i in 0u64 .. 8u64 {
                list.push(mut want_id, int.narrow((gen >> (8u64 * i)) & 255u64))
            }
            let now_s = r.now.wall_ms / 1000u64
            let found = match resolve_pin(r.h, rec.id, now_s + 59u64) {
                Ok(Found(a)) => a == l.assembly,
                _ => false
            }
            let gone = match resolve_pin(r.h, rec.id, now_s + 60u64) {
                Ok(Gone) => true,
                _ => false
            }
            let args_ok = list.len(l.args) == 1u64 && l.args[0u64] == "--port"
            return rec.id == want_id && string.starts_with(rec.destination, "/tapes/") && string.ends_with(rec.destination, ".tape") && found && gone && args_ok
        }
    }
    false
}

// L51 `operator_register` (launch.md "Registering a group"): a Register binds the group's
// listener before it opens the first release's admission, which has no OLD; nothing reaches
// the group until that release is assembled. The assembled release is Installed at
// activation 0 and the group's genesis starts serving at activation 0. The same request ID
// gets the recorded outcome and admits nothing; with other content it is a Conflict, as is a
// second group on the same store. A registration whose admission fails, or whose listener
// cannot be bound, removes its group and closes its listener, and the name registers again.
@test
fn operator_register(c: Clock, rnd: Random) -> Result[(), ()] waits {
    let mut r = rig(c, rnd, 4u64)
    let d1 = request_id(1u64)
    let mut recorded = registration("g", Uncontained, "s1")
    list.push(mut recorded.args, "--port")
    recorded.record = Some(operator.Record(dir: "/tapes", retention_s: 60u64))
    let reg = register_as(mut r, d1, clone(recorded))
    expect(bind_then_admit(r, "g") && admits(r) == 1u64, "L51: the first admission was not opened after the Bind, with no OLD")
    let early = begin_new(mut r)
    expect(errored(r, early, UnknownGroupClass) && admits(r) == 1u64 && list.len(r.starts) == 0u64, "L51: a Begin reached a registering group")
    r.req = clone(d1)
    let mut ev: List[launcher.Event] = list.new()
    list.push(mut ev, Admitted(r.a, image_two(), summary_of(1u64, 0u64, launcher.no_grants()), ""))
    feed(mut r, take ev)
    let a = r.a
    assembled_new(mut r)
    expect(is_installed(phase_on(r, reg)) && rooted_at(r, image_two(), 0u64), "L51: the assembled first release was not Installed at activation 0")
    expect(released(r, a), "L51: the first release's attempt was not released")
    expect(serving_at(r, "g", 0u64, image_two()), "L51: the group's genesis did not start serving at activation 0")
    expect(recorded_start(r, "g"), "L51: the genesis start lost its arguments, or ran unrecorded or before its pin")
    let again = register_as(mut r, d1, take recorded)
    expect(is_installed(phase_on(r, again)) && admits(r) == 1u64, "L51: a repeated Register admitted again or lost its outcome")
    let other = register_as(mut r, d1, registration("g", Uncontained, "s9"))
    expect(errored(r, other, ConflictClass), "L51: the same request ID with other content was not a Conflict")
    let shared = register_as(mut r, request_id(2u64), registration("k", Uncontained, "s1"))
    expect(errored(r, shared, ConflictClass) && admits(r) == 1u64, "L51: a second group was registered on the same store")
    // The admission fails: the group and its listener go, and the name registers again.
    let bad = register_as(mut r, request_id(3u64), registration("h", Uncontained, "s3"))
    let mut no: List[launcher.Event] = list.new()
    list.push(mut no, AdmissionFailed(r.a, Invalid("bad recipe")))
    feed(mut r, take no)
    expect(is_failed(phase_on(r, bad), InvalidClass) && closed(r, "h") && is_none(must(group_row(r.h, "h"), "row")), "L51: a failed registration kept its group or listener")
    let _ = register_as(mut r, request_id(4u64), registration("h", Uncontained, "s3"))
    expect(admits(r) == 3u64, "L51: the name of a failed registration did not register again")
    // An upload cut off before its end releases its attempt; the same Register takes it
    // again under a fresh attempt, still with no OLD, and nothing starts.
    let cut = register_as(mut r, request_id(6u64), registration("p", Uncontained, "s6"))
    let a6 = r.a
    hang_up(mut r, cut)
    let _ = register_as(mut r, request_id(6u64), registration("p", Uncontained, "s6"))
    let mut no_old = 0u64
    for q in r.asked {
        if let Admit(g, _, _, ap) = q {
            if g.name == "p" && is_none(ap.old) {
                no_old += 1u64
            }
        }
    }
    expect(released(r, a6) && !same_attempt(a6, r.a) && no_old == 2u64 && !serving_at(r, "p", 0u64, image_two()), "L51: a cut-off registration did not admit again under a fresh attempt with no OLD")
    // The listener cannot be bound: the registration fails the same way.
    let _ = register_as(mut r, request_id(5u64), registration("m", Contained, "s5"))
    expect(is_failed(status_of(mut r, request_id(5u64)), InvalidClass) && closed(r, "m") && is_none(must(group_row(r.h, "m"), "row")), "L51: an unbound registration kept its group")
    unplug(mut r)
    Ok(())
}

fn is_ok[T](r: Result[T, Refused]) -> bool {
    match r {
        Ok(_) => true,
        Error(_) => false
    }
}

// OWN-19: a scoped type argument is refused only by a user-declared generic; a core
// operation takes one (lru's `result.unwrap(std.pool.get(..))`). The view that comes out
// of `option.unwrap` is the caller's record (each run returns the `b` it built), and it
// keeps its anchor frozen: clearing the list it views is refused (OWN-10).
// expect: run unwrapped(7) = 7
// expect: run swapped(4) = 4
// expect: refuse OWN-10 at 22:14
type P { a: u64, b: u64, c: u64 }
fn unwrapped(x: u64) -> u64 {
  let p = P(a: 1, b: x, c: 3)
  let v = option.unwrap(Some(view p))
  v.b
}
fn swapped(x: u64) -> u64 {
  let p = P(a: x, b: 2, c: 3)
  let r: Result[View[P], u64] = Ok(view p)
  let v = result.unwrap(r)
  v.a
}
fn frozen(mut xs: List[u64]) -> u64 {
  let v = option.unwrap(Some(view xs))
  list.clear(mut xs)
  list.len(v)
}

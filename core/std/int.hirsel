// Module `int`: integer operations (SEM-1). The CORE arithmetic and conversions
// (wrapping_, checked_, saturating_, widen, narrow, try_narrow, truncate) are core.md's and
// not repeated; `parse` is restated for its contract. `T` ranges over the integer types.
// ParseError and Order are core types. Parsing reads a String, so a `string.slice` of a
// line parses without a copy. Nothing here allocates.

/// CORE. Parses the whole of s in decimal: an optional '-' for signed T, then ASCII
/// digits; no '+', spaces or '_'.
/// Fails: Error(Empty | Invalid(i) | OutOfRange), i the byte position. Cost: O(len).
/// Ex: `let n: u64 = int.parse(field)?`
pub fn parse[T](s: String) -> Result[T, ParseError]

/// Parses the whole of s in `base` (2 to 36), digits as char.digit reads them.
/// Fails: Bounds (failure) when base is outside 2..=36; otherwise as parse.
/// Cost: O(len). Ex: `let cp: u32 = int.parse_radix(hex4, 16)?`
pub fn parse_radix[T](s: String, base: u32) -> Result[T, ParseError]

/// Three-way numeric order (the order of `<`). Cost: O(1). Ex: `int.compare(a, b)`
pub fn compare[T](a: T, b: T) -> Order

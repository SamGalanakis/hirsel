#!/usr/bin/env python3
"""Post-push unit body: tools/land-post TIP EVENTS UNIT.

tools/land starts it in a detached user unit after each push. It runs the
pushed tree's POST_PUSH suites on TIP, in its own detached checkout, at lane
priority. A target red here that was not red at the last finished run is
appended to EVENTS as POSTRED: `lane` holds the branches landed since that
run, `ticket` their tickets, `landed` the commit range and `submitted` the
new red targets.
A newer push's run supersedes this one: it stops this unit by its recorded
name and removes this run's recorded checkout, so a superseded run's range
joins the newer one's.
"""
import fcntl
import json
import os
from contextlib import contextmanager
from pathlib import Path
import runpy
import subprocess
import sys

from land_events import append_event

STATE = 'land-post.json'


def git(*arguments, cwd=None):
    return subprocess.run(['git', *arguments], cwd=cwd, capture_output=True, text=True)


@contextmanager
def state(common):
    """The post-push record under its own lock: the current run, the last finished run and its reds."""
    with open(common / (STATE + '.lock'), 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = common / STATE
        record = json.loads(path.read_text()) if path.exists() else {}
        yield record
        temporary = path.with_suffix('.tmp')
        temporary.write_text(json.dumps(record, sort_keys=True))
        os.replace(temporary, path)


def remove(checkout):
    """Stop this checkout's own Buck2 daemon, then remove the checkout."""
    if (checkout / '.buck2/bin/buck2').exists():
        subprocess.run([str(checkout / '.buck2/bin/buck2'), 'kill'], cwd=checkout, capture_output=True)
    git('worktree', 'remove', '--force', str(checkout))


def landings(common):
    path = common / 'hirsel-landings.jsonl'
    return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []


def landed(rows, start, tip):
    """The branches and tickets of the landing rows pushed in start..tip."""
    commits = set(git('rev-list', f'{start}..{tip}').stdout.split())
    found = [row for row in rows if row.get('pushed') in commits]
    return [row['branch'] for row in found], [str(int(row['ticket'])) if 'ticket' in row else '?' for row in found]


def main():
    tip, events, unit = sys.argv[1:]
    common = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir').stdout.strip())
    checkout = common / 'land-checkouts' / f'post-{tip[:12]}'
    log = common / 'land-post' / f'{tip[:12]}.log'
    log.parent.mkdir(exist_ok=True)
    with state(common) as record:
        previous = record.get('running')
        record['running'] = dict(unit=unit, checkout=str(checkout), tip=tip)
    if previous and previous['unit'] != unit:
        # Only the post-push unit tools/land started, by its recorded name.
        subprocess.run(['systemctl', '--user', 'stop', previous['unit']], capture_output=True)
        if Path(previous['checkout']).exists():
            remove(Path(previous['checkout']))
    if checkout.exists():
        remove(checkout)
    checkout.parent.mkdir(exist_ok=True)
    with log.open('w') as output:
        added = git('worktree', 'add', '-f', '--detach', str(checkout), tip)
        if added.returncode:
            output.write(added.stderr)
            return 1
        try:
            os.chdir(checkout)
            land = runpy.run_path(str(checkout / 'tools/land'), run_name='land_post')
            environment = land['rust_environment'].environment(checkout)
            failed, code = [], 0
            for name, command in (('prepare.py', [sys.executable, 'tools/buck2/prepare.py']),
                                  ('sync.py', [sys.executable, 'tools/buck2/sync.py', '--if-stale']),
                                  ('post-push suites', [str(checkout / '.buck2/bin/buck2'), 'test', '-c', 'hirsel.full=true',
                                                        *land['POST_PUSH'], '--', '--test-arg=--test-threads=1'])):
                done = subprocess.run(command, cwd=checkout, env=environment, capture_output=True, text=True)
                output.write(done.stdout + done.stderr)
                if done.returncode:
                    code = done.returncode
                    found = land['failed_checks']([f'FAIL  {name}',
                                                   *(land['failing_targets'](done.stdout + done.stderr) or '').splitlines()])
                    failed = sorted(name.removeprefix('root') for name in found)
                    break
            output.write(f'EXIT {code}\n')
        finally:
            os.chdir(common)
            remove(checkout)
    with state(common) as record:
        if (record.get('running') or {}).get('unit') == unit:
            record.pop('running')
        # The first run's range starts at the base this tip was pushed onto.
        start = record.get('checked') or next((row['base'] for row in landings(common) if row.get('pushed') == tip), tip)
        new = [name for name in failed if name not in record.get('red', [])]
        record.update(checked=tip, red=failed)
    if new:
        branches, tickets = landed(landings(common), start, tip)
        append_event(events, 'POSTRED', dict(lane=','.join(branches), ticket=','.join(tickets),
                                             submitted=','.join(new), landed=f'{start}..{tip}'), log, code)
    return 0


if __name__ == '__main__':
    sys.exit(main())

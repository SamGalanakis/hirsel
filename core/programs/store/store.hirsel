@test
fn test_look_task(c: Clock, tasks: Tasks) -> Result[(), ()] waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, spec("look_task", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "look_task", std.codec.key_u64(), std.codec.of_u64()))
    if !typed_put(mut db, t, 1, 41) {
        return Error(())
    }
    let payload = TypedReader(held: snapshot(db), sh: shape(t))
    let reader = result.unwrap(task.spawn(tasks, bytes 1048576, take payload, fn(take p: TypedReader) -> bool {
        let seen = result.unwrap(look(p.held, None, fn(tx: Tx) -> Result[Option[u64], Error] {
            fetch(tx, p.sh, 1)
        }))
        match take seen {
            Seen(x) => match x.value {
                Ok(Some(41)) => list.len(x.reads) == 1 && x.version == version(p.held),
                _ => false
            },
            _ => false
        }
    }))
    if !typed_put(mut db, t, 1, 42) {
        return Error(())
    }
    result.unwrap(close(take db))
    if result.unwrap(task.join(take reader)) {
        Ok(())
    } else {
        Error(())
    }
}

// L23: identity checks precede the equal-empty-root shortcut. Different branches
// of one open are allowed; stores and opens are not interchangeable.
pub fn law_changes_identity(c: Clock) -> bool {
    let db = test_db(c, 1073741824)
    let a = snapshot(db)
    let other_open = Snapshot(store: a.store, open: 1, branch: 0, head: 0, roots: empty_roots())
    let other_store = Snapshot(store: StoreId(hi: 9, lo: 9), open: 0, branch: 0, head: 0, roots: empty_roots())
    let br = Snapshot(store: a.store, open: a.open, branch: 9, head: 0, roots: empty_roots())
    if !is_foreign(changes(a, other_open)) || !is_foreign(changes(a, other_store)) {
        return false
    }
    list.len(result.unwrap(changes(a, br))) == 0
}

@test
fn test_changes_identity(c: Clock) -> Result[(), ()] {
    if law_changes_identity(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn info_helper(mut tx: Tx) -> u64 {
    info(mut tx).id.version
}

// G2 positive control: run and a mut-Tx helper both have honest CallInfo.
pub fn law_info_mut(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    for _ in 0u64 .. 2 {
        let expected = db.heads[0].head + 1
        let outcome = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[bool, ()] {
            let direct = info(mut tx).id.version
            let indirect = info_helper(mut tx)
            Ok(direct == expected && indirect == expected)
        }))
        match take outcome {
            Committed(done) => if !done.value {
                return false
            },
            _ => return false
        }
    }
    true
}

@test
fn test_info_mut(c: Clock) -> Result[(), ()] waits {
    if law_info_mut(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn same_value_pair(c: Clock) -> (Snapshot, Snapshot) {
    let mut db = test_db(c, 1073741824)
    for k in 0u64 .. 96 {
        if !put_one(mut db, k, k + 1) {
            fail("same-value fixture refused")
        }
    }
    let a = snapshot(db)
    for k in 0u64 .. 96 {
        if !put_one(mut db, k, k + 1) {
            fail("same-value rewrite refused")
        }
    }
    (take a, snapshot(db))
}

// L23: k=96 writes, w=0 returned differences. Both full scans contain keys
// 0..95 and values 1..96, whose hand-derived sum is 96*97/2 = 4656.
pub fn law_changes_rewritten_equal(c: Clock) -> bool {
    let pair = same_value_pair(c)
    let (take a, take b) = take pair
    let delta = result.unwrap(changes(a, b))
    if list.len(delta) != 0 {
        return false
    }
    let mut left = result.unwrap(scan_bytes(a, 1, Unbounded, Unbounded))
    let mut right = result.unwrap(scan_bytes(b, 1, Unbounded, Unbounded))
    let mut sum: u64 = 0
    for k in 0u64 .. 96 {
        let x = option.unwrap(result.unwrap(next_bytes(mut left)))
        let y = option.unwrap(result.unwrap(next_bytes(mut right)))
        if x.0 != result.unwrap(physical(1, key_word(k))) || list.len(x.1) != 8 || decode_word(x.1) != k + 1 || x != y {
            return false
        }
        sum += decode_word(x.1)
    }
    sum == 4656 && result.unwrap(next_bytes(mut left)) == None && result.unwrap(next_bytes(mut right)) == None
}

@test
fn test_changes_rewritten_equal(c: Clock) -> Result[(), ()] {
    if law_changes_rewritten_equal(c) {
        Ok(())
    } else {
        Error(())
    }
}


pub opaque type Parked {
    id: u64,
    completion: Completion,
    record: Option[CallRecord],
    plan: Plan,
    grant: CallReserve,
    // The last attempt's context: its `at` is the call's start, raised to a
    // later branch `at`, and an untried position settles at it.
    attempted: CallInfo
}

// What a call's attempts carry from one attempt to the next.
type CallRun {
    // The queue id the call keeps once it has parked (§13.3a "Wake sources").
    id: Option[u64],
    attempts: u64,
    pins: pager.TieredPins,
    pending: Option[(format.TieredTarget, types.Failure)],
    crowded: bool
}

pub fn park_id(p: Parked) -> u64 {
    p.id
}

// The coalescing notice the pager posts after each writer answer. It is
// handed out once, as `sync_notices` is.
pub fn park_notices(mut db: Db) -> Option[Receiver[()]] {
    pager.take_park_notices(mut db.pager)
}

// Starts the pager with its writer slot and hands the Db its ends.
fn attach_tiered_pager(mut db: Db, take link: pager.TieredPagerLink) -> Task[()] {
    pager.attach_pager(mut db.pager, take link)
}

// Ends every parked call and its delivery; their positions stay Admitted.
fn clear_parked(mut db: Db) {
    pager.clear_parked(mut db.pager)
}

// Entering held mode revokes every parked call.
fn revoke_parked(mut db: Db) {
    let root = call_pin_root(db, 0)
    pager.revoke_parked(mut db.pager, root)
}

// Sends the first unsent demand in id order when no writer demand is in
// flight, and kicks the pager to look at its writer slot.
fn send_parked_demand(mut db: Db) {
    pager.send_parked_demand(mut db.pager)
}

// One level-triggered scan in id order (§13.3a "Polling"). It returns the
// ready ids in id order.
pub fn poll_parked(mut db: Db) -> Result[List[u64], Error] {
    let root = call_pin_root(db, 0)
    failure_result_from_rep(pager.poll_parked(mut db.pager, root))
}

// Removes a parked call: its delivery is detached and its pins released.
// The position is handed back untried, to conclude or drop.
pub fn cancel_parked(mut db: Db, take p: Parked) -> Pending {
    pager.cancel_parked(mut db.pager, p.id)
    let Parked(completion: take complete, record: take rec, attempted: attempted, ..) = take p
    untried(take complete, take rec, attempted)
}

// Runs a parked call's next attempt once it is ready; a call still parked
// comes back unchanged.
pub fn resume_parked[E: inert](mut db: Db, take p: Parked, env: E, body: fn(mut Tx, E) -> Result[Bytes, Bytes]) -> Result[Served, ServeError] waits {
    let Some(k) = pager.park_slot(pager.park_queue(db.pager), p.id) else {
        return Error(Before(Missing("parked"), None))
    }
    if let Error(take problem) = journal_poll(mut db) {
        let _ = pager.remove_parked(mut db.pager, k)
        return Error(Before(take problem, None))
    }
    if let Error(take problem) = healthy(db) {
        let _ = pager.remove_parked(mut db.pager, k)
        return Error(Before(take problem, None))
    }
    if !pager.park_queue(db.pager).entries[k].ready {
        return Ok(Parked(take p))
    }
    let pager.ParkEntry(attempts: attempts, pins: take pins, pending: take pending, failed: take failed, crowded: crowded, ..) = pager.remove_parked(mut db.pager, k)
    if let Some(take problem) = take failed {
        return Error(Before(failure_from_rep(take problem), None))
    }
    let Parked(id: id, completion: take complete, record: take rec, plan: plan, grant: grant, attempted: attempted) = take p
    let carry = CallRun(id: Some(id), attempts: attempts, pins: take pins, pending: take pending, crowded: crowded)
    drive_served(mut db, take complete, plan, grant, take rec, attempted.at, take carry, scoped fn(mut tx: Tx) -> Result[Bytes, Bytes] {
        body(mut tx, env)
    })
}

fn call_page_source(db: Db, source: u64) -> Result[pager.TieredPageSource, Error] {
    let pager_link: Option[View[Sender[pager.TieredPagerMessage]]] = match pager.pager_requests(db.pager) {
        Some(requests) => Some(view requests),
        None => None,
    }
    capture_page_source(pager_link, pages.holder_heads(db.holders)[0].roots.collections, pages.holder_bases(db.holders), source)
}

// Abort and rerun for serve (§13.3, §13.3a): each attempt drafts at the head
// as it is now over the call's pin map. A latched miss parks the call on
// attempts 1 and 2; from attempt 3, or once crowded, the call is held: it
// revokes every parked call and its misses are delivered inline.
fn drive_served(mut db: Db, take complete: Completion, plan: Plan, grant: CallReserve, take rec: Option[CallRecord], at: u64, take carry: CallRun, body: scoped[view] fn(mut Tx) -> Result[Bytes, Bytes]) -> Result[Served, ServeError] waits {
    let mut call = take carry
    let mut revoked = false
    loop {
        let ci = call_info(db.store, 0, pages.holder_heads(db.holders)[0].head + 1, at, pages.holder_heads(db.holders)[0].at)
        refresh_call_pins(mut call.pins, mut call.pending, call_pin_root(db, 0))
        call.attempts += 1
        let attempt = pager.call_attempt(call_captures_tiered(db, 0), pager.pin_partition(db.pager), pager.tiered_window(call.pins))
        let metered = metered_draft(db, complete, ci, plan, grant, rec, attempt, call.pins.frames, body)
        let Some(state) = pager.call_attempt_finish(take attempt) else {
            return decide_served(mut db, take complete, take rec, ci, take metered)
        }
        let refused = match state.stopped {
            None => return decide_served(mut db, take complete, take rec, ci, take metered),
            Some(AttemptPinLimit(problem)) => Cache(problem),
            Some(AttemptAllocation(problem)) => Allocation(problem),
            // The fold cut runs before the rerun and does not count as an attempt.
            Some(AttemptFold(_)) => match cut_install(mut db, NoHolderChange) {
                Ok(_) => {
                    call.attempts -= 1
                    continue
                },
                Error(Full(problem)) => problem,
                Error(take problem) => return Error(Before(take problem, None)),
            },
            Some(AttemptMiss(_)) => {
                let source = serve_before(call_page_source(db, state.miss_source))?
                let root = call_pin_root(db, 0)
                let room = pager.reserve_parked(mut db.pager)
                if call.attempts >= 3 || call.crowded || !room {
                    if !revoked {
                        revoke_parked(mut db)
                        call.pins.partition = pager.pin_partition(db.pager)
                        revoked = true
                    }
                    let SeekKey(sought) = view state.seek else {
                        fail("store: a call's miss has no seek key")
                    }
                    serve_before(failure_result_from_rep(object_writer.serve_tiered_miss(source, root, state, sought, TieredPoint, None, mut call.pins, mut call.pending)))?
                    continue
                }
                let demand = {
                    let SeekKey(sought) = view state.seek else {
                        fail("store: a call's miss has no seek key")
                    }
                    serve_before(failure_result_from_rep(pager.tiered_miss_demand(source, state, sought, TieredPoint, None, mut call.pending)))?
                }
                let pager.TieredTouchSet(stamps: take stamps, ..) = take state
                let CallRun(id: kept, attempts: attempts, pins: take pins, pending: take pending, crowded: crowded) = take call
                let id = pager.enqueue_parked(mut db.pager, kept, attempts, take pins, take stamps, take demand, take pending, crowded)
                send_parked_demand(mut db)
                return Ok(Parked(Parked(id: id, completion: take complete, record: take rec, plan: plan, grant: grant, attempted: ci)))
            },
        }
        let unchanged = pages.holder_next_node(db.holders)
        return decide_served(mut db, take complete, take rec, ci, Ok(DraftedCall(stage: Over(Refused(refused)), next_id: unchanged)))
    }
}

// The deciding attempt's draft, settled as `serve` settles it.
fn decide_served(mut db: Db, take complete: Completion, take rec: Option[CallRecord], ci: CallInfo, take metered: Result[DraftedCall, DraftRefusal]) -> Result[Served, ServeError] waits {
    let DraftedCall(stage: take draft, next_id: next_id) = match take metered {
        Error(AdmissionBytes(problem)) => return Error(Before(Full(Allocation(problem)), None)),
        Error(DraftStopped(take stop)) => return Ok(stopped_pending(untried(take complete, take rec, ci), take stop)),
        Ok(take draft) => take draft,
    }
    pages.set_next_node(mut db.holders, next_id)
    let pending_run = Pending(completion: take complete, record: take rec, attempted: ci, stop: None)
    match take draft {
        Ran(take staged) => finish_served(mut db, take pending_run, take staged, false),
        DraftError(take problem) => Error(Before(take problem, None)),
        DriftStop(take name, take seen) => {
            serve_before(trip_drift(mut db, 0, take seen))?
            Error(Before(Drift(take name), None))
        },
        Over(Stopped(limit)) => Ok(stopped_pending(take pending_run, OutOfSteps(limit.steps))),
        Over(Failed(Raised(causes))) => Ok(stopped_pending(take pending_run, Raised(cause_number(causes)))),
        Over(Failed(Conflict(take name))) => Ok(stopped_pending(take pending_run, Conflict(take name))),
        Over(Refused(Allocation(problem))) => Ok(stopped_pending(take pending_run, OutOfBytes(problem))),
        Over(Refused(take problem)) => Ok(NoRoom(take pending_run, take problem)),
        Over(Aborted(Undone(value: BodyStop(take stop), ..))) => Ok(stopped_pending(take pending_run, take stop)),
        Over(Aborted(Undone(value: StoreFailure(take problem), ..))) => Error(Before(take problem, None)),
        _ => fail("store: missing staged reply"),
    }
}

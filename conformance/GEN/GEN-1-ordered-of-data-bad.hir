// twin: PROV/PROV-2-produced-brand-run.hir
// A token ordered within its owner's domain has no domain-free equality, so it
// cannot also declare `data` (whose `==` would launder through `[T: data]`).
pub opaque type D: copyable + plain + inert + data + ordered of uses {} {
  n: u64,
}

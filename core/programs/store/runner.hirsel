// Module runner (package store): the entries of a place (RUNNER-SPEC v2.10).
// Room and Bad mirror Capacity and DecodeError, which are not codec (OWN-4).
pub type Room: codec + send { requested: u64, available: u64 }

pub type Bad: codec + send { kind: u32, at: u64 }

pub type Kind: codec + send = Compute | Transact | Query | Granted

pub type Refusal: codec + send = NoEntry | Malformed(Bad) | Overloaded | Deadline | Budget(Room) | NotAllowed | RequestMismatch | HistoryUnavailable

pub type Fault: codec + send = Raised(u32) | OutOfBytes(Room) | OutOfTime(u64) | Gone

pub type Outcome: codec + send = Returned(Bytes) | Failed(Fault) | Refused(Refusal) | Abandoned | InDoubt

pub type Described: codec + send { kind: Kind, identity: Bytes, args: Bytes, result: Bytes }

// WIRE-SPEC v2 §3. Declared variant order fixes the u32 wire tags, Hello 0 to Reset 8.
pub type Want: codec + send { identity: Bytes, args_fp: u64, result_fp: u64 }

pub type Entry: codec + send = Ready(u32) | Resolve(u32, Bytes) | Gone

pub type Done: codec + send { stream: u32, p: u64, outcome: Outcome }

// key is the data-tree key (table id and key-codec integers big-endian). value is
// the current value codec's bytes, without a stored schema prefix; None removes it.
pub type Row: codec + send { sub: u32, key: Bytes, value: Option[Bytes] }

pub type Frame: codec + send = Hello(Option[Bytes], List[Want]) | Call(u32, u64, u32, u32, Bytes) | Subscribe(u32, u32, Bytes, Option[Bytes]) | Unsubscribe(u32) | Welcome(Bytes, u32, u64, Bytes, String, u64) | Placed(Entry) | Batch(u64, List[u32], List[Row], List[Done]) | Ended(u32, Outcome) | Reset(u64, List[Done])

pub type RegisterError: send = Full(Capacity) | AlreadyRegistered(Bytes) | Bounds

pub const DEFAULT_STEPS: u64 = 1 << 30

pub type Caller = store.Caller
pub const SUBJECT_MAX: u64 = 64u64

pub fn caller_key(c: Caller, mut out: Bytes) -> Result[(), Capacity] {
    let n = list.len(c.subject)
    if n > SUBJECT_MAX { return Error(Capacity(requested: n, available: SUBJECT_MAX)) }
    list.reserve(mut out, n + 2u64)?
    let _ = list.push(mut out, c.issuer)
    let _ = list.push(mut out, int.narrow(n))
    list.append(mut out, c.subject)
}

pub fn stream_key(c: Caller, number: u32) -> Result[Bytes, Capacity] {
    let mut stream: Bytes = list.with_capacity(list.len(c.subject) + 6u64)?
    caller_key(c, mut stream)?
    std.codec.encode_key(std.codec.key_u32(), number, mut stream)?
    Ok(take stream)
}

pub type FoundActivation: send = Empty | Legacy | Active(u64, Bytes)
pub type Selection: send = Current(u64) | Install
pub type OpenError: send = Store(store.Error) | Place(RegisterError) | Migrate(store.Error) | NotCurrent(FoundActivation) | IdentityUnknown | PublisherStopped

pub type Step: send = Recovering | Activating | Publishing | Listening(Addr)
pub type Phase: send = Starting(Step) | Ready | Draining
pub type Status: shareable + send { phase: Phase, digest: Bytes, target: String, n_place: u64, release: Bytes, addr: Option[Addr] }
pub type Stop: codec + send { lag_ms: u64, grace_ms: u64 }
pub type Backing: send = Memory | Disk(Dir, store.Options) | Temp(Dir)
pub type PlaceConfig[G: send, H: send, S: send]: send {
    backing: Backing, selection: Selection, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64,
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    session: WireConfig, max_sessions: u64, proxies: List[std.wsock.Prefix], policy: ingress.Ingress, n_publisher: u64,
    listen: Addr, net: Net, tasks: Tasks, clock: Clock, random: Random, stop: Stop,
    triggers: Option[TriggerConfig[G, S]],
}
// Grants are made per attempt. The context routes place calls back to the
// same head and carries the attempt fence.
pub type TriggerConfig[G: send, S: send]: send {
    entries: triggers.Entries,
    author: Caller,
    grants: S,
    grant: fn(S, take TriggerContext) -> Result[G, Capacity] waits,
    grant_bytes: u64,
}

pub opaque type TriggerContext: send {
    attempt: triggers.Attempt,
    to: Sender[HeadInput]
}

pub type StartError: send = Open(OpenError) | Listen(NetError) | Missing(String) | Full(Capacity)
pub type Ended: codec + send = Stopped | Forced(u64)

// Private runtime-supplied launch metadata. The body is a declaration placeholder;
// the call is lowered to the immutable launch transport on every engine.
fn launch_word(field: u64, index: u64) -> u64 { 0u64 }

fn launch_digest() -> Result[Bytes, Capacity] {
    let len = launch_word(1u64, 0u64)
    let mut digest: Bytes = list.with_capacity(len)?
    for i in 0u64..len {
        result.unwrap(list.push(mut digest, int.narrow(launch_word(2u64, i))))
    }
    Ok(take digest)
}

fn launch_text(a: Args) -> View[String] in a { "" }

fn launch_target(a: Args) -> Result[String, Capacity] {
    string.from(launch_text(a))
}

fn launch_owned_target() -> Result[String, Capacity] {
    let count = launch_word(3u64, 0u64)
    let mut text_bytes: Bytes = list.with_capacity(count)?
    for index in 0u64 .. count {
        result.unwrap(list.push(mut text_bytes, int.narrow(launch_word(4u64, index))))
    }
    Ok(result.unwrap(string.from_utf8(take text_bytes)))
}

pub fn status_root() -> Result[Latest[Status], Capacity] {
    let initial = Status(phase: Starting(Recovering), digest: launch_digest()?, target: launch_owned_target()?, n_place: launch_word(0u64, 0u64), release: list.new(), addr: None)
    let shared = result.capacity_only(arc.new(take initial))?
    result.capacity_only(latest.new(take shared))
}

type IncomingStop: send { from: Receiver[()], to: Sender[LifeEvent] }

fn watch_stop(take seed: IncomingStop) -> () waits {
    let _ = channel.receive(seed.from)
    let _ = channel.send(seed.to, StopRequested)
}

type DrainTimer: send { to: Sender[LifeEvent], clock: Clock, window: DrainWindow }

fn drain_timer(take alarm: DrainTimer) -> () waits {
    host.sleep_until(alarm.clock, alarm.window.admission)
    let _ = channel.send(alarm.to, AdmissionClose)
    host.sleep_until(alarm.clock, alarm.window.deadline)
    let _ = channel.send(alarm.to, DrainExpired)
}

resource type TemporaryBacking { dir: Dir, name: String } drop(temporary) {
    if list.len(string.as_bytes(temporary.name)) != 0u64 { let _ = std.dir.remove_all(temporary.dir, temporary.name) }
}

fn publish_phase(status: Latest[Status], watch: Option[Sender[Phase]], mut current: Status, phase: Phase) -> Result[(), StartError] {
    current.phase = phase
    let copied: Result[Status, Capacity] = clone(current)
    let value = match take copied { Ok(take next) => take next, Error(cap) => return Error(Full(cap)) }
    let shared = match arc.new(take value) { Ok(take shared) => take shared, Error((cap, _)) => return Error(Full(cap)) }
    latest.publish(status, take shared)
    if let Some(to) = watch { let _ = channel.try_send(to, phase) }
    Ok(())
}

fn copy_status(value: Status) -> Result[Status, Capacity] { clone(value) }

fn status_watch(take watch: Option[Sender[Receiver[Phase]]]) -> Result[Option[Sender[Phase]], StartError] {
    match take watch {
        Some(take handoff) => {
            let made: Result[(Sender[Phase], Receiver[Phase]), Capacity] = channel.new(6u64)
            let (to, from) = match take made { Ok(take pair) => take pair, Error(cap) => return Error(Full(cap)) }
            if let Error(_) = channel.try_send(handoff, take from) { return Ok(None) }
            Ok(Some(take to))
        },
        None => Ok(None),
    }
}

fn serve_inbox_capacity(limit: u64) -> u64 { int.saturating_add(int.saturating_mul(limit, 2u64), 22u64) }

fn start_drain(stop: Stop, started: u64, clock: Clock, tasks: Tasks, events: Sender[LifeEvent], root: Latest[Option[DrainWindow]]) -> Result[Task[()], StartError] {
    let deadline = std.clock.deadline_after_ms(started, stop.grace_ms)
    let admission = std.clock.deadline_after_ms(started, if stop.lag_ms < stop.grace_ms { stop.lag_ms } else { stop.grace_ms })
    let window = DrainWindow(admission: admission, deadline: deadline)
    let wanted: Option[DrainWindow] = Some(window)
    let shared = match arc.new(take wanted) { Ok(take value) => take value, Error((cap, _)) => return Error(Full(cap)) }
    latest.publish(root, take shared)
    let alarm = DrainTimer(to: channel.sender(events), clock: clock, window: window)
    match task.spawn(tasks, bytes 4096u64, take alarm, drain_timer) { Ok(take alarm_task) => Ok(take alarm_task), Error((cap, _)) => Error(Full(cap)) }
}

fn head_bytes(backing: Backing, n_place: u64, n_publisher: u64) -> u64 {
    let options = match backing { Disk(_, options) => options, _ => store.defaults() }
    let mut total = int.saturating_add(options.resident_limit, int.saturating_add(n_place, n_publisher))
    let on_disk = match backing { Memory => false, _ => true }
    if on_disk {
        let journal: u64 = int.widen(options.group_bytes)
        total = int.saturating_add(total, options.checkpoint_task_bytes)
        total = int.saturating_add(total, if journal > 16777296u64 { journal } else { 16777296u64 })
    }
    int.saturating_add(total, 2097152u64)
}

pub fn operate[G: send, H: send, S: send](take p: PlaceConfig[G, H, S], take stop: Receiver[()], status: Latest[Status], take watching: Option[Sender[Receiver[Phase]]]) -> Result[Ended, StartError] waits {
    if p.stop.grace_ms == 0u64 { return Error(Missing("grace_ms")) }
    if p.max_sessions == 0u64 || !wire_configuration(p.session) { return Error(Missing("session")) }
    let PlaceConfig(backing: take backing, selection: selection, place: place, migrate: migrate, handles: handles, n_place: n_place, n_publisher: n_publisher,
        session: session_config, max_sessions: limit, proxies: take proxies, policy: take access_gate,
        listen: listen, net: net, tasks: tasks, clock: clock, random: random, stop: stop_config, triggers: take trigger_config) = take p
    if limit == 0u64 || limit > WIRE_OWNER_LIMIT || !wire_configuration(session_config) { return Error(Missing("socket")) }
    let watch = status_watch(take watching)?
    let mut current = match copy_status(latest.read(status)) { Ok(take held) => take held, Error(cap) => return Error(Full(cap)) }
    publish_phase(status, watch, mut current, Starting(Recovering))?
    let life: Result[(Sender[LifeEvent], Receiver[LifeEvent]), Capacity] = channel.new(12u64)
    let (to, inbox) = match take life { Ok(take pair) => take pair, Error(cap) => return Error(Full(cap)) }
    let head_mail: Result[(Sender[HeadInput], Receiver[HeadInput]), Capacity] = channel.new(64u64)
    let (head_to, inbox_head) = match take head_mail { Ok(take pair) => take pair, Error(cap) => return Error(Full(cap)) }
    let finish_mail: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
    let (finish_to, finish_from) = match take finish_mail { Ok(take pair) => take pair, Error(cap) => return Error(Full(cap)) }
    let serving_total = match serving_bytes(session_config, limit) { Ok(total) => total, Error(cap) => return Error(Full(cap)) }
    let serve_slots = serve_inbox_capacity(limit)
    // The supervisor allocates this channel before the serving task starts.
    // OwnerReady has the largest message: its tag, id and two senders cost 64 B.
    let serving_reserve = serving_total - (64u64 + serve_slots * 64u64)
    let serve_mail: Result[(Sender[ServeInput], Receiver[ServeInput]), Capacity] = channel.new(serve_slots)
    let (serve_to, inbox_serve) = match take serve_mail { Ok(take pair) => take pair, Error(cap) => return Error(Full(cap)) }
    let initial: Option[DrainWindow] = None
    let root = match arc.new(initial) { Ok(take root) => take root, Error((cap, _)) => return Error(Full(cap)) }
    let drain = match latest.new(take root) { Ok(take drain) => take drain, Error((cap, _)) => return Error(Full(cap)) }
    let stopping: Option[Task[()]] = match channel.try_receive(stop) {
        Error(Empty) => {
            let incoming = IncomingStop(from: take stop, to: channel.sender(to))
            match task.spawn(tasks, bytes 4096u64, take incoming, watch_stop) { Ok(take task_handle) => Some(take task_handle), Error((cap, _)) => return Error(Full(cap)) }
        },
        _ => { let _ = channel.try_send(to, StopRequested); None },
    }
    let triggering: Option[(TriggerConfig[G, S], Sender[HeadInput])] = match take trigger_config {
        Some(take config) => {
            if triggers.is_empty(config.entries) { None } else { Some((take config, channel.sender(head_to))) }
        },
        None => None,
    }
    let grant_bytes = match triggering { Some((config, _)) => config.grant_bytes, None => 0u64 }
    let allowance = int.saturating_add(head_bytes(backing, n_place, n_publisher), grant_bytes)
    let head_job = ManagedHead(backing: take backing, selection: selection, tasks: tasks, clock: clock, random: random, place: place, migrate: migrate, handles: handles,
        n_place: n_place, n_publisher: n_publisher, inbox: take inbox_head, finish_from: take finish_from, to: channel.sender(to), drain: latest.handle(drain),
        triggering: take triggering)
    let head_run: fn(take ManagedHead[G, H, S]) -> () waits = head_ended
    let mut heading: Option[Task[()]] = match task.spawn(tasks, bytes allowance, take head_job, head_run) {
        Ok(take handle) => Some(take handle), Error((cap, _)) => return Error(Full(cap)),
    }
    let mut serving: Option[Task[()]] = None
    let mut drain_waiter: Option[Task[()]] = None
    let mut ready: Option[(Listener, Sender[PubIn])] = None
    let mut unused_listener_inputs = Some((take proxies, take access_gate, take inbox_serve))
    let mut stopped = false
    let mut online = false
    let mut expired = false
    let mut settled = false
    let mut serve_done: Option[u64] = None
    let mut head_done = false
    let mut finishing = false
    let mut start_failure: Option[StartError] = None
    loop {
        if !expired && stopped {
            if let Some(window) = drain_window(latest.read(drain)) {
                if host.mono_ns(clock) >= window.deadline {
                    expired = true
                    let _ = channel.try_send(serve_to, ServeWake)
                }
            }
        }
        if expired && (match serving { None => true, _ => false }) {
            if let Some(take handle) = replace(mut heading, None) {
                let mut active_head = take handle
                task.cancel(mut active_head)
                let _ = task.join(take active_head)
            }
            return Ok(Forced(match serve_done { Some(count) => count, None => 0u64 }))
        } else if !expired && head_done {
            if let Some(take problem) = replace(mut start_failure, None) { return Error(take problem) }
            return Ok(Stopped)
        } else if !expired && settled && !finishing {
            if let Some(_) = serve_done {
                let _ = channel.try_send(finish_to, ())
                let _ = channel.try_send(head_to, HeadFinish)
                finishing = true
            }
        }
        let next = match channel.try_receive(inbox) { Ok(take event) => Some(take event), _ => None }
        let event = match take next {
            Some(take event) => take event,
            None => {
                if let Some((take listener, take pub_to)) = replace(mut ready, None) {
                    let (take addresses, take ingress_policy, take from_serve) = option.unwrap(replace(mut unused_listener_inputs, None))
                    let target = match string.from(current.target) { Ok(take name) => take name, Error(cap) => return Error(Full(cap)) }
                    let serving_config = ServePlace(listener: take listener, config: session_config, tasks: tasks, clock: clock, policy: take ingress_policy,
                        max_sessions: limit, proxies: take addresses, target: take target, publisher: take pub_to, place: place,
                        head: channel.sender(head_to), inbox: take from_serve, to: channel.sender(serve_to), events: channel.sender(to), drain: latest.handle(drain))
                    let run: fn(take ServePlace[G, H]) -> () waits = run_serve_place
                    serving = match task.spawn(tasks, bytes serving_reserve, take serving_config, run) {
                        Ok(take handle) => Some(take handle), Error((cap, _)) => { start_failure = Some(Full(cap)); let _ = channel.try_send(head_to, HeadClose); continue },
                    }
                }
                match channel.receive(inbox) { Ok(take incoming_event) => take incoming_event, Error(_) => return Ok(Stopped) }
            },
        }
        match take event {
            StopRequested => {
                let started = host.mono_ns(clock)
                stopped = true
                drain_waiter = Some(start_drain(stop_config, started, clock, tasks, to, drain)?)
                publish_phase(status, watch, mut current, Draining)?
                if let Some(_) = replace(mut ready, None) { let _ = channel.try_send(head_to, HeadClose) }
                if !online { let _ = channel.try_send(serve_to, ServeWake) }
            },
            Recovered => if stopped { let _ = channel.try_send(head_to, HeadClose) } else {
                publish_phase(status, watch, mut current, Starting(Activating))?
                let _ = channel.try_send(head_to, HeadContinue)
            },
            Activated(take release) => {
                current.release = take release
                if stopped { let _ = channel.try_send(head_to, HeadClose) } else {
                    publish_phase(status, watch, mut current, Starting(Publishing))?
                    let _ = channel.try_send(head_to, HeadContinue)
                }
            },
            Published(take pub_to) => if stopped { let _ = channel.try_send(head_to, HeadClose) } else {
                match host.listen(net, listen, 128u16) {
                    Ok((take listener, address)) => {
                        current.addr = Some(address)
                        publish_phase(status, watch, mut current, Starting(Listening(address)))?
                        ready = Some((take listener, take pub_to))
                    },
                    Error(problem) => { start_failure = Some(Listen(problem)); let _ = channel.try_send(head_to, HeadClose) },
                }
            },
            ServePrepared => {
                if stopped {
                    let _ = channel.try_send(serve_to, ServeWake)
                    let _ = channel.try_send(head_to, HeadClose)
                } else {
                    publish_phase(status, watch, mut current, Ready)?
                    online = true
                    let _ = channel.try_send(head_to, HeadContinue)
                    let _ = channel.try_send(serve_to, ServeStart)
                }
            },
            AdmissionClose => {
                if let Some(_) = serving { let _ = channel.try_send(head_to, HeadClose); let _ = channel.try_send(serve_to, ServeWake) }
            },
            DrainExpired => {
                expired = true
                let _ = channel.try_send(serve_to, ServeWake)
            },
            Settled => { settled = true },
            HeadEnded(take ending) => {
                if let Some(take handle) = replace(mut heading, None) { let _ = task.join(take handle) }
                head_done = true
                if let Error(take problem) = take ending {
                    if !stopped || online {
                        if let None = start_failure { start_failure = Some(take problem) }
                    }
                }
            },
            ServeEnded(take ending) => {
                if let Some(take handle) = replace(mut serving, None) { let _ = task.join(take handle) }
                match take ending {
                    Ok(count) => { serve_done = Some(count) },
                    Error(take problem) => if online { return Error(take problem) } else {
                        start_failure = Some(take problem)
                        let _ = channel.try_send(head_to, HeadClose)
                    },
                }
            },
        }
    }
}

// One erased adapter per kind, holding the entry's byte bound n from registration
// (RUNNER-SPEC v2.4 §1.1). A compute slot runs in the caller's task; a granted slot
// starts a task under `bytes n` that holds the grant. A transact slot has two: the
// session's check (rule 5: decode the argument, keep nothing) and the head's run, with the
// entry's step bound and its code.revision, which each call record carries (R5, §7).
type Slot[G: send, H: send]: send = Compute(own[send] fn(Bytes) -> Outcome) | Granted(own[send] fn(Tasks, take JobGrant[G], take Bytes, take Option[TriggerReport]) -> Result[Task[Outcome], Capacity]) | Transact(u64, u64, Option[Bytes], own[send] fn(Bytes) -> Option[Refusal], own[send] fn(mut store.Tx, H, Caller, Bytes) -> Ran) | Query(u64, u64, own[send] fn(store.Snapshot, H, Bytes, store.Snapshot, Option[View[Cover]], u32, Log[Row]) -> Queried) | Fenced(u64, u64, own[send] fn(mut store.Tx, triggers.Attempt, Bytes) -> Result[Bytes, store.Error])

pub opaque type Registry[G: send, H: send]: send {
    slots: Map[Bytes, Slot[G, H]],
    exported: List[Exported],
    checks: Map[Bytes, own[send] fn(Bytes) -> Option[Refusal]],
    gone: Map[Bytes, ()]
}

pub fn registry[G: send, H: send]() -> Registry[G, H] {
    Registry(slots: map.new(), exported: list.new(), checks: map.new(), gone: map.new())
}

fn check_call_reserve(n_e: u64, s_e: u64) -> Result[(), RegisterError] {
    let plan = store.Plan(n_e: n_e, s_e: s_e, reply_max: MAX_RETURNED_BYTES + 8u64)
    match store.call_reserves(plan) { Some(_) => Ok(()), None => Error(Bounds) }
}

fn room(c: Capacity) -> Room {
    Room(requested: c.requested, available: c.available)
}

// RUNNER-SPEC §1.1's fixed Bad.kind table.
fn bad(e: std.codec.DecodeError) -> Bad {
    match e {
        Truncated(at) => Bad(kind: 0u32, at: at),
        Invalid(at) => Bad(kind: 1u32, at: at),
        Utf8(at) => Bad(kind: 2u32, at: at),
        Duplicate(at) => Bad(kind: 3u32, at: at),
        Trailing(at) => Bad(kind: 4u32, at: at),
        Schema(at) => Bad(kind: 5u32, at: at),
        Value(at) => Bad(kind: 6u32, at: at),
    }
}

// RUNNER-SPEC v2.10 §1.1: fixed wire kinds, independent of core ordinals.
fn raised(cs: Causes) -> u32 {
    for c in cs {
        return match c.kind {
            Overflow => 1u32,
            Bounds => 2u32,
            Division => 3u32,
            Unwrap => 4u32,
            Fail(_) => 5u32,
            Cancelled => 6u32,
            Capacity => 7u32,
            OutOfTime => 8u32,
            Tape => 9u32,
        }
    }
    0u32
}

type DecodeFail { e: std.codec.DecodeError }

fn encoded[R](cr: std.codec.Codec[R], r: R) -> Outcome {
    let mut out: Bytes = list.new()
    match std.codec.encode(cr, r, mut out) {
        Ok(()) => limited_reply(take out),
        Error(c) => Failed(OutOfBytes(room(c))),
    }
}

// The compute adapter: decode A, call f and encode R, all inside `bound bytes n` and
// `isolate`. A budget the place cannot grant is Refused(Budget); exhaustion after entry
// is Failed(OutOfBytes); a fault is Failed(Raised).
fn adapt_compute[A, R](f: StaticFn[fn(take A) -> Result[R, Capacity]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], arg: Bytes, n: u64, s: u64) -> Outcome {
    let body = code.callable(f)
    let ran = bound bytes n {
        let run = scoped fn() -> Result[Result[Outcome, DecodeFail], OutOfTime] {
            bound steps s {
            match std.codec.decode(ca, arg) {
                Ok(Ok(take a)) => match body(take a) {
                    Ok(take r) => Ok(encoded(cr, r)),
                    Error(c) => Ok(Failed(OutOfBytes(room(c)))),
                },
                Ok(Error(e)) => Error(DecodeFail(e: e)),
                Error(c) => Ok(Failed(OutOfBytes(room(c)))),
            }
            }
        }
        isolate(run)
    }
    match take ran {
        Ok(Ok(Ok(Ok(Ok(take o))))) => take o,
        Ok(Ok(Ok(Ok(Error(d))))) => Refused(Malformed(bad(d.e))),
        Ok(Ok(Ok(Error(e)))) => Failed(OutOfTime(e.steps)),
        Ok(Ok(Error(cs))) => Failed(Raised(raised(cs))),
        Ok(Error(c)) => Failed(OutOfBytes(room(c))),
        Error(c) => Refused(Budget(room(c))),
    }
}

type JobGrant[G: send]: send = Direct(G) | FromPlace(Sender[GrantRequest[G]], TriggerContext)

type Job[G: send, A, R]: send {
    f: StaticFn[fn(G, take A) -> Result[R, Capacity] waits],
    ca: std.codec.Codec[A],
    cr: std.codec.Codec[R],
    grant: JobGrant[G],
    arg: Bytes,
    steps: u64
}

// The granted adapter, the body of the task `start` spawns under `bytes n`.
fn adapt_granted[G: send, A, R](take j: Job[G, A, R]) -> Outcome waits {
    let allowance = j.steps
    let ran = bound steps allowance {
        let Job(f: f, ca: ca, cr: cr, grant: take source, arg: take arg, steps: _) = take j
        let grants = match take source {
            Direct(take value) => take value,
            FromPlace(to, take ctx) => match attempt_grants(to, take ctx) {
                Ok(take value) => take value,
                Error(take outcome) => return take outcome,
            },
        }
        let body = code.callable(f)
        match std.codec.decode(ca, arg) {
            Ok(Ok(take a)) => match body(grants, take a) {
                Ok(take r) => encoded(cr, r),
                Error(c) => Failed(OutOfBytes(room(c))),
            },
            Ok(Error(e)) => Refused(Malformed(bad(e))),
            Error(c) => Failed(OutOfBytes(room(c))),
        }
    }
    match take ran { Ok(take o) => take o, Error(e) => Failed(OutOfTime(e.steps)) }
}

// Key = identity ++ fingerprint(A) ++ fingerprint(reply), each fingerprint u64 little-endian.
// The reply is the type the Returned bytes carry: Result[R, E] for transact, R for compute
// and granted (RUNNER-SPEC v2.11.2), so a change to E alone changes the Key.
fn described[A, R](identity: View[Bytes], revision: Option[View[Bytes]], kind: Kind, ca: std.codec.Codec[A], cr: std.codec.Codec[R]) -> Result[(Bytes, Exported), Capacity] {
    let args = std.codec.schema(ca)?
    let result = std.codec.schema(cr)?
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)?
    list.append(mut key, identity)?
    let args_fp = std.codec.fingerprint_of(args)
    let result_fp = std.codec.fingerprint_of(result)
    std.codec.put_u64(args_fp, mut key)?
    std.codec.put_u64(result_fp, mut key)?
    let mut id: Bytes = list.with_capacity(list.len(identity))?
    list.append(mut id, identity)?
    let mut rev: Bytes = list.new()
    if let Some(digest) = revision { list.append(mut rev, digest)? }
    let d = Described(kind: kind, identity: take id, args: take args, result: take result)
    Ok((take key, Exported(described: take d, args_fp: args_fp, result_fp: result_fp, revision: take rev)))
}

// The one insertion: a key already present is refused and the registry is unchanged.
fn insert[G: send, H: send](mut r: Registry[G, H], take key: Bytes, take d: Exported, take s: Slot[G, H]) -> Result[(), RegisterError] {
    if map.contains(r.slots, key) {
        return Error(AlreadyRegistered(take key))
    }
    match list.reserve(mut r.exported, 1u64) {
        Ok(()) => (),
        Error(c) => return Error(Full(c)),
    }
    match map.insert(mut r.slots, take key, take s) {
        Ok(()) => (),
        Error((c, _)) => return Error(Full(c)),
    }
    match list.push(mut r.exported, take d) {
        Ok(()) => Ok(()),
        Error((c, _)) => Error(Full(c)),
    }
}

pub fn compute[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(take A) -> Result[R, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Compute, ca, cr) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(arg: Bytes) -> Outcome { adapt_compute(f, ca, cr, arg, n, s) }
    match made {
        Ok(take run) => insert(mut r, take key, take d, Compute(take run)),
        Error((c, _)) => Error(Full(c)),
    }
}

pub fn granted[G: send, H: send, A: codec, R: codec](mut r: Registry[G, H], f: StaticFn[fn(G, take A) -> Result[R, Capacity] waits], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Granted, ca, cr) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(tasks: Tasks, take g: JobGrant[G], take arg: Bytes, take notice: Option[TriggerReport]) -> Result[Task[Outcome], Capacity] {
        let j = Job(f: f, ca: ca, cr: cr, grant: take g, arg: take arg, steps: s)
        if let Some(take report) = take notice {
            let watched = WatchedJob(job: take j, report: take report, tasks: tasks, allowance: n)
            return match task.spawn(tasks, bytes int.saturating_add(n, 4096u64), take watched, watch_trigger) {
                Ok(take t) => Ok(take t),
                Error((c, _)) => Error(c),
            }
        }
        match task.spawn(tasks, bytes n, take j, adapt_granted) {
            Ok(take t) => Ok(take t),
            Error((c, _)) => Error(c),
        }
    }
    match made {
        Ok(take go) => insert(mut r, take key, take d, Granted(take go)),
        Error((c, _)) => Error(Full(c)),
    }
}

// The export list in registration order: the codec of List[Described].
pub fn describe[G: send, H: send](r: Registry[G, H], mut out: Bytes) -> Result[(), Capacity] {
    let c: std.codec.Codec[Described] = std.codec.of()
    let count = list.len(r.exported)
    if count > 0xffffffffu64 { return Error(Capacity(requested: count, available: 0xffffffffu64)) }
    std.codec.put_u32(int.truncate(count), mut out)?
    for entry in r.exported { std.codec.put_with(entry.described, c, mut out)? }
    Ok(())
}

pub type Exported: codec + send { described: Described, args_fp: u64, result_fp: u64, revision: Bytes }

pub fn release_digest(exported: List[Exported]) -> Result[Bytes, Capacity] {
    let codec: std.codec.Codec[List[Exported]] = std.codec.of_list()
    let mut payload: Bytes = list.new()
    std.codec.encode(codec, exported, mut payload)?
    let mut hash = std.sha256.start()
    let domain = string.as_bytes("hirsel.release.v1")
    std.sha256.add_byte(mut hash, int.truncate(list.len(domain)))
    std.sha256.add(mut hash, domain, 0u64, list.len(domain))
    std.sha256.add(mut hash, payload, 0u64, list.len(payload))
    let digest = std.sha256.finish(hash)
    let mut out: Bytes = list.with_capacity(32u64)?
    for index in 0u64 .. 32u64 {
        result.unwrap(list.push(mut out, digest[index]))
    }
    Ok(take out)
}

pub type Describe: codec + send { digest: Bytes, target: String, n_place: u64, exported: List[Exported] }

pub type DescribeError: codec + send = PlaceCapacity(Room) | AlreadyRegistered(Bytes) | Bounds

fn launch_emit(data: Bytes) -> bool { false }

fn encode_describe(description: Describe) -> Result[Bytes, Capacity] {
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let mut out: Bytes = list.new()
    std.codec.encode(codec, description, mut out)?
    Ok(take out)
}

fn describe_registered[G: send, H: send](a: Args, take r: Registry[G, H]) -> Result[Bytes, Capacity] {
    let Registry(exported: take exported, ..) = take r
    encode_describe(Describe(digest: launch_digest()?, target: launch_target(a)?, n_place: launch_word(0u64, 0u64), exported: take exported))
}

pub type ReleaseRecord: codec + send { release: Bytes, digest: Bytes }

fn current_description(db: store.Db) -> Result[Option[Bytes], store.Error] {
    match store.system_table(db, "hirsel.runner.activation", std.codec.key_u8(), std.codec.of_bytes()) {
        Ok(take table) => store.get(store.snapshot(db), store.shape(table), 0u8),
        Error(Missing(_)) => Ok(None),
        Error(take problem) => Error(take problem),
    }
}

pub fn activation_version(db: store.Db) -> Result[u64, store.Error] {
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    let table = store.system_table(db, "hirsel.runner.releases", std.codec.key_u64(), codec)?
    let mut rows = store.scan(store.snapshot(db), store.shape(table), Unbounded, Unbounded)?
    let mut latest: u64 = 0
    while let Some((version, _)) = store.next(mut rows)? { latest = version }
    if latest == 0u64 { return Error(Missing("activation version")) }
    Ok(latest)
}

// Keep these options in Args so they are also present during Run tape replay.
pub fn launch_selection(a: Args) -> Result[Selection, Exit] {
    let mut selected: Option[Selection] = None
    for i in 0u64 .. args.len(a) {
        let name = option.unwrap(args.get(a, i))
        let choice = if name == "--hirsel-install" {
            Install
        } else if let Some(value) = std.string.strip_prefix(name, "--hirsel-activation=") {
            let version: Result[u64, ParseError] = int.parse(value)
            let Ok(v) = version else { return Error(Exit(status: 1u8)) }
            Current(v)
        } else {
            continue
        }
        if let Some(_) = selected { return Error(Exit(status: 1u8)) }
        selected = Some(choice)
    }
    Ok(match selected { Some(choice) => choice, None => Current(0u64) })
}

fn prepare_activation[G: send, H: send](r: Registry[G, H], n_place: u64) -> Result[(Bytes, ReleaseRecord), Capacity] {
    let release = release_digest(r.exported)?
    let description = Describe(digest: launch_digest()?, target: launch_owned_target()?, n_place: n_place, exported: clone(r.exported)?)
    let payload = encode_describe(description)?
    let Describe(digest: take digest, ..) = take description
    Ok((take payload, ReleaseRecord(release: take release, digest: take digest)))
}

fn describe_response[G: send, H: send](a: Args, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]]) -> Result[Bytes, RegisterError] {
    let run = code.callable(place)
    let ran = bound bytes launch_word(0u64, 0u64) {
        let mut r: Registry[G, H] = registry()
        let response: Result[Bytes, RegisterError] = match run(mut r) {
            Ok(()) => match describe_registered(a, take r) {
                Ok(take payload) => Ok(take payload),
                Error(c) => Error(Full(c)),
            },
            Error(take e) => Error(take e),
        }
        take response
    }
    match take ran {
        Ok(take answer) => take answer,
        Error(c) => Error(Full(c)),
    }
}

type HostStop: send { process: Process, to: Sender[()] }

fn wait_for_host_stop(take stop: HostStop) -> () waits {
    let HostStop(process: process, to: take to) = take stop
    host.stopped(process)
    let _ = take to
}

pub fn main[G: send, H: send](a: Args, process: Process, tasks: Tasks, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn(take Receiver[()]) -> Result[(), Exit] waits) -> Result[(), Exit] waits {
    let serving = scoped fn() -> Result[(), Exit] waits {
        let full = Exit(status: 1u8)
        let stop: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
        let (to, from) = match take stop {
            Ok(take pair) => take pair,
            Error(_) => return Error(full),
        }
        let seed = HostStop(process: process, to: take to)
        let mut waiting = match task.spawn(tasks, bytes 4096u64, take seed, wait_for_host_stop) {
            Ok(take task_handle) => take task_handle,
            Error(_) => return Error(full),
        }
        let ended = start_server(take from)
        task.cancel(mut waiting)
        let _ = task.join(take waiting)
        ended
    }
    launch_server(a, place, serving)
}

// The first branch precedes the caller's ordinary serve callback, including its
// store open, listener and every capability use. No n_place runtime argument.
pub fn launch_server[G: send, H: send](a: Args, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], start_server: scoped fn() -> Result[(), Exit] waits) -> Result[(), Exit] waits {
    if launch_word(5u64, 0u64) == 0u64 {
        return start_server()
    }
    match describe_response(a, place) {
        Ok(take payload) => if launch_emit(payload) { Ok(()) } else { Error(Exit(status: 1u8)) },
        Error(take e) => {
            let error: DescribeError = match take e {
                Full(c) => PlaceCapacity(room(c)),
                AlreadyRegistered(take key) => AlreadyRegistered(take key),
                Bounds => Bounds,
            }
            let codec: std.codec.Codec[DescribeError] = std.codec.of()
            let mut out: Bytes = list.new()
            match std.codec.encode(codec, error, mut out) {
                Ok(()) => { let _ = launch_emit(out) },
                Error(_) => (),
            }
            Error(Exit(status: 2u8))
        },
    }
}

// A compute call in the caller's task, under the entry's n. A key that names no compute
// entry is NoEntry.
pub fn call[G: send, H: send](r: Registry[G, H], key: Bytes, arg: Bytes) -> Outcome {
    match map.get(r.slots, key) {
        Some(Compute(run)) => run(arg),
        _ => Refused(NoEntry),
    }
}

// A granted call: a task under the entry's `bytes n` holding g. A key that names no
// granted entry is NoEntry; a task the place cannot grant is Budget.
pub fn start[G: send, H: send](r: Registry[G, H], tasks: Tasks, take g: G, key: Bytes, take arg: Bytes) -> Result[Task[Outcome], Refusal] {
    match map.get(r.slots, key) {
        Some(Granted(go)) => match go(tasks, Direct(take g), take arg, None) {
            Ok(take t) => Ok(take t),
            Error(c) => Error(Budget(room(c))),
        },
        _ => Error(NoEntry),
    }
}

pub fn finish(take t: Task[Outcome]) -> Outcome waits {
    match task.join(take t) {
        Ok(take o) => take o,
        Error(Failed(cs)) => Failed(Raised(raised(cs))),
        Error(Cancelled(cs)) => Failed(Raised(raised(cs))),
    }
}

// ---- R1 (RUNNER-SPEC v2.4 §2, §3): transact, the head, sessions and the publisher.

// Rule 10: every task that runs entries runs the place's one `place` function itself,
// here under `bytes n_place`, so the head's, the publisher's and each session's lists
// are the same list.
fn placed[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64) -> Result[Registry[G, H], RegisterError] {
    let go = code.callable(place)
    let built: Result[Result[Registry[G, H], RegisterError], Capacity] = bound bytes n_place {
        let mut r: Registry[G, H] = registry()
        match go(mut r) {
            Ok(()) => Ok(take r),
            Error(take e) => Error(take e),
        }
    }
    match take built {
        Ok(take x) => take x,
        Error(c) => Error(Full(c)),
    }
}

// A transact run, for the head: an effect to commit with its reply, a typed error whose
// reply is kept alone, a fault after entry, or a refusal that records nothing.
type Ran: send = Commit(Bytes) | Abort(Bytes) | Exhausted(Capacity) | Refuse(Refusal)

// The session's check (rule 5): the argument decodes under n, and the value is dropped.
// Running out of n is not a refusal; the head's run answers it with Failed(OutOfBytes).
fn check_arg[A](ca: std.codec.Codec[A], arg: Bytes, n: u64) -> Option[Refusal] {
    let seen = bound bytes n {
        match std.codec.decode(ca, arg) {
            Ok(Error(e)) => {
                let why: Refusal = Malformed(bad(e))
                Some(take why)
            },
            _ => None,
        }
    }
    match take seen {
        Ok(take o) => take o,
        Error(c) => Some(Budget(room(c))),
    }
}

// The store's entry bound covers decoding, execution and reply encoding.
fn adapt_transact[H: send, A, R, E](f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], ca: std.codec.Codec[A], cr: std.codec.Codec[R], ce: std.codec.Codec[E], mut tx: store.Tx, h: H, author: Caller, arg: Bytes) -> Ran {
    let body = code.callable(f)
    match std.codec.decode(ca, arg) {
        Ok(Ok(take a)) => {
            let res = body(mut tx, h, author, take a)
            let kept = match res { Ok(_) => true, Error(_) => false }
            let mut out: Bytes = list.new()
            match std.codec.put_result(res, cr, ce, mut out) {
                Ok(()) => {
                    let length = list.len(out)
                    if length > MAX_RETURNED_BYTES {
                        Exhausted(Capacity(requested: length, available: MAX_RETURNED_BYTES))
                    } else if kept { Commit(take out) } else { Abort(take out) }
                },
                Error(c) => Exhausted(c),
            }
        },
        Ok(Error(e)) => Refuse(Malformed(bad(e))),
        Error(c) => Exhausted(c),
    }
}

pub fn transact[G: send, H: send, A: codec, R: codec, E: codec](mut r: Registry[G, H], f: StaticFn[fn(mut store.Tx, H, Caller, take A) -> Result[R, E]], n: u64, s: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, s)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let ce: std.codec.Codec[E] = std.codec.of()
    let carried: std.codec.Codec[Result[R, E]] = std.codec.of()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Transact, ca, carried) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    let revision: Option[Bytes] = if list.len(d.revision) == 0u64 {
        None
    } else {
        let copied: Result[Bytes, Capacity] = clone(d.revision)
        match take copied {
            Ok(take digest) => Some(take digest),
            Error(c) => return Error(Full(c)),
        }
    }
    register_check(mut r, key, ca, n, s)?
    let check = fn(arg: Bytes) -> Option[Refusal] { check_arg(ca, arg, n) }
    let run = fn(mut tx: store.Tx, h: H, author: Caller, arg: Bytes) -> Ran { adapt_transact(f, ca, cr, ce, mut tx, h, author, arg) }
    match check {
        Ok(take c) => match run {
            Ok(take go) => insert(mut r, take key, take d, Transact(n, s, take revision, take c, take go)),
            Error((e, _)) => Error(Full(e)),
        },
        Error((e, _)) => Error(Full(e)),
    }
}

pub fn attempt_key[F, A, R](definition: StaticFn[F], arg: std.codec.Codec[A], reply: std.codec.Codec[R]) -> Result[Bytes, Capacity] {
    let identity = code.identity(definition)
    let mut key: Bytes = list.with_capacity(list.len(identity) + 16u64)?
    list.append(mut key, identity)?
    std.codec.put_u64(std.codec.fingerprint(arg)?, mut key)?
    std.codec.put_u64(std.codec.fingerprint(reply)?, mut key)?
    Ok(take key)
}

// An attempt entry has no wire slot or call record. Only the head can attach
// the checked attempt, and the application must register the entry at open.
pub fn register_attempt[G: send, H: send, F, A: codec, R: codec](mut registered: Registry[G, H], definition: StaticFn[F],
    take run: own[send] fn(mut store.Tx, triggers.Attempt, take A) -> Result[R, store.Error], n: u64, steps: u64) -> Result[(), RegisterError] {
    check_call_reserve(n, steps)?
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[R] = std.codec.of()
    let key = match attempt_key(definition, ca, cr) { Ok(take k) => take k, Error(cap) => return Error(Full(cap)) }
    if map.contains(registered.slots, key) { return Error(AlreadyRegistered(take key)) }
    let made = fn(mut tx: store.Tx, attempt: triggers.Attempt, arg: Bytes) -> Result[Bytes, store.Error] {
        let value = match std.codec.decode(ca, arg) {
            Ok(Ok(take decoded)) => take decoded,
            Ok(Error(_)) => return Error(Missing("attempt argument")),
            Error(cap) => return Error(Full(cap)),
        }
        let answer = run(mut tx, attempt, take value)?
        let mut raw: Bytes = list.new()
        match std.codec.encode(cr, answer, mut raw) {
            Ok(()) => Ok(take raw),
            Error(cap) => Error(Full(cap)),
        }
    }
    let adapter = match take made { Ok(take f) => take f, Error((cap, _)) => return Error(Full(cap)) }
    match map.insert(mut registered.slots, take key, Fenced(n, steps, take adapter)) {
        Ok(()) => Ok(()),
        Error((cap, _)) => Error(Full(cap)),
    }
}

// ---- R2 (RUNNER-SPEC v2.11 §4): queries and their Covers.

// A Cover names one data-tree key range [low, high) of one table (I1), without reading it. It
// keeps that table's published value, erased once here (v2.11.1, STORE-SPEC AG3), so the
// publisher normalizes a Cover's initial rows and its changed rows alike (F10).
pub opaque type Cover: send {
    low: Bytes,
    high: Bytes,
    value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error]
}

pub fn cover[K, V](t: store.Shape[K, V], lo: store.Bound[K], hi: store.Bound[K]) -> Result[Cover, Capacity] {
    let (take low, take high) = match store.key_span(t, lo, hi) {
        Ok(Span(take l, take h)) => (take l, take h),
        Error(Full(c)) => return Error(c),
        _ => fail("runner: a Cover's bounds do not encode"),
    }
    let mine: store.Shape[K, V] = clone(t)?
    let made = fn(c: store.Change) -> Result[Option[Bytes], store.Error] { store.published_value(mine, c) }
    match made {
        Ok(take f) => Ok(Cover(low: take low, high: take high, value: take f)),
        Error((c, _)) => Error(c),
    }
}

// What a query run at a Snapshot gives the publisher: its Cover and read set, an Outcome
// that ends the subscription (with the reads the run made before it stopped, when it got
// that far), or a store error, which is a Reset.
type Viewed { cover: Cover, reads: List[store.Read] }

type Queried = Covered(Viewed) | Stopped(Outcome) | Faulted(Outcome, List[store.Read]) | Lost(store.Error)

// The query adapter: decode A and call f inside `look`, all inside `bound bytes n`. A fault,
// or exhaustion after entry, ends the subscription with Failed. The run is isolated inside
// `look`'s body, so `look` returns the reads it made before it stopped: that partial read
// log is the ended entry (§3 "Ended entries").
fn adapt_query[H: send, A](f: StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]], ca: std.codec.Codec[A], s: store.Snapshot, h: H, arg: Bytes, n: u64, steps: u64, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
    let body = code.callable(f)
    let looked = bound bytes n {
        store.look(s, None, scoped fn(tx: store.Tx) -> Result[Cover, Queried] {
          let ran = isolate(fn() -> Result[Result[Cover, Queried], OutOfTime] {
           bound steps steps {
            let c = match std.codec.decode(ca, arg) {
                Ok(Ok(take a)) => match body(tx, h, take a) {
                    Ok(take value) => take value,
                    Error(c) => return Ok(Error(Stopped(Failed(OutOfBytes(room(c)))))),
                },
                Ok(Error(e)) => return Ok(Error(Stopped(Refused(Malformed(bad(e)))))),
                Error(c) => return Ok(Error(Stopped(Failed(OutOfBytes(room(c)))))),
            }
            let projected = match old {
                Some(previous) => rerun_rows(prior, previous, s, c, sub, rows),
                None => cover_rows(s, c, sub, rows),
            }
            match take projected {
                Ok(()) => Ok(take c),
                Error(take e) => Error(projection_error(take e)),
            }
           }
          })
          match take ran {
              Ok(Ok(Ok(take v))) => take v,
              Ok(Ok(Error(e))) => Error(Stopped(Failed(OutOfTime(e.steps)))),
              Ok(Error(cs)) => Error(Stopped(Failed(Raised(raised(cs))))),
              Error(c) => Error(Stopped(Failed(OutOfBytes(room(c))))),
          }
        })
    }
    match take looked {
        Ok(Ok(Seen(take x))) => {
            let store.Seen(value: take v, version: _, reads: take reads) = take x
            match take v {
                Ok(take c) => Covered(Viewed(cover: take c, reads: take reads)),
                Error(Stopped(take why)) => Faulted(take why, take reads),
                Error(take other) => take other,
            }
        },
        Ok(Ok(Failed(cs))) => Stopped(Failed(Raised(raised(cs)))),
        Ok(Ok(Refused(c))) => Stopped(Failed(OutOfBytes(room(c)))),
        Ok(Ok(Stopped(e))) => Stopped(Failed(OutOfTime(e.steps))),
        Ok(Error(e)) => Lost(e),
        Error(c) => Stopped(Refused(Budget(room(c)))),
    }
}

// A query's rows travel in Batches under their tables' codecs, so its described result is
// the unit schema.
pub fn query[G: send, H: send, A: codec](mut r: Registry[G, H], f: StaticFn[fn(store.Tx, H, take A) -> Result[Cover, Capacity]], n: u64, s: u64) -> Result[(), RegisterError] {
    let ca: std.codec.Codec[A] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take key, take d) = match described(code.identity(f), code.revision(f), Query, ca, cr) {
        Ok(take kd) => take kd,
        Error(c) => return Error(Full(c)),
    }
    register_check(mut r, key, ca, n, s)?
    let made = fn(at: store.Snapshot, h: H, arg: Bytes, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
        adapt_query(f, ca, at, h, arg, n, s, prior, old, sub, rows)
    }
    match made {
        Ok(take run) => insert(mut r, take key, take d, Query(n, s, take run)),
        Error((c, _)) => Error(Full(c)),
    }
}

// ---- The publisher's subscriptions (G2, G3). A subscription keeps its Cover and read set at
// the base, never its rows (F4): rows are enumerated from the snapshots the publisher holds.
// Fields drop in reverse order: return the room after freeing the argument and key.
pub opaque type SubscriptionInput: send { room: Option[SubscriptionLease], key: Bytes, arg: Bytes }

resource type SubscriptionLease: send { refund: Sender[u64], charge: u64 } drop(lease) {
    let _ = channel.try_send(lease.refund, lease.charge)
}

// A live sub has its Cover. An ended entry (§3 "Ended entries") has none: it no longer runs,
// but its read set stays indexed, and its input stays charged to the session, until its first
// read-set hit, its owner's removal or the session's end.
// `due` (§3 "Repair"): a full owner inbox bounced content of this live sub. Its hits still
// fence, its diffs stop, and on its owner's progress one full `complete` replaces it.
type Sub { generation: u64, input: SubscriptionInput, cover: Option[Cover], routes: List[RouteKey], due: bool }

type SubId { who: u64, sub: u32, serial: u64 }

// The publisher holds one balanced interval tree for the data-tree keys of its open.
// Points have an inclusive upper endpoint and Covers and Spans have an exclusive one.
// Each node also holds the greatest upper endpoint in its subtree.
type RouteEnd { at: Arc[Bytes], included: bool }
type RouteKey { low: Arc[Bytes], serial: u64, slot: u64 }
type Route {
    key: RouteKey,
    id: SubId,
    end: RouteEnd,
    max: RouteEnd,
    height: u64,
    left: Option[Box[Route]],
    right: Option[Box[Route]]
}

type Subscriptions { by_session: Map[u64, Map[u32, Sub]], root: Option[Box[Route]], serial: u64 }

fn subscriptions() -> Subscriptions {
    Subscriptions(by_session: map.new(), root: None, serial: 0u64)
}

fn route_before(a: RouteKey, b: RouteKey) -> bool {
    let low_a: View[Bytes] = a.low
    let low_b: View[Bytes] = b.low
    if low_a != low_b { return low_a < low_b }
    if a.serial != b.serial { return a.serial < b.serial }
    a.slot < b.slot
}

fn end_reaches(end: RouteEnd, key: Bytes) -> bool {
    let high: View[Bytes] = end.at
    key < high || (end.included && key == high)
}

fn raise_end(mut end: RouteEnd, candidate: RouteEnd) {
    let high: View[Bytes] = candidate.at
    if !end_reaches(end, high) {
        end.at = arc.share(candidate.at)
        end.included = candidate.included
    }
}

fn route_height(root: Option[Box[Route]]) -> u64 {
    match root { Some(node) => node.height, None => 0u64 }
}

fn measure_route(mut node: Box[Route]) {
    let left = route_height(node.left)
    let right = route_height(node.right)
    node.height = 1u64 + if left > right { left } else { right }
    let mut far = RouteEnd(at: arc.share(node.end.at), included: node.end.included)
    if let Some(child) = node.left { raise_end(mut far, child.max) }
    if let Some(child) = node.right { raise_end(mut far, child.max) }
    node.max = take far
}

fn rotate_route_left(take node: Box[Route]) -> Box[Route] {
    let mut parent = take node
    let mut next = option.unwrap(replace(mut parent.right, None))
    parent.right = replace(mut next.left, None)
    measure_route(mut parent)
    next.left = Some(take parent)
    measure_route(mut next)
    take next
}

fn rotate_route_right(take node: Box[Route]) -> Box[Route] {
    let mut parent = take node
    let mut next = option.unwrap(replace(mut parent.left, None))
    parent.left = replace(mut next.right, None)
    measure_route(mut parent)
    next.right = Some(take parent)
    measure_route(mut next)
    take next
}

fn balance_route(take node: Box[Route]) -> Box[Route] {
    let mut root = take node
    let left = route_height(root.left)
    let right = route_height(root.right)
    if left > right + 1u64 {
        let child = option.unwrap(replace(mut root.left, None))
        root.left = Some(if route_height(child.right) > route_height(child.left) {
            rotate_route_left(take child)
        } else { take child })
        return rotate_route_right(take root)
    }
    if right > left + 1u64 {
        let child = option.unwrap(replace(mut root.right, None))
        root.right = Some(if route_height(child.left) > route_height(child.right) {
            rotate_route_right(take child)
        } else { take child })
        return rotate_route_left(take root)
    }
    measure_route(mut root)
    take root
}

fn put_route(take top: Option[Box[Route]], take node: Box[Route]) -> Box[Route] {
    let Some(take old) = take top else { return take node }
    let mut root = take old
    if route_before(node.key, root.key) {
        let child = replace(mut root.left, None)
        root.left = Some(put_route(take child, take node))
    } else {
        let child = replace(mut root.right, None)
        root.right = Some(put_route(take child, take node))
    }
    balance_route(take root)
}

fn take_first_route(take root: Box[Route], mut rest: Option[Box[Route]]) -> Box[Route] {
    let mut node = take root
    if let Some(take left) = replace(mut node.left, None) {
        let first = take_first_route(take left, mut node.left)
        rest = Some(balance_route(take node))
        take first
    } else {
        rest = replace(mut node.right, None)
        take node
    }
}

fn drop_route(take top: Option[Box[Route]], key: RouteKey) -> Option[Box[Route]] {
    let mut root = option.unwrap(take top)
    if route_before(key, root.key) {
        let child = replace(mut root.left, None)
        root.left = drop_route(take child, key)
    } else if route_before(root.key, key) {
        let child = replace(mut root.right, None)
        root.right = drop_route(take child, key)
    } else {
        let right = replace(mut root.right, None)
        let Some(take child) = take right else { return replace(mut root.left, None) }
        let mut rest: Option[Box[Route]] = None
        let mut next = take_first_route(take child, mut rest)
        next.left = replace(mut root.left, None)
        next.right = take rest
        return Some(balance_route(take next))
    }
    Some(balance_route(take root))
}

// Allocate before changing the tree. An insertion or removal only moves boxes.
fn stage_route(mut nodes: List[Box[Route]], id: SubId, slot: u64, take interval: store.Read) -> Result[(), Capacity] {
    let (take low, take end) = match take interval {
        Point(take point) => {
            let endpoint = result.capacity_only(arc.new(take point))?
            (arc.share(endpoint), RouteEnd(at: take endpoint, included: true))
        },
        Span(take lo, take hi) => {
            if hi <= lo { return Ok(()) }
            let upper = result.capacity_only(arc.new(take hi))?
            (result.capacity_only(arc.new(take lo))?, RouteEnd(at: take upper, included: false))
        },
    }
    let max = RouteEnd(at: arc.share(end.at), included: end.included)
    let node = Route(key: RouteKey(low: take low, serial: id.serial, slot: slot), id: id,
        end: take end, max: take max, height: 1u64, left: None, right: None)
    result.capacity_only(list.push(mut nodes, result.capacity_only(box.new(take node))?))
}

fn cover_view(c: Option[Cover]) -> Option[View[Cover]] in c {
    match c {
        Some(x) => Some(x),
        None => None,
    }
}

// Slot 0 is the Cover's route, which an ended entry does not have; reads take slots from 1.
fn stage_routes(id: SubId, c: Option[View[Cover]], take reads: List[store.Read]) -> Result[(List[Box[Route]], List[RouteKey]), Capacity] {
    let mut nodes: List[Box[Route]] = list.with_capacity(list.len(reads) + 1u64)?
    if let Some(span) = c { stage_route(mut nodes, id, 0u64, Span(clone(span.low)?, clone(span.high)?))? }
    let mut slot = 0u64
    for take read in reads {
        slot += 1u64
        stage_route(mut nodes, id, slot, take read)?
    }
    let mut keys: List[RouteKey] = list.with_capacity(list.len(nodes))?
    for node in nodes {
        let key = node.key
        result.unwrap(list.push(mut keys, RouteKey(low: arc.share(key.low), serial: key.serial, slot: key.slot)))
    }
    Ok((take nodes, take keys))
}

fn install_routes(mut root: Option[Box[Route]], take nodes: List[Box[Route]]) {
    for take node in nodes {
        let previous = replace(mut root, None)
        root = Some(put_route(take previous, take node))
    }
}

fn unregister_routes(mut root: Option[Box[Route]], keys: List[RouteKey]) {
    for key in keys {
        let previous = replace(mut root, None)
        root = drop_route(take previous, key)
    }
}

fn route_key(root: Option[Box[Route]], key: Bytes, mut hits: Map[u64, (SubId, bool)]) -> Result[(), Capacity] {
    let Some(node) = view root else { return Ok(()) }
    if !end_reaches(node.max, key) { return Ok(()) }
    route_key(node.left, key, mut hits)?
    let low: View[Bytes] = node.key.low
    if key < low { return Ok(()) }
    if end_reaches(node.end, key) {
        let read = node.key.slot != 0u64
        if read || !map.contains(hits, node.id.serial) {
            result.capacity_only(map.insert(mut hits, node.id.serial, (node.id, read)))?
        }
    }
    route_key(node.right, key, mut hits)
}

fn sub_at(subs: Subscriptions, who: u64, sub: u32) -> Option[View[Sub]] in subs {
    match map.get(subs.by_session, who) {
        Some(group) => map.get(group, sub),
        None => None,
    }
}

fn put_sub(mut subs: Subscriptions, id: SubId, take value: Sub) -> Result[(), Capacity] {
    if !map.contains(subs.by_session, id.who) {
        result.capacity_only(map.insert(mut subs.by_session, id.who, map.new()))?
    }
    let mut incoming = Some(take value)
    let inserted = option.unwrap(map.update(mut subs.by_session, id.who, scoped fn(mut group: Map[u32, Sub]) -> Result[(), Capacity] {
        let pending_sub = option.unwrap(replace(mut incoming, None))
        result.capacity_only(map.insert(mut group, id.sub, take pending_sub))
    }))
    if let Error(_) = inserted {
        if map.len(option.unwrap(map.get(subs.by_session, id.who))) == 0u64 {
            let _ = map.remove(mut subs.by_session, id.who)
        }
    }
    inserted
}

fn remove_sub(mut subs: Subscriptions, who: u64, sub: u32) -> Option[Sub] {
    let Some((take removed, empty)) = map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> (Option[Sub], bool) {
        let removed = map.remove(mut group, sub)
        (take removed, map.len(group) == 0u64)
    }) else { return None }
    if empty { let _ = map.remove(mut subs.by_session, who) }
    if let Some(s) = view removed { unregister_routes(mut subs.root, s.routes) }
    take removed
}

// The publisher ends a live sub (§3 "Ended entries"): its Cover's route leaves the index and
// its read routes stay, as an ended entry. Nothing is allocated.
fn end_entry(mut subs: Subscriptions, who: u64, sub: u32) {
    let dropped = map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> Option[RouteKey] {
        match map.update(mut group, sub, scoped fn(mut entry: Sub) -> Option[RouteKey] {
            entry.cover = None
            entry.due = false
            if list.len(entry.routes) > 0u64 && entry.routes[0].slot == 0u64 { Some(list.remove(mut entry.routes, 0u64)) } else { None }
        }) {
            Some(take key) => take key,
            None => None,
        }
    })
    if let Some(Some(take key)) = take dropped {
        let previous = replace(mut subs.root, None)
        subs.root = drop_route(take previous, key)
    }
}

// A publisher-made Reset ends every live sub of the session; each stays as an ended entry.
fn end_session(mut subs: Subscriptions, who: u64) {
    let mut live: List[u32] = list.new()
    if let Some(group) = map.get(subs.by_session, who) {
        for (sub, entry) in group {
            if let Some(_) = entry.cover { result.unwrap(list.push(mut live, sub)) }
        }
    }
    for sub in live { end_entry(mut subs, who, sub) }
}

fn ended_entry(subs: Subscriptions, id: SubId) -> bool {
    match sub_at(subs, id.who, id.sub) {
        Some(entry) => match entry.cover { Some(_) => false, None => true },
        None => false,
    }
}

fn due_entry(subs: Subscriptions, id: SubId) -> bool {
    match sub_at(subs, id.who, id.sub) {
        Some(entry) => entry.due,
        None => false,
    }
}

// Marks a live sub for repair (§3 "Repair"); an ended entry or a removed sub is not marked.
fn mark_due(mut subs: Subscriptions, who: u64, sub: u32) -> bool {
    match map.update(mut subs.by_session, who, scoped fn(mut group: Map[u32, Sub]) -> bool {
        match map.update(mut group, sub, scoped fn(mut entry: Sub) -> bool {
            match entry.cover {
                Some(_) => { entry.due = true; true },
                None => false,
            }
        }) {
            Some(marked) => marked,
            None => false,
        }
    }) {
        Some(marked) => marked,
        None => false,
    }
}

fn due_subs(subs: Subscriptions, who: u64) -> List[u32] {
    let mut due: List[u32] = list.new()
    if let Some(group) = map.get(subs.by_session, who) {
        for (sub, entry) in group {
            if entry.due { result.unwrap(list.push(mut due, sub)) }
        }
    }
    take due
}

// What one step owes one session: at `version`, the subs whose whole initial result it
// carries, its rows and its Ended subs; or, with `reset`, a Reset and nothing else.
type Owe: send { session: u64, version: u64, generations: List[(u32, u64)], complete: List[u32], rows: List[Row], ended: List[(u32, u64, Outcome)], reset: bool }

type Board[G: send, H: send] { r: Registry[G, H], h: H, base: store.Snapshot, newest: Option[store.Snapshot], subs: Subscriptions }

fn sub_generation(generations: List[(u32, u64)], sub: u32) -> Option[u64] {
    for (id, generation) in generations { if id == sub { return Some(generation) } }
    None
}

fn stamp_rows(mut generations: List[(u32, u64)], sub: u32, generation: u64) {
    if generation != 0u64 { result.unwrap(list.push(mut generations, (sub, generation))) }
}

fn owe(mut owes: List[Owe], who: u64, version: u64) -> u64 {
    let mut i = 0u64
    while i < list.len(owes) {
        if owes[i].session == who {
            return i
        }
        i += 1u64
    }
    result.unwrap(list.push(mut owes, Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false)))
    i
}

fn run_query[G: send, H: send](r: Registry[G, H], h: H, s: store.Snapshot, key: Bytes, arg: Bytes, prior: store.Snapshot, old: Option[View[Cover]], sub: u32, rows: Log[Row]) -> Queried {
    match map.get(r.slots, key) {
        Some(Query(_, _, go)) => go(s, h, arg, prior, old, sub, rows),
        _ => Stopped(Refused(NoEntry)),
    }
}

fn projection_error(take e: store.Error) -> Queried {
    match take e {
        Full(c) => Stopped(Failed(OutOfBytes(room(c)))),
        take other => Lost(take other),
    }
}

// The log's backing list belongs to the publisher. The row bytes and codec
// scratch created during projection are charged to the subscription's bound.
fn row_log() -> Result[Log[Row], Capacity] {
    let output: Log[Row] = log.new()?
    result.capacity_only(log.append(output, Row(sub: 0u32, key: list.new(), value: None)))?
    Ok(take output)
}

fn read_rows(take output: Log[Row]) -> List[Row] {
    let mut rows = log.finish(take output)
    let _ = list.remove(mut rows, 0u64)
    take rows
}

fn projection_row(out: Log[Row], sub: u32, take ch: store.Change, take value: Option[Bytes]) -> Result[(), store.Error] {
    let store.Change(tree_key: take key, value: _) = take ch
    match log.append(out, Row(sub: sub, key: take key, value: take value)) {
        Ok(()) => Ok(()),
        Error((c, _)) => Error(Full(c)),
    }
}

// The rows inside a Cover at s, each with its published value (F10).
fn cover_rows(s: store.Snapshot, c: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    let mut rows = store.open_span_changes(s, c.low, c.high)?
    while let Some(take ch) = store.next_span_change(mut rows)? {
        let value = (c.value)(ch)?
        projection_row(out, sub, take ch, take value)?
    }
    Ok(())
}

// G3: the query runs at the base, and its whole result goes in one owe naming it complete.
fn at_base[G: send, H: send](mut b: Board[G, H], who: u64, sub: u32, take key: Bytes, take arg: Bytes) -> Owe {
    at_base_generation(mut b, who, sub, 0u64, SubscriptionInput(room: None, key: take key, arg: take arg))
}

fn at_base_generation[G: send, H: send](mut b: Board[G, H], who: u64, sub: u32, generation: u64, take input: SubscriptionInput) -> Owe {
    let _ = remove_sub(mut b.subs, who, sub)
    let version = store.version(b.base)
    let mut o = Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false)
    let rows = match row_log() {
        Ok(take x) => take x,
        Error(c) => {
            result.unwrap(list.push(mut o.ended, (sub, generation, Refused(Budget(room(c))))))
            return take o
        },
    }
    match run_query(b.r, b.h, b.base, input.key, input.arg, b.base, None, sub, rows) {
        Covered(take v) => {
            let Viewed(cover: take c, reads: take reads) = take v
            match add_subscription(mut b.subs, who, sub, generation, take input, Some(take c), take reads) {
                Ok(()) => {
                    o.rows = read_rows(take rows)
                    stamp_rows(mut o.generations, sub, generation)
                    result.unwrap(list.push(mut o.complete, sub))
                },
                // Its read set cannot be indexed, so no content of it may go: a Reset, whose
                // other subs stay as ended entries (§3 "Ended entries").
                Error(_) => { o.reset = true },
            }
        },
        Stopped(take why) => result.unwrap(list.push(mut o.ended, (sub, generation, take why))),
        // A faulted or refused run: its partial read log is its ended entry.
        Faulted(take why, take reads) => match add_subscription(mut b.subs, who, sub, generation, take input, None, take reads) {
            Ok(()) => result.unwrap(list.push(mut o.ended, (sub, generation, take why))),
            Error(_) => { o.reset = true },
        },
        Lost(_) => {
            o.reset = true
        },
    }
    take o
}

fn add_subscription(mut subs: Subscriptions, who: u64, sub: u32, generation: u64, take input: SubscriptionInput, take c: Option[Cover], take reads: List[store.Read]) -> Result[(), Capacity] {
    subs.serial += 1u64
    let id = SubId(who: who, sub: sub, serial: subs.serial)
    let (take nodes, take keys) = stage_routes(id, cover_view(c), take reads)?
    put_sub(mut subs, id, Sub(generation: generation, input: take input, cover: take c, routes: take keys, due: false))?
    install_routes(mut subs.root, take nodes)
    Ok(())
}

// The rerun's difference: the keys inside the old Cover at a against the keys inside the new
// Cover at b, removals included, each new or changed key with its published value at b.
fn rerun_rows(a: store.Snapshot, old: Cover, b: store.Snapshot, new: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    let mut before = store.open_span_changes(a, old.low, old.high)?
    let mut after = store.open_span_changes(b, new.low, new.high)?
    let mut previous = store.next_span_change(mut before)?
    let mut next = store.next_span_change(mut after)?
    loop {
        let order = match (view previous, view next) {
            (Some(x), Some(y)) => if x.tree_key < y.tree_key { 0u8 } else if x.tree_key == y.tree_key { 1u8 } else { 2u8 },
            (Some(_), None) => 0u8,
            (None, Some(_)) => 2u8,
            (None, None) => return Ok(()),
        }
        if order == 0u8 {
            let removed = option.unwrap(replace(mut previous, None))
            projection_row(out, sub, take removed, None)?
            previous = store.next_span_change(mut before)?
            continue
        }
        let was = if order == 1u8 {
            let row = option.unwrap(replace(mut previous, None))
            let v = (old.value)(row)?
            previous = store.next_span_change(mut before)?
            take v
        } else {
            None
        }
        let row = option.unwrap(replace(mut next, None))
        let now = (new.value)(row)?
        if was != now {
            projection_row(out, sub, take row, take now)?
        }
        next = store.next_span_change(mut after)?
    }
}

// The changed keys inside a Cover, with their published values at b.
fn covered_rows(d: List[store.Change], c: Cover, sub: u32, out: Log[Row]) -> Result[(), store.Error] {
    for ch in d {
        let v = (c.value)(ch)?
        let copied: Result[Bytes, Capacity] = clone(ch.tree_key)
        let key = match take copied {
            Ok(take x) => take x,
            Error(f) => return Error(Full(f)),
        }
        if let Error((f, _)) = log.append(out, Row(sub: sub, key: take key, value: take v)) {
            return Error(Full(f))
        }
    }
    Ok(())
}

fn change_offset(d: List[store.Change], key: Bytes) -> u64 {
    match list.binary_search_by(d, scoped fn(ch: store.Change) -> Order {
        if ch.tree_key < key { Less } else { Greater }
    }) {
        Ok(i) => i,
        Error(i) => i,
    }
}

fn project_changes[G: send, H: send](r: Registry[G, H], key: Bytes, d: List[store.Change], c: Cover, sub: u32, rows: Log[Row]) -> Result[(), Queried] {
    // changes walks the two data trees in key order, with at most one change per key.
    let first = change_offset(d, c.low)
    let past = change_offset(d, c.high)
    match map.get(r.slots, key) {
        Some(Query(allowance, steps, _)) => bounded_changes(allowance, steps, list.slice(d, first, past), c, sub, rows),
        _ => Error(Stopped(Refused(NoEntry))),
    }
}

fn bounded_changes(allowance: u64, steps: u64, d: List[store.Change], c: Cover, sub: u32, rows: Log[Row]) -> Result[(), Queried] {
    let attempt = bound bytes allowance {
        isolate(fn() -> Result[Result[(), store.Error], OutOfTime] {
            bound steps steps { covered_rows(d, c, sub, rows) }
        })
    }
    match take attempt {
        Ok(Ok(Ok(Ok(Ok(()))))) => Ok(()),
        Ok(Ok(Ok(Ok(Error(e))))) => Error(projection_error(take e)),
        Ok(Ok(Ok(Error(e)))) => Error(Stopped(Failed(OutOfTime(e.steps)))),
        Ok(Ok(Error(cs))) => Error(Stopped(Failed(Raised(raised(cs))))),
        Ok(Error(f)) => Error(Stopped(Failed(OutOfBytes(room(f))))),
        Error(f) => Error(Stopped(Refused(Budget(room(f))))),
    }
}

// A session Reset ends all its subscriptions, whose read sets stay as ended entries, and
// replaces its owed content.
fn reset_session(mut subs: Subscriptions, mut owes: List[Owe], who: u64, version: u64) {
    end_session(mut subs, who)
    let k = owe(mut owes, who, version)
    owes[k] = Owe(session: who, version: version, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: true)
}

fn reset_subscriptions(mut subs: Subscriptions, mut owes: List[Owe], version: u64) {
    let groups = replace(mut subs.by_session, map.new())
    subs.root = None
    for (who, _) in groups { reset_session(mut subs, mut owes, who, version) }
}

fn affected_subscriptions(subs: Subscriptions, changes: List[store.Change]) -> Result[List[(SubId, bool)], Capacity] {
    let mut hits: Map[u64, (SubId, bool)] = map.new()
    for ch in changes { route_key(subs.root, ch.tree_key, mut hits)? }
    let mut ordered: List[(SubId, bool)] = list.with_capacity(map.len(hits))?
    for (_, hit) in hits { result.unwrap(list.push(mut ordered, hit)) }
    // Both projection and reruns observe the same subscription order as G3.
    list.sort(mut ordered, scoped fn(a: (SubId, bool), b: (SubId, bool)) -> Order {
        if a.0.serial < b.0.serial { Less } else if a.0.serial > b.0.serial { Greater } else { Equal }
    })
    Ok(take ordered)
}

// A re-run's Cover and read set replace the sub's, or, with no Cover, its partial read log
// makes it an ended entry.
fn replace_routes(mut subs: Subscriptions, id: SubId, take c: Option[Cover], take reads: List[store.Read]) -> Result[(), Capacity] {
    let (take nodes, take keys) = stage_routes(id, cover_view(c), take reads)?
    let mut incoming = Some((take c, take keys))
    let old = option.unwrap(option.unwrap(map.update(mut subs.by_session, id.who, scoped fn(mut group: Map[u32, Sub]) -> Option[List[RouteKey]] {
        map.update(mut group, id.sub, scoped fn(mut entry: Sub) -> List[RouteKey] {
            let (take cover_next, take routes_next) = option.unwrap(replace(mut incoming, None))
            entry.cover = take cover_next
            replace(mut entry.routes, take routes_next)
        })
    })))
    unregister_routes(mut subs.root, old)
    install_routes(mut subs.root, take nodes)
    Ok(())
}

// The sub keeps the read set of its last run as its ended entry.
fn end_round_sub(mut subs: Subscriptions, mut out: Owe, id: SubId, generation: u64, take why: Outcome) {
    result.unwrap(list.push(mut out.ended, (id.sub, generation, take why)))
    end_entry(mut subs, id.who, id.sub)
}

fn append_round_rows(mut out: Owe, id: SubId, generation: u64, take rows: Log[Row]) {
    let before = list.len(out.rows)
    for take row in read_rows(take rows) { result.unwrap(list.push(mut out.rows, take row)) }
    if list.len(out.rows) != before { stamp_rows(mut out.generations, id.sub, generation) }
}

type SubUpdate = Rows(Log[Row]) | Refreshed(Viewed, Log[Row]) | EndSub(Outcome) | EndRead(Outcome, List[store.Read]) | ResetSubs

fn advance_sub[G: send, H: send](b: Board[G, H], newest: store.Snapshot, d: List[store.Change], id: SubId, read: bool) -> Option[(u64, SubUpdate)] {
    let Some(entry) = sub_at(b.subs, id.who, id.sub) else { return None }
    let generation = entry.generation
    let rows = match row_log() {
        Ok(take x) => take x,
        Error(f) => return Some((generation, EndSub(Refused(Budget(room(f)))))),
    }
    let advanced = if read {
        match run_query(b.r, b.h, newest, entry.input.key, entry.input.arg, b.base, cover_view(entry.cover), id.sub, rows) {
            Covered(take v) => Refreshed(take v, take rows),
            Stopped(take why) => EndSub(take why),
            Faulted(take why, take reads) => EndRead(take why, take reads),
            Lost(_) => ResetSubs,
        }
    } else {
        let Some(c) = entry.cover else { return None }
        match project_changes(b.r, entry.input.key, d, c, id.sub, rows) {
            Ok(()) => Rows(take rows),
            Error(Stopped(take why)) => EndSub(take why),
            Error(_) => ResetSubs,
        }
    }
    Some((generation, take advanced))
}

// G2: one round from the base to the newest snapshot released.
// `fenced` gets every session with a read-set hit, found before any sub is advanced or ended;
// a lost diff fences them all.
fn round[G: send, H: send](mut b: Board[G, H], mut fenced: Fenced) -> List[Owe] {
    let mut owes: List[Owe] = list.new()
    let Some(take newest) = replace(mut b.newest, None) else { return take owes }
    let version = store.version(newest)
    let d = match store.changes(b.base, newest) {
        Ok(take x) => take x,
        Error(_) => {
            fenced.all = true
            reset_subscriptions(mut b.subs, mut owes, version)
            b.base = take newest
            return take owes
        },
    }
    let hits = match affected_subscriptions(b.subs, d) {
        Ok(take x) => take x,
        Error(_) => {
            fenced.all = true
            reset_subscriptions(mut b.subs, mut owes, version)
            b.base = take newest
            return take owes
        },
    }
    for (id, read) in hits {
        if read && !list.contains(fenced.sessions, id.who) {
            if let Error(_) = list.push(mut fenced.sessions, id.who) { fenced.all = true }
        }
    }
    for (id, read) in hits {
        // An ended entry's hit is a read-set hit, fenced above: from this round's E every writer
        // drops all of its content, so the entry leaves.
        if ended_entry(b.subs, id) {
            let _ = remove_sub(mut b.subs, id.who, id.sub)
            continue
        }
        // A due sub's hit is fenced above and its diff is not computed: the repair's full
        // image replaces whatever this round changed (§3 "Repair").
        if due_entry(b.subs, id) { continue }
        let Some((generation, take advanced)) = advance_sub(b, newest, d, id, read) else { continue }
        let k = owe(mut owes, id.who, version)
        match take advanced {
            Rows(take rows) => append_round_rows(mut owes[k], id, generation, take rows),
            Refreshed(Viewed(cover: take c, reads: take reads), take rows) => {
                match replace_routes(mut b.subs, id, Some(take c), take reads) {
                    Ok(()) => append_round_rows(mut owes[k], id, generation, take rows),
                    Error(f) => end_round_sub(mut b.subs, mut owes[k], id, generation, Refused(Budget(room(f)))),
                }
            },
            EndSub(take why) => end_round_sub(mut b.subs, mut owes[k], id, generation, take why),
            EndRead(take why, take reads) => match replace_routes(mut b.subs, id, None, take reads) {
                Ok(()) => result.unwrap(list.push(mut owes[k].ended, (id.sub, generation, take why))),
                Error(_) => reset_session(mut b.subs, mut owes, id.who, version),
            },
            ResetSubs => reset_session(mut b.subs, mut owes, id.who, version),
        }
    }
    b.base = take newest
    take owes
}

// The stream's reply at p is the Outcome's codec bytes (STORE-SPEC §1.8 reply).
fn encode_runner_reply(o: Outcome) -> Result[Bytes, store.Error] {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let mut b: Bytes = list.new()
    match std.codec.encode(co, o, mut b) {
        Ok(()) => Ok(take b),
        Error(c) => Error(Full(c)),
    }
}

// ---- P2: the head (H1-H4) and its gate (V3, V4).

// A request at the head. The session computed its digest at ingress (store.request_digest
// over the requested key and the exact argument bytes, v2.11.3) and never takes one from a
// client.
pub opaque type Req: send { e: HeadIn }

type HeadIn: send = Requested(Request) | OwnerLeft

type Request: send {
    caller: Caller,
    stream: Bytes,
    p: u64,
    key: Bytes,
    arg: Bytes,
    digest: store.RequestDigest,
    reply_to: Sender[WireEvent],
    live: Latest[HeadLife],
    identity: Latest[OwnerNumber],
    seed: Option[Arc[OwnerNumber]]
}

type Recipient: send { owner: u64, to: Sender[WireEvent] }

type Answer: send { recipient: Recipient, row: KeyedDone }

type Replies: send { recipient: Recipient, rows: List[KeyedDone] }

// With a snapshot, a Release carries its group's durable version (V4). Without one it
// carries commitless answers, which the publisher sends at its base (V3).
pub opaque type Release: send {
    version: u64,
    snapshot: Option[store.Snapshot],
    answers: List[Answer]
}

// The publisher's one inbox (v2.12, ruled 2026-11-17: one mailbox per actor). The head's
// Releases, a session's join, its Subscribes and Unsubscribes, its leaving and the head's
// last word arrive here in send order, so a Subscribe is ordered against every Release (G3)
// without selection, which v1 lacks.
pub opaque type PubIn: send { e: ToPub }

type ToPub: send = Released(Release) | Joined(Join) | Subscribed(u64, u32, Bytes, Bytes) | WireSubscribed(u64, u32, u64, SubscriptionInput) | Unsubscribed(u64, u32) | Left(u64) | Halt | Drained

// A session's join, on its first Subscribe: where its content goes, and where the
// publisher answers with the id it mints for the session.
// v2.14: a marked session (an HTTP group or one-shot read) sends the Receiver of its
// retirement mark, a channel it keeps the only Sender of and never sends on.
// v2.19: a session's fence root holds a handle the publisher publishes on (§3 "The release
// check"), and the publisher answers with the session's id and a handle to the round register.
// v2.20: `progress` is the owner's drain token (§3 "Repair"), a capacity-1 channel the owner
// sends on before each `Drained`; with none, a due session repairs on every pass.
type Join: send { to: Sender[WireEvent], told: Sender[Admit], mark: Option[Receiver[()]], closed: Option[Receiver[()]], identity: Option[Latest[OwnerNumber]], fence: Option[Latest[Fence]], progress: Option[Receiver[()]] }

type Admit: send { who: u64, round: Latest[RoundAt] }

// v2.19 (§3 "The release check"): `latest` is the newest commit that hit a read set of the
// session, and `prior` the value `latest` had before it.
pub type Fence: shareable + send { prior: u64, latest: u64 }

// The round register's value R: the newest version whose fences are all published.
// u64::MAX is the deploy halt's, and drops every content unit.
type RoundAt: shareable + send { at: u64 }

const ROUND_HALTED: u64 = 18446744073709551615u64

// The publisher's inbox, both ends, and the place's round register with its reserved Arcs.
// `post` gives each session a sender; place_head then takes the mailbox whole, its head
// sending Releases on the same channel.
pub opaque type Mailbox: send { to: Sender[PubIn], from: Receiver[PubIn], rounds: RoundRegister }

// The round register and every Arc a round publishes from (§3 "Admission"): the current
// value (the publisher's own share), the spares, which no reader reaches through the root,
// and u64::MAX. `mailbox` reserves one spare and each fenced `Joined` one more, so with at
// most one share per writer some spare is always unshared. The register fails closed: a
// publisher that ends by anything but `Halt` (a trap included) publishes R = u64::MAX as it
// is cleaned, before its inbox closes, so no commit after the trap is released unfenced.
resource type RoundRegister: send { round: Latest[RoundAt], halted: Arc[RoundAt], current: Arc[RoundAt], spares: List[Arc[RoundAt]] } drop(rounds) {
    latest.publish(rounds.round, arc.share(rounds.halted))
}

// `Halt`: the publisher stops on the head's word, and R stays where it is.
fn round_disarm(take rounds: RoundRegister) {
    let RoundRegister(round: _, halted: _, current: _, spares: _) = take rounds
}

pub fn mailbox(n: u64) -> Result[Mailbox, Capacity] {
    let (to, from): (Sender[PubIn], Receiver[PubIn]) = channel.new(n)?
    let first = result.capacity_only(arc.new(RoundAt(at: 0u64)))?
    let register = result.capacity_only(latest.new(arc.share(first)))?
    let halted = result.capacity_only(arc.new(RoundAt(at: ROUND_HALTED)))?
    let next = result.capacity_only(arc.new(RoundAt(at: 0u64)))?
    let mut spares: List[Arc[RoundAt]] = list.new()
    result.capacity_only(list.push(mut spares, take next))?
    let rounds = result.capacity_only(RoundRegister(round: take register, halted: take halted, current: take first, spares: take spares))?
    Ok(Mailbox(to: take to, from: take from, rounds: take rounds))
}

// A session's fence root and the Arcs its fence step publishes from: the current one (the
// publisher's own share) and two spares. Its writer holds at most one share at a time, so
// one spare is always unshared.
type FenceSet: send { root: Latest[Fence], current: Arc[Fence], a: Arc[Fence], b: Arc[Fence] }

// `Joined`'s reservation: the session's two fence spares and one more round spare. A refusal
// admits nothing and the join is answered with id 0.
fn fence_reserve(mut rounds: RoundRegister, take root: Latest[Fence]) -> Result[FenceSet, Capacity] {
    let a = result.capacity_only(arc.new(Fence(prior: 0u64, latest: 0u64)))?
    let b = result.capacity_only(arc.new(Fence(prior: 0u64, latest: 0u64)))?
    let spare = result.capacity_only(arc.new(RoundAt(at: 0u64)))?
    result.capacity_only(list.push(mut rounds.spares, take spare))?
    let current = latest.read(root)
    Ok(FenceSet(root: take root, current: take current, a: take a, b: take b))
}

// Publishes Fence{prior: the current latest, latest: b} from an unshared spare, the old
// current becoming that spare. A fence already at b is left. False only if no spare is
// unshared and no Arc can be made.
fn fence_advance(mut fences: FenceSet, b: u64) -> bool {
    let prior = fences.current.latest
    if prior >= b { return true }
    let in_a = arc.with_unique(mut fences.a, scoped fn(mut f: Fence) { f.prior = prior; f.latest = b })
    let fresh = if let Some(_) = in_a {
        let kept = arc.share(fences.current)
        replace(mut fences.a, take kept)
    } else {
        let in_b = arc.with_unique(mut fences.b, scoped fn(mut f: Fence) { f.prior = prior; f.latest = b })
        if let Some(_) = in_b {
            let kept = arc.share(fences.current)
            replace(mut fences.b, take kept)
        } else {
            match arc.new(Fence(prior: prior, latest: b)) { Ok(take x) => take x, Error(_) => return false }
        }
    }
    let _ = replace(mut fences.current, take fresh)
    latest.publish(fences.root, arc.share(fences.current))
    true
}

// Publishes R = at from an unshared spare, the old current becoming that spare, and frees
// spares beyond one per joined session plus one, keeping every shared spare and one unshared
// one. False only if no spare is unshared and no Arc can be made.
fn round_advance(mut rounds: RoundRegister, at: u64, live: u64) -> bool {
    let mut chosen: Option[u64] = None
    let mut i = 0u64
    while i < list.len(rounds.spares) {
        let unique = match arc.with_unique(mut rounds.spares[i], scoped fn(mut v: RoundAt) { v.at = at }) { Some(_) => true, None => false }
        if unique {
            if let None = chosen {
                chosen = Some(i)
            } else if list.len(rounds.spares) > live + 1u64 {
                let _ = list.remove(mut rounds.spares, i)
                continue
            }
        }
        i += 1u64
    }
    let index = match chosen {
        Some(x) => x,
        None => {
            let made = match arc.new(RoundAt(at: at)) { Ok(take x) => take x, Error(_) => return false }
            if let Error(_) = list.push(mut rounds.spares, take made) { return false }
            list.len(rounds.spares) - 1u64
        },
    }
    let kept = arc.share(rounds.current)
    let fresh = list.set(mut rounds.spares, index, take kept)
    let _ = replace(mut rounds.current, take fresh)
    latest.publish(rounds.round, arc.share(rounds.current))
    true
}

// The release check's decision (§3), one function for every transport: R = u64::MAX drops
// every content unit; otherwise the fence acts at `latest` once R has reached it, and at
// `prior` before, and a unit passes if that fence is at most its version.
pub fn release_passes(r: u64, f: Fence, version: u64) -> bool {
    if r == ROUND_HALTED { return false }
    let effective = if f.latest <= r { f.latest } else { f.prior }
    effective <= version
}

// The writer's check: R first, then the fence, each copied and its share released before
// the decision.
fn release_load(register: Latest[RoundAt], fence: Latest[Fence], version: u64) -> bool {
    let r = latest.read(register).at
    let f = {
        let held = latest.read(fence)
        Fence(prior: held.prior, latest: held.latest)
    }
    release_passes(r, f, version)
}

pub fn post(m: Mailbox) -> Sender[PubIn] {
    channel.sender(m.to)
}

// A stream's worker, from its commit until the gate releases its group.
type Worker: send { p: u64, digest: store.RequestDigest, version: u64, outcome: Outcome, waiters: List[Recipient] }

type Waiting: send { req: Request, parked: bool }

type Head[G: send, H: send] {
    db: store.Db,
    r: Registry[G, H],
    replay_identity: Bytes,
    h: H,
    out: Sender[PubIn],
    busy: Map[Bytes, Worker],
    waiting: List[Waiting],
    group: List[Bytes],
    last: Option[store.Ticket],
    minted: u64,
    // The publisher refused a Release: it has stopped, and R = u64::MAX is published. The
    // head commits nothing more and the place ends with OpenError.PublisherStopped.
    cut: bool,
    trigger_drive: Option[Box[TriggerDrive[G]]]
}

type Publish[G: send, H: send]: send {
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    n_place: u64,
    h: H,
    base: store.Snapshot,
    from: Receiver[PubIn],
    rounds: RoundRegister,
    ready: Sender[Option[RegisterError]]
}

// The publisher task runs `place` itself and tells the head whether it could.
fn publish[G: send, H: send](take p: Publish[G, H]) -> () waits {
    let Publish(place: place, n_place: n_place, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready) = take p
    let r = match placed(place, n_place) {
        Ok(take x) => take x,
        Error(take e) => {
            let _ = channel.send(ready, Some(take e))
            return
        },
    }
    if let Error(_) = channel.send(ready, None) {
        return
    }
    publisher(take r, take h, take base, take from, take rounds)
}

// The head selects the release under the store's LOCK before opening handles.
pub fn place_head[G: send, H: send](take db: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: Receiver[Req], take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    place_head_selected(take db, Current(0u64), place, n_place, migrate, handles, DirectRequests(take inbox), take mail, tasks, n_publisher)
}

pub fn place_head_requests[G: send, H: send](take db: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: HeadRequests, take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    place_head_selected(take db, Current(0u64), place, n_place, migrate, handles, take inbox, take mail, tasks, n_publisher)
}

pub fn place_head_selected[G: send, H: send](take db: store.Db, selection: Selection, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], take inbox: HeadRequests, take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(), OpenError] waits {
    let mut owned = take db
    let persistent = store.is_disk(owned)
    let prepared = head_prepare(mut owned, selection, persistent, place, migrate, handles, n_place, tasks)
    let (r, h, h2, _, replay_identity) = match take prepared {
        Ok(take ready) => take ready,
        Error(take problem) => { let _ = close_store(take owned); return Error(take problem) },
    }
    run_head(take owned, take r, take replay_identity, take h, take h2, place, n_place, take inbox, take mail, tasks, n_publisher, None, None)
}

fn run_head[G: send, H: send](take db: store.Db, take r: Registry[G, H], take replay_identity: Bytes, take h: H, take h2: H,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, take inbox: HeadRequests,
    take mail: Mailbox, tasks: Tasks, n_publisher: u64, take drain: Option[HeadDrain], take trigger_drive: Option[Box[TriggerDrive[G]]]) -> Result[(), OpenError] waits {
    let mut owned = take db
    let publishing = start_publisher(owned, place, n_place, take h2, take mail, tasks, n_publisher)
    let (out, publisher_task) = match take publishing {
        Ok(take started) => take started,
        Error(take problem) => { let _ = close_store(take owned); return Error(take problem) },
    }
    if let Some(control) = drain {
        if let ManagedRequests(from) = inbox {
            if !head_advance(control.events, from, Published(channel.sender(out))) {
                let mut stopping = take publisher_task
                task.cancel(mut stopping)
                let _ = task.join(take stopping)
                return close_store(take owned)
            }
        }
    }
    let mut hd = Head(db: take owned, r: take r, replay_identity: take replay_identity, h: take h, out: take out, busy: map.new(), waiting: list.new(), group: list.new(), last: None, minted: 0u64, cut: false, trigger_drive: take trigger_drive)
    let served = serve_head(mut hd, take inbox, take drain)
    finish_head(take hd, take publisher_task, take served)
}

fn finish_head[G: send, H: send](take head: Head[G, H], take publishing: Task[()], take served: Result[(), store.Error]) -> Result[(), OpenError] waits {
    let Head(db: take kept, out: take last_word, cut: cut, trigger_drive: take drive, ..) = take head
    if let Some(take scheduled) = take drive { stop_triggers(take scheduled) }
    let _ = channel.send(last_word, PubIn(e: Halt))
    let stopped = match task.join(take publishing) { Ok(()) => cut, Error(_) => true }
    match take served { Ok(()) => (), Error(take problem) => return Error(Store(take problem)) }
    if stopped {
        let _ = close_store(take kept)
        return Error(PublisherStopped)
    }
    close_store(take kept)
}

fn close_store(take db: store.Db) -> Result[(), OpenError] waits {
    match store.close(take db) { Ok(()) => Ok(()), Error(take problem) => Error(Store(take problem)) }
}

fn open_handles[H: send](db: store.Db, handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]]) -> Result[H, OpenError] {
    match store.with_schema(db, handles) {
        Ok(take h) => Ok(take h),
        Error(take problem) => Error(Store(take problem)),
    }
}

fn start_publisher[G: send, H: send](owned: store.Db, place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], n_place: u64, take h2: H, take mail: Mailbox, tasks: Tasks, n_publisher: u64) -> Result[(Sender[PubIn], Task[()]), OpenError] waits {
    let Mailbox(to: take out, from: take from, rounds: take rounds) = take mail
    let told: Result[(Sender[Option[RegisterError]], Receiver[Option[RegisterError]]), Capacity] = channel.new(1u64)
    let (ready, readied) = match take told {
        Ok(take pair) => take pair,
        Error(c) => return Error(Store(Full(c))),
    }
    let p = Publish(place: place, n_place: n_place, h: take h2, base: store.snapshot(owned), from: take from, rounds: take rounds, ready: take ready)
    let publishing = match task.spawn(tasks, bytes n_publisher, take p, publish) {
        Ok(take t) => take t,
        Error((c, _)) => return Error(Store(Full(c))),
    }
    match channel.receive(readied) {
        Ok(None) => (),
        Ok(Some(take e)) => {
            let _ = task.join(take publishing)
            return Error(Place(take e))
        },
        // The task ended without a word: `place` already ran here, so the task's own
        // allowance could not hold it.
        Error(_) => {
            let _ = task.join(take publishing)
            return Error(Place(Full(Capacity(requested: n_publisher, available: 0u64))))
        },
    }
    Ok((take out, take publishing))
}

type DrainWindow: shareable + send { admission: u64, deadline: u64 }

type LifeEvent: send = StopRequested | Recovered | Activated(Bytes) | Published(Sender[PubIn]) | ServePrepared | Settled | HeadEnded(Result[(), StartError]) | AdmissionClose | DrainExpired | ServeEnded(Result[u64, StartError])

pub type HeadInput: send = RunRequest(Req) | HeadContinue | HeadClose | HeadFinish | TriggerWake(u64) | TriggerMessage(Box[TriggerInput]) | TriggerDone(triggers.Attempt, Option[Outcome])

pub type HeadRequests = DirectRequests(Receiver[Req]) | ManagedRequests(Receiver[HeadInput])
type HeadDrain { finish: Receiver[()], events: Sender[LifeEvent], window: Latest[Option[DrainWindow]], clock: Clock }

type ManagedHead[G: send, H: send, S: send]: send {
    backing: Backing, selection: Selection, tasks: Tasks, clock: Clock, random: Random,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]],
    n_place: u64, n_publisher: u64, inbox: Receiver[HeadInput], finish_from: Receiver[()],
    to: Sender[LifeEvent], drain: Latest[Option[DrainWindow]],
    triggering: Option[(TriggerConfig[G, S], Sender[HeadInput])],
}

fn head_advance(to: Sender[LifeEvent], inbox: Receiver[HeadInput], take progress: LifeEvent) -> bool waits {
    if let Error(_) = channel.send(to, take progress) { return false }
    match channel.receive(inbox) { Ok(HeadContinue) => true, _ => false }
}

fn head_ended[G: send, H: send, S: send](take job: ManagedHead[G, H, S]) -> () waits {
    let to = channel.sender(job.to)
    let ended = managed_head(take job)
    let _ = channel.send(to, HeadEnded(take ended))
}

fn managed_head[G: send, H: send, S: send](take job: ManagedHead[G, H, S]) -> Result[(), StartError] waits {
    let ManagedHead(backing: take backing, selection: selection, tasks: tasks, clock: clock, random: random, place: place, migrate: migrate, handles: handles,
        n_place: n_place, n_publisher: n_publisher, inbox: take inbox, finish_from: take finish_from, to: take to, drain: take drain,
        triggering: take triggering) = take job
    let persistent = match backing { Disk(_, _) => true, _ => false }
    let mut temporary: Option[TemporaryBacking] = None
    let opened: Result[store.Db, store.Error] = match backing {
        Memory => Ok(store.memory(clock, random, store.defaults())),
        Disk(dir, options) => store.open(tasks, dir, clock, random, options),
        Temp(parent) => {
            let name = match string.with_capacity(32u64) { Ok(take name) => take name, Error(cap) => return Error(Full(cap)) }
            let mut cleanup = match TemporaryBacking(dir: parent, name: take name) { Ok(take guard) => take guard, Error((cap, _)) => return Error(Full(cap)) }
            let dir = match std.dir.create_temp(parent, mut cleanup.name) { Ok(dir) => dir, Error(problem) => return Error(Open(Store(Io(problem)))) }
            temporary = Some(take cleanup)
            store.open(tasks, dir, clock, random, store.defaults())
        },
    }
    let mut db = match take opened { Ok(take db) => take db, Error(take problem) => return Error(Open(Store(take problem))) }
    if !head_advance(to, inbox, Recovered) { return head_closed(take db) }
    let prepared = head_prepare(mut db, selection, persistent, place, migrate, handles, n_place, tasks)
    let (reg, local, publisher_handles, release, replay_identity) = match take prepared {
        Ok(take values) => take values,
        Error(take problem) => { let _ = close_store(take db); return Error(Open(take problem)) },
    }
    let trigger_drive = match take triggering {
        Some((take config, take trigger_to)) => match make_trigger_drive(db, clock, tasks, take trigger_to, release, take config) {
            Ok(take drive) => Some(take drive),
            Error(take problem) => { let _ = close_store(take db); return Error(Open(Store(take problem))) },
        },
        None => None,
    }
    if !head_advance(to, inbox, Activated(take release)) { return head_closed(take db) }
    let mail = match mailbox(4u64) {
        Ok(take mail) => take mail,
        Error(cap) => { let _ = close_store(take db); return Error(Full(cap)) },
    }
    let closing = HeadDrain(finish: take finish_from, events: take to, window: take drain, clock: clock)
    let ended = run_head(take db, take reg, take replay_identity, take local, take publisher_handles, place, n_place, ManagedRequests(take inbox), take mail, tasks, n_publisher, Some(take closing), take trigger_drive)
    let _ = take temporary
    match take ended {
        Ok(()) => Ok(()),
        Error(Store(Full(cap))) => Error(Full(cap)),
        Error(take problem) => Error(Open(take problem)),
    }
}

fn head_closed(take db: store.Db) -> Result[(), StartError] waits {
    match close_store(take db) { Ok(()) => Ok(()), Error(take problem) => Error(Open(take problem)) }
}

fn head_prepare[G: send, H: send](mut db: store.Db, selection: Selection, persistent: bool,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits], handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]], n_place: u64, tasks: Tasks) -> Result[(Registry[G, H], H, H, Bytes, Bytes), OpenError] waits {
    if !store.is_disk(db) {
        let mut local_registry = match placed(place, n_place) { Ok(take registered) => take registered, Error(take problem) => return Error(Place(take problem)) }
        let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
        if let Error(take problem) = store.run_migration(mut db, tasks, migrate) { return Error(Migrate(take problem)) }
        let h = open_handles(db, handles)?
        let h2 = open_handles(db, handles)?
        let release = match release_digest(local_registry.exported) { Ok(take value) => take value, Error(cap) => return Error(Store(Full(cap))) }
        return Ok((take local_registry, take h, take h2, take release, take identity))
    }
    let current = activation_result(current_description(db))?
    let selected: Option[u64] = match selection {
        Install => None,
        Current(expected) => match current {
            None => {
                if expected != 0u64 { return Error(NotCurrent(Empty)) }
                None
            },
            Some(_) => {
                if store.fence_level(db) == 0 && persistent { return Error(NotCurrent(Legacy)) }
                let version = activation_result(activation_version(db))?
                if version != expected { return Error(NotCurrent(Active(version, option.unwrap(take current)))) }
                Some(version)
            },
        },
    }
    if persistent && selected == None && launch_word(1u64, 0u64) == 0u64 { return Error(IdentityUnknown) }
    let mut reg = match placed(place, n_place) { Ok(take reg) => take reg, Error(take problem) => return Error(Place(take problem)) }
    let payload = prepare_activation(reg, n_place)
    let (description, record) = match take payload {
        Ok(take pair) => take pair,
        Error(cap) => return Error(Store(Full(cap))),
    }
    if let Some(version) = selected {
        let old = option.unwrap(take current)
        if old != description { return Error(NotCurrent(Active(version, take old))) }
        let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
        let h = open_handles(db, handles)?
        let h2 = open_handles(db, handles)?
        let ReleaseRecord(release: take release, ..) = take record
        return Ok((take reg, take h, take h2, take release, take identity))
    }
    let identity = activation_identity(code.identity(place), code.identity(migrate), code.identity(handles))?
    let mut stage = match store.stage_migration(db, tasks, migrate) {
        Ok(take staged) => take staged,
        Error(take problem) => return Error(Migrate(take problem)),
    }
    let version = store.version(store.snapshot(db)) + 1u64
    let release_codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    activation_result(store.stage_activation(mut stage, version, current, description, release_codec, record))?
    let h = activation_result(store.with_staged_schema(stage, handles))?
    let h2 = activation_result(store.with_staged_schema(stage, handles))?
    if let Error(take problem) = store.install_activation(mut db, take stage) { return Error(Store(take problem)) }
    let ReleaseRecord(release: take release, ..) = take record
    Ok((take reg, take h, take h2, take release, take identity))
}

fn activation_result[T](take answer: Result[T, store.Error]) -> Result[T, OpenError] {
    match take answer {
        Ok(take value) => Ok(take value),
        Error(take problem) => Error(Store(take problem)),
    }
}

fn activation_identity(place_id: Bytes, migrate_id: Bytes, handles_id: Bytes) -> Result[Bytes, OpenError] {
    match replay_identity_of(place_id, migrate_id, handles_id) {
        Ok(take digest) => Ok(take digest),
        Error(problem) => Error(Store(Full(problem))),
    }
}

fn replay_identity_of(place_id: Bytes, migrate_id: Bytes, handles_id: Bytes) -> Result[Bytes, Capacity] {
    let launch = launch_digest()?
    if list.len(launch) == 0 { return Ok(list.new()) }
    let mut raw = take launch
    be_word(mut raw, list.len(place_id), 4)?
    list.append(mut raw, place_id)?
    be_word(mut raw, list.len(migrate_id), 4)?
    list.append(mut raw, migrate_id)?
    be_word(mut raw, list.len(handles_id), 4)?
    list.append(mut raw, handles_id)?
    let mut hash = std.sha256.start()
    std.sha256.add(mut hash, raw, 0, list.len(raw))
    let digest = std.sha256.finish(hash)
    let mut identity: Bytes = list.with_capacity(32)?
    for byte in digest { result.capacity_only(list.push(mut identity, byte))? }
    Ok(take identity)
}

pub type PrepareError: send = Open(OpenError) | Deploy(store.DeployError) | Identity

pub type PrepareConfig[G: send, H: send] {
    scratch: Dir,
    options: store.Options,
    attempt: Bytes,
    image_digest: Bytes,
    clock: Clock,
    tasks: Tasks,
    n_place: u64,
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]],
    migrate: StaticFn[fn(mut store.Migration) -> Result[(), store.Error] waits],
    handles: StaticFn[fn(store.Schema) -> Result[H, store.Error]]
}

pub type PrepareArgs { attempt: Bytes, digest: Bytes }

pub fn launch_prepare_args(a: Args) -> Result[Option[PrepareArgs], Exit] {
    let Some(mode) = args.get(a, 0u64) else { return Ok(None) }
    if mode != "--hirsel-prepare" { return Ok(None) }
    let invalid = Exit(status: 1u8)
    if args.len(a) != 4u64 { return Error(invalid) }
    let Some(attempt_text) = args.get(a, 2u64) else { return Error(invalid) }
    let Some(image_text) = args.get(a, 3u64) else { return Error(invalid) }
    let attempt = std.base64.decode(string.as_bytes(attempt_text))
    let digest = std.base64.decode(string.as_bytes(image_text))
    match (take attempt, take digest) {
        (Ok(Some(take ticket)), Ok(Some(take image))) => {
            if list.len(ticket) != 16 || list.len(image) != 32 { return Error(invalid) }
            Ok(Some(PrepareArgs(attempt: take ticket, digest: take image)))
        },
        _ => Error(invalid),
    }
}

fn prepare_result[T](take outcome: Result[T, store.DeployError]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Deploy(take reason)),
    }
}

fn prepare_open_result[T](take outcome: Result[T, store.Error]) -> Result[T, PrepareError] {
    match take outcome {
        Ok(take answer) => Ok(take answer),
        Error(take reason) => Error(Open(Store(take reason))),
    }
}

// The process receives its export directory as a scratch capability. It
// creates no listener or live-store lock.
pub fn prepare_deploy[G: send, H: send](p: PrepareConfig[G, H]) -> Result[(), PrepareError] waits {
    let source = prepare_result(store.open_export(p.scratch, p.clock, p.attempt, p.options))?
    let digest = match launch_digest() {
        Ok(take hash) => take hash,
        Error(c) => return Error(Open(Store(Full(c)))),
    }
    if list.len(digest) != 32 || digest != p.image_digest { return Error(Identity) }
    let registered = match placed(p.place, p.n_place) {
        Ok(take reg) => take reg,
        Error(take error) => return Error(Open(Place(take error))),
    }
    if let Error(take problem) = activation_identity(code.identity(p.place), code.identity(p.migrate), code.identity(p.handles)) {
        return Error(Open(take problem))
    }
    let staged = match store.stage_export_migration(source, p.tasks, p.migrate) {
        Ok(take staged) => take staged,
        Error(take error) => return Error(Open(Migrate(take error))),
    }
    let _ = prepare_open_result(store.with_staged_schema(staged, p.handles))?
    let _ = prepare_open_result(store.with_staged_schema(staged, p.handles))?
    if let Error(take problem) = store.validate_preparation(source, staged) { return Error(Open(Store(take problem))) }
    let payload = prepare_activation(registered, p.n_place)
    let (take description, take record) = match take payload {
        Ok(take answer) => take answer,
        Error(c) => return Error(Open(Store(Full(c)))),
    }
    let ReleaseRecord(release: take release, digest: take image) = take record
    let target = store.PreparedTarget(describe: take description, release: take release, digest: take image,
        resident_limit: p.options.resident_limit, checkpoint_task_bytes: p.options.checkpoint_task_bytes)
    prepare_result(store.write_prepared(source, staged, p.scratch, take target))
}

fn target_release(target: store.PreparedTarget) -> Result[ReleaseRecord, store.DeployError] {
    let codec: std.codec.Codec[Describe] = std.codec.of()
    let decoded = std.codec.decode(codec, target.describe)
    let description = match take decoded {
        Ok(Ok(take description)) => take description,
        Ok(Error(_)) => return Error(ImportMalformed),
        Error(c) => return Error(Store(Full(c))),
    }
    if description.digest != target.digest { return Error(ImportMalformed) }
    let answer = release_digest(description.exported)
    let release = match take answer {
        Ok(take release) => take release,
        Error(c) => return Error(Store(Full(c))),
    }
    if release != target.release { return Error(ImportMalformed) }
    let digest: Result[Bytes, Capacity] = clone(target.digest)
    match take digest {
        Ok(take image) => Ok(ReleaseRecord(release: take release, digest: take image)),
        Error(c) => Error(Store(Full(c))),
    }
}

fn cutover_store[G: send, H: send](mut db: store.Db, request: store.Cutover, reg: Registry[G, H], n_place: u64) -> Result[u64, store.DeployError] waits {
    let description = match prepare_activation(reg, n_place) {
        Ok((take description, _)) => take description,
        Error(c) => { store.release_export(mut db, request.attempt); return Error(Store(Full(c))) },
    }
    let selected = current_description(db)
    match take selected {
        Ok(Some(known)) => if known != description { store.release_export(mut db, request.attempt); return Error(Drift) },
        Ok(None) => { store.release_export(mut db, request.attempt); return Error(Drift) },
        Error(take problem) => { store.release_export(mut db, request.attempt); return Error(Store(take problem)) },
    }
    let version = match activation_version(db) {
        Ok(version) => version,
        Error(take problem) => { store.release_export(mut db, request.attempt); return Error(Store(take problem)) },
    }
    let codec: std.codec.Codec[ReleaseRecord] = std.codec.of()
    store.perform_cutover(mut db, request, version, description, codec, target_release)
}

pub type CutoverOutcome = Installed(u64, Result[(), store.Error]) | Refused(store.DeployError, store.Db)

// The request reaches this point only after the head settles its admitted
// calls. Once installed, the callback retires publication and the sessions;
// the caller cannot regain a writer for the old image.
pub fn cutover[G: send, H: send](take db: store.Db, request: store.Cutover, reg: Registry[G, H], n_place: u64,
    retire: scoped fn(u64) -> () waits) -> CutoverOutcome waits {
    let mut owned = take db
    match cutover_store(mut owned, request, reg, n_place) {
        Ok(version) => {
            retire(version)
            Installed(version, store.close(take owned))
        },
        Error(take problem) => Refused(take problem, take owned),
    }
}

fn closing_at(drain: Latest[Option[DrainWindow]], clock: Clock) -> bool {
    match drain_window(latest.read(drain)) { Some(window) => host.mono_ns(clock) >= window.admission, None => false }
}

fn drain_window(window: Option[DrainWindow]) -> Option[DrainWindow] { window }

fn head_next(inbox: HeadRequests, waiting: bool) -> Option[HeadInput] waits {
    match inbox {
        DirectRequests(from) => if waiting {
            match channel.receive(from) { Ok(take req) => Some(RunRequest(take req)), _ => None }
        } else { match channel.try_receive(from) { Ok(take req) => Some(RunRequest(take req)), _ => None } },
        ManagedRequests(from) => if waiting {
            match channel.receive(from) { Ok(take req) => Some(take req), _ => None }
        } else { match channel.try_receive(from) { Ok(take req) => Some(take req), _ => None } },
    }
}

// H3's group ends when the inbox stays empty while every task that was ready
// has had its turn: arrivals that a reader or owner is already carrying join
// this group instead of each paying a durable, a Release and a fan-out round.
// A try_receive that finds Empty is a poll, and the head yields to ready tasks
// only when its polls end a CONC-10 turn (64 polls). The bound is one full
// turn, so every settle crosses a turn boundary before the gate; at 32 half
// the groups gate without yielding, and 1,000 clients at 500 calls/s fall
// behind.
const SETTLE_PROBES: u64 = 64

fn settle_probe(inbox: HeadRequests) -> Option[HeadInput] waits {
    let mut polls = 0u64
    while polls < SETTLE_PROBES {
        if let Some(take more) = head_next(inbox, false) { return Some(take more) }
        polls += 1u64
    }
    None
}

fn close_head_admission[G: send, H: send](mut head: Head[G, H]) -> Result[(), store.Error] waits {
    let waiting = replace(mut head.waiting, list.new())
    for take entry in take waiting {
        let Waiting(req: take req, parked: _) = take entry
        commitless(mut head, take req, Refused(Overloaded))?
    }
    Ok(())
}

fn serve_head[G: send, H: send](mut head: Head[G, H], take inbox: HeadRequests, take drain: Option[HeadDrain]) -> Result[(), store.Error] waits {
    let mut closed = false
    let mut settled = false
    let mut input: Option[HeadInput] = None
    loop {
        if head.cut { return Ok(()) }
        if let Some(control) = drain {
            if let Ok(()) = channel.try_receive(control.finish) { return Ok(()) }
            if let Some(_) = drain_window(latest.read(control.window)) {
                // A drain cuts running attempts. Their current rows stay until
                // the next open, which starts a higher attempt.
                if let Some(take scheduled) = replace(mut head.trigger_drive, None) { stop_triggers(take scheduled) }
            }
            if !closed && closing_at(control.window, control.clock) {
                closed = true
                close_head_admission(mut head)?
            }
            if closed && !settled && list.len(head.group) == 0u64 {
                let _ = channel.send(control.events, Settled)
                settled = true
            }
        }
        if !closed && advance_triggers(mut head)? { continue }
        let next = match replace(mut input, None) {
            Some(take next) => Some(take next),
            None => head_next(inbox, false),
        }
        match take next {
            Some(RunRequest(take req)) => { head_arrival(mut head, take req, closed)?; continue },
            Some(HeadClose) => { if !closed { closed = true; close_head_admission(mut head)? }; continue },
            Some(HeadFinish) => return Ok(()),
            Some(TriggerWake(at)) => { clear_trigger_timer(mut head, at); continue },
            Some(TriggerMessage(take message)) => { trigger_message(mut head, take message, closed)?; continue },
            Some(TriggerDone(a, take outcome)) => { trigger_done(mut head, a, take outcome, closed)?; continue },
            Some(_) => continue,
            None => (),
        }
        if !closed && next_waiting(mut head)? { continue }
        if list.len(head.group) > 0u64 {
            if let Some(take more) = settle_probe(inbox) { input = Some(take more); continue }
            gate(mut head)?
            continue
        }
        match head_next(inbox, true) { Some(take message) => { input = Some(take message) }, None => return Ok(()) }
    }
}

fn head_arrival[G: send, H: send](mut hd: Head[G, H], take message: Req, closed: bool) -> Result[(), store.Error] waits {
    let Req(e: take e) = take message
    match take e {
        Requested(take q) => {
            refresh_waiting(mut hd, true)
            if latest.read(q.live).active {
                let mut req = take q
                if latest.read(req.identity).number == 0u64 {
                    hd.minted += 1u64
                    let number = hd.minted
                    let mut id = option.unwrap(replace(mut req.seed, None))
                    let _ = arc.with_unique(mut id, scoped fn(mut value: OwnerNumber) { value.number = number })
                    latest.publish(req.identity, take id)
                    if !latest.read(req.live).active {
                        return Ok(())
                    }
                }
                route_admission(mut hd, take req, closed)?
            }
        },
        OwnerLeft => refresh_waiting(mut hd, false),
    }
    Ok(())
}

// Read the owner's mark before keeping an old request or admitting replacement work.
fn refresh_waiting[G: send, H: send](mut hd: Head[G, H], unpark: bool) {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        if !latest.read(hd.waiting[i].req.live).active {
            let _ = list.remove(mut hd.waiting, i)
        } else {
            if unpark {
                hd.waiting[i].parked = false
            }
            i += 1u64
        }
    }
}

// H1: a request for its stream's worker position joins the waiters if its digest equals the
// worker's, and is otherwise answered Refused(RequestMismatch) as V3 without running (v2.11.3);
// another position waits.
fn route_admission[G: send, H: send](mut hd: Head[G, H], take q: Request, closed: bool) -> Result[(), store.Error] waits {
    let running = match map.get(hd.busy, q.stream) {
        Some(w) => Some((w.p, w.digest == q.digest)),
        None => None,
    }
    match running {
        Some((p, same)) => if p == q.p && !same {
            commitless(mut hd, take q, Refused(RequestMismatch))
        } else if p == q.p {
            let owner = latest.read(q.identity).number
            let Request(caller: _, stream: take stream, p: _, key: _, arg: _, digest: _, reply_to: take to, live: _, identity: _, seed: _) = take q
            let mut w = match map.remove(mut hd.busy, stream) {
                Some(take x) => take x,
                None => return Ok(()),
            }
            result.unwrap(list.push(mut w.waiters, Recipient(owner: owner, to: take to)))
            result.unwrap(map.insert(mut hd.busy, take stream, take w))
            Ok(())
        } else if closed {
            commitless(mut hd, take q, Refused(Overloaded))
        } else {
            result.unwrap(list.push(mut hd.waiting, Waiting(req: take q, parked: false)))
            Ok(())
        },
        None => if closed { commitless(mut hd, take q, Refused(Overloaded)) } else { begin(mut hd, take q) },
    }
}

// The first unparked waiting request whose stream has no worker starts.
fn next_waiting[G: send, H: send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    let mut i = 0u64
    while i < list.len(hd.waiting) {
        if !hd.waiting[i].parked && !map.contains(hd.busy, hd.waiting[i].req.stream) {
            let Waiting(req: take q, parked: _) = list.remove(mut hd.waiting, i)
            if latest.read(q.live).active {
                begin(mut hd, take q)?
                return Ok(true)
            }
            continue
        }
        i += 1u64
    }
    Ok(false)
}

// H2 on the store's admit (STORE-SPEC v2.24). Below latest the store cannot say whether p
// ran these bytes (AH2), and at latest another digest is not this request (AH1): both are
// answered commitless (V3), Refused(HistoryUnavailable) or Refused(RequestMismatch), and
// neither marks the stream.
fn begin[G: send, H: send](mut hd: Head[G, H], take q: Request) -> Result[(), store.Error] waits {
    let a = match store.admit(mut hd.db, q.stream, q.p, q.digest) {
        Ok(take x) => take x,
        Error(Full(_)) => return commitless(mut hd, take q, Refused(Overloaded)),
        Error(e) => return Error(e),
    }
    match take a {
        Admitted(take complete) => execute(mut hd, take q, take complete),
        Abandoned(take complete) => execute(mut hd, take q, take complete),
        Duplicate(stored) => duplicate_reply(mut hd, take q, stored),
        Rejected(_) => {
            result.unwrap(list.push(mut hd.waiting, Waiting(req: take q, parked: true)))
            Ok(())
        },
        HistoryUnavailable => commitless(mut hd, take q, Refused(HistoryUnavailable)),
        RequestMismatch => commitless(mut hd, take q, Refused(RequestMismatch)),
    }
}

fn copy_bytes(b: Bytes) -> Result[Bytes, store.Error] {
    let mut out: Bytes = list.new()
    match list.append(mut out, b) {
        Ok(()) => Ok(take out),
        Error(c) => Error(Full(c)),
    }
}

fn be_word(mut raw: Bytes, value: u64, width: u64) -> Result[(), Capacity] {
    for i in 0u64 .. width {
        result.capacity_only(list.push(mut raw, int.truncate(value >> int.truncate(8 * (width - 1 - i)))))?
    }
    Ok(())
}

// CALL's code (RUNNER-SPEC §7): u64 n ‖ u64 s, big-endian, then the replay identity.
fn code_bytes(n: u64, s: u64, replay_identity: Bytes) -> Result[Bytes, Capacity] {
    let mut raw: Bytes = list.with_capacity(16 + list.len(replay_identity))?
    be_word(mut raw, n, 8)?
    be_word(mut raw, s, 8)?
    list.append(mut raw, replay_identity)?
    Ok(take raw)
}

fn record_request(q: Request, revision: Option[Bytes], n: u64, s: u64, replay_identity: Bytes) -> Result[store.CallRecord, store.Error] {
    let rev = match revision { Some(bytes_in) => Some(copy_bytes(bytes_in)?), None => None }
    let code = match code_bytes(n, s, replay_identity) {
        Ok(take bytes_in) => take bytes_in,
        Error(problem) => return Error(Full(problem)),
    }
    Ok(store.CallRecord(key: copy_bytes(q.key)?, args: copy_bytes(q.arg)?, stream: copy_bytes(q.stream)?, revision: take rev, code: take code))
}

fn encode_entry_reply(mut tx: store.Tx, take result: Ran) -> Result[Bytes, Bytes] {
    let (keep, take outcome): (bool, Outcome) = match take result {
        Commit(take raw) => (true, Returned(take raw)),
        Abort(take raw) => (false, Returned(take raw)),
        Refuse(take reason) => (false, Refused(take reason)),
        Exhausted(problem) => {
            store.body_capacity(mut tx, problem)
            return Error(list.new())
        },
    }
    match encode_runner_reply(outcome) {
        Ok(take wire_bytes) => if keep { Ok(take wire_bytes) } else { Error(take wire_bytes) },
        Error(Full(problem)) => { store.body_capacity(mut tx, problem); Error(list.new()) },
        Error(_) => fail("runner: reply encoding failed"),
    }
}

fn failed_stop(stop: store.Stop) -> Outcome {
    match stop {
        Raised(reason) => Failed(Raised(reason)),
        OutOfSteps(steps) => Failed(OutOfTime(steps)),
        OutOfBytes(problem) => Failed(OutOfBytes(room(problem))),
    }
}

type Effect = Served(Result[store.Served, store.ServeError]) | Unregistered(store.Pending)

fn run_effect[G: send, H: send](mut db: store.Db, identity: Bytes, locations: Registry[G, H],
        handles: H, q: Request, take complete: store.Completion) -> Result[Effect, store.Error] waits {
    match map.get(locations.slots, q.key) {
        Some(Transact(n, s, revision, _, go)) => {
            let rec = record_request(q, revision, n, s, identity)?
            // The stored Outcome adds a four-byte tag and a four-byte length.
            let plan = store.Plan(n_e: n, s_e: s, reply_max: MAX_RETURNED_BYTES + 8u64)
            Ok(Served(store.serve(mut db, take complete, plan, Some(take rec),
                scoped fn(mut tx: store.Tx) -> Result[Bytes, Bytes] {
                    let outcome = go(mut tx, handles, q.caller, q.arg)
                    encode_entry_reply(mut tx, take outcome)
                })))
        },
        _ => {
            let attempted = store.next_call_info(db)
            Ok(Unregistered(store.untried(take complete, None, attempted)))
        },
    }
}

fn execute[G: send, H: send](mut hd: Head[G, H], take q: Request, take complete: store.Completion) -> Result[(), store.Error] waits {
    let tried = run_effect(mut hd.db, hd.replay_identity, hd.r, hd.h, q, take complete)
    let ran = match take tried {
        Ok(Served(take result)) => take result,
        Ok(Unregistered(take pending_run)) => return reply_only(mut hd, take q, take pending_run, Failed(Gone)),
        Error(Full(_)) => return commitless(mut hd, take q, Refused(Overloaded)),
        Error(take problem) => return Error(take problem),
    }
    match take ran {
        Ok(Committed(take receipt)) => answered(mut hd, take q, take receipt),
        Ok(Kept(take receipt)) => answered(mut hd, take q, take receipt),
        Ok(Failed(take pending_run, stop)) => reply_only(mut hd, take q, take pending_run, failed_stop(stop)),
        Ok(NoRoom(_, _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(Full(_))) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(take problem)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
    }
}

fn answered[G: send, H: send](mut hd: Head[G, H], take q: Request, take receipt: store.Receipt) -> Result[(), store.Error] {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let version = store.version(store.snapshot(hd.db))
    match std.codec.decode(co, receipt.reply) {
        Ok(Ok(take outcome)) => worker(mut hd, take q, take outcome, receipt.ticket, version),
        _ => fail("runner: stored reply did not decode"),
    }
}

fn reply_only[G: send, H: send](mut hd: Head[G, H], take q: Request, take pending_run: store.Pending, take outcome: Outcome) -> Result[(), store.Error] waits {
    let wire_bytes = encode_runner_reply(outcome)?
    let settled = store.conclude(mut hd.db, take pending_run, take wire_bytes, Resident)
    match take settled {
        Ok(Committed(receipt)) => {
            let version = store.version(store.snapshot(hd.db))
            worker(mut hd, take q, take outcome, receipt.ticket, version)
        },
        Ok(NoRoom(_, _)) => commitless(mut hd, take q, Refused(Overloaded)),
        Error(Before(take problem)) => Error(take problem),
        Error(After(take problem)) => Error(take problem),
        _ => fail("runner: invalid conclude outcome"),
    }
}

fn duplicate_reply[G: send, H: send](mut hd: Head[G, H], take q: Request, stored: store.Stored) -> Result[(), store.Error] waits {
    let co: std.codec.Codec[Outcome] = std.codec.of()
    let outcome = match std.codec.decode(co, stored.reply) {
        Ok(Ok(take value)) => take value,
        _ => fail("runner: a stored reply does not decode"),
    }
    // A duplicate gets its saved reply as it was committed (ruling 73 as amended).
    commitless(mut hd, take q, take outcome)
}

fn worker[G: send, H: send](mut hd: Head[G, H], take q: Request, take o: Outcome, t: store.Ticket, version: u64) -> Result[(), store.Error] {
    let owner = latest.read(q.identity).number
    let Request(caller: _, stream: take stream, p: p, key: _, arg: _, digest: d, reply_to: take to, live: _, identity: _, seed: _) = take q
    let mut waiters: List[Recipient] = list.new()
    result.unwrap(list.push(mut waiters, Recipient(owner: owner, to: take to)))
    let named: Bytes = result.unwrap(clone(stream))
    result.unwrap(map.insert(mut hd.busy, take named, Worker(p: p, digest: d, version: version, outcome: take o, waiters: take waiters)))
    result.unwrap(list.push(mut hd.group, take stream))
    hd.last = Some(t)
    Ok(())
}

// V3: a commitless answer goes at once, in a snapshot-less Release behind every earlier
// Release on the one FIFO to the publisher.
fn commitless[G: send, H: send](mut hd: Head[G, H], take q: Request, take o: Outcome) -> Result[(), store.Error] waits {
    let owner = latest.read(q.identity).number
    let Request(caller: _, stream: take stream, p: p, key: _, arg: _, digest: _, reply_to: take to, live: _, identity: _, seed: _) = take q
    let mut answers: List[Answer] = list.new()
    result.unwrap(list.push(mut answers, Answer(recipient: Recipient(owner: owner, to: take to), row: KeyedDone(stream: take stream, p: p, outcome: take o))))
    if let Error(_) = channel.send(hd.out, PubIn(e: Released(Release(version: 0u64, snapshot: None, answers: take answers)))) { hd.cut = true }
    Ok(())
}

// H3, V4: one durable and one Release for the group, with every worker's answer
// in commit order. The publisher can now expose the version in one update per owner.
fn gate[G: send, H: send](mut hd: Head[G, H]) -> Result[(), store.Error] waits {
    if let Some(t) = replace(mut hd.last, None) {
        store.durable(mut hd.db, t)?
    }
    let d = store.version(store.snapshot(hd.db))
    let group = replace(mut hd.group, list.new())
    let mut answers: List[Answer] = list.new()
    for stream in group {
        let w = match map.remove(mut hd.busy, stream) {
            Some(take x) => take x,
            None => continue,
        }
        let Worker(p: p, digest: _, version: _, outcome: take o, waiters: take waiters) = take w
        for take recipient in waiters {
            let s: Bytes = result.unwrap(clone(stream))
            let each: Outcome = result.unwrap(clone(o))
            result.unwrap(list.push(mut answers, Answer(recipient: take recipient, row: KeyedDone(stream: take s, p: p, outcome: take each))))
        }
    }
    if let Error(_) = channel.send(hd.out, PubIn(e: Released(Release(version: d, snapshot: Some(store.snapshot(hd.db)), answers: take answers)))) { hd.cut = true }
    refresh_waiting(mut hd, true)
    Ok(())
}

// These messages travel on the existing head inbox, so a run can only write
// through the same writer that starts and finishes attempts.
pub type TriggerCallError: send = Closed | Capacity(Capacity) | Store(store.Error) | StaleAttempt | Cancelled

pub type FencedRefusal: send = Refusal(TriggerCallError) | BodyOutcome(Outcome)

type TriggerAction: send =
    Invoke(triggers.Attempt, Bytes, Bytes, Sender[Result[Outcome, TriggerCallError]])
    | Boundary(triggers.Attempt, Sender[Result[(), TriggerCallError]])
    | MarkHold(triggers.Attempt, u64, Bytes, Bytes, Sender[Result[(), TriggerCallError]])

pub opaque type TriggerInput: send { action: TriggerAction }

pub fn trigger_attempt(ctx: TriggerContext) -> triggers.Attempt { ctx.attempt }

fn trigger_request[P, R: send](ctx: TriggerContext, take payload: P, message: fn(triggers.Attempt, take P, take Sender[Result[R, TriggerCallError]]) -> TriggerAction) -> Result[R, TriggerCallError] waits {
    let made: Result[(Sender[Result[R, TriggerCallError]], Receiver[Result[R, TriggerCallError]]), Capacity] = channel.new(1u64)
    let (to, from) = match take made {
        Ok(take pair) => take pair,
        Error(cap) => return Error(Capacity(cap)),
    }
    let request = TriggerInput(action: message(ctx.attempt, take payload, take to))
    let msg = match box.new(take request) {
        Ok(take item) => take item,
        Error((cap, _)) => return Error(Capacity(cap)),
    }
    if let Error(_) = channel.send(ctx.to, TriggerMessage(take msg)) { return Error(Closed) }
    match channel.receive(from) { Ok(take answer) => take answer, Error(_) => Error(Closed) }
}

pub fn trigger_call(ctx: TriggerContext, take key: Bytes, take arg: Bytes) -> Result[Outcome, TriggerCallError] waits {
    trigger_request(ctx, (take key, take arg), fn(a: triggers.Attempt, take p: (Bytes, Bytes), take to: Sender[Result[Outcome, TriggerCallError]]) -> TriggerAction {
        let (take wanted, take value) = take p
        Invoke(a, take wanted, take value, take to)
    })
}

pub fn trigger_boundary(ctx: TriggerContext) -> Result[(), TriggerCallError] waits {
    trigger_request(ctx, (), fn(a: triggers.Attempt, take p: (), take to: Sender[Result[(), TriggerCallError]]) -> TriggerAction {
        Boundary(a, take to)
    })
}

pub fn trigger_hold(ctx: TriggerContext, step_index: u64, take expected: Bytes, take actual: Bytes) -> Result[(), TriggerCallError] waits {
    trigger_request(ctx, (step_index, take expected, take actual), fn(a: triggers.Attempt, take p: (u64, Bytes, Bytes), take to: Sender[Result[(), TriggerCallError]]) -> TriggerAction {
        let (position, take wanted, take observed) = take p
        MarkHold(a, position, take wanted, take observed, take to)
    })
}

type GrantRequest[G: send]: send { ctx: TriggerContext, reply: Sender[Result[G, Capacity]] }
type GrantWorker[G: send, S: send]: send {
    grants: S,
    grant: fn(S, take TriggerContext) -> Result[G, Capacity] waits,
    inbox: Receiver[GrantRequest[G]],
}

fn supply_grants[G: send, S: send](take supply: GrantWorker[G, S]) -> () waits {
    // A grant callback may wait. Keep it off the head that serves its context.
    while let Ok(take request) = channel.receive(supply.inbox) {
        let GrantRequest(ctx: take ctx, reply: take reply) = take request
        let given = (supply.grant)(supply.grants, take ctx)
        let _ = channel.send(reply, take given)
    }
}

fn attempt_grants[G: send](to: Sender[GrantRequest[G]], take ctx: TriggerContext) -> Result[G, Outcome] waits {
    let pair: Result[(Sender[Result[G, Capacity]], Receiver[Result[G, Capacity]]), Capacity] = channel.new(1u64)
    let (reply, inbox) = match take pair {
        Ok(take value) => take value,
        Error(cap) => return Error(Failed(OutOfBytes(room(cap)))),
    }
    if let Error(_) = channel.send(to, GrantRequest(ctx: take ctx, reply: take reply)) {
        return Error(Failed(Gone))
    }
    match channel.receive(inbox) {
        Ok(Ok(take given)) => Ok(take given),
        Ok(Error(cap)) => Error(Failed(OutOfBytes(room(cap)))),
        Error(_) => Error(Failed(Gone)),
    }
}

type TriggerTimer: send { clock: Clock, deadline: u64, at: u64, to: Sender[HeadInput] }

type ArmedTimer { at: u64, task_handle: Task[()] }

type TriggerDrive[G: send] {
    tables: triggers.Tables,
    revision: Bytes,
    clock: Clock,
    tasks: Tasks,
    to: Sender[HeadInput],
    entries: triggers.Entries,
    author: Caller,
    grants: Sender[GrantRequest[G]],
    granting: Task[()],
    active: Map[triggers.Id, Task[Outcome]],
    timer: Option[ArmedTimer]
}

fn make_trigger_drive[G: send, S: send](db: store.Db, clock: Clock, tasks: Tasks, take to: Sender[HeadInput], revision: Bytes, take config: TriggerConfig[G, S]) -> Result[Box[TriggerDrive[G]], store.Error] {
    let tables = store.with_schema(db, code.describe(triggers.tables))?
    let image = match launch_digest() { Ok(take digest) => take digest, Error(cap) => return Error(Full(cap)) }
    let stamp = if list.len(image) == 0u64 { copy_bytes(revision)? } else { take image }
    let TriggerConfig(entries: take entries, author: take author, grants: take seed, grant: grant, grant_bytes: allowance) = take config
    let pair: Result[(Sender[GrantRequest[G]], Receiver[GrantRequest[G]]), Capacity] = channel.new(1u64)
    let (grants, inbox) = match take pair { Ok(take value) => take value, Error(cap) => return Error(Full(cap)) }
    let supply = GrantWorker(grants: take seed, grant: grant, inbox: take inbox)
    let granting = match task.spawn(tasks, bytes allowance, take supply, supply_grants) {
        Ok(take running) => take running,
        Error((cap, _)) => return Error(Full(cap)),
    }
    let drive = TriggerDrive(tables: take tables, revision: take stamp, clock: clock, tasks: tasks, to: take to,
        entries: take entries, author: take author, grants: take grants, granting: take granting, active: map.new(), timer: None)
    match box.new(take drive) {
        Ok(take scheduled) => Ok(take scheduled),
        Error((cap, _)) => Error(Full(cap)),
    }
}

fn fire_trigger_timer(take timer: TriggerTimer) -> () waits {
    host.sleep_until(timer.clock, timer.deadline)
    let _ = channel.send(timer.to, TriggerWake(timer.at))
}

fn stop_timer(take armed: ArmedTimer) -> () waits {
    let ArmedTimer(at: _, task_handle: take timer) = take armed
    let mut waiting = take timer
    task.cancel(mut waiting)
    let _ = task.join(take waiting)
}

fn arm_trigger_timer[G: send](mut drive: Box[TriggerDrive[G]], at: u64) -> Result[(), store.Error] waits {
    if let Some(armed) = drive.timer {
        if armed.at == at { return Ok(()) }
    }
    if let Some(take prior) = replace(mut drive.timer, None) { stop_timer(take prior) }
    // The clock's wait runs on monotonic time. Sample wall time again after
    // waking so a wall-clock correction cannot start a trigger early.
    let remaining = int.saturating_sub(at, host.wall_ms(drive.clock))
    // Recheck long waits so a wall-clock step forward is visible on an idle head.
    let delay = if remaining < 1000u64 { remaining } else { 1000u64 }
    let deadline = int.saturating_add(host.mono_ns(drive.clock), delay * 1000000u64)
    let timer = TriggerTimer(clock: drive.clock, deadline: deadline, at: at, to: channel.sender(drive.to))
    match task.spawn(drive.tasks, bytes 4096u64, take timer, fire_trigger_timer) {
        Ok(take waiting) => { drive.timer = Some(ArmedTimer(at: at, task_handle: take waiting)); Ok(()) },
        Error((cap, _)) => Error(Full(cap)),
    }
}

fn clear_trigger_timer[G: send, H: send](mut hd: Head[G, H], at: u64) -> () waits {
    let Some(take drive) = replace(mut hd.trigger_drive, None) else { return () }
    let mut owned = take drive
    let clear = match owned.timer { Some(armed) => armed.at == at, None => false }
    if clear {
        if let Some(take elapsed) = replace(mut owned.timer, None) { stop_timer(take elapsed) }
    }
    hd.trigger_drive = Some(take owned)
}

fn stop_triggers[G: send](take drive: Box[TriggerDrive[G]]) -> () waits {
    let TriggerDrive(active: take active, timer: take timer, granting: take granting, ..) = box.unbox(take drive)
    if let Some(take armed) = take timer { stop_timer(take armed) }
    for take (_, take watcher) in take active {
        let mut stopping = take watcher
        task.cancel(mut stopping)
        let _ = task.join(take stopping)
    }
    let mut supply = take granting
    task.cancel(mut supply)
    let _ = task.join(take supply)
}

fn trigger_key[G: send, H: send](r: Registry[G, H], p: triggers.Pending, choices: triggers.Entries) -> Result[Option[Bytes], store.Error] {
    if !triggers.is_allowed(p, choices) { return Ok(None) }
    for entry in r.exported {
        let matches_kind = match entry.described.kind {
            Granted => triggers.is_granted(p),
            Transact => !triggers.is_granted(p),
            _ => false,
        }
        if matches_kind && triggers.matches(p, entry.described.identity, entry.described.args) {
            let mut key = copy_bytes(entry.described.identity)?
            match std.codec.put_u64(entry.args_fp, mut key) { Ok(()) => (), Error(cap) => return Error(Full(cap)) }
            match std.codec.put_u64(entry.result_fp, mut key) { Ok(()) => (), Error(cap) => return Error(Full(cap)) }
            return Ok(Some(take key))
        }
    }
    Ok(None)
}

fn trigger_store_error(take problem: triggers.Error) -> store.Error {
    match take problem {
        Store(take underlying) => take underlying,
        AttemptLimit => Limit(Transaction),
        _ => Missing("trigger"),
    }
}

fn trigger_commit[R](take ran: Result[store.Outcome[R, triggers.Error], store.Error]) -> Result[store.Done[R], store.Error] {
    match take ran {
        Ok(Committed(take committed)) => Ok(take committed),
        Ok(Aborted(store.Undone(value: take problem, ..))) => Error(trigger_store_error(take problem)),
        Ok(Refused(cap)) => Error(Full(cap)),
        Error(take problem) => Error(take problem),
        _ => Error(Missing("trigger commit")),
    }
}

fn publish_trigger[G: send, H: send](mut hd: Head[G, H], ticket: store.Ticket) -> Result[(), store.Error] waits {
    hd.last = Some(ticket)
    gate(mut hd)
}

type TriggerBodyError: send = Store(triggers.Error) | Terminal(triggers.Terminal) | NotDue

fn trigger_terminal(take outcome: Outcome) -> triggers.Terminal {
    match take outcome {
        Returned(take raw) => Returned(take raw),
        Failed(Raised(reason)) => Raised(reason),
        Failed(OutOfTime(steps)) => OutOfTime(steps),
        Failed(OutOfBytes(cap)) => OutOfBytes(cap.requested, cap.available),
        Refused(Budget(cap)) => OutOfBytes(cap.requested, cap.available),
        _ => Gone,
    }
}

fn run_trigger_transaction[G: send, H: send](mut hd: Head[G, H], mut drive: Box[TriggerDrive[G]], p: triggers.Pending, take key: Option[Bytes]) -> Result[bool, store.Error] waits {
    let completed = invoke_trigger_transaction(mut hd.db, hd.r, hd.h, drive, p, key)?
    let final = match take completed {
        TriggerApplied(ticket) => { publish_trigger(mut hd, ticket)?; return Ok(true) },
        TriggerSettled(take outcome) => take outcome,
        TriggerNotDue => { arm_trigger_timer(mut drive, triggers.due_time(p))?; return Ok(false) },
    }
    // The draft that returned an error or fault left no writes. Only this
    // settlement commits, and it consumes the row with the outcome.
    let collected = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.finish_transact(mut tx, drive.tables, p, final)
    })
    let committed = trigger_commit(take collected)?
    publish_trigger(mut hd, committed.ticket)?
    Ok(true)
}

type TriggerDraft = TriggerApplied(store.Ticket) | TriggerSettled(triggers.Terminal) | TriggerNotDue

fn invoke_trigger_transaction[G: send, H: send](mut db: store.Db, r: Registry[G, H], h: H, drive: Box[TriggerDrive[G]], p: triggers.Pending, key: Option[Bytes]) -> Result[TriggerDraft, store.Error] waits {
    let slot = match key { Some(wanted) => map.get(r.slots, wanted), None => None }
    let terminal: triggers.Terminal = if let Some(Transact(n, steps, _, _, go)) = slot {
        let ran = store.run(mut db, Some(steps), scoped fn(mut tx: store.Tx) -> Result[(), TriggerBodyError] {
            // The wall can move backwards between the scheduler's sample
            // and this transaction. The body sees this CallInfo, so use it.
            if store.info(mut tx).at < triggers.due_time(p) { return Error(NotDue) }
            let body = bound bytes n { go(mut tx, h, drive.author, triggers.argument(p)) }
            let terminal: triggers.Terminal = match take body {
                Ok(Commit(take payload)) => Returned(take payload),
                Ok(Abort(take payload)) => return Error(Terminal(Returned(take payload))),
                Ok(Exhausted(cap)) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
                Ok(Refuse(_)) => return Error(Terminal(Gone)),
                Error(cap) => return Error(Terminal(OutOfBytes(cap.requested, cap.available))),
            }
            match triggers.finish_transact(mut tx, drive.tables, p, terminal) {
                Ok(()) => Ok(()),
                Error(take problem) => Error(Store(take problem)),
            }
        })
        match take ran {
            Ok(Committed(committed)) => return Ok(TriggerApplied(committed.ticket)),
            Ok(Aborted(store.Undone(value: Terminal(take terminal), ..))) => take terminal,
            Ok(Aborted(store.Undone(value: NotDue, ..))) => return Ok(TriggerNotDue),
            Ok(Aborted(store.Undone(value: Store(take problem), ..))) => return Error(trigger_store_error(take problem)),
            Ok(Failed(causes)) => Raised(raised(causes)),
            Ok(Stopped(limit)) => OutOfTime(limit.steps),
            Ok(Refused(cap)) => OutOfBytes(cap.requested, cap.available),
            Error(take problem) => return Error(take problem),
        }
    } else { Gone }
    Ok(TriggerSettled(take terminal))
}

type TriggerReport: send { attempt: triggers.Attempt, to: Sender[HeadInput] }

type WatchedJob[G: send, A, R]: send {
    job: Job[G, A, R], report: TriggerReport, tasks: Tasks, allowance: u64
}

fn watch_trigger[G: send, A, R](take watched: WatchedJob[G, A, R]) -> Outcome waits {
    let WatchedJob(job: take work, report: take report, tasks: tasks, allowance: n) = take watched
    let finished: Option[Outcome] = match task.spawn(tasks, bytes n, take work, adapt_granted) {
        Ok(take running) => match task.join(take running) {
            Ok(take outcome) => Some(take outcome),
            Error(Failed(causes)) => Some(Failed(Raised(raised(causes)))),
            Error(Cancelled(_)) => None,
        },
        Error((cap, _)) => Some(Failed(OutOfBytes(room(cap)))),
    }
    let _ = channel.send(report.to, TriggerDone(report.attempt, take finished))
    Abandoned
}

fn launch_trigger[G: send, H: send](r: Registry[G, H], mut drive: Box[TriggerDrive[G]], p: triggers.Pending, a: triggers.Attempt, key: Bytes) -> Result[(), Refusal] {
    let Some(Granted(go)) = map.get(r.slots, key) else { return Error(NoEntry) }
    match map.reserve(mut drive.active, 1u64) { Ok(()) => (), Error(cap) => return Error(Budget(room(cap))) }
    let context = TriggerContext(attempt: a, to: channel.sender(drive.to))
    let source = FromPlace(channel.sender(drive.grants), take context)
    let raw: Bytes = match copy_bytes(triggers.argument(p)) {
        Ok(take payload) => take payload,
        Error(Full(cap)) => return Error(Budget(room(cap))),
        Error(_) => return Error(NoEntry),
    }
    let notice = TriggerReport(attempt: a, to: channel.sender(drive.to))
    match go(drive.tasks, take source, take raw, Some(take notice)) {
        Ok(take watcher) => {
            result.unwrap(map.insert(mut drive.active, triggers.run_id(a), take watcher))
            Ok(())
        },
        Error(cap) => Error(Budget(room(cap))),
    }
}

fn finish_trigger[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], a: triggers.Attempt, outcome: triggers.Terminal) -> Result[(), store.Error] waits {
    let settled = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.finish(mut tx, drive.tables, a, outcome)
    })
    match take settled {
        Ok(Aborted(store.Undone(value: StaleAttempt, ..))) => Ok(()),
        other => {
            let committed = trigger_commit(take other)?
            publish_trigger(mut hd, committed.ticket)
        },
    }
}

fn advance_trigger[G: send, H: send](mut hd: Head[G, H], mut drive: Box[TriggerDrive[G]]) -> Result[bool, store.Error] waits {
    let snapshot = store.snapshot(hd.db)
    let next = triggers.next_pending(snapshot, drive.tables, scoped fn(id: triggers.Id) -> bool { map.contains(drive.active, id) })?
    let Some(take p) = take next else { return Ok(false) }
    let due = triggers.due_time(p)
    if store.next_call_info(hd.db).at < due {
        arm_trigger_timer(mut drive, due)?
        return Ok(false)
    }
    if let Some(_) = hd.last { gate(mut hd)? }
    if hd.cut { return Ok(false) }
    if triggers.cancelling(p) {
        let settled = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
            triggers.finish_cancel(mut tx, drive.tables, p)
        })
        let committed = trigger_commit(take settled)?
        publish_trigger(mut hd, committed.ticket)?
        return Ok(true)
    }
    let key = trigger_key(hd.r, p, drive.entries)?
    if !triggers.is_granted(p) {
        return run_trigger_transaction(mut hd, mut drive, p, take key)
    }
    let ran = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[triggers.Started, triggers.Error] {
        triggers.start(mut tx, drive.tables, p, drive.revision)
    })
    let committed = match take ran {
        Ok(Aborted(store.Undone(value: NotDue, ..))) => {
            arm_trigger_timer(mut drive, due)?
            return Ok(false)
        },
        other => trigger_commit(take other)?,
    }
    publish_trigger(mut hd, committed.ticket)?
    if hd.cut { return Ok(false) }
    match committed.value {
        Held => (),
        Body(a) => {
            if let Some(wanted) = key {
                if let Error(take problem) = launch_trigger(hd.r, mut drive, p, a, wanted) {
                    finish_trigger(mut hd, drive, a, trigger_terminal(Refused(take problem)))?
                }
            } else { finish_trigger(mut hd, drive, a, Gone)? }
        },
    }
    Ok(true)
}

fn advance_triggers[G: send, H: send](mut hd: Head[G, H]) -> Result[bool, store.Error] waits {
    let Some(take selected) = replace(mut hd.trigger_drive, None) else { return Ok(false) }
    let mut drive = take selected
    let advanced = advance_trigger(mut hd, mut drive)
    hd.trigger_drive = Some(take drive)
    take advanced
}

fn trigger_done[G: send, H: send](mut hd: Head[G, H], a: triggers.Attempt, take outcome: Option[Outcome], closed: bool) -> Result[(), store.Error] waits {
    let Some(take selected) = replace(mut hd.trigger_drive, None) else { return Ok(()) }
    let mut drive = take selected
    let watched = map.remove(mut drive.active, triggers.run_id(a))
    let completed = if let Some(take watcher) = take watched {
        let _ = task.join(take watcher)
        if let Some(take result) = take outcome {
            if !closed { finish_trigger(mut hd, drive, a, trigger_terminal(take result)) } else { Ok(()) }
        } else { Ok(()) }
    } else { Ok(()) }
    hd.trigger_drive = Some(take drive)
    take completed
}

fn trigger_message[G: send, H: send](mut hd: Head[G, H], take pending: Box[TriggerInput], closed: bool) -> Result[(), store.Error] waits {
    let TriggerInput(action: take action) = box.unbox(take pending)
    let Some(take drive) = replace(mut hd.trigger_drive, None) else { return Ok(()) }
    let result = answer_trigger(mut hd, drive, take action, closed)
    hd.trigger_drive = Some(take drive)
    take result
}

fn checked_boundary(take seen: Result[bool, triggers.Error]) -> Result[(), TriggerCallError] {
    match take seen {
        Ok(false) => Ok(()),
        Ok(true) => Error(Cancelled),
        Error(Store(take problem)) => Error(Store(take problem)),
        Error(_) => Error(StaleAttempt),
    }
}

fn answer_trigger[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], take action: TriggerAction, closed: bool) -> Result[(), store.Error] waits {
    if let Some(_) = hd.last { gate(mut hd)? }
    let stopped = closed || hd.cut
    match take action {
        Invoke(a, take key, take arg, take answer) => {
            let reply: Result[Outcome, TriggerCallError] =
                if stopped { Error(Closed) } else { trigger_effect(mut hd, drive.tables, drive.author, a, key, arg)? }
            let _ = channel.send(answer, take reply)
        },
        Boundary(a, take answer) => {
            let reply: Result[(), TriggerCallError] = if stopped { Error(Closed) } else {
                checked_boundary(triggers.boundary(store.snapshot(hd.db), drive.tables, a))
            }
            let _ = channel.send(answer, take reply)
        },
        MarkHold(a, position, take expected, take actual, take answer) => {
            let reply: Result[(), TriggerCallError] = if stopped { Error(Closed) } else {
                mark_trigger_hold(mut hd, drive, a, position, expected, actual)?
            }
            let _ = channel.send(answer, take reply)
        },
    }
    Ok(())
}

fn mark_trigger_hold[G: send, H: send](mut hd: Head[G, H], drive: Box[TriggerDrive[G]], a: triggers.Attempt, position: u64, expected: Bytes, actual: Bytes) -> Result[Result[(), TriggerCallError], store.Error] waits {
    let written = store.run(mut hd.db, None, scoped fn(mut tx: store.Tx) -> Result[(), TriggerCallError] {
        match triggers.hold(mut tx, drive.tables, a, position, expected, actual) {
            Ok(()) => Ok(()),
            Error(Store(take problem)) => Error(Store(take problem)),
            Error(CancelRequested) => Error(Cancelled),
            Error(_) => Error(StaleAttempt),
        }
    })
    match take written {
        Ok(Committed(done)) => { publish_trigger(mut hd, done.ticket)?; Ok(Ok(())) },
        Ok(Aborted(store.Undone(value: take problem, ..))) => Ok(Error(take problem)),
        Ok(Refused(cap)) => Ok(Error(Capacity(cap))),
        Error(take problem) => Error(take problem),
        _ => Error(Missing("trigger hold")),
    }
}

fn trigger_effect[G: send, H: send](mut hd: Head[G, H], trigger_tables: triggers.Tables, author: Caller, a: triggers.Attempt, key: Bytes, arg: Bytes) -> Result[Result[Outcome, TriggerCallError], store.Error] waits {
    let invoked = apply_attempt(mut hd.db, hd.r, hd.h, trigger_tables, author, a, key, arg)
    match take invoked {
        Ok(Committed(store.Done(value: take value, ticket: ticket, ..))) => {
            publish_trigger(mut hd, ticket)?
            Ok(Ok(take value))
        },
        Ok(Aborted(store.Undone(value: BodyOutcome(take outcome), ..))) => Ok(Ok(take outcome)),
        Ok(Aborted(store.Undone(value: Refusal(take problem), ..))) => Ok(Error(take problem)),
        Ok(Failed(causes)) => Ok(Ok(Failed(Raised(raised(causes))))),
        Ok(Stopped(limit)) => Ok(Ok(Failed(OutOfTime(limit.steps)))),
        Ok(Refused(cap)) => Ok(Error(Capacity(cap))),
        Error(take problem) => Error(take problem),
    }
}

// The W2 fixture calls the same release gate as trigger_message. It owns the
// database and reads the volatile head separately from the answer.
pub fn journal_attempt_gate(take db: store.Db, take registered: Registry[(), ()], t: triggers.Tables, a: triggers.Attempt, key: Bytes, arg: Bytes)
    -> (store.Db, u64, Result[Result[Outcome, TriggerCallError], store.Error]) waits {
    let output: Result[(Sender[PubIn], Receiver[PubIn]), Capacity] = channel.new(2u64)
    let (to, from) = result.unwrap(take output)
    let mut head = Head(db: take db, r: take registered, replay_identity: list.new(), h: (), out: take to,
        busy: map.new(), waiting: list.new(), group: list.new(), last: None, minted: 0u64, cut: false, trigger_drive: None)
    let response = trigger_effect(mut head, t, store.Caller(issuer: 0u8, subject: list.new()), a, key, arg)
    let at = store.version(store.snapshot(head.db))
    let Head(db: take kept, ..) = take head
    let _ = take from
    (take kept, at, take response)
}

pub fn apply_attempt[G: send, H: send](mut db: store.Db, registered: Registry[G, H], h: H, trigger_tables: triggers.Tables, author: Caller, a: triggers.Attempt, key: Bytes, arg: Bytes) -> Result[store.Outcome[Outcome, FencedRefusal], store.Error] waits {
    let slot = map.get(registered.slots, key)
    let steps = match slot { Some(Transact(_, limit, _, _, _)) => Some(limit), Some(Fenced(_, limit, _)) => Some(limit), _ => None }
    store.run(mut db, steps, scoped fn(mut tx: store.Tx) -> Result[Outcome, FencedRefusal] {
        match triggers.fence(tx, trigger_tables, a) {
            Ok(false) => (),
            Ok(true) => return Error(Refusal(Cancelled)),
            Error(StaleAttempt) => return Error(Refusal(StaleAttempt)),
            Error(Store(take problem)) => return Error(Refusal(Store(take problem))),
            Error(_) => return Error(Refusal(StaleAttempt)),
        }
        if let Some(Fenced(n, _, go)) = slot {
            let ran = bound bytes n { go(mut tx, a, arg) }
            return match take ran {
                Ok(Ok(take payload)) => Ok(Returned(take payload)),
                Ok(Error(take problem)) => Error(Refusal(Store(take problem))),
                Error(cap) => Error(Refusal(Capacity(cap))),
            }
        }
        if let Some(Transact(n, _, _, _, go)) = slot {
            let ran = bound bytes n { go(mut tx, h, author, arg) }
            match take ran {
                Ok(Commit(take payload)) => Ok(Returned(take payload)),
                Ok(Abort(take payload)) => Error(BodyOutcome(Returned(take payload))),
                Ok(Refuse(take refusal)) => Error(BodyOutcome(Refused(take refusal))),
                Ok(Exhausted(cap)) => Error(BodyOutcome(Failed(OutOfBytes(room(cap))))),
                Error(cap) => Error(BodyOutcome(Failed(OutOfBytes(room(cap))))),
            }
        } else { Error(BodyOutcome(Refused(NoEntry))) }
    })
}

type TriggerLawTables: send { effects: store.Table[u64, u64] }

fn trigger_law_migrate(mut phase: store.Migration) -> Result[(), store.Error] {
    triggers.migrate(mut phase)?
    let codec: std.codec.Codec[u64] = std.codec.of()
    store.migration_create_table(mut phase, store.spec("trigger-law-effects", std.codec.key_u64(), codec))
}

fn trigger_law_handles(catalog: store.Schema) -> Result[TriggerLawTables, store.Error] {
    let codec: std.codec.Codec[u64] = std.codec.of()
    let effects = store.schema_table(catalog, "trigger-law-effects", std.codec.key_u64(), codec)?
    Ok(TriggerLawTables(effects: take effects))
}

fn trigger_law_body(mut tx: store.Tx, h: TriggerLawTables, author: Caller, take digit: u64) -> Result[u64, u64] {
    let old = match result.unwrap(store.fetch(tx, store.shape(h.effects), 0u64)) { Some(value) => value, None => 0u64 }
    let next = old * 10u64 + digit
    result.unwrap(store.put(mut tx, h.effects, 0u64, next))
    if digit == 2u64 { return Error(22u64) }
    if digit == 3u64 { fail("trigger law: abort on fault") }
    if digit == 4u64 {
        let info = store.info(mut tx)
        result.unwrap(store.put(mut tx, h.effects, 1u64, info.at))
    }
    Ok(next)
}

fn trigger_law_grants(seed: (), take ctx: TriggerContext) -> Result[TriggerContext, Capacity] { Ok(take ctx) }

fn trigger_law_config(take entries: triggers.Entries) -> TriggerConfig[TriggerContext, ()] {
    TriggerConfig(entries: take entries, author: store.Caller(issuer: 0u8, subject: list.new()),
        grants: (), grant: trigger_law_grants, grant_bytes: 65536u64)
}

fn trigger_law_places(mut reg: Registry[TriggerContext, TriggerLawTables]) -> Result[(), RegisterError] {
    transact(mut reg, code.describe(trigger_law_body), 131072u64, DEFAULT_STEPS)?
    granted(mut reg, code.describe(trigger_law_granted_body), 131072u64, DEFAULT_STEPS)
}

fn trigger_law_initial(take db: store.Db, c: Clock, tasks: Tasks, take to: Sender[HeadInput], take allowed: triggers.Entries) -> (Head[TriggerContext, TriggerLawTables], Receiver[PubIn]) {
    let revision = result.unwrap(copy_bytes(string.as_bytes("trigger-law-r1")))
    let config = trigger_law_config(take allowed)
    let drive = result.unwrap(make_trigger_drive(db, c, tasks, take to, revision, take config))
    let reg = result.unwrap(placed(code.describe(trigger_law_places), 1048576u64))
    let h = result.unwrap(store.with_schema(db, code.describe(trigger_law_handles)))
    let output: Result[(Sender[PubIn], Receiver[PubIn]), Capacity] = channel.new(32u64)
    let (out, from) = result.unwrap(take output)
    let head = Head(db: take db, r: take reg, replay_identity: list.new(), h: take h, out: take out,
        busy: map.new(), waiting: list.new(), group: list.new(), last: None, minted: 0u64, cut: false,
        trigger_drive: Some(take drive))
    (take head, take from)
}

fn trigger_law_outcome[G: send, H: send](head: Head[G, H], id: triggers.Id) -> Option[triggers.Terminal] {
    match head.trigger_drive {
        Some(drive) => result.unwrap(triggers.outcome(store.snapshot(head.db), drive.tables, id)),
        None => None,
    }
}

fn trigger_law_value(head: Head[TriggerContext, TriggerLawTables]) -> Option[u64] {
    result.unwrap(store.get(store.snapshot(head.db), store.shape(head.h.effects), 0u64))
}

fn trigger_law_invoked(outcome: Option[triggers.Terminal], expected: Result[u64, u64]) -> bool {
    let Some(Returned(raw)) = view outcome else { return false }
    let codec: std.codec.Codec[Result[u64, u64]] = std.codec.of()
    match std.codec.decode(codec, raw) {
        Ok(Ok(value)) => match value {
            Ok(n) => match expected { Ok(want) => n == want, _ => false },
            Error(n) => match expected { Error(want) => n == want, _ => false },
        },
        _ => false,
    }
}

// ENDSTATE Triggers T1/T2 and Transact. A later-due row is written first,
// followed by AfterCommit, a typed error and a fault. The clock crosses T
// while the store is closed. The fault and error write a digit before failing,
// so only a rollback followed by outcome-only consumption leaves 14.
pub fn journal_law_trigger_transact(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = triggers.law_directory(d)
    let mut initial = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    result.unwrap(store.run_migration(mut initial, tasks, code.describe(trigger_law_migrate)))
    let tables = result.unwrap(store.with_schema(initial, code.describe(triggers.tables)))
    let target: triggers.Entry[u64] = result.unwrap(triggers.transact(code.describe(trigger_law_body)))
    let mut allowed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut allowed, target))
    let latest = store.next_call_info(initial).at + 10u64
    let written = store.run(mut initial, None, scoped fn(mut tx: store.Tx) -> Result[(triggers.Id, triggers.Id, triggers.Id, triggers.Id), triggers.Error] {
        let later = triggers.write(mut tx, tables, allowed, target, 4u64, At(latest))?
        let early = triggers.write(mut tx, tables, allowed, target, 1u64, AfterCommit)?
        let aborted = triggers.write(mut tx, tables, allowed, target, 2u64, At(latest))?
        let faulted = triggers.write(mut tx, tables, allowed, target, 3u64, At(latest))?
        Ok((early, later, aborted, faulted))
    })
    let committed = result.unwrap(trigger_commit(take written))
    let (early, later, aborted, faulted) = committed.value
    if later.index != 0u64 || early.index != 1u64 || aborted.index != 2u64 || faulted.index != 3u64 { return false }
    if early.version != committed.info.id.version || early.branch != committed.info.id.branch { return false }
    result.unwrap(store.durable(mut initial, committed.ticket))
    result.unwrap(store.close(take initial))
    while host.wall_ms(c) < latest {
        host.sleep_until(c, host.mono_ns(c) + 10000000u64)
    }

    let reopened = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    let inputs: Result[(Sender[HeadInput], Receiver[HeadInput]), Capacity] = channel.new(4u64)
    let (wake, inbox) = result.unwrap(take inputs)
    let (take built, take published) = trigger_law_initial(take reopened, c, tasks, take wake, take allowed)
    let mut head = take built
    let initial_version = store.version(store.snapshot(head.db))
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if !trigger_law_invoked(trigger_law_outcome(head, early), Ok(1u64)) { return false }
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if !trigger_law_invoked(trigger_law_outcome(head, later), Ok(14u64)) { return false }
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if !trigger_law_invoked(trigger_law_outcome(head, aborted), Error(22u64)) { return false }
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if let Some(Raised(5u32)) = trigger_law_outcome(head, faulted) { } else { return false }
    if trigger_law_value(head) != Some(14u64) { return false }
    let final_snapshot = store.snapshot(head.db)
    if store.version(final_snapshot) != initial_version + 4u64 { return false }
    let at = result.unwrap(store.get(final_snapshot, store.shape(head.h.effects), 1u64))
    if let Some(seen) = at { if seen < latest { return false } } else { return false }
    if result.unwrap(advance_triggers(mut head)) { return false }
    let Head(db: take kept, ..) = take head
    result.unwrap(store.close(take kept))

    let mut recovered = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    let recovered_tables = result.unwrap(store.with_schema(recovered, code.describe(triggers.tables)))
    let due = result.unwrap(triggers.next_pending(store.snapshot(recovered), recovered_tables, fn(id: triggers.Id) -> bool { false }))
    if let Some(_) = due { return false }
    if let Some(Raised(5u32)) = result.unwrap(triggers.outcome(store.snapshot(recovered), recovered_tables, faulted)) { } else { return false }
    result.unwrap(store.close(take recovered))
    true
}

@test
fn journal_test_trigger_transact(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_trigger_transact(d, c, r, tasks) { Ok(()) } else { Error(()) }
}

fn trigger_law_entry_key() -> Result[Bytes, Capacity] {
    let args: std.codec.Codec[u64] = std.codec.of()
    let returned: std.codec.Codec[Result[u64, u64]] = std.codec.of()
    let (take key, _) = described(code.identity(code.describe(trigger_law_body)), None, Transact, args, returned)?
    Ok(take key)
}

fn trigger_law_argument(n: u64) -> Result[Bytes, Capacity] {
    let mut raw: Bytes = list.new()
    std.codec.put_u64(n, mut raw)?
    Ok(take raw)
}

fn trigger_law_granted_body(ctx: TriggerContext, take digit: u64) -> Result[u64, Capacity] waits {
    match trigger_boundary(ctx) {
        Ok(()) => (),
        Error(Cancelled) => return Ok(0u64),
        _ => fail("trigger law: unexpected boundary result"),
    }
    if digit == 5u64 {
        let expected = trigger_law_argument(1u64)?
        let actual = trigger_law_argument(2u64)?
        result.unwrap(trigger_hold(ctx, 3u64, take expected, take actual))
        return Ok(0u64)
    }
    let key = trigger_law_entry_key()?
    let arg = trigger_law_argument(digit)?
    match trigger_call(ctx, take key, take arg) {
        Ok(Returned(_)) => Ok(triggers.number(trigger_attempt(ctx))),
        Error(Cancelled) => Ok(0u64),
        _ => fail("trigger law: unexpected fenced call result"),
    }
}

// ENDSTATE granted Start/End and steps law 7. After the start is durable,
// close before a body can write. Reopen and run attempt 2, then try the old
// attempt's write during attempt 2. The first attempt must have changed no row,
// the late write must be refused, and exactly one terminal outcome must remain.
pub fn journal_law_trigger_granted(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = triggers.law_directory(d)
    let mut initial = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    result.unwrap(store.run_migration(mut initial, tasks, code.describe(trigger_law_migrate)))
    let t = result.unwrap(store.with_schema(initial, code.describe(triggers.tables)))
    let target: triggers.Entry[u64] = result.unwrap(triggers.granted(code.describe(trigger_law_granted_body)))
    let mut allowed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut allowed, target))
    let armed = store.run(mut initial, None, scoped fn(mut tx: store.Tx) -> Result[triggers.Id, triggers.Error] {
        triggers.write(mut tx, t, allowed, target, 7u64, AfterCommit)
    })
    let committed = result.unwrap(trigger_commit(take armed))
    result.unwrap(store.durable(mut initial, committed.ticket))
    let first_inputs: Result[(Sender[HeadInput], Receiver[HeadInput]), Capacity] = channel.new(4u64)
    let (first_to, first_inbox) = result.unwrap(take first_inputs)
    let first_allowed: Result[triggers.Entries, Capacity] = clone(allowed)
    let (take first_head, take first_published) = trigger_law_initial(take initial, c, tasks, take first_to, result.unwrap(take first_allowed))
    let mut running_head = take first_head
    if !result.unwrap(advance_triggers(mut running_head)) { return false }
    // The body is waiting at its first boundary. Close without answering it
    // and leave its durable start as the last write.
    let pending = result.unwrap(channel.receive(first_inbox))
    let TriggerMessage(first_request) = view pending else { return false }
    let Boundary(old, _) = view first_request.action else { return false }
    if triggers.number(old) != 1u64 { return false }
    let Head(db: take before, trigger_drive: take active, ..) = take running_head
    stop_triggers(option.unwrap(take active))
    result.unwrap(store.close(take before))

    let reopened = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    let inputs: Result[(Sender[HeadInput], Receiver[HeadInput]), Capacity] = channel.new(4u64)
    let (to, inbox) = result.unwrap(take inputs)
    let (take built, take published) = trigger_law_initial(take reopened, c, tasks, take to, take allowed)
    let mut head = take built
    if !result.unwrap(advance_triggers(mut head)) { return false }
    let selected = replace(mut head.trigger_drive, None)
    let drive = option.unwrap(take selected)
    let wrong = result.unwrap(trigger_law_argument(9u64))
    let key = result.unwrap(trigger_law_entry_key())
    let stale = trigger_effect(mut head, drive.tables, drive.author, old, key, wrong)
    head.trigger_drive = Some(take drive)
    match stale { Ok(Error(StaleAttempt)) => (), _ => return false }
    let boundary = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take check) = take boundary else { return false }
    result.unwrap(trigger_message(mut head, take check, false))
    let inbound = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take request) = take inbound else { return false }
    result.unwrap(trigger_message(mut head, take request, false))
    let scope_end = result.unwrap(channel.receive(inbox))
    let TriggerDone(a, take answer) = take scope_end else { return false }
    if triggers.number(a) != 2u64 || triggers.run_id(a) != committed.value { return false }
    result.unwrap(trigger_done(mut head, a, take answer, false))
    if trigger_law_value(head) != Some(7u64) || result.unwrap(advance_triggers(mut head)) { return false }
    let Some(Returned(take raw)) = trigger_law_outcome(head, committed.value) else { return false }
    let mut offset = 0u64
    if result.unwrap(std.codec.take_u64(raw, mut offset)) != 2u64 { return false }
    let Head(db: take kept, ..) = take head
    result.unwrap(store.close(take kept))
    true
}

@test
fn journal_test_trigger_granted(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_trigger_granted(d, c, r, tasks) { Ok(()) } else { Error(()) }
}

// ENDSTATE steps law 7. A committed request reaches the waiting body at its
// boundary. Its ordinary return cannot replace the Cancelled terminal outcome.
pub fn journal_law_trigger_cancel(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let dir = triggers.law_directory(d)
    let mut db = result.unwrap(store.open(tasks, dir, c, r, triggers.law_options()))
    result.unwrap(store.run_migration(mut db, tasks, code.describe(trigger_law_migrate)))
    let tables = result.unwrap(store.with_schema(db, code.describe(triggers.tables)))
    let target: triggers.Entry[u64] = result.unwrap(triggers.granted(code.describe(trigger_law_granted_body)))
    let mut allowed = triggers.empty_entries()
    result.unwrap(triggers.allow(mut allowed, target))
    let queued = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(triggers.Id, triggers.Id), triggers.Error] {
        let live = triggers.write(mut tx, tables, allowed, target, 7u64, AfterCommit)?
        let held = triggers.write(mut tx, tables, allowed, target, 5u64, AfterCommit)?
        Ok((live, held))
    })
    let writing = result.unwrap(trigger_commit(take queued))
    let (live, held) = writing.value
    result.unwrap(store.durable(mut db, writing.ticket))
    let inputs: Result[(Sender[HeadInput], Receiver[HeadInput]), Capacity] = channel.new(4u64)
    let (to, inbox) = result.unwrap(take inputs)
    let (take built, take published) = trigger_law_initial(take db, c, tasks, take to, take allowed)
    let mut head = take built
    if !result.unwrap(advance_triggers(mut head)) { return false }

    let cancellation = store.run(mut head.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.request_cancel(mut tx, tables, live)
    })
    let requested = result.unwrap(trigger_commit(take cancellation))
    result.unwrap(store.durable(mut head.db, requested.ticket))
    let boundary = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take check) = take boundary else { return false }
    result.unwrap(trigger_message(mut head, take check, false))
    let inbound = result.unwrap(channel.receive(inbox))
    let TriggerDone(a, take response) = take inbound else { return false }
    result.unwrap(trigger_done(mut head, a, take response, false))
    if let Some(Cancelled) = trigger_law_outcome(head, live) { } else { return false }
    if trigger_law_value(head) != None || !result.unwrap(advance_triggers(mut head)) { return false }
    let step_check = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take step_request) = take step_check else { return false }
    result.unwrap(trigger_message(mut head, take step_request, false))
    let holding = result.unwrap(channel.receive(inbox))
    let TriggerMessage(take hold_request) = take holding else { return false }
    result.unwrap(trigger_message(mut head, take hold_request, false))
    let held_done = result.unwrap(channel.receive(inbox))
    let TriggerDone(held_attempt, take held_response) = take held_done else { return false }
    result.unwrap(trigger_done(mut head, held_attempt, take held_response, false))
    if let Some(_) = trigger_law_outcome(head, held) { return false }
    if result.unwrap(advance_triggers(mut head)) { return false }

    let cancel_held = store.run(mut head.db, None, scoped fn(mut tx: store.Tx) -> Result[(), triggers.Error] {
        triggers.request_cancel(mut tx, tables, held)
    })
    let marked = result.unwrap(trigger_commit(take cancel_held))
    result.unwrap(store.durable(mut head.db, marked.ticket))
    if !result.unwrap(advance_triggers(mut head)) { return false }
    if let Some(Cancelled) = trigger_law_outcome(head, held) { } else { return false }
    if result.unwrap(advance_triggers(mut head)) { return false }
    let Head(db: take kept, ..) = take head
    result.unwrap(store.close(take kept))
    true
}

@test
fn journal_test_trigger_cancel(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_trigger_cancel(d, c, r, tasks) { Ok(()) } else { Error(()) }
}

// ---- The publisher, on its one inbox. A Release with a snapshot runs one G2 round to it
// and moves the base there. Each owner's diff or Reset travels with all its
// owed answers in one update (G1). A Release without a snapshot carries commitless
// answers at the base (V3). A Subscribe runs at the base (G3), in its place among Releases.
//
// The publisher never blocks on a session (L23): every send to an owner is a try_send. A
// closed inbox drops that session's subs. A full one marks each live sub whose content did
// not fit due for repair (§3 "Repair"), with no Ended and no Reset: `due` says some sub of
// the session is due. On the owner's progress the publisher reruns each due sub at its base
// and sends its whole image as a `complete`. A bounced Ended (or Reset) and bounced answers
// wait until the inbox takes them, retried at the current base with any new content.
// `ended_at` is the oldest computation version among `ended` (u64::MAX when empty): a waiting
// Ended keeps the version it was computed at when it is folded into later content.
type Joiner { who: u64, to: Sender[WireEvent], closed: Option[Receiver[()]], ended: List[(u32, u64, Outcome)], ended_at: u64, reset: bool, mark: Option[Receiver[()]], identity: Option[Latest[OwnerNumber]], fence: Option[FenceSet], due: bool, progress: Option[Receiver[()]] }

// One try_send to an owner: taken, bounced back by a full inbox, or shut.
type Offered = Took | Bounced(Notice) | Shut

fn offer(to: Sender[WireEvent], take e: Notice) -> Offered {
    match channel.try_send(to, wire_event(FromRunner(take e))) {
        Ok(()) => Took,
        Error(Full(WireEvent(e: FromRunner(take back)))) => Bounced(take back),
        _ => Shut,
    }
}

fn publisher[G: send, H: send](take r: Registry[G, H], take h: H, take base: store.Snapshot, take from: Receiver[PubIn], take register: RoundRegister) -> () waits {
    let mut at = store.version(base)
    let mut b = Board(r: take r, h: take h, base: take base, newest: None, subs: subscriptions())
    let mut joined: List[Joiner] = list.new()
    let mut waiting: List[Replies] = list.new()
    let mut minted = 0u64
    // Declared last, so a trap cleans it first (FAIL-8): R = u64::MAX is published before any
    // owner channel or the inbox closes.
    let mut rounds = take register
    fence_round(mut joined, Fenced(sessions: list.new(), all: false), at, mut rounds)
    loop {
        let got = match channel.receive(from) {
            Ok(take x) => take x,
            Error(_) => return,
        }
        let PubIn(e: take e) = take got
        let mut owes: List[Owe] = list.new()
        match take e {
            Halt => {
                round_disarm(take rounds)
                return
            },
            Released(take rel) => {
                let Release(version: v, snapshot: take snap, answers: take answers) = take rel
                if let Some(take s) = take snap {
                    at = v
                    b.newest = Some(take s)
                    let mut fenced = Fenced(sessions: list.new(), all: false)
                    owes = round(mut b, mut fenced)
                    // G2 step 3: every fence of the round, then R, before anything is offered.
                    fence_round(mut joined, take fenced, v, mut rounds)
                }
                keep_answers(mut waiting, take answers)
            },
            Joined(take j) => {
                let Join(to: take to, told: take told, mark: take mark, closed: take closed, identity: take id, fence: take fence, progress: take progress) = take j
                let wake: Option[Sender[WireEvent]] = match closed { Some(_) => Some(channel.sender(to)), _ => None }
                // A fenced session's Arcs are reserved here (§3 "Admission"); a refusal answers id 0.
                let reserved: Result[Option[FenceSet], Capacity] = match take fence {
                    Some(take root) => match fence_reserve(mut rounds, take root) { Ok(take fences) => Ok(Some(take fences)), Error(c) => Error(c) },
                    None => Ok(None),
                }
                match take reserved {
                    Ok(take fences) => {
                        minted += 1u64
                        result.unwrap(list.push(mut joined, Joiner(who: minted, to: take to, closed: take closed, ended: list.new(), ended_at: ROUND_HALTED, reset: false, mark: take mark, identity: take id, fence: take fences, due: false, progress: take progress)))
                        let _ = channel.try_send(told, Admit(who: minted, round: latest.handle(rounds.round)))
                    },
                    Error(_) => { let _ = channel.try_send(told, Admit(who: 0u64, round: latest.handle(rounds.round))) },
                }
                if let Some(sender) = wake { let _ = channel.try_send(sender, wire_event(JoinReady)) }
            },
            Subscribed(who, sub, take key, take arg) =>
                publish_subscription(mut b, mut joined, mut owes, who, sub, 0u64, take key, take arg),
            WireSubscribed(who, sub, generation, take input) =>
                publish_wire_subscription(mut b, mut joined, mut owes, who, sub, generation, take input),
            Unsubscribed(who, sub) => { let _ = remove_sub(mut b.subs, who, sub) },
            Left(who) => forget(mut b.subs, mut joined, who),
            // An owner made room (v2.13), or a marked session ended (v2.14): the sweep and the
            // retry below are the whole of it.
            Drained => (),
        }
        sweep(mut b.subs, mut joined)
        repair(mut b, mut joined, mut owes)
        settle(mut b.subs, mut joined, mut waiting, take owes, at)
    }
}

// The sessions a round's read-set hits fence: each named session, or every joined session
// when the round could not tell which (a lost diff resets them all).
type Fenced { sessions: List[u64], all: bool }

// G2 step 3 (§3 "The release check"): publish every fence of round b, then R = b, each from
// its reservation. A publisher that cannot is stopped, which publishes R = u64::MAX as it is
// cleaned (RoundRegister), and the head ends the place when its next Release is refused.
fn fence_round(mut joined: List[Joiner], take fenced: Fenced, b: u64, mut rounds: RoundRegister) {
    let Fenced(sessions: take sessions, all: all) = take fenced
    let mut i = 0u64
    while i < list.len(joined) {
        if all || list.contains(sessions, joined[i].who) {
            if let Some(take held) = replace(mut joined[i].fence, None) {
                let mut fences = take held
                let published = fence_advance(mut fences, b)
                joined[i].fence = Some(take fences)
                if !published { fail("release check: no fence Arc for the round") }
            }
        }
        i += 1u64
    }
    if !round_advance(mut rounds, b, list.len(joined)) { fail("release check: no round Arc for the round") }
}

fn publish_subscription[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], mut owes: List[Owe], who: u64, sub: u32, generation: u64, take key: Bytes, take arg: Bytes) {
    publish_wire_subscription(mut b, mut joined, mut owes, who, sub, generation, SubscriptionInput(room: None, key: take key, arg: take arg))
}

fn publish_wire_subscription[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], mut owes: List[Owe], who: u64, sub: u32, generation: u64, take input: SubscriptionInput) {
    if let Some(i) = joiner(joined, who) {
        unend(mut joined[i].ended, sub)
        result.unwrap(list.push(mut owes, at_base_generation(mut b, who, sub, generation, take input)))
    }
}

fn reply_bucket(waiting: List[Replies], owner: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(waiting) {
        if waiting[i].recipient.owner == owner {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn keep_answers(mut waiting: List[Replies], take answers: List[Answer]) {
    for take a in answers {
        let Answer(recipient: take recipient, row: take row) = take a
        match reply_bucket(waiting, recipient.owner) {
            Some(i) => result.unwrap(list.push(mut waiting[i].rows, take row)),
            None => {
                let mut rows: List[KeyedDone] = list.new()
                result.unwrap(list.push(mut rows, take row))
                result.unwrap(list.push(mut waiting, Replies(recipient: take recipient, rows: take rows)))
            },
        }
    }
}

// A resubscribed sub's waiting Ended is moot: the new Subscribe's Batch replaces it.
fn unend(mut ended: List[(u32, u64, Outcome)], sub: u32) {
    let mut i = 0u64
    while i < list.len(ended) {
        if ended[i].0 == sub {
            let _ = list.remove(mut ended, i)
        } else {
            i += 1u64
        }
    }
}

// Fold the ledger and this round into the same attempt as the owner's pending outcomes.
fn settle(mut subs: Subscriptions, mut joined: List[Joiner], mut waiting: List[Replies], take owes: List[Owe], at: u64) {
    let mut contents = take owes
    let mut bounced: List[Replies] = list.new()
    let mut i = 0u64
    while i < list.len(joined) {
        let who = joined[i].who
        let closed = match joined[i].closed { Some(from) => match channel.try_receive(from) { Ok(()) => true, _ => false }, _ => false }
        if closed {
            forget(mut subs, mut joined, who)
            continue
        }
        let owner = match joined[i].identity { Some(id) => latest.read(id).number, None => 0u64 }
        let mut next = Owe(session: who, version: at, generations: list.new(), complete: list.new(), rows: list.new(), ended: list.new(), reset: false)
        let mut j = 0u64
        while j < list.len(contents) {
            if contents[j].session == who {
                next = list.remove(mut contents, j)
                break
            }
            j += 1u64
        }
        let old = replace(mut joined[i].ended, list.new())
        let old_at = joined[i].ended_at
        joined[i].ended_at = ROUND_HALTED
        if joined[i].reset || next.reset {
            let _ = replace(mut next.generations, list.new())
            let _ = replace(mut next.complete, list.new())
            let _ = replace(mut next.rows, list.new())
            let _ = replace(mut next.ended, list.new())
            next.reset = true
            end_session(mut subs, who)
            joined[i].due = false
        } else if list.len(old) > 0u64 {
            // A unit is checked at its oldest component (§3).
            if old_at < next.version { next.version = old_at }
            let now = replace(mut next.ended, take old)
            for take ended in now {
                result.unwrap(list.push(mut next.ended, take ended))
            }
        }
        joined[i].reset = false
        let (take recipient, take rows) = match reply_bucket(waiting, owner) {
            Some(k) => {
                let Replies(recipient: take r, rows: take rows) = list.remove(mut waiting, k)
                (Some(take r), take rows)
            },
            None => (None, list.new()),
        }
        let has_content = next.reset || list.len(next.complete) > 0u64 || list.len(next.rows) > 0u64 || list.len(next.ended) > 0u64
        if !has_content && list.len(rows) == 0u64 {
            i += 1u64
            continue
        }
        let content = if has_content { Some(take next) } else { None }
        match offer(joined[i].to, update(at, take content, take rows)) {
            Shut => {
                forget(mut subs, mut joined, who)
                continue
            },
            Bounced(Notice(e: Updated(Update(version: _, content: take back, outcomes: take outcomes)))) => {
                if let Some(take r) = take recipient {
                    result.unwrap(list.push(mut bounced, Replies(recipient: take r, rows: take outcomes)))
                }
                if let Some(take o) = take back {
                    overloaded(mut subs, mut joined[i], take o)
                }
            },
            _ => (),
        }
        i += 1u64
    }
    let retry = replace(mut waiting, take bounced)
    for take bucket in retry {
        let Replies(recipient: take recipient, rows: take rows) = take bucket
        if let Bounced(Notice(e: Updated(Update(version: _, content: _, outcomes: take back)))) = offer(recipient.to, update(at, None, take rows)) {
            result.unwrap(list.push(mut waiting, Replies(recipient: take recipient, rows: take back)))
        }
    }
}

// A full inbox bounced this content: a Reset waits and covers it all; otherwise each live sub
// it named (complete or a row) is due for repair (§3 "Repair") and its Ended subs wait.
fn overloaded(mut subs: Subscriptions, mut j: Joiner, take o: Owe) {
    let Owe(session: who, version: computed, generations: _, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    if reset || j.reset {
        j.reset = true
        j.ended = list.new()
        j.ended_at = ROUND_HALTED
        return
    }
    for sub in complete {
        if mark_due(mut subs, who, sub) { j.due = true }
    }
    for r in rows {
        if mark_due(mut subs, who, r.sub) { j.due = true }
    }
    if list.len(ended) == 0u64 { return }
    if computed < j.ended_at { j.ended_at = computed }
    for take x in ended {
        result.unwrap(list.push(mut j.ended, take x))
    }
}

// §3 "Repair", before the offers of each pass: every owner's drain token is taken, so a token
// sent before a bounce never counts after it. A due session that progressed (or has no token
// channel) reruns each due sub at the base, with its generation and input, into its owe as a
// complete. Removing the sub drops its old read set: any commit since that read set's run
// that hit it has fenced the session, and if none did the rerun reads the same keys.
fn repair[G: send, H: send](mut b: Board[G, H], mut joined: List[Joiner], mut owes: List[Owe]) {
    let at = store.version(b.base)
    let mut i = 0u64
    while i < list.len(joined) {
        let progressed = match joined[i].progress {
            Some(from) => match channel.try_receive(from) { Ok(()) => true, _ => false },
            None => true,
        }
        if joined[i].due && progressed && !joined[i].reset {
            joined[i].due = false
            let who = joined[i].who
            for sub in due_subs(b.subs, who) {
                let Some(take old) = remove_sub(mut b.subs, who, sub) else { continue }
                let Sub(generation: generation, input: take input, cover: _, routes: _, due: _) = take old
                let fresh = at_base_generation(mut b, who, sub, generation, take input)
                let k = owe(mut owes, who, at)
                merge_owe(mut owes[k], take fresh)
            }
        }
        i += 1u64
    }
}

fn merge_owe(mut into: Owe, take from: Owe) {
    let Owe(session: _, version: v, generations: take generations, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take from
    if v < into.version { into.version = v }
    if reset { into.reset = true }
    for g in generations { result.unwrap(list.push(mut into.generations, g)) }
    for sub in complete { result.unwrap(list.push(mut into.complete, sub)) }
    for take r in rows { result.unwrap(list.push(mut into.rows, take r)) }
    for take e in ended { result.unwrap(list.push(mut into.ended, take e)) }
}

fn joiner(joined: List[Joiner], who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(joined) {
        if joined[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

// v2.14: after every message but Halt, in join order, a marked session whose mark answers
// Closed has ended, and is retired: its subscriptions, its ledger and mark (in its Joiner)
// go. The retry pass that follows drops its waiting replies, whose inbox is closed (Shut).
fn sweep(mut subs: Subscriptions, mut joined: List[Joiner]) {
    let mut i = 0u64
    while i < list.len(joined) {
        let ended = match joined[i].mark {
            Some(m) => match channel.try_receive(m) {
                Error(Closed) => true,
                _ => false,
            },
            None => false,
        }
        if ended {
            let who = joined[i].who
            forget(mut subs, mut joined, who)
        } else {
            i += 1u64
        }
    }
}

fn forget_subs(mut subs: Subscriptions, who: u64) {
    if let Some(take group) = map.remove(mut subs.by_session, who) {
        for (_, sub) in group { unregister_routes(mut subs.root, sub.routes) }
    }
}

fn forget(mut subs: Subscriptions, mut joined: List[Joiner], who: u64) {
    forget_subs(mut subs, who)
    if let Some(j) = joiner(joined, who) {
        let _ = list.remove(mut joined, j)
    }
}

// ---- §3: publisher delivery to the wire owner.

// One publisher update carries the owner's forwarded positions and subscription content.
type Update: send { version: u64, content: Option[Owe], outcomes: List[KeyedDone] }

fn update(at: u64, take content: Option[Owe], take outcomes: List[KeyedDone]) -> Notice {
    Notice(e: Updated(Update(version: at, content: take content, outcomes: take outcomes)))
}

pub fn head_request(take author: Caller, take stream: Bytes, p: u64, take key: Bytes, take arg: Bytes, take reply_to: Sender[WireEvent]) -> Req {
    let digest = store.request_digest(key, arg)
    let alive = result.unwrap(result.capacity_only(arc.new(HeadLife(active: true))))
    let live = result.unwrap(result.capacity_only(latest.new(take alive)))
    let blank = result.unwrap(result.capacity_only(arc.new(OwnerNumber(number: 0u64))))
    let identity = result.unwrap(result.capacity_only(latest.new(take blank)))
    let seed = result.unwrap(result.capacity_only(arc.new(OwnerNumber(number: 0u64))))
    Req(e: Requested(Request(caller: take author, stream: take stream, p: p, key: take key, arg: take arg, digest: digest,
        reply_to: take reply_to, live: take live, identity: take identity, seed: Some(take seed))))
}

pub fn head_outcome(take event: WireEvent) -> Option[KeyedDone] {
    let WireEvent(e: take input) = take event
    let FromRunner(Notice(e: take notice)) = take input else { return None }
    match take notice {
        Updated(Update(outcomes: take outcomes, ..)) if list.len(outcomes) == 1u64 => {
            let mut rows = take outcomes
            Some(list.remove(mut rows, 0u64))
        },
        _ => None,
    }
}

// What a session hands its client, before the wire Frame (WIRE-SPEC §3): the Frame's Batch,
// Ended and Reset with each answered send named by the store's stream key, until R3 gives
// sessions stream slots. A KeyedBatch at `version` names in `complete` each sub whose whole
// initial result it carries (F11), and carries the wire's subscription Rows (F10: the
// data-tree key and the published value at `version`, None for a removal) and KeyedDone
// rows, one per send answered.
pub type KeyedDone: send { stream: Bytes, p: u64, outcome: Outcome }

pub type KeyedBatch: send { version: u64, complete: List[u32], rows: List[Row], outcomes: List[KeyedDone] }

pub type Down: send = Batched(KeyedBatch) | Ended(u32, Outcome) | KeyedReset(u64, List[KeyedDone])

type Tick: send { stream: Bytes, p: u64, generation: u64 }

// The wire owner receives publisher answers, subscription content and deadline timers
// through the same WireEvent inbox as its reader and writer.
type PublisherEvent: send = Updated(Update) | Expired(Tick)

type HeadLife: shareable + send { active: bool }

// Only the head assigns a number. The publisher and every subscription join can
// read the same number, including after a wire Reset replaced its Joiner.
type OwnerNumber: shareable + send { number: u64 }

resource type HeadLease: send { head: WireHead, live: Latest[HeadLife], dead: Arc[HeadLife], identity: Latest[OwnerNumber] } drop(lease) {
    latest.publish(lease.live, arc.share(lease.dead))
    if latest.read(lease.identity).number != 0u64 {
        let _ = try_head(lease.head, Req(e: OwnerLeft))
    }
}

fn head_lease(take head: WireHead) -> Result[HeadLease, Capacity] {
    let alive = result.capacity_only(arc.new(HeadLife(active: true)))?
    let dead = result.capacity_only(arc.new(HeadLife(active: false)))?
    let live = result.capacity_only(latest.new(take alive))?
    let blank = result.capacity_only(arc.new(OwnerNumber(number: 0u64)))?
    let identity = result.capacity_only(latest.new(take blank))?
    result.capacity_only(HeadLease(head: take head, live: take live, dead: take dead, identity: take identity))
}

fn owner_seed(lease: HeadLease) -> Result[Option[Arc[OwnerNumber]], Capacity] {
    if latest.read(lease.identity).number != 0u64 {
        return Ok(None)
    }
    let blank = result.capacity_only(arc.new(OwnerNumber(number: 0u64)))?
    Ok(Some(take blank))
}

pub opaque type Notice: send { e: PublisherEvent }

// v2.14: a marked session's joiner. A failed or cancelled session skipped its own end, so
// whatever the outcome, the joiner offers the publisher one Drained, never waiting.
pub fn join_marked[R: send](take t: Task[R], to_publisher: Sender[PubIn]) -> Result[R, JoinError] waits {
    let got = task.join(take t)
    let _ = channel.try_send(to_publisher, PubIn(e: Drained))
    got
}

fn slot_key(stream: Bytes, p: u64) -> Bytes {
    let mut k: Bytes = result.unwrap(list.with_capacity(list.len(stream) + 8u64))
    result.unwrap(list.append(mut k, stream))
    result.unwrap(std.codec.put_u64(p, mut k))
    k
}

// The publisher's content for this session: one Batch with its complete subs and rows (G3:
// a sub's whole initial result in the Batch that names it), then its Ended subs; or a Reset.
// `dropped` holds the subs whose Unsubscribe met a full PubIn (v2.12 item 3): the publisher
// keeps them, and the owner drops their rows and Endeds until a Batch completes the sub's
// resubscription, an Ended ends it, or a Reset ends them all.
fn hand(to: Sender[Down], take o: Owe, mut dropped: List[u32], take outcomes: List[KeyedDone]) -> () waits {
    let Owe(session: _, version: v, generations: _, complete: take complete, rows: take rows, ended: take ended, reset: reset) = take o
    if reset {
        list.clear(mut dropped)
        let _ = channel.send(to, KeyedReset(v, take outcomes))
        return
    }
    for sub in complete {
        forgive(mut dropped, sub)
    }
    let heard = unheard(take rows, dropped)
    if list.len(complete) > 0u64 || list.len(heard) > 0u64 || list.len(outcomes) > 0u64 {
        let _ = channel.send(to, Batched(KeyedBatch(version: v, complete: take complete, rows: take heard, outcomes: take outcomes)))
    }
    for take e in take ended {
        let (sub, _, take why) = take e
        if has_sub(dropped, sub) {
            forgive(mut dropped, sub)
        } else {
            let _ = channel.send(to, Ended(sub, take why))
        }
    }
}

fn has_sub(subs: List[u32], sub: u32) -> bool {
    for s in subs {
        if s == sub {
            return true
        }
    }
    false
}

fn forgive(mut dropped: List[u32], sub: u32) {
    let mut i = 0u64
    while i < list.len(dropped) {
        if dropped[i] == sub {
            let _ = list.remove(mut dropped, i)
        } else {
            i += 1u64
        }
    }
}

// The rows of subs not in `dropped`.
fn unheard(take rows: List[Row], dropped: List[u32]) -> List[Row] {
    if list.len(dropped) == 0u64 {
        return take rows
    }
    let mut kept: List[Row] = list.new()
    for take w in take rows {
        if !has_sub(dropped, w.sub) {
            result.unwrap(list.push(mut kept, take w))
        }
    }
    kept
}

// A session owner's inbox capacity: C, the run of takes after which a joined owner wakes the
// publisher (v2.13).
const INBOX: u64 = 64u64

// ---- R2's subscription law (RUNNER-SPEC §8.2: subs25's main_two_sessions, as hand-written
// steps). Table "data" holds perm (key 0), row0 (key 1) and row1 (key 2). Q1 reads perm and,
// when it is not 0, covers row0 and row1; otherwise it covers nothing. Qf reads row1 and
// covers it, and faults when row1 is 2. The client applies each owe to its cache per
// (session, sub); the expected caches are written out by hand from the store's values at each
// version, as a from-scratch run of the query would give them (K1), never from the publisher.
// A value is the u64 codec's 8 bytes little-endian (codec.md), so `word` is the oracle's.
type Qh: send { t: store.Shape[u64, u64] }

fn q1(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    let allowed = match store.fetch(tx, h.t, 0u64) {
        Ok(Some(p)) => p != 0u64,
        Ok(None) => false,
        Error(_) => fail("subs: q1 reads perm"),
    }
    if allowed {
        cover(h.t, Included(1u64), Included(2u64))
    } else {
        cover(h.t, Included(1u64), Excluded(1u64))
    }
}

fn qf(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    match store.fetch(tx, h.t, 2u64) {
        Ok(Some(v)) => if v == 2u64 {
            fail("subs: qf at row1 = 2")
        },
        _ => (),
    }
    cover(h.t, Included(2u64), Included(2u64))
}

// q_late reads row1 and covers it. When row1 is 2 it also reads perm, then faults, so its
// partial read log holds a key its last good run never read.
fn q_late(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    match store.fetch(tx, h.t, 2u64) {
        Ok(Some(v)) => if v == 2u64 {
            let _ = store.fetch(tx, h.t, 0u64)
            fail("subs: q_late at row1 = 2")
        },
        _ => (),
    }
    cover(h.t, Included(2u64), Included(2u64))
}

fn q_moving(tx: store.Tx, h: Qh, take _arg: u32) -> Result[Cover, Capacity] {
    let selector = option.unwrap(result.unwrap(store.fetch(tx, h.t, 0u64)))
    let key = if selector == 0u64 { 3u64 } else { 4u64 }
    let mut scan = result.unwrap(store.range(tx, h.t, Included(key), Excluded(key + 1u64)))
    let chosen = match result.unwrap(store.next(mut scan)) { Some((_, _)) => 2u64, None => 1u64 }
    cover(h.t, Included(chosen), Included(chosen))
}

fn subs_place(mut r: Registry[(), Qh]) -> Result[(), RegisterError] {
    query(mut r, code.describe(q1), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(qf), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(q_late), 65536u64, DEFAULT_STEPS)?
    query(mut r, code.describe(q_moving), 65536u64, DEFAULT_STEPS)
}

fn subs_handles(mut db: store.Db) -> Result[Qh, store.Error] waits {
    let cv: std.codec.Codec[u64] = std.codec.of()
    let t = store.table(mut db, "data", std.codec.key_u64(), cv)?
    Ok(Qh(t: store.shape(t)))
}

fn query_key(f: StaticFn[fn(store.Tx, Qh, take u32) -> Result[Cover, Capacity]]) -> Bytes {
    let ca: std.codec.Codec[u32] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take k, _) = result.unwrap(described(code.identity(f), None, Query, ca, cr))
    k
}

fn no_arg() -> Bytes {
    let ca: std.codec.Codec[u32] = std.codec.of()
    let mut a: Bytes = list.new()
    result.unwrap(std.codec.encode(ca, 0u32, mut a))
    a
}

fn word(v: u8) -> Bytes {
    let mut out: Bytes = list.new()
    result.unwrap(list.push(mut out, v))
    for _ in 0u64 .. 7u64 {
        result.unwrap(list.push(mut out, 0u8))
    }
    out
}

fn set(mut db: store.Db, t: store.Table[u64, u64], k: u64, v: u64) -> () waits {
    let done = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, t, k, v)
    })
    match take done {
        Ok(Committed(_)) => (),
        _ => fail("subs: a fixture put"),
    }
}

type Cached { who: u64, sub: u32, rows: Map[Bytes, Bytes] }

type Client { caches: List[Cached], last: List[(u64, u64)] }

fn cached(c: Client, who: u64, sub: u32) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who && c.caches[i].sub == sub {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn drop_cache(mut c: Client, who: u64, sub: u32) {
    if let Some(i) = cached(c, who, sub) {
        let _ = list.remove(mut c.caches, i)
    }
}

// The client's side of one owe: versions never decrease (K2); a complete sub starts its cache
// empty; a row for a sub with no cache is a row before its complete (L17).
fn apply(mut c: Client, take o: Owe) -> bool {
    let mut seen = false
    let mut i = 0u64
    while i < list.len(c.last) {
        if c.last[i].0 == o.session {
            if o.version < c.last[i].1 {
                return false
            }
            c.last[i].1 = o.version
            seen = true
        }
        i += 1u64
    }
    if !seen {
        result.unwrap(list.push(mut c.last, (o.session, o.version)))
    }
    if o.reset {
        while let Some(j) = first_of(c, o.session) {
            let _ = list.remove(mut c.caches, j)
        }
        return true
    }
    for sub in o.complete {
        drop_cache(mut c, o.session, sub)
        result.unwrap(list.push(mut c.caches, Cached(who: o.session, sub: sub, rows: map.new())))
    }
    let Owe(session: who, version: _, generations: _, complete: _, rows: take rows, ended: take ended, reset: _) = take o
    for take row in rows {
        let Row(sub: sub, key: take key, value: take value) = take row
        let k = match cached(c, who, sub) {
            Some(k) => k,
            None => return false,
        }
        let _ = map.remove(mut c.caches[k].rows, key)
        if let Some(take v) = take value {
            result.unwrap(map.insert(mut c.caches[k].rows, take key, take v))
        }
    }
    for e in ended {
        drop_cache(mut c, who, e.0)
    }
    true
}

fn first_of(c: Client, who: u64) -> Option[u64] {
    let mut i = 0u64
    while i < list.len(c.caches) {
        if c.caches[i].who == who {
            return Some(i)
        }
        i += 1u64
    }
    None
}

fn apply_all(mut c: Client, take owes: List[Owe]) -> bool {
    for take o in owes {
        if !apply(mut c, take o) {
            return false
        }
    }
    true
}

// The cache of (who, sub) holds exactly row0 and row1 (keys[1], keys[2]) with these values;
// None leaves a row out.
fn holds(c: Client, keys: List[Bytes], who: u64, sub: u32, row0: Option[u8], row1: Option[u8]) -> bool {
    let k = match cached(c, who, sub) {
        Some(k) => k,
        None => return false,
    }
    let rows = c.caches[k].rows
    let mut n = 0u64
    if let Some(v) = row0 {
        n += 1u64
        match map.get(rows, keys[1]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    if let Some(v) = row1 {
        n += 1u64
        match map.get(rows, keys[2]) {
            Some(got) => if got != word(v) {
                return false
            },
            None => return false,
        }
    }
    map.len(rows) == n
}

fn step_held[G: send, H: send](mut b: Board[G, H]) -> List[Owe] {
    let mut fenced = Fenced(sessions: list.new(), all: false)
    round(mut b, mut fenced)
}

fn step[G: send, H: send](mut b: Board[G, H], db: store.Db) -> List[Owe] {
    b.newest = Some(store.snapshot(db))
    let mut fenced = Fenced(sessions: list.new(), all: false)
    round(mut b, mut fenced)
}

pub fn law_subs_main(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    let empty = store.snapshot(db)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let mut keys: List[Bytes] = list.new()
    for ch in result.unwrap(store.changes(empty, base)) {
        result.unwrap(list.push(mut keys, result.unwrap(clone(ch.tree_key))))
    }
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let mut b = Board(r: take reg, h: take h, base: take base, newest: None, subs: subscriptions())
    let mut cl = Client(caches: list.new(), last: list.new())
    let k1 = query_key(code.describe(q1))
    let kf = query_key(code.describe(qf))
    // subscribe_at_latest: w0 commits and is released, then session 0 subscribes Q1 before the
    // round. Its result is the base's (row0 = 0), labelled with the base.
    set(mut db, t, 1u64, 1u64)
    b.newest = Some(store.snapshot(db))
    let first = at_base(mut b, 0u64, 1u32, result.unwrap(clone(k1)), no_arg())
    if first.version != 4u64 || list.len(first.complete) != 1u64 || !apply(mut cl, take first) || !holds(cl, keys, 0u64, 1u32, Some(0u8), Some(0u8)) {
        return false
    }
    if !apply_all(mut cl, step_held(mut b)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(0u8)) {
        return false
    }
    // shared_cache: session 1 subscribes Q1 with the same sub id; session 0 subscribes Qf.
    // Then row1 = 5 is a cover change for both Q1s and a re-run for Qf.
    if !apply(mut cl, at_base(mut b, 1u64, 1u32, result.unwrap(clone(k1)), no_arg())) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(0u8)) {
        return false
    }
    if !apply(mut cl, at_base(mut b, 0u64, 2u32, result.unwrap(clone(kf)), no_arg())) || !holds(cl, keys, 0u64, 2u32, None, Some(0u8)) {
        return false
    }
    set(mut db, t, 2u64, 5u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 0u64, 2u32, None, Some(5u8)) {
        return false
    }
    // rerun_without_retract: revoke re-runs both Q1s, whose Covers become empty, so both lose
    // row0 and row1. A Subscribe of Q1 now completes with an empty result (L17).
    set(mut db, t, 0u64, 0u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, None, None) || !holds(cl, keys, 1u64, 1u32, None, None) || !holds(cl, keys, 0u64, 2u32, None, Some(5u8)) {
        return false
    }
    let empty_result = at_base(mut b, 1u64, 3u32, result.unwrap(clone(k1)), no_arg())
    if list.len(empty_result.complete) != 1u64 || empty_result.complete[0] != 3u32 || list.len(empty_result.rows) != 0u64 || !apply(mut cl, take empty_result) {
        return false
    }
    // K7: grant, then the call's row1 = 2. Qf's re-run faults and ends Qf alone, with
    // Failed(Raised(5)) (Fail); session 0's Q1 follows row1 by its Cover.
    set(mut db, t, 0u64, 1u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(5u8)) || !holds(cl, keys, 1u64, 3u32, Some(1u8), Some(5u8)) {
        return false
    }
    set(mut db, t, 2u64, 2u64)
    let owes = step(mut b, db)
    let mut faulted = false
    for o in owes {
        for e in o.ended {
            faulted = o.session == 0u64 && e.0 == 2u32 && match e.2 {
                Failed(Raised(n)) => n == 5u32,
                _ => false,
            }
        }
    }
    if !faulted || !apply_all(mut cl, take owes) || cached(cl, 0u64, 2u32) != None || !holds(cl, keys, 0u64, 1u32, Some(1u8), Some(2u8)) || !holds(cl, keys, 1u64, 1u32, Some(1u8), Some(2u8)) {
        return false
    }
    // Moving the selector invalidates the Point and moves the read Span from [4,5) to
    // [3,4). A write at the old lower bound must miss both Spans. The new lower bound
    // must rerun the query and move its Cover from row0 to row1.
    let moving = at_base(mut b, 2u64, 1u32, query_key(code.describe(q_moving)), no_arg())
    if !apply(mut cl, take moving) || !holds(cl, keys, 2u64, 1u32, Some(1u8), None) { return false }
    set(mut db, t, 0u64, 0u64)
    if !apply_all(mut cl, step(mut b, db)) || !holds(cl, keys, 2u64, 1u32, Some(1u8), None) { return false }
    set(mut db, t, 4u64, 20u64)
    if list.len(step(mut b, db)) != 0u64 { return false }
    set(mut db, t, 3u64, 21u64)
    apply_all(mut cl, step(mut b, db)) && holds(cl, keys, 2u64, 1u32, None, Some(2u8))
}

pub fn law_subs_reset_keeps_diff(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    let h = result.unwrap(subs_handles(mut db))
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    let _ = at_base(mut b, 1u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 2u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 3u64, 1u32, query_key(code.describe(q1)), no_arg())
    let schema = 7u64
    let rejected = fn(_ch: store.Change) -> Result[Option[Bytes], store.Error] { Error(Schema(schema)) }
    let value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error] = result.unwrap(result.capacity_only(take rejected))
    let mut next = Some(take value)
    let _ = map.update(mut b.subs.by_session, 2u64, scoped fn(mut group: Map[u32, Sub]) {
        let _ = map.update(mut group, 1u32, scoped fn(mut entry: Sub) {
            let mut kept = option.unwrap(replace(mut entry.cover, None))
            kept.value = option.unwrap(replace(mut next, None))
            entry.cover = Some(take kept)
        })
    })
    set(mut db, t, 1u64, 7u64)
    let owes = step(mut b, db)
    list.len(owes) == 3u64
        && owes[0].session == 1u64 && list.len(owes[0].rows) == 1u64
        && owes[1].session == 2u64 && owes[1].reset
        && owes[2].session == 3u64 && list.len(owes[2].rows) == 1u64
}

@test
fn test_subs_reset_keeps_diff(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_subs_reset_keeps_diff(c, r) { Ok(()) } else { Error(()) }
}

// L22 (RUNNER-SPEC v2.12, subscribe_order): a Subscribe runs at the version of the last
// Released taken before it in PubIn's order, and each later Release reaches it as a round.
// The publisher's own loop drains one inbox filled in that order: Joined, c1's Release, the
// Subscribe, c2's Release, Halt. Sub 1's initial result holds c1 (row 1 = 1) at c1's version,
// and c2 (row 2 = 7) follows as a round at c2's version.
pub fn law_subscribe_order(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    let empty = store.snapshot(db)
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let mut keys: List[Bytes] = list.new()
    for ch in result.unwrap(store.changes(empty, base)) {
        result.unwrap(list.push(mut keys, result.unwrap(clone(ch.tree_key))))
    }
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 1u64)
    let c1 = store.snapshot(db)
    set(mut db, t, 2u64, 7u64)
    let c2 = store.snapshot(db)
    set(mut db, t, 4u64, 1u64)
    let outside = store.snapshot(db)
    let v1 = store.version(c1)
    let v2 = store.version(c2)
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ev_to, ev_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(8u64))
    let (told_to, told_from): (Sender[Admit], Receiver[Admit]) = result.unwrap(channel.new(1u64))
    let mut queue: List[ToPub] = list.new()
    result.unwrap(list.push(mut queue, Joined(Join(to: take ev_to, told: take told_to, mark: None, closed: None, identity: None, fence: None, progress: None))))
    result.unwrap(list.push(mut queue, Released(Release(version: v1, snapshot: Some(take c1), answers: list.new()))))
    result.unwrap(list.push(mut queue, Subscribed(1u64, 1u32, query_key(code.describe(q1)), no_arg())))
    result.unwrap(list.push(mut queue, Released(Release(version: v2, snapshot: Some(take c2), answers: list.new()))))
    result.unwrap(list.push(mut queue, Released(Release(version: store.version(outside), snapshot: Some(take outside), answers: list.new()))))
    result.unwrap(list.push(mut queue, Halt))
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    publisher(take reg, take h, take base, take from, take rounds)
    match channel.try_receive(told_from) {
        Ok(a) => if a.who != 1u64 { return false },
        _ => return false,
    }
    let mut cl = Client(caches: list.new(), last: list.new())
    let mut n = 0u64
    while let Ok(take x) = channel.try_receive(ev_from) {
        let Notice(e: take e) = publisher_notice(take x)
        let o = match take e {
            Updated(Update(version: _, content: Some(take o), outcomes: _)) => take o,
            _ => return false,
        }
        let ok = if n == 0u64 {
            o.version == v1 && list.len(o.complete) == 1u64 && apply(mut cl, take o) && holds(cl, keys, 1u64, 1u32, Some(1u8), Some(0u8))
        } else {
            o.version == v2 && list.len(o.complete) == 0u64 && apply(mut cl, take o) && holds(cl, keys, 1u64, 1u32, Some(1u8), Some(7u8))
        }
        if !ok {
            return false
        }
        n += 1u64
    }
    n == 2u64
}

// L25 (RUNNER-SPEC v2.14, retired_without_waiting): a marked session's end waits on nothing,
// and after the next message the publisher takes, Released or not, that session's
// subscriptions, Joiner (its ledger and mark) and waiting replies are gone; a live session is
// unchanged by every sweep. The oracle is the state itself, in place of §8's retained-bytes
// figure (followups.md, 2026-11-17): a closed event channel for the publisher's Joiner, the
// Board's subs and the waiting list for the sweep, and the Drained messages on PubIn for the
// session's end.
pub fn law_retired_without_waiting(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    retired_at_publisher(c, r, tasks, true) && retired_at_publisher(c, r, tasks, false) && retired_state(c, r) && retired_session(c, r, tasks, 0u64) && retired_session(c, r, tasks, 1u64) && retired_session(c, r, tasks, 2u64) && retired_session(c, r, tasks, 3u64)
}

// A session joins the publisher and is told its id (0 if it could not): a sync point that is
// not a Released, since the publisher has taken every message sent before it.
fn join_as(to: Sender[PubIn], take ev: Sender[WireEvent], take mark: Option[Receiver[()]]) -> u64 waits {
    join_with(to, take ev, take mark, None)
}

fn join_with(to: Sender[PubIn], take ev: Sender[WireEvent], take mark: Option[Receiver[()]], take progress: Option[Receiver[()]]) -> u64 waits {
    let (told, hear): (Sender[Admit], Receiver[Admit]) = result.unwrap(channel.new(1u64))
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: take ev, told: take told, mark: take mark, closed: None, identity: None, fence: None, progress: take progress)))) {
        return 0u64
    }
    match channel.receive(hear) {
        Ok(a) => a.who,
        Error(_) => 0u64,
    }
}

// Takes every event `from` holds: each Content's version, and whether any names `sub`.
// True if the channel is then closed, false if it is only empty.
fn drain_content(from: Receiver[WireEvent], mut versions: List[u64], sub: u32, mut named: bool) -> bool {
    loop {
        match channel.try_receive(from) {
            Ok(take x) => {
                let Notice(e: take e) = publisher_notice(take x)
                if let Updated(Update(version: _, content: Some(take o), outcomes: _)) = take e {
                    for s in o.complete {
                        named = named || s == sub
                    }
                    for w in o.rows {
                        named = named || w.sub == sub
                    }
                    result.unwrap(list.push(mut versions, o.version))
                }
            },
            Error(Empty) => return false,
            Error(Closed) => return true,
        }
    }
}

// The publisher, as a task. Marked sessions L and M and an unmarked filler F join; L and M
// subscribe sub 1, and both take c1's round. M's mark then closes in a quiet place, and the
// next message is M's wake (woken) or, with the wake dropped, F's Unsubscribe followed by M's
// queued Subscribe of sub 2. After that and a Joined, with no Released between, M's event
// channel holds its two contents and is closed (its Joiner is gone), and sub 2 registered
// nothing. Then c2's round reaches L.
fn retired_at_publisher(c: Clock, r: Random, tasks: Tasks, woken: bool) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let v0 = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 1u64)
    let c1 = store.snapshot(db)
    set(mut db, t, 2u64, 7u64)
    let c2 = store.snapshot(db)
    let v1 = store.version(c1)
    let v2 = store.version(c2)
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = result.unwrap(channel.new(1u64))
    let p = Publish(place: code.describe(subs_place), n_place: 1048576u64, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready_to)
    let publishing = match task.spawn(tasks, bytes 8388608u64, take p, publish) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    match channel.receive(ready_from) {
        Ok(None) => (),
        _ => return false,
    }
    let (l_to, l_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(16u64))
    let (l_send, l_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let mut l_keep = Some(take l_send)
    let l = join_as(to, take l_to, Some(take l_mark))
    let (m_to, m_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(16u64))
    let (m_send, m_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let mut m_keep = Some(take m_send)
    let m = join_as(to, take m_to, Some(take m_mark))
    let (f_to, f_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(16u64))
    let f = join_as(to, take f_to, None)
    let k1 = query_key(code.describe(q1))
    let mut queue: List[ToPub] = list.new()
    result.unwrap(list.push(mut queue, Subscribed(l, 1u32, result.unwrap(clone(k1)), no_arg())))
    result.unwrap(list.push(mut queue, Subscribed(m, 1u32, result.unwrap(clone(k1)), no_arg())))
    result.unwrap(list.push(mut queue, Released(Release(version: v1, snapshot: Some(take c1), answers: list.new()))))
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (g_to, g_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let g = join_as(to, take g_to, None)
    // M ends: its mark's only Sender goes. Nothing is Released until M's channel is read.
    m_keep = None
    let mut quiet: List[ToPub] = list.new()
    if woken {
        result.unwrap(list.push(mut quiet, Drained))
    } else {
        result.unwrap(list.push(mut quiet, Unsubscribed(f, 9u32)))
        result.unwrap(list.push(mut quiet, Subscribed(m, 2u32, result.unwrap(clone(k1)), no_arg())))
    }
    for take e in quiet {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (n_to, n_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let n = join_as(to, take n_to, None)
    let mut mv: List[u64] = list.new()
    let mut m2 = false
    let m_closed = drain_content(m_from, mut mv, 2u32, mut m2)
    if !m_closed || m2 || list.len(mv) != 2u64 || mv[0] != v0 || mv[1] != v1 {
        return false
    }
    if let Error(_) = channel.send(to, PubIn(e: Released(Release(version: v2, snapshot: Some(take c2), answers: list.new())))) {
        return false
    }
    let (k_to, k_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let k = join_as(to, take k_to, None)
    let mut lv: List[u64] = list.new()
    let mut l2 = false
    let l_closed = drain_content(l_from, mut lv, 2u32, mut l2)
    if l_closed || l2 || list.len(lv) != 3u64 || lv[0] != v0 || lv[1] != v1 || lv[2] != v2 {
        return false
    }
    if let Error(_) = channel.send(to, PubIn(e: Halt)) {
        return false
    }
    let stopped = match task.join(take publishing) {
        Ok(_) => true,
        Error(_) => false,
    }
    l_keep = None
    let _ = (f_from, g_from, n_from, k_from)
    stopped && l != 0u64 && m != 0u64 && f != 0u64 && g != 0u64 && n != 0u64 && k != 0u64 && none(l_keep) && none(m_keep)
}

// The sweep's own state: session 2's mark is closed, session 1's is open. One sweep and the
// retry pass leave session 1's sub and Joiner, and remove session 2's two subs, its Joiner
// (with its waiting Ended and its mark) and its waiting Told.
fn retired_state(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    let base = store.snapshot(db)
    let at = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let reg = match placed(code.describe(subs_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let mut b = Board(r: take reg, h: take h, base: take base, newest: None, subs: subscriptions())
    let k1 = query_key(code.describe(q1))
    let _ = at_base(mut b, 1u64, 1u32, result.unwrap(clone(k1)), no_arg())
    let _ = at_base(mut b, 2u64, 1u32, result.unwrap(clone(k1)), no_arg())
    let _ = at_base(mut b, 2u64, 2u32, result.unwrap(clone(k1)), no_arg())
    let (l_send, l_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let (m_send, m_mark): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let mut m_keep = Some(take m_send)
    m_keep = None
    let (l_to, l_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(4u64))
    let (m_to, m_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(4u64))
    let m_told = channel.sender(m_to)
    let mut m_inbox = Some(take m_from)
    m_inbox = None
    let mut ended: List[(u32, u64, Outcome)] = list.new()
    result.unwrap(list.push(mut ended, (1u32, 0u64, Refused(Overloaded))))
    let mut joined: List[Joiner] = list.new()
    result.unwrap(list.push(mut joined, Joiner(who: 1u64, to: take l_to, closed: None, ended: list.new(), ended_at: ROUND_HALTED, reset: false, mark: Some(take l_mark), identity: None, fence: None, due: false, progress: None)))
    result.unwrap(list.push(mut joined, Joiner(who: 2u64, to: take m_to, closed: None, ended: take ended, ended_at: ROUND_HALTED, reset: false, mark: Some(take m_mark), identity: None, fence: None, due: false, progress: None)))
    let mut outcomes: List[KeyedDone] = list.new()
    result.unwrap(list.push(mut outcomes, KeyedDone(stream: no_arg(), p: 0u64, outcome: Refused(Overloaded))))
    let mut waiting: List[Replies] = list.new()
    result.unwrap(list.push(mut waiting, Replies(recipient: Recipient(owner: 2u64, to: take m_told), rows: take outcomes)))
    sweep(mut b.subs, mut joined)
    settle(mut b.subs, mut joined, mut waiting, list.new(), at)
    let _ = (l_send, l_from)
    map.len(b.subs.by_session) == 1u64 && map.contains(b.subs.by_session, 1u64) && list.len(joined) == 1u64 && joined[0].who == 1u64 && list.len(waiting) == 0u64 && none(m_keep) && none(m_inbox)
}

fn none[T](x: Option[T]) -> bool {
    match x {
        Some(_) => false,
        None => true,
    }
}

// The Drained messages `from` holds now; any other message counts as many.
fn drained(from: Receiver[PubIn]) -> u64 {
    let mut n = 0u64
    while let Ok(take x) = channel.try_receive(from) {
        let PubIn(e: take e) = take x
        n += match take e {
            Drained => 1u64,
            _ => 1000u64,
        }
    }
    n
}

fn is_ended(take d: Down, sub: u32) -> bool {
    match take d {
        Ended(s, take o) => s == sub && match o {
            Refused(Overloaded) => true,
            _ => false,
        },
        _ => false,
    }
}

// The session's end. A marked session on a mailbox of 2, with this law as its publisher,
// joins and subscribes sub 1; its mark is Empty while it lives. It ends (0) normally on an
// empty PubIn, (1) normally on a full one, (2) by a fault, or (3) by cancellation. Its end
// waits on nothing: the session's own Drained is on PubIn before `join_marked` in (0), and in
// (1) it was dropped, so `join_marked` adds only its own. In (2) and (3) only the joiner offers
// one. The mark is closed after the join in each. (1) also holds v2.12 item 3: on the full
// PubIn, a Subscribe of sub 2 is answered Ended(2, Refused(Overloaded)), and an Unsubscribe of
// sub 1 is applied at the owner, which drops sub 1's rows from later content.
fn fixture_generations(g: u64) -> List[(u32, u64)] {
    let mut stamps: List[(u32, u64)] = list.new()
    result.unwrap(list.push(mut stamps, (1u32, 1u64)))
    result.unwrap(list.push(mut stamps, (3u32, g)))
    stamps
}

// This unit driver feeds the production wire service, including its finish path.
// It owns no public client transport. The existing publisher tests exercise marks.
type RetiredOwner: send { service: Service[WireSession[(), Qh]], from: Receiver[WireEvent], output: Sender[Down], publisher: Sender[PubIn] }

fn retired_owner(take seed: RetiredOwner) -> Result[(), ()] waits {
    let RetiredOwner(service: take initial, from: take from, output: take output, publisher: take pub_to) = take seed
    let mut service = take initial
    let mut work = wire_work()
    loop {
        let event = match channel.receive(from) { Ok(take x) => take x, _ => break }
        let WireEvent(e: take input_event) = take event
        let input = match take input_event {
            Input(take frame, at) => WClient(take frame, at),
            FromRunner(take notice) => WRunner(take notice),
            JoinReady => WPoll(false),
            Ended(_) => break,
            _ => continue,
        }
        let _ = result.unwrap((service.step)(mut service.context, mut work, take input))
        while let Some(take frame) = result.unwrap((service.step)(mut service.context, mut work, WPoll(true))) {
            let _ = result.unwrap((service.step)(mut service.context, mut work, WSent))
            let down = match take frame {
                Batch(v, take complete, take rows, _) => Batched(KeyedBatch(version: v, complete: take complete, rows: take rows, outcomes: list.new())),
                Ended(sub, take outcome) => Ended(sub, take outcome),
                Reset(v, _) => KeyedReset(v, list.new()),
                _ => continue,
            }
            let _ = channel.send(output, take down)
        }
    }
    wire_finish_owner(mut service, pub_to)
    Ok(())
}

fn retired_session(c: Clock, r: Random, tasks: Tasks, end: u64) -> bool waits {
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(2u64))
    let (head, heads): (Sender[Req], Receiver[Req]) = result.unwrap(channel.new(1u64))
    let (down_to, down): (Sender[Down], Receiver[Down]) = result.unwrap(channel.new(16u64))
    let (inbox, events): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(16u64))
    let (access_gate, take policy_handle) = result.unwrap(ingress.start(tasks, c, r, ingress.defaults(), 1048576u64))
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut service = wire_service_seed(take reg, access_gate, head, c, tasks, wire_defaults(1048576u64, 1048576u64), "fixture")
    service.context.marked = true
    service.context.phase = 3u8
    service.context.me = Some(channel.sender(inbox))
    service.context.publisher = Some(channel.sender(to))
    let k1 = query_key(code.describe(q1))
    result.unwrap(list.push(mut service.context.entries, result.unwrap(clone(k1))))
    let seed = RetiredOwner(service: take service, from: take events, output: take down_to, publisher: channel.sender(to))
    let mut running = match task.spawn(tasks, bytes 4194304u64, take seed, retired_owner) { Ok(take t) => take t, _ => return false }
    if let Error(_) = channel.send(inbox, wire_event(Input(Subscribe(1u32, 0u32, no_arg(), None), 0u64))) { return false }
    let joining = match channel.receive(from) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let PubIn(e: take first) = take joining
    let (ses, held) = match take first {
        Joined(take j) => {
            let Join(to: take delivery, told: take told, mark: take given, closed: _, identity: _, fence: _, progress: _) = take j
            let ses_to = take delivery
            let _ = channel.try_send(told, Admit(who: 7u64, round: latest.handle(rounds.round)))
            let _ = channel.send(ses_to, wire_event(JoinReady))
            (take ses_to, take given)
        },
        _ => return false,
    }
    let m = match take held {
        Some(take x) => take x,
        None => return false,
    }
    let subscribing = match channel.receive(from) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let PubIn(e: take second) = take subscribing
    let subscribed = match take second {
        WireSubscribed(who, sub, _, _) => who == 7u64 && sub == 1u32,
        _ => false,
    }
    let live = match channel.try_receive(m) {
        Error(Empty) => true,
        _ => false,
    }
    if !subscribed || !live {
        return false
    }
    if end == 1u64 {
        if let Error(_) = channel.send(inbox, wire_event(Input(Subscribe(3u32, 0u32, no_arg(), None), 0u64))) { return false }
        let generation = match channel.receive(from) {
            Ok(take x) => { let PubIn(e: take e) = take x; match take e { WireSubscribed(7u64, 3u32, g, _) => g, _ => return false } },
            _ => return false,
        }
        for _ in 0u64 .. 2u64 {
            if let Error(_) = channel.send(to, PubIn(e: Drained)) {
                return false
            }
        }
        let mut rows: List[Row] = list.new()
        result.unwrap(list.push(mut rows, Row(sub: 1u32, key: no_arg(), value: None)))
        result.unwrap(list.push(mut rows, Row(sub: 3u32, key: no_arg(), value: None)))
        let o = Owe(session: 7u64, version: 9u64, generations: fixture_generations(generation), complete: list.new(), rows: take rows, ended: list.new(), reset: false)
        if let Error(_) = channel.send(inbox, wire_event(Input(Subscribe(2u32, 0u32, no_arg(), None), 0u64))) {
            return false
        }
        if let Error(_) = channel.send(inbox, wire_event(Input(Unsubscribe(1u32), 0u64))) {
            return false
        }
        if let Error(_) = channel.send(inbox, wire_event(FromRunner(update(9u64, Some(take o), list.new())))) {
            return false
        }
        let refused = match channel.receive(down) {
            Ok(take d) => is_ended(take d, 2u32),
            Error(_) => false,
        }
        let only_three = match channel.receive(down) {
            Ok(Batched(take x)) => list.len(x.rows) == 1u64 && x.rows[0].sub == 3u32,
            _ => false,
        }
        if !refused || !only_three {
            return false
        }
    }
    if end == 2u64 {
        // A Told whose stream is over the session's bytes: slot_key's allocation faults.
        let mut big: Bytes = list.new()
        if let Error(_) = list.fill(mut big, 8388608u64, 0u8) {
            return false
        }
        let mut answers: List[KeyedDone] = list.new()
        result.unwrap(list.push(mut answers, KeyedDone(stream: take big, p: 0u64, outcome: Refused(Overloaded))))
        if let Error(_) = channel.send(inbox, wire_event(FromRunner(update(0u64, None, take answers)))) {
            return false
        }
    } else if end == 3u64 {
        task.cancel(mut running)
    } else if let Error(_) = channel.send(inbox, wire_event(Ended(1000u16))) {
        return false
    }
    // The session's end drops its client; this waits for that, never for the task.
    while let Ok(_) = channel.receive(down) {
    }
    let before = drained(from)
    let outcome = match join_marked(take running, to) {
        Ok(Ok(_)) => end <= 1u64,
        Error(Failed(_)) => end == 2u64,
        Error(Cancelled(_)) => end == 3u64,
        _ => false,
    }
    let after = drained(from)
    let closed = match channel.try_receive(m) {
        Error(Closed) => true,
        _ => false,
    }
    let want = if end == 0u64 {
        1u64
    } else if end == 1u64 {
        2u64
    } else {
        0u64
    }
    let _ = heads
    let mut policy_task = take policy_handle
    task.cancel(mut policy_task)
    let _ = task.join(take policy_task)
    outcome && closed && before == want && after == 1u64
}

@test
fn test_retired_without_waiting(c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_retired_without_waiting(c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L28 (RUNNER-SPEC v2.19.2, stale_never_released): once commit b's round register value is
// published, no writer accepts a content unit below b for a session whose read set b hit.
// The decision rows are hand-derived from §3: R = u64::MAX drops; the fence acts at `latest`
// once R has reached it and at `prior` before. The trace runs the publisher as a task: one
// session joins with its fence root and subscribes q1 at v0 (q1 reads perm, covers rows 0
// and 1). Commit c writes only a covered row, so the fence stays at 0 and R = c; commit b
// clears perm, a read hit, so the fence becomes {0, b} and R = b, and the writer's check
// then refuses a unit at c and accepts one at b.
pub fn law_stale_never_released(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let table = !release_passes(ROUND_HALTED, Fence(prior: 0u64, latest: 0u64), 5u64)
        && !release_passes(7u64, Fence(prior: 3u64, latest: 7u64), 5u64)
        && release_passes(5u64, Fence(prior: 3u64, latest: 9u64), 4u64)
        && !release_passes(5u64, Fence(prior: 3u64, latest: 9u64), 2u64)
        && release_passes(9u64, Fence(prior: 3u64, latest: 9u64), 9u64)
    table && stale_trace(c, r, tasks) && trap_trace(c, r, tasks) && ended_trace(c, r)
}

// v2.19.2 ended entries (RECHECK B1, B1a): a sub the publisher ends keeps its read set
// indexed until a read-set hit fences its session. Three sessions end at commit c with no
// fence of their own: session 1's q1 by a Cover-only conversion that faults (Ended), session
// 2's q1 by one that loses (a publisher-made Reset), and session 3's q_late by a re-run that
// faults after reading perm, which its last good run never read. Session 4's q1 gets round
// c's rows, which bounce at its full owner inbox after c's R is published (B1d), so it is due
// for repair (§3 "Repair"): no Ended, no fence. Commit b then writes only perm: all four
// sessions are fenced at b, and nothing is owed, since session 4's sub is due and is not re-run.
// A second write to perm fences only session 4, whose due sub keeps its read set; each ended
// entry left at its first hit. Repair waits for session 4's drain token, then owes q1's whole
// image at the base: perm is set, so rows 1 and 2, in one `complete`.
fn ended_trace(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let h = result.unwrap(subs_handles(mut db))
    let reg = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    let _ = at_base(mut b, 1u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 2u64, 1u32, query_key(code.describe(q1)), no_arg())
    let _ = at_base(mut b, 3u64, 1u32, query_key(code.describe(q_late)), no_arg())
    let _ = at_base(mut b, 4u64, 1u32, query_key(code.describe(q1)), no_arg())
    let schema = 7u64
    let faults = fn(_ch: store.Change) -> Result[Option[Bytes], store.Error] {
        if schema != 0u64 { fail("subs: a Cover's value faults") }
        Error(Schema(schema))
    }
    let loses = fn(_ch: store.Change) -> Result[Option[Bytes], store.Error] { Error(Schema(schema)) }
    let faulting_value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error] = result.unwrap(result.capacity_only(take faults))
    let losing_value: own[send] fn(store.Change) -> Result[Option[Bytes], store.Error] = result.unwrap(result.capacity_only(take loses))
    let mut faulting = Some(take faulting_value)
    let mut losing = Some(take losing_value)
    let _ = map.update(mut b.subs.by_session, 1u64, scoped fn(mut group: Map[u32, Sub]) {
        let _ = map.update(mut group, 1u32, scoped fn(mut entry: Sub) {
            let mut kept = option.unwrap(replace(mut entry.cover, None))
            kept.value = option.unwrap(replace(mut faulting, None))
            entry.cover = Some(take kept)
        })
    })
    let _ = map.update(mut b.subs.by_session, 2u64, scoped fn(mut group: Map[u32, Sub]) {
        let _ = map.update(mut group, 1u32, scoped fn(mut entry: Sub) {
            let mut kept = option.unwrap(replace(mut entry.cover, None))
            kept.value = option.unwrap(replace(mut losing, None))
            entry.cover = Some(take kept)
        })
    })
    set(mut db, t, 2u64, 2u64)
    b.newest = Some(store.snapshot(db))
    let mut at_c = Fenced(sessions: list.new(), all: false)
    let mut owes_c = round(mut b, mut at_c)
    let (full_to, _full_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let (progressed, progress): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let mut joined: List[Joiner] = list.new()
    result.unwrap(list.push(mut joined, Joiner(who: 4u64, to: take full_to, closed: None, ended: list.new(), ended_at: ROUND_HALTED, reset: false, mark: None, identity: None, fence: None, due: false, progress: Some(take progress))))
    let mut bounced = 0u64
    let mut i = 0u64
    while i < list.len(owes_c) {
        if owes_c[i].session == 4u64 {
            let o = list.remove(mut owes_c, i)
            if list.len(o.rows) > 0u64 { bounced += 1u64 }
            overloaded(mut b.subs, mut joined[0], take o)
        } else {
            i += 1u64
        }
    }
    let marked = joined[0].due && list.len(joined[0].ended) == 0u64
    let mut ended = 0u64
    for o in owes_c {
        if o.session == 2u64 && o.reset { ended += 1u64 }
        for e in o.ended {
            let raised_fail = match e.2 { Failed(Raised(n)) => n == 5u32, _ => false }
            if (o.session == 1u64 || o.session == 3u64) && e.0 == 1u32 && raised_fail { ended += 1u64 }
        }
    }
    let c_fences = !at_c.all && list.len(at_c.sessions) == 1u64 && list.contains(at_c.sessions, 3u64)
    set(mut db, t, 0u64, 5u64)
    b.newest = Some(store.snapshot(db))
    let mut at_b = Fenced(sessions: list.new(), all: false)
    let owes_b = round(mut b, mut at_b)
    let b_fences = !at_b.all && list.len(at_b.sessions) == 4u64 && list.contains(at_b.sessions, 1u64)
        && list.contains(at_b.sessions, 2u64) && list.contains(at_b.sessions, 3u64) && list.contains(at_b.sessions, 4u64)
    set(mut db, t, 0u64, 6u64)
    b.newest = Some(store.snapshot(db))
    let mut again = Fenced(sessions: list.new(), all: false)
    let owes_again = round(mut b, mut again)
    let kept = !again.all && list.len(again.sessions) == 1u64 && list.contains(again.sessions, 4u64) && list.len(owes_again) == 0u64
    let mut idle: List[Owe] = list.new()
    repair(mut b, mut joined, mut idle)
    let _ = channel.try_send(progressed, ())
    let mut fixed: List[Owe] = list.new()
    repair(mut b, mut joined, mut fixed)
    let image = list.len(fixed) == 1u64 && fixed[0].session == 4u64 && fixed[0].version == store.version(b.base)
        && list.len(fixed[0].complete) == 1u64 && fixed[0].complete[0] == 1u32 && list.len(fixed[0].ended) == 0u64 && !fixed[0].reset
        && list.len(fixed[0].rows) == 2u64 && fixed[0].rows[0].sub == 1u32 && fixed[0].rows[1].sub == 1u32 && !joined[0].due
    bounced == 1u64 && marked && ended == 3u64 && c_fences && b_fences && list.len(owes_b) == 0u64
        && kept && list.len(idle) == 0u64 && image
}

// publisher_trap_open: a publisher that traps publishes R = u64::MAX before it goes, so the
// head's next commit is never released unfenced. The trap is real: one commitless Release
// carries more answers for one owner than the publisher's byte limit holds, and
// keep_answers' push unwraps the refusal.
fn trap_trace(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    let base = store.snapshot(db)
    let v0 = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = result.unwrap(channel.new(1u64))
    let p = Publish(place: code.describe(subs_place), n_place: 131072u64, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready_to)
    let publishing = match task.spawn(tasks, bytes 524288u64, take p, publish) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    match channel.receive(ready_from) {
        Ok(None) => (),
        _ => return false,
    }
    let (s_to, s_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let (told, hear): (Sender[Admit], Receiver[Admit]) = result.unwrap(channel.new(1u64))
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: channel.sender(s_to), told: take told, mark: None, closed: None, identity: None, fence: None, progress: None)))) {
        return false
    }
    let Admit(who: s, round: take register) = match channel.receive(hear) {
        Ok(take a) => take a,
        Error(_) => return false,
    }
    let before = latest.read(register).at == v0
    let mut answers: List[Answer] = list.new()
    for i in 0u64 .. 16384u64 {
        let row = KeyedDone(stream: list.new(), p: i, outcome: Abandoned)
        result.unwrap(list.push(mut answers, Answer(recipient: Recipient(owner: 999u64, to: channel.sender(s_to)), row: take row)))
    }
    let _ = channel.send(to, PubIn(e: Released(Release(version: 0u64, snapshot: None, answers: take answers))))
    let trapped = match task.join(take publishing) {
        Ok(_) => false,
        Error(_) => true,
    }
    let refused = match channel.send(to, PubIn(e: Drained)) { Error(_) => true, Ok(_) => false }
    let at = latest.read(register).at
    let _ = (s_from, take s_to)
    before && s != 0u64 && trapped && refused && at == ROUND_HALTED && !release_passes(at, Fence(prior: 0u64, latest: 0u64), v0)
}

fn stale_trace(c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let cv: std.codec.Codec[u64] = std.codec.of()
    let _ = result.unwrap(store.create_table(mut db, store.spec("data", std.codec.key_u64(), cv)))
    let t = result.unwrap(store.table(mut db, "data", std.codec.key_u64(), cv))
    set(mut db, t, 0u64, 1u64)
    set(mut db, t, 1u64, 0u64)
    set(mut db, t, 2u64, 0u64)
    let base = store.snapshot(db)
    let v0 = store.version(base)
    let h = match subs_handles(mut db) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    set(mut db, t, 1u64, 5u64)
    let cs = store.snapshot(db)
    set(mut db, t, 0u64, 0u64)
    let bs = store.snapshot(db)
    let vc = store.version(cs)
    let vb = store.version(bs)
    let Mailbox(to: take to, from: take from, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = result.unwrap(channel.new(1u64))
    let p = Publish(place: code.describe(subs_place), n_place: 1048576u64, h: take h, base: take base, from: take from, rounds: take rounds, ready: take ready_to)
    let publishing = match task.spawn(tasks, bytes 8388608u64, take p, publish) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    match channel.receive(ready_from) {
        Ok(None) => (),
        _ => return false,
    }
    let first = result.unwrap(arc.new(Fence(prior: 0u64, latest: 0u64)))
    let root = result.unwrap(latest.new(take first))
    let (s_to, s_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(16u64))
    let (told, hear): (Sender[Admit], Receiver[Admit]) = result.unwrap(channel.new(1u64))
    if let Error(_) = channel.send(to, PubIn(e: Joined(Join(to: take s_to, told: take told, mark: None, closed: None, identity: None, fence: Some(latest.handle(root)), progress: None)))) {
        return false
    }
    let Admit(who: s, round: take register) = match channel.receive(hear) {
        Ok(take a) => take a,
        Error(_) => return false,
    }
    let mut queue: List[ToPub] = list.new()
    result.unwrap(list.push(mut queue, Subscribed(s, 1u32, query_key(code.describe(q1)), no_arg())))
    result.unwrap(list.push(mut queue, Released(Release(version: vc, snapshot: Some(take cs), answers: list.new()))))
    for take e in queue {
        if let Error(_) = channel.send(to, PubIn(e: take e)) {
            return false
        }
    }
    let (x_to, x_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let x = join_as(to, take x_to, None)
    // Round c named only q1's cover: no fence moved.
    let at_c = latest.read(register).at == vc && latest.read(root).latest == 0u64
        && release_load(register, root, v0) && release_load(register, root, vc)
    if let Error(_) = channel.send(to, PubIn(e: Released(Release(version: vb, snapshot: Some(take bs), answers: list.new())))) {
        return false
    }
    let (y_to, y_from): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(1u64))
    let y = join_as(to, take y_to, None)
    let at_b = {
        let f = latest.read(root)
        f.prior == 0u64 && f.latest == vb
    } && latest.read(register).at == vb && !release_load(register, root, vc) && release_load(register, root, vb)
    if let Error(_) = channel.send(to, PubIn(e: Halt)) {
        return false
    }
    let stopped = match task.join(take publishing) {
        Ok(_) => true,
        Error(_) => false,
    }
    let _ = (s_from, x_from, y_from)
    stopped && s != 0u64 && x != 0u64 && y != 0u64 && at_c && at_b
}

@test
fn test_stale_never_released(c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if law_stale_never_released(c, r, tasks) { Ok(()) } else { Error(()) }
}

@test
fn test_subscribe_order(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_subscribe_order(c, r) {
        Ok(())
    } else {
        Error(())
    }
}

@test
fn test_subs_main(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_subs_main(c, r) {
        Ok(())
    } else {
        Error(())
    }
}

// ---- L16 (rows_normalized, RUNNER-SPEC v2.11.1 §3 Rows): a Row's key is the table id
// big-endian ‖ the key codec, and its value is the table's current value codec without the
// stored u16 schema prefix. 257 pad tables take ids 1..257, so "accounts" is 0x00000102,
// whose bytes differ under the two byte orders. Its row 1 is stored under schema 0
// ({balance}); the table is then opened at schema 1 ({balance, bonus = 7}) and row 2 is put.
// The expected bytes are written out by hand: u64 keys are 8 bytes big-endian (codec.md's
// order-preserving key format), u64 values 8 bytes little-endian.
type Old { balance: u64 }

type New { balance: u64, bonus: u64 }

fn old_put(v: Old, mut b: Bytes) -> Result[(), Capacity] {
    std.codec.put_u64(v.balance, mut b)
}

fn old_take(b: Bytes, mut at: u64) -> Result[Old, std.codec.Stop] {
    Ok(Old(balance: std.codec.take_u64(b, mut at)?))
}

fn old_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[Old]) -> Result[(), Capacity] {
    std.codec.define(mut s, "runner.tests.Account", 0)?
    if std.codec.record(mut s, 1)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)?
    std.codec.close(mut s)
    Ok(())
}

fn new_put(v: New, mut b: Bytes) -> Result[(), Capacity] {
    std.codec.put_u64(v.balance, mut b)?
    std.codec.put_u64(v.bonus, mut b)
}

fn new_take(b: Bytes, mut at: u64) -> Result[New, std.codec.Stop] {
    let balance = std.codec.take_u64(b, mut at)?
    let bonus = std.codec.take_u64(b, mut at)?
    Ok(New(balance: balance, bonus: bonus))
}

fn new_schema(mut s: std.codec.Schema, dictionary: std.codec.Codec[New]) -> Result[(), Capacity] {
    std.codec.define(mut s, "runner.tests.Account", 0)?
    if std.codec.record(mut s, 2)? {
        return Ok(())
    }
    std.codec.field(mut s, "balance")?
    std.codec.schema_u64(mut s)?
    std.codec.field_default(mut s, "bonus", std.codec.of_u64(), 7)?
    std.codec.close(mut s)
    Ok(())
}

type Ah: send { t: store.Shape[u64, New] }

fn accounts_q(tx: store.Tx, h: Ah, take _arg: u32) -> Result[Cover, Capacity] {
    cover(h.t, Included(1u64), Included(2u64))
}

fn accounts_place(mut r: Registry[(), Ah]) -> Result[(), RegisterError] {
    query(mut r, code.describe(accounts_q), 65536u64, DEFAULT_STEPS)
}

fn push_bytes(mut out: Bytes, x: u8, n: u64) {
    for _ in 0u64 .. n {
        result.unwrap(list.push(mut out, x))
    }
}

// The tree key of accounts row k (k < 256), by hand.
fn account_key(k: u8) -> Bytes {
    let mut out: Bytes = list.new()
    push_bytes(mut out, 0u8, 2u64)
    push_bytes(mut out, 1u8, 1u64)
    push_bytes(mut out, 2u8, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    push_bytes(mut out, k, 1u64)
    out
}

// A New value by hand: balance then bonus, each 8 bytes little-endian (both < 256).
fn account_value(balance: u8, bonus: u8) -> Bytes {
    let mut out: Bytes = list.new()
    push_bytes(mut out, balance, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    push_bytes(mut out, bonus, 1u64)
    push_bytes(mut out, 0u8, 7u64)
    out
}

fn row_is(r: Row, key: Bytes, value: Bytes) -> bool {
    r.sub == 7u32 && r.key == key && match r.value {
        Some(v) => v == value,
        None => false,
    }
}

pub fn law_rows_normalized(c: Clock, r: Random) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    for i in 0i64 .. 257i64 {
        let mut name = result.unwrap(string.from("pad"))
        result.unwrap(string.push_i64(mut name, i))
        let _ = result.unwrap(store.create_table(mut db, store.spec(take name, std.codec.key_u64(), std.codec.of_u64())))
    }
    let oc: std.codec.Codec[Old] = std.codec.make(old_put, old_take, old_schema, 8u64)
    let nc: std.codec.Codec[New] = std.codec.make(new_put, new_take, new_schema, 16u64)
    let _ = result.unwrap(store.create_table(mut db, store.spec("accounts", std.codec.key_u64(), oc)))
    let old = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), oc))
    let first = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, old, 1u64, Old(balance: 10u64))
    })
    match take first {
        Ok(Committed(_)) => (),
        _ => return false,
    }
    let current = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), nc))
    let h = Ah(t: store.shape(current))
    let reg = match placed(code.describe(accounts_place), 1048576u64) {
        Ok(take x) => take x,
        Error(_) => return false,
    }
    let ca: std.codec.Codec[u32] = std.codec.of()
    let cr: std.codec.Codec[()] = std.codec.of_unit()
    let (take key, _) = result.unwrap(described(code.identity(code.describe(accounts_q)), None, Query, ca, cr))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    // G3: the initial result, from span_changes, holds row 1 normalized from schema 0.
    let initial = at_base(mut b, 0u64, 7u32, take key, no_arg())
    if list.len(initial.complete) != 1u64 || list.len(initial.rows) != 1u64 || !row_is(initial.rows[0], account_key(1u8), account_value(10u8, 7u8)) {
        return false
    }
    // G2: row 2, put at schema 1, arrives from changes with the same normalization.
    let second = store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, current, 2u64, New(balance: 20u64, bonus: 9u64))
    })
    match take second {
        Ok(Committed(_)) => (),
        _ => return false,
    }
    let owes = step(mut b, db)
    list.len(owes) == 1u64 && list.len(owes[0].rows) == 1u64 && row_is(owes[0].rows[0], account_key(2u8), account_value(20u8, 9u8))
}

fn faulting_new_take(b: Bytes, mut at: u64) -> Result[New, std.codec.Stop] {
    let value = new_take(b, mut at)?
    if value.balance == 10u64 {
        fail("fixture: old row failed in the current decoder")
    }
    let mut i = 0u64
    while i < 8192u64 {
        i += 1u64
    }
    Ok(value)
}

fn projection_place(mut r: Registry[(), Ah]) -> Result[(), RegisterError] {
    query(mut r, code.describe(accounts_q), 65536u64, 4096u64)
}

fn faulting_projection(c: Clock, r: Random, balance: u64) -> bool waits {
    let mut db = store.memory(c, r, store.defaults())
    let oc: std.codec.Codec[Old] = std.codec.make(old_put, old_take, old_schema, 8u64)
    let nc: std.codec.Codec[New] = std.codec.make(new_put, faulting_new_take, new_schema, 16u64)
    let _ = result.unwrap(store.create_table(mut db, store.spec("accounts", std.codec.key_u64(), oc)))
    let old = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), oc))
    let _ = result.unwrap(store.run(mut db, None, scoped fn(mut tx: store.Tx) -> Result[(), store.Error] {
        store.put(mut tx, old, 1u64, Old(balance: balance))
    }))
    let current = result.unwrap(store.table(mut db, "accounts", std.codec.key_u64(), nc))
    let h = Ah(t: store.shape(current))
    let reg = result.unwrap(placed(code.describe(projection_place), 1048576u64))
    let ca: std.codec.Codec[u32] = std.codec.of()
    let (take key, _) = result.unwrap(described(code.identity(code.describe(accounts_q)), None, Query, ca, std.codec.of_unit()))
    let mut b = Board(r: take reg, h: take h, base: store.snapshot(db), newest: None, subs: subscriptions())
    let o = at_base(mut b, 1u64, 7u32, take key, no_arg())
    !o.reset && list.len(o.rows) == 0u64 && list.len(o.complete) == 0u64
        && list.len(o.ended) == 1u64 && o.ended[0].0 == 7u32 && ended_entry(b.subs, SubId(who: 1u64, sub: 7u32, serial: 0u64))
        && match o.ended[0].2 {
            Failed(Raised(5u32)) => balance == 10u64,
            Failed(OutOfTime(4096u64)) => balance == 11u64,
            _ => false,
        }
}

// The old stored layout takes the reader path and executes application code. The faulted
// first run stays only as an ended entry (v2.19.2).
pub fn law_projection_isolated(c: Clock, r: Random) -> bool waits {
    faulting_projection(c, r, 10u64) && faulting_projection(c, r, 11u64)
}

@test
fn test_projection_isolated(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_projection_isolated(c, r) { Ok(()) } else { Error(()) }
}

@test
fn test_rows_normalized(c: Clock, r: Random) -> Result[(), ()] waits {
    if law_rows_normalized(c, r) {
        Ok(())
    } else {
        Error(())
    }
}

pub const WIRE_OWNER_LIMIT: u64 = 10000u64
pub const WIRE_OWNER_FLOOR: u64 = 65536u64
const WIRE_OWNER_TASK_BYTES: u64 = 320u64
const WIRE_OVERHEAD: u64 = 67108864u64
const WIRE_SESSION_CEILING: u64 = 16777216u64
pub const WIRE_POOL_BYTES: u64 = 384u64 * 1024u64 * 1024u64
pub type WireConfig: send { n_pool: u64, max_subs: u64, socket: std.wsock.Config, q: u64, budget: u64, n_service: u64, n_place: u64, site: Option[std.wsock.Site] }

pub fn wire_defaults(n_service: u64, n_place: u64) -> WireConfig {
    WireConfig(n_pool: WIRE_POOL_BYTES, max_subs: 128u64, socket: std.wsock.defaults(), q: 4, budget: 1048576, n_service: n_service, n_place: n_place, site: None)
}

fn wire_round(n: u64) -> u64 { (n + 7u64) & 0xfffffffffffffff8u64 }

pub fn reader_bytes() -> u64 { 4096u64 }

fn wire_outcome_reserve(c: WireConfig) -> u64 {
    (1u64 + c.q) * (DONE_MAX + 36u64)
}

fn wire_service_job_bytes(c: WireConfig) -> u64 {
    c.n_place + c.n_service + 6u64 * c.socket.max_frame + 32768u64
}

fn wire_variable_peak(c: WireConfig) -> u64 {
    let m = c.socket.max_frame
    let units = 1u64 + c.q
    // Read credits bound typed inbox/deferred values. Head positions retain
    // a key and argument each, both at most one frame, plus stream and caller.
    let input = units * (4u64 * m + 128u64) + units * (2u64 * m + 256u64)
    let transport = wire_round(3u64 * m / 2u64) + 2u64 * wire_round(m + 14u64)
    let retained = c.n_place + 4u64 * m + 2u64 * c.budget + wire_outcome_reserve(c)
    input + transport + retained + wire_service_job_bytes(c) + 32768u64
}

fn wire_configuration(c: WireConfig) -> bool {
    if c.q > 4u64 || c.socket.max_frame > 262144u64 || c.socket.pending_max > 1024u64 || c.budget > 1048576u64 || c.max_subs == 0u64
        || c.n_pool == 0u64 || c.n_pool > WIRE_POOL_BYTES || c.n_service > WIRE_SESSION_CEILING || c.n_place > WIRE_SESSION_CEILING { return false }
    if wire_variable_peak(c) > WIRE_SESSION_CEILING { return false }
    // Welcome has a 21-byte principal and a digest of at most 32 bytes.
    // The launch target belongs to this run, so its size is known at serve.
    let welcome = 89u64 + launch_word(3u64, 0u64)
    let mandatory = if welcome > 125u64 { welcome } else { 125u64 }
    c.socket.max_frame >= mandatory && c.budget >= wire_round(mandatory + 14u64)
        && c.socket.max_frame >= wire_outcome_reserve(c) + 28u64
}

fn wire_decode(b: Bytes) -> Result[Frame, u16] {
    if list.len(b) < 4u64 || b[0u64] >= 4u8 || b[1u64] != 0u8 || b[2u64] != 0u8 || b[3u64] != 0u8 {
        return Error(1007u16)
    }
    let codec: std.codec.Codec[Frame] = std.codec.of()
    match std.codec.decode(codec, b) {
        Ok(Ok(take f)) => Ok(take f),
        Ok(Error(_)) => Error(1007u16),
        Error(_) => Error(1013u16),
    }
}


pub const DONE_MAX: u64 = 8192
const MAX_RETURNED_BYTES: u64 = DONE_MAX - 20u64

// WIRE W3b. The service owns principal binding, admission, dedup and outcomes.
// Each owner holds the one publisher sender. Another transport calls the same dispatch.
pub type ServiceInput: send = WAttach(Ip, Sender[WireEvent], Sender[PubIn]) | WClient(Frame, u64) | WRunner(Notice) | WPrepared(Box[ServicePlan]) | WDrained | WSent | WDropped | WPoll(bool) | WClose(u64) | WForce

pub type Service[C: send]: send {
    context: C,
    step: fn(mut C, mut WireWork, take ServiceInput) -> Result[Option[Frame], u16],
    ready: fn(C) -> bool,
    allocate: fn(mut C, take ServiceAllocation) -> Result[ServicePlan, u16],
    finish: fn(mut C) -> Option[PubIn],
    check: fn(C, Frame) -> Option[u16]
}

pub fn dispatch[C: send](mut service: Service[C], take frame: Frame) -> Result[Option[Frame], u16] {
    let mut work = wire_work()
    (service.step)(mut service.context, mut work, WClient(take frame, 0u64))
}

pub fn writer_bytes() -> u64 { 4096u64 }

// The owner result has charge-v1 size 32. Its 320-byte task
// record is part of the floor, which also covers its child tasks.
pub fn serving_bytes(c: WireConfig, owners: u64) -> Result[u64, Capacity] {
    if owners > WIRE_OWNER_LIMIT { return Error(Capacity(requested: owners, available: WIRE_OWNER_LIMIT)) }
    let floors = owners * WIRE_OWNER_FLOOR
    // Use less supervisor room when a caller deliberately serves fewer owners.
    let metadata = 2097152u64 + owners * 6711u64
    let overhead = if metadata < WIRE_OVERHEAD { metadata } else { WIRE_OVERHEAD }
    let fixed = overhead + floors
    match int.checked_add(fixed, c.n_pool) {
        Some(total) => Ok(total),
        None => Error(Capacity(requested: c.n_pool, available: 0xffffffffffffffffu64 - fixed)),
    }
}

pub opaque type WireEvent: send { e: WireInput }

fn wire_event(take e: WireInput) -> WireEvent { WireEvent(e: take e) }

type WireInput: send = Input(Frame, u64) | FromRunner(Notice) | Authenticated(Option[ingress.Principal]) | Rate(bool) | JoinReady | HelloExpired | Published(Frame) | Control(u8, std.websocket.Control) | Sent | Dropped | WriteTimedOut(u64) | ReadClosed(std.websocket.Control, std.wsock.Reader) | WriteClosed(std.wsock.Writer) | Ended(u16) | DrainWake

type WirePacket: send = Fragment | Decoded(Frame, u64) | Pinged(std.websocket.Control) | Ponged | PeerClosed(std.websocket.Control)
type WireParsed: send { reader: std.wsock.Reader, packet: Result[Option[WirePacket], std.wsock.Error] }
type WireAllocation[C: send]: send = Decode(std.wsock.Reader, u64, Sender[WireParsed]) | Encode(Frame, Sender[Result[Bytes, std.wsock.Error]]) | AllocateService(Box[Service[C]], ServiceAllocation, Sender[Option[AllocatedState[C]]])
type WirePool[C: send]: send { inbox: Receiver[WireAllocation[C]], config: std.wsock.Config, clock: Clock, tasks: Tasks, service_bytes: u64 }
pub type ServiceAllocation: send = BindPrincipal(Option[ingress.Principal]) | ValidateCall(bool) | ValidateSubscribe(u32, u32, Bytes, Option[Bytes]) | DeliverUpdate(DeliveryJob)
pub opaque type DeliveryJob: send { update: Update, output: List[WireOutput], drain: Option[Latest[Option[DrainWindow]]] }
type AllocatedState[C: send]: send { service: Box[Service[C]], status: Result[Box[ServicePlan], u16] }
type ServiceAllocationJob[C: send]: send { service: Box[Service[C]], plan: ServiceAllocation }

fn wire_allocate_job[C: send](take job: ServiceAllocationJob[C]) -> AllocatedState[C] {
    let ServiceAllocationJob(service: take owned, plan: take plan) = take job
    let mut session = take owned
    let allocate = session.allocate
    let status: Result[Box[ServicePlan], u16] = match allocate(mut session.context, take plan) {
        Ok(take result_plan) => match box.new(take result_plan) { Ok(take plan_box) => Ok(take plan_box), Error(_) => Error(1013u16) },
        Error(code) => Error(code),
    }
    AllocatedState(service: take session, status: status)
}


fn wire_parse(mut reader: std.wsock.Reader, at: u64, clock: Clock) -> Result[Option[WirePacket], std.wsock.Error] {
    match std.wsock.decode_buffered(mut reader)? {
        None => Ok(None),
        Some(Need) => Ok(Some(Fragment)),
        Some(Ping(control)) => Ok(Some(Pinged(control))),
        Some(Pong(_)) => Ok(Some(Ponged)),
        Some(Closed(control)) => Ok(Some(PeerClosed(control))),
        Some(Reject(code)) => Error(Protocol(code)),
        Some(Text(_)) => Error(Protocol(1003u16)),
        Some(Ended) => Error(Eof),
        Some(Message(take payload)) => {
            match wire_decode(payload) {
                Ok(take frame) => {
                    let arrived = match frame { Hello(_, _) => host.mono_ns(clock), _ => at }
                    Ok(Some(Decoded(take frame, arrived)))
                },
                Error(code) => Error(Protocol(code)),
            }
        },
    }
}

fn wire_pool[C: send](take pool: WirePool[C]) -> () waits {
    let WirePool(inbox: take inbox, config: config, clock: clock, tasks: tasks, service_bytes: service_bytes) = take pool
    let encoder = match std.wsock.outbound(Server, config, None) { Ok(out) => out, Error(_) => return }
    while let Ok(take work) = channel.receive(inbox) {
        match take work {
            Decode(take input, at, take to) => {
                let mut reader = take input
                let packet = wire_parse(mut reader, at, clock)
                let _ = channel.try_send(to, WireParsed(reader: take reader, packet: take packet))
            },
            Encode(take frame, take to) => {
                let encoded_frame = wire_encode(encoder, frame)
                let _ = channel.try_send(to, take encoded_frame)
            },
            AllocateService(take owned, take plan, take to) => {
                let run: fn(take ServiceAllocationJob[C]) -> AllocatedState[C] waits = wire_allocate_job
                let job = ServiceAllocationJob(service: take owned, plan: take plan)
                let returned = match task.spawn(tasks, bytes service_bytes, take job, run) {
                    Ok(take running) => match task.join(take running) {
                        Ok(take completed) => Some(take completed),
                        Error(_) => None,
                    },
                    Error((_, ServiceAllocationJob(service: take back, plan: _))) => Some(AllocatedState(service: take back, status: Error(1013u16))),
                }
                let _ = channel.try_send(to, take returned)
            },
        }
    }
}

/// One whole binary frame for f, its codec bytes written once behind the header.
pub fn wire_encode(out: std.wsock.Outbound, f: Frame) -> Result[Bytes, std.wsock.Error] {
    let codec: std.codec.Codec[Frame] = std.codec.of()
    std.wsock.encode_with(out, codec, f, wire_output_size(f))
}

fn start_wire_pool[C: send](tasks: Tasks, c: WireConfig, clock: Clock, n: u64, slots: u64) -> Result[(Sender[WireAllocation[C]], Task[()]), Capacity] {
    let allocation_inbox: Result[(Sender[WireAllocation[C]], Receiver[WireAllocation[C]]), Capacity] = channel.new(slots)
    let (to, inbox) = match take allocation_inbox { Ok(take pair) => take pair, Error(cap) => return Error(cap) }
    // Registry construction may reserve n_place. Hello key growth is bounded
    // by the wire payload, rounded identities and the list of Bytes handles.
    let pool = WirePool(inbox: take inbox, config: c.socket, clock: clock, tasks: tasks, service_bytes: wire_service_job_bytes(c))
    let run: fn(take WirePool[C]) -> () waits = wire_pool
    match task.spawn(tasks, bytes n, take pool, run) {
        Ok(take handle) => Ok((take to, take handle)),
        Error((cap, _)) => Error(cap),
    }
}

fn wire_pack[C: send](pool: Sender[WireAllocation[C]], to: Sender[Result[Bytes, std.wsock.Error]], inbox: Receiver[Result[Bytes, std.wsock.Error]], take frame: Frame) -> Result[Bytes, std.wsock.Error] waits {
    if let Error(_) = channel.try_send(pool, Encode(take frame, channel.sender(to))) { return Error(Protocol(1013u16)) }
    match channel.receive(inbox) {
        Ok(Error(Allocation(_))) => Error(Protocol(1013u16)),
        Ok(take result) => take result,
        Error(_) => Error(Protocol(1013u16)),
    }
}

fn wire_allocate[C: send](pool: Sender[WireAllocation[C]], to: Sender[Option[AllocatedState[C]]], inbox: Receiver[Option[AllocatedState[C]]], take service: Box[Service[C]], take plan: ServiceAllocation) -> Option[AllocatedState[C]] waits {
    match channel.try_send(pool, AllocateService(take service, take plan, channel.sender(to))) {
        Ok(()) => match channel.receive(inbox) { Ok(take returned) => take returned, Error(_) => None },
        Error(Full(AllocateService(take back, _, _))) => Some(AllocatedState(service: take back, status: Error(1013u16))),
        Error(Closed(AllocateService(take back, _, _))) => Some(AllocatedState(service: take back, status: Error(1013u16))),
        _ => None,
    }
}

// Read credits cover the inbox and a reader blocked on handing off a packet.
type WireRead[C: send]: send { reader: std.wsock.Reader, to: Sender[WireEvent], credits: Receiver[()], clock: Clock, config: std.wsock.Config, pool: Sender[WireAllocation[C]] }
type WireWrite: send { writer: std.wsock.Writer, from: Receiver[WireUnit], to: Sender[WireEvent], out: std.wsock.Outbound, clock: Clock, config: std.wsock.Config }

// One encoded frame for the writer. A content unit carries its version and handles to the
// round register and its session's fence root; the writer applies the release check after
// it takes the unit and before its first byte (§3).
type WireUnit: send { frame: Bytes, check: Option[WireCheck] }
type WireCheck: send { version: u64, round: Latest[RoundAt], fence: Latest[Fence] }

// A content unit is built only with both handles; the owner has them from the join that let
// the content in, so a missing one is a broken invariant and ends the session, unwritten.
fn wire_unit(work: WireWork, take frame: Bytes, check: Option[u64]) -> WireUnit {
    let checked = match check {
        Some(version) => match work.round {
            Some(register) => match work.fence {
                Some(fence) => Some(WireCheck(version: version, round: latest.handle(register), fence: latest.handle(fence))),
                None => fail("runner: a content unit without its fence"),
            },
            None => fail("runner: a content unit without the round register"),
        },
        None => None,
    }
    WireUnit(frame: take frame, check: take checked)
}

fn wire_return_reader(to: Sender[WireEvent], control: std.websocket.Control, take input: std.wsock.Reader) -> () waits {
    let mut reader = take input
    std.wsock.finish_read(mut reader)
    let _ = channel.send(to, wire_event(ReadClosed(control, take reader)))
}

fn wire_read[C: send](take x: WireRead[C]) -> () waits {
    let WireRead(reader: take initial, to: take to, credits: take credits, clock: clock, config: config, pool: take pool) = take x
    let parsed: Result[(Sender[WireParsed], Receiver[WireParsed]), Capacity] = channel.new(1u64)
    let (reply, packets) = match take parsed { Ok(take pair) => take pair, Error(_) => { wire_return_reader(to, wire_close_control(1013u16), take initial); return } }
    let mut r = take initial
    let mut probing = false
    loop {
        if let Error(_) = channel.receive(credits) { return }
        let next: WireInput = loop {
            let end = std.clock.deadline_after_ms(host.mono_ns(clock), config.idle_ms)
            let packet = loop {
                match channel.try_send(pool, Decode(take r, host.mono_ns(clock), channel.sender(reply))) {
                    Ok(()) => {},
                    Error(Full(Decode(take back, _, _))) => { wire_return_reader(to, wire_close_control(1013u16), take back); return },
                    Error(_) => return,
                }
                let WireParsed(reader: take returned, packet: take attempted) = match channel.receive(packets) {
                    Ok(take frame) => take frame,
                    Error(_) => return,
                }
                r = take returned
                match take attempted {
                    Ok(None) => {},
                    take complete => break take complete,
                }
                match std.wsock.refill(mut r, At(clock, end)) {
                    Ok(()) => if host.mono_ns(clock) >= end { break Error(Network(TimedOut)) },
                    Error(e) => break Error(e),
                }
            }
            match take packet {
                Ok(Some(Fragment)) => { probing = false },
                Ok(Some(Ponged)) => { probing = false },
                Ok(Some(Decoded(take frame, at))) => { probing = false; break Input(take frame, at) },
                Ok(Some(Pinged(control))) => { probing = false; break Control(10u8, control) },
                Ok(Some(PeerClosed(control))) => { wire_return_reader(to, control, take r); return },
                Error(Protocol(code)) => { wire_return_reader(to, wire_close_control(code), take r); return },
                Error(Allocation(_)) => { wire_return_reader(to, wire_close_control(1013u16), take r); return },
                Error(Network(TimedOut)) => {
                    if probing { wire_return_reader(to, wire_close_control(1001u16), take r); return }
                    probing = true
                    break Control(9u8, std.websocket.Control(data: [0u8; 125], len: 0u64))
                },
                _ => { wire_return_reader(to, wire_close_control(1001u16), take r); return },
            }
        }
        if let Error(_) = channel.send(to, wire_event(take next)) { return }
    }
}

fn wire_write(take x: WireWrite) -> () waits {
    let WireWrite(writer: take initial, from: take from, to: take to, out: take initial_out, clock: clock, config: config) = take x
    let mut writer = take initial
    let mut out = take initial_out
    loop {
        let unit = match channel.receive(from) {
            Ok(take b) => take b,
            Error(_) => return,
        }
        let WireUnit(frame: take frame, check: take check) = take unit
        if let Some(c) = check {
            if !release_load(c.round, c.fence, c.version) {
                if let Error(_) = channel.send(to, wire_event(Dropped)) { return }
                continue
            }
        }
        let is_close = list.len(frame) != 0u64 && frame[0u64] & 15u8 == 8u8
        let now = host.mono_ns(clock)
        let mut end = if is_close { std.clock.deadline_after_ms(now, config.close_ms) } else { int.saturating_add(now, std.wsock.MESSAGE_NS) }
        let mut can_close = !is_close
        let _ = std.wsock.stage(mut writer, take frame)
        loop {
            let flushed: Result[bool, std.wsock.Error] = if host.mono_ns(clock) >= end {
                Error(Network(TimedOut))
            } else { std.wsock.flush(mut writer, mut out, At(clock, end)) }
            match flushed {
                Ok(true) => break,
                Ok(false) => {},
                Error(Network(TimedOut)) => {
                    if !can_close { let _ = channel.send(to, wire_event(Ended(1001u16))); return }
                    // The Close frame cannot overtake a partial frame. Give the
                    // sole writer the same close deadline as the owner.
                    end = std.clock.deadline_after_ms(end, config.close_ms)
                    can_close = false
                    if let Error(_) = channel.send(to, wire_event(WriteTimedOut(end))) { return }
                },
                Error(_) => { let _ = channel.send(to, wire_event(Ended(1001u16))); return },
            }
        }
        if is_close {
            let _ = channel.send(to, wire_event(WriteClosed(take writer)))
            return
        }
        if let Error(_) = channel.send(to, wire_event(Sent)) { return }
    }
}

// The capacity-one channel is a handoff, not a second queue. busy stays set
// until Sent, so a writer stalled in send cannot retain a queued second frame.
fn wire_ready(busy: bool) -> bool { !busy }

fn wire_offer(to: Sender[WireUnit], mut busy: bool, take u: WireUnit) -> Result[(), WireUnit] {
    match channel.try_send(to, take u) {
        Ok(()) => { busy = true; Ok(()) },
        Error(Full(take full)) => Error(take full),
        Error(Closed(take closed)) => Error(take closed),
    }
}

// Tokio JoinSet::shutdown aborts all before draining. Goose's contained
// workers release on wait, but lack cancellation. Both children are unshielded.
fn wire_join(take first: Task[()], take second: Task[()]) -> () waits {
    let mut reader = take first
    let mut writer = take second
    task.cancel(mut reader)
    task.cancel(mut writer)
    let _ = task.join(take reader)
    let _ = task.join(take writer)
}

pub fn wire_publish(to: Sender[WireEvent], take frame: Frame) -> Result[(), SendError[WireEvent]] {
    channel.try_send(to, wire_event(Published(take frame)))
}

type WireAlarm: send { clock: Clock, at: u64, to: Sender[WireEvent] }

fn wire_alarm(take a: WireAlarm) -> () waits {
    host.sleep_until(a.clock, a.at)
    let _ = channel.send(a.to, wire_event(Ended(1001u16)))
}

fn wire_close_control(code: u16) -> std.websocket.Control {
    let mut data: Inline[u8, 125] = [0u8; 125]
    data[0u64] = int.narrow(code >> 8u16)
    data[1u64] = int.truncate(code)
    std.websocket.Control(data: data, len: 2u64)
}

fn wire_close_payload(code: u16) -> Bytes {
    let mut b: Bytes = result.unwrap(list.with_capacity(2u64))
    let high: u8 = int.narrow(code >> 8u16)
    let low: u8 = int.truncate(code)
    result.unwrap(list.push(mut b, high))
    result.unwrap(list.push(mut b, low))
    b
}

type WireOwner[C: send]: send { upgraded: std.wsock.Upgraded, service: Box[Service[C]], publisher: Sender[PubIn], config: WireConfig, clock: Clock, tasks: Tasks, managed: Option[OwnerControl] }

fn wire_connection_pool_bytes(c: WireConfig) -> u64 {
    let peak = wire_variable_peak(c)
    if c.n_pool < peak { c.n_pool } else { peak }
}

// Serves an already upgraded connection. W3c constructs the service at Hello;
// its sender joins the one publisher inbox lazily at the first Subscribe.
pub fn serve_connection[C: send](tasks: Tasks, take upgraded: std.wsock.Upgraded, take service: Service[C], to_publisher: Sender[PubIn], c: WireConfig, clock: Clock) -> Result[Task[Result[(), std.wsock.Error]], Capacity] {
    let boxed = match box.new(take service) { Ok(take accepted) => take accepted, Error((cap, _)) => return Error(cap) }
    let x = WireOwner(upgraded: take upgraded, service: take boxed, publisher: channel.sender(to_publisher), config: c, clock: clock, tasks: tasks, managed: None)
    let run: fn(take WireOwner[C]) -> Result[(), std.wsock.Error] waits = wire_connection_owner
    let allowance = if wire_configuration(c) { WIRE_OWNER_FLOOR - WIRE_OWNER_TASK_BYTES + wire_connection_pool_bytes(c) + 8192u64 } else { 0u64 }
    match task.spawn(tasks, bytes allowance, take x, run) {
        Ok(take h) => Ok(take h),
        Error((cap, _)) => Error(cap),
    }
}

fn wire_connection_owner[C: send](take x: WireOwner[C]) -> Result[(), std.wsock.Error] waits {
    if !wire_configuration(x.config) { return Error(Configuration) }
    let mut abandoned = 0u64
    let c = x.config
    // The reader and owner each wait for their single allocation request.
    let allocated: Result[(Sender[WireAllocation[C]], Task[()]), Capacity] = start_wire_pool(x.tasks, c, x.clock, wire_connection_pool_bytes(c), 2u64)
    let (to, take holding) = match take allocated {
        Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)),
    }
    let served = wire_owner(take x, to, mut abandoned)
    let _ = take holding
    served
}

// The owner's state across its event loop. wire_owner_setup builds it and
// returns, so the setup's temporaries leave the stack before the loop runs, and
// each event kind is handled in a call of its own, so the loop's frame holds
// one event's temporaries rather than every arm's.
type WireLoop[C: send] {
    apply_input: fn(mut C, mut WireWork, take ServiceInput) -> Result[Option[Frame], u16],
    work: WireWork, c: WireConfig, clock: Clock, tasks: Tasks, managed: Option[OwnerControl], pub_to: Sender[PubIn],
    to: Sender[WireEvent], inbox: Receiver[WireEvent], credit: Sender[()], write: Sender[WireUnit],
    encoded_to: Sender[Result[Bytes, std.wsock.Error]], encoded_from: Receiver[Result[Bytes, std.wsock.Error]],
    allocation_to: Sender[Option[AllocatedState[C]]], allocation_from: Receiver[Option[AllocatedState[C]]],
    encoder: std.wsock.Outbound, rh: Task[()], wh: Task[()], lease: Option[std.wsock.Pending],
    hello_at: Option[u64], hello_seen: bool, hello_alarm: Option[Task[()]],
    run: u64, held_credit: bool, deferred: List[(Frame, u64)], busy: bool, control: Option[Bytes], closing: bool, alarm: Option[Task[()]],
    read_back: Option[std.wsock.Reader], write_back: Option[std.wsock.Writer], read_closed: bool, write_closed: bool, close_at: Option[u64], expired: bool,
}

// What one step of the owner's loop asks of it: go on with this frame (if
// any), start the next event, or leave the loop with this result.
type WireStep = Go(Option[Frame]) | Again | Stop(Result[(), std.wsock.Error])

fn wire_owner[C: send](take x: WireOwner[C], pool: Sender[WireAllocation[C]], mut abandoned: u64) -> Result[(), std.wsock.Error] waits {
    let (take st, take service) = match wire_owner_setup(take x, pool) {
        Ok(take ready) => take ready,
        Error(take done) => return take done,
    }
    wire_owner_run(take st, take service, pool, mut abandoned)
}

// Error(r) is the owner's result when it ends before its loop.
fn wire_owner_setup[C: send](take x: WireOwner[C], pool: Sender[WireAllocation[C]]) -> Result[(WireLoop[C], Box[Service[C]]), Result[(), std.wsock.Error]] waits {
    let WireOwner(upgraded: take up, service: take initial_service, publisher: take pub_to, config: c, clock: clock, tasks: tasks, managed: take managed) = take x
    let std.wsock.Upgraded(reader: take reader, writer: take writer, source: source, timers: timers, pending: take pending) = take up
    let new_events: Result[(Sender[WireEvent], Receiver[WireEvent]), Capacity] = channel.new(1u64 + c.q)
    let lease = Some(take pending)
    let (to, inbox) = match take new_events {
        Ok(take p) => take p, Error(cap) => return Error(Error(Allocation(cap))),
    }
    if let Some(life) = managed {
        let handoff: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
        let (ready_to, ready_from) = match take handoff { Ok(take pair) => take pair, Error(cap) => return Error(Error(Allocation(cap))) }
        if let Error(_) = channel.send(life.to, OwnerReady(life.id, channel.sender(to), take ready_to)) { return Error(Ok(())) }
        if let Error(_) = channel.receive(ready_from) { return Error(Ok(())) }
    }
    let new_credits: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64 + c.q)
    let (credit, credits) = match take new_credits {
        Ok(take p) => take p, Error(cap) => return Error(Error(Allocation(cap))),
    }
    for _ in 0u64 .. 1u64 + c.q { let _ = channel.try_send(credit, ()) }
    let new_writes: Result[(Sender[WireUnit], Receiver[WireUnit]), Capacity] = channel.new(1u64)
    let (write, writes) = match take new_writes {
        Ok(take p) => take p, Error(cap) => return Error(Error(Allocation(cap))),
    }
    let results: Result[(Sender[Result[Bytes, std.wsock.Error]], Receiver[Result[Bytes, std.wsock.Error]]), Capacity] = channel.new(1u64)
    let (encoded_to, encoded_from) = match take results { Ok(take pair) => take pair, Error(cap) => return Error(Error(Allocation(cap))) }
    let allocation_results: Result[(Sender[Option[AllocatedState[C]]], Receiver[Option[AllocatedState[C]]]), Capacity] = channel.new(1u64)
    let (allocation_to, allocation_from) = match take allocation_results { Ok(take pair) => take pair, Error(cap) => return Error(Error(Allocation(cap))) }
    let out = match std.wsock.outbound(Server, c.socket, None) { Ok(o) => o, Error(e) => return Error(Error(e)) }
    let encoder = match std.wsock.outbound(Server, c.socket, None) { Ok(o) => o, Error(e) => return Error(Error(e)) }
    let reading = WireRead(reader: take reader, to: channel.sender(to), credits: take credits, clock: clock, config: c.socket, pool: channel.sender(pool))
    let read_task: fn(take WireRead[C]) -> () waits = wire_read
    let mut rh = match task.spawn(tasks, bytes reader_bytes(), take reading, read_task) {
        Ok(take h) => take h, Error((cap, _)) => return Error(Error(Allocation(cap))),
    }
    let writing = WireWrite(writer: take writer, from: take writes, to: channel.sender(to), out: out, clock: clock, config: c.socket)
    let wh = match task.spawn(tasks, bytes writer_bytes(), take writing, wire_write) {
        Ok(take h) => take h,
        Error((cap, _)) => {
            task.cancel(mut rh)
            let _ = task.join(take rh)
            return Error(Error(Allocation(cap)))
        },
    }
    let mut service = take initial_service
    let apply_input = service.step
    let mut work = wire_work()
    if let Some(life) = managed { work.drain = Some(latest.handle(life.drain)) }
    if let Error(code) = apply_input(mut service.context, mut work, WAttach(source, channel.sender(to), channel.sender(pub_to))) { wire_join(take rh, take wh); return Error(Error(Protocol(code))) }
    let hello_at = std.wsock.hello_deadline(timers)
    let mut hello_alarm: Option[Task[()]] = None
    if let Some(at) = hello_at {
        let timing = WireAlarm(clock: clock, at: at, to: channel.sender(to))
        match task.spawn(tasks, bytes 4096u64, take timing, wire_hello_alarm) { Ok(take h) => { hello_alarm = Some(take h) }, Error((cap, _)) => { wire_join(take rh, take wh); return Error(Error(Allocation(cap))) } }
    }
    let st = WireLoop(apply_input: apply_input, work: take work, c: c, clock: clock, tasks: tasks, managed: take managed, pub_to: take pub_to,
        to: take to, inbox: take inbox, credit: take credit, write: take write,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: encoder, rh: take rh, wh: take wh, lease: take lease, hello_at: hello_at, hello_seen: false, hello_alarm: take hello_alarm,
        run: 0u64, held_credit: false, deferred: list.new(), busy: false, control: None, closing: false, alarm: None,
        read_back: None, write_back: None, read_closed: false, write_closed: false, close_at: None, expired: false)
    Ok((take st, take service))
}

fn wire_owner_run[C: send](take initial: WireLoop[C], take initial_service: Box[Service[C]], pool: Sender[WireAllocation[C]], mut abandoned: u64) -> Result[(), std.wsock.Error] waits {
    let mut st = take initial
    let mut service = take initial_service
    // Every normal exit goes through wire_join, including service refusal and
    // either child's Ended. Cancellation uses CONC-8 on the two owned handles.
    let result: Result[(), std.wsock.Error] = loop {
        let received = match wire_owner_next(mut st, mut service) {
            Some(take e) => take e,
            None => break Ok(()),
        }
        let frame = match take received {
            Input(take f, at) => {
                if st.closing { let _ = channel.try_send(st.credit, ()); continue }
                match wire_owner_input(mut st, take service, pool, take f, at) {
                    Some((take kept, take outcome)) => {
                        service = take kept
                        match take outcome { Go(take next) => take next, Again => continue, Stop(take r) => break take r }
                    },
                    None => return wire_owner_lost(take st),
                }
            },
            FromRunner(take e) => {
                if st.closing { continue }
                match wire_owner_runner(mut st, take service, pool, take e) {
                    Some((take kept, take next)) => { service = take kept; take next },
                    None => return wire_owner_lost(take st),
                }
            },
            Authenticated(take p) => {
                let _ = replace(mut st.work.asking, None)
                match wire_owner_principal(mut st, take service, pool, take p) {
                    Some(take kept) => { service = take kept; None },
                    None => return wire_owner_lost(take st),
                }
            },
            JoinReady => None,
            DrainWake => None,
            HelloExpired => {
                if st.hello_seen { continue }
                wire_owner_refuse(mut st, 1008u16)
                None
            },
            Rate(allowed) => {
                let _ = replace(mut st.work.asking, None)
                if st.closing { continue }
                match wire_owner_rate(mut st, take service, pool, allowed) {
                    Some((take kept, take next)) => { service = take kept; take next },
                    None => return wire_owner_lost(take st),
                }
            },
            Published(take f) => { if st.closing { continue }; Some(take f) },
            Control(op, payload) => match wire_owner_control(mut st, op, payload) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            Sent => {
                st.busy = false
                let _ = (st.apply_input)(mut service.context, mut st.work, WSent)
                None
            },
            Dropped => {
                st.busy = false
                if let Error(code) = (st.apply_input)(mut service.context, mut st.work, WDropped) { wire_owner_refuse(mut st, code) }
                None
            },
            WriteTimedOut(end) => match wire_owner_write_timeout(mut st, end) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            ReadClosed(payload, take returned) => match wire_owner_read_closed(mut st, payload, take returned) { Go(take next) => take next, Again => continue, Stop(take r) => break take r },
            WriteClosed(take returned) => {
                st.write_back = Some(take returned)
                st.write_closed = true
                if st.read_closed { break Ok(()) }
                None
            },
            Ended(_) => break Ok(()),
        }
        let outgoing = match wire_owner_poll(mut st, mut service, take frame) { Go(take next) => take next, Again => continue, Stop(take r) => break take r }
        match wire_owner_send(mut st, mut service, pool, take outgoing) { Stop(take r) => break take r, _ => {} }
    }
    if st.expired { abandoned = st.work.abandoned }
    wire_owner_end(take st, mut service, take result)
}

// The next event, or None when the loop ends: the inbox closed, or the work's
// cut passed (the owner then expires).
fn wire_owner_next[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) -> Option[WireInput] waits {
    let event = if (service.ready)(service.context) && list.len(st.deferred) != 0u64 {
        let (take pending_frame, at) = list.remove(mut st.deferred, 0u64)
        wire_event(Input(take pending_frame, at))
    } else {
        let e = match channel.try_receive(st.inbox) {
            Ok(take e) => take e,
            Error(Empty) => { st.run = 0u64; match channel.receive(st.inbox) { Ok(take e) => take e, Error(_) => return None } },
            _ => return None,
        }
        if wire_taken(mut st.run, 1u64 + st.c.q) { let _ = (st.apply_input)(mut service.context, mut st.work, WDrained) }
        take e
    }
    if wire_owner_cut(mut st, mut service) { return None }
    if let Some(life) = st.managed {
        if let Some(window) = drain_window(latest.read(life.drain)) {
            if host.mono_ns(st.clock) >= window.admission && (match st.work.deadline { None => true, _ => false }) {
                let _ = (st.apply_input)(mut service.context, mut st.work, WClose(window.deadline))
            }
        }
    }
    let WireEvent(e: take received) = take event
    Some(take received)
}

// Whether the work's cut has passed; the service is then forced and the owner
// expires.
fn wire_owner_cut[C: send](mut st: WireLoop[C], mut service: Box[Service[C]]) -> bool {
    if !wire_cut(st.work, st.clock) { return false }
    let _ = (st.apply_input)(mut service.context, mut st.work, WForce)
    st.expired = true
    true
}

// Queues a close with this code and starts closing.
fn wire_owner_refuse[C: send](mut st: WireLoop[C], code: u16) {
    st.control = Some(result.unwrap(std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(code))))
    st.closing = true
}

// The service's answer to a frame from the client. None when the allocation
// pool is gone with the service.
fn wire_owner_input[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take f: Frame, at: u64) -> Option[(Box[Service[C]], WireStep)] waits {
    let mut service = take held
    let mut checked = (service.check)(service.context, f)
    if let Hello(_, _) = f {
        if !st.hello_seen {
            if let Some(end) = st.hello_at { if at >= end { checked = Some(1008u16) } }
            st.hello_seen = true
        }
    }
    if match checked { None => true, _ => false } && !(service.ready)(service.context) {
        if let Error(_) = list.push(mut st.deferred, (take f, at)) { return Some((take service, Stop(Ok(())))) }
        return Some((take service, Again))
    }
    if let Hello(_, _) = f { let _ = replace(mut st.hello_alarm, None) }
    let handled: Result[Option[Frame], u16] = match checked {
        Some(code) => Error(code),
        None => if let Subscribe(sub, slot, take arg, take resume) = f {
            let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take service, ValidateSubscribe(sub, slot, take arg, take resume)) {
                Some(take returned) => take returned,
                None => return None,
            }
            service = take restored
            match take status {
                Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
                Error(code) => Error(code),
            }
        } else { (st.apply_input)(mut service.context, mut st.work, WClient(take f, at)) },
    }
    if (service.ready)(service.context) { let _ = channel.try_send(st.credit, ()) } else { st.held_credit = true }
    let outcome = match take handled {
        Ok(take next) => Go(take next),
        Error(code) => {
            let payload = wire_close_payload(code)
            match std.wsock.encode(mut st.encoder, true, 8u8, payload) {
                Ok(take refused) => { st.control = Some(take refused) },
                Error(e) => return Some((take service, Stop(Error(e)))),
            }
            st.closing = true
            Go(None)
        },
    }
    Some((take service, take outcome))
}

// The service's answer to a publisher notice. None when the allocation pool is
// gone with the service.
fn wire_owner_runner[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take e: Notice) -> Option[(Box[Service[C]], Option[Frame])] waits {
    let mut service = take held
    let applied = if let Notice(e: Updated(take published)) = e {
        let drain: Option[Latest[Option[DrainWindow]]] = match st.work.drain { Some(root) => Some(latest.handle(root)), None => None }
        let output = replace(mut st.work.output, list.new())
        let job = DeliveryJob(update: take published, output: take output, drain: take drain)
        let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take service, DeliverUpdate(take job)) {
            Some(take returned) => take returned,
            None => return None,
        }
        service = take restored
        match take status {
            Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
            Error(code) => Error(code),
        }
    } else {
        (st.apply_input)(mut service.context, mut st.work, WRunner(take e))
    }
    let next = match take applied {
        Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
    }
    Some((take service, take next))
}

// Binds the authenticated principal. None when the allocation pool is gone
// with the service.
fn wire_owner_principal[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], take p: Option[ingress.Principal]) -> Option[Box[Service[C]]] waits {
    let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take held, BindPrincipal(take p)) {
        Some(take returned) => take returned,
        None => return None,
    }
    if let Error(code) = status { wire_owner_refuse(mut st, code) }
    Some(take restored)
}

// Validates a call the rate limiter decided. None when the allocation pool is
// gone with the service.
fn wire_owner_rate[C: send](mut st: WireLoop[C], take held: Box[Service[C]], pool: Sender[WireAllocation[C]], allowed: bool) -> Option[(Box[Service[C]], Option[Frame])] waits {
    let AllocatedState(service: take restored, status: take status) = match wire_allocate(pool, st.allocation_to, st.allocation_from, take held, ValidateCall(allowed)) {
        Some(take returned) => take returned,
        None => return None,
    }
    let mut service = take restored
    let applied = match take status {
        Ok(take plan) => (st.apply_input)(mut service.context, mut st.work, WPrepared(take plan)),
        Error(code) => Error(code),
    }
    let next = match take applied {
        Ok(take f) => take f, Error(code) => { wire_owner_refuse(mut st, code); None },
    }
    Some((take service, take next))
}

fn wire_owner_control[C: send](mut st: WireLoop[C], op: u8, payload: std.websocket.Control) -> WireStep {
    let _ = channel.try_send(st.credit, ())
    if st.closing { return Again }
    let mut b: Bytes = result.unwrap(list.with_capacity(125u64))
    for i in 0u64 .. payload.len { let _ = list.push(mut b, payload.data[i]) }
    match std.wsock.encode(mut st.encoder, true, op, b) {
        Ok(take encoded_control) => { st.control = Some(take encoded_control) },
        Error(e) => return Stop(Error(e)),
    }
    if op == 8u8 { st.closing = true }
    Go(None)
}

fn wire_owner_write_timeout[C: send](mut st: WireLoop[C], end: u64) -> WireStep {
    if !st.closing {
        st.close_at = Some(end)
        match std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(1001u16)) {
            Ok(take close_frame) => { st.control = Some(take close_frame) },
            Error(e) => return Stop(Error(e)),
        }
        st.closing = true
    }
    Go(None)
}

fn wire_owner_read_closed[C: send](mut st: WireLoop[C], payload: std.websocket.Control, take returned: std.wsock.Reader) -> WireStep {
    st.read_back = Some(take returned)
    st.read_closed = true
    if st.write_closed { return Stop(Ok(())) }
    if !st.closing {
        let mut b: Bytes = result.unwrap(list.with_capacity(125u64))
        for i in 0u64 .. payload.len { result.unwrap(list.push(mut b, payload.data[i])) }
        match std.wsock.encode(mut st.encoder, true, 8u8, b) {
            Ok(take close_bytes) => { st.control = Some(take close_bytes) },
            Error(e) => return Stop(Error(e)),
        }
    }
    st.closing = true
    Go(None)
}

// After an event: queues its frame, polls the service, and decides the frame to
// write now, if any.
fn wire_owner_poll[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], take frame: Option[Frame]) -> WireStep {
    if wire_owner_cut(mut st, mut service) { return Stop(Ok(())) }
    let mut outgoing: Option[Frame] = None
    if !st.closing {
        if let Some(take f) = take frame {
            if let Error(e) = wire_queue_external(mut st.work, st.c, take f, None) { return Stop(Error(e)) }
        }
        let writable = wire_ready(st.busy) && !st.write_closed && none(st.control)
            && (list.len(st.work.output) == 0u64 || !st.work.output[0u64].external)
        match (st.apply_input)(mut service.context, mut st.work, WPoll(writable)) {
            Ok(Some(take f)) => {
                if writable { outgoing = Some(take f) }
                else {
                    let held_check = replace(mut st.work.check, None)
                    if let Error(e) = wire_queue_external(mut st.work, st.c, take f, held_check) { return Stop(Error(e)) }
                }
            },
            Ok(None) => {},
            Error(code) => wire_owner_refuse(mut st, code),
        }
    }
    if st.held_credit && (service.ready)(service.context) { let _ = channel.try_send(st.credit, ()); st.held_credit = false }
    if !st.closing && map.len(st.work.timers) == 0u64 && wire_ready(st.busy) && list.len(st.work.output) == 0u64 &&
        (service.ready)(service.context) && list.len(st.deferred) == 0u64 {
        if let Some(_) = st.work.deadline {
            if let None = outgoing { wire_owner_refuse(mut st, 1001u16) }
        }
    }
    Go(take outgoing)
}

// Packs and offers the next data frame or the queued control frame, and arms
// the close alarm once closing.
fn wire_owner_send[C: send](mut st: WireLoop[C], mut service: Box[Service[C]], pool: Sender[WireAllocation[C]], take outgoing: Option[Frame]) -> WireStep waits {
    let mut data_frame: Option[(Bytes, bool, Option[u64])] = None
    if wire_ready(st.busy) && !st.write_closed && !st.closing && none(st.control) {
        let next = match take outgoing {
            Some(take f) => Some(take f),
            None => if list.len(st.work.output) != 0u64 && st.work.output[0u64].external {
                let WireOutput(frame: take f, marks: _, generations: _, external: _, check: held_check) = list.remove(mut st.work.output, 0u64)
                st.work.check = held_check
                Some(take f)
            } else { None },
        }
        if let Some(take f) = take next {
            let welcome = match f { Welcome(_, _, _, _, _, _) => true, _ => false }
            let check = replace(mut st.work.check, None)
            match wire_pack(pool, st.encoded_to, st.encoded_from, take f) {
                Ok(take b) => { data_frame = Some((take b, welcome, check)) },
                Error(Protocol(1013u16)) => {
                    match std.wsock.encode(mut st.encoder, true, 8u8, wire_close_payload(1013u16)) {
                        Ok(take refused) => { st.control = Some(take refused) },
                        Error(e) => return Stop(Error(e)),
                    }
                    st.closing = true
                },
                Error(e) => return Stop(Error(e)),
            }
            if wire_owner_cut(mut st, mut service) { return Stop(Ok(())) }
        }
    }
    let unarmed = match st.alarm { None => true, _ => false }
    if st.closing && unarmed {
        let own_close = match st.close_at {
            Some(end) => end,
            None => std.clock.deadline_after_ms(host.mono_ns(st.clock), st.c.socket.close_ms),
        }
        let deadline = match st.work.deadline { Some(cut) => if cut < own_close { cut } else { own_close }, None => own_close }
        st.close_at = Some(deadline)
        let close_wait = WireAlarm(clock: st.clock, at: deadline, to: channel.sender(st.to))
        match task.spawn(st.tasks, bytes 4096u64, take close_wait, wire_alarm) {
            Ok(take h) => { st.alarm = Some(take h) },
            Error(_) => return Stop(Ok(())),
        }
    }
    if wire_ready(st.busy) && !st.write_closed {
        if let Some(take b) = replace(mut st.control, None) {
            if let Error(_) = wire_offer(st.write, mut st.busy, WireUnit(frame: take b, check: None)) { return Stop(Ok(())) }
            return Again
        }
        if let Some((take packed, welcome, check)) = take data_frame {
            // The check version travels with the unit; WSent or WDropped clears the copy.
            st.work.check = check
            if let Error(_) = wire_offer(st.write, mut st.busy, wire_unit(st.work, take packed, check)) { return Stop(Ok(())) }
            if welcome {
                if let Some(take accepted) = replace(mut st.lease, None) { std.wsock.hello_accepted(take accepted) }
            }
        }
    }
    Go(None)
}

// The allocation pool went with the service: join both children and refuse.
fn wire_owner_lost[C: send](take st: WireLoop[C]) -> Result[(), std.wsock.Error] waits {
    // Every owned field stays bound, so it drops after the join as it did
    // when the loop was inline.
    let WireLoop(pub_to: take pub_to, managed: take managed, lease: take lease, to: take to, inbox: take inbox, credit: take credit, write: take write,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: take encoder, rh: take rh, wh: take wh, work: take work, hello_alarm: take hello_alarm, deferred: take deferred, control: take control,
        alarm: take alarm, read_back: take read_back, write_back: take write_back, clock: clock, close_at: close_at, expired: expired, ..) = take st
    wire_join(take rh, take wh)
    Error(Protocol(1013u16))
}

fn wire_owner_end[C: send](take st: WireLoop[C], mut service: Box[Service[C]], take result: Result[(), std.wsock.Error]) -> Result[(), std.wsock.Error] waits {
    // Every owned field stays bound, so it drops at the end as it did when the
    // loop was inline; only copyable fields are left out.
    let WireLoop(pub_to: take pub_to, managed: take managed, lease: take lease, to: take to, inbox: take inbox, credit: take credit, write: take write,
        encoded_to: take encoded_to, encoded_from: take encoded_from, allocation_to: take allocation_to, allocation_from: take allocation_from,
        encoder: take encoder, rh: take rh, wh: take wh, work: take work, hello_alarm: take hello_alarm, deferred: take deferred, control: take control,
        alarm: take alarm, read_back: take read_back, write_back: take write_back, clock: clock, close_at: close_at, expired: expired, ..) = take st
    if let Some(take h) = take alarm {
        let mut timing = take h
        task.cancel(mut timing)
        wire_join(take rh, take wh)
        let _ = task.join(take timing)
    } else {
        wire_join(take rh, take wh)
    }
    if !expired && (match managed { None => true, _ => false }) {
        if let Some(take returned_reader) = take read_back {
            if let Some(take returned_writer) = take write_back {
                if let Some(deadline) = close_at {
                    let _ = std.wsock.finish(take returned_writer, take returned_reader, clock, deadline)
                }
            }
        }
    }
    wire_finish_owner(mut service, pub_to)
    result
}

// At most one inbox capacity of uninterrupted takes between publisher wakes.
fn wire_taken(mut run: u64, capacity: u64) -> bool {
    run += 1u64
    if run == capacity { run = 0u64; true } else { false }
}

pub fn law_owner_take_wakes() -> bool {
    let mut run = 0u64
    let mut wakes = 0u64
    for _ in 0u64 .. 129u64 { if wire_taken(mut run, 64u64) { wakes += 1u64 } }
    wakes == 2u64 && run == 1u64
}

fn wire_finish_owner[C: send](mut service: Service[C], pub_to: Sender[PubIn]) {
    if let Some(take left) = (service.finish)(mut service.context) { let _ = channel.try_send(pub_to, take left) }
}

// The accept loop retains at most max_sessions owner handles and reaps completed
// ones on the next acceptance. Upgrade runs in the owner, so a stalled HTTP
// client cannot prevent the listener accepting another connection.
type WireAccept[C: send]: send {
    socket: Socket, peer: Ip, accepted: u64, slot: std.wsock.Pending, proxies: List[std.wsock.Prefix],
    policy: Option[ingress.Ingress], service: Box[Service[C]], publisher: Sender[PubIn], c: WireConfig, clock: Clock, tasks: Tasks,
    control: Option[OwnerControl], completion: OwnerCompletion, allocation: Sender[WireAllocation[C]],
}

fn wire_accepted[C: send](take x: WireAccept[C]) -> Result[(), std.wsock.Error] waits {
    let WireAccept(completion: take completion, socket: take socket, peer: peer, accepted: accepted, slot: take slot, proxies: take proxies,
        policy: take access_gate, service: take service, publisher: take pub_to, c: c, clock: clock, tasks: tasks, control: take control, allocation: take allocation) = take x
    let mut active: Option[ingress.Lease] = None
    let admission = scoped fn(ip: Ip) -> bool waits {
        if let Some(life) = control { if closing_at(life.drain, clock) { return false } }
        if let Some(i) = access_gate {
            active = ingress.open(i, ip)
            match active { Some(_) => true, None => false }
        } else { true }
    }
    let mut abandoned = 0u64
    let received = std.wsock.server_with_site(take socket, take slot, peer, proxies, c.socket, clock, accepted, c.site, admission)
    let result: Result[(), std.wsock.Error] = match take received {
        Ok(None) => Ok(()),
        Ok(Some(take up)) => wire_owner(WireOwner(upgraded: take up, service: take service, publisher: take pub_to, config: c, clock: clock, tasks: tasks, managed: take control), allocation, mut abandoned),
        Error(e) => Error(e),
    }
    let _ = take active
    let mut final_report = take completion
    final_report.abandoned = abandoned
    result
}

pub fn serve[C: send](take listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, take proxies: List[std.wsock.Prefix], make: scoped[view] fn() -> Service[C]) -> Result[(), std.wsock.Error] waits {
    serve_ingress(take listener, tasks, clock, to_publisher, c, max_sessions, take proxies, None, make)
}

pub fn serve_admitted[C: send](take listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, take proxies: List[std.wsock.Prefix], access_gate: ingress.Ingress, make: scoped[view] fn() -> Service[C]) -> Result[(), std.wsock.Error] waits {
    serve_ingress(take listener, tasks, clock, to_publisher, c, max_sessions, take proxies, Some(ingress.share(access_gate)), make)
}

type ServeInput: send = AcceptedSocket(Socket, Ip, u64) | AcceptEnded(NetError) | OwnerReady(u64, Sender[WireEvent], Sender[()]) | OwnerEnded(u64, u64) | ServeStart | ServeWake

type OwnerControl: send { id: u64, to: Sender[ServeInput], drain: Latest[Option[DrainWindow]] }

resource type OwnerCompletion: send { to: Sender[ServeInput], id: u64, abandoned: u64 } drop(completion) {
    let _ = channel.try_send(completion.to, OwnerEnded(completion.id, completion.abandoned))
}

type Acceptor: send { listener: Listener, clock: Clock, to: Sender[ServeInput], permit: Receiver[()] }

fn accept_sockets(take seed: Acceptor) -> () waits {
    let Acceptor(listener: take listener, clock: clock, to: take to, permit: take permit) = take seed
    let mut bound_listener = take listener
    while let Ok(()) = channel.receive(permit) {
        match host.accept(mut bound_listener, Never) {
            Ok((take socket, peer)) => if let Error(_) = channel.send(to, AcceptedSocket(take socket, peer.ip, host.mono_ns(clock))) { return },
            Error(problem) => { let _ = channel.send(to, AcceptEnded(problem)); return },
        }
    }
}

type ManagedRefusal: send { socket: Socket, clock: Clock, until: u64, completion: OwnerCompletion }

fn refuse_managed_socket(take seed: ManagedRefusal) -> () waits {
    let ManagedRefusal(socket: take socket, clock: clock, until: until, completion: take completion) = take seed
    let _ = std.wsock.refuse_socket(take socket, 503u16, At(clock, until))
    let _ = take completion
}

type SessionTask { handle: Task[Result[(), std.wsock.Error]], wake: Option[Sender[WireEvent]] }

type ServeTransport {
    listener: Listener, config: WireConfig, tasks: Tasks, clock: Clock, policy: Option[ingress.Ingress],
    limit: u64, proxies: List[std.wsock.Prefix], publisher: Sender[PubIn], inbox: Receiver[ServeInput], to: Sender[ServeInput],
}

type ServeDrain { events: Sender[LifeEvent], window: Latest[Option[DrainWindow]] }

fn serve_closing(lifecycle: Option[ServeDrain], clock: Clock) -> bool {
    match lifecycle { Some(control) => closing_at(control.window, clock), _ => false }
}

type ServePlace[G: send, H: send]: send {
    listener: Listener, config: WireConfig, tasks: Tasks, clock: Clock, policy: ingress.Ingress,
    max_sessions: u64, proxies: List[std.wsock.Prefix], target: String, publisher: Sender[PubIn],
    place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], head: Sender[HeadInput],
    inbox: Receiver[ServeInput], to: Sender[ServeInput], events: Sender[LifeEvent], drain: Latest[Option[DrainWindow]],
}

fn run_serve_place[G: send, H: send](take seed: ServePlace[G, H]) -> () waits {
    let events = channel.sender(seed.events)
    let serving = supervise_serve(take seed)
    let _ = channel.send(events, ServeEnded(take serving))
}

fn supervise_serve[G: send, H: send](take seed: ServePlace[G, H]) -> Result[u64, StartError] waits {
    let ServePlace(listener: take listener, config: config, tasks: tasks, clock: clock, policy: take access_gate,
        max_sessions: limit, proxies: take proxies, target: take target, publisher: take pub_to, place: place,
        head: take head_to, inbox: take inbox, to: take to, events: take events, drain: take drain) = take seed
    let make: scoped[view] fn() -> Service[WireSession[G, H]] = fn() -> Service[WireSession[G, H]] {
        let initial: Registry[G, H] = registry()
        let mut service = wire_service_with_head(take initial, access_gate, LifecycleHead(channel.sender(head_to)), clock, tasks, config, result.unwrap(clone(target)))
        service.context.place = Some(place)
        take service
    }
    let transport = ServeTransport(listener: take listener, config: config, tasks: tasks, clock: clock, policy: Some(ingress.share(access_gate)),
        limit: limit, proxies: take proxies, publisher: take pub_to, inbox: take inbox, to: take to)
    match serve_sockets(take transport, Some(ServeDrain(events: take events, window: take drain)), make) {
        Ok(count) => Ok(count), Error(Allocation(cap)) => Error(Full(cap)), Error(Network(problem)) => Error(Listen(problem)), _ => Error(Missing("socket")),
    }
}

fn serve_sockets[C: send](take seed: ServeTransport, take lifecycle: Option[ServeDrain], make: scoped[view] fn() -> Service[C]) -> Result[u64, std.wsock.Error] waits {
    let ServeTransport(listener: take listener, config: config, tasks: tasks, clock: clock, policy: take access_gate,
        limit: limit, proxies: take proxies, publisher: take pub_to, inbox: take inbox, to: take to) = take seed
    let pool = std.wsock.pending(config.socket)?
    let allocated: Result[(Sender[WireAllocation[C]], Task[()]), Capacity] = start_wire_pool(tasks, config, clock, config.n_pool, 1024u64)
    let (allocation, allocation_task) = match take allocated {
        Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)),
    }
    let credit: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
    let (permit, permits) = match take credit { Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)) }
    let acceptor = Acceptor(listener: take listener, clock: clock, to: channel.sender(to), permit: take permits)
    let mut accepting: Option[Task[()]] = match task.spawn(tasks, bytes 8192u64, take acceptor, accept_sockets) {
        Ok(take handle) => Some(take handle), Error((cap, _)) => return Error(Allocation(cap)),
    }
    if let Some(control) = lifecycle {
        if let Error(_) = channel.send(control.events, ServePrepared) { return Ok(0u64) }
        if let Ok(ServeStart) = channel.receive(inbox) {} else { return Ok(0u64) }
    }
    let _ = channel.try_send(permit, ())
    let mut owners: Map[u64, SessionTask] = map.new()
    let mut refusing: Map[u64, Task[()]] = map.new()
    let mut serial = 0u64
    let mut abandoned = 0u64
    loop {
        if serve_closing(lifecycle, clock) {
            if let Some(take accept_task) = replace(mut accepting, None) {
                let mut counted = take accept_task
                task.cancel(mut counted)
                let _ = task.join(take counted)
                let _ = replace(mut refusing, map.new())
                let mut closing_ids: List[u64] = list.new()
                for (id, owner_task) in owners {
                    match owner_task.wake {
                        Some(wake) => { let _ = channel.try_send(wake, wire_event(DrainWake)) },
                        None => result.unwrap(list.push(mut closing_ids, id)),
                    }
                }
                for id in closing_ids { let _ = map.remove(mut owners, id) }
            }
            if map.len(owners) == 0u64 { return Ok(abandoned) }
        }
        let event = match channel.receive(inbox) { Ok(take event) => take event, Error(_) => return Ok(abandoned) }
        match take event {
            ServeStart => (),
            ServeWake => for (_, owner_task) in owners { if let Some(wake) = owner_task.wake { let _ = channel.try_send(wake, wire_event(DrainWake)) } },
            AcceptEnded(problem) => if !serve_closing(lifecycle, clock) { return Error(Network(problem)) },
            OwnerReady(id, take wake, take acknowledgement) => {
                if !serve_closing(lifecycle, clock) {
                    if let Some(take owner_task) = map.remove(mut owners, id) {
                        let mut promoted = take owner_task
                        promoted.wake = Some(take wake)
                        result.unwrap(map.insert(mut owners, id, take promoted))
                        let _ = channel.try_send(acknowledgement, ())
                    }
                }
            },
            OwnerEnded(id, count) => {
                abandoned += count
                if let Some(SessionTask(handle: take handle, wake: _)) = map.remove(mut owners, id) { let _ = task.join(take handle) }
                if let Some(take handle) = map.remove(mut refusing, id) { let _ = task.join(take handle) }
            },
            AcceptedSocket(take socket, peer, at) => {
                if serve_closing(lifecycle, clock) { continue }
                let _ = channel.try_send(permit, ())
                let id = serial
                serial += 1u64
                let pending: Option[std.wsock.Pending] = if map.len(owners) >= limit { None } else { match std.wsock.acquire(pool) { Ok(take slot) => take slot, _ => None } }
                let slot = match take pending {
                    Some(take slot) => take slot,
                    None => { start_socket_refusal(tasks, take socket, clock, at, config, to, id, mut refusing); continue },
                }
                let copied: Result[List[std.wsock.Prefix], Capacity] = clone(proxies)
                let prefixes = match take copied { Ok(take prefixes) => take prefixes, Error(_) => { start_socket_refusal(tasks, take socket, clock, at, config, to, id, mut refusing); continue } }
                let made = bound bytes config.n_service { make() }
                let service = match take made { Ok(take instance) => take instance, Error(_) => { start_socket_refusal(tasks, take socket, clock, at, config, to, id, mut refusing); continue } }
                let boxed = match box.new(take service) { Ok(take held) => take held, Error(_) => { start_socket_refusal(tasks, take socket, clock, at, config, to, id, mut refusing); continue } }
                let completion = match OwnerCompletion(to: channel.sender(to), id: id, abandoned: 0u64) { Ok(take completion) => take completion, Error(_) => continue }
                let control: Option[OwnerControl] = match lifecycle {
                    Some(life) => Some(OwnerControl(id: id, to: channel.sender(to), drain: latest.handle(life.window))), _ => None,
                }
                let job = WireAccept(socket: take socket, peer: peer, accepted: at, slot: take slot, proxies: take prefixes,
                    policy: match access_gate { Some(rules) => Some(ingress.share(rules)), _ => None }, service: take boxed, publisher: channel.sender(pub_to), c: config,
                    clock: clock, tasks: tasks, control: take control, completion: take completion, allocation: channel.sender(allocation))
                let run: fn(take WireAccept[C]) -> Result[(), std.wsock.Error] waits = wire_accepted
                match task.spawn(tasks, bytes (WIRE_OWNER_FLOOR - WIRE_OWNER_TASK_BYTES), take job, run) {
                    Ok(take handle) => result.unwrap(map.insert(mut owners, id, SessionTask(handle: take handle, wake: None))),
                    Error((_, take back)) => {
                        let WireAccept(socket: take refused, ..) = take back
                        start_socket_refusal(tasks, take refused, clock, at, config, to, serial, mut refusing)
                        serial += 1u64
                    },
                }
            },
        }
    }
}

fn start_socket_refusal(tasks: Tasks, take socket: Socket, clock: Clock, at: u64, config: WireConfig, to: Sender[ServeInput], id: u64, mut refusing: Map[u64, Task[()]]) {
    if map.len(refusing) >= 16u64 { return }
    if let Ok(take completion) = OwnerCompletion(to: channel.sender(to), id: id, abandoned: 0u64) {
        let job = ManagedRefusal(socket: take socket, clock: clock, until: std.clock.deadline_after_ms(at, config.socket.upgrade_ms), completion: take completion)
        if let Ok(take handle) = task.spawn(tasks, bytes 16384u64, take job, refuse_managed_socket) { let _ = map.insert(mut refusing, id, take handle) }
    }
}

fn serve_ingress[C: send](take listener: Listener, tasks: Tasks, clock: Clock, to_publisher: Sender[PubIn], c: WireConfig, max_sessions: u64, take proxies: List[std.wsock.Prefix], take access_gate: Option[ingress.Ingress], make: scoped[view] fn() -> Service[C]) -> Result[(), std.wsock.Error] waits {
    if max_sessions == 0u64 || max_sessions > WIRE_OWNER_LIMIT || !wire_configuration(c) { return Error(Configuration) }
    let required = match serving_bytes(c, max_sessions) { Ok(total) => total, Error(cap) => return Error(Allocation(cap)) }
    let served: Result[Result[(), std.wsock.Error], Capacity] = bound bytes required {
        let messages: Result[(Sender[ServeInput], Receiver[ServeInput]), Capacity] = channel.new(serve_inbox_capacity(max_sessions))
        let (to, inbox) = match take messages { Ok(take pair) => take pair, Error(cap) => return Error(Allocation(cap)) }
        let transport = ServeTransport(listener: take listener, config: c, tasks: tasks, clock: clock, policy: take access_gate,
            limit: max_sessions, proxies: take proxies, publisher: channel.sender(to_publisher), inbox: take inbox, to: take to)
        match serve_sockets(take transport, None, make) { Ok(_) => Ok(()), Error(problem) => Error(problem) }
    }
    match take served { Ok(take ended) => take ended, Error(cap) => Error(Allocation(cap)) }
}

fn limited_reply(take b: Bytes) -> Outcome {
    if list.len(b) > MAX_RETURNED_BYTES {
        Failed(OutOfBytes(Room(requested: list.len(b), available: MAX_RETURNED_BYTES)))
    } else { Returned(take b) }
}

fn register_check[G: send, H: send, A](mut r: Registry[G, H], key: Bytes, ca: std.codec.Codec[A], n: u64, steps: u64) -> Result[(), RegisterError] {
    let check = fn(arg: Bytes) -> Option[Refusal] {
        let seen = bound bytes n {
            let validate = scoped fn() -> Result[Option[Refusal], OutOfTime] {
                bound steps steps {
                    match std.codec.decode(ca, arg) {
                        Ok(Ok(_)) => { let no_refusal: Option[Refusal] = None; no_refusal },
                        Ok(Error(e)) => Some(Malformed(bad(e))),
                        Error(c) => Some(Budget(room(c))),
                    }
                }
            }
            isolate(validate)
        }
        match take seen {
            Ok(Ok(Ok(Ok(take why)))) => take why,
            Ok(Ok(Ok(Error(_)))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Ok(Error(_))) => Some(Malformed(Bad(kind: 6u32, at: 0u64))),
            Ok(Error(c)) => Some(Budget(room(c))),
            Error(c) => Some(Budget(room(c))),
        }
    }
    let go = match check { Ok(take f) => take f, Error((c, _)) => return Error(Full(c)) }
    let copied_result: Result[Bytes, Capacity] = clone(key)
    let copied: Bytes = match take copied_result { Ok(take b) => take b, Error(c) => return Error(Full(c)) }
    match map.insert(mut r.checks, take copied, take go) { Ok(()) => Ok(()), Error((c, _)) => Error(Full(c)) }
}

// The composition root supplies previous/current activation keys. A current key
// always wins; retaining a gone key never substitutes a newly registered entry.
pub fn retain_gone[G: send, H: send](mut r: Registry[G, H], take key: Bytes) -> Result[(), RegisterError] {
    match map.insert(mut r.gone, take key, ()) { Ok(()) => Ok(()), Error((c, _)) => Error(Full(c)) }
}

pub opaque type Admitted: send {
    caller: Caller, entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64
}

pub fn admitted(take caller: Caller, take entries: List[Bytes], arrived: u64, now: u64, budget: u64, arg_max: u64) -> Admitted {
    Admitted(caller: take caller, entries: take entries, arrived: arrived, now: now, budget: budget, arg_max: arg_max)
}

pub type CallWant: send { key: Bytes, stream: u32, p: u64, arg: Bytes, deadline_ms: u32 }
pub opaque type Send: send { key: Bytes, stream: Bytes, p: u64, arg: Bytes, digest: store.RequestDigest, deadline: u64, budget: u64 }

pub fn prepare[G: send, H: send](r: Registry[G, H], a: Admitted, take want: CallWant) -> Result[Send, Refusal] {
    let known = map.contains(r.slots, want.key)
    if !known && !map.contains(r.gone, want.key) { return Error(NoEntry) }
    let mut allowed = false
    for key in a.entries { if key == want.key { allowed = true } }
    if !allowed { return Error(NotAllowed) }
    let size = list.len(want.arg)
    if size > a.arg_max { return Error(Budget(Room(requested: size, available: a.arg_max))) }
    if size > a.budget { return Error(Budget(Room(requested: size, available: a.budget))) }
    let relative: u64 = int.widen(want.deadline_ms)
    let end = std.clock.deadline_after_ms(a.arrived, relative)
    if want.deadline_ms == 0u32 || end <= a.now { return Error(Deadline) }
    if let Some(check) = map.get(r.checks, want.key) {
        if let Some(take why) = check(want.arg) { return Error(take why) }
    }
    let digest = store.request_digest(want.key, want.arg)
    let stream = match stream_key(a.caller, want.stream) { Ok(take b) => take b, Error(c) => return Error(Budget(room(c))) }
    let CallWant(key: take key, stream: _, p: p, arg: take arg, deadline_ms: _) = take want
    Ok(Send(key: take key, stream: take stream, p: p, arg: take arg, digest: digest, deadline: end, budget: a.budget))
}

// The wire owner owns this state. Policy tasks answer only through its inbox.
type WireOwed: send { generation: u64, reply: Bytes }

// v2.19: `fence` is the session's fence root, made at join, and `round` the place's round
// register, from the join's answer. `check` and `sending_done` are the unit handed out last:
// its version, and a copy of its Outcome rows, which a Dropped Reset carries (§3).
pub opaque type WireWork { head: Option[HeadLease], asking: Option[Task[()]], timers: Map[u64, Task[()]], output: List[WireOutput], sending: List[WireMark], deadline: Option[u64], drain: Option[Latest[Option[DrainWindow]]], abandoned: u64, fence: Option[Latest[Fence]], round: Option[Latest[RoundAt]], check: Option[u64], sending_done: List[Done] }

fn wire_work() -> WireWork { WireWork(head: None, asking: None, timers: map.new(), output: list.new(), sending: list.new(), deadline: None, drain: None, abandoned: 0u64, fence: None, round: None, check: None, sending_done: list.new()) }

fn wire_cut(work: WireWork, clock: Clock) -> bool {
    wire_cut_at(work.drain, clock)
}

fn wire_cut_at(drain: Option[Latest[Option[DrainWindow]]], clock: Clock) -> bool {
    if let Some(root) = drain {
        if let Some(window) = drain_window(latest.read(root)) { return host.mono_ns(clock) >= window.deadline }
    }
    false
}

fn wire_admission_closed(work: WireWork, clock: Clock) -> bool {
    match work.drain { Some(root) => closing_at(root, clock), _ => false }
}
type WireHeld: send { stream: u32, p: u64, digest: store.RequestDigest, forwarded: bool, queued: u64, owed: List[WireOwed] }
type WireMark: send = Unit(Bytes) | V1

// The service and public transport callbacks share this owner-local queue. An
// external item has no outcome units or subscription generations to retire.
// `check` is a content unit's version, the oldest of its content components' (§3 "The release
// check"); None for a unit that carries no content and passes unchecked.
type WireOutput: send { frame: Frame, marks: List[WireMark], generations: List[(u32, u64)], external: bool, check: Option[u64] }
type WirePending: send { stream: u32, p: u64, slot: u32, deadline: u32, arg: Bytes, at: u64, grows: bool }
type WireAsk: send = Bind(Option[Bytes]) | CheckRate(Caller)
type WirePolicy: send { policy: ingress.Ingress, source: Ip, request: WireAsk, to: Sender[WireEvent] }

fn wire_policy(take job: WirePolicy) -> () waits {
    let WirePolicy(policy: take access_gate, source: source, request: take request, to: take to) = take job
    let answer = match take request {
        CheckRate(caller) => Rate(ingress.call(access_gate, caller)),
        Bind(take token) => Authenticated(ingress.hello(access_gate, source, take token)),
    }
    let _ = channel.send(to, wire_event(take answer))
}

type WireDeadline: send { clock: Clock, at: u64, to: Sender[WireEvent], stream: Bytes, p: u64, generation: u64 }

fn wire_deadline(take t: WireDeadline) -> () waits {
    host.sleep_until(t.clock, t.at)
    let WireDeadline(clock: _, at: _, to: take to, stream: take stream, p: p, generation: g) = take t
    let _ = channel.send(to, wire_event(FromRunner(Notice(e: Expired(Tick(stream: take stream, p: p, generation: g))))))
}

type WireHead: send = LegacyHead(Sender[Req]) | LifecycleHead(Sender[HeadInput])
type HeadOffer = Posted | InboxFull | InboxClosed

fn copy_wire_head(head: WireHead) -> WireHead {
    match head {
        LegacyHead(to) => LegacyHead(channel.sender(to)),
        LifecycleHead(to) => LifecycleHead(channel.sender(to)),
    }
}

fn try_head(head: WireHead, take req: Req) -> HeadOffer {
    match head {
        LegacyHead(to) => match channel.try_send(to, take req) {
            Ok(()) => Posted,
            Error(Full(_)) => InboxFull,
            Error(Closed(_)) => InboxClosed,
        },
        LifecycleHead(to) => match channel.try_send(to, RunRequest(take req)) {
            Ok(()) => Posted,
            Error(Full(_)) => InboxFull,
            Error(Closed(_)) => InboxClosed,
        },
    }
}

type SubscriptionRoom: send {
    to: Sender[u64], from: Receiver[u64], slots: u64, limit: u64, held: u64, used: u64,
}

fn subscription_room(limit: u64, max_subs: u64) -> Result[SubscriptionRoom, Capacity] {
    let possible = int.saturating_sub(limit, 64u64) / 8u64
    let wanted = int.saturating_add(max_subs, 1u64)
    let slots = if wanted < possible { wanted } else { possible }
    if slots == 0u64 { return Error(Capacity(requested: 72u64, available: limit)) }
    let (to, from): (Sender[u64], Receiver[u64]) = channel.new(slots)?
    Ok(SubscriptionRoom(to: take to, from: take from, slots: slots, limit: limit - (64u64 + slots * 8u64), held: 0u64, used: 0u64))
}

fn subscription_hold(mut quota: SubscriptionRoom, take key: Bytes, take arg: Bytes) -> Result[SubscriptionInput, Capacity] {
    while let Ok(charge) = channel.try_receive(quota.from) {
        quota.held -= charge
        quota.used -= 1u64
    }
    // Include the lease record. One refund fits for every issued lease.
    let charge = wire_round(list.capacity(key)) + wire_round(list.capacity(arg)) + 64u64
    let available = quota.limit - quota.held
    if quota.used == quota.slots || charge > available { return Error(Capacity(requested: charge, available: available)) }
    let lease = result.capacity_only(SubscriptionLease(refund: channel.sender(quota.to), charge: charge))?
    quota.held += charge
    quota.used += 1u64
    Ok(SubscriptionInput(room: Some(take lease), key: take key, arg: take arg))
}

pub opaque type WireSession[G: send, H: send]: send {
    registry: Registry[G, H], place: Option[StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]]], policy: ingress.Ingress, head: WireHead, clock: Clock, tasks: Tasks, config: WireConfig, target: String,
    source: Ip, me: Option[Sender[WireEvent]], publisher: Option[Sender[PubIn]], caller: Option[Caller], welcome_token: Option[Bytes],
    phase: u8, wants: List[Want], entries: List[Bytes], placing: u64,
    asking: bool, pending: Option[WirePending],
    held: Map[Bytes, WireHeld], refusals: u64, last: u64, generation: u64,
    joined: Option[u64], joining: Option[Receiver[Admit]], join_lease: Option[WireJoinLease], marked: bool, mark: Option[Sender[()]], subscription: Option[(u32, SubscriptionInput)], subscription_room: Option[SubscriptionRoom], sub_generation: u64, subs: List[(u32, u64)], pub_subs: List[u32], reset_seen: bool,
    holding: bool, leaving: List[WireJoinLease], resubs: List[WireResub],
    // §3 "Repair": the drain token's sender, made at each join; the publisher holds the receiver.
    progress: Option[Sender[()]]
}

// v2.19.2 (§3 "The owner asks for removal"): a replacing Subscribed held while the writer
// holds a content unit. The owner already counts the new instance as live.
type WireResub: send { sub: u32, generation: u64, input: SubscriptionInput }

pub fn wire_service[G: send, H: send](take reg: Registry[G, H], access_gate: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, a: Args) -> Service[WireSession[G, H]] {
    wire_service_with_head(take reg, access_gate, LegacyHead(channel.sender(head)), clock, tasks, config, result.unwrap(launch_target(a)))
}

fn wire_service_seed[G: send, H: send](take reg: Registry[G, H], access_gate: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, H]] {
    wire_service_with_head(take reg, access_gate, LegacyHead(channel.sender(head)), clock, tasks, config, take target)
}

fn wire_service_with_head[G: send, H: send](take reg: Registry[G, H], access_gate: ingress.Ingress, take head: WireHead, clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, H]] {
    let context = WireSession(registry: take reg, place: None, policy: ingress.share(access_gate), head: take head, clock: clock, tasks: tasks, config: config, target: take target,
        source: V4(0u32), me: None, publisher: None, caller: None, welcome_token: None, phase: 0u8, wants: list.new(), entries: list.new(), placing: 0u64,
        asking: false, pending: None, held: map.new(), refusals: 0u64, last: 0u64, generation: 0u64,
        joined: None, joining: None, join_lease: None, marked: false, mark: None, subscription: None, subscription_room: None, sub_generation: 0u64, subs: list.new(), pub_subs: list.new(), reset_seen: false,
        holding: false, leaving: list.new(), resubs: list.new(), progress: None)
    Service(context: take context, step: wire_step, ready: wire_can_read, allocate: wire_service_allocate, finish: wire_finish, check: wire_check_live)
}

fn wire_can_read[G: send, H: send](s: WireSession[G, H]) -> bool {
    (s.phase == 0u8 || s.phase == 3u8) && !s.asking && match s.joining { None => true, _ => false }
}

fn wire_key(w: Want) -> Result[Bytes, Capacity] {
    let mut key: Bytes = list.with_capacity(list.len(w.identity) + 16u64)?
    list.append(mut key, w.identity)?
    std.codec.put_u64(w.args_fp, mut key)?
    std.codec.put_u64(w.result_fp, mut key)?
    Ok(take key)
}

fn wire_stream(caller: Caller, number: u32) -> Bytes {
    result.unwrap(stream_key(caller, number))
}

fn wire_units[G: send, H: send](s: WireSession[G, H]) -> u64 {
    let mut units = 0u64
    for (_, h) in s.held {
        let live = list.len(h.owed) + h.queued
        units += if h.forwarded && live == 0u64 { 1u64 } else { live }
    }
    if let Some(p) = s.pending { if p.grows { units += 1u64 } }
    units
}

// std codec: a u32 tag, u32 lengths and integers at their width. A Done is
// stream 4 and p 8, then the Outcome's tag 4 and payload. Every variant is
// named, so a new one cannot fall into another's size.
fn wire_done_size(o: Outcome) -> u64 {
    12u64 + match o {
        Returned(b) => 8u64 + list.len(b),
        Failed(OutOfBytes(_)) => 24u64,
        Failed(OutOfTime(_)) => 16u64,
        Failed(Raised(_)) => 12u64,
        Failed(Gone) => 8u64,
        Refused(Budget(_)) => 24u64,
        Refused(Malformed(_)) => 20u64,
        Refused(NoEntry) => 8u64,
        Refused(Overloaded) => 8u64,
        Refused(Deadline) => 8u64,
        Refused(NotAllowed) => 8u64,
        Refused(RequestMismatch) => 8u64,
        Refused(HistoryUnavailable) => 8u64,
        Abandoned => 4u64,
        InDoubt => 4u64,
    }
}

fn wire_rows_size(rows: List[Row]) -> u64 {
    let mut size = 0u64
    for row in rows {
        size += 12u64 + list.len(row.key)
        if let Some(value) = row.value { size += 4u64 + list.len(value) }
    }
    size
}

fn wire_optional_bytes(b: Option[Bytes]) -> u64 {
    match b { Some(value) => 4u64 + list.len(value), None => 0u64 }
}

fn wire_done_bytes(done: List[Done]) -> u64 {
    let mut size = 0u64
    for d in done { size += wire_done_size(d.outcome) }
    size
}

fn wire_output_size(f: Frame) -> u64 {
    match f {
        Hello(token, wanted) => {
            let mut size = 12u64 + wire_optional_bytes(token)
            for entry in wanted { size += 20u64 + list.len(entry.identity) }
            size
        },
        Call(_, _, _, _, arg) => 28u64 + list.len(arg),
        Subscribe(_, _, arg, resume) => 20u64 + list.len(arg) + wire_optional_bytes(resume),
        Unsubscribe(_) => 8u64,
        Welcome(principal, _, _, digest, target, _) => 36u64 + list.len(principal) + list.len(digest) + string.byte_len(target),
        Placed(Ready(_)) => 12u64,
        Placed(Resolve(_, args)) => 16u64 + list.len(args),
        Placed(Gone) => 8u64,
        Batch(_, complete, rows, done) => 24u64 + 4u64 * list.len(complete) + wire_rows_size(rows) + wire_done_bytes(done),
        Reset(_, done) => 16u64 + wire_done_bytes(done),
        Ended(_, o) => 8u64 + wire_done_size(o) - 12u64,
    }
}

// Retained row storage includes the 60-byte Row records and the rounded
// backing buffers of their key and value lists (WIRE-SPEC F4).
fn wire_rows_retained(rows: List[Row]) -> u64 {
    let mut size = wire_round(60u64 * list.capacity(rows))
    for row in rows {
        size += wire_round(list.capacity(row.key))
        if let Some(value) = row.value { size += wire_round(list.capacity(value)) }
    }
    size
}

fn wire_batch_charge(complete: List[u32], rows: List[Row], done: List[Done], reserved: bool) -> u64 {
    let row_payload = wire_rows_size(rows)
    let retained = wire_rows_retained(rows)
    24u64 + 4u64 * list.len(complete) + (if retained > row_payload { retained } else { row_payload })
        + (if reserved { 0u64 } else { wire_done_bytes(done) })
}

fn wire_output_charge(f: Frame, reserved: bool) -> u64 {
    // Slot and V1 marks already hold the outcome reserve through handoff.
    match f {
        Batch(_, complete, rows, done) => wire_batch_charge(complete, rows, done, reserved),
        Reset(_, _) => if reserved { 16u64 } else { wire_output_size(f) },
        _ => wire_output_size(f),
    }
}

fn wire_queued_bytes(output: List[WireOutput]) -> u64 {
    // WireOutput's charge-v1 size is Frame (88), two Lists (24 each)
    // and the external flag (1).
    let mut size = wire_round(137u64 * list.capacity(output))
    for o in output { size += wire_output_charge(o.frame, list.len(o.marks) != 0u64) }
    size
}

fn wire_queue_external(mut work: WireWork, c: WireConfig, take frame: Frame, check: Option[u64]) -> Result[(), std.wsock.Error] {
    if wire_output_size(frame) > c.socket.max_frame { return Error(Protocol(1009u16)) }
    if list.len(work.output) >= 1u64 + c.q || wire_queued_bytes(work.output) + wire_output_charge(frame, false) > c.budget { return Error(Busy) }
    let item = WireOutput(frame: take frame, marks: list.new(), generations: list.new(), external: true, check: check)
    match list.push(mut work.output, take item) {
        Ok(()) => Ok(()),
        Error((cap, _)) => Error(Allocation(cap)),
    }
}

fn wire_queue(mut output: List[WireOutput], take frame: Frame, take marks: List[WireMark], take generations: List[(u32, u64)]) {
    wire_queue_checked(mut output, take frame, take marks, take generations, None)
}

fn wire_queue_checked(mut output: List[WireOutput], take frame: Frame, take marks: List[WireMark], take generations: List[(u32, u64)], check: Option[u64]) {
    result.unwrap(list.push(mut output, WireOutput(frame: take frame, marks: take marks, generations: take generations, external: false, check: check)))
}

fn wire_refused[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, stream: u32, p: u64, take why: Refusal) -> Result[(), u16] {
    if s.refusals >= 1u64 + s.config.q { return Error(1008u16) }
    s.refusals += 1u64
    let mut done: List[Done] = list.new()
    result.unwrap(list.push(mut done, Done(stream: stream, p: p, outcome: Refused(take why))))
    let mut marks: List[WireMark] = list.new()
    result.unwrap(list.push(mut marks, V1))
    let version = s.last
    wire_queue(mut work.output, Batch(version, list.new(), list.new(), take done), take marks, list.new())
    Ok(())
}

fn wire_row[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, key: Bytes, stream: u32, p: u64, version: u64, take outcome: Outcome) {
    let mut done: List[Done] = list.new()
    result.unwrap(list.push(mut done, Done(stream: stream, p: p, outcome: take outcome)))
    let mut marks: List[WireMark] = list.new()
    result.unwrap(list.push(mut marks, Unit(result.unwrap(clone(key)))))
    wire_queue(mut work.output, Batch(version, list.new(), list.new(), take done), take marks, list.new())
}

fn wire_reset[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], version: u64) -> Result[(), u16] {
    if s.reset_seen { return Error(1008u16) }
    s.reset_seen = true
    wire_reset_rows(mut s, mut output, version, list.new(), list.new())
}

fn wire_reset_rows[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], version: u64, take latest_done: List[Done], take latest_marks: List[WireMark]) -> Result[(), u16] {
    let mut done: List[Done] = list.new()
    let mut marks: List[WireMark] = list.new()
    let all = replace(mut output, list.new())
    for take o in take all {
        if o.external {
            result.unwrap(list.push(mut output, take o))
            continue
        }
        let WireOutput(frame: take f, marks: take held, generations: _, external: _, check: _) = take o
        for take m in take held { result.unwrap(list.push(mut marks, take m)) }
        match take f {
            Batch(_, _, _, take ds) => for take d in take ds { result.unwrap(list.push(mut done, take d)) },
            Reset(_, take ds) => for take d in take ds { result.unwrap(list.push(mut done, take d)) },
            _ => {},
        }
    }
    for take d in latest_done { result.unwrap(list.push(mut done, take d)) }
    for take m in latest_marks { result.unwrap(list.push(mut marks, take m)) }
    let _ = replace(mut s.subs, list.new())
    let _ = replace(mut s.pub_subs, list.new())
    wire_leave(mut s)
    s.joined = None
    let _ = replace(mut s.joining, None)
    let _ = replace(mut s.subscription, None)
    wire_queue(mut output, Reset(version, take done), take marks, list.new())
    Ok(())
}

fn wire_drop_stale(mut generations: List[(u32, u64)], active: List[(u32, u64)]) -> bool {
    let mut index = list.len(generations)
    let mut changed = false
    while index != 0u64 {
        index -= 1u64
        let (sub, generation) = generations[index]
        if sub_generation(active, sub) != Some(generation) {
            let _ = list.remove(mut generations, index)
            changed = true
        }
    }
    changed
}

fn wire_current_output(active: List[(u32, u64)], take output: WireOutput) -> Option[WireOutput] {
    if output.external { return Some(take output) }
    let WireOutput(frame: take f, marks: take marks, generations: take stamps, external: external, check: check) = take output
    let mut generations = take stamps
    if let Ended(sub, _) = f {
        // A terminal frame has no active subscription unless the id was reused.
        if let Some(generation) = sub_generation(active, sub) {
            if sub_generation(generations, sub) != Some(generation) { return None }
        }
    } else {
        if wire_drop_stale(mut generations, active) {
            if let Batch(version, take complete, take rows, take done) = take f {
                let mut live_complete = take complete
                let mut kept = 0u64
                for index in 0u64 .. list.len(live_complete) {
                    if let Some(_) = sub_generation(generations, live_complete[index]) {
                        list.swap(mut live_complete, kept, index)
                        kept += 1u64
                    }
                }
                while list.len(live_complete) > kept { let _ = list.pop(mut live_complete) }
                let mut live_rows = take rows
                kept = 0u64
                for index in 0u64 .. list.len(live_rows) {
                    if let Some(_) = sub_generation(generations, live_rows[index].sub) {
                        list.swap(mut live_rows, kept, index)
                        kept += 1u64
                    }
                }
                while list.len(live_rows) > kept { let _ = list.pop(mut live_rows) }
                if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 && list.len(done) == 0u64 { return None }
                // Content left out of a unit is gone from it; what stays keeps the unit's version.
                let kept_check: Option[u64] = if list.len(live_complete) == 0u64 && list.len(live_rows) == 0u64 { None } else { check }
                return Some(WireOutput(frame: Batch(version, take live_complete, take live_rows, take done), marks: take marks, generations: take generations, external: external, check: kept_check))
            }
            return None
        }
    }
    Some(WireOutput(frame: take f, marks: take marks, generations: take generations, external: external, check: check))
}

fn wire_prune_output[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], retired: Option[u32]) {
    let mut kept = 0u64
    for index in 0u64 .. list.len(output) {
        let empty = WireOutput(frame: Reset(0u64, list.new()), marks: list.new(), generations: list.new(), external: false, check: None)
        let queued = list.set(mut output, index, take empty)
        if !queued.external { if let Ended(sub, _) = queued.frame { if retired == Some(sub) { continue } } }
        if let Some(take current) = wire_current_output(s.subs, take queued) {
            let _ = list.set(mut output, kept, take current)
            kept += 1u64
        }
    }
    while list.len(output) > kept { let _ = list.pop(mut output) }
}

// A content unit's Outcome rows are copied before it is handed out, so a Dropped Reset can
// carry them (§3); a copy that cannot be made closes the session (1013) rather than send the
// unit unchecked or lose the rows.
fn wire_take_output[G: send, H: send](s: WireSession[G, H], mut work: WireWork) -> Result[Option[Frame], u16] {
    let selected = loop {
        if list.len(work.output) == 0u64 { return Ok(None) }
        let next = list.remove(mut work.output, 0u64)
        if let Some(take current) = wire_current_output(s.subs, take next) { break take current }
    }
    let WireOutput(frame: take f, marks: take marks, generations: _, external: _, check: check) = take selected
    work.sending = take marks
    work.check = check
    work.sending_done = list.new()
    if let Some(_) = check {
        if let Batch(_, _, _, done) = f {
            if list.len(done) != 0u64 {
                let copied: Result[List[Done], Capacity] = clone(done)
                match take copied { Ok(take rows) => { work.sending_done = take rows }, Error(_) => return Error(1013u16) }
            }
        }
    }
    Ok(Some(take f))
}

// v2.19 (§3): the writer dropped the content unit it was handed. Every content component
// the owner holds goes; every Outcome row, the dropped unit's included, rides in one Reset
// that never counts toward the protocol-error close.
fn wire_dropped[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork) -> Result[(), u16] {
    let marks = replace(mut work.sending, list.new())
    let done = replace(mut work.sending_done, list.new())
    work.check = None
    let version = s.last
    wire_reset_rows(mut s, mut work.output, version, take done, take marks)
}

fn wire_sent[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork) {
    work.check = None
    work.sending_done = list.new()
    let marks = replace(mut work.sending, list.new())
    for take mark in take marks {
        match take mark {
            V1 => { s.refusals -= 1u64 },
            Unit(take key) => if let Some(take found) = map.remove(mut s.held, key) {
                let mut h = take found
                h.queued -= 1u64
                if h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64 { result.unwrap(map.insert(mut s.held, take key, take h)) }
            },
        }
    }
}

fn wire_begin_policy[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take request: WireAsk) -> Result[(), u16] {
    let to = match s.me { Some(to) => channel.sender(to), None => return Error(1008u16) }
    let job = WirePolicy(policy: ingress.share(s.policy), source: s.source, request: take request, to: take to)
    match task.spawn(s.tasks, bytes 8192u64, take job, wire_policy) {
        Ok(take h) => { work.asking = Some(take h); s.asking = true; Ok(()) },
        Error(_) => Error(1013u16),
    }
}

pub type ServicePlan: send = NoAction | PlanRefusal(u32, u64, Refusal) | PlannedCall(Send, Admitted, u32, Bytes, Option[Outcome]) | PlannedUpdate(List[WireOutput], List[u64]) | PlannedSubscribe(u32, SubscriptionInput) | SubscriptionRefusal(u32, Outcome) | ResumeReset

fn wire_plan_call[G: send, H: send](s: WireSession[G, H], take pending: WirePending, allowed: bool) -> Result[ServicePlan, u16] {
    let WirePending(stream: stream, p: p, slot: slot, deadline: deadline_ms, arg: take arg, at: at, grows: _) = take pending
    if !allowed { return Ok(PlanRefusal(stream, p, Overloaded)) }
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { return Ok(PlanRefusal(stream, p, NoEntry)) }
    let caller: Caller = match s.caller {
        Some(a) => {
            let copied: Result[Caller, Capacity] = clone(a)
            match take copied { Ok(take item) => take item, Error(_) => return Ok(PlanRefusal(stream, p, Overloaded)) }
        },
        _ => return Error(1008u16),
    }
    let mut entries: List[Bytes] = list.new()
    let copied_key: Result[Bytes, Capacity] = clone(s.entries[index])
    let key = match take copied_key { Ok(take item) => take item, Error(_) => return Ok(PlanRefusal(stream, p, Overloaded)) }
    let copied_entry: Result[Bytes, Capacity] = clone(key)
    let key_copy = match take copied_entry { Ok(take item) => take item, Error(_) => return Ok(PlanRefusal(stream, p, Overloaded)) }
    if let Error(_) = list.push(mut entries, take key_copy) { return Ok(PlanRefusal(stream, p, Overloaded)) }
    let context = admitted(take caller, take entries, at, host.mono_ns(s.clock), s.config.budget, s.config.socket.max_frame)
    let want = CallWant(key: take key, stream: stream, p: p, arg: take arg, deadline_ms: deadline_ms)
    match prepare(s.registry, context, take want) {
        Ok(take sent) => {
            let reply_room: Result[Bytes, Capacity] = list.with_capacity(DONE_MAX)
            let backing = match take reply_room { Ok(take held) => take held, Error(_) => return Ok(PlanRefusal(stream, p, Overloaded)) }
            let computed: Option[Outcome] = match map.get(s.registry.slots, sent.key) {
                Some(Compute(_)) => Some(call(s.registry, sent.key, sent.arg)),
                _ => None,
            }
            Ok(PlannedCall(take sent, take context, stream, take backing, take computed))
        },
        Error(take why) => Ok(PlanRefusal(stream, p, take why)),
    }
}

fn wire_apply_plan[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take plan: ServicePlan) -> Result[(), u16] {
    let (take sent, take context, stream, take reply, take computed) = match take plan {
        NoAction => return Ok(()),
        PlanRefusal(stream, p, take why) => return wire_refused(mut s, mut work, stream, p, take why),
        PlannedUpdate(take output, take completed) => {
            work.output = take output
            for id in completed { let _ = map.remove(mut work.timers, id) }
            return Ok(())
        },
        PlannedSubscribe(sub, take input) => return wire_apply_subscribe(mut s, mut work, sub, take input),
        SubscriptionRefusal(sub, take why) => { wire_end(mut s, mut work.output, sub, take why); return Ok(()) },
        ResumeReset => {
            let version = s.last
            return wire_reset_rows(mut s, mut work.output, version, list.new(), list.new())
        },
        PlannedCall(take prepared, take caller_context, stream, take reply, take computed) =>
            (take prepared, take caller_context, stream, take reply, take computed),
    }
    let p = sent.p
    let k = slot_key(sent.stream, p)
    let (forwarded, same, queued) = match map.get(s.held, k) { Some(h) => (h.forwarded, h.digest == sent.digest, h.queued), _ => (false, true, 0u64) }
    if forwarded && !same { return Error(1008u16) }
    if wire_admission_closed(work, s.clock) && !forwarded { return wire_refused(mut s, mut work, stream, p, Overloaded) }
    let durable = match map.get(s.registry.slots, sent.key) { Some(Transact(_, _, _, _, _)) => true, None => true, _ => false }
    if !durable {
        let is_compute = match map.get(s.registry.slots, sent.key) { Some(Compute(_)) => true, _ => false }
        if !is_compute { return wire_refused(mut s, mut work, stream, p, NotAllowed) }
        let outcome = match take computed {
            Some(take result) => take result,
            None => return wire_refused(mut s, mut work, stream, p, NotAllowed),
        }
        if wire_cut(work, s.clock) { work.abandoned += 1u64; return Ok(()) }
        let held = WireHeld(stream: stream, p: p, digest: sent.digest, forwarded: false, queued: queued + 1u64, owed: list.new())
        result.unwrap(map.insert(mut s.held, result.unwrap(clone(k)), take held))
        let version = s.last
        wire_row(mut s, mut work, k, stream, p, version, take outcome)
        return Ok(())
    }
    if let None = work.head {
        match head_lease(copy_wire_head(s.head)) {
            Ok(take lease) => { work.head = Some(take lease) },
            Error(_) => return wire_refused(mut s, mut work, stream, p, Overloaded),
        }
    }
    let seed = if !forwarded {
        let made = match work.head { Some(lease) => owner_seed(lease), None => fail("runner: missing head lease") }
        match take made { Ok(take x) => take x, Error(_) => return wire_refused(mut s, mut work, stream, p, Overloaded) }
    } else {
        None
    }
    s.generation += 1u64
    let to = match s.me { Some(to) => channel.sender(to), None => return Error(1008u16) }
    let until = match work.deadline { Some(cut) => if cut < sent.deadline { cut } else { sent.deadline }, None => sent.deadline }
    let timing = WireDeadline(clock: s.clock, at: until, to: take to, stream: result.unwrap(clone(sent.stream)), p: p, generation: s.generation)
    let h = match task.spawn(s.tasks, bytes 4096u64, take timing, wire_deadline) { Ok(take h) => take h, Error(_) => return wire_refused(mut s, mut work, stream, p, Overloaded) }
    if let Error(_) = map.reserve(mut work.timers, 1u64) { return wire_refused(mut s, mut work, stream, p, Overloaded) }
    if let Error(_) = map.reserve(mut s.held, 1u64) { return wire_refused(mut s, mut work, stream, p, Overloaded) }
    let owed = WireOwed(generation: s.generation, reply: take reply)
    if forwarded {
        let mut held = option.unwrap(map.remove(mut s.held, k))
        result.unwrap(list.push(mut held.owed, take owed))
        result.unwrap(map.insert(mut s.held, take k, take held))
    } else {
        let Send(key: take entry, stream: take named, p: position, arg: take argument, digest: digest, deadline: _, budget: _) = take sent
        let (live, identity) = match work.head {
            Some(lease) => (latest.handle(lease.live), latest.handle(lease.identity)),
            None => fail("runner: missing head lease"),
        }
        let Admitted(caller: take principal, ..) = take context
        let request = Request(caller: take principal, stream: take named, p: position, key: take entry, arg: take argument, digest: digest, reply_to: wire_me(s), live: take live, identity: take identity, seed: take seed)
        let mut sends: List[WireOwed] = list.new()
        if let Error(_) = list.push(mut sends, take owed) { return wire_refused(mut s, mut work, stream, p, Overloaded) }
        match try_head(s.head, Req(e: Requested(take request))) {
            Posted => (),
            InboxFull => return wire_refused(mut s, mut work, stream, p, Overloaded),
            InboxClosed => return Error(1011u16),
        }
        result.unwrap(map.insert(mut s.held, take k, WireHeld(stream: stream, p: p, digest: digest, forwarded: true, queued: queued, owed: take sends)))
    }
    result.unwrap(map.insert(mut work.timers, s.generation, take h))
    Ok(())
}

// An Ended the owner makes itself passes unchecked; a publisher-made one is content (§3).
fn wire_end[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32, take outcome: Outcome) {
    wire_end_checked(mut s, mut output, sub, take outcome, None)
}

fn wire_end_checked[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32, take outcome: Outcome, check: Option[u64]) {
    let mut generations: List[(u32, u64)] = list.new()
    if let Some(generation) = sub_generation(s.subs, sub) { stamp_rows(mut generations, sub, generation) }
    wire_stop_sub(mut s, mut output, sub)
    wire_queue_checked(mut output, Ended(sub, take outcome), list.new(), take generations, check)
}

fn wire_subscribed[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, sub: u32, take input: SubscriptionInput) {
    let who = option.unwrap(s.joined)
    let to_pub = wire_publisher(s)
    s.sub_generation += 1u64
    let generation = s.sub_generation
    let mut index = 0u64
    while index < list.len(s.subs) && s.subs[index].0 != sub { index += 1u64 }
    if index == list.len(s.subs) {
        if let Error(_) = list.reserve(mut s.subs, 1u64) {
            wire_end(mut s, mut work.output, sub, Refused(Overloaded))
            return
        }
    }
    let registered = list.contains(s.pub_subs, sub)
    if !registered {
        if let Error(_) = list.reserve(mut s.pub_subs, 1u64) {
            wire_end(mut s, mut work.output, sub, Refused(Overloaded))
            return
        }
    }
    if registered && s.holding {
        // v2.19.2: this Subscribed removes the publisher's live instance, so it waits for the writer.
        let mut at = 0u64
        while at < list.len(s.resubs) && s.resubs[at].sub != sub { at += 1u64 }
        let held = WireResub(sub: sub, generation: generation, input: take input)
        if at == list.len(s.resubs) {
            if let Error(_) = list.reserve(mut s.resubs, 1u64) {
                wire_end(mut s, mut work.output, sub, Refused(Overloaded))
                return
            }
            result.unwrap(list.push(mut s.resubs, take held))
        } else {
            let _ = list.set(mut s.resubs, at, take held)
        }
    } else {
        let sent = channel.try_send(to_pub, PubIn(e: WireSubscribed(who, sub, generation, take input)))
        if let Error(_) = take sent { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return }
    }
    if index == list.len(s.subs) {
        result.unwrap(list.push(mut s.subs, (sub, generation)))
    } else {
        s.subs[index] = (sub, generation)
    }
    if !registered { result.unwrap(list.push(mut s.pub_subs, sub)) }
}

fn wire_plan_subscribe[G: send, H: send](mut s: WireSession[G, H], sub: u32, slot: u32, take arg: Bytes, take resume: Option[Bytes]) -> Result[ServicePlan, u16] {
    if s.phase != 3u8 { return Error(1008u16) }
    if let Some(_) = resume { return Ok(ResumeReset) }
    let index: u64 = int.widen(slot)
    if index >= list.len(s.entries) { return Ok(SubscriptionRefusal(sub, Refused(NoEntry))) }
    let cloned: Result[Bytes, Capacity] = clone(s.entries[index])
    let key = match take cloned { Ok(take held_key) => take held_key, Error(_) => return Ok(SubscriptionRefusal(sub, Refused(Overloaded))) }
    if !map.contains(s.registry.slots, key) {
        let outcome: Outcome = if map.contains(s.registry.gone, key) { Failed(Gone) } else { Refused(NoEntry) }
        return Ok(SubscriptionRefusal(sub, take outcome))
    }
    let is_query = match map.get(s.registry.slots, key) { Some(Query(_, _, _)) => true, _ => false }
    if !is_query { return Ok(SubscriptionRefusal(sub, Refused(NoEntry))) }
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if !registered && list.len(s.pub_subs) >= s.config.max_subs { return Ok(SubscriptionRefusal(sub, Refused(NotAllowed))) }
    let refused = match map.get(s.registry.checks, key) { Some(check) => check(arg), _ => { let no_refusal: Option[Refusal] = None; no_refusal } }
    if let Some(take why) = take refused { return Ok(SubscriptionRefusal(sub, Refused(take why))) }
    if let None = s.subscription_room {
        let limit = int.saturating_sub(WIRE_SESSION_CEILING, wire_variable_peak(s.config))
        match subscription_room(limit, s.config.max_subs) {
            Ok(take quota) => { s.subscription_room = Some(take quota) },
            Error(_) => return Ok(SubscriptionRefusal(sub, Refused(Overloaded))),
        }
    }
    let mut quota = option.unwrap(replace(mut s.subscription_room, None))
    let held = subscription_hold(mut quota, take key, take arg)
    s.subscription_room = Some(take quota)
    match take held {
        Ok(take input) => Ok(PlannedSubscribe(sub, take input)),
        Error(_) => Ok(SubscriptionRefusal(sub, Refused(Overloaded))),
    }
}

fn wire_apply_subscribe[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, sub: u32, take input: SubscriptionInput) -> Result[(), u16] {
    if wire_admission_closed(work, s.clock) {
        wire_end(mut s, mut work.output, sub, Refused(Overloaded))
        return Ok(())
    }
    if let Some(_) = s.joined { wire_subscribed(mut s, mut work, sub, take input); return Ok(()) }
    let made: Result[(Sender[Admit], Receiver[Admit]), Capacity] = channel.new(1u64)
    let (told, hear) = match take made { Ok(take pair) => take pair, Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) } }
    // v2.19: the session's fence root, at {0, 0}; the publisher gets a handle in the Join.
    let fence_root: Result[Latest[Fence], Capacity] = match arc.new(Fence(prior: 0u64, latest: 0u64)) {
        Ok(take first) => result.capacity_only(latest.new(take first)),
        Error((cap, _)) => Error(cap),
    }
    let fence = match take fence_root { Ok(take root) => take root, Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) } }
    let close_channel: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
    let (closing, closed) = match take close_channel { Ok(take pair) => take pair, Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) } }
    let progress_channel: Result[(Sender[()], Receiver[()]), Capacity] = channel.new(1u64)
    let (token, progress) = match take progress_channel { Ok(take pair) => take pair, Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) } }
    if let None = work.head {
        match head_lease(copy_wire_head(s.head)) {
            Ok(take h) => { work.head = Some(take h) },
            Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) },
        }
    }
    let identity = match work.head { Some(h) => latest.handle(h.identity), None => fail("runner: missing head lease") }
    let join = if s.marked {
        s.mark = Some(take closing)
        Join(to: wire_me(s), told: take told, mark: Some(take closed), closed: None, identity: Some(take identity), fence: Some(latest.handle(fence)), progress: Some(take progress))
    } else {
        if let Error(_) = list.reserve(mut s.leaving, 1u64) { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) }
        let lease = match WireJoinLease(closing: take closing, publisher: wire_publisher(s)) { Ok(take l) => take l, Error(_) => { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) } }
        s.join_lease = Some(take lease)
        Join(to: wire_me(s), told: take told, mark: None, closed: Some(take closed), identity: Some(take identity), fence: Some(latest.handle(fence)), progress: Some(take progress))
    }
    if let Error(_) = channel.try_send(wire_publisher(s), PubIn(e: Joined(take join))) { wire_end(mut s, mut work.output, sub, Refused(Overloaded)); return Ok(()) }
    work.fence = Some(take fence)
    s.progress = Some(take token)
    // A fresh join can wait for its id while an old terminal frame is queued.
    wire_prune_output(mut s, mut work.output, Some(sub))
    s.joining = Some(take hear)
    s.subscription = Some((sub, take input))
    Ok(())
}

fn wire_update[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take upd: Update) -> Result[(), u16] {
    let mut completed: List[u64] = list.new()
    let result = wire_stage_update(mut s, mut work.output, mut completed, work.drain, take upd)
    for id in completed { let _ = map.remove(mut work.timers, id) }
    result
}

fn wire_stage_update[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], mut completed: List[u64], drain: Option[Latest[Option[DrainWindow]]], take upd: Update) -> Result[(), u16] {
    let Update(version: at, content: take content, outcomes: take answers) = take upd
    let mut done: List[Done] = list.new()
    let mut marks: List[WireMark] = list.new()
    for answer in answers {
        wire_answer(mut s, mut completed, drain, answer, mut done, mut marks)?
    }
    let current = match content {
        Some(o) => match s.joined { Some(who) => who == o.session, _ => false },
        None => false,
    }
    if !current && list.len(done) == 0u64 { return Ok(()) }
    s.last = if at > s.last { at } else { s.last }
    let version = s.last
    let mut live_rows: List[Row] = list.new()
    let mut live_complete: List[u32] = list.new()
    let mut ended: List[(u32, u64, Outcome)] = list.new()
    let mut generations: List[(u32, u64)] = list.new()
    let mut computed = 0u64
    if current {
        let Owe(session: _, version: content_version, generations: take stamps, complete: take complete, rows: take rows, ended: take stopped, reset: reset) = option.unwrap(take content)
        computed = content_version
        if reset {
            if s.reset_seen { return Error(1008u16) }
            s.reset_seen = true
            return wire_reset_rows(mut s, mut output, version, take done, take marks)
        }
        generations = take stamps
        let _ = wire_drop_stale(mut generations, s.subs)
        for take row in rows {
            if let Some(_) = sub_generation(generations, row.sub) { result.unwrap(list.push(mut live_rows, take row)) }
        }
        for sub in complete {
            if let Some(_) = sub_generation(generations, sub) { result.unwrap(list.push(mut live_complete, sub)) }
        }
        ended = take stopped
    }
    let reserve = wire_outcome_reserve(s.config)
    let envelope = 24u64 + 4u64 * list.len(live_complete)
    let allowance = int.saturating_sub(s.config.socket.max_frame, reserve + envelope)
    let requested = wire_rows_size(live_rows)
    if requested > allowance {
        if list.len(live_complete) == 0u64 {
            if s.reset_seen { return Error(1008u16) }
            s.reset_seen = true
            return wire_reset_rows(mut s, mut output, version, take done, take marks)
        }
        for sub in live_complete { wire_end(mut s, mut output, sub, Refused(Budget(Room(requested: requested, available: allowance)))) }
        live_complete = list.new()
        live_rows = list.new()
        generations = list.new()
    }
    if list.len(live_rows) != 0u64 || list.len(live_complete) != 0u64 || list.len(done) != 0u64 {
        let charge = wire_batch_charge(live_complete, live_rows, done, list.len(marks) != 0u64)
        if wire_queued_bytes(output) + charge > s.config.budget {
            wire_prune_output(mut s, mut output, None)
            if wire_queued_bytes(output) + charge > s.config.budget {
                if s.reset_seen { return Error(1008u16) }
                s.reset_seen = true
                return wire_reset_rows(mut s, mut output, version, take done, take marks)
            }
        }
        let check = if list.len(live_rows) != 0u64 || list.len(live_complete) != 0u64 { Some(computed) } else { None }
        let frame: Frame = Batch(version, take live_complete, take live_rows, take done)
        wire_queue_checked(mut output, take frame, take marks, take generations, check)
    }
    for take e in ended {
        let (sub, generation, take why) = take e
        if sub_generation(s.subs, sub) == Some(generation) {
            wire_forget_sub(mut s, sub)
            wire_end_checked(mut s, mut output, sub, take why, Some(computed))
        }
    }
    Ok(())
}

fn wire_answer[G: send, H: send](mut s: WireSession[G, H], mut completed: List[u64], drain: Option[Latest[Option[DrainWindow]]], told: KeyedDone, mut done: List[Done], mut marks: List[WireMark]) -> Result[(), u16] {
    if wire_cut_at(drain, s.clock) { return Ok(()) }
    // A pre-W3c stored reply can exceed today's producer bound. Preserve its
    // bytes in the store and fail delivery explicitly before retaining its row.
    if let Returned(b) = told.outcome { if list.len(b) > MAX_RETURNED_BYTES { return Error(1009u16) } }
    let key = slot_key(told.stream, told.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        h.forwarded = false
        let owed = replace(mut h.owed, list.new())
        let count = list.len(owed)
        h.queued += count
        for take owing in owed {
            let WireOwed(generation: generation, reply: take backing) = take owing
            if let Error(_) = list.push(mut completed, generation) { return Error(1013u16) }
            let outcome: Outcome = match told.outcome {
                Returned(payload) => {
                    let mut reply = take backing
                    if let Error(_) = list.append(mut reply, payload) { return Error(1013u16) }
                    let updated: Outcome = Returned(take reply)
                    take updated
                },
                _ => result.unwrap(clone(told.outcome)),
            }
            result.unwrap(list.push(mut done, Done(stream: h.stream, p: h.p, outcome: take outcome)))
            result.unwrap(list.push(mut marks, Unit(result.unwrap(clone(key)))))
        }
        if h.queued != 0u64 { result.unwrap(map.insert(mut s.held, take key, take h)) }
    }
    Ok(())
}

fn wire_expired[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, tick: Tick) {
    let _ = map.remove(mut work.timers, tick.generation)
    let version = s.last
    let key = slot_key(tick.stream, tick.p)
    if let Some(take found) = map.remove(mut s.held, key) {
        let mut h = take found
        let mut index = 0u64
        let mut hit = false
        while index < list.len(h.owed) && !hit {
            if h.owed[index].generation == tick.generation { hit = true } else { index += 1u64 }
        }
        if hit {
            let _ = list.remove(mut h.owed, index)
            h.queued += 1u64
            wire_row(mut s, mut work, key, h.stream, h.p, version, Abandoned)
        }
        result.unwrap(map.insert(mut s.held, take key, take h))
    }
}

fn wire_service_allocate[G: send, H: send](mut s: WireSession[G, H], take allocation: ServiceAllocation) -> Result[ServicePlan, u16] {
    match take allocation {
        BindPrincipal(take principal) => { wire_authenticate(mut s, take principal)?; Ok(NoAction) },
        ValidateCall(allowed) => {
            s.asking = false
            match replace(mut s.pending, None) {
                Some(take pending) => wire_plan_call(s, take pending, allowed),
                None => Ok(NoAction),
            }
        },
        ValidateSubscribe(sub, slot, take arg, take resume) => wire_plan_subscribe(mut s, sub, slot, take arg, take resume),
        DeliverUpdate(take delivery) => {
            let DeliveryJob(update: take published, output: take previous, drain: take drain) = take delivery
            let mut output = take previous
            let mut completed: List[u64] = list.new()
            wire_stage_update(mut s, mut output, mut completed, drain, take published)?
            Ok(PlannedUpdate(take output, take completed))
        },
    }
}

fn wire_authenticate[G: send, H: send](mut s: WireSession[G, H], take principal: Option[ingress.Principal]) -> Result[(), u16] {
    s.asking = false
    let (take caller, take token) = match take principal {
        Some(take p) => ingress.welcome(take p),
        None => return Error(1013u16),
    }
    s.caller = Some(take caller)
    s.welcome_token = Some(take token)
    if let Some(place) = s.place {
        s.registry = match placed(place, s.config.n_place) { Ok(take r) => take r, Error(_) => return Error(1013u16) }
    }
    let wanted = replace(mut s.wants, list.new())
    for take want in take wanted {
        let key = match wire_key(want) { Ok(take key) => take key, Error(_) => return Error(1013u16) }
        if let Error(_) = list.push(mut s.entries, take key) { return Error(1013u16) }
    }
    s.phase = 2u8
    Ok(())
}

fn wire_step[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork, take input: ServiceInput) -> Result[Option[Frame], u16] {
    s.holding = match work.check { Some(_) => true, None => false }
    match take input {
        WAttach(source, take me, take pub_to) => {
            s.source = source; s.me = Some(take me); s.publisher = Some(take pub_to)
        },
        WClient(take frame, at) => match take frame {
            Hello(take token, take wanted) => {
                if s.phase != 0u8 { return Error(1008u16) }
                s.phase = 1u8
                s.wants = take wanted
                wire_begin_policy(mut s, mut work, Bind(take token))?
            },
            Call(stream, p, slot, deadline, take arg) => {
                if s.phase != 3u8 { return Error(1008u16) }
                let (take key, take auth): (Bytes, Caller) = match s.caller { Some(caller) => (slot_key(wire_stream(caller, stream), p), result.unwrap(clone(caller))), _ => return Error(1008u16) }
                let grows = match map.get(s.held, key) { Some(h) => !h.forwarded || h.queued != 0u64 || list.len(h.owed) != 0u64, _ => true }
                let held = match map.get(s.held, key) { Some(h) => h.forwarded, _ => false }
                if (wire_admission_closed(work, s.clock) && !held) || (grows && wire_units(s) >= 1u64 + s.config.q) {
                    wire_refused(mut s, mut work, stream, p, Overloaded)?
                } else {
                    s.pending = Some(WirePending(stream: stream, p: p, slot: slot, deadline: deadline, arg: take arg, at: at, grows: grows))
                    wire_begin_policy(mut s, mut work, CheckRate(take auth))?
                }
            },
            Subscribe(sub, slot, take arg, take resume) => {
                if s.phase != 3u8 { return Error(1008u16) }
                if wire_admission_closed(work, s.clock) {
                    wire_end(mut s, mut work.output, sub, Refused(Overloaded))
                } else {
                    let planned = wire_plan_subscribe(mut s, sub, slot, take arg, take resume)?
                    wire_apply_plan(mut s, mut work, take planned)?
                }
            },
            Unsubscribe(sub) => {
                if s.phase != 3u8 { return Error(1008u16) }
                wire_stop_sub(mut s, mut work.output, sub)
            },
            _ => return Error(1007u16),
        },
        WPrepared(take plan) => wire_apply_plan(mut s, mut work, box.unbox(take plan))?,
        WRunner(take e) => {
            let Notice(e: take received) = take e
            match take received {
                Updated(take upd) => wire_update(mut s, mut work, take upd)?,
                Expired(tick) => wire_expired(mut s, mut work, tick),
                _ => {},
            }
        },
        WSent => { wire_sent(mut s, mut work); wire_flush(mut s, mut work); return Ok(None) },
        WDropped => { wire_dropped(mut s, mut work)?; wire_flush(mut s, mut work); return Ok(None) },
        WDrained => {
            // The token goes first, so the wake it rides on finds it (§3 "Repair").
            if let Some(to) = s.progress { let _ = channel.try_send(to, ()) }
            if let Some(_) = work.head { let _ = channel.try_send(wire_publisher(s), PubIn(e: Drained)) }
        },
        WClose(deadline) => { work.deadline = Some(deadline) },
        WForce => {
            work.abandoned += map.len(work.timers)
            let _ = replace(mut s.held, map.new())
            return Ok(None)
        },
        WPoll(writable) => {
            let received: Option[Admit] = match s.joining { Some(hear) => match channel.try_receive(hear) { Ok(take a) => Some(take a), _ => None }, _ => None }
            if let Some(take admit) = received {
                let Admit(who: who, round: take register) = take admit
                let _ = replace(mut s.joining, None)
                if who == 0u64 {
                    // The publisher could not reserve this session's fence Arcs.
                    let _ = replace(mut s.join_lease, None)
                    let _ = replace(mut s.mark, None)
                    work.fence = None
                    if let Some((sub, _)) = replace(mut s.subscription, None) { wire_end(mut s, mut work.output, sub, Refused(Overloaded)) }
                } else {
                    s.joined = Some(who)
                    work.round = Some(take register)
                    if let Some((sub, take ready_sub)) = replace(mut s.subscription, None) { wire_subscribed(mut s, mut work, sub, take ready_sub) }
                }
            }
            if !writable { return Ok(None) }
            if s.phase == 4u8 { s.phase = 3u8 }
            if s.phase == 2u8 {
                if s.placing == 0u64 {
                    s.placing += 1u64
                    if list.len(s.entries) == 0u64 { s.phase = 4u8 }
                    let token = option.unwrap(replace(mut s.welcome_token, None))
                    let q: u32 = int.narrow(s.config.q)
                    return Ok(Some(Welcome(take token, q, s.config.budget, result.unwrap(launch_digest()), result.unwrap(clone(s.target)), launch_word(0u64, 0u64))))
                }
                let index = s.placing - 1u64
                let slot: u32 = int.narrow(index)
                let answer: Entry = if map.contains(s.registry.slots, s.entries[index]) { Ready(slot) } else { Gone }
                s.placing += 1u64
                if index + 1u64 == list.len(s.entries) { s.phase = 4u8 }
                return Ok(Some(Placed(take answer)))
            }
            return wire_take_output(s, mut work)
        },
    }
    let version = s.last
    if wire_queued_bytes(work.output) > s.config.budget {
        wire_prune_output(mut s, mut work.output, None)
        if wire_queued_bytes(work.output) > s.config.budget { wire_reset(mut s, mut work.output, version)? }
    }
    Ok(None)
}


fn wire_me[G: send, H: send](s: WireSession[G, H]) -> Sender[WireEvent] {
    match s.me { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}

fn wire_publisher[G: send, H: send](s: WireSession[G, H]) -> Sender[PubIn] {
    match s.publisher { Some(to) => channel.sender(to), _ => fail("runner: detached wire service") }
}


fn wire_hello_alarm(take a: WireAlarm) -> () waits {
    host.sleep_until(a.clock, a.at)
    let _ = channel.send(a.to, wire_event(HelloExpired))
}

fn wire_finish[G: send, H: send](mut s: WireSession[G, H]) -> Option[PubIn] {
    s.mark = None
    if s.marked { Some(PubIn(e: Drained)) }
    else { match s.joined { Some(who) => Some(PubIn(e: Left(who))), _ => None } }
}

// Production sessions build place inside the owner, after source admission.
pub fn wire_place_service[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], access_gate: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, a: Args) -> Service[WireSession[G, H]] {
    wire_place_target(place, access_gate, head, clock, tasks, config, result.unwrap(launch_target(a)))
}

// Embedded hosts and socket fixtures supply their launch target directly.
pub fn wire_place_target[G: send, H: send](place: StaticFn[fn(mut Registry[G, H]) -> Result[(), RegisterError]], access_gate: ingress.Ingress, head: Sender[Req], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G, H]] {
    let initial: Registry[G, H] = registry()
    let mut service = wire_service_with_head(take initial, access_gate, LegacyHead(channel.sender(head)), clock, tasks, config, take target)
    service.context.place = Some(place)
    take service
}

resource type WireJoinLease: send { closing: Sender[()], publisher: Sender[PubIn] } drop(lease) {
    let _ = channel.try_send(lease.closing, ())
    let _ = channel.try_send(lease.publisher, PubIn(e: Drained))
}

fn wire_remove_sub[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.subs) { if s.subs[i].0 == sub { let _ = list.remove(mut s.subs, i) } else { i += 1u64 } }
    wire_prune_output(mut s, mut output, Some(sub))
}


fn wire_forget_sub[G: send, H: send](mut s: WireSession[G, H], sub: u32) {
    let mut i = 0u64
    while i < list.len(s.pub_subs) { if s.pub_subs[i] == sub { let _ = list.remove(mut s.pub_subs, i) } else { i += 1u64 } }
}

fn wire_stop_sub[G: send, H: send](mut s: WireSession[G, H], mut output: List[WireOutput], sub: u32) {
    wire_remove_sub(mut s, mut output, sub)
    let mut at = 0u64
    while at < list.len(s.resubs) {
        if s.resubs[at].sub == sub { let _ = list.remove(mut s.resubs, at) } else { at += 1u64 }
    }
    if list.len(s.subs) == 0u64 {
        wire_leave(mut s)
        let _ = replace(mut s.joining, None)
        let _ = replace(mut s.subscription, None)
        s.joined = None
        let _ = replace(mut s.pub_subs, list.new())
        return
    }
    if !s.holding { wire_unsubscribe(mut s, sub) }
}

fn wire_unsubscribe[G: send, H: send](mut s: WireSession[G, H], sub: u32) {
    let mut registered = false
    for id in s.pub_subs { if id == sub { registered = true } }
    if registered {
        if let Some(who) = s.joined {
            if let Ok(()) = channel.try_send(wire_publisher(s), PubIn(e: Unsubscribed(who, sub))) { wire_forget_sub(mut s, sub) }
        }
    }
}

// v2.19.2 (§3 "The owner asks for removal"): the session leaves by dropping its join lease,
// which tells the publisher to forget it. While the writer holds a content unit the lease
// is parked, so the publisher keeps fencing the read sets that unit was computed from. The
// join that made the lease reserved its parking slot, so parking allocates nothing.
fn wire_leave[G: send, H: send](mut s: WireSession[G, H]) {
    while let Some(_) = list.pop(mut s.resubs) {}
    if let Some(take lease) = replace(mut s.join_lease, None) {
        if s.holding { result.unwrap(list.push(mut s.leaving, take lease)) }
    }
}

// The writer holds no content unit: the removals held for it go now, in the order the
// publisher must apply them. A replacing Subscribed goes before the Unsubscribeds, and a
// sub the owner no longer has but the publisher may (pub_subs) owes an Unsubscribed.
fn wire_flush[G: send, H: send](mut s: WireSession[G, H], mut work: WireWork) {
    s.holding = false
    while let Some(_) = list.pop(mut s.leaving) {}
    while list.len(s.resubs) != 0u64 {
        let WireResub(sub: sub, generation: generation, input: take input) = list.remove(mut s.resubs, 0u64)
        let who = option.unwrap(s.joined)
        if let Error(_) = channel.try_send(wire_publisher(s), PubIn(e: WireSubscribed(who, sub, generation, take input))) {
            wire_end(mut s, mut work.output, sub, Refused(Overloaded))
        }
    }
    let mut at = 0u64
    while at < list.len(s.pub_subs) {
        let sub = s.pub_subs[at]
        let before = list.len(s.pub_subs)
        if let None = sub_generation(s.subs, sub) { wire_unsubscribe(mut s, sub) }
        if list.len(s.pub_subs) == before { at += 1u64 }
    }
}


// A second digest at a live position closes before waiting for access_gate. Otherwise
// a head answer could reach the writer while that conflicting send awaits a rate decision.
fn wire_check_live[G: send, H: send](s: WireSession[G, H], f: Frame) -> Option[u16] {
    if let Call(stream, p, slot, _, arg) = f {
        let index: u64 = int.widen(slot)
        if index >= list.len(s.entries) { return None }
        let key = s.entries[index]
        if !map.contains(s.registry.slots, key) && !map.contains(s.registry.gone, key) { return None }
        let named: Bytes = match s.caller { Some(caller) => wire_stream(caller, stream), _ => return None }
        let position = slot_key(named, p)
        let prior: Option[store.RequestDigest] = match map.get(s.held, position) { Some(h) => if h.forwarded { Some(h.digest) } else { None }, _ => None }
        if let Some(digest) = prior {
            if digest != store.request_digest(key, arg) { return Some(1008u16) }
        }
    }
    None
}

// Publisher harness: a joined inbox whose consumer the law can hold still.
// This fixture does not create a session or a second call transport.
pub type FixtureOwner { inbox: Receiver[WireEvent], out: Sender[Down], from: Receiver[Down], post: Sender[PubIn], who: u64, progress: Sender[()] }

pub fn fixture_owner(pub_in: Sender[PubIn]) -> FixtureOwner waits {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = result.unwrap(channel.new(64u64))
    let (progressed, progress): (Sender[()], Receiver[()]) = result.unwrap(channel.new(1u64))
    let who = join_with(pub_in, take to, None, Some(take progress))
    let (out, from): (Sender[Down], Receiver[Down]) = result.unwrap(channel.new(64u64))
    FixtureOwner(inbox: take inbox, out: take out, from: take from, post: channel.sender(pub_in), who: who, progress: take progressed)
}

pub fn fixture_subscribe(owner: FixtureOwner, sub: u32, take key: Bytes, take arg: Bytes) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Subscribed(owner.who, sub, take key, take arg)))
}

pub fn fixture_unsubscribe(owner: FixtureOwner, sub: u32) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Unsubscribed(owner.who, sub)))
}

fn fixture_content(owner: FixtureOwner, take event: WireEvent) -> () waits {
    let Notice(e: take e) = publisher_notice(take event)
    let mut dropped: List[u32] = list.new()
    if let Updated(Update(version: _, content: Some(take o), outcomes: take outcomes)) = take e {
        hand(owner.out, take o, mut dropped, take outcomes)
    }
    let _ = channel.try_send(owner.progress, ())
    let _ = channel.try_send(owner.post, PubIn(e: Drained))
}

pub fn fixture_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    loop {
        if let Ok(take d) = channel.try_receive(owner.from) { return Ok(take d) }
        match channel.receive(owner.inbox) {
            Ok(take e) => fixture_content(owner, take e),
            Error(_) => return Error(Closed),
        }
    }
}

pub fn fixture_try_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    if let Ok(take d) = channel.try_receive(owner.from) { return Ok(take d) }
    match channel.try_receive(owner.inbox) {
        Ok(take e) => { fixture_content(owner, take e); channel.try_receive(owner.from) },
        Error(e) => Error(e),
    }
}

pub fn fixture_close(take owner: FixtureOwner) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Left(owner.who)))
}

fn publisher_notice(take event: WireEvent) -> Notice {
    let WireEvent(e: take input) = take event
    match take input { FromRunner(take notice) => take notice, _ => fail("publisher fixture: non-publisher event") }
}

// The collection map is Memory metadata. The span's single attempt
// crosses those entries and charges the Tiered data reached beneath them.
pub fn tiered_span_row(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], data: pages.PageTree, low: Bytes, high: Bytes) -> Result[Option[(Bytes, Arc[Bytes])], types.Failure] {
    if high <= low {
        return Ok(None)
    }
    let beginning = list.slice(low, 0, order.min(4, list.len(low)))
    let mut collections = std.page.cursor_open(data.root, Some(types.copied(beginning)?), true, false)
    let no_prefix: Bytes = list.new()
    while let Some((take id, _)) = std.page.cursor_next_key(mut collections, no_prefix) {
        if id >= high {
            break
        }
        let collection: u32 = list.word_be(id, 0)
        let collection_end = catalog.prefix(collection + 1)?
        let from = if low <= id {
            view id
        } else {
            view low
        }
        let until = if list.len(high) > 4 && high < collection_end {
            view high
        } else {
            view collection_end
        }
        let (edge, descriptor) = option.unwrap(std.page.collection_slot(data.root, id))
        if let Some(take row) = tiered_span_collection(attempt, visible, data, edge, descriptor, collection, from, until)? {
            return Ok(Some(take row))
        }
    }
    Ok(None)
}

pub fn tiered_span_collection(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], data: pages.PageTree, edge: std.page.Slot, descriptor: Bytes, collection: u32, low: Bytes, high: Bytes) -> Result[Option[(Bytes, Arc[Bytes])], types.Failure] {
    if low >= high {
        return Ok(None)
    }
    if pages.collection_descriptor(descriptor).residency == ResidentMemory {
        let mut cursor = pages.open_page_range(data, Some(types.copied(low)?), true, false, Some(types.copied(high)?))?
        return catalog.next_bytes(mut cursor)
    }
    let (take start, take stop) = tiered_scan_bounds(descriptor, collection, types.copied(low)?, types.copied(high)?)?
    if start >= stop {
        return Ok(None)
    }
    let overlay = match data.replay {
        Some(replay) => std.omap.get(replay.collections, collection),
        None => None,
    }
    tiered_seek(attempt, SeekKey(types.copied(list.slice(start, 4, list.len(start)))?))
    let found = tiered_scan_row(attempt, visible, edge, collection, overlay, start, stop, false)?
    tiered_seek(attempt, SeekOperation)
    Ok(take found)
}

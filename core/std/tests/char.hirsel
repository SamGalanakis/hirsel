// Contract tests for `char` (core/std/char.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names. Lists are read back as numbers, one decimal digit per element.
fn value(o: Option[u32]) -> u32 {
    match o {
        Some(v) => v,
        None => 99,
    }
}

// expect: run utf8_len_ascii() = 1
fn utf8_len_ascii() -> u64 {
    char.utf8_len('a')
}

// U+00E9.
// expect: run utf8_len_two() = 2
fn utf8_len_two() -> u64 {
    char.utf8_len('é')
}

// U+20AC.
// expect: run utf8_len_three() = 3
fn utf8_len_three() -> u64 {
    char.utf8_len('€')
}

// U+1F600.
// expect: run utf8_len_four() = 4
fn utf8_len_four() -> u64 {
    char.utf8_len('😀')
}

// 'Q' is 81.
// expect: run upper_letter() = 81
fn upper_letter() -> u32 {
    char.to_u32(char.to_ascii_upper('q'))
}

// '`' (96) and '{' (123) border a-z and stay; é (233) is not ASCII and stays.
// expect: run upper_borders() = true
fn upper_borders() -> bool {
    char.to_u32(char.to_ascii_upper('`')) == 96 && char.to_u32(char.to_ascii_upper('{')) == 123 && char.to_u32(char.to_ascii_upper('é')) == 233
}

// 'a' is 97.
// expect: run lower_letter() = 97
fn lower_letter() -> u32 {
    char.to_u32(char.to_ascii_lower('A'))
}

// '@' (64) and '[' (91) border A-Z and stay; É (201) is not ASCII and stays.
// expect: run lower_borders() = true
fn lower_borders() -> bool {
    char.to_u32(char.to_ascii_lower('@')) == 64 && char.to_u32(char.to_ascii_lower('[')) == 91 && char.to_u32(char.to_ascii_lower('É')) == 201
}

// The 22 probes, in order: tab, LF, VT, FF, CR, space, / 0 9 : @ A Z [ ` a z {, U+0085,
// U+00A0, U+FF10 (fullwidth zero), é. Each predicate test writes 1 or 0 per probe.
fn probes() -> String {
    "\t\n\u{B}\u{C}\r /09:@AZ[`az{\u{85}\u{A0}\u{FF10}é"
}

fn mark(mut out: String, yes: bool) {
    result.unwrap(string.push(mut out, if yes { "1" } else { "0" }))
}

// Only '0' and '9' (probes 8 and 9).
// expect: run digit_probes() = true
fn digit_probes() -> bool {
    let p = probes()
    let mut out = string.new()
    let mut at: u64 = 0
    while let Some((c, next)) = string.next_scalar(p, at) {
        mark(mut out, char.is_ascii_digit(c))
        at = next
    }
    out == "0000000110000000000000"
}

// Only A, Z, a, z (probes 12, 13, 16, 17).
// expect: run alpha_probes() = true
fn alpha_probes() -> bool {
    let p = probes()
    let mut out = string.new()
    let mut at: u64 = 0
    while let Some((c, next)) = string.next_scalar(p, at) {
        mark(mut out, char.is_ascii_alpha(c))
        at = next
    }
    out == "0000000000011001100000"
}

// Tab, LF, FF, CR, space (probes 1, 2, 4, 5, 6); not VT, U+0085 or U+00A0.
// expect: run whitespace_probes() = true
fn whitespace_probes() -> bool {
    let p = probes()
    let mut out = string.new()
    let mut at: u64 = 0
    while let Some((c, next)) = string.next_scalar(p, at) {
        mark(mut out, char.is_ascii_whitespace(c))
        at = next
    }
    out == "1101110000000000000000"
}

// expect: run digit_hex_lower() = 15
fn digit_hex_lower() -> u32 {
    value(char.digit('f', 16))
}

// expect: run digit_hex_upper() = 15
fn digit_hex_upper() -> u32 {
    value(char.digit('F', 16))
}

// expect: run digit_past_base() = 99
fn digit_past_base() -> u32 {
    value(char.digit('g', 16))
}

// expect: run digit_decimal() = 9
fn digit_decimal() -> u32 {
    value(char.digit('9', 10))
}

// expect: run digit_base_36() = 35
fn digit_base_36() -> u32 {
    value(char.digit('z', 36))
}

// expect: run digit_at_base() = 99
fn digit_at_base() -> u32 {
    value(char.digit('7', 7))
}

// expect: run digit_base_37() = fail Fail
fn digit_base_37() -> u32 {
    value(char.digit('0', 37))
}

// expect: run digit_base_1() = fail Fail
fn digit_base_1() -> u32 {
    value(char.digit('0', 1))
}

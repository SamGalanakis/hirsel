// TS1 laws: T1 codepoints, T2 static QPACK, T3 Huffman.
fn hex(s: Bytes) -> Bytes {
    option.unwrap(std.hex.decode(s))
}

fn field(name: Bytes, value: Bytes) -> qpack.Field {
    let mut n: Bytes = list.new()
    list.append(mut n, name)
    let mut v: Bytes = list.new()
    list.append(mut v, value)
    qpack.Field(name: take n, value: take v)
}

fn same(a: u64, b: u64, take what: String) {
    if a != b {
        fail(take what)
    }
}

/// bug: A WT-1 codepoint, an RFC 9114/9204/9220/9297 registry value or the draft-17 §4.4
/// application-code mapping is mistyped, so a peer reads our settings, capsules or errors
/// as something else.
/// oracle: draft-ietf-webtrans-http3-17 §4.2, §4.3, §4.4 (Figure 4) and §9; RFC 9114 §6.2,
/// §7.2, §8.1, §11.2; RFC 9204 §4.2, §5, §6; RFC 9220 §3; RFC 9297 §2.1.1, §3.2, §5.
/// Values copied by hand from the documents.
@test
fn codepoints_match_draft() -> Result[(), ()] {
    // draft-17 §9.2 HTTP/3 settings.
    same(h3_wire.SETTINGS_WT_ENABLED, 0x20b8933b, "SETTINGS_WT_ENABLED, draft-17 §9.2")
    same(h3_wire.SETTINGS_WT_INITIAL_MAX_STREAMS_UNI, 0x2b64, "SETTINGS_WT_INITIAL_MAX_STREAMS_UNI, §9.2")
    same(h3_wire.SETTINGS_WT_INITIAL_MAX_STREAMS_BIDI, 0x2b65, "SETTINGS_WT_INITIAL_MAX_STREAMS_BIDI, §9.2")
    same(h3_wire.SETTINGS_WT_INITIAL_MAX_DATA, 0x2b61, "SETTINGS_WT_INITIAL_MAX_DATA, §9.2")
    // draft-17 §9.3 signal value and §9.4 stream type.
    same(h3_wire.SIGNAL_WT_BIDI, 0x41, "WT_STREAM signal, draft-17 §4.3")
    same(h3_wire.STREAM_WT, 0x54, "WT_STREAM uni type, draft-17 §4.2")
    // draft-17 §9.5 error codes.
    same(h3_wire.WT_BUFFERED_STREAM_REJECTED, 0x3994bd84, "WT_BUFFERED_STREAM_REJECTED, §9.5")
    same(h3_wire.WT_SESSION_GONE, 0x170d7b68, "WT_SESSION_GONE, §9.5")
    same(h3_wire.WT_FLOW_CONTROL_ERROR, 0x045d4487, "WT_FLOW_CONTROL_ERROR, §9.5")
    same(h3_wire.WT_ALPN_ERROR, 0x0817b3dd, "WT_ALPN_ERROR, §9.5")
    same(h3_wire.WT_REQUIREMENTS_NOT_MET, 0x212c0d48, "WT_REQUIREMENTS_NOT_MET, §9.5")
    same(h3_wire.WT_APPLICATION_FIRST, 0x52e4a40fa8db, "WT_APPLICATION_ERROR first, §9.5")
    same(h3_wire.WT_APPLICATION_LAST, 0x52e5ac983162, "WT_APPLICATION_ERROR last, §9.5")
    // draft-17 §9.6 capsules.
    same(h3_wire.CAPSULE_WT_CLOSE_SESSION, 0x2843, "WT_CLOSE_SESSION, §9.6")
    same(h3_wire.CAPSULE_WT_DRAIN_SESSION, 0x78ae, "WT_DRAIN_SESSION, §9.6")
    same(h3_wire.CAPSULE_WT_MAX_STREAMS_BIDI, 0x190B4D3F, "WT_MAX_STREAMS bidi, §9.6")
    same(h3_wire.CAPSULE_WT_MAX_STREAMS_UNI, 0x190B4D40, "WT_MAX_STREAMS uni, §9.6")
    same(h3_wire.CAPSULE_WT_STREAMS_BLOCKED_BIDI, 0x190B4D43, "WT_STREAMS_BLOCKED bidi, §9.6")
    same(h3_wire.CAPSULE_WT_STREAMS_BLOCKED_UNI, 0x190B4D44, "WT_STREAMS_BLOCKED uni, §9.6")
    same(h3_wire.CAPSULE_WT_MAX_DATA, 0x190B4D3D, "WT_MAX_DATA, §9.6")
    same(h3_wire.CAPSULE_WT_DATA_BLOCKED, 0x190B4D41, "WT_DATA_BLOCKED, §9.6")
    // RFC 9220 §3/§5, RFC 9297 §2.1.1/§5, RFC 9204 §5.
    same(h3_wire.SETTINGS_ENABLE_CONNECT_PROTOCOL, 0x08, "SETTINGS_ENABLE_CONNECT_PROTOCOL, RFC 9220 §3")
    same(h3_wire.SETTINGS_H3_DATAGRAM, 0x33, "SETTINGS_H3_DATAGRAM, RFC 9297 §5.1")
    same(h3_wire.H3_DATAGRAM_ERROR, 0x33, "H3_DATAGRAM_ERROR, RFC 9297 §5.2")
    same(h3_wire.CAPSULE_DATAGRAM, 0x00, "DATAGRAM capsule, RFC 9297 §5.4")
    same(h3_wire.SETTINGS_QPACK_MAX_TABLE_CAPACITY, 0x01, "SETTINGS_QPACK_MAX_TABLE_CAPACITY, RFC 9204 §5")
    same(h3_wire.SETTINGS_QPACK_BLOCKED_STREAMS, 0x07, "SETTINGS_QPACK_BLOCKED_STREAMS, RFC 9204 §5")
    same(h3_wire.SETTINGS_MAX_FIELD_SECTION_SIZE, 0x06, "SETTINGS_MAX_FIELD_SECTION_SIZE, RFC 9114 §7.2.4.1")
    // RFC 9114 §11.2.1 frame types and §11.2.4 / RFC 9204 §4.2 stream types.
    same(h3_wire.FRAME_DATA, 0x00, "DATA, RFC 9114 §11.2.1")
    same(h3_wire.FRAME_HEADERS, 0x01, "HEADERS, §11.2.1")
    same(h3_wire.FRAME_CANCEL_PUSH, 0x03, "CANCEL_PUSH, §11.2.1")
    same(h3_wire.FRAME_SETTINGS, 0x04, "SETTINGS, §11.2.1")
    same(h3_wire.FRAME_PUSH_PROMISE, 0x05, "PUSH_PROMISE, §11.2.1")
    same(h3_wire.FRAME_GOAWAY, 0x07, "GOAWAY, §11.2.1")
    same(h3_wire.FRAME_MAX_PUSH_ID, 0x0d, "MAX_PUSH_ID, §11.2.1")
    same(h3_wire.STREAM_CONTROL, 0x00, "control stream, RFC 9114 §11.2.4")
    same(h3_wire.STREAM_PUSH, 0x01, "push stream, §11.2.4")
    same(h3_wire.STREAM_QPACK_ENCODER, 0x02, "QPACK encoder stream, RFC 9204 §8.2")
    same(h3_wire.STREAM_QPACK_DECODER, 0x03, "QPACK decoder stream, RFC 9204 §8.2")
    // RFC 9114 §8.1 and RFC 9204 §6 error codes.
    same(h3_wire.H3_NO_ERROR, 0x0100, "H3_NO_ERROR, RFC 9114 §8.1")
    same(h3_wire.H3_GENERAL_PROTOCOL_ERROR, 0x0101, "H3_GENERAL_PROTOCOL_ERROR")
    same(h3_wire.H3_INTERNAL_ERROR, 0x0102, "H3_INTERNAL_ERROR")
    same(h3_wire.H3_STREAM_CREATION_ERROR, 0x0103, "H3_STREAM_CREATION_ERROR")
    same(h3_wire.H3_CLOSED_CRITICAL_STREAM, 0x0104, "H3_CLOSED_CRITICAL_STREAM")
    same(h3_wire.H3_FRAME_UNEXPECTED, 0x0105, "H3_FRAME_UNEXPECTED")
    same(h3_wire.H3_FRAME_ERROR, 0x0106, "H3_FRAME_ERROR")
    same(h3_wire.H3_EXCESSIVE_LOAD, 0x0107, "H3_EXCESSIVE_LOAD")
    same(h3_wire.H3_ID_ERROR, 0x0108, "H3_ID_ERROR")
    same(h3_wire.H3_SETTINGS_ERROR, 0x0109, "H3_SETTINGS_ERROR")
    same(h3_wire.H3_MISSING_SETTINGS, 0x010a, "H3_MISSING_SETTINGS")
    same(h3_wire.H3_REQUEST_REJECTED, 0x010b, "H3_REQUEST_REJECTED")
    same(h3_wire.H3_REQUEST_CANCELLED, 0x010c, "H3_REQUEST_CANCELLED")
    same(h3_wire.H3_REQUEST_INCOMPLETE, 0x010d, "H3_REQUEST_INCOMPLETE")
    same(h3_wire.H3_MESSAGE_ERROR, 0x010e, "H3_MESSAGE_ERROR")
    same(h3_wire.QPACK_DECOMPRESSION_FAILED, 0x0200, "QPACK_DECOMPRESSION_FAILED, RFC 9204 §6")
    same(h3_wire.QPACK_ENCODER_STREAM_ERROR, 0x0201, "QPACK_ENCODER_STREAM_ERROR")
    same(h3_wire.QPACK_DECODER_STREAM_ERROR, 0x0202, "QPACK_DECODER_STREAM_ERROR")
    // draft-17 §4.4: 0 and 0xffffffff map to the range's ends (stated in the text). The first
    // reserved value inside the range is 0x1f * 0x2ad7fd3c62c + 0x21 = 0x52e4a40fa8f9, so 29
    // and 30 map to its two neighbours, 0x52e4a40fa8f8 and 0x52e4a40fa8fa (worked by hand).
    same(h3_wire.application_code(0), 0x52e4a40fa8db, "application code 0")
    same(h3_wire.application_code(0xffffffffu32), 0x52e5ac983162, "application code 0xffffffff")
    same(h3_wire.application_code(29), 0x52e4a40fa8f8, "application code 29")
    same(h3_wire.application_code(30), 0x52e4a40fa8fa, "application code 30 skips 0x52e4a40fa8f9")
    if let Some(_) = h3_wire.application_code_of(0x52e4a40fa8f9) {
        fail("a reserved HTTP/3 code mapped to an application code")
    }
    if h3_wire.application_code_of(0x52e4a40fa8fa) != Some(30u32) || h3_wire.application_code_of(0x52e5ac983162) != Some(0xffffffffu32) {
        fail("the inverse of draft-17 Figure 4")
    }
    Ok(())
}

fn decodes(wire: Bytes, max: u64, expected: List[qpack.Field]) {
    let mut fields: List[qpack.Field] = list.new()
    result.unwrap(qpack.decode_section(wire, 0, list.len(wire), max, mut fields))
    if fields != expected {
        fail("field section decoded to the wrong fields")
    }
}

fn encodes(fields: List[qpack.Field], wire: Bytes) {
    let mut out: Bytes = list.new()
    qpack.encode_section(fields, mut out)
    if out != wire {
        fail("field section encoded to the wrong bytes")
    }
    decodes(wire, 65536, fields)
}

fn refused(wire: Bytes, max: u64, expected: qpack.QpackError) {
    let mut fields: List[qpack.Field] = list.new()
    match qpack.decode_section(wire, 0, list.len(wire), max, mut fields) {
        Error(e) if e == expected => (),
        _ => fail("a field section was not refused with its RFC 9204 error"),
    }
}

fn static_row(i: u64, name: Bytes, value: Bytes) {
    let mut n: Bytes = list.new()
    qpack.push_static_name(i, mut n)
    let mut v: Bytes = list.new()
    qpack.push_static_value(i, mut v)
    if n != name || v != value {
        fail("RFC 9204 Appendix A row")
    }
}

/// bug: The static table, an indexed or literal line, or the dynamic-table refusals of WT-6
/// are wrong, so a browser's CONNECT decodes to other fields or a dynamic reference is
/// silently misread.
/// oracle: RFC 9204 Appendix A rows and Appendix B.1 (the only vector without a dynamic
/// table), §4.3 and §4.5; encode vectors derived by hand from Appendix A and RFC 7541
/// Appendix B and C.4.1.
@test
fn qpack_static_vectors() -> Result[(), ()] {
    same(qpack.STATIC_COUNT, 99, "RFC 9204 Appendix A has 99 entries")
    static_row(0, b":authority", b"")
    static_row(1, b":path", b"/")
    static_row(15, b":method", b"CONNECT")
    static_row(23, b":scheme", b"https")
    static_row(25, b":status", b"200")
    static_row(31, b"accept-encoding", b"gzip, deflate, br")
    static_row(58, b"strict-transport-security", b"max-age=31536000; includesubdomains; preload")
    static_row(72, b"accept-language", b"")
    static_row(85, b"content-security-policy", b"script-src 'none'; object-src 'none'; base-uri 'none'")
    static_row(90, b"origin", b"")
    static_row(98, b"x-frame-options", b"sameorigin")
    // Appendix B.1 sends /index.html raw; our encoder Huffman-codes it (8 < 11 bytes), so
    // B.1 is a decode vector and the encode vector is 51 88 then the RFC 7541 code.
    let mut path: List[qpack.Field] = list.new()
    list.push(mut path, field(b":path", b"/index.html"))
    decodes(hex(b"0000510b2f696e6465782e68746d6c"), 65536, path)
    encodes(path, hex(b"0000518860d5485f2bce9a68"))
    // RFC 7541 C.4.1's Huffman string under static name :authority (index 0).
    let mut authority: List[qpack.Field] = list.new()
    list.push(mut authority, field(b":authority", b"www.example.com"))
    encodes(authority, hex(b"0000508cf1e3c2e5f23a6ba0ab90f4ff"))
    // A WebTransport CONNECT: cf is :method CONNECT (15); :protocol is not in the table,
    // so a literal name, 2f 00 (Huffman, length 7 past the 3-bit prefix); d7 is :scheme
    // https (23); 50/51 name :authority/:path; origin is index 90, 5f 4b past the 4-bit prefix.
    let mut connect: List[qpack.Field] = list.new()
    list.push(mut connect, field(b":method", b"CONNECT"))
    list.push(mut connect, field(b":protocol", b"webtransport-h3"))
    list.push(mut connect, field(b":scheme", b"https"))
    list.push(mut connect, field(b":authority", b"example.com"))
    list.push(mut connect, field(b":path", b"/moq"))
    list.push(mut connect, field(b"origin", b"https://example.com"))
    encodes(connect, hex(b"0000cf2f00b95d8749c87a3f8bf058d360ea4567b12b4ecfd750882f91d35d055c87a751836293f65f4b8e9d29ad171860be474d7415721e9f"))
    // :status 200, 404 and 403 are indices 25, 27 and 68; 68 passes the 6-bit prefix: ff 05.
    let mut statuses: List[qpack.Field] = list.new()
    list.push(mut statuses, field(b":status", b"200"))
    list.push(mut statuses, field(b":status", b"404"))
    list.push(mut statuses, field(b":status", b"403"))
    encodes(statuses, hex(b"0000d9dbff05"))
    // A dynamic reference in each position is QPACK_DECOMPRESSION_FAILED.
    refused(hex(b"0100"), 65536, Decompression)
    refused(hex(b"000080"), 65536, Decompression)
    refused(hex(b"000010"), 65536, Decompression)
    refused(hex(b"00004000"), 65536, Decompression)
    refused(hex(b"00000000"), 65536, Decompression)
    refused(hex(b"0000ff24"), 65536, Decompression)
    // :path /index.html is 5 + 11 + 32 = 48 bytes (RFC 9114 §4.2.2).
    decodes(hex(b"0000510b2f696e6465782e68746d6c"), 48, path)
    refused(hex(b"0000510b2f696e6465782e68746d6c"), 47, TooLarge)
    refused(hex(b"0000518860d5485f2bce9a68"), 47, TooLarge)
    // Encoder stream: only Set Dynamic Table Capacity 0 (0x20); capacity 1 (0x21) and an
    // insert with static name reference (c0 00) are QPACK_ENCODER_STREAM_ERROR (§4.3).
    same(result.unwrap(qpack.read_encoder_stream(hex(b"2020"), 0, 2)), 2, "capacity 0 accepted")
    if let Error(EncoderStream) = qpack.read_encoder_stream(hex(b"21"), 0, 1) {} else {
        fail("Set Dynamic Table Capacity 1 accepted")
    }
    if let Error(EncoderStream) = qpack.read_encoder_stream(hex(b"c000"), 0, 2) {} else {
        fail("an insert on the encoder stream accepted")
    }
    // Decoder stream: Stream Cancellation (01, §4.4.2) is consumed; a Section
    // Acknowledgment (1, §4.4.1) or Insert Count Increment (00, §4.4.3) is an error.
    same(result.unwrap(qpack.read_decoder_stream(hex(b"44"), 0, 1)), 1, "stream cancellation")
    same(result.unwrap(qpack.read_decoder_stream(hex(b"447f"), 0, 2)), 1, "partial cancellation waits")
    if let Error(DecoderStream) = qpack.read_decoder_stream(hex(b"84"), 0, 1) {} else {
        fail("a Section Acknowledgment accepted")
    }
    if let Error(DecoderStream) = qpack.read_decoder_stream(hex(b"01"), 0, 1) {} else {
        fail("an Insert Count Increment accepted")
    }
    Ok(())
}

fn huffman_vector(plain: Bytes, coded: Bytes) {
    let mut out: Bytes = list.new()
    qpack.huffman_encode(plain, mut out)
    if out != coded || qpack.huffman_len(plain) != list.len(coded) {
        fail("RFC 7541 Huffman encode")
    }
    let mut back: Bytes = list.new()
    result.unwrap(qpack.huffman_decode(coded, 0, list.len(coded), 1024, mut back))
    if back != plain {
        fail("RFC 7541 Huffman decode")
    }
}

fn huffman_refused(coded: Bytes) {
    let mut back: Bytes = list.new()
    if let Error(Decompression) = qpack.huffman_decode(coded, 0, list.len(coded), 1024, mut back) {} else {
        fail("a malformed Huffman string decoded")
    }
}

fn round_trip(plain: Bytes, mut coded: Bytes, mut back: Bytes) {
    list.clear(mut coded)
    list.clear(mut back)
    qpack.huffman_encode(plain, mut coded)
    result.unwrap(qpack.huffman_decode(coded, 0, list.len(coded), 3, mut back))
    if back != plain {
        fail("a byte string did not survive a Huffman round trip")
    }
}

/// bug: A Huffman code, the canonical decode tables, the EOS padding or the padding checks
/// are wrong, so a browser's Huffman-coded header decodes to other bytes or a malformed
/// string is accepted.
/// oracle: RFC 7541 Appendix C.4 and C.6 Huffman strings, §5.2's padding and EOS rules.
@test
fn huffman_round_trip_and_vectors() -> Result[(), ()] {
    huffman_vector(b"www.example.com", hex(b"f1e3c2e5f23a6ba0ab90f4ff"))
    huffman_vector(b"no-cache", hex(b"a8eb10649cbf"))
    huffman_vector(b"custom-key", hex(b"25a849e95ba97d7f"))
    huffman_vector(b"custom-value", hex(b"25a849e95bb8e8b4bf"))
    huffman_vector(b"302", hex(b"6402"))
    huffman_vector(b"307", hex(b"640eff"))
    huffman_vector(b"private", hex(b"aec3771a4b"))
    huffman_vector(b"gzip", hex(b"9bd9ab"))
    huffman_vector(b"Mon, 21 Oct 2013 20:13:21 GMT", hex(b"d07abe941054d444a8200595040b8166e082a62d1bff"))
    huffman_vector(b"https://www.example.com", hex(b"9d29ad171863c78f0b97c8e9ae82ae43d3"))
    huffman_vector(b"foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1", hex(b"94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007"))
    // Every byte string of length 0 to 3.
    let mut coded: Bytes = list.with_capacity(16)
    let mut back: Bytes = list.with_capacity(4)
    let mut plain: Bytes = list.with_capacity(3)
    round_trip(plain, mut coded, mut back)
    for a in 0u64 .. 256 {
        list.clear(mut plain)
        list.push(mut plain, int.narrow(a))
        round_trip(plain, mut coded, mut back)
        for b in 0u64 .. 256 {
            list.truncate(mut plain, 1)
            list.push(mut plain, int.narrow(b))
            round_trip(plain, mut coded, mut back)
            for c in 0u64 .. 256 {
                list.truncate(mut plain, 2)
                list.push(mut plain, int.narrow(c))
                round_trip(plain, mut coded, mut back)
            }
        }
    }
    // EOS (30 ones) inside a string; 'a' (00011) then 11 bits of padding; 'a' padded with
    // zeros instead of the EOS prefix.
    huffman_refused(hex(b"ffffffff"))
    huffman_refused(hex(b"1fff"))
    huffman_refused(hex(b"18"))
    // A decode that would pass its limit stops there.
    let mut short: Bytes = list.new()
    if let Error(TooLarge) = qpack.huffman_decode(hex(b"f1e3c2e5f23a6ba0ab90f4ff"), 0, 12, 14, mut short) {} else {
        fail("a Huffman decode ran past its limit")
    }
    same(list.len(short), 14, "the decode stopped at its limit")
    Ok(())
}

fn wt_push_varint(mut src: std.prop.Source, rem: u64, mut out: Bytes) {
    match std.prop.below(mut src, 7) {
        0 => list.push(mut out, 0u8),
        1 => list.append(mut out, b"\xff\xff\xff\xff\xff\xff\xff\xff"),
        2 => h3_wire.write_varint(rem + 1, mut out),
        3 => h3_wire.write_varint(rem, mut out),
        4 => list.append(mut out, b"\x40\x01"),
        _ => h3_wire.write_varint(std.prop.below(mut src, 64), mut out),
    }
}

fn wt_wire_gen() -> std.prop.Gen[Bytes] {
    let mut arms: List[std.prop.Gen[Bytes]] = list.new()
    list.push(mut arms, std.prop.bytes_of(0, 256))
    // Varint pairs (frame and capsule heads, SETTINGS pairs) at 0, 2^62-1 and one past the rest.
    list.push(mut arms, std.prop.make(fn(mut src: std.prop.Source) -> Bytes {
        let mut out: Bytes = list.new()
        let tail = std.prop.draw(mut src, std.prop.bytes_of(0, 32))
        for _ in 0u64 .. 2 * std.prop.below(mut src, 4) {
            wt_push_varint(mut src, list.len(tail), mut out)
        }
        list.append(mut out, tail)
        take out
    }, fn(b: Bytes, mut out: String) {
        string.push(mut out, "wt_varints(len=")
        string.push_u64(mut out, list.len(b))
        string.push(mut out, ")")
    }))
    // QPACK sections: prefix 00 00, then field lines with prefixed integers at their
    // continuation edge and string lengths one past the rest.
    list.push(mut arms, std.prop.make(fn(mut src: std.prop.Source) -> Bytes {
        let mut out: Bytes = list.new()
        list.push(mut out, 0u8)
        list.push(mut out, 0u8)
        for _ in 0u64 .. std.prop.below(mut src, 4) {
            match std.prop.below(mut src, 4) {
                0 => list.push(mut out, 0xc0u8 | int.narrow(std.prop.below(mut src, 64))),
                1 => list.append(mut out, b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x7f"),
                2 => {
                    list.push(mut out, 0x50u8 | int.narrow(std.prop.below(mut src, 16)))
                    let n = std.prop.below(mut src, 8)
                    list.push(mut out, int.narrow(std.prop.below(mut src, 2) * 0x80 + n + std.prop.below(mut src, 2)))
                    for _ in 0u64 .. n {
                        list.push(mut out, int.truncate(std.prop.word(mut src)))
                    }
                },
                _ => {
                    list.push(mut out, 0x20u8 | int.narrow(std.prop.below(mut src, 16)))
                    let tail = std.prop.draw(mut src, std.prop.bytes_of(0, 12))
                    list.append(mut out, tail)
                },
            }
        }
        take out
    }, fn(b: Bytes, mut out: String) {
        string.push(mut out, "qpack_section(len=")
        string.push_u64(mut out, list.len(b))
        string.push(mut out, ")")
    }))
    std.prop.one_of(take arms)
}

fn wt_total_law(wire: Bytes) -> Result[(), String] {
    let len = list.len(wire)
    // 1. Frame/capsule head: minimal varints re-encode to exactly the consumed prefix.
    if let Some(h) = h3_wire.read_head(wire, 0, len) {
        if h.head > len {
            return Error(string.from("read_head consumed past the input"))
        }
        let mut re: Bytes = list.new()
        h3_wire.write_head(h.kind, h.len, mut re)
        if list.len(re) == h.head && re != list.slice(wire, 0, h.head) {
            return Error(string.from("frame head did not re-encode to the consumed prefix"))
        }
    }
    // 2. SETTINGS payload: a minimal payload re-encodes to exactly its bytes.
    if let Ok(s) = h3_wire.read_settings(wire, 0, len) {
        let mut re: Bytes = list.new()
        h3_wire.write_settings(s.pairs, mut re)
        let mut at = 0u64
        let Some(h) = h3_wire.read_head(re, at, list.len(re)) else {
            return Error(string.from("write_settings head unreadable"))
        }
        at = h.head
        if h.len == len && list.slice(re, at, list.len(re)) != wire {
            return Error(string.from("SETTINGS payload did not re-encode to the consumed bytes"))
        }
    }
    // 3. QPACK field section: whatever decodes re-encodes and decodes to the same fields.
    for max in[0u64, 64u64, 1u64 << 20] {
        let mut fields: List[qpack.Field] = list.new()
        if let Ok(()) = qpack.decode_section(wire, 0, len, max, mut fields) {
            let mut re: Bytes = list.new()
            qpack.encode_section(fields, mut re)
            let mut back: List[qpack.Field] = list.new()
            if let Error(_) = qpack.decode_section(re, 0, list.len(re), 1u64 << 40, mut back) {
                return Error(string.from("encode_section output refused by decode_section"))
            }
            if back != fields {
                return Error(string.from("QPACK section did not round-trip"))
            }
        }
    }
    // 4. Huffman: an accepted string re-encodes to exactly the consumed bytes (RFC 7541 §5.2 padding).
    let mut plain: Bytes = list.new()
    if let Ok(()) = qpack.huffman_decode(wire, 0, len, 1u64 << 20, mut plain) {
        let mut re: Bytes = list.new()
        qpack.huffman_encode(plain, mut re)
        if re != wire {
            return Error(string.from("Huffman string did not re-encode to the consumed bytes"))
        }
    }
    // 5. QPACK encoder and decoder streams consume at most their input.
    if let Ok(n) = qpack.read_encoder_stream(wire, 0, len) {
        if n > len {
            return Error(string.from("encoder stream consumed past the input"))
        }
    }
    if let Ok(n) = qpack.read_decoder_stream(wire, 0, len) {
        if n > len {
            return Error(string.from("decoder stream consumed past the input"))
        }
    }
    Ok(())
}

/// bug: a frame head, SETTINGS, QPACK or Huffman decoder that traps, overflows or reads past
/// the input on peer bytes, or accepts a form that does not re-encode to the bytes it consumed.
/// oracle: RFC 9000 §16 varints, RFC 9114 §7.2.4 SETTINGS, RFC 9204 §4.5 sections and
/// RFC 7541 §5.2 Huffman, written by write_head, write_settings, encode_section and
/// huffman_encode, independent of the decoders.
@test
fn wire_decode_totality_property() -> Result[(), ()] {
    let mut c = std.prop.config()
    c.cases = 160
    std.prop.check(c, wt_wire_gen(), wt_total_law)
}

// The reviewed corpus (core/tests/decoder-corpus/qpack.json): field sections under a size
// limit and the two QPACK instruction streams. Its expected classes, projections and
// partial steps are a Python reference's of RFC 9204 §4.3–§4.5 over the published static
// table and Huffman code, not this package's. Rows are `id class selector input projection
// schedules` with hex fields and `-` for an empty one; a schedule is `<chunk ends,
// big-endian u16>:<partial steps>`. Selectors: 0 a section under 4096, 1 the decoder
// stream, 2 the encoder stream, 3 a section under 64.
// Regenerate: tools/decoder-fuzz/fixtures.py rows qpack --write.
const REVIEWED_QPACK: String = "accepted-decoder-cancellations accepted 1 447f0045 636f6e73756d65643d34 0004:0,0001000200030004:1,00020004:1\naccepted-empty-section accepted 0 0000 - 0002:0\naccepted-encoder-capacity-zero accepted 2 2020 636f6e73756d65643d32 0002:0,00010002:0\naccepted-huffman-authority accepted 0 0000508cf1e3c2e5f23a6ba0ab90f4ff 3a617574686f726974793a207777772e6578616d706c652e636f6d0a 0010:0\naccepted-last-static-entry accepted 0 0000ff23 782d6672616d652d6f7074696f6e733a2073616d656f726967696e0a 0004:0\naccepted-literal-name accepted 0 000023782d610162 782d613a20620a 0008:0\naccepted-rfc9204-b1 accepted 0 0000510b2f696e6465782e68746d6c 3a706174683a202f696e6465782e68746d6c0a 000f:0\naccepted-section-at-size-limit accepted 3 0000511b2f6162636465666768696a6b6c6d6e6f707172737475767778797a 3a706174683a202f6162636465666768696a6b6c6d6e6f707172737475767778797a0a 001f:0\naccepted-static-indexed accepted 0 0000d1d7c1 3a6d6574686f643a204745540a3a736368656d653a2068747470730a3a706174683a202f0a 0005:0\npartial-decoder-open-integer partial 1 447f 636f6e73756d65643d31 0002:1,00010002:1\nrefused-decoder-insert-count-increment decoder-stream 1 4401 - 0002:0,00010002:0\nrefused-decoder-integer-overflow decoder-stream 1 7fffffffffffffffffff7f - 000b:0\nrefused-decoder-section-acknowledgment decoder-stream 1 84 - 0001:0\nrefused-dynamic-indexed decompression 0 000080 - 0003:0\nrefused-encoder-capacity-one encoder-stream 2 21 - 0001:0\nrefused-encoder-insert encoder-stream 2 c000 - 0002:0\nrefused-huffman-padding decompression 0 0000518100 - 0005:0\nrefused-post-base decompression 0 000010 - 0003:0\nrefused-rfc9204-b2-dynamic decompression 0 03811011 - 0004:0\nrefused-section-over-size-limit too-large 3 0000511c2f6162636465666768696a6b6c6d6e6f707172737475767778797a30 - 0020:0\nrefused-static-index-99 decompression 0 0000ff24 - 0004:0\nrefused-truncated-literal decompression 0 0000510b2f69 - 0006:0\nrefused-two-fields-over-size-limit too-large 3 0000d1d7 - 0004:0\n"

fn reviewed_qpack_class(e: qpack.QpackError) -> u8 {
    match e {
        Decompression => 2u8,
        EncoderStream => 3u8,
        DecoderStream => 4u8,
        TooLarge => 5u8,
    }
}

fn reviewed_qpack_name(class: u8) -> String {
    match class {
        0u8 => "accepted",
        1u8 => "partial",
        2u8 => "decompression",
        3u8 => "encoder-stream",
        4u8 => "decoder-stream",
        5u8 => "too-large",
        6u8 => "surface",
        _ => "law",
    }
}

fn reviewed_consumed(n: u64) -> Bytes {
    let mut text = string.from("consumed=")
    string.push_u64(mut text, n)
    let mut out: Bytes = list.new()
    list.append(mut out, string.as_bytes(text))
    take out
}

fn reviewed_end(ends: Bytes, i: u64) -> u64 {
    let high: u64 = int.widen(ends[2 * i])
    let low: u64 = int.widen(ends[2 * i + 1])
    high * 256 + low
}

// One field section: its fields as `name: value` lines. The owner law: the fields
// encode_section writes decode to the same fields under the same limit.
fn reviewed_qpack_section(wire: Bytes, max: u64) -> (u8, Bytes, u64) {
    let mut fields: List[qpack.Field] = list.new()
    if let Error(e) = qpack.decode_section(wire, 0, list.len(wire), max, mut fields) {
        return (reviewed_qpack_class(e), b"", 0)
    }
    let mut again: Bytes = list.new()
    qpack.encode_section(fields, mut again)
    let mut back: List[qpack.Field] = list.new()
    if let Error(_) = qpack.decode_section(again, 0, list.len(again), max, mut back) {
        return (9u8, b"", 0)
    }
    if back != fields {
        return (9u8, b"", 0)
    }
    let mut out: Bytes = list.new()
    for f in fields {
        list.append(mut out, f.name)
        list.append(mut out, b": ")
        list.append(mut out, f.value)
        list.push(mut out, 10)
    }
    (0u8, take out, 0)
}

// The decoder stream in chunks, buffered as the connection buffers it: each read drops
// the complete instructions and a step that leaves bytes behind is partial. The owner
// law: the chunks consume what one read of the whole stream consumes, or are refused
// as it is.
fn reviewed_qpack_decoder(wire: Bytes, ends: Bytes) -> (u8, Bytes, u64) {
    let size = list.len(wire)
    let whole = qpack.read_decoder_stream(wire, 0, size)
    let mut buf: Bytes = list.new()
    let mut partials = 0u64
    let mut consumed = 0u64
    let mut from = 0u64
    for i in 0u64 .. list.len(ends) / 2 {
        let stop = reviewed_end(ends, i)
        if stop < from || stop > size {
            return (9u8, b"", partials)
        }
        list.append(mut buf, list.slice(wire, from, stop))
        from = stop
        match qpack.read_decoder_stream(buf, 0, list.len(buf)) {
            Ok(n) => {
                if n > list.len(buf) {
                    return (9u8, b"", partials)
                }
                list.drop_prefix(mut buf, n)
                consumed += n
                if list.len(buf) > 0 {
                    partials += 1
                }
            },
            Error(e) => {
                if let Error(w) = whole {
                    if w == e {
                        return (reviewed_qpack_class(e), b"", partials)
                    }
                }
                return (9u8, b"", partials)
            },
        }
    }
    if from != size {
        return (9u8, b"", partials)
    }
    match whole {
        Ok(n) if n == consumed && n + list.len(buf) == size => if list.len(buf) > 0 {
            (1u8, reviewed_consumed(n), partials)
        } else {
            (0u8, reviewed_consumed(n), partials)
        },
        _ => (9u8, b"", partials),
    }
}

// The encoder stream, each chunk read on its own as the connection reads it. The owner
// law: the chunks consume what one read of the whole stream consumes, or are refused
// as it is.
fn reviewed_qpack_encoder(wire: Bytes, ends: Bytes) -> (u8, Bytes, u64) {
    let size = list.len(wire)
    let whole = qpack.read_encoder_stream(wire, 0, size)
    let mut consumed = 0u64
    let mut from = 0u64
    for i in 0u64 .. list.len(ends) / 2 {
        let stop = reviewed_end(ends, i)
        if stop < from || stop > size {
            return (9u8, b"", 0)
        }
        match qpack.read_encoder_stream(wire, from, stop) {
            Ok(n) => {
                consumed += n
            },
            Error(e) => {
                if let Error(w) = whole {
                    if w == e {
                        return (reviewed_qpack_class(e), b"", 0)
                    }
                }
                return (9u8, b"", 0)
            },
        }
        from = stop
    }
    match whole {
        Ok(n) if n == consumed && n == size => (0u8, reviewed_consumed(n), 0),
        _ => (9u8, b"", 0),
    }
}

// One input on fresh state: its class, its projection and its partial steps. Class 6 is
// a selector that names no surface; class 9 a broken owner law or chunks that do not
// cover the input in order.
fn reviewed_qpack_case(selector: u8, wire: Bytes, ends: Bytes) -> (u8, Bytes, u64) {
    match selector {
        0u8 => reviewed_qpack_section(wire, 4096),
        1u8 => reviewed_qpack_decoder(wire, ends),
        2u8 => reviewed_qpack_encoder(wire, ends),
        3u8 => reviewed_qpack_section(wire, 64),
        _ => (6u8, b"", 0),
    }
}

fn reviewed_field(row: String, mut at: u64) -> View[String] in row {
    let start = at
    let end = match string.find(row, start, " ") {
        Some(space) => space,
        None => string.byte_len(row),
    }
    at = end + 1
    string.slice(row, start, end)
}

fn reviewed_bytes(text: String) -> Bytes {
    if text == "-" {
        return b""
    }
    option.unwrap(std.hex.decode(string.as_bytes(text)))
}

fn reviewed_count(text: String) -> u64 {
    let digits = string.as_bytes(text)
    let mut n = 0u64
    for i in 0u64 .. list.len(digits) {
        let digit: u64 = int.widen(digits[i] - 48)
        n = n * 10 + digit
    }
    n
}

/// bug: Decode a field section to the wrong fields, admit one past its size limit or a
/// dynamic reference, or consume a QPACK instruction stream differently when its bytes
/// arrive in pieces.
/// oracle: core/tests/decoder-corpus/qpack.json, whose expected observations are a Python
/// reference's of RFC 9204 §4.3–§4.5 and Appendix A and B, RFC 7541 §5.1, §5.2 and
/// Appendix B and RFC 9114 §4.2.2. Every case runs twice per schedule, each from fresh
/// state.
@test
fn reviewed_qpack() -> Result[(), ()] {
    let data = REVIEWED_QPACK
    let mut at = 0u64
    let mut completed = 0u64
    while at < string.byte_len(data) {
        let end = option.unwrap(string.find(data, at, "\n"))
        let row = string.slice(data, at, end)
        let mut next = 0u64
        let id = reviewed_field(row, mut next)
        let class = reviewed_field(row, mut next)
        let selector: u8 = int.truncate(reviewed_count(reviewed_field(row, mut next)))
        let raw = reviewed_bytes(reviewed_field(row, mut next))
        let projection = reviewed_bytes(reviewed_field(row, mut next))
        let schedules = reviewed_field(row, mut next)
        let mut s = 0u64
        while s < string.byte_len(schedules) {
            let stop = match string.find(schedules, s, ",") {
                Some(comma) => comma,
                None => string.byte_len(schedules),
            }
            let colon = option.unwrap(string.find(schedules, s, ":"))
            let ends = reviewed_bytes(string.slice(schedules, s, colon))
            let partials = reviewed_count(string.slice(schedules, colon + 1, stop))
            let (first, shown, steps) = reviewed_qpack_case(selector, raw, ends)
            let (second, replayed, again) = reviewed_qpack_case(selector, raw, ends)
            if first != second || shown != replayed || steps != again || reviewed_qpack_name(first) != class || shown != projection || steps != partials {
                fail(string.from(id))
            }
            s = stop + 1
        }
        completed += 1
        at = end + 1
    }
    if completed != 23 {
        fail("reviewed qpack cases completed")
    }
    Ok(())
}

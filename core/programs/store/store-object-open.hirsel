fn history_load_admitted(mut read_source: history.ObjectPackRead, head: history.HistoryHead, ceiling: u64) -> Result[pager.JournalReplay, Error] waits {
    let (take replay, take checkpoint_state) = history_paged_load(mut read_source, head, ceiling)?
    let owners = disk_allocation(scoped fn() -> Result[Map[manifest.IncomingEdge, u64], Error] {
        Ok(manifest.located_owners(checkpoint_state.manifest))
    })?
    let manifest.LoadedPageStore(manifest: take page_record, lists: take lists, locations: take locations, ..) = take checkpoint_state
    let pages = manifest.recovered_pack_disk(page_record, take locations, take lists, take owners, list.new())
    read_source.admitted_base = Some(history.recovered_open_base(page_record, take pages))
    Ok(take replay)
}

fn history_claim_matches_pair(expected: Claim, current: history.HistoryPair) -> bool {
    if expected.epoch != current.epoch || list.len(expected.holder) != 16 {
        return false
    }
    let hi = format.read_le(expected.holder, 0, 8)
    let lo = format.read_le(expected.holder, 8, 8)
    hi == current.holder.hi && lo == current.holder.lo
}

fn history_check_claim_auth(options: Options, current: history.HistoryPair) -> Result[ClaimAuth, Error] {
    let Some(auth) = view options.claim_auth else {
        return Error(Missing("claim_auth"))
    }
    if list.len(auth.attempt) != 16 {
        return Error(Missing("claim_auth"))
    }
    match auth.expect {
        Some(expected) => {
            if expected.epoch == 0 || list.len(expected.holder) != 16 {
                return Error(Missing("claim_auth"))
            }
            if !history_claim_matches_pair(expected, current) {
                return Error(Superseded(claim_from_pair(current)?))
            }
        },
        None => {
            match auth.class {
                // An operator Adopt is pinned to the first pair it admits:
                // the open's later iterations check against that pair.
                Adopt => return Ok(ClaimAuth(expect: Some(claim_from_pair(current)?), attempt: clone(auth.attempt), class: Adopt)),
                _ => return Error(Missing("claim_auth")),
            }
        },
    }
    Ok(clone(auth))
}

// A validated successor (STORE-SPEC §12.3): the head that replaced the
// caller's is the same Store at this namespace, so its pair is the claim
// that deposed the caller. A head that does not decode or names another
// Store is not a validated successor and stays `Lost`.
fn history_superseded_by(client: std.object.Client, store: StoreId, observed: Bytes) -> Error {
    let Ok((take capture, _)) = failure_result_from_rep(history.history_decode_head_attach(observed)) else {
        return Lost
    }
    if let Error(_) = failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(Some(store)), capture.head.store)) {
        return Lost
    }
    if let Error(_) = failure_result_from_rep(history.history_check_namespace(capture, client)) {
        return Lost
    }
    match claim_from_pair(capture.head.pair) {
        Ok(take actual) => Superseded(take actual),
        Error(take problem) => take problem,
    }
}

fn history_check_open(client: std.object.Client, selected: history.HistoryCapture, requested_levels: List[String], authority_kind: u8, options: Options) -> Result[ClaimAuth, Error] {
    let current = selected.head
    failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(options.expect), current.store))?
    failure_result_from_rep(history.history_check_namespace(selected, client))?
    if current.authority_kind != authority_kind {
        return Error(Unsupported(int.widen(current.authority_kind)))
    }
    for i in 0u64 .. list.len(selected.config.levels) {
        let recorded_name = view selected.config.levels[i]
        if i >= list.len(requested_levels) || recorded_name != requested_levels[i] {
            return Error(Declared(string.from(recorded_name)))
        }
    }
    if list.len(selected.config.levels) != list.len(requested_levels) {
        return Error(Declared(string.from(selected.config.levels[list.len(selected.config.levels) - 1])))
    }
    // Check ClaimAuth before any write, slot_attach, or Held row (STORE-SPEC §12.3).
    let auth = history_check_claim_auth(options, current.pair)?
    if let Some(version_number) = options.activation {
        if version_number != current.activation {
            return Error(NotCurrent(current.activation))
        }
    }
    if current.activation != 0 {
        if let Some(schema_binding) = options.binding {
            if !object_writer.history_binding_equals(schema_binding, current.binding) {
                return Error(NotCurrent(current.activation))
            }
        }
    }
    let _ = failure_result_from_rep(history.history_next_id(current.pair.epoch))?
    let _ = failure_result_from_rep(history.history_next_id(current.entry.seq))?
    Ok(take auth)
}

fn history_open_genesis[T](mut client: std.object.Client, r: Random, holder: StoreId, options: Options, authority_kind: u8, take authority: Bytes, mut workspace: history.HistoryBuffers, deadline: u64, mut link: Option[host_stream.SlotLink], prepare_writer: scoped fn(StoreId, u64, bool, std.object.Client, pager.JournalReplay) -> Result[T, Error]) -> Result[(history.HistoryRegister, pager.JournalReplay, T, Bytes), Error] waits {
    if !options.create || (options.activation != None && options.activation != Some(0u64)) {
        return Error(NotFound)
    }
    if let Some(_) = options.expect {
        return Error(NotFound)
    }
    if let Some(auth) = options.claim_auth {
        if list.len(auth.attempt) != 16 {
            return Error(Missing("claim_auth"))
        }
        if let Some(_) = auth.expect {
            return Error(NotFound)
        }
    }
    failure_result_from_rep(object_writer.history_check_empty(mut client, deadline))?
    let first = disk_allocation(scoped fn() -> Result[pages.State, Error] {
        failure_result_from_rep(types.capacity(pages.main_state(pages.empty_roots(), 0, 0)))
    })?
    let initial = failure_result_from_rep(pager.journal_replay(take first, 0, limits_to_rep(limits_from_rep(types.named_limits(optional_limits_to_rep(options.limits))))))?
    failure_result_from_rep(catalog.over_ceiling(failure_result_from_rep(journal.journal_account(initial))?, options.resident_limit))?
    let id = failure_result_from_rep(types.capacity(types.disk_identity(r)))?
    let admitted = prepare_writer(store_key_from_rep(id), 1, false, client, initial)?
    if let Some(mut attaching) = link {
        let register = failure_result_from_rep(object_writer.history_stream_genesis(mut client, mut attaching, store_key_to_rep(store_key_from_rep(id)), store_key_to_rep(holder), authority_kind, authority, mut workspace, deadline, limits_to_rep(limits_from_rep(initial.limits))))?
        return Ok((take register, take initial, take admitted, take authority))
    }
    let created = failure_result_from_rep(history.history_publish_genesis(mut client, store_key_to_rep(store_key_from_rep(id)), store_key_to_rep(holder), authority_kind, authority, mut workspace, deadline, limits_to_rep(limits_from_rep(initial.limits)), None))
    let mut register = match take created {
        Ok(take granted) => take granted,
        Error(Exists(existing)) if existing == "head" => return Error(Lost),
        Error(take problem) => return Error(take problem),
    }
    failure_result_from_rep(host_stream.history_advance_claim(mut client, mut register, authority, mut workspace, deadline))?
    Ok((take register, take initial, take admitted, take authority))
}

// Recover and prepare_writer the state while the incumbent still holds the claim.
// The returned register has already advanced its CLAIM entry.
// With `link`, the head has no ATTACH and the Place is opened streamed
// (§12.11.5, "No ATTACH"): the replace writes ATTACH naming the slot's
// stream, and the CLAIM rides the stream as X's first frame there.
fn history_open_existing[T](mut read_source: history.ObjectPackRead, c: Clock, r: Random, holder: StoreId, take first: history.HistoryCapture, options: Options, requested_levels: List[String], authority_kind: u8, mut workspace: history.HistoryBuffers, mut link: Option[host_stream.SlotLink], prepare_writer: scoped fn(StoreId, u64, bool, std.object.Client, pager.JournalReplay) -> Result[T, Error]) -> Result[(history.HistoryRegister, pager.JournalReplay, T, Bytes), Error] waits {
    let pair = first.head.pair
    let mut selected = take first
    let mut admitted: Option[(history.HistoryHead, pager.JournalReplay)] = None
    let mut entropy = disk_allocation(fn() -> Result[Bytes, Error] {
        Ok(list.with_capacity(8))
    })?
    let mut pause = 10u64
    // The slot's grant (epoch, inc, next seq), taken once for the first head.
    let mut granted: Option[(u64, u64, u64)] = None
    let mut opening: Options = clone(options)
    loop {
        if std.object.deadline_after_ms(read_source.client, 0) >= read_source.deadline {
            return Error(Lost)
        }
        let auth = history_check_open(read_source.client, selected, requested_levels, authority_kind, opening)?
        opening.claim_auth = Some(clone(auth))
        let reserved = cell.get(read_source.direct_floor)
        let trial = match replace(mut admitted, None) {
            Some((base, take replay)) if selected.head.checkpoint.seq <= base.entry.seq => {
                if selected.head.floor < base.floor {
                    return Error(failure_from_rep(format.disk_fault("head", 72, Malformed)))
                }
                history_rebase_suffix(mut read_source, selected.head, base.entry, take replay, options.resident_limit)
            },
            _ => history_load_admitted(mut read_source, selected.head, options.resident_limit),
        }
        let replay = match take trial {
            Error(Changed(_)) if cell.get(read_source.direct_floor) > reserved => continue,
            Ok(take ready) => take ready,
            Error(HistoryMissing(take file, missing_seq)) => {
                let verdict = failure_result_from_rep(history.history_witness(mut read_source.client, selected.head, Some(pair), file, missing_seq, mut workspace.witness, read_source.deadline))?
                match take verdict {
                    HistoryEvicted(take newer) if options.claim_ms != 0 => {
                        selected = take newer
                        continue
                    },
                    HistoryWitnessLost => return Error(history_superseded_by(read_source.client, store_key_from_rep(selected.head.store), workspace.witness)),
                    _ => return Error(Lost),
                }
            },
            Error(take problem) => return Error(take problem),
        }
        failure_result_from_rep(types.check_limits(optional_limits_to_rep(options.limits), replay.limits))?
        let next_epoch = failure_result_from_rep(history.history_next_id(selected.head.pair.epoch))?
        let admitted_state = prepare_writer(store_key_from_rep(selected.head.store), next_epoch, history.has_deferred_pages(read_source.admitted_base), read_source.client, replay)?
        let head = selected.head
        let authority_end = failure_result_from_rep(history.history_authority_end(workspace.witness))?
        let authority = failure_result_from_rep(types.copied(list.slice(workspace.witness, 240, authority_end)))?
        if std.object.deadline_after_ms(read_source.client, 0) >= read_source.deadline {
            return Error(Lost)
        }
        let attach: Option[format.Attach] = match link {
            Some(mut attaching) => {
                let (inc, next_seq) = match granted {
                    // A head moved to another epoch is another claimant's.
                    Some((epoch, inc, next_seq)) => if epoch == head.pair.epoch + 1 {
                        (inc, next_seq)
                    } else {
                        return Error(Lost)
                    },
                    None => {
                        let place_prefix = std.object.bucket_config(read_source.client).prefix
                        let (inc, next_seq) = failure_result_from_rep(host_stream.slot_attach(mut attaching, store_key_to_rep(store_key_from_rep(head.store)), head.pair.epoch + 1, place_prefix, limits_to_rep(limits_from_rep(replay.limits))))?
                        granted = Some((head.pair.epoch + 1, inc, next_seq))
                        (inc, next_seq)
                    },
                }
                Some(format.Attach(settles: 0, live: Some(format.StreamRef(sid: host_stream.slot_sid(attaching), inc, from_seq: next_seq, from_frame: 0)), sealed: list.new()))
            },
            None => None,
        }
        let attempt = history_replace_claim(mut read_source.client, head, holder, auth, mut workspace, read_source.deadline, take attach)?
        match take attempt {
            HistoryClaimed(take result) => {
                let mut register = take result
                if let Some(mut attaching) = link {
                    host_stream.slot_claim_frame(mut workspace.packet, history.register_head(register).pair.epoch, store_key_to_rep(holder))
                    failure_result_from_rep(host_stream.slot_send(attaching, workspace.packet, 0))?
                    match failure_result_from_rep(host_stream.slot_wait(mut attaching, 0)) {
                        Ok(()) => (),
                        Error(Fenced(_)) => return Error(Lost),
                        Error(take problem) => return Error(take problem),
                    }
                } else {
                    failure_result_from_rep(host_stream.history_advance_claim(mut read_source.client, mut register, authority, mut workspace, read_source.deadline))?
                }
                return Ok((take register, take replay, take admitted_state, take authority))
            },
            HistoryClaimMoved(backoff) => {
                if options.claim_ms == 0 {
                    // No retry: a move to another pair names its claimant.
                    let (take moved, _) = failure_result_from_rep(history.history_decode_head_attach(workspace.witness))?
                    if !history.history_pair_matches(moved.head.pair, head.pair) {
                        return Error(history_superseded_by(read_source.client, store_key_from_rep(head.store), workspace.witness))
                    }
                    return Error(Lost)
                }
                selected = failure_result_from_rep(history.history_decode_head(workspace.witness))?
                admitted = Some((head, take replay))
                if backoff {
                    object_writer.history_claim_retry(c, r, mut entropy, pause, read_source.deadline)
                    pause = order.min(pause * 2, 1000)
                }
            },
            HistoryClaimLost => return Error(history_superseded_by(read_source.client, store_key_from_rep(head.store), workspace.witness)),
            HistoryClaimUncertain => return Error(Undecided),
        }
    }
}

fn history_rebase_suffix(mut read_source: history.ObjectPackRead, head: history.HistoryHead, from: pages.HistoryRef, take initial: pager.JournalReplay, ceiling: u64) -> Result[pager.JournalReplay, Error] waits {
    let suffix = failure_result_from_rep(history.history_suffix(mut read_source.client, head, from, read_source.deadline))?
    let mut replay = take initial
    history_apply_suffix(read_source.direct_floor, mut read_source.client, head, from.seq, suffix, mut replay, ceiling, read_source.deadline)?
    Ok(take replay)
}

fn history_open_register(mut read_source: history.ObjectPackRead, c: Clock, r: Random, options: Options, requested_level: String, mut workspace: history.HistoryBuffers, op_ms: u64) -> Result[(history.HistoryRegister, pager.JournalReplay), Error] waits {
    let config = history.object_history_config(std.object.bucket_config(read_source.client), string.from(requested_level))
    let authority = failure_result_from_rep(history.history_config_bytes(config))?
    let mut unattached: Option[host_stream.SlotLink] = None
    let (holder, take selected) = history_open_select(mut read_source, r, options, 1, mut workspace, op_ms, false)?
    let capture = match take selected {
        Some((take current, _)) => Some(take current),
        None => None,
    }
    let (take register, take replay, _, _) = history_open_selected(mut read_source, c, r, options, config.levels, 1, take authority, mut workspace, mut unattached, store_key_from_rep(holder), take capture, fn(_id: StoreId, _epoch: u64, _deferred: bool, _client: std.object.Client, _initial: pager.JournalReplay) -> Result[(), Error] {
        Ok(())
    })?
    Ok((take register, take replay))
}

fn history_open_select(mut read_source: history.ObjectPackRead, r: Random, options: Options, authority_kind: u8, mut workspace: history.HistoryBuffers, op_ms: u64, has_slot: bool) -> Result[(types.StoreKey, Option[(history.HistoryCapture, Option[format.Attach])]), Error] waits {
    let claim_ms = if options.claim_ms == 0 {
        op_ms
    } else {
        options.claim_ms
    }
    read_source.deadline = std.object.deadline_after_ms(read_source.client, claim_ms)
    let observed = failure_result_from_rep(history.history_fetch(mut read_source.client, "head", mut workspace.witness, read_source.deadline))
    let selected = match take observed {
        // Only a streamed opener reads an attached head (§12.11.2).
        Ok(_) => {
            let (take capture, take attached) = failure_result_from_rep(history.history_decode_head_attach(workspace.witness))?
            if has_slot {
                Some((take capture, take attached))
            } else {
                // A stale ClaimAuth is refused `Superseded` before the
                // attachment-mode refusal, so a deposed opener parks.
                if let Some(a) = attached {
                    failure_result_from_rep(manifest.check_expected_store(optional_store_key_to_rep(options.expect), capture.head.store))?
                    failure_result_from_rep(history.history_check_namespace(capture, read_source.client))?
                    let _ = history_check_claim_auth(options, capture.head.pair)?
                    return Error(Attached(optional_host_stream_id_from_rep(format.stream_attached_sid(a))))
                }
                Some((take capture, None))
            }
        },
        Error(Remote(NotFound)) => None,
        Error(take failure) => return Error(take failure),
    }
    if authority_kind == 1 {
        failure_result_from_rep(history.history_check_endpoint(mut read_source.client, read_source.deadline))?
    }
    let holder = failure_result_from_rep(types.capacity(types.disk_identity(r)))?
    Ok((holder, take selected))
}

fn history_open_selected[T](mut read_source: history.ObjectPackRead, c: Clock, r: Random, options: Options, requested_levels: List[String], authority_kind: u8, take genesis_authority: Bytes, mut workspace: history.HistoryBuffers, mut link: Option[host_stream.SlotLink], holder: StoreId, take selected: Option[history.HistoryCapture], prepare_writer: scoped fn(StoreId, u64, bool, std.object.Client, pager.JournalReplay) -> Result[T, Error]) -> Result[(history.HistoryRegister, pager.JournalReplay, T, Bytes), Error] waits {
    match take selected {
        Some(take capture) => history_open_existing(mut read_source, c, r, holder, take capture, options, requested_levels, authority_kind, mut workspace, mut link, prepare_writer),
        None => history_open_genesis(mut read_source.client, r, holder, options, authority_kind, take genesis_authority, mut workspace, read_source.deadline, mut link, prepare_writer),
    }
}

fn history_open_with[T](mut opening: Option[history.ObjectPackRead], c: Clock, r: Random, options: Options, requested_levels: List[String], authority_kind: u8, take genesis_authority: Bytes, mut workspace: history.HistoryBuffers, op_ms: u64, mut link: Option[host_stream.SlotLink], prepare_writer: scoped fn(StoreId, u64, bool, std.object.Client, pager.JournalReplay) -> Result[T, Error]) -> Result[(history.HistoryRegister, pager.JournalReplay, T, Bytes), Error] waits {
    let has_slot = match link {
        Some(_) => true,
        None => false,
    }
    let (holder, take selected) = match opening {
        Some(mut read_source) => history_open_select(mut read_source, r, options, authority_kind, mut workspace, op_ms, has_slot)?,
        None => fail("object open requires a reader"),
    }
    let take capture = match take selected {
        Some((_, Some(_))) => {
            if let Some(mut attaching) = link {
                let initial = option.unwrap(replace(mut opening, None))
                let (take restored, take outcome) = stream_open_attached(take initial, mut attaching, r, store_key_from_rep(holder), options, requested_levels, authority_kind, op_ms, mut workspace, prepare_writer)
                opening = Some(take restored)
                return take outcome
            }
            fail("an attached open requires a slot")
        },
        Some((take captured, None)) => Some(take captured),
        None => None,
    }
    match opening {
        Some(mut read_source) => history_open_selected(mut read_source, c, r, options, requested_levels, authority_kind, take genesis_authority, mut workspace, mut link, store_key_from_rep(holder), take capture, prepare_writer),
        None => fail("object open requires a reader"),
    }
}

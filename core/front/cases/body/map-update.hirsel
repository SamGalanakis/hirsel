// SEM-5: update invokes the callback once at the found entry's value place.
// Missing keys do not invoke f, insert or admit. Cleanup keeps the same owner.
// expect: run counter() = 17
// expect: run owners() = 9 trace 9
fn counter() -> u64 {
    let mut m: Map[u64, u64] = map.new()
    result.unwrap(map.insert(mut m, 1u64, 10u64))
    let mut calls: u64 = 0
    let found = map.update(mut m, 1u64, scoped fn(mut n: u64) -> u64 {
        calls += 1;
        n += 1;
        n
    })
    let value: u64 = match found {
        Some(n) => n,
        None => 0
    }
    let missing = map.update(mut m, 2u64, scoped fn(mut n: u64) -> u64 {
        calls += 100;
        n
    })
    let read: u64 = match map.get(m, 1u64) {
        Some(n) => n,
        None => 0
    }
    if value == 11 && read == 11 && calls == 1 && map.len(m) == 1 && (match missing {
        None => true,
        Some(_) => false
    }) {
        17u64
    } else {
        0
    }
}

resource type Mark {
    id: u64
} drop(m) {
    let _ = m.id
}

fn owners() -> u64 {
    let mut m: Map[u64, Mark] = map.new()
    result.unwrap(map.insert(mut m, 1u64, result.unwrap(Mark(id: 8))))
    option.unwrap(map.update(mut m, 1u64, fn(mut value: Mark) -> u64 {
        value.id += 1;
        value.id
    }))
}

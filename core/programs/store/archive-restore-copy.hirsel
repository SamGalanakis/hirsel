fn restore_output(mut file: HostFile, data: Bytes) -> Result[(), Error] waits {
    match host.write(mut file, data) {
        Ok(()) => Ok(()),
        Error(err) => Error(Io(err.error)),
    }
}

const RESTORE_PACK_CHUNK: u64 = 65536

const RESTORE_PACK_WRITE_SLOTS: u64 = 4

const RESTORE_PACK_IN_FLIGHT_BYTES: u64 = 262144

const RESTORE_PACK_WORKER_BYTES: u64 = RESTORE_PACK_CHUNK + 16384

fn restore_stream_unit(src: std.object.Opener, lane: u64, key: String, mut file: HostFile, parent: StoreId, pack: pages.HistoryRef, object_header: bool, deadline: u64) -> Result[(), Error] waits {
    let mut pos = 0u64
    let mut digest = std.check.start()
    while pos < pack.len {
        let end = pos + order.min(RESTORE_PACK_CHUNK, pack.len - pos)
        let buffer = failure_result_from_rep(manifest.disk_read_buffer(end - pos))?
        let fetched = std.object.read_range_joined(src, lane, std.object.GetRange(key: clone(key), lo: pos, hi: end, buffer: take buffer, deadline))
        let (meta, take raw) = restore_range_result(key, pos, end, take fetched)?
        if meta.size != pack.len {
            return Error(Lost)
        }
        std.check.add(mut digest, raw, 0, list.len(raw))
        if pos == 0 && object_header {
            let ctx = failure_result_from_rep(history.history_object_context(key, store_key_to_rep(parent), 3, pack, raw))?
            let header = failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?
            restore_output(mut file, header)?
            restore_output(mut file, list.slice(raw, 72, list.len(raw)))?
        } else {
            restore_output(mut file, raw)?
        }
        pos = end
    }
    if std.check.finish(digest) != pack.digest {
        return Error(failure_from_rep(format.disk_fault(key, 0, Checksum)))
    }
    Ok(())
}

fn restore_copy_pack(mut src: std.object.Client, dir: Dir, parent: StoreId, inc: Inline[u8, 16], ref: pages.HistoryRef, objects: bool, deadline: u64) -> Result[(), Error] waits {
    restore_copy_pack_read(std.object.opener(src), 0, dir, parent, inc, ref, objects, deadline)
}

fn restore_copy_pack_read(src: std.object.Opener, lane: u64, dir: Dir, parent: StoreId, inc: Inline[u8, 16], ref: pages.HistoryRef, objects: bool, deadline: u64) -> Result[(), Error] waits {
    let key = if objects {
        restore_object_key(parent, inc, "p-", ref)?
    } else {
        format.archive_key(store_key_to_rep(parent), inc, format.archive_log_pack_rel(ref.seq, ref.digest))
    }
    let path = failure_result_from_rep(manifest.paged_pack_path(ref.seq))?
    let mut output = failure_result_from_rep(manifest.disk_io(host.open(dir, path, Write)))?
    restore_stream_unit(src, lane, key, mut output, parent, ref, objects, deadline)?
    failure_result_from_rep(manifest.disk_io(host.sync(mut output)))?
    failure_result_from_rep(manifest.disk_io(host.close(take output)))
}

type RestorePackCopy: send {
    src: std.object.Opener,
    lane: u64,
    dir: Dir,
    parent: StoreId,
    inc: Inline[u8, 16],
    pack: format.ArchivePackRefRep,
    objects: bool,
    deadline: u64
}

fn restore_pack_copy_worker(take job: RestorePackCopy) -> Result[(), Error] waits {
    let RestorePackCopy(src: take src, lane, dir, parent, inc, pack, objects, deadline) = take job
    let ref = pages.HistoryRef(seq: pack.seq, epoch: pack.epoch, len: pack.len, digest: pack.digest)
    restore_copy_pack_read(src, lane, dir, parent, inc, ref, objects, deadline)
}

fn restore_pack_batch_count(packs: List[format.ArchivePackRefRep], start: u64, width: u64) -> u64 {
    let limit = order.min(width, list.len(packs) - start)
    for slot in 1u64 .. limit {
        for earlier in 0u64 .. slot {
            if packs[start + earlier].seq == packs[start + slot].seq {
                return slot
            }
        }
    }
    limit
}

fn restore_copy_packs(tasks: Tasks, src: std.object.Opener, dir: Dir, parent: StoreId, inc: Inline[u8, 16], packs: List[format.ArchivePackRefRep], objects: bool, deadline: u64) -> Result[(), Error] waits {
    // Each worker owns a file and at most one live range buffer until it
    // writes it. Reserve a full chunk per slot even for a short final range.
    let width = order.min(std.object.range_lanes(src), order.min(RESTORE_PACK_WRITE_SLOTS, RESTORE_PACK_IN_FLIGHT_BYTES / RESTORE_PACK_CHUNK))
    let mut batch_start = 0u64
    while batch_start < list.len(packs) {
        // A repeated ordinal must never have two writers to the same path.
        let batch_count = restore_pack_batch_count(packs, batch_start, width)
        let mut active: List[Task[Result[(), Error]]] = list.with_capacity(batch_count)
        for lane in 0u64 .. batch_count {
            let job = RestorePackCopy(src: std.object.share_opener(src), lane, dir, parent, inc, pack: packs[batch_start + lane], objects, deadline)
            let worker = task.try_spawn(tasks, bytes RESTORE_PACK_WORKER_BYTES, take job, restore_pack_copy_worker) ?=> |(room, _)| Full(Allocation(room))
            list.push(mut active, take worker)
        }
        // Join in archive order to preserve the first failure. On cancellation,
        // dropping the remaining handles cancels and joins them before unwind.
        let mut first: Result[(), Error] = Ok(())
        for take worker in take active {
            let done = match task.join(take worker) {
                Ok(take result_copy) => take result_copy,
                Error(Failed(causes)) => match manifest.raised_capacity(causes) {
                    Some(room) => Error(Full(Allocation(room))),
                    None => Error(Io(Closed)),
                },
                Error(Cancelled(_)) => Error(Io(Closed)),
            }
            if let Ok(()) = first {
                first = take done
            }
        }
        (take first)?
        batch_start += batch_count
    }
    Ok(())
}

fn restore_copy_log(mut src: std.object.Client, dir: Dir, parent: StoreId, inc: Inline[u8, 16], row: format.ArchiveBaseRowRep, b: manifest.RestoreBoundary, deadline: u64) -> Result[(u64, u64), Error] waits {
    restore_copy_log_read(std.object.opener(src), dir, parent, inc, row, b, deadline)
}

fn restore_copy_log_read(src: std.object.Opener, dir: Dir, parent: StoreId, inc: Inline[u8, 16], row: format.ArchiveBaseRowRep, b: manifest.RestoreBoundary, deadline: u64) -> Result[(u64, u64), Error] waits {
    let mut seq = row.first_unit
    loop {
        let path = failure_result_from_rep(manifest.journal_path(seq, ""))?
        let mut output = failure_result_from_rep(manifest.disk_io(host.open(dir, path, Write)))?
        let limit = if seq < b.unit {
            restore_sealed_end_read(src, parent, inc, seq + 1, deadline)?
        } else {
            b.frame_end
        }
        if limit == 0 {
            let ctx = format.DiskContext(store: store_key_to_rep(parent), role: 2, seq)
            restore_output(mut output, failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0)))?)?
        }
        let mut pos = 0u64
        while pos < limit {
            let key = restore_segment_key(parent, inc, seq, pos)
            let (meta, _) = restore_range_read(src, key, 0, 1, deadline)?
            let mut offset = 0u64
            let mut digest = std.check.start()
            while offset < meta.size {
                let hi = offset + order.min(65536u64, meta.size - offset)
                let (part, take raw) = restore_range_read(src, key, offset, hi, deadline)?
                if part.etag != meta.etag {
                    return Error(Lost)
                }
                std.check.add(mut digest, raw, 0, list.len(raw))
                let width = order.min(list.len(raw), int.saturating_sub(limit - pos, offset))
                if width > 0 {
                    restore_output(mut output, list.slice(raw, 0, width))?
                }
                offset = hi
            }
            if seq == b.unit && meta.size >= limit - pos && std.check.finish(digest) != b.unit_digest {
                return Error(failure_from_rep(format.disk_fault(key, pos, Checksum)))
            }
            pos += order.min(meta.size, limit - pos)
        }
        failure_result_from_rep(manifest.disk_io(host.sync(mut output)))?
        failure_result_from_rep(manifest.disk_io(host.close(take output)))?
        if seq == b.unit {
            return Ok((seq, order.max(72u64, limit)))
        }
        seq += 1
    }
}

fn restore_copy_archive(tasks: Tasks, mut src: std.object.Client, dir: Dir, point: RestorePoint, op_ms: u64) -> Result[ExportStamp, DeployError] waits {
    let parent = point.token.parent
    let id = store_key_to_rep(parent)
    let b = point.token.boundary
    let due = std.object.deadline_after_ms(src, op_ms)
    let Some((take head, _)) = deploy_result(failure_result_from_rep(history.archive_head_fetch(mut src, id, due)))? else {
        return Error(Store(Lost))
    }
    if head.binding_id != point.token.binding_id {
        return Error(Store(Foreign))
    }
    if let Some(floor) = view head.floor_base {
        if b.base_ordinal < floor.base_ordinal {
            return Error(Expired)
        }
    }
    let copied = restore_copy_covered(tasks, mut src, dir, point, head, due)
    match take copied {
        Error(Store(Remote(NotFound))) => (),
        Error(Store(HistoryMissing(_, _))) => (),
        result_copy => return take result_copy,
    }
    let Some((take new_head, _)) = deploy_result(failure_result_from_rep(history.archive_head_fetch(mut src, id, due)))? else {
        return Error(Store(Lost))
    }
    if new_head.binding_id != point.token.binding_id {
        return Error(Store(Foreign))
    }
    if let Some(floor) = new_head.floor_base {
        if b.base_ordinal < floor.base_ordinal {
            return Error(Expired)
        }
    }
    Error(Store(Lost))
}

fn restore_copy_covered(tasks: Tasks, mut src: std.object.Client, dir: Dir, point: RestorePoint, head: format.ArchiveHeadRep, due: u64) -> Result[ExportStamp, DeployError] waits {
    let inc = head.incarnation
    let parent = point.token.parent
    let id = store_key_to_rep(parent)
    let b = point.token.boundary
    let chain_index = deploy_result(failure_result_from_rep(history.archive_restore_index(mut src, head, due)))?
    let mut found: Option[format.ArchiveBaseRowRep] = None
    let objects = b.source_kind == format.ARCHIVE_SOURCE_OBJECTS
    for page_ref in chain_index.pages {
        let page = deploy_result(failure_result_from_rep(history.archive_index_page(mut src, id, head.incarnation, head.source_kind, page_ref, due)))?
        for row in page.bases {
            if row.base_ordinal == b.base_ordinal && row.digest == b.base_digest {
                if !row.pack_continuation {
                    found = Some(format.archive_base_summary(row))
                }
                deploy_result(restore_copy_packs(tasks, std.object.opener(src), dir, parent, inc, row.packs, objects, due))?
            }
        }
    }
    let Some(take row) = take found else {
        return Error(Store(Lost))
    }
    let (take m, evidence) = deploy_result(restore_archive_manifest(mut src, parent, inc, head.source_kind, row, due))?
    if evidence.number != point.activation || evidence.binding != point.binding {
        return Error(ExportMismatch)
    }
    let (terminal, end) = if objects {
        deploy_result(restore_copy_entries(mut src, dir, parent, inc, row, b, due))?
    } else {
        deploy_result(restore_copy_log(mut src, dir, parent, inc, row, b, due))?
    }
    deploy_result(restore_direct_prefix(dir, id, m.first_live, terminal, end, objects, scoped fn(place: format.DirectBlob) -> Result[Bytes, Error] waits {
        let rel = failure_result_from_rep(history.archive_direct_rel(objects, place))?
        restore_archive_bytes(mut src, format.archive_key(id, inc, rel), history.direct_history_ref(place), due)
    }))?
    let mut nonce: Bytes = list.with_capacity(16)
    list.fill(mut nonce, 16, 0u8)
    let stamp = ExportStamp(attempt: take nonce, store_hi: id.hi, store_lo: id.lo, opened: terminal, branch: 0, head: point.main_version, next_table: m.next_table, activation: point.activation, binding: export_binding_bytes(point.binding), terminal, end)
    restore_scratch_manifest(dir, id, take m, stamp)?
    Ok(take stamp)
}

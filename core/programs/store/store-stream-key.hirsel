pub const SUBJECT_MAX: u64 = 64u64

pub fn parse_stream_key(raw: Bytes) -> Option[StreamKeyRep] {
    if list.len(raw) < 18u64 {
        return None
    }
    let size: u64 = int.widen(raw[1u64])
    if size > SUBJECT_MAX || list.len(raw) != size + 18u64 {
        return None
    }
    let mut at = size + 2u64
    let t = result.unwrap(std.codec.take_key_u64(raw, mut at))
    let n = result.unwrap(std.codec.take_key_u64(raw, mut at))
    let subject: Bytes = clone(list.slice(raw, 2u64, size + 2u64))
    Some(StreamKeyRep(caller: CallerRep(issuer: raw[0u64], subject: take subject), id: StreamIdRep(t, n)))
}

pub fn stream_record_matches(raw: Bytes, issuer: u8, subject: Bytes, t: u64, n: u64) -> bool {
    let size = list.len(subject)
    list.len(raw) == size + 18u64 && raw[0u64] == issuer && raw[1u64] == int.truncate(size) && list.starts_with_at(raw, 2u64, subject) && word_be(raw, size + 2u64) == t && word_be(raw, size + 10u64) == n
}

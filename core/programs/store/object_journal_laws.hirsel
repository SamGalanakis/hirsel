fn object_fresh_holder_law(c: Clock, r: Random, tasks: Tasks, sim: BucketSim) -> Result[(), Error] waits {
    let first = bucket_law_client_with(sim, tasks, "s3.test", 1, true)?
    let mut options = result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64))
    options.group_bytes = 65536
    options.head_poll_ms = 10000
    let mut writer = open_authority(tasks, object_authority(take first, "bucket", BUCKET_LAW_OP_MS), c, r, options)?
    let (notify, notifications): (Sender[u64], Receiver[u64]) = channel.new(1)
    on_unhealthy(mut writer, take notify, 17u64)?
    let deadline = clock.deadline_after_ms(host.mono_ns(sim.time), BUCKET_LAW_OP_MS)
    let initial = fresh_snapshot(mut writer, deadline)?
    if version(initial) != 0 { fail("304 altered the holder's durable snapshot") }
    if let Ok(0) = health(writer) {} else { fail("unchanged HEAD altered writer health") }
    let successor_client = bucket_law_client_with(sim, tasks, "s3.test", 2, true)?
    let successor = open_authority(tasks, object_authority(take successor_client, "bucket", BUCKET_LAW_OP_MS), c, r, options)?
    if let Error(Fenced(1)) = fresh_snapshot(mut writer, deadline) {} else {
        fail("fresh holder query accepted a new claim")
    }
    let notice = result.unwrap(channel.receive(notifications))
    if notice != 17 { fail("the terminal health notice changed its payload") }
    if let Fenced(1) = health(writer) {} else { fail("the notified fence was not published") }
    if let Error(Fenced(1)) = close(take writer) {} else {
        fail("holder close lost the fresh query fence")
    }
    if let Error(Closed) = channel.try_receive(notifications) {} else {
        fail("terminal health subscription sent twice or stayed open")
    }
    close(take successor)
}


fn bucket_m2_law_recover(tasks: Tasks, sim: BucketSim) -> Result[(), Error] waits {
    let _ = bucket_m2_law_register(tasks, sim)?
    let mut client = bucket_law_client(sim, tasks, "s3.test", 3)?
    let due = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    let mut head_buf: Bytes = list.with_capacity(history.HISTORY_HEAD_LIMIT)
    let _ = failure_result_from_rep(history.history_fetch(mut client, "head", mut head_buf, due))?
    let captured = failure_result_from_rep(history.history_decode_head(head_buf))?
    let history_head = captured.head
    let mut source = history.history_reader(take client, due)
    let replay = history_paged_capture(mut source, history_head, 1048576)?
    if replay.state.tips[0].head != 1 {
        fail("recovery did not apply exactly the published suffix")
    }
    Ok(())
}


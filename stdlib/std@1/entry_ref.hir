// Entry references (RUN-3): an entry's path and signature fingerprint as data,
// so a stored row can name an entry. A reference is inert and grants nothing;
// only an `Entry` the program already holds runs, and `resolve` returns one of
// the entries it is given, never another.

/// An entry's full versioned path and signature fingerprint.
@serializable
pub type EntryRef {
  path: String,
  fingerprint: Bytes,
}

/// The reference that names `f`.
pub fn reference[F](f: Entry[F]) -> EntryRef uses {} {
  let id = core@1/runner.entry_id(f)
  EntryRef(path: copy id.path, fingerprint: copy id.fingerprint)
}

/// The entry of `among` with `r`'s path and fingerprint, or `None()`. A
/// reference to an entry that moved, or whose signature changed, names no
/// entry of `among` and resolves to `None()`.
pub fn resolve[F](r: EntryRef, among: List[Entry[F]]) -> Option[Entry[F]] uses {} {
  for e in among {
    let id = core@1/runner.entry_id(e)
    if id.path == r.path && id.fingerprint == r.fingerprint {
      return Some(e)
    }
  }
  None()
}

pub fn page_limits(rows: u64, byte_limit: u64) -> Result[(), types.Failure] {
    if rows == 0 {
        return Error(Missing("rows"))
    }
    if byte_limit == 0 {
        return Error(Missing("bytes"))
    }
    Ok(())
}

pub fn read_snapshot_collection_page[K, V, R: shareable + send](r: ReaderState, data: pages.PageTree, opened: u64, branch: u32, source: u32, decoder: RowDecoder[K, R], take low: std.omap.Bound[Bytes], take high: Bytes, row_limit: u64, byte_limit: u64, decode: fn(R, u32, Bytes) -> Result[V, types.Failure]) -> Result[SnapshotPage[K, V], types.Failure] waits {
    if let Some(inventory) = view data.paging {
        let id = catalog.prefix(source)?
        if let Some((edge, descriptor)) = std.page.collection_slot(data.root, id) {
            let tiered_rows = pages.collection_descriptor(descriptor).residency == ResidentTiered
            let tiered_owner = if source == decoder.table {
                false
            } else {
                let owner = std.page.lookup(data.root, catalog.prefix(decoder.table)?)
                match owner {
                    Some(record) => pages.collection_descriptor(record).residency == ResidentTiered,
                    None => false
                }
            }
            if tiered_rows || tiered_owner {
                let (take input, take grant, root) = snapshot_pager(r, inventory, opened, branch, pages.tree_stamp(data))?
                let start = scan_page_start(low, id)?
                if list.len(start) < 4 || start >= high {
                    return Ok(SnapshotPage(rows: list.new(), byte_count: 0, next: None))
                }
                let hint = list.slice(start, 4, list.len(start))
                let edits = match data.replay {
                    Some(replay) => std.omap.get(replay.collections, source),
                    None => None,
                }
                return retry_tiered_read(input, grant, root, hint, None, TieredForward, scoped fn(attempt: core.Cell[pager.TieredTouchSet], visible: Map[pager.TieredCacheKey, Arc[format.TieredFrame]]) -> Result[SnapshotPage[K, V], types.Failure] {
                    let mut walk = ()
                    read_snapshot_page(types.copied(high)?, row_limit, byte_limit, mut walk, scoped fn(mut _walk: (), previous: Option[Bytes], full: bool, remaining: Option[u64]) -> Result[SnapshotPageStep[K, V], types.Failure] {
                        let found = if tiered_rows {
                            if let Some(last_key) = previous {
                                let after = pager.scan_page_after(last_key)?
                                pager.tiered_scan_row(attempt, visible, edge, source, edits, after, high, false)?
                            } else {
                                pager.tiered_scan_row(attempt, visible, edge, source, edits, start, high, false)?
                            }
                        } else {
                            let mut cursor = resume_data(data, start, high, previous, false)?
                            catalog.next_bytes(mut cursor)?
                        }
                        let Some((take key, raw)) = take found else {
                            return Ok(PageEnd)
                        }
                        if full {
                            return Ok(PageLimit)
                        }
                        let row = tiered_snapshot_row(attempt, visible, data, decoder, key, raw, remaining, decode)?
                        Ok(snapshot_page_step(take key, take row))
                    })
                })
            }
        }
    }
    let start = scan_page_start(low, catalog.prefix(source)?)?
    let Some(take initial) = catalog.collection_cursor(data, source, start, high, false)? else {
        return Ok(SnapshotPage(rows: list.new(), byte_count: 0, next: None))
    }
    let mut cursor = take initial
    let leading = catalog.prefix(source)?
    read_snapshot_page(take high, row_limit, byte_limit, mut cursor, scoped fn(mut current: pages.CollectionCursor, previous: Option[Bytes], full: bool, remaining: Option[u64]) -> Result[SnapshotPageStep[K, V], types.Failure] {
        let stepped = std.page.cursor_read(mut current.walk, scoped fn(suffix: Bytes, raw: Bytes) -> Result[SnapshotPageStep[K, V], types.Failure] {
            if full {
                return Ok(PageLimit)
            }
            let key = pages.collection_row_key(leading, suffix)
            let row = advance_rows(decoder, data, key, raw, remaining, decode, fn(observed: Bytes) -> Result[(), types.Failure] {
                Ok(())
            })?
            Ok(snapshot_page_step(take key, take row))
        })
        match take stepped {
            Some(take step) => take step,
            None => Ok(PageEnd),
        }
    })
}

fn scan_page_start(low: std.omap.Bound[Bytes], id: Bytes) -> Result[Bytes, types.Failure] {
    match low {
        Included(key) => types.copied(key),
        Excluded(key) => pager.scan_page_after(key),
        Unbounded => types.copied(id),
    }
}

type SnapshotPageStep[K, V] = PageEnd | PageLimit | PageValue(Bytes, (K, V), u64)

fn snapshot_page_step[K, V](take key: Bytes, take row: Option[((K, V), u64)]) -> SnapshotPageStep[K, V] {
    match take row {
        Some((take value, size)) => PageValue(take key, take value, size),
        None => PageLimit,
    }
}

fn read_snapshot_page[K, V, W](take high: Bytes, row_limit: u64, byte_limit: u64, mut walk: W, advance: scoped[view] fn(mut W, Option[Bytes], bool, Option[u64]) -> Result[SnapshotPageStep[K, V], types.Failure]) -> Result[SnapshotPage[K, V], types.Failure] {
    let mut page: List[(K, V)] = list.new()
    let mut byte_count = 0u64
    let mut final_item: Option[Bytes] = None
    while true {
        let full = list.len(page) == row_limit
        let remaining: Option[u64] = if list.len(page) == 0 {
            None
        } else {
            Some(int.saturating_sub(byte_limit, byte_count))
        }
        match advance(mut walk, final_item, full, remaining)? {
            PageEnd => return Ok(SnapshotPage(rows: take page, byte_count: byte_count, next: None)),
            PageLimit => break,
            PageValue(take key, take value, size) => {
                list.push(mut page, take value)
                byte_count += size
                final_item = Some(take key)
            },
        }
    }
    let resume = match take final_item {
        Some(take key) => Some((take high, take key)),
        None => None
    }
    Ok(SnapshotPage(rows: take page, byte_count: byte_count, next: take resume))
}

pub type SnapshotPage[K, V] {
    rows: List[(K, V)],
    byte_count: u64,
    next: Option[(Bytes, Bytes)]
}

// M3b-S5 (§13.10a "Lifts"): a hot Migrate on a Tiered log@1 store lifts
// everything except a Tiered build, which refuses `Tiered(Migrate)` until
// lane 3224 gives it a mechanism. Fixture: log@1, table `rows` u64 -> u64
// seeded with `k % 97`, then `set_residency(Tiered)`.
fn hot_options(dirty: u64) -> Result[Options, Error] {
    let mut overrides = derived_sizes()
    overrides.resident_limit = Some(268435456u64)
    overrides.writer_pin_bytes = Some(34471936u64)
    overrides.cache_bytes = Some(80u64 * 1048576u64)
    if dirty != 0 {
        overrides.dirty_bytes = Some(dirty)
    }
    Ok(sized_with(Directory, 2147483648u64, overrides) ?=> |_| Missing("hot migrate sizing"))
}

fn hot_seed(mut db: Db, n: u64) -> Result[Table[u64, u64], Error] waits {
    let mut decl = declare(db, Migrate)?
    let rows_decl = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = finish(mut decl, take rows_decl)?
    let other_decl = declare_table(mut decl, "other", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut decl, take other_decl)?
    let _ = seal(mut db, take decl)?
    let fixture: Table[u64, u64] = clone(rows)
    let Committed(_) = run(mut db, None, copy_env((fixture, n)), fn(mut tx: Tx, env: (Table[u64, u64], u64)) -> Result[(), Error] {
        for k in 0u64 .. env.1 {
            put(mut tx, env.0, k, k % 97)?
        }
        Ok(())
    })? else {
        fail("hot migrate: seed did not commit")
    }
    set_residency(mut db, rows.id, Tiered)?
    let _ = checkpoint(mut db)?
    Ok(rows)
}

// The rows of `name`, each checked against the seed's `k % 97`.
fn hot_rows(mut db: Db, name: String, n: u64) -> Result[(), Error] waits {
    let t = table(mut db, name, std.codec.key_u64(), std.codec.of_u64())?
    let Committed(Done(value: ok, ..)) = run(mut db, Some(100000000u64), copy_env((t, n)), fn(mut tx: Tx, env: (Table[u64, u64], u64)) -> Result[bool, Error] {
        for k in 0u64 .. env.1 {
            if fetch(tx, env.0, k)? != Some(k % 97) {
                return Ok(false)
            }
        }
        Ok(count(tx, env.0, Unbounded, Unbounded)? == env.1)
    })? else {
        fail("hot migrate: read did not commit")
    }
    if !ok {
        fail("hot migrate: the seeded rows changed")
    }
    Ok(())
}

fn hot_migrate(mut phase: Migration) -> Result[(), Error] {
    migrate_table(mut phase, "rows", std.codec.key_u64(), std.codec.of_u64(), "moved", std.codec.key_u64(), std.codec.of_u64(), fn(k: u64, v: u64) -> Result[Option[(u64, u64)], Capacity] {
        Ok(Some((k, v)))
    })
}

// A hot Tiered `migrate_table` would queue a DeferredMigrate nobody runs.
// Red on a663f742: run_migration published an empty `moved` and removed
// `rows` from the catalog (every row lost).
@test
fn tiered_hot_migrate_table_refused(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, hot_options(0)?)?
    let _ = hot_seed(mut db, 500)?
    let before = refusal_directory(d)
    if let Error(Tiered(Migrate)) = run_migration(mut db, tasks, code.describe(hot_migrate)) {} else {
        fail("hot migrate: a Tiered migrate_table was not Tiered(Migrate)")
    }
    if !refusal_directory_unchanged(d, before) {
        fail("hot migrate: the refused migration changed the store directory")
    }
    close(take db)?
    let mut again = open(tasks, d, c, r, hot_options(0)?)?
    hot_rows(mut again, string.from("rows"), 500)?
    if let Ok(_) = table(mut again, "moved", std.codec.key_u64(), std.codec.of_u64()) {
        fail("hot migrate: the refused target exists after reopen")
    }
    close(take again)
}

// A new index on a Tiered table would build through seal's child cut on the
// live directory. Red on a663f742: past `dirty_bytes` the build's packs
// collided with the publishing cut's, and reopen was `Corrupt` p-6.
@test
fn tiered_hot_index_build_refused(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, hot_options(65536)?)?
    let _ = hot_seed(mut db, 6000)?
    let before = refusal_directory(d)
    let mut decl = declare(db, Migrate)?
    let mut rows_decl = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    if let Error(Tiered(Migrate)) = index(mut decl, mut rows_decl, "by_v", Many, code.describe(crash_value), std.codec.key_u64()) {} else {
        fail("hot migrate: a new index on a Tiered table was not Tiered(Migrate)")
    }
    let _ = take rows_decl
    let _ = take decl
    if !refusal_directory_unchanged(d, before) {
        fail("hot migrate: the refused index changed the store directory")
    }
    let _ = checkpoint(mut db)?
    close(take db)?
    let mut again = open(tasks, d, c, r, hot_options(65536)?)?
    hot_rows(mut again, string.from("rows"), 6000)?
    let mut check = declare(again, Open)?
    let rows_decl2 = declare_table(mut check, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut check, take rows_decl2)?
    let other_decl = declare_table(mut check, "other", std.codec.key_u64(), std.codec.of_u64())?
    let _ = finish(mut check, take other_decl)?
    let _ = seal(mut again, take check)?
    close(take again)
}

fn l70_rename(mut phase: Migration) -> Result[(), Error] {
    let listed = list_collections(phase)?
    if list.len(listed) != 2 {
        fail("L70(c): list_collections on a Tiered store")
    }
    rename_table(mut phase, "rows", "renamed")
}

fn l70_drop(mut phase: Migration) -> Result[(), Error] {
    drop_named_table(mut phase, "renamed")
}

fn l70_noop(mut _phase: Migration) -> Result[(), Error] {
    Ok(())
}

// L70 revised (§13.10a "Lifts", v2.169): on log@1, a hot Migrate that needs
// no Tiered build, export and install of a Tiered store succeed; objects@1
// `set_residency` stays `Tiered(Install)`. Red on main before M3b-S5: every
// step here was `Tiered(Migrate)` or `Tiered(Install)`.
@test
fn tiered_l70_refusals(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let store_dir = disk_test_directory(d)
    let scratch = disk_test_directory(d)
    let memory_db = memory(c, r, result.unwrap(sized(Memory, 1074790400u64)))
    if let Error(Tiered(Memory)) = require_tiered_storage(memory_db) {} else {
        fail("L70(c): expected Tiered(Memory) for memory residency")
    }
    if let Error(Tiered(Authority)) = require_archive_authority(memory_db) {} else {
        fail("L70(c): expected Tiered(Authority) for memory archive")
    }
    close(take memory_db)?
    let mut db = open(tasks, store_dir, c, r, hot_options(0)?)?
    let _ = hot_seed(mut db, 300)?
    if let Error(Tiered(Authority)) = require_archive_authority(db) {} else {
        fail("L70(c): expected Tiered(Authority) for log archive")
    }
    run_migration(mut db, tasks, code.describe(l70_rename))?
    hot_rows(mut db, string.from("renamed"), 300)?
    let export_attempt = b"l70-export-lift!"
    let scratch_before = refusal_directory(scratch)
    let leased_job = match begin_export_copy(mut db, scratch, failure_result_from_rep(types.copied(export_attempt))?, 0) {
        Ok(take job) => take job,
        Error(_) => fail("L70(c): expected log@1 Tiered export lease to succeed"),
    }
    let _ = take leased_job
    release_export(mut db, export_attempt)
    if !refusal_directory_unchanged(scratch, scratch_before) {
        fail("L70(c): export lease changed scratch before export_copy")
    }
    let staged = stage_migration(db, tasks, code.describe(l70_noop))?
    install_activation(mut db, take staged)?
    close(take db)?
    let mut again = open(tasks, store_dir, c, r, hot_options(0)?)?
    hot_rows(mut again, string.from("renamed"), 300)?
    run_migration(mut again, tasks, code.describe(l70_drop))?
    if let Ok(_) = table(mut again, "renamed", std.codec.key_u64(), std.codec.of_u64()) {
        fail("L70(c): the dropped Tiered table is still listed")
    }
    let _ = checkpoint(mut again)?
    close(take again)?
    let reopened = open(tasks, store_dir, c, r, hot_options(0)?)?
    close(take reopened)?
    let s = bucket_law_sim(tasks, c, 72, None, list.new())
    let opened = bucket_order_open(tasks, r, s.time, s.endpoint, 72, true)
    let mut ob = match take opened {
        Ok(take found) => take found,
        Error(take problem) => {
            let _ = bucket_law_report(take s)
            return Error(take problem)
        },
    }
    let mut decl = declare(ob, Migrate)?
    let t_decl = declare_table(mut decl, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let t = finish(mut decl, take t_decl)?
    let _ = seal(mut ob, take decl)?
    let head = version(snapshot(ob))
    let refused = set_residency(mut ob, t.id, Tiered)
    let after = version(snapshot(ob))
    let closed = close(take ob)
    let _ = bucket_law_report(take s)
    closed?
    if let Error(Tiered(Install)) = refused {} else {
        fail("L70(c): objects@1 set_residency was not Tiered(Install)")
    }
    if head != after {
        fail("L70(c): the refused objects@1 set_residency moved the head")
    }
    Ok(())
}

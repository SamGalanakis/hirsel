// ADAPTED from httparse a0fa552e src/lib.rs: request/status line, strict
// header tokens, opaque field values, optional whitespace, CRLF or LF.
// Offsets replace borrowed slices. No body parsing and no I/O.
pub type Span: key {
    start: u64,
    end: u64
}

pub type Header {
    name: Span,
    value: Span
}

pub type Head {
    method: Span,
    target: Span,
    version: u8,
    status: u16,
    reason: Span,
    fields: Inline[Header, 64],
    count: u64,
    end: u64
}

pub type Progress: key = Partial | Complete | Bad | TooLarge

// The caller retains the growing buffer, Head and Cursor until completion.
// No offsets or fields are rediscovered after a fragment boundary.
type Scan: key = Leading | LeadingLf | Method | Target | Version | RequestEnd | RequestLf | FieldStart | Name | Value | FieldLf | EndLf

pub type Cursor {
    state: Scan,
    offset: u64,
    line_end: u64,
    line_start: u64,
    start: u64,
    name_end: u64,
    value_start: u64,
    value_end: u64,
    part: u64,
    utf8_left: u8,
    utf8_low: u8,
    utf8_high: u8,
    examined: u64,
    result: Progress
}

/// Starts a request scan beside a fresh head. examined counts actual byte reads.
/// Ex: `let mut cur = http1.cursor()`.
pub fn cursor() -> Cursor {
    Cursor(state: Leading, offset: 0, line_end: 0, line_start: 0, start: 0, name_end: 0, value_start: 0, value_end: 0, part: 0, utf8_left: 0, utf8_low: 128, utf8_high: 191, examined: 0, result: Partial)
}

fn finish_field(mut h: Head, mut cur: Cursor) {
    h.fields[h.count] = Header(name: Span(start: cur.start, end: cur.name_end), value: Span(start: cur.value_start, end: cur.value_end))
    h.count += 1
}

fn target_byte(c: u8, mut cur: Cursor) -> bool {
    if cur.utf8_left > 0 {
        if c < cur.utf8_low || c > cur.utf8_high {
            return false
        }
        cur.utf8_left -= 1
        cur.utf8_low = 128
        cur.utf8_high = 191
        return true
    }
    if c < 128 {
        return c >= 33 && c != 127
    }
    cur.utf8_low = 128
    cur.utf8_high = 191
    let Some(shape) = string.utf8_head(c) else {
        return false
    }
    cur.utf8_left = int.narrow(shape.width - 1)
    cur.utf8_low = shape.low
    cur.utf8_high = shape.high
    true
}

// The component owns its ASCII run until a separator, invalid byte, or
// fragment boundary. Other token bytes use the full RFC 9110 classifier.
fn scan_token(b: Bytes, first: u8, start: u64, limit: u64, separator: u8) -> (u64, Progress) {
    let mut c = first
    let mut next = start
    loop {
        let lower = c | 0x20
        if lower < b'a' || lower > b'z' {
            if c == separator {
                return (next, Complete)
            }
            if !token(c) {
                return (next, Bad)
            }
        }
        if next == limit {
            return (next, Partial)
        }
        c = b[next]
        next += 1
    }
}

/// Resumes over a growing buffer whose examined prefix has not changed.
/// Initialize h with head() and cur with cursor(), once per request. Terminal
/// results are sticky. Each head byte is read once; no allocation or I/O.
/// Ex: `http1.resume(b, mut h, mut cur)`.
pub fn resume(b: Bytes, mut h: Head, mut cur: Cursor) -> Progress {
    if cur.result != Partial {
        return cur.result
    }
    let limit = order.min(8192, list.len(b))
    let mut next = cur.offset
    let mut state = cur.state
    let mut result: Progress = Partial
    while next < limit {
        let at = next
        let c = b[at]
        next += 1
        match state {
            Leading => {
                if c == 13 {
                    state = LeadingLf
                } else if c == 10 {
                    cur.line_start = next
                } else {
                    if !token(c) {
                        result = Bad
                    } else {
                        cur.start = at
                        state = Method
                    }
                }
            },
            LeadingLf => {
                if c != 10 {
                    result = Bad
                } else {
                    cur.line_start = next
                    state = Leading
                }
            },
            Method => {
                let (stop, scanned) = scan_token(b, c, next, limit, b' ')
                next = stop
                if scanned == Complete {
                    h.method = Span(start: cur.start, end: next - 1)
                    cur.start = next
                    state = Target
                } else {
                    result = scanned
                }
            },
            Target => {
                if c == b' ' && cur.utf8_left == 0 {
                    if at == cur.start {
                        result = Bad
                    } else {
                        h.target = Span(start: cur.start, end: at)
                        cur.part = 0
                        if next + 8 <= limit {
                            // The version is one little-endian word. Ignore
                            // only the bit distinguishing HTTP/1.0 and 1.1.
                            let word = list.word_le(b, next)
                            let mismatch = (word & 0xfeffffffffffffff) ^ 0x302e312f50545448
                            if mismatch == 0 {
                                let minor: u8 = int.truncate(word >> 56)
                                h.version = minor - b'0'
                                cur.part = 7
                                next += 8
                                state = RequestEnd
                            } else {
                                // Keep the first bad byte as the cursor's stop,
                                // while charging every byte in the loaded word.
                                let bit: u64 = int.widen(int.trailing_zeros(mismatch))
                                let scanned = (bit >> 3) + 1
                                cur.part = order.min(scanned, 7)
                                cur.examined += 8 - scanned
                                next += scanned
                                state = Version
                                result = Bad
                            }
                        } else {
                            state = Version
                        }
                    }
                } else if !target_byte(c, mut cur) {
                    result = Bad
                }
            },
            Version => {
                let prefix = string.as_bytes("HTTP/1.")
                let mut part = cur.part
                let mut version_byte = c
                loop {
                    if part >= 7 {
                        if version_byte == b'0' || version_byte == b'1' {
                            h.version = version_byte - b'0'
                            state = RequestEnd
                        } else {
                            result = Bad
                        }
                        break
                    }
                    let expected = prefix[part]
                    part += 1
                    if version_byte != expected {
                        result = Bad
                        break
                    }
                    if next == limit {
                        break
                    }
                    version_byte = b[next]
                    next += 1
                }
                cur.part = part
            },
            RequestEnd => {
                if c == 13 {
                    state = RequestLf
                } else if c == 10 {
                    cur.line_end = next
                    state = FieldStart
                } else {
                    result = Bad
                }
            },
            RequestLf => {
                if c == 10 {
                    cur.line_end = next
                    state = FieldStart
                } else {
                    result = Bad
                }
            },
            FieldStart => {
                if c == 13 {
                    state = EndLf
                } else if c == 10 {
                    h.end = next
                    result = Complete
                } else if h.count == 64 {
                    result = TooLarge
                } else if token(c) {
                    cur.start = at
                    state = Name
                } else {
                    result = Bad
                }
            },
            Name => {
                let (stop, scanned) = scan_token(b, c, next, limit, b':')
                next = stop
                if scanned == Complete {
                    cur.name_end = next - 1
                    cur.value_start = next
                    cur.value_end = next
                    state = Value
                } else {
                    result = scanned
                }
            },
            Value => {
                let mut start = cur.value_start
                let mut end = cur.value_end
                let mut value = c
                'value_bytes: loop {
                    if value == 13 || value == 10 {
                        state = if value == 13 {
                            FieldLf
                        } else {
                            FieldStart
                        }
                        break
                    }
                    if value < 32 && value != 9 || value == 127 {
                        result = Bad
                        break
                    }
                    if value == b' ' || value == 9 {
                        // An empty span still tracks the first possible value byte.
                        if start == end {
                            start = next
                            end = next
                        }
                    } else {
                        end = next
                    }
                    // Visit common value bytes in full eight-byte groups.
                    // Stop the group on the first exceptional byte, so a
                    // field or head terminator never reads into the next one.
                    while next + 8 <= limit {
                        let begin = next
                        for _ in 0u64 .. 8 {
                            value = b[next]
                            next += 1
                            if value <= 32 || value == 127 {
                                if next > begin + 1 {
                                    end = next - 1
                                }
                                continue 'value_bytes
                            }
                        }
                        end = next
                    }
                    if next == limit {
                        break
                    }
                    value = b[next]
                    next += 1
                }
                cur.value_start = start
                cur.value_end = end
                if state == FieldStart {
                    finish_field(mut h, mut cur)
                }
            },
            FieldLf => {
                if c == 10 {
                    finish_field(mut h, mut cur)
                    state = FieldStart
                } else {
                    result = Bad
                }
            },
            EndLf => {
                if c == 10 {
                    h.end = next
                    result = Complete
                } else {
                    result = Bad
                }
            }
        }
        if result != Partial {
            break
        }
    }
    cur.examined += next - cur.offset
    cur.offset = next
    cur.state = state
    if result == Partial && next == 8192 {
        result = TooLarge
    }
    cur.result = result
    result
}

type Stop = More | Malformed | Limit

/// Empty offset head; parsers reset it before each call. No allocation.
/// Ex: `let mut h = http1.head()`.
pub fn head() -> Head {
    let z = Span(start: 0, end: 0)
    Head(method: z, target: z, version: 0, status: 0, reason: z, fields:[Header(name: z, value: z); 64], count: 0, end: 0)
}

fn byte(b: Bytes, at: u64) -> Result[u8, Stop] {
    if at >= 8192 {
        return Error(Limit)
    }
    if at >= list.len(b) {
        return Error(More)
    }
    Ok(b[at])
}

fn newline(b: Bytes, mut at: u64) -> Result[(), Stop] {
    let c = byte(b, at)?
    at += 1
    if c == 13 {
        if byte(b, at)? != 10 {
            return Error(Malformed)
        }
        at += 1
    } else if c != 10 {
        return Error(Malformed)
    }
    Ok(())
}

/// Checks an Upgrade token with an optional protocol version.
pub fn valid_upgrade_protocol(protocol: Bytes) -> bool {
    let n = list.len(protocol)
    if n == 0 {
        return false
    }
    let mut has_version = false
    for i in 0u64 .. n {
        let c = protocol[i]
        if c == b'/' && !has_version && i != 0 && i + 1 != n {
            has_version = true
        } else if !token(c) {
            return false
        }
    }
    true
}

/// Whether c is an RFC 9110 field-name token byte.
pub fn token(c: u8) -> bool {
    int.is_ascii_alpha(c) || int.is_ascii_digit(c) || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

/// Checks a nonempty field name and an opaque HTTP field value.
pub fn valid_field(name: Bytes, value: Bytes) -> bool {
    if list.len(name) == 0 {
        return false
    }
    for c in name {
        if !token(c) {
            return false
        }
    }
    for c in value {
        if c < 32 && c != 9 || c == 127 {
            return false
        }
    }
    true
}

fn version(b: Bytes, mut at: u64) -> Result[u8, Stop] {
    let prefix = string.as_bytes("HTTP/1.")
    for i in 0u64 .. 7u64 {
        if byte(b, at)? != prefix[i] {
            return Error(Malformed)
        }
        at += 1
    }
    let c = byte(b, at)?
    if c != b'0' && c != b'1' {
        return Error(Malformed)
    }
    at += 1
    Ok(c - b'0')
}

fn status_line(b: Bytes, mut at: u64, mut h: Head) -> Result[(), Stop] {
    while byte(b, at)? == 13 || byte(b, at)? == 10 {
        newline(b, mut at)?
    }
    h.version = version(b, mut at)?
    if byte(b, at)? != b' ' {
        return Error(Malformed)
    }
    at += 1
    let mut status: u16 = 0
    for i in 0u64 .. 3u64 {
        let c = byte(b, at)?
        if !int.is_ascii_digit(c) {
            return Error(Malformed)
        }
        let digit: u16 = int.widen(c - b'0')
        status = status * 10 + digit
        at += 1
    }
    h.status = status
    let c = byte(b, at)?
    if c == b' ' {
        at += 1
    } else if c != 13 && c != 10 {
        return Error(Malformed)
    }
    let start = at
    loop {
        let x = byte(b, at)?
        if x == 13 || x == 10 {
            break
        }
        if x < 32 && x != 9 || x == 127 {
            return Error(Malformed)
        }
        at += 1
    }
    h.reason = Span(start, end: at)
    newline(b, mut at)
}

/// Parses one request head, capped at 8192 bytes and 64 fields. A complete
/// head sets h.end; any read-ahead remains in b[h.end..]. O(head), no allocation.
/// Partial keeps initialized fields. Ex: `http1.request(b, mut h)`.
pub fn request(b: Bytes, mut h: Head) -> Progress {
    h = head()
    let mut cur = cursor()
    resume(b, mut h, mut cur)
}

/// Bounded status-head parser for HTTP clients and the WebSocket 101 check.
/// Same offsets, limits and strict header rules as request. Ex: `http1.response(b, mut h)`.
pub fn response(b: Bytes, mut h: Head) -> Progress {
    h = head()
    let mut cur = cursor()
    match status_line(b, mut cur.offset, mut h) {
        Ok(()) => {
            cur.state = FieldStart
            resume(b, mut h, mut cur)
        },
        Error(More) => Partial,
        Error(Malformed) => Bad,
        Error(Limit) => TooLarge,
    }
}

/// Compares ASCII bytes without changing their spelling. O(n), no allocation.
/// Ex: `http1.equal_ascii(value, string.as_bytes("websocket"))`.
pub fn equal_ascii(a: Bytes, b: Bytes) -> bool {
    if list.len(a) != list.len(b) {
        return false
    }
    for i in 0u64 .. list.len(a) {
        if int.to_ascii_lower(a[i]) != int.to_ascii_lower(b[i]) {
            return false
        }
    }
    true
}

/// Comma/space/tab-separated ASCII token membership. O(n), no allocation.
/// Ex: `http1.contains(value, string.as_bytes("upgrade"))`.
pub fn contains(b: Bytes, wanted: Bytes) -> bool {
    let mut at: u64 = 0
    let n = list.len(b)
    while at < n {
        while at < n && (b[at] == 44 || b[at] == 32 || b[at] == 9) {
            at += 1
        }
        let start = at
        while at < n && b[at] != 44 && b[at] != 32 && b[at] != 9 {
            at += 1
        }
        if equal_ascii(list.slice(b, start, at), wanted) {
            return true
        }
    }
    false
}

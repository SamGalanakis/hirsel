fn nibble(c: u8) -> u8 {
    if c >= b'a' {
        c - b'a' + 10u8
    } else {
        c - b'0'
    }
}

fn unhex(s: String) -> Bytes {
    let h = string.as_bytes(s)
    let mut out: Bytes = list.with_capacity(list.len(h) / 2)
    for i in 0u64 .. list.len(h) / 2 {
        list.push(mut out, nibble(h[2 * i]) * 16u8 + nibble(h[2 * i + 1]))
    }
    out
}

// RFC 6979 A.2.5. The signed cell's next draw must match a separate cell.
// expect: run p256_sign_keeps_next_draw() = true
fn p256_sign_keeps_next_draw() -> bool {
    let random = provide.random(7)
    let control = provide.random(7)
    let pkcs8 = unhex("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721a1440342000460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
    let key = result.unwrap(secret.seal(take pkcs8, "sign(p256)"))
    let point = unhex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
    let message = string.as_bytes("sample")
    let mut sig: Bytes = list.with_capacity(64)
    let n = result.unwrap(secret.sign(key, P256, random, message, mut sig))
    let expected = unhex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    let mut next: Bytes = list.with_capacity(8)
    let mut untouched: Bytes = list.with_capacity(8)
    host.random(random, mut next)
    host.random(control, mut untouched)
    n == 64 && sig == expected && next == untouched && p256.verify(point, message, sig) && !p256.verify(point, string.as_bytes("rample"), sig)
}

// RFC 6979 A.2.5 chooses the second 32-byte draw. The first is out of range.
// A failed admission keeps the tape and output untouched.
// expect: run p256_generation_draws_and_charge() = true
fn p256_generation_draws_and_charge() -> bool {
    let tape = unhex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffc9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f67211122334455667788")
    let random = provide.random_tape(take tape)
    let expected = unhex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
    let mut rejected: Bytes = list.with_capacity(65)
    let reject = result.unwrap(bound bytes 175 {
        match secret.p256_key(random, "sign(p256)", mut rejected) {
            Error(Capacity(c)) => c.requested == 176 && c.available == 175,
            _ => false,
        }
    })
    let other = provide.random(7)
    let mut other_point: Bytes = list.with_capacity(65)
    let mut point: Bytes = list.with_capacity(65)
    let document = result.unwrap(bound bytes 176 {
        let previous = result.unwrap(secret.p256_key(other, "sign(p256)", mut other_point))
        drop(take previous)
        let key = result.unwrap(secret.p256_key(random, "sign(p256)", mut point))
        take key
    })
    let message = string.as_bytes("sample")
    let mut sig: Bytes = list.with_capacity(64)
    let n = result.unwrap(secret.sign(document, P256, random, message, mut sig))
    let want_sig = unhex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    let mut next: Bytes = list.with_capacity(8)
    host.random(random, mut next)
    reject && list.len(rejected) == 0 && list.len(other_point) == 65 && point == expected && n == 64 && sig == want_sig && next == unhex("1122334455667788")
}

// RFC 7748 §6.1 Alice. Both share types pay exactly 64 bytes.
// expect: run key_share_keeps_private_keys_and_refunds() = true
fn key_share_keeps_private_keys_and_refunds() -> bool {
    let scalar = unhex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    let random = provide.random_tape(take scalar)
    let scalar_p256 = unhex("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    let random_p256 = provide.random_tape(take scalar_p256)
    let mut x25519_point: Bytes = list.with_capacity(32)
    let mut p256_point: Bytes = list.with_capacity(65)
    let short = result.unwrap(bound bytes 63 {
        match secret.key_share(random, X25519, mut x25519_point) {
            Error(Capacity(c)) => c.requested == 64 && c.available == 63,
            _ => false,
        }
    })
    let generated = result.unwrap(bound bytes 64 {
        let share = result.unwrap(secret.key_share(random, X25519, mut x25519_point))
        drop(take share)
        let second = result.unwrap(secret.key_share(random_p256, P256, mut p256_point))
        drop(take second)
        true
    })
    short && generated && x25519_point == unhex("8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a") && p256_point == unhex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
}

fn share_for_parent(take random: Random) -> secret.KeyShare {
    let mut point: Bytes = list.with_capacity(32)
    result.unwrap(secret.key_share(random, X25519, mut point))
}

fn key_share_room() -> u64 {
    let probe: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 4320)
    match probe {
        Ok(take pair) => {
            drop(take pair)
            4392
        },
        Error(c) => c.available,
    }
}

// A unit's share retains 64 bytes of the reservation until its last holder drops it.
// expect: run key_share_crosses_unit_with_charge(tasks) = true
fn key_share_crosses_unit_with_charge(tasks: Tasks) -> bool waits {
    let random = provide.random(7)
    result.unwrap(bound bytes 4392 {
        let worker = result.unwrap(task.spawn_unit(tasks, bytes 4096, take random, share_for_parent))
        let share = result.unwrap(task.join(take worker))
        let retains_charge = key_share_room() == 4328
        drop(take share)
        retains_charge && key_share_room() == 4392
    })
}

// RFC 9001 Appendix A.2. Unprotected header and protected payload, including its tag.
// expect: run quic_initial_packets_match_rfc9001() = true
fn quic_initial_packets_match_rfc9001() -> bool {
    let dcid = unhex("8394c8f03e515708")
    let header = unhex("c300000001088394c8f03e5157080000449e00000002")
    let mut plain: Bytes = list.with_capacity(1162)
    let frames = unhex("")
    for byte in frames {
        list.push(mut plain, byte)
    }
    while list.len(plain) < 1162 {
        list.push(mut plain, 0u8)
    }
    let ciphertext = unhex("")
    let extra: Bytes = list.new()
    let mut client = result.unwrap(schedule.quic_initial(Client, dcid))
    let server = result.unwrap(schedule.quic_initial(Server, dcid))
    let mut sender = result.unwrap(schedule.sealer(mut client, Initial, 0, 2))
    let opener = result.unwrap(schedule.opener(server, Initial))
    let mask = result.unwrap(schedule.header_mask(client, Initial, true))
    let duplicate = match schedule.sealer(mut client, Initial, 0, 3) {
        Error(Issued) => true,
        _ => false,
    }
    let mut sent: Bytes = list.with_capacity(1200)
    for byte in header {
        list.push(mut sent, byte)
    }
    let written = result.unwrap(packet.seal_into(mut sender, 2, plain, 0, mut sent, 0, extra))
    let matches_wire = list.len(sent) == 1200 && list.slice(sent, 22, 1200) == list.slice(ciphertext, 0, 1178)
    let sample = packet.mask(mask, sent, 22)
    let matches_mask = sample[0] == 0x43 && sample[1] == 0x7b && sample[2] == 0x9a && sample[3] == 0xec && sample[4] == 0x36
    let domain = match packet.open(opener, 1, 2, mut sent, 0, 22, extra) {
        Error(Range) => true,
        _ => false,
    }
    let opened = result.unwrap(packet.open(opener, 0, 2, mut sent, 0, 22, extra))
    duplicate && written == 1178 && matches_wire && matches_mask && domain && opened == 1162 && list.slice(sent, 22, 1184) == list.slice(plain, 0, 1162)
}

// RFC 9001 §5.8 and A.4. The pseudo-packet is AAD, and the plaintext is empty.
// expect: run quic_retry_integrity_matches_rfc9001() = true
fn quic_retry_integrity_matches_rfc9001() -> bool {
    let key_bytes = unhex("be0c690b9f66575a1d766b54e368c84e")
    let key = result.unwrap(secret.seal(take key_bytes, "aead(aes128-gcm)"))
    let nonce = unhex("461599d35d632bf2239825bb")
    let odcid = unhex("8394c8f03e515708")
    let packet_bytes = unhex("ff000000010008f067a5502a4262b5746f6b656e")
    let tag = unhex("04a265ba2eff4d829058fb3f0f2496ba")
    let mut aad: Bytes = list.with_capacity(1 + list.len(odcid) + list.len(packet_bytes))
    list.push(mut aad, 8u8)
    list.append(mut aad, odcid)
    list.append(mut aad, packet_bytes)
    let mut out: Bytes = list.with_capacity(16)
    let sealed = result.unwrap(secret.aead_seal(key, Aes128Gcm, nonce, aad, b"", mut out))
    if sealed != 16 || out != tag {
        return false
    }
    let mut empty: Bytes = list.new()
    let opened = result.unwrap(secret.aead_open(key, Aes128Gcm, nonce, aad, tag, mut empty))
    let changed = out[0] ^ 1u8
    let _ = list.set(mut out, 0, changed)
    let tampered = match secret.aead_open(key, Aes128Gcm, nonce, aad, out, mut empty) {
        Error(Tampered) => true,
        _ => false,
    }
    opened == 0 && tampered && list.len(empty) == 0
}

// RFC 9001 §6.1 with the RFC 8448 §3 server application secret. Python HMAC
// and cryptography AES-GCM derive the bytes following the unprotected header.
// expect: run quic_next_opener_preserves_receive_phase() = true
fn quic_next_opener_preserves_receive_phase() -> bool {
    let profile: schedule.Profile13 = Quic(Aes128GcmSha256)
    let material = unhex("a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643")
    let imported = result.unwrap(secret.seal(take material, "traffic_import(receive)"))
    let mut receiving = result.unwrap(schedule.import_traffic(profile, take imported))
    let scalar = unhex("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005")
    let peer = unhex("c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f")
    let random = provide.random_tape(take scalar)
    let mut public: Bytes = list.with_capacity(32)
    let share = result.unwrap(secret.key_share(random, X25519, mut public))
    let mut client = result.unwrap(schedule.tls13(profile, Client, take share, peer, unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")))
    let handshake_refused = match schedule.next_opener(client) {
        Error(Invalid) => true,
        _ => false,
    }
    result.unwrap(schedule.application(mut client, unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")))
    handshake_refused && quic_probe_phase(mut client) && quic_probe_phase(mut receiving)
}

fn quic_probe_phase(mut s: schedule.Schedule) -> bool {
    let old_wire = "4008426f17fd258cbb8056f1fdddbb66b92fe6d225"
    let next_wire = "4409fb383924221d84fee048b5c56c9c32adbb08bc"
    let previous = result.unwrap(schedule.opener(s, Application))
    let candidate = result.unwrap(schedule.next_opener(s))
    let mut forged = unhex(next_wire)
    let changed = forged[20] ^ 1u8
    let _ = list.set(mut forged, 20, changed)
    match packet.open(candidate, 0, 9, mut forged, 0, 2, b"") {
        Error(Tampered) => (),
        _ => return false,
    }
    let after_forgery = result.unwrap(schedule.opener(s, Application))
    if !quic_phase_opens(after_forgery, 8, old_wire) || !quic_phase_opens(candidate, 9, next_wire) {
        return false
    }
    let before_commit = result.unwrap(schedule.opener(s, Application))
    if !quic_phase_opens(before_commit, 8, old_wire) {
        return false
    }
    result.unwrap(schedule.key_update(mut s, false))
    let after_commit = result.unwrap(schedule.opener(s, Application))
    quic_phase_opens(after_commit, 9, next_wire) && quic_phase_opens(previous, 8, old_wire)
}

fn quic_phase_opens(opener: packet.Opener, seq: u64, wire: String) -> bool {
    let mut buf = unhex(wire)
    let n = result.unwrap(packet.open(opener, 0, seq, mut buf, 0, 2, b""))
    n == 3 && list.slice(buf, 2, 5) == unhex("010000")
}

// RFC 9147 §5.9 key and IV labels. Python hmac and OpenSSL AES-GCM
// independently generated the payload for sequence 2^48.
// expect: run dtls13_import_keeps_direction_spend_and_width() = true
fn dtls13_import_keeps_direction_spend_and_width() -> bool {
    let profile: schedule.Profile13 = Dtls13(Aes128GcmSha256)
    let tx_material = unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let rx_material = unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let tx = result.unwrap(secret.seal(take tx_material, "traffic_import(send)"))
    let rx = result.unwrap(secret.seal(take rx_material, "traffic_import(receive)"))
    let alias = secret.share(tx)
    let mut sending = result.unwrap(schedule.import_traffic(profile, take tx))
    let mut receiving = result.unwrap(schedule.import_traffic(profile, take rx))
    let spent = match schedule.import_traffic(profile, take alias) {
        Error((Spent, Some(take returned_alias))) => {
            drop(take returned_alias)
            true
        },
        _ => false,
    }
    let no_open = match schedule.opener(sending, Application) {
        Error(Invalid) => true,
        _ => false,
    }
    let no_seal = match schedule.sealer(mut receiving, Application, 0, 0) {
        Error(Invalid) => true,
        _ => false,
    }
    let mut sealer = result.unwrap(schedule.sealer(mut sending, Application, 0, 0))
    let opener = result.unwrap(schedule.opener(receiving, Application))
    let mut buf: Bytes = list.with_capacity(31)
    for b in unhex("2c0001") {
        list.push(mut buf, b)
    }
    let plain = string.as_bytes("dtls13 width")
    for b in plain {
        list.push(mut buf, b)
    }
    let empty: Bytes = list.new()
    let seq = 281474976710656u64
    let tag = result.unwrap(packet.seal(mut sealer, seq, mut buf, 0, 3, empty))
    let wire = unhex("2c00013b9f811ad532922364df49738c048631aa857afa5ef2d2d2009a38c9")
    let same = buf == wire
    let count = result.unwrap(packet.open(opener, 0, seq, mut buf, 0, 3, empty))
    spent && no_open && no_seal && same && tag == 16 && count == 12 && list.slice(buf, 3, 15) == list.slice(plain, 0, 12)
}

// RFC 8448 §3. Pair each protected handshake record with the side that sent it.
// expect: run tls13_handshake_uses_rfc8448_context_and_direction() = true
fn tls13_handshake_uses_rfc8448_context_and_direction() -> bool {
    let client_scalar = unhex("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005")
    let server_scalar = unhex("b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e")
    let client_random = provide.random_tape(take client_scalar)
    let server_random = provide.random_tape(take server_scalar)
    let mut cp: Bytes = list.with_capacity(32)
    let mut sp: Bytes = list.with_capacity(32)
    let client_share = result.unwrap(secret.key_share(client_random, X25519, mut cp))
    let server_share = result.unwrap(secret.key_share(server_random, X25519, mut sp))
    let hello_hash = unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    let profile: schedule.Profile13 = Tls13(Aes128GcmSha256)
    let empty: Bytes = list.new()
    let returned_share = match schedule.tls13(profile, Client, take client_share, sp, empty) {
        Error((Invalid, Some(take returned))) => take returned,
        _ => return false,
    }
    let mut client = result.unwrap(schedule.tls13(profile, Client, take returned_share, sp, hello_hash))
    let mut server = result.unwrap(schedule.tls13(profile, Server, take server_share, cp, hello_hash))
    let mut from_server = result.unwrap(schedule.sealer(mut server, Handshake, 0, 0))
    let to_client = result.unwrap(schedule.opener(client, Handshake))
    let mut from_client = result.unwrap(schedule.sealer(mut client, Handshake, 0, 0))
    let to_server = result.unwrap(schedule.opener(server, Handshake))
    let server_wire = unhex("")
    let client_wire = unhex("170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546")
    let server_plain = unhex("")
    let client_plain = unhex("14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce6116")
    let mut server_out: Bytes = list.with_capacity(list.len(server_wire))
    let mut client_out: Bytes = list.with_capacity(list.len(client_wire))
    for byte in list.slice(server_wire, 0, 5) {
        list.push(mut server_out, byte)
    }
    for byte in list.slice(client_wire, 0, 5) {
        list.push(mut client_out, byte)
    }
    for byte in server_plain {
        list.push(mut server_out, byte)
    }
    for byte in client_plain {
        list.push(mut client_out, byte)
    }
    let s = result.unwrap(packet.seal(mut from_server, 0, mut server_out, 0, 5, empty))
    let c = result.unwrap(packet.seal(mut from_client, 0, mut client_out, 0, 5, empty))
    let protected = s == 16 && c == 16 && server_out == server_wire && client_out == client_wire
    let s_open = result.unwrap(packet.open(to_client, 0, 0, mut server_out, 0, 5, empty))
    let c_open = result.unwrap(packet.open(to_server, 0, 0, mut client_out, 0, 5, empty))
    protected && s_open == list.len(server_plain) && c_open == list.len(client_plain) && list.slice(server_out, 5, list.len(server_out)) == server_plain && list.slice(client_out, 5, list.len(client_out)) == client_plain
}

// RFC 8448 §3 contexts. Python HMAC and OpenSSL provide the independent record oracle.
// expect: run tls13_application_updates_and_retires() = true
fn tls13_application_updates_and_retires() -> bool {
    let scalar = unhex("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005")
    let peer = unhex("c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f")
    let random = provide.random_tape(take scalar)
    let mut public: Bytes = list.with_capacity(32)
    let share = result.unwrap(secret.key_share(random, X25519, mut public))
    let profile: schedule.Profile13 = Tls13(Aes128GcmSha256)
    let mut s = result.unwrap(schedule.tls13(profile, Client, take share, peer, unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")))
    let mut old_handshake = result.unwrap(schedule.sealer(mut s, Handshake, 0, 0))
    let transcript = unhex("abababababababababababababababababababababababababababababababab")
    let short = match schedule.key_update(mut s, true) {
        Error(Invalid) => true,
        _ => false,
    }
    result.unwrap(schedule.application(mut s, unhex("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")))
    let mut out: Bytes = list.with_capacity(32)
    let n = result.unwrap(schedule.finished(s, Client, transcript, mut out))
    let verified = result.unwrap(schedule.verify_finished(s, Client, transcript, out))
    let wrong = result.unwrap(schedule.verify_finished(s, Server, transcript, out))
    let mut app = result.unwrap(schedule.sealer(mut s, Application, 0, 0))
    let app_matches = tls13_test_record(mut app, unhex("170303001ccf5b163ed309e1b6ca8398ecc789405a154d19ca9f73b5400f3d3f49"))
    result.unwrap(schedule.key_update(mut s, true))
    let mut updated = result.unwrap(schedule.sealer(mut s, Application, 0, 0))
    let update_matches = tls13_test_record(mut updated, unhex("170303001c65bed5efa2a4b736f51cfe5bebba7129f7e6395d32d5c8788e8803a9"))
    result.unwrap(schedule.retire(mut s, Handshake))
    let invalid_domain = match schedule.sealer(mut s, Handshake, 1, 0) {
        Error(Invalid) => true,
        _ => false,
    }
    let spent = match schedule.finished(s, Client, transcript, mut out) {
        Error(Spent) => true,
        _ => false,
    }
    let hs_matches = tls13_test_record(mut old_handshake, unhex("170303001c0c89298bf100d60723861c6cf83cdc521ebf65cfd727c24ab19c140e"))
    short && n == 32 && out == unhex("a751e45dc25ec365b33fc91fa449169efa90d681fb695dfd34b11280d890364f") && verified && !wrong && app_matches && update_matches && spent && invalid_domain && hs_matches
}

fn tls13_test_record(mut cipher: packet.Sealer, expected: Bytes) -> bool {
    let mut packet_bytes: Bytes = list.with_capacity(33)
    for b in b"\x17\x03\x03\x00\x1cmedia sample" {
        list.push(mut packet_bytes, b)
    }
    let empty: Bytes = list.new()
    result.unwrap(packet.seal(mut cipher, 0, mut packet_bytes, 0, 5, empty)) == 16 && packet_bytes == expected
}

// Python hmac and OpenSSL derive the RFC 5246 record and server Finished independently.
// expect: run dtls12_records_use_epoch_and_explicit_nonce() = true
fn dtls12_records_use_epoch_and_explicit_nonce() -> bool {
    dtls12_record_case(Aes128GcmSha256, 32, false, "5838181a5c0e550b83a796bc0420474963330d92aa3ee92302d6c35801c0869e745a4d1344d6", "cdf7b3a0776ff52c4601258e", Some("2441834d04700d2bc96b720c7883efc82db409a9ecde7597ee80ada6f742fb5fec4efbd4506a")) && dtls12_record_case(Aes128GcmSha256, 32, true, "e064f066f85a8648b81b5c64ee9b88c57680bf39d36cb15997a8a6b94d6edd661b66f6d048ba", "55c67a1e89d48a06231bfcc9", Some("d9e906b8a251ea1193fb32d9dfb78c6d9a0e61fe37f9c42d31f3032a05fc9d8acad29c503e97")) && dtls12_record_case(Aes256GcmSha384, 48, false, "64adde471a0f0f1652eb3bcd46870341d070710b9b682c68595c0fd8ae7aadfb87865970df0d", "1725abd8c2457a08d6a35e8e", Some("49b94e68b6433b5fe3b274792456bdbe6fee1a062b3800de14083bb5ad7d3adb5af9012f6c7e")) && dtls12_record_case(Aes256GcmSha384, 48, true, "c7895b6b0c565abe094851ac9f1aa5eb6843f3dfe6c846cbce835343546e739e87692dbcdffb", "c7d34b30663fda4c330392ad", Some("9889a16d9a3557d4ef1d4c22bfdc5477d3c79049b3929853588e3d1d20bf8d77b33e2f38b840")) && dtls12_record_case(ChaCha20Poly1305Sha256, 32, false, "9341ef93d6f84fb2235c3e8552d3f190e7c65c129d79c3188f7d9191224da2de5d386af172a7", "cdf7b3a0776ff52c4601258e", None) && dtls12_record_case(ChaCha20Poly1305Sha256, 32, true, "aec8a50ce0e2ce8ae0adddda95021f655764a34d32a0e82934ff90f9b30260f5ee0358ee524d", "55c67a1e89d48a06231bfcc9", None)
}

fn dtls12_record_case(suite: schedule.Suite12, hash_size: u64, ems: bool, want_record: String, want_finished: String, want_peer: Option[String]) -> bool {
    let client_scalar = unhex("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005")
    let server_scalar = unhex("b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e")
    let client_rng = provide.random_tape(take client_scalar)
    let server_rng = provide.random_tape(take server_scalar)
    let mut cp: Bytes = list.with_capacity(32)
    let mut sp: Bytes = list.with_capacity(32)
    let local = result.unwrap(secret.key_share(client_rng, X25519, mut cp))
    let remote = result.unwrap(secret.key_share(server_rng, X25519, mut sp))
    let client_random = unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let server_random = unhex("a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf")
    let session: Option[Bytes] = if ems {
        Some(dtls12_hash(hash_size, 0x5e))
    } else {
        None
    }
    let mut client = result.unwrap(schedule.dtls12(suite, Client, 1, take local, sp, client_random, server_random, session))
    let server = result.unwrap(schedule.dtls12(suite, Server, 1, take remote, cp, client_random, server_random, session))
    let mut sealer = result.unwrap(schedule.sealer(mut client, Application, 0, 1))
    let opener = result.unwrap(schedule.opener(server, Application))
    let extra = unhex("000100000000000117fefd0016")
    let plain = string.as_bytes("DTLS record transcript")
    let mut record: Bytes = list.with_capacity(38)
    let too_wide = match packet.seal_into(mut sealer, 281474976710656, plain, 0, mut record, 0, extra) {
        Error(Range) => true,
        _ => false,
    }
    let n = result.unwrap(packet.seal_into(mut sealer, 1, plain, 0, mut record, 0, extra))
    let exact = record == unhex(want_record)
    let p = result.unwrap(packet.open(opener, 0, 281474976710657, mut record, 0, 0, extra))
    let peer_nonce = match want_peer {
        Some(want) => {
            let mut peer_record: Bytes = unhex(want)
            let peer_opener = result.unwrap(schedule.opener(client, Application))
            let opened = result.unwrap(packet.open(peer_opener, 0, 0x1234, mut peer_record, 0, 0, extra))
            opened == 22 && peer_record == plain
        },
        None => true,
    }
    let hash = dtls12_hash(hash_size, 0xab)
    let mut verify: Bytes = list.with_capacity(12)
    let size = result.unwrap(schedule.finished(server, Server, hash, mut verify))
    let valid = result.unwrap(schedule.verify_finished(client, Server, hash, verify))
    exact && peer_nonce && too_wide && n == 38 && p == 22 && record == plain && size == 12 && verify == unhex(want_finished) && valid
}

fn dtls12_hash(size: u64, byte: u8) -> Bytes {
    let mut out: Bytes = list.with_capacity(size)
    for _ in 0u64 .. size {
        list.push(mut out, byte)
    }
    take out
}

// libSRTP fd08747f srtp_validate and srtp_validate_gcm.
// expect: run srtp_import_obeys_policy_and_libsrtp() = true
fn srtp_import_obeys_policy_and_libsrtp() -> bool {
    let cm: schedule.SrtpProfile = Aes128CmHmacSha1_80
    let gcm: schedule.SrtpProfile = AeadAes128Gcm
    let cm_key = "e1f97a0d3e018be0d64fa32c06de41390ec675ad498afeebb6960b3aabe6"
    let gcm_key = "000102030405060708090a0b0c0d0e0fa0a1a2a3a4a5a6a7a8a9aaab"
    let cm_rtp = unhex("800f1234decafbadcafebabe4e55dc4ce79978d88ca4d215949d2402b78d6acc99ea179b8dbb")
    let cm_rtcp = unhex("81c8000bcafebabe7128035be487b9bdbef89041f977a5a8993e08cd54d6c1230798")
    let gcm_rtp = unhex("800f1234decafbadcafebabec5002ede04cfdd2eb91159e0880aa06ed2976826f796b201df3131a127e8a392")
    let cm_tx_material = unhex(cm_key)
    let cm_rx_material = unhex(cm_key)
    let gcm_tx_material = unhex(gcm_key)
    let gcm_rx_material = unhex(gcm_key)
    let cm_tx = result.unwrap(secret.seal(take cm_tx_material, "srtp_import(send)"))
    let cm_rx = result.unwrap(secret.seal(take cm_rx_material, "srtp_import(receive)"))
    let gcm_tx = result.unwrap(secret.seal(take gcm_tx_material, "srtp_import(send)"))
    let gcm_rx = result.unwrap(secret.seal(take gcm_rx_material, "srtp_import(receive)"))
    let alias = secret.share(cm_tx)
    let mut cm_sender = result.unwrap(schedule.import_srtp(cm, take cm_tx))
    let mut cm_receiver = result.unwrap(schedule.import_srtp(cm, take cm_rx))
    let mut gcm_sender = result.unwrap(schedule.import_srtp(gcm, take gcm_tx))
    let gcm_receiver = result.unwrap(schedule.import_srtp(gcm, take gcm_rx))
    let spent = match schedule.import_srtp(cm, take alias) {
        Error((Spent, Some(take returned))) => {
            drop(take returned)
            true
        },
        _ => false,
    }
    let no_open = match schedule.opener(cm_sender, Rtp) {
        Error(Invalid) => true,
        _ => false,
    }
    let no_seal = match schedule.sealer(mut cm_receiver, Rtcp, 0xcafebabe, 0) {
        Error(Invalid) => true,
        _ => false,
    }
    let mut cm_rtp_seal = result.unwrap(schedule.sealer(mut cm_sender, Rtp, 0xcafebabe, 0))
    let mut cm_rtcp_seal = result.unwrap(schedule.sealer(mut cm_sender, Rtcp, 0xcafebabe, 0))
    let mut gcm_rtp_seal = result.unwrap(schedule.sealer(mut gcm_sender, Rtp, 0xcafebabe, 0))
    let cm_rtp_open = result.unwrap(schedule.opener(cm_receiver, Rtp))
    let cm_rtcp_open = result.unwrap(schedule.opener(cm_receiver, Rtcp))
    let gcm_rtp_open = result.unwrap(schedule.opener(gcm_receiver, Rtp))
    let cm_out = result.unwrap(schedule.inspect(cm_sender, Rtp))
    let gcm_in = result.unwrap(schedule.inspect(gcm_receiver, Rtcp))
    spent && no_open && no_seal && cm_out.send && !cm_out.receive && gcm_in.receive && !gcm_in.send && cm_out.cipher != gcm_in.cipher && srtp_test_packet(mut cm_rtp_seal, cm_rtp_open, 0x1234, 12, unhex("00000000"), cm_rtp) && srtp_test_packet(mut cm_rtcp_seal, cm_rtcp_open, 1, 8, unhex("80000001"), cm_rtcp) && srtp_test_packet(mut gcm_rtp_seal, gcm_rtp_open, 0x1234, 12, unhex(""), gcm_rtp)
}

// 1040 bytes fits one sealer and its ledger entry, but cannot issue a pair.
// expect: run srtp_sealer_pair_is_atomic() = true
fn srtp_sealer_pair_is_atomic() -> bool {
    let key = unhex("e1f97a0d3e018be0d64fa32c06de41390ec675ad498afeebb6960b3aabe6")
    let secret = result.unwrap(secret.seal(take key, "srtp_import(send)"))
    let mut send = result.unwrap(schedule.import_srtp(Aes128CmHmacSha1_80, take secret))
    let refused = result.unwrap(bound bytes 1040 {
        match schedule.sealer_pair(mut send, Rtp, Rtcp, 7, 0, 0) {
            Error(Capacity(c)) => c.requested == 2080 && c.available == 1040,
            _ => false,
        }
    })
    let _ = result.unwrap(schedule.sealer(mut send, Rtcp, 7, 0))
    let second_already_issued = match schedule.sealer_pair(mut send, Rtp, Rtcp, 7, 0, 0) {
        Error(Issued) => true,
        _ => false,
    }
    let _ = result.unwrap(schedule.sealer(mut send, Rtp, 7, 0))
    let _ = result.unwrap(schedule.sealer_pair(mut send, Rtp, Rtcp, 8, 0, 0))
    refused && second_already_issued
}

fn srtp_test_packet(mut sealer: packet.Sealer, opener: packet.Opener, seq: u64, at: u64, extra: Bytes, wire: Bytes) -> bool {
    let mut protected: Bytes = list.with_capacity(list.len(wire))
    for b in list.slice(wire, 0, at) {
        list.push(mut protected, b)
    }
    let plain = unhex("abababababababababababababababab")
    let n = result.unwrap(packet.seal_into(mut sealer, seq, plain, 0, mut protected, 0, extra))
    let mut out: Bytes = list.with_capacity(16)
    let opened = result.unwrap(packet.open_into(opener, 0xcafebabe, seq, protected, 0, at, extra, mut out))
    n == list.len(wire) - at && protected == wire && opened == 16 && out == plain
}

// Independent Python/OpenSSL RFC 5764 exporter and SRTP-CM records.
// expect: run dtls12_exports_one_srtp_child_per_side() = true
fn dtls12_exports_one_srtp_child_per_side() -> bool {
    let client_scalar = unhex("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005")
    let server_scalar = unhex("b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e")
    let client_rng = provide.random_tape(take client_scalar)
    let server_rng = provide.random_tape(take server_scalar)
    let mut cp: Bytes = list.with_capacity(32)
    let mut sp: Bytes = list.with_capacity(32)
    let local = result.unwrap(secret.key_share(client_rng, X25519, mut cp))
    let remote = result.unwrap(secret.key_share(server_rng, X25519, mut sp))
    let client_random = unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let server_random = unhex("a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf")
    let suite: schedule.Suite12 = Aes128GcmSha256
    let mut client = result.unwrap(schedule.dtls12(suite, Client, 1, take local, sp, client_random, server_random, None))
    let mut server = result.unwrap(schedule.dtls12(suite, Server, 1, take remote, cp, client_random, server_random, None))
    let profile: schedule.SrtpProfile = Aes128CmHmacSha1_80
    let mut tx = result.unwrap(schedule.srtp(mut client, profile))
    let mut rx = result.unwrap(schedule.srtp(mut server, profile))
    let issued = match schedule.srtp(mut client, profile) {
        Error(Issued) => true,
        _ => false,
    }
    let mut from_client = result.unwrap(schedule.sealer(mut tx, Rtp, 0xcafebabe, 0x1234))
    let from_server = result.unwrap(schedule.opener(tx, Rtp))
    let mut to_client = result.unwrap(schedule.sealer(mut rx, Rtp, 0xcafebabe, 0x1234))
    let to_server = result.unwrap(schedule.opener(rx, Rtp))
    let client_wire = unhex("800f1234decafbadcafebabea96910a3d7e66d0f6c03290697acbb07443b55797ea969d2e520")
    let server_wire = unhex("800f1234decafbadcafebabec8c224bfc6a8c71d2fe207d31482cc44eb3093e300355b0f3367")
    let roc = unhex("00000000")
    issued && srtp_test_packet(mut from_client, to_server, 0x1234, 12, roc, client_wire) && srtp_test_packet(mut to_client, from_server, 0x1234, 12, roc, server_wire)
}

// Python X25519 scales both public points by the same independent scalar.
// expect: run same_agreement_same_side_refused() = true
fn same_agreement_same_side_refused() -> bool {
    let a = unhex("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005")
    let b = unhex("b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e")
    let a_rng = provide.random_tape(take a)
    let b_rng = provide.random_tape(take b)
    let c_a = unhex("7aba1a2b287d8be8d6b8661a0734e388d6b9b1bf60f03eac5381b33bde83cd76")
    let c_b = unhex("09cf5c30ad059d6cac8c8f7a64731d25ac4a95ca293e032fd468c824ddff803b")
    let hello = unhex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    let profile: schedule.Profile13 = Tls13(Aes128GcmSha256)
    let mut first_point: Bytes = list.with_capacity(32)
    let mut second_point: Bytes = list.with_capacity(32)
    let empty: Bytes = list.new()
    let mut packet_bytes: Bytes = list.with_capacity(16)
    result.unwrap(bound bytes 4392 {
        let a_share = result.unwrap(secret.key_share(a_rng, X25519, mut first_point))
        let b_share = result.unwrap(secret.key_share(b_rng, X25519, mut second_point))
        let mut accepted = result.unwrap(schedule.tls13(profile, Client, take a_share, c_b, hello))
        let mut sender = result.unwrap(schedule.sealer(mut accepted, Handshake, 0, 0))
        let tag = result.unwrap(packet.seal(mut sender, 0, mut packet_bytes, 0, 0, empty))
        drop(take sender)
        drop(take accepted)
        let stays_counted = key_share_room() == 4280
        let refused = match schedule.tls13(profile, Client, take b_share, c_a, hello) {
            Error((Issued, None)) => true,
            _ => false,
        }
        tag == 16 && stays_counted && refused && key_share_room() == 4392 && c_a != first_point && c_b != second_point
    })
}

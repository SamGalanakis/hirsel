// CONC-7: cancellation while a sleep waits returns Cancelled.
fn sleeper(take c: Clock) waits {
    host.sleep_until(c, 18446744073709551615u64)
}

pub fn main(tasks: Tasks, clock: Clock, out: Stdout) -> Result[(), Exit] waits {
    let mut h = task.spawn(tasks, bytes 4096, clock, sleeper)
    let now = host.mono_ns(clock)
    host.sleep_until(clock, now + 1_000_000u64)
    task.cancel(mut h)
    match task.join(take h) {
        Error(Cancelled(take causes)) => { let _ = take causes; result.unwrap(stdout.write(out, "C")); Ok(()) },
        _ => Error(Exit(status: 7))
    }
}

pub type Bounds: send {
    event_max: u64,
    producer_bytes: u64,
    producer_steps: u64
}

pub opaque type Spec: send {
    status: u16,
    fields: List[(Bytes, Bytes)],
    block: Bytes,
    state_at: u64,
    room: Bounds,
    source: Source,
    expires_at_ms: Option[u64],
}

type Source: send = Encoded(fn(take Seed) waits) | Owned(own[send] fn(take Seed, Clock, Option[Dir]) waits, Option[Dir]) | Relayed(Box[http_client.Connection], u64) | Managed

pub fn spec[P: codec + send](req: http.Request, response_status: u16, room: Bounds, state: P, driver: fn(take Seed) waits) -> Result[Spec, http.HandlerError] {
    if response_status < 200 || response_status > 599 || response_status == 204 || response_status == 304 || room.event_max == 0 {
        return Error(InvalidStream)
    }
    let (out_cap, state_max) = http.handover_limits(req)
    let need = int.saturating_add(int.saturating_mul(3u64, room.event_max), state_max)
    if room.producer_bytes < need {
        return Error(InvalidStream)
    }
    encode_spec(response_status, room, state, out_cap, state_max, Encoded(driver))
}

/// Places a subscription's codec seed in the connection's handoff block.
pub fn spec_managed[P: codec + send](req: http.Request, state: P) -> Result[Spec, http.HandlerError] {
    if http.route_tag(req) == 0u64 {
        return Error(InvalidStream)
    }
    let (out_cap, state_max) = http.handover_limits(req)
    encode_spec(200u16, Bounds(event_max: 0u64, producer_bytes: 0u64, producer_steps: 0u64), state, out_cap, state_max, Managed)
}

fn encode_spec[P: codec + send](spec_status: u16, room: Bounds, state: P, out_cap: u64, state_max: u64, take source: Source) -> Result[Spec, http.HandlerError] {
    let size = int.saturating_add(out_cap, state_max)
    if size > 18446744073709551608 {
        return Error(InvalidStream)
    }
    let coding: codec.Codec[P] = codec.of()
    let made: Result[Result[Bytes, codec.EncodeError], Capacity] = bound bytes ((size + 7) / 8 * 8) {
        let mut block: Bytes = list.with_capacity(size)
        list.fill(mut block, out_cap, 0u8)
        match codec.encode(coding, state, mut block) {
            Ok(()) => Ok(take block),
            Error(e) => Error(e),
        }
    }
    match take made {
        Ok(Ok(take block)) => Ok(Spec(status: spec_status, fields: list.new(), block: take block, state_at: out_cap, room, source: take source, expires_at_ms: None)),
        Ok(Error(_)) => Error(InvalidStream),
        Error(e) => Error(Allocation(e)),
    }
}

fn relayed(source: Source) -> bool {
    match source {
        Relayed(..) => true,
        _ => false,
    }
}

pub fn managed(offer: Offer) -> bool {
    if let Managed = offer.source {
        true
    } else {
        false
    }
}

/// Hands an owning producer to the admitted stream task without serialization.
pub fn spec_owned(req: http.Request, response_status: u16, room: Bounds, directory: Option[Dir], take driver: own[send] fn(take Seed, Clock, Option[Dir]) waits) -> Result[Spec, http.HandlerError] {
    held_spec(req, response_status, room, list.new(), Owned(take driver, directory))
}

/// Relays an upstream response body whose head the handler has read: the
/// handler's status, the upstream's end-to-end fields, then its bytes as they
/// arrive, with no heartbeat, each read under its own idle_ms deadline.
pub fn spec_relay(req: http.Request, response_status: u16, room: Bounds, take upstream: http_client.Connection, idle_ms: u64) -> Result[Spec, http.HandlerError] {
    if room.event_max < 8 || !http_client.fresh_response(upstream) {
        return Error(InvalidStream)
    }
    held_spec(req, response_status, room, http_client.relay_fields(upstream), Relayed(box.new(take upstream), idle_ms))
}

fn held_spec(req: http.Request, response_status: u16, room: Bounds, take head_fields: List[(Bytes, Bytes)], take source: Source) -> Result[Spec, http.HandlerError] {
    if response_status < 200 || response_status > 599 || response_status == 204 || response_status == 304 || room.event_max == 0 {
        return Error(InvalidStream)
    }
    let (out_cap, _) = http.handover_limits(req)
    if room.producer_bytes < int.saturating_mul(3u64, room.event_max) || out_cap > 18446744073709551608 {
        return Error(InvalidStream)
    }
    let made: Result[Bytes, Capacity] = bound bytes ((out_cap + 7) / 8 * 8) {
        let mut block: Bytes = list.with_capacity(out_cap)
        list.fill(mut block, out_cap, 0u8)
        take block
    }
    match take made {
        Ok(take block) => Ok(Spec(status: response_status, fields: take head_fields, block: take block, state_at: out_cap, room, source: take source, expires_at_ms: None)),
        Error(e) => Error(Allocation(e)),
    }
}

/// Gives a private stream its binding's exclusive wall-clock deadline.
pub fn expire_at(mut offer: Spec, expires_at_ms: Option[u64]) {
    offer.expires_at_ms = expires_at_ms
}

pub fn pre_head_refusal(s: Spec, c: Clock, now: u64, deadline: u64) -> Option[u16] {
    if auth_lapsed(c, s.expires_at_ms) {
        Some(401u16)
    } else if now >= deadline {
        Some(503u16)
    } else {
        None
    }
}

pub fn auth_lapsed(c: Clock, expires_at_ms: Option[u64]) -> bool {
    match expires_at_ms {
        Some(at) => host.wall_ms(c) >= at,
        None => false,
    }
}

pub fn header(mut s: Spec, take name: Bytes, take value: Bytes) -> Result[(), http.HandlerError] {
    http.check_response_field(name, value)?
    list.push(mut s.fields, (take name, take value))
    Ok(())
}

pub fn status(s: Spec) -> u16 {
    s.status
}

pub fn fields(s: Spec) -> View[List[(Bytes, Bytes)]] in s {
    view s.fields
}

pub type Offer: send {
    block: Bytes,
    head_len: u64,
    state_at: u64,
    room: Bounds,
    source: Source,
    chunked: bool,
    heartbeat: bool,
    suppress: bool,
    at: u64,
    pre_head: u64,
    expires_at_ms: Option[u64],
}

pub fn prepare(take s: Spec, head: Bytes, chunked: bool, heartbeat: bool, suppress: bool, at: u64, pre_head: u64) -> Offer {
    let Spec(status: _, fields: _, block: take owned, state_at, room, source: take source, expires_at_ms) = take s
    let mut block = take owned
    for i in 0u64 .. list.len(head) {
        block[i] = head[i]
    }
    let beat = heartbeat && !relayed(source)
    Offer(block: take block, head_len: list.len(head), state_at, room, source: take source, chunked, heartbeat: beat, suppress, at, pre_head, expires_at_ms)
}

pub type Delivery: send = Item(Bytes) | Staged(Bytes, u64) | Committed(u64) | Sent(SentUnit) | WriteFailed | UnitDropped | Expiry | UnitExpired | ReadEnd | Tick | SourceEnded | SourceFailed | Stop

pub opaque type StopHandle: send {
    inbox: Sender[Delivery]
}

pub fn signal_stop(handle: StopHandle) {
    let _ = channel.try_send(handle.inbox, Stop)
}

pub type SentUnit: key = HeadSent | ItemSent | ControlSent | EndSent

type Unit: send = Head | Data(Bytes, u64) | Heartbeat | Terminal(u64) | Refusal | AuthRefusal | AuthTerminal(MeasuredEvent, u64) | Measured(MeasuredEvent, u64, bool) | FirstFailure(http.Response, Option[http.ReleaseGate])

pub type MeasuredEvent: send {
    length: u64,
    body: http.BodyWriter,
    gate: Option[http.ReleaseGate],
}

pub opaque type Seed: send {
    block: Bytes,
    at: u64,
    inbox: Sender[Delivery],
    credits: Receiver[()],
    room: Bounds
}

fn discard(take buffer: Bytes) {}

fn next_event[P: send, E](take previous: P, room: Bounds, next: fn(mut P) -> Result[Option[Bytes], E] waits) -> Result[(P, Result[Result[Option[Bytes], E], Capacity]), OutOfTime] waits {
    bound steps room.producer_steps {
        let mut state = take previous
        let event = bound bytes room.event_max {
            next(mut state)
        }
        (take state, take event)
    }
}

pub fn produce[P: codec + send, E](take seed: Seed, next: fn(mut P) -> Result[Option[Bytes], E] waits) waits {
    let Seed(block: take block, at, inbox: take inbox, credits: take credits, room) = take seed
    let decoded = codec.decode_at((codec.of() : codec.Codec[P]), block, at)
    discard(take block)
    match take decoded {
        Ok(take initial) => produce_items(take initial, take inbox, take credits, room, next),
        Error(_) => {
            let _ = channel.send(inbox, SourceEnded)
        },
    }
}

/// Produces from already-owned state. The same credit and per-item bounds apply.
pub fn produce_owned[P: send, E](take seed: Seed, take state: P, next: fn(mut P) -> Result[Option[Bytes], E] waits) waits {
    let Seed(block: take block, at: _, inbox: take inbox, credits: take credits, room) = take seed
    discard(take block)
    produce_items(take state, take inbox, take credits, room, next)
}

fn produce_items[P: send, E](take initial: P, take inbox: Sender[Delivery], take credits: Receiver[()], room: Bounds, next: fn(mut P) -> Result[Option[Bytes], E] waits) waits {
    let mut state = take initial
    let mut failed = false
    while let Ok(()) = channel.receive(credits) {
        match next_event(take state, room, next) {
            Ok((take current, Ok(Ok(Some(take event))))) => {
                state = take current
                if list.len(event) == 0 || list.capacity(event) > room.event_max {
                    failed = true
                    break
                }
                if let Error(_) = channel.send(inbox, Item(take event)) {
                    return
                }
            },
            Ok((_, Ok(Ok(None)))) => break,
            _ => {
                failed = true
                break
            },
        }
    }
    let _ = channel.send(inbox, if failed {
        SourceFailed
    } else {
        SourceEnded
    })
}

type OwnedJob: send {
    seed: Seed,
    clock: Clock,
    directory: Option[Dir],
    driver: own[send] fn(take Seed, Clock, Option[Dir]) waits
}

fn run_owned(take job: OwnedJob) waits {
    let OwnedJob(seed: take seed, clock: clock, directory, driver: take driver) = take job
    driver(take seed, clock, directory)
}

pub type Transfer: send {
    reader: ReadHalf,
    writer: WriteHalf,
    offer: Offer,
    buffered: u64,
    clock: Clock,
    out_cap: u64,
    pipeline_max: u64,
    write_ms: u64,
    linger_ms: u64,
    heartbeat_ms: u64,
    lease_ms: u64
}

pub type Work: send {
    transport: Transfer,
    tasks: Tasks,
    control: Option[http.StreamControl]
}

type Writer[E: send]: send {
    half: WriteHalf,
    block: Bytes,
    size: u64,
    state_at: u64,
    out_cap: u64,
    chunked: bool,
    suppressed: bool,
    clock: Clock,
    pre_head: u64,
    write_ms: u64,
    expires_at_ms: Option[u64],
    stop: Option[http.DrainSignal],
    inbox: Sender[E],
    units: Receiver[Unit],
    notify: fn(take Delivery) -> E
}

type Monitor[E: send]: send {
    half: ReadHalf,
    remaining: u64,
    inbox: Sender[E],
    notify: fn(take Delivery) -> E
}

type Alarm[E: send]: send {
    clock: Clock,
    from: u64,
    interval: u64,
    pre_head: u64,
    inbox: Sender[E],
    notify: fn(take Delivery) -> E
}

fn monitor[E: send](take job: Monitor[E]) -> ReadHalf waits {
    let Monitor(half: take half, remaining: limit, inbox: take inbox, notify) = take job
    let mut reader = take half
    let mut buffer: Bytes = list.with_capacity(64)
    let mut remaining = limit
    loop {
        list.clear(mut buffer)
        match host.recv_bounded(mut reader, mut buffer, 64, Never) {
            Ok(n) => {
                if n == 0 || n > remaining {
                    break
                }
                remaining -= n
            },
            Error(_) => break,
        }
    }
    let _ = channel.send(inbox, notify(ReadEnd))
    take reader
}

fn alarm[E: send](take job: Alarm[E]) waits {
    let Alarm(clock: c, from: start, interval: period, pre_head, inbox: take inbox, notify) = take job
    let mut next = clock.deadline_after_ms(start, period)
    let mut pending = pre_head
    loop {
        let at = order.min(next, pending)
        host.sleep_until(c, at)
        let _ = channel.try_send(inbox, notify(Tick))
        if at == 18446744073709551615 {
            return
        }
        if next == at {
            next = clock.deadline_after_ms(at, period)
        }
        if pending == at {
            pending = 18446744073709551615
        }
    }
}

fn chunk_prefix(mut out: Bytes, length: u64) {
    list.clear(mut out)
    let mut digits: Inline[u8, 64] =[0; 64]
    let start = int.radix_digits(length, 16, mut digits)
    for i in start .. 64 {
        let _ = list.push(mut out, digits[i])
    }
    let _ = list.append(mut out, string.as_bytes("\r\n"))
}

fn send_data(mut socket: WriteHalf, mut scratch: Bytes, data: Bytes, chunked: bool, clock: Clock, deadline: u64, signal: Option[http.DrainSignal]) -> Result[(), NetError] waits {
    if chunked {
        chunk_prefix(mut scratch, list.len(data))
        http.write_wire_until(mut socket, scratch, data, clock, deadline, signal)?
        http.write_wire_until(mut socket, string.as_bytes("\r\n"), string.as_bytes(""), clock, deadline, signal)
    } else {
        http.write_wire_until(mut socket, data, string.as_bytes(""), clock, deadline, signal)
    }
}

fn write_head[E: send](mut socket: WriteHalf, head: Bytes, c: Clock, deadline: u64, ms: u64, inbox: Sender[E], notify: fn(take Delivery) -> E, signal: Option[http.DrainSignal]) -> Result[SentUnit, NetError] waits {
    if http.stop_deadline(signal) != None {
        return Ok(EndSent)
    }
    let at = host.mono_ns(c)
    if at >= deadline {
        http.write_promotion_refusal(mut socket, c, at, ms, signal)?
        return Ok(EndSent)
    }
    let stop = clock.deadline_after_ms(at, ms)
    let sent = match host.send_pair(mut socket, head, string.as_bytes(""), At(c, http.clamp_deadline(signal, order.min(stop, deadline)))) {
        Ok(0) => return Error(Reset),
        Ok(n) => n,
        Error(TimedOut) => {
            if deadline <= stop && http.stop_deadline(signal) == None {
                http.write_promotion_refusal(mut socket, c, host.mono_ns(c), ms, signal)?
                return Ok(EndSent)
            }
            return Error(TimedOut)
        },
        Error(e) => return Error(e),
    }
    if let Error(_) = channel.send(inbox, notify(Committed(host.mono_ns(c)))) {
        return Error(Aborted)
    }
    http.write_wire_until(mut socket, list.slice(head, sent, list.len(head)), string.as_bytes(""), c, stop, signal)?
    Ok(HeadSent)
}

fn writer[E: send](take job: Writer[E]) -> WriteHalf waits {
    let Writer(half: take half, block: take block, size, state_at, out_cap: capacity, chunked, suppressed, clock: c, pre_head, write_ms: ms, expires_at_ms, stop: take signal, inbox: take inbox, units: take units, notify) = take job
    let mut socket = take half
    let mut scratch: Bytes = list.with_capacity(capacity)
    let _ = list.append(mut scratch, list.slice(block, 0, size))
    if let Error(_) = channel.send(inbox, notify(Staged(take block, state_at))) {
        return take socket
    }
    let mut committed = false
    let mut expired = false
    while let Ok(take unit) = channel.receive(units) {
        expired = expired || auth_lapsed(c, expires_at_ms)
        if expired && !after_expiry(unit) {
            if committed {
                let _ = channel.send(inbox, notify(UnitExpired))
                continue
            }
            let sent = write_auth_refusal(mut socket, c, ms, signal)
            let _ = channel.send(inbox, notify(if sent {
                Sent(EndSent)
            } else {
                WriteFailed
            }))
            break
        }
        if !unit_allowed(unit) {
            if !unit_started(unit) {
                let _ = channel.send(inbox, notify(UnitDropped))
                continue
            }
            let now = host.mono_ns(c)
            let wrote = if now >= pre_head {
                match http.write_promotion_refusal(mut socket, c, now, ms, signal) {
                    Ok(()) => true,
                    Error(_) => false
                }
            } else {
                write_reset_refusal(mut socket, suppressed, c, ms, signal)
            }
            let _ = channel.send(inbox, notify(if wrote {
                Sent(EndSent)
            } else {
                WriteFailed
            }))
            break
        }
        let wrote: Result[SentUnit, NetError] = match take unit {
            Head => write_head(mut socket, scratch, c, pre_head, ms, inbox, notify, signal),
            Data(take data, cap) => {
                let deadline = order.min(cap, clock.deadline_after_ms(host.mono_ns(c), ms))
                match send_data(mut socket, mut scratch, data, chunked, c, deadline, signal) {
                    Ok(()) => Ok(ItemSent),
                    Error(e) => Error(e),
                }
            },
            Heartbeat => {
                let deadline = clock.deadline_after_ms(host.mono_ns(c), ms)
                match send_data(mut socket, mut scratch, string.as_bytes(":\n\n"), chunked, c, deadline, signal) {
                    Ok(()) => Ok(ControlSent),
                    Error(e) => Error(e),
                }
            },
            Terminal(deadline) => {
                if chunked && !suppressed {
                    match http.write_wire_until(mut socket, string.as_bytes("0\r\n\r\n"), string.as_bytes(""), c, deadline, signal) {
                        Ok(()) => Ok(EndSent),
                        Error(e) => Error(e),
                    }
                } else {
                    Ok(EndSent)
                }
            },
            Measured(take event, cap, initial) => {
                let ready = if initial {
                    write_head(mut socket, scratch, c, pre_head, ms, inbox, notify, signal)
                } else {
                    Ok(HeadSent)
                }
                match ready {
                    Ok(EndSent) => Ok(EndSent),
                    Ok(_) if suppressed => Ok(EndSent),
                    Ok(_) => {
                        if initial {
                            committed = true
                            if auth_lapsed(c, expires_at_ms) {
                                expired = true
                                let _ = channel.send(inbox, notify(UnitExpired))
                                continue
                            }
                        }
                        let deadline = order.min(cap, clock.deadline_after_ms(host.mono_ns(c), ms))
                        send_measured(mut socket, mut scratch, event, chunked, c, deadline, signal)
                    },
                    Error(e) => Error(e),
                }
            },
            AuthTerminal(take event, deadline) => send_measured(mut socket, mut scratch, event, chunked, c, deadline, signal),
            AuthRefusal => if write_auth_refusal(mut socket, c, ms, signal) {
                Ok(EndSent)
            } else {
                Error(Reset)
            },
            FirstFailure(take response, _) => {
                let now = host.mono_ns(c)
                let deadline = clock.deadline_after_ms(now, ms)
                let written = if now >= pre_head {
                    http.write_promotion_refusal(mut socket, c, now, ms, signal)
                } else {
                    http.write_stream_response(mut socket, mut scratch, response, if chunked {
                        1u8
                    } else {
                        0u8
                    }, suppressed, c, deadline, signal)
                }
                match written {
                    Ok(()) => Ok(EndSent),
                    Error(e) => Error(e)
                }
            },
            Refusal => {
                match http.write_promotion_refusal(mut socket, c, host.mono_ns(c), ms, signal) {
                    Ok(()) => Ok(EndSent),
                    Error(e) => Error(e),
                }
            },
        }
        match wrote {
            Ok(sent) => {
                if sent == HeadSent {
                    committed = true
                }
                if let Error(_) = channel.send(inbox, notify(Sent(sent))) {
                    break
                }
                if sent == EndSent {
                    break
                }
            },
            Error(_) => {
                let _ = channel.send(inbox, notify(WriteFailed))
                break
            },
        }
    }
    take socket
}

fn after_expiry(unit: Unit) -> bool {
    match unit {
        AuthTerminal(..) => true,
        AuthRefusal => true,
        Terminal(_) => true,
        _ => false,
    }
}

fn write_auth_refusal(mut socket: WriteHalf, c: Clock, ms: u64, signal: Option[http.DrainSignal]) -> bool waits {
    let head = b"HTTP/1.1 401 Unauthorized\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
    let deadline = clock.deadline_after_ms(host.mono_ns(c), ms)
    if let Ok(()) = http.write_wire_until(mut socket, head, b"", c, deadline, signal) {
        true
    } else {
        false
    }
}

fn unit_allowed(unit: Unit) -> bool {
    let gate = match unit {
        Measured(event, _, _) => view event.gate,
        FirstFailure(_, fence) => view fence,
        _ => return true,
    }
    match gate {
        Some(check) => http.read_fence(check.round, check.fence, check.version),
        None => true
    }
}

fn unit_started(unit: Unit) -> bool {
    match unit {
        Measured(_, _, initial) => initial,
        FirstFailure(_, _) => true,
        _ => false
    }
}

fn write_reset_refusal(mut socket: WriteHalf, suppressed: bool, c: Clock, ms: u64, signal: Option[http.DrainSignal]) -> bool waits {
    let deadline = clock.deadline_after_ms(host.mono_ns(c), ms)
    let head = b"HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\nRetry-After: 1\r\nContent-Type: application/json\r\nContent-Length: 19\r\n\r\n"
    let body: Bytes = if suppressed {
        b""
    } else {
        b"{\"refused\":\"reset\"}"
    }
    match http.write_wire_until(mut socket, head, body, c, deadline, signal) {
        Ok(()) => true,
        Error(_) => false,
    }
}

fn send_measured(mut socket: WriteHalf, mut scratch: Bytes, event: MeasuredEvent, chunked: bool, c: Clock, deadline: u64, signal: Option[http.DrainSignal]) -> Result[SentUnit, NetError] waits {
    if chunked {
        chunk_prefix(mut scratch, event.length)
        http.write_wire_until(mut socket, scratch, b"", c, deadline, signal)?
    }
    let capacity = list.capacity(scratch)
    let flush = scoped fn(block: Bytes) -> bool waits {
        let mut offset = 0u64
        while offset < list.len(block) {
            let next = offset + order.min(capacity, list.len(block) - offset)
            if let Error(_) = http.write_wire_until(mut socket, list.slice(block, offset, next), b"", c, deadline, signal) {
                return false
            }
            offset = next
        }
        true
    }
    let wrote = (event.body)(mut scratch, flush)
    if !wrote {
        return Error(Reset)
    }
    if chunked {
        http.write_wire_until(mut socket, b"\r\n", b"", c, deadline, signal)?
    }
    Ok(ItemSent)
}

/// The owner holds these handles and sends one unit when the writer is idle.
pub const MANAGED_BYTES: u64 = 256 + 104 + 64 + 96 + 8192 + 296 + (296 + 64) + (288 + 4096) + 288 + 16384

pub opaque type ManagedWriter {
    units: Sender[Unit],
    writer: Task[WriteHalf],
    reader: Task[ReadHalf],
    timer: Task[()],
    expiry: Option[Task[()]],
    signal: Option[http.DrainSignal],
    clock: Clock,
    linger: u64,
}

pub fn managed_timing(work: Work) -> (Clock, u64, u64, u64, Option[u64]) {
    (work.transport.clock, work.transport.offer.pre_head, work.transport.lease_ms, work.transport.write_ms, work.transport.offer.expires_at_ms)
}

pub fn managed_state[P: codec](packet: Bytes, start: u64) -> Result[P, codec.DecodeError] {
    codec.decode_at((codec.of() : codec.Codec[P]), packet, start)
}

pub fn start_managed[E: send](take work: Work, to: Sender[E], notify: fn(take Delivery) -> E) -> Option[ManagedWriter] {
    let Work(transport: take transport, tasks, control: take control) = take work
    let Transfer(reader: take input, writer: take output, offer: take offer, buffered, clock: c, out_cap: capacity, pipeline_max: allowance, write_ms: ms, linger_ms: linger, heartbeat_ms: period, lease_ms: _) = take transport
    if buffered > allowance {
        return None
    }
    let Offer(block: take block, head_len, state_at, room: _, source: _, chunked, heartbeat: _, suppress, at, pre_head, expires_at_ms) = take offer
    let signal = http.stream_signal(control)
    let (units, writes): (Sender[Unit], Receiver[Unit]) = channel.new(1u64)
    let writing = Writer(half: take output, block: take block, size: head_len, state_at, out_cap: capacity, chunked, suppressed: suppress, clock: c, pre_head, write_ms: ms, expires_at_ms, stop: http.stream_signal(control), inbox: channel.sender(to), units: take writes, notify)
    let watching = Monitor(half: take input, remaining: allowance - buffered, inbox: channel.sender(to), notify)
    let waking = Alarm(clock: c, from: at, interval: period, pre_head, inbox: channel.sender(to), notify)
    let write: fn(take Writer[E]) -> WriteHalf waits = writer
    let read: fn(take Monitor[E]) -> ReadHalf waits = monitor
    let tick: fn(take Alarm[E]) waits = alarm
    let expiry = stream_expiry(tasks, c, expires_at_ms, to, notify)
    Some(ManagedWriter(units: take units, writer: task.spawn(tasks, bytes ((capacity + 7u64) / 8u64 * 8u64 + 1024u64), take writing, write), reader: task.spawn(tasks, bytes 64u64, take watching, read), timer: task.spawn(tasks, bytes 4096u64, take waking, tick), expiry: take expiry, signal: take signal, clock: c, linger: linger))
}

pub fn managed_offer(active: ManagedWriter, take event: MeasuredEvent, until: u64, initial: bool) -> bool {
    if let Ok(()) = channel.try_send(active.units, Measured(take event, until, initial)) {
        true
    } else {
        false
    }
}

pub fn managed_expired(active: ManagedWriter, take event: MeasuredEvent, until: u64) {
    let _ = channel.try_send(active.units, AuthTerminal(take event, until))
}

pub fn managed_auth_refusal(active: ManagedWriter) {
    let _ = channel.try_send(active.units, AuthRefusal)
}

pub fn managed_failure(active: ManagedWriter, take response: http.Response, take gate: Option[http.ReleaseGate]) {
    let _ = channel.try_send(active.units, FirstFailure(take response, take gate))
}

pub fn managed_deadline(active: ManagedWriter) {
    let _ = channel.try_send(active.units, Refusal)
}

pub fn managed_heartbeat(active: ManagedWriter) {
    let _ = channel.try_send(active.units, Heartbeat)
}

pub fn managed_terminal(active: ManagedWriter, deadline: u64) {
    let _ = channel.try_send(active.units, Terminal(deadline))
}

pub fn managed_stop(active: ManagedWriter) -> Option[u64] {
    http.stop_deadline(active.signal)
}

pub fn finish_managed(take active: ManagedWriter) waits {
    let ManagedWriter(units: _, writer: take writing_task, reader: take reader, timer: take timer, expiry: take expiry_task, signal: _, clock: c, linger) = take active
    let mut writing = take writing_task
    let mut reading = take reader
    let mut ticking = take timer
    task.cancel(mut writing)
    task.cancel(mut reading)
    task.cancel(mut ticking)
    let mut expiry = take expiry_task
    stop_producer(mut expiry)
    let out_half = task.join(take writing)
    let in_half = task.join(take reading)
    let _ = task.join(take ticking)
    if let Some(take expiry_alarm) = take expiry {
        let _ = task.join(take expiry_alarm)
    }
    if let (Ok(take write_half), Ok(take read_half)) = (take out_half, take in_half) {
        let _ = net.finish(take write_half, take read_half, c, clock.deadline_after_ms(host.mono_ns(c), linger))
    }
}

pub fn managed_reservation(out_cap: u64) -> u64 {
    int.saturating_add(MANAGED_BYTES, (int.saturating_add(out_cap, 7u64) / 8u64) * 8u64)
}

pub fn reservation(offer: Offer, out_cap: u64) -> u64 {
    // HTTP-15 rows 10–13b. The spawner pays the group's own task record.
    let owner: u64 = 256 + 104 + 64 + 96 + 8192
    let children: u64 = 296 + (296 + 64) + (288 + 4096) + 288
    let output = (int.saturating_add(out_cap, 7) / 8) * 8
    let expiry = if offer.expires_at_ms != None {
        288u64 + 4096u64
    } else {
        0u64
    }
    if managed(offer) {
        // The subscription has a depth stack and an owner inbox. It has no
        // producer task, its credits or a retained producer-owned event.
        return int.saturating_add(managed_reservation(out_cap), expiry + (int.saturating_add(list.len(offer.block) - offer.state_at, 7u64) / 8u64) * 8u64)
    }
    int.saturating_add(owner + children + expiry, int.saturating_add(output, offer.room.producer_bytes))
}

fn stop_producer(mut running: Option[Task[()]]) {
    if let Some(mut producer) = running {
        task.cancel(mut producer)
    }
}

fn stream_expiry[E: send](tasks: Tasks, c: Clock, expires_at_ms: Option[u64], to: Sender[E], notify: fn(take Delivery) -> E) -> Option[Task[()]] {
    match expires_at_ms {
        Some(at_ms) => Some(clock.wall_alarm(tasks, c, at_ms, to, notify(Expiry))),
        None => None,
    }
}

pub fn expiry_wake(message: Delivery) -> bool {
    match message {
        Expiry => true,
        UnitExpired => true,
        _ => false,
    }
}

fn same_delivery(take event: Delivery) -> Delivery {
    take event
}

pub fn drive(take job: Work) waits {
    let Work(transport: take transport, tasks, control: take control) = take job
    let Transfer(reader: take input, writer: take output, offer: take offer, buffered, clock: c, out_cap: capacity, pipeline_max: allowance, write_ms: ms, linger_ms: linger, heartbeat_ms: period, lease_ms: lease) = take transport
    if buffered > allowance {
        return
    }
    let Offer(block: take block, head_len, state_at, room, source: take offered_source, chunked, heartbeat, suppress, at, pre_head, expires_at_ms) = take offer
    // A relayed body is whole only when upstream ends it (§2 Ending).
    let relay = relayed(offered_source)
    let mut source = Some(take offered_source)
    let (tx, rx): (Sender[Delivery], Receiver[Delivery]) = channel.new(6)
    if let Some(owner) = control {
        if !http.register_stream(owner, StopHandle(inbox: channel.sender(tx))) {
            return
        }
    }
    let signal = http.stream_signal(control)
    let (units, writes): (Sender[Unit], Receiver[Unit]) = channel.new(1)
    let (give, take_credit): (Sender[()], Receiver[()]) = channel.new(2)
    let _ = channel.try_send(give, ())
    let _ = channel.try_send(give, ())
    let mut queue: List[Bytes] = list.with_capacity(2)
    let writing = Writer(half: take output, block: take block, size: head_len, state_at, out_cap: capacity, chunked, suppressed: suppress, clock: c, pre_head, write_ms: ms, expires_at_ms, stop: http.stream_signal(control), inbox: channel.sender(tx), units: take writes, notify: same_delivery)
    let watching = Monitor(half: take input, remaining: allowance - buffered, inbox: channel.sender(tx), notify: same_delivery)
    let waking = Alarm(clock: c, from: at, interval: period, pre_head, inbox: channel.sender(tx), notify: same_delivery)
    let mut write_task = task.spawn(tasks, bytes ((capacity + 7) / 8 * 8), take writing, writer)
    let mut read_task = task.spawn(tasks, bytes 64, take watching, monitor)
    let mut alarm_task = task.spawn(tasks, bytes 4096, take waking, alarm)
    let mut expiry = stream_expiry(tasks, c, expires_at_ms, tx, same_delivery)
    let mut producer: Option[Task[()]] = None
    let mut credit: Option[Receiver[()]] = Some(take take_credit)
    let mut head_started = false
    let mut busy = false
    let mut lease_end: Option[u64] = None
    let mut end: Option[u64] = None
    let mut draining = false
    let mut expired = false
    let mut whole = !relay
    while let Ok(take message) = channel.receive(rx) {
        let now = host.mono_ns(c)
        let mut heartbeat_ready = false
        if !draining {
            if let Some(d) = http.stop_deadline(signal) {
                if !head_started {
                    break
                }
                draining = true
                let stop = match end {
                    Some(until) => until,
                    None => clock.deadline_after_ms(now, ms),
                }
                end = Some(order.min(d, stop))
                list.clear(mut queue)
                stop_producer(mut producer)
            }
        }
        if !expired && (expiry_wake(message) || auth_lapsed(c, expires_at_ms)) {
            expired = true
            if end == None {
                end = Some(clock.deadline_after_ms(now, ms))
            }
            list.clear(mut queue)
            stop_producer(mut producer)
            if !head_started {
                head_started = true
                busy = true
                let _ = channel.try_send(units, AuthRefusal)
            }
        }
        if let Some(expires) = lease_end {
            if now >= expires && end == None {
                end = Some(clock.deadline_after_ms(now, ms))
                list.clear(mut queue)
                stop_producer(mut producer)
            }
        }
        match take message {
            Staged(take packet, _) => {
                if head_started {
                    discard(take packet)
                } else {
                    head_started = true
                    busy = true
                    if now >= pre_head {
                        discard(take packet)
                        let _ = channel.try_send(units, Refusal)
                    } else {
                        if suppress {
                            discard(take packet)
                        } else {
                            let receiver = option.unwrap(replace(mut credit, None))
                            let seed = Seed(block: take packet, at: state_at, inbox: channel.sender(tx), credits: take receiver, room)
                            producer = match option.unwrap(replace(mut source, None)) {
                                Encoded(driver) => Some(task.spawn(tasks, bytes room.producer_bytes, take seed, driver)),
                                Owned(take driver, directory) => {
                                    let owned = OwnedJob(seed: take seed, clock: c, directory, driver: take driver)
                                    Some(task.spawn(tasks, bytes room.producer_bytes, take owned, run_owned))
                                },
                                Relayed(take upstream, idle_ms) => {
                                    let body = http_client.BodyRelay(seed: take seed, upstream: box.unbox(take upstream), idle_ms, size: room.event_max / 8 * 8)
                                    Some(task.spawn(tasks, bytes room.producer_bytes, take body, http_client.relay_body))
                                },
                                Managed => fail("managed offer uses the subscription owner"),
                            }
                        }
                        let _ = channel.try_send(units, Head)
                    }
                }
            },
            Committed(committed_at) => {
                lease_end = Some(clock.deadline_after_ms(committed_at, lease))
            },
            Item(take item) => {
                if end == None {
                    let _ = list.push(mut queue, take item)
                }
            },
            Sent(HeadSent) => {
                busy = false
                if suppress {
                    end = Some(clock.deadline_after_ms(now, ms))
                }
            },
            Sent(ItemSent) => {
                busy = false
                let _ = channel.try_send(give, ())
            },
            Sent(ControlSent) => {
                busy = false
            },
            Sent(EndSent) => break,
            WriteFailed => break,
            UnitDropped => break,
            UnitExpired => {
                busy = false
            },
            Expiry => (),
            ReadEnd => {
                stop_producer(mut producer)
                if lease_end == None {
                    break
                }
                if end == None {
                    end = Some(clock.deadline_after_ms(now, ms))
                }
                list.clear(mut queue)
            },
            SourceEnded => {
                if end == None {
                    whole = true
                    end = Some(clock.deadline_after_ms(now, ms))
                    stop_producer(mut producer)
                }
            },
            SourceFailed => {
                if end == None {
                    whole = false
                    end = Some(clock.deadline_after_ms(now, ms))
                }
            },
            Tick => {
                if !head_started && now >= pre_head {
                    head_started = true
                    busy = true
                    let _ = channel.try_send(units, Refusal)
                }
                heartbeat_ready = heartbeat && lease_end != None
            },
            Stop => {},
        }
        if let Some(deadline) = end {
            if now >= deadline {
                break
            }
        }
        if busy || lease_end == None {
            continue
        }
        if list.len(queue) != 0 {
            let item = list.remove(mut queue, 0)
            let cap = match end {
                Some(deadline) => deadline,
                None => 18446744073709551615,
            }
            let _ = channel.try_send(units, Data(take item, cap))
            busy = true
        } else if let Some(deadline) = end {
            if !whole {
                break
            }
            let _ = channel.try_send(units, Terminal(deadline))
            busy = true
        } else if heartbeat_ready {
            let _ = channel.try_send(units, Heartbeat)
            busy = true
        }
    }
    stop_producer(mut producer)
    task.cancel(mut write_task)
    task.cancel(mut read_task)
    task.cancel(mut alarm_task)
    stop_producer(mut expiry)
    if let Some(take running) = take producer {
        let _ = task.join(take running)
    }
    let write_result = task.join(take write_task)
    let read_result = task.join(take read_task)
    let _ = task.join(take alarm_task)
    if let Some(take expiry_alarm) = take expiry {
        let _ = task.join(take expiry_alarm)
    }
    if let (Ok(take write_half), Ok(take read_half)) = (take write_result, take read_result) {
        let _ = net.finish(take write_half, take read_half, c, clock.deadline_after_ms(host.mono_ns(c), linger))
    }
}

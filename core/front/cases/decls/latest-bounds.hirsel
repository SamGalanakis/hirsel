// CONC-13: Latest[T] is send and a cleaned resource, never shareable, key,
// ordered or codec, and it gives no view of its payload (only read's Arc).
type Shares: shareable { l: Latest[u64] }
type Keyed: key { l: Latest[u64] }
type Ordered: ordered { l: Latest[u64] }
type Coded: codec { l: Latest[u64] }
type Sent: send { l: Latest[u64] }
fn number(x: u64) -> u64 { x }
fn peek(h: Latest[u64]) -> u64 { number(h) }
fn shared[T: shareable + send](x: T) -> u64 { 1 }
fn root(h: Latest[u64]) -> u64 { shared(h) }

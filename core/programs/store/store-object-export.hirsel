type ObjectExportLease: send {
    names: Map[String, ()],
    lifetime: Receiver[()]
}

type ObjectExportCopy: send {
    journal: Sender[JournalMsg],
    health: Latest[Health],
    manifest: pages.HistoryRef,
    packs: List[pages.HistoryRef],
    entries: List[pages.HistoryRef],
}

fn object_export_read(mut lane: ObjectJournalSession, key: String, reference: pages.HistoryRef, take buffer: Bytes) -> Result[Bytes, Error] waits {
    let mut raw = take buffer
    let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
    match failure_result_from_rep(history.history_range(mut lane.client, key, reference, 0, reference.len, mut raw, due)) {
        Ok(()) => Ok(take raw),
        Error(HistoryMissing(..)) => {
            object_journal_fresh_probe(mut lane, due)?
            Error(failure_from_rep(format.disk_fault(key, 0, Absent)))
        },
        Error(take problem) => Error(take problem),
    }
}

fn object_export_fetch(plan: ObjectExportCopy, lead: String, reference: pages.HistoryRef) -> Result[Bytes, Error] waits {
    let (take key, take buffer) = disk_allocation(scoped fn() -> Result[(String, Bytes), Error] {
        Ok((history.history_key(lead, reference), list.with_capacity(reference.len)))
    })?
    let (outlet, incoming): (Sender[Result[Bytes, types.Failure]], Receiver[Result[Bytes, types.Failure]]) = channel.new(1)
    let request = journal.ObjectExportFetch(key: take key, reference, buffer: take buffer, reply: take outlet)
    if let Ok(()) = channel.send(plan.journal, ObjectExportRead(take request)) {
        if let Ok(take observed) = channel.receive(incoming) {
            return failure_result_from_rep(take observed)
        }
    }
    health_result(latest.read(plan.health))?
    Error(Io(Closed))
}

fn begin_object_export_copy(mut db: Db, take into: ExportInto, take attempt: Bytes, activation: Option[u64]) -> Result[ExportCopy, DeployError] waits {
    let receipt = Ticket(store: db.store, open: open_number(db), mark: Journal(db.frame_seq, 0, 0))
    deploy_result(durable(mut db, receipt))?
    // §12.11.11 M5: export/backup on an attached Place cuts when `sealed` is
    // non-empty (returning its refusal if refused), or settles keeping ATTACH
    // when `sealed` is empty so the holder keeps serving with ATTACH intact.
    let (is_attached, has_sealed) = match disk_state(db).object {
        Some(w) => (w.attached, w.has_sealed),
        None => (false, false),
    }
    if is_attached && has_sealed {
        let cut_ticket = deploy_result(checkpoint(mut db))?
        deploy_result(durable(mut db, cut_ticket))?
    }
    let (take parked, take resume) = deploy_result(take_object_journal_with(mut db, true))?
    let mut lane = take parked
    let mut report: Option[host_stream.DeferredSlotReport] = None
    let settle_err: Option[Error] = if is_attached && !has_sealed {
        let group_bytes: u64 = int.widen(disk_state(db).options.group_bytes)
        let group_commits: u64 = int.widen(disk_state(db).options.group_commits)
        let last_seq = match view lane.stream {
            Some(link) => host_stream.slot_last_batch(link),
            None => 0u64,
        }
        let (take settled, take outcome) = stream_settle(take lane, last_seq, last_seq + 1, false, group_bytes, group_commits)
        lane = take settled
        match take outcome {
            Ok(SettleApplied) => {
                let fseq = match history.register_attach(lane.register) {
                    Some(a) => match a.live {
                        Some(r) => r.from_seq,
                        None => 0u64,
                    },
                    None => 0u64,
                }
                object_journal_stream_trim_batches(mut lane, fseq)
                if let Some(link) = view lane.stream {
                    report = Some(host_stream.defer_slot_head(link, history.register_head(lane.register).store, history.register_attach(lane.register), last_seq))
                }
                None
            },
            Ok(SettleFenced(moved_epoch, cutoff)) => {
                if let Some(link) = view lane.stream {
                    report = Some(host_stream.defer_slot_report(link, ReportFenced(host_stream.slot_number(link), history.register_head(lane.register).store, history.register_head(lane.register).pair.epoch, moved_epoch, cutoff)))
                }
                Some(Fenced(history.register_head(lane.register).pair.epoch))
            },
            Ok(SettleNotApplied) => Some(Undecided),
            Error(take problem) => Some(take problem),
        }
    } else {
        None
    }
    if let Some(take problem) = take settle_err {
        deploy_result(return_object_journal(take lane, resume))?
        if let Some(take completion) = take report {
            host_stream.deliver_slot_report(take completion)
        }
        return Error(Store(take problem))
    }
    let (lifetime, stop): (Sender[()], Receiver[()]) = channel.new(1)
    let captured: Result[ExportCopy, DeployError] = match object_export_capture(db, mut lane, take into, take attempt, activation, take stop) {
        Error(Store(HistoryMissing(take key, _))) => {
            let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
            match object_journal_fresh_probe(mut lane, due) {
                Ok(()) => Error(Store(failure_from_rep(format.disk_fault(key, 0, Absent)))),
                Error(take problem) => Error(Store(take problem)),
            }
        },
        other => take other,
    }
    deploy_result(return_object_journal(take lane, resume))?
    if let Some(take completion) = take report {
        host_stream.deliver_slot_report(take completion)
    }
    let job = captured?
    let held = arc.share(job.lease)
    write_disk(mut db.disk, (take lifetime, take held), scoped fn(mut state: DiskState, take grant: (Sender[()], Arc[manifest.ExportLease])) {
        let (take sending, take lease) = take grant
        state.lease = Some(take lease)
        state.steps = list.new()
        if let Some(mut object_writer) = state.object {
            object_writer.export_lifetime = Some(take sending)
        }
    })
    Ok(take job)
}

fn object_export_capture(db: Db, mut lane: ObjectJournalSession, take into: ExportInto, take attempt: Bytes, wanted: Option[u64], take stop: Receiver[()]) -> Result[ExportCopy, DeployError] waits {
    let head = history.register_head(lane.register)
    // A backup (no activation) takes the activation the head has.
    let activation = match wanted {
        Some(given) => given,
        None => head.activation
    }
    if activation != head.activation {
        return Error(Drift)
    }
    let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
    deploy_result(object_journal_fresh_probe(mut lane, due))?
    let (take mark, _) = deploy_result(failure_result_from_rep(history.history_checkpoint(mut lane.client, head, due)))?
    let suffix = deploy_result(failure_result_from_rep(history.history_suffix(mut lane.client, head, head.checkpoint, due)))?
    let (take packs, take history_entries, take names) = deploy_result(disk_allocation(scoped fn() -> Result[(List[pages.HistoryRef], List[pages.HistoryRef], Map[String, ()]), Error] {
        let locator = object_state(db).locator
        let mut packs: List[pages.HistoryRef] = list.with_capacity(map.len(history.locator_rows(locator)))
        let mut history_entries: List[pages.HistoryRef] = list.with_capacity(list.len(suffix))
        let mut names: Map[String, ()] = map.new()
        live_reclaim_name(mut names, "m-", mark.manifest)?
        live_reclaim_name(mut names, "e-", head.checkpoint)?
        for chunk in history.locator_chunks(locator) {
            live_reclaim_name(mut names, "l-", chunk)?
        }
        for (_, item) in history.locator_rows(locator) {
            list.push(mut packs, item)
            live_reclaim_name(mut names, "p-", item)?
        }
        for suffix_index in 0u64 .. list.len(suffix) {
            let item = history.history_length(suffix[suffix_index], head.checkpoint.seq + 1 + suffix_index)
            list.push(mut history_entries, item)
            live_reclaim_name(mut names, "e-", item)?
        }
        Ok((take packs, take history_entries, take names))
    }))?
    let mut journal_end = 72u64
    for item in history_entries {
        let key = history.history_key("e-", item)
        if item.len < 128 {
            return Error(Store(failure_from_rep(format.disk_fault(key, 112, Truncated))))
        }
        deploy_result(failure_result_from_rep(history.history_range(mut lane.client, key, item, 112, 128, mut lane.buffers.compare, due)))?
        let frame = deploy_result(failure_result_from_rep(manifest.disk_read_frame_head(key, lane.buffers.compare, 112)))?
        if frame.kind != 0x0040 {
            let Some(total) = int.checked_add(journal_end, item.len - 112) else {
                return Error(Store(Limit(Value)))
            }
            journal_end = total
        }
    }
    let source = ObjectExportCopy(journal: channel.sender(object_sender(disk_state(db))), health: latest.handle(object_state(db).health), manifest: mark.manifest, packs: take packs, entries: take history_entries)
    let retained = deploy_result(failure_result_from_rep(types.copied(attempt)))?
    let stamp = ExportStamp(attempt: take attempt, store_hi: db.store.hi, store_lo: db.store.lo, opened: open_number(db), branch: 0, head: pages.holder_heads(db.holders)[0].head, next_table: catalog.next_table_id(db.schema), activation, terminal: head.checkpoint.seq, end: journal_end)
    let lease = arc.new(manifest.ExportLease(attempt: take retained, packs: list.new(), collections: pages.share_page_tree(pages.holder_heads(db.holders)[0].roots.collections), first: stamp.terminal, terminal: stamp.terminal, end: stamp.end, head: stamp.head, next_table: stamp.next_table, activation))
    lane.export_lease = Some(ObjectExportLease(names: take names, lifetime: take stop))
    Ok(ExportCopy(source: ExportObject(take source), into: take into, stamp: take stamp, lease: take lease))
}

fn export_write(mut file: HostFile, raw: Bytes) -> Result[(), DeployError] waits {
    match host.write(mut file, raw) {
        Ok(()) => Ok(()),
        Error(problem) => Error(Scratch(Io(problem.error))),
    }
}

fn object_export_file(plan: ObjectExportCopy, to: Dir, id: StoreId, lead: String, reference: pages.HistoryRef, role: u8, local: String) -> Result[(), DeployError] waits {
    let mut raw = deploy_result(object_export_fetch(plan, lead, reference))?
    let key = history.history_key(lead, reference)
    let ctx = deploy_result(failure_result_from_rep(history.history_object_context(key, store_key_to_rep(id), role, reference, raw)))?
    deploy_result(failure_result_from_rep(history.history_object_digest(key, reference, raw)))?
    let header = deploy_result(failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0))))?
    for i in 0u64 .. 72 {
        raw[i] = header[i]
    }
    scratch_result(failure_result_from_rep(manifest.disk_write_synced(to, local, raw)))
}

fn object_export_copy(plan: ObjectExportCopy, to: Dir, stamp: ExportStamp) -> Result[(), DeployError] waits {
    let id = StoreId(hi: stamp.store_hi, lo: stamp.store_lo)
    for item in plan.packs {
        let local = scratch_result(failure_result_from_rep(manifest.paged_pack_path(item.seq)))?
        object_export_file(plan, to, id, "p-", item, 3, local)?
    }
    object_export_file(plan, to, id, "m-", plan.manifest, 1, "MANIFEST")?
    let local = scratch_result(failure_result_from_rep(types.capacity(manifest.disk_path("j-", stamp.terminal, ""))))?
    let ctx = format.DiskContext(store: store_key_to_rep(id), role: 2, seq: stamp.terminal)
    let mut output = scratch_result(failure_result_from_rep(manifest.disk_io(host.open(to, local, Write))))?
    export_write(mut output, deploy_result(failure_result_from_rep(types.capacity(format.disk_header_bytes(ctx, 0, 0))))?)?
    let mut offset = 72u64
    for item in plan.entries {
        let key = history.history_key("e-", item)
        let mut raw = deploy_result(object_export_fetch(plan, "e-", item))?
        let (remote, _) = deploy_result(failure_result_from_rep(history.history_entry_context(key, store_key_to_rep(id), item, raw)))?
        deploy_result(failure_result_from_rep(history.history_object_digest(key, item, raw)))?
        let first = deploy_result(failure_result_from_rep(manifest.disk_frame_bytes(key, remote, raw, 112)))?
        if first.kind == 0x0040 {
            deploy_result(failure_result_from_rep(history.history_check_claim(key, item, raw, first)))?
            continue
        }
        let mut at = 112u64
        while at < item.len {
            let frame = deploy_result(failure_result_from_rep(manifest.disk_frame_bytes(key, remote, raw, at)))?
            if frame.kind == 0x0090 || frame.kind == 0x00C0 {
                return Error(Store(failure_from_rep(format.disk_fault(key, at, Malformed))))
            }
            deploy_result(failure_result_from_rep(manifest.disk_check_frame_kind(key, remote, frame.kind, frame.flags, at)))?
            let check = deploy_result(failure_result_from_rep(types.capacity(format.disk_check(ctx, offset, list.slice(raw, at, frame.payload), list.slice(raw, frame.payload, frame.end)))))?
            list.set_word_le(mut raw, at + 8, check)
            offset += frame.end - at
            at = frame.end
        }
        export_write(mut output, list.slice(raw, 112, item.len))?
    }
    if offset != stamp.end {
        return Error(ExportMismatch)
    }
    scratch_result(failure_result_from_rep(manifest.disk_io(host.sync(mut output))))?
    scratch_result(failure_result_from_rep(manifest.disk_io(host.close(take output))))
}

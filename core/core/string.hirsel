// Module `string` (SEM-3).

pub fn new() -> String

pub fn from(s: String) -> Result[String, Capacity] {
    let src = string.as_bytes(s)
    // Exact capacity: the copy's length.
    let mut b: Bytes = list.with_capacity(list.len(src))?
    let _ = list.append(mut b, src)
    Ok(of_bytes(take b))
}

pub fn from_utf8(take b: Bytes) -> Result[String, Bytes] {
    let n = list.len(b)
    let mut i: u64 = 0
    while i < n {
        let x = b[i]
        // The scalar's width and the range of its second byte (RFC 3629, section 4).
        let mut w: u64 = 1
        let mut lo: u8 = 0x80
        let mut hi: u8 = 0xBF
        if x < 0x80 {
        } else if x >= 0xC2 && x <= 0xDF {
            w = 2
        } else if x == 0xE0 {
            w = 3
            lo = 0xA0
        } else if x == 0xED {
            w = 3
            hi = 0x9F
        } else if x >= 0xE1 && x <= 0xEF {
            w = 3
        } else if x == 0xF0 {
            w = 4
            lo = 0x90
        } else if x == 0xF4 {
            w = 4
            hi = 0x8F
        } else if x >= 0xF1 && x <= 0xF3 {
            w = 4
        } else {
            return Error(take b)
        }
        if n - i < w {
            return Error(take b)
        }
        for k in 1 .. w {
            let y = b[i + k]
            if y < lo || y > hi {
                return Error(take b)
            }
            lo = 0x80
            hi = 0xBF
        }
        i += w
    }
    Ok(of_bytes(take b))
}

pub fn into_bytes(take s: String) -> Result[Bytes, (Capacity, String)] {
    if list.capacity(string.as_bytes(s)) != 0 {
        return Ok(to_bytes(take s))
    }
    // Static storage: copied into exact capacity.
    let copied: Result[Bytes, Capacity] = list.with_capacity(string.byte_len(s))
    match copied {
        Ok(take b) => {
            let mut out = b
            let _ = list.append(mut out, string.as_bytes(s))
            Ok(take out)
        },
        Error(c) => Error((c, take s)),
    }
}

pub fn as_bytes(s: String) -> View[Bytes] in s
pub fn slice(s: String, lo: u64, hi: u64) -> View[String] in s {
    let b = string.as_bytes(s)
    // Bounds when lo > hi or hi is past the length.
    let v = list.slice(b, lo, hi)
    let n = list.len(b)
    if (lo < n && (b[lo] & 0xC0) == 0x80) || (hi < n && (b[hi] & 0xC0) == 0x80) {
        // Inside a scalar: Bounds, raised by the index n, which is past the end.
        let _ = b[n]
    }
    view_string(v)
}

pub fn next_scalar(s: String, at: u64) -> Option[(char, u64)] {
    let b = string.as_bytes(s)
    let n = list.len(b)
    if at == n {
        return None
    }
    // Past the end, b[at] fails with Bounds.
    let x = b[at]
    if (x & 0xC0) == 0x80 {
        // Inside a scalar: Bounds, raised by the index n, which is past the end.
        let _ = b[n]
    }
    let w: u64 = if x < 0x80 {
        1
    } else if x < 0xE0 {
        2
    } else if x < 0xF0 {
        3
    } else {
        4
    }
    let lead: u8 = if w == 1 {
        x
    } else if w == 2 {
        x & 0x1F
    } else if w == 3 {
        x & 0x0F
    } else {
        x & 0x07
    }
    let mut v: u32 = int.widen(lead)
    for k in 1 .. w {
        let y: u32 = int.widen(b[at + k] & 0x3F)
        v = (v << 6) | y
    }
    // s is valid UTF-8, so v is a scalar.
    Some((option.unwrap(char.from_u32(v)), at + w))
}

pub fn byte_len(s: String) -> u64
pub fn push(mut s: String, t: String) -> Result[(), Capacity]

pub fn push_char(mut s: String, c: char) -> Result[(), Capacity] {
    let v = char.to_u32(c)
    let w: u64 = if v < 0x80 {
        1
    } else if v < 0x800 {
        2
    } else if v < 0x10000 {
        3
    } else {
        4
    }
    string.reserve(mut s, w)?
    let prefix: u32 = if w == 1 {
        0
    } else if w == 2 {
        0xC0
    } else if w == 3 {
        0xE0
    } else {
        0xF0
    }
    let mut shift: u32 = int.narrow(6 * (w - 1))
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    let _ = list.push(mut b, int.truncate(prefix | (v >> shift)))
    while shift > 0 {
        shift -= 6
        let _ = list.push(mut b, int.truncate(0x80 | ((v >> shift) & 0x3F)))
    }
    s = of_bytes(take b)
    Ok(())
}

pub fn push_u64(mut s: String, n: u64) -> Result[(), Capacity] {
    // The digit count w and the place value of the leading digit.
    let mut w: u64 = 1
    let mut place: u64 = 1
    while n / place >= 10 {
        place *= 10
        w += 1
    }
    string.reserve(mut s, w)?
    let owned = replace(mut s, string.new())
    let mut b = to_bytes(take owned)
    loop {
        let d: u8 = int.truncate(n / place % 10)
        let _ = list.push(mut b, b'0' + d)
        if place == 1 {
            break
        }
        place = place / 10
    }
    s = of_bytes(take b)
    Ok(())
}

pub fn reserve(mut s: String, n: u64) -> Result[(), Capacity]

pub fn truncate(mut s: String, n: u64) {
    {
        let b = string.as_bytes(s)
        let len = list.len(b)
        if n > len || (n < len && (b[n] & 0xC0) == 0x80) {
            // Past the length or inside a scalar: Bounds, raised by the index len.
            let _ = b[len]
        }
    }
    let owned = replace(mut s, string.new())
    let mut kept = to_bytes(take owned)
    while list.len(kept) > n {
        let _ = list.pop(mut kept)
    }
    s = of_bytes(take kept)
}

// The kernel: the String carrier and the Bytes carrier are one layout. of_bytes and
// view_string are called only on UTF-8 that is whole scalars; to_bytes keeps any static,
// capacity-0 storage.
fn of_bytes(take b: Bytes) -> String
fn to_bytes(take s: String) -> Bytes
fn view_string(b: Bytes) -> View[String] in b

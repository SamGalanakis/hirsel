fn encode_staged(ci: CallInfo, base: Option[View[pages.PageTree]], prior_stamp: Option[u64], tiered: Option[View[List[Option[format.TieredDataDelta]]]], mut ops: pages.DataRows, order: format.DataOrder, tail: u64, streams: pages.DataRows, call: Option[format.CallSection], rec: Option[CallRecord], settlement: Option[format.Settlement], keyed: Option[format.KeyedDraft], seq: u64, offset: u64, frame_limit: u64) -> Result[Bytes, Capacity] {
    if let Some(record) = rec {
        return encode_frame(ci, base, prior_stamp, tiered, mut ops, order, tail, streams, Some(format.CallView(key: view record.key, args: view record.args, issuer: record.stream.caller.issuer, subject: view record.stream.caller.subject, t: record.stream.id.t, n: record.stream.id.n, revision: view record.revision, code: view record.code)), settlement, keyed, seq, offset, frame_limit)
    }
    match call {
        Some(section) => encode_frame(ci, base, prior_stamp, tiered, mut ops, order, tail, streams, Some(format.CallView(key: view section.record.key, args: view section.record.args, issuer: section.record.stream.caller.issuer, subject: view section.record.stream.caller.subject, t: section.record.stream.id.t, n: section.record.stream.id.n, revision: view section.record.revision, code: view section.record.code)), section.settlement, keyed, seq, offset, frame_limit),
        None => encode_frame(ci, base, prior_stamp, tiered, mut ops, order, tail, streams, None, None, keyed, seq, offset, frame_limit),
    }
}

fn encode_frame(ci: CallInfo, base: Option[View[pages.PageTree]], prior_stamp: Option[u64], tiered: Option[View[List[Option[format.TieredDataDelta]]]], mut ops: pages.DataRows, order: format.DataOrder, tail: u64, streams: pages.DataRows, call: Option[format.CallView], settlement: Option[format.Settlement], keyed: Option[format.KeyedDraft], seq: u64, offset: u64, frame_limit: u64) -> Result[Bytes, Capacity] {
    let keyed_size = match keyed {
        Some(draft) => format.keyed_frame_bytes(draft.edits),
        None => 0u64
    }
    let data = pages.data_row_count(ops) != 0 || (pages.data_row_count(streams) == 0 && keyed_size == 0)
    let control = pages.stream_control_slot(streams)
    let control_count = if let Some(_) = control {
        1u64
    } else {
        0u64
    }
    let stream_count = pages.data_row_count(streams) - control_count
    let sections = (if data {
        1u64
    } else {
        0u64
    }) + (if stream_count != 0u64 {
        1u64
    } else {
        0u64
    }) + control_count
    let keyed_sections = if keyed_size == 0 {
        0u64
    } else {
        1u64
    }
    let mut size = 21 + 5 * sections + keyed_size
    for slot in 0u64 .. pages.data_row_count(ops) {
        let operation = pages.data_row(ops, slot)
        size += format.data_op_size(operation, false)
    }
    for slot in 0u64 .. pages.data_row_count(streams) {
        let operation = pages.data_row(streams, slot)
        size += format.data_op_size(operation, true)
        if let (Some(_), Some(record)) = (view operation.value, view call) {
            if format.stream_record_matches(operation.key, record.issuer, record.subject, record.t, record.n) {
                size += format.call_section_bytes(record.key, record.args, record.revision, record.code, settlement)
            }
        }
    }
    if size + 16 > frame_limit {
        return Error(Capacity(requested: size + 16, available: frame_limit))
    }
    let room = 16 + size + format.BINDING_BYTES
    let mut out: Bytes = if tail == 0 {
        bytebuf.from_tail(mut ops.first[0].key, room)
    } else if tail == 1 {
        bytebuf.from_tail(mut ops.first[1].key, room)
    } else if tail < pages.OPEN_FRAME_TAIL {
        bytebuf.from_tail(mut ops.rest[tail - 2].key, room)
    } else {
        list.with_capacity(room)
    }
    format.le(mut out, 0x0011, 2)?
    format.le(mut out, 1, 2)?
    format.le(mut out, size, 4)?
    format.le(mut out, 0, 8)?
    format.le(mut out, int.widen(ci.id.branch), 4)?
    format.le(mut out, ci.id.version, 8)?
    format.le(mut out, ci.at, 8)?
    format.le(mut out, sections + keyed_sections, 1)?
    if data {
        encode_data_ops(mut out, base, prior_stamp, tiered, ops, order)?
    }
    if stream_count != 0u64 {
        encode_stream_ops(mut out, streams, stream_count, call, settlement)?
    }
    if let Some(slot) = control {
        format.le(mut out, 2u64, 1u64)?
        format.le(mut out, 1u64, 4u64)?
        let operation = pages.data_row(streams, slot)
        format.encode_data_op(mut out, operation.key, operation.value, None)?
    }
    if let Some(draft) = keyed {
        format.encode_keyed_edits(mut out, draft.edits)?
    }
    format.seal_frame(mut out, format.DiskContext(store: store_key_to_rep(ci.id.store), role: 2, seq: seq), offset)?
    Ok(take out)
}

fn ordered_row(ops: pages.DataRows, order: format.DataOrder, slot_order: u64) -> View[format.DataOp] in ops {
    let slot = match order {
        InOrder => slot_order,
        ReversePair => 1 - slot_order,
        SortedSlots(slots) => slots[slot_order],
    }
    pages.data_row(ops, slot)
}

fn encode_data_ops(mut payload: Bytes, base: Option[View[pages.PageTree]], prior_stamp: Option[u64], tiered: Option[View[List[Option[format.TieredDataDelta]]]], ops: pages.DataRows, order: format.DataOrder) -> Result[(), Capacity] {
    let use_cached_prior = match base {
        Some(head) => prior_stamp == Some(pages.tree_stamp(head)),
        None => false,
    }
    format.le(mut payload, 0, 1)?
    format.le(mut payload, pages.data_row_count(ops), 4)?
    for slot_order in 0u64 .. pages.data_row_count(ops) {
        let op = ordered_row(ops, order, slot_order)
        let delta = match tiered {
            Some(slots) => slots[slot_order],
            None => None,
        }
        if let Some(trim) = op.trim {
            let dropped = match delta {
                Some(TieredDropped(bytes_dropped)) => bytes_dropped,
                _ => trim.dropped,
            }
            format.encode_log_trim(mut payload, op.key, trim.floor, dropped)
            continue
        }
        let prior = match (delta, use_cached_prior, op.prior, base) {
            (Some(TieredPrior(prior)), _, _, _) => prior,
            (_, true, Some(prior), _) => prior,
            (_, _, _, Some(head)) => {
                if pages.collection_kind(head, list.slice(op.key, 0, 4)) == Some(LogCollection) {
                    0u32
                } else {
                    format.stored_prior(pages.get_page_row(head, op.key))
                }
            },
            (_, _, _, None) => 0,
        }
        format.encode_data_op(mut payload, op.key, op.value, Some(prior))?
    }
    Ok(())
}

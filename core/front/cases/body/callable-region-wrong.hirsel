// The result belongs to the supplied Region, not a same-position caller parameter.
// expect: refuse LANG-11 at 7:3
stable type Doc { value: u64 }
fn parse(r: Region) -> Result[Doc in r, Capacity] { Error(Capacity(requested: 1, available: 0)) }
fn wrong(r: Region, other: Region) -> Result[Doc in r, Capacity] {
  let cb = parse
  cb(other)
}

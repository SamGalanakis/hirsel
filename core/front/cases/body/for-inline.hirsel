// expect: run sum(0) = 31
// expect: run skip(0) = 20
// expect: run stop(0) = 7
// expect: run nested(0) = 21
// expect: run empty(0) = 0
// expect: run tuples(0) = 33
fn sum(x: u64) -> u64 {
    let xs: Inline[u64, 3] =[7, 11, 13];
    let mut s: u64 = x;
    for v in xs {
        s += v
    };
    s
}

fn skip(x: u64) -> u64 {
    let xs =[7u64, 11u64, 13u64];
    let mut s: u64 = x;
    for v in xs {
        if v == 11 {
            continue
        };
        s += v
    };
    s
}

fn stop(x: u64) -> u64 {
    let xs =[7u64, 11u64, 13u64];
    let mut s: u64 = x;
    for v in xs {
        if v == 11 {
            break
        };
        s += v
    };
    s
}

fn nested(x: u64) -> u64 {
    let xs: Inline[Inline[u64, 2], 2] =[[3, 5],[6, 7]]
    let mut s: u64 = x
    for row in xs {
        for v in row {
            s += v
        }
    }
    s
}

fn empty(x: u64) -> u64 {
    let xs: Inline[u64, 0] =[];
    let mut s = x;
    for _ in xs {
        s += 1
    };
    s
}

type Pair {
    a: u64,
    b: u64
}

fn tuples(x: u64) -> u64 {
    let xs =[Pair(a: 7, b: 8), Pair(a: 9, b: 9)]
    let mut s = x
    for Pair(a: a, b: b) in xs {
        s += a + b
    }
    s
}

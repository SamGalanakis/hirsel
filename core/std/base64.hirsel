fn value(x: u8) -> u8 {
    VALUES[int.widen(x)]
}

/// Appends RFC 4648's standard alphabet with '=' padding. O(n).
/// Capacity leaves out unchanged. Ex: `base64.encode(b, mut out)`.
pub fn encode(b: Bytes, mut out: Bytes) {
    string.append_base64_bytes(b, mut out)
}

/// Encodes RFC 4648's standard alphabet with '=' padding as a new String. O(n).
pub fn encode_string(b: Bytes) -> String {
    string.encode_base64(b)
}

/// Encodes RFC 4648 section 5, with '=' padding when padded is true. O(n).
pub fn encode_url(b: Bytes, padded: bool) -> String {
    let mut out: Bytes = list.new()
    string.append_base64_bytes(b, mut out)
    let mut end = list.len(out)
    if !padded {
        while end > 0 && out[end - 1] == b'=' {
            end -= 1
        }
        list.truncate(mut out, end)
    }
    for i in 0 .. end {
        if out[i] == b'+' {
            out[i] = b'-'
        } else if out[i] == b'/' {
            out[i] = b'_'
        }
    }
    result.unwrap(string.from_utf8(take out))
}

fn decode_value(b: u8, url: bool) -> u8 {
    if url {
        match b {
            b'-' => 62,
            b'_' => 63,
            b'+' => 255,
            b'/' => 255,
            _ => value(b),
        }
    } else {
        value(b)
    }
}

// Added (mod 256) to a digit by its high nibble; '/' (0x2f) takes entry 1.
const ROLL: Inline[u8, 16] =[0, 16, 19, 4, 191, 191, 185, 185, 0, 0, 0, 0, 0, 0, 0, 0]

// Each u32 lane holds 24 output bits in its low three bytes, high byte first.
const PACK: Inline[u8, 32] =[2, 1, 0, 6, 5, 4, 10, 9, 8, 14, 13, 12, 18, 17, 16, 22, 21, 20, 26, 25, 24, 30, 29, 28, 255, 255, 255, 255, 255, 255, 255, 255]

fn invalid_blocks(b: Bytes, end: u64) -> bool {
    let mut src: u64 = 0
    let mut bad: Simd[u8, 32] = simd.splat(0)
    while src < end {
        let v: Simd[u8, 32] = list.lanes(b, src)
        // Fold ASCII case. Bias each range's first byte to signed -128,
        // so one signed comparison tests both bounds of that range.
        let letters: Simd[i8, 32] = simd.cast(simd.wrapping_add(v | simd.splat(32), simd.splat(31)))
        let digits: Simd[i8, 32] = simd.cast(simd.wrapping_add(v, simd.splat(80)))
        let alnum: Simd[u8, 32] = simd.cast(simd.lt(letters, simd.splat(-102)) | simd.lt(digits, simd.splat(-118)))
        // '+' and '/' differ only in bit 2.
        let punctuation = simd.eq(v & simd.splat(0xfb), simd.splat(b'+'))
        bad |= ~(alnum | punctuation)
        src += 32
    }
    simd.any(bad)
}

fn decode_blocks(b: Bytes, end: u64, mut out: Bytes) {
    let mut src: u64 = 0
    // 32 valid digits become 24 bytes.
    while src < end {
        let v: Simd[u8, 32] = list.lanes(b, src)
        let slash = simd.eq(v, simd.splat(b'/'))
        let roll = simd.swizzle(simd.from(ROLL), simd.wrapping_add(v >> 4, slash))
        let d = simd.wrapping_add(v, roll)
        let p: Simd[u16, 16] = simd.cast(d)
        let q: Simd[u32, 8] = simd.cast(((p & simd.splat(63)) << 6) | (p >> 8))
        let r: Simd[u8, 32] = simd.cast(((q & simd.splat(4095)) << 12) | (q >> 16))
        list.put_lanes(mut out, simd.swizzle(r, simd.from(PACK)), 24)
        src += 32
    }
}

/// Decodes canonical padded RFC 4648 bytes. Ok(None) means malformed input,
/// Error means Capacity. Whitespace, missing padding and nonzero pad bits fail.
/// O(n); validates before allocating. Ex: `base64.decode(key)`.
pub fn decode(b: Bytes) -> Option[Bytes] {
    decode_alphabet(b, false, true)
}

/// Decodes canonical RFC 4648 section 5 bytes. The padded form requires '='
/// where needed. The unpadded form rejects '='. None means malformed input.
pub fn decode_url(b: Bytes, padded: bool) -> Option[Bytes] {
    decode_alphabet(b, true, padded)
}

fn decode_alphabet(b: Bytes, url: bool, padded: bool) -> Option[Bytes] {
    let n = list.len(b)
    let mut digits = n
    if padded {
        if n % 4 != 0 {
            return None
        }
        if n > 0 && b[n - 1] == b'=' {
            digits -= 1
            if b[n - 2] == b'=' {
                digits -= 1
            }
        }
    }
    let tail = digits % 4
    if tail == 1 {
        return None
    }
    let full = digits - tail
    let end: u64 = if url {
        0
    } else {
        full - full % 32
    }
    if invalid_blocks(b, end) {
        return None
    }
    let mut src = end
    while src < full {
        if (decode_value(b[src], url) | decode_value(b[src + 1], url) | decode_value(b[src + 2], url) | decode_value(b[src + 3], url)) == 255 {
            return None
        }
        src += 4
    }
    let mut first: u8 = 0
    let mut second: u8 = 0
    if tail > 0 {
        let a = decode_value(b[full], url)
        let c = decode_value(b[full + 1], url)
        let d: u8 = if tail == 3 {
            decode_value(b[full + 2], url)
        } else {
            0
        }
        if (a | c | d) == 255 || (tail == 2 && c & 15 != 0) || d & 3 != 0 {
            return None
        }
        first = (a << 2) | (c >> 4)
        second = (c << 4) | (d >> 2)
    }
    let size = digits / 4 * 3 + tail * 3 / 4
    let mut out: Bytes = list.with_capacity(size)
    decode_blocks(b, end, mut out)
    src = end
    let mut dst = list.len(out)
    list.fill(mut out, size - dst, 0)
    while src < full {
        let a = decode_value(b[src], url)
        let c = decode_value(b[src + 1], url)
        let d = decode_value(b[src + 2], url)
        let e = decode_value(b[src + 3], url)
        out[dst] = (a << 2) | (c >> 4)
        out[dst + 1] = (c << 4) | (d >> 2)
        out[dst + 2] = (d << 6) | e
        src += 4
        dst += 3
    }
    if tail > 0 {
        out[dst] = first
        if tail == 3 {
            out[dst + 1] = second
        }
    }
    Some(take out)
}

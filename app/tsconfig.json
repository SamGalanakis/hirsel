{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // The repo-root plugins/*/ui modules sit outside the tree that reaches
      // app/node_modules, so their `solid-js` imports are pinned here the same
      // way vite.config.ts pins them for the bundler. Same physical package.
      "solid-js": ["node_modules/solid-js"],
      "solid-js/*": ["node_modules/solid-js/*"]
    }
  },
  // The repo-root `plugins/*/ui` modules are compiled into this app by the Vite
  // glob in src/plugins/loader.ts, so they are typechecked with it.
  "include": ["src", "vite.config.ts", "vitest.setup.ts", "../plugins/*/ui"]
}

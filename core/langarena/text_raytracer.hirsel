// kostya/LangArena 3c9f84d benchmarks/text_raytracer.rs.
type Vec3 {
    x: f64,
    y: f64,
    z: f64
}

type Sphere {
    center: Vec3,
    radius: f64,
    color: Vec3
}

fn vector(x: f64, y: f64, z: f64) -> Vec3 {
    Vec3(x: x, y: y, z: z)
}

fn scale(v: Vec3, s: f64) -> Vec3 {
    vector(v.x * s, v.y * s, v.z * s)
}

fn add(a: Vec3, b: Vec3) -> Vec3 {
    vector(a.x + b.x, a.y + b.y, a.z + b.z)
}

fn sub(a: Vec3, b: Vec3) -> Vec3 {
    vector(a.x - b.x, a.y - b.y, a.z - b.z)
}

fn dot(a: Vec3, b: Vec3) -> f64 {
    a.x * b.x + a.y * b.y + a.z * b.z
}

fn normal(v: Vec3) -> Vec3 {
    scale(v, 1.0 / float.sqrt(dot(v, v)))
}

fn below(a: f64, b: f64) -> bool {
    match float.total_order(a, b) {
        Less => true,
        _ => false
    }
}

fn above(a: f64, b: f64) -> bool {
    match float.total_order(a, b) {
        Greater => true,
        _ => false
    }
}

fn intersect(dir: Vec3, obj: Sphere) -> Option[f64] {
    let tca = dot(obj.center, dir)
    if below(tca, 0.0) {
        return None
    }
    let d2 = dot(obj.center, obj.center) - tca * tca
    let r2 = obj.radius * obj.radius
    if above(d2, r2) {
        return None
    }
    let t0 = tca - float.sqrt(r2 - d2)
    if above(t0, 10000.0) {
        None
    } else {
        Some(t0)
    }
}

fn shade(dir: Vec3, obj: Sphere, t: f64) -> u64 {
    let pi = add(vector(0.0, 0.0, 0.0), scale(dir, t))
    let n = normal(sub(pi, obj.center))
    let light_dir = normal(sub(vector(0.7, -1.0, 1.7), pi))
    let lam1 = dot(light_dir, n)
    let lam2: f64 = if below(lam1, 0.0) {
        0.0
    } else if above(lam1, 1.0) {
        1.0
    } else {
        lam1
    }
    let color = add(scale(vector(1.0, 1.0, 1.0), lam2 * 0.5), scale(obj.color, 0.3))
    let col = (color.x + color.y + color.z) / 3.0
    let index: Result[u64, FloatError] = float.to_int(float.floor(col * 6.0))
    result.unwrap(index)
}

pub fn dispatch(config: String, name: String, warmup: u64, iterations: u64) -> Result[u32, helper.Error] {
    if name != "Etc::TextRaytracer" {
        return Error(UnknownTask)
    }
    let wi = helper.config_i64(config, name, "w")?
    let hi = helper.config_i64(config, name, "h")?
    if wi <= 0 || hi <= 0 {
        return Error(Config)
    }
    let w: u64 = int.narrow(wi)
    let h: u64 = int.narrow(hi)
    let fw: f64 = float.from_int(w)
    let fh: f64 = float.from_int(h)
    let scene: Inline[Sphere, 3] =[Sphere(center: vector(-1.0, 0.0, 3.0), radius: 0.3, color: vector(1.0, 0.0, 0.0)), Sphere(center: vector(0.0, 0.0, 3.0), radius: 0.8, color: vector(0.0, 1.0, 0.0)), Sphere(center: vector(1.0, 0.0, 3.0), radius: 0.4, color: vector(0.0, 0.0, 1.0))]
    let lut: Inline[u32, 6] =[46u32, 45u32, 43u32, 42u32, 88u32, 77u32]
    let mut total: u32 = 0
    for _ in 0 .. warmup + iterations {
        for j in 0 .. h {
            let fj: f64 = float.from_int(j)
            for i in 0 .. w {
                let fi: f64 = float.from_int(i)
                let dir = normal(vector((fi - fw / 2.0) / fw, (fj - fh / 2.0) / fh, 1.0))
                let mut pixel: u32 = 32
                for obj in scene {
                    if let Some(t) = intersect(dir, obj) {
                        let at = shade(dir, obj, t)
                        if at < 6 {
                            pixel = lut[at]
                        }
                        break
                    }
                }
                total = int.wrapping_add(total, pixel)
            }
        }
    }
    Ok(total)
}

pub fn main(out: Stdout, d: Dir, argv: Args) -> Result[(), Exit] waits {
    harness.main(out, d, argv, fn(c: String, n: String, w: u64, i: u64) -> Result[u32, helper.Error] {
        dispatch(c, n, w, i)
    })
}

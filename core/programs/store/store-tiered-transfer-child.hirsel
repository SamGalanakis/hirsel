// ---------------------------------------------------------------------------
// Child Tiered scratch cuts, streaming inventory/row emission, deferred diffs
// ---------------------------------------------------------------------------
// Emits every Hot Tiered page and blob in `tree` into class-4/class-3 scratch
// packs in the child's export directory `d`, seals `tree` to ColdPage slots,
// and updates `tree.paging` so PagerDirect can read them back.
fn child_cut_tiered(mut tree: PageTree, d: Dir, id: StoreId, mut next_pack: u64, pack_bytes: u64, next_stamp: u64) -> Result[(), Error] waits {
    let mut roots: List[Roots] = list.with_capacity(1)
    let mut empty = empty_roots()
    empty.collections = share_page_tree(tree)
    list.push(mut roots, take empty)
    let TieredCutFrames(pages: take pages, blobs: take blobs, ..) = tiered_cut_frames(roots)?
    if list.len(pages) == 0 && list.len(blobs) == 0 {
        return Ok(())
    }
    let blob_run = layout_tiered_packs(take blobs, 4, next_pack, pack_bytes)?
    let page_run = layout_tiered_packs(take pages, 3, blob_run.next_pack, pack_bytes)?
    let mut emitted: Map[u64, std.page.PagePtr] = map.new()
    let mut packs: List[TieredCutPack] = list.new()
    encode_tiered_run(id, blob_run, mut emitted, mut packs)?
    encode_tiered_run(id, page_run, mut emitted, mut packs)?
    let mut existing = match view tree.paging {
        Some(inv) => std.omap.snapshot(inv.packs),
        None => std.omap.new(),
    }
    let mut map_ids = match view tree.paging {
        Some(inv) => inv.generation + 1000000u64,
        None => 1000000u64,
    }
    for written in packs {
        let name = paged_pack_path(written.seq)?
        disk_write_synced(d, name, written.wire)?
        let pager_pack = TieredPagerPack(inventory: written.pack, object: None)
        let (take updated, _) = std.omap.insert(mut map_ids, take existing, written.seq, pager_pack)
        existing = take updated
    }
    let mut sealed = seal_holder_tiered(tree, emitted)?
    let gen = match view tree.paging {
        Some(inv) => inv.generation + 1,
        None => 1u64,
    }
    let highest = match view tree.paging {
        Some(inv) => order.max(inv.next_stamp, next_stamp + 1),
        None => next_stamp + 1,
    }
    sealed.paging = Some(arc.new(TieredReadInventory(packs: take existing, generation: gen, next_stamp: highest)))
    tree = take sealed
    next_pack = page_run.next_pack
    Ok(())
}

// Measures Hot bytes currently held in Tiered pages/blobs of `tree`.
fn tiered_tree_hot_bytes(tree: PageTree) -> Result[u64, Error] {
    let mut roots: List[Roots] = list.with_capacity(1)
    let mut empty = empty_roots()
    empty.collections = share_page_tree(tree)
    list.push(mut roots, take empty)
    let TieredCutFrames(pages: pages, blobs: blobs, ..) = tiered_cut_frames(roots)?
    let mut total = 0u64
    for item in pages {
        total = int.saturating_add(total, item.frame.size)
    }
    for item in blobs {
        total = int.saturating_add(total, item.frame.size)
    }
    Ok(total)
}

fn tiered_range_inventory_direct(d: Dir, id: StoreId, writer_pin_bytes: u64, snap: Snapshot, collection_id: u32) -> Result[(u64, u64), Error] waits {
    let Some(inventory) = view snap.roots.collections.paging else {
        return Error(Io(Closed))
    }
    let low = prefix(collection_id)?
    let high = prefix(collection_id + 1u32)?
    let mut previous: Option[Bytes] = None
    let mut row_total = 0u64
    let mut checksum = std.check.start()
    while let Some((take key, value, take resume)) = snapshot_tiered_span_step_direct(d, id, writer_pin_bytes, snap, inventory, low, high, previous)? {
        checksum_row(mut checksum, key, value)?
        row_total += 1
        previous = Some(take resume)
    }
    Ok((row_total, std.check.finish(checksum)))
}

fn write_tiered_prepared_rows_direct(mut file: FrameFile, d: Dir, id: StoreId, writer_pin_bytes: u64, snap: Snapshot, collection_id: u32, row_codec: std.codec.Codec[PreparedRow]) -> Result[(), DeployError] waits {
    let Some(inventory) = view snap.roots.collections.paging else {
        return Error(Store(Io(Closed)))
    }
    let low = deploy_result(prefix(collection_id))?
    let high = deploy_result(prefix(collection_id + 1u32))?
    let mut previous: Option[Bytes] = None
    while let Some((take key, value, take resume)) = deploy_result(snapshot_tiered_span_step_direct(d, id, writer_pin_bytes, snap, inventory, low, high, previous))? {
        let row = PreparedRow(key: take key, value: deploy_result(copied(value))?)
        scratch_result(write_prepared_frame(mut file, 0x0084, row_codec, row))?
        previous = Some(take resume)
    }
    Ok(())
}

// Finishes every deferred Tiered range diff at the two captured roots
// (`before` and `after`) through PagerDirect on `d`. Any deferred range that
// cannot be finished (e.g. missing paging inventory) returns `Drift`.
fn catch_up_tiered_diffs(d: Dir, id: StoreId, writer_pin_bytes: u64, before: Snapshot, after: Snapshot, deferred: List[TieredRowDiff]) -> Result[List[CatchUpChange], DeployError] waits {
    let mut out: List[CatchUpChange] = list.new()
    for diff in deferred {
        if (diff.before && !snapshot_paged(before)) || (diff.after && !snapshot_paged(after)) {
            return Error(Drift)
        }
        let low = match diff.start {
            Some(suffix) => deploy_result(logical_key(diff.id, suffix))?,
            None => deploy_result(prefix(diff.id))?,
        }
        let high = match diff.stop {
            Some(suffix) => deploy_result(logical_key(diff.id, suffix))?,
            None => deploy_result(prefix(diff.id + 1u32))?,
        }
        let mut left_prev: Option[Bytes] = None
        let mut right_prev: Option[Bytes] = None
        let mut left_cur: Option[(Bytes, Arc[Bytes])] = None
        let mut right_cur: Option[(Bytes, Arc[Bytes])] = None
        let mut left_done = !diff.before
        let mut right_done = !diff.after
        loop {
            if !left_done && left_cur == None {
                let next_left = deploy_result(catch_up_next_row(d, id, writer_pin_bytes, before, diff.id, low, high, left_prev))?
                match take next_left {
                    Some((take k, take v, take res)) => {
                        left_prev = Some(take res)
                        left_cur = Some((take k, take v))
                    },
                    None => {
                        left_done = true
                    },
                }
            }
            if !right_done && right_cur == None {
                let next_right = deploy_result(catch_up_next_row(d, id, writer_pin_bytes, after, diff.id, low, high, right_prev))?
                match take next_right {
                    Some((take k, take v, take res)) => {
                        right_prev = Some(take res)
                        right_cur = Some((take k, take v))
                    },
                    None => {
                        right_done = true
                    },
                }
            }
            let cmp = match (view left_cur, view right_cur) {
                (None, None) => break,
                (None, Some(_)) => Greater,
                (Some(_), None) => Less,
                (Some((lk, _)), Some((rk, _))) => list.compare_bytes(lk, rk),
            }
            match cmp {
                Less => {
                    let Some((take lk, take lv)) = replace(mut left_cur, None) else {
                        break
                    }
                    list.push(mut out, CatchUpChange(tree_key: take lk, before: Some(take lv), after: None))
                },
                Greater => {
                    let Some((take rk, take rv)) = replace(mut right_cur, None) else {
                        break
                    }
                    list.push(mut out, CatchUpChange(tree_key: take rk, before: None, after: Some(take rv)))
                },
                Equal => {
                    let Some((_, take lv)) = replace(mut left_cur, None) else {
                        break
                    }
                    let Some((take rk, take rv)) = replace(mut right_cur, None) else {
                        break
                    }
                    if lv != rv {
                        list.push(mut out, CatchUpChange(tree_key: take rk, before: Some(take lv), after: Some(take rv)))
                    }
                },
            }
        }
    }
    Ok(take out)
}

fn catch_up_next_row(d: Dir, id: StoreId, writer_pin_bytes: u64, snap: Snapshot, collection_id: u32, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] waits {
    let key = prefix(collection_id)?
    let Some((_, desc)) = std.page.collection_slot(snap.roots.collections.root, key) else {
        return Ok(None)
    }
    if collection_descriptor(desc).residency != ResidentMemory {
        let Some(inventory) = view snap.roots.collections.paging else {
            return Error(Io(Closed))
        }
        return snapshot_tiered_span_step_direct(d, id, writer_pin_bytes, snap, inventory, low, high, previous)
    }
    let start = match previous {
        Some(prev) => Excluded(copied(prev)?),
        None => Included(copied(low)?),
    }
    let mut cursor = byte_cursor(snap.roots.collections, take start, high)?
    match next_bytes(mut cursor)? {
        Some((take k, take v)) => {
            let res = copied(k)?
            Ok(Some((take k, take v, take res)))
        },
        None => Ok(None),
    }
}

// ---------------------------------------------------------------------------
// Tiered round application on OLD (`apply_round`) and on Child
// ---------------------------------------------------------------------------
// Applies one Tiered round op to `tree` via OLD's writer partition call
// attempt (`db.writer_pin_bytes`).
fn apply_one_tiered_round_op(mut db: Db, mut tree: PageTree, key: Bytes, take value: Option[Bytes], prior: bool, private_from: u64, mut next_stamp: u64) -> Result[(), DeployError] waits {
    let collection_bytes = deploy_result(copied(list.slice(key, 0, 4)))?
    let suffix = deploy_result(copied(list.slice(key, 4, list.len(key))))?
    let mut pins = empty_tiered_pins(tiered_pin_root(open_number(db), 0u32, tree), db.writer_pin_bytes)
    let mut pending: Option[(TieredTarget, Error)] = None
    let replay_val: ReplayValue = match take value {
        Some(take raw) => ReplayPut(arc.new(take raw)),
        None => ReplayAbsent,
    }
    loop {
        let attempt = tiered_attempt(db.writer_pin_bytes, 0)
        let apply_res = disk_allocation(scoped fn() -> Result[Result[(PageTree, u64), DeployError], Error] {
            let mut staged = share_page_tree(tree)
            let staged_inline = staged.inline
            let (take ready, kind_byte, draw0) = {
                let Some((edge, desc)) = std.page.collection_slot(staged.root, collection_bytes) else {
                    return Ok(Error(ImportMalformed))
                }
                let fields = collection_descriptor(desc)
                tiered_seek(attempt, SeekKey(copied(suffix)?))
                let prior_width = tiered_plan_prior(attempt, pins.frames, staged, key)?
                let present = prior_width != 0
                match view replay_val {
                    ReplayPut(_) => if present != prior {
                        return Ok(Error(ImportMalformed))
                    },
                    ReplayAbsent => if !present {
                        return Ok(Error(ImportMalformed))
                    },
                }
                let Some(empty_root) = view staged.empty_collection else {
                    fail("store: missing empty collection page")
                }
                let mut stamp_draw = next_stamp
                let ready = stage_tiered_row(attempt, pins.frames, edge, empty_root, suffix, clone_replay_value(replay_val), staged_inline, fields.kind == LogCollection, private_from, mut stamp_draw)?
                (take ready, descriptor_kind_byte(fields.kind), stamp_draw)
            }
            let mut draw = draw0
            let revised = rooted_collection_record(ready, kind_byte, ResidentTiered)?
            page_result(std.page.insert(mut staged.root, collection_bytes, revised, Some(take ready), staged_inline, private_from, mut draw))?
            restore_planned_root(mut staged.root, collection_bytes, private_from, pins.frames, mut draw)?
            Ok(Ok((take staged, draw)))
        })
        let state = tiered_finish(take attempt)
        match state.stopped {
            None => {
                let inner = deploy_result(take apply_res)?
                let (take updated, draw) = inner?
                tree = take updated
                next_stamp = draw
                return Ok(())
            },
            Some(AttemptMiss(_)) => {
                revoke_parked(mut db)
                deploy_result(deliver_call_miss(db, tree, state, mut pins, mut pending))?
            },
            Some(AttemptPinLimit(problem)) => return Error(Store(Full(Cache(problem)))),
            Some(AttemptAllocation(problem)) => return Error(Store(Full(Allocation(problem)))),
            Some(AttemptFold(_)) => return Error(ImportMalformed),
        }
    }
}

fn clone_replay_value(val: ReplayValue) -> ReplayValue {
    match val {
        ReplayPut(raw) => ReplayPut(arc.share(raw)),
        ReplayAbsent => ReplayAbsent,
    }
}

// Applies a single Tiered point edit on the child using PagerDirect (`d`).
fn child_apply_tiered_op(d: Dir, id: StoreId, writer_pin_bytes: u64, opened: u64, mut tree: PageTree, key: Bytes, value: ReplayValue, private_from: u64, mut next_stamp: u64) -> Result[(), Error] waits {
    let inventory = match view tree.paging {
        Some(inv) => arc.share(inv),
        None => return Error(Io(Closed)),
    }
    let collection_bytes = copied(list.slice(key, 0, 4))?
    let suffix = copied(list.slice(key, 4, list.len(key)))?
    let grant = disk_allocation(scoped fn() -> Result[Arc[TieredReaderGrant], Error] {
        Ok(arc.new(TieredReaderGrant(store: id, opened: opened, pin_bytes: writer_pin_bytes)))
    })?
    let root = tiered_pin_root(opened, 0u32, tree)
    let (take updated, draw) = retry_tiered_read_with(PagerDirect(d, id), std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, suffix, None, TieredPoint, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[(PageTree, u64), Error] {
        let mut staged = share_page_tree(tree)
        let staged_inline = staged.inline
        let (take ready, kind_byte, draw0) = {
            let Some((edge, desc)) = std.page.collection_slot(staged.root, collection_bytes) else {
                return Error(Stale(list.word_be(collection_bytes, 0)))
            }
            let fields = collection_descriptor(desc)
            tiered_seek(attempt, SeekKey(copied(suffix)?))
            let _ = tiered_plan_prior(attempt, visible, staged, key)?
            let Some(empty_root) = view staged.empty_collection else {
                fail("store: missing empty collection page")
            }
            let mut stamp_draw = next_stamp
            let ready = stage_tiered_row(attempt, visible, edge, empty_root, suffix, clone_replay_value(value), staged_inline, fields.kind == LogCollection, private_from, mut stamp_draw)?
            (take ready, descriptor_kind_byte(fields.kind), stamp_draw)
        }
        let mut draw = draw0
        let revised = rooted_collection_record(ready, kind_byte, ResidentTiered)?
        page_result(std.page.insert(mut staged.root, collection_bytes, revised, Some(take ready), staged_inline, private_from, mut draw))?
        restore_planned_root(mut staged.root, collection_bytes, private_from, visible, mut draw)?
        Ok((take staged, draw))
    })?
    tree = take updated
    next_stamp = draw
    Ok(())
}

// Point lookup on `tree` that works for both Memory and Tiered collections
// via PagerDirect on `d`.
fn child_get_row(d: Dir, id: StoreId, writer_pin_bytes: u64, opened: u64, tree: PageTree, logical: Bytes) -> Result[Option[Bytes], Error] waits {
    if list.len(logical) < 4 {
        return Ok(None)
    }
    let cid: u32 = list.word_be(logical, 0)
    if !table_is_tiered(tree, cid)? {
        return match get_page_row(tree, logical) {
            Some(raw) => Ok(Some(copied(raw)?)),
            None => Ok(None),
        }
    }
    let Some(inventory) = view tree.paging else {
        return Error(Io(Closed))
    }
    read_tiered_point_direct(d, id, inventory, opened, 0u32, writer_pin_bytes, tree, logical, scoped fn(found: Option[View[Bytes]]) -> Result[Option[Bytes], Error] {
        match found {
            Some(raw) => Ok(Some(copied(raw)?)),
            None => Ok(None),
        }
    })
}

// ---------------------------------------------------------------------------
// Queued Cold `stage_rewrite` validation and activation application (§3.5)
// ---------------------------------------------------------------------------
fn child_cut_context(source: Preparation) -> ChildCutContext {
    let next_seq = cell.with(source.next_pack, (), fn(mut v: u64, take _u: ()) -> u64 {
        v
    })
    ChildCutContext(dir: source.dir, store: source.db.store, next_pack: next_seq, pack_bytes: source.pack_bytes, dirty_bytes: source.dirty_bytes, writer_pin_bytes: source.db.writer_pin_bytes)
}

fn save_child_cut_pack(source: Preparation, next_pack: u64) {
    cell.set(source.next_pack, next_pack)
}

// Runs one writer call attempt over every queued Cold rewrite in `staged`,
// checking existence (`Missing("row")`) and index invariance (`Changed(<ix>)`)
// pinned against `writer_pin_bytes` (`Full(Cache(Capacity))`).
fn check_queued_rewrites(take backend: TieredPageBackend, writer_pin_bytes: u64, opened: u64, store_id: StoreId, staged: StagedMigration, staged_collections: PageTree) -> Result[(), Error] waits {
    if list.len(staged.queued_rewrites) == 0 {
        return Ok(())
    }
    let grant = disk_allocation(scoped fn() -> Result[Arc[TieredReaderGrant], Error] {
        Ok(arc.new(TieredReaderGrant(store: store_id, opened: opened, pin_bytes: writer_pin_bytes)))
    })?
    let inventory = match view staged_collections.paging {
        Some(inv) => arc.share(inv),
        None => match view staged.base_rows.paging {
            Some(inv) => arc.share(inv),
            None => return Error(Io(Closed)),
        },
    }
    let root = TieredPinRoot(domain: opened, branch: 0u32, generation: inventory.generation, root_stamp: tree_stamp(staged_collections))
    let empty_hint: Bytes = list.new()
    retry_tiered_read_with(take backend, std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, empty_hint, None, TieredPoint, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[(), Error] {
        for qr in staged.queued_rewrites {
            let tree = if qr.staged_range {
                view staged_collections
            } else {
                view staged.base_rows
            }
            let old_bytes: Option[Bytes] = if let Some(row) = tiered_replayed_row(tree, qr.logical) {
                match row.now {
                    ReplayPut(v) => Some(copied(v)?),
                    ReplayAbsent => None,
                }
            } else {
                let Some((edge, _)) = std.page.collection_slot(tree.root, list.slice(qr.logical, 0, 4)) else {
                    return Error(Missing("row"))
                }
                tiered_seek(attempt, SeekKey(copied(qr.key)?))
                tiered_reading(attempt, ValuesAt)
                let backing = TieredBorrowedRoot(edge: view edge, pins: view visible)
                match tiered_point_bytes(attempt, backing, qr.key)? {
                    Some(raw) => Some(copied(raw)?),
                    None => None,
                }
            }
            let Some(take old) = take old_bytes else {
                return Error(Missing("row"))
            }
            check_rewrite_indexes(staged.plan, qr.id, qr.schema, qr.key, old, qr.raw)?
        }
        Ok(())
    })
}

fn apply_queued_rewrites(take backend: TieredPageBackend, writer_pin_bytes: u64, opened: u64, store_id: StoreId, mut collections: PageTree, mut next_node: u64, queued: List[QueuedRewrite], mut child_cut: Option[ChildCutContext]) -> Result[List[ActivationRewrite], Error] waits {
    let mut frame_rows: List[ActivationRewrite] = list.new()
    for qr in queued {
        if qr.staged_range {
            if let Some(mut ctx) = child_cut {
                let private_from = stamp_after(next_node)?
                let mut draw = private_from
                child_apply_tiered_op(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, mut collections, copied(qr.logical)?, ReplayPut(arc.new(copied(qr.raw)?)), private_from, mut draw)?
                canonical_tree(mut collections)?
                next_node = draw - 1
                if tiered_tree_hot_bytes(collections)? >= ctx.dirty_bytes {
                    child_cut_tiered(mut collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, next_node)?
                }
            } else {
                let private_from = stamp_after(next_node)?
                let mut draw = private_from
                collections = apply_tiered_rewrite_backend(clone_pager_backend(backend), store_id, writer_pin_bytes, opened, share_page_tree(collections), copied(qr.logical)?, copied(qr.raw)?, private_from, mut draw)?
                canonical_tree(mut collections)?
                next_node = draw - 1
            }
        } else {
            if let None = child_cut {
                let private_from = stamp_after(next_node)?
                let mut draw = private_from
                collections = apply_tiered_rewrite_backend(clone_pager_backend(backend), store_id, writer_pin_bytes, opened, share_page_tree(collections), copied(qr.logical)?, copied(qr.raw)?, private_from, mut draw)?
                canonical_tree(mut collections)?
                next_node = draw - 1
            }
            list.push(mut frame_rows, ActivationRewrite(id: qr.id, key: copied(qr.key)?, value: copied(qr.raw)?))
        }
    }
    Ok(take frame_rows)
}

fn resolve_queued_rewrites(take backend: TieredPageBackend, writer_pin_bytes: u64, opened: u64, store_id: StoreId, mut staged: StagedMigration, mut child_cut: Option[ChildCutContext]) -> Result[List[ActivationRewrite], Error] waits {
    if list.len(staged.queued_rewrites) == 0 {
        return Ok(list.new())
    }
    check_queued_rewrites(clone_pager_backend(backend), writer_pin_bytes, opened, store_id, staged, staged.plan.roots.collections)?
    let queued = replace(mut staged.queued_rewrites, list.new())
    let rows = apply_queued_rewrites(take backend, writer_pin_bytes, opened, store_id, mut staged.plan.roots.collections, mut staged.plan.next_node, queued, mut child_cut)?
    staged.plan.changed = true
    Ok(take rows)
}

fn clone_pager_backend(backend: TieredPageBackend) -> TieredPageBackend {
    match backend {
        PagerTask(sender) => PagerTask(channel.sender(sender)),
        PagerDirect(d, id) => PagerDirect(d, id),
    }
}

fn apply_tiered_rewrite_backend(take backend: TieredPageBackend, id: StoreId, writer_pin_bytes: u64, opened: u64, tree: PageTree, logical: Bytes, take raw: Bytes, private_from: u64, mut next_stamp: u64) -> Result[PageTree, Error] waits {
    let Some(inventory) = view tree.paging else {
        return Error(Io(Closed))
    }
    let collection_bytes = copied(list.slice(logical, 0, 4))?
    let suffix = copied(list.slice(logical, 4, list.len(logical)))?
    let grant = disk_allocation(scoped fn() -> Result[Arc[TieredReaderGrant], Error] {
        Ok(arc.new(TieredReaderGrant(store: id, opened: opened, pin_bytes: writer_pin_bytes)))
    })?
    let root = tiered_pin_root(opened, 0u32, tree)
    let value = ReplayPut(arc.new(take raw))
    let (take updated, draw) = retry_tiered_read_with(take backend, std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, suffix, None, TieredPoint, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[(PageTree, u64), Error] {
        let mut staged = share_page_tree(tree)
        let staged_inline = staged.inline
        let (take ready, kind_byte, draw0) = {
            let Some((edge, desc)) = std.page.collection_slot(staged.root, collection_bytes) else {
                return Error(Missing("row"))
            }
            let fields = collection_descriptor(desc)
            tiered_seek(attempt, SeekKey(copied(suffix)?))
            let _ = tiered_plan_prior(attempt, visible, staged, logical)?
            let Some(empty_root) = view staged.empty_collection else {
                fail("store: missing empty collection page")
            }
            let mut stamp_draw = next_stamp
            let ready = stage_tiered_row(attempt, visible, edge, empty_root, suffix, clone_replay_value(value), staged_inline, fields.kind == LogCollection, private_from, mut stamp_draw)?
            (take ready, descriptor_kind_byte(fields.kind), stamp_draw)
        }
        let mut draw = draw0
        let revised = rooted_collection_record(ready, kind_byte, ResidentTiered)?
        page_result(std.page.insert(mut staged.root, collection_bytes, revised, Some(take ready), staged_inline, private_from, mut draw))?
        restore_planned_root(mut staged.root, collection_bytes, private_from, visible, mut draw)?
        Ok((take staged, draw))
    })?
    next_stamp = draw
    Ok(take updated)
}

// OLD's leased-base check for activation rewrites on Cold rows (§3.5): runs
// as one call attempt on OLD's writer partition against `lease.collections`.
fn validate_rewrite_base_tiered(db: Db, rewrites: List[ActivationRewrite], base_next_table: u32, ranges: List[ValidatedRange]) -> Result[(), DeployError] waits {
    if list.len(rewrites) == 0 {
        return Ok(())
    }
    let Some(lease) = disk_state(db).lease else {
        return Error(ExportMismatch)
    }
    let tree = view lease.collections
    let mut cold_rows: List[(u32, Bytes, Bytes)] = list.new()
    for row in rewrites {
        if row.id == 0 || row.id >= base_next_table {
            return Error(ImportMalformed)
        }
        if let Ok(_) = list.binary_search_by(ranges, scoped fn(checked_range: ValidatedRange) -> Order {
            order.compare(checked_range.id, row.id)
        }) {
            return Error(ImportMalformed)
        }
        let id_key = deploy_result(prefix(row.id))?
        let Some((_, desc)) = std.page.collection_slot(tree.root, id_key) else {
            return Error(ImportMalformed)
        }
        let fields = collection_descriptor(desc)
        if fields.kind != TableCollection {
            return Error(ImportMalformed)
        }
        let logical = logical_key(row.id, row.key) ?=> |_| ImportMalformed
        if fields.residency == ResidentMemory {
            let Some(_) = get_page_row(tree, logical) else {
                return Error(ImportMalformed)
            }
        } else {
            list.push(mut cold_rows, (row.id, deploy_result(copied(row.key))?, take logical))
        }
    }
    if list.len(cold_rows) == 0 {
        return Ok(())
    }
    let Some(inventory) = view tree.paging else {
        return Error(ImportMalformed)
    }
    let backend: TieredPageBackend = match db.pager {
        Some(sender) => PagerTask(channel.sender(sender)),
        None => PagerDirect(deploy_result(log_directory(db))?, db.store),
    }
    let grant = deploy_result(disk_allocation(scoped fn() -> Result[Arc[TieredReaderGrant], Error] {
        Ok(arc.new(TieredReaderGrant(store: db.store, opened: open_number(db), pin_bytes: db.writer_pin_bytes)))
    }))?
    let root = tiered_pin_root(open_number(db), 0u32, tree)
    let empty_hint: Bytes = list.new()
    let checked = retry_tiered_read_with(take backend, std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, grant, root, empty_hint, None, TieredPoint, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[TieredFrame]]) -> Result[bool, Error] {
        for (cid, key, logical) in cold_rows {
            if let Some(replayed) = tiered_replayed_row(tree, logical) {
                match replayed.now {
                    ReplayPut(_) => continue,
                    ReplayAbsent => return Ok(false),
                }
            }
            let Some((edge, _)) = std.page.collection_slot(tree.root, prefix(cid)?) else {
                return Ok(false)
            }
            tiered_seek(attempt, SeekKey(copied(key)?))
            tiered_reading(attempt, ValuesAt)
            let backing = TieredBorrowedRoot(edge: view edge, pins: view visible)
            let Some(_) = tiered_point_bytes(attempt, backing, key)? else {
                return Ok(false)
            }
        }
        Ok(true)
    })
    match take checked {
        Ok(true) => Ok(()),
        Ok(false) => Error(ImportMalformed),
        Error(take problem) => Error(Store(take problem)),
    }
}

// Activation cut rewrite application (§3.5): Memory tables use `insert_row`,
// Tiered tables use a cut read on K (`CUT_PIN_BYTES`) through `retry_fold_edit`.
fn apply_import_rewrites_tiered(db: Db, mut plan: SchemaPlan, rewrites: List[ActivationRewrite]) -> Result[(), DeployError] waits {
    for row in rewrites {
        let key = deploy_result(logical_key(row.id, row.key))?
        let raw = deploy_result(copied(row.value))?
        if !deploy_result(table_is_tiered(plan.roots.collections, row.id))? {
            let _ = deploy_result(insert_row(mut plan.next_node, mut plan.roots, take key, take raw))?
            continue
        }
        let pager: Option[View[Sender[TieredPagerMessage]]] = match db.pager {
            Some(requests) => Some(view requests),
            None => None,
        }
        let id_key = deploy_result(prefix(row.id))?
        let first = deploy_result(stamp_after(plan.next_node))?
        let (take updated, rows, charge, kind_byte, draw0) = {
            let cut = deploy_result(tx_page_source(pager, plan.roots.collections))?
            let Some((edge, desc)) = std.page.collection_slot(plan.roots.collections.root, id_key) else {
                return Error(ImportMalformed)
            }
            let desc_fields = collection_descriptor(desc)
            let kind_byte = descriptor_kind_byte(desc_fields.kind)
            let Some(empty_root) = view plan.roots.collections.empty_collection else {
                fail("store: missing empty collection page")
            }
            let mut stamp_draw = first
            let mut effects: Option[List[TieredFoldEffect]] = None
            let updated = deploy_result(fold_materialize_row(cut, edge, empty_root, key, ReplayRow(base: 0u32, now: ReplayPut(arc.new(take raw))), plan.roots.collections.inline, false, first, mut stamp_draw, mut effects))?
            let (rows, charge) = match view updated {
                HotPage(p) => std.page.totals(p),
                ColdPage(_) => (desc_fields.rows, desc_fields.row_bytes),
            }
            (take updated, rows, charge, kind_byte, stamp_draw)
        }
        let mut draw = draw0
        deploy_result(put_collection_with_residency(mut plan.roots.collections, id_key, Some(take updated), rows, charge, kind_byte, ResidentTiered, first, mut draw))?
        deploy_result(canonical_tree(mut plan.roots.collections))?
        plan.next_node = draw - 1
    }
    Ok(())
}

// ---------------------------------------------------------------------------
// Chunked Tiered `migrate_table` and Tiered declared index build (§4.4)
// ---------------------------------------------------------------------------
// Runs every deferred Tiered `migrate_table` build queued in `plan`, reading
// each source span through `snapshot_tiered_span_step_direct`, converting rows,
// writing into the Tiered target collection, and cutting at `dirty_bytes`.
fn run_deferred_migrates(mut ctx: ChildCutContext, opened: u64, mut plan: SchemaPlan) -> Result[(), Error] waits {
    if list.len(plan.pending_migrates) == 0 {
        return Ok(())
    }
    let pending = replace(mut plan.pending_migrates, list.new())
    for take job in take pending {
        let low = prefix(job.from_id)?
        let high = prefix(job.from_id + 1u32)?
        let mut previous: Option[Bytes] = None
        let mut read = 0u64
        let mut written = 0u64
        loop {
            let mut batch: List[(Bytes, Bytes)] = list.new()
            {
                let snap = Snapshot(store: ctx.store, open: opened, branch: 0u32, head: 0u64, roots: share_roots(plan.roots), watermark: plan.next_node + 1, bases: no_tail_bases())
                let Some(inventory) = view plan.roots.collections.paging else {
                    return Error(Io(Closed))
                }
                while list.len(batch) < INDEX_CHUNK {
                    let Some((take k, v, take res)) = snapshot_tiered_span_step_direct(ctx.dir, ctx.store, ctx.writer_pin_bytes, snap, inventory, low, high, previous)? else {
                        break
                    }
                    list.push(mut batch, (take k, copied(v)?))
                    previous = Some(take res)
                }
            }
            if list.len(batch) == 0 {
                break
            }
            read += list.len(batch)
            let private_from = stamp_after(plan.next_node)?
            let mut draw = private_from
            for (logical, raw) in batch {
                let suffix = list.slice(logical, 4, list.len(logical))
                if let Some((take new_key, take new_raw)) = (job.convert)(suffix, raw)? {
                    let target_key = logical_key(job.to_id, new_key)?
                    if let Some(_) = child_get_row(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, plan.roots.collections, target_key)? {
                        return Error(Exists(named(job.to_name)?))
                    }
                    child_apply_tiered_op(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, mut plan.roots.collections, take target_key, ReplayPut(arc.new(take new_raw)), private_from, mut draw)?
                    written += 1
                }
            }
            canonical_tree(mut plan.roots.collections)?
            plan.next_node = draw - 1
            if tiered_tree_hot_bytes(plan.roots.collections)? >= ctx.dirty_bytes {
                child_cut_tiered(mut plan.roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, plan.next_node)?
            }
        }
        // Drop source table and its old indexes from collections.
        let former = remove_store_collection(mut plan.roots.collections, job.from_id, mut plan.next_node)?
        if !plan.retained {
            plan.live = int.saturating_sub(plan.live, former)
        }
        for old_id in job.olds {
            let charge = remove_store_collection(mut plan.roots.collections, old_id, mut plan.next_node)?
            if !plan.retained {
                plan.live = int.saturating_sub(plan.live, charge)
            }
        }
        if tiered_tree_hot_bytes(plan.roots.collections)? >= ctx.dirty_bytes {
            child_cut_tiered(mut plan.roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, plan.next_node)?
        }
        if let Some(slot) = job.preview_slot {
            if let Some(mut backfills) = plan.preview {
                backfills[slot].read = read
                backfills[slot].written = written
            }
        }
    }
    Ok(())
}

fn find_binding_index(bindings: List[IndexRegistration], table_id: u32, index_id: u32) -> Result[u64, Error] {
    let n = list.len(bindings)
    for i in 0u64 .. n {
        let idx = n - 1 - i
        if bindings[idx].table == table_id && bindings[idx].index.id == index_id {
            return Ok(idx)
        }
    }
    Error(MigrationFault)
}

// Runs every deferred Tiered index build queued in `pending` in chunks against
// `roots` / `next_node`, reading source rows via `snapshot_tiered_span_step_direct`
// (or resident cursor if Memory table + Tiered index) and cutting at `dirty_bytes`.
fn run_deferred_index_builds_roots(mut ctx: ChildCutContext, opened: u64, pending: List[DeferredIndexBuild], bindings: List[IndexRegistration], mut roots: Roots, mut next_node: u64, live_bytes: u64, ceiling: u64, retained: bool) -> Result[(), Error] waits {
    if list.len(pending) == 0 {
        return Ok(())
    }
    for job in pending {
        let record = decode_catalog(job.record_raw)?
        let bind_idx = find_binding_index(bindings, record.owner, record.id)?
        let shape = catalog_index(record)?.shape
        let target_tiered = table_is_tiered(roots.collections, record.id)?
        let source_tiered = table_is_tiered(roots.collections, record.owner)?
        let low = prefix(record.owner)?
        let high = prefix(record.owner + 1u32)?
        let mut previous: Option[Bytes] = None
        loop {
            let mut batch: List[(Bytes, Bytes)] = list.new()
            if source_tiered {
                let snap = Snapshot(store: ctx.store, open: opened, branch: 0u32, head: 0u64, roots: share_roots(roots), watermark: next_node + 1, bases: no_tail_bases())
                let Some(inventory) = view roots.collections.paging else {
                    return Error(Io(Closed))
                }
                while list.len(batch) < INDEX_CHUNK {
                    let Some((take k, v, take res)) = snapshot_tiered_span_step_direct(ctx.dir, ctx.store, ctx.writer_pin_bytes, snap, inventory, low, high, previous)? else {
                        break
                    }
                    list.push(mut batch, (take k, copied(v)?))
                    previous = Some(take res)
                }
            } else {
                let cursor: Option[Bytes] = match previous {
                    Some(prev) => Some(copied(list.slice(prev, 4, list.len(prev)))?),
                    None => None,
                }
                let (take mem_rows, _) = resident_rows_after(roots, record.owner, cursor, INDEX_CHUNK)?
                if let Some((last_k, _)) = list.last(mem_rows) {
                    previous = Some(copied(last_k)?)
                }
                batch = take mem_rows
            }
            if list.len(batch) == 0 {
                break
            }
            if !target_tiered {
                let mut tmp = SchemaPlan(store: ctx.store, roots: share_roots(roots), next_node: next_node, next_table: 0u32, live: live_bytes, ceiling: ceiling, retained: retained, changed: false, bindings: list.new(), superseded: list.new(), chunk_freed: None, step_rows: list.new(), step_drift: false, migrate_sources: list.new(), pending_migrates: list.new(), pending_indexes: list.new(), retention: list.new(), preview: None, value_limit: VALUE_LIMIT)
                let dup = index_chunk(mut tmp, job.catalog_key, copied_record(record)?, bindings[bind_idx].index, batch, false, false, false)?
                if let Some(_) = dup {
                    return Error(Conflict(named(job.name)?))
                }
                roots = share_roots(tmp.roots)
                next_node = tmp.next_node
                continue
            }
            let private_from = stamp_after(next_node)?
            let mut draw = private_from
            for (logical, raw) in batch {
                let primary = list.slice(logical, 4, list.len(logical))
                let IndexValue(keys: take keys, payload: take payload, sums: sums) = (bindings[bind_idx].index.extract)(raw, primary)?
                let mut part = 0u64
                for take entry_key in take keys {
                    if list.len(entry_key) > 4096 {
                        return Error(Limit(Key))
                    }
                    let prior: Option[Bytes] = if let Entries(Many) = shape {
                        None
                    } else {
                        child_get_row(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, roots.collections, entry_key)?
                    }
                    let val = match shape {
                        Entries(Unique) => {
                            if let Some(existing) = view prior {
                                let owner = list.slice(existing, 4, unique_owner_end(existing)?)
                                if owner != primary {
                                    return Error(Conflict(named(job.name)?))
                                }
                            }
                            copied(payload)?
                        },
                        Entries(Many) => copied(payload)?,
                        Sums => {
                            let (members, sum) = match prior {
                                Some(body) => group_totals(body)?,
                                None => (0u64, 0u64),
                            }
                            let Some(total) = int.checked_add(sum, sums[part]) else {
                                return Error(Limit(Value))
                            }
                            totals_bytes(members + 1, total)?
                        },
                    }
                    part += 1
                    child_apply_tiered_op(ctx.dir, ctx.store, ctx.writer_pin_bytes, opened, mut roots.collections, take entry_key, ReplayPut(arc.new(take val)), private_from, mut draw)?
                }
            }
            canonical_tree(mut roots.collections)?
            next_node = draw - 1
            if tiered_tree_hot_bytes(roots.collections)? >= ctx.dirty_bytes {
                child_cut_tiered(mut roots.collections, ctx.dir, ctx.store, mut ctx.next_pack, ctx.pack_bytes, next_node)?
            }
        }
        let mut published = copied_record(record)?
        set_index_state(mut published, Public)?
        let raw_cat = encode_catalog(published)?
        roots = catalog_insert(mut next_node, roots, job.catalog_key, raw_cat)?
    }
    Ok(())
}

fn run_deferred_index_builds(mut ctx: ChildCutContext, opened: u64, mut plan: SchemaPlan) -> Result[(), Error] waits {
    if list.len(plan.pending_indexes) == 0 {
        return Ok(())
    }
    let pending = replace(mut plan.pending_indexes, list.new())
    run_deferred_index_builds_roots(mut ctx, opened, pending, plan.bindings, mut plan.roots, mut plan.next_node, plan.live, plan.ceiling, plan.retained)?
    plan.changed = true
    Ok(())
}

// Helper for reading an optional 0x008B source-map frame after the 0x0083
// inventory frames without disturbing the following 0x0084/0x0085 frame.
fn read_optional_source_map(mut input: PreparedInput) -> Result[List[MigrateSource], DeployError] waits {
    let mut first: Bytes = list.with_capacity(1)
    if scratch_result(disk_io(host.read(mut input.file, mut first)))? == 0 {
        return Ok(list.new())
    }
    if first[0u64] != 0x8Bu8 {
        input.peek = Some(first[0u64])
        return Ok(list.new())
    }
    let rest = scratch_result(prepared_read(mut input.file, 15u64))?
    list.append(mut first, rest)
    let payload = prepared_payload(mut input, 0x008B, first)?
    let codec: std.codec.Codec[List[MigrateSource]] = std.codec.of()
    let sources = std.codec.decode(codec, payload) ?=> |_| ImportMalformed
    if list.len(sources) == 0 {
        return Error(ImportMalformed)
    }
    Ok(take sources)
}

pub fn read_tiered_bucket_window(client: std.object.Opener, pack_ref: pages.HistoryRef, window: pager.TieredRange, deadline: u64) -> Result[Bytes, types.Failure] waits {
    if window.lo >= window.hi || window.hi > pack_ref.len {
        return Error(format.disk_fault(history_key("p-", pack_ref), window.lo, Malformed))
    }
    let raw = manifest.disk_read_buffer(window.hi - window.lo)?
    let range = std.object.GetRange(key: history_key("p-", pack_ref), lo: window.lo, hi: window.hi, buffer: take raw, deadline)
    let (take status, take response) = std.object.read_range(client, take range)
    match take status {
        Ok(meta) if meta.size == pack_ref.len && list.len(response) == window.hi - window.lo => Ok(take response),
        Ok(_) => Error(format.disk_fault(history_key("p-", pack_ref), window.lo, Truncated)),
        Error(NotFound) => Error(pager.history_missing_object(history_key("p-", pack_ref), pack_ref)),
        Error(take problem) => Error(Remote(take problem)),
    }
}

pub fn read_tiered_bucket_windows(client: std.object.Opener, gets: List[pager.TieredBucketGet], streams: u64) -> Result[List[Result[Bytes, types.Failure]], types.Failure] waits {
    let width = list.len(gets)
    let prepared = manifest.disk_allocation(scoped fn() -> Result[List[std.object.GetRange], types.Failure] {
        let mut requests: List[std.object.GetRange] = list.with_capacity(width)
        for read in gets {
            let window = read.window
            let target_name = history_key("p-", read.pack_ref)
            let out: Bytes = list.with_capacity(window.hi - window.lo)
            list.push(mut requests, std.object.GetRange(key: take target_name, lo: window.lo, hi: window.hi, buffer: take out, deadline: read.deadline))
        }
        Ok(take requests)
    })?
    let responses = std.object.read_ranges(client, take prepared, streams)
    let mut outcomes: List[Result[Bytes, types.Failure]] = list.new()
    types.capacity(list.try_reserve(mut outcomes, width))?
    let mut at = 0u64
    for take response in take responses {
        let (take status, take raw) = take response
        let read = gets[at]
        let path = history_key("p-", read.pack_ref)
        let item: Result[Bytes, types.Failure] = match take status {
            Ok(meta) => {
                if meta.size != read.pack_ref.len || list.len(raw) != read.window.hi - read.window.lo {
                    Error(format.disk_fault(path, read.window.lo, Truncated))
                } else {
                    Ok(take raw)
                }
            },
            Error(NotFound) => Error(pager.history_missing_object(path, read.pack_ref)),
            Error(take problem) => Error(Remote(take problem)),
        }
        list.push(mut outcomes, take item)
        at += 1
    }
    Ok(take outcomes)
}

pub fn tiered_window_cache_key(request: pager.TieredBucketGet) -> Result[(String, Option[u64]), types.Failure] {
    if request.window.lo == 0 && request.window.hi == request.pack_ref.len {
        return Ok((history_read_key("p-", request.pack_ref)?, Some(request.pack_ref.digest)))
    }
    types.capacity(bound bytes 104 {
        let mut path = string.with_capacity(104)
        pager.history_fill_key(mut path, "p-", request.pack_ref)
        string.push(mut path, "-")
        string.push_u64(mut path, request.window.lo)
        string.push(mut path, "-")
        string.push_u64(mut path, request.window.hi)
        (take path, None)
    })
}

pub fn tiered_window_cached(cache: pager.ObjectsCache, request: pager.TieredBucketGet) -> Option[Bytes] waits {
    let width = request.window.hi - request.window.lo
    if width > cache.capacity_bytes {
        return None
    }
    let Ok((take path, expected)) = tiered_window_cache_key(request) else {
        return None
    }
    let trailer = if expected == None {
        8u64
    } else {
        0u64
    }
    let Ok(take buffer) = manifest.disk_read_buffer(width + trailer) else {
        return None
    }
    let mut raw = take buffer
    if pack_cache_read(cache, path, width, expected, mut raw) {
        Some(take raw)
    } else {
        None
    }
}

pub fn tiered_window_cache_discard(cache: pager.ObjectsCache, request: pager.TieredBucketGet) waits {
    if let Ok((take path, _)) = tiered_window_cache_key(request) {
        pack_cache_discard(cache, path)
    }
}

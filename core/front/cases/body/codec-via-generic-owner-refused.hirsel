type Ordered[in a, in b]: codec via u64 (to: ordered_view, from: ordered_from) { n: u64 }
fn ordered_view[in a, in b](x: Ordered[in a, in b]) -> View[u64] in x where a: b { view x.n }
fn ordered_from[in a, in b](take n: u64) -> Result[Ordered[in a, in b], ()] where a: b { Ok(Ordered(n: n)) }

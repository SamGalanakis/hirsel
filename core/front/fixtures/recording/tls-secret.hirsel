fn refuse_plain(n: Net, peer: Addr, s: Secret) -> bool waits {
    let socket = result.unwrap(host.connect(n, peer, Never))
    let (r, w) = net.split(take socket)
    let mut read = take r
    let mut write = take w
    // Wait for the peer to accept this plain connection before moving to TLS.
    let mut ready: Bytes = list.with_capacity(1)
    if result.unwrap(host.recv_bounded(mut read, mut ready, 1, Never)) != 1 || ready[0] != b'!' {
        return false
    }
    let empty: Bytes = list.new()
    match tls.send_secret(mut write, empty, s, empty, Never) {
        Error(Denied) => true,
        _ => false,
    }
}

fn refuse_name(n: Net, peer: Addr, s: Secret) -> bool waits {
    let socket = result.unwrap(host.connect(n, peer, Never))
    let alpn: List[String] = list.new()
    let (r, w, _) = result.unwrap(tls.connect(n, take socket, "beta.test", System, alpn, Never))
    let mut write = take w
    let empty: Bytes = list.new()
    match tls.send_secret(mut write, empty, s, empty, Never) {
        Error(Denied) => true,
        _ => false,
    }
}

fn tag_bytes(tag: Inline[u8, 32]) -> Bytes {
    let mut output: Bytes = list.with_capacity(32)
    if !bytebuf.append_inline(mut output, tag, 0, 32) {
        core.fail("32-byte tag exceeds its buffer")
    }
    output
}

fn check_mac(token: Secret, local: Secret, verifier: Secret, out: Stdout) -> Result[(), Exit] waits {
    let data = string.as_bytes("authenticated payload")
    let tag = tag_bytes(result.unwrap(secret.hmac_sha256(token, data)))
    // An explicitly narrowed grant keeps the same canonical policy as the CLI.
    let same = result.unwrap(secret.narrow(token, "tls_send(ALPHA.TEST.) mac"))
    if tag != tag_bytes(result.unwrap(secret.hmac_sha256(same, data))) {
        return Error(Exit(status: 40))
    }
    match secret.hmac_sha256(local, data) {
        Error(Denied) => {},
        _ => return Error(Exit(status: 41)),
    }
    match secret.verify_hmac_sha256(local, data, tag) {
        Error(Denied) => {},
        _ => return Error(Exit(status: 42)),
    }
    match secret.hmac_sha256(verifier, data) {
        Error(Denied) => {},
        _ => return Error(Exit(status: 47)),
    }
    if !result.unwrap(secret.verify_hmac_sha256(verifier, data, tag)) {
        return Error(Exit(status: 48))
    }
    let verify_only = result.unwrap(secret.narrow(token, "verify"))
    let narrowed = result.unwrap(secret.narrow(verify_only, "mac"))
    match secret.hmac_sha256(narrowed, data) {
        Error(Denied) => {},
        _ => return Error(Exit(status: 43)),
    }
    if !result.unwrap(secret.verify_hmac_sha256(narrowed, data, tag)) {
        return Error(Exit(status: 44))
    }
    if result.unwrap(secret.verify_hmac_sha256(narrowed, data, list.slice(tag, 0, 31))) {
        return Error(Exit(status: 45))
    }
    let key = string.into_bytes("Jefe")
    let sealed = result.unwrap(secret.seal(take key, "mac"))
    let sample = string.as_bytes("what do ya want for nothing?")
    let signed = result.unwrap(secret.hmac_sha256(sealed, sample))
    // RFC 4231 §4.3. This signature is needed during replay of a seal as well.
    let expected: Inline[u8, 32] =[0x5b, 0xdc, 0xc1, 0x46, 0xbf, 0x60, 0x75, 0x4e, 0x6a, 0x04, 0x24, 0x26, 0x08, 0x95, 0x75, 0xc7, 0x5a, 0x00, 0x3f, 0x08, 0x9d, 0x27, 0x39, 0x83, 0x9d, 0xec, 0x58, 0xb9, 0x64, 0xec, 0x38, 0x43]
    if tag_bytes(signed) != tag_bytes(expected) {
        return Error(Exit(status: 46))
    }
    result.unwrap(stdout.write(out, "mac verified\n"))
    Ok(())
}

pub fn main(n: Net, out: Stdout, token: Secret, local: Secret, verifier: Secret) -> Result[(), Exit] waits {
    let peer = Addr(ip: V4(2130706433u32), port: 12345u16)
    if !refuse_plain(n, peer, token) {
        return Error(Exit(status: 1))
    }
    if !refuse_name(n, peer, token) {
        return Error(Exit(status: 2))
    }
    let socket = result.unwrap(host.connect(n, peer, Never))
    let alpn: List[String] = list.new()
    let (r, w, _) = result.unwrap(tls.connect(n, take socket, "ALPHA.TEST.", System, alpn, Never))
    let mut read = take r
    let mut write = take w
    let token_view = result.unwrap(secret.narrow(token, "tls_send(ALPHA.TEST.)"))
    let before = string.into_bytes("before:")
    let after = string.into_bytes(":after\n")
    result.unwrap(tls.send_secret(mut write, before, token_view, after, Never))
    let empty: Bytes = list.new()
    result.unwrap(tls.send_secret(mut write, empty, local, after, Never))
    // The first seal is released before the second, which takes its slot;
    // replay sees the same designations (TLS-5, holders and release).
    let dropped = result.unwrap(secret.seal(string.into_bytes("dropped"), "tls_send(alpha.test)"))
    let _ = take dropped
    let payload = string.into_bytes("sealed")
    let sealed = result.unwrap(secret.seal(take payload, "tls_send(alpha.test)"))
    result.unwrap(tls.send_secret(mut write, empty, sealed, after, Never))
    result.unwrap(stdout.write(out, secret.render(token)))
    result.unwrap(stdout.write(out, secret.render(local)))
    let mut response: Bytes = list.with_capacity(16)
    while result.unwrap(host.recv_bounded(mut read, mut response, 16, Never)) != 0 {}
    let text = result.unwrap(string.from_utf8(take response))
    result.unwrap(stdout.write(out, text))
    check_mac(token, local, verifier, out)?
    Ok(())
}

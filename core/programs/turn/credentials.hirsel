// TURN-5: time-limited credentials, the long-term keys, USERHASH and the stateless nonce.
/// RFC 8489 section 9.2's nonce cookie prefix, before the 4 base64 feature characters.
const COOKIE: u64 = 9

/// cookie (9), features (4), hex(t) (16), hex(tag[0..16]) (32).
pub const NONCE_LEN: u64 = 61

const SUBJECT_MAX: u64 = 64

fn cookie_prefix() -> Bytes {
    b"obMatJos2"
}

/// The 24 feature bits with bit 0 (Password algorithms) set and bit 1 (Username
/// anonymity) clear, RFC 8489 section 18.1, as padded base64 of 0x80 0x00 0x00.
fn features() -> Bytes {
    b"gAAA"
}

fn inline32(a: Inline[u8, 32]) -> Bytes {
    let mut b: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32 {
        list.push(mut b, a[i])
    }
    b
}

fn put_decimal(mut out: Bytes, v: u64) {
    let mut p = 1u64
    while v / p >= 10 {
        p = p * 10
    }
    while p > 0 {
        list.push(mut out, b'0' + int.truncate((v / p) % 10))
        p = p / 10
    }
}

fn subject_byte(x: u8) -> bool {
    x >= 0x20 && x <= 0x7e && x != b':'
}

fn subject_ok(b: Bytes, lo: u64, hi: u64) -> bool {
    if hi <= lo || hi - lo > SUBJECT_MAX {
        return false
    }
    for i in lo .. hi {
        if !subject_byte(b[i]) {
            return false
        }
    }
    true
}

/// A username of TURN-5's grammar, `expiry ":" subject`, in packet[lo..hi].
pub type Username {
    expiry: u64,
    subject: stun_ice.Range
}

/// Parse `expiry ":" subject`: 1 to 20 decimal digits with no leading zero that fit u64,
/// then 1 to 64 printable ASCII bytes without ':'.
pub fn username_of(b: Bytes, lo: u64, hi: u64) -> Option[Username] {
    let mut at = lo
    let mut value = 0u64
    while at < hi && b[at] >= b'0' && b[at] <= b'9' {
        if at == lo && b[at] == b'0' {
            return None
        }
        let d: u64 = int.widen(b[at] - b'0')
        let Some(scaled) = int.checked_mul(value, 10u64) else {
            return None
        }
        let Some(next) = int.checked_add(scaled, d) else {
            return None
        }
        value = next
        at += 1
    }
    if at == lo || at - lo > 20 || at >= hi || b[at] != b':' || !subject_ok(b, at + 1, hi) {
        return None
    }
    Some(Username(expiry: value, subject: stun_ice.Range(lo: at + 1, hi: hi)))
}

/// Signaling side: username = expiry ":" subject, password = base64(HMAC-SHA256(master,
/// username)), 44 bytes. The master needs `mac`. Both outputs are cleared first.
pub fn mint(master: Secret, expiry_unix_s: u64, subject: Bytes, mut username: Bytes, mut password: Bytes) -> Result[(), TurnError] {
    if expiry_unix_s == 0 || !subject_ok(subject, 0, list.len(subject)) {
        return Error(Config)
    }
    list.clear(mut username)
    put_decimal(mut username, expiry_unix_s)
    list.push(mut username, b':')
    list.append(mut username, subject)
    let tag = secret.hmac_sha256(master, username) ?=> Mac
    list.clear(mut password)
    std.base64.encode(inline32(tag), mut password)
    Ok(())
}

fn key_prefix(username: Bytes, realm: Bytes) -> Bytes {
    let mut prefix: Bytes = list.with_capacity(list.len(username) + list.len(realm) + 2)
    list.append(mut prefix, username)
    list.push(mut prefix, b':')
    list.append(mut prefix, realm)
    list.push(mut prefix, b':')
    prefix
}

fn digest_alg(a: Algorithm) -> secret.DigestAlg {
    match a {
        Md5 => Md5,
        Sha256 => Sha256,
    }
}

/// Relay side: the long-term key of a minted username, H(username ":" realm ":"
/// base64(HMAC-SHA256(master, username))), without the password or key in program memory.
/// The master needs only `kdf`; the key has `mac`.
/// A derivation refused for memory is the caller's ordinary `Capacity`, retryable, not a
/// fatal `Secret` (TURN-3, MEM-21).
fn secret_error(take e: SecretError) -> TurnError {
    match e {
        Capacity(c) => Capacity(c),
        _ => Secret(take e),
    }
}

pub fn relay_key(master: Secret, username: Bytes, realm: Bytes, alg: Algorithm) -> Result[Secret, TurnError] {
    let password = secret.derive_hmac_sha256(master, b"", username, "digest") ?=> secret_error
    Ok(secret.derive_digest(password, digest_alg(alg), key_prefix(username, realm), Base64, b"", "mac") ?=> secret_error)
}

/// Client side: the long-term key from a password it holds as a `Secret` with `digest`.
pub fn client_key(password: Secret, username: Bytes, realm: Bytes, alg: Algorithm) -> Result[Secret, TurnError] {
    Ok(secret.derive_digest(password, digest_alg(alg), key_prefix(username, realm), Raw, b"", "mac") ?=> secret_error)
}

/// RFC 8489 section 14.4: SHA-256(username ":" realm), from values that are not secret.
pub fn userhash(username: Bytes, realm: Bytes) -> Inline[u8, 32] {
    let mut h = std.sha256.start()
    std.sha256.add(mut h, username, 0, list.len(username))
    std.sha256.add_byte(mut h, b':')
    std.sha256.add(mut h, realm, 0, list.len(realm))
    std.sha256.finish(h)
}

fn put_addr(mut b: Bytes, a: Addr) {
    match a.ip {
        V4(ip) => {
            list.push(mut b, 4)
            list.put_word_be(mut b, ip)
        },
        V6(high, low) => {
            list.push(mut b, 6)
            list.put_word_be(mut b, high)
            list.put_word_be(mut b, low)
        },
    }
    list.put_word_be(mut b, a.port)
}

/// HMAC-SHA256(nonce_key, t ‖ kind ‖ local ‖ client). kind is 0 for UDP ingress and 1 for a
/// stream; an address is its family byte (4 or 6), its address bytes and its port.
fn nonce_tag(key: Secret, t: u64, stream: bool, local: Addr, source: Addr) -> Result[Inline[u8, 32], TurnError] {
    let mut input: Bytes = list.with_capacity(8 + 1 + 19 + 19)
    list.put_word_be(mut input, t)
    list.push(mut input, if stream {
        1u8
    } else {
        0u8
    })
    put_addr(mut input, local)
    put_addr(mut input, source)
    Ok(secret.hmac_sha256(key, input) ?=> Mac)
}

fn push_hex(mut out: Bytes, x: u8) {
    let (hi, lo) = std.hex.encode_byte(x, false)
    list.push(mut out, hi)
    list.push(mut out, lo)
}

/// Append a fresh nonce for this 5-tuple at mono_ns: the cookie, the features, hex(t)
/// with t = mono_ns / 10^6, and the first 16 bytes of the tag in hex.
pub fn nonce(key: Secret, mono_ns: u64, stream: bool, local: Addr, source: Addr, mut out: Bytes) -> Result[(), TurnError] {
    let t = mono_ns / 1000000
    let tag = nonce_tag(key, t, stream, local, source)?
    list.append(mut out, cookie_prefix())
    list.append(mut out, features())
    for i in 0u64 .. 8 {
        push_hex(mut out, int.truncate(t >> (56 - 8 * i)))
    }
    for i in 0u64 .. 16 {
        push_hex(mut out, tag[i])
    }
    Ok(())
}

fn hex_value(x: u8) -> Option[u64] {
    if x >= b'0' && x <= b'9' {
        let v: u64 = int.widen(x - b'0')
        Some(v)
    } else if x >= b'a' && x <= b'f' {
        let v: u64 = int.widen(x - b'a')
        Some(v + 10)
    } else {
        None
    }
}

fn hex_word(b: Bytes, at: u64, digits: u64) -> Option[u64] {
    let mut v = 0u64
    for i in 0u64 .. digits {
        let Some(d) = hex_value(b[at + i]) else {
            return None
        }
        v = (v << 4) | d
    }
    Some(v)
}

fn base64_value(x: u8) -> Option[u8] {
    if x >= b'A' && x <= b'Z' {
        Some(x - b'A')
    } else if x >= b'a' && x <= b'z' {
        Some(x - b'a' + 26)
    } else if x >= b'0' && x <= b'9' {
        Some(x - b'0' + 52)
    } else if x == b'+' {
        Some(62)
    } else if x == b'/' {
        Some(63)
    } else {
        None
    }
}

/// The nonce cookie's first feature byte's top two bits, RFC 8489 section 9.2: bit 0
/// (Password algorithms) and bit 1 (Username anonymity). None without a cookie.
pub type Cookie {
    algorithms: bool,
    anonymity: bool
}

pub fn cookie_of(b: Bytes, lo: u64, hi: u64) -> Option[Cookie] {
    if hi - lo < COOKIE + 4 || !list.starts_with_at(b, lo, cookie_prefix()) {
        return None
    }
    let mut first = 0u8
    for i in 0u64 .. 4 {
        let Some(v) = base64_value(b[lo + COOKIE + i]) else {
            return None
        }
        if i == 0 {
            first = v
        }
    }
    Some(Cookie(algorithms: (first & 0x20) != 0, anonymity: (first & 0x10) != 0))
}

/// The issue time t of a nonce this key issued to this 5-tuple, or None for any other value.
pub fn nonce_time(key: Secret, packet: Bytes, lo: u64, hi: u64, stream: bool, local: Addr, source: Addr) -> Result[Option[u64], TurnError] {
    if hi - lo != NONCE_LEN || !list.starts_with_at(packet, lo, cookie_prefix()) {
        return Ok(None)
    }
    let Some(t) = hex_word(packet, lo + COOKIE + 4, 16) else {
        return Ok(None)
    }
    let mut got: Bytes = list.with_capacity(16)
    for i in 0u64 .. 16 {
        let Some(v) = hex_word(packet, lo + COOKIE + 20 + 2 * i, 2) else {
            return Ok(None)
        }
        list.push(mut got, int.truncate(v))
    }
    let tag = nonce_tag(key, t, stream, local, source)?
    let mut want: Bytes = list.with_capacity(16)
    for i in 0u64 .. 16 {
        list.push(mut want, tag[i])
    }
    if std.hmac.equal(want, got) {
        Ok(Some(t))
    } else {
        Ok(None)
    }
}

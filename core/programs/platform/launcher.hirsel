// Module launcher (package store): the control session between the platform host and the
// launcher (docs/spec/launch.md "The launcher", RUNNER-SPEC v2.27 §14.5).
//
// One session runs at a time on the launcher's control socket. Each frame is a u32
// little-endian length, then one value-codec `Request` (host to launcher) or `Event`
// (launcher to host). Declared variant order fixes the u32 wire tags; the Rust launcher
// (crates/hirsel-core-driver/src/launcher/session.rs) mirrors these types, and
// launcher_wire.hirsel holds the byte vectors both sides check.
//
// `Fake` is the launcher's session rules without processes, for the platform host's
// harness: it answers requests and lets a test end children and make listeners readable.
// A deploy attempt: 16 bytes, `hi` then `lo`, each little-endian.
pub type Attempt: codec + send {
    hi: u64,
    lo: u64
}

// A group by catalog name and incarnation (§14.1). No identity of an earlier incarnation
// matches a later one.
pub type Group: codec + send {
    name: String,
    incarnation: u64
}

// A child's role. The store-holding roles take the group's next `gen`; the others are
// keyed by their deploy attempt (§14.1).
pub type Role: codec + send = Install(u64) | Serving(u64) | Describe(Attempt) | Preview(Attempt) | Prepare(Attempt)

// A child's identity, (group, incarnation, gen or attempt, role).
pub type Child: codec + send {
    group: Group,
    role: Role
}

pub type InstallKind: codec + send = Genesis | Standalone(u64)

// A serving launch is a wake launch: `idle` is its nonzero idle time in milliseconds
// (§14.4). `candidate` names OLD's `gen` when this child is a cutover's candidate (§14.3).
pub type Serve: codec + send {
    activation: u64,
    idle: u64,
    candidate: Option[u64],
    store_id: Option[(u64, u64)],
    witness: Option[u64]
}

// What the child runs, by mode (launch.md "Child modes"). Preview carries OLD's entry
// list; prepare carries the export name OLD answered.
pub type Mode: codec + send = InstallMode(u64, InstallKind) | ServingMode(u64, Serve) | DescribeMode(Attempt) | PreviewMode(Attempt, Bytes) | PrepareMode(Attempt, String, Bytes)

// A recorded serving launch: the 16-byte recording ID whose catalog pin the host made
// durable before this start, and the designated recording destination.
pub type Recording: codec + send {
    id: Bytes,
    destination: String
}

// `assembly` is the 32-byte name of the assembly record the child runs. `workdir` is the
// group's working directory; `args` are the program's arguments after the runtime prefix.
pub type Launch: codec + send {
    group: Group,
    assembly: Bytes,
    workdir: String,
    args: List[String],
    mode: Mode,
    recording: Option[Recording]
}

// What an admission verifies: a recipe R the host attests, streamed in `AdmitData`; a
// publication R already in the launcher's code store; or source, a `Tree`'s codec bytes,
// which the launcher publishes with the normal checker and then admits as a publication
// (launch.md "Publish and assemble"). A source's bool asks for the law gate (launch.md
// "The law gate"): its tests run in the publish scratch after H and before H is admitted.
pub type Input: codec + send = Attested(Bytes) | Publication(Bytes) | Source(Bytes, bool)

// Submitted source: the files of a workspace whose root holds its `hirsel.toml` and
// `hirsel.lock`, the package directory to publish within it, and the `--grant` and `--dir`
// values its recipe binds. Paths are relative, `/`-separated and plain.
pub type Tree: codec + send {
    package: String,
    grants: List[String],
    dirs: List[String],
    files: List[SourceFile],
    // WIRE entries the host requires NEW to keep before import.
    required_entries: List[RequiredEntry]
}

pub type RequiredEntry: codec + send {
    kind: runner.Kind,
    key: Bytes
}

pub type SourceFile: codec + send {
    path: String,
    content: Bytes
}

// The most codec bytes a `Tree` may take. The host keeps a request's input twice in its
// row (the Begin and the input), so two trees fit one stored value.
pub const TREE_BYTES: u64 = 4194304u64

// The tree `b` encodes, if it encodes one within `TREE_BYTES`.
pub fn tree_of(b: Bytes) -> Option[Tree] {
    if list.len(b) > TREE_BYTES {
        return None
    }
    let c: std.codec.Codec[Tree] = std.codec.of()
    match std.codec.decode(c, b) {
        Ok(take t) => Some(take t),
        _ => None,
    }
}

// Whether a `--grant` value is one an untrusted author may not bind (FFI-1, EXEC-1).
pub fn foreign_or_exec(grant: String) -> bool {
    string.starts_with(grant, "Foreign") || string.starts_with(grant, "Exec")
}

// The host's policy for one admission: whether the image records, the approved Foreign
// grants and Exec requests, the group's working directory, and the assembly a deploy
// would replace.
pub type Approvals: codec + send {
    recording: bool,
    foreign: List[String],
    exec: List[String],
    workdir: String,
    old: Option[Bytes]
}

// One object the launcher needs, by kind and 32-byte hash.
pub type Wanted: codec + send = GroupKey(Bytes) | BodyKey(Bytes) | AnnexKey(Bytes) | ArchiveKey(Bytes) | ValueKey(Bytes)

// A grant diff (launch.md "Publish and assemble"): the sorted grant lines a new recipe
// holds that the old one lacks, and the sorted lines of the old one it drops. A line is one
// value of a Dir, Net, Env or Foreign grant, one whole Exec, Secret or Cred binding with its
// policy, or one other capability by name.
pub type Grants: codec + send {
    added: List[String],
    dropped: List[String]
}

pub fn no_grants() -> Grants {
    Grants(added: list.new(), dropped: list.new())
}

pub fn grants_empty(g: Grants) -> bool {
    list.len(g.added) == 0u64 && list.len(g.dropped) == 0u64
}

// What the host compares before `Assemble`: the new and old root limits, the grant diff
// against the old recipe, and the new recipe's target and place allowance, which the host
// checks NEW's preview against.
pub type Summary: codec + send {
    root_limit: u64,
    old_root_limit: u64,
    grants: Grants,
    target: String,
    n_place: u64,
    // A gated source's green verdict (launch.md "The law gate" step 5); None when ungated.
    gate: Option[Green]
}

// A green law gate: the SHA-256 of the source tree's codec bytes, the publication H its
// tests were run against, and the launcher's toolchain identity.
pub type Green: codec + send {
    tree: Bytes,
    root: Bytes,
    toolchain: Bytes
}

// Why an admission ended: a policy refusal printed as is, an invalid input or release,
// a failed assembly, submitted source the checker refused (its diagnostics), a compile
// of submitted source that reached the toolchain's memory limit, a gated source whose
// tests were not all green (one row per such test, with its outcome), or a gate whose
// resident compiler session was lost: never green and never durable, the request is
// admitted again (launch.md "The law gate" step 4).
pub type Failure: codec + send = Denied(String) | Invalid(String) | Unassembled(String) | Uncompiled(String) | Exhausted(String) | Red(List[String]) | GateLost(String)

// A cutover the launcher forwarded to OLD and still holds, by (OLD, attempt).
pub type CutoverKey: codec + send {
    old: Child,
    attempt: Attempt
}

pub type Request: codec + send = Hello
// Hold the group's listener at this address, or bind it again after a launcher loss.
    | Bind(Group, String)
// Close a removed group's listener.
    | Close(Group) | Start(Launch)
// Stop a child by identity: a drain for a serving child, an end for the others.
    | Stop(Child) | Kill(Child)
// The host has applied this child's end; the launcher forgets it.
    | Acknowledge(Child)
// A command for a serving child's private endpoint (runner's host protocol).
    | Command(Child, runner.HostCommand) | Retire(Group)
// The attempt's pending row is durable or abandoned: end its reservation.
    | Release(Attempt) | CollectBegin
// The full root set: assembly record names.
    | Collect(List[Bytes])
// Begin admitting an attempt for a group under the host's approvals.
    | Admit(Group, Attempt, Input, Approvals)
// The next bounded chunk of an attested admission's exchange bytes.
    | AdmitData(Attempt, Bytes)
// The attempt's input is complete; trailing or missing bytes fail it.
    | AdmitEnd(Attempt)
// Assemble the verified release after the host's checks.
    | Assemble(Attempt)
// The host's decision on this cutover is durable: forget its saved result.
    | CutoverAck(Child, Attempt)
// The host could not read its roots: end the fence, remove nothing, and apply the
// releases it deferred. Answered `Collected(0)`.
    | CollectAbort

pub type Status: codec + send = Code(i32) | Signal(i32)

// A child's end. `report` is the wake report the child wrote on descriptor 5, if any: a
// `Stopped(next_due)` sends Some(next_due). `readable` is the listener sample the
// launcher took after the child ended and before it sent this end (§14.3).
pub type End: codec + send {
    status: Status,
    report: Option[Option[u64]],
    readable: bool
}

pub type Phase: codec + send = Started | Exited(End)

pub type Selection: codec + send {
    activation: u64,
    assembly: Bytes
}

pub type ChildState: codec + send {
    child: Child,
    phase: Phase,
    selection: Option[Selection],
    answer: Option[runner.HostReply]
}

pub type Refusal: codec + send = Held | Retiring | UnknownGroup | Mismatch | Image(String) | Spawn(String) | Unbuilt(String)

pub type Event: codec + send =
// The answer to Hello: every child the launcher has, every readable cold listener, and
// every cutover it still holds.
Inventory(List[ChildState], List[Group], List[CutoverKey])
// The answer to Start, and to a repeated Start with the same identity.
    | Launched(Child, Phase) | Refused(Child, Refusal) | Ended(Child, End) | Arrived(Group) | Bound(Group) | BindFailed(Group, String) | Closed(Group) | Retired(Group)
// A serving child's private endpoint reply, or an install child's stdout result.
    | Placed(Child, runner.HostReply) | Fenced | Collected(u64)
// A describe or preview child's answer, read from its standard output after it exited 0
// and before its `Ended`.
    | Answered(Child, Bytes)
// The objects an attested admission still needs; `last` marks the set's final part.
    | Need(Attempt, List[Wanted], bool)
// The release R is verified, with its summary and the confirmation text to show.
    | Admitted(Attempt, Bytes, Summary, String)
// Publication through the assembly record is synced: assembly name, image digest, fetch
// and assembly times in nanoseconds. The launcher holds the attempt's reservation.
    | Assembled(Attempt, Bytes, Bytes, u64, u64) | AdmissionFailed(Attempt, Failure)
// OLD's answer to the cutover forwarded for this attempt, or Uncertain if OLD ended first.
    | CutoverResult(Child, Attempt, runner.HostReply)

pub fn role_of(m: Mode) -> Role {
    match m {
        InstallMode(g, _) => Install(g),
        ServingMode(g, _) => Serving(g),
        DescribeMode(a) => Describe(a),
        PreviewMode(a, _) => Preview(a),
        PrepareMode(a, _, _) => Prepare(a),
    }
}

pub fn same_group(a: Group, b: Group) -> bool {
    a.incarnation == b.incarnation && a.name == b.name
}

fn same_attempt(a: Attempt, b: Attempt) -> bool {
    a.hi == b.hi && a.lo == b.lo
}

pub fn same_child(a: Child, b: Child) -> bool {
    if !same_group(a.group, b.group) {
        return false
    }
    match (a.role, b.role) {
        (Install(x), Install(y)) => x == y,
        (Serving(x), Serving(y)) => x == y,
        (Describe(x), Describe(y)) => same_attempt(x, y),
        (Preview(x), Preview(y)) => same_attempt(x, y),
        (Prepare(x), Prepare(y)) => same_attempt(x, y),
        _ => false,
    }
}

fn holds_store(r: Role) -> bool {
    match r {
        Install(_) => true,
        Serving(_) => true,
        _ => false,
    }
}

// The fake launcher. Children never run: a test ends them with `end`, and makes a listener
// readable with `connect` (a client waits in the backlog) or not with `accept`. It runs no
// verifier: a test answers an admission's requests with `Need`, `Admitted`, `Assembled`
// or `AdmissionFailed` itself.
type Kept {
    state: ChildState
}

type Listener {
    group: Group,
    readable: bool,
    reported: bool,
    retiring: bool
}

// A cutover forwarded to OLD, kept until `CutoverAck`: the command as first sent and
// OLD's answer once it gave one.
type Held {
    key: CutoverKey,
    command: Bytes,
    reply: Option[runner.HostReply]
}

pub opaque type Fake {
    children: List[Kept],
    listeners: List[Listener],
    cutovers: List[Held],
    forwards: u64,
    fenced: bool
}

pub fn fake() -> Fake {
    Fake(children: list.new(), listeners: list.new(), cutovers: list.new(), forwards: 0u64, fenced: false)
}

fn find_held(f: Fake, old: Child) -> Option[u64] {
    for i in 0u64 .. list.len(f.cutovers) {
        if same_child(f.cutovers[i].key.old, old) {
            return Some(i)
        }
    }
    None
}

fn find_key(f: Fake, old: Child, a: Attempt) -> Option[u64] {
    for i in 0u64 .. list.len(f.cutovers) {
        let k = f.cutovers[i].key
        if same_child(k.old, old) && k.attempt.hi == a.hi && k.attempt.lo == a.lo {
            return Some(i)
        }
    }
    None
}

fn attempt_of(b: Bytes) -> Option[Attempt] {
    let mut at = 0u64
    let Ok(hi) = std.codec.take_u64(b, mut at) else {
        return None
    }
    let Ok(lo) = std.codec.take_u64(b, mut at) else {
        return None
    }
    if at != list.len(b) {
        return None
    }
    Some(Attempt(hi: hi, lo: lo))
}

// A cutover command for OLD: forwarded once while OLD runs; an identical re-send returns
// OLD's saved answer, or nothing while OLD holds it; a different command for the same
// attempt, or one for an OLD with no endpoint, is refused.
fn cutover(mut f: Fake, take old: Child, take command: runner.HostCommand, mut out: List[Event]) {
    let ab = match command {
        HostCutover(b, _, _, _) => {
            let got: Bytes = clone(b);
            got
        },
        _ => return
    }
    let codec: std.codec.Codec[runner.HostCommand] = std.codec.of()
    let mut sent: Bytes = list.new()
    if let Error(_) = std.codec.encode(codec, command, mut sent) {
        return
    }
    let Some(a) = attempt_of(ab) else {
        push_event(mut out, Placed(take old, PlaceRefused("a malformed attempt")));
        return
    }
    if let Some(i) = find_key(f, old, a) {
        if f.cutovers[i].command != sent {
            push_event(mut out, Placed(take old, PlaceRefused("a different cutover for this attempt")))
        } else if let Some(r) = f.cutovers[i].reply {
            push_event(mut out, CutoverResult(take old, a, clone(r)))
        }
        return
    }
    let running = match find_child(f, old) {
        Some(i) => live(f.children[i].state.phase),
        None => false
    }
    if !running {
        push_event(mut out, Placed(take old, PlaceRefused("no endpoint")));
        return
    }
    f.forwards += 1u64
    list.push(mut f.cutovers, Held(key: CutoverKey(old: take old, attempt: a), command: take sent, reply: None))
}

// OLD answers the cutover it holds.
pub fn cutover_reply(mut f: Fake, old: Child, take reply: runner.HostReply) -> List[Event] {
    let mut out: List[Event] = list.new()
    let Some(i) = find_held(f, old) else {
        return take out
    }
    if let Some(_) = f.cutovers[i].reply {
        return take out
    }
    f.cutovers[i].reply = Some(clone(reply))
    push_event(mut out, CutoverResult(clone(old), f.cutovers[i].key.attempt, take reply))
    take out
}

// How many cutover commands reached a serving child.
pub fn forwards(f: Fake) -> u64 {
    f.forwards
}

// The cutovers the fake still holds.
pub fn held(f: Fake) -> u64 {
    list.len(f.cutovers)
}

fn find_listener(f: Fake, g: Group) -> Option[u64] {
    for i in 0u64 .. list.len(f.listeners) {
        if same_group(f.listeners[i].group, g) {
            return Some(i)
        }
    }
    None
}

fn find_child(f: Fake, c: Child) -> Option[u64] {
    for i in 0u64 .. list.len(f.children) {
        if same_child(f.children[i].state.child, c) {
            return Some(i)
        }
    }
    None
}

fn live(p: Phase) -> bool {
    match p {
        Started => true,
        Exited(_) => false,
    }
}

// Whether the group has a live serving launch, so its listener is not watched.
fn serving_live(f: Fake, g: Group) -> bool {
    for i in 0u64 .. list.len(f.children) {
        let kept = f.children[i].state
        if same_group(kept.child.group, g) && live(kept.phase) {
            if let Serving(_) = kept.child.role {
                return true
            }
        }
    }
    false
}

fn group_live(f: Fake, g: Group) -> bool {
    for i in 0u64 .. list.len(f.children) {
        let kept = f.children[i].state
        if same_group(kept.child.group, g) && live(kept.phase) {
            return true
        }
    }
    false
}

// The one-launch rule of §14.3: a store-holding launch is refused while another lives,
// unless it is the one candidate that names the live serving child's gen.
fn one_launch(f: Fake, launch: Launch) -> bool {
    let role = role_of(launch.mode)
    if !holds_store(role) {
        return true
    }
    let candidate = match launch.mode {
        ServingMode(_, serve) => serve.candidate,
        _ => None,
    }
    let mut holders = 0u64
    let mut named = false
    for i in 0u64 .. list.len(f.children) {
        let kept = f.children[i].state
        if same_group(kept.child.group, launch.group) && live(kept.phase) && holds_store(kept.child.role) {
            holders += 1u64
            if let (Serving(g), Some(old)) = (kept.child.role, candidate) {
                if g == old {
                    named = true
                }
            }
        }
    }
    holders == 0u64 || (holders == 1u64 && named)
}

fn push_event(mut out: List[Event], take e: Event) {
    list.push(mut out, take e)
}

// Answer one request. The returned events follow in stream order.
pub fn handle(mut f: Fake, take r: Request) -> List[Event] {
    let mut out: List[Event] = list.new()
    match take r {
        Hello => {
            f.fenced = false
            let mut states: List[ChildState] = list.new()
            for i in 0u64 .. list.len(f.children) {
                list.push(mut states, clone(f.children[i].state))
            }
            let mut readable: List[Group] = list.new()
            for i in 0u64 .. list.len(f.listeners) {
                let report = f.listeners[i].readable && !serving_live(f, f.listeners[i].group)
                if report {
                    list.push(mut readable, clone(f.listeners[i].group))
                    f.listeners[i].reported = true
                }
            }
            let mut keys: List[CutoverKey] = list.new()
            for i in 0u64 .. list.len(f.cutovers) {
                list.push(mut keys, clone(f.cutovers[i].key))
            }
            push_event(mut out, Inventory(take states, take readable, take keys))
        },
        Bind(take g, _) => {
            if let None = find_listener(f, g) {
                list.push(mut f.listeners, Listener(group: clone(g), readable: false, reported: false, retiring: false))
            }
            push_event(mut out, Bound(take g))
        },
        Close(take g) => {
            if let Some(i) = find_listener(f, g) {
                let last = list.len(f.listeners) - 1u64
                list.swap(mut f.listeners, i, last)
                let _ = list.pop(mut f.listeners)
            }
            push_event(mut out, Closed(take g))
        },
        Start(take launch) => {
            let child = Child(group: clone(launch.group), role: role_of(launch.mode))
            if let Some(i) = find_child(f, child) {
                push_event(mut out, Launched(take child, clone(f.children[i].state.phase)))
                return take out
            }
            let refusal = match find_listener(f, launch.group) {
                None => Some(UnknownGroup),
                Some(i) if f.listeners[i].retiring => Some(Retiring),
                Some(_) if list.len(launch.assembly) != 32u64 => Some(Mismatch),
                Some(_) if !one_launch(f, launch) => Some(Held),
                Some(_) => None,
            }
            match take refusal {
                Some(take why) => push_event(mut out, Refused(take child, take why)),
                None => {
                    let selected = match launch.mode {
                        ServingMode(_, serve) => Some(Selection(activation: serve.activation, assembly: clone(launch.assembly))),
                        _ => None,
                    }
                    list.push(mut f.children, Kept(state: ChildState(child: clone(child), phase: Started, selection: take selected, answer: None)))
                    push_event(mut out, Launched(take child, Started))
                },
            }
        },
        Stop(_) => (),
        Kill(_) => (),
        Acknowledge(take c) => {
            if let Some(i) = find_child(f, c) {
                if !live(f.children[i].state.phase) {
                    let last = list.len(f.children) - 1u64
                    list.swap(mut f.children, i, last)
                    let _ = list.pop(mut f.children)
                }
            }
        },
        Command(take c, take command) => cutover(mut f, take c, take command, mut out),
        Retire(take g) => {
            if let Some(i) = find_listener(f, g) {
                f.listeners[i].retiring = true
            }
            if !group_live(f, g) {
                push_event(mut out, Retired(take g))
            }
        },
        Release(_) => (),
        CollectBegin => {
            f.fenced = true
            push_event(mut out, Fenced)
        },
        Collect(_) => {
            f.fenced = false
            push_event(mut out, Collected(0u64))
        },
        CollectAbort => {
            f.fenced = false
            push_event(mut out, Collected(0u64))
        },
        Admit(_, _, _, _) => (),
        AdmitData(_, _) => (),
        AdmitEnd(_) => (),
        Assemble(_) => (),
        CutoverAck(take c, a) => {
            if let Some(i) = find_key(f, c, a) {
                let last = list.len(f.cutovers) - 1u64
                list.swap(mut f.cutovers, i, last)
                let _ = list.pop(mut f.cutovers)
            }
        },
    }
    take out
}

// The fake can keep a startup reply while the host has no session.
pub fn remember_place_answer(mut f: Fake, c: Child, take answer: runner.HostReply) {
    if let Some(i) = find_child(f, c) {
        if live(f.children[i].state.phase) {
            f.children[i].state.answer = Some(take answer)
        }
    }
}

// A live child ends. The fake samples the listener first and sends the end with it, and
// only then watches the listener again (§14.3), so an `Arrived` can only follow the end.
pub fn end(mut f: Fake, c: Child, status: Status, report: Option[Option[u64]]) -> List[Event] {
    let mut out: List[Event] = list.new()
    let Some(i) = find_child(f, c) else {
        return take out
    }
    if !live(f.children[i].state.phase) {
        return take out
    }
    let mut readable = false
    let mut retiring = false
    if let Some(l) = find_listener(f, c.group) {
        readable = f.listeners[l].readable
        retiring = f.listeners[l].retiring
        f.listeners[l].reported = readable
    }
    let ended = End(status: status, report: report, readable: readable)
    f.children[i].state.phase = Exited(clone(ended))
    push_event(mut out, Ended(clone(c), take ended))
    if let Some(k) = find_held(f, c) {
        let unanswered = match f.cutovers[k].reply {
            None => true,
            Some(_) => false
        }
        if unanswered {
            f.cutovers[k].reply = Some(PlaceUncertain)
            push_event(mut out, CutoverResult(clone(c), f.cutovers[k].key.attempt, PlaceUncertain))
        }
    }
    if retiring && !group_live(f, c.group) {
        push_event(mut out, Retired(clone(c.group)))
    }
    take out
}

// A client connects to the group's listener and waits in its backlog.
pub fn connect(mut f: Fake, g: Group) -> List[Event] {
    let mut out: List[Event] = list.new()
    let Some(l) = find_listener(f, g) else {
        return take out
    }
    f.listeners[l].readable = true
    if !f.listeners[l].reported && !serving_live(f, g) {
        f.listeners[l].reported = true
        push_event(mut out, Arrived(clone(g)))
    }
    take out
}

// The group's serving child accepted every waiting connection.
pub fn accept(mut f: Fake, g: Group) {
    if let Some(l) = find_listener(f, g) {
        f.listeners[l].readable = false
        f.listeners[l].reported = false
    }
}

// Whether a collection fence is held.
pub fn fenced(f: Fake) -> bool {
    f.fenced
}

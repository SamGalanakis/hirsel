; Suspended frames of fixed blocks under a counted drain (node-bytes-1076).
; f1(k): Rc[Holder{xs: Inline[Pair, 2]}], Pair{pad, left: Box[Tree], right: Box[Tree]},
;   each box a Leaf except xs[1].left, a Node of two Leaves, which suspends in its own
;   block and so writes its frame into its spare word. The drain suspends Holder at
;   the same record for both elements, so the record's offsets must not move with
;   the element.
; f2(k): Rc[Two], Two = Q{k: u32, a: Box[Tree]} | P{a: Box[Tree], b: Box[Tree]}, case P
;   when k is 0. Both cases suspend at cursor 1, P with A at 16 and Q with A at 8,
;   so only the record, never (shape, cursor), names the payload base. P suspends
;   with a still to clean, so its tag byte @0 is live: a frame word there would read
;   back as the low byte of an 8-aligned pointer, never P's 1, and leak a.
; Behaviour, derived by hand: every block is freed once and refunded to its payer.
; run: f1(0) -> 0 | used 0
; run: f2(0) -> 0 | used 0
; run: f2(1) -> 1 | used 0
core v1
type t0 = own "Tree" | Leaf { } | Node { left: box t0, right: box t0 }
type t1 = own "Pair" { pad: u64, left: box t0, right: box t0 }
type t2 = own "Holder" { xs: array 2 t1 }
type t3 = own "Root" { h: rc t2 }
type t4 = own "Two" | Q { k: u32, a: box t0 } | P { a: box t0, b: box t0 }
type t5 = own "Root2" { h: rc t4 }
sig g0 = (u64) -> (u64)
sig g1 = () -> (ptr)
inst n0 = test@0/counted_frames/leaf [] []
inst n1 = test@0/counted_frames/holder [] []
inst n2 = test@0/counted_frames/two [] []
inst n3 = test@0/counted_frames/node [] []
fn f0 = n0 g1 {
  addr a0 = v2 : t0
b0:
  v0: u64 = const 24                  ; 8 + Tree 16; Leaf is the null left (niche)
  v1: u64 = const 16
  v2: ptr, v3: u64 = alloc for box t0 v1 align 8 charge v0
  v4: ptr = const 0x0
  v5: bool = ne v2, v4
  branch v5, b1, b2
b1:
  address a0
  set_case a0, 0
  return v2
b2:
  raise unwrap
}
fn f1 = n1 g0 {
  slot s0 = t3
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 0 deref field 0 element v6 field 1 : ptr
  addr a2 = s0 field 0 deref field 0 element v6 field 2 : ptr
  addr a3 = s0 field 0 deref field 0 element v7 field 1 : ptr
  addr a4 = s0 field 0 deref field 0 element v7 field 2 : ptr
  addr a5 = s0 field 0 deref field 0 element v6 field 0 : u64
  addr a6 = s0 field 0 deref field 0 element v7 field 0 : u64
  addr a7 = s0 : t3
b0(v0: u64):
  live s0
  address a0
  address a7
  v1: u64 = const 56                  ; count 8 + Holder 48
  v2: u64 = const 56
  v3: ptr, v4: u64 = alloc for rc t2 v2 align 8 charge v1
  v5: ptr = const 0x0
  v6: u64 = const 0
  v7: u64 = const 1
  v8: bool = ne v3, v5
  branch v8, b1, b2
b1:
  store a0, v3
  address a1
  address a2
  address a3
  address a4
  address a5
  address a6
  store a5, v6
  store a6, v7
  v9: ptr = call f0 g1 ()
  store a1, v9
  v10: ptr = call f0 g1 ()
  store a2, v10
  v11: ptr = call f3 g1 ()
  store a3, v11
  v12: ptr = call f0 g1 ()
  store a4, v12
  drop a7 t3
  dead s0
  return v0
b2:
  dead s0
  raise unwrap
}
fn f2 = n2 g0 {
  slot s0 = t5
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 0 deref : t4
  addr a2 = s0 field 0 deref case 1 0 : ptr
  addr a3 = s0 field 0 deref case 1 1 : ptr
  addr a4 = s0 field 0 deref case 0 1 : ptr
  addr a5 = s0 field 0 deref case 0 0 : u32
  addr a6 = s0 : t5
b0(v0: u64):
  live s0
  address a0
  address a6
  v1: u64 = const 32                  ; count 8 + Two 24
  v2: u64 = const 32
  v3: ptr, v4: u64 = alloc for rc t4 v2 align 8 charge v1
  v5: ptr = const 0x0
  v6: u64 = const 0
  v7: bool = ne v3, v5
  branch v7, b1, b4
b1:
  store a0, v3
  address a1
  v8: bool = eq v0, v6
  branch v8, b2, b3
b2:
  address a2
  address a3
  v9: ptr = call f0 g1 ()
  v10: ptr = call f0 g1 ()
  set_case a1, 1
  store a2, v9
  store a3, v10
  drop a6 t5
  dead s0
  return v0
b3:
  address a4
  address a5
  v11: ptr = call f0 g1 ()
  set_case a1, 0
  v12: u32 = const 7
  store a5, v12
  store a4, v11
  drop a6 t5
  dead s0
  return v0
b4:
  dead s0
  raise unwrap
}
fn f3 = n3 g1 {
  addr a0 = v2 : t0
  addr a1 = a0 case 1 0 : ptr
  addr a2 = a0 case 1 1 : ptr
b0:
  v0: u64 = const 24
  v1: u64 = const 16
  v2: ptr, v3: u64 = alloc for box t0 v1 align 8 charge v0
  v4: ptr = const 0x0
  v5: bool = ne v2, v4
  branch v5, b1, b2
b1:
  v6: ptr = call f0 g1 ()
  v7: ptr = call f0 g1 ()
  address a0
  address a1
  address a2
  set_case a0, 1
  store a1, v6
  store a2, v7
  return v2
b2:
  raise unwrap
}

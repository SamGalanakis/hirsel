// A fresh callback environment cannot escape an invocation through a captured slot.
// expect: gap capture descriptor updates through a borrowed place are not built
fn f()->u64 {
 let mut n:u64=1
 let mut m:u64=2
 let mut p=(scoped fn(x:u64)->u64 {n+=x;n},0u64)
 let change=scoped fn() {p.0=scoped fn(x:u64)->u64 {m+=x;m}}
 change()
 p.0(m)
}

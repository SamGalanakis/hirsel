// Laws of core.int's rotations and byte swap (semantics.md SEM-1), each result derived by hand.
// u8 0x81 = 1000_0001: left by 1 is 0000_0011 = 3, and 9 is 1 modulo 8. i8 -128 = 1000_0000
// left by 1 is 1: the count is not read as signed and the top bit wraps to bit 0. u64 2^63
// left by 65 (1 modulo 64) is 1.
// expect: run rotate_left_wraps() = true
fn rotate_left_wraps() -> bool {
    let a: u8 = 129
    let b: i8 = -128
    let c: u64 = 9223372036854775808
    int.rotate_left(a, 1) == 3 && int.rotate_left(a, 9) == 3 && int.rotate_left(b, 1) == 1 && int.rotate_left(c, 65) == 1
}

// u8 0x81 right by 1 is 1100_0000 = 192; by 0 and by 8 it is unchanged. u64 1 right by 1 is
// 2^63. u32 1 right by 33 (1 modulo 32) is 2^31. i16 1 right by 1 is 0x8000 = -32768.
// expect: run rotate_right_wraps() = true
fn rotate_right_wraps() -> bool {
    let a: u8 = 129
    let c: u64 = 1
    let d: u32 = 1
    let e: i16 = 1
    int.rotate_right(a, 1) == 192 && int.rotate_right(a, 0) == 129 && int.rotate_right(a, 8) == 129 && int.rotate_right(c, 1) == 9223372036854775808 && int.rotate_right(d, 33) == 2147483648 && int.rotate_right(e, 1) == -32768
}

// u32 0x01020304 = 16909060 swaps to 0x04030201 = 67305985; u16 0x0102 = 258 to 0x0201 = 513;
// u8 0xAB stays; i16 0x00FF = 255 to 0xFF00 = -256; i64 1 to 0x0100_0000_0000_0000 = 2^56.
// expect: run swap_bytes_reverses() = true
fn swap_bytes_reverses() -> bool {
    let a: u32 = 16909060
    let b: u16 = 258
    let c: u8 = 171
    let d: i16 = 255
    let e: i64 = 1
    int.swap_bytes(a) == 67305985 && int.swap_bytes(b) == 513 && int.swap_bytes(c) == 171 && int.swap_bytes(d) == -256 && int.swap_bytes(e) == 72057594037927936
}

// A replacement that reads captured anchors is OWN-21.
// expect: refuse OWN-21 at 10:9
fn f() -> u64 {
    let mut n: u64 = 1
    let mut cb = scoped fn(x: u64) -> u64 {
        n += x;
        n
    }
    let change = scoped fn() {
        cb = scoped fn(x: u64) -> u64 {
            cb(x) + 1
        }
    }
    change()
    cb(2)
}

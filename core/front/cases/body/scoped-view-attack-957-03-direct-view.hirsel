fn run(mut xs: List[u64]) -> Result[Result[u64, Causes], Capacity] {
    isolate(fn() -> u64 {
        list.len(xs)
    })
}

pub fn main() -> Result[(), ()] {
    let mut xs: List[u64] = list.new();
    let _ = run(mut xs);
    Ok(())
}

pub fn oracle() -> u64 {
    let mut xs: List[u64] = list.new();
    let _ = list.push(mut xs, 7u64);
    match run(mut xs) {
        Ok(Ok(n)) => n,
        _ => 99
    }
}
// expect: run oracle() = 1

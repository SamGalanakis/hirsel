#!/usr/bin/env python3
"""Run chosen conformance cases on the checked compiler, spread over the pool.

    tools/corpus conformance/STORE conformance/MODE/MODE-3-   # directories, files or prefixes
    tools/corpus --slices 12 conformance/SEM
    tools/corpus --native conformance/STORE/STORE-3-       # the per-push smoke configurations
    tools/corpus --native --heap-parts 32 --config x86_64/regions/elide/reuse/flat-walk/heap+inject conformance/STORE/STORE-3-
    tools/corpus --native --full-matrix conformance/OWN/OWN-4-   # every configuration the full gate runs
    tools/corpus --native --config x86_64/regions/elide/reuse/flat-walk/llvm-O3/whole/default conformance/OWN/OWN-5-

Buck2 builds the checked `hirsel-conformance` and the std products it needs
from this checkout (cached by content on the pool), so a std or compiler edit
is picked up without a local toolchain or precompute step. The prefixes run as
`//:gate-conformance-selected-shard-<i>`, each the binary's `--shard i/N`
path-hash partition of the same `--path` selection (`hirsel.conformance_paths_split`,
defs.bzl selected_paths), with about CONFORMANCE_SLICE_PROGRAMS cases per slice.
Prints the summed counts and every failing case; exits non-zero when any slice
fails or none executed a case.

A case with a `// cuts: A..=B` header runs once per cut K, as `case@K`: a
prefix selects all its cuts, `case@K` (native only; the interpreter runs every
cut of the file) that one. `--selection store-land` and `--selection
store-milestone` name the cut-sweep selections STORE lands and milestones run
(named_selection; sync.py NATIVE_STORE_LAND holds the shares a land runs), and
`--native --plan` prints a selection's planned pool CPU-h without running it.

`--heap-parts N` distributes the entire fault domain of explicitly selected
heap+inject configurations. Every part checks the clean run; aggregation requires
all parts, including matching partition metadata. Without it, campaigns are
planned from sync.py's NATIVE_HEAP_COSTS, each case's measured seconds a fault
site (a case with no row: the worst figure of its rule, never a guess): a run's
action runs its heap+inject campaign whole when its sites fit
NATIVE_HEAP_FAULT_SECONDS at the worst selected cost; over that it checks the
clean run and reports the campaign parted, and later rounds run each parted
(case, configuration) as ceil(sites x cost / NATIVE_HEAP_FAULT_SECONDS) heap
parts of their own, every part required, so every site is injected and judged.
A case under a row of sync.py's NATIVE_HEAP_ROTATIONS (N shares) instead has
one share of its sites injected a run, in ceil(sites / N x cost /
NATIVE_HEAP_FAULT_SECONDS) parts: share T is the sites with site % N == T - 1.
The share is chosen from the checked commit among those not yet passed in the
current cycle, printed, and, when the selection holds every run of the family,
recorded with its verdict in the git common directory's
hirsel-heap-rotations.tsv, so N passing runs cover every site once.

`--native` runs the same selection through gate-native-full (`--full --filter`,
the full gate's seed and request) as `//:gate-native-selected-shard-<i>`: one
action per selected case by default, all its named configurations over one
prepare and shared builds (`hirsel.native_paths`, `_split`, `_parts`,
`_configs`; `--parts` splits a case's configurations). By default those are
the per-push smoke configurations (`--config smoke`: the default passes on the
heap executor and at O3 on x86-64 with the diagnostic and shipped archives),
each run whether or not the case's rotating cover holds it. `--config NAME`
(repeatable, with or without launch seeds; an unknown name lists the matrix)
runs those instead, for a bisect. `--full-matrix` runs each case's own pairwise
cover, chosen over the whole matrix before slicing, so every (case,
configuration) verdict is the full gate's; on 2026-11-10 that cost OWN-4's 15
cases 42,139 pool seconds. Slices are sized so the heaviest one's estimated
warm time stays under sync.py's NATIVE_SLICE_SECONDS (a full-matrix cover in
up to NATIVE_COVER_PARTS parts, up to NATIVE_SELECTED_SLICES slices); a
selection that cannot fit is refused before anything runs. Prints every
unlisted or stale exclusion row.
"""
import datetime
import json
import argparse
import math
from pathlib import Path
import subprocess
import sys
import re

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/buck2'))
import conformance  # noqa: E402
import event_logs  # noqa: E402
from run_failures import first_error_line  # noqa: E402
from sync import (CONFORMANCE_SLICE_PROGRAMS, NATIVE_CONFIG_SECONDS, NATIVE_COVER_PART_SECONDS,  # noqa: E402
                  NATIVE_COVER_PARTS, NATIVE_HEAP_COSTS, NATIVE_HEAP_FAULT_SECONDS, NATIVE_HEAP_PART_SECONDS,
                  NATIVE_HEAP_ROTATIONS, NATIVE_STORE_LAND,
                  NATIVE_SELECTED_SLICES, NATIVE_SLICE_SECONDS, SELECTED_SLICES)

CUT = re.compile(r'^(.+\.hir)@(\d+)$')
STORE = 'conformance/STORE/'


def runs_of(corpus, prefixes):
    """The run IDs a selection names, in corpus order: every run of a file a
    prefix starts, and the one run a `case@K` prefix names."""
    selected = []
    for case in corpus:
        if not any(case.startswith(CUT.sub(r'\1', p)) for p in prefixes):
            continue
        for run in conformance.run_ids(case, (ROOT / case).read_text()):
            if any(run == p if CUT.match(p) else case.startswith(p) for p in prefixes):
                selected.append(run)
    return selected


def land_rows():
    """NATIVE_STORE_LAND rows: (key, N), in file order."""
    rows = []
    for line in (ROOT / NATIVE_STORE_LAND).read_text().splitlines():
        if line and not line.startswith('#'):
            key, shares, _ = line.split('\t')
            rows.append((key, int(shares)))
    return rows


def named_selection(name, corpus, parent):
    """A named selection's prefixes. `store-land`: per NATIVE_STORE_LAND row,
    one case of its key and one share of that case's cuts, both from the count
    of commits up to the land's parent, printed. `store-milestone`: every
    cut-sweep case of conformance/STORE but those every land runs whole."""
    swept = sorted(c for c in corpus if c.startswith(STORE)
                   and conformance.run_ids(c, (ROOT / c).read_text()) != [c])
    rows = land_rows()
    if name == 'store-milestone':
        whole = {c for key, shares in rows if shares == 1 for c in swept if c.startswith(key)
                 and len([d for d in swept if d.startswith(key)]) == 1}
        return [c for c in swept if c not in whole]
    if name != 'store-land':
        raise ValueError(f'unknown selection {name}; known: store-land, store-milestone')
    count = int(subprocess.check_output(['git', 'rev-list', '--count', parent], cwd=ROOT, text=True))
    chosen = []
    for key, shares in rows:
        cases = [c for c in swept if c.startswith(key)]
        if not cases:
            raise ValueError(f'{NATIVE_STORE_LAND}: {key} names no cut-sweep case')
        case = cases[count // shares % len(cases)]
        share = count % shares
        cuts = [run for i, run in enumerate(conformance.run_ids(case, (ROOT / case).read_text())) if i % shares == share]
        print(f'corpus: store-land at parent {parent} (commit {count}): {Path(case).name}, share {share + 1}/{shares} '
              f'of its cuts ({", ".join(run.rsplit("@", 1)[1] for run in cuts)})', file=sys.stderr, flush=True)
        chosen += cuts
    return chosen


def heap_costs():
    """NATIVE_HEAP_COSTS rows: case or prefix -> (sites, seconds a site, note)."""
    rows = {}
    for line in (ROOT / NATIVE_HEAP_COSTS).read_text().splitlines():
        if line and not line.startswith('#'):
            key, sites, cost, note = line.split('\t')
            rows[key] = (int(sites), float(cost), note)
    return rows


def heap_cost(run, costs):
    """Planned seconds a fault site of `run`: the longest matching row, else the
    worst figure of its rule (its family), else the worst at all."""
    keys = [key for key in costs if run == key or run.startswith(key)]
    if keys:
        return costs[max(keys, key=len)][1]
    rule = re.match(r'(.*/[A-Z]+-\d+)-', run)
    family = [cost for key, (_, cost, _) in costs.items() if rule and key.startswith(rule[1] + '-')]
    return max(family or [cost for _, cost, _ in costs.values()])


def plan(runs, costs):
    """Print the selection's planned pool CPU-h a native smoke run costs, per
    case and in total: each run's clean configurations (NATIVE_CONFIG_SECONDS
    each) and, from its NATIVE_HEAP_COSTS row, its heap+inject campaign of the
    row's sites at the row's seconds a site, one clean run checked a heap part.
    Returns 2 when a run has no measured row."""
    unmeasured = sorted({CUT.sub(r'\1', run) for run in runs
                         if not any(run == key or run.startswith(key) for key in costs)})
    if unmeasured:
        print(f'corpus: no {NATIVE_HEAP_COSTS} row for {", ".join(unmeasured)}; measure it first', file=sys.stderr)
        return 2
    total, by_case = 0.0, {}
    for run in runs:
        sites, cost, _ = costs[max((key for key in costs if run == key or run.startswith(key)), key=len)]
        heap = sites * cost
        parts = math.ceil(heap / NATIVE_HEAP_FAULT_SECONDS)
        seconds = heap + (3 + parts) * NATIVE_CONFIG_SECONDS
        case = CUT.sub(r'\1', run)
        count, sum_ = by_case.get(case, (0, 0.0))
        by_case[case] = (count + 1, sum_ + seconds)
        total += seconds
    for case, (count, seconds) in by_case.items():
        print(f'plan: {Path(case).name}: {count} runs, {seconds / 3600:.2f} CPU-h')
    print(f'plan: {len(runs)} runs, {total / 3600:.2f} CPU-h')
    return 0


def heap_rotations():
    """NATIVE_HEAP_ROTATIONS rows: case or prefix -> the shares its fault sites
    are split into, one injected a run."""
    rows = {}
    for line in (ROOT / NATIVE_HEAP_ROTATIONS).read_text().splitlines():
        if line and not line.startswith('#'):
            key, shares, _ = line.split('\t')
            rows[key] = int(shares)
    return rows


def rotation_key(run, rotations):
    """The longest rotation row `run` falls under, or None."""
    keys = [key for key in rotations if run == key or run.startswith(key)]
    return max(keys, key=len) if keys else None


def family_runs(key):
    """Every corpus run under rotation row `key`."""
    return runs_of(cases(ROOT), [key])


def rotation_ledger():
    """Where runs record each rotated share and its verdict: shared by every
    worktree of the repository."""
    common = subprocess.check_output(['git', 'rev-parse', '--git-common-dir'], cwd=ROOT, text=True).strip()
    return (ROOT / common).resolve() / 'hirsel-heap-rotations.tsv'


def rotation_cycle(key, shares, ledger):
    """The shares of `key` passed in its current cycle (a cycle ends when every
    one of the `shares` has passed), and how many cycles have completed."""
    passed, cycles = set(), 0
    lines = ledger.read_text().splitlines() if ledger.exists() else []
    for line in lines:
        _, _, row_key, share, verdict = line.split('\t')
        number, of = (int(n) for n in share.split('/'))
        if row_key == key and of == shares and verdict == 'pass':
            passed.add(number)
            if len(passed) == shares:
                passed, cycles = set(), cycles + 1
    return passed, cycles


def rotation_share(key, shares, commit, ledger):
    """The share of `key` this run injects: chosen by `commit` among those not
    passed in the current cycle."""
    passed, _ = rotation_cycle(key, shares, ledger)
    open_shares = [n for n in range(1, shares + 1) if n not in passed]
    return open_shares[int(commit[:12], 16) % len(open_shares)]


def cases(root):
    """Repository-relative corpus files, as hirsel-conformance discovers them."""
    found = []
    stack = [root / 'conformance']
    while stack:
        for entry in stack.pop().iterdir():
            if entry.is_dir():
                if entry.name != 'reports':
                    stack.append(entry)
            elif entry.suffix == '.hir':
                found.append(entry.relative_to(root).as_posix())
    return found


def interpreter_reports(outputs):
    """Decode the compiler's existing JSON report, preserving every case verdict."""
    reports = []
    for name, output in sorted(outputs.items()):
        match = re.search(r'^\{', output, re.M)
        if not match:
            raise ValueError(f'{name}: no conformance JSON report')
        report = json.JSONDecoder().raw_decode(output, match.start())[0]
        reports.append(report)
    return reports


def execute(command, structured=False):
    if not structured:
        return subprocess.call(command, cwd=ROOT)
    # Buck echoes each failing compiler's entire JSON report. The event log
    # retains it; print the case diagnostics below instead of duplicating it.
    with subprocess.Popen(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          text=True, errors='replace') as child:
        for line in child.stdout:
            if not re.match(r'^(?:\[[^]]+\] )?\{"errors":', line):
                print(line, end='', flush=True)
        return child.wait()


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--slices', type=int, help=f'pool actions (1-{SELECTED_SLICES}; default by case count)')
    parser.add_argument('--native', action='store_true', help="through the native gate's configurations")
    parser.add_argument('--parts', type=int, help='--native: configuration parts per case (default fills the slices)')
    parser.add_argument('--heap-parts', type=int, default=1, help='--native: disjoint heap+inject fault partitions; all parts are required')
    parser.add_argument('--config', action='append', default=[], metavar='NAME',
                        help='--native: run only this configuration (repeatable; default smoke)')
    parser.add_argument('--full-matrix', action='store_true',
                        help="--native: every configuration of each case's full-gate cover")
    parser.add_argument('--report-json', type=Path, help='write per-slice compiler reports for main-runs')
    parser.add_argument('--selection', choices=['store-land', 'store-milestone'],
                        help='a named selection instead of prefixes (see named_selection)')
    parser.add_argument('--parent', default='HEAD^', help="--selection store-land: the land's parent commit")
    parser.add_argument('--plan', action='store_true', help="--native: print the selection's planned CPU-h and run nothing")
    parser.add_argument('prefixes', nargs='*', metavar='PREFIX')
    args = parser.parse_args()
    if bool(args.selection) == bool(args.prefixes):
        parser.error('name either prefixes or one --selection')
    if (args.parts or args.config or args.full_matrix or args.heap_parts != 1) and not args.native:
        parser.error('--parts, --config and --full-matrix need --native')
    if args.plan and not (args.native and args.config in ([], ['smoke']) and args.heap_parts == 1):
        parser.error('--plan plans a native smoke run: --native, no --config, --full-matrix or --heap-parts')
    if args.config and args.full_matrix:
        parser.error('--config and --full-matrix exclude each other')
    if args.native and not (args.config or args.full_matrix):
        args.config = ['smoke']
    if args.heap_parts < 1 or args.heap_parts > NATIVE_SELECTED_SLICES:
        parser.error(f'--heap-parts must be 1..{NATIVE_SELECTED_SLICES}')
    if args.heap_parts > 1 and (args.full_matrix or not args.config or any(not c.endswith('/heap+inject') for c in args.config)):
        parser.error('--heap-parts requires explicit heap+inject configurations only')
    corpus = cases(ROOT)
    if args.selection:
        args.prefixes = named_selection(args.selection, corpus, args.parent)
    prefixes = [p.rstrip('/') + '/' if (ROOT / p).is_dir() else p for p in args.prefixes]
    unmatched = [p for p in prefixes if not runs_of(corpus, [p])]
    if unmatched or any('|' in p or ';' in p for p in prefixes):
        print(f'corpus: no corpus case matches {unmatched or prefixes}', file=sys.stderr)
        return 2
    if any('|' in c or ';' in c for c in args.config):
        print(f'corpus: bad configuration name in {args.config}', file=sys.stderr)
        return 2
    # A swept case counts once per cut: each is a run with its own verdict.
    runs = runs_of(corpus, prefixes)
    selected = len(runs)
    if args.plan:
        return plan(runs, heap_costs())
    if args.native:
        return native(prefixes, runs, args)
    # The interpreter runs a swept case's every cut; a `case@K` prefix selects its file.
    prefixes = sorted({CUT.sub(r'\1', p) for p in prefixes})
    runs = runs_of(corpus, prefixes)
    selected = len(runs)
    slices = args.slices or math.ceil(selected / CONFORMANCE_SLICE_PROGRAMS)
    files = len({CUT.sub(r'\1', run) for run in runs})
    slices = max(1, min(slices, SELECTED_SLICES, files))
    print(f'corpus: {selected} runs in {slices} slices', file=sys.stderr, flush=True)
    subprocess.run([sys.executable, str(ROOT / 'tools/buck2/sync.py'), '--if-stale'], cwd=ROOT, check=True)
    targets = [f'//:gate-conformance-selected-shard-{i}' for i in range(1, slices + 1)]
    config = ['-c', 'hirsel.conformance_paths=' + '|'.join(prefixes),
              '-c', f'hirsel.conformance_paths_split={slices}']
    with event_logs.recorded('corpus') as event_log:
        status = execute([str(conformance.BUCK2), 'test', *conformance.CONFIG, *config,
                                  '--event-log', str(event_log), *targets,
                                  *(['--', '--test-arg=--json'] if args.report_json else [])], structured=bool(args.report_json))
        outputs = conformance.shard_outputs(event_log)
    if args.report_json:
        reports, names, problems = [], [], []
        for name, output in sorted(outputs.items()):
            try:
                reports.extend(interpreter_reports({name: output}))
                names.append(name)
            except (ValueError, KeyError) as error:
                problems.append(str(error))
        # A failed slice must not discard all the other slices' observations.
        # Keep the report inputs small; event logs retain the compiler's full output.
        records = []
        for report in reports:
            record = {key: report[key] for key in ('summary', 'in_gate', 'selection', 'format_exemptions', 'errors') if key in report}
            failed = {case['path'] for case in report['tests'] if case['status'] == 'fail'}
            if 'errors' in record:
                record['errors'] = [error for error in record['errors'] if not
                    (error.partition(': ')[0] in failed and ': an in-gate file must pass, got ' in error)]
            record['tests'] = [dict(path=case['path'], status=case['status'], reason=first_error_line(case.get('reason') or '') or None,
                                    actual=case.get('actual') if re.fullmatch(r'accept(?:ed)?(?: entry)?', case.get('actual') or '', re.I) else None)
                               for case in report['tests']]
            records.append(record)
        with args.report_json.open('w') as out:
            json.dump(dict(version=1, expected_slices=slices, reports=records, problems=problems,
                           selected_cases=sorted(runs)), out)
        # Keep the usual CLI summaries and failure lines as well as the JSON artifact.
        outputs = {name: '\n'.join([
            f'{label}: ' + ' / '.join(f'{report[key][field]} {word}' for field, word in
                [('validated', 'validated'), ('passing', 'passing'), ('failing', 'failing'), ('not_implemented', 'not implemented')])
            for label, key in [('whole corpus', 'summary'), ('in-gate corpus', 'in_gate')]])
            + f'\ncorpus formatting: {len(report["format_exemptions"])} intentional syntax rejections exempt\n'
            + '\n'.join(f'{test["path"]}: {test["reason"]}' for test in report['tests'] if test['status'] == 'fail')
            for name, report in zip(names, records)}
        for problem in problems:
            print(f'corpus: {problem}', file=sys.stderr)
    for name, output in sorted(outputs.items()):
        for line in output.splitlines():
            if line.startswith('conformance/') or line.startswith('--path ') or 'matched no corpus' in line:
                print(f'{name.rsplit("-", 1)[-1]}: {line}')
    try:
        lines = conformance.summarize(outputs, slices)
    except ValueError as error:
        print(f'corpus: {error}', file=sys.stderr)
        return status or 1
    print('\n'.join(lines))
    executed = int(lines[0].split(': ', 1)[1].split()[0])
    if executed != selected:
        print(f'corpus: {executed} of {selected} selected cases executed', file=sys.stderr)
        return status or 1
    return status


def native(prefixes, runs, args):
    """The selection through gate-native-full's matrix: one action per run (or
    run shards times configuration parts), then the parted heap campaigns,
    each in parts sized by its measured cost (heap_cost), a rotated one's over
    the share of its sites this run injects (heap_rotations)."""
    costs, rotations = heap_costs(), heap_rotations()
    # A whole campaign of up to sites_max sites holds at most
    # NATIVE_HEAP_FAULT_SECONDS of faults at the worst planned cost.
    worst = max(heap_cost(run, costs) for run in runs)
    sites_max = max(1, int(NATIVE_HEAP_FAULT_SECONDS / worst)) if args.heap_parts == 1 else None
    result = native_selection(prefixes, len(runs), args, sites_max)
    if isinstance(result, int):
        return result
    status, problems, reports, attempts, cases, parted, expected = result
    # Each parted (case, configuration) as its own heap parts, every part
    # checking the clean run and injecting a disjoint share of the sites, the
    # share sized so its expected faults stay under NATIVE_HEAP_FAULT_SECONDS.
    commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
    ledger = rotation_ledger()
    chosen, groups = {}, {}
    for row in parted:
        key = rotation_key(row['case'], rotations)
        rotation = None
        if key:
            if key not in chosen:
                chosen[key] = rotation_share(key, rotations[key], commit, ledger)
            rotation = (chosen[key], rotations[key])
        sites = row['sites'] / rotation[1] if rotation else row['sites']
        parts = math.ceil(sites * heap_cost(row['case'], costs) / NATIVE_HEAP_FAULT_SECONDS)
        groups.setdefault((parts, rotation), []).append(row)
    for key, share in sorted(chosen.items()):
        passed, cycles = rotation_cycle(key, rotations[key], ledger)
        print(f'corpus: {key}: heap fault sites share {share}/{rotations[key]} at {commit[:12]}; '
              f'cycle {cycles + 1} has passed shares {sorted(passed) or "none"}', file=sys.stderr, flush=True)
    for (heap_parts, rotation), rows in sorted(groups.items(), key=lambda item: (item[0][0], item[0][1] or (0, 0))):
        configs = sorted({row['configuration'] for row in rows})
        ids = sorted({row['case'] for row in rows})
        per_round = NATIVE_SELECTED_SLICES // (len(configs) * heap_parts)
        if per_round == 0:
            problems.append(f'{", ".join(ids)}: {heap_parts} heap fault parts per configuration, '
                            f'over {NATIVE_SELECTED_SLICES} slices; not run')
            continue
        verdicts = {}
        for at in range(0, len(ids), per_round):
            chunk = ids[at:at + per_round]
            print(f'corpus: {len(chunk)} parted heap campaigns x {heap_parts} heap fault parts'
                  + (f' of share {rotation[0]}/{rotation[1]}' if rotation else ''), file=sys.stderr, flush=True)
            more = native_round(chunk, len(chunk), len(configs), configs, heap_parts, None, 'corpus-native-heap', rotation)
            status = status or more[0]
            problems += more[1]
            reports += more[2]
            attempts += more[3]
            expected += more[6]
            for case in chunk:
                verdicts[case] = verdicts.get(case, True) and more[0] == 0 and not more[1]
        if rotation:
            # A share passes only when every campaign of its family under it
            # passed, and covers the family only when the selection held all
            # its runs.
            by_key = {}
            for case, ok in verdicts.items():
                key = rotation_key(case, rotations)
                by_key[key] = by_key.get(key, True) and ok
            for key in sorted(by_key):
                missing = sorted(set(family_runs(key)) - set(runs))
                if missing:
                    print(f'corpus: {key}: share {rotation[0]}/{rotation[1]} not recorded: the selection '
                          f'leaves out {len(missing)} of its runs', file=sys.stderr)
                    del by_key[key]
            with ledger.open('a') as out:
                for key, ok in sorted(by_key.items()):
                    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
                    out.write(f'{stamp}\t{commit}\t{key}\t{rotation[0]}/{rotation[1]}\t{"pass" if ok else "fail"}\n')
    print(f'native: {cases} executable cases, {attempts} configuration attempts, {len(reports)} of {expected} slices')
    for line in problems:
        print(line)
    if args.report_json:
        args.report_json.write_text(json.dumps(dict(version=1, native=True, expected_slices=expected,
                                                    reports=reports)) + '\n')
    if not cases:
        print('corpus: no executable case ran', file=sys.stderr)
        return status or 1
    return status or (1 if problems else 0)


def native_selection(prefixes, selected, args, sites_max):
    """Round one over `selected` runs: its native_round result, or an exit code
    when the selection cannot fit the slice budget."""
    shards = max(1, min(args.slices or selected, NATIVE_SELECTED_SLICES // args.heap_parts, selected))
    # A named set gives each case at most that many configurations (smoke:
    # three), all in one action unless --parts splits them; a full-matrix
    # cover is cut into at most NATIVE_COVER_PARTS parts.
    named = sum(3 if name == 'smoke' else 1 for name in args.config) or NATIVE_COVER_PARTS
    parts = max(1, min(args.parts or (1 if args.config else named), named,
                       NATIVE_SELECTED_SLICES // (shards * args.heap_parts)))
    heap = sites_max and any(name == 'smoke' or name.endswith('/heap+inject') for name in args.config)
    # Estimated warm seconds of the heaviest slice (sync.py NATIVE_SLICE_SECONDS):
    # a bounded heap campaign costs about one heap part.
    if args.heap_parts > 1:
        per_case = math.ceil(named / parts) * NATIVE_HEAP_PART_SECONDS
    elif args.config:
        per_case = math.ceil(named / parts) * NATIVE_CONFIG_SECONDS + (NATIVE_HEAP_PART_SECONDS if heap else 0)
    else:
        per_case = math.ceil(named / parts) * NATIVE_COVER_PART_SECONDS
    estimate = math.ceil(selected / shards) * per_case
    if estimate > NATIVE_SLICE_SECONDS:
        print(f'corpus: {selected} runs in {shards * parts * args.heap_parts} slices would run about {estimate} s '
              f'per slice, over {NATIVE_SLICE_SECONDS} s; narrow the selection or name fewer configurations',
              file=sys.stderr)
        return 2
    print(f'corpus: {selected} runs in {shards} case parts x {parts} configuration parts x {args.heap_parts} heap fault parts'
          + (f', whole campaigns up to {sites_max} sites' if heap else ''), file=sys.stderr, flush=True)
    subprocess.run([sys.executable, str(ROOT / 'tools/buck2/sync.py'), '--if-stale'], cwd=ROOT, check=True)
    return native_round(prefixes, shards, parts, args.config, args.heap_parts, sites_max if heap else None, 'corpus-native')


def native_round(prefixes, shards, parts, configs, heap_parts, sites_max, log, rotation=None):
    """One buck2 test of shards x parts x heap_parts selected slices: its exit
    status, problems, reports, configuration attempts, executable cases, parted
    campaigns and slice count. With `rotation` (share T of N) the heap parts
    together inject that share: part h is partition T + N(h-1) of N x heap_parts.
    A missing slice or heap part, or wrong part metadata, is a problem."""
    slices = shards * parts * heap_parts
    targets = [f'//:gate-native-selected-shard-{i}' for i in range(1, slices + 1)]
    config = ['-c', 'hirsel.full=true', '-c', 'hirsel.native_paths=' + '|'.join(prefixes),
              '-c', f'hirsel.native_paths_split={shards}', '-c', f'hirsel.native_paths_parts={parts}',
              '-c', 'hirsel.native_paths_configs=' + '|'.join(configs),
              '-c', f'hirsel.native_paths_heap_parts={heap_parts}',
              '-c', f'hirsel.native_paths_heap_sites_max={sites_max or ""}',
              '-c', 'hirsel.native_paths_heap_rotation=' + (f'{rotation[0]}/{rotation[1]}' if rotation else '')]
    with event_logs.recorded(log) as event_log:
        status = subprocess.call([str(conformance.BUCK2), 'test', *conformance.CONFIG, *config,
                                  '--event-log', str(event_log), *targets], cwd=ROOT)
        outputs = conformance.shard_outputs(event_log)
    attempts = cases = 0
    reports, problems, parted = [], [], []
    for name, output in sorted(outputs.items()):
        start = output.find('\n{\n') + 1 if not output.startswith('{\n') else 0
        try:
            report = json.JSONDecoder().raw_decode(output, start)[0] if start or output.startswith('{') else None
        except ValueError:
            report = None
        slice_name = name.rsplit('-', 1)[-1]
        if report is None:
            problems.append(f'{slice_name}: no report')
            for line in output.splitlines()[-20:]:
                print(f'{slice_name}: {line}')
            continue
        if heap_parts > 1 or rotation:
            heap = (int(slice_name) - 1) // (shards * parts) + 1
            expected = ({'index': rotation[0] + rotation[1] * (heap - 1), 'count': rotation[1] * heap_parts}
                        if rotation else {'index': heap, 'count': heap_parts})
            if report.get('heap_partition') != expected:
                problems.append(f'{slice_name}: missing or incorrect heap partition: expected {expected}')
        if sites_max:
            if report.get('heap_sites_max') != sites_max or not isinstance(report.get('heap_parted'), list):
                problems.append(f'{slice_name}: missing or incorrect heap site bound: expected {sites_max}')
            parted += report.get('heap_parted') or []
        reports.append(report)
        attempts += report['configuration_attempts']
        if (int(slice_name) - 1) // shards == 0:
            cases += report['baseline_executable']
        for row in report['baseline_minus_native_unlisted'] + report['stale_exclusions']:
            problems.append(f'{slice_name}: {row}')
        for line in output.splitlines():
            if line.startswith('native: '):
                print(f'{slice_name}: {line}')
    if len(outputs) != slices:
        problems.append(f'{len(outputs)} of {slices} slices reported')
    return status, problems, reports, attempts, cases, parted, slices



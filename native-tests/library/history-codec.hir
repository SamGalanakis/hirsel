// oracle: expected-stdout
// oracle-reason: thousands of random groups, every single-bit flip and truncation of each, and random checkpoint trees exceed the interpreter budget; each law's oracle is the storage spec's History format, checked in-program.
// Laws of std@1/history (docs/spec/storage.md STORE-11, History format):
// 1. a group decodes back to exactly its encoding, under its digest;
// 2. every single-bit flip and every truncation of a group, a head record
//    and a checkpoint node is refused (each is named by a digest or sum);
// 3. a decoder accepts only canonical bytes: whatever it accepts under the
//    flipped bytes' own digest re-encodes to those same bytes;
// 4. leaves are cut exactly where a flat reference of the cut rule cuts,
//    the tree reads back to its state, and equal states give equal roots;
// 5. the chain rules: prev, first, claim epochs and the store identity;
// 6. vectors written by hand from the format: each decodes to exactly its
//    value and that value encodes to exactly its bytes (see `wire_vectors`).

fn random_bytes(mut g: prng.Generator, max: u64) -> Bytes {
  let n = prng.u64(mut g) % (max + 1)
  prng.bytes(mut g, n)
}

fn fixed(mut g: prng.Generator, n: u64) -> Bytes {
  prng.bytes(mut g, n)
}

// Writes with strictly ascending, distinct keys.
fn random_writes(mut g: prng.Generator) -> List[history.Write] {
  let n = prng.u64(mut g) % 5
  let mut keys: List[Bytes] = []
  for _ in 0u64..n {
    let k = random_bytes(mut g, 6)
    let mut seen = false
    for x in keys {
      if x == k {
        seen = true
      }
    }
    if !seen {
      list.push(mut keys, take k)
    }
  }
  let sorted = sort_bytes(take keys)
  let mut out: List[history.Write] = []
  for k in sorted {
    if prng.u64(mut g) % 3 == 0 {
      list.push(mut out, Delete(key: unique k))
    } else {
      list.push(mut out, Put(key: unique k, value: random_bytes(mut g, 8)))
    }
  }
  out
}

fn sort_bytes(take xs: List[Bytes]) -> List[Bytes] {
  let mut v = take xs
  let n = list.len(v)
  for i in 1u64..n {
    let mut j = i
    while j > 0 && v[j] < v[j - 1] {
      let a = copy v[j - 1]
      v[j - 1] = copy v[j]
      v[j] = take a
      j -= 1
    }
  }
  v
}

fn random_descriptor(mut g: prng.Generator) -> history.Descriptor {
  history.Descriptor(
    version: 1u64 + prng.u64(mut g) % 1000,
    digest: fixed(mut g, 32),
    root: fixed(mut g, 32),
    height: int.truncate(1u64 + prng.u64(mut g) % 4),
    entries: prng.u64(mut g) % 100,
    bytes: prng.u64(mut g) % 10000
  )
}

// A commit that may appear at a version above 2.
fn random_commit(mut g: prng.Generator, defs: u32) -> history.Commit {
  let pick = prng.u64(mut g) % 8
  let body: history.Body = if pick < 3 && defs > 0 {
    let arrival: Option[history.Arrival] = if prng.u64(mut g) % 2 == 0 {
      None()
    } else {
      Some(
        history.Arrival(
          identity: fixed(mut g, 32),
          position: prng.u64(mut g),
          digest: fixed(mut g, 32),
          expected: random_bytes(mut g, 33)
        )
      )
    }
    let d: u32 = int.truncate(prng.u64(mut g) % int.widen(defs))
    Transaction(
      history.Call(
        def: d,
        at: int.truncate(prng.u64(mut g)),
        seed: prng.u64(mut g),
        caller: random_bytes(mut g, 10),
        arrival: take arrival,
        args: random_bytes(mut g, 12),
        outcome: random_bytes(mut g, 12)
      )
    )
  } else if pick == 3 {
    let mut records: List[history.Record] = []
    for _ in 0u64..prng.u64(mut g) % 3 {
      list.push(mut records, history.Record(kind: int.truncate(prng.u64(mut g) % 6), payload: random_bytes(mut g, 9)))
    }
    Run(run: fixed(mut g, 16), records: take records)
  } else if pick == 4 {
    Engine(Checkpoint(random_descriptor(mut g)))
  } else if pick == 5 {
    let mut names: List[Bytes] = []
    for _ in 0u64..prng.u64(mut g) % 3 {
      let name = random_bytes(mut g, 5)
      let mut seen = false
      for x in names {
        if x == name {
          seen = true
        }
      }
      if !seen {
        list.push(mut names, take name)
      }
    }
    let mut pins: List[history.Pin] = []
    for name in sort_bytes(take names) {
      list.push(mut pins, history.Pin(name: unique name, version: prng.u64(mut g)))
    }
    let mut checkpoints: List[history.Descriptor] = []
    for _ in 0u64..prng.u64(mut g) % 2 {
      list.push(mut checkpoints, random_descriptor(mut g))
    }
    Engine(Retain(floor: prng.u64(mut g), pins: take pins, checkpoints: take checkpoints))
  } else if pick == 6 {
    if prng.u64(mut g) % 2 == 0 {
      Engine(StreamFence(fixed(mut g, 32)))
    } else {
      Engine(StreamPurge(fixed(mut g, 32)))
    }
  } else {
    Engine(Library(name: random_bytes(mut g, 6), payload: random_bytes(mut g, 10)))
  }
  history.Commit(body: take body, writes: random_writes(mut g))
}

fn random_group(mut g: prng.Generator) -> history.Group {
  let ndefs: u32 = int.truncate(prng.u64(mut g) % 3)
  let mut defs: List[history.Def] = []
  for _ in 0u32..ndefs {
    list.push(mut defs, history.Def(path: random_bytes(mut g, 8), fingerprint: random_bytes(mut g, 8), code: fixed(mut g, 32), revision: random_bytes(mut g, 4)))
  }
  let count = 1u64 + prng.u64(mut g) % 4
  let mut commits: List[history.Commit] = []
  for _ in 0u64..count {
    list.push(mut commits, random_commit(mut g, ndefs))
  }
  history.Group(
    prev: fixed(mut g, 32),
    first: 3u64 + prng.u64(mut g) % 100000,
    epoch: 1u64 + prng.u64(mut g) % 9,
    commits: take commits,
    defs: take defs
  )
}

fn genesis_group(mut g: prng.Generator, prev: Bytes) -> history.Group {
  let b = history.default_bounds()
  history.Group(
    prev: unique prev,
    first: 2,
    epoch: 1,
    commits: [
      history.Commit(
        body: Engine(
          Genesis(
            key_bytes: 4096,
            value_bytes: 1048576,
            transaction_bytes: 16777216,
            range_rows: 10000,
            bounds: b
          )
        ),
        writes: random_writes(mut g)
      )
    ],
    defs: []
  )
}

fn flip(data: Bytes, bit: u64) -> Bytes {
  let mut out: List[u8] = []
  bytes.append(mut out, data)
  let i = bit / 8
  let mask: u8 = int.truncate(1u64 << bit % 8)
  out[i] = out[i] ^ mask
  bytes.from_list(take out)
}

// The refusal the format names for a record changed at byte `at` (none for
// a truncation): a change to the two version digits of the magic is another
// format version, carried as found; anything else is corruption.
fn classified[T](r: Result[T, history.Fault], changed: Bytes, at: Option[u64]) -> bool {
  let version = match at {
    Some(i) => i == 6 || i == 7,
    None() => false,
  }
  match r {
    Ok(_) => false,
    Error(Unsupported(found: f)) => version && f == bytes.slice(changed, 0, 8),
    Error(Corrupt()) => !version,
  }
}

// Law 1 and 3 on a group's bytes; law 2 on every flip and truncation.
fn group_laws(data: Bytes, d: Bytes, damage: bool) -> (bool, bool, bool) {
  let round = match history.decode_group(data, d) {
    Ok(back) => {
      let (again, d2) = history.encode_group(back)
      again == data && d2 == d
    },
    Error(_) => false,
  }
  let mut refused = true
  let mut canonical = true
  let n: u64 = if damage {
    bytes.len(data)
  } else {
    0
  }
  for bit in 0u64..n * 8 {
    let bad = flip(data, bit)
    if !classified(history.decode_group(bad, d), bad, Some(bit / 8)) {
      refused = false
    }
    let own = history.digest(bad)
    if let Ok(x) = history.decode_group(bad, own) {
      let (again, _) = history.encode_group(x)
      if again != bad {
        canonical = false
      }
    }
  }
  for cut in 0u64..n {
    let short = bytes.slice(data, 0, cut)
    if !classified(history.decode_group(short, d), short, None()) {
      refused = false
    }
    let own = history.digest(short)
    if let Ok(x) = history.decode_group(short, own) {
      let (again, _) = history.encode_group(x)
      if again != short {
        canonical = false
      }
    }
  }
  (round, refused, canonical)
}

fn random_head(mut g: prng.Generator) -> history.Head {
  let checkpoint: Option[history.Descriptor] = if prng.u64(mut g) % 2 == 0 {
    None()
  } else {
    Some(random_descriptor(mut g))
  }
  let origin: Option[(Bytes, u64)] = if prng.u64(mut g) % 2 == 0 {
    None()
  } else {
    Some((fixed(mut g, 32), prng.u64(mut g)))
  }
  history.Head(
    identity: fixed(mut g, 32),
    epoch: prng.u64(mut g),
    attempt: fixed(mut g, 16),
    end: prng.u64(mut g),
    digest: fixed(mut g, 32),
    checkpoint: take checkpoint,
    locator: random_bytes(mut g, 12),
    retain: random_bytes(mut g, 20),
    origin: take origin
  )
}

// A random state, ascending by distinct key.
fn random_state(mut g: prng.Generator, n: u64) -> List[(Bytes, Bytes)] {
  let mut keys: List[Bytes] = []
  for i in 0u64..n {
    let mut k: List[u8] = []
    // Distinct keys: a big-endian index after a random prefix byte.
    list.push(mut k, int.truncate(prng.u64(mut g) % 4))
    for j in 0u64..4 {
      list.push(mut k, int.truncate(i >> (24 - j * 8)))
    }
    list.push(mut keys, bytes.from_list(take k))
  }
  let sorted = sort_bytes(take keys)
  let mut out: List[(Bytes, Bytes)] = []
  for k in sorted {
    list.push(mut out, (unique k, random_bytes(mut g, 40)))
  }
  out
}

// The cut rule over a flat list, written from the spec: the leaf entry
// counts of every node, in order.
fn reference_leaves(entries: List[(Bytes, Bytes)], b: history.Bounds) -> List[u64] {
  let mut counts: List[u64] = []
  let mut size: u64 = 13
  let mut count: u64 = 0
  let max: u64 = int.widen(b.node_max)
  let min: u64 = int.widen(b.node_min)
  let mean: u64 = int.widen(b.node_mean)
  for (k, v) in entries {
    let e = 8 + bytes.len(k) + bytes.len(v)
    if count > 0 && size + e > max {
      list.push(mut counts, count)
      size = 13
      count = 0
    }
    size += e
    count += 1
    let h = bytes.sha256(k)
    let x: u64 = int.widen(h[0]) + (int.widen(h[1]) << 8) + (int.widen(h[2]) << 16) + (int.widen(h[3]) << 24)
    if size >= min && x * mean < e * 4294967296 {
      list.push(mut counts, count)
      size = 13
      count = 0
    }
  }
  if count > 0 || list.len(counts) == 0 {
    list.push(mut counts, count)
  }
  counts
}

fn lookup(nodes: List[(Bytes, Bytes)], d: Bytes) -> Bytes {
  for (k, v) in nodes {
    if k == d {
      return unique v
    }
  }
  b""
}

// Reads a tree back level by level; returns the leaf counts and entries.
fn read_tree(tree: history.Tree, d: history.Descriptor) -> Result[(List[u64], List[(Bytes, Bytes)]), history.Fault] {
  let mut expects: List[history.Expect] = [history.root_expect(d)]
  while true {
    let mut blobs: List[Bytes] = []
    for e in expects {
      list.push(mut blobs, lookup(tree.nodes, e.digest))
    }
    match history.check_level(expects, blobs)? {
      Next(below) => {
        expects = take below
      },
      Leaves(entries) => {
        let mut counts: List[u64] = []
        for e in expects {
          list.push(mut counts, e.entries)
        }
        return Ok((take counts, take entries))
      },
    }
  }
  Error(Corrupt())
}

// Law 6: wire vectors written by hand from docs/spec/storage.md, History
// format: every field of every record kind at a value whose bytes differ
// under any reordering or byte order. Each decodes to exactly the value it
// was written from and that value encodes to exactly its bytes; groups
// malformed only in a rule the spec states, under their own digests, and
// checkpoint nodes cut short or wrong across a child boundary, are corrupt.

fn cat(parts: List[Bytes]) -> Bytes {
  let mut out: List[u8] = []
  for p in parts {
    bytes.append(mut out, p)
  }
  bytes.from_list(take out)
}

fn rep(b: u8, n: u64) -> Bytes {
  let mut out: List[u8] = []
  for _ in 0u64..n {
    list.push(mut out, b)
  }
  bytes.from_list(take out)
}

fn sha(x: Bytes) -> Bytes {
  bytes.from_inline(sha256.digest(x))
}

// A group's bytes from its header fields' bytes, commits and definitions.
fn wire_group(first: Bytes, epoch: Bytes, count: Bytes, commits: List[Bytes], defs: Bytes) -> Bytes {
  let mut out: List[u8] = []
  for p in [b"HSHIST02", rep(17, 32), copy first, copy epoch, copy count] {
    bytes.append(mut out, p)
  }
  for c in commits {
    bytes.append(mut out, c)
  }
  bytes.append(mut out, defs)
  bytes.from_list(take out)
}

// first 0x0102030405060708, epoch 0x1112131415161718.
const V_FIRST: Bytes = b"\x08\x07\x06\x05\x04\x03\x02\x01"

const V_EPOCH: Bytes = b"\x18\x17\x16\x15\x14\x13\x12\x11"

// Transaction: def 1, at -2, seed 0x2122232425262728, caller "cl", stream 1
// with identity 32 x 0x31, position 0x3132333435363738, digest 32 x 0x32, expected "ex",
// args "ar", outcome "out"; writes put k1=v1, delete k2.
fn wire_call(def: Bytes, writes: Bytes) -> Bytes {
  cat(
    [
      b"\x01",
      copy def,
      b"\xfe\xff\xff\xff\xff\xff\xff\xff",
      b"\x28\x27\x26\x25\x24\x23\x22\x21",
      b"\x02\x00\x00\x00cl",
      b"\x01",
      rep(49, 32),
      b"\x38\x37\x36\x35\x34\x33\x32\x31",
      rep(50, 32),
      b"\x02\x00\x00\x00ex",
      b"\x02\x00\x00\x00ar",
      b"\x03\x00\x00\x00out",
      copy writes
    ]
  )
}

const V_WRITES: Bytes = b"\x02\x00\x00\x00\x01\x02\x00\x00\x00k1\x02\x00\x00\x00v1\x02\x02\x00\x00\x00k2"

// Transaction: def 0, at 5, seed 6, caller "", stream 0, args "", outcome "o".
const V_CALL2: Bytes = b"\x01\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00o\x00\x00\x00\x00"

// Run 16 x 0x41 with one record of kind 4, payload "rp".
fn wire_run() -> Bytes {
  cat([b"\x03", rep(65, 16), b"\x01\x00\x00\x00\x04\x02\x00\x00\x00rp", b"\x00\x00\x00\x00"])
}

// Engine Library: name "nm", payload "pl".
const V_LIBRARY: Bytes = b"\x02\x07\x0c\x00\x00\x00\x02\x00\x00\x00nm\x02\x00\x00\x00pl\x00\x00\x00\x00"

// Two definitions: p0 f0 32 x 0x51 r0, p1 f1 32 x 0x52 r1.
fn wire_defs() -> Bytes {
  cat(
    [
      b"\x02\x00\x00\x00",
      b"\x02\x00\x00\x00p0\x02\x00\x00\x00f0",
      rep(81, 32),
      b"\x02\x00\x00\x00r0",
      b"\x02\x00\x00\x00p1\x02\x00\x00\x00f1",
      rep(82, 32),
      b"\x02\x00\x00\x00r1"
    ]
  )
}

fn v1_value() -> history.Group {
  history.Group(
    prev: rep(17, 32),
    first: 72623859790382856,
    epoch: 1230066625199609624,
    commits: [
      history.Commit(
        body: Transaction(
          history.Call(
            def: 1,
            at: -2,
            seed: 2387509390608836392,
            caller: b"cl",
            arrival: Some(
              history.Arrival(identity: rep(49, 32), position: 3544952156018063160, digest: rep(50, 32), expected: b"ex")
            ),
            args: b"ar",
            outcome: b"out"
          )
        ),
        writes: [Put(key: b"k1", value: b"v1"), Delete(key: b"k2")]
      ),
      history.Commit(
        body: Transaction(history.Call(def: 0, at: 5, seed: 6, caller: b"", arrival: None(), args: b"", outcome: b"o")),
        writes: []
      ),
      history.Commit(body: Run(run: rep(65, 16), records: [history.Record(kind: 4, payload: b"rp")]), writes: []),
      history.Commit(body: Engine(Library(name: b"nm", payload: b"pl")), writes: [])
    ],
    defs: [
      history.Def(path: b"p0", fingerprint: b"f0", code: rep(81, 32), revision: b"r0"),
      history.Def(path: b"p1", fingerprint: b"f1", code: rep(82, 32), revision: b"r1")
    ]
  )
}

fn v1_wire() -> Bytes {
  wire_group(
    V_FIRST,
    V_EPOCH,
    b"\x04\x00\x00\x00",
    [wire_call(b"\x01\x00\x00\x00", V_WRITES), V_CALL2, wire_run(), V_LIBRARY],
    wire_defs()
  )
}

// A descriptor: version 0x4142434445464748, digest 32 x 0x61, root 32 x 0x62,
// height 2, entries 0x0102, bytes 0x030405.
fn wire_descriptor() -> Bytes {
  cat(
    [
      b"\x48\x47\x46\x45\x44\x43\x42\x41",
      rep(97, 32),
      rep(98, 32),
      b"\x02",
      b"\x02\x01\x00\x00\x00\x00\x00\x00",
      b"\x05\x04\x03\x00\x00\x00\x00\x00"
    ]
  )
}

fn descriptor_value() -> history.Descriptor {
  history.Descriptor(version: 4702394921427289928, digest: rep(97, 32), root: rep(98, 32), height: 2, entries: 258, bytes: 197637)
}

// Engine commits: Checkpoint, Retain (floor 9, pins a=1 and bc=2, one
// descriptor), StreamFence 32 x 0x71, StreamPurge 32 x 0x72, Genesis with the
// default limits and bounds, Fork (identity 32 x 0x81, origin 32 x 0x82, at
// 0x0102030405060708). First 0x0a0b, epoch 3.
fn v2_wire() -> Bytes {
  wire_group(
    b"\x0b\x0a\x00\x00\x00\x00\x00\x00",
    b"\x03\x00\x00\x00\x00\x00\x00\x00",
    b"\x06\x00\x00\x00",
    [
      cat([b"\x02\x03\x59\x00\x00\x00", wire_descriptor(), b"\x00\x00\x00\x00"]),
      cat(
        [
          b"\x02\x04\x84\x00\x00\x00",
          b"\x09\x00\x00\x00\x00\x00\x00\x00",
          b"\x02\x00\x00\x00",
          b"\x01\x00\x00\x00a\x01\x00\x00\x00\x00\x00\x00\x00",
          b"\x02\x00\x00\x00bc\x02\x00\x00\x00\x00\x00\x00\x00",
          b"\x01\x00\x00\x00",
          wire_descriptor(),
          b"\x00\x00\x00\x00"
        ]
      ),
      cat([b"\x02\x06\x21\x00\x00\x00\x01", rep(113, 32), b"\x00\x00\x00\x00"]),
      cat([b"\x02\x06\x21\x00\x00\x00\x02", rep(114, 32), b"\x00\x00\x00\x00"]),
      b"\x02\x01\x1c\x00\x00\x00\x00\x10\x00\x00\x00\x00\x10\x00\x00\x00\x00\x01\x10\x27\x00\x00\x00\x00\x04\x00\x00\x00\x10\x00\x00\x00\x40\x00\x00\x00\x00\x00",
      cat([b"\x02\x05\x48\x00\x00\x00", rep(129, 32), rep(130, 32), V_FIRST, b"\x00\x00\x00\x00"])
    ],
    b"\x00\x00\x00\x00"
  )
}

fn v2_value() -> history.Group {
  history.Group(
    prev: rep(17, 32),
    first: 2571,
    epoch: 3,
    commits: [
      history.Commit(body: Engine(Checkpoint(descriptor_value())), writes: []),
      history.Commit(
        body: Engine(
          Retain(floor: 9, pins: [history.Pin(name: b"a", version: 1), history.Pin(name: b"bc", version: 2)], checkpoints: [descriptor_value()])
        ),
        writes: []
      ),
      history.Commit(body: Engine(StreamFence(rep(113, 32))), writes: []),
      history.Commit(body: Engine(StreamPurge(rep(114, 32))), writes: []),
      history.Commit(
        body: Engine(
          Genesis(
            key_bytes: 4096,
            value_bytes: 1048576,
            transaction_bytes: 16777216,
            range_rows: 10000,
            bounds: history.Bounds(node_min: 262144, node_mean: 1048576, node_max: 4194304)
          )
        ),
        writes: []
      ),
      history.Commit(body: Engine(Fork(identity: rep(129, 32), origin: rep(130, 32), at: 72623859790382856)), writes: [])
    ],
    defs: []
  )
}

// The first claim: prev zeros, first 1, epoch 1, Claim(1, 16 x 0x91, 32 x 0x92).
fn v3_wire() -> Bytes {
  cat(
    [
      b"HSHIST02",
      rep(0, 32),
      b"\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00",
      b"\x02\x02\x38\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00",
      rep(145, 16),
      rep(146, 32),
      b"\x00\x00\x00\x00\x00\x00\x00\x00"
    ]
  )
}

fn v3_value() -> history.Group {
  history.Group(
    prev: rep(0, 32),
    first: 1,
    epoch: 1,
    commits: [history.Commit(body: Engine(Claim(epoch: 1, attempt: rep(145, 16), identity: rep(146, 32))), writes: [])],
    defs: []
  )
}

// A head record with a checkpoint and an origin, and one with neither.
fn wire_head(full: bool) -> Bytes {
  let mut parts: List[Bytes] = [
    b"HSHEAD01",
    rep(161, 32),
    b"\x02\x01\x00\x00\x00\x00\x00\x00",
    rep(162, 16),
    b"\x04\x03\x00\x00\x00\x00\x00\x00",
    rep(163, 32)
  ]
  if full {
    list.push(mut parts, wire_descriptor())
  } else {
    list.push(mut parts, rep(0, 89))
  }
  list.push(mut parts, b"\x02\x00\x00\x00lo\x02\x00\x00\x00re")
  if full {
    list.push(mut parts, b"\x01")
    list.push(mut parts, rep(164, 32))
    list.push(mut parts, b"\x06\x05\x00\x00\x00\x00\x00\x00")
  } else {
    list.push(mut parts, b"\x00")
  }
  let body = cat(take parts)
  cat([copy body, sha(body)])
}

fn head_value(full: bool) -> history.Head {
  history.Head(
    identity: rep(161, 32),
    epoch: 258,
    attempt: rep(162, 16),
    end: 772,
    digest: rep(163, 32),
    checkpoint: if full {
      Some(descriptor_value())
    } else {
      None()
    },
    locator: b"lo",
    retain: b"re",
    origin: if full {
      Some((rep(164, 32), 1286u64))
    } else {
      None()
    }
  )
}

// Both directions for one group vector.
fn group_vector(wire: Bytes, value: history.Group) -> bool {
  let decoded = match history.decode_group(wire, sha(wire)) {
    Ok(g) => g == value,
    Error(_) => false,
  }
  let (encoded, d) = history.encode_group(value)
  decoded && encoded == wire && d == sha(wire)
}

fn corrupt_group(wire: Bytes) -> bool {
  match history.decode_group(wire, sha(wire)) {
    Error(Corrupt()) => true,
    _ => false,
  }
}

// A group of these commits with the first header and the two definitions.
fn plain(commits: List[Bytes]) -> Bytes {
  wire_group(V_FIRST, V_EPOCH, b"\x01\x00\x00\x00", commits, wire_defs())
}

// Groups that break one stated rule each, under their own digests, each with
// a twin that differs only in that rule and decodes.
fn malformed_groups() -> List[(Bytes, Bytes)] {
  let defs = wire_defs()
  let four = b"\x04\x00\x00\x00"
  let one = b"\x01\x00\x00\x00"
  [
    // A definition index out of range.
    (
      wire_group(V_FIRST, V_EPOCH, four, [wire_call(b"\x02\x00\x00\x00", V_WRITES), V_CALL2, wire_run(), V_LIBRARY], defs),
      v1_wire()
    ),
    // A write op out of range.
    (
      plain([wire_call(one, b"\x01\x00\x00\x00\x03\x02\x00\x00\x00k1")]),
      plain([wire_call(one, b"\x01\x00\x00\x00\x02\x02\x00\x00\x00k1")])
    ),
    // Keys out of order, and a key twice.
    (
      plain([wire_call(one, b"\x02\x00\x00\x00\x02\x02\x00\x00\x00k2\x01\x02\x00\x00\x00k1\x02\x00\x00\x00v1")]),
      plain([wire_call(one, V_WRITES)])
    ),
    (
      plain([wire_call(one, b"\x02\x00\x00\x00\x01\x02\x00\x00\x00k1\x02\x00\x00\x00v1\x02\x02\x00\x00\x00k1")]),
      plain([wire_call(one, V_WRITES)])
    ),
    // Bytes after the definition table.
    (cat([v1_wire(), b"\x00"]), v1_wire()),
    // No commit, and a count above the commits there are.
    (wire_group(V_FIRST, V_EPOCH, b"\x00\x00\x00\x00", [], defs), plain([V_LIBRARY])),
    (
      wire_group(V_FIRST, V_EPOCH, b"\x05\x00\x00\x00", [wire_call(one, V_WRITES), V_CALL2, wire_run(), V_LIBRARY], defs),
      wire_group(V_FIRST, V_EPOCH, four, [wire_call(one, V_WRITES), V_CALL2, wire_run(), V_LIBRARY], defs)
    ),
    // A stream byte, a commit kind, an engine op and a stream op out of range.
    (
      plain([b"\x01\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x01\x00\x00\x00o\x00\x00\x00\x00"]),
      plain([V_CALL2])
    ),
    (
      plain([cat([b"\x04", rep(65, 16), b"\x00\x00\x00\x00\x00\x00\x00\x00"])]),
      plain([cat([b"\x03", rep(65, 16), b"\x00\x00\x00\x00\x00\x00\x00\x00"])])
    ),
    (plain([b"\x02\x08\x0c\x00\x00\x00\x02\x00\x00\x00nm\x02\x00\x00\x00pl\x00\x00\x00\x00"]), plain([V_LIBRARY])),
    (
      plain([cat([b"\x02\x06\x21\x00\x00\x00\x03", rep(113, 32), b"\x00\x00\x00\x00"])]),
      plain([cat([b"\x02\x06\x21\x00\x00\x00\x01", rep(113, 32), b"\x00\x00\x00\x00"])])
    ),
    // Retain pins not sorted by name.
    (
      plain(
        [
          b"\x02\x04\x2b\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x02\x00\x00\x00bc\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00a\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
        ]
      ),
      plain(
        [
          b"\x02\x04\x2b\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x01\x00\x00\x00a\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00bc\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
        ]
      )
    ),
    // Version 1 that is not a claim; a claim not alone in its group; a claim
    // whose epoch is not its group's.
    (
      wire_group(b"\x01\x00\x00\x00\x00\x00\x00\x00", V_EPOCH, one, [V_LIBRARY], defs),
      wire_group(b"\x02\x00\x00\x00\x00\x00\x00\x00", V_EPOCH, one, [V_LIBRARY], defs)
    ),
    (
      cat([bytes.slice(v3_wire(), 0, 56), b"\x02\x00\x00\x00", bytes.slice(v3_wire(), 60, 126), V_LIBRARY, b"\x00\x00\x00\x00"]),
      v3_wire()
    ),
    (cat([bytes.slice(v3_wire(), 0, 66), b"\x02", bytes.slice(v3_wire(), 67, bytes.len(v3_wire()))]), v3_wire())
  ]
}

fn decodes(wire: Bytes) -> bool {
  match history.decode_group(wire, sha(wire)) {
    Ok(_) => true,
    Error(_) => false,
  }
}

// The checkpoint of a("a" = 90 x 0x78) and ("b" = the same) under bounds of
// 112 bytes, one entry's node: two leaves under one index root.
fn leaf(key: Bytes, extra: Bytes) -> Bytes {
  cat([b"HSNODE01\x00\x01\x00\x00\x00", b"\x01\x00\x00\x00", copy key, b"\x5a\x00\x00\x00", rep(120, 90), copy extra])
}

fn index(first: Bytes, a: Bytes, na: Bytes, second: Bytes, b: Bytes) -> Bytes {
  cat(
    [
      b"HSNODE01\x01\x02\x00\x00\x00",
      b"\x01\x00\x00\x00",
      copy first,
      sha(a),
      copy na,
      b"\x01\x00\x00\x00",
      copy second,
      sha(b),
      b"\x01\x00\x00\x00\x00\x00\x00\x00"
    ]
  )
}

fn tree_descriptor(root: Bytes, entries: u64) -> history.Descriptor {
  history.Descriptor(version: 7, digest: rep(1, 32), root: sha(root), height: 2, entries: entries, bytes: 182)
}

// Reads a two-level checkpoint from its root and leaves.
fn read_two(d: history.Descriptor, root: Bytes, leaves: List[Bytes]) -> Result[List[(Bytes, Bytes)], history.Fault] {
  match history.check_level([history.root_expect(d)], [copy root])? {
    Next(below) => match history.check_level(below, leaves)? {
      Leaves(entries) => Ok(take entries),
      Next(_) => Error(Corrupt()),
    },
    Leaves(_) => Error(Corrupt()),
  }
}

fn corrupt_read(r: Result[List[(Bytes, Bytes)], history.Fault]) -> bool {
  match r {
    Error(Corrupt()) => true,
    _ => false,
  }
}

fn node_vectors() -> (bool, bool) {
  let la = leaf(b"a", b"")
  let lb = leaf(b"b", b"")
  let one = b"\x01\x00\x00\x00\x00\x00\x00\x00"
  let root = index(b"a", la, one, b"b", lb)
  let state = [(b"a", rep(120, 90)), (b"b", rep(120, 90))]
  // Encoding: the tree is exactly these three nodes.
  let tree = history.build_tree(state, history.Bounds(node_min: 112, node_mean: 112, node_max: 112))
  let mut encoded = tree.root == sha(root) && tree.height == 2 && list.len(tree.nodes) == 3
  for (d, data) in tree.nodes {
    encoded = encoded && d == sha(data) && (data == la || data == lb || data == root)
  }
  // Decoding: the root names each leaf's digest, first key, bound and count.
  let decoded = match history.check_level([history.root_expect(tree_descriptor(root, 2))], [copy root]) {
    Ok(Next(below)) => below == [
      history.Expect(digest: sha(la), level: 0, first: Some(b"a"), below: Some(b"b"), entries: 1),
      history.Expect(digest: sha(lb), level: 0, first: Some(b"b"), below: None(), entries: 1)
    ],
    _ => false,
  } && match read_two(tree_descriptor(root, 2), root, [copy la, copy lb]) {
    Ok(entries) => entries == state,
    Error(_) => false,
  }
  // Damage under the digests that name it: a leaf cut short, a leaf with a
  // byte after its entry, children out of order, a leaf whose key is not the
  // first its parent names, a leaf holding a key at its right neighbour's
  // bound, a count its leaf does not hold, and a child of no entries.
  let cut = bytes.slice(la, 0, bytes.len(la) - 1)
  let long = leaf(b"a", b"\x00")
  let a0 = leaf(b"a0", b"")
  let c = leaf(b"c", b"")
  let zero = b"\x00\x00\x00\x00\x00\x00\x00\x00"
  let two = b"\x02\x00\x00\x00\x00\x00\x00\x00"
  let damage = [
    corrupt_read(read_two(tree_descriptor(index(b"a", cut, one, b"b", lb), 2), index(b"a", cut, one, b"b", lb), [copy cut, copy lb])),
    corrupt_read(read_two(tree_descriptor(index(b"a", long, one, b"b", lb), 2), index(b"a", long, one, b"b", lb), [copy long, copy lb])),
    corrupt_read(read_two(tree_descriptor(index(b"b", lb, one, b"a", la), 2), index(b"b", lb, one, b"a", la), [copy lb, copy la])),
    corrupt_read(read_two(tree_descriptor(index(b"a", a0, one, b"b", lb), 2), index(b"a", a0, one, b"b", lb), [copy a0, copy lb])),
    corrupt_read(read_two(tree_descriptor(index(b"a", c, one, b"b", lb), 2), index(b"a", c, one, b"b", lb), [copy c, copy lb])),
    corrupt_read(read_two(tree_descriptor(index(b"a", la, two, b"b", lb), 3), index(b"a", la, two, b"b", lb), [copy la, copy lb])),
    corrupt_read(read_two(tree_descriptor(index(b"a", la, zero, b"b", lb), 1), index(b"a", la, zero, b"b", lb), [copy la, copy lb])),
  ]
  let mut all_damage = true
  for d in damage {
    all_damage = all_damage && d
  }
  (encoded && decoded, all_damage)
}

// Law 6 on the hand-written vectors.
fn wire_vectors(stdout: Stdout) -> () {
  let claim_ok = group_vector(v3_wire(), v3_value()) && match history.claim_group(history.origin_tip(), rep(145, 16), rep(146, 32)) {
    (w, d) => w == v3_wire() && d == sha(v3_wire()),
  }
  report(stdout, "wire vectors: calls, runs and definitions", group_vector(v1_wire(), v1_value()))
  report(stdout, "wire vectors: engine commits", group_vector(v2_wire(), v2_value()))
  report(stdout, "wire vectors: the first claim", claim_ok)
  let mut heads = true
  for full in [true, false] {
    heads = heads && history.encode_head(head_value(full)) == wire_head(full) && match history.decode_head(wire_head(full)) {
      Ok(h) => h == head_value(full),
      Error(_) => false,
    }
  }
  report(stdout, "wire vectors: head records", heads)
  let mut malformed = true
  for (bad, twin) in malformed_groups() {
    malformed = malformed && corrupt_group(bad) && decodes(twin)
  }
  report(stdout, "wire vectors: each malformed group refused, its twin read", malformed)
  let (nodes, damage) = node_vectors()
  report(stdout, "wire vectors: checkpoint nodes", nodes)
  report(stdout, "wire vectors: damaged checkpoint nodes refused", damage)
}

fn report(stdout: Stdout, name: String, ok: bool) -> () {
  let _ = out.print(stdout, if ok {
    f"ok {name}\n"
  } else {
    f"FAIL {name}\n"
  })
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let mut g = prng.seed(681)

  // Laws 1-3 on random groups.
  let mut round = true
  let mut refused = true
  let mut canonical = true
  // Every group round trips; every flip and truncation of the first 12 is
  // classified, which keeps the run within the launch timeout.
  for i in 0u64..300 {
    let grp = random_group(mut g)
    let (data, d) = history.encode_group(grp)
    let (r, f, c) = group_laws(data, d, i < 12)
    round = round && r
    refused = refused && f
    canonical = canonical && c
  }
  // The claim and genesis groups that start every history.
  let identity = fixed(mut g, 32)
  let (claim, claim_digest) = history.claim_group(history.origin_tip(), fixed(mut g, 16), identity)
  let (r1, f1, c1) = group_laws(claim, claim_digest, true)
  let (genesis, genesis_digest) = history.encode_group(genesis_group(mut g, claim_digest))
  let (r2, f2, k2) = group_laws(genesis, genesis_digest, true)
  report(stdout, "group round trip", round && r1 && r2)
  report(stdout, "group flips and truncations classified", refused && f1 && f2)
  report(stdout, "group decoding canonical", canonical && c1 && k2)

  // Law 2 on head records.
  let mut head_round = true
  let mut head_refused = true
  for i in 0u64..100 {
    let h = random_head(mut g)
    let data = history.encode_head(h)
    match history.decode_head(data) {
      Ok(back) => {
        head_round = head_round && history.encode_head(back) == data
      },
      Error(_) => {
        head_round = false
      },
    }
    let damaged: u64 = if i < 10 {
      bytes.len(data)
    } else {
      0
    }
    for bit in 0u64..damaged * 8 {
      let bad = flip(data, bit)
      if !classified(history.decode_head(bad), bad, Some(bit / 8)) {
        head_refused = false
      }
    }
    for cut in 0u64..damaged {
      let short = bytes.slice(data, 0, cut)
      if !classified(history.decode_head(short), short, None()) {
        head_refused = false
      }
    }
  }
  report(stdout, "head round trip", head_round)
  report(stdout, "head flips and truncations classified", head_refused)

  // Law 4 on random states under small bounds.
  let bounds = history.Bounds(node_min: 64, node_mean: 256, node_max: 512)
  let mut cuts = true
  let mut reads = true
  let mut equal = true
  for round_index in 0u64..60 {
    // The first state is small: every bit of its tree is flipped.
    let n: u64 = if round_index == 0 {
      40
    } else {
      prng.u64(mut g) % 400
    }
    let state = random_state(mut g, n)
    let tree = history.build_tree(state, bounds)
    let mut total: u64 = 0
    for (k, v) in state {
      total += bytes.len(k) + bytes.len(v)
    }
    let d = history.descriptor(tree, 7, fixed(mut g, 32))
    match read_tree(tree, d) {
      Ok((counts, entries)) => {
        cuts = cuts && counts == reference_leaves(state, bounds)
        reads = reads && entries == state && tree.entries == n && tree.bytes == total
      },
      Error(_) => {
        reads = false
      },
    }
    let again = history.build_tree(state, bounds)
    equal = equal && again.root == tree.root && list.len(again.nodes) == list.len(tree.nodes)
    // Every bit flip of every node of the small tree is classified.
    if round_index == 0 {
      for i in 0u64..list.len(tree.nodes) {
        let (nd, data) = copy tree.nodes[i]
        for bit in 0u64..bytes.len(data) * 8 {
          let mut changed = copy tree
          let bad = flip(data, bit)
          changed.nodes[i] = (copy nd, copy bad)
          if !classified(read_tree(changed, d), bad, Some(bit / 8)) {
            reads = false
          }
        }
      }
    }
  }
  // An empty state is one empty leaf.
  let empty: List[(Bytes, Bytes)] = []
  let none = history.build_tree(empty, bounds)
  let none_d = history.descriptor(none, 2, fixed(mut g, 32))
  reads = reads && list.len(none.nodes) == 1 && none.height == 1 && match read_tree(none, none_d) {
    Ok((counts, entries)) => list.len(entries) == 0 && counts == [0u64],
    Error(_) => false,
  }
  report(stdout, "leaf cuts match the reference", cuts)
  report(stdout, "trees read back and classify damage", reads)
  report(stdout, "equal states give equal roots", equal)

  // Law 5: a chain of claim, genesis and later groups, and its breaks.
  let mut chain = true
  let Ok(claim_group) = history.decode_group(claim, claim_digest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  let Ok(tip1) = history.follow(history.origin_tip(), claim_group, claim_digest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && tip1.epoch == 1 && tip1.last == 1 && tip1.identity == identity
  let Ok(gen) = history.decode_group(genesis, genesis_digest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  let Ok(tip2) = history.follow(tip1, gen, genesis_digest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && tip2.last == 2 && tip2.epoch == 1
  // A later claim raises the epoch; another identity or a skipped epoch is
  // refused, as is a group that changes the epoch without a claim, a wrong
  // prev or a gap in versions.
  let (c2data, c2digest) = history.claim_group(tip2, fixed(mut g, 16), identity)
  let Ok(claim2) = history.decode_group(c2data, c2digest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && match history.follow(tip2, claim2, c2digest) {
    Ok(t) => t.epoch == 2 && t.last == 3,
    Error(()) => false,
  }
  let (other, other_digest) = history.claim_group(tip2, fixed(mut g, 16), fixed(mut g, 32))
  let Ok(o) = history.decode_group(other, other_digest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && is_error(history.follow(tip2, o, other_digest))
  let mut skipped = copy tip2
  skipped.epoch = 0
  chain = chain && is_error(history.follow(skipped, claim2, c2digest))
  let mut later = random_group(mut g)
  later.prev = copy tip2.digest
  later.first = 3
  later.epoch = 1
  let (ld, ldd) = history.encode_group(later)
  let Ok(lg) = history.decode_group(ld, ldd) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && !is_error(history.follow(tip2, lg, ldd))
  let mut raised = copy later
  raised.epoch = 2
  let (rd, rdd) = history.encode_group(raised)
  let Ok(rg) = history.decode_group(rd, rdd) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && is_error(history.follow(tip2, rg, rdd))
  let mut gap = copy later
  gap.first = 4
  let (gd, gdd) = history.encode_group(gap)
  let Ok(gg) = history.decode_group(gd, gdd) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && is_error(history.follow(tip2, gg, gdd))
  chain = chain && is_error(history.follow(tip1, lg, ldd))
  // Nothing but a claim precedes the first claim: a genesis at version 2
  // after no claim does not follow the origin.
  chain = chain && is_error(history.follow(history.origin_tip(), gen, genesis_digest))
  // A history begins with claims and then its one Genesis. A creation cut before
  // its Genesis leaves a claim that a second claim and then the Genesis follow;
  // a commit other than the Genesis after only claims does not follow, nor does
  // a second Genesis.
  let (cbdata, cbdigest) = history.claim_group(tip1, fixed(mut g, 16), identity)
  let Ok(cb) = history.decode_group(cbdata, cbdigest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  let Ok(tipc) = history.follow(tip1, cb, cbdigest) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  let mut late = copy gen
  late.prev = copy tipc.digest
  late.first = 3
  late.epoch = 2
  let (lgen, lgend) = history.encode_group(late)
  chain = chain && match history.decode_group(lgen, lgend) {
    Ok(lg3) => match history.follow(tipc, lg3, lgend) {
      Ok(t) => t.last == 3 && t.epoch == 2,
      Error(()) => false,
    },
    Error(_) => false,
  }
  let mut orphan = copy later
  orphan.prev = copy tipc.digest
  orphan.epoch = 2
  let (od, odd) = history.encode_group(orphan)
  let Ok(og) = history.decode_group(od, odd) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && is_error(history.follow(tipc, og, odd))
  let mut again = copy gen
  again.prev = copy tip2.digest
  again.first = 3
  let (ad, add) = history.encode_group(again)
  let Ok(ag) = history.decode_group(ad, add) else {
    report(stdout, "chain rules", false)
    return Ok(())
  }
  chain = chain && is_error(history.follow(tip2, ag, add))
  report(stdout, "chain rules", chain)
  wire_vectors(stdout)
  Ok(())
}

fn is_error(r: Result[history.Tip, ()]) -> bool {
  match r {
    Ok(_) => false,
    Error(()) => true,
  }
}

// L-IX, catch-up (STORE-SPEC §3.5a "Catch-up", "The kept import"). A
// preparation declares its indexes at an export and ships PREPARED once; OLD
// validates it and keeps it under the import pin while it still serves. Then
// the child follows OLD round by round: each round OLD writes, maybe cuts,
// advances the lease, and the child replays the copied tail, brings its new
// index ranges to the new head and ships only the entries that changed
// (ROUND), which OLD applies to the kept import. After the install, and again
// after reopening from disk, OLD holds exactly the entries a next_value
// extraction of its final rows gives: lix_expected for by_v, and one
// (value, row) entry per row for the Unique by_id, and no import pin. The
// model is the law's own copy of OLD's rows. Round codes: 's' a few
// single-row writes, 'c' the same with two cuts between them (the tail crosses
// two rotations, and the second cut used to delete it), 'w' one commit that
// swaps two rows' values (a Unique key changes owner within the tail), 'b' a
// rewrite of every row, a tail far over a hundredth of the store, which renews
// the export, and the child ships a fresh PREPARED that replaces the kept one,
// 'u' (with OLD's by_v left Backfilling near its end at the export) two build
// chunks of OLD's upkeep under the lease with a write between them to a row
// the first chunk indexed: the round ships the chunks as STEPS, the third
// 'u' finishes OLD's build, and after every round the child's copy of OLD is
// OLD at the cut, catalog and by_v's entries alike. In the untouched case
// 'r' is one chunk of a rebuild OLD began under the lease: NEW leaves by_v
// unchanged, so every round carries the moved record through follow_moves.
//
// AP21 at the install reads only the packs the install cut writes (C-7's
// settled packs), and every cut under the export lease reads back the packs it
// wrote before it publishes. The checkpoint case damages the first pack a
// checkpoint after the export copy writes (the first payload byte of its frame
// at 72), after the pack is written and before the cut's check: the checkpoint
// refuses with Checksum at that frame (disk_frame_bytes: the frame's check no
// longer matches its bytes), OLD keeps serving, the next checkpoint rewrites
// the pack, and the deploy follows and installs as in the other cases. The
// settled case flips the last payload byte of a leaf the kept import reaches
// in a pack after its one read-back, before the install: the install still
// publishes, and the reopen's full AP21 refuses the store at that frame with
// Checksum (check_page_pointer: the page's xxh3 no longer matches its parent's
// pointer).
const LCU_ROWS: u64 = 4000

type LcuDamage = Undamaged | CheckpointPack | SettledLeaf

fn lcu_unique_expected(id: u32, model: List[Option[u64]]) -> Result[List[(Bytes, u64)], Error] {
    let mut pairs: List[(u64, u64)] = list.new()
    for k in 0u64 .. list.len(model) {
        if let Some(v) = model[k] {
            list.push(mut pairs, (v, k))
        }
    }
    list.sort(mut pairs, fn(a: (u64, u64), b: (u64, u64)) -> Order {
        order.compare(a.0, b.0)
    })
    let mut out: List[(Bytes, u64)] = list.new()
    for (v, k) in pairs {
        let mut logical = failure_result_from_rep(catalog.prefix(id))?
        list.put_word_be(mut logical, v)
        list.push(mut out, (take logical, k))
    }
    Ok(take out)
}

fn lcu_unique_entries(db: Db, id: u32) -> Result[List[(Bytes, u64)], Error] {
    let s = snapshot(db)
    let mut cursor = byte_cursor(s.roots.collections, Included(failure_result_from_rep(catalog.prefix(id))?), failure_result_from_rep(catalog.prefix(id + 1))?)?
    let mut out: List[(Bytes, u64)] = list.new()
    while let Some((take key, value)) = failure_result_from_rep(catalog.next_bytes(mut cursor))? {
        let owner: u64 = list.word_be(value, 4)
        list.push(mut out, (take key, owner))
    }
    Ok(take out)
}

fn lcu_public(db: Db, id: u32) -> Result[bool, Error] {
    let mut records = byte_cursor(pages.holder_heads(db.holders)[0].roots.catalog, Included(failure_result_from_rep(catalog.index_prefix(0))?), failure_result_from_rep(catalog.index_prefix(4294967295u32))?)?
    while let Some((_, raw)) = failure_result_from_rep(catalog.next_bytes(mut records))? {
        let record = decode_catalog(raw)?
        if record.id == id {
            return Ok(catalog.record_public(raw))
        }
    }
    Ok(false)
}

// The release the child prepares: rows with by_v (and by_id), and other.
fn lcu_stage(source: Preparation, tasks: Tasks, unique: bool) -> Result[(StagedMigration, u32, u32), Error] waits {
    let mut d = declare_export(source, tasks, None)?
    let (by_v, by_id) = lcu_schema(mut d, unique)?
    let staged = finish_export_declaration(source, take d)?
    Ok((take staged, by_v, by_id))
}

fn lcu_schema(mut d: Declare, unique: bool) -> Result[(u32, u32), Error] {
    let key = std.codec.key_u64()
    let mut rows = declare_table(mut d, "rows", key, std.codec.of_u64())?
    let by_v = index(mut d, mut rows, "by_v", Many, code.describe(lix_keys), key)?
    let by_id = if unique {
        let ix = index(mut d, mut rows, "by_id", Unique, code.describe(backfill_keys), key)?
        ix.id
    } else {
        0u32
    }
    let _ = finish(mut d, take rows)?
    let other = declare_table(mut d, "other", key, std.codec.of_u64())?
    let _ = finish(mut d, take other)?
    Ok((by_v.id, by_id))
}

// The untouched release: rows is only redeclared, while by_v stays an
// unchanged index of the small `other` table. No range of by_v is shipped.
fn lcu_stage_untouched(source: Preparation, tasks: Tasks) -> Result[(StagedMigration, u32), Error] waits {
    let key = std.codec.key_u64()
    let mut d = declare_export(source, tasks, None)?
    let rows = declare_table(mut d, "rows", key, std.codec.of_u64())?
    let _ = finish(mut d, take rows)?
    let mut other = declare_table(mut d, "other", key, std.codec.of_u64())?
    let by_v = index(mut d, mut other, "by_v", Many, code.describe(lix_keys), key)?
    let _ = finish(mut d, take other)?
    let staged = finish_export_declaration(source, take d)?
    Ok((take staged, by_v.id))
}

fn lcu_stage_case(source: Preparation, tasks: Tasks, unique: bool, untouched: bool) -> Result[(StagedMigration, u32, u32), Error] waits {
    if untouched {
        let (take staged, by_v) = lcu_stage_untouched(source, tasks)?
        return Ok((take staged, by_v, 0u32))
    }
    lcu_stage(source, tasks, unique)
}

// The untouched index's twelve rows. This model never changes: the rounds
// write rows, not other, so the index oracle stays independent of them.
fn lcu_untouched_model() -> List[Option[u64]] {
    let mut model: List[Option[u64]] = list.new()
    for k in 0u64 .. 12 {
        list.push(mut model, Some(3 * k))
    }
    take model
}

fn lcu_swap(mut db: Db, t: Table[u64, u64], a: u64, b: u64, mut model: List[Option[u64]]) -> Result[(), Error] waits {
    let (Some(va), Some(vb)) = (model[a], model[b]) else {
        return Ok(())
    }
    let ran = run(mut db, None, (copy_env(t), a, b, va, vb), fn(mut tx: Tx, input: (Table[u64, u64], u64, u64, u64, u64)) -> Result[(), Error] {
        put(mut tx, input.0, input.1, input.4)?
        put(mut tx, input.0, input.2, input.3)
    })?
    let Committed(_) = take ran else {
        return Error(MigrationFault)
    }
    model[a] = Some(vb)
    model[b] = Some(va)
    Ok(())
}

// One round of OLD's writes. Fresh values are distinct, so only `duplicate`
// makes two rows share a value.
fn lcu_round(mut db: Db, t: Table[u64, u64], code_byte: u8, seed: u64, mut next_value: u64, mut model: List[Option[u64]]) -> Result[(), Error] waits {
    let mut state = seed
    if code_byte == 98u8 {
        let ran = run(mut db, None, (copy_env(t), next_value), fn(mut tx: Tx, input: (Table[u64, u64], u64)) -> Result[(), Error] {
            for k in 0u64 .. LCU_ROWS {
                put(mut tx, input.0, k, input.1 + k)?
            }
            Ok(())
        })?
        let Committed(_) = take ran else {
            return Error(MigrationFault)
        }
        for k in 0u64 .. LCU_ROWS {
            model[k] = Some(next_value + k)
        }
        next_value += LCU_ROWS
        return Ok(())
    }
    if code_byte == 119u8 {
        state = lix_next(state)
        let a = state % LCU_ROWS
        state = lix_next(state)
        let b = (a + 1 + state % (LCU_ROWS - 1)) % LCU_ROWS
        return lcu_swap(mut db, t, a, b, mut model)
    }
    let round_writes = lcu_writes(state, mut next_value, list.len(model))
    for i in 0u64 .. list.len(round_writes) {
        if code_byte == 99u8 && i > 0 {
            let _ = checkpoint(mut db)?
        }
        let (k, v) = round_writes[i]
        lix_write(mut db, t, k, v)?
        model[k] = v
    }
    Ok(())
}

// The single writes of an 's' or 'c' round: 3 to 6 rows below `rows`, a
// quarter of them deletes, the rest fresh values.
fn lcu_writes(seed: u64, mut next_value: u64, rows: u64) -> List[(u64, Option[u64])] {
    let mut state = lix_next(seed)
    let writes = 3 + state % 4
    let mut round_writes: List[(u64, Option[u64])] = list.new()
    for _ in 0u64 .. writes {
        state = lix_next(state)
        let k = state % rows
        state = lix_next(state)
        let v: Option[u64] = if state % 4 == 0 {
            None
        } else {
            next_value += 1
            Some(next_value)
        }
        list.push(mut round_writes, (k, v))
    }
    take round_writes
}

fn lcu_target() -> PreparedTarget {
    PreparedTarget(describe: install_fixture_bytes(32u64, 66u8), release: install_fixture_bytes(32u64, 67u8), digest: install_fixture_bytes(32u64, 68u8), resident_limit: 2097152u64, pack_bytes: 1048576u64, checkpoint_bytes: 4096u64, journal_limit: 16781392u64, limits: None)
}

// The child ships PREPARED once; OLD validates it and keeps it.
fn lcu_ship(mut db: Db, mut source: Preparation, staged: StagedMigration, d: Dir) -> Result[Inline[u8, 32], DeployError] waits {
    write_prepared(mut source, staged, d, lcu_target())?
    let checked = validate_prepared(d)?
    let work = reserve_import(mut db, take checked)?
    let assembled = import_trees(take work)?
    let digest = imported_digest(assembled)
    keep_import(mut db, take assembled)?
    Ok(digest)
}

// One delta round: OLD's tail to the child, the child's ROUND back to OLD.
fn lcu_follow(mut db: Db, scratch: Dir, d: Dir, attempt: Bytes, mut source: Preparation, mut staged: StagedMigration) -> Result[bool, DeployError] waits {
    match advance_export(mut db, scratch, attempt)? {
        Tail(take tail) => {
            let _ = copy_export_tail(take tail, d)?
            let _ = catch_up_export(d, mut source, mut staged)?
            let checked = validate_round(d)?
            let _ = apply_round(mut db, take checked)?
            Ok(true)
        },
        Full(_) => Ok(false),
    }
}

fn lcu_no_import_pin(db: Db) -> bool {
    !std.list.any(pages.holder_pins(db.holders), fn(held: pages.Pin) -> bool {
        held.owner == ImportPin
    })
}

// The rows by_v serves, in index order, from the law's row model. A row
// appears once for each distinct extracted key, as a Many index does.
fn lcu_indexed_expected(model: List[Option[u64]]) -> Result[List[(u64, u64)], Error] {
    let mut out: List[(u64, u64)] = list.new()
    for j in 0u64 .. 7 {
        for k in 0u64 .. list.len(model) {
            let Some(v) = model[k] else {
                continue
            }
            let keys = failure_result_from_rep(types.capacity(lix_keys(k, v)))?
            if keys[0] == j || keys[1] == j {
                list.push(mut out, (k, v))
            }
        }
    }
    Ok(take out)
}

// Read through the index, not its raw entries, and compare the collection's
// published row count and charge with the model. A by_v entry key is the
// four-byte collection prefix plus two u64 keys (20 bytes, charged as 24),
// and its unit payload is empty, so STORE-SPEC's row charge is 62 + 24 = 86.
fn lcu_untouched_check(db: Db, ix: Index[u64, u64, u64, ()], by_v: u32) -> Result[(), DeployError] waits {
    let expected = deploy_result(lcu_indexed_expected(lcu_untouched_model()))?
    let read_handle = deploy_result(reader(db, 0u64))?
    let mut rows = deploy_result(find(read_handle, snapshot(db), ix, Unbounded, Unbounded))?
    let mut found: List[(u64, u64)] = list.new()
    while let Some((k, v)) = deploy_result(next(read_handle, mut rows))? {
        list.push(mut found, (k, v))
    }
    if found != expected {
        fail("L-IX catch-up: a query through the followed index differs from the model")
    }
    let catalog = deploy_result(catalog_entries(snapshot(db)))?
    let expected_charge = 86 * list.len(expected)
    for item in catalog {
        if item.id == by_v {
            if item.rows != list.len(expected) || item.charge != expected_charge {
                fail("L-IX catch-up: the followed index's rows or charge differ from the model")
            }
            return Ok(())
        }
    }
    fail("L-IX catch-up: the followed index is missing from the catalog")
}

fn lcu_check(db: Db, model: List[Option[u64]], by_v: u32, by_id: u32, unique: bool) -> Result[(), DeployError] {
    if !deploy_result(lcu_public(db, by_v))? || deploy_result(lix_entries(db, by_v))? != deploy_result(lix_expected(by_v, model))? {
        fail("L-IX catch-up: by_v differs from a next_value extraction of OLD's rows")
    }
    if unique && (!deploy_result(lcu_public(db, by_id))? || deploy_result(lcu_unique_entries(db, by_id))? != deploy_result(lcu_unique_expected(by_id, model))?) {
        fail("L-IX catch-up: by_id differs from a next_value extraction of OLD's rows")
    }
    if !lcu_no_import_pin(db) {
        fail("L-IX catch-up: the install left the import pin")
    }
    Ok(())
}

// A leaf the import pin reaches, by the published record map: from the pin's
// collection-map root, follow each page's last page child until a page has
// none.
fn lcu_import_leaf(db: Db) -> Result[std.page.PagePtr, DeployError] {
    let mut stamp = 0u64
    for held in pages.holder_pins(db.holders) {
        if held.owner == ImportPin {
            stamp = pages.tree_stamp(held.roots.collections)
        }
    }
    if stamp == 0 {
        fail("L-IX catch-up: the kept import holds a pin")
    }
    let frames = manifest.pack_locations(disk_state(db).packs).frames
    loop {
        let Some(record) = manifest.disk_index_get(frames, stamp) else {
            fail("L-IX catch-up: the import pin's pages are located")
        }
        let mut deeper = 0u64
        for child in record.outgoing {
            if let Some(kid) = manifest.disk_index_get(frames, child) {
                if kid.class == 0 {
                    deeper = child
                }
            }
        }
        if deeper == 0 {
            return Ok(record.place)
        }
        stamp = deeper
    }
}

// Row 3992 + 4 * n is the first row the n-th 'u' round's first chunk builds:
// the case built 3992 rows before the first round (3990 before the export,
// two while the child prepares), and each round builds four.
fn lcu_build_round(mut db: Db, t: Table[u64, u64], n: u64, mut next_value: u64, mut model: List[Option[u64]]) -> Result[(), Error] waits {
    let _ = index_build_step(mut db, 2)?
    next_value += 1
    let k = 3992 + 4 * n
    lix_write(mut db, t, k, Some(next_value))?
    model[k] = Some(next_value)
    let _ = index_build_step(mut db, 2)?
    Ok(())
}

// The child's copy of OLD after a round is OLD at the round's cut.
fn lcu_mirrors(db: Db, source: Preparation, by_v: u32) -> Result[(), DeployError] {
    if list.len(deploy_result(failure_result_from_rep(transfer.catalog_changes(pages.holder_heads(source.db.holders)[0].roots, pages.holder_heads(db.holders)[0].roots)))?) != 0 {
        fail("L-IX catch-up: the child's catalog is not OLD's at the cut")
    }
    if deploy_result(lix_entries(source.db, by_v))? != deploy_result(lix_entries(db, by_v))? {
        fail("L-IX catch-up: the child's by_v entries are not OLD's at the cut")
    }
    Ok(())
}

fn lcu_case(d: Dir, c: Clock, r: Random, tasks: Tasks, seed: u64, rounds: String, unique: bool, backfilling: bool, duplicate: bool, untouched: bool, damage: LcuDamage) -> Result[(), DeployError] waits {
    let building = std.list.any(string.as_bytes(rounds), fn(b: u8) -> bool {
        b == 117u8 || b == 114u8
    })
    let directory = disk_test_directory(d)
    let scratch = disk_test_directory(d)
    let options = disk_crash_options("install")
    let mut db = deploy_result(open(tasks, directory, c, r, options))?
    let mut staging = deploy_result(install_old(db))?
    let description = install_fixture_bytes(32u64, 65u8)
    deploy_result(stage_activation(mut staging, 1u64, None, description, std.codec.of_bytes(), description))?
    deploy_result(install_activation(mut db, take staging))?
    let key = std.codec.key_u64()
    let t = deploy_result(table(mut db, "rows", key, std.codec.of_u64()))?
    let mut model: List[Option[u64]] = list.new()
    let filled = deploy_result(run(mut db, None, copy_env(t), fn(mut tx: Tx, rows_table: Table[u64, u64]) -> Result[(), Error] {
        for k in 0u64 .. LCU_ROWS {
            put(mut tx, rows_table, k, 3 * k)?
        }
        Ok(())
    }))?
    let Committed(_) = take filled else {
        return Error(Store(MigrationFault))
    }
    for k in 0u64 .. LCU_ROWS + 16 {
        list.push(mut model, if k < LCU_ROWS {
            Some(3 * k)
        } else {
            None
        })
    }
    let mut moved_ix: Option[Index[u64, u64, u64, ()]] = None
    if backfilling || untouched {
        // OLD's own by_v. The backfilling case leaves rows's index
        // Backfilling part way, so the child resumes it under the same id and
        // ships the whole range. The untouched case keeps a small Public index
        // on other; rows still gives the store enough resident bytes for a
        // small catalog move to catch up rather than renew.
        if untouched {
            let other_live = deploy_result(table(mut db, "other", key, std.codec.of_u64()))?
            let filled_other = deploy_result(run(mut db, None, copy_env(other_live), fn(mut tx: Tx, other_table: Table[u64, u64]) -> Result[(), Error] {
                for k in 0u64 .. 12 {
                    put(mut tx, other_table, k, 3 * k)?
                }
                Ok(())
            }))?
            let Committed(_) = take filled_other else {
                return Error(Store(MigrationFault))
            }
        }
        let mut declaration = deploy_result(declare(db, Migrate))?
        let mut rows_decl = deploy_result(declare_table(mut declaration, "rows", key, std.codec.of_u64()))?
        if backfilling {
            let ix = deploy_result(index(mut declaration, mut rows_decl, "by_v", Many, code.describe(lix_keys), key))?
            let _ = deploy_result(finish(mut declaration, take rows_decl))?
            let other = deploy_result(declare_table(mut declaration, "other", key, std.codec.of_u64()))?
            let _ = deploy_result(finish(mut declaration, take other))?
            let _ = deploy_result(seal(mut db, take declaration))?
            deploy_result(rebuild_index(mut db, ix))?
            let _ = deploy_result(index_build_step(mut db, 1000))?
            if building {
                let _ = deploy_result(index_build_step(mut db, 2990))?
            }
        } else {
            let _ = deploy_result(finish(mut declaration, take rows_decl))?
            let mut other_decl = deploy_result(declare_table(mut declaration, "other", key, std.codec.of_u64()))?
            let ix = deploy_result(index(mut declaration, mut other_decl, "by_v", Many, code.describe(lix_keys), key))?
            let _ = deploy_result(finish(mut declaration, take other_decl))?
            let _ = deploy_result(seal(mut db, take declaration))?
            moved_ix = Some(ix)
        }
    }
    let _ = deploy_result(checkpoint(mut db))?
    let attempt = install_fixture_bytes(16u64, 7u8)
    let first = begin_export_copy(mut db, scratch, deploy_result(failure_result_from_rep(types.copied(attempt)))?, 1u64)?
    let mut exported = export_copy(take first)?
    if building && !untouched {
        // A chunk while the child prepares, before PREPARED is kept: the
        // first round ships it and rebases the kept delta past it.
        let _ = deploy_result(index_build_step(mut db, 2))?
    }
    let mut source = open_export(exported.dir, c, attempt, options)?
    let (take initial_staged, by_v, by_id) = deploy_result(lcu_stage_case(source, tasks, unique, untouched))?
    let mut staged = take initial_staged
    let mut digest = lcu_ship(mut db, mut source, staged, exported.dir)?
    if untouched {
        let held_ix: Option[Index[u64, u64, u64, ()]] = clone(moved_ix)
        let Some(ix) = held_ix else {
            fail("L-IX catch-up: the untouched case declared by_v")
        }
        deploy_result(rebuild_index(mut db, ix))?
    }
    let mut state = seed
    let mut next_value = 1000000u64
    let mut built = 0u64
    for code_byte in string.as_bytes(rounds) {
        state = lix_next(state)
        if code_byte == 117u8 {
            deploy_result(lcu_build_round(mut db, t, built, mut next_value, mut model))?
            built += 1
            if built == 3 && !deploy_result(lcu_public(db, by_v))? {
                fail("L-IX catch-up: the third build round finishes OLD's by_v")
            }
        } else if code_byte == 114u8 {
            let Some(_) = deploy_result(index_build_step(mut db, 5))? else {
                fail("L-IX catch-up: an untouched round builds one chunk")
            }
            built += 1
        } else {
            deploy_result(lcu_round(mut db, t, code_byte, state, mut next_value, mut model))?
        }
        match advance_export(mut db, scratch, attempt)? {
            Tail(take tail) => {
                if code_byte == 98u8 {
                    fail("L-IX catch-up: a tail rewriting every row renews the export")
                }
                let from_segment = source.stamp.terminal
                let _ = copy_export_tail(take tail, exported.dir)?
                let _ = catch_up_export(exported.dir, mut source, mut staged)?
                // Every checkpoint is a cut that rotates the journal, so a
                // 'c' round's tail spans segments.
                if code_byte == 99u8 && source.stamp.terminal <= from_segment {
                    fail("L-IX catch-up: a checkpointed round crosses a rotation")
                }
                if building {
                    lcu_mirrors(db, source, by_v)?
                }
                let checked = validate_round(exported.dir)?
                let _ = apply_round(mut db, take checked)?
                // apply_round's cut packed the kept trees; this one packs main.
                let _ = deploy_result(checkpoint(mut db))?
            },
            Full(take job) => {
                if code_byte != 98u8 {
                    fail("L-IX catch-up: a small tail catches up")
                }
                exported = export_copy(take job)?
                source = open_export(exported.dir, c, attempt, options)?
                let (take renewed, _, _) = deploy_result(lcu_stage_case(source, tasks, unique, untouched))?
                staged = take renewed
                digest = lcu_ship(mut db, mut source, staged, exported.dir)?
            },
        }
    }
    if duplicate {
        // Row 1 takes row 2's value: by_id has two owners for one key.
        let Some(taken) = model[2] else {
            fail("L-IX catch-up: row 2 is present")
        }
        deploy_result(lix_write(mut db, t, 1, Some(taken)))?
        let Tail(take tail) = advance_export(mut db, scratch, attempt)? else {
            fail("L-IX catch-up: one write catches up")
        }
        let _ = copy_export_tail(take tail, exported.dir)?
        match catch_up_export(exported.dir, mut source, mut staged) {
            Error(Store(Conflict(name))) => if name != "by_id" {
                fail("L-IX catch-up: the conflict names by_id")
            },
            _ => fail("L-IX catch-up: a tail that repeats a Unique key fails as a full build does"),
        }
        // The aborted deploy's kept import goes with its lease; the next cut
        // drops its pin, and a reopen finds none.
        release_export(mut db, attempt)
        let _ = deploy_result(checkpoint(mut db))?
        if !lcu_no_import_pin(db) {
            fail("L-IX catch-up: a cut after the abort kept the import pin")
        }
        deploy_result(close(take db))?
        let reopened = deploy_result(open(tasks, directory, c, r, options))?
        if !lcu_no_import_pin(reopened) {
            fail("L-IX catch-up: a reopen after the abort found the import pin")
        }
        return deploy_result(close(take reopened))
    }
    if let CheckpointPack = damage {
        state = lix_next(state)
        deploy_result(lcu_round(mut db, t, 115u8, state, mut next_value, mut model))?
        let name = deploy_result(failure_result_from_rep(manifest.paged_pack_path(manifest.pack_next(disk_state(db).packs))))?
        let refused = disk_cut_state(mut db, NoHolderChange, scoped fn(mut raw: Bytes, context: format.DiskContext, fence: u32) -> Result[(), Error] waits {
            let mut pack = failure_result_from_rep(manifest.disk_read_paged_file(directory, name, 67108864))?
            pack[88] = pack[88] ^ 1u8
            failure_result_from_rep(manifest.disk_write_synced(directory, name, pack))?
            seal_page_manifest_file(mut raw, context, fence)
        })
        match refused {
            Error(Corrupt(Fault(file: file, offset: at, why: Checksum))) if file == name && at == 72 => (),
            _ => fail("L-IX catch-up: a checkpoint under the export lease reads back the pack it wrote"),
        }
        let _ = deploy_result(checkpoint(mut db))?
        if !lcu_follow(mut db, scratch, exported.dir, attempt, mut source, mut staged)? {
            fail("L-IX catch-up: OLD keeps serving the deploy after a refused checkpoint")
        }
        let _ = deploy_result(checkpoint(mut db))?
    }
    if let SettledLeaf = damage {
        let leaf = lcu_import_leaf(db)?
        let name = deploy_result(failure_result_from_rep(manifest.paged_pack_path(leaf.pack)))?
        let mut raw = deploy_result(failure_result_from_rep(manifest.disk_read_paged_file(directory, name, 67108864)))?
        let flipped = leaf.offset + 16 + int.widen(leaf.len) - 1
        raw[flipped] = raw[flipped] ^ 1u8
        deploy_result(failure_result_from_rep(manifest.disk_write_synced(directory, name, raw)))?
        let _ = crash_apply(mut db, attempt, digest)?
        let in_place = match manifest.disk_index_get(manifest.pack_locations(disk_state(db).packs).frames, leaf.stamp) {
            Some(kept) => kept.place == leaf,
            None => false,
        }
        if !in_place {
            fail("L-IX catch-up: the install keeps the damaged leaf in place")
        }
        trust_opt_out("catchup/settled-leaf", mut db)
        deploy_result(close(take db))?
        match open(tasks, directory, c, r, options) {
            Error(Corrupt(Fault(file: file, offset: at, why: Checksum))) if file == name && at == leaf.offset => return Ok(()),
            _ => fail("L-IX catch-up: open's AP21 finds the damaged settled pack"),
        }
    }
    let _ = crash_apply(mut db, attempt, digest)?
    lcu_check(db, if untouched {
        lcu_untouched_model()
    } else {
        clone(model)
    }, by_v, by_id, unique)?
    if untouched {
        if built != 3 || !deploy_result(lcu_public(db, by_v))? {
            fail("L-IX catch-up: three untouched rounds finish OLD's by_v")
        }
        let held_ix: Option[Index[u64, u64, u64, ()]] = clone(moved_ix)
        let Some(ix) = held_ix else {
            fail("L-IX catch-up: the untouched case declared by_v")
        }
        lcu_untouched_check(db, ix, by_v)?
    }
    deploy_result(close(take db))?
    let reopened = deploy_result(open(tasks, directory, c, r, options))?
    lcu_check(reopened, if untouched {
        lcu_untouched_model()
    } else {
        model
    }, by_v, by_id, unique)?
    if untouched {
        let held_ix: Option[Index[u64, u64, u64, ()]] = clone(moved_ix)
        let Some(ix) = held_ix else {
            fail("L-IX catch-up: the untouched case declared by_v")
        }
        lcu_untouched_check(reopened, ix, by_v)?
    }
    deploy_result(close(take reopened))
}

@test
fn test_index_catch_up_law(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), DeployError] waits {
    for seed in 0u64 .. 3 {
        lcu_case(d, c, r, tasks, seed * 7919 + 1, "ss", false, false, false, false, Undamaged)?
        lcu_case(d, c, r, tasks, seed * 7919 + 2, "scs", true, false, false, false, Undamaged)?
        lcu_case(d, c, r, tasks, seed * 7919 + 3, "swbs", true, false, false, false, Undamaged)?
        lcu_case(d, c, r, tasks, seed * 7919 + 4, "cs", false, true, false, false, Undamaged)?
    }
    lcu_case(d, c, r, tasks, 7, "uuus", false, true, false, false, Undamaged)?
    lcu_case(d, c, r, tasks, 8, "rrrs", false, false, false, true, Undamaged)?
    lcu_case(d, c, r, tasks, 5, "s", true, false, true, false, Undamaged)?
    lcu_case(d, c, r, tasks, 6, "sc", false, false, false, false, SettledLeaf)?
    lcu_case(d, c, r, tasks, 7, "s", true, false, false, false, CheckpointPack)
}

// The "catch-up" crash scenario (store_crash_tests.py). The write phase keeps
// a preparation's import, follows OLD through delta rounds (one with cuts)
// and installs; the crash harness cuts power at every durable mutation on
// the way. Whatever the cut, the reopened store is OLD (no by_v, no "other")
// or NEW, never a mix: NEW's by_v holds exactly a next_value extraction of
// the rows the store itself reads back, and once a cut has run, no import pin
// is left in either.
// As many rows as the law's cases, so a round's tail stays under
// resident/100 and catches up rather than renewing.
const LCU_CRASH_ROWS: u64 = LCU_ROWS

const LCU_CRASH_SEED: u64 = 11

const LCU_CRASH_FIRST: u64 = 1000000

const LCU_CRASH_ROUNDS: String = "scs"

// The install scenario's options with packs large enough that 4000 rows make
// hundreds of cuts, not thousands.
fn lcu_crash_options() -> Options {
    let mut options = disk_crash_options("install")
    options.pack_bytes = 65536
    options
}

// The rows after every round of the write phase, from the rounds' plan alone.
fn lcu_crash_model() -> List[Option[u64]] {
    let mut model: List[Option[u64]] = list.new()
    for k in 0u64 .. LCU_CRASH_ROWS + 8 {
        list.push(mut model, if k < LCU_CRASH_ROWS {
            Some(3 * k)
        } else {
            None
        })
    }
    let mut next_value = LCU_CRASH_FIRST
    let mut state = LCU_CRASH_SEED
    for _ in string.as_bytes(LCU_CRASH_ROUNDS) {
        state = lix_next(state)
        for (k, v) in lcu_writes(state, mut next_value, list.len(model)) {
            model[k] = v
        }
    }
    take model
}

fn lcu_crash_init(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, lcu_crash_options())?
    let mut staging = install_old(db)?
    let description = install_fixture_bytes(32u64, 65u8)
    stage_activation(mut staging, 1u64, None, description, std.codec.of_bytes(), description)?
    install_activation(mut db, take staging)?
    let t = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let filled = run(mut db, None, copy_env(t), fn(mut tx: Tx, rows_table: Table[u64, u64]) -> Result[(), Error] {
        for k in 0u64 .. LCU_CRASH_ROWS {
            put(mut tx, rows_table, k, 3 * k)?
        }
        Ok(())
    })?
    let Committed(_) = take filled else {
        return Error(MigrationFault)
    }
    let _ = checkpoint(mut db)?
    close(take db)
}

fn lcu_crash_run(mut db: Db, d: Dir, c: Clock, tasks: Tasks) -> Result[(), DeployError] waits {
    let t = deploy_result(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))?
    let mut model: List[Option[u64]] = list.new()
    for k in 0u64 .. LCU_CRASH_ROWS + 8 {
        list.push(mut model, if k < LCU_CRASH_ROWS {
            Some(3 * k)
        } else {
            None
        })
    }
    let attempt = install_fixture_bytes(16u64, 7u8)
    let (scratch, _) = crash_install_prepared(mut db, d, c, tasks, attempt)?
    let mut source = open_export(scratch, c, attempt, lcu_crash_options())?
    let (take initial_staged, _, _) = deploy_result(lcu_stage(source, tasks, false))?
    let mut staged = take initial_staged
    let digest = lcu_ship(mut db, mut source, staged, scratch)?
    let mut next_value = LCU_CRASH_FIRST
    let mut state = LCU_CRASH_SEED
    for code_byte in string.as_bytes(LCU_CRASH_ROUNDS) {
        state = lix_next(state)
        deploy_result(lcu_round(mut db, t, code_byte, state, mut next_value, mut model))?
        if !lcu_follow(mut db, d, scratch, attempt, mut source, mut staged)? {
            fail("catch-up crash: a small tail catches up")
        }
    }
    let _ = crash_apply(mut db, attempt, digest)?
    Ok(())
}

fn lcu_crash_write(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let mut db = open(tasks, d, c, r, lcu_crash_options())?
    match lcu_crash_run(mut db, d, c, tasks) {
        Ok(()) => (),
        Error(Store(take problem)) => return Error(take problem),
        Error(Scratch(take problem)) => return Error(take problem),
        Error(_) => fail("catch-up crash fixture refused"),
    }
    close(take db)
}

// The "catch-up" crash scenario's phases (disk_crash_main).
fn lcu_crash_phase(d: Dir, c: Clock, r: Random, tasks: Tasks, argv: Args, out: Stdout, phase: String) -> Result[(), Exit] waits {
    if phase == "init" {
        lcu_crash_init(d, c, r, tasks) ?=> |_| Exit(status: 81u8)
        return Ok(())
    }
    if phase == "write" {
        return match lcu_crash_write(d, c, r, tasks) {
            Ok(()) => {
                let _ = stdout.write(out, "DONE");
                Ok(())
            },
            Error(Io(_)) => Ok(()),
            Error(Poisoned(_)) => Ok(()),
            Error(_) => Error(Exit(status: 82u8)),
        }
    }
    let required_new = option.unwrap(args.get(argv, 2u64)) == "new"
    match lcu_crash_read(d, c, r, tasks, required_new) {
        Ok(true) => Ok(()),
        _ => Error(Exit(status: 83u8)),
    }
}

// None for OLD, by_v's id for NEW; a mix fails.
fn lcu_crash_state(mut db: Db) -> Result[Option[u32], Error] waits {
    let t = system_table(db, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let indexes = index_catalog(db, t.id)?
    let other = match system_table(db, "other", std.codec.key_u64(), std.codec.of_u64()) {
        Ok(_) => true,
        Error(_) => false,
    }
    // OLD and NEW both hold "other"; only NEW holds by_v.
    if !other || list.len(indexes) > 1 {
        fail("catch-up crash: neither OLD's catalog nor NEW's")
    }
    if list.len(indexes) == 0 {
        return Ok(None)
    }
    // NEW is installed only after every round, so its rows are the model's.
    let model = lcu_crash_model()
    let snap = snapshot(db)
    for k in 0u64 .. list.len(model) {
        if get(result.unwrap(reader(db, 0u64)), snap, t, k)? != model[k] {
            fail("catch-up crash: NEW's rows differ from the rounds' model")
        }
    }
    let by_v = indexes[0].id
    if !lcu_public(db, by_v)? || lix_entries(db, by_v)? != lix_expected(by_v, model)? {
        fail("catch-up crash: by_v differs from a next_value extraction of the model")
    }
    let mut d = declare(db, Open)?
    let _ = lcu_schema(mut d, false)?
    let _ = seal(mut db, take d)?
    Ok(Some(by_v))
}

fn lcu_crash_read(d: Dir, c: Clock, r: Random, tasks: Tasks, required_new: bool) -> Result[bool, Error] waits {
    let mut db = open(tasks, d, c, r, lcu_crash_options())?
    let installed = lcu_crash_state(mut db)?
    trust_store(mut db)?
    if required_new && installed == None {
        return Ok(false)
    }
    let _ = checkpoint(mut db)?
    if !lcu_no_import_pin(db) {
        return Ok(false)
    }
    close(take db)?
    let mut reopened = open(tasks, d, c, r, lcu_crash_options())?
    if lcu_crash_state(mut reopened)? != installed || !lcu_no_import_pin(reopened) {
        return Ok(false)
    }
    trust_store(mut reopened)?
    close(take reopened)?
    Ok(true)
}

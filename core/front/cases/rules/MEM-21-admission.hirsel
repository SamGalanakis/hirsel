// MEM-21: an allocating operation admits its charge before any write and otherwise fails
// with Capacity having allocated nothing; a core operation that may allocate says so in
// its result type, which must be used (budgets.md's examples: `grow` accepted; the unit
// `grow`'s discarded push refused under LANG-18, fenced by patterns/unused-result).
// Hand-derived: a first push grows an
// empty List[u64] to capacity 4, a charge of 4 * 8 = 32 bytes (budgets.md), so under
// `bound bytes 0` it fails requesting 32, the list stays empty and the error returns the
// value 1: 32 * 100 + 0 * 10 + 1. Unbounded, one push gives length 1.
// expect: run refused() = 3201
// expect: run grown() = 1
fn grow(mut xs: List[u64]) -> Result[(), (Capacity, u64)] {
    list.push(mut xs, 1)
}

fn refused() -> u64 {
    let mut xs: List[u64] = list.new()
    let got = bound bytes 0 {
        list.push(mut xs, 1)
    }
    match got {
        Ok(Error((e, v))) => e.requested * 100 + list.len(xs) * 10 + v,
        _ => 0
    }
}

fn grown() -> u64 {
    let mut xs: List[u64] = list.new()
    match grow(mut xs) {
        Ok(()) => list.len(xs),
        Error(_) => 0
    }
}

// rule: PROV-1
// expect: accept
// An unannotated literal is typed by its elements: `[authority.floor(a)]` holds
// a level of `a` once the call's brand names the argument, so it is a
// `List[Level of a]` and its element may be used with `a`.
fn first(a: Authority) -> u64 {
  let levels = [authority.floor(a)]
  let mut n: u64 = 0
  for l in levels {
    let _ = authority.read(a, 0, l, 1)
    n = n + 1
  }
  n
}

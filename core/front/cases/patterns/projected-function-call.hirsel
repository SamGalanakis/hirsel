// Selecting a member of a function value must not silently call the function.
// The names lane has not implemented this kind of value projection.
// expect: refuse LANG-7 at 7:16
// expect: cause LANG-7 at 7:16 from 6:4
// expect: compared LANG-7 at 7:16 | function | local, module, package or constant as a dotted-path head
fn source() -> u8 { 7 }
fn f() -> u8 { source.member() }

// Overwrite count existing elements starting at at from the start of src.
// A range outside either Inline array fails with Bounds before any write.
pub fn copy_from_slice[A: plain](mut dst: A, at: u64, src: A, count: u64)

// Read a u16, u32 or u64 (as fixed by the expected type) from an Inline byte
// array. Invalid ranges fail with Bounds. Alloc: nothing.
pub fn word_le[A: plain, T: integer](b: A, at: u64) -> T

// Like word_le, in big-endian byte order.
pub fn word_be[A: plain, T: integer](b: A, at: u64) -> T

// Overwrite the u16, u32 or u64 x at byte offset at of an Inline byte array,
// little-endian. Invalid ranges fail with Bounds before any write.
pub fn set_word_le[A: plain, T: integer](mut a: A, at: u64, x: T)

// Like set_word_le, in big-endian byte order.
pub fn set_word_be[A: plain, T: integer](mut a: A, at: u64, x: T)

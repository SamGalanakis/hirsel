// Contract tests for `string` (core/std/string.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names. Lists are read back as numbers, one decimal digit per element.
fn same(a: String, b: String) -> bool {
    a == b
}

fn found(o: Option[u64]) -> u64 {
    match o {
        Some(i) => i,
        None => 99,
    }
}

// expect: run with_capacity_is_empty() = true
fn with_capacity_is_empty() -> bool {
    let s = result.unwrap(string.with_capacity(10))
    string.byte_len(s) == 0 && list.capacity(string.as_bytes(s)) >= 10
}

// "é" is the two bytes C3 A9.
// expect: run boundary_inside_scalar() = false
fn boundary_inside_scalar() -> bool {
    string.is_boundary("é", 1)
}

// expect: run boundary_at_end() = true
fn boundary_at_end() -> bool {
    string.is_boundary("é", 2)
}

// expect: run boundary_past_end() = false
fn boundary_past_end() -> bool {
    string.is_boundary("é", 3)
}

// expect: run boundary_before_scalar() = true
fn boundary_before_scalar() -> bool {
    string.is_boundary("aé", 1)
}

// expect: run push_i64_signs() = true
fn push_i64_signs() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_i64(mut s, -3))
    result.unwrap(string.push_i64(mut s, 0))
    result.unwrap(string.push_i64(mut s, -9223372036854775808))
    result.unwrap(string.push_i64(mut s, 9223372036854775807))
    same(s, "-30-92233720368547758089223372036854775807")
}

// The contract's example: 31 in base 16, padded with '0' to 4 scalars.
// expect: run push_uint_padded_hex() = true
fn push_uint_padded_hex() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_uint(mut s, 31, 16, 4, '0'))
    same(s, "001f")
}

// expect: run push_uint_binary() = true
fn push_uint_binary() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_uint(mut s, 255, 2, 0, ' '))
    same(s, "11111111")
}

// Zero is one digit; the pad scalar may be any scalar.
// expect: run push_uint_zero_padded() = true
fn push_uint_zero_padded() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_uint(mut s, 0, 10, 3, '*'))
    same(s, "**0")
}

// A width below the digit count pads nothing.
// expect: run push_uint_narrow_width() = true
fn push_uint_narrow_width() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_uint(mut s, 12345, 10, 2, '0'))
    same(s, "12345")
}

// expect: run push_uint_base_36() = true
fn push_uint_base_36() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_uint(mut s, 35, 36, 1, '0'))
    same(s, "z")
}

// expect: run push_uint_base_37() = fail Fail
fn push_uint_base_37() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_uint(mut s, 1, 37, 0, '0'))
    true
}

// expect: run push_uint_base_1() = fail Fail
fn push_uint_base_1() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_uint(mut s, 1, 1, 0, '0'))
    true
}

// expect: run clear_keeps_storage() = true
fn clear_keeps_storage() -> bool {
    let mut s = result.unwrap(string.from("abc"))
    string.clear(mut s)
    string.byte_len(s) == 0 && list.capacity(string.as_bytes(s)) >= 3
}

// expect: run clear_static() = 0
fn clear_static() -> u64 {
    let mut s = "xyz"
    string.clear(mut s)
    string.byte_len(s)
}

// Clearing "xyz" admits nothing: under `bound bytes 8` the 8-byte copy of "abcdefgh" still
// fits afterwards. A clear that copied the literal first (charge 8) would hold the whole bound.
// expect: run clear_static_admits_nothing() = true
fn clear_static_admits_nothing() -> bool {
    let r: Result[bool, Capacity] = bound bytes 8 {
        let mut s = "xyz"
        string.clear(mut s)
        let fits = match string.from("abcdefgh") {
            Ok(_) => true,
            Error(_) => false,
        }
        fits && string.byte_len(s) == 0
    }
    match r {
        Ok(b) => b,
        Error(_) => false,
    }
}

// expect: run repeat_three() = true
fn repeat_three() -> bool {
    let r = result.unwrap(string.repeat("aé", 3))
    r == "aéaéaé" && string.byte_len(r) == 9 && list.capacity(string.as_bytes(r)) >= 9
}

// Zero copies and the empty string both give "".
// expect: run repeat_empty() = 0
fn repeat_empty() -> u64 {
    string.byte_len(result.unwrap(string.repeat("abc", 0))) + string.byte_len(result.unwrap(string.repeat("", 1000)))
}

// 2 x 2^63 = 2^64 does not fit in u64.
// expect: run repeat_overflow() = fail Fail
fn repeat_overflow() -> u64 {
    string.byte_len(result.unwrap(string.repeat("ab", 9223372036854775808)))
}

// expect: run find_first() = 2
fn find_first() -> u64 {
    found(string.find("abcabc", 0, "ca"))
}

// expect: run find_from_start() = 4
fn find_from_start() -> u64 {
    found(string.find("abcabc", 3, "bc"))
}

// A partial match at 0 ("aa" then 'a' against 'b') must not hide the match at 1.
// expect: run find_after_partial_match() = 1
fn find_after_partial_match() -> u64 {
    found(string.find("aaab", 0, "aab"))
}

// expect: run find_absent() = 99
fn find_absent() -> u64 {
    found(string.find("abc", 0, "x"))
}

// expect: run find_longer_than_rest() = 99
fn find_longer_than_rest() -> u64 {
    found(string.find("abc", 2, "cd"))
}

// expect: run find_empty_pattern() = 1
fn find_empty_pattern() -> u64 {
    found(string.find("abc", 1, ""))
}

// expect: run find_empty_at_end() = 3
fn find_empty_at_end() -> u64 {
    found(string.find("abc", 3, ""))
}

// k x's, then "éy" (3 bytes), then 15 - k x's: 18 bytes, the match at every offset k of
// two 8-byte words up to the tail (k = 15). Found at k each time, and "éz" (same first two
// bytes) never, so the sum is 0 + 1 + ... + 15 = 120.
// expect: run find_every_offset() = 120
fn find_every_offset() -> u64 {
    let mut total: u64 = 0
    for k in 0u64 .. 16 {
        let mut s = string.new()
        for i in 0u64 .. 16 {
            if i == k { result.unwrap(string.push(mut s, "éy")) }
            if i < 15 { result.unwrap(string.push(mut s, "x")) }
        }
        match string.find(s, 0, "éz") { Some(_) => { return 999 }, None => {} }
        total += found(string.find(s, 0, "éy"))
    }
    total
}

// 37 bytes of 'a' (two 16-byte blocks and a 5-byte tail) with a newline at q and r, and 'b'
// after r when b_after; an offset of 37 or more places nothing.
fn newlines(q: u64, r: u64, b_after: bool) -> String {
    let mut out: Bytes = list.new()
    result.unwrap(list.fill(mut out, 37, 0x61))
    if q < 37 {
        let _ = list.set(mut out, q, 0x0A)
    }
    if r < 37 {
        let _ = list.set(mut out, r, 0x0A)
        if b_after {
            let _ = list.set(mut out, r + 1, 0x62)
        }
    }
    match string.from_utf8(take out) {
        Ok(take text) => text,
        Error(_) => string.new(),
    }
}

// One-byte needle at every offset q of the blocks and the tail: found at q, sum 0 + ... + 36
// = 666. A second newline at each later r, in the same word or after it: still q, sum of
// q * (36 - q) = 7770. Reported as the first sum * 100000 + the second.
// expect: run find_byte_every_offset() = 66607770
fn find_byte_every_offset() -> u64 {
    let mut one: u64 = 0
    let mut two: u64 = 0
    for q in 0u64 .. 37 {
        one += found(string.find(newlines(q, 99, false), 0, "\n"))
        for r in q + 1 .. 37 {
            two += found(string.find(newlines(q, r, false), 0, "\n"))
        }
    }
    one * 100000 + two
}

// "\nb" where a newline at q is followed by 'a' and "\nb" sits at r >= q + 2: the candidate
// at q fails its compare and the scan resumes inside the block; found at r, sum 14280.
// expect: run find_after_failed_candidate() = 14280
fn find_after_failed_candidate() -> u64 {
    let mut total: u64 = 0
    for q in 0u64 .. 34 {
        for r in q + 2 .. 36 {
            total += found(string.find(newlines(q, r, true), 0, "\nb"))
        }
    }
    total
}

// A newline at 30, searched from every start 0 to 37: found at 30 from starts 0 to 30, None
// (99) from 31 to 37: 31 * 30 + 7 * 99 = 1623.
// expect: run find_byte_from_every_start() = 1623
fn find_byte_from_every_start() -> u64 {
    let text = newlines(30, 99, false)
    let mut total: u64 = 0
    for st in 0u64 .. 38 {
        total += found(string.find(text, st, "\n"))
    }
    total
}

// expect: run find_start_past_end() = fail Bounds
fn find_start_past_end() -> u64 {
    found(string.find("abc", 4, "a"))
}

// expect: run starts_with_prefix() = true
fn starts_with_prefix() -> bool {
    string.starts_with("GET /", "GET ")
}

// expect: run starts_with_longer() = false
fn starts_with_longer() -> bool {
    string.starts_with("GE", "GET")
}

// expect: run starts_with_empty() = true
fn starts_with_empty() -> bool {
    string.starts_with("abc", "")
}

// expect: run ends_with_suffix() = true
fn ends_with_suffix() -> bool {
    string.ends_with("a.json", ".json")
}

// expect: run ends_with_longer() = false
fn ends_with_longer() -> bool {
    string.ends_with("json", ".json")
}

// Every piece of s from next_split (sep given) or next_line (sep empty), each in brackets.
fn pieces(s: String, sep: String) -> String {
    let mut out = string.new()
    let mut at: u64 = 0
    if string.byte_len(sep) == 0 {
        while let Some((line, next)) = string.next_line(s, at) {
            result.unwrap(string.push(mut out, "["))
            result.unwrap(string.push(mut out, line))
            result.unwrap(string.push(mut out, "]"))
            at = next
        }
    } else {
        while let Some((piece, next)) = string.next_split(s, at, sep) {
            result.unwrap(string.push(mut out, "["))
            result.unwrap(string.push(mut out, piece))
            result.unwrap(string.push(mut out, "]"))
            at = next
        }
    }
    out
}

// Rust's "a,b,,c,".split(','): a, b, "", c, and the empty piece after the trailing comma.
// expect: run next_split_pieces() = true
fn next_split_pieces() -> bool {
    same(pieces("a,b,,c,", ","), "[a][b][][c][]")
}

// Rust: "".split(',') is one empty piece; "abc" with no comma is itself; "x::y:::z" split
// on "::" is x, y, ":z" (the first "::" of ":::" is the separator); é pieces keep both bytes.
// expect: run next_split_edges() = true
fn next_split_edges() -> bool {
    same(pieces("", ","), "[]") && same(pieces("abc", ","), "[abc]") && same(pieces("x::y:::z", "::"), "[x][y][:z]") && same(pieces("é;é", ";"), "[é][é]")
}

// Cursor 5 is one past "a,b,"'s end (4 + 1): None. Cursor 6 is past that.
// expect: run next_split_past_end() = fail Bounds
fn next_split_past_end() -> u64 {
    match string.next_split("a,b,", 5, ",") {
        Some(_) => 1,
        None => match string.next_split("a,b,", 6, ",") {
            Some(_) => 2,
            None => 3,
        },
    }
}

// expect: run next_split_empty_sep() = fail Fail
fn next_split_empty_sep() -> u64 {
    match string.next_split("abc", 0, "") {
        Some(_) => 1,
        None => 2,
    }
}

// Rust's "a\r\nb\n\nc\r".lines(): a (CRLF ending), b, "", and "c\r" (a lone CR stays).
// expect: run next_line_endings() = true
fn next_line_endings() -> bool {
    same(pieces("a\r\nb\n\nc\r", ""), "[a][b][][c\r]")
}

// Rust: "".lines() is empty; "a\n" is one line (no empty line after the final ending);
// "\n" is one empty line; "\r\n" one empty line; "x\n\n" is x then one empty line.
// expect: run next_line_edges() = true
fn next_line_edges() -> bool {
    same(pieces("", ""), "") && same(pieces("a\n", ""), "[a]") && same(pieces("\n", ""), "[]") && same(pieces("\r\n", ""), "[]") && same(pieces("x\n\n", ""), "[x][]")
}

// A cursor inside é (bytes 1 and 2 of "aé") is refused.
// expect: run next_line_inside_scalar() = fail Bounds
fn next_line_inside_scalar() -> u64 {
    match string.next_line("aé\n", 2) {
        Some((_, next)) => next,
        None => 0,
    }
}

// expect: run split_once_first() = true
fn split_once_first() -> bool {
    match string.split_once("a=b=c", "=") {
        Some((before, after)) => same(before, "a") && same(after, "b=c"),
        None => false,
    }
}

// expect: run split_once_two_bytes() = true
fn split_once_two_bytes() -> bool {
    match string.split_once("key: value", ": ") {
        Some((before, after)) => same(before, "key") && same(after, "value"),
        None => false,
    }
}

// expect: run split_once_empty_sep() = true
fn split_once_empty_sep() -> bool {
    match string.split_once("abc", "") {
        Some((before, after)) => same(before, "") && same(after, "abc"),
        None => false,
    }
}

// expect: run split_once_absent() = false
fn split_once_absent() -> bool {
    match string.split_once("abc", "x") {
        Some(_) => true,
        None => false,
    }
}

// expect: run strip_prefix_present() = true
fn strip_prefix_present() -> bool {
    match string.strip_prefix("GET /x", "GET ") {
        Some(rest) => same(rest, "/x"),
        None => false,
    }
}

// expect: run strip_prefix_absent() = false
fn strip_prefix_absent() -> bool {
    match string.strip_prefix("PUT /x", "GET ") {
        Some(_) => true,
        None => false,
    }
}

// expect: run strip_suffix_present() = true
fn strip_suffix_present() -> bool {
    match string.strip_suffix("a.json", ".json") {
        Some(stem) => same(stem, "a"),
        None => false,
    }
}

// expect: run strip_suffix_absent() = false
fn strip_suffix_absent() -> bool {
    match string.strip_suffix("a.js", ".json") {
        Some(_) => true,
        None => false,
    }
}

// expect: run trim_both_ends() = true
fn trim_both_ends() -> bool {
    same(string.trim_ascii("  \t hi there \r\n"), "hi there")
}

// expect: run trim_all_space() = 0
fn trim_all_space() -> u64 {
    string.byte_len(string.trim_ascii(" \n\t "))
}

// Only ASCII whitespace is trimmed; É is kept.
// expect: run trim_keeps_other_scalars() = true
fn trim_keeps_other_scalars() -> bool {
    same(string.trim_ascii(" É "), "É")
}

// Core operations with bodies (core/core/string.hirsel), against core.md and RFC 3629.
fn utf8(take b: Result[Bytes, Capacity]) -> u64 {
    match string.from_utf8(result.unwrap(take b)) {
        Ok(_) => 1,
        Error(_) => 0,
    }
}

// One digit per case, 1 for valid: a + é; overlong C0 80; overlong E0 80 80; E0 A0 80
// (U+0800); surrogate ED A0 80; ED 9F BF (U+D7FF); overlong F0 80 80 80; F0 90 80 80
// (U+10000); F4 90 80 80 (above U+10FFFF); F4 8F BF BF (U+10FFFF); truncated E2 82; a lone
// continuation 80; F5 80 80 80.
// expect: run from_utf8_boundaries() = 1001010101000
fn from_utf8_boundaries() -> u64 {
    let mut v: u64 = utf8(b"a\xC3\xA9")
    v = v * 10 + utf8(b"\xC0\x80")
    v = v * 10 + utf8(b"\xE0\x80\x80")
    v = v * 10 + utf8(b"\xE0\xA0\x80")
    v = v * 10 + utf8(b"\xED\xA0\x80")
    v = v * 10 + utf8(b"\xED\x9F\xBF")
    v = v * 10 + utf8(b"\xF0\x80\x80\x80")
    v = v * 10 + utf8(b"\xF0\x90\x80\x80")
    v = v * 10 + utf8(b"\xF4\x90\x80\x80")
    v = v * 10 + utf8(b"\xF4\x8F\xBF\xBF")
    v = v * 10 + utf8(b"a\xE2\x82")
    v = v * 10 + utf8(b"\x80")
    v * 10 + utf8(b"\xF5\x80\x80\x80")
}

// The ASCII run before each scalar, one digit per case, 1 for valid: empty; ten ASCII bytes
// to the end; nine then FF; a run, é, a run to the end; the same then a lone 80; a run then
// a truncated E2 82; é é then a run.
// expect: run from_utf8_ascii_runs() = 1101001
fn from_utf8_ascii_runs() -> u64 {
    let mut v: u64 = utf8(b"")
    v = v * 10 + utf8(b"abcdefghij")
    v = v * 10 + utf8(b"abcdefghi\xFF")
    v = v * 10 + utf8(b"abcdefgh\xC3\xA9ijklmnop")
    v = v * 10 + utf8(b"abcdefgh\xC3\xA9ijklmnop\x80")
    v = v * 10 + utf8(b"abcdefgh\xE2\x82")
    v * 10 + utf8(b"\xC3\xA9\xC3\xA9abc")
}

fn valid(take b: Bytes) -> u64 {
    match string.from_utf8(take b) {
        Ok(_) => 1,
        Error(_) => 0,
    }
}

// n bytes of 'a', then the bytes of tail.
fn a_run(n: u64, take tail: Result[Bytes, Capacity]) -> Bytes {
    let mut out: Bytes = list.new()
    result.unwrap(list.fill(mut out, n, 0x61))
    result.unwrap(list.append(mut out, result.unwrap(take tail)))
    out
}

// 37 bytes of 'a' (two 16-byte blocks and a 5-byte tail) with FF at offset q, and with é at
// offset p when p < 37.
fn probe(p: u64, q: u64) -> Bytes {
    let mut out = a_run(37, b"")
    if p < 37 {
        let _ = list.set(mut out, p, 0xC3)
        let _ = list.set(mut out, p + 1, 0xA9)
    }
    if q < 37 {
        let _ = list.set(mut out, q, 0xFF)
    }
    out
}

// FF at each of the 37 offsets, inside either block or the tail: all 37 refused; é at each
// offset 0 to 35, after which the ASCII run crosses words to the end: all 36 accepted; é at
// 0 to 7 then FF at each later offset, so the run that stops at FF starts off a word boundary:
// all (35 + 34 + ... + 28) = 252 refused. Reported as refused * 1000 + accepted.
// expect: run from_utf8_block_offsets() = 289036
fn from_utf8_block_offsets() -> u64 {
    let mut refused: u64 = 0
    let mut accepted: u64 = 0
    for q in 0u64 .. 37 {
        refused += 1 - valid(probe(37, q))
    }
    for p in 0u64 .. 36 {
        accepted += valid(probe(p, 37))
    }
    for p in 0u64 .. 8 {
        for q in p + 2 .. 37 {
            refused += 1 - valid(probe(p, q))
        }
    }
    refused * 1000 + accepted
}

// The rows of from_utf8_boundaries after 16 bytes of ASCII, so each is met where a block
// stops: the same digits.
// expect: run from_utf8_rows_after_a_block() = 1001010101000
fn from_utf8_rows_after_a_block() -> u64 {
    let mut v: u64 = valid(a_run(16, b"a\xC3\xA9"))
    v = v * 10 + valid(a_run(16, b"\xC0\x80"))
    v = v * 10 + valid(a_run(16, b"\xE0\x80\x80"))
    v = v * 10 + valid(a_run(16, b"\xE0\xA0\x80"))
    v = v * 10 + valid(a_run(16, b"\xED\xA0\x80"))
    v = v * 10 + valid(a_run(16, b"\xED\x9F\xBF"))
    v = v * 10 + valid(a_run(16, b"\xF0\x80\x80\x80"))
    v = v * 10 + valid(a_run(16, b"\xF0\x90\x80\x80"))
    v = v * 10 + valid(a_run(16, b"\xF4\x90\x80\x80"))
    v = v * 10 + valid(a_run(16, b"\xF4\x8F\xBF\xBF"))
    v = v * 10 + valid(a_run(16, b"a\xE2\x82"))
    v = v * 10 + valid(a_run(16, b"\x80"))
    v * 10 + valid(a_run(16, b"\xF5\x80\x80\x80"))
}

// The argument comes back unchanged.
// expect: run from_utf8_returns_argument() = 3
fn from_utf8_returns_argument() -> u64 {
    match string.from_utf8(result.unwrap(b"ab\xFF")) {
        Ok(_) => 99,
        Error(b) => list.len(b),
    }
}

// A literal has capacity 0; its copy has capacity equal to its length, 6 bytes.
// expect: run from_literal() = 60
fn from_literal() -> u64 {
    let t = result.unwrap(string.from("héllo"))
    list.capacity(string.as_bytes(t)) * 10 + list.capacity(string.as_bytes("héllo"))
}

// An owned source with spare capacity: the copy's capacity is its length, 4.
// expect: run from_owned() = 4
fn from_owned() -> u64 {
    let mut s = result.unwrap(string.from("abc"))
    result.unwrap(string.push_char(mut s, 'd'))
    let t = result.unwrap(string.from(s))
    if t == "abcd" {
        list.capacity(string.as_bytes(t))
    } else {
        99
    }
}

// Under `bound bytes 0` the copy of "abc" (charge 8) returns Capacity; under 8 it fits.
// expect: run from_under_bound() = 12
fn from_under_bound() -> u64 {
    let small = bound bytes 0 {
        string.from("abc")
    }
    let refused: u64 = match small {
        Ok(Error(_)) => 1,
        _ => 0,
    }
    let enough = bound bytes 8 {
        string.from("abc")
    }
    let admitted: u64 = match enough {
        Ok(Ok(_)) => 2,
        _ => 0,
    }
    refused * 10 + admitted
}

fn decimal(n: u64) -> String {
    let mut s = string.new()
    result.unwrap(string.push_u64(mut s, n))
    s
}

// expect: run push_u64_digits() = true
fn push_u64_digits() -> bool {
    decimal(0) == "0" && decimal(9) == "9" && decimal(10) == "10" && decimal(18446744073709551615) == "18446744073709551615"
}

// Onto a literal: the static storage is copied out, never written.
// expect: run push_u64_onto_literal() = true
fn push_u64_onto_literal() -> bool {
    let mut s = "x"
    result.unwrap(string.push_u64(mut s, 42))
    s == "x42"
}

// Each side of every power of ten from 10 to 10^19: 10^k - 1 is k nines, 10^k is 1 and k zeros.
// Returns the number of k that print right.
// expect: run push_u64_powers_of_ten() = 19
fn push_u64_powers_of_ten() -> u64 {
    let mut right: u64 = 0
    let mut p: u64 = 1
    for k in 1u64 .. 20 {
        p = p * 10
        let nines = result.unwrap(string.repeat("9", k))
        let mut ten = result.unwrap(string.from("1"))
        result.unwrap(string.push(mut ten, result.unwrap(string.repeat("0", k))))
        if decimal(p - 1) == nines && decimal(p) == ten {
            right += 1
        }
    }
    right
}

// Every digit 1 to 9 repeated to every width 1 to 19 (and 1 to width 20): each digit value in each
// position of each width. Returns the number of the 9 x 19 + 1 = 172 that print right.
// expect: run push_u64_repdigits() = 172
fn push_u64_repdigits() -> u64 {
    let mut right: u64 = 0
    for d in 1u64 .. 10 {
        let mut n: u64 = 0
        for w in 1u64 .. 20 {
            n = n * 10 + d
            if decimal(n) == result.unwrap(string.repeat(string.slice("123456789", d - 1, d), w)) {
                right += 1
            }
        }
    }
    if decimal(11111111111111111111) == "11111111111111111111" {
        right += 1
    }
    right
}

// Distinct neighbouring digits at the widths whose last block is 1 to 4 digits after 0, 1 or 2
// blocks of eight: a digit in the wrong position shows.
// expect: run push_u64_digit_order() = true
fn push_u64_digit_order() -> bool {
    decimal(1) == "1" && decimal(12) == "12" && decimal(123) == "123" && decimal(1234) == "1234" && decimal(12345) == "12345" && decimal(123456789) == "123456789" && decimal(9876543210) == "9876543210" && decimal(10203040506) == "10203040506" && decimal(123456789012) == "123456789012" && decimal(98765432109876543) == "98765432109876543" && decimal(1234567890123456789) == "1234567890123456789" && decimal(12345678901234567890) == "12345678901234567890"
}

// Onto owned bytes, twice: the digits land after what is there, zeros inside n included.
// expect: run push_u64_appends() = true
fn push_u64_appends() -> bool {
    let mut s = result.unwrap(string.from("ab"))
    result.unwrap(string.push_u64(mut s, 100))
    result.unwrap(string.push_u64(mut s, 7))
    s == "ab1007"
}

// Into reserved room: ASCII lands after what is there, a wider scalar between ASCII pushes keeps
// the order, and nothing grows: 1 + 2 + 1 bytes fit in the 8 reserved.
// expect: run push_char_into_room() = true
fn push_char_into_room() -> bool {
    let mut s = string.new()
    result.unwrap(string.reserve(mut s, 8))
    let room = list.capacity(string.as_bytes(s))
    result.unwrap(string.push_char(mut s, 'a'))
    result.unwrap(string.push_char(mut s, 'é'))
    result.unwrap(string.push_char(mut s, 'b'))
    s == "aéb" && list.capacity(string.as_bytes(s)) == room
}

// 1, 2, 3 and 4 UTF-8 bytes: 'a', 'é' (C3 A9), '€' (E2 82 AC), U+1F600 (F0 9F 98 80).
// expect: run push_char_widths() = true
fn push_char_widths() -> bool {
    let mut s = string.new()
    result.unwrap(string.push_char(mut s, 'a'))
    result.unwrap(string.push_char(mut s, 'é'))
    result.unwrap(string.push_char(mut s, '€'))
    result.unwrap(string.push_char(mut s, '\u{1F600}'))
    s == "aé€\u{1F600}" && string.byte_len(s) == 10
}

// "aé€" is 61 C3 A9 E2 82 AC: scalars start at 0, 1 and 3, and end at 6.
// expect: run next_scalar_positions() = 1368364
fn next_scalar_positions() -> u64 {
    let s = "aé€"
    let mut v: u64 = 0
    let mut at: u64 = 0
    let mut last: u32 = 0
    while let Some((c, next)) = string.next_scalar(s, at) {
        v = v * 10 + next
        at = next
        last = char.to_u32(c)
    }
    // '€' is U+20AC, 8364.
    v * 10000 + int.widen(last)
}

// expect: run next_scalar_inside() = fail Bounds
fn next_scalar_inside() -> u64 {
    match string.next_scalar("aé", 2) {
        Some((_, next)) => next,
        None => 99,
    }
}

// expect: run next_scalar_past_end() = fail Bounds
fn next_scalar_past_end() -> u64 {
    match string.next_scalar("aé", 4) {
        Some((_, next)) => next,
        None => 99,
    }
}

// expect: run slice_whole_scalar() = 2
fn slice_whole_scalar() -> u64 {
    string.byte_len(string.slice("aé", 1, 3))
}

// expect: run slice_inside_scalar() = fail Bounds
fn slice_inside_scalar() -> u64 {
    string.byte_len(string.slice("aé", 0, 2))
}

// expect: run slice_reversed() = fail Bounds
fn slice_reversed() -> u64 {
    string.byte_len(string.slice("aé", 1, 0))
}

// An owned String keeps its storage: length 3, capacity 3.
// expect: run into_bytes_owned() = 33
fn into_bytes_owned() -> u64 {
    let b = result.unwrap(string.into_bytes(result.unwrap(string.from("abc"))))
    list.len(b) * 10 + list.capacity(b)
}

// A literal is copied into capacity equal to its length.
// expect: run into_bytes_literal() = 44
fn into_bytes_literal() -> u64 {
    let b = result.unwrap(string.into_bytes("abcd"))
    list.len(b) * 10 + list.capacity(b)
}

// Under `bound bytes 0` the copy is refused and the error returns the String.
// expect: run into_bytes_under_bound() = 3
fn into_bytes_under_bound() -> u64 {
    let r: Result[u64, Capacity] = bound bytes 0 {
        match string.into_bytes("abc") {
            Ok(_) => 99,
            Error((_, s)) => string.byte_len(s),
        }
    }
    match r {
        Ok(n) => n,
        Error(_) => 98,
    }
}

// "aé€" truncated to 3 bytes is "aé"; the capacity stays 6.
// expect: run truncate_keeps_capacity() = 36
fn truncate_keeps_capacity() -> u64 {
    let mut s = result.unwrap(string.from("aé€"))
    string.truncate(mut s, 3)
    if s == "aé" {
        string.byte_len(s) * 10 + list.capacity(string.as_bytes(s))
    } else {
        99
    }
}

// expect: run truncate_inside_scalar() = fail Bounds
fn truncate_inside_scalar() -> u64 {
    let mut s = result.unwrap(string.from("aé"))
    string.truncate(mut s, 2)
    string.byte_len(s)
}

// expect: run truncate_past_end() = fail Bounds
fn truncate_past_end() -> u64 {
    let mut s = "aé"
    string.truncate(mut s, 4)
    string.byte_len(s)
}

// To 0: the owned "aé" keeps capacity 3 (len*10 + cap = 3); the literal keeps capacity 0 (0).
// expect: run truncate_to_zero() = 30
fn truncate_to_zero() -> u64 {
    let mut owned = result.unwrap(string.from("aé"))
    string.truncate(mut owned, 0)
    let mut lit = "aé"
    string.truncate(mut lit, 0)
    let a = string.byte_len(owned) * 10 + list.capacity(string.as_bytes(owned))
    let b = string.byte_len(lit) * 10 + list.capacity(string.as_bytes(lit))
    a * 10 + b
}

// expect: run truncate_literal_inside_scalar() = fail Bounds
fn truncate_literal_inside_scalar() -> u64 {
    let mut s = "aé"
    string.truncate(mut s, 2)
    string.byte_len(s)
}

// A push after truncating a literal copies out and never writes the static bytes: on each of two
// passes the literal "aé€" still reads "aé€" (2 passes), truncated to "aé" and pushed 'x' it is
// "aéx" (4 bytes) with capacity at least 4 (1): 2*100 + 1*10 + 4.
// expect: run push_after_truncating_literal() = 214
fn push_after_truncating_literal() -> u64 {
    let mut intact: u64 = 0
    let mut grown: u64 = 0
    let mut len: u64 = 0
    for _ in 0u64 .. 2 {
        let mut s = "aé€"
        if s == "aé€" {
            intact += 1
        }
        string.truncate(mut s, 3)
        let _ = string.push_char(mut s, 'x')
        if s == "aéx" && list.capacity(string.as_bytes(s)) >= 4 {
            grown = 1
            len = string.byte_len(s)
        }
    }
    intact * 100 + grown * 10 + len
}

// A literal shortens without being written; its capacity stays 0.
// expect: run truncate_literal() = 10
fn truncate_literal() -> u64 {
    let mut s = "aé"
    string.truncate(mut s, 1)
    if s == "a" {
        string.byte_len(s) * 10 + list.capacity(string.as_bytes(s))
    } else {
        99
    }
}

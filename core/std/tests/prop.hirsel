// test-of: std.prop
// test-reason: replay laws inspect the consumed tape and the private source flags.
fn law_returns_error(value: u64) -> Result[(), String] {
    Error(string.from("always false"))
}

fn law_passes(value: u64) -> Result[(), String] {
    Ok(())
}

fn show_u64(value: u64, mut out: String) {
    string.push_u64(mut out, value)
}

fn prop_failure_text(take run: Result[Result[Outcome, Causes], Capacity], expected: String) -> bool {
    if let Ok(Error(causes)) = take run {
        for cause in causes {
            if let Fail(text) = cause.kind {
                return text == expected
            }
            return false
        }
    }
    false
}

// Catches a noncanonical byte encoding or a decoded case index or word in the wrong position.
// expect: run prop_token_vector() = true
fn prop_token_vector() -> bool {
    let g = make(fn(mut s: Source) -> u64 {
        word(mut s) + word(mut s) + word(mut s)
    }, show_u64)
    let c = replay(config(), "AQcDAwCsAg==")
    if let Falsified(result) = search(c, g, law_returns_error) {
        let mut text = string.new()
        token(result, mut text)
        return text == "AQcDAwCsAg==" && result.index == 7 && result.rendered == "303" && list.len(result.tape) == 3 && result.tape[0].value == 3 && result.tape[1].value == 0 && result.tape[2].value == 300
    }
    false
}

// Catches using the first case's stream or swapping the Pcg seed words.
// expect: run prop_case_seed() = 0xc4f5a58656eef510
fn prop_case_seed() -> u64 {
    let mut c = config()
    c.seed = 1
    let empty: Option[List[u64]] = None
    let g = make(word, show_u64)
    if let Some((value, _)) = generate(c, g, 2, empty) {
        return value
    }
    0
}

// A draw of 9 against bound 5 must record the normalized choice and render zero.
// expect: run prop_replay_misalignment() = true
fn prop_replay_misalignment() -> bool {
    let g = make(fn(mut s: Source) -> u64 {
        below(mut s, 5)
    }, show_u64)
    if let Falsified(result) = search(replay(config(), "AQABCQ=="), g, law_returns_error) {
        return result.rendered == "0" && list.len(result.tape) == 1 && result.tape[0].value == 0 && result.tape[0].limit == 5
    }
    false
}

// Catches running the always-false law with a missing second choice.
// expect: run prop_replay_overrun() = true
fn prop_replay_overrun() -> bool {
    let g = make(fn(mut s: Source) -> u64 {
        word(mut s) + word(mut s)
    }, show_u64)
    let short_run = isolate(fn() -> Outcome {
        search(replay(config(), "AQABAQ=="), g, law_returns_error)
    })
    if !prop_failure_text(take short_run, "prop: replay token no longer fails") {
        return false
    }
    if let Falsified(result) = search(replay(config(), "AQACAQI="), g, law_returns_error) {
        return result.rendered == "3" && list.len(result.tape) == 2
    }
    false
}

// Catches classifying a refused byte bound as a failing law.
// expect: run prop_config_bytes_refused() = true
fn prop_config_bytes_refused() -> bool {
    let trial = bound bytes 4096 {
        let g = make(word, show_u64)
        let mut c = config()
        c.case_bytes = 8192
        let run = isolate(fn() -> Outcome {
            search(c, g, law_returns_error)
        })
        prop_failure_text(take run, "prop: config: case_bytes 8192 refused")
    }
    match trial {
        Ok(ok) => ok,
        Error(_) => false,
    }
}

// Catches accepting a replay that the law now passes.
// expect: run prop_stale_replay() = true
fn prop_stale_replay() -> bool {
    let g = make(word, show_u64)
    let run = isolate(fn() -> Outcome {
        search(replay(config(), "AQABCQ=="), g, law_passes)
    })
    prop_failure_text(take run, "prop: replay token no longer fails")
}

// Catches calling the law outside its own step bound.
// expect: run prop_case_steps() = true
fn prop_case_steps() -> bool {
    let mut c = config()
    c.case_steps = 0
    c.cases = 1
    let g = make(word, show_u64)
    if let Falsified(result) = search(c, g, law_passes) {
        return result.message == "OutOfTime"
    }
    false
}

// Catches continuing to alternate after the shorter side of the range is exhausted.
// expect: run prop_zigzag() = true
fn prop_zigzag() -> bool {
    let expected: Inline[i64, 8] =[0, 1, -1, 2, -2, 3, 4, 5]
    let g = i64_in(-2, 5)
    for i in 0u64 .. 8 {
        let mut tape: List[u64] = list.new()
        list.push(mut tape, i)
        let mut s = source(0, 0, 1, Some(take tape))
        if draw(mut s, g) != expected[i] || s.overrun || list.len(s.tape) != 1 {
            return false
        }
    }
    true
}

// Catches interpreting zero as the beginning of the negative side or the midpoint.
// expect: run prop_clamped_origin() = true
fn prop_clamped_origin() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 0)
    let mut s = source(0, 0, 1, Some(take tape))
    draw(mut s, i64_in(3, 9)) == 3
}

// Catches drawing a flag before min, outside its element span, or at max.
// expect: run prop_list_flags() = true
fn prop_list_flags() -> bool {
    let g = list_of(u64_in(0, 9), 1, 3)
    let mut short_tape: List[u64] = list.new()
    list.push(mut short_tape, 4)
    list.push(mut short_tape, 1)
    list.push(mut short_tape, 7)
    list.push(mut short_tape, 0)
    let mut short = source(0, 0, 8, Some(take short_tape))
    let small = draw(mut short, g)
    let mut long_tape: List[u64] = list.new()
    list.push(mut long_tape, 4)
    list.push(mut long_tape, 1)
    list.push(mut long_tape, 7)
    list.push(mut long_tape, 1)
    list.push(mut long_tape, 2)
    let mut long = source(0, 0, 8, Some(take long_tape))
    let large = draw(mut long, g)
    !short.overrun && !long.overrun && list.len(small) == 2 && small[0] == 4 && small[1] == 7 && list.len(large) == 3 && large[0] == 4 && large[1] == 7 && large[2] == 2 && list.len(short.tape) == 4 && list.len(long.tape) == 5 && list.len(short.spans) == 3 && short.spans[0].end == 1 && short.spans[1].label == 1 && short.spans[1].start == 1 && short.spans[1].end == 3
}

// Catches counting UTF-16 surrogate code points as scalar choices.
// expect: run prop_char_surrogates() = true
fn prop_char_surrogates() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 1)
    let mut s = source(0, 0, 1, Some(take tape))
    let g = char_in('\u{d7ff}', '\u{e000}')
    draw(mut s, g) == '\u{e000}' && s.tape[0].limit == 2
}

// Catches drawing the selection inside the span or using the first branch.
// expect: run prop_one_of_span() = true
fn prop_one_of_span() -> bool {
    let mut gs: List[Gen[u64]] = list.new()
    list.push(mut gs, u64_in(10, 19))
    list.push(mut gs, u64_in(90, 99))
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 1)
    list.push(mut tape, 3)
    let mut s = source(0, 0, 2, Some(take tape))
    draw(mut s, one_of(take gs)) == 93 && list.len(s.spans) == 1 && s.spans[0].label == 3 && s.spans[0].start == 1 && s.spans[0].end == 2
}

fn reject_value(value: u64) -> bool {
    false
}

// Catches missing, extra, or accepted retries and rejects that count as valid cases.
// expect: run prop_filter_rejects() = true
fn prop_filter_rejects() -> bool {
    let g = filter(u64_in(0, 9), reject_value)
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 1)
    list.push(mut tape, 2)
    list.push(mut tape, 3)
    let mut s = source(0, 0, 5, Some(take tape))
    let _ = draw(mut s, g)
    if !s.invalid || s.overrun || list.len(s.tape) != 3 || list.len(s.spans) != 3 {
        return false
    }
    let mut c = config()
    c.cases = 1
    c.max_rejects = 1
    match search(c, g, law_returns_error) {
        GaveUp(n, rejected) => n == 0 && rejected == 2,
        _ => false,
    }
}

fn all_pair() -> Gen[(bool, u8)] {
    pair(bool_(), map_shown(u64_in(0, 2), fn(value: u64) -> u8 {
        int.narrow(value)
    }, fn(value: u8, mut text: String) {
        string.push_u64(mut text, int.widen(value))
    }))
}

fn all_pair_passes(value: (bool, u8)) -> Result[(), String] {
    Ok(())
}

// Catches skipped, duplicated or out-of-order choices, including at the exact case budget.
// expect: run prop_all_order() = true
fn prop_all_order() -> bool {
    let mut c = config()
    c.cases = 6
    let expected: Inline[(bool, u8), 6] =[(false, 0), (false, 1), (false, 2), (true, 0), (true, 1), (true, 2)]
    for i in 0u64 .. 6 {
        let target = expected[i]
        let Falsified(result) = all(c, all_pair(), fn(value: (bool, u8)) -> Result[(), String] {
            if value == target {
                Error(string.from("target"))
            } else {
                Ok(())
            }
        }) else {
            return false
        }
        if result.index != i || result.cases != i + 1 {
            return false
        }
    }
    match all(c, all_pair(), all_pair_passes) {
        Held(run, discarded) => run == 6 && discarded == 0,
        _ => false,
    }
}

fn all_corner_law(value: (bool, u8)) -> Result[(), String] {
    if value == (true, 2u8) {
        Error(string.from("corner"))
    } else {
        Ok(())
    }
}

// Catches losing the first failing tape or reporting a counterexample that cannot replay.
// expect: run prop_all_corner() = true
fn prop_all_corner() -> bool {
    let Falsified(result) = all(config(), all_pair(), all_corner_law) else {
        return false
    }
    let mut text = string.new()
    token(result, mut text)
    if text != "AQUCAQI=" || result.rendered != "(true, 2)" || result.shrinks != 0 {
        return false
    }
    if let Falsified(replayed) = search(replay(config(), text), all_pair(), all_corner_law) {
        return replayed.index == 5 && replayed.rendered == "(true, 2)" && replayed.message == "corner"
    }
    false
}

// Catches skipping a live word, recording the wrong position or continuing with a dummy value.
// expect: run prop_all_unbounded_position() = true
fn prop_all_unbounded_position() -> bool {
    let g = make(fn(mut s: Source) -> u64 {
        if below(mut s, 2) == 0 {
            return 0
        }
        let _ = below(mut s, 1)
        1u64 / word(mut s)
    }, show_u64)
    match all(config(), g, law_passes) {
        Unbounded(at) => at == 2,
        _ => false,
    }
}

fn keep_nonzero(value: u64) -> bool {
    value != 0
}

fn require_nonzero(value: u64) -> Result[(), String] {
    if value == 0 {
        Error(string.from("zero reached the law"))
    } else {
        Ok(())
    }
}

fn all_counts(outcome: AllOutcome, held: bool, run: u64, discarded: u64) -> bool {
    match outcome {
        Held(r, d) => held && r == run && d == discarded,
        Truncated(r, d) => !held && r == run && d == discarded,
        _ => false,
    }
}

// Catches treating an unfinished tree as closed, counting overrun as rejection, or retrying a filter.
// expect: run prop_all_limits_and_rejects() = true
fn prop_all_limits_and_rejects() -> bool {
    let mut c = config()
    c.cases = 2
    let g = filter(u64_in(0, 2), keep_nonzero)
    if !all_counts(all(c, g, require_nonzero), false, 1, 1) {
        return false
    }
    c.cases = 3
    if !all_counts(all(c, g, require_nonzero), true, 2, 1) {
        return false
    }
    c.max_choices = 0
    if !all_counts(all(c, g, law_returns_error), false, 0, 0) {
        return false
    }
    c.max_choices = 1
    c.gen_steps = 0
    all_counts(all(c, g, law_returns_error), false, 0, 0)
}

// Catches sampling weighted choices at the probability endpoints on a variable-length path.
// expect: run prop_all_weighted() = true
fn prop_all_weighted() -> bool {
    let g = make(fn(mut s: Source) -> u64 {
        if weighted(mut s, 0, 100) {
            2
        } else if weighted(mut s, 100, 100) {
            1
        } else {
            0
        }
    }, show_u64)
    let mut c = config()
    c.cases = 3
    let Falsified(first) = all(c, g, require_nonzero) else {
        return false
    }
    if first.index != 0 || first.rendered != "0" {
        return false
    }
    all_counts(all(c, g, law_passes), true, 3, 0)
}

fn same_mapped_value(value: u64) -> u64 {
    0
}

fn list_law_returns_error(value: List[u64]) -> Result[(), String] {
    Error(string.from("always false"))
}

// Catches printing the mapped value in place of the original choice, including inside a list.
// expect: run prop_map_preimage() = true
fn prop_map_preimage() -> bool {
    let g = list_of(map(u64_in(0, 9), same_mapped_value), 1, 1)
    if let Falsified(result) = search(replay(config(), "AQABBw=="), g, list_law_returns_error) {
        return result.rendered == "[map(7)]"
    }
    false
}

fn smaller_than_thousand(value: u64) -> Result[(), String] {
    if value < 1000 {
        Ok(())
    } else {
        Error(string.from("value >= 1000"))
    }
}

fn sum_below_ten(values: List[u64]) -> Result[(), String] {
    if list.sum(values) < 10 {
        Ok(())
    } else {
        Error(string.from("sum >= 10"))
    }
}

fn length_below_three(values: List[u64]) -> Result[(), String] {
    if list.len(values) < 3 {
        Ok(())
    } else {
        Error(string.from("length >= 3"))
    }
}

fn signed_above_minus_five(value: i64) -> Result[(), String] {
    if value > -5 {
        Ok(())
    } else {
        Error(string.from("value <= -5"))
    }
}

fn pair_sum_below_ten(values: (u64, u64)) -> Result[(), String] {
    if values.0 + values.1 < 10 {
        Ok(())
    } else {
        Error(string.from("sum >= 10"))
    }
}

fn distinct_case_failures(value: u64) -> Result[(), String] {
    if value >= 50 {
        let _ = 1u64 / (value - value)
    }
    if value >= 3 {
        let _ = string.as_bytes("")[value]
    }
    Ok(())
}

fn duplicate_failure(values: (u64, u64)) -> Result[(), String] {
    if values.0 == values.1 && values.0 >= 3 {
        Error(string.from("both choices are equal and large"))
    } else {
        Ok(())
    }
}

fn conditional_generator(mut s: Source) -> u64 {
    let value = below(mut s, 100)
    if value < 50 {
        fail("generator exhausted")
    }
    value
}

fn failing_generator(mut s: Source) -> u64 {
    let _ = word(mut s)
    fail("generator failed")
}

// Catches failing to find the boundary between passing and failing integers.
// expect: run prop_shrink_integer() = true
fn prop_shrink_integer() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 123456)
    let result = shrink_from(config(), u64_in(0, 1000000), smaller_than_thousand, take tape)
    result.rendered == "1000" && list.len(result.tape) == 1 && result.tape[0].value == 1000
}

// Catches failures to transfer the sum before removing the zero span or to replay the minimal tape.
// expect: run prop_shrink_sum() = true
fn prop_shrink_sum() -> bool {
    let g = list_of(u64_in(0, 100), 0, 50)
    let Replay(values: take starting, ..) = parse_token("AQAFAQYBBwA=", 32)
    let result = shrink_from(config(), g, sum_below_ten, take starting)
    let mut printed = string.new()
    token(result, mut printed)
    if result.rendered != "[10]" || printed != "AQADAQoA" {
        return false
    }
    if let Falsified(reproduced) = search(replay(config(), printed), g, sum_below_ten) {
        return reproduced.rendered == "[10]" && reproduced.shrinks == 0 && reproduced.message == "sum >= 10"
    }
    false
}

// Catches preserving a fourth span or leaving values irrelevant to the length failure.
// expect: run prop_shrink_length() = true
fn prop_shrink_length() -> bool {
    let mut tape: List[u64] = list.new()
    let words: Inline[u64, 9] =[1, 5, 1, 6, 1, 7, 1, 8, 0]
    for value in words {
        list.push(mut tape, value)
    }
    let result = shrink_from(config(), list_of(u64_in(0, 100), 0, 50), length_below_three, take tape)
    result.rendered == "[0, 0, 0]"
}

// Catches minimizing the value by unsigned or absolute magnitude rather than its choice index.
// expect: run prop_shrink_signed() = true
fn prop_shrink_signed() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 100)
    let result = shrink_from(config(), i64_in(-100, 100), signed_above_minus_five, take tape)
    result.rendered == "-5" && result.tape[0].value == 10
}

// Catches shrinking entries independently and getting stuck at (5, 5).
// expect: run prop_shrink_pair() = true
fn prop_shrink_pair() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 7)
    list.push(mut tape, 5)
    let result = shrink_from(config(), pair(u64_in(0, 100), u64_in(0, 100)), pair_sum_below_ten, take tape)
    result.rendered == "(0, 10)"
}

// Catches crossing from the original Division cause to the smaller Bounds failure.
// expect: run prop_shrink_class() = true
fn prop_shrink_class() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 60)
    let result = shrink_from(config(), u64_in(0, 100), distinct_case_failures, take tape)
    result.rendered == "50" && result.message == "Division"
}

// Catches executing a candidate after spending the entire shrink allowance.
// expect: run prop_shrink_limit() = true
fn prop_shrink_limit() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 123456)
    let mut c = config()
    c.max_shrinks = 0
    let result = shrink_from(c, u64_in(0, 1000000), smaller_than_thousand, take tape)
    result.tape[0].value == 123456 && result.shrinks == 0
}

// Catches failing to lower jointly constrained equal choices.
// expect: run prop_shrink_duplicates() = true
fn prop_shrink_duplicates() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 9)
    list.push(mut tape, 9)
    let result = shrink_from(config(), pair(u64_in(0, 100), u64_in(0, 100)), duplicate_failure, take tape)
    result.rendered == "(3, 3)"
}

// Catches treating a generation failure during shrinking as a smaller counterexample.
// expect: run prop_shrink_generator_error() = true
fn prop_shrink_generator_error() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 60)
    let g = make(conditional_generator, show_u64)
    let result = shrink_from(config(), g, law_returns_error, take tape)
    result.rendered == "50" && result.message == "always false"
}

// Catches routing a failing search generator into the shrinker or discarding the case index.
// expect: run prop_shrink_generator_failure() = true
fn prop_shrink_generator_failure() -> bool {
    let g = make(failing_generator, show_u64)
    let result = isolate(fn() -> Outcome {
        search(config(), g, law_passes)
    })
    prop_failure_text(take result, "prop: generator failed at case 0")
}

fn unsorted_or_sorted_failure(values: (u64, u64, u64)) -> Result[(), String] {
    if values == (3u64, 1u64, 2u64) || values == (1u64, 2u64, 3u64) {
        Error(string.from("one of two orders"))
    } else {
        Ok(())
    }
}

// Catches sorting only by swaps that each have to preserve the failure.
// expect: run prop_shrink_sibling_order() = true
fn prop_shrink_sibling_order() -> bool {
    let mut tape: List[u64] = list.new()
    list.push(mut tape, 3)
    list.push(mut tape, 1)
    list.push(mut tape, 2)
    let g = triple(u64_in(0, 9), u64_in(0, 9), u64_in(0, 9))
    let result = shrink_from(config(), g, unsorted_or_sorted_failure, take tape)
    result.rendered == "(1, 2, 3)"
}

// Catches mixing only once or mixing the two inputs in the opposite order.
// expect: run prop_tasks_world_vectors() = true
fn prop_tasks_world_vectors() -> bool {
    world_seed(5, 7) == 0x88bf589a5ce00596 && world_seed(0, 0) == 0xa706dd2f4d197e6f
}

fn seed_case(take trial: Case[(u64, (u64, u64))]) -> Result[(), String] {
    let (actual, (sim, data_value)) = trial.value
    if actual == data_value && trial.world_seed == sim && trial.index == 0 {
        Ok(())
    } else {
        Error(string.from("seed or case index drift"))
    }
}

// Catches either seed affecting the other stream at the spawn boundary.
// expect: run prop_tasks_seed_isolation(tasks) = true
fn prop_tasks_seed_isolation(tasks: Tasks) -> bool waits {
    let vectors: Inline[(u64, u64, u64, u64), 3] =[(5, 5, 0x3eb2ecbc903907fc, 4), (5, 6, 0x7fe2811fc126dc6f, 4), (2, 5, 0x3eb2ecbc903907fc, 8)]
    for (data_seed, sim_seed, expected_world, expected_value) in vectors {
        let mut c = config()
        c.seed = data_seed
        c.sim_seed = Some(sim_seed)
        c.cases = 1
        c.max_shrinks = 0
        let g = pair(u64_in(0, 9), just((expected_world, expected_value)))
        let _ = check_tasks(tasks, c, g, seed_case)
    }
    true
}

fn endless_case(take trial: Case[u64]) -> Result[(), String] {
    loop {
        task.check_cancel()
    }
}

// Catches joining a child with an unbounded root step budget.
// expect: run prop_tasks_out_of_time(tasks) = true
fn prop_tasks_out_of_time(tasks: Tasks) -> bool waits {
    let mut c = config()
    c.case_steps = 1000
    let trial = task_failure(tasks, c, 0u64, 0, endless_case)
    if let Some(info) = trial {
        return info.class == TimedOut
    }
    false
}

}

// The store's next cut, crashed at `crash`'s row of the §13.6 table.
fn gate_crash_cut(d: Dir, c: Clock, r: Random, tasks: Tasks, options: Options, take db: Db, crash: GateCrash) -> Result[Db, Error] waits {
    let mut carried = take db
    if let NoCrash = crash {
        let _ = checkpoint(mut carried)?
        return Ok(take carried)
    }
    let first_output = manifest.pack_next(disk_state(carried).packs)
    let (take sealed, attempts) = refused_cut_seals(mut carried, NoHolderChange)?
    if let RetryAfterRename = crash {
        if attempts != 2 {
            fail("L87: the retry arm's cut redoes its plan once without relocation")
        }
    }
    gate_crash_reopen(d, c, r, tasks, options, take carried, sealed, first_output, crash)
}

// L87 (c), queue rows as roots (§13.6 "Queue rows are their own roots",
// astra 2207 #3). A Cold Tiered Log of 1,100-byte entries keeps its values
// as BLOBs in class-4 packs and its leaves and root in class-3 packs. A
// served trim one entry into the second leaf queues the first leaf (a Page
// row) and the second leaf's first BLOB (a Blob row), and the cut rewrites
// the second leaf and the root. A journaled whole-Log trim then folds at
// reopen, and queues the new root Q, whose leaf children Y stay in the
// older class-3 pack. `free_budget` is 0, so no row drains. The next cuts
// compact every Tiered pack (`compact_permille` 1001): only queue rows reach
// their frames, so each match moves, and each row takes its frame's new
// location. Expected: every Tiered pack listed before the compaction cut
// retires; the queue keeps its rows in order, each of the same kind; the
// walker from the rows reaches exactly the stamps it reached before, each
// at one location in a pack the compaction wrote; and once `free_budget`
// lets the drain run, a cut that moves the rows again drains none of them,
// and with no probe the drain consumes every row and files every moved frame
// dead, so no listed Tiered pack keeps live bytes. The fold cut compacts as
// well, so the row it adds moves before it is written. Seeded bugs
// `blob_in_leaf_only` (the Blob row is never matched, so its pack retires
// under it) and `queue_row_by_map` (Y is not reached from Q).
fn gate_queue_rows(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let floor = 182375272u64
    let width = 1100u64
    let retry = match crash {
        RetryAfterRename => true,
        _ => false,
    }
    let events = l87_cold_log_padded(d, c, r, tasks, floor, 300, width, retry)?
    // The retry arm also keeps a Memory table, so that deleting most of its
    // rows before the compaction cut leaves a sparse Memory pack: relocation
    // enters the cut's candidate, and AP16 redoes the refused attempt.
    let padding = if let RetryAfterRename = crash {
        let mut padded = open(tasks, d, c, r, l70_open_options(floor)?)?
        let fixture = table(mut padded, "padding", std.codec.key_u64(), std.codec.of_bytes())?
        let Committed(_) = run(mut padded, Some(100000000), copy_env(fixture), fn(mut tx: Tx, env: Table[u64, Bytes]) -> Result[(), Error] {
            for key in 0u64 .. 64 {
                let mut body: Bytes = list.with_capacity(2000)
                list.fill(mut body, 2000, int.truncate(key))
                put(mut tx, env, key, body)?
            }
            Ok(())
        })? else {
            fail("L87 (c): the padding rows commit")
        }
        let _ = checkpoint(mut padded)?
        close(take padded)?
        Some(())
    } else {
        None
    }
    let mut db = open(tasks, d, c, r, l87_options(floor, 0)?)?
    let (_, part) = l87_first_leaf(d, db, events.binding.id)?
    let partial: Log[Bytes] = clone(events)
    let Committed(_) = run(mut db, Some(100000), copy_env((partial, part)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87 (c): the served trim commits")
    }
    let _ = checkpoint(mut db)?
    let whole: Log[Bytes] = clone(events)
    let Committed(_) = run(mut db, Some(100000), copy_env(whole), fn(mut tx: Tx, env: Log[Bytes]) -> Result[(), Error] {
        trim_before(mut tx, env, 300)
    })? else {
        fail("L87 (c): the whole-Log trim commits")
    }
    close(take db)?
    // The fold cut compacts too, so Q, a row the cut adds, moves before T8
    // step 3 writes it, and is written at `deferred_next` with its new value.
    let mut fold_options = l87_options(floor, 0)?
    fold_options.probe_budget = 4096
    fold_options.compact_permille = 1001
    let mut folding = open(tasks, d, c, r, fold_options)?
    let _ = checkpoint(mut folding)?
    let _ = gate_walk_queue(d, folding)?
    close(take folding)?
    let mut options = l87_options(floor, 0)?
    options.probe_budget = 4096
    options.compact_permille = 1001
    let mut probing = open(tasks, d, c, r, options)?
    let before = l87_queue(probing)?
    let mut pages = 0u64
    let mut blobs = 0u64
    for (_, row) in before {
        match row.target {
            TieredPage(_) => {
                pages += 1
            },
            TieredBlob(_) => {
                blobs += 1
            },
        }
    }
    if pages < 2 || blobs < 1 {
        fail("L87 (c): the fixture queues Page rows and a Blob row")
    }
    let reached = gate_walk_queue(d, probing)?
    let mut old: List[u64] = list.new()
    let mut inventory = std.omap.range(manifest.pack_locations(disk_state(probing).packs).packs.values, Unbounded, Unbounded)
    while let Some((seq, pack)) = std.omap.next(mut inventory) {
        if pack.class == 3 || pack.class == 4 {
            list.push(mut old, seq)
        }
    }
    let mut cut_options = l87_options(floor, 0)?
    cut_options.probe_budget = 4096
    cut_options.compact_permille = 1001
    if let Some(_) = padding {
        let rows = table(mut probing, "padding", std.codec.key_u64(), std.codec.of_bytes())?
        let Committed(_) = run(mut probing, Some(100000000), copy_env(rows), fn(mut tx: Tx, env: Table[u64, Bytes]) -> Result[(), Error] {
            for key in 1u64 .. 64 {
                let _ = delete(mut tx, env, key)?
            }
            Ok(())
        })? else {
            fail("L87 (c): the padding deletes commit")
        }
    }
    let mut cutting = gate_crash_cut(d, c, r, tasks, cut_options, take probing, crash)?
    // A crash loses the probe cursors, so the cuts after it restart them
    // (§13.6 "Progress"); each probe covers its pack within these cuts.
    for _ in 0u64 .. 8 {
        let _ = checkpoint(mut cutting)?
    }
    for seq in old {
        if compact_listed(cutting, seq) {
            fail("L87 (c): a pack that only queue rows reach retires once its frames move")
        }
    }
    let after = l87_queue(cutting)?
    if list.len(after) != list.len(before) {
        fail("L87 (c): compaction keeps every queue row")
    }
    for k in 0u64 .. list.len(after) {
        let (seq_before, row_before) = before[k]
        let (seq_after, row_after) = after[k]
        let same_kind = match (row_before.target, row_after.target) {
            (TieredPage(_), TieredPage(_)) => true,
            (TieredBlob(_), TieredBlob(_)) => true,
            _ => false,
        }
        if seq_before != seq_after || row_before.branch_id != row_after.branch_id || !same_kind {
            fail("L87 (c): each row keeps its place, owner and kind, and takes the new location")
        }
    }
    let moved = gate_walk_queue(d, cutting)?
    if map.len(moved.places) != map.len(reached.places) {
        fail("L87 (c): the rows reach the same frames after the move")
    }
    for (stamp, place) in moved.places {
        if !map.contains(reached.places, stamp) || list.contains(old, place.0) {
            fail("L87 (c): every frame the rows reach moved to a pack the compaction wrote")
        }
    }
    close(take cutting)?
    // At `compact_permille` 1001 every fresh pack is selected again at each
    // cut and every row moves again, and a drain takes no row its own cut
    // moved (§13.6 "Deferred frees"): such a cut drains nothing.
    let mut moving_options = l87_options(floor, 65536)?
    moving_options.probe_budget = 4096
    moving_options.compact_permille = 1001
    let mut db_moving = open(tasks, d, c, r, moving_options)?
    let _ = checkpoint(mut db_moving)?
    if list.len(l87_queue(db_moving)?) != list.len(before) {
        fail("L87 (c): the drain takes no row its cut moved")
    }
    let moved_again = gate_walk_queue(d, db_moving)?
    if map.len(moved_again.places) != map.len(reached.places) {
        fail("L87 (c): the rows reach the same frames after the move")
    }
    close(take db_moving)?
    // With no probe, the drain consumes the queue.
    let mut draining = l87_options(floor, 65536)?
    draining.probe_budget = 0
    let mut db_drained = open(tasks, d, c, r, draining)?
    let mut rounds = 0u64
    while std.page.count(std.page.image_of(manifest.pack_lists(disk_state(db_drained).packs).deferred)) != 0 {
        if rounds == 16 {
            fail("L87 (c): the drain consumes every moved row")
        }
        let _ = checkpoint(mut db_drained)?
        rounds += 1
    }
    let _ = checkpoint(mut db_drained)?
    let mut left = std.omap.range(manifest.pack_locations(disk_state(db_drained).packs).packs.values, Unbounded, Unbounded)
    while let Some((_, pack)) = std.omap.next(mut left) {
        if (pack.class == 3 || pack.class == 4) && pack.live != 0 {
            fail("L87 (c): the drain files every moved frame dead")
        }
    }
    close(take db_drained)
}

// The walker over the queue rows alone: each Page row's tree and each Blob
// row, every stamp at one location in a listed pack on disk.
fn gate_walk_queue(d: Dir, db: Db) -> Result[CompactWalk, Error] waits {
    let mut walk = CompactWalk(live: map.new(), places: map.new())
    let queued = l87_queue(db)?
    for k in 0u64 .. list.len(queued) {
        let (_, row) = queued[k]
        match row.target {
            TieredPage(ptr) => compact_walk_frame(d, db, ptr, mut walk)?,
            TieredBlob(body) => compact_walk_blob(d, db, body, mut walk)?,
        }
    }
    for (seq, _) in walk.live {
        if !compact_listed(db, seq) || !disk_exists(d, failure_result_from_rep(manifest.paged_pack_path(seq))?)? {
            fail("L87 (c): every queue row reaches its frames in listed packs on disk")
        }
    }
    Ok(take walk)
}

@test
fn test_l87_queue_rows_move_as_roots(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_queue_rows(d, c, r, tasks, NoCrash)
}

@test
fn test_l87_queue_rows_move_as_roots_refused_cut(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_queue_rows(d, c, r, tasks, SealRefused)
}

@test
fn test_l87_queue_rows_move_as_roots_crash_before_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_queue_rows(d, c, r, tasks, BeforeRename)
}

@test
fn test_l87_queue_rows_move_as_roots_crash_after_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_queue_rows(d, c, r, tasks, AfterRename)
}

// AP16's redo after a refusal with relocation in the candidate keeps the
// staged Tiered steps (§13.6a T8, v2.114): the queue rows' rewrites ride with
// the retirements, so the published queue reaches only listed packs.
@test
fn test_l87_queue_rows_move_as_roots_retry_after_rename(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    gate_queue_rows(d, c, r, tasks, RetryAfterRename)
}

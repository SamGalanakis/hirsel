// kostya/LangArena 3c9f84d benchmarks/base64_{encode,decode}.rs.
fn encode(s: String) -> Result[String, helper.Error] {
    Ok(std.base64.encode_string(string.as_bytes(s)))
}

fn decode(s: String) -> Result[Bytes, helper.Error] {
    match std.base64.decode(string.as_bytes(s)) {
        Some(take decoded) => Ok(take decoded),
        None => Error(Config),
    }
}

fn prefix(mut message: String, s: String) -> Result[(), helper.Error] {
    if string.byte_len(s) > 4 {
        string.push(mut message, string.slice(s, 0, 4))
        string.push(mut message, "...")
    } else {
        string.push(mut message, s)
    }
    Ok(())
}

pub fn dispatch(config: helper.Settings, name: String, warmup: u64, iterations: u64) -> Result[u32, helper.Error] {
    let decoding = name == "Base64::Decode"
    if !decoding && name != "Base64::Encode" {
        return Error(UnknownTask)
    }
    let size = helper.config_i64(config, "size")?
    if size < 0 {
        return Error(Config)
    }
    let data = std.string.repeat("a", int.narrow(size))
    let mut encoded = encode(data)?
    let mut decoded = if decoding {
        decode(encoded)?
    } else {
        list.new()
    }
    let mut total: u32 = 0
    for _ in 0 .. warmup + iterations {
        if decoding {
            decoded = decode(encoded)?
            total = int.wrapping_add(total, int.truncate(list.len(decoded)))
        } else {
            encoded = encode(data)?
            total = int.wrapping_add(total, int.truncate(string.byte_len(encoded)))
        }
    }
    let mut message = string.from(if decoding {
        "decode "
    } else {
        "encode "
    })
    if decoding {
        prefix(mut message, encoded)?
    } else {
        prefix(mut message, data)?
    }
    string.push(mut message, " to ")
    if decoding {
        if list.len(decoded) < 4 {
            return Error(Config)
        }
        for at in 0u64 .. 4u64 {
            string.push_char(mut message, option.unwrap(char.from_u32(int.widen(decoded[at]))))
        }
        string.push(mut message, "...")
    } else {
        prefix(mut message, encoded)?
    }
    string.push(mut message, ": ")
    string.push_u64(mut message, int.widen(total))
    Ok(helper.checksum_str(message))
}

pub fn main(out: Stdout, d: Dir, argv: Args) -> Result[(), Exit] waits {
    harness.main(out, d, argv, fn(c: helper.Settings, n: String, w: u64, i: u64) -> Result[u32, helper.Error] {
        dispatch(c, n, w, i)
    })
}

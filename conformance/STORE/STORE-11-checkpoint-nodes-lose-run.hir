// rule: STORE-11
// expect: run
// authorities: {"l1":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":1,"crash_at":1}},"l10":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":10,"crash_at":10}},"l11":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":11,"crash_at":11}},"l12":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":12,"crash_at":12}},"l13":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":13,"crash_at":13}},"l14":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":14,"crash_at":14}},"l15":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":15,"crash_at":15}},"l16":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":16,"crash_at":16}},"l17":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":17,"crash_at":17}},"l18":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":18,"crash_at":18}},"l19":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":19,"crash_at":19}},"l2":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":2,"crash_at":2}},"l20":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":20,"crash_at":20}},"l21":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":21,"crash_at":21}},"l22":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":22,"crash_at":22}},"l23":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":23,"crash_at":23}},"l24":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":24,"crash_at":24}},"l25":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":25,"crash_at":25}},"l3":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":3,"crash_at":3}},"l4":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":4,"crash_at":4}},"l5":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":5,"crash_at":5}},"l6":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":6,"crash_at":6}},"l7":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":7,"crash_at":7}},"l8":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":8,"crash_at":8}},"l9":{"provider":"authority.sim@1","floor":"disk","seed":1,"represent":"log","levels":["disk"],"faults":{"lose_response_at":9,"crash_at":9}}}
// cuts: 1..=25
// steps: 20000000
// Checkpoints of several nodes (bounds 32 to 1024 bytes, mean 96) over a simulated log
// whose history is cut at an authority request; authority `lN` applies request N, loses its answer, then fails the power.
// The one level is disk and the floor, so an Ok commit is durable.
// The history is fixed: open a store; commit 1 puts 16 values of 16 bytes;
// compact, a tree of three levels; commit 3 rewrites one value and commit 4
// inserts five keys and deletes one mid-range, so the next compaction replaces
// the nodes over them and reuses the others; commit 6 deletes five keys and
// rewrites one; close.
// After each cut the store reopens holding exactly the model's rows after some
// step j, j at least the last step that returned Ok and at most the last that
// may have happened. The history then finishes from the step after j, its
// compactions putting nodes the cut one may already have put, and a reopen
// holds the model's end state. A cut between two node puts leaves nodes no
// record names, and recovery uses the checkpoint before them.
// The finished history's checkpoints say what it is for: two, the last of
// height 3 or more (an index under the root, each level under it split), the
// second replacing at least one of the first's nodes and reusing at least one.
// Every `lN` up to the history's last request stops the history there, and
// the one past it, the last declared cut, lets the history finish.
// Each run makes one cut, K, of the declared cuts; the last lets the
// history finish.
// stdout: checkpoints: 0

// The cut this case makes at each request.
const KIND: String = "l"

// Whether the cuts fall on a reopen after the history rather than in it.
const LOAD: bool = false

// A value of `len` bytes, each `fill`, built by doubling.
fn value(fill: u8, len: u64) -> Bytes {
  let mut out: List[u8] = [fill]
  while list.len(out) * 2 <= len {
    let half = bytes.from_list(copy out)
    bytes.append(mut out, half)
  }
  let have = list.len(out)
  if have < len {
    let head = bytes.from_list(copy out)
    bytes.append(mut out, bytes.slice(head, 0, len - have))
  }
  bytes.from_list(take out)
}

// Keys of 4 bytes, `m/NN`.
fn key(i: u8) -> Bytes {
  bytes.from_list([109u8, 47u8, 48u8 + i / 10, 48u8 + i % 10])
}

// One write of a step: the key, and the fill and length of its value, or a
// deletion when the length is 0.
type Write {
  key: Bytes,
  fill: u8,
  len: u64,
}

// The writes of step j; compactions (2 and 5) write nothing. Step 3 rewrites
// one value and step 4 inserts and deletes keys mid-range, so the compaction
// after them replaces the leaves they touch, some boundaries moved, and reuses
// the rest; step 6 deletes a run.
fn writes(j: u8) -> List[Write] {
  let mut w: List[Write] = []
  if j == 1 {
    for i in 0u8..32u8 {
      if i % 2 == 0 {
        list.push(mut w, Write(key: key(i), fill: i, len: 16))
      }
    }
  } else if j == 3 {
    list.push(mut w, Write(key: key(16), fill: 200, len: 16))
  } else if j == 4 {
    for i in 9u8..18u8 {
      if i % 2 == 1 {
        list.push(mut w, Write(key: key(i), fill: 100 + i, len: 11))
      }
    }
    list.push(mut w, Write(key: key(26), fill: 0, len: 0))
  } else if j == 6 {
    for i in 20u8..30u8 {
      list.push(mut w, Write(key: key(i), fill: 0, len: 0))
    }
    list.push(mut w, Write(key: key(0), fill: 7, len: 3))
  }
  w
}

fn compaction(j: u8) -> bool {
  j == 2 || j == 5
}

const STEPS: u8 = 6

fn step(mut tx: store.Tx, info: store.CallInfo, j: u8) -> Result[u8, store.TxError] {
  for w in writes(j) {
    if w.len == 0 {
      store.tx_delete(mut tx, copy w.key)?
    } else {
      store.tx_put(mut tx, copy w.key, value(w.fill, w.len))?
    }
  }
  Ok(j)
}

// Limits under the defaults, so checkpoint nodes of 32 to 1024 bytes fit
// them: 16 entries of 4-byte keys and 16-byte values make a tree of three
// levels at a mean of 96 bytes a node, where the default bounds hold them in
// one leaf.
fn config() -> store.StoreConfig {
  let mut c = store.default_config()
  c.limits.key_bytes = 8
  c.limits.value_bytes = 16
  c.limits.transaction_bytes = 4096
  c.nodes = history.Bounds(node_min: 32, node_mean: 96, node_max: 1024)
  c
}

// One checkpoint record of the history: its tree's height and how many nodes
// the record created and retired.
type Made {
  height: u8,
  created: u64,
  retired: u64,
}

// The checkpoint records of `a`'s history, oldest first. The run's one cut
// may fall on the first read, so a refused read is tried again.
fn checkpoints(a: Authority) -> List[Made] {
  let records = match authority.read(a, 1, authority.floor(a), 4096) {
    Ok(r) => r,
    Error(_) => {
      let Ok(r) = authority.read(a, 1, authority.floor(a), 4096) else {
        return []
      }
      r
    },
  }
  let mut made: List[Made] = []
  for r in records {
    if let Appended(entry, created, retired) = r {
      if let Ok(g) = history.decode_group(entry) {
        for c in g.commits {
          if let Engine(Checkpoint(d)) = c.body {
            list.push(
              mut made,
              Made(
                height: d.height,
                created: list.len(created),
                retired: list.len(retired)
              )
            )
          }
        }
      }
    }
  }
  made
}

// The finished history's two checkpoints: the last of height 3 or more, and
// the second replacing at least one of the first's nodes and reusing at least
// one.
fn trees(a: Authority) -> Result[(), Failed] {
  let made = checkpoints(a)
  check(
    list.len(made) == 2,
    f"{list.len(made)} checkpoint records, not the two compactions'"
  )?
  let first = made[0]
  let second = made[1]
  check(
    second.height >= 3,
    f"the last checkpoint has height {second.height}, not three levels"
  )?
  check(
    second.created >= 1 && second.retired >= 1 && second.retired < first.created,
    f"the second checkpoint creates {second.created} nodes and retires {second.retired} of the first's {first.created}: it does not both replace and reuse"
  )
}

pub type Failed = Check(String) | Store(store.StoreError)

fn check(ok: bool, take what: String) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check(what))
  }
}

// Every user row of the store's state at its floor.
fn rows(a: Authority, mut s: store.Store) -> Result[List[(Bytes, Bytes)], Failed] {
  let snap = store.snapshot(a, mut s, authority.floor(a)) ? Store
  let mut user: List[(Bytes, Bytes)] = []
  for (k, v) in store.range(snap, Unbounded(), Unbounded(), Ascending(), 100) {
    if !store.reserved(k) {
      list.push(mut user, (copy k, copy v))
    }
  }
  Ok(user)
}

// The model's rows after every step, 0 to STEPS, worked out once, after the
// history: a fault injected in it costs only the checks after it.
type Models = List[List[(Bytes, Bytes)]]

fn models() -> Models {
  // Step j's keys are step j-1's with step j's writes merged in key order.
  let mut all: Models = []
  let mut m: List[Write] = []
  for j in 0u8..STEPS + 1 {
    for w in writes(j) {
      let mut next: List[Write] = []
      let mut placed = false
      for old in m {
        if !placed && w.key <= old.key {
          if w.len > 0 {
            list.push(mut next, copy w)
          }
          placed = true
          if w.key != old.key {
            list.push(mut next, copy old)
          }
        } else {
          list.push(mut next, copy old)
        }
      }
      if !placed && w.len > 0 {
        list.push(mut next, copy w)
      }
      m = take next
    }
    let mut r: List[(Bytes, Bytes)] = []
    for w in m {
      list.push(mut r, (copy w.key, value(w.fill, w.len)))
    }
    list.push(mut all, take r)
  }
  all
}

// Whether the rows are the model's after step j.
fn holds(m: Models, r: List[(Bytes, Bytes)], j: u8) -> bool {
  let at: u64 = int.widen(j)
  r == m[at]
}

// The step whose model the rows are, the commit when a compaction after it
// shares its model, so finishing from there compacts again over the nodes
// already put; 255 when they are no step's.
fn which(m: Models, r: List[(Bytes, Bytes)]) -> u8 {
  for j in 0u8..STEPS + 1 {
    if holds(m, r, j) {
      return j
    }
  }
  255
}

// What the history learned: `low`, the last step an Ok covered (the floor is
// the one level, so an Ok commit is durable), and `high`, the last step that
// may have happened.
type Known {
  low: u8,
  high: u8,
  finished: bool,
}

// Runs steps from `first` on, stopping at the first failure.
fn steps_from(mut s: store.Store, mut k: Known, first: u8) -> bool {
  for j in first..STEPS + 1 {
    if compaction(j) {
      if store.compact(mut s) != Ok(()) {
        return false
      }
      k.low = j
      k.high = j
    } else {
      let r: Result[u8, store.TxFailure[store.TxError]] = store.transact(mut s, step, j)
      match r {
        Ok(_) => {
          k.low = j
          k.high = j
        },
        Error(Unknown(_)) => {
          k.high = j
          return false
        },
        _ => return false,
      }
    }
  }
  true
}

// The fixed history.
fn history(a: Authority, mut k: Known) -> () {
  let Ok(opened) = store.open(a, config()) else {
    return ()
  }
  let mut s = take opened
  if !steps_from(mut s, mut k, 1) {
    return ()
  }
  if store.close(take s) == Ok(()) {
    k.finished = true
  }
}

fn reopen(a: Authority, name: String, what: String) -> Result[store.Store, Failed] {
  match store.open(a, config()) {
    Ok(s) => Ok(s),
    Error(_) => Error(Check(f"{name}: {what} refused")),
  }
}

// Recovers the store a cut history left and checks it against `k`, then
// finishes the history from the recovered step and checks the end state.
fn recover(m: Models, a: Authority, name: String, k: Known) -> Result[(), Failed] {
  let mut s = reopen(a, name, "reopen")?
  let seen = rows(a, mut s)?
  let j = which(m, seen)
  check(
    j != 255,
    f"{name}: {list.len(seen)} rows, no step's state, history {k.low}..{k.high}"
  )?
  // Rows that are a compaction's state are also its commit's.
  let low = if compaction(k.low) {
    k.low - 1
  } else {
    k.low
  }
  check(
    low <= j && j <= k.high,
    f"{name}: recovered step {j} outside {k.low}..{k.high}"
  )?
  let mut rest = Known(low: j, high: j, finished: false)
  check(steps_from(mut s, mut rest, j + 1), f"{name}: finishing from step {j} failed")?
  store.close(take s) ? Store
  let mut last = reopen(a, name, "last reopen")?
  let end = rows(a, mut last)?
  check(
    holds(m, end, STEPS),
    f"{name}: finished from step {j}, {list.len(end)} rows, not the end state"
  )?
  Ok(())
}

// Reopens a finished history whose cut falls on the reopen: the cut refuses
// the open, and the next open holds the end state.
fn load(m: Models, a: Authority, name: String) -> Result[(), Failed] {
  if let Ok(opened) = store.open(a, config()) {
    let _ = store.close(take opened)
    return Error(
      Check(f"{name}: the cut reopen was not refused: the cut is past its reads")
    )
  }
  let mut last = reopen(a, name, "reopen after the cut")?
  let end = rows(a, mut last)?
  check(
    holds(m, end, STEPS),
    f"{name}: reopen after the cut, {list.len(end)} rows, not the end state"
  )?
  Ok(())
}

// Argument i of the run: the corpus driver runs the case once per declared cut
// K, with the arguments K and the last declared cut.
fn cut_arg(args: Args, i: u64) -> Result[u64, Failed] {
  match arg.text(args, i) {
    Ok(text) => match u64.parse(text) {
      Ok(k) => Ok(k),
      Error(_) => Error(Check(f"argument {i} is not a cut")),
    },
    Error(_) => Error(
      Check(f"argument {i} is missing: the corpus driver runs each cut")
    ),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Check("stdout"))
  }
  let r = run(rt, stdout, args)
  if let Error(Check(what)) = r {
    let _ = out.print(stdout, f"{what}\n")
  }
  r
}

fn run(rt: Io, stdout: Stdout, args: Args) -> Result[(), Failed] {
  let n = cut_arg(args, 0)?
  let end = cut_arg(args, 1)?
  let name = f"{KIND}{n}"
  let Ok(a) = io.authority(rt, name) else {
    return Error(Check(f"{name} not granted"))
  }
  let mut cut = Known(low: 0, high: 0, finished: false)
  history(a, mut cut)
  let m = models()
  let mut failures: u64 = 0
  if LOAD {
    // The cut falls on the reopen's reads, level by level down the tree.
    check(cut.finished, f"{name} cut the history: the load cuts start too early")?
    if let Error(e) = load(m, a, name) {
      failures += 1
      let line = match e {
        Check(what) => what,
        Store(_) => f"{name}: store error",
      }
      let _ = out.print(stdout, f"{line}\n")
    }
    if n == end {
      trees(a)?
    }
  } else if n == end {
    // Every cut stops the history at its request, so the one past its end
    // lets it finish.
    check(cut.finished, f"{name} stopped the history: it is longer than its cuts")?
    trees(a)?
  } else {
    check(!cut.finished, f"{name} let the history finish: it is shorter than its cuts")?
    if let Error(e) = recover(m, a, name, cut) {
      failures += 1
      let line = match e {
        Check(what) => what,
        Store(_) => f"{name}: store error",
      }
      let _ = out.print(stdout, f"{line}\n")
    }
  }
  let _ = out.print(stdout, f"checkpoints: {failures}\n")
  Ok(())
}

// OWN-9: a by-value scalar argument is read into a temporary before places are compared,
// so `f(mut t, t.root)` is accepted and the callee sees the value read before it ran.
type Tree {
    root: u64,
    items: List[u64]
}

fn set_root(mut t: Tree, old: u64) -> u64 {
    t.root = 9u64;
    old
}

pub fn scalar_read_first() -> u64 {
    let mut t = Tree(root: 4u64, items: list.new())
    let old = set_root(mut t, t.root)
    old * 10u64 + t.root
}

// expect: run scalar_read_first() = 49

// The host stream's settle (STORE-SPEC §12.11.6 rule a, §12.11.11) and stall
// head poll (§12.11.4, §12.11.12). One mechanism runs both an unhold settle
// (keeping ATTACH and raising `settles`) and a close settle (dropping ATTACH
// on its last head write).
pub type SettleOutcome = SettleApplied | SettleFenced(u64, Option[u64]) | SettleNotApplied

// Finds the sealed cutoff for (sid, inc) in `attach` (§12.11.4 "The second
// authority: a sealed cutoff"). None is A3's missing evidence.
pub fn stream_find_sealed_cutoff(attach: Option[format.Attach], sid: types.HostStreamIdRep, inc: u64) -> Option[u64] {
    let Some(a) = view attach else {
        return None
    }
    for st in a.sealed {
        if format.stream_same(st.tail.sid, sid) && st.tail.inc == inc {
            return Some(st.cutoff)
        }
    }
    None
}

// Builds `Attach` for a settle step: `live.from` moved to `(from_seq, from_frame)`
// and `settles` raised by 1 (M1, M4).
pub fn stream_settle_attach(base: format.Attach, sid: types.HostStreamIdRep, inc: u64, from_seq: u64, from_frame: u32) -> Result[format.Attach, types.Failure] {
    let sealed = manifest.disk_allocation(scoped fn() -> Result[List[format.SealedTail], types.Failure] {
        Ok(clone(base.sealed))
    })?
    Ok(format.Attach(settles: base.settles + 1, live: Some(format.StreamRef(sid: sid, inc, from_seq, from_frame)), sealed: take sealed))
}

// A worker's settlement state. Slot metadata is copied, and the batch
// list and root move temporarily out of the link. The link retains its queues.
pub opaque type SettleView {
    client: std.object.Client,
    register: history.HistoryRegister,
    authority: Bytes,
    buffers: history.HistoryBuffers,
    archive_on: u64,
    op_ms: u64,
    slot: Option[(types.HostStreamIdRep, u64)],
    root: String,
    last_acked: u64,
    known_batches: List[u64],
    cursor_seq: u64,
    cursor_frame: u32
}

pub fn settle_view(take client: std.object.Client, take register: history.HistoryRegister, take authority: Bytes, take buffers: history.HistoryBuffers, archive_on: u64, op_ms: u64, mut stream: Option[SlotLink]) -> SettleView {
    let (slot, take root, last_acked, take known_batches) = match stream {
        Some(mut link) => (Some((link.sid, link.inc)), replace(mut link.root, string.new()), link.last_batch_seq, replace(mut link.commit_batches, list.new())),
        None => (None, string.new(), 0u64, list.new()),
    }
    SettleView(client: take client, register: take register, authority: take authority, buffers: take buffers, archive_on, op_ms, slot, root: take root, last_acked, known_batches: take known_batches, cursor_seq: 0, cursor_frame: 0)
}

pub fn return_settle_view(take settled: SettleView, mut stream: Option[SlotLink]) -> (std.object.Client, history.HistoryRegister, Bytes, history.HistoryBuffers) {
    let SettleView(client: take client, register: take register, authority: take authority, buffers: take buffers, root: take root, known_batches: take batches, ..) = take settled
    if let Some(mut link) = stream {
        link.root = take root
        link.commit_batches = take batches
    }
    (take client, take register, take authority, take buffers)
}

pub fn stream_settle_sealed(mut lane: SettleView, group_bytes: u64, group_commits: u64) -> Result[SettleOutcome, types.Failure] waits {
    if let None = lane.slot {
        return Ok(SettleApplied)
    }
    stream_settle_sealed_core(mut lane.client, mut lane.register, lane.authority, mut lane.buffers, lane.root, lane.op_ms, group_bytes, group_commits)
}

// Polls X's head during a stall (§12.11.4): returns `Some((moved_epoch, cutoff))`
// when a claimant's H raised the epoch above ours.
pub fn stream_poll_head(mut lane: SettleView) -> Result[Option[(u64, Option[u64])], types.Failure] waits {
    let (sid, inc) = match lane.slot {
        Some((sid, inc)) => (sid, inc),
        None => return Ok(None),
    }
    let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
    let _ = history.history_fetch(mut lane.client, "head", mut lane.buffers.witness, due)?
    let (take capture, take attach) = history.history_decode_head_attach(lane.buffers.witness)?
    if capture.head.pair.epoch > history.register_head(lane.register).pair.epoch {
        return Ok(Some((capture.head.pair.epoch, stream_find_sealed_cutoff(attach, sid, inc))))
    }
    Ok(None)
}

// Publishes one settle head write, with or without a new GROUP entry in
// `lane.buffers.packet` (`has_entry`). Updates `lane.register` only on Applied.
fn stream_settle_publish(mut lane: SettleView, sid: types.HostStreamIdRep, inc: u64, has_entry: bool, take next_attach: Option[format.Attach], drop_attach: bool, deadline: u64) -> Result[SettleOutcome, types.Failure] waits {
    let mut candidate = history.register_head(lane.register)
    if has_entry {
        let next_pos = history.history_next_id(candidate.entry.seq)?
        candidate.entry = history.history_new_ref(next_pos, candidate.pair.epoch, lane.buffers.packet)
        pager.history_fill_key(mut lane.buffers.key, "e-", candidate.entry)
        list.clear(mut lane.buffers.compare)
        types.capacity(list.try_reserve(mut lane.buffers.compare, list.len(lane.buffers.packet)))?
        history.history_create(mut lane.client, lane.buffers.key, mut lane.buffers.packet, mut lane.buffers.compare, deadline)?
    }
    let written = history.publish_register_head(mut lane.client, mut lane.register, candidate, lane.authority, take next_attach, mut lane.buffers, deadline)?
    match take written {
        HistoryApplied(_) => Ok(SettleApplied),
        HistoryConflict(_) => {
            let (take moved, take moved_attach) = history.history_decode_head_attach(lane.buffers.witness)?
            if moved.head.pair.epoch > history.register_head(lane.register).pair.epoch {
                return Ok(SettleFenced(moved.head.pair.epoch, stream_find_sealed_cutoff(moved_attach, sid, inc)))
            }
            Ok(SettleNotApplied)
        },
        HistoryRefused(take problem) => if drop_attach {
            Error(Remote(take problem))
        } else {
            Ok(SettleNotApplied)
        },
        HistoryUndecided => if drop_attach {
            Error(Undecided)
        } else {
            Ok(SettleNotApplied)
        },
    }
}

// Writes GROUP entries carrying X's live tail from `live.from` through
// `through_seq` (inclusive), advancing `live.from` past each entry's frames
// and raising `settles` by 1 (§12.11.6 rule a, §12.11.11). On an unhold settle
// (`drop_attach == false`), the final head write keeps ATTACH with
// `live.from = (max(next_seq, live.from_seq), 0)`. On a close settle
// (`drop_attach == true`), the final head write drops ATTACH.
pub fn stream_settle(mut lane: SettleView, through_seq: u64, next_seq: u64, drop_attach: bool, group_bytes: u64, group_commits: u64) -> Result[SettleOutcome, types.Failure] waits {
    // Under archival (§12.11.11 M6), no entry is written above `sealed[0].at`
    // until all sealed tails are rewritten in order via the sealed cursor.
    if lane.archive_on != 0 {
        let has_sealed = match history.register_attach(lane.register) {
            Some(a) => list.len(a.sealed) != 0,
            None => false,
        }
        if has_sealed {
            match stream_settle_sealed(mut lane, group_bytes, group_commits)? {
                SettleApplied => (),
                other => return Ok(other),
            }
        }
    }
    if let None = lane.slot {
        return Ok(SettleApplied)
    }
    let last_acked = lane.last_acked
    let live_tail = match history.register_attach(lane.register) {
        Some(attach_now) => match attach_now.live {
            Some(r) => r,
            None => return Ok(SettleApplied),
        },
        None => return Ok(SettleApplied),
    }
    let sid = live_tail.sid
    let inc = live_tail.inc
    let head = history.register_head(lane.register)
    let store = head.store
    let epoch = head.pair.epoch
    let dir = stream_key(lane.root, stream_dir(sid))
    // Build the exact ascending list of batch seqs to inspect: known acked
    // commit batches of this Place in `[live_tail.from_seq, through_seq]`, plus
    // any unacked (stalled) batches in `(last_acked, through_seq]`.
    let mut seqs: List[u64] = list.new()
    for bseq in lane.known_batches {
        if bseq >= live_tail.from_seq && bseq <= through_seq {
            types.capacity(list.try_reserve(mut seqs, 1))?
            list.push(mut seqs, bseq)
        }
    }
    if !drop_attach {
        let tail_start = order.max(live_tail.from_seq, last_acked + 1)
        let mut s = tail_start
        while s <= through_seq {
            types.capacity(list.try_reserve(mut seqs, 1))?
            list.push(mut seqs, s)
            s += 1
        }
    }
    let mut buffers = stream_tail_buffers()?
    let mut entry_frames = 0u64
    let mut entry_bytes = 0u64
    lane.cursor_seq = live_tail.from_seq
    lane.cursor_frame = live_tail.from_frame
    for seq in seqs {
        let due = std.object.deadline_after_ms(lane.client, lane.op_ms)
        let mut name = string.with_capacity(48)
        format.stream_batch_key(mut name, inc, seq)
        let key = stream_key(dir, name)
        let fetched = stream_at_root(mut lane.client, scoped fn(mut c: std.object.Client) -> Result[Option[format.BatchRow], types.Failure] waits {
            if let None = stream_tail_range(mut c, key, 0, format.STREAM_INDEX_PROBE, mut buffers.index, due)? {
                return Ok(None)
            }
            let mut batch_index = match manifest.stream_batch_head(key, buffers.index, sid, inc, seq)? {
                Rows(take found) => take found,
                Term(_, _) => return Error(Latched(Superseded)),
            }
            if list.len(buffers.index) < batch_index.byte_len {
                if let None = stream_tail_range(mut c, key, 0, batch_index.byte_len, mut buffers.index, due)? {
                    return Error(format.disk_fault(key, 0, Absent))
                }
                batch_index = match manifest.stream_batch_head(key, buffers.index, sid, inc, seq)? {
                    Rows(take found) => take found,
                    Term(_, _) => return Error(format.disk_fault(key, 72, Malformed)),
                }
            }
            for row in batch_index.rows {
                if types.same(row.store.hi, row.store.lo, store.hi, store.lo) && row.epoch == epoch {
                    if row.len == 0 {
                        return Error(format.disk_fault(key, row.offset, Malformed))
                    }
                    if let None = stream_tail_range(mut c, key, row.offset, row.offset + row.len, mut buffers.slice, due)? {
                        return Error(format.disk_fault(key, row.offset, Absent))
                    }
                    format.stream_slice_check(key, row, buffers.slice)?
                    return Ok(Some(row))
                }
            }
            Ok(None)
        })?
        if let Some(row) = fetched {
            let skip: u64 = if seq == live_tail.from_seq {
                int.widen(live_tail.from_frame)
            } else {
                0
            }
            let batch_ctx = format.DiskContext(store: store, role: format.ROLE_BATCH, seq)
            let mut at = 0u64
            let mut fidx = 0u64
            while at < list.len(buffers.slice) {
                let frame = manifest.disk_frame_bytes(key, batch_ctx, buffers.slice, at)?
                if fidx >= skip {
                    if frame.kind == 0x0040 {
                        if frame.end - frame.payload != 24 || format.read_le(buffers.slice, frame.payload, 8) != epoch {
                            return Error(format.disk_fault(key, row.offset + at, Malformed))
                        }
                    } else if frame.kind == 0x0011 || frame.kind == 0x0013 {
                        let width = frame.end - at
                        if entry_frames > 0 && entry_bytes + width > group_bytes {
                            let step_attach = match history.register_attach(lane.register) {
                                Some(cur_attach) => stream_settle_attach(cur_attach, sid, inc, lane.cursor_seq, lane.cursor_frame)?,
                                None => return Ok(SettleNotApplied),
                            }
                            let pub_due = std.object.deadline_after_ms(lane.client, lane.op_ms)
                            match stream_settle_publish(mut lane, sid, inc, true, Some(take step_attach), drop_attach, pub_due)? {
                                SettleApplied => (),
                                other => return Ok(other),
                            }
                            entry_frames = 0
                            entry_bytes = 0
                        }
                        if entry_frames == 0 {
                            let group_ctx = history_group_context(history.register_head(lane.register))?
                            history.history_packet_header(mut lane.buffers.packet, group_ctx, history.register_head(lane.register).pair.epoch, history.register_head(lane.register).authority_kind, history.register_head(lane.register).entry)?
                        }
                        let group_ctx = history_group_context(history.register_head(lane.register))?
                        let frame_bytes = list.slice(buffers.slice, at, frame.end)
                        types.capacity(list.try_reserve(mut lane.buffers.packet, list.len(frame_bytes) + format.BINDING_BYTES))?
                        history_group_append(mut lane.buffers.packet, group_ctx, frame_bytes)?
                        entry_frames += 1
                        entry_bytes += width
                        if fidx + 1 < row.frames {
                            lane.cursor_seq = seq
                            lane.cursor_frame = int.narrow(fidx + 1)
                        } else {
                            lane.cursor_seq = seq + 1
                            lane.cursor_frame = 0
                        }
                    } else {
                        return Error(format.disk_fault(key, row.offset + at, Kind(int.widen(frame.kind))))
                    }
                }
                fidx += 1
                at = frame.end
            }
            if fidx != row.frames {
                return Error(format.disk_fault(key, row.offset, Malformed))
            }
        }
    }
    let final_attach: Option[format.Attach] = if drop_attach {
        None
    } else {
        let final_seq = order.max(next_seq, order.max(live_tail.from_seq, lane.cursor_seq))
        match history.register_attach(lane.register) {
            Some(cur_attach) => Some(stream_settle_attach(cur_attach, sid, inc, final_seq, 0)?),
            None => return Ok(SettleNotApplied),
        }
    }
    let pub_due = std.object.deadline_after_ms(lane.client, lane.op_ms)
    stream_settle_publish(mut lane, sid, inc, entry_frames > 0, take final_attach, drop_attach, pub_due)
}

// RTC-5's control order and RTC-7's fence: the fence table, the tag check, and what
// a revoke, a suspend and a close (RTC-10) do on a unit.
// ---- RTC-7: the fence table and the tag check ----
fn entry_of(r: Router, ri: u64, id: u64) -> Option[u64] {
    for i in 0u64 .. list.len(r.rooms[ri].ids) {
        if r.rooms[ri].ids[i] == id {
            return Some(i)
        }
    }
    None
}

/// Whether generation `g` of a participant of `room` is at or below its fence.
pub fn fenced(r: Router, room: peer.RoomId, g: peer.Gen) -> bool {
    let Some(ri) = room_at(r, room) else {
        return false
    }
    fenced_at(r, ri, g)
}

fn fenced_at(r: Router, ri: u64, g: peer.Gen) -> bool {
    let Gen(id: id, epoch: epoch) = g
    let Some(e) = entry_of(r, ri, id) else {
        return false
    }
    match r.rooms[ri].fenced[e] {
        Some(f) => epoch <= f,
        None => false,
    }
}

/// Whether `room` is suspended on this router (RTC-7 `Suspend`).
pub fn suspended(r: Router, room: peer.RoomId) -> bool {
    match room_at(r, room) {
        Some(ri) => r.rooms[ri].causes != 0,
        None => false,
    }
}

/// Whether this unit still has the room open.
pub fn room_open(r: Router, room: peer.RoomId) -> bool {
    room_at(r, room) != None
}

/// Stale messages or builds for an open room. After close, late drops still
/// contribute to Counts.stale and no room record is retained for them.
pub fn room_stale(r: Router, room: peer.RoomId) -> Option[u64] {
    let ri = room_at(r, room)?
    Some(r.rooms[ri].stale)
}

/// Check room identity before allocating a session for a queued build.
pub fn take_build(mut r: Router, room: peer.RoomId) -> bool {
    if room_open(r, room) {
        return true
    }
    count_stale(mut r, None)
    false
}

/// Count a media message of `room` dropped because the inbox, or the room's share
/// of it, was full. A room this unit does not have open has no count.
pub fn count_full(mut r: Router, room: peer.RoomId) {
    if let Some(ri) = room_at(r, room) {
        r.rooms[ri].full += 1
    }
}

pub fn room_full(r: Router, room: peer.RoomId) -> Option[u64] {
    let ri = room_at(r, room)?
    Some(r.rooms[ri].full)
}

/// The room a change names: every change names exactly one.
pub fn change_room(c: Change) -> peer.RoomId {
    match c {
        Open(room: room, ..) => room,
        Close(room: room) => room,
        Admit(who: who, ..) => who.room,
        Publish(room: room, ..) => room,
        Subscribe(room: room, ..) => room,
        Retarget(room: room, ..) => room,
        Rebind(room: room, ..) => room,
        Unsubscribe(room: room, ..) => room,
        Leave(room: room, ..) => room,
        Revoke(room: room, ..) => room,
        Suspend(room: room, ..) => room,
        Playout(room: room, ..) => room,
    }
}

/// Whether a change is a fence (RTC-10, Revokes first): it is admitted before its
/// room's other pending changes and takes no slot of the `inflight` window.
pub fn fencing(c: Change) -> bool {
    match c {
        Revoke(room: _, ..) => true,
        Suspend(room: _, ..) => true,
        Close(room: _) => true,
        _ => false,
    }
}

fn count_stale(mut r: Router, ri: Option[u64]) {
    r.counts.stale += 1
    if let Some(i) = ri {
        r.rooms[i].stale += 1
    }
}

/// Drop a queue entry for a closed room, a fenced generation, or suspended media.
pub fn dead(r: Router, t: peer.Tag) -> bool {
    let Some(ri) = room_at(r, t.room) else {
        return true
    }
    if fenced_at(r, ri, t.dst) {
        return true
    }
    match t.src {
        Some(g) => fenced_at(r, ri, g) || r.rooms[ri].causes != 0,
        None => false,
    }
}

/// Remove every entry of `out` that `dead` names (RTC-7 step 2, and the send step's
/// recheck). The bytes stay where they are; only the entries go. It answers how many
/// went.
pub fn purge(r: Router, mut out: peer.Outbox) -> u64 {
    let n = list.len(out.pkts)
    let mut kept = 0u64
    for i in 0u64 .. n {
        if !dead(r, out.tags[i]) {
            if kept != i {
                out.pkts[kept] = out.pkts[i]
                out.tags[kept] = out.tags[i]
            }
            kept += 1
        }
    }
    list.truncate(mut out.pkts, kept)
    list.truncate(mut out.tags, kept)
    n - kept
}

/// CAS-5: Set or clear a room's lease deadline (ms on the shared lease clock) and
/// `guard_ms` on this media unit. Checked where media leaves, regardless of the control unit.
pub fn set_lease_deadline(mut r: Router, room: peer.RoomId, deadline_ms: Option[u64], guard_ms: u32) {
    if let Some(ri) = room_at(r, room) {
        r.rooms[ri].lease_deadline_ms = deadline_ms
        r.rooms[ri].lease_guard_ms = guard_ms
    }
}

/// Whether a queued entry's room lease has passed `deadline_ms - guard_ms` at `now_ms`.
pub fn lease_expired(r: Router, t: peer.Tag, now_ms: u64) -> bool {
    if t.src == None {
        return false
    }
    let Some(ri) = room_at(r, t.room) else {
        return true
    }
    match r.rooms[ri].lease_deadline_ms {
        Some(dl) => {
            let guard: u64 = int.widen(r.rooms[ri].lease_guard_ms)
            int.saturating_add(now_ms, guard) > dl
        },
        None => false,
    }
}

/// CAS-5: Purge both fenced/suspended entries and media entries whose room lease
/// cannot cover `guard_ms` at `now_ms` right before `udp_send`.
pub fn purge_at(r: Router, now_ms: u64, mut out: peer.Outbox) -> u64 {
    let n = list.len(out.pkts)
    let mut kept = 0u64
    for i in 0u64 .. n {
        if !dead(r, out.tags[i]) && !lease_expired(r, out.tags[i], now_ms) {
            if kept != i {
                out.pkts[kept] = out.pkts[i]
                out.tags[kept] = out.tags[i]
            }
            kept += 1
        }
    }
    list.truncate(mut out.pkts, kept)
    list.truncate(mut out.tags, kept)
    n - kept
}

// ---- The control order ----
/// The unit that applies `c` first: the home of the session it touches. A change
/// that touches no session goes first to this unit.
pub fn first(r: Router, c: Change) -> u16 {
    let (room, who) = match c {
        Admit(who: _, home: h) => return h,
        Publish(room: room, who: w, ..) => (room, w),
        Subscribe(room: room, who: w, ..) => (room, w),
        Retarget(room: room, who: w, ..) => (room, w),
        Rebind(room: room, who: w, ..) => (room, w),
        Unsubscribe(room: room, who: w, ..) => (room, w),
        Leave(room: room, who: w) => (room, w),
        Playout(room: room, who: w, ..) => (room, w),
        _ => return r.unit,
    }
    match seat_at(r, room, who) {
        Some(si) => r.roster[si].home,
        None => r.unit,
    }
}

/// Make the receiving section `section` of `who`'s session a publication.
pub fn publish(mut r: Router, room: peer.RoomId, who: peer.Gen, section: u8) -> Result[PublicationId, RouterError] {
    let id = PublicationId(r.next_publication)
    let _ = add_publication(mut r, room, who, section, id, None, None)?
    r.next_publication += 1
    Ok(id)
}

/// The next publication id the control unit hands out.
pub fn next_publication(mut r: Router) -> PublicationId {
    let id = PublicationId(r.next_publication)
    r.next_publication += 1
    id
}

/// Apply one change of the control order to this unit. The first unit checks it
/// in full; once it answers `Ok`, every other unit applies the same change, with a
/// publication's `Shape` taken from the first unit's answer.
pub fn apply(mut r: Router, now: u64, take c: Change, mut out: peer.Outbox) -> Result[Answer, RouterError] {
    apply_with_fmtp(mut r, now, take c, None, mut out)
}

/// Apply an order that can carry Opus parameters from the publication's home unit.
pub fn apply_with_fmtp(mut r: Router, now: u64, take c: Change, fmtp: Option[Shared[Bytes]], mut out: peer.Outbox) -> Result[Answer, RouterError] {
    let answer = change(mut r, now, take c, fmtp, mut out)
    // RTC-6 follows every change: allocations, the audio gate and the local masks.
    let _ = rebalance(mut r, now, mut out)
    answer
}

fn change(mut r: Router, now: u64, take c: Change, fmtp: Option[Shared[Bytes]], mut out: peer.Outbox) -> Result[Answer, RouterError] {
    match take c {
        Open(room: room, limits: limits) => {
            open(mut r, room, limits)?
            Ok(Done)
        },
        Close(room: room) => {
            close_room(mut r, room, mut out)?
            Ok(Done)
        },
        // A refused admission drops the session its home unit parked for it, so a
        // refused or fenced join leaves nothing that answers its credentials.
        Admit(who: who, home: home) => {
            if let Error(e) = admit(mut r, who, home) {
                if home == r.unit {
                    unpark(mut r, who)
                }
                return Error(e)
            }
            Ok(Done)
        },
        Publish(room: room, who: who, section: section, id: id, shape: shape) => {
            let made = add_publication(mut r, room, who, section, id, shape, fmtp)?
            Ok(Shaped(id: id, shape: made))
        },
        Subscribe(room: room, who: who, p: p, section: section, target: target) => {
            add_down(mut r, room, who, p, section, target, now, mut out)?
            Ok(Done)
        },
        Retarget(room: room, who: who, p: p, target: target) => {
            retarget(mut r, room, who, p, target, now, mut out)?
            Ok(Done)
        },
        Rebind(room: room, who: who, from: from, to: to, target: target) => {
            move_down(mut r, room, who, from, to, target, now, mut out)?
            Ok(Done)
        },
        Unsubscribe(room: room, who: who, p: p) => {
            remove_down(mut r, room, who, p)?
            Ok(Done)
        },
        Leave(room: room, who: who) => {
            let Some(si) = seat_at(r, room, who) else {
                return Error(NoParticipant)
            }
            drop_seat(mut r, si, true, mut out)
            Ok(Done)
        },
        Revoke(room: room, id: id, epoch: epoch) => {
            fence(mut r, room, id, epoch, mut out)?
            Ok(Done)
        },
        Suspend(room: room, cause: cause, on: on) => {
            hold(mut r, room, cause_bit(cause), on, mut out)?
            Ok(Done)
        },
        Playout(room: room, who: who, p: p, delay: delay) => {
            playout(mut r, room, who, p, delay)?
            Ok(Done)
        },
    }
}

/// Opus parameters to carry with a successful first application of `c`.
pub fn published_opus_fmtp(r: Router, c: Change) -> Option[Shared[Bytes]] {
    if let Publish(room: room, who: _, section: _, id: id, shape: None) = c {
        let pi = publication_at(r, room, id)?
        if r.publications[pi].codec == Opus {
            return Some(shared.share(r.publications[pi].opus_fmtp))
        }
    }
    None
}

/// Fence and erase the room at this unit, including sessions awaiting admission.
pub fn close_room(mut r: Router, room: peer.RoomId, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Some(ri) = room_at(r, room) else {
        return Error(NoRoom)
    }
    let _ = list.remove(mut r.rooms, ri)
    list.retain(mut r.roster, scoped fn(s: Seat) -> bool {
        s.who.room != room
    })
    list.retain(mut r.members, scoped fn(m: Member) -> bool {
        m.who.room != room
    })
    list.retain(mut r.parked, scoped fn(m: Member) -> bool {
        m.who.room != room
    })
    list.retain(mut r.publications, scoped fn(p: Publication) -> bool {
        p.room != room
    })
    list.retain(mut r.downs, scoped fn(d: Down) -> bool {
        d.room != room
    })
    list.retain(mut r.rows, scoped fn(w: Row) -> bool {
        w.room != room
    })
    list.retain(mut r.posts, scoped fn(p: Post) -> bool {
        carry_room(p.carried.carry) != room
    })
    list.retain(mut r.notices, scoped fn(n: Notice) -> bool {
        match n {
            Layers(room: id, ..) => id != room,
            Speakers(room: id, ..) => id != room,
            Offer(who: who, ..) => who.room != room,
            Shut(who: who) => who.room != room,
            Fault(room: id, ..) => id != room,
        }
    })
    let _ = purge(r, mut out)
    Ok(())
}

// ---- Revoke and suspend on a unit ----
fn fence(mut r: Router, room: peer.RoomId, id: u64, epoch: u64, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Some(ri) = room_at(r, room) else {
        return Error(NoRoom)
    }
    let Some(e) = entry_of(r, ri, id) else {
        return Error(NoParticipant)
    }
    let raised = match r.rooms[ri].fenced[e] {
        Some(f) if f >= epoch => f,
        _ => epoch,
    }
    r.rooms[ri].fenced[e] = Some(raised)
    let barred: peer.Gen = Gen(id: id, epoch: raised)
    // Steps 1 and 3: the sessions at or below the fence close without notice, their
    // rows go, and every down-track of their publications and of their subscriptions ends.
    let mut i = 0u64
    while i < list.len(r.roster) {
        let Gen(id: sid, epoch: sep) = r.roster[i].who.gen
        if r.roster[i].who.room == room && sid == id && sep <= raised {
            drop_seat(mut r, i, false, mut out)
        } else {
            i += 1
        }
    }
    // Step 2: a down-track that stays, rebound away from the fenced publisher, drops
    // that publisher's paced entries when its pacer lets them out; and every entry of
    // `out` the fence covers goes.
    for m in 0u64 .. list.len(r.members) {
        if r.members[m].who.room == room {
            peer.bar(mut r.members[m].session, barred)
        }
    }
    let _ = purge(r, mut out)
    Ok(())
}

fn cause_bit(cause: Cause) -> u8 {
    match cause {
        Signaling => 1,
        Lease => 2,
        Term => 4,
    }
}

// A room's fault holds it as a suspension does, under a cause no `Suspend` names.
const FAULT: u8 = 8

/// Raise `room`'s fault on this unit, once (RTC-10 Isolation item 2): an error in the
/// room's shared state. The unit stops routing the room's media and repair as for a
/// suspension and purges its queued entries with a `src`, and the control unit is told
/// (`Notice.Fault`), whose adapter closes the room with the `Close` fence.
pub fn fault(mut r: Router, room: peer.RoomId, take e: RouterError, mut out: peer.Outbox) {
    let Some(ri) = room_at(r, room) else {
        return
    }
    if r.rooms[ri].causes & FAULT != 0 {
        return
    }
    let _ = hold(mut r, room, FAULT, true, mut out)
    list.push(mut r.notices, Fault(room: room, error: take e))
}

/// Whether `room` has faulted on this unit.
pub fn faulted(r: Router, room: peer.RoomId) -> bool {
    match room_at(r, room) {
        Some(ri) => r.rooms[ri].causes & FAULT != 0,
        None => false,
    }
}

// RTC-7 Suspend and resume: routing stops for the room, and every queued entry with
// a `src` goes from `out` and from the room's pacers. Ingress stays up.
fn hold(mut r: Router, room: peer.RoomId, bit: u8, on: bool, mut out: peer.Outbox) -> Result[(), RouterError] {
    let Some(ri) = room_at(r, room) else {
        return Error(NoRoom)
    }
    let before = r.rooms[ri].causes
    r.rooms[ri].causes = if on {
        before | bit
    } else {
        before & ~bit
    }
    if on && before == 0 {
        for d in 0u64 .. list.len(r.downs) {
            if r.downs[d].room != room || r.downs[d].home != r.unit {
                continue
            }
            if let Some(mi) = member_at(r, room, r.downs[d].sub) {
                peer.unpace(mut r.members[mi].session, r.downs[d].track)
            }
        }
        let _ = purge(r, mut out)
    }
    Ok(())
}

fn drop_seat(mut r: Router, si: u64, notify: bool, mut out: peer.Outbox) {
    let who = r.roster[si].who
    let mut i = 0u64
    while i < list.len(r.publications) {
        if r.publications[i].room == who.room && r.publications[i].owner == who.gen {
            let id = r.publications[i].id
            let mut d = 0u64
            while d < list.len(r.downs) {
                if r.downs[d].room == who.room && r.downs[d].publication == id {
                    end_down(mut r, d)
                } else {
                    d += 1
                }
            }
            for k in 0u64 .. list.len(r.downs) {
                if r.downs[k].room == who.room && r.downs[k].previous == Some(id) {
                    settle(mut r, k)
                }
            }
            let _ = list.remove(mut r.publications, i)
        } else {
            i += 1
        }
    }
    let mut d = 0u64
    while d < list.len(r.downs) {
        if r.downs[d].room == who.room && r.downs[d].sub == who.gen {
            end_down(mut r, d)
        } else {
            d += 1
        }
    }
    let mut w = 0u64
    while w < list.len(r.rows) {
        if r.rows[w].room == who.room && r.rows[w].who == who.gen {
            let _ = list.remove(mut r.rows, w)
        } else {
            w += 1
        }
    }
    let Some(s) = seat_at(r, who.room, who.gen) else {
        return
    }
    let _ = list.remove(mut r.roster, s)
    if let Some(mi) = member_at(r, who.room, who.gen) {
        let m = list.remove(mut r.members, mi)
        let Member(who: _, session: take session, ..) = take m
        peer.close(take session, notify, mut out)
    }
}

// RTC-5: a subscription's static playout delay, written by the down-track's home.
fn playout(mut r: Router, room: peer.RoomId, who: peer.Gen, p: PublicationId, delay: Option[peer.Delay]) -> Result[(), RouterError] {
    if let Some(d) = delay {
        if d.max > 4095 || d.min > d.max {
            return Error(Limit(4095))
        }
    }
    let Some(di) = down_at(r, room, who, p) else {
        return Error(NoPublication)
    }
    if r.downs[di].home != r.unit {
        return Ok(())
    }
    let Some(mi) = member_at(r, room, who) else {
        return Error(NoParticipant)
    }
    let track = r.downs[di].track
    let _ = peer.set_playout(mut r.members[mi].session, track, delay)
    Ok(())
}

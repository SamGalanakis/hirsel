fn record_migrate_source(mut plan: SchemaPlan, from_id: u32, to_id: u32) -> Result[(), Error] {
    let mut base_source = from_id
    let mut found: Option[u64] = None
    for i in 0u64 .. list.len(plan.migrate_sources) {
        if plan.migrate_sources[i].target == from_id {
            base_source = plan.migrate_sources[i].source
            found = Some(i)
            break
        }
    }
    if let Some(at) = found {
        let mut kept: List[transfer.MigrateSource] = list.with_capacity(list.len(plan.migrate_sources))
        for i in 0u64 .. list.len(plan.migrate_sources) {
            if i != at {
                list.push(mut kept, plan.migrate_sources[i])
            }
        }
        plan.migrate_sources = take kept
    }
    failure_result_from_rep(types.capacity(list.try_reserve(mut plan.migrate_sources, 1)))?
    list.push(mut plan.migrate_sources, transfer.MigrateSource(target: to_id, source: base_source))
    Ok(())
}

fn drop_migrate_source(mut plan: SchemaPlan, id: u32) {
    if list.len(plan.migrate_sources) == 0 {
        return ()
    }
    let mut kept: List[transfer.MigrateSource] = list.new()
    for item in plan.migrate_sources {
        if item.target != id {
            list.push(mut kept, item)
        }
    }
    plan.migrate_sources = take kept
}

// Flushes every HotPage currently in `builder.levels` into class-3/4 packs via
// one cut that sets the builder's owner-3 pin, replacing each HotPage with its ColdPage(ptr).
fn stream_flush_chunk(mut db: Db, mut builder: transfer.StreamBuilder, mut collections: pages.PageTree) -> Result[(), Error] waits {
    let mut temp_stamp = failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders)))?
    let Some(take root_node) = failure_result_from_rep(transfer.stream_temporary_root_multi(builder.levels, mut temp_stamp))? else {
        return Ok(())
    }
    let transfer.StreamNode(slot: take root_slot, rows: root_rows, charge: root_charge, ..) = take root_node
    let key = failure_result_from_rep(catalog.prefix(builder.id))?
    let private_from = temp_stamp
    failure_result_from_rep(transfer.put_collection_with_residency(mut collections, key, Some(take root_slot), root_rows, root_charge, builder.kind, ResidentTiered, private_from, mut temp_stamp))?
    failure_result_from_rep(pages.canonical_tree(mut collections))?
    pages.set_next_node(mut db.holders, temp_stamp - 1)
    let (take packed, emitted) = hold_owner3_emitted(mut db, builder.pin, pages.share_page_tree(collections))?
    collections = take packed
    for l in 0u64 .. list.len(builder.levels) {
        for j in 0u64 .. list.len(builder.levels[l]) {
            let is_hot = if let HotPage(_) = view builder.levels[l][j].slot {
                true
            } else {
                false
            }
            if is_hot {
                let s = builder.levels[l][j].stamp
                if let Some(ptr) = map.get(emitted, s) {
                    builder.levels[l][j].slot = ColdPage(ptr)
                }
            }
        }
    }
    builder.hot_bytes = 0
    Ok(())
}

fn stream_push_row(mut db: Db, mut builder: transfer.StreamBuilder, mut collections: pages.PageTree, take row: std.page.Row) -> Result[(), Error] waits {
    let key_len = list.len(row.key)
    let val_len = list.len(row.value)
    let width = transfer.stream_leaf_row_width(key_len, val_len, builder.inline)
    let mut fits = true
    let mut next_prefix = key_len
    if list.len(builder.leaf_rows) != 0 {
        next_prefix = std.page.common_prefix(builder.leaf_rows[0u64].key, row.key)
        fits = transfer.stream_compressed(builder.leaf_sum + width, list.len(builder.leaf_rows) + 1, next_prefix) <= 4096
    }
    if !fits {
        let ready_rows = replace(mut builder.leaf_rows, list.new())
        let (take leaf_node, hot) = failure_result_from_rep(transfer.stream_encode_leaf(take ready_rows, builder.inline, mut builder.next_stamp, builder.stamp_high))?
        builder.hot_bytes = int.saturating_add(builder.hot_bytes, hot)
        failure_result_from_rep(transfer.stream_push_node(mut builder, 0u64, take leaf_node))?
        builder.leaf_sum = 0
        builder.leaf_prefix = 0
        if builder.hot_bytes >= builder.dirty_bytes {
            stream_flush_chunk(mut db, mut builder, mut collections)?
        }
        next_prefix = key_len
    }
    builder.leaf_sum += width
    builder.leaf_prefix = next_prefix
    list.push(mut builder.leaf_rows, take row)
    Ok(())
}

// Pass 2 (§13.10a): re-reads PREPARED sequentially for Tiered ranges only,
// streaming each range bottom-up into `collections` and flushing via
// `hold_import` cuts at `dirty_bytes`. Re-derives each range's digest; a
// mismatch forgets the import and returns `ImportMalformed`.
fn build_tiered_import_pass2(mut db: Db, d: Dir, ranges: List[transfer.ImportedRange], mut collections: pages.PageTree, low: u64, high: u64, inline: u64) -> Result[(), DeployError] waits {
    let mut file = scratch_result(failure_result_from_rep(manifest.disk_io(host.open(d, "PREPARED", Read))))?
    let header = scratch_result(failure_result_from_rep(transfer.prepared_read(mut file, 72u64)))?
    let head = deploy_result(failure_result_from_rep(manifest.disk_read_header("PREPARED", header, 6, None, optional_store_key_to_rep(None))))?
    let mut input = transfer.PreparedInput(file: take file, ctx: head.context, offset: 72u64, digest: std.sha256.start(), peek: None)
    let metadata_codec: std.codec.Codec[transfer.PreparedMeta] = std.codec.of()
    let delta_codec: std.codec.Codec[transfer.CatalogChange] = std.codec.of()
    let inventory_codec: std.codec.Codec[transfer.Inventory] = std.codec.of()
    let row_codec: std.codec.Codec[transfer.PreparedRow] = std.codec.of()
    let meta = transfer_result(transfer.prepared_frame(mut input, 0x0081, metadata_codec))?
    for _ in 0u64 .. meta.changes {
        let _ = transfer_result(transfer.prepared_frame(mut input, 0x0082, delta_codec))?
    }
    let mut inventory: List[transfer.Inventory] = list.with_capacity(meta.ranges)
    for _ in 0u64 .. meta.ranges {
        list.push(mut inventory, transfer_result(transfer.prepared_frame(mut input, 0x0083, inventory_codec))?)
    }
    if meta.changes != 0 {
        let _ = transfer_result(transfer.read_optional_source_map(mut input))?
    }
    if list.len(inventory) != list.len(ranges) {
        return Error(ImportMalformed)
    }
    let dirty_bytes = disk_state(db).options.dirty_bytes
    let mut stamp_cursor = low + 1
    for i in 0u64 .. list.len(ranges) {
        let desc = inventory[i]
        let target = view ranges[i]
        if target.id != desc.id || target.count != desc.count || target.digest != desc.digest {
            return Error(ImportMalformed)
        }
        if target.kind == 0 || target.residency == ResidentMemory {
            for _ in 0u64 .. desc.count {
                let _ = transfer_result(transfer.prepared_frame(mut input, 0x0084, row_codec))?
            }
            continue
        }
        let mut builder = transfer.new_stream_builder(target.id, target.kind, inline, dirty_bytes, stamp_cursor, high, string.from(IMPORT_PIN))
        let mut digest = std.check.start()
        for _ in 0u64 .. desc.count {
            let transfer.PreparedRow(key: take key, value: take encoded) = transfer_result(transfer.prepared_frame(mut input, 0x0084, row_codec))?
            if list.len(key) < 4 {
                return Error(ImportMalformed)
            }
            let key_id: u32 = list.word_be(key, 0)
            if key_id != target.id {
                return Error(ImportMalformed)
            }
            deploy_result(failure_result_from_rep(transfer.checksum_row(mut digest, key, encoded)))?
            let row_charge = txn.entry(key, encoded)
            let suffix = deploy_result(failure_result_from_rep(types.copied(list.slice(key, 4, list.len(key)))))?
            deploy_result(stream_push_row(mut db, mut builder, mut collections, std.page.Row(key: take suffix, value: take encoded, charge: row_charge)))?
        }
        if std.check.finish(digest) != target.digest {
            return Error(ImportMalformed)
        }
        let finished = deploy_result(failure_result_from_rep(transfer.stream_finish_range(mut builder)))?
        stamp_cursor = builder.next_stamp
        let key = deploy_result(failure_result_from_rep(catalog.prefix(target.id)))?
        let private_from = deploy_result(failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(db.holders))))?
        let mut map_stamp = private_from
        match take finished {
            Some(take node) => {
                let transfer.StreamNode(slot: take node_slot, rows: node_rows, charge: node_charge, ..) = take node
                deploy_result(failure_result_from_rep(transfer.put_collection_with_residency(mut collections, key, Some(take node_slot), node_rows, node_charge, target.kind, ResidentTiered, private_from, mut map_stamp)))?
            },
            None => {
                deploy_result(failure_result_from_rep(transfer.put_collection_with_residency(mut collections, key, None, 0, 0, target.kind, ResidentTiered, private_from, mut map_stamp)))?
            },
        }
        deploy_result(failure_result_from_rep(pages.canonical_tree(mut collections)))?
        pages.set_next_node(mut db.holders, map_stamp - 1)
        if builder.hot_bytes >= dirty_bytes {
            let (take packed, _) = hold_import_emitted(mut db, pages.share_page_tree(collections))?
            collections = take packed
        }
    }
    let transfer.PreparedInput(file: take done, ..) = take input
    scratch_result(failure_result_from_rep(manifest.disk_io(host.close(take done))))?
    Ok(())
}

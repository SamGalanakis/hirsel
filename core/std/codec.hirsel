}

const U8_RULE: u32 = 1

const KEY_U8_RULE: u32 = 1

pub fn schema_u8(mut s: Schema) {
    schema_atom(mut s, 3, "u8", U8_RULE, "key.u8", KEY_U8_RULE)
}

const U16_RULE: u32 = 1

const KEY_U16_RULE: u32 = 1

pub fn schema_u16(mut s: Schema) {
    schema_atom(mut s, 4, "u16", U16_RULE, "key.u16", KEY_U16_RULE)
}

const U32_RULE: u32 = 1

const KEY_U32_RULE: u32 = 1

pub fn schema_u32(mut s: Schema) {

pub type Residency: send = Memory | Tiered

// §13.8 "Residency changes": a schema commit on main, published by its own
// cut. Tables, Logs and indexes (D7, §13.10a; aggregates are indexes); a
// Cell is `Missing("residency")`. Each join side reads by its own descriptor.
pub fn set_residency(mut db: Db, id: u32, r: Residency) -> Result[(), Error] waits {
    if !is_disk(db) {
        return Error(Tiered(Memory))
    }
    if object_writer_open(db) {
        return Error(Tiered(Install))
    }
    healthy(db)?
    let key = failure_result_from_rep(catalog.prefix(id))?
    let Some(std.page_descriptor.CollectionDescriptor(kind, residency, ..)) = pages.collection_by_key(pages.holder_heads(db.holders)[0u64].roots.collections, key) else {
        return Error(Stale(id))
    }
    if kind == CellCollection {
        return Error(Missing("residency"))
    }
    match r {
        Tiered => {
            if residency == ResidentTiered {
                return Ok(())
            }
            residency_to_tiered(mut db, id, take key)
        },
        Memory => {
            if residency == ResidentMemory {
                return Ok(())
            }
            residency_to_memory(mut db, id, take key)
        },
    }
}

// §1.1 "Which plan": the first Tiered collection is admitted against the
// Tiered plan before anything changes. The plan must be funded (r covers
// C + K + D + P and the 64 MiB Memory floor, as at open), and the Memory rows
// already resident must fit what the plan leaves them. The floor is their
// room, so it is not added on top of them.
fn admit_tiered_plan(db: Db) -> Result[(), Error] {
    let o = disk_state(db).options
    if !tiered_open_funded(o) {
        let requested = int.saturating_add(tiered_plan_reserve(o), 64 * history.MIB)
        return Error(Full(Resident(Capacity(requested: requested, available: o.resident_limit))))
    }
    failure_result_from_rep(catalog.over_ceiling(db.resident, tiered_memory_room(o)))
}

// C + K + D + P: what the Tiered plan reserves inside `resident_limit`.
fn tiered_plan_reserve(o: Options) -> u64 {
    int.saturating_add(int.saturating_add(o.cache_bytes, pager.CUT_PIN_BYTES), int.saturating_add(o.dirty_bytes, o.pager_task_bytes))
}

// The Memory rows' room under the Tiered plan (§1.1, v2.76).
fn tiered_memory_room(o: Options) -> u64 {
    int.saturating_sub(o.resident_limit, tiered_plan_reserve(o))
}

fn start_residency_pager(mut db: Db) -> Result[(), Error] {
    let d = log_directory(db)?
    let link = {
        let state = disk_state(db)
        let o = state.options
        let funding = pager.TieredPagerFunding(cache_bytes: o.cache_bytes, writer_pin_bytes: o.writer_pin_bytes, pager_task_bytes: o.pager_task_bytes, cut_pins: true)
        failure_result_from_rep(object_writer.start_tiered_pager_link(state.tasks, store_key_to_rep(db.store), state.open, PagerDirectory(d), funding, pager.TIERED_PAGER_QUEUE))?
    }
    let worker = attach_tiered_pager(mut db, take link)
    write_disk(mut db.disk, take worker, scoped fn(mut state: DiskState, take running: Task[()]) {
        pager.set_worker(mut state.tiered, take running)
    })
    Ok(())
}

// A refused first change leaves the store as it was: no pager.
fn stop_residency_pager(mut db: Db) waits {
    clear_parked(mut db)
    pager.disconnect_pager(mut db.pager)
    let running = edit_disk(mut db.disk, scoped fn(mut state: DiskState) -> Option[Task[()]] {
        pager.take_worker(mut state.tiered)
    })
    if let Some(take started) = take running {
        let mut pager_link = take started
        task.cancel(mut pager_link)
        let _ = task.join(take pager_link)
    }
}

fn residency_to_tiered(mut db: Db, id: u32, take key: Bytes) -> Result[(), Error] waits {
    if !store_has_tiered(db) {
        admit_tiered_plan(db)?
    }
    let started = if pager.has_requests(db.pager) {
        false
    } else {
        start_residency_pager(mut db)?
        true
    }
    let changed = publish_tiered_residency(mut db, id, take key)
    if let Error(_) = changed {
        if started {
            stop_residency_pager(mut db)
        }
    }
    changed
}

// The head's collection becomes a Hot Tiered root over its Memory images.
// The cut's T2 emits it with fresh stamps (§13.6a T2 "Re-stamping"), so no
// stamp is reached in classes 0 and 3. Followers see the head's pre-change
// roots: the same rows, and no Hot Tiered page that carries a Memory stamp.
fn publish_tiered_residency(mut db: Db, id: u32, take key: Bytes) -> Result[(), Error] waits {
    let SchemaPlan(schema: catalog.SchemaPlan(roots: take roots, next_node: ids, ..), ..) = schema_plan(db)
    let mut changed = take roots
    let mut tree = pages.share_page_tree(changed.collections)
    let (take root, take descriptor) = {
        let Some((here, before)) = std.page.collection_entry(tree.root, key) else {
            return Error(Stale(id))
        }
        let mut record = failure_result_from_rep(types.copied(before))?
        std.page_descriptor.set_collection_residency(mut record, ResidentTiered)
        (arc.share(here), take record)
    }
    let first = failure_result_from_rep(catalog.stamp_after(ids))?
    let mut draw = first
    failure_result_from_rep(pages.page_result(std.page.insert(mut tree.root, clone(key), take descriptor, Some(arc.share(root)), tree.inline, first, mut draw)))?
    failure_result_from_rep(pages.page_result(std.page.install_tiered_root(mut tree.root, key, HotPage(take root), mut draw)))?
    changed.collections = take tree
    let head = pages.holder_heads(db.holders)[0u64].head + 1
    let replacement = ProposedMain(roots: take changed, head: head, at: pages.holder_heads(db.holders)[0u64].at, tables: catalog.next_table_id(db.schema), activation: None, drop_pin: None, superseded: list.new(), chunk_freed: None, step_rows: list.new(), step_drift: true)
    let publication = failure_result_from_rep(types.capacity(prepare_publication(db, 0, head, pages.holder_heads(db.holders)[0u64].roots, draw - 1)))?
    pages.set_next_node(mut db.holders, draw - 1)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        pager.set_restamp(mut state.tiered, Some(id))
    })
    let installed = cut_install(mut db, ReplaceMain(take replacement, None))
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        pager.set_restamp(mut state.tiered, None)
    })
    let _ = installed?
    publish(take publication)
    Ok(())
}

// §13.8 Tiered -> Memory. Admitted before anything changes: the Memory rows
// plus the collection's Tiered row charge must fit the Memory room the Tiered
// plan leaves inside `resident_limit` (§1.1). The load is a step
// of the schema commit's cut (`load_memory_residency`), so a refused or
// failed load publishes nothing and the collection stays Tiered.
fn residency_to_memory(mut db: Db, id: u32, take key: Bytes) -> Result[(), Error] waits {
    let charge = match std.page.lookup(pages.holder_heads(db.holders)[0u64].roots.collections.root, key) {
        Some(descriptor) => pages.collection_descriptor(descriptor).row_bytes,
        None => return Error(Stale(id)),
    }
    failure_result_from_rep(catalog.over_ceiling(int.saturating_add(db.resident, charge), tiered_memory_room(disk_state(db).options)))?
    let SchemaPlan(schema: catalog.SchemaPlan(roots: take roots, next_node: ids, ..), ..) = schema_plan(db)
    let head = pages.holder_heads(db.holders)[0u64].head + 1
    let replacement = ProposedMain(roots: take roots, head: head, at: pages.holder_heads(db.holders)[0u64].at, tables: catalog.next_table_id(db.schema), activation: None, drop_pin: None, superseded: list.new(), chunk_freed: None, step_rows: list.new(), step_drift: true)
    let publication = failure_result_from_rep(types.capacity(prepare_publication(db, 0, head, pages.holder_heads(db.holders)[0u64].roots, ids)))?
    pages.set_next_node(mut db.holders, ids)
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        pager.set_unload(mut state.tiered, Some(id))
    })
    let installed = cut_install(mut db, ReplaceMain(take replacement, None))
    edit_disk(mut db.disk, scoped fn(mut state: DiskState) {
        pager.set_unload(mut state.tiered, None)
    })
    let _ = installed?
    publish(take publication)
    Ok(())
}

type HistoryWitness = HistoryEvicted(HistoryCapture) | HistoryWitnessLost | HistoryWitnessDeadline

// A missing pack, manifest or chunk belongs to the checkpoint that named
// it. Checking another retained locator would answer for a different capture.
fn history_witness(mut client: std.object.Client, capture: HistoryHead, required_pair: Option[HistoryPair], file: String, missing_seq: Option[u64], mut observed: Bytes, deadline: u64) -> Result[HistoryWitness, Error] waits {
    while std.object.deadline_after_ms(client, 0) < deadline {
        let _ = history_fetch(mut client, "head", mut observed, deadline)?
        if let Some(pair) = required_pair {
            let (_, field) = history_head_frame(observed)?
            if !history_pair_matches(pair, history_frame_pair(observed, field)) {
                return Ok(HistoryWitnessLost)
            }
        }
        let witness = history_decode_head(observed)?
        check_expected_store(Some(capture.store), witness.head.store)?
        history_check_namespace(witness, client)?
        if let Some(seq) = missing_seq {
            if seq < witness.head.floor {
                return Ok(HistoryEvicted(take witness))
            }
            return Error(disk_fault(file, 0, Absent))
        }
        let marker = history_checkpoint(mut client, witness.head, deadline)
        let mark = match take marker {
            Ok((take loaded, _)) => take loaded,
            Error(HistoryMissing(..)) => continue,
            Error(take failure) => return Error(take failure),
        }
        if history_ref_matches(witness.head.checkpoint, capture.checkpoint) {
            return Error(disk_fault(file, 0, Absent))
        }
        for retained in mark.retained {
            if history_ref_matches(retained, capture.checkpoint) {
                return Error(disk_fault(file, 0, Absent))
            }
        }
        return Ok(HistoryEvicted(take witness))
    }
    Ok(HistoryWitnessDeadline)
}

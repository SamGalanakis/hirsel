pub fn cell_page_row(tree: pages.PageTree, key: Bytes) -> Option[View[Bytes]] in tree {
    let (root, descriptor) = std.page.collection_entry(tree.root, key)?
    if let Some(raw) = pages.inline_cell(descriptor) {
        return Some(raw)
    }
    // A spilled Cell stores its only row at the empty key.
    std.page.lookup(root, list.new())
}

fn cell_wire_size(edit: Option[View[pages.CellEdit]]) -> u64 {
    match edit {
        Some(CellPut(value)) => 17 + list.len(format.staged_bytes(value)),
        Some(CellDelete) => 13,
        _ => 0,
    }
}

fn cell_charge(raw: Option[View[Bytes]]) -> u64 {
    match raw {
        Some(value) => 70 + format.round8(list.len(value)),
        None => 0,
    }
}

fn cell_matches(before: Option[View[Bytes]], after: Option[Bytes]) -> bool {
    match after {
        Some(right) => match before {
            Some(left) => left == right,
            None => false,
        },
        None => before == None,
    }
}

fn lower_cell_edit(layers: List[Arc[pages.Staged]], id: u32) -> Option[View[pages.CellEdit]] in layers {
    let mut layer = list.len(layers)
    while layer > 0 {
        layer -= 1
        if let Some(edit) = map.get(layers[layer].ops.cells, id) {
            return Some(edit)
        }
    }
    None
}

fn remove_cell_edit(mut cells: Map[u32, pages.CellEdit], layers: List[Arc[pages.Staged]], id: u32) {
    match lower_cell_edit(layers, id) {
        Some(CellPut(_)) => map.insert(mut cells, id, CellRevert),
        Some(CellDelete) => map.insert(mut cells, id, CellRevert),
        _ => {
            let _ = map.remove(mut cells, id)
        },
    }
}

fn fold_cell_edits(mut cells: Map[u32, pages.CellEdit], layers: List[Arc[pages.Staged]], newer: Map[u32, pages.CellEdit]) {
    for (id, edit) in newer {
        match edit {
            CellRevert => remove_cell_edit(mut cells, layers, id),
            _ => map.insert(mut cells, id, clone(edit)),
        }
    }
}

pub fn seal_cell_edits(mut rows: pages.DataRows, cells: Map[u32, pages.CellEdit]) {
    for (id, edit) in cells {
        let key = result.unwrap(catalog.prefix(id))
        match edit {
            CellPut(value) => pages.push_data_row(mut rows, format.DataOp(key: take key, value: Some(clone(value)), trim: None, prior: None)),
            CellDelete => pages.push_data_row(mut rows, format.DataOp(key: take key, value: None, trim: None, prior: None)),
            CellRevert => (),
        }
    }
}

pub const CELL_INLINE: u64 = 256

fn apply_cell(mut tree: pages.PageTree, key: Bytes, raw: Option[View[Bytes]], shared: Option[View[Arc[Bytes]]], first: u64, mut ids: u64) -> Result[(), types.Failure] {
    let mut root = {
        let Some(empty) = view tree.empty_collection else {
            fail("store: missing empty collection page")
        }
        arc.share(empty)
    }
    let inline = match raw {
        Some(value) if list.len(value) <= CELL_INLINE => Some(value),
        Some(value) => {
            if let Some(contents) = shared {
                pages.page_result(std.page.insert_shared(mut root, list.new(), contents, tree.inline, first, mut ids))?
            } else {
                pages.page_result(std.page.insert(mut root, list.new(), value, None, tree.inline, first, mut ids))?
            }
            None
        },
        None => None,
    }
    let descriptor = pages.cell_record(root, inline)?
    pages.page_result(std.page.insert(mut tree.root, key, descriptor, Some(take root), tree.inline, first, mut ids))
}

fn cell_edit[Event: inert + shareable + send](tx: TxState[Event], id: u32) -> Option[View[pages.CellEdit]] in tx {
    if let Some(edit) = map.get(tx.ops.cells, id) {
        return Some(edit)
    }
    lower_cell_edit(tx.below, id)
}

pub fn cell_current[Event: inert + shareable + send](tx: TxState[Event], id: u32, key: Bytes) -> Option[View[Bytes]] in tx {
    match cell_edit(tx, id) {
        Some(CellPut(value)) => Some(format.staged_bytes(value)),
        Some(CellDelete) => None,
        _ => cell_page_row(tx_roots(tx).collections, key),
    }
}

pub fn stage_cell[Event: inert + shareable + send](mut tx: TxState[Event], id: u32, take wanted: Option[Bytes]) -> Result[(), types.Failure] {
    let key = catalog.prefix(id)?
    let (reverts, old_width, old_charge) = {
        let current = cell_current(tx, id, key)
        if cell_matches(current, wanted) {
            return Ok(())
        }
        let previous = cell_edit(tx, id)
        let was = if tx.retain_old {
            match previous {
                Some(CellPut(raw)) => cell_charge(Some(format.staged_bytes(raw))),
                _ => 0u64,
            }
        } else {
            cell_charge(current)
        }
        (cell_matches(pages.get_page_row(tx_roots(tx).collections, key), wanted), cell_wire_size(previous), was)
    }
    let (new_width, new_charge) = match view wanted {
        Some(raw) => (17 + list.len(raw), 70 + format.round8(list.len(raw))),
        None => (13u64, 0u64),
    }
    let effective_width = if reverts {
        0u64
    } else {
        new_width
    }
    let old_count = if old_width == 0 {
        0u64
    } else {
        1u64
    }
    let new_count = if effective_width == 0 {
        0u64
    } else {
        1u64
    }
    let cell_rows = tx.cell_rows - old_count + new_count
    let frame: Option[u64] = match tx.frame_bytes {
        None => None,
        Some(current) => {
            let after = current - old_width + effective_width
            let data_head = if tx.streams != 0 && tx.rows + cell_rows + tx.trim_rows == 0 {
                5u64
            } else {
                0u64
            }
            if int.saturating_add(after, tx.extra_bytes) - 16 - data_head > types.transaction_limit(tx.limits) {
                return Error(Limit(Transaction))
            }
            Some(after)
        },
    }
    if reverts {
        remove_cell_edit(mut tx.ops.cells, tx.below, id)
    } else {
        let height = collection_write_height(tx_roots(tx).collections, key)
        let _ = reserve_ids(mut tx, height)?
        let edit: pages.CellEdit = match take wanted {
            Some(take raw) => CellPut(pages.stage_value(take raw, tx_roots(tx).collections.inline)),
            None => CellDelete,
        }
        map.insert(mut tx.ops.cells, id, take edit)
    }
    let added = if tx.retain_old && reverts {
        0u64
    } else {
        new_charge
    }
    tx.resident = int.saturating_add(int.saturating_sub(tx.resident, old_charge), added)
    tx.frame_bytes = frame
    tx.cell_rows = cell_rows
    Ok(())
}

pub fn readable_value(store_id: types.StoreKey, roots: pages.Roots, expected: types.StoreKey, catalog_key: Bytes, catalog_page: Bytes, id: u32) -> Result[(), types.Failure] {
    if store_id != expected {
        return Error(Foreign)
    }
    catalog.readable(roots, catalog_key, catalog_page, id)
}

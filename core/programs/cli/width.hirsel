// Display width (README.md, "Width"): escape sequences count 0, a scalar of category Mn, Me
// or Cf counts 0, a control counts 0, a scalar whose East_Asian_Width is W or F counts 2, and
// every other scalar (Ambiguous included) counts 1. There is no grapheme segmentation.
fn wide(code: u32) -> bool {
    let mut low: u64 = 0
    let mut high: u64 = WIDE_RANGES
    while low < high {
        let mid = (low + high) / 2
        if code < WIDE[2 * mid] {
            high = mid
        } else if code > WIDE[2 * mid + 1] {
            low = mid + 1
        } else {
            return true
        }
    }
    false
}

/// The columns one scalar takes.
pub fn char_width(c: char) -> u64 {
    let code = char.to_u32(c)
    if code < 0x20 || (code >= 0x7f && code < 0xa0) {
        return 0
    }
    if code < 0x7f {
        return 1
    }
    let k = char.category(c)
    if k == Mn || k == Me || k == Cf {
        return 0
    }
    if wide(code) {
        2
    } else {
        1
    }
}

// The byte just past the escape sequence starting at `at` (an ESC): a CSI ends at its final
// byte (0x40 to 0x7E), an OSC at BEL or ST, and any other escape after one more scalar.
fn escape_end(t: String, at: u64) -> u64 {
    let b = string.as_bytes(t)
    let n = list.len(b)
    if at + 1 >= n {
        return n
    }
    if b[at + 1] == b'[' {
        let mut i = at + 2
        while i < n {
            if b[i] >= 0x40 && b[i] <= 0x7e {
                return i + 1
            }
            i += 1
        }
        return n
    }
    if b[at + 1] == b']' {
        let mut i = at + 2
        while i < n {
            if b[i] == 0x07 {
                return i + 1
            }
            if b[i] == 0x1b && i + 1 < n && b[i + 1] == b'\\' {
                return i + 2
            }
            i += 1
        }
        return n
    }
    match string.next_scalar(t, at + 1) {
        Some((_, next)) => next,
        None => n,
    }
}

/// The columns `t` takes on a terminal, skipping escape sequences.
pub fn width(t: String) -> u64 {
    let mut total: u64 = 0
    let mut at: u64 = 0
    while let Some((c, next)) = string.next_scalar(t, at) {
        if c == '\u{1b}' {
            at = escape_end(t, at)
        } else {
            total += char_width(c)
            at = next
        }
    }
    total
}


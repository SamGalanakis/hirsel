const DEFAULT_LANES: u64 = 8

const MAX_ATTEMPTS: u64 = 5

const THROTTLE_BACKOFF_NS: u64 = 100000000

const TRANSPORT_BACKOFF_NS: u64 = 10000000

const MAX_U64: u64 = 18446744073709551615

pub type Style: key = Virtual | Path

pub type Bucket: send {
    endpoint: String,
    aws_region: String,
    bucket: String,
    prefix: String,
    style: Style
}

pub type ETag: key {
    octets: Inline[u8, 64],
    len: u64
}

pub type Meta: send {
    size: u64,
    etag: ETag,
    crc64: Option[u64],
    put_id: Option[Inline[u8, 16]]
}

pub type Created: send = Created(Meta) | Exists

pub type Conditional: send = Applied(Meta) | Mismatch

pub type Precondition: send = Match(ETag) | Absent

pub type Reason: shareable + cross = Status(u16, Bytes) | Net(NetError) | Http(http_client.Error) | Malformed | Deadline | Cancelled

pub type Error: shareable + cross = Fatal(Reason) | Retriable(Reason) | Uncertain(Reason) | TooLarge | NotFound | Precondition

pub type Mode: key = Overwrite | NoClobber

/// A byte range of RFC 9110 §14.1.2. `Whole` asks for no range, `From(first)`
/// is `first-`, `Span(first, last)` is `first-last` with `last` inclusive, and
/// `Last(n)` is the suffix `-n`.
pub type Want: key + send = Whole | From(u64) | Span(u64, u64) | Last(u64)

/// The head of an opened object body. A 200 is the whole object; a 206 is
/// the bytes [first, end) of an object of `size` bytes. `size` is the whole
/// object's, from `Content-Range` on a 206 and `Content-Length` on a 200.
pub type Part: send {
    status: u16,
    first: u64,
    end: u64,
    size: u64,
    etag: ETag
}

/// An opened object: its head and the live connection with the body unread,
/// or the store's 416 when no byte of the object is in the range.
pub type Opened: send = Ready(Part, Box[http_client.Connection]) | Unsatisfiable

pub opaque type Key: key {
    octets: Inline[u8, 1024],
    len: u64
}

pub type Entry: send {
    key: Key,
    size: u64,
    etag: ETag
}

pub type Page: send {
    truncated: bool,
    after: Key
}

pub fn key_text(key: Key) -> String {
    let mut out: Bytes = list.with_capacity(key.len)
    let _ = bytebuf.append_inline(mut out, key.octets, 0, key.len)
    result.unwrap(string.from_utf8(take out))
}

pub type Operation = object_request.Operation

pub type RequestKind = object_request.RequestKind

pub type RequestCounts = object_request.RequestCounts

type AttemptObservation = object_request.AttemptObservation

type LaneCounts = object_request.LaneCounts

type Phase = object_request.Phase

fn ascii(b: u8) -> char {
    option.unwrap(char.from_u32(int.widen(b)))
}

fn make_path(mut out: String, bucket: Bucket, key: String, bucket_only: bool) {
    string.clear(mut out)
    string.push_char(mut out, '/')
    if bucket.style == Path {
        object_request.percent_encode(mut out, string.as_bytes(bucket.bucket), false)
        string.push_char(mut out, '/')
    }
    if !bucket_only {
        object_request.percent_encode(mut out, string.as_bytes(bucket.prefix), true)
        object_request.percent_encode(mut out, string.as_bytes(key), true)
    }
}

fn request_path(bucket: Bucket, key: String, bucket_only: bool) -> String {
    let mut out = string.from("")
    make_path(mut out, bucket, key, bucket_only)
    take out
}

fn new_meta() -> Meta {
    Meta(size: 0, etag: empty_tag(), crc64: None, put_id: None)
}

fn copy_bytes(b: Bytes) -> Bytes {
    let mut out: Bytes = list.with_capacity(list.len(b))
    list.append(mut out, b)
    take out
}

fn size_or(n: Option[u64], fallback: u64) -> u64 {
    match n {
        Some(value) => value,
        None => fallback,
    }
}

/// The half-open span [first, end) that `want` selects from an object of
/// `size` bytes (RFC 9110 §14.1.2), or None when it is unsatisfiable: no byte
/// of the object lies in it, as for any range of an empty object, or
/// `Span(first, last)` has last < first.
pub fn range_span(want: Want, size: u64) -> Option[(u64, u64)] {
    match want {
        Whole => Some((0, size)),
        From(first) if first < size => Some((first, size)),
        Span(first, last) if first <= last && first < size => Some((first, order.min(last, size - 1) + 1)),
        Last(n) if n != 0 && size != 0 => Some((size - order.min(n, size), size)),
        _ => None,
    }
}

fn decimal(b: Bytes, lo: u64, hi: u64) -> Result[u64, Error] {
    match int.parse_decimal_span(b, lo, hi, MAX_U64) {
        Ok(n) => Ok(n),
        Error(_) => Error(Fatal(Malformed)),
    }
}

type Range: send {
    lo: u64,
    hi: u64,
    size: u64
}

fn content_range(b: Bytes) -> Result[Range, Error] {
    if list.len(b) < 11 || list.slice(b, 0, 6) != string.as_bytes("bytes ") {
        return Error(Fatal(Malformed))
    }
    let mut dash = 6u64
    while dash < list.len(b) && b[dash] != b'-' {
        dash += 1
    }
    if dash == list.len(b) {
        return Error(Fatal(Malformed))
    }
    let mut slash = dash + 1
    while slash < list.len(b) && b[slash] != b'/' {
        slash += 1
    }
    if slash == list.len(b) {
        return Error(Fatal(Malformed))
    }
    let lo = decimal(b, 6, dash)?
    let last = decimal(b, dash + 1, slash)?
    let size = decimal(b, slash + 1, list.len(b))?
    if lo > last || last >= size {
        return Error(Fatal(Malformed))
    }
    Ok(Range(lo, hi: last + 1, size))
}

fn empty_tag() -> ETag {
    ETag(octets:[0; 64], len: 0)
}

fn etag(data: Bytes) -> Result[ETag, Error] {
    if list.len(data) > 64 {
        return Error(Fatal(Malformed))
    }
    let mut result = empty_tag()
    result.len = list.len(data)
    for i in 0u64 .. result.len {
        result.octets[i] = data[i]
    }
    Ok(result)
}

fn strong_tag(tag: ETag) -> bool {
    if tag.len < 2 || tag.len > 64 || tag.octets[0] != b'"' || tag.octets[tag.len - 1] != b'"' {
        return false
    }
    for i in 1u64 .. tag.len - 1 {
        let b = tag.octets[i]
        if b < 33 || b == b'"' || b == 127 {
            return false
        }
    }
    true
}

fn tag_bytes(tag: ETag) -> Bytes {
    let mut out: Bytes = list.with_capacity(tag.len)
    let _ = bytebuf.append_inline(mut out, tag.octets, 0, tag.len)
    take out
}

fn read_meta(head: http_client.ResponseHead, size: u64) -> Result[Meta, Error] {
    let mut out = new_meta()
    out.size = size
    if let Some(value) = object_request.header(head, "etag") {
        out.etag = etag(value)?
    }
    if let Some(value) = object_request.header(head, "x-amz-meta-hirsel-put-id") {
        out.put_id = object_request.decode_id(value)
    }
    if let Some(value) = object_request.header(head, "x-amz-checksum-crc64nvme") {
        if let Some(raw) = base64.decode(value) {
            if list.len(raw) == 8 {
                let mut n = 0u64
                for b in raw {
                    n = (n << 8) | int.widen(b)
                }
                out.crc64 = Some(n)
            }
        }
    }
    Ok(take out)
}

type Endpoint: send {
    name: String,
    authority: String,
    port: u16,
    secure: bool,
    proven: bool,
    roots: Option[Bytes]
}

fn loopback_v4(host: String) -> bool {
    let octets = string.as_bytes(host)
    let mut dots = 0u64
    let mut digits = 0u64
    let mut value = 0u64
    let mut first = 0u64
    for c in octets {
        if c == b'.' {
            if digits == 0 || dots == 3 {
                return false
            }
            if dots == 0 {
                first = value
            }
            dots += 1
            digits = 0
            value = 0
        } else if int.is_ascii_digit(c) {
            if digits == 3 || (digits > 0 && value == 0) {
                return false
            }
            value = value * 10 + int.widen(c - b'0')
            digits += 1
            if value > 255 {
                return false
            }
        } else {
            return false
        }
    }
    dots == 3 && digits != 0 && first == 127
}

fn endpoint(bucket: Bucket, take trust: Trust) -> Result[Endpoint, Error] {
    let parsed = match uri.parse(bucket.endpoint) {
        Ok(p) => p,
        Error(_) => return Error(Fatal(Malformed)),
    }
    let Some(scheme) = parsed.scheme else {
        return Error(Fatal(Malformed))
    }
    let secure = string.slice(bucket.endpoint, scheme.start, scheme.end) == "https"
    if !secure && string.slice(bucket.endpoint, scheme.start, scheme.end) != "http" {
        return Error(Fatal(Malformed))
    }
    let Some(Name(host)) = parsed.host else {
        return Error(Fatal(Malformed))
    }
    if parsed.userinfo != None || parsed.query != None || parsed.fragment != None || (parsed.path.end != parsed.path.start && string.slice(bucket.endpoint, parsed.path.start, parsed.path.end) != "/") || bucket.bucket == "" {
        return Error(Fatal(Malformed))
    }
    // A plain-http path-style endpoint at an IPv4 loopback literal is the
    // loopback simulator (STORE §12.2): every answer must carry its proof.
    let loopback = !secure && bucket.style == Path && loopback_v4(string.from(string.slice(bucket.endpoint, host.start, host.end)))
    let mut name = string.from("")
    if bucket.style == Virtual {
        string.push(mut name, bucket.bucket)
        string.push_char(mut name, '.')
    }
    string.push(mut name, string.slice(bucket.endpoint, host.start, host.end))
    let mut authority = string.from(name)
    let port = if let Some(p) = uri.port_number(bucket.endpoint, parsed) {
        string.push_char(mut authority, ':')
        string.push_u64(mut authority, int.widen(p))
        p
    } else if secure {
        443
    } else {
        80
    }
    if !http.valid_authority(string.as_bytes(authority)) {
        return Error(Fatal(Malformed))
    }
    let roots: Option[Bytes] = match take trust {
        System => None,
        Roots(take certs) => Some(take certs),
    }
    Ok(Endpoint(name: take name, authority: take authority, port, secure, proven: loopback, roots: take roots))
}

type Job: send {
    ticket: u64,
    op: Operation,
    path: String,
    query: String,
    data: Bytes,
    tag: ETag,
    id: Option[Inline[u8, 16]],
    lo: u64,
    hi: u64,
    want: Want,
    deadline: u64,
    retry_uncertain: bool,
    resolve_complete: bool,
    // The bucket prefix a listing's keys are stripped of.
    prefix: String,
    entries: List[Entry]
}

type Value: send = Headed(Part) | Handed(Part, Box[http_client.Connection]) | Object(Meta) | Existing | NotModified | BucketSetting(String) | Listed(Page) | Initiated(String) | Pending(List[String], List[String], bool, Option[UploadCursor])

type Reply: send {
    lane: u64,
    ticket: u64,
    path: String,
    result: Result[Value, Error],
    data: Bytes,
    entries: List[Entry]
}

const HOST_FIELD: u64 = 0

const MATCH_FIELD: u64 = 1

const NO_CLOBBER_FIELD: u64 = 2

const RANGE_FIELD: u64 = 3

const CHECKSUM_FIELD: u64 = 4

const PAYLOAD_FIELD: u64 = 5

const DATE_FIELD: u64 = 6

const ID_FIELD: u64 = 7

const TOKEN_FIELD: u64 = 8

const AUTH_FIELD: u64 = 9

const FIELD_COUNT: u64 = 10

type WireBuffers: send {
    values: List[Bytes],
    headers: List[http_client.Header],
    signing: Bytes,
    target: String,
    range_text: String
}

fn wire_buffers() -> WireBuffers {
    let mut values: List[Bytes] = list.with_capacity(FIELD_COUNT)
    for i in 0u64 .. FIELD_COUNT {
        let capacity = if i == TOKEN_FIELD {
            4096u64
        } else if i == HOST_FIELD || i == AUTH_FIELD {
            1024u64
        } else {
            64u64
        }
        list.push(mut values, list.with_capacity(capacity))
    }
    WireBuffers(values: take values, headers: list.with_capacity(FIELD_COUNT), signing: list.with_capacity(16384), target: string.with_capacity(8192), range_text: string.with_capacity(64))
}

fn value_buffer(mut slots: List[Bytes], index: u64) -> Bytes {
    let mut out = list.set(mut slots, index, list.new())
    list.clear(mut out)
    take out
}

fn set_header(mut headers: List[http_client.Header], index: u64, take value: Bytes) {
    list.push(mut headers, http_client.Header(name: object_request.field_name(index), value: Public(take value)))
}

fn copy_header(mut headers: List[http_client.Header], mut slots: List[Bytes], index: u64, from: Bytes) {
    let mut out = value_buffer(mut slots, index)
    list.append(mut out, from)
    set_header(mut headers, index, take out)
}

fn reclaim_header(mut slots: List[Bytes], take h: http_client.Header) {
    let http_client.Header(name: take name, value: take value) = take h
    let Public(take data) = take value else {
        fail("object signing returned a protected header")
    }
    for i in 0u64 .. FIELD_COUNT {
        if name == object_request.field_name(i) {
            let _ = list.set(mut slots, i, take data)
            return
        }
    }
    fail("object signing returned an unknown header")
}

fn reclaim_headers(mut w: WireBuffers, take sent: List[http_client.Header]) {
    let mut headers = take sent
    while let Some(take h) = list.pop(mut headers) {
        reclaim_header(mut w.values, take h)
    }
    w.headers = take headers
}

fn reclaim_request(mut w: WireBuffers, take req: http_client.Request) {
    let http_client.Request(target: take target, headers: take sent, ..) = take req
    w.target = take target
    reclaim_headers(mut w, take sent)
}

fn signed_request(mut job: Job, op: Operation, server: Endpoint, keys: sigv4.SigningKeys, access_key: String, token: String, clock: Clock, skew: i64, crc: Option[u32], from: u64, to: u64, tag: ETag, mut w: WireBuffers) -> Result[http_client.Request, Error] {
    let now = host.wall_ms(clock)
    let timestamp = if skew < 0 {
        now - order.min(now, int.narrow(int.abs(skew)))
    } else {
        int.saturating_add(now, int.narrow(int.abs(skew)))
    }
    let mut headers = replace(mut w.headers, list.new())
    let mut date = value_buffer(mut w.values, DATE_FIELD)
    if let Error(_) = sigv4.write_date(mut date, timestamp) {
        let _ = list.set(mut w.values, DATE_FIELD, take date)
        w.headers = take headers
        return Error(Fatal(Malformed))
    }
    copy_header(mut headers, mut w.values, HOST_FIELD, string.as_bytes(server.authority))
    if (object_request.payload_read(op) || op == S3PutIf) && tag.len != 0 {
        let mut field = value_buffer(mut w.values, MATCH_FIELD)
        let _ = bytebuf.append_inline(mut field, tag.octets, 0, tag.len)
        set_header(mut headers, MATCH_FIELD, take field)
    }
    if op == S3PutConditional || op == S3CompleteConditional || (op == S3PutIf && tag.len == 0) {
        copy_header(mut headers, mut w.values, NO_CLOBBER_FIELD, string.as_bytes("*"))
    }
    if op == S3FetchChanged {
        let mut field = value_buffer(mut w.values, NO_CLOBBER_FIELD)
        let _ = bytebuf.append_inline(mut field, job.tag.octets, 0, job.tag.len)
        set_header(mut headers, NO_CLOBBER_FIELD, take field)
    }
    if object_request.payload_read(op) && (op == S3FetchRange || from != 0) {
        string.clear(mut w.range_text)
        string.push(mut w.range_text, "bytes=")
        string.push_u64(mut w.range_text, from)
        string.push_char(mut w.range_text, '-')
        if to != MAX_U64 {
            string.push_u64(mut w.range_text, to - 1)
        }
        copy_header(mut headers, mut w.values, RANGE_FIELD, string.as_bytes(w.range_text))
    } else if op == S3Open && job.want != Whole {
        string.clear(mut w.range_text)
        string.push(mut w.range_text, "bytes=")
        match job.want {
            From(first) => {
                string.push_u64(mut w.range_text, first)
                string.push_char(mut w.range_text, '-')
            },
            Span(first, last) => {
                string.push_u64(mut w.range_text, first)
                string.push_char(mut w.range_text, '-')
                string.push_u64(mut w.range_text, last)
            },
            Last(n) => {
                string.push_char(mut w.range_text, '-')
                string.push_u64(mut w.range_text, n)
            },
            Whole => {},
        }
        copy_header(mut headers, mut w.values, RANGE_FIELD, string.as_bytes(w.range_text))
    }
    let valid_crc = object_request.uploads_body(op) && crc != None
    if valid_crc {
        let mut field = value_buffer(mut w.values, CHECKSUM_FIELD)
        object_request.encode_checksum(mut field, option.unwrap(crc))
        set_header(mut headers, CHECKSUM_FIELD, take field)
    }
    copy_header(mut headers, mut w.values, PAYLOAD_FIELD, string.as_bytes("UNSIGNED-PAYLOAD"))
    set_header(mut headers, DATE_FIELD, take date)
    if op == S3Upload || op == S3Put || op == S3PutConditional {
        if let Some(id) = job.id {
            let mut field = value_buffer(mut w.values, ID_FIELD)
            hex.append_from(mut field, 16, scoped fn(i: u64) -> u8 {
                id[i]
            })
            set_header(mut headers, ID_FIELD, take field)
        }
    }
    if token != "" {
        copy_header(mut headers, mut w.values, TOKEN_FIELD, string.as_bytes(token))
    }
    let uri_path = replace(mut job.path, string.new())
    let query = if op == S3Head {
        string.new()
    } else {
        replace(mut job.query, string.new())
    }
    let signed = sigv4.Request(method: object_request.method(op), uri: take uri_path, query: take query, headers: take headers, payload: if !server.secure && valid_crc {
        Plaintext
    } else {
        Tls
    })
    let mut authorization = value_buffer(mut w.values, AUTH_FIELD)
    let authorized = sigv4.authorize(keys, now, timestamp, access_key, signed, mut w.signing, mut authorization)
    let sigv4.Request(headers: take signed_fields, uri: take restored_path, query: take restored_query, ..) = take signed
    job.path = take restored_path
    if op != S3Head {
        job.query = take restored_query
    }
    if let Error(_) = authorized {
        let _ = list.set(mut w.values, AUTH_FIELD, take authorization)
        reclaim_headers(mut w, take signed_fields)
        return Error(Fatal(Malformed))
    }
    let mut target = replace(mut w.target, string.new())
    string.clear(mut target)
    string.push(mut target, job.path)
    if op != S3Head && job.query != "" {
        string.push_char(mut target, '?')
        string.push(mut target, job.query)
    }
    let mut actual_fields = take signed_fields
    let host = list.remove(mut actual_fields, 0)
    reclaim_header(mut w.values, take host)
    set_header(mut actual_fields, AUTH_FIELD, take authorization)
    Ok(http_client.Request(method: object_request.method(op), target: take target, headers: take actual_fields, body: Fixed(if object_request.uploads_body(op) {
        list.len(job.data)
    } else {
        0
    })))
}

type Failure: send {
    phase: Phase,
    reason: Reason,
    status: u16,
    code: Bytes,
    server_time: Option[u64]
}

type Exchange: send = Received(Value) | Refused(Failure) | Invalid(Error)

fn failure(phase: Phase, e: http_client.Error) -> Exchange {
    let reason: Reason = match e {
        Deadline => Deadline,
        Cancelled => Cancelled,
        _ => Http(e),
    }
    match e {
        InvalidRequest => Invalid(Fatal(take reason)),
        State => Invalid(Fatal(take reason)),
        NoSpace => Invalid(Fatal(take reason)),
        UnsupportedSwitch => Invalid(Fatal(take reason)),
        TooLarge => Invalid(TooLarge),
        _ => Refused(Failure(phase, reason: take reason, status: 0, code: list.new(), server_time: None)),
    }
}

fn xml_text(b: Bytes) -> Result[String, Error] {
    match string.from_utf8(copy_bytes(b)) {
        Ok(take s) => Ok(take s),
        Error(_) => Error(Fatal(Malformed)),
    }
}

fn empty_key() -> Key {
    Key(octets:[0; 1024], len: 0)
}

fn parse_listing_fields(body: String, prefix: String, mut decoded: String) -> Result[Entry, Error] {
    let Some(raw_key) = object_xml.xml_content(body, "<Key>", "</Key>") else {
        return Error(Fatal(Malformed))
    }
    object_xml.decode_xml(mut decoded, raw_key)?
    if !string.starts_with(decoded, prefix) || string.byte_len(decoded) > 1024 {
        return Error(Fatal(Malformed))
    }
    let offset = string.byte_len(prefix)
    let mut name = empty_key()
    name.len = string.byte_len(decoded) - offset
    for i in 0u64 .. name.len {
        name.octets[i] = string.as_bytes(decoded)[offset + i]
    }
    let Some(raw_size) = object_xml.xml_content(body, "<Size>", "</Size>") else {
        return Error(Fatal(Malformed))
    }
    let Some(raw_etag) = object_xml.xml_content(body, "<ETag>", "</ETag>") else {
        return Error(Fatal(Malformed))
    }
    object_xml.decode_xml(mut decoded, raw_etag)?
    let size = decimal(string.as_bytes(raw_size), 0, string.byte_len(raw_size))?
    Ok(Entry(key: name, size, etag: etag(string.as_bytes(decoded))?))
}

type ListScratch: send {
    text: Bytes,
    decoded: String
}

fn list_scratch() -> ListScratch {
    ListScratch(text: list.with_capacity(32768), decoded: string.with_capacity(32768))
}

fn parse_entry(body: Bytes, prefix: String, mut scratch: ListScratch) -> Result[Entry, Error] {
    list.clear(mut scratch.text)
    list.append(mut scratch.text, body)
    let raw = replace(mut scratch.text, list.new())
    match string.from_utf8(take raw) {
        Ok(take text) => {
            let parsed = parse_listing_fields(text, prefix, mut scratch.decoded)
            scratch.text = string.into_bytes(take text)
            take parsed
        },
        Error(take rejected) => {
            scratch.text = take rejected
            Error(Fatal(Malformed))
        },
    }
}

fn consume(mut buffer: Bytes, n: u64) {
    let rest = list.len(buffer) - n
    list.copy_within(mut buffer, n, 0, rest)
    list.truncate(mut buffer, rest)
}

fn receive_failure(e: http_client.Error) -> Exchange {
    failure(ResponseBody, e)
}

fn collect(mut c: http_client.Connection, mut into: Bytes, mut overflow: Bytes) -> Result[(), http_client.Error] waits {
    list.clear(mut overflow)
    loop {
        if list.len(into) == list.capacity(into) {
            return if http_client.read(mut c, mut overflow)? == 0 {
                Ok(())
            } else {
                Error(TooLarge)
            }
        }
        if http_client.read(mut c, mut into)? == 0 {
            return Ok(())
        }
    }
}

fn listing(mut c: http_client.Connection, prefix: String, mut entries: List[Entry], mut buffer: Bytes, mut probe: Bytes, mut scratch: ListScratch) -> Exchange waits {
    list.clear(mut buffer)
    let original = list.len(entries)
    let mut truncated: Option[bool] = None
    let mut closed = false
    let mut at = 0u64
    loop {
        let Some(begin_at) = list.find_byte(buffer, at, list.len(buffer), b'<') else {
            if list.len(buffer) == list.capacity(buffer) {
                return Invalid(TooLarge)
            }
            list.clear(mut buffer)
            at = 0
            match http_client.read(mut c, mut buffer) {
                Ok(0) => break,
                Ok(_) => continue,
                Error(e) => return receive_failure(e),
            }
        }
        let Some(stop) = list.find_byte(buffer, begin_at, list.len(buffer), b'>') else {
            consume(mut buffer, begin_at)
            at = 0
            match http_client.read(mut c, mut buffer) {
                Ok(0) => return Invalid(Fatal(Malformed)),
                Ok(_) => continue,
                Error(e) => return receive_failure(e),
            }
        }
        let (entry, page, final_tag, embedded_error) = {
            let tag = list.slice(buffer, begin_at, stop + 1)
            (tag == string.as_bytes("<Contents>"), tag == string.as_bytes("<IsTruncated>"), tag == string.as_bytes("</ListBucketResult>"), tag == string.as_bytes("<Error>") || tag == string.as_bytes("<Error/>"))
        }
        if embedded_error && !closed {
            if let Error(e) = collect(mut c, mut buffer, mut probe) {
                return receive_failure(e)
            }
            return interpret_error(S3ListObjects, 200, buffer)
        }
        if final_tag {
            closed = true
        }
        if entry || page {
            let end = if entry {
                string.as_bytes("</Contents>")
            } else {
                string.as_bytes("</IsTruncated>")
            }
            let Some(end_at) = object_xml.fragment(buffer, stop + 1, end) else {
                consume(mut buffer, begin_at)
                at = 0
                if list.len(buffer) == list.capacity(buffer) {
                    return Invalid(TooLarge)
                }
                match http_client.read(mut c, mut buffer) {
                    Ok(0) => return Invalid(Fatal(Malformed)),
                    Ok(_) => continue,
                    Error(e) => return receive_failure(e),
                }
            }
            let body = list.slice(buffer, stop + 1, end_at)
            if entry {
                if list.len(entries) == list.capacity(entries) {
                    return Invalid(TooLarge)
                }
                match parse_entry(body, prefix, mut scratch) {
                    Ok(take parsed) => list.push(mut entries, take parsed),
                    Error(take e) => return Invalid(take e),
                }
            } else {
                if body == string.as_bytes("true") {
                    truncated = Some(true)
                } else if body == string.as_bytes("false") {
                    truncated = Some(false)
                } else {
                    return Invalid(Fatal(Malformed))
                }
            }
            at = end_at + list.len(end)
        } else {
            at = stop + 1
        }
    }
    let Some(more) = truncated else {
        return Invalid(Fatal(Malformed))
    }
    if !closed {
        return Invalid(Fatal(Malformed))
    }
    let after = if list.len(entries) == original {
        empty_key()
    } else {
        entries[list.len(entries) - 1].key
    }
    Received(Listed(Page(truncated: more, after)))
}

// Keys come back with the bucket prefix, which the caller's handles leave out.
fn parse_pending(body: Bytes, prefix: String) -> Exchange {
    let Ok(text) = xml_text(body) else {
        return Invalid(Fatal(Malformed))
    }
    if string.find(text, 0, "</ListMultipartUploadsResult>") == None {
        return Invalid(Fatal(Malformed))
    }
    let more = match object_xml.xml_field(text, "IsTruncated") {
        Some(flag) => {
            if flag == "true" {
                true
            } else if flag == "false" {
                false
            } else {
                return Invalid(Fatal(Malformed))
            }
        },
        None => return Invalid(Fatal(Malformed)),
    }
    let mut keys: List[String] = list.new()
    let mut ids: List[String] = list.new()
    let mut at = 0u64
    while let Some(first) = string.find(text, at, "<Upload>") {
        let Some(last) = string.find(text, first, "</Upload>") else {
            return Invalid(Fatal(Malformed))
        }
        let entry = string.slice(text, first, last)
        let (Some(raw_key), Some(raw_id)) = (object_xml.xml_field(entry, "Key"), object_xml.xml_field(entry, "UploadId")) else {
            return Invalid(Fatal(Malformed))
        }
        let key = match object_xml.xml_decoded(raw_key) {
            Ok(take value) => take value,
            Error(take e) => return Invalid(take e),
        }
        if !string.starts_with(key, prefix) {
            return Invalid(Fatal(Malformed))
        }
        list.push(mut keys, string.from(string.slice(key, string.byte_len(prefix), string.byte_len(key))))
        match object_xml.xml_decoded(raw_id) {
            Ok(take value) => list.push(mut ids, take value),
            Error(take e) => return Invalid(take e),
        }
        at = last
    }
    let cursor: Option[UploadCursor] = match (object_xml.xml_field(text, "NextKeyMarker"), object_xml.xml_field(text, "NextUploadIdMarker")) {
        (Some(raw_key), Some(raw_id)) if more => {
            let (Ok(take key), Ok(take id)) = (object_xml.xml_decoded(raw_key), object_xml.xml_decoded(raw_id)) else {
                return Invalid(Fatal(Malformed))
            }
            if !string.starts_with(key, prefix) || id == "" {
                return Invalid(Fatal(Malformed))
            }
            Some(UploadCursor(key: take key, id: take id))
        },
        _ => None,
    }
    Received(Pending(take keys, take ids, more, take cursor))
}

fn status_failure(status: u16, body: Bytes) -> Failure {
    let mut code: Bytes = list.new()
    let mut server_time: Option[u64] = None
    if let Ok(text) = xml_text(body) {
        if let Some(tag) = object_xml.xml_field(text, "Code") {
            code = copy_bytes(string.as_bytes(tag))
        }
        if let Some(value) = object_xml.xml_field(text, "ServerTime") {
            if let Ok((stamp, _)) = time.parse_rfc3339(value) {
                let seconds = time.unix_secs(stamp)
                if seconds >= 0 {
                    let sec: u64 = int.narrow(seconds)
                    server_time = Some(int.saturating_mul(sec, 1000u64))
                }
            }
        }
    }
    Failure(phase: ResponseHead, reason: Status(status, clone(code)), status, code: take code, server_time)
}

fn bad_success(op: Operation) -> Exchange {
    if op == S3PutConditional || op == S3PutIf || op == S3Complete || op == S3CompleteConditional {
        return Refused(Failure(phase: ResponseBody, reason: Malformed, status: 0, code: list.new(), server_time: None))
    }
    Invalid(Fatal(Malformed))
}

fn interpret_error(op: Operation, status: u16, body: Bytes) -> Exchange {
    let response = status_failure(status, body)
    if status >= 200 && status < 300 && list.len(response.code) == 0 {
        return bad_success(op)
    }
    Refused(take response)
}

type ReadProgress: send {
    initial: u64,
    size: Option[u64],
    tag: ETag
}

fn receive_object(mut c: http_client.Connection, mut into: Bytes, mut progress: ReadProgress, status: u16, lo: u64, hi: u64, mut probe: Bytes) -> Exchange waits {
    let (found, expected) = {
        let head = http_client.head(c)
        if status == 206 {
            let Some(field) = object_request.header(head, "content-range") else {
                return Invalid(Fatal(Malformed))
            }
            let range = match content_range(field) {
                Ok(value) => value,
                Error(take e) => return Invalid(take e),
            }
            if range.lo != lo || range.hi != order.min(hi, range.size) {
                return Invalid(Fatal(Malformed))
            }
            if let Some(prev) = progress.size {
                if prev != range.size {
                    return Invalid(Precondition)
                }
            }
            let n = range.hi - range.lo
            if let Some(field_n) = object_request.content_length(head) {
                if field_n != n {
                    return Invalid(Fatal(Malformed))
                }
            }
            (read_meta(head, range.size), Some(n))
        } else if status == 200 && lo == 0 && hi == MAX_U64 {
            let size = object_request.content_length(head)
            (read_meta(head, size_or(size, 0)), size)
        } else {
            return Invalid(Fatal(Malformed))
        }
    }
    let mut received = match take found {
        Ok(take info) => take info,
        Error(take e) => return Invalid(take e),
    }
    if progress.tag.len != 0 {
        if progress.tag != received.etag {
            return Invalid(Precondition)
        }
    } else if received.etag.len != 0 {
        progress.tag = received.etag
    }
    if status == 206 || expected != None {
        progress.size = Some(received.size)
    }
    let begin_at = list.len(into)
    if let Some(n) = expected {
        if n > list.capacity(into) - begin_at {
            return Invalid(TooLarge)
        }
    }
    match collect(mut c, mut into, mut probe) {
        Ok(()) => {},
        Error(e) => return receive_failure(e),
    }
    let n = list.len(into) - begin_at
    if let Some(want) = expected {
        if n != want {
            return Invalid(Fatal(Malformed))
        }
    }
    if status == 200 && expected == None {
        received.size = n
    }
    Received(Object(take received))
}

// An opened 2xx head (std.http_object): a 206 must carry the Content-Range
// that `range_span(want, size)` gives at the object size it names, and a Content-Length,
// if any, of that span; a 200 is the whole object and needs its length.
fn open_part(head: http_client.ResponseHead, want: Want, status: u16) -> Exchange {
    let tag = match object_request.header(head, "etag") {
        Some(value) => match etag(value) {
            Ok(found) => found,
            Error(take e) => return Invalid(take e),
        },
        None => empty_tag(),
    }
    let length = object_request.content_length(head)
    if status == 200 {
        let Some(size) = length else {
            return Invalid(Fatal(Malformed))
        }
        return Received(Headed(Part(status, first: 0, end: size, size, etag: tag)))
    }
    if status != 206 || want == Whole {
        return Invalid(Fatal(Malformed))
    }
    let Some(field) = object_request.header(head, "content-range") else {
        return Invalid(Fatal(Malformed))
    }
    let range = match content_range(field) {
        Ok(value) => value,
        Error(take e) => return Invalid(take e),
    }
    let Some((first, end)) = range_span(want, range.size) else {
        return Invalid(Fatal(Malformed))
    }
    if range.lo != first || range.hi != end || (length != None && length != Some(end - first)) {
        return Invalid(Fatal(Malformed))
    }
    Received(Headed(Part(status, first, end, size: range.size, etag: tag)))
}

fn location_setting(text: String) -> Result[String, Error] {
    let Some(at) = string.find(text, 0, "<LocationConstraint") else {
        return Error(Fatal(Malformed))
    }
    let suffix = at + string.byte_len("<LocationConstraint")
    let Some(close) = string.find(text, suffix, ">") else {
        return Error(Fatal(Malformed))
    }
    if suffix != close && !string.starts_with(string.slice(text, suffix, close), " ") {
        return Error(Fatal(Malformed))
    }
    let Some(end) = string.find(text, close + 1, "</LocationConstraint>") else {
        return Error(Fatal(Malformed))
    }
    object_xml.xml_decoded(string.slice(text, close + 1, end))
}

fn receive_control(mut c: http_client.Connection, octets: u64, put: Option[Inline[u8, 16]], op: Operation, status: u16, prefix: String, mut entries: List[Entry], mut buffer: Bytes, mut probe: Bytes, mut scratch: ListScratch) -> Exchange waits {
    if op == S3ListObjects && status == 200 {
        return listing(mut c, prefix, mut entries, mut buffer, mut probe, mut scratch)
    }
    list.clear(mut buffer)
    if let Error(e) = collect(mut c, mut buffer, mut probe) {
        return receive_failure(e)
    }
    if op == S3FetchChanged && status == 304 {
        return Received(NotModified)
    }
    if status < 200 || status >= 300 || object_xml.fragment(buffer, 0, string.as_bytes("<Error")) != None {
        return interpret_error(op, status, buffer)
    }
    if op == S3GetBucketLocation {
        let Ok(take text) = xml_text(buffer) else {
            return Invalid(Fatal(Malformed))
        }
        return match location_setting(text) {
            Ok(take value) => Received(BucketSetting(take value)),
            Error(take problem) => Invalid(take problem),
        }
    }
    if op == S3ListUploads {
        return parse_pending(buffer, prefix)
    }
    if op == S3Upload {
        let Ok(text) = xml_text(buffer) else {
            return Invalid(Fatal(Malformed))
        }
        let Some(id) = object_xml.xml_field(text, "UploadId") else {
            return Invalid(Fatal(Malformed))
        }
        return match object_xml.xml_decoded(id) {
            Ok(take value) => Received(Initiated(take value)),
            Error(take e) => Invalid(take e),
        }
    }
    let head = http_client.head(c)
    let mut info = match read_meta(head, if op == S3Head {
        size_or(object_request.content_length(head), 0)
    } else {
        octets
    }) {
        Ok(take value) => take value,
        Error(take e) => {
            if op == S3PutIf {
                return bad_success(op)
            }
            return Invalid(take e)
        },
    }
    if op == S3PutIf && !strong_tag(info.etag) {
        return bad_success(op)
    }
    if op == S3Complete || op == S3CompleteConditional {
        let Ok(text) = xml_text(buffer) else {
            return bad_success(op)
        }
        let Some(tag) = object_xml.xml_field(text, "ETag") else {
            return bad_success(op)
        }
        let Ok(decoded) = object_xml.xml_decoded(tag) else {
            return bad_success(op)
        }
        info.etag = match etag(string.as_bytes(decoded)) {
            Ok(value) => value,
            Error(_) => return bad_success(op),
        }
    }
    if (op == S3Put || op == S3PutConditional || op == S3Complete || op == S3CompleteConditional) {
        info.put_id = put
    }
    Received(Object(take info))
}

const IDLE_NS: u64 = 4000000000

const CONDITIONAL_IDLE_NS: u64 = 1000000000

const DNS_RESOLVE_SLICE_NS: u64 = 1000000000

const RESOLVE_NS: u64 = 300000000000

const PEER_COOLDOWN_NS: u64 = 100000000

type Held: send {
    connection: http_client.Connection,
    address: Addr,
    idle_at: u64
}

type PoolMessage: send = Acquire(u64, List[Ip]) | Connected(Addr) | Release(Addr, bool) | Measured(u64, Addr, u64) | Resolved(List[Ip])

type PoolReply: send = Address(Option[Addr]) | Rotate(bool)

type PeerHealth: send = Untried | Working | ConnectFailed

type Peer: send {
    ip: Ip,
    listed: bool,
    open: u64,
    blocked: u64,
    health: PeerHealth,
    count: u64,
    next: u64,
    rates: Inline[u64, 9]
}

type Pool: send {
    network: Net,
    clock: Clock,
    tasks: Tasks,
    server: Endpoint,
    input: Receiver[PoolMessage],
    timer_tx: Sender[PoolMessage],
    replies: List[Sender[PoolReply]],
    peers: List[Peer]
}

fn ip_equal(a: Ip, b: Ip) -> bool {
    match (a, b) {
        (V4(x), V4(y)) => x == y,
        (V6(x, y), V6(v, w)) => x == v && y == w,
        _ => false,
    }
}

fn peer_index(peers: List[Peer], ip: Ip) -> Option[u64] {
    for i in 0u64 .. list.len(peers) {
        if ip_equal(peers[i].ip, ip) {
            return Some(i)
        }
    }
    None
}

fn resolve_ips(n: Net, c: Clock, name: String, deadline: u64) -> Result[List[Ip], NetError] waits {
    let mut count = 16u64
    loop {
        let mut ips: List[Ip] = list.with_capacity(count)
        let resolved = host.resolve(n, name, mut ips, At(c, deadline))?
        if resolved == 0 {
            return Error(Reset)
        }
        if resolved < count {
            return Ok(take ips)
        }
        count *= 2
    }
}

fn update_peers(mut peers: List[Peer], ips: List[Ip]) {
    for i in 0u64 .. list.len(peers) {
        peers[i].listed = false
    }
    for ip in ips {
        if let Some(index) = peer_index(peers, ip) {
            peers[index].listed = true
        } else {
            list.push(mut peers, Peer(ip, listed: true, open: 0, blocked: 0, health: Untried, count: 0, next: 0, rates:[0; 9]))
        }
    }
    list.retain(mut peers, fn(p: Peer) -> bool {
        p.listed || p.open != 0
    })
}

fn resolve_peers(n: Net, c: Clock, name: String, deadline: u64, mut peers: List[Peer]) -> Result[(), NetError] waits {
    let ips = resolve_ips(n, c, name, deadline)?
    update_peers(mut peers, ips)
    Ok(())
}

type Dns: send {
    network: Net,
    clock: Clock,
    name: String,
    output: Sender[PoolMessage]
}

fn dns_loop(take dns: Dns) waits {
    let mut next = int.saturating_add(host.mono_ns(dns.clock), RESOLVE_NS)
    loop {
        host.sleep_until(dns.clock, next)
        let now = host.mono_ns(dns.clock)
        if let Ok(take ips) = resolve_ips(dns.network, dns.clock, dns.name, int.saturating_add(now, DNS_RESOLVE_SLICE_NS)) {
            if let Error(_) = channel.send(dns.output, Resolved(take ips)) {
                return
            }
        }
        let current = host.mono_ns(dns.clock)
        let skipped = (current - next) / RESOLVE_NS + 1
        next = int.saturating_add(next, int.saturating_mul(skipped, RESOLVE_NS))
    }
}

fn rate(p: Peer) -> u64 {
    if p.count == 0 {
        return 0
    }
    let mut ordered = p.rates
    for i in 1u64 .. p.count {
        let n = ordered[i]
        let mut j = i
        while j > 0 && ordered[j - 1] > n {
            ordered[j] = ordered[j - 1]
            j -= 1
        }
        ordered[j] = n
    }
    ordered[p.count / 2]
}

fn family_mask(ip: Ip) -> u8 {
    match ip {
        V4(_) => 1,
        V6(_, _) => 2,
    }
}

fn failing_families(peers: List[Peer]) -> u8 {
    let mut failed = 0u8
    let mut working = 0u8
    for peer in peers {
        if peer.listed {
            match peer.health {
                Untried => (),
                Working => {
                    working = working | family_mask(peer.ip)
                },
                ConnectFailed => {
                    failed = failed | family_mask(peer.ip)
                },
            }
        }
    }
    failed & ~working
}

fn peer_priority(peer: Peer, failed_families: u8) -> u8 {
    // A peer's own failure outranks any family penalty.
    let address_penalty = match peer.health {
        ConnectFailed => 2u8,
        _ => 0u8,
    }
    let family_penalty = if failed_families & family_mask(peer.ip) != 0 {
        1u8
    } else {
        0u8
    }
    address_penalty + family_penalty
}

fn available(peer: Peer, now: u64, tried: List[Ip]) -> bool {
    peer.listed && peer.blocked <= now && !list.contains(tried, peer.ip)
}

fn preferred(peers: List[Peer], i: u64, now: u64, tried: List[Ip], failed_families: u8) -> bool {
    if !available(peers[i], now, tried) {
        return false
    }
    let priority = peer_priority(peers[i], failed_families)
    let this_rate = rate(peers[i])
    let mut faster = 0u64
    let mut measured = 0u64
    for p in peers {
        if available(p, now, tried) {
            let other_priority = peer_priority(p, failed_families)
            if other_priority < priority {
                return false
            }
            if other_priority == priority && this_rate != 0 {
                let other = rate(p)
                if other == 0 {
                    continue
                }
                measured += 1
                if other > this_rate {
                    faster += 1
                }
            }
        }
    }
    this_rate == 0 || faster < (measured + 1) / 2
}

fn acquire(mut pool: Pool, tried: List[Ip]) -> Option[Addr] {
    let now = host.mono_ns(pool.clock)
    let failed_families = failing_families(pool.peers)
    let mut chosen: Option[u64] = None
    for i in 0u64 .. list.len(pool.peers) {
        if preferred(pool.peers, i, now, tried, failed_families) {
            if let Some(old) = chosen {
                if pool.peers[i].open < pool.peers[old].open {
                    chosen = Some(i)
                }
            } else {
                chosen = Some(i)
            }
        }
    }
    if let Some(i) = chosen {
        pool.peers[i].open += 1
        return Some(Addr(ip: pool.peers[i].ip, port: pool.server.port))
    }
    None
}

fn pool_loop(take setup: Pool) waits {
    let mut pool = take setup
    let dns = Dns(network: pool.network, clock: pool.clock, name: clone(pool.server.name), output: channel.sender(pool.timer_tx))
    let resolver = task.spawn(pool.tasks, bytes 65536, take dns, dns_loop)
    while let Ok(take message) = channel.receive(pool.input) {
        match take message {
            Acquire(lane, tried) => {
                let address = acquire(mut pool, tried)
                let _ = channel.try_send(pool.replies[lane], Address(address))
            },
            Connected(address) => {
                if let Some(i) = peer_index(pool.peers, address.ip) {
                    pool.peers[i].health = Working
                    pool.peers[i].blocked = 0
                }
            },
            Release(address, blocked) => {
                if let Some(i) = peer_index(pool.peers, address.ip) {
                    pool.peers[i].open -= 1
                    if blocked {
                        pool.peers[i].health = ConnectFailed
                        pool.peers[i].blocked = int.saturating_add(host.mono_ns(pool.clock), PEER_COOLDOWN_NS)
                    }
                    if pool.peers[i].open == 0 && !pool.peers[i].listed {
                        let _ = list.remove(mut pool.peers, i)
                    }
                }
            },
            Measured(lane, address, throughput) => {
                let now = host.mono_ns(pool.clock)
                let mut rotate = true
                if let Some(i) = peer_index(pool.peers, address.ip) {
                    if throughput != 0 {
                        let at = pool.peers[i].next
                        pool.peers[i].rates[at] = throughput
                        pool.peers[i].next = (at + 1) % 9
                        pool.peers[i].count = order.min(9, pool.peers[i].count + 1)
                    }
                    rotate = !preferred(pool.peers, i, now, list.new(), failing_families(pool.peers))
                }
                let _ = channel.try_send(pool.replies[lane], Rotate(rotate))
            },
            Resolved(ips) => update_peers(mut pool.peers, ips),
        }
    }
    let _ = task.cancel_join(take resolver)
}

type LaneMessage: send = Work(Job, Option[Sender[LaneEvent]]) | Ask(Job, Sender[Result[Value, Error]]) | Reap

type LaneEvent: send = Finished(Reply) | LaneFailed

resource type LaneOutput: send {
    tx: Sender[LaneEvent]
} drop(output) {
    let _ = channel.try_send(output.tx, LaneFailed)
}

const REFRESH_WINDOW_MS: u64 = 300000

const REFRESH_FIRST_MS: u64 = 100

const REFRESH_BUDGET_NS: u64 = 5000000000

type AuthState: send {
    credentials: cred.Credentials,
    signer: sigv4.Signer,
    day: u64
}

fn auth_state(c: Clock, region_name: String, take set: cred.Credentials) -> Result[AuthState, Error] {
    let key = secret.share(set.secret)
    match sigv4.open(c, take key, string.from(region_name), "s3") {
        Ok(take signer) => Ok(AuthState(credentials: take set, signer: take signer, day: host.wall_ms(c) / 86400000)),
        Error(_) => Error(Fatal(Malformed)),
    }
}

fn has_source(source: Option[Cred]) -> bool {
    match source {
        Some(_) => true,
        None => false,
    }
}

fn share_credentials(value: cred.Credentials) -> cred.Credentials {
    cred.Credentials(access_key_id: clone(value.access_key_id), secret: secret.share(value.secret), session_token: clone(value.session_token), expires_ns: value.expires_ns)
}

fn share_auth(state: AuthState) -> AuthState {
    AuthState(credentials: share_credentials(state.credentials), signer: sigv4.share_signer(state.signer), day: state.day)
}

fn clock_expired(c: Clock, expiry: u64) -> bool {
    expiry != MAX_U64 && int.saturating_mul(host.wall_ms(c), 1000000u64) >= expiry
}

type Restore: send {
    clock: Clock,
    network: Net,
    server: Endpoint,
    pool: Sender[PoolMessage],
    lease: Receiver[PoolReply],
    index: u64,
    config: Bucket,
    wire: WireBuffers,
    counts: RequestCounts,
    report: Latest[RequestCounts]
}

fn validate_credentials(n: Net, server: Endpoint, c: Clock, pool: Sender[PoolMessage], lease: Receiver[PoolReply], index: u64, bucket_path: String, proposed: AuthState, deadline: u64, mut wire: WireBuffers, mut counts: RequestCounts) -> bool waits {
    counts.jobs = int.saturating_add(counts.jobs, 1)
    if host.mono_ns(c) >= deadline {
        return false
    }
    let mut probe = new_job(S3Head, string.from(bucket_path), list.new(), deadline)
    let keys = sigv4.share_keys(proposed.signer)
    let request = match signed_request(mut probe, S3Head, server, keys, proposed.credentials.access_key_id, proposed.credentials.session_token, c, 0, None, 0, MAX_U64, empty_tag(), mut wire) {
        Ok(take req) => take req,
        Error(_) => return false,
    }
    let connection = connect_pool(n, server, c, pool, lease, index, deadline)
    let mut accepted = false
    let mut successful = false
    let mut seen = object_request.AttemptObservation(started: false, answered: false)
    if let Ok(take held) = take connection {
        let Held(connection: take stream, address, ..) = take held
        let mut conn = take stream
        if let Ok(()) = object_request.start_request(mut conn, request, deadline, mut seen) {
            if let Ok(()) = http_client.finish_request(mut conn, MAX_U64) {
                seen.answered = true
                let status = http_client.status(http_client.head(conn))
                accepted = status != 403
                successful = status >= 200 && status < 300
            }
        }
        http_client.close(take conn)
        let _ = channel.send(pool, Release(address, false))
    }
    object_request.count_attempt(mut counts, seen, false, successful)
    reclaim_request(mut wire, take request)
    accepted
}

fn validate(mut checker: Restore, proposed: AuthState, deadline: u64) -> bool waits {
    let path = request_path(checker.config, "", true)
    let valid = validate_credentials(checker.network, checker.server, checker.clock, checker.pool, checker.lease, checker.index, path, proposed, deadline, mut checker.wire, mut checker.counts)
    latest.publish(checker.report, arc.new(checker.counts))
    valid
}

fn adopt(mut checker: Restore, mut active: AuthState, take offered: cred.Credentials, deadline: u64) -> bool waits {
    if clock_expired(checker.clock, offered.expires_ns) {
        return false
    }
    let candidate = match auth_state(checker.clock, checker.config.aws_region, take offered) {
        Ok(take state) => take state,
        Error(_) => return false,
    }
    if validate(mut checker, candidate, deadline) {
        active = take candidate
        return true
    }
    false
}

type Renewal: send {
    source: Cred,
    validator: Restore,
    current: AuthState,
    updates: List[Sender[cred.Credentials]]
}

fn refresh_wall_ms(set: cred.Credentials) -> u64 {
    let expiry = set.expires_ns / 1000000
    expiry - order.min(REFRESH_WINDOW_MS, expiry)
}

fn renewal_loop(take input: Renewal) waits {
    let mut sync = take input
    let c = sync.validator.clock
    let mut next = refresh_wall_ms(sync.current.credentials)
    let mut backoff = REFRESH_FIRST_MS
    loop {
        host.sleep_until_wall(c, next)
        let now = host.wall_ms(c)
        let expiry = sync.current.credentials.expires_ns
        if clock_expired(c, expiry) {
            return
        }
        let remaining = expiry - int.saturating_mul(now, 1000000u64)
        let deadline = int.saturating_add(host.mono_ns(c), order.min(remaining, REFRESH_BUDGET_NS))
        let mut updated = false
        if let Ok(take candidate) = cred.credentials(sync.source, At(c, deadline)) {
            if adopt(mut sync.validator, mut sync.current, take candidate, deadline) {
                for tx in sync.updates {
                    let _ = channel.try_send(tx, share_credentials(sync.current.credentials))
                }
                updated = true
            }
        }
        if updated {
            backoff = REFRESH_FIRST_MS
            next = order.max(refresh_wall_ms(sync.current.credentials), int.saturating_add(host.wall_ms(c), backoff))
        } else {
            next = order.min(expiry / 1000000, int.saturating_add(host.wall_ms(c), backoff))
            backoff = order.min(REFRESH_WINDOW_MS, backoff * 2)
        }
    }
}

fn renew_lane(mut lane: Lane, deadline: u64) -> bool waits {
    let Some(source) = lane.source else {
        return false
    }
    let set = match cred.credentials(source, At(lane.clock, deadline)) {
        Ok(take fresh) => take fresh,
        Error(_) => return false,
    }
    if clock_expired(lane.clock, set.expires_ns) {
        return false
    }
    let candidate = match auth_state(lane.clock, lane.region_name, take set) {
        Ok(take new_state) => take new_state,
        Error(_) => return false,
    }
    let i = object_request.request_index(ValidateCredentials)
    if validate_credentials(lane.network, lane.server, lane.clock, lane.pool, lane.lease, lane.index, lane.bucket_path, candidate, deadline, mut lane.wire, mut lane.counts.rows[i]) {
        lane.auth = take candidate
        return true
    }
    false
}

fn take_refresh(mut lane: Lane) {
    let update: Option[cred.Credentials] = match lane.refresh {
        Some(rx) => {
            match channel.try_receive(rx) {
                Ok(take fresh) => Some(take fresh),
                Error(_) => None,
            }
        },
        None => None,
    }
    if let Some(take latest_set) = take update {
        if latest_set.expires_ns >= lane.auth.credentials.expires_ns && !clock_expired(lane.clock, latest_set.expires_ns) {
            if let Ok(take state) = auth_state(lane.clock, lane.region_name, take latest_set) {
                lane.auth = take state
            }
        }
    }
}

type Lane: send {
    index: u64,
    network: Net,
    tasks: Tasks,
    clock: Clock,
    random: Random,
    server: Endpoint,
    auth: AuthState,
    proof: Option[Secret],
    source: Option[Cred],
    refresh: Option[Receiver[cred.Credentials]],
    region_name: String,
    bucket_path: String,
    pool: Sender[PoolMessage],
    lease: Receiver[PoolReply],
    input: Receiver[LaneMessage],
    wake: Sender[LaneMessage],
    output: LaneOutput,
    held: Option[Held],
    wire: WireBuffers,
    control: Bytes,
    list_parsing: ListScratch,
    probe: Bytes,
    jitter: Bytes,
    skew: i64,
    counts: LaneCounts,
    report: Latest[LaneCounts]
}

fn connect_to(n: Net, server: Endpoint, address: Addr, clock: Clock, end: u64) -> Result[http_client.Connection, http_client.Error] waits {
    if server.secure {
        let trust: Trust = match server.roots {
            Some(cert) => Roots(copy_bytes(cert)),
            None => System,
        }
        http_client.open_tls(n, address, server.authority, server.name, trust, clock, end)
    } else {
        http_client.open(n, address, server.authority, clock, end)
    }
}

fn connect_pool(n: Net, server: Endpoint, clock: Clock, pool: Sender[PoolMessage], lease: Receiver[PoolReply], index: u64, end: u64) -> Result[Held, Reason] waits {
    // No request has been sent. Try each available address once before charging a retry.
    let mut tried: List[Ip] = list.new()
    let mut last: Reason = Net(Reset)
    loop {
        if let Error(_) = channel.send(pool, Acquire(index, clone(tried))) {
            return Error(take last)
        }
        let address = match channel.receive(lease) {
            Ok(Address(Some(addr))) => addr,
            _ => return Error(take last),
        }
        match connect_to(n, server, address, clock, end) {
            Ok(take stream) => {
                let _ = channel.send(pool, Connected(address))
                return Ok(Held(connection: take stream, address, idle_at: host.mono_ns(clock)))
            },
            Error(problem) => {
                if let Cancelled = problem {
                    let _ = channel.send(pool, Release(address, false))
                    return Error(Cancelled)
                }
                let _ = channel.send(pool, Release(address, true))
                if let Deadline = problem {
                    return Error(Deadline)
                }
                last = Http(problem)
                if host.mono_ns(clock) >= end {
                    return Error(Deadline)
                }
                list.push(mut tried, address.ip)
            },
        }
    }
}

fn release(mut lane: Lane) waits {
    let old = replace(mut lane.held, None)
    if let Some(take h) = take old {
        let Held(connection: take c, address, ..) = take h
        http_client.close(take c)
        let _ = channel.send(lane.pool, Release(address, false))
    }
}

fn exchange(mut lane: Lane, mut job: Job, op: Operation, mut progress: ReadProgress, crc: Option[u32], kind: RequestKind, retrying: bool) -> Exchange waits {
    let mut seen = object_request.AttemptObservation(started: false, answered: false)
    let result = exchange_once(mut lane, mut job, op, mut progress, crc, mut seen)
    let successful = match result {
        Received(_) => true,
        _ => false,
    }
    object_request.count_attempt(mut lane.counts.rows[object_request.request_index(kind)], seen, retrying, successful)
    take result
}

fn exchange_once(mut lane: Lane, mut job: Job, op: Operation, mut progress: ReadProgress, crc: Option[u32], mut seen: AttemptObservation) -> Exchange waits {
    let at = host.mono_ns(lane.clock)
    let idle_limit = if op == S3PutConditional || op == S3PutIf || op == S3Complete || op == S3CompleteConditional {
        CONDITIONAL_IDLE_NS
    } else {
        IDLE_NS
    }
    let expired = match lane.held {
        Some(old) => at - old.idle_at >= idle_limit,
        None => false,
    }
    if expired {
        release(mut lane)
    }
    let current = replace(mut lane.held, None)
    let mut h = match take current {
        Some(take held) => take held,
        None => {
            match connect_pool(lane.network, lane.server, lane.clock, lane.pool, lane.lease, lane.index, job.deadline) {
                Ok(take held) => take held,
                Error(take reason) => return Refused(Failure(phase: BeforeRequest, reason: take reason, status: 0, code: list.new(), server_time: None)),
            }
        },
    }
    let (from, to) = if object_request.payload_read(op) {
        (job.lo + (list.len(job.data) - progress.initial), job.hi)
    } else {
        (0u64, MAX_U64)
    }
    let sent_size = list.len(job.data)
    let keys = sigv4.share_keys(lane.auth.signer)
    let expected_tag = progress.tag
    let req = signed_request(mut job, op, lane.server, keys, lane.auth.credentials.access_key_id, lane.auth.credentials.session_token, lane.clock, lane.skew, crc, from, to, expected_tag, mut lane.wire)
    let result = match take req {
        Error(take e) => Invalid(take e),
        Ok(take wire) => {
            let response = transact(mut h.connection, wire, lane.proof, lane.server.secure, mut job, op, mut progress, from, to, mut lane.control, mut lane.probe, mut lane.list_parsing, mut seen)
            reclaim_request(mut lane.wire, take wire)
            take response
        },
    }
    if let Received(Headed(part)) = result {
        // The body stays unread on the connection, which leaves the lane.
        let Held(connection: take opened, address, ..) = take h
        let _ = channel.send(lane.pool, Release(address, false))
        return Received(Handed(part, box.new(take opened)))
    }
    let elapsed = host.mono_ns(lane.clock) - at
    let throughput: u64 = match result {
        Received(_) if elapsed != 0 => {
            let n = if object_request.payload_read(op) {
                list.len(job.data) - sent_size
            } else if object_request.uploads_body(op) {
                sent_size
            } else {
                0
            }
            int.saturating_mul(n, 1000000000u64) / elapsed
        },
        _ => 0,
    }
    let reusable = http_client.reusable(h.connection)
    let mut rotate = false
    if reusable || throughput != 0 {
        let _ = channel.send(lane.pool, Measured(lane.index, h.address, throughput))
        if let Ok(Rotate(value)) = channel.receive(lane.lease) {
            rotate = value
        }
    }
    if reusable && !rotate {
        h.idle_at = host.mono_ns(lane.clock)
        lane.held = Some(take h)
        return take result
    }
    let Held(connection: take c, address, ..) = take h
    http_client.close(take c)
    let _ = channel.send(lane.pool, Release(address, false))
    take result
}

fn proven_answer(head: http_client.ResponseHead, wire: http_client.Request, key: Secret) -> bool {
    let Some(text) = object_request.header(head, sim.s3.PROOF_FIELD) else {
        return false
    }
    if list.len(text) != 64 {
        return false
    }
    let mut tag: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32 {
        let hi = hex.digit(text[2 * i])
        if hi == 255 {
            return false
        }
        let lo = hex.digit(text[2 * i + 1])
        if lo == 255 {
            return false
        }
        list.push(mut tag, hi * 16 + lo)
    }
    for h in wire.headers {
        if h.name == "authorization" {
            let Public(value) = h.value else {
                return false
            }
            if let Ok(true) = secret.verify_hmac_sha256(key, sim.s3.proof_message(value), tag) {
                return true
            }
            return false
        }
    }
    false
}

fn transact(mut c: http_client.Connection, wire: http_client.Request, proof: Option[Secret], secure: bool, mut job: Job, op: Operation, mut progress: ReadProgress, from: u64, to: u64, mut control: Bytes, mut probe: Bytes, mut scratch: ListScratch, mut seen: AttemptObservation) -> Exchange waits {
    if let Error(e) = object_request.start_request(mut c, wire, job.deadline, mut seen) {
        return failure(if seen.started {
            RequestSent
        } else {
            BeforeRequest
        }, e)
    }
    if object_request.uploads_body(op) {
        match http_client.write(mut c, job.data) {
            Error(Write(Reset)) if !secure && op == S3PutIf => return failure(BeforeRequest, Write(Reset)),
            Error(e) => return failure(RequestSent, e),
            Ok(()) => (),
        }
    }
    if let Error(e) = http_client.finish_request(mut c, MAX_U64) {
        return failure(RequestSent, e)
    }
    if let Some(key) = proof {
        if !proven_answer(http_client.head(c), wire, key) {
            return Invalid(Fatal(Malformed))
        }
    }
    seen.answered = true
    let status = http_client.status(http_client.head(c))
    if op == S3Open && status >= 200 && status < 300 {
        return open_part(http_client.head(c), job.want, status)
    }
    if object_request.payload_read(op) && status >= 200 && status < 300 {
        return receive_object(mut c, mut job.data, mut progress, status, from, to, mut probe)
    }
    receive_control(mut c, list.len(job.data), job.id, op, status, job.prefix, mut job.entries, mut control, mut probe, mut scratch)
}

fn wait_retry(mut lane: Lane, attempt: u64, throttle: bool, deadline: u64) waits {
    let base = if throttle {
        THROTTLE_BACKOFF_NS
    } else {
        TRANSPORT_BACKOFF_NS
    }
    retry_backoff(lane.clock, lane.random, mut lane.jitter, base << (attempt - 1), deadline)
}

fn retry_backoff(clock: Clock, random: Random, mut entropy: Bytes, span: u64, deadline: u64) waits {
    list.clear(mut entropy)
    host.random(random, mut entropy)
    let mut sample = 0u64
    for b in entropy {
        sample = (sample << 8) | int.widen(b)
    }
    let wake = int.saturating_add(host.mono_ns(clock), span + sample % span)
    host.sleep_until(clock, order.min(wake, deadline))
}

type Resolution: send = Committed(Value) | Reissue | Doubtful | Undecided

fn resolve_write(mut lane: Lane, mut job: Job, mut read: ReadProgress, retrying: bool) -> Resolution waits {
    if host.mono_ns(lane.clock) >= job.deadline {
        return Undecided
    }
    match exchange(mut lane, mut job, S3Head, mut read, None, ReconcileWrite, retrying) {
        Received(Object(m)) => {
            if m.put_id == job.id {
                Committed(Object(m))
            } else {
                Committed(Existing)
            }
        },
        Refused(f) => {
            match object_request.classify(S3Head, f.phase, f.status, f.code, false, false) {
                Missing => Reissue,
                Retry => Undecided,
                Throttle => Undecided,
                _ => Doubtful,
            }
        },
        _ => Doubtful,
    }
}

fn retry(mut lane: Lane, mut job: Job) -> Result[Value, Error] waits {
    let i = object_request.request_index(ObjectRequest(job.op))
    lane.counts.rows[i].jobs = int.saturating_add(lane.counts.rows[i].jobs, 1)
    let mut uncertain: Option[Reason] = None
    let result = retry_job(mut lane, mut job, mut uncertain)
    latest.publish(lane.report, arc.new(lane.counts))
    match (take result, take uncertain) {
        (Error(_), Some(take reason)) => Error(Uncertain(take reason)),
        (other, _) => take other,
    }
}

fn retry_job(mut lane: Lane, mut job: Job, mut uncertain: Option[Reason]) -> Result[Value, Error] waits {
    let original_entries = list.len(job.entries)
    let initial_tag = if job.op == S3FetchChanged {
        empty_tag()
    } else {
        job.tag
    }
    let mut progress = ReadProgress(initial: list.len(job.data), size: None, tag: initial_tag)
    let crc = if job.op == S3Put || job.op == S3PutConditional || job.op == S3PutIf || job.op == S3Part {
        Some(crc32c.update(0, job.data))
    } else {
        None
    }
    let mut pending = false
    let mut probed = false
    let mut ambiguous = false
    let mut skewed = false
    let mut refreshed = false
    let mut last: Reason = Deadline
    let op = job.op
    let mut attempt = 0u64
    while attempt < MAX_ATTEMPTS && host.mono_ns(lane.clock) < job.deadline {
        take_refresh(mut lane)
        if clock_expired(lane.clock, lane.auth.credentials.expires_ns) {
            if refreshed || !renew_lane(mut lane, job.deadline) {
                return Error(Retriable(Status(403, copy_bytes(string.as_bytes("ExpiredToken")))))
            }
            refreshed = true
        }
        let day = host.wall_ms(lane.clock) / 86400000
        if day != lane.auth.day {
            if let Error(_) = sigv4.refresh(mut lane.auth.signer, lane.clock) {
                return Error(Fatal(Malformed))
            }
            lane.auth.day = day
        }
        attempt += 1
        let mut throttle = false
        if !pending {
            let outcome = exchange(mut lane, mut job, op, mut progress, crc, ObjectRequest(op), attempt > 1)
            match take outcome {
                Received(take value) => return Ok(take value),
                Invalid(take e) => {
                    list.truncate(mut job.entries, original_entries)
                    return Error(take e)
                },
                Refused(take response) => {
                    let Failure(phase, reason: take reason, status, code: take code, server_time) = take response
                    if let Cancelled = reason {
                        list.truncate(mut job.entries, original_entries)
                        return if phase != BeforeRequest && (op == S3PutConditional || op == S3PutIf || op == S3Complete || op == S3CompleteConditional) {
                            Error(Uncertain(take reason))
                        } else {
                            Error(Retriable(take reason))
                        }
                    }
                    let decision = object_request.classify(op, phase, status, code, ambiguous, progress.tag.len != 0)
                    last = take reason
                    match decision {
                        Accept => return Ok(Object(new_meta())),
                        AlreadyExists => return Ok(Existing),
                        Changed => return Error(Precondition),
                        Missing => {
                            if ambiguous && (op == S3Complete || op == S3CompleteConditional) {
                                pending = true
                            } else {
                                return Error(NotFound)
                            }
                        },
                        Reject => return Error(Fatal(take last)),
                        Refresh => {
                            if refreshed || attempt == MAX_ATTEMPTS || !renew_lane(mut lane, job.deadline) {
                                return Error(Fatal(take last))
                            }
                            refreshed = true
                            continue
                        },
                        Resolve => {
                            if !job.resolve_complete {
                                return Error(Uncertain(take last))
                            } else if op == S3PutIf {
                                if !job.retry_uncertain {
                                    return Error(Uncertain(take last))
                                }
                                uncertain = Some(take last)
                                last = Deadline
                                throttle = status == 429 || status == 503
                            } else {
                                pending = true
                                ambiguous = true
                            }
                        },
                        Throttle => {
                            throttle = true
                        },
                        CorrectSkew => {
                            let Some(corrected) = server_time else {
                                return Error(Fatal(take last))
                            }
                            if skewed || corrected > 253402300799000u64 {
                                return Error(Fatal(take last))
                            }
                            let server_ms: i64 = int.narrow(corrected)
                            let local_ms: i64 = int.narrow(host.wall_ms(lane.clock))
                            lane.skew = server_ms - local_ms
                            skewed = true
                        },
                        Retry => {},
                    }
                },
            }
        }
        if pending {
            let resolution = resolve_write(mut lane, mut job, mut progress, probed)
            probed = true
            match take resolution {
                Committed(take value) => return Ok(take value),
                Reissue => {
                    pending = false
                },
                Doubtful => return Error(Uncertain(take last)),
                Undecided => {},
            }
        }
        list.truncate(mut job.entries, original_entries)
        if object_request.payload_read(op) && list.len(job.data) > progress.initial && progress.tag.len == 0 {
            return Error(Retriable(take last))
        }
        if attempt < MAX_ATTEMPTS && host.mono_ns(lane.clock) < job.deadline {
            wait_retry(mut lane, attempt, throttle, job.deadline)
        }
    }
    if pending {
        return Error(Uncertain(take last))
    }
    if host.mono_ns(lane.clock) >= job.deadline {
        return Error(Retriable(Deadline))
    }
    Error(Retriable(take last))
}

type IdleTimer: send {
    clock: Clock,
    input: Receiver[u64],
    output: Sender[LaneMessage]
}

fn idle_timer(take timer: IdleTimer) waits {
    while let Ok(at) = channel.receive(timer.input) {
        host.sleep_until(timer.clock, at)
        if let Error(_) = channel.send(timer.output, Reap) {
            return
        }
    }
}

fn on_idle(lane: Lane) -> Option[u64] {
    match lane.held {
        Some(h) => Some(int.saturating_add(h.idle_at, IDLE_NS)),
        None => None,
    }
}

fn arm_idle(lane: Lane, arm: Sender[u64], mut armed: bool) waits {
    if !armed {
        if let Some(at) = on_idle(lane) {
            let _ = channel.send(arm, at)
            armed = true
        }
    }
}

fn lane_loop(take setup: Lane) waits {
    let mut lane = take setup
    let (arm, inbound): (Sender[u64], Receiver[u64]) = channel.new(1)
    let timer = task.spawn(lane.tasks, bytes 4096, IdleTimer(clock: lane.clock, input: take inbound, output: channel.sender(lane.wake)), idle_timer)
    let mut armed = false
    while let Ok(take next) = channel.receive(lane.input) {
        match take next {
            Ask(take pending, take reply) => {
                let mut job = take pending
                let result = retry(mut lane, mut job)
                arm_idle(lane, arm, mut armed)
                // A caller that stopped waiting drops the answer, and with it
                // any connection the answer holds; the lane goes on.
                let _ = channel.send(reply, take result)
            },
            Work(take pending, take answer) => {
                let mut job = take pending
                let result = retry(mut lane, mut job)
                arm_idle(lane, arm, mut armed)
                let Job(ticket, path: take path, data: take data, entries: take entries, ..) = take job
                let finished = Finished(Reply(lane: lane.index, ticket, path: take path, result: take result, data: take data, entries: take entries))
                if let Some(tx) = answer {
                    let _ = channel.try_send(tx, take finished)
                } else if let Error(_) = channel.send(lane.output.tx, take finished) {
                    break
                }
            },
            Reap => {
                armed = false
                if let Some(end) = on_idle(lane) {
                    if host.mono_ns(lane.clock) >= end {
                        release(mut lane)
                    } else {
                        let _ = channel.send(arm, end)
                        armed = true
                    }
                }
            },
        }
    }
    release(mut lane)
    let _ = task.cancel_join(take timer)
}

pub opaque type Requests: send {
    bucket: Bucket,
    simulated: bool,
    proven: bool,
    lanes: List[Sender[LaneMessage]],
    lane_bytes: u64,
    output: Receiver[LaneEvent],
    next: u64,
    random: Random,
    entropy: Bytes,
    path: String,
    clock: Clock,
    monitor: RequestMonitor
}

pub opaque type Workers {
    lanes: List[Task[()]],
    resolver: Task[()],
    renewal: Option[Task[()]]
}

pub opaque type Client {
    requests: Requests,
    workers: Option[Workers]
}

pub opaque type PendingStore {
    output: Receiver[LaneEvent]
}

/// Observes the client after its request endpoint has moved to another task.
pub opaque type RequestMonitor: send {
    lanes: List[Latest[LaneCounts]],
    renewal: Option[Latest[RequestCounts]]
}

pub fn request_monitor(c: Client) -> RequestMonitor {
    let mut lanes: List[Latest[LaneCounts]] = list.with_capacity(list.len(c.requests.monitor.lanes))
    for lane in c.requests.monitor.lanes {
        list.push(mut lanes, latest.handle(lane))
    }
    let renewal = match c.requests.monitor.renewal {
        Some(report) => Some(latest.handle(report)),
        None => None,
    }
    RequestMonitor(lanes: take lanes, renewal: take renewal)
}

/// Sums each lane's last completed job and the last credential check. Retries
/// are additional attempts for the same job and kind. A reconciliation HEAD
/// is counted separately from the write whose outcome it checks.
pub fn request_counts(m: RequestMonitor, kind: RequestKind) -> RequestCounts {
    let mut total = object_request.EMPTY_REQUEST_COUNTS
    let i = object_request.request_index(kind)
    for lane in m.lanes {
        let published = latest.read(lane)
        object_request.add_counts(mut total, published.rows[i])
    }
    if kind == ValidateCredentials {
        if let Some(report) = m.renewal {
            let published = latest.read(report)
            object_request.add_counts(mut total, published)
        }
    }
    total
}

/// Opens objects from any task through the client's lanes (std.http_object).
/// Each call is answered on its own channel; dropping the client cancels
/// the calls still waiting.
pub opaque type Opener: send {
    bucket: Bucket,
    lanes: List[Sender[LaneMessage]],
    clock: Clock
}

pub fn opener(c: Client) -> Opener {
    share_lanes(c.requests.bucket, c.requests.lanes, c.requests.clock)
}

pub fn share_opener(o: Opener) -> Opener {
    share_lanes(o.bucket, o.lanes, o.clock)
}

fn share_lanes(bucket: Bucket, lanes: List[Sender[LaneMessage]], clock: Clock) -> Opener {
    let mut copies: List[Sender[LaneMessage]] = list.with_capacity(list.len(lanes))
    for lane in lanes {
        list.push(mut copies, channel.sender(lane))
    }
    Opener(bucket: clone(bucket), lanes: take copies, clock)
}

/// The deadline `ms` milliseconds from now on the opener's clock.
pub fn opener_deadline_ms(o: Opener, ms: u64) -> u64 {
    clock.deadline_after_ms(host.mono_ns(o.clock), ms)
}

// One key always takes one lane: the byte sum of its path picks it.
fn ask(o: Opener, take job: Job) -> Result[Value, Error] waits {
    let mut index = 0u64
    for b in string.as_bytes(job.path) {
        index = (index + int.widen(b)) % list.len(o.lanes)
    }
    let (reply, answer): (Sender[Result[Value, Error]], Receiver[Result[Value, Error]]) = channel.new(1)
    if let Error(_) = channel.send(o.lanes[index], Ask(take job, take reply)) {
        return Error(Retriable(Cancelled))
    }
    match channel.receive(answer) {
        Ok(take result) => take result,
        Error(_) => Error(Retriable(Cancelled)),
    }
}

/// Sends a signed GET for `want` and returns once the store's head arrives,
/// with the body unread on the returned connection (std.http_object). The
/// Range field is signed with the request. A 416 is `Unsatisfiable`; a 404
/// is `NotFound`; a ranged 206 whose Content-Range is not the span `want`
/// resolves to at the size it names is `Fatal(Malformed)`.
pub fn open(o: Opener, key: String, want: Want, deadline_ns: u64) -> Result[Opened, Error] waits {
    if let Span(first, last) = want {
        if last < first {
            return Error(Fatal(Malformed))
        }
    }
    let mut job = new_job(S3Open, request_path(o.bucket, key, false), list.new(), deadline_ns)
    job.want = want
    match ask(o, take job) {
        Ok(Handed(part, take upstream)) => Ok(Ready(part, take upstream)),
        Error(Fatal(Status(416, _))) => Ok(Unsatisfiable),
        Ok(_) => Error(Fatal(Malformed)),
        Error(take e) => Error(take e),
    }
}

/// The object's metadata from a HEAD, through the opener's lanes.
pub fn stat(o: Opener, key: String, deadline_ns: u64) -> Result[Meta, Error] waits {
    as_meta(ask(o, new_job(S3Head, request_path(o.bucket, key, false), list.new(), deadline_ns)))
}

pub fn split(take c: Client) -> (Requests, Option[Workers]) {
    let Client(requests: take request_owner, workers: take lifetime) = take c
    (take request_owner, take lifetime)
}

pub fn attach(take requests: Requests, take workers: Option[Workers]) -> Client {
    Client(requests: take requests, workers: take workers)
}

type PartReceipt: send {
    size: u64,
    tag: ETag
}

pub opaque type Upload: send {
    path: String,
    upload_id: String,
    put_id: Inline[u8, 16],
    mode: Mode,
    parts: List[PartReceipt]
}

pub type LaneConfig: send {
    requested_lanes: u64,
    lane_bytes: u64
}

fn lane_count(config: LaneConfig) -> u64 {
    match config.requested_lanes {
        0 => DEFAULT_LANES,
        n => n,
    }
}

/// The reservation of the lane owner tasks.
pub fn lane_reservation(config: LaneConfig) -> Option[u64] {
    int.checked_mul(lane_count(config), config.lane_bytes)
}

/// Returns the active lanes and grants of the transferred request endpoint.
pub fn request_lanes(requests: Requests) -> LaneConfig {
    LaneConfig(requested_lanes: list.len(requests.lanes), lane_bytes: requests.lane_bytes)
}

/// Tests whether the client's active lanes use this count and grant.
pub fn matches_lanes(c: Client, config: LaneConfig) -> bool {
    let actual = request_lanes(c.requests)
    actual.requested_lanes == lane_count(config) && actual.lane_bytes == config.lane_bytes
}

/// Starts one owner task per lane. Supply the credential grant as source for
/// expiring credentials. Static credentials use None.
pub fn start(n: Net, tasks: Tasks, take bucket: Bucket, take credentials_set: cred.Credentials, source: Option[Cred], take trust: Trust, c: Clock, random: Random, config: LaneConfig, deadline: u64) -> Result[Client, Error] waits {
    let server = endpoint(bucket, take trust)?
    if has_source(source) && !server.secure {
        return Error(Fatal(Malformed))
    }
    let lanes = lane_count(config)
    let lane_bytes = config.lane_bytes
    let mut peers: List[Peer] = list.with_capacity(16)
    if let Error(e) = resolve_peers(n, c, server.name, deadline, mut peers) {
        return Error(Retriable(Net(e)))
    }
    let mut inputs: List[Sender[LaneMessage]] = list.with_capacity(lanes)
    let mut workers: List[Task[()]] = list.with_capacity(lanes)
    let mut reports: List[Latest[LaneCounts]] = list.with_capacity(lanes)
    let initial = object_request.LaneCounts(rows:[object_request.EMPTY_REQUEST_COUNTS; 19])
    let mut replies: List[Sender[PoolReply]] = list.with_capacity(lanes + 1)
    let mut send_credentials: List[Sender[cred.Credentials]] = list.new()
    if has_source(source) {
        send_credentials = list.with_capacity(lanes)
    }
    let (pool_tx, pool_rx): (Sender[PoolMessage], Receiver[PoolMessage]) = channel.new(lanes * 2 + 4)
    let bucket_path = request_path(bucket, "", true)
    let verified_loopback = server.proven
    let proof: Option[Secret] = if verified_loopback {
        Some(sim.s3.proof_key(credentials_set.secret) ?=> |_| Fatal(Malformed))
    } else {
        None
    }
    let active = auth_state(c, bucket.aws_region, take credentials_set)?
    let (tx, output): (Sender[LaneEvent], Receiver[LaneEvent]) = channel.new(lanes * 2)
    for index in 0u64 .. lanes {
        let (input, rx): (Sender[LaneMessage], Receiver[LaneMessage]) = channel.new(2)
        let (lease_tx, lease): (Sender[PoolReply], Receiver[PoolReply]) = channel.new(1)
        list.push(mut replies, take lease_tx)
        let auth = share_auth(active)
        let refresh: Option[Receiver[cred.Credentials]] = if !has_source(source) {
            None
        } else {
            let (updates, notices): (Sender[cred.Credentials], Receiver[cred.Credentials]) = channel.new(1)
            list.push(mut send_credentials, take updates)
            Some(take notices)
        }
        let events = match LaneOutput(tx: channel.sender(tx)) {
            Ok(take output_handle) => take output_handle,
            Error(_) => return Error(TooLarge),
        }
        let report = latest.new(arc.new(initial))
        list.push(mut reports, latest.handle(report))
        let setup = Lane(index, network: n, tasks, clock: c, random, server: clone(server), auth: take auth, proof: match proof {
            Some(key) => Some(secret.share(key)),
            None => None,
        }, source, refresh: take refresh, region_name: clone(bucket.aws_region), bucket_path: clone(bucket_path), pool: channel.sender(pool_tx), lease: take lease, input: take rx, wake: channel.sender(input), output: take events, held: None, wire: wire_buffers(), control: list.with_capacity(32768), list_parsing: list_scratch(), probe: list.with_capacity(1), jitter: list.with_capacity(8), skew: 0, counts: initial, report: take report)
        let worker = task.spawn(tasks, bytes lane_bytes, take setup, lane_loop)
        list.push(mut workers, take worker)
        list.push(mut inputs, take input)
    }
    let mut renewal_report: Option[Latest[RequestCounts]] = None
    let renewal: Option[Task[()]] = if let Some(grant) = source {
        let (lease_tx, lease): (Sender[PoolReply], Receiver[PoolReply]) = channel.new(1)
        list.push(mut replies, take lease_tx)
        let report = latest.new(arc.new(object_request.EMPTY_REQUEST_COUNTS))
        renewal_report = Some(latest.handle(report))
        let validator = Restore(clock: c, network: n, server: clone(server), pool: channel.sender(pool_tx), lease: take lease, index: lanes, config: clone(bucket), wire: wire_buffers(), counts: object_request.EMPTY_REQUEST_COUNTS, report: take report)
        let input = Renewal(source: grant, validator: take validator, current: take active, updates: take send_credentials)
        Some(task.spawn(tasks, bytes lane_bytes, take input, renewal_loop))
    } else {
        None
    }
    let pool = Pool(network: n, clock: c, tasks, server: take server, input: take pool_rx, timer_tx: take pool_tx, replies: take replies, peers: take peers)
    let resolver = task.spawn(tasks, bytes lane_bytes, take pool, pool_loop)
    let monitor = RequestMonitor(lanes: take reports, renewal: take renewal_report)
    let requests = Requests(bucket: take bucket, simulated: false, proven: verified_loopback, lanes: take inputs, lane_bytes, output: take output, next: 0, random, entropy: list.with_capacity(16), path: string.with_capacity(4096), clock: c, monitor: take monitor)
    let lifetime = Workers(lanes: take workers, resolver: take resolver, renewal: take renewal)
    Ok(Client(requests: take requests, workers: Some(take lifetime)))
}

/// Starts a client whose provider port belongs to the S3 simulator.
pub fn start_simulated(n: sim.s3.Endpoint, tasks: Tasks, take bucket: Bucket, take credentials_set: cred.Credentials, c: Clock, random: Random, config: LaneConfig, deadline: u64) -> Result[Client, Error] waits {
    let mut client = start(sim.s3.endpoint_network(n), tasks, take bucket, take credentials_set, None, System, c, random, config, deadline)?
    client.requests.simulated = true
    Ok(take client)
}

pub fn simulated(c: Client) -> bool {
    c.requests.simulated
}

/// Whether every answer this client accepts carries the loopback
/// simulator's proof for its credential (STORE §12.2).
pub fn proven(c: Client) -> bool {
    c.requests.proven
}

pub fn bucket_config(c: Client) -> Bucket {
    clone(c.requests.bucket)
}

/// Names later requests' keys, listings included, under `prefix` and
/// returns the old prefix; openers made earlier keep theirs. Cost: O(1).
pub fn set_prefix(mut c: Client, take prefix: String) -> String {
    replace(mut c.requests.bucket.prefix, take prefix)
}

pub fn endpoint_secure(c: Client) -> bool {
    string.starts_with(c.requests.bucket.endpoint, "https://")
}

fn new_job(op: Operation, take path: String, take data: Bytes, deadline: u64) -> Job {
    Job(ticket: 0, op, path: take path, query: string.from(""), data: take data, tag: empty_tag(), id: None, lo: 0, hi: MAX_U64, want: Whole, deadline, retry_uncertain: false, resolve_complete: true, prefix: string.new(), entries: list.new())
}

fn submit(input: Sender[LaneMessage], index: u64, take request: Job) -> Option[Reply] waits {
    match channel.send(input, Work(take request, None)) {
        Ok(()) => None,
        Error(Closed(Work(take returned, _))) => {
            let Job(ticket, path: take path, data: take data, entries: take entries, ..) = take returned
            Some(Reply(lane: index, ticket, path: take path, result: Error(Retriable(Cancelled)), data: take data, entries: take entries))
        },
        Error(_) => fail("object client submitted an invalid lane message"),
    }
}

fn receive(output: Receiver[LaneEvent]) -> Reply waits {
    match channel.receive(output) {
        Ok(Finished(take reply)) => take reply,
        _ => fail("object lane failed while owning a request"),
    }
}

fn next_lane(mut c: Client) -> u64 {
    let index = c.requests.next
    c.requests.next = (index + 1) % list.len(c.requests.lanes)
    index
}

fn run(mut c: Client, take request: Job) -> Reply waits {
    let index = next_lane(mut c)
    let mut reply = match submit(c.requests.lanes[index], index, take request) {
        Some(take result) => take result,
        None => receive(c.requests.output),
    }
    c.requests.path = replace(mut reply.path, string.from(""))
    take reply
}

fn object_job(mut c: Client, op: Operation, key: String, take data: Bytes, deadline: u64) -> Job {
    make_path(mut c.requests.path, c.requests.bucket, key, false)
    let path = replace(mut c.requests.path, string.from(""))
    new_job(op, take path, take data, deadline)
}

fn as_meta(take result: Result[Value, Error]) -> Result[Meta, Error] {
    let Object(take value) = result? else {
        return Error(Fatal(Malformed))
    }
    Ok(take value)
}

fn as_created(take result: Result[Value, Error]) -> Result[Created, Error] {
    match result? {
        Object(take value) => Ok(Created(take value)),
        Existing => Ok(Exists),
        _ => Error(Fatal(Malformed)),
    }
}

fn as_unit(take result: Result[Value, Error]) -> Result[(), Error] {
    let _ = result?
    Ok(())
}

/// The deadline `ms` milliseconds from now on the clock the client was started with.
pub fn deadline_after_ms(c: Client, ms: u64) -> u64 {
    clock.deadline_after_ms(host.mono_ns(c.requests.clock), ms)
}

/// Waits before retrying an operation that spans several object requests.
/// The first retry is attempt 0. Sleep never extends past the operation deadline.
pub fn pause_retry(mut c: Client, attempt: u64, deadline_ns: u64) waits {
    if host.mono_ns(c.requests.clock) < deadline_ns {
        let span = TRANSPORT_BACKOFF_NS << order.min(attempt, MAX_ATTEMPTS - 1)
        retry_backoff(c.requests.clock, c.requests.random, mut c.requests.entropy, span, deadline_ns)
    }
}

pub fn fetch(mut c: Client, key: String, take into: Bytes, deadline_ns: u64) -> (Result[Meta, Error], Bytes) waits {
    let request = object_job(mut c, S3Fetch, key, take into, deadline_ns)
    let Reply(result: take result, data: take data, ..) = run(mut c, take request)
    (as_meta(take result), take data)
}

/// A conditional GET. None means the service returned 304 without a body.
/// The entity tag's field value as the store sent it, quotes included.
pub fn tag_value(tag: ETag) -> Bytes {
    let mut out: Bytes = list.with_capacity(tag.len)
    for i in 0u64 .. tag.len {
        list.push(mut out, tag.octets[i])
    }
    take out
}

/// RFC 9110 §8.8.3.2 strong comparison: both tags are strong and their
/// octets are equal. A weak tag (`W/"x"`) or a malformed one never matches.
pub fn strong_match(tag: ETag, value: Bytes) -> bool {
    match etag(value) {
        Ok(other) => strong_tag(tag) && strong_tag(other) && tag == other,
        Error(_) => false,
    }
}

pub fn fetch_if_changed(mut c: Client, key: String, unchanged: ETag, take into: Bytes, deadline_ns: u64) -> (Result[Option[Meta], Error], Bytes) waits {
    if !strong_tag(unchanged) {
        return (Error(Precondition), take into)
    }
    let mut request = object_job(mut c, S3FetchChanged, key, take into, deadline_ns)
    request.tag = unchanged
    let Reply(result: take received, data: take data, ..) = run(mut c, take request)
    let extracted: Result[Option[Meta], Error] = match take received {
        Ok(Object(take meta)) => Ok(Some(take meta)),
        Ok(NotModified) => Ok(None),
        Error(take problem) => Error(take problem),
        _ => Error(Fatal(Malformed)),
    }
    (take extracted, take data)
}

fn read_bucket_setting(mut c: Client, op: Operation, query: String, deadline_ns: u64) -> Result[String, Error] waits {
    make_path(mut c.requests.path, c.requests.bucket, "", true)
    let path = replace(mut c.requests.path, string.new())
    let mut request = new_job(op, take path, list.new(), deadline_ns)
    request.query = string.from(query)
    let Reply(result: take received, ..) = run(mut c, take request)
    match take received {
        Ok(BucketSetting(take value)) => Ok(take value),
        Error(take problem) => Error(take problem),
        _ => Error(Fatal(Malformed)),
    }
}

pub fn bucket_location(mut c: Client, deadline_ns: u64) -> Result[String, Error] waits {
    read_bucket_setting(mut c, S3GetBucketLocation, "location=", deadline_ns)
}

/// A nonempty byte interval, inclusive at lo and exclusive at hi.
pub fn fetch_range(mut c: Client, key: String, lo: u64, hi: u64, take into: Bytes, deadline_ns: u64) -> (Result[Meta, Error], Bytes) waits {
    if lo >= hi {
        return (Error(Precondition), take into)
    }
    let mut request = object_job(mut c, S3FetchRange, key, take into, deadline_ns)
    request.lo = lo
    request.hi = hi
    let Reply(result: take result, data: take data, ..) = run(mut c, take request)
    (as_meta(take result), take data)
}

pub type GetRange: send {
    key: String,
    lo: u64,
    hi: u64,
    buffer: Bytes,
    deadline: u64
}

/// Fetch ranges concurrently on up to `streams` lanes. Results and their
/// buffers follow request order, including errors.
pub fn fetch_ranges(mut c: Client, take ranges: List[GetRange], streams: u64) -> List[(Result[Meta, Error], Bytes)] waits {
    let n = list.len(ranges)
    let mut queued: List[Option[Job]] = list.with_capacity(n)
    let mut slots: List[u64] = list.with_capacity(n)
    let mut results: List[Option[(Result[Meta, Error], Bytes)]] = list.with_capacity(n)
    for take range_request in take ranges {
        let GetRange(key: name, lo: lo, hi: hi, buffer: take into, deadline: until) = take range_request
        if streams == 0 || lo >= hi {
            list.push(mut results, Some((Error(Precondition), take into)))
            continue
        }
        let mut request = object_job(mut c, S3FetchRange, name, take into, until)
        request.lo = lo
        request.hi = hi
        list.push(mut slots, list.len(results))
        list.push(mut queued, Some(take request))
        list.push(mut results, None)
    }
    let replies = run_batch(c, take queued, streams)
    let mut at = 0u64
    for take one in replies {
        let Reply(result: take status, data: take data, ..) = option.unwrap(take one)
        let _ = list.set(mut results, slots[at], Some((as_meta(take status), take data)))
        at += 1
    }
    let mut ordered: List[(Result[Meta, Error], Bytes)] = list.with_capacity(n)
    for take one in take results {
        list.push(mut ordered, option.unwrap(take one))
    }
    take ordered
}

pub fn store(mut c: Client, key: String, take body: Bytes, deadline_ns: u64) -> (Result[Meta, Error], Bytes) waits {
    let mut request = object_job(mut c, S3Put, key, take body, deadline_ns)
    request.id = Some(object_request.fresh_id(c.requests.random, mut c.requests.entropy))
    let Reply(result: take result, data: take data, ..) = run(mut c, take request)
    (as_meta(take result), take data)
}

pub fn store_no_clobber(mut c: Client, key: String, take body: Bytes, deadline_ns: u64) -> (Result[Created, Error], Bytes) waits {
    let mut request = object_job(mut c, S3PutConditional, key, take body, deadline_ns)
    request.id = Some(object_request.fresh_id(c.requests.random, mut c.requests.entropy))
    let Reply(result: take result, data: take data, ..) = run(mut c, take request)
    (as_created(take result), take data)
}

/// Conditional PUT. The caller resolves an Uncertain outcome using its own
/// protocol. The client returns the unmodified body so it can resend it.
pub fn store_if(mut c: Client, key: String, pre: Precondition, take body: Bytes, deadline_ns: u64) -> (Result[Conditional, Error], Bytes) waits {
    match conditional_job(mut c, key, pre, take body, deadline_ns) {
        Ok(take request) => conditional_reply(run(mut c, take request)),
        Error((take returned, take problem)) => (Error(take problem), take returned),
    }
}

/// Conditional PUT with a single retry budget for transport failures and
/// uncertain responses. Every retry uses the original body and precondition.
/// The caller inspects the object to resolve Mismatch.
pub fn store_if_retry(mut c: Client, key: String, pre: Precondition, take body: Bytes, deadline_ns: u64) -> (Result[Conditional, Error], Bytes) waits {
    match store_if_issue(mut c, key, pre, take body, deadline_ns) {
        Ok(take pending) => store_if_finish(mut c, take pending),
        Error((take returned, take problem)) => (Error(take problem), take returned),
    }
}

/// Builds and admits a retrying conditional PUT before sending it. A
/// successful send hands ownership to the lane and issue returns without waiting again.
pub fn store_if_issue(mut c: Client, key: String, pre: Precondition, take body: Bytes, deadline_ns: u64) -> Result[PendingStore, (Bytes, Error)] waits {
    let mut request = conditional_job(mut c, key, pre, take body, deadline_ns)?
    request.retry_uncertain = true
    let index = next_lane(mut c)
    match issue_with_reply(c.requests.lanes[index], take request) {
        Ok(take output) => Ok(PendingStore(output: take output)),
        Error(take returned) => {
            let Job(path: take path, data: take data, ..) = take returned
            c.requests.path = take path
            Error((take data, Retriable(Cancelled)))
        },
    }
}

fn issue_with_reply(input: Sender[LaneMessage], take request: Job) -> Result[Receiver[LaneEvent], Job] waits {
    let (tx, rx): (Sender[LaneEvent], Receiver[LaneEvent]) = channel.new(1)
    match channel.send(input, Work(take request, Some(take tx))) {
        Ok(()) => Ok(take rx),
        Error(Closed(Work(take returned, _))) => Error(take returned),
        Error(_) => fail("object client submitted an invalid lane message"),
    }
}

/// Storage for the one-element reply channel of an isolated call.
pub const ISOLATED_REPLY_BYTES: u64 = 64 + bytes[LaneEvent]

/// A pre-encoded object path with request-owned storage. Use with the client
/// that built it. A completed call returns the storage. A deadline after
/// handoff leaves the storage with the lane and expires this request.
pub opaque type IsolatedRequest {
    path: String
}

pub fn isolated_request(c: Client, prefix: String, key: String) -> IsolatedRequest {
    let bucket = view c.requests.bucket
    let mut path = string.with_capacity(2 + 3 * (string.byte_len(bucket.bucket) + string.byte_len(prefix) + string.byte_len(key)))
    string.push_char(mut path, '/')
    if bucket.style == Path {
        object_request.percent_encode(mut path, string.as_bytes(bucket.bucket), false)
        string.push_char(mut path, '/')
    }
    object_request.percent_encode(mut path, string.as_bytes(prefix), true)
    object_request.percent_encode(mut path, string.as_bytes(key), true)
    IsolatedRequest(path: take path)
}

fn isolated_admit(input: Sender[LaneMessage], take pending: Job, c: Clock) -> Result[Receiver[LaneEvent], (Job, Error)] waits {
    let (tx, rx): (Sender[LaneEvent], Receiver[LaneEvent]) = channel.new(1)
    let deadline = pending.deadline
    let mut job = take pending
    loop {
        let now = host.mono_ns(c)
        if now >= deadline {
            return Error((take job, Retriable(Deadline)))
        }
        match channel.try_send(input, Work(take job, Some(channel.sender(tx)))) {
            Ok(()) => return Ok(take rx),
            Error(Full(Work(take returned, _))) => {
                job = take returned
                host.sleep_until(c, order.min(deadline, int.saturating_add(now, 1000000)))
            },
            Error(Closed(Work(take returned, _))) => return Error((take returned, Retriable(Cancelled))),
            Error(_) => fail("object client submitted an invalid isolated lane message"),
        }
    }
}

fn run_isolated(mut c: Client, mut isolated: IsolatedRequest, take request: Job) -> Reply waits {
    let index = next_lane(mut c)
    let deadline = request.deadline
    let put = request.op == S3PutIf
    let mut reply = match isolated_admit(c.requests.lanes[index], take request, c.requests.clock) {
        Ok(take output) => match channel.receive_until(output, At(c.requests.clock, deadline)) {
            Ok(Finished(take arrived)) => take arrived,
            other => {
                let why: Reason = match other {
                    Error(Empty) => Deadline,
                    _ => Cancelled,
                }
                let problem: Error = if put {
                    Uncertain(take why)
                } else {
                    Retriable(take why)
                }
                Reply(lane: index, ticket: 0, path: string.new(), result: Error(take problem), data: list.new(), entries: list.new())
            },
        },
        Error((take returned, take problem)) => {
            let Job(ticket, path: take path, data: take data, entries: take entries, ..) = take returned
            Reply(lane: index, ticket, path: take path, result: Error(take problem), data: take data, entries: take entries)
        },
    }
    isolated.path = replace(mut reply.path, string.new())
    take reply
}

/// A GET with a private reply, usable during cancellation cleanup.
pub fn fetch_isolated(mut c: Client, mut isolated: IsolatedRequest, take into: Bytes, deadline: u64) -> (Result[Meta, Error], Bytes) waits {
    if string.byte_len(isolated.path) == 0 {
        return (Error(Precondition), take into)
    }
    let request = new_job(S3Fetch, replace(mut isolated.path, string.new()), take into, deadline)
    let Reply(result: take result, data: take data, ..) = run_isolated(mut c, mut isolated, take request)
    (as_meta(take result), take data)
}

/// A conditional PUT with a private reply. Uncertain outcomes are returned
/// to the caller without retry on possible delivery.
pub fn store_if_isolated(mut c: Client, mut isolated: IsolatedRequest, pre: Precondition, take body: Bytes, deadline: u64) -> (Result[Conditional, Error], Bytes) waits {
    if string.byte_len(isolated.path) == 0 {
        return (Error(Precondition), take body)
    }
    let tag = match pre {
        Match(value) if strong_tag(value) => value,
        Match(_) => return (Error(Precondition), take body),
        Absent => empty_tag(),
    }
    let mut request = new_job(S3PutIf, replace(mut isolated.path, string.new()), take body, deadline)
    request.tag = tag
    conditional_reply(run_isolated(mut c, mut isolated, take request))
}

/// Waits for the issued PUT's result and returns its body to the caller.
/// Use the issuing client to reclaim its path buffer.
pub fn store_if_finish(mut c: Client, take pending: PendingStore) -> (Result[Conditional, Error], Bytes) waits {
    let mut reply = receive(pending.output)
    c.requests.path = replace(mut reply.path, string.new())
    conditional_reply(take reply)
}

fn conditional_job(mut c: Client, key: String, pre: Precondition, take body: Bytes, deadline_ns: u64) -> Result[Job, (Bytes, Error)] {
    let tag = match pre {
        Match(value) if strong_tag(value) => value,
        Match(_) => return Error((take body, Precondition)),
        Absent => empty_tag(),
    }
    let mut request = object_job(mut c, S3PutIf, key, take body, deadline_ns)
    request.tag = tag
    Ok(take request)
}

fn conditional_reply(take reply: Reply) -> (Result[Conditional, Error], Bytes) {
    let Reply(result: take result, data: take data, ..) = take reply
    let outcome: Result[Conditional, Error] = match take result {
        Ok(Object(take meta)) => Ok(Applied(take meta)),
        Ok(Existing) => Ok(Mismatch),
        Error(take e) => Error(take e),
        _ => Error(Fatal(Malformed)),
    }
    (take outcome, take data)
}

pub fn erase(mut c: Client, key: String, deadline_ns: u64) -> Result[(), Error] waits {
    let request = object_job(mut c, S3Erase, key, list.new(), deadline_ns)
    let Reply(result: take result, ..) = run(mut c, take request)
    as_unit(take result)
}

pub const LIST_PAGE_MAX: u64 = 1000

pub fn list(mut c: Client, prefix: String, after: String, mut into: List[Entry], deadline_ns: u64) -> Result[Page, Error] waits {
    let room = order.min(LIST_PAGE_MAX, list.capacity(into) - list.len(into))
    if room == 0 {
        return Error(TooLarge)
    }
    let path = request_path(c.requests.bucket, "", true)
    let mut request = new_job(S3ListObjects, take path, list.new(), deadline_ns)
    request.prefix = clone(c.requests.bucket.prefix)
    let mut query = string.from("list-type=2&max-keys=")
    string.push_u64(mut query, room)
    string.push(mut query, "&prefix=")
    object_request.percent_encode(mut query, string.as_bytes(c.requests.bucket.prefix), false)
    object_request.percent_encode(mut query, string.as_bytes(prefix), false)
    if after != "" {
        string.push(mut query, "&start-after=")
        object_request.percent_encode(mut query, string.as_bytes(c.requests.bucket.prefix), false)
        object_request.percent_encode(mut query, string.as_bytes(after), false)
    }
    request.query = take query
    request.entries = replace(mut into, list.new())
    let Reply(result: take result, entries: take entries, ..) = run(mut c, take request)
    into = take entries
    match take result {
        Ok(Listed(take page)) => Ok(take page),
        Error(take e) => Error(take e),
        _ => Error(Fatal(Malformed)),
    }
}

pub fn upload(mut c: Client, key: String, mode: Mode, deadline_ns: u64) -> Result[Upload, Error] waits {
    let path = request_path(c.requests.bucket, key, false)
    let mut request = new_job(S3Upload, clone(path), list.new(), deadline_ns)
    let id = object_request.fresh_id(c.requests.random, mut c.requests.entropy)
    request.id = Some(id)
    request.query = string.from("uploads=")
    let Reply(result: take result, ..) = run(mut c, take request)
    match take result {
        Ok(Initiated(take upload_id)) => Ok(Upload(path: take path, upload_id: take upload_id, put_id: id, mode, parts: list.new())),
        Error(take e) => Error(take e),
        _ => Error(Fatal(Malformed)),
    }
}

const PENDING_PAGE: u64 = 16

pub opaque type UploadCursor: send {
    key: String,
    id: String
}

pub type PendingUpload: send {
    key: String,
    handle: Upload
}

fn upload_listing(mut c: Client, prefix: String, after: Option[UploadCursor], deadline_ns: u64) -> Result[Value, Error] waits {
    let path = request_path(c.requests.bucket, "", true)
    let mut request = new_job(S3ListUploads, take path, list.new(), deadline_ns)
    request.prefix = clone(c.requests.bucket.prefix)
    let mut query = string.new()
    if let Some(marker) = after {
        string.push(mut query, "key-marker=")
        object_request.percent_encode(mut query, string.as_bytes(marker.key), false)
        string.push_char(mut query, '&')
    }
    string.push(mut query, "max-uploads=")
    string.push_u64(mut query, PENDING_PAGE)
    string.push(mut query, "&prefix=")
    object_request.percent_encode(mut query, string.as_bytes(c.requests.bucket.prefix), false)
    object_request.percent_encode(mut query, string.as_bytes(prefix), false)
    if let Some(marker) = after {
        string.push(mut query, "&upload-id-marker=")
        object_request.percent_encode(mut query, string.as_bytes(marker.id), false)
    }
    string.push(mut query, "&uploads=")
    request.query = take query
    let Reply(result: take result, ..) = run(mut c, take request)
    take result
}

fn pending_handle(mut c: Client, key: String, take id: String) -> Upload {
    let path = request_path(c.requests.bucket, key, false)
    let put_id = object_request.fresh_id(c.requests.random, mut c.requests.entropy)
    Upload(path: take path, upload_id: take id, put_id, mode: Overwrite, parts: list.new())
}

/// Appends handles for up to 16 multipart uploads still pending under the
/// prefix, for `abort`. The result is true when more remain.
pub fn pending_uploads(mut c: Client, prefix: String, mut into: List[Upload], deadline_ns: u64) -> Result[bool, Error] waits {
    let listed = upload_listing(mut c, prefix, None, deadline_ns)?
    let Pending(take keys, take ids, more, _) = take listed else {
        return Error(Fatal(Malformed))
    }
    let mut i = 0u64
    for take id in take ids {
        list.push(mut into, pending_handle(mut c, keys[i], take id))
        i += 1
    }
    Ok(more)
}

/// Lists a page of pending uploads together with their relative object keys.
/// Pass the returned cursor to continue, even if every upload on this page
/// must be kept. None marks the final page.
pub fn pending_uploads_page(mut c: Client, prefix: String, after: Option[UploadCursor], mut into: List[PendingUpload], deadline_ns: u64) -> Result[Option[UploadCursor], Error] waits {
    let listed = upload_listing(mut c, prefix, after, deadline_ns)?
    let Pending(take keys, take ids, more, take cursor) = take listed else {
        return Error(Fatal(Malformed))
    }
    if more {
        let Some(marker) = view cursor else {
            return Error(Fatal(Malformed))
        }
        if let Some(previous) = after {
            if marker.key == previous.key && marker.id == previous.id {
                return Error(Fatal(Malformed))
            }
        }
    }
    let mut i = 0u64
    for take id in take ids {
        let handle = pending_handle(mut c, keys[i], take id)
        list.push(mut into, PendingUpload(key: string.from(keys[i]), handle: take handle))
        i += 1
    }
    Ok(take cursor)
}

fn upload_query(u: Upload, number: u64) -> String {
    let mut query = string.from("")
    if number != 0 {
        string.push(mut query, "partNumber=")
        string.push_u64(mut query, number)
        string.push_char(mut query, '&')
    }
    string.push(mut query, "uploadId=")
    object_request.percent_encode(mut query, string.as_bytes(u.upload_id), false)
    take query
}

fn first_error(mut current: Result[(), Error], take next: Error) {
    if let Ok(()) = current {
        current = Error(take next)
    }
}

fn dispatch_next(c: Client, lane_index: u64, mut jobs: List[Option[Job]], mut replies: List[Option[Reply]], mut next: u64) -> bool waits {
    while next < list.len(jobs) {
        let ticket = next
        next += 1
        let Some(take pending) = list.set(mut jobs, ticket, None) else {
            fail("object batch dispatched a job twice")
        }
        let mut request = take pending
        request.ticket = ticket
        let returned = submit(c.requests.lanes[lane_index], lane_index, take request)
        if let Some(take reply) = take returned {
            let _ = list.set(mut replies, ticket, Some(take reply))
        } else {
            return true
        }
    }
    false
}

fn run_batch(c: Client, take queued: List[Option[Job]], streams: u64) -> List[Option[Reply]] waits {
    let mut jobs = take queued
    let mut replies: List[Option[Reply]] = list.with_capacity(list.len(jobs))
    for _ in 0u64 .. list.len(jobs) {
        list.push(mut replies, None)
    }
    let mut next = 0u64
    let mut active = 0u64
    for lane_index in 0u64 .. order.min(streams, order.min(list.len(c.requests.lanes), list.len(jobs))) {
        if dispatch_next(c, lane_index, mut jobs, mut replies, mut next) {
            active += 1
        }
    }
    while active > 0 {
        let reply = receive(c.requests.output)
        let lane_index = reply.lane
        let ticket = reply.ticket
        let _ = list.set(mut replies, ticket, Some(take reply))
        if !dispatch_next(c, lane_index, mut jobs, mut replies, mut next) {
            active -= 1
        }
    }
    take replies
}

pub const MULTIPART_MAX_PARTS: u64 = 10000

pub const MULTIPART_MAX_PART_BYTES: u64 = 5 * 1024 * 1024 * 1024

pub fn parts(mut c: Client, mut u: Upload, take bodies: List[Bytes], deadline_ns: u64) -> (Result[(), Error], List[Bytes]) waits {
    let mut returned = take bodies
    let count = list.len(returned)
    let existing = list.len(u.parts)
    if count > MULTIPART_MAX_PARTS - existing {
        return (Error(TooLarge), take returned)
    }
    let mut queued: List[Option[Job]] = list.with_capacity(count)
    for i in 0u64 .. count {
        let data = list.set(mut returned, i, list.new())
        let mut request = new_job(S3Part, clone(u.path), take data, deadline_ns)
        request.query = upload_query(u, existing + i + 1)
        list.push(mut queued, Some(take request))
    }
    let mut status: Result[(), Error] = Ok(())
    let rv = run_batch(c, take queued, list.len(c.requests.lanes))
    let mut i = 0u64
    for take slot in rv {
        let Reply(result: take outcome, data: take data, ..) = option.unwrap(take slot)
        match as_meta(take outcome) {
            Ok(meta) => {
                if meta.etag.len == 0 {
                    first_error(mut status, Fatal(Malformed))
                } else {
                    list.push(mut u.parts, PartReceipt(size: list.len(data), tag: meta.etag))
                }
            },
            Error(take e) => first_error(mut status, take e),
        }
        let _ = list.set(mut returned, i, take data)
        i += 1
    }
    if let Error(_) = status {
        list.truncate(mut u.parts, existing)
    }
    (take status, take returned)
}

fn xml_encode(mut out: String, raw: Bytes) {
    for b in raw {
        match b {
            b'&' => string.push(mut out, "&amp;"),
            b'<' => string.push(mut out, "&lt;"),
            b'>' => string.push(mut out, "&gt;"),
            _ => string.push_char(mut out, ascii(b)),
        }
    }
}

pub fn complete(mut c: Client, take u: Upload, deadline_ns: u64) -> Result[Created, Error] waits {
    let mut owned = take u
    let path = replace(mut owned.path, string.new())
    complete_upload(mut c, owned, take path, true, deadline_ns)
}

/// Complete an upload with caller-owned resolution of uncertain replies.
/// The handle remains available to abort if the caller starts a new upload.
pub fn complete_unresolved(mut c: Client, u: Upload, deadline_ns: u64) -> Result[Created, Error] waits {
    complete_upload(mut c, u, clone(u.path), false, deadline_ns)
}

fn complete_upload(mut c: Client, u: Upload, take path: String, resolve: bool, deadline_ns: u64) -> Result[Created, Error] waits {
    if list.len(u.parts) == 0 {
        return Error(Precondition)
    }
    let mut xml = string.from("<CompleteMultipartUpload>")
    let mut size = 0u64
    for i in 0u64 .. list.len(u.parts) {
        let p = u.parts[i]
        string.push(mut xml, "<Part><PartNumber>")
        string.push_u64(mut xml, i + 1)
        string.push(mut xml, "</PartNumber><ETag>")
        xml_encode(mut xml, tag_bytes(p.tag))
        string.push(mut xml, "</ETag></Part>")
        size += p.size
    }
    string.push(mut xml, "</CompleteMultipartUpload>")
    let operation: Operation = if u.mode == NoClobber {
        S3CompleteConditional
    } else {
        S3Complete
    }
    let query = upload_query(u, 0)
    let mut request = new_job(operation, take path, string.into_bytes(take xml), deadline_ns)
    request.query = take query
    request.id = Some(u.put_id)
    request.resolve_complete = resolve
    let Reply(result: take result, ..) = run(mut c, take request)
    match as_created(take result) {
        Ok(Created(take m)) => {
            let mut meta = take m
            meta.size = size
            Ok(Created(take meta))
        },
        other => take other,
    }
}

pub fn abort(mut c: Client, take u: Upload, deadline_ns: u64) -> Result[(), Error] waits {
    let query = upload_query(u, 0)
    let Upload(path: take path, ..) = take u
    let mut request = new_job(S3Abort, take path, list.new(), deadline_ns)
    request.query = take query
    let Reply(result: take result, ..) = run(mut c, take request)
    as_unit(take result)
}

pub fn fetch_parts(mut c: Client, key: String, take buffers_in: List[Bytes], deadline_ns: u64) -> (Result[Meta, Error], List[Bytes]) waits {
    let mut buffers = take buffers_in
    let path = request_path(c.requests.bucket, key, false)
    let Reply(result: take result, ..) = run(mut c, new_job(S3Head, clone(path), list.new(), deadline_ns))
    let info = match as_meta(take result) {
        Ok(take meta) => take meta,
        Error(take e) => return (Error(take e), take buffers),
    }
    let mut remaining = info.size
    let mut count = 0u64
    let mut prefix = 0u64
    while remaining != 0 && prefix < list.len(buffers) {
        let spare = int.saturating_sub(list.capacity(buffers[prefix]), list.len(buffers[prefix]))
        if spare != 0 {
            count += 1
            remaining -= order.min(remaining, spare)
        }
        prefix += 1
    }
    if remaining != 0 {
        return (Error(TooLarge), take buffers)
    }
    if count > 0 && info.etag.len == 0 {
        return (Error(Fatal(Malformed)), take buffers)
    }
    let mut queued: List[Option[Job]] = list.with_capacity(count)
    let mut slots: List[u64] = list.with_capacity(count)
    let mut offset = 0u64
    for i in 0u64 .. prefix {
        let spare = int.saturating_sub(list.capacity(buffers[i]), list.len(buffers[i]))
        if spare == 0 {
            continue
        }
        let data = list.set(mut buffers, i, list.new())
        let mut request = new_job(S3FetchRange, clone(path), take data, deadline_ns)
        request.lo = offset
        offset += order.min(spare, info.size - offset)
        request.hi = offset
        request.tag = info.etag
        list.push(mut slots, i)
        list.push(mut queued, Some(take request))
    }
    let mut status: Result[(), Error] = Ok(())
    let rv = run_batch(c, take queued, list.len(c.requests.lanes))
    let mut i = 0u64
    for take slot in rv {
        let Reply(result: take part, data: take data, ..) = option.unwrap(take slot)
        let _ = list.set(mut buffers, slots[i], take data)
        match as_meta(take part) {
            Ok(part_meta) => {
                if part_meta.size != info.size {
                    first_error(mut status, Precondition)
                }
            },
            Error(take e) => first_error(mut status, take e),
        }
        i += 1
    }
    match take status {
        Ok(()) => (Ok(take info), take buffers),
        Error(take e) => (Error(take e), take buffers),
    }
}

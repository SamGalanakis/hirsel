// The index walker (STORE-SPEC §1.2). A walk checks every Public index
// this release binds against its table, both ways. In the rows phase each
// row's entries must be in the index with the row's payload. In the entries
// phase each entry must come from a row that still produces it with that
// payload. Sums fold one head's rows and merge the result with its stored
// totals. A Repair walk counts a finding as drift and demotes the index
// (§I.3), so the builder rebuilds it. A Report walk (`hirsel store verify`)
// only reports it, walks on through the same index, and never commits.
/// Missing: a row's entry is absent. Extra: no row produces the entry.
/// Payload: the entry is present, and its payload is not the row's.
pub type WalkFault: send = Missing | Extra | Payload

pub type WalkFinding: send {
    index: String,
    entry: Bytes,
    fault: WalkFault
}

/// `checked` counts rows and entries read since `begin_verify`. `done` says
/// the walk has checked every index; `findings` holds this slice's.
pub type WalkReport: send {
    checked: u64,
    done: bool,
    findings: List[WalkFinding]
}

/// Repair: a finding demotes its index (the head's walk). Report: findings
/// are only reported, every one of them, and the walk never commits.
pub type WalkMode: send = Repair | Report

pub opaque type IndexWalk: send {
    inner: maintenance.IndexWalk
}

pub fn begin_verify(mode: WalkMode) -> IndexWalk {
    let repair = if let Repair = mode {
        true
    } else {
        false
    }
    IndexWalk(inner: maintenance.begin_verify(repair))
}

/// Why a walk passes an index by: it checks Walked ones only.
pub type WalkCoverage: send = Walked | NotPublic | Unbound

pub type IndexCoverage: send {
    table: u32,
    index: String,
    coverage: WalkCoverage
}

/// Every index on main's head, in the order a walk takes them, and whether
/// the walk checks it: an index that is not Public or one
/// this release binds no extractor to is passed by.
pub fn walk_coverage(db: Db) -> Result[List[IndexCoverage], Error] {
    let mut low: Bytes = list.new()
    list.push(mut low, 2u8)
    let mut end_key: Bytes = list.new()
    list.push(mut end_key, 3u8)
    let mut out: List[IndexCoverage] = list.new()
    let mut records = byte_cursor(pages.holder_heads(db.holders)[0].roots.catalog, Included(take low), end_key)?
    while let Some((take key, raw)) = failure_result_from_rep(catalog.next_bytes(mut records))? {
        let record = decode_catalog(raw)?
        let coverage = if !catalog.record_public(raw) {
            NotPublic
        } else if let None = indexes.bound_extractor(db.indexes, record) {
            Unbound
        } else {
            Walked
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut out, 1)))?
        list.push(mut out, IndexCoverage(table: record.owner, index: failure_result_from_rep(catalog.declaration_index_name(key))?, coverage: coverage))
    }
    Ok(take out)
}

// One slice of at most `limit` rows or entries of the index the walk is on.
// In a Repair walk a slice that finds the index wrong demotes it in one
// schema commit; under an export lease catch-up ships that commit as a step
// (§3.5a). A Report walk never commits.
pub fn verify_step(mut db: Db, mut walk: IndexWalk, limit: u64) -> Result[WalkReport, Error] waits {
    let (take report, demote) = verify_step_read(db, mut walk, limit, false)?
    if let Some((owner, id)) = demote {
        let mut seen: List[(u32, u32)] = list.new()
        list.push(mut seen, (owner, id))
        trip_drift(mut db, 0, seen)?
        failure_result_from_rep(maintenance.skip_demoted(mut walk.inner, id))?
    }
    Ok(take report)
}

fn verify_step_read(db: Db, mut walk: IndexWalk, limit: u64, direct: bool) -> Result[(WalkReport, Option[(u32, u32)]), Error] waits {
    healthy(db)?
    if limit == 0 {
        return Error(Limit(Transaction))
    }
    let Some((take key, take record)) = failure_result_from_rep(maintenance.walk_index(pages.holder_heads(db.holders)[0].roots.catalog, db.indexes, mut walk.inner))? else {
        maintenance.clear_walk_position(mut walk.inner)
        return Ok((WalkReport(checked: maintenance.walk_checked(walk.inner), done: true, findings: list.new()), None))
    }
    let name = failure_result_from_rep(catalog.declaration_index_name(key))?
    let mut findings: List[WalkFinding] = list.new()
    if let Sums = catalog_index(record)?.shape {
        walk_sums(db, mut walk, record, name, limit, mut findings, direct)?
    } else if maintenance.walking_entries(walk.inner) {
        walk_entries(db, mut walk, record, name, limit, mut findings, direct)?
    } else {
        walk_rows(db, mut walk, record, name, limit, mut findings, direct)?
    }
    let demote = if maintenance.walk_repairs(walk.inner) && list.len(findings) != 0 {
        Some((record.owner, record.id))
    } else {
        None
    }
    Ok((WalkReport(checked: maintenance.walk_checked(walk.inner), done: false, findings: take findings), demote))
}

fn walk_finding(mut findings: List[WalkFinding], name: String, entry_key: Bytes, fault: WalkFault) -> Result[(), Error] {
    failure_result_from_rep(types.capacity(list.try_reserve(mut findings, 1)))?
    list.push(mut findings, WalkFinding(index: clone(name), entry: failure_result_from_rep(types.copied(entry_key))?, fault: fault))
    Ok(())
}

fn walk_resume(walk: IndexWalk) -> Result[Option[Bytes], Error] {
    match maintenance.walk_cursor(walk.inner) {
        Some(key) => Ok(Some(failure_result_from_rep(types.copied(key))?)),
        None => Ok(None),
    }
}

// The fold may span slices. Restart it if a commit changed the head,
// so comparisons and repair never use totals from different versions.
fn walk_sums(db: Db, mut walk: IndexWalk, record: indexes.Catalog, name: String, limit: u64, mut findings: List[WalkFinding], direct: bool) -> Result[(), Error] waits {
    let head = pages.holder_heads(db.holders)[0].head
    maintenance.begin_sum_walk(mut walk.inner, head)
    if maintenance.walking_entries(walk.inner) {
        return walk_sum_entries(db, mut walk, record, name, limit, mut findings, direct)
    }
    let Some(extractor) = indexes.bound_extractor(db.indexes, record) else {
        return Error(Stale(record.id))
    }
    let (take rows, done) = tiered_rows_after_mode(db, record.owner, maintenance.copy_walk_cursor(walk.inner), limit, direct)?
    failure_result_from_rep(maintenance.fold_sum_rows(mut walk.inner, extractor, rows, done))
}

fn open_verify_entries(db: Db, id: u32, cursor: Option[Bytes], limit: u64, direct: bool) -> Result[maintenance.VerifyEntries, Error] waits {
    let data = pages.holder_heads(db.holders)[0].roots.collections
    if failure_result_from_rep(transfer.table_is_tiered(data, id))? {
        let (take rows, _) = tiered_rows_after_mode(db, id, clone(cursor), limit, direct)?
        return Ok(VerifyTieredEntries(take rows, 0))
    }
    let start = match cursor {
        Some(after) => Excluded(failure_result_from_rep(catalog.logical_key(id, after))?),
        None => Included(failure_result_from_rep(catalog.prefix(id))?),
    }
    Ok(VerifyMemoryEntries(byte_cursor(data, take start, failure_result_from_rep(catalog.prefix(id + 1))?)?))
}

type WalkPoint = WalkResident | WalkReader(Reader) | WalkDirect(Dir)

fn walk_point_source(db: Db, s: Snapshot, id: u32, direct: bool) -> Result[WalkPoint, Error] waits {
    if !failure_result_from_rep(transfer.table_is_tiered(s.roots.collections, id))? {
        return Ok(WalkResident)
    }
    if direct {
        if let Some(state) = view db.disk {
            if let Some(d) = disk_directory(state) {
                return Ok(WalkDirect(d))
            }
        }
        if let None = pager.pager_requests(db.pager) {
            return Error(Io(Closed))
        }
    }
    Ok(WalkReader(reader(db, READER_PIN_MIN)?))
}

fn walk_point[R](db: Db, s: Snapshot, source: WalkPoint, key: Bytes, visit: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    let tree = view s.roots.collections
    match source {
        WalkResident => visit(pages.get_page_row(tree, key)),
        WalkReader(r) => snapshot_point(r, s, key, visit),
        WalkDirect(d) => {
            let Some(inventory) = view tree.paging else {
                return Error(Io(Closed))
            }
            read_tiered_point_direct(d, db.store, inventory, s.open, s.branch, pager.pin_partition(db.pager), tree, key, visit)
        },
    }
}

// Merge the sorted expected groups and stored entries so a missing group
// is found even when the aggregate has no entries.
fn walk_sum_entries(db: Db, mut walk: IndexWalk, record: indexes.Catalog, name: String, limit: u64, mut findings: List[WalkFinding], direct: bool) -> Result[(), Error] waits {
    let mut groups = failure_result_from_rep(maintenance.sum_groups(walk.inner))?
    let after = match maintenance.walk_cursor(walk.inner) {
        Some(final_key) => Some(failure_result_from_rep(types.copied(list.slice(final_key, 4, list.len(final_key))))?),
        None => None,
    }
    let mut indexed = open_verify_entries(db, record.id, after, limit, direct)?
    let mut expected = std.omap.next(mut groups)
    let mut actual = failure_result_from_rep(maintenance.next_verify_entry(mut indexed))?
    for step in 0u64 .. limit {
        let relation = match expected {
            Some((want, _)) => match actual {
                Some((have, _)) => list.compare_bytes(want, have),
                None => Less,
            },
            None => match actual {
                Some(_) => Greater,
                None => return failure_result_from_rep(maintenance.walk_past(mut walk.inner)),
            },
        }
        if relation == Less {
            let (take key, _) = option.unwrap(replace(mut expected, None))
            walk_finding(mut findings, name, key, Missing)?
            maintenance.set_walk_cursor(mut walk.inner, take key)
        } else {
            let (take key, raw) = option.unwrap(replace(mut actual, None))
            if relation == Greater {
                walk_finding(mut findings, name, key, Extra)?
            } else {
                let (_, wanted) = option.unwrap(replace(mut expected, None))
                if !failure_result_from_rep(maintenance.sum_payload_matches(raw, wanted))? {
                    walk_finding(mut findings, name, key, Payload)?
                }
            }
            maintenance.set_walk_cursor(mut walk.inner, take key)
        }
        maintenance.count_checked(mut walk.inner, 1)
        if step + 1 < limit {
            if relation != Greater {
                expected = std.omap.next(mut groups)
            }
            if relation != Less {
                actual = failure_result_from_rep(maintenance.next_verify_entry(mut indexed))?
            }
        }
    }
    Ok(())
}

// Rows phase: up to `limit` rows after the cursor, each extracted with the
// bound extractor and looked up by the index collection's residency.
fn walk_rows(db: Db, mut walk: IndexWalk, record: indexes.Catalog, name: String, limit: u64, mut findings: List[WalkFinding], direct: bool) -> Result[(), Error] waits {
    let cursor = walk_resume(walk)?
    let (take rows, done) = tiered_rows_after_mode(db, record.owner, cursor, limit, direct)?
    let s = snapshot(db)
    let source = walk_point_source(db, s, record.id, direct)?
    let Some(extractor) = indexes.bound_extractor(db.indexes, record) else {
        return Error(Stale(record.id))
    }
    for (logical, raw) in rows {
        let primary = list.slice(logical, 4, list.len(logical))
        let values = extract_index(extractor, raw, primary)?
        for entry_key in values.keys {
            let fault = walk_point(db, s, source, entry_key, scoped fn(found: Option[View[Bytes]]) -> Result[Option[WalkFault], Error] {
                Ok(match found {
                    None => Some(Missing),
                    Some(stored) if stored != values.payload => Some(Payload),
                    _ => None,
                })
            })?
            if let Some(found) = fault {
                walk_finding(mut findings, name, entry_key, found)?
            }
        }
        maintenance.set_walk_cursor(mut walk.inner, failure_result_from_rep(types.copied(primary))?)
    }
    maintenance.finish_rows(mut walk.inner, done, list.len(rows))
    Ok(())
}

// Entries phase: up to `limit` entries after the cursor. A Unique entry names
// its row in its payload; a Many entry ends with it. The row is read as a
// point read, through the pager when the table is Tiered.
fn walk_entries(db: Db, mut walk: IndexWalk, record: indexes.Catalog, name: String, limit: u64, mut findings: List[WalkFinding], direct: bool) -> Result[(), Error] waits {
    let s = snapshot(db)
    // A Tiered index's entries come back as a list, so its scan Reader is
    // returned before the owner's point Reader is reserved: both take the one
    // Reader partition the derived plan funds.
    let mut indexed = open_verify_entries(db, record.id, maintenance.copy_walk_cursor(walk.inner), limit, direct)?
    let source = walk_point_source(db, s, record.owner, direct)?
    let Some(extractor) = indexes.bound_extractor(db.indexes, record) else {
        return Error(Stale(record.id))
    }
    let mut read = 0u64
    while read < limit {
        let Some((take entry_key, raw)) = failure_result_from_rep(maintenance.next_verify_entry(mut indexed))? else {
            failure_result_from_rep(maintenance.walk_past(mut walk.inner))?
            break
        }
        let (unique, start, end) = failure_result_from_rep(maintenance.entry_primary_range(record, extractor, entry_key, raw))?
        let primary = if unique {
            list.slice(raw, start, end)
        } else {
            list.slice(entry_key, start, end)
        }
        let mut logical = failure_result_from_rep(catalog.prefix(record.owner))?
        list.append(mut logical, primary)
        let fault = walk_point(db, s, source, logical, scoped fn(stored: Option[View[Bytes]]) -> Result[Option[WalkFault], Error] {
            Ok(match failure_result_from_rep(maintenance.walk_check_entry_row(extractor, entry_key, raw, primary, stored))? {
                Some(Extra) => Some(Extra),
                Some(Payload) => Some(Payload),
                None => None,
            })
        })?
        if let Some(found) = fault {
            walk_finding(mut findings, name, entry_key, found)?
        }
        maintenance.set_walk_cursor(mut walk.inner, failure_result_from_rep(types.copied(list.slice(entry_key, 4, list.len(entry_key))))?)
        read += 1
    }
    maintenance.count_checked(mut walk.inner, read)
    Ok(())
}

// The compiler inserts the verifier call in test builds.
fn teardown_hook(db: Db) {
    if list.len(pages.holder_heads(db.holders)) == 18446744073709551615u64 {
        fail("store trust teardown")
    }
}

// Applies to this handle's test teardown, even if recovery reuses the same
// store identity and journal segment number.
pub fn allow_unverified_teardown(mut db: Db) {
    db.skip_test_teardown = true
}

// Observe journal poison that close would collect before running the verifier.
pub fn observe_teardown_poison(mut db: Db) -> Option[IoError] waits {
    if is_disk(db) {
        let _ = drain_close_journal(mut db)
    }
    journal_poison(db)
}

fn teardown_fault_name(fault: WalkFault) -> String {
    match fault {
        Missing => "Missing",
        Extra => "Extra",
        Payload => "Payload",
    }
}

fn teardown_check_bucket(db: Db) -> Result[(), Error] waits {
    let Some(state) = view db.disk else {
        return Ok(())
    }
    let ObjectBackend(ow) = view state.backend else {
        return Ok(())
    }
    if let Some(problem) = object_writer.terminal_failure(ow) {
        return match problem {
            Corrupt(fault) => Error(Corrupt(fault_from_rep(clone(fault)))),
            Poisoned(e) => Error(Poisoned(e)),
            _ => Ok(()),
        }
    }
    match failure_result_from_rep(object_writer.health_result(object_writer.health(ow))) {
        Ok(()) => (),
        Error(Corrupt(fault)) => return Error(Corrupt(fault)),
        Error(Poisoned(e)) => return Error(Poisoned(e)),
        Error(_) => return Ok(()),
    }
    if let Some(_) = object_writer.attached_stream(ow) {
        return Ok(())
    }
    if object_writer.recovered_checkpoint(ow).seq == 0 {
        return Ok(())
    }
    let (handover, paused): (Sender[object_writer.ObjectJournalStart], Receiver[object_writer.ObjectJournalStart]) = channel.new(1)
    let (resume, resuming): (Sender[object_writer.ObjectJournalStart], Receiver[object_writer.ObjectJournalStart]) = channel.new(1)
    if let Error(_) = channel.try_send(object_sender(state), ObjectPause(take handover, take resuming)) {
        return Ok(())
    }
    let Ok(take owned_io) = channel.receive(paused) else {
        return Ok(())
    }
    let mut lane = object_writer.object_journal_begin(take owned_io)
    let checked = failure_result_from_rep(object_writer.check_paused_checkpoint(mut lane))
    let _ = failure_result_from_rep(object_writer.return_object_journal(take lane, resume))
    match take checked {
        Ok(()) => Ok(()),
        Error(Corrupt(fault)) => Error(Corrupt(fault)),
        Error(Poisoned(e)) => Error(Poisoned(e)),
        // Ignore closed/fenced/remote transport errors if the sim stopped or faulted.
        Error(_) => Ok(()),
    }
}

// Registered by the test launcher (`native_entry/start.rs`) only in `@test` builds.
fn verify_teardown(db: Db) waits {
    if db.skip_test_teardown || list.len(pages.holder_heads(db.holders)) == 0 {
        return
    }
    if let Some(state) = view db.disk {
        if let Some(_) = queue_accounting(state).poison {
            fail("store trust teardown: database is Poisoned")
        }
        if let Some(d) = disk_directory(state) {
            match failure_result_from_rep(capture.read_only_manifest(d)) {
                Ok((_, id, take manifest)) => match validate_directory_graph(d, store_key_from_rep(id), take manifest, true) {
                    Ok(_) => (),
                    Error(Corrupt(fault)) => maintenance.teardown_fail_corrupt("directory", fault.file, fault.offset),
                    Error(Poisoned(_)) => fail("store trust teardown (directory): Poisoned"),
                    Error(_) => (),
                },
                Error(Corrupt(fault)) => maintenance.teardown_fail_corrupt("directory", fault.file, fault.offset),
                Error(Poisoned(_)) => fail("store trust teardown (directory): Poisoned"),
                Error(_) => (),
            }
        }
        if let ObjectBackend(ow) = view state.backend {
            if let Some(problem) = object_writer.terminal_failure(ow) {
                match problem {
                    Corrupt(fault) => maintenance.teardown_fail_corrupt("bucket", fault.file, fault.offset),
                    Poisoned(_) => fail("store trust teardown (bucket): Poisoned"),
                    _ => (),
                }
            }
            match failure_result_from_rep(object_writer.health_result(object_writer.health(ow))) {
                Ok(()) => (),
                Error(Corrupt(fault)) => maintenance.teardown_fail_corrupt("bucket", fault.file, fault.offset),
                Error(Poisoned(_)) => fail("store trust teardown (bucket): Poisoned"),
                Error(_) => (),
            }
        }
    }
    let mut walk = begin_verify(Report)
    loop {
        match verify_step_read(db, mut walk, 128u64, true) {
            Ok((report, _)) => {
                if list.len(report.findings) != 0 {
                    let found = view report.findings[0u64]
                    let mut msg = string.with_capacity(96)
                    string.push(mut msg, "store trust teardown: index ")
                    string.push(mut msg, found.index)
                    string.push(mut msg, " fault ")
                    string.push(mut msg, teardown_fault_name(found.fault))
                    fail(take msg)
                }
                if report.done {
                    return
                }
            },
            Error(Corrupt(fault)) => maintenance.teardown_fail_corrupt("index walk", fault.file, fault.offset),
            Error(Poisoned(_)) => fail("store trust teardown (index walk): Poisoned"),
            // Fenced/Lost/Closed (e.g. a mock pager or fenced Bucket writer): stop cleanly.
            Error(_) => return,
        }
    }
}

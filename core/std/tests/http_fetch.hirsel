// test-vectors
type Exchange: send {
    method: String,
    path: String,
    body: Bytes,
    content_type: bool,
    credentials: bool,
    may_close: bool,
    response: Bytes
}

type Peer: send {
    listener: Listener,
    clock: Clock,
    deadline: u64,
    exchanges: List[Exchange]
}

fn fixture_url(port: u16, path: String) -> String {
    let mut at = string.from("http://127.0.0.1:")
    string.push_u64(mut at, int.widen(port))
    string.push(mut at, path)
    take at
}

fn send_all(mut out: WriteHalf, data: Bytes, until: Until) -> Result[(), NetError] waits {
    let mut at: u64 = 0
    while at < list.len(data) {
        let n = host.send_pair(mut out, list.slice(data, at, list.len(data)), b"", until)?
        if n == 0 {
            return Error(Reset)
        }
        at += n
    }
    Ok(())
}

fn expect_field(raw: Bytes, h: http1.Head, expected: Bytes) -> bool {
    for i in 0u64 .. h.count {
        let name = h.fields[i].name
        if http1.equal_ascii(list.slice(raw, name.start, name.end), expected) {
            return true
        }
    }
    false
}

fn request_matches(mut input: ReadHalf, row: Exchange, until: Until) -> bool waits {
    let mut wire: Bytes = list.with_capacity(2048)
    let mut h = http1.head()
    loop {
        match http1.request(wire, mut h) {
            Complete => break,
            Partial => (),
            _ => return false,
        }
        let room = 2048 - list.len(wire)
        if room == 0 || result.unwrap(host.recv_bounded(mut input, mut wire, room, until)) == 0 {
            return false
        }
    }
    let mut length: u64 = 0
    for i in 0u64 .. h.count {
        let field = h.fields[i]
        if http1.equal_ascii(list.slice(wire, field.name.start, field.name.end), b"content-length") {
            length = result.unwrap(int.parse_decimal_span(wire, field.value.start, field.value.end, 2048))
        }
    }
    if length != list.len(row.body) || list.slice(wire, h.method.start, h.method.end) != string.as_bytes(row.method) || list.slice(wire, h.target.start, h.target.end) != string.as_bytes(row.path) {
        return false
    }
    if expect_field(wire, h, b"content-type") != row.content_type || expect_field(wire, h, b"authorization") != row.credentials || expect_field(wire, h, b"proxy-authorization") != row.credentials || expect_field(wire, h, b"cookie") != row.credentials {
        return false
    }
    while list.len(wire) < h.end + length {
        let left = h.end + length - list.len(wire)
        if result.unwrap(host.recv_bounded(mut input, mut wire, left, until)) == 0 {
            return false
        }
    }
    list.slice(wire, h.end, list.len(wire)) == row.body
}

fn serve(take job: Peer) -> bool waits {
    let Peer(listener: take site, clock, deadline, exchanges: take exchanges) = take job
    let until = At(clock, deadline)
    let mut accepting = take site
    let (sock, _) = result.unwrap(host.accept(mut accepting, until))
    let (rx, tx) = net.split(take sock)
    let mut input = take rx
    let mut output = take tx
    for row in exchanges {
        if !request_matches(mut input, row, until) {
            return false
        }
        match send_all(mut output, row.response, until) {
            Ok(()) => (),
            Error(Reset) => return row.may_close,
            Error(_) => return false,
        }
    }
    true
}

fn bind_fixture(n: Net) -> (Listener, Addr) waits {
    result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 4))
}

fn reply(status: u16, fields: String, body: Bytes) -> Bytes {
    let mut h = string.from("HTTP/1.1 ")
    string.push_u64(mut h, int.widen(status))
    string.push(mut h, "\r\n")
    string.push(mut h, fields)
    string.push(mut h, "Content-Length: ")
    string.push_u64(mut h, list.len(body))
    string.push(mut h, "\r\n\r\n")
    let mut wire = string.into_bytes(take h)
    list.append(mut wire, body)
    take wire
}

fn wire_exchange(method: String, path: String, body: Bytes, content_type: bool, credentials: bool, take wire: Bytes) -> Exchange {
    Exchange(method: string.from(method), path: string.from(path), body: clone(body), content_type, credentials, may_close: false, response: take wire)
}

fn fetch_case(n: Net, c: Clock, tasks: Tasks, status: u16, verb: String, next_verb: String, keeps_body: bool) -> bool waits {
    let (site, address) = bind_fixture(n)
    let end = host.mono_ns(c) + 2000000000
    let mut script: List[Exchange] = list.new()
    let notice = if verb == "HEAD" {
        b""
    } else {
        b"moved"
    }
    list.push(mut script, wire_exchange(verb, "/first?x=y", b"input", true, false, reply(status, "Location: /second?ok#ignored\r\n", notice)))
    if keeps_body {
        list.push(mut script, wire_exchange(next_verb, "/second?ok", b"input", true, false, reply(200, "", b"")))
    } else {
        list.push(mut script, wire_exchange(next_verb, "/second?ok", b"", false, false, reply(200, "", b"")))
    }
    let server = task.spawn(tasks, bytes 65536, Peer(listener: take site, clock: c, deadline: end, exchanges: take script), serve)
    let p = result.unwrap(http_client.pool(n, c, tasks, System, http_client.limits(0)))
    let cl = http_client.handle(p)
    let mut fields: List[http_client.Header] = list.new()
    list.push(mut fields, http_client.Header(name: "Content-Type", value: Public(b"text/plain")))
    let mut segments: List[http_client.Segment] = list.new()
    list.push(mut segments, Plain(b"input"))
    let req = http_client.Fetch(method: string.from(verb), url: fixture_url(address.port, "/first?x=y#not-sent"), headers: take fields, body: take segments)
    let mut r = result.unwrap(http_client.fetch(cl, req, end))
    let mut scratch: Bytes = list.with_capacity(1)
    let valid = http_client.status(http_client.fetch_head(r)) == 200 && http_client.fetch_url(r) == fixture_url(address.port, "/second?ok#ignored") && result.unwrap(http_client.fetch_read(mut r, mut scratch)) == 0
    result.unwrap(task.join(take server)) && valid
}

// FE1. The server compares the wire method, body and content header against
// literal RFC 9110 rows and sees the redirect reuse the same connection.
// expect: run fetch_redirect_table(network) = true
fn fetch_redirect_table(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    fetch_case(n, c, tasks, 301, "POST", "GET", false) && fetch_case(n, c, tasks, 301, "PUT", "PUT", true) && fetch_case(n, c, tasks, 302, "POST", "GET", false) && fetch_case(n, c, tasks, 302, "DELETE", "DELETE", true) && fetch_case(n, c, tasks, 303, "POST", "GET", false) && fetch_case(n, c, tasks, 303, "HEAD", "HEAD", false) && fetch_case(n, c, tasks, 307, "POST", "POST", true) && fetch_case(n, c, tasks, 308, "PATCH", "PATCH", true)
}

fn coding_fields(name: String) -> String {
    let mut fields = string.from("Content-Encoding: ")
    string.push(mut fields, name)
    string.push(mut fields, "\r\n")
    take fields
}

fn encoded_case(n: Net, c: Clock, tasks: Tasks, name: String, data: Bytes, expected_case: u8) -> bool waits {
    let (site, address) = bind_fixture(n)
    let end = host.mono_ns(c) + 2000000000
    let mut exchange = wire_exchange("GET", "/data", b"", false, false, reply(200, coding_fields(name), data))
    // A refused encoding can close while the peer is still writing its tail.
    exchange.may_close = expected_case != 0 && expected_case != 5
    let mut plan: List[Exchange] = list.new()
    list.push(mut plan, take exchange)
    let peer = task.spawn(tasks, bytes 65536, Peer(listener: take site, clock: c, deadline: end, exchanges: take plan), serve)
    let mut cfg = http_client.limits(if expected_case >= 5 {
        0
    } else {
        32768
    })
    if expected_case == 4 {
        cfg.max_window = 1023
    }
    let p = result.unwrap(http_client.pool(n, c, tasks, System, cfg))
    let cl = http_client.handle(p)
    let request = http_client.Fetch(method: "GET", url: fixture_url(address.port, "/data"), headers: list.new(), body: list.new())
    let fetched = http_client.fetch(cl, request, end)
    if expected_case == 6 {
        let refused = match fetched {
            Error(Http(TooLarge)) => true,
            _ => false,
        }
        return result.unwrap(task.join(take peer)) && refused
    }
    let mut response = result.unwrap(take fetched)
    if http_client.fetch_coding(response) == None {
        return false
    }
    let mut payload: Bytes = list.with_capacity(4096)
    let mut total: u64 = 0
    let mut observed: u8 = 0
    loop {
        list.clear(mut payload)
        match http_client.fetch_read(mut response, mut payload) {
            Ok(0) => break,
            Ok(nread) => {
                if nread != list.len(payload) {
                    return false
                }
                for byte in payload {
                    if byte != 0 {
                        return false
                    }
                }
                total += nread
            },
            Error(Http(TooLarge)) => {
                observed = 1;
                break
            },
            Error(Coding(Flate(TrailingData(offset)))) => {
                observed = if offset + 1 == list.len(data) {
                    2
                } else {
                    255
                };
                break
            },
            Error(Coding(Flate(Header))) => {
                observed = 3;
                break
            },
            Error(Coding(Zstd(WindowTooLarge(1024)))) => {
                observed = 4;
                break
            },
            Error(_) => {
                observed = 255;
                break
            },
        }
    }
    let served = result.unwrap(task.join(take peer))
    let right_size = if expected_case == 3 || expected_case == 4 || expected_case == 5 {
        total == 0
    } else if expected_case == 1 && name == "zstd" {
        total <= 32768
    } else {
        total == 32768
    }
    served && observed == (if expected_case == 5 {
        0
    } else {
        expected_case
    }) && right_size
}

fn skippable_frame(size: u64) -> Bytes {
    let mut wire: Bytes = list.with_capacity(size)
    list.put_word_le(mut wire, 0x184d2a50u32)
    let payload: u32 = int.narrow(size - 8)
    list.put_word_le(mut wire, payload)
    list.fill(mut wire, size - 8, 0)
    take wire
}

// FE3 and FE4. gzip -dc, Python zlib and zstd -dc check the pinned corpus.
// expect: run fetch_bounded_codings(network) = true
fn fetch_bounded_codings(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let vectors = coding_vectors()
    for row in vectors {
        let (name, data, expected_case) = view row
        if !encoded_case(n, c, tasks, name, data, expected_case) {
            return false
        }
    }
    encoded_case(n, c, tasks, "zstd", skippable_frame(131072), 5) && encoded_case(n, c, tasks, "zstd", skippable_frame(131073), 6)
}

fn route_to(url: String) -> String {
    let mut fields = string.from("Location: ")
    string.push(mut fields, url)
    string.push(mut fields, "\r\n")
    take fields
}

// FE2. A port change strips credentials even though the host is identical.
// The first peer also checks same-origin forwarding before the port change.
// expect: run fetch_cross_origin_fields(network) = true
fn fetch_cross_origin_fields(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (site_a, a) = bind_fixture(n)
    let (site_b, b) = bind_fixture(n)
    let end = host.mono_ns(c) + 2000000000
    let same = wire_exchange("GET", "/first", b"", false, true, reply(302, "Location: /same\r\n", b""))
    let cross = wire_exchange("GET", "/same", b"", false, true, reply(307, route_to(fixture_url(b.port, "/cross")), b""))
    let back = wire_exchange("GET", "/cross", b"", false, false, reply(308, route_to(fixture_url(a.port, "/last")), b""))
    let last = wire_exchange("GET", "/last", b"", false, false, reply(200, "", b""))
    let mut first: List[Exchange] = list.new()
    list.push(mut first, take same)
    list.push(mut first, take cross)
    list.push(mut first, take last)
    let mut second: List[Exchange] = list.new()
    list.push(mut second, take back)
    let first_peer = task.spawn(tasks, bytes 65536, Peer(listener: take site_a, clock: c, deadline: end, exchanges: take first), serve)
    let second_peer = task.spawn(tasks, bytes 65536, Peer(listener: take site_b, clock: c, deadline: end, exchanges: take second), serve)
    let p = result.unwrap(http_client.pool(n, c, tasks, System, http_client.limits(0)))
    let cl = http_client.handle(p)
    let mut headers: List[http_client.Header] = list.new()
    list.push(mut headers, http_client.Header(name: "aUtHoRiZaTiOn", value: Public(b"private")))
    list.push(mut headers, http_client.Header(name: "proxy-authorization", value: Public(b"private")))
    list.push(mut headers, http_client.Header(name: "COOKie", value: Public(b"private")))
    let req = http_client.Fetch(method: "GET", url: fixture_url(a.port, "/first"), headers: take headers, body: list.new())
    let mut r = result.unwrap(http_client.fetch(cl, req, end))
    let mut out: Bytes = list.with_capacity(8)
    let valid = result.unwrap(http_client.fetch_read(mut r, mut out)) == 0 && http_client.status(http_client.fetch_head(r)) == 200
    result.unwrap(task.join(take first_peer)) && result.unwrap(task.join(take second_peer)) && valid
}

fn redirect_close_peer(take job: Peer) -> bool waits {
    let Peer(listener: take site, clock, deadline, exchanges: take exchanges) = take job
    let until = At(clock, deadline)
    let mut accepting = take site
    let (first, _) = result.unwrap(host.accept(mut accepting, until))
    let (a, b) = net.split(take first)
    let mut before = take a
    let mut redirect = take b
    if !request_matches(mut before, exchanges[0], until) {
        return false
    }
    result.unwrap(send_all(mut redirect, exchanges[0].response, until))
    // Keep the old write half open until the next connection is accepted.
    // Waiting for any body byte beyond the drain budget would deadlock.
    let (second, _) = result.unwrap(host.accept(mut accepting, until))
    let _ = take redirect
    let (r, w) = net.split(take second)
    let mut next_input = take r
    let mut next_output = take w
    if !request_matches(mut next_input, exchanges[1], until) {
        return false
    }
    if let Ok(()) = send_all(mut next_output, exchanges[1].response, until) {
        return true
    }
    false
}

// HTTP-18. An EOF-delimited redirect may stall exactly at the drain bound.
// expect: run fetch_redirect_drain_boundary(network) = true
fn fetch_redirect_drain_boundary(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (site, address) = bind_fixture(n)
    let end = host.mono_ns(c) + 2000000000
    let mut notice: Bytes = list.with_capacity(2112)
    list.append(mut notice, b"HTTP/1.1 302 Found\r\nLocation: /next\r\n\r\n")
    list.fill(mut notice, 2048, b'x')
    let mut script: List[Exchange] = list.new()
    list.push(mut script, wire_exchange("GET", "/start", b"", false, false, take notice))
    list.push(mut script, wire_exchange("GET", "/next", b"", false, false, reply(200, "", b"")))
    let peer = task.spawn(tasks, bytes 65536, Peer(listener: take site, clock: c, deadline: end, exchanges: take script), redirect_close_peer)
    let p = result.unwrap(http_client.pool(n, c, tasks, System, http_client.limits(0)))
    let cl = http_client.handle(p)
    let req = http_client.Fetch(method: "GET", url: fixture_url(address.port, "/start"), headers: list.new(), body: list.new())
    let r = result.unwrap(http_client.fetch(cl, req, end))
    http_client.status(http_client.fetch_head(r)) == 200 && result.unwrap(task.join(take peer))
}

type Conns: send {
    listener: Listener,
    clock: Clock,
    deadline: u64,
    conns: List[List[Exchange]]
}

// Accepts one connection per script, in order, and keeps each open until all are served.
fn serve_conns(take job: Conns) -> bool waits {
    let Conns(listener: take site, clock, deadline, conns: take conns) = take job
    let until = At(clock, deadline)
    let mut accepting = take site
    let mut kept: List[WriteHalf] = list.new()
    for rows in conns {
        let (sock, _) = result.unwrap(host.accept(mut accepting, until))
        let (rx, tx) = net.split(take sock)
        let mut input = take rx
        let mut output = take tx
        for row in rows {
            if !request_matches(mut input, row, until) {
                return false
            }
            match send_all(mut output, row.response, until) {
                Ok(()) => (),
                Error(Reset) => if !row.may_close {
                    return false
                },
                Error(_) => return false,
            }
        }
        list.push(mut kept, take output)
    }
    true
}

fn get_request(port: u16, path: String) -> http_client.Fetch {
    http_client.Fetch(method: "GET", url: fixture_url(port, path), headers: list.new(), body: list.new())
}

fn body_of(take response: http_client.Response) -> Bytes waits {
    let mut r = take response
    let mut all: Bytes = list.with_capacity(64)
    let mut chunk: Bytes = list.with_capacity(64)
    loop {
        list.clear(mut chunk)
        match http_client.fetch_read(mut r, mut chunk) {
            Ok(0) => break,
            Ok(_) => list.append(mut all, chunk),
            Error(_) => return b"error",
        }
    }
    take all
}

fn conns_peer(tasks: Tasks, take site: Listener, c: Clock, end: u64, take first: List[Exchange], take second: List[Exchange]) -> Task[bool] {
    let mut conns: List[List[Exchange]] = list.new()
    list.push(mut conns, take first)
    if list.len(second) != 0 {
        list.push(mut conns, take second)
    }
    task.spawn(tasks, bytes 131072, Conns(listener: take site, clock: c, deadline: end, conns: take conns), serve_conns)
}

type Stray: send {
    listener: Listener,
    clock: Clock,
    deadline: u64,
    body: Bytes
}

// One connection answers /a with a response and a second, unrequested one behind
// it. A second connection answers /b.
fn stray_peer(take job: Stray) -> bool waits {
    let Stray(listener: take site, clock, deadline, body: take body) = take job
    let until = At(clock, deadline)
    let mut accepting = take site
    let (first, _) = result.unwrap(host.accept(mut accepting, until))
    let (a_in, a_out) = net.split(take first)
    let mut input = take a_in
    let mut output = take a_out
    let mut wire = reply(200, "", body)
    list.append(mut wire, reply(200, "", b"stray"))
    if !request_matches(mut input, wire_exchange("GET", "/a", b"", false, false, b""), until) {
        return false
    }
    // The client closes the connection once it sees the stray response.
    let _ = send_all(mut output, wire, until)
    let (second, _) = result.unwrap(host.accept(mut accepting, until))
    let (b_in, b_out) = net.split(take second)
    let mut next_input = take b_in
    let mut next_output = take b_out
    if !request_matches(mut next_input, wire_exchange("GET", "/b", b"", false, false, b""), until) {
        return false
    }
    result.unwrap(send_all(mut next_output, reply(201, "", b"fresh"), until))
    true
}

fn stray_case(n: Net, c: Clock, tasks: Tasks, body: Bytes) -> bool waits {
    let (site, address) = bind_fixture(n)
    let end = host.mono_ns(c) + 2000000000
    let peer = task.spawn(tasks, bytes 131072, Stray(listener: take site, clock: c, deadline: end, body: clone(body)), stray_peer)
    let p = result.unwrap(http_client.pool(n, c, tasks, System, http_client.limits(1024)))
    let cl = http_client.handle(p)
    let mut a: Bytes = list.new()
    let first = result.unwrap(http_client.get(cl, fixture_url(address.port, "/a"), mut a, end))
    let r = result.unwrap(http_client.fetch(cl, get_request(address.port, "/b"), end))
    let status = http_client.status(http_client.fetch_head(r))
    let b = body_of(take r)
    first == 200 && a == body && status == 201 && b == b"fresh" && result.unwrap(task.join(take peer))
}

// FE5. A response with a pipelined response behind it never parks its
// connection: the next fetch dials anew and never reads the stray bytes. The
// harness delivers 8-byte fragments, so a 3-byte body leaves stray bytes staged
// with it and a 5-byte body leaves them in the socket at the next checkout.
// expect: run fetch_pool_stray_bytes(network) = true
fn fetch_pool_stray_bytes(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    stray_case(n, c, tasks, b"fir") && stray_case(n, c, tasks, b"first")
}

// FE6. With every slot leased, dropping an unread response neither waits nor
// leaks its slot: the next fetch at conns_max 1 gets a new connection.
// expect: run fetch_pool_unread_drop(network) = true
fn fetch_pool_unread_drop(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (site, address) = bind_fixture(n)
    let end = host.mono_ns(c) + 2000000000
    let mut unread = wire_exchange("GET", "/a", b"", false, false, reply(200, "", b"unread"))
    unread.may_close = true
    let mut first: List[Exchange] = list.new()
    list.push(mut first, take unread)
    let mut second: List[Exchange] = list.new()
    list.push(mut second, wire_exchange("GET", "/b", b"", false, false, reply(200, "", b"next")))
    let peer = conns_peer(tasks, take site, c, end, take first, take second)
    let mut cfg = http_client.limits(1024)
    cfg.conns_max = 1
    cfg.waiters_max = 1
    let p = result.unwrap(http_client.pool(n, c, tasks, System, cfg))
    let cl = http_client.handle(p)
    let r = result.unwrap(http_client.fetch(cl, get_request(address.port, "/a"), end))
    let dropping = bound bytes 0 {
        let _ = take r
    }
    let dropped = match dropping {
        Ok(()) => true,
        Error(_) => false,
    }
    let next = body_of(result.unwrap(http_client.fetch(cl, get_request(address.port, "/b"), end)))
    dropped && next == b"next" && result.unwrap(task.join(take peer))
}

type Waiter: send {
    client: http_client.Client,
    port: u16,
    deadline: u64
}

fn wait_for_lease(take w: Waiter) -> bool waits {
    let Waiter(client: take cl, port, deadline) = take w
    match http_client.fetch(cl, get_request(port, "/w"), deadline) {
        Ok(take r) => body_of(take r) == b"waited",
        Error(_) => false,
    }
}

// FE7. At conns_max with the waiter queue full a fetch is refused with Busy, a
// waiter whose deadline passes gets Deadline, and a waiter served in time gets
// the parked connection with no new dial (the peer accepts once).
// expect: run fetch_pool_waiters(network) = true
fn fetch_pool_waiters(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (site, address) = bind_fixture(n)
    let end = host.mono_ns(c) + 4000000000
    let mut only: List[Exchange] = list.new()
    list.push(mut only, wire_exchange("GET", "/a", b"", false, false, reply(200, "", b"held")))
    list.push(mut only, wire_exchange("GET", "/w", b"", false, false, reply(200, "", b"waited")))
    let peer = conns_peer(tasks, take site, c, end, take only, list.new())
    let mut cfg = http_client.limits(1024)
    cfg.conns_max = 1
    cfg.waiters_max = 1
    let p = result.unwrap(http_client.pool(n, c, tasks, System, cfg))
    let cl = http_client.handle(p)
    let held = result.unwrap(http_client.fetch(cl, get_request(address.port, "/a"), end))
    let timed_out = match http_client.fetch(cl, get_request(address.port, "/x"), host.mono_ns(c) + 50000000) {
        Error(Http(Deadline)) => true,
        _ => false,
    }
    let waiter = task.spawn(tasks, bytes 65536, Waiter(client: http_client.handle(p), port: address.port, deadline: end), wait_for_lease)
    // Let the waiter's ask take the only queue place.
    host.sleep_until(c, host.mono_ns(c) + 10000000)
    let busy = match http_client.fetch(cl, get_request(address.port, "/x"), end) {
        Error(Busy) => true,
        _ => false,
    }
    let first = body_of(take held)
    let served = result.unwrap(task.join(take waiter))
    timed_out && busy && first == b"held" && served && result.unwrap(task.join(take peer))
}

// FE9. An endpoint never reaches another origin: a redirect there ends the call
// with CrossOrigin before the other origin sees a connection.
// expect: run fetch_endpoint_confined(network) = true
fn fetch_endpoint_confined(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (site_a, a) = bind_fixture(n)
    let (site_b, b) = bind_fixture(n)
    let end = host.mono_ns(c) + 2000000000
    let mut rows: List[Exchange] = list.new()
    let mut away = wire_exchange("GET", "/go", b"", false, false, reply(302, route_to(fixture_url(b.port, "/there")), b""))
    away.may_close = true
    list.push(mut rows, take away)
    let peer = conns_peer(tasks, take site_a, c, end, take rows, list.new())
    let p = result.unwrap(http_client.pool(n, c, tasks, System, http_client.limits(1024)))
    let cl = http_client.handle(p)
    let e = result.unwrap(http_client.endpoint(cl, fixture_url(a.port, "/")))
    let refused = match http_client.call(e, http_client.Call(method: "GET", target: "/go", headers: list.new(), body: list.new()), end) {
        Error(CrossOrigin) => true,
        _ => false,
    }
    let mut other = take site_b
    let other_quiet = match host.accept(mut other, At(c, host.mono_ns(c) + 50000000)) {
        Ok(_) => false,
        Error(_) => true,
    }
    refused && other_quiet && result.unwrap(task.join(take peer))
}

type RebindLink: send {
    port: Served[NetOp],
    clock: Clock,
    network: sim.net.Network,
}

fn rebind_clock(take input: sim.world.World) waits {
    let mut world = take input
    sim.world.run(mut world)
}

fn rebind_link(take input: RebindLink) waits {
    let RebindLink(port: take port, clock, network: take network) = take input
    let mut plan = sim.world.plan_from(sim.world.Script(tail_seed: 0, streams: list.new()), 0)
    let _ = sim.net.serve(network, mut plan, clock, take port)
}

fn ips(a: Ip, b: Option[Ip]) -> List[Ip] {
    let mut out: List[Ip] = list.with_capacity(2)
    list.push(mut out, a)
    if let Some(second) = b {
        list.push(mut out, second)
    }
    take out
}

fn site_peer(tasks: Tasks, root: Net, c: Clock, ip: Ip, take response: Bytes, may_close: bool) -> Task[bool] waits {
    let (site, _) = result.unwrap(host.listen(root, Addr(ip: ip, port: 80), 4))
    let mut row = wire_exchange("GET", "/", b"", false, false, take response)
    row.may_close = may_close
    let mut rows: List[Exchange] = list.new()
    list.push(mut rows, take row)
    task.spawn(tasks, bytes 65536, Peer(listener: take site, clock: c, deadline: 18446744073709551615u64, exchanges: take rows), serve)
}

// A trap listener no dial may reach: after the asks its accept has nothing queued.
fn untouched(take trap: Listener, c: Clock) -> bool waits {
    let mut listener = take trap
    match host.accept(mut listener, At(c, 1)) {
        Error(TimedOut) => true,
        _ => false,
    }
}

// NET-18 public_fetch_rebinding (HTTP-18). The pool's Net is the served root
// narrowed to [Connect 0.0.0.0/0 1-65535 public, Resolve *]. rebind.test answers
// 8.8.8.8, then 127.0.0.1; hop.test (9.9.9.9) redirects to meta.test
// (169.254.169.254); mixed.test answers [127.0.0.1, 1.1.1.1]; dark.test answers
// [8.8.4.4, which nothing serves, 127.0.0.1]. Oracle, by hand from NET-18: the
// first fetch is 200; the second and the redirect end Http(Connect(Denied));
// mixed.test is 200 from 1.1.1.1; dark.test ends with 8.8.4.4's Refused, not
// Denied; not_public counts the four refused dials; neither 127.0.0.1:80 nor
// 169.254.169.254:80 is ever connected.
// expect: run public_fetch_rebinding(tasks) = true
fn public_fetch_rebinding(tasks: Tasks) -> bool waits {
    let loopback = V4(2130706433)
    let metadata = V4(2852039166)
    let (world, c) = sim.world.new(1, 0, 0)
    let (root, port) = provide.net(bytes 65536)
    let mut network = sim.net.new(sim.net.Config(queue_bytes: 32768, fragment_bytes: 32768, latency_ns: 0))
    let mut answers: List[List[Ip]] = list.new()
    list.push(mut answers, ips(V4(134744072), None))
    list.push(mut answers, ips(loopback, None))
    sim.net.resolve_sequence(mut network, "rebind.test", take answers)
    sim.net.resolve_as(mut network, "hop.test", ips(V4(151587081), None))
    sim.net.resolve_as(mut network, "meta.test", ips(metadata, None))
    sim.net.resolve_as(mut network, "mixed.test", ips(loopback, Some(V4(16843009))))
    sim.net.resolve_as(mut network, "dark.test", ips(V4(134743044), Some(loopback)))
    let driver = task.spawn(tasks, bytes 65536, take world, rebind_clock)
    let link = task.spawn(tasks, bytes 4194304, RebindLink(port: take port, clock: c, network: take network), rebind_link)
    let first_site = site_peer(tasks, root, c, V4(134744072), reply(200, "Connection: close\r\n", b"one"), false)
    let hop_site = site_peer(tasks, root, c, V4(151587081), reply(302, "Location: http://meta.test/\r\n", b""), true)
    let mixed_site = site_peer(tasks, root, c, V4(16843009), reply(200, "", b"two"), false)
    let (trap_a, _) = result.unwrap(host.listen(root, Addr(ip: loopback, port: 80), 1))
    let (trap_b, _) = result.unwrap(host.listen(root, Addr(ip: metadata, port: 80), 1))
    let mut rules: List[Rule] = list.new()
    list.push(mut rules, Rule(dir: Connect, prefix: V4(0), bits: 0, ports: (1, 65535), reach: Public))
    list.push(mut rules, Resolve(names: "*"))
    let n = result.unwrap(net.narrow(root, rules))
    let p = result.unwrap(http_client.pool(n, c, tasks, System, http_client.limits(1024)))
    let cl = http_client.handle(p)
    let end = 18446744073709551615u64
    let mut body: Bytes = list.with_capacity(64)
    let first = match http_client.get(cl, "http://rebind.test/", mut body, end) {
        Ok(200) => body == b"one",
        _ => false,
    }
    let second = match http_client.get(cl, "http://rebind.test/", mut body, end) {
        Error(Http(Connect(Denied))) => true,
        _ => false,
    }
    let redirect = match http_client.get(cl, "http://hop.test/", mut body, end) {
        Error(Http(Connect(Denied))) => true,
        _ => false,
    }
    list.clear(mut body)
    let mixed = match http_client.get(cl, "http://mixed.test/", mut body, end) {
        Ok(200) => body == b"two",
        _ => false,
    }
    let dark = match http_client.get(cl, "http://dark.test/", mut body, end) {
        Error(Http(Connect(Refused))) => true,
        _ => false,
    }
    let counted = net.denials(n).not_public == 4
    let local_clean = untouched(take trap_a, c)
    let metadata_clean = untouched(take trap_b, c)
    let served = result.unwrap(task.join(take first_site)) && result.unwrap(task.join(take hop_site)) && result.unwrap(task.join(take mixed_site))
    let _ = take p
    result.unwrap(task.join(take link))
    result.unwrap(task.join(take driver))
    first && second && redirect && mixed && dark && counted && local_clean && metadata_clean && served
}

fn block_steps(memory_kib: u32) -> bool {
    let password = b"password"
    let salt = b"somesalt"
    let empty = b""
    let cost = Argon2Cost(memory_kib: memory_kib, passes: 2, lanes: 2)
    let len: u64 = 32
    let out: Bytes = list.with_capacity(32)
    let exact = bound steps 513 {
        let mut tag = take out
        let answer = argon2.id(password, salt, empty, empty, cost, len, mut tag)
        (answer, take tag)
    }
    let too_short: Bytes = list.with_capacity(32)
    let refused = bound bytes 0 {
        bound steps 512 {
            let mut tag = take too_short
            let answer = argon2.id(password, salt, empty, empty, cost, len, mut tag)
            (answer, take tag)
        }
    }
    match (take exact, take refused) {
        (Ok((Ok(()), take tag)), Ok(Error(e))) => list.len(tag) == 32 && e.steps == 512,
        _ => false,
    }
}

// AR4. The std caller emits the source call step. Both memory costs use 256 blocks.
// The one-step-short case has zero bytes to check that OutOfTime wins.
// expect: run ar4_block_steps() = true
fn ar4_block_steps() -> bool {
    block_steps(256) && block_steps(259)
}

fn malformed(phc: Bytes) -> bool {
    match argon2.verify(b"password", phc) {
        Error(Malformed) => true,
        _ => false,
    }
}

// AR6. Variants of libargon2's first PHC that must be refused without hashing.
// expect: run ar6_phc_strictness() = true
fn ar6_phc_strictness() -> bool {
    malformed(b"$argon2i$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc") && malformed(b"$argon2id$v=16$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc") && malformed(b"$argon2id$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc") && malformed(b"$argon2id$v=19$t=2,m=65536,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc") && malformed(b"$argon2id$v=19$m=065536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc") && malformed(b"$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ=$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc") && malformed(b"$argon2id$v=19$m=65536,t=2,p=1,keyid=AAAA$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc") && malformed(b"$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$AAAA") && malformed(b"$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHR$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")
}

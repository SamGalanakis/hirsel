pub opaque type Authority = LogAuthority(Dir) | ObjectAuthority(ObjectAuthorityConfig)

pub fn log_authority(d: Dir) -> Authority {
    LogAuthority(d)
}

pub opaque type Followers {
    issued: u64
}

pub fn followers() -> Followers {
    Followers(issued: 0)
}

type FollowCapture: shareable + send {
    store: StoreId,
    state: Arc[State],
    resident: u64,
    remote: Option[ObjectFollowHead],
    watermark: u64
}

type FollowBackend = FollowLog(Dir) | FollowObject(ObjectFollowerIo)

pub opaque type Follower {
    open: u64,
    backend: FollowBackend,
    tasks: Tasks,
    clock: Clock,
    ceiling: u64,
    capture: Arc[FollowCapture],
    stopped: Option[StoreCapacity]
}

type LogFollowJob: send {
    directory: Dir,
    expect: Option[StoreId],
    ceiling: u64,
    result: Sender[Result[Arc[FollowCapture], Error]]
}

fn log_follow_capture(d: Dir, expected: Option[StoreId], ceiling: u64) -> Result[Arc[FollowCapture], Error] waits {
    disk_io(host.sync_dir(d))?
    let (take raw, id, take manifest) = read_only_manifest(d)?
    check_expected_store(expected, id)?
    let replay = read_only_state(d, id, take manifest, true)?
    let resident = journal_account(replay)?
    over_ceiling(resident, ceiling)?
    check_read_only_manifest(d, raw)?
    let JournalReplay(state: take state, next_node: last_stamp, ..) = take replay
    Ok(arc.new(FollowCapture(store: id, state: arc.new(take state), resident, remote: None, watermark: stamp_after(last_stamp)?)))
}

fn log_follow_job(take job: LogFollowJob) waits {
    let selected = log_follow_capture(job.directory, job.expect, job.ceiling)
    let _ = channel.send(job.result, take selected)
}

fn log_follow_private(tasks: Tasks, d: Dir, expected: Option[StoreId], ceiling: u64) -> Result[Arc[FollowCapture], Error] waits {
    let (to, from): (Sender[Result[Arc[FollowCapture], Error]], Receiver[Result[Arc[FollowCapture], Error]]) = channel.new(1)
    let job = LogFollowJob(directory: d, expect: expected, ceiling, result: take to)
    let first = task.try_spawn(tasks, bytes 18446744073709551327u64, take job, log_follow_job)
    let worker = match take first {
        Ok(take running) => take running,
        Error((problem, take returned)) => {
            if problem.available < 288 {
                return Error(Full(Allocation(problem)))
            }
            task.spawn(tasks, bytes (problem.available - 288), take returned, log_follow_job)
        },
    }
    match task.join(take worker) {
        Ok(()) => (),
        Error(Failed(causes)) => return Error(match raised_capacity(causes) {
            Some(problem) => Full(Allocation(problem)),
            None => Io(Closed),
        }),
        Error(Cancelled(_)) => return Error(Io(Closed)),
    }
    match channel.receive(from) {
        Ok(take answer) => take answer,
        Error(_) => Error(Io(Closed)),
    }
}

pub fn follower(mut source: Followers, tasks: Tasks, take authority: Authority, c: Clock, o: Options) -> Result[Follower, Error] waits {
    let minted = history_next_id(source.issued)?
    let (take backend, take captured) = match take authority {
        LogAuthority(d) => (FollowLog(d), log_follow_private(tasks, d, o.expect, o.resident_limit)?),
        ObjectAuthority(ObjectAuthorityConfig(client: take client, op_ms, ..)) => {
            let deadline = std.object.deadline_after_ms(client, op_ms)
            let (take requests, take workers) = std.object.split(take client)
            let mut io = ObjectFollowerIo(requests: Some(take requests), workers: take workers, op_ms)
            let Some(take initial) = object_follow_private(tasks, mut io, Advance(None), o.expect, o.resident_limit, deadline)? else {
                return Error(NotFound)
            }
            (FollowObject(take io), take initial)
        },
    }
    source.issued = minted
    Ok(Follower(open: HISTORY_OPEN_LIMIT | minted, backend: take backend, tasks, clock: c, ceiling: o.resident_limit, capture: take captured, stopped: None))
}

pub fn follower_branch(f: Follower, name: String) -> Option[Branch] {
    for tip in f.capture.state.tips {
        if tip.name == name {
            return Some(Branch(store: f.capture.store, id: tip.id))
        }
    }
    None
}

fn follower_tip(f: Follower, b: Branch) -> Result[View[Tip], Error] in f {
    if !same(f.capture.store, b.store) {
        return Error(Foreign)
    }
    for i in 0u64 .. list.len(f.capture.state.tips) {
        let tip = view f.capture.state.tips[i]
        if tip.id == b.id {
            return Ok(tip)
        }
    }
    if b.id < f.capture.state.next_branch {
        Error(Gone(b.id))
    } else {
        Error(Unseen(b.id))
    }
}

pub fn snapshot_follower(f: Follower, b: Branch) -> Result[Snapshot, Error] {
    let tip = follower_tip(f, b)?
    Ok(Snapshot(store: b.store, open: f.open, branch: b.id, head: tip.head, roots: share_roots(tip.roots), watermark: f.capture.watermark))
}

pub fn applied(f: Follower, b: Branch) -> Result[Position, Error] {
    let tip = follower_tip(f, b)?
    Ok(Position(store: b.store, branch: b.id, version: tip.head))
}

fn follower_main(f: Follower) -> Branch {
    Branch(store: f.capture.store, id: 0)
}

pub fn catch_up(mut f: Follower, deadline_ns: u64) -> Result[Position, Error] waits {
    if let Some(problem) = f.stopped {
        return Error(Full(problem))
    }
    let previous = applied(f, follower_main(f))?
    if host.mono_ns(f.clock) >= deadline_ns {
        return Error(Behind(previous))
    }
    let update: Result[Option[Arc[FollowCapture]], Error] = match f.backend {
        FollowLog(d) => {
            let outcome = log_follow_private(f.tasks, d, Some(f.capture.store), f.ceiling - f.capture.resident)
            match take outcome {
                Ok(take fresh_capture) => Ok(Some(take fresh_capture)),
                Error(Full(Resident(c))) => Error(Full(Resident(Capacity(requested: int.saturating_add(f.capture.resident, c.requested), available: f.ceiling)))),
                Error(take problem) => Error(take problem),
            }
        },
        FollowObject(mut io) => {
            let due = order.min(clock.deadline_after_ms(host.mono_ns(f.clock), io.op_ms), deadline_ns)
            let previous_capture = arc.share(f.capture)
            object_follow_private(f.tasks, mut io, Advance(Some(take previous_capture)), Some(f.capture.store), f.ceiling, due)
        },
    }
    let newer = match take update {
        Ok(Some(take minted)) => take minted,
        Ok(None) => return Ok(previous),
        Error(Full(Resident(c))) => {
            f.stopped = Some(Resident(c))
            return Error(Full(Resident(c)))
        },
        Error(Remote(Retriable(Deadline))) if host.mono_ns(f.clock) >= deadline_ns => return Error(Behind(previous)),
        Error(take problem) => return Error(take problem),
    }
    if host.mono_ns(f.clock) >= deadline_ns {
        return Error(Behind(previous))
    }
    if newer.state.tips[0].head < previous.version {
        return Error(Diverged(0))
    }
    f.capture = take newer
    applied(f, follower_main(f))
}

pub fn fresh(mut f: Follower, deadline_ns: u64) -> Result[Snapshot, Error] waits {
    let _ = catch_up(mut f, deadline_ns)?
    snapshot_follower(f, follower_main(f))
}

pub fn at_least(mut f: Follower, p: Position, deadline_ns: u64) -> Result[Snapshot, Error] waits {
    let b = Branch(store: p.store, id: p.branch)
    loop {
        match applied(f, b) {
            Ok(current) if current.version >= p.version => return snapshot_follower(f, b),
            Error(Unseen(_)) => (),
            Error(take problem) => return Error(take problem),
            _ => (),
        }
        if host.mono_ns(f.clock) >= deadline_ns {
            let current = applied(f, b)?
            return Error(Behind(current))
        }
        if let FollowLog(_) = f.backend {
            // A log follower requires writer exclusion for its life.
            host.sleep_until(f.clock, deadline_ns)
            continue
        }
        match catch_up(mut f, deadline_ns) {
            Ok(_) => (),
            Error(Behind(_)) => (),
            Error(Reclaimed(_)) => (),
            Error(take problem) => return Error(take problem),
        }
        match applied(f, b) {
            Ok(current) if current.version >= p.version => return snapshot_follower(f, b),
            Error(Unseen(_)) => (),
            Error(take problem) => return Error(take problem),
            _ => (),
        }
        let poll = clock.deadline_after_ms(host.mono_ns(f.clock), 10)
        host.sleep_until(f.clock, order.min(poll, deadline_ns))
    }
}


fn read_only_checkpoint(d: Dir, id: StoreId, take manifest: PageManifest) -> Result[JournalReplay, Error] waits {
    let validated = validate_page_manifest(d, id, take manifest)?
    let ValidatedPageManifest(manifest: take selected, graph: take resolved, ..) = take validated
    let mut graph = take resolved
    let empty_collection = disk_allocation(fn() -> Result[Arc[std.page.Page], Error] {
        Ok(std.page.empty(0, 0, Collection))
    })?
    let pages = attach_page_graph(mut graph, empty_collection)?
    let state = disk_allocation(scoped fn() -> Result[State, Error] {
        let holders = attach_manifest_holders(selected, pages, empty_collection)
        capacity(manifest_state(selected, holders))
    })?
    journal_replay_manifest(take state, selected)
}

fn log_floor(directory: Dir, store_id: StoreId, opened: u64, ceiling: u64, at_most: u64) -> Result[Option[Snapshot], Error] waits {
    let (take raw, id, take manifest) = read_only_manifest(directory)?
    check_expected_store(Some(store_id), id)?
    if manifest.branches[0u64].version > at_most { return Ok(None) }
    let recovered = read_only_checkpoint(directory, id, take manifest)?
    over_ceiling(journal_account(recovered)?, ceiling)?
    check_read_only_manifest(directory, raw)?
    let tip = view recovered.state.tips[0u64]
    Ok(Some(Snapshot(store: id, open: opened, branch: 0, head: tip.head, roots: share_roots(tip.roots), watermark: stamp_after(recovered.next_node)?)))
}

pub fn follower_floor(mut f: Follower, at_most: u64) -> Result[Option[Snapshot], Error] waits {
    let id = f.capture.store
    let needed = f.ceiling - f.capture.resident
    match f.backend {
        FollowLog(directory) => log_floor(directory, id, f.open, needed, at_most),
        FollowObject(mut io) => {
            let due = clock.deadline_after_ms(host.mono_ns(f.clock), io.op_ms)
            let found = object_follow_private(f.tasks, mut io, Floor(at_most), Some(id), needed, due)?
            match found {
                Some(captured) => {
                    let tip = view captured.state.tips[0u64]
                    Ok(Some(Snapshot(store: id, open: f.open, branch: 0, head: tip.head, roots: share_roots(tip.roots), watermark: captured.watermark)))
                },
                None => Ok(None),
            }
        },
    }
}

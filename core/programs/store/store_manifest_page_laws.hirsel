fn page_planted_manifest_vector() -> Bytes {
    let mut raw = page_manifest_vector()
    // The pack-list PagePtr's offset is at byte 88 + 192 + 8.
    list.set_word_le(mut raw, 288, 88u64)
    list.set_word_le(mut raw, 80, 0x6e7e59fe9364fb25u64)
    take raw
}

#!/usr/bin/env bash
# Build the Darwin-host LLVM pin (`darwin_llvm` in llvm-23.lock): the compiler's
# lib/libLLVM.23.1.dylib and a bin/ld.lld with the ELF and Mach-O ports
# (static-lld-elf-macho.patch) that loads that dylib through @loader_path/../lib.
#
#   build-libllvm-darwin DIR [package]   build and package DIR/llvm-darwin.tar.xz, or
#                                         package an already-built tree, and print its
#                                         lock record
#
# The archive is the prefix a Mac-hosted compiler reads as LLVM_SYS_231_PREFIX:
# bin/ld.lld, bin/llvm-config, bin/llvm-ar, bin/llvm-objcopy and bin/llvm-objdump (the bridge build
# scripts archive with one and read the dylib's LC_UUID with the other),
# lib/libLLVM.23.1.dylib and its libLLVM-23.dylib alias
# (the name `llvm-config --link-shared --libs` links by), include/llvm and
# include/llvm-c, and the licenses. The installer copies bin/ld.lld and lib/libLLVM.23.1.dylib into an
# installation, so the linker's one search path is @loader_path/../lib and the dylib
# has none. Configuration: Release without assertions, targets X86 and AArch64,
# zlib on (the SDK's libz), zstd, libxml2, libedit, ffi, z3 and libpfm off, no
# profile, LTO or BOLT; minos comes from the macOS target record and build paths are
# mapped out of the binaries. The result loads only libSystem, libc++ and libz.
#
# Run once per pin change on an Apple Silicon Mac at or above the floor, with the
# Xcode command line tools (xcrun), cmake and ninja on PATH, under JOBS jobs
# (default 4; about 25 minutes at 8 on an M4 Pro). Then upload DIR/llvm-darwin.tar.xz
# to the release in `asset_pool` under the printed asset name and write the record
# into llvm-23.lock. Nothing rebuilds it per land.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lock="$here/llvm-23.lock"
fail() { echo "build-libllvm-darwin: $*" >&2; exit 1; }
if (( $# < 1 || $# > 2 )) || [[ ${2:-package} != package ]]; then
  echo "usage: build-libllvm-darwin DIR [package]" >&2
  exit 2
fi
[[ "$(uname -s)-$(uname -m)" == Darwin-arm64 ]] || fail "run this on an Apple Silicon Mac"
lock_value() {
  awk -v k="$1" '$1 == k { sub(/^[^ ]+ /, ""); print; found = 1 } END { exit !found }' "$lock" \
    || fail "llvm-23.lock has no '$1' record"
}

mkdir -p "$1"
dir="$(cd "$1" && pwd)"
jobs=${JOBS:-4}
version="$(lock_value llvm_version)"
major=${version%%.*}
apple=$(python3 "$here/../buck2/apple_records.py" macos triple floor)
read -r triple floor <<< "$apple"
library_path="$(python3 "$here/../toolchain-dist/product.py" llvm-path "$triple")"
library="${library_path##*/}"
build="$dir/build"
tools="llvm-config llvm-ar llvm-objcopy llvm-objdump"
stage="$dir/stage"

if (( $# == 1 )); then
  archive="$dir/llvm-project-$version.src.tar.xz"
  [[ -f "$archive" ]] || curl -fsSL "$(lock_value source_url)" -o "$archive" || fail "could not download the source archive"
  [[ "$(shasum -a 256 "$archive" | cut -d ' ' -f 1)" == "$(lock_value source_sha256)" ]] || fail "$archive does not have the locked SHA-256"
  rm -rf "$dir/src" "$build"
  mkdir "$dir/src"
  tar xf "$archive" --strip-components=1 -C "$dir/src"
  patch -s -d "$dir/src" -p1 < "$here/static-lld-elf-macho.patch"

  sdk="$(xcrun --sdk macosx --show-sdk-path)"
  flags="-ffile-prefix-map=$dir/=/llvm/"
  cmake -G Ninja -S "$dir/src/llvm" -B "$build" \
    -DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_ASSERTIONS=OFF \
    -DCMAKE_C_COMPILER="$(xcrun --find clang)" -DCMAKE_CXX_COMPILER="$(xcrun --find clang++)" \
    -DCMAKE_OSX_SYSROOT="$sdk" -DCMAKE_OSX_ARCHITECTURES=arm64 -DCMAKE_OSX_DEPLOYMENT_TARGET="$floor" \
    -DCMAKE_C_FLAGS="$flags" -DCMAKE_CXX_FLAGS="$flags" \
    -DLLVM_HOST_TRIPLE="$triple" -DLLVM_DEFAULT_TARGET_TRIPLE="$triple" \
    -DLLVM_TARGETS_TO_BUILD='X86;AArch64' -DLLVM_ENABLE_PROJECTS=lld \
    -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON \
    -DLLVM_ENABLE_ZLIB=FORCE_ON -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_LIBXML2=OFF -DLLVM_ENABLE_LIBEDIT=OFF \
    -DLLVM_ENABLE_FFI=OFF -DLLVM_ENABLE_Z3_SOLVER=OFF -DLLVM_ENABLE_LIBPFM=OFF \
    -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_PARALLEL_LINK_JOBS=2 > "$dir/cmake.log" || fail "cmake failed (see $dir/cmake.log)"
  nice -n 19 ninja -C "$build" -j "$jobs" LLVM lld $tools > "$dir/ninja.log" \
    || fail "the build failed (see $dir/ninja.log)"
fi

rm -rf "$stage"
for component in LLVM lld $tools llvm-headers; do
  cmake --install "$build" --prefix "$stage" --strip --component "$component" > /dev/null
done
# One linker file: the driver passes `-flavor darwin` for Mach-O, and ld.lld is ELF.
rm -f "$stage/bin/ld.lld" "$stage/bin/ld64.lld" "$stage/lib/libLLVM.dylib"
find "$stage/bin" -type l -delete
mv "$stage/bin/lld" "$stage/bin/ld.lld"
mkdir -p "$stage/share/licenses/llvm-project"
for component in llvm lld; do
  cp "$dir/src/$component/LICENSE.TXT" "$stage/share/licenses/llvm-project/$component-LICENSE.TXT"
done
# LLVM's CMake gives every Mach-O the run path @loader_path/../lib. The dylib needs
# none: it loads only system libraries, and the executable that loads it finds it.
install_name_tool -delete_rpath @loader_path/../lib "$stage/$library_path" 2> /dev/null
# strip and install_name_tool invalidate the ad hoc signatures; arm64 runs signed code only.
executables=("$stage/bin/ld.lld")
for tool in $tools; do executables+=("$stage/bin/$tool"); done
codesign -f -s - "${executables[@]}" "$stage/$library_path" 2> /dev/null

[[ "$(otool -D "$stage/$library_path" | sed -n 2p)" == "@rpath/$library" ]] || fail "$library is not named @rpath/$library"
loads() { otool -L "$1" | tail -n +2 | awk '{ print $1 }'; }
rpaths() { otool -l "$1" | awk '$1 == "cmd" { rpath = ($2 == "LC_RPATH") } rpath && $1 == "path" { print $2 }'; }
for file in "${executables[@]}" "$stage/$library_path"; do
  for name in $(loads "$file"); do
    case "$name" in
      "@rpath/$library" | /usr/lib/libSystem.B.dylib | /usr/lib/libc++.1.dylib | /usr/lib/libz.1.dylib) ;;
      *) fail "${file#"$stage/"} loads $name" ;;
    esac
  done
  minos="$(otool -l "$file" | awk '$1 == "minos" { print $2; exit }')"
  [[ "$minos" == "$floor" ]] || fail "${file#"$stage/"} has minos $minos, not $floor"
  codesign -v --strict "$file" || fail "${file#"$stage/"} has no valid signature"
done
# llvm-config alone keeps the build tree, as the answer to --src-root and --obj-root.
for file in "$stage/bin/ld.lld" "$stage/$library_path"; do
  ! grep -qF "$dir" "$file" || fail "${file#"$stage/"} names the build directory"
done
[[ "$(rpaths "$stage/bin/ld.lld")" == '@loader_path/../lib' ]] || fail "ld.lld's search path is not @loader_path/../lib"
[[ -z "$(rpaths "$stage/$library_path")" ]] || fail "$library carries a search path"
[[ "$("$stage/bin/ld.lld" --version)" == *" $version "* ]] || fail "ld.lld does not report $version"
[[ "$("$stage/bin/ld.lld" -flavor darwin --version)" == *" $version"* ]] || fail "ld.lld has no Mach-O port"
[[ "$("$stage/bin/llvm-config" --version)" == "$version" ]] || fail "llvm-config does not report $version"
for tool in llvm-ar llvm-objcopy llvm-objdump; do
  [[ "$("$stage/bin/$tool" --version)" == *"LLVM version $version"* ]] || fail "$tool does not report $version"
done

# The bootstrap flattens the alias into a copy; the archive keeps it a link.
python3 - "$stage" "$dir/llvm-darwin.tar.xz" <<'EOF'
import os, sys, tarfile
stage, out = sys.argv[1:]
def clean(info):
    info.uid = info.gid = 0
    info.uname = info.gname = ""
    info.mtime = 0
    return info
with tarfile.open(out, "w:xz") as archive:
    for directory, names, files in os.walk(stage):
        names.sort()
        for name in sorted(names + files):
            path = os.path.join(directory, name)
            if os.path.isdir(path) and not os.path.islink(path):
                continue
            archive.add(path, os.path.relpath(path, stage), recursive=False, filter=clean)
EOF
echo "darwin_llvm $(shasum -a 256 "$dir/llvm-darwin.tar.xz" | cut -d ' ' -f 1) $(stat -f %z "$dir/llvm-darwin.tar.xz") llvm-$version-darwin-tools-macos$floor-arm64.tar.xz"

// The host's side of an admission's end (launch.md "The launcher", "Publish and assemble"
// step 3; "The law gate"): the launcher's Admitted summary and its failures, and the law
// gate's green verdict recorded in the request row.
// The verifier admitted the release: the host checks its overlap memory and grants against
// OLD's recipe, then assembles at once or sends the operator the approval text to confirm.
// A refusal fails the request durably.
fn admitted(mut h: Host, a: launcher.Attempt, root: Bytes, summary: launcher.Summary, display: String, mut out: List[launcher.Request]) waits {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    let Ok(Some(g)) = group_row(h, name) else {
        return
    }
    let mut v = vol_read(h, name)
    let Some(take adm) = replace(mut v.admit, None) else {
        return
    }
    let mut d = take adm
    let request: Bytes = clone(d.request)
    let mut why = string.new()
    // OLD and NEW run side by side through the cutover, so the group's memory bounds both.
    if let Some(m) = g.memory {
        if summary.root_limit > m || summary.old_root_limit > m - summary.root_limit {
            why = "Refused(Memory)"
        }
    }
    // Any change of authority, gained or lost, runs only under a person's approval of exactly
    // that diff (launch.md "Deploy preview"): without one the attempt is released and the
    // request waits durably for a Decide, so an approval given for another diff approves
    // nothing.
    let Ok(Some(row)) = request_row(h, request) else {
        list.push(mut out, Release(a))
        return
    }
    if !subject_still_current(h, row) {
        vol_put(mut h, name, take v)
        list.push(mut out, Release(a))
        fail_request(mut h, request, ConflictClass, "the approved group predecessor changed")
        return
    }
    let Some((_, _, foreign, exec)) = admission_ask(row.begin) else {
        list.push(mut out, Release(a))
        fail_request(mut h, request, StoreClass, "invalid stored submission")
        return
    }
    let mut facts = decision_of(row.input, summary.gate, AdmissionStage, summary.grants, operator.no_triggers())
    facts.root = Some(clone(root))
    if display != "" {
        facts.approvals = Some(operator.Approvals(r: clone(root), foreign: take foreign, exec: take exec, text: string.from(display)))
    }
    let approved = match row.admission_plan {
        Some(previous) => operator.decision_bytes(previous) == operator.decision_bytes(facts),
        None => false,
    }
    let needs_consent = !approved && (!launcher.grants_empty(summary.grants) || stops_at_plan(row) || !is_none(row.admission_plan) || display != "")
    let baseline: Option[operator.Decision] = if !approved && !needs_consent && why == "" {
        Some(clone(facts))
    } else {
        None
    }
    if !is_none(baseline) || !is_none(summary.gate) {
        if let Error(e) = record_admission(mut h, request, summary.gate, baseline) {
            vol_put(mut h, name, take v)
            list.push(mut out, Release(a))
            fail_request(mut h, request, class_of(e), refused_text(e))
            return
        }
    }
    if why == "" && (needs_consent || (display != "" && is_none(owner_of(h, request)))) {
        vol_put(mut h, name, take v)
        list.push(mut out, Release(a))
        hold(mut h, request, facts)
        return
    }
    let denied = why != ""
    let confirming = !denied && display != "" && !is_none(owner_of(h, request))
    let owner = owner_of(h, request)
    if denied {
        d.stage = Rejected(string.from(why))
        list.push(mut out, Release(a))
    } else if confirming {
        d.stage = Confirming(string.from(display))
    } else {
        d.stage = Assembling
        list.push(mut out, Assemble(a))
    }
    d.summary = Some(clone(summary))
    v.admit = Some(take d)
    vol_put(mut h, name, take v)
    if denied {
        fail_request(mut h, request, DeniedClass, why)
    } else if confirming {
        if let Some(conn) = owner {
            say(mut h, conn, DisplayAnswer(clone(request), a, clone(root), string.from(display)), false)
        }
    }
}

// Request d's gated source admitted green: its row records the tree, H and toolchain the
// tests ran against (launch.md "The law gate" step 5), before any hold or assembly.
fn record_admission(mut h: Host, d: Bytes, green: Option[launcher.Green], baseline: Option[operator.Decision]) -> Result[(), Refused] waits {
    let made = {
        let t = view h.t
        let g = view green
        let approved = view baseline
        store.run(mut h.db, None, (store.copy_env(d), store.copy_env(t), store.copy_env(g), store.copy_env(approved)), fn(mut tx, call_env) -> Result[(), Refused] {
            let Some(found) = st(store.fetch(tx, call_env.1 .requests, call_env.0))? else {
                return Ok(())
            }
            let mut row = found
            if let Done(_) = row.status {
                return Ok(())
            }
            row.gate = clone(call_env.2)
            if let Some(facts) = call_env.3 {
                row.admission_plan = Some(clone(facts))
            }
            st(store.put(mut tx, call_env.1 .requests, call_env.0, row))?
            Ok(())
        })
    }
    decided(mut h, take made)
}

fn failure_class(why: launcher.Failure) -> operator.Class {
    match why {
        Denied(_) => DeniedClass,
        Invalid(_) => InvalidClass,
        Unassembled(_) => UnassembledClass,
        Uncompiled(_) => UncompiledClass,
        Exhausted(_) => ExhaustedClass,
        Red(_) => RedClass,
        GateLost(_) => BusyClass,
    }
}

fn failure_text(why: launcher.Failure) -> String {
    match why {
        Denied(w) => string.from(w),
        Invalid(w) => string.from(w),
        Unassembled(w) => string.from(w),
        Uncompiled(w) => string.from(w),
        Exhausted(w) => string.from(w),
        Red(rows) => {
            let mut text = string.new()
            for row in rows {
                if text != "" {
                    string.push(mut text, "\n")
                }
                string.push(mut text, row)
            }
            text
        },
        GateLost(w) => string.from(w),
    }
}

fn unadmitted(mut h: Host, a: launcher.Attempt, why: launcher.Failure) waits {
    let Some(name) = admitting_group(h, a) else {
        return
    }
    let Some(d) = vol_read(h, name).admit else {
        return
    }
    // A lost gate session is never a verdict: the admission ends as a new launcher session
    // ends it, and the same Begin admits D again (launch.md "The law gate" step 4).
    if let GateLost(_) = why {
        list.push(mut h.later, Release(a))
        interrupted(mut h, name)
        return
    }
    set_stage(mut h, name, Unadmitted(clone(why)))
    fail_request(mut h, d.request, failure_class(why), failure_text(why))
}

// Opens the launcher's admission of request d's input under attempt `a` (launch.md "Publish
// and assemble"), with the group's working directory, OLD's assembly and the operator's
// Foreign and Exec lines. A publication's input is complete at once.
fn start_admission(mut h: Host, name: String, g: GroupRow, d: Bytes, a: launcher.Attempt, input: launcher.Input, foreign: List[String], exec: List[String], approved: launcher.Grants, genesis: bool, deadline_ms: u64, mut out: List[launcher.Request]) {
    let complete = match input {
        Attested(_) => false,
        _ => true,
    }
    let old: Option[Bytes] = if genesis {
        None
    } else {
        Some(clone(g.assembly))
    }
    // A recording group's every image carries the recording runtime, so each serving start
    // can record (launch.md "Recording a group").
    let recording = match g.record {
        Some(_) => true,
        None => false,
    }
    let approvals = launcher.Approvals(recording: recording, foreign: clone(foreign), exec: clone(exec), workdir: string.from(g.workdir), old: take old, packages: clone(g.packages))
    list.push(mut out, Admit(group_of(name, g.incarnation), a, clone(input), take approvals, deadline_ms))
    let mut w = vol_read(h, name)
    w.admit = Some(Admitting(request: clone(d), attempt: a, incarnation: g.incarnation, approved: clone(approved), stage: Uploading(0u64, false), summary: None, ended: complete, genesis: genesis, receive: None))
    vol_put(mut h, name, take w)
}

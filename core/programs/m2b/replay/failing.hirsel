// M2b slice 3 cases for a recorded call that fails, run inside `isolate` (FAIL-16).
// Each case returns a hand-derived u64 (core/corpus/m2b/replay_fail/SPEC.md).
fn divide(b: Bytes) -> Result[Bytes, Capacity] {
    let _ = 1 / list.len(b)
    Ok(list.new())
}

fn code_of(take d: m2b.journal.Diverged) -> u64 {
    match take d {
        Missing(i) => 100 + i,
        Code(i) => 200 + i,
        Arg(i) => 300 + i,
        Outcome(i) => 400 + i,
        Extra(i) => 500 + i,
        Full(_) => 999,
    }
}

fn value(take r: Result[u64, m2b.journal.Diverged]) -> u64 {
    match take r {
        Ok(v) => v,
        Error(take d) => code_of(take d),
    }
}

fn failed(take r: Result[Result[Bytes, Capacity], Causes]) -> u64 {
    match take r {
        Error(_) => 1,
        Ok(_) => 0,
    }
}

// A call that fails with Division is recorded as a failure, and replay fails the same way.
pub fn fails() -> Result[u64, m2b.journal.Diverged] {
    let mut j = m2b.journal.recording(65536)
    let empty: Bytes = list.new()
    let a = failed(m2b.journal.call_isolated(mut j, code.describe(divide), empty)?)
    m2b.journal.rewind(mut j)
    let b = failed(m2b.journal.call_isolated(mut j, code.describe(divide), empty)?)
    m2b.journal.finish(j)?
    let outcome: u64 = match list.get(j.entries, 0) {
        Some(e) => if list.len(e.outcome) == 2 {
            let tag: u64 = int.widen(e.outcome[0])
            let kind: u64 = int.widen(e.outcome[1])
            tag * 10 + kind
        } else {
            99
        },
        None => 99,
    }
    Ok(list.len(j.entries) * 10000 + a * 1000 + b * 100 + outcome)
}

// A journal recorded by an older body of divide (PROG-9: a body change keeps the
// identity) that failed with Overflow: entry 0's outcome is set to the Overflow failure
// (tag 2, kind 1). Replay fails with Division: Outcome(0).
pub fn cause_changed() -> Result[u64, m2b.journal.Diverged] {
    let mut j = m2b.journal.recording(65536)
    let empty: Bytes = list.new()
    let _ = m2b.journal.call_isolated(mut j, code.describe(divide), empty)?
    let code0 = match list.get(j.entries, 0) {
        Some(e) => e.code,
        None => return Ok(1),
    }
    let mut older: Bytes = list.new()
    list.push(mut older, 2u8)
    list.push(mut older, 1u8)
    let _ = list.set(mut j.entries, 0, m2b.journal.Entry(code: code0, arg: list.new(), outcome: take older))
    m2b.journal.rewind(mut j)
    let _ = m2b.journal.call_isolated(mut j, code.describe(divide), empty)?
    Ok(1)
}

pub fn case_fails() -> u64 {
    value(fails())
}

pub fn case_cause_changed() -> u64 {
    value(cause_changed())
}

fn select(name: String) -> Option[u64] {
    if name == "fails" {
        Some(case_fails())
    } else if name == "cause_changed" {
        Some(case_cause_changed())
    } else {
        None
    }
}

pub fn main(out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let Some(name) = args.get(argv, 0) else {
        return Error(Exit(status: 2))
    }
    let Some(v) = select(name) else {
        return Error(Exit(status: 2))
    }
    let mut s = string.new()
    string.push_u64(mut s, v)
    string.push(mut s, "\n")
    match stdout.write(out, s) {
        Ok(()) => Ok(()),
        Error(_) => Error(Exit(status: 2)),
    }
}

fn mixed() -> u64 {
    let f: fn(u64, u64) -> u64 = fn(a: u64, b) {
        a + b
    }
    f(1, 2)
}

fn uncontextual() -> u64 {
    let _ = fn(n) -> u64 {
        n
    }
    0
}

fn fold[A, T](xs: List[T], combine: fn(A, T) -> A, take init: A) -> A {
    init
}

fn open_parameter(xs: List[u64]) -> u64 {
    let sum = fold(xs, fn(acc, x) {
        acc + x
    }, 0)
    sum
}

fn wrong_mode() -> u64 {
    let f: fn(take String) -> u64 = fn(s) {
        string.byte_len(s)
    }
    f("text")
}

fn top_level(x) -> u64 {

// Module `pool`: a generational slot pool (Rust slotmap / generational-arena), library code
// as MEM-18 describes. Field legend: API.md, "Reading a contract"; design: API.md, "Pool".
// It uses only core operations: `unique.new` for the pool's identity, `list.with_capacity`,
// `list.push`, `list.get`, `list.set`, `list.len`, `replace` and checked arithmetic.
//
// Representation: `slots` is a List[Slot[T]] (24-byte header; storage capacity x
// size(Slot[T]) with size(Slot[T]) = 8 + max(8 + size(T), 16)), charged like any list to
// the limit where the pool was made (MEM-26). Vacant slots form an intrusive free list,
// so removing never allocates. Each slot's generation starts at 0 and rises by one on
// every removal; a slot whose generation reaches 2^64 - 1 is retired: never reused, its
// storage kept until the pool is cleaned.
//
// Checking: an Id is plain data, the pool's Unique, a slot index and a generation. Every
// access compares all three at run time and returns Error(Stale) on any mismatch. There
// is no static brand, so an Id may be stored anywhere: in a local, a record, a Map's keys
// or values, or inside the pool's own values. Removal is explicit; cleaning the pool
// cleans every live value by ordinary list cleanup (FAIL-8). Unique is plain, so a
// identity is plain data (MEM-18). Pool itself is an opaque owner, so MEM-17 refuses
// cloning it; a new pool always receives a fresh identity.
pub opaque type Pool[T] {
    me: Unique,
    slots: List[Slot[T]],
    free: u64,
    live: u64
}

type Slot[T] = Occupied(u64, T) | Vacant(u64, u64) // (generation, value | next free)

/// The end of the free list, and the generation at which a slot retires.
const NONE: u64 = 18446744073709551615

/// A handle to one value in one pool: plain (its fields are) and key, 24 bytes. Equal Ids
/// name the same slot of the same pool at the same generation.
pub opaque type Id[T]: key {
    pool: Unique,
    index: u64,
    generation: u64
}

/// Why an Id did not resolve. WrongPool: it was issued by a pool with another identity
/// (another pool, or what this place held before a new pool was assigned to it).
/// Removed: its value was removed (the slot may hold a newer value, or be vacant or
/// retired).
pub type Stale = WrongPool | Removed

/// An empty pool with no storage and a fresh identity (`unique.new`, which cannot fail).
/// Alloc: nothing. Ex: `let mut p: std.pool.Pool[Entry] = std.pool.new()`
pub fn new[T]() -> Pool[T] {
    Pool(me: unique.new(), slots: list.new(), free: NONE, live: 0)
}

/// An empty pool with storage for n slots: `list.with_capacity` of slots.
/// Fails: Error(c). Alloc: n x size(Slot[T]) rounded to 8, current limit.
/// Ex: `let mut p: std.pool.Pool[Entry] = std.pool.with_capacity(64)?`
pub fn with_capacity[T](n: u64) -> Result[Pool[T], Capacity] {
    let slots: List[Slot[T]] = list.with_capacity(n)?
    Ok(Pool(me: unique.new(), slots: take slots, free: NONE, live: 0))
}

/// Number of live values. Cost: O(1). Ex: `std.pool.len(p)`
pub fn len[T](p: Pool[T]) -> u64 {
    p.live
}

/// Stores x in a vacant slot (the most recently vacated first) or a new one.
/// Fails: Error((c, x)) when a new slot is needed and GROWTH is refused; p unchanged.
/// Alloc: GROWTH of slots only when no slot is vacant. Cost: amortised O(1).
/// Ex: `let h = std.pool.insert(mut l.pool, take entry)?`
pub fn insert[T](mut p: Pool[T], take x: T) -> Result[Id[T], (Capacity, T)] {
    if p.free == NONE {
        let index = list.len(p.slots)
        if let Error((c, take slot)) = list.push(mut p.slots, Occupied(0, take x)) {
            return match slot {
                Occupied(_, take v) => Error((c, take v)),
                Vacant(_, _) => fail("pool.insert: push returned another slot"),
            }
        }
        p.live += 1
        return Ok(Id(pool: p.me, index: index, generation: 0))
    }
    let index = p.free
    let (generation, free_next) = match p.slots[index] {
        Vacant(g, n) => (g, n),
        Occupied(_, _) => fail("pool: the free list names an occupied slot"),
    }
    let _ = list.set(mut p.slots, index, Occupied(generation, take x))
    p.free = free_next
    p.live += 1
    Ok(Id(pool: p.me, index: index, generation: generation))
}

/// A view of h's value. Fails: Error(Stale). View: anchored to p; FREEZE p. Cost: O(1).
/// Ex: `match std.pool.get(l.pool, h) { Ok(e) => string.byte_len(e.value), Error(_) => 0 }`
pub fn get[T](p: Pool[T], h: Id[T]) -> Result[View[T], Stale] in p {
    if h.pool != p.me {
        return Error(WrongPool)
    }
    match list.get(p.slots, h.index) {
        Some(Occupied(g, v)) if g == h.generation => Ok(v),
        _ => Error(Removed),
    }
}

/// h's value copied out, or x when h is stale. Cost: O(1). Ex: `std.pool.get_or(b, i, 0)`
pub fn get_or[T: plain](p: Pool[T], h: Id[T], x: T) -> T {
    match get(p, h) {
        Ok(v) => v,
        Error(_) => x,
    }
}

/// Whether h resolves. Cost: O(1). Ex: `std.pool.contains(p, h)`
pub fn contains[T](p: Pool[T], h: Id[T]) -> bool {
    match get(p, h) {
        Ok(_) => true,
        Error(_) => false,
    }
}

/// Calls f with h's value as an owned local and puts the value back; returns f's result.
/// The value is taken out with `list.set` of a Vacant placeholder and installed again
/// after f, so no mutable view is needed. f is a `scoped fn` (OWN-21): it may view or
/// lend `mut` the caller's locals but not p, which is lent for the call. If f fails, the
/// failure propagates, the value is cleaned with the local, and the slot is left vacant at
/// a new generation and off the free list, so h is stale from then on.
/// Fails: Error(Stale) without calling f. Alloc: nothing. Cost: O(1) plus f.
/// Ex: `std.pool.update(mut l.pool, h, fn(mut e: Entry) { e.prev = None })?`
pub fn update[T, R](mut p: Pool[T], h: Id[T], f: scoped fn(mut T) -> R) -> Result[R, Stale] {
    check(p, h)?
    // An occupied slot's generation is below NONE (a slot retires on reaching it).
    let placeholder: Slot[T] = Vacant(h.generation + 1, NONE)
    let slot = list.set(mut p.slots, h.index, take placeholder)
    let mut value = match slot {
        Occupied(_, take v) => take v,
        Vacant(_, _) => fail("pool.update: a checked slot was vacant"),
    }
    p.live -= 1
    let r = f(mut value)
    let _ = list.set(mut p.slots, h.index, Occupied(h.generation, take value))
    p.live += 1
    Ok(take r)
}

/// Removes h's value and returns it; the slot's generation rises by one, so every Id to
/// it is stale from now on; at 2^64 - 1 the slot retires instead of joining the free
/// list. Fails: Error(Stale), p unchanged. Alloc: nothing. Cost: O(1).
/// Ex: `let old = std.pool.remove(mut l.pool, tail)?`
pub fn remove[T](mut p: Pool[T], h: Id[T]) -> Result[T, Stale] {
    check(p, h)?
    let bumped = h.generation + 1
    let retired = bumped == NONE
    let link = if retired {
        NONE
    } else {
        p.free
    }
    let slot = list.set(mut p.slots, h.index, Vacant(bumped, link))
    if !retired {
        p.free = h.index
    }
    p.live -= 1
    match slot {
        Occupied(_, take v) => Ok(take v),
        Vacant(_, _) => fail("pool.remove: a checked slot was vacant"),
    }
}

fn check[T](p: Pool[T], h: Id[T]) -> Result[(), Stale] {
    match get(p, h) {
        Ok(_) => Ok(()),
        Error(e) => Error(e),
    }
}

/// Removes every live value, invalidating its Id, while keeping slot storage and pool
/// identity. Every generation advances exactly as in remove; exhausted slots stay retired.
/// Vacant slots are reused in increasing slot order. Alloc: nothing. Cost: O(slots).
/// Ex: `std.pool.clear(mut cache)`
pub fn clear[T](mut p: Pool[T]) {
    p.free = NONE
    let mut i = list.len(p.slots)
    while i > 0 {
        i -= 1
        let generation = match p.slots[i] {
            Occupied(g, _) => g + 1,
            Vacant(g, _) => g,
        }
        let _ = list.set(mut p.slots, i, Vacant(generation, p.free))
        if generation != NONE { p.free = i }
    }
    p.live = 0
}

/// The first live slot at or after at, as (Id, value view, next cursor). None at the
/// end; begin with 0 and pass the returned cursor to the next call. Order is slot order,
/// independent of insertion order. View: anchored to p; FREEZE p while held.
/// Alloc: nothing. Cost: O(slots scanned), O(slots) for a complete walk.
/// Ex: `if let Some((h, value, at)) = std.pool.next(p, 0) { .. }`
pub fn next[T](p: Pool[T], at: u64) -> Option[(Id[T], View[T], u64)] in p {
    let mut i = at
    while i < list.len(p.slots) {
        if let Occupied(g, v) = p.slots[i] {
            return Some((Id(pool: p.me, index: i, generation: g), v, i + 1))
        }
        i += 1
    }
    None
}

// A workload error: the exit status the corpus gives its class (2 for input and I/O,
// 3 for Capacity, 4 for cancellation), and the label the program prints as failure=.
pub type Error: send {
    exit: Exit,
    label: String,
    capacity: Option[Capacity]
}

pub fn error(take label: String) -> Error {
    Error(exit: Exit(status: 2), label: take label, capacity: None)
}

pub fn ambient_capacity(c: Capacity) -> Error {
    Error(exit: Exit(status: 3), label: "Capacity@ambient", capacity: Some(c))
}

pub fn mapped[T, U](xs: List[T], f: scoped fn(T) -> Result[U, Error]) -> Result[List[U], Error] {
    let mut ys: List[U] = list.with_capacity(list.len(xs))
    for x in xs {
        list.push(mut ys, f(x)?)
    }
    Ok(take ys)
}

pub fn count_if[T](xs: List[T], f: scoped fn(T) -> bool) -> u64 {
    let mut n: u64 = 0
    for x in xs {
        if f(x) {
            n += 1
        }
    }
    n
}

pub fn put(out: Stdout, s: String) -> Result[(), Error] waits {
    match stdout.write(out, s) {
        Ok(()) => Ok(()),
        Error(_) => Error(error("Io@stdout"))
    }
}

pub fn number(s: String) -> Result[u64, Error] {
    match (int.parse(s) : Result[u64, ParseError]) {
        Ok(n) => Ok(n),
        Error(_) => Error(error("Parse@number"))
    }
}

pub fn line(s: String, mut at: u64) -> View[String] in s {
    let start = at
    let Some((row, next)) = string.next_line(s, start) else {
        return string.slice(s, start, start)
    }
    at = next
    // M1 also strips a CR at the end of an unterminated final line.
    if next == string.byte_len(s) && string.as_bytes(s)[next - 1] == b'\r' {
        return string.slice(s, start, next - 1)
    }
    row
}

pub fn name(prefix: String, n: u64, suffix: String) -> String {
    let mut s = string.from(prefix)
    string.push_u64(mut s, n)
    string.push(mut s, suffix)
    s
}

pub fn admission(variant: String, site: String, requested: u64) -> Result[(), Error] {
    if let Some(s) = string.strip_prefix(variant, "capacity:") {
        if s == site {
            let mut label = string.from("Capacity@")
            string.push(mut label, site)
            return Error(Error(exit: Exit(status: 3), label: take label, capacity: Some(Capacity(requested: if requested > 18446744073709551608 {
                18446744073709551615
            } else {
                ((requested + 7) / 8) * 8
            }, available: 0))))
        }
    }
    Ok(())
}

pub resource type Marker grant bytes 256 {
    release: String,
    events: Sender[String]
} drop(m) {
    let s = string.from(m.release)
    let _ = channel.try_send(m.events, take s)
}

pub fn marker(tx: Sender[String], label: String) -> Result[Marker, Error] {
    let mut acquired = string.from("acquire=")
    string.push(mut acquired, label)
    let mut released = string.from("release=")
    string.push(mut released, label)
    let owner = Marker(release: take released, events: channel.sender(tx)) ?=> |(c, _)| ambient_capacity(c)
    match channel.try_send(tx, take acquired) {
        Ok(()) => {},
        Error(_) => fail("trace capacity")
    }
    Ok(take owner)
}

pub fn finish(out: Stdout, take rx: Receiver[String], take outcome: Result[(), Error]) -> Result[(), Error] waits {
    while let Ok(take event) = channel.receive(rx) {
        put(out, event)?
        put(out, "\n")?
    }
    match take outcome {
        Ok(()) => Ok(()),
        Error(take e) => {
            put(out, "failure=")?;
            put(out, e.label)?;
            put(out, "\n")?;
            Error(take e)
        },
    }
}

/// main's result: the workload's outcome with its error reduced to its exit status
/// (PROG-3). The label has been printed already, or the run ended before any output.
pub fn exit(take r: Result[(), Error]) -> Result[(), Exit] {
    match take r {
        Ok(()) => Ok(()),
        Error(take e) => Error(e.exit),
    }
}

pub fn input(d: Dir, argv: Args) -> Result[String, Error] waits {
    let Some(path) = args.get(argv, 0) else {
        return Error(error("Parse@arguments"))
    }
    match std.file.read_string(d, path) {
        Ok(take s) => Ok(take s),
        Error(_) => Error(error("Io@input"))
    }
}

pub fn case_variant(argv: Args) -> View[String] in argv {
    match args.get(argv, 1) {
        Some(s) => s,
        None => "normal"
    }
}

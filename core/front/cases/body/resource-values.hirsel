// A1.4 (T1.2, T3.7, MEM-24): a resource value is a pointer to its block. The literal
// admits the block and writes the fields into it; a field is read through the
// holder; taking it apart copies the fields out and frees the block. Hand-derived:
// sum(5) reads 5 + 2 back from the block, first(9) reads the first field.
// expect: run sum(5) = 7
// expect: run first(9) = 9
resource type R { id: u64, k: u64 }
fn sum(x: u64) -> u64 {
  match R(id: x, k: 2) {
    Ok(r) => {
      let R(id: a, k: b) = take r
      a + b
    },
    Error(_) => 0
  }
}
fn first(x: u64) -> u64 {
  match R(id: x, k: 1) {
    Ok(r) => r.id,
    Error(_) => 0
  }
}

// rule: STORE-11
// expect: run
// authorities: {"main":{"provider":"authority.memory@1","floor":"memory"},"other":{"provider":"authority.sim@1","floor":"disk","seed":7,"represent":"log","levels":["cache","disk"],"faults":{}}}
// stdout: absent: not granted
// stdout: other levels: cache disk, floor disk
// stdout: main declares no disk
// stdout: claimed to 1
// stdout: second claim to 2
// stdout: first writer fenced
// stdout: fenced claim stays fenced
// stdout: a dead claim submits nothing
// stdout: submitted at 3 and 4
// stdout: answered 4 then 3, claim at 4
// stdout: read 4: claims of epochs 1 and 2 naming one identity, entries 3 and 4 kept
// stdout: put twice: ok
// stdout: other bytes: refused
// stdout: outside the claim's positions or epoch: 3 refused
// stdout: a short digest: put and get refused
// stdout: got 1 byte, missing object: none
// stdout: a created object at another position: refused
// stdout: entry 5 inventories its object
// stdout: a retirement at or past its own position or of a later epoch: 3 refused
// stdout: entry 6 retires entry 5's object
// stdout: reclaim with budget 1: refused
// stdout: reclaimed: the retired object gone, an unrecorded one at 7 gone, one at 8 kept
// stdout: a level of other is not main's
// stdout: a claim of main is not other's
// The authority seam: a grant names each authority and the levels its provider declares;
// a later claim fences the writer before it, whose claim stays dead and queues nothing;
// entries submitted together take consecutive positions, and waits taken newest first
// each answer their own; a read returns each claim as a record one epoch up naming the
// one store identity, and each entry as the payload it was submitted with; an object
// is put once, only with bytes of its digest, only by the live claim, of its epoch,
// at a position from the claim's next to 64 past it, and a digest not of 32 bytes
// names no object; a submit inventories only objects of its own position and epoch,
// and retires only objects of an earlier position and an epoch up to its own, and a
// read returns both with its entry; reclamation removes a retired object and one of
// a recorded position that its record does not inventory, and keeps one of the
// claim's epoch past the durable end; and a level or claim of one authority never
// narrows to another.
pub type Failed = Failed()

fn digest(data: Bytes) -> Bytes {
  bytes.from_inline(sha256.digest(data))
}

fn say(stdout: Stdout, line: String) -> Result[(), Failed] {
  match out.print(stdout, f"{line}\n") {
    Ok(_) => Ok(()),
    Error(_) => Error(Failed()),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Failed())
  }
  match io.authority(rt, "absent") {
    Ok(_) => say(stdout, "absent: granted")?,
    Error(NotGranted()) => say(stdout, "absent: not granted")?,
  }
  let Ok(a) = io.authority(rt, "main") else {
    return Error(Failed())
  }
  let Ok(b) = io.authority(rt, "other") else {
    return Error(Failed())
  }
  let mut names = ""
  for l in authority.levels(b) {
    names = f"{names} {level.name(l)}"
  }
  say(stdout, f"other levels:{names}, floor {level.name(authority.floor(b))}")?
  match authority.level(a, "disk") {
    Some(_) => say(stdout, "main declares disk")?,
    None() => say(stdout, "main declares no disk")?,
  }
  let floor = authority.floor(a)
  let Ok(made_first) = authority.claim(a) else {
    return Error(Failed())
  }
  let mut first = take made_first
  say(stdout, f"claimed to {claim.end(first)}")?
  let Ok(made_second) = authority.claim(a) else {
    return Error(Failed())
  }
  let mut second = take made_second
  say(stdout, f"second claim to {claim.end(second)}")?
  let stale = match authority.submit(a, mut first, b"stale", [], [], floor) {
    Ok(p) => authority.wait(a, mut first, p),
    Error(_) => Fenced(),
  }
  match stale {
    Fenced() => say(stdout, "first writer fenced")?,
    _ => say(stdout, "first writer advanced")?,
  }
  match authority.durable(a, mut first, floor) {
    Error(Fenced()) => say(stdout, "fenced claim stays fenced")?,
    _ => say(stdout, "fenced claim revived")?,
  }
  match authority.submit(a, mut first, b"dead", [], [], floor) {
    Error(Fenced()) => say(stdout, "a dead claim submits nothing")?,
    _ => say(stdout, "a dead claim submitted")?,
  }
  let (Ok(p3), Ok(p4)) = (
    authority.submit(a, mut second, b"three", [], [], floor),
    authority.submit(a, mut second, b"four", [], [], floor)
  ) else {
    return Error(Failed())
  }
  say(stdout, f"submitted at {p3} and {p4}")?
  match (authority.wait(a, mut second, p4), authority.wait(a, mut second, p3)) {
    (Advanced(q4), Advanced(q3)) => say(
      stdout,
      f"answered {q4} then {q3}, claim at {claim.end(second)}"
    )?,
    _ => say(stdout, "second writer refused")?,
  }
  let Ok(all) = authority.read(a, 0, floor, 10) else {
    return Error(Failed())
  }
  let mut count: u64 = 0
  let mut claims = true
  let mut identity: Bytes = b""
  let mut appended: List[Bytes] = []
  for r in all {
    count = count + 1
    match r {
      Claimed(epoch, _, named) => {
        let same = count == 1 || named == identity
        claims = claims && epoch == count && count < 3 && same && bytes.len(named) == 32
        identity = copy named
      },
      Appended(payload, _, _) => {
        list.push(mut appended, copy payload)
      },
    }
  }
  let kept = count == 4 && appended == [b"three", b"four"]
  let order = if claims {
    "claims of epochs 1 and 2 naming one identity"
  } else {
    "claims out of order"
  }
  if kept {
    say(stdout, f"read {count}: {order}, entries 3 and 4 kept")?
  } else {
    say(stdout, f"read {count}: {order}, entries 3 and 4 lost")?
  }
  // The second claim, of epoch 2, submits next at 5.
  let one = digest(b"1")
  let r = ObjectRef(lifetime: 5, epoch: 2, digest: copy one)
  let made = authority.put(a, mut second, r, b"1")
  let twice = authority.put(a, mut second, r, b"1")
  match (made, twice) {
    (Ok(()), Ok(())) => say(stdout, "put twice: ok")?,
    _ => say(stdout, "put twice: refused")?,
  }
  match authority.put(a, mut second, r, b"2") {
    Error(Refused(_)) => say(stdout, "other bytes: refused")?,
    _ => say(stdout, "other bytes: accepted")?,
  }
  let outside = [
    ObjectRef(lifetime: 4, epoch: 2, digest: copy one),
    ObjectRef(lifetime: 70, epoch: 2, digest: copy one),
    ObjectRef(lifetime: 5, epoch: 1, digest: copy one)
  ]
  let mut refused: u64 = 0
  for o in outside {
    if let Error(Refused(_)) = authority.put(a, mut second, o, b"1") {
      refused = refused + 1
    }
  }
  say(stdout, f"outside the claim's positions or epoch: {refused} refused")?
  let short = ObjectRef(lifetime: 5, epoch: 2, digest: b"short")
  match (authority.put(a, mut second, short, b"1"), authority.get(a, short)) {
    (Error(Refused(_)), Error(Refused(_))) => say(
      stdout,
      "a short digest: put and get refused"
    )?,
    _ => say(stdout, "a short digest: accepted")?,
  }
  let missing = ObjectRef(lifetime: 5, epoch: 2, digest: digest(b"y"))
  match (authority.get(a, r), authority.get(a, missing)) {
    (Ok(Some(got)), Ok(None())) => say(
      stdout,
      f"got {bytes.len(got)} byte, missing object: none"
    )?,
    _ => say(stdout, "get: wrong")?,
  }
  let Ok(p5) = authority.submit(a, mut second, b"five", [copy r], [], floor) else {
    return Error(Failed())
  }
  match authority.submit(a, mut second, b"six", [copy r], [], floor) {
    Error(Refused(_)) => say(stdout, "a created object at another position: refused")?,
    _ => say(stdout, "a created object at another position: accepted")?,
  }
  let Advanced(_) = authority.wait(a, mut second, p5) else {
    return Error(Failed())
  }
  let Ok(tail) = authority.read(a, 4, floor, 10) else {
    return Error(Failed())
  }
  let mut inventoried = list.len(tail) == 1
  for t in tail {
    inventoried = inventoried && match t {
      Appended(payload, created, retired) => payload == b"five" && created == [copy r] && list.len(
        retired
      ) == 0,
      Claimed(..) => false,
    }
  }
  if inventoried {
    say(stdout, "entry 5 inventories its object")?
  } else {
    say(stdout, "entry 5 lost its object")?
  }
  // Entry 6 may retire only an object of a position below 6 and an epoch up to 2.
  let unretirable = [
    ObjectRef(lifetime: 6, epoch: 2, digest: copy one),
    ObjectRef(lifetime: 7, epoch: 2, digest: copy one),
    ObjectRef(lifetime: 5, epoch: 3, digest: copy one)
  ]
  let mut unretired: u64 = 0
  for o in unretirable {
    if let Error(Refused(_)) = authority.submit(
      a,
      mut second,
      b"six",
      [],
      [copy o],
      floor
    ) {
      unretired = unretired + 1
    }
  }
  say(
    stdout,
    f"a retirement at or past its own position or of a later epoch: {unretired} refused"
  )?
  let Ok(p6) = authority.submit(a, mut second, b"six", [], [copy r], floor) else {
    return Error(Failed())
  }
  let Advanced(_) = authority.wait(a, mut second, p6) else {
    return Error(Failed())
  }
  let Ok(six) = authority.read(a, 5, floor, 10) else {
    return Error(Failed())
  }
  let mut retires = p6 == 6 && list.len(six) == 1
  for t in six {
    retires = retires && match t {
      Appended(payload, created, retired) => payload == b"six" && list.len(created) == 0 && retired == [
        copy r
      ],
      Claimed(..) => false,
    }
  }
  if retires {
    say(stdout, "entry 6 retires entry 5's object")?
  } else {
    say(stdout, "entry 6 retires nothing")?
  }
  match authority.reclaim(a, mut second, 1) {
    Error(Refused(_)) => say(stdout, "reclaim with budget 1: refused")?,
    _ => say(stdout, "reclaim with budget 1: ran")?,
  }
  // An object put at 7 that entry 7 does not inventory, and one at 8, past the
  // durable end, of the claim's own epoch.
  let two = digest(b"2")
  let unrecorded = ObjectRef(lifetime: 7, epoch: 2, digest: copy two)
  let ahead = ObjectRef(lifetime: 8, epoch: 2, digest: copy two)
  let (Ok(()), Ok(())) = (
    authority.put(a, mut second, unrecorded, b"2"),
    authority.put(a, mut second, ahead, b"2")
  ) else {
    return Error(Failed())
  }
  let Ok(p7) = authority.submit(a, mut second, b"seven", [], [], floor) else {
    return Error(Failed())
  }
  let Advanced(_) = authority.wait(a, mut second, p7) else {
    return Error(Failed())
  }
  let mut done = false
  let mut calls: u64 = 0
  while !done && calls < 100 {
    calls = calls + 1
    match authority.reclaim(a, mut second, 64) {
      Ok(Done()) => {
        done = true
      },
      Ok(More()) => {},
      Error(_) => return Error(Failed()),
    }
  }
  match (
    authority.get(a, r),
    authority.get(a, unrecorded),
    authority.get(a, ahead),
    done
  ) {
    (Ok(None()), Ok(None()), Ok(Some(_)), true) => say(
      stdout,
      "reclaimed: the retired object gone, an unrecorded one at 7 gone, one at 8 kept"
    )?,
    _ => say(stdout, "reclaimed: wrong")?,
  }
  match level.narrow(a, authority.floor(b)) {
    None() => say(stdout, "a level of other is not main's")?,
    Some(_) => say(stdout, "a level of other narrowed to main")?,
  }
  match claim.narrow(b, take second) {
    None() => say(stdout, "a claim of main is not other's")?,
    Some(_) => say(stdout, "a claim of main narrowed to other")?,
  }
  Ok(())
}

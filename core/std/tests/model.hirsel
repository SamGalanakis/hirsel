// expect: run bag_laws() = true
fn bag_laws() -> bool {
    let mut first: model.Bag[u64] = model.bag_new()
    model.bag_add(mut first, 1u64)
    model.bag_add(mut first, 1u64)
    model.bag_add(mut first, 2u64)
    if !model.bag_remove(mut first, 1u64) || model.bag_count(first, 1u64) != 1 || model.bag_size(first) != 2 {
        return false
    }
    let mut second: model.Bag[u64] = model.bag_new()
    model.bag_add(mut second, 2u64)
    model.bag_add(mut second, 1u64)
    if first != second || model.bag_remove(mut first, 3u64) || first != second {
        return false
    }
    {
        let rows = model.bag_entries(first)
        if list.len(rows) != 2 || rows[0] != (1u64, 1u64) || rows[1] != (2u64, 1u64) {
            return false
        }
    }
    let mut keyed: Map[model.Bag[u64], u64] = map.new()
    map.insert(mut keyed, take first, 42u64)
    match map.get(keyed, second) {
        Some(value) => value == 42,
        None => false,
    }
}

type CounterAction = Start | Inc | Reset

fn counter(broken: bool) -> model.Model[u64, CounterAction] {
    let mut init: List[u64] = list.new()
    list.push(mut init, 0u64)
    let mut always: List[model.Always[u64, CounterAction]] = list.new()
    if broken {
        list.push(mut always, model.Always(
            label: string.from("never_wrap"),
            holds: fn(prev: u64, action: CounterAction, next: u64) -> bool {
                !(prev == 2 && next == 0)
            },
        ))
    }
    let mut sometimes: List[model.Sometimes[u64]] = list.new()
    list.push(mut sometimes, model.Sometimes(label: string.from("wrap"), holds: fn(s: u64) -> bool {
        s == 0
    }))
    model.Model(
        init: take init,
        start: Start,
        actions: fn(state: u64, mut out: List[CounterAction]) {
            list.push(mut out, Inc)
        },
        step: fn(state: u64, action: CounterAction) -> u64 {
            match action {
                Reset => 0,
                _ => (state + 1) % 3,
            }
        },
        done: fn(state: u64) -> bool {
            false
        },
        always: take always,
        sometimes: take sometimes,
        sometimes_step: list.new(),
        show: fn(action: CounterAction, mut out: String) {
            string.push(mut out, "Inc")
        },
    )
}

fn model_bounds() -> model.Bounds {
    model.Bounds(depth: 10, states: 10, step_steps: 1000, step_bytes: 4096)
}

fn closed_stats(stats: model.Stats, states: u64, edges: u64, depth: u64, label: String) -> bool {
    stats.states == states && stats.edges == edges && stats.depth == depth && list.len(stats.witnessed) == 1 && stats.witnessed[0].0 == label && stats.witnessed[0].1 == 1
}

fn failure_token(f: model.Failure) -> String {
    let mut text = string.new()
    model.token(f, mut text)
    take text
}

fn failure_report(f: model.Failure) -> String {
    let mut text = string.new()
    model.report(f, mut text)
    take text
}

// C1
// expect: run explore_counter_closed() = true
fn explore_counter_closed() -> bool {
    let Closed(stats) = model.explore(counter(false), model_bounds()) else {
        return false
    }
    closed_stats(stats, 3, 3, 2, "wrap") && model.check(counter(false), model_bounds()) == Ok(())
}

// expect: run explore_unwitnessed_step() = true
fn explore_unwitnessed_step() -> bool {
    let mut m = counter(false)
    list.push(mut m.sometimes_step, model.SometimesStep(
        label: string.from("wrap by increment"),
        holds: fn(prev: u64, action: CounterAction, next: u64) -> bool {
            let Inc = action else {
                return false
            }
            prev == 2 && next == 0
        },
    ))
    list.push(mut m.sometimes_step, model.SometimesStep(
        label: string.from("wrap by reset"),
        holds: fn(prev: u64, action: CounterAction, next: u64) -> bool {
            let Reset = action else {
                return false
            }
            prev == 2 && next == 0
        },
    ))
    let Failed(f) = model.explore(m, model_bounds()) else {
        return false
    }
    model.kind(f) == Unwitnessed(string.from("wrap by reset")) && model.depth(f) == 0 && failure_token(f) == "AQAA"
}

// C2
// expect: run explore_counter_wrap() = true
fn explore_counter_wrap() -> bool {
    let Failed(f) = model.explore(counter(true), model_bounds()) else {
        return false
    }
    model.kind(f) == Violated(string.from("never_wrap")) && model.depth(f) == 3 && failure_token(f) == "AQAEAAAAAA==" && failure_report(f) == "model: violated: reproduce: model.replay(m, b, \"AQAEAAAAAA==\"); always never_wrap at depth 3; path: init 0, Inc, Inc, Inc"
}

// C3
// expect: run explore_counter_depth() = true
fn explore_counter_depth() -> bool {
    let mut b = model_bounds()
    b.depth = 1
    let ToDepth(stats, Depth) = model.explore(counter(false), b) else {
        return false
    }
    stats.states == 2 && stats.edges == 1 && stats.depth == 1
}

// C4
// expect: run explore_counter_states() = true
fn explore_counter_states() -> bool {
    let mut b = model_bounds()
    b.states = 2
    let ToDepth(stats, States) = model.explore(counter(false), b) else {
        return false
    }
    stats.states == 2 && stats.edges == 2 && stats.depth == 1
}

type Network: key {
    sent: u64,
    delivered: u64,
    net: model.Bag[u64]
}

type Message = StartNetwork | Send | Deliver(u64)

fn network_step(state: Network, action: Message) -> Network {
    let mut next: Network = clone(state)
    match action {
        StartNetwork => {},
        Send => {
            model.bag_add(mut next.net, 7u64)
            next.sent += 1
        },
        Deliver(message) => {
            model.bag_remove(mut next.net, message)
            next.delivered += 1
        },
    }
    take next
}

fn network(take done: own fn(Network) -> bool) -> model.Model[Network, Message] {
    let mut init: List[Network] = list.new()
    list.push(mut init, Network(sent: 0, delivered: 0, net: model.bag_new()))
    let mut sometimes: List[model.Sometimes[Network]] = list.new()
    list.push(mut sometimes, model.Sometimes(label: string.from("both"), holds: fn(s: Network) -> bool {
        s.delivered == 2
    }))
    model.Model(
        init: take init,
        start: StartNetwork,
        actions: fn(state: Network, mut out: List[Message]) {
            if state.sent < 2 {
                list.push(mut out, Send)
            }
            for (message, _) in model.bag_entries(state.net) {
                list.push(mut out, Deliver(message))
            }
        },
        step: network_step,
        done: take done,
        always: list.new(),
        sometimes: take sometimes,
        sometimes_step: list.new(),
        show: fn(action: Message, mut out: String) {
            match action {
                StartNetwork => string.push(mut out, "Start"),
                Send => string.push(mut out, "Send"),
                Deliver(message) => {
                    string.push(mut out, "Deliver(")
                    string.push_u64(mut out, message)
                    string.push(mut out, ")")
                },
            }
        },
    )
}

// C5
// expect: run explore_bag_closed() = true
fn explore_bag_closed() -> bool {
    let Closed(stats) = model.explore(network(fn(s: Network) -> bool {
        s.delivered == 2
    }), model_bounds()) else {
        return false
    }
    closed_stats(stats, 6, 6, 4, "both")
}

// C6
// expect: run explore_bag_stuck() = true
fn explore_bag_stuck() -> bool {
    let Failed(f) = model.explore(network(fn(s: Network) -> bool {
        false
    }), model_bounds()) else {
        return false
    }
    model.kind(f) == Stuck && model.depth(f) == 4 && failure_token(f) == "AQAFAAAAAAA="
}

fn ghosts() -> model.Model[(u64, bool), CounterAction] {
    let mut init: List[(u64, bool)] = list.new()
    list.push(mut init, (0u64, false))
    list.push(mut init, (0u64, true))
    let mut sometimes: List[model.Sometimes[(u64, bool)]] = list.new()
    list.push(mut sometimes, model.Sometimes(label: string.from("any"), holds: fn(state: (u64, bool)) -> bool {
        true
    }))
    model.Model(
        init: take init,
        start: Start,
        actions: fn(state: (u64, bool), mut out: List[CounterAction]) {},
        step: fn(state: (u64, bool), action: CounterAction) -> (u64, bool) {
            state
        },
        done: fn(state: (u64, bool)) -> bool {
            true
        },
        always: list.new(),
        sometimes: take sometimes,
        sometimes_step: list.new(),
        show: fn(action: CounterAction, mut out: String) {},
    )
}

// C7
// expect: run explore_ghost_state() = true
fn explore_ghost_state() -> bool {
    let mut b = model_bounds()
    b.depth = 0
    let ToDepth(stats, Depth) = model.explore(ghosts(), b) else {
        return false
    }
    if stats.states != 2 || stats.edges != 0 || stats.depth != 0 {
        return false
    }
    b.depth = 1
    let Failed(f) = model.explore(ghosts(), b) else {
        return false
    }
    model.kind(f) == Unwitnessed(string.from("any")) && model.depth(f) == 0
}

// C8
// expect: run explore_initial_pseudo_edge() = true
fn explore_initial_pseudo_edge() -> bool {
    let mut m = counter(false)
    let _ = list.set(mut m.init, 0, 5u64)
    list.push(mut m.always, model.Always(
        label: string.from("small"),
        holds: fn(prev: u64, action: CounterAction, next: u64) -> bool {
            next < 4
        },
    ))
    let Failed(f) = model.explore(m, model_bounds()) else {
        return false
    }
    model.kind(f) == Violated(string.from("small")) && model.depth(f) == 0 && failure_token(f) == "AQABAA=="
}

// C9
// expect: run explore_handler_timeout() = true
fn explore_handler_timeout() -> bool {
    let mut b = model_bounds()
    b.step_steps = 0
    let Failed(f) = model.explore(counter(false), b) else {
        return false
    }
    model.kind(f) == Handler && model.depth(f) == 0 && failure_report(f) == "model: handler: reproduce: model.replay(m, b, \"AQABAA==\"); OutOfTime in actions at depth 0; path: init 0"
}

// expect: run replay_wrap() = true
fn replay_wrap() -> bool {
    let Reproduced(f) = model.replay(counter(true), model_bounds(), "AQAEAAAAAA==") else {
        return false
    }
    model.kind(f) == Violated(string.from("never_wrap")) && model.depth(f) == 3
}

// expect: run replay_repaired() = true
fn replay_repaired() -> bool {
    if let NoLongerFails = model.replay(counter(false), model_bounds(), "AQAEAAAAAA==") {
        return true
    }
    false
}

// expect: run replay_stuck() = true
fn replay_stuck() -> bool {
    let Reproduced(f) = model.replay(network(fn(s: Network) -> bool {
        false
    }), model_bounds(), "AQAFAAAAAAA=") else {
        return false
    }
    model.kind(f) == Stuck && model.depth(f) == 4
}

// expect: run replay_malformed() = true
fn replay_malformed() -> bool {
    let run = isolate(fn() {
        let _ = model.replay(counter(false), model_bounds(), "!")
    })
    let Error(causes) = result.unwrap(take run) else {
        return false
    }
    for cause in causes {
        if let Fail(message) = cause.kind {
            return message == "model: config: token does not fit this model at step 0"
        }
    }
    false
}

// C2's tape is [0, 0, 0, 0]: initial state 0 and three Inc actions at index 0.
// Base64 of 01 00 04 00 00 00 00 is AQAEAAAAAA== even if show fails at depth 0.
// expect: run replay_show_handler() = true
fn replay_show_handler() -> bool {
    let mut counterexample = counter(true)
    counterexample.show = fn(action: CounterAction, mut out: String) {
        fail("show refused")
    }
    let Failed(f) = model.explore(counterexample, model_bounds()) else {
        return false
    }
    let tape = failure_token(f)
    if model.kind(f) != Handler || model.depth(f) != 0 || tape != "AQAEAAAAAA==" {
        return false
    }
    let Reproduced(replayed) = model.replay(counterexample, model_bounds(), tape) else {
        return false
    }
    model.kind(replayed) == Handler && model.depth(replayed) == 0 && failure_token(replayed) == "AQAEAAAAAA==" && failure_report(replayed) == "model: handler: reproduce: model.replay(m, b, \"AQAEAAAAAA==\"); Fail: show refused in show at depth 0; path: init 0"
}

type Pipe: key {
    sent: u64,
    outbox: u64,
    wire: u64,
    got: u64
}

type PipeAction: key = StartPipe | SendPipe | Ship | Recv

fn pipe_step(state: Pipe, action: PipeAction) -> Pipe {
    let mut next = state
    match action {
        StartPipe => {},
        SendPipe => {
            next.sent += 1
            next.outbox += 1
        },
        Ship => {
            next.outbox -= 1
            next.wire += 1
        },
        Recv => {
            next.wire -= 1
            next.got += 1
        },
    }
    next
}

fn pipe() -> model.Model[Pipe, PipeAction] {
    let mut init: List[Pipe] = list.new()
    list.push(mut init, Pipe(sent: 0, outbox: 0, wire: 0, got: 0))
    let mut sometimes: List[model.Sometimes[Pipe]] = list.new()
    list.push(mut sometimes, model.Sometimes(label: string.from("both"), holds: fn(s: Pipe) -> bool {
        s.got == 2
    }))
    model.Model(
        init: take init,
        start: StartPipe,
        actions: fn(s: Pipe, mut out: List[PipeAction]) {
            if s.sent < 2 {
                list.push(mut out, SendPipe)
            }
            if s.outbox > 0 {
                list.push(mut out, Ship)
            }
            if s.wire > 0 {
                list.push(mut out, Recv)
            }
        },
        step: pipe_step,
        done: fn(s: Pipe) -> bool {
            s.got == 2
        },
        always: list.new(),
        sometimes: take sometimes,
        sometimes_step: list.new(),
        show: fn(action: PipeAction, mut out: String) {
            string.push(mut out, pipe_label(action))
        },
    )
}

fn pipe_label(action: PipeAction) -> String {
    match action {
        StartPipe => string.from("start"),
        SendPipe => string.from("send"),
        Ship => string.from("ship"),
        Recv => string.from("recv"),
    }
}

fn pipe_boundary() -> model.Boundary[Pipe, PipeAction, PipeAction, u64] {
    model.Boundary(
        label: fn(action: PipeAction) -> PipeAction {
            action
        },
        observe: fn(prev: Pipe, action: PipeAction, next: Pipe) -> Option[u64] {
            match action {
                SendPipe => Some(next.sent),
                Recv => Some(next.got),
                _ => None,
            }
        },
        show: fn(hint: PipeAction, seen: u64, mut out: String) {
            string.push(mut out, pipe_label(hint))
            string.push(mut out, " ")
            string.push_u64(mut out, seen)
        },
    )
}

fn observe_pipe(mut trace: List[model.Seen[PipeAction, u64]], hint: PipeAction, seen: u64) {
    list.push(mut trace, model.Seen(hint: hint, seen: seen))
}

fn pipe_trace() -> List[model.Seen[PipeAction, u64]] {
    let mut trace: List[model.Seen[PipeAction, u64]] = list.new()
    observe_pipe(mut trace, SendPipe, 1)
    observe_pipe(mut trace, SendPipe, 2)
    observe_pipe(mut trace, Recv, 1)
    observe_pipe(mut trace, Recv, 2)
    take trace
}

// T1
// expect: run conforms_pipe() = true
fn conforms_pipe() -> bool {
    if let Conforms(4, 3) = model.conforms(pipe(), model_bounds(), pipe_boundary(), pipe_trace()) {
        return true
    }
    false
}

fn impossible_pipe_trace() -> List[model.Seen[PipeAction, u64]] {
    let mut trace: List[model.Seen[PipeAction, u64]] = list.new()
    observe_pipe(mut trace, SendPipe, 1)
    observe_pipe(mut trace, Recv, 1)
    observe_pipe(mut trace, Recv, 3)
    take trace
}

// T2
// expect: run conforms_impossible_prefix() = true
fn conforms_impossible_prefix() -> bool {
    let Diverged(2, 1, NoTransition) = model.conforms(pipe(), model_bounds(), pipe_boundary(), impossible_pipe_trace()) else {
        return false
    }
    let run = isolate(fn() {
        let _ = model.conforms_check(pipe(), model_bounds(), pipe_boundary(), impossible_pipe_trace())
    })
    let Error(causes) = result.unwrap(take run) else {
        return false
    }
    for cause in causes {
        if let Fail(message) = cause.kind {
            return message == "model: conforms: diverged at entry 2 of 3 (recv 3): no transition; 1 compatible state before it"
        }
    }
    false
}

// T3
// expect: run conforms_checks_label() = true
fn conforms_checks_label() -> bool {
    let mut trace: List[model.Seen[PipeAction, u64]] = list.new()
    observe_pipe(mut trace, SendPipe, 1)
    observe_pipe(mut trace, SendPipe, 1)
    if let Diverged(1, 2, HintMismatch(Recv)) = model.conforms(pipe(), model_bounds(), pipe_boundary(), trace) {
        return true
    }
    false
}

// T4
// expect: run conforms_states_cap() = true
fn conforms_states_cap() -> bool {
    let mut b = model_bounds()
    b.states = 2
    if let Incomplete(1, States) = model.conforms(pipe(), b, pipe_boundary(), pipe_trace()) {
        return true
    }
    false
}

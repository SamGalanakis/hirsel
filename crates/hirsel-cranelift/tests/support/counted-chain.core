; n + 1 counted nodes, each charge 24. The terminal variant owns no edge;
; each next variant transfers the preceding root, so one last release cleans all.
core v1
type t0 = own "Node" | End { } | Next { next: rc t0 }
type t1 = own "Holder" { root: rc t0 }
sig g0 = (u64) -> (u64)
inst n0 = test@0/counted_chain/run [] []
fn f0 = n0 g0 {
  slot s0 = t1
  addr a0 = s0 field 0 : ptr
  addr a1 = s0 field 0 deref : t0
  addr a2 = s0 field 0 deref case 1 0 : ptr
  addr a3 = s0 : t1
b0(v0: u64):
  live s0
  address a0
  address a3
  v1: u64 = const 24
  v2: ptr, v3: u64 = alloc for rc t0 v1 align 8 charge v1
  v4: ptr = const 0x0
  v5: bool = ne v2, v4
  v6: u64 = const 0
  branch v5, b1, b5
b1:
  store a0, v2
  address a1
  set_case a1, 0
  jump b2(v6)
b2(v7: u64):
  v8: bool = lt v7, v0
  branch v8, b3, b4
b3:
  v9: ptr = read a0
  v10: ptr, v11: u64 = alloc for rc t0 v1 align 8 charge v1
  v12: bool = ne v10, v4
  branch v12, b6, b4
b4:
  drop a3 t1
  dead s0
  return v7
b5:
  return v6
b6:
  store a0, v10
  address a1
  address a2
  set_case a1, 1
  store a2, v9
  v13: u64 = const 1
  v14: u64 = wrapping_add v7, v13
  jump b2(v14)

}

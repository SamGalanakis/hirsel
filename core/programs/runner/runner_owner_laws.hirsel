// §3 "Repair", the owner's take: an owner that takes Update 1 also takes the Updates queued
// behind it, in order, up to its inbox's capacity (1+q = 5) in one delivery job. The first
// other event ends the run and is held, not lost, and every take counts once toward the
// drain wake. Hand-derived: with the run at 3 of 5, taking Updates 2 and 3 and then `Dropped`
// is three takes, so the run wraps once (one wake) and ends at 1; Update 4 stays queued. A
// full backlog takes four more Updates and leaves the fifth queued.
pub fn law_owner_takes_queued() -> bool {
    let (to, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(5u64)
    let _ = channel.try_send(to, queued_update(2u64))
    let _ = channel.try_send(to, queued_update(3u64))
    let _ = channel.try_send(to, wire_event(Dropped))
    let _ = channel.try_send(to, queued_update(4u64))
    let mut updates: List[Update] = list.new()
    list.push(mut updates, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut held: Option[WireEvent] = None
    let mut run = 3u64
    let wakes = wire_take_queued(inbox, mut run, 5u64, mut updates, mut held)
    let held_sent = match take held {
        Some(WireEvent(e: Dropped)) => true,
        _ => false
    }
    let left = match channel.try_receive(inbox) {
        Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 4u64,
        _ => false
    }
    let mixed = wakes == 1u64 && run == 1u64 && held_sent && left && queued_versions(updates, 3u64)
    for v in 2u64 .. 7u64 {
        let _ = channel.try_send(to, queued_update(v))
    }
    let mut full: List[Update] = list.new()
    list.push(mut full, Update(version: 1u64, content: None, outcomes: list.new()))
    let mut kept: Option[WireEvent] = None
    let mut at = 0u64
    let _ = wire_take_queued(inbox, mut at, 5u64, mut full, mut kept)
    let rest = match channel.try_receive(inbox) {
        Ok(WireEvent(e: FromRunner(Notice(e: Updated(take u))))) => u.version == 6u64,
        _ => false
    }
    let capped = at == 4u64 && rest && (match kept {
        None => true,
        _ => false
    }) && queued_versions(full, 5u64)
    mixed && capped
}

pub fn law_owner_take_wakes() -> bool {
    let mut run = 0u64
    let mut wakes = 0u64
    for _ in 0u64 .. 129u64 {
        if wire_taken(mut run, 64u64) {
            wakes += 1u64
        }
    }
    wakes == 2u64 && run == 1u64
}

// No wire configuration, for unit drivers that bind nothing.
fn no_wire() -> Option[BindGrant[()]] {
    None
}

fn wire_service_seed[G: send](random: Random, take session_wire: Option[BindGrant[G]], head: Sender[HeadInput], clock: Clock, tasks: Tasks, config: WireConfig, take target: String) -> Service[WireSession[G]] {
    wire_service_with_head(random, take session_wire, None, LifecycleHead(channel.sender(head)), clock, tasks, config, take target)
}

pub fn fixture_unsubscribe(owner: FixtureOwner, sub: u32) -> () waits {
    let _ = channel.send(owner.post, PubIn(e: Unsubscribed(owner.who, sub)))
}

pub fn fixture_try_receive(owner: FixtureOwner) -> Result[Down, ReceiveError] waits {
    if let Ok(take d) = channel.try_receive(owner.from) {
        return Ok(take d)
    }
    match channel.try_receive(owner.inbox) {
        Ok(take e) => {
            fixture_content(owner, take e);
            channel.try_receive(owner.from)
        },
        Error(e) => Error(e),
    }
}

@test
fn leaving_sub_does_not_block_successor(clock: Clock, random: Random, tasks: Tasks) -> Result[(), u64] waits {
    let (head_to, _head_from): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let (pub_to, pub_from): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    result.unwrap(channel.try_send(pub_to, PubIn(e: Drained)))
    let mut config = wire_defaults(1048576u64)
    config.max_subs = 1u64
    let service: Service[WireSession[()]] = wire_service_seed(random, no_wire(), head_to, clock, tasks, config, string.new())
    let Service(context: take initial, ..) = take service
    let mut ctx = take initial
    wire_law_open(mut ctx, law_caller(1u64))
    ctx.publisher = Some(take pub_to)
    ctx.joined = Some(23u64)
    ctx.next_sub = 8u64
    ctx.sub_generation = 1u64
    list.push(mut ctx.subs, (7u32, 1u64))
    list.push(mut ctx.pub_subs, 7u32)
    let mut work = wire_work()
    work.check = Some(10u64)
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Unsubscribe(7u32), 0u64)))
    if !list.contains(ctx.pub_subs, 7u32) {
        return Error(1u64)
    }
    let reg = result.unwrap(placed(code.describe(http_law_place), HTTP_LAW_PLACE_BYTES))
    if let Open(entries: mut entries, ..) = ctx.handshake {
        list.push(mut entries, (http_law_key(reg.t.exported[1u64]), Registered))
    }
    let next = result.unwrap(wire_plan_subscribe(mut ctx, reg, 8u32, 0u32, b"\x00\x00\x00\x00", None))
    if let PlannedSubscribe(..) = next {} else {
        return Error(2u64)
    }
    result.unwrap(wire_apply_plan(mut ctx, mut work, take next))
    let excess = result.unwrap(wire_plan_subscribe(mut ctx, reg, 9u32, 0u32, b"\x00\x00\x00\x00", None))
    if let SubscriptionRefusal(9u32, Refused(NotAllowed)) = excess {} else {
        return Error(3u64)
    }
    // The first successor owns the outgoing sub's slot. It occupies no PubIn
    // cell until the writer finishes and the old read set can be removed.
    if list.len(ctx.deferred_subs) != 1u64 || ctx.deferred_subs[0u64].sub != 8u32 {
        return Error(4u64)
    }
    if !list.contains(ctx.pub_subs, 7u32) || list.contains(ctx.pub_subs, 8u32) {
        return Error(5u64)
    }
    let receiver = task.spawn(tasks, bytes 4096u64, take pub_from, owner_receive_successor)
    let _ = result.unwrap(wire_step(mut ctx, mut work, WSent))
    wire_flush_subscriptions(mut ctx, mut work)
    let (take remaining, exact) = result.unwrap(task.join(take receiver))
    if !exact || list.len(ctx.deferred_subs) != 0u64 || !list.contains(ctx.pub_subs, 8u32) {
        return Error(6u64)
    }
    if let Error(1002u16) = wire_plan_subscribe(mut ctx, reg, 8u32, 0u32, b"", None) {} else {
        return Error(8u64)
    }
    if let Error(1002u16) = wire_step(mut ctx, mut work, WClient(Set(8u32, None), 0u64)) {} else {
        return Error(9u64)
    }
    if let Error(1002u16) = wire_step(mut ctx, mut work, WClient(Send(10u32, None, b""), 0u64)) {} else {
        return Error(10u64)
    }
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Set(7u32, None), 0u64)))
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Send(6u32, None, b""), 0u64)))
    // With an idle writer there will be no Sent to push a lost unsubscribe.
    result.unwrap(channel.try_send(wire_publisher(ctx), PubIn(e: Drained)))
    let _ = result.unwrap(wire_step(mut ctx, mut work, WClient(Unsubscribe(8u32), 0u64)))
    let idle = task.spawn(tasks, bytes 4096u64, take remaining, owner_receive_idle_unsubscribe)
    wire_flush_subscriptions(mut ctx, mut work)
    if !result.unwrap(task.join(take idle)) || list.len(ctx.pub_subs) != 0u64 {
        return Error(7u64)
    }
    Ok(())
}

fn owner_receive_successor(take from: Receiver[PubIn]) -> (Receiver[PubIn], bool) waits {
    let first = match channel.receive(from) {
        Ok(PubIn(e: Drained)) => true,
        _ => false
    }
    let retired = match channel.receive(from) {
        Ok(PubIn(e: Unsubscribed(23u64, 7u32))) => true,
        _ => false
    }
    let successor = match channel.receive(from) {
        Ok(PubIn(e: WireSubscribed(23u64, 8u32, 2u64, _))) => true,
        _ => false
    }
    (take from, first && retired && successor)
}

fn owner_receive_idle_unsubscribe(take from: Receiver[PubIn]) -> bool waits {
    let first = match channel.receive(from) {
        Ok(PubIn(e: Drained)) => true,
        _ => false
    }
    let retired = match channel.receive(from) {
        Ok(PubIn(e: Unsubscribed(23u64, 8u32))) => true,
        _ => false
    }
    first && retired
}

fn room_law_admit(tx: store.Tx, unused: (), author: Caller, take argument: ()) -> Result[Answer[Grant], Capacity] {
    Ok(Answer(value: Join, covers: covers()))
}

fn room_law_entries(mut reg: Registry[(), ()]) -> Result[(), RegisterError] {
    room(mut reg, code.describe(room_law_admit), slots(), std.codec.of_u32(), std.codec.of_u32(), RoomBounds(peers: 2u32, state: 4u32, message: 4u32), 4096u64, 1024u64, DEFAULT_STEPS)?
    compute(mut reg, code.describe(room_law_barrier), 4096u64, DEFAULT_STEPS)
}

fn room_law_barrier(take v: u32) -> Result[u32, Capacity] {
    Ok(v)
}

fn room_law_large_entries(mut reg: Registry[(), ()]) -> Result[(), RegisterError] {
    let state: std.codec.Codec[List[Bytes]] = std.codec.of()
    room(mut reg, code.describe(room_law_admit), slots(), state, std.codec.of_bytes(), RoomBounds(peers: 9u32, state: STATE_MAX, message: MESSAGE_MAX), 4096u64, 1024u64, DEFAULT_STEPS)
}

fn room_law_settings(c: Clock, random: Random, tasks: Tasks, net: Net, large_room: bool) -> PlaceConfig[(), (), ()] {
    let entries = if large_room {
        code.describe(room_law_large_entries)
    } else {
        code.describe(room_law_entries)
    }
    let mut config = wire_defaults(262144u64)
    config.n_pool = 33554432u64
    config.n_relay = 4194304u64
    PlaceConfig(backing: Memory, sizes: store.derived_sizes(), selection: Current(0u64), place: entries, n_place: 1048576u64, on_migrate: None, schema: code.describe(empty_schema), session: config, max_sessions: 4u64, proxies: list.new(), n_publisher: 4194304u64, listen: Tcp(Addr(ip: V4(0x7f000001u32), port: 0u16)), net, tasks, clock: c, random, stop: Stop(lag_ms: 1u64, grace_ms: 1000u64), wire: None, grants: None, triggers: None, idle: None)
}

fn room_law_socket(tasks: Tasks, net: Net, c: Clock, random: Random, running: fixture.Fixture, large_room: bool) -> wire_client.Conn waits {
    let entries = if large_room {
        code.describe(room_law_large_entries)
    } else {
        code.describe(room_law_entries)
    }
    let keys = result.unwrap(fixture.entry_keys(entries))
    let address = option.unwrap(fixture.status(running).addr)
    let session = wire_defaults(262144u64)
    let peer = result.unwrap(wire_client.connect_for(tasks, net, address, c, random, keys, None, session.socket, 5000u64, 3000u64))
    wire_client.send_frame(peer, Subscribe(0u32, 0u32, list.new(), None))
    take peer
}

fn room_law_you(connection: wire_client.Conn) -> Option[u32] waits {
    for _ in 0u64 .. 6u64 {
        match wire_client.next(connection) {
            Ok(Live(parts)) => {
                for part in parts {
                    if part.sub == 0u32 && part.complete {
                        if let Some(peer) = part.you {
                            return Some(peer)
                        }
                    }
                }
            },
            Ok(Batch(..)) => (),
            _ => return None,
        }
    }
    None
}

fn room_law_full(connection: wire_client.Conn) -> bool waits {
    for _ in 0u64 .. 6u64 {
        match wire_client.next(connection) {
            Ok(Live(parts)) => {
                for part in parts {
                    if part.sub == 0u32 && part.full {
                        return !part.complete && none(part.you) && list.len(part.joined) == 0u64
                    }
                }
            },
            Ok(Batch(..)) => (),
            _ => return false,
        }
    }
    false
}

// The final broadcast from the same sender is the FIFO boundary for the preceding sends.
fn room_law_count(connection: wire_client.Conn, sender: u32, payload: Bytes, marker: Bytes, direct: bool) -> Option[u64] waits {
    let mut count = 0u64
    for _ in 0u64 .. 12u64 {
        match wire_client.next(connection) {
            Ok(Live(parts)) => {
                for part in parts {
                    for (from, target, message) in part.msgs {
                        if from != sender {
                            return None
                        }
                        if !target && message == marker {
                            return Some(count)
                        }
                        if target != direct || message != payload {
                            return None
                        }
                        count += 1u64
                    }
                }
            },
            Ok(Batch(..)) => (),
            _ => return None,
        }
    }
    None
}

fn room_law_reached_barrier(connection: wire_client.Conn, c: Clock) -> bool waits {
    let stream = store.StreamId(t: host.wall_ms(c), n: 1u64)
    wire_client.send_frame(connection, Call(stream, 0u64, 1u32, 2000u32, b"\x05\x00\x00\x00"))
    for _ in 0u64 .. 8u64 {
        match wire_client.next(connection) {
            Ok(Batch(_, _, _, done)) => {
                for answer in done {
                    if answer.stream == stream && answer.p == 0u64 {
                        return match answer.outcome {
                            Returned(value) => value == b"\x05\x00\x00\x00",
                            _ => false,
                        }
                    }
                }
            },
            Ok(Live(_)) => (),
            _ => return false,
        }
    }
    false
}

@test
fn first_admission_installs_adm(c: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let mut roomless = room_law_settings(c, random, tasks, net, false)
    roomless.place = code.describe(empty_place)
    let with_relay = operate_bytes(roomless) ?=> |_| 10u64
    roomless.session.n_relay = 0u64
    let without_relay = operate_bytes(roomless) ?=> |_| 10u64
    if with_relay != without_relay {
        return Error(10u64)
    }
    room_law_watch() ?=> |why| {
        20u64 + why
    }
    let running = fixture.start(room_law_settings(c, random, tasks, net, false), 5000u64) ?=> |_| 1u64
    let sender = room_law_socket(tasks, net, c, random, running, false)
    let Some(author) = room_law_you(sender) else {
        return Error(2u64)
    }
    let receiver = room_law_socket(tasks, net, c, random, running, false)
    let Some(other) = room_law_you(receiver) else {
        return Error(3u64)
    }
    if author != 1u32 || other != 2u32 {
        return Error(4u64)
    }
    let payload = b"\x11\x00\x00\x00"
    let marker = b"\x12\x00\x00\x00"
    wire_client.send_frame(sender, Send(0u32, None, clone(payload)))
    wire_client.send_frame(sender, Send(0u32, None, clone(marker)))
    if room_law_count(receiver, author, payload, marker, false) != Some(1u64) {
        return Error(5u64)
    }
    let waiter = room_law_socket(tasks, net, c, random, running, false)
    if !room_law_full(waiter) {
        return Error(6u64)
    }
    wire_client.send_frame(sender, Unsubscribe(0u32))
    let Some(promoted) = room_law_you(waiter) else {
        return Error(7u64)
    }
    if promoted != 3u32 {
        return Error(8u64)
    }
    wire_client.send_frame(waiter, Send(0u32, None, clone(payload)))
    wire_client.send_frame(waiter, Send(0u32, None, clone(marker)))
    let observed = room_law_count(receiver, promoted, payload, marker, false)
    let _ = wire_client.close(take sender)
    let _ = wire_client.close(take receiver)
    let _ = wire_client.close(take waiter)
    let _ = fixture.end(take running, 5000u64)
    if observed != Some(1u64) {
        return Error(9u64)
    }
    Ok(())
}

@test
fn waiter_set_not_installed_after_promotion(c: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let running = fixture.start(room_law_settings(c, random, tasks, net, false), 5000u64) ?=> |_| 1u64
    let leaving = room_law_socket(tasks, net, c, random, running, false)
    let observer = room_law_socket(tasks, net, c, random, running, false)
    if none(room_law_you(leaving)) || none(room_law_you(observer)) {
        return Error(2u64)
    }
    let waiter = room_law_socket(tasks, net, c, random, running, false)
    if !room_law_full(waiter) {
        return Error(3u64)
    }
    let before = b"\x01\x00\x00\x00"
    let after = b"\x02\x00\x00\x00"
    wire_client.send_frame(waiter, Set(0u32, Some(clone(before))))
    if !room_law_reached_barrier(waiter, c) {
        return Error(4u64)
    }
    wire_client.send_frame(leaving, Unsubscribe(0u32))
    let Some(peer) = room_law_you(waiter) else {
        return Error(5u64)
    }
    wire_client.send_frame(waiter, Set(0u32, Some(clone(after))))
    let mut empty = false
    let mut recorded = false
    for _ in 0u64 .. 12u64 {
        match wire_client.next(observer) {
            Ok(Live(parts)) => {
                for part in parts {
                    for (id, state) in part.states {
                        if id != peer {
                            continue
                        }
                        if let Some(value) = state {
                            if !empty || value != after {
                                return Error(6u64)
                            }
                            recorded = true
                        } else {
                            empty = true
                        }
                    }
                }
                if recorded {
                    break
                }
            },
            Ok(Batch(..)) => (),
            _ => return Error(7u64),
        }
    }
    let _ = wire_client.close(take leaving)
    let _ = wire_client.close(take observer)
    let _ = wire_client.close(take waiter)
    let _ = fixture.end(take running, 5000u64)
    if !recorded {
        return Error(8u64)
    }
    Ok(())
}

fn room_law_bytes(len: u64, byte: u8) -> Bytes {
    let mut data: Bytes = list.with_capacity(len + 4u64)
    std.codec.put_u32(int.narrow(len), mut data)
    for _ in 0u64 .. len {
        list.push(mut data, byte)
    }
    take data
}

@test
fn direct_destination_survives_full_block(c: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let running = fixture.start(room_law_settings(c, random, tasks, net, true), 5000u64) ?=> |_| 1u64
    let sender = room_law_socket(tasks, net, c, random, running, true)
    let first = room_law_socket(tasks, net, c, random, running, true)
    let second = room_law_socket(tasks, net, c, random, running, true)
    let other = room_law_socket(tasks, net, c, random, running, true)
    let Some(author) = room_law_you(sender) else {
        return Error(2u64)
    }
    let Some(p2) = room_law_you(first) else {
        return Error(3u64)
    }
    let Some(p3) = room_law_you(second) else {
        return Error(4u64)
    }
    if none(room_law_you(other)) {
        return Error(5u64)
    }
    let msg = room_law_bytes(32764u64, 0x55u8)
    let marker = room_law_bytes(1u64, 0x66u8)
    wire_client.send_frame(sender, Send(0u32, Some(p2), clone(msg)))
    wire_client.send_frame(sender, Send(0u32, Some(p3), clone(msg)))
    // Peer 0 is the relay's broadcast sentinel and peer 9 is not in the room:
    // both destination sets are empty, so neither send may reach anyone.
    wire_client.send_frame(sender, Send(0u32, Some(0u32), clone(msg)))
    wire_client.send_frame(sender, Send(0u32, Some(9u32), clone(msg)))
    wire_client.send_frame(sender, Send(0u32, None, clone(marker)))
    let recipients = (room_law_count(first, author, msg, marker, true), room_law_count(second, author, msg, marker, true), room_law_count(other, author, msg, marker, true))
    let _ = wire_client.close(take sender)
    let _ = wire_client.close(take first)
    let _ = wire_client.close(take second)
    let _ = wire_client.close(take other)
    let _ = fixture.end(take running, 5000u64)
    if recipients != (Some(1u64), Some(1u64), Some(0u64)) {
        return Error(6u64)
    }
    Ok(())
}

fn room_law_seed_desk(mut relay: RoomRelay, rounds: Latest[RoundAt], id: RoomSession, relay_to: Sender[RoomRelayIn], relay_in: Receiver[RoomRelayIn], to_owner: Sender[WireEvent], settings: (u32, u64, Grant)) -> RoomOwner {
    let (peers, live_limit, grant) = settings
    let link = RoomLink(relay: channel.sender(relay_to), round_read: latest.handle(rounds), max_message: 32768u64, live_limit, hooks: room_hooks)
    let mut owner = result.unwrap(room_owner(take link, id, to_owner))
    let check = fn(raw: Bytes) -> RoomCodecCheck {
        ValidRoomValue
    }
    let req = RoomRequest(key: RoomKey(entry: 0u32, arg: list.new()), codec: RoomCodecs(state: check, message: check), bounds: RoomBounds(peers, state: STATE_MAX, message: MESSAGE_MAX))
    let caller = store.Caller(issuer: 2u8, subject: b"member")
    result.unwrap(room_owner_join(mut owner, 0u32, 1u64, take req, take caller))
    let mut grants = empty_room_grants()
    grants.latest[0u64] = Some(RoomGrant(sub: 0u32, instance: 1u64, grant, member_epoch: 0u32, publish_epoch: 0u32))
    latest.publish(owner.grants, arc.new(take grants))
    while let Ok(take event) = channel.try_receive(relay_in) {
        room_relay_event(mut relay, rounds, take event)
    }
    take owner
}

fn room_law_part(mut relay: RoomRelay, rounds: Latest[RoundAt], mut watcher: RoomOwner, expected_head: Option[Bytes]) -> Option[Part] {
    let id = watcher.id
    room_desk_flush(mut relay, rounds, id)
    room_owner_drain(mut watcher)
    let take filled = room_owner_live(mut watcher)?
    if let Some(head) = expected_head {
        // Live tag and count (8), sub (4), complete (1), Some tag and peer (8).
        if list.len(filled.data) < 46u64 || list.slice(filled.data, 21u64, 46u64) != head {
            return None
        }
    }
    let formats: std.codec.Codec[Frame] = std.codec.of()
    let decoded = std.codec.decode(formats, filled.data)
    room_relay_event(mut relay, rounds, Back(id, take filled))
    let Ok(Live(take parts)) = take decoded else {
        return None
    }
    let mut only = take parts
    if list.len(only) != 1u64 {
        return None
    }
    list.pop(mut only)
}

@test
fn room_admits_300_funded_peers(random: Random, tasks: Tasks) -> Result[(), u64] waits {
    let peers = 300u32
    let sessions: u64 = int.widen(peers)
    let bounds = RoomBounds(peers, state: STATE_MAX, message: MESSAGE_MAX)
    let mut reg: Registry[(), ()] = registry()
    room(mut reg, code.describe(room_law_admit), slots(), std.codec.of_bytes(), std.codec.of_bytes(), bounds, 4096u64, ROOM_ARGS_MAX, DEFAULT_STEPS) ?=> |_| 1u64
    let mut config = wire_defaults(262144u64)
    config.n_relay = 1u64
    let short = plan_rooms(reg, config)
    let (pub_to, pub_from): (Sender[PubIn], Receiver[PubIn]) = channel.new(1u64)
    let _ = take pub_from
    if let Error(Exceeds(Bound(name, ..))) = start_room_relay(short, config, sessions, pub_to, tasks, random) {
        if name != "n_relay" {
            return Error(2u64)
        }
    } else {
        return Error(2u64)
    }
    // Step the relay with the roster bytes funded by the Place's room plan.
    let mut relay = room_relay_state(random, short.roster, sessions)
    let rounds = latest.new(arc.new(std.http.ReleaseRound(at: 0u64)))
    let (relay_to, relay_in): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(ROOM_RELAY_TOKENS)
    let (to_owner, _inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(sessions)
    let mut members: List[RoomOwner] = list.with_capacity(sessions)
    for i in 1u64 .. sessions + 1u64 {
        let id = RoomSession(low: i, high: 0u64)
        let mut owner = room_law_seed_desk(mut relay, rounds, id, relay_to, relay_in, to_owner, (peers, short.live_limit, Join))
        if i == sessions {
            let Some(part) = room_law_part(mut relay, rounds, mut owner, None) else {
                return Error(3u64)
            }
            if !part.complete || part.you != Some(peers) {
                return Error(4u64)
            }
        }
        list.push(mut members, take owner)
    }
    Ok(())
}

fn room_law_disconnect(mut relay: RoomRelay, rounds: Latest[RoundAt], inbox: Receiver[RoomRelayIn], mut owner: RoomOwner) {
    room_owner_time_to_leave(mut owner)
    while let Ok(take event) = channel.try_receive(inbox) {
        room_relay_event(mut relay, rounds, take event)
    }
    room_owner_drain(mut owner)
}

fn room_law_reconnect_identity() -> Result[(), u64] {
    let tape = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0fABCDEFGHIJKLMNOP"
    let mut relay = room_relay_state(provide.random_tape(take tape), 1048576u64, 2u64)
    let rounds = latest.new(arc.new(std.http.ReleaseRound(at: 0u64)))
    let (to, inbox): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(64u64)
    let (owner, _events): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let watcher_id = RoomSession(low: 1u64, high: 0u64)
    let member_id = RoomSession(low: 2u64, high: 0u64)
    let mut watcher = room_law_seed_desk(mut relay, rounds, watcher_id, to, inbox, owner, (2u32, 65536u64, Join))
    let mut member = room_law_seed_desk(mut relay, rounds, member_id, to, inbox, owner, (2u32, 65536u64, Join))
    // Hand-written wire head: tape's first 16 bytes, 1 + 2 admissions in little endian, true.
    let head = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x03\x00\x00\x00\x00\x00\x00\x00\x01"
    let Some(before) = room_law_part(mut relay, rounds, mut watcher, Some(take head)) else {
        return Error(1u64)
    }
    if before.you != Some(1u32) || list.len(before.joined) != 2u64 || before.revision != 3u64 || !before.snapshot {
        return Error(2u64)
    }
    room_law_disconnect(mut relay, rounds, inbox, mut watcher)
    // Stop between removal and waiter selection to observe the retained, empty roster.
    room_drop_desk(mut relay, member_id)
    room_owner_drain(mut member)
    if relay.rooms[0u64].count != 0u64 || relay.rooms[0u64].next_peer != 3u64 || relay.rooms[0u64].revision != 5u64 {
        return Error(3u64)
    }
    let replacement_id = RoomSession(low: 3u64, high: 0u64)
    let reconnected_id = RoomSession(low: 4u64, high: 0u64)
    let _replacement = room_law_seed_desk(mut relay, rounds, replacement_id, to, inbox, owner, (2u32, 65536u64, Join))
    let mut reconnected = room_law_seed_desk(mut relay, rounds, reconnected_id, to, inbox, owner, (2u32, 65536u64, Join))
    let Some(after) = room_law_part(mut relay, rounds, mut reconnected, None) else {
        return Error(4u64)
    }
    if after.incarnation != (0x4847464544434241u64, 0x504f4e4d4c4b4a49u64) || after.incarnation == before.incarnation || after.you != Some(2u32) || after.revision != 3u64 || !after.snapshot || list.len(after.joined) != 2u64 {
        return Error(5u64)
    }
    let (first, _) = after.joined[0u64]
    if first != 1u32 {
        return Error(6u64)
    }
    Ok(())
}

fn room_law_churn_identity() -> Result[(), u64] {
    let mut relay = room_relay_state(provide.random_tape(b"ABCDEFGHIJKLMNOP"), 1048576u64, 7u64)
    let rounds = latest.new(arc.new(std.http.ReleaseRound(at: 0u64)))
    let (to, inbox): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(64u64)
    let (owner, _events): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let watcher_id = RoomSession(low: 1u64, high: 0u64)
    let member_id = RoomSession(low: 2u64, high: 0u64)
    let mut watcher = room_law_seed_desk(mut relay, rounds, watcher_id, to, inbox, owner, (256u32, 192u64, Watch))
    let Some(initial) = room_law_part(mut relay, rounds, mut watcher, None) else {
        return Error(10u64)
    }
    let incarnation = (0x4847464544434241u64, 0x504f4e4d4c4b4a49u64)
    if initial.incarnation != incarnation || initial.revision != 1u64 || !none(initial.you) || !initial.snapshot {
        return Error(11u64)
    }
    for i in 0u64 .. 300u64 {
        let mut member = room_law_seed_desk(mut relay, rounds, member_id, to, inbox, owner, (256u32, 65536u64, Join))
        let Some(joined) = room_law_part(mut relay, rounds, mut watcher, None) else {
            return Error(12u64)
        }
        let expected: u32 = int.narrow(1u64 + i)
        if joined.incarnation != incarnation || joined.revision != 2u64 + 2u64 * i || !joined.snapshot || list.len(joined.joined) != 1u64 || list.len(joined.left) != 0u64 {
            return Error(13u64)
        }
        let (peer, _) = joined.joined[0u64]
        if peer != expected {
            return Error(14u64)
        }
        latest.publish(member.grants, arc.new(empty_room_grants()))
        let Some(left) = room_law_part(mut relay, rounds, mut watcher, None) else {
            return Error(15u64)
        }
        if left.incarnation != incarnation || left.revision != 3u64 + 2u64 * i || !left.snapshot || list.len(left.left) != 1u64 || left.left[0u64] != expected || list.len(left.joined) != 0u64 {
            return Error(16u64)
        }
        room_law_disconnect(mut relay, rounds, inbox, mut member)
    }
    let mut members: List[RoomOwner] = list.with_capacity(6u64)
    for i in 2u64 .. 8u64 {
        let id = RoomSession(low: i, high: 0u64)
        let member = room_law_seed_desk(mut relay, rounds, id, to, inbox, owner, (256u32, 65536u64, Join))
        list.push(mut members, take member)
    }
    // 192 - 8 (Live) - 59 (Part) = 125 bytes. A join and absent state take 23 bytes.
    // The watcher gets five joins on the first Part and the last join on the second.
    let Some(first) = room_law_part(mut relay, rounds, mut watcher, None) else {
        return Error(17u64)
    }
    let Some(last) = room_law_part(mut relay, rounds, mut watcher, None) else {
        return Error(18u64)
    }
    if first.incarnation != incarnation || last.incarnation != incarnation || first.revision != 607u64 || last.revision != 607u64 || first.snapshot || !last.snapshot || list.len(first.joined) != 5u64 || list.len(last.joined) != 1u64 {
        return Error(19u64)
    }
    if let Some(_) = room_law_part(mut relay, rounds, mut watcher, None) {
        return Error(20u64)
    }
    Ok(())
}

@test
fn room_roster_identity() -> Result[(), u64] {
    room_law_reconnect_identity()?
    room_law_churn_identity()
}

fn room_law_watch() -> Result[(), u64] {
    let mut relay = room_relay_state(provide.random(0u64), 1048576u64, 2u64)
    let rounds = latest.new(arc.new(std.http.ReleaseRound(at: 0u64)))
    let (relay_to, relay_in): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(2u64 * ROOM_RELAY_TOKENS)
    let (to_owner, _inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(2u64)
    let watched = RoomSession(low: 1u64, high: 0u64)
    let watching = RoomSession(low: 2u64, high: 0u64)
    let mut watcher = room_law_seed_desk(mut relay, rounds, watching, relay_to, relay_in, to_owner, (2u32, 65536u64, Watch))
    let mut member = room_law_seed_desk(mut relay, rounds, watched, relay_to, relay_in, to_owner, (2u32, 65536u64, Join))
    let Some(joined) = room_law_part(mut relay, rounds, mut member, None) else {
        return Error(1u64)
    }
    let Some(peer) = joined.you else {
        return Error(2u64)
    }
    let Some(snapshot) = room_law_part(mut relay, rounds, mut watcher, None) else {
        return Error(3u64)
    }
    let payload = b"room message"
    room_owner_send(mut watcher, 0u32, Some(peer), payload) ?=> |_| 4u64
    if let Ok(_) = channel.try_receive(relay_in) {
        return Error(5u64)
    }
    if peer != 1u32 || list.len(joined.joined) != 1u64 || !snapshot.complete || !none(snapshot.you) || list.len(snapshot.joined) != 1u64 || snapshot.joined[0u64].0 != 1u32 {
        return Error(6u64)
    }
    room_owner_send(mut member, 0u32, None, payload) ?=> |_| 7u64
    let Ok(take event) = channel.try_receive(relay_in) else {
        return Error(8u64)
    }
    room_relay_event(mut relay, rounds, take event)
    let Some(delivered) = room_law_part(mut relay, rounds, mut watcher, None) else {
        return Error(9u64)
    }
    if list.len(delivered.msgs) != 1u64 || delivered.msgs[0u64] != (1u32, false, payload) {
        return Error(10u64)
    }
    Ok(())
}

// Hold both output buffers while eight state changes and one message accumulate.
@test
fn message_delivered_under_full_state_churn() -> Result[(), u64] {
    let mut relay = room_relay_state(provide.random(0u64), 1048576u64, 9u64)
    let rounds = latest.new(arc.new(std.http.ReleaseRound(at: 0u64)))
    let (relay_to, relay_in): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(256u64)
    let (to_owner, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(9u64)
    let id = RoomSession(low: 0u64, high: 0u64)
    let mut receiver = room_law_seed_desk(mut relay, rounds, id, relay_to, relay_in, to_owner, (9u32, 65536u64, Join))
    let mut senders: List[RoomOwner] = list.with_capacity(8u64)
    for i in 1u64 .. 9u64 {
        let sender = room_law_seed_desk(mut relay, rounds, RoomSession(low: i, high: 0u64), relay_to, relay_in, to_owner, (9u32, 65536u64, Join))
        list.push(mut senders, take sender)
    }
    room_desk_flush(mut relay, rounds, id)
    room_owner_drain(mut receiver)
    let Some(take roster) = room_owner_live(mut receiver) else {
        return Error(1u64)
    }
    let formats: std.codec.Codec[Frame] = std.codec.of()
    let initial = std.codec.decode(formats, roster.data) ?=> |_| 2u64
    let Live(parts) = initial else {
        return Error(3u64)
    }
    if list.len(parts) != 1u64 || list.len(parts[0u64].joined) != 9u64 || parts[0u64].you != Some(1u32) {
        return Error(4u64)
    }
    // The other prefunded buffer is withheld as if a previous write was blocked.
    let held = map.update(mut relay.desks, id, scoped fn(mut desk: Box[RoomDesk]) -> Option[Box[RoomLiveBuffer]] {
        list.pop(mut desk.free)
    })
    let Some(Some(take blocked)) = take held else {
        return Error(5u64)
    }
    let state = room_law_bytes(8188u64, 0x31u8)
    for i in 0u64 .. 8u64 {
        let who = senders[i].id
        let carrier = box.new(RoomCarrier(room_slot: 0u8, instance: 1u64, admission: i + 2u64, publish_epoch: 0u32, state: clone(state), state_pending: true, state_present: true, lost: 0u32, lost_under: 0u64, leave: false))
        room_relay_event(mut relay, rounds, RoomPost(who, take carrier))
    }
    let payload = room_law_bytes(32764u64, 0x32u8)
    let msg = box.new(RoomMsgBlock(instance: 1u64, admission: 2u64, member_epoch: 0u32, publish_epoch: 0u32, to: 0u32, len: 32768u32, data: clone(payload)))
    room_relay_event(mut relay, rounds, RoomMessage(senders[0u64].id, take msg))
    room_desk_flush(mut relay, rounds, id)
    if let Ok(_) = channel.try_receive(receiver.inbox) {
        return Error(6u64)
    }
    room_relay_event(mut relay, rounds, Back(id, take blocked))
    room_desk_flush(mut relay, rounds, id)
    room_owner_drain(mut receiver)
    let Some(take filled) = room_owner_live(mut receiver) else {
        return Error(7u64)
    }
    let delivered = std.codec.decode(formats, filled.data) ?=> |_| 8u64
    let Live(delivery) = delivered else {
        return Error(9u64)
    }
    if list.len(delivery) != 1u64 {
        return Error(10u64)
    }
    let part = delivery[0u64]
    if list.len(part.msgs) != 1u64 || list.len(part.states) != 3u64 {
        return Error(11u64)
    }
    let (from, direct, message) = part.msgs[0u64]
    if from != 2u32 || direct || message != payload || part.gap != 0u32 {
        return Error(12u64)
    }
    Ok(())
}

fn room_law_flush_once(mut relay: RoomRelay, rounds: Latest[RoundAt], id: RoomSession, mut receiver: RoomOwner) -> Option[(u64, u64)] {
    room_desk_flush(mut relay, rounds, id)
    room_owner_drain(mut receiver)
    let filled = room_owner_live(mut receiver)?
    let formats: std.codec.Codec[Frame] = std.codec.of()
    let decoded = std.codec.decode(formats, filled.data)
    room_relay_event(mut relay, rounds, Back(id, take filled))
    let Ok(Live(parts)) = decoded else {
        return None
    }
    let mut states = 0u64
    let mut msgs = 0u64
    for part in parts {
        states += list.len(part.states);
        msgs += list.len(part.msgs)
    }
    Some((states, msgs))
}

// Carry 4: a maximum head message leaves 65536 - 67 - 32777 bytes, three 8204-byte
// state diffs. The blocked diffs then take the next Part first: seven fit, so all
// eight states arrive within two Parts while a maximum message is always pending.
@test
fn roster_diffs_served_under_sustained_messages() -> Result[(), u64] {
    let mut relay = room_relay_state(provide.random(0u64), 1048576u64, 9u64)
    let rounds = latest.new(arc.new(std.http.ReleaseRound(at: 0u64)))
    let (relay_to, relay_in): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(256u64)
    let (to_owner, _inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(9u64)
    let id = RoomSession(low: 0u64, high: 0u64)
    let mut receiver = room_law_seed_desk(mut relay, rounds, id, relay_to, relay_in, to_owner, (9u32, 65536u64, Join))
    let mut senders: List[RoomOwner] = list.with_capacity(8u64)
    for i in 1u64 .. 9u64 {
        let sender = room_law_seed_desk(mut relay, rounds, RoomSession(low: i, high: 0u64), relay_to, relay_in, to_owner, (9u32, 65536u64, Join))
        list.push(mut senders, take sender)
    }
    if none(room_law_flush_once(mut relay, rounds, id, mut receiver)) {
        return Error(1u64)
    }
    let state = room_law_bytes(8188u64, 0x31u8)
    for i in 0u64 .. 8u64 {
        let carrier = box.new(RoomCarrier(room_slot: 0u8, instance: 1u64, admission: i + 2u64, publish_epoch: 0u32, state: clone(state), state_pending: true, state_present: true, lost: 0u32, lost_under: 0u64, leave: false))
        room_relay_event(mut relay, rounds, RoomPost(senders[i].id, take carrier))
    }
    let payload = room_law_bytes(32764u64, 0x32u8)
    let mut states = 0u64
    let mut delivered = 0u64
    let mut pending = 0u64
    for flush in 0u64 .. 3u64 {
        if pending == 0u64 {
            let msg = box.new(RoomMsgBlock(instance: 1u64, admission: 2u64, member_epoch: 0u32, publish_epoch: 0u32, to: 0u32, len: 32768u32, data: clone(payload)))
            room_relay_event(mut relay, rounds, RoomMessage(senders[0u64].id, take msg))
            pending = 1u64
        }
        let Some((s, m)) = room_law_flush_once(mut relay, rounds, id, mut receiver) else {
            return Error(2u64 + flush)
        }
        states += s
        delivered += m
        pending -= m
        if flush == 1u64 && states != 8u64 {
            return Error(10u64 + states)
        }
    }
    if delivered != 2u64 {
        return Error(20u64 + delivered)
    }
    Ok(())
}

@test
fn room_decode_capacity_reports_loss(c: Clock, random: Random, tasks: Tasks, net: Net) -> Result[(), u64] waits {
    let running = fixture.start(room_law_settings(c, random, tasks, net, true), 5000u64) ?=> |_| 1u64
    let sender = room_law_socket(tasks, net, c, random, running, true)
    if none(room_law_you(sender)) {
        return Error(2u64)
    }
    let mut raw_value: Bytes = list.with_capacity(8192u64)
    std.codec.put_u32(2047u32, mut raw_value)
    for _ in 0u64 .. 2047u64 {
        std.codec.put_u32(0u32, mut raw_value)
    }
    wire_client.send_frame(sender, Set(0u32, Some(take raw_value)))
    let mut losses = 0u32
    for _ in 0u64 .. 6u64 {
        match wire_client.next(sender) {
            Ok(Live(parts)) => {
                for part in parts {
                    if part.sub == 0u32 {
                        losses += part.lost
                    }
                }
                if losses != 0u32 {
                    break
                }
            },
            Ok(Batch(..)) => (),
            _ => return Error(3u64),
        }
    }
    let _ = wire_client.close(take sender)
    let _ = fixture.end(take running, 5000u64)
    if losses != 1u32 {
        return Error(4u64)
    }
    Ok(())
}

// MEM-20: Desk, Seats and MsgBlocks keep the owner's record when they move to
// the relay. The owner's reservation must hold eight subs of the funded
// 300-peer room, the Desk, the MsgBlocks and one maximum-size decode.
// The law's own isolate adds one 32-byte cause cell (MEM-24).
@test
fn room_session_charge_covers_maximum_session() -> Result[(), u64] {
    let bounds = RoomBounds(peers: 300u32, state: STATE_MAX, message: MESSAGE_MAX)
    let membership_bytes = room_membership_charge(bounds, ROOM_ARGS_MAX)
    let reserve = room_session_charge(membership_bytes, int.widen(MESSAGE_MAX), int.widen(MESSAGE_MAX), int.widen(LIVE_MAX))
    let (relay_to, relay_in): (Sender[RoomRelayIn], Receiver[RoomRelayIn]) = channel.new(ROOM_RELAY_TOKENS)
    let (to_owner, _events): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(1u64)
    let rounds = latest.new(arc.new(std.http.ReleaseRound(at: 0u64)))
    let message_max: u64 = int.widen(MESSAGE_MAX)
    let input = room_law_bytes(message_max - 4u64, 0x43u8)
    let held = bound bytes (reserve + 32u64) {
        isolate(scoped fn() -> (RoomOwner, RoomCodecCheck) {
            let link = RoomLink(relay: channel.sender(relay_to), round_read: latest.handle(rounds), max_message: message_max, live_limit: int.widen(LIVE_MAX), hooks: room_hooks)
            let mut owner = result.unwrap(room_owner(take link, RoomSession(low: 0u64, high: 0u64), to_owner))
            for sub in 0u32 .. 8u32 {
                let mut arg: Bytes = list.with_capacity(ROOM_ARGS_MAX)
                list.fill(mut arg, ROOM_ARGS_MAX, 0x41u8)
                let mut subject: Bytes = list.with_capacity(SUBJECT_MAX)
                list.fill(mut subject, SUBJECT_MAX, 0x42u8)
                let state_format: std.codec.Codec[Bytes] = std.codec.of()
                let message_format: std.codec.Codec[Bytes] = std.codec.of()
                let req = RoomRequest(key: RoomKey(entry: 0u32, arg: take arg), codec: RoomCodecs(state: fn(raw: Bytes) -> RoomCodecCheck {
                    decode_room_value(state_format, raw)
                }, message: fn(raw: Bytes) -> RoomCodecCheck {
                    decode_room_value(message_format, raw)
                }), bounds)
                result.unwrap(room_owner_join(mut owner, sub, 1u64, take req, store.Caller(issuer: 2u8, subject: take subject)))
            }
            let format: std.codec.Codec[Bytes] = std.codec.of()
            (take owner, decode_room_value(format, input))
        })
    }
    let Ok(Ok(Ok((take owner, largest)))) = take held else {
        return Error(1u64)
    }
    if let ValidRoomValue = largest {} else {
        return Error(2u64)
    }
    let mut seats = 0u64
    while let Ok(event) = channel.try_receive(relay_in) {
        if let Enter(..) = event {
            seats += 1u64
        }
    }
    let _ = take owner
    if seats != 8u64 {
        return Error(3u64)
    }
    Ok(())
}

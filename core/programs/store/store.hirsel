// Q1/K1: sweep task allowances through open and schema-cut refusal. A refused
// create_table leaves the base reader roots and durable generation unchanged.
pub fn disk_law_schema_refusal(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let limits: Inline[u64, 4] =[1048576, 2097152, 20971520, 33554432]
    let mut refusals: u64 = 0
    let mut successes: u64 = 0
    for allowance in limits {
        let mut name = string.from("schema-cut-")
        string.reserve(mut name, 32)
        let child = result.unwrap(host.mkdtemp(d, mut name))
        let mut options = defaults()

        options.resident_limit = 1048576
        options.pack_bytes = 512
        let attempt = open(tasks, child, c, r, options)
        let mut db = match take attempt {
            Ok(take db) => take db,
            Error(Full(_)) => continue,
            _ => return false
        }
        match create_table(mut db, spec("base", std.codec.key_u64(), std.codec.of_u64())) {
            Ok(_) => {},
            Error(Full(_)) => {
                result.unwrap(close(take db));
                continue
            },
            _ => return false
        }
        let base = result.unwrap(table(mut db, "base", std.codec.key_u64(), std.codec.of_u64()))
        for k in 0u64 .. 512 {
            if !typed_put(mut db, base, k, k + 1) {
                return false
            }
        }
        let made = bound bytes allowance { create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())) }
        match take made {
            Ok(Error(Full(Allocation(_)))) => {
                refusals += 1
                if db.heads[0].head != 513 || db.resident != 260 + 512 * 94 || db.checkpointed != 2
                    || db.next_table != 2 || page_row_count(db.heads[0].roots.catalog) != 1
                    || page_row_count(db.heads[0].roots.collections) != 512 {
                    return false
                }
                let persisted = result.unwrap(disk_load(child, 1048576))
                if persisted.manifest.generation != 2 || persisted.manifest.branches[0].version != 1
                    || persisted.manifest.next_table != 2 || page_row_count(persisted.all[0u64].catalog) != 1
                    || page_row_count(persisted.all[0u64].collections) != 0 {
                    return false
                }
            },
            Ok(Ok(commit_ticket)) => {
                successes += 1
                if db.heads[0].head != 514 || db.checkpointed != 3 || db.next_table != 3 {
                    return false
                }
                result.unwrap(durable(mut db, commit_ticket))
            },
            _ => return false
        }
        result.unwrap(close(take db))
    }
    refusals > 0 && successes > 0
}


// rule: DET-1
// expect: run
// A second std@1/store writer opening the same Dir claims the next epoch and
// fences the first: the first writer's next log object finds its id taken,
// so its commit's durable() returns Fenced() and every later call Closed(),
// while the second writer's commits survive a reopen. The two-opener law holds
// across compaction too: whatever the schedule, including the successor
// compacting before the first writer's next commit, or compacting twice before
// the first writer compacts, the store reopens and holds every commit whose
// durable() returned Ok, since compaction never frees an object's name.
@serializable
type Pair {
  key: Bytes,
  value: Bytes,
}

fn puts(mut tx: store.Tx, info: store.CallInfo, p: Pair) -> Result[(), store.TxError] {
  store.tx_put(mut tx, unique p.key, unique p.value)
}

// The store's error, whether or not the commit may have become durable.
fn put(mut s: store.Store[Dir], k: Bytes, v: Bytes) -> Result[(), store.StoreError] {
  match store.transact(mut s, puts, Pair(key: unique k, value: unique v)) {
    Ok(()) => Ok(()),
    Error(Storage(e)) => Error(e),
    Error(Unknown(e)) => Error(e),
    Error(Limit(l)) => Error(Limit(l)),
    Error(_) => Error(Corrupt("put")),
  }
}

// Whether the store in `d` opens and holds every acknowledged commit.
fn holds_acknowledged(d: Dir, acked: List[(Bytes, Bytes)]) -> bool uses {d} {
  let Ok(opened) = store.open(d, store.default_config()) else {
    return false
  }
  let mut s = take opened
  let now = store.snapshot(mut s)
  let mut all = true
  for (k, v) in acked {
    let found = match store.get(now, k) {
      Some(stored) => stored == v,
      None() => false,
    }
    all = all && found
  }
  let _ = store.close(take s)
  all
}

// Commits `k` = `v` through `s`, adding it to `acked` when durable() returns Ok.
fn attempt(mut s: store.Store[Dir], mut acked: List[(Bytes, Bytes)], k: Bytes, v: Bytes) -> () {
  if put(mut s, k, v) == Ok(()) {
    list.push(mut acked, (unique k, unique v))
  }
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  let d = test.dir(t, [])
  let mut old = store.open(d, store.default_config())?
  put(mut old, b"a", b"old")?
  let mut new = store.open(d, store.default_config())?
  test.check(t, store.get(store.snapshot(mut new), b"a") == Some(b"old"))
  test.check(t, put(mut old, b"b", b"stale") == Error(Fenced()))
  test.check(t, put(mut old, b"c", b"late") == Error(Closed()))
  test.check(t, store.close(take old) == Error(Closed()))
  put(mut new, b"b", b"new")?
  store.close(take new)?
  let mut again = store.open(d, store.default_config())?
  let now = store.snapshot(mut again)
  test.check(t, store.get(now, b"b") == Some(b"new") && store.get(now, b"c") == None())
  store.close(take again)?
  // The successor compacts before the first writer's next commit.
  let e = test.dir(t, [])
  let mut a = store.open(e, store.default_config())?
  let mut b = store.open(e, store.default_config())?
  store.compact(mut b)?
  let mut acked: List[(Bytes, Bytes)] = []
  attempt(mut a, mut acked, b"x", b"1")
  attempt(mut b, mut acked, b"y", b"2")
  let _ = store.close(take a)
  let _ = store.close(take b)
  test.check(t, holds_acknowledged(e, acked))
  // The successor compacts twice, then the superseded writer compacts.
  let f = test.dir(t, [])
  let mut a2 = store.open(f, store.default_config())?
  let mut b2 = store.open(f, store.default_config())?
  let mut acked2: List[(Bytes, Bytes)] = []
  attempt(mut b2, mut acked2, b"k", b"1")
  store.compact(mut b2)?
  attempt(mut b2, mut acked2, b"m", b"2")
  store.compact(mut b2)?
  let _ = store.compact(mut a2)
  attempt(mut a2, mut acked2, b"z", b"3")
  let _ = store.close(take a2)
  let _ = store.close(take b2)
  test.check(t, holds_acknowledged(f, acked2))
  Ok(())
}

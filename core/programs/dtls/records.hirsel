pub type Close = Local | PeerClosed | PeerAlert(u8) | SentAlert(u8) | Timeout

pub type Discards {
    malformed: u64,
    replayed: u64,
    tampered: u64,
    stale_epoch: u64,
    overflow: u64
}

pub type RecordError = Capacity(Capacity) | Packet(packet.PacketError) | Schedule(schedule.ScheduleError) | DatagramFull | SequenceExhausted | InvalidRecord | Closed(Close)

pub type RecordEvent = End | Discarded | Held | Ignored | ChangeCipherSpec | AlertClosed(Close) | HandshakeRecord(RecordHeader, Bytes) | ApplicationData(Bytes)

type RecordQueue {
    entries: List[Bytes],
    head: u64
}

pub opaque type Ahead {
    limit: u64,
    fragments: u64,
    encrypted: RecordQueue,
    application: RecordQueue,
    /// The record `next_early_record` last took, until the next drain call: a refused step
    /// on it puts it back (DTLS-8). It holds no slot.
    drained: Option[Bytes]
}

type ReceiveKeys {
    cipher: packet.Opener,
    explicit: u64,
    window: std.replay.Window
}

type SendKeys {
    cipher: packet.Sealer,
    explicit: u64,
    next: u64
}

pub opaque type Records {
    read: Option[ReceiveKeys],
    write: Option[SendKeys],
    plain_next: u64,
    connected: bool,
    close: Option[Close],
    dropped: Discards
}

fn queue() -> RecordQueue {
    RecordQueue(entries: list.new(), head: 0)
}

fn queued(q: RecordQueue) -> u64 {
    list.len(q.entries) - q.head
}

fn ahead_full(a: Ahead) -> bool {
    a.fragments + queued(a.encrypted) + queued(a.application) >= a.limit
}

fn enqueue(mut q: RecordQueue, take b: Bytes) -> Result[(), RecordError] {
    match list.try_reserve(mut q.entries, 1) {
        Ok(()) => list.push(mut q.entries, take b),
        Error(c) => {
            return Error(Capacity(c))
        },
    }
    Ok(())
}

fn dequeue(mut q: RecordQueue) -> Bytes {
    let b = list.set(mut q.entries, q.head, list.new())
    q.head += 1
    if q.head == list.len(q.entries) {
        list.clear(mut q.entries)
        q.head = 0
    }
    b
}

/// Put `b` back at the head of `q`, where `dequeue` took it from.
fn requeue(mut q: RecordQueue, take b: Bytes) {
    if q.head == 0 {
        list.push(mut q.entries, take b)
    } else {
        q.head -= 1
        q.entries[q.head] = b
    }
}

pub fn ahead(max_ahead: u16) -> Ahead {
    Ahead(limit: int.widen(max_ahead), fragments: 0, encrypted: queue(), application: queue(), drained: None)
}

pub fn records(first_plain_sequence: u64) -> Records {
    Records(read: None, write: None, plain_next: first_plain_sequence, connected: false, close: None, dropped: Discards(malformed: 0, replayed: 0, tampered: 0, stale_epoch: 0, overflow: 0))
}

pub fn record_discards(r: Records) -> Discards {
    r.dropped
}

pub fn record_close(r: Records) -> Option[Close] {
    r.close
}

/// The handshake calls this only after verifying Finished, possession and the pin.
pub fn records_connected(mut r: Records) {
    r.connected = true
}

fn explicit_nonce(suite: schedule.Suite12) -> u64 {
    match suite {
        ChaCha20Poly1305Sha256 => 0,
        _ => EXPLICIT_NONCE,
    }
}

pub fn start_sending_protected(mut r: Records, mut s: schedule.Schedule, suite: schedule.Suite12) -> Result[(), RecordError] {
    if let Some(c) = r.close {
        return Error(Closed(c))
    }
    if let Some(_) = r.write {
        return Error(InvalidRecord)
    }
    match schedule.sealer(mut s, Application, 0, 0) {
        Ok(take cipher) => {
            r.write = Some(SendKeys(cipher: take cipher, explicit: explicit_nonce(suite), next: 0))
            Ok(())
        },
        Error(Capacity(c)) => Error(Capacity(c)),
        Error(e) => Error(Schedule(e)),
    }
}

/// Install the opener only after the handshake accepts the peer's ChangeCipherSpec.
pub fn start_receiving_protected(mut r: Records, s: schedule.Schedule, suite: schedule.Suite12) -> Result[(), RecordError] {
    if let Some(c) = r.close {
        return Error(Closed(c))
    }
    if let Some(_) = r.read {
        return Ok(())
    }
    match schedule.opener(s, Application) {
        Ok(take cipher) => {
            r.read = Some(ReceiveKeys(cipher: take cipher, explicit: explicit_nonce(suite), window: result.unwrap(std.replay.window(64))))
            Ok(())
        },
        Error(Capacity(c)) => Error(Capacity(c)),
        Error(e) => Error(Schedule(e)),
    }
}

/// The snapshot includes receipts that a provisional advance may evict (DTLS-8).
fn read_window(r: Records) -> Option[std.replay.Window] {
    match r.read {
        Some(k) => Some(result.unwrap(std.replay.try_copy(k.window))),
        None => None,
    }
}

fn restore_window(mut r: Records, take snapshot: Option[std.replay.Window]) {
    if let Some(take window) = take snapshot {
        if let Some(mut k) = r.read {
            k.window = take window
        }
    }
}

fn copy_record(data: Bytes, lo: u64, hi: u64) -> Result[Bytes, RecordError] {
    let mut out: Bytes = list.new()
    match list.try_reserve(mut out, hi - lo) {
        Ok(()) => list.append(mut out, list.slice(data, lo, hi)),
        Error(c) => {
            return Error(Capacity(c))
        },
    }
    Ok(take out)
}

fn malformed(mut dropped: Discards) -> RecordEvent {
    dropped.malformed += 1
    Discarded
}

fn tampered(mut dropped: Discards) -> RecordEvent {
    dropped.tampered += 1
    Discarded
}

fn overflow(mut dropped: Discards) -> RecordEvent {
    dropped.overflow += 1
    Discarded
}

fn alert(mut closed: Option[Close], mut dropped: Discards, payload: Bytes) -> RecordEvent {
    if list.len(payload) != 2 || (payload[0] != 1 && payload[0] != 2) {
        return malformed(mut dropped)
    }
    let ending = if payload[1] == 0 {
        PeerClosed
    } else if payload[0] == 2 {
        PeerAlert(payload[1])
    } else {
        return Ignored
    }
    closed = Some(ending)
    AlertClosed(ending)
}

/// Process one record so the handshake can change state between records in a datagram.
pub fn next_record(mut r: Records, mut a: Ahead, version: RecordVersion, datagram: Bytes, mut at: u64) -> Result[RecordEvent, RecordError] {
    if let Some(c) = r.close {
        return Error(Closed(c))
    }
    if at == list.len(datagram) {
        return Ok(End)
    }
    let Some(h) = record_header(datagram, at, version) else {
        at = list.len(datagram)
        return Ok(malformed(mut r.dropped))
    }
    let event = match h.epoch {
        0 => receive_plain(mut r, datagram, h)?,
        1 => {
            if let Some(mut k) = r.read {
                receive_protected(mut k, mut a, r.connected, mut r.dropped, mut r.close, datagram, h)?
            } else if h.end - h.start > MAX_PLAINTEXT + TAG + EXPLICIT_NONCE {
                // Longer than any sealed 16,384-byte plaintext: never held.
                tampered(mut r.dropped)
            } else if ahead_full(a) {
                overflow(mut r.dropped)
            } else {
                let raw = copy_record(datagram, at, h.end)?
                enqueue(mut a.encrypted, take raw)?
                Held
            }
        },
        _ => {
            r.dropped.stale_epoch += 1
            Discarded
        },
    }
    at = h.end
    Ok(take event)
}

fn receive_plain(mut r: Records, datagram: Bytes, h: RecordHeader) -> Result[RecordEvent, RecordError] {
    let after_ccs = match r.read {
        Some(_) => true,
        None => false
    }
    // Once the peer's ChangeCipherSpec has installed the opener, only a repeated
    // ChangeCipherSpec may still arrive in epoch 0; nothing else there can authenticate.
    if r.connected || (after_ccs && h.kind != CCS) {
        r.dropped.stale_epoch += 1
        return Ok(Discarded)
    }
    let len = h.end - h.start
    if len > MAX_PLAINTEXT || h.kind == APPLICATION {
        return Ok(malformed(mut r.dropped))
    }
    let payload = list.slice(datagram, h.start, h.end)
    if h.kind == CCS {
        if len != 1 || payload[0] != 1 {
            return Ok(malformed(mut r.dropped))
        }
        return Ok(if after_ccs {
            Ignored
        } else {
            ChangeCipherSpec
        })
    }
    if h.kind == ALERT {
        return Ok(alert(mut r.close, mut r.dropped, payload))
    }
    let body = copy_record(datagram, h.start, h.end)?
    Ok(HandshakeRecord(h, take body))
}

fn receive_protected(mut k: ReceiveKeys, mut a: Ahead, connected: bool, mut dropped: Discards, mut closed: Option[Close], datagram: Bytes, h: RecordHeader) -> Result[RecordEvent, RecordError] {
    if std.replay.seen(k.window, h.sequence) != Fresh {
        dropped.replayed += 1
        return Ok(Discarded)
    }
    let size = h.end - h.start
    if size < TAG + k.explicit || size - TAG - k.explicit > MAX_PLAINTEXT {
        return Ok(tampered(mut dropped))
    }
    let number = record_number(h.epoch, h.sequence)
    let nonce: u64 = if k.explicit == 0 {
        number
    } else {
        list.word_be(datagram, h.start)
    }
    let length: u16 = int.narrow(size - TAG - k.explicit)
    let aad = match record_aad(h.kind, number, length) {
        Ok(take built) => built,
        Error(c) => {
            return Error(Capacity(c))
        },
    }
    let ciphertext = list.slice(datagram, h.start + k.explicit, h.end)
    let mut body: Bytes = list.new()
    match list.try_reserve(mut body, int.widen(length)) {
        Error(c) => {
            return Error(Capacity(c))
        },
        Ok(()) => (),
    }
    match packet.open_into(k.cipher, 0, nonce, ciphertext, 0, 0, aad, mut body) {
        Error(Tampered) => {
            return Ok(tampered(mut dropped))
        },
        Error(Range) => {
            return Ok(tampered(mut dropped))
        },
        Error(Capacity(c)) => {
            return Error(Capacity(c))
        },
        Error(e) => {
            return Error(Packet(e))
        },
        Ok(_) => (),
    }
    if h.kind == APPLICATION && !connected {
        if ahead_full(a) {
            return Ok(overflow(mut dropped))
        }
        enqueue(mut a.application, take body)?
        let _ = std.replay.mark(mut k.window, h.sequence)
        return Ok(Held)
    }
    let _ = std.replay.mark(mut k.window, h.sequence)
    match h.kind {
        kind if kind == HANDSHAKE => Ok(HandshakeRecord(h, take body)),
        kind if kind == APPLICATION => Ok(ApplicationData(take body)),
        kind if kind == ALERT => Ok(alert(mut closed, mut dropped, body)),
        _ => Ok(malformed(mut dropped)),
    }
}

/// Drain after accepting ChangeCipherSpec, one record at a time. Free its shared slot
/// while processing it, including if authenticated application data has to wait.
pub fn next_early_record(mut r: Records, mut a: Ahead) -> Result[RecordEvent, RecordError] {
    a.drained = None
    if let Some(c) = r.close {
        return Error(Closed(c))
    }
    if let None = r.read {
        return Ok(End)
    }
    if queued(a.encrypted) == 0 {
        return Ok(End)
    }
    let raw = dequeue(mut a.encrypted)
    let mut at = 0u64
    match next_record(mut r, mut a, Fixed, raw, mut at) {
        Ok(take event) => {
            a.drained = Some(take raw)
            Ok(take event)
        },
        Error(e) => {
            // Restore the record at the head on a retryable resource refusal.
            requeue(mut a.encrypted, take raw)
            Error(e)
        },
    }
}

/// Processing the record `next_early_record` just returned was refused: hold it again at
/// the head, so the next receive drains it first (DTLS-8).
fn undo_early_record(mut a: Ahead) {
    if let Some(take raw) = replace(mut a.drained, None) {
        requeue(mut a.encrypted, take raw)
    }
}

pub fn next_held_application(r: Records, mut a: Ahead) -> Option[Bytes] {
    if let Some(_) = r.close {
        return None
    }
    if !r.connected || queued(a.application) == 0 {
        return None
    }
    Some(dequeue(mut a.application))
}

fn output_room(out: Bytes, n: u64) -> Result[(), RecordError] {
    let available = list.capacity(out) - list.len(out)
    if available < n {
        return Error(Capacity(Capacity(requested: n, available: available)))
    }
    Ok(())
}

fn write_plain_record(sequence: u64, kind: u8, body: Bytes, mut out: Bytes) -> Result[u64, RecordError] {
    if sequence > MAX_RECORD_SEQUENCE {
        return Error(SequenceExhausted)
    }
    let len = list.len(body)
    let size = RECORD_HEADER + len
    output_room(out, size)?
    let version: u16 = if kind == HANDSHAKE && len > 0 && body[0] == 3 {
        0xfeff
    } else {
        0xfefd
    }
    record_prefix(mut out, kind, version, sequence, int.narrow(len))
    list.append(mut out, body)
    Ok(size)
}

/// For the stateless HelloVerifyRequest, which echoes the received record number.
pub fn write_verify_request(sequence: u64, body: Bytes, mut out: Bytes) -> Result[u64, RecordError] {
    if list.len(body) == 0 || list.len(body) > MAX_PLAINTEXT || body[0] != 3 {
        return Error(InvalidRecord)
    }
    write_plain_record(sequence, HANDSHAKE, body, mut out)
}

fn record_overhead(r: Records, protected: bool) -> u64 {
    match r.write {
        Some(k) if protected => RECORD_HEADER + TAG + k.explicit,
        _ => RECORD_HEADER,
    }
}

/// A Cookie server learns its first record number from the ClientHello it answers.
pub fn set_plain_sequence(mut r: Records, sequence: u64) {
    r.plain_next = sequence
}

fn sending_protected(r: Records) -> bool {
    match r.write {
        Some(_) => true,
        None => false,
    }
}

pub fn write_record(mut r: Records, mtu: u16, kind: u8, body: Bytes, mut out: Bytes) -> Result[u64, RecordError] {
    let protected = sending_protected(r)
    write_record_in(mut r, mtu, protected, kind, body, mut out)
}

/// Write in epoch 1 when protected, else in epoch 0, so a resent flight keeps its epochs.
pub fn write_record_in(mut r: Records, mtu: u16, protected: bool, kind: u8, body: Bytes, mut out: Bytes) -> Result[u64, RecordError] {
    if let Some(c) = r.close {
        return Error(Closed(c))
    }
    let len = list.len(body)
    if kind < CCS || kind > APPLICATION || len > MAX_PLAINTEXT {
        return Error(InvalidRecord)
    }
    if kind == APPLICATION && !r.connected {
        return Error(InvalidRecord)
    }
    let size = record_overhead(r, protected) + len
    let at = list.len(out)
    let room: u64 = int.widen(mtu)
    if at > room || size > room - at {
        return Error(DatagramFull)
    }
    if protected {
        if let Some(mut k) = r.write {
            if kind == CCS {
                return Error(InvalidRecord)
            }
            if k.next > MAX_RECORD_SEQUENCE {
                return Error(Packet(Range))
            }
            output_room(out, size)?
            let number = record_number(1, k.next)
            let aad = match record_aad(kind, number, int.narrow(len)) {
                Ok(take built) => built,
                Error(c) => {
                    return Error(Capacity(c))
                },
            }
            record_prefix(mut out, kind, 0xfefd, number, int.narrow(len + TAG + k.explicit))
            if k.explicit != 0 {
                list.put_word_be(mut out, number)
            }
            let start = list.len(out)
            match packet.seal_into(mut k.cipher, k.next, body, 0, mut out, start, aad) {
                Ok(_) => {
                    k.next += 1
                    return Ok(size)
                },
                Error(e) => {
                    list.truncate(mut out, at)
                    return match e {
                        Capacity(c) => Error(Capacity(c)),
                        _ => Error(Packet(e)),
                    }
                },
            }
        }
        return Error(InvalidRecord)
    }
    if kind == APPLICATION {
        return Error(InvalidRecord)
    }
    let n = write_plain_record(r.plain_next, kind, body, mut out)?
    r.plain_next += 1
    Ok(n)
}

pub fn write_close_notify(mut r: Records, mtu: u16, mut out: Bytes) -> Result[u64, RecordError] {
    let n = write_record(mut r, mtu, ALERT, b"\x01\x00", mut out)?
    r.close = Some(Local)
    Ok(n)
}

pub fn write_fatal_alert(mut r: Records, mtu: u16, code: u8, mut out: Bytes) -> Result[u64, RecordError] {
    let mut body: Bytes = list.with_capacity(2)
    list.push(mut body, 2)
    list.push(mut body, code)
    let n = write_record(mut r, mtu, ALERT, body, mut out)?
    r.close = Some(SentAlert(code))
    Ok(n)
}

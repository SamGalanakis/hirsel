// A collection's row diff that `walk_page_changes` deferred because one side
// is Tiered: `start` and `stop` are suffixes within the collection, and
// `before` and `after` say which snapshot holds it.
pub type TieredRowDiff {
    id: u32,
    start: Option[Bytes],
    stop: Option[Bytes],
    before: bool,
    after: bool
}

// Rows each side reads per pager attempt while two Tiered sides are merged.
pub const TIERED_DIFF_BATCH: u64 = 256

// A page edge of one side's collection tree and the suffix span [lo, hi) its
// subtree covers there (hi None: the collection's end).
pub type TieredDiffEdge {
    slot: std.page.Slot,
    stamp: u64,
    level: u8,
    lo: Bytes,
    hi: Option[Bytes]
}

// A root edge's level is known only once its page is read.
pub const TIERED_DIFF_UNREAD: u8 = 255

// Edges one pager attempt expands.
pub const TIERED_DIFF_EXPAND: u64 = 16

pub fn tiered_slot_stamp(slot: std.page.Slot) -> u64 {
    match slot {
        HotPage(page) => std.page.stamp(std.page.image_of(page)),
        ColdPage(ptr) => ptr.stamp,
    }
}

pub fn tiered_diff_root(tree: pages.PageTree, key: Bytes) -> List[TieredDiffEdge] {
    let mut edges: List[TieredDiffEdge] = list.new()
    let (edge, _) = option.unwrap(std.page.collection_slot(tree.root, key))
    let slot: std.page.Slot = clone(edge)
    let stamp = tiered_slot_stamp(slot)
    list.push(mut edges, TieredDiffEdge(slot: take slot, stamp, level: TIERED_DIFF_UNREAD, lo: list.new(), hi: None))
    take edges
}

// Drops every edge whose stamp is an edge of the other side. A zero stamp
// names no subtree and is never dropped.
pub fn tiered_diff_drop_shared(mut left: List[TieredDiffEdge], mut right: List[TieredDiffEdge]) {
    let mut in_left: Map[u64, ()] = map.new()
    for edge in left {
        if edge.stamp != 0 {
            map.insert(mut in_left, edge.stamp, ())
        }
    }
    let mut in_right: Map[u64, ()] = map.new()
    for edge in right {
        if edge.stamp != 0 {
            map.insert(mut in_right, edge.stamp, ())
        }
    }
    list.retain(mut left, scoped fn(edge: TieredDiffEdge) -> bool {
        edge.stamp == 0 || !map.contains(in_right, edge.stamp)
    })
    list.retain(mut right, scoped fn(edge: TieredDiffEdge) -> bool {
        edge.stamp == 0 || !map.contains(in_left, edge.stamp)
    })
}

pub fn tiered_diff_push(mut spans: List[(Bytes, Bytes)], take lo: Bytes, take hi: Bytes, low: Bytes, high: Bytes) -> Result[(), types.Failure] {
    let start = if lo < low {
        types.copied(low)?
    } else {
        take lo
    }
    let stop = if hi > high {
        types.copied(high)?
    } else {
        take hi
    }
    if start < stop {
        types.capacity(list.try_reserve(mut spans, 1))?
        list.push(mut spans, (take start, take stop))
    }
    Ok(())
}

pub fn tiered_diff_add_span(mut spans: List[(Bytes, Bytes)], id: u32, edge: TieredDiffEdge, low: Bytes, high: Bytes) -> Result[(), types.Failure] {
    let lo = catalog.logical_key(id, edge.lo)?
    let hi = match edge.hi {
        Some(suffix) => catalog.logical_key(id, suffix)?,
        None => catalog.prefix(id + 1)?,
    }
    tiered_diff_push(mut spans, take lo, take hi, low, high)
}

// The sequences between a Log window edge's old and new place.
pub fn tiered_diff_window_span(mut spans: List[(Bytes, Bytes)], id: u32, old: u64, new: u64, low: Bytes, high: Bytes) -> Result[(), types.Failure] {
    if old == new {
        return Ok(())
    }
    tiered_diff_push(mut spans, log_key(id, order.min(old, new))?, log_key(id, order.max(old, new))?, low, high)
}

// One side's buffered rows: `rows[at..]` are unread, and `from` is where the
// next batch starts.
pub type TieredDiffSide {
    rows: List[(Bytes, Arc[Bytes])],
    at: u64,
    from: Bytes,
    done: bool
}

pub fn tiered_page_rank(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], edge: std.page.Slot, expected: Option[u8], sought: Bytes) -> Result[u64, types.Failure] {
    let page = tiered_point_page(attempt, visible, edge, expected)?
    let image = std.page.image_of(page)
    let Some(selected) = std.page.descend(image, sought) else {
        let (rank, _) = std.page.search(image, sought)
        return Ok(rank)
    }
    let mut skipped = 0u64
    for slot in 0u64 .. selected {
        let row = option.unwrap(std.page.entry(image, slot))
        let Child(link) = view row.cell else {
            fail("store: a verified interior page has only branches")
        }
        let Some(total) = int.checked_add(skipped, link.rows) else {
            return Error(pages.malformed(0))
        }
        skipped = total
    }
    let child = option.unwrap(std.page.child_slot(page, selected))
    let rank = tiered_page_rank(attempt, visible, child, Some(std.page.level(image) - 1), sought)?
    let Some(total) = int.checked_add(skipped, rank) else {
        return Error(pages.malformed(0))
    }
    Ok(total)
}

pub fn tiered_count_overlay(overlay: Option[View[Arc[pages.ReplayOverlay]]], low: Bytes, high: Bytes, base_count: u64) -> Result[u64, types.Failure] {
    if let Some(edits) = overlay {
        return replay_overlay_count(edits, low, high, base_count)
    }
    Ok(base_count)
}

// The QUIC-1 stream calls. Each reaches a connection by handle once the handshake has
// its transport parameters; before then, or once closing, a call is StreamState.
fn stream_slot(mut e: Endpoint, c: ConnectionHandle) -> Result[u64, QuicError] {
    let Some(i) = slot_at_mut(mut e, c) else {
        return Error(UnknownConnection)
    }
    if let Some(conn) = e.connections[i] {
        if open_life(conn) && conn.streams.ready {
            return Ok(i)
        }
    }
    Error(StreamState)
}

fn open_in(mut st: Streams, bidi: bool) -> Result[StreamId, QuicError] {
    let limit = if bidi {
        st.local_bidi_limit
    } else {
        st.local_uni_limit
    }
    let opened = if bidi {
        st.local_bidi_opened
    } else {
        st.local_uni_opened
    }
    if opened >= limit {
        return Error(Limit)
    }
    let mut id = opened << 2
    if !bidi {
        id = id | 2
    }
    if st.side_server {
        id = id | 1
    }
    add_stream(mut st, id)
    if bidi {
        st.local_bidi_opened += 1
    } else {
        st.local_uni_opened += 1
    }
    Ok(StreamId(id))
}

pub fn open(mut e: Endpoint, c: ConnectionHandle, bidi: bool) -> Result[StreamId, QuicError] {
    let i = stream_slot(mut e, c)?
    if let Some(mut conn) = e.connections[i] {
        return open_in(mut conn.streams, bidi)
    }
    Error(UnknownConnection)
}

fn writable_send(st: Streams, id: u64) -> Result[u64, QuicError] {
    let Some(i) = find(st, id) else {
        return Error(UnknownStream)
    }
    let Some(s) = st.list[i].send else {
        return Error(StreamState)
    }
    if s.fin || s.acked_reported {
        return Error(StreamState)
    }
    if let Some(_) = s.reset {
        return Error(StreamState)
    }
    Ok(i)
}

fn headroom(limit: u64, used: u64) -> u64 {
    if limit > used {
        return limit - used
    }
    0
}

/// Queue at most what fits under the stream's credit, the connection's and send_bytes
/// (QUIC-5); the count says how much. A short write asks for Writable.
fn write_in(mut st: Streams, id: u64, data: Bytes, fin: bool) -> Result[u64, QuicError] {
    let i = writable_send(st, id)?
    // The copy's storage is n bytes rounded up to 8 (MEM-24), so at most the headroom
    // rounded down to 8 is taken.
    let memory = headroom(st.send_bytes, st.held) / 8 * 8
    let connection = headroom(st.peer_max_data, st.written_data)
    let mut n = 0u64
    let mut charge = 0u64
    if let Some(mut s) = st.list[i].send {
        n = order.min(order.min(list.len(data), memory), order.min(headroom(s.credit, s.written),
            connection))
        if n > 0 {
            if list.len(s.pieces) == list.capacity(s.pieces) && s.head > 0 {
                compact_pieces(mut s)
            }
            let mut owned: Bytes = list.with_capacity(n)
            list.append(mut owned, list.slice(data, 0, n))
            charge = round8(n)
            list.push(mut s.pieces, Piece(offset: s.written, len: n, data: Owned(take owned),
                charge: charge))
            s.written += n
        }
        if n < list.len(data) {
            s.want_writable = true
        } else if fin {
            s.fin = true
            s.fin_pending = true
        }
    }
    st.held += charge
    st.written_data += n
    Ok(n)
}

pub fn write(mut e: Endpoint, c: ConnectionHandle, s: StreamId, data: Bytes, fin: bool) -> Result[
    u64, QuicError] {
    let i = stream_slot(mut e, c)?
    let StreamId(id) = s
    let mut out: Result[u64, QuicError] = Error(UnknownConnection)
    if let Some(mut conn) = e.connections[i] {
        out = write_in(mut conn.streams, id, data, fin)
    }
    if let Ok(_) = out {
        enqueue_ready(mut e, i)
    }
    out
}

/// All or nothing against send_bytes; Ok(false) asks for Writable (QUIC-5). The charge
/// is what the slice keeps alive (QUIC-9), not its length.
fn write_shared_in(mut st: Streams, id: u64, take data: PayloadSlice, fin: bool) -> Result[bool,
    QuicError] {
    let i = writable_send(st, id)?
    let len = payload_len(data)
    let charge = if len > 0 {
        payload_retained_bytes(data)
    } else {
        0u64
    }
    let fits = charge <= headroom(st.send_bytes, st.held)
    if let Some(mut s) = st.list[i].send {
        if !fits {
            s.want_writable = true
            return Ok(false)
        }
        if len > 0 {
            if list.len(s.pieces) == list.capacity(s.pieces) && s.head > 0 {
                compact_pieces(mut s)
            }
            list.push(mut s.pieces, Piece(offset: s.written, len: len, data: Held(take data),
                charge: charge))
            s.written += len
        }
        if fin {
            s.fin = true
            s.fin_pending = true
        }
    }
    st.held += charge
    st.written_data += len
    Ok(true)
}

/// Queue a payload slice on a stream without copying it; the slice's bytes are copied
/// once, into the sealed packet.
pub fn write_shared(mut e: Endpoint, c: ConnectionHandle, s: StreamId, take data: PayloadSlice,
    fin: bool) -> Result[bool, QuicError] {
    let i = stream_slot(mut e, c)?
    let StreamId(id) = s
    let mut out: Result[bool, QuicError] = Error(UnknownConnection)
    if let Some(mut conn) = e.connections[i] {
        out = write_shared_in(mut conn.streams, id, take data, fin)
    }
    if let Ok(true) = out {
        enqueue_ready(mut e, i)
    }
    out
}

/// Copy contiguous bytes into into's spare capacity. After a reset, bytes below the
/// reliable size still arrive and then the read reports StreamReset.
fn read_in(mut st: Streams, id: u64, mut into: Bytes) -> Result[(u64, bool), QuicError] {
    let Some(i) = find(st, id) else {
        return Error(UnknownStream)
    }
    let window = st.stream_window
    let mut n = 0u64
    let mut fin = false
    let mut reset_code: Option[u64] = None
    if let Some(mut r) = st.list[i].recv {
        let mut end = contiguous(r)
        if let Some(x) = r.reset {
            end = order.min(end, order.max(x.reliable, r.read))
        }
        n = order.min(end - r.read, list.capacity(into) - list.len(into))
        let mut at = r.read
        while at < r.read + n {
            let p = (at - r.base) / PAGE
            let within = (at - r.base) % PAGE
            let k = order.min(PAGE - within, r.read + n - at)
            let page: u64 = int.widen(r.pages[p])
            list.append(mut into, list.slice(st.pool.data, page * PAGE + within, page * PAGE +
                within + k))
            at += k
        }
        r.read += n
        trim_runs_below(mut r.runs, r.read)
        release_pages(mut st.pool, mut r)
        match r.reset {
            Some(x) => {
                if n == 0 && r.read >= x.reliable {
                    reset_code = Some(x.code)
                }
            },
            None => {
                fin = r.final_size == Some(r.read)
                raise_stream_credit(window, mut r)
            },
        }
    } else {
        return Error(StreamState)
    }
    if n > 0 {
        release_data(mut st, n)
    }
    retire(mut st)
    if let Some(code) = reset_code {
        return Error(StreamReset(code))
    }
    Ok((n, fin))
}

pub fn read(mut e: Endpoint, c: ConnectionHandle, s: StreamId, mut into: Bytes) -> Result[(u64,
    bool), QuicError] {
    let i = stream_slot(mut e, c)?
    let StreamId(id) = s
    let mut out: Result[(u64, bool), QuicError] = Error(UnknownConnection)
    let mut wake = false
    if let Some(mut conn) = e.connections[i] {
        out = read_in(mut conn.streams, id, mut into)
        if let Ok(_) = out {
            wake = conn.streams.max_data_pending || conn.streams.bidi_limit_pending ||
                conn.streams.uni_limit_pending
            if !wake {
                if let Some(k) = find(conn.streams, id) {
                    if let Some(r) = conn.streams.list[k].recv {
                        wake = r.limit_pending
                    }
                }
            }
        }
    }
    if wake {
        enqueue_ready(mut e, i)
    }
    out
}

/// The largest offset received on a stream, read or not (WT-5).
pub fn received(e: Endpoint, c: ConnectionHandle, s: StreamId) -> u64 {
    let Some(i) = slot_at(e, c) else {
        return 0
    }
    let StreamId(id) = s
    if let Some(conn) = e.connections[i] {
        if let Some(k) = find(conn.streams, id) {
            if let Some(r) = conn.streams.list[k].recv {
                return r.highest
            }
        }
    }
    0
}

/// The final offset declared by a local reset. Queued bytes discarded by the reset
/// do not count toward that offset (WT-5).
pub fn reset_final_size(e: Endpoint, c: ConnectionHandle, s: StreamId) -> Option[u64] {
    let Some(i) = slot_at(e, c) else {
        return None
    }
    let StreamId(id) = s
    if let Some(conn) = e.connections[i] {
        if let Some(k) = find(conn.streams, id) {
            if let Some(tx) = conn.streams.list[k].send {
                if let Some(r) = tx.reset {
                    return Some(r.final_size)
                }
            }
        }
    }
    None
}

fn reset_in(mut st: Streams, id: u64, code: u64, reliable: u64) -> Result[(), QuicError] {
    let Some(i) = find(st, id) else {
        return Error(UnknownStream)
    }
    if code > MAX_NUMBER {
        return Error(Config)
    }
    if reliable > 0 && !st.reset_stream_at {
        return Error(Unsupported)
    }
    let mut freed = 0u64
    if let Some(mut s) = st.list[i].send {
        if s.acked_reported || reliable > s.written {
            return Error(StreamState)
        }
        if let Some(_) = s.reset {
            return Error(StreamState)
        }
        freed = reset_send(mut s, code, reliable)
    } else {
        return Error(StreamState)
    }
    st.held -= freed
    Ok(())
}

/// RESET_STREAM (reliable 0) or RESET_STREAM_AT, discarding at once every byte at or past
/// reliable, including any in a polled but uncommitted suffix (QUIC-5).
pub fn reset(mut e: Endpoint, c: ConnectionHandle, s: StreamId, code: u64, reliable: u64) -> Result[
    (), QuicError] {
    let i = stream_slot(mut e, c)?
    let StreamId(id) = s
    let mut out: Result[(), QuicError] = Error(UnknownConnection)
    if let Some(mut conn) = e.connections[i] {
        out = reset_in(mut conn.streams, id, code, reliable)
    }
    if let Ok(()) = out {
        enqueue_ready(mut e, i)
    }
    out
}

fn stop_in(mut st: Streams, id: u64, code: u64) -> Result[(), QuicError] {
    let Some(i) = find(st, id) else {
        return Error(UnknownStream)
    }
    if code > MAX_NUMBER {
        return Error(Config)
    }
    if let Some(mut r) = st.list[i].recv {
        if let None = r.stop {
            r.stop = Some(code)
            r.stop_pending = true
        }
        return Ok(())
    }
    Error(StreamState)
}

pub fn stop(mut e: Endpoint, c: ConnectionHandle, s: StreamId, code: u64) -> Result[(), QuicError] {
    let i = stream_slot(mut e, c)?
    let StreamId(id) = s
    let mut out: Result[(), QuicError] = Error(UnknownConnection)
    if let Some(mut conn) = e.connections[i] {
        out = stop_in(mut conn.streams, id, code)
    }
    if let Ok(()) = out {
        enqueue_ready(mut e, i)
    }
    out
}

pub fn priority(mut e: Endpoint, c: ConnectionHandle, s: StreamId, p: Priority) -> Result[(),
    QuicError] {
    let key = priority_key(p)?
    let i = stream_slot(mut e, c)?
    let StreamId(id) = s
    if let Some(mut conn) = e.connections[i] {
        let Some(k) = find(conn.streams, id) else {
            return Error(UnknownStream)
        }
        if let Some(mut send) = conn.streams.list[k].send {
            send.priority = key
            return Ok(())
        }
        return Error(StreamState)
    }
    Error(UnknownConnection)
}

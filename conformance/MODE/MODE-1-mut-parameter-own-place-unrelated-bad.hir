// rule: MODE-1
// expect: reject MODE-1 at line 11
// twin: MODE/MODE-1-mut-parameter-own-place-ok.hir
// A view of the relation's source may not be stored into a sibling `mut` parameter
// that has no relation.
type Node {
  keys: List[Bytes],
}

fn leak(n: Node, mut out: List[Bytes] in n, mut g: List[Bytes]) -> () uses {} {
  list.push(mut g, copy n.keys[0])
}

; A refused buffer allocation explicitly unwraps Capacity before anything owned is live.
; CoreIR sample, family: provider rows (CAP-5, core.md; crate docs "Providers"): `args`,
; `stdout` and `host` operations as closed `rt.*` rows, each `String` or `Bytes`
; operand passed as a pointer to its carrier, each waiting row a cancellation point
; with failure successors where owners are live. The evaluator's provider is its
; `World` model: an argument table from the run line, captured streams, flat
; directories keyed by (Dir handle, name).
;
; Source (package samples@0, module providers):
;   f0: fn echo(a: Args, out: Stdout, i: u64) -> (u64, u64) {
;         let w = match args.get(a, i) { Some(s) => stdout.write(out, s) .. written, None => 0 };
;         (args.len(a), w)
;       }
;   f1: fn files(d: Dir) {
;         let f = host.open(d, "log", CreateNew); host.write(mut f, "hi"); host.close(f);
;         let e = host.open(d, "log", CreateNew);          // Error(Exists)
;         let g = host.open(d, "log", Read);
;         let mut buf = list.with_capacity(8); let n = host.read(mut g, mut buf);
;         host.close(g); (e's error, n, buf[1], the first write's `written`)
;       }
;   f2: fn temp(d: Dir, n: u64) {
;         let mut name = String with capacity n;  let t = host.mkdtemp(d, mut name)?;
;         host.mkdir(t, "x"); (byte_len(name), host.mkdir(t, "x")'s error)
;       }
; Error numbers: 0 success, else IoError's case + 1 (NotFound 1, Denied 2, Exists 3).
; Open modes: Read 0, Write 1, Append 2, CreateNew 3. The literals are capacity-0
; carriers with nothing to clean, so their drops are omitted (decision 48).
;
; Behaviour, derived by hand.
; f0 writes argument i whole, so `written` is its length:
; run args prog hello: f0(0, 0, 1) -> 2, 5 | out hello
; run args prog hello: f0(0, 0, 2) -> 2, 0             ; past the end: None, nothing written
; run: f0(0, 0, 0) -> 0, 0
; f1: CreateNew of "log" makes it; writing "hi" writes 2; the second CreateNew is
; Exists (3); Read from the start fills 2 of buf's 8: buf[1] is 'i' (105). buf is
; charged 8 and freed at the end:
; run limit 1000: f1(7) -> 3, 2, 105, 2 | used 0
; run limit 4: f1(7) -> fail Unwrap | used 0
; f2: mkdtemp needs 32 spare bytes in the name (the run time's check), then appends
; the model's name "t0" (2 bytes); a second mkdir of "x" in the new directory is
; Exists. With 31 it fails with Bounds and the name's storage is freed by the
; failure successor:
; run limit 1000: f2(7, 40) -> 2, 3 | used 0
; run limit 1000: f2(7, 32) -> 2, 3 | used 0
; run limit 1000: f2(7, 31) -> fail Bounds | used 0
core v1
type t0 = own "String" { bytes: seq u8 }
static d0 = align 1 hex 6c6f67
static d1 = align 1 hex 6869
static d2 = align 1 hex 78
sig g0 = (u64, u64, u64) -> (u64, u64)
sig g1 = (u64) -> (u64)

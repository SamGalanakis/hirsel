pub fn table_identity[K, V](t: Table[K, V]) -> (StoreId, u32) {
    (t.store, t.id)
}

type ReadAccess {
    store: StoreId,
    opened: u64,
    check: fn(StoreId, u64, Snapshot) -> Result[(), Error] waits
}

type ReaderPool: send {
    requests: Sender[TieredPagerMessage],
    grant: Arc[TieredReaderGrant]
}

pub opaque resource type Reader: send {
    access: ReadAccess,
    pool: Option[ReaderPool]
} drop(owned_reader) {}

fn hot_read_access(id: StoreId, opened: u64, captured: Snapshot) -> Result[(), Error] {
    if !same(id, captured.store) || opened != captured.open {
        return Error(Foreign)
    }
    Ok(())
}

fn make_reader(id: StoreId, opened: u64, take pool: Option[ReaderPool]) -> Result[Reader, Error] {
    let access = ReadAccess(store: id, opened: opened, check: hot_read_access)
    match Reader(access: access, pool: take pool) {
        Ok(take opened_reader) => Ok(take opened_reader),
        Error((problem, _)) => Error(Full(Allocation(problem))),
    }
}

fn open_reader(id: StoreId, opened: u64, pager: Option[Sender[TieredPagerMessage]], pin_bytes: u64) -> Result[Reader, Error] waits {
    let pool: Option[ReaderPool] = match pager {
        Some(requests) => {
            let grant = pager_reader_grant(requests, pin_bytes)?
            Some(ReaderPool(requests: channel.sender(requests), grant: take grant))
        },
        None => None,
    }
    make_reader(id, opened, take pool)
}

pub fn reader(db: Db, pin_bytes: u64) -> Result[Reader, Error] waits {
    open_reader(db.store, open_number(db), db.pager, pin_bytes)
}

pub fn follower_reader(f: Follower, pin_bytes: u64) -> Result[Reader, Error] waits {
    open_reader(f.capture.store, f.open, f.pager, pin_bytes)
}

pub fn read_only_reader(source: ReadOnly, pin_bytes: u64) -> Result[Reader, Error] waits {
    open_reader(source.snapshot.store, source.snapshot.open, None, pin_bytes)
}

pub fn staged_reader(source: Preparation, pin_bytes: u64) -> Result[Reader, Error] waits {
    reader(source.db, pin_bytes)
}

fn read_access(r: Reader, s: Snapshot) -> Result[(), Error] waits {
    (r.access.check)(r.access.store, r.access.opened, s)
}

pub fn copy_env[E: inert](env: E) -> E {
    clone(env)
}

pub opaque type SpanRows: send {
    capture: Snapshot,
    low: Bytes,
    high: Bytes,
    cursor: Option[PageRange],
    last: Option[Bytes],
    done: bool
}

pub fn open_span_changes(r: Reader, s: Snapshot, lo: Bytes, hi: Bytes) -> Result[SpanRows, Error] waits {
    read_access(r, s)?
    disk_allocation(scoped fn() -> Result[SpanRows, Error] {
        let captured: Snapshot = clone(s)
        Ok(SpanRows(capture: take captured, low: copied(lo)?, high: copied(hi)?, cursor: None, last: None, done: hi <= lo))
    })
}

pub fn next_span_change(r: Reader, mut rows: SpanRows) -> Result[Option[Change], Error] waits {
    read_access(r, rows.capture)?
    if rows.done {
        return Ok(None)
    }
    let selected = if let Some(inventory) = view rows.capture.roots.collections.paging {
        snapshot_tiered_span_step(r, rows.capture, inventory, rows.low, rows.high, rows.last)?
    } else {
        memory_span_step(mut rows.cursor, rows.capture.roots.collections, rows.low, rows.high, rows.last)?
    }
    match take selected {
        Some((take key, take value, take resume)) => {
            rows.last = Some(take resume)
            Ok(Some(Change(tree_key: take key, value: Some(take value))))
        },
        None => {
            rows.done = true
            Ok(None)
        },
    }
}

fn memory_span_step(mut cursor: Option[PageRange], tree: PageTree, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] {
    // The allocation scope can only view its captures. The cell transfers the
    // cursor through the scope. A refusal discards it, so the next call resumes
    // after the last key actually returned.
    let exchange = disk_allocation(scoped fn() -> Result[core.Cell[Option[PageRange]], Error] {
        Ok(cell.new(None))
    })?
    cell.set(exchange, replace(mut cursor, None))
    let selected = disk_allocation(scoped fn() -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] {
        let mut walk = match cell.replace(exchange, None) {
            Some(take active) => take active,
            None => resume_data(tree, low, high, previous, false)?,
        }
        let found = next_bytes(mut walk)?
        let Some((take key, take value)) = take found else {
            return Ok(None)
        }
        let resume = copied(key)?
        cell.set(exchange, Some(take walk))
        Ok(Some((take key, take value, take resume)))
    })
    match take selected {
        Ok(take row) => {
            cursor = cell.into_inner(take exchange)
            Ok(take row)
        },
        Error(take problem) => Error(take problem),
    }
}

pub fn span_changes(r: Reader, s: Snapshot, lo: Bytes, hi: Bytes) -> Result[List[Change], Error] waits {
    read_access(r, s)?
    let mut out: List[Change] = list.new()
    if hi <= lo {
        return Ok(take out)
    }
    if let Some(inventory) = view s.roots.collections.paging {
        return snapshot_tiered_span(r, s, inventory, lo, hi)
    }
    let mut cursor = byte_cursor(s.roots.collections, Included(copied(lo)?), hi)?
    while let Some((take key, take value)) = next_bytes(mut cursor)? {
        list.push(mut out, Change(tree_key: take key, value: Some(take value)))
    }
    Ok(take out)
}

pub opaque type Rows[K, V]: send {
    capture: Snapshot,
    source: u32,
    cursor: Option[CollectionCursor],
    fault: Option[Error],
    low: Bytes,
    high: Bytes,
    last: Option[Bytes],
    reverse: bool,
    done: bool,
    decoder: RowDecoder[K, V]
}

fn table_decoder[K, V](t: Table[K, V]) -> RowDecoder[K, V] {
    RowDecoder(table: t.id, key: t.key, readers: arc.share(t.readers), unique: false, skip: None)
}

fn snapshot_pager(r: Reader, s: Snapshot, inventory: TieredReadInventory) -> Result[(TieredPageSource, Arc[TieredReaderGrant], TieredPinRoot), Error] {
    let Some(pool) = view r.pool else {
        return Error(Io(Closed))
    }
    let source = TieredPageSource(pager: channel.sender(pool.requests), packs: std.omap.snapshot(inventory.packs), next_stamp: inventory.next_stamp, deadline: 0)
    let root = TieredPinRoot(domain: s.open, branch: s.branch, generation: inventory.generation, root_stamp: tree_stamp(s.roots.collections))
    Ok((take source, arc.share(pool.grant), root))
}

fn snapshot_point[R](r: Reader, s: Snapshot, logical: Bytes, decode_row: scoped[view] fn(Option[View[Bytes]]) -> Result[R, Error]) -> Result[R, Error] waits {
    let tree = view s.roots.collections
    if let Some(inventory) = view tree.paging {
        if let Some((_, descriptor)) = std.page.collection_slot(tree.root, list.slice(logical, 0, 4)) {
            if collection_descriptor(descriptor).residency == ResidentTiered {
                let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
                return read_tiered_point(source, grant, root, tree, logical, decode_row)
            }
        }
    }
    decode_row(get_page_row(tree, logical))
}

pub fn get[K, V](r: Reader, s: Snapshot, t: Table[K, V], k: K) -> Result[Option[V], Error] waits {
    read_access(r, s)?
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let mut key = prefixed(t.id, 8, false)?
    std.codec.encode_key(t.key, k, mut key)
    snapshot_point(r, s, key, scoped fn(stored: Option[View[Bytes]]) -> Result[Option[V], Error] {
        match stored {
            Some(raw) => Ok(Some(row_value(t.readers, t.id, raw)?)),
            None => Ok(None),
        }
    })
}

pub fn count_at[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[u64, Error] waits {
    read_access(r, s)?
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let tree = view s.roots.collections
    if let Some(inventory) = view tree.paging {
        let id = prefix(t.id)?
        if let Some((edge, descriptor)) = std.page.collection_slot(tree.root, id) {
            let fields = collection_descriptor(descriptor)
            if fields.residency == ResidentTiered {
                if high <= low {
                    return Ok(0u64)
                }
                if low == id && list.slice(high, 0, 4) != id {
                    return Ok(fields.rows)
                }
                let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
                return read_tiered_count(source, grant, root, tree, edge, descriptor, id, low, high)
            }
        }
    }
    count_page_rows(s.roots.collections, t.id, low, high)
}

fn decode_row_key[K, V](r: RowDecoder[K, V], row_key: Bytes, raw: Bytes) -> Result[(K, Option[Bytes]), Error] {
    let mut at: u64 = 4
    if let Some(skip) = r.skip {
        match (skip)(row_key, mut at) {
            Ok(()) => {},
            Error(e) => return Error(Decode(e))
        }
    }
    let key = if r.unique {
        list.slice(raw, 4, unique_owner_end(raw)?)
    } else {
        list.slice(row_key, at, list.len(row_key))
    }
    let k = decoded(std.codec.decode_key(r.key, key))?
    let primary = if let Some(_) = r.skip {
        Some(logical_key(r.table, key)?)
    } else {
        None
    }
    Ok((take k, take primary))
}

fn advance_rows[K, V](r: RowDecoder[K, V], data: PageTree, row_key: Bytes, raw: Bytes, remaining: Option[u64], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[((K, V), u64)], Error] {
    let (take k, take owner) = decode_row_key(r, row_key, raw)?
    if let Some(primary) = view owner {
        match get_page_row(data, primary) {
            Some(value) => finish_row(r, take k, primary, value, remaining, seen),
            None => Error(Stale(r.table))
        }
    } else {
        finish_row(r, take k, row_key, raw, remaining, seen)
    }
}

fn finish_row[K, V](r: RowDecoder[K, V], take key: K, row_key: Bytes, raw: Bytes, remaining: Option[u64], seen: scoped[view] fn(Bytes) -> Result[(), Error]) -> Result[Option[((K, V), u64)], Error] {
    let size = list.len(row_key) + list.len(raw)
    if let Some(left) = remaining {
        if size > left {
            return Ok(None)
        }
    }
    let value = row_value(r.readers, r.table, raw)?
    seen(row_key)?
    Ok(Some(((take key, take value), size)))
}

fn open_scan[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K], reverse: bool) -> Result[Rows[K, V], Error] waits {
    read_access(r, s)?
    if !same(s.store, t.store) {
        return Error(Foreign)
    }
    readable(s.roots, t.catalog_key, t.catalog_page, t.id)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    open_snapshot_rows(s, t.id, take low, take high, reverse, table_decoder(t))
}

fn open_snapshot_rows[K, V](s: Snapshot, source: u32, take low: Bytes, take high: Bytes, reverse: bool, take decoder: RowDecoder[K, V]) -> Result[Rows[K, V], Error] {
    let captured: Snapshot = clone(s)
    let data = view s.roots.collections
    let tiered = if let Some(_) = data.paging {
        let source_tiered = collection_is_tiered(data, prefix(source)?)
        source_tiered || (source != decoder.table && collection_is_tiered(data, prefix(decoder.table)?))
    } else {
        false
    }
    let cursor: Option[CollectionCursor] = if tiered {
        None
    } else {
        collection_cursor(data, source, low, high, reverse)?
    }
    let done = if let None = cursor {
        !tiered
    } else {
        false
    }
    Ok(Rows(capture: take captured, source: source, cursor: take cursor, fault: None, low: take low, high: take high, last: None, reverse: reverse, done: done, decoder: take decoder))
}

fn collection_is_tiered(data: PageTree, key: Bytes) -> bool {
    match std.page.lookup(data.root, key) {
        Some(descriptor) => collection_descriptor(descriptor).residency == ResidentTiered,
        None => false,
    }
}

pub fn scan[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] waits {
    open_scan(r, s, t, lo, hi, false)
}

pub fn scan_reverse[K, V](r: Reader, s: Snapshot, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[Rows[K, V], Error] waits {
    open_scan(r, s, t, lo, hi, true)
}

pub fn find[J, K, V, P](r: Reader, s: Snapshot, ix: Index[J, K, V, P], lo: Bound[J], hi: Bound[J]) -> Result[Rows[K, V], Error] waits {
    read_access(r, s)?
    if !same(s.store, ix.store) {
        return Error(Foreign)
    }
    index_readable(s.roots, ix.catalog_key, ix.catalog_page, ix.id, ix.public)?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    open_snapshot_rows(s, ix.id, take low, take high, false, index_decoder(ix))
}

fn resume_data(data: PageTree, low: Bytes, high: Bytes, final_item: Option[Bytes], reverse: bool) -> Result[PageRange, Error] {
    if reverse {
        return match final_item {
            Some(previous) => reverse_byte_cursor(data, low, previous),
            None => reverse_byte_cursor(data, low, high),
        }
    }
    let start = match final_item {
        Some(previous) => Excluded(copied(previous)?),
        None => Included(copied(low)?),
    }
    byte_cursor(data, take start, high)
}

fn snapshot_scan_step[K, V](r: Reader, rows: Rows[K, V], tree: PageTree, inventory: TieredReadInventory, edge: std.page.Slot, descriptor: Bytes) -> Result[Option[(Bytes, (K, V))], Error] waits {
    let mut start = copied(rows.low)?
    let mut stop = copied(rows.high)?
    if let Some(previous) = view rows.last {
        if rows.reverse {
            stop = copied(previous)?
        } else {
            start = copied(previous)?
            list.push(mut start, 0u8)
        }
    }
    let (take source, take grant, root) = snapshot_pager(r, rows.capture, inventory)?
    read_tiered_scan(source, grant, root, tree, edge, descriptor, rows.source, take start, take stop, rows.reverse, rows.decoder)
}

fn decode_snapshot_next[K, V](r: Reader, s: Snapshot, decoder: RowDecoder[K, V], key: Bytes, raw: Bytes) -> Result[(K, V), Error] waits {
    let (take row_key, take owner) = decode_row_key(decoder, key, raw)?
    let value = if let Some(primary) = view owner {
        snapshot_point(r, s, primary, scoped fn(stored: Option[View[Bytes]]) -> Result[V, Error] {
            let Some(row) = stored else {
                return Error(Stale(decoder.table))
            }
            row_value(decoder.readers, decoder.table, row)
        })?
    } else {
        row_value(decoder.readers, decoder.table, raw)?
    }
    Ok((take row_key, take value))
}

pub fn next[K, V](r: Reader, mut rows: Rows[K, V]) -> Result[Option[(K, V)], Error] waits {
    read_access(r, rows.capture)?
    if rows.done {
        return Ok(None)
    }
    if let Some(problem) = rows.fault {
        return Error(clone(problem))
    }
    if let Some(mut cursor) = rows.cursor {
        let found = next_memory_snapshot(mut cursor.walk, cursor.leading, rows.decoder, rows.capture.roots.collections)
        match take found {
            Some(Ok(take row)) => return Ok(Some(take row)),
            Some(Error(take problem)) => {
                // An immutable snapshot would decode the same row again.
                rows.fault = Some(clone(problem))
                return Error(take problem)
            },
            None => {
                rows.done = true
                return Ok(None)
            },
        }
    }
    let selected = {
        let data = view rows.capture.roots.collections
        if let Some(inventory) = view data.paging {
            if let Some((edge, descriptor)) = std.page.collection_slot(data.root, prefix(rows.source)?) {
                if collection_descriptor(descriptor).residency == ResidentTiered {
                    let Some((take key, take result)) = snapshot_scan_step(r, rows, data, inventory, edge, descriptor)? else {
                        rows.done = true
                        return Ok(None)
                    }
                    rows.last = Some(take key)
                    return Ok(Some(take result))
                }
            }
        }
        let mut cursor = resume_data(data, rows.low, rows.high, rows.last, rows.reverse)?
        let Some((take key, raw)) = next_bytes(mut cursor)? else {
            rows.done = true
            return Ok(None)
        }
        let result = decode_snapshot_next(r, rows.capture, rows.decoder, key, raw)?
        (take key, take result)
    }
    let (take key, take result) = take selected
    rows.last = Some(take key)
    Ok(Some(take result))
}

fn next_memory_snapshot[K, V](mut walk: std.page.Cursor, leading: Bytes, decoder: RowDecoder[K, V], data: PageTree) -> Option[Result[(K, V), Error]] {
    std.page.cursor_read(mut walk, scoped fn(suffix: Bytes, raw: Bytes) -> Result[(K, V), Error] {
        if let None = decoder.skip {
            return decode_table_row(decoder, suffix, raw)
        }
        let key = collection_row_key(leading, suffix)
        let (take row_key, take owner) = decode_row_key(decoder, key, raw)?
        let value = if let Some(primary) = view owner {
            let Some(stored) = get_page_row(data, primary) else {
                return Error(Stale(decoder.table))
            }
            row_value(decoder.readers, decoder.table, stored)?
        } else {
            row_value(decoder.readers, decoder.table, raw)?
        }
        Ok((take row_key, take value))
    })
}

fn decode_table_row[K, V](decoder: RowDecoder[K, V], suffix: Bytes, raw: Bytes) -> Result[(K, V), Error] {
    let key = decoded(std.codec.decode_key(decoder.key, suffix))?
    Ok((take key, row_value(decoder.readers, decoder.table, raw)?))
}

fn scan_raw(s: Snapshot, id: u32, lo: Bound[Bytes], hi: Bound[Bytes]) -> Result[PageRange, Error] {
    byte_cursor(s.roots.collections, Included(lower_bytes(id, lo, false)?), lower_bytes(id, hi, true)?)
}

pub fn range[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[TxRows[K, V], Error] in tx {
    open_range(tx, t, lo, hi, false)
}

pub fn range_reverse[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[TxRows[K, V], Error] in tx {
    open_range(tx, t, lo, hi, true)
}

fn check_table_read[K, V](tx: Tx, t: Table[K, V]) -> Result[(), Error] {
    if !same(tx.store, t.store) {
        return Error(Foreign)
    }
    readable(tx.roots, t.catalog_key, t.catalog_page, t.id)
}

fn open_range[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K], reverse: bool) -> Result[TxRows[K, V], Error] in tx {
    check_table_read(tx, t)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    open_range_bounds(tx, t, take low, take high, reverse)
}

pub fn range_prefix[K, V, Q](tx: Tx, t: Table[K, V], q: Q, take key: std.codec.Key[Q]) -> Result[TxRows[K, V], Error] in tx {
    check_table_read(tx, t)?
    let (take low, take high) = prefix_limits(t.id, t.key, key, q)?
    open_range_bounds(tx, t, take low, take high, false)
}

pub fn count[K, V](tx: Tx, t: Table[K, V], lo: Bound[K], hi: Bound[K]) -> Result[u64, Error] {
    check_table_read(tx, t)?
    let low = lower_bytes(t.id, typed_bound(t.key, lo)?, false)?
    let high = lower_bytes(t.id, typed_bound(t.key, hi)?, true)?
    let n = if tx_tiered_descriptor(tx, t.id)? {
        tx_tiered_count(tx, t.id, low, high)?
    } else {
        let data = transaction_collection_pages(tx)?
        count_page_rows(data, t.id, low, high)?
    }
    note_read(tx, Span(take low, take high))?
    Ok(n)
}

fn open_range_bounds[K, V](tx: Tx, t: Table[K, V], take low: Bytes, take high: Bytes, reverse: bool) -> Result[TxRows[K, V], Error] in tx {
    let tree = transaction_collection_pages(tx)?
    let tiered = tx_tiered_rows(tx, t.id, low, high, true)?
    let cursor: Option[CollectionCursor] = if let Some(_) = tiered {
        None
    } else {
        collection_cursor(tree, t.id, low, high, reverse)?
    }
    Ok(TxRows(cursor: take cursor, decoder: table_decoder(t), owner: tx.info.id, depth: tx.own, reads: tx.reads, low: take low, high: take high, reverse: reverse, log_tail: None, tiered: take tiered))
}

pub opaque scoped type TxRows[K, V] {
    cursor: Option[CollectionCursor],
    decoder: RowDecoder[K, V],
    owner: CallId,
    depth: u64,
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    reverse: bool,
    log_tail: Option[LogRangeTail],
    tiered: Option[TxTieredRows]
}

// Before decoding an attempted row, record it and the gap traversed to find it.
// Exhaustion records the remainder once. An unused cursor observes no keys.
pub fn next_in[K, V](tx: Tx, mut r: TxRows[K, V]) -> Result[Option[(K, V)], Error] {
    if !same(tx.store, r.owner.store) || tx.info.id.branch != r.owner.branch || tx.info.id.version != r.owner.version || tx.own != r.depth {
        return Error(Foreign)
    }
    if let Some(mut cursor) = r.cursor {
        let found = next_tx_page(mut cursor.walk, cursor.leading, r.decoder, r.reads, r.low, r.high, r.reverse)
        if let Some(take row) = take found {
            let (take boundary, take decoded_row) = take row
            if r.reverse {
                r.high = take boundary
            } else {
                r.low = take boundary
            }
            return Ok(Some(decoded_row?))
        }
    }
    let mut found = match r.tiered {
        Some(mut tiered) => next_tiered_in(tx, mut tiered, r.reverse)?,
        None => None,
    }
    if let None = found {
        if let Some(mut tail) = r.log_tail {
            found = next_log_range_tail(tx, mut tail)?
        }
    }
    match take found {
        Some((key, raw)) => {
            note_tx_row(r.reads, mut r.low, mut r.high, r.reverse, key)?
            Ok(Some(decode_table_row(r.decoder, list.slice(key, 4, list.len(key)), raw)?))
        },
        None => {
            if r.low < r.high {
                let low = replace(mut r.low, list.new())
                let high = replace(mut r.high, list.new())
                log.append(r.reads, Span(take low, take high))
            }
            Ok(None)
        },
    }
}

fn next_tx_page[K, V](mut walk: std.page.Cursor, leading: Bytes, decoder: RowDecoder[K, V], reads: View[core.Log[Read]], low: Bytes, high: Bytes, reverse: bool) -> Option[(Bytes, Result[(K, V), Error])] {
    std.page.cursor_read(mut walk, scoped fn(suffix: Bytes, raw: Bytes) -> (Bytes, Result[(K, V), Error]) {
        let mut key = collection_row_key(leading, suffix)
        if reverse {
            log.append(reads, Span(clone(key), clone(high)))
        } else {
            list.push(mut key, 0u8)
            log.append(reads, Span(clone(low), clone(key)))
        }
        (take key, decode_table_row(decoder, suffix, raw))
    })
}

fn note_tx_row(reads: View[core.Log[Read]], mut low: Bytes, mut high: Bytes, reverse: bool, key: Bytes) -> Result[(), Error] {
    if reverse {
        let new_high = copied(key)?
        let end = replace(mut high, take new_high)
        log.append(reads, Span(copied(key)?, take end))
    } else {
        let mut end = scan_page_after(key)?
        let start = replace(mut low, copied(end)?)
        log.append(reads, Span(take start, take end))
    }
    Ok(())
}

// RUNNER-SPEC §4 (R2): a Cover names data-tree key ranges (I1) without reading them. `key_span`
// gives the Span a fully consumed range over the same bounds covers.
fn prefix_limits[K, Q](id: u32, full: std.codec.Key[K], leading: std.codec.Key[Q], q: Q) -> Result[(Bytes, Bytes), Error] {
    let matches = std.key_prefix.matches(full, leading) ?=> |_| Schema(0)
    if !matches {
        return Error(Schema(0))
    }
    let low = logical_key(id, encode_key(leading, q)?)?
    let high = prefix_after(low)?
    Ok((take low, take high))
}

pub scoped type IndexRows[K, V] {
    rows: PageRows[K, V],
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    tiered: Option[TxIndexTiered]
}

pub opaque scoped type IndexEntries[J, K, P] {
    cursor: PageRange,
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    id: u32,
    kind: IndexKind,
    key: std.codec.Key[J],
    primary: std.codec.Key[K],
    payload: Option[Arc[Readers[P]]],
    payload_codec: std.codec.Codec[P]
}

/// The key codec of the index's table. Rows rank in the order of the bytes
/// it writes, which is the order a package breaks ties in.
pub fn primary_key[J, K, V, P](ix: Index[J, K, V, P]) -> std.codec.Key[K] {
    ix.primary
}

fn check_index_read[J, K, V, P](tx: Tx, ix: Index[J, K, V, P]) -> Result[(), Error] {
    if !same(tx.store, ix.store) {
        return Error(Foreign)
    }
    index_readable(tx.roots, ix.catalog_key, ix.catalog_page, ix.id, ix.public)
}

pub fn lookup[J, K, V, P](tx: Tx, ix: Index[J, K, V, P], lo: Bound[J], hi: Bound[J]) -> Result[IndexRows[K, V], Error] in tx {
    check_index_read(tx, ix)?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    open_lookup(tx, ix, take low, take high)
}

pub fn lookup_prefix[J, K, V, P, Q](tx: Tx, ix: Index[J, K, V, P], q: Q, take key: std.codec.Key[Q]) -> Result[IndexRows[K, V], Error] in tx {
    check_index_read(tx, ix)?
    let (take low, take high) = prefix_limits(ix.id, ix.key, key, q)?
    open_lookup(tx, ix, take low, take high)
}

fn open_lookup[J, K, V, P](tx: Tx, ix: Index[J, K, V, P], take low: Bytes, take high: Bytes) -> Result[IndexRows[K, V], Error] in tx {
    let tree = transaction_collection_pages(tx)?
    let cursor = collection_cursor(tree, ix.id, low, high, false)?
    let rows = PageRows(cursor: take cursor, data: take tree, decoder: index_decoder(ix))
    Ok(IndexRows(rows: take rows, reads: tx.reads, low: take low, high: take high, tiered: tx_index_tiered(tx)?))
}

pub fn entries[J, K, V, P](tx: Tx, ix: Index[J, K, V, P], lo: Bound[J], hi: Bound[J]) -> Result[IndexEntries[J, K, P], Error] in tx {
    check_index_read(tx, ix)?
    let low = index_bound(ix.id, ix.key, lo, false)?
    let high = index_bound(ix.id, ix.key, hi, true)?
    let tree = transaction_collection_pages(tx)?
    let cursor = byte_cursor(tree, Included(copied(low)?), high)?
    Ok(IndexEntries(cursor: take cursor, reads: tx.reads, low: take low, high: take high, id: ix.id, kind: ix.kind, key: ix.key, primary: ix.primary, payload: clone(ix.payload), payload_codec: ix.payload_codec))
}

fn note_index_step(reads: View[core.Log[Read]], mut low: Bytes, high: Bytes, last_key: Option[View[Bytes]]) -> Result[(), Error] {
    if low >= high {
        return Ok(())
    }
    let end = match last_key {
        Some(key) => {
            let mut after = copied(key)?
            list.push(mut after, 0u8)
            take after
        },
        None => copied(high)?,
    }
    let start = replace(mut low, copied(end)?)
    log.append(reads, Span(take start, take end))
    Ok(())
}

pub fn next_indexed[K, V](mut r: IndexRows[K, V]) -> Result[Option[(K, V)], Error] {
    if let Some(mut cursor) = r.rows.cursor {
        let stepped = next_index_page(mut cursor.walk, cursor.leading, r.rows.decoder, r.rows.data, r.tiered, r.reads, r.low, r.high)
        if let Some(take step) = take stepped {
            let (take boundary, take value) = step?
            r.low = take boundary
            return take value
        }
    }
    note_index_step(r.reads, mut r.low, r.high, None)?
    Ok(None)
}

fn next_index_page[K, V](mut walk: std.page.Cursor, leading: Bytes, decoder: RowDecoder[K, V], data: PageTree, tiered: Option[TxIndexTiered], reads: View[core.Log[Read]], low: Bytes, high: Bytes) -> Option[Result[(Bytes, Result[Option[(K, V)], Error]), Error]] {
    std.page.cursor_read(mut walk, scoped fn(suffix: Bytes, raw: Bytes) -> Result[(Bytes, Result[Option[(K, V)], Error]), Error] {
        let key = collection_row_key(leading, suffix)
        let mut boundary: Bytes = clone(low)
        note_index_step(reads, mut boundary, high, Some(view key))?
        let seen: scoped[view] fn(Bytes) -> Result[(), Error] = scoped fn(observed: Bytes) -> Result[(), Error] {
            log.append(reads, Point(copied(observed)?))
            Ok(())
        }
        let row = match tiered {
            Some(attempt) => tx_tiered_index_row(attempt, decoder, data, key, raw, seen),
            None => advance_rows(decoder, data, key, raw, None, seen),
        }
        let value: Result[Option[(K, V)], Error] = match take row {
            Ok(Some((take found, _))) => Ok(Some(take found)),
            Ok(None) => Ok(None),
            Error(take problem) => Error(take problem),
        }
        Ok((take boundary, take value))
    })
}

pub fn next_entry[J, K, P](mut r: IndexEntries[J, K, P]) -> Result[Option[(J, K, P)], Error] {
    let Some((take key, take raw)) = next_bytes(mut r.cursor)? else {
        note_index_step(r.reads, mut r.low, r.high, None)?
        return Ok(None)
    }
    note_index_step(r.reads, mut r.low, r.high, Some(view key))?
    let mut at = 4u64
    let j = decoded(std.codec.take_key_with(key, mut at, r.key))?
    let payload_start = if let Unique = r.kind {
        if at != list.len(key) {
            return Error(malformed(at))
        }
        unique_owner_end(raw)?
    } else {
        0u64
    }
    let primary = if let Unique = r.kind {
        list.slice(raw, 4, payload_start)
    } else {
        list.slice(key, at, list.len(key))
    }
    let k = decoded(std.codec.decode_key(r.primary, primary))?
    let payload = list.slice(raw, payload_start, list.len(raw))
    let value = match r.payload {
        Some(registered) => row_value(registered, r.id, payload)?,
        None => decoded(std.codec.decode(r.payload_codec, payload))?,
    }
    Ok(Some((take j, take k, take value)))
}

pub opaque scoped type I8Entries[K] {
    cursor: Option[CollectionCursor],
    reads: View[core.Log[Read]],
    low: Bytes,
    high: Bytes,
    decoder: I8EntryDecoder[K]
}

type I8EntryDecoder[K] {
    id: u32,
    primary: std.codec.Key[K],
    deferred_key: bool,
    schema: u16
}

/// Borrow the current List[i8] encoding of an unbounded Many index on ().
/// An index with other codecs or an older payload reader uses entries instead.
pub fn i8_entries[K, V](tx: Tx, ix: Index[(), K, V, List[i8]]) -> Result[Option[I8Entries[K]], Error] in tx {
    check_index_read(tx, ix)?
    let Some(payload) = view ix.payload else {
        return Ok(None)
    }
    let unit: std.codec.Key[()] = std.codec.key_of()
    let Some(unit_revision) = std.codec.key_revision(unit) else {
        return Ok(None)
    }
    let codes: std.codec.Codec[List[i8]] = std.codec.of_list()
    let Some(code_revision) = std.codec.revision(codes) else {
        return Ok(None)
    }
    if ix.kind != Many || list.len(payload.older) != 1 || std.codec.key_revision(ix.key) != Some(take unit_revision) || std.codec.revision(payload.codec) != Some(take code_revision) {
        return Ok(None)
    }
    let deferred_key = if let Some(take numeric) = std.codec.key_revision(std.codec.key_u64()) {
        std.codec.key_revision(ix.primary) == Some(take numeric)
    } else {
        false
    }
    let low = prefix(ix.id)?
    let high = prefix(ix.id + 1)?
    let tree = transaction_collection_pages(tx)?
    let cursor = collection_cursor(tree, ix.id, low, high, false)?
    let decoder = I8EntryDecoder(id: ix.id, primary: ix.primary, deferred_key: deferred_key, schema: payload.current)
    Ok(Some(I8Entries(cursor: take cursor, reads: tx.reads, low: take low, high: take high, decoder: decoder)))
}

/// Visit a code in place. A custom key decoder runs before the payload is
/// examined. For the built-in u64 codec the validated eight bytes suffice
/// until the visitor needs the key.
pub fn next_i8_entry[K, T](mut r: I8Entries[K], visit: scoped[view] fn(take Option[K], Bytes, Bytes) -> T) -> Result[Option[T], Error] {
    if let Some(mut cursor) = r.cursor {
        let step = next_i8_page(mut cursor.walk, cursor.leading, r.decoder, r.reads, r.low, r.high, visit)
        if let Some(take advanced) = take step {
            let (take boundary, take value) = advanced?
            r.low = take boundary
            return Ok(Some(value?))
        }
    }
    note_index_step(r.reads, mut r.low, r.high, None)?
    Ok(None)
}

fn next_i8_page[K, T](mut walk: std.page.Cursor, leading: Bytes, decoder: I8EntryDecoder[K], reads: View[core.Log[Read]], low: Bytes, high: Bytes, visit: scoped[view] fn(take Option[K], Bytes, Bytes) -> T) -> Option[Result[(Bytes, Result[T, Error]), Error]] {
    std.page.cursor_read(mut walk, scoped fn(key: Bytes, raw: Bytes) -> Result[(Bytes, Result[T, Error]), Error] {
        let full_key = collection_row_key(leading, key)
        let mut boundary: Bytes = clone(low)
        note_index_step(reads, mut boundary, high, Some(view full_key))?
        let value: Result[T, Error] = visit_i8_code(decoder, key, raw, visit)
        Ok((take boundary, take value))
    })
}

fn visit_i8_code[K, T](r: I8EntryDecoder[K], key: Bytes, raw: Bytes, visit: scoped[view] fn(take Option[K], Bytes, Bytes) -> T) -> Result[T, Error] {
    let width = list.len(key)
    let primary: Option[K] = if r.deferred_key {
        if width < 8 {
            return Error(Decode(Truncated(0)))
        }
        if width > 8 {
            return Error(Decode(Trailing(8)))
        }
        None
    } else {
        Some(decoded(std.codec.decode_key(r.primary, key))?)
    }
    let mut at = 0u64
    let schema = decoded(std.codec.take_u16(raw, mut at))?
    if schema != r.schema {
        return Error(Stale(r.id))
    }
    let length = decoded(std.codec.take_count(raw, mut at, 1))?
    if at + length != list.len(raw) {
        return Error(Decode(Trailing(at + length)))
    }
    Ok(visit(take primary, key, list.slice(raw, at, at + length)))
}

/// The main-branch snapshot recovered by a read-only open.
pub opaque type ReadOnly: shareable + send {
    snapshot: Snapshot
}

pub fn read_only_table[K, V](read_source: ReadOnly, take name: String, take key: std.codec.Key[K], take value: std.codec.Codec[V]) -> Result[Table[K, V], Error] {
    let s = view read_source.snapshot
    let handle = catalog_handle(s.store, s.roots.catalog, take name, take key, take value)?
    Ok(clone(handle))
}

pub fn read_only_get[K, V](read_source: ReadOnly, t: Table[K, V], key: K) -> Result[Option[V], Error] waits {
    get(read_only_reader(read_source, 0)?, read_source.snapshot, t, key)
}

pub fn read_only_snapshot(read_source: ReadOnly) -> Snapshot {
    Snapshot(store: read_source.snapshot.store, open: read_source.snapshot.open, branch: read_source.snapshot.branch, head: read_source.snapshot.head, roots: share_roots(read_source.snapshot.roots), watermark: read_source.snapshot.watermark, bases: share_tail_bases(read_source.snapshot.bases))
}

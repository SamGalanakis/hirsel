// Module local (package store): the host's request API. Each call asks the host task
// through its inbox and waits for the answer; `local` starts the task (local.hirsel).

// What a host spends: its places' budget, its catalog store, the store a create seeds
// and its own task.
pub fn host_bytes(options: store.Options, place_bytes: u64) -> u64 {
    let stores = int.saturating_add(runner.disk_store_bytes(options), runner.disk_store_bytes(options))
    int.saturating_add(place_bytes, int.saturating_add(stores, LOCAL_BYTES))
}

pub fn doorway() -> Doorway {
    let (to, inbox): (Sender[In], Receiver[In]) = channel.new(256u64)
    Doorway(to: take to, inbox: take inbox)
}

pub fn door_of(w: Doorway) -> Door { Door(to: channel.sender(w.to)) }

pub fn local[T: send](take way: Doorway, take config: Config[T]) -> Result[Local, Refused] waits {
    if config.max_places == 0u64 || config.idle_ms == 0u64 || config.place_bytes == 0u64 || config.sessions == 0u64 { return Error(Full) }
    let tasks = config.tasks
    let need = host_bytes(config.options, config.place_bytes)
    let Doorway(to: take to, inbox: take inbox) = take way
    let (ready, started): (Sender[Result[(), Refused]], Receiver[Result[(), Refused]]) = channel.new(1u64)
    let begin = Begin(config: take config, inbox: take inbox, me: channel.sender(to), ready: take ready)
    let run: fn(take Begin[T]) -> () waits = run_local
    let actor = match task.try_spawn(tasks, bytes need, take begin, run) {
        Ok(take spawned) => take spawned,
        Error(_) => return Error(Full),
    }
    match channel.receive(started) {
        Ok(Ok(())) => Ok(Local(to: take to, actor: take actor)),
        Ok(Error(take why)) => { let _ = task.join(take actor); Error(take why) },
        Error(_) => { let _ = task.join(take actor); Error(Stopping) },
    }
}

pub fn door(l: Local) -> Door { Door(to: channel.sender(l.to)) }

pub fn copy_door(d: Door) -> Door { Door(to: channel.sender(d.to)) }

pub fn status(l: Lease) -> Latest[runner.Status] { latest.handle(l.status) }

fn ask[A: send](d: Door, take m: In, answer: Receiver[A], take stopped: A) -> A waits {
    if let Error(_) = channel.send(d.to, take m) { return take stopped }
    match channel.receive(answer) { Ok(take answered) => take answered, Error(_) => take stopped }
}

// Creates the session `key` names, or finds it: a new one's store is migrated and seeded
// before its group is added, and its id is the one its commit takes.
pub fn create(d: Door, take key: Bytes, take seed: Seed) -> Result[u64, Refused] waits {
    let (reply, answer): (Sender[Result[u64, Refused]], Receiver[Result[u64, Refused]]) = channel.new(1u64)
    ask(d, Create(take key, take seed, take reply), answer, Error(Stopping))
}

// Unlists a session and removes its group, and answers once its child, if any, has
// drained and its store is deleted.
pub fn delete(d: Door, id: u64) -> Result[(), Refused] waits {
    let (reply, answer): (Sender[Result[(), Refused]], Receiver[Result[(), Refused]]) = channel.new(1u64)
    ask(d, Delete(id, take reply), answer, Error(Stopping))
}

pub fn listing(d: Door) -> List[u64] waits {
    let (reply, answer): (Sender[List[u64]], Receiver[List[u64]]) = channel.new(1u64)
    ask(d, Listing(take reply), answer, list.new())
}

// Wakes a session if it is unloaded and answers a lease on its Ready child.
pub fn route(d: Door, id: u64) -> Result[Lease, Refused] waits {
    let (reply, answer): (AccessReply, Receiver[Result[Option[Lease], Refused]]) = channel.new(1u64)
    match ask(d, Route(id, take reply), answer, Error(Stopping)) {
        Ok(take lease) => Ok(option.unwrap(take lease)),
        Error(take why) => Error(take why),
    }
}

// A running child returns a lease for the caller's live authorization. For a
// cold child, check its durable state before optionally starting it. None
// acknowledges an allowed cold read that did not request a wake.
pub fn access(d: Door, id: u64, take check: ColdCheck, wake: bool) -> Result[Option[Lease], Refused] waits {
    let (reply, answer): (AccessReply, Receiver[Result[Option[Lease], Refused]]) = channel.new(1u64)
    ask(d, Access(id, take check, wake, take reply), answer, Error(Stopping))
}

// A lease on the session's child only if it is Ready now; it never starts one (`Busy`).
pub fn peek(d: Door, id: u64) -> Result[Lease, Refused] waits {
    let (reply, answer): (Sender[Result[Lease, Refused]], Receiver[Result[Lease, Refused]]) = channel.new(1u64)
    ask(d, Peek(id, take reply), answer, Error(Stopping))
}

// Drains the session's live child now, as an operator would, and answers how it ended.
pub fn unload(d: Door, id: u64) -> Result[Unloaded, Refused] waits {
    let (reply, answer): (Sender[Result[Unloaded, Refused]], Receiver[Result[Unloaded, Refused]]) = channel.new(1u64)
    ask(d, Unload(id, take reply), answer, Error(Stopping))
}

// Tells the host that a front changed a session, so streams that follow it look again.
pub fn nudge(d: Door, id: u64) -> () waits { let _ = channel.send(d.to, Nudge(id)) }

pub fn marks(d: Door, id: u64) -> Marks waits {
    let (reply, answer): (Sender[Marks], Receiver[Marks]) = channel.new(1u64)
    ask(d, Marked(id, take reply), answer, Marks(ups: 0u64, downs: 0u64, nudges: 0u64))
}

// The caller registers before sampling marks. A queued notification is enough
// because marks contain the cumulative counts.
pub fn watch_marks(d: Door, id: u64, notify: Sender[()]) -> Option[u64] waits {
    let (reply, answer): (Sender[u64], Receiver[u64]) = channel.new(1u64)
    if let Error(_) = channel.send(d.to, WatchMarks(id, channel.sender(notify), take reply)) { return None }
    match channel.receive(answer) { Ok(token) => Some(token), Error(_) => None }
}

pub fn unwatch_marks(d: Door, id: u64, token: u64) -> () waits { let _ = channel.send(d.to, UnwatchMarks(id, token)) }

// Waits until the session's child has ended more than `after` times, and answers how many.
pub fn await_down(d: Door, id: u64, after: u64) -> Result[u64, Refused] waits {
    let (reply, answer): (Downs, Receiver[Result[u64, Refused]]) = channel.new(1u64)
    ask(d, AwaitDown(id, after, take reply), answer, Error(Stopping))
}

// Runs `r` over the session's committed store once no child of it is live, and answers
// what it read.
pub fn read_cold(d: Door, id: u64, take r: ColdRead) -> Result[Bytes, Refused] waits {
    let (reply, answer): (ReadReply, Receiver[Result[Bytes, Refused]]) = channel.new(1u64)
    ask(d, Read(id, take r, take reply), answer, Error(Stopping))
}

// Drains every live child through its graceful stop, applies each end to the host's
// catalog and returns how each ended.
pub fn stop(take l: Local) -> List[Unloaded] waits {
    let Local(to: take to, actor: take actor) = take l
    let (reply, answer): (Sender[List[Unloaded]], Receiver[List[Unloaded]]) = channel.new(1u64)
    let _ = channel.send(to, Halt(take reply))
    let ended = match channel.receive(answer) { Ok(take done) => take done, Error(_) => list.new() }
    let _ = task.join(take actor)
    take ended
}

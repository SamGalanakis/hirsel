fn challenge() -> Bytes {
    b"dGhlIHNhbXBsZSBub25jZQ=="
}

fn request_bytes() -> Bytes {
    b"GET /hirsel HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Protocol: hirsel.3\r\n\r\n"
}

fn response_bytes() -> Bytes {
    b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
}

fn status(b: Bytes) -> u16 {
    match websocket.server(b) {
        Waiting => 0,
        Upgraded(_, _, _) => 101,
        Refused(s) => s
    }
}

fn client_status(b: Bytes, offered: bool) -> u16 {
    match websocket.client(b, challenge(), offered) {
        Pending => 0,
        Ready(_, _) => 101,
        Failed(s) => s
    }
}

fn request_with(method: String, path: String, connection: String, upgrade: String, version: String, key: String, extra: String) -> Bytes {
    let mut b: Bytes = list.new()
    list.append(mut b, string.as_bytes(method))
    list.append(mut b, string.as_bytes(" "))
    list.append(mut b, string.as_bytes(path))
    list.append(mut b, string.as_bytes(" HTTP/1.1\r\nHost: example.com\r\nConnection: "))
    list.append(mut b, string.as_bytes(connection))
    list.append(mut b, string.as_bytes("\r\nUpgrade: "))
    list.append(mut b, string.as_bytes(upgrade))
    list.append(mut b, string.as_bytes("\r\nSec-WebSocket-Version: "))
    list.append(mut b, string.as_bytes(version))
    list.append(mut b, string.as_bytes("\r\nSec-WebSocket-Key: "))
    list.append(mut b, string.as_bytes(key))
    list.append(mut b, string.as_bytes("\r\n"))
    list.append(mut b, string.as_bytes(extra))
    list.append(mut b, string.as_bytes("\r\n"))
    take b
}

// RFC 6455 section 1.3 and tungstenite handshake/mod.rs:143.
// Mutant: guid_typo.
// expect: run rfc6455_accept() = true
fn rfc6455_accept() -> bool {
    websocket.accept(challenge()) == b"s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
}

// The response bytes are derived from RFC 6455, not from another encode.
// Mutant: drop_accept_header.
// expect: run server_response() = true
fn server_response() -> bool {
    let b = request_bytes()
    match websocket.server(b) {
        Upgraded(end, Current, out) => end == list.len(b) &&
            out == b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: hirsel.3\r\n\r\n",
        _ => false
    }
}

// Mutants: skip_method, skip_upgrade, accept_wrong_version, accept_bad_key.
// expect: run upgrade_checks() = true
fn upgrade_checks() -> bool {
    status(request_with("POST", "/hirsel", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", "")) == 400 && status(request_with("GET", "/else", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", "")) == 404 && status(request_with("GET", "/hirsel", "notupgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", "")) == 400 && status(request_with("GET", "/hirsel", "Upgrade", "wrong", "13", "dGhlIHNhbXBsZSBub25jZQ==", "")) == 400 && status(request_with("GET", "/hirsel", "upgrade", "websocket", "12", "dGhlIHNhbXBsZSBub25jZQ==", "")) == 426 && status(request_with("GET", "/hirsel", "upgrade", "websocket", "13", "Zg==", "")) == 400 && status(request_with("GET", "/hirsel", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZR==", "")) == 400
}

// Mutant: protocol_case_fold, accept_duplicate_key, interpret_body_as_frames.
// expect: run protocol_and_ambiguity() = true
fn protocol_and_ambiguity() -> bool {
    if status(request_with("GET", "/hirsel", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", "Sec-WebSocket-Protocol: hirsel.1\r\n")) != 101 {
        return false
    }
    status(request_with("GET", "/hirsel", "UpGrAdE", "WeBsOcKeT", "13", "dGhlIHNhbXBsZSBub25jZQ==", "Sec-WebSocket-Protocol: other, hirsel.3\r\n")) == 101 && status(request_with("GET", "/hirsel", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", "Sec-WebSocket-Protocol: HIRSEL.3\r\n")) == 400 && status(request_with("GET", "/hirsel", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n")) == 400 && status(request_with("GET", "/hirsel", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", "Content-Length: 3\r\n")) == 400
}

// Mutant: drop_tail. The masked binary frame is hand-derived with zero mask.
// expect: run upgrade_tail_kept() = true
fn upgrade_tail_kept() -> bool {
    let mut b = request_bytes()
    let end = list.len(b)
    let tail = b"\x82\x83\x00\x00\x00\x00abc"
    list.append(mut b, tail)
    match websocket.server(b) {
        Upgraded(at, Current, _) => at == end && list.slice(b, at, list.len(b)) == tail,
        _ => false
    }
}

// httparse a0fa552e src/lib.rs:1705, the response 101 vector's tab reason.
// RFC 6455 client checks, F18. Mutants: status_only, skip_accept, unsolicited_protocol.
// expect: run client_checks() = true
fn client_checks() -> bool {
    client_status(response_bytes(), false) == 101 && client_status(b"HTTP/1.1 101 Switching Protocols\t\r\nUpgrade: WebSocket\r\nConnection: keep-alive, upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n", false) == 101 && client_status(b"HTTP/1.1 101 Switching Protocols\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n", false) == 400 && client_status(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: upgrade\r\nSec-WebSocket-Accept: wrong\r\n\r\n", false) == 400 && client_status(b"HTTP/1.1 200 OK\r\nUpgrade: websocket\r\nConnection: upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n", false) == 400
}

// RFC 6455 section 4.1: an offer may be declined. The runner requires its
// protocol through its own configuration, not through the generic machine.
// Mutants: allow_unsolicited_extension, require_offered_protocol.
// expect: run client_negotiation_tail() = true
fn client_negotiation_tail() -> bool {
    let mut b = response_bytes()
    let end = list.len(b)
    list.append(mut b, b"\x82\x00")
    let tail = match websocket.client(b, challenge(), false) {
        Ready(at, false) => at == end && list.len(b) - at == 2,
        _ => false
    }
    let mut protocol_response: Bytes = list.new()
    let response = response_bytes()
    list.append(mut protocol_response, list.slice(response, 0, list.len(response) - 2))
    list.append(mut protocol_response, b"Sec-WebSocket-Protocol: hirsel.3\r\n\r\n")
    let offered = match websocket.client(protocol_response, challenge(), true) {
        Ready(_, selected) => selected,
        _ => false
    }
    let declined = match websocket.client(response_bytes(), challenge(), true) {
        Ready(_, selected) => !selected,
        _ => false
    }
    let mut extension: Bytes = list.new()
    list.append(mut extension, list.slice(response, 0, list.len(response) - 2))
    list.append(mut extension, b"Sec-WebSocket-Extensions: permessage-deflate\r\n\r\n")
    tail && offered && declined && client_status(protocol_response, false) == 400 && client_status(extension, true) == 400
}

// Mutant: wrong_client_nonce, inject_host.
// expect: run client_request_vector() = true
fn client_request_vector() -> bool {
    let r = websocket.request(b"server.example.com", b"the sample nonce", false)
    let expected = b"GET /hirsel HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n"
    match r {
        Ok(b) => b == expected,
        _ => false
    }
}

// Exact limit and one byte over, with arbitrary read-ahead excluded.
// Mutants: head_limit_off_by_one, ignore_field_limit.
// expect: run head_bounds() = true
fn head_bounds() -> bool {
    let mut b: Bytes = list.new()
    list.append(mut b, b"GET /hirsel HTTP/1.1\r\nX: ")
    let count = 8192 - list.len(b) - 4
    list.fill(mut b, count, b'a')
    list.append(mut b, b"\r\n\r\n")
    let mut h = http1.head()
    let exact = http1.request(b, mut h) == Complete && h.end == 8192
    let mut over: Bytes = list.new()
    list.append(mut over, list.slice(b, 0, 8188))
    list.append(mut over, b"a\r\n\r\n")
    let long = http1.request(over, mut h) == TooLarge
    let mut fields = b"GET / HTTP/1.1\r\n"
    for i in 0u64 .. 64u64 {
        list.append(mut fields, b"X: a\r\n")
    }
    list.append(mut fields, b"\r\n")
    let sixty_four = http1.request(fields, mut h) == Complete && h.count == 64
    let at = list.len(fields) - 2
    let _ = list.set(mut fields, at, b'X')
    let excess = http1.request(fields, mut h) == TooLarge
    let partial = b"HTTP/1.1 200 OK\r\nX: \tval \t\r\nY"
    let response_progress = http1.response(partial, mut h)
    exact && long && sixty_four && excess && response_progress == Partial && h.status == 200 && h.reason == http1.Span(start: 13, end: 15) && h.count == 1 && h.fields[0].name == http1.Span(start: 17, end: 18) && h.fields[0].value == http1.Span(start: 21, end: 24)
}

// Mutant: status_only_check.
// expect: run client_missing_connection() = 400
fn client_missing_connection() -> u16 {
    client_status(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n", false)
}

// Mutant: status_only_check.
// expect: run client_wrong_accept() = 400
fn client_wrong_accept() -> u16 {
    client_status(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: wrong\r\n\r\n", false)
}

fn ingress_request(extra: String) -> Bytes {
    request_with("GET", "/hirsel", "upgrade", "websocket", "13", "dGhlIHNhbXBsZSBub25jZQ==", extra)
}

// WIRE 2.1 v2. Keys feed per-IP limits independently of Net authority.
// Mutants: trust_any_xff, fallback_to_peer, take_rightmost_of_list.
// expect: run ingress_sanitized() = true
fn ingress_sanitized() -> bool {
    let peer = V4(0x7f000001)
    let mut trusted: List[wsock.Prefix] = list.new()
    list.push(mut trusted, wsock.Prefix(ip: peer, bits: 32))
    let a = ingress_request("X-Forwarded-For: 1.1.1.1\r\n")
    let b = ingress_request("X-Forwarded-For: 2.2.2.2\r\n")
    let outside = V4(0x03030303)
    let canonical_mapped = ingress_value(ingress_request("X-Forwarded-For: 0:0:0:0:0:ffff:1.1.1.1\r\n"), peer, trusted) == (400u16, 0u64, 0u64)
    let mixed_ipv6 = ingress_value(ingress_request("X-Forwarded-For: 2001:db8::1.1.1.1\r\n"), peer, trusted) == (400u16, 0u64, 0u64)
    let overlong = ingress_value(ingress_request("X-Forwarded-For: 11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111\r\n"), peer, trusted) == (400u16, 0u64, 0u64)
    canonical_mapped && mixed_ipv6 && overlong && ingress_value(a, peer, trusted) == (4u16, 0u64, 0x01010101u64) && ingress_value(b, peer, trusted) == (4u16, 0u64, 0x02020202u64) && ingress_value(a, outside, trusted) == (4u16, 0u64, 0x03030303u64) && ingress_value(ingress_request(""), peer, trusted) == (400u16, 0u64, 0u64) && ingress_value(ingress_request("X-Forwarded-For: 1.1.1.1\r\nX-Forwarded-For: 2.2.2.2\r\n"), peer, trusted) == (400u16, 0u64, 0u64) && ingress_value(ingress_request("X-Forwarded-For: 1.1.1.1, 2.2.2.2\r\n"), peer, trusted) == (400u16, 0u64, 0u64) && ingress_value(ingress_request("X-Forwarded-For: 1.1.1.01\r\n"), peer, trusted) == (400u16, 0u64, 0u64) && ingress_value(ingress_request("X-Forwarded-For: ::ffff:1.1.1.1\r\n"), peer, trusted) == (4u16, 0u64, 0x01010101u64) && ingress_value(ingress_request("X-Forwarded-For: 2001:db8::1\r\n"), peer, trusted) == (6u16, 0x20010db800000000u64, 1u64) && ingress_value(ingress_request("X-Forwarded-For: 2001:0db8::1\r\n"), peer, trusted) == (400u16, 0u64, 0u64) && ingress_value(ingress_request("X-Forwarded-For: 2001:db8:0:0:1::1\r\n"), peer, trusted) == (400u16, 0u64, 0u64) && ingress_value(ingress_request("X-Forwarded-For: ::\r\n"), peer, trusted) == (6u16, 0u64, 0u64)
}

fn ingress_value(b: Bytes, peer: Ip, trusted: List[wsock.Prefix]) -> (u16, u64, u64) {
    match wsock.source(b, peer, trusted) {
        Ok(V4(v)) => (4, 0, int.widen(v)),
        Ok(V6(hi, lo)) => (6, hi, lo),
        Error(code) => (code, 0, 0)
    }
}

type ServedReader: send {
    n: Net,
    c: Clock
}

fn served_upgraded(take a: ServedReader) -> wsock.Upgraded waits {
    let ServedReader(n: take n, c: c) = take a
    let config = wsock.defaults()
    let pool = result.unwrap(wsock.pending(config))
    let slot = option.unwrap(result.unwrap(wsock.acquire(pool)))
    let socket = result.unwrap(host.connect(n, Addr(ip: V4(2130706433), port: 80), Never))
    result.unwrap(wsock.server(take socket, take slot, V4(2130706433), list.new(), config, c, host.mono_ns(c)))
}

fn served_reader(take a: ServedReader) -> bool waits {
    let upgraded = served_upgraded(take a)
    let wsock.Upgraded(reader: take input, writer: take writer, source: _, timers: _, pending: take lease, ..) = take upgraded
    let mut r = take input
    let got = match wsock.read(mut r, Never) {
        Ok(Message(take payload)) => payload == string.as_bytes("hi"),
        _ => false
    }
    let _ = take r
    let _ = take writer
    let _ = take lease
    got
}

fn answered(mut s: Served[NetOp], take c: Call[NetOp], r: NetReply) -> bool {
    match provide.reply(mut s, take c, provide.net_reply(r)) {
        Ok(_) => true,
        _ => false
    }
}

// Answers the connect, the upgrade's receive with request_bytes() and its
// send, which must be RFC 6455's 101 response.
fn served_upgrade(mut s: Served[NetOp]) -> bool waits {
    let Some(take connect) = provide.next(mut s) else {
        return false
    }
    let dialed = match provide.net_op(connect) {
        Connect(addr) => addr.port == 80,
        _ => false
    }
    if !dialed || !answered(mut s, take connect, Socket(8, Addr(ip: V4(2130706433), port: 80))) {
        return false
    }
    let Some(take request) = provide.next(mut s) else {
        return false
    }
    let mut c = take request
    let took = provide.fill(mut s, mut c, request_bytes())
    let n = list.len(request_bytes())
    if took != n || !answered(mut s, take c, Count(n)) {
        return false
    }
    let Some(take response) = provide.next(mut s) else {
        return false
    }
    let mut p: Bytes = list.with_capacity(256)
    provide.payload(response, 1, mut p)
    provide.payload(response, 2, mut p)
    let k = list.len(p)
    p == response_bytes() && answered(mut s, take response, Count(k))
}

// Takes the next call: true when it is Ready(8), answered with r.
fn served_ready(mut s: Served[NetOp], r: NetReply) -> bool waits {
    let Some(take call) = provide.next(mut s) else {
        return false
    }
    matches_ready(call) && answered(mut s, take call, r)
}

fn matches_ready(call: Call[NetOp]) -> bool {
    match provide.net_op(call) {
        Ready(socket) => socket == 8,
        _ => false
    }
}

// Takes the next call: true when it is Recv(8) with an 8192-byte loan, and
// stages data and answers r.
fn served_recv(mut s: Served[NetOp], data: Bytes, r: NetReply) -> bool waits {
    let Some(take call) = provide.next(mut s) else {
        return false
    }
    let mut c = take call
    let op = match provide.net_op(c) {
        Recv(socket, room, max) => socket == 8 && room >= 8192 && max == 8192,
        _ => false
    }
    let took = provide.fill(mut s, mut c, data)
    op && took == list.len(data) && answered(mut s, take c, r)
}

// Answers Released calls until the client is gone.
fn served_drain(mut s: Served[NetOp]) -> bool waits {
    loop {
        let Some(take call) = provide.next(mut s) else {
            return true
        }
        let released = match provide.net_op(call) {
            Released(id, part: _) => id == 8,
            _ => false
        }
        if !released || !answered(mut s, take call, Done) {
            return false
        }
    }
}

// NET-1 readiness lending: the masked binary frame "hi" with a zero mask
// (RFC 6455 section 5.2: 0x82, 0x82, four mask bytes, payload) arrives split
// after its third byte across two readiness events. Each receive follows a
// buffer-free Ready, and the decoder joins the halves into one message.
// expect: run split_frame_across_readiness(tasks) = true
fn split_frame_across_readiness(tasks: Tasks) -> bool waits {
    let (c, hand) = provide.clock(0, 0)
    let (n, served) = provide.net(bytes 256)
    let mut s = take served
    let child = task.spawn(tasks, bytes 65536, ServedReader(n: n, c: c), served_reader)
    let upgraded = served_upgrade(mut s)
    let first = served_ready(mut s, Done) && served_recv(mut s, b"\x82\x82\x00", Count(3))
    let second = served_ready(mut s, Done) && served_recv(mut s, b"\x00\x00\x00hi", Count(5))
    let drained = served_drain(mut s)
    let read = result.unwrap(task.join(take child))
    let _ = take hand
    upgraded && first && second && drained && read
}

// Stale readiness: Ready answers Done but the receive then times out before
// the reader's deadline (Never). The reader must return to a buffer-free
// Ready, not repeat the receive, and then read the whole frame.
// expect: run stale_readiness_waits_again(tasks) = true
fn stale_readiness_waits_again(tasks: Tasks) -> bool waits {
    let (c, hand) = provide.clock(0, 0)
    let (n, served) = provide.net(bytes 256)
    let mut s = take served
    let child = task.spawn(tasks, bytes 65536, ServedReader(n: n, c: c), served_reader)
    let upgraded = served_upgrade(mut s)
    let stale = served_ready(mut s, Done) && served_recv(mut s, b"", Failed(TimedOut))
    let fresh = served_ready(mut s, Done) && served_recv(mut s, b"\x82\x82\x00\x00\x00\x00hi", Count(8))
    let drained = served_drain(mut s)
    let read = result.unwrap(task.join(take child))
    let _ = take hand
    upgraded && stale && fresh && drained && read
}

type IdleSession {
    port: Served[NetOp],
    ready: Call[NetOp],
    reader: Task[bool],
    writer: wsock.Writer
}

fn refill_reader(take input: wsock.Reader) -> bool waits {
    let mut r = take input
    match wsock.refill(mut r, Never) {
        Ok(()) => true,
        Error(_) => false
    }
}

// The native stack law intercepts the write after all 64 readers have
// issued Ready and before any of those calls receive a reply.
pub fn idle_reader_stacks(tasks: Tasks, out: Stdout) -> Result[(), Exit] waits {
    let (c, hand) = provide.clock(0, 0)
    let mut sessions: List[IdleSession] = list.with_capacity(64)
    for _ in 0u64 .. 64u64 {
        let (n, served) = provide.net(bytes 256)
        let mut port = take served
        let upgrading = task.spawn(tasks, bytes 65536, ServedReader(n: n, c: c), served_upgraded)
        if !served_upgrade(mut port) {
            fail("WebSocket upgrade failed")
        }
        let upgraded = result.unwrap(task.join(take upgrading))
        let wsock.Upgraded(reader: take input, writer: take writer, source: _, timers: _, pending: take lease, ..) = take upgraded
        wsock.hello_accepted(take lease)
        let reader = task.spawn(tasks, bytes 65536, take input, refill_reader)
        let Some(take ready) = provide.next(mut port) else {
            fail("reader did not wait for readiness")
        }
        if !matches_ready(ready) {
            fail("reader issued a call other than Ready")
        }
        list.push(mut sessions, IdleSession(port: take port, ready: take ready, reader: take reader, writer: take writer))
    }
    result.unwrap(stdout.write(out, "idle\n"));
    while let Some(IdleSession(port: take served, ready: take ready, reader: take reader, writer: take writer)) = list.pop(mut sessions) {
        let mut port = take served
        if !answered(mut port, take ready, Done) || !served_recv(mut port, b"\x82\x82\x00\x00\x00\x00hi", Count(8)) {
            fail("could not deliver the frame")
        }
        let _ = take writer
        if !served_drain(mut port) || !result.unwrap(task.join(take reader)) {
            fail("idle reader did not resume")
        }
    }
    let _ = take hand
    Ok(())
}

// Cancellation CLOSE consumes the file exactly once, including on its failure edge.
fn child(take f: HostFile) -> u64 waits {
    result.unwrap(host.close(take f))
    7u64
}
pub fn main(d: Dir, tasks: Tasks) -> Result[(), Exit] {
    let f = result.unwrap(host.open(d, "input", Read))
    let mut h = result.unwrap(task.spawn(tasks, bytes 0, take f, child))
    task.cancel(mut h)
    match task.join(take h) {
        Error(Cancelled(take causes)) => { let _ = take causes; Ok(()) },
        _ => Error(Exit(status: 1))
    }
}

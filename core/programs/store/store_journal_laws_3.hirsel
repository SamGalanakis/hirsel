    if journal_law_ack_channel(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn journal_failure_notice(db: Db) -> Option[IoError] {
    let mut found: Option[IoError] = None
    if let Some(disk) = db.disk {
        let receiver = journal_written(disk)
        if let Ok(WriteFailed(e)) = channel.try_receive(receiver) {
            found = Some(e)
        }
    }
    if let Some(e) = found {
        if let Some(disk) = db.disk {
            let sender = journal_written_send(disk)
            let _ = channel.try_send(sender, WriteFailed(e))
        }
    }
    found
}

type JournalCancelInput: send {
    d: Dir,
    c: Clock,
    r: Random,
    tasks: Tasks,
    out: Stdout
}

fn journal_cancel_owner(take input: JournalCancelInput) -> Result[(), Error] waits {
    journal_crash_write(input.d, input.c, input.r, input.tasks, input.out, "journal-cancel", JOURNAL_IMMEDIATE_CADENCE)
}

// L4/X1: a queued frame is acked before a successor can bind its end.
// Open, repeated cuts and Barrier-only traffic require no new frame ack.
// The frozen rotate_before_ack source makes W2 refusal cut20 unopenable.
pub fn journal_law_rotation(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let options = journal_crash_options()
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    let empty = result.unwrap(checkpoint(mut db))
    result.unwrap(durable(mut db, empty))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    for k in 0u64 .. 3 {
        if !typed_put(mut db, t, k, k + 10) {
            return false
        }
    }
    let wanted = db.frame_seq
    let pending_end = file_end(db)
    let previous_seq = file_seq(db)
    let cut = result.unwrap(checkpoint(mut db))
    if queue_accounting(disk_state(db)).journaled != wanted {
        return false
    }
    let header = option.unwrap(result.unwrap(failure_result_from_rep(manifest.journal_header(d, store_key_to_rep(db.store), previous_seq + 1, None))))
    if header.prev_end != pending_end {
        return false
    }
    result.unwrap(durable(mut db, cut))
    if let Some(disk) = db.disk {
        let sender = journal.dir_sender(dir_state(disk))
        result.unwrap(channel.send(sender, Barrier))
    }
    if let Some(disk) = db.disk {
        let receiver = journal_written(disk)
        match result.unwrap(channel.receive(receiver)) {
            Written => {},
            _ => return false
        }
    }
    let again = result.unwrap(checkpoint(mut db))
    result.unwrap(durable(mut db, again))
    result.unwrap(close(take db))
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    let sh = view t
    for k in 0u64 .. 3 {
        if result.unwrap(get(result.unwrap(reader(reopened, 0u64)), snapshot(reopened), sh, k)) != Some(k + 10) {
            return false
        }
    }
    result.unwrap(close(take reopened))
    true
}

@test
fn journal_test_rotation(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_rotation(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L23 across a checkpoint: expected logical keys and stored values are laid
// out by hand. Rewriting row2 to the same value emits no Change.
pub fn journal_law_changes_checkpoint(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut db = result.unwrap(open(tasks, d, c, r, journal_crash_options()))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    for k in 0u64 .. 3 {
        if !typed_put(mut db, t, k, (k + 1) * 10) {
            return false
        }
    }
    let before = snapshot(db)
    let cut = result.unwrap(checkpoint(mut db))
    result.unwrap(durable(mut db, cut))
    let done = result.unwrap(run(mut db, None, t, fn(mut tx, call_env) -> Result[(), Error] {
        put(mut tx, call_env, 0, 11)?
        if !delete(mut tx, call_env, 1)? {
            fail("missing L23 row")
        }
        put(mut tx, call_env, 2, 30)?
        put(mut tx, call_env, 3, 40)
    }))
    match take done {
        Committed(_) => {},
        _ => return false
    }
    let after = snapshot(db)
    let found = result.unwrap(changes(result.unwrap(reader(db, 0u64)), before, after)).rows
    if list.len(found) != 3 {
        return false
    }
    let keys: Inline[u64, 3] =[0, 1, 3]
    for i in 0u64 .. 3 {
        let mut key: Bytes = list.with_capacity(12)
        list.fill(mut key, 3, 0u8)
        list.push(mut key, 1u8)
        for j in 0u64 .. 8 {
            list.push(mut key, int.truncate(keys[i] >> int.truncate((7 - j) * 8)))
        }
        if found[i].tree_key != key {
            return false
        }
        if i == 1 {
            if found[i].value != None {
                return false
            }
        } else {
            let v = if i == 0 {
                11u64
            } else {
                40u64
            }
            let mut expected: Bytes = list.with_capacity(10)
            list.fill(mut expected, 2, 0u8)
            for j in 0u64 .. 8 {
                list.push(mut expected, int.truncate(v >> int.truncate(j * 8)))
            }
            match found[i].value {
                Some(raw) => if list.slice(raw, 0, list.len(raw)) != expected {
                    return false
                },
                None => return false
            }
        }
    }
    let sh = view t
    for k in 0u64 .. 4 {
        let old = result.unwrap(get(result.unwrap(reader(db, 0u64)), before, sh, k))
        let new = result.unwrap(get(result.unwrap(reader(db, 0u64)), after, sh, k))
        let expected_old: Option[u64] = if k < 3 {
            Some((k + 1) * 10)
        } else {
            None
        }
        let expected_new: Option[u64] = if k == 0 {
            Some(11u64)
        } else if k == 1 {
            None
        } else if k == 2 {
            Some(30u64)
        } else {
            Some(40u64)
        }
        if old != expected_old || new != expected_new {
            return false
        }
        if (old != new) != (k != 2) {
            return false
        }
    }
    result.unwrap(close(take db))
    true
}

@test
fn journal_test_changes_checkpoint(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_changes_checkpoint(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn journal_boundary_case(d: Dir, c: Clock, r: Random, tasks: Tasks, final_item: u64, accepted: bool) -> bool waits {
    let mut options = journal_crash_options()
    options.resident_limit = 134217728
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let done = result.unwrap(run(mut db, None, final_item, fn(mut tx, call_env) -> Result[u64, Error] {
        for k in 0u64 .. 16 {
            let size = if k == 15 {
                call_env
            } else {
                1048576u64
            }
            let mut value: Bytes = list.with_capacity(size)
            list.fill(mut value, size, 0u8)
            put_bytes(mut tx, 1, types.key_word(k), value)?
        }
        // §2.4:26-byte section prelude +16*(1+4+12+4+4)+stored values.
        let expected = 16 + 26 + 16 * 25 + 15 * 1048576 + call_env
        if tx.frame_bytes != Some(expected) {
            fail("disk L29 arithmetic")
        }
        Ok(expected)
    }))
    match take done {
        Committed(x) => {
            if !accepted || x.value != 15729082 + final_item || pages.holder_heads(db.holders)[0].head != 2 {
                return false
            }
            result.unwrap(durable(mut db, x.ticket))
        },
        Aborted(Undone(value: Limit(Transaction), ticket: None)) => if accepted || pages.holder_heads(db.holders)[0].head != 1 || page_row_count(pages.holder_heads(db.holders)[0].roots.collections) != 0 {
            return false
        },
        _ => return false
    }
    let seq = file_seq(db)
    result.unwrap(close(take db))
    let path = result.unwrap(manifest.disk_path("j-", seq, ""))
    if accepted {
        let raw = result.unwrap(read_journal_prefix(d, path, 72 + 15729082 + final_item))
        if format.read_le(raw, 76, 4) != 15729066 + final_item {
            return false
        }
    } else {
        // §3.3b: the segment is its Direct creation block, the header and zeros
        // to 4096; the refused frame wrote nothing past the header.
        let raw = result.unwrap(failure_result_from_rep(manifest.disk_read_file(d, path, 4096)))
        if list.len(raw) != 4096 {
            return false
        }
        for byte in list.slice(raw, 72, 4096) {
            if byte != 0u8 {
                return false
            }
        }
    }
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    if pages.holder_heads(reopened.holders)[0].head != (if accepted {
        2u64
    } else {
        1u64
    }) {
        return false
    }
    if page_row_count(pages.holder_heads(reopened.holders)[0].roots.collections) != (if accepted {
        16u64
    } else {
        0u64
    }) {
        return false
    }
    if accepted {
        for k in 0u64 .. 16 {
            let found = option.unwrap(result.unwrap(get_raw(snapshot(reopened), 1, types.key_word(k))))
            let expected_size = if k == 15 {
                final_item
            } else {
                1048576u64
            }
            if list.len(found) != expected_size {
                return false
            }
            for byte in found {
                if byte != 0u8 {
                    return false
                }
            }
        }
    }
    result.unwrap(close(take reopened))
    true
}

// L29: the journal applies the hand-derived payload boundary.
// The whole 16MiB boundary frame is replayed, rather than only decoded.
pub fn journal_law_frame_size_boundary(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    journal_boundary_case(disk_test_directory(d), c, r, tasks, 1048213, true) && journal_boundary_case(disk_test_directory(d), c, r, tasks, 1048214, true) && journal_boundary_case(disk_test_directory(d), c, r, tasks, 1048215, false)
}

@test
fn journal_frame_size_boundary(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_frame_size_boundary(d, c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn journal_full_frame(mut tx: Tx, rows: Table[u64, Bytes]) -> Result[(), Error] {
    let mut body: Bytes = list.with_capacity(16711674)
    list.fill(mut body, 16711674, 8u8)
    put(mut tx, rows, 2, body)?
    list.clear(mut body)
    list.fill(mut body, 65518, 9u8)
    put(mut tx, rows, 3, body)
}

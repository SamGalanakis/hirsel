fn l79_fold_base(d: Dir, owner: StoreId) -> Result[std.page.PagePtr, Error] waits {
    let mut rows: List[std.page.Entry] = list.with_capacity(3)
    for seq in 0u64 .. 3 {
        list.push(mut rows, std.page.Entry(key: key_word(seq), cell: InlineValue(string.into_bytes(string.from("stored")))))
    }
    let image = page_result(std.page.encode(rows, 0, 40, Collection))?
    l68_write_page_pack(d, owner, 8, 40, std.page.payload(image))
}

fn l79_fold_parent(d: Dir, owner: StoreId, left: std.page.PagePtr) -> Result[(std.page.PagePtr, std.page.PagePtr), Error] waits {
    let mut rows: List[std.page.Entry] = list.with_capacity(2)
    for seq in 3u64 .. 5 {
        list.push(mut rows, std.page.Entry(key: key_word(seq), cell: InlineValue(string.into_bytes(string.from("stored")))))
    }
    let right_leaf = page_result(std.page.encode(rows, 0, 41, Collection))?
    let right = l68_write_page_pack(d, owner, 9, 41, std.page.payload(right_leaf))?
    let mut children: List[std.page.Entry] = list.with_capacity(2)
    list.push(mut children, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: left, rows: 3, charge: 258))))
    list.push(mut children, std.page.Entry(key: key_word(3), cell: Child(std.page.Branch(child: right, rows: 2, charge: 172))))
    let branch_image = page_result(std.page.encode(children, 1, 42, Collection))?
    let root = l68_write_page_pack(d, owner, 10, 42, std.page.payload(branch_image))?
    Ok((root, right))
}

fn l79_fold_trims(first_charge: u64, final_charge: u64) -> Result[Arc[ReplayOverlay], Error] {
    let mut overlay = empty_replay_overlay(Some(3u64))
    let initial = ReplayLogHead(first: 0, next: 3, cold_next: 3, row_bytes: 258)
    let middle = replay_overlay_trim(mut overlay, "j-1", 72, ReplayOrigin(ordinal: 1, branch: 0), 9, initial, JournalTrim(floor: 2, dropped: first_charge))?
    let _ = replay_overlay_trim(mut overlay, "j-1", 90, ReplayOrigin(ordinal: 2, branch: 0), 9, middle, JournalTrim(floor: 3, dropped: final_charge))?
    Ok(take overlay)
}

fn l79_fold_checks(source: TieredPageSource, base: std.page.PagePtr) -> Result[(), Error] waits {
    // Each of the three rows costs 62 + round8(12) + round8(6) = 86.
    verify_tiered_fold(source, base, l79_fold_trims(172, 86)?)?
    let Error(Corrupt(Fault(why: Malformed, ..))) = verify_tiered_fold(source, base, l79_fold_trims(180, 78)?) else {
        fail("L79: individually wrong trim charges passed with the right sum")
    }
    let mut overlay = empty_replay_overlay(None)
    // Force an internal overlay node before placing bad evidence in its last leaf.
    for absent in 3u64 .. 36 {
        replay_overlay_edit(mut overlay, "j-1", 110, ReplayOrigin(ordinal: absent, branch: 0), log_key(9, absent)?, 0, ReplayAbsent)?
    }
    let key = log_key(9, 36)?
    replay_overlay_edit(mut overlay, "j-1", 110, ReplayOrigin(ordinal: 36, branch: 0), key, 7, ReplayAbsent)?
    let Error(Corrupt(Fault(why: Malformed, ..))) = verify_tiered_fold(source, base, overlay) else {
        fail("L68: fold accepted a recorded prior for an absent key")
    }
    l79_fold_materializes(source, base)
}

fn l79_fold_materializes(source: TieredPageSource, base: std.page.PagePtr) -> Result[(), Error] waits {
    let mut overlay = empty_replay_overlay(Some(3u64))
    let initial = ReplayLogHead(first: 0, next: 3, cold_next: 3, row_bytes: 258)
    let _ = replay_overlay_trim(mut overlay, "j-1", 72, ReplayOrigin(ordinal: 1, branch: 0), 9, initial, JournalTrim(floor: 2, dropped: 172))?
    let next_key = log_key(9, 3)?
    replay_overlay_edit(mut overlay, "j-1", 90, ReplayOrigin(ordinal: 2, branch: 0), next_key, 0,
        ReplayPut(arc.new(string.into_bytes(string.from("next")))))?
    verify_tiered_fold(source, base, overlay)?
    let limits = LogBounds(first: 0, next: 3)
    let empty = std.page.empty(0, 0, Collection)
    let mut stamp = 41u64
    let kept = fold_materialize_trim(source, ColdPage(base), empty, limits, 258, 2, mut stamp)?
    let appended = option.unwrap(replay_overlay_at(overlay, next_key))
    let HotPage(take ready) = fold_materialize_row(source, kept, empty, next_key, appended, 1024, true, 41, mut stamp)? else {
        fail("L79: the overlay append must make a fresh leaf")
    }
    if std.page.totals(ready) != (2u64, 172u64) || std.page.lookup(ready, key_word(0)) != None ||
        std.page.lookup(ready, key_word(1)) != None || std.page.lookup(ready, key_word(2)) != Some(string.as_bytes("stored")) ||
        std.page.lookup(ready, key_word(3)) != Some(string.as_bytes("next")) {
        fail("L79: only the retained Cold row and the replay append belong to the fold")
    }
    Ok(())
}

fn l64_fold_with_writer_pin(source: TieredPageSource, base: std.page.PagePtr, parent: std.page.PagePtr, right: std.page.PagePtr) -> Result[(), Error] waits {
    // The fixture's leaf frame occupies all writer room:
    // 16 + 24 + 7 + 3 * (2 + 1 + 1 + 2 + 6 + 2) = 89.
    let demand = TieredPointDemand(target: TieredPage(base), key: key_word(2), direction: TieredPoint,
        siblings: list.new(), packs: std.omap.snapshot(source.packs), next_stamp: source.next_stamp, deadline: source.deadline, grant: None)
    let held = tiered_point_delivery(source.pager, take demand)?
    l79_fold_checks(source, base)?
    let empty = std.page.empty(0, 0, Collection)
    let mut stamp = 43u64
    let ColdPage(survivor) = fold_materialize_trim(source, ColdPage(parent), empty, LogBounds(first: 0, next: 5), 430, 3, mut stamp)? else {
        fail("L64: the fold must release the cut pin of an unchanged survivor")
    }
    if survivor != right || stamp != 43 { fail("L64: a collapsed root must keep its original Cold location") }
    if let Some(_) = held.failure { fail("L64: the writer's leaf must be readable") }
    if CUT_PIN_BYTES != 19944296 || list.len(held.frames) != 1 || tiered_frame_charge(held.frames[0u64]) != 89 {
        fail("L64: the independent fold must retain the full writer pin")
    }
    Ok(())
}

@test
fn test_l79_fold_checks_cold_evidence(d: Dir, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let owner = StoreId(hi: 3, lo: 4)
    let base = l79_fold_base(fixtures, owner)?
    let (parent, right) = l79_fold_parent(fixtures, owner, base)?
    let mut ids = 0u64
    let mut packs: std.omap.OMap[u64, TieredPagerPack] = std.omap.new()
    for ptr in [base, right, parent] {
        let width: u64 = int.widen(ptr.len)
        let inventory = PagePack(class: 3, frames: 1, live: width, payload_bytes: 116 + width, index: 88 + width)
        let (take updated, _) = std.omap.insert(mut ids, packs, ptr.pack, TieredPagerPack(inventory: inventory, object: None))
        packs = take updated
    }
    let funding = TieredPagerFunding(cache_bytes: 89, writer_pin_bytes: 89, pager_task_bytes: 1048576, cut_pins: true)
    let (take requests, take worker) = start_tiered_pager(tasks, owner, 0, PagerDirectory(fixtures), funding, 4)?
    let source = TieredPageSource(pager: take requests, packs: take packs, next_stamp: 43, deadline: 0)
    let checked = l64_fold_with_writer_pin(source, base, parent, right)
    let _ = take source
    let _ = result.unwrap(task.join(take worker))
    checked
}

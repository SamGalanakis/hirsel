// rule: SER-2
// expect: run
// The payload pair is the version-1 codec without its envelope. Each expected payload
// below is derived by hand from the SER-2 payload table, not from an encoder: the
// payload of `codec.encode(x)` is exactly `codec.encode_payload(x)`, and
// `codec.decode_payload` applies every payload validation, reporting the same errors as
// `codec.decode` would for the same payload inside a matching envelope.
@serializable
type Row {
  x: u8,
  y: bool,
}

@serializable
type Choice = Empty | Item(String)

@serializable(check = valid)
pub opaque type Month: plain + key + sendable + inert + noalloc_drop uses {} {
  number: u8,
}

@noalloc
fn valid(value: Month) -> bool uses {} {
  value.number >= 1 && value.number <= 12
}

// `x` encodes to `payload`, decodes back from it, and is the tail of its envelope.
fn vector[T: serializable](t: Test, x: T, payload: Bytes) {
  let data = codec.encode_payload(x)
  test.check(t, data == payload)
  let none: Option[T] = None()
  let decoded: Result[T, DecodeError] = codec.decode_payload(none, payload)
  match take decoded {
    Ok(y) => test.check(t, codec.encode_payload(y) == payload),
    Error(_) => test.check(t, false),
  }
  let envelope = codec.encode(x)
  let n = bytes.len(envelope)
  test.check(t, bytes.slice(envelope, n - bytes.len(payload), n) == payload)
}

fn refused[T: serializable](
  t: Test,
  none: Option[T],
  payload: Bytes,
  expected: DecodeError
) {
  let decoded: Result[T, DecodeError] = codec.decode_payload(none, payload)
  match take decoded {
    Ok(_) => test.check(t, false),
    Error(e) => test.check(t, e == expected),
  }
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  vector(t, true, b"\x01")
  vector(t, false, b"\x00")
  vector(t, 42u64, b"\x2a\x00\x00\x00\x00\x00\x00\x00")
  vector(t, -2i16, b"\xfe\xff")
  vector(t, (), b"")
  vector(t, "é\0", b"\x03\x00\x00\x00\x00\x00\x00\x00\xc3\xa9\x00")
  vector(t, Row(x: 7, y: true), b"\x07\x01")
  let item: Choice = Item("s")
  vector(t, item, b"\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x73")
  let empty: Choice = Empty
  vector(t, empty, b"\x00\x00\x00\x00")
  let some: Option[u8] = Some(9)
  vector(t, some, b"\x01\x00\x00\x00\x09")
  vector(t, Month(number: 12), b"\x0c")
  let row_list: List[u16] = [1, 258]
  vector(t, row_list, b"\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00\x02\x01")
  // The envelope `codec.encode(true)` is magic, version 1, the 14-byte bool
  // descriptor, the payload length 1 and the payload.
  let envelope = codec.encode(true)
  test.check(
    t,
    bytes.slice(envelope, 0, bytes.len(envelope) - 1) == b"HSC1\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00"
  )
  let bool_none: Option[bool] = None()
  let u64_none: Option[u64] = None()
  let string_none: Option[String] = None()
  let choice_none: Option[Choice] = None()
  let month_none: Option[Month] = None()
  refused(t, u64_none, b"\x01\x02", Truncated())
  refused(t, bool_none, b"", Truncated())
  refused(t, bool_none, b"\x01\x00", Trailing())
  // A whole envelope is not a payload of bool.
  refused(t, bool_none, envelope, Scalar())
  refused(t, bool_none, b"\x02", Scalar())
  refused(t, string_none, b"\x01\x00\x00\x00\x00\x00\x00\x00\xff", Utf8())
  refused(t, string_none, b"\x02\x00\x00\x00\x00\x00\x00\x00\x61", Truncated())
  refused(t, choice_none, b"\x02\x00\x00\x00", Tag())
  refused(t, month_none, b"\x0d", Invalid())
  refused(t, month_none, b"\x00", Invalid())
  Ok(())
}

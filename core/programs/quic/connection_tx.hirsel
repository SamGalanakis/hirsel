type StagedPacket {
    number: u64,
    size: u64,
    crypto_at: u64,
    crypto_end: u64,
    resent: bool,
    ack: bool,
    done: bool,
    close: bool,
    eliciting: bool,
    path: bool,
    frames: List[SentFrame]
}

/// The ack_delay_exponent this endpoint advertises (RFC 9000 §18.2 default).
const ACK_DELAY_EXPONENT: u64 = 3

/// Stage one packet of `kind`. Without `send`, the congestion controller or pacer holds
/// new ack-eliciting frames back; an owed probe is sent regardless (RFC 9002 §7.5).
fn tx_space(mut s: Space, mut st: Streams, fill: bool, kind: codec.PacketKind, dest: Bytes, source: Bytes, done: bool, closing: Option[CloseFrame], limit: u64, now: u64, send: bool, mut out: Bytes) -> Option[StagedPacket] {
    if let None = s.send {
        return None
    }
    let start = list.len(out)
    // RFC 9000 §8.2.1: a datagram with PATH_CHALLENGE or PATH_RESPONSE is expanded to
    // 1200 bytes when the anti-amplification limit allows.
    let path_frames = kind == OneRtt && list.len(s.path_out) > 0
    let mut padding = if kind == Initial || (path_frames && limit >= 1200) {
        1200u64
    } else {
        0u64
    }
    let header_bound = 14 + list.len(dest) + list.len(source) + list.len(s.token) + 8
    if limit < padding || limit <= header_bound + 16 {
        return None
    }
    let cap = limit - header_bound - 16
    let mut payload: Bytes = list.with_capacity(cap)
    let mut crypto_at = s.crypto_committed
    let mut crypto_end = s.crypto_committed
    let mut resent = false
    let mut ack = false
    let mut done_sent = false
    let mut closed = false
    let mut eliciting = false
    let mut path = false
    let mut frames: List[SentFrame] = list.new()
    if let Some(f) = closing {
        let len = order.min(list.len(f.reason), cap - order.min(cap, 27))
        let reason = codec.Span(at: 0, len: len)
        let frame: codec.Frame = if f.application && kind == OneRtt {
            ApplicationClose(code: f.code, reason: reason)
        } else if f.application {
            TransportClose(code: 0x0c, frame_type: 0, reason: codec.Span(at: 0, len: 0))
        } else {
            TransportClose(code: f.code, frame_type: f.frame, reason: reason)
        }
        if let Error(_) = codec.write_frame(frame, f.reason, mut payload) {
            return None
        }
        closed = true
    } else {
        if s.ack_pending && !s.ack_staged {
            // RFC 9000 §13.2.5: the delay since the largest packet arrived, in units of
            // 2^ack_delay_exponent microseconds. RFC 9002 §5.3 lets Initial and
            // Handshake delays be ignored, so those report 0.
            let delay = if kind == OneRtt && now > s.largest_at {
                ((now - s.largest_at) / 1000) >> ACK_DELAY_EXPONENT
            } else {
                0u64
            }
            let counts = s.ecn_in
            let ecn: Option[codec.EcnCounts] = if counts.ect0 + counts.ect1 + counts.ce == 0 {
                None
            } else {
                Some(counts)
            }
            let mut count = list.len(s.received)
            while count > 0 {
                let ranges: List[codec.AckRange] = clone(list.slice(s.received, 0, count))
                let f: codec.Frame = Ack(codec.AckFields(delay: delay, ranges: take ranges, ecn: ecn))
                if let Ok(()) = codec.write_frame(f, b"", mut payload) {
                    ack = true
                    break
                }
                count -= 1
            }
        }
        if path_frames && list.len(payload) + list.len(s.path_out) <= cap {
            list.append(mut payload, s.path_out)
            path = true
            eliciting = true
        }
        let probe = s.probes > 0
        if send || probe {
            if done && list.len(payload) < cap {
                if let Ok(()) = codec.write_frame(HandshakeDone, b"", mut payload) {
                    done_sent = true
                    eliciting = true
                }
            }
            let room = cap - order.min(cap, list.len(payload) + 17)
            if list.len(s.resend) != 0 && room > 0 {
                let r = s.resend[0]
                let len = order.min(r.end - r.at, room)
                let frame: codec.Frame = Crypto(offset: r.at, data: codec.Span(at: r.at, len: len))
                if let Ok(()) = codec.write_frame(frame, s.crypto_out, mut payload) {
                    crypto_at = r.at
                    crypto_end = r.at + len
                    resent = true
                    eliciting = true
                }
            } else if list.len(s.crypto_out) > s.crypto_committed && room > 0 {
                let len = order.min(list.len(s.crypto_out) - s.crypto_committed, room)
                let frame: codec.Frame = Crypto(offset: s.crypto_committed, data: codec.Span(at: s.crypto_committed, len: len))
                if let Ok(()) = codec.write_frame(frame, s.crypto_out, mut payload) {
                    crypto_end += len
                    eliciting = true
                }
            }
            if fill && kind == OneRtt && !s.hold_data {
                // A packet filled to the brim is padded to the limit, so the packets
                // before the last of a batch have one length: a NET-16 GSO train.
                if fill_streams(mut st, cap, mut payload, mut frames) {
                    padding = limit
                }
                eliciting = eliciting || list.len(frames) > 0
            }
            if probe && !eliciting && list.len(payload) < cap {
                if let Ok(()) = codec.write_frame(Ping, b"", mut payload) {
                    eliciting = true
                }
            }
        }
    }
    if list.len(payload) == 0 {
        return None
    }
    let Some(number) = seal_packet(mut s, kind, dest, source, payload, padding, mut out) else {
        requeue(mut st, frames, true)
        return None
    }
    s.ack_staged = s.ack_staged || ack
    Some(StagedPacket(number: number, size: list.len(out) - start, crypto_at: crypto_at, crypto_end: crypto_end, resent: resent, ack: ack, done: done_sent, close: closed, eliciting: eliciting, path: path, frames: take frames))
}

fn commit_space(mut s: Space, p: StagedPacket) {
    record_sent(mut s, p.number)
    if p.resent {
        remove_range(mut s.resend, p.crypto_at, p.crypto_end)
    } else {
        s.crypto_committed = p.crypto_end
    }
    s.ack_pending = s.ack_pending && !p.ack
    if p.path {
        list.clear(mut s.path_out)
    }
    if p.eliciting {
        list.push(mut s.flights, Flight(number: p.number, crypto_at: p.crypto_at, crypto_end: p.crypto_end, done: p.done))
        if s.probes > 0 {
            s.probes -= 1
        }
    }
}

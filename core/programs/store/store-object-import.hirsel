/// Publishes a validated export as the first checkpoint of a new object store.
pub fn import_authority(take authority: Authority, take source: Preparation, r: Random, options: Options) -> Result[StoreId, Error] waits {
    let ObjectAuthority(take settings) = take authority else {
        return Error(Unsupported(0))
    }
    failure_result_from_rep(object_writer.object_open_checks(options.group_commits, options.group_bytes, optional_limits_to_rep(options.limits), options.checkpoint_bytes, options.journal_limit, options.head_poll_ms, options.checkpoint_entries, options.retain))?
    if !options.create || (options.activation != None && options.activation != Some(0u64)) {
        return Error(NotFound)
    }
    if let Some(_) = options.expect {
        return Error(NotFound)
    }
    let ObjectAuthorityConfig(client: take connected, level_name: take level_name, op_ms, ..) = take settings
    let mut client = take connected
    let metadata = failure_result_from_rep(history.history_config_bytes(history.object_history_config(std.object.bucket_config(client), take level_name)))?
    let deadline = std.object.deadline_after_ms(client, op_ms)
    let mut workspace = failure_result_from_rep(history.history_buffers(65536))?
    failure_result_from_rep(history.history_check_endpoint(mut client, deadline))?
    match failure_result_from_rep(history.history_fetch(mut client, "head", mut workspace.witness, deadline)) {
        Ok(_) => return Error(Exists("authority")),
        Error(Remote(NotFound)) => (),
        Error(take problem) => return Error(take problem),
    }
    failure_result_from_rep(object_writer.history_check_empty(mut client, deadline))?
    let id = failure_result_from_rep(types.capacity(types.disk_identity(r)))?
    let holder = failure_result_from_rep(types.capacity(types.disk_identity(r)))?
    let Preparation(db: take recovered, ..) = take source
    let mut draft = take recovered
    draft.store = store_key_from_rep(id)
    catalog.restore_fence(mut draft.schema, 1)
    let (manifest, take locator) = history_import_base(mut client, draft, options, mut workspace, deadline)?
    match failure_result_from_rep(history.history_publish_base(mut client, store_key_to_rep(store_key_from_rep(id)), store_key_to_rep(store_key_from_rep(holder)), 1, metadata, manifest, locator, mut workspace, deadline, None)) {
        Ok(_) => Ok(store_key_from_rep(id)),
        Error(Exists(existing)) if existing == "head" => Error(Lost),
        Error(take problem) => Error(take problem),
    }
}

fn history_import_base(mut client: std.object.Client, draft: Db, options: Options, mut workspace: history.HistoryBuffers, deadline: u64) -> Result[(pages.HistoryRef, history.HistoryLocateRoot), Error] waits {
    let participants = disk_allocation(scoped fn() -> Result[manifest.CutParticipants, Error] {
        cut_participants(draft, NoHolderChange)
    })?
    let blank = manifest.new_page_locations()
    let base = failure_result_from_rep(manifest.page_retry_base(blank, map.new(), participants.holders, participants.roots))?
    failure_result_from_rep(catalog.over_ceiling(base.account, options.resident_limit))?
    let mut next_stamp = failure_result_from_rep(catalog.stamp_after(pages.holder_next_node(draft.holders)))?
    let cut_plan = plan_page_cut(base, participants.holders, manifest.empty_paged_lists(), manifest.no_cut_queue(), manifest.empty_lineage(), None, 1, options.pack_bytes, map.new(), None, mut next_stamp)?
    let limit = order.max(options.pack_bytes, manifest.page_manifest_file_size(manifest.MANIFEST_LIMIT, 1) + manifest.RESTORE_ORIGIN_FRAME)
    let mut buffers = failure_result_from_rep(manifest.cut_output_buffers(cut_plan, cut_manifest_size(draft, NoHolderChange), limit))?
    let no_packs = history.empty_history_locator()
    let (take layout, take refs) = failure_result_from_rep(object_writer.history_write_page_cut(mut client, store_key_to_rep(draft.store), 1, 1, take cut_plan, no_packs, None, mut buffers, mut workspace, deadline))?
    fill_cut_manifest(mut buffers.out, draft, NoHolderChange, participants.roots, 1, 1, 1, layout, next_stamp, base.account, seal_page_manifest_file)?
    let (_, take page_record) = disk_read_page_manifest("MANIFEST", buffers.out)?
    let uploaded = failure_result_from_rep(history.history_create_manifest(mut client, store_key_to_rep(draft.store), 1, 1, page_record, mut workspace, deadline))?
    let locator = failure_result_from_rep(history.history_make_locator(mut client, store_key_to_rep(draft.store), 1, 1, 1, take refs, mut workspace, deadline))?
    Ok((uploaded, take locator))
}

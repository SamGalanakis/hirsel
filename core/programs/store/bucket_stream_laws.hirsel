// L90 laws for the Bucket host stream (STORE-SPEC §12.11.15). Each oracle is
// the spec's rule or a value chosen here, never the encoder's own output.
fn stream_law_head(at_seq: u64) -> HistoryHead {
    let base = pages.HistoryRef(seq: 1, epoch: 1, len: 189, digest: 0x2701)
    let newest = pages.HistoryRef(seq: at_seq, epoch: 1, len: 189, digest: 0x2702)
    HistoryHead(authority_kind: 1, store: StoreId(hi: 9, lo: 10), pair: HistoryPair(epoch: 1, holder: StoreId(hi: 11, lo: 12)), activation: 0, entry: newest, checkpoint: base, floor: 1, binding:[0; 32], origin: None)
}

fn stream_law_authority() -> Result[Bytes, Error] {
    let config = object_history_config(std.object.Bucket(endpoint: "https://s3.amazonaws.com", aws_region: "us-east-1", bucket: "bucket", prefix: "p", style: Path), "bucket")
    history_config_bytes(config)
}

fn stream_law_bytes(first: u8, n: u64, step: u8) -> Bytes {
    let mut out: Bytes = list.with_capacity(n)
    let mut b = first
    for _ in 0u64 .. n {
        list.push(mut out, b)
        b += step
    }
    take out
}

fn stream_law_sid() -> HostStreamId {
    HostStreamId(hi: 0x0807060504030201, lo: 0x100F0E0D0C0B0A09)
}

fn stream_law_tail(inc: u64, from_seq: u64, cutoff: u64, at: u64) -> format.SealedTail {
    format.SealedTail(tail: format.StreamRef(sid: host_stream_id_to_rep(HostStreamId(hi: 21, lo: 22)), inc, from_seq, from_frame: 0), cutoff, at)
}

fn stream_law_attached(head: HistoryHead, a: format.Attach) -> Result[Bytes, Error] {
    let authority = stream_law_authority()?
    let mut raw: Bytes = list.with_capacity(HISTORY_HEAD_LIMIT)
    history_encode_head(mut raw, head, authority)?
    failure_result_from_rep(format.stream_attach_append(mut raw, format.DiskContext(store: store_key_to_rep(head.store), role: 7, seq: head.entry.seq), a))?
    Ok(take raw)
}

fn stream_law_expect_malformed(head: HistoryHead, a: format.Attach, take description: String) -> Result[(), Error] {
    let raw = stream_law_attached(head, a)?
    match history_decode_head_attach(raw) {
        Error(Corrupt(Fault(file: f, why: Malformed, ..))) if f == "head" => Ok(()),
        _ => fail(take description),
    }
}

// L90 (§12.11.2): a non-streamed opener refuses an attached head with the
// live sid, and ATTACH's rules hold. Red before ATTACH was read: such a head
// was a standalone head plus trailing bytes, and a reader that skipped them
// would drop the Place's stream tail.
@test
fn bucket_stream_attached_head_refused() -> Result[(), Error] {
    let head = stream_law_head(5)
    let mut sealed: List[format.SealedTail] = list.new()
    list.push(mut sealed, stream_law_tail(1, 3, 4, 2))
    list.push(mut sealed, stream_law_tail(2, 7, 9, 5))
    let tail_ref = format.StreamRef(sid: host_stream_id_to_rep(stream_law_sid()), inc: 3, from_seq: 40, from_frame: 2)
    let raw = stream_law_attached(head, format.Attach(settles: 6, live: Some(tail_ref), sealed: take sealed))?
    // 4,999 bytes is the head bound with a full ATTACH; this one holds two sealed tails.
    if list.len(raw) > 4999 {
        fail("an attached head passed its bound")
    }
    let expected_sid = stream_law_sid()
    match history_decode_head(raw) {
        Error(Attached(Some(sid))) if types.same(sid.hi, sid.lo, expected_sid.hi, expected_sid.lo) => (),
        _ => fail("a non-streamed reader accepted an attached head"),
    }
    let (_, take attach) = history_decode_head_attach(raw)?
    let Some(a) = attach else {
        fail("the attached reader lost ATTACH")
    }
    let Some(r) = a.live else {
        fail("the attached reader lost the live tail")
    }
    if a.settles != 6 || r.inc != 3 || r.from_seq != 40 || r.from_frame != 2 || list.len(a.sealed) != 2 || a.sealed[1].cutoff != 9 || a.sealed[1].at != 5 {
        fail("ATTACH did not read back as written")
    }
    let direct = stream_law_attached(head, format.Attach(settles: 0, live: None, sealed: list.new()))?
    match history_decode_head(direct) {
        Error(Attached(None)) => (),
        _ => fail("direct service did not report no live stream"),
    }
    let mut falling: List[format.SealedTail] = list.new()
    list.push(mut falling, stream_law_tail(1, 3, 4, 4))
    list.push(mut falling, stream_law_tail(2, 7, 9, 3))
    stream_law_expect_malformed(head, format.Attach(settles: 0, live: None, sealed: take falling), "a sealed `at` fell")?
    let mut ahead: List[format.SealedTail] = list.new()
    list.push(mut ahead, stream_law_tail(1, 3, 4, 6))
    stream_law_expect_malformed(head, format.Attach(settles: 0, live: None, sealed: take ahead), "a sealed `at` passed the head position")?
    let mut backwards: List[format.SealedTail] = list.new()
    list.push(mut backwards, stream_law_tail(1, 8, 7, 2))
    stream_law_expect_malformed(head, format.Attach(settles: 0, live: None, sealed: take backwards), "a sealed cutoff below its start")?
    let mut nine: List[format.SealedTail] = list.new()
    for _ in 0u64 .. 9 {
        list.push(mut nine, stream_law_tail(1, 1, 1, 1))
    }
    match stream_law_attached(head, format.Attach(settles: 0, live: None, sealed: take nine)) {
        Ok(over) => match history_decode_head_attach(over) {
            Error(Corrupt(_)) => (),
            _ => fail("nine sealed tails were accepted"),
        },
        Error(_) => (),
    }
    Ok(())
}

fn stream_law_register(rev: u64, low_seq: u64, k: u64) -> format.StreamRegister {
    let mut rows: List[format.RegRow] = list.new()
    list.push(mut rows, format.RegRow(store: store_key_to_rep(StoreId(hi: 1, lo: 2)), epoch: 4, token: store_key_to_rep(StoreId(hi: 5, lo: 6)), rev_hold: rev, abandoned: false))
    list.push(mut rows, format.RegRow(store: store_key_to_rep(StoreId(hi: 1, lo: 3)), epoch: 2, token: store_key_to_rep(StoreId(hi: 7, lo: 8)), rev_hold: rev - 1, abandoned: true))
    format.StreamRegister(rev, sid: host_stream_id_to_rep(stream_law_sid()), inc: 2, holder: store_key_to_rep(StoreId(hi: 30, lo: 31)), collecting: false, low_inc: 2, low_seq, index: Some(format.RegIndex(k, len: 100, digest: 0x77, covers_inc: 2, covers_seq: 40)), rows: take rows)
}

// L90 (§12.11.2, §12.11.3 rule 1): a register body is 110 + 49 per row, a body
// with a lower rev than one seen is `Regressed`, and a write may not lower
// `low` or `index.k`. Red without the rev guard: an old body seen again would
// show a removed row or an old incarnation and reauthorize nothing it should.
@test
fn bucket_stream_register_rules() -> Result[(), Error] {
    let reg = stream_law_register(5, 10, 3)
    let mut raw: Bytes = list.with_capacity(format.REG_LIMIT + 128)
    failure_result_from_rep(format.stream_register_encode(mut raw, reg, 1))?
    if list.len(raw) != 72 + 16 + 110 + 2 * 49 {
        fail("the register body is not 110 + 49 per row")
    }
    let read = stream_register_decode(raw, stream_law_sid(), 5)?
    if read.rev != 5 || list.len(read.rows) != 2 || !read.rows[1].abandoned || read.rows[0].rev_hold != 5 || read.low_seq != 10 {
        fail("the register did not read back")
    }
    match stream_register_decode(raw, stream_law_sid(), 6) {
        Error(Corrupt(Fault(file: f, why: Regressed, ..))) if f == "reg" => (),
        _ => fail("a register body with a lower rev was accepted"),
    }
    match stream_register_decode(raw, HostStreamId(hi: 1, lo: 1), 0) {
        Error(Corrupt(_)) => (),
        _ => fail("another stream's register was accepted"),
    }
    if !format.stream_register_follows(stream_law_register(5, 10, 3), stream_law_register(6, 10, 3)) {
        fail("a valid successor was refused")
    }
    if format.stream_register_follows(stream_law_register(5, 10, 3), stream_law_register(7, 10, 3)) || format.stream_register_follows(stream_law_register(5, 10, 3), stream_law_register(6, 9, 3)) || format.stream_register_follows(stream_law_register(5, 10, 3), stream_law_register(6, 10, 2)) {
        fail("a register write that skipped a rev or lowered low or index.k was accepted")
    }
    // The register's limit holds 10,698 slots' 2 × rows: 110 + 49 × 21,396 = 1,048,514.
    if format.stream_register_bytes(2 * format.STREAM_MAX_SLOTS) > format.REG_LIMIT || format.stream_register_bytes(2 * format.STREAM_MAX_SLOTS + 2) <= format.REG_LIMIT {
        fail("max_slots 10,698 is not the register's bound")
    }
    Ok(())
}

fn stream_law_slice(hi: u64, take octets: Bytes) -> format.BatchSlice {
    format.BatchSlice(store: store_key_to_rep(StoreId(hi, lo: 0)), epoch: 3, frames: 1, octets)
}

// L90 (§12.11.2): a batch's INDEX locates each Place's slice, its row digest
// and FOOTER catch a changed byte, INDEX's limit is the constant 727,480 and
// a reader's first 4 KiB holds 58 rows; a TERM at a batch key reads as TERM.
@test
fn bucket_stream_batch_objects() -> Result[(), Error] {
    let mut slices: List[format.BatchSlice] = list.new()
    list.push(mut slices, stream_law_slice(1, stream_law_bytes(1, 3, 1)))
    list.push(mut slices, stream_law_slice(4, stream_law_bytes(9, 5, 0)))
    let mut raw: Bytes = list.with_capacity(4096)
    failure_result_from_rep(format.stream_batch_encode(mut raw, host_stream_id_to_rep(stream_law_sid()), 2, 17, 1, 44, slices))?
    let found = stream_batch_check("b", raw, stream_law_sid(), 2, 17)?
    // HEADER 72, INDEX 16 + 16 + 2 × 68, slices 3 + 5, FOOTER 16 + 32.
    if found.byte_len != 240 || list.len(raw) != 240 + 8 + 48 || found.seen_rev != 44 {
        fail("the batch layout differs from §12.11.2")
    }
    let second = found.rows[1]
    if second.offset != 243 || second.len != 5 || list.slice(raw, second.offset, second.offset + second.len) != stream_law_bytes(9, 5, 0) {
        fail("INDEX does not locate the second slice")
    }
    failure_result_from_rep(format.stream_slice_check("b", second, list.slice(raw, 243, 248)))?
    let mut changed: Bytes = clone(raw)
    let _ = list.set(mut changed, 244, 8u8)
    match failure_result_from_rep(format.stream_slice_check("b", second, list.slice(changed, 243, 248))) {
        Error(Corrupt(Fault(why: Checksum, ..))) => (),
        _ => fail("a changed slice byte passed its digest"),
    }
    match stream_batch_check("b", changed, stream_law_sid(), 2, 17) {
        Error(Corrupt(Fault(why: Checksum, ..))) => (),
        _ => fail("a changed slice byte passed FOOTER"),
    }
    match stream_batch_check("b", raw, stream_law_sid(), 2, 18) {
        Error(Corrupt(_)) => (),
        _ => fail("a batch read at another key was accepted"),
    }
    if format.STREAM_INDEX_PREFIX + 58 * format.STREAM_INDEX_ROW_BYTES > format.STREAM_INDEX_PROBE || format.STREAM_INDEX_PREFIX + 59 * format.STREAM_INDEX_ROW_BYTES <= format.STREAM_INDEX_PROBE {
        fail("the first 4 KiB does not hold exactly 58 rows")
    }
    if 16 + 68 * 10698 != format.STREAM_INDEX_LIMIT || disk_kind_limit(0x0101) != Some(727480) {
        fail("INDEX's limit is not the constant 727,480")
    }
    let mut term: Bytes = list.with_capacity(256)
    failure_result_from_rep(format.stream_term_encode(mut term, host_stream_id_to_rep(stream_law_sid()), 2, 18, 1))?
    match stream_batch_head("b", term, stream_law_sid(), 2, 18)? {
        Term(2, 18) => (),
        _ => fail("a TERM did not read as the terminal fence"),
    }
    Ok(())
}

// --- The service core over std.sim.s3 (§12.11.3, §12.11.4).
const STREAM_LAW_ROWS: u64 = 8

fn stream_law_lane(endpoint: std.sim.s3.Endpoint, clock: Clock, tasks: Tasks, seed: u64, holder: StoreId) -> Result[(std.object.Client, StreamLane), Error] waits {
    let client = bucket_endpoint_client(endpoint, std.sim.s3.endpoint_network(endpoint), clock, tasks, "s3.test", seed, true, 0)?
    let lane = stream_lane(stream_law_sid(), 1, STREAM_LAW_ROWS, holder)?
    Ok((take client, take lane))
}

fn stream_law_due(client: std.object.Client) -> u64 {
    std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
}

// A claimant that reads `reg` and adds its hold for (store, epoch); with
// `after`, it starts once the sim has seen that key's first PUT.
type StreamHolder: send {
    endpoint: std.sim.s3.Endpoint,
    clock: Clock,
    tasks: Tasks,
    seed: u64,
    token: StoreId,
    store: StoreId,
    epoch: u64,
    after: Option[String]
}

fn stream_law_holder(take actor: StreamHolder) -> Result[u64, Error] waits {
    if let Some(key) = actor.after {
        result.unwrap(std.sim.s3.requested(actor.endpoint, "PUT", key, 1))
    }
    let (take made_client, take made_lane) = stream_law_lane(actor.endpoint, actor.clock, actor.tasks, actor.seed, actor.token)?
    let mut client = take made_client
    let mut lane = take made_lane
    let due = stream_law_due(client)
    stream_reg_read(mut lane, mut client, due)?
    let against = lane.reg.inc
    let Written = stream_reg_write(mut lane, mut client, Hold(format.RegRow(store: store_key_to_rep(actor.store), epoch: actor.epoch, token: store_key_to_rep(actor.token), rev_hold: 0, abandoned: false), against), due)? else {
        fail("a hold saw the incarnation move with no election")
    }
    match stream_hold_rev(lane.reg, actor.token) {
        Some(rev) => Ok(rev),
        None => fail("a hold write returned without its row"),
    }
}

fn stream_law_holder_task(s: BucketSim, tasks: Tasks, seed: u64, token: StoreId, store: StoreId, epoch: u64, take after: Option[String]) -> Task[Result[u64, Error]] {
    task.spawn(tasks, bytes 16777216, StreamHolder(endpoint: s.endpoint, clock: s.time, tasks, seed, token, store, epoch, after: take after), stream_law_holder)
}

fn stream_law_puts(report: std.sim.s3.Report, key: String) -> (u64, u64) {
    let mut sent = 0u64
    let mut landed = 0u64
    for request in report.requests {
        if request.method == "PUT" && request.key == key {
            sent += 1
            if request.applied {
                landed += 1
            }
        }
    }
    (sent, landed)
}

// L90-R (§12.11.3 rules 3 and 4): B's and C's holds from one rev, the first
// one's reply lost. The resend gets 412, the GET shows its token with its
// stored rev_hold, and the write is done; the other rebuilds over it. Both
// rows stand, and `reg` saw 4 applied writes for revs 1–4. Red for a resend
// that rebuilds (a fifth write) or a merge that drops the other row.
@test
fn bucket_stream_register_q5(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let reg = stream_key(stream_dir(stream_law_sid()), "reg")
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    // PUT 1 creates `reg` and PUT 2 elects; PUT 3, the first hold, applies
    // with its reply lost once PUT 4, the second hold from the same rev, arrives.
    list.push(mut holds, std.sim.s3.Hold(method: "PUT", key: clone(reg), from: 3, count: 1, until: Requested("PUT", clone(reg), 4), then: ApplyLoseReply))
    let s = bucket_law_sim_holds(tasks, c, 41, None, list.new(), take holds, std.sim.world.plan(41))
    let (take made_client, take made_lane) = stream_law_lane(s.endpoint, s.time, tasks, 41, StoreId(hi: 50, lo: 1))?
    let mut client = take made_client
    let mut service = take made_lane
    stream_start_fresh(mut service, mut client, stream_law_due(client))?
    let place = StoreId(hi: 70, lo: 0)
    let b = stream_law_holder_task(s, tasks, 42, StoreId(hi: 60, lo: 1), place, 3, None)
    let held_c = stream_law_holder_task(s, tasks, 43, StoreId(hi: 60, lo: 2), place, 3, None)
    let rev_b = result.unwrap(task.join(take b))
    let rev_c = result.unwrap(task.join(take held_c))
    let seen = stream_reg_read(mut service, mut client, stream_law_due(client))
    let StreamLane(reg: take final_reg, ..) = take service
    let _ = take client
    let report = bucket_law_report(take s)
    seen?
    let (b_rev, c_rev) = (rev_b?, rev_c?)
    if !((b_rev == 3 && c_rev == 4) || (b_rev == 4 && c_rev == 3)) {
        fail("the two holds did not apply at revs 3 and 4")
    }
    if final_reg.rev != 4 || list.len(final_reg.rows) != 2 || stream_hold_rev(final_reg, StoreId(hi: 60, lo: 1)) != Some(b_rev) || stream_hold_rev(final_reg, StoreId(hi: 60, lo: 2)) != Some(c_rev) {
        fail("a hold row was dropped or rewritten")
    }
    // Create, election, the held hold, the refused hold, its rebuild and the refused resend.
    if stream_law_puts(report, reg) != (6, 4) {
        fail("the register's PUTs are not 4 applied of 6")
    }
    Ok(())
}

// L90 ack rule (§12.11.4): batch 1 holds X's and Y's frames; its create is
// held until a hold for (X, 3) applies. The service's GET after the create
// shows the row, so X stalls and Y is acked. Red for ack-on-create, which acks
// X from the register read before the batch.
@test
fn bucket_stream_ack_after_create(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let dir = stream_dir(stream_law_sid())
    let reg = stream_key(dir, "reg")
    let mut name = string.with_capacity(48)
    format.stream_batch_key(mut name, 1, 1)
    let batch = stream_key(dir, name)
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    list.push(mut holds, std.sim.s3.Hold(method: "PUT", key: clone(batch), from: 1, count: 1, until: Applied("PUT", clone(reg), 3), then: Apply))
    let s = bucket_law_sim_holds(tasks, c, 51, None, list.new(), take holds, std.sim.world.plan(51))
    let (take made_client, take made_lane) = stream_law_lane(s.endpoint, s.time, tasks, 51, StoreId(hi: 50, lo: 1))?
    let mut client = take made_client
    let mut service = take made_lane
    stream_start_fresh(mut service, mut client, stream_law_due(client))?
    let claimant = stream_law_holder_task(s, tasks, 52, StoreId(hi: 60, lo: 1), StoreId(hi: 70, lo: 0), 3, Some(clone(batch)))
    let mut slices: List[format.BatchSlice] = list.new()
    list.push(mut slices, stream_law_slice(70, stream_law_bytes(1, 3, 1)))
    list.push(mut slices, stream_law_slice(71, stream_law_bytes(9, 5, 0)))
    let decided = stream_cycle(mut service, mut client, slices, stream_law_due(client))
    let held = result.unwrap(task.join(take claimant))
    let _ = take service
    let _ = take client
    let _ = bucket_law_report(take s)
    held?
    let acked = decided?
    if list.len(acked) != 2 || acked[0].acked || !acked[1].acked {
        fail("the ack rule acked a held Place's frames or stalled a free one")
    }
    Ok(())
}

// L90 ack rule, a lost read (§12.11.4): every GET of `reg` after batch 1's
// create is dropped, so the cycle returns an error with batch 1 undecided.
// Nothing is acked from it, and the next good read decides batch 1's slices
// before any later batch is created. Red for a cycle that drops its slices
// on a failed read: batch 1's frames would never be decided.
@test
fn bucket_stream_ack_after_lost_read(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let reg = stream_key(stream_dir(stream_law_sid()), "reg")
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    // GET 1 is the start's; GETs 2–6 are the cycle's read and its resends.
    list.push(mut holds, std.sim.s3.Hold(method: "GET", key: clone(reg), from: 2, count: 5, until: At(0), then: Drop))
    let s = bucket_law_sim_holds(tasks, c, 61, None, list.new(), take holds, std.sim.world.plan(61))
    let (take made_client, take made_lane) = stream_law_lane(s.endpoint, s.time, tasks, 61, StoreId(hi: 50, lo: 1))?
    let mut client = take made_client
    let mut service = take made_lane
    stream_start_fresh(mut service, mut client, stream_law_due(client))?
    let mut slices: List[format.BatchSlice] = list.new()
    list.push(mut slices, stream_law_slice(70, stream_law_bytes(1, 3, 1)))
    let lost = stream_cycle(mut service, mut client, slices, stream_law_due(client))
    let later = stream_decide_pending(mut service, mut client, stream_law_due(client))
    let _ = take service
    let _ = take client
    let _ = bucket_law_report(take s)
    if let Ok(_) = lost {
        fail("a cycle decided a batch with every register read dropped")
    }
    let decided = later?
    if list.len(decided) != 1 || decided[0].seq != 1 || !decided[0].acked {
        fail("the next good read did not decide the undecided batch")
    }
    Ok(())
}

type Z0Step {
    method: String,
    lead: String,
    status: u16,
    applied: bool
}

fn z0_step(take method: String, take lead: String, status: u16, done: bool) -> Z0Step {
    Z0Step(method: take method, lead: take lead, status, applied: done)
}

// L90-Z0 (§12.11.15): with no journal_service, a Place's genesis, one commit
// and close send exactly §12.3's requests. Genesis steps 1–6 are GET `head`
// 404, the LIST, the MANIFEST create, the entry 1 create, step 5a's two
// refused probes of entry 1, and the `head` create. Then each advance, the
// CLAIM included, is one entry create and one head replace. No `s-` key is
// sent, and the last head carries no ATTACH. Red for stream machinery in
// the default path.
@test
fn bucket_stream_zero_cost(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let s = bucket_law_sim(tasks, c, 71, None, list.new())
    let opened = bucket_order_open(tasks, r, s.time, s.endpoint, 71, true)
    let mut db = match take opened {
        Ok(take found) => take found,
        Error(take problem) => {
            let _ = bucket_law_report(take s)
            return Error(take problem)
        },
    }
    let committed = bucket_order_commit(mut db)
    let closed = close(take db)
    let report = bucket_law_report(take s)
    let _ = committed?
    closed?
    let mut expected: List[Z0Step] = list.new()
    list.push(mut expected, z0_step("GET", "head", 404, false))
    list.push(mut expected, z0_step("LIST", "", 200, true))
    list.push(mut expected, z0_step("PUT", "m-00000000000000000001-", 200, true))
    list.push(mut expected, z0_step("PUT", "e-00000000000000000001-", 200, true))
    list.push(mut expected, z0_step("PUT", "e-00000000000000000001-", 412, false))
    list.push(mut expected, z0_step("PUT", "e-00000000000000000001-", 412, false))
    list.push(mut expected, z0_step("PUT", "head", 200, true))
    list.push(mut expected, z0_step("PUT", "e-00000000000000000002-", 200, true))
    list.push(mut expected, z0_step("PUT", "head", 200, true))
    list.push(mut expected, z0_step("PUT", "e-00000000000000000003-", 200, true))
    list.push(mut expected, z0_step("PUT", "head", 200, true))
    if list.len(report.requests) != list.len(expected) {
        fail("the default path sent other than §12.3's requests")
    }
    for i in 0u64 .. list.len(expected) {
        let want = expected[i]
        let got = report.requests[i]
        if got.method != want.method || !string.starts_with(got.key, want.lead) || got.status != want.status || got.applied != want.applied || (want.lead == "head" && got.key != "head") {
            fail("the default path sent other than §12.3's requests")
        }
        if string.starts_with(got.key, "s-") {
            fail("the default path sent a stream key")
        }
    }
    let n = list.len(report.head_writes)
    let (_, take attach) = history_decode_head_attach(report.head_writes[n - 1].data)?
    if let Some(_) = attach {
        fail("the default path wrote ATTACH")
    }
    Ok(())
}

fn forge_prepared_capture(d: Dir, take raw: Bytes, id: store.types.StoreKey, take recorded: store.manifest.PageManifest, lists: store.capture.CaptureListCount) -> store.capture.PreparedState {
    store.capture.PreparedState(dir: d, raw: take raw, id, manifest: take recorded, segments: list.new(), lists, names: 0, name_bytes: 0, lock: None)
}

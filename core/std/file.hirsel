// Module `file`: files below a Dir, as library code over core's host primitives
// (core/core/host.hirsel; core.md, "Host"). Every operation passes the replay point
// at issue and at delivery (CAP-8) and, when marked `waits`, is a cancellation point
// (CONC-7). Field legend: API.md; "Prefix:" says what has happened on the host when the
// operation fails or is cancelled part way.
//
// The open file is core's HostFile: a `send` mechanical resource with a position (MEM-24):
// making one admits nothing, and its finalizer closes it and ignores the outcome, as Rust's
// File does; call `close` to see the error. The seed writes it `HostFile` and adds no
// wrapper.
//
// OpenMode (core.md, "Host"): Read opens an existing file for reading; Write creates or
// empties a file for writing; Append creates or opens one for writing at the end;
// CreateNew creates one for writing and fails with Exists. There is no read-write mode,
// so a program that reads back what it wrote opens the file twice.
//
// IoError has no arm for Capacity or invalid data, so the operations that allocate
// return `file.Error`.

/// IoError plus what the allocating operations add: Capacity from a refused admission,
/// NotUtf8 from read_string.
pub type Error = Io(IoError) | Capacity(Capacity) | NotUtf8

/// Opens p in mode. `host.open`. Fails: Error(NotFound | Denied | Exists | Other(_)).
/// Prefix: nothing on failure; on success Write and CreateNew may have created p and Write
/// emptied it. A cancellation at delivery closes the handle.
/// Ex: `let src = file.open(d, "source.txt", Read)?`
pub fn open(d: Dir, p: String, mode: OpenMode) -> Result[HostFile, IoError] waits

/// Reads at most capacity(buf) - len(buf) bytes from f's position and appends them to
/// buf; Ok(0) at end of file or when buf has no spare capacity. `host.read`.
/// Fails: Error(Denied | Closed | Other(_)); buf unchanged. Alloc: nothing; buf never
/// grows. Prefix: on failure nothing was read. Cost: O(n) bytes.
/// Ex: `list.clear(mut buf); let n = file.read_into(mut src, mut buf)?`
pub fn read_into(mut f: HostFile, mut buf: Bytes) -> Result[u64, IoError] waits

/// Writes all of data at f's position. `host.write`.
/// Fails: Error(WriteError(written: n, error: e)).
/// Prefix: the first n bytes are written and stay written; the position moved by n.
/// Alloc: nothing. Cost: O(len). Ex: `file.write_all(mut dst, list.slice(buf, 0, 17))?`
pub fn write_all(mut f: HostFile, data: Bytes) -> Result[(), WriteError] waits

/// Closes f and reports the host's close error. `host.close`. Either way f is ended and
/// its finalizer does not run. Ex: `file.close(take src)?`
pub fn close(take f: HostFile) -> Result[(), IoError] waits

/// Reads the whole file p: opens it Read, then `list.reserve` and `host.read` until
/// Ok(0), then closes it. Grows by GROWTH from 4096 bytes.
/// Fails: Error(Io(_)) from the host, Error(Capacity(c)) when growth is refused; the
/// bytes read so far are cleaned and refunded (FAIL-5). Alloc: the Bytes, current limit.
/// Prefix: nothing on the host changes. Cost: O(size).
/// Ex: `let raw = file.read(d, "input.txt")?`
pub fn read(d: Dir, p: String) -> Result[Bytes, Error] waits

/// As read, then `string.from_utf8`; Error(NotUtf8) when it is not UTF-8 (the bytes
/// are cleaned). Ex: `let s = file.read_string(d, input)?`
pub fn read_string(d: Dir, p: String) -> Result[String, Error] waits

/// Opens p Write, writes all of data, then closes it.
/// Fails: Error(Io(e)) from any of the three. Prefix: the file may exist holding a
/// prefix of data of unknown length (use open, write_all and close to learn it).
/// Alloc: nothing. Ex: `file.write(d, "source.txt", data)?`
pub fn write(d: Dir, p: String, data: Bytes) -> Result[(), IoError] waits

/// Removes the file p. `host.remove`. Fails: Error(NotFound | Denied | Other(_)).
/// Prefix: a cancellation at delivery leaves it removed. Ex: `file.remove(d, p)?`
pub fn remove(d: Dir, p: String) -> Result[(), IoError] waits

// The OS file lock: advisory, exclusive, whole-file (flock semantics, as Rust's
// File::try_lock). Lock is a `send` resource that owns the locked file, so the lock is
// released exactly once: by `unlock`, or by its finalizer, which unlocks (ignoring the
// error) and then cleans the file field, whose finalizer closes the handle. Making a Lock
// admits 32 bytes for its cause cell (budgets.md, "resource value"); try_lock makes it
// before asking the host, so a refused admission leaves the host untouched.

pub opaque resource type Lock: send { f: HostFile }
  drop(l) { let _ = host.unlock(mut l.f) }

/// Held: another handle holds the lock. Io: the host refused for another reason.
/// Capacity: the Lock's cause cell was refused, before the host was asked.
pub type LockError = Held | Io(IoError) | Capacity(Capacity)

/// Takes the lock on f without blocking. `host.try_lock`.
/// Fails: Error((Held, f)), Error((Io(e), f)) or Error((Capacity(c), f)); f is returned
/// unlocked and the Lock's cell refunded. Alloc: 32, current limit. Prefix: on failure the
/// lock is not held. Cost: one host call.
/// Ex: `let l = match file.try_lock(take lf) { Ok(l) => l, Error((e, lf)) => .. }`
pub fn try_lock(take f: HostFile) -> Result[Lock, (LockError, HostFile)] waits

/// Unlocks and returns the file, still open. `host.unlock`. Fails: Error((e, f)): the
/// unlock failed and the lock state is the host's; closing f releases it. Either way l
/// is ended exactly once. Alloc: nothing; the cause cell is refunded.
/// Ex: `let lf = file.unlock(take l)?`
pub fn unlock(take l: Lock) -> Result[HostFile, (IoError, HostFile)] waits

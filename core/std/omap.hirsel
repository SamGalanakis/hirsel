// A persistent B+ tree. Nodes contain 1..32 entries/children; non-root nodes
// contain 16..32. Leaf keys/values stay inline. Branches share separator
// blocks across path copies alongside child holders. See api/omap.md.
pub opaque type Node[K: ordered + shareable + send, V: shareable + send]: shareable + send {
    stamp: u64,
    depth: u64,
    size: u64,
    keys: List[K],
    values: List[V],
    kids: List[Arc[Node[K, V]]],
    lows: Option[Arc[List[K]]]
}

pub opaque type OMap[K: ordered + shareable + send, V: shareable + send]: shareable + send {
    head: Option[Arc[Node[K, V]]]
}

type Replacement[K: ordered + shareable + send, V: shareable + send]: send = Moved(V) | Held(Arc[Node[K, V]], u64)

/// The replaced value, moved from a unique leaf or retained in a shared leaf.
pub opaque type Replaced[K: ordered + shareable + send, V: shareable + send]: send {
    value: Replacement[K, V]
}

/// The stored value before replacement, without copying its payload.
pub fn replaced_value[K: ordered + shareable + send, V: shareable + send](old: Replaced[K, V]) -> View[V] in old {
    match old.value {
        Moved(v) => view v,
        Held(n, at) => view n.values[at]
    }
}

pub type Bound[K: ordered + shareable + send]: shareable + send = Unbounded | Included(K) | Excluded(K)

type Frame[K: ordered + shareable + send, V: shareable + send]: shareable + send {
    node: Arc[Node[K, V]],
    position: u64
}

pub opaque type Cursor[K: ordered + shareable + send, V: shareable + send]: send {
    path: List[Frame[K, V]],
    upper: Bound[K]
}

fn copied[T: shareable](x: T) -> Result[T, Capacity] {
    clone(x)
}

/// Empty, with no allocation.
pub fn new[K: ordered + shareable + send, V: shareable + send]() -> OMap[K, V] {
    OMap(head: None)
}

/// O(1) version: share the root, allocate nothing.
pub fn snapshot[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> OMap[K, V] {
    OMap(head: root(m))
}

/// Entry count, O(1).
pub fn len[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> u64 {
    match m.head {
        Some(n) => n.size,
        None => 0
    }
}

/// Root holder for a checkpoint or another task, O(1), no allocation.
pub fn root[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> Option[Arc[Node[K, V]]] {
    match m.head {
        Some(n) => Some(arc.share(n)),
        None => None
    }
}

/// Publish decoded nodes without rechecking tree invariants. Loading is eager:
/// every child must have been constructed before its parent. O(1).
pub fn from_root[K: ordered + shareable + send, V: shareable + send](take head: Option[Arc[Node[K, V]]]) -> OMap[K, V] {
    OMap(head: take head)
}

/// Caller-assigned identity, unchanged when a subtree is shared.
pub fn node_id[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    n.stamp
}

/// Zero for leaves, one plus the children's level for branches.
pub fn node_level[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    n.depth
}

/// Number of leaf entries or branch children, at most 32.
pub fn node_count[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    if n.depth == 0 {
        list.len(n.keys)
    } else {
        list.len(n.kids)
    }
}

/// Total leaf entries beneath this node.
pub fn node_len[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]]) -> u64 {
    n.size
}

/// Leaf key i, or minimum key of branch child i. None outside count.
pub fn node_key[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], i: u64) -> Option[View[K]] in n {
    let ks = node_keys(n)
    if i < list.len(ks) {
        Some(view ks[i])
    } else {
        None
    }
}

/// Leaf value i. None for branches or outside count.
pub fn node_value[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], i: u64) -> Option[View[V]] in n {
    if i < list.len(n.values) {
        Some(view n.values[i])
    } else {
        None
    }
}

/// Child i as an owned Arc holder. None for leaves or outside count.
pub fn node_child[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], i: u64) -> Option[Arc[Node[K, V]]] {
    if i < list.len(n.kids) {
        Some(arc.share(n.kids[i]))
    } else {
        None
    }
}

/// Construct a decoded leaf with its recorded id. No order or fan-out checks.
/// Capacity returns both input lists, unchanged. Payloads are copied into node lists.
pub fn leaf[K: ordered + shareable + send, V: shareable + send](id: u64, take keys: List[K], take values: List[V]) -> Result[Arc[Node[K, V]], (Capacity, (List[K], List[V]))] {
    match load_leaf(id, keys, values) {
        Ok(take n) => Ok(take n),
        Error(c) => Error((c, (take keys, take values))),
    }
}

fn load_leaf[K: ordered + shareable + send, V: shareable + send](id: u64, keys: List[K], values: List[V]) -> Result[Arc[Node[K, V]], Capacity] {
    let mut ks: List[K] = list.with_capacity(list.len(keys))?
    let mut vs: List[V] = list.with_capacity(list.len(values))?
    for k in keys {
        result.capacity_only(list.push(mut ks, copied(k)?))?
    }
    for v in values {
        result.capacity_only(list.push(mut vs, copied(v)?))?
    }
    pack_leaf(id, take ks, take vs)
}

/// Construct a decoded branch with recorded minima and child holders. No tree
/// revalidation. Capacity returns all inputs; children are eagerly loaded.
pub fn branch[K: ordered + shareable + send, V: shareable + send](id: u64, take low_keys: List[K], take children: List[Arc[Node[K, V]]]) -> Result[Arc[Node[K, V]], (Capacity, (List[K], List[Arc[Node[K, V]]]))] {
    match load_branch(id, low_keys, children) {
        Ok(take n) => Ok(take n),
        Error(c) => Error((c, (take low_keys, take children))),
    }
}

fn load_branch[K: ordered + shareable + send, V: shareable + send](id: u64, low_keys: List[K], children: List[Arc[Node[K, V]]]) -> Result[Arc[Node[K, V]], Capacity] {
    let mut ks: List[K] = list.with_capacity(list.len(low_keys))?
    let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(children))?
    let mut size: u64 = 0
    let mut depth: u64 = 1
    for k in low_keys {
        result.capacity_only(list.push(mut ks, copied(k)?))?
    }
    for n in children {
        size += n.size
        depth = n.depth + 1
        result.capacity_only(list.push(mut cs, arc.share(n)))?
    }
    let lows = result.capacity_only(arc.new(take ks))?
    result.capacity_only(arc.new(Node(stamp: id, depth: depth, size: size, keys: list.new(), values: list.new(), kids: take cs, lows: Some(take lows))))
}

/// Bottom-up build from strictly increasing keys and equally many values.
/// Like leaf/branch, the caller supplies the shape/order invariant. Input lists
/// stay borrowed and unchanged on Capacity. Payloads are cloned into the leaf lists; no
/// search path is copied. O(n) payload work and O(n/32) nodes.
pub fn from_sorted[K: ordered + shareable + send, V: shareable + send](mut ids: u64, keys: List[K], values: List[V]) -> Result[OMap[K, V], Capacity] {
    let n = list.len(keys)
    if n == 0 {
        return Ok(new())
    }
    let groups = (n - 1) / 32 + 1
    let mut level: List[Arc[Node[K, V]]] = list.with_capacity(groups)?
    let mut at: u64 = 0
    for group in 0 .. groups {
        let count = n / groups + if group < n % groups {
            1u64
        } else {
            0u64
        }
        let mut ks: List[K] = list.with_capacity(count)?
        let mut vs: List[V] = list.with_capacity(count)?
        for i in at .. at + count {
            result.capacity_only(list.push(mut ks, copied(keys[i])?))?
            result.capacity_only(list.push(mut vs, copied(values[i])?))?
        }
        ids += 1
        result.capacity_only(list.push(mut level, pack_leaf(ids, take ks, take vs)?))?
        at += count
    }
    while list.len(level) > 1 {
        let total = list.len(level)
        let branches = (total - 1) / 32 + 1
        let mut parents: List[Arc[Node[K, V]]] = list.with_capacity(branches)?
        let mut start: u64 = 0
        for group in 0 .. branches {
            let count = total / branches + if group < total % branches {
                1u64
            } else {
                0u64
            }
            let mut children: List[Arc[Node[K, V]]] = list.with_capacity(count)?
            for i in start .. start + count {
                result.capacity_only(list.push(mut children, arc.share(level[i])))?
            }
            result.capacity_only(list.push(mut parents, fresh_branch(mut ids, take children)?))?
            start += count
        }
        level = take parents
    }
    Ok(OMap(head: Some(arc.share(level[0]))))
}

/// O(log32 n) search. The returned view freezes this version only.
pub fn get[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V], k: K) -> Option[View[V]] in m {
    match m.head {
        Some(n) => lookup(n, k),
        None => None
    }
}

fn lookup[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], k: K) -> Option[View[V]] in n {
    if n.depth == 0 {
        let i = lower(n.keys, k)
        if i < list.len(n.keys) && key_order(n.keys, i, k) == Equal {
            Some(view n.values[i])
        } else {
            None
        }
    } else {
        lookup(n.kids[child_index(n, k)], k)
    }
}

fn key_order[K: ordered + shareable + send](ks: List[K], i: u64, k: K) -> Order {
    let a: View[K] = view ks[i]
    if a < k {
        Less
    } else if k < a {
        Greater
    } else {
        Equal
    }
}

fn lower[K: ordered + shareable + send](ks: List[K], k: K) -> u64 {
    let mut a: u64 = 0
    let mut b = list.len(ks)
    while a < b {
        let mid = a + (b - a) / 2
        if ks[mid] < k {
            a = mid + 1
        } else {
            b = mid
        }
    }
    a
}

// First separator greater than k; its predecessor owns k's interval.
// One comparison per step, without rechecking the final separator.
fn upper_child[K: ordered + shareable + send](ks: List[K], k: K) -> u64 {
    let mut a: u64 = 0
    let mut b = list.len(ks)
    while a < b {
        let mid = a + (b - a) / 2
        if k < ks[mid] {
            b = mid
        } else {
            a = mid + 1
        }
    }
    if a == 0 {
        0u64
    } else {
        a - 1
    }
}

fn child_index[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], k: K) -> u64 {
    upper_child(node_keys(n), k)
}

/// Insert/replace by path copying. ids is the last issued id shared by every
/// writer branch. New children are stamped before parents. Failed allocations
/// may consume ids but never publish a partial version; key and value return.
pub fn insert[K: ordered + shareable + send, V: shareable + send](mut ids: u64, m: OMap[K, V], take k: K, take v: V) -> Result[(OMap[K, V], Option[Replaced[K, V]]), (Capacity, (K, V))] {
    match inserted(mut ids, m, k, v) {
        Ok(take next_map) => Ok(take next_map),
        Error(c) => Error((c, (take k, take v))),
    }
}

/// Consuming input with recovery: Capacity returns the original map and k/v.
/// The input root stays alive until publication, so this uses path copying
/// even when its caller owns the only version. No rollback allocation occurs.
pub fn insert_recover[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take m: OMap[K, V], take k: K, take v: V) -> Result[(OMap[K, V], Option[Replaced[K, V]]), (Capacity, (OMap[K, V], (K, V)))] {
    match inserted(mut ids, m, k, v) {
        Ok(take next_map) => Ok(take next_map),
        Error(c) => Error((c, (take m, (take k, take v))))
    }
}

fn inserted[K: ordered + shareable + send, V: shareable + send](mut ids: u64, m: OMap[K, V], k: K, v: V) -> Result[(OMap[K, V], Option[Replaced[K, V]]), Capacity] {
    let mut replaced: Option[Replaced[K, V]] = None
    let pieces = match m.head {
        Some(n) => insert_node(mut ids, mut replaced, n, k, v)?,
        None => {
            let mut ks: List[K] = list.with_capacity(1)?
            let mut vs: List[V] = list.with_capacity(1)?
            result.capacity_only(list.push(mut ks, copied(k)?))?
            result.capacity_only(list.push(mut vs, copied(v)?))?
            let mut out: List[Arc[Node[K, V]]] = list.with_capacity(1)?
            ids += 1
            result.capacity_only(list.push(mut out, pack_leaf(ids, take ks, take vs)?))?
            take out
        },
    }
    let h = if list.len(pieces) == 1 {
        arc.share(pieces[0])
    } else {
        fresh_branch(mut ids, take pieces)?
    }
    Ok((OMap(head: Some(take h)), take replaced))
}

fn insert_leaf[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], n: Arc[Node[K, V]], k: K, v: V) -> Result[List[Arc[Node[K, V]]], Capacity] {
    let i = lower(n.keys, k)
    let hit = i < list.len(n.keys) && key_order(n.keys, i, k) == Equal
    if hit {
        replaced = Some(Replaced(value: Held(arc.share(n), i)))
    }
    let total = list.len(n.keys) + if hit {
        0u64
    } else {
        1u64
    }
    let cut = if total <= 32 {
        total
    } else {
        total / 2
    }
    let mut ka: List[K] = list.with_capacity(cut)?
    let mut va: List[V] = list.with_capacity(cut)?
    let mut kb: List[K] = list.with_capacity(total - cut)?
    let mut vb: List[V] = list.with_capacity(total - cut)?
    for j in 0 .. total {
        let old = if j > i && !hit {
            j - 1
        } else {
            j
        }
        let nk = if j == i {
            copied(k)?
        } else {
            copied(n.keys[old])?
        }
        let nv = if j == i {
            copied(v)?
        } else {
            copied(n.values[old])?
        }
        if j < cut {
            result.capacity_only(list.push(mut ka, take nk))?
            result.capacity_only(list.push(mut va, take nv))?
        } else {
            result.capacity_only(list.push(mut kb, take nk))?
            result.capacity_only(list.push(mut vb, take nv))?
        }
    }
    let mut out: List[Arc[Node[K, V]]] = list.with_capacity(if cut < total {
        2u64
    } else {
        1u64
    })?
    ids += 1
    result.capacity_only(list.push(mut out, pack_leaf(ids, take ka, take va)?))?
    if cut < total {
        ids += 1
        result.capacity_only(list.push(mut out, pack_leaf(ids, take kb, take vb)?))?
    }
    Ok(take out)
}

fn insert_node[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], n: Arc[Node[K, V]], k: K, v: V) -> Result[List[Arc[Node[K, V]]], Capacity] {
    if n.depth == 0 {
        insert_leaf(mut ids, mut replaced, n, k, v)
    } else {
        let at = child_index(n, k)
        let changed = insert_node(mut ids, mut replaced, n.kids[at], k, v)?
        let same_boundaries = list.len(changed) == 1 && {
            let ks = node_keys(n)
            at > 0 || !(k < ks[at])
        }
        let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(n.kids) - 1 + list.len(changed))?
        for j in 0 .. list.len(n.kids) {
            if j == at {
                for c in changed {
                    result.capacity_only(list.push(mut cs, arc.share(c)))?
                }
            } else {
                result.capacity_only(list.push(mut cs, arc.share(n.kids[j])))?
            }
        }
        if list.len(cs) <= 32 {
            let lows = if same_boundaries {
                share_lows(n)
            } else {
                Some(fresh_keys(cs)?)
            }
            let mut out: List[Arc[Node[K, V]]] = list.with_capacity(1)?
            result.capacity_only(list.push(mut out, pack_branch(mut ids, take cs, take lows)?))?
            return Ok(take out)
        }
        split_branches(mut ids, cs)
    }
}

fn pack_leaf[K: ordered + shareable + send, V: shareable + send](id: u64, take ks: List[K], take vs: List[V]) -> Result[Arc[Node[K, V]], Capacity] {
    let size = list.len(ks)
    result.capacity_only(arc.new(Node(stamp: id, depth: 0, size: size, keys: take ks, values: take vs, kids: list.new(), lows: None)))
}

fn fresh_branch[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take cs: List[Arc[Node[K, V]]]) -> Result[Arc[Node[K, V]], Capacity] {
    let lows = fresh_keys(cs)?
    pack_branch(mut ids, take cs, Some(take lows))
}

fn node_keys[K: ordered + shareable + send, V: shareable + send](n: Node[K, V]) -> View[List[K]] in n {
    match n.lows {
        Some(xs) => xs,
        None => view n.keys
    }
}

// A shared key block keeps branch comparisons over contiguous inline keys.
fn share_lows[K: ordered + shareable + send, V: shareable + send](n: Node[K, V]) -> Option[Arc[List[K]]] {
    match n.lows {
        Some(xs) => Some(arc.share(xs)),
        None => None
    }
}

fn fresh_keys[K: ordered + shareable + send, V: shareable + send](cs: List[Arc[Node[K, V]]]) -> Result[Arc[List[K]], Capacity] {
    let mut ks: List[K] = list.with_capacity(list.len(cs))?
    for c in cs {
        let child_keys = node_keys(c)
        result.capacity_only(list.push(mut ks, copied(child_keys[0])?))?
    }
    result.capacity_only(arc.new(take ks))
}

fn pack_branch[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take cs: List[Arc[Node[K, V]]], take lows: Option[Arc[List[K]]]) -> Result[Arc[Node[K, V]], Capacity] {
    let mut size: u64 = 0
    let depth = cs[0].depth + 1
    for c in cs {
        size += c.size
    }
    ids += 1
    result.capacity_only(arc.new(Node(stamp: ids, depth: depth, size: size, keys: list.new(), values: list.new(), kids: take cs, lows: take lows)))
}

// Transfer a temporary leaf's entries into the final halves. No payload clone.
fn split_leaves[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take ks: List[K], take vs: List[V]) -> Result[List[Arc[Node[K, V]]], Capacity] {
    let total = list.len(ks)
    let mut left_keys = take ks
    let mut left_values = take vs
    let count = if total <= 32 {
        1u64
    } else {
        2u64
    }
    let mut out: List[Arc[Node[K, V]]] = list.with_capacity(count)?
    if total <= 32 {
        ids += 1
        result.capacity_only(list.push(mut out, pack_leaf(ids, take left_keys, take left_values)?))?
        return Ok(take out)
    }
    let mid = total / 2
    let mut right_keys: List[K] = list.with_capacity(total - mid)?
    let mut right_values: List[V] = list.with_capacity(total - mid)?
    for _ in mid .. total {
        result.capacity_only(list.push(mut right_keys, option.unwrap(list.pop(mut left_keys))))?
        result.capacity_only(list.push(mut right_values, option.unwrap(list.pop(mut left_values))))?
    }
    for i in 0u64 .. (total - mid) / 2 {
        list.swap(mut right_keys, i, total - mid - 1 - i)
        list.swap(mut right_values, i, total - mid - 1 - i)
    }
    ids += 1
    result.capacity_only(list.push(mut out, pack_leaf(ids, take left_keys, take left_values)?))?
    ids += 1
    result.capacity_only(list.push(mut out, pack_leaf(ids, take right_keys, take right_values)?))?
    Ok(take out)
}

fn split_branches[K: ordered + shareable + send, V: shareable + send](mut ids: u64, cs: List[Arc[Node[K, V]]]) -> Result[List[Arc[Node[K, V]]], Capacity] {
    let total = list.len(cs)
    let mut out: List[Arc[Node[K, V]]] = list.with_capacity(if total <= 32 {
        1u64
    } else {
        2u64
    })?
    let mid = if total <= 32 {
        total
    } else {
        total / 2
    }
    let mut a: List[Arc[Node[K, V]]] = list.with_capacity(mid)?
    for i in 0 .. mid {
        result.capacity_only(list.push(mut a, arc.share(cs[i])))?
    }
    result.capacity_only(list.push(mut out, fresh_branch(mut ids, take a)?))?
    if mid < total {
        let mut b: List[Arc[Node[K, V]]] = list.with_capacity(total - mid)?
        for i in mid .. total {
            result.capacity_only(list.push(mut b, arc.share(cs[i])))?
        }
        result.capacity_only(list.push(mut out, fresh_branch(mut ids, take b)?))?
    }
    Ok(take out)
}

type Pieces[K: ordered + shareable + send, V: shareable + send] {
    first: Arc[Node[K, V]],
    second: Option[Arc[Node[K, V]]]
}

fn as_pieces[K: ordered + shareable + send, V: shareable + send](take nodes: List[Arc[Node[K, V]]]) -> Pieces[K, V] {
    let mut out = take nodes
    let second = if list.len(out) == 2 {
        list.pop(mut out)
    } else {
        None
    }
    Pieces(first: option.unwrap(list.pop(mut out)), second: take second)
}

/// Consuming update. Unique nodes are edited in place through with_unique;
/// shared nodes use the ordinary path-copy. Splits retain the left node and add a sibling.
/// Capacity consumes m; k/v are returned, and
/// independently held versions remain valid. Keep a snapshot for rollback.
pub fn insert_owned[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take m: OMap[K, V], take k: K, take v: V) -> Result[(OMap[K, V], Option[Replaced[K, V]]), (Capacity, (K, V))] {
    match owned_map(mut ids, take m, k, v) {
        Ok(take next_map) => Ok(take next_map),
        Error(c) => Error((c, (take k, take v)))
    }
}

fn owned_map[K: ordered + shareable + send, V: shareable + send](mut ids: u64, take m: OMap[K, V], k: K, v: V) -> Result[(OMap[K, V], Option[Replaced[K, V]]), Capacity] {
    let mut replaced: Option[Replaced[K, V]] = None
    let OMap(head: old) = take m
    let changed = match take old {
        None => {
            let empty: Node[K, V] = Node(stamp: 0, depth: 0, size: 0, keys: list.new(), values: list.new(), kids: list.new(), lows: None)
            let h = result.capacity_only(arc.new(take empty))?
            owned_arc(mut ids, mut replaced, take h, k, v)?
        },
        Some(take h) => owned_arc(mut ids, mut replaced, take h, k, v)?
    }
    let Pieces(first: left, second: right) = take changed
    let new_head = match take right {
        None => take left,
        Some(take r) => {
            let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(2)?
            result.capacity_only(list.push(mut cs, take left))?
            result.capacity_only(list.push(mut cs, take r))?
            fresh_branch(mut ids, take cs)?
        }
    }
    Ok((OMap(head: Some(take new_head)), take replaced))
}

fn owned_arc[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], take h: Arc[Node[K, V]], k: K, v: V) -> Result[Pieces[K, V], Capacity] {
    let mut holder = take h
    let right = edit_owned_arc(mut ids, mut replaced, mut holder, k, v)?
    Ok(Pieces(first: take holder, second: take right))
}

fn edit_owned_arc[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut replaced: Option[Replaced[K, V]], mut holder: Arc[Node[K, V]], k: K, v: V) -> Result[Option[Arc[Node[K, V]]], Capacity] {
    let edited = arc.with_unique(mut holder, scoped fn(mut node: Node[K, V]) -> Result[Option[Arc[Node[K, V]]], Capacity] {
        if node.depth == 0 {
            let at = lower(node.keys, k)
            let hit = at < list.len(node.keys) && key_order(node.keys, at, k) == Equal
            let nk = copied(k)?
            let nv = copied(v)?
            if hit {
                let _ = list.set(mut node.keys, at, take nk)
                let old = list.set(mut node.values, at, take nv)
                replaced = Some(Replaced(value: Moved(take old)))
            } else {
                let capacity = if list.len(node.keys) < 32 {
                    32u64
                } else {
                    33u64
                }
                let extra_keys = capacity - list.len(node.keys)
                let extra_values = capacity - list.len(node.values)
                list.reserve(mut node.keys, extra_keys)?
                list.reserve(mut node.values, extra_values)?
                push_at(mut node.keys, at, take nk)?
                push_at(mut node.values, at, take nv)?
            }
            node.size = list.len(node.keys)
        } else {
            let at = child_index_node(node, k)
            let mut boundaries_changed = {
                let ks = node_keys(node)
                at == 0 && k < ks[at]
            }
            let total = list.len(node.kids)
            let old_size = node.kids[at].size
            list.swap(mut node.kids, at, total - 1)
            let mut selected = option.unwrap(list.pop(mut node.kids))
            let right = edit_owned_arc(mut ids, mut replaced, mut selected, k, v)?
            let mut size = selected.size
            result.capacity_only(list.push(mut node.kids, take selected))?
            list.swap(mut node.kids, at, total - 1)
            if let Some(take r) = take right {
                boundaries_changed = true
                size += r.size
                list.reserve(mut node.kids, 1)?
                push_at(mut node.kids, at + 1, take r)?
            }
            node.size = node.size - old_size + size
            if boundaries_changed && list.len(node.kids) <= 32 {
                node.lows = Some(fresh_keys(node.kids)?)
            }
        }
        ids += 1
        node.stamp = ids
        let count = if node.depth == 0 {
            list.len(node.keys)
        } else {
            list.len(node.kids)
        }
        if count > 32 {
            Ok(Some(split_owned_node(mut ids, mut node)?))
        } else {
            Ok(None)
        }
    })
    match take edited {
        Some(take changed) => take changed,
        None => {
            let Pieces(first: left, second: right) = as_pieces(insert_node(mut ids, mut replaced, holder, k, v)?)
            holder = take left
            Ok(take right)
        },
    }
}

fn push_at[T](mut xs: List[T], at: u64, take value: T) -> Result[(), Capacity] {
    result.capacity_only(list.push(mut xs, take value))?
    let mut i = list.len(xs) - 1
    while i > at {
        list.swap(mut xs, i, i - 1)
        i -= 1
    }
    Ok(())
}

fn split_owned_node[K: ordered + shareable + send, V: shareable + send](mut ids: u64, mut node: Node[K, V]) -> Result[Arc[Node[K, V]], Capacity] {
    let is_leaf = node.depth == 0
    let total = if is_leaf {
        list.len(node.keys)
    } else {
        list.len(node.kids)
    }
    let count = total - total / 2
    let mut keys: List[K] = list.with_capacity(if is_leaf {
        count
    } else {
        0
    })?
    let mut values: List[V] = list.with_capacity(if is_leaf {
        count
    } else {
        0
    })?
    let mut kids: List[Arc[Node[K, V]]] = list.with_capacity(if is_leaf {
        0
    } else {
        count
    })?
    let mut size = 0u64
    for _ in 0 .. count {
        if is_leaf {
            result.capacity_only(list.push(mut keys, option.unwrap(list.pop(mut node.keys))))?
            result.capacity_only(list.push(mut values, option.unwrap(list.pop(mut node.values))))?
            size += 1
        } else {
            let child = option.unwrap(list.pop(mut node.kids))
            size += child.size
            result.capacity_only(list.push(mut kids, take child))?
        }
    }
    for i in 0u64 .. count / 2 {
        if is_leaf {
            list.swap(mut keys, i, count - 1 - i)
            list.swap(mut values, i, count - 1 - i)
        } else {
            list.swap(mut kids, i, count - 1 - i)
        }
    }
    node.size -= size
    let lows: Option[Arc[List[K]]] = if is_leaf {
        None
    } else {
        node.lows = Some(fresh_keys(node.kids)?)
        Some(fresh_keys(kids)?)
    }
    ids += 1
    let right = Node(stamp: ids, depth: node.depth, size: size, keys: take keys, values: take values, kids: take kids, lows: take lows)
    result.capacity_only(arc.new(take right))
}

fn child_index_node[K: ordered + shareable + send, V: shareable + send](n: Node[K, V], k: K) -> u64 {
    upper_child(node_keys(n), k)
}

/// Remove by path copying and sibling merge/redistribution. Missing keys share
/// the original root and issue no ids. O(log32 n) nodes; Capacity leaves m valid.
pub fn remove[K: ordered + shareable + send, V: shareable + send](mut ids: u64, m: OMap[K, V], k: K) -> Result[OMap[K, V], Capacity] {
    let head = match m.head {
        None => return Ok(new()),
        Some(n) => n,
    }
    if let None = lookup(head, k) {
        return Ok(snapshot(m))
    }
    let changed = remove_node(mut ids, head, k)?
    match take changed {
        None => Ok(new()),
        Some(take n) => {
            if n.depth > 0 && list.len(n.kids) == 1 {
                Ok(OMap(head: Some(arc.share(n.kids[0]))))
            } else {
                Ok(OMap(head: Some(take n)))
            }
        },
    }
}

fn remove_node[K: ordered + shareable + send, V: shareable + send](mut ids: u64, n: Arc[Node[K, V]], k: K) -> Result[Option[Arc[Node[K, V]]], Capacity] {
    if n.depth == 0 {
        let at = lower(n.keys, k)
        let total = list.len(n.keys) - 1
        if total == 0 {
            return Ok(None)
        }
        let mut ks: List[K] = list.with_capacity(total)?
        let mut vs: List[V] = list.with_capacity(total)?
        for i in 0 .. list.len(n.keys) {
            if i != at {
                result.capacity_only(list.push(mut ks, copied(n.keys[i])?))?
                result.capacity_only(list.push(mut vs, copied(n.values[i])?))?
            }
        }
        ids += 1
        Ok(Some(pack_leaf(ids, take ks, take vs)?))
    } else {
        let at = child_index(n, k)
        let changed = remove_node(mut ids, n.kids[at], k)?
        let same_minimum = {
            let ks = node_keys(n);
            ks[at] < k
        }
        let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(n.kids))?
        for i in 0 .. list.len(n.kids) {
            if i == at {
                if let Some(c) = changed {
                    result.capacity_only(list.push(mut cs, arc.share(c)))?
                }
            } else {
                result.capacity_only(list.push(mut cs, arc.share(n.kids[i])))?
            }
        }
        if list.len(cs) == 0 {
            return Ok(None)
        }
        let short = if at < list.len(cs) {
            at
        } else {
            list.len(cs) - 1
        }
        if node_count(cs[short]) < 16 && list.len(cs) > 1 {
            let a = if short > 0 {
                short - 1
            } else {
                0u64
            }
            let pair = merge_pair(mut ids, cs[a], cs[a + 1])?
            let mut fixed: List[Arc[Node[K, V]]] = list.with_capacity(list.len(cs) - 2 + list.len(pair))?
            for i in 0 .. list.len(cs) {
                if i == a {
                    for c in pair {
                        result.capacity_only(list.push(mut fixed, arc.share(c)))?
                    }
                } else if i != a + 1 {
                    result.capacity_only(list.push(mut fixed, arc.share(cs[i])))?
                }
            }
            return Ok(Some(fresh_branch(mut ids, take fixed)?))
        }
        let lows = if same_minimum && list.len(cs) == list.len(n.kids) {
            share_lows(n)
        } else {
            Some(fresh_keys(cs)?)
        }
        Ok(Some(pack_branch(mut ids, take cs, take lows)?))
    }
}

fn merge_pair[K: ordered + shareable + send, V: shareable + send](mut ids: u64, a: Arc[Node[K, V]], b: Arc[Node[K, V]]) -> Result[List[Arc[Node[K, V]]], Capacity] {
    if a.depth == 0 {
        let total = list.len(a.keys) + list.len(b.keys)
        let mut ks: List[K] = list.with_capacity(total)?
        let mut vs: List[V] = list.with_capacity(total)?
        for i in 0 .. list.len(a.keys) {
            result.capacity_only(list.push(mut ks, copied(a.keys[i])?))?
            result.capacity_only(list.push(mut vs, copied(a.values[i])?))?
        }
        for i in 0 .. list.len(b.keys) {
            result.capacity_only(list.push(mut ks, copied(b.keys[i])?))?
            result.capacity_only(list.push(mut vs, copied(b.values[i])?))?
        }
        split_leaves(mut ids, take ks, take vs)
    } else {
        let mut cs: List[Arc[Node[K, V]]] = list.with_capacity(list.len(a.kids) + list.len(b.kids))?
        for c in a.kids {
            result.capacity_only(list.push(mut cs, arc.share(c)))?
        }
        for c in b.kids {
            result.capacity_only(list.push(mut cs, arc.share(c)))?
        }
        split_branches(mut ids, cs)
    }
}

/// Least entry, no allocation.
pub fn first[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> Option[(View[K], View[V])] in m {
    match m.head {
        Some(n) => endpoint(n, false),
        None => None
    }
}

/// Greatest entry, no allocation.
pub fn last[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V]) -> Option[(View[K], View[V])] in m {
    match m.head {
        Some(n) => endpoint(n, true),
        None => None
    }
}

fn endpoint[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], high: bool) -> Option[(View[K], View[V])] in n {
    let i = if high {
        node_count(n) - 1
    } else {
        0u64
    }
    if n.depth == 0 {
        Some((view n.keys[i], view n.values[i]))
    } else {
        endpoint(n.kids[i], high)
    }
}

/// An Arc-owned cursor over exactly the requested interval. Reserve one frame
/// per level once. O(height) storage, O(log n) seek, no row materialization.
pub fn range[K: ordered + shareable + send, V: shareable + send](m: OMap[K, V], take lo: Bound[K], take hi: Bound[K]) -> Result[Cursor[K, V], (Capacity, (Bound[K], Bound[K]))] {
    let allocation: Result[List[Frame[K, V]], Capacity] = list.with_capacity(match m.head {
        Some(n) => n.depth + 1,
        None => 0
    })
    let mut path: List[Frame[K, V]] = match take allocation {
        Ok(take p) => take p,
        Error(c) => return Error((c, (take lo, take hi))),
    }
    if let Some(n) = m.head {
        if let Error(c) = seek(n, lo, mut path) {
            return Error((c, (take lo, take hi)))
        }
    }
    Ok(Cursor(path: take path, upper: take hi))
}

fn seek[K: ordered + shareable + send, V: shareable + send](n: Arc[Node[K, V]], lo: Bound[K], mut path: List[Frame[K, V]]) -> Result[(), Capacity] {
    let i = if n.depth == 0 {
        match lo {
            Unbounded => 0u64,
            Included(k) => lower(n.keys, k),
            Excluded(k) => {
                let j = lower(n.keys, k)
                if j < list.len(n.keys) && key_order(n.keys, j, k) == Equal {
                    j + 1
                } else {
                    j
                }
            },
        }
    } else {
        match lo {
            Unbounded => 0u64,
            Included(k) => child_index(n, k),
            Excluded(k) => child_index(n, k)
        }
    }
    result.capacity_only(list.push(mut path, Frame(node: arc.share(n), position: i)))?
    if n.depth > 0 {
        seek(n.kids[i], lo, mut path)?
    }
    Ok(())
}

fn within_upper[K: ordered + shareable + send](hi: Bound[K], k: K) -> bool {
    match hi {
        Unbounded => true,
        Included(v) => !(v < k),
        Excluded(v) => k < v
    }
}

// Pop exhausted leaves/ancestors and recursively descend the next subtree.
// The original seek reserved the maximum path length, so these pushes fit.
fn ready[K: ordered + shareable + send, V: shareable + send](mut path: List[Frame[K, V]]) -> Result[bool, Capacity] {
    if list.len(path) == 0 {
        return Ok(false)
    }
    let at = list.len(path) - 1
    if path[at].node.depth == 0 && path[at].position < list.len(path[at].node.keys) {
        return Ok(true)
    }
    let _ = list.pop(mut path)
    if list.len(path) == 0 {
        return Ok(false)
    }
    let p = list.len(path) - 1
    path[p].position += 1
    if path[p].position < list.len(path[p].node.kids) {
        let child = arc.share(path[p].node.kids[path[p].position])
        seek(child, Unbounded, mut path)?
    }
    ready(mut path)
}

/// Next owned pair; Capacity on payload copying leaves this row unconsumed.
/// Complete traversal is O(n) node work plus payload copies. The cursor is send.
pub fn next[K: ordered + shareable + send, V: shareable + send](mut c: Cursor[K, V]) -> Result[Option[(K, V)], Capacity] {
    if !ready(mut c.path)? {
        return Ok(None)
    }
    let at = list.len(c.path) - 1
    let pair = {
        let frame = view c.path[at]
        let i = frame.position
        if !within_upper(c.upper, frame.node.keys[i]) {
            return Ok(None)
        }
        let kr: Result[K, Capacity] = clone(frame.node.keys[i])
        let vr: Result[V, Capacity] = clone(frame.node.values[i])
        (kr?, vr?)
    }
    c.path[at].position += 1
    Ok(Some(take pair))
}

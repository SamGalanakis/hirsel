// test-vectors
// test-env: HIRSEL_SHA256=portable
fn matches(d: Inline[u8, 32], hex: String) -> bool {
    let alphabet = string.as_bytes("0123456789abcdef")
    let expected = string.as_bytes(hex)
    for i in 0u64 .. 32u64 {
        if alphabet[int.widen(d[i] >> 4)] != expected[i * 2] || alphabet[int.widen(d[i] & 15)] != expected[i * 2 + 1] {
            return false
        }
    }
    true
}

// FIPS 180-4 and NIST SHA examples: empty, abc, 448-bit and 896-bit messages.
// Mutants: little-endian length, padding branch >56, missing final block.
// expect: run nist_vectors() = true
fn nist_vectors() -> bool {
    matches(sha256.hash(string.as_bytes("")), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") && matches(sha256.hash(string.as_bytes("abc")), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") && matches(sha256.hash(string.as_bytes("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1") && matches(sha256.hash(string.as_bytes("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")), "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")
}

// The NIST 896-bit message fed by add_byte, through one full block and a
// tail. Mutant: add_byte filling a block without compressing it.
// expect: run nist_bytewise() = true
fn nist_bytewise() -> bool {
    let b = string.as_bytes("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
    let mut s = sha256.start()
    for x in b {
        sha256.add_byte(mut s, x)
    }
    matches(sha256.finish(s), "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")
}

// NIST million-a vector, streamed as 1,000 chunks with only one 1,000-byte input.
// expect: run nist_million() = true
fn nist_million() -> bool {
    let mut b: Bytes = list.with_capacity(1000)
    list.fill(mut b, 1000, b'a')
    let mut s = sha256.start()
    for _ in 0u64 .. 1000u64 {
        sha256.add(mut s, b, 0, 1000)
    }
    matches(sha256.finish(s), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
}

// finish reads a snapshot; empty adds and nonzero ranges preserve the stream.
// expect: run snapshot_and_ranges() = true
fn snapshot_and_ranges() -> bool {
    let b = string.as_bytes("!abc?")
    let mut s = sha256.start()
    sha256.add(mut s, b, 1, 1)
    if !matches(sha256.finish(s), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
        return false
    }
    sha256.add(mut s, b, 1, 2)
    if !matches(sha256.finish(s), "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb") {
        return false
    }
    sha256.add(mut s, b, 2, 4)
    sha256.add(mut s, b, 5, 5)
    matches(sha256.finish(s), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}


pub const MANIFEST_FIXED_BYTES: u64 = 236

pub const MANIFEST_LIMIT: u64 = MANIFEST_FIXED_BYTES + types.META_LIMIT

// A store's MANIFEST payload limit: the fixed fields and its `meta` records.
pub fn manifest_limit(l: types.LimitsRep) -> u64 {
    MANIFEST_FIXED_BYTES + l.meta
}

pub const PAGE_LIMIT: u64 = std.page.PAGE_MAX

pub const BLOB_LIMIT: u64 = types.VALUE_LIMIT + bytes[u64]

pub const UNKNOWN_ROOM: u64 = 1048576

pub fn disk_allocation[T](operation: scoped[view] fn() -> Result[T, types.Failure]) -> Result[T, types.Failure] {
    match isolate(operation) {
        Ok(Ok(take output)) => take output,
        Ok(Error(causes)) => match raised_capacity(causes) {
            Some(problem) => Error(Full(Allocation(problem))),
            None => fail("store: disk allocation phase failed"),
        },
        Error(problem) => Error(Full(Allocation(problem))),
    }
}

pub fn paged_pack_path(seq: u64) -> Result[String, types.Failure] {
    disk_allocation(scoped fn() -> Result[String, types.Failure] {
        types.capacity(disk_path("p-", seq, ""))
    })
}

pub const PAGE_MANIFEST_FILE_LIMIT: u64 = 72 + 16 + MANIFEST_LIMIT + 20 + UNKNOWN_ROOM

fn disk_page_kind(path: String, at: u64, kind: u16, expected: u16, flags: u16) -> Result[(), types.Failure] {
    if kind == 0x0001 {
        return Error(format.disk_fault(path, at, Header))
    }
    if kind == expected {
        if flags != 1 {
            return Error(format.disk_fault(path, at, Flags))
        }
        return Ok(())
    }
    let known = match kind {
        0x0011 => true,
        0x0012 => true,
        0x0013 => true,
        0x0021 => true,
        0x0022 => true,
        0x0023 => true,
        0x0031 => true,
        0x0040 => true,
        0x0060 => true,
        0x0070 => true,
        _ => kind >= 0x0080 && kind <= 0x0085,
    }
    if known {
        return Error(format.disk_fault(path, at, Kind(int.widen(kind))))
    }
    if flags != 0 {
        return Error(Unsupported(int.widen(kind)))
    }
    Ok(())
}

pub fn disk_read_page_manifest(path: String, raw: Bytes) -> Result[(types.StoreKey, PageManifest), types.Failure] {
    let header = disk_read_header(path, raw, 1, None, None)?
    let mut found: Option[PageManifest] = None
    let mut fence: u32 = 0
    let mut room = 0u64
    let mut at = 72u64
    while at < list.len(raw) {
        let frame = disk_frame_bytes(path, header.context, raw, at)?
        let payload = list.slice(raw, frame.payload, frame.end)
        if frame.kind == 0x0070 {
            if fence != 0 || frame.flags != 1 || list.len(payload) != 4 {
                return Error(format.disk_fault(path, at, Malformed))
            }
            fence = list.word_le(payload, 0)
            if fence == 0 {
                return Error(format.disk_fault(path, at, Malformed))
            }
        } else {
            disk_page_kind(path, at, frame.kind, 0x0031, frame.flags)?
            if frame.kind == 0x0031 {
                if let Some(_) = found {
                    return Error(format.disk_fault(path, at, Malformed))
                }
                found = Some(decode_page_manifest(path, payload, header.context.seq)?)
            } else {
                room += frame.end - at
                if room > UNKNOWN_ROOM {
                    return Error(format.disk_fault(path, at, Malformed))
                }
            }
        }
        at = frame.end
    }
    if fence > 1 {
        return Error(Unsupported(0x0070))
    }
    let Some(take record) = take found else {
        return Error(format.disk_fault(path, 72, Malformed))
    }
    let mut manifest = take record
    manifest.fence = fence
    Ok((header.context.store, take manifest))
}

pub fn disk_page_manifest_bytes(id: types.StoreKey, m: PageManifest) -> Result[Bytes, types.Failure] {
    let size = page_manifest_size(m)
    if size > manifest_limit(m.limits) {
        return Error(Limit(Manifest))
    }
    let mut raw: Bytes = list.with_capacity(page_manifest_file_size(size, m.fence))
    fill_page_manifest_file(mut raw, id, m)?
    Ok(take raw)
}

pub fn fill_page_manifest_file(mut raw: Bytes, id: types.StoreKey, m: PageManifest) -> Result[(), types.Failure] {
    let size = page_manifest_size(m)
    if size > manifest_limit(m.limits) {
        return Error(Limit(Manifest))
    }
    let context = format.DiskContext(store: id, role: 1, seq: m.generation)
    begin_page_manifest_file(mut raw, context)?
    append_page_manifest(mut raw, m)?
    seal_page_manifest_file(mut raw, context, m.fence)
}

pub fn begin_page_manifest_file(mut raw: Bytes, context: format.DiskContext) -> Result[(), types.Failure] {
    let header = disk_allocation(scoped fn() -> Result[Bytes, types.Failure] {
        types.capacity(format.disk_header_bytes(context, 0, 0))
    })?
    list.clear(mut raw)
    list.append(mut raw, header)
    list.put_word_le(mut raw, 0x0031u16)
    list.put_word_le(mut raw, 1u16)
    list.put_word_le(mut raw, 0u32)
    list.put_word_le(mut raw, 0u64)
    Ok(())
}

pub fn seal_page_manifest_file(mut raw: Bytes, context: format.DiskContext, level_number: u32) -> Result[(), types.Failure] {
    let size = list.len(raw) - 88
    if size > MANIFEST_LIMIT {
        return Error(Limit(Manifest))
    }
    let width: u32 = int.truncate(size)
    list.set_word_le(mut raw, 76, width)
    let check = disk_allocation(scoped fn() -> Result[u64, types.Failure] {
        types.capacity(format.disk_check(context, 72, list.slice(raw, 72, 80), list.slice(raw, 88, list.len(raw))))
    })?
    list.set_word_le(mut raw, 80, check)
    if level_number != 0 {
        let at = list.len(raw)
        list.put_word_le(mut raw, 0x0070u16)
        list.put_word_le(mut raw, 1u16)
        list.put_word_le(mut raw, 4u32)
        list.put_word_le(mut raw, 0u64)
        list.put_word_le(mut raw, level_number)
        let fence = disk_allocation(scoped fn() -> Result[u64, types.Failure] {
            types.capacity(format.disk_check(context, at, list.slice(raw, at, at + 8), list.slice(raw, at + 16, at + 20)))
        })?
        list.set_word_le(mut raw, at + 8, fence)
    }
    Ok(())
}

pub fn pack_record(path: String, at: u64, raw: Bytes) -> Result[pages.PagePack, types.Failure] {
    if list.len(raw) != 29 {
        return Error(format.disk_fault(path, at, Malformed))
    }
    let frames: u32 = list.word_le(raw, 1)
    let live_bytes: u64 = list.word_le(raw, 5)
    let payload_bytes: u64 = list.word_le(raw, 13)
    let class = raw[0u64]
    let index_offset: u64 = list.word_le(raw, 21)
    if live_bytes > payload_bytes || class == 2 || class > 4 || (class < 3 && index_offset != 0) || (class >= 3 && (index_offset < 72 || index_offset >= payload_bytes || payload_bytes - index_offset < 28)) {
        return Error(format.disk_fault(path, at, Malformed))
    }
    Ok(pages.PagePack(class: class, frames: frames, live: live_bytes, payload_bytes: payload_bytes, index: index_offset))
}

pub type LoadedPack {
    class: u8,
    payloads: Map[u64, format.DiskFrame],
    raw: Bytes
}

pub fn disk_read_paged_file(d: Dir, path: String, limit: u64) -> Result[Bytes, types.Failure] waits {
    let mut handle = disk_io(host.open(d, path, Read))?
    let size = disk_io(host.stat_file(mut handle))?.size
    if size > limit {
        return Error(format.disk_fault(path, limit, Malformed))
    }
    let raw = read_disk_bytes(mut handle, path, 0, size)?
    disk_io(host.close(take handle))?
    Ok(take raw)
}

pub fn disk_read_file(d: Dir, path: String, limit: u64) -> Result[Bytes, types.Failure] waits {
    let mut file = disk_io(host.open(d, path, Read))?
    let mut out: Bytes = list.new()
    loop {
        let size = list.len(out)
        if size == limit {
            let mut probe = disk_read_buffer(1)?
            if disk_io(host.read(mut file, mut probe))? != 0 {
                return Error(format.disk_fault(path, size, Malformed))
            }
            break
        }
        let room = if limit - size < 16384 {
            limit - size
        } else {
            16384u64
        }
        let mut chunk = disk_read_buffer(room)?
        if disk_io(host.read(mut file, mut chunk))? == 0 {
            break
        }
        types.capacity(list.try_reserve(mut out, list.len(chunk)))?
        list.append(mut out, chunk)
    }
    disk_io(host.close(take file))?
    Ok(take out)
}

pub fn disk_read_buffer(size: u64) -> Result[Bytes, types.Failure] {
    let charge = if size > 18446744073709551608u64 {
        18446744073709551615u64
    } else {
        format.round8(size)
    }
    types.capacity(bound bytes charge {
        list.with_capacity(size)
    })
}

pub fn read_disk_bytes(mut handle: HostFile, path: String, offset: u64, size: u64) -> Result[Bytes, types.Failure] waits {
    let mut raw = disk_read_buffer(size)?
    while list.len(raw) < size {
        let at = offset + list.len(raw)
        if disk_io(host.read_at(mut handle, at, mut raw))? == 0 {
            return Error(format.disk_fault(path, at, Truncated))
        }
    }
    Ok(take raw)
}

pub fn check_page_manifest_header(mut handle: HostFile) -> Result[(), types.Failure] waits {
    let header = read_disk_bytes(mut handle, "MANIFEST", 0, 72)?
    let _ = disk_allocation(scoped fn() -> Result[format.DiskHeader, types.Failure] {
        disk_read_header("MANIFEST", header, 1, None, None)
    })?
    Ok(())
}

pub fn read_page_manifest_bytes(d: Dir) -> Result[Bytes, types.Failure] waits {
    let path = "MANIFEST"
    let mut handle = disk_io(host.open(d, path, Read))?
    check_page_manifest_header(mut handle)?
    let size = disk_io(host.stat_file(mut handle))?.size
    if size > PAGE_MANIFEST_FILE_LIMIT {
        return Error(format.disk_fault(path, PAGE_MANIFEST_FILE_LIMIT, Malformed))
    }
    let raw = read_disk_bytes(mut handle, path, 0, size)?
    disk_io(host.close(take handle))?
    Ok(take raw)
}

pub fn read_page_manifest_file(d: Dir) -> Result[(types.StoreKey, PageManifest), types.Failure] waits {
    let raw = read_page_manifest_bytes(d)?
    disk_allocation(scoped fn() -> Result[(types.StoreKey, PageManifest), types.Failure] {
        disk_read_page_manifest("MANIFEST", raw)
    })
}

fn disk_check_stamp(path: String, at: u64, raw: Bytes, slot_order: u64, next_stamp: u64) -> Result[(), types.Failure] {
    let stamp: u64 = list.word_le(raw, slot_order)
    if stamp == 0 || stamp >= next_stamp {
        return Error(format.disk_fault(path, at, Malformed))
    }
    Ok(())
}

pub fn disk_load_page_pack(d: Dir, id: types.StoreKey, seq: u64, pack: pages.PagePack, next_stamp: u64) -> Result[LoadedPack, types.Failure] waits {
    let path = paged_pack_path(seq)?
    let limit = if pack.class == 0 {
        PAGE_LIMIT
    } else {
        BLOB_LIMIT
    }
    let expected_frames: u64 = int.widen(pack.frames)
    // frames is u32. Even the larger BLOB limit gives a product below 2^56.
    let raw = disk_read_paged_file(d, path, 72 + expected_frames * (16 + limit) + UNKNOWN_ROOM)?
    let payloads = disk_allocation(scoped fn() -> Result[Map[u64, format.DiskFrame], types.Failure] {
        index_page_pack(path, id, seq, pack, next_stamp, raw)
    })?
    Ok(LoadedPack(class: pack.class, payloads: take payloads, raw: take raw))
}

type PackScan {
    class: u8,
    kind: u16,
    stamp_at: u64,
    next_stamp: u64,
    index: u64,
    data_end: u64,
    index_frames: u64,
    frames: u64,
    payload_bytes: u64,
    unknown_bytes: u64,
}

pub fn pack_scan(class: u8, next_stamp: u64) -> PackScan {
    pack_scan_indexed(class, next_stamp, 0)
}

pub fn pack_scan_indexed(class: u8, next_stamp: u64, index_at: u64) -> PackScan {
    let (kind, stamp_at) = if class == 1 || class == 4 {
        (0x0022u16, 0u64)
    } else {
        (0x0021u16, 8u64)
    }
    PackScan(class, kind, stamp_at, next_stamp, index: index_at, data_end: 72, index_frames: 0, frames: 0, payload_bytes: 0, unknown_bytes: 0)
}

pub fn pack_scan_finished(checked: PackScan, frames: u64, payload_bytes: u64, at: u64) -> bool {
    if checked.class >= 3 {
        return checked.frames == frames && checked.data_end == checked.index && checked.index_frames != 0 && at == payload_bytes
    }
    if checked.class == 2 {
        return checked.frames <= 4294967295
    }
    checked.frames == frames && checked.payload_bytes == payload_bytes
}

pub fn scan_pack_frame(mut checked_pack: PackScan, path: String, at: u64, kind: u16, flags: u16, size: u64, stamp_bytes: Bytes) -> Result[Option[u64], types.Failure] {
    if checked_pack.class >= 3 && at >= checked_pack.index {
        if checked_pack.data_end != checked_pack.index {
            return Error(format.disk_fault(path, at, Malformed))
        }
        disk_page_kind(path, at, kind, PACK_INDEX_KIND, flags)?
        if kind != PACK_INDEX_KIND {
            return Error(format.disk_fault(path, at, Malformed))
        }
        checked_pack.index_frames += 1
        return Ok(None)
    }
    disk_page_kind(path, at, kind, checked_pack.kind, flags)?
    if kind != checked_pack.kind {
        if checked_pack.class >= 3 {
            return Error(format.disk_fault(path, at, Malformed))
        }
        checked_pack.unknown_bytes += 16 + size
        if checked_pack.unknown_bytes > UNKNOWN_ROOM {
            return Error(format.disk_fault(path, at, Malformed))
        }
        return Ok(None)
    }
    if size < checked_pack.stamp_at + 8 {
        return Error(format.disk_fault(path, at, Malformed))
    }
    disk_check_stamp(path, at, stamp_bytes, checked_pack.stamp_at, checked_pack.next_stamp)?
    checked_pack.frames += 1
    checked_pack.payload_bytes += size
    if checked_pack.class >= 3 {
        checked_pack.data_end = at + 16 + size
        if checked_pack.data_end > checked_pack.index {
            return Error(format.disk_fault(path, at, Malformed))
        }
    }
    Ok(Some(list.word_le(stamp_bytes, checked_pack.stamp_at)))
}

fn index_page_pack(path: String, id: types.StoreKey, seq: u64, pack: pages.PagePack, next_stamp: u64, raw: Bytes) -> Result[Map[u64, format.DiskFrame], types.Failure] {
    let header = disk_read_header(path, raw, 3, Some(seq), Some(id))?
    index_pack_frames(path, header.context, pack, next_stamp, raw)
}

pub fn index_pack_frames(path: String, ctx: format.DiskContext, pack: pages.PagePack, next_stamp: u64, raw: Bytes) -> Result[Map[u64, format.DiskFrame], types.Failure] {
    let expected_frames: u64 = int.widen(pack.frames)
    let mut frames: Map[u64, format.DiskFrame] = map.new()
    let mut checked_pack = pack_scan(pack.class, next_stamp)
    let mut at = 72u64
    while at < list.len(raw) {
        let frame = disk_frame_bytes(path, ctx, raw, at)?
        let size = frame.end - frame.payload
        let stamp_bytes = list.slice(raw, frame.payload, frame.payload + order.min(size, checked_pack.stamp_at + 8))
        let _ = scan_pack_frame(mut checked_pack, path, at, frame.kind, frame.flags, size, stamp_bytes)?
        if checked_pack.frames > expected_frames {
            return Error(format.disk_fault(path, at, Malformed))
        }
        map.insert(mut frames, at, frame)
        at = frame.end
    }
    if checked_pack.payload_bytes != pack.payload_bytes || checked_pack.frames != expected_frames {
        return Error(format.disk_fault(path, at, Malformed))
    }
    Ok(take frames)
}

// A zero child stamp is either an empty collection or an edge owned by the
// Tiered descriptor. Neither creates an incoming edge in PageLocations.
pub type ReadFrame = ReadPage(std.page.Image, List[u64], List[u64]) | ReadBlob(Bytes)

pub type PageGraph {
    stamps: Map[u64, std.page.PagePtr],
    frames: Map[u64, ReadFrame],
    postorder: List[u64]
}

pub fn graph_add(mut graph: PageGraph, stamp: u64, take frame: ReadFrame) -> Result[(), types.Failure] {
    types.capacity(map.try_reserve(mut graph.frames, 1))?
    types.capacity(list.try_reserve(mut graph.postorder, 1))?
    map.insert(mut graph.frames, stamp, take frame)
    list.push(mut graph.postorder, stamp)
    Ok(())
}

fn resolve_blob(packs: Map[u64, LoadedPack], inventory: RecoveryInventory, settled: SettledPacks, reference: std.page.BlobRef, mut graph: PageGraph) -> Result[(), types.Failure] {
    let path = types.capacity(disk_path("p-", reference.pack, ""))?
    let Some(pack) = map.get(packs, reference.pack) else {
        let width = 8 + reference.len
        let loc = std.page.PagePtr(pack: reference.pack, offset: reference.offset, len: int.truncate(width), checksum: reference.checksum, stamp: reference.stamp)
        return settled_frame(inventory, settled, path, loc, 1, mut graph)
    }
    resolve_blob_frame(path, pack, reference, mut graph)
}

pub fn resolve_blob_frame(path: String, pack: LoadedPack, reference: std.page.BlobRef, mut graph: PageGraph) -> Result[(), types.Failure] {
    if pack.class != 1 {
        return Error(format.disk_fault(path, reference.offset, Malformed))
    }
    let Some(frame) = map.get(pack.payloads, reference.offset) else {
        return Error(format.disk_fault(path, reference.offset, Dangling(reference.stamp)))
    }
    let width = 8 + reference.len
    if frame.kind != 0x0022 || frame.end - frame.payload != width {
        return Error(format.disk_fault(path, reference.offset, Checksum))
    }
    let stamp: u64 = list.word_le(pack.raw, frame.payload)
    let start = frame.payload + 8
    if stamp != reference.stamp || std.check.xxh3(pack.raw, start, frame.end) != reference.checksum {
        return Error(format.disk_fault(path, reference.offset, Checksum))
    }
    let loc = std.page.PagePtr(pack: reference.pack, offset: reference.offset, len: int.truncate(width), checksum: reference.checksum, stamp: reference.stamp)
    if !mark_reached(mut graph.stamps, path, loc)? {
        return Ok(())
    }
    let value = types.copied(list.slice(pack.raw, start, frame.end))?
    graph_add(mut graph, loc.stamp, ReadBlob(take value))
}

// The packs the published generation lists below the cut's first new pack
// (AP21's settled packs). A cut proves NEW's MANIFEST by reading only the
// packs it wrote: a settled pack is immutable and every frame NEW reaches in
// one is a frame the published generation reaches at the same place, so its
// bytes were already the published generation's. Open passes below 0.
pub scoped type SettledPacks {
    below: u64,
    locations: View[PageLocations]
}

// A frame in a settled pack ends the descent: NEW must list the pack with the
// frame's class, and the published record map must hold the frame at exactly
// this place.
fn settled_frame(inventory: RecoveryInventory, settled: SettledPacks, path: String, ptr: std.page.PagePtr, class: u8, mut graph: PageGraph) -> Result[(), types.Failure] {
    if ptr.pack >= settled.below {
        return Error(format.disk_fault(path, ptr.offset, Dangling(ptr.stamp)))
    }
    let Some(listed) = map.get(inventory.packs, ptr.pack) else {
        return Error(format.disk_fault(path, ptr.offset, Dangling(ptr.stamp)))
    }
    if listed.class != class {
        return Error(format.disk_fault(path, ptr.offset, Malformed))
    }
    let Some(record) = disk_index_get(settled.locations.frames, ptr.stamp) else {
        return Error(format.disk_fault(path, ptr.offset, Dangling(ptr.stamp)))
    }
    if record.class != class || record.place != ptr {
        return Error(format.disk_fault(path, ptr.offset, Checksum))
    }
    let _ = mark_reached(mut graph.stamps, path, ptr)?
    Ok(())
}

pub scoped type RecoveryInventory {
    packs: View[Map[u64, pages.PagePack]],
    next_stamp: u64,
    allow_tiered: bool
}

pub fn validate_cold_root(inventory: RecoveryInventory, ptr: std.page.PagePtr) -> Result[(), types.Failure] {
    if ptr.stamp == 0 {
        return Ok(())
    }
    let path = paged_pack_path(ptr.pack)?
    let Some(pack) = map.get(inventory.packs, ptr.pack) else {
        return Error(format.disk_fault(path, ptr.offset, Dangling(ptr.stamp)))
    }
    let width: u64 = int.widen(ptr.len)
    if pack.class != 3 || ptr.stamp >= inventory.next_stamp || width < 24 || width > PAGE_LIMIT || ptr.offset < 72 || ptr.offset >= pack.index || 16 + width > pack.index - ptr.offset {
        return Error(format.disk_fault(path, ptr.offset, Malformed))
    }
    Ok(())
}

fn resolve_data_page(packs: Map[u64, LoadedPack], inventory: RecoveryInventory, settled: SettledPacks, ptr: std.page.PagePtr, domain: std.page.Domain, expected_level: Option[u8], collect_cold: bool, mut cold_roots: List[std.page.PagePtr], mut graph: PageGraph) -> Result[(), types.Failure] {
    if ptr.stamp == 0 {
        return Ok(())
    }
    let path = types.capacity(disk_path("p-", ptr.pack, ""))?
    let Some(pack) = map.get(packs, ptr.pack) else {
        return settled_frame(inventory, settled, path, ptr, 0, mut graph)
    }
    if pack.class != 0 {
        return Error(format.disk_fault(path, ptr.offset, Malformed))
    }
    let Some(frame) = map.get(pack.payloads, ptr.offset) else {
        return Error(format.disk_fault(path, ptr.offset, Dangling(ptr.stamp)))
    }
    if frame.kind != 0x0021 {
        return Error(format.disk_fault(path, ptr.offset, Checksum))
    }
    let payload = list.slice(pack.raw, frame.payload, frame.end)
    check_page_pointer(path, ptr, payload)?
    if !mark_reached(mut graph.stamps, path, ptr)? {
        let existing = map.get(graph.frames, ptr.stamp)
        if let Some(ReadPage(image, _, _)) = existing {
            if std.page.key_domain(image) != domain {
                return Error(format.disk_fault(path, ptr.offset, Malformed))
            }
            if let Some(wanted) = expected_level {
                if std.page.level(image) != wanted {
                    return Error(format.disk_fault(path, ptr.offset, Malformed))
                }
            }
            return Ok(())
        }
        return Error(format.disk_fault(path, ptr.offset, Malformed))
    }
    let image = decode_manifest_page(path, ptr.offset, types.copied(payload)?, domain, inventory.allow_tiered)?
    let height = std.page.level(image)
    if let Some(wanted) = expected_level {
        if height != wanted {
            return Error(format.disk_fault(path, ptr.offset, Malformed))
        }
    }
    let mut kids: List[u64] = list.new()
    let mut blobs: List[u64] = list.new()
    for slot in 0u64 .. std.page.count(image) {
        match std.page.owning_edge(image, slot) {
            Some(PageEdge(child)) => {
                if child.stamp != 0 {
                    format.page_edge_order(path, ptr, child)?
                }
                if let Some(_) = std.page.tiered_root_at(image, slot) {
                    validate_cold_root(inventory, child)?
                    if collect_cold && child.stamp != 0 {
                        types.capacity(list.try_reserve(mut cold_roots, 1))?
                        list.push(mut cold_roots, child)
                    }
                    list.push(mut kids, 0u64)
                } else {
                    if height == 0 {
                        resolve_data_page(packs, inventory, settled, child, Collection, None, collect_cold, mut cold_roots, mut graph)?
                    } else {
                        resolve_data_page(packs, inventory, settled, child, domain, Some(height - 1), collect_cold, mut cold_roots, mut graph)?
                    }
                    list.push(mut kids, child.stamp)
                }
            },
            Some(BlobEdge(reference)) => {
                resolve_blob(packs, inventory, settled, reference, mut graph)?
                list.push(mut blobs, reference.stamp)
            },
            None => (),
        }
    }
    graph_add(mut graph, ptr.stamp, ReadPage(take image, take kids, take blobs))
}

pub fn resolve_data_roots(packs: Map[u64, LoadedPack], inventory: RecoveryInventory, settled: SettledPacks, roots: pages.LocatedRoots, collect_cold: bool, mut cold_roots: List[std.page.PagePtr], mut graph: PageGraph) -> Result[(), types.Failure] {
    resolve_data_page(packs, inventory, settled, roots.collections, CollectionMap, None, collect_cold, mut cold_roots, mut graph)?
    resolve_data_page(packs, inventory, settled, roots.streams, Unprefixed, None, false, mut cold_roots, mut graph)?
    resolve_data_page(packs, inventory, settled, roots.catalog, Unprefixed, None, false, mut cold_roots, mut graph)?
    for ptr in roots.keyed {
        resolve_data_page(packs, inventory, settled, ptr, Unprefixed, None, false, mut cold_roots, mut graph)?
    }
    Ok(())
}

pub type ValidatedPageManifest {
    manifest: PageManifest,
    inventory: Map[u64, pages.PagePack],
    lineage: Lineage,
    graph: PageGraph,
    allow_tiered: bool
}

fn parse_pack_filename(raw: Bytes, from: u64, end: u64) -> Option[(u64, bool)] {
    let total = end - from
    // Minimum canonical pack filename is "p-1" (3 bytes).
    if total < 3 || raw[from] != 112u8 || raw[from + 1] != 45u8 {
        return None
    }
    let temporary = total >= 7 && raw[end - 4] == 46u8 && raw[end - 3] == 116u8 && raw[end - 2] == 109u8 && raw[end - 1] == 112u8
    let digits_end = if temporary {
        end - 4
    } else {
        end
    }
    let digits_start = from + 2
    if digits_end <= digits_start || digits_end - digits_start > 20 {
        return None
    }
    // Canonical u64 >= 1: first digit is '1'..'9' (no leading zeros, no p-0).
    let first = raw[digits_start]
    if first < 49u8 || first > 57u8 {
        return None
    }
    let mut seq = 0u64
    for at in digits_start .. digits_end {
        let byte = raw[at]
        if byte < 48u8 || byte > 57u8 {
            return None
        }
        let Some(shifted) = int.checked_mul(seq, 10) else {
            return None
        }
        let digit: u64 = int.widen(byte - 48u8)
        let Some(advanced) = int.checked_add(shifted, digit) else {
            return None
        }
        seq = advanced
    }
    Some((seq, temporary))
}

// Reclaim every canonical p-<seq>.tmp and every canonical p-<seq> absent from
// the validated positive inventory (L ∪ C) in O(1) memory, closing the
// directory stream before unlinking each sorted batch (v2.145, AP21 step 5).
fn cleanup_dead_packs(d: Dir, inventory: Map[u64, pages.PagePack], mut name: String) -> Result[(), types.Failure] waits {
    let (take buf_init, take batch_init) = disk_allocation(fn() -> Result[(Bytes, List[(u64, bool)]), types.Failure] {
        Ok((list.with_capacity(1024), list.with_capacity(64)))
    })?
    let mut buf = take buf_init
    let mut batch = take batch_init
    loop {
        list.clear(mut batch)
        let mut listing = disk_io(host.entries(d, None))?
        let mut full = false
        loop {
            list.clear(mut buf)
            let read_entries = disk_io(host.next_entries(mut listing, mut buf))?
            if read_entries == 0 {
                break
            }
            let mut offset = 0u64
            while offset < list.len(buf) {
                let kind = buf[offset]
                let size: u16 = list.word_le(buf, offset + 1)
                let from = offset + 3
                offset = from + int.widen(size)
                // Skip directories (1) and symlinks (2); accept files (0) and unknown (3).
                if kind == 1u8 || kind == 2u8 {
                    continue
                }
                if let Some((seq, temporary)) = parse_pack_filename(buf, from, offset) {
                    if temporary || !map.contains(inventory, seq) {
                        list.push(mut batch, (seq, temporary))
                        if list.len(batch) == 64 {
                            full = true
                            break
                        }
                    }
                }
            }
            if full {
                break
            }
        }
        drop(take listing)
        if list.len(batch) == 0 {
            break
        }
        list.sort(mut batch, fn(a: (u64, bool), b: (u64, bool)) -> Order {
            match order.compare(a.0, b.0) {
                Equal => order.compare(a.1, b.1),
                other => other,
            }
        })
        let mut removed_any = false
        for (seq, temporary) in batch {
            string.truncate(mut name, 0)
            string.push(mut name, "p-")
            string.push_u64(mut name, seq)
            if temporary {
                string.push(mut name, ".tmp")
            }
            if disk_remove_optional(d, name)? {
                removed_any = true
            }
        }
        if !full || !removed_any {
            break
        }
    }
    Ok(())
}

pub fn cleanup_page_manifest(d: Dir, validated: ValidatedPageManifest) -> Result[(), types.Failure] waits {
    let mut name = disk_allocation(scoped fn() -> Result[String, types.Failure] {
        Ok(string.with_capacity(26))
    })?
    let _ = disk_remove_optional(d, "MANIFEST.tmp")?
    cleanup_dead_packs(d, validated.inventory, mut name)?
    for old in validated.manifest.prev_first .. validated.manifest.first_live {
        remove_numbered(d, "j-", old, true, mut name)?
    }
    Ok(())
}

pub fn publish_page_manifest_bytes(d: Dir, raw: Bytes) -> Result[(), types.Failure] waits {
    // This is the pack directory's barrier. The MANIFEST has its own file
    // sync and its rename has its own directory barrier below.
    disk_io(host.sync_dir(d))?
    disk_write_synced(d, "MANIFEST.tmp", raw)?
    disk_io(host.rename(d, "MANIFEST.tmp", "MANIFEST"))?
    disk_io(host.sync_dir(d))
}

pub fn journal_path(seq: u64, suffix: String) -> Result[String, types.Failure] {
    disk_allocation(scoped fn() -> Result[String, types.Failure] {
        types.capacity(disk_path("j-", seq, suffix))
    })
}

// The lookahead needs only the next HEADER's prev_end. Read that prefix, not
// a second whole segment, while the current segment's buffer is retained.
pub fn journal_header(d: Dir, id: types.StoreKey, seq: u64, flush: Option[Clock]) -> Result[Option[format.DiskHeader], types.Failure] waits {
    let path = journal_path(seq, "")?
    let mut file = match host.open(d, path, Read) {
        Ok(take file) => take file,
        Error(NotFound) => return Ok(None),
        Error(e) => return Error(Io(e))
    }
    if let Some(c) = flush {
        journal_wait_shared(mut file, c)?
        disk_io(host.sync(mut file))?
    }
    let mut raw = disk_read_buffer(72)?
    while list.len(raw) < 72 {
        let mut chunk = disk_read_buffer(72 - list.len(raw))?
        if disk_io(host.read(mut file, mut chunk))? == 0 {
            break
        }
        list.append(mut raw, chunk)
    }
    disk_io(host.close(take file))?
    Ok(Some(disk_read_header(path, raw, 2, Some(seq), Some(id))?))
}

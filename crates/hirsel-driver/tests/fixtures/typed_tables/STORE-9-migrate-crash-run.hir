// rule: STORE-9
// expect: run
// A crash at each storage write of a migration, its install and the deletion
// of the replaced rows included, leaves after reopening either the old table
// or the migrated one, complete; a crash at each write of a drop (STORE-5)
// leaves the table or nothing of it. The tables exceed what one commit holds.
@serializable
type Item {
  label: String,
  count: u32,
}

@serializable
type Priced {
  label: String,
  cents: u64,
}

fn price(c: (), key: String, old: Item) -> Result[(String, Priced), ()] {
  Ok((unique key, Priced(label: unique old.label, cents: int.widen(old.count) * 100)))
}

fn items() -> table.Table[String, Item] {
  table.named("items")
}

fn priced() -> table.Table[String, Priced] {
  table.named("items")
}

fn gone() -> table.Table[String, Item] {
  table.named("gone")
}

// The table has 6 rows under long keys, too many for one commit to rewrite or
// delete. Key order is row order.
fn row_key(k: u32) -> String uses {} {
  let mut out = f"row {k}"
  let mut i: u32 = 0
  while i < 7 {
    out = f"{out} under a key long enough that deleting every row outgrows a commit"
    i += 1
  }
  out
}

fn label(k: u32) -> String uses {} {
  f"item {k}"
}

fn tight() -> store.StoreConfig uses {} {
  let mut config = store.default_config()
  config.limits.transaction_bytes = 2500
  config
}

// Every key stored under a table's rows, whatever its generation.
fn stored(mut s: store.Store[Dir], name: String) -> u64 {
  let snap = store.snapshot(mut s)
  let mut prefix: List[u8] = []
  bytes.append(mut prefix, b"hirsel.rows/")
  bytes.append(mut prefix, keys.encode(name))
  let (low, high) = store.prefix_bounds(bytes.from_list(take prefix))
  list.len(store.range(snap, low, high, Ascending(), 200))
}

fn leftovers(mut s: store.Store[Dir]) -> u64 {
  let snap = store.snapshot(mut s)
  let (low, high) = store.prefix_bounds(b"hirsel.garbage/")
  list.len(store.range(snap, low, high, Ascending(), 10))
}

fn seed(mut s: store.Store[Dir], name: String) -> bool {
  store.transact(mut s, seed_rows, name) == Ok(())
}

fn seed_rows(mut tx: store.Tx, info: store.CallInfo, name: String) -> Result[
  (),
  store.TxError
] {
  let t: table.Table[String, Item] = table.named(name)
  table.create(mut tx, t)?
  for k in 1u32..7u32 {
    table.put(mut tx, t, row_key(k), Item(label: label(k), count: k))?
  }
  Ok(())
}

// 1 for the old table, every row intact and writable; 2 for the migrated one,
// every row priced; 0 for anything else. The table's keys are exactly its
// 6 rows either way, and nothing waits to be deleted.
fn old_or_new(mut s: store.Store[Dir]) -> u8 {
  let read = store.transact(mut s, which_table, ())
  if stored(mut s, "items") != 6 || leftovers(mut s) != 0 {
    return 0
  }
  match read {
    Ok(found) => found,
    _ => 0,
  }
}

// 1 for the table whole, 2 for nothing of it, 0 for anything else.
fn whole_or_none(mut s: store.Store[Dir]) -> u8 {
  let read = store.transact(mut s, gone_rows, ())
  let n = stored(mut s, "gone")
  if leftovers(mut s) != 0 {
    return 0
  }
  if read == Ok(6) && n == 6 {
    return 1
  }
  if read == Ok(99) && n == 0 {
    return 2
  }
  0
}

// A store holding `t` seeded, in a fresh directory.
fn fresh(t: Test, name: String) -> Result[Dir, store.StoreError] {
  let d = test.dir(t, [])
  let mut s = store.open(d, store.default_config())?
  let ok = seed(mut s, name)
  store.close(take s)?
  if !ok {
    return Error(Corrupt("seed"))
  }
  Ok(d)
}

// Migrates the table in `d` with the store stopping after `n` storage writes,
// then reopens: 1 or 2 as `old_or_new` after a crash, 3 for a migration that
// completed, 0 for anything else.
fn migrate_crashing(d: Dir, sc: Scope, n: u64) -> Result[u8, store.StoreError] {
  let mut config = tight()
  config.faults = StopAfterWrites(n)
  // A crash while opening is a crash before the migration starts.
  let opened = store.open(d, config)
  let mut faulty = match take opened {
    Ok(opened_store) => opened_store,
    Error(_) => {
      let mut reopened = store.open(d, tight())?
      let found = old_or_new(mut reopened)
      store.close(take reopened)?
      if found == 1 {
        return Ok(1)
      }
      return Ok(0)
    },
  }
  let outcome: u8 = match table.migrate(sc, mut faulty, items(), priced(), price, 2) {
    Ok(6) => {
      store.close(take faulty)?
      3
    },
    Error(Table(Storage(_))) => 1,
    _ => 0,
  }
  let mut reopened = store.open(d, tight())?
  let found = old_or_new(mut reopened)
  store.close(take reopened)?
  if outcome == 3 {
    if found == 2 {
      return Ok(3)
    }
    return Ok(0)
  }
  if outcome == 0 {
    return Ok(0)
  }
  Ok(found)
}

// Drops the table in `d` with the store stopping after `n` storage writes,
// then reopens: 1 or 2 as `whole_or_none` after a crash, 3 for a drop that
// completed, 0 for anything else.
fn drop_crashing(d: Dir, n: u64) -> Result[u8, store.StoreError] {
  let mut config = tight()
  config.faults = StopAfterWrites(n)
  // A crash while opening is a crash before the drop starts.
  let opened = store.open(d, config)
  let mut faulty = match take opened {
    Ok(opened_store) => opened_store,
    Error(_) => {
      let mut reopened = store.open(d, tight())?
      let found = whole_or_none(mut reopened)
      store.close(take reopened)?
      if found == 1 {
        return Ok(1)
      }
      return Ok(0)
    },
  }
  let outcome: u8 = match table.drop(mut faulty, gone()) {
    Ok(()) => {
      store.close(take faulty)?
      3
    },
    Error(Aborted(_)) => 0,
    Error(_) => 1,
  }
  let mut reopened = store.open(d, tight())?
  let found = whole_or_none(mut reopened)
  store.close(take reopened)?
  if outcome == 3 {
    if found == 2 {
      return Ok(3)
    }
    return Ok(0)
  }
  if outcome == 0 {
    return Ok(0)
  }
  Ok(found)
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  task.scope(
    test.tasks(t),
    fn(sc: Scope) -> Result[(), store.StoreError] {
      scenario(t, sc)
    }
  )
}

fn scenario(t: Test, sc: Scope) -> Result[(), store.StoreError] {
  // No one commit rewrites or deletes every row of the table.
  let d = fresh(t, "items")?
  let mut small = store.open(d, tight())?
  let too_large = store.transact(mut small, delete_rows, 7u32)
  test.check(t, too_large == Error(Aborted(Limit(TransactionBytes()))))
  store.close(take small)?
  // Crashes before the install leave the old table, crashes after it the new.
  // A store left as it was serves the next position; any other is seeded anew.
  let mut seen: List[bool] = [false, false, false, false]
  let mut n: u64 = 0
  let mut at = d
  while !seen[3] && n < 200 {
    let found = migrate_crashing(at, sc, n)?
    seen[int.widen(found)] = true
    if found != 1 {
      at = fresh(t, "items")?
    }
    n += 1
  }
  test.check(t, !seen[0] && seen[1] && seen[2] && seen[3])
  let mut dropped: List[bool] = [false, false, false, false]
  n = 0
  at = fresh(t, "gone")?
  while !dropped[3] && n < 200 {
    let found = drop_crashing(at, n)?
    dropped[int.widen(found)] = true
    if found != 1 {
      at = fresh(t, "gone")?
    }
    n += 1
  }
  test.check(t, !dropped[0] && dropped[1] && dropped[2] && dropped[3])
  Ok(())
}

// 1 for the old table, every row intact and writable; 2 for the migrated
// one, every row priced; 0 for anything else.
fn which_table(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[
  u8,
  store.TxError
] {
  match table.range(tx, items(), Unbounded(), Unbounded(), 200, Ascending()) {
    Ok(rows) => {
      let mut k: u32 = 0
      for row in rows {
        k += 1
        if row != (row_key(k), Item(label: label(k), count: k)) {
          return Ok(0)
        }
      }
      table.put(mut tx, items(), "written", Item(label: "written", count: 99))?
      if k == 6 && table.delete(mut tx, items(), "written")? {
        return Ok(1)
      }
      Ok(0)
    },
    Error(Schema(_)) => {
      let rows = table.range(tx, priced(), Unbounded(), Unbounded(), 200, Ascending())?
      let mut k: u32 = 0
      for row in rows {
        k += 1
        if row != (row_key(k), Priced(label: label(k), cents: int.widen(k) * 100)) {
          return Ok(0)
        }
      }
      if k == 6 {
        return Ok(2)
      }
      Ok(0)
    },
    Error(e) => Error(e),
  }
}

// The rows of `gone`, or 99 when it does not exist.
fn gone_rows(mut tx: store.Tx, info: store.CallInfo, a: ()) -> Result[
  u64,
  store.TxError
] {
  match table.range(tx, gone(), Unbounded(), Unbounded(), 200, Ascending()) {
    Ok(rows) => Ok(list.len(rows)),
    Error(NoTable()) => Ok(99),
    Error(e) => Error(e),
  }
}

fn delete_rows(mut tx: store.Tx, info: store.CallInfo, n: u32) -> Result[
  (),
  store.TxError
] {
  for k in 1u32..n {
    let _ = table.delete(mut tx, items(), row_key(k))?
  }
  Ok(())
}

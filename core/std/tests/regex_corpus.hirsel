// test-of: std.regex
// test-reason: RX1 checks private syntax before the matching API is available.
// Generated by core/tools/regex_oracle.rs from the pinned regex-syntax crate.
fn oracle_syntax(p: String, expected: Option[SyntaxError]) -> bool {
    match compile_hir(p) {
        Ok(_) => expected == None,
        Error(Syntax(e)) => expected == Some(e),
        Error(_) => false,
    }
}


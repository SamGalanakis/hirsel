// L2 across task ownership: the reader owns roots from before 1000 later commits.
// Wrong implementation caught: a non-send snapshot or a view tied to the writer.
pub fn law_reader_task(c: Clock, tasks: Tasks) -> bool waits {
    let mut db = test_db(c, 1073741824)
    for k in 0u64 .. 24 {
        if !put_one(mut db, k, k + 1) {
            return false
        }
    }
    let held = snapshot(db)
    let reader = result.unwrap(task.spawn(tasks, bytes 1048576, take held, fn(take s: Snapshot) -> bool {
        let mut rows = result.unwrap(scan_bytes(s, 1, Unbounded, Unbounded))
        for k in 0u64 .. 24 {
            if value_at(s, k) != k + 1 {
                return false
            }
            match result.unwrap(next_bytes(mut rows)) {
                Some((_, v)) => if decode_word(v) != k + 1 {
                    return false
                },
                None => return false
            }
        }
        version(s) == 24 && result.unwrap(next_bytes(mut rows)) == None
    }))
    for k in 0u64 .. 1000 {
        if !put_one(mut db, k % 24, 10000 + k) {
            return false
        }
    }
    result.unwrap(task.join(take reader))
}


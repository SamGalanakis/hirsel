// rule: CT-5
// expect: run
// stdout: 128
// CT-5: a generated declaration whose comptime expression is a block binding
// locals of the declaration's type parameters before calling the generator.
fn body[T, K: serializable](s: TypeShape[T], k: Option[K]) -> Result[
  Body[fn(T) -> u64 uses {}],
  String
] uses {} {
  let n = bytes.len(codec.encode(k))
  let name = type_shape.info(s).name
  Ok(codegen.body(f"fn(_t: {name}) -> u64 uses {{}} {{ {n} }}"))
}

type Holder[K] {
  key: Option[K],
}

fn sized[K: serializable](h: Holder[K]) -> u64 uses {} = comptime {
  let k: Option[K] = None()
  body(shape(Holder[K]), k)
}

pub fn main(rt: Io) -> Result[(), GrantError] {
  let out = io.stdout(rt)?
  let h: Holder[u64] = Holder(key: None())
  let _ = out.print(out, f"{sized(h)}\n")
  Ok(())
}

/// The S3 operation of an object-client job.
pub type Operation: key = S3Open | S3Fetch | S3FetchRange | S3FetchChanged | S3Put | S3PutConditional | S3PutIf | S3ListObjects | S3Erase | S3Upload | S3Part | S3Complete | S3CompleteConditional | S3Abort | S3Head | S3ListUploads | S3GetBucketLocation

/// The wire operation or purpose of a Bucket request.
pub type RequestKind: key = ObjectRequest(Operation) | ReconcileWrite | ValidateCredentials

/// Lifetime totals for one client and request kind. Attempts include local
/// failures before any bytes could be sent. Starts may have sent request bytes.
/// Responses count accepted response heads, including unsuccessful statuses.
/// Successes count exchanges that returned a usable result.
pub type RequestCounts: shareable + send {
    jobs: u64,
    attempts: u64,
    retries: u64,
    starts: u64,
    responses: u64,
    successes: u64
}

pub type AttemptObservation {
    started: bool,
    answered: bool
}

pub const EMPTY_REQUEST_COUNTS: RequestCounts = RequestCounts(jobs: 0, attempts: 0, retries: 0, starts: 0, responses: 0, successes: 0)

pub type LaneCounts: shareable + send {
    rows: Inline[RequestCounts, 19]
}

pub fn request_index(kind: RequestKind) -> u64 {
    match kind {
        ObjectRequest(S3Open) => 0,
        ObjectRequest(S3Fetch) => 1,
        ObjectRequest(S3FetchRange) => 2,
        ObjectRequest(S3FetchChanged) => 3,
        ObjectRequest(S3Put) => 4,
        ObjectRequest(S3PutConditional) => 5,
        ObjectRequest(S3PutIf) => 6,
        ObjectRequest(S3ListObjects) => 7,
        ObjectRequest(S3Erase) => 8,
        ObjectRequest(S3Upload) => 9,
        ObjectRequest(S3Part) => 10,
        ObjectRequest(S3Complete) => 11,
        ObjectRequest(S3CompleteConditional) => 12,
        ObjectRequest(S3Abort) => 13,
        ObjectRequest(S3Head) => 14,
        ObjectRequest(S3ListUploads) => 15,
        ObjectRequest(S3GetBucketLocation) => 16,
        ReconcileWrite => 17,
        ValidateCredentials => 18,
    }
}

pub fn count_attempt(mut counts: RequestCounts, seen: AttemptObservation, retrying: bool, successful: bool) {
    counts.attempts = int.saturating_add(counts.attempts, 1)
    if retrying {
        counts.retries = int.saturating_add(counts.retries, 1)
    }
    if seen.started {
        counts.starts = int.saturating_add(counts.starts, 1)
    }
    if seen.answered {
        counts.responses = int.saturating_add(counts.responses, 1)
    }
    if successful {
        counts.successes = int.saturating_add(counts.successes, 1)
    }
}

pub fn add_counts(mut total: RequestCounts, counts: RequestCounts) {
    total.jobs = int.saturating_add(total.jobs, counts.jobs)
    total.attempts = int.saturating_add(total.attempts, counts.attempts)
    total.retries = int.saturating_add(total.retries, counts.retries)
    total.starts = int.saturating_add(total.starts, counts.starts)
    total.responses = int.saturating_add(total.responses, counts.responses)
    total.successes = int.saturating_add(total.successes, counts.successes)
}

pub fn method(op: Operation) -> String {
    match op {
        S3Open => "GET",
        S3Fetch => "GET",
        S3FetchRange => "GET",
        S3FetchChanged => "GET",
        S3GetBucketLocation => "GET",
        S3ListObjects => "GET",
        S3ListUploads => "GET",
        S3Head => "HEAD",
        S3Put => "PUT",
        S3PutConditional => "PUT",
        S3PutIf => "PUT",
        S3Part => "PUT",
        S3Erase => "DELETE",
        S3Abort => "DELETE",
        S3Upload => "POST",
        S3Complete => "POST",
        S3CompleteConditional => "POST",
    }
}

pub fn field_name(index: u64) -> String {
    match index {
        0 => "host",
        1 => "if-match",
        2 => "if-none-match",
        3 => "range",
        4 => "x-amz-checksum-crc32c",
        5 => "x-amz-content-sha256",
        6 => "x-amz-date",
        7 => "x-amz-meta-hirsel-put-id",
        8 => "x-amz-security-token",
        9 => "authorization",
        _ => fail("unknown signed field"),
    }
}

pub fn uploads_body(op: Operation) -> bool {
    op == S3Put || op == S3PutConditional || op == S3PutIf || op == S3Part || op == S3Complete || op == S3CompleteConditional
}

pub fn payload_read(op: Operation) -> bool {
    op == S3Fetch || op == S3FetchRange || op == S3FetchChanged
}

fn ascii(b: u8) -> char {
    option.unwrap(char.from_u32(int.widen(b)))
}

// S3 canonical paths preserve every slash and escape all octets outside the
// unreserved set, including characters that RFC 3986 allows in path segments.
pub fn percent_encode(mut out: String, raw: Bytes, keep_slash: bool) {
    for b in raw {
        if int.is_ascii_alpha(b) || int.is_ascii_digit(b) || b == b'-' || b == b'_' || b == b'.' || b == b'~' || keep_slash && b == b'/' {
            string.push_char(mut out, ascii(b))
        } else {
            let (hi, lo) = hex.encode_byte(b, true)
            string.push_char(mut out, '%')
            string.push_char(mut out, ascii(hi))
            string.push_char(mut out, ascii(lo))
        }
    }
}

pub fn encode_checksum(mut out: Bytes, crc: u32) {
    let abc = string.as_bytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    for shift in 0u32 .. 5 {
        list.push(mut out, abc[int.widen((crc >> (26 - shift * 6)) & 63)])
    }
    list.push(mut out, abc[int.widen((crc & 3) << 4)])
    list.append(mut out, string.as_bytes("=="))
}

pub fn fresh_id(random: Random, mut raw: Bytes) -> Inline[u8, 16] {
    list.clear(mut raw)
    host.random(random, mut raw)
    let mut id: Inline[u8, 16] =[0; 16]
    for i in 0u64 .. 16 {
        id[i] = raw[i]
    }
    id
}

pub fn decode_id(data: Bytes) -> Option[Inline[u8, 16]] {
    if list.len(data) != 32 {
        return None
    }
    let mut id: Inline[u8, 16] =[0; 16]
    for i in 0u64 .. 16 {
        let a = hex.digit(data[i * 2])
        if a == 255 {
            return None
        }
        let b = hex.digit(data[i * 2 + 1])
        if b == 255 {
            return None
        }
        id[i] = a * 16 + b
    }
    Some(id)
}

pub fn start_request(mut c: http_client.Connection, wire: http_client.Request, deadline: u64, mut seen: AttemptObservation) -> Result[(), http_client.Error] waits {
    let started = http_client.start(mut c, wire, deadline)
    seen.started = http_client.request_started(c)
    started
}

pub type Phase: key = BeforeRequest | RequestSent | ResponseHead | ResponseBody

pub type Decision: key = Accept | Retry | Throttle | Resolve | AlreadyExists | Missing | Changed | Refresh | CorrectSkew | Reject

pub fn classify(op: Operation, phase: Phase, status: u16, code: Bytes, resolving: bool, pinned: bool) -> Decision {
    if op == S3PutIf {
        if phase == BeforeRequest || status == 409 || (status == 400 && code == string.as_bytes("RequestTimeout")) {
            return Retry
        }
        if status == 412 {
            return AlreadyExists
        }
        if status == 0 || status == 429 || (status >= 500 && status < 600) {
            return Resolve
        }
        return Reject
    }
    let conditional = op == S3PutConditional || op == S3CompleteConditional
    let uncertain = conditional || op == S3Complete
    if phase == BeforeRequest {
        return Retry
    }
    if status == 0 {
        if uncertain && (phase == RequestSent || phase == ResponseBody) {
            return Resolve
        }
        return Retry
    }
    if (status == 400 || status == 200) && code == string.as_bytes("RequestTimeout") {
        return Retry
    }
    if (status == 400 || status == 200) && code == string.as_bytes("RequestTimeTooSkewed") {
        return CorrectSkew
    }
    if (status == 403 || status == 200) && code == string.as_bytes("ExpiredToken") {
        return Refresh
    }
    if status == 304 || status == 412 {
        if conditional {
            return if resolving {
                Resolve
            } else {
                AlreadyExists
            }
        }
        return Changed
    }
    if status == 404 {
        return if op == S3Erase || op == S3Abort {
            Accept
        } else {
            Missing
        }
    }
    if status == 409 && pinned && payload_read(op) {
        return Retry
    }
    if status == 429 || status == 503 || code == string.as_bytes("SlowDown") {
        return if uncertain {
            Resolve
        } else {
            Throttle
        }
    }
    if status == 500 || status == 502 || status == 504 || code == string.as_bytes("InternalError") {
        return if uncertain {
            Resolve
        } else {
            Retry
        }
    }
    if status >= 200 && status < 300 && list.len(code) == 0 {
        return Accept
    }
    Reject
}

pub fn header(head: http_client.ResponseHead, name: String) -> Option[View[Bytes]] in head {
    let key = string.as_bytes(name)
    for i in 0u64 .. http_client.field_count(head) {
        let (field, value) = option.unwrap(http_client.field_at(head, i))
        if http1.equal_ascii(field, key) {
            return Some(value)
        }
    }
    None
}

pub fn content_length(head: http_client.ResponseHead) -> Option[u64] {
    let Some(value) = header(head, "content-length") else {
        return None
    }
    match int.parse_decimal_span(value, 0, list.len(value), 18446744073709551615u64) {
        Ok(n) => Some(n),
        Error(_) => None,
    }
}

pub fn new_meta() -> object.Meta {
    object.Meta(size: 0, etag: empty_tag(), crc64: None, put_id: None)
}

pub fn empty_tag() -> object.ETag {
    object.ETag(octets: [0; 64], len: 0)
}

pub fn etag(data: Bytes) -> Result[object.ETag, object.Error] {
    if list.len(data) > 64 {
        return Error(Fatal(Malformed))
    }
    let mut result = empty_tag()
    result.len = list.len(data)
    for i in 0u64 .. result.len {
        result.octets[i] = data[i]
    }
    Ok(result)
}

pub fn strong_tag(tag: object.ETag) -> bool {
    if tag.len < 2 || tag.len > 64 || tag.octets[0] != b'"' || tag.octets[tag.len - 1] != b'"' {
        return false
    }
    for i in 1u64 .. tag.len - 1 {
        let b = tag.octets[i]
        if b < 33 || b == b'"' || b == 127 {
            return false
        }
    }
    true
}

pub fn tag_bytes(tag: object.ETag) -> Bytes {
    let mut out: Bytes = list.with_capacity(tag.len)
    let _ = bytebuf.append_inline(mut out, tag.octets, 0, tag.len)
    take out
}

pub fn read_meta(head: http_client.ResponseHead, size: u64) -> Result[object.Meta, object.Error] {
    let mut out = new_meta()
    out.size = size
    if let Some(value) = header(head, "etag") {
        out.etag = etag(value)?
    }
    if let Some(value) = header(head, "x-amz-meta-hirsel-put-id") {
        out.put_id = decode_id(value)
    }
    if let Some(value) = header(head, "x-amz-checksum-crc64nvme") {
        if let Some(raw) = base64.decode(value) {
            if list.len(raw) == 8 {
                let mut n = 0u64
                for b in raw {
                    n = (n << 8) | int.widen(b)
                }
                out.crc64 = Some(n)
            }
        }
    }
    Ok(take out)
}

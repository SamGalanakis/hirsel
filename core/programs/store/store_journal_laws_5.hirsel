// AD1 (vi): the hand-written revision 0x00, 0x01, ..., 0x1f.
fn code_vector() -> Bytes {
    let mut raw: Bytes = list.new()
    list.fill(mut raw, 48, 9u8)
    raw
}

fn revision_vector() -> Bytes {
    let mut r: Bytes = list.with_capacity(32)
    for i in 0u64 .. 32 {
        list.push(mut r, int.truncate(i))
    }
    r
}

fn revision_is_vector(got: Option[Bytes]) -> bool {
    match got {
        Some(r) => r == revision_vector(),
        None => false
    }
}

fn revision_is_none(got: Option[Bytes]) -> bool {
    match got {
        Some(_) => false,
        None => true
    }
}

// L10/L12/L29: hand-laid payload with data followed by a Replied stream op and its CALL.
pub fn journal_law_payload() -> bool {
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, 3, 4))
    result.unwrap(le(mut payload, 257, 8))
    result.unwrap(le(mut payload, 1234, 8))
    result.unwrap(le(mut payload, 2, 1))
    result.unwrap(le(mut payload, 0, 1))
    result.unwrap(le(mut payload, 2, 4))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(blob(mut payload, string.as_bytes("key")))
    result.unwrap(le(mut payload, 0, 4))
    result.unwrap(blob(mut payload, string.as_bytes("value")))
    result.unwrap(le(mut payload, 2, 1))
    result.unwrap(blob(mut payload, string.as_bytes("gone")))
    result.unwrap(le(mut payload, 10, 4))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(le(mut payload, 1, 4))
    result.unwrap(le(mut payload, 3, 1))
    let stream = journal_vector_stream()
    result.unwrap(blob(mut payload, stream))
    let mut replied: Bytes = list.new()
    list.fill(mut replied, 40, 0u8)
    list.push(mut replied, 2u8)
    list.append(mut replied, string.as_bytes("reply"))
    result.unwrap(blob(mut payload, replied))
    result.unwrap(blob(mut payload, string.as_bytes("entry")))
    result.unwrap(blob(mut payload, string.as_bytes("arguments")))
    result.unwrap(blob(mut payload, revision_vector()))
    result.unwrap(blob(mut payload, code_vector()))
    result.unwrap(le(mut payload, 0, 1))
    let got = result.unwrap(journal_decode_commit("j-7", payload))
    if got.branch != 3 || got.version != 257 || got.at != 1234 || list.len(got.data) != 2 || list.len(got.streams) != 1 {
        return false
    }
    if got.data[0].key != string.as_bytes("key") || got.data[0].prior != 0 {
        return false
    }
    match got.data[0].value {
        Some(v) => if v != string.as_bytes("value") {
            return false
        },
        None => return false
    }
    if got.data[1].key != string.as_bytes("gone") || got.data[1].value != None || got.data[1].prior != 10 {
        return false
    }
    if got.streams[0].key != stream {
        return false
    }
    match got.streams[0].value {
        Some(v) => if v != replied {
            return false
        },
        None => return false
    }
    match got.call {
        Some(c) => if c.record.key != string.as_bytes("entry") || c.record.args != string.as_bytes("arguments") || c.record.stream != journal_vector_stream_name() || !revision_is_vector(c.record.revision) {
            return false
        },
        None => return false
    }
    // The 21-byte fixed header, 39-byte data section, 84-byte streams prefix,
    // 9-byte entry key and 13-byte args place revision at [166, 202).
    for size in 0u64 .. 2 {
        let mut other: Bytes = result.unwrap(copied(list.slice(payload, 0, 166)))
        result.unwrap(le(mut other, size, 4))
        if size == 1 {
            list.push(mut other, 0u8)
        }
        list.append(mut other, list.slice(payload, 202, list.len(payload)))
        let read_back = journal_decode_commit("j-7", other)
        if size == 1 {
            match read_back {
                Error(Corrupt(fault)) => match fault.why {
                    Malformed => {},
                    _ => return false
                },
                _ => return false
            }
        } else {
            match result.unwrap(take read_back).call {
                Some(c) => if !revision_is_none(c.record.revision) {
                    return false
                },
                None => return false
            }
        }
    }
    for i in 0u64 .. list.len(payload) {
        if !disk_corrupt(journal_decode_commit("j-7", list.slice(payload, 0, i))) {
            return false
        }
    }
    let mut trailing = result.unwrap(copied(payload))
    list.push(mut trailing, 0u8)
    if !disk_corrupt(journal_decode_commit("j-7", trailing)) {
        return false
    }
    // The CALL's stream op must have state Replied. The value starts at 98.
    let mut no_reply = result.unwrap(copied(payload))
    let _ = list.set(mut no_reply, 138, 1u8)
    if !disk_corrupt(journal_decode_commit("j-7", no_reply)) {
        return false
    }
    // A second op, put or delete, cannot overwrite the CALL's stream op.
    for tag in 1u64 .. 3 {
        let mut repeated: Bytes = result.unwrap(copied(payload))
        list.set_word_le(mut repeated, 61, 2u32)
        result.unwrap(le(mut repeated, tag, 1))
        result.unwrap(blob(mut repeated, stream))
        if tag == 1 {
            result.unwrap(blob(mut repeated, replied))
        }
        if !disk_corrupt(journal_decode_commit("j-7", repeated)) {
            return false
        }
    }
    let mut two_calls: Bytes = result.unwrap(copied(payload))
    list.set_word_le(mut two_calls, 61, 2u32)
    list.append(mut two_calls, list.slice(payload, 65, list.len(payload)))
    let _ = list.set(mut two_calls, list.len(payload) + 7, b'x')
    if !disk_corrupt(journal_decode_commit("j-7", two_calls)) {
        return false
    }
    // The stream section cannot precede data. Format 6 tag 2 accepts only control.
    let mut reversed: Bytes = result.unwrap(copied(list.slice(payload, 0, 21)))
    list.append(mut reversed, list.slice(payload, 60, list.len(payload)))
    list.append(mut reversed, list.slice(payload, 21, 60))
    if !disk_corrupt(journal_decode_commit("j-7", reversed)) {
        return false
    }
    let mut control: Bytes = result.unwrap(copied(list.slice(payload, 0, 21)))
    let _ = list.set(mut control, 20, 1u8)
    result.unwrap(le(mut control, 2, 1))
    list.append(mut control, list.slice(payload, 61, list.len(payload)))
    if !disk_corrupt(journal_decode_commit("j-7", control)) {
        return false
    }
    // Two sections with the same tag are malformed, including an empty one.
    let mut duplicate: Bytes = list.new()
    result.unwrap(le(mut duplicate, 0, 4))
    result.unwrap(le(mut duplicate, 1, 8))
    result.unwrap(le(mut duplicate, 2, 8))
    result.unwrap(le(mut duplicate, 2, 1))
    for i in 0u64 .. 2 {
        result.unwrap(le(mut duplicate, 0, 1))
        result.unwrap(le(mut duplicate, 0, 4))
    }
    disk_corrupt(journal_decode_commit("j-7", duplicate))
}

@test
fn journal_test_payload() -> Result[(), ()] {
    if journal_law_payload() {
        Ok(())
    } else {
        Error(())
    }
}

fn journal_empty_commit(ctx: DiskContext, offset: u64, head: u64) -> Bytes {
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, 0, 4))
    result.unwrap(le(mut payload, head, 8))
    result.unwrap(le(mut payload, head + 100, 8))
    result.unwrap(le(mut payload, 1, 1))
    result.unwrap(le(mut payload, 0, 1))
    result.unwrap(le(mut payload, 0, 4))
    result.unwrap(disk_seal(ctx, offset, 0x0011, 1, payload))
}

fn journal_scan_fixture(d: Dir, id: StoreId, raw: Bytes, boundary: Option[u64], final_item: bool) -> Result[(u64, u64, List[JournalEvent]), Error] waits {
    disk_write_synced(d, "j-7", raw)?
    let mut input = journal_input(disk_io(host.open(d, "j-7", Read))?, false)?
    let mut events: List[JournalEvent] = list.new()
    let scanned = journal_scan(mut input, "j-7", id, 7, 72, boundary, final_item, mut events, scoped fn(mut observed: List[JournalEvent], take event: JournalEvent) -> Result[(), Error] {
        list.push(mut observed, take event)
        Ok(())
    })
    let JournalInput(file: take opened_file, ..) = take input
    disk_io(host.close(take opened_file))?
    let (end, accepted) = scanned?
    Ok((end, accepted, take events))
}

// L3/L10/L11/L12: the fixture's two COMMIT frames are 42 bytes each.
// Every short prefix of the second frame is a torn tail at d=114
// and corruption at d=156.
fn journal_law_segment_boundaries(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let ctx = DiskContext(store: id, role: 2, seq: 7)
    let header = result.unwrap(disk_header_bytes(ctx, 0, 0))
    let first = journal_empty_commit(ctx, 72, 1)
    let second = journal_empty_commit(ctx, 114, 2)
    let mut raw = result.unwrap(copied(header))
    list.append(mut raw, first)
    list.append(mut raw, second)
    if list.len(raw) != 156 {
        return false
    }
    let (end, accepted, take events) = result.unwrap(journal_scan_fixture(d, id, raw, Some(114), true))
    if end != 156 || accepted != 84 || list.len(events) != 2 {
        return false
    }
    let (Commit(left), Commit(right)) = (events[0], events[1]) else {
        return false
    }
    if left.version != 1 || right.version != 2 {
        return false
    }
    let (middle_end, middle_bytes, take middle) = result.unwrap(journal_scan_fixture(d, id, raw, Some(114), false))
    if middle_end != 114 || middle_bytes != 42 || list.len(middle) != 1 {
        return false
    }
    // D3: the segment length survives, but every byte past the durable frame is zero.
    let mut zeroed = result.unwrap(copied(list.slice(raw, 0, 114)))
    list.fill(mut zeroed, 42, 0u8)
    let (zeroed_end, zeroed_bytes, take zeroed_events) = result.unwrap(journal_scan_fixture(d, id, zeroed, Some(114), true))
    if zeroed_end != 114 || zeroed_bytes != 42 || list.len(zeroed_events) != 1 {
        return false
    }
    let Commit(first_commit) = zeroed_events[0] else {
        return false
    }
    if first_commit.version != 1 || first_commit.at != 101 {
        return false
    }
    for n in 114u64 .. 156 {
        let tail = list.slice(raw, 0, n)
        let (partial_end, partial_bytes, take partial) = result.unwrap(journal_scan_fixture(d, id, tail, Some(114), true))
        if partial_end != 114 || partial_bytes != 42 || list.len(partial) != 1 {
            return false
        }
        if !disk_corrupt(journal_scan_fixture(d, id, tail, Some(156), true)) {
            return false
        }
    }
    for n in 72u64 .. 114 {
        let mut broken = result.unwrap(copied(raw))
        let changed = broken[n] ^ 1u8
        let _ = list.set(mut broken, n, changed)
        if !disk_corrupt(journal_scan_fixture(d, id, broken, Some(114), true)) {
            return false
        }
        let (torn_end, torn_bytes, take torn) = result.unwrap(journal_scan_fixture(d, id, broken, None, true))
        if torn_end != 72 || torn_bytes != 0 || list.len(torn) != 0 {
            return false
        }
    }
    if !disk_corrupt(journal_scan_fixture(d, id, raw, Some(115), true)) {
        return false
    }
    let empty: Bytes = list.new()
    let optional = result.unwrap(disk_seal(ctx, 72, 0x7ffe, 0, empty))
    let shifted = journal_empty_commit(ctx, 88, 1)
    let mut extended = result.unwrap(copied(header))
    list.append(mut extended, optional)
    list.append(mut extended, shifted)
    let (future_end, future_bytes, take future) = result.unwrap(journal_scan_fixture(d, id, extended, None, true))
    if future_end != 130 || future_bytes != 42 || list.len(future) != 1 {
        return false
    }
    // PRINCIPAL is a MUST kind no reader builds yet.
    let required = result.unwrap(disk_seal(ctx, 156, 0x0060, 1, empty))
    list.append(mut raw, required)
    match journal_scan_fixture(d, id, raw, Some(114), true) {
        Error(Unsupported(0x0060)) => true,
        _ => false
    }
}

fn journal_law_segment_fork(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let ctx = DiskContext(store: id, role: 2, seq: 7)
    let mut raw = result.unwrap(disk_header_bytes(ctx, 0, 0))
    list.append(mut raw, journal_empty_commit(ctx, 72, 64))
    list.append(mut raw, fork_frame_bytes())
    let (end, accepted, take events) = result.unwrap(journal_scan_fixture(d, id, raw, Some(160), true))
    if end != 160 || accepted != 88 || list.len(events) != 2 {
        return false
    }
    let (Commit(previous), Fork(read_fork)) = (events[0], events[1]) else {
        return false
    }
    previous.version == 64 && fork_frame_fields(read_fork)
}

fn journal_law_chunked_segment(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let context = DiskContext(store: id, role: 2, seq: 7)
    let mut raw = result.unwrap(disk_header_bytes(context, 0, 0))
    // Optional extension: offset 72, length 16 + 65,536, ending at 65,624.
    // Checksums are libxxhash over the independent wire layout and binding.
    result.unwrap(le(mut raw, 0x7ffe, 2))
    result.unwrap(le(mut raw, 0, 2))
    result.unwrap(le(mut raw, 65536, 4))
    result.unwrap(le(mut raw, 17032182677987914202, 8))
    list.fill(mut raw, 65536, 9u8)
    // One COMMIT: 42 + put (9 + key 12 + prior length 4 + value 65,536) = 65,603.
    result.unwrap(le(mut raw, 0x0011, 2))
    result.unwrap(le(mut raw, 1, 2))
    result.unwrap(le(mut raw, 65587, 4))
    result.unwrap(le(mut raw, 3906595394227617390, 8))
    result.unwrap(le(mut raw, 0, 4))
    result.unwrap(le(mut raw, 1, 8))
    result.unwrap(le(mut raw, 100, 8))
    result.unwrap(le(mut raw, 1, 1))
    result.unwrap(le(mut raw, 0, 1))
    result.unwrap(le(mut raw, 1, 4))
    result.unwrap(le(mut raw, 1, 1))
    result.unwrap(le(mut raw, 12, 4))
    result.unwrap(append_be(mut raw, 1, 4))
    result.unwrap(append_be(mut raw, 7, 8))
    result.unwrap(le(mut raw, 0, 4))
    result.unwrap(le(mut raw, 65536, 4))
    list.fill(mut raw, 65536, 17u8)
    list.fill(mut raw, 11, 0u8)
    let (end, accepted, take events) = result.unwrap(journal_scan_fixture(d, id, raw, Some(131227), true))
    if end != 131227 || accepted != 65603 || list.len(events) != 1 {
        return false
    }
    let Commit(commit) = events[0] else {
        return false
    }
    commit.version == 1
}

pub fn journal_law_segment(d: Dir) -> bool waits {
    let child = disk_test_directory(d)
    journal_law_segment_boundaries(child) && journal_law_segment_fork(child) && journal_law_chunked_segment(child)
}

@test
fn journal_test_segment(d: Dir) -> Result[(), ()] waits {
    if journal_law_segment(d) {
        Ok(())
    } else {
        Error(())
    }
}

// BL2 (case (a), L86, row 6a): wide groups over tail blocks. Each commit
// puts TAIL_PUTS rows in one transaction, so its group spans several
// 512-byte sectors of the block it starts in: behind the creation HEADER at
// 72 for each segment's first group, behind acked frames for the rest, and
// one group crosses into the next block so the tail is copied before the
// group after it. The cut after commit 1 makes j-(n + 1)'s first group wide.
// Commit k is head k + 2 and puts key 1000k + i = 1000k + i + 10.
const TAIL_PUTS: u64 = 48

const TAIL_COMMITS: u64 = 7

fn journal_tail_write(take writer: Db, t: Table[u64, u64], out: Stdout) -> Result[(), Error] waits {
    let mut db = take writer
    for k in 0u64 .. TAIL_COMMITS {
        let committed = run(mut db, None, (copy_env(t), copy_env(k)), fn(mut tx, call_env) -> Result[(), Error] {
            for i in 0u64 .. TAIL_PUTS {
                put(mut tx, call_env.0, 1000 * call_env.1 + i, 1000 * call_env.1 + i + 10)?
            }
            Ok(())
        })?
        let commit_ticket = match take committed {
            Committed(done) => done.ticket,
            _ => fail("BL2: a wide commit was refused")
        }
        durable(mut db, commit_ticket)?
        journal_note(out, db.heads[0].head)
        if k == 1 {
            let cut = checkpoint(mut db)?
            durable(mut db, cut)?
            journal_note(out, db.heads[0].head)
        }
    }
    close(take db)
}

// The commit law (acked ⊆ recovered ⊆ issued): the head lies in
// [minimum, TAIL_COMMITS + 1] and holds exactly commits 0 .. head - 2.
fn journal_tail_read(db: Db, t: Table[u64, u64], minimum: u64) -> Result[bool, Error] waits {
    let head = db.heads[0].head
    if head < 1 || head > TAIL_COMMITS + 1 || head < minimum {
        return Ok(false)
    }
    let sh = view t
    for k in 0u64 .. TAIL_COMMITS {
        for i in 0u64 .. TAIL_PUTS {
            let key = 1000 * k + i
            let expected = if k + 2 <= head {
                Some(key + 10)
            } else {
                None
            }
            if get(result.unwrap(reader(db, 0u64)), snapshot(db), sh, key)? != expected {
                return Ok(false)
            }
        }
    }
    Ok(true)
}

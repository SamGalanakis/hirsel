// A mut Region parameter lends a value place holding the region's pointer
// (`&mut ptr`, #88), so a callable over one is built; no stored Region row is
// invented for it.
// expect: accept
fn invoke(cb: fn(mut Region) -> u64) -> u64 {
    region r {
        let mut alias = r
        cb(mut alias)
    }
}

// expect: run item() = 7
// expect: run literal() = 11
@compact(u32)
type Stamp {
    n: u64
}

fn read(mut r: Region) -> u64 {
    let s = result.unwrap(make_stamp(r, 7));
    s.n
}

fn item() -> u64 {
    invoke(read)
}

fn literal() -> u64 {
    invoke(fn(mut r: Region) -> u64 {
        let s = result.unwrap(make_stamp(r, 11));
        s.n
    })
}

pub fn main() -> Result[(), Exit] {
    if item() + literal() == 18u64 {
        Ok(())
    } else {
        Error(Exit(status: 1))
    }
}

fn make_stamp(r: Region, n: u64) -> Result[Stamp in r, Capacity] {
    match build_in(r, bytes 8, fn(mut d: Dest[Stamp]) -> Result[Child[Stamp], BuildError] {
        dest.put(mut d, Stamp(n: n))
    }) {
        Ok(take built) => Ok(finish(take built)),
        Error(Overflow) => fail("fixed document size"),
    }
}

// Appended to the store module only by store_disk_bench.py. S2 open is private.
type DiskAccount: send + codec {
    id: u64,
    balance: i64,
    owner: String
}

fn disk_bench_bucket(a: DiskAccount) -> Result[u64, Capacity] { Ok(a.id % 4) }

fn disk_bench_upgrade(key: u64, a: DiskAccount) -> Result[Option[(u64, DiskAccount)], Capacity] {
    let changed = DiskAccount(id: a.id, balance: a.balance + 1, owner: clone(a.owner))
    Ok(Some((key, take changed)))
}

fn disk_bench_put(mut db: Db, t: Table[u64, DiskAccount], key: u64, balance: u64) waits {
    let done = result.unwrap(run(mut db, None, (copy_env(balance), copy_env(key), copy_env(t)), fn(mut tx, call_env) -> Result[(), Error] {
        let a = DiskAccount(id: call_env.1, balance: int.narrow(call_env.0), owner: string.from("owner000"))
        put(mut tx, call_env.2, call_env.1, a)
    }))
    if let Committed(_) = done {} else { fail("disk bench put") }
}

fn disk_bench_next_pack(d: Dir) -> u64 waits {
    let (_, manifest) = result.unwrap(read_page_manifest_file(d))
    manifest.next_pack
}

// R4/R5 (MEASURE.md, store-build-1010's workload): commit c (from 0) puts Account
// {id c % 16, balance c, owner "owner000"} at key c % 16 and returns c.
fn disk_bench_commit(mut db: Db, t: Table[u64, DiskAccount], c: u64) -> Ticket waits {
    let done = result.unwrap(run(mut db, None, (copy_env(c), copy_env(t)), fn(mut tx, call_env) -> Result[u64, Error] {
        let a = DiskAccount(id: call_env.0 % 16, balance: int.narrow(call_env.0), owner: string.from("owner000"))
        put(mut tx, call_env.1, call_env.0 % 16, a)?
        Ok(call_env.0)
    }))
    match done {
        Committed(take d) => {
            if d.value != c { fail("disk bench commit value") }
            d.ticket
        }
        _ => fail("disk bench commit")
    }
}

// R4: 10,000 commits, each run then durable; DONE is the sum of c. R5: commits back
// to back for 10 s, durable after every 64th, the clock read after each durable;
// DONE is the number of commits. Before READY, 64 durable commits. After the gate the
// store is closed, reopened by replay, and its 16 rows and version are checked.
fn disk_bench_journal(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout, mode: String) -> Result[(), Exit] waits {
    let child = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    let mut db = result.unwrap(open(tasks, child, c, r, options))
    let dictionary: std.codec.Codec[DiskAccount] = std.codec.of()
    result.unwrap(create_table(mut db, spec("accounts", std.codec.key_u64(), dictionary)))
    let t = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), dictionary))
    let mut n = 0u64
    while n < 64 {
        let committed = disk_bench_commit(mut db, t, n)
        result.unwrap(durable(mut db, committed))
        n += 1
    }
    let mut gate = result.unwrap(host.open(d, "gate", Read))
    let mut byte: Bytes = list.with_capacity(1)
    result.unwrap(stdout.write(out, "READY\n"))
    if result.unwrap(host.read(mut gate, mut byte)) != 1 { return Error(Exit(status: 7)) }
    let started = host.mono_ns(c)
    let mut reported = 0u64
    if mode == "R4" {
        for _ in 0u64 .. 10000 {
            reported += n
            let committed = disk_bench_commit(mut db, t, n)
            result.unwrap(durable(mut db, committed))
            n += 1
        }
    } else {
        loop {
            let mut latest_commit = disk_bench_commit(mut db, t, n)
            n += 1
            for _ in 1u64 .. 64 {
                latest_commit = disk_bench_commit(mut db, t, n)
                n += 1
            }
            result.unwrap(durable(mut db, latest_commit))
            if host.mono_ns(c) - started >= 10000000000 {
                break
            }
        }
        reported = n - 64
    }
    let elapsed = host.mono_ns(c) - started
    let mut rendered = string.new()
    string.push(mut rendered, "DONE ")
    string.push_u64(mut rendered, reported)
    string.push(mut rendered, " ")
    string.push_u64(mut rendered, elapsed)
    string.push(mut rendered, "\n")
    result.unwrap(stdout.write(out, rendered))
    list.clear(mut byte)
    if result.unwrap(host.read(mut gate, mut byte)) != 1 { return Error(Exit(status: 7)) }
    let closed_at = snapshot(db).head
    result.unwrap(close(take db))
    options.create = false
    let mut reopened = result.unwrap(open(tasks, child, c, r, options))
    let s = snapshot(reopened)
    if s.head != closed_at { fail("disk bench replayed version") }
    let mut t2 = result.unwrap(table(mut reopened, "accounts", std.codec.key_u64(), dictionary))
    let mut rows = result.unwrap(scan(result.unwrap(reader(reopened, 0u64)), s, t2, Unbounded, Unbounded))
    for k in 0u64 .. 16 {
        let expected_commit = (n - 1) - ((n - 1) % 16 + 16 - k) % 16
        let row = option.unwrap(result.unwrap(next(result.unwrap(reader(reopened, 0u64)), mut rows)))
        if row.0 != k || row.1.id != k || row.1.balance != int.narrow(expected_commit) || row.1.owner != "owner000" {
            fail("disk bench replayed row")
        }
    }
    if let Some(_) = result.unwrap(next(result.unwrap(reader(reopened, 0u64)), mut rows)) { fail("disk bench extra row") }
    let mut extra = string.new()
    string.push(mut extra, "COMMITS ")
    string.push_u64(mut extra, n)
    string.push(mut extra, " VERSION ")
    string.push_u64(mut extra, closed_at)
    string.push(mut extra, "\n")
    result.unwrap(stdout.write(out, extra))
    result.unwrap(close(take reopened))
    Ok(())
}

fn disk_bench_burst_commit(mut db: Db, t: Table[u64, DiskAccount], n: u64, width: u64) -> Ticket waits {
    let outcome = result.unwrap(run(mut db, None, (copy_env(n), copy_env(t), copy_env(width - 89)), fn(mut tx, input) -> Result[(), Error] {
        let mut raw: Bytes = list.with_capacity(input.2)
        list.fill(mut raw, input.2, 120u8)
        let account = DiskAccount(id: input.0 % 16, balance: int.narrow(input.0), owner: result.unwrap(string.from_utf8(take raw)))
        put(mut tx, input.1, input.0 % 16, account)
    }))
    let Committed(take done) = take outcome else { fail("disk bench burst commit") }
    done.ticket
}

fn disk_bench_burst(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout, width: u64, burst: u64, gate_name: String) -> Result[(), Exit] waits {
    if (width != 97 && width != 4096) || (burst != 1 && burst != 8 && burst != 64) {
        return Error(Exit(status: 7))
    }
    let child = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    // Keep the measured log in one segment for every row, including 64 × 4096.
    options.checkpoint_bytes = 1073741824
    options.journal_limit = options.checkpoint_bytes + FRAME_LIMIT
    let mut db = result.unwrap(open(tasks, child, c, r, options))
    let dictionary: std.codec.Codec[DiskAccount] = std.codec.of()
    result.unwrap(create_table(mut db, spec("accounts", std.codec.key_u64(), dictionary)))
    let t = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), dictionary))
    let mut n = 0u64
    while db.file_end - 72 < 8388608 {
        let committed = disk_bench_burst_commit(mut db, t, n, 4096)
        result.unwrap(durable(mut db, committed))
        n += 1
    }
    let mut file = result.unwrap(host.open(child, result.unwrap(journal_path(db.file_seq, "")), Read))
    let mut gate = result.unwrap(host.open(d, gate_name, Read))
    let mut byte: Bytes = list.with_capacity(1)
    let trials = 2000u64
    let mut latencies: List[u64] = list.with_capacity(trials * burst)
    let mut tickets: List[Ticket] = list.with_capacity(burst)
    let mut engaged = 0u64
    result.unwrap(stdout.write(out, "READY\n"))
    if result.unwrap(host.read(mut gate, mut byte)) != 1 { return Error(Exit(status: 7)) }
    let mut last_ack = host.mono_ns(c)
    for trial in 0u64 .. trials {
        let scheduled = last_ack + splitmix64(trial + 2177) % 2000001
        host.sleep_until(c, scheduled)
        let before = result.unwrap(host.stat_file(mut file)).size
        let start_end = db.file_end
        list.clear(mut tickets)
        for _ in 0u64 .. burst {
            list.push(mut tickets, disk_bench_burst_commit(mut db, t, n, width))
            n += 1
        }
        for committed in tickets {
            result.unwrap(durable(mut db, committed))
            last_ack = host.mono_ns(c)
            list.push(mut latencies, last_ack - scheduled)
        }
        let after = result.unwrap(host.stat_file(mut file)).size
        if before == after { engaged += 1 }
        if db.file_end - start_end != width * burst { fail("disk bench burst frame size") }
    }
    let mut report = string.with_capacity(trials * burst * 12)
    string.push(mut report, "BURST ")
    string.push_u64(mut report, engaged)
    string.push(mut report, " ")
    string.push_u64(mut report, db.file_end)
    for latency in latencies {
        string.push(mut report, " ")
        string.push_u64(mut report, latency)
    }
    string.push(mut report, "\n")
    result.unwrap(stdout.write(out, report))
    result.unwrap(host.close(take file))
    result.unwrap(close(take db))
    Ok(())
}

pub fn disk_bench_main(d: Dir, c: Clock, r: Random, tasks: Tasks, out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let mode = option.unwrap(args.get(argv, 0))
    if mode == "RB" {
        let width_arg = option.unwrap(args.get(argv, 1))
        let burst_arg = option.unwrap(args.get(argv, 2))
        let gate_name = option.unwrap(args.get(argv, 3))
        let width: u64 = result.unwrap(int.parse(width_arg))
        let burst: u64 = result.unwrap(int.parse(burst_arg))
        return disk_bench_burst(d, c, r, tasks, out, width, burst, gate_name)
    }
    if mode == "R4" || mode == "R5" {
        return disk_bench_journal(d, c, r, tasks, out, mode)
    }
    let indexed = option.unwrap(args.get(argv, 1)) == "1"
    let migrating = mode == "migrate"
    let million = mode == "R8-load" || mode == "R8-open"
    let n: u64 = if million { 1000000 } else { 100000 }
    // R8-load's phase is creation, population and the first checkpoint, so its
    // gate comes before the store exists; every other mode's comes after setup.
    let loading = mode == "R8-load"
    let mut gate = result.unwrap(host.open(d, "gate", Read))
    let mut byte: Bytes = list.with_capacity(1)
    let mut started = 0u64
    if loading {
        result.unwrap(stdout.write(out, "READY\n"))
        if result.unwrap(host.read(mut gate, mut byte)) != 1 { return Error(Exit(status: 7)) }
        started = host.mono_ns(c)
    }
    let child = disk_test_directory(d)
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    // The journal worker allowance and resident limit keep their defaults.
    let mut db = result.unwrap(open(tasks, child, c, r, options))
    let dictionary: std.codec.Codec[DiskAccount] = std.codec.of()
    result.unwrap(create_table(mut db, spec("accounts", std.codec.key_u64(), dictionary)))
    let mut t = result.unwrap(table(mut db, "accounts", std.codec.key_u64(), dictionary))
    if indexed {
        result.unwrap(create_index(mut db, t, "bucket", code.describe(disk_bench_bucket), std.codec.key_u64()))
        let _ = result.unwrap(bind_table_index(mut db, t, "bucket", code.describe(disk_bench_bucket), std.codec.key_u64()))
    }
    let catalog_cost = db.resident
    for k in 0u64 .. n { disk_bench_put(mut db, t, k, k) }
    let first = result.unwrap(checkpoint(mut db))
    result.unwrap(durable(mut db, first))
    // 62 + r8(12-byte key) + r8(30-byte value: schema 2, id 8, balance 8, owner u32 count 4 + 8); an index entry adds 86.
    let per_row: u64 = if indexed { 196 } else { 110 }
    if db.resident != catalog_cost + n * per_row { fail("disk bench account") }
    let first_pack = disk_bench_next_pack(child)
    let original_shape: Table[u64, DiskAccount] = clone(t)
    let migration = if migrating {
        let mut target = spec("migrated", std.codec.key_u64(), dictionary)
        if indexed {
            result.unwrap(with_index(mut target, "bucket", code.describe(disk_bench_bucket), std.codec.key_u64()))
        }
        Some(take target)
    } else {
        None
    }
    let original_head = db.heads[0].head
    if mode == "R6" {
        for i in 0u64 .. 64 {
            let k = splitmix64(i) % n
            disk_bench_put(mut db, t, k, 100000 + i)
        }
    }
    // Reopen modes release the populated database before READY.
    let mut holder: List[Db] = list.new()
    if mode == "R7" || mode == "R8-open" {
        result.unwrap(close(take db))
    } else {
        list.push(mut holder, take db)
    }
    if !loading {
        result.unwrap(stdout.write(out, "READY\n"))
        if result.unwrap(host.read(mut gate, mut byte)) != 1 { return Error(Exit(status: 7)) }
        started = host.mono_ns(c)
    }
    let mut timing: Option[CutTiming] = None
    if mode == "R7" || mode == "R8-open" {
        options.create = false
        let opened = result.unwrap(open(tasks, child, c, r, options))
        list.push(mut holder, take opened)
    } else if mode == "R6" {
        timing = Some(CutTiming(pause_ns: 0, removal_ns: 0, removal_attempts: 0, drain_groups: 0))
        let _ = result.unwrap(disk_cut_timed(mut holder[0], NoHolderChange, seal_page_manifest_file, mut timing))
    } else if let Some(take target) = take migration {
        let cut = result.unwrap(migrate(mut holder[0], take t, take target, disk_bench_upgrade))
        result.unwrap(durable(mut holder[0], cut))
    }
    let elapsed = host.mono_ns(c) - started
    let stored_rows = page_row_count(holder[0].heads[0].roots.collections)
    let expected_count = if indexed { 2 * n } else { n }
    if stored_rows != expected_count { fail("disk bench row count") }
    let mut rendered = string.new()
    string.push(mut rendered, "DONE ")
    string.push_u64(mut rendered, n)
    string.push(mut rendered, " ")
    string.push_u64(mut rendered, elapsed)
    string.push(mut rendered, "\n")
    result.unwrap(stdout.write(out, rendered))
    list.clear(mut byte)
    if result.unwrap(host.read(mut gate, mut byte)) != 1 { return Error(Exit(status: 7)) }
    if let Some(measured) = timing {
        let mut stats = string.new()
        string.push(mut stats, "CUT ")
        string.push_u64(mut stats, measured.pause_ns)
        string.push(mut stats, " REMOVAL ")
        string.push_u64(mut stats, measured.removal_ns)
        string.push(mut stats, " REMOVE_ATTEMPTS ")
        string.push_u64(mut stats, measured.removal_attempts)
        string.push(mut stats, " DRAIN_GROUP_SYNCS ")
        string.push_u64(mut stats, measured.drain_groups)
        string.push(mut stats, "\n")
        result.unwrap(stdout.write(out, stats))
    }
    // Full values are verified after the phase counters and RSS have stopped.
    let sh = if migrating {
        let target = result.unwrap(table(mut holder[0], "migrated", std.codec.key_u64(), dictionary))
        if holder[0].heads[0].head != original_head + 1 { fail("disk bench migrate version") }
        target
    } else {
        take original_shape
    }
    let s = snapshot(holder[0])
    let read = result.unwrap(reader(holder[0], 0u64))
    let mut rows = result.unwrap(scan(read, s, sh, Unbounded, Unbounded))
    for k in 0u64 .. n {
        let row = option.unwrap(result.unwrap(next(read, mut rows)))
        let mut balance = if migrating { k + 1 } else { k }
        if mode == "R6" {
            for i in 0u64 .. 64 {
                if splitmix64(i) % n == k { balance = 100000 + i }
            }
        }
        if row.0 != k || row.1.id != k || row.1.balance != int.narrow(balance) || row.1.owner != "owner000" {
            fail("disk bench wrong row")
        }
    }
    if let Some(_) = result.unwrap(next(read, mut rows)) { fail("disk bench extra row") }
    let (id, manifest) = result.unwrap(read_page_manifest_file(child))
    let mut written: u64 = 0
    let mut pages: u64 = 0
    for seq in first_pack .. manifest.next_pack {
        let path = result.unwrap(paged_pack_path(seq))
        let raw = result.unwrap(disk_read_file(child, path, options.pack_bytes + 72))
        written += list.len(raw)
        let ctx = result.unwrap(disk_read_header(path, raw, 3, Some(seq), Some(id))).context
        let mut offset = 72u64
        while offset < list.len(raw) {
            let frame = result.unwrap(disk_read_frame(path, ctx, raw, offset))
            if frame.kind == 0x0021 { pages += 1 }
            offset = frame.end
        }
    }
    let mut extra = string.new()
    string.push(mut extra, "PACK_BYTES ")
    string.push_u64(mut extra, written)
    string.push(mut extra, " NEW_PAGES ")
    string.push_u64(mut extra, pages)
    string.push(mut extra, " ACCOUNT ")
    string.push_u64(mut extra, holder[0].resident)
    string.push(mut extra, "\n")
    result.unwrap(stdout.write(out, extra))
    let mut finished = take holder
    let owned = option.unwrap(list.pop(mut finished))
    result.unwrap(close(take owned))
    Ok(())
}

// provide cells (core.md, Provide; CONC-7). A virtual Clock's timers fire only
// from clock.advance_to; clock.idle answers the earliest deadline still waited
// on once every other task waits. provide.random(seed) is SplitMix64 (Vigna's
// reference: seed 0 gives 0xe220a8397b1dcdaf, 0x6e789e6aa1b965f4,
// 0x06c45d188009454f), eight little-endian bytes per step, the last step cut
// to the spare capacity.
fn sleeper(take c: Clock) -> u64 waits {
    host.sleep_until(c, 100)
    host.mono_ns(c)
}

// The child sleeps until 100 on a clock that starts at 10. advance_to(50) is
// short of the deadline, so the child stays asleep and idle still reports 100.
// advance_to(150) wakes it and it reads 150. With no sleeper left, idle is None.
// expect: run virtual_sleep(tasks) = true
fn virtual_sleep(tasks: Tasks) -> bool waits {
    let (c, h) = provide.clock(10, 7)
    let mut hand = take h
    let child = task.spawn(tasks, bytes 65536, c, sleeper)
    let start = host.mono_ns(c) == 10 && host.wall_ms(c) == 7
    let first = clock.idle(mut hand) == Some(100)
    clock.advance_to(mut hand, 50)
    let short = clock.idle(mut hand) == Some(100) && host.mono_ns(c) == 50
    clock.advance_to(mut hand, 150)
    let woke = result.unwrap(task.join(take child)) == 150
    clock.set_wall(mut hand, 9)
    start && first && short && woke && clock.idle(mut hand) == None && host.wall_ms(c) == 9
}

// Moving a virtual clock backwards keeps it where it is (monotonic).
// expect: run never_back() = true
fn never_back() -> bool {
    let (c, h) = provide.clock(10, 0)
    let mut hand = take h
    clock.advance_to(mut hand, 5)
    host.mono_ns(c) == 10
}

// Seed 0: ten bytes are step one (8 LE bytes) and the first two of step two;
// the next eight bytes are step three (the rest of step two is not kept).
// expect: run seeded_bytes() = true
fn seeded_bytes() -> bool {
    let r = provide.random(0)
    let mut b: Bytes = list.with_capacity(10)
    host.random(r, mut b)
    let first = list.len(b) == 10 && b[0] == 0xaf && b[1] == 0xcd && b[2] == 0x1d && b[3] == 0x7b && b[4] == 0x39 && b[5] == 0xa8 && b[6] == 0x20 && b[7] == 0xe2 && b[8] == 0xf4 && b[9] == 0x65
    let mut c: Bytes = list.with_capacity(8)
    host.random(r, mut c)
    first && c[0] == 0x4f && c[1] == 0x45 && c[2] == 0x09 && c[3] == 0x80 && c[4] == 0x18 && c[5] == 0x5d && c[6] == 0xc4 && c[7] == 0x06
}

fn watcher(take p: Process) -> u64 waits {
    host.stopped(p)
    1
}

// A watcher of a provide.process Process completes only after its trigger.
// expect: run stopped_after_trigger(tasks) = true
fn stopped_after_trigger(tasks: Tasks) -> bool waits {
    let (p, t) = provide.process()
    let child = task.spawn(tasks, bytes 65536, p, watcher)
    process.trigger(take t)
    result.unwrap(task.join(take child)) == 1
}

type Peer: send {
    w: WriteHalf,
    hand: ClockHand,
    real: Clock,
    go: Receiver[u64]
}

// Writes one byte 20 ms of real time later, then, once the reader says so,
// moves the virtual clock to the reader's deadline. It hands its half back
// so the stream stays open (no end of stream) until the reader has joined.
fn peer(take p: Peer) -> WriteHalf waits {
    let Peer(w: take wh, hand: take h, real, go: take go) = take p
    let mut w = take wh
    let mut hand = take h
    host.sleep_until(real, host.mono_ns(real) + 20000000)
    let sent = result.unwrap(host.send_pair(mut w, string.as_bytes("x"), string.as_bytes(""), Never))
    let _ = result.unwrap(channel.receive(go))
    clock.advance_to(mut hand, 100 + sent - 1)
    take w
}

// CONC-7: a receive bounded by At(v, 100) on a virtual clock at 0 does not
// expire in real time (the byte sent 20 ms later arrives), and expires once
// advance_to reaches 100: the second receive gives TimedOut.
// expect: run virtual_deadline(network) = true
fn virtual_deadline(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (v, hand) = provide.clock(0, 0)
    let (listener, where_to) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 0), 1))
    let mut l = take listener
    let client = result.unwrap(host.connect(n, where_to, Never))
    let (server, _) = result.unwrap(host.accept(mut l, Never))
    let (unused_r, w) = net.split(take client)
    let (rh, unused_w) = net.split(take server)
    let mut r = take rh
    let (tx, rx): (Sender[u64], Receiver[u64]) = channel.new(1)
    let job = task.spawn(tasks, bytes 65536, Peer(w: take w, hand: take hand, real: c, go: take rx), peer)
    let mut b: Bytes = list.with_capacity(4)
    let first = host.recv_bounded(mut r, mut b, 4, At(v, 100))
    result.unwrap(channel.send(tx, 1))
    let second = host.recv_bounded(mut r, mut b, 4, At(v, 100))
    let kept = result.unwrap(task.join(take job))
    let arrived = match first {
        Ok(k) => k == 1,
        _ => false
    }
    let expired = match second {
        Error(TimedOut) => true,
        _ => false
    }
    arrived && expired && host.mono_ns(v) == 100
}

// A cell admits 32 bytes from the current limit (MEM-24), held until the run
// ends as a narrowed grant. A bound of 32 fits one cell: a second asks 32 of
// the 0 left. A bound of 24 refuses the first, asking 32 of 24.
// expect: run cell_charge() = true
fn cell_charge() -> bool {
    let one = bound bytes 32 {
        let r = provide.random(1)
        true
    }
    let fits = match one {
        Ok(v) => v,
        _ => false
    }
    let second = match refusal(isolate(fn() -> Result[bool, Capacity] {
        bound bytes 32 {
            let r = provide.random(1)
            let s = provide.random(2)
            true
        }
    })) {
        Some(c) => c.requested == 32 && c.available == 0,
        None => false
    }
    let first = match refusal(isolate(fn() -> Result[bool, Capacity] {
        bound bytes 24 {
            let (c, h) = provide.clock(0, 0)
            true
        }
    })) {
        Some(c) => c.requested == 32 && c.available == 24,
        None => false
    }
    fits && second && first
}

// The primary cause of a caught failure, when it is a refused admission.
fn refusal[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

// Served stdout ports (core.md, Provide). A write waits as a Call until the
// server replies: the first is answered Done, the second WriteFailed with one
// byte written and Other(5), which the writer sees exactly.
fn echo_writer(take o: Stdout) -> bool waits {
    let first = match stdout.write(o, "hello") {
        Ok(_) => true,
        _ => false
    }
    let second = match stdout.write(o, "abc") {
        Error(e) => e.written == 1 && match e.error {
            Other(code) => code == 5,
            _ => false
        },
        _ => false
    }
    first && second
}

// The server reads Write(5) and the five bytes "hello", answers Done, then
// answers the three-byte write WriteFailed(1, Other(5)). Once the writer has
// ended, next waits until every task waits and returns None.
// expect: run echo(tasks) = true
fn echo(tasks: Tasks) -> bool waits {
    let (o, s) = provide.stdout(bytes 64, false)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, o, echo_writer)
    let first = match provide.next(mut served) {
        Some(take call) => {
            let len = match provide.stream_op(call) {
                Write(len) => len
            }
            let mut b: Bytes = list.with_capacity(8)
            provide.payload(call, 0, mut b)
            let read = len == 5 && list.len(b) == 5 && b[0] == 0x68 && b[1] == 0x65 && b[4] == 0x6f
            let answered = match provide.reply(mut served, take call, provide.stream_reply(Done)) {
                Ok(_) => true,
                _ => false
            }
            read && answered
        },
        None => false
    }
    let second = match provide.next(mut served) {
        Some(take call) => {
            let failed: StreamReply = WriteFailed(WriteError(written: 1, error: Other(5)))
            match provide.reply(mut served, take call, provide.stream_reply(failed)) {
                Ok(_) => true,
                _ => false
            }
        },
        None => false
    }
    let wrote = result.unwrap(task.join(take child))
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    first && second && wrote && quiet
}

fn lone_writer(take o: Stdout) -> bool waits {
    let _ = stdout.write(o, "x")
    true
}

// CONC-7 and NOTES 16: once the writer's cancellation is requested, a reply
// to its taken call is Withdrawn, and the writer ends Cancelled.
// expect: run withdrawn(tasks) = true
fn withdrawn(tasks: Tasks) -> bool waits {
    let (o, s) = provide.stdout(bytes 64, false)
    let mut served = take s
    let mut child = task.spawn(tasks, bytes 65536, o, lone_writer)
    let refused = match provide.next(mut served) {
        Some(take call) => {
            task.cancel(mut child)
            match provide.reply(mut served, take call, provide.stream_reply(Done)) {
                Error(Withdrawn()) => true,
                _ => false
            }
        },
        None => false
    }
    let cancelled = match task.join(take child) {
        Error(Cancelled(take causes)) => {
            let _ = take causes
            true
        },
        _ => false
    }
    refused && cancelled
}

fn closed_writer(take o: Stdout) -> bool waits {
    match stdout.write(o, "x") {
        Error(e) => e.written == 0 && match e.error {
            Closed => true,
            _ => false
        },
        _ => false
    }
}

fn seal(take s: Served[StreamOp]) {
    let _ = take s
}

// Cleaning the Served end seals the port: the taken call and the other
// writer's call (queued, or issued after the seal) complete Closed with
// nothing written, a later write is Closed at once, and dropping the taken
// Call afterwards changes nothing.
// expect: run sealed(tasks) = true
fn sealed(tasks: Tasks) -> bool waits {
    let (o, s) = provide.stdout(bytes 64, false)
    let mut served = take s
    let a = task.spawn(tasks, bytes 65536, o, closed_writer)
    let b = task.spawn(tasks, bytes 65536, o, closed_writer)
    let taken = provide.next(mut served)
    seal(take served)
    let both = result.unwrap(task.join(take a)) && result.unwrap(task.join(take b))
    let held = match take taken {
        Some(take call) => {
            let _ = take call
            true
        },
        None => false
    }
    held && both && closed_writer(o)
}

// NOTES 20: a Call given to another port's reply is consumed as a dropped
// one: the reply is Withdrawn and its writer sees Closed with nothing written.
// expect: run foreign_call(tasks) = true
fn foreign_call(tasks: Tasks) -> bool waits {
    let (o, s) = provide.stdout(bytes 64, false)
    let (_, t) = provide.stderr(bytes 64, false)
    let mut served = take s
    let mut other = take t
    let child = task.spawn(tasks, bytes 65536, o, closed_writer)
    let refused = match provide.next(mut served) {
        Some(take call) => {
            match provide.reply(mut other, take call, provide.stream_reply(Done)) {
                Error(Withdrawn()) => true,
                _ => false
            }
        },
        None => false
    }
    let closed = result.unwrap(task.join(take child))
    let _ = take served
    let _ = take other
    refused && closed
}

// Served Dir ports (core.md, Provide). The client opens "a", writes "hi",
// reads into a 4-byte buffer, stats and closes; the server answers each from
// the call's words and payload.
fn dir_client(take d: Dir) -> bool waits {
    match host.open(d, "a", CreateNew) {
        Ok(take f) => {
            let mut file = take f
            let wrote = match host.write(mut file, string.as_bytes("hi")) {
                Ok(_) => true,
                _ => false
            }
            let mut b: Bytes = list.with_capacity(4)
            let read = match host.read(mut file, mut b) {
                Ok(n) => n == 3 && list.len(b) == 3 && b[0] == 0x78 && b[2] == 0x7a,
                _ => false
            }
            let stat = match host.stat_file(mut file) {
                Ok(s) => s.size == 7 && s.modified_ns == -1 && match s.kind {
                    File => true,
                    _ => false
                },
                _ => false
            }
            let closed = match host.close(take file) {
                Ok(_) => true,
                _ => false
            }
            wrote && read && stat && closed
        },
        Error(_) => false
    }
}

fn answer(mut s: Served[DirOp], take c: Call[DirOp], r: DirReply) -> bool {
    match provide.reply(mut s, take c, provide.dir_reply(r)) {
        Ok(_) => true,
        _ => false
    }
}

// The server sees Open(0, 1, CreateNew) with path "a" and issues File(5);
// Write(5, 2) with "hi"; Read(5, 4), where it stages "xyz" (fill takes all
// 3) and answers Count(3); StatFile(5), answered size 7 and mtime -1; then
// Close(5). The client sees exactly those results.
// expect: run dir_echo(tasks) = true
fn dir_echo(tasks: Tasks) -> bool waits {
    let (d, s) = provide.dir(bytes 256)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, d, dir_client)
    let opened = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.dir_op(call) {
                Open(dir, path, mode) => dir == 0 && path == 1 && match mode {
                    CreateNew => true,
                    _ => false
                },
                _ => false
            }
            let mut p: Bytes = list.with_capacity(4)
            provide.payload(call, 1, mut p)
            let named = list.len(p) == 1 && p[0] == 0x61
            let ok = answer(mut served, take call, File(5))
            op && named && ok
        },
        None => false
    }
    let wrote = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.dir_op(call) {
                Write(file, len) => file == 5 && len == 2,
                _ => false
            }
            let mut p: Bytes = list.with_capacity(4)
            provide.payload(call, 1, mut p)
            let data = list.len(p) == 2 && p[0] == 0x68 && p[1] == 0x69
            let ok = answer(mut served, take call, Done)
            op && data && ok
        },
        None => false
    }
    let read = match provide.next(mut served) {
        Some(take call) => {
            let mut c = take call
            let op = match provide.dir_op(c) {
                Read(file, room) => file == 5 && room == 4,
                _ => false
            }
            let took = provide.fill(mut served, mut c, string.as_bytes("xyz"))
            let ok = answer(mut served, take c, Count(3))
            op && took == 3 && ok
        },
        None => false
    }
    let stat = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.dir_op(call) {
                StatFile(file) => file == 5,
                _ => false
            }
            let ok = answer(mut served, take call, Stat(Stat(kind: File, size: 7, modified_ns: -1)))
            op && ok
        },
        None => false
    }
    let closed = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.dir_op(call) {
                Close(file) => file == 5,
                _ => false
            }
            let ok = answer(mut served, take call, Done)
            op && ok
        },
        None => false
    }
    let client = result.unwrap(task.join(take child))
    opened && wrote && read && stat && closed && client
}

fn drop_client(take d: Dir) -> bool waits {
    let first = match host.open(d, "a", Read) {
        Ok(take f) => {
            let _ = take f
            true
        },
        Error(_) => false
    }
    let second = match host.open(d, "b", Read) {
        Ok(take f) => {
            let _ = take f
            true
        },
        Error(_) => false
    }
    first && second
}

// Take the next call, expect an Open, and issue File(id).
fn issue(mut s: Served[DirOp], id: u64) -> bool waits {
    match provide.next(mut s) {
        Some(take call) => {
            let op = match provide.dir_op(call) {
                Open(dir, path, mode) => dir == 0 && path == 1,
                _ => false
            }
            let ok = answer(mut s, take call, File(id))
            op && ok
        },
        None => false
    }
}

// Take the next call and expect Released(id), which Done acknowledges.
fn released(mut s: Served[DirOp], id: u64) -> bool waits {
    match provide.next(mut s) {
        Some(take call) => {
            let op = match provide.dir_op(call) {
                Released(id: h) => h == id,
                _ => false
            }
            let ok = answer(mut s, take call, Done)
            op && ok
        },
        None => false
    }
}

// FAIL-13: a dropped file reaches the server as Released(id), queued before
// the client's next open. A room of 32 holds one handle: File(5) fills it,
// Released(5) refunds it, so File(6) fits. Once the client ends with both
// released, next returns None.
// expect: run dir_released(tasks) = true
fn dir_released(tasks: Tasks) -> bool waits {
    let (d, s) = provide.dir(bytes 32)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, d, drop_client)
    let first = issue(mut served, 5)
    let one = released(mut served, 5)
    let second = issue(mut served, 6)
    let two = released(mut served, 6)
    let client = result.unwrap(task.join(take child))
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    first && one && second && two && client && quiet
}

// The primary cause of a failed task is Fail.
fn fail_cause(r: Result[bool, JoinError]) -> bool {
    match r {
        Error(Failed(causes)) => {
            for c in causes {
                return match c.kind {
                    Fail(_) => true,
                    _ => false,
                }
            }
            false
        },
        _ => false,
    }
}

fn zero_server(take s: Served[DirOp]) -> bool waits {
    let mut served = take s
    issue(mut served, 0)
}

fn twice_server(take s: Served[DirOp]) -> bool waits {
    let mut served = take s
    let first = issue(mut served, 5)
    first && issue(mut served, 5)
}

fn variant_server(take s: Served[DirOp]) -> bool waits {
    let mut served = take s
    match provide.next(mut served) {
        Some(take call) => answer(mut served, take call, Count(1)),
        None => false
    }
}

fn opens_closed(d: Dir) -> bool waits {
    match host.open(d, "a", Read) {
        Ok(take f) => {
            let _ = take f
            false
        },
        Error(e) => match e {
            Closed => true,
            _ => false
        }
    }
}

// core.md, Handles: a reply issuing id 0, an id already live, or a variant
// that does not answer the call fails the server with Fail, and the caller
// sees Closed. The first file of the twice server stays open past its
// server's end, and dropping it then still completes.
// expect: run dir_fail(tasks) = true
fn dir_fail(tasks: Tasks) -> bool waits {
    let (d0, s0) = provide.dir(bytes 64)
    let zero = task.spawn(tasks, bytes 65536, take s0, zero_server)
    let closed0 = opens_closed(d0)
    let failed0 = fail_cause(task.join(take zero))
    let (d1, s1) = provide.dir(bytes 64)
    let twice = task.spawn(tasks, bytes 65536, take s1, twice_server)
    let kept = host.open(d1, "a", Read)
    let closed1 = opens_closed(d1)
    let failed1 = fail_cause(task.join(take twice))
    let first = match take kept {
        Ok(take f) => {
            let _ = take f
            true
        },
        Error(_) => false
    }
    let (d2, s2) = provide.dir(bytes 64)
    let variant = task.spawn(tasks, bytes 65536, take s2, variant_server)
    let closed2 = opens_closed(d2)
    let failed2 = fail_cause(task.join(take variant))
    closed0 && failed0 && closed1 && failed1 && first && closed2 && failed2
}

fn greedy_server(take s: Served[DirOp]) -> bool waits {
    let mut served = take s
    let opened = issue(mut served, 5)
    match provide.next(mut served) {
        Some(take call) => {
            let mut c = take call
            let took = provide.fill(mut served, mut c, string.as_bytes("abcdefghi"))
            let ok = answer(mut served, take c, Count(took))
            opened && ok
        },
        None => false
    }
}

fn reads_closed(take f: HostFile) -> bool waits {
    let mut file = take f
    let mut b: Bytes = list.with_capacity(16)
    match host.read(mut file, mut b) {
        Ok(_) => false,
        Error(e) => match e {
            Closed => true,
            _ => false
        }
    }
}

// The primary cause of a failed task, when it is a refused admission.
fn join_refusal(r: Result[bool, JoinError]) -> Option[Capacity] {
    match r {
        Error(Failed(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

// MEM-21: a port admits its room with a cell's 32: a bound of 40 holds
// provide.dir(bytes 8), and a bound of 39 refuses it, asking 40 of 39. In a
// room of 40, File(5) holds 32 and leaves 8; a fill of 9 bytes into a read
// offering 16 asks 9 of the 8, a Capacity refusal in the server, and the
// reader sees Closed.
// expect: run dir_room(tasks) = true
fn dir_room(tasks: Tasks) -> bool waits {
    let held = bound bytes 40 {
        let (d, s) = provide.dir(bytes 8)
        let _ = take s
        true
    }
    let fits = match held {
        Ok(v) => v,
        _ => false
    }
    let refused = match refusal(isolate(fn() -> Result[bool, Capacity] {
        bound bytes 39 {
            let (d, s) = provide.dir(bytes 8)
            let _ = take s
            true
        }
    })) {
        Some(c) => c.requested == 40 && c.available == 39,
        None => false
    }
    let (d, s) = provide.dir(bytes 40)
    let server = task.spawn(tasks, bytes 65536, take s, greedy_server)
    let closed = match host.open(d, "a", Read) {
        Ok(take f) => reads_closed(take f),
        Error(_) => false
    }
    let short = match join_refusal(task.join(take server)) {
        Some(c) => c.requested == 9 && c.available == 8,
        None => false
    }
    fits && refused && closed && short
}

fn paired_server(take s: Served[DirOp]) -> bool waits {
    let mut served = take s
    let first = issue(mut served, 5)
    first && issue(mut served, 6)
}

// core.md, Handles: each issued id holds 32 bytes of the room. In a room of
// 40, File(5) leaves 8, so a reply issuing File(6) asks 32 of the 8, a
// Capacity refusal in the server; the second open sees Closed, and the first
// file, kept past its server's end, still drops.
// expect: run dir_handle_room(tasks) = true
fn dir_handle_room(tasks: Tasks) -> bool waits {
    let (d, s) = provide.dir(bytes 40)
    let server = task.spawn(tasks, bytes 65536, take s, paired_server)
    let kept = host.open(d, "a", Read)
    let closed = opens_closed(d)
    let short = match join_refusal(task.join(take server)) {
        Some(c) => c.requested == 32 && c.available == 8,
        None => false
    }
    let first = match take kept {
        Ok(take f) => {
            let _ = take f
            true
        },
        Error(_) => false
    }
    closed && short && first
}

// expect: run provided_terminals() = true
fn provided_terminals() -> bool waits {
    let (o, s) = provide.stdout(bytes 64, true)
    let (e, t) = provide.stderr(bytes 64, false)
    let mut served_out = take s
    let mut served_err = take t
    let before = stdout.is_terminal(o) && !stderr.is_terminal(e)
    let quiet = match provide.next(mut served_out) {
        None => true,
        Some(take call) => {
            let _ = take call
            false
        },
    } && match provide.next(mut served_err) {
        None => true,
        Some(take call) => {
            let _ = take call
            false
        },
    }
    seal(take served_out)
    seal(take served_err)
    before && quiet && stdout.is_terminal(o) && !stderr.is_terminal(e)
}

fn net_answer(mut s: Served[NetOp], take c: Call[NetOp], r: NetReply) -> bool {
    match provide.reply(mut s, take c, provide.net_reply(r)) {
        Ok(_) => true,
        _ => false
    }
}

fn loopback(a: Addr, port: u16) -> bool {
    a.port == port && match a.ip {
        V4(x) => x == 2130706433,
        _ => false
    }
}

// Sends "he"+"llo" on the socket's write half and receives at most 4 bytes
// on its read half, then drops the halves.
fn exchange(take s: Socket) -> bool waits {
    let (rh, wh) = net.split(take s)
    let mut r = take rh
    let mut w = take wh
    let sent = match host.send_pair(mut w, string.as_bytes("he"), string.as_bytes("llo"), Never) {
        Ok(k) => k == 5,
        _ => false
    }
    let mut b: Bytes = list.with_capacity(8)
    let got = match host.recv_bounded(mut r, mut b, 4, Never) {
        Ok(k) => k == 4 && list.len(b) == 4 && b[0] == 0x61 && b[3] == 0x64,
        _ => false
    }
    let _ = take r
    let _ = take w
    sent && got
}

// Listens, connects to the bound address, accepts, exchanges on the
// connected socket, then drops every part and connects once more.
fn net_client(take n: Net) -> bool waits {
    let (listener, at) = result.unwrap(host.listen(n, Addr(ip: V4(2130706433), port: 80), 4))
    let mut l = take listener
    let client = result.unwrap(host.connect(n, at, Never))
    let (accepted, from) = result.unwrap(host.accept(mut l, Never))
    let exchanged = exchange(take client)
    let _ = take accepted
    let _ = take l
    let again = match host.connect(n, at, Never) {
        Ok(take s) => {
            let _ = take s
            true
        },
        Error(_) => false
    }
    loopback(at, 8080) && loopback(from, 5000) && exchanged && again
}

// Take the next call and expect Released(id, part), which Done acknowledges.
fn net_released(mut s: Served[NetOp], id: u64, part: u64) -> bool waits {
    match provide.next(mut s) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Released(id: h, part: p) => h == id && match p {
                    Whole => part == 0,
                    Read => part == 1,
                    Write => part == 2,
                },
                _ => false
            }
            op && net_answer(mut s, take call, Done)
        },
        None => false
    }
}

// Take the next call, expect a Connect to 127.0.0.1:port, and issue
// Socket(id).
fn net_connect(mut s: Served[NetOp], id: u64, port: u16) -> bool waits {
    match provide.next(mut s) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Connect(addr) => loopback(addr, port),
                _ => false
            }
            op && net_answer(mut s, take call, Socket(id, Addr(ip: V4(2130706433), port: port)))
        },
        None => false
    }
}

// Served Net ports (core.md, Provide). The server binds the listen to port
// 8080 as Listener(7), answers the connect with Socket(8) and the accept
// with Socket(9) from 127.0.0.1:5000; takes the send's prefix and tail as
// payload fields 1 and 2 and answers Count(5); stages "abcdef" for a receive
// whose room the max of 4 clamps (fill takes 4) and answers Count(4). Each
// dropped part reaches it as Released in drop order: the split socket's
// halves as Read and Write, the unsplit socket and listener as Whole. A room
// of 100 holds three ids (32 bytes each) and the 4 staged bytes, so
// Socket(10) fits only once the drops refund the ids.
// expect: run net_echo(tasks) = true
fn net_echo(tasks: Tasks) -> bool waits {
    let (n, s) = provide.net(bytes 100)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, n, net_client)
    let listened = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Listen(addr, backlog) => loopback(addr, 80) && backlog == 4,
                _ => false
            }
            op && net_answer(mut served, take call, Listener(7, Addr(ip: V4(2130706433), port: 8080)))
        },
        None => false
    }
    let connected = net_connect(mut served, 8, 8080)
    let accepted = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Accept(listener) => listener == 7,
                _ => false
            }
            op && net_answer(mut served, take call, Socket(9, Addr(ip: V4(2130706433), port: 5000)))
        },
        None => false
    }
    let sent = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Send(socket, prefix, tail) => socket == 8 && prefix == 2 && tail == 3,
                _ => false
            }
            let mut p: Bytes = list.with_capacity(8)
            provide.payload(call, 1, mut p)
            provide.payload(call, 2, mut p)
            let data = list.len(p) == 5 && p[0] == 0x68 && p[2] == 0x6c && p[4] == 0x6f
            op && data && net_answer(mut served, take call, Count(5))
        },
        None => false
    }
    let received = match provide.next(mut served) {
        Some(take call) => {
            let mut c = take call
            let op = match provide.net_op(c) {
                Recv(socket, room, max) => socket == 8 && room == 4 && max == 4,
                _ => false
            }
            let took = provide.fill(mut served, mut c, string.as_bytes("abcdef"))
            op && took == 4 && net_answer(mut served, take c, Count(4))
        },
        None => false
    }
    let halves = net_released(mut served, 8, 1) && net_released(mut served, 8, 2)
    let wholes = net_released(mut served, 9, 0) && net_released(mut served, 7, 0)
    let again = net_connect(mut served, 10, 8080) && net_released(mut served, 10, 0)
    let client = result.unwrap(task.join(take child))
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    listened && connected && accepted && sent && received && halves && wholes && again && client && quiet
}

// Consumes a handshake's result: true when it is Error(Denied).
fn tls_denied(take r: Result[(ReadHalf, WriteHalf, Handshake), NetError]) -> bool {
    match take r {
        Ok(take stream) => {
            let (take rh, take wh, _) = take stream
            let _ = take rh
            let _ = take wh
            false
        },
        Error(Denied) => true,
        Error(_) => false
    }
}

// Dials 127.0.0.1:443 twice through the served Net: the first socket is
// split and rejoined, then its handshake offers h2 and http/1.1 as
// Alpha.Test; the second offers nothing as beta.test.
fn tls_client(take n: Net) -> bool waits {
    let at = Addr(ip: V4(2130706433), port: 443)
    let dialed = result.unwrap(host.connect(n, at, Never))
    // Split and rejoined in place, as STARTTLS does: the server sees neither.
    let (rh, wh) = net.split(take dialed)
    let first = result.unwrap(net.join(take rh, take wh))
    let mut alpn: List[String] = list.new()
    list.push(mut alpn, string.from("h2"))
    list.push(mut alpn, string.from("http/1.1"))
    let secured = match tls.connect(n, take first, string.from("Alpha.Test"), System, alpn, Never) {
        Ok(take stream) => {
            let (take r, take w, h) = take stream
            let (p0, p1, p2, p3) = h.peer
            let chosen = match h.protocol {
                Some(p) => p == 1,
                None => false
            }
            let _ = take r
            let _ = take w
            chosen && p0 == 1 && p1 == 2 && p2 == 3 && p3 == 0xffffffffffffffff
        },
        Error(_) => false
    }
    let second = result.unwrap(host.connect(n, at, Never))
    let none: List[String] = list.new()
    let refused = match tls.connect(n, take second, string.from("beta.test"), System, none, Never) {
        Ok(take stream) => {
            let (take r, take w, _) = take stream
            let _ = take r
            let _ = take w
            false
        },
        Error(e) => match e {
            Tls(f) => match f {
                Alpn => true,
                _ => false
            },
            _ => false
        }
    }
    secured && refused
}

// A served Net's handshake is a Handshake call (core.md, Provide; NOTES 32):
// the socket's id, the canonical name's length (payload field 1) and the
// offer's ALPN wire bytes' length (field 2: each protocol after its length
// byte), and whether the trust is System. Secured's protocol is the zero-
// based index into the offer and its peer the digest's words, both as the
// server gave them. The stream's halves drop as Read and Write; a Failed
// reply is the client's error, and the socket the handshake consumed comes
// back as Released Whole.
// expect: run net_tls(tasks) = true
fn net_tls(tasks: Tasks) -> bool waits {
    let (n, s) = provide.net(bytes 64)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, n, tls_client)
    let dialed = net_connect(mut served, 8, 443)
    let shaken = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Handshake(socket, name, alpn, system) => socket == 8 && name == 10 && alpn == 12 && system,
                _ => false
            }
            let mut p: Bytes = list.with_capacity(32)
            provide.payload(call, 1, mut p)
            provide.payload(call, 2, mut p)
            let data = list.len(p) == 22 && p[0] == 0x61 && p[9] == 0x74 && p[10] == 2 && p[11] == 0x68 && p[13] == 8 && p[21] == 0x31
            let digest: (u64, u64, u64, u64) = (1, 2, 3, 0xffffffffffffffff)
            op && data && net_answer(mut served, take call, Secured(Handshake(protocol: Some(1), peer: digest)))
        },
        None => false
    }
    let halves = net_released(mut served, 8, 1) && net_released(mut served, 8, 2)
    let redialed = net_connect(mut served, 9, 443)
    let failed = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Handshake(socket, name, alpn, system) => socket == 9 && name == 9 && alpn == 0 && system,
                _ => false
            }
            op && net_answer(mut served, take call, Failed(Tls(Alpn)))
        },
        None => false
    }
    let whole = net_released(mut served, 9, 0)
    let client = result.unwrap(task.join(take child))
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    dialed && shaken && halves && redialed && failed && whole && client && quiet
}

type Crossing: send {
    model: Net,
    served: Net
}

// A model socket handed to the served Net, then a served socket handed to
// the model Net (whose grant permits *.test): each handshake is Denied.
fn crossing_client(take c: Crossing) -> bool waits {
    let (listener, at) = result.unwrap(host.listen(c.model, Addr(ip: V4(2130706433), port: 0), 1))
    let mut l = take listener
    let plain = result.unwrap(host.connect(c.model, at, Never))
    let none: List[String] = list.new()
    let model_socket = tls_denied(tls.connect(c.served, take plain, string.from("alpha.test"), System, none, Never))
    let virtual = result.unwrap(host.connect(c.served, Addr(ip: V4(2130706433), port: 8080), Never))
    let empty: List[String] = list.new()
    let served_socket = tls_denied(tls.connect(c.model, take virtual, string.from("alpha.test"), System, empty, Never))
    let _ = take l
    model_socket && served_socket
}

// A handshake goes only through the Net whose provider made the socket
// (NOTES 32): a served Net cannot answer for a model socket, nor a model
// Net for a served one. Each is Denied before any call, and the served
// socket it consumed reaches its server only as Released Whole.
// expect: run tls_crossing(network) = true
fn tls_crossing(n: Net, c: Clock, tasks: Tasks) -> bool waits {
    let (v, s) = provide.net(bytes 64)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, Crossing(model: n, served: v), crossing_client)
    let dialed = net_connect(mut served, 8, 8080)
    let whole = net_released(mut served, 8, 0)
    let client = result.unwrap(task.join(take child))
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    dialed && whole && client && quiet
}

fn bad_secured(take s: Served[NetOp]) -> bool waits {
    let mut served = take s
    let dialed = net_connect(mut served, 8, 8080)
    match provide.next(mut served) {
        Some(take call) => {
            let digest: (u64, u64, u64, u64) = (0, 0, 0, 0)
            dialed && net_answer(mut served, take call, Secured(Handshake(protocol: Some(0), peer: digest)))
        },
        None => false
    }
}

// core.md, Handles: Secured naming a protocol outside the offer (here an
// empty one) fails the server with Fail, and the caller sees Reset.
// expect: run net_tls_fail(tasks) = true
fn net_tls_fail(tasks: Tasks) -> bool waits {
    let (n, s) = provide.net(bytes 64)
    let server = task.spawn(tasks, bytes 65536, take s, bad_secured)
    let socket = result.unwrap(host.connect(n, Addr(ip: V4(2130706433), port: 8080), Never))
    let none: List[String] = list.new()
    let reset = match tls.connect(n, take socket, string.from("alpha.test"), System, none, Never) {
        Ok(take stream) => {
            let (take r, take w, _) = take stream
            let _ = take r
            let _ = take w
            false
        },
        Error(e) => match e {
            Reset => true,
            _ => false
        }
    }
    reset && fail_cause(task.join(take server))
}

// Take the next call, expect a Handshake on `socket` for alpha.test with no
// offer, and answer Secured with no protocol.
fn answer_handshake(mut s: Served[NetOp], socket: u64) -> bool waits {
    match provide.next(mut s) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Handshake(socket: h, name, alpn, system) => h == socket && name == 10 && alpn == 0 && system,
                _ => false
            }
            let digest: (u64, u64, u64, u64) = (0, 0, 0, 0)
            op && net_answer(mut s, take call, Secured(Handshake(protocol: None, peer: digest)))
        },
        None => false
    }
}

fn sealed_pencil(to: String) -> Secret {
    let b = string.into_bytes(string.from("pencil"))
    result.unwrap(secret.seal(take b, to))
}

// Sends "Auth " ‖ pencil ‖ "\r\n" on a served alpha.test stream; a pencil
// sealed to beta.test is Denied there for both sinks, and a plain half
// Denies both for the alpha.test one. The plain socket's halves drop first.
fn secret_client(take n: Net) -> bool waits {
    let at = Addr(ip: V4(2130706433), port: 443)
    let socket = result.unwrap(host.connect(n, at, Never))
    let none: List[String] = list.new()
    let alpha = sealed_pencil(string.from("alpha.test"))
    let beta = sealed_pencil(string.from("beta.test"))
    let empty: Bytes = list.new()
    let client_first = string.as_bytes("n,,n=user,r=rOprNGfwEbeRWgbNEkqO")
    let server_first = string.as_bytes("r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096")
    match tls.connect(n, take socket, string.from("alpha.test"), System, none, Never) {
        Ok(take stream) => {
            let (take r, take w, _) = take stream
            let mut wh = take w
            let sent = match tls.send_secret(mut wh, string.as_bytes("Auth "), alpha, string.as_bytes("\r\n"), Never) {
                Ok(_) => true,
                Error(_) => false
            }
            let other_name = match tls.send_secret(mut wh, string.as_bytes("Auth "), beta, empty, Never) {
                Error(Denied) => true,
                _ => false
            }
            let other_scram = match secret.scram_sha256(mut wh, beta, client_first, server_first, empty, empty, Never) {
                Ok(take c) => {
                    let _ = take c
                    false
                },
                Error(e) => match e {
                    Denied => true,
                    _ => false
                }
            }
            let plain = result.unwrap(host.connect(n, at, Never))
            let (pr, pw) = net.split(take plain)
            let mut ph = take pw
            let plain_send = match tls.send_secret(mut ph, empty, alpha, empty, Never) {
                Error(Denied) => true,
                _ => false
            }
            let plain_scram = match secret.scram_sha256(mut ph, alpha, client_first, server_first, empty, empty, Never) {
                Ok(take c) => {
                    let _ = take c
                    false
                },
                Error(e) => match e {
                    Denied => true,
                    _ => false
                }
            }
            let _ = take pr
            let _ = take ph
            let _ = take r
            let _ = take wh
            sent && other_name && other_scram && plain_send && plain_scram
        },
        Error(_) => false
    }
}

// Forwards `s` on an onward alpha.test stream as SCRAM's password (RFC 7677's
// "pencil" vector): true when the server's final message verifies.
fn forward(onward: Net, s: Secret) -> bool waits {
    let socket = result.unwrap(host.connect(onward, Addr(ip: V4(2130706433), port: 5432), Never))
    let none: List[String] = list.new()
    match tls.connect(onward, take socket, string.from("alpha.test"), System, none, Never) {
        Ok(take stream) => {
            let (take r, take w, _) = take stream
            let mut wh = take w
            let empty: Bytes = list.new()
            let client_first = string.as_bytes("n,,n=user,r=rOprNGfwEbeRWgbNEkqO")
            let server_first = string.as_bytes("r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096")
            let verified = match secret.scram_sha256(mut wh, s, client_first, server_first, empty, empty, Never) {
                Ok(take c) => secret.scram_verify(take c, string.as_bytes("v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=")),
                Error(_) => false
            }
            let _ = take r
            let _ = take wh
            verified
        },
        Error(_) => false
    }
}

// The onward server: the proof reaches it only as Send calls, from the
// first byte it has not taken (core.md, Net authority). It takes 100 of the
// 106 bytes, then the last 6.
fn proof_server(take s: Served[NetOp]) -> bool waits {
    let mut served = take s
    let dialed = net_connect(mut served, 5, 5432)
    let shaken = answer_handshake(mut served, 5)
    let first = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Send(socket, prefix, tail) => socket == 5 && prefix == 106 && tail == 0,
                _ => false
            }
            let mut p: Bytes = list.with_capacity(128)
            provide.payload(call, 1, mut p)
            let data = match string.from_utf8(take p) {
                Ok(text) => text == "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=",
                Error(_) => false
            }
            op && data && net_answer(mut served, take call, Count(100))
        },
        None => false
    }
    let rest = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                Send(socket, prefix, tail) => socket == 5 && prefix == 6 && tail == 0,
                _ => false
            }
            let mut p: Bytes = list.with_capacity(8)
            provide.payload(call, 1, mut p)
            let data = match string.from_utf8(take p) {
                Ok(text) => text == "AndVQ=",
                Error(_) => false
            }
            op && data && net_answer(mut served, take call, Count(6))
        },
        None => false
    }
    let halves = net_released(mut served, 5, 1) && net_released(mut served, 5, 2)
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    dialed && shaken && first && rest && halves && quiet
}

// TLS-5, virtual streams (NOTES 6): send_secret on a served stream with a
// sealed Secret is a SendSecret call (the socket, `before`'s and `after`'s
// lengths as payload fields 1 and 2), and provide.secret hands the server the
// Secret narrowed to alpha.test: narrowing it to beta.test is Invalid, and
// forwarded as an onward stream's SCRAM password its proof and the server's
// verdict are RFC 7677's for "pencil". A Secret sealed to beta.test, and any
// plain half, reach no server.
// expect: run net_secret(tasks) = true
fn net_secret(tasks: Tasks) -> bool waits {
    let (n, s) = provide.net(bytes 64)
    let mut served = take s
    let (onward, s2) = provide.net(bytes 64)
    let inner = task.spawn(tasks, bytes 65536, take s2, proof_server)
    let child = task.spawn(tasks, bytes 65536, n, secret_client)
    let dialed = net_connect(mut served, 8, 443)
    let shaken = answer_handshake(mut served, 8)
    let relayed = match provide.next(mut served) {
        Some(take call) => {
            let op = match provide.net_op(call) {
                SendSecret(socket, before, after) => socket == 8 && before == 5 && after == 2,
                _ => false
            }
            let mut p: Bytes = list.with_capacity(8)
            provide.payload(call, 1, mut p)
            provide.payload(call, 2, mut p)
            let data = match string.from_utf8(take p) {
                Ok(text) => text == "Auth \r\n",
                Error(_) => false
            }
            let given = provide.secret(call)
            let narrowed = match secret.narrow(given, string.from("beta.test")) {
                Ok(_) => false,
                Error(_) => true
            }
            op && data && narrowed && forward(onward, given) && net_answer(mut served, take call, Done)
        },
        None => false
    }
    let redialed = net_connect(mut served, 9, 443)
    let plain = net_released(mut served, 9, 1) && net_released(mut served, 9, 2)
    let halves = net_released(mut served, 8, 1) && net_released(mut served, 8, 2)
    let client = result.unwrap(task.join(take child))
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    let proven = result.unwrap(task.join(take inner))
    dialed && shaken && relayed && redialed && plain && halves && client && quiet && proven
}

fn handshake_server(take s: Served[NetOp]) -> bool waits {
    let mut served = take s
    let dialed = net_connect(mut served, 8, 443)
    let shaken = answer_handshake(mut served, 8)
    let halves = net_released(mut served, 8, 1) && net_released(mut served, 8, 2)
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    dialed && shaken && halves && quiet
}

// TLS-5 and TLS-6, virtual streams: a served Net's stream never satisfies a
// Secret from an entry grant, here granted to alpha.test. send_secret and
// SCRAM on it are Denied before issue, so the server sees only the halves'
// Released.
// expect: run granted_denied(granted, tasks) = true
fn granted_denied(token: Secret, tasks: Tasks) -> bool waits {
    let (n, s) = provide.net(bytes 64)
    let server = task.spawn(tasks, bytes 65536, take s, handshake_server)
    let socket = result.unwrap(host.connect(n, Addr(ip: V4(2130706433), port: 443), Never))
    let none: List[String] = list.new()
    let denied = match tls.connect(n, take socket, string.from("alpha.test"), System, none, Never) {
        Ok(take stream) => {
            let (take r, take w, _) = take stream
            let mut wh = take w
            let empty: Bytes = list.new()
            let sent = match tls.send_secret(mut wh, empty, token, empty, Never) {
                Error(Denied) => true,
                _ => false
            }
            let scram = match secret.scram_sha256(mut wh, token, string.as_bytes("n,,n=user,r=abc"), string.as_bytes("r=abcd,s=c2FsdA==,i=4096"), empty, empty, Never) {
                Ok(take c) => {
                    let _ = take c
                    false
                },
                Error(e) => match e {
                    Denied => true,
                    _ => false
                }
            }
            let _ = take r
            let _ = take wh
            sent && scram
        },
        Error(_) => false
    }
    denied && result.unwrap(task.join(take server))
}

// A resolved address record (NOTES 34): family 0 and twelve zeros before a
// V4 address's four octets, or family 1 and a V6 address's sixteen.
fn v4_record(mut b: Bytes, x: u8, y: u8, z: u8, w: u8) {
    list.push(mut b, 0u8)
    let mut i = 0u64
    while i < 12u64 {
        list.push(mut b, 0u8)
        i = i + 1u64
    }
    list.push(mut b, x)
    list.push(mut b, y)
    list.push(mut b, z)
    list.push(mut b, w)
}

// 2001:db8::1.
fn doc_v6_record(mut b: Bytes) {
    list.push(mut b, 1u8)
    list.push(mut b, 0x20u8)
    list.push(mut b, 0x01u8)
    list.push(mut b, 0x0du8)
    list.push(mut b, 0xb8u8)
    let mut i = 0u64
    while i < 11u64 {
        list.push(mut b, 0u8)
        i = i + 1u64
    }
    list.push(mut b, 1u8)
}

// Resolves "Alpha.Test" into a list already holding one address with room
// for two, then a name with no address and one the resolver cannot reach.
// A narrowed Net that does not cover the name, and a malformed name, are
// Denied before the server sees anything.
fn resolve_client(take n: Net) -> bool waits {
    let mut out: List[Ip] = list.with_capacity(3)
    list.push(mut out, V4(1))
    let two = match host.resolve(n, string.from("Alpha.Test"), mut out, Never) {
        Ok(k) => k == 2 && list.len(out) == 3 && match out[0] {
            V4(x) => x == 1,
            _ => false
        } && match out[1] {
            V4(x) => x == 167772161,
            _ => false
        } && match out[2] {
            V6(hi, lo) => hi == 0x20010db800000000 && lo == 1,
            _ => false
        },
        _ => false
    }
    let mut none: List[Ip] = list.with_capacity(2)
    let empty = match host.resolve(n, string.from("empty.test"), mut none, Never) {
        Ok(k) => k == 0 && list.len(none) == 0,
        _ => false
    }
    let unreachable = match host.resolve(n, string.from("far.test"), mut none, Never) {
        Error(Unreachable) => true,
        _ => false
    }
    let rule: Rule = Resolve(names: "beta.test")
    let beta = result.unwrap(net.narrow(n, rule))
    let narrowed = match host.resolve(beta, string.from("alpha.test"), mut none, Never) {
        Error(Denied) => true,
        _ => false
    }
    let malformed = match host.resolve(n, string.from("bad..test"), mut none, Never) {
        Error(Denied) => true,
        _ => false
    }
    two && empty && unreachable && narrowed && malformed
}

// Take the next call and expect Resolve of `name` with `room` bytes.
fn resolve_call(mut s: Served[NetOp], name: String, room: u64) -> Option[Call[NetOp]] waits {
    match provide.next(mut s) {
        Some(take call) => {
            let mut p: Bytes = list.with_capacity(16)
            provide.payload(call, 0, mut p)
            let op = match provide.net_op(call) {
                Resolve(name: k, room: r) => k == string.byte_len(name) && r == room,
                _ => false
            }
            let named = match string.from_utf8(take p) {
                Ok(take t) => t == name,
                Error(_) => false
            }
            if op && named {
                Some(take call)
            } else {
                let _ = take call
                None
            }
        },
        None => None
    }
}

// Served Net names (NET-11, NOTES 34). The resolve's room is its spare Ip
// slots as 17-byte records (2 slots, 34 bytes), so of three staged records
// fill takes two, and Count(2) appends 10.0.0.1 and 2001:db8::1 after the
// caller's own address. Count(0) is a name with no address and
// Failed(Unreachable) reaches the caller as given. The narrowed and the
// malformed lookups never reach the server.
// expect: run net_resolve(tasks) = true
fn net_resolve(tasks: Tasks) -> bool waits {
    let (n, s) = provide.net(bytes 128)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, n, resolve_client)
    let two = match resolve_call(mut served, string.from("Alpha.Test"), 34) {
        Some(take call) => {
            let mut c = take call
            let mut b: Bytes = list.with_capacity(51)
            v4_record(mut b, 10, 0, 0, 1)
            doc_v6_record(mut b)
            v4_record(mut b, 192, 0, 2, 7)
            let took = provide.fill(mut served, mut c, b)
            took == 34 && net_answer(mut served, take c, Count(2))
        },
        None => false
    }
    let empty = match resolve_call(mut served, string.from("empty.test"), 34) {
        Some(take call) => net_answer(mut served, take call, Count(0)),
        None => false
    }
    let unreachable = match resolve_call(mut served, string.from("far.test"), 34) {
        Some(take call) => net_answer(mut served, take call, Failed(Unreachable)),
        None => false
    }
    let client = result.unwrap(task.join(take child))
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    two && empty && unreachable && client && quiet
}

// Stages 10.0.0.1 twice and answers Count(2).
fn twice_resolved(take s: Served[NetOp]) -> bool waits {
    let mut served = take s
    match provide.next(mut served) {
        Some(take call) => {
            let mut c = take call
            let mut b: Bytes = list.with_capacity(34)
            v4_record(mut b, 10, 0, 0, 1)
            v4_record(mut b, 10, 0, 0, 1)
            let took = provide.fill(mut served, mut c, b)
            took == 34 && net_answer(mut served, take c, Count(2))
        },
        None => false
    }
}

// NOTES 34: a resolve's records must be distinct; a repeated one fails the
// server with Fail, and the caller sees Reset with nothing appended.
// expect: run net_resolve_fail(tasks) = true
fn net_resolve_fail(tasks: Tasks) -> bool waits {
    let (n, s) = provide.net(bytes 128)
    let server = task.spawn(tasks, bytes 65536, take s, twice_resolved)
    let mut out: List[Ip] = list.with_capacity(2)
    let reset = match host.resolve(n, string.from("alpha.test"), mut out, Never) {
        Error(Reset) => list.len(out) == 0,
        _ => false
    }
    reset && fail_cause(task.join(take server))
}

type Timed: send {
    n: Net,
    v: Clock
}

// A resolve bounded by At(v, 100) that the server takes and never answers,
// then one bounded by At(v, 50) once the clock is already past it.
fn timed_client(take t: Timed) -> bool waits {
    let Timed(n, v) = take t
    let mut out: List[Ip] = list.with_capacity(2)
    let held = match host.resolve(n, string.from("alpha.test"), mut out, At(v, 100)) {
        Error(TimedOut) => list.len(out) == 0 && host.mono_ns(v) == 150,
        _ => false
    }
    let late = match host.resolve(n, string.from("beta.test"), mut out, At(v, 50)) {
        Error(TimedOut) => true,
        _ => false
    }
    held && late
}

// CONC-7 on a served Net (NOTES 35): a call's `until` is the caller's, not
// the server's. The server takes the first resolve and holds it; idle shows
// the caller waiting on 100, and advance_to(150) ends the call TimedOut. The
// server's reply after that is Withdrawn. The second resolve's deadline has
// passed when it is issued, so it is TimedOut and never reaches the server.
// expect: run net_deadline(tasks) = true
fn net_deadline(tasks: Tasks) -> bool waits {
    let (v, h) = provide.clock(0, 0)
    let mut hand = take h
    let (n, s) = provide.net(bytes 128)
    let mut served = take s
    let child = task.spawn(tasks, bytes 65536, Timed(n: n, v: v), timed_client)
    let expired = match resolve_call(mut served, string.from("alpha.test"), 34) {
        Some(take call) => {
            let waiting = clock.idle(mut hand) == Some(100)
            clock.advance_to(mut hand, 150)
            let client = result.unwrap(task.join(take child))
            let refused = match provide.reply(mut served, take call, provide.net_reply(Count(0))) {
                Error(Withdrawn()) => true,
                _ => false
            }
            waiting && client && refused
        },
        None => {
            let _ = task.join(take child)
            false
        }
    }
    let quiet = match provide.next(mut served) {
        Some(take call) => {
            let _ = take call
            false
        },
        None => true
    }
    expired && quiet
}

fn seal_for_unit(take _unused: u64) -> Secret {
    sealed_pencil(string.from("beta.test"))
}

// Both secrets keep their original policies. The helper's sealed secret
// keeps 80 bytes of its 4392-byte reservation charged after the join.
// expect: run sealed_secret_from_unit(tasks) = true
fn sealed_secret_from_unit(tasks: Tasks) -> bool waits {
    let local = sealed_pencil(string.from("alpha.test"))
    let checked = bound bytes 4392 {
        let worker = result.unwrap(task.spawn_unit(tasks, bytes 4096, 0u64, seal_for_unit))
        let received = result.unwrap(task.join(take worker))
        let available: Result[(Client[u64], Inbox[u64]), Capacity] = conn.new(1, bytes 4320)
        let held = match available {
            Error(c) => c.requested == 4392 && c.available == 4312,
            Ok(_) => false
        }
        let local_denies = match secret.narrow(local, string.from("beta.test")) {
            Ok(_) => false,
            Error(_) => true
        }
        let received_permits = match secret.narrow(received, string.from("beta.test")) {
            Ok(_) => true,
            Error(_) => false
        }
        held && local_denies && received_permits
    }
    result.unwrap(checked)
}

// Module places (package store): a directory of prelinked places by name (RUNNER-SPEC v2.30 §13).
// One task, the directory, owns every name's state. Every start and every stop of a place
// goes through runner.operate: a place's task runs operate, and the directory only sends
// on its stop channel and waits for its last message.

// What a factory's `make` gets to build its PlaceConfig from. The directory replaces the
// config's backing and selection with the listed ones (§13.3).
// `name` is the listed name being started (v2.30), so a place can name itself to the services it is given.
pub type Supplied: send { name: String, tasks: Tasks, clock: Clock, random: Random, net: Net }

// A start sees a view of the directory's seed (v2.30).
pub opaque type Factory[T: send]: send { start: own[send] fn(take Launch[T], T) -> Result[Started, Refused] }

pub type Listed[T: send]: send { name: String, factory: Factory[T], backing: runner.Backing, selection: runner.Selection }

// idle_ms None: the directory never unloads a place; a place unloads only by its own
// idle stop (§14.4). max_names bounds the listed names, the initial and the added ones.
pub type DirectoryConfig: send {
    idle_ms: Option[u64], max_places: u64, max_names: u64, place_bytes: u64,
    tasks: Tasks, clock: Clock, random: Random, net: Net,
    watch: Option[Sender[Change]],
}

pub type Unloaded: send { name: String, ended: Result[runner.Ended, runner.StartError] }
pub type Change: send = Up(String) | Down(Unloaded)
pub type Limit: send = Count(u64) | Reserve(runner.Room)
pub type Refused: send = Unknown | Full(Limit) | Start(runner.StartError) | Stopping
pub type CloseRefused: send = Unknown | NotLoaded | Leased | Stopping
pub type DirectoryError: send = Missing(String) | Duplicate(String) | Full(Capacity)
pub type AddRefused: send = Duplicate | Full(u64) | Stopping
pub type RemoveRefused: send = Unknown | Loaded | Stopping

pub opaque type Directory[T: send] { to: Sender[DirIn[T]], actor: Task[List[Unloaded]], ticker: Option[Task[()]] }
pub opaque type Opener[T: send]: send { to: Sender[DirIn[T]] }
// A lease pins its instance: the directory never unloads a place while a lease on it lives.
pub opaque type Lease: send { status: Latest[runner.Status], pin: Arc[Pin] }

// The run task's own bytes on top of operate's: the operate task's charge, the phase handoff
// and its last message.
const PLACE_TASK_BYTES: u64 = 65536u64
// The directory task's own bytes on top of the place budget: names, inboxes, leases and the
// spawn charge of each place task.
const DIRECTORY_BYTES: u64 = 1048576u64
const DIRECTORY_SLOT_BYTES: u64 = 8192u64

type Launch[T: send]: send {
    supplied: Supplied, backing: runner.Backing, selection: runner.Selection, available: u64,
    stop: Receiver[()], status: Latest[runner.Status], to: Sender[DirIn[T]], slot: u64,
}
type Started { task: Task[()], charge: u64 }

type DirIn[T: send]: send = Open(String, Sender[Result[Lease, Refused]]) | Close(String, Sender[Result[Unloaded, CloseRefused]])
    | Add(Listed[T], Sender[Result[(), AddRefused]]) | Remove(String, Sender[Result[(), RemoveRefused]])
    | Up(u64) | Down(u64, Result[runner.Ended, runner.StartError]) | Tick | Shutdown

type Pin: shareable + send { slot: u64 }

type Live { stop: Sender[()], status: Latest[runner.Status], pin: Arc[Pin], task: Task[()], charge: u64 }
type Waiters = List[Sender[Result[Lease, Refused]]]
type Closers = List[Sender[Result[Unloaded, CloseRefused]]]
// Absent: no instance. Starting: an instance is starting and these opens wait for it.
// Running: the instance is Ready; the time it was first seen unleased, if it is.
// Closing: the instance drains; these opens start a fresh instance after it ends.
type State = Absent | Starting(Live, Waiters) | Running(Live, Option[u64]) | Closing(Live, Waiters, Closers)
// A removed name leaves its slot unlisted, so the slot numbers live place tasks report under
// never shift; an add reuses an unlisted slot first.
type Slot[T: send] { name: String, factory: Factory[T], backing: runner.Backing, selection: runner.Selection, volatile: bool, listed: bool, state: State }
// What the directory task starts from; it builds its slots, which hold task handles, itself.
type Seed[T: send]: send { seed: T, listed: List[Listed[T]], inbox: Receiver[DirIn[T]], to: Sender[DirIn[T]], idle_ms: Option[u64], max_places: u64, max_names: u64, place_bytes: u64,
    tasks: Tasks, clock: Clock, random: Random, net: Net, watch: Option[Sender[Change]] }

type Actor[T: send] {
    seed: T, slots: List[Slot[T]], inbox: Receiver[DirIn[T]], to: Sender[DirIn[T]], idle_ms: Option[u64], max_places: u64, max_names: u64, place_bytes: u64,
    tasks: Tasks, clock: Clock, random: Random, net: Net, watch: Option[Sender[Change]],
    used: u64, live: u64, stopping: bool, unloaded: List[Unloaded],
}

type Ticker[T: send]: send { to: Sender[DirIn[T]], clock: Clock, every_ms: u64 }

type PlaceJob[T: send, G: send, H: send, S: send, B: send]: send {
    config: runner.PlaceConfig[G, H, S, B], stop: Receiver[()], status: Latest[runner.Status], to: Sender[DirIn[T]], slot: u64, need: u64,
}
type Operated[G: send, H: send, S: send, B: send]: send {
    config: runner.PlaceConfig[G, H, S, B], stop: Receiver[()], status: Latest[runner.Status], watch: Sender[Receiver[runner.Phase]],
}

fn room(cap: Capacity) -> runner.Room { runner.Room(requested: cap.requested, available: cap.available) }

pub fn place_factory[T: send, G: send, H: send, S: send, B: send](make: fn(take Supplied) -> Result[runner.PlaceConfig[G, H, S, B], Capacity]) -> Result[Factory[T], Capacity] {
    let made = fn(take request: Launch[T], seed: T) -> Result[Started, Refused] { start_place(take request, make) }
    Ok(Factory(start: take made))
}

// A factory whose `make` also sees the directory's seed (v2.30): the services a place's
// grants are made from. `make` is still a plain fn, so only linked code is listed.
pub fn seeded_factory[T: send, G: send, H: send, S: send, B: send](make: fn(take Supplied, T) -> Result[runner.PlaceConfig[G, H, S, B], Capacity]) -> Result[Factory[T], Capacity] {
    let made = fn(take request: Launch[T], seed: T) -> Result[Started, Refused] {
        let tasks = request.supplied.tasks
        let config = make(clone(request.supplied), seed)
        start_made(take request, tasks, take config)
    }
    Ok(Factory(start: take made))
}

fn start_place[T: send, G: send, H: send, S: send, B: send](take request: Launch[T], make: fn(take Supplied) -> Result[runner.PlaceConfig[G, H, S, B], Capacity]) -> Result[Started, Refused] {
    let tasks = request.supplied.tasks
    let config = make(clone(request.supplied))
    start_made(take request, tasks, take config)
}

fn start_made[T: send, G: send, H: send, S: send, B: send](take request: Launch[T], tasks: Tasks, take made: Result[runner.PlaceConfig[G, H, S, B], Capacity]) -> Result[Started, Refused] {
    let Launch(supplied: _, backing: take backing, selection: selection, available: available, stop: take halt, status: take root, to: take to, slot: slot) = take request
    let mut config = match take made { Ok(take m) => take m, Error(cap) => return Error(Start(Full(cap))) }
    config.backing = take backing
    config.selection = selection
    let need = match runner.operate_bytes(config) { Ok(total) => total, Error(cap) => return Error(Start(Full(cap))) }
    let charge = int.saturating_add(need, PLACE_TASK_BYTES)
    if charge > available { return Error(Full(Reserve(runner.Room(requested: charge, available: available)))) }
    let job = PlaceJob(config: take config, stop: take halt, status: take root, to: take to, slot: slot, need: need)
    let run: fn(take PlaceJob[T, G, H, S, B]) -> () waits = run_place
    let handle = task.spawn(tasks, bytes charge, take job, run)
    Ok(Started(task: take handle, charge: charge))
}

// The place task: operate runs in a child so this task can read its phases. Its last
// message to the directory is Down, sent after operate has returned and so after the Db
// is closed or dropped.
fn run_place[T: send, G: send, H: send, S: send, B: send](take job: PlaceJob[T, G, H, S, B]) -> () waits {
    let to = channel.sender(job.to)
    let slot = job.slot
    let ended = operated(take job)
    let _ = channel.send(to, Down(slot, take ended))
}

fn operated[T: send, G: send, H: send, S: send, B: send](take job: PlaceJob[T, G, H, S, B]) -> Result[runner.Ended, runner.StartError] waits {
    let PlaceJob(config: take config, stop: take halt, status: take root, to: take to, slot: slot, need: need) = take job
    let tasks = config.tasks
    let (handoff, phases_from): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = channel.new(1u64)
    let request = Operated(config: take config, stop: take halt, status: take root, watch: take handoff)
    let run: fn(take Operated[G, H, S, B]) -> Result[runner.Ended, runner.StartError] waits = run_operate
    let running = task.spawn(tasks, bytes need, take request, run)
    if let Ok(take phases) = channel.receive(phases_from) {
        while let Ok(phase) = channel.receive(phases) {
            if let Ready = phase { let _ = channel.send(to, Up(slot)) }
        }
    }
    match task.join(take running) {
        Ok(take ended) => take ended,
        Error(_) => Error(Missing("operate")),
    }
}

fn run_operate[G: send, H: send, S: send, B: send](take request: Operated[G, H, S, B]) -> Result[runner.Ended, runner.StartError] waits {
    let Operated(config: take config, stop: take halt, status: take root, watch: take phases) = take request
    runner.operate(take config, take halt, root, Some(take phases))
}

fn volatile(backing: runner.Backing) -> bool { match backing { Disk(_, _) => false, _ => true } }

fn copy_backing(backing: runner.Backing) -> runner.Backing {
    match backing { Memory => Memory, Disk(dir, options) => Disk(dir, clone(options)), Temp(dir) => Temp(dir) }
}

pub fn directory[T: send](take places: List[Listed[T]], take config: DirectoryConfig, take seed: T) -> Result[Directory[T], DirectoryError] {
    if config.idle_ms == Some(0u64) { return Error(Missing("idle_ms")) }
    if config.max_places == 0u64 { return Error(Missing("max_places")) }
    if config.max_names == 0u64 || list.len(places) > config.max_names { return Error(Missing("max_names")) }
    if config.place_bytes == 0u64 { return Error(Missing("place_bytes")) }
    let count = list.len(places)
    for i in 0u64 .. count {
        for j in 0u64 .. i {
            if places[i].name == places[j].name {
                let name = string.from(places[i].name)
                return Error(Duplicate(take name))
            }
        }
    }
    let DirectoryConfig(idle_ms: idle_ms, max_places: max_places, max_names: max_names, place_bytes: place_bytes, tasks: tasks, clock: clock,
        random: random, net: net, watch: take watch) = take config
    let (to, inbox): (Sender[DirIn[T]], Receiver[DirIn[T]]) = channel.new(64u64)
    let started_with = Seed(seed: take seed, listed: take places, inbox: take inbox, to: channel.sender(to), idle_ms: idle_ms, max_places: max_places, max_names: max_names,
        place_bytes: place_bytes, tasks: tasks, clock: clock, random: random, net: net, watch: take watch)
    let own = int.saturating_add(DIRECTORY_BYTES, int.saturating_mul(max_names, DIRECTORY_SLOT_BYTES))
    let running = task.spawn(tasks, bytes int.saturating_add(place_bytes, own), take started_with, run_directory)
    let ticker = match idle_ms {
        Some(ms) => {
            let every = if ms < 2u64 { 1u64 } else { ms / 2u64 }
            let ticking = Ticker(to: channel.sender(to), clock: clock, every_ms: every)
            Some(task.spawn(tasks, bytes 4096u64, take ticking, tick))
        },
        None => None,
    }
    Ok(Directory(to: take to, actor: take running, ticker: take ticker))
}

fn tick[T: send](take t: Ticker[T]) -> () waits {
    loop {
        host.sleep_until(t.clock, host.mono_ns(t.clock) + t.every_ms * 1000000u64)
        if let Error(_) = channel.send(t.to, Tick) { return }
    }
}

pub fn opener[T: send](d: Directory[T]) -> Opener[T] { Opener(to: channel.sender(d.to)) }

pub fn status(l: Lease) -> Latest[runner.Status] { latest.handle(l.status) }

pub fn open[T: send](o: Opener[T], name: String) -> Result[Lease, Refused] waits {
    let owned = string.from(name)
    let (reply, answer): (Sender[Result[Lease, Refused]], Receiver[Result[Lease, Refused]]) = channel.new(1u64)
    if let Error(_) = channel.send(o.to, Open(take owned, take reply)) { return Error(Stopping) }
    match channel.receive(answer) { Ok(take answered) => take answered, Error(_) => Error(Stopping) }
}

// Lists one more name. A listed name, even an unloaded one, is a duplicate.
pub fn add[T: send](o: Opener[T], take l: Listed[T]) -> Result[(), AddRefused] waits {
    let (reply, answer): (Sender[Result[(), AddRefused]], Receiver[Result[(), AddRefused]]) = channel.new(1u64)
    if let Error(_) = channel.send(o.to, Add(take l, take reply)) { return Error(Stopping) }
    match channel.receive(answer) { Ok(take answered) => take answered, Error(_) => Error(Stopping) }
}

// Unlists a name with no instance; a loaded one must be closed first.
pub fn remove[T: send](o: Opener[T], name: String) -> Result[(), RemoveRefused] waits {
    let owned = string.from(name)
    let (reply, answer): (Sender[Result[(), RemoveRefused]], Receiver[Result[(), RemoveRefused]]) = channel.new(1u64)
    if let Error(_) = channel.send(o.to, Remove(take owned, take reply)) { return Error(Stopping) }
    match channel.receive(answer) { Ok(take answered) => take answered, Error(_) => Error(Stopping) }
}

pub fn close[T: send](o: Opener[T], name: String) -> Result[Unloaded, CloseRefused] waits {
    let owned = string.from(name)
    let (reply, answer): (Sender[Result[Unloaded, CloseRefused]], Receiver[Result[Unloaded, CloseRefused]]) = channel.new(1u64)
    if let Error(_) = channel.send(o.to, Close(take owned, take reply)) { return Error(Stopping) }
    match channel.receive(answer) { Ok(take answered) => take answered, Error(_) => Error(Stopping) }
}

// Stops every place through its own graceful stop and returns how each ended.
pub fn stop[T: send](take d: Directory[T]) -> List[Unloaded] waits {
    let Directory(to: take to, actor: take actor, ticker: take ticker) = take d
    let _ = channel.send(to, Shutdown)
    let ended = match task.join(take actor) { Ok(take done) => take done, Error(_) => no_unloaded() }
    if let Some(take t) = take ticker { let _ = task.cancel_join(take t) }
    take ended
}

fn find[T: send](slots: List[Slot[T]], name: String) -> Option[u64] {
    for i in 0u64 .. list.len(slots) {
        if slots[i].listed && slots[i].name == name { return Some(i) }
    }
    None
}

fn unique(mut pin: Arc[Pin]) -> bool {
    match arc.with_unique(mut pin, scoped fn(mut held: Pin) -> () { }) { Some(()) => true, None => false }
}

fn lease(live: Live) -> Lease { Lease(status: latest.handle(live.status), pin: arc.share(live.pin)) }

fn answer_all(take waiters: Waiters, refused: Refused) {
    let mut left = take waiters
    while let Some(take waiter) = list.pop(mut left) {
        let copied: Refused = clone(refused)
        let sent = take copied
        let _ = channel.try_send(waiter, Error(take sent))
    }
}

fn lease_all(take waiters: Waiters, live: Live) {
    let mut left = take waiters
    while let Some(take waiter) = list.pop(mut left) {
        let _ = channel.try_send(waiter, Ok(lease(live)))
    }
}

fn one_waiter(take waiter: Sender[Result[Lease, Refused]]) -> Option[Waiters] {
    let mut waiters: Waiters = list.new()
    list.push(mut waiters, take waiter)
    Some(take waiters)
}

fn watch_up[T: send](a: Actor[T], index: u64) {
    if let Some(to) = a.watch {
        let name = string.from(a.slots[index].name)
        let _ = channel.try_send(to, Up(take name))
    }
}

// The activation the instance ran, so the next start of a disk place selects the same one.
fn pin_activation[T: send](mut a: Actor[T], index: u64, live: Live) {
    let version = latest.read(live.status).activation
    if version != 0u64 && !a.slots[index].volatile { a.slots[index].selection = Current(version) }
}

// Starts a fresh instance for these waiters, or answers each of them why not.
fn launch[T: send](mut a: Actor[T], index: u64, take waiters: Waiters) {
    if a.live >= a.max_places { answer_all(take waiters, Full(Count(a.max_places))); return }
    let (stop_to, stop_from): (Sender[()], Receiver[()]) = channel.new(1u64)
    let root = match runner.status_root() { Ok(take made_root) => take made_root, Error(cap) => { answer_all(take waiters, Full(Reserve(room(cap)))); return } }
    let supplied = Supplied(name: string.from(a.slots[index].name), tasks: a.tasks, clock: a.clock, random: a.random, net: a.net)
    let launched = Launch(supplied: take supplied, backing: copy_backing(a.slots[index].backing), selection: a.slots[index].selection,
        available: a.place_bytes - a.used, stop: take stop_from, status: latest.handle(root), to: channel.sender(a.to), slot: index)
    let started = (a.slots[index].factory.start)(take launched, a.seed)
    match take started {
        Ok(take begun) => {
            let Started(task: take running, charge: charged) = take begun
            let pin = arc.new(Pin(slot: index))
            a.used += charged
            a.live += 1u64
            a.slots[index].state = Starting(Live(stop: take stop_to, status: take root, pin: take pin, task: take running, charge: charged), take waiters)
        },
        Error(take refused) => answer_all(take waiters, refused),
    }
}

fn no_waiters() -> Waiters { list.new() }
fn no_closers() -> Closers { list.new() }
fn no_unloaded() -> List[Unloaded] { list.new() }

fn begin_close(take live: Live) -> Live {
    let _ = channel.try_send(live.stop, ())
    take live
}

fn run_directory[T: send](take begun: Seed[T]) -> List[Unloaded] waits {
    let Seed(seed: take seed, listed: take listed, inbox: take inbox, to: take to, idle_ms: idle_ms, max_places: max_places, max_names: max_names,
        place_bytes: place_bytes, tasks: tasks, clock: clock, random: random, net: net, watch: take watch) = take begun
    let mut slots: List[Slot[T]] = list.with_capacity(list.len(listed))
    let mut left = take listed
    while let Some(take entry) = list.pop(mut left) {
        let Listed(name: take name, factory: take factory, backing: take backing, selection: selection) = take entry
        let changes = volatile(backing)
        let slot = Slot(name: take name, factory: take factory, backing: take backing, selection: selection, volatile: changes, listed: true, state: Absent)
        list.push(mut slots, take slot)
    }
    list.reverse(mut slots)
    let mut a = Actor(seed: take seed, slots: take slots, inbox: take inbox, to: take to, idle_ms: idle_ms, max_places: max_places, max_names: max_names, place_bytes: place_bytes,
        tasks: tasks, clock: clock, random: random, net: net, watch: take watch,
        used: 0u64, live: 0u64, stopping: false, unloaded: no_unloaded())
    loop {
        if a.stopping && a.live == 0u64 { return replace(mut a.unloaded, no_unloaded()) }
        let message = match channel.receive(a.inbox) { Ok(take m) => take m, Error(_) => return replace(mut a.unloaded, no_unloaded()) }
        match take message {
            Open(take name, take reply) => on_open(mut a, name, take reply),
            Close(take name, take reply) => on_close(mut a, name, take reply),
            Add(take l, take reply) => on_add(mut a, take l, take reply),
            Remove(take name, take reply) => on_remove(mut a, name, take reply),
            Up(index) => on_up(mut a, index),
            Down(index, take ended) => ended_place(mut a, index, take ended),
            Tick => if !a.stopping { idle_sweep(mut a) },
            Shutdown => on_shutdown(mut a),
        }
    }
}

fn on_open[T: send](mut a: Actor[T], name: String, take reply: Sender[Result[Lease, Refused]]) {
    if a.stopping { let _ = channel.try_send(reply, Error(Stopping)); return }
    let Some(index) = find(a.slots, name) else { let _ = channel.try_send(reply, Error(Unknown)); return }
    match replace(mut a.slots[index].state, Absent) {
        Absent => if let Some(take waiters) = one_waiter(take reply) { launch(mut a, index, take waiters) },
        Starting(take live, take waiters) => {
            let mut more = take waiters
            list.push(mut more, take reply)
            a.slots[index].state = Starting(take live, take more)
        },
        Running(take live, _) => {
            let _ = channel.try_send(reply, Ok(lease(live)))
            a.slots[index].state = Running(take live, None)
        },
        Closing(take live, take reopen, take closers) => {
            let mut more = take reopen
            list.push(mut more, take reply)
            a.slots[index].state = Closing(take live, take more, take closers)
        },
    }
}

fn on_add[T: send](mut a: Actor[T], take l: Listed[T], take reply: Sender[Result[(), AddRefused]]) {
    if a.stopping { let _ = channel.try_send(reply, Error(Stopping)); return }
    if let Some(_) = find(a.slots, l.name) { let _ = channel.try_send(reply, Error(Duplicate)); return }
    let mut free: Option[u64] = None
    let mut names = 0u64
    for i in 0u64 .. list.len(a.slots) {
        if a.slots[i].listed { names += 1u64 } else if none(free) { free = Some(i) }
    }
    if names >= a.max_names { let _ = channel.try_send(reply, Error(Full(a.max_names))); return }
    let Listed(name: take name, factory: take factory, backing: take backing, selection: selection) = take l
    let changes = volatile(backing)
    let slot = Slot(name: take name, factory: take factory, backing: take backing, selection: selection, volatile: changes, listed: true, state: Absent)
    match free {
        Some(i) => { a.slots[i] = take slot },
        None => list.push(mut a.slots, take slot),
    }
    let _ = channel.try_send(reply, Ok(()))
}

fn on_remove[T: send](mut a: Actor[T], name: String, take reply: Sender[Result[(), RemoveRefused]]) {
    if a.stopping { let _ = channel.try_send(reply, Error(Stopping)); return }
    let Some(index) = find(a.slots, name) else { let _ = channel.try_send(reply, Error(Unknown)); return }
    let absent = match a.slots[index].state { Absent => true, _ => false }
    if !absent { let _ = channel.try_send(reply, Error(Loaded)); return }
    a.slots[index].listed = false
    let _ = channel.try_send(reply, Ok(()))
}

fn none[U](o: Option[U]) -> bool { match o { None => true, Some(_) => false } }

fn on_close[T: send](mut a: Actor[T], name: String, take reply: Sender[Result[Unloaded, CloseRefused]]) {
    if a.stopping { let _ = channel.try_send(reply, Error(Stopping)); return }
    let Some(index) = find(a.slots, name) else { let _ = channel.try_send(reply, Error(Unknown)); return }
    match replace(mut a.slots[index].state, Absent) {
        Absent => { let _ = channel.try_send(reply, Error(NotLoaded)) },
        Starting(take live, take waiters) => {
            let _ = channel.try_send(reply, Error(Leased))
            a.slots[index].state = Starting(take live, take waiters)
        },
        Running(take live, since) => {
            let mut held = take live
            if unique(mut held.pin) {
                let mut closers = no_closers()
                list.push(mut closers, take reply)
                a.slots[index].state = Closing(begin_close(take held), no_waiters(), take closers)
            } else {
                let _ = channel.try_send(reply, Error(Leased))
                a.slots[index].state = Running(take held, since)
            }
        },
        Closing(take live, take reopen, take closers) => {
            let mut more = take closers
            list.push(mut more, take reply)
            a.slots[index].state = Closing(take live, take reopen, take more)
        },
    }
}

fn on_up[T: send](mut a: Actor[T], index: u64) {
    match replace(mut a.slots[index].state, Absent) {
        Starting(take live, take waiters) => {
            pin_activation(mut a, index, live)
            // The watch hears Up before any open gets its lease.
            watch_up(a, index)
            lease_all(take waiters, live)
            a.slots[index].state = Running(take live, None)
        },
        Closing(take live, take reopen, take closers) => {
            pin_activation(mut a, index, live)
            a.slots[index].state = Closing(take live, take reopen, take closers)
        },
        other => { a.slots[index].state = take other },
    }
}

fn on_shutdown[T: send](mut a: Actor[T]) {
    a.stopping = true
    for index in 0u64 .. list.len(a.slots) {
        match replace(mut a.slots[index].state, Absent) {
            Absent => (),
            Starting(take live, take waiters) => {
                answer_all(take waiters, Stopping)
                a.slots[index].state = Closing(begin_close(take live), no_waiters(), no_closers())
            },
            Running(take live, _) => { a.slots[index].state = Closing(begin_close(take live), no_waiters(), no_closers()) },
            Closing(take live, take reopen, take closers) => {
                answer_all(take reopen, Stopping)
                a.slots[index].state = Closing(take live, no_waiters(), take closers)
            },
        }
    }
}

// A place unloads only after it has been seen unleased for idle_ms; a volatile place never
// does (§13.3).
fn idle_sweep[T: send](mut a: Actor[T]) {
    let Some(idle_ms) = a.idle_ms else { return }
    let now = host.mono_ns(a.clock) / 1000000u64
    for index in 0u64 .. list.len(a.slots) {
        if a.slots[index].volatile { continue }
        match replace(mut a.slots[index].state, Absent) {
            Running(take live, since) => {
                let mut held = take live
                if !unique(mut held.pin) {
                    a.slots[index].state = Running(take held, None)
                } else {
                    match since {
                        None => { a.slots[index].state = Running(take held, Some(now)) },
                        Some(first) => if now - first >= idle_ms {
                            a.slots[index].state = Closing(begin_close(take held), no_waiters(), no_closers())
                        } else {
                            a.slots[index].state = Running(take held, Some(first))
                        },
                    }
                }
            },
            other => { a.slots[index].state = take other },
        }
    }
}

// The place's last message: its operate has returned. Only now may its name start again.
fn ended_place[T: send](mut a: Actor[T], index: u64, take ended: Result[runner.Ended, runner.StartError]) waits {
    let state = replace(mut a.slots[index].state, Absent)
    let (live, waiters, closers, reopening): (Live, Waiters, Closers, bool) = match take state {
        Starting(take live, take waiters) => (take live, take waiters, no_closers(), false),
        Running(take live, _) => (take live, no_waiters(), no_closers(), false),
        Closing(take live, take reopen, take closers) => (take live, take reopen, take closers, true),
        Absent => return,
    }
    pin_activation(mut a, index, live)
    let Live(task: take running, charge: charged, ..) = take live
    let _ = task.join(take running)
    a.used -= charged
    a.live -= 1u64
    let name = string.from(a.slots[index].name)
    let unloaded = Unloaded(name: take name, ended: take ended)
    let mut answering = take closers
    while let Some(take closer) = list.pop(mut answering) {
        let copied: Unloaded = clone(unloaded)
        let _ = channel.try_send(closer, Ok(take copied))
    }
    if let Some(to) = a.watch {
        let copied: Unloaded = clone(unloaded)
        let _ = channel.try_send(to, Down(take copied))
    }
    if list.len(waiters) != 0u64 {
        // Opens that waited on a close start a fresh instance (§13.2); opens that waited on a
        // start that never reached Ready hear why, every one of them.
        if a.stopping {
            answer_all(take waiters, Stopping)
        } else if reopening {
            launch(mut a, index, take waiters)
        } else {
            match unloaded.ended {
                Error(problem) => {
                    let copied: runner.StartError = clone(problem)
                    answer_all(take waiters, Start(take copied))
                },
                Ok(_) => answer_all(take waiters, Stopping),
            }
        }
    }
    if a.stopping { let _ = list.push(mut a.unloaded, take unloaded) }
}

// Measure the whole append transaction on identical parent histories.
fn fits(children: u64, budget: u64) -> bool waits {
    let (c, _) = provide.clock(0, 100)
    let mut db = store.memory(c, provide.random(4), result.unwrap(store.sized(Memory, 268435456)))
    let h = result.unwrap(store.bind_declaration(mut db, Migrate, schema))
    result.unwrap(admit(mut db, h, children))
    let owned = take db
    let probe = bound steps budget {
        let mut active = take owned
        write_parent(mut active, h, b"p")
    }
    match probe {
        Ok(Ok(_)) => true,
        Error(_) => false,
        _ => fail("parent append refused"),
    }
}

@test
fn idle_children_append_steps(out: Stdout) -> Result[(), u64] waits {
    let mut low = 1u64
    let mut high = 65536u64
    if !fits(0, high) {
        fail("append exceeded measurement range")
    }
    while low < high {
        let mid = low + (high - low) / 2
        if fits(0, mid) {
            high = mid
        } else {
            low = mid + 1
        }
    }
    let mut text = string.from("parent append steps: ")
    string.push_u64(mut text, low)
    string.push_char(mut text, '\n')
    result.unwrap(stdout.write(out, text))
    for count in[10u64, 100u64] {
        if fits(count, low - 1) || !fits(count, low) {
            return Error(low)
        }
    }
    Ok(())
}

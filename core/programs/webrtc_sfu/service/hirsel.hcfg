pkg_v1.Package(
    name: "hirsel.ai/webrtc_sfu_service",
    version: "1.0.0",
    charge: ChargeV1,
    sources: [("main.hirsel", "main"), ("config.hirsel", "config")],
    dependencies: [
        ("std", Toolchain(package: "std", major: 1, authority: [])),
        ("webrtc_sfu", Path(
            package: "webrtc_sfu",
            major: 1,
            path: "..",
            authority: [Net, Clock, Random, Stdout, Tasks, Secret],
        )),
        ("turn", Path(package: "turn", major: 1, path: "../../turn", authority: [Random, Secret])),
        ("runner", Path(
            package: "runner",
            major: 1,
            path: "../../runner",
            authority: [Dir, Net, Clock, Random, Stderr, Process, Tasks, Args, Secret, Cred],
        )),
        ("store", Path(package: "store", major: 1, path: "../../store", authority: [Dir, Clock, Random, Tasks])),
    ],
)

// L3/L10/L18c: replay applies both state trees, keeps the catalog and uses the
// frame's branch/version/at. An unknown branch or a repeated version is Gap.
pub fn journal_law_apply() -> bool {
    let mut replay = journal_initial()
    result.unwrap(define_store_collection(mut replay.state.tips[0].roots.collections, 1, 1, mut replay.next_node))
    for head in 1u64 .. 4 {
        let key = result.unwrap(logical_key(1, key_word(7)))
        let mut data: List[JournalOp] = list.new()
        list.push(mut data, JournalOp(key: result.unwrap(copied(key)), value: Some(key_word(head * 10))))
        let mut streams: List[JournalOp] = list.new()
        list.push(mut streams, JournalOp(key: result.unwrap(copied(string.as_bytes("stream"))), value: Some(key_word(head))))
        let commit = JournalCommit(branch: 0, version: head, at: 100 + head, data: take data, streams: take streams, call: None)
        result.unwrap(journal_apply("j-7", mut replay, Commit(take commit)))
        if replay.state.tips[0].head != head || replay.state.tips[0].at != 100 + head {
            return false
        }
        match get_page_row(replay.state.tips[0].roots.collections, key) {
            Some(v) => if decode_word(v) != head * 10 {
                return false
            },
            None => return false
        }
        match get_page_row(replay.state.tips[0].roots.streams, string.as_bytes("stream")) {
            Some(v) => if decode_word(v) != head {
                return false
            },
            None => return false
        }
    }
    let saved = share_page_tree(replay.state.tips[0].roots.collections)
    let duplicate = JournalCommit(branch: 0, version: 3, at: 103, data: list.new(), streams: list.new(), call: None)
    match journal_apply("j-7", mut replay, Commit(take duplicate)) {
        Error(Corrupt(f)) => match f.why {
            Gap(3) => {},
            _ => return false
        },
        _ => return false
    }
    let foreign_branch = JournalCommit(branch: 1, version: 4, at: 104, data: list.new(), streams: list.new(), call: None)
    match journal_apply("j-7", mut replay, Commit(take foreign_branch)) {
        Error(Corrupt(f)) => match f.why {
            Gap(4) => {},
            _ => return false
        },
        _ => return false
    }
    let key = result.unwrap(logical_key(1, key_word(7)))
    let mut deletes: List[JournalOp] = list.new()
    list.push(mut deletes, JournalOp(key: result.unwrap(copied(key)), value: None))
    let removed = JournalCommit(branch: 0, version: 4, at: 104, data: take deletes, streams: list.new(), call: None)
    result.unwrap(journal_apply("j-7", mut replay, Commit(take removed)))
    if page_row_count(replay.state.tips[0].roots.collections) != 0 || page_row_count(saved) != 1 || replay.state.tips[0].head != 4 || replay.state.tips[0].at != 104 {
        return false
    }
    if page_row_count(replay.state.tips[0].roots.catalog) != 0 || page_row_count(replay.state.tips[0].roots.streams) != 1 {
        return false
    }
    match get_page_row(saved, key) {
        Some(v) => decode_word(v) == 30,
        None => false
    }
}

@test
fn journal_test_apply() -> Result[(), ()] {
    if journal_law_apply() {
        Ok(())
    } else {
        Error(())
    }
}

fn journal_end_bytes(id: StoreId, seq: u64, end: u64) -> Bytes {
    let ctx = DiskContext(store: id, role: 4, seq: seq)
    let mut raw = result.unwrap(disk_header_bytes(ctx, 0, 0))
    let mut payload: Bytes = list.new()
    result.unwrap(le(mut payload, end, 8))
    let frame = result.unwrap(disk_seal(ctx, 72, 0x0012, 1, payload))
    list.append(mut raw, frame)
    take raw
}

fn journal_initial() -> JournalReplay {
    journal_main(empty_roots(), 0, 0, 0)
}

// L3/L10/L12: next-header prev_end ignores an older torn tail; a bad final
// header is absent only without a good END, and its predecessor uses its own d.
pub fn journal_law_recovery(d: Dir) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let (take old, take old_end) = result.unwrap(disk_new_segment(d, id, 7, 0))
    let mut old_file = take old
    let first = journal_empty_commit(DiskContext(store: id, role: 2, seq: 7), 72, 1)
    result.unwrap(host.write(mut old_file, first))
    let mut junk: Bytes = list.new()
    list.fill(mut junk, 16, 255u8)
    result.unwrap(host.write(mut old_file, junk))
    result.unwrap(host.sync(mut old_file))
    result.unwrap(host.close(take old_file))
    result.unwrap(host.close(take old_end))
    result.unwrap(disk_write_synced(d, "j-7.end", journal_end_bytes(id, 7, 114)))
    let (take next_file, take next_end) = result.unwrap(disk_new_segment(d, id, 8, 114))
    let mut newest = take next_file
    let second = journal_empty_commit(DiskContext(store: id, role: 2, seq: 8), 72, 2)
    result.unwrap(host.write(mut newest, second))
    result.unwrap(host.sync(mut newest))
    result.unwrap(host.close(take newest))
    result.unwrap(host.close(take next_end))
    result.unwrap(disk_write_synced(d, "j-8.end", journal_end_bytes(id, 8, 114)))
    let all = result.unwrap(journal_recover(d, id, 7, true, journal_initial()))
    if all.seq != 8 || all.end != 114 || all.replay.state.tips[0].head != 2 || all.replay.state.tips[0].at != 102 {
        return false
    }
    let empty: Bytes = list.new()
    result.unwrap(disk_write_synced(d, "j-9", empty))
    let incomplete = result.unwrap(journal_recover(d, id, 7, true, journal_initial()))
    if incomplete.seq != 8 || incomplete.end != 114 || incomplete.replay.state.tips[0].head != 2 {
        return false
    }
    result.unwrap(disk_write_synced(d, "j-9.end", journal_end_bytes(id, 9, 72)))
    if !disk_corrupt(journal_recover(d, id, 7, true, journal_initial())) {
        return false
    }
    result.unwrap(host.remove(d, "j-9.end"))
    result.unwrap(host.remove(d, "j-8"))
    let previous = result.unwrap(journal_recover(d, id, 7, true, journal_initial()))
    previous.seq == 7 && previous.end == 114 && previous.replay.state.tips[0].head == 1 && previous.replay.state.tips[0].at == 101
}

@test
fn journal_test_recovery(d: Dir) -> Result[(), ()] waits {
    if journal_law_recovery(disk_test_directory(d)) {
        Ok(())
    } else {
        Error(())
    }
}

// Recovery precedes admission and rotation. The pack account alone is too
// small after replay; a refused open releases LOCK without publishing a cut.
pub fn journal_law_bootstrap(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let table_handle = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = view table_handle
    let id = db.store
    let seq = db.file_seq
    let baseline = db.resident
    let wall = db.heads[0].at + 17
    let next_node = db.next_node
    result.unwrap(close(take db))
    let mut stored: Bytes = list.new()
    result.unwrap(le(mut stored, 0, 2))
    result.unwrap(le(mut stored, 70, 8))
    let key = result.unwrap(logical_key(1, key_word(7)))
    let mut written: DataRows = new_data_rows()
    push_data_row(mut written, DataOp(key: take key, value: Some(PageValue(take stored))))
    let ci = CallInfo(id: CallId(store: id, branch: 0, version: 2), at: wall, seed: 0)
    let raw = result.unwrap(encode_commit(ci, mut written, seq, 72))
    if list.len(raw) != 73 {
        return false
    }
    let path = result.unwrap(disk_path("j-", seq, ""))
    let mut file = result.unwrap(host.open(d, path, Append))
    result.unwrap(host.write(mut file, raw))
    result.unwrap(host.sync(mut file))
    result.unwrap(host.close(take file))
    let end_path = result.unwrap(disk_path("j-", seq, ".end"))
    result.unwrap(disk_write_synced(d, end_path, journal_end_bytes(id, seq, 145)))
    let reopened = result.unwrap(open(tasks, d, c, r, options))
    if reopened.heads[0].head != 2 || reopened.heads[0].at != wall || reopened.resident != baseline + 94 || reopened.next_node <= next_node {
        return false
    }
    if result.unwrap(get(snapshot(reopened), sh, 7)) != Some(70u64) {
        return false
    }
    result.unwrap(close(take reopened))
    options.resident_limit = baseline + 93
    match open(tasks, d, c, r, options) {
        Error(Full(Resident(cap))) => if cap.requested != baseline + 94 || cap.available != baseline + 93 {
            return false
        },
        _ => return false
    }
    options.resident_limit = baseline + 94
    let exact = result.unwrap(open(tasks, d, c, r, options))
    if result.unwrap(get(snapshot(exact), sh, 7)) != Some(70u64) {
        return false
    }
    result.unwrap(close(take exact))
    true
}

@test
fn journal_test_bootstrap(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_bootstrap(disk_test_directory(d), c, r, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

fn journal_worker_case(d: Dir, tasks: Tasks, mode: u64) -> bool waits {
    let id = StoreId(hi: 1, lo: 2)
    let (take segment, take end_file) = result.unwrap(disk_new_segment(d, id, 7, 0))
    let (send, receive): (Sender[JournalMsg], Receiver[JournalMsg]) = channel.new(128)
    let (acks, received): (Sender[Ack], Receiver[Ack]) = channel.new(128)
    let (ready, waiting): (Sender[Result[(), Capacity]], Receiver[Result[(), Capacity]]) = channel.new(1)
    let (written_send, written_receive): (Sender[WriteNotice], Receiver[WriteNotice]) = channel.new(2)
    let (synced_send, _synced): (Sender[()], Receiver[()]) = channel.new(1)
    let first = journal_empty_commit(DiskContext(store: id, role: 2, seq: 7), 72, 1)
    result.unwrap(channel.send(send, Frame(take first, 1)))
    if mode == 3 {
        let (take rotated, take rotated_end) = result.unwrap(disk_new_segment(d, id, 8, 114))
        result.unwrap(channel.send(send, Rotate(take rotated, take rotated_end)))
    }
    let startup_frames = if mode == 4 {
        2u64
    } else {
        3u64
    }
    for head in 2u64 .. startup_frames + 1 {
        let seq = if mode == 3 {
            8u64
        } else {
            7u64
        }
        let offset = if mode == 3 {
            72 + (head - 2) * 42
        } else {
            72 + (head - 1) * 42
        }
        let raw = journal_empty_commit(DiskContext(store: id, role: 2, seq: seq), offset, head)
        result.unwrap(channel.send(send, Frame(take raw, head)))
    }
    let max_frames = if mode == 1 {
        1u32
    } else if mode == 4 {
        2u32
    } else {
        8u32
    }
    let max_bytes = if mode == 2 {
        41u32
    } else {
        100u32
    }
    let (idle_send, idle_receive): (Sender[()], Receiver[()]) = channel.new(1)
    let idle = if mode == 4 {
        Some(take idle_send)
    } else {
        None
    }
    let input = JournalWorker(store: id, seq: 7, segment: take segment, end_file: take end_file, group_commits: max_frames, group_bytes: max_bytes, receive: take receive, send: take acks, ready: take ready, written: take written_send, synced: take synced_send, idle: take idle)
    let reserve: u64 = int.widen(max_bytes)
    let worker = if mode == 0 || mode == 2 {
        task.spawn(tasks, bytes reserve + 65536, take input, journal_worker_zero)
    } else {
        task.spawn(tasks, bytes reserve + 65536, take input, journal_worker)
    }
    result.unwrap(result.unwrap(channel.receive(waiting)))
    let mut previously_acked = 0u64
    if mode == 4 {
        result.unwrap(channel.receive(idle_receive))
        match result.unwrap(channel.receive(received)) {
            Journaled(2, 84) => {},
            _ => return false
        }
        for head in 3u64 .. 5 {
            let raw = journal_empty_commit(DiskContext(store: id, role: 2, seq: 7), 72 + (head - 1) * 42, head)
            result.unwrap(channel.send(send, Frame(take raw, head)))
        }
        match result.unwrap(channel.receive(received)) {
            Journaled(4, 168) => {},
            _ => return false
        }
        // This check covers the second group and must leave the timer armed.
        result.unwrap(channel.send(send, IdleCheck))
        result.unwrap(channel.receive(idle_receive))
        // The next check sees no intervening writes. The queued batch must
        // still sync and recover after the worker releases its buffer.
        result.unwrap(channel.send(send, IdleCheck))
        for head in 5u64 .. 7 {
            let raw = journal_empty_commit(DiskContext(store: id, role: 2, seq: 7), 72 + (head - 1) * 42, head)
            result.unwrap(channel.send(send, Frame(take raw, head)))
        }
        previously_acked = 4
    }
    let _ = take send
    result.unwrap(result.unwrap(task.join(take worker)))
    let mut group_count = 0u64
    let mut final_number = previously_acked
    let mut final_bytes = previously_acked * 42
    while let Ok(ack) = channel.try_receive(received) {
        match ack {
            Journaled(n, bytes_out) => {
                group_count += 1
                if n <= final_number || bytes_out != n * 42 {
                    return false
                }
                if mode == 0 && group_count == 1 && n != 2 {
                    return false
                }
                if mode == 3 && group_count == 1 && n != 1 {
                    return false
                }
                final_number = n
                final_bytes = bytes_out
            },
            _ => return false
        }
    }
    let expected_groups = if mode == 1 || mode == 2 {
        3u64
    } else if mode == 4 {
        1u64
    } else {
        2u64
    }
    let expected_frames = if mode == 4 {
        6u64
    } else {
        3u64
    }
    if group_count != expected_groups || final_number != expected_frames || final_bytes != expected_frames * 42 {
        return false
    }
    let end = result.unwrap(disk_end(d, id, 7))
    if end != Some(if mode == 3 {
        114u64
    } else {
        72 + expected_frames * 42
    }) {
        return false
    }
    let all = result.unwrap(journal_recover(d, id, 7, true, journal_initial()))
    if mode == 3 {
        all.seq == 8 && all.end == 156 && all.replay.state.tips[0].head == 3
    } else {
        all.seq == 7 && all.end == 72 + expected_frames * 42 && all.replay.state.tips[0].head == expected_frames
    }
}

// L3/L10/L21: close drains every queued frame. Byte and frame bounds give
// different groupings but the same commit prefix; Rotate preserves that order.
pub fn journal_law_worker(d: Dir, tasks: Tasks) -> bool waits {
    for mode in 0u64 .. 5 {
        if !journal_worker_case(disk_test_directory(d), tasks, mode) {
            return false
        }
    }
    true
}

@test
fn journal_test_worker(d: Dir, tasks: Tasks) -> Result[(), ()] waits {
    if journal_law_worker(d, tasks) {
        Ok(())
    } else {
        Error(())
    }
}

// L18c/L21a: commits without an explicit cut survive close and reopen, and
// close releases LOCK. A subsequent cut retires their live journal segment.
pub fn journal_law_db(d: Dir, c: Clock, r: Random, tasks: Tasks) -> bool waits {
    let mut options = result.unwrap(sized(Directory, 2147483648u64))
    options.resident_limit = 1048576
    options.pack_bytes = 512
    let mut db = result.unwrap(open(tasks, d, c, r, options))
    result.unwrap(create_table(mut db, spec("rows", std.codec.key_u64(), std.codec.of_u64())))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let sh = view t
    let before = db.file_seq
    let saved = result.unwrap(run(mut db, None, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, t, 7, 70)
    }))
    let ci = match take saved {
        Committed(done) => {
            result.unwrap(durable(mut db, done.ticket))
            done.info
        },
        _ => return false
    }
    if disk_state(db).journaled != 1 || disk_state(db).inflight != 0 {
        return false
    }
    if !typed_put(mut db, t, 8, 80) {
        return false
    }
    if db.file_seq != before {
        return false
    }
    result.unwrap(close(take db))
    let mut reopened = result.unwrap(open(tasks, d, c, r, options))
    if reopened.heads[0].head != ci.id.version + 1 || reopened.heads[0].at < ci.at {
        return false
    }
    if result.unwrap(get(snapshot(reopened), sh, 7)) != Some(70u64) || result.unwrap(get(snapshot(reopened), sh, 8)) != Some(80u64) {
        return false
    }
    let path = result.unwrap(disk_path("j-", before, ""))
    if !result.unwrap(disk_exists(d, path)) {
        return false
    }
    let cut = result.unwrap(checkpoint(mut reopened))
    result.unwrap(durable(mut reopened, cut))
    if result.unwrap(disk_exists(d, path)) {
        return false
    }
    result.unwrap(close(take reopened))
    let final_db = result.unwrap(open(tasks, d, c, r, options))
    if result.unwrap(get(snapshot(final_db), sh, 7)) != Some(70u64) || result.unwrap(get(snapshot(final_db), sh, 8)) != Some(80u64) {
        return false
    }
    result.unwrap(close(take final_db))
    true
}


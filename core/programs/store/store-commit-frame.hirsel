fn encode_staged(ci: CallInfo, base: Option[View[pages.PageTree]], prior_stamp: Option[u64], tiered: Option[View[List[Option[format.TieredDataDelta]]]], mut ops: pages.DataRows, order: format.DataOrder, tail: u64, streams: pages.DataRows, call: Option[format.CallSection], rec: Option[CallRecord], settlement: Option[format.Settlement], keyed: Option[format.KeyedDraft], seq: u64, offset: u64, frame_limit: u64) -> Result[Bytes, Capacity] {
    if let Some(record) = rec {
        return pager.encode_frame(store_key_to_rep(ci.id.store), ci.id.branch, ci.id.version, ci.at, base, prior_stamp, tiered, mut ops, order, tail, streams, Some(format.CallView(key: view record.key, args: view record.args, issuer: record.stream.caller.issuer, subject: view record.stream.caller.subject, t: record.stream.id.t, n: record.stream.id.n, revision: view record.revision, code: view record.code)), settlement, keyed, seq, offset, frame_limit)
    }
    match call {
        Some(section) => pager.encode_frame(store_key_to_rep(ci.id.store), ci.id.branch, ci.id.version, ci.at, base, prior_stamp, tiered, mut ops, order, tail, streams, Some(format.CallView(key: view section.record.key, args: view section.record.args, issuer: section.record.stream.caller.issuer, subject: view section.record.stream.caller.subject, t: section.record.stream.id.t, n: section.record.stream.id.n, revision: view section.record.revision, code: view section.record.code)), section.settlement, keyed, seq, offset, frame_limit),
        None => pager.encode_frame(store_key_to_rep(ci.id.store), ci.id.branch, ci.id.version, ci.at, base, prior_stamp, tiered, mut ops, order, tail, streams, None, None, keyed, seq, offset, frame_limit),
    }
}

fn l62_write_count_page(d: Dir, owner: StoreId, seq: u64, collection: u32, page: Arc[std.page.Page], mut packs: std.omap.OMap[u64, TieredPagerPack], mut ids: u64) -> Result[std.page.PagePtr, Error] waits {
    let mut draft = begin_tiered_pack(owner, seq, 3, 4096)?
    let image = std.page.image_of(page)
    let frame = PackFrame(stamp: std.page.stamp(image), size: std.page.sealed_size(image), body: PageBody(arc.share(page)))
    let Some(ptr) = add_tiered_pack_frame(mut draft, frame, collection, tiered_page_index_key(collection, image)?, scoped fn(stamp: u64) -> std.page.PagePtr {
        fail("L62: count fixture's child locations are already Cold")
    })? else {
        fail("L62: a first data frame must fit")
    }
    let (take raw, inventory) = finish_tiered_pack(take draft)?
    disk_write_synced(d, paged_pack_path(seq)?, raw)?
    let (take stored, _) = std.omap.insert(mut ids, packs, seq, TieredPagerPack(inventory: inventory, object: None))
    packs = take stored
    Ok(ptr)
}

fn l62_prepare_count_snapshot(mut db: Db, d: Dir, collection: u32) -> Result[(), Error] waits {
    let mut ids = 0u64
    let mut packs: std.omap.OMap[u64, TieredPagerPack] = std.omap.new()
    let left = l62_write_count_page(d, db.store, 8, collection, l63_edit_leaf(1, 1, (6u64, 6u64), 40)?, mut packs, mut ids)?
    let right = l62_write_count_page(d, db.store, 9, collection, l63_edit_leaf(3, 1, (6u64, 6u64), 41)?, mut packs, mut ids)?
    let mut branches: List[std.page.Entry] = list.with_capacity(2)
    list.push(mut branches, std.page.Entry(key: list.new(), cell: Child(std.page.Branch(child: left, rows: 1, charge: 86))))
    list.push(mut branches, std.page.Entry(key: key_word(3), cell: Child(std.page.Branch(child: right, rows: 1, charge: 86))))
    let image = page_result(std.page.encode(branches, 1, 42, Collection))?
    let branch_page = page_result(std.page.attach_cold(take image))?
    let ptr = l62_write_count_page(d, db.store, 10, collection, branch_page, mut packs, mut ids)?
    let mut row = collection_header(42, 2, 172, 1, ResidentTiered)?
    list.copy_from_slice(mut row, 0, std.page.encode_ptr(ptr))
    let id = prefix(collection)?
    let mut descriptors: List[std.page.Entry] = list.with_capacity(1)
    list.push(mut descriptors, std.page.Entry(key: take id, cell: InlineValue(take row)))
    let map_stamp = stamp_after(order.max(db.next_node, 100))?
    let map_image = page_result(std.page.encode(descriptors, 0, map_stamp, CollectionMap))?
    let mut children: List[std.page.Slot] = list.with_capacity(1)
    list.push(mut children, ColdPage(ptr))
    let mut roots = share_page_tree(db.heads[0u64].roots.collections)
    roots.root = page_result(std.page.attach(take map_image, take children, list.new()))?
    roots.paging = Some(arc.new(TieredReadInventory(packs: take packs, generation: 1, next_stamp: 1u64 << 62)))
    let mut draw = stamp_after(map_stamp)?
    let mut account = ReplayTieredAccount(total: 172, exact: true)
    let inserted = JournalOp(key: log_key(collection, 2)?, value: Some(string.into_bytes(string.from("insert"))), prior: 0, trim: None)
    replay_tiered_op("j-1", mut roots, mut draw, mut account, ReplayDescriptor(rows: 2, row_bytes: 172, seq_bounds: None), inserted)?
    let deleted = JournalOp(key: log_key(collection, 3)?, value: None, prior: 7, trim: None)
    replay_tiered_op("j-1", mut roots, mut draw, mut account, ReplayDescriptor(rows: 3, row_bytes: 258, seq_bounds: None), deleted)?
    db.heads[0u64].roots.collections = take roots
    db.next_node = draw - 1
    Ok(())
}

fn l62_snapshot_counts(db: Db, rows_handle: Table[u64, u32]) -> Result[(), Error] waits {
    let read_handle = reader(db, VALUE_LIMIT + 1048576)?
    let s = snapshot(db)
    if count_at(read_handle, s, rows_handle, Included(2u64), Excluded(3u64))? != 1 || count_at(read_handle, s, rows_handle, Included(3u64), Excluded(4u64))? != 0 || count_at(read_handle, s, rows_handle, Included(2u64), Unbounded)? != 1 || count_at(read_handle, s, rows_handle, Unbounded, Included(1u64))? != 1 || count_at(read_handle, s, rows_handle, Unbounded, Unbounded)? != 2 {
        fail("L62: rank must include the replayed insertion and mask the deleted row")
    }
    Ok(())
}

@test
fn test_l62_tiered_count_uses_overlay_and_interior(d: Dir, c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    let fixtures = disk_test_directory(d)
    let mut db = test_db(c, 2147483648)
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let rows_handle = table(mut db, "rows", std.codec.key_u64(), std.codec.of_u32())?
    let table_id = rows_handle.id
    l62_prepare_count_snapshot(mut db, fixtures, table_id)?
    let funding = TieredPagerFunding(cache_bytes: 32 * 1048576, writer_pin_bytes: 0, pager_task_bytes: 1048576, cut_pins: false)
    let (take requests, take worker) = start_tiered_pager(tasks, db.store, open_number(db), PagerDirectory(fixtures), funding, 4)?
    db.pager = Some(take requests)
    let answer = l62_snapshot_counts(db, rows_handle)
    db.pager = None
    let _ = result.unwrap(task.join(take worker))
    answer
}

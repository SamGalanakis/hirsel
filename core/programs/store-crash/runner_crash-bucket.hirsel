// Native bucket T1 (RUNNER-SPEC v2.50, STORE-SPEC v2.65 §12.2): one executable, so the
// holder and the successor carry the same code revision and differ only by allowance.
// `--sim` serves the loopback simulator bucket and prints its port. `--hold` runs the
// place in-process and reports its activation and allowance, then on `fence` commits
// one bump and must be deposed, or on `stop` commits one bump and drains. Any other launch is
// the place itself. `--bucket=<endpoint>` names the loopback endpoint.
const BUCKET_ACCESS: String = "AKIAHIRSELBUCKETT1"

fn bucket_endpoint(argv: Args) -> String {
    for i in 0u64 .. args.len(argv) {
        let name = option.unwrap(args.get(argv, i))
        if let Some(value) = std.string.strip_prefix(name, "--bucket=") {
            return string.from(value)
        }
    }
    fail("bucket T1: missing --bucket=<endpoint>")
}

fn has_flag(argv: Args, flag: String) -> bool {
    for i in 0u64 .. args.len(argv) {
        if option.unwrap(args.get(argv, i)) == flag {
            return true
        }
    }
    false
}

fn bucket_counter(tx: store.Tx, h: Hd, take _arg: ()) -> Result[runner.Answer[u64], Capacity] {
    let total = result.unwrap(counted(tx, h))
    Ok(runner.Answer(value: total, covers: runner.covers()))
}

fn bucket_place(mut r: Calls) -> Result[(), runner.RegisterError] {
    place(mut r)?
    runner.query(mut r, code.describe(bucket_counter), runner.slots(), 65536u64, runner.DEFAULT_STEPS)
}

fn bucket_config(argv: Args, key: Secret, c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[runner.PlaceConfig[(), Hd, (), ()], Exit] {
    let spot = std.object.Bucket(endpoint: bucket_endpoint(argv), aws_region: "us-east-1", bucket: "bucket-t1", prefix: "", style: Path)
    let credentials = std.cred.from_secret(string.from(BUCKET_ACCESS), secret.share(key), "")
    let backing = runner.BucketBacking(net: n, place: take spot, credentials: take credentials, lanes: std.object.LaneConfig(requested_lanes: 1u64, lane_bytes: 1048576u64), level: "bucket", op_ms: 30000u64)
    let mut wire = runner.wire_defaults(65536u64)
    wire.n_pool = 4194304u64
    let selection = runner.launch_selection(argv)?
    let groups = if has_flag(argv, "--release-check") { Some(1u32) } else { None }
    Ok(runner.PlaceConfig(
        backing: Bucket(take backing), sizes: store.Overrides(resident_limit: None, journal_limit: None, checkpoint_bytes: None, pack_bytes: None, group_bytes: Some(65536u64), group_commits: groups, lock_wait_ms: None,
            cache_bytes: None, writer_pin_bytes: None, dirty_bytes: None, pager_task_bytes: None, readers: None), selection: selection, place: code.describe(bucket_place), n_place: 524288u64,
        on_migrate: Some(code.describe(migrate)), schema: code.describe(schema), session: wire, max_sessions: 4u64,
        proxies: list.new(), n_publisher: 3145728u64,
        listen: Addr(ip: V4(0x7f000001u32), port: 0u16), net: n, tasks: tasks, clock: c, random: r,
        stop: runner.Stop(lag_ms: 0u64, grace_ms: 1000u64), wire: Some(runner.ingress.binding()), triggers: None, idle: None))
}

fn say(out: Stdout, take line: String) waits {
    let mut text = take line
    string.push(mut text, "\n")
    result.unwrap(stdout.write(out, text))
}

fn bucket_sim(key: Secret, c: Clock, n: Net, out: Stdout) -> Result[(), Exit] waits {
    let (take listener, at) = result.unwrap(host.listen(n, Addr(ip: V4(0x7f000001u32), port: 0u16), 64u16))
    let mut line = string.from("PORT ")
    string.push_u64(mut line, int.widen(at.port))
    say(out, take line)
    let mut serving = take listener
    let service = std.sim.s3.Loopback(bucket: "bucket-t1", access_key: string.from(BUCKET_ACCESS), aws_region: "us-east-1", root: secret.share(key), exists_status: 412u16, max_body: 16777216u64)
    let _ = std.sim.s3.serve_loopback(mut serving, take service, c)
    Error(Exit(status: 1u8))
}

fn live_counter(cn: runner.wire_client.Conn, out: Stdout) -> u64 waits {
    runner.wire_client.send_frame(cn, Subscribe(1u32, 1u32, list.new(), None))
    let Ok(Batch(_, complete, groups, outcomes)) = runner.wire_client.next(cn) else { fail("L61: missing initial Batch") }
    want(list.len(complete) == 1u64 && complete[0u64] == 1u32 && list.len(outcomes) == 0u64, "L61: initial completion")
    want(list.len(groups) == 1u64 && groups[0u64].sub == 1u32 && list.len(groups[0u64].rows) == 0u64, "L61: initial value-only group")
    let number = result.unwrap(std.codec.decode(std.codec.of_u64(), groups[0u64].value))
    say(out, "SUBSCRIBED")
    number
}

// One bump at stream 0 position p. If subscribed, observe both the group and outcome.
fn bump_once(cn: runner.wire_client.Conn, p: u64, observed: Option[(Stdout, u64)]) -> Option[(bool, u64)] waits {
    runner.wire_client.send_frame(cn, Call(0u32, p, 0u32, 30000u32, u64_bytes(p)))
    let mut published: Option[u64] = None
    let mut replied: Option[(bool, u64)] = None
    loop {
        match runner.wire_client.next(cn) {
            Ok(Batch(at, complete, groups, done)) => {
                if let Some((out, expected_count)) = observed {
                    if list.len(groups) != 0u64 {
                        want(published == None && list.len(complete) == 0u64 && list.len(groups) == 1u64,
                            "L61: expected one delta group")
                        let group = view groups[0u64]
                        want(group.sub == 1u32 && list.len(group.rows) == 0u64 && group.value == u64_bytes(expected_count),
                            "L61: counter group bytes")
                        published = Some(at)
                        let mut line = string.from("GROUP ")
                        string.push_u64(mut line, at)
                        say(out, take line)
                    }
                }
                for item in done {
                    if item.p == p {
                        replied = Some((same(item.outcome, returned(Ok(p))), at))
                    }
                }
            },
            Ok(Reset(..)) => fail("L61: subscription reset"),
            Ok(_) => (),
            Error(_) => return None,
        }
        if let Some((ok, at)) = replied {
            if let None = observed { return Some((ok, at)) }
            if published == Some(at) { return Some((ok, at)) }
        }
    }
}

fn say_ended(out: Stdout, take running: Task[Result[runner.Ended, runner.StartError]]) waits {
    let mut line = string.from("ENDED ")
    match task.join(take running) {
        Ok(Error(take problem)) => string.push(mut line, runner.start_text(take problem)),
        _ => string.push(mut line, "without an error"),
    }
    say(out, take line)
}

fn bucket_hold(argv: Args, key: Secret, c: Clock, r: Random, tasks: Tasks, n: Net, input: Stdin, out: Stdout) -> Result[(), Exit] waits {
    let config = bucket_config(argv, key, c, r, tasks, n)?
    let (stop, stopping): (Sender[()], Receiver[()]) = channel.new(1u64)
    let (watch, watching): (Sender[Receiver[runner.Phase]], Receiver[Receiver[runner.Phase]]) = channel.new(1u64)
    let status = result.unwrap(runner.status_root())
    let lanes = {
        let Bucket(backing) = view config.backing else { fail("bucket T1: expected Bucket backing") }
        backing.lanes
    }
    // Size the Store at 81 MiB, then add Runner's 1 MiB keep and a
    // fixture MiB outside the head.
    let plan = result.unwrap(store.planned(Bucket(lanes), 81 * 1048576u64, config.sizes))
    let allowance = result.unwrap(runner.operate_bytes(config)) + 2 * 1048576u64 + store.planned_bytes(plan)
    let fixture = DeadlinePlace(config: take config, stop: take stopping, status: latest.handle(status), watch: take watch)
    let running = task.spawn(tasks, bytes allowance, take fixture, deadline_place)
    let Ok(phases) = channel.receive(watching) else {
        say_ended(out, take running)
        return Error(Exit(status: 1u8))
    }
    loop {
        match channel.receive(phases) {
            Ok(Ready) => break,
            Ok(Starting(_)) => (),
            _ => {
                say_ended(out, take running)
                return Error(Exit(status: 1u8))
            },
        }
    }
    let seen = latest.read(status)
    let mut line = string.from("READY ")
    string.push_u64(mut line, seen.activation)
    string.push_char(mut line, ' ')
    string.push_u64(mut line, seen.n_place)
    say(out, take line)
    if has_flag(argv, "--idle-fence") {
        say_ended(out, take running)
        return Ok(())
    }
    let mut keys: List[Bytes] = list.new()
    list.push(mut keys, body_key(0u64))
    let release_check = has_flag(argv, "--release-check")
    if release_check {
        let counter = runner.client.query_entry(code.describe(bucket_counter), runner.slots())
        list.push(mut keys, runner.client.entry_key(counter))
    }
    let cn = result.unwrap(runner.wire_client.connect(tasks, n, option.unwrap(seen.addr), c, r, keys, Some(runner.ingress.credential(r)), std.wsock.defaults()))
    let observed = if release_check { Some((out, live_counter(cn, out) + 1u64)) } else { None }
    let mut command: Bytes = list.with_capacity(16u64)
    while list.len(command) == 0 || command[list.len(command) - 1] != b'\n' {
        want(result.unwrap(stdin.read(input, mut command, Never)) != 0, "bucket T1: no command")
    }
    if list.slice(command, 0, 5) == string.as_bytes("fence") {
        // A deposed holder never answers a commit: its group fails on the claim.
        if let Some((true, _)) = bump_once(cn, 0u64, observed) { fail("bucket T1: the deposed holder committed") }
        let _ = runner.wire_client.close(take cn)
        say_ended(out, take running)
        return Ok(())
    }
    let Some((true, released)) = bump_once(cn, 0u64, observed) else {
        if release_check {
            let _ = runner.wire_client.close(take cn)
            say_ended(out, take running)
            return Ok(())
        }
        fail("bucket T1: the serving place did not commit")
    }
    if release_check {
        let mut publication = string.from("BUMPED ")
        string.push_u64(mut publication, released)
        say(out, take publication)
        // The host law crashes this process after the client saw a release.
        // Keep the live place open until that cut.
        list.clear(mut command)
        let _ = stdin.read(input, mut command, Never)
    } else {
        say(out, "BUMPED")
    }
    let _ = runner.wire_client.close(take cn)
    result.unwrap(channel.send(stop, ()))
    want(match task.join(take running) { Ok(Ok(Stopped(_))) => true, _ => false }, "bucket T1: the place did not stop")
    say(out, "STOPPED")
    Ok(())
}

fn bucket_follow(argv: Args, key: Secret, c: Clock, r: Random, tasks: Tasks, n: Net, out: Stdout) waits {
    let bucket = std.object.Bucket(endpoint: bucket_endpoint(argv), aws_region: "us-east-1", bucket: "bucket-t1", prefix: "", style: Path)
    let credential = std.cred.from_secret(string.from(BUCKET_ACCESS), secret.share(key), "")
    let lanes = std.object.LaneConfig(requested_lanes: 1u64, lane_bytes: 1048576u64)
    let due = std.clock.deadline_after_ms(host.mono_ns(c), 30000u64)
    let connected = result.unwrap(std.object.start(n, tasks, take bucket, take credential, None, System, c, r, lanes, due))
    // Leave half the fixture limit for the client and the native harness.
    let sizing = result.unwrap(store.sized(Bucket(lanes), runtime.root_limit() / 2))
    let plan = result.unwrap(store.follower_plan(Bucket(lanes), sizing))
    let mut plans: List[store.FollowerPlan] = list.with_capacity(1)
    list.push(mut plans, clone(plan))
    let service = result.unwrap(store.follower_service(tasks, option.unwrap(store.service_bytes(plans))))
    let owner = result.unwrap(store.follower_owner(service))
    let slot = result.unwrap(store.follower_slot(owner, plan))
    let mut ids = store.followers()
    let mut mirror = result.unwrap(store.follower(mut ids, take slot, store.object_authority(take connected, "bucket", 30000u64), c, sizing.expect))
    let image = result.unwrap(store.fresh(mut mirror, due))
    let mut declaration = store.declare_follower(mirror)
    let handle = result.unwrap(schema(mut declaration))
    result.unwrap(store.seal_follower(mirror, take declaration))
    let rows = result.unwrap(store.follower_reader(mirror, 0u64))
    let accumulated = match result.unwrap(store.get(rows, image, handle.t, 0u64)) { Some(value) => value, None => 0u64 }
    let mut line = string.from("FOLLOW ")
    string.push_u64(mut line, store.version(image))
    string.push_char(mut line, ' ')
    string.push_u64(mut line, accumulated)
    let _ = take mirror
    let _ = take owner
    result.unwrap(store.close_follower_service(take service))
    say(out, take line)
}

pub fn bucket_main(c: Clock, r: Random, tasks: Tasks, argv: Args, n: Net, process: Process, errors: Stderr, input: Stdin, out: Stdout, key: Secret) -> Result[(), Exit] waits {
    if has_flag(argv, "--sim") {
        return bucket_sim(key, c, n, out)
    }
    if has_flag(argv, "--follow") {
        bucket_follow(argv, key, c, r, tasks, n, out)
        return Ok(())
    }
    if has_flag(argv, "--hold") {
        return bucket_hold(argv, key, c, r, tasks, n, input, out)
    }
    let serve = scoped fn(take stopping: Receiver[()]) -> Result[runner.Ended, runner.MainError] waits {
        let config = bucket_config(argv, key, c, r, tasks, n) ?=> Usage
        let ended = runner.operate_report(take config, take stopping, result.unwrap(runner.status_root()), None, errors) ?=> Start
        Ok(ended)
    }
    runner.main(argv, process, errors, tasks, c, code.describe(bucket_place), code.describe(schema), serve)
}

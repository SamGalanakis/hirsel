fn encode_staged(ci: CallInfo, base: Option[View[PageTree]], tiered: Option[View[List[Option[TieredDataDelta]]]], mut ops: DataRows, tail: u64, streams: DataRows, call: Option[CallSection], rec: Option[CallRecord], settlement: Option[Settlement], keyed: Option[KeyedDraft], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    if let Some(record) = rec {
        return encode_frame(ci, base, tiered, mut ops, tail, streams, Some(view record), settlement, keyed, seq, offset)
    }
    match call {
        Some(section) => encode_frame(ci, base, tiered, mut ops, tail, streams, Some(view section.record), section.settlement, keyed, seq, offset),
        None => encode_frame(ci, base, tiered, mut ops, tail, streams, None, None, keyed, seq, offset),
    }
}

fn encode_frame(ci: CallInfo, base: Option[View[PageTree]], tiered: Option[View[List[Option[TieredDataDelta]]]], mut ops: DataRows, tail: u64, streams: DataRows, call: Option[View[CallRecord]], settlement: Option[Settlement], keyed: Option[KeyedDraft], seq: u64, offset: u64) -> Result[Bytes, Capacity] {
    let keyed_size = match keyed { Some(draft) => keyed_frame_bytes(draft.edits), None => 0u64 }
    let data = ops.count != 0 || (streams.count == 0 && keyed_size == 0)
    let control = stream_control_slot(streams)
    let control_count = if let Some(_) = control { 1u64 } else { 0u64 }
    let stream_count = streams.count - control_count
    let sections = (if data {
        1u64
    } else {
        0u64
    }) + (if stream_count != 0u64 {
        1u64
    } else {
        0u64
    }) + control_count
    let keyed_sections = if keyed_size == 0 { 0u64 } else { 1u64 }
    let mut size = 21 + 5 * sections + keyed_size
    for slot in 0u64 .. ops.count {
        let operation = data_row(ops, slot)
        size += data_op_size(operation, false)
    }
    for slot in 0u64 .. streams.count {
        let operation = data_row(streams, slot)
        size += data_op_size(operation, true)
        if let (Some(_), Some(record)) = (view operation.value, view call) {
            if stream_record_matches(operation.key, record.stream) {
                size += call_section_bytes(record, settlement)
            }
        }
    }
    let order = data_order(ops)?
    let room = 16 + size + BINDING_BYTES
    let mut out: Bytes = if tail == 0 {
        bytebuf.from_tail(mut ops.first[0].key, room)
    } else if tail == 1 {
        bytebuf.from_tail(mut ops.first[1].key, room)
    } else if tail < OPEN_FRAME_TAIL {
        bytebuf.from_tail(mut ops.rest[tail - 2].key, room)
    } else {
        list.with_capacity(room)
    }
    le(mut out, 0x0011, 2)?
    le(mut out, 1, 2)?
    le(mut out, size, 4)?
    le(mut out, 0, 8)?
    le(mut out, int.widen(ci.id.branch), 4)?
    le(mut out, ci.id.version, 8)?
    le(mut out, ci.at, 8)?
    le(mut out, sections + keyed_sections, 1)?
    if data {
        encode_data_ops(mut out, base, tiered, ops, order)?
    }
    if stream_count != 0u64 {
        encode_stream_ops(mut out, streams, stream_count, call, settlement)?
    }
    if let Some(slot) = control {
        le(mut out, 2u64, 1u64)?
        le(mut out, 1u64, 4u64)?
        let operation = data_row(streams, slot)
        encode_data_op(mut out, operation.key, operation.value, None)?
    }
    if let Some(draft) = keyed { encode_keyed_edits(mut out, draft.edits)? }
    seal_frame(mut out, DiskContext(store: ci.id.store, role: 2, seq: seq), offset)?
    Ok(take out)
}

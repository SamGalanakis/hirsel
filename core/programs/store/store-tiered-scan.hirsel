type TieredScanLeaf {
    key: Bytes,
    page: Arc[std.page.Page],
    slot: u64
}

fn tiered_scan_edge(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], edge: std.page.Slot, expected: Option[u8], low: Bytes, high: Option[View[Bytes]], reverse: bool) -> Result[Option[TieredScanLeaf], Error] {
    let page = tiered_point_page(attempt, visible, edge, expected)?
    let image = std.page.image_of(page)
    let n = std.page.count(image)
    if n == 0 {
        return Ok(None)
    }
    let height = std.page.level(image)
    let stop = if let Some(upper) = high {
        let (slot, _) = std.page.search(image, upper)
        slot
    } else {
        n
    }
    if height == 0 {
        let (start, _) = std.page.search(image, low)
        if stop <= start {
            return Ok(None)
        }
        let selected = if reverse {
            stop - 1
        } else {
            start
        }
        let key = option.unwrap(std.page.key_at(image, selected))
        return Ok(Some(TieredScanLeaf(key: take key, page: arc.share(page), slot: selected)))
    }
    let start = option.unwrap(std.page.descend(image, low))
    for offset in 0u64 .. int.saturating_sub(stop, start) {
        let selected = if reverse {
            stop - 1 - offset
        } else {
            start + offset
        }
        let child = option.unwrap(std.page.child_slot(page, selected))
        let walked = tiered_scan_edge(attempt, visible, child, Some(height - 1), low, high, reverse)
        tiered_scan_siblings(attempt, page, child, selected, reverse)
        let answer = (take walked)?
        if let Some(take row) = take answer {
            return Ok(Some(take row))
        }
    }
    Ok(None)
}

// Siblings are hints computed after the latch. A list that cannot be
// reserved is dropped and never replaces the latched miss.
fn tiered_scan_siblings(attempt: core.Cell[TieredTouchSet], page: Arc[std.page.Page], edge: std.page.Slot, selected: u64, reverse: bool) {
    let Some((missing, window)) = tiered_missed_page(attempt) else {
        return
    }
    let ColdPage(wanted) = view edge else {
        return
    }
    if missing != wanted || window == 0 {
        return
    }
    let n = std.page.count(std.page.image_of(page))
    let remaining = if reverse {
        selected
    } else {
        n - selected - 1
    }
    let limit = order.min(window, remaining)
    let mut found: List[format.TieredTarget] = list.new()
    if let Error(_) = list.try_reserve(mut found, limit) {
        return
    }
    for distance in 1u64 .. limit + 1 {
        let slot = if reverse {
            selected - distance
        } else {
            selected + distance
        }
        if let Some(ColdPage(ptr)) = std.page.child_slot(page, slot) {
            list.push(mut found, TieredPage(ptr))
        }
    }
    tiered_set_siblings(attempt, take found)
}

fn tiered_scan_overlay(edits: Arc[ReplayOverlay], low: Bytes, high: Bytes, reverse: bool) -> Option[(Bytes, Arc[Bytes])] {
    let mut cursor = if reverse {
        std.omap.range_reverse(edits.entries, Included(clone(low)), Excluded(clone(high)))
    } else {
        std.omap.range(edits.entries, Included(clone(low)), Excluded(clone(high)))
    }
    while let Some((key, row)) = std.omap.next(mut cursor) {
        if let ReplayPut(stored) = view row.now {
            return Some((clone(key), arc.share(stored)))
        }
    }
    None
}

// The closest overlay put caps the Cold search. A Cold key present in the
// overlay is masked before its value is touched.
fn tiered_scan_row(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], edge: std.page.Slot, collection: u32, overlay: Option[View[Arc[ReplayOverlay]]], low: Bytes, high: Bytes, reverse: bool) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    let staged = if let Some(edits) = overlay {
        tiered_scan_overlay(edits, low, high, reverse)
    } else {
        None
    }
    let (take capped_low, take capped_high) = match staged {
        Some((key, _)) => if reverse {
            let mut after = failure_result_from_rep(types.copied(key))?
            list.push(mut after, 0u8)
            (take after, failure_result_from_rep(types.copied(high))?)
        } else {
            (failure_result_from_rep(types.copied(low))?, failure_result_from_rep(types.copied(key))?)
        },
        None => (failure_result_from_rep(types.copied(low))?, failure_result_from_rep(types.copied(high))?),
    }
    let mut start = take capped_low
    let mut stop = take capped_high
    while start < stop {
        let found = {
            let cold_low = list.slice(start, 4, list.len(start))
            let stop_collection: Option[u32] = if list.len(stop) >= 4 {
                Some(list.word_be(stop, 0))
            } else {
                None
            }
            let cold_high = if stop_collection == Some(collection) {
                Some(list.slice(stop, 4, list.len(stop)))
            } else {
                None
            }
            tiered_scan_edge(attempt, visible, edge, None, cold_low, cold_high, reverse)?
        }
        let Some(take row) = take found else {
            break
        }
        let mut logical = logical_key(collection, row.key)?
        if let Some(edits) = overlay {
            if let Some(_) = replay_overlay_at(edits, logical) {
                if reverse {
                    stop = take logical
                } else {
                    list.push(mut logical, 0u8)
                    start = take logical
                }
                continue
            }
        }
        let value = tiered_point_value(attempt, visible, row.page, row.slot)?
        return Ok(Some((take logical, take value)))
    }
    Ok(take staged)
}

fn tiered_snapshot_primary(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], tree: PageTree, edge: std.page.Slot, primary: Bytes, owner: u32) -> Result[Arc[Bytes], Error] {
    if let Some(row) = tiered_replayed_row(tree, primary) {
        let ReplayPut(value) = view row.now else {
            return Error(Stale(owner))
        }
        return Ok(arc.share(value))
    }
    let key = list.slice(primary, 4, list.len(primary))
    tiered_seek(attempt, SeekKey(failure_result_from_rep(types.copied(key))?))
    tiered_reading(attempt, ValuesAt)
    let selected = tiered_point_path(attempt, visible, edge, None, key)?
    tiered_seek(attempt, SeekOperation)
    let Some(take value) = take selected else {
        return Error(Stale(owner))
    }
    Ok(take value)
}

fn tiered_snapshot_row[K, V](attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], tree: PageTree, decoder: RowDecoder[K, V], row_key: Bytes, raw: Bytes, remaining: Option[u64]) -> Result[Option[((K, V), u64)], Error] {
    let (take key, take owner) = decode_row_key(decoder, row_key, raw)?
    let keep = fn(observed: Bytes) -> Result[(), Error] {
        Ok(())
    }
    if let Some(primary) = view owner {
        let Some((edge, descriptor)) = std.page.collection_slot(tree.root, list.slice(primary, 0, 4)) else {
            return Error(Stale(decoder.table))
        }
        if collection_descriptor(descriptor).residency == ResidentMemory {
            let Some(value) = get_page_row(tree, primary) else {
                return Error(Stale(decoder.table))
            }
            return finish_row(decoder, take key, primary, value, remaining, keep)
        }
        let value = tiered_snapshot_primary(attempt, visible, tree, edge, primary, decoder.table)?
        finish_row(decoder, take key, primary, value, remaining, keep)
    } else {
        finish_row(decoder, take key, row_key, raw, remaining, keep)
    }
}

fn tiered_scan_bounds(descriptor: Bytes, collection: u32, take low: Bytes, take high: Bytes) -> Result[(Bytes, Bytes), Error] {
    let mut start = take low
    let mut stop = take high
    if collection_descriptor(descriptor).kind == LogCollection {
        let window = descriptor_bounds(descriptor)
        let first_key = log_key(collection, window.first)?
        let next_key = log_key(collection, window.next)?
        if start < first_key {
            start = take first_key
        }
        if stop > next_key {
            stop = take next_key
        }
    }
    Ok((take start, take stop))
}

fn read_tiered_scan[K, V](source: TieredPageSource, grant: Arc[TieredReaderGrant], root: TieredPinRoot, tree: PageTree, edge: std.page.Slot, descriptor: Bytes, collection: u32, take low: Bytes, take high: Bytes, reverse: bool, decoder: RowDecoder[K, V]) -> Result[Option[(Bytes, (K, V))], Error] waits {
    let (take start, take stop) = tiered_scan_bounds(descriptor, collection, take low, take high)?
    if start >= stop {
        return Ok(None)
    }
    let overlay = match tree.replay {
        Some(replay) => std.omap.get(replay.collections, collection),
        None => None,
    }
    let hint = if reverse {
        view stop
    } else {
        view start
    }
    let direction = if reverse {
        TieredBackward
    } else {
        TieredForward
    }
    retry_tiered_read(source, grant, root, list.slice(hint, 4, list.len(hint)), None, direction, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]]) -> Result[Option[(Bytes, (K, V))], Error] {
        tiered_reading(attempt, if reverse {
            ValuesNone
        } else {
            ValuesFrom
        })
        let Some((take key, take raw)) = tiered_scan_row(attempt, visible, edge, collection, overlay, start, stop, reverse)? else {
            return Ok(None)
        }
        let result = tiered_snapshot_row(attempt, visible, tree, decoder, key, raw, None)?
        let (take selected, _) = option.unwrap(take result)
        Ok(Some((take key, take selected)))
    })
}

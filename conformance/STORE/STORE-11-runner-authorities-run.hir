// rule: STORE-11
// expect: run
// runners: [{"name":"bare","provider":"sim@1","node":"vault","models":"db@1","head":"application@1/bare_head","grants":{"dirs":[]},"definitions":null},{"name":"clerk","provider":"local.threads@1","grants":{"tasks":"tasks.cooperative@1","dirs":[]},"definitions":["application@1/probe"]},{"name":"ledger","provider":"sim@1","node":"bank","models":"db@1","head":"application@1/head","grants":{"dirs":[],"authorities":{"place":{"provider":"authority.memory@1","floor":"memory"}}},"definitions":null},{"name":"teller","provider":"local.threads@1","grants":{"tasks":"tasks.cooperative@1","dirs":[],"authorities":{"cash":{"provider":"authority.memory@1","floor":"memory"}}},"definitions":["application@1/bank","application@1/probe"]}]
// tasks: free
// A runner's callees and a place's head reach exactly the authorities their
// runner grants: a callee opens a store over its grant and commits, a run whose
// runner grants no authority gets NotGranted, and no run reaches another
// runner's authority by name. A head reaches no directory its runner does not grant.
@serializable
type Short = Db(store.TxError)

fn read(tx: store.Tx) -> Result[u64, Short] {
  match store.tx_get(tx, b"balance") {
    Ok(Some(b)) => Ok(int.widen(b[0])),
    Ok(None()) => Ok(0),
    Error(e) => Error(Db(unique e)),
  }
}

fn deposit(mut tx: store.Tx, info: store.CallInfo, amount: u64) -> Result[u64, Short] {
  let n = read(tx)? + amount
  store.tx_put(mut tx, b"balance", bytes.from_list([int.truncate(n)])) ? Db
  Ok(n)
}

fn balance(tx: store.Tx, info: store.CallInfo, a: ()) -> Result[u64, Short] {
  read(tx)
}

// A callee's store over its runner's authority: two commits, then the latest
// commit read back.
fn bank(rt: Io, n: u64) -> Result[u64, String] {
  let Ok(a) = io.authority(rt, "cash") else {
    return Error("cash")
  }
  let at = authority.floor(a)
  let mut s = match store.open(a, store.default_config()) {
    Ok(s) => s,
    Error(_) => return Error("open"),
  }
  let one: Result[u64, store.TxFailure[Short]] = store.transact(mut s, deposit, n)
  let two: Result[u64, store.TxFailure[Short]] = store.transact(mut s, deposit, n)
  if one != Ok(n) || two != Ok(n + n) {
    return Error("transact")
  }
  let Ok(snap) = store.snapshot(a, mut s, at) else {
    return Error("snapshot")
  }
  let seen: Result[u64, store.TxFailure[Short]] = store.query(take snap, balance, ())
  match seen {
    Ok(v) => Ok(v),
    Error(_) => Error("query"),
  }
}

// Whether a callee reaches the named authority.
fn probe(rt: Io, name: String) -> Result[bool, String] {
  match io.authority(rt, name) {
    Ok(_) => Ok(true),
    Error(NotGranted()) => Ok(false),
    Error(_) => Error("authority"),
  }
}

// The ledger's head serves only if it cannot reach the teller's authority, nor
// the root's directory: its runner grants it none.
pub fn head(rt: Io, a: ()) -> Result[(), store.StoreError] {
  match io.authority(rt, "cash") {
    Error(NotGranted()) => (),
    _ => return Error(Corrupt("cash")),
  }
  let root = io.dir(rt, path.of(""))
  match take root {
    Ok(_) => return Error(Corrupt("dir")),
    Error(_) => (),
  }
  let Ok(place) = io.authority(rt, "place") else {
    return Error(Corrupt("place"))
  }
  let Ok(inbox) = io.inbox(rt) else {
    return Error(Corrupt("inbox"))
  }
  let mut s = store.open(place, store.default_config())?
  store.serve(mut s, take inbox, [store.served_transact(deposit)])
}

// The bare place grants no authority: its head ends without serving unless it
// reaches the ledger's by name.
pub fn bare_head(rt: Io, a: ()) -> Result[(), store.StoreError] {
  let place = match io.authority(rt, "place") {
    Ok(p) => p,
    Error(NotGranted()) => return Ok(()),
    Error(_) => return Error(Corrupt("place")),
  }
  let Ok(inbox) = io.inbox(rt) else {
    return Error(Corrupt("inbox"))
  }
  let mut s = store.open(place, store.default_config())?
  store.serve(mut s, take inbox, [store.served_transact(deposit)])
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let teller = io.runner(rt, "teller")?
  failure.check(runner.call(teller, bank, 5u64) == Ok(10u64), Arithmetic())
  failure.check(runner.call(teller, probe, "cash") == Ok(true), Arithmetic())
  failure.check(runner.call(teller, probe, "place") == Ok(false), Arithmetic())
  let clerk = io.runner(rt, "clerk")?
  failure.check(runner.call(clerk, probe, "cash") == Ok(false), Arithmetic())
  failure.check(runner.call(clerk, probe, "place") == Ok(false), Arithmetic())
  let ledger = io.runner(rt, "ledger")?
  failure.check(runner.transact(ledger, deposit, 5u64) == Ok(5u64), Arithmetic())
  let bare = io.runner(rt, "bare")?
  failure.check(
    runner.transact(bare, deposit, 1u64) == Error(NotRun(Unreachable())),
    Arithmetic()
  )
  Ok(())
}

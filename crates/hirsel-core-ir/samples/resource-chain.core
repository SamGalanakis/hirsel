; LANG-19 through resources: a resource whose field owns the next resource
; releases under constant native stack. Chain = End | Link(Box[R]), and the
; resource R { next: Chain } has no finalizer (mechanical cleanup) and no u64
; field, so nothing is traced. Chain is one word, End the null niche. f0(n)
; makes n links: a resource (8 native bytes, charged 48: Chain's logical 16, tag
; word included, plus the 32-byte cell) takes the current root as its next, and a
; box (charged 8, the resource pointer) holds it. Then the root is dropped. Derived by
; hand: every block is freed once and refunded, so the run returns n with
; nothing used and 2n admissions. A refused box drops the resource, and so the
; chain it took.
; run: f0(0) -> 0 | used 0
; run: f0(32) -> 32 | used 0
; run refuse 4: f0(3) -> 1 | used 0
core v1
type t0 = resource "R" { next: t1 }
type t1 = own "Chain" | End { } | Link { b: box t0 }
sig g0 = (u64) -> (u64)
inst n0 = test@0/resource_chain/run [] []
fn f0 = n0 g0 {
  slot s0 = t1
  slot s1 = t0                         ; a resource whose box was refused
  addr a0 = s0 : t1
  addr a1 = s0 case 1 0 : ptr          ; Link.b
  addr a2 = v5 : t0                    ; the new resource's storage
  addr a3 = a2 field 0 : t1            ; its next
  addr a4 = v12 : ptr                  ; the new box's payload
  addr a5 = s1 : ptr
  addr a6 = s1 : t0
b0(v0: u64):
  live s0
  address a0
  address a1
  set_case a0, 0                       ; root = End
  v1: u64 = const 0
  v2: u64 = const 1
  v3: u64 = const 8
  v4: u64 = const 48
  v9: ptr = const 0x0
  v13: u64 = const 8
  jump b1(v1)
b1(v7: u64):
  v8: bool = lt v7, v0
  branch v8, b2, b6
b2:
  v5: ptr, v6: u64 = alloc resource grant 0 v3 align 8 charge v4
  v10: bool = ne v5, v9
  branch v10, b3, b6
b3:
  address a2
  address a3
  copy a3, a0, v3                      ; the root moves into the new resource
  set_case a0, 0
  v12: ptr, v14: u64 = alloc for box t0 v3 align 8 charge v13
  v15: bool = ne v12, v9
  branch v15, b4, b5
b4:
  address a4
  store a4, v5
  set_case a0, 1
  store a1, v12
  v11: u64 = wrapping_add v7, v2
  jump b1(v11)
b5:
  live s1
  address a5
  address a6
  store a5, v5
  drop a6 t0
  dead s1
  jump b6
b6:
  drop a0 t1
  dead s0
  return v7
}

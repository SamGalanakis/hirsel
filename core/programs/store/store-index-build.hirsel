// The same rows on main's head when the table is Tiered: each is read
// through the pager under a reader's pin extractor, as a snapshot scan reads.
fn tiered_rows_after(db: Db, table_id: u32, cursor: Option[Bytes], limit: u64) -> Result[(List[(Bytes, Bytes)], bool), Error] waits {
    tiered_rows_after_mode(db, table_id, cursor, limit, false)
}

fn tiered_rows_after_mode(db: Db, table_id: u32, cursor: Option[Bytes], limit: u64, direct: bool) -> Result[(List[(Bytes, Bytes)], bool), Error] waits {
    let s = snapshot(db)
    if !failure_result_from_rep(transfer.table_is_tiered(s.roots.collections, table_id))? {
        return failure_result_from_rep(maintenance.resident_rows_after(s.roots, table_id, cursor, limit))
    }
    let Some(inventory) = view s.roots.collections.paging else {
        return failure_result_from_rep(maintenance.resident_rows_after(s.roots, table_id, cursor, limit))
    }
    let low = failure_result_from_rep(catalog.prefix(table_id))?
    let high = failure_result_from_rep(catalog.prefix(table_id + 1))?
    let previous: Option[Bytes] = match cursor {
        Some(final_key) => {
            let mut k = failure_result_from_rep(catalog.prefix(table_id))?
            list.append(mut k, final_key)
            Some(take k)
        },
        None => None,
    }
    snapshot_rows_after(db, s, inventory, low, high, take previous, limit, direct)
}

// Up to `limit` rows of [`low`, `high`) after `previous` in `s`, each read
// through the pager (or directly, on a store with no pager task).
fn snapshot_rows_after(db: Db, s: Snapshot, inventory: pages.TieredReadInventory, low: Bytes, high: Bytes, take after: Option[Bytes], limit: u64, direct: bool) -> Result[(List[(Bytes, Bytes)], bool), Error] waits {
    let mut previous = take after
    let direct_dir: Option[Dir] = if direct {
        match view db.disk {
            Some(state) => disk_directory(state),
            None => None,
        }
    } else {
        None
    }
    let mut out: List[(Bytes, Bytes)] = list.new()
    if let Some(d) = direct_dir {
        while list.len(out) <= limit {
            let Some((take key, value, take resume)) = snapshot_tiered_span_step_direct(d, db.store, pager.pin_partition(db.pager), s, inventory, low, high, previous)? else {
                return Ok((take out, true))
            }
            if list.len(out) == limit {
                return Ok((take out, false))
            }
            list.push(mut out, (take key, failure_result_from_rep(types.copied(value))?))
            previous = Some(take resume)
        }
        return Ok((take out, false))
    }
    if direct {
        let has_pager_task = match view db.disk {
            Some(state) => pager.has_worker(state.tiered),
            None => false,
        }
        if !has_pager_task {
            return Error(Io(Closed))
        }
    }
    let r = reader(db, READER_PIN_MIN)?
    while list.len(out) <= limit {
        let Some((take key, value, take resume)) = snapshot_tiered_span_step(r, s, inventory, low, high, previous)? else {
            return Ok((take out, true))
        }
        if list.len(out) == limit {
            return Ok((take out, false))
        }
        list.push(mut out, (take key, failure_result_from_rep(types.copied(value))?))
        previous = Some(take resume)
    }
    Ok((take out, false))
}

// One chunk of the first Backfilling index on main, in one schema commit
// read from and published at main's current head. Returns the index's name,
// or None when no index is building. A Unique key found under two primary
// keys moves the index to Failed instead, and no entry of that chunk commits.
// The chunk reads a Tiered table through the pager, so in-place repair needs
// no Migrate on a Tiered store (STORE-SPEC §13.10).
pub fn index_build_step(mut db: Db, limit: u64) -> Result[Option[String], Error] waits {
    healthy(db)?
    if limit == 0 {
        return Error(Limit(Transaction))
    }
    let Some((take key, take record)) = failure_result_from_rep(maintenance.building_index(pages.holder_heads(db.holders)[0].roots.catalog, db.indexes))? else {
        return Ok(None)
    }
    let name = failure_result_from_rep(catalog.declaration_index_name(key))?
    let tiered = failure_result_from_rep(transfer.table_is_tiered(pages.holder_heads(db.holders)[0].roots.collections, record.id))?
    if tiered && index_build_has_overlay(pages.holder_heads(db.holders)[0].roots.collections, record.id) {
        let _ = cut_install(mut db, NoHolderChange)?
    }
    let cursor = match catalog_index(record)?.state {
        Backfilling(Some(final_key)) => Some(failure_result_from_rep(types.copied(final_key))?),
        _ => None,
    }
    let (take rows, done) = tiered_rows_after(db, record.owner, cursor, limit)?
    let mut plan = schema_plan(db)
    let found = if tiered {
        let chunk = prepare_tiered_index_chunk(mut db, record, rows)?
        match take chunk {
            ChunkDuplicate(take previous, take next_key) => Some((take previous, take next_key)),
            ChunkReady(pager.TieredWritePlan(tree: take tree, next_stamp: following, freed: take freed, ..), take step_ops) => {
                plan.schema.roots.collections = take tree
                plan.schema.next_node = following - 1
                plan.chunk_freed = Some(take freed)
                plan.step_rows = take step_ops
                let mut published = failure_result_from_rep(maintenance.copied_record(record))?
                if done {
                    failure_result_from_rep(indexes.set_index_state(mut published, Public))?
                } else if let Some((logical, _)) = list.last(rows) {
                    let after = failure_result_from_rep(types.copied(list.slice(logical, 4, list.len(logical))))?
                    failure_result_from_rep(indexes.set_index_state(mut published, Backfilling(Some(take after))))?
                }
                failure_result_from_rep(maintenance.put_index_record(mut plan.schema, key, published))?
                None
            },
        }
    } else {
        let Some(extractor) = indexes.bound_extractor(db.indexes, record) else {
            return Error(Stale(record.id))
        }
        failure_result_from_rep(maintenance.index_chunk(mut plan.schema, key, failure_result_from_rep(maintenance.copied_record(record))?, extractor, rows, done, false, true, mut plan.step_rows))?
    }
    if let Some((take first, take second)) = take found {
        let mut failed = failure_result_from_rep(maintenance.copied_record(record))?
        failure_result_from_rep(indexes.set_index_state(mut failed, Failed(take first, take second)))?
        failure_result_from_rep(maintenance.put_index_record(mut plan.schema, key, failed))?
    }
    let _ = publish_schema_plan(mut db, take plan)?
    Ok(Some(take name))
}

// Demotes each index a failed transaction proved wrong, in one schema
// commit on main. A crash before it commits loses nothing: the next write
// to the row fails the same way.
// Each index whose record this commit changes counts one demotion
// (`attention`); one already Backfilling(None) counts none.
fn demote_drifted(mut db: Db, seen: List[(u32, u32)]) -> Result[(), Error] waits {
    let mut plan = schema_plan(db)
    let mut demoted: List[(u32, u32)] = list.new()
    for (owner, id) in seen {
        let name = find_index_name(plan.schema.roots.catalog, owner, id)?
        if failure_result_from_rep(maintenance.demote_index(mut plan.schema, failure_result_from_rep(catalog.catalog_index_key(owner, name))?))? {
            failure_result_from_rep(types.capacity(list.try_reserve(mut demoted, 1)))?
            list.push(mut demoted, (owner, id))
        }
    }
    if plan.schema.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    count_demotions(mut db, demoted)
}

// Starts an in-place rebuild of a declared index: demotes it, and
// `index_build_step` then rebuilds it while every other index serves.
pub fn rebuild_index[J, K, V, P](mut db: Db, ix: Index[J, K, V, P]) -> Result[(), Error] waits {
    healthy(db)?
    if !types.same(db.store.hi, db.store.lo, ix.store.hi, ix.store.lo) {
        return Error(Foreign)
    }
    let mut plan = schema_plan(db)
    let record = catalog_entry_in(plan.schema.roots.catalog, ix.catalog_key)?
    if record.id != ix.id {
        return Error(Stale(ix.id))
    }
    let _ = failure_result_from_rep(maintenance.demote_index(mut plan.schema, ix.catalog_key))?
    if plan.schema.changed {
        let _ = publish_schema_plan(mut db, take plan)?
    }
    Ok(())
}

// A declaration's index build in its plan. A new index (`new_index`) gets its
// record as Backfilling(None) over an empty collection; an existing entry
// index is rebuilt whole, an aggregate resumes from its cursor, and a Failed
// one restarts from an empty index.
fn stage_index_build[K, V](mut plan: SchemaPlan, t: Table[K, V], key: Bytes, name: String, take record: indexes.Catalog, extractor: indexes.RegisteredIndex, new_index: bool, take cause: String) -> Result[(), Error] {
    if !types.same(plan.store.hi, plan.store.lo, t.store.hi, t.store.lo) {
        return Error(Foreign)
    }
    let mut proposed = take record
    let owner_tiered = failure_result_from_rep(transfer.table_is_tiered(plan.schema.roots.collections, t.id))?
    // A hot build draws a Tiered target's two scratch ids with it (§13.10a).
    let hot = !plan.schema.defer_tiered
    let mut scratch = 0u32
    if new_index {
        let mut meta = catalog_entry_in(plan.schema.roots.catalog, t.catalog_key)?
        if meta.id != t.id {
            return Error(Stale(t.id))
        }
        let drawn = if owner_tiered && hot {
            3u32
        } else {
            1u32
        }
        let Some(next_table) = int.checked_add(proposed.id, drawn) else {
            return Error(Limit(Ids))
        }
        scratch = proposed.id + 1u32
        failure_result_from_rep(indexes.set_index_state(mut proposed, Backfilling(None)))?
        let raw = encode_catalog(proposed)?
        let mut live_bytes = int.saturating_add(126, txn.catalog_recharge(plan.schema.live, plan.schema.roots, key, raw, plan.schema.retained))
        meta.epoch += 1
        let changed = encode_catalog(meta)?
        live_bytes = txn.catalog_recharge(live_bytes, plan.schema.roots, t.catalog_key, changed, plan.schema.retained)
        failure_result_from_rep(catalog.over_ceiling(live_bytes, plan.schema.ceiling))?
        let mut roots = pages.share_roots(plan.schema.roots)
        if owner_tiered {
            failure_result_from_rep(maintenance.define_empty_tiered_index(mut roots.collections, proposed.id, mut plan.schema.next_node))?
        } else {
            failure_result_from_rep(catalog.define_store_collection(mut roots.collections, proposed.id, 2, mut plan.schema.next_node))?
        }
        roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, roots, key, raw))?
        roots = failure_result_from_rep(catalog.catalog_insert(mut plan.schema.next_node, roots, t.catalog_key, changed))?
        keep_schema(mut plan, take roots, live_bytes, next_table)?
    } else if let Failed(_, _) = catalog_index(proposed)?.state {
        let _ = failure_result_from_rep(maintenance.demote_index(mut plan.schema, key))?
    }
    let current = catalog_entry_in(plan.schema.roots.catalog, key)?
    let target_tiered = failure_result_from_rep(transfer.table_is_tiered(plan.schema.roots.collections, current.id))?
    if target_tiered && hot && !new_index {
        scratch = plan.schema.next_table
        let Some(next_table) = int.checked_add(scratch, 2u32) else {
            return Error(Limit(Ids))
        }
        plan.schema.next_table = next_table
    }
    if owner_tiered || target_tiered {
        let preview_slot: Option[u64] = if let Some(mut backfills) = plan.preview {
            let slot = list.len(backfills)
            let table_name = failure_result_from_rep(catalog.catalog_collection_name(t.catalog_key, 1u8))?
            list.push(mut backfills, MigrationBackfill(table: take table_name, index: Some(clone(name)), cause: Some(take cause), read: 0, written: 0, outcome: Deferred(maintenance.collection_rows(plan.schema.roots.collections, t.id))))
            Some(slot)
        } else {
            None
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut plan.pending_indexes, 1)))?
        list.push(mut plan.pending_indexes, transfer.DeferredIndexBuild(catalog_key: failure_result_from_rep(types.copied(key))?, name: failure_result_from_rep(catalog.named(name))?, record_raw: encode_catalog(current)?, scratch: scratch, preview_slot: preview_slot))
        plan.step_drift = true
        // A queued build publishes even when it resumes an unchanged record.
        plan.schema.changed = true
        return Ok(())
    }
    let preview = if let Some(_) = plan.preview {
        true
    } else {
        false
    }
    let (take duplicate, read, written) = failure_result_from_rep(maintenance.build_declared_index(mut plan.schema, key, current, extractor, preview))?
    let outcome: BackfillOutcome = match take duplicate {
        Some((take first, take second)) => {
            if !preview {
                return Error(Conflict(failure_result_from_rep(catalog.named(name))?))
            }
            Conflict(ConflictKeys(first: take first, second: take second))
        },
        None => Filled,
    }
    if let Some(mut backfills) = plan.preview {
        let table_name = failure_result_from_rep(catalog.catalog_collection_name(t.catalog_key, 1u8))?
        list.push(mut backfills, MigrationBackfill(table: take table_name, index: Some(clone(name)), cause: Some(take cause), read: read, written: written, outcome: take outcome))
    }
    Ok(())
}

fn index_stop_error(stop: txn.IndexStop) -> Result[Error, Error] {
    match stop {
        Duplicate(name) => Ok(Conflict(failure_result_from_rep(catalog.named(name))?)),
        Drifted(name) => Ok(Drift(failure_result_from_rep(catalog.named(name))?)),
    }
}

fn stage_migrate[K, V, K2, V2](mut plan: SchemaPlan, take from: Table[K, V], to_name: String, to_key: std.codec.Key[K2], to_value: std.codec.Codec[V2], f: fn(K, V) -> Result[Option[(K2, V2)], Capacity]) -> Result[(), Error] {
    if !types.same(plan.store.hi, plan.store.lo, from.store.hi, from.store.lo) {
        return Error(Foreign)
    }
    let meta = catalog_entry_in(plan.schema.roots.catalog, from.catalog_key)?
    if meta.id != from.id {
        return Error(Stale(from.id))
    }
    let target = failure_result_from_rep(catalog.table_key(to_name))?
    if !catalog.same_bytes(target, from.catalog_key) {
        if let Some(_) = pages.get_page_row(plan.schema.roots.catalog, target) {
            return Error(Exists(failure_result_from_rep(catalog.named(to_name))?))
        }
    }
    if meta.next == 65535 {
        return Error(Limit(Value))
    }
    let tiered = failure_result_from_rep(transfer.table_is_tiered(plan.schema.roots.collections, from.id))?
    let source_rows = maintenance.collection_rows(plan.schema.roots.collections, from.id)
    let olds = index_catalog_in(plan.schema.roots.catalog, from.id)?
    let id = plan.schema.next_table
    plan.step_drift = true
    // 3150 F2: the source and its retired indexes supersede their ids. A
    // Tiered source's overlay is discarded once its rows are read.
    failure_result_from_rep(types.capacity(list.try_reserve(mut plan.schema.superseded, 1 + list.len(olds))))?
    list.push(mut plan.schema.superseded, from.id)
    for old in olds {
        list.push(mut plan.schema.superseded, old.id)
    }
    if tiered {
        let mut roots = pages.share_roots(plan.schema.roots)
        let mut ids = plan.schema.next_node
        let schema = std.codec.schema(to_value) ?=> |_| Schema(0)
        let fp = std.codec.fingerprint_of(schema)
        let mut schemas: List[catalog.ValueSchema] = list.new()
        list.push(mut schemas, catalog.ValueSchema(number: meta.next, fingerprint: fp, schema: take schema))
        let table_raw = encode_catalog(indexes.Catalog(record: CatalogTable, id: id, owner: 0, epoch: 1, key: (std.codec.key_schema(to_key) ?=> |_| Schema(0)), schemas: take schemas, next: meta.next + 1, by: list.new(), revision: list.new()))?
        let mut live_bytes = int.saturating_add(plan.schema.live, 126 + txn.entry(target, table_raw))
        failure_result_from_rep(transfer.define_empty_tiered_collection(mut roots.collections, id, 1, mut ids))?
        let mut old_ids: List[u32] = list.with_capacity(list.len(olds))
        for old in olds {
            list.push(mut old_ids, old.id)
        }
        let low = failure_result_from_rep(catalog.index_prefix(from.id))?
        let high = failure_result_from_rep(catalog.index_prefix(from.id + 1))?
        let mut catalog_rows = byte_cursor(roots.catalog, Included(take low), high)?
        while let Some((k, v)) = failure_result_from_rep(catalog.next_bytes(mut catalog_rows))? {
            if !plan.schema.retained {
                live_bytes = int.saturating_sub(live_bytes, txn.entry(k, v))
            }
            failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, k, mut ids))?
        }
        if let Some(raw) = pages.get_page_row(roots.catalog, from.catalog_key) {
            if !plan.schema.retained {
                live_bytes = int.saturating_sub(live_bytes, txn.entry(from.catalog_key, raw))
            }
        }
        failure_result_from_rep(catalog.remove_store_row(mut roots.catalog, from.catalog_key, mut ids))?
        roots = failure_result_from_rep(catalog.catalog_insert(mut ids, roots, target, table_raw))?
        plan.schema.next_node = ids
        // A hot build draws the target's two scratch ids with it (§13.10a).
        let drawn = if plan.schema.defer_tiered {
            1u32
        } else {
            3u32
        }
        let Some(next_table) = int.checked_add(id, drawn) else {
            return Error(Limit(Ids))
        }
        keep_schema(mut plan, take roots, live_bytes, next_table)?
        record_migrate_source(mut plan, from.id, id)?
        let preview_slot: Option[u64] = if let Some(mut backfills) = plan.preview {
            let slot = list.len(backfills)
            list.push(mut backfills, MigrationBackfill(table: failure_result_from_rep(catalog.named(to_name))?, index: None, cause: None, read: 0, written: 0, outcome: Deferred(source_rows)))
            Some(slot)
        } else {
            None
        }
        let from_id = from.id
        let number = meta.next
        let value_limit = plan.schema.value_limit
        let convert_row: own[send] fn(Bytes, Bytes) -> Result[Option[(Bytes, Bytes)], types.Failure] = fn(key_bytes: Bytes, raw_val: Bytes) -> Result[Option[(Bytes, Bytes)], types.Failure] {
            let decoded_key = catalog.decoded(std.codec.decode_key(from.key, key_bytes))?
            let decoded_val = failure_result_to_rep(row_value(from.readers, from_id, raw_val))?
            match types.capacity(f(decoded_key, decoded_val))? {
                Some((k2, v2)) => {
                    let encoded = catalog.encode_key(to_key, k2)?
                    if list.len(encoded) > 4092 {
                        return Error(Limit(Key))
                    }
                    let mut out_val: Bytes = list.new()
                    types.capacity(format.le(mut out_val, int.widen(number), 2))?
                    std.codec.encode(to_value, v2, mut out_val) ?=> |_| Limit(Value)
                    if list.len(out_val) > value_limit {
                        return Error(Limit(Value))
                    }
                    Ok(Some((take encoded, take out_val)))
                },
                None => Ok(None),
            }
        }
        failure_result_from_rep(types.capacity(list.try_reserve(mut plan.pending_migrates, 1)))?
        list.push(mut plan.pending_migrates, transfer.DeferredMigrate(from_id: from_id, to_id: id, to_name: failure_result_from_rep(catalog.named(to_name))?, olds: take old_ids, convert: take convert_row, preview_slot: preview_slot))
        return Ok(())
    }
    let base = pages.share_roots(plan.schema.roots)
    let mut ids = plan.schema.next_node
    let built = migrate_build(plan.schema.roots.collections, take base, mut ids, plan.schema.live, plan.schema.ceiling, plan.schema.retained, from, olds, to_name, to_key, to_value, f, id, meta.next, target, plan.schema.value_limit)
    plan.schema.next_node = ids
    let catalog.Built(roots: take roots, live: live_bytes, read, written) = built?
    keep_schema(mut plan, take roots, live_bytes, id + 1)?
    record_migrate_source(mut plan, from.id, id)?
    if let Some(mut backfills) = plan.preview {
        list.push(mut backfills, MigrationBackfill(table: failure_result_from_rep(catalog.named(to_name))?, index: None, cause: None, read: read, written: written, outcome: Filled))
    }
    Ok(())
}

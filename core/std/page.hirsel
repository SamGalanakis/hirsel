// Store format 3 payloads (STORE-SPEC AP3, AP8, AP13, AP20).
const HEADER: u64 = 24

const TARGET: u64 = 4096

const PAGE_MAX: u64 = 8384

const PRIVATE_MAX: u64 = 16384

const INLINE_MAX: u64 = 1024

const VALUE_MAX: u64 = 16711680

const PTR_BYTES: u64 = 36

const REF_BYTES: u64 = 42

const BRANCH_BYTES: u64 = PTR_BYTES + 16

pub type Domain: key = Collection | CollectionMap | Unprefixed

pub type Error: key = MalformedPage | UnsupportedPage | OutOfOrder | PageLimit | StampLimit

type Edit: key = Changed | Shrunk | Split

pub type PagePtr: key {
    pack: u64,
    offset: u64,
    len: u32,
    checksum: u64,
    stamp: u64
}

pub type BlobRef: key {
    stamp: u64,
    len: u64,
    checksum: u64,
    pack: u64,
    offset: u64,
    body: u16
}

pub type Branch {
    child: PagePtr,
    rows: u64,
    charge: u64
}

pub type Cell: shareable + send = InlineValue(Bytes) | BlobValue(BlobRef) | Child(Branch)

pub type Entry: shareable + send {
    key: Bytes,
    cell: Cell
}

pub type Edge = PageEdge(PagePtr) | BlobEdge(BlobRef)

pub type Blob: shareable + send {
    stamp: u64,
    value: Bytes
}

pub opaque type Image: shareable + send {
    raw: Bytes,
    domain: Domain
}

pub opaque type Page: shareable + send {
    image: Image,
    kids: List[Arc[Page]],
    blobs: List[Arc[Bytes]],
    rows: u64,
    charge: u64
}

pub type Row: shareable + send {
    key: Bytes,
    value: Bytes,
    charge: u64
}

fn u16_at(raw: Bytes, at: u64) -> u64 {
    let n: u16 = list.word_le(raw, at)
    int.widen(n)
}

fn u32_at(raw: Bytes, at: u64) -> u64 {
    let n: u32 = list.word_le(raw, at)
    int.widen(n)
}

fn put16(mut raw: Bytes, at: u64, n: u64) {
    let word: u16 = int.truncate(n)
    list.set_word_le(mut raw, at, word)
}

fn put32(mut raw: Bytes, at: u64, n: u64) {
    let word: u32 = int.truncate(n)
    list.set_word_le(mut raw, at, word)
}

fn fits(at: u64, size: u64, end: u64) -> bool {
    at <= end && size <= end - at
}

pub fn unlocated(id: u64) -> PagePtr {
    PagePtr(pack: 0, offset: 0, len: 0, checksum: 0, stamp: id)
}

fn ptr_at(raw: Bytes, at: u64) -> PagePtr {
    PagePtr(pack: list.word_le(raw, at), offset: list.word_le(raw, at + 8), len: list.word_le(raw, at + 16), checksum: list.word_le(raw, at + 20), stamp: list.word_le(raw, at + 28))
}

fn put_ptr(mut raw: Bytes, at: u64, ptr: PagePtr) {
    list.set_word_le(mut raw, at, ptr.pack)
    list.set_word_le(mut raw, at + 8, ptr.offset)
    list.set_word_le(mut raw, at + 16, ptr.len)
    list.set_word_le(mut raw, at + 20, ptr.checksum)
    list.set_word_le(mut raw, at + 28, ptr.stamp)
}

pub fn encode_ptr(ptr: PagePtr) -> Bytes {
    let mut raw: Bytes = list.with_capacity(PTR_BYTES)
    list.fill(mut raw, PTR_BYTES, 0)
    put_ptr(mut raw, 0, ptr)
    raw
}

pub fn decode_ptr(raw: Bytes) -> Result[PagePtr, Error] {
    if list.len(raw) != PTR_BYTES {
        return Error(MalformedPage)
    }
    let ptr = ptr_at(raw, 0)
    if ptr.stamp == 0 && ptr != unlocated(0) {
        return Error(MalformedPage)
    }
    Ok(ptr)
}

fn ref_at(raw: Bytes, at: u64) -> BlobRef {
    BlobRef(stamp: list.word_le(raw, at), len: list.word_le(raw, at + 8), checksum: list.word_le(raw, at + 16), pack: list.word_le(raw, at + 24), offset: list.word_le(raw, at + 32), body: list.word_le(raw, at + 40))
}

fn put_ref(mut raw: Bytes, at: u64, blob: BlobRef) {
    list.set_word_le(mut raw, at, blob.stamp)
    list.set_word_le(mut raw, at + 8, blob.len)
    list.set_word_le(mut raw, at + 16, blob.checksum)
    list.set_word_le(mut raw, at + 24, blob.pack)
    list.set_word_le(mut raw, at + 32, blob.offset)
    list.set_word_le(mut raw, at + 40, blob.body)
}

fn valid_ref(blob: BlobRef) -> bool {
    blob.stamp != 0 && blob.len > 0 && blob.len <= VALUE_MAX
}

pub fn encode_ref(blob: BlobRef) -> Bytes {
    let mut raw: Bytes = list.with_capacity(REF_BYTES)
    list.fill(mut raw, REF_BYTES, 0)
    put_ref(mut raw, 0, blob)
    raw
}

pub fn decode_ref(raw: Bytes) -> Result[BlobRef, Error] {
    if list.len(raw) != REF_BYTES {
        return Error(MalformedPage)
    }
    let blob = ref_at(raw, 0)
    if !valid_ref(blob) {
        return Error(MalformedPage)
    }
    Ok(blob)
}

pub fn encode_blob(id: u64, value: Bytes) -> Result[Bytes, Error] {
    let n = list.len(value)
    if id == 0 || n == 0 || n > VALUE_MAX {
        return Error(MalformedPage)
    }
    let mut raw: Bytes = list.with_capacity(8 + n)
    list.put_word_le(mut raw, id)
    list.append(mut raw, value)
    Ok(take raw)
}

pub fn decode_blob(take raw: Bytes) -> Result[Blob, Error] {
    let n = list.len(raw)
    if n <= 8 || n > 8 + VALUE_MAX {
        return Error(MalformedPage)
    }
    let id: u64 = list.word_le(raw, 0)
    if id == 0 {
        return Error(MalformedPage)
    }
    list.copy_within(mut raw, 8, 0, n - 8)
    list.truncate(mut raw, n - 8)
    Ok(Blob(stamp: id, value: take raw))
}

pub fn stamp(image: Image) -> u64 {
    list.word_le(image.raw, 8)
}

pub fn level(image: Image) -> u8 {
    image.raw[0u64]
}

pub fn count(image: Image) -> u64 {
    u16_at(image.raw, 2)
}

pub fn key_domain(image: Image) -> Domain {
    image.domain
}

pub fn image_of(page: Arc[Page]) -> View[Image] in page {
    view page.image
}

pub fn payload(image: Image) -> View[Bytes] in image {
    view image.raw
}

pub fn child(page: Arc[Page], slot: u64) -> Option[Arc[Page]] {
    if slot < list.len(page.kids) {
        Some(arc.share(page.kids[slot]))
    } else {
        None
    }
}

pub fn body(page: Arc[Page], at: u16) -> Option[Arc[Bytes]] {
    let i: u64 = int.widen(at)
    if i < list.len(page.blobs) {
        Some(arc.share(page.blobs[i]))
    } else {
        None
    }
}

pub fn copy_with_stamp(page: Arc[Page], id: u64) -> Arc[Page] {
    let mut raw: Bytes = clone(page.image.raw)
    list.set_word_le(mut raw, 8, id)
    arc.new(Page(image: Image(raw: take raw, domain: page.image.domain), kids: clone(page.kids), blobs: clone(page.blobs), rows: page.rows, charge: page.charge))
}

pub fn value_at(page: Arc[Page], slot: u64) -> Option[View[Bytes]] in page {
    if level(page.image) != 0 || slot >= count(page.image) {
        return None
    }
    let at = entry_at(page.image, slot)
    let value = at + 2 + u16_at(page.image.raw, at)
    if page.image.raw[value] == 0 {
        let n = u16_at(page.image.raw, value + 1)
        return Some(list.slice(page.image.raw, value + 3, value + 3 + n))
    }
    let edge = ref_at(page.image.raw, value + 1)
    let index: u64 = int.widen(edge.body)
    Some(view page.blobs[index])
}

pub fn lookup(root: Arc[Page], key: Bytes) -> Option[View[Bytes]] in root {
    if let Some(slot) = descend(root.image, key) {
        return lookup(root.kids[slot], key)
    }
    let (slot, hit) = search(root.image, key)
    if hit {
        value_at(root, slot)
    } else {
        None
    }
}

pub fn collection_child(root: Arc[Page], key: Bytes) -> Option[View[Arc[Page]]] in root {
    if let Some(slot) = descend(root.image, key) {
        return collection_child(root.kids[slot], key)
    }
    let (slot, hit) = search(root.image, key)
    if hit && root.image.domain == CollectionMap {
        Some(view root.kids[slot])
    } else {
        None
    }
}

pub fn collection_entry(root: Arc[Page], key: Bytes) -> Option[(View[Arc[Page]], View[Bytes])] in root {
    if let Some(slot) = descend(root.image, key) {
        return collection_entry(root.kids[slot], key)
    }
    let (slot, hit) = search(root.image, key)
    if hit && root.image.domain == CollectionMap {
        let Some(descriptor) = value_at(root, slot) else {
            return None
        }
        return Some((view root.kids[slot], descriptor))
    }
    None
}

pub fn rank(root: Arc[Page], key: Bytes, inclusive: bool) -> u64 {
    if let Some(slot) = descend(root.image, key) {
        let mut prior = 0u64
        for i in 0u64 .. slot {
            let at = entry_at(root.image, i)
            let value = at + 2 + u16_at(root.image.raw, at)
            let child_rows: u64 = list.word_le(root.image.raw, value + PTR_BYTES)
            prior = int.saturating_add(prior, child_rows)
        }
        return int.saturating_add(prior, rank(root.kids[slot], key, inclusive))
    }
    let (slot, hit) = search(root.image, key)
    if hit && inclusive {
        slot + 1
    } else {
        slot
    }
}

fn row_charge(key: u64, value: u64) -> u64 {
    62 + ((key + 7) / 8) * 8 + ((value + 7) / 8) * 8
}

pub fn totals(page: Arc[Page]) -> (u64, u64) {
    (page.rows, page.charge)
}

fn stored_totals(image: Image, slot: u64) -> (u64, u64) {
    let at = entry_at(image, slot)
    let suffix = u16_at(image.raw, at)
    let cell = at + 2 + suffix
    if level(image) != 0 {
        return (list.word_le(image.raw, cell + PTR_BYTES), list.word_le(image.raw, cell + PTR_BYTES + 8))
    }
    let prefix = u16_at(image.raw, 4) + (if image.domain == Collection {
        4u64
    } else {
        0u64
    })
    let width = if image.raw[cell] == 0 {
        u16_at(image.raw, cell + 1)
    } else {
        ref_at(image.raw, cell + 1).len
    }
    (1, row_charge(prefix + suffix, width))
}

fn image_totals(image: Image) -> (u64, u64) {
    let mut rows = 0u64
    let mut charge = 0u64
    for slot in 0u64 .. count(image) {
        let (one_rows, one_charge) = stored_totals(image, slot)
        rows = int.saturating_add(rows, one_rows)
        charge = int.saturating_add(charge, one_charge)
    }
    (rows, charge)
}

fn changed_totals(mut page: Page, old_rows: u64, old_charge: u64, rows: u64, charge: u64) {
    if (page.rows == 0xffffffffffffffffu64 && old_rows != 0) || (page.charge == 0xffffffffffffffffu64 && old_charge != 0) {
        let (calculated_rows, calculated_charge) = image_totals(page.image)
        page.rows = calculated_rows
        page.charge = calculated_charge
        return ()
    }
    page.rows = int.saturating_add(page.rows - old_rows, rows)
    page.charge = int.saturating_add(page.charge - old_charge, charge)
}

fn new_page(take image: Image, take kids: List[Arc[Page]], take blobs: List[Arc[Bytes]]) -> Page {
    let (rows, charge) = image_totals(image)
    Page(image: take image, kids: take kids, blobs: take blobs, rows: rows, charge: charge)
}

fn slots(image: Image) -> u64 {
    list.len(image.raw) - 2 * count(image)
}

fn entry_at(image: Image, i: u64) -> u64 {
    u16_at(image.raw, slots(image) + 2 * i)
}

fn key_limit(domain: Domain) -> u64 {
    match domain {
        Collection => 4092,
        CollectionMap => 4,
        Unprefixed => 4096,
    }
}

fn map_value(raw: Bytes, at: u64) -> Result[(), Error] {
    let ptr = ptr_at(raw, at)
    if ptr.stamp == 0 {
        let rows: u64 = list.word_le(raw, at + 36)
        let charge: u64 = list.word_le(raw, at + 44)
        if ptr != unlocated(0) || rows != 0 || charge != 0 {
            return Error(MalformedPage)
        }
    }
    let kind = raw[at + 52]
    let residency = raw[at + 53]
    if (kind != 1 && kind != 2) || residency > 1 || raw[at + 55] != 0 {
        return Error(MalformedPage)
    }
    if residency != 0 || raw[at + 54] != 0 {
        return Error(UnsupportedPage)
    }
    Ok(())
}

fn legal(lvl: u8, n: u64, size: u64) -> bool {
    size <= TARGET || (lvl == 0 && n == 1) || (lvl != 0 && n <= 3)
}

/// Validate the payload's local structure. Edge location, frame identity and child
/// level checks belong to the loader that resolves the edges.
pub fn decode(take raw: Bytes, domain: Domain) -> Result[Image, Error] {
    let len = list.len(raw)
    if len < HEADER || len > PAGE_MAX {
        return Error(MalformedPage)
    }
    let lvl = raw[0u64]
    let n = u16_at(raw, 2)
    let p = u16_at(raw, 4)
    let heap = u32_at(raw, 16)
    let first = HEADER + p
    let id: u64 = list.word_le(raw, 8)
    if n == 0 || id == 0 || raw[1u64] != 0 || u16_at(raw, 6) != 0 || u32_at(raw, 20) != 0 || p > key_limit(domain) || (lvl != 0 && n == 1 && p != 0) || !legal(lvl, n, len) || first > heap || heap + 2 * n != len {
        return Error(MalformedPage)
    }
    let mut at = first
    let mut bodies: u16 = 0
    for i in 0 .. n {
        if u16_at(raw, heap + 2 * i) != at || !fits(at, 2, heap) {
            return Error(MalformedPage)
        }
        let suffix = u16_at(raw, at)
        at += 2
        if !fits(at, suffix, heap) {
            return Error(MalformedPage)
        }
        if lvl != 0 && i == 0 {
            if suffix != 0 {
                return Error(MalformedPage)
            }
        } else if p + suffix > key_limit(domain) || (lvl != 0 && p + suffix == 0) || (lvl == 0 && domain == CollectionMap && p + suffix != 4) {
            return Error(MalformedPage)
        }
        at += suffix
        if lvl != 0 {
            if !fits(at, BRANCH_BYTES, heap) || ptr_at(raw, at).stamp == 0 {
                return Error(MalformedPage)
            }
            at += BRANCH_BYTES
        } else {
            if !fits(at, 1, heap) {
                return Error(MalformedPage)
            }
            let tag = raw[at]
            at += 1
            if tag == 0 {
                if !fits(at, 2, heap) {
                    return Error(MalformedPage)
                }
                let width = u16_at(raw, at)
                at += 2
                if width > INLINE_MAX || !fits(at, width, heap) {
                    return Error(MalformedPage)
                }
                if domain == CollectionMap {
                    if width != 56 {
                        return Error(MalformedPage)
                    }
                    map_value(raw, at)?
                }
                at += width
            } else {
                if tag != 1 || domain == CollectionMap || !fits(at, REF_BYTES, heap) {
                    return Error(MalformedPage)
                }
                let blob = ref_at(raw, at)
                if !valid_ref(blob) || blob.body != bodies {
                    return Error(MalformedPage)
                }
                bodies += 1
                at += REF_BYTES
            }
        }
    }
    if at != heap {
        return Error(MalformedPage)
    }
    Ok(Image(raw: take raw, domain: domain))
}

pub fn common_prefix(a: Bytes, b: Bytes) -> u64 {
    let end = order.min(list.len(a), list.len(b))
    let mut n = 0u64
    while n < end && a[n] == b[n] {
        n += 1
    }
    n
}

pub fn separator(left: Bytes, right: Bytes) -> Result[Bytes, Error] {
    if list.compare_bytes(left, right) != Less {
        return Error(OutOfOrder)
    }
    Ok(clone(list.slice(right, 0, common_prefix(left, right) + 1)))
}

// The `width` (at most eight) bytes ending at `end` as a big-endian word with
// zero bytes after them; `end` is at least eight. Two runs of at most eight bytes
// order as these words do, and on equal words as their widths do.
fn head_word(b: Bytes, end: u64, width: u64) -> u64 {
    if width == 0 {
        return 0
    }
    let w: u64 = list.word_be(b, end - 8)
    int.wrapping_shl(w, int.narrow(64 - 8 * width))
}

// The first `width` (one to eight) bytes of `b`, which has at least eight, as
// `head_word` lays them out.
fn lead_word(b: Bytes, width: u64) -> u64 {
    let w: u64 = list.word_be(b, 0)
    let gone = 64 - 8 * width
    (w >> gone) << gone
}

// `search`'s bisection over slots [first, n) when key[p, len(key)) has at most
// eight bytes and the key at least eight: the suffix is compared as one word.
fn search_word(raw: Bytes, start: u64, first: u64, n: u64, key: Bytes, p: u64) -> (u64, bool) {
    let key_width = list.len(key)
    let tail = key_width - p
    let word = head_word(key, key_width, tail)
    let mut lo = first
    let mut hi = n
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let at = u16_at(raw, start + 2 * mid)
        let width = u16_at(raw, at)
        let probe = if width <= 8 {
            let cell = head_word(raw, at + 2 + width, width)
            if cell != word {
                order.compare(cell, word)
            } else {
                order.compare(width, tail)
            }
        } else {
            list.compare_bytes(list.slice(raw, at + 2, at + 2 + width), list.slice(key, p, key_width))
        }
        match probe {
            Less => {
                lo = mid + 1
            },
            Greater => {
                hi = mid
            },
            Equal => return (mid, true),
        }
    }
    (lo, false)
}

/// In a leaf, the first slot at or above key and whether it equals key.
pub fn search(image: Image, key: Bytes) -> (u64, bool) {
    let n = count(image)
    if n == 0 {
        return (0, false)
    }
    let first = first_key_slot(level(image))
    let p = u16_at(image.raw, 4)
    let key_width = list.len(key)
    let common = order.min(p, key_width)
    if common != 0 {
        let head = if common <= 8 && key_width >= 8 {
            order.compare(head_word(image.raw, HEADER + common, common), lead_word(key, common))
        } else {
            list.compare_bytes(list.slice(image.raw, HEADER, HEADER + common), list.slice(key, 0, common))
        }
        match head {
            Less => return (n, false),
            Greater => return (first, false),
            Equal => (),
        }
    }
    if key_width < p {
        return (first, false)
    }
    let start = list.len(image.raw) - 2 * n
    let tail = key_width - p
    if tail <= 8 && key_width >= 8 {
        return search_word(image.raw, start, first, n, key, p)
    }
    let suffix = list.slice(key, p, key_width)
    let mut lo = first
    let mut hi = n
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let at = u16_at(image.raw, start + 2 * mid)
        let width = u16_at(image.raw, at)
        match list.compare_bytes(list.slice(image.raw, at + 2, at + 2 + width), suffix) {
            Less => {
                lo = mid + 1
            },
            Greater => {
                hi = mid
            },
            Equal => return (mid, true),
        }
    }
    (lo, false)
}

/// In a branch, the last slot at or below key. Slot zero is below every key.
pub fn descend(image: Image, key: Bytes) -> Option[u64] {
    if level(image) == 0 || count(image) == 0 {
        return None
    }
    let (at, hit) = search(image, key)
    Some(if hit {
        at
    } else {
        at - 1
    })
}

fn cell_at(image: Image, at: u64) -> Cell {
    if level(image) != 0 {
        return Child(Branch(child: ptr_at(image.raw, at), rows: list.word_le(image.raw, at + PTR_BYTES), charge: list.word_le(image.raw, at + PTR_BYTES + 8)))
    }
    if image.raw[at] == 0 {
        let n = u16_at(image.raw, at + 1)
        InlineValue(clone(list.slice(image.raw, at + 3, at + 3 + n)))
    } else {
        BlobValue(ref_at(image.raw, at + 1))
    }
}

fn read_slot_key(image: Image, slot: u64, at: u64) -> Bytes {
    let n = u16_at(image.raw, at)
    let p: u64 = if level(image) != 0 && slot == 0 {
        0
    } else {
        u16_at(image.raw, 4)
    }
    let mut key: Bytes = list.with_capacity(p + n)
    list.append(mut key, list.slice(image.raw, HEADER, HEADER + p))
    list.append(mut key, list.slice(image.raw, at + 2, at + 2 + n))
    take key
}

pub fn key_at(image: Image, slot: u64) -> Option[Bytes] {
    if slot >= count(image) {
        return None
    }
    Some(read_slot_key(image, slot, entry_at(image, slot)))
}

pub fn entry(image: Image, slot: u64) -> Option[Entry] {
    if slot >= count(image) {
        return None
    }
    let at = entry_at(image, slot)
    Some(Entry(key: read_slot_key(image, slot, at), cell: cell_at(image, at + 2 + u16_at(image.raw, at))))
}

pub fn owning_edge(image: Image, slot: u64) -> Option[Edge] {
    if slot >= count(image) {
        return None
    }
    let at = entry_at(image, slot)
    let cell = at + 2 + u16_at(image.raw, at)
    if level(image) != 0 {
        return Some(PageEdge(ptr_at(image.raw, cell)))
    }
    if image.domain == CollectionMap {
        return Some(PageEdge(ptr_at(image.raw, cell + 3)))
    }
    if image.raw[cell] == 1 {
        return Some(BlobEdge(ref_at(image.raw, cell + 1)))
    }
    None
}

fn full_size(row: Entry) -> u64 {
    4 + list.len(row.key) + match row.cell {
        InlineValue(value) => 3 + list.len(value),
        BlobValue(_) => 1 + REF_BYTES,
        Child(_) => BRANCH_BYTES,
    }
}

fn valid_entry(domain: Domain, lvl: u8, i: u64, row: Entry) -> Result[(), Error] {
    let n = list.len(row.key)
    if n > key_limit(domain) || (lvl != 0 && ((i == 0 && n != 0) || (i != 0 && n == 0))) {
        return Error(MalformedPage)
    }
    match row.cell {
        Child(branch) => if lvl == 0 || branch.child.stamp == 0 {
            return Error(MalformedPage)
        },
        BlobValue(blob) => if lvl != 0 || domain == CollectionMap || !valid_ref(blob) {
            return Error(MalformedPage)
        },
        InlineValue(value) => {
            let width = list.len(value)
            if lvl != 0 || width > INLINE_MAX {
                return Error(MalformedPage)
            }
            if domain == CollectionMap {
                if n != 4 || width != 56 {
                    return Error(MalformedPage)
                }
                map_value(value, 0)?
            }
        },
    }
    Ok(())
}

fn check_order(rows: List[Entry], lvl: u8, domain: Domain) -> Result[(), Error] {
    for i in 0u64 .. list.len(rows) {
        valid_entry(domain, lvl, i, rows[i])?
        if i > 0 && list.compare_bytes(rows[i - 1].key, rows[i].key) != Less {
            return Error(OutOfOrder)
        }
    }
    Ok(())
}

fn cell_size(raw: Bytes, lvl: u8, at: u64) -> u64 {
    if lvl != 0 {
        BRANCH_BYTES
    } else if raw[at] == 1 {
        1 + REF_BYTES
    } else {
        3 + u16_at(raw, at + 1)
    }
}

fn write_entry(mut raw: Bytes, at: u64, p: u64, row: Entry, body_index: Option[u16]) -> u64 {
    let value = write_key(mut raw, at, p, row.key)
    match row.cell {
        Child(branch) => {
            put_ptr(mut raw, value, branch.child)
            list.set_word_le(mut raw, value + PTR_BYTES, branch.rows)
            list.set_word_le(mut raw, value + PTR_BYTES + 8, branch.charge)
            value + BRANCH_BYTES
        },
        InlineValue(data) => write_inline(mut raw, value, data),
        BlobValue(original) => {
            let mut blob = original
            if let Some(index) = body_index {
                blob.body = index
            }
            write_blob(mut raw, value, blob)
        },
    }
}

fn write_key(mut raw: Bytes, at: u64, p: u64, key: Bytes) -> u64 {
    let suffix = list.len(key) - p
    put16(mut raw, at, suffix)
    list.copy_from_slice(mut raw, at + 2, list.slice(key, p, p + suffix))
    at + 2 + suffix
}

fn write_inline(mut raw: Bytes, at: u64, data: Bytes) -> u64 {
    raw[at] = 0
    put16(mut raw, at + 1, list.len(data))
    list.copy_from_slice(mut raw, at + 3, data)
    at + 3 + list.len(data)
}

fn write_blob(mut raw: Bytes, at: u64, blob: BlobRef) -> u64 {
    raw[at] = 1
    put_ref(mut raw, at + 1, blob)
    at + 1 + REF_BYTES
}

fn header(mut raw: Bytes, lvl: u8, id: u64, n: u64, p: u64, heap: u64) {
    raw[0u64] = lvl
    put16(mut raw, 2, n)
    put16(mut raw, 4, p)
    list.set_word_le(mut raw, 8, id)
    put32(mut raw, 16, heap)
}

fn first_key_slot(lvl: u8) -> u64 {
    if lvl == 0 {
        0
    } else {
        1
    }
}

fn prefix_of(rows: List[Entry], lvl: u8) -> u64 {
    let first = first_key_slot(lvl)
    let n = list.len(rows)
    if n <= first {
        0
    } else {
        common_prefix(rows[first].key, rows[n - 1].key)
    }
}

fn compressed(sum: u64, keys: u64, p: u64) -> u64 {
    // The prefix is stored once, even when just one key takes it.
    HEADER + sum - (order.max(keys, 1) - 1) * p
}

/// Canonical size for layout planning without allocating a canonical image.
pub fn sealed_size(image: Image) -> u64 {
    let n = count(image)
    let first = first_key_slot(level(image))
    let p = u16_at(image.raw, 4)
    let keyed = n - order.min(first, n)
    let mut sum = keyed * p + 2 * n
    for slot in 0u64 .. n {
        sum += entry_size(image, slot)
    }
    if keyed == 0 {
        return HEADER + sum
    }
    let left = entry_at(image, first)
    let right = entry_at(image, n - 1)
    let extension = common_prefix(list.slice(image.raw, left + 2, left + 2 + u16_at(image.raw, left)), list.slice(image.raw, right + 2, right + 2 + u16_at(image.raw, right)))
    compressed(sum, keyed, p + extension)
}

fn pack_entries(rows: List[Entry], lvl: u8, id: u64, domain: Domain) -> Result[Image, Error] {
    let n = list.len(rows)
    let first = first_key_slot(lvl)
    let p = prefix_of(rows, lvl)
    let mut sum = 0u64
    for row in rows {
        sum += full_size(row)
    }
    let size = compressed(sum, n - order.min(first, n), p)
    if !legal(lvl, n, size) {
        return Error(PageLimit)
    }
    let slot_start = size - 2 * n
    let mut raw: Bytes = list.with_capacity(size)
    list.fill(mut raw, size, 0)
    header(mut raw, lvl, id, n, p, slot_start)
    if p != 0 {
        list.copy_from_slice(mut raw, HEADER, list.slice(rows[first].key, 0, p))
    }
    let mut at = HEADER + p
    for i in 0u64 .. n {
        put16(mut raw, slot_start + 2 * i, at)
        at = write_entry(mut raw, at, if i < first {
            0
        } else {
            p
        }, rows[i], None)
    }
    Ok(Image(raw: take raw, domain: domain))
}

/// Build a canonical image from ordered entries with their disk references.
/// Keys are in the page's domain, with the collection id already stripped.
pub fn encode(rows: List[Entry], lvl: u8, id: u64, domain: Domain) -> Result[Image, Error] {
    if id == 0 || list.len(rows) == 0 || list.len(rows) > (PAGE_MAX - HEADER) / 7 {
        return Error(MalformedPage)
    }
    check_order(rows, lvl, domain)?
    let mut next_body: u16 = 0
    for row in rows {
        if let BlobValue(blob) = row.cell {
            if blob.body != next_body {
                return Error(MalformedPage)
            }
            next_body += 1
        }
    }
    pack_entries(rows, lvl, id, domain)
}

/// Attach the loader's already resolved edges, in slot and body order.
pub fn attach(take image: Image, take kids: List[Arc[Page]], take blobs: List[Arc[Bytes]]) -> Result[Arc[Page], Error] {
    check_attachment(image, kids, blobs)?
    Ok(arc.new(new_page(take image, take kids, take blobs)))
}

/// Attach without copying the adopted image, returning an allocation refusal.
pub fn attach_fallible(take image: Image, take kids: List[Arc[Page]], take blobs: List[Arc[Bytes]]) -> Result[Result[Arc[Page], Error], Capacity] {
    if let Error(problem) = check_attachment(image, kids, blobs) {
        return Ok(Error(problem))
    }
    // Allocate the counted node inside a read-only failure boundary, then
    // move the validated owners into it while it is still unique.
    let reserved = isolate(fn() -> Arc[Page] {
        arc.new(Page(image: Image(raw: list.new(), domain: Unprefixed), kids: list.new(), blobs: list.new(), rows: 0, charge: 0))
    })
    let mut resident = match take reserved {
        Ok(Ok(take allocated)) => take allocated,
        Error(problem) => return Error(problem),
        Ok(Error(causes)) => {
            for cause in causes {
                if let Capacity(problem) = cause.kind {
                    return Error(problem)
                }
            }
            fail("page: counted allocation failed")
        },
    }
    let mut ready: Option[Page] = Some(new_page(take image, take kids, take blobs))
    let moved = arc.with_unique(mut resident, scoped fn(mut destination: Page) {
        destination = option.unwrap(replace(mut ready, None))
    })
    let _ = option.unwrap(moved)
    Ok(Ok(take resident))
}

fn check_attachment(image: Image, kids: List[Arc[Page]], blobs: List[Arc[Bytes]]) -> Result[(), Error] {
    let n = count(image)
    let lvl = level(image)
    let owns_kids = lvl != 0 || image.domain == CollectionMap
    if list.len(kids) != (if owns_kids {
        n
    } else {
        0
    }) {
        return Error(MalformedPage)
    }
    let mut body_count = 0u64
    for i in 0u64 .. n {
        let at = entry_at(image, i)
        let value = at + 2 + u16_at(image.raw, at)
        if owns_kids {
            let ptr = ptr_at(image.raw, if lvl == 0 {
                value + 3
            } else {
                value
            })
            if stamp(kids[i].image) != ptr.stamp || (lvl != 0 && level(kids[i].image) != lvl - 1) {
                return Error(MalformedPage)
            }
        } else if image.raw[value] == 1 {
            let blob = ref_at(image.raw, value + 1)
            let b: u64 = int.widen(blob.body)
            if b >= list.len(blobs) || list.len(blobs[b]) != blob.len {
                return Error(MalformedPage)
            }
            body_count += 1
        }
    }
    if list.len(blobs) != body_count {
        return Error(MalformedPage)
    }
    Ok(())
}

pub fn empty(lvl: u8, id: u64, domain: Domain) -> Arc[Page] {
    let mut raw: Bytes = list.with_capacity(HEADER)
    list.fill(mut raw, HEADER, 0)
    header(mut raw, lvl, id, 0, 0, HEADER)
    arc.new(Page(image: Image(raw: take raw, domain: domain), kids: list.new(), blobs: list.new(), rows: 0, charge: 0))
}

fn rows_of(image: Image) -> List[Entry] {
    let n = count(image)
    let mut rows: List[Entry] = list.with_capacity(n)
    for i in 0u64 .. n {
        list.push(mut rows, option.unwrap(entry(image, i)))
    }
    rows
}

/// Write a fresh canonical image and return the old body indices in disk order.
/// The caller can use this permutation to emit or reorder the blob edges.
/// Live entries are copied from the image in place; the prefix grows to the
/// common prefix of the first and last keys, as sealed_size counts it.
pub fn seal(page: Arc[Page]) -> Result[(Image, List[u16]), Error] {
    let image = view page.image
    let n = count(image)
    let lvl = level(image)
    let id = stamp(image)
    if id == 0 || n == 0 || n > (PAGE_MAX - HEADER) / 7 {
        return Error(MalformedPage)
    }
    let size = sealed_size(image)
    if !legal(lvl, n, size) {
        return Error(PageLimit)
    }
    let first = first_key_slot(lvl)
    let p = u16_at(image.raw, 4)
    let (extension, sealed_prefix) = if first >= n {
        (0u64, 0u64)
    } else {
        let left = entry_at(image, first)
        let right = entry_at(image, n - 1)
        let grown = common_prefix(list.slice(image.raw, left + 2, left + 2 + u16_at(image.raw, left)), list.slice(image.raw, right + 2, right + 2 + u16_at(image.raw, right)))
        (grown, p + grown)
    }
    let slot_start = size - 2 * n
    let mut raw: Bytes = list.with_capacity(size)
    list.fill(mut raw, size, 0)
    header(mut raw, lvl, id, n, sealed_prefix, slot_start)
    if sealed_prefix != 0 {
        let left = entry_at(image, first)
        list.copy_from_slice(mut raw, HEADER, list.slice(image.raw, HEADER, HEADER + p))
        list.copy_from_slice(mut raw, HEADER + p, list.slice(image.raw, left + 2, left + 2 + extension))
    }
    let mut at = HEADER + sealed_prefix
    for slot in 0u64 .. n {
        put16(mut raw, slot_start + 2 * slot, at)
        let source = entry_at(image, slot)
        let stored = u16_at(image.raw, source)
        let cut = if slot < first {
            0u64
        } else {
            extension
        }
        let suffix = stored - cut
        put16(mut raw, at, suffix)
        list.copy_from_slice(mut raw, at + 2, list.slice(image.raw, source + 2 + cut, source + 2 + stored))
        let cell = source + 2 + stored
        let width = cell_size(image.raw, lvl, cell)
        list.copy_from_slice(mut raw, at + 2 + suffix, list.slice(image.raw, cell, cell + width))
        at += 2 + suffix + width
    }
    let mut sealed = Image(raw: take raw, domain: image.domain)
    let mut bodies: List[u16] = list.with_capacity(list.len(page.blobs))
    for slot in 0u64 .. n {
        if let Some(field) = blob_field(sealed, slot) {
            list.push(mut bodies, int.truncate(u16_at(sealed.raw, field)))
            put16(mut sealed.raw, field, list.len(bodies) - 1)
        }
    }
    Ok((take sealed, take bodies))
}

/// Seal a page for disk and fill its edges from the selected generation's
/// locations. BLOB locations carry the value checksum and payload length.
pub fn seal_located(page: Arc[Page], locate: scoped[view] fn(u64) -> PagePtr) -> Result[Bytes, Error] {
    let (take sealed, _) = seal(page)?
    let mut image = take sealed
    for slot in 0u64 .. count(image) {
        let at = entry_at(image, slot)
        let value = at + 2 + u16_at(image.raw, at)
        match owning_edge(image, slot) {
            Some(PageEdge(edge)) => {
                let ptr = if edge.stamp == 0 {
                    unlocated(0)
                } else {
                    locate(edge.stamp)
                }
                let field = if level(image) == 0 {
                    value + 3
                } else {
                    value
                }
                put_ptr(mut image.raw, field, ptr)
            },
            Some(BlobEdge(edge)) => {
                let loc = locate(edge.stamp)
                let relocated = BlobRef(stamp: edge.stamp, len: edge.len, checksum: loc.checksum, pack: loc.pack, offset: loc.offset, body: edge.body)
                put_ref(mut image.raw, value + 1, relocated)
            },
            None => (),
        }
    }
    let Image(raw: take raw, ..) = take image
    Ok(take raw)
}

fn blob_field(image: Image, slot: u64) -> Option[u64] {
    if level(image) != 0 {
        return None
    }
    let at = entry_at(image, slot)
    let tag = at + 2 + u16_at(image.raw, at)
    if image.raw[tag] == 1 {
        Some(tag + 41)
    } else {
        None
    }
}

fn move_last_body(mut page: Page, removed: u64, slot: u64) {
    let last = list.len(page.blobs) - 1
    if removed != last {
        list.swap(mut page.blobs, removed, last)
        for i in 0u64 .. count(page.image) {
            if i != slot {
                if let Some(at) = blob_field(page.image, i) {
                    if u16_at(page.image.raw, at) == last {
                        put16(mut page.image.raw, at, removed)
                        break
                    }
                }
            }
        }
    }
    list.truncate(mut page.blobs, last)
}

fn open_slot[T](mut xs: List[T], slot: u64, take value: T) {
    let mut i = list.len(xs)
    list.push(mut xs, take value)
    while i > slot {
        list.swap(mut xs, i, i - 1)
        i -= 1
    }
}

fn close_slot[T](mut xs: List[T], slot: u64) {
    let last = list.len(xs) - 1
    for i in slot .. last {
        list.swap(mut xs, i, i + 1)
    }
    list.truncate(mut xs, last)
}

fn entry_size(image: Image, slot: u64) -> u64 {
    let start = entry_at(image, slot)
    let value = start + 2 + u16_at(image.raw, start)
    value - start + cell_size(image.raw, level(image), value)
}

// Rebuild when a new key shortens the prefix or dead entries exhaust the image.
// The replacement keeps the private stamp and the existing body numbering.
fn repack(image: Image, row: Entry, slot: u64, hit: bool, body_index: Option[u16]) -> Result[Image, Error] {
    if level(image) == 0 {
        let edits = leaf_edit_slots(image, row, slot, hit)
        let end = list.len(edits)
        let mut width = 0u64
        for item in edits {
            width += item.width
        }
        if !legal(0, end, slot_section_size(image, row.key, edits, 0, end, width)) {
            return Error(PageLimit)
        }
        return Ok(pack_leaf_section(image, row, body_index, edits, 0, end, stamp(image)))
    }
    let mut rows = rows_of(image)
    let replacement: Entry = clone(row)
    if hit {
        rows[slot] = take replacement
    } else {
        open_slot(mut rows, slot, take replacement)
    }
    pack_entries(rows, level(image), stamp(image), image.domain)
}

fn slot_space(mut image: Image, slot: u64, hit: bool, old_size: u64, needed: u64) -> u64 {
    let n = count(image)
    let start = slots(image)
    let old_len = list.len(image.raw)
    if needed > old_len {
        let len = order.min(PRIVATE_MAX, order.max(2 * old_len, needed))
        list.reserve(mut image.raw, len - old_len)
        list.fill(mut image.raw, len - old_len, 0)
        list.copy_within(mut image.raw, start, len - 2 * n, 2 * n)
        list.fill_slice(mut image.raw, start, order.min(2 * n, len - old_len), 0)
    }
    let heap = u32_at(image.raw, 16)
    let base = slots(image)
    let dest = if hit {
        let dead = u16_at(image.raw, 6)
        put16(mut image.raw, 6, dead + old_size)
        base
    } else {
        list.copy_within(mut image.raw, base, base - 2, 2 * slot)
        put16(mut image.raw, 2, n + 1)
        base - 2
    }
    put16(mut image.raw, dest + 2 * slot, heap)
    heap
}

fn write_slot(mut image: Image, row: Entry, slot: u64, hit: bool, p: u64, old_size: u64, needed: u64, body_index: Option[u16]) {
    let heap = slot_space(mut image, slot, hit, old_size, needed)
    let end = write_entry(mut image.raw, heap, p, row, body_index)
    put32(mut image.raw, 16, end)
}

fn absent[T](value: Option[T]) -> bool {
    match value {
        None => true,
        Some(_) => false
    }
}

fn edge_matches(image: Image, row: Entry, kid: Option[Arc[Page]], blob: Option[Arc[Bytes]]) -> bool {
    match row.cell {
        Child(branch) => match kid {
            Some(k) => absent(blob) && stamp(k.image) == branch.child.stamp && level(k.image) == level(image) - 1,
            None => false,
        },
        InlineValue(value) => {
            if image.domain == CollectionMap {
                match kid {
                    Some(k) => absent(blob) && stamp(k.image) == ptr_at(value, 0).stamp,
                    None => false,
                }
            } else {
                absent(kid) && absent(blob)
            }
        },
        BlobValue(r) => match blob {
            Some(b) => absent(kid) && list.len(b) == r.len,
            None => false,
        },
    }
}

fn private_put(mut page: Page, incoming: Entry, kid: Option[Arc[Page]], blob: Option[Arc[Bytes]]) -> Result[Edit, Error] {
    let lvl = level(page.image)
    let n = count(page.image)
    let (slot, hit) = if lvl != 0 && list.len(incoming.key) == 0 {
        (0u64, n != 0)
    } else {
        search(page.image, incoming.key)
    }
    valid_entry(page.image.domain, lvl, slot, incoming)?
    if stamp(page.image) == 0 || !edge_matches(page.image, incoming, kid, blob) {
        return Error(MalformedPage)
    }
    if hit && lvl == 0 && page.image.domain != CollectionMap {
        if let InlineValue(value) = incoming.cell {
            let at = entry_at(page.image, slot)
            let cell = at + 2 + u16_at(page.image.raw, at)
            if page.image.raw[cell] == 0 && u16_at(page.image.raw, cell + 1) == list.len(value) {
                list.copy_from_slice(mut page.image.raw, cell + 3, value)
                return Ok(Changed)
            }
        }
    }
    let old_body = if hit {
        match blob_field(page.image, slot) {
            Some(at) => Some(u16_at(page.image.raw, at)),
            None => None,
        }
    } else {
        None
    }
    let body_index: Option[u16] = if absent(blob) {
        None
    } else {
        let index = if let Some(i) = old_body {
            i
        } else {
            list.len(page.blobs)
        }
        Some(int.truncate(index))
    }
    let p: u64 = if lvl != 0 && slot == 0 {
        0
    } else {
        u16_at(page.image.raw, 4)
    }
    let heap = u32_at(page.image.raw, 16)
    let dead = u16_at(page.image.raw, 6)
    let old_size = if hit {
        entry_size(page.image, slot)
    } else {
        0
    }
    let (old_rows, old_charge) = if hit {
        stored_totals(page.image, slot)
    } else {
        (0u64, 0u64)
    }
    let key_width = list.len(incoming.key) + (if page.image.domain == Collection {
        4u64
    } else {
        0u64
    })
    let (rows, charge) = match incoming.cell {
        Child(edge) => (edge.rows, edge.charge),
        InlineValue(value) => (1u64, row_charge(key_width, list.len(value))),
        BlobValue(edge) => (1u64, row_charge(key_width, edge.len)),
    }
    let total = if hit {
        n
    } else {
        n + 1
    }
    let has_prefix = list.len(incoming.key) >= p && list.compare_bytes(list.slice(incoming.key, 0, p), list.slice(page.image.raw, HEADER, HEADER + p)) == Equal
    let full = full_size(incoming) - 2
    let width = full - order.min(p, full)
    let needed = heap + width + 2 * total
    let packed = needed - dead - old_size
    let replacement = if !has_prefix || needed > PRIVATE_MAX || !legal(lvl, total, packed) {
        match repack(page.image, incoming, slot, hit, body_index) {
            Ok(take rebuilt) => Some(take rebuilt),
            Error(PageLimit) => return Ok(Split),
            Error(e) => return Error(e),
        }
    } else {
        None
    }
    if !absent(kid) && !hit {
        list.reserve(mut page.kids, 1)
    }
    if !absent(blob) && absent(old_body) {
        list.reserve(mut page.blobs, 1)
    }
    match take replacement {
        Some(take rebuilt) => {
            page.image = take rebuilt
        },
        None => write_slot(mut page.image, incoming, slot, hit, p, old_size, needed, body_index),
    }
    if let Some(k) = kid {
        if hit {
            let _ = list.set(mut page.kids, slot, arc.share(k))
        } else {
            open_slot(mut page.kids, slot, arc.share(k))
        }
    }
    match blob {
        Some(b) => match old_body {
            Some(i) => {
                let _ = list.set(mut page.blobs, i, arc.share(b))
            },
            None => list.push(mut page.blobs, arc.share(b)),
        },
        None => if let Some(i) = old_body {
            move_last_body(mut page, i, slot)
        },
    }
    changed_totals(mut page, old_rows, old_charge, rows, charge)
    Ok(if width < old_size {
        Shrunk
    } else {
        Changed
    })
}

fn private_delete(mut page: Page, key: Bytes) {
    let lvl = level(page.image)
    let n = count(page.image)
    let (slot, hit) = if lvl != 0 && list.len(key) == 0 {
        (0u64, n != 0)
    } else {
        search(page.image, key)
    }
    if !hit {
        return ()
    }
    let (old_rows, old_charge) = stored_totals(page.image, slot)
    let mut dead = u16_at(page.image.raw, 6) + entry_size(page.image, slot)
    if let Some(at) = blob_field(page.image, slot) {
        let removed = u16_at(page.image.raw, at)
        move_last_body(mut page, removed, slot)
    }
    if lvl != 0 || page.image.domain == CollectionMap {
        close_slot(mut page.kids, slot)
    }
    if n == 1 {
        let free = list.len(page.image.raw) - HEADER
        list.fill_slice(mut page.image.raw, HEADER, free, 0)
        put16(mut page.image.raw, 2, 0)
        put16(mut page.image.raw, 4, 0)
        put16(mut page.image.raw, 6, 0)
        put32(mut page.image.raw, 16, HEADER)
        page.rows = 0
        page.charge = 0
        return ()
    }
    if lvl != 0 && slot == 0 {
        let at = entry_at(page.image, 1)
        let suffix = u16_at(page.image.raw, at)
        list.copy_within(mut page.image.raw, at + 2 + suffix, at + 2, BRANCH_BYTES)
        put16(mut page.image.raw, at, 0)
        dead += suffix
    }
    if lvl != 0 && n == 2 {
        dead += u16_at(page.image.raw, 4)
        put16(mut page.image.raw, 4, 0)
    }
    let base = slots(page.image)
    list.copy_within(mut page.image.raw, base, base + 2, 2 * slot)
    list.fill_slice(mut page.image.raw, base, 2, 0)
    put16(mut page.image.raw, 2, n - 1)
    put16(mut page.image.raw, 6, dead)
    changed_totals(mut page, old_rows, old_charge, 0, 0)
}

type Built: shareable + send {
    root: Arc[Page],
    first: Bytes,
    last: Bytes,
    rows: u64,
    charge: u64
}

fn draw(mut next: u64) -> u64 {
    let id = next
    next += 1
    id
}

fn leaf_cell(row: Row, inline: u64, mut next: u64, mut blobs: List[Arc[Bytes]]) -> Cell {
    let n = list.len(row.value)
    if n <= inline {
        return InlineValue(clone(row.value))
    }
    let b: u16 = int.truncate(list.len(blobs))
    let id = draw(mut next)
    let checksum = check.xxh3(row.value, 0, n)
    list.push(mut blobs, arc.new(clone(row.value)))
    BlobValue(BlobRef(stamp: id, len: n, checksum: checksum, pack: 0, offset: 0, body: b))
}

fn leaf_end(rows: List[Row], start: u64, inline: u64) -> u64 {
    let mut sum = 0u64
    for i in start .. list.len(rows) {
        let row = view rows[i]
        let value = list.len(row.value)
        sum += 4 + list.len(row.key) + (if value <= inline {
            3 + value
        } else {
            1 + REF_BYTES
        })
        let p = common_prefix(rows[start].key, row.key)
        if i > start && compressed(sum, i - start + 1, p) > TARGET {
            return i
        }
    }
    list.len(rows)
}

fn bulk_leaf(rows: List[Row], lo: u64, hi: u64, inline: u64, domain: Domain, mut next: u64) -> Result[Built, Error] {
    // The rows are written straight into the image with pack_entries' cell
    // writers, so no row key or inline value is copied into an Entry first.
    let mut refs: List[BlobRef] = list.new()
    let mut blobs: List[Arc[Bytes]] = list.new()
    let mut charge = 0u64
    let mut sum = 0u64
    for i in lo .. hi {
        let row = view rows[i]
        let Some(total) = int.checked_add(charge, row.charge) else {
            return Error(PageLimit)
        }
        charge = total
        let value = list.len(row.value)
        sum += 4 + list.len(row.key) + (if value <= inline {
            3 + value
        } else {
            1 + REF_BYTES
        })
        if value > inline {
            if let BlobValue(blob) = leaf_cell(row, inline, mut next, mut blobs) {
                list.push(mut refs, blob)
            }
        }
    }
    let id = draw(mut next)
    let n = hi - lo
    let p = common_prefix(rows[lo].key, rows[hi - 1].key)
    let size = compressed(sum, n, p)
    if !legal(0, n, size) {
        return Error(PageLimit)
    }
    let slot_start = size - 2 * n
    let mut raw: Bytes = list.with_capacity(size)
    list.fill(mut raw, size, 0)
    header(mut raw, 0, id, n, p, slot_start)
    if p != 0 {
        list.copy_from_slice(mut raw, HEADER, list.slice(rows[lo].key, 0, p))
    }
    let mut at = HEADER + p
    let mut blob_slot = 0u64
    for i in lo .. hi {
        let row = view rows[i]
        put16(mut raw, slot_start + 2 * (i - lo), at)
        let cell = write_key(mut raw, at, p, row.key)
        if list.len(row.value) <= inline {
            at = write_inline(mut raw, cell, row.value)
        } else {
            at = write_blob(mut raw, cell, refs[blob_slot])
            blob_slot += 1
        }
    }
    let image = Image(raw: take raw, domain: domain)
    let root = arc.new(new_page(take image, list.new(), take blobs))
    Ok(Built(root: take root, first: clone(rows[lo].key), last: clone(rows[hi - 1].key), rows: hi - lo, charge: charge))
}

fn branch_end(seps: List[Bytes], start: u64) -> u64 {
    let mut sum = 4 + BRANCH_BYTES
    for i in start + 1 .. list.len(seps) {
        sum += 4 + BRANCH_BYTES + list.len(seps[i])
        let p = common_prefix(seps[start + 1], seps[i])
        if i - start >= 2 && compressed(sum, i - start, p) > TARGET {
            return i
        }
    }
    list.len(seps)
}

fn bulk_branch(nodes: List[Built], seps: List[Bytes], lo: u64, hi: u64, domain: Domain, mut next: u64) -> Result[Built, Error] {
    let mut entries: List[Entry] = list.with_capacity(hi - lo)
    let mut kids: List[Arc[Page]] = list.with_capacity(hi - lo)
    let mut rows = 0u64
    let mut charge = 0u64
    let lvl = level(nodes[lo].root.image) + 1
    for i in lo .. hi {
        let node = view nodes[i]
        let Some(sum) = int.checked_add(charge, node.charge) else {
            return Error(PageLimit)
        }
        charge = sum
        rows += node.rows
        let key: Bytes = if i == lo {
            list.new()
        } else {
            clone(seps[i])
        }
        let branch = Branch(child: unlocated(stamp(node.root.image)), rows: node.rows, charge: node.charge)
        list.push(mut entries, Entry(key: take key, cell: Child(branch)))
        list.push(mut kids, arc.share(node.root))
    }
    let id = draw(mut next)
    let image = pack_entries(entries, lvl, id, domain)?
    let root = arc.new(Page(image: take image, kids: take kids, blobs: list.new(), rows: rows, charge: charge))
    Ok(Built(root: take root, first: clone(nodes[lo].first), last: clone(nodes[hi - 1].last), rows: rows, charge: charge))
}

fn bulk_level(nodes: List[Built], domain: Domain, mut next: u64) -> Result[List[Built], Error] {
    let n = list.len(nodes)
    let mut seps: List[Bytes] = list.with_capacity(n)
    list.push(mut seps, list.new())
    for i in 1u64 .. n {
        list.push(mut seps, separator(nodes[i - 1].last, nodes[i].first)?)
    }
    let mut out: List[Built] = list.new()
    let mut lo = 0u64
    while lo < n {
        let mut hi = branch_end(seps, lo)
        if hi == n - 1 {
            // Merge a unary tail with a two-child predecessor, or borrow its
            // predecessor's final child before computing the next level.
            hi = if hi - lo == 2 {
                n
            } else {
                hi - 1
            }
        }
        list.push(mut out, bulk_branch(nodes, seps, lo, hi, domain, mut next)?)
        lo = hi
    }
    Ok(take out)
}

fn reserve_stamps(mut next: u64, rows: u64, blobs: u64) -> Result[u64, Error] {
    let Some(twice) = int.checked_mul(rows, 2) else {
        return Error(StampLimit)
    }
    let Some(used) = int.checked_add(twice, blobs) else {
        return Error(StampLimit)
    }
    let Some(reserve) = int.checked_add(used, 1) else {
        return Error(StampLimit)
    }
    let Some(end) = int.checked_add(next, reserve) else {
        return Error(StampLimit)
    }
    if next == 0 {
        return Error(StampLimit)
    }
    let start = next
    next = end
    Ok(start)
}

/// AP13 over sorted, distinct stored keys. The caller supplies each row's
/// logical charge. The reserved stamp interval stays consumed after a refusal.
pub fn bulk(rows: List[Row], domain: Domain, inline: u64, mut next: u64) -> Result[Option[Arc[Page]], Error] {
    if inline > INLINE_MAX || domain == CollectionMap {
        return Error(MalformedPage)
    }
    let n = list.len(rows)
    let mut blobs = 0u64
    for i in 0u64 .. n {
        let key = view rows[i].key
        let value = list.len(rows[i].value)
        if list.len(key) > key_limit(domain) || value > VALUE_MAX {
            return Error(PageLimit)
        }
        if i > 0 && list.compare_bytes(rows[i - 1].key, key) != Less {
            return Error(OutOfOrder)
        }
        if value > inline {
            blobs += 1
        }
    }
    let mut cursor = reserve_stamps(mut next, n, blobs)?
    if n == 0 {
        return Ok(None)
    }
    let mut nodes: List[Built] = list.new()
    let mut lo = 0u64
    while lo < n {
        let hi = leaf_end(rows, lo, inline)
        list.push(mut nodes, bulk_leaf(rows, lo, hi, inline, domain, mut cursor)?)
        lo = hi
    }
    while list.len(nodes) > 1 {
        nodes = bulk_level(nodes, domain, mut cursor)?
    }
    Ok(Some(arc.share(nodes[0u64].root)))
}

type PageSlot: shareable + send {
    row: Entry,
    kid: Option[Arc[Page]],
    blob: Option[Arc[Bytes]]
}

fn take_stamp(mut next: u64) -> Result[u64, Error] {
    let Some(end) = int.checked_add(next, 1) else {
        return Error(StampLimit)
    }
    if next == 0 {
        return Error(StampLimit)
    }
    let id = next
    next = end
    Ok(id)
}

fn stamp_replay_edit(mut page: Page, private_from: u64, mut next: u64) -> Result[(), Error] {
    if private_from == 0 {
        let id = take_stamp(mut next)?
        list.set_word_le(mut page.image.raw, 8, id)
    }
    Ok(())
}

fn owned_slots(page: Page) -> List[PageSlot] {
    let n = count(page.image)
    let mut slots_out: List[PageSlot] = list.with_capacity(n)
    for i in 0u64 .. n {
        let row = option.unwrap(entry(page.image, i))
        let blob: Option[Arc[Bytes]] = match row.cell {
            BlobValue(edge) => Some(arc.share(page.blobs[int.widen(edge.body)])),
            _ => None,
        }
        let kid: Option[Arc[Page]] = if list.len(page.kids) == 0 {
            None
        } else {
            Some(arc.share(page.kids[i]))
        }
        list.push(mut slots_out, PageSlot(row: take row, kid: take kid, blob: take blob))
    }
    take slots_out
}

// A leaf slot read in place: key_at is where its key suffix starts in the image.
type PackedSlot {
    key_at: u64,
    key_len: u64,
    width: u64,
    at: u64
}

// Byte i of a slot's key: the incoming key, or the leaf prefix followed by the suffix.
fn slot_key_byte(image: Image, incoming: Bytes, s: PackedSlot, i: u64) -> u8 {
    if s.at == 0 {
        return incoming[i]
    }
    let p = u16_at(image.raw, 4)
    if i < p {
        image.raw[HEADER + i]
    } else {
        image.raw[s.key_at + i - p]
    }
}

fn slot_common_prefix(image: Image, incoming: Bytes, a: PackedSlot, b: PackedSlot) -> u64 {
    let end = order.min(a.key_len, b.key_len)
    let mut n = 0u64
    while n < end && slot_key_byte(image, incoming, a, n) == slot_key_byte(image, incoming, b, n) {
        n += 1
    }
    n
}

// Copies key bytes from .. to of a slot to raw at dst.
fn copy_slot_key(mut raw: Bytes, dst: u64, image: Image, incoming: Bytes, s: PackedSlot, from: u64, to: u64) {
    if s.at == 0 {
        list.copy_from_slice(mut raw, dst, list.slice(incoming, from, to))
    } else {
        let p = u16_at(image.raw, 4)
        let mut out = dst
        let mut i = from
        if i < p {
            let cut = order.min(p, to)
            list.copy_from_slice(mut raw, out, list.slice(image.raw, HEADER + i, HEADER + cut))
            out += cut - i
            i = cut
        }
        if i < to {
            list.copy_from_slice(mut raw, out, list.slice(image.raw, s.key_at + i - p, s.key_at + to - p))
        }
    }
}

// Slot offsets identify the existing cells. Offset zero denotes the incoming
// cell because no entry overlaps the page header.
fn leaf_edit_slots(image: Image, row: Entry, position: u64, hit: bool) -> List[PackedSlot] {
    let n = count(image) + (if hit {
        0u64
    } else {
        1u64
    })
    let mut entries: List[PackedSlot] = list.with_capacity(n)
    for i in 0u64 .. n {
        if i == position {
            list.push(mut entries, PackedSlot(key_at: 0, key_len: list.len(row.key), width: full_size(row), at: 0))
        } else {
            let prior = if !hit && i > position {
                i - 1
            } else {
                i
            }
            let at = entry_at(image, prior)
            let key_len = u16_at(image.raw, 4) + u16_at(image.raw, at)
            let cell = at + 2 + u16_at(image.raw, at)
            let width = 4 + key_len + cell_size(image.raw, 0, cell)
            list.push(mut entries, PackedSlot(key_at: at + 2, key_len: key_len, width: width, at: cell))
        }
    }
    take entries
}

fn pack_leaf_section(image: Image, incoming: Entry, body_index: Option[u16], entries: List[PackedSlot], lo: u64, hi: u64, id: u64) -> Image {
    let n = hi - lo
    let prefix = slot_common_prefix(image, incoming.key, entries[lo], entries[hi - 1])
    let mut width = 0u64
    for i in lo .. hi {
        width += entries[i].width
    }
    let size = compressed(width, n, prefix)
    let slot_start = size - 2 * n
    let mut raw: Bytes = list.with_capacity(size)
    list.fill(mut raw, size, 0)
    header(mut raw, 0, id, n, prefix, slot_start)
    copy_slot_key(mut raw, HEADER, image, incoming.key, entries[lo], 0, prefix)
    let mut at = HEADER + prefix
    for i in lo .. hi {
        let source = view entries[i]
        put16(mut raw, slot_start + 2 * (i - lo), at)
        if source.at == 0 {
            at = write_entry(mut raw, at, prefix, incoming, body_index)
        } else {
            let key_end = source.key_len
            let suffix = key_end - prefix
            put16(mut raw, at, suffix)
            copy_slot_key(mut raw, at + 2, image, incoming.key, source, prefix, key_end)
            let payload_width = source.width - 4 - key_end
            list.copy_from_slice(mut raw, at + 2 + suffix, list.slice(image.raw, source.at, source.at + payload_width))
            at += 2 + suffix + payload_width
        }
    }
    Image(raw: take raw, domain: image.domain)
}

fn slot_section_size(image: Image, incoming: Bytes, items: List[PackedSlot], lo: u64, hi: u64, width: u64) -> u64 {
    if lo >= hi {
        return HEADER + width
    }
    compressed(width, hi - lo, slot_common_prefix(image, incoming, items[lo], items[hi - 1]))
}

fn slot_size_with_prefix(items: List[PageSlot], lvl: u8, lo: u64, hi: u64, sum: u64) -> u64 {
    let first = lo + first_key_slot(lvl)
    let width = if first == lo {
        sum
    } else {
        sum - list.len(items[lo].row.key)
    }
    if first >= hi {
        return HEADER + width
    }
    compressed(width, hi - first, common_prefix(items[first].row.key, items[hi - 1].row.key))
}

fn section_size(items: List[PageSlot], lvl: u8, lo: u64, hi: u64) -> u64 {
    let mut sum = 0u64
    for i in lo .. hi {
        sum += full_size(items[i].row)
    }
    slot_size_with_prefix(items, lvl, lo, hi, sum)
}

fn split_slots(n: u64, lvl: u8, width_at: scoped fn(u64) -> u64, section: scoped fn(u64, u64, u64) -> u64) -> Result[(u64, u64), Error] {
    let mut total = 0u64
    for slot in 0u64 .. n {
        total += width_at(slot)
    }
    if legal(lvl, n, section(0, n, total)) {
        return Ok((n, n))
    }
    let minimum = if lvl == 0 {
        1u64
    } else {
        2u64
    }
    if n < 2 * minimum {
        return Error(PageLimit)
    }
    let mut best = PAGE_MAX + 1
    let mut left = 0u64
    let mut middle = n
    let mut first_size = if minimum == 2 {
        width_at(0)
    } else {
        0u64
    }
    for cut in minimum .. n - minimum + 1 {
        first_size += width_at(cut - 1)
        let a = section(0, cut, first_size)
        let b = section(cut, n, total - first_size)
        let widest = order.max(a, b)
        if widest < best && legal(lvl, cut, a) && legal(lvl, n - cut, b) {
            left = cut
            best = widest
        }
    }
    if left != 0 {
        return Ok((left, n))
    }
    if n < 3 * minimum {
        return Error(PageLimit)
    }
    first_size = if minimum == 2 {
        width_at(0)
    } else {
        0u64
    }
    for cut in minimum .. n - 2 * minimum + 1 {
        first_size += width_at(cut - 1)
        let a = section(0, cut, first_size)
        if !legal(lvl, cut, a) {
            continue
        }
        let mut second_size = if minimum == 2 {
            width_at(cut)
        } else {
            0u64
        }
        for split in cut + minimum .. n - minimum + 1 {
            second_size += width_at(split - 1)
            let b = section(cut, split, second_size)
            let c = section(split, n, total - first_size - second_size)
            let widest = order.max(a, order.max(b, c))
            if widest < best && legal(lvl, split - cut, b) && legal(lvl, n - split, c) {
                left = cut
                middle = split
                best = widest
            }
        }
    }
    if left == 0 {
        Error(PageLimit)
    } else {
        Ok((left, middle))
    }
}

fn build_section(items: List[PageSlot], domain: Domain, lvl: u8, lo: u64, hi: u64, id: u64) -> Result[Arc[Page], Error] {
    let mut rows: List[Entry] = list.with_capacity(hi - lo)
    let mut kids: List[Arc[Page]] = list.new()
    let mut blobs: List[Arc[Bytes]] = list.new()
    for i in lo .. hi {
        let piece = view items[i]
        let mut row: Entry = clone(piece.row)
        if lvl != 0 && i == lo {
            list.clear(mut row.key)
        }
        if let Some(kid) = piece.kid {
            list.push(mut kids, arc.share(kid))
        }
        if let BlobValue(edge) = row.cell {
            let mut located = edge
            located.body = int.truncate(list.len(blobs))
            row.cell = BlobValue(located)
            let Some(payload_arc) = piece.blob else {
                return Error(MalformedPage)
            }
            list.push(mut blobs, arc.share(payload_arc))
        }
        list.push(mut rows, take row)
    }
    let image = pack_entries(rows, lvl, id, domain)?
    Ok(arc.new(new_page(take image, take kids, take blobs)))
}

fn build_pieces(items: List[PageSlot], domain: Domain, lvl: u8, mut next: u64) -> Result[List[Arc[Page]], Error] {
    let n = list.len(items)
    let (left, middle) = split_slots(n, lvl, scoped fn(slot: u64) -> u64 {
        full_size(items[slot].row)
    }, scoped fn(lo: u64, hi: u64, width: u64) -> u64 {
        slot_size_with_prefix(items, lvl, lo, hi, width)
    })?
    let mut parts: List[Arc[Page]] = list.new()
    list.push(mut parts, build_section(items, domain, lvl, 0, left, take_stamp(mut next)?)?)
    if left < middle {
        list.push(mut parts, build_section(items, domain, lvl, left, middle, take_stamp(mut next)?)?)
    }
    if middle < n {
        list.push(mut parts, build_section(items, domain, lvl, middle, n, take_stamp(mut next)?)?)
    }
    Ok(take parts)
}

fn extreme_key(root: Arc[Page], right: bool) -> Bytes {
    let i = if right {
        count(root.image) - 1
    } else {
        0u64
    }
    if level(root.image) == 0 {
        return option.unwrap(key_at(root.image, i))
    }
    extreme_key(root.kids[i], right)
}

fn branch_slot(take key: Bytes, descendant: Arc[Page]) -> PageSlot {
    let (rows, charge) = totals(descendant)
    PageSlot(row: Entry(key: take key, cell: Child(Branch(child: unlocated(stamp(descendant.image)), rows: rows, charge: charge))), kid: Some(arc.share(descendant)), blob: None)
}

fn refresh_child(mut page: Page, slot: u64) {
    let child_id = stamp(page.kids[slot].image)
    let (rows, charge) = totals(page.kids[slot])
    let start = entry_at(page.image, slot)
    let edge = start + 2 + u16_at(page.image.raw, start)
    let old_rows: u64 = list.word_le(page.image.raw, edge + PTR_BYTES)
    let old_charge: u64 = list.word_le(page.image.raw, edge + PTR_BYTES + 8)
    put_ptr(mut page.image.raw, edge, unlocated(child_id))
    list.set_word_le(mut page.image.raw, edge + PTR_BYTES, rows)
    list.set_word_le(mut page.image.raw, edge + PTR_BYTES + 8, charge)
    changed_totals(mut page, old_rows, old_charge, rows, charge)
}

// Puts the pieces that replace the child at slot into the private page itself
// while they fit, and rebuilds the page into pieces only when one does not.
fn adopt_children(mut page: Page, slot: u64, parts: List[Arc[Page]], mut next: u64) -> Result[Option[List[Arc[Page]]], Error] {
    let _ = list.set(mut page.kids, slot, arc.share(parts[0]))
    refresh_child(mut page, slot)
    for i in 1u64 .. list.len(parts) {
        let divider = separator(extreme_key(parts[i - 1], true), extreme_key(parts[i], false))?
        let row = branch_slot(take divider, parts[i])
        if private_put(mut page, row.row, row.kid, None)? == Split {
            return Ok(Some(replace_children(page, slot, parts, i, mut next)?))
        }
    }
    Ok(None)
}

// The page already holds parts[0] at slot and the dividers of parts[1..from];
// the rebuilt pieces add the rest.
fn replace_children(page: Page, slot: u64, parts: List[Arc[Page]], from: u64, mut next: u64) -> Result[List[Arc[Page]], Error] {
    let mut edited = owned_slots(page)
    for i in from .. list.len(parts) {
        let divider = separator(extreme_key(parts[i - 1], true), extreme_key(parts[i], false))?
        open_slot(mut edited, slot + i, branch_slot(take divider, parts[i]))
    }
    build_pieces(edited, page.image.domain, level(page.image), mut next)
}

fn build_leaf_piece(page: Page, incoming: PageSlot, entries: List[PackedSlot], slot: u64, hit: bool, lo: u64, hi: u64, id: u64) -> Arc[Page] {
    let mut image = pack_leaf_section(page.image, incoming.row, None, entries, lo, hi, id)
    let mut kids: List[Arc[Page]] = list.new()
    let mut blobs: List[Arc[Bytes]] = list.new()
    for i in lo .. hi {
        if let Some(at) = blob_field(image, i - lo) {
            let blob_bytes = if i == slot {
                let Some(staged_blob) = view incoming.blob else {
                    fail("page: split lost its incoming blob")
                }
                arc.share(staged_blob)
            } else {
                let ordinal = u16_at(image.raw, at)
                arc.share(page.blobs[ordinal])
            }
            put16(mut image.raw, at, list.len(blobs))
            list.push(mut blobs, take blob_bytes)
        }
        if page.image.domain == CollectionMap {
            let kid = if i == slot {
                let Some(staged_kid) = view incoming.kid else {
                    fail("page: split lost its incoming child")
                }
                arc.share(staged_kid)
            } else {
                let prior = if !hit && i > slot {
                    i - 1
                } else {
                    i
                }
                arc.share(page.kids[prior])
            }
            list.push(mut kids, take kid)
        }
    }
    arc.new(new_page(take image, take kids, take blobs))
}

fn split_insert(page: Page, incoming: PageSlot, mut next: u64) -> Result[List[Arc[Page]], Error] {
    let (slot, hit) = search(page.image, incoming.row.key)
    let entries = leaf_edit_slots(page.image, incoming.row, slot, hit)
    let n = list.len(entries)
    let (left, middle) = split_slots(n, 0, scoped fn(index: u64) -> u64 {
        entries[index].width
    }, scoped fn(lo: u64, hi: u64, width: u64) -> u64 {
        slot_section_size(page.image, incoming.row.key, entries, lo, hi, width)
    })?
    let mut parts: List[Arc[Page]] = list.new()
    list.push(mut parts, build_leaf_piece(page, incoming, entries, slot, hit, 0, left, take_stamp(mut next)?))
    if left < middle {
        list.push(mut parts, build_leaf_piece(page, incoming, entries, slot, hit, left, middle, take_stamp(mut next)?))
    }
    if middle < n {
        list.push(mut parts, build_leaf_piece(page, incoming, entries, slot, hit, middle, n, take_stamp(mut next)?))
    }
    Ok(take parts)
}

// The boolean tracks a decrease in this page's sealed size. Child totals alone
// do not change a branch's size, so only a rebuilt branch can pass it upward.
fn insert_private(mut page: Page, incoming: PageSlot, private_from: u64, mut next: u64) -> Result[(Option[List[Arc[Page]]], bool), Error] {
    let Some(slot) = descend(page.image, incoming.row.key) else {
        let edit = private_put(mut page, incoming.row, incoming.kid, incoming.blob)?
        if edit == Split {
            return Ok((Some(split_insert(page, incoming, mut next)?), false))
        }
        return Ok((None, edit == Shrunk))
    }
    let (take revised, shrank) = insert_path(mut page.kids[slot], incoming, private_from, mut next)?
    if let Some(parts) = view revised {
        if !shrank {
            return Ok((adopt_children(mut page, slot, parts, mut next)?, false))
        }
        page.kids[slot] = arc.share(parts[0])
    }
    if !shrank {
        refresh_child(mut page, slot)
        return Ok((None, false))
    }
    let rebuilt = rebalance_child(mut page, slot, mut next)?
    let smaller = if let Some(parts) = view rebuilt {
        list.len(parts) == 1 && sealed_size(parts[0].image) < sealed_size(page.image)
    } else {
        false
    }
    Ok((take rebuilt, smaller))
}

fn insert_path(mut root: Arc[Page], incoming: PageSlot, private_from: u64, mut next: u64) -> Result[(Option[List[Arc[Page]]], bool), Error] {
    let prior = stamp(root.image)
    if prior != 0 && prior >= private_from {
        let update = arc.with_unique(mut root, scoped fn(mut page: Page) -> Result[(Option[List[Arc[Page]]], bool), Error] {
            stamp_replay_edit(mut page, private_from, mut next)?
            insert_private(mut page, incoming, private_from, mut next)
        })
        if let Some(take result) = take update {
            return take result
        }
    }
    root = copy_with_stamp(root, take_stamp(mut next)?)
    option.unwrap(arc.with_unique(mut root, scoped fn(mut page: Page) -> Result[(Option[List[Arc[Page]]], bool), Error] {
        insert_private(mut page, incoming, private_from, mut next)
    }))
}

fn rebalance_child(mut page: Page, slot: u64, mut next: u64) -> Result[Option[List[Arc[Page]]], Error] {
    let lvl = level(page.kids[slot].image)
    let n = count(page.kids[slot].image)
    let siblings = count(page.image)
    if n == 0 {
        let top_key = option.unwrap(key_at(page.image, slot))
        private_delete(mut page, top_key)
        return Ok(None)
    }
    let unary = lvl != 0 && n == 1
    if siblings == 1 || (!unary && sealed_size(page.kids[slot].image) >= TARGET / 4) {
        refresh_child(mut page, slot)
        return Ok(None)
    }
    let left = if slot + 1 == siblings {
        slot - 1
    } else {
        slot
    }
    let right = left + 1
    let mut merged = owned_slots(page.kids[left])
    let first_right = list.len(merged)
    let mut right_items = owned_slots(page.kids[right])
    if lvl != 0 {
        right_items[0u64].row.key = option.unwrap(key_at(page.image, right))
    }
    for take item in take right_items {
        list.push(mut merged, take item)
    }
    let combined = list.len(merged)
    let works = if unary {
        combined <= 3
    } else {
        legal(lvl, combined, section_size(merged, lvl, 0, combined))
    }
    if !works && !unary {
        refresh_child(mut page, slot)
        return Ok(None)
    }
    let domain = page.image.domain
    let mut parent = owned_slots(page)
    let left_separator: Bytes = clone(parent[left].row.key)
    if works {
        let joined = build_section(merged, domain, lvl, 0, combined, take_stamp(mut next)?)?
        parent[left] = branch_slot(take left_separator, joined)
        close_slot(mut parent, right)
    } else {
        let pivot = if first_right == 1 {
            2u64
        } else {
            combined - 2
        }
        let right_separator: Bytes = clone(merged[pivot].row.key)
        let smaller_left = build_section(merged, domain, lvl, 0, pivot, take_stamp(mut next)?)?
        let smaller_right = build_section(merged, domain, lvl, pivot, combined, take_stamp(mut next)?)?
        parent[left] = branch_slot(take left_separator, smaller_left)
        parent[right] = branch_slot(take right_separator, smaller_right)
    }
    Ok(Some(build_pieces(parent, domain, level(page.image), mut next)?))
}

fn remove_private(mut page: Page, key: Bytes, private_from: u64, mut next: u64) -> Result[Option[List[Arc[Page]]], Error] {
    let Some(slot) = descend(page.image, key) else {
        private_delete(mut page, key)
        return Ok(None)
    }
    let revised = remove_path(mut page.kids[slot], key, private_from, mut next)?
    if let Some(parts) = revised {
        if list.len(parts) == 1 {
            page.kids[slot] = arc.share(parts[0])
            return rebalance_child(mut page, slot, mut next)
        }
        return adopt_children(mut page, slot, parts, mut next)
    }
    rebalance_child(mut page, slot, mut next)
}

fn remove_path(mut root: Arc[Page], key: Bytes, private_from: u64, mut next: u64) -> Result[Option[List[Arc[Page]]], Error] {
    if stamp(root.image) >= private_from {
        let update = arc.with_unique(mut root, scoped fn(mut page: Page) -> Result[Option[List[Arc[Page]]], Error] {
            stamp_replay_edit(mut page, private_from, mut next)?
            remove_private(mut page, key, private_from, mut next)
        })
        if let Some(take result) = take update {
            return take result
        }
    }
    root = copy_with_stamp(root, take_stamp(mut next)?)
    option.unwrap(arc.with_unique(mut root, scoped fn(mut page: Page) -> Result[Option[List[Arc[Page]]], Error] {
        remove_private(mut page, key, private_from, mut next)
    }))
}

fn finish_split(mut root: Arc[Page], parts: List[Arc[Page]], mut next: u64) -> Result[(), Error] {
    if list.len(parts) == 1 {
        root = arc.share(parts[0])
        return Ok(())
    }
    let mut parents: List[PageSlot] = list.with_capacity(list.len(parts))
    list.push(mut parents, branch_slot(list.new(), parts[0]))
    for i in 1u64 .. list.len(parts) {
        let divider = separator(extreme_key(parts[i - 1], true), extreme_key(parts[i], false))?
        list.push(mut parents, branch_slot(take divider, parts[i]))
    }
    root = build_section(parents, root.image.domain, level(root.image) + 1, 0, list.len(parents), take_stamp(mut next)?)?
    Ok(())
}

/// Delete one row, rebalancing its path and collapsing a unary root.
pub fn remove(mut root: Arc[Page], key: Bytes, private_from: u64, mut next: u64) -> Result[bool, Error] {
    remove_to(mut root, key, None, private_from, mut next)
}

/// Delete one row, using the caller's stamp-zero empty leaf of the same domain
/// if the root becomes empty.
pub fn remove_with_empty(mut root: Arc[Page], key: Bytes, empty_root: Arc[Page], private_from: u64, mut next: u64) -> Result[bool, Error] {
    remove_to(mut root, key, Some(view empty_root), private_from, mut next)
}

fn remove_to(mut root: Arc[Page], key: Bytes, empty_root: Option[View[Arc[Page]]], private_from: u64, mut next: u64) -> Result[bool, Error] {
    let present = match lookup(root, key) {
        Some(_) => true,
        None => false
    }
    if !present {
        return Ok(false)
    }
    if let Some(parts) = remove_path(mut root, key, private_from, mut next)? {
        finish_split(mut root, parts, mut next)?
    }
    if count(root.image) == 0 {
        root = match empty_root {
            Some(shared) => arc.share(shared),
            None => empty(0, 0, root.image.domain),
        }
    } else if count(root.image) == 1 && level(root.image) != 0 {
        root = arc.share(root.kids[0u64])
    }
    Ok(true)
}

/// Upsert one row, copying a shared path and keeping private pages editable.
/// Collection descriptors supply the collection root as their owning child.
/// Replay passes zero to re-stamp unique pages outside a live store.
pub fn insert(mut root: Arc[Page], key: Bytes, value: Bytes, descriptor: Option[Arc[Page]], inline: u64, private_from: u64, mut next: u64) -> Result[(), Error] {
    insert_value(mut root, key, value, None, descriptor, inline, private_from, mut next)
}

/// Share the value body with the journal operation when the row uses a BLOB.
pub fn insert_shared(mut root: Arc[Page], key: Bytes, value: Arc[Bytes], inline: u64, private_from: u64, mut next: u64) -> Result[(), Error] {
    insert_value(mut root, key, value, Some(view value), None, inline, private_from, mut next)
}

fn insert_value(mut root: Arc[Page], key: Bytes, value: Bytes, shared: Option[View[Arc[Bytes]]], descriptor: Option[Arc[Page]], inline: u64, private_from: u64, mut next: u64) -> Result[(), Error] {
    let domain = root.image.domain
    let n = list.len(value)
    if inline > INLINE_MAX || n > VALUE_MAX || list.len(key) > key_limit(domain) {
        return Error(PageLimit)
    }
    let incoming = if n <= inline || domain == CollectionMap {
        PageSlot(row: Entry(key: clone(key), cell: InlineValue(clone(value))), kid: clone(descriptor), blob: None)
    } else {
        let edge = BlobRef(stamp: take_stamp(mut next)?, len: n, checksum: check.xxh3(value, 0, n), pack: 0, offset: 0, body: 0)
        let shared_body = match shared {
            Some(held) => arc.share(held),
            None => arc.new(clone(value)),
        }
        PageSlot(row: Entry(key: clone(key), cell: BlobValue(edge)), kid: None, blob: Some(take shared_body))
    }
    let (take revised, _) = insert_path(mut root, incoming, private_from, mut next)?
    if let Some(parts) = view revised {
        finish_split(mut root, parts, mut next)?
        if level(root.image) != 0 && count(root.image) == 1 {
            root = arc.share(root.kids[0u64])
        }
    }
    Ok(())
}

fn collection_private(mut page: Page, key: Bytes, private_from: u64, mut next: u64, edit: scoped fn(mut Arc[Page], mut u64) -> Result[(), Error]) -> Result[(), Error] {
    if let Some(slot) = descend(page.image, key) {
        edit_collection(mut page.kids[slot], key, private_from, mut next, edit)?
        refresh_child(mut page, slot)
        return Ok(())
    }
    let (slot, hit) = search(page.image, key)
    if !hit {
        return Error(MalformedPage)
    }
    edit(mut page.kids[slot], mut next)?
    refresh_collection(mut page, slot)
    Ok(())
}

fn refresh_collection(mut page: Page, slot: u64) {
    let (rows, charge) = totals(page.kids[slot])
    let child_id = if rows == 0 {
        0u64
    } else {
        stamp(page.kids[slot].image)
    }
    let start = entry_at(page.image, slot)
    let value = start + 2 + u16_at(page.image.raw, start) + 3
    put_ptr(mut page.image.raw, value, unlocated(child_id))
    list.set_word_le(mut page.image.raw, value + PTR_BYTES, rows)
    list.set_word_le(mut page.image.raw, value + PTR_BYTES + 8, charge)
}

/// Edit a collection through the unique path that holds its descriptor.
pub fn edit_collection(mut root: Arc[Page], key: Bytes, private_from: u64, mut next: u64, edit: scoped fn(mut Arc[Page], mut u64) -> Result[(), Error]) -> Result[(), Error] {
    if stamp(root.image) >= private_from {
        let edited = arc.with_unique(mut root, scoped fn(mut page: Page) -> Result[(), Error] {
            stamp_replay_edit(mut page, private_from, mut next)?
            collection_private(mut page, key, private_from, mut next, edit)
        })
        if let Some(take answer) = take edited {
            return take answer
        }
    }
    root = copy_with_stamp(root, take_stamp(mut next)?)
    option.unwrap(arc.with_unique(mut root, scoped fn(mut page: Page) -> Result[(), Error] {
        collection_private(mut page, key, private_from, mut next, edit)
    }))
}

fn put_inline_leaf(mut page: Page, key: Bytes, data: Bytes, id: u64, has_sibling: bool) -> Result[bool, Capacity] {
    let (slot, hit) = search(page.image, key)
    let p = u16_at(page.image.raw, 4)
    let key_width = list.len(key)
    let value_width = list.len(data)
    let charge = row_charge(key_width + (if page.image.domain == Collection {
        4u64
    } else {
        0u64
    }), value_width)
    let (old_size, old_rows, old_charge) = if hit {
        let at = entry_at(page.image, slot)
        let value = at + 2 + u16_at(page.image.raw, at)
        if page.image.raw[value] != 0 {
            return Ok(false)
        }
        let previous = u16_at(page.image.raw, value + 1)
        if previous == value_width {
            list.copy_from_slice(mut page.image.raw, value + 3, data)
            list.set_word_le(mut page.image.raw, 8, id)
            return Ok(true)
        }
        if has_sibling && value_width < previous && sealed_size(page.image) - previous + value_width < TARGET / 4 {
            return Ok(false)
        }
        (value - at + 3 + previous, 1u64, row_charge(key_width + (if page.image.domain == Collection {
            4u64
        } else {
            0u64
        }), previous))
    } else {
        (0u64, 0u64, 0u64)
    }
    if key_width < p {
        return Ok(false)
    }
    if list.compare_bytes(list.slice(page.image.raw, HEADER, HEADER + p), list.slice(key, 0, p)) != Equal {
        return Ok(false)
    }
    let total = count(page.image) + (if hit {
        0u64
    } else {
        1u64
    })
    let suffix = key_width - p
    let needed = u32_at(page.image.raw, 16) + 5 + suffix + value_width + 2 * total
    if needed > PRIVATE_MAX || !legal(0, total, needed - u16_at(page.image.raw, 6) - old_size) {
        return Ok(false)
    }
    let old_len = list.len(page.image.raw)
    if needed > old_len {
        let capacity = order.min(PRIVATE_MAX, order.max(2 * old_len, needed))
        list.try_reserve(mut page.image.raw, capacity - old_len)?
    }
    let at = slot_space(mut page.image, slot, hit, old_size, needed)
    put16(mut page.image.raw, at, suffix)
    list.copy_from_slice(mut page.image.raw, at + 2, list.slice(key, p, key_width))
    let value = at + 2 + suffix
    page.image.raw[value] = 0
    put16(mut page.image.raw, value + 1, value_width)
    list.copy_from_slice(mut page.image.raw, value + 3, data)
    put32(mut page.image.raw, 16, value + 3 + value_width)
    changed_totals(mut page, old_rows, old_charge, 1, charge)
    list.set_word_le(mut page.image.raw, 8, id)
    Ok(true)
}

fn put_inline_path(mut root: Arc[Page], collection: Bytes, key: Bytes, data: Bytes, mut next: u64, has_sibling: bool) -> Result[bool, Capacity] {
    let edited = arc.with_unique(mut root, scoped fn(mut page: Page) -> Result[bool, Capacity] {
        // Issue the path's stamps in the same root-first order as a copy.
        let id = next
        next += 1
        let map_page = page.image.domain == CollectionMap
        let page_key = if map_page {
            view collection
        } else {
            view key
        }
        if let Some(slot) = descend(page.image, page_key) {
            if !put_inline_path(mut page.kids[slot], collection, key, data, mut next, count(page.image) > 1)? {
                return Ok(false)
            }
            refresh_child(mut page, slot)
        } else if map_page {
            let (slot, hit) = search(page.image, collection)
            if !hit || !put_inline_path(mut page.kids[slot], collection, key, data, mut next, false)? {
                return Ok(false)
            }
            refresh_collection(mut page, slot)
        } else {
            return put_inline_leaf(mut page, key, data, id, has_sibling)
        }
        list.set_word_le(mut page.image.raw, 8, id)
        Ok(true)
    })
    match take edited {
        Some(take answer) => take answer,
        None => Ok(false),
    }
}

/// Apply an inline write after the writer's checks, holding the full path
/// unique. A split, repack, possible merge or shared path leaves the tree untouched.
pub fn put_inline_unique(mut root: Arc[Page], collection: Bytes, key: Bytes, data: Bytes, inline: u64, first: u64) -> Result[bool, Capacity] {
    if list.len(data) > inline || first == 0 || first > 18446744073709551103u64 {
        return Ok(false)
    }
    let mut next = first
    put_inline_path(mut root, collection, key, data, mut next, false)
}

/// Install a prepared tree without allocating. Reuse the Arc of each
/// uniquely held page while its ancestors stay unique. A shape change
/// takes the prepared child list and a shared page takes its replacement.
pub fn install_planned(mut root: Arc[Page], take replacement: Arc[Page]) {
    if stamp(root.image) == stamp(replacement.image) {
        return ()
    }
    let mut pending: Option[Arc[Page]] = Some(take replacement)
    let changed = arc.with_unique(mut root, scoped fn(mut installed: Page) -> bool {
        let candidate = option.unwrap(replace(mut pending, None))
        match arc.try_unwrap(take candidate) {
            Error(take shared) => {
                pending = Some(take shared)
                false
            },
            Ok(take page) => {
                let mut fresh = take page
                if level(installed.image) == level(fresh.image) && list.len(installed.kids) == list.len(fresh.kids) {
                    while let Some(take descendant) = list.pop(mut fresh.kids) {
                        let slot = list.len(fresh.kids)
                        install_planned(mut installed.kids[slot], take descendant)
                    }
                    fresh.kids = replace(mut installed.kids, list.new())
                }
                installed = take fresh
                true
            },
        }
    })
    if changed != Some(true) {
        root = option.unwrap(replace(mut pending, None))
    }
}

type CursorSlot: send {
    page: Arc[Page],
    next_slot: u64
}

pub opaque type Cursor: send {
    path: List[CursorSlot],
    key_buffer: Bytes,
    has_prefix: bool,
    reverse: bool
}

pub type CursorRow: send {
    key: Bytes,
    value: Arc[Bytes],
    collection: Option[Arc[Page]]
}

fn cursor_path(mut cursor: Cursor, root: Arc[Page], boundary: Option[Bytes], inclusive: bool) {
    let mut walking = arc.share(root)
    while count(walking.image) != 0 {
        let n = count(walking.image)
        if level(walking.image) == 0 {
            let position = match boundary {
                None => if cursor.reverse {
                    n
                } else {
                    0u64
                },
                Some(key) => {
                    let (slot, hit) = search(walking.image, key)
                    if hit && cursor.reverse == inclusive {
                        slot + 1
                    } else {
                        slot
                    }
                },
            }
            list.push(mut cursor.path, CursorSlot(page: take walking, next_slot: position))
            return ()
        }
        let selected = match boundary {
            None => if cursor.reverse {
                n - 1
            } else {
                0u64
            },
            Some(key) => option.unwrap(descend(walking.image, key)),
        }
        let descendant = arc.share(walking.kids[selected])
        let following = if cursor.reverse {
            selected
        } else {
            selected + 1
        }
        list.push(mut cursor.path, CursorSlot(page: take walking, next_slot: following))
        walking = take descendant
    }
}

pub fn cursor_open(root: Arc[Page], boundary: Option[Bytes], inclusive: bool, reverse: bool) -> Cursor {
    let mut cursor = Cursor(path: list.new(), key_buffer: list.new(), has_prefix: false, reverse: reverse)
    cursor_path(mut cursor, root, boundary, inclusive)
    take cursor
}

fn cursor_row(page: Arc[Page], slot: u64) -> CursorRow {
    let at = entry_at(page.image, slot)
    let key = read_slot_key(page.image, slot, at)
    let cell_offset = at + 2 + u16_at(page.image.raw, at)
    let shared = if page.image.raw[cell_offset] == 0 {
        let width = u16_at(page.image.raw, cell_offset + 1)
        let inline: Bytes = clone(list.slice(page.image.raw, cell_offset + 3, cell_offset + 3 + width))
        arc.new(take inline)
    } else {
        let edge = ref_at(page.image.raw, cell_offset + 1)
        arc.share(page.blobs[int.widen(edge.body)])
    }
    let collection: Option[Arc[Page]] = if page.image.domain == CollectionMap {
        Some(arc.share(page.kids[slot]))
    } else {
        None
    }
    CursorRow(key: take key, value: take shared, collection: take collection)
}

fn cursor_step(mut cursor: Cursor) -> Option[u64] {
    while list.len(cursor.path) != 0 {
        let top = list.len(cursor.path) - 1
        let n = count(cursor.path[top].page.image)
        let candidate = cursor.path[top].next_slot
        if (cursor.reverse && candidate == 0) || (!cursor.reverse && candidate == n) {
            cursor.has_prefix = false
            let _ = list.pop(mut cursor.path)
            continue
        }
        let selected = if cursor.reverse {
            candidate - 1
        } else {
            candidate
        }
        cursor.path[top].next_slot = if cursor.reverse {
            selected
        } else {
            selected + 1
        }
        if level(cursor.path[top].page.image) == 0 {
            return Some(selected)
        }
        let descendant = arc.share(cursor.path[top].page.kids[selected])
        cursor_path(mut cursor, descendant, None, true)
    }
    None
}

pub fn cursor_next(mut cursor: Cursor) -> Option[CursorRow] {
    let Some(slot) = cursor_step(mut cursor) else {
        return None
    }
    Some(cursor_row(cursor.path[list.len(cursor.path) - 1].page, slot))
}

/// Advance to a leaf slot and return its owned key with `leading` prepended.
pub fn cursor_next_key(mut cursor: Cursor, leading: Bytes) -> Option[(Bytes, u64)] {
    let Some(slot) = cursor_step(mut cursor) else {
        return None
    }
    let image = cursor.path[list.len(cursor.path) - 1].page.image
    let at = entry_at(image, slot)
    let prefix = u16_at(image.raw, 4)
    let suffix = u16_at(image.raw, at)
    let mut key: Bytes = list.with_capacity(list.len(leading) + prefix + suffix)
    list.append(mut key, leading)
    list.append(mut key, list.slice(image.raw, HEADER, HEADER + prefix))
    list.append(mut key, list.slice(image.raw, at + 2, at + 2 + suffix))
    Some((take key, slot))
}

/// Borrow the value at a slot returned by `cursor_next_key` on this leaf.
pub fn cursor_value(cursor: Cursor, slot: u64) -> Option[View[Bytes]] in cursor {
    let Some(top) = list.last(cursor.path) else {
        return None
    }
    value_at(top.page, slot)
}

/// Decode from the positioned leaf with a key buffer shared across advances.
pub fn cursor_read[T](mut cursor: Cursor, visit: scoped[view] fn(Bytes, Bytes) -> T) -> Option[T] {
    let Some(slot) = cursor_step(mut cursor) else {
        return None
    }
    let page = cursor.path[list.len(cursor.path) - 1].page
    let at = entry_at(page.image, slot)
    let prefix = u16_at(page.image.raw, 4)
    let suffix = u16_at(page.image.raw, at)
    let raw_suffix = list.slice(page.image.raw, at + 2, at + 2 + suffix)
    let Some(raw) = value_at(page, slot) else {
        fail("page cursor is not on a row")
    }
    if prefix == 0 {
        return Some(visit(raw_suffix, raw))
    }
    if cursor.has_prefix {
        list.truncate(mut cursor.key_buffer, prefix)
    } else {
        list.clear(mut cursor.key_buffer)
        list.append(mut cursor.key_buffer, list.slice(page.image.raw, HEADER, HEADER + prefix))
        cursor.has_prefix = true
    }
    list.append(mut cursor.key_buffer, raw_suffix)
    Some(visit(cursor.key_buffer, raw))
}

type WalkFrame: send {
    page: Arc[Page],
    slot: u64,
    whole: bool
}

/// A sorted walk that can consume a complete remaining subtree at once.
pub opaque type Walk: send {
    path: List[WalkFrame]
}

pub type Subtree {
    stamp: u64,
    level: u8
}

pub fn walk_begin(root: Arc[Page]) -> Walk {
    let mut path: List[WalkFrame] = list.new()
    if count(root.image) != 0 {
        list.push(mut path, WalkFrame(page: arc.share(root), slot: 0, whole: true))
    }
    Walk(path: take path)
}

pub fn walk_empty() -> Walk {
    Walk(path: list.new())
}

pub fn walk_key(walk: Walk) -> Option[Bytes] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        return Some(extreme_key(top.page, false))
    }
    key_at(top.page.image, top.slot)
}

pub fn walk_subtree(walk: Walk) -> Option[Subtree] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if !top.whole {
        return None
    }
    Some(Subtree(stamp: stamp(top.page.image), level: level(top.page.image)))
}

pub fn walk_subtree_high(walk: Walk) -> Option[Bytes] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        Some(extreme_key(top.page, true))
    } else {
        None
    }
}

pub fn walk_subtree_charge(walk: Walk) -> u64 {
    let Some(top) = list.last(walk.path) else {
        return 0
    }
    let (_, charge) = totals(top.page)
    charge
}

pub fn walk_value(walk: Walk) -> Option[View[Bytes]] in walk {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        None
    } else {
        value_at(top.page, top.slot)
    }
}

pub fn walk_blob_stamp(walk: Walk) -> u64 {
    let Some(top) = list.last(walk.path) else {
        return 0
    }
    if top.whole {
        return 0
    }
    if let Some(BlobEdge(edge)) = owning_edge(top.page.image, top.slot) {
        edge.stamp
    } else {
        0
    }
}

pub fn walk_owned_value(walk: Walk) -> Option[Arc[Bytes]] {
    let Some(top) = list.last(walk.path) else {
        return None
    }
    if top.whole {
        return None
    }
    if let Some(BlobEdge(edge)) = owning_edge(top.page.image, top.slot) {
        return body(top.page, edge.body)
    }
    let Some(value) = value_at(top.page, top.slot) else {
        return None
    }
    let owned: Bytes = clone(value)
    Some(arc.new(take owned))
}

pub fn walk_expand(mut walk: Walk) {
    let n = list.len(walk.path)
    if n == 0 {
        return
    }
    let top = n - 1
    walk.path[top].whole = false
    if level(walk.path[top].page.image) != 0 {
        let first = arc.share(walk.path[top].page.kids[0u64])
        walk.path[top].slot = 1
        list.push(mut walk.path, WalkFrame(page: take first, slot: 0, whole: true))
    }
}

pub fn walk_next(mut walk: Walk) {
    let n = list.len(walk.path)
    if n == 0 {
        return
    }
    let top = n - 1
    if !walk.path[top].whole {
        walk.path[top].slot += 1
        if walk.path[top].slot < count(walk.path[top].page.image) {
            return
        }
    }
    let _ = list.pop(mut walk.path)
    while list.len(walk.path) != 0 {
        let parent = list.len(walk.path) - 1
        let slot = walk.path[parent].slot
        if slot < count(walk.path[parent].page.image) {
            let descendant = arc.share(walk.path[parent].page.kids[slot])
            walk.path[parent].slot += 1
            list.push(mut walk.path, WalkFrame(page: take descendant, slot: 0, whole: true))
            return ()
        }
        let _ = list.pop(mut walk.path)
    }
}

type WireOrder: send = LostReply | Overtaken | FencedAfterRead

type OrderedWriter: send {
    tasks: Tasks,
    r: Random,
    clock: Clock,
    endpoint: std.sim.s3.Endpoint,
    ordering: WireOrder,
    read_done: Sender[()],
    retry: Receiver[()]
}

fn bucket_order_options(create: bool) -> Options {
    let mut options = bucket_law_options(create)
    options.group_bytes = 65536
    options.group_commits = 1
    options.head_poll_ms = 600000
    take options
}

fn bucket_order_open(tasks: Tasks, r: Random, clock: Clock, endpoint: std.sim.s3.Endpoint, seed: u64, create: bool) -> Result[Db, Error] waits {
    let client = bucket_endpoint_client(endpoint, std.sim.s3.endpoint_network(endpoint), clock, tasks, "s3.test", seed, true, 0)?
    let authority = object_authority(take client, "bucket", BUCKET_LAW_OP_MS)
    Ok(open_authority(tasks, take authority, clock, r, bucket_order_options(create)) ?=> |Refusal(error: take problem, ..)| take problem)
}

// An empty commit still advances the main version. This keeps schema changes
// and their automatic cuts out of the head request schedule.
fn bucket_order_commit(mut db: Db) -> Result[Ticket, Error] waits {
    let written = run(mut db, None, (), fn(mut tx, unused_env) -> Result[(), Error] {
        let _ = info(mut tx)
        Ok(())
    })?
    let Committed(done) = written else {
        fail("the ordered test commit was refused")
    }
    Ok(done.ticket)
}

fn bucket_order_fresh(take writer: OrderedWriter) -> Result[(), Error] waits {
    let mut db = bucket_order_open(writer.tasks, writer.r, writer.clock, writer.endpoint, 1, true)?
    for _ in 0u64 .. 2 {
        let receipt = bucket_order_commit(mut db)?
        durable(mut db, receipt)?
    }
    let third = bucket_order_commit(mut db)?
    let until = clock.deadline_after_ms(host.mono_ns(writer.clock), BUCKET_LAW_OP_MS)
    let observed = fresh_snapshot(mut db, until)
    if let Overtaken = writer.ordering {
        match observed {
            Error(Fenced(1)) => (),
            _ => fail("L57-a: an overtaken fresh read did not report Fenced"),
        }
        if let Ok(()) = durable(mut db, third) {
            fail("L57-a: an unapplied commit was acknowledged")
        }
        return Ok(())
    }
    if version(observed?) != 3 {
        fail("L57-a: fresh missed the applied position 5")
    }
    durable(mut db, third)?
    if let FencedAfterRead = writer.ordering {
        let _ = channel.send(writer.read_done, ())
        let _ = channel.receive(writer.retry)
        match fresh_snapshot(mut db, until) {
            Error(Fenced(1)) => (),
            _ => fail("L57-a: fresh did not see the later claim"),
        }
        durable(mut db, third)?
    }
    Ok(())
}

fn bucket_order_history(report: std.sim.s3.Report) -> bool {
    let mut found = 0u64
    let request_id = report.head_writes[4].request
    // Successful PUT (reply lost), conditional retry, Q5 witness, fresh probe.
    for req in report.requests {
        if req.key != "head" {
            continue
        }
        if req.request == request_id {
            found = 1;
            continue
        }
        match found {
            0 => (),
            1 if req.method == "PUT" && req.status == 412 && !req.applied => {
                found += 1
            },
            2 if req.method == "GET" && req.status == 200 => {
                found += 1
            },
            3 if req.method == "GET" && req.status == 304 => return true,
            _ => return false,
        }
    }
    false
}

fn bucket_order_fresh_case(tasks: Tasks, c: Clock, r: Random, seed: u64, ordering: WireOrder) -> Result[(), Error] waits {
    let hold: std.sim.s3.Hold = match ordering {
        Overtaken => std.sim.s3.Hold(method: "PUT", key: "head", from: 5, count: 1, until: Applied("PUT", "head", 6), then: Apply),
        _ => std.sim.s3.Hold(method: "PUT", key: "head", from: 5, count: 1, until: At(50000000), then: ApplyLoseReply),
    }
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(1)
    list.push(mut holds, take hold)
    let sim = bucket_law_sim_holds(tasks, c, seed, None, list.new(), take holds, std.sim.world.plan(seed))
    let (first_done, complete): (Sender[()], Receiver[()]) = channel.new(1)
    let (go, retry): (Sender[()], Receiver[()]) = channel.new(1)
    let writer = OrderedWriter(tasks, r, clock: sim.time, endpoint: sim.endpoint, ordering, read_done: take first_done, retry: take retry)
    let running = task.spawn(tasks, bytes 33554432, take writer, bucket_order_fresh)
    match ordering {
        LostReply => (),
        Overtaken => {
            result.unwrap(std.sim.s3.requested(sim.endpoint, "PUT", "head", 5))
            let successor = bucket_order_open(tasks, r, sim.time, sim.endpoint, 2, false)?
            if version(snapshot(successor)) != 2 {
                fail("L57-a: the successor recovered the unapplied commit")
            }
            close(take successor)?
        },
        FencedAfterRead => {
            result.unwrap(channel.receive(complete))
            let successor = bucket_order_open(tasks, r, sim.time, sim.endpoint, 2, false)?
            if version(snapshot(successor)) != 3 {
                fail("L57-a: the successor lost the applied commit")
            }
            close(take successor)?
            result.unwrap(channel.send(go, ()))
        },
    }
    let tested = result.unwrap(task.join(take running))
    let trusted = match view tested {
        Ok(()) => trust_bucket_sim(tasks, sim, "s3.test"),
        Error(_) => Ok(()),
    }
    let report = bucket_law_finish(take sim)
    tested?
    trusted?
    match ordering {
        Overtaken => {
            for write in report.head_writes {
                if format.read_le(write.data, 88, 8) == 1 && format.read_le(write.data, 120, 8) >= 5 {
                    fail("L57-a: the overtaken holder advanced its prefix")
                }
            }
        },
        _ => {
            if list.len(report.head_writes) < 5 || format.read_le(report.head_writes[4].data, 120, 8) != 5 || !bucket_order_history(report) {
                fail("L57-a: head requests did not follow the reply-loss and fresh sequence")
            }
        },
    }
    Ok(())
}

fn bucket_ack_fixture(tasks: Tasks, c: Clock, seed: u64) -> BucketSim {
    let mut faults: List[std.sim.s3.Fault] = list.with_capacity(4)
    list.push(mut faults, Clean)
    list.push(mut faults, ResetAfterBody)
    list.push(mut faults, Conflict)
    list.push(mut faults, SlowDown)
    let mut choices = std.sim.world.plan(seed)
    let mut words: List[u64] = list.with_capacity(512)
    for i in 0u64 .. 256 {
        // Keep one clean connection after each seeded fault so the law
        // reaches every commit without exhausting a retry budget.
        let fault = if i % 2 == 0 {
            0u64
        } else {
            std.sim.world.pick(mut choices, 4)
        }
        list.push(mut words, fault << 62)
        list.push(mut words, seed + i)
    }
    let mut streams: List[List[u64]] = list.with_capacity(1)
    list.push(mut streams, take words)
    let tape = std.sim.world.Script(tail_seed: seed, streams: take streams)
    bucket_law_sim_plan(tasks, c, seed, None, take faults, std.sim.world.plan_from(tape, 0))
}

fn bucket_ack_marker(i: u64) -> String {
    let mut marker = string.from("mark-")
    string.push_u64(mut marker, i)
    take marker
}

fn bucket_ack_commits(tasks: Tasks, r: Random, sim: BucketSim, replaced: bool) -> Result[(), Error] waits {
    let mut primary = bucket_order_open(tasks, r, sim.time, sim.endpoint, 1, true)?
    let mut marker_client = bucket_law_client_with(sim, tasks, "s3.test", 3, true)?
    for i in 1u64 .. 9 {
        let committed = bucket_order_commit(mut primary)
        let acked = match committed {
            Ok(receipt) => durable(mut primary, receipt),
            Error(take problem) => Error(take problem),
        }
        if replaced && i > 4 {
            if let Error(Fenced(1)) = acked {} else {
                fail("VP1: the deposed holder acknowledged a commit")
            }
            continue
        }
        acked?
        let due = std.object.deadline_after_ms(marker_client, BUCKET_LAW_OP_MS)
        let (seen, _) = std.object.fetch(mut marker_client, bucket_ack_marker(i), list.new(), due)
        if let Error(NotFound) = seen {} else {
            fail("VP1: the acknowledgement marker must be absent")
        }
        if replaced && i == 4 {
            let successor = bucket_order_open(tasks, r, sim.time, sim.endpoint, 2, false)?
            if version(snapshot(successor)) != 4 {
                fail("VP1: the successor did not inherit four acknowledged commits")
            }
            close(take successor)?
        }
    }
    Ok(())
}

fn bucket_ack_history(report: std.sim.s3.Report, expected: u64) -> Result[(), Error] {
    let mut seen_mark = 0u64
    let mut position_at = 0u64
    let mut written: Map[u64, u64] = map.new()
    for event in report.head_writes {
        if format.read_le(event.data, 88, 8) == 1 {
            map.insert(mut written, event.request, format.read_le(event.data, 120, 8))
        }
    }
    for req in report.requests {
        if let Some(applied_position) = map.get(written, req.request) {
            position_at = applied_position
        }
        if req.method == "GET" && req.key == bucket_ack_marker(seen_mark + 1) {
            seen_mark += 1
            if position_at < 2 + seen_mark {
                fail("VP1: the acknowledgement preceded its exact head advance")
            }
        }
    }
    if seen_mark != expected || position_at != 2 + expected {
        fail("VP1: the register and successful acknowledgements disagree")
    }
    Ok(())
}

// Validate in application order. Connection numbers identify requests but
// can be out of order when connections deliver their final bytes concurrently.
fn bucket_law_head_history(report: std.sim.s3.Report) -> Result[(), Error] {
    let mut last_head: Map[String, u64] = map.new()
    let mut requests: Map[u64, ()] = map.new()
    for i in 0u64 .. list.len(report.head_writes) {
        let event = view report.head_writes[i]
        if event.request == 0 || event.request > report.attempts || map.contains(requests, event.request) {
            fail("VP1: duplicate or invalid applied HEAD request id")
        }
        map.insert(mut requests, event.request, ())
        // Attach-aware: a streamed Place's heads carry ATTACH (§12.11.2).
        let (captured, attach) = failure_result_from_rep(history.history_decode_head_attach(event.data))?
        let current = captured.head
        if let Some(previous_index) = map.get(last_head, event.key) {
            let prior = view report.head_writes[previous_index]
            let (prior_capture, prior_attach) = failure_result_from_rep(history.history_decode_head_attach(prior.data))?
            let previous = prior_capture.head
            let attached = match (prior_attach, attach) {
                (None, None) => false,
                _ => true,
            }
            let Some(precondition) = event.if_match else {
                fail("VP1: HEAD replaced without an If-Match")
            }
            let prior_authority = list.slice(prior.data, 240, failure_result_from_rep(history.history_authority_end(prior.data))?)
            let authority = list.slice(event.data, 240, failure_result_from_rep(history.history_authority_end(event.data))?)
            if precondition != prior.etag || event.if_none_match != None || !types.same(previous.store.hi, previous.store.lo, current.store.hi, current.store.lo) || prior.etag == event.etag || prior_authority != authority {
                fail("VP1: HEAD did not condition on its predecessor or changed the authority")
            }
            if current.pair.epoch == previous.pair.epoch {
                // ORIGIN is copied byte for byte by every same-epoch advance (STORE-SPEC §12.3).
                if !bucket_law_same_origin(current.origin, previous.origin) {
                    fail("VP1: a same-epoch HEAD advance changed ORIGIN")
                }
                if !types.same(current.pair.holder.hi, current.pair.holder.lo, previous.pair.holder.hi, previous.pair.holder.lo) {
                    fail("VP1: a same-epoch HEAD advance changed the holder")
                }
                // An attached Place may rewrite only ATTACH (a settle that
                // moved no entry): every history field stays put.
                if attached && history.history_ref_matches(current.entry, previous.entry) {
                    if !history.history_ref_matches(current.checkpoint, previous.checkpoint) || current.floor != previous.floor || current.activation != previous.activation || current.binding != previous.binding {
                        fail("VP1: an ATTACH-only HEAD update changed the history")
                    }
                } else {
                    if current.entry.seq != previous.entry.seq + 1 || current.entry.epoch != current.pair.epoch || current.floor < previous.floor || current.activation < previous.activation {
                        fail("VP1: HEAD did not advance the incumbent's prefix")
                    }
                    if !history.history_ref_matches(current.checkpoint, previous.checkpoint) && !history.history_ref_matches(current.checkpoint, current.entry) {
                        fail("VP1: HEAD did not publish the checkpoint at its new entry")
                    }
                    // Reclaim can erase earlier entries. Where an entry remains,
                    // the bucket's bytes must link to the previous applied tip.
                    let offset = string.byte_len(event.key) - 4
                    let mut entry_key = string.from(string.slice(event.key, 0, offset))
                    string.push(mut entry_key, history.history_key("e-", current.entry))
                    if let Some(stored_entry) = map.get(report.objects, entry_key) {
                        let (_, link) = failure_result_from_rep(history.history_entry_context(entry_key, current.store, current.entry, stored_entry.data))?
                        if !history.history_ref_matches(history.history_length(link, current.entry.seq - 1), previous.entry) {
                            fail("VP1: the applied advance omitted its predecessor")
                        }
                    }
                }
            } else if current.pair.epoch != previous.pair.epoch + 1 || !history.history_ref_matches(current.entry, previous.entry) || !history.history_ref_matches(current.checkpoint, previous.checkpoint) || current.floor != previous.floor || current.activation != previous.activation || current.binding != previous.binding {
                fail("VP1: a claim reused an epoch, applied from a stale epoch, or changed the inherited prefix")
            }
        } else if event.if_match != None || event.if_none_match != Some("*") || current.pair.epoch != 1 || current.entry.seq != 1 || !history.history_ref_matches(current.entry, current.checkpoint) {
            fail("VP1: genesis was not a create-only checkpoint")
        }
        map.insert(mut last_head, string.from(event.key), i)
    }
    for (key, at) in last_head {
        let event = view report.head_writes[at]
        let Some(present) = map.get(report.objects, key) else {
            fail("VP1: the applied HEAD disappeared")
        }
        if event.etag != present.etag || event.data != present.data {
            fail("VP1: the last applied HEAD differs from the stored HEAD")
        }
    }
    Ok(())
}

type WitnessCut {
    head: history.HistoryHead,
    manifest: pages.HistoryRef,
    manifest_bytes: Bytes,
    entry_bytes: Bytes
}

fn witness_cut(id: StoreId, pair: history.HistoryPair, pos: u64, predecessor: pages.HistoryRef, generation: u64, rows_version: u64) -> Result[WitnessCut, Error] {
    let mut page_record = manifest.page_manifest_empty(limits_to_rep(default_limits()))
    page_record.generation = generation
    page_record.first_live = pos
    page_record.prev_first = pos
    page_record.branches[0u64].version = rows_version
    let mut raw_manifest = failure_result_from_rep(manifest.disk_page_manifest_bytes(store_key_to_rep(id), page_record))?
    bucket_m2_object_header(mut raw_manifest, id, 1, generation)?
    let reference = history.history_new_ref(generation, pair.epoch, raw_manifest)
    let mut raw_entry: Bytes = list.with_capacity(1024)
    let retained = history.HistoryRetention(floor: pos, earlier: list.new())
    let locate = history.HistoryLocateRoot(depth: 0, rows: list.new())
    let entry_ref = failure_result_from_rep(history.history_checkpoint_packet(mut raw_entry, format.DiskContext(store: store_key_to_rep(id), role: 2, seq: pos), pair.epoch, 1, predecessor, reference, retained, locate, history.HistoryActivation(number: 0, binding:[0; 32])))?
    let header = history.HistoryHead(authority_kind: 1, store: store_key_to_rep(id), pair, activation: 0, entry: entry_ref, checkpoint: entry_ref, floor: pos, binding:[0; 32], origin: None)
    Ok(WitnessCut(head: header, manifest: reference, manifest_bytes: take raw_manifest, entry_bytes: take raw_entry))
}

fn witness_create(mut client: std.object.Client, key: String, data: Bytes, due: u64) -> Result[std.object.ETag, Error] waits {
    let (created, _) = std.object.store_if(mut client, key, Absent, clone(data), due)
    let Applied(meta) = created ?=> Remote else {
        fail("L52-W: a fixture key already existed")
    }
    Ok(meta.etag)
}

fn witness_publish(mut client: std.object.Client, selected: history.HistoryHead, declaration: Bytes, precondition: std.object.Precondition, due: u64) -> Result[std.object.ETag, Error] waits {
    let mut data: Bytes = list.with_capacity(history.HISTORY_HEAD_LIMIT)
    failure_result_from_rep(history.history_encode_head(mut data, selected, declaration))?
    let (result, _) = std.object.store_if(mut client, "head", precondition, take data, due)
    let Applied(meta) = result ?=> Remote else {
        fail("L52-W: a fixture head lost its precondition")
    }
    Ok(meta.etag)
}

fn witness_install_cut(mut client: std.object.Client, cut: WitnessCut, metadata: Bytes, precondition: std.object.Precondition, due: u64) -> Result[std.object.ETag, Error] waits {
    let _ = witness_create(mut client, history.history_key("m-", cut.manifest), cut.manifest_bytes, due)?
    let _ = witness_create(mut client, history.history_key("e-", cut.head.entry), cut.entry_bytes, due)?
    witness_publish(mut client, cut.head, metadata, precondition, due)
}

type WitnessClaimant: send {
    tasks: Tasks,
    r: Random,
    clock: Clock,
    endpoint: std.sim.s3.Endpoint
}

fn witness_claim(take actor: WitnessClaimant) -> Result[(), Error] waits {
    let mut client = bucket_endpoint_client(actor.endpoint, std.sim.s3.endpoint_network(actor.endpoint), actor.clock, actor.tasks, "s3.test", 22, true, 0)?
    let mut opts = bucket_order_options(false)
    opts.claim_ms = BUCKET_LAW_OP_MS
    opts.retain = 1
    let grant = object_authority(take client, "bucket", BUCKET_LAW_OP_MS)
    match open_authority(actor.tasks, take grant, actor.clock, actor.r, opts) {
        Ok(take unexpected) => {
            let _ = take unexpected;
            fail("L52-W: B opened after the pair changed")
        },
        Error(Refusal(error: take reason, ..)) => Error(take reason),
    }
}

fn witness_ceiling_check(report: std.sim.s3.Report, removed: String, next_cut: u64, blocked_entry: String) -> Result[(), Error] {
    let mut missing = false
    let mut head_reads = 0u64
    for event in report.requests {
        if event.method != "GET" {
            continue
        }
        if missing {
            if event.key == "head" && event.status == 200 {
                head_reads += 1
            }
            if blocked_entry != "" && event.key == blocked_entry {
                fail("L52-W: B read a checkpoint after observing another pair")
            }
        }
        if event.key == removed && event.status == 404 {
            missing = true
        }
    }
    if !missing || head_reads != 1 {
        fail("L52-W: a missing checkpoint did not cause exactly one fresh head GET")
    }
    if list.len(report.head_writes) != (if next_cut == 22 {
        5
    } else {
        7
    }) {
        fail("L52-W: B wrote a head or C missed an advance")
    }
    let last_write = report.head_writes[list.len(report.head_writes) - 1]
    if format.read_le(last_write.data, 88, 8) != 2 || format.read_le(last_write.data, 120, 8) != next_cut + 1 {
        fail("L52-W: the successor did not advance after reclaim")
    }
    Ok(())
}

fn witness_case(tasks: Tasks, c: Clock, r: Random, seed: u64, lost_marker: bool) -> Result[(), Error] waits {
    let id = StoreId(hi: 9, lo: 10)
    let pair = history.HistoryPair(epoch: 1, holder: types.StoreKey(hi: 11, lo: 12))
    let previous = pages.HistoryRef(seq: 19, epoch: 1, len: 112, digest: 0)
    let first = witness_cut(id, pair, 20, previous, 1, 0)?
    let manifest_key = history.history_key("m-", first.manifest)
    let mut group: Bytes = list.with_capacity(1024)
    bucket_m2_law_commit_packet(mut group, first.head, 1)?
    let group_ref = history.history_new_ref(21, 1, group)
    let later = witness_cut(id, pair, 22, group_ref, 2, 1)?
    let entry_key = history.history_key("e-", later.head.entry)
    let mut holds: List[std.sim.s3.Hold] = list.with_capacity(2)
    list.push(mut holds, std.sim.s3.Hold(method: "GET", key: clone(manifest_key), from: 1, count: 1, until: Applied("DELETE", clone(manifest_key), 1), then: Apply))
    if lost_marker {
        list.push(mut holds, std.sim.s3.Hold(method: "GET", key: clone(entry_key), from: 1, count: 1, until: Applied("DELETE", clone(entry_key), 1), then: Apply))
    }
    let sim = bucket_law_sim_holds(tasks, c, seed, None, list.new(), take holds, std.sim.world.plan(seed))
    let mut publisher = bucket_law_client_with(sim, tasks, "s3.test", 19, true)?
    let metadata = failure_result_from_rep(history.history_config_bytes(history.object_history_config(std.object.bucket_config(publisher), "bucket")))?
    let due = std.object.deadline_after_ms(publisher, BUCKET_LAW_OP_MS)
    let first_tag = witness_install_cut(mut publisher, first, metadata, Absent, due)?
    let claimant = WitnessClaimant(tasks, r, clock: sim.time, endpoint: sim.endpoint)
    let pending_claim = task.spawn(tasks, bytes 33554432, take claimant, witness_claim)
    result.unwrap(std.sim.s3.requested(sim.endpoint, "GET", manifest_key, 1))
    if lost_marker {
        let _ = witness_create(mut publisher, history.history_key("e-", group_ref), group, due)?
        let mut head21 = first.head
        head21.entry = group_ref
        let group_tag = witness_publish(mut publisher, head21, metadata, Match(first_tag), due)?
        let _ = witness_install_cut(mut publisher, later, metadata, Match(group_tag), due)?
        // A's previous checkpoint is below its new floor.
        std.object.erase(mut publisher, manifest_key, due) ?=> Remote
        result.unwrap(std.sim.s3.requested(sim.endpoint, "GET", entry_key, 1))
    }
    let client = bucket_law_client_with(sim, tasks, "s3.test", 23, true)?
    let mut opts = bucket_order_options(false)
    opts.retain = 1
    let grant = object_authority(take client, "bucket", BUCKET_LAW_OP_MS)
    let mut successor = open_authority(tasks, take grant, sim.time, r, opts) ?=> |Refusal(error: take reason, ..)| take reason
    bucket_law_checkpoint(mut successor)?
    reclaim_barrier(successor)?
    // C is the same Store, a validated successor: B names C's pair (§12.3).
    let Error(Superseded(deposer)) = result.unwrap(task.join(take pending_claim)) else {
        fail("L52-W: B did not return Superseded")
    }
    let successor_ticket = bucket_order_commit(mut successor)?
    durable(mut successor, successor_ticket)?
    close(take successor)?
    let _ = take publisher
    let report = bucket_law_report(take sim)
    let final_write = report.head_writes[list.len(report.head_writes) - 1]
    if !history_claim_matches_pair(deposer, failure_result_from_rep(history.history_decode_head(final_write.data))?.head.pair) {
        fail("L52-W: Superseded did not name C's pair")
    }
    if lost_marker {
        witness_ceiling_check(report, entry_key, 24, "")?
    } else {
        // C has already read its checkpoint when its sweep removes C20.
        if list.len(report.head_writes) != 5 {
            fail("L52-W: the successor's head writes were missing")
        }
        let body = view report.head_writes[3].data
        let reference = pages.HistoryRef(seq: format.read_le(body, 120, 8), epoch: format.read_le(body, 128, 8), len: format.read_le(body, 136, 8), digest: format.read_le(body, 144, 8))
        let claimed_entry = history.history_key("e-", reference)
        witness_ceiling_check(report, manifest_key, 22, claimed_entry)?
    }
    trust_bucket_report(report)
}

fn bucket_m2_law_follow(tasks: Tasks, r: Random, sim: BucketSim, seed: u64) -> Result[(), Error] waits {
    let mut model_history = std.sim.history.new(seed)
    // The witness commits below carry no operations, so each model projection is empty.
    std.sim.history.model(mut model_history, 0, b"")
    std.sim.history.model(mut model_history, 1, b"")
    let initial_client = bucket_law_client_with(sim, tasks, "s3.test", 1, true)?
    let read_source = bucket_law_client_with(sim, tasks, "s3.test", 2, true)?
    let mut writer = history.history_reader(take initial_client, 0)
    let mut workspace = failure_result_from_rep(history.history_buffers(1024))?
    let authority = failure_result_from_rep(history.history_config_bytes(history.object_history_config(std.object.bucket_config(writer.client), "bucket")))?
    let (take opened, _) = history_open_register(mut writer, sim.time, r, result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64)), "bucket", mut workspace, BUCKET_LAW_OP_MS)?
    let mut held = take opened
    let mut source = followers()
    let mut settings = result.unwrap(sized(Bucket(bucket_law_lanes(0)), 2147483648u64))
    settings.expect = Some(store_key_from_rep(history.register_head(held).store))
    // Writer selection never constrains a read-only follower.
    settings.activation = Some(17)
    settings.binding = Some(list.new())
    let plan = follower_law_plan(Bucket(bucket_law_lanes(0)), settings)
    let service = follower_law_service(tasks, plan, 1)?
    let mut followed = follower(mut source, follower_slot(follower_owner(service)?, plan)?, object_authority(take read_source, "reader", BUCKET_LAW_OP_MS), sim.time, settings.expect)?
    let deadline = std.object.deadline_after_ms(writer.client, BUCKET_LAW_OP_MS)
    let initial = std.sim.history.request(model_history, 1, Fresh)
    let genesis = fresh(mut followed, deadline)?
    std.sim.history.check(std.sim.history.read(mut model_history, initial, version(genesis), b""))
    let genesis_head = follower_head(followed)?
    if version(genesis) != 0 || genesis_head.claim.epoch != 1 || genesis_head.activation != 0 || list.len(genesis_head.binding) != 32 {
        fail("fresh did not preserve the initial capture")
    }
    bucket_m2_law_commit_packet(mut workspace.packet, history.register_head(held), 1)?
    let HistoryApplied(_) = failure_result_from_rep(history.history_register_advance(mut writer.client, mut held, authority, mut workspace, deadline))? else {
        fail("the first group did not advance")
    }
    let requested = std.sim.history.request(model_history, 1, Follower(1))
    let advanced = at_least(mut followed, Position(store: store_key_from_rep(history.register_head(held).store), branch: 0, version: 1), deadline)?
    std.sim.history.check(std.sim.history.read(mut model_history, requested, version(advanced), b""))
    if version(advanced) != 1 || version(genesis) != 0 {
        fail("catch-up did not publish its applied version privately")
    }
    bucket_m2_law_commit_packet(mut workspace.packet, history.register_head(held), 2)?
    let HistoryApplied(_) = failure_result_from_rep(history.history_register_advance(mut writer.client, mut held, authority, mut workspace, deadline))? else {
        fail("the second group did not advance")
    }
    let final_item = history.history_key("e-", history.register_head(held).entry)
    match std.object.erase(mut writer.client, final_item, deadline) {
        Error(take problem) => return Error(Remote(take problem)),
        Ok(()) => (),
    }
    if let Error(Corrupt(Fault(file: gone, why: Absent, ..))) = fresh(mut followed, deadline) {
        if gone != final_item {
            fail("witness named another object")
        }
    } else {
        fail("a missing live entry was accepted or classified as reclaimed")
    }
    let current = applied(followed, Branch(store: store_key_from_rep(history.register_head(held).store), id: 0))?
    if current.version != 1 {
        fail("failed catch-up changed the published state")
    }
    Ok(())
}

@test
fn bucket_test_m2_follower(c: Clock, r: Random, tasks: Tasks, seed_grant: Env) -> Result[(), Error] waits {
    let seed = bucket_law_seed(seed_grant, 773)
    let sim = bucket_law_sim(tasks, c, seed, None, list.new())
    let checked = trust_bucket_then(tasks, sim, "s3.test", bucket_m2_law_follow(tasks, r, sim, seed))
    let _ = bucket_law_finish(take sim)
    trust_seed_gate("bucket_test_m2_follower", take checked)
}

// L91 (F1, E7): idle Bucket holder A with every frame durable is deposed by B,
// who claims and commits a change to key k. Before A's idle poll, A runs a
// zero-mutation run reading k. A must return and latch Fenced (red without
// the skip-time conditional head GET).
@test
fn bucket_test_empty_commit_fenced(c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let sim = bucket_law_sim(tasks, c, 9101, None, list.new())
    let mut history = std.sim.history.new(9101)
    let mut a = bucket_order_open(tasks, r, sim.time, sim.endpoint, 1, true)?
    let _ = law_table(mut a, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let rows = table(mut a, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let Committed(w1) = run(mut a, None, copy_env(rows), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 1u64, 10u64)
    })? else {
        fail("L91 F1: A initial write failed")
    }
    durable(mut a, w1.ticket)?
    let v_a = version(snapshot(a))
    std.sim.history.model(mut history, v_a, types.key_word(10u64))
    std.sim.history.check(std.sim.history.committed(mut history, types.key_word(1u64), v_a, types.key_word(10u64)))
    std.sim.history.check(std.sim.history.reply(mut history, 1, types.key_word(1u64), v_a, Some(types.key_word(10u64))))
    // While A still owns the claim, a zero-mutation run succeeds with 0 new PUT head.
    let seq_before = a.frame_seq
    let req_a1 = std.sim.history.request(history, 1, Fresh)
    let Committed(r_ok) = run(mut a, None, copy_env(rows), fn(mut tx, t) -> Result[Option[u64], Error] {
        fetch(tx, t, 1u64)
    })? else {
        fail("L91 F1: unfenced zero-mutation run failed")
    }
    if r_ok.value != Some(10u64) || version(snapshot(a)) != v_a || a.frame_seq != seq_before {
        fail("L91 F1: unfenced skipped run changed version or frame_seq")
    }
    if let Some(_) = r_ok.info {
        fail("L91 F1/F2: unfenced skipped run returned Some(CallInfo)")
    }
    std.sim.history.check(std.sim.history.read(mut history, req_a1, v_a, types.key_word(10u64)))
    // B claims the store and commits k = 20.
    let mut b = bucket_order_open(tasks, r, sim.time, sim.endpoint, 2, false)?
    let rows_b = table(mut b, "rows", std.codec.key_u64(), std.codec.of_u64())?
    let Committed(w2) = run(mut b, None, copy_env(rows_b), fn(mut tx, t) -> Result[(), Error] {
        put(mut tx, t, 1u64, 20u64)
    })? else {
        fail("L91 F1: B write failed")
    }
    durable(mut b, w2.ticket)?
    let v_b = version(snapshot(b))
    std.sim.history.model(mut history, v_b, types.key_word(20u64))
    std.sim.history.check(std.sim.history.committed(mut history, types.key_word(2u64), v_b, types.key_word(20u64)))
    std.sim.history.check(std.sim.history.reply(mut history, 2, types.key_word(2u64), v_b, Some(types.key_word(20u64))))
    close(take b)?
    // A is idle with every frame durable; A runs a zero-mutation run reading k.
    // Without the skip-time head read, A would return Ok(Committed(Some(10)))
    // and durable would succeed, releasing stale data and failing Freshness.
    let req_stale = std.sim.history.request(history, 1, Fresh)
    match run(mut a, None, copy_env(rows), fn(mut tx, t) -> Result[Option[u64], Error] {
        fetch(tx, t, 1u64)
    }) {
        Error(Fenced(1)) => (),
        Ok(Committed(done)) => {
            let _ = durable(mut a, done.ticket)
            std.sim.history.check(std.sim.history.read(mut history, req_stale, version(snapshot(a)), types.key_word(option.unwrap(done.value))))
            fail("L91 F1: deposed Bucket holder committed stale zero-mutation run")
        },
        _ => fail("L91 F1: deposed Bucket holder did not return Fenced(1)"),
    }
    // Fenced must be latched on A.
    match health(a) {
        Fenced(1) => (),
        _ => fail("L91 F1: Fenced was not latched in health(a)"),
    }
    match run(mut a, None, copy_env(rows), fn(mut tx, t) -> Result[Option[u64], Error] {
        fetch(tx, t, 1u64)
    }) {
        Error(Fenced(1)) => (),
        _ => fail("L91 F1: second zero-mutation run on fenced holder was not refused"),
    }
    let _ = close(take a)
    let report = bucket_law_finish(take sim)
    // Verify the unfenced skip issued a conditional 304 GET head and the fenced
    // skip issued a 200 GET head with no extra PUT head from A.
    let mut saw_304 = false
    for req in report.requests {
        if req.method == "GET" && req.key == "head" && req.status == 304 {
            saw_304 = true
        }
    }
    if !saw_304 {
        fail("L91 F1: unfenced skip did not issue a conditional 304 head GET")
    }
    Ok(())
}

// Every ORIGIN field, so a same-epoch advance that rewrote any byte of the
// 49-byte payload is caught.
fn bucket_law_same_origin(a: Option[history.HistoryOrigin], b: Option[history.HistoryOrigin]) -> bool {
    match (a, b) {
        (None, None) => true,
        (Some(x), Some(y)) => x.epoch == y.epoch && x.class == y.class && x.permit_epoch == y.permit_epoch && history.history_origin_same_bytes(x.attempt, y.attempt) && history.history_origin_same_bytes(x.permit_attempt, y.permit_attempt),
        _ => false,
    }
}

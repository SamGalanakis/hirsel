fn same_value_pair(c: Clock) -> (Snapshot, Snapshot) {
    let mut db = test_db(c, 1073741824)
    for k in 0u64 .. 96 {
        if !put_one(mut db, k, k + 1) {
            fail("same-value fixture refused")
        }
    }
    let a = snapshot(db)
    for k in 0u64 .. 96 {
        if !put_one(mut db, k, k + 1) {
            fail("same-value rewrite refused")
        }
    }
    (take a, snapshot(db))
}

// L23: k=96 writes, w=0 returned differences. Both full scans contain keys
// 0..95 and values 1..96, whose hand-derived sum is 96*97/2 = 4656.
pub fn law_changes_rewritten_equal(c: Clock) -> bool {
    let pair = same_value_pair(c)
    let (take a, take b) = take pair
    let delta = result.unwrap(changes(a, b))
    if list.len(delta) != 0 {
        return false
    }
    let mut left = result.unwrap(scan_bytes(a, 1, Unbounded, Unbounded))
    let mut right = result.unwrap(scan_bytes(b, 1, Unbounded, Unbounded))
    let mut sum: u64 = 0
    for k in 0u64 .. 96 {
        let x = option.unwrap(result.unwrap(next_bytes(mut left)))
        let y = option.unwrap(result.unwrap(next_bytes(mut right)))
        if x.0 != result.unwrap(physical(1, key_word(k))) || list.len(x.1) != 8 || decode_word(x.1) != k + 1 || x != y {
            return false
        }
        sum += decode_word(x.1)
    }
    sum == 4656 && result.unwrap(next_bytes(mut left)) == None && result.unwrap(next_bytes(mut right)) == None
}

@test
fn test_changes_rewritten_equal(c: Clock) -> Result[(), ()] {
    if law_changes_rewritten_equal(c) {
        Ok(())
    } else {
        Error(())
    }
}

// Spec-derived 97-byte COMMIT vectors from core/tools/store_reference.py and
// external libxxhash, not encode_commit itself. Offsets72,73,1048576 plus
// contrasting store/branch/version/time/segment values defeat constant fields.
fn frame_boundary_points() -> bool {
    let expected: Inline[Inline[u8, 97], 5] =[[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 22u8, 231u8, 24u8, 90u8, 230u8, 90u8, 179u8, 95u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 231u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 131u8, 62u8, 23u8, 153u8, 102u8, 103u8, 61u8, 55u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 231u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 242u8, 74u8, 7u8, 159u8, 62u8, 162u8, 244u8, 186u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 231u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 195u8, 158u8, 179u8, 130u8, 221u8, 148u8, 76u8, 174u8, 7u8, 0u8, 0u8, 0u8, 2u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 233u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8],[17u8, 0u8, 1u8, 0u8, 81u8, 0u8, 0u8, 0u8, 155u8, 194u8, 195u8, 201u8, 143u8, 74u8, 58u8, 20u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 7u8, 34u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8]]
    let stores: Inline[StoreId, 5] =[StoreId(hi: 1, lo: 2), StoreId(hi: 1, lo: 2), StoreId(hi: 1, lo: 2), StoreId(hi: 3, lo: 4), StoreId(hi: 1, lo: 9)]
    let branches: Inline[u32, 5] =[0, 0, 0, 7, 1]
    let versions: Inline[u64, 5] =[257, 257, 257, 258, 65536]
    let times: Inline[u64, 5] =[999, 999, 999, 1001, 0]
    let segments: Inline[u64, 5] =[9, 9, 9, 10, 256]
    let offsets: Inline[u64, 5] =[72, 73, 1048576, 73, 1048576]
    let mut ids: u64 = 0
    let mut ops: std.omap.OMap[Bytes, Option[Bytes]] = std.omap.new()
    let key = result.unwrap(physical(1, key_word(7)))
    let mut value: Bytes = list.new()
    result.unwrap(list.push(mut value, 0u8))
    result.unwrap(list.push(mut value, 0u8))
    for i in 0u64 .. 32 {
        result.unwrap(list.push(mut value, int.truncate(i)))
    }
    ops = {
        let (take next_map, _) = result.unwrap(std.omap.insert(mut ids, ops, take key, Some(take value)))
        take next_map
    }
    for i in 0u64 .. 5 {
        let ci = CallInfo(id: CallId(store: stores[i], branch: branches[i], version: versions[i]), at: times[i], seed: 0)
        let raw = result.unwrap(encode_commit(ci, ops, segments[i], offsets[i]))
        if list.len(raw) != 97 {
            return false
        }
        for at in 0u64 .. 97 {
            if raw[at] != expected[i][at] {
                return false
            }
        }
    }
    true
}

fn seed_boundary_points() -> bool {
    let versions: Inline[u64, 4] =[1, 256, 257, 258]
    let expected: Inline[u64, 4] =[14418179372084732305u64, 5897679137105858605u64, 15310494363706394912u64, 17163838325734834816u64]
    for i in 0u64 .. 4 {
        let ci = call_info(StoreId(hi: 1, lo: 2), 0, versions[i], 8, 9)
        if ci.seed != expected[i] || ci.id.version != versions[i] || ci.at != 9 {
            return false
        }
    }
    let stores: Inline[StoreId, 3] =[StoreId(hi: 9, lo: 2), StoreId(hi: 1, lo: 9), StoreId(hi: 1, lo: 2)]
    let branches: Inline[u32, 3] =[0, 0, 1]
    let other: Inline[u64, 3] =[15407299455215397367u64, 15770638267073898971u64, 7822107688032465790u64]
    for i in 0u64 .. 3 {
        if call_info(stores[i], branches[i], 1, 8, 9).seed != other[i] {
            return false
        }
    }
    true
}

fn resident_rounding_points() -> bool {
    let sizes: Inline[u64, 8] =[0, 1, 7, 8, 9, 15, 16, 17]
    let rounded: Inline[u64, 8] =[0, 8, 8, 8, 16, 16, 16, 24]
    for i in 0u64 .. 8 {
        let mut key: Bytes = result.unwrap(list.with_capacity(sizes[i]))
        result.unwrap(list.fill(mut key, sizes[i], 0u8))
        for j in 0u64 .. 8 {
            let mut value: Bytes = result.unwrap(list.with_capacity(sizes[j]))
            result.unwrap(list.fill(mut value, sizes[j], 0u8))
            if entry(key, value) != 62 + rounded[i] + rounded[j] {
                return false
            }
        }
    }
    true
}

fn range_boundary_points(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "boundary", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "boundary", std.codec.key_u64(), std.codec.of_u64()))
    let sh = shape(t)
    // The review's one-row witness, before any node split can distract from it.
    let witness = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[bool, Error] {
        put(mut tx, t, 32, 7)?
        let mut rows = range(tx, sh, Included(32), Included(32))?
        Ok(next(mut rows)? == Some((32u64, 7u64)) && next(mut rows)? == None)
    }))
    match take witness {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    for k in 0u64 .. 96 {
        if !typed_put(mut db, t, k, k + 1) {
            return false
        }
    }
    let points: Inline[u64, 10] =[0, 15, 16, 31, 32, 33, 63, 64, 95, 96]
    for i in 0u64 .. 10 {
        let pivot = points[i]
        for a in 0u64 .. 3 {
            for b in 0u64 .. 3 {
                let lo: Bound[u64] = match a {
                    0 => Unbounded,
                    1 => Included(pivot),
                    _ => Excluded(pivot)
                }
                let hi: Bound[u64] = match b {
                    0 => Unbounded,
                    1 => Included(pivot + 1),
                    _ => Excluded(pivot + 1)
                }
                let outcome = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[bool, Error] {
                    let mut rows = range(tx, sh, lo, hi)?
                    for k in 0u64 .. 96 {
                        let lower = a == 0 || (a == 1 && k >= pivot) || (a == 2 && k > pivot)
                        let upper = b == 0 || (b == 1 && k <= pivot + 1) || (b == 2 && k < pivot + 1)
                        if lower && upper {
                            if next(mut rows)? != Some((k, k + 1)) {
                                return Ok(false)
                            }
                        }
                    }
                    Ok(next(mut rows)? == None)
                }))
                match take outcome {
                    Committed(done) => if !done.value {
                        return false
                    },
                    _ => return false
                }
            }
        }
    }
    result.unwrap(create_table(mut db, "other_boundary", std.codec.key_u64(), std.codec.of_u64()))
    let second_table = result.unwrap(table(mut db, "other_boundary", std.codec.key_u64(), std.codec.of_u64()))
    let second_shape = shape(second_table)
    let second_witness = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[bool, Error] {
        put(mut tx, second_table, 32, 17)?
        let mut rows = range(tx, second_shape, Included(32), Included(32))?
        Ok(next(mut rows)? == Some((32u64, 17u64)) && next(mut rows)? == None)
    }))
    match take second_witness {
        Committed(done) => if !done.value {
            return false
        },
        _ => return false
    }
    true
}

fn catalog_key_handle(take key: Bytes) -> Result[Arc[Bytes], Error] {
    match arc.new(take key) {
        Ok(take shared) => Ok(take shared),
        Error((c, _)) => Error(Full(c))
    }
}

fn readable(roots: Roots, key: Bytes, id: u32) -> Result[(), Error] {
    match std.omap.get(roots.catalog, key) {
        Some(raw) => {
            if list.len(raw) < 5 {
                return Error(malformed(0))
            }
            if read_le(raw, 1, 4) == int.widen(id) {
                Ok(())
            } else {
                Error(Stale(id))
            }
        },
        None => Error(Stale(id))
    }
}

pub scoped type IndexRows[K, V] {
    rows: Rows[K, V],
    reads: View[Log[Read]]
}

pub fn next[K, V](mut r: Rows[K, V]) -> Result[Option[(K, V)], Error] {
    advance_rows(mut r, fn(key: Bytes) -> Result[(), Error] {
        Ok(())
    })
}

pub fn next_indexed[K, V](mut r: IndexRows[K, V]) -> Result[Option[(K, V)], Error] {
    indexed_advance(mut r.rows, r.reads)
}

fn indexed_advance[K, V](mut rows: Rows[K, V], reads: View[Log[Read]]) -> Result[Option[(K, V)], Error] {
    advance_rows(mut rows, fn(key: Bytes) -> Result[(), Error] {
        match log.append(reads, Point(copied(key)?)) {
            Ok(()) => Ok(()),
            Error((c, _)) => Error(Full(c))
        }
    })
}

fn catalog_recharge(live: u64, roots: Roots, key: Bytes, value: Bytes, retained: bool) -> u64 {
    let old_charge = if retained {
        0u64
    } else {
        match std.omap.get(roots.catalog, key) {
            Some(old) => entry(key, old),
            None => 0
        }
    }
    int.saturating_add(int.saturating_sub(live, old_charge), entry(key, value))
}

fn stale_reads(tx: Tx, sh: Shape[u64, u64], ix: Index[u64, u64, u64], table_id: u32, index_id: u32) -> bool {
    let point = match fetch(tx, sh, 1) {
        Error(Stale(id)) => id == table_id,
        _ => false
    }
    let span = match range(tx, sh, Unbounded, Unbounded) {
        Error(Stale(id)) => id == table_id,
        _ => false
    }
    let index_read = match lookup(tx, ix, Unbounded, Unbounded) {
        Error(Stale(id)) => id == index_id,
        _ => false
    }
    point && span && index_read
}

// L16/I3: catalog liveness belongs to the roots read. Epoch changes alone do
// not invalidate readers; drop/recreate replaces the incarnation (ids1 ->4).
pub fn law_read_liveness(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    let mut old = result.unwrap(table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    let old_shape = shape(old)
    if !typed_put(mut db, old, 1, 10) {
        return false
    }
    result.unwrap(create_index(mut db, old, "bucket", code.describe(bucket), std.codec.key_u64()))
    let old_index = result.unwrap(index(db, mut old, "bucket", code.describe(bucket), std.codec.key_u64()))
    result.unwrap(create_index(mut db, old, "other", code.describe(quotient), std.codec.key_u64()))
    let before = snapshot(db)
    if result.unwrap(get(before, old_shape, 1)) != Some(10u64) {
        return false
    }
    let mut old_matches = result.unwrap(find(before, old_index, Included(2), Included(2)))
    if result.unwrap(next(mut old_matches)) != Some((1u64, 10u64)) {
        return false
    }
    result.unwrap(drop_table(mut db, take old))
    match get(snapshot(db), old_shape, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    result.unwrap(create_table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    let mut fresh = result.unwrap(table(mut db, "live", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_index(mut db, fresh, "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_index = result.unwrap(index(db, mut fresh, "bucket", code.describe(bucket), std.codec.key_u64()))
    let fresh_shape = shape(fresh)
    if fresh.id != 4 || fresh_index.id != 5 || !typed_put(mut db, fresh, 1, 20) {
        return false
    }
    let current = snapshot(db)
    match get(current, old_shape, 1) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match scan(current, old_shape, Unbounded, Unbounded) {
        Error(Stale(1)) => {},
        _ => return false
    }
    match find(current, old_index, Unbounded, Unbounded) {
        Error(Stale(2)) => {},
        _ => return false
    }
    let observed = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[bool, Error] {
        Ok(stale_reads(tx, old_shape, old_index, 1, 2))
    }))
    match take observed {
        Committed(done) => if !done.value || list.len(done.reads) != 0 {
            return false
        },
        _ => return false
    }
    let query = result.unwrap(look(current, fn(tx: Tx) -> bool {
        stale_reads(tx, old_shape, old_index, 1, 2)
    }))
    match take query {
        Seen(done) => if !done.value || list.len(done.reads) != 0 {
            return false
        },
        _ => return false
    }
    if result.unwrap(get(before, old_shape, 1)) != Some(10u64) {
        return false
    }
    let mut old_rows = result.unwrap(scan(before, old_shape, Unbounded, Unbounded))
    if result.unwrap(next(mut old_rows)) != Some((1u64, 10u64)) || result.unwrap(next(mut old_rows)) != None {
        return false
    }
    match get(before, fresh_shape, 1) {
        Error(Stale(4)) => {},
        _ => return false
    }
    match scan(before, fresh_shape, Unbounded, Unbounded) {
        Error(Stale(4)) => {},
        _ => return false
    }
    match find(before, fresh_index, Unbounded, Unbounded) {
        Error(Stale(5)) => {},
        _ => return false
    }
    let old_query = result.unwrap(look(before, fn(tx: Tx) -> bool {
        stale_reads(tx, fresh_shape, fresh_index, 4, 5)
    }))
    match take old_query {
        Seen(done) => done.value && list.len(done.reads) == 0,
        _ => false
    }
}

// L27(a): catalog142 + row94 =236 throughout; ceiling330 is one extra row.
// Wrong implementation: charge every overwrite without subtracting its old row.
pub fn law_overwrite_account(c: Clock) -> bool waits {
    let mut options = defaults()
    options.resident_limit = 330
    let mut db = memory_at(c, StoreId(hi: 1, lo: 2), options)
    result.unwrap(create_table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    let t = result.unwrap(table(mut db, "rows", std.codec.key_u64(), std.codec.of_u64()))
    if db.resident != 142 {
        return false
    }
    for step in 0u64 .. 100000 {
        if !typed_put(mut db, t, 1, step + 1) || db.resident != 236 {
            return false
        }
    }
    result.unwrap(get(snapshot(db), shape(t), 1)) == Some(100000u64)
}

// J1: same J rewrites only the primary key; changing J rewrites old+new index
// entries. Three indexes make these counts1 and7, independent of tree shape.
pub fn law_index_writes(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "writes", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "writes", std.codec.key_u64(), std.codec.of_u64()))
    for i in 0u64 .. 3 {
        let name = if i == 0 {
            "i0"
        } else if i == 1 {
            "i1"
        } else {
            "i2"
        }
        result.unwrap(create_index(mut db, t, name, code.describe(bucket), std.codec.key_u64()))
        let _ = result.unwrap(index(db, mut t, name, code.describe(bucket), std.codec.key_u64()))
    }
    if !typed_put(mut db, t, 1, 17) {
        return false
    }
    let same_j = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[u64, Error] {
        put(mut tx, t, 1, 21)?;
        Ok(std.omap.len(tx.ops))
    }))
    match take same_j {
        Committed(done) => if done.value != 1 {
            return false
        },
        _ => return false
    }
    let changed_j = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[u64, Error] {
        put(mut tx, t, 1, 22)?;
        Ok(std.omap.len(tx.ops))
    }))
    match take changed_j {
        Committed(done) => done.value == 7,
        _ => false
    }
}

@test
fn test_read_liveness(c: Clock) -> Result[(), ()] waits {
    if law_read_liveness(c) {
        Ok(())
    } else {
        Error(())
    }
}

@test
fn test_overwrite_account(c: Clock) -> Result[(), ()] waits {
    if law_overwrite_account(c) {
        Ok(())
    } else {
        Error(())
    }
}

@test
fn test_index_writes(c: Clock) -> Result[(), ()] waits {
    if law_index_writes(c) {
        Ok(())
    } else {
        Error(())
    }
}

fn read_set_hit(reads: List[Read], delta: List[Change]) -> bool {
    for change in delta {
        for read in reads {
            let hit = match read {
                Point(key) => key == change.tree_key,
                Span(low, high) => low <= change.tree_key && change.tree_key < high
            }
            if hit {
                return true
            }
        }
    }
    false
}

fn observe_lookup(s: Snapshot, ix: Index[u64, u64, u64], limit: u64) -> (List[u64], List[Read]) {
    let observed = result.unwrap(look(s, fn(tx: Tx) -> Result[List[u64], Error] {
        let mut rows = lookup(tx, ix, Included(1), Included(1))?
        let mut out: List[u64] = list.new()
        for _ in 0u64 .. limit {
            match next_indexed(mut rows)? {
                Some((k, v)) => {
                    capacity(result.capacity_only(list.push(mut out, k)))?
                    capacity(result.capacity_only(list.push(mut out, v)))?
                },
                None => break
            }
        }
        Ok(take out)
    }))
    match take observed {
        Seen(take done) => {
            let Seen(value: take result_value, version: _, reads: take reads) = take done
            (result.unwrap(take result_value), take reads)
        },
        _ => fail("L26 lookup observation failed")
    }
}

// J1's sharp witnesses: partial/zero/full iteration and equal J values.
// A value-only change, and delete+reput at that J, hit only the primary Point.
fn lookup_cover_points(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "cover", std.codec.key_u64(), std.codec.of_u64()))
    let mut t = result.unwrap(table(mut db, "cover", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_index(mut db, t, "i", code.describe(bucket), std.codec.key_u64()))
    let ix = result.unwrap(index(db, mut t, "i", code.describe(bucket), std.codec.key_u64()))
    for k in 1u64 .. 4 {
        if !typed_put(mut db, t, k, 4 * k - 3) {
            return false
        }
    }
    let a = snapshot(db)
    let first = observe_lookup(a, ix, 1)
    let (take values, take reads) = take first
    if list.len(values) != 2 || values[0] != 1 || values[1] != 1 || list.len(reads) != 2 {
        return false
    }
    let span = match reads[0] {
        Span(low, high) => low == result.unwrap(physical(2, key_word(1))) && high == result.unwrap(physical(2, key_word(2))),
        _ => false
    }
    let point = match reads[1] {
        Point(key) => key == result.unwrap(physical(1, key_word(1))),
        _ => false
    }
    if !span || !point {
        return false
    }
    // The unreturned row's value was not observed: no Point for key2.
    if !typed_put(mut db, t, 2, 9) {
        return false
    }
    let b = snapshot(db)
    let unreturned_delta = result.unwrap(changes(a, b))
    let untouched = observe_lookup(b, ix, 1)
    if read_set_hit(reads, unreturned_delta) || untouched.0 != values {
        return false
    }
    if !typed_put(mut db, t, 1, 5) {
        return false
    }
    let d = snapshot(db)
    let changed = result.unwrap(changes(b, d))
    let changed_answer = observe_lookup(d, ix, 1)
    if list.len(changed) != 1 || !read_set_hit(reads, changed) || changed_answer.0 == values {
        return false
    }
    let replaced = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        let _ = delete(mut tx, t, 1)?
        put(mut tx, t, 1, 13)
    }))
    match take replaced {
        Committed(_) => {},
        _ => return false
    }
    let e = snapshot(db)
    let replaced_delta = result.unwrap(changes(d, e))
    if list.len(replaced_delta) != 1 || !read_set_hit(changed_answer.1, replaced_delta) {
        return false
    }
    let zero = observe_lookup(e, ix, 0)
    if list.len(zero.0) != 0 || list.len(zero.1) != 1 {
        return false
    }
    let all = observe_lookup(e, ix, 8)
    let expected: Inline[u64, 6] =[1, 13, 2, 9, 3, 9]
    if list.len(all.0) != 6 || list.len(all.1) != 4 {
        return false
    }
    for i in 0u64 .. 6 {
        if all.0[i] != expected[i] {
            return false
        }
    }
    true
}

fn cover_push(mut out: List[u64], n: u64) -> Result[(), Error] {
    capacity(result.capacity_only(list.push(mut out, n)))
}

fn cover_observe(tx: Tx, a: Shape[u64, u64], b: Shape[u64, u64], ia: Index[u64, u64, u64], ib: Index[u64, u64, u64], plan: u64) -> Result[List[u64], Error] {
    let mut out: List[u64] = list.new()
    match fetch(tx, a, plan % 8)? {
        Some(v) => {
            cover_push(mut out, 1)?;
            cover_push(mut out, v)?
        },
        None => cover_push(mut out, 0)?
    }
    match fetch(tx, b, (plan >> 8) % 8)? {
        Some(v) => {
            cover_push(mut out, 1)?;
            cover_push(mut out, v)?
        },
        None => cover_push(mut out, 0)?
    }
    let lower = (plan >> 16) % 3
    let upper = (plan >> 24) % 3
    let lo: Bound[u64] = match lower {
        0 => Unbounded,
        1 => Included(2),
        _ => Excluded(2)
    }
    let hi: Bound[u64] = match upper {
        0 => Unbounded,
        1 => Included(6),
        _ => Excluded(6)
    }
    let mut left = range(tx, a, lo, hi)?
    while let Some((k, v)) = next(mut left)? {
        cover_push(mut out, k)?;
        cover_push(mut out, v)?
    }
    cover_push(mut out, 65535)?
    let mut right = range(tx, b, lo, hi)?
    while let Some((k, v)) = next(mut right)? {
        cover_push(mut out, k)?;
        cover_push(mut out, v)?
    }
    cover_push(mut out, 65534)?
    let j = (plan >> 32) % 4
    let limit = match (plan >> 40) % 4 {
        0 => 0u64,
        1 => 1u64,
        2 => 2u64,
        _ => 8u64
    }
    let mut left_index = lookup(tx, ia, Included(j), Included(j))?
    for _ in 0u64 .. limit {
        match next_indexed(mut left_index)? {
            Some((k, v)) => {
                cover_push(mut out, k)?;
                cover_push(mut out, v)?
            },
            None => break
        }
    }
    cover_push(mut out, 65533)?
    let mut right_index = lookup(tx, ib, Included(j), Included(j))?
    for _ in 0u64 .. limit {
        match next_indexed(mut right_index)? {
            Some((k, v)) => {
                cover_push(mut out, k)?;
                cover_push(mut out, v)?
            },
            None => break
        }
    }
    Ok(take out)
}

fn observe_cover(s: Snapshot, a: Shape[u64, u64], b: Shape[u64, u64], ia: Index[u64, u64, u64], ib: Index[u64, u64, u64], plan: u64) -> (List[u64], List[Read]) {
    let observed = result.unwrap(look(s, fn(tx: Tx) -> Result[List[u64], Error] {
        cover_observe(tx, a, b, ia, ib, plan)
    }))
    match take observed {
        Seen(take done) => {
            let Seen(value: take result_value, version: _, reads: take reads) = take done
            (result.unwrap(take result_value), take reads)
        },
        _ => fail("L26 observation failed")
    }
}

fn cover_write(mut tx: Tx, t: Table[u64, u64], key: u64, mode: u64, value: u64) -> Result[(), Error] {
    let old = match fetch(tx, shape(t), key)? {
        Some(v) => v,
        None => 100u64 + key
    }
    if mode == 0 {
        put(mut tx, t, key, old + 4)
    } else if mode == 1 {
        let _ = delete(mut tx, t, key)?;
        put(mut tx, t, key, old + 4)
    } else if mode == 2 {
        let _ = delete(mut tx, t, key)?;
        Ok(())
    } else {
        put(mut tx, t, key, value)
    }
}

// L26: re-execution is the oracle, exact vectors rather than a checksum. Two
// tables have equal keys and equal J buckets, but distinct physical prefixes.
pub fn law_read_cover(c: Clock) -> bool waits {
    if !lookup_cover_points(c) {
        return false
    }
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "left", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_table(mut db, "right", std.codec.key_u64(), std.codec.of_u64()))
    let mut a = result.unwrap(table(mut db, "left", std.codec.key_u64(), std.codec.of_u64()))
    let mut b = result.unwrap(table(mut db, "right", std.codec.key_u64(), std.codec.of_u64()))
    result.unwrap(create_index(mut db, a, "i", code.describe(bucket), std.codec.key_u64()))
    let ia = result.unwrap(index(db, mut a, "i", code.describe(bucket), std.codec.key_u64()))
    result.unwrap(create_index(mut db, b, "i", code.describe(bucket), std.codec.key_u64()))
    let ib = result.unwrap(index(db, mut b, "i", code.describe(bucket), std.codec.key_u64()))
    for k in 0u64 .. 8 {
        if !typed_put(mut db, a, k, 100 + k) || !typed_put(mut db, b, k, 200 + k) {
            return false
        }
    }
    let sa = shape(a)
    let sb = shape(b)
    let mut misses: u64 = 0
    let mut hits: u64 = 0
    for step in 0u64 .. 128 {
        let state = sm(step + 1031)
        let first = snapshot(db)
        let initial = observe_cover(first, sa, sb, ia, ib, state)
        let (take initial_value, take reads) = take initial
        let mutation = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
            if state & 1 == 0 {
                cover_write(mut tx, a, (state >> 8) % 8, (state >> 16) % 4, 300 + ((state >> 24) % 64))
            } else {
                cover_write(mut tx, b, (state >> 8) % 8, (state >> 16) % 4, 300 + ((state >> 24) % 64))
            }
        }))
        match take mutation {
            Committed(_) => {},
            _ => return false
        }
        let second = snapshot(db)
        let delta = result.unwrap(changes(first, second))
        let observed = observe_cover(second, sa, sb, ia, ib, state)
        if read_set_hit(reads, delta) {
            hits += 1
        } else {
            misses += 1
            if initial_value != observed.0 {
                return false
            }
        }
    }
    hits > 0 && misses > 0
}

@test
fn test_read_cover(c: Clock) -> Result[(), ()] waits {
    if law_read_cover(c) {
        Ok(())
    } else {
        Error(())
    }
}

type FrameRow {
    present: bool,
    op: u8,
    size: u64,
    key_size: u64
}

// L29(a): an independent slot history counts the fields in section2.4.
// An overwritten key has one final op; deleting an absent key adds none.
// Table keys have12 bytes; the index keys have20 and empty values.
pub fn law_frame_size(c: Clock) -> bool {
    let mut db = test_db(c, 1073741824)
    let budgeted = result.unwrap(bound bytes 80 {
        execute(mut db, 16, fn(mut tx: Tx) -> Result[u64, Error] {
            let _ = info(mut tx)
            Ok(19)
        })
    })
    match take budgeted {
        Ok(Committed(done)) => if done.value != 19 { return false },
        _ => return false
    }
    let outcome = result.unwrap(execute(mut db, 17, fn(mut tx: Tx) -> Result[bool, Error] {
        let mut model: List[FrameRow] = list.new()
        for slot in 0u64 .. 24 {
            let width = if slot < 12 { 12u64 } else { 20u64 }
            capacity(result.capacity_only(list.push(mut model, FrameRow(present: false, op: 0, size: 0, key_size: width))))?
        }
        for step in 0u64 .. 96 {
            let k = sm(step) % 24
            let id: u32 = if k < 12 { 1 } else { 2 }
            let mut key = key_word(k % 12)
            if id == 2 {
                capacity(list.append(mut key, key_word(k % 4)))?
            }
            if step % 5 == 0 {
                let removed = delete_bytes(mut tx, id, key)?
                if removed != model[k].present {
                    return Ok(false)
                }
                if removed {
                    model[k].present = false
                    model[k].op = 2
                    model[k].size = 0
                }
            } else {
                let size = if id == 2 { 0u64 } else { sm(step + 1) % 33 }
                let mut value: Bytes = capacity(list.with_capacity(size))?
                capacity(list.fill(mut value, size, int.truncate(step)))?
                put_bytes(mut tx, id, key, value)?
                model[k].present = true
                model[k].op = 1
                model[k].size = size
            }
            // head16 + branch4 + version8 + at8 + sections1 + data-tag1 + count4.
            let mut expected: u64 = 16 + 4 + 8 + 8 + 1 + 1 + 4
            for row in model {
                if row.op == 1 {
                    expected += 1 + 4 + row.key_size + 4 + row.size
                } else if row.op == 2 {
                    expected += 1 + 4 + row.key_size
                }
            }
            let ci = info(mut tx)
            let raw = capacity(encode_commit(ci, tx.ops, 1, 72))?
            if tx.frame_bytes != expected || list.len(raw) != expected || read_le(raw, 4, 4) != expected - 16 {
                return Ok(false)
            }
        }
        Ok(true)
    }))
    match take outcome {
        Committed(done) => done.value,
        _ => false
    }
}

@test
fn test_frame_size(c: Clock) -> Result[(), ()] {
    if law_frame_size(c) { Ok(()) } else { Error(()) }
}

fn frame_boundary(c: Clock, last: u64, accepted: bool) -> bool {
    let mut db = test_db(c, 1073741824)
    let result = result.unwrap(execute(mut db, 17, fn(mut tx: Tx) -> Result[u64, Error] {
        for k in 0u64 .. 16 {
            let size = if k == 15 { last } else { 1048576u64 }
            let mut value: Bytes = capacity(list.with_capacity(size))?
            capacity(list.fill(mut value, size, 0u8))?
            put_bytes(mut tx, 1, key_word(k), value)?
        }
        let ci = info(mut tx)
        let raw = capacity(encode_commit(ci, tx.ops, 1, 72))?
        // U1: payload26 +16*(op1+key-length4+key12+value-length4)
        // +15*1048576 +last; the frame also has its16-byte head.
        let expected = 16 + 26 + 16 * 21 + 15 * 1048576 + last
        if tx.frame_bytes != expected || list.len(raw) != expected || read_le(raw, 4, 4) != expected - 16 {
            fail("L29 frame size")
        }
        Ok(expected)
    }))
    match take result {
        Committed(done) => accepted && done.value == 15729018 + last && db.head == 1 && std.omap.len(db.roots.data) == 16,
        Aborted(Undone(value: Limit(Transaction), ticket: None)) => !accepted && db.head == 0 && std.omap.len(db.roots.data) == 0,
        _ => false
    }
}

// L29(b), U1's hand-derived payload cap-1, cap, and cap+1. The stored values
// include schema0's two zero bytes. No journal or frame allocation in execute.
pub fn law_frame_size_boundary(c: Clock) -> bool {
    frame_boundary(c, 1048277, true) && frame_boundary(c, 1048278, true) && frame_boundary(c, 1048279, false)
}

@test
fn frame_size_boundary(c: Clock) -> Result[(), ()] {
    if law_frame_size_boundary(c) { Ok(()) } else { Error(()) }
}

// T2: key12 rounds to16; schema0's value2+8 rounds to16, schema1's2+16
// rounds to24. Replacing the old stored row must therefore add exactly8.
// Subtracting a re-encode of the resolved old value would add nothing.
pub fn law_stored_size(c: Clock) -> bool waits {
    let mut db = test_db(c, 1073741824)
    result.unwrap(create_table(mut db, "sizes", std.codec.key_u64(), old_codec()))
    let old = result.unwrap(table(mut db, "sizes", std.codec.key_u64(), old_codec()))
    let first = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, old, 1, OldAccount(balance: 10))
    }))
    if let Committed(_) = first {} else { return false }
    let held = snapshot(db)
    let current = result.unwrap(table(mut db, "sizes", std.codec.key_u64(), new_codec()))
    let sh = shape(current)
    let before = db.resident
    let changed = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, current, 1, NewAccount(balance: 10, bonus: 7))
    }))
    if let Committed(_) = changed {} else { return false }
    if db.resident != before + 8 { return false }
    let second = result.unwrap(run(mut db, fn(mut tx: Tx) -> Result[(), Error] {
        put(mut tx, current, 1, NewAccount(balance: 11, bonus: 9))
    }))
    if let Committed(_) = second {} else { return false }
    let a = option.unwrap(result.unwrap(get(held, sh, 1)))
    let b = option.unwrap(result.unwrap(get(snapshot(db), sh, 1)))
    db.resident == before + 8 && a.balance == 10 && a.bonus == 7 && b.balance == 11 && b.bonus == 9
}

@test
fn test_stored_size(c: Clock) -> Result[(), ()] waits {
    if law_stored_size(c) { Ok(()) } else { Error(()) }
}

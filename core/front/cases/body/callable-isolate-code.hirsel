// FAIL-16: isolate refuses mutable transitive captures at its argument.
// expect: refuse FAIL-16 at 5:16
fn mut_capture()->u64 {
 let mut n:u64=0
 match isolate(scoped fn()->u64{n+=1;n}) { _ => 0 }
}
// A plain function is callable through isolate.
// expect: accept
fn plain_body()->u64 { match isolate(fn()->u64{7}) { _ => 0 } }
// A received scoped callback that is invoked by the body counts as mutable.
// expect: refuse FAIL-16 at 13:16
fn received(f:scoped fn()->u64)->u64 {
 match isolate(scoped fn()->u64{ let _ = f(); 0 }) { _ => 0 }
}
// PROG-9 accepts only a top-level non-generic function name and preserves the
// FunctionRef through the StaticFn value. The identity includes the full
// signature but excludes parameter names.
// expect: run describe_named() = 0
fn named()->u64 {7}
fn other()->u64 {7}
fn describe_named()->u64 {
 let s = code.describe(named)
 let _ = code.identity(s)
 let _ = code.identity(code.describe(other))
 0
}

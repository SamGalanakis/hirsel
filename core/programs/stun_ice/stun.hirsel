const COOKIE: u32 = 0x2112a442

const CRC_MASK: u32 = 0x5354554e

const HEADER: u64 = 20

const MAX_PACKET: u64 = HEADER + 65532

pub const CHANNEL_NUMBER: u16 = 0x000c

pub const LIFETIME: u16 = 0x000d

pub const XOR_PEER_ADDRESS: u16 = 0x0012

pub const DATA: u16 = 0x0013

pub const REALM: u16 = 0x0014

pub const NONCE: u16 = 0x0015

pub const XOR_RELAYED_ADDRESS: u16 = 0x0016

pub const REQUESTED_ADDRESS_FAMILY: u16 = 0x0017

pub const EVEN_PORT: u16 = 0x0018

pub const REQUESTED_TRANSPORT: u16 = 0x0019

pub const DONT_FRAGMENT: u16 = 0x001a

pub const MESSAGE_INTEGRITY_SHA256: u16 = 0x001c

pub const PASSWORD_ALGORITHM: u16 = 0x001d

pub const USERHASH: u16 = 0x001e

pub const RESERVATION_TOKEN: u16 = 0x0022

pub const ADDITIONAL_ADDRESS_FAMILY: u16 = 0x8000

pub const ADDRESS_ERROR_CODE: u16 = 0x8001

pub const PASSWORD_ALGORITHMS: u16 = 0x8002

pub const ICMP: u16 = 0x8004

pub const ALLOCATE: u16 = 0x0003

pub const REFRESH: u16 = 0x0004

pub const SEND: u16 = 0x0006

pub const DATA_METHOD: u16 = 0x0007

pub const CREATE_PERMISSION: u16 = 0x0008

pub const CHANNEL_BIND: u16 = 0x0009

pub type Transaction: key {
    high: u32,
    low: u64
}

pub type Class: key = Request | Indication | Success | Failure

pub type Role: key = Controlling | Controlled

pub type IceRole {
    role: Role,
    tie: u64
}

pub type Check {
    role: IceRole,
    priority: u32,
    nominate: bool
}

pub type Integrity: key = NoIntegrity | Sha1 | Sha256 | Both

pub type Error = BadHeader | UnsupportedMethod(u16) | BadAttribute(u16) | UnknownRequired(u16) | BadFingerprint | MissingIntegrity | BadIntegrity | BufferTooSmall(u64) | BadUsername | BadErrorCode | Mac(MacError)

pub type Range {
    lo: u64,
    hi: u64
}

pub type Message {
    class: Class,
    transaction: Transaction,
    username: Option[Range],
    mapped: Option[Addr],
    xor_mapped: bool,
    priority: Option[u32],
    role: Option[IceRole],
    nominate: bool,
    code: Option[u16],
    fingerprint: bool,
    integrity: Integrity
}

pub type Key = Short(Bytes) | Long(Secret)

pub type Attr {
    kind: u16,
    value: Range
}

pub type Header {
    method: u16,
    class: Class,
    transaction: Transaction,
    length: u16
}

pub opaque type Builder {
    transaction: Transaction,
    at: u64
}

type Scan {
    at: u64,
    tag_at: u64,
    integrity: Integrity,
    unknown: Option[u16]
}

fn mapped_address(packet: Bytes, at: u64, len: u64, tx: Transaction, xored: bool) -> Result[Addr, Error] {
    let kind: u16 = if xored {
        0x0020
    } else {
        0x0001
    }
    if len != 8 && len != 20 {
        return Error(BadAttribute(kind))
    }
    let port: u16 = list.word_be(packet, at + 2)
    let port_mask: u16 = if xored {
        0x2112
    } else {
        0
    }
    let ip = match packet[at + 1] {
        1 if len == 8 => {
            let word: u32 = list.word_be(packet, at + 4)
            V4(word ^ (if xored {
                COOKIE
            } else {
                0
            }))
        },
        2 if len == 20 => {
            let high: u64 = list.word_be(packet, at + 4)
            let low: u64 = list.word_be(packet, at + 12)
            let high_mask: u64 = if xored {
                list.word_be(packet, 4)
            } else {
                0
            }
            V6(high ^ high_mask, low ^ (if xored {
                tx.low
            } else {
                0
            }))
        },
        _ => {
            return Error(BadAttribute(kind))
        },
    }
    Ok(Addr(ip: ip, port: port ^ port_mask))
}

/// Parse the fixed header of one complete STUN message.
pub fn header(packet: Bytes) -> Result[Header, Error] {
    let end = list.len(packet)
    if end < HEADER {
        return Error(BadHeader)
    }
    let kind: u16 = list.word_be(packet, 0)
    let length: u16 = list.word_be(packet, 2)
    let cookie: u32 = list.word_be(packet, 4)
    if (kind & 0xc000) != 0 || (length & 3) != 0 || end != HEADER + int.widen(length) || cookie != COOKIE {
        return Error(BadHeader)
    }
    let class = match kind & 0x0110 {
        0 => Request,
        0x0010 => Indication,
        0x0100 => Success,
        _ => Failure,
    }
    let method = (kind & 0x000f) | ((kind & 0x00e0) >> 1) | ((kind & 0x3e00) >> 2)
    let tx = Transaction(high: list.word_be(packet, 8), low: list.word_be(packet, 12))
    Ok(Header(method: method, class: class, transaction: tx, length: length))
}

fn scan_start() -> Scan {
    Scan(at: HEADER, tag_at: 0, integrity: NoIntegrity, unknown: None)
}

fn required_known(kind: u16) -> bool {
    kind == 0x0001 || kind == 0x0006 || kind == 0x0009 || kind == 0x000a || kind == CHANNEL_NUMBER || kind == LIFETIME || kind == XOR_PEER_ADDRESS || kind == DATA || kind == REALM || kind == NONCE || kind == XOR_RELAYED_ADDRESS || kind == REQUESTED_ADDRESS_FAMILY || kind == EVEN_PORT || kind == REQUESTED_TRANSPORT || kind == DONT_FRAGMENT || kind == PASSWORD_ALGORITHM || kind == USERHASH || kind == 0x0020 || kind == RESERVATION_TOKEN || kind == 0x0024 || kind == 0x0025
}

fn next_attr(packet: Bytes, mut scan: Scan) -> Result[Attr, Error] {
    let at = scan.at
    let end = list.len(packet)
    let kind: u16 = list.word_be(packet, at)
    let len16: u16 = list.word_be(packet, at + 2)
    let len: u64 = int.widen(len16)
    let data = at + 4
    let next = data + padded(len)
    if next > end {
        return Error(BadAttribute(kind))
    }
    match kind {
        0x8028 => {
            if len != 4 || next != end {
                return Error(BadAttribute(kind))
            }
            let got: u32 = list.word_be(packet, data)
            if got != (std.crc32.update(0, packet, 0, at) ^ CRC_MASK) {
                return Error(BadFingerprint)
            }
        },
        _ if kind == MESSAGE_INTEGRITY_SHA256 => {
            if len != 32 || scan.integrity == Sha256 || scan.integrity == Both {
                return Error(BadAttribute(kind))
            }
            scan.tag_at = at
            scan.integrity = if scan.integrity == Sha1 {
                Both
            } else {
                Sha256
            }
        },
        _ => {
            if scan.integrity != NoIntegrity {
                return Error(BadAttribute(kind))
            }
            if kind == 0x0008 {
                if len != 20 {
                    return Error(BadAttribute(kind))
                }
                scan.tag_at = at
                scan.integrity = Sha1
            } else if kind < 0x8000 && !required_known(kind) {
                if let None = scan.unknown {
                    scan.unknown = Some(kind)
                }
            }
        },
    }
    scan.at = next
    Ok(Attr(kind: kind, value: Range(lo: data, hi: data + len)))
}

/// Append the attribute value ranges in wire order. A framing error leaves the preceding ranges appended.
/// UnknownRequired follows a complete scan. Keep the ranges to derive a key and authenticate with verify_key.
pub fn attrs(packet: Bytes, mut out: List[Attr]) -> Result[Integrity, Error] {
    let _ = header(packet)?
    let mut scan = scan_start()
    while scan.at < list.len(packet) {
        list.push(mut out, next_attr(packet, mut scan)?)
    }
    if let Some(kind) = scan.unknown {
        return Error(UnknownRequired(kind))
    }
    Ok(scan.integrity)
}

fn binding_header(packet: Bytes) -> Result[Header, Error] {
    let h = header(packet)?
    if h.method != 1 {
        return Error(UnsupportedMethod(list.word_be(packet, 0)))
    }
    Ok(h)
}

fn binding_fields(packet: Bytes, h: Header, mut scan: Scan) -> Result[Message, Error] {
    let mut msg = Message(class: h.class, transaction: h.transaction, username: None, mapped: None, xor_mapped: false, priority: None, role: None, nominate: false, code: None, fingerprint: false, integrity: NoIntegrity)
    while scan.at < list.len(packet) {
        let attr = next_attr(packet, mut scan)?
        if let Some(kind) = scan.unknown {
            return Error(UnknownRequired(kind))
        }
        let kind = attr.kind
        let data = attr.value.lo
        let len = attr.value.hi - data
        match kind {
            0x0006 => {
                if len > 763 || !valid_utf8(packet, data, len) {
                    return Error(BadAttribute(kind))
                }
                if let None = msg.username {
                    msg.username = Some(attr.value)
                }
            },
            _ if kind == 0x0001 || kind == 0x0020 => {
                if !msg.xor_mapped {
                    let addr = mapped_address(packet, data, len, h.transaction, kind == 0x0020)?
                    if kind == 0x0020 {
                        msg.mapped = Some(addr)
                        msg.xor_mapped = true
                    } else if let None = msg.mapped {
                        msg.mapped = Some(addr)
                    }
                }
            },
            0x0009 => {
                if len < 4 || len > 767 || !valid_utf8(packet, data + 4, len - 4) {
                    return Error(BadAttribute(kind))
                }
                let hundreds: u16 = int.widen(packet[data + 2] & 7)
                let number: u16 = int.widen(packet[data + 3])
                if hundreds < 3 || hundreds > 6 || number > 99 {
                    return Error(BadAttribute(kind))
                }
                if let None = msg.code {
                    msg.code = Some(100 * hundreds + number)
                }
            },
            0x0024 => {
                if len != 4 {
                    return Error(BadAttribute(kind))
                }
                if let None = msg.priority {
                    msg.priority = Some(list.word_be(packet, data))
                }
            },
            0x0025 => {
                if len != 0 {
                    return Error(BadAttribute(kind))
                }
                msg.nominate = true
            },
            _ if kind == 0x8029 || kind == 0x802a => {
                if len != 8 {
                    return Error(BadAttribute(kind))
                }
                let role = if kind == 0x802a {
                    Controlling
                } else {
                    Controlled
                }
                if let Some(old) = msg.role {
                    if old.role != role {
                        return Error(BadAttribute(kind))
                    }
                } else {
                    msg.role = Some(IceRole(role: role, tie: list.word_be(packet, data)))
                }
            },
            _ if kind == REALM || kind == NONCE => {
                if len > 763 || !valid_utf8(packet, data, len) {
                    return Error(BadAttribute(kind))
                }
            },
            _ if kind == USERHASH => {
                if len != 32 {
                    return Error(BadAttribute(kind))
                }
            },
            0x8028 => {
                msg.fingerprint = true
            },
            _ => (),
        }
    }
    msg.integrity = scan.integrity
    Ok(msg)
}

fn valid_utf8(packet: Bytes, at: u64, len: u64) -> bool {
    if let Ok(()) = std.utf8.validate(list.slice(packet, at, at + len)) {
        true
    } else {
        false
    }
}

/// Parse one Binding datagram and check any FINGERPRINT. Call verify before trusting authenticated fields.
/// The username range refers to packet; neither function retains the packet.
pub fn decode(packet: Bytes) -> Result[Message, Error] {
    let mut scan = scan_start()
    binding_fields(packet, binding_header(packet)?, mut scan)
}

/// Authenticate with the usage's prepared key. SHA-256 takes precedence when both tags are present.
/// SHA-1 needs 64 bytes of scratch plus the prefix before its attribute. Scratch is cleared after use.
pub fn verify(packet: Bytes, key: Bytes, mut scratch: Bytes) -> Result[Message, Error] {
    let mut scan = scan_start()
    let msg = binding_fields(packet, binding_header(packet)?, mut scan)?
    verify_tag(packet, scan, ShortView(view key), mut scratch)?
    Ok(msg)
}

/// Authenticate the strongest tag present after checking the message's attribute framing.
/// A well-framed unknown required attribute is covered by the tag like any other attribute.
pub fn verify_key(packet: Bytes, key: Key, mut scratch: Bytes) -> Result[Integrity, Error] {
    let _ = header(packet)?
    let mut scan = scan_start()
    while scan.at < list.len(packet) {
        let _ = next_attr(packet, mut scan)?
    }
    match key {
        Short(raw_key) => verify_tag(packet, scan, ShortView(view raw_key), mut scratch)?,
        Long(secret_key) => verify_tag(packet, scan, LongView(view secret_key), mut scratch)?,
    }
    Ok(scan.integrity)
}

fn padded(n: u64) -> u64 {
    (n + 3) & 0xfffffffffffffffc
}

fn trailer_size(integrity: Integrity, fingerprint: bool) -> u64 {
    (match integrity {
        NoIntegrity => 0u64,
        Sha1 => 24,
        Sha256 => 36,
        Both => 60,
    }) + (if fingerprint {
        8u64
    } else {
        0
    })
}

fn check_output(out: Bytes, end: u64) -> Result[(), Error] {
    if end > MAX_PACKET {
        return Error(BadHeader)
    }
    if list.len(out) < end {
        return Error(BufferTooSmall(end))
    }
    Ok(())
}

/// Begin a message in a caller buffer. Continue building in that same buffer.
pub fn start(method: u16, class: Class, tx: Transaction, mut out: Bytes) -> Result[Builder, Error] {
    if method > 0x0fff {
        return Error(BadHeader)
    }
    check_output(out, HEADER)?
    let class_bits: u16 = match class {
        Request => 0,
        Indication => 0x0010,
        Success => 0x0100,
        Failure => 0x0110,
    }
    let kind = (method & 0x000f) | ((method & 0x0070) << 1) | ((method & 0x0f80) << 2) | class_bits
    list.set_word_be(mut out, 0, kind)
    list.set_word_be(mut out, 2, 0u16)
    list.set_word_be(mut out, 4, COOKIE)
    list.set_word_be(mut out, 8, tx.high)
    list.set_word_be(mut out, 12, tx.low)
    Ok(Builder(transaction: tx, at: HEADER))
}

fn attribute(mut out: Bytes, at: u64, kind: u16, len: u16) {
    list.set_word_be(mut out, at, kind)
    list.set_word_be(mut out, at + 2, len)
}

fn reserve_attr(mut b: Builder, kind: u16, len: u64, mut out: Bytes) -> Result[u64, Error] {
    if len > 65535 || kind == 0x0008 || kind == MESSAGE_INTEGRITY_SHA256 || kind == 0x8028 {
        return Error(BadAttribute(kind))
    }
    let data = b.at + 4
    let end = data + padded(len)
    check_output(out, end)?
    attribute(mut out, b.at, kind, int.narrow(len))
    b.at = end
    Ok(data)
}

/// Append one attribute with zero padding. Add integrity and fingerprint with finish.
pub fn add(mut b: Builder, kind: u16, value: Bytes, mut out: Bytes) -> Result[(), Error] {
    let len = list.len(value)
    let data = reserve_attr(mut b, kind, len, mut out)?
    list.copy_from_slice(mut out, data, value)
    list.fill_slice(mut out, data + len, padded(len) - len, 0)
    Ok(())
}

pub fn add_xor_addr(mut b: Builder, kind: u16, a: Addr, mut out: Bytes) -> Result[(), Error] {
    let len: u64 = match a.ip {
        V4(_) => 8,
        V6(_, _) => 20,
    }
    let data = reserve_attr(mut b, kind, len, mut out)?
    out[data] = 0
    list.set_word_be(mut out, data + 2, a.port ^ 0x2112)
    match a.ip {
        V4(ip) => {
            out[data + 1] = 1
            list.set_word_be(mut out, data + 4, ip ^ COOKIE)
        },
        V6(hi, lo) => {
            out[data + 1] = 2
            let cookie: u64 = int.widen(COOKIE)
            let mask = (cookie << 32) | int.widen(b.transaction.high)
            list.set_word_be(mut out, data + 4, hi ^ mask)
            list.set_word_be(mut out, data + 12, lo ^ b.transaction.low)
        },
    }
    Ok(())
}

pub fn add_error(mut b: Builder, code: u16, mut out: Bytes) -> Result[(), Error] {
    if code < 300 || code > 699 {
        return Error(BadErrorCode)
    }
    let data = reserve_attr(mut b, 0x0009, 4, mut out)?
    let encoded: u32 = int.widen(((code / 100) << 8) | (code % 100))
    list.set_word_be(mut out, data, encoded)
    Ok(())
}

fn finish_size(at: u64, integrity: Integrity, fingerprint: bool, long: bool, out: Bytes, scratch: Bytes) -> Result[u64, Error] {
    let end = at + trailer_size(integrity, fingerprint)
    check_output(out, end)?
    let need = if long {
        match integrity {
            NoIntegrity => 0u64,
            Both => at + 24,
            _ => at,
        }
    } else if integrity == Sha1 || integrity == Both {
        at + 64
    } else {
        0
    }
    if list.len(scratch) < need {
        return Error(BufferTooSmall(need))
    }
    Ok(end)
}

fn finish_packet(at: u64, end: u64, integrity: Integrity, key: KeyView, fingerprint: bool, mut out: Bytes, mut scratch: Bytes) -> Result[u64, Error] {
    let length: u16 = int.narrow(end - HEADER)
    list.set_word_be(mut out, 2, length)
    let mut next = at
    if integrity == Sha1 || integrity == Both {
        let tag = sign_sha1(key, out, next, mut scratch)?
        attribute(mut out, next, 0x0008, 20)
        for i in 0u64 .. 20 {
            out[next + 4 + i] = tag[i]
        }
        next += 24
    }
    if integrity == Sha256 || integrity == Both {
        let tag = sign_sha256(key, out, next, mut scratch)?
        attribute(mut out, next, MESSAGE_INTEGRITY_SHA256, 32)
        for i in 0u64 .. 32 {
            out[next + 4 + i] = tag[i]
        }
        next += 36
    }
    if fingerprint {
        let crc = std.crc32.update(0, out, 0, next) ^ CRC_MASK
        attribute(mut out, next, 0x8028, 4)
        list.set_word_be(mut out, next + 4, crc)
    }
    Ok(end)
}

pub fn finish(take b: Builder, integrity: Integrity, key: Key, fingerprint: bool, mut out: Bytes, mut scratch: Bytes) -> Result[u64, Error] {
    match key {
        Short(raw_key) => {
            let end = finish_size(b.at, integrity, fingerprint, false, out, scratch)?
            finish_packet(b.at, end, integrity, ShortView(view raw_key), fingerprint, mut out, mut scratch)
        },
        Long(secret_key) => {
            let end = finish_size(b.at, integrity, fingerprint, true, out, scratch)?
            finish_packet(b.at, end, integrity, LongView(view secret_key), fingerprint, mut out, mut scratch)
        },
    }
}

fn add_check(mut b: Builder, check: Check, mut out: Bytes) -> Result[(), Error] {
    let priority = reserve_attr(mut b, 0x0024, 4, mut out)?
    list.set_word_be(mut out, priority, check.priority)
    let kind: u16 = if check.role.role == Controlling {
        0x802a
    } else {
        0x8029
    }
    let tie = reserve_attr(mut b, kind, 8, mut out)?
    list.set_word_be(mut out, tie, check.role.tie)
    if check.nominate {
        add(mut b, 0x0025, b"", mut out)?
    }
    Ok(())
}

/// Write a Binding request to a caller buffer. Return the number of bytes written.
/// An empty username omits USERNAME. Omit check for plain STUN or an RFC 7675 consent request.
pub fn binding_request(tx: Transaction, username: Bytes, check: Option[Check], integrity: Integrity, fingerprint: bool, key: Bytes, mut out: Bytes, mut scratch: Bytes) -> Result[u64, Error] {
    let n = list.len(username)
    if n > 508 || !valid_utf8(username, 0, n) {
        return Error(BadUsername)
    }
    let mut at = HEADER
    if n != 0 {
        at += 4 + padded(n)
    }
    if let Some(c) = check {
        at += if c.nominate {
            24
        } else {
            20
        }
    }
    let end = finish_size(at, integrity, fingerprint, false, out, scratch)?
    let mut b = start(1, Request, tx, mut out)?
    if n != 0 {
        add(mut b, 0x0006, username, mut out)?
    }
    if let Some(c) = check {
        add_check(mut b, c, mut out)?
    }
    finish_packet(b.at, end, integrity, ShortView(view key), fingerprint, mut out, mut scratch)
}

/// Write a Binding success with the source transport address in XOR-MAPPED-ADDRESS.
pub fn binding_success(tx: Transaction, mapped: Addr, integrity: Integrity, fingerprint: bool, key: Bytes, mut out: Bytes, mut scratch: Bytes) -> Result[u64, Error] {
    let at = HEADER + match mapped.ip {
        V4(_) => 12u64,
        V6(_, _) => 24u64
    }
    let end = finish_size(at, integrity, fingerprint, false, out, scratch)?
    let mut b = start(1, Success, tx, mut out)?
    add_xor_addr(mut b, 0x0020, mapped, mut out)?
    finish_packet(b.at, end, integrity, ShortView(view key), fingerprint, mut out, mut scratch)
}

/// Write a Binding error with an empty diagnostic phrase.
pub fn binding_error(tx: Transaction, code: u16, integrity: Integrity, fingerprint: bool, key: Bytes, mut out: Bytes, mut scratch: Bytes) -> Result[u64, Error] {
    if code < 300 || code > 699 {
        return Error(BadErrorCode)
    }
    let end = finish_size(28, integrity, fingerprint, false, out, scratch)?
    let mut b = start(1, Failure, tx, mut out)?
    add_error(mut b, code, mut out)?
    finish_packet(b.at, end, integrity, ShortView(view key), fingerprint, mut out, mut scratch)
}

fn same_address(a: Addr, b: Addr) -> bool {
    if a.port != b.port {
        return false
    }
    match (a.ip, b.ip) {
        (V4(x), V4(y)) => x == y,
        (V6(xh, xl), V6(yh, yl)) => xh == yh && xl == yl,
        _ => false,
    }
}

// Contract tests for `list` (core/std/list.hirsel), written to run once an engine runs
// library bodies. Each test returns a scalar; the line `// expect: run f() = R` above it
// gives the result derived by hand from the contract, or `fail Cause` for the failure the
// contract names. Lists are read back as numbers, one decimal digit per element.
/// [a, b, c, d, e] in capacity reserved first.
fn five(a: u64, b: u64, c: u64, d: u64, e: u64) -> List[u64] {
    let mut xs: List[u64] = result.unwrap(list.with_capacity(5))
    result.unwrap(list.push(mut xs, a))
    result.unwrap(list.push(mut xs, b))
    result.unwrap(list.push(mut xs, c))
    result.unwrap(list.push(mut xs, d))
    result.unwrap(list.push(mut xs, e))
    xs
}

/// The elements as the digits of one number, first element first: [3, 1, 2] is 312.
fn digits(xs: List[u64]) -> u64 {
    let mut v: u64 = 0
    for x in xs {
        v = v * 10 + x
    }
    v
}

fn present(o: Option[View[u64]]) -> u64 {
    match o {
        Some(v) => v,
        None => 99,
    }
}

// expect: run first_of_five() = 7
fn first_of_five() -> u64 {
    let xs = five(7, 1, 2, 3, 4)
    present(list.first(xs))
}

// expect: run first_of_empty() = 99
fn first_of_empty() -> u64 {
    let xs: List[u64] = list.new()
    present(list.first(xs))
}

// expect: run last_of_five() = 4
fn last_of_five() -> u64 {
    let xs = five(7, 1, 2, 3, 4)
    present(list.last(xs))
}

// expect: run last_of_empty() = 99
fn last_of_empty() -> u64 {
    let xs: List[u64] = list.new()
    present(list.last(xs))
}

// Removes 6 and keeps the order of the rest: 6, then 5789.
// expect: run remove_keeps_order() = 65789
fn remove_keeps_order() -> u64 {
    let mut xs = five(5, 6, 7, 8, 9)
    let r = list.remove(mut xs, 1)
    r * 10000 + digits(xs)
}

// expect: run remove_last() = 95678
fn remove_last() -> u64 {
    let mut xs = five(5, 6, 7, 8, 9)
    let r = list.remove(mut xs, 4)
    r * 10000 + digits(xs)
}

// expect: run remove_past_end() = fail Bounds
fn remove_past_end() -> u64 {
    let mut xs = five(5, 6, 7, 8, 9)
    list.remove(mut xs, 5)
}

// expect: run insert_middle() = 129345
fn insert_middle() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    result.unwrap(list.insert(mut xs, 2, 9))
    digits(xs)
}

// Inserting at len appends.
// expect: run insert_at_len() = 123459
fn insert_at_len() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    result.unwrap(list.insert(mut xs, 5, 9))
    digits(xs)
}

// expect: run insert_at_front() = 912345
fn insert_at_front() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    result.unwrap(list.insert(mut xs, 0, 9))
    digits(xs)
}

// expect: run insert_past_len() = fail Bounds
fn insert_past_len() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    result.unwrap(list.insert(mut xs, 6, 9))
    digits(xs)
}

// Removes 2 and moves the last element, 5, into its place.
// expect: run swap_remove_middle() = 21534
fn swap_remove_middle() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    let r = list.swap_remove(mut xs, 1)
    r * 10000 + digits(xs)
}

// expect: run swap_remove_last() = 51234
fn swap_remove_last() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    let r = list.swap_remove(mut xs, 4)
    r * 10000 + digits(xs)
}

// expect: run swap_remove_past_end() = fail Bounds
fn swap_remove_past_end() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap_remove(mut xs, 5)
}

// expect: run swap_ends() = 52341
fn swap_ends() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 0, 4)
    digits(xs)
}

// expect: run swap_reversed_indexes() = 14325
fn swap_reversed_indexes() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 3, 1)
    digits(xs)
}

// expect: run swap_with_itself() = 12345
fn swap_with_itself() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 2, 2)
    digits(xs)
}

// expect: run swap_past_end() = fail Bounds
fn swap_past_end() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.swap(mut xs, 0, 5)
    digits(xs)
}

// expect: run truncate_shorter() = 12
fn truncate_shorter() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.truncate(mut xs, 2)
    digits(xs)
}

// expect: run truncate_longer() = 12345
fn truncate_longer() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.truncate(mut xs, 9)
    digits(xs)
}

// expect: run truncate_to_zero() = 0
fn truncate_to_zero() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.truncate(mut xs, 0)
    list.len(xs)
}

// expect: run reverse_odd() = 54321
fn reverse_odd() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.reverse(mut xs)
    digits(xs)
}

// expect: run reverse_even() = 4321
fn reverse_even() -> u64 {
    let mut xs = five(1, 2, 3, 4, 5)
    list.truncate(mut xs, 4)
    list.reverse(mut xs)
    digits(xs)
}

// expect: run sort_ascending() = 11345
fn sort_ascending() -> u64 {
    let mut xs = five(3, 1, 4, 1, 5)
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    digits(xs)
}

// expect: run sort_descending() = 54311
fn sort_descending() -> u64 {
    let mut xs = five(3, 1, 4, 1, 5)
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(b, a)
    })
    digits(xs)
}

// Past 16 elements the quicksort partitions: (7i) % 20 for i in 0..20 is a permutation of
// 0..20 (7 and 20 are coprime), so sorted, element i is i at all 20 positions.
// expect: run sort_permutation_of_twenty() = 20
fn sort_permutation_of_twenty() -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 20 {
        result.unwrap(list.push(mut xs, (7 * i) % 20))
    }
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    let mut placed: u64 = 0
    for i in 0u64 .. 20 {
        if xs[i] == i {
            placed += 1
        }
    }
    placed
}

// Thirty elements i % 3: sorted, ten 0s, ten 1s and ten 2s, so element i is i / 10.
// expect: run sort_many_equal() = 30
fn sort_many_equal() -> u64 {
    let mut xs: List[u64] = list.new()
    for i in 0u64 .. 30 {
        result.unwrap(list.push(mut xs, i % 3))
    }
    list.sort(mut xs, fn(a: u64, b: u64) -> Order {
        order.compare(a, b)
    })
    let mut placed: u64 = 0
    for i in 0u64 .. 30 {
        if xs[i] == i / 10 {
            placed += 1
        }
    }
    placed
}

// 'a' + 'b' + 'c' = 97 + 98 + 99.
// expect: run sum_bytes_of_text() = 294
fn sum_bytes_of_text() -> u64 {
    list.sum_bytes(string.as_bytes("abc"))
}

// 300 bytes of 255 sum past u8 and u16 without overflow: 300 x 255.
// expect: run sum_bytes_wide() = 76500
fn sum_bytes_wide() -> u64 {
    let mut b: Bytes = list.new()
    result.unwrap(list.fill(mut b, 300, 255))
    list.sum_bytes(b)
}

// Core operations with bodies (core/core/list.hirsel), against core.md.
// fill appends n copies after the existing elements and grows once to at least len + n.
// expect: run fill_appends() = 1777
fn fill_appends() -> u64 {
    let mut xs: List[u64] = list.new()
    result.unwrap(list.push(mut xs, 1))
    result.unwrap(list.fill(mut xs, 3, 7))
    if list.capacity(xs) < 4 {
        return 99
    }
    digits(xs)
}

// Under `bound bytes 0` the growth is refused and xs is unchanged.
// expect: run fill_under_bound() = 0
fn fill_under_bound() -> u64 {
    let mut xs: List[u64] = list.new()
    let r = bound bytes 0 {
        list.fill(mut xs, 3, 7)
    }
    match r {
        Ok(Error(_)) => list.len(xs),
        _ => 99,
    }
}

// expect: run sum_empty() = 0
fn sum_empty() -> u64 {
    let xs: List[u64] = list.new()
    list.sum(xs)
}

// 250 + 5 is u8's maximum, 255.
// expect: run sum_to_max() = 255
fn sum_to_max() -> u8 {
    let mut xs: List[u8] = list.new()
    result.unwrap(list.push(mut xs, 250))
    result.unwrap(list.push(mut xs, 5))
    list.sum(xs)
}

// 250 + 6 does not fit u8.
// expect: run sum_overflow() = fail Overflow
fn sum_overflow() -> u8 {
    let mut xs: List[u8] = list.new()
    result.unwrap(list.push(mut xs, 250))
    result.unwrap(list.push(mut xs, 6))
    list.sum(xs)
}

// Signed: -128 + 127 + -1 = -2, every partial sum within i8.
// expect: run sum_signed() = -2
fn sum_signed() -> i8 {
    let mut xs: List[i8] = list.new()
    result.unwrap(list.push(mut xs, -128))
    result.unwrap(list.push(mut xs, 127))
    result.unwrap(list.push(mut xs, -1))
    list.sum(xs)
}

// expect: run contains_cases() = true
fn contains_cases() -> bool {
    let xs = five(1, 2, 3, 2, 1)
    let empty: List[u64] = list.new()
    list.contains(xs, 2) && !list.contains(xs, 4) && !list.contains(empty, 1)
}

// Search returns the first equal and exact insertion positions.
// expect: run search_positions() = 1305
fn search_positions() -> u64 {
    let xs = five(1, 2, 2, 4, 5)
    let a = result.unwrap(list.binary_search(xs, 2))
    let b = match list.binary_search(xs, 3) { Error(i) => i, _ => 99 }
    let c = match list.binary_search(xs, 0) { Error(i) => i, _ => 99 }
    let d = match list.binary_search(xs, 6) { Error(i) => i, _ => 99 }
    a * 1000 + b * 100 + c * 10 + d
}

// [1,1,2,2,1] -> [1,2,1], not globally unique and not reordered.
// expect: run dedup_runs() = 121
fn dedup_runs() -> u64 {
    let mut xs = five(1, 1, 2, 2, 1)
    list.dedup(mut xs)
    digits(xs)
}

// expect: run dedup_empty_singleton() = 7
fn dedup_empty_singleton() -> u64 {
    let mut xs: List[u64] = list.new()
    list.dedup(mut xs)
    result.unwrap(list.push(mut xs, 7))
    list.dedup(mut xs)
    digits(xs)
}

// expect: run extend_copies() = 12345
fn extend_copies() -> u64 {
    let mut xs: List[u64] = list.new()
    let ys = five(1, 2, 3, 4, 5)
    result.unwrap(list.extend(mut xs, ys))
    if digits(ys) != 12345 { return 99 }
    digits(xs)
}

// expect: run extend_capacity() = 0
fn extend_capacity() -> u64 {
    let mut xs: List[u64] = list.new()
    let ys = five(6, 7, 8, 9, 0)
    let r = bound bytes 0 { list.extend(mut xs, ys) }
    match r { Ok(Error(_)) => list.len(xs), _ => 99 }
}

fn by_tens(a: u64, b: u64) -> Order { order.compare(a / 10, b / 10) }

// Original equal-key groups: 2 -> [21,22,23], 1 -> [11,12].
// Taking the right run on Equal changes [11,12,21,22,23].
// expect: run stable_equal_keys() = true
fn stable_equal_keys() -> bool {
    let mut xs = five(21, 11, 22, 12, 23)
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { order.compare(a / 10, b / 10) }))
    xs[0] == 11 && xs[1] == 12 && xs[2] == 21 && xs[3] == 22 && xs[4] == 23
}

// expect: run stable_empty_singleton() = 7
fn stable_empty_singleton() -> u64 {
    let mut xs: List[u64] = list.new()
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { order.compare(a / 10, b / 10) }))
    result.unwrap(list.push(mut xs, 7))
    result.unwrap(list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { order.compare(a / 10, b / 10) }))
    digits(xs)
}

// expect: run stable_capacity_unchanged() = 54321
fn stable_capacity_unchanged() -> u64 {
    let mut xs = five(5, 4, 3, 2, 1)
    let r = bound bytes 0 { list.sort_stable(mut xs, fn(a: u64, b: u64) -> Order { order.compare(a, b) }) }
    match r { Ok(Error(_)) => digits(xs), _ => 99 }
}

// Four accumulators and all tail lengths. 0 + 1 + ... + 6 = 21.
// expect: run sum_bytes_tails() = 21
fn sum_bytes_tails() -> u64 {
    let mut xs: Bytes = list.new()
    for i in 0u8 .. 7 { result.unwrap(list.push(mut xs, i)) }
    list.sum_bytes(list.slice(xs, 0, 4)) + list.sum_bytes(list.slice(xs, 4, 7))
}

// Owned elements remain a permutation and ties keep their original order.
// expect: run stable_owned_strings() = true
fn stable_owned_strings() -> bool {
    let mut xs: List[String] = list.new()
    result.unwrap(list.push(mut xs, result.unwrap(string.from("bb"))))
    result.unwrap(list.push(mut xs, result.unwrap(string.from("a"))))
    result.unwrap(list.push(mut xs, result.unwrap(string.from("cc"))))
    result.unwrap(list.sort_stable(mut xs, fn(a: String, b: String) -> Order {
        order.compare(list.len(string.as_bytes(a)), list.len(string.as_bytes(b)))
    }))
    xs[0] == "a" && xs[1] == "bb" && xs[2] == "cc"
}

// All four accumulator tails, including empty input.
// expect: run sum_bytes_tail_lengths() = true
fn sum_bytes_tail_lengths() -> bool {
    let mut xs: Bytes = list.new()
    result.unwrap(list.fill(mut xs, 7, 255))
    let mut n: u64 = 0
    while n <= 7 {
        if list.sum_bytes(list.slice(xs, 0, n)) != 255 * n { return false }
        n += 1
    }
    true
}

// The collection map is Memory metadata. The span's single attempt
// crosses those entries and charges the Tiered data reached beneath them.
fn tiered_span_row(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], data: pages.PageTree, low: Bytes, high: Bytes) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    if high <= low {
        return Ok(None)
    }
    let beginning = list.slice(low, 0, order.min(4, list.len(low)))
    let mut collections = std.page.cursor_open(data.root, Some(failure_result_from_rep(types.copied(beginning))?), true, false)
    let no_prefix: Bytes = list.new()
    while let Some((take id, _)) = std.page.cursor_next_key(mut collections, no_prefix) {
        if id >= high {
            break
        }
        let collection: u32 = list.word_be(id, 0)
        let collection_end = failure_result_from_rep(catalog.prefix(collection + 1))?
        let from = if low <= id {
            view id
        } else {
            view low
        }
        let until = if list.len(high) > 4 && high < collection_end {
            view high
        } else {
            view collection_end
        }
        let (edge, descriptor) = option.unwrap(std.page.collection_slot(data.root, id))
        if let Some(take row) = tiered_span_collection(attempt, visible, data, edge, descriptor, collection, from, until)? {
            return Ok(Some(take row))
        }
    }
    Ok(None)
}

fn tiered_span_collection(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], data: pages.PageTree, edge: std.page.Slot, descriptor: Bytes, collection: u32, low: Bytes, high: Bytes) -> Result[Option[(Bytes, Arc[Bytes])], Error] {
    if low >= high {
        return Ok(None)
    }
    if pages.collection_descriptor(descriptor).residency == ResidentMemory {
        let mut cursor = byte_cursor(data, Included(failure_result_from_rep(types.copied(low))?), high)?
        return failure_result_from_rep(catalog.next_bytes(mut cursor))
    }
    let (take start, take stop) = tiered_scan_bounds(descriptor, collection, failure_result_from_rep(types.copied(low))?, failure_result_from_rep(types.copied(high))?)?
    if start >= stop {
        return Ok(None)
    }
    let overlay = match data.replay {
        Some(replay) => std.omap.get(replay.collections, collection),
        None => None,
    }
    tiered_seek(attempt, SeekKey(failure_result_from_rep(types.copied(list.slice(start, 4, list.len(start))))?))
    let found = tiered_scan_row(attempt, visible, edge, collection, overlay, start, stop, false)?
    tiered_seek(attempt, SeekOperation)
    Ok(take found)
}

fn snapshot_tiered_span_step(r: Reader, s: Snapshot, inventory: pages.TieredReadInventory, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] waits {
    let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
    snapshot_tiered_span_step_with(PagerTask(channel.sender(source.pager)), source.packs, source.next_stamp, source.deadline, take grant, root, s, low, high, previous)
}

fn snapshot_tiered_span_step_direct(d: Dir, owner: StoreId, pin_bytes: u64, s: Snapshot, inventory: pages.TieredReadInventory, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] waits {
    let grant = disk_allocation(scoped fn() -> Result[Arc[TieredReaderGrant], Error] {
        Ok(arc.new(TieredReaderGrant(store: owner, opened: s.open, pin_bytes: pin_bytes)))
    })?
    let root = TieredPinRoot(domain: s.open, branch: s.branch, generation: inventory.generation, root_stamp: pages.tree_stamp(s.roots.collections))
    snapshot_tiered_span_step_with(PagerDirect(d, owner), std.omap.snapshot(inventory.packs), inventory.next_stamp, 0, take grant, root, s, low, high, previous)
}

fn snapshot_tiered_span_step_with(take backend: TieredPageBackend, packs: std.omap.OMap[u64, pages.TieredPagerPack], next_stamp: u64, deadline: u64, grant: Arc[TieredReaderGrant], root: TieredPinRoot, s: Snapshot, low: Bytes, high: Bytes, previous: Option[Bytes]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] waits {
    let beginning = disk_allocation(scoped fn() -> Result[Bytes, Error] {
        match previous {
            Some(last_key) => scan_page_after(last_key),
            None => failure_result_from_rep(types.copied(low)),
        }
    })?
    let empty_hint: Bytes = list.new()
    retry_tiered_read_with(take backend, packs, next_stamp, deadline, grant, root, empty_hint, None, TieredForward, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]]) -> Result[Option[(Bytes, Arc[Bytes], Bytes)], Error] {
        let Some((take key, take value)) = tiered_span_row(attempt, visible, s.roots.collections, beginning, high)? else {
            return Ok(None)
        }
        let resume = failure_result_from_rep(types.copied(key))?
        Ok(Some((take key, take value, take resume)))
    })
}

fn snapshot_tiered_span(r: Reader, s: Snapshot, inventory: pages.TieredReadInventory, low: Bytes, high: Bytes) -> Result[List[Change], Error] waits {
    let (take source, take grant, root) = snapshot_pager(r, s, inventory)?
    let empty_hint: Bytes = list.new()
    retry_tiered_read(source, grant, root, empty_hint, None, TieredForward, scoped fn(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]]) -> Result[List[Change], Error] {
        let mut out: List[Change] = list.new()
        let mut start = failure_result_from_rep(types.copied(low))?
        while let Some((take key, take value)) = tiered_span_row(attempt, visible, s.roots.collections, start, high)? {
            start = scan_page_after(key)?
            list.push(mut out, Change(tree_key: take key, value: Some(take value)))
        }
        Ok(take out)
    })
}

// L88 (c), Hot slots: an empty table becomes Tiered, and 160 rows are put
// before any cut, so main's leaves H and root G₁ are Hot. Capture S′. Cut 1
// seals them, and main's image of each leaf is the sealed one, while S′
// keeps its Hot images. Main overwrites a row of the second leaf, so its
// root G₂ still names the first leaf's sealed location. pin(S′) finds each
// Hot leaf's stamp in main and takes the sealed location; G₁ and the
// overwritten leaf are not found and T2 emits them. Seeded bug
// `hot_promote_twice` (Hot slots skip the lookup): T2 emits S′'s first leaf
// again under its stamp, which main already reaches at its sealed place.
fn gate_l88_hot_slots(d: Dir, c: Clock, r: Random, tasks: Tasks, crash: GateCrash) -> Result[(), Error] waits {
    let floor = 182375272u64
    let options = gate_l88_options(floor)?
    let mut db = open(tasks, d, c, r, options)?
    let _ = law_table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    let rows = table(mut db, "rows", std.codec.key_u64(), std.codec.of_bytes())?
    set_residency(mut db, rows.id, Tiered)?
    let fixture: Table[u64, Bytes] = clone(rows)
    let Committed(_) = run(mut db, Some(100000000), copy_env(fixture), fn(mut tx: Tx, env: Table[u64, Bytes]) -> Result[(), Error] {
        for key in 0u64 .. 160 {
            put(mut tx, env, key, compact_value_of(key, 0, 48))?
        }
        Ok(())
    })? else {
        fail("L88 (c): the puts commit")
    }
    let s = snapshot(db)
    match std.page.collection_slot(s.roots.collections.root, failure_result_from_rep(catalog.prefix(rows.id))?) {
        Some((HotPage(_), _)) => (),
        _ => fail("L88 (c): puts before any cut leave the captured Tiered root Hot"),
    }
    let _ = checkpoint(mut db)?
    let (_, leaves) = gate_leaves(d, db, 0, rows.id)?
    let edited = leaves[1u64].first
    gate_put(mut db, rows, edited, 1)?
    let pinned_db = gate_pin_cut(d, c, r, tasks, options, take db, "s", take s, crash)?
    let _ = gate_walk_all(d, pinned_db, rows.id)?
    let mut head_edits: Map[u64, u8] = map.new()
    map.insert(mut head_edits, edited, 1u8)
    gate_l88_reads(pinned_db, "s", rows, head_edits, map.new(), map.new(), gate_pin_kept(crash))?
    close(take pinned_db)?
    let reopened = open(tasks, d, c, r, options)?
    let _ = gate_walk_all(d, reopened, rows.id)?
    gate_l88_reads(reopened, "s", rows, head_edits, map.new(), map.new(), gate_pin_kept(crash))?
    close(take reopened)
}


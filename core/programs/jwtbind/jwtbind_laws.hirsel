// T_MAX_SUB sub "a" × 64; T_OTHER_ISS iss "https://other.example"; T_OTHER_AUD aud "place-b";
// T_TYP_JWT header typ "JWT"; T_TYP_AT header typ "at+jwt"; T_K2 kid k2, signed by k2;
// T_HUGE_EXP exp 18446744073709551; T_BAD_SIG is T_BASE's header and payload with T_LATER's
// signature.

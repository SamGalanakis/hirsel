[Unit]
Description=Record a Hirsel nightly board failure

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/hirsel-board/main/tools/board-freshness.py --base %h/.local/share/hirsel-board --service-failure /workspace/code/hirsel-briefs/archive/followups-to-2026-11-28.md --current /workspace/code/hirsel-briefs/CURRENT-BOARD.md

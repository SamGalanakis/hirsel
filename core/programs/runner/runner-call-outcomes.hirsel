pub fn wake_report_main(a: Args, process: Process, err: Stderr, d: Dir, c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), Exit] waits {
    let run = scoped fn(take stop: Receiver[()]) -> Result[runner.Ended, runner.MainError] waits {
        match args.get(a, 0u64) {
            Some(mode) if mode == "clean" => {
                let settings = managed_settings(d, c, r, tasks, n, Addr(ip: V4(0x7f000001u32), port: 0u16), runner.Stop(lag_ms: 0u64, grace_ms: 1000u64))
                let ended = runner.operate(take settings, take stop, result.unwrap(runner.status_root()), None) ?=> Start
                Ok(ended)
            },
            Some(mode) if mode == "due" => Ok(Stopped(Some(123456u64))),
            Some(mode) if mode == "forced" => Ok(Forced(2u64)),
            Some(mode) if mode == "unstarted" => Ok(Unstarted),
            Some(mode) if mode == "error" => Error(Start(Missing("test"))),
            _ => Error(Usage(Exit(status: 2u8))),
        }
    }
    runner.main(a, process, err, tasks, c, code.describe(place), code.describe(schema), run)
}

pub fn law_calls_recorded(d: Dir, c: Clock, r: Random, tasks: Tasks, n: Net) -> bool waits {
    let mut name = string.with_capacity(64u64)
    string.push(mut name, "runner-recorded-")
    let dir = result.unwrap(host.mkdtemp(d, mut name))
    let db = result.unwrap(store.open(tasks, dir, c, r, disk_options()))
    let mut token: Bytes = list.new()
    // The Drive's streams are born at a keyed time between these two wall readings.
    let from = host.wall_ms(c)
    if !served_on(take db, c, tasks, n, r, mut token, 0u64, drive_recorded) {
        return false
    }
    let to = host.wall_ms(c)
    let mut o = disk_options()
    o.create = false
    let again = result.unwrap(store.open(tasks, dir, c, r, o))
    let b = store.main_branch(again)
    for v in 1u64 .. 9u64 {
        let got = result.unwrap(store.recorded(again, b, v))
        let held = if v == 3u64 {
            record_is(got, k_write(), 10u64, 0u64, token, from, to)
        } else if v == 5u64 {
            record_is(got, k_refuse(), 7u64, 1u64, token, from, to)
        } else if v == 7u64 {
            record_is(got, k_crash(), 2u64, 2u64, token, from, to)
        } else {
            match got {
                None => true,
                Some(_) => false,
            }
        }
        if !held {
            return false
        }
    }
    result.unwrap(store.close(take again))
    true
}

@test
fn test_calls_recorded(d: Dir, c: Clock, r: Random, tasks: Tasks, n: Net) -> Result[(), ()] waits {
    if law_calls_recorded(d, c, r, tasks, n) {
        Ok(())
    } else {
        Error(())
    }
}

// L3 (§8): a Failed position re-sent k times runs its handler exactly once. A Failed
// run's effects are aborted, so no row the body writes survives to count its runs
// (followups to runner-spec-1020). The count is tally's TRY_SEND events, which the
// harness reads from the evaluator's event log: exactly 1 for this case. A head that
// runs the body again for a Duplicate and discards the run gives 4. The data half runs
// on every engine: p0 is admitted at 3 and its reply kept alone at 4, and each of the
// three re-sends returns that stored reply.
fn drive_runs_once(take d: Drive) -> () waits {
    let s0 = conn(d, 0u64)
    for _ in 0u64 .. 4u64 {
        ask(s0, d.clock, 0u64, 0u64, k_tally(), u64_arg(5u64), LATER)
        let f = frame(s0)
        want(is(f.outcome, Failed(Raised(2u32))) && f.version == 3u64, "runs_once: Failed(Raised(2)) at 3")
    }
    hang(take s0)
}

pub fn law_calls_runs_once(c: Clock, r: Random, tasks: Tasks, n: Net) -> bool waits {
    served(c, r, tasks, n, drive_runs_once)
}

// refusals' store refusal (C3): the store refuses p0's effect commit
// (resident_limit), so the session gets Refused(Overloaded) in a frame at the publisher's
// base (V3), the open's version 1, and p0 stays admitted with no reply. p1 is not admitted while p0 is unreplied (STORE-SPEC §1.8, S7):
// it waits in the FIFO and is Abandoned at its deadline. A re-send of p0 runs it again
// and is refused again; it is not HistoryUnavailable, which C3 allows only for a replied position.
fn drive_store_refusal(take d: Drive) -> () waits {
    let s0 = conn(d, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_flood(), u64_arg(FLOOD), LATER)
    let a = frame(s0)
    want(is(a.outcome, Refused(Overloaded)) && a.version == 1u64, "store_refusal: p0 refused by the store")
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(1u64), 2000000u64)
    let b = frame(s0)
    want(b.p == 1u64 && is(b.outcome, Abandoned), "store_refusal: p1 not admitted while p0 is unreplied")
    ask(s0, d.clock, 0u64, 0u64, k_flood(), u64_arg(FLOOD), LATER)
    let c = frame(s0)
    want(c.p == 0u64 && is(c.outcome, Refused(Overloaded)), "store_refusal: re-sent p0 runs again, not HistoryUnavailable")
    hang(take s0)
}

// Each row's resident charge is 62 + 16 (key) + 8 (value) bytes.
// This exceeds the 32,768-byte resident limit while the draft fits the entry grant.
const FLOOD: u64 = 512u64

pub fn law_calls_store_refusal(c: Clock, r: Random, tasks: Tasks, n: Net) -> bool waits {
    let mut o = result.unwrap(store.sized(Directory, 2147483648u64))
    o.resident_limit = 32768u64
    served_in(c, r, tasks, n, o, drive_store_refusal)
}

fn joins(cn: Conn, stream: Bytes, p: u64, version: u64) -> () waits {
    want(match down(cn) {
        Batched(b) => b.version == version && list.len(b.rows) == 0u64 && list.len(b.outcomes) == 2u64 && b.outcomes[0].stream == stream && b.outcomes[1].stream == stream && b.outcomes[0].p == p && b.outcomes[1].p == p && ok_value(b.outcomes[0].outcome) == Some(version) && is(b.outcomes[0].outcome, b.outcomes[1].outcome),
        _ => false,
    }, "one_outcome: both joined sends are in the same Batch")
}

// Rule 5: every send ends in exactly one Outcome (review 1042, law_abandoned_no_resend).
// Each position runs once, as an admit and an effect commit after the schema commit. A new
// stream admits only p0 (STORE-SPEC §1.8), so each stream first commits p0.
// - Stream 0: p0 at 3. p2 sent alone before p1 is Abandoned at its deadline. p1 commits
//   at 5; p2 runs behind it at 7 and produces no further outcome row.
// - Another stream proceeds at 9, then stream 0's p3 commits at 11.
// - Stream 2: p0 at 13. Two sends of p2 wait behind p1 (15) and receive two outcomes in
//   one frame at 17.
// - Stream 3: p0 at 19. A p2 that expires and is re-sent twice waits behind p1 (21) and
//   receives two outcomes at 23. Its next position commits at 25.
// - Stream 4: p0 at 27. p2 Abandoned in a session that then ends: a different session
//   can send p1, p2 and p3, with one answer for each position (29, 31, 33).
fn drive_one_outcome_per_send(take d: Drive) -> () waits {
    let s0 = conn(d, 2u64)
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(0u64), LATER)
    let b = frame(s0)
    want(b.p == 0u64 && ok_value(b.outcome) == Some(3u64), "one_outcome: p0 at 3")
    ask(s0, d.clock, 0u64, 2u64, k_write(), u64_arg(2u64), 2000000u64)
    let a = frame(s0)
    want(a.p == 2u64 && is(a.outcome, Abandoned), "one_outcome: p2 Abandoned")
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(1u64), LATER)
    let b1 = frame(s0)
    want(b1.p == 1u64 && ok_value(b1.outcome) == Some(5u64), "one_outcome: p1 at 5")
    ask(s0, d.clock, 1u64, 0u64, k_write(), u64_arg(100u64), LATER)
    let other = frame(s0)
    want(other.stream == sid(1u64) && other.p == 0u64 && ok_value(other.outcome) == Some(9u64), "one_outcome: another stream proceeds, and p2's run has no Outcome")
    ask(s0, d.clock, 0u64, 3u64, k_write(), u64_arg(3u64), LATER)
    let c = frame(s0)
    want(c.stream == sid(0u64) && c.p == 3u64 && ok_value(c.outcome) == Some(11u64), "one_outcome: p3 next, and p2 ran once with no Outcome")
    ask(s0, d.clock, 2u64, 0u64, k_write(), u64_arg(200u64), LATER)
    want(ok_value(frame(s0).outcome) == Some(13u64), "one_outcome: stream 2 p0 at 13")
    ask(s0, d.clock, 2u64, 2u64, k_write(), u64_arg(202u64), LATER)
    ask(s0, d.clock, 2u64, 2u64, k_write(), u64_arg(202u64), LATER)
    ask(s0, d.clock, 2u64, 1u64, k_write(), u64_arg(201u64), LATER)
    let d1 = frame(s0)
    want(d1.stream == sid(2u64) && d1.p == 1u64 && ok_value(d1.outcome) == Some(15u64), "one_outcome: the predecessor runs at 15")
    joins(s0, sid(2u64), 2u64, 17u64)
    ask(s0, d.clock, 3u64, 0u64, k_write(), u64_arg(300u64), LATER)
    want(ok_value(frame(s0).outcome) == Some(19u64), "one_outcome: stream 3 p0 at 19")
    ask(s0, d.clock, 3u64, 2u64, k_write(), u64_arg(302u64), 2000000u64)
    let e = frame(s0)
    want(e.p == 2u64 && is(e.outcome, Abandoned), "one_outcome: stream 3 p2 Abandoned")
    ask(s0, d.clock, 3u64, 2u64, k_write(), u64_arg(302u64), LATER)
    ask(s0, d.clock, 3u64, 2u64, k_write(), u64_arg(302u64), LATER)
    ask(s0, d.clock, 3u64, 1u64, k_write(), u64_arg(301u64), LATER)
    let e1 = frame(s0)
    want(e1.p == 1u64 && ok_value(e1.outcome) == Some(21u64), "one_outcome: stream 3 p1 at 21")
    joins(s0, sid(3u64), 2u64, 23u64)
    ask(s0, d.clock, 3u64, 3u64, k_write(), u64_arg(303u64), LATER)
    let e3 = frame(s0)
    want(e3.p == 3u64 && ok_value(e3.outcome) == Some(25u64), "one_outcome: stream 3 p3 next")
    ask(s0, d.clock, 4u64, 0u64, k_write(), u64_arg(400u64), LATER)
    want(ok_value(frame(s0).outcome) == Some(27u64), "one_outcome: stream 4 p0 at 27")
    let s1 = conn(d, 1u64)
    ask(s1, d.clock, 4u64, 2u64, k_write(), u64_arg(402u64), 2000000u64)
    let f = frame(s1)
    want(f.p == 2u64 && is(f.outcome, Abandoned), "one_outcome: stream 4 p2 Abandoned")
    hang(take s1)
    ask(s0, d.clock, 4u64, 1u64, k_write(), u64_arg(401u64), LATER)
    let f1 = frame(s0)
    want(f1.p == 1u64 && ok_value(f1.outcome) == Some(29u64), "one_outcome: stream 4 p1 at 29")
    ask(s0, d.clock, 4u64, 2u64, k_write(), u64_arg(402u64), LATER)
    let f2 = frame(s0)
    want(f2.p == 2u64 && ok_value(f2.outcome) == Some(31u64), "one_outcome: replacement session sends p2")
    ask(s0, d.clock, 4u64, 3u64, k_write(), u64_arg(403u64), LATER)
    let f3 = frame(s0)
    want(f3.p == 3u64 && ok_value(f3.outcome) == Some(33u64), "one_outcome: stream 4 p3 after the replacement p2")
    hang(take s0)
}

pub fn law_calls_one_outcome_per_send(c: Clock, r: Random, tasks: Tasks, n: Net) -> bool waits {
    served(c, r, tasks, n, drive_one_outcome_per_send)
}

// L7/deadline_held (v2.4), on the real head. p0 commits at 3. p2, sent before p1, waits in
// the head's FIFO (S7: Rejected(0)); the session answers Abandoned at its deadline (V1), at
// its last version 3, and keeps the slot (V2). Then p1 is sent and p2 re-sent: p1 commits
// at 5, and p2, which the re-send joins locally, runs once and commits at 7. The next
// position is the next frame, at 9, so p2 was answered once. (A new stream admits only
// p0, STORE-SPEC §1.8, so the held successor follows a committed p0.)
fn drive_deadline_held(take d: Drive) -> () waits {
    let s0 = conn(d, 1u64)
    ask(s0, d.clock, 0u64, 0u64, k_write(), u64_arg(10u64), LATER)
    let f0 = frame(s0)
    want(f0.p == 0u64 && ok_value(f0.outcome) == Some(3u64) && f0.version == 3u64, "deadline_held: p0 at 3")
    ask(s0, d.clock, 0u64, 2u64, k_write(), u64_arg(12u64), 2000000u64)
    let a = frame(s0)
    want(is(a.outcome, Abandoned) && a.p == 2u64 && a.version == 3u64, "deadline_held: Abandoned at the deadline")
    ask(s0, d.clock, 0u64, 1u64, k_write(), u64_arg(11u64), LATER)
    ask(s0, d.clock, 0u64, 2u64, k_write(), u64_arg(12u64), LATER)
    let f1 = frame(s0)
    want(f1.p == 1u64 && ok_value(f1.outcome) == Some(5u64) && f1.version == 5u64, "deadline_held: p1 at 5")
    let f2 = frame(s0)
    want(f2.p == 2u64 && ok_value(f2.outcome) == Some(7u64) && f2.version == 7u64, "deadline_held: p2 once, at 7")
    ask(s0, d.clock, 0u64, 3u64, k_write(), u64_arg(13u64), LATER)
    let f3 = frame(s0)
    want(f3.p == 3u64 && ok_value(f3.outcome) == Some(9u64), "deadline_held: p2 answered once")
    hang(take s0)
}

pub fn law_calls_deadline_held(c: Clock, r: Random, tasks: Tasks, n: Net) -> bool waits {
    served(c, r, tasks, n, drive_deadline_held)
}

// The session's V1 and V2 logic against a head that holds every request and answers none
// (a held-head case; not L7/deadline_hung, which waits on D5):
// - q = 0: A p0 is Abandoned at its deadline (V1) and keeps its slot (V2), so B p0 is
//   Overloaded at once, and the head holds one request (C6, queue_outside_account);
//   a re-send of A p0 joins locally and is Abandoned again, still one request;
// - q = 1: p0 and p1 of one stream both forwarded and both Abandoned at their deadlines,
//   though the head answers neither (deadline_rides_release);
// - L15, each send at its own deadline: A (2 ms) then B (50 ms) of one held position, and
//   A's Abandoned arrives before B's deadline, then B's (latest_deadline);
// - L15, a joined send takes a slot: with q = 0 a second send of a held position is
//   Overloaded at once, and the first is Abandoned at its deadline (join_outside_account).
// The held head answers only a Hello's stream-time read, so a session can mint its stream,
// and keeps every other input in `hold` unanswered.
type Holding: send {
    from: Receiver[runner.HeadInput],
    hold: Sender[runner.HeadInput],
    clock: Clock
}

fn holding(take h: Holding) -> () waits {
    while let Ok(take q) = channel.receive(h.from) {
        match take q {
            ReadStreamTime(take to) => {
                let _ = channel.try_send(to, runner.StreamTime(now_ms: host.wall_ms(h.clock), retention_ms: store.STREAM_RETENTION_MS))
            },
            take other => {
                let _ = channel.send(h.hold, take other)
            },
        }
    }
}

pub fn law_calls_held_head(c: Clock, tasks: Tasks, n: Net, r: Random) -> bool waits {
    let (head, from): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let (held_to, inbox): (Sender[runner.HeadInput], Receiver[runner.HeadInput]) = channel.new(64u64)
    let mut holder = task.spawn(tasks, bytes 65536u64, Holding(from: take from, hold: take held_to, clock: c), holding)
    let mail = result.unwrap(runner.mailbox(1u64))
    let post = runner.post(mail)
    let credential = ingress.credential(r)
    let db = store.memory(c, r, result.unwrap(store.sized(Memory, 1074790400u64)))
    let d = Drive(head: channel.sender(head), post: channel.sender(post), clock: c, tasks: tasks, net: n, random: r, token: clone(credential), accepted: None, birth: host.wall_ms(c))
    let s0 = conn(d, 0u64)
    ask(s0, c, 0u64, 0u64, k_write(), u64_arg(1u64), 2000000u64)
    let a = frame(s0)
    want(is(a.outcome, Abandoned) && a.version == 0u64, "held_head: Abandoned at the deadline")
    ask(s0, c, 1u64, 0u64, k_write(), u64_arg(2u64), LATER)
    want(is(frame(s0).outcome, Refused(Overloaded)), "held_head: the slot stays held")
    let mut held = 0u64
    while !empty(inbox) {
        held += 1u64
    }
    want(held == 1u64, "held_head: the head holds 1 + q")
    ask(s0, c, 0u64, 0u64, k_write(), u64_arg(1u64), 2000000u64)
    want(is(frame(s0).outcome, Abandoned), "held_head: a re-send joins locally")
    want(empty(inbox), "held_head: a re-send is not forwarded")
    hang(take s0)
    let s1 = conn(d, 1u64)
    ask(s1, c, 0u64, 0u64, k_write(), u64_arg(1u64), 2000000u64)
    ask(s1, c, 0u64, 1u64, k_write(), u64_arg(2u64), 2000000u64)
    want(is(frame(s1).outcome, Abandoned) && is(frame(s1).outcome, Abandoned), "held_head: both answered by the session")
    hang(take s1)
    let s3 = conn(d, 1u64)
    ask(s3, c, 0u64, 0u64, k_write(), u64_arg(3u64), 2000000u64)
    let b_at = host.mono_ns(c) + 50000000u64
    ask(s3, c, 0u64, 0u64, k_write(), u64_arg(3u64), 50000000u64)
    let first = frame(s3)
    want(is(first.outcome, Abandoned) && host.mono_ns(c) < b_at, "held_head: the first send is Abandoned at its own deadline")
    want(is(frame(s3).outcome, Abandoned) && host.mono_ns(c) >= b_at, "held_head: the second send at its own")
    hang(take s3)
    let s2 = conn(d, 0u64)
    ask(s2, c, 0u64, 9u64, k_write(), u64_arg(9u64), 2000000u64)
    ask(s2, c, 0u64, 9u64, k_write(), u64_arg(9u64), 2000000u64)
    want(is(frame(s2).outcome, Refused(Overloaded)), "held_head: with q = 0 a join takes the second slot")
    want(is(frame(s2).outcome, Abandoned), "held_head: the first send is still answered")
    hang(take s2)
    task.cancel(mut holder)
    let _ = task.join(take holder)
    true
}

// H2 and V2: a live successor may wait for a predecessor from another session.
// A departed session's successor no longer owns a position in that FIFO. Stream 0 first
// commits p0 at 3, since a new stream admits only p0 (STORE-SPEC §1.8).
fn drive_retired_head(take d: Drive) -> () waits {
    let old = conn(d, 0u64)
    ask(old, d.clock, 0u64, 0u64, k_write(), u64_arg(9u64), LATER)
    want(ok_value(frame(old).outcome) == Some(3u64), "retired head: p0 commits")
    ask(old, d.clock, 0u64, 2u64, k_write(), u64_arg(99u64), 2000000u64)
    want(is(frame(old).outcome, Abandoned), "retired head: the parked send reaches its deadline")
    hang(take old)
    let next = conn(d, 1u64)
    let prior = conn(d, 1u64)
    ask(prior, d.clock, 0u64, 1u64, k_write(), u64_arg(10u64), LATER)
    want(ok_value(frame(prior).outcome) == Some(5u64), "retired head: the predecessor commits")
    ask(prior, d.clock, 1u64, 0u64, k_write(), u64_arg(11u64), LATER)
    want(ok_value(frame(prior).outcome) == Some(7u64), "retired head: the departed successor consumed no commit")
    ask(next, d.clock, 0u64, 3u64, k_write(), u64_arg(13u64), LATER)
    ask(prior, d.clock, 0u64, 2u64, k_write(), u64_arg(12u64), LATER)
    want(ok_value(frame(prior).outcome) == Some(9u64), "retired head: the replacement commits")
    want(ok_value(frame(next).outcome) == Some(11u64), "retired head: the live successor follows on its other session")
    hang(take next)
    hang(take prior)
}

pub fn law_calls_retired_head(c: Clock, r: Random, tasks: Tasks, n: Net) -> bool waits {
    served(c, r, tasks, n, drive_retired_head)
}


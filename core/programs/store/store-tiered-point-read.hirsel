pub fn tiered_replayed_row(tree: pages.PageTree, logical: Bytes) -> Option[View[pages.ReplayRow]] in tree {
    let Some(overlays) = view tree.replay else {
        return None
    }
    let id: u32 = list.word_be(logical, 0)
    let Some(overlay) = std.omap.get(overlays.collections, id) else {
        return None
    }
    replay_overlay_at(overlay, logical)
}

pub type TieredPageBackend = PagerTask(Sender[TieredPagerMessage]) | PagerDirect(Dir, types.StoreKey)

// The demand for a latched miss, or the failure an earlier delivery of the
// same target recorded.
pub fn tiered_miss_demand(source: TieredPageSource, state: TieredTouchSet, sought: Bytes, direction: TieredDirection, take grant: Option[Arc[TieredReaderGrant]], mut pending: Option[(format.TieredTarget, types.Failure)]) -> Result[TieredPointDemand, types.Failure] {
    tiered_miss_demand_raw(source.packs, source.next_stamp, source.deadline, state, sought, direction, take grant, mut pending)
}

pub fn tiered_miss_demand_raw(packs: std.omap.OMap[u64, pages.TieredPagerPack], next_stamp: u64, deadline: u64, state: TieredTouchSet, sought: Bytes, direction: TieredDirection, take grant: Option[Arc[TieredReaderGrant]], mut pending: Option[(format.TieredTarget, types.Failure)]) -> Result[TieredPointDemand, types.Failure] {
    let Some(AttemptMiss(target)) = view state.stopped else {
        fail("store: only a latched miss is delivered")
    }
    let failed_here = match pending {
        Some((failed, _)) => format.tiered_frame_id(failed) == format.tiered_frame_id(target),
        None => false,
    }
    if failed_here {
        let (_, take problem) = option.unwrap(replace(mut pending, None))
        return Error(take problem)
    }
    // A scan's demand descends in the scan's direction, whichever driver
    // serves it.
    let descent = match state.ahead {
        Ahead(_, true) => TieredBackward,
        Ahead(_, false) => TieredForward,
        NoAhead => direction,
    }
    Ok(TieredPointDemand(target: clone(target), key: types.copied(sought)?, values: clone(state.values), room: int.saturating_sub(state.partition, state.touched_bytes), direction: descent, paths: clone(state.gather.paths), siblings: clone(state.siblings), ahead: clone(state.ahead), packs: std.omap.snapshot(packs), next_stamp: next_stamp, deadline: deadline, grant: take grant))
}

// Installs a delivered batch in its order and records its failure. The
// held path frames are protected like touched ones once installed, so a
// later frame of the same batch never evicts one and the next attempt finds
// every path it was demanded for. It is false when a path frame did not fit
// the map's partition (§13.3a "crowded").
pub fn tiered_install_delivery(take delivered: TieredPointDelivery, root: TieredPinRoot, touched: Map[u64, ()], mut pins: TieredPins, mut pending: Option[(format.TieredTarget, types.Failure)]) -> Result[bool, types.Failure] {
    let TieredPointDelivery(frames: take frames, held: held, failure: take failure, ..) = take delivered
    let mut kept: Map[u64, ()] = map.new()
    if held != 0 {
        types.capacity(map.try_reserve(mut kept, map.len(touched) + held))?
        for (stamp, _) in touched {
            map.insert(mut kept, stamp, ())
        }
    }
    let mut fit = true
    let mut at = 0u64
    for frame in frames {
        let installed = if held == 0 {
            tiered_install_pin(mut pins, root, touched, frame)?
        } else {
            tiered_install_pin(mut pins, root, kept, frame)?
        }
        // A sibling or a later value that does not fit is a prefetch left
        // out; only a path frame that does not fit leaves the call crowded.
        if installed {
            if at < held {
                map.insert(mut kept, frame.identity.stamp, ())
            }
        } else if held == 0 || at < held {
            fit = false
        }
        at += 1
    }
    if let Some(take refused) = take failure {
        pending = Some(take refused)
    }
    pins.demands += 1
    Ok(fit)
}

// The source a Tx attempt's misses are served from, at the root it reads.
pub fn tx_page_source(pager: Option[View[Sender[TieredPagerMessage]]], tree: pages.PageTree) -> Result[TieredPageSource, types.Failure] {
    let Some(requests) = pager else {
        return Error(Io(Closed))
    }
    let Some(inventory) = view tree.paging else {
        fail("store: a Cold edge has no pack inventory")
    }
    Ok(TieredPageSource(pager: channel.sender(requests), packs: std.omap.snapshot(inventory.packs), next_stamp: inventory.next_stamp, deadline: 0))
}

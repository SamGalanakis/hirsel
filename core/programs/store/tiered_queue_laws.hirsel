// 120 appends of 48 bytes in a Tiered Log whose tree the cut emits Cold.
fn l87_cold_log(d: Dir, c: Clock, r: Random, tasks: Tasks, floor: u64) -> Result[Log[Bytes], Error] waits {
    let mut db = open(tasks, d, c, r, l70_open_options(floor)?)?
    let mut declaring = declare(db, Migrate)?
    let events = declare_log(mut declaring, "events", std.codec.of_bytes())?
    let _ = seal(mut db, take declaring)?
    let Committed(_) = run(mut db, None, copy_env(events), fn(mut tx: Tx, l: Log[Bytes]) -> Result[(), Error] {
        for seq in 0u64 .. 120 {
            let mut body: Bytes = list.with_capacity(48)
            list.fill(mut body, 48, int.truncate(seq))
            let _ = append(mut tx, l, body)?
        }
        Ok(())
    })? else {
        fail("L87: fixture appends did not commit")
    }
    let id = prefix(events.binding.id)?
    let mut tree = share_page_tree(db.heads[0u64].roots.collections)
    let (take root, take descriptor) = {
        let Some((here, before)) = std.page.collection_entry(tree.root, id) else {
            fail("L87: the fixture has no Log")
        }
        let limits = descriptor_bounds(before)
        (arc.share(here), log_record(here, limits.first, limits.next, 1)?)
    }
    if std.page.level(std.page.image_of(root)) == 0 {
        fail("L87: the fixture Log must span more than one leaf")
    }
    let mut draw = stamp_after(db.next_node)?
    let first = draw
    page_result(std.page.insert(mut tree.root, id, descriptor, Some(arc.share(root)), tree.inline, first, mut draw))?
    page_result(std.page.install_tiered_root(mut tree.root, id, HotPage(take root), mut draw))?
    db.heads[0u64].roots.collections = take tree
    db.next_node = draw - 1
    let _ = checkpoint(mut db)?
    close(take db)?
    Ok(events)
}

// The Cold root's first child, read from its class-3 pack: the leaf a floor
// past that child's last row detaches, and the floor that does it.
fn l87_first_leaf(d: Dir, db: Db, collection: u32) -> Result[(std.page.PagePtr, u64), Error] waits {
    let id = prefix(collection)?
    let Some((ColdPage(root), _)) = std.page.collection_slot(db.heads[0u64].roots.collections.root, id) else {
        fail("L87: the cut must leave the Log root Cold")
    }
    let path = paged_pack_path(root.pack)?
    let wire = disk_read_file(d, path, 1048576)?
    let frame = read_tiered_frame(path, db.store, TieredPage(root), wire, 0, stamp_after(db.next_node)?)?
    let page = fold_page(frame)
    let Some(ColdPage(leaf)) = std.page.child_slot(page, 0) else {
        fail("L87: the root's first child is a Cold leaf")
    }
    let Some(separator) = std.page.key_at(std.page.image_of(page), 1) else {
        fail("L87: the root has a second child")
    }
    let following: u64 = list.word_be(separator, 0)
    Ok((leaf, following + 1))
}

fn l87_queue(db: Db) -> Result[List[(u64, DeferredFree)], Error] {
    let lists = disk_state(db).pages.lists
    let mut rows: List[(u64, DeferredFree)] = list.new()
    let image = std.page.image_of(lists.deferred)
    if std.page.level(image) != 0 {
        fail("L87: the fixture queue fits one leaf")
    }
    for slot in 0u64 .. std.page.count(image) {
        let key = option.unwrap(std.page.key_at(image, slot))
        let value = option.unwrap(std.page.value_at(lists.deferred, slot))
        let seq: u64 = list.word_be(key, 0)
        let ptr: std.page.PagePtr = std.page.decode_ptr(list.slice(value, 5, 41)) ?=> |_| Missing("L87 queued Page row")
        let owner: u32 = list.word_le(value, 1)
        list.push(mut rows, (seq, DeferredFree(branch_id: owner, target: TieredPage(ptr))))
    }
    Ok(take rows)
}

// L87 (a) through the cut (§13.6a T8 step 3): a journaled floor reopens as
// a replay overlay; the fold cut detaches the whole first Cold leaf without
// reading it and queues exactly that location for main. A second, idle cut
// carries the queue unchanged, and a reopen reads it back from the MANIFEST.
@test
fn test_l87_fold_cut_queues_detached_leaf(d: Dir, c: Clock, r: Random, tasks: Tasks) -> Result[(), Error] waits {
    let floor = 182375272u64
    let events = l87_cold_log(d, c, r, tasks, floor)?
    let mut cold = open(tasks, d, c, r, l70_open_options(floor)?)?
    let (leaf, trim) = l87_first_leaf(d, cold, events.binding.id)?
    let Committed(_) = run(mut cold, Some(100000), copy_env((events, trim)), fn(mut tx: Tx, env: (Log[Bytes], u64)) -> Result[(), Error] {
        trim_before(mut tx, env.0, env.1)
    })? else {
        fail("L87: the served trim of a Cold Tiered Log commits")
    }
    close(take cold)?

    let mut replayed = open(tasks, d, c, r, l70_open_options(floor)?)?
    let _ = checkpoint(mut replayed)?
    let _ = checkpoint(mut replayed)?
    close(take replayed)?

    let reopened = open(tasks, d, c, r, l70_open_options(floor)?)?
    let queued = l87_queue(reopened)?
    if list.len(queued) != 1 || disk_state(reopened).pages.lists.deferred_next != 1 {
        fail("L87: the fold queues one detached subtree")
    }
    let (seq, row) = queued[0u64]
    let TieredPage(queued_leaf) = row.target else {
        fail("L87: a detached leaf is queued as a Page row")
    }
    if seq != 0 || row.branch_id != 0 || queued_leaf != leaf {
        fail("L87: the queue names main's detached Cold leaf at its exact location")
    }
    close(take reopened)
}

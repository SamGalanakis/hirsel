// rule: FAIL-3
// expect: run
// stdout: decoding
// stdout: SEM-1
// stdout: 19
// stdout: 5
// A check's failure is its decode's failure and unwinds like any other: the list the
// decode reconstructed, every String in it included, is released once, and
// task.isolate catches the failure with the check's own rule. The check fails on the
// third of five entries; the program goes on, and a list every check admits decodes.
@serializable(check = valid)
pub opaque type Month: plain + key + sendable + inert + noalloc_drop uses {} {
  number: u8,
}

// Admits 1 and 2; fails on 3 and above (u8 overflow).
@noalloc
fn valid(value: Month) -> bool uses {} {
  value.number * 100 > 0
}

@serializable
type Entry {
  name: String,
  month: Month,
}

fn entries(months: List[u8]) -> List[Entry] {
  let mut out: List[Entry] = []
  for m in months {
    list.push(
      mut out,
      Entry(name: "an entry whose name the decode allocates", month: Month(number: m))
    )
  }
  out
}

fn count(encoded: Bytes) -> u64 {
  let decoded: Result[List[Entry], DecodeError] = codec.decode(encoded)
  match decoded {
    Ok(read) => list.len(read),
    Error(_) => 0,
  }
}

fn line(stdout: Stdout, text: String) -> () {
  let _ = out.print(stdout, text)
  let _ = out.print(stdout, "\n")
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let tasks = io.tasks(rt)?
  line(stdout, "decoding")
  let caught: Result[u64, Failure] = task.isolate(
    tasks,
    fn() -> u64 {
      count(codec.encode(entries([1, 2, 3, 1, 2])))
    }
  )
  match caught {
    Ok(_) => line(stdout, "not caught"),
    Error(failed) => {
      line(stdout, failed.rule)
      line(stdout, u64.to_string(failed.site.line))
    },
  }
  line(stdout, u64.to_string(count(codec.encode(entries([1, 2, 1, 2, 1])))))
  Ok(())
}

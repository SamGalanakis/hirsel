// steps: 20000000
// A store over authority.objects@1 on simulated objects (objects.sim@1), the
// path an S3 bucket takes, whose client is cut at each object request in turn
// (every get, put, conditional replace, listing and delete); authority `vN`
// applies request N, loses its reply, then the client crashes. A crashed client restarts with nothing of the old one, and the old
// one's claim is dead. The one level is disk and the floor, so an Ok commit is
// acknowledged.
// The history is fixed: open the first head, commit 1 and wait for it at disk;
// open a second head on the same authority, whose claim fences the first; the
// first commits 2 and 3; the second commits 4 and waits for it at disk; open a
// third head, fencing the second; the second commits 5; the third commits 6;
// close the first, the second and the third. A fenced head's commits 2, 3 and 5
// are never acknowledged and never appear, whatever the cut did to their
// requests or answers. Uncut, commit 2 is refused Fenced() and closes the first
// head (commit 3 and its close are Closed()), and commit 5 is refused Fenced().
// After each cut the store reopens and holds the state after live commit j, 0,
// 1, 4 or 6, whole: a, b and c are j and xi for each live i up to j, no others.
// j is at least the last commit an acknowledgement at disk or the close covered,
// and at most the last live commit whose transaction returned Ok or Unknown. A
// second reopen holds the same rows and fences the first, whose next commit is
// refused Fenced(). A commit made after recovery survives a third reopen.
// Authority `fN` refuses request N and then crashes: every `fN` up to the
// history's last request stops the history and the one after lets it finish,
// so each `vN` cuts a request of the same deterministic history.
// This case makes the cuts at requests 1 to 21.
// stdout: fences: 0

// The cut this case makes at each request.
const KIND: String = "v"

// The first request this case cuts, and the last (0: to the history's end).
const FIRST: u64 = 1

const LAST: u64 = 21

// Whether an Ok commit is acknowledged at disk (the floor is the strongest level).
const ACKED_AT_FLOOR: bool = true

// Commit j: a, b and c set to j, and xj added.
fn step(mut tx: store.Tx, info: store.CallInfo, j: u8) -> Result[u8, store.TxError] {
  let v = bytes.from_list([j])
  store.tx_put(mut tx, b"a", copy v)?
  store.tx_put(mut tx, b"b", copy v)?
  store.tx_put(mut tx, b"c", copy v)?
  store.tx_put(mut tx, bytes.from_list([120u8, j]), copy v)?
  Ok(j)
}

pub type Failed = Check(String) | Store(store.StoreError)

fn check(ok: bool, take what: String) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Check(what))
  }
}

// What the history learned: `low`, the last commit an acknowledgement covers;
// `high`, the last commit that may have happened; `stale`, the outcomes of the
// commits and closes of fenced heads, in order; `acked`, a fenced head's commit
// that returned Ok (0 when none did).
type Known {
  low: u8,
  high: u8,
  finished: bool,
  stale: String,
  acked: u8,
}

fn config() -> store.StoreConfig {
  store.default_config()
}

fn said(e: store.StoreError) -> String {
  match e {
    Storage(_) => "Storage",
    Refused(_) => "Refused",
    Corrupt(what) => f"Corrupt({what})",
    Fenced => "Fenced",
    Closed => "Closed",
    Unsupported(_) => "Unsupported",
    NoLevel => "NoLevel",
    Foreign => "Foreign",
    InvalidInput => "InvalidInput",
  }
}

// Commit j on a live head: Ok and Unknown may have happened; Storage(..) did not.
// True when the store is still open.
fn commit(mut s: store.Store, mut k: Known, j: u8) -> bool {
  let r: Result[u8, store.TxFailure[store.TxError]] = store.transact(mut s, step, j)
  match r {
    Ok(_) => {
      k.high = j
      if ACKED_AT_FLOOR {
        k.low = j
      }
      true
    },
    Error(Unknown(_)) => {
      k.high = j
      false
    },
    _ => false,
  }
}

// Waits for commit j at disk; true when acknowledged.
fn strong(a: Authority, mut s: store.Store, mut k: Known, j: u8) -> bool {
  let Some(disk) = authority.level(a, "disk") else {
    return false
  }
  let t = store.ticket(s)
  match store.durable(a, mut s, t, disk) {
    Ok(()) => {
      k.low = j
      true
    },
    _ => false,
  }
}

// Commit j on a head a later claim fenced: it must not be acknowledged, and its
// effect must never appear. The outcome is noted for the uncut run.
fn stale(mut s: store.Store, mut k: Known, j: u8) -> () {
  let r: Result[u8, store.TxFailure[store.TxError]] = store.transact(mut s, step, j)
  let outcome = match r {
    Ok(_) => {
      k.acked = j
      "Ok"
    },
    Error(Storage(e)) => f"Storage({said(e)})",
    Error(Unknown(e)) => f"Unknown({said(e)})",
    Error(_) => "other",
  }
  k.stale = f"{k.stale} {j}:{outcome}"
}

fn closed(take s: store.Store, mut k: Known, name: String) -> () {
  let outcome = match store.close(take s) {
    Ok(()) => "Ok",
    Error(e) => said(e),
  }
  k.stale = f"{k.stale} close {name}:{outcome}"
}

// The fixed history, stopping at the first failure of a live head.
fn history(a: Authority, mut k: Known) -> () {
  let Ok(made_first) = store.open(a, config()) else {
    return ()
  }
  let mut first = take made_first
  if !commit(mut first, mut k, 1) || !strong(a, mut first, mut k, 1) {
    return ()
  }
  // The second head's claim fences the first.
  let Ok(made_second) = store.open(a, config()) else {
    return ()
  }
  let mut second = take made_second
  stale(mut first, mut k, 2)
  stale(mut first, mut k, 3)
  if !commit(mut second, mut k, 4) || !strong(a, mut second, mut k, 4) {
    return ()
  }
  // A third head fences the second, whose own claim had fenced the first.
  let Ok(made_third) = store.open(a, config()) else {
    return ()
  }
  let mut third = take made_third
  stale(mut second, mut k, 5)
  if !commit(mut third, mut k, 6) {
    return ()
  }
  closed(take first, mut k, "first")
  closed(take second, mut k, "second")
  match store.close(take third) {
    Ok(()) => {
      k.low = 6
      k.finished = true
    },
    Error(_) => (),
  }
}

// Every user row of the store's state at its floor.
fn rows(a: Authority, mut s: store.Store) -> Result[List[(Bytes, Bytes)], Failed] {
  let snap = store.snapshot(a, mut s, authority.floor(a)) ? Store
  let all: ordered_map.Bound[Bytes] = Unbounded()
  let up: ordered_map.Direction = Ascending()
  let mut user: List[(Bytes, Bytes)] = []
  for (k, v) in store.range(snap, all, Unbounded(), up, 100) {
    if !store.reserved(k) {
      list.push(mut user, (copy k, copy v))
    }
  }
  Ok(user)
}

// The rows after live commit j (0, 1, 4 or 6): the fenced heads' commits 2, 3
// and 5 are never among them.
fn model(j: u8) -> List[(Bytes, Bytes)] {
  let mut m: List[(Bytes, Bytes)] = []
  if j == 0 {
    return m
  }
  let v = bytes.from_list([j])
  list.push(mut m, (b"a", copy v))
  list.push(mut m, (b"b", copy v))
  list.push(mut m, (b"c", copy v))
  for i in [1u8, 4u8, 6u8] {
    if i <= j {
      list.push(mut m, (bytes.from_list([120u8, i]), bytes.from_list([i])))
    }
  }
  m
}

// The rows after live commit j and then commit 9.
fn after(j: u8) -> List[(Bytes, Bytes)] {
  let nine = bytes.from_list([9u8])
  let mut m: List[(Bytes, Bytes)] = [
    (b"a", copy nine),
    (b"b", copy nine),
    (b"c", copy nine)
  ]
  for i in [1u8, 4u8, 6u8] {
    if i <= j {
      list.push(mut m, (bytes.from_list([120u8, i]), bytes.from_list([i])))
    }
  }
  list.push(mut m, (bytes.from_list([120u8, 9u8]), copy nine))
  m
}

// The live commit the rows are the state after; 255 when they are none's.
fn which(r: List[(Bytes, Bytes)]) -> u8 {
  let mut j: u8 = 0
  for (k, v) in r {
    if k == b"a" && bytes.len(v) == 1 {
      j = v[0]
    }
  }
  if (j == 0 || j == 1 || j == 4 || j == 6) && r == model(j) {
    j
  } else {
    255
  }
}

fn keys(r: List[(Bytes, Bytes)]) -> String {
  let mut out = ""
  for (k, v) in r {
    if bytes.len(k) == 2 && k[0] == 120u8 {
      out = f"{out} x{k[1]}"
    } else if k == b"a" && bytes.len(v) == 1 {
      out = f"{out} a={v[0]}"
    }
  }
  out
}

// Recovers the store a cut history left and checks it against `k`.
fn recover(a: Authority, name: String, k: Known) -> Result[(), Failed] {
  check(k.acked == 0, f"{name}: fenced commit {k.acked} acknowledged")?
  let first = store.open(a, config())
  let mut s = match take first {
    Ok(opened) => opened,
    Error(e) => return Error(
      Check(f"{name}: reopen refused {said(e)}, history {k.low}..{k.high}")
    ),
  }
  let seen = rows(a, mut s)?
  let j = which(seen)
  check(
    j != 255,
    f"{name}: rows are no live commit's state:{keys(seen)}, history {k.low}..{k.high}"
  )?
  check(
    k.low <= j && j <= k.high,
    f"{name}: recovered commit {j} outside {k.low}..{k.high}"
  )?
  // A second reopen fences the first and holds the same rows; the first can
  // no longer commit.
  let Ok(second) = store.open(a, config()) else {
    return Error(Check(f"{name}: second reopen refused"))
  }
  let mut again = take second
  check(rows(a, mut again)? == seen, f"{name}: second reopen differs")?
  let late: Result[u8, store.TxFailure[store.TxError]] = store.transact(
    mut s,
    step,
    7u8
  )
  check(
    late == Error(Storage(Fenced())),
    f"{name}: the fenced reopen was not refused Fenced"
  )?
  // The recovered store takes a new commit and keeps it, and the refused one is gone.
  let made: Result[u8, store.TxFailure[store.TxError]] = store.transact(
    mut again,
    step,
    9u8
  )
  check(made == Ok(9), f"{name}: commit after recovery failed")?
  store.close(take again) ? Store
  let Ok(third) = store.open(a, config()) else {
    return Error(Check(f"{name}: third reopen refused"))
  }
  let mut last = take third
  let kept = rows(a, mut last)?
  let want = after(j)
  check(
    kept == want,
    f"{name}: after recovery and commit 9:{keys(kept)}, expected{keys(want)}"
  )?
  Ok(())
}

// What the uncut history's fenced heads must see: the first commit after a
// later claim is refused Fenced and closes the store, so every later use is
// Closed.
const UNCUT: String = " 2:Storage(Fenced) 3:Storage(Closed) 5:Storage(Fenced) close first:Closed close second:Closed"

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  let Ok(stdout) = io.stdout(rt) else {
    return Error(Check("stdout"))
  }
  let mut failures: u64 = 0
  let mut n: u64 = FIRST
  let mut last = false
  while !last && (LAST == 0 || n <= LAST) {
    // The refusing cut decides whether request n is in the history.
    let Ok(f) = io.authority(rt, f"f{n}") else {
      return Error(Check(f"f{n} not granted: the history is longer than the grants"))
    }
    let mut k = Known(low: 0, high: 0, finished: false, stale: "", acked: 0)
    history(f, mut k)
    if k.finished {
      // Cut n is past the history: it finished, uncut.
      last = true
      check(n > FIRST, f"request {FIRST} was not cut")?
      if k.stale != UNCUT {
        failures += 1
        let _ = out.print(stdout, f"uncut: fenced heads saw{k.stale}\n")
      }
    } else {
      let name = f"{KIND}{n}"
      let Ok(a) = io.authority(rt, name) else {
        return Error(Check(f"{name} not granted"))
      }
      let mut cut = Known(low: 0, high: 0, finished: false, stale: "", acked: 0)
      if KIND == "f" {
        cut = k
      } else {
        history(a, mut cut)
      }
      if let Error(e) = recover(a, name, cut) {
        failures += 1
        let line = match e {
          Check(what) => what,
          Store(_) => f"{name}: store error",
        }
        let _ = out.print(stdout, f"{line}\n")
      }
    }
    n += 1
  }
  let _ = out.print(stdout, f"fences: {failures}\n")
  Ok(())
}

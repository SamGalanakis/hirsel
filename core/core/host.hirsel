// Module `host`: the provider operations (CAP-5), with `stdout.write`,
// `stdout.write_bytes`, `stderr.write` and `stderr.write_bytes`, exactly these.
// Other(DEVICE_READ_UNAVAILABLE) from ReadDevice means this file system
// cannot supply an uncached read. Other failures retain their host error.
pub const DEVICE_READ_UNAVAILABLE: u32 = 0x40000001

pub fn open(d: Dir, p: String, mode: OpenMode) -> Result[HostFile, IoError] waits

/// Appends into spare capacity. Ok(0) means EOF. No room gives Error(Other(22)).
pub fn read(mut f: HostFile, mut buf: Bytes) -> Result[u64, IoError] waits

pub fn write(mut f: HostFile, b: Bytes) -> Result[(), WriteError] waits

pub fn open_dir(d: Dir, p: String) -> Result[Dir, IoError] waits

pub fn read_only(d: Dir) -> Dir

pub fn entries(d: Dir, at: Option[String]) -> Result[HostEntries, IoError] waits

pub fn next_entries(mut h: HostEntries, mut buf: Bytes) -> Result[u64, IoError] waits

pub fn stat(d: Dir, p: String) -> Result[Stat, IoError] waits

pub fn stat_file(mut f: HostFile) -> Result[Stat, IoError] waits

/// Like read at the supplied offset, leaving the cursor unchanged.
pub fn read_at(mut f: HostFile, at: u64, mut buf: Bytes) -> Result[u64, IoError] waits

pub fn write_at(mut f: HostFile, at: u64, b: Bytes) -> Result[(), WriteError] waits

pub fn close(take f: HostFile) -> Result[(), IoError] waits

pub fn try_lock(mut f: HostFile) -> Result[bool, IoError] waits

pub fn try_lock_shared(mut f: HostFile) -> Result[bool, IoError] waits

pub fn zero_at(mut f: HostFile, at: u64, len: u64) -> Result[(), IoError] waits

pub fn unlock(mut f: HostFile) -> Result[(), IoError] waits

pub fn mkdir(d: Dir, p: String) -> Result[(), IoError] waits

pub fn mkdtemp(d: Dir, mut name: String) -> Result[Dir, IoError] waits

pub fn mkstemp(d: Dir, mut name: String) -> Result[HostFile, IoError] waits

pub fn remove(d: Dir, p: String) -> Result[(), IoError] waits

pub fn remove_tree(d: Dir, p: String) -> Result[(), IoError] waits

pub fn rename(d: Dir, from: String, to: String) -> Result[(), IoError] waits

// Flush file data and the metadata needed to read it back (fdatasync).
pub fn sync(mut f: HostFile) -> Result[(), IoError] waits

// Flush directory entry updates (fsync on the granted directory).
pub fn sync_dir(d: Dir) -> Result[(), IoError] waits

/// Whether a crashed extension can expose only zeros or bytes written there.
pub fn zero_extension(d: Dir) -> Result[bool, IoError] waits

/// Fills the entire writable capacity and sets the length to capacity. Zero capacity raises Bounds.
pub fn random(r: Random, mut b: Bytes)

pub fn wall_ms(c: Clock) -> u64

pub fn mono_ns(c: Clock) -> u64

pub fn boot_ns(c: Clock) -> u64

pub fn sleep_until(c: Clock, deadline_ns: u64) waits

pub fn sleep_until_wall(c: Clock, at_ms: u64) waits

pub fn stopped(p: Process) waits

pub fn connect(n: Net, a: Addr, until: Until) -> Result[Socket, NetError] waits

pub fn resolve(n: Net, name: String, mut out: List[Ip], until: Until) -> Result[u64, NetError] waits

pub fn listen(n: Net, a: Addr, backlog: u16) -> Result[(Listener, Addr), NetError] waits

pub fn accept(mut l: Listener, until: Until) -> Result[(Socket, Addr), NetError] waits

pub fn recv_bounded(mut r: ReadHalf, mut buf: Bytes, max_receive: u64, until: Until) -> Result[u64, NetError] waits

pub fn recv_ready(mut r: ReadHalf, until: Until) -> Result[(), NetError] waits

pub fn send_pair(mut w: WriteHalf, prefix: Bytes, tail: Bytes, until: Until) -> Result[u64, NetError] waits

pub fn connect_unix(n: Net, root: String, path: String, until: Until) -> Result[Socket, NetError] waits {
    if target.os == (Ios : target.Os) {
        target.unsupported("Unix socket naming needs `pthread_fchdir_np`, which iOS does not offer")
    } else {
        connect_unix_raw(n, root, path, until)
    }
}

fn connect_unix_raw(n: Net, root: String, path: String, until: Until) -> Result[Socket, NetError] waits

pub fn listen_unix(n: Net, root: String, path: String, backlog: u16) -> Result[UnixListener, NetError] waits {
    if target.os == (Ios : target.Os) {
        target.unsupported("Unix socket naming needs `pthread_fchdir_np`, which iOS does not offer")
    } else {
        listen_unix_raw(n, root, path, backlog)
    }
}

fn listen_unix_raw(n: Net, root: String, path: String, backlog: u16) -> Result[UnixListener, NetError] waits


pub type Purpose: key = Describe | Check | Copy

pub type Part: send {
    name: String,
    amount: u64
}

pub type Need: send {
    total: u64,
    parts: List[Part]
}

pub opaque type PreparedCapture: send {
    purpose: Purpose,
    state: capture.PreparedState
}

fn capture_need_part(mut n: Need, name: String, amount: u64) {
    n.total = capture.capture_add(n.total, amount)
    list.push(mut n.parts, Part(name: clone(name), amount: amount))
}

pub fn capture_need(p: PreparedCapture) -> Need {
    let mut n = Need(total: 0, parts: list.with_capacity(8))
    capture_need_part(mut n, "bootstrap", capture.capture_bootstrap(p.state))
    capture_need_part(mut n, "segments", capture.capture_mul(capture.SEG, capture.prepared_segment_count(p.state)))
    if p.purpose != Describe {
        capture_need_part(mut n, "lists", capture.capture_mul(capture.CAPTURE_LIST_ROW, capture.capture_list_slots(p.state)))
        capture_need_part(mut n, "bitmaps", 2 * capture.capture_bitmap_bytes(p.state))
        capture_need_part(mut n, "branches", capture.CAPTURE_BRANCH * capture.capture_branch_slots(capture.prepared_manifest(p.state).limits))
        capture_need_part(mut n, "chunk", journal.JOURNAL_CHUNK_BYTES)
        if p.purpose == Copy {
            capture_need_part(mut n, "copy chunk", journal.JOURNAL_CHUNK_BYTES)
        }
        capture_need_part(mut n, "scratch", capture.CAPTURE_PATH + capture.CAPTURE_SCRATCH)
        return take n
    }
    capture_need_part(mut n, "held", capture.capture_mul(capture.PACK_HELD, capture.capture_add(capture.prepared_lists(p.state).pack_rows, capture.prepared_lists(p.state).pages)))
    capture_need_part(mut n, "deltas", capture.capture_mul(32, int.widen(capture.prepared_manifest(p.state).next_table)))
    capture_need_part(mut n, "catalog", capture.capture_add(capture.capture_mul(capture.NAME_SLOT, capture.prepared_names(p.state)), capture.prepared_name_bytes(p.state)))
    capture_need_part(mut n, "chunk", journal.JOURNAL_CHUNK_BYTES)
    capture_need_part(mut n, "scratch", capture.CAPTURE_SCRATCH)
    take n
}

pub fn prepare(d: Dir, c: Clock, purpose: Purpose) -> Result[PreparedCapture, Error] waits {
    let lock: Option[capture.CaptureLock] = match purpose {
        Describe => None,
        Check => Some(failure_result_from_rep(capture.check_lock(d, c))?),
        Copy => Some(failure_result_from_rep(capture.backup_lock(d))?),
    }
    let prepared = match take lock {
        Some(take held) => capture.prepare_locked(c, take held),
        None => capture.prepare_live(d, c),
    }
    let state = failure_result_from_rep(take prepared)?
    Ok(PreparedCapture(purpose, state: take state))
}

pub const BOOTSTRAP: u64 = capture.BOOTSTRAP

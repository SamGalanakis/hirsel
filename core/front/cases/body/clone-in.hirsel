// MEM-17: copy a region value to another region at its original encoding width.
// expect: run again() = 15
@compact(u32)
type Span2 {
    start: u64,
    end: u64
}

fn again() -> u64 {
    region r {
        match make_span2(r, 5, 10) {
            Ok(s) => region q {
                let t: Span2 in q = clone_in(q, s)
                t.start + t.end
            },
            Error(_) => 998,
        }
    }
}

fn make_span2(r: Region, start: u64, end: u64) -> Result[Span2 in r, Capacity] {
    match build_in(r, bytes 16, fn(mut d: Dest[Span2]) -> Result[Child[Span2], BuildError] {
        dest.put(mut d, Span2(start: start, end: end))
    }) {
        Ok(take built) => Ok(finish(take built)),
        Error(Overflow) => fail("fixed document size"),
    }
}

// A nested Text keeps the source blob's u16 width but copies only its own
// encoding. Its 2-byte count plus five bytes of text admit 8 bytes.
@compact(u16)
type Label {
    n: u64,
    text: Text,
}

fn label(r: Region) -> Result[Label in r, BuildError] {
    let b = build_in(r, bytes 64, fn(mut d: Dest[Label]) -> Result[Child[Label], BuildError] {
        dest.put(mut d, Label(n: 41, text: "sheep"))
    })?
    Ok(finish(take b))
}

// expect: run copy_nested() = true
fn copy_nested() -> bool {
    region source {
        let holder = result.unwrap(label(source))
        match (bound bytes 8 {
            region out {
                let t: Text in out = clone_in(out, holder.text)
                text.as_string(t) == "sheep"
            }
        }) {
            Ok(equal) => equal,
            Error(_) => false,
        }
    }
}

@compact(u32)
type Expr = Num(u64) | Add(Link[Expr], Link[Expr])

fn tree(r: Region) -> Result[Expr in r, BuildError] {
    let b = build_in(r, bytes 64, fn(mut d: Dest[Expr]) -> Result[Child[Expr], BuildError] {
        let a = dest.put(mut d, Num(2))?
        let b = dest.put(mut d, Num(5))?
        dest.put(mut d, Add(a, b))
    })?
    Ok(finish(take b))
}

fn sum(e: Expr) -> u64 {
    match e {
        Num(n) => n,
        Add(a, b) => sum(a) + sum(b),
    }
}

// The three encodings are 9 bytes each. The clone copies the used 27-byte
// prefix, admits 32, and keeps the Add root's offset within that prefix.
// expect: run copy_linked(32) = 7
// expect: run copy_linked(31) = 3231 used 32
fn copy_linked(limit: u64) -> u64 {
    let outer = isolate(fn() -> Result[u64, Capacity] {
        region source {
            let root = result.unwrap(tree(source))
            bound bytes limit {
                region out {
                    let copied: Expr in out = clone_in(out, root)
                    sum(copied)
                }
            }
        }
    })
    if let Ok(Ok(Ok(n))) = outer {
        return n
    }
    match caught(take outer) {
        Some(c) => c.requested * 100 + c.available,
        None => 0,
    }
}

// The primary cause of a caught failure, when it is a refused admission.
fn caught[R](r: Result[Result[R, Causes], Capacity]) -> Option[Capacity] {
    match r {
        Ok(Error(causes)) => {
            for c in causes {
                return match c.kind {
                    Capacity(k) => Some(k),
                    _ => None,
                }
            }
            None
        },
        _ => None,
    }
}

pub opaque type Laws {}
pub opaque type Other {}
pub opaque type Obj {}
pub opaque type B {}
type Mine {}
fn invalid(f: Foreign[Mine]) {}
pub resource type Open { p: foreign.Ptr[Obj] } drop(o) {}
pub opaque resource type ObjBox: send { p: foreign.Ptr[Obj] } drop(o) {}
pub opaque resource type BBox { p: foreign.Ptr[B] } drop(o) {}
type Inner { p: Option[foreign.Ptr[Obj]] }
type Outer { x: Inner }
fn list_escape(p: foreign.Ptr[Obj]) {
    let xs: List[foreign.Ptr[Obj]] = list.new()
}
fn id[T: plain](x: T) -> T { x }
fn generic_escape(p: foreign.Ptr[Obj]) { let q = id(p) }
fn capture(p: foreign.Ptr[Obj]) { let _ = scoped fn() { let _ = p } }
fn kind_mismatch(p: foreign.Ptr[Obj]) { let _ = BBox(p: p) }
fn keep(o: ObjBox) -> List[ObjBox] { list.new() }
fn keep_copy(p: foreign.Ptr[Obj]) { let q = p }

// 35 elements of u8 by a multiply-add over its width, so high and sign bits vary.
fn seq_u8() -> List[u8] {
    let mut xs: List[u8] = list.with_capacity(35)
    let mut x: u8 = 200
    for i in 0u64 .. 35u64 {
        list.push(mut xs, x)

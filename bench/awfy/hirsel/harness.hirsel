// AWFY runs one verified inner loop per outer iteration.
pub fn main(out: Stdout, argv: Args) -> Result[(), Exit] waits {
    let Some(name) = args.get(argv, 0) else {
        return Error(Exit(status: 2))
    }
    let (outer, inner) = iterations(argv)?
    for _ in 0 .. outer {
        match run(name, inner) {
            Ok(true) => {},
            Ok(false) => return Error(Exit(status: 1)),
            Error(_) => return Error(Exit(status: 3)),
        }
        match stdout.write(out, "verified\n") {
            Ok(()) => {},
            Error(_) => return Error(Exit(status: 4)),
        }
    }
    Ok(())
}

pub fn iterations(argv: Args) -> Result[(u64, u64), Exit] {
    let Some(outer_arg) = args.get(argv, 1) else {
        return Error(Exit(status: 2))
    }
    let Some(inner_arg) = args.get(argv, 2) else {
        return Error(Exit(status: 2))
    }
    let parsed_outer: Result[u64, ParseError] = int.parse(outer_arg)
    let outer = match parsed_outer {
        Ok(n) => n,
        Error(_) => return Error(Exit(status: 2)),
    }
    let parsed_inner: Result[u64, ParseError] = int.parse(inner_arg)
    let inner = match parsed_inner {
        Ok(n) => n,
        Error(_) => return Error(Exit(status: 2)),
    }
    if outer == 0 || inner == 0 {
        return Error(Exit(status: 2))
    }
    Ok((outer, inner))
}

fn repeat(inner: u64, check: scoped fn() -> Result[bool, Capacity]) -> Result[bool, Capacity] {
    for _ in 0 .. inner {
        if !check()? {
            return Ok(false)
        }
    }
    Ok(true)
}

// Each workload is its own entry, reached through a function value as Rust's
// harness reaches its per-benchmark entries, so no workload is compiled into the
// dispatcher and one workload's code never shares a register allocation with another's.
type Entry = fn(u64) -> Result[bool, Capacity]

fn run(name: String, inner: u64) -> Result[bool, Capacity] {
    let Some(workload) = entry(name) else {
        return Ok(false)
    }
    workload(inner)
}

fn entry(name: String) -> Option[Entry] {
    if name == "CD" { return Some(run_cd) }
    if name == "Bounce" { return Some(run_bounce) }
    if name == "DeltaBlue" { return Some(run_deltablue) }
    if name == "Havlak" { return Some(run_havlak) }
    if name == "Json" { return Some(run_json) }
    if name == "List" { return Some(run_list) }
    if name == "Mandelbrot" { return Some(run_mandelbrot) }
    if name == "NBody" { return Some(run_nbody) }
    if name == "Permute" { return Some(run_permute) }
    if name == "Queens" { return Some(run_queens) }
    if name == "Richards" { return Some(run_richards) }
    if name == "Sieve" { return Some(run_sieve) }
    if name == "Storage" { return Some(run_storage) }
    if name == "Towers" { return Some(run_towers) }
    None
}

fn run_cd(inner: u64) -> Result[bool, Capacity] {
    cd.benchmark(inner)
}

fn run_bounce(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        Ok(small.bounce() == 1331)
    })
}

fn run_deltablue(inner: u64) -> Result[bool, Capacity] {
    deltablue.benchmark(inner)
}

fn run_havlak(inner: u64) -> Result[bool, Capacity] {
    havlak.benchmark(inner)
}

fn run_json(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        json_parse.benchmark(rap.document())
    })
}

fn run_list(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        Ok(lists.list_benchmark()? == 10)
    })
}

fn run_mandelbrot(inner: u64) -> Result[bool, Capacity] {
    Ok(numeric.mandelbrot(inner))
}

fn run_nbody(inner: u64) -> Result[bool, Capacity] {
    Ok(numeric.nbody(inner))
}

fn run_permute(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        Ok(small.permute() == 8660)
    })
}

fn run_queens(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        Ok(small.queens())
    })
}

fn run_richards(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        richards.benchmark()
    })
}

fn run_sieve(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        Ok(small.sieve() == 669)
    })
}

fn run_storage(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        Ok(trees.storage()? == 5461)
    })
}

fn run_towers(inner: u64) -> Result[bool, Capacity] {
    repeat(inner, fn() -> Result[bool, Capacity] {
        Ok(trees.towers_benchmark()? == 8191)
    })
}

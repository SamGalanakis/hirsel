fn l84_write_blob_pack(mut client: std.object.Client, owner: StoreId, pack_seq: u64, first: u64, frame_count: u64, value_bytes: u64) -> Result[(pages.HistoryRef, pages.PagePack, List[format.TieredTarget]), Error] waits {
    let mut draft = begin_tiered_pack(owner, pack_seq, 4, frame_count * (value_bytes + 64) + 4096)?
    let mut written: List[format.TieredTarget] = list.new()
    for offset in 0u64 .. frame_count {
        let stamp = first + offset
        let mut value: Bytes = list.with_capacity(value_bytes)
        list.fill(mut value, value_bytes, int.truncate(stamp))
        let frame = PackFrame(stamp: stamp, size: value_bytes + 8, body: BlobBody(arc.new(take value)))
        let Some(ptr) = add_tiered_pack_frame(mut draft, frame, 9, log_key(9, stamp)?, scoped fn(expected: u64) -> std.page.PagePtr {
            fail("L84: a BLOB has no owning page edge")
        })? else {
            fail("L84: the fixture BLOBs fit in one pack")
        }
        let reference = std.page.BlobRef(stamp: stamp, len: value_bytes, checksum: ptr.checksum, pack: pack_seq, offset: ptr.offset, body: 0)
        list.push(mut written, TieredBlob(reference))
    }
    let (take raw, pack) = finish_tiered_pack(take draft)?
    let object_ref = history_new_ref(pack_seq, 1, raw)
    let deadline = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    let (take stored, _) = std.object.store(mut client, history_key("p-", object_ref), take raw, deadline)
    let _ = stored ?=> |problem| Remote(problem)
    Ok((object_ref, pack, take written))
}

fn l84_bucket_pager_batch(model: BucketSim, tasks: Tasks, cache: Option[ObjectsCache]) -> Result[(), Error] waits {
    let owner = StoreId(hi: 1, lo: 2)
    let mut client = bucket_law_client_lanes(model, tasks, "s3.test", 802, true, 2)?
    let (first, first_pack, take first_blobs) = l84_write_blob_pack(mut client, owner, 8, 40, 2, 1025)?
    let (second, second_pack, take second_blobs) = l84_write_blob_pack(mut client, owner, 9, 42, 1, 1025)?
    let (large, large_pack, take large_blobs) = l84_write_blob_pack(mut client, owner, 10, 43, 1, 262144)?
    let mut ids = 0u64
    let blank: std.omap.OMap[u64, pages.TieredPagerPack] = std.omap.new()
    let (take first_listed, _) = std.omap.insert(mut ids, blank, first.seq, pages.TieredPagerPack(inventory: first_pack, object: Some(first)))
    let (take both, _) = std.omap.insert(mut ids, first_listed, second.seq, pages.TieredPagerPack(inventory: second_pack, object: Some(second)))
    let (take packs, _) = std.omap.insert(mut ids, both, large.seq, pages.TieredPagerPack(inventory: large_pack, object: Some(large)))
    let mut siblings: List[format.TieredTarget] = list.with_capacity(4)
    list.push(mut siblings, clone(first_blobs[1u64]))
    list.push(mut siblings, clone(first_blobs[0u64]))
    list.push(mut siblings, clone(large_blobs[0u64]))
    list.push(mut siblings, clone(large_blobs[0u64]))
    let demand = TieredPointDemand(target: clone(second_blobs[0u64]), key: types.key_word(42), values: ValuesNone, room: 0, direction: TieredBackward, paths: list.new(), siblings: take siblings, packs: take packs, next_stamp: 44, deadline: 0, grant: None)
    let mut input = PagerObjects(take client, BUCKET_LAW_OP_MS, pack_cache_directory(cache))
    let runs = if let None = cache {
        2u64
    } else {
        3u64
    }
    let mut cache_state = new_tiered_cache(1048576)
    for pass in 0u64 .. runs {
        if let Some(local) = cache {
            cache_state = new_tiered_cache(1048576)
            if pass == 2 {
                corrupt_one_cached_pack(local.dir, true)
            }
        }
        let delivered = tiered_pager_point(mut input, mut cache_state, owner, demand)?
        if let Some(_) = delivered.failure {
            fail("L84: all requested frames exist")
        }
        if list.len(delivered.frames) != 5 || delivered.frames[0u64].identity.stamp != 42 || delivered.frames[1u64].identity.stamp != 41 || delivered.frames[2u64].identity.stamp != 40 || delivered.frames[3u64].identity.stamp != 43 || delivered.frames[4u64].identity.stamp != 43 {
            fail("L84: the pager must deliver the requested target and siblings in logical order")
        }
    }
    Ok(())
}

// A demand with several key paths (§13.3 "Batched point misses") delivers
// each path's frames in path order, a frame two paths share once per path,
// and reads the paths' frames as one batch: one GET per pack.
fn l84_bucket_pager_paths(model: BucketSim, tasks: Tasks) -> Result[(), Error] waits {
    let owner = StoreId(hi: 1, lo: 2)
    let mut client = bucket_law_client_lanes(model, tasks, "s3.test", 802, true, 2)?
    let (first, first_pack, take first_blobs) = l84_write_blob_pack(mut client, owner, 8, 40, 2, 1025)?
    let (second, second_pack, take second_blobs) = l84_write_blob_pack(mut client, owner, 9, 42, 1, 1025)?
    let mut ids = 0u64
    let blank: std.omap.OMap[u64, pages.TieredPagerPack] = std.omap.new()
    let (take first_listed, _) = std.omap.insert(mut ids, blank, first.seq, pages.TieredPagerPack(inventory: first_pack, object: Some(first)))
    let (take packs, _) = std.omap.insert(mut ids, first_listed, second.seq, pages.TieredPagerPack(inventory: second_pack, object: Some(second)))
    let mut paths: List[TieredPath] = list.with_capacity(3)
    list.push(mut paths, TieredPath(target: clone(first_blobs[1u64]), key: types.key_word(41), values: ValuesNone))
    list.push(mut paths, TieredPath(target: clone(second_blobs[0u64]), key: types.key_word(42), values: ValuesNone))
    list.push(mut paths, TieredPath(target: clone(first_blobs[0u64]), key: types.key_word(40), values: ValuesNone))
    let demand = TieredPointDemand(target: clone(second_blobs[0u64]), key: types.key_word(42), values: ValuesNone, room: 0, direction: TieredForward, paths: take paths, siblings: list.new(), packs: take packs, next_stamp: 43, deadline: 0, grant: None)
    let mut input = PagerObjects(take client, BUCKET_LAW_OP_MS, None)
    let mut cache_state = new_tiered_cache(1048576)
    let delivered = tiered_pager_point(mut input, mut cache_state, owner, demand)?
    if let Some(_) = delivered.failure {
        fail("L84: every path's frame exists")
    }
    if list.len(delivered.frames) != 4 || delivered.frames[0u64].identity.stamp != 42 || delivered.frames[1u64].identity.stamp != 41 || delivered.frames[2u64].identity.stamp != 42 || delivered.frames[3u64].identity.stamp != 40 {
        fail("L84: a multi-path demand delivers each path's frames in path order")
    }
    Ok(())
}

// A demand that reads values (§13.3 "Values") delivers, after the leaf, the
// BLOB of the row at its key, then a forward scan's later values in key
// order while their charges (16 + 8 + 1,025 = 1,049 bytes each) fit its room.
fn l84_bucket_pager_values(model: BucketSim, tasks: Tasks) -> Result[(), Error] waits {
    let owner = StoreId(hi: 1, lo: 2)
    let mut client = bucket_law_client_lanes(model, tasks, "s3.test", 802, true, 2)?
    let (blobs, blob_pack, take refs) = l84_write_blob_pack(mut client, owner, 8, 40, 3, 1025)?
    let mut rows: List[std.page.Entry] = list.with_capacity(3)
    for row in 0u64 .. 3 {
        let TieredBlob(reference) = view refs[row] else {
            fail("L84: the fixture writes BLOBs")
        }
        // A leaf numbers its BLOB bodies in slot order.
        let numbered = std.page.BlobRef(stamp: reference.stamp, len: reference.len, checksum: reference.checksum, pack: reference.pack, offset: reference.offset, body: int.truncate(row))
        list.push(mut rows, std.page.Entry(key: types.key_word(row + 1), cell: BlobValue(numbered)))
    }
    let image = failure_result_from_rep(pages.page_result(std.page.encode(rows, 0, 43, Collection)))?
    let page = failure_result_from_rep(pages.page_result(std.page.attach_cold(take image)))?
    let mut draft = begin_tiered_pack(owner, 9, 3, 8192)?
    let width = std.page.sealed_size(std.page.image_of(page))
    let frame = PackFrame(stamp: 43, size: width, body: PageBody(take page))
    let Some(leaf) = add_tiered_pack_frame(mut draft, frame, 9, logical_key(9, types.key_word(1))?, fn(stamp: u64) -> std.page.PagePtr {
        std.page.unlocated(stamp)
    })? else {
        fail("L84: the leaf fits its pack")
    }
    let (take raw, leaf_pack) = finish_tiered_pack(take draft)?
    let leaves = pages.HistoryRef(seq: 9, epoch: 1, len: list.len(raw), digest: 88)
    let deadline = std.object.deadline_after_ms(client, BUCKET_LAW_OP_MS)
    let (take stored, _) = std.object.store(mut client, history_key("p-", leaves), take raw, deadline)
    let _ = stored ?=> |problem| Remote(problem)
    let mut ids = 0u64
    let blank: std.omap.OMap[u64, pages.TieredPagerPack] = std.omap.new()
    let (take one, _) = std.omap.insert(mut ids, blank, blobs.seq, pages.TieredPagerPack(inventory: blob_pack, object: Some(blobs)))
    let (take packs, _) = std.omap.insert(mut ids, one, leaves.seq, pages.TieredPagerPack(inventory: leaf_pack, object: Some(leaves)))
    let mut input = PagerObjects(take client, BUCKET_LAW_OP_MS, None)
    let mut cache_state = new_tiered_cache(1048576)
    // (values, room, the delivered frames: the leaf (43), then the BLOBs of
    // keys 2 (41) and 3 (42) while delivered, held)
    let mut cases: List[(TieredValues, u64, u64, u64)] = list.new()
    list.push(mut cases, (ValuesNone, 1048576, 1u64, 0u64))
    list.push(mut cases, (ValuesAt, 0, 2u64, 0u64))
    list.push(mut cases, (ValuesFrom, 1048, 2u64, 0u64))
    list.push(mut cases, (ValuesFrom, 1049, 3u64, 2u64))
    for (values, room, delivered_count, held) in cases {
        let mut stamps: List[u64] = list.new()
        for at in 0u64 .. delivered_count {
            list.push(mut stamps, if at == 0 {
                43u64
            } else {
                40 + at
            })
        }
        let direction = if let ValuesFrom = values {
            TieredForward
        } else {
            TieredPoint
        }
        let demand = TieredPointDemand(target: TieredPage(clone(leaf)), key: types.key_word(2), values: clone(values), room: room, direction: direction, paths: list.new(), siblings: list.new(), packs: std.omap.snapshot(packs), next_stamp: 44, deadline: 0, grant: None)
        let delivered = tiered_pager_point(mut input, mut cache_state, owner, demand)?
        if let Some(_) = delivered.failure {
            fail("L84: every value's BLOB exists")
        }
        let mut got: List[u64] = list.new()
        for item in delivered.frames {
            list.push(mut got, item.identity.stamp)
        }
        if got != stamps || delivered.held != held {
            fail("L84: a demand delivers its leaf, the value at its key, then later values within its room")
        }
    }
    Ok(())
}

fn l84_branch_scan_demands(reverse: bool) -> Result[(), Error] {
    let mut children: List[std.page.Entry] = list.new()
    for child in 0u64 .. 3 {
        let separator: Bytes = if child == 0 {
            list.new()
        } else {
            types.key_word(child + 1)
        }
        let ptr = std.page.PagePtr(pack: 8 + child, offset: 72, len: 80, checksum: child, stamp: 40 + child)
        list.push(mut children, std.page.Entry(key: take separator, cell: Child(std.page.Branch(child: ptr, rows: 1, charge: 86))))
    }
    let image = failure_result_from_rep(pages.page_result(std.page.encode(children, 1, 43, Collection)))?
    let root: std.page.Slot = HotPage(failure_result_from_rep(pages.page_result(std.page.attach_cold(take image)))?)
    let visible: Map[TieredCacheKey, Arc[format.TieredFrame]] = map.new()
    let attempt = tiered_attempt(4096, 8)
    let failed = tiered_scan_edge(attempt, visible, root, None, types.key_word(1), None, reverse)
    let Error(Missed) = failed else {
        fail("L84: the selected child is Cold")
    }
    let Some(AttemptMiss(target)) = tiered_attempt_state(attempt).stopped else {
        fail("L84: the first miss must name its target")
    }
    let begin = if reverse {
        42u64
    } else {
        40u64
    }
    let end = if reverse {
        40u64
    } else {
        42u64
    }
    if format.tiered_frame_id(target).stamp != begin || list.len(tiered_attempt_state(attempt).siblings) != 2 || format.tiered_frame_id(tiered_attempt_state(attempt).siblings[0u64]).stamp != 41 || format.tiered_frame_id(tiered_attempt_state(attempt).siblings[1u64]).stamp != end {
        fail("L84: the demanded siblings must follow the scan direction")
    }
    Ok(())
}

@test
fn test_l84_pager_coalesces_sibling_demands(c: Clock, tasks: Tasks) -> Result[(), Error] waits {
    l84_branch_scan_demands(false)?
    l84_branch_scan_demands(true)?
    let model = bucket_law_sim(tasks, c, 8464, None, list.new())
    let result = l84_bucket_pager_batch(model, tasks, None)
    let report = bucket_law_report(take model)
    result?
    // Three PUTs and one cold GET per pack, including the shared 262,168-byte
    // frame. The second demand is fully cached.
    if report.attempts != 6 {
        fail("L84: nearby frames and duplicate oversized ranges share a GET")
    }
    let paths_model = bucket_law_sim(tasks, c, 8465, None, list.new())
    let paths_result = l84_bucket_pager_paths(paths_model, tasks)
    let paths_report = bucket_law_report(take paths_model)
    paths_result?
    // Two PUTs and one GET per pack: the three distinct frames of four paths
    // are read as one batch.
    if paths_report.attempts != 4 {
        fail("L84: the frames of a demand's paths share a GET per pack")
    }
    let values_model = bucket_law_sim(tasks, c, 8466, None, list.new())
    let values_result = l84_bucket_pager_values(values_model, tasks)
    let _ = bucket_law_report(take values_model)
    values_result?
    Ok(())
}

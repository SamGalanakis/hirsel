type TieredWritePlan {
    tree: PageTree,
    deltas: List[Option[format.TieredDataDelta]],
    next_stamp: u64,
    freed: TieredFreed
}

fn tiered_staged_value(op: format.DataOp) -> Result[ReplayValue, Error] {
    match op.value {
        Some(BlobBody(raw)) => Ok(ReplayPut(arc.share(raw))),
        Some(PageValue(raw)) => Ok(ReplayPut(arc.new(failure_result_from_rep(types.copied(raw))?))),
        None => Ok(ReplayAbsent),
    }
}

fn tiered_stage_collection_edit(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], staged: PageTree, logical: format.DataOp, prior: u32, private_from: u64, mut next_stamp: u64) -> Result[(Arc[std.page.Page], Bytes, format.TieredDataDelta), Error] {
    let id = list.slice(logical.key, 0, 4)
    let Some((root, descriptor)) = std.page.collection_slot(staged.root, id) else {
        return Error(Stale(list.word_be(id, 0)))
    }
    let Some(empty_root) = view staged.empty_collection else {
        fail("store: missing empty collection page")
    }
    let fields = collection_descriptor(descriptor)
    let kind = fields.kind
    if let Some(trim) = logical.trim {
        let limits = descriptor_bounds(descriptor)
        let before = fields.row_bytes
        let (take ready, dropped) = stage_tiered_trim(attempt, visible, root, empty_root, limits, before, trim.floor, mut next_stamp)?
        let revised = log_record(ready, trim.floor, order.max(limits.next, trim.floor), ResidentTiered)?
        return Ok((take ready, take revised, TieredDropped(dropped)))
    }
    let key = list.slice(logical.key, 4, list.len(logical.key))
    let value = tiered_staged_value(logical)?
    let ready = stage_tiered_row(attempt, visible, root, empty_root, key, value, staged.inline, kind == LogCollection, private_from, mut next_stamp)?
    let revised = if kind == LogCollection {
        let limits = descriptor_bounds(descriptor)
        log_record(ready, limits.first, stamp_after(limits.next)?, ResidentTiered)?
    } else {
        rooted_collection_record(ready, descriptor_kind_byte(kind), ResidentTiered)?
    }
    Ok((take ready, take revised, TieredPrior(prior)))
}

fn tiered_wait_for_fold(attempt: core.Cell[TieredTouchSet], base: PageTree, operations: DataRows, order: format.DataOrder) -> Result[(), Error] {
    if tiered_stopped(attempt) {
        return Error(Missed)
    }
    let Some(overlays) = view base.replay else {
        return Ok(())
    }
    for slot in 0u64 .. data_row_count(operations) {
        let op = ordered_row(operations, order, slot)
        let collection: u32 = list.word_be(op.key, 0)
        if let Some(_) = std.omap.get(overlays.collections, collection) {
            tiered_latch(attempt, AttemptFold(collection))
            return Error(Missed)
        }
    }
    Ok(())
}

// The original root supplies every previous value. Sequential edits take
// siblings from the private candidate's shape, including after an earlier merge.
fn prepare_tiered_writes(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], base: PageTree, operations: DataRows, order: format.DataOrder, first_stamp: u64) -> Result[TieredWritePlan, Error] {
    tiered_wait_for_fold(attempt, base, operations, order)?
    let mut staged = share_page_tree(base)
    let mut deltas: List[Option[format.TieredDataDelta]] = list.new()
    failure_result_from_rep(types.capacity(list.try_reserve(mut deltas, data_row_count(operations))))?
    let inline = staged.inline
    let mut draw = first_stamp
    let mut touched: List[PlannedCollection] = list.new()
    for slot in 0u64 .. data_row_count(operations) {
        let op = ordered_row(operations, order, slot)
        let id = list.slice(op.key, 0, 4)
        let Some(descriptor) = std.page.lookup(base.root, id) else {
            return Error(Stale(list.word_be(id, 0)))
        }
        if collection_descriptor(descriptor).residency == ResidentMemory {
            list.push(mut deltas, None)
            continue
        }
        let sought = match op.trim {
            Some(trim) => types.key_word(trim.floor),
            None => failure_result_from_rep(types.copied(list.slice(op.key, 4, list.len(op.key))))?,
        }
        tiered_seek(attempt, SeekKey(take sought))
        let prior = match op.trim {
            None => tiered_plan_prior(attempt, visible, base, op.key)?,
            Some(_) => 0u32,
        }
        let (take ready, take revised, delta) = tiered_stage_collection_edit(attempt, visible, staged, op, prior, first_stamp, mut draw)?
        page_result(std.page.insert(mut staged.root, id, revised, Some(take ready), inline, first_stamp, mut draw))?
        restore_planned_root(mut staged.root, id, first_stamp, visible, mut draw)?
        list.push(mut deltas, Some(delta))
        note_planned_collection(mut touched, id, match op.trim {
            Some(_) => true,
            None => false
        })?
        tiered_seek(attempt, SeekOperation)
    }
    let freed = planned_freed(base, staged, touched, first_stamp, visible)?
    Ok(TieredWritePlan(tree: take staged, deltas: take deltas, next_stamp: draw, freed: take freed))
}

// A loaded Cold page the edit left unchanged goes back to its location, as
// the fold's restore does, so the cut never re-emits a stamp it already has.
fn restore_planned_root(mut root: Arc[std.page.Page], id: Bytes, first_stamp: u64, visible: Map[TieredCacheKey, Arc[format.TieredFrame]], mut draw: u64) -> Result[(), Error] {
    let held: Option[Arc[std.page.Page]] = match std.page.collection_slot(root, id) {
        Some((HotPage(page), _)) => Some(arc.share(page)),
        _ => None,
    }
    let Some(take page) = take held else {
        return Ok(())
    }
    let restored = restore_fold_slots(take page, first_stamp, visible)
    page_result(std.page.install_tiered_root(mut root, id, restored, mut draw))
}

// Operations come in key order, so one collection's edits are adjacent.
type PlannedCollection {
    id: Bytes,
    trimmed: bool
}

fn note_planned_collection(mut touched: List[PlannedCollection], id: Bytes, trimmed: bool) -> Result[(), Error] {
    let noted = list.len(touched)
    if noted != 0 && list.compare_bytes(touched[noted - 1].id, id) == Equal {
        if trimmed {
            touched[noted - 1].trimmed = true
        }
        return Ok(())
    }
    failure_result_from_rep(types.capacity(list.try_reserve(mut touched, 1)))?
    list.push(mut touched, PlannedCollection(id: failure_result_from_rep(types.copied(id))?, trimmed: trimmed))
    Ok(())
}

// The commit's replaced and dropped lists (§13.6a T8, §13.8): the Cold
// frames each touched collection's deciding root reached and its planned
// root no longer does. A floor's detached subtrees and blobs are dropped
// rows; loaded pages and the edges a write replaced are replaced rows.
fn planned_freed(base: PageTree, staged: PageTree, touched: List[PlannedCollection], first_stamp: u64, visible: Map[TieredCacheKey, Arc[format.TieredFrame]]) -> Result[TieredFreed, Error] {
    let mut freed = no_tiered_freed()
    for collection in touched {
        let Some((before, _)) = std.page.collection_slot(base.root, collection.id) else {
            continue
        }
        let Some((after, _)) = std.page.collection_slot(staged.root, collection.id) else {
            continue
        }
        let effects = folded_step_effects(before, after, first_stamp, visible, collection.trimmed)?
        for take effect in take effects {
            match take effect {
                FoldReplaced(frame) => {
                    failure_result_from_rep(types.capacity(list.try_reserve(mut freed.replaced, 1)))?
                    list.push(mut freed.replaced, frame)
                },
                FoldDropped(take target) => {
                    failure_result_from_rep(types.capacity(list.try_reserve(mut freed.dropped, 1)))?
                    list.push(mut freed.dropped, take target)
                },
            }
        }
    }
    Ok(take freed)
}

fn plan_tiered_edits(base: PageTree, attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], ops: DataRows, order: format.DataOrder, first: u64) -> Result[Option[TieredWritePlan], Error] {
    for slot in 0u64 .. data_row_count(ops) {
        if tiered_data_key(base, data_row(ops, slot).key) {
            return Ok(Some(prepare_tiered_writes(attempt, visible, base, ops, order, first)?))
        }
    }
    Ok(None)
}

type TieredIndexChunk = ChunkReady(TieredWritePlan, List[StepOp]) | ChunkDuplicate(Bytes, Bytes)

fn index_build_has_overlay(tree: PageTree, id: u32) -> bool {
    if let Some(replay) = view tree.replay {
        if let Some(_) = std.omap.get(replay.collections, id) {
            return true
        }
    }
    false
}

// A schema chunk uses the writer's attempt partition. Its prepared roots
// and replacements belong to the cut candidate until MANIFEST publication.
fn prepare_tiered_index_chunk(mut db: Db, record: Catalog, rows: List[(Bytes, Bytes)]) -> Result[TieredIndexChunk, Error] waits {
    let mut pins = empty_tiered_pins(call_pin_root(db, 0), db.writer_pin_bytes)
    let mut pending: Option[(format.TieredTarget, Error)] = None
    loop {
        let attempt = tiered_attempt(db.writer_pin_bytes, tiered_window(pins))
        let prepared = disk_allocation(scoped fn() -> Result[Result[TieredIndexChunk, Error], Error] {
            let Some(extractor) = bound_extractor(db.indexes, record) else {
                return Error(Stale(record.id))
            }
            let first = stamp_after(db.next_node)?
            Ok(draft_tiered_index_chunk(attempt, pins.frames, db.heads[0].roots.collections, record, extractor, rows, first))
        })
        let state = tiered_finish(take attempt)
        match state.stopped {
            None => return (take prepared)?,
            Some(AttemptMiss(_)) => {
                revoke_parked(mut db)
                deliver_call_miss(db, db.heads[0].roots.collections, state, mut pins, mut pending)?
            },
            Some(AttemptPinLimit(problem)) => return Error(Full(Cache(problem))),
            Some(AttemptAllocation(problem)) => return Error(Full(Allocation(problem))),
            Some(AttemptFold(_)) => fail("store: the index builder planned over a replay overlay"),
        }
    }
}

fn draft_tiered_index_chunk(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], tree: PageTree, record: Catalog, extractor: RegisteredIndex, rows: List[(Bytes, Bytes)], first: u64) -> Result[TieredIndexChunk, Error] {
    let shape = catalog_index(record)?.shape
    let Some((edge, _)) = std.page.collection_slot(tree.root, prefix(record.id)?) else {
        return Error(Stale(record.id))
    }
    let mut operations = empty_ops()
    let no_layers: List[Arc[Staged]] = list.new()
    let mut row_count = 0u64
    for (logical, raw) in rows {
        let primary = list.slice(logical, 4, list.len(logical))
        let IndexValue(keys: take keys, payload: take payload, sums: sums) = (extractor.extract)(raw, primary)?
        let mut part = 0u64
        for take key in take keys {
            if list.len(key) > 4096 {
                return Error(Limit(Key))
            }
            let prior: Option[Arc[Bytes]] = if let Entries(Many) = shape {
                None
            } else {
                tiered_chunk_prior(attempt, visible, edge, operations, key)?
            }
            let value = match shape {
                Entries(Unique) => {
                    if let Some(value) = view prior {
                        let owner = list.slice(value, 4, unique_owner_end(value)?)
                        if owner != primary {
                            return Ok(ChunkDuplicate(failure_result_from_rep(types.copied(owner))?, failure_result_from_rep(types.copied(primary))?))
                        }
                    }
                    failure_result_from_rep(types.copied(payload))?
                },
                Entries(Many) => failure_result_from_rep(types.copied(payload))?,
                Sums => {
                    let (members, sum) = match prior {
                        Some(body) => group_totals(body)?,
                        None => (0u64, 0u64),
                    }
                    let Some(total) = int.checked_add(sum, sums[part]) else {
                        return Error(Limit(Value))
                    }
                    totals_bytes(members + 1, total)?
                },
            }
            part += 1
            let _ = save_data_op(mut operations, no_layers, false, mut row_count, take key, Some(stage_value(take value, tree.inline)), None)
        }
    }
    let order = failure_result_from_rep(types.capacity(data_order(operations.rows)))?
    let write_plan = prepare_tiered_writes(attempt, visible, tree, operations.rows, order, first)?
    let mut step_rows: List[StepOp] = list.with_capacity(data_row_count(operations.rows))
    for slot in 0u64 .. data_row_count(operations.rows) {
        let op = ordered_row(operations.rows, order, slot)
        let prior = match write_plan.deltas[slot] {
            Some(TieredPrior(w)) => w,
            _ => 0u32,
        }
        let val: Option[Bytes] = match op.value {
            Some(BlobBody(raw)) => Some(failure_result_from_rep(types.copied(raw))?),
            Some(PageValue(raw)) => Some(failure_result_from_rep(types.copied(raw))?),
            None => None,
        }
        list.push(mut step_rows, StepOp(key: failure_result_from_rep(types.copied(op.key))?, value: take val, prior: prior))
    }
    Ok(ChunkReady(take write_plan, take step_rows))
}

fn tiered_chunk_prior(attempt: core.Cell[TieredTouchSet], visible: Map[TieredCacheKey, Arc[format.TieredFrame]], edge: std.page.Slot, staged: DataOps, key: Bytes) -> Result[Option[Arc[Bytes]], Error] {
    if let Some(slot) = op_slot(staged, key) {
        let raw = data_row(staged.rows, slot).value
        return Ok(match raw {
            Some(BlobBody(body)) => Some(arc.share(body)),
            Some(PageValue(body)) => Some(arc.new(failure_result_from_rep(types.copied(body))?)),
            None => None,
        })
    }
    let suffix = list.slice(key, 4, list.len(key))
    tiered_seek(attempt, SeekKey(failure_result_from_rep(types.copied(suffix))?))
    tiered_reading(attempt, ValuesAt)
    let selected = tiered_point_path(attempt, visible, edge, None, suffix)?
    tiered_seek(attempt, SeekOperation)
    Ok(take selected)
}

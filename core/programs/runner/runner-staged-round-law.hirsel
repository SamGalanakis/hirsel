// L61. The head seals a real Directory ticket, and the publisher prepares
// its update before the head calls durable. Only the Release installs it.
fn staged_law_table(mut d: store.Declare) -> Result[store.Table[u64, u64], store.Error] {
    let declared = store.declare_table(mut d, "data", std.codec.key_u64(), std.codec.of_u64())?
    store.finish(mut d, take declared)
}

fn staged_law_write(mut tx: store.Tx, data: store.Table[u64, u64]) -> Result[(), store.Error] {
    store.put(mut tx, data, 0u64, 2u64)?
    store.put(mut tx, data, 1u64, 7u64)
}

fn staged_round_checks(d: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), String] waits {
    let mut name = string.with_capacity(64u64)
    let dir = result.unwrap(std.dir.create_temp(d, mut name))
    let opts = result.unwrap(store.sized(Directory, 134217728u64))
    let mut db = result.unwrap(store.open(tasks, dir, clock, random, opts))
    let mut schema = result.unwrap(store.declare(db, Migrate))
    let data = result.unwrap(staged_law_table(mut schema))
    let schema_ticket = result.unwrap(store.seal(mut db, take schema))
    result.unwrap(store.durable(mut db, schema_ticket))
    set(mut db, data, 0u64, 1u64)
    set(mut db, data, 1u64, 3u64)
    set(mut db, data, 2u64, 4u64)
    let at = store.snapshot(db)
    let a = store.version(at)
    let handles = Qh(t: clone(data))
    let read_handle = result.unwrap(store.reader(db, 0u64))
    let mut registered = result.unwrap(placed(code.describe(subs_place), 1048576u64))
    result.unwrap(bind_query_slots(mut registered, handles))
    let mut b = Board(r: take registered, h: arc.new(take handles), read_handle: take read_handle, reads: publisher_reads(), base: take at, newest: None, subs: subscriptions())
    let Mailbox(to: take out, from: take inbox, rounds: take reserved) = result.unwrap(mailbox(8u64))
    let mut rounds = take reserved
    let mut joined: List[Joiner] = list.new()
    let owner = failed_read_owner(mut joined, mut rounds, 1u64)
    fence_round(mut joined, Fenced(sessions: map.new()), a, mut rounds)
    let visible = latest.handle(rounds.round)
    let initial = at_base_generation(mut b, 1u64, 1u32, 1u64, failed_read_sub())
    if list.len(owe_content_view(initial).complete) != 1u64 {
        return Error("initial subscription")
    }
    let before = option.unwrap(sub_at(b.subs, 1u64, 1u32)).charge
    let written: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut db, None, data, fn(mut tx, bound_data) -> Result[(), store.Error] {
        staged_law_write(mut tx, bound_data)
    })
    let outcome = result.unwrap(take written)
    let Committed(store.Done(ticket: ticket, ..)) = outcome else {
        return Error("group did not commit")
    }
    let empty_registry: Registry[(), ()] = registry()
    let mut hd: Head[(), ()] = Head(db: take db, anonymous: anonymous_streams(), r: take empty_registry, replay_identity: list.new(), h: arc.new(()), out: take out, busy: map.new(), waiting: list.new(), group: list.new(), last: Some(ticket), held: list.new(), wakes: false, minted: 0u64, cut: false, trigger_drive: None, parked: list.new(), recovery: None, upkeep: upkeep())
    close_group(mut hd)
    let Ok(PubIn(e: Staged(take next))) = channel.try_receive(inbox) else {
        return Error("head did not stage the sealed group")
    }
    let v = store.version(next)
    let Some(take prepared) = stage_round(b, next, 1048576u64) else {
        return Error("publisher did not stage the update")
    }
    if store.version(b.base) != a || latest.read(visible).at != a || !release_load(visible, owner.fence, a) || option.unwrap(sub_at(b.subs, 1u64, 1u32)).charge != before {
        return Error("staging changed visible publication state")
    }
    if let Error(Empty) = channel.try_receive(owner.from) {} else {
        return Error("owner got bytes before durable")
    }
    if let Error(Empty) = channel.try_receive(inbox) {} else {
        return Error("head released before durable")
    }
    // Losing the prepared pass leaves the read, fence and output work for Release.
    b.reads = failing_reads(ReclaimedBlock, ViewRead)
    if let Some(_) = stage_round(b, next, 1048576u64) {
        return Error("partial reads were staged")
    }
    if !release_load(visible, owner.fence, a) {
        return Error("failed staging advanced a fence")
    }
    b.reads = publisher_reads()
    result.unwrap(release_held(mut hd, true))
    let Ok(PubIn(e: Released(Release(version: released, snapshot: Some(take snapshot), answers: take answers)))) = channel.try_receive(inbox) else {
        return Error("durable group did not release")
    }
    if released != v {
        return Error("Release changed the staged version")
    }
    let mut fenced = Fenced(sessions: map.new())
    let owes = install_staged(mut b, mut fenced, take snapshot, take prepared)
    fence_round(mut joined, take fenced, v, mut rounds)
    if latest.read(visible).at != v || release_load(visible, owner.fence, a) {
        return Error("Release omitted the fence")
    }
    let mut waiting: List[Replies] = list.new()
    keep_answers(mut waiting, take answers)
    settle(mut b.subs, mut joined, mut waiting, take owes, v)
    let Ok(WireEvent(e: FromRunner(Notice(e: Updated(received))))) = channel.try_receive(owner.from) else {
        return Error("Release did not deliver")
    }
    let Some(content) = view received.content else {
        return Error("Release omitted the group")
    }
    if received.version != v || list.len(owe_content_view(content).groups) != 1u64 || owe_content_view(content).groups[0u64].sub != 1u32 {
        return Error("released group version or subscriber")
    }
    if list.compare_bytes(owe_content_view(content).groups[0u64].payload, b"\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x0c\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x01\x00\x00\x00\x08\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00") != Equal {
        return Error("released group bytes differ from the slot-zero row update")
    }
    let Head(db: take completed, ..) = take hd
    result.unwrap(store.close(take completed))
    result.unwrap(std.dir.remove_all(d, name))
    Ok(())
}

type StagedSocket: send {
    at: u64,
    packet: Bytes
}

type StagedRecorder: send {
    port: Served[NetOp],
    next: Receiver[()],
    clock: Clock,
    writes: Sender[StagedSocket]
}

// Record actual bytes at the socket boundary, including the WebSocket header.
fn staged_record(take input: StagedRecorder) waits {
    let StagedRecorder(port: take incoming, next: take next, clock, writes: take writes) = take input
    let mut provider = take incoming
    let mut next_socket = 1u64
    while let Ok(()) = channel.receive(next) {
        let op = loop {
            let pending = option.unwrap(provide.next(mut provider))
            if let Released(..) = provide.net_op(pending) {
                continue
            }
            break take pending
        }
        let reply: NetReply = match provide.net_op(op) {
            Connect(addr: address, ..) => {
                let socket = next_socket
                next_socket += 1u64
                Socket(socket, address)
            },
            Send(prefix: prefix, tail: tail, ..) => {
                let mut packet: Bytes = list.with_capacity(prefix + tail)
                provide.payload(op, 1u64, mut packet)
                provide.payload(op, 2u64, mut packet)
                if list.len(packet) != prefix + tail {
                    fail("L61 socket recorder lost payload bytes")
                }
                result.unwrap(channel.send(writes, StagedSocket(at: host.mono_ns(clock), packet: take packet)))
                Count(prefix + tail)
            },
            _ => fail("L61 unexpected socket operation"),
        }
        result.unwrap(provide.reply(mut provider, take op, provide.net_reply(reply)))
    }
}

type StagedOwner {
    owner: WireSession[()],
    work: WireWork,
    to: Sender[WireEvent],
    inbox: Receiver[WireEvent],
    closing: Sender[()],
    unused_head: Receiver[HeadInput],
    round: Latest[RoundAt],
    fence: Latest[Fence]
}

fn staged_subscribe(to: Sender[PubIn], tasks: Tasks, clock: Clock, random: Random) -> Option[StagedOwner] waits {
    let (head, unused_head): (Sender[HeadInput], Receiver[HeadInput]) = channel.new(1u64)
    let service: Service[WireSession[()]] = wire_service_seed(random, no_wire(), head, clock, tasks, wire_defaults(1048576u64), string.new())
    let Service(context: take fresh, ..) = take service
    let mut owner = take fresh
    owner.handshake = Open(caller: law_caller(1u64), entries: list.new())
    let mut work = wire_work()
    work.splice = true
    let (events, inbox): (Sender[WireEvent], Receiver[WireEvent]) = channel.new(8u64)
    let reply_to = channel.sender(events)
    let (told, admission): (Sender[Admit], Receiver[Admit]) = channel.new(1u64)
    let (closing, closed): (Sender[()], Receiver[()]) = channel.new(1u64)
    let fence = latest.new(arc.new(std.http.ReleaseFence(prior: 0u64, latest: 0u64)))
    let join = Join(to: take events, told: take told, mark: None, closed: Some(take closed), identity: None, fence: Some(latest.handle(fence)), progress: None, taken: None, first: None, http_credit: None)
    if let Error(_) = channel.send(to, PubIn(e: Joined(take join))) {
        return None
    }
    let Ok(Admit(who: who, round: take register)) = channel.receive(admission) else {
        return None
    }
    if let Ok(WireEvent(e: JoinReady)) = channel.receive(inbox) {} else {
        fail("L61 subscriber did not become ready")
    }
    owner.joined = Some(who)
    owner.publisher = Some(channel.sender(to))
    wire_subscribed(mut owner, mut work, 1u32, failed_read_sub())
    Some(StagedOwner(owner: take owner, work: take work, to: take reply_to, inbox: take inbox, closing: take closing, unused_head: take unused_head, round: take register, fence: take fence))
}

fn staged_packet(mut peer: StagedOwner, take notice: Notice) -> (u64, Bytes) {
    result.unwrap(wire_step(mut peer.owner, mut peer.work, WRunner(take notice)))
    let frame = option.unwrap(result.unwrap(wire_take_output(peer.owner, mut peer.work)))
    let version = match frame {
        Batch(at, _, _, _) => at,
        _ => fail("L61 expected a subscription Batch"),
    }
    let out = result.unwrap(std.wsock.outbound(Server, wire_defaults(0u64).socket, None))
    let packed = result.unwrap(encode_published_frame(out, frame, peer.work.packing))
    (version, take packed)
}

fn staged_send(mut peer: StagedOwner, mut socket: WriteHalf, next: Sender[()], take notice: Notice) -> u64 waits {
    let (version, take packed) = staged_packet(mut peer, take notice)
    result.unwrap(channel.send(next, ()))
    if result.unwrap(host.send_pair(mut socket, packed, b"", Never)) != list.len(packed) {
        fail("L61 partial socket write")
    }
    wire_sent(mut peer.owner, mut peer.work)
    version
}

fn staged_receive(mut peer: StagedOwner, mut socket: WriteHalf, next: Sender[()]) -> u64 waits {
    let Ok(WireEvent(e: FromRunner(take notice))) = channel.receive(peer.inbox) else {
        fail("L61 subscription Batch missing")
    }
    staged_send(mut peer, mut socket, next, take notice)
}

fn staged_open_socket(network: Net, next: Sender[()]) -> WriteHalf waits {
    result.unwrap(channel.send(next, ()))
    let (_, take writer) = net.split(result.unwrap(host.connect(network, Addr(ip: V4(2130706433u32), port: 1u16), Never)))
    take writer
}

type StagedClockCommand: send = Pause(Sender[()]) | Resume | Stop

type StagedClock: send {
    world: std.sim.world.World,
    commands: Receiver[StagedClockCommand],
    real: Clock
}

fn staged_clock(take input: StagedClock) waits {
    let StagedClock(world: take initial, commands: take commands, real) = take input
    let mut virtual = take initial
    loop {
        match channel.try_receive(commands) {
            Ok(Pause(take ready)) => {
                result.unwrap(channel.send(ready, ()))
                if let Ok(Resume) = channel.receive(commands) {} else {
                    return
                }
            },
            Ok(Stop) => return,
            Error(Closed) => return,
            _ => (),
        }
        if !std.sim.world.step(mut virtual) {
            host.sleep_until(real, clock.deadline_after_ms(host.mono_ns(real), 1u64))
        }
    }
}

type StagedBucket {
    endpoint: std.sim.s3.Endpoint,
    commands: Sender[StagedClockCommand]
}

type StagedTrial = Pipeline(StagedBucket) | Serial(StagedBucket) | Poison

fn staged_socket_trial(take opened: store.Db, random: Random, tasks: Tasks, trial: StagedTrial) -> Result[Bytes, String] waits {
    let mut db = take opened
    let mut schema = result.unwrap(store.declare(db, Migrate))
    let data = result.unwrap(staged_law_table(mut schema))
    let schema_ticket = result.unwrap(store.seal(mut db, take schema))
    result.unwrap(store.durable(mut db, schema_ticket))
    set(mut db, data, 0u64, 1u64)
    set(mut db, data, 1u64, 3u64)
    let base_write: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut db, None, data, fn(mut tx, bound_data) -> Result[(), store.Error] {
        store.put(mut tx, bound_data, 2u64, 4u64)
    })
    let Committed(store.Done(ticket: base_ticket, ..)) = result.unwrap(take base_write) else {
        return Error("L61 base did not commit")
    }
    result.unwrap(store.durable(mut db, base_ticket))
    let base = store.snapshot(db)
    let a = store.version(base)
    let Mailbox(to: take out, from: take inbox, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let to = channel.sender(out)
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let job = Publish(placing: placing_at(code.describe(subs_place), 1048576u64), n_place: 1048576u64, staging: 1048576u64, h: arc.new(Qh(t: clone(data))), read_handle: result.unwrap(store.reader(db, 0u64)), base: take base, from: take inbox, rounds: take rounds, ready: take ready_to)
    let publishing = task.spawn(tasks, bytes 8388608u64, take job, publish)
    if let Ok(None) = channel.receive(ready_from) {} else {
        return Error("L61 publisher did not start")
    }
    let (time, take stopped_clock) = provide.clock(0u64, 0u64)
    let mut ticks = take stopped_clock
    let (network, take port) = provide.net(bytes 4096u64)
    let (write_to, writes): (Sender[StagedSocket], Receiver[StagedSocket]) = channel.new(4u64)
    let (commands, resume_recording): (Sender[()], Receiver[()]) = channel.new(1u64)
    let recorder = task.spawn(tasks, bytes 65536u64, StagedRecorder(port: take port, next: take resume_recording, clock: time, writes: take write_to), staged_record)
    let mut socket = staged_open_socket(network, commands)
    let mut peer = option.unwrap(staged_subscribe(to, tasks, time, random))
    if staged_receive(mut peer, mut socket, commands) != a {
        return Error("L61 initial Batch has the wrong version")
    }
    let _ = result.unwrap(channel.receive(writes))
    let before = latest.read(peer.fence).latest
    let bucket = match trial {
        Pipeline(selected) => Some(selected),
        Serial(selected) => Some(selected),
        Poison => None,
    }
    // Keep the object request from reaching its deadline during the held observation.
    if let Some(selected) = bucket {
        let (ready, paused): (Sender[()], Receiver[()]) = channel.new(1u64)
        result.unwrap(channel.send(selected.commands, Pause(take ready)))
        result.unwrap(channel.receive(paused))
    }
    let written: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut db, None, data, fn(mut tx, bound_data) -> Result[(), store.Error] {
        staged_law_write(mut tx, bound_data)
    })
    let Committed(store.Done(ticket: ticket, ..)) = result.unwrap(take written) else {
        return Error("L61 group did not commit")
    }
    let empty_registry: Registry[(), ()] = registry()
    let mut hd: Head[(), ()] = Head(db: take db, anonymous: anonymous_streams(), r: take empty_registry, replay_identity: list.new(), h: arc.new(()), out: take out, busy: map.new(), waiting: list.new(), group: list.new(), last: Some(ticket), held: list.new(), wakes: false, minted: 0u64, cut: false, trigger_drive: None, parked: list.new(), recovery: None, upkeep: upkeep())
    let next = store.snapshot(hd.db)
    let v = store.version(next)
    if let Serial(_) = trial {
        hd.last = None
        list.push(mut hd.held, Sealed(ticket, v, take next, list.new()))
    } else {
        close_group(mut hd)
    }
    if let Some(selected) = bucket {
        // Bootstrap writes two heads, then the schema and each of three base
        // writes take one each. The latch holds the effect's seventh PUT.
        result.unwrap(std.sim.s3.requested(selected.endpoint, "PUT", "head", 7u64))
        if let Ok(false) = store.durable_now(mut hd.db, ticket) {} else {
            return Error("L61 the latch did not hold durable")
        }
    }
    // Run the publisher to its next receive while the head is held at the gate.
    // An inbox probe would itself discard the pending staged plan.
    let released_at = 1u64
    let release_tick = task.spawn(tasks, bytes 0u64, (time, released_at), fn(take timer: (Clock, u64)) waits {
        host.sleep_until(timer.0, timer.1)
    })
    if clock.idle(mut ticks) != Some(released_at) {
        return Error("L61 the release timer was not pending")
    }
    if latest.read(peer.round).at != a || latest.read(peer.fence).latest != before {
        fail("L61 staging advanced the fence or round before durable")
    }
    if let Ok(WireEvent(e: FromRunner(take early))) = channel.try_receive(peer.inbox) {
        let _ = staged_send(mut peer, mut socket, commands, take early)
    }
    clock.advance_to(mut ticks, released_at)
    if let Ok(write) = channel.try_receive(writes) {
        if write.at < released_at {
            fail("L61 staged Batch wrote to the socket before durable")
        }
        return Error("L61 unexpected write at the durability gate")
    }
    if let Some(selected) = bucket {
        // Requested is a transport latch. The marker needs no object access.
        let marker = b"GET /release-l61 HTTP/1.1\r\nHost: bucket.s3.test:8080\r\nConnection: close\r\n\r\n"
        let bucket_net = std.sim.s3.endpoint_network(selected.endpoint)
        let (_, take output) = net.split(result.unwrap(host.connect(bucket_net, Addr(ip: V4(2130706433u32), port: 8080u16), Never)))
        let mut marker_socket = take output
        let mut sent = 0u64
        while sent < list.len(marker) {
            let count = result.unwrap(host.send_pair(mut marker_socket, list.slice(marker, sent, list.len(marker)), b"", Never))
            if count == 0u64 {
                return Error("L61 latch release marker was incomplete")
            }
            sent += count
        }
        result.unwrap(std.sim.s3.requested(selected.endpoint, "GET", "release-l61", 1u64))
        result.unwrap(channel.send(selected.commands, Resume))
    }
    result.unwrap(task.join(take release_tick))
    let frame: Bytes = if let Poison = trial {
        store.fixture_broken_handoff(mut hd.db)
        let failed: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut hd.db, None, data, fn(mut tx, bound_data) -> Result[(), store.Error] {
            store.put(mut tx, bound_data, 3u64, 9u64)
        })
        if let Error(Poisoned(Closed)) = failed {} else {
            return Error("L61 journal fixture did not poison the store")
        }
        if let Error(Poisoned(Closed)) = release_held(mut hd, true) {} else {
            return Error("L61 durable did not report poison")
        }
        store.allow_unverified_teardown(mut hd.db)
        let _ = clock.idle(mut ticks)
        if let Ok(WireEvent(e: FromRunner(take leaked))) = channel.try_receive(peer.inbox) {
            let _ = staged_send(mut peer, mut socket, commands, take leaked)
            return Error("L61 failed durable wrote to the previous socket")
        }
        result.unwrap(channel.send(to, PubIn(e: Halt)))
        let _ = take peer
        let _ = take socket
        let mut retry_socket = staged_open_socket(network, commands)
        if let Some(take reconnected) = staged_subscribe(to, tasks, time, random) {
            let mut retry = take reconnected
            if staged_receive(mut retry, mut retry_socket, commands) >= v {
                let _ = result.unwrap(channel.receive(writes))
                fail("L61 failed durable wrote staged data after reconnect")
            }
        }
        list.new()
    } else {
        if let Error(_) = release_held(mut hd, true) {
            return Error("L61 durable failed after the latch opened")
        }
        if staged_receive(mut peer, mut socket, commands) != v || latest.read(peer.round).at != v || latest.read(peer.fence).latest != v {
            return Error("L61 durable Release omitted the version or fence")
        }
        let StagedSocket(at, packet: take packed) = result.unwrap(channel.receive(writes))
        if at < released_at {
            fail("L61 staged Batch wrote to the socket before durable")
        }
        take packed
    }
    let _ = channel.send(to, PubIn(e: Halt))
    result.unwrap(task.join(take publishing))
    let _ = take commands
    result.unwrap(task.join(take recorder))
    let Head(db: take completed, ..) = take hd
    match store.close(take completed) {
        Ok(()) => (),
        Error(Poisoned(Closed)) => if let Poison = trial {} else {
            return Error("L61 close unexpectedly reported poison")
        },
        _ => return Error("L61 could not close the store"),
    }
    Ok(take frame)
}

fn staged_latched_trial(real: Clock, random: Random, tasks: Tasks, staged: bool) -> Result[Bytes, String] waits {
    let seed = 61u64
    let address = Addr(ip: V4(2130706433u32), port: 8080u16)
    let mut network = std.sim.net.new(std.sim.net.defaults())
    let mut peers: List[Ip] = list.with_capacity(1u64)
    list.push(mut peers, address.ip)
    std.sim.net.resolve_as(mut network, "bucket.s3.test", take peers)
    let key_bytes: Inline[u8, 32] =[219, 184, 147, 172, 192, 16, 150, 73, 24, 241, 253, 67, 58, 221, 135, 199, 14, 139, 13, 182, 190, 48, 193, 251, 234, 254, 250, 94, 198, 186, 131, 120]
    let mut signing: Bytes = list.with_capacity(32u64)
    let _ = bytebuf.append_inline(mut signing, key_bytes, 0u64, 32u64)
    let verify = result.unwrap(secret.seal(take signing, "verify"))
    let mut head_holds: List[std.sim.s3.Hold] = list.with_capacity(1u64)
    list.push(mut head_holds, std.sim.s3.Hold(method: "PUT", key: "head", from: 7u64, count: 1u64, until: Requested("GET", "release-l61", 1u64), then: Apply))
    let config = std.sim.s3.Config(address, cut: None, network: take network, after_resolve: None, credential: "AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request", signing_key: take verify, faults: list.new(), holds: take head_holds, exists_status: 412, fragment_bytes: 4096, max_body: 1048576)
    let (take virtual, time) = std.sim.world.new(seed, 0u64, 1369353600000u64)
    let (control, commands): (Sender[StagedClockCommand], Receiver[StagedClockCommand]) = channel.new(1u64)
    let driver = task.spawn(tasks, bytes 65536u64, StagedClock(world: take virtual, commands: take commands, real), staged_clock)
    let (endpoint, take sim) = std.sim.s3.start_service(tasks, take config, std.sim.world.plan(seed), time, 1048576u64, 16777216u64)
    let mut world = result.unwrap(store.level_world(tasks, time, list.new(), 1048576u64))
    let authority = store.sim_authority(sim_release_client(endpoint, time, tasks, random), sim_release_levels(), result.unwrap(store.level_sync(mut world)), 30000u64)
    let db = match store.open_authority(tasks, take authority, time, random, sim_release_options()) {
        Ok(take value) => take value,
        Error(_) => return Error("L61 could not open simulated bucket"),
    }
    let bucket = StagedBucket(endpoint, commands: channel.sender(control))
    let trial = if staged {
        Pipeline(take bucket)
    } else {
        Serial(take bucket)
    }
    let tested = staged_socket_trial(take db, random, tasks, trial)
    let _ = result.unwrap(store.level_log(take world))
    let _ = channel.send(control, Stop)
    let _ = result.unwrap(task.join(take sim))
    result.unwrap(task.join(take driver))
    take tested
}

@test
fn test_release_after_durable(d: Dir, clock: Clock, random: Random, tasks: Tasks) -> Result[(), String] waits {
    staged_round_checks(d, clock, random, tasks)?
    let staged = staged_latched_trial(clock, random, tasks, true)?
    let unstaged = staged_latched_trial(clock, random, tasks, false)?
    if staged != unstaged {
        return Error("L61 staged and unstaged socket frames differ byte for byte")
    }
    let mut name = string.with_capacity(64u64)
    let dir = result.unwrap(std.dir.create_temp(d, mut name))
    let opts = result.unwrap(store.sized(Directory, 134217728u64))
    let db = result.unwrap(store.open(tasks, dir, clock, random, opts))
    let _ = staged_socket_trial(take db, random, tasks, Poison)?
    result.unwrap(std.dir.remove_all(d, name))
    Ok(())
}

// L91 (E1, F5): (1) behind the S3 PUT head latch, a zero-mutation run reading
// the un-durable commit emits no extra PUT head, returns Done.info == None,
// keeps durable_now == Ok(false) and 0 socket bytes while latched, resolves
// position == (store, 0, v) after release, and releasing a zero-write attempt
// at unchanged version v emits reply-only socket bytes with no second
// subscription frame; (2) on the Poison arm, durable on the skipped ticket
// returns Poisoned, discards output, and passes std.sim.history.recovered.
@test
fn test_zero_mutation_behind_latch(d: Dir, real: Clock, random: Random, tasks: Tasks) -> Result[(), String] waits {
    // --- Arm 1: sim@1 bucket with S3 PUT head #7 latch (E1 + F5) ---
    let seed = 9161u64
    let address = Addr(ip: V4(2130706433u32), port: 8080u16)
    let mut network = std.sim.net.new(std.sim.net.defaults())
    let mut peers: List[Ip] = list.with_capacity(1u64)
    list.push(mut peers, address.ip)
    std.sim.net.resolve_as(mut network, "bucket.s3.test", take peers)
    let key_bytes: Inline[u8, 32] =[219, 184, 147, 172, 192, 16, 150, 73, 24, 241, 253, 67, 58, 221, 135, 199, 14, 139, 13, 182, 190, 48, 193, 251, 234, 254, 250, 94, 198, 186, 131, 120]
    let mut signing: Bytes = list.with_capacity(32u64)
    let _ = bytebuf.append_inline(mut signing, key_bytes, 0u64, 32u64)
    let verify = result.unwrap(secret.seal(take signing, "verify"))
    let mut head_holds: List[std.sim.s3.Hold] = list.with_capacity(1u64)
    list.push(mut head_holds, std.sim.s3.Hold(method: "PUT", key: "head", from: 7u64, count: 1u64, until: Requested("GET", "release-l91", 1u64), then: Apply))
    let config = std.sim.s3.Config(address, cut: None, network: take network, after_resolve: None, credential: "AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request", signing_key: take verify, faults: list.new(), holds: take head_holds, exists_status: 412, fragment_bytes: 4096, max_body: 1048576)
    let (take virtual, sim_time) = std.sim.world.new(seed, 0u64, 1369353600000u64)
    let (control, clock_cmds): (Sender[StagedClockCommand], Receiver[StagedClockCommand]) = channel.new(1u64)
    let driver = task.spawn(tasks, bytes 65536u64, StagedClock(world: take virtual, commands: take clock_cmds, real), staged_clock)
    let (endpoint, take sim) = std.sim.s3.start_service(tasks, take config, std.sim.world.plan(seed), sim_time, 1048576u64, 16777216u64)
    let mut world = result.unwrap(store.level_world(tasks, sim_time, list.new(), 1048576u64))
    let authority = store.sim_authority(sim_release_client(endpoint, sim_time, tasks, random), sim_release_levels(), result.unwrap(store.level_sync(mut world)), 30000u64)
    let mut db = match store.open_authority(tasks, take authority, sim_time, random, sim_release_options()) {
        Ok(take value) => take value,
        Error(_) => return Error("L91 E1: could not open simulated bucket"),
    }
    let mut schema = result.unwrap(store.declare(db, Migrate))
    let data = result.unwrap(staged_law_table(mut schema))
    let schema_ticket = result.unwrap(store.seal(mut db, take schema))
    result.unwrap(store.durable(mut db, schema_ticket))
    set(mut db, data, 0u64, 1u64)
    set(mut db, data, 1u64, 3u64)
    let base_write: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut db, None, data, fn(mut tx, bound_data) -> Result[(), store.Error] {
        store.put(mut tx, bound_data, 2u64, 4u64)
    })
    let Committed(store.Done(ticket: base_ticket, ..)) = result.unwrap(take base_write) else {
        return Error("L91 E1: base write did not commit")
    }
    result.unwrap(store.durable(mut db, base_ticket))
    let base = store.snapshot(db)
    let a = store.version(base)
    let mut history = std.sim.history.new(seed)
    std.sim.history.model(mut history, a, b"1")
    std.sim.history.model(mut history, a + 1u64, b"2")
    let Mailbox(to: take out, from: take inbox, rounds: take rounds) = result.unwrap(mailbox(8u64))
    let to = channel.sender(out)
    let (ready_to, ready_from): (Sender[Option[RegisterError]], Receiver[Option[RegisterError]]) = channel.new(1u64)
    let job = Publish(placing: placing_at(code.describe(subs_place), 1048576u64), n_place: 1048576u64, staging: 1048576u64, h: arc.new(Qh(t: clone(data))), read_handle: result.unwrap(store.reader(db, 0u64)), base: take base, from: take inbox, rounds: take rounds, ready: take ready_to)
    let publishing = task.spawn(tasks, bytes 8388608u64, take job, publish)
    if let Ok(None) = channel.receive(ready_from) {} else {
        return Error("L91 E1: publisher did not start")
    }
    let (time, take stopped_clock) = provide.clock(0u64, 0u64)
    let mut ticks = take stopped_clock
    let (socket_net, take port) = provide.net(bytes 4096u64)
    let (write_to, writes): (Sender[StagedSocket], Receiver[StagedSocket]) = channel.new(4u64)
    let (rec_cmds, resume_recording): (Sender[()], Receiver[()]) = channel.new(1u64)
    let recorder = task.spawn(tasks, bytes 65536u64, StagedRecorder(port: take port, next: take resume_recording, clock: time, writes: take write_to), staged_record)
    let mut socket = staged_open_socket(socket_net, rec_cmds)
    let mut peer = option.unwrap(staged_subscribe(to, tasks, time, random))
    if staged_receive(mut peer, mut socket, rec_cmds) != a {
        return Error("L91 E1: initial Batch version mismatch")
    }
    let _ = result.unwrap(channel.receive(writes))
    // Pause virtual clock while Commit A is held behind PUT head #7.
    let (ready, paused): (Sender[()], Receiver[()]) = channel.new(1u64)
    result.unwrap(channel.send(control, Pause(take ready)))
    result.unwrap(channel.receive(paused))
    let written_a: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut db, None, data, fn(mut tx, bound_data) -> Result[(), store.Error] {
        staged_law_write(mut tx, bound_data)
    })
    let Committed(store.Done(ticket: ticket_a, ..)) = result.unwrap(take written_a) else {
        return Error("L91 E1: Commit A did not commit")
    }
    let empty_registry: Registry[(), ()] = registry()
    let mut hd: Head[(), ()] = Head(db: take db, anonymous: anonymous_streams(), r: take empty_registry, replay_identity: list.new(), h: arc.new(()), out: take out, busy: map.new(), waiting: list.new(), group: list.new(), last: Some(ticket_a), held: list.new(), wakes: false, minted: 0u64, cut: false, trigger_drive: None, parked: list.new(), recovery: None, upkeep: upkeep())
    let v = store.version(store.snapshot(hd.db))
    close_group(mut hd)
    result.unwrap(std.sim.s3.requested(endpoint, "PUT", "head", 7u64))
    if let Ok(false) = store.durable_now(mut hd.db, ticket_a) {} else {
        return Error("L91 E1: latch did not hold Commit A")
    }
    // Zero-mutation run B reads Commit A's row 0 behind the latch.
    let read_b: Result[store.Outcome[Option[u64], store.Error], store.Error] = store.run(mut hd.db, None, data, fn(mut tx, bound_data) -> Result[Option[u64], store.Error] {
        store.fetch(tx, bound_data, 0u64)
    })
    let Committed(done_b) = result.unwrap(take read_b) else {
        return Error("L91 E1: zero-mutation run B did not commit")
    }
    if done_b.value != Some(2u64) || store.version(store.snapshot(hd.db)) != v {
        return Error("L91 E1: zero-mutation run B saw wrong value or advanced version")
    }
    if let Some(_) = done_b.info {
        return Error("L91 E1/F2: zero-mutation run B returned Some(CallInfo)")
    }
    if let Ok(false) = store.durable_now(mut hd.db, done_b.ticket) {} else {
        return Error("L91 E1: durable_now on skipped ticket returned true while latched")
    }
    if let Ok(_) = channel.try_receive(writes) {
        return Error("L91 E1: socket received bytes while latched")
    }
    // Open the S3 latch and release Commit A first.
    let marker = b"GET /release-l91 HTTP/1.1\r\nHost: bucket.s3.test:8080\r\nConnection: close\r\n\r\n"
    let bucket_net = std.sim.s3.endpoint_network(endpoint)
    let (_, take output) = net.split(result.unwrap(host.connect(bucket_net, Addr(ip: V4(2130706433u32), port: 8080u16), Never)))
    let mut marker_socket = take output
    let mut sent = 0u64
    while sent < list.len(marker) {
        let count = result.unwrap(host.send_pair(mut marker_socket, list.slice(marker, sent, list.len(marker)), b"", Never))
        if count == 0u64 {
            return Error("L91 E1: latch release marker incomplete")
        }
        sent += count
    }
    result.unwrap(std.sim.s3.requested(endpoint, "GET", "release-l91", 1u64))
    result.unwrap(channel.send(control, Resume))
    if let Error(_) = release_held(mut hd, true) {
        return Error("L91 E1: release_held failed after latch opened")
    }
    if staged_receive(mut peer, mut socket, rec_cmds) != v {
        return Error("L91 E1: released subscription Batch had wrong version")
    }
    let _ = result.unwrap(channel.receive(writes))
    std.sim.history.check(std.sim.history.committed(mut history, b"a", v, b"2"))
    std.sim.history.check(std.sim.history.reply(mut history, 1u64, b"a", v, Some(b"2")))
    let pos_b = result.unwrap(store.position(mut hd.db, done_b.ticket))
    if pos_b.branch != 0u32 || pos_b.version != v {
        return Error("L91 E1: position(done_b.ticket) did not equal (store, 0, v)")
    }
    // F5: zero-write attempt at unchanged version v -> stage + release ->
    // socket bytes equal the reply only, with no second subscription frame.
    let req_b2 = std.sim.history.request(history, 1u64, Fresh)
    let read_b2: Result[store.Outcome[Option[u64], store.Error], store.Error] = store.run(mut hd.db, None, data, fn(mut tx, bound_data) -> Result[Option[u64], store.Error] {
        store.fetch(tx, bound_data, 0u64)
    })
    let Committed(done_b2) = result.unwrap(take read_b2) else {
        return Error("L91 F5: zero-write attempt B2 did not commit")
    }
    if done_b2.value != Some(2u64) || store.version(store.snapshot(hd.db)) != v {
        return Error("L91 F5: B2 saw wrong value or advanced version")
    }
    if let Some(_) = done_b2.info {
        return Error("L91 F5/F2: B2 returned Some(CallInfo)")
    }
    let sid = store.StreamId(t: 1u64, n: 1u64)
    let skey = store.StreamKey(caller: law_caller(1u64), id: sid)
    let raw_stream = result.unwrap(store.stream_key_bytes(skey))
    let held_slot = slot_key(raw_stream, 0u64)
    let mut owed_list: List[WireOwed] = list.with_capacity(1u64)
    list.push(mut owed_list, WireOwed(generation: 1u64, reply: list.new()))
    let req_digest = store.request_digest(b"f5", b"")
    let held_entry = WireHeld(stream: sid, p: 0u64, digest: req_digest, forwarded: true, queued: 0u64, owed: take owed_list)
    map.insert(mut peer.owner.held, take held_slot, take held_entry)
    let reply_payload: Bytes = clone(b"2")
    let who = option.unwrap(peer.owner.joined)
    let mut waiters: List[CallWaiter] = list.with_capacity(1u64)
    list.push(mut waiters, CallWaiter(owner: who, target: WireReply(channel.sender(peer.to))))
    let held_worker = Worker(p: 0u64, digest: req_digest, version: v, outcome: Returned(clone(reply_payload)), waiters: take waiters)
    map.insert(mut hd.busy, clone(raw_stream), take held_worker)
    list.push(mut hd.group, take raw_stream)
    hd.last = Some(done_b2.ticket)
    close_group(mut hd)
    if let Error(_) = release_held(mut hd, true) {
        return Error("L91 F5: release_held at unchanged version failed")
    }
    let Ok(WireEvent(e: FromRunner(take reply_notice))) = channel.receive(peer.inbox) else {
        return Error("L91 F5: reply notice missing")
    }
    result.unwrap(wire_step(mut peer.owner, mut peer.work, WRunner(take reply_notice)))
    let out_frame = option.unwrap(result.unwrap(wire_take_output(peer.owner, mut peer.work)))
    let Batch(batch_at, dropped_subs, sub_groups, reply_rows) = view out_frame else {
        return Error("L91 F5: expected Batch reply frame")
    }
    if batch_at != v || list.len(dropped_subs) != 0u64 || list.len(sub_groups) != 0u64 || list.len(reply_rows) != 1u64 {
        return Error("L91 F5: unchanged-version Release emitted a subscription frame or wrong reply count")
    }
    let out_ws = result.unwrap(std.wsock.outbound(Server, wire_defaults(0u64).socket, None))
    let actual_bytes = result.unwrap(encode_published_frame(out_ws, out_frame, peer.work.packing))
    result.unwrap(channel.send(rec_cmds, ()))
    if result.unwrap(host.send_pair(mut socket, actual_bytes, b"", Never)) != list.len(actual_bytes) {
        return Error("L91 F5: partial socket write")
    }
    wire_sent(mut peer.owner, mut peer.work)
    let StagedSocket(packet: take recorded_bytes, ..) = result.unwrap(channel.receive(writes))
    let mut expected_rows: List[Done] = list.with_capacity(1u64)
    list.push(mut expected_rows, Done(stream: sid, p: 0u64, outcome: Returned(take reply_payload)))
    let expected_ws = result.unwrap(std.wsock.outbound(Server, wire_defaults(0u64).socket, None))
    let expected_bytes = result.unwrap(encode_published_frame(expected_ws, Batch(v, list.new(), list.new(), take expected_rows), peer.work.packing))
    if recorded_bytes != expected_bytes {
        return Error("L91 F5: socket bytes did not equal the reply-only frame")
    }
    if let Ok(_) = channel.try_receive(peer.inbox) {
        return Error("L91 F5: unexpected extra notice after unchanged-version Release")
    }
    std.sim.history.check(std.sim.history.read(mut history, req_b2, v, b"2"))
    std.sim.history.check(std.sim.history.recovered(history, v))
    let _ = channel.send(to, PubIn(e: Halt))
    result.unwrap(task.join(take publishing))
    let _ = take rec_cmds
    result.unwrap(task.join(take recorder))
    let Head(db: take completed, ..) = take hd
    result.unwrap(store.close(take completed))
    let _ = result.unwrap(store.level_log(take world))
    let _ = channel.send(control, Stop)
    let report = result.unwrap(task.join(take sim))
    result.unwrap(task.join(take driver))
    let _ = take ticks
    // Only 7 PUT head writes total (B and B2 wrote 0 PUT head).
    if list.len(report.head_writes) != 7u64 {
        return Error("L91 E1/F5: skipped runs issued an extra PUT head")
    }
    // --- Arm 2: Poison arm on Directory store (E1 Poison + OutputGate) ---
    let mut dir_name = string.with_capacity(64u64)
    let dir = result.unwrap(std.dir.create_temp(d, mut dir_name))
    let opts = result.unwrap(store.sized(Directory, 134217728u64))
    let mut pdb = result.unwrap(store.open(tasks, dir, real, random, opts))
    let mut pschema = result.unwrap(store.declare(pdb, Migrate))
    let pdata = result.unwrap(staged_law_table(mut pschema))
    let pticket = result.unwrap(store.seal(mut pdb, take pschema))
    result.unwrap(store.durable(mut pdb, pticket))
    set(mut pdb, pdata, 0u64, 1u64)
    let pa = store.version(store.snapshot(pdb))
    let mut phistory = std.sim.history.new(seed + 1u64)
    std.sim.history.model(mut phistory, pa, b"1")
    let pwrite: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut pdb, None, pdata, fn(mut tx, bound_data) -> Result[(), store.Error] {
        store.put(mut tx, bound_data, 0u64, 2u64)
    })
    let Committed(store.Done(ticket: pticket_a, ..)) = result.unwrap(take pwrite) else {
        return Error("L91 E1 Poison: write A did not commit")
    }
    let pread: Result[store.Outcome[Option[u64], store.Error], store.Error] = store.run(mut pdb, None, pdata, fn(mut tx, bound_data) -> Result[Option[u64], store.Error] {
        store.fetch(tx, bound_data, 0u64)
    })
    let Committed(pdone_b) = result.unwrap(take pread) else {
        return Error("L91 E1 Poison: skipped read B did not commit")
    }
    if pdone_b.value != Some(2u64) {
        return Error("L91 E1 Poison: skipped read B saw wrong value")
    }
    if let Some(_) = pdone_b.info {
        return Error("L91 E1 Poison: skipped read B returned Some(CallInfo)")
    }
    let _ = pticket_a
    store.fixture_broken_handoff(mut pdb)
    let pfail: Result[store.Outcome[(), store.Error], store.Error] = store.run(mut pdb, None, pdata, fn(mut tx, bound_data) -> Result[(), store.Error] {
        store.put(mut tx, bound_data, 3u64, 9u64)
    })
    if let Error(Poisoned(Closed)) = pfail {} else {
        return Error("L91 E1 Poison: broken handoff did not poison store")
    }
    if let Error(Poisoned(Closed)) = store.durable(mut pdb, pdone_b.ticket) {} else {
        return Error("L91 E1 Poison: durable on skipped ticket did not return Poisoned")
    }
    // Because B's output was never released, history.recovered at pa passes cleanly.
    std.sim.history.check(std.sim.history.recovered(phistory, pa))
    // This arm poisons the store on purpose, so the trust teardown is waived.
    store.allow_unverified_teardown(mut pdb)
    let _ = store.close(take pdb)
    result.unwrap(std.dir.remove_all(d, dir_name))
    Ok(())
}

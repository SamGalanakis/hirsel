// CommonMark 0.31.2 parser adapted from the original Hirsel std implementation.
// Block and delimiter algorithms adapted from commonmark.js.
// Copyright (c) 2014 John MacFarlane. BSD-2-Clause, see third-party/NOTICES.md.
pub type Span: key {
    start: u64,
    end: u64,
}

pub type Kind = Document | Paragraph | Heading(u64) | BlockQuote | ListBlock(bool, u64, bool) | Item | CodeBlock(String, String) | HtmlBlock(String) | ThematicBreak | Text(String) | SoftBreak | HardBreak | Code(String) | HtmlInline(String) | Emphasis | Strong | Link(String, String) | Image(String, String) | Wikilink(String, String)

pub type Node {
    kind: Kind,
    span: Span,
    section: Option[Span],
    target: Option[Span],
    label: Option[Span],
    first: u64,
    next: u64,
}

pub type ParseBudget: key {
    source_bytes: u64,
    work_items: u64,
    nesting: u64,
}

pub type Dialect: key = CommonMark | Wiki

pub type ParseLimit: key = SourceBytes | WorkItems | Nesting

type SourceRow {
    primary: SourceSpan,
    target: SourceSpan,
    label: SourceSpan,
}

const MAX_NESTING: u64 = 128

type ParseState {
    work: u64,
    nesting: u64,
}

fn admit(mut budget: ParseState, count: u64) -> Result[(), ParseLimit] {
    if count > budget.work {
        return Error(WorkItems)
    }
    budget.work -= count
    Ok(())
}

fn admit_nesting(budget: ParseState, count: u64) -> Result[(), ParseLimit] {
    if count > budget.nesting {
        return Error(Nesting)
    }
    Ok(())
}

// Parent chains are iterative: no host recursion precedes admission.
fn child_depth(budget: ParseState, nodes: List[Entry], parent: u64) -> Result[(), ParseLimit] {
    let mut remaining = budget.nesting
    if remaining == 0 {
        return Error(Nesting)
    }
    remaining -= 1
    let mut id = parent
    while true {
        if remaining == 0 {
            return Error(Nesting)
        }
        remaining -= 1
        if id == 0 {
            return Ok(())
        }
        id = nodes[id].parent
    }
    Ok(())
}

// Arena links use zero as null. The document itself is slot zero.
type Entry {
    kind: u8,
    value: String,
    info: String,
    title: String,
    number: u64,
    flag: bool,
    tight: bool,
    parent: u64,
    first: u64,
    last: u64,
    next: u64,
    prev: u64,
    open: bool,
    indent: u64,
    padding: u64,
    marker: u8,
    fence: u64,
    html: u8,
    start_line: u64,
    end_line: u64,
}

type Reference {
    destination: String,
    title: String,
}

type Parser {
    sources: List[EntrySource],
    maps: List[LineMap],
    nodes: List[Entry],
    tip: u64,
    line: String,
    offset: u64,
    column: u64,
    nonspace: u64,
    nonspace_column: u64,
    indent: u64,
    blank: bool,
    partial: bool,
    matched: u64,
    oldtip: u64,
    closed: bool,
    line_number: u64,
    refs: Map[String, Reference],
    dialect: Dialect,
}

fn entry(tag: u8) -> Entry {
    Entry(kind: tag, value: "", info: "", title: "", number: 0, flag: false, tight: true, parent: 0, first: 0, last: 0, next: 0, prev: 0, open: true, indent: 0, padding: 0, marker: 0, fence: 0, html: 0, start_line: 0, end_line: 0)
}

fn byte(s: String, at: u64) -> u8 {
    let data = string.as_bytes(s)
    if at < list.len(data) {
        data[at]
    } else {
        0
    }
}

fn size(s: String) -> u64 {
    string.byte_len(s)
}

fn piece(s: String, a: u64, b: u64) -> String {
    string.from(string.slice(s, a, b))
}

fn space(c: u8) -> bool {
    c == 32 || c == 9
}

fn whitespace(c: u8) -> bool {
    c == 32 || c >= 9 && c <= 13
}

fn member(set: String, value: u8) -> bool {
    let mut i: u64 = 0
    while i < size(set) {
        if byte(set, i) == value {
            return true
        }
        i += 1
    }
    false
}

fn punctuation(c: u8) -> bool {
    c >= 33 && c <= 126 && !alpha_numeric(c)
}

fn trim(s: String) -> String {
    let mut a: u64 = 0
    let mut b = size(s)
    while a < b && (space(byte(s, a)) || byte(s, a) == 10 || byte(s, a) == 13) {
        a += 1
    }
    while b > a && (space(byte(s, b - 1)) || byte(s, b - 1) == 10 || byte(s, b - 1) == 13) {
        b -= 1
    }
    piece(s, a, b)
}

fn starts(s: String, at: u64, prefix: String) -> bool {
    list.starts_with_at(string.as_bytes(s), at, string.as_bytes(prefix))
}

fn run(s: String, at: u64, c: u8) -> u64 {
    let mut end = at
    while end < size(s) && byte(s, end) == c {
        end += 1
    }
    end - at
}

fn new_child(mut budget: ParseState, mut p: Parser, parent: u64, tag: u8) -> Result[u64, ParseLimit] {
    child_depth(budget, p.nodes, parent)?
    admit(mut budget, 1)?
    let id = list.len(p.nodes)
    let mut node = entry(tag)
    // Each parser entry owns its parallel source row and normalized byte map.
    admit(mut budget, 2)?
    list.push(mut p.sources, empty_source())
    node.parent = parent
    node.prev = p.nodes[parent].last
    list.push(mut p.nodes, take node)
    let last = p.nodes[parent].last
    if last != 0 {
        p.nodes[last].next = id
    } else {
        p.nodes[parent].first = id
    }
    p.nodes[parent].last = id
    Ok(id)
}

fn unlink(mut p: Parser, id: u64) -> () {
    let parent = p.nodes[id].parent
    let prev = p.nodes[id].prev
    let next = p.nodes[id].next
    if prev != 0 {
        p.nodes[prev].next = next
    } else {
        p.nodes[parent].first = next
    }
    if next != 0 {
        p.nodes[next].prev = prev
    } else {
        p.nodes[parent].last = prev
    }
    p.nodes[id].prev = 0
    p.nodes[id].next = 0
}

fn move_child(mut p: Parser, id: u64, parent: u64) -> () {
    unlink(mut p, id)
    let last = p.nodes[parent].last
    p.nodes[id].parent = parent
    p.nodes[id].prev = last
    if last != 0 {
        p.nodes[last].next = id
    } else {
        p.nodes[parent].first = id
    }
    p.nodes[parent].last = id
}

fn find_nonspace(mut p: Parser) -> () {
    let mut at = p.offset
    let mut col = p.column
    while at < size(p.line) && space(byte(p.line, at)) {
        col += if byte(p.line, at) == 9 {
            4 - col % 4
        } else {
            1
        }
        at += 1
    }
    p.nonspace = at
    p.nonspace_column = col
    p.indent = col - p.column
    p.blank = at == size(p.line)
}

fn advance(mut p: Parser, count: u64, columns: bool) -> () {
    let mut left = count
    while left > 0 && p.offset < size(p.line) {
        if byte(p.line, p.offset) == 9 {
            let width: u64 = 4 - p.column % 4
            let used = if columns && width > left {
                left
            } else {
                width
            }
            p.partial = columns && width > left
            p.column += used
            if !p.partial {
                p.offset += 1
            }
            left -= if columns {
                used
            } else {
                1
            }
        } else {
            p.partial = false
            p.offset += 1
            p.column += 1
            left -= 1
        }
    }
}

fn advance_nonspace(mut p: Parser) -> () {
    p.offset = p.nonspace
    p.column = p.nonspace_column
    p.partial = false
}

fn add_line(mut budget: ParseState, mut p: Parser) -> Result[(), ParseLimit] {
    let tip = p.tip
    if p.partial {
        let padding = 4 - p.column % 4
        let range = p.maps[p.line_number - 1].runs[p.offset]
        admit(mut budget, padding)?
        for _ in 0u64 .. padding {
            string.push_char(mut p.nodes[tip].value, ' ')
            list.push(mut p.sources[tip].runs, range)
        }
        p.offset += 1
    }
    let content_start = p.offset
    let content_end = size(p.line)
    append_content(mut budget, mut p, tip, content_start, content_end)?
    let range = p.maps[p.line_number - 1].terminator
    // A synthetic final LF is discarded before inline parsing.
    if range.tag == 0 {
        admit(mut budget, 1)?
        list.push(mut p.sources[tip].runs, range)
    }
    string.push(mut p.nodes[tip].value, string.slice(p.line, p.offset, size(p.line)))
    string.push(mut p.nodes[tip].value, "\n")
    extend_blocks(mut p, tip)
    Ok(())
}

fn can_contain(tag: u8, child: u8) -> bool {
    if tag == 4 {
        child == 5
    } else {
        (tag == 0 || tag == 3 || tag == 5) && child != 5
    }
}

fn finish_at(mut budget: ParseState, id: u64, line: u64, mut p: Parser) -> Result[(), ParseLimit] {
    if p.nodes[id].kind == 1 {
        // Keep definition-only paragraphs until lists have measured blank gaps,
        // as commonmark.js lib/blocks.js:277-299 does before document finalization.
        let _ = remove_references(mut budget, mut p, id)?
    }
    p.nodes[id].open = false
    p.nodes[id].end_line = line
    if p.nodes[id].kind == 6 {
        if p.nodes[id].fence != 0 {
            let (decoded, literal) = fence_parts(p.nodes[id].value)
            p.nodes[id].info = take decoded
            p.nodes[id].value = take literal
        } else {
            let value = string.from(p.nodes[id].value)
            let mut end = size(value)
            let mut blank_lines: u64 = 0
            while end > 0 {
                let mut start = end - 1
                while start > 0 && byte(value, start - 1) != 10 {
                    start -= 1
                }
                if size(trim(piece(value, start, end))) != 0 {
                    break
                }
                end = start
                blank_lines += 1
            }
            let literal = piece(value, 0, end)
            let end_content = if end > 0 && byte(value, end - 1) == 10 {
                end - 1
            } else {
                end
            }
            let extent = mapped_origin(p.sources[id].runs, 0, end_content)
            p.sources[id].row.primary.end = extent.end
            p.nodes[id].value = literal
            p.nodes[id].end_line -= blank_lines
        }
    }
    if p.nodes[id].kind == 4 {
        let mut item = p.nodes[id].first
        let mut tight = true
        while item != 0 {
            let next = p.nodes[item].next
            if next != 0 && p.nodes[item].end_line + 1 < p.nodes[next].start_line {
                tight = false
            }
            let mut child = p.nodes[item].first
            while child != 0 {
                let following = p.nodes[child].next
                if following != 0 && p.nodes[child].end_line + 1 < p.nodes[following].start_line {
                    tight = false
                }
                child = following
            }
            item = next
        }
        p.nodes[id].tight = tight
        let last = p.nodes[id].last
        if last != 0 {
            p.nodes[id].end_line = p.nodes[last].end_line
        }
    }
    if p.nodes[id].kind == 5 {
        let last = p.nodes[id].last
        p.nodes[id].end_line = if last == 0 {
            p.nodes[id].start_line
        } else {
            p.nodes[last].end_line
        }
    }
    p.tip = p.nodes[id].parent
    Ok(())
}

fn close_unmatched(mut budget: ParseState, mut p: Parser) -> Result[(), ParseLimit] {
    if !p.closed {
        while p.oldtip != p.matched {
            let parent = p.nodes[p.oldtip].parent
            let close_id = p.oldtip
            let close_line = p.line_number - 1
            finish_at(mut budget, close_id, close_line, mut p)?
            p.oldtip = parent
        }
        p.closed = true
    }
    Ok(())
}

fn add_block(mut budget: ParseState, mut p: Parser, tag: u8) -> Result[u64, ParseLimit] {
    while !can_contain(p.nodes[p.tip].kind, tag) {
        let close_id = p.tip
        let close_line = p.line_number - 1
        finish_at(mut budget, close_id, close_line, mut p)?
    }
    let tip = p.tip
    let id = new_child(mut budget, mut p, tip, tag)?
    p.nodes[id].start_line = p.line_number
    let (_, end) = trim_bounds(p.line)
    let extent = mapped_origin(p.maps[p.line_number - 1].runs, p.nonspace, end)
    include_extent(mut p, id, extent)
    p.tip = id
    Ok(id)
}

// HTML tag scanner implements commonmark.js common.js tag/attribute grammar.
fn html_tag_end(s: String, at: u64, mut missing: Inline[bool, 4]) -> u64 {
    if byte(s, at) != 60 {
        return at
    }
    let mut i = at + 1
    if starts(s, at, "<!-->") {
        return at + 5
    }
    if starts(s, at, "<!--->") {
        return at + 6
    }
    let mode: u64 = if starts(s, at, "<!--") {
        0
    } else if starts(s, at, "<?") {
        1
    } else if starts(s, at, "<![CDATA[") {
        2
    } else if byte(s, i) == 33 && int.is_ascii_alpha(byte(s, i + 1)) {
        3
    } else {
        4
    }
    if mode < 4 {
        if missing[mode] {
            return at
        }
        let close = match mode {
            0 => "-->",
            1 => "?>",
            2 => "]]>",
            _ => ">",
        }
        if let Some(pos) = string.find(s, i, close) {
            return pos + size(close)
        }
        // A failed search proves the rest of this input contains no closer.
        missing[mode] = true
        return at
    }
    let closing = byte(s, i) == 47
    if closing {
        i += 1
    }
    if !int.is_ascii_alpha(byte(s, i)) {
        return at
    }
    i += 1
    while alpha_numeric(byte(s, i)) || byte(s, i) == 45 {
        i += 1
    }
    while i < size(s) {
        let prior_offset = i
        while whitespace(byte(s, i)) {
            i += 1
        }
        if byte(s, i) == 62 {
            return i + 1
        }
        if !closing && starts(s, i, "/>") {
            return i + 2
        }
        if closing || prior_offset == i {
            return at
        }
        let c = byte(s, i)
        if !int.is_ascii_alpha(c) && c != 95 && c != 58 {
            return at
        }
        i += 1
        while alpha_numeric(byte(s, i)) || member("_:.-", byte(s, i)) && i < size(s) {
            i += 1
        }
        let after_name = i
        while whitespace(byte(s, i)) {
            i += 1
        }
        if byte(s, i) == 61 {
            i += 1
            while whitespace(byte(s, i)) {
                i += 1
            }
            let quote = byte(s, i)
            if quote == 34 || quote == 39 {
                i += 1
                while i < size(s) && byte(s, i) != quote {
                    i += 1
                }
                if i == size(s) {
                    return at
                }
                i += 1
            } else {
                let start = i
                while i < size(s) && !whitespace(byte(s, i)) && !member("\"'=<>`", byte(s, i)) {
                    i += 1
                }
                if i == start {
                    return at
                }
            }
        } else {
            i = after_name
        }
    }
    at
}

fn html_block_type(s: String, paragraph: bool) -> u8 {
    if byte(s, 0) != 60 {
        return 0
    }
    let lower = lower_ascii(s)
    let mut end: u64 = if byte(s, 1) == 47 {
        2
    } else {
        1
    }
    let begin = end
    while alpha_numeric(byte(s, end)) {
        end += 1
    }
    let tag = piece(lower, begin, end)
    let delim = byte(s, end)
    if begin == 1 && (delim == 0 || delim == 62 || whitespace(delim)) && (tag == "script" || tag == "pre" || tag == "style" || tag == "textarea") {
        return 1
    }
    if starts(s, 0, "<!--") {
        return 2
    }
    if starts(s, 0, "<?") {
        return 3
    }
    if starts(s, 0, "<!") && int.is_ascii_alpha(byte(s, 2)) {
        return 4
    }
    if starts(s, 0, "<![CDATA[") {
        return 5
    }
    if (delim == 0 || delim == 62 || whitespace(delim) || starts(s, end, "/>")) && tag != "" && contains("|address|article|aside|base|basefont|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h1|h2|h3|h4|h5|h6|head|header|hr|html|iframe|legend|li|link|main|menu|menuitem|nav|noframes|ol|optgroup|option|p|param|section|search|summary|table|tbody|td|tfoot|th|thead|title|tr|track|ul|", concat(concat("|", tag), "|")) {
        return 6
    }
    if !paragraph {
        let mut missing: Inline[bool, 4] =[false; 4]
        let n = html_tag_end(s, 0, mut missing)
        if n > 0 && size(trim(piece(s, n, size(s)))) == 0 {
            return 7
        }
    }
    0
}

fn html_closed(s: String, tag: u8) -> bool {
    if tag == 1 {
        let lower = lower_ascii(s)
        contains(lower, "</script>") || contains(lower, "</pre>") || contains(lower, "</style>") || contains(lower, "</textarea>")
    } else if tag == 2 {
        contains(s, "-->")
    } else if tag == 3 {
        contains(s, "?>")
    } else if tag == 4 {
        contains(s, ">")
    } else if tag == 5 {
        contains(s, "]]>")
    } else {
        false
    }
}

fn thematic(s: String) -> bool {
    let c = byte(s, 0)
    if c != 42 && c != 95 && c != 45 {
        return false
    }
    let mut count: u64 = 0
    let mut i: u64 = 0
    while i < size(s) {
        let b = byte(s, i)
        if b == c {
            count += 1
        } else if !space(b) {
            return false
        }
        i += 1
    }
    count >= 3
}

// Returns (marker length, marker byte, start, ordered).
fn list_marker(s: String, paragraph: bool) -> Option[(u64, u8, u64, bool)] {
    let c = byte(s, 0)
    let mut n: u64 = 1
    let mut start: u64 = 0
    let mut ordered = false
    if c != 42 && c != 43 && c != 45 {
        n = 0
        while n < 9 && int.is_ascii_digit(byte(s, n)) {
            start = start * 10 + int.widen(byte(s, n) - 48u8)
            n += 1
        }
        if n == 0 || byte(s, n) != 46 && byte(s, n) != 41 || paragraph && start != 1 {
            return None
        }
        n += 1
        ordered = true
    }
    if byte(s, n) != 0 && !space(byte(s, n)) {
        return None
    }
    if paragraph && size(trim(piece(s, n, size(s)))) == 0 {
        return None
    }
    Some((n, byte(s, n - 1), start, ordered))
}

fn continue_block(mut budget: ParseState, mut p: Parser, id: u64) -> Result[u8, ParseLimit] {
    let tag = p.nodes[id].kind
    if tag == 0 || tag == 4 {
        return Ok(0)
    }
    if tag == 3 {
        if p.indent < 4 && byte(p.line, p.nonspace) == 62 {
            advance_nonspace(mut p)
            advance(mut p, 1, false)
            if space(byte(p.line, p.offset)) {
                advance(mut p, 1, true)
            }
            return Ok(0)
        }
        return Ok(1)
    }
    if tag == 5 {
        let padding = p.nodes[id].indent + p.nodes[id].padding
        if p.indent >= padding {
            advance(mut p, padding, true)
        } else if p.blank && p.nodes[id].first != 0 {
            advance_nonspace(mut p)
        } else {
            return Ok(1)
        }
        return Ok(0)
    }
    if tag == 2 || tag == 8 {
        return Ok(1)
    }
    if tag == 6 {
        if p.nodes[id].fence != 0 {
            let n = run(p.line, p.nonspace, p.nodes[id].marker)
            if p.indent <= 3 && n >= p.nodes[id].fence && size(trim(piece(p.line, p.nonspace + n, size(p.line)))) == 0 {
                let endpoint = mapped_origin(p.maps[p.line_number - 1].runs, p.nonspace + n, p.nonspace + n)
                include_extent(mut p, id, endpoint)
                let close_id = id
                let close_line = p.line_number
                finish_at(mut budget, close_id, close_line, mut p)?
                return Ok(2)
            }
            let mut remaining = p.nodes[id].indent
            while remaining > 0 && space(byte(p.line, p.offset)) {
                advance(mut p, 1, true)
                remaining -= 1
            }
        } else if p.indent >= 4 {
            advance(mut p, 4, true)
        } else if p.blank {
            advance_nonspace(mut p)
        } else {
            return Ok(1)
        }
        return Ok(0)
    }
    if tag == 7 {
        return Ok(if p.blank && p.nodes[id].html >= 6 {
            1
        } else {
            0
        })
    }
    if tag == 1 {
        return Ok(if p.blank {
            1
        } else {
            0
        })
    }
    Ok(1)
}

fn start_block(mut budget: ParseState, mut p: Parser, container: u64) -> Result[u8, ParseLimit] {
    let s = piece(p.line, p.nonspace, size(p.line))
    let c = byte(s, 0)
    if p.indent < 4 {
        if c == 62 {
            advance_nonspace(mut p)
            advance(mut p, 1, false)
            if space(byte(p.line, p.offset)) {
                advance(mut p, 1, true)
            }
            close_unmatched(mut budget, mut p)?
            add_block(mut budget, mut p, 3)?
            return Ok(1)
        }
        let hashes = run(s, 0, 35)
        if hashes >= 1 && hashes <= 6 && (byte(s, hashes) == 0 || space(byte(s, hashes))) {
            advance_nonspace(mut p)
            advance(mut p, hashes, false)
            close_unmatched(mut budget, mut p)?
            let id = add_block(mut budget, mut p, 2)?
            p.nodes[id].number = hashes
            let raw = trim(piece(p.line, p.offset, size(p.line)))
            let mut end = size(raw)
            while end > 0 && byte(raw, end - 1) == 35 {
                end -= 1
            }
            let value = if end == 0 || end < size(raw) && space(byte(raw, end - 1)) {
                trim(piece(raw, 0, end))
            } else {
                take raw
            }
            let (left, _) = trim_bounds(piece(p.line, p.offset, size(p.line)))
            let begin = p.offset + left
            append_content(mut budget, mut p, id, begin, begin + size(value))?
            p.nodes[id].value = value
            p.offset = size(p.line)
            return Ok(2)
        }
        if c == 96 || c == 126 {
            let n = run(s, 0, c)
            if n >= 3 && (c != 96 || !contains(piece(s, n, size(s)), "`")) {
                close_unmatched(mut budget, mut p)?
                let id = add_block(mut budget, mut p, 6)?
                p.nodes[id].fence = n
                p.nodes[id].marker = c
                p.nodes[id].indent = p.indent
                advance_nonspace(mut p)
                advance(mut p, n, false)
                return Ok(2)
            }
        }
        let ht = html_block_type(s, p.nodes[container].kind == 1 || !p.closed && !p.blank && p.nodes[p.tip].kind == 1)
        if ht != 0 {
            close_unmatched(mut budget, mut p)?
            let id = add_block(mut budget, mut p, 7)?
            p.nodes[id].html = ht
            return Ok(2)
        }
        if p.nodes[container].kind == 1 && (c == 61 || c == 45) {
            let n = run(s, 0, c)
            if n != 0 && size(trim(piece(s, n, size(s)))) == 0 {
                // Definitions at the start do not become heading content.
                let remaining = remove_references(mut budget, mut p, container)?
                if remaining {
                    close_unmatched(mut budget, mut p)?
                    p.nodes[container].kind = 2
                    extend_blocks(mut p, container)
                    p.nodes[container].number = if c == 61 {
                        1
                    } else {
                        2
                    }
                    p.offset = size(p.line)
                    return Ok(2)
                }
            }
        }
        if thematic(s) {
            close_unmatched(mut budget, mut p)?
            add_block(mut budget, mut p, 8)?
            p.offset = size(p.line)
            return Ok(2)
        }
        if let Some((length, marker, start, ordered)) = list_marker(s, p.nodes[container].kind == 1) {
            let indent = p.indent
            advance_nonspace(mut p)
            advance(mut p, length, true)
            let column = p.column
            let offset = p.offset
            while space(byte(p.line, p.offset)) && p.column - column < 5 {
                advance(mut p, 1, true)
            }
            let spaces = p.column - column
            let padding = if spaces < 1 || spaces >= 5 || p.offset == size(p.line) {
                length + 1
            } else {
                length + spaces
            }
            if padding == length + 1 {
                p.column = column
                p.offset = offset
                p.partial = false
                if space(byte(p.line, p.offset)) {
                    advance(mut p, 1, true)
                }
            }
            close_unmatched(mut budget, mut p)?
            let mut list = p.tip
            if p.nodes[list].kind != 4 || p.nodes[list].marker != marker || p.nodes[list].flag != ordered {
                list = add_block(mut budget, mut p, 4)?
                p.nodes[list].marker = marker
                p.nodes[list].flag = ordered
                p.nodes[list].number = start
            }
            let id = add_block(mut budget, mut p, 5)?
            p.nodes[id].indent = indent
            p.nodes[id].padding = padding
            return Ok(1)
        }
    }
    if p.indent >= 4 && p.nodes[p.tip].kind != 1 && !p.blank {
        let indentation = p.maps[p.line_number - 1].runs[p.offset].start
        advance(mut p, 4, true)
        close_unmatched(mut budget, mut p)?
        let id = add_block(mut budget, mut p, 6)?
        p.sources[id].row.primary.start = indentation
        return Ok(2)
    }
    Ok(0)
}

fn incorporate(mut budget: ParseState, mut p: Parser, take line: String) -> Result[(), ParseLimit] {
    p.line = take line
    p.line_number += 1
    p.oldtip = p.tip
    p.offset = 0
    p.column = 0
    p.partial = false
    let mut container: u64 = 0
    while p.nodes[container].last != 0 && p.nodes[p.nodes[container].last].open {
        let child = p.nodes[container].last
        find_nonspace(mut p)
        let status = continue_block(mut budget, mut p, child)?
        if status == 2 {
            return Ok(())
        }
        if status == 1 {
            break
        }
        container = child
    }
    p.closed = container == p.oldtip
    p.matched = container
    let mut leaf = p.nodes[container].kind == 6 || p.nodes[container].kind == 7
    while !leaf {
        find_nonspace(mut p)
        let res = start_block(mut budget, mut p, container)?
        if res == 0 {
            advance_nonspace(mut p)
            break
        }
        container = p.tip
        leaf = res == 2
    }
    if !p.closed && !p.blank && p.nodes[p.tip].kind == 1 {
        add_line(mut budget, mut p)?
    } else {
        close_unmatched(mut budget, mut p)?
        let tag = p.nodes[container].kind
        if tag == 1 || tag == 6 || tag == 7 {
            add_line(mut budget, mut p)?
            if tag == 7 && html_closed(piece(p.line, p.offset, size(p.line)), p.nodes[container].html) {
                let close_id = container
                let close_line = p.line_number
                finish_at(mut budget, close_id, close_line, mut p)?
            }
        } else if p.offset < size(p.line) && !p.blank {
            add_block(mut budget, mut p, 1)?
            advance_nonspace(mut p)
            add_line(mut budget, mut p)?
        }
    }
    Ok(())
}

fn entity_lookup(name: String) -> Option[String] {
    let mut low: u64 = 0
    let mut high = ENTITY_COUNT
    while low < high {
        let middle = low + (high - low) / 2
        let at: u64 = ENTITY_INDEX[middle]
        let mut end = at
        while byte(ENTITY_DATA, end) != 0 {
            end += 1
        }
        let key = piece(ENTITY_DATA, at, end)
        if name < key {
            high = middle
        } else if name > key {
            low = middle + 1
        } else {
            let start = end + 1
            end = start
            while byte(ENTITY_DATA, end) != 0 {
                end += 1
            }
            return Some(piece(ENTITY_DATA, start, end))
        }
    }
    None
}

fn unicode_punctuation(c: char) -> bool {
    match char.category(c) {
        Pc => true,
        Pd => true,
        Ps => true,
        Pe => true,
        Pi => true,
        Pf => true,
        Po => true,
        Sm => true,
        Sc => true,
        Sk => true,
        So => true,
        _ => false,
    }
}

fn entity(s: String, at: u64) -> Option[(String, u64)] {
    if byte(s, at) != 38 {
        return None
    }
    let mut end = at + 1
    if byte(s, end) == 35 {
        end += 1
        let hex = byte(s, end) == 120 || byte(s, end) == 88
        if hex {
            end += 1
        }
        let begin = end
        let mut value: u32 = 0
        let base: u32 = if hex {
            16
        } else {
            10
        }
        let max: u64 = if hex {
            6
        } else {
            7
        }
        while end - begin < max {
            let Some(digit) = int.ascii_digit(byte(s, end), base) else {
                break
            }
            value = value * base + int.widen(digit)
            end += 1
        }
        if end == begin || byte(s, end) != 59 {
            return None
        }
        // CommonMark numeric references replace invalid scalars with U+FFFD.
        let c = if value == 0 || value > 1114111 || value >= 55296 && value <= 57343 {
            '\u{fffd}'
        } else {
            match char.from_u32(value) {
                Some(c) => c,
                None => '\u{fffd}',
            }
        }
        let mut out = string.new()
        string.push_char(mut out, c)
        return Some((take out, end + 1))
    }
    while end - at <= 32 && alpha_numeric(byte(s, end)) {
        end += 1
    }
    if end - at < 3 || byte(s, end) != 59 {
        return None
    }
    match entity_lookup(piece(s, at + 1, end)) {
        Some(value) => Some((value, end + 1)),
        None => None,
    }
}

fn unescape(s: String, escapes: bool) -> String {
    let mut out: List[u8] = list.new()
    let mut i: u64 = 0
    while i < size(s) {
        if escapes && byte(s, i) == 92 && punctuation(byte(s, i + 1)) {
            list.push(mut out, byte(s, i + 1))
            i += 2
        } else if let Some((value, end)) = entity(s, i) {
            append(mut out, value)
            i = end
        } else {
            list.push(mut out, byte(s, i))
            i += 1
        }
    }
    finish(take out)
}

fn normalize_uri(s: String) -> String {
    let mut out: List[u8] = list.new()
    let hex = "0123456789ABCDEF"
    let mut i: u64 = 0
    while i < size(s) {
        let b = byte(s, i)
        if alpha_numeric(b) || member(";/?:@&=+$,-_.!~*'()#", byte(s, i)) || b == 37 && i + 2 < size(s) && int.ascii_digit(byte(s, i + 1), 16) != None && int.ascii_digit(byte(s, i + 2), 16) != None {
            list.push(mut out, b)
            if b == 37 {
                list.push(mut out, byte(s, i + 1))
                list.push(mut out, byte(s, i + 2))
                i += 2
            }
        } else {
            list.push(mut out, 37u8)
            list.push(mut out, byte(hex, int.widen(b / 16u8)))
            list.push(mut out, byte(hex, int.widen(b % 16u8)))
        }
        i += 1
    }
    finish(take out)
}

fn skip_space(s: String, at: u64) -> u64 {
    let mut i = at
    while space(byte(s, i)) {
        i += 1
    }
    if byte(s, i) == 10 {
        i += 1
        while space(byte(s, i)) {
            i += 1
        }
    }
    i
}

fn destination(s: String, at: u64) -> Option[(String, u64)] {
    let angle = byte(s, at) == 60
    let begin = if angle {
        at + 1
    } else {
        at
    }
    let mut i = begin
    let mut depth: u64 = 0
    while i < size(s) {
        let c = byte(s, i)
        if c == 92 && punctuation(byte(s, i + 1)) {
            i += 2
            continue
        }
        if angle {
            if c == 62 {
                return Some((normalize_uri(unescape(piece(s, begin, i), true)), i + 1))
            }
            if c == 60 || c == 10 {
                return None
            }
        } else {
            if c <= 32 || c == 127 {
                break
            }
            if c == 40 {
                depth += 1
            }
            if c == 41 {
                if depth == 0 {
                    break
                }
                depth -= 1
            }
        }
        i += 1
    }
    if angle || depth != 0 || i == begin && byte(s, i) != 41 {
        return None
    }
    Some((normalize_uri(unescape(piece(s, begin, i), true)), i))
}

fn link_title(s: String, at: u64) -> Option[(String, u64)] {
    let c = byte(s, at)
    if c != 34 && c != 39 && c != 40 {
        return None
    }
    let close: u8 = if c == 40 {
        41
    } else {
        c
    }
    let mut i = at + 1
    while i < size(s) {
        if byte(s, i) == close {
            return Some((unescape(piece(s, at + 1, i), true), i + 1))
        }
        if c == 40 && byte(s, i) == 40 {
            return None
        }
        if byte(s, i) == 92 && punctuation(byte(s, i + 1)) {
            i += 1
        }
        i += 1
    }
    None
}

fn label_end(s: String, at: u64) -> u64 {
    if byte(s, at) != 91 {
        return at
    }
    let mut i = at + 1
    let mut count: u64 = 0
    while i < size(s) && count <= 999 {
        if byte(s, i) == 93 {
            return i + 1
        }
        if byte(s, i) == 91 {
            return at
        }
        if byte(s, i) == 92 && i + 1 < size(s) {
            i += 1
        }
        i += 1
        count += 1
    }
    at
}

fn normalize_label(s: String) -> String {
    let folded = fold_label(s)
    let mut out = string.new()
    let mut pending = false
    let mut any = false
    let mut at = 0u64
    while let Some((c, next)) = string.next_scalar(folded, at) {
        at = next
        if char.is_whitespace(c) {
            pending = any
        } else {
            if pending {
                string.push_char(mut out, ' ')
            }
            string.push_char(mut out, c)
            pending = false
            any = true
        }
    }
    take out
}

fn line_end(s: String, at: u64) -> Option[u64] {
    let mut i = at
    while space(byte(s, i)) {
        i += 1
    }
    if i == size(s) {
        Some(i)
    } else if byte(s, i) == 10 {
        Some(i + 1)
    } else {
        None
    }
}

fn reference(mut budget: ParseState, s: String, mut refs: Map[String, Reference]) -> Result[u64, ParseLimit] {
    let n = label_end(s, 0)
    if n == 0 || byte(s, n) != 58 {
        return Ok(0)
    }
    let label = normalize_label(piece(s, 1, n - 1))
    if label == "" {
        return Ok(0)
    }
    let dest_start = skip_space(s, n + 1)
    let Some((dest, end)) = destination(s, dest_start) else {
        return Ok(0)
    }
    let after_space = skip_space(s, end)
    let mut title = ""
    let mut consumed = line_end(s, end)
    if after_space > end {
        if let Some((value, after)) = link_title(s, after_space) {
            if let Some(final) = line_end(s, after) {
                consumed = Some(final)
                title = value
            }
        }
    }
    let Some(final) = consumed else {
        return Ok(0)
    }
    if !map.contains(refs, label) {
        admit(mut budget, 1)?
        map.insert(mut refs, take label, Reference(destination: dest, title: title))
    }
    Ok(final)
}

fn remove_references(mut budget: ParseState, mut p: Parser, id: u64) -> Result[bool, ParseLimit] {
    let value = string.from(p.nodes[id].value)
    let mut removed = 0u64
    let length = size(value)
    while byte(value, removed) == 91 {
        let n = reference(mut budget, string.slice(value, removed, length), mut p.refs)?
        if n == 0 {
            break
        }
        removed += n
    }
    let rest = string.slice(value, removed, length)
    let (a, b) = trim_bounds(rest)
    if removed > 0 {
        let mapped_length = list.len(p.sources[id].runs)
        let first = if removed < mapped_length {
            removed
        } else {
            mapped_length
        }
        p.sources[id].row.primary = mapped_origin(p.sources[id].runs, first + a, first + b)
        content_slice(mut budget, mut p, id, first, mapped_length)?
        p.nodes[id].value = string.from(rest)
    }
    Ok(a != b)
}

type Delimiter {
    node: u64,
    marker: u8,
    count: u64,
    original: u64,
    opens: bool,
    closes: bool,
    prev: u64,
    next: u64,
}

type Bracket {
    node: u64,
    index: u64,
    image: bool,
    active: bool,
    bracket_after: bool,
    delimiter: u64,
}

type InlineParser {
    runs: List[SourceSpan],
    source: String,
    at: u64,
    delimiters: List[Delimiter],
    top: u64,
    brackets: List[Bracket],
    link_ends: List[LinkEnds],
}

fn text_node(mut budget: ParseState, mut p: Parser, parent: u64, take value: String, tag: u8) -> Result[u64, ParseLimit] {
    let id = new_child(mut budget, mut p, parent, tag)?
    p.nodes[id].value = take value
    Ok(id)
}

fn remove_delimiter(mut ip: InlineParser, id: u64) -> () {
    let prev = ip.delimiters[id].prev
    let next = ip.delimiters[id].next
    if prev != 0 {
        ip.delimiters[prev].next = next
    }
    if next != 0 {
        ip.delimiters[next].prev = prev
    } else {
        ip.top = prev
    }
}

fn process_emphasis(mut budget: ParseState, mut p: Parser, mut ip: InlineParser, bottom: u64) -> Result[(), ParseLimit] {
    if ip.top == 0 {
        return Ok(())
    }
    let mut closer = ip.top
    while closer != 0 && ip.delimiters[closer].prev != bottom {
        closer = ip.delimiters[closer].prev
    }
    // One lower bound per marker, flanking class and length modulo three.
    let mut bounds: List[u64] = list.new()
    let mut k: u64 = 0
    while k < 12 {
        admit(mut budget, 1)?
        list.push(mut bounds, bottom)
        k += 1
    }
    while closer != 0 {
        if !ip.delimiters[closer].closes {
            closer = ip.delimiters[closer].next
            continue
        }
        let marker = ip.delimiters[closer].marker
        let marker_base: u64 = if marker == 42 {
            0
        } else {
            6
        }
        let flanking_class: u64 = if ip.delimiters[closer].opens {
            3
        } else {
            0
        }
        let index = marker_base + flanking_class + ip.delimiters[closer].original % 3
        let mut opener = ip.delimiters[closer].prev
        while opener > bottom && opener > bounds[index] {
            let odd = (ip.delimiters[closer].opens || ip.delimiters[opener].closes) && ip.delimiters[closer].original % 3 != 0 && (ip.delimiters[closer].original + ip.delimiters[opener].original) % 3 == 0
            if ip.delimiters[opener].marker == marker && ip.delimiters[opener].opens && !odd {
                break
            }
            opener = ip.delimiters[opener].prev
        }
        if opener <= bottom || opener <= bounds[index] {
            bounds[index] = ip.delimiters[closer].prev
            let old = closer
            closer = ip.delimiters[closer].next
            if !ip.delimiters[old].opens {
                remove_delimiter(mut ip, old)
            }
            continue
        }
        let used: u64 = if ip.delimiters[opener].count >= 2 && ip.delimiters[closer].count >= 2 {
            2
        } else {
            1
        }
        let left = ip.delimiters[opener].node
        let right = ip.delimiters[closer].node
        let left_size = size(p.nodes[left].value)
        let right_size = size(p.nodes[right].value)
        let left_span = p.sources[left].row.primary
        let right_span = p.sources[right].row.primary
        let extent = cover(left_span.end - used, right_span.start + used)
        ip.delimiters[opener].count -= used
        ip.delimiters[closer].count -= used
        string.truncate(mut p.nodes[left].value, left_size - used)
        string.truncate(mut p.nodes[right].value, right_size - used)
        let parent = p.nodes[left].parent
        let emph = new_child(mut budget, mut p, parent, if used == 1 {
            14
        } else {
            15
        })?
        p.sources[emph].row.primary = extent
        p.sources[left].row.primary.end -= used
        p.sources[right].row.primary.start += used
        let mut current = p.nodes[left].next
        while current != right && current != 0 && current != emph {
            let next = p.nodes[current].next
            move_child(mut p, current, emph)
            current = next
        }
        // Insert the new emphasis immediately after the opener.
        unlink(mut p, emph)
        let next = p.nodes[left].next
        p.nodes[emph].prev = left
        p.nodes[emph].next = next
        p.nodes[left].next = emph
        if next != 0 {
            p.nodes[next].prev = emph
        } else {
            p.nodes[parent].last = emph
        }
        ip.delimiters[opener].next = closer
        ip.delimiters[closer].prev = opener
        if ip.delimiters[opener].count == 0 {
            unlink(mut p, left)
            remove_delimiter(mut ip, opener)
        }
        if ip.delimiters[closer].count == 0 {
            unlink(mut p, right)
            let next_closer = ip.delimiters[closer].next
            remove_delimiter(mut ip, closer)
            closer = next_closer
        }
    }
    while ip.top != bottom && ip.top != 0 {
        let top = ip.top
        remove_delimiter(mut ip, top)
    }
    Ok(())
}

fn adjacent_class(s: String, at: u64, previous: bool) -> (bool, bool) {
    if previous && at == 0 || !previous && at == size(s) {
        return (true, false)
    }
    let mut pos = if previous {
        at - 1
    } else {
        at
    }
    if previous {
        while pos > 0 && byte(s, pos) >= 128 && byte(s, pos) < 192 {
            pos -= 1
        }
    }
    let (c, _) = option.unwrap(string.next_scalar(s, pos))
    (c == ' ' || c == '\t' || c == '\n' || c == '\r' || char.to_u32(c) == 12 || char.category(c) == Zs, unicode_punctuation(c) || punctuation(byte(s, pos)))
}

fn handle_delimiter(mut budget: ParseState, mut p: Parser, parent: u64, mut ip: InlineParser) -> Result[(), ParseLimit] {
    let c = byte(ip.source, ip.at)
    let n = run(ip.source, ip.at, c)
    let (before_ws, before_punct) = adjacent_class(ip.source, ip.at, true)
    let (after_ws, after_punct) = adjacent_class(ip.source, ip.at + n, false)
    let left = !after_ws && (!after_punct || before_ws || before_punct)
    let right = !before_ws && (!before_punct || after_ws || after_punct)
    let opens = left && (c != 95 || !right || before_punct)
    let closes = right && (c != 95 || !left || after_punct)
    let id = text_node(mut budget, mut p, parent, piece(ip.source, ip.at, ip.at + n), 9)?
    inline_source(mut p, id, ip.runs, ip.at, ip.at + n)
    if opens || closes {
        let d = list.len(ip.delimiters)
        if ip.top != 0 {
            ip.delimiters[ip.top].next = d
        }
        admit(mut budget, 1)?
        list.push(mut ip.delimiters, Delimiter(node: id, marker: c, count: n, original: n, opens: opens, closes: closes, prev: ip.top, next: 0))
        ip.top = d
    }
    ip.at += n
    Ok(())
}

fn email_address(s: String) -> bool {
    let mut i: u64 = 0
    while i < size(s) && (alpha_numeric(byte(s, i)) || member(".!#$%&'*+/=?^_`{|}~-", byte(s, i))) {
        i += 1
    }
    if i == 0 || byte(s, i) != 64 {
        return false
    }
    i += 1
    while i < size(s) {
        let start = i
        if !alpha_numeric(byte(s, i)) {
            return false
        }
        while i < size(s) && (alpha_numeric(byte(s, i)) || byte(s, i) == 45) {
            i += 1
        }
        if i - start > 63 || !alpha_numeric(byte(s, i - 1)) {
            return false
        }
        if i == size(s) {
            return true
        }
        if byte(s, i) != 46 {
            return false
        }
        i += 1
    }
    false
}

fn uri_scheme(s: String) -> bool {
    if !int.is_ascii_alpha(byte(s, 0)) {
        return false
    }
    let mut i: u64 = 1
    while i < 32 && (alpha_numeric(byte(s, i)) || byte(s, i) == 43 || byte(s, i) == 46 || byte(s, i) == 45) {
        i += 1
    }
    if i < 2 || byte(s, i) != 58 {
        return false
    }
    while i < size(s) {
        if byte(s, i) <= 32 || byte(s, i) == 60 || byte(s, i) == 62 {
            return false
        }
        i += 1
    }
    true
}

fn close_bracket(mut budget: ParseState, mut p: Parser, parent: u64, mut ip: InlineParser) -> Result[(), ParseLimit] {
    ip.at += 1
    let after = ip.at
    let Some(bracket) = list.pop(mut ip.brackets) else {
        let text_id_0 = text_node(mut budget, mut p, parent, "]", 9)?
        inline_source(mut p, text_id_0, ip.runs, after - 1, after)
        return Ok(())
    }
    if !bracket.active {
        let text_id_1 = text_node(mut budget, mut p, parent, "]", 9)?
        inline_source(mut p, text_id_1, ip.runs, after - 1, after)
        return Ok(())
    }
    let mut dest = ""
    let mut title = ""
    let mut matched = false
    if byte(ip.source, after) == 40 {
        if let Some((address, description, end)) = inline_link(ip.source, ip.link_ends, after + 1) {
            dest = string.from(address)
            title = string.from(description)
            matched = true
            ip.at = end
        }
    }
    if !matched {
        let end = label_end(ip.source, after)
        let mut label = ""
        if end > after + 2 {
            label = normalize_label(piece(ip.source, after + 1, end - 1))
        } else if !bracket.bracket_after {
            label = normalize_label(piece(ip.source, bracket.index + 1, after - 1))
        }
        if label != "" {
            if let Some(definition) = map.get(p.refs, label) {
                dest = string.from(definition.destination)
                title = string.from(definition.title)
                matched = true
                ip.at = if end > after {
                    end
                } else {
                    after
                }
            }
        }
    }
    if !matched {
        ip.at = after
        // cmark-gfm src/inlines.c:1238-1307: only after ordinary link matching
        // fails, restore the raw label and remove parsed emphasis/link children.
        let text_id_2 = text_node(mut budget, mut p, parent, "]", 9)?
        inline_source(mut p, text_id_2, ip.runs, after - 1, after)
        return Ok(())
    }
    let id = new_child(mut budget, mut p, parent, if bracket.image {
        17
    } else {
        16
    })?
    admit(mut budget, 1)?
    p.sources[id].row.primary = hull(p.sources[bracket.node].row.primary, mapped_origin(ip.runs, after - 1, ip.at))
    p.nodes[id].info = dest
    p.nodes[id].title = title
    let mut current = p.nodes[bracket.node].next
    while current != 0 && current != id {
        let next = p.nodes[current].next
        move_child(mut p, current, id)
        current = next
    }
    process_emphasis(mut budget, mut p, mut ip, bracket.delimiter)?
    unlink(mut p, bracket.node)
    if !bracket.image {
        let mut i: u64 = 0
        while i < list.len(ip.brackets) {
            if !ip.brackets[i].image {
                ip.brackets[i].active = false
            }
            i += 1
        }
    }
    Ok(())
}

fn parse_inlines(mut budget: ParseState, mut p: Parser, parent: u64) -> Result[(), ParseLimit] {
    let source = trim(p.nodes[parent].value)
    let runs = {
        let (source_start, source_end) = trim_bounds(p.nodes[parent].value)
        slice_runs(mut budget, p.sources[parent].runs, source_start, source_end)?
    }
    if p.nodes[parent].kind == 1 {
        p.sources[parent].row.primary = mapped_origin(runs, 0, size(source))
    }
    let markers = b"\n`\\*_[]!<&"
    // A literal run needs neither a delimiter stack nor bracket bookkeeping.
    if find_any(string.as_bytes(source), markers, 0) == size(source) {
        if size(source) != 0 {
            let length = size(source)
            let text_id_3 = text_node(mut budget, mut p, parent, take source, 9)?
            inline_source(mut p, text_id_3, runs, 0, length)
        }
        p.sources[parent].runs = list.new()
        p.nodes[parent].value = ""
        return Ok(())
    }
    admit(mut budget, 1)?
    let sentinel = Delimiter(node: 0, marker: 0, count: 0, original: 0, opens: false, closes: false, prev: 0, next: 0)
    let mut delimiters: List[Delimiter] = list.new()
    list.push(mut delimiters, sentinel)
    let ticks = backtick_ends(mut budget, source)?
    let link_ends = scan_link_ends(mut budget, source)?
    let mut ip: InlineParser = InlineParser(runs: take runs, source: take source, at: 0, delimiters: take delimiters, top: 0, brackets: list.new(), link_ends: take link_ends)
    let mut missing: Inline[bool, 4] =[false; 4]
    while ip.at < size(ip.source) {
        let start = ip.at
        let c = byte(ip.source, start)
        if c == 96 {
            let n = run(ip.source, start, c)
            ip.at += n
            let end = ticks[start]
            if end != 0 {
                let mut value = replace_newlines(piece(ip.source, ip.at, end))
                if size(value) >= 2 && byte(value, 0) == 32 && byte(value, size(value) - 1) == 32 && run(value, 0, 32) < size(value) {
                    value = piece(value, 1, size(value) - 1)
                }
                let text_id_5 = text_node(mut budget, mut p, parent, take value, 12)?
                inline_source(mut p, text_id_5, ip.runs, start, end + n)
                ip.at = end + n
            } else {
                let text_id_6 = text_node(mut budget, mut p, parent, piece(ip.source, start, ip.at), 9)?
                inline_source(mut p, text_id_6, ip.runs, start, ip.at)
            }
            continue
        }
        if c == 92 {
            let next = byte(ip.source, start + 1)
            if next == 10 {
                let break_id = new_child(mut budget, mut p, parent, 11)?
                p.sources[break_id].row.primary = mapped_origin(ip.runs, start, start + 2)
                ip.at = start + 2
                while space(byte(ip.source, ip.at)) {
                    ip.at += 1
                }
            } else if punctuation(next) {
                let text_id_7 = text_node(mut budget, mut p, parent, piece(ip.source, start + 1, start + 2), 9)?
                inline_source(mut p, text_id_7, ip.runs, start, start + 2)
                ip.at += 2
            } else {
                let text_id_8 = text_node(mut budget, mut p, parent, "\\", 9)?
                inline_source(mut p, text_id_8, ip.runs, start, start + 1)
                ip.at += 1
            }
            continue
        }
        if c == 10 {
            let mut content_end = start
            while content_end > 0 && byte(ip.source, content_end - 1) == 32 {
                content_end -= 1
            }
            let hard = start - content_end >= 2
            let mut break_extent = mapped_origin(ip.runs, start, start + 1)
            if content_end != start {
                let last = p.nodes[parent].last
                let trailing = start - content_end
                let end = size(p.nodes[last].value) - trailing
                string.truncate(mut p.nodes[last].value, end)
                let gap = mapped_origin(ip.runs, content_end, start)
                p.sources[last].row.primary.end = gap.start
                if hard {
                    break_extent = hull(gap, break_extent)
                }
                if end == 0 {
                    unlink(mut p, last)
                }
            }
            let break_id = new_child(mut budget, mut p, parent, if hard {
                11
            } else {
                10
            })?
            p.sources[break_id].row.primary = break_extent
            ip.at += 1
            while space(byte(ip.source, ip.at)) {
                ip.at += 1
            }
            continue
        }
        if c == 42 || c == 95 {
            handle_delimiter(mut budget, mut p, parent, mut ip)?
            continue
        }
        if p.dialect == Wiki && c == 91 && byte(ip.source, start + 1) == 91 {
            if let Some((pipe, end)) = wiki_end(ip.source, start + 2) {
                let target_end = if pipe == 0 {
                    end
                } else {
                    pipe
                }
                let target = piece(ip.source, start + 2, target_end)
                let label = if pipe == 0 {
                    string.from(target)
                } else {
                    piece(ip.source, pipe + 1, end)
                }
                let id = new_child(mut budget, mut p, parent, 18)?
                p.nodes[id].info = take target
                p.nodes[id].title = take label
                p.sources[id].row.primary = mapped_origin(ip.runs, start, end + 2)
                p.sources[id].row.target = mapped_origin(ip.runs, start + 2, target_end)
                if pipe != 0 {
                    p.sources[id].row.label = mapped_origin(ip.runs, pipe + 1, end)
                }
                ip.at = end + 2
                continue
            }
        }
        if c == 91 || c == 33 && byte(ip.source, start + 1) == 91 {
            let image = c == 33
            ip.at += if image {
                2
            } else {
                1
            }
            let id = text_node(mut budget, mut p, parent, piece(ip.source, start, ip.at), 9)?
            inline_source(mut p, id, ip.runs, start, ip.at)
            let len = list.len(ip.brackets)
            if len != 0 {
                ip.brackets[len - 1].bracket_after = true
            }
            // Root plus the pending bracket stack.
            if len >= budget.nesting - 1 {
                return Error(Nesting)
            }
            admit(mut budget, 1)?
            list.push(mut ip.brackets, Bracket(node: id, index: if image {
                start + 1
            } else {
                start
            }, image: image, active: true, bracket_after: false, delimiter: ip.top))
            continue
        }
        if c == 93 {
            close_bracket(mut budget, mut p, parent, mut ip)?
            continue
        }
        if c == 60 {
            let mut end = start + 1
            while end < size(ip.source) && byte(ip.source, end) != 60 && byte(ip.source, end) != 62 && byte(ip.source, end) != 10 {
                end += 1
            }
            if byte(ip.source, end) == 62 {
                let content = piece(ip.source, start + 1, end)
                let email = email_address(content)
                if email || uri_scheme(content) {
                    let value = unescape(content, false)
                    let id = new_child(mut budget, mut p, parent, 16)?
                    p.nodes[id].info = if email {
                        normalize_uri(concat("mailto:", value))
                    } else {
                        normalize_uri(value)
                    }
                    admit(mut budget, 1)?
                    p.sources[id].row.primary = mapped_origin(ip.runs, start, end + 1)
                    let text_id_10 = text_node(mut budget, mut p, id, take value, 9)?
                    inline_source(mut p, text_id_10, ip.runs, start + 1, end)
                    ip.at = end + 1
                    continue
                }
            }
            let html_end = html_tag_end(ip.source, start, mut missing)
            if html_end > start {
                let text_id_11 = text_node(mut budget, mut p, parent, piece(ip.source, start, html_end), 13)?
                inline_source(mut p, text_id_11, ip.runs, start, html_end)
                ip.at = html_end
                continue
            }
        }
        if c == 38 {
            if let Some((value, end)) = entity(ip.source, start) {
                let text_id_12 = text_node(mut budget, mut p, parent, string.from(value), 9)?
                inline_source(mut p, text_id_12, ip.runs, start, end)
                ip.at = end
                continue
            }
        }
        // Aggregate ordinary text so trailing-space processing sees a complete run.
        let end = find_any(string.as_bytes(ip.source), markers, start + 1)
        let text_id_13 = text_node(mut budget, mut p, parent, piece(ip.source, start, end), 9)?
        inline_source(mut p, text_id_13, ip.runs, start, end)
        ip.at = end
    }
    process_emphasis(mut budget, mut p, mut ip, 0)?
    p.sources[parent].runs = list.new()
    p.nodes[parent].value = ""
    Ok(())
}

fn normalized_line(source: String, begin: u64, end: u64, take prefix: List[u8]) -> String {
    if list.len(prefix) == 0 {
        piece(source, begin, end)
    } else {
        let mut out = take prefix
        append(mut out, piece(source, begin, end))
        finish(take out)
    }
}

fn normalized_lines(mut budget: ParseState, source: String) -> Result[List[String], ParseLimit] {
    let data = string.as_bytes(source)
    let len = list.len(data)
    let mut lines: List[String] = list.new()
    // LF-only input needs no replacement buffer or CRLF state.
    if find_any(data, b"\x00\r", 0) == len {
        let mut begin = 0u64
        while begin < len {
            let end = find_any(data, b"\n", begin)
            admit(mut budget, 1)?
            list.push(mut lines, piece(source, begin, end))
            if end == len {
                return Ok(take lines)
            }
            begin = end + 1
        }
        return Ok(take lines)
    }
    let mut prefix: List[u8] = list.new()
    let mut begin = 0u64
    let mut at = 0u64
    while at < len {
        let end = find_any(data, b"\x00\r\n", at)
        if end == len {
            break
        }
        let c = data[end]
        if c == 0 {
            admit(mut budget, 2)?
            append(mut prefix, piece(source, begin, end))
            append(mut prefix, "\u{fffd}")
            begin = end + 1
        } else {
            admit(mut budget, 1)?
            list.push(mut lines, normalized_line(source, begin, end, take prefix))
            prefix = list.new()
            begin = end + 1
            if c == 13 && begin < len && data[begin] == 10 {
                begin += 1
            }
        }
        at = begin
    }
    if begin < len || list.len(prefix) != 0 {
        admit(mut budget, 1)?
        list.push(mut lines, normalized_line(source, begin, len, take prefix))
    }
    Ok(take lines)
}

fn parse_arena(source: String, dialect: Dialect, take maps: List[LineMap], mut budget: ParseState) -> Result[Parser, ParseLimit] {
    admit(mut budget, 1)?
    let mut sources: List[EntrySource] = list.new()
    admit(mut budget, 2)?
    list.push(mut sources, empty_source())
    let mut entries: List[Entry] = list.new()
    list.push(mut entries, entry(0))
    let mut p = Parser(
        sources: take sources,
        maps: take maps,
        nodes: take entries,
        tip: 0,
        line: "",
        offset: 0,
        column: 0,
        nonspace: 0,
        nonspace_column: 0,
        indent: 0,
        blank: false,
        partial: false,
        matched: 0,
        oldtip: 0,
        closed: true,
        line_number: 0,
        refs: map.new(),
        dialect,
    )
    let lines = normalized_lines(mut budget, source)?
    for line in lines {
        incorporate(mut budget, mut p, string.from(line))?
    }
    while p.tip != 0 {
        let close_id = p.tip
        let close_line = p.line_number
        finish_at(mut budget, close_id, close_line, mut p)?
    }
    let count = list.len(p.nodes)
    let mut empty_id: u64 = 1
    while empty_id < count {
        if p.nodes[empty_id].kind == 1 && p.nodes[empty_id].value == "" {
            unlink(mut p, empty_id)
        }
        empty_id += 1
    }
    let mut id: u64 = 1
    while id < count {
        if p.nodes[id].kind == 1 || p.nodes[id].kind == 2 {
            parse_inlines(mut budget, mut p, id)?
        }
        id += 1
    }
    Ok(take p)
}

type SourceSpan {
    tag: u8,
    start: u64,
    end: u64,
}

type EntrySource {
    row: SourceRow,
    runs: List[SourceSpan],
}

type LineMap {
    runs: List[SourceSpan],
    terminator: SourceSpan,
}

fn empty_source() -> EntrySource {
    EntrySource(row: SourceRow(primary: absent_span(1), target: absent_span(1), label: absent_span(1)), runs: list.new())
}

// Internal rows use only scalar fields. Public origin enums are decoded at
// the view boundary, so ordinary parsing does not register their variant graph.
fn cover(a: u64, b: u64) -> SourceSpan {
    SourceSpan(tag: 0, start: a, end: b)
}

fn absent_span(tag: u8) -> SourceSpan {
    SourceSpan(tag: tag, start: 0, end: 0)
}

fn hull(a: SourceSpan, b: SourceSpan) -> SourceSpan {
    if a.tag == 0 && b.tag == 0 {
        cover(if a.start < b.start {
            a.start
        } else {
            b.start
        }, if a.end > b.end {
            a.end
        } else {
            b.end
        })
    } else if b.tag == 0 {
        b
    } else {
        a
    }
}

// Index by normalized byte. A rewritten UTF-8 scalar or a partially
// consumed tab can give several normalized bytes the same original extent.
fn mapped_origin(runs: List[SourceSpan], a: u64, b: u64) -> SourceSpan {
    if a < b {
        return cover(runs[a].start, runs[b - 1].end)
    }
    if a > 0 && a <= list.len(runs) {
        let end = runs[a - 1].end
        return cover(end, end)
    }
    if a == 0 && list.len(runs) != 0 {
        let start = runs[0].start
        return cover(start, start)
    }
    absent_span(1)
}

fn slice_runs(mut budget: ParseState, runs: List[SourceSpan], a: u64, b: u64) -> Result[List[SourceSpan], ParseLimit] {
    admit(mut budget, b - a)?
    let mut out: List[SourceSpan] = list.with_capacity(b - a)
    list.append(mut out, list.slice(runs, a, b))
    Ok(take out)
}

fn trim_bounds(source: String) -> (u64, u64) {
    let mut a = 0u64
    let mut b = size(source)
    while a < b && (space(byte(source, a)) || byte(source, a) == 10 || byte(source, a) == 13) {
        a += 1
    }
    while b > a && (space(byte(source, b - 1)) || byte(source, b - 1) == 10 || byte(source, b - 1) == 13) {
        b -= 1
    }
    (a, b)
}

// Called before normalization, preserving CRLF width and NUL rewrite atoms.
fn source_index(mut budget: ParseState, source: String) -> Result[List[LineMap], ParseLimit] {
    let mut maps: List[LineMap] = list.new()
    let mut begin = 0u64
    while true {
        let mut end = begin
        while end < size(source) && byte(source, end) != 10 && byte(source, end) != 13 {
            end += 1
        }
        let mut next = end
        if next < size(source) {
            next += 1
            if byte(source, end) == 13 && byte(source, next) == 10 {
                next += 1
            }
        }
        if begin == size(source) {
            break
        }
        let mut runs: List[SourceSpan] = list.new()
        for at in begin .. end {
            let width = if byte(source, at) == 0 {
                3u64
            } else {
                1u64
            }
            admit(mut budget, width)?
            for _ in 0u64 .. width {
                list.push(mut runs, cover(at, at + 1))
            }
        }
        admit(mut budget, 1)?
        list.push(mut maps, LineMap(runs: take runs, terminator: if next > end {
            cover(end, next)
        } else {
            absent_span(1)
        }))
        if next == end {
            break
        }
        begin = next
    }
    Ok(take maps)
}

fn append_content(mut budget: ParseState, mut p: Parser, id: u64, a: u64, b: u64) -> Result[(), ParseLimit] {
    admit(mut budget, b - a)?
    let line_number = p.line_number - 1
    list.append(mut p.sources[id].runs, list.slice(p.maps[line_number].runs, a, b))
    Ok(())
}

fn content_slice(mut budget: ParseState, mut p: Parser, id: u64, a: u64, b: u64) -> Result[(), ParseLimit] {
    let runs = slice_runs(mut budget, p.sources[id].runs, a, b)?
    p.sources[id].runs = take runs
    Ok(())
}

fn inline_source(mut p: Parser, id: u64, runs: List[SourceSpan], a: u64, b: u64) {
    p.sources[id].row.primary = mapped_origin(runs, a, b)
}

fn entry_kind(n: Entry) -> Kind {
    let payload: Kind = match n.kind {
        0 => Document,
        1 => Paragraph,
        2 => Heading(n.number),
        3 => BlockQuote,
        4 => ListBlock(n.flag, n.number, n.tight),
        5 => Item,
        6 => CodeBlock(string.from(n.value), string.from(n.info)),
        7 => HtmlBlock(string.from(n.value)),
        8 => ThematicBreak,
        9 => Text(string.from(n.value)),
        10 => SoftBreak,
        11 => HardBreak,
        12 => Code(string.from(n.value)),
        13 => HtmlInline(string.from(n.value)),
        14 => Emphasis,
        15 => Strong,
        16 => Link(string.from(n.info), string.from(n.title)),
        17 => Image(string.from(n.info), string.from(n.title)),
        _ => Wikilink(string.from(n.info), string.from(n.title)),
    }
    take payload
}

fn extend_blocks(mut p: Parser, id: u64) -> () {
    if list.len(p.maps) == 0 || p.blank && p.nodes[id].kind != 6 && p.nodes[id].kind != 7 {
        return
    }
    let mut last = size(p.line)
    let tag = p.nodes[id].kind
    if tag != 6 && tag != 7 {
        while last > 0 && space(byte(p.line, last - 1)) {
            last -= 1
        }
    }
    let mapped = mapped_origin(p.maps[p.line_number - 1].runs, last, last)
    let endpoint = if last == 0 {
        let terminator = p.maps[p.line_number - 1].terminator
        if terminator.tag == 0 {
            cover(terminator.start, terminator.start)
        } else {
            mapped
        }
    } else {
        mapped
    }
    include_extent(mut p, id, endpoint)
}

fn include_extent(mut p: Parser, id: u64, endpoint: SourceSpan) {
    let mut current = id
    while current != 0 {
        let old = p.sources[current].row.primary
        p.sources[current].row.primary = hull(old, endpoint)
        current = p.nodes[current].parent
    }
}

fn public_span(s: SourceSpan) -> Span {
    Span(start: s.start, end: s.end)
}

fn optional_span(s: SourceSpan) -> Option[Span] {
    if s.tag == 0 {
        Some(public_span(s))
    } else {
        None
    }
}

/// Parses Markdown into a flat tree, indexed by first child and next sibling.
/// Node zero is the document. A zero child or sibling means end of the chain.
/// Spans are half-open byte offsets in source. Headings carry their section
/// extent, and wikilinks carry separate target and explicit-label spans.
/// Returns SourceBytes, WorkItems or Nesting when a limit is met. The parser
/// caps nesting at 128 even when the requested limit is higher.
/// Alloc: O(source bytes and parser records). May raise Capacity.
/// Ex: markdown.parse("# Title", CommonMark, markdown.ParseBudget(source_bytes: 4096, work_items: 16384, nesting: 64)).
pub fn parse(source: String, dialect: Dialect, limits: ParseBudget) -> Result[List[Node], ParseLimit] {
    let length = size(source)
    if length > limits.source_bytes {
        return Error(SourceBytes)
    }
    let nesting = if limits.nesting < MAX_NESTING {
        limits.nesting
    } else {
        MAX_NESTING
    }
    let mut budget = ParseState(work: limits.work_items, nesting)
    admit_nesting(budget, 1)?
    let maps = source_index(mut budget, source)?
    let p = parse_arena(source, dialect, take maps, mut budget)?
    let mut ids: List[u64] = list.new()
    let mut index: List[u64] = list.new()
    admit(mut budget, list.len(p.nodes))?
    list.fill(mut index, list.len(p.nodes), 0)
    let mut id = 0u64
    let mut depth = 1u64
    loop {
        admit_nesting(budget, depth)?
        admit(mut budget, 2)?
        index[id] = list.len(ids)
        list.push(mut ids, id)
        if p.nodes[id].first != 0 {
            id = p.nodes[id].first
            depth += 1
        } else {
            while id != 0 && p.nodes[id].next == 0 {
                id = p.nodes[id].parent
                depth -= 1
            }
            if id == 0 {
                break
            }
            id = p.nodes[id].next
        }
    }
    let mut nodes: List[Node] = list.new()
    let mut headings: List[(u64, u64, u64)] = list.new()
    for slot in 0u64 .. list.len(ids) {
        let node_id = ids[slot]
        let row = p.sources[node_id].row
        let extent = if node_id == 0 {
            Span(start: 0, end: length)
        } else {
            public_span(row.primary)
        }
        if p.nodes[node_id].kind == 2 {
            let level = p.nodes[node_id].number
            while list.len(headings) > 0 {
                let (previous, start, previous_level) = headings[list.len(headings) - 1]
                if previous_level < level {
                    break
                }
                let _ = list.pop(mut headings)
                nodes[previous].section = Some(Span(start, end: extent.start))
            }
            list.push(mut headings, (slot, extent.start, level))
        }
        list.push(mut nodes, Node(
            kind: entry_kind(p.nodes[node_id]),
            span: extent,
            section: None,
            target: optional_span(row.target),
            label: optional_span(row.label),
            first: index[p.nodes[node_id].first],
            next: index[p.nodes[node_id].next],
        ))
    }
    for (slot, start, _) in headings {
        nodes[slot].section = Some(Span(start, end: length))
    }
    Ok(take nodes)
}

fn alpha_numeric(b: u8) -> bool {
    int.is_ascii_alpha(b) || int.is_ascii_digit(b)
}

fn finish(take b: Bytes) -> String {
    match string.from_utf8(take b) {
        Ok(s) => take s,
        Error(_) => fail("invalid Markdown parser UTF-8"),
    }
}

fn append(mut out: Bytes, value: String) {
    list.append(mut out, string.as_bytes(value))
}

fn concat(a: String, b: String) -> String {
    let mut out = string.from(a)
    string.push(mut out, b)
    take out
}

fn contains(s: String, pat: String) -> bool {
    string.find(s, 0, pat) != None
}

fn find_any(s: Bytes, markers: Bytes, at: u64) -> u64 {
    let mut end = at
    while end < list.len(s) {
        for marker in markers {
            if s[end] == marker {
                return end
            }
        }
        end += 1
    }
    end
}

fn replace_newlines(s: String) -> String {
    let mut out: Bytes = list.new()
    for b in string.as_bytes(s) {
        list.push(mut out, if b == 10 {
            32u8
        } else {
            b
        })
    }
    finish(take out)
}

fn wiki_end(s: String, start: u64) -> Option[(u64, u64)] {
    let mut pipe = 0u64
    let mut at = start
    while at < size(s) {
        let c = byte(s, at)
        if c == b'[' || c == 10 {
            return None
        }
        if c == b']' {
            if at > start && pipe != start && byte(s, at + 1) == b']' {
                return Some((pipe, at))
            }
            return None
        }
        if pipe == 0 && c == b'|' {
            pipe = at
        }
        at += 1
    }
    None
}

fn lower_ascii(s: String) -> String {
    let mut out = string.from(s)
    string.make_ascii_lower(mut out)
    take out
}

fn fold_label(s: String) -> String {
    let mut out = string.new()
    let mut at = 0u64
    while let Some((c, next)) = string.next_scalar(s, at) {
        at = next
        let folded = special_fold(c)
        if folded == "" {
            string.push_lower(mut out, c)
        } else {
            string.push(mut out, folded)
        }
    }
    take out
}


// Go ebe2feefc400 readrequest_test.go:33, reqTests[0]; head only.
// Mutant: drop_head_field.
// expect: run go_head_00() = true
fn go_head_00() -> bool {
    let mut names: List[Bytes] = list.new()
    result.unwrap(list.push(mut names, result.unwrap(b"Host")))
    result.unwrap(list.push(mut names, result.unwrap(b"User-Agent")))
    result.unwrap(list.push(mut names, result.unwrap(b"Accept")))
    result.unwrap(list.push(mut names, result.unwrap(b"Accept-Language")))
    result.unwrap(list.push(mut names, result.unwrap(b"Accept-Encoding")))
    result.unwrap(list.push(mut names, result.unwrap(b"Accept-Charset")))
    result.unwrap(list.push(mut names, result.unwrap(b"Keep-Alive")))
    result.unwrap(list.push(mut names, result.unwrap(b"Content-Length")))
    result.unwrap(list.push(mut names, result.unwrap(b"Proxy-Connection")))
    let mut values: List[Bytes] = list.new()
    result.unwrap(list.push(mut values, result.unwrap(b"www.techcrunch.com")))
    result.unwrap(list.push(mut values, result.unwrap(b"Fake")))
    result.unwrap(list.push(mut values, result.unwrap(b"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8")))
    result.unwrap(list.push(mut values, result.unwrap(b"en-us,en;q=0.5")))
    result.unwrap(list.push(mut values, result.unwrap(b"gzip,deflate")))
    result.unwrap(list.push(mut values, result.unwrap(b"ISO-8859-1,utf-8;q=0.7,*;q=0.7")))
    result.unwrap(list.push(mut values, result.unwrap(b"300")))
    result.unwrap(list.push(mut values, result.unwrap(b"7")))
    result.unwrap(list.push(mut values, result.unwrap(b"keep-alive")))
    request_case(result.unwrap(b"GET http://www.techcrunch.com/ HTTP/1.1\r\nHost: www.techcrunch.com\r\nUser-Agent: Fake\r\nAccept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\nAccept-Language: en-us,en;q=0.5\r\nAccept-Encoding: gzip,deflate\r\nAccept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\r\nKeep-Alive: 300\r\nContent-Length: 7\r\nProxy-Connection: keep-alive\r\n\r\nabcdef\n???"), Complete, 338, Some(result.unwrap(b"GET")), Some(result.unwrap(b"http://www.techcrunch.com/")), Some(1), names, values)
}


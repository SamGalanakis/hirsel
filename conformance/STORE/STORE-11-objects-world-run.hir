// steps: 20000000
// Two clients of one bucket: authority.objects@1 grants whose objects.sim@1
// entries name the same `world` share its objects, its request count and its
// cut script, and each grant is its own client, which crashes and restarts
// alone. Requests are numbered across both clients in the order they reach the
// world. Client a writes, then client b opens the store, which takes it over.
// - `oa`, `ob`: b reads what a committed, a is fenced once b has taken over, and
//   b reads its own commit.
// - `cKa`, `cKb`: the client sending request K crashes right after it. b then
//   reads x as some commit j of a, whole: at least the last a acknowledged, at
//   most the last a attempted (absent when a acknowledged none).
// - `dKa`, `dKb`: request K is held back and takes effect just before request
//   K + 9, which may be one of b's. `lKxMa`, `lKxMb`: a's head replace K (3, 8,
//   10 or 12 when nothing is held) is held back until just before request M, so
//   it can arrive after b's own replace, as a lost conditional replace does; its
//   tag is stale by then, so it must not apply: the run answers exactly as the
//   fault-free script does (a commits 1 and 2, b commits 9 and reads it back).
// - `t1a`, `t1b` and `t2a`, `t2b`: two worlds with the same script; the same
//   program over each gives the same answers.
fn put_x(mut tx: store.Tx, info: store.CallInfo, n: u8) -> Result[(), store.TxError] {
  store.tx_put(mut tx, b"x", bytes.from_list([n]))
}

pub type Failed = Check | Wrong(String)

fn check(ok: bool, take what: String) -> Result[(), Failed] {
  if ok {
    Ok(())
  } else {
    Error(Wrong(what))
  }
}

fn granted(rt: Io, name: String) -> Result[Authority, Failed] {
  let Ok(a) = io.authority(rt, name) else {
    return Error(Check())
  }
  Ok(a)
}

// Commits x = n; true when the commit is acknowledged (the one level is the
// floor).
fn write(mut s: store.Store, n: u8) -> bool {
  let done: Result[(), store.TxFailure[store.TxError]] = store.transact(mut s, put_x, n)
  done == Ok(())
}

// x as the store over `a` holds it after `a` opens it: None when the open or
// the read is refused.
fn reopened(a: Authority) -> Option[Option[Bytes]] {
  let Ok(opened) = store.open(a, store.default_config()) else {
    return None()
  }
  let mut s = take opened
  let got = match store.snapshot(a, mut s, authority.floor(a)) {
    Ok(snap) => Some(store.get(snap, b"x")),
    Error(_) => None(),
  }
  let _ = store.close(take s)
  got
}

fn x(n: u8) -> Option[Bytes] {
  if n == 0 {
    None()
  } else {
    Some(bytes.from_list([n]))
  }
}

// A reopen's answer as text.
fn shown(got: Option[Option[Bytes]]) -> String {
  if got == None() {
    return "refused"
  }
  for n in [0u8, 1u8, 2u8, 9u8] {
    if got == Some(x(n)) {
      return f"x={n}"
    }
  }
  "another x"
}

fn observed(rt: Io) -> Result[(), Failed] {
  let a = granted(rt, "oa")?
  let b = granted(rt, "ob")?
  let Ok(opened) = store.open(a, store.default_config()) else {
    return Error(Wrong("a cannot open"))
  }
  let mut s = take opened
  check(write(mut s, 1), "a commits 1")?
  let Ok(taken) = store.open(b, store.default_config()) else {
    return Error(Wrong("b cannot open"))
  }
  let mut t = take taken
  let Ok(snap) = store.snapshot(b, mut t, authority.floor(b)) else {
    return Error(Wrong("b cannot read"))
  }
  check(store.get(snap, b"x") == x(1), "b reads a's commit")?
  check(write(mut t, 2), "b commits 2")?
  check(!write(mut s, 3), "a commits after b took over")?
  let _ = store.close(take s)
  let _ = store.close(take t)
  check(reopened(b) == Some(x(2)), "b reads its own commit")
}

// a commits 1, 2 and 3, stopping at the first that is not acknowledged; then
// b reads. 1 when b read.
fn cut(rt: Io, k: u64) -> Result[u64, Failed] {
  let a = granted(rt, f"c{k}a")?
  let b = granted(rt, f"c{k}b")?
  let mut acked: u8 = 0
  let mut tried: u8 = 0
  if let Ok(opened) = store.open(a, store.default_config()) {
    let mut s = take opened
    for n in [1u8, 2u8, 3u8] {
      tried = n
      if !write(mut s, n) {
        break
      }
      acked = n
    }
    let _ = store.close(take s)
  }
  let Some(got) = reopened(b) else {
    return Ok(0)
  }
  let mut fits = false
  for n in [0u8, 1u8, 2u8, 3u8] {
    if acked <= n && n <= tried && got == x(n) {
      fits = true
    }
  }
  check(
    fits,
    f"c{k}: b reads a state between a's acknowledged {acked} and attempted {tried}"
  )?
  Ok(1)
}

// a commits 1 and 2; b takes over and commits 9, then reopens. What each step
// answered, as text, and 1 when b committed.
fn delayed(rt: Io, name: String) -> Result[(String, u64), Failed] {
  let a = granted(rt, f"{name}a")?
  let b = granted(rt, f"{name}b")?
  let mut said = ""
  if let Ok(opened) = store.open(a, store.default_config()) {
    let mut s = take opened
    said = f"{said} a1 {write(mut s, 1)} a2 {write(mut s, 2)}"
    let _ = store.close(take s)
  }
  let Ok(taken) = store.open(b, store.default_config()) else {
    return Ok((f"{said} b refused", 0))
  }
  let mut t = take taken
  let mine = write(mut t, 9)
  let _ = store.close(take t)
  let again = reopened(b)
  said = f"{said} b9 {mine} then {shown(copy again)}"
  if !mine {
    return Ok((said, 0))
  }
  match again {
    Some(got) => {
      check(got == x(9), f"{name}: a late write of a overrode b's 9:{said}")?
      Ok((said, 1))
    },
    None() => Ok((said, 0)),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), Failed] {
  observed(rt)?
  let mut read: u64 = 0
  for k in 1u64..30 + 1 {
    read += cut(rt, k)?
  }
  let mut committed: u64 = 0
  for k in 1u64..30 + 1 {
    let (_, n) = delayed(rt, f"d{k}")?
    committed += n
  }
  for name in [
    "l3x24",
    "l3x28",
    "l3x32",
    "l3x36",
    "l3x40",
    "l8x24",
    "l8x28",
    "l8x32",
    "l8x36",
    "l8x40",
    "l10x24",
    "l10x28",
    "l10x32",
    "l10x36",
    "l10x40",
    "l12x24",
    "l12x28",
    "l12x32",
    "l12x36",
    "l12x40"
  ] {
    let (said, n) = delayed(rt, name)?
    check(
      said == " a1 true a2 true b9 true then x=9",
      f"{name}: a's stale replace changed the outcome:{said}"
    )?
    committed += n
  }
  let (first, _) = delayed(rt, "t1")?
  let (second, _) = delayed(rt, "t2")?
  check(first == second, f"two worlds of one script:{first} /{second}")?
  check(read > 0 && committed > 0, "every run refused")
}

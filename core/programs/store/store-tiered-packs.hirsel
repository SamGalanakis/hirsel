type TieredPackDraft {
    context: format.DiskContext,
    class: u8,
    cap: u64,
    raw: Bytes,
    rows: List[manifest.PackIndexRow],
    planned_bytes: u64,
    index_room: u64,
    live: u64
}

pub fn tiered_page_index_key(collection: u32, image: std.page.Image) -> Result[Bytes, types.Failure] {
    let slot = if std.page.level(image) == 0 {
        0u64
    } else {
        1u64
    }
    if let Some(suffix) = std.page.key_at(image, slot) {
        return catalog.logical_key(collection, suffix)
    }
    catalog.prefix(collection)
}

pub fn begin_tiered_pack(owner: types.StoreKey, seq: u64, class: u8, cap: u64) -> Result[TieredPackDraft, types.Failure] {
    let context = format.DiskContext(store: owner, role: 3, seq: seq)
    let raw = manifest.disk_allocation(scoped fn() -> Result[Bytes, types.Failure] {
        types.capacity(format.disk_header_bytes(context, 0, 0))
    })?
    let header_bytes = list.len(raw)
    Ok(TieredPackDraft(context: context, class: class, cap: cap, raw: take raw, rows: list.new(), planned_bytes: header_bytes, index_room: 0, live: 0))
}

fn tiered_frame_extent(bytes_written: u64, index_room: u64, size: u64, key_size: u64) -> Result[(u64, u64), types.Failure] {
    let row_width = manifest.PACK_INDEX_ROW + key_size
    if row_width > format.PACK_INDEX_LIMIT - manifest.PACK_INDEX_PREFIX {
        return Error(Limit(Key))
    }
    let starts_index = index_room == 0 || row_width > format.PACK_INDEX_LIMIT - index_room
    if starts_index {
        return Ok((bytes_written + 16 + size + 16 + manifest.PACK_INDEX_PREFIX + row_width, manifest.PACK_INDEX_PREFIX + row_width))
    }
    Ok((bytes_written + 16 + size + row_width, index_room + row_width))
}

pub fn add_tiered_pack_frame(mut draft: TieredPackDraft, frame: manifest.PackFrame, collection: u32, key: Bytes, locate: scoped[view] fn(u64) -> std.page.PagePtr) -> Result[Option[std.page.PagePtr], types.Failure] {
    let (class, kind): (u8, u8) = match frame.body {
        PageBody(_) => (3, 0x21),
        BlobBody(_) => (4, 0x22),
    }
    if draft.class != class {
        fail("store: attempted to mix Tiered pack classes")
    }
    let (next_size, next_index_room) = tiered_frame_extent(draft.planned_bytes, draft.index_room, frame.size, list.len(key))?
    if list.len(draft.rows) != 0 && (next_size > draft.cap || list.len(draft.rows) == 4294967295) {
        return Ok(None)
    }
    let logical = types.copied(key)?
    types.capacity(list.try_reserve(mut draft.rows, 1))?
    types.capacity(list.try_reserve(mut draft.raw, 16 + frame.size))?
    let offset = list.len(draft.raw)
    let encoded = manifest.emit_located_frame(mut draft.raw, draft.context, frame, locate)
    let place = match take encoded {
        Ok(ptr) => ptr,
        Error(take problem) => {
            list.truncate(mut draft.raw, offset)
            return Error(take problem)
        },
    }
    list.push(mut draft.rows, manifest.PackIndexRow(offset: place.offset, len: place.len, kind: kind, collection: collection, stamp: place.stamp, key: take logical))
    draft.planned_bytes = next_size
    draft.index_room = next_index_room
    draft.live += frame.size
    Ok(Some(place))
}

pub fn finish_tiered_pack(take draft: TieredPackDraft) -> Result[(Bytes, pages.PagePack), types.Failure] {
    let TieredPackDraft(context, class, raw: take bytes_out, rows: take rows, live: live_bytes, ..) = take draft
    if list.len(rows) == 0 {
        fail("store: attempted to seal an empty Tiered pack")
    }
    let mut raw = take bytes_out
    let index_offset = manifest.append_pack_index(mut raw, context, rows)?
    let pack = pages.PagePack(foreign: None, class: class, frames: int.truncate(list.len(rows)), live: live_bytes, payload_bytes: list.len(raw), index: index_offset)
    Ok((take raw, pack))
}

// Each op-4 introduction owns a whole immutable. Its index stores the
// collection-prefixed chunk key used in the COMMIT.
pub fn seal_direct_chunk(id: types.StoreKey, seq: u64, stamp: u64, epoch: u64, authority: u8, key: Bytes, body: Arc[Bytes]) -> Result[(format.DirectBlob, TieredCutPack), types.Failure] {
    if seq == 0 || stamp == 0 || !format.direct_chunk_key(key) || list.len(body) <= 6 || list.len(body) > types.FORMAT_VALUE_MAX {
        return Error(format.disk_fault("direct BLOB", 0, Malformed))
    }
    let mut draft = begin_tiered_pack(id, seq, 4, 0)?
    if epoch != 0 {
        list.clear(mut draft.raw)
        types.capacity(format.history_append_header(mut draft.raw, draft.context, epoch, authority))?
    }
    let frame = manifest.PackFrame(stamp: stamp, size: 8 + list.len(body), body: BlobBody(arc.share(body)))
    let collection: u32 = list.word_be(key, 0)
    let Some(ptr) = add_tiered_pack_frame(mut draft, frame, collection, key, fn(_stamp: u64) -> std.page.PagePtr {
        fail("store: a BLOB has no child locations")
    })? else {
        fail("store: a fresh pack accepts its first frame")
    }
    let (take wire, pack) = finish_tiered_pack(take draft)?
    let place = format.DirectBlob(stamp: stamp, len: list.len(body), checksum: ptr.checksum, pack: seq, offset: ptr.offset, epoch: epoch, pack_len: list.len(wire), digest: std.check.xxh3(wire, 0, list.len(wire)))
    Ok((place, TieredCutPack(seq: seq, wire: take wire, pack: pack)))
}

fn chrome() -> Bytes {
    // hb1 in str0m 2ada76a, src/rtp/header.rs.
    b"\xb0\x6f\xb7\x98\x00\x00\x27\x10\x2e\x57\x15\xf9\xbe\xde\x00\x04\x10\xaa\x22\xfe\x20\x6a\x31\x00\x00\x42xYj\x00\x00\x00\x01\x02\x03\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0c"
}

fn fields() -> header.Fields {
    header.Fields(marker: true, pt: 96, seq: 0x1234, ts: 3000, ssrc: 0xbeef)
}

fn found(m: ext.ExtMap, pkt: Bytes, h: header.Header, k: ext.Kind) -> ext.Element {
    let Some(e) = result.unwrap(ext.find(m, pkt, h, k)) else {
        fail("negotiated extension missing")
    }
    e
}

/// bug: Decode the Chrome packet's fixed fields, payload offset or mapped extensions incorrectly.
/// oracle: str0m 2ada76a, src/rtp/header.rs, hb1 and its expected header.
@test
fn header_chrome_vector() -> Result[(), ()] {
    let pkt = chrome()
    let h = result.unwrap(header.parse(pkt))
    if h.marker || h.pt != 111 || h.seq != 47000 || h.ts != 10000 || h.ssrc != 777459193 || h.csrcs != 0 || !h.padded || h.end != 32 || h.len != 48 {
        fail("Chrome fixed header")
    }
    let OneByte(at: at, len: len) = h.block else {
        fail("Chrome extension profile")
    }
    if at != 16 || len != 16 {
        fail("Chrome extension extent")
    }
    let (start, size) = result.unwrap(header.payload(h, pkt))
    if start != 32 || size != 4 || list.slice(pkt, start, start + size) != b"\x01\x02\x03\x04" {
        fail("Chrome payload and padding")
    }
    let mut m = ext.map(Mixed)
    result.unwrap(ext.bind(mut m, 1, AudioLevel))
    result.unwrap(ext.bind(mut m, 2, AbsSendTime))
    result.unwrap(ext.bind(mut m, 3, TransportSeq))
    result.unwrap(ext.bind(mut m, 4, Mid))
    ext.vad(mut m, true)
    let level = result.unwrap(ext.audio_level(m, pkt, h, found(m, pkt, h, AudioLevel)))
    let abs = result.unwrap(ext.abs_send_time(pkt, h, found(m, pkt, h, AbsSendTime)))
    let seq = result.unwrap(ext.transport_seq(pkt, h, found(m, pkt, h, TransportSeq)))
    let mid = result.unwrap(ext.token(pkt, h, Mid, found(m, pkt, h, Mid)))
    if level != (Some(true), 42u8) || abs != 0xfe206a || seq != 0 || mid.at != 26 || mid.len != 3 || list.slice(pkt, 26, 29) != b"xYj" {
        fail("Chrome extension values")
    }
    Ok(())
}

fn expect_padding(pkt: Bytes) {
    let h = result.unwrap(header.parse(pkt))
    let Error(Padding) = header.payload(h, pkt) else {
        fail("invalid padding accepted")
    }
}

/// bug: Read a missing pad count, admit zero or oversized counts, or refuse a padding-only packet.
/// oracle: RFC 3550 section 5.1.
@test
fn padding_counts() -> Result[(), ()] {
    let bare = b"\xa0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    expect_padding(bare)
    expect_padding(b"\xa0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
    expect_padding(b"\xa0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02")
    let padded = b"\xa0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01"
    if result.unwrap(header.payload(result.unwrap(header.parse(padded)), padded)) != (12u64, 0u64) {
        fail("padding-only payload")
    }
    Ok(())
}

fn stopped(pkt: Bytes) {
    let h = result.unwrap(header.parse(pkt))
    let mut at = 0u64
    let Ok(None) = ext.next(pkt, h, mut at) else {
        fail("reserved ID did not end the walk")
    }
    let Ok(None) = ext.next(pkt, h, mut at) else {
        fail("reserved ID stop was not terminal")
    }
    if at != 4 {
        fail("terminal cursor did not reach the block end")
    }
}

/// bug: Misread extension lengths or accept a reserved one-byte ID or an invalid token.
/// oracle: RFC 8285 sections 4.2, 4.3 and 6, RFC 8852 section 3, RFC 9143 section 15 and RFC 6464 sections 3 and 4.
@test
fn extension_forms() -> Result[(), ()] {
    let pkt = b"\x90\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x06\x00\x07\x00\x14\x11abcdefghijklmnopq\x08\x01"
    let h = result.unwrap(header.parse(pkt))
    let mut at = 0u64
    let Some(zero) = result.unwrap(ext.next(pkt, h, mut at)) else {
        fail("zero-length two-byte element missing")
    }
    if zero.id != 7 || zero.at != 19 || zero.len != 0 || at != 3 {
        fail("zero-length element range or cursor")
    }
    let Some(long) = result.unwrap(ext.next(pkt, h, mut at)) else {
        fail("17-byte RID missing")
    }
    let rid = result.unwrap(ext.token(pkt, h, Rid, long))
    if rid.id != 20 || rid.at != 21 || rid.len != 17 || at != 22 {
        fail("two-byte RID range or cursor")
    }
    let Error(Overrun) = ext.next(pkt, h, mut at) else {
        fail("extension overrun accepted")
    }
    if at != 22 {
        fail("overrun advanced the cursor")
    }
    stopped(b"\x90\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xbe\xde\x00\x01\xf0\x10a\x00")
    stopped(b"\x90\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xbe\xde\x00\x01\x03\x10a\x00")
    let mut one = ext.map(OneOnly)
    let Error(BadId) = ext.bind(mut one, 16, Mid) else {
        fail("OneOnly map accepted ID 16")
    }
    let mut mixed = ext.map(Mixed)
    result.unwrap(ext.bind(mut mixed, 16, Mid))
    let values = b"\x90\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\x0f\x00\x05\x10\x07audio-1\x01\x03a_b\x02\x01\xaa\x00\x00\x00"
    let vh = result.unwrap(header.parse(values))
    let mid = found(mixed, values, vh, Mid)
    if result.unwrap(ext.token(values, vh, Mid, mid)).len != 7 {
        fail("MID token rejected")
    }
    let Error(Value(Rid)) = ext.token(values, vh, Rid, ext.Element(id: 1, at: 27, len: 3)) else {
        fail("RID containing underscore accepted")
    }
    let e = ext.Element(id: 2, at: 32, len: 1)
    ext.vad(mut mixed, true)
    if result.unwrap(ext.audio_level(mixed, values, vh, e)) != (Some(true), 42u8) {
        fail("audio level with VAD")
    }
    ext.vad(mut mixed, false)
    if result.unwrap(ext.audio_level(mixed, values, vh, e)) != (None, 42u8) {
        fail("audio level without VAD")
    }
    let Error(Value(AudioLevel)) = ext.audio_level(mixed, values, vh, ext.Element(id: 2, at: 32, len: 2)) else {
        fail("two-byte audio level accepted")
    }
    Ok(())
}

fn egress_map(form: ext.Form, voice: bool) -> ext.ExtMap {
    let mut m = ext.map(form)
    result.unwrap(ext.bind(mut m, 1, AudioLevel))
    result.unwrap(ext.bind(mut m, 2, TransportSeq))
    result.unwrap(ext.bind(mut m, 3, Rid))
    ext.vad(mut m, voice)
    m
}

fn short_values(m: ext.ExtMap) -> ext.ExtWriter {
    let mut w = ext.writer()
    result.unwrap(ext.put_level(mut w, m, true, 42))
    result.unwrap(ext.put(mut w, m, TransportSeq, b"\x00\x12\x34", 1, 2))
    w
}

fn check_egress(w: View[ext.ExtWriter], expected: Bytes) {
    let mut out: Bytes = list.with_capacity(64)
    if result.unwrap(header.write(fields(), w, mut out)) != list.len(expected) || out != expected {
        fail("egress wire bytes")
    }
    let h = result.unwrap(header.parse(out))
    if !h.marker || h.pt != 96 || h.seq != 0x1234 || h.ts != 3000 || h.ssrc != 0xbeef || h.padded || h.csrcs != 0 || h.end != list.len(expected) {
        fail("egress fixed header")
    }
}

/// bug: Choose the wrong negotiated form, write incorrect extension bytes, or append on refusal.
/// oracle: RFC 8285 sections 4.2 and 4.3 and RFC 6464 section 3. Two-byte long payload is 3 + 4 + 19 = 26 bytes, rounded to 28.
@test
fn egress_form() -> Result[(), ()] {
    let mixed = egress_map(Mixed, true)
    let mut w = short_values(mixed)
    check_egress(view w, b"\x90\xe0\x12\x34\x00\x00\x0b\xb8\x00\x00\xbe\xef\xbe\xde\x00\x02\x10\xaa\x21\x12\x34\x00\x00\x00")
    let rid = b"abcdefghijklmnopq"
    result.unwrap(ext.put(mut w, mixed, Rid, rid, 0, 17))
    check_egress(view w, b"\x90\xe0\x12\x34\x00\x00\x0b\xb8\x00\x00\xbe\xef\x10\x00\x00\x07\x01\x01\xaa\x02\x02\x12\x34\x03\x11abcdefghijklmnopq\x00\x00")
    let two = short_values(egress_map(TwoOnly, true))
    check_egress(view two, b"\x90\xe0\x12\x34\x00\x00\x0b\xb8\x00\x00\xbe\xef\x10\x00\x00\x02\x01\x01\xaa\x02\x02\x12\x34\x00")
    let one = egress_map(OneOnly, false)
    let mut short = short_values(one)
    check_egress(view short, b"\x90\xe0\x12\x34\x00\x00\x0b\xb8\x00\x00\xbe\xef\xbe\xde\x00\x02\x10\x2a\x21\x12\x34\x00\x00\x00")
    let mut out: Bytes = list.with_capacity(16)
    list.push(mut out, 0xff)
    let Error(Capacity(c)) = header.write(fields(), view short, mut out) else {
        fail("header written without spare")
    }
    if c.requested != 24 || c.available != list.capacity(out) - 1 || out != b"\xff" {
        fail("capacity refusal was not atomic")
    }
    result.unwrap(ext.put(mut short, one, Rid, rid, 0, 17))
    let Error(Form) = header.write(fields(), view short, mut out) else {
        fail("OneOnly writer accepted a 17-byte value")
    }
    if out != b"\xff" {
        fail("form refusal was not atomic")
    }
    let empty = ext.writer()
    check_egress(view empty, b"\x80\xe0\x12\x34\x00\x00\x0b\xb8\x00\x00\xbe\xef")
    let mut other = ext.writer()
    result.unwrap(ext.put_other(mut other, mixed, 7, b"", 0, 0))
    check_egress(view other, b"\x90\xe0\x12\x34\x00\x00\x0b\xb8\x00\x00\xbe\xef\x10\x00\x00\x01\x07\x00\x00\x00")
    Ok(())
}

fn expect_index(highest: u64, wire: u16, expected: u64) {
    let Index(i) = seq.estimate(highest, wire) else {
        fail("expected an index in the SRTP range")
    }
    if i != expected {
        fail("wrong sequence cycle")
    }
}

/// bug: Choose the wrong rollover counter at a wrap or a tie, or wrap the 48-bit index.
/// oracle: RFC 3711 Appendix A. ROC stays at 1 for differences of exactly 32768 in either direction.
@test
fn index_estimate() -> Result[(), ()] {
    expect_index(65535, 0, 65536)
    expect_index(65536, 65535, 65535)
    expect_index(65636, 32868, 98404)
    expect_index(65636, 32869, 32869)
    expect_index(105536, 7232, 72768)
    expect_index(105536, 7231, 138303)
    expect_index(65536, 40000, 40000)
    let Before = seq.estimate(0, 65535) else {
        fail("index below zero accepted")
    }
    let Beyond = seq.estimate(281474976710655, 0) else {
        fail("index above the SRTP limit accepted")
    }
    if seq.estimate32(0, 0xffffffff) != -1 || seq.estimate32(-1, 0) != 0 || seq.estimate24(16777215, 0) != 16777216 || seq.estimate24(0, 0xffffff) != -1 {
        fail("signed timestamp or TWCC rollover")
    }
    Ok(())
}

/// bug: Use the wrong packet's view or read past a truncated header, CSRC list, extension element, RTCP report block, FCI entry or RTX payload.
/// oracle: RFC 3550 sections 5.1, 6.1 and 6.4, RFC 5761 section 4 and RFC 8285 sections 4.2 and 4.3. Chrome's complete header takes 32 bytes; an RTX payload range comes from header.payload, which checks the buffer first.
@test
fn bounded_views() -> Result[(), ()] {
    let raw = chrome()
    let mut n = 0u64
    while n < 48 {
        match header.parse(list.slice(raw, 0, n)) {
            Error(Short) if n < 12 => {},
            Error(Extension) if n >= 12 && n < 32 => {},
            Ok(h) if n >= 32 && h.end == 32 && h.len == n => {},
            _ => fail("wrong result on Chrome packet prefix"),
        }
        n += 1
    }
    let csrcs = b"\x82\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08"
    let ch = result.unwrap(header.parse(csrcs))
    if result.unwrap(header.csrc(ch, csrcs, 1)) != 0x05060708 {
        fail("second CSRC")
    }
    let Error(Index) = header.csrc(ch, csrcs, 2) else {
        fail("CSRC index outside the view accepted")
    }
    let Error(Csrc) = header.parse(list.slice(csrcs, 0, 19)) else {
        fail("truncated CSRC list accepted")
    }
    let Error(Version) = header.parse(b"\x7f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00") else {
        fail("version was checked after the CSRC count")
    }
    let h = result.unwrap(header.parse(raw))
    let short = list.slice(raw, 0, 47)
    let mut at = 0u64
    let mut m = ext.map(Mixed)
    let e = ext.Element(id: 1, at: 17, len: 1)
    let Error(Buffer) = header.payload(h, short) else {
        fail("payload accepted a mismatched buffer")
    }
    let Error(Buffer) = header.csrc(h, short, 0) else {
        fail("CSRC accepted a mismatched buffer")
    }
    let Error(Buffer) = ext.next(short, h, mut at) else {
        fail("extension walk accepted a mismatched buffer")
    }
    let Error(Buffer) = ext.find(m, short, h, Mid) else {
        fail("extension lookup accepted a mismatched buffer")
    }
    let Error(Buffer) = ext.audio_level(m, short, h, e) else {
        fail("audio level accepted a mismatched buffer")
    }
    let Error(Buffer) = ext.abs_send_time(short, h, e) else {
        fail("abs-send-time accepted a mismatched buffer")
    }
    let Error(Buffer) = ext.transport_seq(short, h, e) else {
        fail("transport sequence accepted a mismatched buffer")
    }
    let Error(Buffer) = ext.token(short, h, Mid, e) else {
        fail("token accepted a mismatched buffer")
    }
    if at != 0 {
        fail("buffer refusal advanced the cursor")
    }
    let last_id = b"\x90\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x01\x00\x00\x00\x01"
    let Error(Overrun) = ext.next(last_id, result.unwrap(header.parse(last_id)), mut at) else {
        fail("two-byte ID accepted without its length byte")
    }
    if at != 0 {
        fail("trailing ID refusal advanced the cursor")
    }
    let overrun = b"\x90\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xbe\xde\x00\x01\x10a\x2f\x00"
    result.unwrap(ext.bind(mut m, 1, Mid))
    let Error(Overrun) = ext.find(m, overrun, result.unwrap(header.parse(overrun)), Mid) else {
        fail("lookup stopped before the overrun")
    }
    let Error(Value(TransportSeq)) = ext.transport_seq(raw, h, ext.Element(id: 3, at: 31, len: 2)) else {
        fail("value reader crossed into payload")
    }
    let opaque_packet = b"\x90\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x20\x00\x00\x01\x10a\x00\x00"
    let oh = result.unwrap(header.parse(opaque_packet))
    let Opaque(profile: 0x2000, at: 16, len: 4) = oh.block else {
        fail("opaque profile was not preserved")
    }
    let Ok(None) = ext.next(opaque_packet, oh, mut at) else {
        fail("read an element from an opaque profile")
    }
    if at != 4 {
        fail("opaque block did not leave a terminal cursor")
    }
    let Error(Buffer) = rtx.unwrap(h, short) else {
        fail("RTX unwrap accepted a mismatched buffer")
    }
    rtcp_views()
    Ok(())
}

fn expect_lookup(mut h: history.History[u64], index: u64, now: u64, expected: history.Lookup) {
    let got = history.get(mut h, index, now, 50)
    let same = match (got, expected) {
        (Found(a), Found(b)) => a == b,
        (Missing, Missing) => true,
        (Throttled, Throttled) => true,
        (BeforeSwitch, BeforeSwitch) => true,
        _ => false,
    }
    if !same {
        fail("wrong history lookup")
    }
}

/// bug: Answer a NACK from an overwritten, aged, gated or just-resent slot, or alias two indices with one low 16 bits.
/// oracle: RTP-7, by hand. Four slots: index i lives in slot i mod 4, so 5 overwrote 1 and 6 overwrote 2; 65,537 mod 4 = 1 mod 4 and 65,537 mod 2^16 = 1.
@test
fn history_lookup() -> Result[(), ()] {
    let mut h: history.History[u64] = result.unwrap(history.history(4, 1000))
    let mut i = 1u64
    while i <= 4 {
        if let Some(_) = history.put(mut h, i, i * 10, i * 100) {
            fail("an empty slot answered a replaced value")
        }
        i += 1
    }
    let Some(100) = history.put(mut h, 5, 50, 500) else {
        fail("put did not answer the value it replaced")
    }
    let Some(200) = history.put(mut h, 6, 60, 600) else {
        fail("put did not answer the value it replaced")
    }
    expect_lookup(mut h, 2, 100, Missing)
    expect_lookup(mut h, 5, 100, Found(5))
    expect_lookup(mut h, 5, 120, Throttled)
    if option.copied(history.entry(h, 5)) != Some(500u64) {
        fail("entry answered another slot's value")
    }
    // Index 5 was sent at 50 ns; at 1051 ns it is 1001 ns old, past max_age 1000.
    expect_lookup(mut h, 5, 1051, Missing)
    expect_lookup(mut h, 6, 200, Found(6))
    history.gate(mut h, 6)
    expect_lookup(mut h, 5, 300, BeforeSwitch)
    if history.clear(mut h) != 4 {
        fail("clear count")
    }
    expect_lookup(mut h, 6, 400, Missing)
    let mut fresh: history.History[u64] = result.unwrap(history.history(4, 1000))
    history.put(mut fresh, 1, 0, 1)
    history.put(mut fresh, 65537, 0, 65537)
    expect_lookup(mut fresh, 1, 10, Missing)
    if let Some(_) = history.entry(fresh, 1) {
        fail("entry answered an index the slot no longer holds")
    }
    let none: Result[history.History[u64], Capacity] = history.history(0, 1000)
    let Error(_) = none else {
        fail("history of 0 slots")
    }
    let over: Result[history.History[u64], Capacity] = history.history(32769, 1000)
    let Error(_) = over else {
        fail("history of 2^15 + 1 slots")
    }
    Ok(())
}

// One sent packet, as a leg's egress history keeps it: enough to reproduce
// that leg's exact media payload.
type Sent {
    generation: u64,
    ts: u32,
    marker: bool,
    pre: Bytes,
    from: u64,
    len: u64
}

type Leg {
    map: ext.ExtMap,
    mid: Bytes,
    pt: u8,
    ssrc: u32,
    rtx_pt: u8,
    rtx_ssrc: u32,
    rtx_seq: u16,
    transport: u16,
    highest: u64,
    sent: history.History[Sent]
}

fn leg(mid_id: u8, take mid: Bytes, transport_id: u8, pt: u8, ssrc: u32, rtx_pt: u8, rtx_ssrc: u32, rtx_seq: u16, transport: u16) -> Leg {
    let mut m = ext.map(Mixed)
    result.unwrap(ext.bind(mut m, mid_id, Mid))
    result.unwrap(ext.bind(mut m, transport_id, TransportSeq))
    Leg(map: m, mid: mid, pt: pt, ssrc: ssrc, rtx_pt: rtx_pt, rtx_ssrc: rtx_ssrc, rtx_seq: rtx_seq, transport: transport, highest: 0, sent: result.unwrap(history.history(64, 1000000000)))
}

// The leg's own extensions, with a fresh transport number for this send.
fn leg_exts(mut l: Leg) -> ext.ExtWriter {
    let mut w = ext.writer()
    result.unwrap(ext.put(mut w, l.map, Mid, l.mid, 0, list.len(l.mid)))
    let mut t: Bytes = list.with_capacity(2)
    list.put_word_be(mut t, l.transport)
    l.transport += 1
    result.unwrap(ext.put(mut w, l.map, TransportSeq, t, 0, 2))
    w
}

fn send(mut l: Leg, index: u64, take s: Sent, src: Bytes) -> Bytes {
    let w = leg_exts(mut l)
    let mut out: Bytes = list.with_capacity(64)
    let seq: u16 = int.truncate(index)
    result.unwrap(header.write(header.Fields(marker: s.marker, pt: l.pt, seq: seq, ts: s.ts, ssrc: l.ssrc), view w, mut out))
    for b in s.pre {
        list.push(mut out, b)
    }
    for b in list.slice(src, s.from, s.from + s.len) {
        list.push(mut out, b)
    }
    l.highest = index
    history.put(mut l.sent, index, 1000000, take s)
    out
}

fn repair(mut l: Leg, wire: u16, src: Bytes) -> Result[(Bytes, u64), history.Lookup] {
    let Index(index) = seq.estimate(l.highest, wire) else {
        fail("NACK outside the index domain")
    }
    let i = match history.get(mut l.sent, index, 2000000, 10000000) {
        Found(i) => i,
        other => return Error(other),
    }
    let w = leg_exts(mut l)
    let Some(s) = history.entry(l.sent, i) else {
        fail("found index without an entry")
    }
    let mut out: Bytes = list.with_capacity(64)
    let osn: u16 = int.truncate(i)
    let head = result.unwrap(rtx.write(header.Fields(marker: s.marker, pt: l.rtx_pt, seq: l.rtx_seq, ts: s.ts, ssrc: l.rtx_ssrc), view w, osn, s.pre, src, s.from, s.len, mut out))
    l.rtx_seq += 1
    Ok((out, head))
}

/// bug: Put the OSN in the header, repair with the publisher's or another leg's identity, descriptor or transport number, or read padding as a repair.
/// oracle: RFC 4588 section 4 and RFC 8852 section 3, by hand. 0x80 | 97 = 0xE1, 0x80 | 101 = 0xE5; 3000 = 0x0BB8, 9000 = 0x2328, 500 = 0x01F4. One-byte elements: MID "0" at id 1 is 10 30, "v-1" at id 2 is 22 76 2D 31, transport-seq at id 3 is 31 hi lo and at id 5 is 51 hi lo, padded to 8 bytes. VP8 picture IDs 0x1234 and 0x0042 with M set: 90 80 92 34 and 90 80 80 42.
@test
fn rtx_layout() -> Result[(), ()] {
    let mut out: Bytes = list.with_capacity(32)
    let empty = ext.writer()
    let f = header.Fields(marker: true, pt: 97, seq: 5, ts: 3000, ssrc: 0xbeef)
    if result.unwrap(rtx.write(f, view empty, 0x1234, b"", b"\x00\xaa\xbb\xcc\x00", 1, 3, mut out)) != 12 || out != b"\x80\xe1\x00\x05\x00\x00\x0b\xb8\x00\x00\xbe\xef\x12\x34\xaa\xbb\xcc" {
        fail("RTX plaintext layout")
    }
    let Repair(0x1234, 14) = result.unwrap(rtx.unwrap(result.unwrap(header.parse(out)), out)) else {
        fail("RTX repair read back")
    }
    let mut probe: Bytes = list.with_capacity(32)
    if result.unwrap(rtx.write_probe(header.Fields(marker: false, pt: 97, seq: 6, ts: 3000, ssrc: 0xbeef), view empty, 4, mut probe)) != 12 || probe != b"\xa0\x61\x00\x06\x00\x00\x0b\xb8\x00\x00\xbe\xef\x00\x00\x00\x04" {
        fail("padding-only probe layout")
    }
    let Probe = result.unwrap(rtx.unwrap(result.unwrap(header.parse(probe)), probe)) else {
        fail("padding-only RTX read as a repair")
    }
    let one = b"\x80\x61\x00\x07\x00\x00\x0b\xb8\x00\x00\xbe\xef\x12"
    let Error(Padding) = rtx.unwrap(result.unwrap(header.parse(one)), one) else {
        fail("1-byte RTX payload accepted")
    }
    // The publisher's packet: its own VP8 descriptor, then the shared remainder.
    let src = b"\x90\x80\x81\x00\xaa\xbb\xcc"
    let mut one_leg = leg(1, b"0", 3, 96, 0x1111, 97, 0x2222, 0x10, 7)
    let mut two_leg = leg(2, b"v-1", 5, 100, 0x3333, 101, 0x4444, 0x200, 40)
    let media_one = send(mut one_leg, 100, Sent(generation: 1, ts: 3000, marker: true, pre: b"\x90\x80\x92\x34", from: 4, len: 3), src)
    let media_two = send(mut two_leg, 500, Sent(generation: 1, ts: 9000, marker: true, pre: b"\x90\x80\x80\x42", from: 4, len: 3), src)
    if media_one != b"\x90\xe0\x00\x64\x00\x00\x0b\xb8\x00\x00\x11\x11\xbe\xde\x00\x02\x10\x30\x31\x00\x07\x00\x00\x00\x90\x80\x92\x34\xaa\xbb\xcc" || media_two != b"\x90\xe4\x01\xf4\x00\x00\x23\x28\x00\x00\x33\x33\xbe\xde\x00\x02\x22\x76\x2d\x31\x51\x00\x28\x00\x90\x80\x80\x42\xaa\xbb\xcc" {
        fail("per-leg media send")
    }
    let (repair_one, head_one) = result.unwrap(repair(mut one_leg, 100, src))
    if head_one != 24 || repair_one != b"\x90\xe1\x00\x10\x00\x00\x0b\xb8\x00\x00\x22\x22\xbe\xde\x00\x02\x10\x30\x31\x00\x08\x00\x00\x00\x00\x64\x90\x80\x92\x34\xaa\xbb\xcc" {
        fail("leg 1 repair")
    }
    let (repair_two, head_two) = result.unwrap(repair(mut two_leg, 500, src))
    if head_two != 24 || repair_two != b"\x90\xe5\x02\x00\x00\x00\x23\x28\x00\x00\x44\x44\xbe\xde\x00\x02\x22\x76\x2d\x31\x51\x00\x29\x00\x01\xf4\x90\x80\x80\x42\xaa\xbb\xcc" {
        fail("leg 2 repair")
    }
    // A source switch on leg 1: the next output index comes from generation 2.
    send(mut one_leg, 101, Sent(generation: 2, ts: 6000, marker: false, pre: b"", from: 4, len: 3), src)
    history.gate(mut one_leg.sent, 101)
    let Error(BeforeSwitch) = repair(mut one_leg, 100, src) else {
        fail("repair from before the switch")
    }
    Ok(())
}

fn sr_sdes(padded_sr: bool) -> Bytes {
    // SR, RC 0, SSRC 0x11223344: 28 bytes, length 6. Then an SDES chunk for that
    // SSRC with CNAME "abc": 4 + 2 + 3 + END = 10, nulls to 12, length 3.
    let mut b: Bytes = list.with_capacity(64)
    list.append(mut b, if padded_sr {
        b"\xa0\xc8\x00\x06"
    } else {
        b"\x80\xc8\x00\x06"
    })
    list.append(mut b, b"\x11\x22\x33\x44\xaa\xbb\xcc\xdd\x00\x11\x22\x33\x01\x02\x03\x04\x00\x00\x00\x05\x00\x00\x02\x58")
    list.append(mut b, b"\x81\xca\x00\x03\x11\x22\x33\x44\x01\x03abc\x00\x00\x00")
    b
}

fn refused(pkt: Bytes, mode: rtcp.Mode, expected: rtcp.Error) {
    match rtcp.check(pkt, mode) {
        Error(e) if e == expected => {},
        _ => fail("datagram refused with the wrong error or accepted"),
    }
}

fn accepted(pkt: Bytes, mode: rtcp.Mode, packets: u64) {
    if result.unwrap(rtcp.check(pkt, mode)) != packets {
        fail("valid datagram refused or miscounted")
    }
}

fn only(pkt: Bytes) -> rtcp.Packet {
    let mut at = 0u64
    let Some(p) = result.unwrap(rtcp.next(pkt, mut at)) else {
        fail("packet missing")
    }
    if at != list.len(pkt) || p.at != 0 || p.body != 4 {
        fail("packet extent")
    }
    p
}

fn pli() -> Bytes {
    b"\x81\xce\x00\x02\x00\x00\x00\x01\x00\x00\x00\x02"
}

fn nack() -> Bytes {
    b"\x81\xcd\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02\xff\x9c\x80\x09"
}

fn fir() -> Bytes {
    b"\x84\xce\x00\x04\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x07\x00\x00\x00"
}

fn report(i: u64) -> rtcp.Block {
    let n: u32 = int.narrow(i)
    let lost: i32 = int.narrow(i)
    rtcp.Block(ssrc: 0x1000 + n, fraction: int.narrow(i), lost: -lost, highest: 0x10000 + n, jitter: n, lsr: 0xb7050000 + n, dlsr: n << 8)
}

/// bug: Accept a datagram RFC 3550 or RFC 5506 refuses, misplace padding, or write feedback or report bytes that a receiver misreads.
/// oracle: RFC 3550 sections 6.1, 6.4, 6.5 and A.2, RFC 4585 sections 6.2.1 and 6.3.1, RFC 5104 section 4.3.1.1, RFC 5506 section 3, RFC 5761 section 4, by hand. The SDES chunk is 4 + 2 + 3 + 1 = 10 bytes, nulls to 12, then 4 bytes of padding; 32 blocks are 8 + 24 * 31 = 752 bytes (length 187), then 8 + 24 = 32 (length 7).
@test
fn rtcp_compound_rules() -> Result[(), ()] {
    let mut padded = sr_sdes(false)
    list.truncate(mut padded, 28)
    list.append(mut padded, b"\xa1\xca\x00\x04\x11\x22\x33\x44\x01\x03abc\x00\x00\x00\x00\x00\x00\x04")
    accepted(padded, Compound, 2)
    let mut at = 0u64
    let Some(sr) = result.unwrap(rtcp.next(padded, mut at)) else {
        fail("SR missing")
    }
    let Sr(info, 0) = sr.item else {
        fail("SR item")
    }
    if info.ssrc != 0x11223344 || info.ntp != 0xaabbccdd00112233 || info.rtp != 0x01020304 || info.packets != 5 || info.octets != 600 || sr.end != 28 || at != 28 {
        fail("SR sender info")
    }
    let Some(sdes) = result.unwrap(rtcp.next(padded, mut at)) else {
        fail("SDES missing")
    }
    if sdes.item != Sdes(1) || sdes.body != 32 || sdes.end != 44 || sdes.len != 48 || at != 48 {
        fail("padded SDES extent")
    }
    if result.unwrap(rtcp.cname(padded, sdes, 0x11223344)) != Some((38u64, 3u64)) || result.unwrap(rtcp.cname(padded, sdes, 0x55667788)) != None {
        fail("CNAME lookup")
    }
    accepted(sr_sdes(false), Compound, 2)
    accepted(pli(), Reduced, 1)
    accepted(nack(), Reduced, 1)
    accepted(fir(), Reduced, 1)
    if only(pli()).item != Pli(1, 2) || only(nack()).item != Nack(1, 2) || only(fir()).item != Fir(1) {
        fail("feedback items")
    }
    let fp = only(fir())
    let mut cursor = 0u64
    if result.unwrap(rtcp.fir_next(fir(), fp, mut cursor)) != Some((2u32, 7u8)) || result.unwrap(rtcp.fir_next(fir(), fp, mut cursor)) != None {
        fail("FIR entry")
    }
    refused(sr_sdes(true), Compound, Padding)
    refused(b"\x80\xc9\x00\x01\x11\x22\x33\x44", Compound, NoCname)
    refused(b"\x80\xc9\x00\x01\x11\x22\x33\x44", Reduced, NoCname)
    refused(b"\x80\xc9\x00\x01\x11\x22\x33\x44\x81\xca\x00\x03\x55\x66\x77\x88\x01\x03abc\x00\x00\x00", Compound, NoCname)
    refused(pli(), Compound, NotCompound)
    refused(b"\x81\xce\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02", Reduced, Length)
    refused(b"\x80\xc9\x00\x01\x11\x22\x33\x44\x82\xca\x00\x04\x11\x22\x33\x44\x01\x03abc\x00\x00\x00\x55\x66\x77\x88", Compound, Body(202))
    refused(b"\x81\xcb\x00\x02\x11\x22\x33\x44\x05abc", Reduced, Body(203))
    refused(b"\x81\xce\x00\x03\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x00", Reduced, Body(206))
    // Without padding a NACK's FCI is whole words; 6 bytes of FCI need a
    // 2-byte pad count, which RFC 3550 section 6.4.1 refuses first.
    refused(b"\xa1\xcd\x00\x04\x00\x00\x00\x01\x00\x00\x00\x02\xff\x9c\x80\x09\x00\x00\x00\x02", Reduced, Padding)
    refused(b"\x81\xcd\x00\x02\x00\x00\x00\x01\x00\x00\x00\x02", Reduced, Body(205))
    refused(b"\x84\xce\x00\x05\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x07\x00\x00\x00\x00\x00\x00\x03", Reduced, Body(206))
    let mut tail = sr_sdes(false)
    list.append(mut tail, b"\xa0\xc9\x00\x02\x11\x22\x33\x44\x00\x00\x00\x03")
    refused(tail, Compound, Padding)
    if !rtcp.is_rtcp(b"\x80\xc0\x00\x00") || !rtcp.is_rtcp(b"\x80\xdf\x00\x00") || rtcp.is_rtcp(b"\x80\xbf\x00\x00") || rtcp.is_rtcp(b"\x80\xe0\x00\x00") {
        fail("RTP and RTCP demultiplexing")
    }
    let mut blocks: List[rtcp.Block] = list.new()
    let mut i = 0u64
    while i < 32 {
        list.push(mut blocks, report(i))
        i += 1
    }
    let mut out: Bytes = list.with_capacity(1024)
    if result.unwrap(rtcp.write_rr(0x11223344, view blocks, mut out)) != 784 || list.len(out) != 784 || list.slice(out, 0, 8) != b"\x9f\xc9\x00\xbb\x11\x22\x33\x44" || list.slice(out, 752, 760) != b"\x81\xc9\x00\x07\x11\x22\x33\x44" {
        fail("RR split at 31 blocks")
    }
    at = 0
    let Some(first) = result.unwrap(rtcp.next(out, mut at)) else {
        fail("first RR")
    }
    let Some(second) = result.unwrap(rtcp.next(out, mut at)) else {
        fail("second RR")
    }
    if first.item != Rr(0x11223344, 31) || second.item != Rr(0x11223344, 1) || at != 784 {
        fail("RR items")
    }
    i = 0
    while i < 32 {
        let back = if i < 31 {
            result.unwrap(rtcp.block(out, first, int.narrow(i)))
        } else {
            result.unwrap(rtcp.block(out, second, 0))
        }
        if back != report(i) {
            fail("report block did not parse back")
        }
        i += 1
    }
    let mut cname_out: Bytes = list.with_capacity(512)
    list.push(mut cname_out, 0xff)
    let mut long: Bytes = list.new()
    list.fill(mut long, 256, b'a')
    let Error(Unrepresentable) = rtcp.write_cname(1, long, mut cname_out) else {
        fail("256-byte CNAME written")
    }
    let mut tight: Bytes = list.with_capacity(15)
    let Error(Capacity(c)) = rtcp.write_cname(0x11223344, b"abc", mut tight) else {
        fail("CNAME written without spare")
    }
    if c.requested != 16 || c.available != list.capacity(tight) || list.len(tight) != 0 || cname_out != b"\xff" {
        fail("CNAME refusal appended")
    }
    let mut named: Bytes = list.with_capacity(16)
    if result.unwrap(rtcp.write_cname(0x11223344, b"abc", mut named)) != 16 || named != b"\x81\xca\x00\x03\x11\x22\x33\x44\x01\x03abc\x00\x00\x00" {
        fail("CNAME bytes")
    }
    let mut fb: Bytes = list.with_capacity(64)
    if result.unwrap(rtcp.write_pli(1, 2, mut fb)) != 12 || fb != pli() {
        fail("PLI bytes")
    }
    list.clear(mut fb)
    let mut pairs: List[(u16, u16)] = list.new()
    list.push(mut pairs, (65436u16, 0x8009u16))
    if result.unwrap(rtcp.write_nack(1, 2, view pairs, mut fb)) != 16 || fb != nack() {
        fail("NACK bytes")
    }
    list.clear(mut fb)
    if result.unwrap(rtcp.write_fir(1, 2, 7, mut fb)) != 20 || fb != fir() {
        fail("FIR bytes")
    }
    // TWCC with four statuses (0xBC00) and deltas 00 30 2C 50: 14 FCI bytes.
    // Its FCI may end up to 3 bytes before RTCP padding, not 4; with one
    // delta short it overruns into the padding.
    accepted(twcc_pkt(b"\xaf\xcd\x00\x06", b"\x00\x0a\x00\x04\x00\x00\x00\x00\xbc\x00\x00\x30\x2c\x50\x00\x02"), Reduced, 1)
    accepted(twcc_pkt(b"\xaf\xcd\x00\x07", b"\x00\x0a\x00\x04\x00\x00\x00\x00\xbc\x00\x00\x30\x2c\x50\x00\x00\x00\x00\x00\x03"), Reduced, 1)
    refused(twcc_pkt(b"\xaf\xcd\x00\x07", b"\x00\x0a\x00\x04\x00\x00\x00\x00\xbc\x00\x00\x30\x2c\x50\x00\x00\x00\x00\x00\x02"), Reduced, Body(205))
    refused(short_delta(), Reduced, Body(205))
    Ok(())
}

// A TWCC packet from sender 1 about media 2.
fn twcc_pkt(head: Bytes, fci: Bytes) -> Bytes {
    let mut b: Bytes = list.with_capacity(64)
    list.append(mut b, head)
    list.append(mut b, b"\x00\x00\x00\x01\x00\x00\x00\x02")
    list.append(mut b, fci)
    b
}

// Four statuses with three of their four deltas, then 3 bytes of padding.
fn short_delta() -> Bytes {
    twcc_pkt(b"\xaf\xcd\x00\x06", b"\x00\x0a\x00\x04\x00\x00\x00\x00\xbc\x00\x00\x30\x2c\x00\x00\x03")
}

// A send log that has assigned transport numbers 0 to n - 1, number i sent
// at i us with 1200 bytes.
fn sent(n: u64) -> twcc.SendLog {
    let mut s = result.unwrap(twcc.send_log(64))
    let mut i = 0u64
    while i < n {
        let _ = twcc.assign(mut s, i * 1000, 1200)
        i += 1
    }
    s
}

fn feed(mut s: twcc.SendLog, pkt: Bytes, mut out: List[twcc.Acked]) -> u64 {
    result.unwrap(twcc.on_feedback(mut s, pkt, only(pkt), 64, mut out))
}

fn arrival(index: u64, us: Option[i64]) -> twcc.Acked {
    twcc.Acked(index: index, sent_ns: index * 1000, size: 1200, arrived_us: us)
}

fn written(mut r: twcc.RecvLog) -> Bytes {
    let mut out: Bytes = list.with_capacity(512)
    let size = result.unwrap(twcc.write(mut r, 1, 2, 1500, mut out))
    if size != list.len(out) {
        fail("write answered another length")
    }
    out
}

/// bug: Quantize, chunk or encode arrivals so that a receiver reads other times, refuse for room after changing state, or count a receipt twice or turn it into a loss.
/// oracle: draft-holmer-rmcat-transport-wide-cc-extensions-01 section 3.1, by hand, on the arrivals of str0m twcc.rs:1529-1549 (numbers 10 to 13 at 0, 12, 23 and 43 ms): one 1-bit vector of four received symbols, 0b10_1111_0000000000 = 0xBC00, and deltas 0, 48, 44 and 80 in 250 us units; FCI 14 bytes padded to 16, so 28 bytes and length 6.
@test
fn twcc_report_bytes() -> Result[(), ()] {
    let mut r = result.unwrap(twcc.recv_log(64))
    twcc.on_packet(mut r, 10, 0)
    twcc.on_packet(mut r, 11, 12000000)
    twcc.on_packet(mut r, 12, 23000000)
    twcc.on_packet(mut r, 13, 43000000)
    let out = written(mut r)
    if out != twcc_pkt(b"\x8f\xcd\x00\x06", b"\x00\x0a\x00\x04\x00\x00\x00\x00\xbc\x00\x00\x30\x2c\x50\x00\x00") {
        fail("TWCC report bytes")
    }
    if list.len(written(mut r)) != 0 {
        fail("a report was written twice")
    }
    let mut s = sent(14)
    let mut acked: List[twcc.Acked] = list.with_capacity(8)
    // Number 10 reported lost first: base 10, count 1, a run of one 00.
    let lost = twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x0a\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00")
    if feed(mut s, lost, mut acked) != 1 || acked[0] != arrival(10, None) {
        fail("loss report")
    }
    list.clear(mut acked)
    let Error(Capacity(_)) = twcc.on_feedback(mut s, out, only(out), 3, mut acked) else {
        fail("four statuses accepted under a bound of 3")
    }
    if list.len(acked) != 0 {
        fail("refusal for room appended")
    }
    if feed(mut s, out, mut acked) != 4 || acked[0] != arrival(10, Some(0)) || acked[1] != arrival(11, Some(12000)) || acked[2] != arrival(12, Some(23000)) || acked[3] != arrival(13, Some(43000)) {
        fail("arrivals after the refusal")
    }
    list.clear(mut acked)
    if feed(mut s, out, mut acked) != 0 || feed(mut s, lost, mut acked) != 0 || list.len(acked) != 0 {
        fail("an overlapping report counted again")
    }
    Ok(())
}

fn expect_refused(pkt: Bytes, expected: Bytes) {
    let p = only(pkt)
    let mut s = sent(16)
    let mut acked: List[twcc.Acked] = list.with_capacity(8)
    let got = match twcc.parse(pkt, p) {
        Error(Chunk) => b"Chunk",
        Error(Symbol) => b"Symbol",
        Error(Deltas) => b"Deltas",
        Error(Tail) => b"Tail",
        _ => b"other",
    }
    let Error(_) = twcc.on_feedback(mut s, pkt, p, 64, mut acked) else {
        fail("invalid FCI fed")
    }
    if got != expected || list.len(acked) != 0 {
        fail("invalid FCI refused wrongly or emitted")
    }
}

/// bug: Pick the wrong chunk form or symbol, misread a negative delta, carry a delta that does not fit, lose the reference time across its 24-bit wrap or a full revolution, or accept an FCI outside the draft's grammar.
/// oracle: draft-holmer-rmcat-transport-wide-cc-extensions-01 section 3.1, by hand. 221 small statuses are the run 0b0_01_0000011011101 = 0x20DD. Arrivals 1 ms apart in the order 11, 10 give 10 q 4 and 11 q 0: 2-bit symbols 01 10 = 0xD800, deltas 04 and -4 = FF FC. 8.2 s is q 32800 > 32767, so the next packet has reference 128 and first delta 32. 0xFFFFFF then 0 is 64 ms later. q = 2^32 + 1 is reference 2^24 (wire 0) and delta 1, reached by references 2^22 apart.
@test
fn twcc_chunks() -> Result[(), ()] {
    let mut run = result.unwrap(twcc.recv_log(512))
    let mut i = 0u64
    while i < 221 {
        twcc.on_packet(mut run, int.narrow(i), i * 1000000)
        i += 1
    }
    let long = written(mut run)
    if list.len(long) != 244 || list.slice(long, 12, 22) != b"\x00\x00\x00\xdd\x00\x00\x00\x00\x20\xdd" {
        fail("221 small statuses")
    }
    let mut two = result.unwrap(twcc.recv_log(16))
    twcc.on_packet(mut two, 11, 1000000000)
    twcc.on_packet(mut two, 10, 1001000000)
    let back = written(mut two)
    if back != twcc_pkt(b"\x8f\xcd\x00\x06", b"\x00\x0a\x00\x02\x00\x00\x00\x00\xd8\x00\x04\xff\xfc\x00\x00\x00") {
        fail("negative delta chunk")
    }
    let mut s = sent(12)
    let mut acked: List[twcc.Acked] = list.with_capacity(8)
    if feed(mut s, back, mut acked) != 2 || acked[0] != arrival(10, Some(1000)) || acked[1] != arrival(11, Some(0)) {
        fail("negative delta read back")
    }
    let mut gap = result.unwrap(twcc.recv_log(16))
    twcc.on_packet(mut gap, 1, 0)
    twcc.on_packet(mut gap, 2, 8200000000)
    if written(mut gap) != twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x01\x00\x01\x00\x00\x00\x00\xa0\x00\x00\x00") || written(mut gap) != twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x02\x00\x01\x00\x00\x80\x01\xa0\x00\x20\x00") {
        fail("8.2 s delta did not end the packet")
    }
    let mut wrap = sent(2)
    list.clear(mut acked)
    feed(mut wrap, twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x00\x00\x01\xff\xff\xff\x00\xa0\x00\x00\x00"), mut acked)
    feed(mut wrap, twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x01\x00\x01\x00\x00\x00\x01\xa0\x00\x00\x00"), mut acked)
    let (Some(before), Some(after)) = (acked[0].arrived_us, acked[1].arrived_us) else {
        fail("wrapped reference lost an arrival")
    }
    if list.len(acked) != 2 || after - before != 64000 {
        fail("reference time did not extend across its wrap")
    }
    let mut rev = result.unwrap(twcc.recv_log(16))
    let mut far = sent(6)
    let steps =[0u64, 1073741824u64, 2147483648u64, 3221225472u64, 4294967297u64]
    let mut last: Bytes = list.new()
    i = 0
    while i < 5 {
        let q = steps[i]
        twcc.on_packet(mut rev, int.narrow(i + 1), q * 250000)
        last = written(mut rev)
        list.clear(mut acked)
        let us: i64 = int.narrow(q * 250)
        if feed(mut far, last, mut acked) != 1 || acked[0] != arrival(i + 1, Some(us)) {
            fail("arrival across a revolution")
        }
        i += 1
    }
    if last != twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x05\x00\x01\x00\x00\x00\x04\xa0\x00\x01\x00") {
        fail("full revolution bytes")
    }
    // A zero-length run, then a vector of two received statuses.
    let zero = twcc_pkt(b"\x8f\xcd\x00\x06", b"\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\xb0\x00\x01\x02\x00\x00")
    let mut z = sent(2)
    list.clear(mut acked)
    if result.unwrap(twcc.parse(zero, only(zero))) != 2 || feed(mut z, zero, mut acked) != 2 || acked[0] != arrival(0, Some(250)) || acked[1] != arrival(1, Some(750)) {
        fail("zero-length run chunk")
    }
    expect_refused(twcc_pkt(b"\xaf\xcd\x00\x05", b"\x00\x0a\x00\x04\x00\x00\x00\x00\xbc\x00\x00\x03"), b"Chunk")
    expect_refused(twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x00\x00\x01\x00\x00\x00\x00\xf0\x00\x00\x00"), b"Symbol")
    expect_refused(twcc_pkt(b"\x8f\xcd\x00\x05", b"\x00\x00\x00\x01\x00\x00\x00\x00\x60\x01\x00\x00"), b"Symbol")
    expect_refused(short_delta(), b"Deltas")
    expect_refused(twcc_pkt(b"\xaf\xcd\x00\x06", b"\x00\x00\x00\x01\x00\x00\x00\x00\xa0\x00\x00\x01\x01\x01\x01\x01"), b"Tail")
    Ok(())
}

/// bug: Misread a NACK FCI entry, extend its PID or BLP bits against the wrong cycle, pack due losses into the wrong pairs, ask for an index that arrived or left the window, or lose retry state when the output is short.
/// oracle: str0m src/rtp/rtcp/nack.rs:134-155 and RFC 4585 section 6.2.1. 196618 is cycle 3, sequence 10; 65436 - 10 > 32768, so PID 65436 is cycle 2: 196508, and BLP 0x8009 sets bits 0, 3 and 15: +1, +4 and +16. Packing is RTP-6's greedy rule, by hand.
@test
fn nack_pairs() -> Result[(), ()] {
    let pkt = nack()
    let p = only(pkt)
    let mut at = 0u64
    let Some((pid, blp)) = result.unwrap(rtcp.nack_next(pkt, p, mut at)) else {
        fail("NACK pair missing")
    }
    if pid != 65436 || blp != 0b1000_0000_0000_1001 || at != 4 {
        fail("NACK pair")
    }
    let Ok(None) = rtcp.nack_next(pkt, p, mut at) else {
        fail("NACK walk did not end")
    }
    let mut lost: List[u64] = list.new()
    let mut bit = 0u16
    while bit <= 16 {
        if bit == 0 || ((blp >> (bit - 1)) & 1) != 0 {
            let wire = int.wrapping_add(pid, bit)
            if let Index(i) = seq.estimate(196618, wire) {
                list.push(mut lost, i)
            }
        }
        bit += 1
    }
    if list.len(lost) != 4 || lost[0] != 196508 || lost[1] != 196509 || lost[2] != 196512 || lost[3] != 196524 {
        fail("NACK expansion")
    }
    nack_packing()
    Ok(())
}

// The RTP-4 cases of bounded_views. The RR's block decodes by hand as SSRC
// 0x55667788, fraction 64, lost -2, highest 0x1000D, jitter 42.
fn rtcp_views() {
    let rr = b"\x81\xc9\x00\x07\x11\x22\x33\x44\x55\x66\x77\x88\x40\xff\xff\xfe\x00\x01\x00\x0d\x00\x00\x00\x2a\xb7\x05\x20\x00\x00\x05\x40\x00"
    let p = only(rr)
    let b = result.unwrap(rtcp.block(rr, p, 0))
    if b != rtcp.Block(ssrc: 0x55667788, fraction: 64, lost: -2, highest: 0x1000d, jitter: 42, lsr: 0xb7052000, dlsr: 0x54000) {
        fail("report block fields")
    }
    let Error(Index) = rtcp.block(rr, p, 1) else {
        fail("report block outside the count")
    }
    let short = list.slice(rr, 0, 31)
    let Error(Buffer) = rtcp.block(short, p, 0) else {
        fail("report block on a mismatched buffer")
    }
    let np = only(nack())
    let mut at = 0u64
    let Error(Buffer) = rtcp.nack_next(short, np, mut at) else {
        fail("NACK walk on a mismatched buffer")
    }
    let Error(Buffer) = rtcp.cname(short, p, 0) else {
        fail("CNAME lookup on a mismatched buffer")
    }
    if at != 0 {
        fail("buffer refusal moved the cursor")
    }
    let mut n = 0u64
    while n < 4 {
        if rtcp.is_rtcp(list.slice(b"\x80\xc8\x00", 0, if n < 3 {
            n
        } else {
            3
        })) {
            fail("RTCP shorter than its common header")
        }
        n += 1
    }
    let Error(Length) = rtcp.next(b"\x00\xc8\x00", mut at) else {
        fail("version checked before length")
    }
    let Error(Length) = rtcp.check(b"\x81\xce\x00", Reduced) else {
        fail("3-byte datagram")
    }
    let Error(Version) = rtcp.next(b"\x41\xce\x00\x02\x00\x00\x00\x01\x00\x00\x00\x02", mut at) else {
        fail("version")
    }
    if at != 0 {
        fail("refused packet moved the cursor")
    }
}

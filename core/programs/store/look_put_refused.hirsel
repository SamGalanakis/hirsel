// L22 negative control. The view Tx passed to look cannot become writable.
pub fn rejected(s: store.Snapshot, t: store.Table[u64, u64]) -> bool {
    let answer = store.look(s, fn(tx: store.Tx) -> bool {
        match store.put(mut tx, t, 1, 2) {
            Ok(()) => true,
            Error(_) => false
        }
    })
    false
}

b0(v0: u64, v1: u64, v2: u64):
  v3: u64 = call rt.args_len g1 (v0)
  v4: ptr = call rt.args_get g2 (v0, v2)  ; a run-owned carrier of capacity 0, or null
  v5: ptr = const 0x0
  v6: bool = ne v4, v5
  branch v6, b1, b2
b1:
  v7: u64, v8: u8, v9: u32, v10: u64 = call rt.stdout_write g3 (v1, v4)
  return v3, v10
b2:
  v11: u64 = const 0
  return v3, v11

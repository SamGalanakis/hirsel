// rule: MODE-6
// expect: run
// A key built in a short-lived arena and recorded through a nested borrow is
// recorded as independently owned bytes: ending the arena and reusing its
// storage leaves the finished events intact.
fn read(r: Recorder[Bytes], key: Bytes) -> () {
  recorder.append(r, copy_to(heap, key))
}

fn nested(r: Recorder[Bytes], key: Bytes) -> () {
  read(r, key)
}

pub fn main(t: Test) -> Result[(), ()] {
  let r: Recorder[Bytes] = recorder.new()
  arena.with(
    fn(a: Arena) {
      let k: Bytes in a = copy_to(a, b"absent")
      nested(r, k)
    }
  )
  arena.with(
    fn(a: Arena) {
      let junk: Bytes in a = copy_to(a, b"XXXXXX")
      test.check(t, junk == b"XXXXXX")
    }
  )
  recorder.append(r, b"held")
  let xs: List[Bytes] = recorder.finish(take r)
  test.check(t, xs == [b"absent", b"held"])
  Ok(())
}

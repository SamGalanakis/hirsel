pub type PageTree: shareable + send {
    root: Arc[std.page.Page],
    inline: u64,
    // The collection map keeps its empty child shared even while every collection has rows.
    empty_collection: Option[Arc[std.page.Page]]
    replay: Option[Arc[ReplayBranch]],
    paging: Option[Arc[TieredReadInventory]]
}

pub type PageRoots: shareable + send {
    collections: PageTree,
    streams: PageTree,
    catalog: PageTree,
    keyed: List[PageTree]
}

pub const KEYED_TREE_COUNT: u64 = 7

fn new_keyed_pages(inline: u64) -> List[PageTree] {
    let mut trees: List[PageTree] = list.with_capacity(KEYED_TREE_COUNT)
    for _ in 0u64 .. KEYED_TREE_COUNT {
        list.push(mut trees, new_page_tree(Unprefixed, inline))
    }
    take trees
}

pub fn share_keyed_pages(trees: List[PageTree]) -> List[PageTree] {
    let mut shared: List[PageTree] = list.with_capacity(list.len(trees))
    for tree in trees {
        list.push(mut shared, share_page_tree(tree))
    }
    take shared
}

pub fn attach_page_tree(pages: Map[u64, Arc[std.page.Page]], ptr: std.page.PagePtr, domain: std.page.Domain, inline: u64, take empty_collection: Option[Arc[std.page.Page]]) -> PageTree {
    let root = if ptr.stamp == 0 {
        std.page.empty(0, 0, domain)
    } else {
        let Some(found) = map.get(pages, ptr.stamp) else {
            fail("store: missing validated root")
        }
        arc.share(found)
    }
    PageTree(root: take root, inline: inline, empty_collection: take empty_collection, replay: None, paging: None)
}

pub fn attach_page_roots(pages: Map[u64, Arc[std.page.Page]], roots: LocatedRoots, inline: u64, empty_collection: Arc[std.page.Page]) -> PageRoots {
    let mut keyed: List[PageTree] = list.with_capacity(list.len(roots.keyed))
    for ptr in roots.keyed {
        list.push(mut keyed, attach_page_tree(pages, ptr, Unprefixed, inline, None))
    }
    PageRoots(collections: attach_page_tree(pages, roots.collections, CollectionMap, inline, Some(arc.share(empty_collection))), streams: attach_page_tree(pages, roots.streams, Unprefixed, inline, None), catalog: attach_page_tree(pages, roots.catalog, Unprefixed, inline, None), keyed: take keyed)
}

pub fn new_page_tree(domain: std.page.Domain, inline: u64) -> PageTree {
    let empty_collection = if domain == CollectionMap {
        Some(std.page.empty(0, 0, Collection))
    } else {
        None
    }
    PageTree(root: std.page.empty(0, 0, domain), inline: inline, empty_collection: take empty_collection, replay: None, paging: None)
}

pub fn share_page_tree(tree: PageTree) -> PageTree {
    let empty_collection = match tree.empty_collection {
        Some(empty) => Some(arc.share(empty)),
        None => None
    }
    PageTree(root: arc.share(tree.root), inline: tree.inline, empty_collection: take empty_collection, replay: clone(tree.replay), paging: clone(tree.paging))
}

pub fn tree_domain(tree: PageTree) -> std.page.Domain {
    std.page.key_domain(std.page.image_of(tree.root))
}

pub fn tree_stamp(tree: PageTree) -> u64 {
    std.page.stamp(std.page.image_of(tree.root))
}

fn install_page_tree(mut tree: PageTree, take replacement: PageTree) {
    let PageTree(root: take ready, inline: width, replay: take layers, paging: take inventory, ..) = take replacement
    std.page.install_planned(mut tree.root, take ready)
    tree.inline = width
    tree.replay = take layers
    tree.paging = take inventory
}

pub fn page_error(problem: std.page.Error) -> types.Failure {
    match problem {
        StampLimit => Limit(Ids),
        PageLimit => Limit(Value),
        UnsupportedPage => Unsupported(0x0021),
        _ => malformed(0),
    }
}

pub fn page_result[T](take value: Result[T, std.page.Error]) -> Result[T, types.Failure] {
    match take value {
        Ok(take ready) => Ok(take ready),
        Error(problem) => Error(page_error(problem)),
    }
}

pub type CollectionDescriptor = std.page_descriptor.CollectionDescriptor

pub fn collection_descriptor(raw: Bytes) -> CollectionDescriptor {
    result.unwrap(std.page_descriptor.collection_descriptor(raw))
}

pub fn unwrap_collection_descriptor(take raw: Option[View[Bytes]]) -> CollectionDescriptor {
    let value = option.unwrap(take raw)
    collection_descriptor(value)
}

pub fn collection_by_key(tree: PageTree, key: Bytes) -> Option[CollectionDescriptor] {
    match std.page.lookup(tree.root, key) {
        Some(raw) => Some(collection_descriptor(raw)),
        None => None,
    }
}

pub fn descriptor_kind_byte(kind: std.page_descriptor.CollectionKind) -> u8 {
    match kind {
        TableCollection => 1,
        IndexCollection => 2,
        CellCollection => 3,
        LogCollection => 4,
        BlobsCollection => 5,
    }
}

pub fn collection_header(stamp: u64, rows: u64, charge: u64, kind: u8, residency: std.page_descriptor.Residency) -> Result[Bytes, types.Failure] {
    let mut record = std.page.encode_ptr(std.page.unlocated(stamp))
    types.capacity(format.le(mut record, rows, 8))?
    types.capacity(format.le(mut record, charge, 8))?
    list.push(mut record, kind)
    list.fill(mut record, 3, 0u8)
    std.page_descriptor.set_collection_residency(mut record, residency)
    Ok(take record)
}

pub fn rooted_collection_record(root: Arc[std.page.Page], kind: u8, residency: std.page_descriptor.Residency) -> Result[Bytes, types.Failure] {
    let (rows, charge) = std.page.totals(root)
    let stamp = if rows == 0 {
        0u64
    } else {
        std.page.stamp(std.page.image_of(root))
    }
    collection_header(stamp, rows, charge, kind, residency)
}

pub fn cell_record(root: Arc[std.page.Page], inline: Option[View[Bytes]]) -> Result[Bytes, types.Failure] {
    if let Some(value) = inline {
        let mut record = collection_header(0, 1, 70 + format.round8(list.len(value)), 3, ResidentMemory)?
        types.capacity(format.le(mut record, list.len(value), 2))?
        list.append(mut record, value)
        return Ok(take record)
    }
    let mut record = rooted_collection_record(root, 3, ResidentMemory)?
    list.fill(mut record, 2, 0u8)
    Ok(take record)
}

pub fn log_record(root: Arc[std.page.Page], first_seq: u64, next_seq: u64, residency: std.page_descriptor.Residency) -> Result[Bytes, types.Failure] {
    let mut record = rooted_collection_record(root, 4, residency)?
    list.put_word_le(mut record, next_seq)
    list.put_word_le(mut record, first_seq)
    Ok(take record)
}

pub fn put_collection(mut tree: PageTree, key: Bytes, built: Option[Arc[std.page.Page]], kind: u8, private_from: u64, mut ids: u64) -> Result[(), types.Failure] {
    let root = match built {
        Some(ready) => arc.share(ready),
        None => {
            let Some(shared) = view tree.empty_collection else {
                fail("store: missing empty collection page")
            }
            arc.share(shared)
        },
    }
    let record = match kind {
        3 => cell_record(root, None)?,
        4 => log_record(root, 0, 0, ResidentMemory)?,
        _ => rooted_collection_record(root, kind, ResidentMemory)?,
    }
    page_result(std.page.insert(mut tree.root, key, record, Some(take root), tree.inline, private_from, mut ids))
}

pub fn collection_rank(root: Arc[std.page.Page], id_key: Bytes, boundary: Bytes, total: u64) -> u64 {
    let n = list.len(boundary)
    if n < 4 || list.slice(boundary, 0, 4) < id_key {
        return 0
    }
    if list.slice(boundary, 0, 4) > id_key {
        return total
    }
    if n == 4 {
        return 0
    }
    std.page.rank(root, list.slice(boundary, 4, n), false)
}

pub fn one_page_account(roots: PageRoots) -> u64 {
    let (_, streams) = std.page.totals(roots.streams.root)
    let (_, catalog) = std.page.totals(roots.catalog.root)
    let mut charge = int.saturating_add(streams, catalog)
    for tree in roots.keyed {
        let (_, rows) = std.page.totals(tree.root)
        charge = int.saturating_add(charge, rows)
    }
    let mut listed = std.page.cursor_open(roots.collections.root, None, true, false)
    let leading: Bytes = list.new()
    while let Some((_, slot)) = std.page.cursor_next_key(mut listed, leading) {
        let descriptor = unwrap_collection_descriptor(std.page.cursor_value(listed, slot))
        let bytes_charge: u64 = if descriptor.residency == ResidentMemory {
            descriptor.row_bytes
        } else {
            0
        }
        charge = int.saturating_add(charge, int.saturating_add(126, bytes_charge))
    }
    charge
}

pub fn page_image_charge(node: Arc[std.page.Page], mut seen: Map[u64, ()]) -> u64 {
    let image = std.page.image_of(node)
    let stamp = std.page.stamp(image)
    if stamp == 0 || map.contains(seen, stamp) {
        return 0
    }
    map.insert(mut seen, stamp, ())
    let mut total = list.capacity(std.page.payload(image))
    for slot in 0u64 .. std.page.count(image) {
        match std.page.owning_edge(image, slot) {
            Some(PageEdge(_)) => {
                if let HotPage(child) = option.unwrap(std.page.child_slot(node, slot)) {
                    total = int.saturating_add(total, page_image_charge(child, mut seen))
                }
            },
            Some(BlobEdge(body_ref)) => {
                if let HotBlob(_) = option.unwrap(std.page.blob_slot(node, body_ref.body)) {
                    if !map.contains(seen, body_ref.stamp) {
                        map.insert(mut seen, body_ref.stamp, ())
                        total = int.saturating_add(total, body_ref.len)
                    }
                }
            },
            None => (),
        }
    }
    total
}

fn account_frontier(mut ready: Heap[(Bytes, u64)], walks: List[std.page_walk.Walk], slot: u64) {
    if let Some(take key) = std.page_walk.key(walks[slot]) {
        heap.push(mut ready, (take key, slot))
    }
}

pub fn compare_row_versions(first: std.page_walk.Walk, second: std.page_walk.Walk) -> Order {
    let stamp = std.page_walk.blob_stamp(first)
    if stamp != 0 && stamp == std.page_walk.blob_stamp(second) {
        return Equal
    }
    let Some(a) = std.page_walk.value(first) else {
        fail("store: missing row version")
    }
    let Some(b) = std.page_walk.value(second) else {
        fail("store: missing row version")
    }
    list.compare_bytes(a, b)
}

fn count_row_versions(walks: List[std.page_walk.Walk], mut group: List[u64], key_width: u64) -> u64 {
    list.sort(mut group, scoped fn(a: u64, b: u64) -> Order {
        compare_row_versions(walks[a], walks[b])
    })
    let mut charge = 0u64
    for slot in 0u64 .. list.len(group) {
        let current = group[slot]
        if slot != 0 && compare_row_versions(walks[current], walks[group[slot - 1]]) == Equal {
            continue
        }
        let Some(raw) = std.page_walk.value(walks[current]) else {
            fail("store: missing row version")
        }
        charge = int.saturating_add(charge, 62 + format.round8(key_width) + format.round8(list.len(raw)))
    }
    charge
}

fn row_version_union(roots: List[Arc[std.page.Page]], prefix_width: u64) -> u64 {
    let mut walks: List[std.page_walk.Walk] = list.with_capacity(list.len(roots))
    let mut ready: Heap[(Bytes, u64)] = heap.new()
    let mut seen: Map[u64, ()] = map.new()
    for root in roots {
        let stamp = std.page.stamp(std.page.image_of(root))
        if stamp == 0 || map.contains(seen, stamp) {
            continue
        }
        map.insert(mut seen, stamp, ())
        let slot = list.len(walks)
        list.push(mut walks, std.page_walk.begin(root))
        account_frontier(mut ready, walks, slot)
    }
    let mut group: List[u64] = list.new()
    let mut charge = 0u64
    while let Some((take key, first)) = heap.pop(mut ready) {
        list.clear(mut group)
        list.push(mut group, first)
        loop {
            let same_key = match heap.peek(ready) {
                Some((following, _)) => following == key,
                None => false
            }
            if !same_key {
                break
            }
            let (_, slot) = option.unwrap(heap.pop(mut ready))
            list.push(mut group, slot)
        }
        let mut shared = std.page_walk.subtree(walks[first])
        let mut highest: Option[u8] = None
        for slot in group {
            if let Some(span) = std.page_walk.subtree(walks[slot]) {
                if let Some(common) = shared {
                    if common.stamp != span.stamp {
                        shared = None
                    }
                }
                let lvl = match highest {
                    Some(prior) => order.max(prior, span.level),
                    None => span.level
                }
                highest = Some(lvl)
            } else {
                shared = None
            }
        }
        if let Some(_) = shared {
            let high = option.unwrap(std.page_walk.subtree_high(walks[first]))
            let overlaps = match heap.peek(ready) {
                Some((following, _)) => following <= high,
                None => false
            }
            if !overlaps {
                charge = int.saturating_add(charge, std.page_walk.subtree_charge(walks[first]))
                for slot in group {
                    std.page_walk.next(mut walks[slot])
                    account_frontier(mut ready, walks, slot)
                }
                continue
            }
        }
        if let Some(top_level) = highest {
            for slot in group {
                if let Some(span) = std.page_walk.subtree(walks[slot]) {
                    if span.level == top_level {
                        std.page_walk.expand(mut walks[slot])
                    }
                }
                account_frontier(mut ready, walks, slot)
            }
        } else {
            charge = int.saturating_add(charge, count_row_versions(walks, mut group, prefix_width + list.len(key)))
            for slot in group {
                std.page_walk.next(mut walks[slot])
                account_frontier(mut ready, walks, slot)
            }
        }
    }
    charge
}

// The collection descriptors live in Memory even when their data is Tiered.
fn account_collection_key(mut listed: std.page_walk.Walk) -> Option[Bytes] {
    while let Some(_) = std.page_walk.subtree(listed) {
        std.page_walk.expand(mut listed)
    }
    std.page_walk.key(listed)
}

pub fn page_row_account(roots: List[PageRoots]) -> u64 {
    if list.len(roots) == 1 {
        return one_page_account(roots[0u64])
    }
    let mut streams: List[Arc[std.page.Page]] = list.with_capacity(list.len(roots))
    let mut catalog: List[Arc[std.page.Page]] = list.with_capacity(list.len(roots))
    let mut collections: Map[u32, List[Arc[std.page.Page]]] = map.new()
    let mut cells: Map[u32, List[Arc[Bytes]]] = map.new()
    let mut descriptors: Map[u32, ()] = map.new()
    for participating in roots {
        list.push(mut streams, arc.share(participating.streams.root))
        list.push(mut catalog, arc.share(participating.catalog.root))
        let mut listed = std.page_walk.begin(participating.collections.root)
        while let Some(take key) = account_collection_key(mut listed) {
            let id: u32 = list.word_be(key, 0)
            map.insert(mut descriptors, id, ())
            {
                let descriptor = option.unwrap(std.page_walk.value(listed))
                let fields = collection_descriptor(descriptor)
                if fields.residency == ResidentMemory {
                    let child = std.page_walk.collection(listed)
                    if fields.kind == CellCollection {
                        let value = owned_cell(child, descriptor)
                        if let Some(raw) = value {
                            map.update_or_insert(mut cells, id, list.new(), fn(mut group: List[Arc[Bytes]]) {
                                list.push(mut group, arc.share(raw))
                            })
                        }
                    } else {
                        map.update_or_insert(mut collections, id, list.new(), fn(mut group: List[Arc[std.page.Page]]) {
                            list.push(mut group, arc.share(child))
                        })
                    }
                }
            }
            std.page_walk.next(mut listed)
        }
    }
    let mut charge = int.saturating_add(row_version_union(streams, 0), row_version_union(catalog, 0))
    if std.list.any(roots, fn(root: PageRoots) -> bool {
        list.len(root.keyed) != 0
    }) {
        let mut versions: List[Arc[std.page.Page]] = list.with_capacity(list.len(roots))
        for slot in 0u64 .. KEYED_TREE_COUNT {
            for root in roots {
                if list.len(root.keyed) != 0 {
                    list.push(mut versions, arc.share(root.keyed[slot].root))
                }
            }
            charge = int.saturating_add(charge, row_version_union(versions, 0))
            list.clear(mut versions)
        }
    }
    charge = int.saturating_add(charge, int.saturating_mul(map.len(descriptors), 126))
    for (_, group) in collections {
        charge = int.saturating_add(charge, row_version_union(group, 4))
    }
    for (_, group) in cells {
        let mut versions: List[Arc[Bytes]] = clone(group)
        list.sort(mut versions, fn(a: Arc[Bytes], b: Arc[Bytes]) -> Order {
            list.compare_bytes(a, b)
        })
        for i in 0u64 .. list.len(versions) {
            if i == 0 || versions[i - 1] != versions[i] {
                charge = int.saturating_add(charge, 70 + format.round8(list.len(versions[i])))
            }
        }
    }
    charge
}

pub fn get_page_row(tree: PageTree, key: Bytes) -> Option[View[Bytes]] in tree {
    if tree_domain(tree) != CollectionMap {
        return std.page.lookup(tree.root, key)
    }
    if list.len(key) < 4 {
        return None
    }
    let Some((root, descriptor)) = std.page.collection_entry(tree.root, list.slice(key, 0, 4)) else {
        return None
    }
    if collection_descriptor(descriptor).kind == CellCollection {
        if list.len(key) != 4 {
            return None
        }
        if let Some(raw) = inline_cell(descriptor) {
            return Some(raw)
        }
    }
    std.page.lookup(root, list.slice(key, 4, list.len(key)))
}

pub fn collection_kind(tree: PageTree, key: Bytes) -> Option[std.page_descriptor.CollectionKind] {
    match collection_by_key(tree, key) {
        Some(descriptor) => Some(descriptor.kind),
        None => None,
    }
}

pub fn put_page_row(mut tree: PageTree, key: Bytes, value: Bytes, private_from: u64, mut ids: u64) -> Result[(), types.Failure] {
    if tree_domain(tree) != CollectionMap {
        return page_result(std.page.insert(mut tree.root, key, value, None, tree.inline, private_from, mut ids))
    }
    if list.len(key) < 4 {
        return Error(Limit(Key))
    }
    let collection_key = list.slice(key, 0, 4)
    if let None = std.page.collection_child(tree.root, collection_key) {
        return Error(Stale(list.word_be(key, 0)))
    }
    let inline = tree.inline
    let suffix = list.slice(key, 4, list.len(key))
    page_result(std.page.edit_collection(mut tree.root, collection_key, private_from, mut ids, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        std.page.insert(mut root, suffix, value, None, inline, private_from, mut stamps)
    }))
}

pub fn blob_row_prior(tree: PageTree, key: Bytes) -> u32 {
    let Some(root) = std.page.collection_child(tree.root, list.slice(key, 0, 4)) else {
        return 0
    }
    blob_leaf_prior(root, list.slice(key, 4, list.len(key)))
}

fn blob_leaf_prior(page: Arc[std.page.Page], key: Bytes) -> u32 {
    let image = std.page.image_of(page)
    if let Some(slot) = std.page.descend(image, key) {
        return blob_leaf_prior(option.unwrap(std.page.child(page, slot)), key)
    }
    let (slot, hit) = std.page.search(image, key)
    if hit {
        std.page.slot_prior(image, slot)
    } else {
        0
    }
}

pub fn put_direct_page_row(mut tree: PageTree, key: Bytes, place: format.DirectBlob, resident: Option[Arc[Bytes]], private_from: u64, mut ids: u64) -> Result[(), types.Failure] {
    let suffix = list.slice(key, 4, list.len(key))
    page_result(std.page.edit_collection(mut tree.root, list.slice(key, 0, 4), private_from, mut ids, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        std.page.insert_blob_ref(mut root, suffix, format.direct_ref(place), resident, private_from, mut stamps, fn(_ptr: std.page.PagePtr) -> Result[Arc[std.page.Page], std.page.Error] {
            return Error(MalformedPage)
        })
    }))
}

pub fn put_shared_page_row(mut tree: PageTree, key: Bytes, value: Arc[Bytes], private_from: u64, mut ids: u64) -> Result[(), types.Failure] {
    if tree_domain(tree) != CollectionMap {
        return page_result(std.page.insert_shared(mut tree.root, key, value, tree.inline, private_from, mut ids))
    }
    if list.len(key) < 4 {
        return Error(Limit(Key))
    }
    let collection_key = list.slice(key, 0, 4)
    let inline = tree.inline
    let suffix = list.slice(key, 4, list.len(key))
    page_result(std.page.edit_collection(mut tree.root, collection_key, private_from, mut ids, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        std.page.insert_shared(mut root, suffix, value, inline, private_from, mut stamps)
    }))
}

pub fn remove_page_row(mut tree: PageTree, key: Bytes, private_from: u64, mut ids: u64) -> Result[bool, types.Failure] {
    if tree_domain(tree) != CollectionMap {
        return page_result(std.page.remove(mut tree.root, key, private_from, mut ids))
    }
    let present = if collection_kind(tree, list.slice(key, 0, 4)) == Some(BlobsCollection) {
        blob_row_prior(tree, key) != 0
    } else {
        match get_page_row(tree, key) {
            Some(_) => true,
            None => false
        }
    }
    if !present {
        return Ok(false)
    }
    let collection_key = list.slice(key, 0, 4)
    let suffix = list.slice(key, 4, list.len(key))
    let Some(empty_root) = view tree.empty_collection else {
        fail("store: missing empty collection page")
    }
    page_result(std.page.edit_collection(mut tree.root, collection_key, private_from, mut ids, scoped fn(mut root: Arc[std.page.Page], mut stamps: u64) -> Result[(), std.page.Error] {
        let _ = std.page.remove_with_empty(mut root, suffix, empty_root, private_from, mut stamps)?
        Ok(())
    }))?
    Ok(true)
}

pub type CollectionCursor: send {
    walk: std.page.Cursor,
    leading: Bytes
}

pub fn collection_row_key(leading: Bytes, suffix: Bytes) -> Bytes {
    let mut key: Bytes = list.with_capacity(list.len(leading) + list.len(suffix))
    list.append(mut key, leading)
    list.append(mut key, suffix)
    take key
}

pub type PageRange: send {
    listed: std.page.Cursor,
    nested: bool,
    active: List[std.page.Cursor],
    collection: u32,
    start: Option[Bytes],
    stop: Option[Bytes],
    inclusive: bool,
    reverse: bool
}

pub fn open_page_range(tree: PageTree, start: Option[Bytes], inclusive: bool, reverse: bool, take stop: Option[Bytes]) -> Result[PageRange, types.Failure] {
    let nested = tree_domain(tree) == CollectionMap
    let initial: Option[Bytes] = match start {
        None => None,
        Some(key) => Some(types.copied(list.slice(key, 0, if nested {
            order.min(4, list.len(key))
        } else {
            list.len(key)
        }))?),
    }
    let outer_stop: Option[Bytes] = match view stop {
        None => None,
        Some(key) => {
            // Collection keys are four bytes. A longer upper bound includes
            // its collection; a lower bound always includes its collection.
            let width = if !nested {
                list.len(key)
            } else {
                order.min(if reverse {
                    4
                } else {
                    5
                }, list.len(key))
            }
            Some(types.copied(list.slice(key, 0, width))?)
        },
    }
    // In reverse, an exclusive four-byte key precedes every row of its
    // collection. The outer cursor can skip that collection at the seek.
    let within_collection = match start {
        Some(key) => list.len(key) > 4,
        None => false,
    }
    let outer_inclusive = inclusive || (nested && (!reverse || within_collection))
    let listed = std.page.cursor_open_bounded(tree.root, initial, outer_inclusive, reverse, take outer_stop)
    Ok(PageRange(listed: take listed, nested: nested, active: list.new(), collection: 0, start: clone(start), stop: take stop, inclusive: inclusive, reverse: reverse))
}

pub fn range_has_cell(rows: PageRange, key: Bytes) -> bool {
    if let Some(start) = rows.start {
        if (!rows.inclusive && key == start) || (if rows.reverse {
            key > start
        } else {
            key < start
        }) {
            return false
        }
    }
    match rows.stop {
        Some(stop) => if rows.reverse {
            key >= stop
        } else {
            key < stop
        },
        None => true,
    }
}

pub fn open_page_collection(mut rows: PageRange, key: Bytes, root: Arc[std.page.Page]) -> Result[(), types.Failure] {
    rows.collection = list.word_be(key, 0)
    let start: Option[Bytes] = match rows.start {
        Some(boundary) => if list.len(boundary) >= 4 && list.slice(boundary, 0, 4) == key {
            Some(types.copied(list.slice(boundary, 4, list.len(boundary)))?)
        } else {
            None
        },
        None => None,
    }
    let stop: Option[Bytes] = match rows.stop {
        Some(boundary) => if list.len(boundary) > 4 && list.slice(boundary, 0, 4) == key {
            Some(types.copied(list.slice(boundary, 4, list.len(boundary)))?)
        } else {
            None
        },
        None => None,
    }
    list.push(mut rows.active, std.page.cursor_open_bounded(root, start, rows.inclusive, rows.reverse, take stop))
    Ok(())
}

// Keep the first two rows inline. The count's high bit records the first
// append whose full encoded key is not above the preceding one.
const DATA_ROWS_UNORDERED: u64 = 1u64 << 63

const DATA_ROWS_CHUNKS: u64 = 1u64 << 62

pub type DataRows: shareable + send {
    count_word: u64,
    first: Inline[format.DataOp, 2],
    rest: List[format.DataOp]
}

pub fn new_data_rows() -> DataRows {
    let first: Inline[format.DataOp, 2] =[
        format.DataOp(key: list.new(), value: None, trim: None, prior: None),
        format.DataOp(key: list.new(), value: None, trim: None, prior: None),
    ]
    DataRows(count_word: 0, first: take first, rest: list.new())
}

pub fn data_row_count(rows: DataRows) -> u64 {
    rows.count_word & (DATA_ROWS_CHUNKS - 1)
}

pub fn draft_has_chunks(rows: DataRows) -> bool {
    rows.count_word & DATA_ROWS_CHUNKS != 0
}

pub fn mark_chunk_rows(mut rows: DataRows) {
    rows.count_word = rows.count_word | DATA_ROWS_CHUNKS
}

pub fn rows_ascending(rows: DataRows) -> bool {
    rows.count_word & DATA_ROWS_UNORDERED == 0
}

pub fn data_row(rows: DataRows, slot: u64) -> View[format.DataOp] in rows {
    if slot < 2 {
        view rows.first[slot]
    } else {
        view rows.rest[slot - 2]
    }
}

pub fn push_data_row(mut rows: DataRows, take row: format.DataOp) {
    let n = data_row_count(rows)
    let inversion = n > 0 && rows_ascending(rows) && list.compare_bytes(data_row(rows, n - 1).key, row.key) != Less
    if n < 2 {
        rows.first[n] = take row
    } else {
        list.push(mut rows.rest, take row)
    }
    if inversion {
        rows.count_word = rows.count_word | DATA_ROWS_UNORDERED
    }
    rows.count_word += 1
}

pub fn op_slot(ops: DataOps, key: Bytes) -> Option[u64] {
    let n = data_row_count(ops.rows)
    if n > SCANNED_OPS {
        if !rows_ascending(ops.rows) {
            return option.copied(map.get(ops.slots, key))
        }
        let mut low = 0u64
        let mut high = n
        while low < high {
            let mid = low + (high - low) / 2
            match list.compare_bytes(data_row(ops.rows, mid).key, key) {
                Less => {
                    low = mid + 1
                },
                Equal => return Some(mid),
                Greater => {
                    high = mid
                },
            }
        }
        return None
    }
    for slot in 0u64 .. n {
        if data_row(ops.rows, slot).key == key {
            return Some(slot)
        }
    }
    None
}
